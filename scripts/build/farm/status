#!/usr/bin/python3
"""What the build farm can use now (README.md): its configuration, each host's health (probed now),
and whether this machine's side is installed.

    scripts/build/farm/status [--json]

A host is usable when it answers over ssh, is reached over its configured interface (`link`;
when it is not, the farm looks for an address of it that is, `farm.recover`), and has the free disk, round trip and throughput the configuration asks.
Exits 0 when at least one host is usable, 1 when none is (everything then runs here).
"""
import json
import os
import socket
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import farm  # noqa: E402


def speed(name, base):
    """`name`'s compile benchmark (`bench`), as a line: its times at each job count, its 8-job time
    against this Mac's (`base`), and the date; None when it has not been measured."""
    r = farm.read_json(farm.state("bench", name + ".json"), None)
    runs = {int(j): x for j, x in (r or {}).get("runs", {}).items() if x.get("s") is not None}
    if not runs:
        return None
    parts = [f"{x['s']:.0f} s at {j} job{'s' if j > 1 else ''}{' (contended)' if x.get('contended') else ''}" for j, x in sorted(runs.items())]
    top = runs[max(runs)]
    rel = f"; {top['s'] / base:.2f}x this Mac's time" if base and name != "local" else ""
    return f"compile benchmark (bench): {', '.join(parts)}{rel}; measured {time.strftime('%Y-%m-%d', time.localtime(top['at']))}"


def main(argv):
    cfg = farm.config()
    local_bench = farm.read_json(farm.state("bench", "local.json"), {}).get("runs", {})
    base = (local_bench.get(str(max(map(int, local_bench)))) or {}).get("s") if local_bench else None
    path = farm.config_path()
    rows = []
    for host in farm.hosts():
        h = farm.health(host, fresh=True) if host.get("enabled", True) else {"ok": False, "why": "disabled"}
        rows.append((host, h))
    if "--json" in argv:
        print(json.dumps([dict(name=host["name"], **h) for host, h in rows], indent=1))
    else:
        print(f"configuration: {path}" if path else
              f"configuration: none ({os.path.join(farm.CONFIG, 'farm.json')} missing): no hosts, everything runs here")
        print(f"limits: {cfg['min_free_gb']} GB free (the farm frees its data under it; used down to {cfg['floor_free_gb']}); "
              "a slow link or round trip only orders the hosts, it never refuses one")
        sock = socket.socket(socket.AF_UNIX)
        try:
            sock.connect(farm.state("mirror.sock"))
            daemon = "running"
        except OSError:
            daemon = "not running (the first remote compile or test-remote starts it)"
        finally:
            sock.close()
        local = os.statvfs(farm.HOME)
        print(f"this Mac: {local.f_bavail * local.f_frsize / 1e9:.0f} GB free; under {cfg.get('local_min_free_gb', 200)} GB, "
              "Rerail's least recently built builds go (free-local)")
        if speed("local", base):
            print(f"  this Mac's {speed('local', base)}")
        print(f"farm sccache: {'installed' if os.path.exists(farm.SCCACHE) else 'not installed (setup)'}; mirror daemon: {daemon}")
        for host, h in rows:
            if farm.host_os(host) == "macos":
                uses = "compiles" + (", tests" if host.get("tests", True) else "")
            else:
                parts = (["this Mac's compiles, in a container"] if host.get("mac_compiles", True) else []) + \
                    ([f"tests as a {farm.host_os(host)} build"] if host.get("tests", True) else [])
                uses = f"{farm.host_os(host)}: " + (", ".join(parts) or "unused")
            facts = ", ".join(f"{v} {unit}" for v, unit in ((h.get("rtt_ms"), "ms"), (h.get("mbps"), "MB/s through ssh"),
                                                            (h.get("free_gb"), "GB free"),
                                                            (None if h.get("busy") is None else f"{h['busy']}%", "of its CPU busy"),
                                                            (h.get("load"), "load average")) if v is not None)
            state = "usable" if h.get("ok") else f"not usable: {h.get('why')}"
            hw = " ".join(x for x in (farm.host_arch(host), f"{farm.host_memory_gb(host)} GB" if farm.host_memory_gb(host) else None) if x)
            print(f"  {host['name']}: {state} ({host.get('cores')} cores{', ' + hw if hw else ''}; {uses}{'; ' + facts if facts else ''})")
            if speed(host["name"], base):
                print(f"    {speed(host['name'], base)}")
            if h.get("arrival") and not farm.link_of(host):
                print(f"    no link: it is reached over its {h['arrival']}; a fall back to WiFi is not caught")
            if h.get("ok") and h.get("short"):
                print(f"    short of disk: {h['short']}")
            if h.get("route"):
                print(f"    reached at an address of its {farm.link_of(host)} (its name resolved to another link)")
        print("A usable host takes commands however busy it is: test-remote sends to a free test slot, and\n"
              "busy CPUs or a load over the cores only order the hosts. Never wait for a host to be idle.")
    sys.exit(0 if any(h.get("ok") for _, h in rows) else 1)


if __name__ == "__main__":
    main(sys.argv[1:])
