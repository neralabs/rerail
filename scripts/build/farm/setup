#!/bin/sh
# Installs the build farm for this user (README.md): the scripts and the farm's sccache under
# ~/.local/share/rerail-farm, and a configuration to fill in at ~/.config/rerail-farm/farm.json (kept
# if there is one). Hosts need nothing installed (the scripts they run are sent with each command):
# only ssh without a password, and the toolchain of rust-toolchain.toml, which this checks.
# Usage: setup [path-to-patched-sccache]
set -eu
here=$(cd "$(dirname "$0")" && pwd)
share=$HOME/.local/share/rerail-farm
config=$HOME/.config/rerail-farm
mkdir -p "$share/bin" "$config"
for f in farm.py mirror.py rustc-wrapper farm-rustc farm-cc remote-rustc farm-agent shared-volume status; do
  install -m 0755 "$here/$f" "$share/$f.tmp" && mv "$share/$f.tmp" "$share/$f"
done
ln -sf farm-cc "$share/farm-c++"
if [ $# -gt 0 ]; then install -m 0755 "$1" "$share/bin/sccache.tmp" && mv "$share/bin/sccache.tmp" "$share/bin/sccache"; fi
[ -f "$config/farm.json" ] || [ -f "$config/hosts.json" ] || cp "$here/farm.example.json" "$config/farm.json"
toolchain=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' "$here/../../../rust-toolchain.toml")
python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import farm; [print(h["name"]) for h in farm.hosts() if h.get("enabled", True)]' "$here" |
while read -r host; do
  if ssh -o BatchMode=yes -o ConnectTimeout=3 "$host" "~/.cargo/bin/rustup toolchain list | grep -q '^$toolchain' || ~/.cargo/bin/rustup toolchain install $toolchain --profile minimal" </dev/null; then
    echo "$host: ready"
  else
    echo "$host: unreachable or without rustup, skipped"
  fi
done
"$share/status" || true
