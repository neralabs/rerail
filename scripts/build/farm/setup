#!/bin/sh
# Installs the build farm for this user (README.md): the scripts and the farm's sccache under
# ~/.local/share/rerail-farm, the machine's one cargo configuration for Rerail's builds in
# ~/.cargo/config.toml ("One configuration"), and a farm configuration to fill in at
# ~/.config/rerail-farm/farm.json (kept if there is one). Hosts need nothing installed (the scripts
# they run are sent with each command): only ssh without a password, and the toolchain of
# rust-toolchain.toml, which this checks (on a Linux host with aarch64-apple-darwin's std too: it
# compiles this Mac's crates, README "Mac compiles on a Linux host").
# Usage: setup [--force] [path-to-patched-sccache]
#   --force installs this checkout's farm over a newer installed version (a downgrade).
set -eu
here=$(cd "$(dirname "$0")" && pwd)
share=$HOME/.local/share/rerail-farm
config=$HOME/.config/rerail-farm
force=
if [ "${1:-}" = "--force" ]; then force=1; shift; fi
version() { sed -n 's/^VERSION = \([0-9]*\)$/\1/p' "$1" 2>/dev/null; }
mine=$(version "$here/farm.py")
installed=$(version "$share/farm.py")
if [ -n "$installed" ] && [ "$installed" -gt "$mine" ] && [ -z "$force" ]; then
  echo "setup: the installed farm is version $installed, this checkout's $mine: not installed over it" >&2
  echo "       (merge the newer farm into this checkout, or --force to go back)" >&2
  exit 1
fi
# The same version from another branch can hold changes this checkout lacks (2026-11-21: farm 54
# replaced a branch's 53 with its pack-data sending, and that branch's tests lost their fixtures).
# The commit an install came from must be in this checkout's history.
head=$(git -C "$here" rev-parse HEAD)
from=$(cat "$share/installed-from" 2>/dev/null || true)
if [ -n "$from" ] && [ -z "$force" ] && ! git -C "$here" merge-base --is-ancestor "$from" "$head" 2>/dev/null; then
  echo "setup: the installed farm came from commit $from, which this checkout has not merged: not installed over it" >&2
  echo "       (merge that commit's farm changes into this checkout, or --force to drop them)" >&2
  exit 1
fi
mkdir -p "$share/bin" "$config"
for f in farm.py mirror.py guest.py guests rustc-wrapper farm-rustc farm-cc farm-agent gpu-guard status bench features diagnose free-local dashboard sampler sampler.ps1 cloud-deadman; do
  install -m 0755 "$here/$f" "$share/$f.tmp" && mv "$share/$f.tmp" "$share/$f"
done
install -m 0755 "$here/../../dev/clean-target" "$share/clean-target.tmp" && mv "$share/clean-target.tmp" "$share/clean-target"
install -m 0755 "$here/../../dev/quiet-run" "$share/quiet-run.tmp" && mv "$share/quiet-run.tmp" "$share/quiet-run"
# Every checkout's test-remote and live-test-remote are handed to these (farm.py): one version for all.
for f in test-remote live-test-remote; do
  install -m 0755 "$here/../../dev/$f" "$share/$f.tmp" && mv "$share/$f.tmp" "$share/$f"
done
ln -sf farm-cc "$share/farm-c++"
echo "$head" > "$share/installed-from"
# What an earlier version installed and this one has not: copy and NFS modes.
for f in remote-rustc shared-volume; do [ -e "$share/$f" ] && mv "$share/$f" "${TMPDIR:-/tmp}/rerail-farm-old-$f.$$"; done
if [ $# -gt 0 ]; then install -m 0755 "$1" "$share/bin/sccache.tmp" && mv "$share/bin/sccache.tmp" "$share/bin/sccache"; fi
[ -f "$config/farm.json" ] || [ -f "$config/hosts.json" ] || cp "$here/farm.example.json" "$config/farm.json"
"$here/cargo-config"
toolchain=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' "$here/../../../rust-toolchain.toml")
# A Windows host's toolchain is Windows' own (README, "Windows hosts"), and a host that takes no
# jobs (no tests, no mirror: a Windows VM's WSL1, there for its Windows side) needs none.
# A stopped guest is not started for this (a cloud one bills): its toolchain is checked when it runs.
python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import farm, guest; [print(h["name"], "stopped" if guest.spec(h)[1] and guest.record(guest.spec(h)[0]["name"]).get("state") != "running" else "windows" if farm.host_os(h) == "windows" else "idle" if not h.get("tests", True) and not h.get("mirror", True) else "") for h in farm.hosts() if h.get("enabled", True)]' "$here" |
while read -r host kind; do
  if [ "$kind" = windows ]; then
    ssh -o BatchMode=yes -o ConnectTimeout=3 "$host" "/mnt/c/Windows/System32/cmd.exe /d /c 'cd /d C:\\ && %USERPROFILE%\\.cargo\\bin\\rustup.exe toolchain list' 2>/dev/null" </dev/null | grep -q "^$toolchain" \
      && echo "$host: ready (Windows' toolchain)" || echo "$host: Windows has no $toolchain toolchain (README, \"Windows hosts\")"
    continue
  fi
  [ "$kind" = idle ] && { echo "$host: takes no jobs"; continue; }
  [ "$kind" = stopped ] && { echo "$host: a guest, stopped: not checked"; continue; }
  if ssh -o BatchMode=yes -o ConnectTimeout=3 "$host" "{ ~/.cargo/bin/rustup toolchain list | grep -q '^$toolchain' || ~/.cargo/bin/rustup toolchain install $toolchain --profile minimal; } && { [ \$(uname) != Linux ] || ~/.cargo/bin/rustup target add --toolchain $toolchain aarch64-apple-darwin >/dev/null 2>&1; }" </dev/null; then
    echo "$host: ready"
  else
    echo "$host: unreachable or without rustup, skipped"
  fi
done
# The guests' watcher (guest.py; README, "Guests"): stops each guest once idle. A LaunchAgent, kept
# running, when the configuration has a guest; restarted so it runs this version.
agent=software.nera.rerail-farm-guests
plist=$HOME/Library/LaunchAgents/$agent.plist
if [ "$(uname)" = Darwin ] && python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import farm; sys.exit(0 if any(h.get("guest") for h in farm.hosts()) else 1)' "$share"; then
  mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Caches/rerail-farm"
  cat > "$plist.tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$agent</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>$share/guests</string><string>watch</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>$HOME/Library/Caches/rerail-farm/guests.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Caches/rerail-farm/guests.log</string>
</dict></plist>
PLIST
  mv "$plist.tmp" "$plist"
  launchctl bootout "gui/$(id -u)/$agent" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist" && echo "guests: the watcher runs (stops each guest once idle)"
fi
# Keeps the farm's files on the hosts out of their backups (and reports Spotlight's indexing of them).
"$here/host-privacy" || true
"$share/status" || true
