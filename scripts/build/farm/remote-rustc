#!/usr/bin/python3
"""Runs one rustc compile that another Mac's farm-rustc sent here (scripts/build/farm/README.md).

Reads a JSON request on stdin: {"cwd", "argv", "env", "dirs"}, and for a host that mounts the
sender's files ("shared"), "fresh" and "depinfo". The paths are the sender's: this machine keeps a
copy of its checkout and target files at the same absolute paths, or mounts them there. Creates
`dirs`, runs `argv` in `cwd` with exactly `env`, and passes rustc's output and exit status through.

Through a mount, what this machine sees of a directory may lag the sender's by its attribute cache
(1 s): "fresh" maps each path to the sender's [mtime_ns, size] (a directory: its mtime at least),
and the compile starts once this machine sees each of them, or exits 75 after 3 s. After the
compile, the files the dep-info file "depinfo" lists are reported as {path: [mtime_ns, size]} on
the last line of stderr, after MARK, for the sender to check against its own and strip."""
import json, os, subprocess, sys, time

MARK = "\0rerail-farm-read "

request = json.load(sys.stdin)
for d in request["dirs"]:
    os.makedirs(d, exist_ok=True)


def seen(path):
    try:
        st = os.stat(path)
        return [st.st_mtime_ns, st.st_size]
    except OSError:
        return None


fresh = request.get("fresh", {})
started = time.time()
deadline = started + 3
while True:
    stale = []
    for path, (mtime, size) in fresh.items():
        now = seen(path)
        if now is None or (now[0] < mtime if size is None else now != [mtime, size]):
            stale.append(path)
    if not stale:
        break
    if time.time() > deadline:
        sys.stderr.write(f"remote-rustc: stale after 3 s: {stale[:5]}\n")
        sys.exit(75)
    time.sleep(0.05)
waited = time.time() - started
done = subprocess.run(request["argv"], cwd=request["cwd"], env=request["env"], stdin=subprocess.DEVNULL)
ran = time.time() - started - waited
if request.get("depinfo") and done.returncode == 0:
    read = {}
    try:
        text = open(request["depinfo"]).read().replace("\\\n", " ")
        for line in text.splitlines():
            if line.startswith("#") or ":" not in line:
                continue
            for path in line.split(":", 1)[1].split():
                read[path] = seen(path)
    except OSError:
        read = {"?": None}
    sys.stderr.flush()
    # How long the view took to be fresh, and rustc's own time: the rest is the farm's.
    read["\0times"] = [round(waited, 3), round(ran, 3)]
    sys.stderr.write(MARK + json.dumps(read) + "\n")
sys.exit(done.returncode)
