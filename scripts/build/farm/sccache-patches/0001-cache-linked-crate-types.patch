From 9c2ed7ae58f7c6ae13386d0a2e98f97159bd09ed Mon Sep 17 00:00:00 2001
From: rerail farm <noreply@example.invalid>
Subject: [PATCH] rerail-farm: cache crate types that link
 (SCCACHE_CACHE_LINKED), path-less sysroot --extern, keep SOURCE_DATE_EPOCH;
 debug key logging

---
 src/cmdline.rs       |   4 +-
 src/compiler/rust.rs | 107 ++++++++++++++++++++++++++++++++++++++-----
 2 files changed, 99 insertions(+), 12 deletions(-)

diff --git a/src/cmdline.rs b/src/cmdline.rs
index f639396..e43d2c4 100644
--- a/src/cmdline.rs
+++ b/src/cmdline.rs
@@ -308,7 +308,9 @@ pub fn try_parse() -> Result<Command> {
                         && k != "PWD"
                         && k != "HOST"
                         && k != "RPM_BUILD_ROOT"
-                        && k != "SOURCE_DATE_EPOCH"
+                        // SOURCE_DATE_EPOCH is kept: a build that sets it makes `__DATE__` and
+                        // `__TIME__` expand the same each time, and a C compile's key hashes its
+                        // preprocessed text, so a source that uses them is cached at all.
                         && k != "RPM_PACKAGE_RELEASE"
                         && k != "MINICOM"
                         && k != "DESTDIR"
diff --git a/src/compiler/rust.rs b/src/compiler/rust.rs
index a6aface..7301eed 100644
--- a/src/compiler/rust.rs
+++ b/src/compiler/rust.rs
@@ -427,6 +427,54 @@ pub struct RustCompilation {
 pub struct CrateTypes {
     rlib: bool,
     staticlib: bool,
+    /// A crate type rustc links (cdylib, dylib, proc-macro, bin), cached only with
+    /// `SCCACHE_CACHE_LINKED` (`cache_linked`).
+    linked: bool,
+}
+
+/// Crate types that rustc links with the system linker. sccache does not know all of a link's
+/// inputs, so it never caches them, unless `SCCACHE_CACHE_LINKED` is set in the server's environment:
+/// then their inputs are taken to be what it hashes for an rlib (the sources, every `--extern`, the
+/// static libraries) plus the linker's and the SDK's versions (`linker_identity`). A system library
+/// that changes without either version changing is the one input not covered.
+const LINKED_CRATE_TYPES: &[&str] = &["cdylib", "dylib", "proc-macro", "bin"];
+
+fn cache_linked() -> bool {
+    std::env::var_os("SCCACHE_CACHE_LINKED").is_some_and(|v| !v.is_empty() && v != "0")
+}
+
+/// The linker's and the SDK's versions, the deployment target and the SDK root: hashed into the key
+/// of a linked crate type (`LINKED_CRATE_TYPES`). Read once per server.
+fn linker_identity(env_vars: &[(OsString, OsString)]) -> Vec<u8> {
+    static IDENTITY: LazyLock<Vec<u8>> = LazyLock::new(|| {
+        let mut out = Vec::new();
+        // Only what each prints as its answer: an error (xcrun without an SDK) carries a time and a pid.
+        // `ld -v` answers on stderr.
+        for (program, args, stderr) in [
+            ("cc", &["--version"][..], false),
+            ("ld", &["-v"][..], true),
+            ("xcrun", &["--show-sdk-version"][..], false),
+            ("xcrun", &["--show-sdk-build-version"][..], false),
+        ] {
+            out.extend_from_slice(program.as_bytes());
+            if let Ok(o) = std::process::Command::new(program).args(args).output() {
+                out.extend_from_slice(if stderr { &o.stderr } else { &o.stdout });
+                out.push(o.status.success() as u8);
+            }
+            out.push(0);
+        }
+        out
+    });
+    let mut out = IDENTITY.clone();
+    for (k, v) in env_vars {
+        if k == "MACOSX_DEPLOYMENT_TARGET" || k == "SDKROOT" || k == "IPHONEOS_DEPLOYMENT_TARGET" {
+            out.extend_from_slice(k.as_encoded_bytes());
+            out.push(b'=');
+            out.extend_from_slice(v.as_encoded_bytes());
+            out.push(0);
+        }
+    }
+    out
 }
 
 /// Emit types that we will cache.
@@ -1361,28 +1409,42 @@ impl IntoArg for ArgUnstable {
 #[derive(Clone, Debug, PartialEq)]
 struct ArgExtern {
     name: String,
-    path: PathBuf,
+    /// None for a sysroot crate named without a path (cargo gives every proc macro
+    /// `--extern proc_macro`): the compiler's own digests cover it.
+    path: Option<PathBuf>,
 }
+
+/// The sysroot's crates, which `--extern` may name without a path.
+const SYSROOT_EXTERNS: &[&str] = &["proc_macro", "std", "core", "alloc", "test"];
+
 impl FromArg for ArgExtern {
     fn process(arg: OsString) -> ArgParseResult<Self> {
-        if let (name, Some(path)) = split_os_string_arg(arg, "=")? {
-            Ok(ArgExtern {
+        match split_os_string_arg(arg, "=")? {
+            (name, Some(path)) => Ok(ArgExtern {
                 name,
-                path: path.into(),
-            })
-        } else {
-            Err(ArgParseError::Other("no path for extern"))
+                path: Some(path.into()),
+            }),
+            (name, None) if SYSROOT_EXTERNS.contains(&name.as_str()) => {
+                Ok(ArgExtern { name, path: None })
+            }
+            _ => Err(ArgParseError::Other("no path for extern")),
         }
     }
 }
 impl IntoArg for ArgExtern {
     fn into_arg_os_string(self) -> OsString {
         let ArgExtern { name, path } = self;
-        make_os_string!(name, "=", path)
+        match path {
+            Some(path) => make_os_string!(name, "=", path),
+            None => name.into(),
+        }
     }
     fn into_arg_string(self, transformer: PathTransformerFn<'_>) -> ArgToStringResult {
         let ArgExtern { name, path } = self;
-        Ok(format!("{}={}", name, path.into_arg_string(transformer)?))
+        Ok(match path {
+            Some(path) => format!("{}={}", name, path.into_arg_string(transformer)?),
+            None => name,
+        })
     }
 }
 
@@ -1668,6 +1730,7 @@ fn parse_arguments(arguments: &[OsString], cwd: &Path) -> CompilerArguments<Pars
     let mut crate_types = CrateTypes {
