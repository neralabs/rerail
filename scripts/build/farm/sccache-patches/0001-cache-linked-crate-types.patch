             Some(CodeGen(ArgCodegen { opt, value })) => {
                 match (opt.as_ref(), value) {
                     ("extra-filename", Some(value)) => extra_filename = Some(value.to_owned()),
@@ -1835,6 +1903,7 @@ fn parse_arguments(arguments: &[OsString], cwd: &Path) -> CompilerArguments<Pars
     if let CrateTypes {
         rlib: false,
         staticlib: false,
+        linked: false,
     } = crate_types
     {
         cannot_cache!("crate-type", NO_CRATE_TYPE_PASSED.to_owned())
@@ -2299,6 +2368,13 @@ where
                 })
         };
         args.hash(&mut HashToDigest { digest: &mut m });
+        if std::env::var_os("SCCACHE_DEBUG_KEY").is_some() {
+            debug!("[{}]: key args {:?} sources {:?} externs {:?} statics {:?} cwd {:?}", self.parsed_args.crate_name, args, source_hashes, extern_hashes, staticlib_hashes, strip_basedirs_os(cwd.as_os_str(), basedirs));
+            for (k, v) in env_vars.iter().filter(|(k, _)| k.to_string_lossy().starts_with("CARGO_")) {
+                debug!("[{}]: key env {:?}={:?}", self.parsed_args.crate_name, k, strip_basedirs_os(v, basedirs));
+            }
+            debug!("[{}]: key env_deps {:?}", self.parsed_args.crate_name, env_deps);
+        }
         // 4. The digest of all source files (this includes src file from cmdline).
         // 5. The digest of all files listed on the commandline (self.externs).
         // 6. The digest of all static libraries listed on the commandline (self.staticlibs).
@@ -2363,6 +2439,11 @@ where
             .hash(&mut HashToDigest { digest: &mut m });
         // 10. The version of the compiler.
         self.version.hash(&mut HashToDigest { digest: &mut m });
+        // 11. For a crate type that links, the linker and the SDK.
+        if self.parsed_args.crate_types.linked {
+            m.update(b"linked");
+            m.update(&linker_identity(&env_vars));
+        }
 
         // metadata / dep-info don't ever generate binaries, but
         // rustc still makes them appear in the --print
@@ -3092,6 +3173,7 @@ impl pkg::InputsPackager for RustInputsPackager {
             CrateTypes {
