#!/usr/bin/python3
"""The farm agent's test: runs `farm-agent` here on a root of its own (`RERAIL_FARM_AGENT_ROOT`, a
temporary directory) and speaks its protocol (puts, `have`, `prune`), as the mirror daemon does.

    scripts/build/farm/test-agent

`prune` (README.md, "Live mirror") removes a file the mirror wrote that the checkout no longer has,
and keeps a file the checkout still has, a file under a `skip` directory, a file under `.git` and a
file a command wrote there (no attribute). Exits 0 when every check holds.
"""
import json
import os
import struct
import subprocess
import sys
import tempfile

AGENT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "farm-agent")


def main():
    with tempfile.TemporaryDirectory() as root:
        agent = subprocess.Popen([sys.executable, "-u", AGENT], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                 env=dict(os.environ, RERAIL_FARM_AGENT_ROOT=root))

        def send(header, payload=b""):
            data = json.dumps(dict(header, size=len(payload))).encode()
            agent.stdin.write(struct.pack(">I", len(data)) + data + payload)
            agent.stdin.flush()

        def receive():
            head = agent.stdout.read(4)
            header = json.loads(agent.stdout.read(struct.unpack(">I", head)[0]))
            agent.stdout.read(header.get("size", 0))
            return header

        checkout = "/checkout"
        put = ["/checkout/kept.rs", "/checkout/deleted.rs", "/checkout/tree/input.txt", "/checkout/.git/HEAD"]
        for path in put:
            send({"op": "put", "path": path, "mtime_ns": 1, "mode": 0o644}, path.encode())
        # A file a command wrote in the copy: no attribute.
        send({"op": "have", "id": 1, "paths": put})
        assert all(receive()["seen"]), "every put file is there"
        written = os.path.join(root, "checkout/output.txt")
        open(written, "w").write("a run's output")
        send({"op": "prune", "id": 2, "root": checkout, "keep": ["/checkout/kept.rs"], "skip": ["/checkout/tree"]})
        reply = receive()
        agent.stdin.close()
        agent.wait()
        checks = [
            (reply.get("op") == "pruned" and reply.get("removed") == ["/checkout/deleted.rs"], f"removed only the deleted file: {reply}"),
            (not os.path.exists(os.path.join(root, "checkout/deleted.rs")), "the deleted file is gone"),
            (os.path.exists(os.path.join(root, "checkout/kept.rs")), "a file the checkout has stays"),
            (os.path.exists(os.path.join(root, "checkout/tree/input.txt")), "a file under a skipped directory stays"),
            (os.path.exists(os.path.join(root, "checkout/.git/HEAD")), "a file under .git stays"),
            (os.path.exists(written), "a file a command wrote stays"),
        ]
        failed = [why for ok, why in checks if not ok]
        for why in failed:
            print(f"test-agent: FAIL: {why}", file=sys.stderr)
        if failed:
            sys.exit(1)
        print(f"test-agent: {len(checks)} checks pass")


main()
