<script>
const $ = s => document.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
// Memory in GiB, as the systems' own settings count it (a "16GB" WSL, a 24 GB machine); disks in GB.
const MEM = b => b == null ? "?" : (b / 2 ** 30).toFixed(1).replace(/\.0$/, "") + " GB";
const GB = b => b == null ? "?" : (b / 1e9 >= 100 ? (b / 1e9).toFixed(0) : (b / 1e9).toFixed(1)) + " GB";
const pct = f => f == null ? "?" : Math.round(f * 100) + "%";
const rate = b => b == null ? "?" : b >= 1e6 ? (b / 1e6).toFixed(1) + " MB/s" : b >= 1e3 ? (b / 1e3).toFixed(0) + " KB/s" : Math.round(b) + " B/s";
const ago = t => { if (!t) return "never"; const s = Date.now() / 1000 - t; return s < 90 ? Math.round(s) + " s ago" : s < 5400 ? Math.round(s / 60) + " min ago" : (s / 3600).toFixed(1) + " h ago"; };
function bar(parts, total) {
  return '<div class="bar">' + parts.filter(p => p[0] > 0).map(p =>
    `<span style="width:${Math.min(100, 100 * p[0] / total)}%;background:${p[1]}" title="${esc(p[2])}"></span>`).join("") + "</div>";
}
// A stacked area of the CPU shares over the history (0..1), and an optional line.
function cpuSpark(h) {
  if (h.length < 2) return '<svg class="spark"></svg>';
  const W = 300, H = 34, t0 = h[0][0], t1 = h[h.length - 1][0], x = t => (W * (t - t0) / Math.max(t1 - t0, 1)).toFixed(1);
  const layer = (lo, hi, color) => {
    const top = h.map(r => `${x(r[0])},${(H - H * Math.min(hi(r), 1)).toFixed(1)}`);
    const bot = h.slice().reverse().map(r => `${x(r[0])},${(H - H * Math.min(lo(r), 1)).toFixed(1)}`);
    return `<polygon points="${top.concat(bot).join(" ")}" fill="${color}"/>`;
  };
  return `<svg class="spark" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><title>CPU, last ${Math.round((t1 - t0) / 60)} min</title>` +
    layer(r => 0, r => r[1], "var(--farm)") + layer(r => r[1], r => r[1] + r[2], "var(--fleet)") +
    layer(r => r[1] + r[2], r => r[1] + r[2] + r[3], "var(--other)") + "</svg>";
}
function lineSpark(h, i, color, label, max) {
  const pts = h.filter(r => r[i] != null);
  if (pts.length < 2) return "";
  const W = 300, H = 24, t0 = h[0][0], t1 = h[h.length - 1][0], m = max || Math.max(...pts.map(r => r[i]), 1e-9);
  const p = pts.map(r => `${(W * (r[0] - t0) / Math.max(t1 - t0, 1)).toFixed(1)},${(H - 2 - (H - 4) * Math.min(r[i] / m, 1)).toFixed(1)}`).join(" ");
  return `<svg class="spark" style="height:24px" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><title>${esc(label)}</title>` +
    `<polyline points="${p}" fill="none" stroke="${color}" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/></svg>`;
}
const KIND = {lima: "Lima VM", orb: "OrbStack machine", parallels: "Parallels VM", wsl: "WSL"};
const STATE_COLOR = {running: "var(--good)", starting: "var(--warn)", stopping: "var(--warn)", stopped: "var(--muted)"};
function guestLine(g) {
  const now = Date.now() / 1000, size = g.cpus ? `${g.cpus} CPUs, ${g.memory_gb} GB` : "not sized yet";
  let when = "";
  if (g.state === "running") when = g.busy ? "in use" : g.stop_at ? "idle, stops in " + Math.max(0, Math.round((g.stop_at - now) / 60)) + " min" : "";
  else if (g.state === "stopped") when = "since " + ago(g.since) + " · starts when a command needs it";
  else if (g.state === "starting") when = "for " + ago(g.since).replace(" ago", "");
  return `<i class="dot" style="background:${STATE_COLOR[g.state] || "var(--bad)"}"></i><b>${esc(g.state)}</b> · ${esc(size)}` +
    `${when ? " · " + esc(when) : ""}${g.why && g.state !== "running" ? " · " + esc(g.why) : ""}`;
}
// The machine's system as a chip (its name in words, never its colour alone), and a line under the
// name: what runs it (WSL in Windows, a VM on a Mac) and the Windows hosts it also takes.
const VIRT = {wsl2: "WSL 2", wsl1: "WSL 1", apple: "a VM", kvm: "a KVM VM", vmware: "a VMware VM", parallels: "a Parallels VM", qemu: "a QEMU VM"};
function family(m) {
  const s = (m.last || {}).system, g = m.guest;
  if (m.local) return "macos";
  if (s) return s.virt && s.virt.startsWith("wsl") ? "windows" : s.family;
  // No sample (a guest stopped): its kind says (WSL and a Parallels VM are Windows; Lima and OrbStack Linux).
  return g ? (g.kind === "wsl" || g.kind === "parallels" ? "windows" : "linux") : null;
}
function osChip(m) {
  const f = family(m);
  if (!f) return "";
  const label = {macos: "macOS", linux: "Linux", windows: "Windows + Linux"}[f];
  return `<span class="os os-${f}">${label}</span>`;
}
function osLine(m) {
  const s = (m.last || {}).system, w = (m.last || {}).windows, d = m.last || {};
  if (!s) return "";
  let t;
  if (s.virt && s.virt.startsWith("wsl")) {
    t = `<b>${esc(w ? w.name : "Windows")}</b> PC; its Linux is ${esc(s.name)} in ${VIRT[s.virt]}` +
      (d.mem ? ` (${d.cores} CPUs, up to ${MEM(d.mem.total)})` : "");
  } else if (s.virt) t = `<b>${esc(s.name)}</b> in ${esc(VIRT[s.virt] || s.virt)}`;
  else t = `<b>${esc(s.name)}</b>`;
  t += ` · ${esc(s.arch)}`;
  const wh = m.windows_hosts || [];
  if (wh.length) t += ` · Windows jobs as <b>${wh.map(esc).join(", ")}</b>`;
  return `<div class="place">${t}</div>`;
}
function card(m, all) {
  const d = m.last, f = m.farm || {}, gs = m.guest;
  let status, color;
  if (m.connected) { status = "connected"; color = "var(--good)"; }
  else if (gs && gs.state !== "running") { status = gs.state; color = STATE_COLOR[gs.state] || "var(--muted)"; }
  else { status = "not connected"; color = "var(--bad)"; }
  let html = `<div class="top"><div><span class="name">${esc(m.name)}</span> ${osChip(m)} <span class="model">${esc(d ? d.model || "" : "")}</span></div>` +
    `<span class="badge"><i class="dot" style="background:${color}"></i>${status}${m.rtt_ms != null && m.connected ? " · " + m.rtt_ms + " ms" : ""}</span></div>`;
  html += osLine(m);
  if (gs) html += `<div class="place">${esc(KIND[gs.kind] || gs.kind)} “${esc(gs.vm)}” on <b>${esc(gs.placement || "its Windows PC")}</b></div>` +
    `<div class="why">guest: ${guestLine(gs)}</div>`;
  const mine = all.filter(o => o.guest && o.guest.placement === m.name);
  if (mine.length) html += `<div class="row"><span class="lab">Guests</span><ul class="gl" style="margin:0">` +
    mine.map(o => `<li><b>${esc(o.name)}</b> (${esc(KIND[o.guest.kind] || o.guest.kind)}): ${guestLine(o.guest)}</li>`).join("") + "</ul></div>";
  if (gs && gs.state !== "running") return html;
  if (!m.local) {
    const ok = f.ok;
    html += `<div class="why">farm: <b style="color:${ok ? "var(--good)" : "var(--bad)"}">${ok ? "✓ usable" : "✕ not usable"}</b>` +
      `${ok ? "" : ": " + esc(f.why)} · probed ${ago(f.checked)}${f.probe_rtt_ms != null ? ", " + f.probe_rtt_ms + " ms" : ""}` +
      `${f.mbps != null ? ", " + f.mbps + " MB/s (" + ago(f.mbps_at) + ")" : ""}${f.link ? " · link " + esc(f.link) : ""}</div>`;
  }
  if (!d) return html + `<div class="why">${esc(m.error || "")}</div>`;
  if (!m.connected) html += `<div class="why">${esc(m.error || "")}</div>`;
  const c = d.cpu, cores = d.cores, idle = Math.max(0, 1 - c.farm - c.fleet - c.other);
  html += `<div class="row"><span class="lab">CPU</span><div>` +
    bar([[c.farm, "var(--farm)", "farm " + pct(c.farm)], [c.fleet, "var(--fleet)", "fleet " + pct(c.fleet)], [c.other, "var(--other)", "own " + pct(c.other)]], 1) +
    `<div class="val"><b>${pct(c.busy)}</b> of ${cores} cores · farm ${pct(c.farm)} · fleet ${pct(c.fleet)} · own ${pct(c.other)} · idle ${pct(idle)} · load ${d.load}</div>` +
    cpuSpark(m.history) + `</div></div>`;
  // A Windows machine whose Linux is WSL: Windows' view of the whole machine (WSL's VM is one of its processes).
  const w = d.windows;
  if (w) html += `<div class="row"><span class="lab">Windows</span><div>` +
    bar([[w.busy, "var(--other)", "whole machine " + pct(w.busy)]], 1) +
    `<div class="val"><b>${pct(w.busy)}</b> of the machine busy (WSL included) · <b>${MEM(w.mem_avail)}</b> available of ${MEM(w.mem_total)}` +
    `${w.mem_installed && w.mem_installed - w.mem_total > 2 ** 30 ? " (" + MEM(w.mem_installed) + " installed; the firmware keeps " + MEM(w.mem_installed - w.mem_total) + ", the GPU's)" : ""}` +
    ` · ${(d.jobs || []).filter(j => j.kind === "windows").length} Windows jobs</div></div></div>`;
  const g = d.gpu;
  if (g) html += `<div class="row"><span class="lab">GPU</span><div>` + bar([[(g.util || 0) / 100, "var(--farm)", "busy " + g.util + "%"]], 1) +
    `<div class="val"><b>${g.util ?? "?"}%</b> busy${g.mem_used != null ? " · " + GB(g.mem_used) + " in use" : ""}` +
    `${g.mem_total ? " of " + GB(g.mem_total) : ""}${g.power_w != null ? " · " + g.power_w + " W" : ""}${g.temp_c != null ? " · " + g.temp_c + " °C" : ""}</div>` +
    lineSpark(m.history, 4, "var(--farm)", "GPU busy %", 100) + `</div></div>`;
  const mem = d.mem, own = Math.max(0, mem.used - mem.farm_rss);
  // A Linux VM's memory is what its VM may take (WSL's cap, a guest's size), not the machine's.
  const sys_ = d.system || {}, inVm = sys_.virt != null;
  html += `<div class="row"><span class="lab">${w ? "Linux" : "Memory"}</span><div>` +
    bar([[mem.farm_rss, "var(--farm)", "farm " + MEM(mem.farm_rss)], [own, "var(--other)", "rest " + MEM(own)]], mem.total) +
    `<div class="val"><b>${MEM(mem.available)}</b> available of ${MEM(mem.total)}${inVm ? " (the VM's limit)" : ""} · farm ${MEM(mem.farm_rss)}` +
    `${mem.swap_used ? " · swap " + MEM(mem.swap_used) : ""}${mem.compressed ? " · compressed " + MEM(mem.compressed) : ""}</div></div></div>`;
  // Low: under 50 GB a plain write can have (an important one may get more, from what macOS purges).
  const dk = d.disk, used = dk.total - dk.free, low = dk.free < 50e9;
  html += `<div class="row"><span class="lab">Disk</span><div>` + bar([[used, low ? "var(--bad)" : "var(--other)", "used " + GB(used)]], dk.total) +
    `<div class="val"><b ${low ? 'style="color:var(--bad)"' : ""}>${low ? "⚠ " : ""}${GB(dk.free)}</b> free of ${GB(dk.total)}` +
    `${dk.important != null ? " · " + GB(dk.important) + " for an important write" : ""}</div></div></div>`;
  html += `<div class="row"><span class="lab">Network</span><div><div class="val">↓ <b>${rate(d.net.rx)}</b> · ↑ <b>${rate(d.net.tx)}</b>` +
    `${m.rtt_ms != null ? " · round trip " + m.rtt_ms + " ms" : ""}</div>` + lineSpark(m.history, 6, "var(--farm)", "received") + `<div class="val">received, 5 min</div>` +
    (m.local ? "" : lineSpark(m.history, 8, "var(--text2)", "round trip ms") + `<div class="val">round trip, 5 min</div>`) + `</div></div>`;
  const jobs = d.jobs || [];
  html += `<div class="row"><span class="lab">Jobs</span><div class="val"><b>${jobs.length}</b>` +
    `${m.local ? "" : " of " + f.slots + " test slots"} · ${d.compiles} compiles · ${d.fleet_jobs} fleet jobs` +
    `${d.idle_s != null ? " · " + (d.idle_s < 600 ? "<b>someone at it</b> (" + Math.round(d.idle_s) + " s)" : "no one at it") : ""}</div></div>`;
  if (jobs.length) html += '<ul class="jobs">' + jobs.map(j => `<li title="${esc(j.cmd)}"><b>${esc(j.kind)}</b> ${esc(j.checkout)} · ${(j.cpu).toFixed(1)} cores · ${GB(j.rss)} — ${esc(j.cmd)}</li>`).join("") + "</ul>";
  html += `<div class="foot">sampler: ${(d.probe_cpu * 100).toFixed(2)}% of a core · sample ${ago(d.t)}</div>`;
  return html;
}
async function tick() {
  try {
    const s = await (await fetch("/api/state", {cache: "no-store"})).json();
    // (a guest's cores and memory are its machine's, counted on that machine's card)
    const on = s.machines.filter(m => m.connected && m.last && !(m.guest && m.guest.placement));
    let cores = 0, farm = 0, fleet = 0, own = 0, jobs = 0, memAv = 0, memT = 0;
    for (const m of on) { const d = m.last, n = d.cores; cores += n; farm += d.cpu.farm * n; fleet += d.cpu.fleet * n; own += d.cpu.other * n;
      jobs += (d.jobs || []).length; memAv += d.mem.available; memT += d.mem.total; }
    $("#sum").innerHTML = `<b>${s.machines.filter(m => m.connected && m.last).length}</b> of ${s.machines.length} machines connected · <b>${cores}</b> cores: farm <b>${farm.toFixed(1)}</b>, ` +
      `fleet <b>${fleet.toFixed(1)}</b>, own <b>${own.toFixed(1)}</b>, idle <b>${Math.max(0, cores - farm - fleet - own).toFixed(1)}</b> · ` +
      `<b>${jobs}</b> farm jobs · memory ${MEM(memAv)} available of ${MEM(memT)}`;
    $("#grid").innerHTML = s.machines.map(m => `<section class="card ${m.connected ? "" : "off"} ${m.guest ? "guestcard" : ""}">${card(m, s.machines)}</section>`).join("");
  } catch (e) { $("#sum").textContent = "the dashboard's server is not answering: " + e; }
}
tick(); setInterval(tick, 2000);
</script></body></html>
