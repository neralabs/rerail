  else if (g.state === "stopped") when = "since " + ago(g.since) + " · starts when a command needs it";
  else if (g.state === "starting") when = "for " + ago(g.since).replace(" ago", "");
  // A cloud guest: its price, and while it runs what it has cost and its hard stop.
  if (g.cost_per_hour != null) {
    const ran = g.state === "running" ? (now - g.since) / 3600 : 0;
    when += ` · US$${g.cost_per_hour}/h` + (g.state === "running" ? `, US$${(ran * g.cost_per_hour).toFixed(2)} so far, stops by ${g.max_hours} h` : "");
  }
