#!/usr/bin/python3
"""The farm's dashboard: a live page of every host's state and this Mac's, served here only.

    scripts/build/farm/dashboard [--port 8740] [--open]

then http://127.0.0.1:8740/. Per machine: its CPU split between the farm's work (test commands,
Relax sessions, this Mac's compiles, and on this Mac Rerail's builds), the fleet's jobs, the
machine's own (external) load and idle; its GPU; memory used, the farm's share, and available; disk
used and free (and what macOS gives an important write); the farm's jobs running there; whether
someone is at it; the round trip through its connection now, its link and the farm's last measured
throughput, and its network traffic. Five minutes of history each.

How it costs little: one `sampler` per machine (scripts/build/farm/sampler), started over one ssh
connection and kept, reads the counters the system keeps every 3 seconds and sends one line; it
says what it used (`probe_cpu`: about 0.3% of one core). The reachability and throughput are the
farm's own probes' (its health records, read; the dashboard adds no probe). The ping is one line
each way every 2 seconds over the open connection. Nothing runs when the dashboard is not running:
the samplers end with their connection.

A card is one machine or one VM, with its own system: a Windows PC's card is Windows' (sampled by
`sampler.ps1` over its Windows ssh, `windows_ssh`, so it is live while its WSL is stopped), and
its WSL is a VM on it, as a Mac's Lima or OrbStack machine is. A guest's card comes after its
machine's. An entry that takes no jobs (a Windows VM's WSL 1) has none.

The page and its data stay on this machine (127.0.0.1): the hosts' names are the configuration's,
read at run time.
"""
import collections
import json
import os
import shlex
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import farm  # noqa: E402
import guest  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
HISTORY = 100          # samples kept: 5 minutes at 3 s
PING_SECONDS = 2
REFRESH_SECONDS = 20   # the configuration read again: hosts added, removed, enabled or not
STALE_SECONDS = 12     # no sample for this long: the machine's connection is shown as lost
SILENT_SECONDS = 30    # no line at all for this long (a Windows sampler's setup takes about 10 s): a new session
SAMPLER = os.path.join(HERE, "sampler")
WINDOWS_SAMPLER = os.path.join(HERE, "sampler.ps1")
LOCAL = "this Mac"


class Machine:
    def __init__(self, name, host=None):
        self.name, self.host = name, host
        self.lock = threading.Lock()
        self.last, self.history = None, collections.deque(maxlen=HISTORY)
        self.rtt_ms, self.rtts = None, collections.deque(maxlen=HISTORY)
        self.connected, self.error, self.since = False, "connecting", time.time()
        self.proc = None

    def command(self):
        if self.host is None:
            return ["/usr/bin/python3", "-u", SAMPLER, "--local"]
        if farm.host_os(self.host) == "windows":
            # Run in sshd's own PowerShell (sampler.ps1 says why), decoded there.
            import base64
            text = base64.b64encode(open(WINDOWS_SAMPLER, encoding="utf-8").read().encode("utf-16-le")).decode()
            return ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "ServerAliveInterval=5", "-o", "ServerAliveCountMax=3",
                    self.host["windows_ssh"], f"iex ([Text.Encoding]::Unicode.GetString([Convert]::FromBase64String('{text}')))"]
        return farm.ssh(self.name, "exec /usr/bin/python3 -u -c " + shlex.quote(open(SAMPLER).read()), "dash")

    def guest(self):
        """This machine's guest record and settings (guest.py), when it is a guest: its entry read
        afresh, so a host made a guest or no longer one shows as such without a restart."""
        if self.host is not None:
            self.host = farm.entry(self.name) or self.host
        base, g = guest.spec(self.host)
        # A Windows PC is no guest: its WSL is (a Windows VM is one whole, its WSL inside it).
        if g is None or (g["kind"] == "wsl" and farm.host_os(self.host) == "windows"):
            return None
        r = guest.record(base["name"])
        return {"kind": g["kind"], "on": g["on"], "placement": guest.placement(g), "vm": g["vm"],
                "state": r.get("state", "unknown"), "cpus": r.get("cpus"), "memory_gb": r.get("memory_gb"),
                "since": r.get("since"), "last_busy": r.get("last_busy"), "busy": r.get("busy"),
                "stop_at": r.get("stop_at"), "why": r.get("why"), "boot_s": r.get("boot_s"),
                "idle_minutes": g.get("idle_minutes", guest.IDLE_MINUTES),
                "cost_per_hour": g.get("cost_per_hour") if guest.is_cloud(g) else None,
                "max_hours": guest.cloud_limits()["max_hours"] if guest.is_cloud(g) else None}

    def parent(self, g):
        """The machine this one runs on (a guest's placement; WSL's, its Windows host), or None."""
        if self.host is None:
            return None
        if g:
            return g["placement"]
        return next((h["name"] for h in farm.hosts() if h.get("shares") == self.name and h.get("enabled", True)
                     and farm.host_os(h) == "windows" and farm.host_os(self.host) == "linux"), None)

    def run(self):
        backoff = 5
        while not getattr(self, "gone", False):
            if self.host is not None and not self.host.get("enabled", True):
                with self.lock:
                    self.connected, self.error = False, "disabled in the configuration"
                time.sleep(3)
                continue
            # A guest that is not running is not asked (an ssh to it would fail, or start it).
            g = self.host is not None and self.guest()
            if g and g["state"] != "running":
                with self.lock:
                    self.connected, self.error = False, f"a guest, {g['state']}"
                time.sleep(3)
                continue
            started = time.time()
            self.renew = False
            try:
                self.session()
            except Exception as e:  # noqa: BLE001 (a dashboard keeps going)
                self.error = f"{type(e).__name__}: {e}"
            if self.renew:  # the sampler's planned end (sampler.ps1): the next at once
                continue
            with self.lock:
                self.connected = False
            backoff = 5 if time.time() - started > 60 else min(backoff * 2, 120)
            with self.lock:
                self.retry_at = time.time() + backoff
            time.sleep(backoff)

    def session(self):
        p = self.proc = subprocess.Popen(self.command(), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.PIPE, text=True, bufsize=1)
        sent = {}
        alive = threading.Event()
        heard = [time.monotonic()]

        def pinger():
            # It also ends a session that has gone silent: a sampler stuck on its host (a Windows one never
            # sees the end of its input) would otherwise keep the card lost until the dashboard restarts.
            n = 0
            while not alive.is_set():
                if time.monotonic() - heard[0] > SILENT_SECONDS:
                    self.error = f"no word from the sampler for {SILENT_SECONDS} s; starting another"
                    p.kill()
                    return
                n += 1
                with self.lock:  # the reader pops pongs from `sent` under it
                    sent[str(n)] = time.monotonic()
                    for k in [k for k in sent if int(k) < n - 10]:
                        del sent[k]
                try:
                    p.stdin.write(f"ping {n}\n")
                    p.stdin.flush()
                except OSError:
                    return
                alive.wait(PING_SECONDS)
        threading.Thread(target=pinger, daemon=True).start()
        err = collections.deque(maxlen=5)
        threading.Thread(target=lambda: [err.append(line.strip()) for line in p.stderr], daemon=True).start()
        try:
            for line in p.stdout:
                heard[0] = time.monotonic()
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if d.get("bye"):
                    self.renew = True
                    break
                with self.lock:
                    if "pong" in d:
                        t = sent.pop(d["pong"], None)
                        if t is not None:
                            self.rtt_ms = round((time.monotonic() - t) * 1000, 1)
                            self.rtts.append((time.time(), self.rtt_ms))
                        continue
                    d["rtt_ms"] = self.rtt_ms
                    self.last = d
                    self.history.append(d)
                    if not self.connected:
                        self.connected, self.since, self.error = True, time.time(), None
        finally:
            alive.set()
            p.kill()
            p.wait()
            if time.monotonic() - heard[0] <= SILENT_SECONDS:  # else the pinger said why it ended it
                self.error = " / ".join(e for e in err if e) or f"the sampler ended (exit {p.returncode})"

    def state(self):
        with self.lock:
            fresh = self.last is not None and time.time() - self.last["t"] < STALE_SECONDS
            h = {} if self.host is None else farm.read_json(farm.state("health", self.name), {})
            out = {"name": self.name, "local": self.host is None, "connected": self.connected and fresh,
                   "error": None if (self.connected and fresh) else (self.error or "no sample lately"),
                   "since": self.since, "retry_at": getattr(self, "retry_at", None),
                   "last": self.last, "rtt_ms": self.rtt_ms,
                   "history": [compact(d) for d in self.history]}
        if self.host is not None:
            out["farm"] = {"ok": h.get("ok"), "why": h.get("why"), "checked": h.get("checked"),
                           "probe_rtt_ms": h.get("rtt_ms"), "mbps": h.get("mbps"), "mbps_at": h.get("mbps_at"),
                           "link": farm.link_of(self.host), "enabled": self.host.get("enabled", True),
                           "tests": self.host.get("tests", True), "mirror": self.host.get("mirror", True),
                           "slots": farm.test_slots(self.host), "down_until": h.get("down_until")}
            g = out["guest"] = self.guest()
            out["os"] = farm.host_os(self.host)
            out["parent"] = self.parent(g)
            if out["os"] == "windows":
                # Its jobs run through its WSL (farm-agent's windows_job): stopped, it starts for one.
                base, bg = guest.spec(self.host)
                if bg and bg["kind"] == "wsl":
                    out["via"] = {"name": base["name"], "state": guest.record(base["name"]).get("state", "unknown")}
                if out["rtt_ms"] is None:
                    out["rtt_ms"] = h.get("rtt_ms")  # no pings through sshd's PowerShell: the probe's
        else:
            out["os"], out["parent"] = "macos", None
        return out


def compact(d):
    c = d.get("cpu", {})
    return [round(d["t"], 1), c.get("farm", 0), c.get("fleet", 0), c.get("other", 0), (d.get("gpu") or {}).get("util"),
            d.get("mem", {}).get("used"), round(d.get("net", {}).get("rx", 0)), round(d.get("net", {}).get("tx", 0)), d.get("rtt_ms")]


MACHINES = []


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def send(self, body, kind):
        data = body.encode()
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path.startswith("/api/state"):
            self.send(json.dumps({"now": time.time(), "machines": [m.state() for m in MACHINES], "cloud": guest.budget()}), "application/json")
        elif self.path in ("/", "/index.html"):
            self.send(PAGE, "text/html; charset=utf-8")
        else:
            self.send_error(404)


def layout():
    """The cards' order from the configuration as it is now: one a machine or VM, a guest's after its
    machine's; disabled hosts too (marked, not sampled); none for an entry that takes no jobs (a
    Windows VM's WSL 1, there for its Windows side)."""
    hosts = [h for h in farm.hosts() if h.get("tests", True) or h.get("mirror", True)]
    parents = {}
    for h in hosts:
        m = Machine(h["name"], h)
        parents[h["name"]] = m.parent(m.guest())
    order = [LOCAL] + [h["name"] for h in hosts if not parents[h["name"]]]
    for h in hosts:
        if parents[h["name"]]:
            at = order.index(parents[h["name"]]) if parents[h["name"]] in order else len(order) - 1
            while at + 1 < len(order) and parents.get(order[at + 1]) == parents[h["name"]]:
                at += 1
            order.insert(at + 1, h["name"])
    by_name = {h["name"]: h for h in hosts}
    return [(n, by_name[n]) for n in order[1:]]


def refresh():
    """MACHINES as the configuration says now: a host added gets its card and sampler, one removed
    loses them, a host's entry is read afresh (enabled or not). Every REFRESH_SECONDS."""
    while True:
        try:
            have = {m.name: m for m in MACHINES[1:]}
            new = []
            for name, h in layout():
                m = have.pop(name, None)
                if m is None:
                    m = Machine(name, h)
                    threading.Thread(target=m.run, daemon=True).start()
                m.host = h
                new.append(m)
            for m in have.values():
                m.gone = True
                if m.proc and m.proc.poll() is None:
                    m.proc.kill()
            MACHINES[1:] = new
        except Exception as e:  # noqa: BLE001 (a dashboard keeps going)
            print(f"dashboard: the configuration could not be read: {e}", file=sys.stderr, flush=True)
        time.sleep(REFRESH_SECONDS)


def main(argv):
    port = int(argv[argv.index("--port") + 1]) if "--port" in argv else 8740
    MACHINES.append(Machine(LOCAL))
    threading.Thread(target=MACHINES[0].run, daemon=True).start()
    threading.Thread(target=refresh, daemon=True).start()
    time.sleep(0.5)
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{port}/"
    print(f"dashboard: {url} ({len(MACHINES)} machines; ^C ends it, and the samplers with it)", flush=True)
    if "--open" in argv:
        subprocess.run(["open", url])
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        for m in MACHINES:
            if m.proc and m.proc.poll() is None:
                m.proc.kill()


