#!/usr/bin/python3
"""A host's end of the farm's live mirror (scripts/build/farm/README.md, "Live mirror").

The build machine's mirror daemon starts this over ssh and keeps it: one connection per host. Frames
both ways are a 4-byte big-endian header length, a JSON header, and `size` bytes of payload.

Everything this writes is under one root of the farm's own, ROOT (`~/Library/Caches/rerail-farm/
root.noindex`): a build machine's path P is kept at ROOT + P. Nothing of the host's own is ever
written, moved or mounted over (README.md, "The farm's root on a host").

From the daemon:
- {"op": "put", "path", "mtime_ns", "mode", "size"} + bytes: writes the file kept for that path,
  through a temporary file, so a compile never reads half of it. Its mtime here is the time of the
  write, never the build machine's: a cargo here (`test-remote`) then rebuilds what a late-arriving
  file changed, however old the file is there. The build machine's mtime and size are kept with
  the file (an extended attribute), and `seen` reports those while the file is as written.
- {"op": "have", "id", "paths"}: replies {"op": "had", "id", "seen"}, each path's [mtime_ns, size]
  (null when missing): what an earlier connection already wrote.
- {"op": "unlisted", "id", "root", "listed"}: replies {"op": "unlisted!", "id", "files"}, each file
  under `root`'s copy that the daemon wrote (it carries the attribute) and `listed` does not name,
  with its `seen`. The daemon asks it for a checkout before a test command runs, with what it just
  synced there, and keeps those the build machine no longer has (`remove`). Files a command here
  made carry no attribute and are never named.
- {"op": "remove", "id", "root", "files"}: removes each of `files` (a path: its `seen`, as
  `unlisted` named it) while it is still that file the daemon wrote, and the directories that
  leaves empty, up to `root`'s copy. Replies {"op": "removed", "id", "paths"}: those removed.
- {"op": "same", "id", "files"}: `files` maps paths of this host's own (a crate in its cargo
  registry, at the path it has on the build machine too) to their sha256 there. Replies {"op":
  "same?", "id", "differ"}: those missing or different here. Only read: a compile then reads that
  crate in place, at the very path the build machine compiles it from, and rustc's output is the
  same bytes (rustc hashes a source file's real path into it, remapped or not).
- {"op": "run", "id", "cwd", "argv", "env", "dirs", "outputs", "depinfo", "map", "inplace", "externs"}: runs
  the compile in a thread of its own; `inplace` lists the directories it reads in place (`same`). `map` lists the build machine's paths that are kept here: every one of
  them in the arguments, the environment and `cwd` is replaced by where it is kept, and
  `--remap-path-prefix ROOT=/` (rustc's lowest-precedence remap; rustc strips a prefix by path components, so `/` puts the leading slash back) gives the compile's paths back.
  Replies with a "file" frame per output (the dep-info with ROOT taken out), then {"op": "done",
  "id", "code", "stdout", "stderr", "read"}: `read` maps each file the dep-info lists, and each of `externs` (its `--extern` crates), to
  [mtime_ns, size] as `seen`, for the daemon to check against its own. An output that names ROOT
  (a path written into it that no remap reached, such as `env!("CARGO_MANIFEST_DIR")`) is not sent:
  code 71, and the compile runs on the build machine. A put that fails makes every later run fail
  with code 70: the daemon then drops this agent and forgets what it sent. An output the compile
  did not write: code 72, and the compile runs on the build machine.
  With "xc": {"home", "toolchain"} (a Mac's compile on a Linux host), the compile runs in this
  host's container instead (`xc_container`), where the build machine's paths are real: ROOT's copy
  of the build machine's top directory at its own path (the daemon sends the crate's sources
  there too), and this host's rustup at /opt/rustup. Nothing is mapped; the same toolchain's Linux rustc compiles for aarch64-apple-darwin, and the bytes are the
  build machine's own (README, "Mac compiles on a Linux host").

The stream starts on ssh. The daemon's first frame may be {"op": "tcp", "port", "token"}: the agent
then connects back to the build machine (at the address this connection came from: the fast link,
which `farm.health` checked) on that port, sends the token, and every later frame both ways goes
over that plain TCP connection, which costs no encryption and no ssh flow control. ssh stays open as
the lifeline: when it ends, the agent ends. If the connection cannot be made, it replies
{"op": "tcp-failed", "why"} on ssh and stays there.
"""
import ctypes, glob, json, os, re, socket, struct, subprocess, sys, threading, time, traceback


def leave(kind, value, tb):
    """An uncaught exception (the daemon's connection reset, a broken pipe) ends the agent at once,
    as the stream's end does: a normal exit finalizes the interpreter while another thread holds
    stdin's lock, and Python aborts ("Fatal Python error: _enter_buffered_busy"), which macOS reports
    as a crash on the host (5 in half an hour, 2026-11-17)."""
    try:
        traceback.print_exception(kind, value, tb)
        sys.stderr.flush()
    finally:
        os._exit(1)


sys.excepthook = leave

# The farm's own directory on the host: macOS's caches, or on Linux XDG's.
MACOS = sys.platform == "darwin"
FARM = os.path.join(os.path.expanduser("~"), "Library/Caches/rerail-farm") if MACOS else \
    os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "rerail-farm")
# A Windows host's builds: its farm directory on the Windows drive, as its WSL mounts it (`windows_dir`).
WINDIR = os.environ.get("RERAIL_FARM_WINDIR")
ROOT = os.path.join(FARM, "root.noindex")
# Linux keeps a program's attributes in the `user.` namespace.
XATTR = b"org.rerail.farm.sent" if MACOS else b"user.org.rerail.farm.sent"

out = sys.stdout.buffer
inp = sys.stdin.buffer
write_lock = threading.Lock()
refused = []

if MACOS:
    # Python has no xattr calls on macOS: libc's, which take a position and options.
    libc = ctypes.CDLL(None, use_errno=True)
    libc.getxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
    libc.getxattr.restype = ctypes.c_ssize_t
    libc.setxattr.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint32, ctypes.c_int]
    libc.setxattr.restype = ctypes.c_int


def get_tag(path, follow=True):
    """The attribute's bytes on `path` (None: it has none)."""
    if not MACOS:
        try:
            return os.getxattr(path, XATTR, follow_symlinks=follow)
        except OSError:
            return None
    buf = ctypes.create_string_buffer(96)
    n = libc.getxattr(path.encode(), XATTR, buf, 96, 0, 0 if follow else 0x0001)  # XATTR_NOFOLLOW
    return buf.raw[:n] if n > 0 else None


def set_tag(path, tag):
    if not MACOS:
        os.setxattr(path, XATTR, tag)
        return
    if libc.setxattr(path.encode(), XATTR, tag, len(tag), 0, 0) != 0:
        e = ctypes.get_errno()
        raise OSError(e, "setxattr failed", path)


def at(path):
    """Where the build machine's absolute `path` is kept here: always under ROOT."""
    if not path.startswith("/"):
        raise OSError(f"not an absolute path: {path!r}")
    return ROOT + os.path.normpath(path)


def send(header, payload=b""):
    header = dict(header, size=len(payload))
    data = json.dumps(header).encode()
    with write_lock:
        out.write(struct.pack(">I", len(data)) + data + payload)
        out.flush()


def receive():
    head = inp.read(4)
    if len(head) < 4:
        return None, None
    header = json.loads(inp.read(struct.unpack(">I", head)[0]))
    return header, inp.read(header.get("size", 0))


def seen(kept, touch=False):
    """[mtime_ns, size] of the file kept at `kept`, as the build machine had it when it was sent (its
    attribute), while the file is as it was written; else as it is here; None when missing. `touch`
    (the daemon asks what a run will read): its access time becomes now, so prune_root counts it as
    used from here on, never removing it under the run that was just told it is here."""
    try:
        st = os.stat(kept)
    except OSError:
        return None
    if touch:
        try:
            os.utime(kept, ns=(time.time_ns(), st.st_mtime_ns))
        except OSError:
            pass
    tag = get_tag(kept)
    if tag:
        try:
            mtime, size, written = (int(x) for x in tag.split())
            if written == st.st_mtime_ns and size == st.st_size:
                return [mtime, size]
        except ValueError:
            pass
    return [st.st_mtime_ns, st.st_size]


hashes = {}


def sha(path):
    """The sha256 of this host's file `path`, kept while its mtime and size stay (None: unreadable)."""
    import hashlib
    try:
        st = os.stat(path)
    except OSError:
        return None
    k = (st.st_mtime_ns, st.st_size)
    if hashes.get(path, (None,))[0] != k:
        try:
            hashes[path] = (k, hashlib.sha256(open(path, "rb").read()).hexdigest())
        except OSError:
            return None
    return hashes[path][1]


def under(path, dirs):
    return any(path == d or path.startswith(d.rstrip("/") + "/") for d in dirs)


def under_mount(path):
    # macOS: `X on /path (nfs, ...)`; Linux: `X on /path type nfs (...)`.
    mounts = [re.sub(r" type \S+$", "", l.split(" on ", 1)[1].rsplit(" (", 1)[0]) for l in
              subprocess.run(["mount", "-t", "nfs,autofs"], capture_output=True, text=True).stdout.splitlines() if " on " in l]
    return any(path == m or path.startswith(m.rstrip("/") + "/") for m in mounts)


def put(header, payload):
    kept = at(header["path"])
    os.makedirs(os.path.dirname(kept), exist_ok=True)
    tmp = f"{kept}.farm-{os.getpid()}-{threading.get_ident()}"
    with open(tmp, "wb") as f:
        f.write(payload)
    written = os.stat(tmp).st_mtime_ns
    tag = f"{header['mtime_ns']} {len(payload)} {written}".encode()
    # The attribute before the mode: macOS refuses it on a read-only file (EACCES), and a tree's
    # git objects are read-only: every one failed, and the daemon dropped this agent each time
    # (2026-11-17).
    try:
        set_tag(tmp, tag)
    except OSError as e:
        os.unlink(tmp)
        raise OSError(e.errno, "setxattr failed", kept)
    os.chmod(tmp, header.get("mode", 0o644) & 0o7777)
    os.replace(tmp, kept)


def has_tag(path):
    return get_tag(path, follow=False) is not None


def unlisted(header):
    """The files the daemon wrote under `root`'s copy that `listed` does not name (`unlisted`)."""
    top, listed, files = at(header["root"]), set(header["listed"]), {}
    for d, _, names in os.walk(top):
        for n in names:
            kept = os.path.join(d, n)
            path = kept[len(ROOT):]
            if path in listed or ".farm-" in n or os.path.islink(kept) or not has_tag(kept):
                continue
            files[path] = seen(kept)
    send({"op": "unlisted!", "id": header["id"], "files": files})


def remove(header):
    """Removes the files the build machine no longer has (`remove`): only while each is the very
    file the daemon wrote, so a file sent again since stays."""
    top, removed = at(header["root"]), []
    for path, was in header["files"].items():
        kept = at(path)
        if not kept.startswith(top + "/") or not has_tag(kept) or seen(kept) != was:
            continue
        try:
            os.unlink(kept)
        except OSError:
            continue
        removed.append(path)
        d = os.path.dirname(kept)
        while d != top and d.startswith(top + "/"):
            try:
                os.rmdir(d)
            except OSError:
                break
            d = os.path.dirname(d)
    send({"op": "removed", "id": header["id"], "paths": removed})


# ---- a Mac's compile on a Linux host (farm 32)

XC_NAME = "rerail-farm-xc"
# Only glibc is needed: rustc's own libraries. No linker: only libraries' compiles come here.
XC_IMAGE = "ubuntu:24.04"
xc_lock = threading.Lock()
xc_ready = set()


def docker(*args, timeout=120):
    return subprocess.run(["docker", *args], capture_output=True, text=True, timeout=timeout)


def xc_container(home):
    """Starts this host's compile container for the build machine's `home` unless it runs: None, or
    why it could not. Only the farm's own container (by its name) is ever removed or replaced."""
    with xc_lock:
        if home in xc_ready:
            return None
        top = "/" + home.strip("/").split("/")[0]
        r = docker("inspect", "-f", '{{.State.Running}} {{index .Config.Labels "rerail.farm.home"}}', XC_NAME)
        if r.returncode == 0 and r.stdout.split() == ["true", home]:
            xc_ready.add(home)
            return None
        if r.returncode == 0:
            docker("rm", "-f", XC_NAME)
        if docker("image", "inspect", XC_IMAGE).returncode != 0:
            p = docker("pull", "-q", XC_IMAGE, timeout=600)
            if p.returncode:
                return f"docker pull {XC_IMAGE}: {p.stderr[-300:]}"
        os.makedirs(ROOT + top, exist_ok=True)
        mounts = [(ROOT + top, top, "rw"), (os.path.expanduser("~/.rustup"), "/opt/rustup", "ro")]
        cmd = ["run", "-d", "--name", XC_NAME, "--label", "rerail.farm=xc", "--label", f"rerail.farm.home={home}",
               "--network", "none", "--user", f"{os.getuid()}:{os.getgid()}", "--entrypoint", "sleep"]
        for src, dst, mode in mounts:
            cmd += ["-v", f"{src}:{dst}:{mode}"]
        r = docker(*cmd, XC_IMAGE, "infinity")
        if r.returncode:
            return f"docker run: {r.stderr[-300:]}"
        xc_ready.add(home)
        return None


# The Linux builds of the proc-macros a Mac's compile loads, and of what they link: one directory a
# recorded compile (by its record's hash), shared by every proc-macro that links it.
XC_PM = os.path.join(FARM, "xc-pm.noindex")
# This host's own target (an x86_64 host as well as an ARM one): its rustc, and its proc-macros' builds.
HOST_TRIPLE = ("x86_64" if os.uname().machine in ("x86_64", "amd64") else "aarch64") + "-unknown-linux-gnu"
TRIPLE_LINUX = HOST_TRIPLE.encode()
TRIPLE_MAC = b"aarch64-apple-darwin"


def svh_at(data, triple):
    """Where a crate's SVH is in its metadata: the 16 bytes after its header's target triple (its
    length, its bytes, and the 0xC1 that ends every string there). The crates that load it record
    the same 16 bytes. None: not found once."""
    tag = bytes([len(triple)]) + triple + b"\xc1"
    at_ = data.find(tag)
    if at_ < 0 or data.find(tag, at_ + 1) >= 0:
        return None
    return at_ + len(tag)


def outputs_of(args):
    crate = value_of(args, "--crate-name")
    extra = next((a.split("=", 1)[1] for i, a in enumerate(args) if a.startswith("extra-filename=") and args[i - 1] == "-C"), "")
    return crate, extra


def value_of(args, flag):
    for i, a in enumerate(args):
        if a == flag and i + 1 < len(args):
            return args[i + 1]
        if a.startswith(flag + "="):
            return a[len(flag) + 1:]
    return None


def stem_of(path):
    d, f = os.path.split(path)
    return os.path.join(d, os.path.splitext(f[3:] if f.startswith("lib") else f)[0])


def pm_build(pm, toolchain):
    """Builds `pm["dylib"]` (a proc-macro the build machine compiled) for this host from its record
    and its dependencies' (`pm["calls"]`, dependencies first), each in a directory of its own here,
    with this host's rustc and linker, at the copies of their sources under ROOT. Then puts the
    build machine's SVH into the Linux library (`svh_at`) and writes it beside the dylib's copy, as
    `.so`: the compile in the container loads it from there. None, or why it could not."""
    import fcntl, hashlib, shutil
    rustc = os.path.expanduser(f"~/.rustup/toolchains/{toolchain}-{HOST_TRIPLE}/bin/rustc")
    built = {}  # the build machine's stem -> this host's output directory
    closure = {}  # the build machine's stem -> the directories of all it links (rustc's -L dependency)
    for rec in pm["calls"]:
        args = rec["args"]
        crate, extra = outputs_of(args)
        stem = os.path.join(os.path.abspath(os.path.join(rec["cwd"], value_of(args, "--out-dir"))), crate + extra)
        deps = []
        out = []
        i = 0
        while i < len(args):
            a = args[i]
            nxt = args[i + 1] if i + 1 < len(args) else ""
            if a == "--out-dir" or (a == "-C" and nxt.startswith("incremental=")):
                i += 2
                continue
            if a == "-L" and nxt.startswith("dependency="):
                i += 2
                continue
            if a == "--extern" and "=" in nxt:
                name, path = nxt.split("=", 1)
                dep = stem_of(os.path.abspath(os.path.join(rec["cwd"], path)))
                d = built.get(dep)
                if d is None:
                    return f"{crate}: its dependency {os.path.basename(path)} was not built first"
                f = os.path.basename(path)
                if f.endswith(".dylib"):
                    f = f[:-len(".dylib")] + ".so"
                out += [a, f"{name}={os.path.join(d, f)}"]
                deps += [d] + sorted(closure[dep])
                i += 2
                continue
            out.append(a)
            i += 1
        key = hashlib.sha256(json.dumps([rec, sorted(set(deps)), toolchain], sort_keys=True).encode()).hexdigest()[:24]
        d = os.path.join(XC_PM, key)
        built[stem] = d
        closure[stem] = set(deps)
        main = os.path.join(d, f"lib{crate}{extra}" + (".so" if rec.get("proc_macro") else ".rlib"))
        if os.path.exists(os.path.join(d, ".done")) and os.path.exists(main):
            # (every file used now: the prune goes file by file, and a build lacking one is redone)
            try:
                for f in os.listdir(d):
                    os.utime(os.path.join(d, f))
                continue
            except OSError:
                pass
        os.makedirs(XC_PM, exist_ok=True)
        with open(d + ".lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if os.path.exists(os.path.join(d, ".done")) and os.path.exists(main):
                continue
            if os.path.exists(d):
                shutil.rmtree(d)
            os.makedirs(d)
            m = mapper([rec["cwd"]] + ([rec["env"]["OUT_DIR"]] if rec["env"].get("OUT_DIR") else []))
            env = dict(os.environ)
            env.update({k: m(v) for k, v in rec["env"].items()})
            argv = map_args([rustc] + out, m) + ["--out-dir", d] + [x for dd in sorted(set(deps)) for x in ("-L", f"dependency={dd}")]
            done = subprocess.run(argv, cwd=at(rec["cwd"]), env=env, stdin=subprocess.DEVNULL, capture_output=True)
            if done.returncode:
                return f"{crate}: its Linux build failed: {done.stderr.decode('latin-1')[-400:]}"
            open(os.path.join(d, ".done"), "w").close()
    crate, extra = outputs_of(pm["calls"][-1]["args"])
    so = os.path.join(built[stem_of(pm["dylib"])], f"lib{crate}{extra}.so")
    try:
        linux = open(so, "rb").read()
        mac = open(at(pm["dylib"]), "rb").read()
    except OSError as e:
        return f"{crate}: {e}"
    i, j = svh_at(linux, TRIPLE_LINUX), svh_at(mac, TRIPLE_MAC)
    if i is None or j is None:
        return f"{crate}: its SVH was not found (once) in its metadata"
    patched = linux.replace(linux[i:i + 16], mac[j:j + 16])
    dest = at(pm["dylib"][:-len(".dylib")] + ".so")
    with open(dest + ".tmp", "wb") as f:
        f.write(patched)
    os.chmod(dest + ".tmp", 0o755)
    os.replace(dest + ".tmp", dest)
    return None


def xc_argv(job):
    """The `docker exec` that runs the build machine's compile `job` in the container."""
    xc = job["xc"]
    rustc = f"/opt/rustup/toolchains/{xc['toolchain']}-{HOST_TRIPLE}/bin/rustc"
    args = job["argv"][1:]
    # On the Mac the target is the host's: named here, it is the same compile (the outputs' bytes too).
    if not any(a == "--target" or a.startswith("--target=") for a in args):
        args = ["--target", "aarch64-apple-darwin"] + args
    # A proc-macro it loads: this host's build of it, beside the dylib (`pm_build`).
    dylibs = {pm["dylib"] for pm in job.get("pm", [])}
    args = [a[:-len(".dylib")] + ".so" if "=" in a and a.split("=", 1)[1] in dylibs else a for a in args]
    env = [f"{k}={v}" for k, v in job["env"].items() if k != "PATH"] + ["PATH=/usr/bin:/bin"]
    return ["docker", "exec", "-w", job["cwd"], XC_NAME, "env", "-i", *env, rustc, *args]


def mapper(prefixes):
    """Replaces each of `prefixes` (the build machine's paths kept here) where it starts a path: at the
    start of a string or after `=`, `:` or a space, and ending there or before `/`, `=`, `:` or a space."""
    ps = sorted({os.path.normpath(p) for p in prefixes if p.startswith("/") and p != "/"}, key=len, reverse=True)
    if not ps:
        return lambda s: s
    rx = re.compile(r"(?<![^=:\s])(" + "|".join(re.escape(p) for p in ps) + r")(?=/|$|[=:\s])")
    return lambda s: rx.sub(lambda m: ROOT + m.group(1), s)


def map_args(argv, m):
    """rustc's arguments with the kept paths mapped. A `--remap-path-prefix FROM=TO` maps its FROM
    only (TO is what the outputs say). `--remap-path-prefix ROOT=/` goes first: rustc applies the
    last remap that matches, so every remap given keeps its meaning, and the rest of ROOT goes."""
    out, i = [argv[0], "--remap-path-prefix", f"{ROOT}=/"], 1
    while i < len(argv):
        a = argv[i]
        if a == "--remap-path-prefix" and i + 1 < len(argv):
            src, eq, dst = argv[i + 1].partition("=")
            out += [a, m(src) + eq + dst]
            i += 2
            continue
        if a.startswith("--remap-path-prefix="):
            src, eq, dst = a[len("--remap-path-prefix="):].partition("=")
            out.append("--remap-path-prefix=" + m(src) + eq + dst)
        else:
            out.append(m(a))
        i += 1
    return out


def run(job):
    if refused:
        send({"op": "done", "id": job["id"], "code": 70, "stdout": "", "read": {},
              "stderr": f"a file was not written: {refused[0]}"})
        return
    m = mapper(job.get("map", []))
    try:
        for d in job["dirs"]:
            os.makedirs(at(d), exist_ok=True)
        if job.get("xc"):
            why = xc_container(job["xc"]["home"])
            for pm in job.get("pm", []):
                why = why or pm_build(pm, job["xc"]["toolchain"])
            if why:
                raise OSError(why)
            done = subprocess.run(xc_argv(job), stdin=subprocess.DEVNULL, capture_output=True)
            if done.returncode != 0 and (b"is not running" in done.stderr or b"No such container" in done.stderr):
                # (stopped since: a reboot, docker's restart) started again, once
                xc_ready.discard(job["xc"]["home"])
                why = xc_container(job["xc"]["home"])
                if why:
                    raise OSError(why)
                done = subprocess.run(xc_argv(job), stdin=subprocess.DEVNULL, capture_output=True)
        else:
            cwd = m(job["cwd"])
            argv = map_args(job["argv"], m) if len(job["argv"]) > 1 else job["argv"]
            env = {k: m(v) for k, v in job["env"].items()}
            done = subprocess.run(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, capture_output=True)
        code, stdout, stderr = done.returncode, done.stdout, done.stderr
    except OSError as e:
        code, stdout, stderr = 127, b"", str(e).encode()
    read = {}
    root = ROOT.encode()
    # In the container nothing names ROOT; what must not leak there is this host's own paths.
    leaks = [root] + ([os.path.expanduser("~").encode() + b"/", b"/opt/rustup/"] if job.get("xc") else [])
    if code == 0:
        files = []
        for path in job["outputs"]:
            try:
                data = open(at(path), "rb").read()
            except OSError:
                # Every output or none: the build machine compiles it itself (an output left out
                # kept the last compile's there, beside this one's others: Q377).
                code, stderr = 72, f"{path}: not written by the compile".encode()
                break
            if path == job.get("depinfo"):
                data = data.replace(root + b"/", b"/")
            if any(x in data for x in leaks):
                code, stderr = 71, f"{path} names this host's farm root or home: compiled on the build machine instead".encode()
                break
            files.append((path, data))
        if code == 0:
            for path, data in files:
                send({"op": "file", "id": job["id"], "path": path}, data)
            try:
                text = open(at(job["depinfo"])).read().replace("\\\n", " ") if job.get("depinfo") else ""
            except OSError:
                text, read = "", {"?": None}
            inplace = job.get("inplace", [])
            for line in text.splitlines():
                if not line.startswith("#") and ":" in line:
                    for path in line.split(":", 1)[1].split():
                        p = path[len(ROOT):] if path.startswith(ROOT + "/") else path
                        full = p if p.startswith("/") else os.path.normpath(os.path.join(job["cwd"], p))
                        # Read in place: its content was checked (`same`) just before.
                        read[p] = "inplace" if under(full, inplace) else seen(at(full))
            # The `--extern` crates it read: the dep-info does not list them.
            for p in job.get("externs", []):
                read[p] = seen(at(p))
    send({"op": "done", "id": job["id"], "code": code, "stdout": stdout.decode("latin-1").replace(ROOT + "/", "/"),
          "stderr": stderr.decode("latin-1").replace(ROOT + "/", "/"), "read": read})


def over_tcp(header):
    """Moves the stream to a TCP connection back to the build machine (see above); False if none."""
    global out, inp
    client = os.environ.get("SSH_CONNECTION", "").split()[:1]
    try:
        if not client:
            raise OSError("no SSH_CONNECTION")
        sock = socket.create_connection((client[0], header["port"]), timeout=5)
        sock.settimeout(None)
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        for opt in (socket.SO_SNDBUF, socket.SO_RCVBUF):
            sock.setsockopt(socket.SOL_SOCKET, opt, 8 << 20)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        # A dead link is noticed in about 10 s, not macOS's default 2 hours.
        # (TCP_KEEPALIVE, the idle time, is 0x10 on macOS; Python names it only on some builds.)
        for opt, v in ((getattr(socket, "TCP_KEEPALIVE", 0x10), 4), (socket.TCP_KEEPINTVL, 2), (socket.TCP_KEEPCNT, 3)):
            sock.setsockopt(socket.IPPROTO_TCP, opt, v)
        sock.sendall(header["token"].encode() + b"\n")
    except (OSError, KeyError) as e:
        send({"op": "tcp-failed", "why": repr(e)})
        return False
    lifeline = inp

    def watch():
        while lifeline.read(65536):
            pass
        os._exit(0)
    out, inp = sock.makefile("wb"), sock.makefile("rb")
    threading.Thread(target=watch, daemon=True).start()
    return True


TARGETS = os.path.join(FARM, "targets.noindex")
# The commands' TMPDIR: the farm's, so what their runs leave (stores, scratch) is the farm's to free,
# never the host's own temporary directory (pruned as the root is, every file counting).
TMP = os.path.join(FARM, "tmp.noindex")
# A lock per directory a command runs in (its checkout's copy, its trees): held shared while it runs,
# so prune_root leaves those directories alone (`busy`).
BUSY = os.path.join(FARM, "busy.noindex")
# A test target directory unused this long goes; so do the least recently used ones while the disk
# has less free than the run asks for and PRUNE_HEADROOM_GB more: pruning only to the farm's own
# threshold left the host just above it, and the next run's build took it below (unusable).
TARGET_DAYS = 3
PRUNE_HEADROOM_GB = 40
# A target directory is cleaned (scripts/dev/clean-target: builds no current build was made from,
# debug objects no binary names, stale incremental state) after a command that used it ends, at most
# this often. Without it a host's targets grew without bound: 207 GB on one host, 195 GB of it
# leftovers (2026-11-16).
CLEAN_SECONDS = 15 * 60


# The free disk macOS gives an important write: what is free and what it purges for it (Time
# Machine's hourly local snapshots, caches). statvfs leaves that out: one host showed 19 GB free
# with 691 GB available, the snapshots holding a day of every file the farm had deleted (2026-11-17).
AVAILABLE_JS = ('ObjC.import("Foundation"); var r = Ref(); $.NSURL.fileURLWithPath($.NSHomeDirectory())'
                '.getResourceValueForKeyError(r, $.NSURLVolumeAvailableCapacityForImportantUsageKey, null); String(r[0].js)')


def free_gb():
    try:
        out = subprocess.run(["osascript", "-l", "JavaScript", "-e", AVAILABLE_JS], capture_output=True, text=True, timeout=10)
        b = float(out.stdout.strip())
        if b > 0:
            return b / (1 << 30)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    st = os.statvfs(os.path.expanduser("~"))
    return st.f_bavail * st.f_frsize / (1 << 30)


def target_lock(name, exclusive):
    """The lock of the test target `name` (in TARGETS/.locks, outside the directory it guards): a
    command holds it shared while it runs, prune exclusively while it removes the directory. Held
    until the returned file closes; None when `exclusive` and someone holds it."""
    import fcntl
    os.makedirs(os.path.join(TARGETS, ".locks"), exist_ok=True)
    f = open(os.path.join(TARGETS, ".locks", name), "a+")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB if exclusive else fcntl.LOCK_SH)
    except OSError:
        f.close()
        return None
    return f


def busy_lock(path):
    """Holds `path` (a directory a command runs in) busy until the returned file closes."""
    import fcntl, hashlib
    os.makedirs(BUSY, exist_ok=True)
    f = open(os.path.join(BUSY, hashlib.sha1(path.encode()).hexdigest()), "a+")
    fcntl.flock(f, fcntl.LOCK_SH)
    if f.tell() == 0:
        f.write(path)
        f.flush()
    return f


def busy():
    """The directories a command runs in now (their lock is held)."""
    import fcntl
    out = []
    try:
        names = os.listdir(BUSY)
    except OSError:
        return out
    for n in names:
        try:
            with open(os.path.join(BUSY, n), "r") as f:
                try:
                    fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    path = f.read().strip()
                    if path:
                        out.append(path)
        except OSError:
            pass
    return out


# A target used this recently is kept while the disk is over `min_free_gb`, under the headroom
# above it: a host whose own data holds it there (an M3 at 50-60 GB free, the farm's part 67 GB of
# it) had every target no command held that minute removed by each sweep, and the next command of
# its checkout rebuilt it whole; runs never reached their tests (2026-11-18).
RECENT_TARGET_SECONDS = 2 * 3600


def prune(keep, min_free_gb):
    """Removes test target directories of TARGETS (never anything else): those unused for TARGET_DAYS,
    then the least recently used while the disk is short of `min_free_gb` + PRUNE_HEADROOM_GB: under
    the headroom only those unused for RECENT_TARGET_SECONDS, under `min_free_gb` itself any. Never
    one a command is running in (its lock is held): removing those failed other checkouts' builds
    mid-run (2026-11-16)."""
    import shutil, time
    used = []
    for name in os.listdir(TARGETS):
        d = os.path.join(TARGETS, name)
        if name == keep or name.startswith(".") or not os.path.isdir(d) or os.path.islink(d):
            continue
        try:
            used.append((os.stat(os.path.join(d, ".used")).st_mtime, d))
        except OSError:
            used.append((0, d))
    used.sort()
    for when, d in used:
        age, free = time.time() - when, free_gb()
        if age > TARGET_DAYS * 86400 or free < min_free_gb or (free < min_free_gb + PRUNE_HEADROOM_GB and age > RECENT_TARGET_SECONDS):
            lock = target_lock(os.path.basename(d), True)
            if lock is None:
                continue
            try:
                print(f"farm-agent: removing the test target {os.path.basename(d)} (unused since {time.ctime(when)})", file=sys.stderr, flush=True)
                # Aside first, at once: a removal cut short (this process ends with its command)
                # leaves no half a target that cargo would trust, only trash the next sweep removes.
                trash = os.path.join(TARGETS, f".trash.{os.path.basename(d)}.{os.getpid()}")
                try:
                    os.rename(d, trash)
                except OSError:
                    continue
            finally:
                lock.close()
            shutil.rmtree(trash, ignore_errors=True)


# While a command runs, its agent checks the host every SWEEP_SECONDS (one agent at a time):
# targets due a clean are cleaned, whether or not their own commands ever ended (a test-remote
# killed by its caller took its agent with it, and that target was never cleaned: 33 GB of a
# host's 318 GB of targets were leftover objects), and while the disk is short, the least
# recently used targets no command holds go, then the root's idle copies. Checking only when a
# command started let concurrent builds take a host from 255 GB free to none within the hour
# (2026-11-17).
SWEEP_SECONDS = 60
# The test targets together stay under the job's `max_target_gb` (farm.py, `max_target_gb`): the
# least recently used no command holds go first. Measured at most every BUDGET_SECONDS. Without a
# bound the targets grew with the checkouts using a host (16 of them: 318 GB), until the host's
# disk ran out.
MAX_TARGET_GB = 150
BUDGET_SECONDS = 600


def target_sizes():
    """{target directory: GB on disk}, by `du` (a few seconds for hundreds of GB)."""
    out = {}
    try:
        names = [n for n in os.listdir(TARGETS) if not n.startswith(".")]
    except OSError:
        return out
    for n in names:
        d = os.path.join(TARGETS, n)
        try:
            r = subprocess.run(["du", "-sk", d], capture_output=True, text=True, timeout=300)
            out[d] = int(r.stdout.split()[0]) / (1 << 20)
        except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
            pass
    return out


def keep_to_budget(max_gb, keep=None):
    """Removes the least recently used targets no command holds while they hold over `max_gb`."""
    import shutil
    sizes = target_sizes()
    total = sum(sizes.values())
    if total <= max_gb:
        return
    def used(d):
        try:
            return os.stat(os.path.join(d, ".used")).st_mtime
        except OSError:
            return 0
    for d in sorted(sizes, key=used):
        if total <= max_gb:
            break
        name = os.path.basename(d)
        if name == keep:
            continue
        lock = target_lock(name, True)
        if lock is None:
            continue
        try:
            trash = os.path.join(TARGETS, f".trash.{name}.{os.getpid()}")
            try:
                os.rename(d, trash)
            except OSError:
                continue
        finally:
            lock.close()
        print(f"farm-agent: removing the test target {name} ({sizes[d]:.0f} GB; the targets hold "
              f"{total:.0f} GB, over {max_gb:g})", file=sys.stderr, flush=True)
        total -= sizes[d]
        shutil.rmtree(trash, ignore_errors=True)


def sweep(job):
    """One pass of the watchdog (see SWEEP_SECONDS). Returns at once when another agent sweeps."""
    import fcntl, shutil
    try:
        lock = open(os.path.join(FARM, "sweep.lock"), "a+")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    try:
        min_free_gb = job.get("min_free_gb", 40)
        try:
            names = os.listdir(TARGETS)
        except OSError:
            names = []
        for n in names:
            if n.startswith(".trash."):
                shutil.rmtree(os.path.join(TARGETS, n), ignore_errors=True)
        if job.get("cleaner"):
            home = ROOT + os.path.expanduser("~/Library/Caches/rerail-farm/relax-home")
            for n in names:
                d = os.path.join(TARGETS, n)
                if n.startswith(".") or not os.path.isdir(d):
                    continue
                try:
                    used = os.stat(os.path.join(d, ".used")).st_mtime
                except OSError:
                    continue
                try:
                    cleaned = os.stat(os.path.join(d, ".cleaned")).st_mtime
                except OSError:
                    cleaned = 0
                if cleaned >= used or time.time() - cleaned < CLEAN_SECONDS:
                    continue
                open(os.path.join(d, ".cleaned"), "w").close()
                try:
                    with open(os.path.join(d, ".cleaned.log"), "w") as log:
                        # Its own session: it finishes even when this agent ends with its command.
                        subprocess.run(["nice", "-n", "19", "/usr/bin/python3", "-c", job["cleaner"], "--relax-home", home, d],
                                       stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True, timeout=900,
                                       env={k: v for k, v in os.environ.items() if k != "RELAX_HOME"})
                except (OSError, subprocess.TimeoutExpired):
                    pass
        stamp = os.path.join(FARM, "budget.checked")
        try:
            due = time.time() - os.stat(stamp).st_mtime >= BUDGET_SECONDS
        except OSError:
            due = True
        if due:
            open(stamp, "w").close()
            keep_to_budget(job.get("max_target_gb", MAX_TARGET_GB), job.get("target"))
        if free_gb() < min_free_gb + PRUNE_HEADROOM_GB:
            prune(job.get("target"), min_free_gb)
        if free_gb() < min_free_gb + PRUNE_HEADROOM_GB:
            fd = os.open(os.path.join(FARM, "root.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
            try:
                prune_roots(min_free_gb, (ROOT_DAYS,) + ROOT_SHORT_DAYS + (1 / 24,), lambda line: os.write(fd, (line + "\n").encode()))
            finally:
                os.close(fd)
    except Exception as e:
        try:
            print(f"farm-agent: the sweep failed: {e!r}", file=sys.stderr, flush=True)
        except Exception:
            pass
    finally:
        lock.close()


GPU_GUARD = os.path.join(FARM, "gpu-guard")


def ensure_gpu_guard(text):
    """On a Mac: starts the GPU watchdog (scripts/build/farm/gpu-guard, its text sent with the job)
    unless one runs, and holds its `users` lock shared while this command runs, so it stays. Returns
    the lock's file (held until this process exits)."""
    import fcntl
    os.makedirs(GPU_GUARD, exist_ok=True)
    path = os.path.join(GPU_GUARD, "gpu-guard.py")
    try:
        old = open(path).read()
    except OSError:
        old = None
    if old != text:
        with open(path + ".part", "w") as f:
            f.write(text)
        os.rename(path + ".part", path)
    users = open(os.path.join(GPU_GUARD, "users"), "a+")
    fcntl.flock(users, fcntl.LOCK_SH)
    # This agent's pid: the guard takes every process under it for the farm's (removed at the end).
    os.makedirs(os.path.join(GPU_GUARD, "agents"), exist_ok=True)
    open(os.path.join(GPU_GUARD, "agents", str(os.getpid())), "w").close()
    with open(os.path.join(GPU_GUARD, "lock"), "a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(lock, fcntl.LOCK_UN)
            running = False
        except BlockingIOError:
            running = True
    if not running:
        with open(os.path.join(GPU_GUARD, "guard.err"), "a") as err:
            subprocess.Popen(["/usr/bin/python3", "-I", path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=err, start_new_session=True)
    return users


def gpu_kills_of(pid, since):
    """The GPU watchdog's kills of processes under `pid` (this command) since `since`."""
    found = []
    try:
        for line in open(os.path.join(GPU_GUARD, "kills.log")):
            try:
                k = json.loads(line)
            except ValueError:
                continue
            if k.get("time", 0) >= since and pid in k.get("ancestors", []):
                found.append(k)
    except OSError:
        pass
    return found


def watchdog(job):
    while True:
        sweep(job)
        time.sleep(SWEEP_SECONDS)


def run_command(job):
    """`farm-agent exec JOB` (test-remote, live-test-remote): runs a command in the build machine's
    `cwd` as kept here, with `env` added, the kept paths of `map` mapped in both, and the open-file
    limit `nofile`. With `target` (a key of the checkout's path), cargo builds in a target directory
    of its own under TARGETS: never the checkout's `target/`, where the mirror writes the compiles'
    dependencies, so no two writers share one. The command stops when this command's input ends
    (the connection closed): a host's sshd does not stop it without a terminal."""
    import resource, signal
    # The connection's end (a caller killed, a closed terminal) hangs this agent up: it stays, to
    # stop the command (`watch`) and clean after it, instead of dying with the session.
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    m = mapper(job.get("map", []))
    env = dict(os.environ)
    env.update({k: m(v) for k, v in job.get("env", {}).items()})
    global BUSY_HELD
    BUSY_HELD = [busy_lock(ROOT + os.path.normpath(p)) for p in job.get("map", []) if p.startswith("/") and p != "/"]
    os.makedirs(TMP, exist_ok=True)
    env["TMPDIR"] = TMP + "/"
    env["PATH"] = os.path.expanduser("~/.cargo/bin") + ":/opt/homebrew/bin:" + env.get("PATH", "")
    if job.get("target"):
        os.makedirs(TARGETS, exist_ok=True)
        # Held until this process exits (after the command): prune leaves the directory alone. Taken
        # before the directory is made, so a removal under way ends first.
        global HELD
        HELD = target_lock(job["target"], False)
        target = os.path.join(TARGETS, job["target"])
        os.makedirs(target, exist_ok=True)
        open(os.path.join(target, ".used"), "w").close()
        # Cargo writes the tag only into a directory it makes itself; clean-target cleans only a
        # directory that has it.
        tag = os.path.join(target, "CACHEDIR.TAG")
        if not os.path.exists(tag):
            with open(tag, "w") as f:
                f.write("Signature: 8a477f597d28d172789f06886806bc55\n"
                        "# This file is a cache directory tag created by the rerail farm.\n")
        prune(job["target"], job.get("min_free_gb", 40))
        env["CARGO_TARGET_DIR"] = target
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    want = job.get("nofile") or soft
    try:
        resource.setrlimit(resource.RLIMIT_NOFILE, (min(want, hard) if hard != resource.RLIM_INFINITY else want, hard))
    except (ValueError, OSError) as e:
        print(f"farm-agent: the open-file limit stays {soft}: {e}", file=sys.stderr, flush=True)
    argv = [m(a) for a in job["argv"]]
    global GPU_USERS
    started = time.time()
    if MACOS and job.get("gpu_guard"):
        try:
            GPU_USERS = ensure_gpu_guard(job["gpu_guard"])
        except OSError as e:
            print(f"farm-agent: no GPU watchdog: {e}", file=sys.stderr, flush=True)
    windows = None
    if job.get("windows"):
        try:
            windows = windows_job(job, argv, m(job["cwd"]), env)
        except OSError as e:
            print(f"farm-agent: {e}", file=sys.stderr, flush=True)
            os._exit(127)
        argv, env = windows["argv"], windows["env"]
    try:
        # (Windows' cmd started in a WSL directory says it cannot use it: started on its drive)
        proc = subprocess.Popen(argv if windows else ["nice", "-n", str(job.get("nice", 10))] + argv,
                                cwd=WINDIR if windows else m(job["cwd"]), env=env,
                                stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        print(f"farm-agent: {e}", file=sys.stderr, flush=True)
        os._exit(127)

    def watch():
        while sys.stdin.buffer.read(65536):
            pass
        if windows:
            windows_kill(windows)
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except OSError:
            pass
    threading.Thread(target=watch, daemon=True).start()
    if job.get("target"):
        threading.Thread(target=watchdog, args=(job,), daemon=True).start()
    code = proc.wait()
    if MACOS:
        try:
            os.remove(os.path.join(GPU_GUARD, "agents", str(os.getpid())))
        except OSError:
            pass
        for k in gpu_kills_of(proc.pid, started):
            print(f"farm-agent: the farm's GPU watchdog killed {os.path.basename(k['path'])} (pid {k['pid']}): "
                  f"{k.get('why')}; macOS restarts a Mac whose WindowServer stops for 120 s "
                  f"(scripts/build/farm/README.md, \"The GPU watchdog\")",
                  file=sys.stderr, flush=True)
    if windows:
        for p in (windows["script"], windows["launcher"]):
            try:
                os.remove(p)
            except OSError:
                pass
    for f in (sys.stdout, sys.stderr):
        try:
            f.flush()
        except OSError:
            pass  # the connection is gone: the cleaning below still runs
    if job.get("target") and job.get("cleaner"):
        clean(os.path.join(TARGETS, job["target"]), job["cleaner"], env.get("RELAX_HOME"))
    if job.get("target"):
        tidy_root(job.get("min_free_gb", 40))
    os._exit(code if code >= 0 else 128 - code)


def win_path(path):
    """A path on a Windows drive as WSL mounts it (/mnt/c/x/y) as Windows names it (C:\\x\\y)."""
    m = re.match(r"^/mnt/([a-z])(/.*)?$", path)
    if not m:
        raise OSError(f"{path} is not on a Windows drive (the host's farm_dir must be under /mnt/)")
    return m.group(1).upper() + ":" + (m.group(2) or "/").replace("/", "\\")


def bat_quote(arg):
    """`arg` for a batch file's command line: in quotes (cmd's `&|<>^` stay literal inside them, and
    the C runtime takes them off), `%` doubled (a batch file expands it even there)."""
    return '"' + arg.replace('"', '\\"').replace("%", "%%") + '"'


WINDOWS_PRIORITY = [(0, "NORMAL"), (10, "BELOWNORMAL"), (19, "LOW")]


def windows_job(job, argv, cwd, env):
    """A test command run as a Windows build (`windows` in the job: a Windows host, "Windows
    hosts"): the checkout's copy is on the Windows drive, so the command runs natively there, in a
    batch file Windows' cmd runs through WSL's interop, at a low priority (its children inherit it),
    with its target directory on that drive. A leading `nice -n N` sets the priority; `env` that
    the job set goes in the batch file, a path in it as Windows names it."""
    nice = job.get("nice", 10)
    if len(argv) >= 3 and argv[0] == "nice" and argv[1] == "-n":
        nice, argv = int(argv[2]), argv[3:]
    priority = next(p for n, p in reversed(WINDOWS_PRIORITY) if nice >= n)
    if not WINDIR:
        raise OSError("a Windows job on a host with no windows_dir")
    wenv = interop_env()
    # The checkout's copy here (the machine's Linux one) to the Windows drive, then the command
    # runs in that one, with its target directory there too.
    for p in job.get("map", []):
        if p.startswith("/") and p != "/":
            windows_sync(ROOT + os.path.normpath(p), WINDIR + "/r" + os.path.normpath(p), wenv)
    cwd = WINDIR + "/r" + cwd[len(ROOT):] if cwd.startswith(ROOT + "/") else cwd
    if job.get("target"):
        env = dict(env, CARGO_TARGET_DIR=os.path.join(WINDIR, "t", job["target"]))
        os.makedirs(env["CARGO_TARGET_DIR"], exist_ok=True)
    tag = f"farm-job-{os.getpid()}"
    os.makedirs(os.path.join(WINDIR, "tmp"), exist_ok=True)
    script, launcher = os.path.join(WINDIR, "tmp", tag + ".cmd"), os.path.join(WINDIR, "tmp", tag + "-run.cmd")
    lines = ["@echo off", f"cd /d {bat_quote(win_path(cwd))}"]
    for k, v in job.get("env", {}).items():
        v = env.get(k, v)
        lines.append(f'set "{k}={win_path(v) if v.startswith("/mnt/") else v}"')
    if env.get("CARGO_TARGET_DIR"):
        lines.append(f'set "CARGO_TARGET_DIR={win_path(env["CARGO_TARGET_DIR"])}"')
    lines += ['set "PATH=%USERPROFILE%\\.cargo\\bin;%PATH%"', " ".join(bat_quote(a) for a in argv), "exit /b %ERRORLEVEL%"]
    with open(script, "w", newline="\r\n") as f:
        f.write("\n".join(lines) + "\n")
    # `start /WAIT` runs it at the priority; the launcher's next line hands its exit status back.
    with open(launcher, "w", newline="\r\n") as f:
        f.write(f'@echo off\nstart "" /B /WAIT /{priority} cmd /d /c {bat_quote(win_path(script))}\nexit /b %ERRORLEVEL%\n')
    return {"argv": ["/mnt/c/Windows/System32/cmd.exe", "/d", "/c", win_path(launcher)], "env": wenv,
            "script": script, "launcher": launcher, "tag": tag}


def interop_env():
    """This environment with WSL's interop socket: a command from ssh has none, and Windows'
    programs are then not runnable (the first one WSL made serves every session)."""
    wenv = dict(os.environ)
    if not wenv.get("WSL_INTEROP"):
        socks = sorted(glob.glob("/run/WSL/*_interop"), key=lambda p: int(os.path.basename(p).split("_")[0]))
        if socks:
            wenv["WSL_INTEROP"] = socks[0]
    return wenv


def windows_sync(src, dst, wenv):
    """Brings the Windows drive's copy `dst` up to the copy `src` here: the files changed since
    the last sync (size or time, from its manifest) in one tar stream to Windows' own tar, which
    writes them natively (WSL's mount wrote 13 files a second); the files gone, removed. A
    `target` directory and `.git` stay out: the mirror's compile outputs, and no build reads them."""
    import hashlib, tarfile
    started = time.time()
    manifest = os.path.join(FARM, "winsync", hashlib.sha256(dst.encode()).hexdigest()[:16] + ".json")
    try:
        old = json.load(open(manifest))
    except (OSError, ValueError):
        old = {}
    new, changed = {}, []
    for d, dirs, files in os.walk(src):
        dirs[:] = [x for x in dirs if x not in ("target", ".git")]
        for name in files:
            p = os.path.join(d, name)
            st = os.lstat(p)
            if not os.path.isfile(p) or os.path.islink(p):
                continue
            rel = os.path.relpath(p, src)
            new[rel] = [st.st_size, st.st_mtime_ns]
            if old.get(rel) != new[rel]:
                changed.append(rel)
    os.makedirs(dst, exist_ok=True)
    if changed:
        tar = subprocess.Popen(["/mnt/c/Windows/System32/tar.exe", "-x", "-f", "-", "-C", win_path(dst)], env=wenv,
                               stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        try:
            with tarfile.open(fileobj=tar.stdin, mode="w|", format=tarfile.PAX_FORMAT) as t:
                for rel in changed:
                    t.add(os.path.join(src, rel), arcname=rel.replace(os.sep, "/"), recursive=False)
            tar.stdin.close()
        except OSError:
            pass
        err = tar.stderr.read().decode(errors="replace")
        if tar.wait() != 0:
            raise OSError(f"tar on Windows: {err.strip()[-500:]}")
    gone = [rel for rel in old if rel not in new]
    for rel in gone:
        try:
            os.remove(os.path.join(dst, rel))
        except OSError:
            pass
    os.makedirs(os.path.dirname(manifest), exist_ok=True)
    with open(manifest + ".tmp", "w") as f:
        json.dump(new, f)
    os.replace(manifest + ".tmp", manifest)
    if changed or gone:
        print(f"farm-agent: {len(changed)} files to the Windows drive, {len(gone)} removed, in {time.time() - started:.1f} s",
              file=sys.stderr, flush=True)


def windows_kill(w):
    """Stops a Windows command's processes: every process tree whose command line names its batch
    file (Windows' processes are not this agent's children)."""
    ps = ("Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*" + w["tag"] + "*' } | "
          "ForEach-Object { taskkill.exe /T /F /PID $_.ProcessId | Out-Null }")
    try:
        subprocess.run(["/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe", "-NoProfile", "-Command", ps],
                       env=w["env"], stdin=subprocess.DEVNULL, capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        pass


# What the root holds that no run has used for ROOT_DAYS goes (prune_root); while the disk is short
# (under min_free_gb + PRUNE_HEADROOM_GB free), what is idle for a day, then 6 hours. Checked after a
# command ends, at most once every ROOT_SECONDS. Without it the root kept every copy and every run
# output (95 GB on one host, 2026-11-16).
ROOT_DAYS = 3
ROOT_SHORT_DAYS = (1, 0.25)
ROOT_SECONDS = 3600


def tidy_root(min_free_gb):
    """Starts prune_root in a process of its own (the command's exit is not held up), logged in
    the farm's `root.log` beside the root."""
    import time
    stamp = os.path.join(os.path.dirname(ROOT), "root.pruned")
    try:
        if time.time() - os.stat(stamp).st_mtime < ROOT_SECONDS:
            return
    except OSError:
        pass
    open(stamp, "w").close()
    import warnings
    try:
        # (Python 3.12, the Linux hosts' own, warns at every fork of a process with threads, into
        # the command's output: the child here holds to the rule below.)
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", DeprecationWarning)
            if os.fork():
                return
    except OSError:
        return
    # The child: only file system calls from here, never this process's streams or threads' locks.
    try:
        os.setsid()
        os.setpriority(os.PRIO_PROCESS, 0, 19)
        # Off the command's streams: ssh waits until every holder of them closes.
        null = os.open(os.devnull, os.O_RDWR)
        for n in (0, 1, 2):
            os.dup2(null, n)
        fd = os.open(os.path.join(FARM, "root.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        prune_roots(min_free_gb, (ROOT_DAYS,) + ROOT_SHORT_DAYS, lambda line: os.write(fd, (line + "\n").encode()))
    finally:
        os._exit(0)


def prune_roots(min_free_gb, days_list, say):
    """prune_root on the root and on TMP (where every file is the commands' own): what is idle for
    the first of `days_list`, then for each shorter one while the disk is short. Never the farm's
    Relax home (clean-target cleans it) or a directory a command runs in (`busy`)."""
    relax = ROOT + os.path.expanduser("~/Library/Caches/rerail-farm/relax-home")
    for i, days in enumerate(days_list):
        if i and free_gb() >= min_free_gb + PRUNE_HEADROOM_GB:
            break
        keep = [relax] + busy()
        n, b = prune_root(days, keep)
        n2, b2 = prune_root(days, keep, TMP, every_file=True)
        n3, b3 = prune_root(days, keep, XC_PM, every_file=True) if os.path.isdir(XC_PM) else (0, 0)
        say(f"{time.strftime('%Y-%m-%d %H:%M')}: idle {days:g}+ days: {n + n2 + n3} paths, "
            f"{(b + b2 + b3) / 1e9:.1f} GB; {free_gb():.0f} GB free")


def free_space(job):
    """`farm-agent free JOB` (farm.free_host, when a host is short of disk): frees what is the
    farm's here, least needed first, until the disk has `min_free_gb` + PRUNE_HEADROOM_GB free:
    test targets no command runs in (least recently used first), then the rest cleaned
    (clean-target, the job's `cleaner`), then the root and TMP down to what was used in the last
    hour. Nothing of the host's own. Prints a JSON line: free GB before and after, and what the
    farm still holds here."""
    import shutil
    min_free_gb = job.get("min_free_gb", 40)
    want = min_free_gb + PRUNE_HEADROOM_GB
    before = free_gb()
    steps = []
    say = lambda line: steps.append(line)
    if os.path.isdir(TARGETS):
        prune(None, min_free_gb)
        if job.get("cleaner"):
            home = ROOT + os.path.expanduser("~/Library/Caches/rerail-farm/relax-home")
            for name in os.listdir(TARGETS):
                d = os.path.join(TARGETS, name)
                if name.startswith(".") or not os.path.isdir(d):
                    continue
                try:
                    subprocess.run(["nice", "-n", "19", "/usr/bin/python3", "-c", job["cleaner"], "--relax-home", home, d],
                                   stdin=subprocess.DEVNULL, capture_output=True, timeout=900,
                                   env={k: v for k, v in os.environ.items() if k != "RELAX_HOME"})
                except (OSError, subprocess.TimeoutExpired):
                    pass
            say(f"targets cleaned; {free_gb():.0f} GB free")
        keep_to_budget(job.get("max_target_gb", MAX_TARGET_GB))
        say(f"targets kept to {job.get('max_target_gb', MAX_TARGET_GB):g} GB; {free_gb():.0f} GB free")
    if free_gb() < want:
        prune_roots(min_free_gb, (ROOT_DAYS,) + ROOT_SHORT_DAYS + (1 / 24,), say)
    held = 0
    for d, dirs, files in os.walk(FARM):
        for n in files:
            try:
                held += os.lstat(os.path.join(d, n)).st_blocks * 512
            except OSError:
                pass
    print(json.dumps({"before_gb": round(before, 1), "after_gb": round(free_gb(), 1),
                      "farm_gb": round(held / (1 << 30), 1), "steps": steps}), flush=True)


def prune_root(days, keep=(), root=ROOT, every_file=False):
    """Removes from ROOT what no run has used for `days`: whole directories none of whose files was
    read or written since, and, in directories still in use, the copies the mirror sent (they carry
    XATTR; the mirror sends one again when a run needs it: a compile that misses it fails once, runs
    on the build machine, and the host is asked what it holds). A file a command wrote here stays
    while its directory is in use. `keep`: subtrees left alone (the farm's Relax home: clean-target
    cleans it). Files are judged by their own access and modification times, never a
    directory's (this walk reads the directories). Symlinks are never followed; nothing outside
    ROOT is touched. Returns (paths, bytes)."""
    import shutil, time
    cutoff = time.time() - days * 86400
    keep = [os.path.realpath(k) for k in keep]
    removed = [0, 0]

    def last_use(path, isdir):
        """Asked again just before removing: the walk's view of a big tree is minutes old by then,
        and a run may have started reading it meanwhile (it removed a checkout's Cargo.lock and
        rust-toolchain.toml under a run that had just been told they were there, 2026-11-17)."""
        if any(path == k or path.startswith(k + "/") or k.startswith(path + "/") for k in keep + busy()):
            return time.time()
        st = os.lstat(path)
        # A directory's access time is this walk's own reading of it: only its modification counts.
        newest = st.st_mtime if isdir else max(st.st_atime, st.st_mtime)
        if isdir:
            for d, dirs, files in os.walk(path):
                for n in dirs + files:
                    try:
                        st = os.lstat(os.path.join(d, n))
                        newest = max(newest, st.st_mtime if n in dirs else max(st.st_atime, st.st_mtime))
                    except OSError:
                        pass
        return newest

    def blocks(path):
        total = 0
        for d, dirs, files in os.walk(path):
            for n in dirs + files:
                try:
                    total += os.lstat(os.path.join(d, n)).st_blocks * 512
                except OSError:
                    pass
        return total

    def remove(path, isdir):
        if not path.startswith(root + "/"):
            return
        try:
            if last_use(path, isdir) >= cutoff:
                return
            b = blocks(path) if isdir else os.lstat(path).st_blocks * 512
        except OSError:
            return
        removed[0] += 1
        removed[1] += b
        if isdir:
            shutil.rmtree(path, ignore_errors=True)
        else:
            try:
                os.unlink(path)
            except OSError:
                pass

    sent = has_tag

    def walk(d, top=False):
        """The newest use of anything under `d` (0: nothing in it); removes what is idle in it."""
        if any(d == k or d.startswith(k + "/") for k in keep):
            return time.time()
        newest, idle_dirs, idle_sent = 0.0, [], []
        try:
            # Its own modification time (an entry added or removed) counts: a directory a command
            # made and has not written into yet is in use.
            newest = os.lstat(d).st_mtime
            entries = list(os.scandir(d))
        except OSError:
            return time.time()
        for e in entries:
            try:
                if e.is_dir(follow_symlinks=False):
                    used = walk(e.path)
                    if used < cutoff:
                        idle_dirs.append(e.path)
                else:
                    st = e.stat(follow_symlinks=False)
                    used = max(st.st_atime, st.st_mtime)
                    if used < cutoff and (every_file or (not e.is_symlink() and sent(e.path))):
                        idle_sent.append(e.path)
            except OSError:
                used = time.time()
            newest = max(newest, used)
        # A directory still in use keeps itself and what was used; its idle parts go. A wholly idle
        # one goes whole, from its parent.
        if newest >= cutoff or top:
            for p in idle_dirs:
                remove(p, True)
            for p in idle_sent:
                remove(p, False)
        return newest

    if os.path.isdir(root) and not os.path.islink(root):
        walk(root, True)
    return removed[0], removed[1]


def clean(target, source, relax_home):
    """Starts the cleaner (clean-target's text, sent with the job) on `target`, detached, so the
    command's exit is not held up, at most once every CLEAN_SECONDS. Its only Relax home is the
    farm's (`relax_home`, the job's RELAX_HOME, under the farm's root), never one of the host's own.
    It skips a profile directory another command builds in; that command cleans it when it ends."""
    import time
    stamp = os.path.join(target, ".cleaned")
    try:
        if time.time() - os.stat(stamp).st_mtime < CLEAN_SECONDS:
            return
    except OSError:
        pass
    open(stamp, "w").close()
    home = relax_home if relax_home and os.path.realpath(relax_home).startswith(os.path.realpath(ROOT) + "/") else ""
    try:
        with open(os.path.join(target, ".cleaned.log"), "w") as log:
            subprocess.Popen(["nice", "-n", "19", "/usr/bin/python3", "-c", source, "--relax-home", home, target],
                             stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                             env={k: v for k, v in os.environ.items() if k != "RELAX_HOME"})
    except OSError as e:
        print(f"farm-agent: the cleaner did not start: {e}", file=sys.stderr, flush=True)


# The root is the farm's: made here, never a mount (a mounted root would write through to whatever
# is mounted).
os.makedirs(ROOT, exist_ok=True)
if sys.argv[1:2] == ["exec"]:
    run_command(json.loads(sys.argv[2]))
if sys.argv[1:2] == ["fetch"]:
    # One file of a test-remote command's target directory, to stdout (`--fetch`): a program the
    # host built, for this Mac to run. Only a file inside that target directory.
    base = os.path.realpath(os.path.join(TARGETS, sys.argv[2]))
    path = os.path.realpath(os.path.join(base, sys.argv[3]))
    if not path.startswith(base + os.sep) or not os.path.isfile(path):
        print(f"farm-agent: no file {sys.argv[3]} in the command's target directory", file=sys.stderr, flush=True)
        os._exit(66)
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1 << 20)
            if not chunk:
                break
            sys.stdout.buffer.write(chunk)
    sys.stdout.buffer.flush()
    os._exit(0)
if sys.argv[1:2] == ["free"]:
    os.setpriority(os.PRIO_PROCESS, 0, 19)
    free_space(json.loads(sys.argv[2]))
    sys.stdout.flush()
    os._exit(0)
if under_mount(ROOT):
    refused.append(f"{ROOT} is under a network mount")

while True:
    header, payload = receive()
    if header is None:
        break
    if header["op"] == "tcp":
        over_tcp(header)
        continue
    if header["op"] == "put":
        try:
            put(header, payload)
        except OSError as e:
            print(f"farm-agent: {header['path']}: {e}", file=sys.stderr, flush=True)
            refused.append(f"{header['path']} ({e})")
    elif header["op"] == "run":
        threading.Thread(target=run, args=(header,), daemon=True).start()
    elif header["op"] == "same":
        send({"op": "same?", "id": header["id"], "differ": [p for p, h in header["files"].items() if sha(p) != h]})
    elif header["op"] == "unlisted":
        # In a thread of its own: the walk takes a moment, and other compiles' puts go on meanwhile.
        threading.Thread(target=unlisted, args=(header,), daemon=True).start()
    elif header["op"] == "remove":
        remove(header)
    elif header["op"] == "have":
        send({"op": "had", "id": header["id"], "seen": [seen(at(p), touch=True) for p in header["paths"]]})
    elif header["op"] == "ping":
        send({"op": "pong", "id": header.get("id")})

# The stream ended: the daemon is gone. Leave at once. A normal exit would finalize the interpreter
# while the lifeline thread holds stdin's lock, or a compile's thread still runs, and Python aborts
# ("Fatal Python error: _enter_buffered_busy"), which macOS reports as a crash on the host.
sys.stderr.flush()
os._exit(0)
