+/// `attr_path` of the attribute an `unsafe(..)` wraps (`#[unsafe(no_mangle)]`: `no_mangle`, as
+/// edition 2024 writes the unsafe attributes), else of the attribute itself.
+pub fn attr_inner_path(prog: &Program, file: u32, a: &Attr) -> Vec<u8> {
+    let p = prog.src(file);
+    let (lo, hi) = (a.toks.lo as usize, a.toks.hi as usize);
