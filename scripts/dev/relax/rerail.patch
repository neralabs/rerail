+++ b/libs/relax/compiler/tests/proc_macro_state_per_crate/run.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# usage: run.sh <relax binary>: a crate and its test build each run the `Once` derive (reg/src/lib.rs) as rustc
+# runs it, afresh: its registry of struct names is the compile's own, so neither build is refused. The derive
+# writes to stdout, so the macro world's std registers its flush at exit: the check still exits 0 (the handler
+# goes with the world, not called in its freed code). Prints
+# "proc_macro_state_per_crate: ok" or "proc_macro_state_per_crate: FAILED" (exit 1).
+H=$(cd "$(dirname "$0")" && pwd)
+T=$(mktemp -d) || exit 1
+[ -n "$T" ] || exit 1
+trap 'rm -rf "$T"' EXIT
+export RELAX_CACHE=off RELAX_HOME="$T/home" RELAX_STD=$H/../../std
+CHECK=$(cd "$H" && "$1" check -p a --tests 2>&1; echo "exit $?")
+TEST=$(cd "$H" && "$1" test a --lib 2>&1)
+if echo "$CHECK" | grep -q "body owners of the checked crates, .* 0 errors" && echo "$CHECK" | grep -q "^exit 0$" && echo "$TEST" | grep -q "test result: ok. 1 passed"; then
+  echo "proc_macro_state_per_crate: ok"
+else
+  echo "$CHECK" | tail -6; echo "$TEST" | tail -6; echo "proc_macro_state_per_crate: FAILED"; exit 1
+fi
