+// A cast whose source referent is a slice of a still-open element type: `&[][..] as &[String]`.
+// rustc's cast check coerces the operand to the target (cast.rs try_coercion_cast), which decides
+// the element; Relax left it open and reported the index's `[_; 0]: Index<RangeFull>` as E0283.
+// Run with `makepad test` and rustc --test; lines "| " are compared.
+fn count(lists: &[&[String]]) -> usize {
+    lists.iter().map(|l| l.len()).sum::<usize>() + lists.len()
+}
+
+#[test]
+fn empty_slice_cast_takes_the_target_element() {
+    let lists = [&[][..] as &[String]];
+    let words = vec!["a".to_string()];
+    let more = [&words[..] as &[String], &[][..] as &[String]];
+    println!("| {} {}", count(&lists), count(&more));
+}
+
+#[test]
+fn literal_elements_still_cast() {
+    let bytes = &[1u8, 2][..] as &[u8];
+    let v: Vec<u16> = Vec::new();
+    let r = &v[..] as &[u16];
+    println!("| {:?} {}", bytes, r.len());
+}
