+#!/bin/bash
+# usage: run.sh <makepad binary>: under the smallvec Relax substitutes (std/substitutes.txt), whose
+# `smallvec!` is a built-in, a child module that glob-imports its parent's `use smallvec::smallvec`
+# and imports `smallvec::smallvec` itself (cranelift-codegen 0.125 machinst/abi.rs). The glob brings
+# a macro; the path's first segment is the crate (type namespace): no E0659, as rustc. Prints
+# "substitute_smallvec_glob: ok" or "substitute_smallvec_glob: FAILED" (exit 1).
+H=$(cd "$(dirname "$0")" && pwd)
+export RELAX_CACHE=off
+OUT=$(cd "$H" && RELAX_STD=$H/../../std "$1" check svg-app 2>&1)
+if echo "$OUT" | grep -q " 0 errors"; then echo "substitute_smallvec_glob: ok"; else echo "$OUT" | tail -5; echo "substitute_smallvec_glob: FAILED"; exit 1; fi
