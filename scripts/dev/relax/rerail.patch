+#[test]
+fn a_closure_built_in_a_closure_returned_through_an_impl_capturing_two_lifetimes_borrows_self() {
+    // rerail: edition 2024's `impl Trait` captures both `&self` and `_r`; the inner closure's
+    // captured borrow sits in the outer closure's signature, in a slot whose identity is the fn's
+    // `'a` (root_cx.rs tie_inherited_slots). It was left free, member constraints chose `'static`
+    // for it, and `T: 'static` failed (E0310). rustc accepts it.
+    let (errors, _) = borrowck_source_in("
+        pub struct S<T>(pub Vec<Option<T>>);
+        impl<T> S<T> {
+            pub fn f(&self, _r: &str) -> impl Iterator<Item = &T> {
+                let o = move || (0..1usize).filter_map(move |c| self.0[c].as_ref());
+                o()
+            }
+        }
+        #[derive(Clone, Copy)]
+        pub enum View<'a> { A(&'a [u32]), B(&'a [u64]) }
+        impl View<'_> { pub fn has(&self, v: u32) -> bool { match self { View::A(x) => x.contains(&v), View::B(x) => x.contains(&(v as u64)) } } }
+        pub fn combine(out: &mut Vec<u32>, a: View<'_>, b: View<'_>) {
+            match (a, b) {
+                (View::A(x), m @ View::B(_)) | (m @ View::B(_), View::A(x)) => out.extend(x.iter().copied().filter(|&v| m.has(v))),
+                _ => {}
+            }
+        }
+        fn main() {}", 2024);
+    assert!(errors.is_empty(), "{errors:?}");
+}
+
+#[test]
+fn a_closure_built_in_a_closure_cannot_return_a_shorter_borrow_through_an_impl() {
+    // rerail: the case above with a borrow of a shorter lifetime: rustc rejects it (E0621), and
+    // tying the signature's slots to the parent's regions must not hide that.
+    let (errors, _) = borrowck_source_in("
+        pub fn g<'a>(x: &'a String, y: &String) -> impl Iterator<Item = &'a String> + 'a {
+            let _ = x;
+            let o = move || std::iter::once(()).map(move |_| y);
+            o()
+        }
+        fn main() {}", 2024);
+    assert!(errors.iter().any(|e| e.contains("E0621") || e.contains("lifetime")), "{errors:?}");
+}
