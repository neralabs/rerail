+++ b/libs/relax/compiler/tests/proc_macro_state_per_crate/reg/src/lib.rs
@@ -0,0 +1,25 @@
+//! A derive that keeps state across its calls, as napi-derive's constructor registry does
+//! (`static STRUCTS: OnceLock<..>`): a struct name registered twice is an error. rustc runs a
+//! proc macro afresh for each crate it compiles, so the state is per crate: two crates (or a
+//! crate and its test build) that each derive it for a struct of one name are no error. It also
+//! writes to stdout, as a macro may: the world's std then registers its flush at exit.
+use proc_macro::TokenStream;
+use std::collections::HashSet;
+use std::sync::{Mutex, OnceLock};
+
+static SEEN: OnceLock<Mutex<HashSet<String>>> = OnceLock::new();
+
+#[proc_macro_derive(Once)]
+pub fn once(input: TokenStream) -> TokenStream {
+    let text = input.to_string();
+    let name = text.split_whitespace().skip_while(|w| *w != "struct").nth(1).unwrap_or("").trim_end_matches(';').to_string();
+    let fresh = SEEN.get_or_init(Default::default).lock().unwrap().insert(name.clone());
+    // (a macro that writes to stdout: the world's std registers its flush at exit, which must not
+    // outlive the world)
+    println!("Once: {name}");
+    if fresh {
+        format!("impl {name} {{ pub fn once() -> &'static str {{ \"{name}\" }} }}").parse().unwrap()
+    } else {
+        format!("compile_error!(\"`{name}` is registered twice in one crate\");").parse().unwrap()
+    }
+}
diff --git a/libs/relax/compiler/tests/proc_macro_state_per_crate/run.sh b/libs/relax/compiler/tests/proc_macro_state_per_crate/run.sh
new file mode 100755
index 00000000..3f923114
