+
+/// receipt_identity over the reached packages ((dir, name, version), from a registry) and the
+/// script runs by their package's name and version. Every list is taken as a set: a package's
+/// host and target runs, and the link's archives and packages, come in no fixed order.
+fn identity_of(mut pkgs: Vec<(&(String, String, String), bool)>, scripts: &[(&str, &str, &ScriptOut)], lib: Option<&NativeLib>) -> String {
+    let mut h = fnv(b"receipt-identity-v1", 0xcbf29ce484222325);
+    pkgs.sort();
+    pkgs.dedup();
+    for ((dir, name, version), registry) in pkgs {
+        h = fnv(format!("{name} {version}\0").as_bytes(), h);
+        if !registry {
+            hash_package_dir(dir, &mut h);
+        }
+        let mut runs: Vec<String> = scripts.iter().filter(|(n, v, _)| n == name && v == version)
+            .map(|(_, _, o)| format!("{}\0{}\0{:?}\0{:?}\0{:?}\0", o.host, o.out_dir, o.cfgs, o.env, o.system)).collect();
+        runs.sort();
+        for r in runs {
+            h = fnv(r.as_bytes(), h);
+        }
+    }
+    if let Some(lib) = lib {
+        let (mut statics, mut crates) = (lib.statics.clone(), lib.crates.clone());
+        statics.sort();
+        crates.sort();
+        h = fnv(format!("{statics:?}\0{crates:?}\0").as_bytes(), h);
+    }
+    format!("{h:016x}")
+}
