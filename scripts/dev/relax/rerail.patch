+        let (h, t) = (run(0, true, "/o/libc-h", &[]), run(0, false, "/o/libc-t", &[]));
+        let e1 = run(1, false, "/o/engine", &[("BUILD_ID", "1")]);
+        let e2 = run(1, false, "/o/engine", &[("BUILD_ID", "2")]);
+        let lib = |statics: &[&str]| NativeLib { path: String::new(), statics: statics.iter().map(|s| s.to_string()).collect(), crates: vec!["libc 0.2".into(), "engine 0.1".into()], partial: false };
+        let id = |runs: &[(&str, &str, &ScriptOut)], path: &str, statics: &[&str]| {
+            let mut l = lib(statics);
+            l.path = path.into();
+            identity_of(vec![(&libc, true)], runs, Some(&l))
