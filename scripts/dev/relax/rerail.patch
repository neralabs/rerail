+        // (the wrapper's closing parenthesis left out)
+        let inner = Attr { toks: crate::ast::TokRange { lo: (lo + 2) as u32, hi: a.toks.hi - 1 }, ..*a };
+        return attr_path(prog, file, &inner);
+    }
+    attr_path(prog, file, a)
+}
