@@ -0,0 +1,161 @@
+//! The C library's path calls a program makes itself (`libc::open`, `libc::statfs`, ...), with a folder mount's
+//! paths as the disk names them. A folder mount (a shared workspace's checkout, RELAX_SHARE) is a disk folder under
+//! another path: std answers its paths from the disk (std fs_vfs.rs `kind`), and these give a program's own calls
+//! the same disk. Without them a program that listed a folder by `open` and `getattrlistbulk` (rerail's observer)
+//! found no such folder under the mount, where std had just read it.
+//!
+//! `open`, `openat`, `creat` and `opendir` are the run's already (domain_res.rs, which keeps what they open): they
+//! take their path through [`disk`]. The rest are here ([`interposer`]). Each passes its arguments on as it got
+//! them, a path argument replaced by its disk path where a folder mount names it; none is variadic.
+
+use std::cell::RefCell;
+use std::ffi::{CStr, CString, c_char, c_int, c_void};
+
+/// mode_t (sandbox/broker.rs declares the `*at` calls with it too).
+#[cfg(target_vendor = "apple")]
+type ModeT = u16;
+#[cfg(not(target_vendor = "apple"))]
+type ModeT = u32;
+
+thread_local! {
+    /// The disk paths handed to this thread's call in progress, by argument.
+    static HELD: RefCell<[Option<CString>; 2]> = const { RefCell::new([None, None]) };
+}
+
+/// `p` as the disk names it: a folder mount's path its disk path, held until this thread's next call that
+/// translates argument `slot` (0 or 1); any other path (a relative one, a disk one, one not UTF-8) itself.
+pub(crate) fn disk(p: *const c_char, slot: usize) -> *const c_char {
+    if p.is_null() || !relax_base::vfs::folder_mounted() {
+        return p;
+    }
+    let Ok(path) = unsafe { CStr::from_ptr(p) }.to_str() else { return p };
+    let std::borrow::Cow::Owned(on_disk) = relax_base::vfs::on_disk(path) else { return p };
+    let Ok(on_disk) = CString::new(on_disk) else { return p };
+    HELD.with(|h| {
+        let mut h = h.borrow_mut();
+        let at = &mut h[slot.min(1)];
+        *at = Some(on_disk);
+        at.as_ref().map_or(p, |c| c.as_ptr())
+    })
+}
+
+mod sys {
+    use super::*;
+    extern "C" {
+        pub fn stat(path: *const c_char, buf: *mut c_void) -> c_int;
+        pub fn lstat(path: *const c_char, buf: *mut c_void) -> c_int;
+        pub fn fstatat(fd: c_int, path: *const c_char, buf: *mut u8, flag: c_int) -> c_int;
+        pub fn access(path: *const c_char, mode: c_int) -> c_int;
+        pub fn faccessat(fd: c_int, path: *const c_char, mode: c_int, flag: c_int) -> c_int;
+        pub fn statfs(path: *const c_char, buf: *mut c_void) -> c_int;
+        pub fn readlink(path: *const c_char, buf: *mut c_char, size: usize) -> isize;
+        pub fn readlinkat(fd: c_int, path: *const c_char, buf: *mut u8, size: usize) -> isize;
+        pub fn mkdir(path: *const c_char, mode: ModeT) -> c_int;
+        pub fn mkdirat(fd: c_int, path: *const c_char, mode: ModeT) -> c_int;
+        pub fn rmdir(path: *const c_char) -> c_int;
+        pub fn unlink(path: *const c_char) -> c_int;
+        pub fn unlinkat(fd: c_int, path: *const c_char, flag: c_int) -> c_int;
+        pub fn truncate(path: *const c_char, len: i64) -> c_int;
+        pub fn chmod(path: *const c_char, mode: ModeT) -> c_int;
+        pub fn rename(from: *const c_char, to: *const c_char) -> c_int;
+        pub fn link(from: *const c_char, to: *const c_char) -> c_int;
+        #[cfg(target_vendor = "apple")]
+        pub fn getattrlist(path: *const c_char, attrs: *mut c_void, buf: *mut c_void, size: usize, options: u64) -> c_int;
+        #[cfg(target_vendor = "apple")]
+        pub fn clonefile(from: *const c_char, to: *const c_char, flags: u32) -> c_int;
+    }
+}
+
+extern "C" fn stat(path: *const c_char, buf: *mut c_void) -> c_int {
+    unsafe { sys::stat(disk(path, 0), buf) }
+}
+extern "C" fn lstat(path: *const c_char, buf: *mut c_void) -> c_int {
+    unsafe { sys::lstat(disk(path, 0), buf) }
+}
+extern "C" fn fstatat(fd: c_int, path: *const c_char, buf: *mut u8, flag: c_int) -> c_int {
+    unsafe { sys::fstatat(fd, disk(path, 0), buf, flag) }
+}
+extern "C" fn access(path: *const c_char, mode: c_int) -> c_int {
+    unsafe { sys::access(disk(path, 0), mode) }
+}
+extern "C" fn faccessat(fd: c_int, path: *const c_char, mode: c_int, flag: c_int) -> c_int {
+    unsafe { sys::faccessat(fd, disk(path, 0), mode, flag) }
+}
+extern "C" fn statfs(path: *const c_char, buf: *mut c_void) -> c_int {
+    unsafe { sys::statfs(disk(path, 0), buf) }
+}
+extern "C" fn readlink(path: *const c_char, buf: *mut c_char, size: usize) -> isize {
+    unsafe { sys::readlink(disk(path, 0), buf, size) }
+}
+extern "C" fn readlinkat(fd: c_int, path: *const c_char, buf: *mut u8, size: usize) -> isize {
+    unsafe { sys::readlinkat(fd, disk(path, 0), buf, size) }
+}
+extern "C" fn mkdir(path: *const c_char, mode: ModeT) -> c_int {
+    unsafe { sys::mkdir(disk(path, 0), mode) }
+}
+extern "C" fn mkdirat(fd: c_int, path: *const c_char, mode: ModeT) -> c_int {
+    unsafe { sys::mkdirat(fd, disk(path, 0), mode) }
+}
+extern "C" fn rmdir(path: *const c_char) -> c_int {
+    unsafe { sys::rmdir(disk(path, 0)) }
+}
+extern "C" fn unlink(path: *const c_char) -> c_int {
+    unsafe { sys::unlink(disk(path, 0)) }
+}
+extern "C" fn unlinkat(fd: c_int, path: *const c_char, flag: c_int) -> c_int {
+    unsafe { sys::unlinkat(fd, disk(path, 0), flag) }
+}
+extern "C" fn truncate(path: *const c_char, len: i64) -> c_int {
+    unsafe { sys::truncate(disk(path, 0), len) }
+}
+extern "C" fn chmod(path: *const c_char, mode: ModeT) -> c_int {
+    unsafe { sys::chmod(disk(path, 0), mode) }
+}
+extern "C" fn rename(from: *const c_char, to: *const c_char) -> c_int {
+    unsafe { sys::rename(disk(from, 0), disk(to, 1)) }
+}
+extern "C" fn link(from: *const c_char, to: *const c_char) -> c_int {
+    unsafe { sys::link(disk(from, 0), disk(to, 1)) }
+}
+#[cfg(target_vendor = "apple")]
+extern "C" fn getattrlist(path: *const c_char, attrs: *mut c_void, buf: *mut c_void, size: usize, options: u64) -> c_int {
+    unsafe { sys::getattrlist(disk(path, 0), attrs, buf, size, options) }
+}
+#[cfg(target_vendor = "apple")]
+extern "C" fn clonefile(from: *const c_char, to: *const c_char, flags: u32) -> c_int {
+    unsafe { sys::clonefile(disk(from, 0), disk(to, 1), flags) }
+}
+
+/// The run's version of the C library's path call `link` (its link name), for a program (jit.rs
+/// `lookup_interposer`). Linux's `*64` names are the same calls on a 64-bit target.
+pub(crate) fn interposer(link_name: &str) -> Option<u64> {
+    macro_rules! at {
+        ($f:expr) => {
+            Some($f as *const () as usize as u64)
+        };
+    }
+    match link_name {
+        "stat" | "stat64" => at!(stat),
+        "lstat" | "lstat64" => at!(lstat),
+        "fstatat" | "fstatat64" => at!(fstatat),
+        "access" => at!(access),
+        "faccessat" => at!(faccessat),
+        "statfs" | "statfs64" => at!(statfs),
+        "readlink" => at!(readlink),
+        "readlinkat" => at!(readlinkat),
+        "mkdir" => at!(mkdir),
+        "mkdirat" => at!(mkdirat),
+        "rmdir" => at!(rmdir),
+        "unlink" => at!(unlink),
+        "unlinkat" => at!(unlinkat),
+        "truncate" | "truncate64" => at!(truncate),
+        "chmod" => at!(chmod),
+        "rename" => at!(rename),
+        "link" => at!(link),
+        #[cfg(target_vendor = "apple")]
+        "getattrlist" => at!(getattrlist),
+        #[cfg(target_vendor = "apple")]
+        "clonefile" => at!(clonefile),
+        _ => None,
+    }
+}
