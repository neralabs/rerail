+#!/bin/bash
+# usage: run.sh <makepad binary>: the load hooks of an edition-2024 crate's test binary run under
+# `relax test` (#[unsafe(link_section = ..)]), and `relax check` reports no dead code for a private
+# #[unsafe(no_mangle)] fn. Prints "link_section_unsafe: ok" or "link_section_unsafe: FAILED" (exit 1).
+H=$(cd "$(dirname "$0")" && pwd)
+export RELAX_CACHE=off
+TEST=$(cd "$H" && RELAX_STD=$H/../../std "$1" test link-section-unsafe --lib 2>&1)
+CHECK=$(cd "$H" && RELAX_STD=$H/../../std "$1" check link-section-unsafe 2>&1)
+if echo "$TEST" | grep -q "test result: ok. 1 passed" && ! echo "$CHECK" | grep -q "never used"; then
+  echo "link_section_unsafe: ok"
+else
+  echo "$TEST" | tail -5; echo "$CHECK" | grep -A3 "never used"; echo "link_section_unsafe: FAILED"; exit 1
+fi
