+#!/bin/bash
+# usage: run.sh <makepad binary>: under RELAX_SHARE (the package folder-mounted, its paths on no disk), std's stat
+# of a mount path is the disk's, and the program's own C library calls (open, stat) reach the same files; a
+# symbolic link made outside the share keeps its relative target (src/lib.rs). Prints "share_folder_disk: ok" or "share_folder_disk: FAILED" (exit 1).
+H=$(cd "$(dirname "$0")" && pwd)
+T=$(mktemp -d) || exit 1
+[ -n "$T" ] || exit 1
+trap 'rm -rf "$T"' EXIT
+export RELAX_CACHE=off
+OUT=$(cd "$H" && RELAX_HOME="$T/home" RELAX_SHARE=share-folder-disk SHARE_FOLDER_DISK_MOUNTED=1 RELAX_STD=$H/../../std "$1" test share-folder-disk --lib 2>&1)
+if echo "$OUT" | grep -q "test result: ok. 2 passed"; then
+  echo "share_folder_disk: ok"
+else
+  echo "$OUT" | tail -12; echo "share_folder_disk: FAILED"; exit 1
+fi
diff --git a/libs/relax/compiler/tests/share_folder_disk/src/lib.rs b/libs/relax/compiler/tests/share_folder_disk/src/lib.rs
new file mode 100644
index 00000000..2e78cce9
--- /dev/null
+++ b/libs/relax/compiler/tests/share_folder_disk/src/lib.rs
@@ -0,0 +1,70 @@
+//! Under RELAX_SHARE the package is folder-mounted: CARGO_MANIFEST_DIR is the mount's path, on no disk. What std
+//! says of a path there is the disk's (a real device, inode and change time, not a synthetic stat), and so is what
+//! the program's own C library calls say of it: a program that compared the two (a listing by `open`, against stats
+//! std gave) saw every file changed, or no folder at all.
+
+#[cfg(test)]
+mod tests {
+    use std::ffi::{CString, c_char, c_int};
+    use std::os::fd::FromRawFd as _;
+    use std::os::unix::fs::MetadataExt as _;
+    use std::path::Path;
+
+    unsafe extern "C" {
+        fn open(path: *const c_char, flags: c_int, ...) -> c_int;
+        fn stat(path: *const c_char, buf: *mut u8) -> c_int;
+    }
+
+    fn c(p: &Path) -> CString {
+        CString::new(p.to_str().unwrap()).unwrap()
+    }
+
+    /// Outside the share, as before: a symbolic link's canonical path is its target's, its stat the target's.
+    #[test]
+    fn a_link_outside_the_share_is_its_target() {
+        let base = std::env::temp_dir().join(format!("share-folder-disk-{}", std::process::id()));
+        std::fs::create_dir_all(&base).unwrap();
+        std::fs::write(base.join("m0.py"), "x = 1\n").unwrap();
+        let link = base.join("alias.py");
+        let _ = std::fs::remove_file(&link);
+        std::os::unix::fs::symlink("m0.py", &link).unwrap();
+        let real = std::fs::canonicalize(&base).unwrap();
+        let got = std::fs::canonicalize(&link);
+        let meta = std::fs::metadata(&link).map(|m| m.ino());
+        let target = std::fs::metadata(base.join("m0.py")).unwrap().ino();
+        let _ = std::fs::remove_dir_all(&base);
+        assert_eq!(got.unwrap(), real.join("m0.py"));
+        assert_eq!(meta.unwrap(), target);
+    }
+
+    #[test]
+    fn a_share_paths_are_the_disks_to_std_and_to_libc() {
+        let dir = Path::new(env!("CARGO_MANIFEST_DIR"));
+        if std::env::var_os("SHARE_FOLDER_DISK_MOUNTED").is_some() {
+            assert!(dir.to_str().unwrap().contains("/vfs/share/"), "not run under the share's mount: {}", dir.display());
+        }
+        let src = dir.join("src");
+        let lib = src.join("lib.rs");
+        // std: the disk's stat
+        let meta = std::fs::metadata(&lib).unwrap();
+        assert!(meta.ino() != 0 && meta.dev() != 0 && meta.ctime() != 0, "a synthetic stat: ino {} dev {} ctime {}", meta.ino(), meta.dev(), meta.ctime());
+        let folder = std::fs::metadata(&src).unwrap();
+        assert!(folder.is_dir() && folder.ino() != 0 && folder.mtime() != 0, "a synthetic folder stat");
+        // a listing's entries: the same files
+        let listed = std::fs::read_dir(&src).unwrap().flatten().find(|e| e.file_name() == "lib.rs").expect("lib.rs listed");
+        assert_eq!(listed.metadata().unwrap().ino(), meta.ino());
+        // the C library, called by the program itself, on the mount's paths
+        let fd = unsafe { open(c(&src).as_ptr(), 0) };
+        assert!(fd >= 0, "open({}): {}", src.display(), std::io::Error::last_os_error());
+        let opened = unsafe { std::fs::File::from_raw_fd(fd) };
+        assert_eq!(opened.metadata().unwrap().ino(), folder.ino(), "the folder libc opened is not the one std stated");
+        let mut buf = [0u8; 512];
+        assert_eq!(unsafe { stat(c(&lib).as_ptr(), buf.as_mut_ptr()) }, 0, "stat({}): {}", lib.display(), std::io::Error::last_os_error());
+        // canonical: still the mount's path, as the program was given
+        let canonical = std::fs::canonicalize(&lib).unwrap();
+        assert!(canonical.starts_with(std::fs::canonicalize(dir).unwrap()) && canonical.ends_with("src/lib.rs"), "canonical: {}", canonical.display());
+        if std::env::var_os("SHARE_FOLDER_DISK_MOUNTED").is_some() {
+            assert!(canonical.to_str().unwrap().contains("/vfs/share/"), "canonical left the mount: {}", canonical.display());
+        }
+    }
+}
