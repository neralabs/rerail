+/// What a script whose build-dependencies reach the native packages `reached` (their crates) takes
+/// from the receipt, for its rerun key: those packages' outputs (cfgs, env, OUT_DIR, system
+/// libraries), a path package's files, and the library's packages and archives. Not the library's
+/// path, nor the other packages' outputs: both change with any native package's build (the
+/// library's folder is the native key's, which hashes every native path package's files; a
+/// package's script can set a rustc-env over all its sources), and every script reaches some
+/// native package (libc is one), so a key over the whole receipt ran every script again, in a
+/// new OUT_DIR, after any edit of such a package, and every crate whose closure reads an OUT_DIR
+/// lost its stores.
+pub fn receipt_identity(g: &Graph, reached: &[usize], scripts: &[ScriptOut], lib: Option<&NativeLib>) -> String {
+    let pkgs: Vec<(&(String, String, String), bool)> = reached.iter().map(|&k| (&g.pkg[k], g.crates[k].registry)).collect();
+    let runs: Vec<(&str, &str, &ScriptOut)> = scripts.iter().map(|o| (g.pkg[o.krate].1.as_str(), g.pkg[o.krate].2.as_str(), o)).collect();
+    identity_of(pkgs, &runs, lib)
