+/// jit.rs `materialize_fault`: a fault in program code the run ends by (contained, then fatal) goes to the program's
+/// handler for its signal first, as a rustc build's kernel would have run it: on the faulting thread (here at its
+/// recovery point, outside a compile), with a siginfo of the signal, a kernel code and the address, and no context
+/// (the fault's registers are gone). False: no program handler, or not a program thread. The caller ends the
+/// process by the signal after it either way.
+pub(crate) unsafe fn fatal_fault(sig: i32, addr: u64) -> bool {
+    #[cfg(target_vendor = "apple")]
+    const SI_ADDR: usize = 24;
+    #[cfg(not(target_vendor = "apple"))]
+    const SI_ADDR: usize = 16;
+    // siginfo_t: 128 bytes on Linux, 104 on Darwin
+    let mut info = [0u64; 16];
+    let p = info.as_mut_ptr() as *mut u8;
+    *(p as *mut i32) = sig;
+    // si_code 1: SEGV_MAPERR / BUS_ADRALN / ILL_ILLOPC / FPE_INTDIV, the kernel's own (`synchronous`)
+    *(p.add(8) as *mut i32) = 1;
+    *(p.add(SI_ADDR) as *mut u64) = addr;
+    deliver(sig, p, std::ptr::null_mut(), true)
+}
