+/// glibc keeps 512 bytes of static TLS for libraries loaded after the start, and an `--allow-c`
+/// native library that bundles an allocator (jemalloc, mimalloc: initial-exec TLS) needs more:
+/// its load failed "cannot allocate memory in static TLS block". The surplus is fixed when the
+/// process starts, from GLIBC_TUNABLES, so Relax restarts itself once with room for it (and
+/// every process it starts inherits it).
+#[cfg(all(target_os = "linux", target_env = "gnu"))]
+fn static_tls_room() {
+    use std::os::unix::process::CommandExt;
+    const TUNABLE: &str = "glibc.rtld.optional_static_tls";
+    let old = std::env::var("GLIBC_TUNABLES").unwrap_or_default();
+    if old.contains(TUNABLE) {
+        return;
+    }
+    let new = if old.is_empty() { format!("{TUNABLE}=262144") } else { format!("{old}:{TUNABLE}=262144") };
+    let mut args = std::env::args_os();
+    let arg0 = args.next().unwrap_or_default();
+    let err = std::process::Command::new("/proc/self/exe").arg0(arg0).args(args).env("GLIBC_TUNABLES", new).exec();
+    eprintln!("relax: could not restart with room for native libraries' static TLS: {err}");
+}
