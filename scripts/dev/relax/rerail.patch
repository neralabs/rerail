+//! relax test fixture: a crate's own test binary registers at load (an init-array entry), as
+//! edition 2024 writes it: `#[used]` with `#[unsafe(link_section = ..)]`, behind `cfg_attr`, bare,
+//! and with the section's name from a macro. Edition 2024 rejects the bare `#[link_section]`, so
+//! a Relax that read only that form ran none of them. A private `#[unsafe(no_mangle)]` fn is kept
+//! alive (no dead_code warning), as rustc's.
+use std::sync::atomic::AtomicU32;
+pub static LOADED: AtomicU32 = AtomicU32::new(0);
+
+#[cfg(test)]
+mod plain {
+    extern "C" fn load() { super::LOADED.fetch_or(1, std::sync::atomic::Ordering::SeqCst); }
+    #[used]
+    #[cfg_attr(target_vendor = "apple", unsafe(link_section = "__DATA,__mod_init_func"))]
+    #[cfg_attr(not(target_vendor = "apple"), unsafe(link_section = ".init_array"))]
+    static LOAD: extern "C" fn() = load;
+}
+
+#[cfg(all(test, target_vendor = "apple"))]
+mod direct {
+    extern "C" fn load() { super::LOADED.fetch_or(2, std::sync::atomic::Ordering::SeqCst); }
+    #[used]
+    #[unsafe(link_section = "__DATA,__mod_init_func")]
+    static LOAD: extern "C" fn() = load;
+}
+
+// the section's name from a macro, as a crate writes it for each target
+#[cfg(all(test, target_vendor = "apple"))]
+mod expanded {
+    extern "C" fn load() { super::LOADED.fetch_or(4, std::sync::atomic::Ordering::SeqCst); }
+    #[used]
+    #[unsafe(link_section = concat!("__DATA,", "__mod_init_func"))]
+    static LOAD: extern "C" fn() = load;
+}
+
+#[test]
+fn every_hook_ran_at_load() {
+    assert_eq!(LOADED.load(std::sync::atomic::Ordering::SeqCst), 7);
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn link_section_unsafe_exported() -> u32 { 7 }
diff --git a/libs/relax/compiler/tests/neon_narrow_count_lane.rs b/libs/relax/compiler/tests/neon_narrow_count_lane.rs
new file mode 100644
index 00000000..d956bea0
--- /dev/null
+++ b/libs/relax/compiler/tests/neon_narrow_count_lane.rs
@@ -0,0 +1,55 @@
+//! NEON intrinsics the engine's SIMD crate and join kernels call: count leading zeros (`vclzq_s32`,
+//! `vclzq_u8`), the narrowing high halves (`vmovn_high_u64`, `vshrn_high_n_u16`), the 48-byte table
+//! lookup (`vqtbl3q_u8`), a lane broadcast (`vdupq_laneq_u32`) and the 8-lane pairwise and across
+//! sums (`vpadd_u8`, `vaddv_u8`). The expected lanes are rustc's on an M-series Mac.
+
+#[cfg(target_arch = "aarch64")]
+#[test]
+fn narrowing_counting_and_lane_intrinsics_match_rustc() {
+    use std::arch::aarch64::*;
+    unsafe {
+        let s: [i32; 4] = [0, 1, -1, 0x0010_0000];
+        let mut clz_s = [0i32; 4];
+        vst1q_s32(clz_s.as_mut_ptr(), vclzq_s32(vld1q_s32(s.as_ptr())));
+        assert_eq!(clz_s, [32, 31, 0, 11]);
+
+        let b: [u8; 16] = [0, 1, 2, 3, 4, 7, 8, 15, 16, 31, 32, 63, 64, 127, 128, 255];
+        let mut clz_b = [0u8; 16];
+        vst1q_u8(clz_b.as_mut_ptr(), vclzq_u8(vld1q_u8(b.as_ptr())));
+        assert_eq!(clz_b, [8, 7, 6, 6, 5, 5, 4, 4, 3, 3, 2, 2, 1, 1, 0, 0]);
+
+        let lo: [u32; 2] = [7, 9];
+        let wide: [u64; 2] = [0x1_0000_0005, 0xffff_ffff_ffff_fffe];
+        let mut movn = [0u32; 4];
+        vst1q_u32(movn.as_mut_ptr(), vmovn_high_u64(vld1_u32(lo.as_ptr()), vld1q_u64(wide.as_ptr())));
+        assert_eq!(movn, [7, 9, 5, 0xffff_fffe]);
+
+        let h: [u16; 8] = [0x0100, 0x1234, 0xffff, 0x00f0, 0x8000, 0x0010, 0x7f7f, 0x0001];
+        let low8: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
+        let mut shrn = [0u8; 16];
+        vst1q_u8(shrn.as_mut_ptr(), vshrn_high_n_u16::<4>(vld1_u8(low8.as_ptr()), vld1q_u16(h.as_ptr())));
+        assert_eq!(shrn, [1, 2, 3, 4, 5, 6, 7, 8, 0x10, 0x23, 0xff, 0x0f, 0x00, 0x01, 0xf7, 0x00]);
+
+        let t: [u8; 48] = core::array::from_fn(|i| 100 + i as u8);
+        let idx: [u8; 16] = [0, 15, 16, 31, 32, 47, 48, 255, 5, 20, 40, 63, 1, 33, 17, 64];
+        let table = uint8x16x3_t(vld1q_u8(t.as_ptr()), vld1q_u8(t.as_ptr().add(16)), vld1q_u8(t.as_ptr().add(32)));
+        let mut tbl = [0u8; 16];
+        vst1q_u8(tbl.as_mut_ptr(), vqtbl3q_u8(table, vld1q_u8(idx.as_ptr())));
+        assert_eq!(tbl, [100, 115, 116, 131, 132, 147, 0, 0, 105, 120, 140, 0, 101, 133, 117, 0]);
+
+        let v: [u32; 4] = [10, 20, 30, 40];
+        let mut dup = [0u32; 4];
+        vst1q_u32(dup.as_mut_ptr(), vdupq_laneq_u32::<3>(vld1q_u32(v.as_ptr())));
+        assert_eq!(dup, [40; 4]);
+        vst1q_u32(dup.as_mut_ptr(), vdupq_laneq_u32::<1>(vld1q_u32(v.as_ptr())));
+        assert_eq!(dup, [20; 4]);
+
+        let p: [u8; 8] = [1, 2, 250, 10, 128, 128, 0, 7];
+        let q: [u8; 8] = [3, 4, 5, 6, 255, 1, 9, 9];
+        let mut padd = [0u8; 8];
+        vst1_u8(padd.as_mut_ptr(), vpadd_u8(vld1_u8(p.as_ptr()), vld1_u8(q.as_ptr())));
+        assert_eq!(padd, [3, 4, 0, 7, 7, 11, 0, 18]);
+        assert_eq!(vaddv_u8(vld1_u8(p.as_ptr())), 14);
+        assert_eq!(vaddv_u8(vld1_u8(q.as_ptr())), 36);
+    }
+}
diff --git a/libs/relax/compiler/tests/neon_table_extend.rs b/libs/relax/compiler/tests/neon_table_extend.rs
new file mode 100644
index 00000000..4d7901ef
--- /dev/null
+++ b/libs/relax/compiler/tests/neon_table_extend.rs
@@ -0,0 +1,26 @@
+//! NEON's table lookup with extension (TBX, `vqtbx1q_u8` / `vqtbx1q_s8`): each lane of the index
+//! vector picks a byte of the table, and an index of 16 or more keeps the first operand's lane
+//! (TBL's `vqtbl1q_u8` gives 0 there). simdjson's arm64 stage 1 classifies whitespace with it. The
+//! expected lanes are rustc's on an M-series Mac.
+
+#[cfg(target_arch = "aarch64")]
+#[test]
+fn tbx_keeps_the_first_operand_past_the_table() {
+    use std::arch::aarch64::*;
+    let a: [u8; 16] = core::array::from_fn(|i| 100 + i as u8);
+    let t: [u8; 16] = core::array::from_fn(|i| 200 + i as u8);
+    let idx: [u8; 16] = [0, 15, 16, 255, 3, 17, 8, 128, 1, 2, 14, 31, 7, 9, 64, 5];
+    let mut out = [0u8; 16];
+    let mut outs = [0i8; 16];
+    let mut tbl = [0u8; 16];
+    unsafe {
+        let r = vqtbx1q_u8(vld1q_u8(a.as_ptr()), vld1q_u8(t.as_ptr()), vld1q_u8(idx.as_ptr()));
+        vst1q_u8(out.as_mut_ptr(), r);
+        let rs = vqtbx1q_s8(vreinterpretq_s8_u8(vld1q_u8(a.as_ptr())), vreinterpretq_s8_u8(vld1q_u8(t.as_ptr())), vld1q_u8(idx.as_ptr()));
+        vst1q_s8(outs.as_mut_ptr(), rs);
+        vst1q_u8(tbl.as_mut_ptr(), vqtbl1q_u8(vld1q_u8(t.as_ptr()), vld1q_u8(idx.as_ptr())));
+    }
+    assert_eq!(out, [200, 215, 102, 103, 203, 105, 208, 107, 201, 202, 214, 111, 207, 209, 114, 205]);
+    assert_eq!(outs, [-56, -41, 102, 103, -53, 105, -48, 107, -55, -54, -42, 111, -49, -47, 114, -51]);
+    assert_eq!(tbl, [200, 215, 0, 0, 203, 0, 208, 0, 201, 202, 214, 0, 207, 209, 0, 205]);
+}
