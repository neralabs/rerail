+/// `text` (UTF-8) with each folder mount's paths in it as the disk names them ([`shown`]), held until
+/// `relax_vfs_release`; 0 when it names none (or is not UTF-8). For a program the run starts, which reads the disk,
+/// not the mounts (std process_unix.rs): a share's paths (`CARGO_MANIFEST_DIR`, `file!()`) are the mount's.
+pub extern "C" fn relax_vfs_shown(p: *const u8, n: usize, out: *mut *const u8, out_len: *mut usize) -> u64 {
+    let Ok(text) = std::str::from_utf8(unsafe { std::slice::from_raw_parts(p, n) }) else { return 0 };
+    match shown(text) {
+        std::borrow::Cow::Owned(s) => hold(s.into_bytes(), out, out_len),
+        std::borrow::Cow::Borrowed(_) => 0,
+    }
+}
+
+/// The disk path of `p` under a folder mount (a shared workspace's checkout, SHARE), held until
+/// `relax_vfs_release`; 0 when `p` is under none. A folder mount names a disk folder under another
+/// path, nothing more: std answers its paths from the disk (std fs_vfs.rs `folder_disk`), so a
+/// program's stats, listings and descriptors are the disk's, as are those of the libc calls it makes
+/// itself (jit.rs `relax_libc_path`).
+pub extern "C" fn relax_vfs_folder_disk(p: *const u8, n: usize, out: *mut *const u8, out_len: *mut usize) -> u64 {
+    if !ANY_FOLDER.load(Ordering::Acquire) {
+        return 0;
+    }
+    match folder_path(unsafe { path_arg(p, n) }) {
+        Some(disk) => hold(disk.to_string_lossy().into_owned().into_bytes(), out, out_len),
+        None => 0,
+    }
+}
+
+/// `p` (a disk path) under the folder mount that names its folder ([`virtual_of`]), held until
+/// `relax_vfs_release`; 0 when no folder mount names it. A path std hands back (`canonicalize`) is
+/// the mount's, as the paths the program was given are.
+pub extern "C" fn relax_vfs_folder_virtual(p: *const u8, n: usize, out: *mut *const u8, out_len: *mut usize) -> u64 {
+    match virtual_of(unsafe { path_arg(p, n) }) {
+        std::borrow::Cow::Owned(s) => hold(s.into_bytes(), out, out_len),
+        std::borrow::Cow::Borrowed(_) => 0,
+    }
+}
+
