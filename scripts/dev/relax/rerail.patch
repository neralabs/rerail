@@ -0,0 +1,26 @@
+//! NEON's table lookup with extension (TBX, `vqtbx1q_u8` / `vqtbx1q_s8`): each lane of the index
+//! vector picks a byte of the table, and an index of 16 or more keeps the first operand's lane
+//! (TBL's `vqtbl1q_u8` gives 0 there). simdjson's arm64 stage 1 classifies whitespace with it. The
+//! expected lanes are rustc's on an M-series Mac.
+
+#[cfg(target_arch = "aarch64")]
+#[test]
+fn tbx_keeps_the_first_operand_past_the_table() {
+    use std::arch::aarch64::*;
+    let a: [u8; 16] = core::array::from_fn(|i| 100 + i as u8);
+    let t: [u8; 16] = core::array::from_fn(|i| 200 + i as u8);
+    let idx: [u8; 16] = [0, 15, 16, 255, 3, 17, 8, 128, 1, 2, 14, 31, 7, 9, 64, 5];
+    let mut out = [0u8; 16];
+    let mut outs = [0i8; 16];
+    let mut tbl = [0u8; 16];
+    unsafe {
+        let r = vqtbx1q_u8(vld1q_u8(a.as_ptr()), vld1q_u8(t.as_ptr()), vld1q_u8(idx.as_ptr()));
+        vst1q_u8(out.as_mut_ptr(), r);
+        let rs = vqtbx1q_s8(vreinterpretq_s8_u8(vld1q_u8(a.as_ptr())), vreinterpretq_s8_u8(vld1q_u8(t.as_ptr())), vld1q_u8(idx.as_ptr()));
+        vst1q_s8(outs.as_mut_ptr(), rs);
+        vst1q_u8(tbl.as_mut_ptr(), vqtbl1q_u8(vld1q_u8(t.as_ptr()), vld1q_u8(idx.as_ptr())));
+    }
+    assert_eq!(out, [200, 215, 102, 103, 203, 105, 208, 107, 201, 202, 214, 111, 207, 209, 114, 205]);
+    assert_eq!(outs, [-56, -41, 102, 103, -53, 105, -48, 107, -55, -54, -42, 111, -49, -47, 114, -51]);
+    assert_eq!(tbl, [200, 215, 0, 0, 203, 0, 208, 0, 201, 202, 214, 0, 207, 209, 0, 205]);
+}
