+        let base = id(&[("libc", "0.2", &h), ("libc", "0.2", &t), ("engine", "0.1", &e1)], "/n/1/lib.dylib", &["z", "c"]);
+        assert_eq!(base, id(&[("libc", "0.2", &t), ("libc", "0.2", &h), ("engine", "0.1", &e1)], "/n/1/lib.dylib", &["z", "c"]), "the runs' order");
+        assert_eq!(base, id(&[("libc", "0.2", &h), ("libc", "0.2", &t), ("engine", "0.1", &e1)], "/n/1/lib.dylib", &["c", "z"]), "the archives' order");
+        assert_eq!(base, id(&[("libc", "0.2", &h), ("libc", "0.2", &t), ("engine", "0.1", &e2)], "/n/2/lib.dylib", &["z", "c"]), "a package not reached, and the library's folder");
