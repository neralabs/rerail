+#!/bin/bash
+# usage: run.sh <makepad binary>: the load hooks of an edition-2024 crate's test binary run under
+# `relax test` (#[unsafe(link_section = ..)]), and `relax check` reports no dead code for a private
+# #[unsafe(no_mangle)] fn. Prints "link_section_unsafe: ok" or "link_section_unsafe: FAILED" (exit 1).
+H=$(cd "$(dirname "$0")" && pwd)
+export RELAX_CACHE=off
+TEST=$(cd "$H" && RELAX_STD=$H/../../std "$1" test link-section-unsafe --lib 2>&1)
+CHECK=$(cd "$H" && RELAX_STD=$H/../../std "$1" check link-section-unsafe 2>&1)
+if echo "$TEST" | grep -q "test result: ok. 1 passed" && ! echo "$CHECK" | grep -q "never used"; then
+  echo "link_section_unsafe: ok"
+else
+  echo "$TEST" | tail -5; echo "$CHECK" | grep -A3 "never used"; echo "link_section_unsafe: FAILED"; exit 1
+fi
diff --git a/libs/relax/compiler/tests/link_section_unsafe/src/lib.rs b/libs/relax/compiler/tests/link_section_unsafe/src/lib.rs
new file mode 100644
index 00000000..48984537
--- /dev/null
+++ b/libs/relax/compiler/tests/link_section_unsafe/src/lib.rs
@@ -0,0 +1,41 @@
+//! relax test fixture: a crate's own test binary registers at load (an init-array entry), as
+//! edition 2024 writes it: `#[used]` with `#[unsafe(link_section = ..)]`, behind `cfg_attr`, bare,
+//! and with the section's name from a macro. Edition 2024 rejects the bare `#[link_section]`, so
+//! a Relax that read only that form ran none of them. A private `#[unsafe(no_mangle)]` fn is kept
+//! alive (no dead_code warning), as rustc's.
+use std::sync::atomic::AtomicU32;
+pub static LOADED: AtomicU32 = AtomicU32::new(0);
+
+#[cfg(test)]
+mod plain {
+    extern "C" fn load() { super::LOADED.fetch_or(1, std::sync::atomic::Ordering::SeqCst); }
+    #[used]
+    #[cfg_attr(target_vendor = "apple", unsafe(link_section = "__DATA,__mod_init_func"))]
+    #[cfg_attr(not(target_vendor = "apple"), unsafe(link_section = ".init_array"))]
+    static LOAD: extern "C" fn() = load;
+}
+
+#[cfg(all(test, target_vendor = "apple"))]
+mod direct {
+    extern "C" fn load() { super::LOADED.fetch_or(2, std::sync::atomic::Ordering::SeqCst); }
+    #[used]
+    #[unsafe(link_section = "__DATA,__mod_init_func")]
+    static LOAD: extern "C" fn() = load;
+}
+
+// the section's name from a macro, as a crate writes it for each target
+#[cfg(all(test, target_vendor = "apple"))]
+mod expanded {
+    extern "C" fn load() { super::LOADED.fetch_or(4, std::sync::atomic::Ordering::SeqCst); }
+    #[used]
+    #[unsafe(link_section = concat!("__DATA,", "__mod_init_func"))]
+    static LOAD: extern "C" fn() = load;
+}
+
+#[test]
+fn every_hook_ran_at_load() {
+    assert_eq!(LOADED.load(std::sync::atomic::Ordering::SeqCst), 7);
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn link_section_unsafe_exported() -> u32 { 7 }
