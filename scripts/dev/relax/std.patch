+#[cfg_attr(target_arch = "aarch64", target_feature(enable = "neon"))]
+pub unsafe fn vst2q_u32(a: *mut u32, b: uint32x4x2_t) {
+    let mut i = 0;
+    while i < 4 {
+        unsafe {
+            a.add(2 * i).write_unaligned(b.0.0[i]);
+            a.add(2 * i + 1).write_unaligned(b.1.0[i]);
+        }
+        i += 1;
+    }
+}
