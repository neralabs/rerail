+#[cfg_attr(target_arch = "aarch64", target_feature(enable = "neon"))]
+pub unsafe fn vld2q_u32(a: *const u32) -> uint32x4x2_t {
+    let (mut x, mut y) = ([0; 4], [0; 4]);
+    let mut i = 0;
+    while i < 4 {
+        x[i] = unsafe { a.add(2 * i).read_unaligned() };
+        y[i] = unsafe { a.add(2 * i + 1).read_unaligned() };
+        i += 1;
+    }
+    uint32x4x2_t(uint32x4_t(x), uint32x4_t(y))
