#!/usr/bin/python3
"""Runs a test command on another Mac of the build farm, in this checkout's copy there; here when none
is usable (docs/final-shape/notes/t37, §2; scripts/build/farm/README.md).

    scripts/dev/test-remote [--host NAME] [--os macos|linux|windows|any] [--dir native] [--remote-only] [--tree DIR]... -- COMMAND...

e.g. `scripts/dev/test-remote -- cargo nextest run --lib --profile gate` for the full suite, or
`scripts/dev/test-remote -- cargo nextest run --lib -E 'test(/some::filter/)'`.

The host is a usable one (`scripts/build/farm/status`: reachable, on its link, with disk to spare)
with a free test slot (a third of its cores, or `test_slots` in the configuration), the one with the
most of its slots free first, then the most cores to spare; with none free, whichever slot frees
first on any of them.
What changed of this checkout is sent through the farm's mirror into the host's farm root, after
the host is asked again what it holds (it may have been cleaned). COMMAND runs there at `nice -n
10`, from the checkout's `native/` (or `--dir`), with this machine's open-file limit, and builds in
a target directory of its own on the host (one per checkout, kept warm, removed after 14 unused
days or when the host's disk runs short), never the checkout's `target/`. Its output is printed
here.

With no usable host, or when the host is lost during the run (asleep, off the network: ssh exits
255), COMMAND runs here instead, at `nice -n 19`; `--remote-only` exits 69 instead. The exit
status is COMMAND's. Ctrl-C, a kill or a closed terminal stops it on the host too.

A host may be a Linux machine (`"os": "linux"` in the configuration): COMMAND there is a Linux
build and run, as CI's. The Macs go first; a Linux host takes a command when every Mac slot is
taken, and never one that needs macOS: one naming Metal (`metal-tests`, `rerail-device-metal`) or
sending a `--tree` (a program built here is a macOS one). `--os linux` sends it to a Linux host
only, `--os any` lets any host take it, `--os macos` keeps it off Linux.

A Windows host (`"os": "windows"`: a Windows PC's or VM's Windows side, through its WSL) takes a
command only with `--os windows` (or `--host`): COMMAND runs there as a Windows build (Windows'
cargo and MSVC, at a low priority; a leading `nice -n N` sets it), in a copy of the checkout on
its drive. One machine's Linux and Windows sides share its test slots: what is queued decides how
many of each run.

`--tree DIR` also sends DIR whole (untracked files too, at the same path under the host's farm
root): a run's inputs and a program built here, e.g. `--tree tmp/bench --tree tmp/engines` for a
benchmark run on the host.

It runs the installed farm (`~/.local/share/rerail-farm`, `scripts/build/farm/setup`), the one every
worktree's compiles use, whatever version this checkout has.
"""
import concurrent.futures
import os
import resource
import json
import shlex
import signal
import subprocess
import sys
import time

# The checkout's: the installed copy of this script runs for every checkout (the farm hands a
# checkout's own copy to it), told which.
CHECKOUT = os.environ.get("RERAIL_FARM_CHECKOUT") or os.path.realpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "../.."))
SHARE = os.path.expanduser("~/.local/share/rerail-farm")
USAGE = __doc__.split("\n\n")[1]

UNAVAILABLE = 69



def say(message):
    print(f"test-remote: {message}", file=sys.stderr, flush=True)


def stop_on_signals():
    def stop(signum, frame):
        raise KeyboardInterrupt
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, stop)


def here(argv, directory, why, remote_only):
    if remote_only:
        say(f"{why}; --remote-only: not run")
        sys.exit(UNAVAILABLE)
    say(f"{why}: running it here, at nice 19")
    proc = subprocess.Popen(["nice", "-n", "19"] + argv, cwd=os.path.join(CHECKOUT, directory),
                            env=dict(os.environ, RERAIL_FARM_TESTS_HERE="1"))
    try:
        sys.exit(proc.wait())
    except KeyboardInterrupt:
        proc.terminate()
        sys.exit(proc.wait())


def needs_macos(argv, trees):
    """Whether COMMAND must run on a Mac: it names Metal, or runs what `--tree` sends."""
    return bool(trees) or "metal" in " ".join(argv).lower()


def stopped_guests(oses):
    """The guests (guest.py) of one of `oses` that take test commands and are stopped now: each one
    machine, so a Windows host and its Linux side (`shares`) count once, the one of `oses`."""
    out, seen = [], set()
    for h in farm.hosts():
        if not h.get("enabled", True) or not h.get("tests", True) or h.get("by_name") or farm.host_os(h) not in oses:
            continue
        base = farm.shared_base(h)
        if base.get("guest") and base["name"] not in seen and farm.health(h).get("guest") == "stopped":
            seen.add(base["name"])
            out.append(h)
    return out


def wait_for_guest(host):
    """`host`'s health once its guest is up, or once its start failed (at most START_SECONDS and a minute)."""
    deadline = time.time() + guest.START_SECONDS + 60
    while time.time() < deadline:
        h = farm.health(host)
        if h.get("ok") or h.get("guest") == "stopped":
            return h
        time.sleep(3)
    return farm.health(host)


def choose(named, oses, roots):
    """A usable host of one of `oses`, its test slot and this checkout's copy there (`farm.CopyUse`
    of the tree `roots` hold), each held until exit; or (None, None, None, why)."""
    if named:
        host = next((h for h in farm.hosts() if h["name"] == named), None)
        if host is None:
            return None, None, None, f"{named} is not in the farm's configuration"
        if farm.host_os(host) not in oses:
            return None, None, None, f"{named} is a {farm.host_os(host)} host, and this command runs on {' or '.join(oses)} (--os)"
        h = farm.health(host, fresh=True)
        if not h.get("ok") and h.get("guest") in ("stopped", "starting") and guest.request_start(host):
            base = guest.spec(host)[0]
            what = "its guest " + base["name"] if base["name"] != named else "the guest"
            if farm.host_os(host) == "windows" and base["name"] != named:
                what = f"{base['name']}, its WSL (which runs its Windows jobs)"
            say(f"{named}: starting {what} (guest.py; up to {guest.START_SECONDS // 60} min)")
            h = wait_for_guest(host)
        if not h.get("ok"):
            return None, None, None, f"{named} is not usable: {h.get('why')}"
        candidates = [host]
    else:
        candidates = [h for h in farm.usable("tests") if farm.host_os(h) in oses]
        if not candidates:
            # Every host is backed off: asked again now, together (a few seconds), before the command
            # runs here. A back-off is a guess about a host, and running here on a wrong one costs more.
            hosts = [h for h in farm.hosts() if h.get("enabled", True) and h.get("tests", True) and farm.host_os(h) in oses]
            with concurrent.futures.ThreadPoolExecutor(max(len(hosts), 1)) as pool:
                list(pool.map(lambda h: farm.health(h, fresh=True), hosts))
            candidates = [h for h in farm.usable("tests") if farm.host_os(h) in oses]
        if not candidates and stopped_guests(oses):
            # No running host of these: a guest that can be one is started, and the command waits
            # for it (below), as for a slot.
            pass
        elif not candidates:
            reasons = [f"{h['name']}: {farm.health(h).get('why') or 'not ' + ' or '.join(oses)}" for h in farm.hosts()
                       if h.get("enabled", True) and h.get("tests", True)]
            return None, None, None, "no usable host" + (f" ({'; '.join(reasons)})" if reasons else " (none configured)")
    said = False
    starting = []
    while True:
        # A guest started for this command (below) that is up now is a candidate too.
        for g in starting:
            if g not in candidates and farm.health(g).get("ok"):
                candidates.append(g)
        if starting and not any(farm.health(g).get("guest") == "starting" or farm.health(g).get("ok") for g in starting) \
                and not any(farm.health(h).get("ok") for h in candidates):
            return None, None, None, "no usable host, and the guests started for it did not come up (" + \
                "; ".join(f"{g['name']}: {farm.health(g).get('why')}" for g in starting) + ")"
        # The host with the most of its test slots free, then the most cores to spare; any slot that
        # frees on any host is taken, not only the first host's.
        free = []
        tree = mirror.fingerprint(roots)
        other_tree = []
        for host in candidates:
            # Asked again while waiting: a host that started a fleet job meanwhile takes nothing more.
            if not farm.health(host).get("ok"):
                continue
            paths = farm.test_slot_paths(host["name"], host)
            got = None
            idle = 0
            for path in paths:
                lock = farm.Lock(path, blocking=False)
                if lock.held:
                    idle += 1
                    if got is None:
                        got = lock
                        continue
                lock.release()
            if got:
                # This checkout's copy there: idle, or running from this very tree; else another
                # command of this checkout runs there from other files, which this one would change.
                # (a Windows host's copy is its machine's Linux one: `shared_base`)
                use = farm.CopyUse(farm.shared_base(host)["name"], CHECKOUT, tree)
                if not use.held:
                    other_tree.append(host["name"])
                    got.release()
                    continue
                # This checkout's commands on one host share its target directory there, and cargo
                # builds for them one at a time: a host where none runs goes first.
                # (a host short of disk last: it keeps only its recently used targets, and drops
                # even those under its floor)
                free.append((farm.host_os(host) != "macos", bool(farm.health(host).get("short")), not use.sends,
                             -idle / len(paths), -farm.spare(host), host, got, use))
        if free:
            # A Mac first: a Linux host's run is another platform's build.
            free.sort(key=lambda f: f[:5])
            for f in free[1:]:
                f[6].release()
                f[7].release()
            best = free[0]
            best[6].used()
            return best[5], best[6], best[7], None
        if not starting:
            # It would wait: the stopped guests that can take it are started (guest.py), and it
            # takes the first slot that frees, a running host's or a guest's once it is up.
            # One a command: another machine's before this Mac's (where the edit loop runs), then the
            # most cores; a second command that would wait starts the next.
            order = sorted(stopped_guests(oses), key=lambda g: (farm.shared_base(g)["guest"]["on"] == "local", -g.get("cores", 0)))
            starting = next(([g] for g in order if guest.request_start(g)), [])
            if starting:
                say("starting " + ", ".join(f"{g['name']} (a guest on {guest.placement(farm.shared_base(g)['guest']) or farm.shared_base(g)['guest']['on']})" for g in starting)
                    + f": it takes the command once it is up, unless a slot frees first (up to {guest.START_SECONDS // 60} min)")
        if not said and candidates:
            say("every test slot of every usable host is taken"
                + (f", or this checkout's copy there runs another command from other files ({', '.join(other_tree)})" if other_tree else "")
                + ": waiting for the first that frees (" + ", ".join(f"{h['name']} {farm.test_slots(h)}" for h in candidates) + ")")
            said = True
        time.sleep(2)


def usage(why):
    sys.exit(f"test-remote: {why}\nusage:{USAGE}\n(scripts/dev/test-remote --help for more)")


def parse(argv):
    """The options and COMMAND, checked before anything is sent: an unknown option or a missing
    COMMAND is refused here, never run on a host."""
    named, directory, remote_only, trees, os_choice = None, "native", False, [], None
    while argv and argv[0] != "--":
        a = argv[0]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if a == "--remote-only":
            remote_only, argv = True, argv[1:]
        elif a == "--tree":
            if len(argv) < 2 or not os.path.isdir(argv[1]):
                usage("--tree needs a directory")
            trees.append(os.path.realpath(argv[1]))
            argv = argv[2:]
        elif a == "--os":
            if len(argv) < 2 or argv[1] not in ("macos", "linux", "windows", "any"):
                usage("--os takes macos, linux, windows or any")
            os_choice, argv = argv[1], argv[2:]
        elif a in ("--host", "--dir"):
            if len(argv) < 2 or argv[1].startswith("-"):
                usage(f"{a} needs a value")
            if a == "--host":
                named = argv[1]
            else:
                directory = argv[1]
            argv = argv[2:]
        elif a.startswith("-"):
            usage(f"unknown option {a}")
        else:
            usage(f"COMMAND goes after --: {a}")
    argv = argv[1:]
    if not argv:
        usage("no COMMAND")
    if not os.path.isdir(os.path.join(CHECKOUT, directory)):
        usage(f"--dir {directory}: no such directory in {CHECKOUT}")
    return named, directory, remote_only, trees, os_choice, argv


def main(argv):
    named, directory, remote_only, trees, os_choice, argv = parse(argv)
    stop_on_signals()
    if not os.path.exists(os.path.join(SHARE, "farm.py")):
        here(argv, directory, "the farm is not installed (scripts/build/farm/setup)", remote_only)
    sys.path.insert(0, SHARE)
    global farm, mirror, guest
    import farm
    import mirror
    import guest
    try:
        tree = int(open(os.path.join(CHECKOUT, "scripts/build/farm/farm.py")).read().split("\nVERSION = ", 1)[1].split()[0])
    except (OSError, IndexError, ValueError):
        tree = 0
    if tree > farm.VERSION:
        say(f"this checkout's farm (version {tree}) is newer than the installed one ({farm.VERSION}): "
            "scripts/build/farm/setup installs it; running the installed one")

    started = time.time()
    if os_choice is None and named and farm.host_os(farm.entry(named)) == "windows":
        os_choice = "windows"
    if os_choice is None:
        os_choice = "macos" if needs_macos(argv, trees) else "any"
    oses = ("macos", "linux") if os_choice == "any" else (os_choice,)
    roots = [[CHECKOUT, "checkout"]] + [[t, "tree"] for t in trees]
    host, slot, use, why = choose(named, oses, roots)
    if host is None:
        here(argv, directory, why, remote_only)
    name = host["name"]
    linux = farm.host_os(host) == "linux"
    windows = farm.host_os(host) == "windows"
    kind = " (Linux: a Linux build and run)" if linux else " (Windows: a Windows build and run)" if windows else ""
    short = farm.health(host).get("short")
    if short:
        say(f"{name}: {short}")
    if use.sends:
        reply = mirror.compile({"host": name, "since": started, "roots": roots, "files": [], "verify": True,
                                "run": {"cwd": "/", "argv": ["true"], "dirs": [], "outputs": [], "depinfo": None, "env": {}}})
        if reply is None or reply.get("code") != 0:
            use.release()
            slot.release()
            here(argv, directory, f"the checkout could not be sent to {name}: {(reply or {}).get('why') or 'no mirror daemon'}", remote_only)
        use.sent()
        t = reply.get("times", {})
        say(f"{name}{kind}: checkout sent ({t.get('files')} files, {t.get('sync')} s)")
    else:
        say(f"{name}{kind}: nothing sent: this checkout's copy there is "
            "this very tree, and another command of it runs from it")

    # The farm's wrapper is this machine's; the host's cargo builds as it would alone, in a target
    # directory of its own (farm-agent's `exec`).
    job = {"cwd": os.path.join(CHECKOUT, directory), "argv": argv, "map": [CHECKOUT] + [t for t in trees if not t.startswith(CHECKOUT + os.sep)],
           "env": {"RUSTC_WRAPPER": ""}, "target": farm.key(CHECKOUT), "nice": host.get("nice", 10),
           "nofile": resource.getrlimit(resource.RLIMIT_NOFILE)[0],
           "min_free_gb": farm.config().get("min_free_gb", 40),
           "max_target_gb": host.get("max_target_gb", farm.config()["max_target_gb"])}
    if windows:
        job["windows"] = True
    remote = farm.agent_exec(job)
    proc = subprocess.Popen(farm.ssh(name, remote, "test"), stdin=subprocess.PIPE)
    try:
        code = proc.wait()
    except KeyboardInterrupt:
        say(f"stopping it on {name}")
        proc.stdin.close()
        try:
            code = proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            code = 130
        sys.exit(code)
    say(f"{name}: exit {code} after {time.time() - started:.0f} s")
    if code == 255:
        farm.mark_down(name, "lost during a test run")
        use.release()
        slot.release()
        here(argv, directory, f"the connection to {name} was lost", remote_only)
    sys.exit(code)


if __name__ == "__main__":
    main(sys.argv[1:])
