#!/usr/bin/python3
"""Runs a build or test command on another machine of the build farm, in this checkout's copy there;
here when none is usable (docs/final-shape/notes/t37, §2; scripts/build/farm/README.md).

    scripts/dev/test-remote [--host NAME] [--os macos|linux|windows|any] [--arch arm64|x86_64] [--memory GB] [--cpu-feature F]... [--dir native] [--remote-only] [--tree DIR]... [--fetch PATH]... -- COMMAND...

e.g. `scripts/dev/test-remote -- cargo nextest run --lib --profile gate` for the full suite,
`scripts/dev/test-remote -- cargo nextest run --lib -E 'test(/some::filter/)'`, or
`scripts/dev/test-remote --fetch debug/rerail-engine -- cargo build --bin rerail-engine --features test-hooks`
for the CLI, built on a Mac host and brought back to this checkout's `target/debug/`.

The host is a usable one (`scripts/build/farm/status`: reachable, on its link, with disk to spare)
with a free test slot (a third of its cores, or `test_slots` in the configuration), the one with the
most of its slots free first, then the most cores to spare, a Linux host as much as a Mac, a fast
link before a slow one and a VM on this Mac last (`tier`); with none
free, whichever slot frees first on any of them. COMMAND gets its share of the host
(`farm.cpu_share`: twice its cores over its slots) as CARGO_BUILD_JOBS, NEXTEST_TEST_THREADS and
RUST_TEST_THREADS, unless they are set here.

`--fetch PATH` (repeatable) brings PATH of the host's target directory back into this checkout's
`target/` once COMMAND exits 0, executable: a program built there to run here. It keeps COMMAND on a
Mac. When COMMAND runs here instead, it builds into `target/` itself.
What changed of this checkout is sent through the farm's mirror into the host's farm root, after
the host is asked again what it holds (it may have been cleaned). COMMAND runs there at `nice -n
10`, from the checkout's `native/` (or `--dir`), with this machine's open-file limit, and builds in
a target directory of its own on the host (one per checkout, kept warm, removed after 14 unused
days or when the host's disk runs short), never the checkout's `target/`. Its output is printed
here.

With no usable host, or when the host is lost during the run (asleep, off the network: ssh exits
255), COMMAND runs here instead, at `nice -n 19`; `--remote-only` exits 69 instead. The exit
status is COMMAND's. Ctrl-C, a kill or a closed terminal stops it on the host too.

A host may be a Linux machine (`"os": "linux"` in the configuration): COMMAND there is a Linux
build and run, as CI's. It takes any command that does not need macOS: one naming Metal
(`metal-tests`, `rerail-device-metal`), sending a `--tree` (a program built here is a macOS one) or
fetching a program (`--fetch`). `--os linux` sends it to a Linux host
only, `--os any` lets any host take it, `--os macos` keeps it off Linux.

`--arch arm64` or `--arch x86_64` takes only hosts of that CPU, and `--memory GB` only hosts whose
command gets at least that much memory (a VM's own, not its machine's). Both are as each host's
health probe last found them (`status` shows them); a host never probed (a guest not yet started)
is left out unless its configuration says (`arch`, `memory_gb`). Without a usable one, COMMAND runs
here only if this Mac fits too. `--cpu-feature F` (repeatable, or `F,G`) takes only hosts whose CPU
has F, in the farm's names (`scripts/build/farm/features`: `sve2`, `sme2`, `i8mm`, `avx2`, ...).
COMMAND is told its machine's CPU, there or here: RERAIL_FARM_CPU_MODEL, RERAIL_FARM_CPU_FEATURES
(space-separated), RERAIL_FARM_SVE_BITS and RERAIL_FARM_SME_BITS (0: none).

A Windows host (`"os": "windows"`: a Windows PC's or VM's Windows side, through its WSL) takes a
command only with `--os windows` (or `--host`): COMMAND runs there as a Windows build (Windows'
cargo and MSVC, at a low priority; a leading `nice -n N` sets it), in a copy of the checkout on
its drive. One machine's Linux and Windows sides share its test slots: what is queued decides how
many of each run.

`--tree DIR` also sends DIR whole (untracked files too, at the same path under the host's farm
root): a run's inputs and a program built here, e.g. `--tree tmp/bench --tree tmp/engines` for a
benchmark run on the host.

The pack test data pulled here (`npm run fixtures:pull`: the ignored files under
`packs/<pack>/upstream/<tool>/`, none of it in git) is sent too, as trees: the tests that read it
fail without it, on the host as here. The first run sends it (about 13 MB), later ones what changed.

It runs the installed farm (`~/.local/share/rerail-farm`, `scripts/build/farm/setup`), the one every
worktree's compiles use, whatever version this checkout has.
"""
import concurrent.futures
import os
import resource
import json
import shlex
import signal
import subprocess
import sys
import time

# The checkout's: the installed copy of this script runs for every checkout (the farm hands a
# checkout's own copy to it), told which.
CHECKOUT = os.environ.get("RERAIL_FARM_CHECKOUT") or os.path.realpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "../.."))
SHARE = os.path.expanduser("~/.local/share/rerail-farm")
USAGE = __doc__.split("\n\n")[1]

UNAVAILABLE = 69



def say(message):
    print(f"test-remote: {message}", file=sys.stderr, flush=True)


def stop_on_signals():
    def stop(signum, frame):
        raise KeyboardInterrupt
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, stop)


# What COMMAND needs of a machine (`Need`), set once parsed: here() runs it only if this Mac fits.
NEED = None


def here(argv, directory, why, remote_only):
    if remote_only:
        say(f"{why}; --remote-only: not run")
        sys.exit(UNAVAILABLE)
    if NEED is not None and NEED.here():
        say(f"{why}; {NEED.here()}: not run")
        sys.exit(UNAVAILABLE)
    say(f"{why}: running it here, at nice 19")
    cpu = farm.cpu_env(farm.local_cpu()) if "farm" in globals() else {}
    proc = subprocess.Popen(["nice", "-n", "19"] + argv, cwd=os.path.join(CHECKOUT, directory),
                            env=dict(os.environ, RERAIL_FARM_TESTS_HERE="1", **cpu))
    try:
        sys.exit(proc.wait())
    except KeyboardInterrupt:
        proc.terminate()
        sys.exit(proc.wait())


def needs_macos(argv, trees):
    """Whether COMMAND must run on a Mac: it names Metal, or runs what `--tree` sends."""
    return bool(trees) or "metal" in " ".join(argv).lower()


class Need:
    """What COMMAND needs of a host: one of `oses`, the CPU `arch` (None: any) and at least
    `memory_gb` (None: any)."""

    def __init__(self, oses, arch=None, memory_gb=None, features=()):
        self.oses, self.arch, self.memory_gb, self.features = oses, arch, memory_gb, list(features)

    def lacks(self, cpu):
        """Why a CPU record (`farm.host_cpu`) lacks what `--cpu-feature` asks, or None."""
        if not self.features:
            return None
        if not cpu.get("features"):
            return "its CPU features not yet known (--cpu-feature)"
        missing = [f for f in self.features if f not in cpu["features"]]
        return f"its CPU has no {', '.join(missing)} (--cpu-feature)" if missing else None

    def why_not(self, host):
        """Why `host` cannot take COMMAND, or None."""
        if farm.host_os(host) not in self.oses:
            return f"a {farm.host_os(host)} host, and this command runs on {' or '.join(self.oses)} (--os)"
        if self.arch and farm.host_arch(host) != self.arch:
            return f"{farm.host_arch(host) or 'of a CPU not yet known'}, not {self.arch} (--arch)"
        if self.memory_gb and (farm.host_memory_gb(host) or 0) < self.memory_gb:
            have = farm.host_memory_gb(host)
            return f"{have} GB of memory, under {self.memory_gb} (--memory)" if have else f"its memory not yet known (--memory {self.memory_gb})"
        return self.lacks(farm.host_cpu(host))

    def fits(self, host):
        return self.why_not(host) is None

    def here(self):
        """Why this Mac cannot take COMMAND, or None."""
        # (Its system is not checked, as before: with no host of it, COMMAND runs here all the same.)
        arch = farm.ARCHES.get(os.uname().machine, os.uname().machine)
        if self.arch and arch != self.arch:
            return f"this Mac is {arch}, not {self.arch} (--arch)"
        memory = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") >> 30
        if self.memory_gb and memory < self.memory_gb:
            return f"this Mac has {memory} GB of memory, under {self.memory_gb} (--memory)"
        lacks = self.lacks(farm.local_cpu())
        return lacks and "this Mac: " + lacks


def stopped_guests(need):
    """The guests (guest.py) that fit `need`, take test commands and are stopped now: each one
    machine, so a Windows host and its Linux side (`shares`) count once, the one that fits."""
    out, seen = [], set()
    for h in farm.hosts():
        if not h.get("enabled", True) or not h.get("tests", True) or h.get("by_name") or not need.fits(h):
            continue
        base = farm.shared_base(h)
        if base.get("guest") and base["name"] not in seen and farm.health(h).get("guest") == "stopped":
            seen.add(base["name"])
            out.append(h)
    return out


# A link this slow costs minutes a send (a remote site's tunnel, about 4 MB/s); the LAN's hosts,
# reached over this Mac's Wi-Fi or a 100 Mbit hop at 10-40 MB/s, send a checkout's changes in
# seconds, and count as fast.
FAST_MBPS = 8


def tier(host):
    """Where `host` stands before its free slots and cores count: 0, a link of FAST_MBPS or more
    through ssh (the health probe's measure) to another machine; 1, a slower one; 2, a VM on this
    Mac (a command there loads the machine it was meant to spare)."""
    base = farm.shared_base(host)
    if (base.get("guest") or {}).get("on") == "local":
        return 2
    # The best of the last hour's measurements (`mbps_best`), not the last one: load only lowers it.
    h = farm.health(host)
    return 0 if (h.get("mbps_best") or h.get("mbps") or 0) >= FAST_MBPS else 1


def wait_for_guest(host):
    """`host`'s health once its guest is up, or once its start failed (at most START_SECONDS and a minute)."""
    deadline = time.time() + guest.START_SECONDS + 60
    while time.time() < deadline:
        h = farm.health(host)
        if h.get("ok") or h.get("guest") in ("stopped", "unknown"):  # unknown: its provider did not answer
            return h
        time.sleep(3)
    return farm.health(host)


def choose(named, need, roots):
    """A usable host that fits `need`, its test slot and this checkout's copy there (`farm.CopyUse`
    of the tree `roots` hold), each held until exit; or (None, None, None, why)."""
    if named:
        host = next((h for h in farm.hosts() if h["name"] == named), None)
        if host is None:
            return None, None, None, f"{named} is not in the farm's configuration"
        if need.why_not(host):
            return None, None, None, f"{named} does not fit: {need.why_not(host)}"
        h = farm.health(host, fresh=True)
        if not h.get("ok") and h.get("guest") in ("stopped", "starting", "unknown") and guest.request_start(host):
            base = guest.spec(host)[0]
            what = "its guest " + base["name"] if base["name"] != named else "the guest"
            if farm.host_os(host) == "windows" and base["name"] != named:
                what = f"{base['name']}, its WSL (which runs its Windows jobs)"
            if guest.is_cloud(base["guest"]):
                b = guest.budget()
                what += (f", a cloud VM at US${base['guest'].get('cost_per_hour', '?')}/h (today US${b['day']} of US${b['day_limit']};"
                         f" it stops when idle {base['guest'].get('idle_minutes', guest.IDLE_MINUTES)} min, and by {guest.cloud_limits()['max_hours']} h)")
            say(f"{named}: starting {what} (guest.py; up to {guest.START_SECONDS // 60} min)")
            h = wait_for_guest(host)
        if not h.get("ok"):
            return None, None, None, f"{named} is not usable: {h.get('why')}"
        candidates = [host]
    else:
        candidates = [h for h in farm.usable("tests") if need.fits(h)]
        if not candidates:
            # Every host is backed off: asked again now, together (a few seconds), before the command
            # runs here. A back-off is a guess about a host, and running here on a wrong one costs more.
            hosts = [h for h in farm.hosts() if h.get("enabled", True) and h.get("tests", True) and need.fits(h)]
            with concurrent.futures.ThreadPoolExecutor(max(len(hosts), 1)) as pool:
                list(pool.map(lambda h: farm.health(h, fresh=True), hosts))
            candidates = [h for h in farm.usable("tests") if need.fits(h)]
        if not candidates and stopped_guests(need):
            # No running host of these: a guest that can be one is started, and the command waits
            # for it (below), as for a slot.
            pass
        elif not candidates:
            reasons = [f"{h['name']}: {need.why_not(h) or farm.health(h).get('why')}" for h in farm.hosts()
                       if h.get("enabled", True) and h.get("tests", True)]
            return None, None, None, "no usable host" + (f" ({'; '.join(reasons)})" if reasons else " (none configured)")
    # Its place in the line (farm.SlotQueue): a slot goes to the earliest command that would take it.
    queue = farm.SlotQueue(farm.shared_base(h)["name"] for h in candidates if farm.health(h).get("ok"))
    try:
        return wait_for_slot(named, need, roots, candidates, queue)
    finally:
        queue.leave()


def wait_for_slot(named, need, roots, candidates, queue):
    said = False
    deferred = set()
    other_tree = []
    starting = []
    while True:
        # A guest started for this command (below) that is up now is a candidate too.
        for g in starting:
            if g not in candidates and farm.health(g).get("ok"):
                candidates.append(g)
        if starting and not any(farm.health(g).get("guest") == "starting" or farm.health(g).get("ok") for g in starting) \
                and not any(farm.health(h).get("ok") for h in candidates):
            return None, None, None, "no usable host, and the guests started for it did not come up (" + \
                "; ".join(f"{g['name']}: {farm.health(g).get('why')}" for g in starting) + ")"
        # The host with the most of its test slots free, then the most cores to spare; any slot that
        # frees on any host is taken, not only the first host's.
        free = []
        tree = mirror.fingerprint(roots)
        # The machines it would take now: the usable ones, but not one where this checkout's copy ran
        # another command from other files at the last look (that slot is for a command behind it).
        queue.update(farm.shared_base(h)["name"] for h in candidates
                     if farm.health(h).get("ok") and h["name"] not in other_tree)
        ahead = queue.counts()
        other_tree = []
        for host in candidates:
            # Asked again while waiting: a host that started a fleet job meanwhile takes nothing more.
            if not farm.health(host).get("ok"):
                continue
            paths = farm.test_slot_paths(host["name"], host)
            got = None
            idle = 0
            for path in paths:
                lock = farm.Lock(path, blocking=False)
                if lock.held:
                    idle += 1
                    if got is None:
                        got = lock
                        continue
                lock.release()
            machine = farm.shared_base(host)["name"]
            earlier = ahead.get(machine, 0) + ahead.get("*", 0)
            if got and earlier >= idle:
                # Its free slots are for the commands that came first and would take them.
                got.release()
                got = None
                if machine not in deferred:
                    deferred.add(machine)
                    say(f"{host['name']} has {idle} free test slot{'s' if idle > 1 else ''}, "
                        f"and {earlier} earlier command{'s' if earlier > 1 else ''} wait{'' if earlier > 1 else 's'} for it: they go first")
            if got:
                # This checkout's copy there: idle, or running from this very tree; else another
                # command of this checkout runs there from other files, which this one would change.
                # (a Windows host's copy is its machine's Linux one: `shared_base`)
                use = farm.CopyUse(farm.shared_base(host)["name"], CHECKOUT, tree)
                if not use.held:
                    other_tree.append(host["name"])
                    got.release()
                    continue
                # This checkout's commands on one host share its target directory there, and cargo
                # builds for them one at a time: a host where none runs goes first.
                # (a host short of disk last: it keeps only its recently used targets, and drops
                # even those under its floor)
                free.append((bool(farm.health(host).get("short")), tier(host), not use.sends,
                             -idle / len(paths), -farm.spare(host), host, got, use))
        if free:
            # Any OS the command allows, a Linux host as much as a Mac: a fast link first (`tier`),
            # then the most of its slots free, then the most cores to spare. (Macs first had left
            # the Linux hosts idle while two Macs ran loads of 44 and 88, 2026-11-20.)
            free.sort(key=lambda f: f[:5])
            for f in free[1:]:
                f[6].release()
                f[7].release()
            best = free[0]
            best[6].used()
            return best[5], best[6], best[7], None
        if not starting and not named:
            # It would wait: the stopped guests that can take it are started (guest.py), and it
            # takes the first slot that frees, a running host's or a guest's once it is up. A
            # named host (`--host`) waits for its own slot: another guest started would take it.
            # One a command: another machine's before this Mac's (where the edit loop runs), then the
            # most cores; a second command that would wait starts the next.
            order = sorted(stopped_guests(need), key=lambda g: (farm.shared_base(g)["guest"]["on"] == "local", -g.get("cores", 0)))
            starting = next(([g] for g in order if guest.request_start(g)), [])
            if starting:
                say("starting " + ", ".join(f"{g['name']} (a guest on {guest.placement(farm.shared_base(g)['guest']) or farm.shared_base(g)['guest']['on']})" for g in starting)
                    + f": it takes the command once it is up, unless a slot frees first (up to {guest.START_SECONDS // 60} min)")
        if not said and candidates:
            say("every test slot of every usable host is taken"
                + (f", or this checkout's copy there runs another command from other files ({', '.join(other_tree)})" if other_tree else "")
                + ": waiting for the first that frees (" + ", ".join(f"{h['name']} {farm.test_slots(h)}" for h in candidates) + ")")
            said = True
        time.sleep(2)


def usage(why):
    sys.exit(f"test-remote: {why}\nusage:{USAGE}\n(scripts/dev/test-remote --help for more)")


def parse(argv):
    """The options and COMMAND, checked before anything is sent: an unknown option or a missing
    COMMAND is refused here, never run on a host."""
    named, directory, remote_only, trees, os_choice, fetches = None, "native", False, [], None, []
    arch, memory_gb, features = None, None, []
    while argv and argv[0] != "--":
        a = argv[0]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if a == "--remote-only":
            remote_only, argv = True, argv[1:]
        elif a == "--tree":
            if len(argv) < 2 or not os.path.isdir(argv[1]):
                usage("--tree needs a directory")
            trees.append(os.path.realpath(argv[1]))
            argv = argv[2:]
        elif a == "--fetch":
            # A path in the target directory (`debug/rerail-engine`), brought back to this
            # checkout's target/ once COMMAND exits 0.
            if len(argv) < 2 or argv[1].startswith("-") or argv[1].startswith("/") or ".." in argv[1].split("/"):
                usage("--fetch takes a path inside the target directory, e.g. debug/rerail-engine")
            fetches.append(argv[1].removeprefix("target/"))
            argv = argv[2:]
        elif a == "--os":
            if len(argv) < 2 or argv[1] not in ("macos", "linux", "windows", "any"):
                usage("--os takes macos, linux, windows or any")
            os_choice, argv = argv[1], argv[2:]
        elif a == "--arch":
            if len(argv) < 2 or argv[1] not in ("arm64", "aarch64", "x86_64", "amd64"):
                usage("--arch takes arm64 or x86_64")
            arch, argv = {"aarch64": "arm64", "amd64": "x86_64"}.get(argv[1], argv[1]), argv[2:]
        elif a == "--cpu-feature":
            if len(argv) < 2 or argv[1].startswith("-"):
                usage("--cpu-feature takes a feature's name (scripts/build/farm/features lists them)")
            features += [f.lower() for f in argv[1].split(",") if f]
            argv = argv[2:]
        elif a == "--memory":
            if len(argv) < 2 or not argv[1].isdigit():
                usage("--memory takes a whole number of GB")
            memory_gb, argv = int(argv[1]), argv[2:]
        elif a in ("--host", "--dir"):
            if len(argv) < 2 or argv[1].startswith("-"):
                usage(f"{a} needs a value")
            if a == "--host":
                named = argv[1]
            else:
                directory = argv[1]
            argv = argv[2:]
        elif a.startswith("-"):
            usage(f"unknown option {a}")
        else:
            usage(f"COMMAND goes after --: {a}")
    argv = argv[1:]
    if not argv:
        usage("no COMMAND")
    if not os.path.isdir(os.path.join(CHECKOUT, directory)):
        usage(f"--dir {directory}: no such directory in {CHECKOUT}")
    if fetches and os_choice not in (None, "macos"):
        usage("--fetch brings back a program for this Mac: it runs on a Mac (no --os)")
    return named, directory, remote_only, trees, os_choice, fetches, arch, memory_gb, features, argv


def fetch(host, paths):
    """Each of `paths` (in the command's target directory on `host`) into this checkout's target/,
    executable, written beside and renamed into place: a failed copy leaves the old file. None, or why
    one failed."""
    for rel in paths:
        dest = os.path.join(CHECKOUT, "target", rel)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        part = dest + ".fetching"
        with open(part, "wb") as out:
            r = subprocess.run(farm.ssh(host["name"], farm.on_host("farm-agent") + " fetch " + shlex.quote(farm.key(CHECKOUT)) + " " + shlex.quote(rel), "test"),
                               stdout=out, stderr=subprocess.PIPE, text=False, timeout=600)
        if r.returncode != 0:
            os.remove(part)
            return f"{rel}: {r.stderr.decode(errors='replace').strip()[-300:] or 'exit ' + str(r.returncode)}"
        os.chmod(part, 0o755)
        os.replace(part, dest)
        say(f"fetched {os.path.relpath(dest, CHECKOUT)} ({os.path.getsize(dest) / 1e6:.1f} MB)")
    return None


def pack_data():
    """The tool directories of the packs (`packs/<pack>/upstream/<tool>/`) that hold pulled test data:
    files git ignores there. Tracked files in them go as the checkout's too, the same bytes."""
    out = subprocess.run(["git", "-C", CHECKOUT, "ls-files", "--others", "--ignored", "--exclude-standard", "--directory", "--", "packs"],
                         capture_output=True, text=True)
    dirs = set()
    for name in out.stdout.splitlines():
        parts = name.split("/")
        if len(parts) >= 5 and parts[0] == "packs" and parts[2] == "upstream":
            dirs.add(os.path.join(CHECKOUT, *parts[:4]))
    return sorted(d for d in dirs if os.path.isdir(d))


def main(argv):
    named, directory, remote_only, trees, os_choice, fetches, arch, memory_gb, features, argv = parse(argv)
    trees += [t for t in pack_data() if t not in trees]
    stop_on_signals()
    if not os.path.exists(os.path.join(SHARE, "farm.py")):
        here(argv, directory, "the farm is not installed (scripts/build/farm/setup)", remote_only)
    sys.path.insert(0, SHARE)
    global farm, mirror, guest
    import farm
    import mirror
    import guest
    try:
        tree = int(open(os.path.join(CHECKOUT, "scripts/build/farm/farm.py")).read().split("\nVERSION = ", 1)[1].split()[0])
    except (OSError, IndexError, ValueError):
        tree = 0
    if tree > farm.VERSION:
        say(f"this checkout's farm (version {tree}) is newer than the installed one ({farm.VERSION}): "
            "scripts/build/farm/setup installs it; running the installed one")

    started = time.time()
    if os_choice is None and named and farm.host_os(farm.entry(named)) == "windows":
        os_choice = "windows"
    if os_choice is None:
        os_choice = "macos" if needs_macos(argv, trees) or fetches else "any"
    need = Need(("macos", "linux") if os_choice == "any" else (os_choice,), arch, memory_gb, features)
    roots = [[CHECKOUT, "checkout"]] + [[t, "tree"] for t in trees]
    global NEED
    NEED = need
    host, slot, use, why = choose(named, need, roots)
    if host is None:
        here(argv, directory, why, remote_only)
    name = host["name"]
    linux = farm.host_os(host) == "linux"
    windows = farm.host_os(host) == "windows"
    kind = " (Linux: a Linux build and run)" if linux else " (Windows: a Windows build and run)" if windows else ""
    short = farm.health(host).get("short")
    if short:
        say(f"{name}: {short}")
    if use.sends:
        reply = mirror.compile({"host": name, "since": started, "roots": roots, "files": [], "verify": True,
                                "run": {"cwd": "/", "argv": ["true"], "dirs": [], "outputs": [], "depinfo": None, "env": {}}})
        if reply is None or reply.get("code") != 0:
            use.release()
            slot.release()
            here(argv, directory, f"the checkout could not be sent to {name}: {(reply or {}).get('why') or 'no mirror daemon'}", remote_only)
        use.sent()
        t = reply.get("times", {})
        say(f"{name}{kind}: checkout sent ({t.get('files')} files, {t.get('sync')} s)")
    else:
        say(f"{name}{kind}: nothing sent: this checkout's copy there is "
            "this very tree, and another command of it runs from it")

    # The farm's wrapper is this machine's; the host's cargo builds as it would alone, in a target
    # directory of its own (farm-agent's `exec`).
    # Its share of the host (farm.cpu_share), unless the caller set one.
    share = str(farm.cpu_share(host))
    env = {"RUSTC_WRAPPER": "", **farm.cpu_env(farm.host_cpu(host))}
    for k in ("CARGO_BUILD_JOBS", "NEXTEST_TEST_THREADS", "RUST_TEST_THREADS"):
        env[k] = os.environ.get(k) or share
    job = {"cwd": os.path.join(CHECKOUT, directory), "argv": argv, "map": [CHECKOUT] + [t for t in trees if not t.startswith(CHECKOUT + os.sep)],
           "env": env, "target": farm.key(CHECKOUT), "nice": host.get("nice", 10),
           "nofile": resource.getrlimit(resource.RLIMIT_NOFILE)[0],
           "min_free_gb": farm.config().get("min_free_gb", 40),
           "max_target_gb": host.get("max_target_gb", farm.config()["max_target_gb"])}
    if windows:
        job["windows"] = True
    remote = farm.agent_exec(job)
    proc = subprocess.Popen(farm.ssh(name, remote, "test"), stdin=subprocess.PIPE)
    try:
        code = proc.wait()
    except KeyboardInterrupt:
        say(f"stopping it on {name}")
        proc.stdin.close()
        try:
            code = proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            code = 130
        sys.exit(code)
    say(f"{name}: exit {code} after {time.time() - started:.0f} s")
    if code == 255:
        farm.mark_down(name, "lost during a test run")
        use.release()
        slot.release()
        if not os.environ.get("RERAIL_TEST_REMOTE_RETRIED"):
            # Once more through the farm, not here: this Mac is the busiest machine in it, and the
            # lost host is asked again first (`mark_down`), so another takes the command if it is gone.
            say(f"the connection to {name} was lost: choosing a host again")
            os.environ["RERAIL_TEST_REMOTE_RETRIED"] = "1"
            os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)] + ORIGINAL_ARGS)
        here(argv, directory, f"the connection to {name} was lost again", remote_only)
    if code == 0 and fetches:
        why = fetch(host, fetches)
        if why:
            say(f"could not fetch from {name}: {why}")
            sys.exit(1)
    sys.exit(code)


if __name__ == "__main__":
    ORIGINAL_ARGS = sys.argv[1:]  # (as given: a lost connection reruns them, `main`)
    main(sys.argv[1:])
