{
  "format": "rerail.policy/v1",
  "id": "tslint:strict-type-predicates",
  "revision": 1,
  "description": "Warns for type predicates that are always true or always false. APPROXIMATION: only operands that are literals (whose type is known from syntax) are checked; everything else needs the type checker.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "typeof-literal",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "binary_expression"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "regex": "^(==|!=|===|!==)$"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "kind": "unary_expression"
                    },
                    {
                      "regex": "^typeof\\b"
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "kind": "string"
                          },
                          {
                            "kind": "number"
                          },
                          {
                            "kind": "true"
                          },
                          {
                            "kind": "false"
                          },
                          {
                            "kind": "array"
                          },
                          {
                            "kind": "object"
                          },
                          {
                            "kind": "template_string"
                          },
                          {
                            "kind": "arrow_function"
                          },
                          {
                            "kind": "function_expression"
                          },
                          {
                            "kind": "regex"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "STRICT_TYPE_PREDICATES",
        "severity": "error",
        "message": "Expression is always true or always false."
      }
    },
    {
      "id": "literal-null-check",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "binary_expression"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "regex": "^(==|!=|===|!==)$"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "null"
                    },
                    {
                      "kind": "undefined"
                    }
                  ]
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "string"
                    },
                    {
                      "kind": "number"
                    },
                    {
                      "kind": "true"
                    },
                    {
                      "kind": "false"
                    },
                    {
                      "kind": "array"
                    },
                    {
                      "kind": "object"
                    },
                    {
                      "kind": "template_string"
                    },
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "regex"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "STRICT_TYPE_PREDICATES",
        "severity": "error",
        "message": "Expression is always true or always false."
      }
    }
  ]
}