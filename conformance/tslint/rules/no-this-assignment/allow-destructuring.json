{
  "format": "rerail.policy/v1",
  "id": "tslint:no-this-assignment",
  "revision": 1,
  "mode": "steer",
  "description": "no-this-assignment with allow-destructuring.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "this-assignment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "variable_declarator"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "this"
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "object_pattern"
                      },
                      {
                        "kind": "array_pattern"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_THIS_ASSIGNMENT",
        "message": "Assigning `this` reference to local variable not allowed."
      }
    }
  ]
}
