{
  "format": "rerail.policy/v1",
  "id": "tslint:no-submodule-imports",
  "revision": 1,
  "mode": "steer",
  "description": "no-submodule-imports with whitelist @angular/core, rxjs, @angular/platform-browser/animations.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "submodule-import",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string"
              },
              {
                "regex": "^[\"'](?:@[^/\"']+/[^/\"']+|[^./@\"'][^/\"']*)/"
              },
              {
                "any": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "import_statement"
                        },
                        {
                          "kind": "export_statement"
                        },
                        {
                          "kind": "import_require_clause"
                        }
                      ]
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "arguments",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "call_expression",
                        "any": [
                          {
                            "pattern": "import($$$A)"
                          },
                          {
                            "pattern": "require($$$A)"
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "not": {
                  "regex": "^[\"'](?:@angular/core|rxjs|@angular/platform\\-browser/animations)(?:/|[\"'])"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_SUBMODULE_IMPORTS",
        "message": "Submodule import paths from this package are disallowed; import from the root instead"
      }
    }
  ]
}
