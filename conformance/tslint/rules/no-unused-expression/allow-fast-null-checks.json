{
  "format": "rerail.policy/v1",
  "id": "tslint:no-unused-expression",
  "revision": 1,
  "mode": "steer",
  "description": "Disallows expression statements (and comma/void/ternary operands) whose value is discarded unless they are calls, assignments, increments, delete, await or yield. TSLint's checking walk is modelled with recursive utils: `checked-*` is where the walk evaluates a node in checking mode, `unused-*` what it returns there, strict/lax being allowFastNullChecks off/on. Options: allow-fast-null-checks",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unused-expression",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "expression_statement",
                "not": {
                  "matches": "directive"
                },
                "has": {
                  "matches": "operand",
                  "all": [
                    {
                      "matches": "unused-lax"
                    }
                  ]
                }
              },
              {
                "matches": "operand",
                "not": {
                  "matches": "zero"
                },
                "inside": {
                  "kind": "unary_expression",
                  "regex": "^void\\b",
                  "not": {
                    "matches": "checked"
                  }
                },
                "all": [
                  {
                    "inside": {
                      "kind": "unary_expression"
                    }
                  },
                  {
                    "matches": "unused-lax"
                  }
                ]
              },
              {
                "matches": "operand",
                "precedes": {
                  "regex": "^,$"
                },
                "inside": {
                  "kind": "sequence_expression",
                  "all": [
                    {
                      "not": {
                        "matches": "indirect-eval"
                      }
                    },
                    {
                      "not": {
                        "matches": "checked"
                      }
                    }
                  ]
                },
                "all": [
                  {
                    "precedes": {
                      "regex": "^,$"
                    }
                  },
                  {
                    "matches": "unused-lax"
                  }
                ],
                "any": [
                  {
                    "not": {
                      "follows": {
                        "stopBy": "end",
                        "matches": "operand"
                      }
                    }
                  },
                  {
                    "follows": {
                      "stopBy": "end",
                      "matches": "operand",
                      "not": {
                        "matches": "unused-lax"
                      }
                    }
                  }
                ]
              },
              {
                "matches": "operand",
                "all": [
                  {
                    "inside": {
                      "kind": "ternary_expression"
                    }
                  },
                  {
                    "matches": "unused-lax"
                  }
                ],
                "any": [
                  {
                    "follows": {
                      "regex": "^\\?$"
                    },
                    "inside": {
                      "kind": "ternary_expression",
                      "matches": "checked-lax",
                      "has": {
                        "follows": {
                          "regex": "^:$"
                        },
                        "not": {
                          "matches": "unused-lax"
                        }
                      }
                    }
                  },
                  {
                    "follows": {
                      "regex": "^:$"
                    },
                    "inside": {
                      "kind": "ternary_expression",
                      "matches": "checked-lax",
                      "has": {
                        "follows": {
                          "regex": "^\\?$"
                        },
                        "not": {
                          "matches": "unused-lax"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "matches": "operand",
                "inside": {
                  "kind": "sequence_expression",
                  "not": {
                    "matches": "indirect-eval"
                  },
                  "matches": "checked-lax"
                },
                "all": [
                  {
                    "inside": {
                      "kind": "sequence_expression"
                    }
                  },
                  {
                    "matches": "unused-lax"
                  }
                ],
                "any": [
                  {
                    "not": {
                      "follows": {
                        "stopBy": "end",
                        "matches": "operand"
                      }
                    },
                    "precedes": {
                      "stopBy": "end",
                      "matches": "operand",
                      "not": {
                        "matches": "unused-lax"
                      }
                    }
                  },
                  {
                    "follows": {
                      "stopBy": "end",
                      "matches": "operand",
                      "not": {
                        "matches": "unused-lax"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "utils": {
            "operand": {
              "not": {
                "any": [
                  {
                    "regex": "^(?:[(),?:;]|void|&&|\\|\\|)$"
                  },
                  {
                    "kind": "comment"
                  }
                ]
              }
            },
            "zero": {
              "any": [
                {
                  "kind": "number",
                  "regex": "^0$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "kind": "number",
                    "regex": "^0$"
                  }
                }
              ]
            },
            "indirect-eval": {
              "kind": "sequence_expression",
              "regex": "^0\\s*,\\s*eval$",
              "inside": {
                "kind": "parenthesized_expression",
                "inside": {
                  "any": [
                    {
                      "kind": "call_expression"
                    },
                    {
                      "kind": "arguments",
                      "inside": {
                        "kind": "call_expression"
                      }
                    }
                  ]
                }
              }
            },
            "directive": {
              "kind": "expression_statement",
              "has": {
                "kind": "string"
              },
              "inside": {
                "any": [
                  {
                    "kind": "program"
                  },
                  {
                    "kind": "statement_block",
                    "inside": {
                      "any": [
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "generator_function_declaration"
                        },
                        {
                          "kind": "function_expression"
                        },
                        {
                          "kind": "generator_function"
                        },
                        {
                          "kind": "arrow_function"
                        },
                        {
                          "kind": "method_definition"
                        },
                        {
                          "kind": "internal_module"
                        },
                        {
                          "kind": "module"
                        }
                      ]
                    }
                  }
                ]
              },
              "not": {
                "follows": {
                  "stopBy": "end",
                  "not": {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "regex": "^\\{$"
                      },
                      {
                        "kind": "expression_statement",
                        "has": {
                          "kind": "string"
                        }
                      }
                    ]
                  }
                }
              }
            },
            "checked": {
              "any": [
                {
                  "matches": "checked-lax"
                }
              ]
            },
            "checked-lax": {
              "any": [
                {
                  "inside": {
                    "kind": "expression_statement",
                    "not": {
                      "matches": "directive"
                    }
                  }
                },
                {
                  "inside": {
                    "any": [
                      {
                        "kind": "parenthesized_expression"
                      },
                      {
                        "kind": "unary_expression",
                        "regex": "^void\\b"
                      },
                      {
                        "kind": "sequence_expression",
                        "not": {
                          "matches": "indirect-eval"
                        }
                      }
                    ],
                    "matches": "checked-lax"
                  }
                },
                {
                  "follows": {
                    "regex": "^[?:]$"
                  },
                  "inside": {
                    "kind": "ternary_expression",
                    "matches": "checked-lax"
                  }
                },
                {
                  "follows": {
                    "regex": "^(&&|\\|\\|)$"
                  },
                  "inside": {
                    "kind": "binary_expression",
                    "matches": "checked-lax"
                  }
                },
                {
                  "not": {
                    "matches": "zero"
                  },
                  "inside": {
                    "kind": "unary_expression",
                    "regex": "^void\\b",
                    "not": {
                      "matches": "checked"
                    }
                  }
                },
                {
                  "precedes": {
                    "regex": "^,$"
                  },
                  "inside": {
                    "kind": "sequence_expression",
                    "all": [
                      {
                        "not": {
                          "matches": "indirect-eval"
                        }
                      },
                      {
                        "not": {
                          "matches": "checked"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "unused-lax": {
              "any": [
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "operand",
                    "all": [
                      {
                        "matches": "unused-lax"
                      }
                    ]
                  }
                },
                {
                  "kind": "unary_expression",
                  "regex": "^void\\b",
                  "has": {
                    "matches": "operand",
                    "all": [
                      {
                        "matches": "unused-lax"
                      }
                    ]
                  }
                },
                {
                  "kind": "ternary_expression",
                  "all": [
                    {
                      "has": {
                        "follows": {
                          "regex": "^\\?$"
                        },
                        "matches": "unused-lax"
                      }
                    },
                    {
                      "has": {
                        "follows": {
                          "regex": "^:$"
                        },
                        "matches": "unused-lax"
                      }
                    }
                  ]
                },
                {
                  "kind": "sequence_expression",
                  "all": [
                    {
                      "not": {
                        "matches": "indirect-eval"
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "matches": "operand",
                          "not": {
                            "matches": "unused-lax"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "binary_expression",
                  "has": {
                    "regex": "^(&&|\\|\\|)$"
                  },
                  "all": [
                    {
                      "has": {
                        "follows": {
                          "regex": "^(&&|\\|\\|)$"
                        },
                        "matches": "unused-lax"
                      }
                    }
                  ]
                },
                {
                  "matches": "unused-leaf-lax"
                }
              ]
            },
            "unused-leaf-lax": {
              "matches": "operand",
              "not": {
                "any": [
                  {
                    "kind": "parenthesized_expression"
                  },
                  {
                    "kind": "unary_expression",
                    "regex": "^(void|delete)\\b"
                  },
                  {
                    "kind": "ternary_expression"
                  },
                  {
                    "kind": "sequence_expression"
                  },
                  {
                    "kind": "binary_expression",
                    "has": {
                      "regex": "^(&&|\\|\\|)$"
                    }
                  },
                  {
                    "kind": "call_expression",
                    "not": {
                      "has": {
                        "kind": "template_string"
                      }
                    }
                  },
                  {
                    "kind": "yield_expression"
                  },
                  {
                    "kind": "await_expression"
                  },
                  {
                    "kind": "update_expression"
                  },
                  {
                    "kind": "assignment_expression"
                  },
                  {
                    "kind": "augmented_assignment_expression"
                  },
                  {
                    "kind": "internal_module"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_UNUSED_EXPRESSION",
        "message": "unused expression, expected an assignment or function call"
      }
    }
  ]
}
