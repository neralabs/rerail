{
  "format": "rerail.policy/v1",
  "id": "tslint:no-empty",
  "revision": 1,
  "description": "no-empty with allow-empty-catch: empty catch blocks are also allowed.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "empty-block",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "statement_block"
              },
              {
                "regex": "^\\{\\s*\\}$"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "kind": "method_definition"
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "property_identifier",
                          "regex": "^constructor$"
                        }
                      },
                      {
                        "any": [
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "accessibility_modifier",
                              "regex": "^(private|protected)$"
                            }
                          },
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "formal_parameters",
                              "has": {
                                "stopBy": "neighbor",
                                "any": [
                                  {
                                    "kind": "required_parameter"
                                  },
                                  {
                                    "kind": "optional_parameter"
                                  }
                                ],
                                "regex": "^(public|private|protected|readonly)\\b"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "catch_clause"
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_EMPTY",
        "severity": "error",
        "message": "block is empty"
      }
    }
  ]
}