{
  "format": "rerail.policy/v1",
  "id": "tslint:no-floating-promises",
  "revision": 1,
  "description": "Syntactic under-approximation: expression statements that are `x.then()`/`x.then(onFulfilled)` (no rejection handler), `x.finally(...)`, or `new Promise(...)`. Whether an arbitrary call returns a Promise needs the type checker. Anchor is the statement (same start as the expression).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "floating-then",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "expression_statement"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "all": [
                        {
                          "kind": "call_expression"
                        },
                        {
                          "any": [
                            {
                              "pattern": "$O.then()"
                            },
                            {
                              "pattern": "$O.then($A)"
                            },
                            {
                              "pattern": "$O.finally($$$A)"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "kind": "new_expression"
                        },
                        {
                          "any": [
                            {
                              "pattern": "new Promise($$$A)"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_FLOATING_PROMISES",
        "severity": "error",
        "message": "Promises must be handled appropriately"
      }
    }
  ]
}
