{
  "format": "rerail.policy/v1",
  "id": "tslint:switch-final-break",
  "revision": 1,
  "description": "The final clause of a switch must end with `break;` (always). Approximation of endsControlFlow: last statement is break/return/throw/continue.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "missing-final-break",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "all": [
                  {
                    "any": [
                      {
                        "kind": "switch_case"
                      },
                      {
                        "kind": "switch_default"
                      }
                    ]
                  },
                  {
                    "not": {
                      "precedes": {
                        "stopBy": "neighbor",
                        "all": [
                          {
                            "any": [
                              {
                                "kind": "switch_case"
                              },
                              {
                                "kind": "switch_default"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "not": {
                  "any": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "all": [
                          {
                            "any": [
                              {
                                "kind": "break_statement"
                              },
                              {
                                "kind": "return_statement"
                              },
                              {
                                "kind": "throw_statement"
                              },
                              {
                                "kind": "continue_statement"
                              }
                            ]
                          },
                          {
                            "not": {
                              "precedes": {
                                "stopBy": "neighbor",
                                "not": {
                                  "any": [
                                    {
                                      "regex": "^\\}$"
                                    },
                                    {
                                      "kind": "comment"
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        ]
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "statement_block",
                        "has": {
                          "stopBy": "neighbor",
                          "all": [
                            {
                              "any": [
                                {
                                  "kind": "break_statement"
                                },
                                {
                                  "kind": "return_statement"
                                },
                                {
                                  "kind": "throw_statement"
                                },
                                {
                                  "kind": "continue_statement"
                                }
                              ]
                            },
                            {
                              "not": {
                                "precedes": {
                                  "stopBy": "neighbor",
                                  "not": {
                                    "any": [
                                      {
                                        "regex": "^\\}$"
                                      },
                                      {
                                        "kind": "comment"
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "SWITCH_FINAL_BREAK",
        "severity": "error",
        "message": "Final clause in 'switch' statement should end with 'break;'."
      }
    }
  ]
}
