{
  "format": "rerail.policy/v1",
  "id": "tslint:max-classes-per-file",
  "revision": 1,
  "description": "A file may not contain more than 2 classes: flags a class with 2 or more classes before it in document order (ancestors, and classes at or inside earlier siblings of the class or any ancestor); utility after-K holds when a class with K-1 classes before it precedes the node.",
  "scope": {"include": ["**/*"], "exclude": []},
  "checks": [
    {
      "id": "too-many-classes",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {"all": [{"matches": "counted"}, {"matches": "after-2"}]},
          "utils": {
            "class": {
              "any": [{"kind": "class_declaration"}, {"kind": "abstract_class_declaration"}, {"kind": "class"}]
            },
            "counted": {
              "any": [
                {"matches": "class", "not": {"inside": {"kind": "export_statement"}}},
                {"kind": "export_statement", "has": {"matches": "class"}}
              ]
            },
            "at-or-around-1": {"any": [{"matches": "class"}, {"has": {"stopBy": "end", "matches": "class"}}]},
            "after-1": {
              "any": [
                {"inside": {"stopBy": "end", "matches": "class"}},
                {"follows": {"stopBy": "end", "matches": "at-or-around-1"}},
                {"inside": {"stopBy": "end", "follows": {"stopBy": "end", "matches": "at-or-around-1"}}}
              ]
            },
            "class-1": {"all": [{"matches": "class"}, {"matches": "after-1"}]},
            "at-or-around-2": {"any": [{"matches": "class-1"}, {"has": {"stopBy": "end", "matches": "class-1"}}]},
            "after-2": {
              "any": [
                {"inside": {"stopBy": "end", "matches": "class-1"}},
                {"follows": {"stopBy": "end", "matches": "at-or-around-2"}},
                {"inside": {"stopBy": "end", "follows": {"stopBy": "end", "matches": "at-or-around-2"}}}
              ]
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "MAX_CLASSES_PER_FILE",
        "severity": "error",
        "message": "A maximum of 2 classes per file are allowed."
      }
    }
  ]
}
