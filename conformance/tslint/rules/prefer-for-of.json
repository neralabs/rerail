{
  "format": "rerail.policy/v1",
  "id": "tslint:prefer-for-of",
  "revision": 1,
  "mode": "steer",
  "description": "Flags `for (let|var i = 0; i < a.length; i++ / ++i / i += 1 / i = i + 1 / i = 1 + i)` whose body uses i only as a read of `a[i]` (object compared by text, after one level of parentheses): not assigned, updated, deleted or destructured into; uses under a nearer declaration of i (block, loop, function parameter) are someone else's; a `var` index used outside the loop bails.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "indexed-for",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "for_statement"
              },
              {
                "pattern": "$F"
              },
              {
                "any": [
                  {
                    "pattern": "for (let $I = 0; $I < $A.length; $$$INC) $BODY"
                  },
                  {
                    "all": [
                      {
                        "pattern": "for (var $I = 0; $I < $A.length; $$$INC) $BODY"
                      },
                      {
                        "not": {
                          "inside": {
                            "stopBy": "end",
                            "any": [
                              {
                                "any": [
                                  {
                                    "kind": "function_declaration"
                                  },
                                  {
                                    "kind": "function_expression"
                                  },
                                  {
                                    "kind": "arrow_function"
                                  },
                                  {
                                    "kind": "method_definition"
                                  },
                                  {
                                    "kind": "generator_function_declaration"
                                  },
                                  {
                                    "kind": "generator_function"
                                  },
                                  {
                                    "kind": "program"
                                  }
                                ]
                              }
                            ],
                            "has": {
                              "stopBy": "end",
                              "kind": "identifier",
                              "pattern": "$I",
                              "not": {
                                "inside": {
                                  "stopBy": "end",
                                  "pattern": "$F"
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "has": {
                  "any": [
                    {
                      "pattern": "$I++"
                    },
                    {
                      "pattern": "++$I"
                    },
                    {
                      "pattern": "$I += 1"
                    },
                    {
                      "pattern": "$I = $I + 1"
                    },
                    {
                      "pattern": "$I = 1 + $I"
                    }
                  ]
                }
              },
              {
                "not": {
                  "has": {
                    "follows": {
                      "regex": "^\\)$"
                    },
                    "has": {
                      "stopBy": "end",
                      "all": [
                        {
                          "any": [
                            {
                              "kind": "identifier"
                            },
                            {
                              "kind": "shorthand_property_identifier"
                            }
                          ]
                        },
                        {
                          "pattern": "$I"
                        },
                        {
                          "not": {
                            "inside": {
                              "stopBy": "end",
                              "any": [
                                {
                                  "all": [
                                    {
                                      "any": [
                                        {
                                          "kind": "statement_block"
                                        },
                                        {
                                          "kind": "for_statement"
                                        },
                                        {
                                          "kind": "for_in_statement"
                                        },
                                        {
                                          "kind": "function_declaration"
                                        },
                                        {
                                          "kind": "function_expression"
                                        },
                                        {
                                          "kind": "arrow_function"
                                        },
                                        {
                                          "kind": "method_definition"
                                        },
                                        {
                                          "kind": "generator_function_declaration"
                                        },
                                        {
                                          "kind": "generator_function"
                                        }
                                      ]
                                    },
                                    {
                                      "has": {
                                        "any": [
                                          {
                                            "any": [
                                              {
                                                "kind": "lexical_declaration"
                                              },
                                              {
                                                "kind": "variable_declaration"
                                              }
                                            ]
                                          },
                                          {
                                            "kind": "formal_parameters"
                                          }
                                        ],
                                        "has": {
                                          "any": [
                                            {
                                              "any": [
                                                {
                                                  "kind": "variable_declarator"
                                                },
                                                {
                                                  "kind": "required_parameter"
                                                },
                                                {
                                                  "kind": "optional_parameter"
                                                }
                                              ]
                                            }
                                          ],
                                          "has": {
                                            "kind": "identifier",
                                            "pattern": "$I",
                                            "not": {
                                              "follows": {
                                                "regex": "^=$"
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  ]
                                },
                                {
                                  "all": [
                                    {
                                      "kind": "arrow_function"
                                    },
                                    {
                                      "has": {
                                        "kind": "identifier",
                                        "pattern": "$I"
                                      }
                                    }
                                  ]
                                }
                              ],
                              "inside": {
                                "stopBy": "end",
                                "pattern": "$F"
                              }
                            }
                          }
                        },
                        {
                          "not": {
                            "kind": "identifier",
                            "follows": {
                              "regex": "^\\[$"
                            },
                            "inside": {
                              "all": [
                                {
                                  "kind": "subscript_expression"
                                },
                                {
                                  "has": {
                                    "all": [
                                      {
                                        "any": [
                                          {
                                            "pattern": "$A",
                                            "not": {
                                              "kind": "parenthesized_expression"
                                            }
                                          },
                                          {
                                            "kind": "parenthesized_expression",
                                            "has": {
                                              "pattern": "$A"
                                            }
                                          }
                                        ]
                                      },
                                      {
                                        "precedes": {
                                          "regex": "^\\[$"
                                        }
                                      }
                                    ]
                                  }
                                },
                                {
                                  "not": {
                                    "any": [
                                      {
                                        "any": [
                                          {
                                            "all": [
                                              {
                                                "inside": {
                                                  "any": [
                                                    {
                                                      "kind": "assignment_expression"
                                                    },
                                                    {
                                                      "kind": "augmented_assignment_expression"
                                                    }
                                                  ]
                                                }
                                              },
                                              {
                                                "precedes": {
                                                  "regex": "=$"
                                                }
                                              }
                                            ]
                                          },
                                          {
                                            "inside": {
                                              "kind": "update_expression"
                                            }
                                          },
                                          {
                                            "inside": {
                                              "kind": "unary_expression",
                                              "regex": "^delete\\b"
                                            }
                                          },
                                          {
                                            "inside": {
                                              "stopBy": "end",
                                              "any": [
                                                {
                                                  "any": [
                                                    {
                                                      "kind": "object_pattern"
                                                    },
                                                    {
                                                      "kind": "array_pattern"
                                                    }
                                                  ]
                                                }
                                              ]
                                            }
                                          },
                                          {
                                            "all": [
                                              {
                                                "inside": {
                                                  "kind": "for_in_statement"
                                                }
                                              },
                                              {
                                                "precedes": {
                                                  "regex": "^(of|in)$"
                                                }
                                              }
                                            ]
                                          }
                                        ]
                                      },
                                      {
                                        "inside": {
                                          "kind": "parenthesized_expression",
                                          "any": [
                                            {
                                              "all": [
                                                {
                                                  "inside": {
                                                    "any": [
                                                      {
                                                        "kind": "assignment_expression"
                                                      },
                                                      {
                                                        "kind": "augmented_assignment_expression"
                                                      }
                                                    ]
                                                  }
                                                },
                                                {
                                                  "precedes": {
                                                    "regex": "=$"
                                                  }
                                                }
                                              ]
                                            },
                                            {
                                              "inside": {
                                                "kind": "update_expression"
                                              }
                                            },
                                            {
                                              "inside": {
                                                "kind": "unary_expression",
                                                "regex": "^delete\\b"
                                              }
                                            },
                                            {
                                              "inside": {
                                                "stopBy": "end",
                                                "any": [
                                                  {
                                                    "any": [
                                                      {
                                                        "kind": "object_pattern"
                                                      },
                                                      {
                                                        "kind": "array_pattern"
                                                      }
                                                    ]
                                                  }
                                                ]
                                              }
                                            },
                                            {
                                              "all": [
                                                {
                                                  "inside": {
                                                    "kind": "for_in_statement"
                                                  }
                                                },
                                                {
                                                  "precedes": {
                                                    "regex": "^(of|in)$"
                                                  }
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PREFER_FOR_OF",
        "message": "Expected a 'for-of' loop instead of a 'for' loop with this simple iteration"
      }
    }
  ]
}
