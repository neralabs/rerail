{
  "format": "rerail.policy/v1",
  "id": "tslint:member-ordering",
  "revision": 1,
  "description": "Options [{\"order\": \"instance-sandwich\"}]; alphabetize is not ported (needs comparison of two captured names). One check: a member of rank i fails when an earlier sibling member of the same body is ranked after i (TSLint compares with the last non-failing member, which holds the highest rank seen so far).",
  "scope": {"include": ["**/*"], "exclude": []},
  "checks": [
    {
      "id": "member-rank",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "inside": {"any": [{"kind": "class_body"}, {"kind": "interface_body"}, {"kind": "object_type"}]},
            "any": [
              {
                "matches": "rank-public-static-field",
                "follows": {"stopBy": "end", "matches": "after-public-static-field"}
              },
              {
                "matches": "rank-protected-static-field",
                "follows": {"stopBy": "end", "matches": "after-protected-static-field"}
              },
              {
                "matches": "rank-private-static-field",
                "follows": {"stopBy": "end", "matches": "after-private-static-field"}
              },
              {
                "matches": "rank-public-instance-field",
                "follows": {"stopBy": "end", "matches": "after-public-instance-field"}
              },
              {
                "matches": "rank-protected-instance-field",
                "follows": {"stopBy": "end", "matches": "after-protected-instance-field"}
              },
              {
                "matches": "rank-private-instance-field",
                "follows": {"stopBy": "end", "matches": "after-private-instance-field"}
              },
              {"matches": "rank-constructor", "follows": {"stopBy": "end", "matches": "after-constructor"}},
              {
                "matches": "rank-public-instance-accessor",
                "follows": {"stopBy": "end", "matches": "after-public-instance-accessor"}
              },
              {
                "matches": "rank-protected-instance-accessor",
                "follows": {"stopBy": "end", "matches": "after-protected-instance-accessor"}
              },
              {
                "matches": "rank-private-instance-accessor",
                "follows": {"stopBy": "end", "matches": "after-private-instance-accessor"}
              },
              {
                "matches": "rank-public-instance-method",
                "follows": {"stopBy": "end", "matches": "after-public-instance-method"}
              },
              {
                "matches": "rank-protected-instance-method",
                "follows": {"stopBy": "end", "matches": "after-protected-instance-method"}
              },
              {
                "matches": "rank-private-instance-method",
                "follows": {"stopBy": "end", "matches": "after-private-instance-method"}
              },
              {
                "matches": "rank-public-static-accessor",
                "follows": {"stopBy": "end", "matches": "after-public-static-accessor"}
              },
              {
                "matches": "rank-protected-static-accessor",
                "follows": {"stopBy": "end", "matches": "after-protected-static-accessor"}
              },
              {
                "matches": "rank-private-static-accessor",
                "follows": {"stopBy": "end", "matches": "after-private-static-accessor"}
              },
              {
                "matches": "rank-public-static-method",
                "follows": {"stopBy": "end", "matches": "after-public-static-method"}
              },
              {
                "matches": "rank-protected-static-method",
                "follows": {"stopBy": "end", "matches": "after-protected-static-method"}
              }
            ]
          },
          "utils": {
            "rank-public-static-field": {"all": [{"matches": "public"}, {"matches": "static"}], "matches": "field"},
            "rank-protected-static-field": {"all": [{"matches": "protected"}, {"matches": "static"}], "matches": "field"},
            "rank-private-static-field": {"all": [{"matches": "private"}, {"matches": "static"}], "matches": "field"},
            "rank-public-instance-field": {"all": [{"matches": "public", "not": {"matches": "static"}}, {"matches": "field"}]},
            "rank-protected-instance-field": {"all": [{"matches": "protected", "not": {"matches": "static"}}, {"matches": "field"}]},
            "rank-private-instance-field": {"all": [{"matches": "private", "not": {"matches": "static"}}, {"matches": "field"}]},
            "rank-constructor": {"matches": "constructor"},
            "rank-public-instance-accessor": {"all": [{"matches": "public", "not": {"matches": "static"}}, {"matches": "accessor"}]},
            "rank-protected-instance-accessor": {"all": [{"matches": "protected", "not": {"matches": "static"}}, {"matches": "accessor"}]},
            "rank-private-instance-accessor": {"all": [{"matches": "private", "not": {"matches": "static"}}, {"matches": "accessor"}]},
            "rank-public-instance-method": {"all": [{"matches": "public", "not": {"matches": "static"}}, {"matches": "method"}]},
            "rank-protected-instance-method": {"all": [{"matches": "protected", "not": {"matches": "static"}}, {"matches": "method"}]},
            "rank-private-instance-method": {"all": [{"matches": "private", "not": {"matches": "static"}}, {"matches": "method"}]},
            "rank-public-static-accessor": {"all": [{"matches": "public"}, {"matches": "static"}], "matches": "accessor"},
            "rank-protected-static-accessor": {"all": [{"matches": "protected"}, {"matches": "static"}], "matches": "accessor"},
            "rank-private-static-accessor": {"all": [{"matches": "private"}, {"matches": "static"}], "matches": "accessor"},
            "rank-public-static-method": {"all": [{"matches": "public"}, {"matches": "static"}], "matches": "method"},
            "rank-protected-static-method": {"all": [{"matches": "protected"}, {"matches": "static"}], "matches": "method"},
            "after-public-static-field": {
              "any": [
                {
                  "any": [{"not": {"matches": "public"}, "matches": "static"}, {"not": {"matches": "static"}}],
                  "matches": "field"
                },
                {"matches": "constructor"},
                {"matches": "accessor"},
                {"matches": "method"}
              ]
            },
            "after-protected-static-field": {
              "any": [
                {
                  "any": [{"all": [{"matches": "private"}, {"matches": "static"}]}, {"not": {"matches": "static"}}],
                  "matches": "field"
                },
                {"matches": "constructor"},
                {"matches": "accessor"},
                {"matches": "method"}
              ]
            },
            "after-private-static-field": {
              "any": [
                {"not": {"matches": "static"}, "matches": "field"},
                {"matches": "constructor"},
                {"matches": "accessor"},
                {"matches": "method"}
              ]
            },
            "after-public-instance-field": {
              "any": [
                {"all": [{"not": {"matches": "public"}}, {"not": {"matches": "static"}}], "matches": "field"},
                {"matches": "constructor"},
                {"matches": "accessor"},
                {"matches": "method"}
              ]
            },
            "after-protected-instance-field": {
              "any": [
                {"all": [{"matches": "private", "not": {"matches": "static"}}, {"matches": "field"}]},
                {"matches": "constructor"},
                {"matches": "accessor"},
                {"matches": "method"}
              ]
            },
            "after-private-instance-field": {"any": [{"matches": "constructor"}, {"matches": "accessor"}, {"matches": "method"}]},
            "after-constructor": {"any": [{"matches": "accessor"}, {"matches": "method"}]},
            "after-public-instance-accessor": {
              "any": [
                {
                  "any": [{"matches": "static"}, {"all": [{"not": {"matches": "public"}}, {"not": {"matches": "static"}}]}],
                  "matches": "accessor"
                },
                {"matches": "method"}
              ]
            },
            "after-protected-instance-accessor": {
              "any": [
                {
                  "any": [{"matches": "static"}, {"matches": "private", "not": {"matches": "static"}}],
                  "matches": "accessor"
                },
                {"matches": "method"}
              ]
            },
            "after-private-instance-accessor": {"any": [{"all": [{"matches": "static"}, {"matches": "accessor"}]}, {"matches": "method"}]},
            "after-public-instance-method": {
              "any": [
                {"all": [{"matches": "static"}, {"matches": "accessor"}]},
                {
                  "any": [{"matches": "static"}, {"all": [{"not": {"matches": "public"}}, {"not": {"matches": "static"}}]}],
                  "matches": "method"
                }
              ]
            },
            "after-protected-instance-method": {
              "any": [
                {"all": [{"matches": "static"}, {"matches": "accessor"}]},
                {
                  "any": [{"matches": "static"}, {"matches": "private", "not": {"matches": "static"}}],
                  "matches": "method"
                }
              ]
            },
            "after-private-instance-method": {
              "any": [
                {"all": [{"matches": "static"}, {"matches": "accessor"}]},
                {"all": [{"matches": "static"}, {"matches": "method"}]}
              ]
            },
            "after-public-static-accessor": {
              "any": [
                {"all": [{"not": {"matches": "public"}, "matches": "static"}, {"matches": "accessor"}]},
                {"all": [{"matches": "static"}, {"matches": "method"}]}
              ]
            },
            "after-protected-static-accessor": {
              "any": [
                {"all": [{"matches": "private"}, {"matches": "static"}], "matches": "accessor"},
                {"all": [{"matches": "static"}, {"matches": "method"}]}
              ]
            },
            "after-private-static-accessor": {"all": [{"matches": "static"}, {"matches": "method"}]},
            "after-public-static-method": {"all": [{"not": {"matches": "public"}, "matches": "static"}, {"matches": "method"}]},
            "after-protected-static-method": {"all": [{"matches": "private"}, {"matches": "static"}], "matches": "method"},
            "static": {"has": {"regex": "^static$", "not": {"kind": "property_identifier"}}},
            "private": {"has": {"kind": "accessibility_modifier", "regex": "^private$"}},
            "protected": {"has": {"kind": "accessibility_modifier", "regex": "^protected$"}},
            "public": {"not": {"has": {"kind": "accessibility_modifier", "regex": "^(?:private|protected)$"}}},
            "function-initializer": {"has": {"any": [{"kind": "arrow_function"}, {"kind": "function_expression"}]}},
            "method-like": {
              "any": [{"kind": "method_definition"}, {"kind": "method_signature"}, {"kind": "abstract_method_signature"}]
            },
            "field": {
              "any": [
                {"kind": "property_signature"},
                {"kind": "public_field_definition", "not": {"matches": "function-initializer"}}
              ]
            },
            "constructor": {
              "any": [
                {"kind": "construct_signature"},
                {
                  "any": [{"kind": "method_definition"}, {"kind": "method_signature", "inside": {"kind": "class_body"}}],
                  "has": {"kind": "property_identifier", "regex": "^constructor$"}
                }
              ]
            },
            "accessor": {"has": {"regex": "^(?:get|set)$", "not": {"kind": "property_identifier"}}, "matches": "method-like"},
            "method": {
              "any": [
                {"kind": "public_field_definition", "matches": "function-initializer"},
                {"not": {"any": [{"matches": "constructor"}, {"matches": "accessor"}]}, "matches": "method-like"}
              ]
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "MEMBER_ORDERING",
        "severity": "error",
        "message": "Member declaration not allowed after a member of a later-ranked category."
      }
    }
  ]
}
