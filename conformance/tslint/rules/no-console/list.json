{
  "format": "rerail.policy/v1",
  "id": "tslint:no-console",
  "revision": 1,
  "mode": "steer",
  "description": "Bans console.dir/error/log/warn (option list variant).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "console-access",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "pattern": "console.$M"
              },
              {
                "regex": "^console\\.(dir|error|log|warn)$"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_CONSOLE",
        "message": "Calls to 'console.<method>' are not allowed."
      }
    }
  ]
}
