{
  "format": "rerail.policy/v1",
  "id": "tslint:curly",
  "revision": 1,
  "description": "Enforces braces unless the body is on the same line (ignore-same-line).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "loop-braces",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "for_statement"
                  },
                  {
                    "kind": "for_in_statement"
                  },
                  {
                    "kind": "while_statement"
                  }
                ]
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "statement_block"
                  }
                }
              },
              {
                "not": {
                  "regex": "^[^\\n]*$"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "CURLY",
        "severity": "error",
        "message": "for/while statements must be braced"
      }
    },
    {
      "id": "do-braces",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "do_statement"
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "statement_block"
                  }
                }
              },
              {
                "not": {
                  "regex": "^do[ \\t]+[^\\s/][^\\n]*;"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "CURLY",
        "severity": "error",
        "message": "do statements must be braced"
      }
    },
    {
      "id": "if-braces",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "if_statement"
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "statement_block"
                  }
                }
              },
              {
                "not": {
                  "regex": "^([^\\n]*$|[^\\n]*\\n\\s*else\\b)"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "CURLY",
        "severity": "error",
        "message": "if statements must be braced"
      }
    },
    {
      "id": "else-braces",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "else_clause"
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "statement_block"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "if_statement"
                  }
                }
              },
              {
                "not": {
                  "regex": "^else[ \\t]+[^\\n]*$"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "CURLY",
        "severity": "error",
        "message": "else statements must be braced"
      }
    }
  ]
}
