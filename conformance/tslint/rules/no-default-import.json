{
  "format": "rerail.policy/v1",
  "id": "tslint:no-default-import",
  "revision": 1,
  "mode": "steer",
  "description": "Disallows default imports from relative modules (TSLint default fromModules: ^\\./|^\\.\\./).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "default-import-clause",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "identifier"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "import_clause",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "import_statement",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "regex": "^[\"'](?:\\./|\\.\\./)"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_DEFAULT_IMPORT",
        "message": "Import of default members from this module is forbidden. Import named member instead"
      }
    },
    {
      "id": "named-default-import",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^default$"
              },
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^as$"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "import_specifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "named_imports",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "import_clause",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "import_statement",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "string",
                          "regex": "^[\"'](?:\\./|\\.\\./)"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_DEFAULT_IMPORT",
        "message": "Import of default members from this module is forbidden. Import named member instead"
      }
    }
  ]
}