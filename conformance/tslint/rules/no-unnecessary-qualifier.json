{
  "format": "rerail.policy/v1",
  "id": "tslint:no-unnecessary-qualifier",
  "revision": 1,
  "description": "Approximation: flags capitalised namespace-like qualifiers used inside a namespace/module/enum body. Cannot check the qualifier names the enclosing namespace or that it is not shadowed.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "type-qualifier",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "nested_identifier"
                  }
                ]
              },
              {
                "regex": "^[A-Z][A-Za-z0-9_$]*(\\.[A-Z][A-Za-z0-9_$]*)*$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "nested_type_identifier"
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "internal_module"
                    },
                    {
                      "kind": "module"
                    },
                    {
                      "kind": "enum_declaration"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_UNNECESSARY_QUALIFIER",
        "severity": "error",
        "message": "Qualifier is unnecessary since the namespace is in scope."
      }
    },
    {
      "id": "expression-qualifier",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "member_expression"
                  }
                ]
              },
              {
                "regex": "^[A-Z][A-Za-z0-9_$]*(\\.[A-Z][A-Za-z0-9_$]*)*$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "member_expression",
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "member_expression"
                    }
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "internal_module"
                    },
                    {
                      "kind": "module"
                    },
                    {
                      "kind": "enum_declaration"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_UNNECESSARY_QUALIFIER",
        "severity": "error",
        "message": "Qualifier is unnecessary since the namespace is in scope."
      }
    }
  ]
}