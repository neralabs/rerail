{
  "format": "rerail.policy/v1",
  "id": "tslint:no-unused-variable",
  "revision": 1,
  "description": "Syntactic fragment only: flags an empty named import `import {} from \"m\"` (imports nothing). Detecting unused bindings needs reference resolution.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "empty-named-import",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "import_statement",
            "regex": "^import\\s+\\{\\s*\\}\\s*from\\b"
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_UNUSED_VARIABLE",
        "severity": "error",
        "message": "Unused import."
      }
    }
  ]
}
