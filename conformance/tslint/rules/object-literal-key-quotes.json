{
  "format": "rerail.policy/v1",
  "id": "tslint:object-literal-key-quotes",
  "revision": 1,
  "mode": "steer",
  "description": "Property names in object literals must always be quoted (TSLint default option: always).",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "always",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": { "any": [{ "kind": "property_identifier" }, { "kind": "number" }], "matches": "unquoted-key" },
          "utils": {
            "key": {
              "any": [
                {
                  "inside": { "stopBy": "neighbor", "kind": "pair" },
                  "not": { "follows": { "stopBy": "neighbor", "regex": "^:$" } }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "method_definition",
                    "inside": { "stopBy": "neighbor", "kind": "object" }
                  }
                }
              ]
            },
            "unquoted-key": { "any": [{ "kind": "property_identifier" }, { "kind": "number" }], "matches": "key" }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "OBJECT_LITERAL_KEY_QUOTES",
        "message": "Unquoted property found."
      }
    }
  ]
}
