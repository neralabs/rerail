{
  "format": "rerail.policy/v1",
  "id": "tslint:variable-name",
  "revision": 1,
  "mode": "steer",
  "description": "Checks variable/parameter/property names for lowerCamelCase or UPPER_CASE; alias exemption via same-metavar patterns. Options: ['require-const-for-all-caps'].",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "format",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "^_.*\\p{Ll}|\\p{Ll}.*_$|^\\p{Lu}.*\\p{Ll}|^(?:.*\\p{Ll}.*_.+|.+_.*\\p{Ll}.*)$",
            "matches": "format-target",
            "not": {"inside": {"stopBy": "end", "matches": "declare-statement"}}
          },
          "utils": {
            "format-target": {
              "any": [
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "variable_declarator",
                    "not": {"matches": "alias-declarator"}
                  },
                  "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}}
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {"kind": "required_parameter"},
                      {"kind": "optional_parameter"},
                      {"kind": "assignment_pattern"}
                    ]
                  },
                  "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}}
                },
                {
                  "kind": "identifier",
                  "inside": {"stopBy": "neighbor", "any": [{"kind": "array_pattern"}, {"kind": "rest_pattern"}]}
                },
                {
                  "kind": "identifier",
                  "inside": {"stopBy": "neighbor", "kind": "pair_pattern"},
                  "follows": {"stopBy": "neighbor", "regex": "^:$"}
                },
                {
                  "kind": "property_identifier",
                  "inside": {"stopBy": "neighbor", "kind": "public_field_definition", "not": {"matches": "alias-field"}}
                }
              ]
            },
            "alias-declarator": {
              "any": [
                {"pattern": {"context": "var $N = $N", "selector": "variable_declarator"}},
                {"pattern": {"context": "var $N = $O.$N", "selector": "variable_declarator"}}
              ]
            },
            "alias-field": {
              "any": [
                {"pattern": {"context": "class A { $N = $N }", "selector": "public_field_definition"}},
                {"pattern": {"context": "class A { $N = $O.$N }", "selector": "public_field_definition"}}
              ]
            },
            "declare-statement": {
              "any": [{"kind": "lexical_declaration"}, {"kind": "variable_declaration"}],
              "inside": {"stopBy": "neighbor", "kind": "ambient_declaration"}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "VARIABLE_NAME",
        "message": "variable name must be in lowerCamelCase or UPPER_CASE"
      }
    },
    {
      "id": "const-for-caps",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "variable_declarator",
            "has": {
              "stopBy": "neighbor",
              "kind": "identifier",
              "regex": "^[^\\p{Ll}]+$",
              "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}}
            },
            "inside": {
              "stopBy": "neighbor",
              "all": [
                {"any": [{"kind": "variable_declaration"}, {"kind": "lexical_declaration"}]},
                {"regex": "^(var|let)\\b"}
              ]
            },
            "not": {"inside": {"stopBy": "end", "matches": "declare-statement"}}
          },
          "utils": {
            "declare-statement": {
              "any": [{"kind": "lexical_declaration"}, {"kind": "variable_declaration"}],
              "inside": {"stopBy": "neighbor", "kind": "ambient_declaration"}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "VARIABLE_NAME",
        "message": "Only `const` variables may be UPPER_CASE."
      }
    }
  ]
}
