{
  "format": "rerail.policy/v1",
  "id": "tslint:max-file-line-count",
  "revision": 1,
  "description": "Requires files to remain under 300 lines.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "too-many-lines",
      "forbid": {
        "select_when": {
          "select": {
            "regex": {
              "source": "file.content",
              "pattern": "(?s).\\z"
            }
          },
          "exists": {
            "regex": {
              "source": "file.content",
              "pattern": "\\A(?:[^\\n]*\\n){300}"
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "MAX_FILE_LINE_COUNT",
        "severity": "error",
        "message": "This file exceeds the maximum of 300 lines allowed. Consider breaking this file up into smaller parts"
      }
    }
  ]
}