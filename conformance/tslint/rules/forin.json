{
  "format": "rerail.policy/v1",
  "id": "tslint:forin",
  "revision": 1,
  "description": "Requires a for...in body block to be filtered with an if statement.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "forin-unfiltered",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "for_in_statement"
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^of$"
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "kind": "statement_block"
                    },
                    {
                      "not": {
                        "regex": "^\\{\\s*\\}$"
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "all": [
                            {
                              "kind": "if_statement",
                              "follows": {
                                "stopBy": "neighbor",
                                "regex": "^\\{$"
                              }
                            },
                            {
                              "any": [
                                {
                                  "precedes": {
                                    "stopBy": "neighbor",
                                    "regex": "^\\}$"
                                  }
                                },
                                {
                                  "has": {
                                    "stopBy": "neighbor",
                                    "kind": "continue_statement"
                                  }
                                },
                                {
                                  "has": {
                                    "stopBy": "neighbor",
                                    "all": [
                                      {
                                        "kind": "statement_block"
                                      },
                                      {
                                        "regex": "^\\{\\s*continue\\s*;?\\s*\\}$"
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "FORIN",
        "severity": "error",
        "message": "for (... in ...) statements must be filtered with an if statement"
      }
    }
  ]
}
