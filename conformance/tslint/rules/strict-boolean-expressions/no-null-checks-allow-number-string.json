{
  "format": "rerail.policy/v1",
  "id": "tslint:strict-boolean-expressions",
  "revision": 1,
  "description": "Syntactic approximation: flags non-boolean LITERAL operands (number, string, object/array/new/function/class/regex, null, undefined; also parenthesized, to any depth) of &&, ||, !, ternary conditions and if/while/do conditions; allow-number, allow-string.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "checks": [
    {
      "id": "non-boolean-literal",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [{ "matches": "literal" }, { "kind": "parenthesized_expression", "matches": "wrapped-literal" }]
              },
              {
                "any": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "binary_expression",
                      "has": { "stopBy": "neighbor", "regex": "^(?:&&|\\|\\|)$" }
                    },
                    "any": [
                      { "precedes": { "stopBy": "neighbor", "regex": "^(?:&&|\\|\\|)$" } },
                      { "follows": { "stopBy": "neighbor", "regex": "^(?:&&|\\|\\|)$" } }
                    ]
                  },
                  { "inside": { "stopBy": "neighbor", "kind": "unary_expression", "regex": "^!" } },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "parenthesized_expression",
                      "inside": {
                        "stopBy": "neighbor",
                        "any": [{ "kind": "if_statement" }, { "kind": "while_statement" }, { "kind": "do_statement" }]
                      }
                    }
                  },
                  {
                    "inside": { "stopBy": "neighbor", "kind": "ternary_expression" },
                    "precedes": { "stopBy": "neighbor", "regex": "^\\?$" }
                  }
                ]
              }
            ]
          },
          "utils": {
            "literal": {
              "any": [
                { "kind": "object" },
                { "kind": "array" },
                { "kind": "new_expression" },
                { "kind": "arrow_function" },
                { "kind": "function_expression" },
                { "kind": "class" },
                { "kind": "regex" },
                { "kind": "null" },
                { "kind": "undefined" }
              ]
            },
            "wrapped-literal": {
              "has": {
                "stopBy": "neighbor",
                "any": [{ "matches": "literal" }, { "kind": "parenthesized_expression", "matches": "wrapped-literal" }]
              }
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "STRICT_BOOLEAN_EXPRESSIONS",
        "severity": "error",
        "message": "This value in a boolean context is not a boolean."
      }
    }
  ]
}
