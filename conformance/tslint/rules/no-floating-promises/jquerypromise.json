{
  "format": "rerail.policy/v1",
  "id": "tslint:no-floating-promises",
  "revision": 1,
  "description": "no-floating-promises with extra promise class JQueryPromise (same under-approximation).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "floating-then",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "expression_statement"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "all": [
                        {
                          "kind": "call_expression"
                        },
                        {
                          "any": [
                            {
                              "pattern": "$O.then()"
                            },
                            {
                              "pattern": "$O.then($A)"
                            },
                            {
                              "pattern": "$O.finally($$$A)"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "kind": "new_expression"
                        },
                        {
                          "any": [
                            {
                              "pattern": "new Promise($$$A)"
                            },
                            {
                              "pattern": "new JQueryPromise($$$A)"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_FLOATING_PROMISES",
        "severity": "error",
        "message": "Promises must be handled appropriately"
      }
    }
  ]
}
