{
  "format": "rerail.policy/v1",
  "id": "tslint:match-default-export-name",
  "revision": 1,
  "description": "Candidate set only: every default-import binding (cannot resolve the exported declaration's name).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "default-import",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "identifier"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "import_clause"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "MATCH_DEFAULT_EXPORT_NAME",
        "severity": "error",
        "message": "Default import should match the default export name."
      }
    }
  ]
}