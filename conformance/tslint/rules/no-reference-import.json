{
  "format": "rerail.policy/v1",
  "id": "tslint:no-reference-import",
  "revision": 1,
  "mode": "steer",
  "description": "Flags `/// <reference types=\"x\" />` in files that also import. Approximation: cannot check that x is the imported module.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "reference-types-with-import",
      "forbid": {
        "select_when": {
          "select": { "regex": { "source": "file.content", "pattern": "(?m)^[ \\t]*///[ \\t]*<reference[ \\t]+types[ \\t]*=[ \\t]*\"(?<NAME>[^\"\\n]*)\"" } },
          "exists": { "ast": { "language": "typescript", "rule": { "any": [ { "kind": "import_statement" }, { "kind": "import_alias" } ] } } }
        }
      },
      "violation": { "anchor": "capture.NAME", "code": "NO_REFERENCE_IMPORT", "message": "No need to reference the module, since it is imported." }
    }
  ]
}
