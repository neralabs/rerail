{
  "format": "rerail.policy/v1",
  "id": "tslint:object-literal-sort-keys",
  "revision": 1,
  "description": "Options [\"shorthand-first\"]. checkAlphabetical: in an object literal spanning lines, each identifier- or string-keyed property (pair or shorthand) compares its key with the key of the nearest earlier such property, back to the last spread (methods, numeric and computed keys are skipped and keep the previous key); with shorthand-first: a shorthand after a normal property fails, a normal property compares only back to the last shorthand; string keys compare unquoted, by UTF-16 code unit. Only the first descending key of an object is reported, as TSLint returns after it. Not modelled: the blank-line reset (a descending key after a blank line is not reported by TSLint), which needs trivia.",
  "scope": {"include": ["**/*"], "exclude": []},
  "checks": [
    {
      "id": "unsorted-key",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "inside": {"kind": "object", "regex": "\\n"},
            "all": [{"matches": "descending"}, {"not": {"follows": {"stopBy": "end", "matches": "descending-before"}}}]
          },
          "utils": {
            "key": {"any": [{"kind": "property_identifier"}, {"kind": "string"}], "precedes": {"regex": "^:$"}},
            "keyed-previous": {
              "any": [
                {"kind": "pair", "has": {"matches": "key", "pattern": "$PREV"}},
                {"kind": "shorthand_property_identifier", "pattern": "$PREV"}
              ]
            },
            "descending": {
              "any": [
                {
                  "kind": "shorthand_property_identifier",
                  "pattern": "$KEY",
                  "follows": {"stopBy": {"any": [{"kind": "spread_element"}, {"matches": "property"}]}, "kind": "pair"}
                },
                {
                  "kind": "shorthand_property_identifier",
                  "pattern": "$KEY",
                  "follows": {"stopBy": {"kind": "spread_element"}, "matches": "keyed-previous"},
                  "compare": {"left": "PREV", "op": "gt", "right": "KEY", "text": "unquoted"}
                },
                {
                  "kind": "pair",
                  "has": {"matches": "key", "pattern": "$KEY"},
                  "follows": {
                    "stopBy": {"any": [{"kind": "spread_element"}, {"kind": "shorthand_property_identifier"}]},
                    "kind": "pair",
                    "has": {"matches": "key", "pattern": "$PREV"}
                  },
                  "compare": {"left": "PREV", "op": "gt", "right": "KEY", "text": "unquoted"}
                }
              ]
            },
            "property": {"any": [{"kind": "pair"}, {"kind": "shorthand_property_identifier"}]},
            "descending-before": {
              "any": [
                {
                  "kind": "shorthand_property_identifier",
                  "pattern": "$KEY2",
                  "follows": {"stopBy": {"any": [{"kind": "spread_element"}, {"matches": "property"}]}, "kind": "pair"}
                },
                {
                  "kind": "shorthand_property_identifier",
                  "pattern": "$KEY2",
                  "follows": {"stopBy": {"kind": "spread_element"}, "matches": "keyed-previous-2"},
                  "compare": {"left": "PREV2", "op": "gt", "right": "KEY2", "text": "unquoted"}
                },
                {
                  "kind": "pair",
                  "has": {"matches": "key", "pattern": "$KEY2"},
                  "follows": {
                    "stopBy": {"any": [{"kind": "spread_element"}, {"kind": "shorthand_property_identifier"}]},
                    "kind": "pair",
                    "has": {"matches": "key", "pattern": "$PREV2"}
                  },
                  "compare": {"left": "PREV2", "op": "gt", "right": "KEY2", "text": "unquoted"}
                }
              ]
            },
            "keyed-previous-2": {
              "any": [
                {"kind": "pair", "has": {"matches": "key", "pattern": "$PREV2"}},
                {"kind": "shorthand_property_identifier", "pattern": "$PREV2"}
              ]
            }
          }
        }
      },
      "finding": {
        "anchor": "capture.KEY",
        "code": "OBJECT_LITERAL_SORT_KEYS",
        "severity": "error",
        "message": "The key '$KEY' is not sorted alphabetically (after '$PREV')."
      }
    }
  ]
}
