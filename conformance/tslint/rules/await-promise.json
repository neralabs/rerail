{
  "format": "rerail.policy/v1",
  "id": "tslint:await-promise",
  "revision": 1,
  "mode": "steer",
  "description": "Warns for an awaited value that is not a Promise. Syntactic proxy for the type check: await of a literal, a ternary of literals, or `new X()` where X is not Promise; for-await over an array literal.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "await-non-promise",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "await_expression"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "any": [
                        {
                          "kind": "number"
                        },
                        {
                          "kind": "string"
                        },
                        {
                          "kind": "template_string"
                        },
                        {
                          "kind": "true"
                        },
                        {
                          "kind": "false"
                        },
                        {
                          "kind": "null"
                        },
                        {
                          "kind": "undefined"
                        },
                        {
                          "kind": "regex"
                        },
                        {
                          "kind": "array"
                        },
                        {
                          "kind": "object"
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "kind": "parenthesized_expression"
                        },
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "any": [
                                  {
                                    "kind": "number"
                                  },
                                  {
                                    "kind": "string"
                                  },
                                  {
                                    "kind": "template_string"
                                  },
                                  {
                                    "kind": "true"
                                  },
                                  {
                                    "kind": "false"
                                  },
                                  {
                                    "kind": "null"
                                  },
                                  {
                                    "kind": "undefined"
                                  },
                                  {
                                    "kind": "regex"
                                  },
                                  {
                                    "kind": "array"
                                  },
                                  {
                                    "kind": "object"
                                  }
                                ]
                              },
                              {
                                "all": [
                                  {
                                    "kind": "ternary_expression"
                                  },
                                  {
                                    "has": {
                                      "stopBy": "neighbor",
                                      "any": [
                                        {
                                          "kind": "number"
                                        },
                                        {
                                          "kind": "string"
                                        },
                                        {
                                          "kind": "template_string"
                                        },
                                        {
                                          "kind": "true"
                                        },
                                        {
                                          "kind": "false"
                                        },
                                        {
                                          "kind": "null"
                                        },
                                        {
                                          "kind": "undefined"
                                        },
                                        {
                                          "kind": "regex"
                                        },
                                        {
                                          "kind": "array"
                                        },
                                        {
                                          "kind": "object"
                                        }
                                      ],
                                      "precedes": {
                                        "stopBy": "neighbor",
                                        "regex": "^:$"
                                      }
                                    }
                                  },
                                  {
                                    "has": {
                                      "stopBy": "neighbor",
                                      "any": [
                                        {
                                          "kind": "number"
                                        },
                                        {
                                          "kind": "string"
                                        },
                                        {
                                          "kind": "template_string"
                                        },
                                        {
                                          "kind": "true"
                                        },
                                        {
                                          "kind": "false"
                                        },
                                        {
                                          "kind": "null"
                                        },
                                        {
                                          "kind": "undefined"
                                        },
                                        {
                                          "kind": "regex"
                                        },
                                        {
                                          "kind": "array"
                                        },
                                        {
                                          "kind": "object"
                                        }
                                      ],
                                      "follows": {
                                        "stopBy": "neighbor",
                                        "regex": "^:$"
                                      }
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "kind": "new_expression"
                        },
                        {
                          "not": {
                            "regex": "^new\\s+Promise\\b"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "AWAIT_PROMISE",
        "message": "Invalid 'await' of a non-Promise value."
      }
    },
    {
      "id": "for-await-non-async-iterable",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "array"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "for_in_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^await$"
                  }
                }
              },
              {
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "^of$"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "AWAIT_PROMISE",
        "message": "Invalid 'for-await-of' of a non-AsyncIterable value."
      }
    }
  ]
}
