{
  "format": "rerail.policy/v1",
  "id": "tslint:type-literal-delimiter",
  "revision": 1,
  "description": "type-literal-delimiter with singleLine always.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "comma",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^,$"
              },
              {
                "inside": {
                  "kind": "object_type",
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "interface_declaration"
                    }
                  },
                  "stopBy": "neighbor"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "TYPE_LITERAL_DELIMITER",
        "severity": "error",
        "message": "Expected type literal to use ';' instead of ','."
      }
    },
    {
      "id": "missing",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "property_signature"
                  },
                  {
                    "kind": "method_signature"
                  },
                  {
                    "kind": "index_signature"
                  },
                  {
                    "kind": "call_signature"
                  },
                  {
                    "kind": "construct_signature"
                  }
                ]
              },
              {
                "inside": {
                  "kind": "object_type",
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "interface_declaration"
                    }
                  },
                  "stopBy": "neighbor"
                }
              },
              {
                "not": {
                  "precedes": {
                    "stopBy": "neighbor",
                    "regex": "^[;,]$"
                  }
                }
              },
              {
                "regex": "(?<LAST>.)$"
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "capture.LAST",
        "code": "TYPE_LITERAL_DELIMITER",
        "severity": "error",
        "message": "Expected type literal to use ';' to separate members."
      }
    }
  ]
}
