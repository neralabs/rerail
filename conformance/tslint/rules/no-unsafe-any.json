{
  "format": "rerail.policy/v1",
  "id": "tslint:no-unsafe-any",
  "revision": 1,
  "description": "Syntactic fragment only: flags member access / calls on JSON.parse(...), whose declared return type is `any`. General any-tracking needs the type checker (explicit `as any` casts are allowed by TSLint).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "syntactic-any-use",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "pattern": "JSON.parse($$$A).$P"
              },
              {
                "pattern": "JSON.parse($$$A)[$K]"
              },
              {
                "pattern": "JSON.parse($$$A)($$$B)"
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_UNSAFE_ANY",
        "severity": "error",
        "message": "Unsafe use of expression of type 'any'."
      }
    }
  ]
}
