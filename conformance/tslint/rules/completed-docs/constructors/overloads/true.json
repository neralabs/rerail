{
  "format": "rerail.policy/v1",
  "id": "tslint:completed-docs",
  "revision": 1,
  "description": "constructors, each overload documented separately.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "checks": [
    {
      "id": "constructors",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "all": [
                  {
                    "all": [
                      { "any": [{ "kind": "method_definition" }, { "kind": "method_signature" }] },
                      { "has": { "kind": "property_identifier", "regex": "^constructor$" } }
                    ]
                  },
                  { "inside": { "kind": "class_body" } }
                ]
              },
              { "not": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } } }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "severity": "error",
        "message": "Documentation must exist for constructors."
      }
    }
  ]
}
