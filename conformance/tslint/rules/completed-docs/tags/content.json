{
  "format": "rerail.policy/v1",
  "id": "tslint:completed-docs",
  "revision": 1,
  "description": "variables, exempt when @see matches #<digits>.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "checks": [
    {
      "id": "variables-internal",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "kind": "variable_declarator" },
              {
                "inside": {
                  "all": [
                    { "any": [{ "kind": "lexical_declaration" }, { "kind": "variable_declaration" }] },
                    { "not": { "inside": { "kind": "export_statement" } } },
                    {
                      "inside": {
                        "any": [
                          { "kind": "program" },
                          {
                            "kind": "statement_block",
                            "inside": { "any": [{ "kind": "internal_module" }, { "kind": "module" }] }
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "any": [
                  { "matches": "later-declarator" },
                  {
                    "inside": {
                      "all": [
                        { "not": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } } },
                        {
                          "not": {
                            "follows": {
                              "kind": "comment",
                              "all": [{ "regex": "^/\\*\\*" }, { "regex": "\\*\\s*@see\\s\\s*#\\d+\\s" }]
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "utils": {
            "later-declarator": {
              "follows": {
                "any": [
                  { "kind": "variable_declarator" },
                  { "regex": "^,$" },
                  { "kind": "comment", "matches": "later-declarator" }
                ]
              }
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "severity": "error",
        "message": "Documentation must exist for variables."
      }
    },
    {
      "id": "variables-exported",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "kind": "variable_declarator" },
              {
                "inside": {
                  "all": [
                    { "any": [{ "kind": "lexical_declaration" }, { "kind": "variable_declaration" }] },
                    {
                      "inside": {
                        "all": [
                          { "kind": "export_statement" },
                          {
                            "inside": {
                              "any": [
                                { "kind": "program" },
                                {
                                  "kind": "statement_block",
                                  "inside": { "any": [{ "kind": "internal_module" }, { "kind": "module" }] }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "any": [
                  { "matches": "later-declarator" },
                  {
                    "inside": {
                      "inside": {
                        "all": [
                          { "not": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } } },
                          {
                            "not": {
                              "follows": {
                                "kind": "comment",
                                "all": [{ "regex": "^/\\*\\*" }, { "regex": "\\*\\s*@see\\s\\s*#\\d+\\s" }]
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          "utils": {
            "later-declarator": {
              "follows": {
                "any": [
                  { "kind": "variable_declarator" },
                  { "regex": "^,$" },
                  { "kind": "comment", "matches": "later-declarator" }
                ]
              }
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "severity": "error",
        "message": "Documentation must exist for exported variables."
      }
    }
  ]
}
