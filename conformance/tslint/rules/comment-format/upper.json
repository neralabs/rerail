{
  "format": "rerail.policy/v1",
  "id": "tslint:comment-format",
  "revision": 1,
  "description": "Line comments: check-space + check-uppercase.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "line-comment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "comment"
              },
              {
                "regex": "^//+(?<TEXT>.*)$"
              },
              {
                "not": {
                  "regex": "^//+(?:#?(?:end)?region|noinspection\\s)"
                }
              },
              {
                "not": {
                  "regex": "^///\\s*<reference\\b"
                }
              },
              {
                "any": [
                  {
                    "regex": "^//+[^\\s/]"
                  },
                  {
                    "all": [
                      {
                        "regex": "^//+\\s*\\p{Ll}"
                      },
                      {
                        "not": {
                          "regex": "^//+\\s*tslint:(?:enable|disable)(?:-(?:line|next-line))?(?::|\\s|$)"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "capture.TEXT",
        "code": "COMMENT_FORMAT",
        "severity": "error",
        "message": "comment must start with a space and uppercase letter"
      }
    }
  ]
}
