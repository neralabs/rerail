{
  "format": "rerail.policy/v1",
  "id": "tslint:quotemark",
  "revision": 1,
  "description": "Double quotes in code, single quotes in JSX attributes.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "double",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string"
              },
              {
                "regex": "^'"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "jsx_attribute"
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "QUOTEMARK",
        "severity": "error",
        "message": "' should be \""
      }
    },
    {
      "id": "jsx-single",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string"
              },
              {
                "regex": "^\""
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "jsx_attribute"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "QUOTEMARK",
        "severity": "error",
        "message": "\" should be '"
      }
    }
  ]
}
