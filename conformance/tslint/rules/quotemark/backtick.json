{
  "format": "rerail.policy/v1",
  "id": "tslint:quotemark",
  "revision": 1,
  "mode": "steer",
  "description": "Backtick literals wherever TypeScript syntax allows them. JSX attributes (double quotes) are a separate check: a tsx-only kind anywhere in a rule makes it inert on .ts files.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "backtick",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string"
              },
              {
                "not": {
                  "any": [
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "import_statement"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "export_statement"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "pair"
                      },
                      "precedes": {
                        "stopBy": "neighbor",
                        "regex": "^:$"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "property_signature"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "method_signature"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "method_definition"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "enum_body"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "enum_assignment"
                      }
                    },
                    {
                      "all": [
                        {
                          "regex": "^.use strict.$"
                        },
                        {
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "expression_statement"
                          }
                        }
                      ]
                    },
                    {
                      "regex": "(^|[^\\\\])(\\\\\\\\)*\\\\[1-7]"
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "literal_type",
                        "inside": {
                          "stopBy": "end",
                          "any": [
                            {
                              "kind": "type_arguments"
                            },
                            {
                              "kind": "constraint"
                            },
                            {
                              "kind": "lookup_type"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "QUOTEMARK",
        "message": "' or \" should be `"
      }
    },
    {
      "id": "jsx-double",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string"
              },
              {
                "regex": "^'"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "jsx_attribute"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "QUOTEMARK",
        "message": "' should be \""
      }
    }
  ]
}
