{
  "format": "rerail.policy/v1",
  "id": "tslint:prefer-while",
  "revision": 1,
  "description": "Prefer `while` loops over `for` loops without an initializer and incrementor.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "for-without-init-incr",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "for_statement"
              },
              {
                "regex": "^for\\s*\\(\\s*;[^;]*;\\s*\\)"
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "PREFER_WHILE",
        "severity": "error",
        "message": "Prefer `while` loops instead of `for` loops without an initializer and incrementor."
      }
    }
  ]
}
