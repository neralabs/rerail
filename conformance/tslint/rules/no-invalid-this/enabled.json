{
  "format": "rerail.policy/v1",
  "id": "tslint:no-invalid-this",
  "revision": 1,
  "mode": "steer",
  "description": "TSLint tracks the nearest enclosing class or function-like (method, accessor, constructor, property, function declaration or expression; arrow functions are transparent). `this` is allowed when that scope is a class method (a function-like whose own nearest enclosing scope is a class) or a function with a `this` parameter, found by an inside walk that stops at the nearest scope. check-function-in-method: a disallowed `this` inside a class is reported too.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "invalid-this",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "this"
              },
              {
                "not": {
                  "inside": {
                    "any": [
                      {
                        "kind": "required_parameter"
                      },
                      {
                        "kind": "optional_parameter"
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": {
                      "matches": "scope"
                    },
                    "any": [
                      {
                        "matches": "bound-function"
                      },
                      {
                        "matches": "class-method"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "utils": {
            "class-like": {
              "any": [
                {
                  "kind": "class_declaration"
                },
                {
                  "kind": "class"
                },
                {
                  "kind": "abstract_class_declaration"
                }
              ]
            },
            "function-like": {
              "any": [
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "public_field_definition"
                },
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "generator_function"
                }
              ]
            },
            "scope": {
              "any": [
                {
                  "matches": "class-like"
                },
                {
                  "matches": "function-like"
                }
              ]
            },
            "bound-function": {
              "matches": "function-like",
              "has": {
                "kind": "formal_parameters",
                "has": {
                  "any": [
                    {
                      "kind": "required_parameter"
                    },
                    {
                      "kind": "optional_parameter"
                    }
                  ],
                  "has": {
                    "kind": "this"
                  }
                }
              }
            },
            "class-method": {
              "matches": "function-like",
              "inside": {
                "stopBy": {
                  "matches": "scope"
                },
                "matches": "class-like"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_INVALID_THIS",
        "message": "the \"this\" keyword is disallowed outside of a class body"
      }
    }
  ]
}
