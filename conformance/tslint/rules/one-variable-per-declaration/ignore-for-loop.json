{
  "format": "rerail.policy/v1",
  "id": "tslint:one-variable-per-declaration",
  "revision": 1,
  "description": "Disallows multiple variable definitions in the same declaration statement (ignore-for-loop).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "statement",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "variable_declaration"
                  },
                  {
                    "kind": "lexical_declaration"
                  }
                ]
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "variable_declarator",
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^,$"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "for_statement"
                      },
                      {
                        "kind": "export_statement"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "ONE_VARIABLE_PER_DECLARATION",
        "severity": "error",
        "message": "Multiple variable declarations in the same statement are forbidden"
      }
    },
    {
      "id": "export-statement",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "export_statement"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "variable_declaration"
                        },
                        {
                          "kind": "lexical_declaration"
                        }
                      ]
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "variable_declarator",
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "^,$"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "ONE_VARIABLE_PER_DECLARATION",
        "severity": "error",
        "message": "Multiple variable declarations in the same statement are forbidden"
      }
    }
  ]
}
