{
  "format": "rerail.policy/v1",
  "id": "tslint:typedef",
  "revision": 1,
  "description": "Requires type definitions. TSLint's default (no options) checks nothing; an empty checks list does not compile, so this doc holds one check that cannot match. Per-option variants live in typedef/.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "no-options",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "identifier"
              },
              {
                "kind": "string"
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "TYPEDEF",
        "severity": "error",
        "message": "typedef with no options checks nothing"
      }
    }
  ]
}
