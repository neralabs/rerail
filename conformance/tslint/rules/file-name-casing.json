{
  "format": "rerail.policy/v1",
  "id": "tslint:file-name-casing",
  "revision": 1,
  "description": "File base name (without extension) must be camel-case (a casing option is required; this doc ports camel-case). Findings anchor at file start: the path regex match begins at offset 0.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "camel-case",
      "forbid": {
        "regex": {
          "source": "file.path",
          "pattern": "\\A(?:.*/)?(?:[A-Z][^/]*$|(?:[^/]*[_-][^/]*\\.[^./]*|[^./]*[_-][^./]*)$)"
        }
      },
      "finding": {
        "anchor": "witness.start",
        "code": "FILE_NAME_CASING",
        "severity": "error",
        "message": "File name must be camelCase"
      }
    }
  ]
}