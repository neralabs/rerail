{
  "format": "rerail.policy/v1",
  "id": "tslint:object-literal-shorthand",
  "revision": 1,
  "description": "Enforces method and property shorthand in object literals (TSLint default option: always). Longhand properties carry a fix (`$A`); longhand methods do not (async and generator forms need a different template each).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "longhand-method",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "pair"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "object"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "generator_function"
                    }
                  ],
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "identifier"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "OBJECT_LITERAL_SHORTHAND",
        "severity": "error",
        "message": "Expected method shorthand in object literal."
      }
    },
    {
      "id": "longhand-property",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "pattern": {
                  "context": "({ $A: $A })",
                  "selector": "pair"
                }
              },
              {
                "pattern": {
                  "context": "({ $A: $A } = x)",
                  "selector": "pair_pattern"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "OBJECT_LITERAL_SHORTHAND",
        "severity": "error",
        "message": "Expected property shorthand in object literal.",
        "fix": "$A"
      }
    }
  ]
}
