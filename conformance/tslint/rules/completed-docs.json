{
  "format": "rerail.policy/v1",
  "id": "tslint:completed-docs",
  "revision": 1,
  "mode": "steer",
  "description": "Default options: classes, functions, methods, properties need a JSDoc with text; methods/properties exempt when tagged @deprecated/@inheritdoc/@see. Documented = previous sibling is a /** */ comment with text; function and method overloads share docs with a same-named sibling, get/set accessors with their counterpart.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "classes-internal",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "any": [{ "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
              { "not": { "inside": { "kind": "export_statement" } } },
              { "not": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } } }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "message": "Documentation must exist for classes."
      }
    },
    {
      "id": "classes-exported",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "kind": "export_statement" },
              { "has": { "any": [{ "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] } },
              { "not": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } } }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "message": "Documentation must exist for exported classes."
      }
    },
    {
      "id": "functions-internal",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "matches": "fn" },
              { "not": { "inside": { "kind": "export_statement" } } },
              {
                "not": {
                  "any": [
                    { "matches": "documented" },
                    {
                      "all": [
                        { "matches": "fn-named" },
                        { "inside": { "has": { "all": [{ "matches": "fn-named" }, { "matches": "documented" }] } } }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "utils": {
            "documented": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } },
            "fn": {
              "any": [
                { "kind": "function_declaration" },
                { "kind": "function_signature" },
                { "kind": "generator_function_declaration" }
              ]
            },
            "fn-named": {
              "any": [
                { "all": [{ "matches": "fn" }, { "has": { "kind": "identifier", "pattern": "$FN" } }] },
                { "kind": "export_statement", "has": { "matches": "fn-named" } }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "message": "Documentation must exist for functions."
      }
    },
    {
      "id": "functions-exported",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "kind": "export_statement" },
              { "has": { "matches": "fn" } },
              {
                "not": {
                  "any": [
                    { "matches": "documented" },
                    {
                      "all": [
                        { "matches": "fn-named" },
                        { "inside": { "has": { "all": [{ "matches": "fn-named" }, { "matches": "documented" }] } } }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "utils": {
            "documented": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } },
            "fn": {
              "any": [
                { "kind": "function_declaration" },
                { "kind": "function_signature" },
                { "kind": "generator_function_declaration" }
              ]
            },
            "fn-named": {
              "any": [
                { "all": [{ "matches": "fn" }, { "has": { "kind": "identifier", "pattern": "$FN" } }] },
                { "kind": "export_statement", "has": { "matches": "fn-named" } }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "message": "Documentation must exist for exported functions."
      }
    },
    {
      "id": "methods",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "matches": "method" },
              {
                "not": {
                  "any": [
                    { "matches": "documented" },
                    {
                      "all": [
                        { "has": { "kind": "property_identifier", "pattern": "$MN" } },
                        {
                          "inside": {
                            "kind": "class_body",
                            "has": {
                              "all": [
                                { "matches": "method" },
                                { "has": { "kind": "property_identifier", "pattern": "$MN" } },
                                { "matches": "documented" }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "not": {
                  "follows": {
                    "kind": "comment",
                    "all": [{ "regex": "^/\\*\\*" }, { "regex": "\\*\\s*@(?:deprecated|inheritdoc)\\s|\\*\\s*@see\\s" }]
                  }
                }
              }
            ]
          },
          "utils": {
            "documented": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } },
            "method": {
              "all": [
                {
                  "any": [
                    { "kind": "method_definition", "inside": { "kind": "class_body" } },
                    { "kind": "method_signature" },
                    { "kind": "abstract_method_signature" }
                  ]
                },
                { "not": { "has": { "regex": "^[gs]et$", "not": { "kind": "property_identifier" } } } },
                { "not": { "has": { "kind": "property_identifier", "regex": "^constructor$" } } }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "message": "Documentation must exist for methods."
      }
    },
    {
      "id": "properties",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [{ "kind": "public_field_definition" }, { "kind": "property_signature" }, { "matches": "accessor" }]
              },
              {
                "not": {
                  "any": [
                    { "matches": "documented" },
                    {
                      "all": [
                        { "matches": "accessor" },
                        { "has": { "kind": "property_identifier", "pattern": "$AN" } },
                        {
                          "inside": {
                            "has": {
                              "all": [
                                { "matches": "accessor" },
                                { "has": { "kind": "property_identifier", "pattern": "$AN" } },
                                { "matches": "documented" }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "not": {
                  "follows": {
                    "kind": "comment",
                    "all": [{ "regex": "^/\\*\\*" }, { "regex": "\\*\\s*@(?:deprecated|inheritdoc)\\s|\\*\\s*@see\\s" }]
                  }
                }
              }
            ]
          },
          "utils": {
            "documented": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } },
            "accessor": {
              "all": [
                {
                  "any": [
                    { "kind": "method_definition", "inside": { "kind": "class_body" } },
                    { "kind": "method_signature" },
                    { "kind": "abstract_method_signature" }
                  ]
                },
                { "has": { "regex": "^[gs]et$", "not": { "kind": "property_identifier" } } }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "COMPLETED_DOCS",
        "message": "Documentation must exist for properties."
      }
    }
  ]
}
