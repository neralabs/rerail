{
  "format": "rerail.policy/v1",
  "id": "tslint:no-unnecessary-callback-wrapper",
  "revision": 1,
  "description": "Flags arrow functions that only forward their parameters, in order, to an identifier callee (up to 3 params).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "callback-wrapper",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "arrow_function"
              },
              {
                "any": [
                  {
                    "pattern": "$A => $F($A)"
                  },
                  {
                    "pattern": "($A) => $F($A)"
                  },
                  {
                    "pattern": "($A, $B) => $F($A, $B)"
                  },
                  {
                    "pattern": "($A, $B, $C) => $F($A, $B, $C)"
                  },
                  {
                    "pattern": "$A => $F<$$$T>($A)"
                  },
                  {
                    "pattern": "($A) => $F<$$$T>($A)"
                  },
                  {
                    "pattern": "($A, $B) => $F<$$$T>($A, $B)"
                  },
                  {
                    "pattern": "($A, $B, $C) => $F<$$$T>($A, $B, $C)"
                  },
                  {
                    "pattern": "(...$A) => $F(...$A)"
                  },
                  {
                    "pattern": "($A, ...$B) => $F($A, ...$B)"
                  }
                ]
              },
              {
                "not": {
                  "regex": "^async\\b"
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "has": {
                        "kind": "identifier",
                        "pattern": "$F"
                      }
                    },
                    {
                      "has": {
                        "kind": "formal_parameters",
                        "has": {
                          "stopBy": "end",
                          "kind": "identifier",
                          "pattern": "$F"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "call_expression",
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "member_expression"
                        },
                        {
                          "kind": "subscript_expression"
                        },
                        {
                          "kind": "call_expression"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_UNNECESSARY_CALLBACK_WRAPPER",
        "severity": "error",
        "message": "No need to wrap the callee in another function. Just use it directly."
      }
    }
  ]
}
