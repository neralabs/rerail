{
  "format": "rerail.policy/v1",
  "id": "tslint:prefer-object-spread",
  "revision": 1,
  "mode": "steer",
  "description": "Prefers object spread over Object.assign with an object literal first argument, or whose result is used with a side-effect-free first argument.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "object-literal-target",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "call_expression"
              },
              {
                "any": [
                  {
                    "pattern": "Object.assign({$$$P}, $$$R)"
                  },
                  {
                    "pattern": "Object.assign({$$$P})"
                  }
                ]
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "arguments",
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "spread_element"
                        },
                        {
                          "kind": "this"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PREFER_OBJECT_SPREAD",
        "message": "Use the object spread operator instead."
      }
    },
    {
      "id": "used-result",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "call_expression"
              },
              {
                "regex": "^Object\\s*\\.\\s*assign\\s*\\(\\s*[A-Za-z_$][\\w$]*(?:\\s*\\.\\s*[A-Za-z_$][\\w$]*)*\\s*[,)]"
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "arguments",
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "spread_element"
                        },
                        {
                          "kind": "this"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "expression_statement"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PREFER_OBJECT_SPREAD",
        "message": "'Object.assign' returns the first argument. Prefer object spread if you want a new object."
      }
    }
  ]
}
