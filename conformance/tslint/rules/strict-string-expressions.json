{
  "format": "rerail.policy/v1",
  "id": "tslint:strict-string-expressions",
  "revision": 1,
  "mode": "steer",
  "description": "Disables implicit toString() in string concatenation and template substitutions. APPROXIMATION: only operands whose syntax alone proves a non-stringifiable type (array/object/function/class/new/regex literals, null, undefined) are flagged; named values need the type checker.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "template-span",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "array"
                  },
                  {
                    "kind": "object"
                  },
                  {
                    "kind": "new_expression"
                  },
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "regex"
                  },
                  {
                    "kind": "null"
                  },
                  {
                    "kind": "undefined"
                  }
                ]
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "template_substitution"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "STRICT_STRING_EXPRESSIONS",
        "message": "Explicit conversion to string type required"
      }
    },
    {
      "id": "string-concat",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "binary_expression"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "regex": "^\\+$"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "string"
                    },
                    {
                      "kind": "template_string"
                    }
                  ]
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "array"
                    },
                    {
                      "kind": "object"
                    },
                    {
                      "kind": "new_expression"
                    },
                    {
                      "kind": "class"
                    },
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "regex"
                    },
                    {
                      "kind": "null"
                    },
                    {
                      "kind": "undefined"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "STRICT_STRING_EXPRESSIONS",
        "message": "Explicit conversion to string type required"
      }
    }
  ]
}