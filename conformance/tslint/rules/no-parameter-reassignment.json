{
  "format": "rerail.policy/v1",
  "id": "tslint:no-parameter-reassignment",
  "revision": 1,
  "description": "Flags assignment, update, for-in/of and destructuring-assignment targets whose name is a parameter of an enclosing function (the target's name bound and joined to the parameter list).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "checks": [
    {
      "id": "reassignment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "all": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "assignment_expression"
                        }
                      },
                      {
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^=$"
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "augmented_assignment_expression"
                        }
                      },
                      {
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^[-+*/%&|^<>?]+=$"
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "update_expression"
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "kind": "shorthand_property_identifier_pattern"
                      },
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "object_pattern",
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "assignment_expression"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "for_in_statement"
                        }
                      },
                      {
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^(?:in|of)$"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "pattern": "$P"
              },
              {
                "inside": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "function_declaration"
                    },
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "method_definition"
                    },
                    {
                      "kind": "generator_function_declaration"
                    },
                    {
                      "kind": "generator_function"
                    }
                  ],
                  "all": [
                    {
                      "any": [
                        {
                          "has": {
                            "kind": "formal_parameters",
                            "has": {
                              "stopBy": "end",
                              "any": [
                                {
                                  "kind": "identifier"
                                },
                                {
                                  "kind": "shorthand_property_identifier_pattern"
                                }
                              ],
                              "pattern": "$P",
                              "not": {
                                "follows": {
                                  "regex": "^=$"
                                }
                              }
                            }
                          }
                        },
                        {
                          "has": {
                            "kind": "identifier",
                            "pattern": "$P"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_PARAMETER_REASSIGNMENT",
        "severity": "error",
        "message": "Reassigning parameter is forbidden."
      }
    }
  ]
}
