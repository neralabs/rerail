{
  "format": "rerail.policy/v1",
  "id": "n-exports-style",
  "revision": 1,
  "mode": "steer",
  "description": "eslint-plugin-n 18.4.1 n/exports-style (default \"module.exports\", no batch assign): every reference to the global `exports` (Node's CommonJS-scope binding; a local `exports` shadows it).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "languageOptions": {
            "sourceType": "commonjs"
          },
          "rule": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "shorthand_property_identifier"
              }
            ],
            "regex": "^exports$",
            "resolves": {
              "global": [
                "exports"
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/exports-style",
        "message": "Unexpected access to 'exports'. Use 'module.exports' instead.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/exports-style"
            ]
          }
        }
      }
    }
  ]
}
