{
  "format": "rerail.policy/v1",
  "id": "python-conformance:bandit-b610-django-extra-used",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Bandit 1.8.6's B610 django_extra_used: a call of `extra` whose `where` or `tables` is not a list of plain strings, or whose `select` is not a dict of plain strings, bound to QuerySet.extra's six positional slots. Port of the kernel test b610_extra_with_a_non_literal_where_tables_or_select. Bandit's `# nosec` is not modelled; its recordings run with --ignore-nosec.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "django-extra-used",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "extra($$$)"
              },
              {
                "pattern": "$R.extra($$$)"
              }
            ],
            "all": [
              {
                "any": [
                  {
                    "arguments": {
                      "signature": [
                        "select",
                        "where",
                        "params",
                        "tables",
                        "order_by",
                        "select_params"
                      ],
                      "bind": {
                        "W": "where"
                      }
                    },
                    "has": {
                      "stopBy": "end",
                      "pattern": "$W",
                      "not": {
                        "matches": "strings"
                      }
                    }
                  },
                  {
                    "arguments": {
                      "signature": [
                        "select",
                        "where",
                        "params",
                        "tables",
                        "order_by",
                        "select_params"
                      ],
                      "bind": {
                        "T": "tables"
                      }
                    },
                    "has": {
                      "stopBy": "end",
                      "pattern": "$T",
                      "not": {
                        "matches": "strings"
                      }
                    }
                  },
                  {
                    "arguments": {
                      "signature": [
                        "select",
                        "where",
                        "params",
                        "tables",
                        "order_by",
                        "select_params"
                      ],
                      "bind": {
                        "S": "select"
                      }
                    },
                    "has": {
                      "stopBy": "end",
                      "pattern": "$S",
                      "not": {
                        "matches": "string-pairs"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "utils": {
            "string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT]"
                    }
                  }
                }
              ]
            },
            "strings": {
              "kind": "list",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "any": [
                      {
                        "matches": "string"
                      },
                      {
                        "regex": "^[\\[\\],]$"
                      },
                      {
                        "kind": "comment"
                      }
                    ]
                  }
                }
              }
            },
            "string-pairs": {
              "kind": "dictionary",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "any": [
                      {
                        "kind": "pair",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "not": {
                              "any": [
                                {
                                  "matches": "string"
                                },
                                {
                                  "regex": "^:$"
                                },
                                {
                                  "kind": "comment"
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "regex": "^[{},]$"
                      },
                      {
                        "kind": "comment"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B610",
        "message": "Bandit B610 (django-extra-used)"
      }
    }
  ]
}
