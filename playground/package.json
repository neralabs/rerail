{
  "name": "@neralabs/rerail-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Private development rule playground for Rerail; runs beside the rerail/ package on an attended macOS host",
  "type": "module",
  "scripts": {
    "build": "npm run build:workers && npm run build:ui",
    "build:workers": "node scripts/build.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "check": "tsc --noEmit && npm run check:ui",
    "check:ui": "tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run --dir test",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "test:integration": "vitest run --dir integration",
    "test:watch": "vitest --dir test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@oh-my-pi/pi-agent-core": "18.0.4",
    "@oh-my-pi/pi-ai": "18.0.4",
    "@oh-my-pi/pi-catalog": "18.0.4",
    "better-sqlite3": "^12.11.1",
    "chokidar": "4.0.3",
    "node-pty": "1.1.0",
    "picomatch": "4.0.7",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.0.4",
    "@tailwindcss/vite": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.10.0",
    "@types/picomatch": "4.0.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.1.11",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "node-pty": true,
    "esbuild": true
  }
}
