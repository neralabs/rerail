{
  "name": "@neralabs/rerail-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Development rule playground for Rerail: runs beside this checkout's dev daemon on an attended macOS host. Never published.",
  "license": "Apache-2.0",
  "author": "Nera Software Inc.",
  "type": "module",
  "scripts": {
    "build": "npm run build:workers && npm run build:ui",
    "build:workers": "node scripts/build.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "check": "tsc --noEmit && npm run check:ui",
    "check:ui": "tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run --dir test && vitest run --dir scripts",
    "test:ui": "vitest run --config ui/vitest.config.ts",
    "test:integration": "vitest run --dir integration",
    "test:watch": "vitest --dir test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@oh-my-pi/pi-agent-core": "18.12.6",
    "@oh-my-pi/pi-ai": "18.12.6",
    "@oh-my-pi/pi-catalog": "18.12.6",
    "better-sqlite3": "^12.11.1",
    "chokidar": "4.0.3",
    "node-pty": "1.1.0",
    "picomatch": "4.0.7",
    "ws": "8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.12.6",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.85.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.10.0",
    "@types/picomatch": "4.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "jsdom": "^27.0.0",
    "radix-ui": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "node-pty": true,
    "esbuild": true
  }
}
