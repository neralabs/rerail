.policy "survey-source-inventory" revision 1
.language python
.mode log
.scope include "**/*.py"
.scope exclude
#include "data-layer/survey-reference-targets.rr"
.violation Inventory(at: span, kind: symbol, path: symbol, module: symbol) code "SURVEY_INVENTORY" "inventory"
Inventory(@place(path, 0), "module", path, module) :- sgs_module(_, path, module).
.violation Symbol(at: span, kind: symbol, path: symbol, module: symbol, ordinal: number, sid: symbol, fq: symbol, name: symbol, qual: symbol, symbol_kind: symbol, line: number, owner: symbol, async_flag: number, abstract_flag: number) code "SURVEY_SYMBOL" "symbol"
Symbol(@place(path, 0), "symbol", path, module, ordinal, sid, fq, name, qual, k, line, owner, flag, abstract) :- sgs_symbol(n, d, ordinal, sid, fq, name, qual, k, owner, line, flag), sgs_module(d, path, module), sgs_abstract(n, abstract).
.violation Defined(at: span, kind: symbol, path: symbol, module: symbol, name: symbol, sid: symbol, ordinal: number) code "SURVEY_DEFINED" "defined"
Defined(@place(path, 0), "defined", path, module, name, sid, ordinal) :- sgs_defined(d, name, sid, ordinal), sgs_module(d, path, module).
.violation Imported(at: span, kind: symbol, path: symbol, module: symbol, name: symbol, target: symbol) code "SURVEY_IMPORTED" "import"
Imported(@place(path, 0), k, path, module, name, target) :- sgs_import(d, k, name, target), sgs_module(d, path, module).
.violation Parameter(at: span, kind: symbol, path: symbol, symbol_ordinal: number, ordinal: number, name: symbol, has_annotation: number, text: symbol) code "SURVEY_PARAMETER" "parameter"
Parameter(@place(path, 0), "parameter", path, s, i, name, has, text) :- sgs_parameter(f, i, name, has, text), sgs_symbol(f, d, s, _, _, _, _, _, _, _, _), sgs_module(d, path, _).
.violation Return(at: span, kind: symbol, path: symbol, symbol_ordinal: number, has_annotation: number, text: symbol) code "SURVEY_RETURN" "return"
Return(@place(path, 0), "return", path, s, has, text) :- sgs_return(f, has, text), sgs_symbol(f, d, s, _, _, _, _, _, _, _, _), sgs_module(d, path, _).
.violation ModuleRef(at: span, kind: symbol, path: symbol, module: symbol, name: symbol) code "SURVEY_MODULE_REF" "module reference"
ModuleRef(@place(path, 0), "module_ref", path, module, name) :- sgs_module_ref(d, name), sgs_module(d, path, module).
.decl property_text(n: node, k: symbol, ordinal: number, value: symbol)
property_text(n, "decorator", i, text) :- sgs_decorator(n, i, text).
property_text(n, "class_decorator", i, text) :- sgs_class_decorator(n, i, text).
property_text(n, "base", i, text) :- sgs_base(n, i, text).
.violation Property(at: span, kind: symbol, path: symbol, symbol_ordinal: number, ordinal: number, text: symbol) code "SURVEY_PROPERTY" "property"
Property(@place(path, 0), k, path, s, i, text) :- property_text(n, k, i, text), sgs_symbol(n, d, s, _, _, _, _, _, _, _, _), sgs_module(d, path, _).
.violation ClassAttribute(at: span, kind: symbol, path: symbol, symbol_ordinal: number, ordinal: number, name: symbol, text: symbol) code "SURVEY_CLASS_ATTRIBUTE" "attribute"
ClassAttribute(@place(path, 0), "class_attribute", path, s, i, name, text) :- sgs_class_attribute(n, i, name, text), sgs_symbol(n, d, s, _, _, _, _, _, _, _, _), sgs_module(d, path, _).
.violation RawRef(at: span, kind: symbol, path: symbol, symbol_ordinal: number, ordinal: number, ref_kind: symbol, base: symbol, has_base: number, attr: symbol) code "SURVEY_RAW_REF" "reference"
RawRef(@place(path, 0), "raw_ref", path, s, i, k, base, has, attr) :- sgb_raw_ref(f, i, k, base, has, attr), sgs_symbol(f, d, s, _, _, _, _, _, _, _, _), sgs_module(d, path, _).
.violation ExecutionHit(at: span, kind: symbol, path: symbol, symbol_ordinal: number, name: symbol) code "SURVEY_EXECUTION_HIT" "execution"
ExecutionHit(@place(path, 0), "execution_hit", path, s, name) :- sgb_execution(f, name), sgs_symbol(f, d, s, _, _, _, _, _, _, _, _), sgs_module(d, path, _).
.violation LocalImport(at: span, kind: symbol, path: symbol, symbol_ordinal: number, name: symbol, target: symbol) code "SURVEY_LOCAL_IMPORT" "import"
LocalImport(@place(path, 0), "local_import", path, s, name, target) :- sgb_local_import(f, name, target), sgs_symbol(f, d, s, _, _, _, _, _, _, _, _), sgs_module(d, path, _).
.violation GraphSymbol(at: span, kind: symbol, order_file: number, order_local: number, sid: symbol, path: symbol, line: number, symbol_kind: symbol) code "SURVEY_GRAPH_SYMBOL" "symbol"
GraphSymbol(@place(path, 0), "graph_symbol", f, i, sid, path, line, k) :- sgc_symbol(n, f, i, sid), sgs_symbol(n, _, _, _, _, _, _, k, _, line, _), docof(n, d), sgs_module(d, path, _).
.violation GraphModule(at: span, kind: symbol, order_file: number, module: symbol, path: symbol) code "SURVEY_GRAPH_MODULE" "module"
GraphModule(@place(path, 0), "graph_module", i, module, path) :- sgc_module(module, _, i, path).
.violation GraphFqname(at: span, kind: symbol, name: symbol, sid: symbol) code "SURVEY_GRAPH_FQNAME" "fqname"
GraphFqname(@place("", 0), "graph_fqname", name, sid) :- sgc_fqname(name, sid).
.violation GraphClassName(at: span, kind: symbol, name: symbol, ordinal: number, sid: symbol) code "SURVEY_GRAPH_CLASS_NAME" "class name"
GraphClassName(@place("", 0), "graph_class_name", name, i, sid) :- sgc_class_name(name, i, sid).
.violation GraphMethod(at: span, kind: symbol, owner: symbol, name: symbol, ordinal: number, sid: symbol) code "SURVEY_GRAPH_METHOD" "method"
GraphMethod(@place("", 0), "graph_method", owner, name, i, sid) :- sgc_method(owner, name, i, sid).
.violation GraphBase(at: span, kind: symbol, owner: symbol, ordinal: number, sid: symbol) code "SURVEY_GRAPH_BASE" "base"
GraphBase(@place("", 0), "graph_base", owner, i, sid) :- sgc_base(owner, i, sid).
.violation GraphSubclass(at: span, kind: symbol, owner: symbol, sid: symbol) code "SURVEY_GRAPH_SUBCLASS" "subclass"
GraphSubclass(@place("", 0), "graph_subclass", owner, sid) :- sgc_subclass(owner, sid).
.violation GraphResolution(at: span, kind: symbol, name: symbol, sid: symbol) code "SURVEY_GRAPH_RESOLUTION" "resolution"
GraphResolution(@place("", 0), "graph_resolution", name, sid) :- sgc_resolved(name, sid).
.violation GraphNameCall(at: span, kind: symbol, owner: symbol, ordinal: number, name: symbol, has_target: number, target: symbol, target_kind: symbol) code "SURVEY_GRAPH_NAME_CALL" "name call"
GraphNameCall(@place("", 0), "graph_name_call", sid, i, name, has, target, k) :- sgn_call(sid, i, name, has, target, k).
.violation GraphAccessor(at: span, kind: symbol, owner: symbol) code "SURVEY_GRAPH_ACCESSOR" "accessor"
GraphAccessor(@place("", 0), "graph_accessor", owner) :- cm_root(owner).
.decl accessor_row(kind: symbol, owner: symbol, ordinal: number, sid: symbol)
accessor_row("graph_walk", owner, i, sid) :- cm_walk(owner, sid, i).
accessor_row("graph_public", owner, i, sid) :- cm_public(owner, i, sid).
accessor_row("graph_dunder", owner, i, sid) :- cm_dunder(owner, i, sid).
.violation GraphAccessorRow(at: span, kind: symbol, owner: symbol, ordinal: number, sid: symbol) code "SURVEY_GRAPH_ACCESSOR_ROW" "accessor row"
GraphAccessorRow(@place("", 0), k, owner, i, sid) :- accessor_row(k, owner, i, sid).
.violation GraphRef(at: span, kind: symbol, owner: symbol, ordinal: number, ref_kind: symbol, base: symbol, attr: symbol, has_target: number, target: symbol, target_kind: symbol) code "SURVEY_GRAPH_REF" "reference target"
GraphRef(@place("", 0), "graph_ref", sid, i, k, base, attr, has, target, target_kind) :- sgr_ref(sid, i, k, base, attr, has, target, target_kind).
