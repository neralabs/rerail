{
  "version": 1,
  "rules": [
    {
      "id": "oss:no-force-push",
      "match": {
        "all": [
          { "field": "tool.name", "regex": "^(?:Bash|bash|shell)$" },
          { "field": "input.command", "regex": "\\bgit\\s+push\\b[^\\n]*(?:--force\\b|\\s-f\\b|--force-with-lease\\b)" }
        ]
      },
      "sample": { "source": "tool:*", "boundary": "tool-call" },
      "action": { "delivery": "steer", "content": "Do not force-push: it rewrites published history. Ask the user first." },
      "repeat": { "mode": "always" }
    },
    {
      "id": "oss:no-skip-verify",
      "match": {
        "all": [
          { "field": "input.command", "regex": "\\bgit\\s+(?:commit|push)\\b" },
          { "field": "input.command", "contains": "--no-verify" }
        ]
      },
      "sample": { "source": "tool:Bash", "boundary": "tool-call" },
      "action": { "delivery": "steer", "content": "Do not bypass git hooks with --no-verify; fix the failing check." },
      "repeat": { "mode": "always" }
    },
    {
      "id": "oss:no-git-internals-write",
      "match": {
        "any": [
          { "field": "input.file_path", "regex": "(?:^|/)\\.git/" },
          { "field": "input.path", "regex": "(?:^|/)\\.git/" }
        ]
      },
      "sample": { "source": "tool:*", "boundary": "tool-call" },
      "action": { "delivery": "steer", "content": "Do not write inside .git/; use git commands instead." },
      "repeat": { "mode": "always" }
    }
  ]
}
