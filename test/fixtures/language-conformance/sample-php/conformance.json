{
  "pack": "sample-php",
  "family": "php",
  "capabilities": [
    "syntax",
    "scope"
  ],
  "corpora": [
    {
      "name": "mini",
      "repository": "test/fixtures/language-conformance/sample-php/corpora/mini",
      "commit": "fixture",
      "paths": [
        "src"
      ],
      "exclude": [
        "**/*.blade.php"
      ]
    }
  ],
  "tools": [
    {
      "name": "phpcs",
      "version": "4.0.4"
    }
  ],
  "rules": [
    {
      "id": "forbidden-functions",
      "upstream": {
        "tool": "phpcs",
        "rule": "Generic.PHP.ForbiddenFunctions.FoundWithAlternative"
      },
      "policy": "rules/forbidden-functions.json",
      "capabilities": [
        "syntax"
      ],
      "match": "line+column"
    },
    {
      "id": "forbidden-functions-resolved",
      "upstream": {
        "tool": "phpcs",
        "rule": "Generic.PHP.ForbiddenFunctions.FoundWithAlternative"
      },
      "policy": "rules/forbidden-functions-resolved.json",
      "capabilities": [
        "scope"
      ],
      "match": "line+column"
    }
  ]
}
