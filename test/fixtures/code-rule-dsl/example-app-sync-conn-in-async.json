{"format":"rerail.policy/v1","id":"example-app:SYNC_CONN_IN_ASYNC","revision":1,"mode":"steer","scope":{"include":["api/**/*"],"exclude":[]},"clauses":[{"id":"example-app-sync-conn-in-async","forbid":{"ast":{"language":"python","rule":{"all":[{"kind":"function_definition"},{"regex":"(?s)^async\\s+def\\s+.*\\b\\w*conn\\w*\\.(?:read|write)\\s*\\("}]}}},"violation":{"code":"SYNC_CONN_IN_ASYNC","anchor":"witness.span","message":"conn.session(...).write()/read() are sync methods. In async code they block the event loop, and asyncio.to_thread() fails due to connection thread-affinity."}}]}