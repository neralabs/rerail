{
  "format": "rerail.policy/v1",
  "id": "vue:no-v-html",
  "revision": 1,
  "mode": "steer",
  "description": "A v-html directive, which renders raw HTML.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "v-html",
      "forbid": {
        "ast": {
          "language": "vue",
          "rule": {
            "kind": "directive_attribute",
            "regex": "^v-html"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "VUE-V-HTML",
        "message": "v-html renders raw HTML"
      }
    }
  ]
}
