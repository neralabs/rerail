{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rerail",
  "scopeName": "source.rerail",
  "fileTypes": ["rerail"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#include" },
    { "include": "#declaration" },
    { "include": "#violation" },
    { "include": "#functor" },
    { "include": "#type-declaration" },
    { "include": "#lattice" },
    { "include": "#io" },
    { "include": "#test-block" },
    { "include": "#setting" },
    { "include": "#violation-continuation" },
    { "include": "#body" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.rerail", "match": "(//).*$", "captures": { "1": { "name": "punctuation.definition.comment.rerail" } } },
        {
          "name": "comment.block.rerail",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.rerail" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.rerail" } }
        }
      ]
    },
    "include": {
      "match": "^\\s*(#include)\\b",
      "captures": { "1": { "name": "keyword.control.import.rerail" } }
    },
    "declaration": {
      "comment": ".decl r(x: node, …) modifiers  /  .edit r(…)",
      "begin": "^\\s*(\\.(?:decl|edit))\\s+([A-Za-z_]\\w*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.rerail" },
        "2": { "name": "entity.name.type.relation.rerail" }
      },
      "end": "$",
      "patterns": [
        { "include": "#columns" },
        { "include": "#comments" },
        { "name": "storage.modifier.rerail", "match": "\\b[A-Za-z_]\\w*\\b" }
      ]
    },
    "violation": {
      "comment": ".violation Name(at: node) [code \"X\" | code {c} in \"re\" | tag {t}] \"message\"",
      "begin": "^\\s*(\\.violation)\\s+([A-Za-z_]\\w*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.rerail" },
        "2": { "name": "entity.name.type.relation.rerail" }
      },
      "end": "$",
      "patterns": [
        { "include": "#columns" },
        { "include": "#comments" },
        { "include": "#brace-column" },
        { "name": "keyword.other.rerail", "match": "\\b(?:code|tag|in)\\b" },
        { "include": "#strings" }
      ]
    },
    "violation-continuation": {
      "patterns": [
        {
          "comment": "fix [safe] relation \"title\"",
          "match": "^\\s*(fix)\\s+(?:(safe)\\s+)?([A-Za-z_]\\w*)(?=\\s*\")",
          "captures": {
            "1": { "name": "keyword.other.rerail" },
            "2": { "name": "keyword.other.rerail" },
            "3": { "name": "entity.name.function.rerail" }
          }
        },
        {
          "comment": "suppress TOOL \"rule\", … [over {c}]",
          "begin": "^\\s*(suppress)\\s+([A-Za-z_][\\w-]*)(?=\\s*\")",
          "beginCaptures": {
            "1": { "name": "keyword.other.rerail" },
            "2": { "name": "constant.other.tool.rerail" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "name": "keyword.other.rerail", "match": "\\bover\\b" },
            { "include": "#brace-column" }
          ]
        },
        {
          "match": "^\\s*(options)(?=\\s*\\{)",
          "captures": { "1": { "name": "keyword.other.rerail" } }
        }
      ]
    },
    "functor": {
      "comment": ".functor f(a: symbol): symbol stateful",
      "begin": "^\\s*(\\.functor)\\s+([A-Za-z_]\\w*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.rerail" },
        "2": { "name": "entity.name.function.functor.rerail" }
      },
      "end": "$",
      "patterns": [
        { "include": "#columns" },
        { "include": "#comments" },
        {
          "match": "(:)\\s*([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "punctuation.separator.type.rerail" }, "2": { "name": "support.type.rerail" } }
        },
        { "name": "storage.modifier.rerail", "match": "\\b[A-Za-z_]\\w*\\b" }
      ]
    },
    "type-declaration": {
      "begin": "^\\s*(\\.type)\\s+([A-Za-z_]\\w*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.rerail" },
        "2": { "name": "entity.name.type.rerail" }
      },
      "end": "$",
      "patterns": [
        { "include": "#comments" },
        { "name": "support.type.rerail", "match": "\\b[A-Za-z_]\\w*\\b" }
      ]
    },
    "lattice": {
      "comment": ".lattice name<base> { Op -> @f }",
      "begin": "^\\s*(\\.lattice)\\s+([A-Za-z_]\\w*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.rerail" },
        "2": { "name": "entity.name.type.relation.rerail" }
      },
      "end": "(?<=\\})|$",
      "patterns": [
        { "include": "#comments" },
        {
          "match": "(<)\\s*([A-Za-z_]\\w*)?\\s*(>)",
          "captures": { "2": { "name": "support.type.rerail" } }
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(->)",
          "captures": { "1": { "name": "entity.name.function.rerail" }, "2": { "name": "keyword.operator.rerail" } }
        },
        { "include": "#body" }
      ]
    },
    "io": {
      "comment": ".input r(IO=file, filename=\"…\")  /  .output r, s",
      "begin": "^\\s*(\\.(?:input|output))\\b",
      "beginCaptures": { "1": { "name": "keyword.control.directive.rerail" } },
      "end": "$",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(=)",
          "captures": { "1": { "name": "variable.parameter.rerail" }, "2": { "name": "keyword.operator.rerail" } }
        },
        { "name": "entity.name.type.relation.rerail", "match": "\\b[A-Za-z_]\\w*\\b(?=\\s*(?:\\(|,|$|//))" },
        { "name": "constant.other.rerail", "match": "\\b[A-Za-z_]\\w*\\b" }
      ]
    },
    "test-block": {
      "comment": ".test name [exactly] [uses a, b]  /  .fixtures name",
      "match": "^\\s*(\\.(?:test|fixtures))\\s+([A-Za-z_]\\w*)(?:\\s+(exactly))?(?:\\s+(uses)\\b)?",
      "captures": {
        "1": { "name": "keyword.control.directive.rerail" },
        "2": { "name": "entity.name.namespace.test.rerail" },
        "3": { "name": "keyword.other.rerail" },
        "4": { "name": "keyword.other.rerail" }
      }
    },
    "setting": {
      "comment": "Every other directive is a setting: .policy, .mode, .scope, .language, .description, .fixture, .expect, .end …",
      "begin": "^\\s*(\\.[A-Za-z_]\\w*)\\b",
      "beginCaptures": { "1": { "name": "keyword.control.directive.rerail" } },
      "end": "$",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#code" },
        { "include": "#numbers" },
        { "name": "constant.language.boolean.rerail", "match": "\\b(?:true|false|null)\\b" },
        { "name": "constant.other.setting.rerail", "match": "\\b_\\b" },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.rerail" } }
        },
        { "name": "constant.other.setting.rerail", "match": "\\b[A-Za-z_][\\w-]*\\b" },
        { "include": "#punctuation" }
      ]
    },
    "columns": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.rerail" } },
      "endCaptures": { "0": { "name": "punctuation.section.parens.end.rerail" } },
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(:)\\s*([A-Za-z_]\\w*)(?:\\s*(<)\\s*([A-Za-z_]\\w*)?\\s*(>))?",
          "captures": {
            "1": { "name": "variable.parameter.rerail" },
            "2": { "name": "punctuation.separator.type.rerail" },
            "3": { "name": "support.type.rerail" },
            "5": { "name": "support.type.rerail" }
          }
        },
        { "include": "#punctuation" }
      ]
    },
    "brace-column": {
      "match": "(\\{)\\s*([A-Za-z_]\\w*)\\s*(\\})",
      "captures": {
        "1": { "name": "punctuation.section.braces.begin.rerail" },
        "2": { "name": "variable.other.column.rerail" },
        "3": { "name": "punctuation.section.braces.end.rerail" }
      }
    },
    "strings": {
      "name": "string.quoted.double.rerail",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.rerail" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.rerail" } },
      "patterns": [
        { "name": "constant.character.escape.rerail", "match": "\\\\(?:[\"\\\\nrt]|u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4})" },
        { "match": "\\\\." },
        { "name": "constant.other.placeholder.rerail", "match": "\\{[A-Za-z_][\\w.]*\\}" }
      ]
    },
    "regex": {
      "comment": "match(\"regex\", n): the pattern is a regular expression.",
      "begin": "\\b(match)\\s*(\\()\\s*(\")",
      "beginCaptures": {
        "1": { "name": "entity.name.function.rerail" },
        "2": { "name": "punctuation.section.parens.begin.rerail" },
        "3": { "name": "string.regexp.rerail" }
      },
      "end": "\"",
      "endCaptures": { "0": { "name": "string.regexp.rerail" } },
      "contentName": "string.regexp.rerail",
      "patterns": [{ "match": "\\\\." }]
    },
    "code": {
      "comment": "A backtick literal, fenced by one or more backticks: a code pattern or a fix template. Its $X are metavariables. `` before ) , or ; is the empty literal (replace(c, ``)).",
      "patterns": [
        { "name": "markup.inline.raw.code.rerail", "match": "``(?=\\s*[),;])" },
        {
          "name": "markup.inline.raw.code.rerail",
          "begin": "(`+)",
          "end": "\\1(?!`)",
          "beginCaptures": { "0": { "name": "punctuation.definition.code.begin.rerail" } },
          "endCaptures": { "0": { "name": "punctuation.definition.code.end.rerail" } },
          "patterns": [
            { "name": "support.variable.metavariable.rerail", "match": "\\$\\$?\\$?[A-Z_][A-Z0-9_]*" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.rerail", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.rerail", "match": "\\b\\d+\\b" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.rerail", "match": "," },
        { "name": "punctuation.terminator.rerail", "match": "\\." },
        { "name": "punctuation.separator.rerail", "match": "[;:]" },
        { "name": "punctuation.section.rerail", "match": "[(){}\\[\\]]" }
      ]
    },
    "body": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#regex" },
        { "include": "#strings" },
        { "include": "#code" },
        { "include": "#numbers" },
        { "name": "keyword.control.rule.rerail", "match": ":-" },
        {
          "match": "\\b(must|may)\\s+(?=[A-Za-z_]\\w*\\s*\\()",
          "captures": { "1": { "name": "keyword.other.modal.rerail" } }
        },
        { "name": "keyword.other.aggregate.rerail", "match": "\\b(?:count|sum|min|max|mean|product|join)\\b(?!\\s*\\()(?=[^;\\n]*?:\\s*\\{)" },
        { "name": "keyword.other.aggregate.rerail", "match": "\\b(?:by|sep)\\b(?=[^;\\n]*?:\\s*\\{)" },
        {
          "comment": "A .violation's code or tag on a line of its own: code \"X\", code {c} in \"re\", tag {t}.",
          "match": "^\\s*(code|tag)\\s+(?=[\"{])",
          "captures": { "1": { "name": "keyword.other.rerail" } }
        },
        {
          "match": "(?<=\\})\\s*(in)\\s+(?=\")",
          "captures": { "1": { "name": "keyword.other.rerail" } }
        },
        {
          "match": "(@)([A-Za-z_]\\w*)",
          "captures": { "1": { "name": "punctuation.definition.functor.rerail" }, "2": { "name": "support.function.functor.rerail" } }
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.relation.rerail" } }
        },
        { "name": "keyword.other.negation.rerail", "match": "!(?!=)" },
        { "name": "keyword.operator.comparison.rerail", "match": "!=|<=|>=|<:|=>|->|[=<>~]" },
        { "name": "keyword.operator.arithmetic.rerail", "match": "[-+*/%^&|]" },
        { "name": "support.variable.wildcard.rerail", "match": "\\b_\\b" },
        { "name": "variable.other.rerail", "match": "\\b[A-Za-z_]\\w*\\b" },
        { "include": "#punctuation" }
      ]
    }
  }
}
