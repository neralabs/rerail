     }
    }
   }
  },
  "proj_inventory": {
   "over": "membership",
   "define": {
    "sql": "SELECT *, module || '::' || CASE WHEN class_name IS NULL THEN name ELSE class_name || '.' || name END AS id,\n module || '.' || CASE WHEN class_name IS NULL THEN name ELSE class_name || '.' || name END AS fqname\n FROM (SELECT __path,__start,__end,name,class_name,return_annotation,class_start,body_start, replace(rx_replace(__path, '/__init__\\.py$|\\.py$', ''), '/', '.') AS module, CASE WHEN class_name IS NULL THEN 'function' ELSE 'method' END AS kind FROM py_functions\n UNION ALL SELECT __path,__start,__end,name,NULL,NULL,NULL,body_start,replace(rx_replace(__path, '/__init__\\.py$|\\.py$', ''), '/', '.'),'class' FROM py_classes)"
   },
   "indexes": [
    [
     "id"
    ],
    [
     "module",
     "name"
    ]
   ]
  },
  "proj_declarations": {
   "over": "membership",
   "define": {
    "sql": "SELECT * FROM (SELECT *,row_number() OVER (PARTITION BY id ORDER BY __start DESC,__path) AS selected FROM proj_inventory) WHERE selected=1"
   },
   "indexes": [
    [
     "id"
    ],
    [
     "__path",
     "__start"
    ],
    [
     "module",
     "name"
    ],
    [
     "fqname"
    ],
    [
     "kind",
     "name"
    ],
    [
     "module",
     "class_name"
    ]
   ]
  },
  "proj_parameters": {
   "over": "membership",
   "define": {
    "sql": "SELECT p.*, d.id AS symbol FROM py_parameters p JOIN proj_declarations d ON d.__path=p.__path AND d.__start=p.owner\n WHERE d.class_name IS NULL OR p.name NOT IN ('self','cls')"
   },
   "indexes": [
    [
     "symbol"
    ],
    [
     "__path",
     "owner"
    ],
    [
     "__path",
     "__start"
    ]
   ]
  },
  "proj_annotation_names": {
   "over": "membership",
   "define": {
    "sql": "SELECT d.id AS symbol,a.name FROM py_return_annotations a JOIN proj_declarations d ON d.__path=a.__path AND d.__start=a.owner\n UNION SELECT p.symbol,a.name FROM py_parameter_annotations a JOIN proj_parameters p ON p.__path=a.__path AND p.__start=a.parameter"
   },
   "indexes": [
    [
     "symbol",
     "name"
    ]
   ]
  },
  "proj_imports": {
   "over": "membership",
   "define": {
    "sql": "WITH RECURSIVE\n tokens(path,ordinal,top,base,item,rest,position) AS (\n SELECT __path,__start,top,base,'',rx_replace(items,'#[^\\n]*','') || ',',0 FROM py_imports\n UNION SELECT path,ordinal,top,base,trim(substr(rest,1,instr(rest,',')-1),' ()' || char(10) || char(13)),substr(rest,instr(rest,',')+1),position+1 FROM tokens WHERE rest<>''),\n parts AS (SELECT *,rx_extract(item,'^(\\S+)',1) AS original, rx_extract(item,'\\s+as\\s+(\\S+)$',1) AS alias,\n replace(rx_replace(path,'/__init__\\.py$|\\.py$',''),'/','.') AS module FROM tokens WHERE item<>''),\n relative(path,ordinal,top,base,original,alias,module,prefix,remaining,position) AS (\n SELECT path,ordinal,top,base,original,alias,module,CASE WHEN path LIKE '%/__init__.py' THEN module ELSE rx_replace(module,'\\.?[^.]+$','') END,\n coalesce(length(base)-length(ltrim(base,'.'))-1,-1),position FROM parts\n UNION SELECT path,ordinal,top,base,original,alias,module,rx_replace(prefix,'\\.?[^.]+$',''),remaining-1,position FROM relative WHERE remaining>0),\n resolved AS (SELECT *,CASE WHEN base IS NULL THEN original WHEN base NOT LIKE '.%' THEN base || '.' || original\n ELSE CASE WHEN prefix='' THEN '' ELSE prefix || '.' END || CASE WHEN ltrim(base,'.')='' THEN '' ELSE ltrim(base,'.') || '.' END || original END AS target,\n coalesce(alias,CASE WHEN base IS NULL THEN rx_extract(original,'^[^.]+',0) ELSE original END) AS name FROM relative WHERE remaining<=0)\n SELECT path,ordinal,top,module,name,target,CASE WHEN base IS NULL THEN 'module' ELSE 'symbol' END AS kind\n FROM (SELECT *,row_number() OVER (PARTITION BY module,name,base IS NULL ORDER BY ordinal DESC,position DESC,path) AS selected FROM resolved WHERE original<>'*') WHERE selected=1"
   },
   "indexes": [
    [
     "module",
     "name"
    ],
    [
     "target"
    ]
   ]
  },
  "proj_resolved_names": {
   "over": "membership",
   "define": {
    "sql": "WITH RECURSIVE names(fqname,symbol) AS (\n SELECT fqname,id FROM proj_declarations UNION\n SELECT i.module || '.' || i.name,n.symbol FROM names n CROSS JOIN proj_imports i ON i.target=n.fqname\n WHERE i.kind='symbol' AND NOT EXISTS(SELECT 1 FROM proj_declarations d WHERE d.fqname=i.module || '.' || i.name))\n SELECT * FROM names"
   },
   "indexes": [
    [
     "fqname"
    ],
    [
     "symbol"
    ]
   ]
  },
  "proj_base_edges": {
   "over": "membership",
   "define": {
    "sql": "SELECT d.id AS owner,b.id AS base,r.__start AS ordinal FROM py_bases r JOIN proj_declarations d ON d.__path=r.__path AND d.__start=r.owner\n JOIN proj_declarations b ON b.kind='class' AND b.id=coalesce(\n (SELECT c.id FROM proj_imports i JOIN proj_declarations c ON c.fqname=i.target AND c.kind='class'\n WHERE i.kind='symbol' AND i.module=d.module AND i.name=trim(rx_replace(rx_replace(r.name,'(?s)\\[.*$',''),'^.*\\.','')) ORDER BY c.id LIMIT 1),\n (SELECT c.id FROM proj_declarations c WHERE c.module=d.module AND c.kind='class' AND c.name=trim(rx_replace(rx_replace(r.name,'(?s)\\[.*$',''),'^.*\\.','')) ORDER BY c.id LIMIT 1),\n (SELECT min(c.id) FROM proj_declarations c WHERE c.kind='class' AND c.name=trim(rx_replace(rx_replace(r.name,'(?s)\\[.*$',''),'^.*\\.','')) HAVING count(*)=1))"
   },
   "indexes": [
    [
     "owner"
    ],
    [
     "base"
    ]
   ]
  },
  "proj_hierarchy": {
   "over": "membership",
   "define": {
    "sql": "WITH RECURSIVE walk(owner,base,depth,route,seen) AS (\n SELECT id,id,0,'',',' || id || ',' FROM proj_declarations WHERE kind='class' UNION\n SELECT w.owner,e.base,w.depth+1,w.route || printf('%012d.',e.ordinal),w.seen || e.base || ',' FROM walk w JOIN proj_base_edges e ON e.owner=w.base WHERE instr(w.seen,',' || e.base || ',')=0)\n SELECT owner,base,depth,route FROM (SELECT *,row_number() OVER (PARTITION BY owner,base ORDER BY depth,route) AS selected FROM walk) WHERE selected=1"
   },
   "indexes": [
    [
     "owner"
    ],
    [
     "base"
    ]
   ]
  },
  "proj_public_methods": {
   "over": "membership",
   "define": {
    "sql": "SELECT owner,name,symbol FROM (\n SELECT h.owner,d.name,d.id AS symbol,row_number() OVER (PARTITION BY h.owner,d.name ORDER BY h.depth,h.route,d.id) AS selected\n FROM proj_hierarchy h JOIN proj_declarations c ON c.id=h.base JOIN proj_declarations d ON d.module=c.module AND d.class_name=c.name\n WHERE d.kind='method' AND substr(d.name,1,1)<>'_' AND d.name NOT IN ('__aenter__','__aexit__','__enter__','__exit__','__init__','__repr__','__str__','authorize_internal_access','disable_thread_affinity_checks','get_thread_checks_disabled','set_disable_thread_checks','validate_legacy_delegates','versioned_read','versioned_write')\n AND NOT EXISTS(SELECT 1 FROM py_decorators x WHERE x.__path=d.__path AND x.owner=d.__start AND rx_matches(x.name,'property$|\\.setter$|\\.deleter$'))) WHERE selected=1"
   },
   "indexes": [
    [
     "owner"
    ],
    [
     "symbol"
    ]
   ]
  },
  "proj_explicit_exports": {
   "over": "membership",
   "define": {
    "sql": "SELECT *,row_number() OVER (PARTITION BY __path ORDER BY __start) AS selected FROM py_all"
   },
   "indexes": [
    [
     "__path"
    ]
   ]
  },
  "proj_export_names": {
   "over": "membership",
   "define": {
    "sql": "SELECT path,module,name,target FROM proj_imports WHERE top IS NOT NULL AND kind='symbol' AND rx_matches(path,'^data_layer/[^/]+\\.py$')\n UNION ALL SELECT __path,module,name,fqname FROM proj_declarations WHERE class_name IS NULL AND rx_matches(__path,'^data_layer/[^/]+\\.py$')"
   },
   "indexes": [
    [
     "module",
     "name"
    ]
   ]
  },
  "proj_exported_roots": {
   "over": "membership",
   "define": {
    "sql": "SELECT DISTINCT e.path,e.module AS export_module,e.name AS export_name,n.symbol FROM proj_export_names e JOIN proj_resolved_names n ON n.fqname=e.target\n LEFT JOIN proj_explicit_exports a ON a.__path=e.path AND a.selected=1\n WHERE substr(e.name,1,1)<>'_' AND (a.__path IS NULL OR (a.array IS NOT NULL AND EXISTS(SELECT 1 FROM py_all_names v WHERE v.__path=e.path AND v.owner=a.__start AND v.name=e.name)))"
   },
   "indexes": [
    [
     "symbol"
    ]
   ]
  }
 }
}
