  "sel_sfp": {
   "over": "content",
   "define": {
    "match": {
     "as": "row",
     "query": {
      "ast": {
       "language": "python",
       "syntax": "valid",
       "rule": {
        "all": [
         {
          "kind": "module"
         },
         {
          "all": [
           {
            "$option": "entryPoint",
            "cases": {
             "scan_project_sources": {
              "filePath": {
               "regex": "(?s).*"
              }
             }
            },
            "default": {
             "$option": "sourceProvided",
             "cases": {
              "true": {
               "any": [
                {
                 "matches": "state-function-source"
                },
                {
                 "inside": {
                  "matches": "state-function-source",
                  "stopBy": "end"
                 }
                }
               ]
              },
              "false": {
               "filePath": {
                "regex": "(?s).*"
               }
              }
             }
            }
           },
           {
            "all": [
             {
              "$option": "entryPoint",
              "cases": {
               "scan_project_sources": {
                "filePath": {
                 "regex": "(?s).*"
                }
               }
              },
              "default": {
               "any": [
                {
                 "matches": "state-flow-source"
                },
                {
                 "inside": {
                  "matches": "state-flow-source",
                  "stopBy": "end"
                 }
                }
               ]
              }
             },
             {
              "all": [
               {
                "$option": "oracleAnalyzer",
                "cases": {
                 "true": {
                  "filePath": {
                   "regex": "(?s).*"
                  }
                 },
                 "false": {
                  "any": [
                   {
                    "matches": "state-project-source"
                   },
                   {
                    "inside": {
                     "matches": "state-project-source",
                     "stopBy": "end"
                    }
                   }
                  ]
                 }
                }
               },
               {
                "all": [
                 {
                  "$option": "entryPoint",
                  "cases": {
                   "scan_project_sources": {
                    "filePath": {
                     "regex": "(?s).*"
                    }
                   }
                  },
                  "default": {
                   "filePath": {
                    "regex": "\\b\\B"
                   }
                  }
                 },
                 {
                  "all": [
                   {
                    "$option": "entryPoint",
                    "cases": {
                     "all": {
                      "filePath": {
                       "regex": "(?s).*"
                      }
                     },
                     "scan_project_sources": {
                      "filePath": {
                       "regex": "(?s).*"
                      }
                     }
                    },
                    "default": {
                     "filePath": {
                      "regex": "\\b\\B"
                     }
                    }
                   }
                  ]
                 }
                ]
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "pattern": "$NODE"
         }
        ]
       }
      }
     },
     "project": {
      "kind": "capture.NODE.kind"
     }
    }
   }
  },
  "sel_qc": {
   "over": "content",
   "define": {
    "match": {
     "as": "row",
     "query": {
      "ast": {
       "language": "python",
       "syntax": "valid",
       "rule": {
        "all": [
         {
          "not": {
           "any": [
            {
             "kind": "comment"
            },
            {
             "kind": "string_start"
            },
            {
             "kind": "string_content"
            },
            {
             "kind": "string_end"
            },
            {
             "kind": "escape_sequence"
            },
            {
             "kind": "line_continuation"
            }
           ]
          }
         },
         {
          "$option": "entryPoint",
          "cases": {
           "all": {
            "filePath": {
             "regex": "(?s).*"
            }
           },
           "conditional_architecture_findings": {
            "filePath": {
             "regex": "(?s).*"
            }
           }
          },
          "default": {
           "filePath": {
            "regex": "\\b\\B"
           }
          }
         },
         {
          "matches": "quality-conditional-1-selected"
         },
         {
          "pattern": "$NODE"
         },
         {
          "any": [
           {
            "inside": {
             "all": [
              {
               "matches": "quality-conditional-1-selected"
              },
              {
               "pattern": "$ANCESTOR"
              }
             ],
             "stopBy": {
              "matches": "quality-conditional-1-selected"
             }
            }
           },
           {
            "pattern": "$_"
           }
          ]
         }
        ]
       }
      }
     },
     "project": {
      "kind": "capture.NODE.kind",
      "ancestor_start": "capture.ANCESTOR.startByte",
      "ancestor_end": "capture.ANCESTOR.endByte",
      "ancestor_kind": "capture.ANCESTOR.kind"
     }
    }
   }
  }
 }
