          ]
         },
         {
          "any": [
           {
            "has": {
             "pattern": "$ALIAS",
             "stopBy": "neighbor",
             "field": "alias"
            }
           },
           {
            "pattern": "$_"
           }
          ]
         },
         {
          "any": [
           {
            "has": {
             "pattern": "$MODULE_NAME",
             "stopBy": "neighbor",
             "field": "module_name"
            }
           },
           {
            "pattern": "$_"
           }
          ]
         }
        ]
       }
      }
     },
     "project": {
