 "clauses": [
  {
   "id": "shared",
   "define": {
    "options": {
     "oracleAnalyzer": {
      "type": "boolean",
      "default": false
     },
     "sourceGate": {
      "type": "boolean",
      "default": true
     },
     "executionOnly": {
      "type": "boolean",
      "default": true
     }
    },
    "language": "python",
    "utils": {
     "b5-common-1": {
      "any": [
       {
        "all": [
         {
          "kind": "identifier"
         },
         {
          "pattern": "$NAME"
         }
        ]
       },
       {
        "all": [
         {
          "kind": "typed_parameter"
         },
         {
          "has": {
           "all": [
            {
             "kind": "identifier"
            },
            {
             "pattern": "$NAME"
            }
           ],
           "stopBy": "neighbor"
          }
         }
        ]
       },
       {
        "all": [
         {
          "any": [
           {
            "kind": "default_parameter"
           },
           {
            "kind": "typed_default_parameter"
           }
          ]
         },
         {
          "has": {
           "pattern": "$NAME",
           "stopBy": "neighbor",
           "field": "name"
          }
         }
        ]
       }
      ]
     },
     "b5-common-2": {
      "inside": {
       "all": [
        {
         "kind": "function_definition"
        },
        {
         "not": {
          "inside": {
           "kind": "function_definition",
           "stopBy": "end"
          }
         }
        },
        {
         "pattern": "$OWNER"
        },
        {
         "has": {
          "pattern": "$FNAME",
          "stopBy": "neighbor",
          "field": "name"
         }
        },
        {
         "any": [
          {
           "inside": {
            "all": [
             {
              "kind": "class_definition"
             },
             {
              "has": {
               "pattern": "$CLASS",
               "stopBy": "neighbor",
               "field": "name"
              }
             },
             {
              "pattern": "$CLASS_NODE"
             }
            ],
            "stopBy": {
             "kind": "class_definition"
            }
           }
          },
          {
           "pattern": "$_"
          }
         ]
        },
        {
         "any": [
          {
           "has": {
            "pattern": "$RET",
            "stopBy": "neighbor",
            "field": "return_type"
           }
          },
          {
           "pattern": "$_"
          }
         ]
        },
        {
         "has": {
          "pattern": "$BODY",
          "stopBy": "neighbor",
          "field": "body"
         }
        }
       ],
       "stopBy": {
        "kind": "function_definition"
       }
      }
     },
     "b5-common-3": {
      "regex": "^(?:_fetchall|_fetchone|execute|execute_async|execute_fire_and_forget|execute_grammar|execute_grammar_fetchall|execute_grammar_fetchone|execute_raw|fetchall|fetchall_raw|fetchone|fetchone_raw|grammar_effect_lazy|grammar_fetchall|grammar_fetchall_async|grammar_fetchone|grammar_fetchone_async|grammar_row_lazy|grammar_rows_lazy|raw_execute)$|^(?:execute_grammar|grammar_fetch)"
     }
    }
   }
  },
  {
   "id": "y2-probe",
   "relational": {
    "inputs": {
     "py_bases": {
      "evidence": {
       "as": "row",
       "query": {
        "ast": {
         "language": "python",
         "syntax": "valid",
         "rule": {
          "all": [
           {
            "any": [
             {
              "kind": "identifier"
             },
             {
              "kind": "attribute"
             },
             {
              "kind": "generic_type"
             },
             {
              "kind": "subscript"
             }
            ]
           },
           {
            "pattern": "$BASE"
           },
           {
            "inside": {
             "all": [
              {
               "kind": "argument_list"
              },
              {
               "inside": {
                "all": [
                 {
                  "kind": "class_definition"
                 },
                 {
                  "pattern": "$CLASS"
                 }
                ],
                "stopBy": "neighbor"
               }
              }
             ],
             "stopBy": "neighbor"
            }
           }
          ]
         }
        }
       },
       "project": {
        "owner": "capture.CLASS.startByte",
        "name": "capture.BASE"
       }
      }
     }
    },
    "query": "SELECT __path AS path,owner AS start_byte,owner AS end_byte,max(CASE WHEN instr(name,'ServerPlanStep')>0 THEN 1 ELSE 0 END) AS intent_base,max(CASE WHEN rx_matches(name,'Sql|Grammar') THEN 1 ELSE 0 END) AS grammar_base FROM py_bases WHERE instr(name,'ServerPlanStep')>0 OR rx_matches(name,'Sql|Grammar') GROUP BY __path,owner",
    "key": [
     "intent_base",
     "grammar_base"
    ]
   },
   "violation": {
    "code": "y2_probe",
    "message": "y2 probe",
    "anchor": "witness.span"
   }
  },
  {
   "id": "y2-dyn",
   "relational": {
    "inputs": {
     "raw_dynamic_imports": {
      "evidence": {
       "as": "row",
       "query": {
        "ast": {
         "language": "python",
         "syntax": "valid",
         "rule": {
          "all": [
           {
            "kind": "module"
           },
           {
            "regex": "(?P<ENTRY>(?:\\bimport_module|\\bload_python_module|\\bimportlib\\.import_module)\\(\\s*['\\\"](?P<module>[^'\\\"]+)['\\\"]\\s*\\)\\.(?P<attr>[A-Za-z_][A-Za-z0-9_]*))"
           }
          ]
         }
        }
       },
       "project": {
        "entry": "capture.ENTRY"
       },
       "each": "ENTRY"
      }
     }
    },
    "query": "SELECT __path AS path,__start AS start_byte,__end AS end_byte,rx_extract(entry,'(?:\\bimport_module|\\bload_python_module|\\bimportlib\\.import_module)\\(\\s*[''\\\"](?P<module>[^''\\\"]+)[''\\\"]\\s*\\)\\.(?P<attr>[A-Za-z_][A-Za-z0-9_]*)',1) || '.' || rx_extract(entry,'(?:\\bimport_module|\\bload_python_module|\\bimportlib\\.import_module)\\(\\s*[''\\\"](?P<module>[^''\\\"]+)[''\\\"]\\s*\\)\\.(?P<attr>[A-Za-z_][A-Za-z0-9_]*)',2) AS fqname FROM raw_dynamic_imports",
    "key": [
     "fqname"
    ]
   },
   "violation": {
    "code": "y2_dyn",
    "message": "y2 dyn",
    "anchor": "witness.span"
   }
  }
 ]
