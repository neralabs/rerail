// Exact window matches on the matrix units (decision 0727): for each query (a window of 32 bytes of the text at
// `q0 + q · qs`), the first reference (a window at `r0 + j`, j < nr) whose bytes are the query's. The bytes are
// int8 as they lie (a byte's int8 reading is one-to-one), and the windows' sum of squared differences
//   D(q, j) = P(q) + P(j) - 2 · Σ_k T[q + k] · T[j + k]
// is 0 exactly when they are equal (Fischer and Paterson's matching by correlation): the cross term is a product of
// two Hankel matrices, A's rows the queries' windows (row-major, stride qs) and B's columns the references' (B[k][c]
// = T[j0 + c + k]: row-major, stride 1), read where they lie. Integer sums: exact on the unit and in the emulation.

#include <ukl/matrix.h>
#include <ukl/memory.h>

typedef struct MatchArgs {
    uint32_t nq;
    uint32_t qs;
    uint32_t q0;
    uint32_t nr;
    uint32_t r0;
    uint32_t pad0;
    uint32_t pad1;
    uint32_t pad2;
} MatchArgs;
UKL_REFLECT_STRUCT(MatchArgs, nq, qs, q0, nr, r0, pad0, pad1, pad2)

#define M_W 32u

// Whether i8 runs on the unit here, and its shape.
DEFINE_KERNEL2(tests, m_consts,
               RWBUFFER, uint32_t, out, "[6]",
               GID0,     uint32_t, i,   )
{
    if (i != 0u)
        return;
    out[0] = UKL_MMA_NATIVE(i8); out[1] = UKL_MMA_M(i8); out[2] = UKL_MMA_N(i8); out[3] = UKL_MMA_K(i8);
    out[4] = UKL_MMA_LANES; out[5] = UKL_SIMD_WIDTH;
}

// Each window's sum of squares: `n` windows at `base + i · stride`.
DEFINE_KERNEL2(tests, m_squares,
               ARGS,     MatchArgs, args, ,
               ROBUFFER, int8_t,   T,    "[1]",
               RWBUFFER, int32_t,  P,    "[1]",
               GID0,     uint32_t, i,    )
{
    // args.nq windows at q0 + i · qs.
    if (i >= args.nq)
        return;
    int32_t s = 0;
    for (uint32_t k = 0u; k < M_W; k++) {
        int32_t x = (int32_t)T[args.q0 + i * args.qs + k];
        s += x * x;
    }
    P[i] = s;
}

// The join on the matrix units: one owner (a SIMD group) a threadgroup, `M_QT` tiles of 16 queries an owner (`tile`
// its first), every reference tile of 16 in turn, each B read once for the owner's tiles. A lane keeps the first
// match of each row it holds, and sets it once at the end.
#ifndef M_QT
#define M_QT 1u
#endif
DEFINE_KERNEL2(tests, m_mma,
               ARGS,     MatchArgs, args, ,
               ROBUFFER, int8_t,   T,    "[1]",
               ROBUFFER, int32_t,  Pq,   "[1]",
               ROBUFFER, int32_t,  Pr,   "[1]",
               RWBUFFER, uint32_t, out,  "[1]",
               TGID0,    uint32_t, tile, ,
               LID0,     uint32_t, lid,  )
{
    UklMmaAt at = ukl_mma_at(lid);
    const uint32_t M = UKL_MMA_M(i8), N = UKL_MMA_N(i8);
    uint32_t q = tile * M * M_QT;
    if (q >= args.nq)
        return;
    // The window in steps of the unit's K (32 on the units, 16 in the emulation): A's steps held.
    const uint32_t KS = UKL_MMA_K(i8), STEPS = M_W / UKL_MMA_K(i8);
    uint32_t best[M_QT][UKL_MMA_RB];
    ukl_mma_a_i8 a[M_QT][M_W / UKL_MMA_K(i8)];
    for (uint32_t t = 0u; t < M_QT; t++) {
        for (uint32_t i = 0u; i < UKL_MMA_RB; i++)
            best[t][i] = 0xffffffffu;
        uint32_t qt = min(q + t * M, args.nq - M);
        for (uint32_t s = 0u; s < STEPS; s++)
            ukl_mma_load_a_i8(&a[t][s], T + args.q0 + qt * args.qs + s * KS, args.qs, UKL_ROW_MAJOR, at);
    }
    for (uint32_t j = 0u; j < args.nr; j += N) {
        ukl_mma_b_i8 b[M_W / UKL_MMA_K(i8)];
        for (uint32_t s = 0u; s < STEPS; s++)
            ukl_mma_load_b_i8(&b[s], T + args.r0 + j + s * KS, 1u, UKL_ROW_MAJOR, at);
        for (uint32_t t = 0u; t < M_QT; t++) {
            uint32_t qt = min(q + t * M, args.nq - M);
            ukl_mma_c_i32 c;
            ukl_mma_fill_c_i32(&c, 0, at);
            for (uint32_t s = 0u; s < STEPS; s++)
                ukl_mma_i8(&c, &a[t][s], &b[s], at __UKL_ARGS);
            for (uint32_t e = 0u; e < UKL_MMA_C_PER; e++) {
                uint32_t row = ukl_mma_row(e / UKL_MMA_CB, at), col = ukl_mma_col(e % UKL_MMA_CB, at);
                int32_t d = Pq[qt + row] + Pr[j + col] - 2 * c.x[e];
                if (d == 0 && j + col < best[t][e / UKL_MMA_CB])
                    best[t][e / UKL_MMA_CB] = j + col;
            }
        }
    }
    for (uint32_t t = 0u; t < M_QT; t++) {
        uint32_t qt = min(q + t * M, args.nq - M);
        for (uint32_t i = 0u; i < UKL_MMA_RB; i++) {
            uint32_t row = ukl_mma_row(i, at);
            if (best[t][i] != 0xffffffffu)
                ukl_atomic_min(out + qt + row, best[t][i]);
        }
    }
}

// The same join on the threads: a query a thread, its window's four words held, each reference's first word read
// where it lies (unaligned) and the rest only where it matches; the first match ends the query.
DEFINE_KERNEL2(tests, m_threads,
               ARGS,     MatchArgs, args, ,
               ROBUFFER, uint8_t,  T,    "[1]",
               RWBUFFER, uint32_t, out,  "[1]",
               GID0,     uint32_t, q,    )
{
    if (q >= args.nq)
        return;
    uint32_t at = args.q0 + q * args.qs;
    uint64_t w0 = ukl_ld_u64(T, at), w1 = ukl_ld_u64(T, at + 8u), w2 = ukl_ld_u64(T, at + 16u), w3 = ukl_ld_u64(T, at + 24u);
    uint32_t found = 0xffffffffu;
    for (uint32_t j = 0u; j < args.nr; j++) {
        uint32_t r = args.r0 + j;
        if (ukl_ld_u64(T, r) == w0 && ukl_ld_u64(T, r + 8u) == w1 && ukl_ld_u64(T, r + 16u) == w2 && ukl_ld_u64(T, r + 24u) == w3) {
            found = j;
            break;
        }
    }
    out[q] = found;
}

// ---- A suffix array by prefix doubling (decision 0727): the radix sort (`ukl/radix.h`, the host's passes) and an
// exclusive scan, between these. Ranks are 1 and up; 0 is past the text's end, so a shorter suffix sorts first.

typedef struct SaArgs {
    uint32_t n;
    uint32_t h;
    uint32_t b;
    uint32_t pad;
} SaArgs;
UKL_REFLECT_STRUCT(SaArgs, n, h, b, pad)

// Each suffix's first 7 bytes, 9 bits a symbol (a byte + 1; 0 past the end), high symbol first; its position.
DEFINE_KERNEL2(tests, sa_init,
               ARGS,     SaArgs,   args, ,
               ROBUFFER, uint8_t,  T,    "[1]",
               RWBUFFER, uint64_t, keys, "[1]",
               RWBUFFER, uint32_t, pos,  "[1]",
               GID0,     uint32_t, i,    )
{
    if (i >= args.n)
        return;
    uint64_t k = 0u;
    for (uint32_t c = 0u; c < 7u; c++)
        k = (k << 9) | (i + c < args.n ? (uint64_t)T[i + c] + 1u : 0u);
    keys[i] = k;
    pos[i] = i;
}

// Ranks are a group's first slot in the order so far, plus 1 (0 is past the text's end); each round sorts only the
// rows not yet alone in their group (`m` of them), by (rank, rank h on), `b` bits each.

// Whether sorted row `k` opens a group of the new order (its key not the row before's), and of the old (its rank
// part not the row before's; in the first round, one old group).
DEFINE_KERNEL2(tests, sa_heads,
               ARGS,     SaArgs,   args,   ,
               ROBUFFER, uint64_t, keys,   "[1]",
               RWBUFFER, uint32_t, heads,  "[1]",
               RWBUFFER, uint32_t, oheads, "[1]",
               GID0,     uint32_t, k,      )
{
    if (k >= args.n)
        return;
    heads[k] = (k == 0u || keys[k] != keys[k - 1u]) ? 1u : 0u;
    oheads[k] = (k == 0u || (args.pad == 0u && (keys[k] >> args.b) != (keys[k - 1u] >> args.b))) ? 1u : 0u;
}

// Each group's first row, new (`first`) and old (`ofirst`), at the group's number (the heads' scans).
DEFINE_KERNEL2(tests, sa_firsts,
               ARGS,     SaArgs,   args,   ,
               ROBUFFER, uint32_t, heads,  "[1]",
               ROBUFFER, uint32_t, sid,    "[1]",
               ROBUFFER, uint32_t, oheads, "[1]",
               ROBUFFER, uint32_t, soid,   "[1]",
               RWBUFFER, uint32_t, first,  "[1]",
               RWBUFFER, uint32_t, ofirst, "[1]",
               GID0,     uint32_t, k,      )
{
    if (k >= args.n)
        return;
    if (heads[k] != 0u)
        first[sid[k]] = k;
    if (oheads[k] != 0u)
        ofirst[soid[k]] = k;
}

// Each row's suffix's new rank, its old group's slot and its new group's offset in it; whether the row stays (its
// new group is not it alone).
DEFINE_KERNEL2(tests, sa_rerank,
               ARGS,     SaArgs,   args,   ,
               ROBUFFER, uint64_t, keys,   "[1]",
               ROBUFFER, uint32_t, pos,    "[1]",
               ROBUFFER, uint32_t, heads,  "[1]",
               ROBUFFER, uint32_t, sid,    "[1]",
               ROBUFFER, uint32_t, oheads, "[1]",
               ROBUFFER, uint32_t, soid,   "[1]",
               ROBUFFER, uint32_t, first,  "[1]",
               ROBUFFER, uint32_t, ofirst, "[1]",
               RWBUFFER, uint32_t, rank,   "[1]",
               RWBUFFER, uint32_t, keep,   "[1]",
               GID0,     uint32_t, k,      )
{
    if (k >= args.n)
        return;
    uint32_t id = sid[k] + heads[k] - 1u, oid = soid[k] + oheads[k] - 1u;
    uint32_t base = args.pad != 0u ? 1u : (uint32_t)(keys[k] >> args.b);
    rank[pos[k]] = base + first[id] - ofirst[oid];
    keep[k] = (heads[k] != 0u && (k + 1u == args.n || heads[k + 1u] != 0u)) ? 0u : 1u;
}

// The rows that stay, packed in order.
DEFINE_KERNEL2(tests, sa_compact,
               ARGS,     SaArgs,   args, ,
               ROBUFFER, uint32_t, pos,  "[1]",
               ROBUFFER, uint32_t, keep, "[1]",
               ROBUFFER, uint32_t, koff, "[1]",
               RWBUFFER, uint32_t, out,  "[1]",
               GID0,     uint32_t, k,    )
{
    if (k >= args.n)
        return;
    if (keep[k] != 0u)
        out[koff[k]] = pos[k];
}

// Each staying row's key for the next round: its suffix's rank, then the rank `h` on (0 past the end, `len` the
// text's length).
DEFINE_KERNEL2(tests, sa_keys,
               ARGS,     SaArgs,   args, ,
               ROBUFFER, uint32_t, pos,  "[1]",
               ROBUFFER, uint32_t, rank, "[1]",
               RWBUFFER, uint64_t, keys, "[1]",
               GID0,     uint32_t, k,    )
{
    if (k >= args.n)
        return;
    uint32_t p = pos[k], len = args.pad;
    uint64_t r2 = p + args.h < len ? (uint64_t)rank[p + args.h] : 0u;
    keys[k] = ((uint64_t)rank[p] << args.b) | r2;
}

// The suffix array from the final ranks: each suffix at its slot.
DEFINE_KERNEL2(tests, sa_out,
               ARGS,     SaArgs,   args, ,
               ROBUFFER, uint32_t, rank, "[1]",
               RWBUFFER, uint32_t, sa,   "[1]",
               GID0,     uint32_t, p,    )
{
    if (p >= args.n)
        return;
    sa[rank[p] - 1u] = p;
}
