// The UKL library's test kernels (decision 0440 §5): each wraps library calls, one result a slot, so that
// `library_tests.rs` compares each primitive with its Rust reference, on random inputs and edge sizes, on the device.

#include <ukl/memory.h>
#include <ukl/group.h>
#include <ukl/lz4.h>
#include <ukl/workqueue.h>
#include <ukl/grid.h>

typedef struct TestArgs {
    uint32_t n;
    uint32_t w;
} TestArgs;
UKL_REFLECT_STRUCT(TestArgs, n, w)

// ukl/memory.h: loads at every byte address, and bit fields of width `w` from bit `i * w + i % 5`.
DEFINE_KERNEL2(tests, t_loads,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint8_t,  bytes, "[n + 16]",
               RWBUFFER, uint64_t, out,   "[n * 6]",
               GID0,     uint32_t, i,     )
{
    if (i >= args.n)
        return;
    out[i * 6u + 0u] = ukl_ld_u8(bytes, i);
    out[i * 6u + 1u] = ukl_ld_u16(bytes, i);
    out[i * 6u + 2u] = ukl_ld_u32(bytes, (uint64_t)i);
    out[i * 6u + 3u] = ukl_ld_u64(bytes, i);
    out[i * 6u + 4u] = ukl_ld_bits(bytes, (uint64_t)i * args.w + i % 5u, args.w);
    out[i * 6u + 5u] = ukl_ld_packed(bytes, i, args.w);
}

// Stores into each thread's own 32 bytes at unaligned addresses (a u16 in its first 8, a u32 in its next 8, a u64
// from 16), read back through the coherent loads.
DEFINE_KERNEL2(tests, t_stores,
               ARGS,     TestArgs, args,  ,
               RWBUFFER, uint8_t,  bytes, "[n * 32]",
               RWBUFFER, uint64_t, out,   "[n * 3]",
               GID0,     uint32_t, i,     )
{
    if (i >= args.n)
        return;
    UKL_COHERENT uint8_t* t = (UKL_COHERENT uint8_t*)bytes;
    uint32_t base = i * 32u;
    uint64_t v = ((uint64_t)i * 0x9e3779b97f4a7c15ul) ^ 0x0123456789abcdeful;
    ukl_stc_u16(t, base + i % 7u, v);
    ukl_stc_u32(t, base + 8u + i % 5u, v >> 7);
    ukl_stc_u64(t, base + 16u + i % 9u % 8u, v >> 3);
    out[i * 3u + 0u] = ukl_ldc_u16(t, base + i % 7u);
    out[i * 3u + 1u] = ukl_ldc_u32(t, base + 8u + i % 5u);
    out[i * 3u + 2u] = ukl_ldc_u64(t, base + 16u + i % 9u % 8u);
}

// ukl/bits.h on one word a thread.
DEFINE_KERNEL2(tests, t_bits,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint64_t, words, "[n]",
               RWBUFFER, uint64_t, out,   "[n * 12]",
               GID0,     uint32_t, i,     )
{
    if (i >= args.n)
        return;
    uint64_t w = words[i];
    uint32_t lo = (uint32_t)w;
    RWBUFFER(uint64_t) o = out + i * 12u;
    o[0] = ukl_popcount32(lo);
    o[1] = ukl_popcount64(w);
    o[2] = ukl_clz32(lo);
    o[3] = ukl_clz64(w);
    o[4] = ukl_ctz32(lo);
    o[5] = ukl_ctz64(w);
    o[6] = ukl_rank32(lo, i % 33u);
    o[7] = ukl_rank64(w, i % 65u);
    o[8] = ukl_select32(lo, i % 33u);
    o[9] = ukl_select64(w, i % 65u);
    o[10] = ukl_bits64(w, i % 64u, i * 7u % 65u);
    o[11] = ukl_bits32(lo, i % 33u, i * 5u % 33u);
}

// The first set bit at or after `i`, in a bitset of `w` bits.
DEFINE_KERNEL2(tests, t_bitset_next,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint32_t, words, "[(w + 31) / 32]",
               RWBUFFER, uint32_t, out,   "[n]",
               GID0,     uint32_t, i,     )
{
    if (i < args.n)
        out[i] = ukl_bitset_next(words, args.w, i);
}

// Threads set bits (some the same one): whether each was set before.
DEFINE_KERNEL2(tests, t_bitset_set,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint32_t, bits,  "[n]",
               RWBUFFER, uint32_t, words, "[(w + 31) / 32]",
               RWBUFFER, uint32_t, out,   "[n]",
               GID0,     uint32_t, i,     )
{
    if (i < args.n)
        out[i] = ukl_bitset_set(words, bits[i]) ? 1u : 0u;
}

// ukl/simd.h: every operation, the backend's form and the reference.
DEFINE_KERNEL2(tests, t_simd,
               ARGS,     TestArgs, args, ,
               ROBUFFER, uint32_t, in,   "[n]",
               RWBUFFER, uint32_t, out,  "[n * 16]",
               GID0,     uint32_t, i,    ,
               LANE,     uint16_t, lane, )
{
    uint32_t v = in[i];
    RWBUFFER(uint32_t) o = out + i * 16u;
    o[0] = ukl_sg_sum(v __UKL_ARGS);
    o[1] = ukl_sg_sum_ref(v __UKL_ARGS);
    o[2] = ukl_sg_min(v __UKL_ARGS);
    o[3] = ukl_sg_min_ref(v __UKL_ARGS);
    o[4] = ukl_sg_max(v __UKL_ARGS);
    o[5] = ukl_sg_max_ref(v __UKL_ARGS);
    o[6] = ukl_sg_inclusive_sum(v, lane __UKL_ARGS);
    o[7] = ukl_sg_inclusive_sum_ref(v, lane __UKL_ARGS);
    o[8] = ukl_sg_exclusive_sum(v, lane __UKL_ARGS);
    o[9] = ukl_sg_exclusive_sum_ref(v, lane __UKL_ARGS);
    o[10] = ukl_sg_count_below((v & 1u) != 0u, lane __UKL_ARGS);
    o[11] = ukl_sg_count((v & 1u) != 0u __UKL_ARGS);
    o[12] = ukl_sg_first(v % 5u == 0u __UKL_ARGS);
    o[13] = ukl_sg_broadcast(v, (i / UKL_SIMD_WIDTH) % UKL_SIMD_WIDTH __UKL_ARGS);
    o[14] = ukl_sg_match(v % 4u __UKL_ARGS);
    o[15] = ukl_sg_match_ref(v % 4u __UKL_ARGS);
}

// ukl/group.h: the group's sum, and each thread's exclusive scan and the total.
DEFINE_KERNEL2(tests, t_group,
               ARGS,     TestArgs, args,    ,
               ROBUFFER, uint32_t, in,      "[n]",
               RWBUFFER, uint32_t, out,     "[n * 3]",
               SHARED,   uint32_t, scratch, UKL_TG_SCRATCH,
               GID0,     uint32_t, i,       ,
               LID0,     uint32_t, lid,     ,
               LSZ0,     uint32_t, lsz,     )
{
    uint32_t v = in[i];
    uint32_t s = ukl_tg_sum(v, lid, lsz, scratch __UKL_ARGS);
    UklScan r = ukl_tg_exclusive_sum(v, lid, lsz, scratch __UKL_ARGS);
    out[i * 3u + 0u] = s;
    out[i * 3u + 1u] = r.exclusive;
    out[i * 3u + 2u] = r.total;
}

// ukl/lz4.h: a block a SIMD group; job `j` is {source offset, source length, output offset, capacity}.
DEFINE_KERNEL2(tests, t_lz4,
               ARGS,     TestArgs, args,    ,
               ROBUFFER, uint32_t, jobs,    "[n * 4]",
               ROBUFFER, uint8_t,  in,      "[inLength]",
               RWBUFFER, uint8_t,  outData, "[outLength]",
               RWBUFFER, uint32_t, lengths, "[n]",
               TGID0,    uint32_t, j,       ,
               LANE,     uint16_t, lane,    )
{
    if (j >= args.n)
        return;
    ROBUFFER(uint32_t) job = jobs + j * 4u;
    uint32_t got = ukl_lz4_decode_sg(in + job[0], job[1], outData + job[2], job[3], lane);
    if (lane == 0u)
        lengths[j] = got;
}

// ukl/workqueue.h: a persistent dispatch walking the binary tree of `w` nodes from node 0, each node pushing its
// children; `visits` counts each node's visits. A worker stops after `n` empty polls in a row. `t_workqueue` takes a
// thread at a time, `t_workqueue_sg` a SIMD group at a time.
UKL_INLINE void visit(UklWorkQueue q, UKL_GLOBAL uint32_t* visits, uint32_t nodes, uint32_t item)
{
    ukl_atomic_add(&visits[item], 1u);
    for (uint32_t c = 2u * item + 1u; c <= 2u * item + 2u; c++)
        if (c < nodes)
            ukl_wq_push(q, c);
    ukl_wq_done(q);
}

UKL_INLINE UklWorkQueue test_queue(UKL_GLOBAL uint32_t* slots, UKL_GLOBAL uint32_t* control, uint32_t nodes)
{
    UklWorkQueue q;
    q.slots = slots;
    q.control = control;
    q.capacity = 4u * nodes;
    return q;
}

DEFINE_KERNEL2(tests, t_workqueue,
               ARGS,     TestArgs, args,    ,
               RWBUFFER, uint32_t, slots,   "[4 * w]",
               RWBUFFER, uint32_t, control, "[4]",
               RWBUFFER, uint32_t, visits,  "[w]",
               GID0,     uint32_t, i,       )
{
    UklWorkQueue q = test_queue(slots, control, args.w);
    uint32_t polls = 0u;
    for (uint32_t turn = 0u; turn < UKL_WQ_TURNS; turn++) {
        uint32_t item = 0u;
        if (ukl_wq_take(q, &item)) {
            visit(q, visits, args.w, item);
            polls = 0u;
        } else if (ukl_wq_idle(q, &polls, args.n)) {
            break;
        }
    }
}

DEFINE_KERNEL2(tests, t_workqueue_sg,
               ARGS,     TestArgs, args,    ,
               RWBUFFER, uint32_t, slots,   "[4 * w]",
               RWBUFFER, uint32_t, control, "[4]",
               RWBUFFER, uint32_t, visits,  "[w]",
               LANE,     uint16_t, lane,    )
{
    UklWorkQueue q = test_queue(slots, control, args.w);
    uint32_t polls = 0u;
    for (uint32_t turn = 0u; turn < UKL_WQ_TURNS; turn++) {
        uint32_t item = 0u;
        bool got = ukl_wq_take_sg(q, lane, &item __UKL_ARGS);
        if (got)
            visit(q, visits, args.w, item);
        if (ukl_wq_idle_sg(q, got, &polls, args.n __UKL_ARGS))
            break;
    }
}

// ukl/grid.h's barrier: `n` rounds, two barriers each. In a round each thread writes its slot, waits, reads the slot of
// the thread a group ahead (another group's, a coherent read), and counts it wrong unless it is that thread's write
// of this round; then waits again before the next round's writes. `out[group]` is the group's wrong reads.
DEFINE_KERNEL2(tests, t_grid_barrier,
               ARGS,     TestArgs, args,  ,
               RWBUFFER, uint32_t, ctl,   "[3]",
               RWBUFFER, uint32_t, slots, "[w * 256]",
               RWBUFFER, uint32_t, out,   "[w]",
               SHARED,   uint32_t, flag,  1,
               GID0,     uint32_t, i,     ,
               GSZ0,     uint32_t, gsz,   ,
               TGID0,    uint32_t, group, ,
               LID0,     uint32_t, lid,   ,
               LSZ0,     uint32_t, lsz,   )
{
    UklGrid g;
    g.ctl = ctl; g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;
    UKL_COHERENT uint32_t* s = (UKL_COHERENT uint32_t*)slots;
    uint32_t wrong = 0u, other = (i + lsz) % gsz;
    for (uint32_t r = 0u; r < args.n; r++) {
        s[i] = r * gsz + i;
        if (!ukl_grid_barrier(g, flag))
            break;
        wrong += s[other] != r * gsz + other ? 1u : 0u;
        if (!ukl_grid_barrier(g, flag))
            break;
    }
    if (wrong != 0u)
        ukl_atomic_add(&out[group], wrong);
}

// ukl/grid.h's scan: the exclusive scan of `in`'s first `count[0]` values, as the grid's phases.
DEFINE_KERNEL2(tests, t_grid_scan,
               ARGS,     TestArgs, args,    ,
               RWBUFFER, uint32_t, ctl,     "[3]",
               ROBUFFER, uint32_t, count,   "[1]",
               RWBUFFER, uint32_t, in,      "[n]",
               RWBUFFER, uint32_t, out,     "[n + 1]",
               RWBUFFER, uint32_t, sums,    "[w + 1]",
               SHARED,   uint32_t, scratch, UKL_TG_SCRATCH,
               SHARED,   uint32_t, flag,    1,
               GSZ0,     uint32_t, gsz,     ,
               TGID0,    uint32_t, group,   ,
               LID0,     uint32_t, lid,     ,
               LSZ0,     uint32_t, lsz,     )
{
    UklGrid g;
    g.ctl = ctl; g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;
    ukl_grid_scan_exclusive_u32(g, count, (UKL_COHERENT const uint32_t*)in, (UKL_COHERENT uint32_t*)out,
                                (UKL_COHERENT uint32_t*)sums, scratch, flag __UKL_ARGS);
}

// ukl/grid.h's segmented scan: `op` (`w >> 16`) over `in`'s first `count[0]` values, cut at `heads`.
DEFINE_KERNEL2(tests, t_grid_seg,
               ARGS,     TestArgs, args,  ,
               RWBUFFER, uint32_t, ctl,   "[3]",
               ROBUFFER, uint32_t, count, "[1]",
               RWBUFFER, uint32_t, in,    "[n]",
               RWBUFFER, uint32_t, heads, "[n]",
               RWBUFFER, uint32_t, out,   "[n]",
               RWBUFFER, uint32_t, sums,  "[2 * w]",
               SHARED,   uint32_t, sv,    1024,
               SHARED,   uint32_t, sf,    1024,
               SHARED,   uint32_t, flag,  1,
               GSZ0,     uint32_t, gsz,   ,
               TGID0,    uint32_t, group, ,
               LID0,     uint32_t, lid,   ,
               LSZ0,     uint32_t, lsz,   )
{
    UklGrid g;
    g.ctl = ctl; g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;
    ukl_grid_seg_scan_n(g, args.w >> 16, ukl_atomic_load((UKL_GLOBAL uint32_t*)count), (UKL_COHERENT const uint32_t*)in,
                        (UKL_COHERENT const uint32_t*)heads, (UKL_COHERENT uint32_t*)out, (UKL_COHERENT uint32_t*)sums, sv, sf, flag);
}

#if UKL_SIMD_WIDTH >= 8
// ukl/grid.h's sort: `keys`' first `count[0]` by their low `w >> 16` bits, the values their indexes before it.
DEFINE_KERNEL2(tests, t_grid_sort,
               ARGS,     TestArgs, args,    ,
               RWBUFFER, uint32_t, ctl,     "[3]",
               ROBUFFER, uint32_t, count,   "[1]",
               RWBUFFER, uint64_t, keys,    "[n]",
               RWBUFFER, uint32_t, values,  "[n]",
               RWBUFFER, uint64_t, keys2,   "[n]",
               RWBUFFER, uint32_t, values2, "[n]",
               RWBUFFER, uint32_t, hist,    "[256 * n + 1]",
               RWBUFFER, uint32_t, sums,    "[4 * w + 4]",
               SHARED,   uint32_t, h,       UKL_RADIX_DIGITS,
               SHARED,   uint32_t, counts,  UKL_RADIX_GROUPS * UKL_RADIX_DIGITS,
               SHARED,   uint32_t, before,  UKL_RADIX_DIGITS,
               SHARED,   uint32_t, base,    UKL_RADIX_DIGITS,
               SHARED,   uint32_t, tile,    UKL_GRID_SORT_TILE_WORDS,
               SHARED,   uint32_t, scratch, UKL_TG_SCRATCH,
               SHARED,   uint32_t, flag,    1,
               GSZ0,     uint32_t, gsz,     ,
               TGID0,    uint32_t, group,   ,
               LID0,     uint32_t, lid,     ,
               LSZ0,     uint32_t, lsz,     )
{
    UklGrid g;
    g.ctl = ctl; g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;
    UklGridSortLocal l;
    l.h = h; l.counts = counts; l.before = before; l.base = base; l.tile = tile;
    ukl_grid_sort_u64(g, ukl_atomic_load((UKL_GLOBAL uint32_t*)count), args.w >> 16, true, (UKL_COHERENT uint64_t*)keys,
                      (UKL_COHERENT uint32_t*)values, (UKL_COHERENT uint64_t*)keys2, (UKL_COHERENT uint32_t*)values2,
                      (UKL_COHERENT uint32_t*)hist, (UKL_COHERENT uint32_t*)sums, l, scratch, flag __UKL_ARGS);
}
#endif
