// The UKL library's test kernels (decision 0440 §5): each wraps library calls, one result a slot, so that
// `library_tests.rs` compares each primitive with its Rust reference, on random inputs and edge sizes, on the device.

#include <ukl/memory.h>
#include <ukl/dot.h>
#include <ukl/group.h>
#include <ukl/lz4.h>
#include <ukl/workqueue.h>
#include <ukl/stages.h>

typedef struct TestArgs {
    uint32_t n;
    uint32_t w;
} TestArgs;
UKL_REFLECT_STRUCT(TestArgs, n, w)

// ukl/memory.h: loads at every byte address, and bit fields of width `w` from bit `i * w + i % 5`.
DEFINE_KERNEL2(tests, t_loads,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint8_t,  bytes, "[n + 16]",
               RWBUFFER, uint64_t, out,   "[n * 6]",
               GID0,     uint32_t, i,     )
{
    if (i >= args.n)
        return;
    out[i * 6u + 0u] = ukl_ld_u8(bytes, i);
    out[i * 6u + 1u] = ukl_ld_u16(bytes, i);
    out[i * 6u + 2u] = ukl_ld_u32(bytes, (uint64_t)i);
    out[i * 6u + 3u] = ukl_ld_u64(bytes, i);
    out[i * 6u + 4u] = ukl_ld_bits(bytes, (uint64_t)i * args.w + i % 5u, args.w);
    out[i * 6u + 5u] = ukl_ld_packed(bytes, i, args.w);
}

// Stores into each thread's own 32 bytes at unaligned addresses (a u16 in its first 8, a u32 in its next 8, a u64
// from 16), read back through the coherent loads.
DEFINE_KERNEL2(tests, t_stores,
               ARGS,     TestArgs, args,  ,
               RWBUFFER, uint8_t,  bytes, "[n * 32]",
               RWBUFFER, uint64_t, out,   "[n * 3]",
               GID0,     uint32_t, i,     )
{
    if (i >= args.n)
        return;
    UKL_COHERENT uint8_t* t = (UKL_COHERENT uint8_t*)bytes;
    uint32_t base = i * 32u;
    uint64_t v = ((uint64_t)i * 0x9e3779b97f4a7c15ul) ^ 0x0123456789abcdeful;
    ukl_stc_u16(t, base + i % 7u, v);
    ukl_stc_u32(t, base + 8u + i % 5u, v >> 7);
    ukl_stc_u64(t, base + 16u + i % 9u % 8u, v >> 3);
    out[i * 3u + 0u] = ukl_ldc_u16(t, base + i % 7u);
    out[i * 3u + 1u] = ukl_ldc_u32(t, base + 8u + i % 5u);
    out[i * 3u + 2u] = ukl_ldc_u64(t, base + 16u + i % 9u % 8u);
}

// The word stores (`ukl_stw_*`) into each thread's own 32 bytes, as `t_stores`, and a byte at the end, read back
// through the word loads (`ukl_ldw_*`).
DEFINE_KERNEL2(tests, t_word_stores,
               ARGS,     TestArgs, args,  ,
               RWBUFFER, uint8_t,  bytes, "[n * 32]",
               RWBUFFER, uint64_t, out,   "[n * 4]",
               GID0,     uint32_t, i,     )
{
    if (i >= args.n)
        return;
    uint64_t base = (uint64_t)i * 32u;
    uint64_t v = ((uint64_t)i * 0x9e3779b97f4a7c15ul) ^ 0x0123456789abcdeful;
    ukl_stw_u16(bytes, base + i % 7u, v);
    ukl_stw_u32(bytes, base + 8u + i % 5u, v >> 7);
    ukl_stw_u64(bytes, base + 16u + i % 9u % 8u, v >> 3);
    ukl_stw_u8(bytes, base + 31u, v >> 11);
    out[i * 4u + 0u] = ukl_ldw_u16(bytes, base + i % 7u);
    out[i * 4u + 1u] = ukl_ldw_u32(bytes, base + 8u + i % 5u);
    out[i * 4u + 2u] = ukl_ldw_u64(bytes, base + 16u + i % 9u % 8u);
    out[i * 4u + 3u] = ukl_ldw_u8(bytes, base + 31u);
}

// ukl/bits.h on one word a thread.
DEFINE_KERNEL2(tests, t_bits,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint64_t, words, "[n]",
               RWBUFFER, uint64_t, out,   "[n * 15]",
               GID0,     uint32_t, i,     )
{
    if (i >= args.n)
        return;
    uint64_t w = words[i];
    uint32_t lo = (uint32_t)w;
    RWBUFFER(uint64_t) o = out + i * 15u;
    o[0] = ukl_popcount32(lo);
    o[1] = ukl_popcount64(w);
    o[2] = ukl_clz32(lo);
    o[3] = ukl_clz64(w);
    o[4] = ukl_ctz32(lo);
    o[5] = ukl_ctz64(w);
    o[6] = ukl_rank32(lo, i % 33u);
    o[7] = ukl_rank64(w, i % 65u);
    o[8] = ukl_select32(lo, i % 33u);
    o[9] = ukl_select64(w, i % 65u);
    o[10] = ukl_bits64(w, i % 64u, i * 7u % 65u);
    o[11] = ukl_bits32(lo, i % 33u, i * 5u % 33u);
    o[12] = ukl_reverse32(lo);
    o[13] = ukl_reverse64(w);
    o[14] = ukl_umulhi64(w, words[(i + 1u) % args.n]);
}

// The first set bit at or after `i`, in a bitset of `w` bits.
DEFINE_KERNEL2(tests, t_bitset_next,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint32_t, words, "[(w + 31) / 32]",
               RWBUFFER, uint32_t, out,   "[n]",
               GID0,     uint32_t, i,     )
{
    if (i < args.n)
        out[i] = ukl_bitset_next(words, args.w, i);
}

// Threads set bits (some the same one): whether each was set before.
DEFINE_KERNEL2(tests, t_bitset_set,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint32_t, bits,  "[n]",
               RWBUFFER, uint32_t, words, "[(w + 31) / 32]",
               RWBUFFER, uint32_t, out,   "[n]",
               GID0,     uint32_t, i,     )
{
    if (i < args.n)
        out[i] = ukl_bitset_set(words, bits[i]) ? 1u : 0u;
}

// ukl/simd.h: every operation, the backend's form and the reference.
DEFINE_KERNEL2(tests, t_simd,
               ARGS,     TestArgs, args, ,
               ROBUFFER, uint32_t, in,   "[n]",
               RWBUFFER, uint32_t, out,  "[n * 18]",
               GID0,     uint32_t, i,    ,
               LANE,     uint16_t, lane, )
{
    uint32_t v = in[i];
    RWBUFFER(uint32_t) o = out + i * 18u;
    o[0] = ukl_sg_sum(v __UKL_ARGS);
    o[1] = ukl_sg_sum_ref(v __UKL_ARGS);
    o[2] = ukl_sg_min(v __UKL_ARGS);
    o[3] = ukl_sg_min_ref(v __UKL_ARGS);
    o[4] = ukl_sg_max(v __UKL_ARGS);
    o[5] = ukl_sg_max_ref(v __UKL_ARGS);
    o[6] = ukl_sg_inclusive_sum(v, lane __UKL_ARGS);
    o[7] = ukl_sg_inclusive_sum_ref(v, lane __UKL_ARGS);
    o[8] = ukl_sg_exclusive_sum(v, lane __UKL_ARGS);
    o[9] = ukl_sg_exclusive_sum_ref(v, lane __UKL_ARGS);
    o[10] = ukl_sg_count_below((v & 1u) != 0u, lane __UKL_ARGS);
    o[11] = ukl_sg_count((v & 1u) != 0u __UKL_ARGS);
    o[12] = ukl_sg_first(v % 5u == 0u __UKL_ARGS);
    o[13] = ukl_sg_broadcast(v, (i / UKL_SIMD_WIDTH) % UKL_SIMD_WIDTH __UKL_ARGS);
    // The masks as two words, low first (a 64-lane group's).
    uint64_t m = (uint64_t)ukl_sg_match(v % 4u __UKL_ARGS), r = (uint64_t)ukl_sg_match_ref(v % 4u __UKL_ARGS);
    o[14] = (uint32_t)m;
    o[15] = (uint32_t)(m >> 32);
    o[16] = (uint32_t)r;
    o[17] = (uint32_t)(r >> 32);
}

// ukl/group.h: the group's sum, and each thread's exclusive scan and the total.
DEFINE_KERNEL2(tests, t_group,
               ARGS,     TestArgs, args,    ,
               ROBUFFER, uint32_t, in,      "[n]",
               RWBUFFER, uint32_t, out,     "[n * 3]",
               SHARED,   uint32_t, scratch, UKL_TG_SCRATCH,
               GID0,     uint32_t, i,       ,
               LID0,     uint32_t, lid,     ,
               LSZ0,     uint32_t, lsz,     )
{
    uint32_t v = in[i];
    uint32_t s = ukl_tg_sum(v, lid, lsz, scratch __UKL_ARGS);
    UklScan r = ukl_tg_exclusive_sum(v, lid, lsz, scratch __UKL_ARGS);
    out[i * 3u + 0u] = s;
    out[i * 3u + 1u] = r.exclusive;
    out[i * 3u + 2u] = r.total;
}

// ukl/lz4.h: a block a SIMD group; job `j` is {source offset, source length, output offset, capacity}.
DEFINE_KERNEL2(tests, t_lz4,
               ARGS,     TestArgs, args,    ,
               ROBUFFER, uint32_t, jobs,    "[n * 4]",
               ROBUFFER, uint8_t,  in,      "[inLength]",
               RWBUFFER, uint8_t,  outData, "[outLength]",
               RWBUFFER, uint32_t, lengths, "[n]",
               TGID0,    uint32_t, j,       ,
               LANE,     uint16_t, lane,    )
{
    if (j >= args.n)
        return;
    ROBUFFER(uint32_t) job = jobs + j * 4u;
    uint32_t got = ukl_lz4_decode_sg(in + job[0], job[1], outData + job[2], job[3], lane);
    if (lane == 0u)
        lengths[j] = got;
}

// ukl/workqueue.h: a persistent dispatch walking the binary tree of `w` nodes from node 0, each node pushing its
// children; `visits` counts each node's visits. A worker stops after `n` empty polls in a row, or once it has taken
// `b` items in the launch (0: no budget). `t_workqueue` takes a thread at a time, `t_workqueue_sg` a SIMD group at a
// time.
typedef struct QueueArgs {
    uint32_t n;
    uint32_t w;
    uint32_t b;
    uint32_t pad;
} QueueArgs;
UKL_REFLECT_STRUCT(QueueArgs, n, w, b, pad)

UKL_INLINE void visit(UklWorkQueue q, UKL_GLOBAL uint32_t* visits, uint32_t nodes, uint32_t item)
{
    ukl_atomic_add(&visits[item], 1u);
    for (uint32_t c = 2u * item + 1u; c <= 2u * item + 2u; c++)
        if (c < nodes)
            ukl_wq_push(q, c);
    ukl_wq_done(q);
}

UKL_INLINE UklWorkQueue test_queue(UKL_GLOBAL uint32_t* slots, UKL_GLOBAL uint32_t* control, QueueArgs args)
{
    UklWorkQueue q;
    q.slots = slots;
    q.control = control;
    q.capacity = 4u * args.w;
    q.ring = 0u;
    q.budget = args.b;
    return q;
}

DEFINE_KERNEL2(tests, t_workqueue,
               ARGS,     QueueArgs, args,   ,
               RWBUFFER, uint32_t, slots,   "[4 * w]",
               RWBUFFER, uint32_t, control, "[4]",
               RWBUFFER, uint32_t, visits,  "[w]",
               GID0,     uint32_t, i,       )
{
    UklWorkQueue q = test_queue(slots, control, args);
    uint32_t taken = 0u;
    for (uint32_t turn = 0u; turn < UKL_WQ_TURNS && !ukl_wq_spent(q, taken); turn++) {
        uint32_t item = 0u;
        // None to take: the worker ends (decision 0540 step 7).
        if (!ukl_wq_take(q, &item))
            break;
        visit(q, visits, args.w, item);
        taken++;
    }
}

DEFINE_KERNEL2(tests, t_workqueue_sg,
               ARGS,     QueueArgs, args,   ,
               RWBUFFER, uint32_t, slots,   "[4 * w]",
               RWBUFFER, uint32_t, control, "[4]",
               RWBUFFER, uint32_t, visits,  "[w]",
               LANE,     uint16_t, lane,    )
{
    UklWorkQueue q = test_queue(slots, control, args);
    uint32_t taken = 0u;
    for (uint32_t turn = 0u; turn < UKL_WQ_TURNS && !ukl_wq_spent(q, taken); turn++) {
        uint32_t item = 0u;
        bool got = ukl_wq_take_sg(q, lane, &item __UKL_ARGS);
        if (got)
            visit(q, visits, args.w, item);
        // The group's takes that got any item: the same count in every lane. None: the group ends (0540 step 7).
        bool any = ukl_sg_count(got __UKL_ARGS) != 0u;
        if (!any)
            break;
        taken++;
    }
}

// ukl/stages.h's stages: a launch a stage, of `UklTiles` its groups (`t.tiles` the groups dispatched, `t.tile` this
// one), in the order the host gives.
UKL_INLINE UklTiles test_tiles(uint32_t gsz, uint32_t group, uint32_t lid, uint32_t lsz)
{
    UklTiles t;
    t.tiles = gsz / lsz; t.tile = group; t.lid = lid; t.lsz = lsz;
    return t;
}

// The scan of `in`'s first `count[0]` values into `out`, its total at `out[count[0]]`: stage `w & 0xff` (0 one tile's
// alone, 1 the tiles' sums, 2 their scan by one tile, 3 the shares from their offsets).
DEFINE_KERNEL2(tests, t_stage_scan,
               ARGS,     TestArgs, args,    ,
               ROBUFFER, uint32_t, count,   "[1]",
               RWBUFFER, uint32_t, in,      "[n]",
               RWBUFFER, uint32_t, out,     "[n + 1]",
               RWBUFFER, uint32_t, sums,    "[4 * 256 + 4]",
               SHARED,   uint32_t, scratch, UKL_TG_SCRATCH,
               GSZ0,     uint32_t, gsz,     ,
               TGID0,    uint32_t, group,   ,
               LID0,     uint32_t, lid,     ,
               LSZ0,     uint32_t, lsz,     )
{
    UklTiles t = test_tiles(gsz, group, lid, lsz);
    UklScanJob job;
    job.n = count[0]; job.in = (UKL_COHERENT uint32_t*)in; job.out = (UKL_COHERENT uint32_t*)out; job.total = (UKL_COHERENT uint32_t*)out + count[0];
    uint32_t stage = args.w & 0xffu;
    if (stage == 0u) ukl_scans_one(t, &job, 1u, scratch __UKL_ARGS);
    if (stage == 1u) ukl_scans_sum(t, &job, 1u, (UKL_COHERENT uint32_t*)sums, scratch __UKL_ARGS);
    if (stage == 2u && t.tile == 0u) ukl_scans_sums(t, args.w >> 8, 1u, (UKL_COHERENT uint32_t*)sums, scratch __UKL_ARGS);
    if (stage == 3u) ukl_scans_out(t, &job, 1u, (UKL_COHERENT uint32_t*)sums, scratch __UKL_ARGS);
}

// The segmented scan `op` (`w >> 16`) of `in`'s first `count[0]` values, cut at `heads`: stage `w & 0xff` (0 one
// tile's alone, 1 the tiles' aggregates, 2 their carries by one thread, 3 the shares from them); `(w >> 8) & 0xff`
// the tiles of stages 1 and 3.
DEFINE_KERNEL2(tests, t_stage_seg,
               ARGS,     TestArgs, args,  ,
               ROBUFFER, uint32_t, count, "[1]",
               RWBUFFER, uint32_t, in,    "[n]",
               RWBUFFER, uint32_t, heads, "[n]",
               RWBUFFER, uint32_t, out,   "[n]",
               RWBUFFER, uint32_t, sums,  "[2 * 256]",
               SHARED,   uint32_t, sv,    1024,
               SHARED,   uint32_t, sf,    1024,
               GSZ0,     uint32_t, gsz,   ,
               TGID0,    uint32_t, group, ,
               LID0,     uint32_t, lid,   ,
               LSZ0,     uint32_t, lsz,   )
{
    UklTiles t = test_tiles(gsz, group, lid, lsz);
    uint32_t stage = args.w & 0xffu, op = args.w >> 16, n = count[0];
    UKL_COHERENT const uint32_t* vi = (UKL_COHERENT const uint32_t*)in;
    UKL_COHERENT const uint32_t* hi = (UKL_COHERENT const uint32_t*)heads;
    UKL_COHERENT uint32_t* vo = (UKL_COHERENT uint32_t*)out;
    UKL_COHERENT uint32_t* s = (UKL_COHERENT uint32_t*)sums;
    if (stage == 0u) ukl_seg_one(t, op, n, vi, hi, vo, sv, sf __UKL_ARGS);
    if (stage == 1u) ukl_seg_agg(t, op, n, vi, hi, vo, s, sv, sf __UKL_ARGS);
    if (stage == 2u && t.tile == 0u && lid == 0u) ukl_seg_carry(op, (args.w >> 8) & 0xffu, s);
    if (stage == 3u) ukl_seg_out(t, op, n, vi, hi, vo, s, sv, sf __UKL_ARGS);
}

#if UKL_SIMD_WIDTH >= 8
// The sort of `keys`' first `count[0]` by their low `bits` bits (`(w >> 8) & 0xff`), the values their indexes before
// it: stage `w & 0xf`, of digit `(w >> 4) & 0xf`. Stages: 0 the few rows' ranks; 1 the varying bits' sums; 2 their
// answer, by one thread, into `ctl` (0, 1 the bits that vary; 2 the passes so far; 3, the host's, stage 1's tiles); 3 a digit's histograms, where it
// varies; 4 its scatter (the histograms scanned between, by `t_stage_scan`); 5 the passes counted, one thread; 6 the
// rows moved where they end (`ukl_sort_in_input`), where they are not: the few rows' (`w >> 16`: 1) or the passes'.
DEFINE_KERNEL2(tests, t_stage_sort,
               ARGS,     TestArgs, args,    ,
               ROBUFFER, uint32_t, count,   "[1]",
               RWBUFFER, uint32_t, ctl,     "[4]",
               RWBUFFER, uint64_t, keys,    "[n]",
               RWBUFFER, uint32_t, values,  "[n]",
               RWBUFFER, uint64_t, keys2,   "[n]",
               RWBUFFER, uint32_t, values2, "[n]",
               RWBUFFER, uint32_t, hist,    "[256 * n + 1]",
               RWBUFFER, uint32_t, sums,    "[4 * 256 + 4]",
               SHARED,   uint32_t, h,       UKL_RADIX_DIGITS,
               SHARED,   uint32_t, counts,  UKL_RADIX_GROUPS * UKL_RADIX_DIGITS,
               SHARED,   uint32_t, before,  UKL_RADIX_DIGITS,
               SHARED,   uint32_t, base,    UKL_RADIX_DIGITS,
               SHARED,   uint32_t, digits,  UKL_RADIX_SPILL,
               SHARED,   uint32_t, tile,    UKL_SORT_TILE_WORDS,
               SHARED,   uint32_t, scratch, UKL_TG_SCRATCH,
               GSZ0,     uint32_t, gsz,     ,
               TGID0,    uint32_t, group,   ,
               LID0,     uint32_t, lid,     ,
               LSZ0,     uint32_t, lsz,     )
{
    UklTiles t = test_tiles(gsz, group, lid, lsz);
    UklSortLocal l;
    l.h = h; l.counts = counts; l.before = before; l.base = base; l.digits = digits; l.tile = tile;
    uint32_t stage = args.w & 0xfu, d = (args.w >> 4) & 0xfu, bits = (args.w >> 8) & 0xffu, n = count[0];
    UKL_COHERENT uint64_t* k1 = (UKL_COHERENT uint64_t*)keys;
    UKL_COHERENT uint32_t* v1 = (UKL_COHERENT uint32_t*)values;
    UKL_COHERENT uint64_t* k2 = (UKL_COHERENT uint64_t*)keys2;
    UKL_COHERENT uint32_t* v2 = (UKL_COHERENT uint32_t*)values2;
    UKL_COHERENT uint32_t* c = (UKL_COHERENT uint32_t*)ctl;
    uint64_t vary = ((uint64_t)c[0] << 32) | (uint64_t)c[1];
    bool varies = ((vary >> (8u * d)) & 0xffu) != 0u, even = c[2] % 2u == 0u;
    if (stage == 0u) ukl_sort_rank(t, n, bits, true, k1, v1, k2, v2, l);
    if (stage == 1u) ukl_sort_vary(t, n, bits, true, k1, v1, (UKL_COHERENT uint32_t*)sums, scratch __UKL_ARGS);
    if (stage == 2u && t.tile == 0u && lid == 0u) {
        uint64_t v = ukl_sort_varying(c[3], (UKL_COHERENT uint32_t*)sums);
        c[0] = (uint32_t)(v >> 32); c[1] = (uint32_t)v; c[2] = 0u;
    }
    if (stage == 3u && varies) ukl_sort_hist(t, n, d, even ? k1 : k2, (UKL_COHERENT uint32_t*)hist, l);
    if (stage == 4u && varies) ukl_sort_scatter(t, n, d, even ? k1 : k2, even ? v1 : v2, (UKL_COHERENT uint32_t*)hist, even ? k2 : k1, even ? v2 : v1, l __UKL_ARGS);
    if (stage == 5u && varies && t.tile == 0u && lid == 0u) c[2] = c[2] + 1u;
    if (stage == 6u) {
        // In the second buffers: the few rows', or an odd count of passes'.
        bool second = (args.w >> 16) != 0u || !even;
        if (second == ukl_sort_in_input(bits)) ukl_sort_back(t, n, second, k1, v1, k2, v2);
    }
}
#endif

// ukl/dot.h: each dot product, the backend's form and the reference, on `a[i]`, `b[i]` and `c[i]` (the accumulator:
// an i32, a u32 or an f32's bits); and the f16 conversion of `i`'s low 16 bits, the backend's and the reference's.
DEFINE_KERNEL2(tests, t_dot,
               ARGS,     TestArgs, args, ,
               ROBUFFER, uint32_t, a,    "[n]",
               ROBUFFER, uint32_t, b,    "[n]",
               ROBUFFER, uint32_t, c,    "[n]",
               RWBUFFER, uint32_t, out,  "[n * 10]",
               GID0,     uint32_t, i,    )
{
    if (i >= args.n)
        return;
    uint32_t x = a[i], y = b[i], z = c[i];
    float zf = reinterpretIntAsFloat((int32_t)z);
    RWBUFFER(uint32_t) o = out + i * 10u;
    o[0] = (uint32_t)ukl_dot4_i8(x, y, (int32_t)z);
    o[1] = (uint32_t)ukl_dot4_i8_ref(x, y, (int32_t)z);
    o[2] = ukl_dot4_u8(x, y, z);
    o[3] = ukl_dot4_u8_ref(x, y, z);
    o[4] = (uint32_t)reinterpretFloatAsInt(ukl_dot2_f16(x, y, zf));
    o[5] = (uint32_t)reinterpretFloatAsInt(ukl_dot2_f16_ref(x, y, zf));
    o[6] = (uint32_t)reinterpretFloatAsInt(ukl_dot2_bf16(x, y, zf));
    o[7] = (uint32_t)reinterpretFloatAsInt(ukl_dot2_bf16_ref(x, y, zf));
    o[8] = (uint32_t)reinterpretFloatAsInt(ukl_f16_to_f32(i & 0xffffu));
    o[9] = (uint32_t)reinterpretFloatAsInt(ukl_f16_to_f32_ref(i & 0xffffu));
}
