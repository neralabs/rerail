# Every text file checks out with the LF line ends it is stored with, on every platform. Git for Windows sets
# core.autocrlf=true by default, which checked text out as CRLF: every pack README then failed the README and structure
# checks, as did the tests that read a checkout's bytes. A file stored with CRLF (a few test fixtures) keeps it: Git
# converts nothing in a file whose stored form already holds a CR. Later lines win, so the -text lines below still
# apply, and keep the model's files byte for byte.
* text=auto eol=lf

# Binaries are stored in Git LFS: install git-lfs before cloning (CONTRIBUTING.md). CI pulls them through
# .github/actions/lfs.
model/model.safetensors filter=lfs diff=lfs merge=lfs -text
# The model's manifest pins each file's SHA-256 and the engine refuses a model that differs, so no checkout may rewrite
# these files' line ends (Git for Windows converts text to CRLF by default).
model/config.json -text
model/tokenizer.json -text
native/src/code_rule_dsl/value/names/names.bin filter=lfs diff=lfs merge=lfs -text
native/grammars/*/src/parser.generated.c.gz filter=lfs diff=lfs merge=lfs -text

# Packs' expected findings and the upstream test cases copied beside them: generated or vendored data that GitHub
# collapses in reviews and leaves out of language statistics.
packs/*/upstream/**/*.expected.json linguist-generated=true
packs/*/upstream/*/fixtures/** linguist-vendored=true
packs/*/upstream/*/tests/** linguist-vendored=true
