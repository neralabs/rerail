// data-layer-serverplan-quality's relational clauses in Rerail logic, on the final shape's path.
//
// The policy below holds each clause's anchor: a forbid clause whose matcher finds the nodes a violation can
// be reported at, with the clause's code and message. The rules give the violations; they replace the
// one-line rule the policy's forbid clause would give. An `ast` atom that is no clause's matcher is a helper
// of the wave. Rules read the base relations as bound: `core_node(d, t, n)` turns a matched tape node `t`
// into the syntax node `n` that `node`, `text`, `child` and `field` key on.
//
// Source: the relational clauses of gate/data-layer/final-shape/data-layer-serverplan-quality.json
// (the PIAT port of nera-data-layer serverplan_quality).

.policy {"format": "rerail.policy/v1", "id": "data-layer-serverplan-quality-logic", "revision": 1, "mode": "block", "description": "serverplan_quality's relational clauses in Rerail logic: anchor clauses here, violations in the rules.", "scope": {"include": ["**/*.py"], "exclude": ["**/.git/**", "**/.venv/**", "**/venv/**", "**/tmp/**", "**/__pycache__/**"]}, "clauses": [{"id": "shared", "define": {"options": {"oracleAnalyzer": {"type": "boolean", "default": false}, "entryPoint": {"type": "string", "default": "all"}}, "language": "python"}}, {"id": "spq-vector-filter-constants", "forbid": {"ast": {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "identifier"}, {"pattern": "$NAME"}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/intent_vector_query\\.py)$"}}, {"any": [{"all": [{"nthChild": {"position": 1, "ofRule": {"all": [{"not": {"kind": "comment"}}, {"not": {"kind": "keyword_argument"}}, {"not": {"kind": "list_splat"}}, {"not": {"kind": "dictionary_splat"}}]}}}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:QueryFilter)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:QueryFilter)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}], "stopBy": "neighbor", "field": "arguments"}}], "stopBy": "neighbor"}}]}, {"inside": {"all": [{"kind": "keyword_argument"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:column)$"}], "stopBy": "neighbor", "field": "name"}}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:QueryFilter)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:QueryFilter)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}], "stopBy": "neighbor", "field": "arguments"}}], "stopBy": "neighbor"}}], "stopBy": "neighbor", "field": "value"}}]}, {"inside": {"all": [{"kind": "module"}, {"regex": "QueryFilter"}], "stopBy": "end"}}]}, "file": {"$option": "entryPoint", "cases": {"_check_vector_scope_filters_use_expressions": {"path": {"regex": "(?s).*"}}, "_check_serverplan_quality_source": {"path": {"regex": "(?s).*"}}, "all": {"$option": "oracleAnalyzer", "cases": {"true": {"path": {"regex": "(?s).*"}}, "false": {"path": {"regex": "^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$|^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$)", "notRegex": "(?:^|/)__init__\\.py$"}}}}}, "default": {"path": {"regex": "\\b\\B"}}}}}, "violation": {"code": "SPQ-042", "message": "Architecture contract violation", "anchor": "witness.span"}}]}

// ---- spq-vector-filter-constants (SPQ-042) ----
// A QueryFilter column named by a module constant whose (latest) value is "branch_id" or "revision_id".
// The SQL took the constant's last string assignment per name (max start); here a flagged assignment that
// a later one to the same name supersedes does not count.

// Module-level `NAME = "<string>"` in the file: the name's text and the assignment's start.
.decl constant(d: int, s: sym, b: int)
constant($D, $S, $B) :- ast($D, $T, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "identifier"}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/intent_vector_query\\.py)$"}}, {"inside": {"all": [{"kind": "assignment"}, {"not": {"has": {"pattern": "$_", "stopBy": "neighbor", "field": "type"}}}, {"has": {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*['\"]"}, {"not": {"inside": {"kind": "concatenated_string", "stopBy": "neighbor"}}}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}, {"not": {"has": {"all": [{"kind": "string"}, {"regex": "(?i)^(?:fr|rf|f)['\"]"}], "stopBy": "end"}}}]}]}], "stopBy": "neighbor", "field": "right"}}, {"inside": {"all": [{"kind": "expression_statement"}, {"inside": {"kind": "module", "stopBy": "neighbor"}}], "stopBy": "neighbor"}}], "stopBy": "neighbor", "field": "left"}}]}}), core_node($D, $T, $N), text($N, $S), node($D, $N, _, $B, _).

// Those whose value is a branch or revision id.
.decl id_constant(d: int, s: sym, b: int)
id_constant($D, $S, $B) :- ast($D, $T, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "identifier"}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/intent_vector_query\\.py)$"}}, {"inside": {"all": [{"kind": "assignment"}, {"not": {"has": {"pattern": "$_", "stopBy": "neighbor", "field": "type"}}}, {"has": {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*['\"]"}, {"not": {"inside": {"kind": "concatenated_string", "stopBy": "neighbor"}}}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}, {"not": {"has": {"all": [{"kind": "string"}, {"regex": "(?i)^(?:fr|rf|f)['\"]"}], "stopBy": "end"}}}]}]}, {"regex": "^[rRuU]*['\"](?:branch_id|revision_id)['\"]$"}], "stopBy": "neighbor", "field": "right"}}, {"inside": {"all": [{"kind": "expression_statement"}, {"inside": {"kind": "module", "stopBy": "neighbor"}}], "stopBy": "neighbor"}}], "stopBy": "neighbor", "field": "left"}}]}}), core_node($D, $T, $N), text($N, $S), node($D, $N, _, $B, _).

.decl superseded(d: int, s: sym, b: int)
superseded($D, $S, $B) :- id_constant($D, $S, $B), constant($D, $S, $C), $C > $B.

violation("data-layer-serverplan-quality-logic", "spq-vector-filter-constants", $D, $T) :-
    ast($D, $T, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "identifier"}, {"pattern": "$NAME"}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/intent_vector_query\\.py)$"}}, {"any": [{"all": [{"nthChild": {"position": 1, "ofRule": {"all": [{"not": {"kind": "comment"}}, {"not": {"kind": "keyword_argument"}}, {"not": {"kind": "list_splat"}}, {"not": {"kind": "dictionary_splat"}}]}}}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:QueryFilter)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:QueryFilter)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}], "stopBy": "neighbor", "field": "arguments"}}], "stopBy": "neighbor"}}]}, {"inside": {"all": [{"kind": "keyword_argument"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:column)$"}], "stopBy": "neighbor", "field": "name"}}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:QueryFilter)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:QueryFilter)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}], "stopBy": "neighbor", "field": "arguments"}}], "stopBy": "neighbor"}}], "stopBy": "neighbor", "field": "value"}}]}, {"inside": {"all": [{"kind": "module"}, {"regex": "QueryFilter"}], "stopBy": "end"}}]}, "file": {"$option": "entryPoint", "cases": {"_check_vector_scope_filters_use_expressions": {"path": {"regex": "(?s).*"}}, "_check_serverplan_quality_source": {"path": {"regex": "(?s).*"}}, "all": {"$option": "oracleAnalyzer", "cases": {"true": {"path": {"regex": "(?s).*"}}, "false": {"path": {"regex": "^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$|^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$)", "notRegex": "(?:^|/)__init__\\.py$"}}}}}, "default": {"path": {"regex": "\\b\\B"}}}}),
    core_node($D, $T, $N), text($N, $S),
    id_constant($D, $S, $B), !superseded($D, $S, $B).
