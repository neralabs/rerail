// data-layer-serverplan-quality's relational clauses in Rerail logic, on the final shape's path.
//
// The policy below holds each clause's anchor: a forbid clause whose matcher finds the nodes a violation can
// be reported at, with the clause's code and message. The rules give the violations; they replace the
// one-line rule the policy's forbid clause would give. An `ast` atom that is no clause's matcher is a helper
// of the wave. Rules read the base relations as bound: `core_node(d, t, n)` turns a matched tape node `t`
// into the syntax node `n` that `node`, `text`, `child` and `field` key on.
//
// Source: the relational clauses of gate/data-layer/final-shape/data-layer-serverplan-quality.json
// (the PIAT port of nera-data-layer serverplan_quality).

.policy {{POLICY}}

// ---- spq-vector-filter-constants (SPQ-042) ----
// A QueryFilter column named by a module constant whose (latest) value is "branch_id" or "revision_id".
// The SQL took the constant's last string assignment per name (max start); here a flagged assignment that
// a later one to the same name supersedes does not count.

// Module-level `NAME = "<string>"` in the file: the name's text and the assignment's start.
.decl constant(d: int, s: sym, b: int)
constant($D, $S, $B) :- ast($D, $T, {{CONSTANT}}), core_node($D, $T, $N), text($N, $S), node($D, $N, _, $B, _).

// Those whose value is a branch or revision id.
.decl id_constant(d: int, s: sym, b: int)
id_constant($D, $S, $B) :- ast($D, $T, {{IDCONSTANT}}), core_node($D, $T, $N), text($N, $S), node($D, $N, _, $B, _).

.decl superseded(d: int, s: sym, b: int)
superseded($D, $S, $B) :- id_constant($D, $S, $B), constant($D, $S, $C), $C > $B.

violation("data-layer-serverplan-quality-logic", "spq-vector-filter-constants", $D, $T) :-
    ast($D, $T, {{ANCHOR042}}),
    core_node($D, $T, $N), text($N, $S),
    id_constant($D, $S, $B), !superseded($D, $S, $B).

// ---- spq-runtime-state-annotations (SPQ-050) ----
// An annotated assignment whose annotation names, as Python resolves the name, `Callable` or a runtime-state
// type (a connection, cursor, transaction, executor, token service or store, hydrator, runtime bundle).
// A name resolves through the imports of its scope chain: the annotation's scope, the functions around it,
// then the module. An atom inside `Literal[...]`, or inside `Annotated[...]` with metadata, does not count
// where the base resolves to typing's (trusted: not shadowed, one origin). `ConnectionId` from the data
// layer's types is no runtime state.
//
// The SQL built each origin as a string (`module.name` + the atom's tail) and matched it with regexes. Here
// an origin is its pieces, the identifiers of its module, imported name or dotted name, and the atom's
// tail: it names Callable where a piece is `Callable`, a runtime-state type where a piece's text holds one
// (no piece holds a dot, so no match spans two). Scopes are byte ranges: the nearest is the innermost.
// Not covered yet: quoted annotations (their atoms, `parse` with the annotation grammar), and a member
// atom's tail naming ConnectionId, Literal or Annotated through a module import other than typing's.

// Scopes: functions (f 1) and classes; a scope is its start byte, the module -1.
.decl def(d: int, x: int, s: int, e: int, f: int)
def($D, $X, $S, $E, 1) :- ast($D, $T, {{FN}}), core_node($D, $T, $X), node($D, $X, _, $S, $E).
def($D, $X, $S, $E, 0) :- ast($D, $T, {{CLS}}), core_node($D, $T, $X), node($D, $X, _, $S, $E).

// The byte ranges whose scope the clause reads, and each one's scope.
.decl ann(d: int, a: int, s: int, e: int)
ann($D, $A, $S, $E) :- ast($D, $T, {{ANCHOR050}}), core_node($D, $T, $A), node($D, $A, _, $S, $E).
.decl from_stmt(d: int, st: int, s: int, e: int)
from_stmt($D, $St, $S, $E) :- ast($D, $T, {{FROM}}), core_node($D, $T, $St), node($D, $St, _, $S, $E).
.decl import_stmt(d: int, st: int, s: int, e: int)
import_stmt($D, $St, $S, $E) :- ast($D, $T, {{IMPORT}}), core_node($D, $T, $St), node($D, $St, _, $S, $E).
.decl binder(d: int, n: int, s: int, e: int, h: sym)
binder($D, $N, $S, $E, $H) :- ast($D, $T, {{BOUND}}), core_node($D, $T, $N), node($D, $N, _, $S, $E), text($N, $H).
.decl param(d: int, n: int, s: int, e: int, h: sym)
param($D, $N, $S, $E, $H) :- ast($D, $T, {{PLAIN_PARAM}}), core_node($D, $T, $N), node($D, $N, _, $S, $E), text($N, $H).
param($D, $N, $S, $E, $H) :- ast($D, $T, {{TYPED_PARAM}}), core_node($D, $T, $N), node($D, $N, _, $S, $E), text($N, $H).

.decl spot(d: int, s: int, e: int)
spot($D, $S, $E) :- ann($D, _, $S, $E).
spot($D, $S, $E) :- from_stmt($D, _, $S, $E).
spot($D, $S, $E) :- import_stmt($D, _, $S, $E).
spot($D, $S, $E) :- binder($D, _, $S, $E, _).
spot($D, $S, $E) :- param($D, _, $S, $E, _).
spot($D, $S, $E) :- def($D, _, $S, $E, _).
.decl around(d: int, s: int, e: int, x: int)
around($D, $S, $E, $X) :- spot($D, $S, $E), def($D, _, $X, $XE, _), $X < $S, $XE >= $E.
.decl outer(d: int, s: int, e: int, x: int)
outer($D, $S, $E, $X) :- around($D, $S, $E, $X), around($D, $S, $E, $Y), $Y > $X.
.decl enclosed(d: int, s: int, e: int)
enclosed($D, $S, $E) :- around($D, $S, $E, _).
.decl scope_at(d: int, s: int, e: int, x: int)
scope_at($D, $S, $E, $X) :- around($D, $S, $E, $X), !outer($D, $S, $E, $X).
scope_at($D, $S, $E, -1) :- spot($D, $S, $E), !enclosed($D, $S, $E).

// An annotation's scope, and the scopes its names are looked up in: its own, the functions around it
// (a class's scope is not seen from inside its methods), the module.
.decl ann_scope(d: int, a: int, x: int)
ann_scope($D, $A, $X) :- ann($D, $A, $S, $E), scope_at($D, $S, $E, $X).
.decl chain(d: int, x: int, y: int)
chain($D, $X, $X) :- ann_scope($D, _, $X).
chain($D, $X, -1) :- ann_scope($D, _, $X).
chain($D, $X, $F) :- ann_scope($D, _, $X), def($D, _, $X, $XE, _), def($D, _, $F, $FE, 1), $F < $X, $FE >= $XE.

// Names bound in a scope other than by an import: assignments and the like, parameters, definitions,
// `global` (at the module).
.decl shadow(d: int, x: int, h: sym)
shadow($D, $X, $H) :- binder($D, _, $S, $E, $H), scope_at($D, $S, $E, $X).
shadow($D, $X, $H) :- param($D, _, $S, $E, $H), scope_at($D, $S, $E, $X).
// (A definition's name is a relation of its own: in one rule with scope_at, the planner scanned every
// first child in the chunk and joined scope_at to each.)
.decl def_name(d: int, s: int, e: int, h: sym)
def_name($D, $S, $E, $H) :- def($D, $N, $S, $E, _), child($N, $I, 0), text($I, $H).
shadow($D, $X, $H) :- def_name($D, $S, $E, $H), scope_at($D, $S, $E, $X).
shadow($D, -1, $H) :- ast($D, $T, {{GLOBAL}}), core_node($D, $T, $N), text($N, $H).
// `nonlocal` binds the name in each function around the statement.
shadow($D, $F, $H) :- ast($D, $T, {{NONLOCAL}}), core_node($D, $T, $N), text($N, $H), node($D, $N, _, $S, $E), def($D, _, $F, $FE, 1), $F < $S, $FE >= $E.

// Imports: each binding identifier, its statement and name; the byte ranges of its origin's pieces.
.decl aliased(d: int, n: int)
aliased($D, $N) :- ast($D, $T, {{ALIASED}}), core_node($D, $T, $N).
.decl bind(d: int, b: int, st: int, h: sym)
.decl origin_in(d: int, b: int, s: int, e: int)
.decl imported(d: int, b: int, h: sym)
.decl direct(d: int, b: int)
// from m import name
bind($D, $B, $St, $H) :- from_stmt($D, $St, _, _), child($St, $En, $I), $I > 0, !aliased($D, $En), child($En, $B, 0), text($B, $H).
imported($D, $B, $H) :- from_stmt($D, $St, _, _), child($St, $En, $I), $I > 0, !aliased($D, $En), child($En, $B, 0), text($B, $H).
origin_in($D, $B, $S, $E) :- from_stmt($D, $St, _, _), child($St, $En, $I), $I > 0, !aliased($D, $En), child($En, $B, 0), node($D, $En, _, $S, $E).
// from m import name as alias
bind($D, $B, $St, $H) :- from_stmt($D, $St, _, _), child($St, $En, $I), $I > 0, aliased($D, $En), child($En, $B, 1), text($B, $H).
imported($D, $B, $H) :- from_stmt($D, $St, _, _), child($St, $En, $I), $I > 0, aliased($D, $En), child($En, $B, 1), child($En, $Dn, 0), child($Dn, $J, 0), text($J, $H).
origin_in($D, $B, $S, $E) :- from_stmt($D, $St, _, _), child($St, $En, $I), $I > 0, aliased($D, $En), child($En, $B, 1), child($En, $Dn, 0), node($D, $Dn, _, $S, $E).
// ... and the module
origin_in($D, $B, $S, $E) :- bind($D, $B, $St, _), from_stmt($D, $St, _, _), child($St, $M, 0), node($D, $M, _, $S, $E).
// import a.b (binds a, whose origin is a)
bind($D, $B, $St, $H) :- import_stmt($D, $St, _, _), child($St, $En, _), !aliased($D, $En), child($En, $B, 0), text($B, $H).
direct($D, $B) :- import_stmt($D, $St, _, _), child($St, $En, _), !aliased($D, $En), child($En, $B, 0).
origin_in($D, $B, $S, $E) :- direct($D, $B), node($D, $B, _, $S, $E).
// import a.b as alias (origin a.b)
bind($D, $B, $St, $H) :- import_stmt($D, $St, _, _), child($St, $En, _), aliased($D, $En), child($En, $B, 1), text($B, $H).
origin_in($D, $B, $S, $E) :- import_stmt($D, $St, _, _), child($St, $En, _), aliased($D, $En), child($En, $B, 1), child($En, $Dn, 0), node($D, $Dn, _, $S, $E).

.decl stmt_scope(d: int, st: int, x: int)
stmt_scope($D, $St, $X) :- from_stmt($D, $St, $S, $E), scope_at($D, $S, $E, $X).
stmt_scope($D, $St, $X) :- import_stmt($D, $St, $S, $E), scope_at($D, $S, $E, $X).

// An origin's module, where it is one or two identifiers.
.decl long(m: int, i: int)
long($M, $I) :- child($M, _, $I).
.decl module1(d: int, b: int, m: sym)
module1($D, $B, $Mt) :- bind($D, $B, $St, _), from_stmt($D, $St, _, _), child($St, $M, 0), child($M, $J, 0), text($J, $Mt), !long($M, 1).
.decl module2(d: int, b: int, m: sym, n: sym)
module2($D, $B, $M1, $M2) :- bind($D, $B, $St, _), from_stmt($D, $St, _, _), child($St, $M, 0), child($M, $J, 0), text($J, $M1), child($M, $K, 1), text($K, $M2), !long($M, 2).

// The pieces that name Callable or a runtime-state type.
.decl callable_piece(d: int, s: int, e: int)
callable_piece($D, $S, $E) :- ast($D, $T, {{CALLABLE_IDENT}}), core_node($D, $T, $N), node($D, $N, _, $S, $E).
.decl service_piece(d: int, s: int, e: int)
service_piece($D, $S, $E) :- ast($D, $T, {{SERVICE_IDENT}}), core_node($D, $T, $N), node($D, $N, _, $S, $E).
.decl bind_callable(d: int, b: int)
bind_callable($D, $B) :- origin_in($D, $B, $S, $E), callable_piece($D, $PS, $PE), $PS >= $S, $PE <= $E.
.decl bind_service(d: int, b: int)
bind_service($D, $B) :- origin_in($D, $B, $S, $E), service_piece($D, $PS, $PE), $PS >= $S, $PE <= $E.

// Origins named exactly: typing's Literal and Annotated, the data layer's ConnectionId.
.decl literal_origin(d: int, b: int)
literal_origin($D, $B) :- imported($D, $B, "Literal"), module1($D, $B, "typing").
literal_origin($D, $B) :- imported($D, $B, "Literal"), module1($D, $B, "typing_extensions").
.decl annotated_origin(d: int, b: int)
annotated_origin($D, $B) :- imported($D, $B, "Annotated"), module1($D, $B, "typing").
annotated_origin($D, $B) :- imported($D, $B, "Annotated"), module1($D, $B, "typing_extensions").
.decl typing_module(d: int, b: int)
typing_module($D, $B) :- direct($D, $B), text($B, "typing").
typing_module($D, $B) :- direct($D, $B), text($B, "typing_extensions").
// The data layer's types modules, and a binding whose origin is one: `import m` (a two-identifier module
// binds its first) or `import m as alias`.
.decl types_module(m: sym)
types_module("l1350_foundational_types").
types_module("l1400_types").
.decl connection_id(d: int, b: int)
connection_id($D, $B) :- imported($D, $B, "ConnectionId"), module2($D, $B, "data_layer", "types").
connection_id($D, $B) :- imported($D, $B, "ConnectionId"), module1($D, $B, $M), types_module($M).
.decl alias_origin1(d: int, b: int, m: sym)
alias_origin1($D, $B, $M) :- import_stmt($D, $St, _, _), child($St, $En, _), aliased($D, $En), child($En, $B, 1), child($En, $Dn, 0), child($Dn, $J, 0), text($J, $M), !long($Dn, 1).
.decl alias_origin2(d: int, b: int, m: sym, n: sym)
alias_origin2($D, $B, $M1, $M2) :- import_stmt($D, $St, _, _), child($St, $En, _), aliased($D, $En), child($En, $B, 1), child($En, $Dn, 0), child($Dn, $J, 0), text($J, $M1), child($Dn, $K, 1), text($K, $M2), !long($Dn, 2).

// An annotation's atoms: the atom's node, its head name, and whether it is a member (m 1).
.decl head(d: int, s: int, h: sym)
head($D, $S, $H) :- ast($D, $T, {{HEAD}}), core_node($D, $T, $N), node($D, $N, _, $S, _), text($N, $H).
.decl atom(d: int, a: int, n: int, h: sym, m: int)
atom($D, $A, $N, $H, 0) :- ast($D, $T, {{NAME_ATOM}}), core_node($D, $T, $N), text($N, $H), node($D, $N, _, $S, $E), ann($D, $A, $AS, $AE), $S >= $AS, $E <= $AE.
atom($D, $A, $N, $H, 1) :- ast($D, $T, {{MEMBER_ATOM}}), core_node($D, $T, $N), node($D, $N, _, $S, $E), head($D, $S, $H), ann($D, $A, $AS, $AE), $S >= $AS, $E <= $AE.
// A member atom's tail (after its head) names Callable or a runtime-state type; any atom's text does.
.decl tail_callable(d: int, n: int)
tail_callable($D, $N) :- atom($D, _, $N, _, 1), node($D, $N, _, $S, $E), callable_piece($D, $PS, $PE), $PS > $S, $PE <= $E.
.decl tail_service(d: int, n: int)
tail_service($D, $N) :- atom($D, _, $N, _, 1), node($D, $N, _, $S, $E), service_piece($D, $PS, $PE), $PS > $S, $PE <= $E.
.decl text_callable(d: int, n: int)
text_callable($D, $N) :- atom($D, _, $N, _, _), node($D, $N, _, $S, $E), callable_piece($D, $PS, $PE), $PS >= $S, $PE <= $E.
.decl text_service(d: int, n: int)
text_service($D, $N) :- atom($D, _, $N, _, _), node($D, $N, _, $S, $E), service_piece($D, $PS, $PE), $PS >= $S, $PE <= $E.

// Resolution: the imports of the atom's head in the nearest scope of the chain that has one.
.decl visible(d: int, a: int, n: int, x: int, b: int)
visible($D, $A, $N, $X, $B) :- atom($D, $A, $N, $H, _), ann_scope($D, $A, $Y), chain($D, $Y, $X), bind($D, $B, $St, $H), stmt_scope($D, $St, $X).
.decl nearer(d: int, a: int, n: int, x: int)
nearer($D, $A, $N, $X) :- visible($D, $A, $N, $X, _), visible($D, $A, $N, $Z, _), $Z > $X.
.decl resolved(d: int, a: int, n: int, x: int, b: int)
resolved($D, $A, $N, $X, $B) :- visible($D, $A, $N, $X, $B), !nearer($D, $A, $N, $X).
.decl bound(d: int, a: int, n: int)
bound($D, $A, $N) :- resolved($D, $A, $N, _, _).
// Trusted: no other binding of the head in the chain between the annotation and the import, and one import.
.decl shadowed(d: int, a: int, n: int)
shadowed($D, $A, $N) :- resolved($D, $A, $N, $X, _), atom($D, $A, $N, $H, _), ann_scope($D, $A, $Y), chain($D, $Y, $Z), $Z >= $X, shadow($D, $Z, $H).
.decl ambiguous(d: int, a: int, n: int)
ambiguous($D, $A, $N) :- resolved($D, $A, $N, _, $B), resolved($D, $A, $N, _, $C), $B != $C.
.decl trusted(d: int, a: int, n: int, b: int)
trusted($D, $A, $N, $B) :- resolved($D, $A, $N, _, $B), !shadowed($D, $A, $N), !ambiguous($D, $A, $N).

// What an atom names.
.decl names_callable(d: int, a: int, n: int)
names_callable($D, $A, $N) :- resolved($D, $A, $N, _, $B), bind_callable($D, $B).
names_callable($D, $A, $N) :- resolved($D, $A, $N, _, _), tail_callable($D, $N).
names_callable($D, $A, $N) :- atom($D, $A, $N, _, _), !bound($D, $A, $N), text_callable($D, $N).
// ConnectionId from the data layer's types: imported by name, or a member of the module.
.decl exempt(d: int, a: int, n: int)
exempt($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, _, 0), connection_id($D, $B).
// m.ConnectionId: `import m` or `import m as alias`
exempt($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, $M, 1), direct($D, $B), types_module($M), child($N, $O, 0), text($O, _), child($N, $L, 1), text($L, "ConnectionId").
exempt($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, _, 1), alias_origin1($D, $B, $M), types_module($M), child($N, $O, 0), text($O, _), child($N, $L, 1), text($L, "ConnectionId").
// data_layer.types.ConnectionId: `import data_layer.types`, or `import data_layer.types as alias` and alias.ConnectionId
exempt($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, "data_layer", 1), direct($D, $B), child($N, $O, 0), child($O, $I, 0), text($I, "data_layer"), child($O, $J, 1), text($J, "types"), child($N, $L, 1), text($L, "ConnectionId").
exempt($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, _, 1), alias_origin2($D, $B, "data_layer", "types"), child($N, $O, 0), text($O, _), child($N, $L, 1), text($L, "ConnectionId").
.decl names_service(d: int, a: int, n: int)
names_service($D, $A, $N) :- resolved($D, $A, $N, _, $B), bind_service($D, $B), !exempt($D, $A, $N).
names_service($D, $A, $N) :- resolved($D, $A, $N, _, _), tail_service($D, $N), !exempt($D, $A, $N).
names_service($D, $A, $N) :- atom($D, $A, $N, _, _), !bound($D, $A, $N), text_service($D, $N).

// Literal[...]'s arguments and Annotated[...]'s metadata (its arguments after the first), where the base
// is typing's: atoms inside do not count.
.decl literal_base(d: int, a: int, n: int)
literal_base($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, _, 0), literal_origin($D, $B).
literal_base($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, _, 1), typing_module($D, $B), child($N, $L, 1), text($L, "Literal").
.decl annotated_base(d: int, a: int, n: int)
annotated_base($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, _, 0), annotated_origin($D, $B).
annotated_base($D, $A, $N) :- trusted($D, $A, $N, $B), atom($D, $A, $N, _, 1), typing_module($D, $B), child($N, $L, 1), text($L, "Annotated").
.decl generic(d: int, g: int)
generic($D, $G) :- ast($D, $T, {{GENERIC}}), core_node($D, $T, $G).
.decl inert(d: int, a: int, s: int, e: int)
inert($D, $A, $S, $E) :- generic($D, $G), child($G, $N, 0), literal_base($D, $A, $N), child($G, $P, 1), child($P, $R, _), node($D, $R, _, $S, $E).
inert($D, $A, $S, $E) :- generic($D, $G), child($G, $N, 0), annotated_base($D, $A, $N), child($G, $P, 1), child($P, $R, $I), $I > 0, node($D, $R, _, $S, $E).
.decl ignored(d: int, a: int, n: int)
ignored($D, $A, $N) :- atom($D, $A, $N, _, _), node($D, $N, _, $S, $E), inert($D, $A, $IS, $IE), $S >= $IS, $E <= $IE.

violation("data-layer-serverplan-quality-logic", "spq-runtime-state-annotations", $D, $T) :-
    ast($D, $T, {{ANCHOR050}}), core_node($D, $T, $A), names_callable($D, $A, $N), !ignored($D, $A, $N).
violation("data-layer-serverplan-quality-logic", "spq-runtime-state-annotations", $D, $T) :-
    ast($D, $T, {{ANCHOR050}}), core_node($D, $T, $A), names_service($D, $A, $N), !ignored($D, $A, $N).
