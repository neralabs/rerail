+    /// Render one family scope from the indexed logical graph. Physical boundaries stop
+    /// traversal; family members keep their definitions and earlier owners become views.
+    pub fn render_cuts(
+        &self,
+        body: &str,
+        physical: &BTreeSet<String>,
+        members: &BTreeSet<&str>,
+        aliases: &HashMap<String, String>,
+        extra: &[String],
+    ) -> String {
+        let mut pending: Vec<_> = tokens(body)
+            .chain(extra.iter().flat_map(|sql| tokens(sql)))
+            .filter_map(|t| self.names.get(t).copied())
+            .collect();
+        let mut seen = BTreeSet::new();
+        while let Some(index) = pending.pop() {
+            if seen.insert(index) {
+                let name = self.entries[index]
+                    .sql
+                    .split_once('(')
+                    .expect("generated columns")
