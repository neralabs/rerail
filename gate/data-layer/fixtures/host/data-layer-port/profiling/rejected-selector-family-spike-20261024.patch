+//! Parameterize compatible generated scalar SELECTs. Values remain typed SQLite bindings.
+use std::sync::LazyLock;
+
+#[derive(Clone)]
+pub(super) struct Template {
+    pub key: String,
+    projection: String,
+    tail: String,
+    parameters: Vec<String>,
+}
+
+pub(super) fn template(cte: &str) -> Option<Template> {
+    let body = cte.split_once(" AS ")?.1;
+    let body = body
+        .strip_prefix("MATERIALIZED (")
+        .or_else(|| body.strip_prefix("NOT MATERIALIZED ("))?
+        .strip_suffix(')')?;
+    if !body.starts_with("SELECT ") || body.starts_with("SELECT DISTINCT ") {
+        return None;
+    }
+    // This compiler-owned subset has no nested SELECT, grouping, choice, set operator,
+    // ordering or window. Their domains and duplicate behavior need separate operators.
+    let upper = body[7..].to_ascii_uppercase();
+    if [
+        "SELECT ",
+        " UNION ",
+        " INTERSECT ",
+        " EXCEPT ",
+        " GROUP ",
+        " HAVING ",
+        " LIMIT ",
+        " ORDER ",
+        " OVER",
+        "WITH ",
+    ]
+    .iter()
+    .any(|s| upper.contains(s))
+    {
+        return None;
+    }
+    let lower = body
+        .chars()
+        .filter(|c| !c.is_whitespace())
+        .collect::<String>()
+        .to_ascii_lowercase();
+    if [
+        "count(",
+        "sum(",
+        "min(",
+        "max(",
+        "avg(",
+        "total(",
+        "group_concat(",
+        "string_agg(",
+        "json_group",
+    ]
+    .iter()
+    .any(|name| lower.contains(name))
+    {
+        return None;
+    }
+    static PARAMETERS: LazyLock<regex::Regex> =
+        LazyLock::new(|| regex::Regex::new(r"\?[0-9]+").expect("generated parameter"));
+    let mut parameters = Vec::new();
+    let mut key = String::new();
+    let mut start = 0;
+    for p in PARAMETERS.find_iter(body) {
+        key.push_str(&body[start..p.start()]);
+        key.push_str(&format!("rr_input.p{}", parameters.len()));
+        parameters.push(p.as_str().to_owned());
+        start = p.end();
+    }
+    if parameters.is_empty() {
+        return None;
+    }
+    key.push_str(&body[start..]);
+    let (projection, tail) = key.strip_prefix("SELECT ")?.split_once(" FROM ")?;
+    Some(Template {
+        projection: projection.into(),
+        tail: tail.into(),
+        parameters,
+        key,
+    })
+}
+
+/// One SQL operator reads a producer-qualified request matrix. There is no host key loop.
+pub(super) fn render(members: &[(usize, &Template)], id: usize) -> (String, String) {
+    let first = members[0].1;
+    let name = format!("selector_args_{id}");
+    let columns = std::iter::once("producer".to_owned())
+        .chain((0..first.parameters.len()).map(|i| format!("p{i}")))
+        .collect::<Vec<_>>()
+        .join(",");
+    let values = members
+        .iter()
+        .map(|(slot, t)| format!("({slot},{})", t.parameters.join(",")))
+        .collect::<Vec<_>>()
+        .join(",");
+    (
+        format!("{name}({columns}) AS MATERIALIZED (VALUES {values})"),
+        format!(
+            "SELECT rr_input.producer,{} FROM {name} rr_input CROSS JOIN {}",
+            first.projection, first.tail
+        ),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::super::render::Definitions;
+    use super::super::{Stage, pack};
+    use super::*;
+    use rusqlite::{Connection, Result, params_from_iter, types::Value};
+    #[test]
+    fn aggregate_choice_window_set_and_nested_domains_do_not_enter_scalar_fusion() {
+        for body in [
+            "SELECT fid,max(pre) FROM input WHERE pre=?1",
+            "SELECT fid,COUNT (pre) FROM input WHERE pre=?1",
+            "SELECT DISTINCT fid,pre FROM input WHERE pre=?1",
+            "SELECT fid,pre FROM input WHERE pre=?1 LIMIT 1",
+            "SELECT fid,pre FROM input WHERE pre=?1 ORDER BY pre",
+            "SELECT fid,pre FROM input WHERE pre=?1 UNION SELECT fid,pre FROM input",
+            "SELECT fid,pre FROM input WHERE EXISTS(select 1 FROM other WHERE pre=?1)",
+            "SELECT fid,max(pre) OVER () FROM input WHERE pre=?1",
+        ] {
+            assert!(
+                template(&format!("a(fid,pre) AS MATERIALIZED ({body})")).is_none(),
+                "{body}"
+            );
+        }
+    }
+    #[test]
+    fn one_scalar_operator_preserves_typed_requests_null_absence_and_projection_names() -> Result<()>
+    {
+        for affinity in ["", "TEXT"] {
+            let db = Connection::open_in_memory()?;
+            db.execute_batch(&format!("CREATE TABLE input(fid INTEGER,pre INTEGER,value {affinity});INSERT INTO input VALUES(1,10,7),(1,11,'7'),(1,12,NULL)"))?;
+            let mut graph = Vec::new();
+            let mut stages = Vec::new();
+            for (i, name) in ["a", "b", "c"].iter().enumerate() {
+                let body = format!("SELECT s.fid,s.pre+0 FROM input s WHERE s.value=?{}", i + 1);
+                graph.push(format!("{name}(fid,pre) AS MATERIALIZED ({body})"));
+                stages.push(Stage {
+                    name: (*name).into(),
+                    sql: format!("CREATE TEMP TABLE \"{name}\" AS SELECT fid,pre FROM {name}"),
+                    index: Some("fid,pre"),
+                    temporary: true,
+                    covering: false,
+                });
+            }
+            let p=pack(stages,vec!["SELECT 0,fid,pre FROM a UNION ALL SELECT 1,fid,pre FROM b UNION ALL SELECT 2,fid,pre FROM c ORDER BY 1,2,3".into()],&graph,&Definitions::new(graph.iter().cloned()));
+            assert_eq!(p.stages.len(), 1);
+            assert_eq!(p.stages[0].sql.matches("input s").count(), 1);
+            db.execute(
+                &p.stages[0].sql,
+                params_from_iter([Value::Integer(7), Value::Text("7".into()), Value::Null]),
+            )?;
+            let rows = db
+                .prepare(&p.queries[0])?
+                .query_map([], |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(2)?)))?
+                .collect::<Result<Vec<_>>>()?;
+            assert_eq!(
+                rows,
+                if affinity.is_empty() {
+                    vec![(0, 10), (1, 11)]
+                } else {
+                    vec![(0, 10), (0, 11), (1, 10), (1, 11)]
+                }
+            );
+        }
+        Ok(())
+    }
+}
