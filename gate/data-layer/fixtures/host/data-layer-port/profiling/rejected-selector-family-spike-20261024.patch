--- /dev/null
+++ b/scripts/profiling/preparation/src/compiler.rs
@@ -0,0 +1,75 @@
+//! Re-render captured candidate programs with the production physical planner; SQLite executes the result.
+use crate::{families, lifetime, render::Definitions};
+use serde_json::{Value, json};
+use std::path::Path;
+pub fn repack(
+    capture: &Path,
+    graph: &Path,
+    output: &Path,
+) -> Result<(), Box<dyn std::error::Error>> {
+    let mut data: Value = serde_json::from_slice(&std::fs::read(capture)?)?;
+    let graph: Vec<String> = serde_json::from_slice(&std::fs::read(graph)?)?;
+    let stages = data["stages"]
+        .as_array()
+        .ok_or("missing stages")?
+        .iter()
+        .map(|s| {
+            let index = match s["index"].as_str() {
+                None => None,
+                Some("fid,pre") => Some("fid,pre"),
+                Some("fid") => Some("fid"),
+                _ => return Err("unsupported captured index"),
+            };
+            Ok(families::Stage {
+                name: s["name"].as_str().ok_or("missing name")?.into(),
+                sql: s["sql"].as_str().ok_or("missing SQL")?.into(),
+                index,
+                temporary: s["temporary"] == true,
+                covering: false,
+            })
+        })
+        .collect::<Result<Vec<_>, &str>>()?;
+    let queries: Vec<String> = serde_json::from_value(data["queries"].clone())?;
+    let packed = families::pack(
+        stages,
+        queries,
+        &graph,
+        &Definitions::new(graph.iter().cloned()),
+    );
+    let schedule = lifetime::Schedule::new(
+        &packed
+            .stages
+            .iter()
+            .map(|s| lifetime::Input {
+                name: &s.name,
+                sql: &s.sql,
+                temporary: s.temporary,
+            })
+            .collect::<Vec<_>>(),
+        &packed.queries,
+    );
+    let parent = output.parent().ok_or("output needs parent")?;
+    std::fs::create_dir_all(parent)?;
+    let database = capture
+        .parent()
+        .ok_or("capture needs parent")?
+        .join(data["database"].as_str().ok_or("missing database")?);
+    let copy = parent.join("compiler-input.sqlite");
+    if !copy.exists() {
+        std::fs::copy(database, &copy)?;
+    }
+    data["database"] = "compiler-input.sqlite".into();
+    data["stages"] = json!(
+        packed
+            .stages
+            .iter()
+            .map(|s| json!({"name":s.name,"sql":s.sql,"index":s.index,"temporary":s.temporary}))
+            .collect::<Vec<_>>()
+    );
+    data["queries"] = json!(packed.queries);
+    data["selectorOwners"] = json!(packed.owners);
+    data["schedule"] = json!(schedule.actions);
+    data["peakLiveRelations"] = json!(schedule.peak_relations);
+    std::fs::write(output, serde_json::to_vec_pretty(&data)?)?;
+    Ok(())
+}
