@@ -0,0 +1,617 @@
+//! Pack independent keyed selectors into SQL-owned, producer-qualified physical families.
+use super::{lifetime, render::Definitions, waves};
+#[path = "families/flat.rs"]
+mod flat;
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+
+#[derive(Clone)]
+pub struct Stage {
+    pub name: String,
+    pub sql: String,
+    pub index: Option<&'static str>,
+    pub temporary: bool,
+    pub covering: bool,
+}
+
+#[derive(serde::Serialize)]
+pub struct Owner {
+    pub name: String,
+    pub members: Vec<String>,
+    pub depth: usize,
+}
+
+pub struct Packed {
+    pub stages: Vec<Stage>,
+    pub queries: Vec<String>,
+    pub owners: Vec<Owner>,
+}
+
+fn body(stage: &Stage) -> &str {
+    stage
+        .sql
+        .strip_prefix(&format!("CREATE TEMP TABLE \"{}\" AS ", stage.name))
+        .expect("generated CTAS")
+}
+
+// Generated aliases are globally unique inside this pinned program. A materialization's
+// own local definition shadows its future owner projection; earlier physical cuts do not.
+fn read(sql: &str, aliases: &HashMap<String, String>, own: Option<&str>) -> String {
+    let names: BTreeSet<_> = waves::identifiers(sql)
+        .filter(|name| Some(*name) != own && aliases.contains_key(*name))
+        .collect();
+    if names.is_empty() {
+        return sql.to_owned();
+    }
+    let views = names
+        .into_iter()
+        .map(|name| aliases[name].as_str())
+        .collect::<Vec<_>>()
+        .join(",");
+    let tail = sql
+        .strip_prefix("WITH RECURSIVE ")
+        .or_else(|| sql.strip_prefix("WITH "));
+    match tail {
+        Some(tail) => format!("WITH RECURSIVE {views},{tail}"),
+        None => format!("WITH RECURSIVE {views} {sql}"),
+    }
+}
+
+/// Only the declared (fid,pre) shape with its existing nonunique key index is packed.
+/// Other schemas and retained writes keep their current operators and ownership.
+pub fn pack(
+    stages: Vec<Stage>,
+    queries: Vec<String>,
+    graph: &[String],
+    definitions: &Definitions,
+) -> Packed {
+    let pairs: BTreeSet<_> = graph
+        .iter()
+        .filter_map(|cte| {
+            let (name, tail) = cte.split_once('(').expect("generated columns");
+            tail.starts_with("fid,pre) AS ").then_some(name)
+        })
+        .collect();
+    let physical: BTreeSet<_> = stages
+        .iter()
+        .filter(|s| s.temporary)
+        .map(|s| s.name.clone())
+        .collect();
+    let dependencies = lifetime::Dependencies::new(
+        &stages
+            .iter()
+            .map(|s| lifetime::Input {
+                name: &s.name,
+                sql: &s.sql,
+                temporary: s.temporary,
+            })
+            .collect::<Vec<_>>(),
+    );
+    let mut depths = vec![0; stages.len()];
+    let mut groups: BTreeMap<usize, Vec<usize>> = BTreeMap::new();
+    for (i, stage) in stages.iter().enumerate() {
+        depths[i] = dependencies.prerequisites[i]
+            .iter()
+            .map(|&p| depths[p] + 1)
+            .max()
+            .unwrap_or(0);
+        if stage.temporary
+            && !stage.covering
+            && stage.index == Some("fid,pre")
+            && pairs.contains(stage.name.as_str())
+        {
+            groups.entry(depths[i]).or_default().push(i);
+        }
+    }
+    // Bound symbolic expansion per submitted statement, not per producer or file.
+    // AS MATERIALIZED does not bound SQLite's preparation expansion. A shared physical
+    // input resets that expansion; independent roots still add to one statement's cost.
+    const PREPARATION_UNITS: usize = 0;
+    let mut expansion = HashMap::new();
+    let mut costs = HashMap::new();
+    for cte in graph {
+        let name = cte.split_once('(').expect("generated columns").0;
+        let body = cte.split_once(" AS ").expect("generated body").1;
+        let cost = waves::identifiers(body)
+            .filter_map(|t| expansion.get(t))
+            .fold(1usize, |n, c| n.saturating_add(*c));
+        costs.insert(name, cost);
+        expansion.insert(name, if physical.contains(name) { 1 } else { cost });
+    }
+    let templates = graph
+        .iter()
+        .filter_map(|cte| {
+            flat::template(cte).map(|t| (cte.split_once('(').expect("generated columns").0, t))
+        })
+        .collect::<HashMap<_, _>>();
+    let mut bounded = Vec::new();
+    for (depth, members) in groups {
+        let mut batch = Vec::new();
+        let mut units = 0usize;
+        let mut operators = BTreeSet::new();
+        for i in members {
+            let name = stages[i].name.as_str();
+            let template = templates.get(name);
+            let mut cost = if template.is_some_and(|t| operators.contains(&t.key)) {
+                1
+            } else {
+                costs[name]
+            };
+            if !batch.is_empty() && units.saturating_add(cost) > PREPARATION_UNITS {
+                bounded.push((depth, std::mem::take(&mut batch)));
+                units = 0;
+                operators.clear();
+                cost = costs[name];
+            }
+            if let Some(t) = template {
+                operators.insert(t.key.clone());
+            }
+            batch.push(i);
+            units = units.saturating_add(cost);
+        }
+        if !batch.is_empty() {
+            bounded.push((depth, batch));
+        }
+    }
+    let mut owners = Vec::new();
+    let mut member_indices = Vec::new();
+    let mut aliases = HashMap::new();
+    let mut member_owner = BTreeMap::new();
+    for (depth, members) in bounded.into_iter().filter(|(_, members)| members.len() > 1) {
+        let name = format!("selector_family_{}", owners.len());
+        for (slot, &i) in members.iter().enumerate() {
+            aliases.insert(stages[i].name.clone(),format!("{}(fid,pre) AS NOT MATERIALIZED (SELECT fid,pre FROM {name} WHERE producer={slot})",stages[i].name));
+            member_owner.insert(i, owners.len());
+        }
+        member_indices.push(members.clone());
+        owners.push(Owner {
+            name,
+            members: members.iter().map(|&i| stages[i].name.clone()).collect(),
+            depth,
+        });
+    }
+    let stages = stages
+        .into_iter()
+        .map(|mut stage| {
+            if stage.temporary && pairs.contains(stage.name.as_str()) {
+                let before = format!("{}(fid,pre) AS MATERIALIZED ", stage.name);
+                let after = format!("{}(fid,pre) AS NOT MATERIALIZED ", stage.name);
+                stage.sql = stage.sql.replacen(&before, &after, 1);
+            }
+            stage
+        })
+        .collect::<Vec<_>>();
+    if owners.is_empty() {
+        return Packed {
+            stages,
+            queries,
+            owners,
+        };
+    }
+    // Earlier dependency levels must be published before a family reads their aliases.
+    // Retained RAW, WAR and WAW edges come from the scheduler's exact preparation graph.
+    let mut order: Vec<_> = (0..stages.len()).collect();
+    order.sort_by_key(|&i| (depths[i], i));
+    let mut source: Vec<_> = stages.into_iter().map(Some).collect();
+    let mut output = Vec::new();
+    for i in order {
+        let Some(mut stage) = source[i].take() else {
+            continue;
+        };
+        if let Some(&owner) = member_owner.get(&i) {
+            let members = &member_indices[owner];
+            let owner = &owners[owner];
+            let names: BTreeSet<_> = owner.members.iter().map(String::as_str).collect();
+            // One WITH scope per family. Re-render the trusted logical graph, stopping
+            // at existing physical cuts. Repeating member WITH scopes retains separate
+            // ephemeral trees and can multiply SQLite's heap peak even on empty inputs.
+            let mut operators: BTreeMap<&str, Vec<(usize, &flat::Template)>> = BTreeMap::new();
+            let mut arms = Vec::new();
+            let mut extra = Vec::new();
+            for (slot, name) in owner.members.iter().enumerate() {
+                if let Some(template) = templates.get(name.as_str()) {
+                    operators
+                        .entry(&template.key)
+                        .or_default()
+                        .push((slot, template));
+                } else {
+                    arms.push(format!("SELECT {slot} AS producer,fid,pre FROM {name}"));
+                }
+            }
+            for operator in operators.values() {
+                if operator.len() > 1 {
+                    let (cte, arm) = flat::render(operator, extra.len());
+                    extra.push(cte);
+                    arms.push(arm);
+                } else {
+                    let slot = operator[0].0;
+                    arms.push(format!(
+                        "SELECT {slot} AS producer,fid,pre FROM {}",
+                        owner.members[slot]
+                    ));
+                }
+            }
+            for &j in members {
+                if j != i {
+                    source[j].take().expect("one physical publication");
+                }
+            }
+            extra.push(format!(
+                "selector_rows(producer,fid,pre) AS NOT MATERIALIZED ({})",
+                waves::compound("producer,fid,pre", arms)
+            ));
+            let selection = "SELECT CAST(producer AS INTEGER) AS producer,CAST(fid AS INTEGER) AS fid,CAST(pre AS INTEGER) AS pre FROM selector_rows";
+            let sql = definitions.render_cuts(selection, &physical, &names, &aliases, &extra);
+            output.push(Stage {
+                name: owner.name.clone(),
+                sql: format!("CREATE TEMP TABLE \"{}\" AS {sql}", owner.name),
+                index: Some("producer,fid,pre"),
+                temporary: true,
+                covering: false,
+            });
+        } else {
+            stage.sql = if stage.temporary {
+                format!(
+                    "CREATE TEMP TABLE \"{}\" AS {}",
+                    stage.name,
+                    read(body(&stage), &aliases, Some(&stage.name))
+                )
+            } else {
+                read(&stage.sql, &aliases, None)
+            };
+            output.push(stage);
+        }
+    }
+    Packed {
+        stages: output,
+        queries: queries.iter().map(|q| read(q, &aliases, None)).collect(),
+        owners,
+    }
+}
+
+#[cfg(test)]
+mod tests {
