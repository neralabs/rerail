#include "python/ast.rr"
.decl permission_selected(d: number)
permission_selected(d) :- pp_doc(d,_), pp_api().
.decl permission_selected_included(d: number)
permission_selected_included(d) :- pp_doc(d,p), glob("api/**/*.py",p).
permission_selected_included(d) :- pp_doc(d,p), glob("impl/**/*.py",p).
permission_selected_included(d) :- pp_doc(d,p), glob("l1100_exceptions/**/*.py",p).
.decl permission_selected_excluded(d: number)
permission_selected_excluded(d) :- pp_doc(d,p), glob("**/.git/**",p).
