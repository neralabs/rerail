.policy "data-layer:revision-ancestry-invariants" revision 1
.description "Revision ancestry stays structural and index-safe: no ancestry descriptors, no stmt_ancestry_chain, no text casts of stored revision columns."
.language python
.mode block
.scope dirs "impl/common/l2100_sql_grammar/domain/versioning", "impl/common/l2070_server_plan/steps"
.scope exclude "**/tests/**", "**/test_*.py"
// Python linter: scripts/lint_revision_ancestry_invariants.py, on the raw text of each file (comments and strings too):
//   forbidden_descriptor        `class SqlRevisionAncestryDefinition` (or six other names) at the start of a line
//   removed_surface             the text stmt_ancestry_chain anywhere, at its first occurrence
//   stored_revision_text_cast   a stored revision column cast to text: `rp.revision_sys_id::text`,
//                               `CAST(rp.revision_sys_id AS TEXT)`, across lines too; `CAST(? AS UUID)` is fine
// This follows the suite plugin, which reports each finding at its line. The --check CLI prints the first two
// without a line, and the recording puts those at line 1.
// The plugin runs only on a file that holds "revision", "ancestry" or "stmt_ancestry_chain" (case-sensitive), so
// `class SqlRevisionAncestryDefinition` alone, with capitals only, is not reported (rai_triggered).

// FORBIDDEN_CLASS_NAMES.
.decl rai_class(x: symbol)
rai_class("SqlRevisionAncestryDefinition"). rai_class("SqlNativeRevisionValue").
rai_class("SqlRevisionInAncestryCondition"). rai_class("SqlAncestryChainCte").
rai_class("_SqlVisibleAncestorsDefinition"). rai_class("_SqlCopyVisibleSparseAncestors").
rai_class("_SparseRowVisibleAtRevisionCondition").

// rai_text(d, sp): the whole file, when the plugin's source triggers let it run.
.decl rai_text(d: number, sp: span)
rai_text(d, sp) :- source(d, sp), text(sp, s), match("(?s).*(revision|ancestry).*", s).

// rai_class_at(d, x, k): `class x` starts line k. rai_chain_at(d, k): stmt_ancestry_chain occurs on line k.
.decl rai_class_at(d: number, x: symbol, k: number)
rai_class_at(d, x, k) :- rai_text(d, sp), match_all("(?m)^class\\s+(?<c>\\w+)\\b", sp), text(c, x), rai_class(x), line(c, k).
.decl rai_chain_at(d: number, k: number)
rai_chain_at(d, k) :- rai_text(d, sp), match_all("(?<m>stmt_ancestry_chain)", sp), line(m, k).

// Both are reported once, at the first occurrence (re.search, str.find).
.violation forbidden_descriptor(at: loc, name: symbol) "forbidden ancestry descriptor {name}"
forbidden_descriptor(@place(p, l), x) :- rai_class_at(d, x, _), doc(d, p, _), l = min k : { rai_class_at(d, x, k) }.

.violation removed_surface(at: loc) "imports removed stmt_ancestry_chain surface"
removed_surface(@place(p, l)) :- rai_chain_at(d, _), doc(d, p, _), l = min k : { rai_chain_at(d, k) }.

// TEXT_CAST_PATTERNS, case-insensitive, every match. A column may be followed by a closing quote, then up to 80
// characters (newlines included) before `::text`, or inside CAST(… AS TEXT | CHAR(n)).
.violation stored_revision_text_cast(at: loc) "stored revision column cast to text"
stored_revision_text_cast(m) :- rai_text(_, sp),
    match_all("(?i)(?<m>(?:revision_sys_id|parent_revision_sys_id|sys_valid_from_revision_id|sys_valid_to_revision_id)[\"'`]?[\\s\\S]{0,80}::\\s*text)", sp).
stored_revision_text_cast(m) :- rai_text(_, sp),
    match_all("(?i)(?<m>CAST\\([\\s\\S]{0,160}?(?:revision_sys_id|parent_revision_sys_id|sys_valid_from_revision_id|sys_valid_to_revision_id)[\"'`]?[\\s\\S]{0,80}?\\s+AS\\s+(?:TEXT|CHAR(?:\\s*\\(\\s*\\d+\\s*\\))?)\\s*\\))", sp).
