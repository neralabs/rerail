spt_1_transitive_sinks(f,c,"runtime_sequence_projection",t) :- spt_1_roots_runtime_sequence_projection(f,_), !spt_1_target_runtime_sequence_projection(f),
    dfs_first_memo(f,t,i,spt_1_ordered_edge,spt_1_target_runtime_sequence_projection,spt_1_roots_runtime_sequence_projection), spt_1_edge_rank(f,u,l,_,i), spt_1_call_graph(f,c,u), line(c,l).
