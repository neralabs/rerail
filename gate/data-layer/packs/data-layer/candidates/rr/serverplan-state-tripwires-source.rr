.decl spt_1_flow_issue(i: symbol)
spt_1_flow_issue("SPT-002"). spt_1_flow_issue("SPT-003"). spt_1_flow_issue("SPT-005"). spt_1_flow_issue("SPT-010"). spt_1_flow_issue("SPT-011"). spt_1_flow_issue("SPT-012").
spt_1_flow_issue("SPT-019"). spt_1_flow_issue("SPT-020"). spt_1_flow_issue("SPT-021"). spt_1_flow_issue("SPT-022"). spt_1_flow_issue("SPT-024"). spt_1_flow_issue("SPT-026").
spt_1_flow_issue("SPT-027"). spt_1_flow_issue("SPT-028").
.decl spt_1_ctx_display(f: node, name: symbol)
spt_1_ctx_display(f, n) :- spt_1_contexts(f, n, "").
spt_1_ctx_display(f, q) :- spt_1_contexts(f, n, c), c != "", q = @concat(@concat(c, "."), n).
.decl spt_1_signed(issue: symbol, f: node)
spt_1_signed(i, f) :- spt_1_ctx_display(f, n), docof(f, d), doc(d, p, _), spt_1_flow_issue(i), key = @concat(@concat(@concat(@concat(i, "::"), n), "::"), p), spt_1_signed_exceptions(key).
.decl spt_1_flow(fn: node, n: node, kind: symbol, origin: node)
spt_1_flow(f, n, k, o) :- spt_1_transitive_sinks(f, n, k, o), spt_1_contexts(f, _, _), spt_1_contexts(o, _, _).
.decl spt_1_post_process_name(n: symbol)
spt_1_post_process_name("_post_process"). spt_1_post_process_name("post_op_with_refs"). spt_1_post_process_name("post_process"). spt_1_post_process_name("postprocess").
















.decl spt_1_context_call(f: node, n: node, attr: symbol)
spt_1_context_call(f, n, a) :- spt_1_calls(n, _, _, _, _), spt_1_special_attributes(f, n, "context", a), spt_1_contexts(f, _, _).
.decl spt_1_outside_tests(n: node)
spt_1_outside_tests(n) :- docof(n, d), doc(d, p, _), @rx(p, "/tests/") = 0.







.decl spt_1_start(n: node, s: number)
spt_1_start(n, s) :- node(_, n, _, s, _).
.decl spt_1_dl_class_kind(k: symbol)
spt_1_dl_class_kind("class_definition").
.decl spt_1_dl_in_class(n: node)
spt_1_dl_in_class(n) :- nearest(n, _, spt_1_dl_class_kind).
.decl spt_1_dl_class_path(c: node, s: symbol)
spt_1_dl_class_path(c, t) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), !spt_1_dl_in_class(c).
spt_1_dl_class_path(c, s) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), nearest(c, a, spt_1_dl_class_kind),
    spt_1_dl_class_path(a, p), s = @concat(@concat(p, "."), t).
.decl spt_1_dl_class_prefix(n: node, s: symbol)
spt_1_dl_class_prefix(n, s) :- nearest(n, c, spt_1_dl_class_kind), spt_1_dl_class_path(c, p), s = @concat(p, ".").
spt_1_dl_class_prefix(n, "") :- kind(n, "function_definition"), !spt_1_dl_in_class(n).
.decl spt_1_dl_frame_kind(k: symbol)
spt_1_dl_frame_kind("function_definition").
spt_1_dl_frame_kind("class_definition").
.decl spt_1_dl_frame(f: node, t: symbol, fn: number)
spt_1_dl_frame(f, t, 1) :- kind(f, "function_definition"), field(f, "name", m), text(m, t).
spt_1_dl_frame(f, t, 0) :- kind(f, "class_definition"), field(f, "name", m), text(m, t).
.decl spt_1_dl_frame_parent(f: node, a: node)
spt_1_dl_frame_parent(f, a) :- spt_1_dl_frame(f, _, _), nearest(f, a, spt_1_dl_frame_kind).
.decl spt_1_dl_in_frame(n: node)
spt_1_dl_in_frame(n) :- spt_1_dl_frame_parent(n, _).
.decl spt_1_dl_qual(f: node, q: symbol, d: number)
spt_1_dl_qual(f, t, k) :- spt_1_dl_frame(f, t, k), !spt_1_dl_in_frame(f).
spt_1_dl_qual(f, s, d) :- spt_1_dl_frame(f, t, 1), spt_1_dl_frame_parent(f, a), spt_1_dl_qual(a, p, k), k > 0, d = k + 1,
    s = @concat(@concat(p, ".<locals>."), t).
spt_1_dl_qual(f, s, d) :- spt_1_dl_frame(f, t, x), spt_1_dl_frame_parent(f, a), spt_1_dl_qual(a, p, k), (x = 0; k = 0), d = k + x,
    s = @concat(@concat(p, "."), t).
.decl spt_1_dl_qualname(f: node, q: symbol)
spt_1_dl_qualname(f, q) :- spt_1_dl_qual(f, q, _).
.decl spt_1_dl_qualdepth(f: node, d: number)
spt_1_dl_qualdepth(f, d) :- spt_1_dl_qual(f, _, d).
spt_1_return_kind_entry(n,k) :- option_item("returnKindNames",i,n), option_item("returnKindValues",i,k).
spt_1_return_kind_entry(n,k) :- spt_generated(n,k), !option("entryPoint",_).


.decl spt_1_source_scope(body: node, classes: symbol)
spt_1_source_scope(m,"") :- spt_1_gnode(m), kind(m,"module").
spt_1_source_scope(b,@nfkc(name)) :- spt_1_source_scope(parent,""), body_member(parent,c), kind(c,"class_definition"),
    def_name(c,name), field(c,"body",b).
spt_1_source_scope(b,cat(prefix,".",@nfkc(name))) :- spt_1_source_scope(parent,prefix), prefix != "", body_member(parent,c),
    kind(c,"class_definition"), def_name(c,name), field(c,"body",b).
spt_1_contexts(f,@nfkc(name),classes) :- spt_1_source_scope(body,classes), body_member(body,f), kind(f,"function_definition"), def_name(f,name).



spt_1_ctx_planning(f) :- spt_1_contexts(f,n,_), @rx(n,"_lazy$") = 1.
spt_1_ctx_planning(f) :- spt_1_contexts(f,n,_), spt_1_planning_name(n).
spt_1_ctx_planning(f) :- spt_1_contexts(f,"pending_pipeline_effects",_).
spt_1_ctx_planning(f) :- spt_1_contexts(f,n,_), prefix("apply_",n), suffix("_effect",n).
spt_1_ctx_planning(f) :- spt_1_contexts(f,_,_), decorator(f,e), short_name(e,name), @nfkc(name) = "pure_lazy".



spt_1_ctx_helper(f) :- spt_1_contexts(f,name,_), suffix("sql_builder",name), !spt_1_planning_name(name),
    spt_1_parameters(f,p,_,_), field(p,"type",ann), walk_name(ann,raw), @nfkc(raw) = "CompilationContext".



spt_1_ctx_materializer(f) :- spt_1_contexts(f,name,_), spt_1_parameters(f,_,"runtime_refs",_), prefix("materialize_",name), suffix("builder",name).
spt_1_ctx_materializer(f) :- spt_1_contexts(f,_,_), spt_1_parameters(f,_,"runtime_refs",_), spt_1_parameters(f,p,_,_),
    field(p,"type",ann), walk_name(ann,raw), @nfkc(raw) = "RuntimeBuilderSpec".


spt_1_body_nodes(f,e) :- spt_1_contexts(f,_,_), decorator(f,e).
spt_1_body_nodes(f,n) :- spt_1_contexts(f,_,_), decorator(f,e), within(n,e).


.decl spt_1_native_work_context(f: node)
spt_1_native_work_context(f) :- spt_1_body_nodes(f,c), spt_forbidden_native_call(c).
spt_1_reachable(f) :- spt_1_ctx_planning(f).
spt_1_reachable(f) :- spt_1_ctx_helper(f).
spt_1_reachable(f) :- spt_1_ctx_provider_helper(f).
spt_1_reachable(f) :- spt_1_ctx_materializer(f).
// scan_tree already collected native-work calls during its visitor, on any path.
spt_1_reachable(f) :- spt_1_native_work_context(f).
// Selection is by called leaf name. Resolution for findings remains class-aware.
spt_1_reachable(t) :- spt_1_reachable(f), spt_1_body_nodes(f,c), kind(c,"call"), field(c,"function",callee), spt_callee(callee,name),
    docof(f,d), spt_1_contexts(t,name,_), docof(t,d).
.decl spt_1_fact_context(f: node)
spt_1_fact_context(f) :- spt_1_contexts(f,_,_), spt_1_reachable(f), docof(f,d), spt_needs_facts(d).
.decl spt_1_runtime_context(f: node)
spt_1_runtime_context(f) :- spt_1_fact_context(f).

spt_1_direct_events(f,n,"native_python_work",1) :- spt_1_body_nodes(f,n), spt_forbidden_native_call(n), spt_1_fact_context(f).


.violation StateAnalysisContext(at: span, family: symbol, line: number, name: symbol, class_scope: symbol) code "SPT_ANALYSIS_CONTEXT" "{family}: {name}"
StateAnalysisContext(@place(p,l),"facts",l,name,cls) :- option("entryPoint","_analysis_contexts"),
    spt_1_fact_context(f), spt_1_contexts(f,name,cls), docof(f,d), doc(d,p,_), line(f,l).
StateAnalysisContext(@place(p,l),"runtime",l,name,cls) :- option("entryPoint","_analysis_contexts"),
    spt_1_runtime_context(f), spt_1_contexts(f,name,cls), docof(f,d), doc(d,p,_), line(f,l).

.decl spt_2_fdef(kind: symbol)
spt_2_fdef("function_definition").
.decl spt_2_cdef(kind: symbol)
spt_2_cdef("class_definition").
.decl spt_2_finding(clause: symbol, key: symbol, n: node)

.decl spt_2_raw_strings(d: number, s: number, e: number, value: symbol)
spt_2_raw_strings(d, s, e, v) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}, {"filePath": {"regex": "(?s).*"}}]}]}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), node(d, x, _, s, e), doc_role(d,"primary").
spt_2_raw_strings(d, s, e, v) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"all": [{"not": {"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}[a-z]"}]}, {"filePath": {"regex": "(?s).*"}}]}]}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), node(d, x, _, s, e), doc_role(d,"primary").
spt_2_raw_strings(d, s, e, v) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"not": {"any": [{"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}[a-z]"}]}}, {"filePath": {"regex": "(?s).*"}}]}]}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), node(d, x, _, s, e), doc_role(d,"primary").
.decl spt_2_project_mode(d: number)
spt_2_project_mode(d) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"kind": "module"}, {"filePath": {"regex": "(?s).*"}}]}]}]}]}]}}), doc_role(d,"primary").
.decl spt_2_syntax_gate(d: number)
spt_2_syntax_gate(d) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"kind": "module"}]}]}]}]}]}}), doc_role(d,"primary").

.decl spt_2_excluded_kind(k: symbol)
spt_2_excluded_kind("comment"). spt_2_excluded_kind("string_start"). spt_2_excluded_kind("string_content"). spt_2_excluded_kind("string_end").
spt_2_excluded_kind("escape_sequence"). spt_2_excluded_kind("line_continuation").
.decl spt_2_gnode(n: node)
spt_2_gnode(n) :- node(d, n, k, _, _), spt_2_syntax_gate(d), !spt_2_excluded_kind(k).
.decl spt_2_own_fn(x: node, f: node)
spt_2_own_fn(x, x) :- spt_2_gnode(x), kind(x, "function_definition").
spt_2_own_fn(x, f) :- spt_2_gnode(x), !kind(x, "function_definition"), nearest(x, f, spt_2_fdef).
.decl spt_2_own_cls(x: node, c: node)
spt_2_own_cls(x, x) :- spt_2_gnode(x), kind(x, "class_definition").
spt_2_own_cls(x, c) :- spt_2_gnode(x), !kind(x, "class_definition"), nearest(x, c, spt_2_cdef).
.decl spt_2_nested_fn(f: node)
spt_2_nested_fn(f) :- kind(f, "function_definition"), nearest(f, g, spt_2_fdef).
.decl spt_2_fn_top(f: node, t: node)
spt_2_fn_top(f, f) :- kind(f, "function_definition"), !spt_2_nested_fn(f).
spt_2_fn_top(f, t) :- spt_2_nested_fn(f), docof(f, d), kind(t, "function_definition"), docof(t, d), !spt_2_nested_fn(t), within(f, t).
.decl spt_2_own_top(x: node, t: node)
spt_2_own_top(x, t) :- spt_2_own_fn(x, f), spt_2_fn_top(f, t).

.decl spt_2_functions(f: node, name: symbol)
spt_2_functions(f, name) :- spt_2_gnode(f), kind(f, "function_definition"), field(f, "name", x), text(x, name).
.decl spt_2_attributes(n: node, attr: symbol, object: node, object_text: symbol)
spt_2_attributes(n, a, o, ot) :- spt_2_gnode(n), kind(n, "attribute"), field(n, "attribute", x), text(x, a), field(n, "object", o), text(o, ot).
.decl spt_2_calls(n: node, callee_id: node, callee_kind: symbol, full_callee: symbol, callee: symbol)
spt_2_calls(n, f, k, t, a) :- spt_2_gnode(n), kind(n, "call"), field(n, "function", f), spt_2_gnode(f), kind(f, k), text(f, t), spt_2_attributes(f, a, _, _).
spt_2_calls(n, f, k, t, t) :- spt_2_gnode(n), kind(n, "call"), field(n, "function", f), spt_2_gnode(f), kind(f, k), text(f, t), !spt_2_attributes(f, _, _, _).
.decl spt_2_call_receiver(n: node, receiver: node)
spt_2_call_receiver(n, o) :- spt_2_calls(n, f, _, _, _), spt_2_attributes(f, _, o, _).

.decl spt_2_arg_skip(k: symbol)
spt_2_arg_skip("comment"). spt_2_arg_skip("keyword_argument"). spt_2_arg_skip("list_splat"). spt_2_arg_skip("dictionary_splat").
.decl spt_2_arg_row(call: node, a: node)
spt_2_arg_row(c, a) :- spt_2_calls(c, _, _, _, _), field(c, "arguments", l), child(l, a, _), spt_2_gnode(a), kind(a, k), !spt_2_arg_skip(k).
.decl spt_2_arg_before(call: node, a: node, b: node)
spt_2_arg_before(c, a, b) :- spt_2_arg_row(c, a), spt_2_arg_row(c, b), spt_2_start(a, sa), spt_2_start(b, sb), sb < sa.
.decl spt_2_has_arg_before(a: node)
spt_2_has_arg_before(a) :- spt_2_arg_before(_, a, _).
.decl spt_2_arguments(call: node, a: node, position: number)
spt_2_arguments(c, a, 0) :- spt_2_arg_row(c, a), !spt_2_has_arg_before(a).
spt_2_arguments(c, a, p) :- spt_2_arg_row(c, a), spt_2_has_arg_before(a), p = count : { spt_2_arg_before(c, a, _) }.

.decl spt_2_keywords(call: node, keyword: node, name: symbol, value: node)
spt_2_keywords(c, k, name, v) :- spt_2_calls(c, _, _, _, _), field(c, "arguments", l), child(l, k, _), spt_2_gnode(k), kind(k, "keyword_argument"),
    field(k, "name", kn), spt_2_gnode(kn), text(kn, name), field(k, "value", v), spt_2_gnode(v).

.decl spt_2_no_expand(k: symbol)
spt_2_no_expand("module"). spt_2_no_expand("block"). spt_2_no_expand("expression_statement"). spt_2_no_expand("argument_list").
spt_2_no_expand("decorated_definition"). spt_2_no_expand("type").
.decl spt_2_descendants(root: node, n: node)
spt_2_descendants(r, r) :- spt_2_gnode(r).
spt_2_descendants(r, n) :- spt_2_gnode(r), kind(r, k), !spt_2_no_expand(k), docof(r, d), spt_2_gnode(n), docof(n, d), within(n, r).

.decl spt_2_assignments(n: node, target: node, target_kind: symbol, target_text: symbol)
spt_2_assignments(n, l, k, t) :- spt_2_gnode(n), kind(n, "assignment"), field(n, "left", l), spt_2_gnode(l), kind(l, k), text(l, t).
.decl spt_2_assignment_value(n: node, value: node)
spt_2_assignment_value(n, r) :- spt_2_assignments(n, _, _, _), field(n, "right", r), spt_2_gnode(r).
.decl spt_2_assignment_fn(n: node, fn: node)
spt_2_assignment_fn(n, f) :- spt_2_assignments(n, _, _, _), spt_2_own_fn(n, f).

.decl spt_2_param_kind(k: symbol)
spt_2_param_kind("typed_parameter"). spt_2_param_kind("default_parameter"). spt_2_param_kind("typed_default_parameter").
.decl spt_2_param_row(fn: node, p: node, name: symbol)
spt_2_param_row(f, p, name) :- spt_2_functions(f, _), field(f, "parameters", ps), child(ps, p, _), spt_2_gnode(p), kind(p, "identifier"), text(p, name).
spt_2_param_row(f, p, name) :- spt_2_functions(f, _), field(f, "parameters", ps), child(ps, p, _), spt_2_gnode(p), kind(p, k), spt_2_param_kind(k),
    child(p, n, 0), spt_2_gnode(n), kind(n, "identifier"), text(n, name).
.decl spt_2_param_before(fn: node, p: node, q: node)
spt_2_param_before(f, p, q) :- spt_2_param_row(f, p, _), spt_2_param_row(f, q, _), spt_2_start(p, sp), spt_2_start(q, sq), sq < sp.
.decl spt_2_has_param_before(p: node)
spt_2_has_param_before(p) :- spt_2_param_before(_, p, _).
.decl spt_2_parameters(fn: node, p: node, name: symbol, position: number)
spt_2_parameters(f, p, n, 0) :- spt_2_param_row(f, p, n), !spt_2_has_param_before(p).
spt_2_parameters(f, p, n, i) :- spt_2_param_row(f, p, n), spt_2_has_param_before(p), i = count : { spt_2_param_before(f, p, _) }.
.decl spt_2_annotation_text(p: node, text: symbol)
spt_2_annotation_text(p, s) :- spt_2_param_row(_, p, _), field(p, "type", t), spt_2_gnode(t), text(t, s).

.decl spt_2_contexts(f: node, name: symbol, class_name: symbol)
spt_2_contexts(f, n, q) :- spt_2_functions(f, n), spt_2_own_top(f, f), spt_2_own_cls(f, c), q = dl_class_path1, spt_2_dl_class_path(c, dl_class_path1).
spt_2_contexts(f, n, "") :- spt_2_functions(f, n), spt_2_own_top(f, f), !spt_2_own_cls(f, _).
.decl spt_2_planning_name(n: symbol)
spt_2_planning_name("compile"). spt_2_planning_name("lower"). spt_2_planning_name("post_op"). spt_2_planning_name("pre_op"). spt_2_planning_name("preprocess").
.decl spt_2_ctx_planning(f: node)
spt_2_ctx_planning(f) :- spt_2_contexts(f, n, _), @rx(n, "_lazy$") = 1.
spt_2_ctx_planning(f) :- spt_2_contexts(f, n, _), spt_2_planning_name(n).
spt_2_ctx_planning(f) :- spt_2_contexts(f, "pending_pipeline_effects", _).
spt_2_ctx_planning(f) :- spt_2_contexts(f, n, _), @rx(n, "^apply_.*_effect$") = 1.
spt_2_ctx_planning(f) :- spt_2_contexts(f, _, _), child(w, f, _), spt_2_gnode(w), kind(w, "decorated_definition"), text(w, t),
    @rx(t, "(?m)^\\s*@(?:[\\w.]*\\.)?pure_lazy\\b") = 1.
.decl spt_2_ctx_preprocess(f: node)
spt_2_ctx_preprocess(f) :- spt_2_contexts(f, "preprocess", _).
.decl spt_2_ctx_helper(f: node)
spt_2_ctx_helper(f) :- spt_2_contexts(f, n, _), @rx(n, "sql_builder$") = 1, !spt_2_planning_name(n), spt_2_parameters(f, p, _, _), spt_2_annotation_text(p, t),
    @rx(t, "\\bCompilationContext\\b") = 1.
.decl spt_2_ctx_provider_helper(f: node)
spt_2_ctx_provider_helper(f) :- spt_2_contexts(f, n, _), docof(f, d), doc(d, "impl/common/l2070_server_plan/backend_profiles.py", _),
    @rx(n, "component|components|score|scores") = 1.
.decl spt_2_ctx_materializer(f: node)
spt_2_ctx_materializer(f) :- spt_2_contexts(f, n, _), spt_2_parameters(f, _, "runtime_refs", _), @rx(n, "^materialize_.*builder$") = 1.
spt_2_ctx_materializer(f) :- spt_2_contexts(f, _, _), spt_2_parameters(f, _, "runtime_refs", _), spt_2_parameters(f, p, _, _), spt_2_annotation_text(p, t),
    @rx(t, "\\bRuntimeBuilderSpec\\b") = 1.

.decl spt_2_body_nodes(fn: node, n: node)
spt_2_body_nodes(f, x) :- spt_2_own_top(x, f), spt_2_contexts(f, _, _).

.decl spt_2_callback_keyword(k: symbol)
spt_2_callback_keyword("post_op"). spt_2_callback_keyword("post_op_with_refs").
.decl spt_2_callback_parameters(fn: node, name: symbol, callback_kind: symbol, position: number)
spt_2_callback_parameters(c, name, kn, i) :- spt_2_contexts(c, _, _), docof(c, d), spt_2_calls(call, _, _, _, "CompiledStep"), docof(call, d), within(call, c),
    spt_2_keywords(call, _, kn, v), spt_2_callback_keyword(kn), kind(v, "identifier"), text(v, vt), spt_2_functions(nested, vt), docof(nested, d),
    within(nested, c), spt_2_parameters(nested, _, name, i), i >= 1, i <= 2.

.decl spt_2_authority_param(n: symbol)
spt_2_authority_param("txn"). spt_2_authority_param("read_txn"). spt_2_authority_param("write_txn"). spt_2_authority_param("conn"). spt_2_authority_param("connection").
spt_2_authority_param("sql_conn").
.decl spt_2_carrier_param(n: symbol)
spt_2_carrier_param("hydrator"). spt_2_carrier_param("runtime_hydrator"). spt_2_carrier_param("runtime_refs").
.decl spt_2_parameter_kinds(fn: node, name: symbol, kind: symbol)
spt_2_parameter_kinds(f, n, "authority") :- spt_2_parameters(f, _, n, _), spt_2_authority_param(n).
spt_2_parameter_kinds(f, n, "authority") :- spt_2_parameters(f, p, n, _), spt_2_annotation_text(p, t), @rx(t, "\\b(?:ReadTransaction|SyncDatabaseConnection|SyncSqlConnection|WriteTransaction)\\b") = 1.
spt_2_parameter_kinds(f, n, "provider") :- spt_2_parameters(f, p, n, _), spt_2_annotation_text(p, t), @rx(t, "\\b(?:CrossBranchQueryProvider|HybridSearchProvider|VectorCandidateProvider|VersionedLoweringProvider|VersionedStorageProvider)\\b") = 1.
spt_2_parameter_kinds(f, "resolved", "runtime_value") :- spt_2_parameters(f, _, "resolved", _).
spt_2_parameter_kinds(f, n, "runtime_value") :- spt_2_parameters(f, p, n, _), spt_2_annotation_text(p, t), @rx(t, "\\bResolvedRefs\\b") = 1.
spt_2_parameter_kinds(f, "runtime_refs", "runtime_value") :- spt_2_parameters(f, _, "runtime_refs", _), spt_2_ctx_materializer(f).
spt_2_parameter_kinds(f, n, "carrier") :- spt_2_parameters(f, _, n, _), spt_2_carrier_param(n).
spt_2_parameter_kinds(f, n, "carrier") :- spt_2_parameters(f, p, n, _), spt_2_annotation_text(p, t), @rx(t, "\\bHydrator\\b") = 1.
spt_2_parameter_kinds(f, n, "carrier") :- spt_2_callback_parameters(f, n, _, 1).
spt_2_parameter_kinds(f, n, "runtime_value") :- spt_2_callback_parameters(f, n, "post_op_with_refs", 2).
spt_2_parameter_kinds(f, n, "carrier") :- spt_2_callback_parameters(f, n, "post_op_with_refs", 2).

.decl spt_2_module_strings(d: number, name: symbol, value: symbol)
spt_2_module_strings(d, name, v) :- spt_2_assignments(a, _, "identifier", name), child(stmt, a, _), spt_2_gnode(stmt), child(root, stmt, _), spt_2_gnode(root),
    kind(root, "module"), field(a, "right", r), node(d, r, _, s, e), spt_2_raw_strings(d, s, e, v).
.decl spt_2_string_values(d: number, s: number, e: number, value: symbol)
spt_2_string_values(d, s, e, v) :- spt_2_raw_strings(d, s, e, v).
spt_2_string_values(d, s, e, v) :- spt_2_gnode(n), kind(n, "identifier"), text(n, name), node(d, n, _, s, e), spt_2_module_strings(d, name, v).

.decl spt_2_ctx_attr(a: symbol)
spt_2_ctx_attr("materialized_pipeline"). spt_2_ctx_attr("sql_connection"). spt_2_ctx_attr("txn").
.decl spt_2_carrier_attr(a: symbol)
spt_2_carrier_attr("_conn"). spt_2_carrier_attr("_serverplan_runtime_txn"). spt_2_carrier_attr("_serverplan_sql_conn"). spt_2_carrier_attr("_txn").
spt_2_carrier_attr("conn"). spt_2_carrier_attr("connection"). spt_2_carrier_attr("sql_conn"). spt_2_carrier_attr("txn").
.decl spt_2_special_attributes(fn: node, n: node, owner: symbol, attr: symbol)
spt_2_special_attributes(f, a, "context", at) :- spt_2_attributes(a, at, _, "ctx"), spt_2_ctx_attr(at), spt_2_body_nodes(f, a).
spt_2_special_attributes(f, a, "carrier", at) :- spt_2_attributes(a, at, _, ot), ot != "ctx", spt_2_carrier_attr(at), spt_2_body_nodes(f, a), spt_2_parameter_kinds(f, ot, "carrier").
spt_2_special_attributes(f, a, "carrier", at) :- spt_2_attributes(a, at, _, "ctx"), spt_2_carrier_attr(at), !spt_2_ctx_attr(at), spt_2_body_nodes(f, a), spt_2_parameter_kinds(f, "ctx", "carrier").
spt_2_special_attributes(f, c, "context", v) :- spt_2_calls(c, _, _, "getattr", _), spt_2_body_nodes(f, c), spt_2_arguments(c, r, 0), kind(r, "identifier"), text(r, "ctx"),
    spt_2_arguments(c, k, 1), node(d, k, _, s, e), spt_2_string_values(d, s, e, v), spt_2_ctx_attr(v).
spt_2_special_attributes(f, c, "context", v) :- spt_2_calls(c, _, _, "getattr", _), spt_2_body_nodes(f, c), spt_2_arguments(c, r, 0), kind(r, "identifier"), text(r, "ctx"),
    spt_2_arguments(c, k, 1), node(d, k, _, s, e), spt_2_string_values(d, s, e, v), spt_2_carrier_attr(v), spt_2_parameter_kinds(f, "ctx", "carrier").
spt_2_special_attributes(f, c, "carrier", v) :- spt_2_calls(c, _, _, "getattr", _), spt_2_body_nodes(f, c), spt_2_arguments(c, r, 0), kind(r, "identifier"), text(r, rt),
    rt != "ctx", spt_2_arguments(c, k, 1), node(d, k, _, s, e), spt_2_string_values(d, s, e, v), spt_2_carrier_attr(v), spt_2_parameter_kinds(f, rt, "carrier").
spt_2_special_attributes(f, c, "carrier", v) :- spt_2_calls(c, g, _, _, "get"), spt_2_body_nodes(f, c), spt_2_attributes(g, _, _, ot), spt_2_arguments(c, k, 0),
    node(d, k, _, s, e), spt_2_string_values(d, s, e, v), spt_2_carrier_attr(v), spt_2_parameter_kinds(f, ot, "carrier").
spt_2_special_attributes(f, n, "carrier", v) :- spt_2_gnode(n), kind(n, "subscript"), spt_2_body_nodes(f, n), field(n, "value", r), spt_2_gnode(r), kind(r, "identifier"),
    text(r, rt), child(n, k, _), spt_2_gnode(k), k != r, node(d, k, _, s, e), spt_2_string_values(d, s, e, v), spt_2_carrier_attr(v),
    spt_2_parameter_kinds(f, rt, "carrier").

.decl spt_2_runtime(d: number, name: symbol)
spt_2_runtime(d, n) :- spt_2_contexts(c, n, _), docof(c, d), spt_2_special_attributes(c, _, "carrier", _), spt_2_parameter_kinds(c, _, "carrier").
spt_2_runtime(d, n) :- spt_2_contexts(c, n, _), spt_2_body_nodes(c, call), spt_2_calls(call, _, "identifier", _, callee), docof(call, d), spt_2_runtime(d, callee),
    spt_2_arguments(call, a, _), spt_2_descendants(a, x), kind(x, "identifier"), text(x, t), spt_2_parameter_kinds(c, t, "carrier").
.decl spt_2_return_kind_entry(name: symbol, kind: symbol)
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  

.decl spt_2_return_kinds(d: number, name: symbol, kind: symbol)
spt_2_return_kinds(d, n, "runtime_authority") :- spt_2_runtime(d, n).
spt_2_return_kinds(d, n, "authority") :- spt_2_contexts(c, n, _), docof(c, d), field(c, "return_type", t), spt_2_gnode(t), text(t, s), @rx(s, "\\b(?:ReadTransaction|SyncDatabaseConnection|SyncSqlConnection|WriteTransaction)\\b") = 1.
spt_2_return_kinds(d, n, "provider") :- spt_2_contexts(c, n, _), docof(c, d), field(c, "return_type", t), spt_2_gnode(t), text(t, s), @rx(s, "\\b(?:CrossBranchQueryProvider|HybridSearchProvider|VectorCandidateProvider|VersionedLoweringProvider|VersionedStorageProvider)\\b") = 1.
spt_2_return_kinds(d, n, k) :- spt_2_contexts(c, _, _), docof(c, d), spt_2_return_kind_entry(n, k).

.decl spt_2_expression_edges(src: node, dst: node)
spt_2_expression_edges(o, n) :- spt_2_attributes(n, _, o, _).
spt_2_expression_edges(r, n) :- spt_2_call_receiver(n, r).
spt_2_expression_edges(v, n) :- spt_2_gnode(n), kind(n, "subscript"), field(n, "value", v).
.decl spt_2_identifier_nodes(n: node, text: symbol)
spt_2_identifier_nodes(n, t) :- spt_2_gnode(n), kind(n, "identifier"), text(n, t).

.decl spt_2_flow_kind(k: symbol)
spt_2_flow_kind("authority"). spt_2_flow_kind("provider"). spt_2_flow_kind("runtime_value").
.decl spt_2_taints(fn: node, n: node, kind: symbol)
spt_2_taints(f, n, k) :- spt_2_body_nodes(f, n), spt_2_identifier_nodes(n, t), spt_2_parameter_kinds(f, t, k), k != "carrier".
spt_2_taints(f, n, "authority") :- spt_2_special_attributes(f, n, "carrier", _).
spt_2_taints(f, n, "authority") :- spt_2_special_attributes(f, n, _, "txn").
spt_2_taints(f, n, "authority") :- spt_2_special_attributes(f, n, _, "sql_connection").
spt_2_taints(f, c, k) :- spt_2_body_nodes(f, c), spt_2_calls(c, _, _, _, callee), docof(c, d), spt_2_return_kinds(d, callee, k).
spt_2_taints(f, c, k) :- spt_2_body_nodes(f, c), spt_2_calls(c, _, _, _, callee), spt_2_project_mode(_), spt_2_return_kinds(_, callee, k).
spt_2_taints(f, t, k) :- spt_2_taints(f, n, k), spt_2_expression_edges(n, t), spt_2_body_nodes(f, t).
spt_2_taints(f, x, k) :- spt_2_taints(f, n, k), spt_2_flow_kind(k), spt_2_assignment_value(a, n), spt_2_assignments(a, _, "identifier", name), spt_2_body_nodes(f, a),
    spt_2_identifier_nodes(x, name), spt_2_body_nodes(f, x).

.decl spt_2_semantic_values(fn: node, n: node)
spt_2_semantic_values(f, n) :- spt_2_taints(f, n, "runtime_value").
spt_2_semantic_values(f, n) :- spt_2_body_nodes(f, n), spt_2_identifier_nodes(n, t), spt_2_parameter_kinds(f, t, "carrier").
spt_2_semantic_values(f, r) :- spt_2_semantic_values(f, n), spt_2_descendants(r, n).
spt_2_semantic_values(f, x) :- spt_2_semantic_values(f, n), spt_2_assignment_value(a, n), spt_2_assignments(a, _, "identifier", name), spt_2_body_nodes(f, a),
    spt_2_identifier_nodes(x, name), spt_2_body_nodes(f, x).

.decl spt_2_eager_name(n: symbol)
spt_2_eager_name("execute_grammar_fetchall_direct"). spt_2_eager_name("execute_grammar_fetchall_direct_async"). spt_2_eager_name("execute_grammar_fetchall_with_params_direct").
spt_2_eager_name("execute_grammar_fetchall_with_params_direct_async"). spt_2_eager_name("execute_grammar_fetchone_direct"). spt_2_eager_name("execute_grammar_fetchone_direct_async").
spt_2_eager_name("execute_grammar_fetchone_with_params_direct"). spt_2_eager_name("execute_grammar_fetchone_with_params_direct_async"). spt_2_eager_name("grammar_effect_lazy").
spt_2_eager_name("grammar_execute"). spt_2_eager_name("grammar_execute_async"). spt_2_eager_name("grammar_fetchall").
spt_2_eager_name("grammar_fetchall_async"). spt_2_eager_name("grammar_fetchone"). spt_2_eager_name("grammar_fetchone_async").
spt_2_eager_name("grammar_row_lazy"). spt_2_eager_name("grammar_rows_lazy"). spt_2_eager_name("grammar_scalar").
spt_2_eager_name("grammar_scalar_async"). spt_2_eager_name("grammar_value_lazy").
.decl spt_2_exec_name(n: symbol)
spt_2_exec_name("execute"). spt_2_exec_name("execute_async"). spt_2_exec_name("execute_ddl"). spt_2_exec_name("execute_ddl_async"). spt_2_exec_name("executemany"). spt_2_exec_name("executemany_async").
spt_2_exec_name("fetchall"). spt_2_exec_name("fetchall_async"). spt_2_exec_name("fetchone"). spt_2_exec_name("fetchone_async"). spt_2_exec_name("scalar"). spt_2_exec_name("scalar_async").
.decl spt_2_eager_rx(p: symbol)
spt_2_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.execute$"). spt_2_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.execute_async$").
spt_2_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.fetchall$"). spt_2_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.fetchall_async$").
spt_2_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.fetchone$"). spt_2_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.fetchone_async$").
spt_2_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.execute$"). spt_2_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.execute_async$").
spt_2_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.fetchall$"). spt_2_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.fetchall_async$").
spt_2_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.fetchone$"). spt_2_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.fetchone_async$").
spt_2_eager_rx("(?:^|\\.)cursor(?:\\([^)]*\\))?\\.execute$"). spt_2_eager_rx("(?:^|\\.)cursor(?:\\([^)]*\\))?\\.executemany$").
spt_2_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.execute$"). spt_2_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.execute_async$").
spt_2_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.fetchall$"). spt_2_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.fetchall_async$").
spt_2_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.fetchone$"). spt_2_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.fetchone_async$").
spt_2_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.execute$"). spt_2_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.execute_async$").
spt_2_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.fetchall$"). spt_2_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.fetchall_async$").
spt_2_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.fetchone$"). spt_2_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.fetchone_async$").
.decl spt_2_native_name(n: symbol)
spt_2_native_name("create_usearch_index_class"). spt_2_native_name("deserialize_embedding"). spt_2_native_name("get_similarity_function"). spt_2_native_name("serialize_embedding").
.decl spt_2_native_rx(p: symbol)
spt_2_native_rx("(?:^|\\.)np(?:\\([^)]*\\))?\\.array$"). spt_2_native_rx("(?:^|\\.)np(?:\\([^)]*\\))?\\.ascontiguousarray$").
spt_2_native_rx("(?:^|\\.)np(?:\\([^)]*\\))?\\.isinf$"). spt_2_native_rx("(?:^|\\.)np(?:\\([^)]*\\))?\\.isnan$").
spt_2_native_rx("(?:^|\\.)numpy(?:\\([^)]*\\))?\\.array$"). spt_2_native_rx("(?:^|\\.)numpy(?:\\([^)]*\\))?\\.ascontiguousarray$").
spt_2_native_rx("(?:^|\\.)numpy(?:\\([^)]*\\))?\\.isinf$"). spt_2_native_rx("(?:^|\\.)numpy(?:\\([^)]*\\))?\\.isnan$").
.decl spt_2_large_column_name(n: symbol)
spt_2_large_column_name("explicit_plan_execution_scope"). spt_2_large_column_name("hydrate_many_post_op").
spt_2_large_column_name("hydrate_one_post_op"). spt_2_large_column_name("runtime_sql_conn_from_hydrator").
.decl spt_2_nested_name(n: symbol)
spt_2_nested_name("execute_runtime_nested_steps_async"). spt_2_nested_name("execute_runtime_nested_steps_sync").
.decl spt_2_nested_rx(p: symbol)
spt_2_nested_rx("(?:^|\\.)PlanExecutor(?:\\([^)]*\\))?\\.execute$"). spt_2_nested_rx("(?:^|\\.)PlanExecutor(?:\\([^)]*\\))?\\.execute_async$").
spt_2_nested_rx("(?:^|\\.)executor(?:\\([^)]*\\))?\\.execute$"). spt_2_nested_rx("(?:^|\\.)executor(?:\\([^)]*\\))?\\.execute_async$").
.decl spt_2_refs_keyword(k: symbol)
spt_2_refs_keyword("post_op_with_refs"). spt_2_refs_keyword("pre_op_with_refs").
.decl spt_2_resolved_call(n: symbol)
spt_2_resolved_call("get"). spt_2_resolved_call("peek"). spt_2_resolved_call("resolve_server_ref").
.decl spt_2_resolved_name(n: symbol)
spt_2_resolved_name("resolved"). spt_2_resolved_name("resolved_refs").
.decl spt_2_projection_call(n: symbol)
spt_2_projection_call("all"). spt_2_projection_call("any"). spt_2_projection_call("filter"). spt_2_projection_call("len"). spt_2_projection_call("map"). spt_2_projection_call("max").
spt_2_projection_call("min"). spt_2_projection_call("reversed"). spt_2_projection_call("sorted"). spt_2_projection_call("sum").
.decl spt_2_sequence_method(n: symbol)
spt_2_sequence_method("count"). spt_2_sequence_method("index"). spt_2_sequence_method("reverse"). spt_2_sequence_method("sort").
.decl spt_2_comprehension_kind(k: symbol)
spt_2_comprehension_kind("list_comprehension"). spt_2_comprehension_kind("set_comprehension"). spt_2_comprehension_kind("dictionary_comprehension").
spt_2_comprehension_kind("generator_expression").
.decl spt_2_direct_events(fn: node, n: node, kind: symbol, priority: number)
spt_2_direct_events(f, n, "eager_sql", 1) :- spt_2_calls(n, _, _, _, c), spt_2_body_nodes(f, n), spt_2_eager_name(c).
spt_2_direct_events(f, n, "eager_sql", 1) :- spt_2_calls(n, _, "identifier", _, c), spt_2_body_nodes(f, n), spt_2_exec_name(c).
spt_2_direct_events(f, n, "eager_sql", 1) :- spt_2_calls(n, _, _, fc, _), spt_2_body_nodes(f, n), spt_2_eager_rx(p), @rx(fc, p) = 1.
spt_2_direct_events(f, n, "eager_sql", 1) :- spt_2_calls(n, _, _, _, c), spt_2_body_nodes(f, n), spt_2_exec_name(c), spt_2_call_receiver(n, r), spt_2_taints(f, r, "authority").
spt_2_direct_events(f, n, "native_python_work", 1) :- spt_2_calls(n, _, _, _, c), spt_2_body_nodes(f, n), spt_2_native_name(c).
spt_2_direct_events(f, n, "native_python_work", 1) :- spt_2_calls(n, _, _, fc, _), spt_2_body_nodes(f, n), spt_2_native_rx(p), @rx(fc, p) = 1.
spt_2_direct_events(f, n, "runtime_callback", 1) :- spt_2_calls(n, _, _, _, "CompiledStep"), spt_2_body_nodes(f, n), spt_2_keywords(n, _, k, _), spt_2_refs_keyword(k).
spt_2_direct_events(f, n, "large_column", 1) :- spt_2_calls(n, _, _, _, c), spt_2_body_nodes(f, n), spt_2_large_column_name(c).
spt_2_direct_events(f, n, "large_column", 1) :- spt_2_calls(n, _, _, _, "convert_row_to_model"), spt_2_body_nodes(f, n), spt_2_keywords(n, _, "hydrate_large_columns", v),
    kind(v, "true").
spt_2_direct_events(f, n, "resolved_refs", 1) :- spt_2_calls(n, g, _, _, c), spt_2_resolved_call(c), spt_2_body_nodes(f, n), spt_2_attributes(g, _, o, _), spt_2_gnode(o),
    kind(o, "identifier"), text(o, t), spt_2_resolved_name(t).
spt_2_direct_events(f, n, "resolved_refs", 1) :- spt_2_calls(n, g, _, _, c), spt_2_resolved_call(c), spt_2_body_nodes(f, n), spt_2_attributes(g, _, o, _), spt_2_gnode(o),
    spt_2_attributes(o, t, _, _), spt_2_resolved_name(t).
spt_2_direct_events(f, n, "resolved_refs", 1) :- spt_2_calls(n, g, _, _, c), spt_2_resolved_call(c), spt_2_body_nodes(f, n), spt_2_attributes(g, _, o, _), spt_2_gnode(o),
    kind(o, k), k != "identifier", k != "attribute", text(o, t), @sql_instr(t, "resolved") > 0.
spt_2_direct_events(f, n, "nested_execute", 1) :- spt_2_calls(n, _, _, _, c), spt_2_body_nodes(f, n), spt_2_nested_name(c).
spt_2_direct_events(f, n, "nested_execute", 1) :- spt_2_calls(n, _, _, fc, _), spt_2_body_nodes(f, n), spt_2_nested_rx(p), @rx(fc, p) = 1.
spt_2_direct_events(f, n, "materialized_pipeline", 1) :- spt_2_attributes(n, "materialized_pipeline", _, _), spt_2_body_nodes(f, n).
spt_2_direct_events(f, n, "materialized_pipeline", 1) :- spt_2_special_attributes(f, n, "context", "materialized_pipeline"), spt_2_body_nodes(f, n), spt_2_gnode(n).
spt_2_direct_events(f, n, "ctx_access", 1) :- spt_2_special_attributes(f, n, "context", _), spt_2_body_nodes(f, n), spt_2_gnode(n).
spt_2_direct_events(f, n, "runtime_authority", 1) :- spt_2_special_attributes(f, n, "carrier", _), spt_2_body_nodes(f, n), spt_2_gnode(n), kind(n, "attribute").
spt_2_direct_events(f, n, "runtime_authority", 1) :- spt_2_special_attributes(f, n, "carrier", _), spt_2_body_nodes(f, n), spt_2_gnode(n), kind(n, "call").
spt_2_direct_events(f, n, "runtime_authority", 1) :- spt_2_calls(n, _, _, _, "active_pipeline_txn_for_callbacks"), spt_2_body_nodes(f, n).
spt_2_direct_events(f, n, "runtime_authority", 1) :- spt_2_calls(n, _, _, _, _), spt_2_body_nodes(f, n), spt_2_taints(f, n, "runtime_authority").
spt_2_direct_events(f, n, "runtime_authority", 0) :- spt_2_assignments(n, _, _, _), spt_2_body_nodes(f, n), spt_2_assignment_value(n, v), spt_2_taints(f, v, "runtime_authority").
spt_2_direct_events(f, n, "runtime_value", 0) :- spt_2_assignments(n, _, _, _), spt_2_body_nodes(f, n), spt_2_assignment_value(n, v), spt_2_taints(f, v, "runtime_value").
spt_2_direct_events(f, n, "runtime_value", 1) :- spt_2_calls(n, _, _, _, _), spt_2_body_nodes(f, n), spt_2_taints(f, n, "runtime_value").
spt_2_direct_events(f, n, "runtime_value", 1) :- spt_2_calls(n, _, _, _, _), spt_2_body_nodes(f, n), spt_2_call_receiver(n, r), spt_2_taints(f, r, "runtime_value").
spt_2_direct_events(f, n, "runtime_value", 1) :- spt_2_calls(n, _, _, _, _), spt_2_body_nodes(f, n), spt_2_arguments(n, a, _), spt_2_taints(f, a, "runtime_value").
spt_2_direct_events(f, n, "runtime_value", 1) :- spt_2_calls(n, _, _, _, _), spt_2_body_nodes(f, n), spt_2_keywords(n, _, _, v), spt_2_taints(f, v, "runtime_value").
spt_2_direct_events(f, n, "runtime_value", 1) :- spt_2_gnode(n), kind(n, "subscript"), spt_2_body_nodes(f, n), field(n, "value", o), spt_2_gnode(o), kind(o, "identifier"),
    spt_2_taints(f, o, "runtime_value").
spt_2_direct_events(f, n, "runtime_value", 1) :- spt_2_gnode(n), kind(n, "comparison_operator"), spt_2_body_nodes(f, n), text(n, t), @rx(t, "\\bin\\b") = 1,
    child(n, o, _), spt_2_gnode(o), kind(o, "identifier"), spt_2_taints(f, o, "runtime_value").
spt_2_direct_events(f, n, "provider_authority", 1) :- spt_2_calls(n, _, _, _, _), spt_2_body_nodes(f, n), spt_2_call_receiver(n, r), spt_2_taints(f, r, "provider"),
    spt_2_arguments(n, a, _), spt_2_taints(f, a, "authority").
spt_2_direct_events(f, n, "provider_authority", 1) :- spt_2_calls(n, _, _, _, _), spt_2_body_nodes(f, n), spt_2_call_receiver(n, r), spt_2_taints(f, r, "provider"),
    spt_2_keywords(n, _, _, v), spt_2_taints(f, v, "authority").
spt_2_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_2_calls(n, _, _, _, c), spt_2_projection_call(c), spt_2_body_nodes(f, n), spt_2_arguments(n, a, _),
    spt_2_semantic_values(f, a).
spt_2_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_2_calls(n, _, _, _, c), spt_2_projection_call(c), spt_2_body_nodes(f, n), spt_2_keywords(n, _, _, v),
    spt_2_semantic_values(f, v).
spt_2_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_2_calls(n, _, _, _, c), spt_2_sequence_method(c), spt_2_body_nodes(f, n), spt_2_call_receiver(n, r),
    spt_2_semantic_values(f, r).
spt_2_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_2_gnode(n), kind(n, "subscript"), spt_2_body_nodes(f, n), child(n, sl, _), spt_2_gnode(sl),
    kind(sl, "slice"), field(n, "value", v), spt_2_semantic_values(f, v).
spt_2_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_2_gnode(n), kind(n, k), spt_2_comprehension_kind(k), spt_2_body_nodes(f, n), child(n, fi, _), spt_2_gnode(fi),
    kind(fi, "for_in_clause"), child(n, ic, _), spt_2_gnode(ic), kind(ic, "if_clause"), field(fi, "right", r), spt_2_semantic_values(f, r).
.decl spt_2_loop_projection(p: node)
spt_2_loop_projection(p) :- spt_2_gnode(p), kind(p, "subscript").
spt_2_loop_projection(p) :- spt_2_calls(p, _, _, _, "get").
spt_2_loop_projection(p) :- spt_2_calls(p, _, _, _, "getattr").
.decl spt_2_append_call(n: symbol)
spt_2_append_call("append"). spt_2_append_call("extend").
.decl spt_2_projection_loop(fn: node, n: node)
spt_2_projection_loop(f, n) :- spt_2_gnode(n), kind(n, "for_statement"), spt_2_body_nodes(f, n), field(n, "right", r), spt_2_semantic_values(f, r),
    spt_2_descendants(n, c), spt_2_calls(c, _, _, _, cc), spt_2_append_call(cc), spt_2_descendants(n, p), spt_2_loop_projection(p),
    spt_2_descendants(p, u), spt_2_identifier_nodes(u, name), field(n, "left", l), spt_2_descendants(l, x), spt_2_identifier_nodes(x, name).
spt_2_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_2_projection_loop(f, n).
spt_2_direct_events(f, n, "runtime_sequence_projection", 1) :- spt_2_projection_loop(f, n).

.decl spt_2_depth_skip(k: symbol)
spt_2_depth_skip("module"). spt_2_depth_skip("block"). spt_2_depth_skip("expression_statement"). spt_2_depth_skip("argument_list").
spt_2_depth_skip("decorated_definition"). spt_2_depth_skip("parenthesized_expression"). spt_2_depth_skip("type").
.decl spt_2_event_ancestor(n: node, r: node)
spt_2_event_ancestor(n, r) :- spt_2_direct_events(_, n, _, _), spt_2_descendants(r, n), kind(r, k), !spt_2_depth_skip(k).
.decl spt_2_event_rank(fn: node, kind: symbol, n: node, priority: number, depth: number, s: number)
spt_2_event_rank(f, k, n, p, c, s) :- spt_2_direct_events(f, n, k, p), c = count : { spt_2_event_ancestor(n, _) }, spt_2_start(n, s).
.decl spt_2_ds_priority(fn: node, kind: symbol, priority: number)
spt_2_ds_priority(f, k, p) :- spt_2_event_rank(f, k, _, _, _, _), p = min q : { spt_2_event_rank(f, k, _, q, _, _) }.
.decl spt_2_ds_depth(fn: node, kind: symbol, depth: number)
spt_2_ds_depth(f, k, c) :- spt_2_ds_priority(f, k, p), c = min x : { spt_2_event_rank(f, k, _, p, x, _) }.
.decl spt_2_ds_start(fn: node, kind: symbol, s: number)
spt_2_ds_start(f, k, s) :- spt_2_ds_priority(f, k, p), spt_2_ds_depth(f, k, c), s = min y : { spt_2_event_rank(f, k, _, p, c, y) }.
.decl spt_2_direct_sinks(fn: node, n: node, kind: symbol)
spt_2_direct_sinks(f, n, k) :- spt_2_ds_priority(f, k, p), spt_2_ds_depth(f, k, c), spt_2_ds_start(f, k, s), spt_2_event_rank(f, k, n, p, c, s).

.decl spt_2_self_name(n: symbol)
spt_2_self_name("self"). spt_2_self_name("cls").
.decl spt_2_call_graph(fn: node, n: node, target: node)
spt_2_call_graph(f, c, t) :- spt_2_body_nodes(f, c), spt_2_calls(c, _, "identifier", _, callee), spt_2_contexts(f, _, _), docof(c, d), spt_2_contexts(t, callee, ""), docof(t, d),
    t != f.
spt_2_call_graph(f, c, t) :- spt_2_body_nodes(f, c), spt_2_calls(c, g, "attribute", _, callee), spt_2_contexts(f, _, cn), cn != "", docof(c, d), spt_2_contexts(t, callee, cn),
    docof(t, d), t != f, spt_2_attributes(g, _, _, ot), spt_2_self_name(ot).

.decl spt_2_builder_tokens(n: node, name: symbol)
spt_2_builder_tokens(n, a) :- spt_2_attributes(n, a, _, "RuntimeBuilderName").
spt_2_builder_tokens(n, v) :- spt_2_gnode(n), node(d, n, _, s, e), spt_2_string_values(d, s, e, v), v != "".

.decl spt_2_semantic_builders(name: symbol)
spt_2_semantic_builders(t) :- spt_2_contexts(c, _, _), spt_2_direct_sinks(c, _, "runtime_sequence_projection"), spt_2_body_nodes(c, cmp), kind(cmp, "comparison_operator"),
    child(cmp, op, _), spt_2_gnode(op), spt_2_builder_tokens(op, t), child(cmp, sp, _), spt_2_attributes(sp, "builder_name", _, "spec").

.decl spt_2_builder_keyword(c: node)
spt_2_builder_keyword(c) :- spt_2_keywords(c, _, "builder_name", _).
.decl spt_2_has_second_argument(c: node)
spt_2_has_second_argument(c) :- spt_2_arguments(c, _, 1).
.decl spt_2_builder_sites(n: node, name: symbol)
spt_2_builder_sites(c, t) :- spt_2_calls(c, _, _, _, "runtime_builder_post_op"), spt_2_arguments(c, a, 1), spt_2_builder_tokens(a, t).
spt_2_builder_sites(c, t) :- spt_2_calls(c, _, _, _, "RuntimeBuilderSpec"), !spt_2_builder_keyword(c), spt_2_arguments(c, a, 1), spt_2_builder_tokens(a, t).
spt_2_builder_sites(c, t) :- spt_2_calls(c, _, _, _, "RuntimeBuilderSpec"), spt_2_keywords(c, _, "builder_name", v), spt_2_builder_tokens(v, t).
spt_2_builder_sites(c, t) :- spt_2_calls(c, _, _, _, "runtime_builder_post_op"), !spt_2_has_second_argument(c), spt_2_keywords(c, _, "builder_name", v), spt_2_builder_tokens(v, t).

.decl spt_2_builder_helper(name: symbol)
spt_2_builder_helper(n) :- spt_2_contexts(h, n, _), spt_2_body_nodes(h, o), spt_2_builder_sites(o, t), spt_2_semantic_builders(t).
.decl spt_2_graph_site(fn: node, n: node)
spt_2_graph_site(f, c) :- spt_2_call_graph(f, c, _).
.decl spt_2_project_seeds(fn: node, n: node, kind: symbol, priority: number)
spt_2_project_seeds(f, n, "builder", 0) :- spt_2_body_nodes(f, n), spt_2_builder_sites(n, t), spt_2_semantic_builders(t).
spt_2_project_seeds(f, c, "builder", 1) :- spt_2_body_nodes(f, c), spt_2_calls(c, _, _, _, callee), !spt_2_graph_site(f, c), spt_2_builder_helper(callee).
spt_2_project_seeds(f, n, "semantic", 0) :- spt_2_direct_sinks(f, n, "runtime_semantic_projection").

.lattice spt_2_shortlex_min<symbol> { Lub -> @shortlex_min }
.decl spt_2_project_sink(fn: node, kind: symbol, n: node, priority: number, route: spt_2_shortlex_min<>) widen 64
spt_2_project_sink(f, k, n, p, r) :- spt_2_project_seeds(f, n, k, p), r = @concat(@concat("|", @rr_to_string(f)), "|").
spt_2_project_sink(g, k, n, p, r) :- spt_2_project_sink(f, k, n, p, r0), spt_2_call_graph(g, _, f), !spt_2_project_seeds(g, _, k, _), r = @concat(@concat(r0, @rr_to_string(g)), "|").
.decl spt_2_project_sink_len(fn: node, kind: symbol, n: node, priority: number, len: number)
spt_2_project_sink_len(f, k, n, p, l) :- spt_2_project_sink(f, k, n, p, r), l = @sql_length(r).
.decl spt_2_ps_len(fn: node, kind: symbol, len: number)
spt_2_ps_len(f, k, l) :- spt_2_project_sink_len(f, k, _, _, _), l = min x : { spt_2_project_sink_len(f, k, _, _, x) }.
.decl spt_2_ps_priority(fn: node, kind: symbol, priority: number)
spt_2_ps_priority(f, k, p) :- spt_2_ps_len(f, k, l), p = min q : { spt_2_project_sink_len(f, k, _, q, l) }.
.decl spt_2_ps_candidate(fn: node, kind: symbol, n: node, s: number)
spt_2_ps_candidate(f, k, n, s) :- spt_2_ps_len(f, k, l), spt_2_ps_priority(f, k, p), spt_2_project_sink_len(f, k, n, p, l), spt_2_start(n, s).
.decl spt_2_ps_start(fn: node, kind: symbol, s: number)
spt_2_ps_start(f, k, s) :- spt_2_ps_candidate(f, k, _, _), s = min y : { spt_2_ps_candidate(f, k, _, y) }.
.decl spt_2_project_sinks(fn: node, n: node, kind: symbol)
spt_2_project_sinks(f, n, k) :- spt_2_ps_candidate(f, k, n, s), spt_2_ps_start(f, k, s).

.decl spt_2_project_semantic(fn: node)
spt_2_project_semantic(c) :- spt_2_project_sinks(c, _, "semantic").
.decl spt_2_project_builder_rows(fn: node, n: node)
spt_2_project_builder_rows(c, n) :- spt_2_contexts(c, _, _), spt_2_project_sinks(c, n, "builder"), spt_2_ctx_planning(c), !spt_2_project_semantic(c).
spt_2_finding("state-flow-project-1", "SPT-028", n) :- spt_2_project_builder_rows(_, n), 0 != 0.

.decl spt_2_start(n: node, s: number)
spt_2_start(n, s) :- node(_, n, _, s, _).
.decl spt_2_dl_class_kind(k: symbol)
spt_2_dl_class_kind("class_definition").
.decl spt_2_dl_in_class(n: node)
spt_2_dl_in_class(n) :- nearest(n, _, spt_2_dl_class_kind).
.decl spt_2_dl_class_path(c: node, s: symbol)
spt_2_dl_class_path(c, t) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), !spt_2_dl_in_class(c).
spt_2_dl_class_path(c, s) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), nearest(c, a, spt_2_dl_class_kind),
    spt_2_dl_class_path(a, p), s = @concat(@concat(p, "."), t).
.decl spt_2_dl_class_prefix(n: node, s: symbol)
spt_2_dl_class_prefix(n, s) :- nearest(n, c, spt_2_dl_class_kind), spt_2_dl_class_path(c, p), s = @concat(p, ".").
spt_2_dl_class_prefix(n, "") :- kind(n, "function_definition"), !spt_2_dl_in_class(n).
.decl spt_2_dl_frame_kind(k: symbol)
spt_2_dl_frame_kind("function_definition").
spt_2_dl_frame_kind("class_definition").
.decl spt_2_dl_frame(f: node, t: symbol, fn: number)
spt_2_dl_frame(f, t, 1) :- kind(f, "function_definition"), field(f, "name", m), text(m, t).
spt_2_dl_frame(f, t, 0) :- kind(f, "class_definition"), field(f, "name", m), text(m, t).
.decl spt_2_dl_frame_parent(f: node, a: node)
spt_2_dl_frame_parent(f, a) :- spt_2_dl_frame(f, _, _), nearest(f, a, spt_2_dl_frame_kind).
.decl spt_2_dl_in_frame(n: node)
spt_2_dl_in_frame(n) :- spt_2_dl_frame_parent(n, _).
.decl spt_2_dl_qual(f: node, q: symbol, d: number)
spt_2_dl_qual(f, t, k) :- spt_2_dl_frame(f, t, k), !spt_2_dl_in_frame(f).
spt_2_dl_qual(f, s, d) :- spt_2_dl_frame(f, t, 1), spt_2_dl_frame_parent(f, a), spt_2_dl_qual(a, p, k), k > 0, d = k + 1,
    s = @concat(@concat(p, ".<locals>."), t).
spt_2_dl_qual(f, s, d) :- spt_2_dl_frame(f, t, x), spt_2_dl_frame_parent(f, a), spt_2_dl_qual(a, p, k), (x = 0; k = 0), d = k + x,
    s = @concat(@concat(p, "."), t).
.decl spt_2_dl_qualname(f: node, q: symbol)
spt_2_dl_qualname(f, q) :- spt_2_dl_qual(f, q, _).
.decl spt_2_dl_qualdepth(f: node, d: number)
spt_2_dl_qualdepth(f, d) :- spt_2_dl_qual(f, _, d).
spt_2_return_kind_entry(n,k) :- option_item("returnKindNames",i,n), option_item("returnKindValues",i,k).
spt_2_return_kind_entry(n,k) :- spt_generated(n,k), !option("entryPoint",_).

