.decl spt_3_branch(n: node, d: number)
spt_3_branch(n, d) :- spt_3_nodes(n), kind(n, "if_statement"), docof(n, d), doc(d, p, _), @rx(p, "/tests/") = 0, @rx(p, "auto_api|lazy_orm|query_builder") = 1.
spt_3_branch(n, d) :- spt_3_nodes(n), kind(n, "elif_clause"), docof(n, d), doc(d, p, _), @rx(p, "/tests/") = 0, @rx(p, "auto_api|lazy_orm|query_builder") = 1.
.decl spt_3_in_projection_scope(n: node)
spt_3_in_projection_scope(n) :- spt_3_branch(n, d), node(d, n, _, ns, ne), spt_3_projection_scopes(d, s, e), s < ns, e >= ne.
.decl spt_3_row_name(t: symbol)
spt_3_row_name("row"). spt_3_row_name("rows"). spt_3_row_name("alias"). spt_3_row_name("key"). spt_3_row_name("keys").
.decl spt_3_row_value(v: symbol)
spt_3_row_value("row"). spt_3_row_value("rows").
.decl spt_3_tests_rows(n: node)
spt_3_tests_rows(n) :- spt_3_branch(n, _), field(n, "condition", c), spt_3_descendants(c, a), kind(a, "identifier"), text(a, t), spt_3_row_name(t).
spt_3_tests_rows(n) :- spt_3_branch(n, d), field(n, "condition", c), spt_3_descendants(c, a), node(d, a, _, s, e), spt_3_string_values(d, s, e, v), spt_3_row_value(v).
.decl spt_3_tests_membership(n: node)
spt_3_tests_membership(n) :- spt_3_branch(n, _), field(n, "condition", c), spt_3_descendants(c, t), kind(t, "comparison_operator"), text(t, x),
    @rx(x, "\\b(?:in|is)\\b") = 1.
spt_3_tests_membership(n) :- spt_3_branch(n, _), field(n, "condition", c), spt_3_descendants(c, t), spt_3_calls(t, _, "isinstance").
.decl spt_3_recovery_callee(c: symbol)
spt_3_recovery_callee("evaluate"). spt_3_recovery_callee("execute"). spt_3_recovery_callee("execute_async"). spt_3_recovery_callee("resolve"). spt_3_recovery_callee("resolve_async").
.decl spt_3_recovery(r: node, d: number, s: number, e: number)
spt_3_recovery(r, d, s, e) :- spt_3_calls(r, _, c), spt_3_recovery_callee(c), node(d, r, _, s, e).
.decl spt_3_recovers(n: node)
spt_3_recovers(n) :- spt_3_branch(n, d), child(n, alt, _), spt_3_nodes(alt), kind(alt, "elif_clause"), node(d, alt, _, as, ae), spt_3_recovery(_, d, s, e),
    s >= as, e <= ae.
spt_3_recovers(n) :- spt_3_branch(n, d), child(n, alt, _), spt_3_nodes(alt), kind(alt, "else_clause"), node(d, alt, _, as, ae), spt_3_recovery(_, d, s, e),
    s >= as, e <= ae.
spt_3_recovers(n) :- spt_3_branch(n, d), nearest(n, f, spt_3_fdef), spt_3_functions(f, _), field(f, "body", b), child(b, stmt, _), spt_3_nodes(stmt), sl = dl_line1,
    nl = dl_line2, sl > nl, node(d, stmt, _, ts, te), spt_3_recovery(_, d, s, e), s >= ts, e <= te, line(stmt, dl_line1), line(n, dl_line2).
spt_3_finding("state-projection-recovery-2", "SPT-029", n) :- spt_3_branch(n, _), spt_3_in_projection_scope(n), spt_3_tests_rows(n), spt_3_tests_membership(n), spt_3_recovers(n).

.decl spt_3_start(n: node, s: number)
spt_3_start(n, s) :- node(_, n, _, s, _).
.decl spt_3_dl_class_kind(k: symbol)
spt_3_dl_class_kind("class_definition").
.decl spt_3_dl_in_class(n: node)
spt_3_dl_in_class(n) :- nearest(n, _, spt_3_dl_class_kind).
.decl spt_3_dl_class_path(c: node, s: symbol)
spt_3_dl_class_path(c, t) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), !spt_3_dl_in_class(c).
spt_3_dl_class_path(c, s) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), nearest(c, a, spt_3_dl_class_kind),
    spt_3_dl_class_path(a, p), s = @concat(@concat(p, "."), t).
.decl spt_3_dl_class_prefix(n: node, s: symbol)
spt_3_dl_class_prefix(n, s) :- nearest(n, c, spt_3_dl_class_kind), spt_3_dl_class_path(c, p), s = @concat(p, ".").
spt_3_dl_class_prefix(n, "") :- kind(n, "function_definition"), !spt_3_dl_in_class(n).
.decl spt_3_dl_frame_kind(k: symbol)
spt_3_dl_frame_kind("function_definition").
spt_3_dl_frame_kind("class_definition").
.decl spt_3_dl_frame(f: node, t: symbol, fn: number)
spt_3_dl_frame(f, t, 1) :- kind(f, "function_definition"), field(f, "name", m), text(m, t).
spt_3_dl_frame(f, t, 0) :- kind(f, "class_definition"), field(f, "name", m), text(m, t).
.decl spt_3_dl_frame_parent(f: node, a: node)
spt_3_dl_frame_parent(f, a) :- spt_3_dl_frame(f, _, _), nearest(f, a, spt_3_dl_frame_kind).
.decl spt_3_dl_in_frame(n: node)
spt_3_dl_in_frame(n) :- spt_3_dl_frame_parent(n, _).
.decl spt_3_dl_qual(f: node, q: symbol, d: number)
spt_3_dl_qual(f, t, k) :- spt_3_dl_frame(f, t, k), !spt_3_dl_in_frame(f).
spt_3_dl_qual(f, s, d) :- spt_3_dl_frame(f, t, 1), spt_3_dl_frame_parent(f, a), spt_3_dl_qual(a, p, k), k > 0, d = k + 1,
    s = @concat(@concat(p, ".<locals>."), t).
spt_3_dl_qual(f, s, d) :- spt_3_dl_frame(f, t, x), spt_3_dl_frame_parent(f, a), spt_3_dl_qual(a, p, k), (x = 0; k = 0), d = k + x,
    s = @concat(@concat(p, "."), t).
.decl spt_3_dl_qualname(f: node, q: symbol)
spt_3_dl_qualname(f, q) :- spt_3_dl_qual(f, q, _).
.decl spt_3_dl_qualdepth(f: node, d: number)
spt_3_dl_qualdepth(f, d) :- spt_3_dl_qual(f, _, d).
// StateRecovery: pinned source line 2718.
spt_result(n,q,"SPT-029","projection-recovery tripwire: tuple/projection extraction helpers must not treat missing projected row shape as permission to recover semantics in Python via evaluate/execute/resolve. Require lowered raw projection rows to contain the needed aliases/values.",n,2718,0,0) :- spt_3_finding(_,"SPT-029",n), spt_prefix(n,p), q = cat(p,"if").

.decl spt_4_fdef(kind: symbol)
spt_4_fdef("function_definition").
.decl spt_4_finding(clause: symbol, key: symbol, n: node)

.decl spt_4_syntax_gate(d: number)
spt_4_syntax_gate(d) :- ast(d, m, {"language": "python", "syntax": "valid", "rule": {"all": [{"any": [{"matches": "state-signature-source"}, {"inside": {"matches": "state-signature-source", "stopBy": "end"}}]}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"kind": "module"}]}]}]}}), doc_role(d,"primary").

.decl spt_4_excluded_kind(k: symbol)
spt_4_excluded_kind("comment"). spt_4_excluded_kind("string_start"). spt_4_excluded_kind("string_content"). spt_4_excluded_kind("string_end").
spt_4_excluded_kind("escape_sequence"). spt_4_excluded_kind("line_continuation").
.decl spt_4_nodes(n: node)
spt_4_nodes(n) :- spt_4_syntax_gate(d), node(d, n, k, _, _), !spt_4_excluded_kind(k).
.decl spt_4_earlier_sibling(n: node, b: node)
spt_4_earlier_sibling(n, b) :- spt_4_nodes(n), child(p, n, i), child(p, b, j), j < i, spt_4_nodes(b).
.decl spt_4_ordinal(n: node, i: number)
spt_4_ordinal(n, i) :- spt_4_nodes(n), i = count : { spt_4_earlier_sibling(n, _) }.
.decl spt_4_descendants(root: node, n: node)
spt_4_descendants(r, r) :- spt_4_nodes(r).
spt_4_descendants(r, n) :- spt_4_nodes(r), docof(r, d), node(d, n, _, _, _), spt_4_nodes(n), within(n, r).

.decl spt_4_functions(f: node, name: symbol)
spt_4_functions(f, name) :- spt_4_nodes(f), kind(f, "function_definition"), field(f, "name", x), text(x, name).
.decl spt_4_classes(c: node, name: symbol)
spt_4_classes(c, name) :- spt_4_nodes(c), kind(c, "class_definition"), field(c, "name", x), text(x, name).
.decl spt_4_methods(f: node, cls: node, class_name: symbol)
spt_4_methods(f, c, cn) :- spt_4_functions(f, _), child(b, f, _), spt_4_classes(c, cn), field(c, "body", b).
spt_4_methods(f, c, cn) :- spt_4_functions(f, _), child(w, f, _), spt_4_nodes(w), kind(w, "decorated_definition"), child(b, w, _), spt_4_classes(c, cn),
    field(c, "body", b).
.decl spt_4_attributes(a: node, attr: symbol, object: node, object_text: symbol)
spt_4_attributes(a, attr, o, ot) :- spt_4_nodes(a), kind(a, "attribute"), field(a, "attribute", x), text(x, attr), field(a, "object", o), text(o, ot).


.decl spt_4_assignments(n: node, target: node, target_kind: symbol, target_text: symbol)
spt_4_assignments(n, l, lk, lt) :- spt_4_nodes(n), kind(n, "assignment"), field(n, "left", l), spt_4_nodes(l), kind(l, lk), text(l, lt).
.decl spt_4_assignment_value(n: node, value: node)
spt_4_assignment_value(n, r) :- spt_4_assignments(n, _, _, _), field(n, "right", r), spt_4_nodes(r).
.decl spt_4_assignment_fn(n: node, fn: node)
spt_4_assignment_fn(n, f) :- spt_4_assignments(n, _, _, _), nearest(n, f, spt_4_fdef).

.decl spt_4_parameter_kind(k: symbol)
spt_4_parameter_kind("identifier"). spt_4_parameter_kind("typed_parameter"). spt_4_parameter_kind("default_parameter"). spt_4_parameter_kind("typed_default_parameter").
.decl spt_4_parameters(fn: node, p: node, kind: symbol, name: symbol)
spt_4_parameters(f, p, "identifier", name) :- spt_4_functions(f, _), field(f, "parameters", ps), child(ps, p, _), spt_4_nodes(p), kind(p, "identifier"), text(p, name).
spt_4_parameters(f, p, k, name) :- spt_4_functions(f, _), field(f, "parameters", ps), child(ps, p, _), spt_4_nodes(p), kind(p, k), spt_4_parameter_kind(k),
    child(p, n, _), spt_4_nodes(n), spt_4_ordinal(n, 0), kind(n, "identifier"), text(n, name).
.decl spt_4_parameter_annotation(p: node, annotation: node)
spt_4_parameter_annotation(p, t) :- spt_4_parameters(_, p, _, _), field(p, "type", t).
.decl spt_4_parameter_before(p: node, q: node)
spt_4_parameter_before(p, q) :- spt_4_parameters(f, p, _, _), spt_4_parameters(f, q, _, _), spt_4_start(p, ps), spt_4_start(q, qs), qs < ps.
.decl spt_4_parameter_position(p: node, position: number)
spt_4_parameter_position(p, i) :- spt_4_parameters(_, p, _, _), i = count : { spt_4_parameter_before(p, _) }.

.decl spt_4_class_base(c: node, text: symbol)
spt_4_class_base(c, t) :- spt_4_classes(c, _), child(c, bs, _), spt_4_nodes(bs), kind(bs, "argument_list"), child(bs, b, _), spt_4_nodes(b), kind(b, k),
    k != "keyword_argument", text(b, t).
.decl spt_4_step_classes(c: node)
spt_4_step_classes(c) :- spt_4_class_base(c, t), @rx(t, "(?:ServerPlanStep|IntentStep)") = 1.
.decl spt_4_step_class_intent(c: node)
spt_4_step_class_intent(c) :- spt_4_step_classes(c), spt_4_class_base(c, t), @rx(t, "IntentStep") = 1.

.decl spt_4_dataclasses(c: node, name: symbol)
spt_4_dataclasses(c, n) :- spt_4_classes(c, n), child(w, c, _), spt_4_nodes(w), kind(w, "decorated_definition"), text(w, wt),
    @rx(wt, "(?m)^\\s*@(?:[\\w.]*\\.)?dataclass\\b") = 1.
.decl spt_4_dataclass_static(c: node)
spt_4_dataclass_static(c) :- spt_4_dataclasses(c, n), child(w, c, _), text(w, wt), @rx(wt, "(?s)@(?:[\\w.]*\\.)?dataclass\\s*\\([^)]*\\bfrozen\\s*=\\s*True") = 1,
    @rx(n, "(?:Config|Payload)$") = 1.
.decl spt_4_dataclass_named(d: number, name: symbol)
spt_4_dataclass_named(d, n) :- spt_4_dataclasses(c, n), docof(c, d).

.decl spt_4_outer_function(m: node)
spt_4_outer_function(m) :- spt_4_methods(m, _, _), nearest(m, o, spt_4_fdef).
.decl spt_4_last_raise(m: node, s: node)
spt_4_last_raise(m, s) :- spt_4_methods(m, _, _), field(m, "body", b), child(b, s, _), spt_4_nodes(s), kind(s, "raise_statement"), text(s, t),
    @rx(t, "^raise\\s+NotImplementedError\\s*\\(") = 1.
.decl spt_4_stub_prefix_kind(k: symbol)
spt_4_stub_prefix_kind("expression_statement"). spt_4_stub_prefix_kind("delete_statement"). spt_4_stub_prefix_kind("pass_statement").
.decl spt_4_raise_other(s: node)
spt_4_raise_other(s) :- spt_4_last_raise(_, s), child(b, s, _), child(b, o, _), spt_4_nodes(o), kind(o, k), k != "comment", spt_4_start(o, os), spt_4_start(s, ss), os > ss.
spt_4_raise_other(s) :- spt_4_last_raise(_, s), child(b, s, _), child(b, o, _), spt_4_nodes(o), kind(o, k), k != "comment", spt_4_start(o, os), spt_4_start(s, ss), os < ss,
    !spt_4_stub_prefix_kind(k).
.decl spt_4_value_kind(k: symbol)
spt_4_value_kind("assignment"). spt_4_value_kind("string"). spt_4_value_kind("concatenated_string"). spt_4_value_kind("integer"). spt_4_value_kind("float").
spt_4_value_kind("none"). spt_4_value_kind("true"). spt_4_value_kind("false").
.decl spt_4_expression_with_value(e: node)
spt_4_expression_with_value(e) :- spt_4_nodes(e), kind(e, "expression_statement"), child(e, v, _), spt_4_nodes(v), kind(v, k), spt_4_value_kind(k).
.decl spt_4_raise_bare_expression(s: node)
spt_4_raise_bare_expression(s) :- spt_4_last_raise(_, s), child(b, s, _), child(b, e, _), spt_4_nodes(e), kind(e, "expression_statement"), !spt_4_expression_with_value(e).
.decl spt_4_stub_method(m: node)
spt_4_stub_method(m) :- spt_4_last_raise(m, s), !spt_4_raise_other(s), !spt_4_raise_bare_expression(s).
.decl spt_4_signature_methods(m: node)
spt_4_signature_methods(m) :- spt_4_methods(m, c, _), spt_4_step_classes(c), !spt_4_outer_function(m), !spt_4_stub_method(m).
.decl spt_4_signature_method_intent(m: node)
spt_4_signature_method_intent(m) :- spt_4_signature_methods(m), spt_4_methods(m, c, _), spt_4_step_class_intent(c).

.decl spt_4_annotation_head(n: node, head: symbol)
spt_4_annotation_head(n, h) :- spt_4_nodes(n), kind(n, "type"), text(n, t), h = @rx_extract(t, "^\\s*(?:[\\w.]+\\.)?([A-Za-z_]\\w*)", 1).
.decl spt_4_annotations(n: node, text: symbol, head: symbol)
spt_4_annotations(n, t, h) :- spt_4_annotation_head(n, h), text(n, t).
spt_4_annotations(n, t, "") :- spt_4_nodes(n), kind(n, "type"), text(n, t), !spt_4_has_annotation_head(n).
.decl spt_4_has_annotation_head(n: node)
spt_4_has_annotation_head(n) :- spt_4_annotation_head(n, _).
.decl spt_4_annotation_union_type(n: node)
spt_4_annotation_union_type(n) :- spt_4_annotations(n, _, _), spt_4_descendants(n, a), kind(a, "union_type"), text(a, t), @sql_instr(t, "|") > 0.
spt_4_annotation_union_type(n) :- spt_4_annotations(n, _, _), spt_4_descendants(n, a), kind(a, "binary_operator"), text(a, t), @sql_instr(t, "|") > 0.
spt_4_annotation_union_type(n) :- spt_4_annotations(n, _, _), spt_4_descendants(n, a), kind(a, "identifier"), text(a, "Union").
spt_4_annotation_union_type(n) :- spt_4_annotations(n, _, _), spt_4_descendants(n, a), kind(a, "identifier"), text(a, "Optional").
.decl spt_4_annotation_server_ref(n: node)
spt_4_annotation_server_ref(n) :- spt_4_annotations(n, _, _), spt_4_descendants(n, a), kind(a, "identifier"), text(a, t), @rx(t, "ServerRef$") = 1.

.decl spt_4_annotation_basic(n: node)
spt_4_annotation_basic(n) :- spt_4_annotation_server_ref(n), !spt_4_annotation_union_type(n).
spt_4_annotation_basic(n) :- spt_4_annotations(n, t, "type"), !spt_4_annotation_union_type(n), @sql_instr(t, "[") > 0.
spt_4_annotation_basic(n) :- spt_4_annotations(n, t, _), !spt_4_annotation_union_type(n),
    @rx(t, "^\\s*(?:[A-Za-z_]\\w*\\.)*(?:BackendType|BranchTipMaterialization|CommitBranchContextRefId|ScopedCleanupMode|ServerPlanRefId|SessionId|SqlIndexName|SqlTableName|SysId|VectorBackendKind|VectorIndexMaintenanceOperation)\\s*$") = 1.
spt_4_annotation_basic(n) :- spt_4_annotations(n, t, _), !spt_4_annotation_union_type(n),
    @rx(t, "^\\s*(?:(?:[A-Za-z_]\\w*\\.)*frozenset\\s*\\[\\s*)+(?:[A-Za-z_]\\w*\\.)*(?:BackendType|BranchTipMaterialization|CommitBranchContextRefId|ScopedCleanupMode|ServerPlanRefId|SessionId|SqlIndexName|SqlTableName|SysId|VectorBackendKind|VectorIndexMaintenanceOperation)\\s*(?:\\]\\s*)+$") = 1.

.decl spt_4_config_fields(a: node, d: number, cls: symbol)
spt_4_config_fields(a, d, cn) :- spt_4_assignments(a, _, _, _), field(a, "type", _), child(stmt, a, _), spt_4_nodes(stmt), child(b, stmt, _), spt_4_dataclasses(c, cn),
    field(c, "body", b), docof(a, d).
.decl spt_4_config_field_annotation(a: node, annotation: node)
spt_4_config_field_annotation(a, t) :- spt_4_config_fields(a, _, _), field(a, "type", t), spt_4_annotations(t, _, _).
.decl spt_4_has_config_field(d: number, cls: symbol)
spt_4_has_config_field(d, cn) :- spt_4_config_fields(_, d, cn).

.decl spt_4_bad_configs(d: number, name: symbol)
spt_4_bad_configs(d, n) :- spt_4_dataclasses(c, n), !spt_4_dataclass_static(c), docof(c, d), !spt_4_has_config_field(d, n).
spt_4_bad_configs(d, n) :- spt_4_dataclasses(c, n), !spt_4_dataclass_static(c), docof(c, d), spt_4_config_fields(f, d, n), !spt_4_config_field_annotation(f, _).
spt_4_bad_configs(d, n) :- spt_4_dataclasses(c, n), !spt_4_dataclass_static(c), docof(c, d), spt_4_config_fields(f, d, n), spt_4_config_field_annotation(f, t),
    !spt_4_annotation_basic(t), spt_4_annotations(t, _, h), !spt_4_dataclass_named(d, h).
spt_4_bad_configs(d, n) :- spt_4_dataclasses(c, n), !spt_4_dataclass_static(c), docof(c, d), spt_4_config_fields(f, d, n), spt_4_config_field_annotation(f, t),
    !spt_4_annotation_basic(t), spt_4_annotations(t, _, h), spt_4_bad_configs(d, h).

.decl spt_4_signature_parameters(p: node, fn: node, kind: symbol, name: symbol, method: symbol)
spt_4_signature_parameters(p, f, k, name, mn) :- spt_4_parameters(f, p, k, name), spt_4_signature_methods(f), spt_4_functions(f, mn).
.decl spt_4_signature_parameter_intent(p: node)
spt_4_signature_parameter_intent(p) :- spt_4_signature_parameters(p, f, _, _, _), spt_4_signature_method_intent(f).
.decl spt_4_signature_parameter_contract(p: node, a: node, head: symbol)
spt_4_signature_parameter_contract(p, a, h) :- spt_4_signature_parameters(p, _, _, _, _), spt_4_parameter_annotation(p, a), spt_4_annotations(a, _, h).
.decl spt_4_signature_parameter_allowed(p: node)
spt_4_signature_parameter_allowed(p) :- spt_4_signature_parameter_contract(p, a, _), spt_4_annotation_basic(a).
spt_4_signature_parameter_allowed(p) :- spt_4_signature_parameter_contract(p, _, h), docof(p, d), spt_4_dataclass_named(d, h), !spt_4_bad_configs(d, h).
.decl spt_4_raw_builtin_name(t: symbol)
spt_4_raw_builtin_name("str"). spt_4_raw_builtin_name("int"). spt_4_raw_builtin_name("float"). spt_4_raw_builtin_name("bool"). spt_4_raw_builtin_name("bytes").
.decl spt_4_signature_parameter_raw_builtin(p: node)
spt_4_signature_parameter_raw_builtin(p) :- spt_4_signature_parameters(p, _, _, _, _), spt_4_parameter_annotation(p, a), spt_4_descendants(a, x), kind(x, "identifier"),
    text(x, t), spt_4_raw_builtin_name(t).

.decl spt_4_shape_attributes(cls: node, name: symbol)
spt_4_shape_attributes(c, an) :- spt_4_signature_parameters(p, f, _, pn, "__init__"), spt_4_signature_parameter_intent(p), pn != "self", pn != "ref_id",
    !spt_4_signature_parameter_allowed(p), spt_4_methods(f, c, _), spt_4_assignment_fn(a, f), spt_4_assignment_value(a, v), spt_4_descendants(v, x), kind(x, "identifier"),
    text(x, pn), spt_4_assignments(a, t, _, _), spt_4_attributes(t, an, _, "self").

.decl spt_4_shape_values(fn: node, n: node)
spt_4_shape_values(m, a) :- spt_4_methods(m, c, _), spt_4_functions(m, "lower"), spt_4_attributes(a, an, _, "self"), within(a, m), spt_4_shape_attributes(c, an).
spt_4_shape_values(f, r) :- spt_4_shape_values(f, n), spt_4_descendants(r, n).
spt_4_shape_values(f, x) :- spt_4_shape_values(f, v), spt_4_assignment_value(a, v), spt_4_assignment_fn(a, f), spt_4_assignments(a, _, "identifier", tt), docof(a, d),
    node(d, x, "identifier", _, _), spt_4_nodes(x), text(x, tt), within(x, f).

.decl spt_4_shape_branch_test(n: node, test: node)
spt_4_shape_branch_test(n, t) :- spt_4_nodes(n), kind(n, "conditional_expression"), child(n, t, _), spt_4_nodes(t), spt_4_ordinal(t, 1).
spt_4_shape_branch_test(n, t) :- spt_4_nodes(n), kind(n, "if_statement"), field(n, "condition", t).
spt_4_shape_branch_test(n, t) :- spt_4_nodes(n), kind(n, "elif_clause"), field(n, "condition", t).
spt_4_shape_branch_test(n, t) :- spt_4_nodes(n), kind(n, "while_statement"), field(n, "condition", t).
spt_4_shape_branch_test(n, n) :- spt_4_nodes(n), kind(n, "not_operator").
spt_4_shape_branch_test(n, n) :- spt_4_nodes(n), kind(n, "boolean_operator").
.decl spt_4_shape_branches(fn: node, line: number)
spt_4_shape_branches(m, l) :- spt_4_methods(m, _, _), spt_4_functions(m, "lower"), spt_4_shape_branch_test(n, t), within(n, m), spt_4_shape_values(m, t), l = dl_line1, line(n, dl_line1).

.decl spt_4_config_parameter(p: node)
spt_4_config_parameter(p) :- spt_4_signature_parameters(p, _, _, "config", _), spt_4_signature_parameter_contract(p, _, h), docof(p, d), spt_4_dataclass_named(d, h).
spt_4_finding("state-signatures-1", "SPT-015", p) :- spt_4_signature_parameters(p, _, _, n, _), n != "self", n != "ref_id", spt_4_signature_parameter_raw_builtin(p),
    !spt_4_config_parameter(p).
spt_4_finding("state-signatures-1", "SPT-016", p) :- spt_4_signature_parameters(p, _, "default_parameter", n, "__init__"), spt_4_signature_parameter_intent(p), n != "self",
    n != "ref_id".
spt_4_finding("state-signatures-1", "SPT-016", p) :- spt_4_signature_parameters(p, _, "typed_default_parameter", n, "__init__"), spt_4_signature_parameter_intent(p),
    n != "self", n != "ref_id".
spt_4_finding("state-signatures-1", "SPT-017", p) :- spt_4_signature_parameters(p, _, _, n, "__init__"), spt_4_signature_parameter_intent(p), n != "self", n != "ref_id",
    !spt_4_signature_parameter_allowed(p).
spt_4_finding("state-signatures-1", "SPT-013", p) :- spt_4_signature_parameters(p, _, _, n, "__init__"), n != "self", spt_4_signature_parameter_contract(p, a, _),
    spt_4_annotation_server_ref(a), spt_4_annotation_union_type(a).
spt_4_finding("state-signatures-1", "SPT-014", p) :- spt_4_signature_parameters(p, _, _, n, "__init__"), n != "self", @sql_instr(@sql_lower(n), "table") > 0,
    @sql_instr(@sql_lower(n), "alias") = 0, spt_4_parameter_annotation(p, a), spt_4_descendants(a, x), kind(x, "identifier"), text(x, "str").
.decl spt_4_line_node(fn: node, line: number, n: node)
spt_4_line_node(f, l, n) :- spt_4_shape_branches(f, l), docof(f, d), node(d, n, _, _, _), spt_4_nodes(n), l = dl_line2, line(n, dl_line2).
.decl spt_4_line_start(fn: node, line: number, s: number)
spt_4_line_start(f, l, s) :- spt_4_line_node(f, l, n), spt_4_start(n, s).
.decl spt_4_line_first_start(fn: node, line: number, s: number)
spt_4_line_first_start(f, l, s) :- spt_4_line_start(f, l, _), s = min t : { spt_4_line_start(f, l, t) }.
.decl spt_4_line_end(fn: node, line: number, e: number)
spt_4_line_end(f, l, e) :- spt_4_line_node(f, l, n), node(_, n, _, s, e), spt_4_line_first_start(f, l, s).
.decl spt_4_line_last_end(fn: node, line: number, e: number)
spt_4_line_last_end(f, l, e) :- spt_4_line_end(f, l, _), e = max x : { spt_4_line_end(f, l, x) }.
spt_4_finding("state-signatures-1", "SPT-018", n) :- spt_4_line_node(f, l, n), node(_, n, _, s, e), spt_4_line_first_start(f, l, s), spt_4_line_last_end(f, l, e).

.decl spt_4_start(n: node, s: number)
spt_4_start(n, s) :- node(_, n, _, s, _).
.decl spt_4_dl_class_kind(k: symbol)
spt_4_dl_class_kind("class_definition").
.decl spt_4_dl_in_class(n: node)
spt_4_dl_in_class(n) :- nearest(n, _, spt_4_dl_class_kind).
.decl spt_4_dl_class_path(c: node, s: symbol)
spt_4_dl_class_path(c, t) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), !spt_4_dl_in_class(c).
spt_4_dl_class_path(c, s) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), nearest(c, a, spt_4_dl_class_kind),
    spt_4_dl_class_path(a, p), s = @concat(@concat(p, "."), t).
.decl spt_4_dl_class_prefix(n: node, s: symbol)
spt_4_dl_class_prefix(n, s) :- nearest(n, c, spt_4_dl_class_kind), spt_4_dl_class_path(c, p), s = @concat(p, ".").
spt_4_dl_class_prefix(n, "") :- kind(n, "function_definition"), !spt_4_dl_in_class(n).
.decl spt_4_dl_frame_kind(k: symbol)
spt_4_dl_frame_kind("function_definition").
spt_4_dl_frame_kind("class_definition").
.decl spt_4_dl_frame(f: node, t: symbol, fn: number)
spt_4_dl_frame(f, t, 1) :- kind(f, "function_definition"), field(f, "name", m), text(m, t).
spt_4_dl_frame(f, t, 0) :- kind(f, "class_definition"), field(f, "name", m), text(m, t).
.decl spt_4_dl_frame_parent(f: node, a: node)
spt_4_dl_frame_parent(f, a) :- spt_4_dl_frame(f, _, _), nearest(f, a, spt_4_dl_frame_kind).
.decl spt_4_dl_in_frame(n: node)
spt_4_dl_in_frame(n) :- spt_4_dl_frame_parent(n, _).
.decl spt_4_dl_qual(f: node, q: symbol, d: number)
spt_4_dl_qual(f, t, k) :- spt_4_dl_frame(f, t, k), !spt_4_dl_in_frame(f).
spt_4_dl_qual(f, s, d) :- spt_4_dl_frame(f, t, 1), spt_4_dl_frame_parent(f, a), spt_4_dl_qual(a, p, k), k > 0, d = k + 1,
    s = @concat(@concat(p, ".<locals>."), t).
spt_4_dl_qual(f, s, d) :- spt_4_dl_frame(f, t, x), spt_4_dl_frame_parent(f, a), spt_4_dl_qual(a, p, k), (x = 0; k = 0), d = k + x,
    s = @concat(@concat(p, "."), t).
.decl spt_4_dl_qualname(f: node, q: symbol)
spt_4_dl_qualname(f, q) :- spt_4_dl_qual(f, q, _).
.decl spt_4_dl_qualdepth(f: node, d: number)
spt_4_dl_qualdepth(f, d) :- spt_4_dl_qual(f, _, d).
