// StateFlow21: pinned source line 2894.
spt_result(n,q,"SPT-023","runtime-materialization tripwire: compile-owned post_op/post_op_with_refs callbacks must not convert raw rows into Python model objects. Keep published refs/raw rows SQL-owned through the pipeline and only materialize inside postprocess(), after SQL has already produced the final result shape.",n,2894,0,0) :- spt_1_calls(n, _, _, _, "convert_row_to_model"), spt_1_outside_tests(n), docof(n, d), spt_1_functions(nested, _), docof(nested, d),
    within(n, nested), spt_1_parameters(nested, _, pn, _), spt_1_callback_parameters(of, pn, _, _), spt_1_contexts(of, _, _), within(nested, of), spt_qual(n,q).

.decl spt_1_fdef(kind: symbol)
spt_1_fdef("function_definition").
.decl spt_1_cdef(kind: symbol)
spt_1_cdef("class_definition").
.decl spt_1_finding(clause: symbol, key: symbol, n: node)

.decl spt_1_raw_strings(d: number, s: number, e: number, value: symbol)
spt_1_raw_strings(d, s, e, v) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}, {"filePath": {"regex": "(?s).*"}}]}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), node(d, x, _, s, e), doc_role(d,"primary").
spt_1_raw_strings(d, s, e, v) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"all": [{"not": {"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}[a-z]"}]}, {"filePath": {"regex": "(?s).*"}}]}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), node(d, x, _, s, e), doc_role(d,"primary").
spt_1_raw_strings(d, s, e, v) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"not": {"any": [{"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}[a-z]"}]}}, {"filePath": {"regex": "(?s).*"}}]}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), node(d, x, _, s, e), doc_role(d,"primary").
.decl spt_1_project_mode(d: number)
spt_1_project_mode(d) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"kind": "module"}, {"filePath": {"regex": "(?s).*"}}]}]}]}]}}), doc_role(d,"primary").
.decl spt_1_syntax_gate(d: number)
spt_1_syntax_gate(d) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"kind": "module"}]}]}]}]}}), doc_role(d,"primary").

.decl spt_1_excluded_kind(k: symbol)
spt_1_excluded_kind("comment"). spt_1_excluded_kind("string_start"). spt_1_excluded_kind("string_content"). spt_1_excluded_kind("string_end").
spt_1_excluded_kind("escape_sequence"). spt_1_excluded_kind("line_continuation").
.decl spt_1_gnode(n: node)
spt_1_gnode(n) :- node(d, n, k, _, _), spt_1_syntax_gate(d), !spt_1_excluded_kind(k).
.decl spt_1_own_fn(x: node, f: node)
spt_1_own_fn(x, x) :- spt_1_gnode(x), kind(x, "function_definition").
spt_1_own_fn(x, f) :- spt_1_gnode(x), !kind(x, "function_definition"), nearest(x, f, spt_1_fdef).
.decl spt_1_own_cls(x: node, c: node)
spt_1_own_cls(x, x) :- spt_1_gnode(x), kind(x, "class_definition").
spt_1_own_cls(x, c) :- spt_1_gnode(x), !kind(x, "class_definition"), nearest(x, c, spt_1_cdef).
.decl spt_1_nested_fn(f: node)
spt_1_nested_fn(f) :- kind(f, "function_definition"), nearest(f, g, spt_1_fdef).
.decl spt_1_fn_top(f: node, t: node)
spt_1_fn_top(f, f) :- kind(f, "function_definition"), !spt_1_nested_fn(f).
spt_1_fn_top(f, t) :- spt_1_nested_fn(f), docof(f, d), kind(t, "function_definition"), docof(t, d), !spt_1_nested_fn(t), within(f, t).
.decl spt_1_own_top(x: node, t: node)
spt_1_own_top(x, t) :- spt_1_own_fn(x, f), spt_1_fn_top(f, t).

.decl spt_1_functions(f: node, name: symbol)
spt_1_functions(f, name) :- spt_1_gnode(f), kind(f, "function_definition"), field(f, "name", x), text(x, name).
.decl spt_1_attributes(n: node, attr: symbol, object: node, object_text: symbol)
spt_1_attributes(n, a, o, ot) :- spt_1_gnode(n), kind(n, "attribute"), field(n, "attribute", x), text(x, a), field(n, "object", o), text(o, ot).
.decl spt_1_calls(n: node, callee_id: node, callee_kind: symbol, full_callee: symbol, callee: symbol)
spt_1_calls(n, f, k, t, a) :- spt_1_gnode(n), kind(n, "call"), field(n, "function", f), spt_1_gnode(f), kind(f, k), text(f, t), spt_1_attributes(f, a, _, _).
spt_1_calls(n, f, k, t, t) :- spt_1_gnode(n), kind(n, "call"), field(n, "function", f), spt_1_gnode(f), kind(f, k), text(f, t), !spt_1_attributes(f, _, _, _).
.decl spt_1_call_receiver(n: node, receiver: node)
spt_1_call_receiver(n, o) :- spt_1_calls(n, f, _, _, _), spt_1_attributes(f, _, o, _).

.decl spt_1_arg_skip(k: symbol)
spt_1_arg_skip("comment"). spt_1_arg_skip("keyword_argument"). spt_1_arg_skip("list_splat"). spt_1_arg_skip("dictionary_splat").
.decl spt_1_arg_row(call: node, a: node)
spt_1_arg_row(c, a) :- spt_1_calls(c, _, _, _, _), field(c, "arguments", l), child(l, a, _), spt_1_gnode(a), kind(a, k), !spt_1_arg_skip(k).
.decl spt_1_arg_before(call: node, a: node, b: node)
spt_1_arg_before(c, a, b) :- spt_1_arg_row(c, a), spt_1_arg_row(c, b), spt_1_start(a, sa), spt_1_start(b, sb), sb < sa.
.decl spt_1_has_arg_before(a: node)
spt_1_has_arg_before(a) :- spt_1_arg_before(_, a, _).
.decl spt_1_arguments(call: node, a: node, position: number)
spt_1_arguments(c, a, 0) :- spt_1_arg_row(c, a), !spt_1_has_arg_before(a).
spt_1_arguments(c, a, p) :- spt_1_arg_row(c, a), spt_1_has_arg_before(a), p = count : { spt_1_arg_before(c, a, _) }.

.decl spt_1_keywords(call: node, keyword: node, name: symbol, value: node)
spt_1_keywords(c, k, name, v) :- spt_1_calls(c, _, _, _, _), field(c, "arguments", l), child(l, k, _), spt_1_gnode(k), kind(k, "keyword_argument"),
    field(k, "name", kn), spt_1_gnode(kn), text(kn, name), field(k, "value", v), spt_1_gnode(v).

.decl spt_1_no_expand(k: symbol)
spt_1_no_expand("module"). spt_1_no_expand("block"). spt_1_no_expand("expression_statement"). spt_1_no_expand("argument_list").
spt_1_no_expand("decorated_definition"). spt_1_no_expand("type").
.decl spt_1_descendants(root: node, n: node)
spt_1_descendants(r, r) :- spt_1_gnode(r).
spt_1_descendants(r, n) :- spt_1_gnode(r), kind(r, k), !spt_1_no_expand(k), docof(r, d), spt_1_gnode(n), docof(n, d), within(n, r).

.decl spt_1_assignments(n: node, target: node, target_kind: symbol, target_text: symbol)
spt_1_assignments(n, l, k, t) :- spt_1_gnode(n), kind(n, "assignment"), field(n, "left", l), spt_1_gnode(l), kind(l, k), text(l, t).
.decl spt_1_assignment_value(n: node, value: node)
spt_1_assignment_value(n, r) :- spt_1_assignments(n, _, _, _), field(n, "right", r), spt_1_gnode(r).
.decl spt_1_assignment_fn(n: node, fn: node)
spt_1_assignment_fn(n, f) :- spt_1_assignments(n, _, _, _), spt_1_own_fn(n, f).

.decl spt_1_param_kind(k: symbol)
spt_1_param_kind("typed_parameter"). spt_1_param_kind("default_parameter"). spt_1_param_kind("typed_default_parameter").
.decl spt_1_param_row(fn: node, p: node, name: symbol)
spt_1_param_row(f, p, name) :- spt_1_functions(f, _), field(f, "parameters", ps), child(ps, p, _), spt_1_gnode(p), kind(p, "identifier"), text(p, name).
spt_1_param_row(f, p, name) :- spt_1_functions(f, _), field(f, "parameters", ps), child(ps, p, _), spt_1_gnode(p), kind(p, k), spt_1_param_kind(k),
    child(p, n, 0), spt_1_gnode(n), kind(n, "identifier"), text(n, name).
.decl spt_1_param_before(fn: node, p: node, q: node)
spt_1_param_before(f, p, q) :- spt_1_param_row(f, p, _), spt_1_param_row(f, q, _), spt_1_start(p, sp), spt_1_start(q, sq), sq < sp.
.decl spt_1_has_param_before(p: node)
spt_1_has_param_before(p) :- spt_1_param_before(_, p, _).
.decl spt_1_parameters(fn: node, p: node, name: symbol, position: number)
spt_1_parameters(f, p, n, 0) :- spt_1_param_row(f, p, n), !spt_1_has_param_before(p).
spt_1_parameters(f, p, n, i) :- spt_1_param_row(f, p, n), spt_1_has_param_before(p), i = count : { spt_1_param_before(f, p, _) }.
.decl spt_1_annotation_text(p: node, text: symbol)
spt_1_annotation_text(p, s) :- spt_1_param_row(_, p, _), field(p, "type", t), spt_1_gnode(t), text(t, s).

.decl spt_1_contexts(f: node, name: symbol, class_name: symbol)
.decl spt_1_planning_name(n: symbol)
spt_1_planning_name("compile"). spt_1_planning_name("lower"). spt_1_planning_name("post_op"). spt_1_planning_name("pre_op"). spt_1_planning_name("preprocess").
.decl spt_1_ctx_planning(f: node)
.decl spt_1_ctx_preprocess(f: node)
spt_1_ctx_preprocess(f) :- spt_1_contexts(f, "preprocess", _).
.decl spt_1_ctx_helper(f: node)
.decl spt_1_ctx_provider_helper(f: node)
spt_1_ctx_provider_helper(f) :- spt_1_contexts(f, n, _), docof(f, d), doc(d, "impl/common/l2070_server_plan/backend_profiles.py", _),
    @rx(n, "component|components|score|scores") = 1.
.decl spt_1_ctx_materializer(f: node)
.decl spt_1_body_nodes(fn: node, n: node)
spt_1_body_nodes(f, x) :- spt_1_own_top(x, f), spt_1_contexts(f, _, _).

.decl spt_1_callback_keyword(k: symbol)
spt_1_callback_keyword("post_op"). spt_1_callback_keyword("post_op_with_refs").
.decl spt_1_callback_parameters(fn: node, name: symbol, callback_kind: symbol, position: number)
spt_1_callback_parameters(c, name, kn, i) :- spt_1_contexts(c, _, _), docof(c, d), spt_1_calls(call, _, _, _, "CompiledStep"), docof(call, d), within(call, c),
    spt_1_keywords(call, _, kn, v), spt_1_callback_keyword(kn), kind(v, "identifier"), text(v, vt), spt_1_functions(nested, vt), docof(nested, d),
    within(nested, c), spt_1_parameters(nested, _, name, i), i >= 1, i <= 2.

.decl spt_1_authority_param(n: symbol)
spt_1_authority_param("txn"). spt_1_authority_param("read_txn"). spt_1_authority_param("write_txn"). spt_1_authority_param("conn"). spt_1_authority_param("connection").
spt_1_authority_param("sql_conn").
.decl spt_1_carrier_param(n: symbol)
spt_1_carrier_param("hydrator"). spt_1_carrier_param("runtime_hydrator"). spt_1_carrier_param("runtime_refs").
.decl spt_1_parameter_kinds(fn: node, name: symbol, kind: symbol)
spt_1_parameter_kinds(f, n, "authority") :- spt_1_parameters(f, _, n, _), spt_1_authority_param(n), spt_1_fact_context(f).
spt_1_parameter_kinds(f, n, "authority") :- spt_1_parameters(f, p, n, _), spt_1_annotation_text(p, t), @rx(t, "\\b(?:ReadTransaction|SyncDatabaseConnection|SyncSqlConnection|WriteTransaction)\\b") = 1, spt_1_fact_context(f).
spt_1_parameter_kinds(f, n, "provider") :- spt_1_parameters(f, p, n, _), spt_1_annotation_text(p, t), @rx(t, "\\b(?:CrossBranchQueryProvider|HybridSearchProvider|VectorCandidateProvider|VersionedLoweringProvider|VersionedStorageProvider)\\b") = 1, spt_1_fact_context(f).
spt_1_parameter_kinds(f, "resolved", "runtime_value") :- spt_1_parameters(f, _, "resolved", _), spt_1_fact_context(f).
spt_1_parameter_kinds(f, n, "runtime_value") :- spt_1_parameters(f, p, n, _), spt_1_annotation_text(p, t), @rx(t, "\\bResolvedRefs\\b") = 1, spt_1_fact_context(f).
spt_1_parameter_kinds(f, "runtime_refs", "runtime_value") :- spt_1_parameters(f, _, "runtime_refs", _), spt_1_ctx_materializer(f), spt_1_fact_context(f).
spt_1_parameter_kinds(f, n, "carrier") :- spt_1_parameters(f, _, n, _), spt_1_carrier_param(n), spt_1_fact_context(f).
spt_1_parameter_kinds(f, n, "carrier") :- spt_1_parameters(f, p, n, _), spt_1_annotation_text(p, t), @rx(t, "\\bHydrator\\b") = 1, spt_1_fact_context(f).
spt_1_parameter_kinds(f, n, "carrier") :- spt_1_callback_parameters(f, n, _, 1), spt_1_fact_context(f).
spt_1_parameter_kinds(f, n, "runtime_value") :- spt_1_callback_parameters(f, n, "post_op_with_refs", 2), spt_1_fact_context(f).
spt_1_parameter_kinds(f, n, "carrier") :- spt_1_callback_parameters(f, n, "post_op_with_refs", 2), spt_1_fact_context(f).

.decl spt_1_module_strings(d: number, name: symbol, value: symbol)
spt_1_module_strings(d, name, v) :- spt_1_assignments(a, _, "identifier", name), child(stmt, a, _), spt_1_gnode(stmt), child(root, stmt, _), spt_1_gnode(root),
    kind(root, "module"), field(a, "right", r), node(d, r, _, s, e), spt_1_raw_strings(d, s, e, v).
.decl spt_1_string_values(d: number, s: number, e: number, value: symbol)
spt_1_string_values(d, s, e, v) :- spt_1_raw_strings(d, s, e, v).
spt_1_string_values(d, s, e, v) :- spt_1_gnode(n), kind(n, "identifier"), text(n, name), node(d, n, _, s, e), spt_1_module_strings(d, name, v).

.decl spt_1_ctx_attr(a: symbol)
spt_1_ctx_attr("materialized_pipeline"). spt_1_ctx_attr("sql_connection"). spt_1_ctx_attr("txn").
.decl spt_1_carrier_attr(a: symbol)
spt_1_carrier_attr("_conn"). spt_1_carrier_attr("_serverplan_runtime_txn"). spt_1_carrier_attr("_serverplan_sql_conn"). spt_1_carrier_attr("_txn").
spt_1_carrier_attr("conn"). spt_1_carrier_attr("connection"). spt_1_carrier_attr("sql_conn"). spt_1_carrier_attr("txn").
.decl spt_1_special_attributes(fn: node, n: node, owner: symbol, attr: symbol)
spt_1_special_attributes(f, a, "context", at) :- spt_1_attributes(a, at, _, "ctx"), spt_1_ctx_attr(at), spt_1_body_nodes(f, a), spt_1_fact_context(f).
spt_1_special_attributes(f, a, "carrier", at) :- spt_1_attributes(a, at, _, ot), ot != "ctx", spt_1_carrier_attr(at), spt_1_body_nodes(f, a), spt_1_parameter_kinds(f, ot, "carrier"), spt_1_fact_context(f).
spt_1_special_attributes(f, a, "carrier", at) :- spt_1_attributes(a, at, _, "ctx"), spt_1_carrier_attr(at), !spt_1_ctx_attr(at), spt_1_body_nodes(f, a), spt_1_parameter_kinds(f, "ctx", "carrier"), spt_1_fact_context(f).
spt_1_special_attributes(f, c, "context", v) :- spt_1_calls(c, _, _, "getattr", _), spt_1_body_nodes(f, c), spt_1_arguments(c, r, 0), kind(r, "identifier"), text(r, "ctx"),
    spt_1_arguments(c, k, 1), node(d, k, _, s, e), spt_1_string_values(d, s, e, v), spt_1_ctx_attr(v), spt_1_fact_context(f).
spt_1_special_attributes(f, c, "context", v) :- spt_1_calls(c, _, _, "getattr", _), spt_1_body_nodes(f, c), spt_1_arguments(c, r, 0), kind(r, "identifier"), text(r, "ctx"),
    spt_1_arguments(c, k, 1), node(d, k, _, s, e), spt_1_string_values(d, s, e, v), spt_1_carrier_attr(v), spt_1_parameter_kinds(f, "ctx", "carrier"), spt_1_fact_context(f).
spt_1_special_attributes(f, c, "carrier", v) :- spt_1_calls(c, _, _, "getattr", _), spt_1_body_nodes(f, c), spt_1_arguments(c, r, 0), kind(r, "identifier"), text(r, rt),
    rt != "ctx", spt_1_arguments(c, k, 1), node(d, k, _, s, e), spt_1_string_values(d, s, e, v), spt_1_carrier_attr(v), spt_1_parameter_kinds(f, rt, "carrier"), spt_1_fact_context(f).
spt_1_special_attributes(f, c, "carrier", v) :- spt_1_calls(c, g, _, _, "get"), spt_1_body_nodes(f, c), spt_1_attributes(g, _, _, ot), spt_1_arguments(c, k, 0),
    node(d, k, _, s, e), spt_1_string_values(d, s, e, v), spt_1_carrier_attr(v), spt_1_parameter_kinds(f, ot, "carrier"), spt_1_fact_context(f).
spt_1_special_attributes(f, n, "carrier", v) :- spt_1_gnode(n), kind(n, "subscript"), spt_1_body_nodes(f, n), field(n, "value", r), spt_1_gnode(r), kind(r, "identifier"),
    text(r, rt), child(n, k, _), spt_1_gnode(k), k != r, node(d, k, _, s, e), spt_1_string_values(d, s, e, v), spt_1_carrier_attr(v),
    spt_1_parameter_kinds(f, rt, "carrier"), spt_1_fact_context(f).

.decl spt_1_runtime(d: number, name: symbol)
spt_1_runtime(d, n) :- spt_1_contexts(c, n, _), docof(c, d), spt_1_special_attributes(c, _, "carrier", _), spt_1_parameter_kinds(c, _, "carrier"), spt_1_runtime_context(c).
spt_1_runtime(d, n) :- spt_1_contexts(c, n, _), spt_1_body_nodes(c, call), spt_1_calls(call, _, "identifier", _, callee), docof(call, d), spt_1_runtime(d, callee),
    spt_1_arguments(call, a, _), spt_1_descendants(a, x), kind(x, "identifier"), text(x, t), spt_1_parameter_kinds(c, t, "carrier"), spt_1_runtime_context(c).
.decl spt_1_return_kind_entry(name: symbol, kind: symbol)
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  

.decl spt_1_return_kinds(d: number, name: symbol, kind: symbol)
spt_1_return_kinds(d, n, "runtime_authority") :- spt_1_runtime(d, n).
spt_1_return_kinds(d, n, "authority") :- spt_1_contexts(c, n, _), docof(c, d), field(c, "return_type", t), spt_1_gnode(t), text(t, s), @rx(s, "\\b(?:ReadTransaction|SyncDatabaseConnection|SyncSqlConnection|WriteTransaction)\\b") = 1, spt_1_fact_context(c).
spt_1_return_kinds(d, n, "provider") :- spt_1_contexts(c, n, _), docof(c, d), field(c, "return_type", t), spt_1_gnode(t), text(t, s), @rx(s, "\\b(?:CrossBranchQueryProvider|HybridSearchProvider|VectorCandidateProvider|VersionedLoweringProvider|VersionedStorageProvider)\\b") = 1, spt_1_fact_context(c).
spt_1_return_kinds(d, n, k) :- spt_1_contexts(c, _, _), docof(c, d), spt_1_return_kind_entry(n, k), spt_1_fact_context(c).

.decl spt_1_expression_edges(src: node, dst: node)
spt_1_expression_edges(o, n) :- spt_1_attributes(n, _, o, _).
spt_1_expression_edges(r, n) :- spt_1_call_receiver(n, r).
spt_1_expression_edges(v, n) :- spt_1_gnode(n), kind(n, "subscript"), field(n, "value", v).
.decl spt_1_identifier_nodes(n: node, text: symbol)
spt_1_identifier_nodes(n, t) :- spt_1_gnode(n), kind(n, "identifier"), text(n, t).

.decl spt_1_flow_kind(k: symbol)
spt_1_flow_kind("authority"). spt_1_flow_kind("provider"). spt_1_flow_kind("runtime_value").
.decl spt_1_taints(fn: node, n: node, kind: symbol)
spt_1_taints(f, n, k) :- spt_1_body_nodes(f, n), spt_1_identifier_nodes(n, t), spt_1_parameter_kinds(f, t, k), k != "carrier", spt_1_fact_context(f).
spt_1_taints(f, n, "authority") :- spt_1_special_attributes(f, n, "carrier", _), spt_1_fact_context(f).
spt_1_taints(f, n, "authority") :- spt_1_special_attributes(f, n, _, "txn"), spt_1_fact_context(f).
spt_1_taints(f, n, "authority") :- spt_1_special_attributes(f, n, _, "sql_connection"), spt_1_fact_context(f).
spt_1_taints(f, c, k) :- spt_1_body_nodes(f, c), spt_1_calls(c, _, _, _, callee), docof(c, d), spt_1_return_kinds(d, callee, k), spt_1_fact_context(f).
spt_1_taints(f, t, k) :- spt_1_taints(f, n, k), spt_1_expression_edges(n, t), spt_1_body_nodes(f, t), spt_1_fact_context(f).
spt_1_taints(f, x, k) :- spt_1_taints(f, n, k), spt_1_flow_kind(k), spt_1_assignment_value(a, n), spt_1_assignments(a, _, "identifier", name), spt_1_body_nodes(f, a),
    spt_1_identifier_nodes(x, name), spt_1_body_nodes(f, x), spt_1_fact_context(f).

.decl spt_1_semantic_values(fn: node, n: node)
spt_1_semantic_values(f, n) :- spt_1_taints(f, n, "runtime_value").
spt_1_semantic_values(f, n) :- spt_1_body_nodes(f, n), spt_1_identifier_nodes(n, t), spt_1_parameter_kinds(f, t, "carrier").
spt_1_semantic_values(f, r) :- spt_1_semantic_values(f, n), spt_1_descendants(r, n).
spt_1_semantic_values(f, x) :- spt_1_semantic_values(f, n), spt_1_assignment_value(a, n), spt_1_assignments(a, _, "identifier", name), spt_1_body_nodes(f, a),
    spt_1_identifier_nodes(x, name), spt_1_body_nodes(f, x).

.decl spt_1_eager_name(n: symbol)
spt_1_eager_name("execute_grammar_fetchall_direct"). spt_1_eager_name("execute_grammar_fetchall_direct_async"). spt_1_eager_name("execute_grammar_fetchall_with_params_direct").
spt_1_eager_name("execute_grammar_fetchall_with_params_direct_async"). spt_1_eager_name("execute_grammar_fetchone_direct"). spt_1_eager_name("execute_grammar_fetchone_direct_async").
spt_1_eager_name("execute_grammar_fetchone_with_params_direct"). spt_1_eager_name("execute_grammar_fetchone_with_params_direct_async"). spt_1_eager_name("grammar_effect_lazy").
spt_1_eager_name("grammar_execute"). spt_1_eager_name("grammar_execute_async"). spt_1_eager_name("grammar_fetchall").
spt_1_eager_name("grammar_fetchall_async"). spt_1_eager_name("grammar_fetchone"). spt_1_eager_name("grammar_fetchone_async").
spt_1_eager_name("grammar_row_lazy"). spt_1_eager_name("grammar_rows_lazy"). spt_1_eager_name("grammar_scalar").
spt_1_eager_name("grammar_scalar_async"). spt_1_eager_name("grammar_value_lazy").
.decl spt_1_exec_name(n: symbol)
spt_1_exec_name("execute"). spt_1_exec_name("execute_async"). spt_1_exec_name("execute_ddl"). spt_1_exec_name("execute_ddl_async"). spt_1_exec_name("executemany"). spt_1_exec_name("executemany_async").
spt_1_exec_name("fetchall"). spt_1_exec_name("fetchall_async"). spt_1_exec_name("fetchone"). spt_1_exec_name("fetchone_async"). spt_1_exec_name("scalar"). spt_1_exec_name("scalar_async").
.decl spt_1_eager_rx(p: symbol)
spt_1_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.execute$"). spt_1_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.execute_async$").
spt_1_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.fetchall$"). spt_1_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.fetchall_async$").
spt_1_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.fetchone$"). spt_1_eager_rx("(?:^|\\.)conn(?:\\([^)]*\\))?\\.fetchone_async$").
spt_1_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.execute$"). spt_1_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.execute_async$").
spt_1_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.fetchall$"). spt_1_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.fetchall_async$").
spt_1_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.fetchone$"). spt_1_eager_rx("(?:^|\\.)connection(?:\\([^)]*\\))?\\.fetchone_async$").
spt_1_eager_rx("(?:^|\\.)cursor(?:\\([^)]*\\))?\\.execute$"). spt_1_eager_rx("(?:^|\\.)cursor(?:\\([^)]*\\))?\\.executemany$").
spt_1_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.execute$"). spt_1_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.execute_async$").
spt_1_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.fetchall$"). spt_1_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.fetchall_async$").
spt_1_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.fetchone$"). spt_1_eager_rx("(?:^|\\.)query(?:\\([^)]*\\))?\\.fetchone_async$").
spt_1_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.execute$"). spt_1_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.execute_async$").
spt_1_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.fetchall$"). spt_1_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.fetchall_async$").
spt_1_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.fetchone$"). spt_1_eager_rx("(?:^|\\.)txn(?:\\([^)]*\\))?\\.fetchone_async$").
.decl spt_1_native_name(n: symbol)
spt_1_native_name("create_usearch_index_class"). spt_1_native_name("deserialize_embedding"). spt_1_native_name("get_similarity_function"). spt_1_native_name("serialize_embedding").
.decl spt_1_native_rx(p: symbol)
spt_1_native_rx("(?:^|\\.)np(?:\\([^)]*\\))?\\.array$"). spt_1_native_rx("(?:^|\\.)np(?:\\([^)]*\\))?\\.ascontiguousarray$").
spt_1_native_rx("(?:^|\\.)np(?:\\([^)]*\\))?\\.isinf$"). spt_1_native_rx("(?:^|\\.)np(?:\\([^)]*\\))?\\.isnan$").
spt_1_native_rx("(?:^|\\.)numpy(?:\\([^)]*\\))?\\.array$"). spt_1_native_rx("(?:^|\\.)numpy(?:\\([^)]*\\))?\\.ascontiguousarray$").
spt_1_native_rx("(?:^|\\.)numpy(?:\\([^)]*\\))?\\.isinf$"). spt_1_native_rx("(?:^|\\.)numpy(?:\\([^)]*\\))?\\.isnan$").
.decl spt_1_large_column_name(n: symbol)
spt_1_large_column_name("explicit_plan_execution_scope"). spt_1_large_column_name("hydrate_many_post_op").
spt_1_large_column_name("hydrate_one_post_op"). spt_1_large_column_name("runtime_sql_conn_from_hydrator").
.decl spt_1_nested_name(n: symbol)
spt_1_nested_name("execute_runtime_nested_steps_async"). spt_1_nested_name("execute_runtime_nested_steps_sync").
.decl spt_1_nested_rx(p: symbol)
spt_1_nested_rx("(?:^|\\.)PlanExecutor(?:\\([^)]*\\))?\\.execute$"). spt_1_nested_rx("(?:^|\\.)PlanExecutor(?:\\([^)]*\\))?\\.execute_async$").
spt_1_nested_rx("(?:^|\\.)executor(?:\\([^)]*\\))?\\.execute$"). spt_1_nested_rx("(?:^|\\.)executor(?:\\([^)]*\\))?\\.execute_async$").
.decl spt_1_refs_keyword(k: symbol)
spt_1_refs_keyword("post_op_with_refs"). spt_1_refs_keyword("pre_op_with_refs").
.decl spt_1_resolved_call(n: symbol)
spt_1_resolved_call("get"). spt_1_resolved_call("peek"). spt_1_resolved_call("resolve_server_ref").
.decl spt_1_resolved_name(n: symbol)
spt_1_resolved_name("resolved"). spt_1_resolved_name("resolved_refs").
.decl spt_1_projection_call(n: symbol)
spt_1_projection_call("all"). spt_1_projection_call("any"). spt_1_projection_call("filter"). spt_1_projection_call("len"). spt_1_projection_call("map"). spt_1_projection_call("max").
spt_1_projection_call("min"). spt_1_projection_call("reversed"). spt_1_projection_call("sorted"). spt_1_projection_call("sum").
.decl spt_1_sequence_method(n: symbol)
spt_1_sequence_method("count"). spt_1_sequence_method("index"). spt_1_sequence_method("reverse"). spt_1_sequence_method("sort").
.decl spt_1_comprehension_kind(k: symbol)
spt_1_comprehension_kind("list_comprehension"). spt_1_comprehension_kind("set_comprehension"). spt_1_comprehension_kind("dictionary_comprehension").
spt_1_comprehension_kind("generator_expression").
.decl spt_1_direct_events(fn: node, n: node, kind: symbol, priority: number)
spt_1_direct_events(f, n, "eager_sql", 1) :- spt_1_calls(n, _, _, _, c), spt_1_body_nodes(f, n), spt_1_eager_name(c), spt_1_fact_context(f).
spt_1_direct_events(f, n, "eager_sql", 1) :- spt_1_calls(n, _, "identifier", _, c), spt_1_body_nodes(f, n), spt_1_exec_name(c), spt_1_fact_context(f).
spt_1_direct_events(f, n, "eager_sql", 1) :- spt_1_calls(n, _, _, fc, _), spt_1_body_nodes(f, n), spt_1_eager_rx(p), @rx(fc, p) = 1, spt_1_fact_context(f).
spt_1_direct_events(f, n, "eager_sql", 1) :- spt_1_calls(n, _, _, _, c), spt_1_body_nodes(f, n), spt_1_exec_name(c), spt_1_call_receiver(n, r), spt_1_taints(f, r, "authority"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_callback", 1) :- spt_1_calls(n, _, _, _, "CompiledStep"), spt_1_body_nodes(f, n), spt_1_keywords(n, _, k, _), spt_1_refs_keyword(k), spt_1_fact_context(f).
spt_1_direct_events(f, n, "large_column", 1) :- spt_1_calls(n, _, _, _, c), spt_1_body_nodes(f, n), spt_1_large_column_name(c), spt_1_fact_context(f).
spt_1_direct_events(f, n, "large_column", 1) :- spt_1_calls(n, _, _, _, "convert_row_to_model"), spt_1_body_nodes(f, n), spt_1_keywords(n, _, "hydrate_large_columns", v),
    kind(v, "true"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "resolved_refs", 1) :- spt_1_calls(n, g, _, _, c), spt_1_resolved_call(c), spt_1_body_nodes(f, n), spt_1_attributes(g, _, o, _), spt_1_gnode(o),
    kind(o, "identifier"), text(o, t), spt_1_resolved_name(t), spt_1_fact_context(f).
spt_1_direct_events(f, n, "resolved_refs", 1) :- spt_1_calls(n, g, _, _, c), spt_1_resolved_call(c), spt_1_body_nodes(f, n), spt_1_attributes(g, _, o, _), spt_1_gnode(o),
    spt_1_attributes(o, t, _, _), spt_1_resolved_name(t), spt_1_fact_context(f).
spt_1_direct_events(f, n, "resolved_refs", 1) :- spt_1_calls(n, g, _, _, c), spt_1_resolved_call(c), spt_1_body_nodes(f, n), spt_1_attributes(g, _, o, _), spt_1_gnode(o),
    kind(o, k), k != "identifier", k != "attribute", text(o, t), @sql_instr(t, "resolved") > 0, spt_1_fact_context(f).
spt_1_direct_events(f, n, "nested_execute", 1) :- spt_1_calls(n, _, _, _, c), spt_1_body_nodes(f, n), spt_1_nested_name(c), spt_1_fact_context(f).
spt_1_direct_events(f, n, "nested_execute", 1) :- spt_1_calls(n, _, _, fc, _), spt_1_body_nodes(f, n), spt_1_nested_rx(p), @rx(fc, p) = 1, spt_1_fact_context(f).
spt_1_direct_events(f, n, "materialized_pipeline", 1) :- spt_1_attributes(n, "materialized_pipeline", _, _), spt_1_body_nodes(f, n), spt_1_fact_context(f).
spt_1_direct_events(f, n, "materialized_pipeline", 1) :- spt_1_special_attributes(f, n, "context", "materialized_pipeline"), spt_1_body_nodes(f, n), spt_1_gnode(n), spt_1_fact_context(f).
spt_1_direct_events(f, n, "ctx_access", 1) :- spt_1_special_attributes(f, n, "context", _), spt_1_body_nodes(f, n), spt_1_gnode(n), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_authority", 1) :- spt_1_special_attributes(f, n, "carrier", _), spt_1_body_nodes(f, n), spt_1_gnode(n), kind(n, "attribute"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_authority", 1) :- spt_1_special_attributes(f, n, "carrier", _), spt_1_body_nodes(f, n), spt_1_gnode(n), kind(n, "call"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_authority", 1) :- spt_1_calls(n, _, _, _, "active_pipeline_txn_for_callbacks"), spt_1_body_nodes(f, n), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_authority", 1) :- spt_1_calls(n, _, _, _, _), spt_1_body_nodes(f, n), spt_1_taints(f, n, "runtime_authority"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_authority", 0) :- spt_1_assignments(n, _, _, _), spt_1_body_nodes(f, n), spt_1_assignment_value(n, v), spt_1_taints(f, v, "runtime_authority"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_value", 0) :- spt_1_assignments(n, _, _, _), spt_1_body_nodes(f, n), spt_1_assignment_value(n, v), spt_1_taints(f, v, "runtime_value"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_value", 1) :- spt_1_calls(n, _, _, _, _), spt_1_body_nodes(f, n), spt_1_taints(f, n, "runtime_value"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_value", 1) :- spt_1_calls(n, _, _, _, _), spt_1_body_nodes(f, n), spt_1_call_receiver(n, r), spt_1_taints(f, r, "runtime_value"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_value", 1) :- spt_1_calls(n, _, _, _, _), spt_1_body_nodes(f, n), spt_1_arguments(n, a, _), spt_1_taints(f, a, "runtime_value"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_value", 1) :- spt_1_calls(n, _, _, _, _), spt_1_body_nodes(f, n), spt_1_keywords(n, _, _, v), spt_1_taints(f, v, "runtime_value"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_value", 1) :- spt_1_gnode(n), kind(n, "subscript"), spt_1_body_nodes(f, n), field(n, "value", o), spt_1_gnode(o), kind(o, "identifier"),
    spt_1_taints(f, o, "runtime_value"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_value", 1) :- spt_1_gnode(n), kind(n, "comparison_operator"), spt_1_body_nodes(f, n), text(n, t), @rx(t, "\\bin\\b") = 1,
    child(n, o, _), spt_1_gnode(o), kind(o, "identifier"), spt_1_taints(f, o, "runtime_value"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "provider_authority", 1) :- spt_1_calls(n, _, _, _, _), spt_1_body_nodes(f, n), spt_1_call_receiver(n, r), spt_1_taints(f, r, "provider"),
    spt_1_arguments(n, a, _), spt_1_taints(f, a, "authority"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "provider_authority", 1) :- spt_1_calls(n, _, _, _, _), spt_1_body_nodes(f, n), spt_1_call_receiver(n, r), spt_1_taints(f, r, "provider"),
    spt_1_keywords(n, _, _, v), spt_1_taints(f, v, "authority"), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_1_calls(n, _, _, _, c), spt_1_projection_call(c), spt_1_body_nodes(f, n), spt_1_arguments(n, a, _),
    spt_1_semantic_values(f, a), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_1_calls(n, _, _, _, c), spt_1_projection_call(c), spt_1_body_nodes(f, n), spt_1_keywords(n, _, _, v),
    spt_1_semantic_values(f, v), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_1_calls(n, _, _, _, c), spt_1_sequence_method(c), spt_1_body_nodes(f, n), spt_1_call_receiver(n, r),
    spt_1_semantic_values(f, r), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_1_gnode(n), kind(n, "subscript"), spt_1_body_nodes(f, n), child(n, sl, _), spt_1_gnode(sl),
    kind(sl, "slice"), field(n, "value", v), spt_1_semantic_values(f, v), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_1_gnode(n), kind(n, k), spt_1_comprehension_kind(k), spt_1_body_nodes(f, n), child(n, fi, _), spt_1_gnode(fi),
    kind(fi, "for_in_clause"), child(n, ic, _), spt_1_gnode(ic), kind(ic, "if_clause"), field(fi, "right", r), spt_1_semantic_values(f, r), spt_1_fact_context(f).
.decl spt_1_loop_projection(p: node)
spt_1_loop_projection(p) :- spt_1_gnode(p), kind(p, "subscript").
spt_1_loop_projection(p) :- spt_1_calls(p, _, _, _, "get").
spt_1_loop_projection(p) :- spt_1_calls(p, _, _, _, "getattr").
.decl spt_1_append_call(n: symbol)
spt_1_append_call("append"). spt_1_append_call("extend").
.decl spt_1_projection_loop(fn: node, n: node)
spt_1_projection_loop(f, n) :- spt_1_gnode(n), kind(n, "for_statement"), spt_1_body_nodes(f, n), field(n, "right", r), spt_1_semantic_values(f, r),
    spt_1_descendants(n, c), spt_1_calls(c, _, _, _, cc), spt_1_append_call(cc), spt_1_descendants(n, p), spt_1_loop_projection(p),
    spt_1_descendants(p, u), spt_1_identifier_nodes(u, name), field(n, "left", l), spt_1_descendants(l, x), spt_1_identifier_nodes(x, name).
spt_1_direct_events(f, n, "runtime_semantic_projection", 1) :- spt_1_projection_loop(f, n), spt_1_fact_context(f).
spt_1_direct_events(f, n, "runtime_sequence_projection", 1) :- spt_1_projection_loop(f, n), spt_1_fact_context(f).

.decl spt_1_depth_skip(k: symbol)
spt_1_depth_skip("module"). spt_1_depth_skip("block"). spt_1_depth_skip("expression_statement"). spt_1_depth_skip("argument_list").
spt_1_depth_skip("decorated_definition"). spt_1_depth_skip("parenthesized_expression"). spt_1_depth_skip("type").
.decl spt_1_event_ancestor(n: node, r: node)
spt_1_event_ancestor(n, r) :- spt_1_direct_events(_, n, _, _), spt_1_descendants(r, n), kind(r, k), !spt_1_depth_skip(k).
.decl spt_1_event_rank(fn: node, kind: symbol, n: node, priority: number, depth: number, s: number)
spt_1_event_rank(f, k, n, p, c, s) :- spt_1_direct_events(f, n, k, p), c = count : { spt_1_event_ancestor(n, _) }, spt_1_start(n, s).
.decl spt_1_ds_priority(fn: node, kind: symbol, priority: number)
spt_1_ds_priority(f, k, p) :- spt_1_event_rank(f, k, _, _, _, _), p = min q : { spt_1_event_rank(f, k, _, q, _, _) }.
.decl spt_1_ds_depth(fn: node, kind: symbol, depth: number)
spt_1_ds_depth(f, k, c) :- spt_1_ds_priority(f, k, p), c = min x : { spt_1_event_rank(f, k, _, p, x, _) }.
.decl spt_1_ds_start(fn: node, kind: symbol, s: number)
spt_1_ds_start(f, k, s) :- spt_1_ds_priority(f, k, p), spt_1_ds_depth(f, k, c), s = min y : { spt_1_event_rank(f, k, _, p, c, y) }.
.decl spt_1_direct_sinks(fn: node, n: node, kind: symbol)
spt_1_direct_sinks(f, n, k) :- spt_1_ds_priority(f, k, p), spt_1_ds_depth(f, k, c), spt_1_ds_start(f, k, s), spt_1_event_rank(f, k, n, p, c, s).

.decl spt_1_self_name(n: symbol)
spt_1_self_name("self"). spt_1_self_name("cls").
.decl spt_1_call_graph(fn: node, n: node, target: node)
spt_1_call_graph(f, c, t) :- spt_1_body_nodes(f, c), spt_1_calls(c, _, "identifier", _, callee), spt_1_contexts(f, _, _), docof(c, d), spt_1_contexts(t, callee, ""), docof(t, d),
    t != f.
spt_1_call_graph(f, c, t) :- spt_1_body_nodes(f, c), spt_1_calls(c, g, "attribute", _, callee), spt_1_contexts(f, _, cn), cn != "", docof(c, d), spt_1_contexts(t, callee, cn),
    docof(t, d), t != f, spt_1_attributes(g, _, _, ot), spt_1_self_name(ot).

.decl spt_1_reachable(fn: node)

.decl spt_1_source_edge(f: node, target: node, line: number, name: symbol)
spt_1_source_edge(f,t,l,q) :- spt_1_call_graph(f,c,t), line(c,l), spt_1_ctx_display(t,q).
.decl spt_1_edge_before(f: node, target: node, line: number, name: symbol, earlier: node, earlier_line: number, earlier_name: symbol)
spt_1_edge_before(f,t,l,q,u,k,s) :- spt_1_source_edge(f,t,l,q), spt_1_source_edge(f,u,k,s), (k < l; k = l, s < q).
.decl spt_1_edge_rank(f: node, target: node, line: number, name: symbol, ordinal: number)
spt_1_edge_rank(f,t,l,q,i) :- spt_1_source_edge(f,t,l,q), i = count : { spt_1_edge_before(f,t,l,q,_,_,_) }.
.decl spt_1_ordered_edge(f: node, target: node, ordinal: number)
spt_1_ordered_edge(f,t,i) :- spt_1_edge_rank(f,t,_,_,i).
.decl spt_1_transitive_sinks(fn: node, n: node, kind: symbol, origin: node)
spt_1_transitive_sinks(f,n,k,f) :- spt_1_direct_sinks(f,n,k), spt_1_reachable(f).
.decl spt_1_target_eager_sql(f: node)
spt_1_target_eager_sql(f) :- spt_1_direct_sinks(f,_,"eager_sql").
.decl spt_1_roots_eager_sql(f: node, ordinal: number)
spt_1_roots_eager_sql(f,i) :- spt_1_ctx_planning(f), spt_1_start(f,i).
spt_1_roots_eager_sql(f,i) :- spt_1_ctx_preprocess(f), spt_1_start(f,i).
spt_1_roots_eager_sql(f,i) :- spt_1_ctx_provider_helper(f), spt_1_start(f,i).
spt_1_transitive_sinks(f,c,"eager_sql",t) :- spt_1_roots_eager_sql(f,_), !spt_1_target_eager_sql(f),
    dfs_first_memo(f,t,i,spt_1_ordered_edge,spt_1_target_eager_sql,spt_1_roots_eager_sql), spt_1_edge_rank(f,u,l,_,i), spt_1_call_graph(f,c,u), line(c,l).
