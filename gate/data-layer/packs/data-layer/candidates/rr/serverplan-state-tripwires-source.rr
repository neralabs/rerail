spt_3_raw_strings_0(s, v) :- ast(d, s, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "auto_api|lazy_orm|query_builder"}}, {"any": [{"matches": "state-projection-source"}, {"inside": {"matches": "state-projection-source", "stopBy": "end"}}]}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}, {"filePath": {"regex": "(?s).*"}}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), doc_role(d,"primary").
.decl spt_3_raw_strings_1(s: node, value: symbol)
spt_3_raw_strings_1(s, v) :- ast(d, s, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "auto_api|lazy_orm|query_builder"}}, {"any": [{"matches": "state-projection-source"}, {"inside": {"matches": "state-projection-source", "stopBy": "end"}}]}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"all": [{"not": {"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}[a-z]"}]}, {"filePath": {"regex": "(?s).*"}}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), doc_role(d,"primary").
.decl spt_3_raw_strings_2(s: node, value: symbol)
spt_3_raw_strings_2(s, v) :- ast(d, s, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "auto_api|lazy_orm|query_builder"}}, {"any": [{"matches": "state-projection-source"}, {"inside": {"matches": "state-projection-source", "stopBy": "end"}}]}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$STRING"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}, {"not": {"any": [{"regex": "^[rRuUbBfF]*[\\\"']{1,3}_"}, {"regex": "^[rRuUbBfF]*[\\\"']{1,3}[a-z]"}]}}, {"filePath": {"regex": "(?s).*"}}]}]}]}, "transform": {"DECODED": {"replace": {"source": "$STRING", "value": true, "replace": "\\b\\B", "by": ""}}}}, DECODED: v), doc_role(d,"primary").
.decl spt_3_syntax_gate(d: number)
spt_3_syntax_gate(d) :- ast(d, m, {"language": "python", "syntax": "valid", "rule": {"all": [{"filePath": {"regex": "auto_api|lazy_orm|query_builder"}}, {"any": [{"matches": "state-projection-source"}, {"inside": {"matches": "state-projection-source", "stopBy": "end"}}]}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"all": [{"filePath": {"regex": "(?s).*"}}, {"kind": "module"}]}]}]}}), doc_role(d,"primary").

.decl spt_3_excluded_kind(k: symbol)
spt_3_excluded_kind("comment"). spt_3_excluded_kind("string_start"). spt_3_excluded_kind("string_content"). spt_3_excluded_kind("string_end").
spt_3_excluded_kind("escape_sequence"). spt_3_excluded_kind("line_continuation").
.decl spt_3_nodes(n: node)
spt_3_nodes(n) :- spt_3_syntax_gate(d), node(d, n, k, _, _), !spt_3_excluded_kind(k).

.decl spt_3_projection_scopes(d: number, s: number, e: number)
spt_3_projection_scopes(d, s, e) :- spt_3_nodes(n), kind(n, "function_definition"), field(n, "name", x), text(x, t),
    @rx(t, "alias|extract|project|projected|projection|tuple") = 1, node(d, n, _, s, e).
spt_3_projection_scopes(d, s, e) :- spt_3_nodes(n), kind(n, "class_definition"), field(n, "name", x), text(x, t),
    @rx(t, "alias|extract|project|projected|projection|tuple") = 1, node(d, n, _, s, e).

.decl spt_3_functions(f: node, name: symbol)
spt_3_functions(f, name) :- spt_3_nodes(f), kind(f, "function_definition"), field(f, "name", x), text(x, name).
.decl spt_3_attributes(a: node, attr: symbol, object: node, object_text: symbol)
spt_3_attributes(a, attr, o, ot) :- spt_3_nodes(a), kind(a, "attribute"), field(a, "attribute", x), text(x, attr), field(a, "object", o), text(o, ot).

.decl spt_3_calls(n: node, callee_id: node, callee: symbol)
spt_3_calls(n, f, c) :- spt_3_nodes(n), kind(n, "call"), field(n, "function", f), spt_3_nodes(f), spt_3_attributes(f, c, _, _).
spt_3_calls(n, f, c) :- spt_3_nodes(n), kind(n, "call"), field(n, "function", f), spt_3_nodes(f), !spt_3_is_attribute(f), text(f, c).
.decl spt_3_is_attribute(a: node)
spt_3_is_attribute(a) :- spt_3_attributes(a, _, _, _).
.decl spt_3_call_receiver(n: node, receiver: node)
spt_3_call_receiver(n, o) :- spt_3_calls(n, f, _), spt_3_attributes(f, _, o, _).

.decl spt_3_unexpanded_kind(k: symbol)
spt_3_unexpanded_kind("module"). spt_3_unexpanded_kind("block"). spt_3_unexpanded_kind("expression_statement"). spt_3_unexpanded_kind("argument_list").
spt_3_unexpanded_kind("decorated_definition"). spt_3_unexpanded_kind("type").
.decl spt_3_descendants(root: node, n: node)
spt_3_descendants(r, r) :- spt_3_nodes(r).
spt_3_descendants(r, n) :- spt_3_nodes(r), kind(r, k), !spt_3_unexpanded_kind(k), docof(r, d), node(d, n, _, _, _), spt_3_nodes(n), within(n, r).

.decl spt_3_assignments(n: node, target: node, target_kind: symbol, target_text: symbol)
spt_3_assignments(n, l, lk, lt) :- spt_3_nodes(n), kind(n, "assignment"), field(n, "left", l), spt_3_nodes(l), kind(l, lk), text(l, lt).
.decl spt_3_assignment_value(n: node, value: node)
spt_3_assignment_value(n, r) :- spt_3_assignments(n, _, _, _), field(n, "right", r), spt_3_nodes(r).
.decl spt_3_assignment_fn(n: node, fn: node)
spt_3_assignment_fn(n, f) :- spt_3_assignments(n, _, _, _), nearest(n, f, spt_3_fdef).

.decl spt_3_raw_strings(s: node, value: symbol)
spt_3_raw_strings(s, v) :- spt_3_raw_strings_0(s, v).
spt_3_raw_strings(s, v) :- spt_3_raw_strings_1(s, v).
spt_3_raw_strings(s, v) :- spt_3_raw_strings_2(s, v).
.decl spt_3_module_strings(d: number, name: symbol, value: symbol)
spt_3_module_strings(d, name, v) :- spt_3_assignments(a, _, "identifier", name), child(stmt, a, _), spt_3_nodes(stmt), child(root, stmt, _), spt_3_nodes(root),
    kind(root, "module"), field(a, "right", r), node(d, r, _, rs, re), spt_3_raw_strings(s, v), node(d, s, _, rs, re).
.decl spt_3_string_values(d: number, s: number, e: number, value: symbol)
spt_3_string_values(d, s, e, v) :- spt_3_raw_strings(x, v), node(d, x, _, s, e).
spt_3_string_values(d, s, e, v) :- spt_3_nodes(n), kind(n, "identifier"), text(n, name), node(d, n, _, s, e), spt_3_module_strings(d, name, v).

