.decl spt_0_events_scope(clause: symbol, n: node, s: number)
spt_0_events_scope(c, n, s) :- spt_0_events(c, n), nearest(n, f, spt_0_fdef), spt_0_start(f, s).
.decl spt_0_events_term(clause: symbol, n: node, term: symbol)
spt_0_events_term(c, n, t) :- spt_0_events(c, n), kind(n, "call"), field(n, "function", f), kind(f, "identifier"), text(f, t).
spt_0_events_term(c, n, t) :- spt_0_events(c, n), kind(n, "call"), field(n, "function", f), kind(f, "attribute"), field(f, "attribute", x), text(x, t).
spt_0_events_term(c, n, t) :- spt_0_events(c, n), kind(n, "class_definition"), field(n, "name", x), text(x, t).
spt_0_events_term(c, n, t) :- spt_0_events(c, n), kind(n, "function_definition"), field(n, "name", x), text(x, t).
spt_0_events_term(c, n, t) :- spt_0_events(c, n), kind(n, "attribute"), field(n, "attribute", x), text(x, t).
.decl spt_0_scope_key(clause: symbol, n: node, k: symbol)
spt_0_scope_key(c, n, k) :- spt_0_events_scope(c, n, s), k = @rr_to_string(s).
spt_0_scope_key(c, n, "") :- spt_0_events(c, n), !spt_0_has_scope(c, n).
.decl spt_0_has_scope(clause: symbol, n: node)
spt_0_has_scope(c, n) :- spt_0_events_scope(c, n, _).
.decl spt_0_term_key(clause: symbol, n: node, k: symbol)
spt_0_term_key(c, n, t) :- spt_0_events_term(c, n, t).
spt_0_term_key(c, n, "") :- spt_0_events(c, n), !spt_0_has_term(c, n).
.decl spt_0_has_term(clause: symbol, n: node)
spt_0_has_term(c, n) :- spt_0_events_term(c, n, _).
.decl spt_0_event_row(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, n: node)
spt_0_event_row(c, d, l, sk, tk, "", n) :- spt_0_events(c, n), !spt_0_detail_clause(c), docof(n, d), l = dl_line1, spt_0_scope_key(c, n, sk), spt_0_term_key(c, n, tk), line(n, dl_line1).
spt_0_event_row(c, d, l, sk, tk, dk, n) :- spt_0_events_detail(c, n, dk), docof(n, d), l = dl_line2, spt_0_scope_key(c, n, sk), spt_0_term_key(c, n, tk), line(n, dl_line2).

.decl spt_0_event_start(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, s: number)
spt_0_event_start(c, d, l, sk, tk, dk, s) :- spt_0_event_row(c, d, l, sk, tk, dk, n), spt_0_start(n, s).
.decl spt_0_first_start(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, s: number)
spt_0_first_start(c, d, l, sk, tk, dk, s) :- spt_0_event_start(c, d, l, sk, tk, dk, _), s = min t : { spt_0_event_start(c, d, l, sk, tk, dk, t) }.
.decl spt_0_event_end(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, e: number)
spt_0_event_end(c, d, l, sk, tk, dk, e) :- spt_0_event_row(c, d, l, sk, tk, dk, n), node(_, n, _, s, e), spt_0_first_start(c, d, l, sk, tk, dk, s).
.decl spt_0_first_end(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, e: number)
spt_0_first_end(c, d, l, sk, tk, dk, e) :- spt_0_event_end(c, d, l, sk, tk, dk, _), e = min x : { spt_0_event_end(c, d, l, sk, tk, dk, x) }.
.decl spt_0_chosen(clause: symbol, line: number, scope: symbol, term: symbol, detail: symbol, n: node)
spt_0_chosen(c, l, sk, tk, dk, n) :- spt_0_event_row(c, d, l, sk, tk, dk, n), node(_, n, _, s, e), spt_0_first_start(c, d, l, sk, tk, dk, s),
    spt_0_first_end(c, d, l, sk, tk, dk, e).
spt_0_finding(c, k, n) :- spt_0_chosen(c, l, sk, tk, dk, n), k = @concat(@concat(@concat(@concat(@concat(@concat(@rr_to_string(l), "|"), sk), "|"), tk), "|"), dk).

.decl spt_0_start(n: node, s: number)
spt_0_start(n, s) :- node(_, n, _, s, _).
.decl spt_0_dl_class_kind(k: symbol)
spt_0_dl_class_kind("class_definition").
.decl spt_0_dl_in_class(n: node)
spt_0_dl_in_class(n) :- nearest(n, _, spt_0_dl_class_kind).
.decl spt_0_dl_class_path(c: node, s: symbol)
spt_0_dl_class_path(c, t) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), !spt_0_dl_in_class(c).
spt_0_dl_class_path(c, s) :- kind(c, "class_definition"), field(c, "name", m), text(m, t), nearest(c, a, spt_0_dl_class_kind),
    spt_0_dl_class_path(a, p), s = @concat(@concat(p, "."), t).
.decl spt_0_dl_class_prefix(n: node, s: symbol)
spt_0_dl_class_prefix(n, s) :- nearest(n, c, spt_0_dl_class_kind), spt_0_dl_class_path(c, p), s = @concat(p, ".").
spt_0_dl_class_prefix(n, "") :- kind(n, "function_definition"), !spt_0_dl_in_class(n).
.decl spt_0_dl_frame_kind(k: symbol)
spt_0_dl_frame_kind("function_definition").
spt_0_dl_frame_kind("class_definition").
.decl spt_0_dl_frame(f: node, t: symbol, fn: number)
spt_0_dl_frame(f, t, 1) :- kind(f, "function_definition"), field(f, "name", m), text(m, t).
spt_0_dl_frame(f, t, 0) :- kind(f, "class_definition"), field(f, "name", m), text(m, t).
.decl spt_0_dl_frame_parent(f: node, a: node)
spt_0_dl_frame_parent(f, a) :- spt_0_dl_frame(f, _, _), nearest(f, a, spt_0_dl_frame_kind).
.decl spt_0_dl_in_frame(n: node)
spt_0_dl_in_frame(n) :- spt_0_dl_frame_parent(n, _).
.decl spt_0_dl_qual(f: node, q: symbol, d: number)
spt_0_dl_qual(f, t, k) :- spt_0_dl_frame(f, t, k), !spt_0_dl_in_frame(f).
spt_0_dl_qual(f, s, d) :- spt_0_dl_frame(f, t, 1), spt_0_dl_frame_parent(f, a), spt_0_dl_qual(a, p, k), k > 0, d = k + 1,
    s = @concat(@concat(p, ".<locals>."), t).
spt_0_dl_qual(f, s, d) :- spt_0_dl_frame(f, t, x), spt_0_dl_frame_parent(f, a), spt_0_dl_qual(a, p, k), (x = 0; k = 0), d = k + x,
    s = @concat(@concat(p, "."), t).
.decl spt_0_dl_qualname(f: node, q: symbol)
spt_0_dl_qualname(f, q) :- spt_0_dl_qual(f, q, _).
.decl spt_0_dl_qualdepth(f: node, d: number)
spt_0_dl_qualdepth(f, d) :- spt_0_dl_qual(f, _, d).
