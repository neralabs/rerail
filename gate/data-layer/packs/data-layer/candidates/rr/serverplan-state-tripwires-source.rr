spt_result(n,q,"SPT-028","serverplan runtime-projection tripwire: runtime-ref callbacks must not implement semantic filtering, ordering, counting, joining, slicing, pagination, or row-to-scalar projection in Python. Push those operations into SQL grammar or another backend-owned relation and reserve runtime callbacks/materializers for terminal materialization.",f,3607,0,1) :- spt_2_project_builder_rows(f,n), option("entryPoint","scan_project_sources"), spt_frame_qual(f,q).

