spt_1_roots_ctx_access(f,i) :- spt_1_ctx_helper(f), spt_1_start(f,i).
spt_1_transitive_sinks(f,c,"ctx_access",t) :- spt_1_roots_ctx_access(f,_), !spt_1_target_ctx_access(f),
    dfs_first_memo(f,t,i,spt_1_ordered_edge,spt_1_target_ctx_access,spt_1_roots_ctx_access), spt_1_edge_rank(f,u,l,_,i), spt_1_call_graph(f,c,u), line(c,l).
