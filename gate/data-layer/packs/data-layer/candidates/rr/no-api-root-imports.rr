.decl pp_fact_allowed(path: symbol)
.decl pp_report_allowed(path: symbol)
pp_fact_allowed(p) :- pp_file(p), !pp_fact_excluded(p).
.decl pp_fact_excluded(path: symbol)
pp_report_allowed(p) :- pp_file(p), !pp_report_excluded(p).
.decl pp_report_excluded(path: symbol)
.decl ppe_RootImport(path: symbol, line: number, event0: number, event1: number, event2: number, ordinal: number, pattern: number, occurrence: number, names: symbol, anchor: node)
RootImport(anchor,ordinal,pattern,occurrence,names,o0,o1,o2) :- ppe_RootImport(p,l,o0,o1,o2,ordinal,pattern,occurrence,names,anchor), pp_api().
RootImport(@place(p,l),ordinal,pattern,occurrence,names,o0,o1,o2) :- ppe_RootImport(p,l,o0,o1,o2,ordinal,pattern,occurrence,names,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
pp_report(p,l,"NARI001",cat("Deprecated root api import (",names,"); use data_layer.* or explicit api.lXXXX_* imports"),p,l,cat("Deprecated root api import (",names,"); use data_layer.* or explicit api.lXXXX_* imports"),0,o0,o1,o2) :- ppe_RootImport(p,l,o0,o1,o2,ordinal,pattern,occurrence,names,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
.violation ProductionFact(at: span, path: symbol, path_order: symbol, order0: number, order1: number, order2: number, f_file_path: symbol, f_line: number, f_message: symbol) code "DL_FACT" "production fact"
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,full,l,cat("Deprecated root api import (",names,"); use data_layer.* or explicit api.lXXXX_* imports")) :- ppe_RootImport(p,l,o0,o1,o2,ordinal,pattern,occurrence,names,anchor), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).
.decl ppe_RootExample(path: symbol, line: number, event0: number, event1: number, event2: number, ordinal: number, piece: number, pattern: number, occurrence: number)
RootExample(@place(p,l),ordinal,piece,pattern,occurrence,o0,o1,o2) :- ppe_RootExample(p,l,o0,o1,o2,ordinal,piece,pattern,occurrence), pp_api().
RootExample(@place(p,l),ordinal,piece,pattern,occurrence,o0,o1,o2) :- ppe_RootExample(p,l,o0,o1,o2,ordinal,piece,pattern,occurrence), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
pp_report(p,l,"NARI001","String literal or doc example uses deprecated root api import; use data_layer.* or explicit api.lXXXX_* imports",p,l,"String literal or doc example uses deprecated root api import; use data_layer.* or explicit api.lXXXX_* imports",0,o0,o1,o2) :- ppe_RootExample(p,l,o0,o1,o2,ordinal,piece,pattern,occurrence), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,full,l,"String literal or doc example uses deprecated root api import; use data_layer.* or explicit api.lXXXX_* imports") :- ppe_RootExample(p,l,o0,o1,o2,ordinal,piece,pattern,occurrence), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).

