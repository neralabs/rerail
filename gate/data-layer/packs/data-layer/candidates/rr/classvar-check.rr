pp_report(p,l,"CLASSVAR001",cat("Direct get_origin(...) ",style," ClassVar check. This fails for string annotations (PEP 563). Use is_classvar_annotation() from l1000_schema.type_utils instead."),p,l,cat("Direct get_origin(...) ",style," ClassVar check. This fails for string annotations (PEP 563). Use is_classvar_annotation() from l1000_schema.type_utils instead."),0,o0,o1,o2) :- ppe_ClassVarComparison(p,l,o0,o1,o2,ordinal,style,column,collector_visit,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
