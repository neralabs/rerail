.decl asda_block_stmt(b: node, s: node, i: number)
asda_block_stmt(b, s, i) :- body_stmt(b, s, i), i > 0.
asda_block_stmt(b, s, 0) :- body_stmt(b, s, 0), !doc_stmt(s, _).
.decl asda_raise(s: node)
asda_raise(s) :- kind(s, "raise_statement"), child(s, raw, 0), unparen(raw, e), kind(e, "identifier"), asdp_callable(e, name), (name = "RuntimeError" ; name = "NotImplementedError").
asda_raise(s) :- kind(s, "raise_statement"), child(s, raw, 0), unparen(raw, e), kind(e, "call"), field(e, "function", rawfn), unparen(rawfn, fn), asdp_callable(fn, name), (name = "RuntimeError" ; name = "NotImplementedError").
.decl asda_setup_leaf(s: node)
asda_setup_leaf(s) :- kind(s, k), (k = "pass_statement" ; k = "delete_statement").
asda_setup_leaf(s) :- asgstmt(_, s).
asda_setup_leaf(s) :- kind(s, "expression_statement"), child(s, raw, 0), unparen(raw, e), kind(e, "ellipsis").
.decl asda_if_child(s: node, c: node)
asda_if_child(s, c) :- py_if(s, _, body), asda_block_stmt(body, c, _).
asda_if_child(s, c) :- py_orelse(s, c), kind(c, "elif_clause").
asda_if_child(s, c) :- py_orelse(s, other), kind(other, "else_clause"), field(other, "body", body), asda_block_stmt(body, c, _).
.decl asda_setup_part(s: node, c: node)
asda_setup_part(s, s) :- body_stmt(_, s, _).
asda_setup_part(s, c) :- asda_setup_part(s, p), asda_if_child(p, c).
.decl asda_setup_bad(s: node)
asda_setup_bad(s) :- asda_setup_part(s, c), !py_if(c, _, _), !asda_setup_leaf(c), !asda_raise(c).
asda_setup_bad(s) :- asda_setup_part(s, c), py_if(c, _, body), !asda_block_stmt(body, _, _).
.decl asda_setup(s: node)
asda_setup(s) :- asda_setup_part(s, s), !asda_setup_bad(s), !asda_raise(s).
.decl asda_stub(f: node)
asda_stub(f) :- asdp_function(f, _, _), !asdp_statement(f, _, _).
asda_stub(f) :- asdp_function(f, _, _), last = max i : { asdp_statement(f, _, i) }, asdp_statement(f, s, last), asda_raise(s), count : { asdp_statement(f, prev, i), i < last, !asda_setup(prev) } = 0.
.decl asda_local_edge(root: node, item: node)
asda_local_edge(root, item) :- (kind(root, "tuple") ; kind(root, "list") ; kind(root, "pattern_list") ; kind(root, "tuple_pattern") ; kind(root, "list_pattern")), child(root, raw, _), !kind(raw, "comment"), unparen(raw, item).
.decl asda_local_part(root: node, item: node)
asda_local_part(root, root) :- kind(root, _).
asda_local_part(root, item) :- asda_local_part(root, p), asda_local_edge(p, item).
.decl asda_self_attr(n: node)
asda_self_attr(n) :- kind(n, "attribute"), field(n, "object", raw), unparen(raw, receiver), kind(receiver, "identifier"), text(receiver, name), @nfkc(name) = "self".
.decl asda_local_leaf(n: node)
asda_local_leaf(n) :- kind(n, "identifier").
asda_local_leaf(n) :- asda_self_attr(n).
asda_local_leaf(n) :- kind(n, k), (k = "tuple" ; k = "list" ; k = "pattern_list" ; k = "tuple_pattern" ; k = "list_pattern").
.decl asda_local_bad(n: node)
asda_local_bad(n) :- asda_local_part(n, part), !asda_local_leaf(part).
.decl asda_static_edge(root: node, item: node)
asda_static_edge(root, item) :- kind(root, k), (k = "tuple" ; k = "list" ; k = "set" ; k = "expression_list"), child(root, raw, _), !kind(raw, "comment"), unparen(raw, item).
asda_static_edge(root, item) :- kind(root, "dictionary"), child(root, pair, _), kind(pair, "pair"), (field(pair, "key", raw) ; field(pair, "value", raw)), unparen(raw, item).
asda_static_edge(root, item) :- kind(root, "dictionary"), child(root, splat, _), kind(splat, "dictionary_splat"), child(splat, raw, 0), unparen(raw, item).
.decl asda_static_part(root: node, item: node)
asda_static_part(root, root) :- kind(root, _).
asda_static_part(root, item) :- asda_static_part(root, p), asda_static_edge(p, item).
.decl asda_static_leaf(n: node)
asda_static_leaf(n) :- ast_constant(n).
asda_static_leaf(n) :- kind(n, "identifier").
asda_static_leaf(n) :- asda_self_attr(n).
asda_static_leaf(n) :- kind(n, k), (k = "tuple" ; k = "list" ; k = "set" ; k = "dictionary" ; k = "expression_list").
.decl asda_static_bad(n: node)
asda_static_bad(n) :- asda_static_part(n, part), !asda_static_leaf(part).
.decl asda_lifecycle_stmt(s: node)
asda_lifecycle_stmt(s) :- kind(s, "pass_statement").
asda_lifecycle_stmt(s) :- asgstmt(a, s), count : { assign_target(a, raw), unparen(raw, target), asda_local_bad(target) } = 0.
asda_lifecycle_stmt(s) :- kind(s, "expression_statement"), child(s, a, 0), kind(a, "augmented_assignment"), field(a, "left", raw), unparen(raw, target), !asda_local_bad(target).
asda_lifecycle_stmt(s) :- kind(s, "return_statement"), !child(s, _, _).
asda_lifecycle_stmt(s) :- kind(s, "return_statement"), child(s, raw, 0), unparen(raw, value), !asda_static_bad(value).
.decl asda_lifecycle(f: node)
asda_lifecycle(f) :- asdp_function(f, _, name), (name = "start" ; name = "stop" ; name = "_on_last_unsubscribe"), count : { asdp_statement(f, s, _), !asda_lifecycle_stmt(s) } = 0.
// Descendants include nested definitions, their defaults and decorators. The
// current function's decorators precede its tree-sitter function range.
.decl asda_desc_call(f: node, call: node)
asda_desc_call(f, call) :- asdp_function(f, _, _), kind(call, "call"), within(call, f).
asda_desc_call(f, call) :- asdp_function(f, _, _), decorator(f, raw), kind(call, "call"), (call = raw ; within(call, raw)).
.decl asda_safe_call(call: node)
asda_safe_call(call) :- kind(call, "call"), field(call, "function", raw), unparen(raw, fn), asdp_callable(fn, name), (suffix("_lazy", name) ; name = "cast" ; name = "JSONResponse" ; name = "_attach_auto_api_hook_registry").
.decl asda_lazy_builder(f: node)
asda_lazy_builder(f) :- asda_desc_call(f, call), field(call, "function", raw), unparen(raw, fn), asdp_callable(fn, name), suffix("_lazy", name), count : { asda_desc_call(f, c), !asda_safe_call(c) } = 0.
.decl asda_await(f: node)
asda_await(f) :- kind(n, "await"), def_frame(n, f).
asda_await(f) :- kind(n, k), (k = "for_statement" ; k = "with_statement"), op(n, "async"), def_frame(n, f).
.decl asda_sync(f: node, name: symbol)
asda_sync(f, sync) :- asdp_function(f, _, name), is_async(f), suffix("_async", name), sync = @slice(name, 0, strlen(name)-6), kind(call, "call"), def_frame(call, f), field(call, "function", raw), unparen(raw, fn), ((kind(fn, "identifier"), text(fn, leaf)) ; (kind(fn, "attribute"), field(fn, "attribute", a), text(a, leaf))), @nfkc(leaf) = sync.
.decl asda_candidate(f: node, path: symbol, name: symbol)
asda_candidate(f, path, name) :- asdp_function(f, path, name), is_async(f), !asdp_ab_skip(path, name), !asda_await(f), !asdp_abstract(f), !asda_stub(f), !asda_lazy_builder(f), !asda_lifecycle(f), !asdp_decorator(f, _, "legacy_async"), !asdp_decorator(f, _, "legacy_module_async").
.decl asda_event(f: node, d: number, end: number, depth: number)
asda_event(f, d, end, depth) :- asda_candidate(f, _, _), node(d, f, _, _, end), ast_depth(f, depth).
.decl asda_rank(f: node, rank: number)
asda_rank(f, rank) :- asda_event(f, d, end, depth), rank = count : { asda_event(_, d, oe, od), (oe < end ; (oe = end, od > depth)) }.
ASDAnalysis(@place(path, line), name, "A", cat("Async function delegates to sync '", sync, "' without await"), sync, "", 1, 0, 0, rank) :- asda_candidate(f, path, name), asda_sync(f, sync), line(f, line), asda_rank(f, rank).
ASDAnalysis(@place(path, line), name, "B", "Async function has no await expressions", "", "", 0, 0, 0, rank) :- asda_candidate(f, path, name), !asda_sync(f, _), line(f, line), asda_rank(f, rank).

.decl asds_return(f: node, text: symbol)
asds_return(f, text) :- asdp_function(f, _, _), field(f, "return_type", a), annotation_text(a, text).
.decl asds_lazy_decorated(f: node)
asds_lazy_decorated(f) :- asdp_decorator(f, _, name), (name = "lazy" ; name = "pure_lazy").
.decl asds_grammar_lazy(f: node)
asds_grammar_lazy(f) :- asdp_function(f, _, name), suffix("_lazy", name), asds_return(f, ann), contains("LazyResult", ann), asda_desc_call(f, call), field(call, "function", raw), unparen(raw, fn), asdp_callable(fn, helper), (helper = "grammar_effect_lazy" ; helper = "grammar_row_lazy" ; helper = "grammar_rows_lazy" ; helper = "grammar_value_lazy").
.decl asds_execution_lazy(f: node)
asds_execution_lazy(f) :- asds_grammar_lazy(f).
asds_execution_lazy(f) :- asds_lazy_decorated(f), !field(f, "return_type", _).
asds_execution_lazy(f) :- asds_lazy_decorated(f), asds_return(f, ann), (contains("LazyResult", ann) ; contains("LazySeq", ann) ; contains("ServerPlan", ann)).
.decl asds_parameter(f: node, nm: node, annotation: loc)
asds_parameter(f, nm, annotation) :- asdp_function(f, _, _), sig_param(f, _, nm, _, k, annotation, _), (k = "posonly" ; k = "pos" ; k = "kwonly").
.decl asds_callback(f: node)
asds_callback(f) :- asds_parameter(f, nm, _), text(nm, raw), name = @nfkc(raw), (name = "fn" ; name = "callback").
asds_callback(f) :- asds_parameter(f, _, ann), annotation_text(ann, text), contains("Callable", text).
.decl asds_transaction(f: node)
asds_transaction(f) :- asds_parameter(f, nm, _), !asds_callback(f), text(nm, raw), name = @nfkc(raw), (name = "txn" ; name = "tx" ; name = "vtxn" ; name = "read_txn" ; name = "write_txn" ; name = "base_txn").
asds_transaction(f) :- asds_parameter(f, _, ann), !asds_callback(f), annotation_text(ann, text), contains("Transaction", text).
.decl asds_unsupported(f: node)
asds_unsupported(f) :- asda_desc_call(f, call), field(call, "function", raw), unparen(raw, fn), kind(fn, "attribute"), field(fn, "attribute", attr), text(attr, name), @nfkc(name) = "_raise_async_not_supported".

.decl asdl_class_candidate(c: node, module: node, name: symbol, i: number)
asdl_class_candidate(c, module, @nfkc(name), i) :- kind(module, "module"), body_stmt(module, stmt, i), defstmt(c, stmt), kind(c, "class_definition"), def_name(c, name).
.decl asdl_scope(c: node, owner: symbol, scope_order: number)
asdl_scope(m, "<module>", 0) :- kind(m, "module").
asdl_scope(c, owner, first+1) :- asdl_class_candidate(c, m, owner, i), i = max j : { asdl_class_candidate(_, m, owner, j) }, first = min j : { asdl_class_candidate(_, m, owner, j) }.
.decl asdl_function_candidate(c: node, f: node, name: symbol, i: number)
asdl_function_candidate(c, f, name, i) :- asdl_scope(c, _, _), body_of(c, b), body_stmt(b, stmt, i), defstmt(f, stmt), asdp_function(f, _, name).
.decl asdl_function(c: node, f: node, name: symbol, first: number)
asdl_function(c, f, name, first) :- asdl_function_candidate(c, f, name, i), i = max j : { asdl_function_candidate(c, _, name, j) }, first = min j : { asdl_function_candidate(c, _, name, j) }.
.decl asdl_kind(f: node, decorator: symbol, priority: number)
asdl_kind(f, "legacy_sync", 0) :- asdp_decorator(f, d, "legacy_sync"), !kind(d, "call").
asdl_kind(f, "legacy_async", 1) :- asdp_decorator(f, d, "legacy_async"), !kind(d, "call").
asdl_kind(f, "legacy_module_sync", 2) :- asdp_decorator(f, d, "legacy_module_sync"), !kind(d, "call").
asdl_kind(f, "legacy_module_async", 3) :- asdp_decorator(f, d, "legacy_module_async"), !kind(d, "call").
.decl asdl_selected(f: node, decorator: symbol)
asdl_selected(f, decorator) :- asdl_kind(f, decorator, p), p = min q : { asdl_kind(f, _, q) }.
.decl asdl_base(f: node, decorator: symbol, base: symbol)
asdl_base(f, "legacy_sync", @replace_all(name, "_sync\\z", "")) :- asdl_selected(f, "legacy_sync"), asdp_function(f, _, name).
asdl_base(f, "legacy_async", @replace_all(name, "_async\\z", "")) :- asdl_selected(f, "legacy_async"), asdp_function(f, _, name).
asdl_base(f, "legacy_module_sync", name) :- asdl_selected(f, "legacy_module_sync"), asdp_function(f, _, name).
asdl_base(f, "legacy_module_async", @replace_all(name, "_async\\z", "")) :- asdl_selected(f, "legacy_module_async"), asdp_function(f, _, name).
.decl asdl_keyword(d: node, value: symbol, i: number)
asdl_keyword(d, value, i) :- kind(d, "call"), field(d, "arguments", args), child(args, kw, i), kind(kw, "keyword_argument"), field(kw, "name", nm), text(nm, raw), @nfkc(raw) = "lazy_name", field(kw, "value", rawvalue), unparen(rawvalue, v), str_const(v, value).
.decl asdl_override(f: node, decorator: symbol, value: symbol)
asdl_override(f, decorator, value) :- asdl_selected(f, decorator), asdp_decorator(f, d, decorator), visit_index(d, i), i = min j : { asdp_decorator(f, other, decorator), visit_index(other, j) }, asdl_keyword(d, value, k), k = min j : { asdl_keyword(d, _, j) }, value != "".
.decl asdl_lazy_name(f: node, name: symbol)
asdl_lazy_name(f, value) :- asdl_override(f, _, value).
asdl_lazy_name(f, cat(base, "_lazy")) :- asdl_base(f, decorator, base), !asdl_override(f, decorator, _).
.decl asdl_requirement(f: node, base: symbol, lazy: symbol, counterpart: symbol, decorator: symbol)
asdl_requirement(f, base, lazy, cat(base, "_async"), "legacy_async") :- asdl_base(f, "legacy_sync", base), asdl_lazy_name(f, lazy).
asdl_requirement(f, base, lazy, base, "legacy_sync") :- asdl_base(f, "legacy_async", base), asdl_lazy_name(f, lazy).
asdl_requirement(f, base, lazy, cat(base, "_async"), "legacy_module_async") :- asdl_base(f, "legacy_module_sync", base), asdl_lazy_name(f, lazy).
asdl_requirement(f, base, lazy, base, "legacy_module_sync") :- asdl_base(f, "legacy_module_async", base), asdl_lazy_name(f, lazy).
// Only ast.Assign with exactly one ast.Name target participates. Other
// assignments do not clear an earlier simple-name binding in the source.
.decl asdl_assignment(c: node, name: symbol, value: node, i: number)
asdl_assignment(c, @nfkc(name), value, i) :- asdl_scope(c, _, _), body_of(c, b), body_stmt(b, stmt, i), asgstmt(a, stmt), !field(a, "type", _), count : { assign_target(a, _) } = 1, assign_target(a, raw), unparen(raw, target), kind(target, "identifier"), text(target, name), assign_value(a, rawvalue), unparen(rawvalue, value).
.decl asdl_rebinding_candidate(c: node, name: symbol, target: symbol, i: number)
asdl_rebinding_candidate(c, name, @nfkc(target), i) :- asdl_assignment(c, name, value, i), kind(value, "identifier"), text(value, target).
.decl asdl_rebinding(c: node, name: symbol, target: symbol)
asdl_rebinding(c, name, target) :- asdl_rebinding_candidate(c, name, target, i), i = max j : { asdl_rebinding_candidate(c, name, _, j) }.
.decl asdl_reach(c: node, start: symbol, end: symbol)
asdl_reach(c, a, b) :- asdl_rebinding(c, a, b).
asdl_reach(c, a, z) :- asdl_reach(c, a, b), asdl_rebinding(c, b, z).
.decl asdl_cycle(c: node, name: symbol)
asdl_cycle(c, name) :- asdl_reach(c, name, name).
.decl asdl_walk(c: node, root: symbol, name: symbol)
asdl_walk(c, root, root) :- asdl_function(c, f, _, _), asdl_requirement(f, _, root, _, _).
asdl_walk(c, root, next) :- asdl_walk(c, root, name), asdl_rebinding(c, name, next).
.decl asdl_final(c: node, root: symbol, final: symbol)
asdl_final(c, root, final) :- asdl_walk(c, root, final), !asdl_rebinding(c, final, _).
asdl_final(c, root, root) :- asdl_walk(c, root, root), asdl_cycle(c, root).
asdl_final(c, root, next) :- asdl_walk(c, root, name), !asdl_cycle(c, name), asdl_rebinding(c, name, next), asdl_cycle(c, next).
.decl asdl_final_lazy(c: node, root: symbol, f: node)
asdl_final_lazy(c, root, f) :- asdl_final(c, root, name), asdl_function(c, f, name, _).
.decl asdl_non_execution_lazy(c: node, root: symbol)
asdl_non_execution_lazy(c, root) :- asdl_final_lazy(c, root, f), asds_lazy_decorated(f), !asds_execution_lazy(f).
.decl asdl_builder(f: node, base: symbol)
asdl_builder(f, base) :- asdl_requirement(f, base, _, _, _), (base = "query" ; base = "query_unfiltered"), asds_return(f, ann), contains("Query", ann).
.decl asdl_target(c: node, f: node, owner: symbol, target: symbol, base: symbol, lazy: symbol, counterpart: symbol, decorator: symbol)
asdl_target(c, f, owner, name, base, lazy, counterpart, decorator) :- asdl_scope(c, owner, _), owner = "<module>", asdl_function(c, f, name, _), asdl_requirement(f, base, lazy, counterpart, decorator), asdp_function(f, path, _), !asdp_test_path(path).
asdl_target(c, f, owner, cat(owner, ".", name), base, lazy, counterpart, decorator) :- asdl_scope(c, owner, _), owner != "<module>", asdl_function(c, f, name, _), asdl_requirement(f, base, lazy, counterpart, decorator), !asdl_builder(f, base), !asdl_non_execution_lazy(c, lazy), asdp_function(f, path, _), !asdp_test_path(path).
.decl asdl_local_required(c: node)
asdl_local_required(c) :- asdl_scope(c, owner, _), (owner = "<module>" ; suffix("Connection", owner) ; suffix("SessionHandle", owner) ; suffix("VersionHandle", owner)).
.decl asdl_local_lazy(c: node, name: symbol)
asdl_local_lazy(c, name) :- asdl_final_lazy(c, name, f), asds_lazy_decorated(f).
.decl asdl_final_detail(c: node, name: symbol, text: symbol)
asdl_final_detail(c, name, "") :- asdl_final(c, name, name).
asdl_final_detail(c, name, cat(" final_binding=", @python_repr(final), ".")) :- asdl_final(c, name, final), name != final.
.decl asdl_counter_scope(c: node, other: node)
asdl_counter_scope(c, other) :- asdl_scope(c, owner, _), prefix("Sync", owner), counterpart = cat("Async", @slice(owner, 4, strlen(owner))), asdl_scope(other, counterpart, _), docof(c, d), docof(other, d).
asdl_counter_scope(c, other) :- asdl_scope(c, owner, _), prefix("Async", owner), counterpart = cat("Sync", @slice(owner, 5, strlen(owner))), asdl_scope(other, counterpart, _), docof(c, d), docof(other, d).
.decl asdl_counterpart(c: node, name: symbol, scope: node, f: node)
asdl_counterpart(c, name, c, f) :- asdl_function(c, f, name, _).
asdl_counterpart(c, name, other, f) :- asdl_counter_scope(c, other), asdl_function(other, f, name, _), !asdl_function(c, _, name, _).
.decl asdl_assignment_decorator(c: node, name: symbol, decorator: symbol)
asdl_assignment_decorator(c, name, decorator) :- asdl_assignment(c, name, value, _), kind(value, "call"), field(value, "function", rawfn), unparen(rawfn, fn), asdp_callable(fn, decorator), call_arg(value, 0, "", rawarg), unparen(rawarg, arg), kind(arg, "identifier"), text(arg, argument), @nfkc(argument) = name.
.decl asdl_paired(c: node, name: symbol, decorator: symbol)
asdl_paired(c, name, decorator) :- asdl_counterpart(c, name, _, f), asdp_decorator(f, _, decorator).
asdl_paired(c, name, decorator) :- asdl_counterpart(c, name, scope, _), asdl_assignment_decorator(scope, name, decorator).
.decl asdl_scope_max(d: number, size: number)
asdl_scope_max(d, size) :- asdl_scope(c, _, _), docof(c, d), size = max n : { asdl_scope(s, _, _), docof(s, d), body_of(s, b), body_len(b, n) }.
.decl asdl_ordinal(c: node, f: node, rank: number)
asdl_ordinal(c, f, (scope_order*(size+1)+first)*2) :- asdl_scope(c, _, scope_order), asdl_function(c, f, _, first), docof(c, d), asdl_scope_max(d, size).
ASDAnalysis(@place(path, line), target, "C", cat("Legacy wrapper ", target, " does not resolve through a local ", lazy, "() lazy surface"), "", cat("legacy_base=", @python_repr(base), "; expected_lazy=", @python_repr(lazy), ".", detail, " Every @legacy_* wrapper must resolve through a sibling *_lazy() function decorated with @lazy or @pure_lazy, and the final binding of that lazy symbol must stay lazy."), 0, 1, 4, rank) :- asdl_target(c, f, _, target, base, lazy, _, _), asdl_local_required(c), !asdl_local_lazy(c, lazy), asdl_final_detail(c, lazy, detail), asdp_function(f, path, _), line(f, line), asdl_ordinal(c, f, rank).
ASDAnalysis(@place(path, line), target, "C", cat("Legacy wrapper ", target, " is missing the required ", counterpart, "() decorated pair"), "", cat("legacy_base=", @python_repr(base), "; expected_counterpart=", @python_repr(counterpart), "; expected_decorator=", decorator, ". Legacy wrappers must always ship as sync/async pairs over one shared lazy family."), 0, 1, 4, rank+1) :- asdl_target(c, f, _, target, base, _, counterpart, decorator), !asdl_paired(c, counterpart, decorator), asdp_function(f, path, _), line(f, line), asdl_ordinal(c, f, rank).

// CPython's positional argument list includes starred arguments and excludes
// keywords, even when a starred argument follows a keyword in source order.
.decl asdw_pos_item(c: node, raw: node, order: number)
asdw_pos_item(c, raw, order) :- kind(c, "call"), field(c, "arguments", args), child(args, raw, order), !kind(raw, "comment"), !kind(raw, "keyword_argument"), !kind(raw, "dictionary_splat").
.decl asdw_arg(c: node, index: number, value: node)
asdw_arg(c, index, value) :- asdw_pos_item(c, raw, order), unparen(raw, value), index = count : { asdw_pos_item(c, _, j), j < order }.
.decl asdw_keyword(c: node, name: symbol, value: node, order: number)
asdw_keyword(c, @nfkc(name), value, order) :- kind(c, "call"), field(c, "arguments", args), child(args, kw, order), kind(kw, "keyword_argument"), field(kw, "name", nm), text(nm, name), field(kw, "value", raw), unparen(raw, value).
.decl asdw_expected(f: node, helper: symbol, boundary: symbol, terminal: symbol)
asdw_expected(f, "_resolve_legacy_result_sync", "run_in_legacy_execution_boundary", "resolve") :- asdp_function(f, _, _), !is_async(f).
asdw_expected(f, "_resolve_legacy_result_async", "run_in_legacy_execution_boundary_async", "resolve_async") :- asdp_function(f, _, _), is_async(f).
.decl asdw_call(f: node, value: node, call: node)
asdw_call(f, call, call) :- asdw_input(f, call), !is_async(f), kind(call, "call").
asdw_call(f, value, call) :- asdw_input(f, value), is_async(f), kind(value, "await"), child(value, raw, 0), unparen(raw, call), kind(call, "call").
.decl asdw_lazy_call(call: node, family: symbol)
asdw_lazy_call(call, @slice(name, 0, strlen(name)-5)) :- kind(call, "call"), field(call, "function", raw), unparen(raw, fn), asdp_callable(fn, name), suffix("_lazy", name).
.decl asdw_build_lambda(call: node, value: node)
asdw_build_lambda(call, value) :- asdw_arg(call, 2, value).
asdw_build_lambda(call, value) :- kind(call, "call"), !asdw_arg(call, 2, _), asdw_keyword(call, "build_lazy", value, i), i = min j : { asdw_keyword(call, "build_lazy", _, j) }.
.decl asdw_resolve(f: node, value: node, family: symbol)
asdw_resolve(f, value, family) :- asdw_call(f, value, call), asdw_expected(f, helper, _, _), field(call, "function", raw), unparen(raw, fn), asdp_callable(fn, helper), asdw_build_lambda(call, lam), kind(lam, "lambda"), field(lam, "body", body), unparen(body, lazy), asdw_lazy_call(lazy, family).
asdw_resolve(f, value, family) :- asdw_call(f, value, call), asdw_expected(f, _, boundary, terminal), field(call, "function", rawfn), unparen(rawfn, fn), asdp_callable(fn, boundary), field(call, "arguments", args), count : { child(args, item, _), !kind(item, "comment") } = 1, asdw_arg(call, 0, arg), kind(arg, "attribute"), field(arg, "attribute", nm), text(nm, name), @nfkc(name) = terminal, field(arg, "object", rawlazy), unparen(rawlazy, lazy), asdw_lazy_call(lazy, family).
asdw_resolve(f, value, family) :- asdw_call(f, value, call), asdw_expected(f, _, _, terminal), field(call, "function", rawfn), unparen(rawfn, fn), kind(fn, "attribute"), field(fn, "attribute", nm), text(nm, name), @nfkc(name) = terminal, field(fn, "object", rawlazy), unparen(rawlazy, lazy), asdw_lazy_call(lazy, family).
.decl asdw_value(stmt: node, value: node)
asdw_value(stmt, value) :- kind(stmt, k), (k = "return_statement" ; k = "expression_statement"), child(stmt, raw, 0), unparen(raw, value).
.decl asdw_order(f: node, stmt: node, index: number)
asdw_order(f, stmt, index) :- asdp_statement(f, stmt, i), index = count : { asdp_statement(f, _, j), j < i }.
.decl asdw_length(f: node, count: number)
asdw_length(f, count) :- asdp_function(f, _, _), count = count : { asdp_statement(f, _, _) }.
.decl asdw_assigned(f: node, family: symbol)
asdw_assigned(f, family) :- asdw_length(f, 2), asdw_order(f, first, 0), asgstmt(a, first), !field(a, "type", _), count : { assign_target(a, _) } = 1, assign_target(a, rawtarget), unparen(rawtarget, target), kind(target, "identifier"), text(target, name), assign_value(a, rawlazy), unparen(rawlazy, lazy), asdw_lazy_call(lazy, family), asdw_order(f, last, 1), kind(last, "return_statement"), asdw_value(last, value), asdw_call(f, value, call), asdw_expected(f, _, boundary, terminal), field(call, "function", rawfn), unparen(rawfn, fn), asdp_callable(fn, boundary), field(call, "arguments", args), count : { child(args, item, _), !kind(item, "comment") } = 1, asdw_arg(call, 0, attr), kind(attr, "attribute"), field(attr, "attribute", nm), text(nm, actual), @nfkc(actual) = terminal, field(attr, "object", rawobj), unparen(rawobj, obj), kind(obj, "identifier"), text(obj, receiver), @nfkc(receiver) = @nfkc(name).
.decl asdw_post(stmt: node, family: symbol)
asdw_post(stmt, family) :- kind(stmt, "expression_statement"), child(stmt, raw, 0), unparen(raw, call), kind(call, "call"), field(call, "function", rawfn), unparen(rawfn, fn), asdp_callable(fn, name), asdp_normalized(name, family).
.decl asdw_bad_handler(t: node)
asdw_bad_handler(t) :- kind(t, "try_statement"), child(t, h, _), kind(h, "except_clause"), op(h, "*").
asdw_bad_handler(t) :- kind(t, "try_statement"), child(t, h, _), kind(h, "except_clause"), child(h, b, _), kind(b, "block"), !body_stmt(b, _, _).
asdw_bad_handler(t) :- kind(t, "try_statement"), child(t, h, _), kind(h, "except_clause"), child(h, b, _), kind(b, "block"), last = max i : { body_stmt(b, _, i) }, body_stmt(b, s, last), !kind(s, "raise_statement").
.decl asdw_try(t: node, statement: node)
asdw_try(t, statement) :- kind(t, "try_statement"), field(t, "body", b), body_len(b, 1), body_stmt(b, statement, 0), !asdw_bad_handler(t), count : { child(t, other, _), (kind(other, "else_clause") ; kind(other, "finally_clause")) } = 0.
.decl asdw_input(f: node, value: node)
asdw_input(f, value) :- asdp_statement(f, stmt, _), asdw_value(stmt, value).
asdw_input(f, value) :- asdp_single(f, t), asdw_try(t, stmt), asdw_value(stmt, value).
.decl asdw_signature(f: node, family: symbol, post: symbol, has_post: number)
asdw_signature(f, family, "", 0) :- asdp_single(f, stmt), asdw_value(stmt, value), asdw_resolve(f, value, family).
asdw_signature(f, family, "__exception_translation__", 1) :- asdp_single(f, t), asdw_try(t, stmt), asdw_value(stmt, value), asdw_resolve(f, value, family).
asdw_signature(f, family, "", 0) :- asdw_assigned(f, family).
asdw_signature(f, family, post, 1) :- asdw_length(f, 2), !asdw_assigned(f, _), asdw_order(f, stmt, 0), asdw_value(stmt, value), asdw_resolve(f, value, family), asdw_order(f, last, 1), asdw_post(last, post).
.decl asdw_candidate(c: node, sync: node, async: node, cls: symbol, sn: symbol, an: symbol, path: symbol, first: number)
asdw_candidate(c, sync, async, @nfkc(cls), sn, an, path, first) :- asdp_method(c, async, an, first), suffix("_async", an), sn = @slice(an, 0, strlen(an)-6), sn != "", !prefix("_", sn), asdp_method(c, sync, sn, _), def_name(c, cls), asdp_function(async, path, _), !asdp_test_path(path), !asdp_browser(path), !asdp_abstract(sync), !asdp_abstract(async), !asds_unsupported(sync), !asds_unsupported(async), !option_item("allowlistedTargets", _, cat(path, "::", @nfkc(cls), ".", an)).
.decl asdw_callback_pair(c: node, async: node)
asdw_callback_pair(c, async) :- asdw_candidate(c, sync, async, _, _, _, _, _), (asds_callback(sync) ; asds_callback(async)).
.decl asdw_shared_thin(c: node, async: node)
asdw_shared_thin(c, async) :- asdw_candidate(c, sync, async, _, _, _, _, _), asdp_thin(sync, family), asdp_thin(async, family).
.decl asdw_callback_legacy(c: node, async: node)
asdw_callback_legacy(c, async) :- asdw_candidate(c, sync, async, _, _, _, _, _), (asdp_decorator(sync, _, "legacy_sync") ; asdp_decorator(async, _, "legacy_async")).
.decl asdw_participates(c: node, async: node)
asdw_participates(c, async) :- asdw_candidate(c, _, async, _, sn, _, _, _), asdp_method(c, _, cat(sn, "_lazy"), _).
asdw_participates(c, async) :- asdw_candidate(c, sync, async, _, _, _, _, _), (asdw_signature(sync, _, _, _) ; asdw_signature(async, _, _, _)).
.decl asdw_triple(c: node, async: node)
asdw_triple(c, async) :- asdw_candidate(c, sync, async, _, sn, _, _, _), asdp_method(c, lazy, cat(sn, "_lazy"), _), asdp_decorator(sync, _, "legacy_sync"), asdp_decorator(async, _, "legacy_async"), asds_execution_lazy(lazy).
.decl asdw_shared_signature(c: node, async: node)
asdw_shared_signature(c, async) :- asdw_candidate(c, sync, async, _, _, _, _, _), asdw_signature(sync, family, post, has_post), asdw_signature(async, family, post, has_post).
.decl asdw_lazy_text(f: node, text: symbol)
asdw_lazy_text(f, @python_repr(family)) :- asdw_signature(f, family, _, _).
asdw_lazy_text(f, "None") :- asdp_function(f, _, _), !asdw_signature(f, _, _, _).
.decl asdw_class_order(c: node, d: number, end: number, depth: number)
asdw_class_order(c, d, end, depth) :- asdw_candidate(c, _, _, _, _, _, _, _), node(d, c, _, _, end), ast_depth(c, depth).
.decl asdw_rank(c: node, async: node, rank: number)
asdw_rank(c, async, rank) :- asdw_candidate(c, _, async, _, _, _, _, first), asdw_class_order(c, d, end, depth), rank = count : { asdw_candidate(other, _, _, _, _, _, _, i), asdw_class_order(other, d, oe, od), (oe < end ; (oe = end, od > depth) ; (other = c, i < first)) }.
ASDAnalysis(@place(path, line), cat(cls, ".", an), "C", cat("Public sync/async pair ", cls, ".", sn, "/", an, " does not delegate to one shared helper family"), "", cat("sync_helper=", sync_text, "; async_helper=", async_text, ". Move orchestration into a shared helper family and keep both public entrypoints thin."), 0, 1, 3, rank) :- asdw_candidate(c, sync, async, cls, sn, an, path, _), asdw_callback_pair(c, async), !asdw_callback_legacy(c, async), !asdw_shared_thin(c, async), asdp_family_text(sync, sync_text), asdp_family_text(async, async_text), line(async, line), asdw_rank(c, async, rank).
ASDAnalysis(@place(path, line), cat(cls, ".", an), "C", cat("Eager txn-bound pair ", cls, ".", sn, "/", an, " does not resolve through one shared lazy family"), "", cat("sync_lazy=", sync_text, "; async_lazy=", async_text, ". Use a shared *_lazy implementation and make the eager pair resolve it."), 0, 1, 3, rank) :- asdw_candidate(c, sync, async, cls, sn, an, path, _), !asdw_callback_pair(c, async), (asds_transaction(sync) ; asds_transaction(async)), (sn != "ensure_schema" ; !asdw_shared_thin(c, async)), asdw_participates(c, async), !asdw_triple(c, async), !asdw_shared_signature(c, async), asdw_lazy_text(sync, sync_text), asdw_lazy_text(async, async_text), line(async, line), asdw_rank(c, async, rank).

.decl asde_pattern(name: symbol)
asde_pattern("asyncio.to_thread").
asde_pattern("to_thread").
asde_pattern("run_in_executor").
asde_pattern("tracked_to_thread").
asde_pattern("tracked_run_in_executor").

.decl asde_allow_function(path: symbol, name: symbol)
asde_allow_function("impl/common/l2550_storage_backend/backend.py","delete_async").
asde_allow_function("impl/common/l2550_storage_backend/backend.py","exists_async").
asde_allow_function("impl/common/l2550_storage_backend/backend.py","get_metadata_async").
asde_allow_function("impl/common/l2550_storage_backend/backend.py","get_stats_async").
asde_allow_function("impl/common/l2550_storage_backend/backend.py","iter_content_hashes_async").
asde_allow_function("impl/common/l2550_storage_backend/backend.py","retrieve_async").
asde_allow_function("impl/common/l2550_storage_backend/backend.py","store_async").
asde_allow_function("impl/sqlite/native_async_wrapper.py","_run_sqlite_call_in_thread").

.decl asde_name(call: node, name: symbol)
asde_name(call, @nfkc(name)) :- kind(call, "call"), field(call, "function", raw), unparen(raw, fn), kind(fn, "identifier"), text(fn, name).
asde_name(call, cat(@nfkc(receiver), ".", @nfkc(name))) :- kind(call, "call"), field(call, "function", raw), unparen(raw, fn), kind(fn, "attribute"), field(fn, "object", rawobj), unparen(rawobj, obj), kind(obj, "identifier"), text(obj, receiver), field(fn, "attribute", nm), text(nm, name).
asde_name(call, @nfkc(name)) :- kind(call, "call"), field(call, "function", raw), unparen(raw, fn), kind(fn, "attribute"), field(fn, "object", rawobj), unparen(rawobj, obj), !kind(obj, "identifier"), field(fn, "attribute", nm), text(nm, name).
.decl asde_call(call: node, name: symbol)
asde_call(call, name) :- asde_name(call, name), asde_pattern(pattern), (name = pattern ; suffix(cat(".", pattern), name)).
.decl asde_owner(n: node, name: symbol)
asde_owner(n, name) :- kind(n, k), (k = "call" ; k = "await"), def_frame(n, f), asdp_function(f, _, name).
asde_owner(n, "<module>") :- kind(n, k), (k = "call" ; k = "await"), !def_frame(n, _).
.decl asde_allowed(n: node)
asde_allowed(n) :- def_frame(n, f), asdp_function(f, path, name), asde_allow_function(tail, name), suffix(tail, path).
.decl asde_event(n: node, d: number, path: symbol, line: number, function_name: symbol, description: symbol, ordinal: number)
asde_event(n, d, path, line, owner, cat("Escape hatch: ", name, "()"), i) :- asde_call(n, name), docof(n, d), asdp_path(d, path), !syntax_error(d, _, _), !asde_allowed(n), asde_owner(n, owner), line(n, line), visit_index(n, i).
asde_event(n, d, path, line, owner, cat("Escape hatch: await ", name, "()"), i) :- kind(n, "await"), child(n, raw, 0), unparen(raw, call), asde_call(call, name), docof(n, d), asdp_path(d, path), !syntax_error(d, _, _), !asde_allowed(n), asde_owner(n, owner), line(n, line), visit_index(n, i).
ASDAnalysis(@place(path, line), owner, "C", description, "", "Replace with native async driver call", 0, 1, 5, i) :- asde_event(_, d, path, line, owner, description, i), i = min j : { asde_event(_, d, _, line, _, _, j) }.
