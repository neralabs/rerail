.decl gfu_last_method(c: node, name: symbol, f: node)
gfu_last_method(c, name, f) :- gfu_method(c, f, name, i), name != "render", i = max j : { gfu_method(c, _, name, j) }.
gfu_last_method(c, "render", f) :- gfu_first(c, "render", f).
