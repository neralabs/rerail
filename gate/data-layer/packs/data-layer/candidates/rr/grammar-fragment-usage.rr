gfu_ann_edge(n, c) :- kind(n, k), (k = "type" ; k = "type_parameter" ; k = "generic_type" ; k = "union_type" ; k = "list" ; k = "tuple"), child(n, raw, _), !kind(raw, "comment"), unparen(raw, c).
