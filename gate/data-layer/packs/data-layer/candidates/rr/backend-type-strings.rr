\\x{16b2f}\\x{16b40}-\\x{16b43}\\x{16b50}-\\x{16b59}\\x{16b5b}-\\x{16b61}\\x{16b63}-\\x{16b77}\\x{16b7d}-\\x{16b8f}\\x{16e40}-\\x{16e96}\\x{16f00}-\\x{16f4a}\\x{16f50}\\x{16f93}-\\x{16f9f}\\x{16fe0}-\\x{16fe1}\\x{16fe3}\\x{17000}-\\x{187f7}\\x{18800}-\\x{18cd5}\\x{18d00}-\\x{18d08}\\x{1aff0}-\\x{1aff3}\\x{1aff5}-\\x{1affb}\\x{1affd}-\\x{1affe}\\x{1b000}-\\x{1b122}\\x{1b132}\\x{1b150}-\\x{1b152}\\x{1b155}\\x{1b164}-\\x{1b167}\\x{1b170}-\\x{1b2fb}\\x{1bc00}-\\x{1bc6a}\\x{1bc70}-\\x{1bc7c}\\x{1bc80}-\\x{1bc88}\\x{1bc90}-\\x{1bc99}\\x{1d2c0}-\\x{1d2d3}\\x{1d2e0}-\\x{1d2f3}\\x{1d360}-\\x{1d378}\\x{1d400}-\\x{1d454}\\x{1d456}-\\x{1d49c}\\x{1d49e}-\\x{1d49f}\\x{1d4a2}\\x{1d4a5}-\\x{1d4a6}\\x{1d4a9}-\\x{1d4ac}\\x{1d4ae}-\\x{1d4b9}\\x{1d4bb}\\x{1d4bd}-\\x{1d4c3}\\x{1d4c5}-\\x{1d505}\\x{1d507}-\\x{1d50a}\\x{1d50d}-\\x{1d514}\\x{1d516}-\\x{1d51c}\\x{1d51e}-\\x{1d539}\\x{1d53b}-\\x{1d53e}\\x{1d540}-\\x{1d544}\\x{1d546}\\x{1d54a}-\\x{1d550}\\x{1d552}-\\x{1d6a5}\\x{1d6a8}-\\x{1d6c0}\\x{1d6c2}-\\x{1d6da}\\x{1d6dc}-\\x{1d6fa}\\x{1d6fc}-\\x{1d714}\\x{1d716}-\\x{1d734}\\x{1d736}-\\x{1d74e}\\x{1d750}-\\x{1d76e}\\x{1d770}-\\x{1d788}\\x{1d78a}-\\x{1d7a8}\\x{1d7aa}-\\x{1d7c2}\\x{1d7c4}-\\x{1d7cb}\\x{1d7ce}-\\x{1d7ff}\\x{1df00}-\\x{1df1e}\\x{1df25}-\\x{1df2a}\\x{1e030}-\\x{1e06d}\\x{1e100}-\\x{1e12c}\\x{1e137}-\\x{1e13d}\\x{1e140}-\\x{1e149}\\x{1e14e}\\x{1e290}-\\x{1e2ad}\\x{1e2c0}-\\x{1e2eb}\\x{1e2f0}-\\x{1e2f9}\\x{1e4d0}-\\x{1e4eb}\\x{1e4f0}-\\x{1e4f9}\\x{1e7e0}-\\x{1e7e6}\\x{1e7e8}-\\x{1e7eb}\\x{1e7ed}-\\x{1e7ee}\\x{1e7f0}-\\x{1e7fe}\\x{1e800}-\\x{1e8c4}\\x{1e8c7}-\\x{1e8cf}\\x{1e900}-\\x{1e943}\\x{1e94b}\\x{1e950}-\\x{1e959}\\x{1ec71}-\\x{1ecab}\\x{1ecad}-\\x{1ecaf}\\x{1ecb1}-\\x{1ecb4}\\x{1ed01}-\\x{1ed2d}\\x{1ed2f}-\\x{1ed3d}\\x{1ee00}-\\x{1ee03}\\x{1ee05}-\\x{1ee1f}\\x{1ee21}-\\x{1ee22}\\x{1ee24}\\x{1ee27}\\x{1ee29}-\\x{1ee32}\\x{1ee34}-\\x{1ee37}\\x{1ee39}\\x{1ee3b}\\x{1ee42}\\x{1ee47}\\x{1ee49}\\x{1ee4b}\\x{1ee4d}-\\x{1ee4f}\\x{1ee51}-\\x{1ee52}\\x{1ee54}\\x{1ee57}\\x{1ee59}\\x{1ee5b}\\x{1ee5d}\\x{1ee5f}\\x{1ee61}-\\x{1ee62}\\x{1ee64}\\x{1ee67}-\\x{1ee6a}\\x{1ee6c}-\\x{1ee72}\\x{1ee74}-\\x{1ee77}\\x{1ee79}-\\x{1ee7c}\\x{1ee7e}\\x{1ee80}-\\x{1ee89}\\x{1ee8b}-\\x{1ee9b}\\x{1eea1}-\\x{1eea3}\\x{1eea5}-\\x{1eea9}\\x{1eeab}-\\x{1eebb}\\x{1f100}-\\x{1f10c}\\x{1fbf0}-\\x{1fbf9}\\x{20000}-\\x{2a6df}\\x{2a700}-\\x{2b739}\\x{2b740}-\\x{2b81d}\\x{2b820}-\\x{2cea1}\\x{2ceb0}-\\x{2ebe0}\\x{2ebf0}-\\x{2ee5d}\\x{2f800}-\\x{2fa1d}\\x{30000}-\\x{3134a}\\x{31350}-\\x{323af}]]", "�"), @slice(@replace_all(raw, "\\A[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+|[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+\\z", ""), 0, 80)) :- bts_doc(d), split_line(d, l, raw), !match("(?s)[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*#.*", raw).
.decl bts_occurrence(d: number, line: number, pattern: number, occurrence: number, start: number, matched: symbol, snippet: symbol)
bts_occurrence(d, l, 0, i, a, @slice(raw, a, b), snippet) :- bts_line(d, l, raw, normalized, snippet), match_all("(?<whole>dialect\\.name[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*==[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*[\"\\'](sqlite|mongo|mariadb|dolt|postgres|postgresql|mongodb|mysql|neo4j|doltdb)[\"\\'])", normalized, i, a, b).
bts_occurrence(d, l, 1, i, a, @slice(raw, a, b), snippet) :- bts_line(d, l, raw, normalized, snippet), match_all("(?<whole>dialect\\.name[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+in[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+\\()", normalized, i, a, b).
bts_occurrence(d, l, 2, i, a, @slice(raw, a, b), snippet) :- bts_line(d, l, raw, normalized, snippet), match_all("(?<whole>backend_type[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*==[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*[\"\\'](sqlite|mongo|mariadb|dolt|postgres|postgresql|mongodb|mysql|neo4j|doltdb)[\"\\'])", normalized, i, a, b).
bts_occurrence(d, l, 3, i, a, @slice(raw, a, b), snippet) :- bts_line(d, l, raw, normalized, snippet), match_all("(?<whole>\\bbackend[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*==[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*[\"\\'](sqlite|mongo|mariadb|dolt|postgres|postgresql|mongodb|mysql|neo4j|doltdb)[\"\\'])", normalized, i, a, b).
bts_occurrence(d, l, 4, i, a, @slice(raw, a, b), snippet) :- bts_line(d, l, raw, normalized, snippet), match_all("(?<whole>\\bbackend[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+in[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+\\([^)]*[\"\\'](sqlite|mongo|mariadb|dolt|postgres|postgresql|mongodb|mysql|neo4j|doltdb)[\"\\'])", normalized, i, a, b).
bts_occurrence(d, l, 5, i, a, @slice(raw, a, b), snippet) :- bts_line(d, l, raw, normalized, snippet), match_all("(?<whole>[\"\\'](sqlite|mongo|mariadb|dolt|postgres|postgresql|mongodb|mysql|neo4j|doltdb)[\"\\'][\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+in[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+\\w*class_name)", normalized, i, a, b).
bts_occurrence(d, l, 6, i, a, @slice(raw, a, b), snippet) :- bts_line(d, l, raw, normalized, snippet), match_all("(?<whole>[\"\\'](sqlite|mongo|mariadb|dolt|postgres|postgresql|mongodb|mysql|neo4j|doltdb)[\"\\'][\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+in[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+type\\()", normalized, i, a, b).
bts_occurrence(d, l, 7, i, a, @slice(raw, a, b), snippet) :- bts_line(d, l, raw, normalized, snippet), match_all("(?<whole>__class__\\.__name__\\.lower\\(\\))", normalized, i, a, b).

.decl bts_matched(m: symbol)
bts_matched(m) :- bts_occurrence(_, _, _, _, _, m, _).
.decl bts_dialect(m: symbol)
bts_dialect(m) :- bts_matched(m), contains("dialect.name", m).
.decl bts_backend(m: symbol)
bts_backend(m) :- bts_matched(m),
    (contains("backend_type", m) ; contains("backend ==", m) ; contains("backend in", m)).
.decl bts_substring(m: symbol)
bts_substring(m) :- bts_matched(m), contains(" in ", m), (contains("class_name", m) ; contains("type(", m)).
.decl bts_class(m: symbol)
bts_class(m) :- bts_matched(m), contains("__class__.__name__", m).
.decl bts_code(m: symbol, code: symbol)
bts_code(m, "BT001") :- bts_dialect(m), contains(" in ", m).
bts_code(m, "BT002") :- bts_dialect(m), !contains(" in ", m).
bts_code(m, "BT003") :- bts_backend(m), !bts_dialect(m).
bts_code(m, "BT004") :- bts_substring(m), !bts_dialect(m), !bts_backend(m).
bts_code(m, "BT005") :- bts_class(m), !bts_dialect(m), !bts_backend(m), !bts_substring(m).
bts_code(m, "BT000") :- bts_matched(m), !bts_dialect(m), !bts_backend(m), !bts_substring(m), !bts_class(m).
.violation BackendBT000(at: span, pattern: number, occurrence: number, column: number, snippet: symbol) code "BT000" "Possible backend type string comparison - consider using BackendType enum"
BackendBT000(@place(path, l), pattern, occurrence, a + 1, snippet) :- bts_occurrence(d, l, pattern, occurrence, a, matched, snippet), bts_code(matched, "BT000"), doc(d, path, _).
.violation BackendBT001(at: span, pattern: number, occurrence: number, column: number, snippet: symbol) code "BT001" "Use BackendType enum with .is_mysql_family or .is_sql_backend instead of dialect.name in (...)"
BackendBT001(@place(path, l), pattern, occurrence, a + 1, snippet) :- bts_occurrence(d, l, pattern, occurrence, a, matched, snippet), bts_code(matched, "BT001"), doc(d, path, _).
.violation BackendBT002(at: span, pattern: number, occurrence: number, column: number, snippet: symbol) code "BT002" "Use BackendType enum instead of dialect.name == 'string'"
BackendBT002(@place(path, l), pattern, occurrence, a + 1, snippet) :- bts_occurrence(d, l, pattern, occurrence, a, matched, snippet), bts_code(matched, "BT002"), doc(d, path, _).
.violation BackendBT003(at: span, pattern: number, occurrence: number, column: number, snippet: symbol) code "BT003" "Use BackendType enum instead of string comparison"
BackendBT003(@place(path, l), pattern, occurrence, a + 1, snippet) :- bts_occurrence(d, l, pattern, occurrence, a, matched, snippet), bts_code(matched, "BT003"), doc(d, path, _).
.violation BackendBT004(at: span, pattern: number, occurrence: number, column: number, snippet: symbol) code "BT004" "Use BackendType.from_connection_class() instead of substring matching"
BackendBT004(@place(path, l), pattern, occurrence, a + 1, snippet) :- bts_occurrence(d, l, pattern, occurrence, a, matched, snippet), bts_code(matched, "BT004"), doc(d, path, _).
.violation BackendBT005(at: span, pattern: number, occurrence: number, column: number, snippet: symbol) code "BT005" "Use BackendType.from_connection_class() instead of class name inspection"
BackendBT005(@place(path, l), pattern, occurrence, a + 1, snippet) :- bts_occurrence(d, l, pattern, occurrence, a, matched, snippet), bts_code(matched, "BT005"), doc(d, path, _).

.violation Skip(at: span) code "BTS_SKIP" "true"
Skip(@place("backend-policy", 1)) :- option("entryPoint", "should_skip_file"), option("path", path), bts_skip(path).
.violation Skipped(at: span) code "BTS_SKIPPED" "Path skipped"
Skipped(@place("backend-policy", 1)) :- option("entryPoint", entry),
    (entry = "check_file" ; entry = "check_file_content"), bts_api_skip().
.violation File(at: span, result: symbol) code "BTS_FILE" "{result}"
File(@place("backend-policy", 1), path) :- option("entryPoint", "find_python_files"), option_item("candidates", _, path), suffix(".py", path).
.violation Configuration(at: span, key: symbol, ordinal: number, value: symbol) code "BTS_CONFIG" "{value}"
Configuration(@place("backend-policy", 1), key, i, value) :- option("entryPoint", "configuration"), bts_config(key, i, value).

.decl tcli_kind(value: symbol)
tcli_kind("backend").
.decl tcli_config(key: symbol, ordinal: number, value: symbol)
tcli_config("description",0,"Lint for backend type string comparisons").
tcli_config("epilog",0,"Linter to detect string-based backend type comparisons.\n\nThis linter finds code that uses string literals for backend type comparisons\ninstead of the type-safe BackendType enum.\n\nUsage:\n    uv run python scripts/lint_backend_type_strings.py [--check] [paths...]\n\nOptions:\n    --check     Exit with error code if violations found (for CI)\n    paths       Specific paths to check (defaults to api/ impl/)\n\nDetects:\n    - dialect.name == \"postgres\" (should use BackendType enum)\n    - dialect.name in (\"mysql\", \"mariadb\") (should use .is_mysql_family)\n    - backend_type == \"sqlite\" (should use BackendType enum)\n    - \"postgres\" in class_name (should use BackendType.from_connection_class)\n    - conn.__class__.__name__.lower() patterns\n\nIgnores:\n    - Test files (conform/, tests/, *_test.py)\n    - The BackendType enum definition itself\n    - URL scheme parsing (postgresql://)\n    - Config/YAML file references\n").
tcli_config("check_help",0,"Exit with error code if violations found (for CI)").
tcli_config("paths_help",0,"Paths to check (default: api/ impl/ data_layer/ lXXXX_*/)").
#include "data-layer/text-cli.rr"
