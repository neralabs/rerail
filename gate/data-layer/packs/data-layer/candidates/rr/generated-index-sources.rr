.policy "data-layer:generated-index-sources" revision 1
.description "Generated auxiliary indexes are built by _generated_index, which takes and forwards a required IndexSource."
.language python
.mode block
.scope dirs "__generated_index_no_primary__"
.scope dirs option("apiInputDirs")
// Python linter: scripts/lint_generated_index_sources.py, on the generator file only. One code, missing_source:
//   an Index(…) call outside a def named _generated_index (module level included), or inside one without source=source;
//   a plain `def _generated_index` with no `source` parameter (positional or keyword-only), with one not annotated
//   IndexSource, or whose keyword-only default is MODEL_DECLARED (bare or IndexSource.MODEL_DECLARED).
// An Index call is `Index(…)`, a name from-imported from l1000_schema.schema_def as Index, or `m.Index(…)` where m
// is `schema_def` or a name `import l1000_schema.schema_def [as m]` binds. Aliases count from their import on, in
// visit order, for the whole file (the linter grows one set as it walks).
// The fact engine runs the collector only on files whose text contains "Index(", "_generated_index" or "IndexSource".
//
// How to read this file
//   1. gis_doc: the trigger gate. gis_index_name / gis_module_name: the alias sets, each with the import it starts at.
//   2. gis_index_call: the calls that build an Index.
//   3. missing_source: one rule per message of the linter.

#include "python/ast.rr"     // def_frame, sig_param, unparen, dotted_expr, from_module_raw
#include "python/calls.rr"   // call_arg
#include "data-layer/plugin-production.rr"
#include "generated-index-sources.tables.rr"
#include "data-layer/generated-indexes-api.rr"

// Python normalizes identifier spellings before collector callbacks. Keep raw
// source triggers unchanged, but compare semantic names in that normalized form.
.decl gis_name(n: node, value: symbol)
gis_name(n,@nfkc(raw)) :- kind(n,"identifier"),text(n,raw).
gis_name(n,@nfkc(raw)) :- kind(n,"dotted_name"),text(n,raw).

// gis_doc(d): the file's text holds one of the collector's triggers.
.decl gis_trigger(t: symbol)
gis_trigger("Index("). gis_trigger("_generated_index"). gis_trigger("IndexSource").
.decl gis_doc(d: number)
gis_doc(d) :- pp_doc(d,_),pp_fact_present(d).
gis_doc(d) :- option("entryPoint","_collector_facts"),pp_doc(d,_),!syntax_error(d,_,_).
.decl gis_owner(d: number, path: symbol)
gis_owner(d,p) :- doc(d,b,_),option_item("apiBuffers",i,b),option_item("apiSourcePaths",i,p).
gis_owner(d,cat(root,"/",p)) :- pp_run(),pp_doc(d,p),workspace_root(root).
gis_owner(d,p) :- pp_api(),doc(d,p,_),!option_item("apiBuffers",_,_).

// gis_index_name(x, i): x names Index from import i on; i is unset for the built-in "Index".
// gis_module_name(x, i): x names the schema_def module, the same way.
.decl gis_index_name(d: number, x: symbol, i: loc)
gis_index_name(d, "Index", u) :- gis_doc(d), unset(u).
gis_index_name(d, x, i) :- from_module_raw(i, raw),@nfkc(raw)="l1000_schema.schema_def", docof(i, d), field(i, "name", a),
    gis_alias(a, "Index", x).
.decl gis_module_name(d: number, x: symbol, i: loc)
gis_module_name(d, "schema_def", u) :- gis_doc(d), unset(u).
// `import l1000_schema.schema_def` binds its last segment, as the linter's rpartition has it (Python binds the head).
gis_module_name(d, x, i) :- kind(i, "import_statement"), docof(i, d), field(i, "name", a), kind(a, "aliased_import"),
    gis_alias(a, "l1000_schema.schema_def", x).
gis_module_name(d, "schema_def", i) :- kind(i, "import_statement"), docof(i, d), field(i, "name", a),
    kind(a, "dotted_name"), gis_name(a, "l1000_schema.schema_def").
// gis_alias(a, name, local): import item a imports name, bound as local (the name itself when there is no `as`).
.decl gis_alias(a: node, name: symbol, local: symbol)
gis_alias(a, x, x) :- kind(a, "dotted_name"), gis_name(a, x).
gis_alias(a, x, l) :- kind(a, "aliased_import"), field(a, "name", n), gis_name(n, x), field(a, "alias", al), gis_name(al, l).
// gis_before(i, n): import i comes before call n in visit order, or i is unset (the name always counts).
.decl gis_before(i: loc, n: node)
gis_before(i, n) :- unset(i), kind(n, "call").
gis_before(i, n) :- kind(n, "call"), earlier(i, n).

// gis_index_call(c): `Index(…)` by a current alias, or `m.Index(…)` on a current module alias.
.decl gis_index_call(c: node)
gis_index_call(c) :- kind(c, "call"), field(c, "function", f), kind(f, "identifier"), gis_name(f, x), docof(c, d), gis_doc(d),
    gis_index_name(d, x, i), gis_before(i, c).
gis_index_call(c) :- kind(c, "call"), field(c, "function", f), kind(f, "attribute"), field(f, "attribute", a),
    gis_name(a, "Index"), field(f, "object", o), kind(o, "identifier"), gis_name(o, m), docof(c, d), gis_doc(d),
    gis_module_name(d, m, i), gis_before(i, c).

// gis_helper(f): a def (async too) named _generated_index; the call's innermost def is what the linter's stack holds.
.decl gis_helper(f: node)
gis_helper(f) :- def_name(f, raw),@nfkc(raw)="_generated_index", kind(f, "function_definition").
// gis_forwards(c): the call passes source=source (a bare name).
.decl gis_forwards(c: node)
.decl gis_source_kw(c: node, argument: node, value: node)
gis_source_kw(c,a,v) :- kind(c,"call"),field(c,"arguments",al),child(al,a,_),kind(a,"keyword_argument"),
    field(a,"name",n),gis_name(n,"source"),field(a,"value",v).
.decl gis_later_kw(c: node, argument: node)
gis_later_kw(c,a) :- gis_source_kw(c,a,_),gis_source_kw(c,b,_),earlier(b,a).
gis_forwards(c) :- gis_source_kw(c,a,v),!gis_later_kw(c,a),kind(v,"identifier"),gis_name(v,"source").
// gis_source_param(f, ann, dflt): the plain def _generated_index's `source` parameter, positional or keyword-only.
.decl gis_check(f: node)
gis_check(f) :- gis_helper(f), !op(f, "async"), docof(f, d), gis_doc(d).
.decl gis_source_param(f: node, k: symbol, ann: loc, dflt: loc)
.decl gis_source_candidate(f: node, i: number, k: symbol, ann: loc, dflt: loc)
gis_source_candidate(f,i,k,a,v) :- gis_check(f),sig_param(f,i,nm,_,k,a,v),gis_name(nm,"source"),(k="pos";k="kwonly").
// ast.parse accepts duplicate parameters. The source chooses the first annotation,
// while its keyword-default dictionary retains the last matching default.
gis_source_param(f,k,a,v) :- gis_source_candidate(f,i,k,a,v),i=min j:{gis_source_candidate(f,j,_,_,_)}.
.decl gis_kw_default(f: node, dflt: loc)
gis_kw_default(f,v) :- gis_source_candidate(f,i,"kwonly",_,v),i=max j:{gis_source_candidate(f,j,"kwonly",_,_)}.
.decl gis_model_declared(s: symbol)
gis_model_declared("MODEL_DECLARED"). gis_model_declared("IndexSource.MODEL_DECLARED").

.decl gis_finding(at: node, why: symbol, rank: number)
// Preserve the collector's parse-back fallback, including caller path spelling.
.decl gis_output(d: number, path: symbol, source_line: number, message: symbol, ordinal: number, rank: number)
gis_output(d,p,l,why,i,rank) :- gis_finding(n,why,rank),visit_index(n,i),line(n,l),docof(n,d),pp_doc(d,p),gis_owner(d,owner),!contains(": ",owner).
gis_output(d,p,1,cat(owner,":",to_string(l),": ",why),i,rank) :- gis_finding(n,why,rank),visit_index(n,i),line(n,l),docof(n,d),pp_doc(d,p),gis_owner(d,owner),contains(": ",owner).
.decl gis_scan()
gis_scan() :- !option("entryPoint",_).
gis_scan() :- option("entryPoint",e),(e="check_file";e="check_source";e="check_repo";e="_run_fact_engine_for_files").
.violation missing_source(at: span, why: symbol, ordinal: number, rank: number) "{why}"
missing_source(@place(p,l),why,i,rank) :- gis_scan(),gis_output(_,p,l,why,i,rank).
gis_finding(c, "generated indexes must use _generated_index(..., source=IndexSource.*)", 0) :-
    gis_index_call(c), !gis_in_helper(c).
gis_finding(c, "_generated_index must forward source=source into Index(...)", 0) :-
    gis_index_call(c), gis_in_helper(c), !gis_forwards(c).
gis_finding(f, "_generated_index must require a source: IndexSource parameter", 0) :-
    gis_check(f), !gis_source_param(f, _, _, _).
gis_finding(f, "_generated_index source parameter must be annotated as IndexSource", 1) :-
    gis_source_param(f, _, a, _), !gis_index_source(a).
gis_finding(f, "_generated_index source must not default to MODEL_DECLARED", 2) :-
    gis_kw_default(f, v), unparen(v, e), dotted_expr(e, s), gis_model_declared(@nfkc(s)).
// gis_in_helper(c): c's innermost def (decorators and defaults belong to it) is a _generated_index.
.decl gis_in_helper(c: node)
gis_in_helper(c) :- gis_index_call(c), def_frame(c, f), gis_helper(f).
// gis_index_source(a): annotation a (a `type` node) unparses to IndexSource: the bare name, perhaps parenthesised.
.decl gis_index_source(a: loc)
gis_index_source(a) :- gis_source_param(_, _, a, _), child(a, t, 0), unparen(t, e), kind(e, "identifier"),
    gis_name(e, "IndexSource").
