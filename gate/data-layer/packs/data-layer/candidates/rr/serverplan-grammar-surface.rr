.decl pp_fact_allowed(path: symbol)
.decl pp_report_allowed(path: symbol)
pp_fact_allowed(p) :- pp_file(p), !pp_fact_excluded(p).
.decl pp_fact_excluded(path: symbol)
pp_report_allowed(p) :- pp_file(p), !pp_report_excluded(p).
.decl pp_report_excluded(path: symbol)
.decl ppe_Surface(path: symbol, line: number, event0: number, event1: number, event2: number, code: symbol, message: symbol, kind: symbol, name: symbol, depth: number, ordinal: number, witness: number, anchor: node)
Surface(anchor,code,message,kind,name,depth,ordinal,witness,o0,o1,o2) :- ppe_Surface(p,l,o0,o1,o2,code,message,kind,name,depth,ordinal,witness,anchor), pp_api().
Surface(@place(p,l),code,message,kind,name,depth,ordinal,witness,o0,o1,o2) :- ppe_Surface(p,l,o0,o1,o2,code,message,kind,name,depth,ordinal,witness,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
pp_report(p,l,code,message,p,o0,"",o1,o0,o1,o2) :- ppe_Surface(p,l,o0,o1,o2,code,message,kind,name,depth,ordinal,witness,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
.violation ProductionFact(at: span, path: symbol, path_order: symbol, order0: number, order1: number, order2: number, f_kind: symbol, f_line: number, f_symbol: symbol, f_message: symbol) code "DL_FACT" "production fact"
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,kind,l,name,message) :- ppe_Surface(p,l,o0,o1,o2,code,message,kind,name,depth,ordinal,witness,anchor), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).

