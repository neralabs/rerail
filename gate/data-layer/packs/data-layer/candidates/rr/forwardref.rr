// Generated by scripts/generate/packs/data_layer_rr_author.py; do not edit.
.policy "data-layer-forwardref" revision 1
.description "ForwardRef annotations must be guarded before annotation type checks"
.language python
.mode block
.scope include "api/**/*.py", "impl/**/*.py", "public/**/*.py"
.scope exclude "**/.git/**", "**/.venv/**", "**/venv/**", "**/__pycache__/**", "**/tmp/**", "**/test/**", "**/tests/**"
// Source: https://github.com/neralabs/nera-data-layer/blob/2b1504adc4291daaf080b2e932962b134da1a69a/scripts/lint_forwardref.py
#include "python/ast.rr"

.decl fr_trigger(d: number)
fr_trigger(d) :- source(d, sp), text(sp, t), (contains(".annotation", t) ; contains("ForwardRef", t)).
.decl fr_sync(f: node)
fr_sync(f) :- kind(f, "function_definition"), !op(f, "async").
// Sync functions reset and restore this collector's state. Async functions do neither.
.decl fr_in(f: node, n: node)
fr_in(f, n) :- fr_sync(f), within(n, f).
fr_in(f, n) :- fr_sync(f), decorator(f, e), (n = e ; within(n, e)).
.decl fr_outer(f: node, n: node)
fr_outer(f, n) :- fr_in(f, n), fr_in(g, n), fr_in(f, g), f != g.
.decl fr_scope(n: node, f: node)
fr_scope(n, f) :- fr_in(f, n), !fr_outer(f, n).
fr_scope(n, m) :- kind(n, _), docof(n, d), modnode(d, m), !fr_in(_, n).
.decl fr_name(e: node, x: symbol)
fr_name(e, @nfkc(t)) :- unparen(e, n), ast_name(n, t).
.decl fr_attr(e: node, x: symbol)
fr_attr(e, @nfkc(t)) :- unparen(e, n), kind(n, "attribute"), field(n, "attribute", a), text(a, t).
.decl fr_nested_assign(a: node)
fr_nested_assign(a) :- kind(p, "assignment"), field(p, "right", a).
.decl fr_assign(a: node, f: node)
fr_assign(a, f) :- kind(a, "assignment"), !field(a, "type", _), !fr_nested_assign(a),
    field(a, "left", t), fr_name(t, "annotation"), field(a, "right", v), fr_attr(v, "annotation"), fr_scope(a, f).
.decl fr_arg(c: node, i: number, n: node)
fr_arg(c, i, n) :- kind(c, "call"), field(c, "arguments", al), child(al, n, j),
    !kind(n, "keyword_argument"), !kind(n, "dictionary_splat"), !kind(n, "comment"), !kind(n, "line_continuation"),
    i = count : { child(al, a, k), k < j, !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"),
        !kind(a, "comment"), !kind(a, "line_continuation") }.
.decl fr_callable(c: node, name: symbol)
fr_callable(c, name) :- kind(c, "call"), field(c, "function", fn), fr_name(fn, name), fr_arg(c, 0, a), fr_name(a, "annotation").
.decl fr_contains_ref(e: node)
fr_contains_ref(e) :- fr_name(e, "ForwardRef").
fr_contains_ref(e) :- fr_attr(e, "ForwardRef").
fr_contains_ref(e) :- unparen(e, t), kind(t, "tuple"), child(t, child, _), fr_contains_ref(child).
.decl fr_good(c: node)
fr_good(c) :- fr_callable(c, "isinstance"), fr_arg(c, 1, a), fr_contains_ref(a).
.decl fr_candidate(c: node, f: node, which: symbol)
fr_candidate(c, f, "isinstance") :- fr_callable(c, "isinstance"), fr_arg(c, 1, a), fr_name(a, "type"), fr_scope(c, f).
fr_candidate(c, f, "issubclass") :- fr_callable(c, "issubclass"), fr_scope(c, f).
fr_candidate(c, f, "callable") :- fr_callable(c, "callable"), fr_scope(c, f).
.decl fr_newer(c: node, a: node)
fr_newer(c, a) :- fr_candidate(c, f, _), fr_assign(a, f), fr_assign(b, f), earlier(a, b), earlier(b, c).
.decl fr_latest(c: node, a: node)
fr_latest(c, a) :- fr_candidate(c, f, _), fr_assign(a, f), earlier(a, c), !fr_newer(c, a).
.decl fr_checked(c: node)
fr_checked(c) :- fr_latest(c, a), fr_scope(c, f), fr_good(g), fr_scope(g, f), earlier(a, g), earlier(g, c).
.decl fr_bad(c: node, which: symbol, column: number, ordinal: number)
fr_bad(c, which, column, ordinal) :- fr_candidate(c, _, which), fr_latest(c, _), !fr_checked(c),
    docof(c, d), fr_file(d), fr_trigger(d), fr_api_gate(d), !syntax_error(d, _, _), col(c, column), visit_index(c, ordinal).
.decl fr_file(d: number)
fr_file(d) :- fr_scope_path(d,p), suffix(".py",p), !fr_test_path(d), !fr_dot_file(d), !fr_excluded(d), fr_selected(d).
.decl fr_scope_path(d: number,path: symbol)
fr_scope_path(d,p) :- pp_doc(d,name),option_item("logicalPaths",i,name),option_item("scopePaths",i,p).
fr_scope_path(d,p) :- pp_doc(d,p),!option_item("logicalPaths",_,_).
.decl fr_test_path(d: number)
fr_test_path(d) :- fr_scope_path(d,p),(contains("/tests/",cat("/",p));contains("/test/",cat("/",p))).
.decl fr_dot_file(d: number)
fr_dot_file(d) :- pp_api(),fr_scope_path(d,p),(p=".py";suffix("/.py",p)).
.decl fr_selected(d: number)
fr_selected(d) :- pp_doc(d,_), pp_api().
.decl fr_excluded(d: number)
fr_excluded(d) :- pp_doc(d,p), option_item("logicalPaths", i, p), option_item("originalPaths", i, original),
    option_item("excludePatterns", _, pattern), contains(pattern, original).
.decl fr_api_gate(d: number)
fr_api_gate(d) :- pp_doc(d,_), !option("callSource", _).
fr_api_gate(d) :- pp_doc(d,_), option("callSource", t), (contains(".annotation", t) ; contains("ForwardRef", t)).
.violation ForwardRefSourceGate(at: span) code "FWDREF_GATE" "source trigger"
ForwardRefSourceGate(@place("input.py", 1)) :- option("entryPoint", "source_gate"), option("callSource", t),
    (contains(".annotation", t) ; contains("ForwardRef", t)).
.violation ForwardRefFileGate(at: span) code "FWDREF_FILE_GATE" "file scope"
ForwardRefFileGate(@place(p, 1)) :- option("entryPoint", "file_gate"), pp_doc(d,p), fr_file(d).
.violation ForwardRefInstance(at: node, column: number, ordinal: number, collector_order0: number, collector_order1: number, collector_order2: number) code "FWDREF001" "isinstance(annotation, type) without ForwardRef handling. ForwardRef annotations will fail this check. Consider using coerce_sys_id_value() or checking for ForwardRef first."
ppe_ForwardRefInstance(ppe_path,ppe_line,ordinal,0,0,column,ordinal,c) :- fr_bad(c, "isinstance", column, ordinal), docof(c,ppe_doc), pp_doc(ppe_doc,ppe_path), line(c,ppe_line).
.violation ForwardRefSubclass(at: node, column: number, ordinal: number, collector_order0: number, collector_order1: number, collector_order2: number) code "FWDREF002" "issubclass(annotation, ...) without ForwardRef handling. ForwardRef annotations will raise TypeError. Consider checking for ForwardRef first."
ppe_ForwardRefSubclass(ppe_path,ppe_line,ordinal,0,0,column,ordinal,c) :- fr_bad(c, "issubclass", column, ordinal), docof(c,ppe_doc), pp_doc(ppe_doc,ppe_path), line(c,ppe_line).
.violation ForwardRefCallable(at: node, column: number, ordinal: number, collector_order0: number, collector_order1: number, collector_order2: number) code "FWDREF003" "callable(annotation) without ForwardRef handling. ForwardRef is callable but calling it produces wrong results. Consider checking for ForwardRef first."
ppe_ForwardRefCallable(ppe_path,ppe_line,ordinal,0,0,column,ordinal,c) :- fr_bad(c, "callable", column, ordinal), docof(c,ppe_doc), pp_doc(ppe_doc,ppe_path), line(c,ppe_line).

fr_selected(d) :- pp_run(), pp_doc(d,_), pp_fact_present(d).

#include "data-layer/plugin-production.rr"
pp_config("name","forwardref").
pp_config("description","ForwardRef annotations must be guarded before annotation type checks").
pp_config("enforcement","hard-fail").
pp_config("findingSeverity","hard-fail").
pp_config("extractor","forwardref.issues").
pp_config("parser","ast_collect").
pp_config("scope","static").
pp_config("include_tests","false").
pp_config("fact_kind","list").
pp_config("layer_regex","l[\\x{30}-\\x{39}\\x{660}-\\x{669}\\x{6f0}-\\x{6f9}\\x{7c0}-\\x{7c9}\\x{966}-\\x{96f}\\x{9e6}-\\x{9ef}\\x{a66}-\\x{a6f}\\x{ae6}-\\x{aef}\\x{b66}-\\x{b6f}\\x{be6}-\\x{bef}\\x{c66}-\\x{c6f}\\x{ce6}-\\x{cef}\\x{d66}-\\x{d6f}\\x{de6}-\\x{def}\\x{e50}-\\x{e59}\\x{ed0}-\\x{ed9}\\x{f20}-\\x{f29}\\x{1040}-\\x{1049}\\x{1090}-\\x{1099}\\x{17e0}-\\x{17e9}\\x{1810}-\\x{1819}\\x{1946}-\\x{194f}\\x{19d0}-\\x{19d9}\\x{1a80}-\\x{1a89}\\x{1a90}-\\x{1a99}\\x{1b50}-\\x{1b59}\\x{1bb0}-\\x{1bb9}\\x{1c40}-\\x{1c49}\\x{1c50}-\\x{1c59}\\x{a620}-\\x{a629}\\x{a8d0}-\\x{a8d9}\\x{a900}-\\x{a909}\\x{a9d0}-\\x{a9d9}\\x{a9f0}-\\x{a9f9}\\x{aa50}-\\x{aa59}\\x{abf0}-\\x{abf9}\\x{ff10}-\\x{ff19}\\x{104a0}-\\x{104a9}\\x{10d30}-\\x{10d39}\\x{11066}-\\x{1106f}\\x{110f0}-\\x{110f9}\\x{11136}-\\x{1113f}\\x{111d0}-\\x{111d9}\\x{112f0}-\\x{112f9}\\x{11450}-\\x{11459}\\x{114d0}-\\x{114d9}\\x{11650}-\\x{11659}\\x{116c0}-\\x{116c9}\\x{11730}-\\x{11739}\\x{118e0}-\\x{118e9}\\x{11950}-\\x{11959}\\x{11c50}-\\x{11c59}\\x{11d50}-\\x{11d59}\\x{11da0}-\\x{11da9}\\x{11f50}-\\x{11f59}\\x{16a60}-\\x{16a69}\\x{16ac0}-\\x{16ac9}\\x{16b50}-\\x{16b59}\\x{1d7ce}-\\x{1d7ff}\\x{1e140}-\\x{1e149}\\x{1e2f0}-\\x{1e2f9}\\x{1e4f0}-\\x{1e4f9}\\x{1e950}-\\x{1e959}\\x{1fbf0}-\\x{1fbf9}]{4}_.+(?s:.*)").
pp_config("relative_reports","true").
pp_static_root("api").
pp_static_root("impl").
pp_static_root("public").
pp_trigger(".annotation").
pp_trigger("ForwardRef").
.decl pp_fact_allowed(path: symbol)
.decl pp_report_allowed(path: symbol)
pp_fact_allowed(p) :- pp_file(p), !pp_fact_excluded(p).
.decl pp_fact_excluded(path: symbol)
pp_report_allowed(p) :- pp_file(p), !pp_report_excluded(p).
.decl pp_report_excluded(path: symbol)
.decl ppe_ForwardRefInstance(path: symbol, line: number, event0: number, event1: number, event2: number, column: number, ordinal: number, anchor: node)
ForwardRefInstance(anchor,column,ordinal,o0,o1,o2) :- ppe_ForwardRefInstance(p,l,o0,o1,o2,column,ordinal,anchor), pp_api().
ForwardRefInstance(@place(p,l),column,ordinal,o0,o1,o2) :- ppe_ForwardRefInstance(p,l,o0,o1,o2,column,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p), !option("entryPoint","_production_contract").
pp_report(p,l,"FWDREF001","isinstance(annotation, type) without ForwardRef handling. ForwardRef annotations will fail this check. Consider using coerce_sys_id_value() or checking for ForwardRef first.",p,l,"FWDREF001",0,o0,o1,o2) :- ppe_ForwardRefInstance(p,l,o0,o1,o2,column,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
.violation ProductionFact(at: span, path: symbol, path_order: symbol, order0: number, order1: number, order2: number, f_file: symbol, f_line: number, f_col: number, f_message: symbol, f_code: symbol) code "DL_FACT" "production fact"
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,p,l,column,"isinstance(annotation, type) without ForwardRef handling. ForwardRef annotations will fail this check. Consider using coerce_sys_id_value() or checking for ForwardRef first.","FWDREF001") :- ppe_ForwardRefInstance(p,l,o0,o1,o2,column,ordinal,anchor), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).
.decl ppe_ForwardRefSubclass(path: symbol, line: number, event0: number, event1: number, event2: number, column: number, ordinal: number, anchor: node)
ForwardRefSubclass(anchor,column,ordinal,o0,o1,o2) :- ppe_ForwardRefSubclass(p,l,o0,o1,o2,column,ordinal,anchor), pp_api().
ForwardRefSubclass(@place(p,l),column,ordinal,o0,o1,o2) :- ppe_ForwardRefSubclass(p,l,o0,o1,o2,column,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p), !option("entryPoint","_production_contract").
pp_report(p,l,"FWDREF002","issubclass(annotation, ...) without ForwardRef handling. ForwardRef annotations will raise TypeError. Consider checking for ForwardRef first.",p,l,"FWDREF002",0,o0,o1,o2) :- ppe_ForwardRefSubclass(p,l,o0,o1,o2,column,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,p,l,column,"issubclass(annotation, ...) without ForwardRef handling. ForwardRef annotations will raise TypeError. Consider checking for ForwardRef first.","FWDREF002") :- ppe_ForwardRefSubclass(p,l,o0,o1,o2,column,ordinal,anchor), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).
.decl ppe_ForwardRefCallable(path: symbol, line: number, event0: number, event1: number, event2: number, column: number, ordinal: number, anchor: node)
ForwardRefCallable(anchor,column,ordinal,o0,o1,o2) :- ppe_ForwardRefCallable(p,l,o0,o1,o2,column,ordinal,anchor), pp_api().
ForwardRefCallable(@place(p,l),column,ordinal,o0,o1,o2) :- ppe_ForwardRefCallable(p,l,o0,o1,o2,column,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p), !option("entryPoint","_production_contract").
pp_report(p,l,"FWDREF003","callable(annotation) without ForwardRef handling. ForwardRef is callable but calling it produces wrong results. Consider checking for ForwardRef first.",p,l,"FWDREF003",0,o0,o1,o2) :- ppe_ForwardRefCallable(p,l,o0,o1,o2,column,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,p,l,column,"callable(annotation) without ForwardRef handling. ForwardRef is callable but calling it produces wrong results. Consider checking for ForwardRef first.","FWDREF003") :- ppe_ForwardRefCallable(p,l,o0,o1,o2,column,ordinal,anchor), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).

