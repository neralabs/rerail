.policy "data-layer-type-safety-patterns" revision 1
.description "Query and expression APIs avoid unsafe string/generic type patterns"
.language python
.mode block
.scope include "impl/**/*.py", "data_layer/**/*.py", "_internal/**/*.py", "l*/**/*.py"
.scope exclude "**/tests/**", "**/test/**", "**/.git/**", "**/.venv/**", "**/venv/**", "**/__pycache__/**", "**/tmp/**"
