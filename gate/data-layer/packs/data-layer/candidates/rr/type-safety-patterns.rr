0}-\\x{1e149}\\x{1e14e}\\x{1e290}-\\x{1e2ad}\\x{1e2c0}-\\x{1e2eb}\\x{1e2f0}-\\x{1e2f9}\\x{1e4d0}-\\x{1e4eb}\\x{1e4f0}-\\x{1e4f9}\\x{1e7e0}-\\x{1e7e6}\\x{1e7e8}-\\x{1e7eb}\\x{1e7ed}-\\x{1e7ee}\\x{1e7f0}-\\x{1e7fe}\\x{1e800}-\\x{1e8c4}\\x{1e8c7}-\\x{1e8cf}\\x{1e900}-\\x{1e943}\\x{1e94b}\\x{1e950}-\\x{1e959}\\x{1ec71}-\\x{1ecab}\\x{1ecad}-\\x{1ecaf}\\x{1ecb1}-\\x{1ecb4}\\x{1ed01}-\\x{1ed2d}\\x{1ed2f}-\\x{1ed3d}\\x{1ee00}-\\x{1ee03}\\x{1ee05}-\\x{1ee1f}\\x{1ee21}-\\x{1ee22}\\x{1ee24}\\x{1ee27}\\x{1ee29}-\\x{1ee32}\\x{1ee34}-\\x{1ee37}\\x{1ee39}\\x{1ee3b}\\x{1ee42}\\x{1ee47}\\x{1ee49}\\x{1ee4b}\\x{1ee4d}-\\x{1ee4f}\\x{1ee51}-\\x{1ee52}\\x{1ee54}\\x{1ee57}\\x{1ee59}\\x{1ee5b}\\x{1ee5d}\\x{1ee5f}\\x{1ee61}-\\x{1ee62}\\x{1ee64}\\x{1ee67}-\\x{1ee6a}\\x{1ee6c}-\\x{1ee72}\\x{1ee74}-\\x{1ee77}\\x{1ee79}-\\x{1ee7c}\\x{1ee7e}\\x{1ee80}-\\x{1ee89}\\x{1ee8b}-\\x{1ee9b}\\x{1eea1}-\\x{1eea3}\\x{1eea5}-\\x{1eea9}\\x{1eeab}-\\x{1eebb}\\x{1f100}-\\x{1f10c}\\x{1fbf0}-\\x{1fbf9}\\x{20000}-\\x{2a6df}\\x{2a700}-\\x{2b739}\\x{2b740}-\\x{2b81d}\\x{2b820}-\\x{2cea1}\\x{2ceb0}-\\x{2ebe0}\\x{2ebf0}-\\x{2ee5d}\\x{2f800}-\\x{2fa1d}\\x{30000}-\\x{3134a}\\x{31350}-\\x{323af}])|:[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*str[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*\\|)(?s:.*)", t).
tsp_issue(d, l, c, column, 5 + i, suggestion, @replace_all(t, "\\A[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+|[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+\\z", "")) :- tsp_signature_match(f, c, suggestion), tsp_function(f, d, l, _, _), visit_index(f, i), col(f, column), split_line(d, l, t), !tsp_earlier_signature(f, c).

.decl tsp_earlier_signature(f: node, c: symbol)
tsp_earlier_signature(f, c) :- tsp_signature_match(f, c, _), tsp_signature_match(g, c, _),
    docof(f, d), docof(g, d), line(f, l), line(g, l), earlier(g, f).
.violation TypeSafety(at: span, category: symbol, column: number, ordinal: number, suggestion: symbol, snippet: symbol, label: symbol, collector_order0: number, collector_order1: number, collector_order2: number) code "TSP001" "{label}: {suggestion}"
ppe_TypeSafety(p,l,ppe_phase,ppe_a,ppe_b,c,column,ordinal,suggestion,snippet,label) :- tsp_issue(d, l, c, column, ordinal, suggestion, snippet), pp_doc(d,p), tsp_category(c, label), tsp_event_order(d,l,ordinal,ppe_phase,ppe_a,ppe_b).
.violation TspAllowed(at: span) code "TSP_ALLOWED" "allowlisted"
TspAllowed(@place("input.py", 1)) :- option("entryPoint", "is_allowlisted"), option("category", c), tsp_normalized(p), tsp_allowed(c, p).
.decl tsp_normalized(p: symbol)
.decl tsp_relative(p:symbol)
tsp_relative(".") :- option("filePath",p),option("basePath",p).
tsp_relative(@slice(p,strlen(b)+1,strlen(p))) :- option("filePath",p),option("basePath",b),b!=".",b!="/",b!="//",prefix(cat(b,"/"),p).
tsp_relative(@slice(p,1,strlen(p))) :- option("filePath",p),option("basePath","/"),p!="/",prefix("/",p),!prefix("//",p).
tsp_relative(@slice(p,2,strlen(p))) :- option("filePath",p),option("basePath","//"),p!="//",prefix("//",p).
tsp_relative(p) :- option("filePath",p),option("basePath","."),!prefix("/",p).
tsp_normalized(p) :- tsp_relative(p).
tsp_normalized(p) :- option("filePath",p),!tsp_relative(_).
.violation TspNormalized(at: span, result: symbol) code "TSP_NORMALIZED" "relative path"
TspNormalized(@place("input.py", 1), p) :- option("entryPoint", "normalize_path"), tsp_normalized(p).
.violation TspDiscovered(at: span) code "TSP_DISCOVERED" "source file"
TspDiscovered(@place(p, 1)) :- option("entryPoint", "find_python_files"), pp_doc(d,p), tsp_path(d, _, n),
    suffix(".py", n), !prefix("test_", n), !suffix("_test.py", n), !tsp_excluded(d).
.decl tsp_excluded(d: number)
.decl tsp_excluded_part(p: symbol)
tsp_excluded_part("tests"). tsp_excluded_part("test"). tsp_excluded_part("vendor").
tsp_excluded_part("__pycache__"). tsp_excluded_part(".git"). tsp_excluded_part("tmp").
tsp_excluded(d) :- tsp_path(d, path, name), tsp_excluded_part(p), p != name,
    contains(cat("/", p, "/"), cat("/", path, "/")).
.violation TspDedupe(at: span, ordinal: number) code "TSP_DEDUPE" "first issue"
TspDedupe(@place("input.py", 1), i) :- option("entryPoint", "_dedupe_issues"), option_item("issuePaths", i, _), !tsp_duplicate(i).
.decl tsp_duplicate(i: number)
tsp_duplicate(i) :- option_item("issuePaths", i, p), option_item("issueLines", i, l), option_item("issueCategories", i, c),
    option_item("issuePaths", j, p), option_item("issueLines", j, l), option_item("issueCategories", j, c), j < i.

tsp_policy_doc(d) :- pp_run(), pp_doc(d,_), pp_fact_present(d).

#include "data-layer/plugin-production.rr"
pp_config("name","type_safety_patterns").
pp_config("description","Query and expression APIs avoid unsafe string/generic type patterns").
pp_config("enforcement","hard-fail").
pp_config("findingSeverity","hard-fail").
pp_config("extractor","type_safety_patterns.issues").
pp_config("parser","ast_collect").
pp_config("scope","production").
pp_config("include_tests","false").
pp_config("fact_kind","list").
