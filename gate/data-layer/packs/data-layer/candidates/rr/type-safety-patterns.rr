tsp_category("STR_UNION_FIELD", "str | Field pattern").
tsp_category("EXPRESSION_ANY_ANY", "Expression[Any, Any] usage").
tsp_category("DEPRECATED_COMPARISON_OP", "deprecated comparison operator (_lt, _gt, etc)").
tsp_category("DEPRECATED_FILTER_METHOD", "deprecated filter_* method (use Expression syntax)").
