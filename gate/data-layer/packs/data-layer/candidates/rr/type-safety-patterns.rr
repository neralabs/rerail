.decl pp_fact_allowed(path: symbol)
.decl pp_report_allowed(path: symbol)
pp_fact_allowed(p) :- pp_file(p), !pp_fact_excluded(p).
.decl pp_fact_excluded(path: symbol)
pp_report_allowed(p) :- pp_file(p), !pp_report_excluded(p).
.decl pp_report_excluded(path: symbol)
.decl ppe_TypeSafety(path: symbol, line: number, event0: number, event1: number, event2: number, category: symbol, column: number, ordinal: number, suggestion: symbol, snippet: symbol, label: symbol)
TypeSafety(@place(p,l),category,column,ordinal,suggestion,snippet,label,o0,o1,o2) :- ppe_TypeSafety(p,l,o0,o1,o2,category,column,ordinal,suggestion,snippet,label), pp_api().
TypeSafety(@place(p,l),category,column,ordinal,suggestion,snippet,label,o0,o1,o2) :- ppe_TypeSafety(p,l,o0,o1,o2,category,column,ordinal,suggestion,snippet,label), pp_run(), pp_fact_allowed(p), pp_report_allowed(p), !option("entryPoint","_production_contract").
pp_report(p,l,"TSP001",cat(label,": ",suggestion),p,l,cat(label,": ",suggestion),0,o0,o1,o2) :- ppe_TypeSafety(p,l,o0,o1,o2,category,column,ordinal,suggestion,snippet,label), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
.violation ProductionFact(at: span, path: symbol, path_order: symbol, order0: number, order1: number, order2: number, f_category: symbol, f_file_path: symbol, f_line_number: number, f_column: number, f_code_snippet: symbol, f_suggestion: symbol) code "DL_FACT" "production fact"
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,category,full,l,column,snippet,suggestion) :- ppe_TypeSafety(p,l,o0,o1,o2,category,column,ordinal,suggestion,snippet,label), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).

