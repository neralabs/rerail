.decl tsp_source(d: number, t: symbol)
tsp_source(d, t) :- source(d, sp), text(sp, t).
.decl tsp_pattern_trigger(d: number)
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("str", t).
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("Expression", t).
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("Field", t).
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("Any", t).
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("_lt", t).
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("_gt", t).
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("_le", t).
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("_ge", t).
tsp_pattern_trigger(d) :- tsp_source(d, t), contains("filter_", t).
.decl tsp_signature_trigger(d: number)
tsp_signature_trigger(d) :- tsp_source(d, t), contains("def order_by", t).
tsp_signature_trigger(d) :- tsp_source(d, t), contains("def where", t).
tsp_signature_trigger(d) :- tsp_source(d, t), contains("def select", t).
tsp_signature_trigger(d) :- tsp_source(d, t), contains("def group_by", t).
tsp_signature_trigger(d) :- tsp_source(d, t), contains("async def order_by", t).
tsp_signature_trigger(d) :- tsp_source(d, t), contains("async def where", t).
tsp_signature_trigger(d) :- tsp_source(d, t), contains("async def select", t).
tsp_signature_trigger(d) :- tsp_source(d, t), contains("async def group_by", t).

.decl tsp_text_mode(d: number)
tsp_text_mode(d) :- tsp_policy_doc(d), pp_run(), !syntax_error(d, _, _).
tsp_text_mode(d) :- pp_doc(d,_), option("entryPoint", e),
    (e = "check_file_for_patterns" ; e = "check_file_content_for_patterns").
tsp_text_mode(d) :- tsp_fact_file(d), option("entryPoint", "_issues_for_files"), !syntax_error(d, _, _).
.decl tsp_fact_file(d: number)
tsp_fact_file(d) :- tsp_path(d, p, n), suffix(".py", n), n != ".py", !tsp_api_duplicate(d),
    !contains("/tests/", cat("/", p, "/")), !contains("/test/", cat("/", p, "/")).
.decl tsp_api_path(d: number, path: symbol, name: symbol)
tsp_api_path(d, p, n) :- pp_doc(d,buffer), option_item("apiBuffers", i, buffer),
    option_item("apiSourcePaths", i, p), option_item("apiSourceNames", i, n).
.decl tsp_api_duplicate(d: number)
tsp_api_duplicate(d) :- pp_doc(d,buffer),option_item("apiBuffers",i,buffer),option_item("apiSourcePaths",i,p),
    option_item("apiBuffers",j,_),option_item("apiSourcePaths",j,p),j<i.
.decl tsp_path(d: number, path: symbol, name: symbol)
tsp_path(d, p, n) :- tsp_api_path(d, p, n).
tsp_path(d, p, n) :- pp_doc(d,p), file_name(d, n), !tsp_api_path(d, _, _).
.decl tsp_signature_mode(d: number)
tsp_signature_mode(d) :- tsp_policy_doc(d), pp_run().
tsp_signature_mode(d) :- tsp_fact_file(d), option("entryPoint", e),
    (e = "check_function_signatures" ; e = "check_function_signature_content" ; e = "_issues_for_files").
// The content API uses its argument only as a trigger, then the framework reads the file.
.decl tsp_signature_gate(d: number)
tsp_signature_gate(d) :- tsp_signature_trigger(d), !option("callSource", _).
tsp_signature_gate(d) :- option("entryPoint","_issues_for_files"),pp_doc(d,_).
tsp_signature_gate(d) :- tsp_policy_doc(d),pp_run().
tsp_signature_gate(d) :- pp_doc(d,_), option("callSource", t), contains("def order_by", t).
tsp_signature_gate(d) :- pp_doc(d,_), option("callSource", t), contains("def where", t).
tsp_signature_gate(d) :- pp_doc(d,_), option("callSource", t), contains("def select", t).
tsp_signature_gate(d) :- pp_doc(d,_), option("callSource", t), contains("def group_by", t).
