tsp_issue(d, l, "DEPRECATED_FILTER_METHOD", 0, 4, "Use .filter(field(Model.col) > value) or .filter(IN(field(Model.col), values))", @replace_all(t, "\\A[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+|[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+\\z", "")) :- tsp_text_mode(d), tsp_pattern_trigger(d), split_line(d, l, t), tsp_path(d, p, _), !tsp_allowed("DEPRECATED_FILTER_METHOD", p), match("(?s:.*?)(?:\\.filter_(gt|gte|lt|lte|ne|in|eq)[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*\\()(?s:.*)", t).
.violation TspPattern4(at: span) code "TSP_PATTERN" "pattern"
TspPattern4(@place("input.py", 1)) :- option("entryPoint", "pattern_search"), option("patternOrdinal", "4"), option("patternText", t), match("(?s:.*?)(?:\\.filter_(gt|gte|lt|lte|ne|in|eq)[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*\\()(?s:.*)", t).

// The scanner reads splitlines(), rather than the function node's source span.
// Preserve its first-eleven-lines limit and its early textual terminator for order_by.
.decl tsp_function(f: node, d: number, l: number, name: symbol, last: number)
tsp_function(f, d, l, @nfkc(n), last) :- kind(f, "function_definition"), def_name(f, n),
    docof(f, d), line(f, l), tsp_signature_mode(d), tsp_signature_gate(d), !syntax_error(d, _, _),
    last = max e : { within(t, f), !kind(t, "comment"), !child(t, _, _), end_line(t, e) }.
.decl tsp_terminator(f: node, k: number)
tsp_terminator(f, k) :- tsp_function(f, d, l, "order_by", _), split_line(d, k, t), k >= l, k <= l + 10,
    (contains("):", t) ; contains(") ->", t)).
.decl tsp_window(f: node, t: symbol)
tsp_window(f, t) :- tsp_function(f, d, l, name, last), name != "order_by",
    t = join s by k sep "\n" : { split_line(d, k, s), k >= l, k <= last }.
tsp_window(f, t) :- tsp_function(f, d, l, "order_by", _),
    t = join s by k sep "\n" : { split_line(d, k, s), k >= l, k <= l + 10,
        !tsp_after_terminator(f, k) }.
.decl tsp_after_terminator(f: node, k: number)
tsp_after_terminator(f, k) :- tsp_function(f, d, _, "order_by", _), split_line(d, k, _), tsp_terminator(f, k2), k2 < k.
.decl tsp_signature_match(f: node, c: symbol, suggestion: symbol)
