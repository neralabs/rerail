tsp_signature_gate(d) :- pp_doc(d,_), option("callSource", t), contains("async def where", t).
tsp_signature_gate(d) :- pp_doc(d,_), option("callSource", t), contains("async def select", t).
tsp_signature_gate(d) :- pp_doc(d,_), option("callSource", t), contains("async def group_by", t).

