.decl tsp_category(c: symbol, label: symbol)
tsp_category("STR_IN_ORDER_BY", "str in order_by signature").
tsp_category("STR_IN_WHERE", "str in where signature").
tsp_category("STR_IN_SELECT", "str in select signature").
tsp_category("STR_IN_GROUP_BY", "str in group_by signature").
