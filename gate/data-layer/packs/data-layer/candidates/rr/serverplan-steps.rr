.policy "data-layer-serverplan-steps" revision 1
.description "ServerPlan step contracts"
.language python
.mode block
.scope include "**/l2070_server_plan/steps/**/*.py", "**/l7300_sql_versioned_transactions/steps/**/*.py", "**/l9700_sql_graph_query/steps/**/*.py", "**/l2070_batching/post_op.py"
// Source: https://github.com/neralabs/nera-data-layer/blob/2b1504adc4291daaf080b2e932962b134da1a69a/scripts/lint_serverplan_steps.py
#include "python/ast.rr"

.decl ssp_display(path: symbol)
ssp_display(".") :- option("entryPoint","Violation.__str__"), option("argumentPath",path), option("rootPath",path).
ssp_display(@slice(path,strlen(root)+1,strlen(path))) :- option("entryPoint","Violation.__str__"), option("argumentPath",path), option("rootPath",root), prefix(cat(root,"/"),path).
ssp_display(path) :- option("entryPoint","Violation.__str__"), option("argumentPath",path), option("rootPath",root), path != root, !prefix(cat(root,"/"),path).
.violation SSPValue(at: span, value: symbol) code "SSP_VALUE" "{value}"
SSPValue(@place("",0),cat(code,": ",path,":",line,": ",detail)) :- option("entryPoint","Violation.__str__"), ssp_display(path), option("violationCode",code), option("violationLine",line), option("detail",detail).

// Direct API calls use their supplied AST's original source. Production calls
// use the same relations over selected documents, without a Python callback.
.decl ssp_doc(d: number, path: symbol)
ssp_doc(d,path) :- option("entryPoint",_), option_item("inputFiles",_,input), doc(d,input,_), doc_role(d,"primary"), option("argumentPath",path), !syntax_error(d,_,_).
ssp_doc(d,path) :- !option("entryPoint",_), doc(d,path,_), doc_role(d,"primary"), !syntax_error(d,_,_).
.decl ssp_entry(name: symbol)
ssp_entry("check_compile_no_data_branching").
ssp_entry("check_compile_no_object_manipulation").
ssp_entry("check_compile_must_not_raise").
ssp_entry("check_postop_no_resolved_data_manipulation").
ssp_entry("check_can_batch_allowlist").
ssp_entry("check_runtime_state_allowlist").
ssp_entry("check_side_effect_tag_allowlist").
ssp_entry("check_zero_io_l0_execution_role_guardrail").
ssp_entry("check_zero_io_l0_execution_role_enum_semantics").
.decl ssp_run(name: symbol)
ssp_run(name) :- ssp_entry(name), option("entryPoint",name).
ssp_run(name) :- ssp_entry(name), option("entryPoint","_scan_source").
ssp_run(name) :- ssp_entry(name), option("entryPoint","_all_checks").
ssp_run(name) :- ssp_entry(name), !option("entryPoint",_).
.decl ssp_base(n: node, name: symbol)
ssp_base(n,@nfkc(name)) :- kind(n,"identifier"), text(n,name).
ssp_base(n,@nfkc(name)) :- attr_of(n,_,name).
ssp_base(n,name) :- kind(n,"subscript"), field(n,"value",raw), unparen(raw,v), ssp_base(v,name).
ssp_base(n,name) :- kind(n,"generic_type"), child(n,v,0), ssp_base(v,name).
.decl ssp_step(c: node, name: symbol)
ssp_step(c,@nfkc(name)) :- kind(c,"class_definition"), docof(c,d), ssp_doc(d,_), def_name(c,name), field(c,"superclasses",al), child(al,raw,_), !kind(raw,"keyword_argument"), unparen(raw,base), ssp_base(base,"ServerPlanStep").
.decl ssp_body(p: node, n: node, i: number)
ssp_body(p,n,i) :- field(p,"body",b), body_stmt(b,n,i), !kind(n,"decorated_definition"), !kind(n,"expression_statement").
ssp_body(p,n,i) :- field(p,"body",b), body_stmt(b,s,i), kind(s,"expression_statement"), child(s,n,0).
ssp_body(p,n,i) :- field(p,"body",b), body_stmt(b,dd,i), kind(dd,"decorated_definition"), field(dd,"definition",n).
.decl ssp_method(c: node, f: node, name: symbol)
ssp_method(c,f,@nfkc(name)) :- ssp_step(c,_), ssp_body(c,f,_), kind(f,"function_definition"), def_name(f,name).
.decl ssp_first(c: node, f: node, name: symbol)
ssp_first(c,f,name) :- ssp_method(c,f,name), visit_index(f,i), i = min j : { ssp_method(c,g,name), visit_index(g,j) }.
.decl ssp_under(n: node, a: node)
ssp_under(n,n) :- kind(n,_).
ssp_under(n,a) :- ast_parent(n,p), ssp_under(p,a).
.decl ssp_nested(n: node)
ssp_nested(n) :- kind(n,k), (k = "function_definition" ; k = "class_definition" ; k = "lambda").
.decl ssp_walk(f: node, n: node)
ssp_walk(f,n) :- kind(f,"function_definition"), ssp_body(f,n,_), !ssp_nested(n).
ssp_walk(f,n) :- ssp_walk(f,p), ast_parent(n,p), !ssp_nested(n).
.decl ssp_func(c: node, f: node)
ssp_func(c,f) :- kind(c,"call"), field(c,"function",raw), unparen(raw,f).
.decl ssp_call_name(c: node, name: symbol)
ssp_call_name(c,@nfkc(name)) :- ssp_func(c,f), ast_name(f,name).
ssp_call_name(c,@nfkc(name)) :- ssp_func(c,f), attr_of(f,_,name).
.decl ssp_name(n: node, name: symbol)
ssp_name(n,@nfkc(name)) :- ast_name(n,name).
.decl ssp_attr(n: node, object: node, name: symbol)
ssp_attr(n,v,@nfkc(name)) :- attr_of(n,raw,name), unparen(raw,v).
.decl ssp_self_private(n: node, name: symbol)
ssp_self_private(n,name) :- ssp_attr(n,v,name), ssp_name(v,"self"), prefix("_",name).
.decl ssp_ret(r: node, v: node)
ssp_ret(r,v) :- kind(r,"return_statement"), child(r,raw,0), unparen(raw,v).
.decl ssp_pos(c: node, i: number, value: node)
ssp_pos(c,i,v) :- kind(c,"call"), field(c,"arguments",al), child(al,raw,k), !kind(raw,"keyword_argument"), !kind(raw,"dictionary_splat"), !kind(raw,"comment"), unparen(raw,v), i = count : { child(al,other,j), j < k, !kind(other,"keyword_argument"), !kind(other,"dictionary_splat"), !kind(other,"comment") }.
.decl ssp_kw(c: node, name: symbol, value: node)
ssp_kw(c,@nfkc(name),v) :- kind(c,"call"), field(c,"arguments",al), child(al,k,_), kind(k,"keyword_argument"), field(k,"name",nm), text(nm,name), field(k,"value",raw), unparen(raw,v).
.decl ssp_first_kw(c: node, name: symbol, value: node)
ssp_first_kw(c,name,v) :- ssp_kw(c,name,v), visit_index(v,i), i = min j : { ssp_kw(c,name,w), visit_index(w,j) }.
.decl ssp_last_kw(c: node, name: symbol, value: node)
ssp_last_kw(c,name,v) :- ssp_kw(c,name,v), visit_index(v,i), i = max j : { ssp_kw(c,name,w), visit_index(w,j) }.
.decl ssp_true(n: node)
ssp_true(n) :- kind(n,"true").
.decl ssp_false(n: node)
ssp_false(n) :- kind(n,"false").
.decl ssp_none(n: node)
ssp_none(n) :- kind(n,"none").
.decl ssp_level_value(c: node, r: node, value: number)
.decl ssp_zero_integer(n: node)
ssp_zero_integer(n) :- kind(n,"integer"), text(n,raw), match_all("\\A(?:0[0_]*|0[xX][0_]+|0[bB][0_]+|0[oO][0_]+)\\z",raw).
ssp_level_value(c,r,0) :- ssp_method(c,f,"level"), ssp_under(r,f), ssp_ret(r,n), ssp_zero_integer(n).
ssp_level_value(c,r,1) :- ssp_method(c,f,"level"), ssp_under(r,f), ssp_ret(r,n), kind(n,"integer"), !ssp_zero_integer(n), text(n,raw), !suffix("j",raw), !suffix("J",raw).
ssp_level_value(c,r,0) :- ssp_method(c,f,"level"), ssp_under(r,f), ssp_ret(r,n), ssp_false(n).
ssp_level_value(c,r,1) :- ssp_method(c,f,"level"), ssp_under(r,f), ssp_ret(r,n), ssp_true(n).
.decl ssp_level(c: node, value: number)
ssp_level(c,value) :- ssp_level_value(c,r,value), visit_index(r,i), i = min j : { ssp_level_value(c,s,_), visit_index(s,j) }.
.decl ssp_hit(entry: symbol, c: node, f: node, n: node, sub: number, code: symbol, message: symbol)

// STEP-016: only attributes assigned outside __init__ are resolved data.
.decl ssp_resolved(c: node, attr: symbol)
ssp_resolved(c,attr) :- ssp_method(c,f,name), name != "__init__", ssp_under(a,f), assign_target(a,t), ssp_self_private(t,attr).
.decl ssp_alias(f: node, name: symbol, attr: symbol)
ssp_alias(f,name,attr) :- ssp_walk(f,a), kind(a,"assignment"), !field(a,"type",_), assign_value(a,raw), unparen(raw,v), ssp_self_private(v,attr), assign_target(a,t), ssp_name(t,name).
.decl ssp_data_test(c: node, f: node, test: node)
ssp_data_test(c,f,test) :- ssp_method(c,f,"compile"), ssp_walk(f,i), kind(i,"if_statement"), field(i,"condition",test), ssp_under(n,test), ssp_self_private(n,attr), ssp_resolved(c,attr).
ssp_data_test(c,f,test) :- ssp_method(c,f,"compile"), ssp_walk(f,i), kind(i,"if_statement"), field(i,"condition",test), ssp_under(n,test), ssp_name(n,name), ssp_alias(f,name,attr), ssp_resolved(c,attr).
ssp_hit("check_compile_no_data_branching",c,f,i,0,"STEP-016",cat(name,".compile() branches on resolved data — SQL structure must not depend on runtime values")) :- ssp_step(c,name), ssp_data_test(c,f,test), field(i,"condition",test), kind(i,"if_statement").

// STEP-017: nested scopes and their decorators do not belong to compile's body.
.decl ssp_object_method(name: symbol)
ssp_object_method("model_copy"). ssp_object_method("model_dump"). ssp_object_method("model_dump_json"). ssp_object_method("dict"). ssp_object_method("copy"). ssp_object_method("deepcopy").
ssp_hit("check_compile_no_object_manipulation",c,f,n,0,"STEP-017",cat(name,".compile() calls .",method,"() — object manipulation in compile() indicates Python-in-the-loop; use SQL instead")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_walk(f,n), ssp_func(n,func), ssp_attr(func,_,method), ssp_object_method(method).
ssp_hit("check_compile_no_object_manipulation",c,f,n,0,"STEP-017",cat(name,".compile() calls ",method,"() — object manipulation in compile() indicates Python-in-the-loop; use SQL instead")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_walk(f,n), ssp_func(n,func), ssp_name(func,method), ssp_object_method(method).

// STEP-018: the source checks direct statements, including every compile def.
.decl ssp_raise(n: node, name: symbol)
ssp_raise(n,name) :- kind(n,"raise_statement"), child(n,e,0), ssp_name(e,name).
ssp_raise(n,name) :- kind(n,"raise_statement"), child(n,e,0), ssp_func(e,func), ssp_name(func,name).
ssp_hit("check_compile_must_not_raise",c,f,n,0,"STEP-018",cat(name,".compile() raises ",exc," — L0 steps must produce a CompiledStep, not raise")) :- ssp_step(c,name), ssp_level(c,0), ssp_method(c,f,"compile"), ssp_body(f,n,_), ssp_raise(n,exc), (exc = "TypeError" ; exc = "NotImplementedError").

// STEP-019: direct nested callbacks are each walked once. Callbacks under a
// compound statement include its nested definitions, as the source walker does.
.decl ssp_postop(f: node, p: node)
ssp_postop(f,p) :- ssp_method(_,f,"compile"), ssp_body(f,p,_), kind(p,"function_definition"), def_name(p,name), name != "on_commit", name != "on_rollback".
ssp_postop(f,p) :- ssp_method(_,f,"compile"), ssp_body(f,s,_), !kind(s,"function_definition"), ssp_under(p,s), kind(p,"function_definition"), def_name(p,name), name != "on_commit", name != "on_rollback".
// p's identity remains in the order key: an inner callback can be visited by
// multiple enclosing callbacks and those repeated findings are intentional.
.decl ssp_post_hit(c: node, f: node, p: node, n: node, sub: number, message: symbol)
ssp_post_hit(c,f,p,a,k,cat(name,": post_op assigns to '",alias,".",attr,"' (captured from self._) — resolved data must not be mutated in post_op")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_postop(f,p), ssp_under(a,p), kind(a,"assignment"), !field(a,"type",_), assign_target(a,t), ssp_attr(t,recv,attr), ssp_name(recv,alias), ssp_alias(f,alias,_), visit_index(t,k).
ssp_post_hit(c,f,p,n,0,cat(name,": post_op calls .",method,"() on '",alias,"' (captured from self._) — resolved data must not be manipulated in post_op")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_postop(f,p), ssp_under(n,p), ssp_func(n,func), ssp_attr(func,recv,method), (method = "model_copy" ; method = "model_dump" ; method = "model_dump_json" ; method = "__setattr__"), ssp_name(recv,alias), ssp_alias(f,alias,_).
ssp_post_hit(c,f,p,n,1,cat(name,": post_op calls __setattr__ on '",alias,"' (captured from self._) — resolved data must not be mutated in post_op")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_postop(f,p), ssp_under(n,p), ssp_func(n,func), ssp_attr(func,_,"__setattr__"), ssp_pos(n,0,arg), ssp_name(arg,alias), ssp_alias(f,alias,_).

ssp_hit("check_can_batch_allowlist",c,f,f,0,"STEP-020",cat(name,".can_batch() returns False — not in the signed allowlist. All steps must be batchable unless explicitly exempted.")) :- ssp_step(c,name), ssp_method(c,f,"can_batch"), ssp_body(f,r,_), ssp_ret(r,v), ssp_false(v), !option_item("canBatchAllowlist",_,name).
ssp_hit("check_runtime_state_allowlist",c,c,t,0,"STEP-021",cat(name," stores runtime state on 'self.",attr,"' — only signed lifecycle exceptions may retain live txn/conn objects on steps.")) :- ssp_step(c,name), !option_item("runtimeStateAllowlist",_,name), ssp_under(a,c), assign_target(a,t), ssp_attr(t,v,attr), ssp_name(v,"self"), (attr = "txn" ; attr = "_txn" ; attr = "conn" ; attr = "_conn").
.decl ssp_side_effect(c: node)
ssp_side_effect(c) :- ssp_first(c,f,"step_tags"), ssp_under(n,f), str_const(n,"side_effect").
ssp_hit("check_side_effect_tag_allowlist",c,f,f,0,"STEP-022",cat(name,".step_tags() includes 'side_effect' — do not use tags as a scheduling signal; migrate to explicit execution_role() semantics.")) :- ssp_step(c,name), ssp_side_effect(c), ssp_first(c,f,"step_tags"), !option_item("sideEffectAllowlist",_,name).

.decl ssp_empty_collection(n: node)
ssp_empty_collection(n) :- kind(n,k), (k = "list" ; k = "tuple" ; k = "set"), count : { child(n,x,_), !kind(x,"comment") } = 0.
.decl ssp_empty_frozenset(f: node)
ssp_empty_frozenset(f) :- kind(f,"function_definition"), ssp_under(r,f), ssp_ret(r,c), ssp_func(c,func), ssp_name(func,"frozenset"), !ssp_pos(c,_,_), !ssp_kw(c,_,_), field(c,"arguments",al), !child(al,_,_).
ssp_empty_frozenset(f) :- kind(f,"function_definition"), ssp_under(r,f), ssp_ret(r,c), ssp_func(c,func), ssp_name(func,"frozenset"), ssp_pos(c,0,n), ssp_empty_collection(n), !ssp_pos(c,1,_), !ssp_kw(c,_,_), field(c,"arguments",al), count : { child(al,x,_), kind(x,"dictionary_splat") } = 0.
.decl ssp_runtime_hooks(f: node)
ssp_runtime_hooks(f) :- kind(f,"function_definition"), ssp_under(c,f), ssp_func(c,func), ssp_name(func,"CompiledStep"), field(c,"arguments",al), !child(al,_,_).
ssp_runtime_hooks(f) :- kind(f,"function_definition"), ssp_under(c,f), ssp_func(c,func), ssp_name(func,"CompiledStep"), ssp_kw(c,name,v), (name = "pre_op" ; name = "post_op" ; name = "on_commit" ; name = "on_rollback"), !ssp_none(v).
.decl ssp_zero_io(c: node)
ssp_zero_io(c) :- ssp_level(c,0), ssp_first(c,r,"tables_read"), ssp_first(c,w,"tables_written"), ssp_first(c,f,"compile"), ssp_empty_frozenset(r), ssp_empty_frozenset(w), ssp_runtime_hooks(f).
ssp_hit("check_zero_io_l0_execution_role_guardrail",c,c,c,0,"STEP-023",cat(name," is an L0 zero-I/O step without execution_role() — add an explicit execution role that matches the scheduler semantics.")) :- ssp_step(c,name), ssp_zero_io(c), !ssp_first(c,_,"execution_role").
ssp_hit("check_zero_io_l0_execution_role_enum_semantics",c,f,f,0,"STEP-024",cat(name,".execution_role() is annotated as str — annotate it as StepExecutionRole.")) :- ssp_step(c,name), ssp_zero_io(c), ssp_first(c,f,"execution_role"), field(f,"return_type",raw), unparen(raw,ann), (ssp_name(ann,"str") ; str_const(ann,"str") ; kind(ann,"type"), child(ann,inner,0), ssp_name(inner,"str")).
ssp_hit("check_zero_io_l0_execution_role_enum_semantics",c,f,f,1,"STEP-025",cat(name,".execution_role() returns a raw string literal — return a StepExecutionRole enum member.")) :- ssp_step(c,name), ssp_zero_io(c), ssp_first(c,f,"execution_role"), ssp_walk(f,r), ssp_ret(r,v), str_const(v,value), (value = "sql" ; value = "virtual" ; value = "apply" ; value = "control").

.violation SSPRow(at: span, violation_code: symbol, detail: symbol, class_order: number, method_order: number, callback_order: number, node_order: number, suborder: number, entry: symbol) code "SSP_ROW" "{detail}"
SSPRow(@place(path,l),code,message,ci,fi,0,ni,sub,entry) :- ssp_run(entry), ssp_hit(entry,c,f,n,sub,code,message), docof(c,d), ssp_doc(d,path), line(n,l), visit_index(c,ci), visit_index(f,fi), visit_index(n,ni).
SSPRow(@place(path,l),"STEP-019",message,ci,fi,pi,ni,sub,"check_postop_no_resolved_data_manipulation") :- ssp_run("check_postop_no_resolved_data_manipulation"), ssp_post_hit(c,f,p,n,sub,message), docof(c,d), ssp_doc(d,path), line(n,l), visit_index(c,ci), visit_index(f,fi), visit_index(p,pi), visit_index(n,ni).

// Global checks retain the source module's traversal order, independently of
// the class/compile ordering used by the step-specific checks.
.decl ssp_module(d: number, root: node)
ssp_module(d,root) :- ssp_doc(d,_), docof(root,d), kind(root,"module").
.decl ssp_dotted(n: node, name: symbol)
ssp_dotted(n,name) :- ssp_name(n,name).
ssp_dotted(n,cat(parent,".",name)) :- ssp_attr(n,v,name), ssp_dotted(v,parent).
ssp_dotted(n,name) :- ssp_attr(n,v,name), !ssp_name(v,_), !ssp_attr(v,_,_).
.decl ssp_named_call(n: node, name: symbol)
ssp_named_call(n,name) :- ssp_func(n,f), ssp_dotted(f,name).
.decl ssp_compiled(c: node)
ssp_compiled(c) :- ssp_func(c,f), ssp_name(f,"CompiledStep").
.decl ssp_missing_grammar(c: node)
ssp_missing_grammar(c) :- ssp_compiled(c), !ssp_last_kw(c,"grammar",_).
ssp_missing_grammar(c) :- ssp_compiled(c), ssp_last_kw(c,"grammar",v), ssp_none(v).
.decl ssp_nonempty(n: node)
ssp_nonempty(n) :- kind(n,_), !ssp_empty_collection(n), !ssp_none(n), !str_const(n,"").
.decl ssp_closed(v: node)
ssp_closed(v) :- ssp_call_name(v,name), suffix("_post_op",name).
ssp_closed(v) :- ssp_func(v,f), ssp_attr(f,_,name), (name = "materialize" ; name = "assert_result").
.decl ssp_strict(d: number)
ssp_strict(d) :- ssp_module(d,m), body_stmt(m,s,_), child(s,a,0), kind(s,"expression_statement"), kind(a,"assignment"), !field(a,"type",_), assign_target(a,t), ssp_name(t,"CLOSED_POST_OP_STRICT"), assign_value(a,v), ssp_true(v).
.decl ssp_explain(problem: symbol, message: symbol)
ssp_explain(problem,cat(problem,". This is an architectural problem: legacy post-op callbacks may only materialize final results or raise approved exceptions. Redesign the calling code using a closed post-op spec, explicit hydration step, executor-owned effect, or API redesign as appropriate. See docs/design/LEGACY_POSTOP_GUARDRAILS.rst.")) :- ssp_problem(problem).
.decl ssp_problem(problem: symbol)
.decl ssp_extra(entry: symbol, c: node, f: node, event: node, at: node, sub: number, code: symbol, message: symbol)
.decl ssp_problem_hit(entry: symbol, c: node, f: node, event: node, at: node, sub: number, code: symbol, problem: symbol)
ssp_problem(problem) :- ssp_problem_hit(_,_,_,_,_,_,_,problem).
ssp_extra(entry,c,f,event,at,sub,code,message) :- ssp_problem_hit(entry,c,f,event,at,sub,code,problem), ssp_explain(problem,message).
SSPRow(@place(path,l),code,message,ci,fi,0,ni,sub,entry) :- ssp_run(entry), ssp_extra(entry,c,f,event,at,sub,code,message), docof(c,d), ssp_doc(d,path), line(at,l), visit_index(c,ci), visit_index(f,fi), visit_index(event,ni).

ssp_entry("check_misc_runtime_is_deleted").
ssp_entry("check_runtime_builder_names_are_enum_members").
ssp_entry("check_runtime_builder_kind_name_pairs").
ssp_entry("check_closed_post_op_migration_guardrail").
ssp_entry("check_virtual_execute_runtime_scalar_value_guardrail").
ssp_entry("check_virtual_execute_runtime_python_shaping_guardrail").
ssp_entry("check_terminal_projection_string_dispatch_guardrail").
ssp_entry("check_empty_result_assertion_placeholder_guardrail").
ssp_entry("check_sql_visible_steps_declare_cte_type_hints").
ssp_entry("check_cte_type_hints_not_inferred_from_column_names").
ssp_entry("check_result_materialization_spec_no_source_ref_escape_hatch").

ssp_extra("check_misc_runtime_is_deleted",m,m,n,n,0,"STEP-030","RuntimeBuilderKind.MISC_RUNTIME is deleted; use a narrower closed kind") :- ssp_module(d,m), docof(n,d), ssp_attr(n,v,"MISC_RUNTIME"), ssp_dotted(v,"RuntimeBuilderKind").
ssp_extra("check_misc_runtime_is_deleted",m,m,a,a,i,"STEP-030","RuntimeBuilderKind must not define MISC_RUNTIME") :- ssp_module(d,m), docof(a,d), kind(a,"assignment"), !field(a,"type",_), assign_target(a,t), ssp_name(t,"MISC_RUNTIME"), visit_index(t,i).
.decl ssp_builder_name(c: node, n: node)
ssp_builder_name(c,n) :- ssp_call_name(c,"runtime_builder_post_op"), ssp_pos(c,1,n).
ssp_builder_name(c,n) :- ssp_call_name(c,"runtime_builder_post_op"), !ssp_pos(c,1,_), ssp_first_kw(c,"builder_name",n).
ssp_builder_name(c,n) :- ssp_call_name(c,"RuntimeBuilderSpec"), ssp_first_kw(c,"builder_name",n).
ssp_extra("check_runtime_builder_names_are_enum_members",m,m,c,n,0,"STEP-031","runtime builder names must use RuntimeBuilderName enum members, not raw strings") :- ssp_module(d,m), docof(c,d), ssp_builder_name(c,n), str_const(n,_).
// check_runtime_builder_kind_name_pairs is intentionally empty in the pinned
// source: runtime-builder deletion made that validation obsolete.

ssp_problem_hit("check_closed_post_op_migration_guardrail",m,m,c,v,0,"STEP-027","CompiledStep(runtime_ref_ids=...) without SQL grammar is forbidden in closed post-op modules") :- ssp_module(d,m), ssp_strict(d), docof(c,d), ssp_missing_grammar(c), ssp_kw(c,"runtime_ref_ids",v).
ssp_problem_hit("check_closed_post_op_migration_guardrail",m,m,c,v,i+1,"STEP-027","CompiledStep(post_op_with_refs=...) is forbidden in closed post-op modules") :- ssp_module(d,m), ssp_strict(d), docof(c,d), ssp_compiled(c), ssp_kw(c,"post_op_with_refs",v), visit_index(v,i).
ssp_problem_hit("check_closed_post_op_migration_guardrail",m,m,c,v,i+1,"STEP-027","CompiledStep(post_op=...) must be a closed CompiledPostOp factory call") :- ssp_module(d,m), ssp_strict(d), docof(c,d), ssp_compiled(c), ssp_kw(c,"post_op",v), !ssp_closed(v), visit_index(v,i).

.decl ssp_role(c: node, role: symbol)
ssp_role(c,name) :- ssp_first(c,f,"execution_role"), ssp_walk(f,r), ssp_ret(r,v), ssp_attr(v,parent,name), ssp_dotted(parent,"StepExecutionRole").
ssp_role(c,upper) :- ssp_first(c,f,"execution_role"), ssp_walk(f,r), ssp_ret(r,v), str_const(v,name), (name = "virtual", upper = "VIRTUAL" ; name = "sql", upper = "SQL" ; name = "apply", upper = "APPLY" ; name = "control", upper = "CONTROL").
.decl ssp_scalar_value(c: node)
ssp_scalar_value(c) :- ssp_func(c,f), ssp_name(f,"scalar_column_post_op"), ssp_pos(c,0,v), str_const(v,"value").
ssp_scalar_value(c) :- ssp_func(c,f), ssp_name(f,"scalar_column_post_op"), !ssp_pos(c,0,_), ssp_first_kw(c,"column_name",v), str_const(v,"value").
.decl ssp_scalar_compile(f: node)
ssp_scalar_compile(f) :- kind(f,"function_definition"), ssp_under(c,f), ssp_missing_grammar(c), !ssp_last_kw(c,"runtime_ref_ids",_), ssp_last_kw(c,"closed_post_op",v), ssp_scalar_value(v).
ssp_scalar_compile(f) :- kind(f,"function_definition"), ssp_under(c,f), ssp_missing_grammar(c), ssp_last_kw(c,"runtime_ref_ids",r), !ssp_nonempty(r), ssp_last_kw(c,"closed_post_op",v), ssp_scalar_value(v).
ssp_problem_hit("check_virtual_execute_runtime_scalar_value_guardrail",c,f,f,f,0,"STEP-033",cat(name," is a virtual execute_runtime() projection compiled as grammar-less scalar_column_post_op('value'); make the projection SQL-visible or fail closed when the source is not a declared CTE/relation")) :- ssp_step(c,name), ssp_first(c,_,"execute_runtime"), ssp_role(c,"VIRTUAL"), ssp_first(c,f,"compile"), ssp_scalar_compile(f).
ssp_problem_hit("check_virtual_execute_runtime_python_shaping_guardrail",c,e,e,e,0,"STEP-036",cat(name,".execute_runtime() runs after compiling to a grammarless virtual step; publish SQL-visible rows or encode terminal-only behavior as a closed typed materialization contract instead of an executor callback")) :- ssp_step(c,name), ssp_first(c,e,"execute_runtime"), ssp_role(c,"VIRTUAL"), ssp_first(c,f,"compile"), ssp_under(call,f), ssp_missing_grammar(call).

.decl ssp_function(d: number, f: node, name: symbol)
ssp_function(d,f,@nfkc(name)) :- ssp_doc(d,_), docof(f,d), kind(f,"function_definition"), def_name(f,name).
ssp_problem_hit("check_terminal_projection_string_dispatch_guardrail",m,f,n,n,0,"STEP-037","terminal projection must not dispatch on projection_kind strings; replace the registry with typed projection steps or typed projection objects and prove each replacement behaviorally") :- ssp_module(d,m), ssp_doc(d,path), (path = "terminal_projection_builders.py" ; suffix("/terminal_projection_builders.py",path)), ssp_function(d,f,"materialize_terminal_projection"), ssp_under(n,f), kind(n,"comparison_operator"), child(n,raw,_), unparen(raw,v), ssp_dotted(v,"projection_kind").
ssp_problem_hit("check_empty_result_assertion_placeholder_guardrail",m,m,c,c,0,"STEP-038","empty ResultAssertionSpec() is a no-op assertion placeholder; use an explicit scalar/materialization/publication contract with behavioral proof") :- ssp_module(d,m), docof(c,d), ssp_named_call(c,"ResultAssertionSpec"), field(c,"arguments",al), !child(al,_,_).

.decl ssp_doc_expr(n: node)
ssp_doc_expr(n) :- str_const(n,_).
.decl ssp_empty_tuple_method(f: node)
ssp_empty_tuple_method(f) :- kind(f,"function_definition"), count : { ssp_body(f,n,_), !ssp_doc_expr(n) } = 1, ssp_body(f,r,_), ssp_ret(r,v), kind(v,"tuple"), ssp_empty_collection(v).
ssp_extra("check_sql_visible_steps_declare_cte_type_hints",c,f,f,f,0,"STEP-034",cat(name," declares cte_output_columns() but does not declare cte_column_type_hints(); SQL-visible step schemas must expose a complete SqlColumnTypeHints contract.")) :- ssp_step(c,name), ssp_first(c,f,"cte_output_columns"), !ssp_empty_tuple_method(f), !ssp_first(c,_,"cte_column_type_hints").

// Last assignment means last CPython DFS visit, including descendants of nested
// defs: the source skips those def nodes but does not prune their children.
.decl ssp_binding_candidate(f: node, name: symbol, a: node, value: node)
ssp_binding_candidate(f,name,a,v) :- kind(f,"function_definition"), ssp_under(a,f), assign_target(a,t), ssp_name(t,name), assign_value(a,raw), unparen(raw,v).
.decl ssp_binding(f: node, name: symbol, value: node)
ssp_binding(f,name,v) :- ssp_binding_candidate(f,name,a,v), visit_index(a,i), i = max j : { ssp_binding_candidate(f,name,b,_), visit_index(b,j) }.
.decl ssp_derived_columns(f: node, n: node)
ssp_derived_columns(f,n) :- kind(f,"function_definition"), ssp_under(n,f), ssp_named_call(n,name), suffix("cte_output_columns",name).
ssp_derived_columns(f,n) :- kind(f,"function_definition"), ssp_under(n,f), ssp_name(n,name), ssp_binding(f,name,v), ssp_derived_columns(f,v).
ssp_derived_columns(f,n) :- ssp_derived_columns(f,c), ast_parent(c,n), ssp_under(n,f).
.decl ssp_type_hints(c: node)
ssp_type_hints(c) :- ssp_named_call(c,name), (name = "SqlColumnTypeHints" ; suffix(".SqlColumnTypeHints",name)).
.decl ssp_arg(c: node, value: node)
ssp_arg(c,v) :- ssp_pos(c,_,v).
ssp_arg(c,v) :- ssp_kw(c,_,v).
ssp_arg(c,v) :- kind(c,"call"), field(c,"arguments",al), child(al,k,_), kind(k,"dictionary_splat"), child(k,raw,0), unparen(raw,v).
.decl ssp_hint_derived(f: node, c: node)
ssp_hint_derived(f,c) :- ssp_under(c,f), ssp_type_hints(c), ssp_arg(c,v), ssp_derived_columns(f,v).
ssp_problem_hit("check_cte_type_hints_not_inferred_from_column_names",c,f,n,n,0,"STEP-040","SqlColumnTypeHints must be declared from the semantic contract, not inferred from cte_output_columns() or output column names") :- ssp_first(c,f,"cte_column_type_hints"), ssp_hint_derived(f,n).
.decl ssp_computed(n: node)
ssp_computed(n) :- kind(n,k), (k = "list_comprehension" ; k = "set_comprehension" ; k = "dictionary_comprehension" ; k = "generator_expression" ; k = "conditional_expression").
ssp_problem_hit("check_cte_type_hints_not_inferred_from_column_names",c,f,n,n,0,"STEP-040","SqlColumnTypeHints must be explicit; comprehensions and conditional expressions inside type-hint declarations are inference, not a typed contract") :- ssp_first(c,f,"cte_column_type_hints"), ssp_under(n,f), ssp_type_hints(n), !ssp_hint_derived(f,n), ssp_arg(n,v), ssp_under(x,v), ssp_computed(x).

.decl ssp_forbidden(c: node, name: symbol)
ssp_forbidden(c,name) :- ssp_named_call(c,callee), (callee = "ResultMaterializationSpec" ; suffix(".ResultMaterializationSpec",callee)), ssp_kw(c,name,_), (name = "source_refs" ; name = "source_names" ; name = "source_materializer").
ssp_forbidden(c,"source_refs") :- ssp_named_call(c,callee), (callee = "runtime_refs_post_op" ; suffix(".runtime_refs_post_op",callee)), ssp_kw(c,"source_refs",_).
ssp_forbidden(c,"raw_payload_ref_id") :- ssp_named_call(c,callee), (callee = "CompiledStep" ; suffix(".CompiledStep",callee) ; callee = "BatchChildResultSpec" ; suffix(".BatchChildResultSpec",callee)), ssp_kw(c,"raw_payload_ref_id",_).
ssp_problem_hit("check_result_materialization_spec_no_source_ref_escape_hatch",m,m,c,c,0,"STEP-042",cat("post-op materialization must consume raw payload rows only; forbidden runtime-ref data ingress: ",names)) :- ssp_module(d,m), docof(c,d), ssp_forbidden(c,_), names = join name by name sep ", " : { ssp_forbidden(c,name) }.

ssp_entry("check_compile_callbacks_no_runtime_authority").
.decl ssp_authority_type(name: symbol)
ssp_authority_type("ReadTransaction"). ssp_authority_type("WriteTransaction").
ssp_authority_type("SqlConnection"). ssp_authority_type("DatabaseConnection").
ssp_authority_type("SyncSqlConnection"). ssp_authority_type("SyncDatabaseConnection").
.decl ssp_annotation_name(ann: node, name: symbol)
ssp_annotation_name(ann,name) :- ssp_name(n,name), within(n,ann).
ssp_annotation_name(ann,name) :- ssp_attr(n,_,name), within(n,ann).
.decl ssp_authority_annotation(ann: node)
ssp_authority_annotation(ann) :- ssp_annotation_name(ann,name), ssp_authority_type(name).
.decl ssp_authority_return(d: number, name: symbol)
ssp_authority_return(d,@nfkc(name)) :- ssp_doc(d,_), docof(f,d), kind(f,"function_definition"), def_name(f,name), field(f,"return_type",ann), ssp_authority_annotation(ann).
.decl ssp_nested_def(f: node, name: symbol, p: node)
.decl ssp_nested_candidate(f: node, name: symbol, p: node)
ssp_nested_candidate(f,@nfkc(raw),p) :- kind(f,"function_definition"), ssp_under(p,f), p != f, kind(p,"function_definition"), def_name(p,raw).
ssp_nested_def(f,name,p) :- ssp_nested_candidate(f,name,p), visit_index(p,i), i = max j : { ssp_nested_candidate(f,name,q), visit_index(q,j) }.
.decl ssp_callback(f: node, call: node, kw: node, name: symbol, cb: node)
ssp_callback(f,call,v,name,cb) :- ssp_method(_,f,"compile"), ssp_walk(f,call), ssp_compiled(call), ssp_kw(call,name,v), (name = "post_op" ; name = "post_op_with_refs" ; name = "on_commit" ; name = "on_rollback"), ssp_name(v,cbname), ssp_nested_def(f,cbname,cb).
.decl ssp_cb_carrier(cb: node, kind: symbol, name: symbol)
ssp_cb_carrier(cb,kind,name) :- ssp_callback(_,_,_,kind,cb), sig_param(cb,_,nm,_,pk,ann,_), (pk = "posonly" ; pk = "pos"), text(nm,raw), name = @nfkc(raw), ssp_annotation_name(ann,"Hydrator").
.decl ssp_cb_positional(cb: node, nm: node, index: number)
ssp_cb_positional(cb,nm,index) :- ssp_callback(_,_,_,_,cb), sig_param(cb,_,nm,i,pk,_,_), (pk = "posonly" ; pk = "pos"), index = count : { sig_param(cb,_,_,j,other,_,_), (other = "posonly" ; other = "pos"), j < i }.
ssp_cb_carrier(cb,kind,name) :- ssp_callback(_,_,_,kind,cb), (kind = "post_op" ; kind = "post_op_with_refs"), ssp_cb_positional(cb,nm,1), text(nm,raw), name = @nfkc(raw).
.decl ssp_cb_authority(cb: node, name: symbol)
ssp_cb_authority(cb,name) :- ssp_callback(_,_,_,_,cb), sig_param(cb,_,nm,_,pk,ann,_), (pk = "posonly" ; pk = "pos" ; pk = "kwonly"), text(nm,raw), name = @nfkc(raw), ssp_authority_annotation(ann).
.decl ssp_carrier_attr(name: symbol)
ssp_carrier_attr("txn"). ssp_carrier_attr("_txn"). ssp_carrier_attr("conn"). ssp_carrier_attr("_conn").
ssp_carrier_attr("sql_conn"). ssp_carrier_attr("_serverplan_runtime_txn"). ssp_carrier_attr("_serverplan_sql_conn").
.decl ssp_recover(cb: node, kind: symbol, n: node)
ssp_recover(cb,kind,n) :- ssp_walk(cb,n), ssp_attr(n,v,attr), ssp_name(v,name), ssp_cb_carrier(cb,kind,name), ssp_carrier_attr(attr).
ssp_recover(cb,kind,n) :- ssp_walk(cb,n), ssp_func(n,func), ssp_name(func,"getattr"), ssp_pos(n,0,v), ssp_name(v,name), ssp_cb_carrier(cb,kind,name), ssp_pos(n,1,a), str_const(a,attr), ssp_carrier_attr(attr).
.decl ssp_cb_problem(cb: node, kind: symbol, n: node, priority: number, tail: symbol)
ssp_cb_problem(cb,kind,n,0,"recovers runtime txn/conn authority from a runtime carrier — callbacks must stay authority-free.") :- ssp_recover(cb,kind,n).
ssp_cb_problem(cb,kind,n,1,"calls a runtime authority helper — callbacks must not recover live txn/conn objects.") :- ssp_callback(_,_,_,kind,cb), ssp_walk(cb,n), ssp_func(n,func), ssp_name(func,"active_pipeline_txn_for_callbacks").
ssp_cb_problem(cb,kind,n,2,"calls an authority-returning helper — callbacks must not recover live txn/conn objects.") :- ssp_callback(_,_,_,kind,cb), ssp_walk(cb,n), ssp_func(n,func), ssp_name(func,name), docof(cb,d), ssp_authority_return(d,name).
ssp_cb_problem(cb,kind,n,3,"uses runtime txn/conn authority — callbacks must stay authority-free.") :- ssp_callback(_,_,_,kind,cb), ssp_walk(cb,n), kind(n,"call"), ssp_pos(n,_,arg), ssp_name(arg,name), ssp_cb_authority(cb,name).
.decl ssp_cb_first(cb: node, kind: symbol, n: node, priority: number, tail: symbol)
ssp_cb_first(cb,kind,n,priority,tail) :- ssp_cb_problem(cb,kind,n,priority,tail), visit_index(n,i), i = min j : { ssp_cb_problem(cb,kind,m,_,_), visit_index(m,j) }, priority = min p : { ssp_cb_problem(cb,kind,n,p,_) }.
SSPRow(@place(path,l),"STEP-026",cat(cls,".compile() callback '",@nfkc(name),"' ",tail),ci,fi,calli,kwi,0,"check_compile_callbacks_no_runtime_authority") :- ssp_run("check_compile_callbacks_no_runtime_authority"), ssp_step(c,cls), ssp_method(c,f,"compile"), ssp_callback(f,call,kw,kind,cb), ssp_cb_first(cb,kind,n,_,tail), def_name(cb,name), docof(c,d), ssp_doc(d,path), line(n,l), visit_index(c,ci), visit_index(f,fi), visit_index(call,calli), visit_index(kw,kwi).
