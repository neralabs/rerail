.policy "data-layer-serverplan-steps" revision 1
.description "ServerPlan step contracts"
.language python
.mode block
.scope include "impl/common/l2070_server_plan/steps/**/*.py", "impl/common/l7300_sql_versioned_transactions/steps/**/*.py", "impl/common/l9700_sql_graph_query/steps/**/*.py"
.scope exclude "**/tests/**", "**/test/**", "**/__pycache__/**", "**/.git/**", "**/.venv/**", "**/venv/**", "**/tmp/**"
// Source: https://github.com/neralabs/nera-data-layer/blob/2b1504adc4291daaf080b2e932962b134da1a69a/scripts/lint_serverplan_steps.py
#include "python/ast.rr"
#include "data-layer/signing.rr"
#include "data-layer/step-core.rr"
#include "data-layer/step-callables.rr"
#include "data-layer/step-settings.rr"
#include "data-layer/step-production.rr"

// Verification receives whole signature batches and uses the shared signed-message layout.
.decl ssp_verification(i: number, name: symbol, sig: symbol)
ssp_verification(0,"serverplan_steps/0",sig) :- option("entryPoint","_verify_allowlists"), option("signature",sig), !option_item("verificationSignatures",_,_).
ssp_verification(i,cat("serverplan_steps/",to_string(i)),sig) :- option("entryPoint","_verify_allowlists"), option_item("verificationSignatures",i,sig).
multi_sig(name,"serverplan_steps",sig) :- ssp_verification(_,name,sig).
multi_name(name,"can_batch_false") :- ssp_verification(_,name,_).
multi_name(name,"lifecycle_runtime_state") :- ssp_verification(_,name,_).
multi_entry(name,"can_batch_false",value) :- ssp_verification(_,name,_), option_item("canBatchAllowlist",_,value).
multi_entry(name,"lifecycle_runtime_state",value) :- ssp_verification(_,name,_), option_item("runtimeStateAllowlist",_,value).
.decl ssp_verification_stderr(name: symbol, detail: symbol)
ssp_verification_stderr(name,cat("FAIL: WARNING: Allowlists for serverplan_steps are ",label,". Sign with --sign-allowlist.\n")) :- ssp_verification(_,name,sig), multi_status(name,"unsigned"), (sig = "NEEDS_SIGNING", label = "needs signing" ; sig != "NEEDS_SIGNING", label = "unsigned").
ssp_verification_stderr(name,cat("FAIL: Allowlist signature verification failed for serverplan_steps: ",error,"\n")) :- ssp_verification(_,name,sig), multi_status(name,"invalid"), multi_message(name,message), nera_key(key), error = @ed25519_error(key,message,sig).
.violation SSPVerification(at: span, ordinal: number, valid: number, stdout: symbol, stderr: symbol) code "SSP_VERIFY" "{stderr}"
SSPVerification(@place("",0),i,1,"","") :- option("entryPoint","_verify_allowlists"), ssp_verification(i,name,_), multi_status(name,"valid").
SSPVerification(@place("",0),i,0,"",cat("FAIL: WARNING: Allowlists for serverplan_steps are ",label,". Sign with --sign-allowlist.\n")) :- option("entryPoint","_verify_allowlists"), ssp_verification(i,name,sig), multi_status(name,"unsigned"), (sig = "NEEDS_SIGNING", label = "needs signing" ; sig != "NEEDS_SIGNING", label = "unsigned").
SSPVerification(@place("",0),i,0,"",cat("FAIL: Allowlist signature verification failed for serverplan_steps: ",error,"\n")) :- option("entryPoint","_verify_allowlists"), ssp_verification(i,name,sig), multi_status(name,"invalid"), multi_message(name,message), nera_key(key), error = @ed25519_error(key,message,sig).

.decl ssp_display(path: symbol)
ssp_display(".") :- option("entryPoint","Violation.__str__"), option("argumentPath",path), option("rootPath",path).
ssp_display(@slice(path,strlen(root)+1,strlen(path))) :- option("entryPoint","Violation.__str__"), option("argumentPath",path), option("rootPath",root), prefix(cat(root,"/"),path).
ssp_display(path) :- option("entryPoint","Violation.__str__"), option("argumentPath",path), option("rootPath",root), path != root, !prefix(cat(root,"/"),path).
.violation SSPValue(at: span, value: symbol) code "SSP_VALUE" "{value}"
SSPValue(@place("",0),cat(code,": ",path,":",line,": ",detail)) :- option("entryPoint","Violation.__str__"), ssp_display(path), option("violationCode",code), option("violationLine",line), option("detail",detail).

// Direct API calls use their supplied AST's original source. Production calls
// use the same relations over selected documents, without a Python callback.
ssp_doc(d,path) :- option("entryPoint",_), option_item("inputFiles",_,input), doc(d,input,_), doc_role(d,"primary"), option("argumentPath",path), !syntax_error(d,_,_).
ssp_doc(d,path) :- !option("entryPoint",_), ssp_prod_document(d,path), !syntax_error(d,_,_).
ssp_doc(d,path) :- option("entryPoint","_production_facts"), ssp_prod_document(d,path), !syntax_error(d,_,_).
ssp_doc(d,path) :- option("entryPoint","_cli_scan"), option_item("inputFiles",i,input), option_item("cliPaths",i,path), doc(d,input,_), doc_role(d,"primary"), !syntax_error(d,_,_).
.decl ssp_entry(name: symbol)
ssp_entry("check_compile_no_data_branching").
ssp_entry("check_compile_no_object_manipulation").
ssp_entry("check_compile_must_not_raise").
ssp_entry("check_postop_no_resolved_data_manipulation").
ssp_entry("check_can_batch_allowlist").
ssp_entry("check_runtime_state_allowlist").
ssp_entry("check_side_effect_tag_allowlist").
ssp_entry("check_zero_io_l0_execution_role_guardrail").
ssp_entry("check_zero_io_l0_execution_role_enum_semantics").
.decl ssp_run(name: symbol)
ssp_run(name) :- ssp_entry(name), option("entryPoint",name).
ssp_run(name) :- ssp_entry(name), option("entryPoint","_scan_source").
ssp_run(name) :- ssp_entry(name), option("entryPoint","_scan_file").
ssp_run(name) :- ssp_entry(name), option("entryPoint","_cli_scan").
ssp_run(name) :- ssp_entry(name), option("entryPoint","_production_facts").
ssp_run(name) :- ssp_entry(name), option("entryPoint","_all_checks"), !option_item("requestedChecks",_,_).
ssp_run(name) :- ssp_entry(name), option("entryPoint","_all_checks"), option_item("requestedChecks",_,name).
ssp_run(name) :- ssp_entry(name), !option("entryPoint",_).

// Scanner phase order and caller-text gates belong to the native contract.
.decl ssp_order(entry: symbol, ordinal: number)
ssp_order("check_compile_no_data_branching",0).
ssp_order("check_compile_no_object_manipulation",1).
ssp_order("check_compile_must_not_raise",2).
ssp_order("check_postop_no_resolved_data_manipulation",3).
ssp_order("check_can_batch_allowlist",4).
ssp_order("check_runtime_state_allowlist",5).
ssp_order("check_side_effect_tag_allowlist",6).
ssp_order("check_zero_io_l0_execution_role_guardrail",7).
ssp_order("check_zero_io_l0_execution_role_enum_semantics",8).
ssp_order("check_step_role_contract_guardrails",9).
ssp_order("check_compile_callbacks_no_runtime_authority",10).
ssp_order("check_closed_post_op_migration_guardrail",11).
ssp_order("check_runtime_refs_without_sql_grammar_guardrail",12).
ssp_order("check_runtime_ref_closed_post_op_consumption_guardrail",13).
ssp_order("check_helper_anchored_runtime_ref_post_op_guardrail",14).
ssp_order("check_runtime_refs_post_op_requires_runtime_refs_guardrail",15).
ssp_order("check_virtual_execute_runtime_scalar_value_guardrail",16).
ssp_order("check_virtual_execute_runtime_python_shaping_guardrail",17).
ssp_order("check_terminal_projection_string_dispatch_guardrail",18).
ssp_order("check_empty_result_assertion_placeholder_guardrail",19).
ssp_order("check_row_materializer_raw_row_shaping_guardrail",20).
ssp_order("check_literal_payload_materializer_dispatch_guardrail",21).
ssp_order("check_cte_type_hints_not_inferred_from_column_names",22).
ssp_order("check_compiled_result_builders_do_not_fail_closed",23).
ssp_order("check_result_materialization_spec_no_source_ref_escape_hatch",24).
ssp_order("check_closed_post_op_runtime_builder_no_callable_escape_hatches",25).
ssp_order("check_misc_runtime_is_deleted",26).
ssp_order("check_runtime_builder_names_are_enum_members",27).
ssp_order("check_runtime_builder_kind_name_pairs",28).
ssp_order("check_legacy_postop_user_callable_escape_hatches",29).
ssp_order("check_sql_visible_steps_declare_cte_type_hints",30).

.decl ssp_scanning()
ssp_scanning() :- option("entryPoint","_scan_source").
ssp_scanning() :- option("entryPoint","_scan_file").
ssp_scanning() :- option("entryPoint","_cli_scan").
ssp_scanning() :- option("entryPoint","_production_facts").
ssp_scanning() :- !option("entryPoint",_).
.decl ssp_text_gated(entry: symbol)
ssp_text_gated("check_runtime_ref_closed_post_op_consumption_guardrail").
ssp_text_gated("check_helper_anchored_runtime_ref_post_op_guardrail").
ssp_text_gated("check_runtime_refs_post_op_requires_runtime_refs_guardrail").
.decl ssp_gate_text(d: number, value: symbol)
ssp_gate_text(d,value) :- ssp_doc(d,_), option("entryPoint","_scan_source"), option("callSource",value).
ssp_gate_text(d,value) :- ssp_doc(d,_), !option("entryPoint","_scan_source"), source(d,span), text(span,value).
.decl ssp_enabled(entry: symbol, d: number)
ssp_enabled(entry,d) :- ssp_entry(entry), ssp_doc(d,_), !ssp_scanning().
ssp_enabled(entry,d) :- ssp_entry(entry), ssp_doc(d,_), ssp_scanning(), !ssp_text_gated(entry).
ssp_enabled(entry,d) :- ssp_text_gated(entry), entry != "check_runtime_refs_post_op_requires_runtime_refs_guardrail", ssp_scanning(), ssp_gate_text(d,value), contains("closed_post_op",value), contains("runtime_ref",value).
ssp_enabled("check_runtime_refs_post_op_requires_runtime_refs_guardrail",d) :- ssp_scanning(), ssp_gate_text(d,value), contains("runtime_refs_post_op",value).
.violation SSPError(at: span, entry: symbol, detail: symbol) code "SSP_ERROR" "{detail}"
SSPError(@place("",0),"_scan_source","AST tree is required; parsing is owned by the fact framework") :- option("entryPoint","_scan_source"), option("suppliedTree","0").
.decl ssp_needs_key(entry: symbol, c: node)
ssp_needs_key("check_side_effect_tag_allowlist",c) :- ssp_run("check_side_effect_tag_allowlist"), ssp_step(c,_), ssp_first(c,_,"step_tags").
ssp_needs_key("check_zero_io_l0_execution_role_guardrail",c) :- ssp_run("check_zero_io_l0_execution_role_guardrail"), ssp_step(c,_).
.decl ssp_key_error(entry: symbol, path: symbol, detail: symbol)
ssp_key_error(entry,path,cat(@python_repr(path)," is not in the subpath of ",@python_repr(root))) :- ssp_needs_key(entry,c), docof(c,d), ssp_doc(d,path), prefix("/",path), option("rootPath",root), !ssp_relative_path(path,_).
.decl ssp_failed_entry(entry: symbol, path: symbol)
ssp_failed_entry(entry,path) :- ssp_key_error(entry,path,_).
ssp_failed_entry(entry,path) :- ssp_scanning(), ssp_entry(entry), ssp_key_error(_,path,_).
SSPError(@place("",0),entry,detail) :- !ssp_scanning(), ssp_key_error(entry,_,detail).
SSPError(@place("",0),"_scan_source",detail) :- option("entryPoint","_scan_source"), ssp_key_error(_,_,detail).

// Collectors consume only these method bodies. Bind the ancestor before the
// native subtree lookup, instead of constructing every node/ancestor pair.
.decl ssp_self_private(n: node, name: symbol)
ssp_self_private(n,name) :- ssp_attr(n,v,name), ssp_name(v,"self"), prefix("_",name).
.decl ssp_hit(entry: symbol, c: node, f: node, n: node, sub: number, code: symbol, message: symbol)

// STEP-016: only attributes assigned outside __init__ are resolved data.
.decl ssp_resolved(c: node, attr: symbol)
ssp_resolved(c,attr) :- ssp_method(c,f,name), name != "__init__", ssp_under(a,f), assign_target(a,t), ssp_self_private(t,attr).
.decl ssp_alias(f: node, name: symbol, attr: symbol)
ssp_alias(f,name,attr) :- ssp_walk(f,a), kind(a,"assignment"), !field(a,"type",_), assign_value(a,raw), unparen(raw,v), ssp_self_private(v,attr), assign_target(a,t), ssp_name(t,name).
.decl ssp_data_test(c: node, f: node, test: node)
ssp_data_test(c,f,test) :- ssp_method(c,f,"compile"), ssp_walk(f,i), kind(i,"if_statement"), field(i,"condition",test), ssp_under(n,test), ssp_self_private(n,attr), ssp_resolved(c,attr).
ssp_data_test(c,f,test) :- ssp_method(c,f,"compile"), ssp_walk(f,i), kind(i,"if_statement"), field(i,"condition",test), ssp_under(n,test), ssp_name(n,name), ssp_alias(f,name,attr), ssp_resolved(c,attr).
ssp_hit("check_compile_no_data_branching",c,f,i,0,"STEP-016",cat(name,".compile() branches on resolved data — SQL structure must not depend on runtime values")) :- ssp_step(c,name), ssp_data_test(c,f,test), field(i,"condition",test), kind(i,"if_statement").

// STEP-017: nested scopes and their decorators do not belong to compile's body.
.decl ssp_object_method(name: symbol)
ssp_object_method(name) :- ssp_setting_value("OBJECT_MANIPULATION_METHODS",_,name).
ssp_hit("check_compile_no_object_manipulation",c,f,n,0,"STEP-017",cat(name,".compile() calls .",method,"() — object manipulation in compile() indicates Python-in-the-loop; use SQL instead")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_walk(f,n), ssp_func(n,func), ssp_attr(func,_,method), ssp_object_method(method).
ssp_hit("check_compile_no_object_manipulation",c,f,n,0,"STEP-017",cat(name,".compile() calls ",method,"() — object manipulation in compile() indicates Python-in-the-loop; use SQL instead")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_walk(f,n), ssp_func(n,func), ssp_name(func,method), ssp_object_method(method).

// STEP-018: the source checks direct statements, including every compile def.
.decl ssp_raise(n: node, name: symbol)
ssp_raise(n,name) :- kind(n,"raise_statement"), child(n,e,0), ssp_name(e,name).
ssp_raise(n,name) :- kind(n,"raise_statement"), child(n,e,0), ssp_func(e,func), ssp_name(func,name).
ssp_hit("check_compile_must_not_raise",c,f,n,0,"STEP-018",cat(name,".compile() raises ",exc," — L0 steps must produce a CompiledStep, not raise")) :- ssp_step(c,name), ssp_level(c,0), ssp_method(c,f,"compile"), ssp_body(f,n,_), ssp_raise(n,exc), (exc = "TypeError" ; exc = "NotImplementedError").

// STEP-019: direct nested callbacks are each walked once. Callbacks under a
// compound statement include its nested definitions, as the source walker does.
.decl ssp_postop(f: node, p: node)
ssp_postop(f,p) :- ssp_method(_,f,"compile"), ssp_body(f,p,_), kind(p,"function_definition"), def_name(p,name), name != "on_commit", name != "on_rollback".
ssp_postop(f,p) :- ssp_method(_,f,"compile"), ssp_body(f,s,_), !kind(s,"function_definition"), ssp_under(p,s), kind(p,"function_definition"), def_name(p,name), name != "on_commit", name != "on_rollback".
// p's identity remains in the order key: an inner callback can be visited by
// multiple enclosing callbacks and those repeated findings are intentional.
.decl ssp_post_hit(c: node, f: node, p: node, n: node, sub: number, message: symbol)
ssp_post_hit(c,f,p,a,k,cat(name,": post_op assigns to '",alias,".",attr,"' (captured from self._) — resolved data must not be mutated in post_op")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_postop(f,p), ssp_under(a,p), kind(a,"assignment"), !field(a,"type",_), assign_target(a,t), ssp_attr(t,recv,attr), ssp_name(recv,alias), ssp_alias(f,alias,_), visit_index(t,k).
ssp_post_hit(c,f,p,n,0,cat(name,": post_op calls .",method,"() on '",alias,"' (captured from self._) — resolved data must not be manipulated in post_op")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_postop(f,p), ssp_under(n,p), ssp_func(n,func), ssp_attr(func,recv,method), ssp_setting_value("POSTOP_MANIPULATION_METHODS",_,method), ssp_name(recv,alias), ssp_alias(f,alias,_).
ssp_post_hit(c,f,p,n,1,cat(name,": post_op calls __setattr__ on '",alias,"' (captured from self._) — resolved data must not be mutated in post_op")) :- ssp_step(c,name), ssp_method(c,f,"compile"), ssp_postop(f,p), ssp_under(n,p), ssp_func(n,func), ssp_attr(func,_,"__setattr__"), ssp_pos(n,0,arg), ssp_name(arg,alias), ssp_alias(f,alias,_).

ssp_hit("check_can_batch_allowlist",c,f,f,0,"STEP-020",cat(name,".can_batch() returns False — not in the signed allowlist. All steps must be batchable unless explicitly exempted.")) :- ssp_step(c,name), ssp_method(c,f,"can_batch"), ssp_body(f,r,_), ssp_ret(r,v), ssp_false(v), !option_item("canBatchAllowlist",_,name).
ssp_hit("check_runtime_state_allowlist",c,c,t,0,"STEP-021",cat(name," stores runtime state on 'self.",attr,"' — only signed lifecycle exceptions may retain live txn/conn objects on steps.")) :- ssp_step(c,name), !option_item("runtimeStateAllowlist",_,name), ssp_under(a,c), assign_target(a,t), ssp_attr(t,v,attr), ssp_name(v,"self"), ssp_setting_value("RUNTIME_STATE_ATTRS",_,attr).
ssp_hit("check_side_effect_tag_allowlist",c,f,f,0,"STEP-022",cat(name,".step_tags() includes 'side_effect' — do not use tags as a scheduling signal; migrate to explicit execution_role() semantics.")) :- ssp_step(c,name), ssp_tag_candidate(c), ssp_first(c,f,"step_tags").

ssp_hit("check_zero_io_l0_execution_role_guardrail",c,c,c,0,"STEP-023",cat(name," is an L0 zero-I/O step without execution_role() — add an explicit execution role that matches the scheduler semantics.")) :- ssp_step(c,name), ssp_zero_candidate(c).
ssp_hit("check_zero_io_l0_execution_role_enum_semantics",c,f,f,0,"STEP-024",cat(name,".execution_role() is annotated as str — annotate it as StepExecutionRole.")) :- ssp_step(c,name), ssp_zero_io(c), ssp_first(c,f,"execution_role"), field(f,"return_type",raw), unparen(raw,ann), (ssp_name(ann,"str") ; str_const(ann,"str") ; kind(ann,"type"), child(ann,inner,0), ssp_name(inner,"str")).
ssp_hit("check_zero_io_l0_execution_role_enum_semantics",c,f,f,1,"STEP-025",cat(name,".execution_role() returns a raw string literal — return a StepExecutionRole enum member.")) :- ssp_step(c,name), ssp_zero_io(c), ssp_first(c,f,"execution_role"), ssp_walk(f,r), ssp_ret(r,v), str_const(v,value), (value = "sql" ; value = "virtual" ; value = "apply" ; value = "control").

.decl ssp_result(path: symbol, line_number: number, violation_code: symbol, detail: symbol, class_order: number, method_order: number, callback_order: number, node_order: number, suborder: number, entry: symbol, check_order: number)
ssp_result(path,l,code,message,ci,fi,0,ni,sub,entry,checkOrder) :- !ssp_failed_entry(entry,path), !ssp_collecting(_), ssp_order(entry,checkOrder), ssp_enabled(entry,d), ssp_run(entry), ssp_hit(entry,c,f,n,sub,code,message), docof(c,d), ssp_doc(d,path), line(n,l), visit_index(c,ci), visit_index(f,fi), visit_index(n,ni), !ssp_suppressed(entry,c,path).
ssp_result(path,l,"STEP-019",message,ci,fi,pi,ni,sub,"check_postop_no_resolved_data_manipulation",checkOrder) :- !ssp_failed_entry("check_postop_no_resolved_data_manipulation",path), !ssp_collecting(_), ssp_order("check_postop_no_resolved_data_manipulation",checkOrder), ssp_enabled("check_postop_no_resolved_data_manipulation",d), ssp_run("check_postop_no_resolved_data_manipulation"), ssp_post_hit(c,f,p,n,sub,message), docof(c,d), ssp_doc(d,path), line(n,l), visit_index(c,ci), visit_index(f,fi), visit_index(p,pi), visit_index(n,ni).

// Global checks retain the source module's traversal order, independently of
// the class/compile ordering used by the step-specific checks.
.decl ssp_module(d: number, root: node)
ssp_module(d,root) :- ssp_doc(d,_), docof(root,d), kind(root,"module").
.decl ssp_dotted(n: node, name: symbol)
ssp_dotted(n,name) :- ssp_name(n,name).
ssp_dotted(n,cat(parent,".",name)) :- ssp_attr(n,v,name), ssp_dotted(v,parent).
ssp_dotted(n,name) :- ssp_attr(n,v,name), !ssp_name(v,_), !ssp_attr(v,_,_).
.decl ssp_named_call(n: node, name: symbol)
ssp_named_call(n,name) :- ssp_func(n,f), ssp_dotted(f,name).
.decl ssp_missing_grammar(c: node)
ssp_missing_grammar(c) :- ssp_compiled(c), !ssp_last_kw(c,"grammar",_).
ssp_missing_grammar(c) :- ssp_compiled(c), ssp_last_kw(c,"grammar",v), ssp_none(v).
.decl ssp_nonempty(n: node)
ssp_nonempty(n) :- kind(n,_), !ssp_empty_collection(n), !ssp_none(n), !str_const(n,"").
.decl ssp_closed(v: node)
ssp_closed(v) :- ssp_call_name(v,name), suffix("_post_op",name).
ssp_closed(v) :- ssp_func(v,f), ssp_attr(f,_,name), (name = "materialize" ; name = "assert_result").
.decl ssp_strict(d: number)
ssp_strict(d) :- ssp_module(d,m), body_stmt(m,s,_), child(s,a,0), kind(s,"expression_statement"), kind(a,"assignment"), !field(a,"type",_), assign_target(a,t), ssp_name(t,"CLOSED_POST_OP_STRICT"), assign_value(a,v), ssp_true(v).
.decl ssp_explain(problem: symbol, message: symbol)
ssp_explain(problem,cat(problem,". This is an architectural problem: legacy post-op callbacks may only materialize final results or raise approved exceptions. Redesign the calling code using a closed post-op spec, explicit hydration step, executor-owned effect, or API redesign as appropriate. See docs/design/LEGACY_POSTOP_GUARDRAILS.rst.")) :- ssp_problem(problem).
.decl ssp_problem(problem: symbol)
.decl ssp_extra(entry: symbol, c: node, f: node, event: node, at: node, sub: number, code: symbol, message: symbol)
.decl ssp_problem_hit(entry: symbol, c: node, f: node, event: node, at: node, sub: number, code: symbol, problem: symbol)
ssp_problem(problem) :- ssp_problem_hit(_,_,_,_,_,_,_,problem).
ssp_extra(entry,c,f,event,at,sub,code,message) :- ssp_problem_hit(entry,c,f,event,at,sub,code,problem), ssp_explain(problem,message).
ssp_result(path,l,code,message,ci,fi,0,ni,sub,entry,checkOrder) :- !ssp_failed_entry(entry,path), !ssp_collecting(_), ssp_order(entry,checkOrder), ssp_enabled(entry,d), ssp_run(entry), ssp_extra(entry,c,f,event,at,sub,code,message), docof(c,d), ssp_doc(d,path), line(at,l), visit_index(c,ci), visit_index(f,fi), visit_index(event,ni), !ssp_suppressed(entry,c,path).

ssp_entry("check_misc_runtime_is_deleted").
ssp_entry("check_runtime_builder_names_are_enum_members").
ssp_entry("check_runtime_builder_kind_name_pairs").
ssp_entry("check_closed_post_op_migration_guardrail").
ssp_entry("check_virtual_execute_runtime_scalar_value_guardrail").
ssp_entry("check_virtual_execute_runtime_python_shaping_guardrail").
ssp_entry("check_terminal_projection_string_dispatch_guardrail").
ssp_entry("check_empty_result_assertion_placeholder_guardrail").
ssp_entry("check_sql_visible_steps_declare_cte_type_hints").
ssp_entry("check_cte_type_hints_not_inferred_from_column_names").
ssp_entry("check_result_materialization_spec_no_source_ref_escape_hatch").

ssp_extra("check_misc_runtime_is_deleted",m,m,n,n,0,"STEP-030","RuntimeBuilderKind.MISC_RUNTIME is deleted; use a narrower closed kind") :- ssp_module(d,m), docof(n,d), ssp_attr(n,v,"MISC_RUNTIME"), ssp_dotted(v,"RuntimeBuilderKind").
ssp_extra("check_misc_runtime_is_deleted",m,m,a,a,i,"STEP-030","RuntimeBuilderKind must not define MISC_RUNTIME") :- ssp_module(d,m), docof(a,d), kind(a,"assignment"), !field(a,"type",_), assign_target(a,t), ssp_name(t,"MISC_RUNTIME"), visit_index(t,i).
.decl ssp_builder_name(c: node, n: node)
ssp_builder_name(c,n) :- ssp_call_name(c,"runtime_builder_post_op"), ssp_pos(c,1,n).
ssp_builder_name(c,n) :- ssp_call_name(c,"runtime_builder_post_op"), !ssp_pos(c,1,_), ssp_first_kw(c,"builder_name",n).
ssp_builder_name(c,n) :- ssp_call_name(c,"RuntimeBuilderSpec"), ssp_first_kw(c,"builder_name",n).
ssp_extra("check_runtime_builder_names_are_enum_members",m,m,c,n,0,"STEP-031","runtime builder names must use RuntimeBuilderName enum members, not raw strings") :- ssp_module(d,m), docof(c,d), ssp_builder_name(c,n), str_const(n,_).
// check_runtime_builder_kind_name_pairs is intentionally empty in the pinned
// source: runtime-builder deletion made that validation obsolete.

ssp_problem_hit("check_closed_post_op_migration_guardrail",m,m,c,v,0,"STEP-027","CompiledStep(runtime_ref_ids=...) without SQL grammar is forbidden in closed post-op modules") :- ssp_module(d,m), ssp_strict(d), docof(c,d), ssp_missing_grammar(c), ssp_last_kw(c,"runtime_ref_ids",v).
ssp_problem_hit("check_closed_post_op_migration_guardrail",m,m,c,v,i+1,"STEP-027","CompiledStep(post_op_with_refs=...) is forbidden in closed post-op modules") :- ssp_module(d,m), ssp_strict(d), docof(c,d), ssp_compiled(c), ssp_kw(c,"post_op_with_refs",v), visit_index(v,i).
ssp_problem_hit("check_closed_post_op_migration_guardrail",m,m,c,v,i+1,"STEP-027","CompiledStep(post_op=...) must be a closed CompiledPostOp factory call") :- ssp_module(d,m), ssp_strict(d), docof(c,d), ssp_compiled(c), ssp_kw(c,"post_op",v), !ssp_closed(v), visit_index(v,i).

.decl ssp_role(c: node, role: symbol)
ssp_role(c,name) :- ssp_first(c,f,"execution_role"), ssp_walk(f,r), ssp_ret(r,v), ssp_attr(v,parent,name), ssp_dotted(parent,"StepExecutionRole").
ssp_role(c,upper) :- ssp_first(c,f,"execution_role"), ssp_walk(f,r), ssp_ret(r,v), str_const(v,name), (name = "virtual", upper = "VIRTUAL" ; name = "sql", upper = "SQL" ; name = "apply", upper = "APPLY" ; name = "control", upper = "CONTROL").
.decl ssp_scalar_value(c: node)
ssp_scalar_value(c) :- ssp_func(c,f), ssp_name(f,"scalar_column_post_op"), ssp_pos(c,0,v), str_const(v,"value").
ssp_scalar_value(c) :- ssp_func(c,f), ssp_name(f,"scalar_column_post_op"), !ssp_pos(c,0,_), ssp_first_kw(c,"column_name",v), str_const(v,"value").
.decl ssp_scalar_compile(f: node)
ssp_scalar_compile(f) :- kind(f,"function_definition"), ssp_under(c,f), ssp_missing_grammar(c), !ssp_last_kw(c,"runtime_ref_ids",_), ssp_last_kw(c,"closed_post_op",v), ssp_scalar_value(v).
ssp_scalar_compile(f) :- kind(f,"function_definition"), ssp_under(c,f), ssp_missing_grammar(c), ssp_last_kw(c,"runtime_ref_ids",r), !ssp_nonempty(r), ssp_last_kw(c,"closed_post_op",v), ssp_scalar_value(v).
ssp_problem_hit("check_virtual_execute_runtime_scalar_value_guardrail",c,f,f,f,0,"STEP-033",cat(name," is a virtual execute_runtime() projection compiled as grammar-less scalar_column_post_op('value'); make the projection SQL-visible or fail closed when the source is not a declared CTE/relation")) :- ssp_step(c,name), ssp_first(c,_,"execute_runtime"), ssp_role(c,"VIRTUAL"), ssp_first(c,f,"compile"), ssp_scalar_compile(f).
ssp_problem_hit("check_virtual_execute_runtime_python_shaping_guardrail",c,e,e,e,0,"STEP-036",cat(name,".execute_runtime() runs after compiling to a grammarless virtual step; publish SQL-visible rows or encode terminal-only behavior as a closed typed materialization contract instead of an executor callback")) :- ssp_step(c,name), ssp_first(c,e,"execute_runtime"), ssp_role(c,"VIRTUAL"), ssp_first(c,f,"compile"), ssp_under(call,f), ssp_missing_grammar(call).

.decl ssp_function(d: number, f: node, name: symbol)
ssp_function(d,f,@nfkc(name)) :- ssp_doc(d,_), docof(f,d), kind(f,"function_definition"), def_name(f,name).
ssp_problem_hit("check_terminal_projection_string_dispatch_guardrail",m,f,n,n,0,"STEP-037","terminal projection must not dispatch on projection_kind strings; replace the registry with typed projection steps or typed projection objects and prove each replacement behaviorally") :- ssp_module(d,m), ssp_doc(d,path), (path = "terminal_projection_builders.py" ; suffix("/terminal_projection_builders.py",path)), ssp_function(d,f,"materialize_terminal_projection"), ssp_under(n,f), kind(n,"comparison_operator"), child(n,raw,_), unparen(raw,v), ssp_dotted(v,"projection_kind").
ssp_problem_hit("check_empty_result_assertion_placeholder_guardrail",m,m,c,c,0,"STEP-038","empty ResultAssertionSpec() is a no-op assertion placeholder; use an explicit scalar/materialization/publication contract with behavioral proof") :- ssp_module(d,m), docof(c,d), ssp_named_call(c,"ResultAssertionSpec"), field(c,"arguments",al), !child(al,_,_).

.decl ssp_doc_expr(n: node)
ssp_doc_expr(n) :- str_const(n,_).
.decl ssp_empty_tuple_method(f: node)
ssp_empty_tuple_method(f) :- kind(f,"function_definition"), count : { ssp_body(f,n,_), !ssp_doc_expr(n) } = 1, ssp_body(f,r,_), ssp_ret(r,v), kind(v,"tuple"), ssp_empty_collection(v).
ssp_extra("check_sql_visible_steps_declare_cte_type_hints",c,f,f,f,0,"STEP-034",cat(name," declares cte_output_columns() but does not declare cte_column_type_hints(); SQL-visible step schemas must expose a complete SqlColumnTypeHints contract.")) :- ssp_step(c,name), ssp_first(c,f,"cte_output_columns"), !ssp_empty_tuple_method(f), !ssp_first(c,_,"cte_column_type_hints").

// Last assignment means last CPython DFS visit, including descendants of nested
// defs: the source skips those def nodes but does not prune their children.
.decl ssp_binding_candidate(f: node, name: symbol, a: node, value: node)
ssp_binding_candidate(f,name,a,v) :- kind(f,"function_definition"), ssp_under(a,f), assign_target(a,t), ssp_name(t,name), assign_value(a,raw), unparen(raw,v).
.decl ssp_binding(f: node, name: symbol, value: node)
ssp_binding(f,name,v) :- ssp_binding_candidate(f,name,a,v), visit_index(a,i), i = max j : { ssp_binding_candidate(f,name,b,_), visit_index(b,j) }.
.decl ssp_derived_columns(f: node, n: node)
ssp_derived_columns(f,n) :- kind(f,"function_definition"), ssp_under(n,f), ssp_named_call(n,name), suffix("cte_output_columns",name).
ssp_derived_columns(f,n) :- kind(f,"function_definition"), ssp_under(n,f), ssp_name(n,name), ssp_binding(f,name,v), ssp_derived_columns(f,v).
ssp_derived_columns(f,n) :- ssp_derived_columns(f,c), ast_parent(c,n), ssp_under(n,f).
.decl ssp_type_hints(c: node)
ssp_type_hints(c) :- ssp_named_call(c,name), (name = "SqlColumnTypeHints" ; suffix(".SqlColumnTypeHints",name)).
.decl ssp_hint_derived(f: node, c: node)
ssp_hint_derived(f,c) :- ssp_under(c,f), ssp_type_hints(c), ssp_arg(c,v), ssp_derived_columns(f,v).
ssp_problem_hit("check_cte_type_hints_not_inferred_from_column_names",c,f,n,n,0,"STEP-040","SqlColumnTypeHints must be declared from the semantic contract, not inferred from cte_output_columns() or output column names") :- ssp_first(c,f,"cte_column_type_hints"), ssp_hint_derived(f,n).
.decl ssp_computed(n: node)
ssp_computed(n) :- kind(n,k), (k = "list_comprehension" ; k = "set_comprehension" ; k = "dictionary_comprehension" ; k = "generator_expression" ; k = "conditional_expression").
ssp_problem_hit("check_cte_type_hints_not_inferred_from_column_names",c,f,n,n,0,"STEP-040","SqlColumnTypeHints must be explicit; comprehensions and conditional expressions inside type-hint declarations are inference, not a typed contract") :- ssp_first(c,f,"cte_column_type_hints"), ssp_under(n,f), ssp_type_hints(n), !ssp_hint_derived(f,n), ssp_arg(n,v), ssp_under(x,v), ssp_computed(x).

.decl ssp_forbidden(c: node, name: symbol)
ssp_forbidden(c,name) :- ssp_named_call(c,callee), (callee = "ResultMaterializationSpec" ; suffix(".ResultMaterializationSpec",callee)), ssp_kw(c,name,_), (name = "source_refs" ; name = "source_names" ; name = "source_materializer").
ssp_forbidden(c,"source_refs") :- ssp_named_call(c,callee), (callee = "runtime_refs_post_op" ; suffix(".runtime_refs_post_op",callee)), ssp_kw(c,"source_refs",_).
ssp_forbidden(c,"raw_payload_ref_id") :- ssp_named_call(c,callee), (callee = "CompiledStep" ; suffix(".CompiledStep",callee) ; callee = "BatchChildResultSpec" ; suffix(".BatchChildResultSpec",callee)), ssp_kw(c,"raw_payload_ref_id",_).
ssp_problem_hit("check_result_materialization_spec_no_source_ref_escape_hatch",m,m,c,c,0,"STEP-042",cat("post-op materialization must consume raw payload rows only; forbidden runtime-ref data ingress: ",names)) :- ssp_module(d,m), docof(c,d), ssp_forbidden(c,_), names = join name by name sep ", " : { ssp_forbidden(c,name) }.

ssp_entry("check_compile_callbacks_no_runtime_authority").
.decl ssp_authority_type(name: symbol)
ssp_authority_type(name) :- ssp_setting_value("AUTHORITY_TYPE_NAMES",_,name).
.decl ssp_authority_annotation(ann: node)
ssp_authority_annotation(ann) :- ssp_annotation_name(ann,name), ssp_authority_type(name).
.decl ssp_authority_return(d: number, name: symbol)
ssp_authority_return(d,@nfkc(name)) :- ssp_doc(d,_), docof(f,d), kind(f,"function_definition"), def_name(f,name), field(f,"return_type",ann), ssp_authority_annotation(ann).
.decl ssp_nested_def(f: node, name: symbol, p: node)
.decl ssp_nested_candidate(f: node, name: symbol, p: node)
ssp_nested_candidate(f,@nfkc(raw),p) :- kind(f,"function_definition"), ssp_under(p,f), p != f, kind(p,"function_definition"), def_name(p,raw).
ssp_nested_def(f,name,p) :- ssp_nested_candidate(f,name,p), visit_index(p,i), i = max j : { ssp_nested_candidate(f,name,q), visit_index(q,j) }.
.decl ssp_callback(f: node, call: node, kw: node, name: symbol, cb: node)
ssp_callback(f,call,v,name,cb) :- ssp_method(_,f,"compile"), ssp_walk(f,call), ssp_compiled(call), ssp_kw(call,name,v), (name = "post_op" ; name = "post_op_with_refs" ; name = "on_commit" ; name = "on_rollback"), ssp_name(v,cbname), ssp_nested_def(f,cbname,cb).
.decl ssp_cb_carrier(cb: node, kind: symbol, name: symbol)
ssp_cb_carrier(cb,kind,name) :- ssp_callback(_,_,_,kind,cb), sig_param(cb,_,nm,_,pk,ann,_), (pk = "posonly" ; pk = "pos"), text(nm,raw), name = @nfkc(raw), ssp_annotation_name(ann,"Hydrator").
.decl ssp_cb_positional(cb: node, nm: node, index: number)
ssp_cb_positional(cb,nm,index) :- ssp_callback(_,_,_,_,cb), sig_param(cb,_,nm,i,pk,_,_), (pk = "posonly" ; pk = "pos"), index = count : { sig_param(cb,_,_,j,other,_,_), (other = "posonly" ; other = "pos"), j < i }.
ssp_cb_carrier(cb,kind,name) :- ssp_callback(_,_,_,kind,cb), (kind = "post_op" ; kind = "post_op_with_refs"), ssp_cb_positional(cb,nm,1), text(nm,raw), name = @nfkc(raw).
.decl ssp_cb_authority(cb: node, name: symbol)
ssp_cb_authority(cb,name) :- ssp_callback(_,_,_,_,cb), sig_param(cb,_,nm,_,pk,ann,_), (pk = "posonly" ; pk = "pos" ; pk = "kwonly"), text(nm,raw), name = @nfkc(raw), ssp_authority_annotation(ann).
.decl ssp_recover(cb: node, kind: symbol, n: node)
ssp_recover(cb,kind,n) :- ssp_walk(cb,n), ssp_attr(n,v,attr), ssp_name(v,name), ssp_cb_carrier(cb,kind,name), ssp_carrier_attr(attr).
ssp_recover(cb,kind,n) :- ssp_walk(cb,n), ssp_func(n,func), ssp_name(func,"getattr"), ssp_pos(n,0,v), ssp_name(v,name), ssp_cb_carrier(cb,kind,name), ssp_pos(n,1,a), str_const(a,attr), ssp_carrier_attr(attr).
.decl ssp_cb_problem(cb: node, kind: symbol, n: node, priority: number, tail: symbol)
ssp_cb_problem(cb,kind,n,0,"recovers runtime txn/conn authority from a runtime carrier — callbacks must stay authority-free.") :- ssp_recover(cb,kind,n).
ssp_cb_problem(cb,kind,n,1,"calls a runtime authority helper — callbacks must not recover live txn/conn objects.") :- ssp_callback(_,_,_,kind,cb), ssp_walk(cb,n), ssp_func(n,func), ssp_name(func,helper), ssp_setting_value("CALLBACK_RUNTIME_AUTHORITY_HELPERS",_,helper).
ssp_cb_problem(cb,kind,n,2,"calls an authority-returning helper — callbacks must not recover live txn/conn objects.") :- ssp_callback(_,_,_,kind,cb), ssp_walk(cb,n), ssp_func(n,func), ssp_name(func,name), docof(cb,d), ssp_authority_return(d,name).
ssp_cb_problem(cb,kind,n,3,"uses runtime txn/conn authority — callbacks must stay authority-free.") :- ssp_callback(_,_,_,kind,cb), ssp_walk(cb,n), kind(n,"call"), ssp_pos(n,_,arg), ssp_name(arg,name), ssp_cb_authority(cb,name).
.decl ssp_cb_first(cb: node, kind: symbol, n: node, priority: number, tail: symbol)
ssp_cb_first(cb,kind,n,priority,tail) :- ssp_cb_problem(cb,kind,n,priority,tail), visit_index(n,i), i = min j : { ssp_cb_problem(cb,kind,m,_,_), visit_index(m,j) }, priority = min p : { ssp_cb_problem(cb,kind,n,p,_) }.
ssp_result(path,l,"STEP-026",cat(cls,".compile() callback '",@nfkc(name),"' ",tail),ci,fi,calli,kwi,0,"check_compile_callbacks_no_runtime_authority",checkOrder) :- !ssp_failed_entry("check_compile_callbacks_no_runtime_authority",path), !ssp_collecting(_), ssp_order("check_compile_callbacks_no_runtime_authority",checkOrder), ssp_enabled("check_compile_callbacks_no_runtime_authority",d), ssp_run("check_compile_callbacks_no_runtime_authority"), ssp_step(c,cls), ssp_method(c,f,"compile"), ssp_callback(f,call,kw,kind,cb), ssp_cb_first(cb,kind,n,_,tail), def_name(cb,name), docof(c,d), ssp_doc(d,path), line(n,l), visit_index(c,ci), visit_index(f,fi), visit_index(call,calli), visit_index(kw,kwi).

ssp_entry("check_runtime_refs_post_op_requires_runtime_refs_guardrail").
ssp_entry("check_runtime_ref_closed_post_op_consumption_guardrail").
ssp_entry("check_helper_anchored_runtime_ref_post_op_guardrail").
// Global helper summaries have consumers only in these requested checks.
.decl ssp_function_consumer(entry: symbol)
ssp_function_consumer("check_runtime_refs_post_op_requires_runtime_refs_guardrail").
ssp_function_consumer("check_runtime_ref_closed_post_op_consumption_guardrail").
ssp_function_consumer("check_helper_anchored_runtime_ref_post_op_guardrail").
ssp_function_consumer("check_row_materializer_raw_row_shaping_guardrail").
ssp_function_consumer("check_literal_payload_materializer_dispatch_guardrail").
ssp_function_consumer("check_closed_post_op_runtime_builder_no_callable_escape_hatches").
ssp_function_consumer("check_compiled_result_builders_do_not_fail_closed").
ssp_function_consumer("check_legacy_postop_user_callable_escape_hatches").
.decl ssp_need_functions()
ssp_need_functions() :- ssp_function_consumer(entry), ssp_run(entry).
.decl ssp_fn(d: number, f: node)
ssp_fn(d,f) :- ssp_need_functions(), ssp_doc(d,_), docof(f,d), kind(f,"function_definition").
.decl ssp_collection(n: node)
ssp_collection(n) :- kind(n,k), (k = "tuple" ; k = "expression_list" ; k = "list" ; k = "set").
.decl ssp_element(n: node, v: node)
ssp_element(n,v) :- ssp_collection(n), child(n,raw,_), !kind(raw,"comment"), unparen(raw,v).
.decl ssp_dict_value(n: node, v: node)
ssp_dict_value(n,v) :- kind(n,"dictionary"), child(n,p,_), kind(p,"pair"), field(p,"value",raw), unparen(raw,v).
ssp_dict_value(n,v) :- kind(n,"dictionary"), child(n,p,_), kind(p,"dictionary_splat"), child(p,raw,0), unparen(raw,v).
.decl ssp_runtime_ref_call(c: node)
ssp_runtime_ref_call(c) :- ssp_named_call(c,name), (name = "runtime_refs_post_op" ; suffix(".runtime_refs_post_op",name)).
.decl ssp_sets_refs(c: node)
ssp_sets_refs(c) :- kind(c,"call"), ssp_first_kw(c,name,v), (name = "runtime_ref_ids" ; name = "source_refs"), ssp_nonempty(v).

// Boolean expression evaluation follows exactly the supported AST shapes:
// calls' arguments, collection elements, dictionary values, and local names.
// Attribute receivers, dictionary keys, and unsupported expressions stay opaque.
.decl ssp_expr_child(n: node, v: node)
ssp_expr_child(n,v) :- ssp_arg(n,v).
ssp_expr_child(n,v) :- ssp_element(n,v).
ssp_expr_child(n,v) :- ssp_dict_value(n,v).
.decl ssp_eval_edge(f: node, n: node, v: node)
ssp_eval_edge(f,n,v) :- ssp_fn(_,f), ssp_under(n,f), ssp_expr_child(n,v).
ssp_eval_edge(f,n,v) :- ssp_fn(_,f), ssp_under(n,f), ssp_name(n,name), ssp_binding(f,name,v).
.decl ssp_consumes(f: node, n: node)
ssp_consumes(f,n) :- ssp_fn(_,f), ssp_under(n,f), ssp_sets_refs(n).
ssp_consumes(f,n) :- ssp_fn(d,f), ssp_under(n,f), ssp_named_call(n,name), ssp_ref_summary(d,name).
ssp_consumes(f,n) :- ssp_eval_edge(f,n,v), ssp_consumes(f,v).
.decl ssp_ref_summary(d: number, name: symbol)
ssp_ref_summary(d,@nfkc(name)) :- ssp_fn(d,f), def_name(f,name), ssp_walk(f,r), ssp_ret(r,v), ssp_consumes(f,v).

// The source's seen-name set belongs to one expression path. A repeated local
// alias falls back to the function summary of that name. A normal reachability
// closure loses this distinction on cycles. Valid Python identifiers contain no
// slash, so slash-delimited names encode that finite path state unambiguously.
// A finite lower-stratum fuel domain makes the bound explicit to the engine.
// Each appended name is a distinct local binding, so N bindings need at most N
// append steps. This is a derived bound, not a rule limit.
.decl ssp_alias_fuel(f: node, step: number)
ssp_alias_fuel(f,0) :- ssp_fn(_,f).
ssp_alias_fuel(f,rank+1) :- ssp_binding(f,name,_), rank = count : { ssp_binding(f,other,_), other < name }.
.decl ssp_refless_visit(f: node, root: node, n: node, seen: symbol, fuel: number)
ssp_refless_visit(f,v,v,"/",0) :- ssp_fn(_,f), ssp_walk(f,r), ssp_ret(r,v).
ssp_refless_visit(f,root,v,seen,fuel) :- ssp_refless_visit(f,root,n,seen,fuel), !ssp_runtime_ref_call(n), ssp_expr_child(n,v).
ssp_refless_visit(f,root,v,cat(seen,name,"/"),fuel+1) :- ssp_refless_visit(f,root,n,seen,fuel), ssp_alias_fuel(f,fuel), ssp_name(n,name), ssp_binding(f,name,v), !contains(cat("/",name,"/"),seen).
.decl ssp_refless(f: node, root: node)
ssp_refless(f,root) :- ssp_refless_visit(f,root,n,_,_), ssp_runtime_ref_call(n), !ssp_sets_refs(n).
ssp_refless(f,root) :- ssp_fn(d,f), ssp_refless_visit(f,root,n,_,_), ssp_named_call(n,name), !ssp_runtime_ref_call(n), ssp_refless_summary(d,name).
ssp_refless(f,root) :- ssp_fn(d,f), ssp_refless_visit(f,root,n,_,_), ssp_name(n,name), !ssp_binding(f,name,_), ssp_refless_summary(d,name).
ssp_refless(f,root) :- ssp_fn(d,f), ssp_refless_visit(f,root,n,seen,_), ssp_name(n,name), contains(cat("/",name,"/"),seen), ssp_refless_summary(d,name).
.decl ssp_refless_summary(d: number, name: symbol)
ssp_refless_summary(d,@nfkc(name)) :- ssp_fn(d,f), def_name(f,name), ssp_walk(f,r), ssp_ret(r,v), ssp_refless(f,v).

ssp_problem_hit("check_runtime_refs_post_op_requires_runtime_refs_guardrail",m,f,f,f,0,"STEP-034","runtime_refs_post_op must declare non-empty runtime_ref_ids/source_refs; raw-row terminal materialization must use a closed materialization spec, not the runtime-ref helper as a metadata carrier") :- ssp_module(d,m), ssp_fn(d,f), def_name(f,name), ssp_refless_summary(d,@nfkc(name)).
ssp_problem_hit("check_runtime_ref_closed_post_op_consumption_guardrail",m,f,c,v,0,"STEP-033","CompiledStep(runtime_ref_ids=..., closed_post_op=...) uses a closed post-op that still consumes runtime refs; request an explicit SQL-visible transport relation with CtePublicationContract columns, complete SqlColumnTypeHints, and any needed prefixed transport columns, then decode from raw_result") :- ssp_module(d,m), ssp_fn(d,f), ssp_under(c,f), kind(c,"call"), ssp_last_kw(c,"runtime_ref_ids",ref), ssp_nonempty(ref), ssp_last_kw(c,"closed_post_op",v), ssp_consumes(f,v).
.decl ssp_call_label(c: node, name: symbol)
ssp_call_label(c,name) :- ssp_named_call(c,name).
ssp_call_label(c,"<call>") :- kind(c,"call"), !ssp_named_call(c,_).
.decl ssp_declared_runtime_refs(c: node)
ssp_declared_runtime_refs(c) :- ssp_last_kw(c,"runtime_ref_ids",v), ssp_nonempty(v).
ssp_problem_hit("check_helper_anchored_runtime_ref_post_op_guardrail",m,f,c,v,0,"STEP-035",cat(name," carries a runtime-ref-consuming closed_post_op without declaring runtime_ref_ids on the same compiled step; helper CTE anchors must publish SQL-visible transport rows with static columns and SqlColumnTypeHints instead of hiding runtime-ref materialization from the linter")) :- ssp_module(d,m), ssp_fn(d,f), ssp_under(c,f), kind(c,"call"), ssp_last_kw(c,"closed_post_op",v), ssp_consumes(f,v), !ssp_declared_runtime_refs(c), ssp_call_label(c,name).

ssp_entry("check_row_materializer_raw_row_shaping_guardrail").
ssp_entry("check_literal_payload_materializer_dispatch_guardrail").
ssp_entry("check_step_role_contract_guardrails").

// The source class dictionary includes every class, including duplicate names.
.decl ssp_class(d: number, c: node, name: symbol)
ssp_class(d,c,@nfkc(name)) :- ssp_doc(d,_), docof(c,d), kind(c,"class_definition"), def_name(c,name).
.decl ssp_class_method(c: node, f: node, name: symbol)
ssp_class_method(c,f,@nfkc(name)) :- kind(c,"class_definition"), ssp_body(c,f,_), kind(f,"function_definition"), def_name(f,name).
.decl ssp_class_first(c: node, f: node, name: symbol)
ssp_class_first(c,f,name) :- ssp_class_method(c,f,name), visit_index(f,i), i = min j : { ssp_class_method(c,g,name), visit_index(g,j) }.
.decl ssp_raw_parameter(f: node, name: symbol)
ssp_raw_parameter(f,@nfkc(name)) :- ssp_fn(_,f), sig_param(f,_,nm,_,pk,_,_), (pk = "posonly" ; pk = "pos" ; pk = "kwonly"), text(nm,name), (@nfkc(name) = "raw" ; @nfkc(name) = "raw_rows" ; @nfkc(name) = "rows").
ssp_raw_parameter(f,@nfkc(name)) :- ssp_fn(_,f), sig_param(f,_,nm,_,pk,ann,_), (pk = "posonly" ; pk = "pos" ; pk = "kwonly"), text(nm,name), ssp_annotation_name(ann,"RawResult").
ssp_raw_parameter(f,@nfkc(name)) :- ssp_fn(_,f), sig_param(f,_,nm,_,pk,ann,_), (pk = "posonly" ; pk = "pos" ; pk = "kwonly"), text(nm,name), within(n,ann), str_const(n,value), contains("RawResult",value).
ssp_raw_parameter(f,@nfkc(name)) :- ssp_fn(_,f), sig_param(f,_,nm,_,pk,ann,_), (pk = "posonly" ; pk = "pos" ; pk = "kwonly"), text(nm,name), str_part(_,_,value,n,_), within(n,ann), contains("RawResult",value).
.decl ssp_raw_reference(f: node, expression: node)
ssp_raw_reference(f,expression) :- ssp_raw_parameter(f,name), ssp_name(n,name), ssp_under(n,expression).
.decl ssp_raw_shapes(f: node)
// Skipping a nested def node in _walk_nodes does not prune its descendants.
ssp_raw_shapes(f) :- ssp_fn(_,f), ssp_under(n,f), kind(n,"for_statement"), !op(n,"async"), field(n,"right",iter), ssp_raw_reference(f,iter).
ssp_raw_shapes(f) :- ssp_fn(_,f), ssp_under(n,f), kind(n,"for_in_clause"), field(n,"right",iter), ssp_raw_reference(f,iter).
ssp_raw_shapes(f) :- ssp_fn(_,f), ssp_under(n,f), ssp_named_call(n,name), (name = "list" ; name = "tuple" ; name = "dict" ; name = "set" ; name = "sorted"), ssp_pos(n,0,arg), ssp_raw_reference(f,arg).
ssp_raw_shapes(f) :- ssp_fn(d,f), ssp_raw_parameter(f,_), ssp_under(n,f), ssp_named_call(n,name), ssp_raw_summary(d,name).
.decl ssp_raw_summary(d: number, name: symbol)
ssp_raw_summary(d,@nfkc(name)) :- ssp_fn(d,f), def_name(f,name), ssp_raw_shapes(f).
.decl ssp_materializes_rows(f: node)
ssp_materializes_rows(f) :- ssp_raw_shapes(f).
ssp_materializes_rows(f) :- ssp_fn(d,f), ssp_under(n,f), ssp_named_call(n,name), ssp_raw_summary(d,name).
.decl ssp_materializer(expr: node, name: symbol)
ssp_materializer(expr,name) :- ssp_name(expr,name).
ssp_materializer(expr,name) :- ssp_call_name(expr,name).
ssp_problem_hit("check_row_materializer_raw_row_shaping_guardrail",m,m,call,value,ci,"STEP-039","row_materializer performs Python raw-row shaping or delegates to a raw-row shaping helper; SQL-chainable transformations must be represented as SQL-visible relations before terminal materialization, not hidden inside typed materializers") :- ssp_module(d,m), docof(call,d), kind(call,"call"), ssp_first_kw(call,"row_materializer",value), ssp_materializer(value,name), ssp_class(d,c,name), ssp_class_first(c,f,"materialize"), ssp_materializes_rows(f), visit_index(c,ci).

.decl ssp_payload_visit(root: node, value: node)
ssp_payload_visit(root,root) :- ssp_first_kw(call,"literal_payload",root), ssp_named_call(call,name), (name = "ResultMaterializationSpec" ; suffix(".ResultMaterializationSpec",name)).
ssp_payload_visit(root,root) :- !ssp_first_kw(call,"literal_payload",_), ssp_first_kw(call,"terminal_literal",root), ssp_named_call(call,name), (name = "ResultMaterializationSpec" ; suffix(".ResultMaterializationSpec",name)).
ssp_payload_visit(root,value) :- ssp_payload_visit(root,n), ssp_element(n,value).
ssp_payload_visit(root,value) :- ssp_payload_visit(root,n), ssp_pos(n,_,value).
ssp_payload_visit(root,value) :- ssp_payload_visit(root,n), ssp_kw(n,_,value).
.decl ssp_payload_value(root: node, value: node)
ssp_payload_value(root,n) :- ssp_payload_visit(root,n), !ssp_collection(n), !kind(n,"dictionary").
ssp_payload_value(root,value) :- ssp_payload_visit(root,n), ssp_dict_value(n,value).
.decl ssp_payload_root(call: node, root: node)
ssp_payload_root(call,root) :- ssp_first_kw(call,"literal_payload",root).
ssp_payload_root(call,root) :- !ssp_first_kw(call,"literal_payload",_), ssp_first_kw(call,"terminal_literal",root).
.decl ssp_literal_materializer(call: node, value: node, class: node)
ssp_literal_materializer(call,value,c) :- ssp_payload_root(call,root), ssp_named_call(call,name), (name = "ResultMaterializationSpec" ; suffix(".ResultMaterializationSpec",name)), ssp_payload_value(root,value), ssp_materializer(value,cls), docof(call,d), ssp_class(d,c,cls), ssp_class_first(c,f,"materialize"), ssp_materializes_rows(f).
.decl ssp_literal_problem(message: symbol)
ssp_problem("literal_payload embeds a materializer that performs Python raw-row shaping; moving a materializer from row_materializer into a marker payload is still row shaping that belongs in SQL-visible relations or executor result routing").
ssp_literal_problem(message) :- ssp_explain("literal_payload embeds a materializer that performs Python raw-row shaping; moving a materializer from row_materializer into a marker payload is still row shaping that belongs in SQL-visible relations or executor result routing",message).
ssp_result(path,l,"STEP-039",message,mi,calli,vi,ci,0,"check_literal_payload_materializer_dispatch_guardrail",checkOrder) :- !ssp_failed_entry("check_literal_payload_materializer_dispatch_guardrail",path), !ssp_collecting(_), ssp_order("check_literal_payload_materializer_dispatch_guardrail",checkOrder), ssp_enabled("check_literal_payload_materializer_dispatch_guardrail",d), ssp_run("check_literal_payload_materializer_dispatch_guardrail"), ssp_module(d,m), ssp_doc(d,path), docof(call,d), ssp_literal_materializer(call,value,c), ssp_literal_problem(message), line(value,l), visit_index(m,mi), visit_index(call,calli), visit_index(value,vi), visit_index(c,ci).

.decl ssp_bool_method(c: node, f: node, method: symbol, value: number)
ssp_bool_method(c,f,method,1) :- ssp_first(c,f,method), ssp_walk(f,r), ssp_ret(r,v), ssp_true(v).
ssp_bool_method(c,f,method,0) :- ssp_first(c,f,method), ssp_walk(f,r), ssp_ret(r,v), ssp_false(v).
.decl ssp_sql_surface(f: node)
ssp_sql_surface(f) :- kind(f,"function_definition"), ssp_under(call,f), ssp_compiled(call), !ssp_missing_grammar(call).
ssp_sql_surface(f) :- kind(f,"function_definition"), ssp_under(call,f), ssp_compiled(call), ssp_last_kw(call,name,value), (name = "auxiliary_ctes" ; name = "runtime_ref_ids" ; name = "source_refs"), ssp_nonempty(value).
.decl ssp_table_return(f: node, r: node)
ssp_table_return(f,r) :- kind(f,"function_definition"), ssp_walk(f,r), ssp_ret(r,call), ssp_func(call,func), ssp_name(func,"frozenset"), ssp_pos(call,0,arg), !ssp_collection(arg).
ssp_table_return(f,r) :- kind(f,"function_definition"), ssp_walk(f,r), ssp_ret(r,call), ssp_func(call,func), ssp_name(func,"frozenset"), ssp_pos(call,0,arg), ssp_element(arg,value), str_const(value,name), name != "*".
.decl ssp_table_violation(c: node, method: symbol, at: node)
ssp_table_violation(c,method,r) :- ssp_first(c,f,method), (method = "tables_read" ; method = "tables_written"), ssp_table_return(f,r), visit_index(r,i), i = min j : { ssp_table_return(f,other), visit_index(other,j) }.
ssp_table_violation(c,method,f) :- ssp_first(c,f,method), (method = "tables_read" ; method = "tables_written"), !ssp_table_return(f,_), !ssp_empty_frozenset(f).
.decl ssp_preferred_table(c: node, method: symbol, at: node)
ssp_preferred_table(c,"tables_read",at) :- ssp_table_violation(c,"tables_read",at).
ssp_preferred_table(c,"tables_written",at) :- !ssp_table_violation(c,"tables_read",_), ssp_table_violation(c,"tables_written",at).
.decl ssp_sqlish_tag(c: node, tag: symbol)
ssp_sqlish_tag(c,tag) :- ssp_first(c,f,"step_tags"), ssp_under(n,f), str_const(n,tag), (tag = "__exists" ; tag = "delete" ; tag = "grammar" ; tag = "insert" ; tag = "query" ; tag = "read" ; tag = "update" ; tag = "validation").
ssp_extra("check_step_role_contract_guardrails",c,c,c,at,0,"STEP-045",cat(name,".execution_role() returns VIRTUAL but ",method,"() can report concrete DB tables.")) :- ssp_step(c,name), ssp_role(c,"VIRTUAL"), ssp_preferred_table(c,method,at).
ssp_extra("check_step_role_contract_guardrails",c,c,c,f,1,"STEP-046",cat(name,".execution_role() returns VIRTUAL but compile() declares SQL grammar, auxiliary CTEs, or runtime/source refs.")) :- ssp_step(c,name), ssp_role(c,"VIRTUAL"), ssp_first(c,f,"compile"), ssp_sql_surface(f).
ssp_extra("check_step_role_contract_guardrails",c,c,c,c,2,"STEP-046",cat(name,".execution_role() returns VIRTUAL but declares a SQL-visible publication contract.")) :- ssp_step(c,name), ssp_role(c,"VIRTUAL"), (ssp_first(c,_,"cte_publication_contract") ; ssp_first(c,_,"publication_contract")).
ssp_extra("check_step_role_contract_guardrails",c,c,c,c,3,"STEP-047",cat(name,".execution_role() returns VIRTUAL but exposes runtime execution authority.")) :- ssp_step(c,name), ssp_role(c,"VIRTUAL"), (ssp_first(c,_,"execute_runtime") ; ssp_first(c,_,"execute_runtime_async") ; ssp_bool_method(c,_,"is_executor_owned_runtime_step",1)).
ssp_extra("check_step_role_contract_guardrails",c,c,c,f,4,"STEP-048",cat(name,".execution_role() returns VIRTUAL but step_tags() contains SQL-ish tags [",tags,"].")) :- ssp_step(c,name), ssp_role(c,"VIRTUAL"), ssp_first(c,f,"step_tags"), ssp_sqlish_tag(c,_), tags = join quoted by tag sep ", " : { ssp_sqlish_tag(c,tag), quoted = @python_repr(tag) }.
ssp_extra("check_step_role_contract_guardrails",c,c,c,f,5,"STEP-049",cat(name,".supports_sql_batch_transport() returns True without SQL role or a SQL/assertion publication surface.")) :- ssp_step(c,name), !ssp_role(c,"SQL"), ssp_bool_method(c,f,"supports_sql_batch_transport",1), !ssp_first(c,_,"cte_publication_contract"), count : { ssp_first(c,compile,"compile"), ssp_sql_surface(compile) } = 0.
ssp_extra("check_step_role_contract_guardrails",c,c,c,f,6,"STEP-050",cat(name,".compile() declares SQL but emits_sql_for_accounting() returns False.")) :- ssp_step(c,name), ssp_first(c,compile,"compile"), ssp_sql_surface(compile), ssp_bool_method(c,f,"emits_sql_for_accounting",0).

ssp_entry("check_closed_post_op_runtime_builder_no_callable_escape_hatches").
ssp_entry("check_runtime_refs_without_sql_grammar_guardrail").
ssp_entry("check_compiled_result_builders_do_not_fail_closed").
ssp_entry("check_legacy_postop_user_callable_escape_hatches").

.decl ssp_builder_token(s: symbol)
ssp_builder_token("callback"). ssp_builder_token("callable"). ssp_builder_token("closure").
ssp_builder_token("function"). ssp_builder_token("lambda"). ssp_builder_token("partial").
.decl ssp_indirect_token(s: symbol)
ssp_indirect_token("callback_id"). ssp_indirect_token("callable_id"). ssp_indirect_token("effect_id").
ssp_indirect_token("function_id"). ssp_indirect_token("hook_id"). ssp_indirect_token("processor_id").
ssp_indirect_token("registry_id"). ssp_indirect_token("transform_id").
.decl ssp_builder_escape(s: symbol)
ssp_builder_escape(s) :- ssp_builder_token(t), (ssp_dotted(_,s) ; str_const(_,s) ; ssp_name(_,s) ; ssp_kw(_,s,_)), contains(t,@lower(s)).
.decl ssp_kw_escape(s: symbol)
ssp_kw_escape(s) :- ssp_kw(_,s,_), (ssp_user_token(t) ; ssp_builder_token(t) ; ssp_indirect_token(t)), contains(t,@lower(s)).
.decl ssp_callable_binding(d: number, name: symbol)
ssp_callable_binding(d,@nfkc(name)) :- ssp_fn(d,f), def_name(f,name).
ssp_callable_binding(d,name) :- docof(a,d), assign_target(a,t), ssp_name(t,name), assign_value(a,raw), unparen(raw,v), kind(v,"lambda").
.decl ssp_direct_callable(n: node)
ssp_direct_callable(n) :- kind(n,"lambda").
ssp_direct_callable(n) :- ssp_name(n,name), docof(n,d), ssp_callable_binding(d,name).
ssp_direct_callable(n) :- ssp_named_call(n,name), (name = "partial" ; name = "functools.partial").
ssp_direct_callable(n) :- ssp_expr_child(n,v), ssp_direct_callable(v).
.decl ssp_mutable(n: node)
ssp_mutable(n) :- kind(n,k), (k = "list" ; k = "dictionary" ; k = "set" ; k = "list_comprehension" ; k = "dictionary_comprehension" ; k = "set_comprehension").
ssp_mutable(n) :- kind(n,k), (k = "tuple" ; k = "expression_list"), ssp_element(n,v), ssp_mutable(v).
.decl ssp_builder_call(c: node)
ssp_builder_call(c) :- ssp_call_name(c,name), (name = "runtime_builder_post_op" ; name = "runtime_op_post_op" ; name = "RuntimeBuilderSpec").
.decl ssp_builder_kind(c: node, value: node)
ssp_builder_kind(c,v) :- ssp_call_name(c,"runtime_builder_post_op"), ssp_pos(c,0,v).
ssp_builder_kind(c,v) :- ssp_call_name(c,"runtime_builder_post_op"), !ssp_pos(c,0,_), ssp_first_kw(c,"kind",v).
ssp_builder_kind(c,v) :- ssp_call_name(c,"RuntimeBuilderSpec"), ssp_first_kw(c,"kind",v).
.decl ssp_runtime_builder_name(c: node, value: node)
ssp_runtime_builder_name(c,v) :- ssp_builder_name(c,v).
ssp_runtime_builder_name(c,v) :- ssp_call_name(c,"runtime_op_post_op"), ssp_pos(c,0,v).
ssp_runtime_builder_name(c,v) :- ssp_call_name(c,"runtime_op_post_op"), !ssp_pos(c,0,_), ssp_first_kw(c,"op",v).
.decl ssp_kw_ordinal(c: node, name: symbol, value: node, ordinal: number)
ssp_kw_ordinal(c,name,v,rank) :- ssp_kw(c,name,v), visit_index(v,i), rank = count : { ssp_kw(c,_,other), visit_index(other,j), j < i }.
.decl ssp_kw_count(c: node, count: number)
ssp_kw_count(c,count) :- ssp_builder_call(c), count = count : { ssp_kw(c,_,_) }.
.decl ssp_literal_kwargs(c: node, value: node)
ssp_literal_kwargs(c,v) :- ssp_call_name(c,"RuntimeBuilderSpec"), ssp_first_kw(c,"literal_kwargs",v).
.decl ssp_literal_pair(n: node, key: node, value: node)
ssp_literal_pair(n,k,v) :- kind(n,t), (t = "tuple" ; t = "expression_list" ; t = "list"), ssp_element(n,p), kind(p,pt), (pt = "tuple" ; pt = "expression_list" ; pt = "list"), count : { ssp_element(p,_) } = 2, ssp_element(p,k), ssp_element(p,v), visit_index(k,ki), visit_index(v,vi), ki < vi.
ssp_literal_pair(n,k,v) :- kind(n,"dictionary"), child(n,p,_), kind(p,"pair"), field(p,"key",rk), unparen(rk,k), field(p,"value",rv), unparen(rv,v).
.decl ssp_literal_escape(n: node)
ssp_literal_escape(n) :- ssp_user_shape(n).
ssp_literal_escape(n) :- ssp_literal_pair(n,k,_), str_const(k,key), (ssp_builder_escape(key) ; @lower(key) = "builder").
ssp_literal_escape(n) :- ssp_literal_pair(n,_,v), ssp_user_shape(v).
ssp_literal_escape(n) :- kind(n,"dictionary"), ssp_dict_value(n,v), ssp_user_shape(v).
.decl ssp_kw_reason(c: node, value: node, priority: number, message: symbol)
ssp_kw_reason(c,v,0,"runtime_builder_post_op literal kwargs must not carry opaque behavior carriers") :- ssp_builder_call(c), ssp_kw(c,name,v), @lower(name) = "builder".
ssp_kw_reason(c,v,1,"runtime_builder_post_op literal kwargs must not carry callback-shaped fields") :- ssp_builder_call(c), ssp_kw(c,name,v), ssp_kw_escape(name).
ssp_kw_reason(c,v,2,"runtime_builder_post_op literal kwargs must not carry callable-shaped values") :- ssp_builder_call(c), ssp_kw(c,_,v), ssp_user_shape(v).
ssp_kw_reason(c,v,3,"runtime_builder_post_op literal kwargs must not carry function or lambda values") :- ssp_builder_call(c), ssp_kw(c,_,v), ssp_direct_callable(v).
ssp_kw_reason(c,v,4,"runtime_builder_post_op literal kwargs must not carry mutable literal values") :- ssp_builder_call(c), ssp_kw(c,name,v), name != "literal_kwargs", ssp_mutable(v).

ssp_extra("check_closed_post_op_runtime_builder_no_callable_escape_hatches",m,m,a,a,ti,"STEP-029","runtime-builder code must not keep module-level callable/effect registries") :- ssp_module(d,m), docof(a,d), assign_target(a,t), ssp_dotted(t,name), contains("runtime",@lower(name)), (contains("callback",@lower(name)) ; contains("callable",@lower(name)) ; contains("effect",@lower(name)) ; contains("function",@lower(name)) ; contains("hook",@lower(name))), visit_index(t,ti).
.decl ssp_kind_item(c: node, item: node)
ssp_kind_item(c,item) :- kind(c,"class_definition"), def_name(c,name), @nfkc(name) = "RuntimeBuilderKind", ssp_body(c,item,_), assign_target(item,t), visit_index(t,i), i = min j : { assign_target(item,other), visit_index(other,j) }, ssp_name(t,target), ssp_builder_escape(target).
ssp_kind_item(c,item) :- kind(c,"class_definition"), def_name(c,name), @nfkc(name) = "RuntimeBuilderKind", ssp_body(c,item,_), assign_value(item,v), str_const(v,value), ssp_builder_escape(value).
ssp_extra("check_closed_post_op_runtime_builder_no_callable_escape_hatches",m,m,c,item,i,"STEP-029","RuntimeBuilderKind must not define generic callback/callable escape hatches") :- ssp_module(d,m), docof(c,d), ssp_kind_item(c,item), visit_index(item,i).
ssp_extra("check_closed_post_op_runtime_builder_no_callable_escape_hatches",m,m,n,n,0,"STEP-029","runtime_builder_post_op inputs must not be indirect callable registry ids") :- ssp_module(d,m), docof(n,d), ssp_named_call(n,name), contains("runtime",@lower(name)), contains("register",@lower(name)), (contains("callback",@lower(name)) ; contains("callable",@lower(name)) ; contains("effect",@lower(name)) ; contains("function",@lower(name)) ; contains("hook",@lower(name)) ; contains("processor",@lower(name)) ; contains("transform",@lower(name))).
.decl ssp_builder_bad_name(c: node)
ssp_builder_bad_name(c) :- ssp_builder_call(c), ssp_builder_kind(c,v), ssp_dotted(v,name), ssp_builder_escape(name).
ssp_builder_bad_name(c) :- ssp_builder_call(c), ssp_runtime_builder_name(c,v), str_const(v,name), ssp_builder_escape(name).
ssp_extra("check_closed_post_op_runtime_builder_no_callable_escape_hatches",m,m,c,c,1,"STEP-029","Closed runtime builders must not be named as generic callback/callable escape hatches") :- ssp_module(d,m), docof(c,d), ssp_builder_bad_name(c).
ssp_extra("check_closed_post_op_runtime_builder_no_callable_escape_hatches",m,m,c,v,index+2,"STEP-029",message) :- ssp_module(d,m), docof(c,d), ssp_kw_ordinal(c,_,v,index), ssp_kw_reason(c,v,p,message), p = min q : { ssp_kw_reason(c,v,q,_) }.
ssp_extra("check_closed_post_op_runtime_builder_no_callable_escape_hatches",m,m,c,v,k+2,"STEP-029","RuntimeBuilderSpec.literal_kwargs must not carry callback-shaped fields or values") :- ssp_module(d,m), docof(c,d), ssp_literal_kwargs(c,v), ssp_literal_escape(v), ssp_kw_count(c,k).
ssp_extra("check_closed_post_op_runtime_builder_no_callable_escape_hatches",m,m,c,v,k+3,"STEP-029","RuntimeBuilderSpec.literal_kwargs must not carry function or lambda values") :- ssp_module(d,m), docof(c,d), ssp_literal_kwargs(c,v), ssp_direct_callable(v), ssp_kw_count(c,k).
ssp_extra("check_closed_post_op_runtime_builder_no_callable_escape_hatches",m,m,c,v,k+4,"STEP-029","RuntimeBuilderSpec.literal_kwargs must not carry mutable literal values") :- ssp_module(d,m), docof(c,d), ssp_literal_kwargs(c,v), ssp_mutable(v), ssp_kw_count(c,k).

// RuntimeBuilder symbols have audit debt by default in the pinned policy.
.decl ssp_builder_symbol(root: node, name: symbol)
ssp_builder_symbol(root,cat("RuntimeBuilderKind.",name)) :- ssp_under(c,root), ssp_builder_kind(c,v), ssp_attr(v,parent,name), ssp_dotted(parent,"RuntimeBuilderKind").
ssp_builder_symbol(root,cat("RuntimeBuilderName.",name)) :- ssp_under(c,root), ssp_builder_name(c,v), ssp_attr(v,parent,name), ssp_dotted(parent,"RuntimeBuilderName").
.decl ssp_ref_symbol(c: node, name: symbol)
ssp_ref_symbol(c,name) :- ssp_last_kw(c,"closed_post_op",root), ssp_builder_symbol(root,name).
.decl ssp_non_audit_ref(c: node)
ssp_non_audit_ref(c) :- ssp_ref_symbol(c,name), option_item("fateNames",i,name), option_item("fateValues",i,value), value != "audit_required".
.decl ssp_ref_symbols(c: node, names: symbol)
ssp_ref_symbols(c,names) :- ssp_compiled(c), ssp_ref_symbol(c,_), names = join name by name sep ", " : { ssp_ref_symbol(c,name) }.
ssp_ref_symbols(c,"unknown post-op") :- ssp_compiled(c), !ssp_ref_symbol(c,_).
ssp_problem_hit("check_runtime_refs_without_sql_grammar_guardrail",m,m,c,v,0,"STEP-033",cat("CompiledStep(runtime_ref_ids=...) without SQL grammar must remain audit debt, not approved terminal post-op behavior (",names,")")) :- ssp_module(d,m), docof(c,d), ssp_missing_grammar(c), ssp_last_kw(c,"runtime_ref_ids",v), ssp_nonempty(v), ssp_ref_symbols(c,names), (!ssp_ref_symbol(c,_) ; ssp_non_audit_ref(c)).

.decl ssp_exception(name: symbol)
ssp_exception("RuntimeError"). ssp_exception("TypeError"). ssp_exception("NotImplementedError").
.decl ssp_assertion_call(c: node)
ssp_assertion_call(c) :- ssp_named_call(c,name), (name = "ResultAssertionSpec" ; suffix(".ResultAssertionSpec",name)).
.decl ssp_assertion_exception(c: node, name: symbol)
ssp_assertion_exception(c,name) :- ssp_assertion_call(c), ssp_first_kw(c,"static_exception",v), ssp_dotted(v,name).
.decl ssp_assert_spec(c: node, value: node)
ssp_assert_spec(c,v) :- ssp_named_call(c,name), suffix("CompiledPostOp.assert_result",name), ssp_pos(c,0,v).
ssp_assert_spec(c,v) :- ssp_named_call(c,name), suffix("CompiledPostOp.assert_result",name), !ssp_pos(c,0,_), ssp_first_kw(c,"spec",v).
.decl ssp_static_exception(n: node)
ssp_static_exception(n) :- ssp_call_name(n,name), docof(n,d), ssp_static_summary(d,name).
ssp_static_exception(n) :- ssp_named_call(n,name), suffix("static_exception_post_op",name), ssp_pos(n,0,v), ssp_dotted(v,exc), ssp_exception(exc).
ssp_static_exception(n) :- ssp_assert_spec(n,v), kind(v,"call"), !ssp_assertion_exception(v,_).
ssp_static_exception(n) :- ssp_assert_spec(n,v), kind(v,"call"), ssp_assertion_exception(v,exc), ssp_exception(exc).
.decl ssp_static_summary(d: number, name: symbol)
ssp_static_summary(d,@nfkc(name)) :- ssp_fn(d,f), def_name(f,name), ssp_under(r,f), ssp_ret(r,v), ssp_static_exception(v).
ssp_static_summary(d,@nfkc(name)) :- ssp_fn(d,f), def_name(f,name), ssp_under(c,f), ssp_assertion_call(c), ssp_first_kw(c,"static_exception",v), ssp_name(v,param), sig_param(f,_,nm,_,pk,_,_), (pk = "posonly" ; pk = "pos" ; pk = "kwonly"), text(nm,raw), @nfkc(raw) = param.
.decl ssp_constructs_result(f: node)
ssp_constructs_result(f) :- ssp_fn(_,f), ssp_under(c,f), ssp_named_call(c,name), (name = "ResultMaterializationSpec" ; suffix(".ResultMaterializationSpec",name) ; name = "CompiledPostOp.materialize" ; suffix(".CompiledPostOp.materialize",name)).
ssp_constructs_result(f) :- ssp_fn(_,f), ssp_under(c,f), ssp_named_call(c,name), (name = "CompiledStep" ; suffix(".CompiledStep",name)), ssp_kw(c,key,_), (key = "post_op" ; key = "closed_post_op" ; key = "post_op_with_refs").
.decl ssp_raised_exception(n: node, name: symbol)
ssp_raised_exception(n,name) :- kind(n,"raise_statement"), child(n,v,0), ssp_name(v,name).
ssp_raised_exception(n,name) :- kind(n,"raise_statement"), child(n,v,0), ssp_named_call(v,name).
ssp_problem_hit("check_compiled_result_builders_do_not_fail_closed",m,f,n,n,0,"STEP-041","compiled result builders must not replace runtime-ref/Python-shaping debt with fail-closed RuntimeError/TypeError/NotImplementedError guards; emit a SQL-visible result contract or route to an existing compliant strategy") :- ssp_module(d,m), ssp_fn(d,f), ssp_constructs_result(f), ssp_under(n,f), ssp_raised_exception(n,name), ssp_exception(name).
ssp_problem_hit("check_compiled_result_builders_do_not_fail_closed",m,f,c,v,0,"STEP-041","compiled result builders must not hide unsupported plan shapes behind static exception closed post-ops; validate before selecting this builder or emit a declared SQL-visible result contract") :- ssp_module(d,m), ssp_fn(d,f), ssp_constructs_result(f), ssp_under(c,f), ssp_compiled(c), ssp_last_kw(c,"closed_post_op",v), ssp_static_exception(v).

.decl ssp_legacy_gate(d: number)
ssp_legacy_gate(d) :- ssp_strict(d).
ssp_legacy_gate(d) :- ssp_doc(d,_), option("strictModulesOnly","0").
.decl ssp_last_function(d: number, name: symbol, f: node)
ssp_last_function(d,@nfkc(name),f) :- ssp_fn(d,f), def_name(f,name), visit_index(f,i), i = max j : { ssp_fn(d,g), def_name(g,other), @nfkc(other) = @nfkc(name), visit_index(g,j) }.
.decl ssp_legacy_hit(call: node, value: node, phase: number, at: node, problem: symbol)
ssp_legacy_hit(call,v,0,v,cat("CompiledStep(",key,"=partial(...)) binds a likely user-provided callable")) :- ssp_legacy_value(call,key,v), ssp_bare_partial(v), ssp_call_user(v).
ssp_legacy_hit(call,v,0,v,"CompiledStep(post_op_with_refs=...) receives a callable object") :- ssp_legacy_value(call,"post_op_with_refs",v), kind(v,"call"), !ssp_bare_partial(v).
ssp_legacy_hit(call,v,0,v,cat("CompiledStep(",key,"=...) references a likely user-provided callable")) :- ssp_legacy_value(call,key,v), !kind(v,"call"), ssp_user_shape(v).
ssp_legacy_hit(call,v,1,n,cat("legacy ",key," callback '",name,"' invokes or forwards a likely user-provided callable")) :- ssp_legacy_value(call,key,v), ssp_name(v,name), docof(call,d), ssp_last_function(d,name,f), ssp_under(n,f), ssp_call_user(n).
ssp_problem(problem) :- ssp_legacy_hit(_,_,_,_,problem).
ssp_result(path,l,"STEP-028",message,mi,phase,calli,vi,ni,"check_legacy_postop_user_callable_escape_hatches",checkOrder) :- !ssp_failed_entry("check_legacy_postop_user_callable_escape_hatches",path), !ssp_collecting(_), ssp_order("check_legacy_postop_user_callable_escape_hatches",checkOrder), ssp_enabled("check_legacy_postop_user_callable_escape_hatches",d), ssp_run("check_legacy_postop_user_callable_escape_hatches"), ssp_module(d,m), ssp_doc(d,path), ssp_legacy_gate(d), docof(call,d), ssp_legacy_hit(call,v,phase,n,problem), ssp_explain(problem,message), line(n,l), visit_index(m,mi), visit_index(call,calli), visit_index(v,vi), visit_index(n,ni).

// Fact-framework parse errors retain their exception class, filename and line.
ssp_result(path,l,"PARSE",cat("SyntaxError: ",detail," (",filename,", line ",to_string(l),")"),0,0,0,0,0,"_scan_file",-1) :- option("entryPoint","_scan_file"), option("argumentPath",path), option("inputName",filename), option_item("inputFiles",_,input), doc(d,input,_), doc_role(d,"primary"), syntax_error(d,l,detail), detail != "source code string cannot contain null bytes".
ssp_result(path,1,"PARSE","SyntaxError: source code string cannot contain null bytes",0,0,0,0,0,"_scan_file",-1) :- option("entryPoint","_scan_file"), option("argumentPath",path), option_item("inputFiles",_,input), doc(d,input,_), doc_role(d,"primary"), syntax_error(d,_,"source code string cannot contain null bytes").
.decl ssp_error_line(detail: symbol, line: number)
ssp_error_line(detail,n) :- ssp_key_error(_,_,detail), contains("line ",detail), tail = @replace_all(detail,"(?s)\\A.*line ",""), match_all("\\A(?<digits>[0-9]+)(?s:.*)\\z",tail), n = to_number(digits).
ssp_result(path,n,"PARSE",cat("ValueError: ",detail),0,0,0,0,0,"_scan_file",-1) :- option("entryPoint","_scan_file"), ssp_key_error(_,path,detail), ssp_error_line(detail,n).
ssp_result(path,1,"PARSE",cat("ValueError: ",detail),0,0,0,0,0,"_scan_file",-1) :- option("entryPoint","_scan_file"), ssp_key_error(_,path,detail), !ssp_error_line(detail,_).
ssp_result(path,l,"PARSE",cat("SyntaxError: ",detail," (",filename,", line ",to_string(l),")"),0,0,0,0,0,"_scan_file",-1) :- option("entryPoint","_cli_scan"), option_item("cliPaths",i,path), filename = @replace_all(path,"(?s)\\A.*/",""), option_item("inputFiles",i,input), doc(d,input,_), doc_role(d,"primary"), syntax_error(d,l,detail), detail != "source code string cannot contain null bytes".
ssp_result(path,1,"PARSE","SyntaxError: source code string cannot contain null bytes",0,0,0,0,0,"_scan_file",-1) :- option("entryPoint","_cli_scan"), option_item("cliPaths",i,path), option_item("inputFiles",i,input), doc(d,input,_), doc_role(d,"primary"), syntax_error(d,_,"source code string cannot contain null bytes").
ssp_result(path,n,"PARSE",cat("ValueError: ",detail),0,0,0,0,0,"_scan_file",-1) :- option("entryPoint","_cli_scan"), ssp_key_error(_,path,detail), ssp_error_line(detail,n).
ssp_result(path,1,"PARSE",cat("ValueError: ",detail),0,0,0,0,0,"_scan_file",-1) :- option("entryPoint","_cli_scan"), ssp_key_error(_,path,detail), !ssp_error_line(detail,_).

// Direct API DTOs and production findings consume the same ordered producer.
.violation SSPRow(at: span, violation_code: symbol, detail: symbol, class_order: number, method_order: number, callback_order: number, node_order: number, suborder: number, entry: symbol, check_order: number) code "SSP_ROW" "{detail}"
SSPRow(@place(path,l),code,message,ci,fi,pi,ni,sub,entry,checkOrder) :- option("entryPoint",_), ssp_result(path,l,code,message,ci,fi,pi,ni,sub,entry,checkOrder).
.violation StepFinding(at: span, violation_code: symbol, detail: symbol, class_order: number, method_order: number, callback_order: number, node_order: number, suborder: number, entry: symbol, check_order: number, path_order: symbol) code {violation_code} "{detail}"
StepFinding(@place(path,l),code,message,ci,fi,pi,ni,sub,entry,checkOrder,@replace_all(path,"/","\u0000")) :- !option("entryPoint",_), multi_status("serverplan_steps/0","valid"), ssp_result(path,l,code,message,ci,fi,pi,ni,sub,entry,checkOrder).
.violation SSPProductionFile(at: span, file_path: symbol, path_order: symbol) code "SSP_PRODUCTION_FILE" "{file_path}"
SSPProductionFile(@place("",0),path,@replace_all(path,"/","\u0000")) :- option("entryPoint","_production_facts"), ssp_prod_file(path).
ssp_verification(0,"serverplan_steps/0",sig) :- !option("entryPoint",_), option("signature",sig).
ssp_verification(0,"serverplan_steps/0",sig) :- !option("entryPoint",_), !option("signature",_), ssp_setting_value("ALLOWLIST_SIGNATURE",0,sig).
.violation StepSignatureFailure(at: span, verification_stderr: symbol) code "invalid_allowlist_signature" "ServerPlan step allowlist signature verification failed"
StepSignatureFailure(@place(cat(root,"/scripts/lint_serverplan_steps.py"),1),detail) :- !option("entryPoint",_), ssp_prod_root(root), ssp_verification_stderr("serverplan_steps/0",detail).
