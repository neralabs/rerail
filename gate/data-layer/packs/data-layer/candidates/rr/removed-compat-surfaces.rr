.decl pp_fact_allowed(path: symbol)
.decl pp_report_allowed(path: symbol)
pp_fact_allowed(p) :- pp_file(p), !pp_fact_excluded(p).
.decl pp_fact_excluded(path: symbol)
pp_report_allowed(p) :- pp_file(p), !pp_report_excluded(p).
.decl pp_report_excluded(path: symbol)
.decl ppe_Removed(path: symbol, line: number, event0: number, event1: number, event2: number, name: symbol, ordinal: number, anchor: node)
Removed(anchor,name,ordinal,o0,o1,o2) :- ppe_Removed(p,l,o0,o1,o2,name,ordinal,anchor), pp_api().
Removed(@place(p,l),name,ordinal,o0,o1,o2) :- ppe_Removed(p,l,o0,o1,o2,name,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
pp_report(p,l,"RCS001",cat("removed compatibility surface '",name,"' must not be reintroduced"),p,o0,"",o1,o0,o1,o2) :- ppe_Removed(p,l,o0,o1,o2,name,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
