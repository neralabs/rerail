// The configured reporter preserves each collector event, including repeated names on one line.
.violation Removed(at: node, name: symbol, ordinal: number, collector_order0: number, collector_order1: number, collector_order2: number) code "RCS001" "removed compatibility surface '{name}' must not be reintroduced"
ppe_Removed(ppe_path,ppe_line,i,0,0,x,i,n) :- removed_symbol(n, x), docof(n, d), removed_selected(d), visit_index(n, i),
    pp_run(), !syntax_error(d, _, _), docof(n,ppe_doc), pp_doc(ppe_doc,ppe_path), line(n,ppe_line).

removed_selected(d) :- pp_run(), pp_doc(d,_), pp_fact_present(d).

