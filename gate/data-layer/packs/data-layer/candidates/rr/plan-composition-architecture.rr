.policy "data-layer:plan-composition-architecture" revision 1
.description "Semantic plans are built without transactions: no runtime imports, runtime types or execution calls."
.language python
.mode block
.scope include "l2070_batching/semantic_plan.py"
// Python linter: scripts/lint_plan_composition_architecture.py. It reads one file, l2070_batching/semantic_plan.py:
//   SPC-001 an import (anywhere) of a module whose name contains cache, connection, executor, plan_flush,
//           runtime_services or transaction, or ends in .lazy_result / .lazy_seq
//   SPC-002 an annotated assignment (anywhere) whose annotation contains Connection, Cursor, Executor, LazyResult,
//           PlanFlushContext or Transaction
//   In a top-level `class SemanticPlanBuilder`, for each sync method directly in its body:
//   SPC-003 a call `….commit()`, `.execute()`, `.resolve()`, … anywhere inside the method
//   SPC-004 a public method whose return annotation is dict, list or set (`-> list[str]` too)
//   SPC-005 its add_fragment does not use both names RefRemap and rewrite_exact_plan_refs_payload
// Two more come from running the builder (run_behavior_probes), which only a CI step can do: the
// plan_composition_probes artifact (RUN-FACTS.md). The rule reads what the probes observed and decides:
//   SPC-012 two builds of the same plan gave different fingerprints
//   SPC-005 importing one fragment twice reused a destination ref
// Both sit at line 1 of l2070_batching/semantic_plan.py, as in the linter.
// Follows the linter: names and annotations are compared as written text, nothing is resolved.

#include "python/names.rr"
#include "python/ast.rr"      // from_module_raw, ast_name

// ---- the linter's lists ---------------------------------------------------------------------------------------
.decl spc_import_part(s: symbol)
spc_import_part("cache"). spc_import_part("connection"). spc_import_part("executor").
spc_import_part("plan_flush"). spc_import_part("runtime_services"). spc_import_part("transaction").
.decl spc_runtime_type(s: symbol)
spc_runtime_type("Connection"). spc_runtime_type("Cursor"). spc_runtime_type("Executor").
spc_runtime_type("LazyResult"). spc_runtime_type("PlanFlushContext"). spc_runtime_type("Transaction").
.decl spc_terminal(s: symbol)
spc_terminal("commit"). spc_terminal("execute"). spc_terminal("execute_async"). spc_terminal("execute_sync").
spc_terminal("resolve"). spc_terminal("resolve_async"). spc_terminal("rollback").
.decl spc_mutable(s: symbol)
spc_mutable("dict"). spc_mutable("list"). spc_mutable("set").

// ---- SPC-001: runtime imports -----------------------------------------------------------------------------------
// spc_imported(i, s): the module text the linter tests. `from ..x.y import z` gives "x.y" (dots dropped,
// `from . import z` gives ""); `import a.b, c as d` gives "a.b,c", the names joined by commas.
.decl spc_imported(i: node, s: symbol)
spc_imported(i, s) :- from_module_raw(i, s).
spc_imported(i, s) :- kind(i, "import_statement"),
    s = join m by k sep "," : { child(i, n, k), dotted(n, m) }.

.violation SPC_001(at: node, m: symbol) code "SPC-001" "semantic plan imports runtime module '{m}'"
SPC_001(i, s) :- spc_imported(i, s), spc_import_part(p), contains(p, s).
SPC_001(i, s) :- spc_imported(i, s), (suffix(".lazy_result", s) ; suffix(".lazy_seq", s)).

// ---- SPC-002: runtime types in annotations ------------------------------------------------------------------------
// `x: T` and `x: T = v` are assignments with a `type` field. The source text stands in for ast.unparse: a substring
// test, so `"Transaction"` (a string annotation) matches as the linter's `'Transaction'` does.
.violation SPC_002(at: node, s: symbol) code "SPC-002" "semantic field uses runtime type '{s}'"
SPC_002(a, s) :- kind(a, "assignment"), field(a, "type", t), text(t, s), spc_runtime_type(p), contains(p, s).

// ---- the builder class ------------------------------------------------------------------------------------------
// spc_builder(c): a top-level `class SemanticPlanBuilder:`, decorated or not.
.decl spc_builder(c: node)
spc_builder(c) :- modnode(_, m), child(m, s, _), (c = s ; kind(s, "decorated_definition"), field(s, "definition", c)),
    def_name(c, "SemanticPlanBuilder").
// spc_method(c, f, w): sync method f is a statement of c's own body (not inside an `if` there); w is f with its
// decorators, the extent ast.walk(method) covers. `async def` is not an ast.FunctionDef, so it is not checked.
.decl spc_method(c: node, f: node, w: node)
spc_method(c, f, w) :- spc_builder(c), field(c, "body", b), child(b, w, _),
    (f = w ; kind(w, "decorated_definition"), field(w, "definition", f)),
    kind(f, "function_definition"), !is_async(f).

// SPC-003: an attribute call to an execution terminal anywhere in a method, nested defs and lambdas included.
.violation SPC_003(at: node, x: symbol) code "SPC-003" "semantic builder calls runtime terminal {x}"
SPC_003(k, x) :- spc_method(_, _, w), within(k, w), kind(k, "call"), field(k, "function", e), kind(e, "attribute"),
    field(e, "attribute", a), text(a, x), spc_terminal(x).

// spc_return_root(f, x): the name at the root of f's return annotation: `list`, `typing.List` (gives List), `list[str]`.
// Only one subscript is taken off, as the linter does; a string annotation has no root.
.decl spc_return_root(f: node, x: symbol)
spc_return_root(f, x) :- field(f, "return_type", t), child(t, e, 0), spc_root(e, x).
spc_return_root(f, x) :- field(f, "return_type", t), child(t, g, 0), kind(g, "generic_type"), child(g, e, 0),
    spc_root(e, x).
spc_return_root(f, x) :- field(f, "return_type", t), child(t, g, 0), kind(g, "subscript"), field(g, "value", e),
    spc_root(e, x).
// spc_root(e, x): a Name gives its text, an Attribute its last name.
.decl spc_root(e: node, x: symbol)
spc_root(e, x) :- kind(e, "identifier"), text(e, x).
spc_root(e, x) :- kind(e, "attribute"), field(e, "attribute", a), text(a, x).
spc_root(e, x) :- kind(e, "member_type"), child(e, a, 1), text(a, x).

// SPC-004: a public method that hands out a mutable container.
.violation SPC_004(at: node, x: symbol) code "SPC-004" "semantic builder exposes mutable return from {x}"
SPC_004(f, x) :- spc_method(_, f, _), def_name(f, x), !prefix("_", x), spc_return_root(f, r), spc_mutable(r).

// SPC-005: the class's first add_fragment must remap refs with both helpers (each read as a plain Name).
.decl spc_add_fragment(c: node, f: node, w: node)
spc_add_fragment(c, f, w) :- spc_method(c, f, w), def_name(f, "add_fragment"),
    !spc_earlier_add_fragment(c, w).
.decl spc_earlier_add_fragment(c: node, w: node)
spc_earlier_add_fragment(c, w) :- spc_method(c, f, w), spc_method(c, g, v), def_name(f, "add_fragment"),
    def_name(g, "add_fragment"), precedes(v, w).
.decl spc_uses(w: node, x: symbol)
spc_uses(w, x) :- spc_add_fragment(_, _, w), has(w, n, "identifier"), ast_name(n, x).

.violation SPC_005(at: node) code "SPC-005" "fragment import must use typed exact ref remapping"
SPC_005(f) :- spc_add_fragment(_, f, w), (!spc_uses(w, "RefRemap") ; !spc_uses(w, "rewrite_exact_plan_refs_payload")).

// ---- the behaviour probes (run artifact) --------------------------------------------------------------------------
// The producer runs the linter's two probes and prints what they observed, not a verdict:
//   {"fingerprints": ["d627…", "d627…"],              two builds of one plan
//    "first_refs": ["probe-destination:first:step_0"], the refs one fragment import allocated
//    "second_refs": ["probe-destination:first:step_1"]} the same fragment imported again
.artifact "plan_composition_probes" inputs "**/*.py"
.decl spc_fingerprint(fp: symbol)
.input spc_fingerprint(IO=json, artifact="plan_composition_probes", path="/fingerprints")
.decl spc_first_ref(r: symbol)
.input spc_first_ref(IO=json, artifact="plan_composition_probes", path="/first_refs")
.decl spc_second_ref(r: symbol)
.input spc_second_ref(IO=json, artifact="plan_composition_probes", path="/second_refs")

.violation SPC_012(at: loc) code "SPC-012" "equivalent semantic plans produced different fingerprints"
SPC_012(@place("l2070_batching/semantic_plan.py", 1)) :- spc_fingerprint(a), spc_fingerprint(b), a != b.
.violation SPC_005_probe(at: loc) code "SPC-005" "colliding fragment imports reused destination refs"
SPC_005_probe(@place("l2070_batching/semantic_plan.py", 1)) :- spc_first_ref(r), spc_second_ref(r).
