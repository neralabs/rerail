.decl ap_supplied()
ap_supplied() :- option("entryPoint","analyze_source").
.decl ap_native_enabled()
ap_native_enabled() :- !ap_supplied().
.decl ap_parent(n: node, p: node)
ap_parent(n, p) :- ap_native_enabled(), ast_parent(n, p).
.decl ap_frame_node(n: node)
ap_frame_node(n) :- ap_native_enabled(), kind(n, k), (k = "function_definition" ; k = "lambda" ; k = "module").
.decl ap_scope(n: node, f: node)
ap_scope(n, n) :- ap_frame_node(n).
ap_scope(n, f) :- ap_parent(n, p), ap_scope(p, f), !ap_frame_node(n).
.decl ap_outer_frame(f: node, p: node)
ap_outer_frame(f, p) :- ap_frame_node(f), ap_parent(f, n), ap_scope(n, p).
.decl ap_function(f: node, name: symbol, async_: number)
ap_function(f, @nfkc(name), 1) :- ap_native_enabled(), kind(f, "function_definition"), def_name(f, name), op(f, "async").
ap_function(f, @nfkc(name), 0) :- ap_native_enabled(), kind(f, "function_definition"), def_name(f, name), !op(f, "async").
.decl ap_sync_frame(f: node)
ap_sync_frame(f) :- ap_function(f, _, 0).
ap_sync_frame(f) :- ap_native_enabled(), kind(f, "lambda").
.decl ap_root_frame(f: node)
ap_root_frame(f) :- ap_native_enabled(), kind(f, "module").
.decl ap_class(n: node, name: symbol)
ap_class(n, @nfkc(name)) :- ap_native_enabled(), kind(n, "class_definition"), def_name(n, name).
.decl ap_class_base(c: node, b: node)
ap_class_base(c, b) :- ap_native_enabled(), ap_class(c, _), field(c, "superclasses", args), child(args, raw, _), unparen(raw, b).
.decl ap_in_class(n: node, c: node)
ap_in_class(n, p) :- ap_parent(n, p), ap_class(p, _).
ap_in_class(n, c) :- ap_parent(n, p), !ap_class(p, _), ap_in_class(p, c).
.decl ap_decorator(f: node, e: node)
ap_decorator(f, e) :- ap_native_enabled(), decorator(f, e).
.decl ap_name(n: node, name: symbol)
ap_name(n, @nfkc(name)) :- ap_native_enabled(), unparen(n, e), ast_name(e, name).
.decl ap_attr(n: node, obj: node, name: symbol)
ap_attr(n, obj, @nfkc(name)) :- ap_native_enabled(), unparen(n, e), kind(e, "attribute"), field(e, "object", obj), field(e, "attribute", nm), text(nm, name).
.decl ap_call(n: node, fn: node)
ap_call(n, fn) :- ap_native_enabled(), kind(n, "call"), field(n, "function", fn).
.decl ap_call_expr(n: node, fn: node)
ap_call_expr(n, fn) :- ap_native_enabled(), unparen(n, c), ap_call(c, fn).
.decl ap_subscript_value(n: node, obj: node)
ap_subscript_value(n, obj) :- ap_native_enabled(), unparen(n, e), kind(e, "subscript"), field(e, "value", obj).
.decl ap_parameter(f: node, name: symbol)
ap_parameter(f, @nfkc(name)) :- ap_native_enabled(), sig_param(f, _, nm, _, _, _, _), text(nm, name).
.decl ap_parameter_annotation(f: node, ann: node)
ap_parameter_annotation(f, ann) :- ap_native_enabled(), sig_param(f, _, _, _, _, ann, _), !unset(ann).
.decl ap_typed_parameter(f: node, name: symbol, ann: node)
ap_typed_parameter(f, @nfkc(name), ann) :- ap_native_enabled(), sig_param(f, _, nm, _, _, ann, _), !unset(ann), text(nm, name).
.decl ap_annotation_edge(e: node, c: node)
ap_annotation_edge(e, c) :- ap_native_enabled(), kind(e, k), (k = "type" ; k = "parenthesized_expression"), child(e, c, _), !kind(c, "comment").
ap_annotation_edge(e, c) :- ap_native_enabled(), kind(e, "generic_type"), child(e, c, 0).
ap_annotation_edge(e, c) :- ap_native_enabled(), kind(e, "generic_type"), child(e, tp, 1), child(tp, c, _).
ap_annotation_edge(e, c) :- ap_native_enabled(), kind(e, "subscript"), (field(e, "value", c) ; field(e, "subscript", c)).
ap_annotation_edge(e, c) :- ap_native_enabled(), kind(e, "tuple"), child(e, c, _).
ap_annotation_edge(e, c) :- ap_native_enabled(), kind(e, "binary_operator"), op(e, "|"), (field(e, "left", c) ; field(e, "right", c)).
ap_annotation_edge(e, c) :- ap_native_enabled(), kind(e, "union_type"), child(e, c, _).
.decl ap_annotation_string(e: node, text: symbol)
ap_annotation_string(e, text) :- ap_native_enabled(), plain_str(e, text).
.decl ap_assignment(a: node, target: symbol, value: node)
ap_assignment(a, target, value) :- ap_native_enabled(), assign_target(a, t), ap_name(t, target), assign_value(a, value).
.decl ap_order(n: node, ordinal: number)
ap_order(n, i) :- ap_native_enabled(), visit_index(n, i).
.decl ap_call_line(n: node, line: number)
ap_call_line(n, l) :- ap_native_enabled(), ap_call(n, _), line(n, l).
.decl ap_receiver_print(c: node, printed: symbol)
ap_receiver_print(c, printed) :- ap_native_enabled(), call_receiver_text(c, printed).

.decl ap_document(d: number, path: symbol)
ap_document(d, p) :- pp_doc(d,p), option("entryPoint", "lint_file"), option("originalPath", actual), suffix(".py", actual), !apf_bare_py(actual), !syntax_error(d, _, _).
.decl ap_hidden(d: number)
ap_hidden(d) :- path_part(d, p), (p = ".git" ; p = ".venv" ; p = "venv" ; p = "__pycache__" ; p = "tmp").
.decl ap_source_triggered(d: number)
ap_source_triggered(d) :- source(d, sp), text(sp, text), ap_trigger(trigger), contains(trigger, text).
.decl ap_path(d: number, owner: symbol, path: symbol)
ap_path(d, owner, path) :- ap_document(d, owner), option("originalPath", path).
ap_path(d, path, cat(root, "/", path)) :- ap_document(d, path), !option("originalPath", _), !option("entryPoint","_ap_file_batch"), workspace_root(root).
.decl ap_excluded_path(path: symbol)
ap_excluded_path(path) :- ap_path(_, _, path), ap_exclude_pattern(pattern), contains(pattern, path).
ap_excluded_path(path) :- option("originalPath", path), ap_exclude_pattern(pattern), contains(pattern, path).
.decl ap_in_scope(d: number, owner: symbol)
ap_in_scope(d, owner) :- ap_path(d, owner, p), !ap_excluded_path(p),
    (contains("impl/", p) ; contains("impl\\", p) ; contains("api/", p) ; contains("api\\", p) ; contains("conform/", p) ; contains("conform\\", p)).
.decl ap_api(d: number, owner: symbol)
ap_api(d, owner) :- ap_path(d, owner, p), (contains("api/", p) ; contains("api\\", p)).
.decl ap_impl(d: number, owner: symbol)
ap_impl(d, owner) :- ap_path(d, owner, p), (contains("impl/", p) ; contains("impl\\", p)).
.decl ap_line(d: number, line: number, text: symbol)
ap_line(d, l, text) :- ap_native_enabled(), ap_document(d, _), split_line(d, l, text).
.decl ap_call_doc(c: node, d: number, path: symbol)
ap_call_doc(c, d, path) :- ap_call(c, _), ap_native_enabled(), docof(c, d), ap_document(d, path), ap_in_scope(d, path), ap_source_triggered(d).
// The supplied tree and original source are independent inputs. Its printer buffer is never a detector input.
ap_document(0, path) :- ap_supplied(), option("analysisPath", path), option("providedTree", "true").
ap_line(0, i + 1, text) :- ap_supplied(), option_item("sourceLines", i, text).
ap_source_triggered(0) :- ap_supplied(), option("providedSource", text), ap_trigger(trigger), contains(trigger, text).
ap_call_doc(c, 0, path) :- ap_supplied(), ap_call(c, _), ap_document(0, path), ap_in_scope(0, path), ap_source_triggered(0).

.decl ap_write_decorator(f: node)
ap_write_decorator(f) :- ap_decorator(f, e), ap_call_expr(e, fn), ap_attr(fn, _, "write_async").
.decl ap_read_decorator(f: node)
ap_read_decorator(f) :- ap_decorator(f, e), ap_call_expr(e, fn), ap_attr(fn, _, "read_async").
.decl ap_flags(f: node, write_: number, read_: number)
ap_flags(f, 0, 0) :- ap_root_frame(f).
ap_flags(f, 0, 0) :- ap_sync_frame(f).
ap_flags(f, w, r) :- ap_function(f, _, 1), (ap_write_decorator(f) ; ap_read_decorator(f)),
    w = count : { ap_write_decorator(f) }, r = count : { ap_read_decorator(f) }.
ap_flags(f, w, r) :- ap_function(f, _, 1), !ap_write_decorator(f), !ap_read_decorator(f), ap_outer_frame(f, p), ap_flags(p, w, r).
ap_flags(f, 0, 0) :- ap_function(f, _, 1), !ap_write_decorator(f), !ap_read_decorator(f), !ap_outer_frame(f, _).
.decl ap_async_call(c: node, f: node, name: symbol)
ap_async_call(c, f, name) :- ap_call(c, _), ap_scope(c, f), ap_function(f, name, 1).
.decl ap_annotation_contains(e: node)
ap_annotation_contains(e) :- ap_name(e, name), ap_param_type(name).
ap_annotation_contains(e) :- ap_attr(e, _, name), ap_param_type(name).
ap_annotation_contains(e) :- ap_annotation_string(e, text), ap_param_type(name), contains(name, text).
ap_annotation_contains(e) :- ap_annotation_edge(e, c), ap_annotation_contains(c).
.decl ap_txn_name(f: node, name: symbol)
ap_txn_name(f, name) :- ap_function(f, _, 1), ap_parameter(f, name), ap_param_name(name).
ap_txn_name(f, name) :- ap_function(f, _, 1), ap_typed_parameter(f, name, ann), ap_annotation_contains(ann).
.decl ap_receiver_root(e: node, name: symbol)
ap_receiver_root(e, name) :- ap_name(e, name).
ap_receiver_root(e, name) :- ap_attr(e, obj, _), ap_receiver_root(obj, name).
ap_receiver_root(e, name) :- ap_call_expr(e, fn), ap_receiver_root(fn, name).
ap_receiver_root(e, name) :- ap_subscript_value(e, obj), ap_receiver_root(obj, name).
.decl ap_query_chain(f: node, e: node)
ap_query_chain(f, e) :- ap_function(f, _, 1), ap_call_expr(e, fn), ap_attr(fn, obj, method), ap_query_method(method), ap_receiver_root(obj, root), ap_txn_name(f, root).
ap_query_chain(f, e) :- ap_call_expr(e, fn), ap_attr(fn, obj, _), ap_query_chain(f, obj).
.decl ap_alias(f: node, name: symbol, kind: symbol, at: number)
ap_alias(f, name, "session", i) :- ap_assignment(a, name, v), ap_scope(a, f), ap_function(f, _, 1), ap_order(a, i), ap_call_expr(v, fn), ap_attr(fn, _, "session").
ap_alias(f, name, "query", i) :- ap_assignment(a, name, v), ap_scope(a, f), ap_function(f, _, 1), ap_order(a, i), ap_query_chain(f, v).
ap_alias(f, name, kind, i) :- ap_assignment(a, name, v), ap_scope(a, f), ap_function(f, _, 1), ap_order(a, i), ap_name(v, other), ap_alias(f, other, kind, j), j <= i.
.decl ap_tracked_query(c: node, obj: node)
ap_tracked_query(c, obj) :- ap_async_call(c, f, _), ap_receiver_root(obj, name), ap_alias(f, name, "query", at), ap_order(c, i), at <= i.
ap_tracked_query(c, obj) :- ap_async_call(c, f, _), ap_query_chain(f, obj).
.decl ap_transaction_receiver(c: node, obj: node)
ap_transaction_receiver(c, obj) :- ap_async_call(c, _, _), ap_name(obj, "self").
ap_transaction_receiver(c, obj) :- ap_async_call(c, f, _), ap_receiver_root(obj, name), ap_txn_name(f, name).
ap_transaction_receiver(c, obj) :- ap_tracked_query(c, obj).
.decl ap_connection_receiver(c: node, obj: node)
ap_connection_receiver(c, obj) :- ap_async_call(c, _, _), ap_attr(obj, base, a), ap_name(base, "self"), (a = "_conn" ; a = "conn" ; a = "connection" ; a = "_connection").
ap_connection_receiver(c, obj) :- ap_async_call(c, f, _), ap_receiver_root(obj, name), ap_alias(f, name, "session", at), ap_order(c, i), at <= i.

.decl ap_abstract(c: node, d: number, owner: symbol)
ap_abstract(c, d, owner) :- ap_class_base(c, b), ap_name(b, "ABC"), docof(c, d), ap_document(d, owner), ap_native_enabled().
ap_abstract(c, d, owner) :- ap_class_base(c, b), ap_attr(b, _, "ABC"), docof(c, d), ap_document(d, owner), ap_native_enabled().
ap_abstract(c, 0, owner) :- ap_document(0, owner), ap_class_base(c, b), (ap_name(b, "ABC") ; ap_attr(b, _, "ABC")), ap_supplied().
ap_abstract(c, d, owner) :- ap_class(c, name), ap_api(d, owner),
    (contains("Transaction", name) ; contains("Connection", name) ; contains("Query", name) ; contains("Handle", name) ; contains("Version", name)).
.decl ap_window_query(radius: number, fragment: symbol)
ap_window_query(5, "ASYNC_FALLBACK:"). ap_window_query(5, "TODO: Implement").
ap_window_query(5, "native async"). ap_window_query(15, "_wrap_for_executor").
.decl ap_window_contains(c: node, radius: number, fragment: symbol)
ap_window_contains(c, radius, fragment) :- ap_window_query(radius, fragment), ap_call_doc(c, d, _), ap_call_line(c, line), ap_line(d, l, text), l >= line - radius, l <= line + radius, contains(fragment, text).
.decl ap_fallback(c: node, owner: symbol)
ap_fallback(c, owner) :- ap_call_doc(c, d, owner), ap_api(d, owner), ap_in_class(c, cls), ap_abstract(cls, d, owner).
ap_fallback(c, owner) :- ap_call_doc(c, _, owner), ap_window_contains(c, 5, "ASYNC_FALLBACK:").
ap_fallback(c, owner) :- ap_call_doc(c, _, owner), ap_window_contains(c, 5, "TODO: Implement"), ap_window_contains(c, 5, "native async").
.decl ap_fallback_value(c: node, owner: symbol, flag: number)
ap_fallback_value(c, owner, 1) :- ap_call_doc(c, _, owner), ap_fallback(c, owner).
ap_fallback_value(c, owner, 0) :- ap_call_doc(c, _, owner), !ap_fallback(c, owner).
.decl ap_executor_fallback(c: node, owner: symbol, flag: number)
ap_executor_fallback(c, owner, 1) :- ap_fallback(c, owner).
ap_executor_fallback(c, owner, 1) :- ap_call_doc(c, d, owner), !ap_impl(d, owner), ap_window_contains(c, 15, "_wrap_for_executor").
ap_executor_fallback(c, owner, 0) :- ap_call_doc(c, d, owner), !ap_fallback(c, owner), (ap_impl(d, owner) ; !ap_window_contains(c, 15, "_wrap_for_executor")).
.decl ap_context_line(d: number, l: number, text: symbol)
ap_context_line(d, l, cat("  ", @slice("    ", 0, 4 - strlen(to_string(l))), to_string(l), " | ", text)) :- ap_line(d, l, text), l < 1000.
ap_context_line(d, l, cat("  ", to_string(l), " | ", text)) :- ap_line(d, l, text), l >= 1000.
.decl ap_context(c: node, context: symbol)
ap_context(c, context) :- ap_call_doc(c, d, _), ap_call_line(c, line),
    context = join text by l sep "\n" : { ap_context_line(d, l, text), l >= line - 2, l <= line + 2 }.
.decl ap_issue(c: node, owner: symbol, code: symbol, message: symbol, fallback: number, rank: number)
ap_issue(c, owner, "ASYNC001", message, flag, 1) :- ap_call_doc(c, _, owner), ap_call(c, fn), ap_attr(fn, _, "to_thread"), ap_fixed_ASYNC001(message), ap_fallback_value(c, owner, flag).
ap_issue(c, owner, "ASYNC002", message, flag, 2) :- ap_call_doc(c, _, owner), ap_call(c, fn), ap_attr(fn, _, "run_in_executor"), ap_fixed_ASYNC002(message), ap_executor_fallback(c, owner, flag).
ap_issue(c, owner, "ASYNC004", cat("Use ", async_method, "() instead of ", method, "() in async transaction"), 0, 4) :- ap_call_doc(c, _, owner), ap_call(c, fn), ap_attr(fn, _, method), ap_scope(c, f), ap_flags(f, 1, _), ap_write(method, async_method).
ap_issue(c, owner, "ASYNC004", cat("Use ", async_method, "() instead of ", method, "() in async transaction"), 0, 4) :- ap_call_doc(c, _, owner), ap_call(c, fn), ap_attr(fn, _, method), ap_scope(c, f), ap_flags(f, w, r), (w = 1 ; r = 1), ap_read(method, async_method).
ap_issue(c, owner, "ASYNC005", cat("Sync I/O '", method, "()' in async function '", name, "' - use ", async_method, "()"), flag, 5) :- ap_call_doc(c, _, owner), ap_async_call(c, _, name), ap_call(c, fn), ap_attr(fn, _, method), ap_internal(method, async_method), ap_fallback_value(c, owner, flag).
ap_issue(c, owner, "ASYNC006", cat("Sync method '", printed, ".", method, "()' in async function - use ", async_method, "()"), flag, 6) :- ap_call_doc(c, _, owner), ap_async_call(c, f, _), ap_flags(f, 0, 0), ap_call(c, fn), ap_attr(fn, obj, method), ap_transaction(method, async_method), ap_transaction_receiver(c, obj), ap_receiver_print(c, printed), ap_fallback_value(c, owner, flag).
ap_issue(c, owner, "ASYNC007", cat("Sync '", printed, ".", method, "()' in async function - use await ", printed, ".", async_method, "()"), 0, 7) :- ap_call_doc(c, _, owner), ap_async_call(c, _, _), ap_call(c, fn), ap_attr(fn, obj, method), ap_connection(method, async_method), ap_connection_receiver(c, obj), ap_receiver_print(c, printed).
ap_issue(c, owner, "ASYNC008", cat("Sync polymorphic metadata helper '", printed, ".", method, "()' in async function - use await ", printed, ".", async_method, "()"), 0, 8) :- ap_call_doc(c, _, owner), ap_async_call(c, _, _), ap_call(c, fn), ap_attr(fn, _, method), ap_metadata(method, async_method), ap_receiver_print(c, printed).
.decl ap_visible(c: node, owner: symbol, code: symbol, message: symbol, fallback: number, rank: number)
ap_visible(c, owner, code, message, fallback, rank) :- ap_issue(c, owner, code, message, fallback, rank), option("entryPoint", e), (e = "lint_file" ; e = "analyze_source").
ap_visible(c, owner, code, message, 0, rank) :- ap_issue(c, owner, code, message, 0, rank), pp_run().
.violation AsyncASYNC001(at: span, message: symbol, context: symbol, fallback: number, ordinal: number, rank: number) code "ASYNC001" "{message}"
AsyncASYNC001(@place(path, line), message, context, fallback, ordinal, rank) :- ap_visible(c, path, "ASYNC001", message, fallback, rank), ap_call_doc(c, _, path), ap_call_line(c, line), ap_context(c, context), ap_order(c, ordinal), !option("entryPoint","_ap_ast_collect"), !option("entryPoint","_production_contract").
.violation AsyncASYNC002(at: span, message: symbol, context: symbol, fallback: number, ordinal: number, rank: number) code "ASYNC002" "{message}"
AsyncASYNC002(@place(path, line), message, context, fallback, ordinal, rank) :- ap_visible(c, path, "ASYNC002", message, fallback, rank), ap_call_doc(c, _, path), ap_call_line(c, line), ap_context(c, context), ap_order(c, ordinal), !option("entryPoint","_ap_ast_collect"), !option("entryPoint","_production_contract").
.violation AsyncASYNC004(at: span, message: symbol, context: symbol, fallback: number, ordinal: number, rank: number) code "ASYNC004" "{message}"
AsyncASYNC004(@place(path, line), message, context, fallback, ordinal, rank) :- ap_visible(c, path, "ASYNC004", message, fallback, rank), ap_call_doc(c, _, path), ap_call_line(c, line), ap_context(c, context), ap_order(c, ordinal), !option("entryPoint","_ap_ast_collect"), !option("entryPoint","_production_contract").
.violation AsyncASYNC005(at: span, message: symbol, context: symbol, fallback: number, ordinal: number, rank: number) code "ASYNC005" "{message}"
AsyncASYNC005(@place(path, line), message, context, fallback, ordinal, rank) :- ap_visible(c, path, "ASYNC005", message, fallback, rank), ap_call_doc(c, _, path), ap_call_line(c, line), ap_context(c, context), ap_order(c, ordinal), !option("entryPoint","_ap_ast_collect"), !option("entryPoint","_production_contract").
.violation AsyncASYNC006(at: span, message: symbol, context: symbol, fallback: number, ordinal: number, rank: number) code "ASYNC006" "{message}"
AsyncASYNC006(@place(path, line), message, context, fallback, ordinal, rank) :- ap_visible(c, path, "ASYNC006", message, fallback, rank), ap_call_doc(c, _, path), ap_call_line(c, line), ap_context(c, context), ap_order(c, ordinal), !option("entryPoint","_ap_ast_collect"), !option("entryPoint","_production_contract").
.violation AsyncASYNC007(at: span, message: symbol, context: symbol, fallback: number, ordinal: number, rank: number) code "ASYNC007" "{message}"
AsyncASYNC007(@place(path, line), message, context, fallback, ordinal, rank) :- ap_visible(c, path, "ASYNC007", message, fallback, rank), ap_call_doc(c, _, path), ap_call_line(c, line), ap_context(c, context), ap_order(c, ordinal), !option("entryPoint","_ap_ast_collect"), !option("entryPoint","_production_contract").
.violation AsyncASYNC008(at: span, message: symbol, context: symbol, fallback: number, ordinal: number, rank: number) code "ASYNC008" "{message}"
AsyncASYNC008(@place(path, line), message, context, fallback, ordinal, rank) :- ap_visible(c, path, "ASYNC008", message, fallback, rank), ap_call_doc(c, _, path), ap_call_line(c, line), ap_context(c, context), ap_order(c, ordinal), !option("entryPoint","_ap_ast_collect"), !option("entryPoint","_production_contract").

 .violation Excluded(at: span) code "AP_EXCLUDED" "excluded"
Excluded(@place("input.py", 1)) :- option("entryPoint", "should_exclude"), option("originalPath", path), ap_excluded_path(path).
.violation ReadFailure(at: span) code "AP_READ_ERROR" "Source read failed"
ReadFailure(@place("input.py", 1)) :- option("entryPoint", "lint_file"), option("originalPath", path), !ap_excluded_path(path), option("ioError", "true").
.violation ParseWarning(at: span) code "AP_PARSE_WARNING" "Source decoding failed"
ParseWarning(@place("input.py", 1)) :- option("entryPoint", "lint_file"), option("originalPath", path), !ap_excluded_path(path), option("decodeError", "true").
.violation MissingTree(at: span) code "AP_AST_REQUIRED" "AST tree is required; parsing is owned by the fact framework"
MissingTree(@place("input.py", 1)) :- option("entryPoint", "analyze_source"), option("providedTree", "false"), ap_source_triggered(0).

ap_parent(n, p) :- ap_graph_edge(p, _, n).
.decl ap_graph_kind(n: node, kind: symbol)
ap_graph_kind(n, kind) :- option_item("astKinds", n, kind).
.decl ap_graph_edge(p: node, field: symbol, n: node)
ap_graph_edge(to_number(parent), field, n) :- option_item("astParents", n, parent), parent != "-1", option_item("astFields", n, field).
.decl ap_graph_ancestor(n: node, a: node)
ap_graph_ancestor(n, a) :- ap_graph_edge(a, _, n).
ap_graph_ancestor(n, a) :- ap_graph_edge(p, _, n), ap_graph_ancestor(p, a).
.decl ap_graph_callable(n: node)
ap_graph_callable(n) :- ap_graph_kind(n, k), (k = "FunctionDef" ; k = "AsyncFunctionDef" ; k = "Lambda").
ap_frame_node(n) :- ap_graph_callable(n).
ap_frame_node(n) :- ap_graph_kind(n, "Module").
ap_function(f, name, 1) :- ap_graph_kind(f, "AsyncFunctionDef"), option_item("astNames", f, name).
ap_function(f, name, 0) :- ap_graph_kind(f, "FunctionDef"), option_item("astNames", f, name).
ap_sync_frame(f) :- ap_graph_kind(f, "Lambda").
ap_sync_frame(f) :- ap_graph_kind(f, "FunctionDef").
ap_root_frame(f) :- ap_graph_kind(f, "Module").
ap_class(n, name) :- ap_graph_kind(n, "ClassDef"), option_item("astNames", n, name).
ap_class_base(c, b) :- ap_graph_kind(c, "ClassDef"), ap_graph_edge(c, "bases", b).
ap_decorator(f, e) :- ap_graph_callable(f), ap_graph_edge(f, "decorator_list", e).
ap_name(n, name) :- ap_graph_kind(n, "Name"), option_item("astIds", n, name).
ap_attr(n, obj, name) :- ap_graph_kind(n, "Attribute"), ap_graph_edge(n, "value", obj), option_item("astAttrs", n, name).
ap_call(n, fn) :- ap_graph_kind(n, "Call"), ap_graph_edge(n, "func", fn).
ap_call_expr(n, fn) :- ap_graph_kind(n, "Call"), ap_call(n, fn).
ap_subscript_value(n, obj) :- ap_graph_kind(n, "Subscript"), ap_graph_edge(n, "value", obj).
ap_parameter(f, name) :- ap_graph_callable(f), ap_graph_edge(f, "args", args), ap_graph_edge(args, _, arg),
    ap_graph_kind(arg, "arg"), option_item("astArgNames", arg, name).
ap_parameter_annotation(f, ann) :- ap_graph_callable(f), ap_graph_edge(f, "args", args), ap_graph_edge(args, _, arg),
    ap_graph_kind(arg, "arg"), ap_graph_edge(arg, "annotation", ann).
ap_typed_parameter(f, name, ann) :- ap_graph_callable(f), ap_graph_edge(f, "args", args), ap_graph_edge(args, _, arg),
    ap_graph_kind(arg, "arg"), option_item("astArgNames", arg, name), ap_graph_edge(arg, "annotation", ann).
ap_annotation_edge(n, e) :- ap_graph_kind(n, "Subscript"), ap_graph_edge(n, field, e), (field = "value" ; field = "slice").
ap_annotation_edge(n, e) :- ap_graph_kind(n, "Tuple"), ap_graph_edge(n, "elts", e).
ap_annotation_edge(n, e) :- ap_graph_kind(n, "BinOp"), ap_graph_edge(n, "op", op), ap_graph_kind(op, "BitOr"),
    ap_graph_edge(n, field, e), (field = "left" ; field = "right").
// JSON preserves surrogate constants losslessly. Frozen transaction type names are ASCII, whose substrings JSON leaves unchanged.
ap_annotation_string(n, value) :- ap_graph_kind(n, "Constant"), option_item("astValueTypes", n, "str"), option_item("astStringJson", n, value).
ap_assignment(a, target, value) :- ap_graph_kind(a, "Assign"), ap_graph_edge(a, "targets", t), ap_name(t, target), ap_graph_edge(a, "value", value).
ap_assignment(a, target, value) :- ap_graph_kind(a, "AnnAssign"), ap_graph_edge(a, "target", t), ap_name(t, target), ap_graph_edge(a, "value", value).
ap_order(n, n) :- ap_graph_kind(n, _).
ap_call_line(n, to_number(line)) :- ap_graph_kind(n, "Call"), option_item("astLines", n, line).
ap_receiver_print(c, printed) :- ap_supplied(), ap_graph_kind(c, "Call"),
    sig_param(_, _, nm, _, _, ann, _), text(nm, name), prefix("call", name), c = to_number(@slice(name, 4, strlen(name))), annotation_text(ann, printed).

#include "data-layer/plugin-production.rr"
pp_config("name","async_patterns").
pp_config("description","Sync-in-async fallback patterns must not appear in actionable code").
pp_config("enforcement","hard-fail").
pp_config("findingSeverity","hard-fail").
pp_config("extractor","async_patterns.violations").
pp_config("parser","ast_collect").
pp_config("scope","static").
pp_config("include_tests","true").
pp_config("fact_kind","list").
pp_static_root("impl/sqlite").
pp_static_root("impl/postgres").
pp_static_root("impl/mariadb").
pp_static_root("impl/doltdb").
pp_static_root("impl/mongodb").
pp_static_root("impl/neo4j").
pp_static_root("impl/common").
pp_static_root("api").
pp_static_root("conform").
pp_trigger("async def").
pp_trigger("to_thread").
pp_trigger("run_in_executor").

ap_document(d,p) :- pp_run(), pp_doc(d,p), pp_fact_present(d).
pp_report(p,l,code,message,p,l,code,0,ordinal,rank,0) :- pp_run(), ap_issue(c,p,code,message,0,rank), ap_call_doc(c,_,p), ap_call_line(c,l), ap_order(c,ordinal).
.violation AsyncPatternProductionFact(at:span,path:symbol,path_order:symbol,order0:number,order1:number,order2:number,f_path:symbol,f_line:number,f_code:symbol,f_message:symbol,f_context:symbol,f_is_fallback:number) code "DL_FACT" "async pattern production fact"
AsyncPatternProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),ordinal,rank,0,p,l,code,message,context,fallback) :- option("entryPoint","_production_contract"),ap_issue(c,p,code,message,fallback,rank),ap_call_doc(c,_,p),ap_call_line(c,l),ap_context(c,context),ap_order(c,ordinal).
ap_config("cli_schema","{\"description\": \"Lint for sync-in-async patterns\", \"arguments\": [{\"names\": [\"--check\"], \"kwargs\": {\"action\": \"store_true\", \"help\": \"Exit 1 if actionable violations found\"}}, {\"names\": [\"--summary\"], \"kwargs\": {\"action\": \"store_true\", \"help\": \"Show summary only\"}}, {\"names\": [\"--verbose\"], \"kwargs\": {\"action\": \"store_true\", \"help\": \"Show context for violations\"}}, {\"names\": [\"--actionable\"], \"kwargs\": {\"action\": \"store_true\", \"help\": \"Only show actionable violations (skip abstract class fallbacks)\"}}, {\"names\": [\"--update-baseline\"], \"kwargs\": {\"action\": \"store_true\", \"help\": \"Update ratchet baseline with current counts\"}}, {\"names\": [\"--sign\"], \"kwargs\": {\"action\": \"store_true\", \"help\": \"Sign baseline with NERA_SIGNING_KEY\"}}, {\"names\": [\"--reason\"], \"kwargs\": {\"type\": \"str\", \"default\": \"\", \"help\": \"Approval reason for baseline update\"}}, {\"names\": [\"--skip-signature-check\"], \"kwargs\": {\"action\": \"store_true\", \"help\": \"Skip baseline signature verification (remove once baseline is signed)\"}}, {\"names\": [\"--require-baseline\"], \"kwargs\": {\"action\": \"store_true\", \"help\": \"Require an existing ratchet baseline in CI mode\"}}, {\"names\": [\"--root\"], \"kwargs\": {\"type\": \"str\", \"default\": null, \"help\": \"Project root directory to scan (default: data layer repo root)\"}}, {\"names\": [\"--dirs\"], \"kwargs\": {\"type\": \"str\", \"nargs\": \"*\", \"default\": null, \"help\": \"Subdirectories under --root to scan (default: production roots for the detected layout)\"}}]}").
ap_config("api_transaction_files","[\"l2050_transaction/transaction.py\", \"l7200_versioned_transactions/versioned_transactions.py\", \"l2060_query_builder/query_builder.py\"]").
ap_config("collector_defaults","{\"violations\": [], \"current_class\": null, \"in_abstract_class\": false, \"in_async_write_txn\": false, \"in_async_read_txn\": false, \"in_async_function\": false, \"current_async_function_name\": null, \"async_txn_name_stack\": [], \"async_session_name_stack\": [], \"async_query_name_stack\": [], \"_class_state_stack\": [], \"_async_function_state_stack\": []}").
ap_config("constants","{\"VIOLATIONS\": {\"kind\": \"dict\", \"value\": {\"ASYNC001\": \"Use native async instead of to_thread() in impl/\", \"ASYNC002\": \"Use native async instead of run_in_executor() in impl/\", \"ASYNC003\": \"Abstract method may need async partner\", \"ASYNC004\": \"Sync method called in async transaction - use async version\", \"ASYNC005\": \"Sync I/O method called in async function - needs async implementation\", \"ASYNC006\": \"Sync transaction method called in async function\", \"ASYNC007\": \"Sync connection method called in async function - use async version\", \"ASYNC008\": \"Sync polymorphic metadata helper called in async function\"}}, \"SYNC_WRITE_METHODS\": {\"kind\": \"dict\", \"value\": {\"insert\": \"insert_async\", \"insert_many\": \"insert_many_async\", \"update\": \"update_async\", \"update_many\": \"update_many_async\", \"delete_by_id\": \"delete_by_id_async\", \"delete_many\": \"delete_many_async\", \"delete_returning\": \"delete_returning_async\", \"delete_many_returning\": \"delete_many_returning_async\", \"delete_by_key_many\": \"delete_by_key_many_async\", \"upsert\": \"upsert_async\", \"upsert_many\": \"upsert_many_async\", \"commit\": \"commit_async\", \"rollback\": \"rollback_async\"}}, \"SYNC_READ_METHODS\": {\"kind\": \"dict\", \"value\": {\"select_one\": \"select_one_async\", \"execute\": \"execute_async\", \"execute_one\": \"execute_one_async\", \"count\": \"count_async\", \"exists\": \"exists_async\", \"first\": \"first_async\"}}, \"SYNC_INTERNAL_IO_METHODS\": {\"kind\": \"dict\", \"value\": {\"_execute_sql\": \"_execute_sql_async\", \"_fetchone\": \"_fetchone_async\", \"_fetchall\": \"_fetchall_async\", \"raw_execute\": \"raw_execute_async\", \"_execute_template_with_params\": \"_execute_template_with_params_async\", \"nonportably_execute_sql\": \"nonportably_execute_sql_async\"}}, \"SYNC_CONNECTION_METHODS\": {\"kind\": \"dict\", \"value\": {\"read\": \"read_async\", \"write\": \"write_async\"}}, \"SYNC_POLYMORPHIC_METADATA_METHODS\": {\"kind\": \"dict\", \"value\": {\"ensure_dynamic_polymorphic_metadata\": \"ensure_dynamic_polymorphic_metadata_async\", \"register_polymorphic_metadata_for_schema_update\": \"register_polymorphic_metadata_for_schema_update_async\"}}, \"ALL_SYNC_TRANSACTION_METHODS\": {\"kind\": \"dict\", \"value\": {\"insert\": \"insert_async\", \"insert_many\": \"insert_many_async\", \"update\": \"update_async\", \"update_many\": \"update_many_async\", \"delete_by_id\": \"delete_by_id_async\", \"delete_many\": \"delete_many_async\", \"delete_returning\": \"delete_returning_async\", \"delete_many_returning\": \"delete_many_returning_async\", \"delete_by_key_many\": \"delete_by_key_many_async\", \"upsert\": \"upsert_async\", \"upsert_many\": \"upsert_many_async\", \"commit\": \"commit_async\", \"rollback\": \"rollback_async\", \"select_one\": \"select_one_async\", \"execute\": \"execute_async\", \"execute_one\": \"execute_one_async\", \"count\": \"count_async\", \"exists\": \"exists_async\", \"first\": \"first_async\", \"execute_raw\": \"execute_raw_async\", \"fetchone_raw\": \"fetchone_raw_async\", \"fetchall_raw\": \"fetchall_raw_async\", \"search\": \"search_async\", \"commit_branch\": \"commit_branch_async\", \"get_history\": \"get_history_async\", \"get_branch_tip\": \"get_branch_tip_async\", \"select_at_revision\": \"select_at_revision_async\"}}, \"SCAN_PATHS\": {\"kind\": \"list\", \"value\": [\"impl/sqlite\", \"impl/postgres\", \"impl/mariadb\", \"impl/doltdb\", \"impl/mongodb\", \"impl/neo4j\", \"impl/common\", \"api\", \"conform\"]}, \"EXCLUDE_PATTERNS\": {\"kind\": \"list\", \"value\": [\"tests/\", \"test_\", \"__pycache__\"]}, \"TRANSACTION_PARAM_NAMES\": {\"kind\": \"frozenset\", \"value\": [\"rtxn\", \"tx\", \"txn\", \"vrtxn\", \"vtxn\", \"wtxn\"]}, \"TRANSACTION_TYPE_NAMES\": {\"kind\": \"frozenset\", \"value\": [\"LazyVersionedReadTransaction\", \"LazyVersionedWriteTransaction\", \"ReadTransaction\", \"WriteTransaction\"]}, \"QUERY_SOURCE_METHODS\": {\"kind\": \"frozenset\", \"value\": [\"cross_branch\", \"query\", \"select_at_revision\"]}, \"SOURCE_TRIGGERS\": {\"kind\": \"tuple\", \"value\": [\"async def\", \"to_thread\", \"run_in_executor\"]}}").
ap_config("extractor","{\"extractor_id\": \"async_patterns.violations\", \"schema_version\": \"1\", \"implementation_version\": \"async-patterns-v2\", \"parser_mode\": \"ast_collect\", \"source_triggers\": [\"async def\", \"to_thread\", \"run_in_executor\"], \"source_trigger_groups\": [], \"cacheable\": true, \"workload_scope\": \"file\", \"project_input_facts\": [], \"project_input_scope\": null, \"implementation_digest\": \"9a9b44db2ff7128a\", \"node_kinds\": [\"ClassDef\", \"AsyncFunctionDef\", \"FunctionDef\", \"Lambda\", \"Assign\", \"AnnAssign\", \"Call\"]}").
ap_config("scope","{\"directories\": [\"impl/sqlite\", \"impl/postgres\", \"impl/mariadb\", \"impl/doltdb\", \"impl/mongodb\", \"impl/neo4j\", \"impl/common\", \"api\", \"conform\"], \"explicit_files\": [], \"include_tests\": true, \"broad_repo_scope\": false}").
ap_config("plugin","{\"name\": \"async_patterns\", \"enforcement\": \"hard-fail\", \"description\": \"Sync-in-async fallback patterns must not appear in actionable code\"}").
