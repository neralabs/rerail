.policy "data-layer-impl-direct-execution" revision 1
.description "Direct database execution outside ServerPlan"
.language python
.mode warn
.scope include "**/*.py"
// Source: https://github.com/neralabs/nera-data-layer/blob/2b1504adc4291daaf080b2e932962b134da1a69a/scripts/lint_impl_direct_execution.py
#include "python/ast.rr"
#include "project.rr"
#include "data-layer/impl-direct-settings.rr"

.violation IdeSetting(at: span, setting: symbol, ordinal: number, value: symbol) code "IDE_SETTING" "{setting}"
IdeSetting(@place("",0),"allowed_file",i,p) :- option("entryPoint","configuration"), ide_allowed_file(p), i = count : { ide_allowed_file(q), q < p }.
IdeSetting(@place("",0),"allowed_dir_pattern",i,p) :- option("entryPoint","configuration"), ide_directory_pattern(i,p).
IdeSetting(@place("",0),"direct_pattern",i,p) :- option("entryPoint","configuration"), ide_pattern(i,p,_).
IdeSetting(@place("",0),"fts_pattern",i,p) :- option("entryPoint","configuration"), ide_pattern(i,p,_), i < 2.
IdeSetting(@place("",0),"signature",0,p) :- option("entryPoint","configuration"), ide_allowlist_signature(p).

.decl ide_allowed(path: symbol)
ide_allowed(p) :- option("argumentPath",p), ide_allowed_file(p).
ide_allowed(p) :- option("argumentPath",p), ide_allowed_file(a), suffix(cat("/",a),p).
ide_allowed(p) :- ide_doc(_,p), ide_allowed_file(p).
ide_allowed(p) :- ide_doc(_,p), ide_allowed_file(a), suffix(cat("/",a),p).
.decl ide_path(path: symbol)
ide_path(p) :- option("argumentPath",p).
ide_path(p) :- ide_doc(_,p).
.violation IdeBool(at: span, value: number) code "IDE_BOOL" "allowlist result"
IdeBool(@place("",0),1) :- option("entryPoint","is_allowed_file"), option("argumentPath",p), ide_allowed(p).
IdeBool(@place("",0),0) :- option("entryPoint","is_allowed_file"), option("argumentPath",p), !ide_allowed(p).

// Discovery consumes every caller root in one request family. Path.rglob does not prune test directories.
.decl ide_walk(request: symbol, path: symbol)
ide_walk(key,p) :- env(key,p), prefix("ide.scan.",key).
ide_walk(key,cat(path,"/",name)) :- ide_walk(key,path), dir_entry(path,name,1), dir_metadata(path,name,_,0,_).
.decl ide_request(ordinal: number, path: symbol)
ide_request(to_number(@slice(key,9,strlen(key))),cat(path,"/",name)) :- ide_walk(key,path), dir_entry(path,name,0), suffix(".py",name).
.decl ide_file(path: symbol)
ide_file(path) :- ide_request(_,path).
#include "data-layer/plugin-discovery.rr"
.decl ide_production_root(name: symbol)
ide_production_root(name) :- !env("ide.api","true"), dir_entry(".",name,1), (name = "impl" ; name = "data_layer" ; name = "_internal" ; match_all("\\Al\\d{4}_.+",name)).
pfd_root(name) :- ide_production_root(name).
ide_file(path) :- pfd_file(path).
load(path,cat("impl-direct:",path),"python") :- ide_file(path).
.decl ide_target(path: symbol, canonical: symbol)
ide_target(p,c) :- ide_file(p), loaded(c,cat("impl-direct:",p),"python").
.decl ide_document_candidate(canonical: symbol, d: number)
ide_document_candidate(c,d) :- ide_target(_,c), doc(d,c,_), doc_role(d,"primary").
ide_document_candidate(c,d) :- ide_target(p,c), doc(d,p,_), doc_role(d,"primary").
ide_document_candidate(c,d) :- ide_target(p,c), workspace_root(root), doc(d,relative,_), doc_role(d,"primary"), p = cat(root,"/",relative).
.decl ide_physical_doc(canonical: symbol, d: number)
ide_physical_doc(c,d) :- ide_document_candidate(c,d), d = min other : { ide_document_candidate(c,other) }.
.decl ide_doc(d: number, path: symbol)
ide_doc(d,p) :- option("argumentPath",p), doc(d,"input.py",_), doc_role(d,"primary"), !syntax_error(d,_,_).
ide_doc(d,p) :- ide_target(p,c), ide_physical_doc(c,d), !syntax_error(d,_,_).
.decl ide_result_request(ordinal: number, path: symbol)
ide_result_request(0,p) :- option("argumentPath",p).
ide_result_request(i,p) :- ide_request(i,p).
ide_result_request(0,p) :- pfd_file(p).

.decl ide_fts(path: symbol)
ide_fts(path) :- ide_doc(_,path), match_all("(^|/)impl/[^/]+/fts/.*\\.py$",path).
.decl ide_entry_allowed(path: symbol)
ide_entry_allowed(path) :- ide_doc(_,path), !option("entryPoint",_).
ide_entry_allowed(path) :- ide_doc(_,path), option("entryPoint",entry), entry != "scan_fts_manager_direct_execution", entry != "scan_fts_manager_source".
ide_entry_allowed(path) :- ide_fts(path).
.decl ide_trigger(value: symbol)
ide_trigger("_execute_direct_internal"). ide_trigger("_fetchone"). ide_trigger("_fetchall").
ide_trigger("fetchone("). ide_trigger("fetchall("). ide_trigger("execute_grammar_fetch").
.decl ide_argument_gate()
ide_argument_gate() :- !option("entryPoint","scan_source").
ide_argument_gate() :- option("callSource",s), ide_trigger(t), contains(t,s).
.decl ide_selected(d: number, path: symbol)
ide_selected(d,p) :- ide_doc(d,p), ide_entry_allowed(p), ide_argument_gate(), source(d,sp), text(sp,s), ide_trigger(t), contains(t,s).
.decl ide_active(d: number, path: symbol, priority: number, pattern: symbol, attribute: symbol)
ide_active(d,p,i,pattern,attribute) :- ide_selected(d,p), !ide_allowed(p), ide_pattern(i,pattern,attribute).
ide_active(d,p,i,pattern,attribute) :- ide_selected(d,p), ide_fts(p), ide_pattern(i,pattern,attribute), i < 2.

// Mask the native lexical ranges that Python tokenize masks. Interpolated expressions remain visible.
.decl ide_ignored(n: node)
ide_ignored(n) :- ide_selected(d,_), docof(n,d), kind(n,"comment").
ide_ignored(n) :- ide_selected(d,_), docof(n,d), kind(n,"string"), !fstring(n).
ide_ignored(n) :- ide_selected(d,_), docof(n,d), kind(n,"string_content").
.decl ide_ignored_end(n: node, end: span)
ide_ignored_end(n,e) :- ide_ignored(n), match_all("(?s).*?(?<e>\\z)",n).
.decl ide_raw_match(d: number, path: symbol, at: span, priority: number)
.decl ide_masked(at: span)
ide_masked(m) :- ide_raw_match(d,_,m,_), !ide_has_extra(d), ide_ignored(n), docof(n,d), line(m,l), col(m,c), line(n,a), col(n,b), ide_ignored_end(n,e), line(e,z), col(e,q),
    (l > a ; l = a, c >= b), (l < z ; l = z, c < q).

// Text scanning numbers str.splitlines(), independently of AST's physical line coordinates.
.decl ide_extra(d: number, separator: span)
ide_extra(d,s) :- ide_selected(d,_), src_line(d,_,sp), match_all("(?<s>[\\x0b\\x0c\\x1c-\\x1e\\x85\\x{2028}\\x{2029}])",sp).
.decl ide_has_extra(d: number)
ide_has_extra(d) :- ide_extra(d,_).
.decl ide_text_line(at: span, line: number)
ide_text_line(m,l+extra) :- ide_raw_match(d,_,m,_), line(m,l), col(m,c),
    extra = count : { ide_extra(d,s), line(s,a), col(s,b), (a < l ; a = l, b < c) }.

// tokenize's spans use physical lines and character columns. The source then
// applies them to splitlines() lines. Preserve that mismatch too. Only files
// with extra split boundaries need character-coordinate preparation.
.decl ide_point(at: loc)
ide_point(m) :- ide_raw_match(d,_,m,_), ide_has_extra(d).
ide_point(n) :- ide_ignored(n), docof(n,d), ide_has_extra(d).
ide_point(e) :- ide_ignored_end(n,e), docof(n,d), ide_has_extra(d).
ide_point(s) :- ide_extra(_,s).
.decl ide_point_line(d: number, line: number)
ide_point_line(d,l) :- ide_point(p), docof(p,d), line(p,l).
.decl ide_character(d: number, line: number, byte_column: number)
ide_character(d,l,b) :- ide_point_line(d,l), src_line(d,l,sp), match_all("(?<character>(?s:.))",sp), col(character,b).
.decl ide_character_col(at: loc, column: number)
ide_character_col(p,c) :- ide_point(p), docof(p,d), line(p,l), col(p,b), c = count : { ide_character(d,l,a), a < b }.
.decl ide_last_separator(at: span, separator: span)
ide_last_separator(m,s) :- ide_raw_match(d,_,m,_), line(m,l), col(m,c), ide_extra(d,s), line(s,l), col(s,b), b < c,
    b = max a : { ide_extra(d,t), line(t,l), col(t,a), a < c }.
.decl ide_text_column(at: span, column: number)
ide_text_column(m,c) :- ide_raw_match(d,_,m,_), ide_character_col(m,c), !ide_last_separator(m,_).
ide_text_column(m,c-a-1) :- ide_last_separator(m,s), ide_character_col(m,c), ide_character_col(s,a).
ide_masked(m) :- ide_raw_match(d,_,m,_), ide_has_extra(d), ide_text_line(m,l), ide_text_column(m,c), text(m,raw),
    ide_ignored(n), docof(n,d), line(n,a), ide_character_col(n,b), ide_ignored_end(n,e), line(e,z), ide_character_col(e,q),
    (l > a ; l = a, c+strlen(raw) > b), (l < z ; l = z, c < q).
.decl ide_text_event(d: number, path: symbol, line: number, priority: number)
ide_text_event(d,p,l,i) :- ide_raw_match(d,p,m,i), !ide_masked(m), ide_text_line(m,l), ide_line(d,l,trimmed), !prefix("#",trimmed).
.decl ide_text_choice(d: number, path: symbol, line: number, priority: number)
ide_text_choice(d,p,l,i) :- ide_text_event(d,p,l,i), i = min j : { ide_text_event(d,p,l,j) }.

// AST calls fill lines missed by the text pass, in native Python traversal order.
.decl ide_ast_event(d: number, path: symbol, line: number, priority: number, visit: number)
ide_ast_event(d,p,l,i,v) :- ide_active(d,p,i,_,attribute), docof(c,d), kind(c,"call"), field(c,"function",raw), unparen(raw,f), kind(f,"attribute"), field(f,"attribute",a), text(a,name), @nfkc(name) = attribute, line(c,l), visit_index(c,v).
.decl ide_ast_choice(d: number, path: symbol, line: number, priority: number, visit: number)
ide_ast_choice(d,p,l,i,v) :- ide_ast_event(d,p,l,i,v), !ide_text_choice(d,p,l,_), v = min w : { ide_ast_event(d,p,l,_,w) }.
.decl ide_event(d: number, path: symbol, phase: number, ordinal: number, line: number, pattern: symbol)
ide_event(d,p,0,l,l,pattern) :- ide_text_choice(d,p,l,i), ide_pattern(i,pattern,_).
ide_event(d,p,1,v,l,pattern) :- ide_ast_choice(d,p,l,i,v), ide_pattern(i,pattern,_).
.decl ide_output_path(path: symbol, output: symbol)
ide_output_path(p,@slice(p,strlen(root)+1,strlen(p))) :- ide_doc(_,p), option("projectRoot",root), prefix(cat(root,"/"),p).
ide_output_path(p,p) :- ide_doc(_,p), option("projectRoot",root), !prefix(cat(root,"/"),p).
ide_output_path(p,p) :- ide_doc(_,p), !option("projectRoot",_).
.decl ide_line(d: number, line: number, value: symbol)
ide_line(d,l,@replace_all(raw,"\\A[\\x09-\\x0d\\x1c-\\x20\\x85\\xa0\\x{1680}\\x{2000}-\\x{200a}\\x{2028}\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+|[\\x09-\\x0d\\x1c-\\x20\\x85\\xa0\\x{1680}\\x{2000}-\\x{200a}\\x{2028}\\x{2029}\\x{202f}\\x{205f}\\x{3000}]+\\z","")) :- ide_selected(d,_), split_line(d,l,raw).
.violation IdeRow(at: span, request_order: number, file_order: symbol, phase: number, ordinal: number, file: symbol, line_num: number, line: symbol, pattern: symbol) code "IDE_ROW" "{pattern}: {line}"
IdeRow(@place(p,l),request,@replace_all(p,"/","\u0000"),phase,i,output,l,text,pattern) :- option("entryPoint",_), ide_doc(d,p), ide_result_request(request,p), ide_event(d,p,phase,i,l,pattern), ide_output_path(p,output), ide_line(d,l,text).
.violation IdeFile(at: span, path: symbol, path_order: symbol) code "IDE_FILE" "{path}"
IdeFile(@place("",0),p,@replace_all(p,"/","\u0000")) :- option("entryPoint","_production_facts"), pfd_file(p).
.violation IdeFinding(at: span, pattern: symbol, snippet: symbol) code "direct_execution" "{pattern}: {snippet}"
.severity IdeFinding error
IdeFinding(@place(output,l),pattern,@slice(text,0,70)) :- !option("entryPoint",_), ide_event(d,p,_,_,l,pattern), ide_output_path(p,output), ide_line(d,l,text).

// CLI discovery, verification and formatting use typed batches. The frontend only performs requested I/O.
#include "data-layer/signing.rr"
allow_sig("ide",name,sig) :- option("entryPoint","_verify_allowlist"), option("linterName",name), option("signature",sig).
allow_entry("ide",entry) :- option("entryPoint","_verify_allowlist"), option_item("allowlistEntries",_,entry).
.violation IdeVerification(at: span, value: number, stderr: symbol) code "IDE_VERIFY" "verification result"
IdeVerification(@place("",0),1,"") :- option("entryPoint","_verify_allowlist"), allow_status("ide","valid").
IdeVerification(@place("",0),0,cat("FAIL: WARNING: Allowlist for ",name," is ",label,". Sign with --sign-allowlist.\n")) :- option("entryPoint","_verify_allowlist"), allow_sig("ide",name,sig), allow_status("ide","unsigned"), (sig = "NEEDS_SIGNING", label = "needs signing" ; sig != "NEEDS_SIGNING", label = "unsigned").
IdeVerification(@place("",0),0,cat("FAIL: Allowlist signature verification failed for ",name,": ",detail,"\n")) :- option("entryPoint","_verify_allowlist"), allow_sig("ide",name,sig), allow_status("ide","invalid"), allow_message("ide",message), nera_key(key), detail = @ed25519_error(key,message,sig).

.decl ide_cli_root(name: symbol, priority: number)
ide_cli_root("impl",0) :- env("ide.cli.root",root), dir_entry(root,"impl",1).
ide_cli_root("data_layer",1) :- env("ide.cli.root",root), dir_entry(root,"data_layer",1).
ide_cli_root("_internal",2) :- env("ide.cli.root",root), dir_entry(root,"_internal",1).
ide_cli_root(name,3) :- env("ide.cli.root",root), dir_entry(root,name,1), match_all("\\Al\\d{4}_.+",name).
.violation IdeDirectory(at: span, priority: number, path: symbol) code "IDE_DIRECTORY" "{path}"
IdeDirectory(@place("",0),priority,name) :- ide_cli_root(name,priority).

.decl ide_cli_row(index: number, path: symbol, line: symbol, text: symbol)
ide_cli_row(i,p,l,s) :- option("entryPoint","_cli_format"), option_item("reportPaths",i,p), option_item("reportLines",i,l), option_item("reportTexts",i,s).
.decl ide_cli_file(path: symbol, display: symbol, order: symbol)
ide_cli_file(p,relative,@replace_all(p,"/","\u0000")) :- ide_cli_row(_,p,_,_), option("projectRoot",root), prefix(cat(root,"/"),p), relative = @slice(p,strlen(root)+1,strlen(p)).
ide_cli_file(p,p,@replace_all(p,"/","\u0000")) :- ide_cli_row(_,p,_,_), option("projectRoot",root), !prefix(cat(root,"/"),p).
.violation IdeCliOutput(at: span, phase: number, path_order: symbol, ordinal: number, text: symbol) code "IDE_OUTPUT" "{text}"
IdeCliOutput(@place("",0),0,"",0,"\nDirect execution allowlist failed signature verification.\nIf the changes are legitimate, sign with:\n  uv run python scripts/lint_impl_direct_execution.py --sign-allowlist\n") :- option("entryPoint","_cli_signature_failure").
IdeCliOutput(@place("",0),0,"",0,cat("Error: impl/ directory not found and no production directories found under ",root,"\n")) :- option("entryPoint","_cli_missing"), option("projectRoot",root).
IdeCliOutput(@place("",0),0,"",0,"No direct execution violations found.\n") :- option("entryPoint","_cli_format"), !ide_cli_row(_,_,_,_).
IdeCliOutput(@place("",0),0,"",0,cat("======================================================================\nDIRECT EXECUTION VIOLATIONS: ",to_string(n),"\n======================================================================\n\n")) :- option("entryPoint","_cli_format"), ide_cli_row(_,_,_,_), n = count : { ide_cli_row(_,_,_,_) }.
IdeCliOutput(@place("",0),1,order,0,cat(display,": ",to_string(n)," violation(s)\n")) :- ide_cli_file(p,display,order), n = count : { ide_cli_row(_,p,_,_) }.
IdeCliOutput(@place("",0),1,order,i+1,cat("  ",line,": ",@slice(text,0,70),"\n")) :- option("cliVerbose","1"), ide_cli_file(p,_,order), ide_cli_row(i,p,line,text).
IdeCliOutput(@place("",0),1,order,n+2,"\n") :- option("cliVerbose","1"), ide_cli_file(p,_,order), n = max i : { ide_cli_row(i,p,_,_) }.
IdeCliOutput(@place("",0),2,"",0,"\n----------------------------------------------------------------------\nThese locations call _fetchone()/_fetchall() directly.\nThey should route through ServerPlan for consistent batching.\n\nTo fix:\n  1. Use query builder .execute() which auto-delegates to ServerPlan\n  2. Use txn.plan() context for explicit batching\n  3. If infrastructure code, use conn.plan() with DDL_EXECUTE\n----------------------------------------------------------------------\n") :- option("entryPoint","_cli_format"), ide_cli_row(_,_,_,_).
.violation IdeCliExit(at: span, status: number, count: number) code "IDE_EXIT" "status"
IdeCliExit(@place("",0),1,0) :- option("entryPoint",entry), (entry = "_cli_missing" ; entry = "_cli_signature_failure").
IdeCliExit(@place("",0),0,n) :- option("entryPoint","_cli_format"), n = count : { ide_cli_row(_,_,_,_) }.

allow_sig("ide-signing","lint_impl_direct_execution","UNSIGNED") :- option("entryPoint","_sign_request").
allow_entry("ide-signing",value) :- option("entryPoint","_sign_request"), option_item("allowlistEntries",_,value).
.violation IdeSignRequest(at: span, request_id: symbol, key_env: symbol, message: symbol) code "IDE_SIGN_REQUEST" "Signing request"
IdeSignRequest(@place("",0),"impl_direct_execution.signing","NERA_SIGNING_KEY",message) :- option("entryPoint","_sign_request"), allow_message("ide-signing",message).

.violation IdeSignResult(at: span, status: number, write_file: number, updated_source: symbol, stdout: symbol, stderr: symbol) code "IDE_SIGN_RESULT" "Signing result"
IdeSignResult(@place("",0),1,0,"","","ERROR: NERA_SIGNING_KEY environment variable not set.\nOnly the user may have access to NERA_SIGNING_KEY. Ask the user to run the documented `uv run ... --sign-allowlist` command in an environment where the key is already present.\nAI agents must never have access to this proof-of-human key and must never try to obtain it.\n") :- option("entryPoint","_sign_error"), option("signStatus","missing-key").
IdeSignResult(@place("",0),1,0,"","","ERROR: NERA_SIGNING_KEY must be 32 bytes\n") :- option("entryPoint","_sign_error"), option("signStatus","key-length").
IdeSignResult(@place("",0),1,0,"","",cat("ERROR: Failed to decode NERA_SIGNING_KEY: ",detail,"\n")) :- option("entryPoint","_sign_error"), option("signStatus","invalid-hex"), option("signDetail",detail).

// CPython's Unicode 15.1 str whitespace includes U+001C..U+001F in addition
// to Unicode White_Space. Match the source's re.MULTILINE replacement exactly.
.decl ide_signs_pattern(pattern: symbol)
ide_signs_pattern(cat("(?m)^(_ALLOWED_FILES_SIGNATURE(?:",space,"*:",space,"*str)?",space,"*=",space,"*)(?:\"[^\"]*\"|NEEDS_SIGNING|UNSIGNED)(.*)")) :- space = "[\\t\\n\\v\\f\\r \\x1c-\\x1f\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]".
.decl ide_signs_matched()
ide_signs_matched() :- option("entryPoint","_sign_update"), option("scriptSource",source), ide_signs_pattern(pattern), @count_matches(pattern,source) > 0.
IdeSignResult(@place("",0),0,1,@replace_all(source,pattern,cat("${1}\"",signature,"\"${2}")),cat("Updated _ALLOWED_FILES_SIGNATURE in ",path,"\n"),"") :- option("entryPoint","_sign_update"), option("scriptSource",source), option("newSignature",signature), option("scriptPath",path), ide_signs_pattern(pattern), ide_signs_matched().
IdeSignResult(@place("",0),1,0,"","",cat("ERROR: Could not find _ALLOWED_FILES_SIGNATURE in ",path,"\n")) :- option("entryPoint","_sign_update"), option("scriptPath",path), !ide_signs_matched().
