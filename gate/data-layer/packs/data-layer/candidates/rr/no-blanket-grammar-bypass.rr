.decl bypass_sql_target(p: symbol)
bypass_sql_target(p) :- option("sqlConnectionFile", p).
bypass_sql_target("impl/common/l2200_sql_dialect/sql_connection.py") :- !option("sqlConnectionFile", _).
// API scopes include every transported file; production uses the source root and test rules.
.decl bypass_selected(d: number)
bypass_selected(d) :- pp_doc(d,_), pp_api().
.decl bypass_scan(d: number, p: symbol, l: number, t: symbol)
bypass_scan(d, p, l, t) :- pp_doc(d,p), bypass_selected(d), split_line(d, l, t), !bypass_allowed(p), !match("(?s)[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*#.*", t).

.violation BypassConstant(at: span, ordinal: number, collector_order0: number, collector_order1: number, collector_order2: number) code "NGB001" "_ALLOW_DIRECT_EXECUTION reference"
ppe_BypassConstant(p,l,0,l,0,0) :- bypass_scan(_, p, l, t), contains("_ALLOW_DIRECT_EXECUTION", t),
    !option("entryPoint", "check_no_public_grammar_methods").
.violation BypassArgument(at: span, ordinal: number, collector_order0: number, collector_order1: number, collector_order2: number) code "NGB001" "allow_direct_execution reference"
ppe_BypassArgument(p,l,0,l,1,1) :- bypass_scan(_, p, l, t),
    contains("allow_direct_execution", @replace_all(t, "#.*\\z", "")),
    !option("entryPoint", "check_no_public_grammar_methods").
.decl bypass_method_trigger(d: number)
bypass_method_trigger(d) :- split_line(d, _, t),
    (contains("execute_grammar", t) ; contains("_ALLOW_DIRECT_EXECUTION", t) ; contains("allow_direct_execution", t)).
.violation BypassPublic(at: node, name: symbol, ordinal: number, collector_order0: number, collector_order1: number, collector_order2: number) code "NGB001" "public method {name}() still exists"
ppe_BypassPublic(ppe_path,ppe_line,1,ppe_method_order,0,n,2,f) :- pp_doc(d,p), bypass_selected(d), bypass_sql_target(p), bypass_method_trigger(d),
    docof(f, d), kind(f, "function_definition"), def_name(f, n), bypass_public_name(n), !syntax_error(d, _, _),
    !option("entryPoint", "check_no_bypass_references"), docof(f,ppe_doc), pp_doc(ppe_doc,ppe_path), line(f,ppe_line), visit_index(f,ppe_method_order).

.violation BypassMissing(at: span) code "NGB001" "file not found"
BypassMissing(@place(p, 0)) :- option("entryPoint", "check_no_public_grammar_methods"), bypass_sql_target(p), !file(p).

