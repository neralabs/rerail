.decl pp_report_excluded(path: symbol)
.decl ppe_BypassConstant(path: symbol, line: number, event0: number, event1: number, event2: number, ordinal: number)
BypassConstant(@place(p,l),ordinal,o0,o1,o2) :- ppe_BypassConstant(p,l,o0,o1,o2,ordinal), pp_api().
BypassConstant(@place(p,l),ordinal,o0,o1,o2) :- ppe_BypassConstant(p,l,o0,o1,o2,ordinal), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
pp_report(p,l,"NGB001","_ALLOW_DIRECT_EXECUTION reference",p,l,"_ALLOW_DIRECT_EXECUTION reference",0,o0,o1,o2) :- ppe_BypassConstant(p,l,o0,o1,o2,ordinal), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
.violation ProductionFact(at: span, path: symbol, path_order: symbol, order0: number, order1: number, order2: number, f_file_path: symbol, f_line: number, f_message: symbol) code "DL_FACT" "production fact"
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,p,l,"_ALLOW_DIRECT_EXECUTION reference") :- ppe_BypassConstant(p,l,o0,o1,o2,ordinal), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).
.decl ppe_BypassArgument(path: symbol, line: number, event0: number, event1: number, event2: number, ordinal: number)
BypassArgument(@place(p,l),ordinal,o0,o1,o2) :- ppe_BypassArgument(p,l,o0,o1,o2,ordinal), pp_api().
BypassArgument(@place(p,l),ordinal,o0,o1,o2) :- ppe_BypassArgument(p,l,o0,o1,o2,ordinal), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
pp_report(p,l,"NGB001","allow_direct_execution reference",p,l,"allow_direct_execution reference",0,o0,o1,o2) :- ppe_BypassArgument(p,l,o0,o1,o2,ordinal), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,p,l,"allow_direct_execution reference") :- ppe_BypassArgument(p,l,o0,o1,o2,ordinal), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).
.decl ppe_BypassPublic(path: symbol, line: number, event0: number, event1: number, event2: number, name: symbol, ordinal: number, anchor: node)
BypassPublic(anchor,name,ordinal,o0,o1,o2) :- ppe_BypassPublic(p,l,o0,o1,o2,name,ordinal,anchor), pp_api().
BypassPublic(@place(p,l),name,ordinal,o0,o1,o2) :- ppe_BypassPublic(p,l,o0,o1,o2,name,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
pp_report(p,l,"NGB001",cat("public method ",name,"() still exists"),p,l,cat("public method ",name,"() still exists"),0,o0,o1,o2) :- ppe_BypassPublic(p,l,o0,o1,o2,name,ordinal,anchor), pp_run(), pp_fact_allowed(p), pp_report_allowed(p).
ProductionFact(@place(p,l),p,@replace_all(p,"/","\u0000"),o0,o1,o2,p,l,cat("public method ",name,"() still exists")) :- ppe_BypassPublic(p,l,o0,o1,o2,name,ordinal,anchor), option("entryPoint","_production_contract"), pp_fact_allowed(p), pp_absolute(p,full).

