.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl name(n: node, s: sym)
.input doc, node, field, text, name
.kindset k0 = "if_statement"
.decl in_scope(d: int)
.decl m13(n: node)
.decl m18(n: node)
.decl m26(n: node)
.decl m28(n: node)
.decl m33(n: node)
.decl m41(n: node)
.decl m43(n: node)
.decl m48(n: node)
.decl m5(n: node)
.decl m56(n: node)
.decl out_scope(d: int)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "api/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "conform/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
m5($n) :- inside($n, $v2, k0), node(_, $v2, "if_statement", _, _), field($v2, "condition", $v3), node(_, $v3, "identifier", _, _), text($v3, $v4), $v4 = "TYPE_CHECKING".
m13($n) :- field($n, "module_name", $v6), name($v6, $v8), @prefix($v8, "impl.").
m13($n) :- field($n, "name", $v9), name($v9, $v11), @prefix($v11, "impl.").
m13($n) :- node(_, $n, "dotted_name", _, _), text($n, $v12), @prefix($v12, "impl.").
m18($n) :- inside($n, $v15, k0), node(_, $v15, "if_statement", _, _), field($v15, "condition", $v16), node(_, $v16, "identifier", _, _), text($v16, $v17), $v17 = "TYPE_CHECKING".
m26($n) :- field($n, "module_name", $v19), name($v19, $v21), @prefix($v21, "impl.").
m26($n) :- field($n, "name", $v22), name($v22, $v24), @prefix($v24, "impl.").
m26($n) :- node(_, $n, "dotted_name", _, _), text($n, $v25), @prefix($v25, "impl.").
m28($n) :- node(_, $n, "dotted_name", _, _).
m28($n) :- node(_, $n, "aliased_import", _, _), field($n, "name", $v27).
m33($n) :- inside($n, $v30, k0), node(_, $v30, "if_statement", _, _), field($v30, "condition", $v31), node(_, $v31, "identifier", _, _), text($v31, $v32), $v32 = "TYPE_CHECKING".
m41($n) :- field($n, "module_name", $v34), name($v34, $v36), @prefix($v36, "impl.").
m41($n) :- field($n, "name", $v37), name($v37, $v39), @prefix($v39, "impl.").
m41($n) :- node(_, $n, "dotted_name", _, _), text($n, $v40), @prefix($v40, "impl.").
m43($n) :- node(_, $n, "dotted_name", _, _).
m43($n) :- node(_, $n, "aliased_import", _, _), field($n, "name", $v42).
m48($n) :- inside($n, $v45, k0), node(_, $v45, "if_statement", _, _), field($v45, "condition", $v46), node(_, $v46, "identifier", _, _), text($v46, $v47), $v47 = "TYPE_CHECKING".
m56($n) :- field($n, "module_name", $v49), name($v49, $v51), @prefix($v51, "impl.").
m56($n) :- field($n, "name", $v52), name($v52, $v54), @prefix($v54, "impl.").
m56($n) :- node(_, $n, "dotted_name", _, _), text($n, $v55), @prefix($v55, "impl.").
.output violation
