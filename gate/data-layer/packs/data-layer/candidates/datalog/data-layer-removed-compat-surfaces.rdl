.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl name(n: node, s: sym)
.decl line(n: node, l: int)
.decl syntax_error(d: int)
.input doc, node, child, field, text, name, line, syntax_error
.kindset k0 = "global_statement" | "import_from_statement" | "import_statement" | "nonlocal_statement"
.decl in_scope(d: int)
.decl m10(n: node)
.decl m20(n: node)
.decl m7(n: node)
.decl out_scope(d: int)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "data_layer/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l4100_queue/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l4400_scheduler/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l4250_timers/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l4300_timers/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l4350_timer_driver/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l7000_versioned_schema/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
m7($n) :- node(_, $n, "function_definition", _, _), field($n, "name", $v1), name($v1, $v3), $v3 in {"AdvisoryLockCoordinator", "ApplicationTickProvider", "ApplyClaimedTimersConfig", "ClaimDueTimersConfig", "CypherLeaseCoordinator", "FileLockCoordinator", "LeaseDocumentCoordinator", "RowLockCoordinator", "SchedulerTick", "SupersedeTimerConfig", "TickCoordinator", "TimerClaim", "TimerScanConfig", "_apply_claimed_timers_runtime", "_claim_due_timers_runtime", "_claimed_queue_prefix_rows_query_spec", "_claimed_queue_rows_query_spec", "_coalesce_branch_tip_materialization_alias", "_reconcile_due_timers_runtime", "_recover_abandoned_timer_claims_runtime", "_schedule_timer_runtime", "_supersede_timer_runtime", "apply_claimed_timers", "apply_claimed_timers_async", "apply_timer_driver_claims", "apply_timer_driver_claims_async", "claim_due_timer", "claim_due_timer_async", "claim_due_timers", "claim_due_timers_async", "claim_local_timer_responsibilities", "claim_local_timer_responsibilities_async", "dispatch_due_jobs", "dispatch_due_jobs_lazy", "recover_abandoned_timer_claims", "recover_abandoned_timer_claims_async"}.
m7($n) :- node(_, $n, "class_definition", _, _), field($n, "name", $v4), name($v4, $v6), $v6 in {"AdvisoryLockCoordinator", "ApplicationTickProvider", "ApplyClaimedTimersConfig", "ClaimDueTimersConfig", "CypherLeaseCoordinator", "FileLockCoordinator", "LeaseDocumentCoordinator", "RowLockCoordinator", "SchedulerTick", "SupersedeTimerConfig", "TickCoordinator", "TimerClaim", "TimerScanConfig", "_apply_claimed_timers_runtime", "_claim_due_timers_runtime", "_claimed_queue_prefix_rows_query_spec", "_claimed_queue_rows_query_spec", "_coalesce_branch_tip_materialization_alias", "_reconcile_due_timers_runtime", "_recover_abandoned_timer_claims_runtime", "_schedule_timer_runtime", "_supersede_timer_runtime", "apply_claimed_timers", "apply_claimed_timers_async", "apply_timer_driver_claims", "apply_timer_driver_claims_async", "claim_due_timer", "claim_due_timer_async", "claim_due_timers", "claim_due_timers_async", "claim_local_timer_responsibilities", "claim_local_timer_responsibilities_async", "dispatch_due_jobs", "dispatch_due_jobs_lazy", "recover_abandoned_timer_claims", "recover_abandoned_timer_claims_async"}.
violation("data-layer-removed-compat-surfaces", "definitions", "RCS001", $p, $l) :- m7($n), node($d, $n, _, _, _), in_scope($d), !syntax_error($d), !out_scope($d), doc($d, $p, _), line($n, $l).
m10($n) :- node(_, $n, "import_statement", _, _).
m10($n) :- node(_, $n, "import_from_statement", _, _).
m10($n) :- node(_, $n, "global_statement", _, _).
m10($n) :- node(_, $n, "nonlocal_statement", _, _).
m20($n) :- inside($n, $v9, k0), m10($v9).
m20($n) :- field($v11, "name", $n), node(_, $v11, "function_definition", _, _).
m20($n) :- field($v12, "name", $n), node(_, $v12, "class_definition", _, _).
m20($n) :- field($v13, "name", $n), node(_, $v13, "keyword_argument", _, _).
m20($n) :- field($v14, "attribute", $n), node(_, $v14, "attribute", _, _).
m20($n) :- child($v15, $n, _), node(_, $v15, "parameters", _, _).
m20($n) :- child($v16, $n, _), node(_, $v16, "lambda_parameters", _, _).
m20($n) :- field($v17, "name", $n), node(_, $v17, "default_parameter", _, _).
m20($n) :- field($v18, "name", $n), node(_, $v18, "typed_default_parameter", _, _).
m20($n) :- child($v19, $n, _), node(_, $v19, "typed_parameter", _, _).
violation("data-layer-removed-compat-surfaces", "names", "RCS001", $p, $l) :- node(_, $n, "identifier", _, _), text($n, $v8), $v8 in {"AdvisoryLockCoordinator", "ApplicationTickProvider", "ApplyClaimedTimersConfig", "ClaimDueTimersConfig", "CypherLeaseCoordinator", "FileLockCoordinator", "LeaseDocumentCoordinator", "RowLockCoordinator", "SchedulerTick", "SupersedeTimerConfig", "TickCoordinator", "TimerClaim", "TimerScanConfig", "_apply_claimed_timers_runtime", "_claim_due_timers_runtime", "_claimed_queue_prefix_rows_query_spec", "_claimed_queue_rows_query_spec", "_coalesce_branch_tip_materialization_alias", "_reconcile_due_timers_runtime", "_recover_abandoned_timer_claims_runtime", "_schedule_timer_runtime", "_supersede_timer_runtime", "apply_claimed_timers", "apply_claimed_timers_async", "apply_timer_driver_claims", "apply_timer_driver_claims_async", "claim_due_timer", "claim_due_timer_async", "claim_due_timers", "claim_due_timers_async", "claim_local_timer_responsibilities", "claim_local_timer_responsibilities_async", "dispatch_due_jobs", "dispatch_due_jobs_lazy", "recover_abandoned_timer_claims", "recover_abandoned_timer_claims_async"}, !m20($n), node($d, $n, _, _, _), in_scope($d), !syntax_error($d), !out_scope($d), doc($d, $p, _), line($n, $l).
violation("data-layer-removed-compat-surfaces", "attributes", "RCS001", $p, $l) :- node(_, $n, "attribute", _, _), field($n, "attribute", $v21), node(_, $v21, "identifier", _, _), text($v21, $v22), $v22 in {"AdvisoryLockCoordinator", "ApplicationTickProvider", "ApplyClaimedTimersConfig", "ClaimDueTimersConfig", "CypherLeaseCoordinator", "FileLockCoordinator", "LeaseDocumentCoordinator", "RowLockCoordinator", "SchedulerTick", "SupersedeTimerConfig", "TickCoordinator", "TimerClaim", "TimerScanConfig", "_apply_claimed_timers_runtime", "_claim_due_timers_runtime", "_claimed_queue_prefix_rows_query_spec", "_claimed_queue_rows_query_spec", "_coalesce_branch_tip_materialization_alias", "_reconcile_due_timers_runtime", "_recover_abandoned_timer_claims_runtime", "_schedule_timer_runtime", "_supersede_timer_runtime", "apply_claimed_timers", "apply_claimed_timers_async", "apply_timer_driver_claims", "apply_timer_driver_claims_async", "claim_due_timer", "claim_due_timer_async", "claim_due_timers", "claim_due_timers_async", "claim_local_timer_responsibilities", "claim_local_timer_responsibilities_async", "dispatch_due_jobs", "dispatch_due_jobs_lazy", "recover_abandoned_timer_claims", "recover_abandoned_timer_claims_async"}, node($d, $n, _, _, _), in_scope($d), !syntax_error($d), !out_scope($d), doc($d, $p, _), line($n, $l).
.output violation
