in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("api/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l[0-9][0-9][0-9][0-9]_*/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/conform/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.pytest_cache/**", p).
out_scope(d) :- doc(d, p, _), glob("**/node_modules/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/browser_build/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test_*.py", p).
tape_syntax_error(d) :- syntax_error(d).
eager_modname(d, m) :- doc(d, p, m), !suffix("/__init__.py", p).
eager_modname(d, x) :- doc(d, p, m), suffix("/__init__.py", p), x = @concat(m, ".__init__").
eager_serverplan(d) :- doc(d, p, _), (prefix("impl/common/l2070_server_plan/", p) ; prefix("impl/common/l7300_sql_versioned_transactions/", p) ; prefix("l2050_transaction/", p) ; prefix("l2055_lazy_result/", p) ; prefix("l2070_batching/", p) ; prefix("l5100_fts/", p) ; prefix("l5200_vector_index/", p) ; prefix("l7200_versioned_transactions/", p)).
eager_test_path(d) :- doc(d, p, _), match("(?:conform/|(?:.*/)?(?:tests|test_[^/]*)/).*", p).
eager_test_path(d) :- doc(d, p, _), match("(?:.*/)?test_[^/]*", p).
eager_decl(n, nm) :- node(_, n, "function_definition", _, _), field(n, "name", x), node_text(x, nm).
eager_decl(n, nm) :- node(_, n, "class_definition", _, _), field(n, "name", x), node_text(x, nm).
