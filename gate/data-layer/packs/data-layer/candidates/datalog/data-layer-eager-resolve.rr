eager_slot_ok(d, "__dict__") :- eager_serverplan(d).
eager_planning_shape(a) :- eager_battr(a, f), eager_attr(a, "deleted_state_value"), field(a, "object", o), node_text(o, ot), eager_asg_fn(x, f), eager_asg(x, t), node_text(t, ot), field(x, "type", ty), eager_ann_name(ty, "PlanningServerValueShape").
eager_raw(f, st, en, p, 1, tr) :- eager_battr(a, f), eager_attr(a, s), node(d, a, _, _, _), eager_slot_ok(d, s), eager_slot_trans(s, tr), !eager_planning_shape(a), eager_span(a, st, en), p = @concat("*.", s).
eager_slot_arg(c, s) :- eager_call_ident(c), eager_callee(c, cn), (cn = "getattr" ; cn = "hasattr"), eager_arg(c, a, 1), eager_str_at(a, s), eager_slot(s).
eager_slot_arg(c, s) :- eager_call_attr(c), eager_callee(c, "getattr_static"), node(d, c, _, _, _), eager_serverplan(d), eager_arg(c, a, 1), eager_str_at(a, s), eager_slot(s).
eager_slot_arg(c, s) :- eager_call_attr(c), eager_callee(c, "__getattribute__"), eager_arg(c, a, k), k = max j : { eager_arg(c, _, j) }, eager_str_at(a, s), eager_slot(s).
eager_raw(f, st, en, p, 1, tr) :- eager_bcall(c, f), eager_slot_arg(c, s), node(d, c, _, _, _), eager_slot_ok(d, s), eager_callee(c, cn), eager_slot_call_trans(cn, s, tr), eager_prefix(c, x), eager_span(c, st, en), p = @concat(@concat(@concat(@concat(x, cn), "("), s), ")").
eager_slot_call_trans(cn, s, 0) :- eager_slot_arg(c, s), eager_callee(c, cn), s = "_step_ref_id".
eager_slot_call_trans(cn, s, 0) :- eager_slot_arg(c, s), eager_callee(c, cn), s = "__dict__".
eager_slot_call_trans(cn, s, 0) :- eager_slot_arg(c, s), eager_callee(c, cn), cn = "getattr_static".
eager_slot_call_trans(cn, s, 1) :- eager_slot_arg(c, s), eager_callee(c, cn), s != "_step_ref_id", s != "__dict__", cn != "getattr_static".
eager_raw(f, st, en, p, 1, 1) :- eager_bcall(c, f), eager_kw(c, _, v), eager_attr(v, s), (s = "resolve" ; s = "resolve_async"), eager_span(c, st, en), p = @concat(@concat("*.", s), "<bound>").
eager_raw(f, st, en, p, 1, 1) :- eager_bcall(c, f), eager_arg(c, v, _), eager_attr(v, s), (s = "resolve" ; s = "resolve_async"), eager_span(c, st, en), p = @concat(@concat("*.", s), "<bound>").
eager_raw(f, st, en, p, 1, 1) :- eager_asg_fn(a, f), field(a, "right", v), eager_attr(v, s), (s = "resolve" ; s = "resolve_async"), eager_span(a, st, en), p = @concat(@concat("*.", s), "<bound>").
eager_raw(f, 0, 0, p, 0, 1) :- eager_legacy_call(f, _, nm), p = @concat(@concat("legacy-boundary-call:", nm), "()").
eager_raw(f, st, en, "plan-scope:*.execute()", 0, 1) :- eager_bcall(c, f), eager_scope_call(c), eager_span(c, st, en).
eager_root(e, e) :- eager_recv(_, e).
eager_root(e, y) :- eager_root(e, x), node(_, x, "attribute", _, _), field(x, "object", y).
eager_root(e, y) :- eager_root(e, x), node(_, x, "subscript", _, _), field(x, "value", y).
eager_root(e, y) :- eager_root(e, x), node(_, x, "call", _, _), field(x, "function", y).
eager_root(e, y) :- eager_root(e, x), node(_, x, "parenthesized_expression", _, _), child(x, y, 0).
eager_root(e, y) :- eager_root(e, x), node(_, x, "type", _, _), child(x, y, 0).
eager_root_name(e, nm) :- eager_root(e, x), node(_, x, "identifier", _, _), node_text(x, nm).
eager_txn_name(f, nm) :- eager_param(f, nm, _, _), nm = "txn".
eager_txn_name(f, nm) :- eager_param(f, nm, _, _), nm = "transaction".
eager_txn_name(f, nm) :- eager_param(f, nm, _, _), nm = "read_txn".
eager_txn_name(f, nm) :- eager_param(f, nm, _, _), nm = "write_txn".
eager_txn_name(f, nm) :- eager_param(f, nm, _, _), suffix("_txn", nm).
eager_txn_name(f, nm) :- eager_typed(f, nm, "Transaction").
eager_raw(f, st, en, p, 0, 1) :- eager_bcall(c, f), eager_call_attr(c), eager_callee(c, s), eager_nonlazy(s), eager_recv(c, r), eager_root_name(r, nm), eager_txn_name(f, nm), !eager_scope_call(c), eager_span(c, st, en), p = @concat(@concat("non-lazy-call:*.", s), "()").
eager_raw(f, st, en, p, 0, 1) :- eager_empty(c, f), eager_func(f, fnm), contains("callback", fnm), eager_call_attr(c), eager_callee(c, s), (s = "get" ; s = "get_async"), eager_recv(c, r), node(_, r, "identifier", _, _), node_text(r, rt), (rt = "lazy" ; rt = "lazy_row" ; rt = "lazy_value" ; rt = "result" ; rt = "row" ; rt = "value"), eager_span(c, st, en), p = @concat(@concat("callback-terminal:*.", s), "()").
eager_raw(f, st, en, p, 0, 1) :- eager_bcall(c, f), eager_call_ident(c), eager_callee(c, s), (s = "bool" ; s = "len" ; s = "list" ; s = "set" ; s = "sorted" ; s = "tuple"), eager_arg(c, a, 0), eager_lazy_expr(f, a), eager_span(c, st, en), p = @concat(@concat("lazy-python:", s), "(lazy)").
eager_raw(f, st, en, "lazy-python:lazy[...]", 0, 1) :- node(_, n, "subscript", st, en), child(n, x, 0), eager_lazy_expr(f, x).
eager_raw(f, st, en, "lazy-python:for lazy", 0, 1) :- node(_, n, "for_statement", st, en), field(n, "right", x), eager_lazy_expr(f, x).
eager_raw(f, st, en, "lazy-python:for lazy", 0, 1) :- node(_, n, "for_in_clause", st, en), field(n, "right", x), eager_lazy_expr(f, x).
eager_raw(f, st, en, "lazy-python:if lazy", 0, 1) :- node(_, n, "if_statement", st, en), field(n, "condition", x), node(_, x, "identifier", _, _), eager_lazy_expr(f, x).
eager_raw(f, st, en, "lazy-python:if lazy", 0, 1) :- node(_, n, "conditional_expression", st, en), field(n, "condition", x), node(_, x, "identifier", _, _), eager_lazy_expr(f, x).
eager_raw(f, st, en, "sql-derived-python:permission-check", 0, 1) :- eager_bcall(c, f), eager_callee(c, s), (s = "_has_permission" ; s = "_require_permission"), field(c, "arguments", g), node(_, g, _, gs, ge), eager_sql_expr(f, x), node(_, x, _, xs, xe), xs >= gs, xe <= ge, eager_span(c, st, en).
eager_raw(f, st, en, "permission-sql:direct-permission-expression", 0, 1) :- eager_bcall(c, f), eager_callee(c, "IN"), eager_arg(c, a0, 0), node(_, a0, "call", _, _), eager_callee(a0, "field"), eager_arg(a0, a1, 0), eager_attr(a1, s), (s = "required_metadata_read_permission" ; s = "required_read_permission" ; s = "required_resolve_permission" ; s = "required_write_permission"), node(d, c, _, _, _), doc(d, p, _), !prefix("l4000_permissions/", p), !suffix("permission_scheme.py", p), eager_span(c, st, en).
eager_legacy_wrapper_symbol(s) :- eager_symbol(_, s), prefix("l2050_transaction.legacy_wrappers.", s).
eager_resolve_exempt(s) :- eager_symbol(_, s), match("(?:impl\\.common\\.l2550_storage_backend\\.local_backend\\.|impl\\.l1570_llm_client\\.client\\.LLMClient\\._resolve_debug_dir|impl\\.sqlite\\.connection\\.SyncSqliteConnection\\.database_identity|l1000_schema\\.path_validation\\.|l1100_exceptions\\.safe_file_ops\\.|l8000_admin\\.tools\\.docs_search\\.|l8000_admin\\.tools\\.validation\\.|l8100_ops_analytics\\.connection\\.|l9600_graphs\\.dynamic_vector\\.resolve_dynamic_embedding_handler).*", s).
eager_approved_pattern(p) :- eager_raw(_, _, _, p, _, _), prefix("non-lazy-call:", p).
eager_seed_exempt(f, p) :- eager_raw(f, _, _, p, _, 1), (p = "_resolve_legacy_result_sync()" ; p = "_resolve_legacy_result_async()"), eager_canonical(f).
eager_seed_exempt(f, p) :- eager_raw(f, _, _, p, _, 1), eager_symbol(f, s), eager_legacy_wrapper_symbol(s).
eager_seed_exempt(f, "*.resolve()") :- eager_symbol(f, s), eager_resolve_exempt(s).
eager_seed_exempt(f, "*.result()") :- eager_symbol(f, s), eager_result_exempt(s).
eager_seed_exempt(f, p) :- eager_raw(f, _, _, p, _, 1), eager_approved_pattern(p), eager_symbol(f, s), eager_approved(s), eager_external_io(f).
eager_dirty(f, i) :- eager_raw(f, _, _, p, _, 1), eager_func(f, _), !eager_seed_exempt(f, p), i = @concat("transitive:", p).
eager_dirty(g, i) :- eager_dirty(f, i), eager_edge(g, f), eager_symbol(g, s), !eager_legacy_wrapper_symbol(s).
eager_transitive_exempt(f, i) :- eager_dirty(f, i), node(d, f, _, _, _), doc(d, p, _), (p = "l2055_lazy_result/lazy_result.py" ; p = "l2055_lazy_result/lazy_seq.py"), eager_symbol(f, s), eager_lazy_core(s).
eager_transitive_exempt(f, i) :- eager_dirty(f, i), node(d, f, _, _, _), doc(d, "l2070_batching/server_ref.py", _), (i = "transitive:*._deleted_state_slot" ; i = "transitive:*._ref_id").
eager_transitive_exempt(f, "transitive:*._ref_id") :- eager_dirty(f, "transitive:*._ref_id"), node(d, f, _, _, _), doc(d, "l2070_batching/step.py", _), eager_symbol(f, s), prefix("l2070_batching.step.StepRef.", s).
eager_lazy_core(s) :- eager_symbol(_, s), match("(?:l2055_lazy_result\\.lazy_result\\.LazyFieldRef\\.|l2055_lazy_result\\.lazy_result\\.LazyResult\\.|l2055_lazy_result\\.lazy_seq\\.LazySeq\\.).*", s).
eager_transitive(d, l, i) :- eager_dirty(f, i), !eager_transitive_exempt(f, i), node(d, f, _, _, _), !eager_test_path(d), line(f, l).
eager_phase_pat(f, p) :- eager_raw(f, _, _, p, 1, _), eager_phase(f, _), !prefix("_resolve_legacy_result_", p).
eager_phase_span(f, p, st, en) :- eager_phase_pat(f, p), st = min s : { eager_raw(f, s, _, p, 1, _) }, en = min e : { eager_raw(f, _, e, p, 1, _) }.
eager_phase_site(d, l, i) :- eager_phase_span(f, p, st, en), eager_phase(f, ph), eager_func(f, _), node(d, f, _, _, _), node(d, n, "call", st, en), line(n, l), i = @concat(@concat(ph, ":"), p).
eager_phase_site(d, l, i) :- eager_phase_span(f, p, st, en), eager_phase(f, ph), eager_func(f, _), node(d, f, _, _, _), node(d, n, "attribute", st, en), line(n, l), i = @concat(@concat(ph, ":"), p).
eager_external(d, l, i) :- eager_external_io(f), eager_func(f, nm), node(d, f, _, _, _), line(f, l), i = @concat(@concat("external-io-boundary:", nm), "()").
eager_resolved_param(f) :- eager_param(f, "resolved", pos, p), pos >= 1, !node(_, p, "typed_default_parameter", _, _).
eager_preprocess(d, l, i) :- eager_bcall(c, f), eager_func(f, "preprocess"), eager_call_ident(c), eager_callee(c, s), (s = "resolve_lazy_param" ; s = "resolve_lazy_param_str" ; s = "resolve_server_value"), node(d, c, _, _, _), line(c, l), i = @concat(@concat("preprocess:", s), "()").
eager_preprocess(d, l, i) :- eager_bcall(c, f), eager_func(f, "preprocess"), eager_call_attr(c), eager_resolved_param(f), eager_callee(c, s), (s = "get" ; s = "peek" ; s = "resolve_server_ref"), eager_recv(c, r), node(_, r, "identifier", _, _), node_text(r, "resolved"), node(d, c, _, _, _), line(c, l), i = @concat(@concat("preprocess:resolved.", s), "()").
eager_preprocess(d, l, "preprocess:*.resolve(resolved)") :- eager_bcall(c, f), eager_func(f, "preprocess"), eager_call_attr(c), eager_resolved_param(f), eager_callee(c, "resolve"), eager_arg(c, a, _), node(_, a, "identifier", _, _), node_text(a, "resolved"), node(d, c, _, _, _), line(c, l).
eager_source_line(d, l, t) :- source(d, sp), match_group("(?m)^(?<LINE>[^\\n]*(?:\\.resolve\\(\\)|\\.resolve_async\\(\\)|\\.result\\(\\)|\\bint\\(\\s*lazy|\\bfloat\\(\\s*lazy|\\bbool\\(\\s*lazy)[^\\n]*)$", sp, _, "LINE", g), line(g, l), text(g, t).
eager_line_issue(d, l, ".resolve()") :- eager_source_line(d, l, s), match("(?s:.*)(?:\\.resolve\\(\\))(?s:.*)", s).
eager_line_issue(d, l, ".resolve_async()") :- eager_source_line(d, l, s), match("(?s:.*)(?:\\.resolve_async\\(\\))(?s:.*)", s).
eager_line_issue(d, l, ".result()") :- eager_source_line(d, l, s), match("(?s:.*)(?:\\.result\\(\\))(?s:.*)", s).
eager_line_issue(d, l, "int(lazy...)") :- eager_source_line(d, l, s), match("(?s:.*)(?:\\bint\\(\\s*lazy)(?s:.*)", s).
eager_line_issue(d, l, "float(lazy...)") :- eager_source_line(d, l, s), match("(?s:.*)(?:\\bfloat\\(\\s*lazy)(?s:.*)", s).
eager_line_issue(d, l, "bool(lazy...)") :- eager_source_line(d, l, s), match("(?s:.*)(?:\\bbool\\(\\s*lazy)(?s:.*)", s).
eager_comment_line(d, l) :- eager_line_issue(d, l, _), eager_source_line(d, l, s), match("\\s*#(?s:.*)", s).
eager_mlstr(d, a, b) :- node(d, s, "string", _, _), node_text(s, t), contains("\n", t), !match("(?s)[rRuUbB]*[fF].*", t), line(s, a), end_line(s, b).
eager_mlstr(d, a, b) :- node(d, s, "concatenated_string", _, _), node_text(s, t), contains("\n", t), !match("(?s)[rRuUbB]*[fF].*", t), line(s, a), end_line(s, b).
eager_in_mlstr(d, l) :- eager_line_issue(d, l, _), eager_mlstr(d, a, b), a <= l, l <= b.
eager_direct_site(d, l, i) :- eager_line_issue(d, l, i), !eager_comment_line(d, l), !eager_test_path(d), !eager_in_mlstr(d, l).
eager_cover(d, l, f, k, n) :- eager_direct_site(d, l, _), eager_func(f, _), node(d, f, _, _, _), line(f, a), end_line(f, b), a <= l, l <= b, eager_depth(f, k), node_text(f, t), n = @strlen(t).
eager_cover_depth(d, l, k) :- eager_cover(d, l, _, _, _), k = max j : { eager_cover(d, l, _, j, _) }.
eager_cover_len(d, l, n) :- eager_cover_depth(d, l, k), n = min m : { eager_cover(d, l, _, k, m) }.
eager_line_symbol(d, l, s) :- eager_cover_len(d, l, n), eager_cover_depth(d, l, k), eager_cover(d, l, f, k, n), eager_symbol(f, s).
eager_line_symbol(d, l, s) :- eager_direct_site(d, l, _), !eager_cover(d, l, _, _, _), eager_modname(d, m), s = @concat(m, "::<module>").
eager_direct_exempt(d, l, i) :- eager_direct_site(d, l, i), doc(d, p, _), (p = "l2055_lazy_result/lazy_result.py" ; p = "l2055_lazy_result/lazy_seq.py"), eager_line_symbol(d, l, s), eager_lazy_core(s).
eager_direct_exempt(d, l, ".resolve()") :- eager_direct_site(d, l, ".resolve()"), doc(d, "l2055_lazy_result/lazy_result.py", _), eager_line_symbol(d, l, "l2055_lazy_result.lazy_result.LazyResult.result").
eager_direct_exempt(d, l, ".resolve()") :- eager_direct_site(d, l, ".resolve()"), eager_line_symbol(d, l, s), eager_resolve_exempt(s).
eager_direct_exempt(d, l, ".result()") :- eager_direct_site(d, l, ".result()"), eager_line_symbol(d, l, s), eager_result_exempt(s).
eager_direct_exempt(d, l, i) :- eager_direct_site(d, l, i), (i = ".resolve()" ; i = ".resolve_async()" ; i = ".result()"), eager_line_symbol(d, l, s), eager_approved(s).
eager_direct_exempt(d, l, ".resolve()") :- eager_direct_site(d, l, ".resolve()"), eager_source_line(d, l, s), contains("ResolveVersionedForeignKeyTargetIntent(", s).
eager_direct(d, l, i) :- eager_direct_site(d, l, i), !eager_direct_exempt(d, l, i).
eager_entry_case(1) :- option_value("entryPoint", e), eager_entry(e).
eager_finding(d, l, i) :- eager_transitive(d, l, i), !eager_entry_case(1).
eager_finding(d, l, i) :- eager_transitive(d, l, i), option_value("entryPoint", "_scan_transitive_eager_ast").
eager_finding(d, l, i) :- eager_phase_site(d, l, i), !eager_entry_case(1).
eager_finding(d, l, i) :- eager_phase_site(d, l, i), option_value("entryPoint", "_scan_lower_compile_ast"), (prefix("lower:", i) ; prefix("compile:", i)).
eager_finding(d, l, i) :- eager_external(d, l, i), !eager_entry_case(1).
eager_finding(d, l, i) :- eager_external(d, l, i), option_value("entryPoint", "_scan_external_io_boundary_definition_ast").
eager_finding(d, l, i) :- eager_preprocess(d, l, i), !eager_entry_case(1).
eager_finding(d, l, i) :- eager_preprocess(d, l, i), option_value("entryPoint", "_scan_preprocess_ast").
eager_finding(d, l, i) :- eager_direct(d, l, i), !eager_entry_case(1).
violation("data-layer-eager-resolve", "eager-resolution", i, p, l) :- eager_finding(d, l, i), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _).
