in_scope(d) :- doc(d, p, _), glob("l2070_batching/post_op.py", p).
in_scope(d) :- doc(d, p, _), glob("l2070_batching/post_op_specs.py", p).
in_scope(d) :- doc(d, p, _), glob("l2070_batching/post_op_domain_decoders.py", p).
in_scope(d) :- doc(d, p, _), glob("l2070_batching/post_op_allowlist.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/conform/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.pytest_cache/**", p).
out_scope(d) :- doc(d, p, _), glob("**/node_modules/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/browser_build/**", p).
ss_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d).
ss_top(n) :- child(m, n, _), node(_, m, "module", _, _).
ss_top(n) :- child(dd, n, _), node(_, dd, "decorated_definition", _, _), child(m, dd, _), node(_, m, "module", _, _).
ss_top_assign(a) :- node(_, a, "assignment", _, _), child(es, a, _), node(_, es, "expression_statement", _, _), child(m, es, _), node(_, m, "module", _, _).
ss_assign_to(a, x) :- node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x).
ss_fn(d, f, x, s, e) :- node(d, f, "function_definition", s, e), ss_doc(d, _), ss_top(f), field(f, "name", nm), text(nm, x).
ss_fn_def(f) :- ss_fn(_, f, _, _, _), !op(f, "async").
ss_fn_first(d, f, x, s, e) :- ss_fn(d, f, x, s, e), s = min t : { ss_fn(d, _, x, t, _) }.
ss_member(d, c, x) :- ss_assign_to(a, x), node(d, a, _, _, _), ss_doc(d, _), inside(a, k, ss_class_k), ss_top(k), field(k, "name", cn), text(cn, c).
ss_dataclass_decorator(dec) :- node(_, dec, "decorator", _, _), child(dec, i, _), node(_, i, "identifier", _, _), text(i, "dataclass").
ss_dataclass_decorator(dec) :- node(_, dec, "decorator", _, _), child(dec, c, _), node(_, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, "dataclass").
ss_spec(d, x) :- node(d, k, "class_definition", _, _), ss_doc(d, _), ss_top(k), field(k, "name", cn), text(cn, x), suffix("Spec", x), child(dd, k, _), node(_, dd, "decorated_definition", _, _), child(dd, dec, _), ss_dataclass_decorator(dec).
ss_strnode(d, n, s, e) :- node(d, n, "string", s, e), ss_doc(d, _), strprefix(n, p), match("[ru]*", p).
ss_strnode(d, n, s, e) :- node(d, n, "concatenated_string", s, e), ss_doc(d, _), child(n, f, 0), strprefix(f, p), match("[ru]*", p).
ss_val(n, v) :- ss_strnode(_, n, _, _), value(n, v).
ss_val(n, "") :- ss_strnode(_, n, _, _), !value(n, _).
ss_string(d, n, s, e, v) :- ss_strnode(d, n, s, e), ss_val(n, v).
ss_registry_node(d, n) :- ss_strnode(d, n, _, _), inside(n, a, ss_assign_k), ss_assign_to(a, "SIGNED_POST_OP_SYMBOLS"), ss_top_assign(a).
ss_registry(d, n, v) :- ss_registry_node(d, n), ss_val(n, v).
ss_signature(d, n, s) :- ss_strnode(d, n, s, _), inside(n, a, ss_assign_k), ss_assign_to(a, "ALLOWLIST_SIGNATURE"), field(a, "type", _), ss_top_assign(a).
ss_ref_slot(n) :- field(p, "name", n), node(_, p, "function_definition", _, _).
ss_ref_slot(n) :- field(p, "name", n), node(_, p, "class_definition", _, _).
ss_ref_slot(n) :- field(p, "name", n), node(_, p, "keyword_argument", _, _).
ss_ref_slot(n) :- field(p, "attribute", n), node(_, p, "attribute", _, _).
ss_runtime_ref(d, n) :- node(d, n, "identifier", _, _), ss_doc(d, _), text(n, x), ss_ref_name(x), !inside(n, _, ss_import_k), !ss_ref_slot(n).
ss_runtime_ref(d, n) :- node(d, n, "attribute", _, _), ss_doc(d, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, x), ss_ref_name(x).
ss_runtime_ref(d, n) :- ss_string(d, n, _, _, v), ss_ref_name(v).
ss_flag(d) :- ss_assign_to(a, "ENFORCE_POST_OP_RUNTIME_ALLOWLIST"), ss_top_assign(a), node(d, a, _, _, _), ss_doc(d, _).
ss_verification(d, s, e, l) :- node(d, c, "call", s, e), ss_doc(d, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, x), ss_verify_name(x), line(c, l).
ss_verification(d, s, e, l) :- node(d, c, "call", s, e), ss_doc(d, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, x), ss_verify_name(x), line(c, l).
ss_return(d, s, e, l) :- node(d, r, "return_statement", s, e), ss_doc(d, _), line(r, l).
ss_override_rest(e, e) :- option_json("fateOverrides", _, e).
ss_override_rest(e, t) :- ss_override_rest(e, q), @strlen(q) > 0, @substr(q, 0, 1) != "=", t = @substr(q, 1, 1000000000).
ss_override(e, s, f) :- ss_override_rest(e, q), @substr(q, 0, 1) = "=", s = @substr(e, 0, @sub(@strlen(e), @strlen(q))), f = @substr(q, 1, 1000000000).
ss_override(e, "", e) :- ss_override_rest(e, "").
ss_override_sym(s) :- ss_override(_, s, _).
ss_ov_digits(p, ds) :- option_json("fateOverrides", p, _), @substr(p, 0, 1) = "/", ds = @substr(p, 1, 1000000000).
ss_ov_index(i, e) :- option_json("fateOverrides", p, e), ss_ov_digits(p, ds), @strlen(ds) = 1, ss_digit(ds, i).
ss_ov_index(i, e) :- option_json("fateOverrides", p, e), ss_ov_digits(p, ds), @strlen(ds) = 2, rr_t1 = @substr(ds, 0, 1), ss_digit(rr_t1, a), rr_t2 = @substr(ds, 1, 1), ss_digit(rr_t2, b), i = @add(@mul(a, 10), b).
ss_ov_index(i, e) :- option_json("fateOverrides", p, e), ss_ov_digits(p, ds), @strlen(ds) = 3, rr_t3 = @substr(ds, 0, 1), ss_digit(rr_t3, a), rr_t4 = @substr(ds, 1, 1), ss_digit(rr_t4, b), rr_t5 = @substr(ds, 2, 1), ss_digit(rr_t5, c), i = @add(@add(@mul(a, 100), @mul(b, 10)), c).
ss_ov_index(i, e) :- option_json("fateOverrides", p, e), ss_ov_digits(p, ds), @strlen(ds) = 4, rr_t6 = @substr(ds, 0, 1), ss_digit(rr_t6, a), rr_t7 = @substr(ds, 1, 1), ss_digit(rr_t7, b), rr_t8 = @substr(ds, 2, 1), ss_digit(rr_t8, c), rr_t9 = @substr(ds, 3, 1), ss_digit(rr_t9, x), i = @add(@add(@add(@mul(a, 1000), @mul(b, 100)), @mul(c, 10)), x).
ss_ov_index(i, e) :- option_json("fateOverrides", p, e), ss_ov_digits(p, ds), @strlen(ds) = 5, rr_t10 = @substr(ds, 0, 1), ss_digit(rr_t10, a), rr_t11 = @substr(ds, 1, 1), ss_digit(rr_t11, b), rr_t12 = @substr(ds, 2, 1), ss_digit(rr_t12, c), rr_t13 = @substr(ds, 3, 1), ss_digit(rr_t13, x), rr_t14 = @substr(ds, 4, 1), ss_digit(rr_t14, y), i = @add(@add(@add(@add(@mul(a, 10000), @mul(b, 1000)), @mul(c, 100)), @mul(x, 10)), y).
ss_ov_index(i, e) :- option_json("fateOverrides", p, e), ss_ov_digits(p, ds), @strlen(ds) = 6, rr_t15 = @substr(ds, 0, 1), ss_digit(rr_t15, a), rr_t16 = @substr(ds, 1, 1), ss_digit(rr_t16, b), rr_t17 = @substr(ds, 2, 1), ss_digit(rr_t17, c), rr_t18 = @substr(ds, 3, 1), ss_digit(rr_t18, x), rr_t19 = @substr(ds, 4, 1), ss_digit(rr_t19, y), rr_t20 = @substr(ds, 5, 1), ss_digit(rr_t20, z), i = @add(@add(@add(@add(@add(@mul(a, 100000), @mul(b, 10000)), @mul(c, 1000)), @mul(x, 100)), @mul(y, 10)), z).
ss_ov_at(i, s, f) :- ss_ov_index(i, e), ss_override(e, s, f).
ss_first_override(s, f) :- ss_ov_at(i, s, f), i = min j : { ss_ov_at(j, s, _) }.
ss_membership(@concat(c, @concat(".", x))) :- ss_member(d, c, x), ss_doc(d, p), (p = "l2070_batching/post_op.py" ; p = "l2070_batching/post_op_specs.py"), (c = "PostOpKind" ; c = "PostOpBehavior").
ss_fate(s, f) :- ss_membership(s), ss_first_override(s, f).
ss_fate(s, "audit_required") :- ss_membership(s), !ss_override_sym(s).
ss_fate_entry(@concat(s, @concat("=", f))) :- ss_fate(s, f).
ss_surface(@concat(c, @concat(".", x))) :- ss_member(d, c, x), ss_doc(d, "l2070_batching/post_op.py"), (c = "PostOpKind" ; c = "PostOpBehavior").
ss_surface(@concat(c, @concat(".", x))) :- ss_member(d, c, x), ss_doc(d, "l2070_batching/post_op_specs.py"), c = "DomainPostOpDecoderKind".
ss_surface(@concat("post_op_factory.", x)) :- ss_fn(d, f, x, _, _), ss_doc(d, "l2070_batching/post_op.py"), glob("*_post_op", x), ss_fn_def(f).
ss_surface(@concat("post_op_spec.", x)) :- ss_spec(d, x), ss_doc(d, "l2070_batching/post_op_specs.py").
rr_agg21(e, q) :- ss_fate_entry(e), q = @json_str(e).
ss_message("fates", @concat("{\"allowlist\":[", @concat(b, "],\"linter\":\"post_op_side_effects\",\"version\":1}"))) :- ss_unit(0), b = join q by (e) sep "," : { rr_agg21(e, q) }.
rr_agg22(e, q) :- ss_surface(e), q = @json_str(e).
ss_message("surface", @concat("{\"allowlist\":[", @concat(b, "],\"linter\":\"post_op_surface\",\"version\":1}"))) :- ss_unit(0), b = join q by (e) sep "," : { rr_agg22(e, q) }.
rr_agg23(n, q, v) :- ss_reg(n, v), q = @json_str(v).
ss_message("runtime", @concat("{\"allowlist\":[", @concat(b, "],\"linter\":\"post_op_runtime_allowlist\",\"version\":1}"))) :- ss_unit(0), b = join q by (v, n) sep "," : { rr_agg23(n, q, v) }.
ss_reachable(v) :- ss_string(d, _, s, e, v), ss_doc(d, "l2070_batching/post_op.py"), (prefix("assertion.", v) ; prefix("materializer.", v)), ss_fn_first(d, _, "post_op_runtime_symbol", fs, fe), fs < s, fe >= e.
ss_reachable(@concat("decoder.", @concat(c, @concat(".", x)))) :- ss_member(d, c, x), ss_doc(d, "l2070_batching/post_op_specs.py"), c = "DomainPostOpDecoderKind".
ss_reg(n, v) :- ss_registry(d, n, v), ss_doc(d, "l2070_batching/post_op_allowlist.py").
ss_reg_value(v) :- ss_reg(_, v).
ss_sig_start(m) :- ss_signature(d, _, _), ss_doc(d, "l2070_batching/post_op_allowlist.py"), m = min s : { ss_signature(d, _, s) }.
ss_sig_node(n) :- ss_sig_start(m), ss_signature(_, n, m), node(_, n, "concatenated_string", _, _).
ss_sig_node(n) :- ss_sig_start(m), ss_signature(_, n, m), node(_, n, "string", _, _), !ss_sig_concat_at(m).
ss_sig_concat_at(m) :- ss_sig_start(m), ss_signature(_, n, m), node(_, n, "concatenated_string", _, _).
ss_sig_value(s) :- ss_sig_node(n), ss_val(n, s).
ss_sig_value("") :- ss_unit(0), !ss_sig_start(_).
ss_signed_with("fates", c) :- option_value("fatesSignature", s), c = @rx_replace(s, "[^A-Za-z0-9+/=]", "").
ss_signed_with("surface", c) :- option_value("surfaceSignature", s), c = @rx_replace(s, "[^A-Za-z0-9+/=]", "").
ss_signed_with("runtime", c) :- ss_sig_value(s), c = @rx_replace(s, "[^A-Za-z0-9+/=]", "").
ss_verified(l) :- ss_message(l, m), ss_signed_with(l, s), ss_key(k), @ed25519_ok(k, m, s) = 1.
ss_fate_valid(0) :- ss_verified("fates").
ss_surface_valid(0) :- ss_verified("surface").
ss_runtime_valid(0) :- ss_verified("runtime").
ss_verifier(d, s, e) :- ss_fn_first(d, _, "assert_post_op_symbol_signed", s, e).
ss_verify_in(d, s, l) :- ss_verifier(d, s, e), ss_verification(d, vs, ve, l), vs >= s, ve <= e.
ss_verifier_first(d, s, l) :- ss_verify_in(d, s, _), l = min x : { ss_verify_in(d, s, x) }.
ss_bypass(d) :- ss_doc(d, _), ss_flag(d).
ss_bypass(d) :- ss_doc(d, _), !ss_verifier(d, _, _).
ss_bypass(d) :- ss_verifier(d, s, _), !ss_verifier_first(d, s, _).
ss_bypass(d) :- ss_verifier(d, s, e), ss_verifier_first(d, s, l), ss_return(d, rs, re, rl), rs >= s, re <= e, rl < l.
ss_entry(ep) :- option_value("entryPoint", ep).
ss_trusted(o, s, f) :- ss_override(o, s, f), ss_entry("_collect_violations").
ss_trusted(o, s, f) :- ss_override(o, s, f), ss_entry(ep), ep != "_collect_violations", ss_fate_valid(0).
ss_trusted_sym(s) :- ss_trusted(_, s, _).
ss_finding("POSTOP200") :- ss_runtime_ref(d, _), ss_doc(d, p), (p = "l2070_batching/post_op.py" ; p = "l2070_batching/post_op_specs.py" ; p = "l2070_batching/post_op_domain_decoders.py").
ss_finding("POSTOP203") :- ss_bypass(d), ss_doc(d, "l2070_batching/post_op_allowlist.py").
ss_finding("POSTOP204") :- ss_reg(_, v), !prefix("assertion.", v), !prefix("decoder.DomainPostOpDecoderKind.", v), !prefix("materializer.", v).
ss_finding("POSTOP204") :- ss_reg(_, v), ss_broad(v).
ss_finding("POSTOP205") :- ss_reachable(s), !ss_reg_value(s).
ss_finding("POSTOP206") :- ss_reg_value(v), !ss_reachable(v).
ss_finding("POSTOP202") :- ss_unit(0), !ss_runtime_valid(0).
ss_finding("POSTOP201") :- ss_unit(0), !ss_surface_valid(0).
ss_finding("POSTOP001") :- ss_trusted(_, s, _), !ss_membership(s).
ss_finding("POSTOP002") :- ss_membership(s), ss_trusted_sym(s), ss_first_override(s, f), ss_bad_fate(f).
ss_finding("POSTOP002") :- ss_membership(s), !ss_trusted_sym(s).
ss_any_finding(0) :- ss_finding(_).
violation("data-layer-post-op-side-effects", "signed-surface", c, "l2070_batching/post_op.py", 1) :- ss_entry(ep), !ss_case(ep), ss_finding(c).
violation("data-layer-post-op-side-effects", "signed-surface", "POSTOP000", "l2070_batching/post_op.py", 1) :- ss_entry(ep), !ss_case(ep), !ss_fate_valid(0), !ss_any_finding(0).
violation("data-layer-post-op-side-effects", "signed-surface", "POSTOP203", p, 1) :- ss_entry("_collect_runtime_allowlist_bypass_violations_from_tree"), ss_bypass(d), ss_doc(d, p).
violation("data-layer-post-op-side-effects", "signed-surface", c, "l2070_batching/post_op.py", 1) :- ss_entry("_collect_violations"), ss_finding(c).
violation("data-layer-post-op-side-effects", "signed-surface", "POSTOP204", "l2070_batching/post_op.py", 1) :- ss_entry("_collect_broad_runtime_authority_violations"), ss_finding("POSTOP204").
violation("data-layer-post-op-side-effects", "signed-surface", c, "l2070_batching/post_op.py", 1) :- ss_entry("_collect_exact_runtime_symbol_coverage_violations"), ss_finding(c), (c = "POSTOP205" ; c = "POSTOP206").
