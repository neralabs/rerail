tape_syntax_error(d) :- syntax_error(d).
comparison_classvar(n) :- node(_, n, "identifier", _, _), text(n, "ClassVar").
comparison_classvar(n) :- node(_, n, "attribute", _, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, "ClassVar").
comparison_get_origin(n) :- node(_, n, "identifier", _, _), text(n, "get_origin").
comparison_get_origin(n) :- node(_, n, "attribute", _, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, "get_origin").
comparison_compare(c) :- node(_, c, "comparison_operator", _, _), child(c, call, 0), node(_, call, "call", _, _), field(call, "function", f), comparison_get_origin(f), token(c, _, s, _, _), comparison_ops(s).
comparison_exempt(n) :- inside(n, f, comparison_defs), node_text(f, s), match("(?s:.*)(?:^def\\b)(?s:.*)", s), field(f, "name", nm), node(_, nm, "identifier", _, _), text(nm, "is_classvar_annotation").
violation("data-layer-classvar-check", "comparison", "CLASSVAR001", p, l) :- comparison_compare(c), child(c, x, _), comparison_classvar(x), prev_token(x, s), comparison_ops(s), !comparison_exempt(x), node(d, c, _, _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _), line(c, l).
