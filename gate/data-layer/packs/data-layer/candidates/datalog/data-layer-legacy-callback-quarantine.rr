t82(s) :- doc(_, s, _), (glob("**/.git", s) ; glob("**/.git/**", s) ; glob("**/.mypy_cache", s) ; glob("**/.mypy_cache/**", s) ; glob("**/.pytest_cache", s) ; glob("**/.pytest_cache/**", s) ; glob("**/.ruff_cache", s) ; glob("**/.ruff_cache/**", s) ; glob("**/.venv", s) ; glob("**/.venv/**", s) ; glob("**/__pycache__", s) ; glob("**/__pycache__/**", s) ; glob("**/tmp", s) ; glob("**/tmp/**", s)).
