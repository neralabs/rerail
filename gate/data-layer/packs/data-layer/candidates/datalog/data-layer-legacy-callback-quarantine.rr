m32(n) :- node(_, n, "function_definition", _, _), child(v19, n, _), node(_, v19, "decorated_definition", _, _), child(v19, v20, _), node(_, v20, "decorator", _, _), child(v20, v21, _), u22(v21).
m32(n) :- node(_, n, "decorated_definition", _, _), child(n, v28, _), node(_, v28, "function_definition", _, _), child(v29, v28, _), node(_, v29, "decorated_definition", _, _), child(v29, v30, _), node(_, v30, "decorator", _, _), child(v30, v31, _), u22(v31).
