violation("data-layer-legacy-callback-quarantine", "connection-definition", "LCB-030", p, l) :- node(v76, n, _, _, _), doc(v76, v77, _), !t78(v77), node(_, n, "function_definition", _, _), field(n, "name", v79), node(_, v79, "identifier", _, _), text(v79, v80), (v80 = "commit_branch" ; v80 = "commit_branch_async"), nearest(n, v81, k1), node(_, v81, "class_definition", _, _), field(v81, "name", v82), node(_, v82, "identifier", _, _), text(v82, v83), (suffix("Connection", v83) ; suffix("ConnectionCore", v83) ; suffix("DatabaseConnection", v83)), !m96(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
callback_call_receiver_name(n) :- node(_, n, "identifier", _, _), text(n, s), (iglob("conn", s) ; iglob("session_handle", s) ; iglob("version_handle", s) ; iglob("*session", s) ; iglob("*connection", s) ; iglob("*version", s)).
callback_call_receiver(n) :- callback_call_receiver_name(n).
callback_call_receiver(n) :- node(_, n, "attribute", _, _), field(n, "attribute", a), callback_call_receiver_name(a).
callback_call_receiver(n) :- node(_, n, "attribute", _, _), field(n, "object", o), callback_call_receiver(o).
callback_call_receiver(n) :- node(_, n, "call", _, _), field(n, "function", f), callback_call_receiver(f).
callback_call_receiver(n) :- node(_, n, "subscript", _, _), field(n, "value", v), callback_call_receiver(v).
callback_call_receiver(n) :- node(_, n, "parenthesized_expression", _, _), child(n, c, _), callback_call_receiver(c).
callback_call_decorator(n) :- node(_, n, "identifier", _, _), text(n, s), callback_call_decorator_name(s).
callback_call_decorator(n) :- node(_, n, "attribute", _, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, s), callback_call_decorator_name(s).
callback_call_decorator(n) :- node(_, n, "call", _, _), field(n, "function", f), callback_call_decorator(f).
callback_call_quarantine(w) :- node(_, w, "decorated_definition", _, _), child(w, f, _), node(_, f, "function_definition", _, _), child(w, k, _), node(_, k, "decorator", _, _), child(k, x, _), callback_call_decorator(x).
callback_call_site(c) :- node(_, c, "call", _, _), field(c, "function", a), node(_, a, "attribute", _, _), field(a, "attribute", m), node(_, m, "identifier", _, _), text(m, s), callback_call_method(s), field(a, "object", o), callback_call_receiver(o), field(c, "arguments", g), child(g, _, _).
callback_call_quarantined(c) :- callback_call_site(c), inside(c, w, callback_call_quarantine_kind), callback_call_quarantine(w).
callback_call_file_content(0) :- option_value("entryPoint", "scan_file_content").
callback_call_path_ok(p) :- doc(_, p, _), callback_call_file_content(0), match("(impl/|l|data_layer/|services/).*", p), !match("(.*/)?(tests|conform)(/.*)?", p).
callback_call_path_ok(p) :- doc(_, p, _), !callback_call_file_content(0), !match("(.*/)?(\\.git|\\.mypy_cache|\\.pytest_cache|\\.ruff_cache|\\.venv|__pycache__|tmp)(/.*)?", p).
violation("data-layer-legacy-callback-quarantine", "callback-call", "LCB-020", p, l) :- callback_call_site(c), !callback_call_quarantined(c), node(d, c, _, _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _), callback_call_path_ok(p), line(c, l).
