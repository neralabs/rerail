m28(n) :- node(_, n, "identifier", _, _), text(n, v24), (v24 = "direct_legacy_async" ; v24 = "direct_legacy_module_async" ; v24 = "direct_legacy_module_sync" ; v24 = "direct_legacy_sync" ; v24 = "legacy_async" ; v24 = "legacy_module_async" ; v24 = "legacy_module_sync" ; v24 = "legacy_sync").
