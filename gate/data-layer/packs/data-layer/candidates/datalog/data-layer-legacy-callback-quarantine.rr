m17(n) :- node(_, n, "call", _, _), field(n, "function", v14), u8(v14).
m17(n) :- node(_, n, "subscript", _, _), field(n, "value", v15), u8(v15).
m17(n) :- node(_, n, "parenthesized_expression", _, _), child(n, v16, _), u8(v16).
u8(n) :- m17(n).
m27(n) :- node(_, n, "identifier", _, _), text(n, v23), (v23 = "direct_legacy_async" ; v23 = "direct_legacy_module_async" ; v23 = "direct_legacy_module_sync" ; v23 = "direct_legacy_sync" ; v23 = "legacy_async" ; v23 = "legacy_module_async" ; v23 = "legacy_module_sync" ; v23 = "legacy_sync").
