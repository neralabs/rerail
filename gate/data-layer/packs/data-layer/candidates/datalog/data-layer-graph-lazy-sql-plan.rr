in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/versioned_lazy_mixin.py", p).
in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/versioned_transactions.py", p).
in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/graph_lazy_sql.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2070_server_plan/steps/intent_graph.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
tape_syntax_error(d) :- syntax_error(d).
kind(n, k) :- node(_, n, k, _, _).
tparam_list(o, l) :- kind(o, "function_definition"), field(o, "type_parameters", l).
tparam_list(o, l) :- kind(o, "class_definition"), field(o, "type_parameters", l).
tparam_list(o, l) :- kind(o, "type_alias_statement"), field(o, "left", t), kind(t, "generic_type"), g = t, child(g, l, _), kind(l, "type_parameter").
tparam_list(o, l) :- kind(o, "type_alias_statement"), field(o, "left", t), kind(t, "type"), child(t, g, 0), kind(g, "generic_type"), child(g, l, _), kind(l, "type_parameter").
tparam_item(l, i, p, -1) :- tparam_list(_, l), child(l, p, i), kind(p, "type").
tparam_item(l, i, p, d) :- tparam_list(_, l), child(l, e, i), kind(e, "type_default"), field(e, "name", p), field(e, "value", d).
tparam_shape(p, nm, "typevar", -1) :- tparam_item(_, _, p, _), child(p, nm, 0), kind(nm, "identifier").
tparam_shape(p, nm, "typevar", b) :- tparam_item(_, _, p, _), child(p, c, 0), kind(c, "constrained_type"), child(c, t, 0), child(t, nm, 0), kind(nm, "identifier"), child(c, b, 1).
tparam_shape(p, nm, "typevartuple", -1) :- tparam_item(_, _, p, _), child(p, s, 0), kind(s, "splat_type"), op(s, "*"), child(s, nm, 0).
tparam_shape(p, nm, "paramspec", -1) :- tparam_item(_, _, p, _), child(p, s, 0), kind(s, "splat_type"), op(s, "**"), child(s, nm, 0).
type_param(o, p, nm, i, k, b, d) :- tparam_list(o, l), tparam_item(l, i, p, d), tparam_shape(p, nm, k, b).
graph_plan_contracts_file(d, p) :- node(d, _, "module", _, _), in_scope(d), !tape_syntax_error(d), !cpython_syntax_error(d, _, _), !out_scope(d), doc(d, p, _).
graph_plan_contracts_nested(n) :- inside(n, _, graph_plan_contracts_defs).
graph_plan_contracts_in_fn(n) :- inside(n, _, graph_plan_contracts_fdef).
graph_plan_contracts_tclass(d, x, c, s) :- node(d, c, "class_definition", s, _), !graph_plan_contracts_nested(c), field(c, "name", nm), text(nm, x).
graph_plan_contracts_class(d, x, c) :- graph_plan_contracts_tclass(d, x, c, s), s = min t : { graph_plan_contracts_tclass(d, x, _, t) }.
graph_plan_contracts_has_class(d, x) :- graph_plan_contracts_tclass(d, x, _, _).
graph_plan_contracts_cand(d, o, x, f, s) :- node(d, f, "function_definition", s, _), !graph_plan_contracts_in_fn(f), nearest(f, c, graph_plan_contracts_cdef), graph_plan_contracts_tclass(d, o, c, _), field(f, "name", nm), text(nm, x).
graph_plan_contracts_method(d, o, x, f) :- graph_plan_contracts_cand(d, o, x, f, s), s = max t : { graph_plan_contracts_cand(d, o, x, _, t) }.
graph_plan_contracts_has_method(d, o, x) :- graph_plan_contracts_cand(d, o, x, _, _).
graph_plan_contracts_unparen(e, e) :- node(_, e, k, _, _), k != "parenthesized_expression".
graph_plan_contracts_unparen(e, m) :- node(_, e, "parenthesized_expression", _, _), child(e, i, 0), graph_plan_contracts_unparen(i, m).
graph_plan_contracts_ref(e, x) :- node(_, e, "identifier", _, _), text(e, x).
graph_plan_contracts_ref(e, x) :- node(_, e, "attribute", _, _), field(e, "attribute", a), text(a, x).
graph_plan_contracts_decorator(f, x) :- field(dd, "definition", f), child(dd, dc, _), node(_, dc, "decorator", _, _), child(dc, e0, 0), graph_plan_contracts_unparen(e0, e), !node(_, e, "call", _, _), graph_plan_contracts_ref(e, x).
graph_plan_contracts_decorator(f, x) :- field(dd, "definition", f), child(dd, dc, _), node(_, dc, "decorator", _, _), child(dc, e0, 0), graph_plan_contracts_unparen(e0, e), node(_, e, "call", _, _), field(e, "function", g0), graph_plan_contracts_unparen(g0, g), graph_plan_contracts_ref(g, x).
graph_plan_contracts_not_name(n) :- field(_, "name", n).
graph_plan_contracts_not_name(n) :- child(ps, n, _), node(_, ps, k, _, _), graph_plan_contracts_params(k).
graph_plan_contracts_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, n, 0).
graph_plan_contracts_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, s, 0), child(s, n, 0), node(_, s, "list_splat_pattern", _, _).
graph_plan_contracts_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, s, 0), child(s, n, 0), node(_, s, "dictionary_splat_pattern", _, _).
graph_plan_contracts_not_name(n) :- child(ps, s, _), node(_, ps, k, _, _), graph_plan_contracts_params(k), child(s, n, 0), node(_, s, "list_splat_pattern", _, _).
graph_plan_contracts_not_name(n) :- child(ps, s, _), node(_, ps, k, _, _), graph_plan_contracts_params(k), child(s, n, 0), node(_, s, "dictionary_splat_pattern", _, _).
graph_plan_contracts_not_name(n) :- node(_, n, "identifier", _, _), inside(n, _, graph_plan_contracts_imports).
graph_plan_contracts_not_name(n) :- node(_, g, "global_statement", _, _), child(g, n, _).
graph_plan_contracts_not_name(n) :- node(_, g, "nonlocal_statement", _, _), child(g, n, _).
graph_plan_contracts_not_name(n) :- node(_, x, "except_clause", _, _), child(x, ap, _), node(_, ap, "as_pattern", _, _), field(ap, "alias", t), child(t, n, _).
graph_plan_contracts_not_name(n) :- node(_, cp, "case_pattern", _, _), child(cp, dn, 0), node(_, dn, "dotted_name", _, _), child(dn, n, 0), !child(dn, _, 1).
graph_plan_contracts_not_name(n) :- node(_, cp, "case_pattern", _, _), child(cp, ap, 0), node(_, ap, "as_pattern", _, _), child(ap, n, 1), node(_, n, "identifier", _, _).
graph_plan_contracts_not_name(n) :- node(_, s, "splat_pattern", _, _), child(s, n, 0).
graph_plan_contracts_not_name(n) :- node(_, k, "keyword_pattern", _, _), child(k, n, 0).
graph_plan_contracts_not_name(n) :- node(_, k, "keyword_pattern", _, _), child(k, dn, 1), node(_, dn, "dotted_name", _, _), child(dn, n, 0), !child(dn, _, 1).
graph_plan_contracts_not_name(n) :- type_param(_, _, n, _, _, _, _).
graph_plan_contracts_named(d, i, x) :- node(d, i, "identifier", _, _), text(i, x), graph_plan_contracts_wanted(x), !graph_plan_contracts_not_name(i).
graph_plan_contracts_named(d, i, x) :- node(d, i, "identifier", _, _), text(i, x), graph_plan_contracts_wanted(x), field(a, "attribute", i), node(_, a, "attribute", _, _).
graph_plan_contracts_mention(f, x) :- graph_plan_contracts_named(_, i, x), inside(i, f, graph_plan_contracts_fdef).
graph_plan_contracts_mention(f, x) :- graph_plan_contracts_named(_, i, x), inside(i, dc, graph_plan_contracts_deco), child(dd, dc, _), field(dd, "definition", f).
graph_plan_contracts_topdef(d, x, s, "class", l) :- graph_plan_contracts_tclass(d, x, c, s), line(c, l).
graph_plan_contracts_topdef(d, x, s, "function", l) :- node(d, f, "function_definition", s, _), !graph_plan_contracts_nested(f), field(f, "name", nm), text(nm, x), line(f, l).
graph_plan_contracts_chain(a, a) :- node(_, a, "assignment", _, _), !field(a, "type", _), !graph_plan_contracts_inner(a).
graph_plan_contracts_chain(a, c) :- graph_plan_contracts_chain(a, b), field(b, "right", c), node(_, c, "assignment", _, _).
graph_plan_contracts_inner(a) :- node(_, b, "assignment", _, _), field(b, "right", a).
graph_plan_contracts_target(a, t) :- graph_plan_contracts_chain(a, b), field(b, "left", l), graph_plan_contracts_bare(l, t).
graph_plan_contracts_bare(l, l) :- node(_, l, "identifier", _, _).
graph_plan_contracts_bare(l, t) :- node(_, l, "tuple_pattern", _, _), child(l, c, 0), !child(l, _, 1), !token(l, _, ",", _, _), graph_plan_contracts_bare(c, t).
graph_plan_contracts_topdef(d, x, s, "assign", l) :- node(d, a, "assignment", s, _), !graph_plan_contracts_nested(a), graph_plan_contracts_target(a, t), text(t, x), line(a, l).
graph_plan_contracts_alias_name(o, i) :- node(_, o, "type_alias_statement", _, _), field(o, "left", t), node(_, t, "type", _, _), child(t, i, 0), node(_, i, "identifier", _, _).
graph_plan_contracts_alias_name(o, i) :- node(_, o, "type_alias_statement", _, _), field(o, "left", t), node(_, t, "type", _, _), child(t, g, 0), node(_, g, "generic_type", _, _), child(g, i, 0), node(_, i, "identifier", _, _).
graph_plan_contracts_alias_name(o, i) :- node(_, o, "type_alias_statement", _, _), field(o, "left", g), node(_, g, "generic_type", _, _), child(g, i, 0), node(_, i, "identifier", _, _).
graph_plan_contracts_topdef(d, x, s, "typealias", l) :- node(d, o, "type_alias_statement", s, _), !graph_plan_contracts_nested(o), graph_plan_contracts_alias_name(o, i), text(i, x), line(o, l).
graph_plan_contracts_symbol(d, x, k, l) :- graph_plan_contracts_topdef(d, x, s, k, l), s = max t : { graph_plan_contracts_topdef(d, x, t, _, _) }.
graph_plan_contracts_has_def(d, x) :- graph_plan_contracts_symbol(d, x, k, _), graph_plan_contracts_defkind(k).
graph_plan_contracts_hit(c, code, p, 1) :- graph_plan_contracts_req_class(c, p, x, code), graph_plan_contracts_file(d, p), !graph_plan_contracts_has_class(d, x).
graph_plan_contracts_hit(c, code, p, 1) :- graph_plan_contracts_req_symbol(c, p, x, code), graph_plan_contracts_file(d, p), !graph_plan_contracts_has_def(d, x).
graph_plan_contracts_hit(c, code, p, l) :- graph_plan_contracts_banned(c, p, x, "def", need, code), graph_plan_contracts_file(d, p), graph_plan_contracts_symbol(d, x, k, l), graph_plan_contracts_defkind(k), graph_plan_contracts_has_class(d, need).
graph_plan_contracts_hit(c, code, p, l) :- graph_plan_contracts_banned(c, p, x, "any", "", code), graph_plan_contracts_file(d, p), graph_plan_contracts_symbol(d, x, _, l).
graph_plan_contracts_hit(c, code, p, l) :- graph_plan_contracts_req_method(c, p, o, x, code), graph_plan_contracts_file(d, p), graph_plan_contracts_class(d, o, k), !graph_plan_contracts_has_method(d, o, x), line(k, l).
graph_plan_contracts_hit(c, code, p, l) :- graph_plan_contracts_req_deco(c, p, o, x, y, code), graph_plan_contracts_file(d, p), graph_plan_contracts_method(d, o, x, f), !graph_plan_contracts_decorator(f, y), line(f, l).
graph_plan_contracts_alias(y, y) :- graph_plan_contracts_req_mention(_, _, _, _, y, _), y != "legacy".
graph_plan_contracts_mentions(f, y) :- graph_plan_contracts_alias(y, x), graph_plan_contracts_mention(f, x).
graph_plan_contracts_hit(c, code, p, l) :- graph_plan_contracts_req_mention(c, p, o, x, y, code), graph_plan_contracts_file(d, p), graph_plan_contracts_method(d, o, x, f), !graph_plan_contracts_mentions(f, y), line(f, l).
graph_plan_contracts_hit(c, code, p, l) :- graph_plan_contracts_removed(c, p, o, x, code), graph_plan_contracts_file(d, p), graph_plan_contracts_method(d, o, x, f), line(f, l).
graph_plan_contracts_surface(d) :- graph_plan_contracts_target(a, t), text(t, "__pure_lazy_surface__"), node(d, a, _, _, _), !graph_plan_contracts_in_fn(a), nearest(a, c, graph_plan_contracts_cdef), graph_plan_contracts_tclass(d, "GraphLazyStepRegistrar", c, _).
graph_plan_contracts_hit("graph-plan-contracts-1", "GLSP-007", p, 1) :- graph_plan_contracts_file(d, p), p = "l7200_versioned_transactions/graph_lazy_sql.py", !graph_plan_contracts_has_class(d, "GraphLazyStepRegistrar").
graph_plan_contracts_hit("graph-plan-contracts-1", "GLSP-007", p, l) :- graph_plan_contracts_file(d, p), p = "l7200_versioned_transactions/graph_lazy_sql.py", graph_plan_contracts_class(d, "GraphLazyStepRegistrar", k), !graph_plan_contracts_surface(d), line(k, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-0", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-0", code, p, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-1", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-1", code, p, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-2", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-2", code, p, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-3", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-3", code, p, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-4", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-4", code, p, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-5", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-5", code, p, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-6", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-6", code, p, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-7", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-7", code, p, l).
violation("data-layer-graph-lazy-sql-plan", "graph-plan-contracts-8", code, p, l) :- graph_plan_contracts_hit("graph-plan-contracts-8", code, p, l).
