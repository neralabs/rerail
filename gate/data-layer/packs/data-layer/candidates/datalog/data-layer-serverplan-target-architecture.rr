m82(n) :- inside(v76, n, k5), node(_, v76, "call", _, _), field(v76, "function", v77), m81(v77).
m83(n) :- field(n, "subject", v56), m68(v56).
m83(n) :- inside(v69, n, k4), node(_, v69, "case_clause", _, _), inside(v70, v69, k3), node(_, v70, "if_clause", _, _), m82(v70).
violation("data-layer-serverplan-target-architecture", "tag-matches", "SPTA007", p, l) :- node(v54, n, _, _, _), doc(v54, v55, _), node(_, n, "match_statement", _, _), m83(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
violation("data-layer-serverplan-target-architecture", "imports-l2070_batching-physical_program.py-from", "SPTA012", p, l) :- node(v84, n, _, _, _), doc(v84, v85, _), node(_, n, "import_from_statement", _, _), node(v86, n, _, _, _), doc(v86, v87, _), v87 = "l2070_batching/physical_program.py", field(n, "module_name", v88), name(v88, v90), (prefix("impl.mariadb", v90) ; prefix("impl.postgres", v90) ; prefix("impl.sqlite", v90) ; prefix("l2000_connection", v90) ; prefix("l2050_transaction", v90)), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
m100(n) :- node(_, n, "dotted_name", _, _), text(n, v96), (prefix("impl.mariadb", v96) ; prefix("impl.postgres", v96) ; prefix("impl.sqlite", v96) ; prefix("l2000_connection", v96) ; prefix("l2050_transaction", v96)).
m100(n) :- node(_, n, "aliased_import", _, _), field(n, "name", v97), name(v97, v99), (prefix("impl.mariadb", v99) ; prefix("impl.postgres", v99) ; prefix("impl.sqlite", v99) ; prefix("l2000_connection", v99) ; prefix("l2050_transaction", v99)).
m102(n) :- field(v101, "module_name", n), node(_, v101, "import_from_statement", _, _).
violation("data-layer-serverplan-target-architecture", "imports-l2070_batching-physical_program.py-direct", "SPTA012", p, l) :- node(v91, n, _, _, _), doc(v91, v92, _), node(_, n, "import_statement", _, _), node(v93, n, _, _, _), doc(v93, v94, _), v94 = "l2070_batching/physical_program.py", child(n, v95, _), m100(v95), !m102(v95), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
violation("data-layer-serverplan-target-architecture", "imports-l2070_batching-planning_contract.py-from", "SPTA012", p, l) :- node(v103, n, _, _, _), doc(v103, v104, _), node(_, n, "import_from_statement", _, _), node(v105, n, _, _, _), doc(v105, v106, _), v106 = "l2070_batching/planning_contract.py", field(n, "module_name", v107), name(v107, v109), (prefix("impl.", v109) ; prefix("l2000_connection", v109) ; prefix("l2050_transaction", v109) ; prefix("l2100_sql_grammar", v109)), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
m119(n) :- node(_, n, "dotted_name", _, _), text(n, v115), (prefix("impl.", v115) ; prefix("l2000_connection", v115) ; prefix("l2050_transaction", v115) ; prefix("l2100_sql_grammar", v115)).
m119(n) :- node(_, n, "aliased_import", _, _), field(n, "name", v116), name(v116, v118), (prefix("impl.", v118) ; prefix("l2000_connection", v118) ; prefix("l2050_transaction", v118) ; prefix("l2100_sql_grammar", v118)).
m121(n) :- field(v120, "module_name", n), node(_, v120, "import_from_statement", _, _).
violation("data-layer-serverplan-target-architecture", "imports-l2070_batching-planning_contract.py-direct", "SPTA012", p, l) :- node(v110, n, _, _, _), doc(v110, v111, _), node(_, n, "import_statement", _, _), node(v112, n, _, _, _), doc(v112, v113, _), v113 = "l2070_batching/planning_contract.py", child(n, v114, _), m119(v114), !m121(v114), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
violation("data-layer-serverplan-target-architecture", "imports-l2070_batching-runtime_application.py-from", "SPTA012", p, l) :- node(v122, n, _, _, _), doc(v122, v123, _), node(_, n, "import_from_statement", _, _), node(v124, n, _, _, _), doc(v124, v125, _), v125 = "l2070_batching/runtime_application.py", field(n, "module_name", v126), name(v126, v128), (prefix("impl.mariadb", v128) ; prefix("impl.postgres", v128) ; prefix("impl.sqlite", v128) ; prefix("l2000_connection", v128)), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
m138(n) :- node(_, n, "dotted_name", _, _), text(n, v134), (prefix("impl.mariadb", v134) ; prefix("impl.postgres", v134) ; prefix("impl.sqlite", v134) ; prefix("l2000_connection", v134)).
m138(n) :- node(_, n, "aliased_import", _, _), field(n, "name", v135), name(v135, v137), (prefix("impl.mariadb", v137) ; prefix("impl.postgres", v137) ; prefix("impl.sqlite", v137) ; prefix("l2000_connection", v137)).
m140(n) :- field(v139, "module_name", n), node(_, v139, "import_from_statement", _, _).
violation("data-layer-serverplan-target-architecture", "imports-l2070_batching-runtime_application.py-direct", "SPTA012", p, l) :- node(v129, n, _, _, _), doc(v129, v130, _), node(_, n, "import_statement", _, _), node(v131, n, _, _, _), doc(v131, v132, _), v132 = "l2070_batching/runtime_application.py", child(n, v133, _), m138(v133), !m140(v133), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
m143(n) :- node(_, n, "assignment", _, _).
m143(n) :- node(_, n, "augmented_assignment", _, _).
m150(n) :- node(_, n, "identifier", _, _), text(n, v147), (v147 = "driver_round_trips" ; v147 = "query_rtts" ; v147 = "round_trips").
m150(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v148), node(_, v148, "identifier", _, _), text(v148, v149), (v149 = "driver_round_trips" ; v149 = "query_rtts" ; v149 = "round_trips").
m154(n) :- node(_, n, "attribute", _, _), field(n, "object", v152), node(_, v152, "identifier", _, _), text(v152, v153), (v153 = "execution_receipt" ; v153 = "receipt").
violation("data-layer-serverplan-target-architecture", "receipt-accounting", "SPTA010", p, l) :- node(v141, n, _, _, _), doc(v141, v142, _), m143(n), node(v144, n, _, _, _), doc(v144, v145, _), prefix("l9900_auto_api/", v145), field(n, "left", v146), m150(v146), field(n, "right", v151), !m154(v151), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
spta_entry_point(1) :- option_value("entryPoint", v), (v = "all" ; v = "scan_sources").
spta_required_shape(1) :- option_on("requiredShape").
spta_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d).
spta_before(p, c, b) :- child(p, c, i), child(p, b, j), j < i.
spta_second(p, c) :- child(p, c, _), k = count : { spta_before(p, c, _) }, k = 1.
spta_ref(x, s) :- node(_, x, "identifier", _, _), text(x, s), !spta_attr_name(x), !spta_kw_name(x).
spta_attr_name(x) :- field(a, "attribute", x), node(_, a, "attribute", _, _).
spta_kw_name(x) :- field(k, "name", x), node(_, k, "keyword_argument", _, _).
spta_ei_name_kind(x) :- node(_, x, "dotted_name", _, _).
spta_ei_name_kind(x) :- node(_, x, "aliased_import", _, _).
spta_ei_imported(s) :- field(s, "module_name", m), child(s, x, _), x != m, spta_ei_name_kind(x), node_text(x, t), match("(?:[A-Za-z_]\\w*)?(?:Step|Intent|Strategy)(?:\\s+as\\s+\\w+)?", t).
violation("data-layer-serverplan-target-architecture", "executor-imports", "SPTA005", p, l) :- spta_entry_point(1), spta_doc(d, p), p = "l2070_batching/executor.py", node(d, s, "import_from_statement", _, _), field(s, "module_name", m), node_text(m, t), contains(".steps.", t), spta_ei_imported(s), line(s, l).
violation("data-layer-serverplan-target-architecture", "executor-imports", "SPTA005", p, l) :- spta_entry_point(1), spta_doc(d, p), p = "l2070_batching/executor.py", node(d, s, "import_from_statement", _, _), field(s, "module_name", m), node_text(m, t), suffix(".steps", t), spta_ei_imported(s), line(s, l).
spta_call(d, p, c, s, al) :- spta_doc(d, p), prefix("impl/common/l2070_server_plan/strategies/", p), node(d, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, s), field(c, "arguments", al).
spta_call(d, p, c, s, al) :- spta_doc(d, p), prefix("impl/common/l2070_server_plan/strategies/", p), node(d, c, "call", _, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, s), field(c, "arguments", al).
violation("data-layer-serverplan-target-architecture", "strategy-getattr", "SPTA008", p, l) :- spta_entry_point(1), spta_call(_, p, c, "getattr", al), spta_second(al, y), node(_, y, k, _, _), (k = "string" ; k = "concatenated_string"), value(y, v), value_type_of(y, "str"), (v = "_stmt" ; v = "_grammar" ; v = "grammar"), line(c, l).
spta_si_name(x) :- spta_ref(x, s), prefix("Sql", s).
spta_si_name(x) :- spta_ref(x, s), suffix("Grammar", s).
spta_si_name(x) :- spta_ref(x, s), suffix("Stmt", s).
spta_si_type(y) :- spta_call(_, _, _, "isinstance", al), spta_second(al, y), spta_si_name(y).
spta_si_type(y) :- spta_call(d, _, _, "isinstance", al), spta_second(al, y), node(d, y, _, ys, ye), node(d, x, "identifier", xs, xe), x != y, xs >= ys, xe <= ye, spta_si_name(x).
violation("data-layer-serverplan-target-architecture", "strategy-isinstance", "SPTA008", p, l) :- spta_entry_point(1), spta_call(_, p, c, "isinstance", al), spta_second(al, y), spta_si_type(y), line(c, l).
spta_rc_raw_class(p, c, t, s) :- spta_doc(d, p), node(d, c, "class_definition", s, _), !inside(c, _, spta_rc_scope), field(c, "name", nm), text(nm, t).
spta_rc_kw_true(al, k) :- child(al, kw, _), node(_, kw, "keyword_argument", _, _), field(kw, "name", n), node(_, n, "identifier", _, _), text(n, k), field(kw, "value", v), node(_, v, "true", _, _).
spta_rc_frozen(c) :- node(_, c, "class_definition", _, _), child(dd, c, _), node(_, dd, "decorated_definition", _, _), child(dd, dec, _), node(_, dec, "decorator", _, _), child(dec, call, _), node(_, call, "call", _, _), field(call, "function", f), spta_rc_dataclass(f), field(call, "arguments", al), spta_rc_kw_true(al, "frozen"), spta_rc_kw_true(al, "slots").
spta_rc_dataclass(f) :- node(_, f, "identifier", _, _), text(f, "dataclass").
spta_rc_dataclass(f) :- node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, "dataclass").
spta_rc_class_last(p, t, s) :- spta_rc_raw_class(p, _, t, _), s = max x : { spta_rc_raw_class(p, _, t, x) }.
spta_rc_class(p, t, c) :- spta_rc_class_last(p, t, s), spta_rc_raw_class(p, c, t, s).
spta_rc_module_stmt(n) :- child(m, n, _), node(_, m, "module", _, _).
spta_rc_symbol(p, t) :- spta_rc_class(p, t, _).
spta_rc_symbol(p, t) :- spta_doc(d, p), node(d, f, "function_definition", _, _), !inside(f, _, spta_rc_scope), spta_rc_module_stmt(f), field(f, "name", nm), text(nm, t).
spta_rc_symbol(p, t) :- spta_doc(d, p), node(d, f, "function_definition", _, _), !inside(f, _, spta_rc_scope), child(dd, f, _), node(_, dd, "decorated_definition", _, _), spta_rc_module_stmt(dd), field(f, "name", nm), text(nm, t).
spta_rc_symbol(p, t) :- spta_rc_module_assign(p, _, t).
spta_rc_assign_node(a) :- node(_, a, "assignment", _, _).
spta_rc_assign_node(a) :- node(_, a, "augmented_assignment", _, _).
spta_rc_module_assign(p, a, t) :- spta_doc(d, p), node(d, a, _, _, _), spta_rc_assign_node(a), field(a, "left", x), node(_, x, "identifier", _, _), text(x, t), child(es, a, _), node(_, es, "expression_statement", _, _), spta_rc_module_stmt(es).
spta_rc_member(c, t, 1) :- spta_rc_class_body_assign(c, a, t), field(a, "type", _).
spta_rc_member(c, t, 0) :- spta_rc_class_body_assign(c, a, t), !spta_rc_typed(a).
spta_rc_typed(a) :- node(_, a, "assignment", _, _), field(a, "type", _).
spta_rc_class_body_assign(c, a, t) :- spta_rc_raw_class(_, c, _, _), field(c, "body", b), node(_, b, "block", _, _), child(b, es, _), node(_, es, "expression_statement", _, _), child(es, a, _), node(_, a, "assignment", _, _), field(a, "left", x), node(_, x, "identifier", _, _), text(x, t).
spta_rc_raw_method(c, f, t, s) :- spta_rc_raw_class(_, c, _, _), field(c, "body", b), node(_, b, "block", _, _), child(b, f, _), node(_, f, "function_definition", s, _), field(f, "name", nm), text(nm, t).
spta_rc_raw_method(c, f, t, s) :- spta_rc_raw_class(_, c, _, _), field(c, "body", b), node(_, b, "block", _, _), child(b, dd, _), node(_, dd, "decorated_definition", _, _), child(dd, f, _), node(_, f, "function_definition", s, _), field(f, "name", nm), text(nm, t).
spta_rc_method_last(c, t, s) :- spta_rc_raw_method(c, _, t, _), s = max x : { spta_rc_raw_method(c, _, t, x) }.
spta_rc_method(c, t, f) :- spta_rc_method_last(c, t, s), spta_rc_raw_method(c, f, t, s).
spta_rc_annotation(c, fld, t) :- spta_rc_class_body_assign(c, a, fld), field(a, "type", ty), node(_, ty, "type", _, _), spta_ref(x, t), inside(x, ty, spta_rc_type).
spta_rc_annotation(c, fld, t) :- spta_rc_class_body_assign(c, a, fld), field(a, "type", ty), node(_, ty, "type", _, _), spta_ref(ty, t).
spta_rc_return(f, t) :- spta_rc_raw_method(_, f, _, _), field(f, "return_type", r), node(d, r, _, rs, re), node(d, x, "identifier", xs, xe), xs >= rs, xe <= re, spta_ref(x, t), inside(x, f, spta_rc_fn).
spta_rc_param(f, t) :- spta_rc_raw_method(_, f, _, _), nearest(x, f, spta_rc_fn), spta_ref(x, t), inside(x, q, spta_rc_params), !spta_rc_splat(q), field(q, "type", ty), node(d, ty, _, ts, te), node(d, x, _, xs, xe), xs >= ts, xe <= te.
spta_rc_splat(q) :- child(q, z, _), node(_, z, "list_splat_pattern", _, _).
spta_rc_splat(q) :- child(q, z, _), node(_, z, "dictionary_splat_pattern", _, _).
spta_rc_base(c, t) :- spta_rc_raw_class(_, c, _, _), child(c, al, _), node(_, al, "argument_list", _, _), inside(x, al, spta_rc_args), spta_ref(x, t), !inside(x, _, spta_rc_kw).
spta_rc_union(p, al, t) :- spta_rc_module_assign(p, a, al), field(a, "right", r), node(d, r, _, rs, re), node(d, x, "identifier", xs, xe), xs >= rs, xe <= re, spta_ref(x, t), spta_rc_nearest_right(x, a).
spta_rc_right_of(x, a, s) :- inside(x, a, spta_rc_assign), field(a, "right", r), node(d, r, _, rs, re), node(d, x, _, xs, xe), xs >= rs, xe <= re, spta_rc_module_assign(_, a, _), node(_, a, _, s, _).
spta_rc_nearest_right(x, a) :- spta_rc_right_of(x, a, s), s = max y : { spta_rc_right_of(x, _, y) }.
spta_rc_finding(p, "SPTA001") :- spta_rc_req_symbol(p, t), !spta_rc_symbol(p, t).
spta_rc_finding(p, "SPTA013") :- spta_rc_req_field(p, k, t), spta_rc_class(p, k, c), !spta_rc_member(c, t, 1).
spta_rc_finding(p, "SPTA013") :- spta_rc_req_immutable(p, k), spta_rc_class(p, k, c), !spta_rc_frozen(c).
spta_rc_finding(p, "SPTA013") :- spta_rc_req_enum(p, k, _), spta_rc_class(p, k, c), !spta_rc_base(c, "StrEnum").
spta_rc_finding(p, "SPTA013") :- spta_rc_req_enum(p, k, t), spta_rc_class(p, k, c), !spta_rc_member(c, t, 0).
spta_rc_finding(p, "SPTA013") :- spta_rc_req_union(p, a, t), spta_rc_symbol(p, a), !spta_rc_union(p, a, t).
spta_rc_finding("l2070_batching/step.py", "SPTA002") :- spta_required_shape(1), !spta_rc_planning_method(1).
spta_rc_finding("l2070_batching/physical_placement.py", "SPTA003") :- spta_required_shape(1), !spta_rc_application_field(1).
spta_rc_finding("l2070_batching/physical_executor.py", "SPTA011") :- spta_required_shape(1), !spta_rc_executor_method(1).
spta_rc_planning_method(1) :- spta_rc_class("l2070_batching/step.py", "ServerPlanStep", c), spta_rc_method(c, "planning_contract", f), spta_rc_return(f, "StepPlanningContract").
spta_rc_application_field(1) :- spta_rc_class("l2070_batching/physical_placement.py", "ApplicationPlacementUnit", c), spta_rc_annotation(c, "application", "RuntimeApplication").
spta_rc_executor_method(1) :- spta_rc_class("l2070_batching/physical_executor.py", "BackendExecutor", c), spta_rc_method(c, "execute_program", f), spta_rc_return(f, "BackendExecutionReceipt"), spta_rc_param(f, "PhysicalTransportProgram").
violation("data-layer-serverplan-target-architecture", "required-contracts", code, p, 1) :- spta_required_shape(1), spta_rc_finding(p, code).
