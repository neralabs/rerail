.scope text "**/*.[mM][dD]", "**/*.[mM][aA][rR][kK][dD][oO][wW][nN]", "**/*.[rR][sS][tT]", "**/*.[tT][xX][tT]", "**/*.[tT][oO][mM][lL]", "**/*.[cC][fF][gG]", "**/*.[iI][nN][iI]", "**/*.[yY][aA][mM][lL]", "**/*.[yY][mM][lL]"
.decl doc(d: number, path: symbol, module: symbol)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl publication_line(d: number, l: number, s: symbol)
.decl src_line(d: number, l: number, sp: node)
.decl text(n: node, s: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, text, src_line
.output violation
in_scope(d) :- doc(d, p, _), glob("l2070_batching/executor.py", p).
publication_line(d, l, s) :- doc(d, _, _), in_scope(d), !out_scope(d), src_line(d, l, sp), text(sp, s).
violation("data-layer-executor-publication-repairs", "cte_output_columns", "executor_publication_repair", p, l) :- publication_line(d, l, s), contains("_cte_output_columns", s), doc(d, p, _).
violation("data-layer-executor-publication-repairs", "cte_column_type_hints", "executor_publication_repair", p, l) :- publication_line(d, l, s), contains("_cte_column_type_hints", s), doc(d, p, _).
violation("data-layer-executor-publication-repairs", "publication_contract_cache", "executor_publication_repair", p, l) :- publication_line(d, l, s), contains("_publication_contract_cache", s), doc(d, p, _).
violation("data-layer-executor-publication-repairs", "cte_publication_contract_cache", "executor_publication_repair", p, l) :- publication_line(d, l, s), contains("_cte_publication_contract_cache", s), doc(d, p, _).
