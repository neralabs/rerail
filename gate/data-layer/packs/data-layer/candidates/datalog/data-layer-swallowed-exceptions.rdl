.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl name(n: node, s: sym)
.input doc, node, child, field, text, name
.kindset k0 = "module"
.kindset k1 = "import_from_statement"
.decl in_scope(d: int)
.decl m19(n: node)
.decl m27(n: node)
.decl m52(n: node)
.decl out_scope(d: int)
.decl u10(n: node)
.decl u2(n: node)
.decl u30(n: node)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "api/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "services/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "data_layer_testing/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test_*.py").
m19($n) :- name($n, $v18), @glob($v18, {"async", "async.*"}).
m27($n) :- node(_, $n, "identifier", _, _), text($n, $v24), $v24 = "suppress".
m27($n) :- node(_, $n, "attribute", _, _), child($n, $v25, 0), node(_, $v25, "identifier", _, _), text($v25, "contextlib"), child($n, $v26, 1), node(_, $v26, "identifier", _, _), text($v26, "suppress"), !child($n, _, 2).
m52($n) :- node(_, $n, "dotted_name", _, _), text($n, $v49), $v49 = "suppress".
m52($n) :- node(_, $n, "aliased_import", _, _), field($n, "name", $v50), node(_, $v50, "dotted_name", _, _), text($v50, $v51), $v51 = "suppress".
.output violation
