.decl k0(kind: symbol)
k0("expression_statement").
.decl k1(kind: symbol)
k1("module").
.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl m13(n: node)
.decl name(n: node, s: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl out_scope(d: number)
.decl syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, child, text, name, line, syntax_error
.output violation
in_scope(d) :- doc(d, p, _), glob("api/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("services/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test_*.py", p).
m13(n) :- node(_, n, "module", _, _), node(v6, n, _, _, _), node(v6, v7, _, _, _), name(v7, v8), (contains("logger.error", v8) ; contains("logger.warning", v8) ; contains("txn.commit", v8)).
m13(n) :- inside(n, v9, k1), node(_, v9, "module", _, _), node(v10, v9, _, _, _), node(v10, v11, _, _, _), name(v11, v12), (contains("logger.error", v12) ; contains("logger.warning", v12) ; contains("txn.commit", v12)).
violation("data-layer-error-handling", "admin-commit", "EH001", p, l) :- node(_, n, "call", _, _), node(_, n, "call", _, _), child(n, v1, 0), node(_, v1, "attribute", _, _), child(v1, v2, 0), node(_, v2, "identifier", _, _), text(v2, "txn"), child(v1, v3, 1), node(_, v3, "identifier", _, _), text(v3, "commit"), !child(v1, _, 2), child(n, v4, 1), node(_, v4, "argument_list", _, _), !child(v4, _, 0), !child(n, _, 2), inside(n, v5, k0), node(_, v5, "expression_statement", _, _), m13(n), doc(d, p, m), prefix("api/l8000_admin/tools", p), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
