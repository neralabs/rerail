in_scope(d) :- doc(d, p, _), glob("l9700_graph_query/graph_pattern.py", p).
in_scope(d) :- doc(d, p, _), glob("l9700_graph_query/query_builder.py", p).
in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/graph_lazy_sql.py", p).
in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/versioned_lazy_mixin.py", p).
in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/versioned_transactions.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2070_server_plan/steps/intent_graph.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2070_server_plan/graph_path_relation_plan.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l9700_sql_graph_query/steps/graph_traverse.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l9700_sql_graph_query/sql_graph_query_builder.py", p).
in_scope(d) :- doc(d, p, _), glob("l9720_sparql/executor.py", p).
in_scope(d) :- doc(d, p, _), glob("l9720_sparql/ast.py", p).
in_scope(d) :- doc(d, p, _), glob("l9720_sparql/compiler.py", p).
in_scope(d) :- doc(d, p, _), glob("docs/l9700_graph_query.rst", p).
in_scope(d) :- doc(d, p, _), glob("docs/l7200_versioned_transactions.rst", p).
in_scope(d) :- doc(d, p, _), glob("docs/l9720_sparql.rst", p).
in_scope(d) :- doc(d, p, _), glob("docs/design/BOUNDED_COMPOSED_GRAPH_PATHS_DESIGN.rst", p).
in_scope(d) :- doc(d, p, _), glob("docs/design/BOUNDED_COMPOSED_GRAPH_PATHS_IMPLEMENTATION_PLAN.rst", p).
in_scope(d) :- doc(d, p, _), glob("scripts/lint_all.py", p).
in_scope(d) :- doc(d, p, _), glob("docs/design/architecture_linter_rules/serverplan/bounded_composed_graph_paths.md", p).
in_scope(d) :- doc(d, p, _), glob("conform/l9700_graph_query/test_bounded_composed_paths.py", p).
text_contract_present(p) :- doc(d, p, _), in_scope(d).
text_contract_src(p, t) :- doc(d, p, _), in_scope(d), source(d, sp), text(sp, t).
text_contract_span(p, l, sp) :- doc(d, p, _), in_scope(d), tape_line(d, l, sp).
text_contract_line(p, l, u) :- text_contract_span(p, l, sp), text(sp, u).
text_contract_next(p, l, j) :- text_contract_line(p, l, _), j = @add(l, 1), text_contract_line(p, j, _).
text_contract_blank(p, l) :- text_contract_line(p, l, u), match("\\s*", u).
text_contract_empty(p, l) :- text_contract_line(p, l, "").
text_contract_nb_next(p, j, j1) :- text_contract_next(p, j, j1), !text_contract_blank(p, j1).
text_contract_nb_next(p, j, j2) :- text_contract_next(p, j, j1), text_contract_blank(p, j1), text_contract_nb_next(p, j1, j2).
text_contract_ne_next(p, j, j1) :- text_contract_next(p, j, j1), !text_contract_empty(p, j1).
text_contract_ne_next(p, j, j2) :- text_contract_next(p, j, j1), text_contract_empty(p, j1), text_contract_ne_next(p, j1, j2).
text_contract_paren(p, j, j2) :- text_contract_nb_next(p, j, j2), text_contract_line(p, j2, u), match("\\s*\\(.*", u).
text_contract_def(k, p, l) :- text_contract_defspec(k, p, nm), text_contract_line(p, l, u), x = @concat("\\s*(?:async )?def ", @concat(nm, "\\s*\\(.*")), match(x, u).
text_contract_def(k, p, l) :- text_contract_defspec(k, p, nm), text_contract_line(p, l, u), x = @concat("\\s*(?:async )?def ", @concat(nm, "\\s*")), match(x, u), text_contract_paren(p, l, _).
text_contract_def_back(k, p, l) :- text_contract_def(k, p, l).
text_contract_def_back(k, p, j) :- text_contract_def_back(k, p, l), text_contract_next(p, j, l), text_contract_blank(p, j).
text_contract_def_first(k, p, l) :- text_contract_def_back(k, p, _), l = min x : { text_contract_def_back(k, p, x) }.
text_contract_word(k, p, l) :- text_contract_wordspec(k, p, nm), text_contract_line(p, l, u), x = @concat(".*\\b", @concat(nm, "\\b.*")), match(x, u).
text_contract_word_first(k, p, l) :- text_contract_word(k, p, _), l = min x : { text_contract_word(k, p, x) }.
text_contract_hdr(p, c, l) :- text_contract_clsspec(p, c), text_contract_line(p, l, u), x = @concat("class ", @concat(c, "(?:\\[.*\\])?(?:\\(.*\\))?:.*")), match(x, u).
text_contract_cls(p, c, l) :- text_contract_hdr(p, c, _), l = min x : { text_contract_hdr(p, c, x) }.
text_contract_has_cls(p, c) :- text_contract_cls(p, c, _).
text_contract_cquirk(p, c) :- text_contract_cls(p, c, h), text_contract_span(p, h, sp), match_group("\\Aclass (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?(?:\\([^\\n]*\\))?:(?P<rest>.*)\\z", sp, m, "n", gn), text(gn, c), match_group("\\Aclass (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?(?:\\([^\\n]*\\))?:(?P<rest>.*)\\z", sp, m, "rest", gr), text(gr, r), match("(?:class |def |async def ).*", r).
text_contract_top(p, l) :- text_contract_line(p, l, u), match("(?:class |def |async def ).*", u).
text_contract_cafter(p, c, t) :- text_contract_cls(p, c, l0), text_contract_top(p, t), t > l0.
text_contract_cend(p, c, e) :- text_contract_cafter(p, c, _), e = min x : { text_contract_cafter(p, c, x) }.
text_contract_cended(p, c) :- text_contract_cend(p, c, _).
text_contract_cin(p, c, l, u) :- text_contract_cls(p, c, l0), !text_contract_cquirk(p, c), text_contract_line(p, l, u), l > l0, text_contract_cend(p, c, e), l < e.
text_contract_cin(p, c, l, u) :- text_contract_cls(p, c, l0), !text_contract_cquirk(p, c), text_contract_line(p, l, u), l > l0, !text_contract_cended(p, c).
text_contract_cdef(k, l) :- text_contract_cmspec(k, p, c, nm), text_contract_cin(p, c, l, u), x = @concat("    (?:async )?def ", @concat(nm, "(?:\\[.*\\])?\\s*\\(.*")), match(x, u).
text_contract_cdef(k, l) :- text_contract_cmspec(k, p, c, nm), text_contract_cin(p, c, l, u), x = @concat("    (?:async )?def ", @concat(nm, "(?:\\[.*\\])?\\s*")), match(x, u), text_contract_paren(p, l, j), text_contract_cin(p, c, j, _).
text_contract_cmok(k) :- text_contract_cdef(k, _).
text_contract_deco(k, l) :- text_contract_decospec(k, dc), text_contract_cmspec(k, p, c, _), text_contract_cin(p, c, l, u), x = @concat("    @", @concat(dc, "(?:\\(.*\\))?")), match(x, u).
text_contract_dchain(k, j) :- text_contract_deco(k, l), text_contract_cmspec(k, p, c, _), text_contract_next(p, l, j), text_contract_cin(p, c, j, _).
text_contract_dchain(k, j) :- text_contract_dchain(k, l), text_contract_cmspec(k, p, c, _), text_contract_cin(p, c, l, u), match("    @.+", u), text_contract_next(p, l, j), text_contract_cin(p, c, j, _).
text_contract_dok(k) :- text_contract_dchain(k, l), text_contract_cdef(k, l).
text_contract_fcolon(k, a, a, x) :- text_contract_fspec(k, p, c, f), text_contract_cin(p, c, a, u), x = @concat("    ", @concat(f, "\\s*:")), y = @concat(x, ".*"), match(y, u).
text_contract_fcolon(k, a, j, "\\s*:") :- text_contract_fspec(k, p, c, f), text_contract_cin(p, c, a, u), x = @concat("    ", @concat(f, "\\s*")), match(x, u), text_contract_nb_next(p, a, j), text_contract_cin(p, c, j, w), match("\\s*:.*", w).
text_contract_fok(k, a) :- text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = @concat(pre, "[^=].*"), match(x, u).
text_contract_fok(k, a) :- text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), match(pre, u), text_contract_ne_next(p, b, j), text_contract_cin(p, c, j, w), match("[^=].*", w).
text_contract_fld(k) :- text_contract_fok(k, _).
text_contract_ffirst(k, a) :- text_contract_fok(k, _), a = min x : { text_contract_fok(k, x) }.
text_contract_fx(k, b, x) :- text_contract_ffirst(k, a), text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = @concat(pre, "\\s*"), y = @concat(x, "\\S.*"), match(y, u).
text_contract_fx(k, j, "\\s*") :- text_contract_ffirst(k, a), text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = @concat(pre, "\\s*"), match(x, u), text_contract_nb_next(p, b, j), text_contract_cin(p, c, j, _).
text_contract_g1none(k) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = @concat(xp, "[^=]*None.*"), match(x, u).
text_contract_fq(k, j, x) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = @concat(xp, "[^=\\s][^=]*="), y = @concat(x, ".*"), match(y, u).
text_contract_fq(k, j3, "\\s*=") :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = @concat(xp, "[^=\\s][^=]*"), match(x, u), text_contract_nb_next(p, j, j3), text_contract_cin(p, c, j3, w), match("\\s*=.*", w).
text_contract_fq(k, j, x) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = @concat(xp, "="), y = @concat(x, ".*"), match(y, u).
