.decl fwdref_scope_kinds(kind: symbol)
fwdref_scope_kinds("function_definition"). fwdref_scope_kinds("module").
.decl fwdref_tuple(kind: symbol)
fwdref_tuple("tuple").
.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl fwdref_anc(n: node, s: node)
.decl fwdref_asked(n: node)
.decl fwdref_assign(a: node)
.decl fwdref_call(c: node, fname: symbol, args: node)
.decl fwdref_guard(g: node)
.decl fwdref_guarded(a: node, c: node)
.decl fwdref_hit(c: node)
.decl fwdref_nearer(n: node, s: node)
.decl fwdref_own(n: node, s: node)
.decl fwdref_pair(a: node, c: node)
.decl fwdref_scope(s: node)
.decl fwdref_target(c: node, clause: symbol)
.decl fwdref_type(t: node)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl op(n: node, s: symbol)
.decl out_scope(d: number)
.decl syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, op, field, text, child, syntax_error, line
.output violation
in_scope(d) :- doc(d, p, _), glob("api/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("public/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
fwdref_scope(s) :- node(_, s, "function_definition", _, _), !op(s, "async").
fwdref_scope(s) :- node(_, s, "module", _, _).
fwdref_call(c, f, a) :- node(_, c, "call", _, _), field(c, "function", fn), node(_, fn, "identifier", _, _), text(fn, f), field(c, "arguments", a), node(_, a, "argument_list", _, _), child(a, x, 0), node(_, x, "identifier", _, _), text(x, "annotation").
fwdref_target(c, "fwdref001") :- fwdref_call(c, "isinstance", a), child(a, t, 1), node(_, t, "identifier", _, _), text(t, "type").
fwdref_target(c, "fwdref002") :- fwdref_call(c, "issubclass", _).
fwdref_target(c, "fwdref003") :- fwdref_call(c, "callable", _).
fwdref_type(t) :- node(_, t, "identifier", _, _), text(t, "ForwardRef").
fwdref_type(t) :- node(_, t, "attribute", _, _), field(t, "attribute", a), node(_, a, "identifier", _, _), text(a, "ForwardRef").
fwdref_type(t) :- node(_, t, "tuple", _, _), inside(i, t, fwdref_tuple), node(_, i, "identifier", _, _), text(i, "ForwardRef").
fwdref_guard(g) :- fwdref_call(g, "isinstance", a), child(a, t, 1), fwdref_type(t).
fwdref_assign(a) :- node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, "annotation"), field(a, "right", r), node(_, r, "attribute", _, _), field(r, "attribute", x), node(_, x, "identifier", _, _), text(x, "annotation").
fwdref_asked(n) :- fwdref_target(n, _).
fwdref_asked(n) :- fwdref_guard(n).
fwdref_asked(n) :- fwdref_assign(n).
fwdref_anc(n, s) :- fwdref_asked(n), inside(n, s, fwdref_scope_kinds), fwdref_scope(s).
fwdref_nearer(n, s) :- fwdref_anc(n, s), fwdref_anc(n, t), inside(t, s, fwdref_scope_kinds).
fwdref_own(n, s) :- fwdref_anc(n, s), !fwdref_nearer(n, s).
fwdref_pair(a, c) :- fwdref_target(c, _), fwdref_own(c, s), fwdref_assign(a), fwdref_own(a, s), node(_, a, _, _, ae), node(_, c, _, cs, _), cs >= ae.
fwdref_guarded(a, c) :- fwdref_pair(a, c), fwdref_own(a, s), fwdref_guard(g), fwdref_own(g, s), node(_, a, _, _, ae), node(_, g, _, gs, ge), node(_, c, _, cs, _), gs >= ae, cs >= ge.
fwdref_hit(c) :- fwdref_pair(a, c), !fwdref_guarded(a, c).
violation("data-layer-forwardref", "fwdref001", "FWDREF001", p, l) :- fwdref_target(c, "fwdref001"), fwdref_hit(c), node(d, c, _, _, _), doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d), line(c, l).
violation("data-layer-forwardref", "fwdref002", "FWDREF002", p, l) :- fwdref_target(c, "fwdref002"), fwdref_hit(c), node(d, c, _, _, _), doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d), line(c, l).
violation("data-layer-forwardref", "fwdref003", "FWDREF003", p, l) :- fwdref_target(c, "fwdref003"), fwdref_hit(c), node(d, c, _, _, _), doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d), line(c, l).
