.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl text(n: node, s: symbol)
.decl op(n: node, s: symbol)
.input doc, node, child, text, op
.decl k0(kind: symbol)
k0("function_definition"). k0("module").
.decl k1(kind: symbol)
k1("assignment").
.decl blocked11(low: node, high: node)
.decl blocked16(low: node, high: node)
.decl blocked31(low: node, high: node)
.decl blocked36(low: node, high: node)
.decl blocked51(low: node, high: node)
