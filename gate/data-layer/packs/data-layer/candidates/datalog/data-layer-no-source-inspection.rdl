.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl field(p: node, f: sym, c: node)
.decl name(n: node, s: sym)
.decl line(n: node, l: int)
.input doc, node, field, name, line
.decl in_scope(d: int)
.decl m13(n: node)
.decl m20(n: node)
.decl out_scope(d: int)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "tests/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "conform/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.pytest_cache/**").
violation("data-layer-no-source-inspection", "inspection-0", "NSI001", $p, $l) :- node(_, $n, "call", _, _), field($n, "function", $v1), node(_, $v1, "attribute", _, _), name($v1, $v2), @glob($v2, {"*.inspect.getsource", "inspect.getsource"}), node($d, $n, _, _, _), in_scope($d), !out_scope($d), doc($d, $p, _), line($n, $l).
violation("data-layer-no-source-inspection", "inspection-1", "NSI001", $p, $l) :- node(_, $n, "call", _, _), field($n, "function", $v3), node(_, $v3, "attribute", _, _), name($v3, $v4), @glob($v4, {"*.inspect.getsourcelines", "inspect.getsourcelines"}), node($d, $n, _, _, _), in_scope($d), !out_scope($d), doc($d, $p, _), line($n, $l).
violation("data-layer-no-source-inspection", "inspection-2", "NSI001", $p, $l) :- node(_, $n, "call", _, _), field($n, "function", $v5), node(_, $v5, "attribute", _, _), name($v5, $v6), @glob($v6, {"*.inspect.getsourcefile", "inspect.getsourcefile"}), node($d, $n, _, _, _), in_scope($d), !out_scope($d), doc($d, $p, _), line($n, $l).
m13($n) :- field($v12, "module_name", $n), node(_, $v12, "import_from_statement", _, _).
m20($n) :- field($v19, "module_name", $n), node(_, $v19, "import_from_statement", _, _).
.output violation
