in_scope(d) :- doc(d, p, _), glob("l9750_graphql/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9800_rippling/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9850_workflow/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9875_mcp/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9900_auto_api/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
tape_syntax_error(d) :- syntax_error(d).
ef_oc_s(a, b, a, b) :- ef_oc_q(a, b).
ef_oc_s(a, b, ta2, tb2) :- ef_oc_s(a, b, ta, tb), @strlen(ta) > 0, @strlen(tb) > 0, @substr(ta, 0, 1) = @substr(tb, 0, 1), ta2 = @substr(ta, 1, @sub(@strlen(ta), 1)), tb2 = @substr(tb, 1, @sub(@strlen(tb), 1)).
ef_oc_lt(a, b) :- ef_oc_s(a, b, "", tb), tb != "".
ef_oc_lt(a, b) :- ef_oc_s(a, b, ta, tb), rr_t1 = @substr(ta, 0, 1), ef_chr(rr_t1, x), rr_t2 = @substr(tb, 0, 1), ef_chr(rr_t2, y), x < y.
ef_wc_s(a, b, a, b) :- ef_wc_q(a, b).
ef_wc_s(a, b, ta2, tb2) :- ef_wc_s(a, b, ta, tb), @strlen(ta) > 0, @strlen(tb) > 0, @substr(ta, 0, 1) = @substr(tb, 0, 1), ta2 = @substr(ta, 1, @sub(@strlen(ta), 1)), tb2 = @substr(tb, 1, @sub(@strlen(tb), 1)).
ef_wc_lt(a, b) :- ef_wc_s(a, b, "", tb), tb != "".
ef_wc_lt(a, b) :- ef_wc_s(a, b, ta, tb), rr_t3 = @substr(ta, 0, 1), ef_chr(rr_t3, x), rr_t4 = @substr(tb, 0, 1), ef_chr(rr_t4, y), x < y.
ef_pc_s(a, b, a, b) :- ef_pc_q(a, b).
ef_pc_s(a, b, ta2, tb2) :- ef_pc_s(a, b, ta, tb), @strlen(ta) > 0, @strlen(tb) > 0, @substr(ta, 0, 1) = @substr(tb, 0, 1), ta2 = @substr(ta, 1, @sub(@strlen(ta), 1)), tb2 = @substr(tb, 1, @sub(@strlen(tb), 1)).
ef_pc_lt(a, b) :- ef_pc_s(a, b, "", tb), tb != "".
ef_pc_lt(a, b) :- ef_pc_s(a, b, ta, tb), rr_t5 = @substr(ta, 0, 1), ef_chr(rr_t5, x), rr_t6 = @substr(tb, 0, 1), ef_chr(rr_t6, y), x < y.
ef_doc(d) :- doc(d, _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d).
ef_dl(d) :- ef_doc(d), doc(d, p, _), match("data_layer/[^/]+\\.py", p).
ef_func(d, f, s) :- node(d, f, "function_definition", _, _), ef_doc(d), !inside(f, _, ef_fn), field(f, "name", n), text(n, s), field(f, "body", _).
ef_func_class(f, c, s) :- ef_func(_, f, _), nearest(f, c, ef_cls), field(c, "name", n), text(n, s).
ef_func_ret(f, s) :- ef_func(_, f, _), field(f, "return_type", t), node_text(t, s).
ef_class(d, c, s) :- node(d, c, "class_definition", _, _), ef_doc(d), field(c, "name", n), text(n, s), field(c, "body", _).
ef_module(d, m) :- ef_doc(d), doc(d, p, _), m = @rx_replace(@rx_replace(p, "/__init__\\.py$|\\.py$", ""), "/", ".").
ef_inv(id, d, f, st, n, "function", m, fq) :- ef_func(d, f, n), !ef_func_class(f, _, _), ef_module(d, m), node(d, f, _, st, _), id = @concat(@concat(m, "::"), n), fq = @concat(@concat(m, "."), n).
ef_inv(id, d, f, st, n, "method", m, fq) :- ef_func(d, f, n), ef_func_class(f, _, c), ef_module(d, m), node(d, f, _, st, _), q = @concat(@concat(c, "."), n), id = @concat(@concat(m, "::"), q), fq = @concat(@concat(m, "."), q).
ef_inv(id, d, c, st, n, "class", m, fq) :- ef_class(d, c, n), ef_module(d, m), node(d, c, _, st, _), id = @concat(@concat(m, "::"), n), fq = @concat(@concat(m, "."), n).
ef_inv_start(id, st) :- ef_inv(id, _, _, st, _, _, _, _).
ef_last(id, s) :- ef_inv_start(id, _), s = max t : { ef_inv_start(id, t) }.
ef_decl(id, d, x, n, k, m, fq) :- ef_inv(id, d, x, st, n, k, m, fq), ef_last(id, st).
ef_decl_class(id, cn, c) :- ef_decl(id, _, x, _, "method", _, _), ef_func_class(x, c, cn).
ef_declared_fq(fq) :- ef_decl(_, _, _, _, _, _, fq).
ef_deco_node(x, o, s) :- node(d, x, "decorator", _, _), ef_doc(d), child(dd, x, _), node(_, dd, "decorated_definition", _, _), child(dd, o, _), ef_def(o), node_text(x, s).
ef_def(o) :- node(_, o, "function_definition", _, _).
ef_def(o) :- node(_, o, "class_definition", _, _).
ef_decorator(o, n) :- ef_deco_node(_, o, s), match("@\\s*[^\\s(]+(?s:.*)", s), n = @rx_replace(s, "^@\\s*([^\\s(]+)(?s:.*)$", "${1}").
ef_param_name(p, s) :- node(_, p, "identifier", _, _), text(p, s).
ef_param_name(p, s) :- node(_, p, "typed_parameter", _, _), child(p, c, _), node(_, c, "identifier", _, _), text(c, s).
ef_param_name(p, s) :- node(_, p, "default_parameter", _, _), field(p, "name", c), text(c, s).
ef_param_name(p, s) :- node(_, p, "typed_default_parameter", _, _), field(p, "name", c), text(c, s).
ef_slash_at(ps, i) :- child(ps, c, i), node(_, c, "positional_separator", _, _).
ef_before_slash(ps, i) :- child(ps, _, i), ef_slash_at(ps, j), i < j.
ef_param(p, f, s, st) :- ef_func(_, f, _), field(f, "parameters", ps), node(_, ps, "parameters", _, _), child(ps, p, i), ef_param_name(p, s), !ef_before_slash(ps, i), node(_, p, _, st, _).
ef_params(p, id, n, st) :- ef_param(p, f, n, st), ef_decl(id, _, f, _, "function", _, _).
ef_params(p, id, n, st) :- ef_param(p, f, n, st), ef_decl(id, _, f, _, "method", _, _), n != "self", n != "cls".
ef_type_ident(t, s) :- node(_, t, "identifier", _, _), text(t, s).
ef_type_ident(t, s) :- node(_, t, "type", _, _), inside(x, t, ef_type), node(_, x, "identifier", _, _), text(x, s).
ef_annot(id, s) :- ef_decl(id, _, f, _, k, _, _), k != "class", field(f, "return_type", t), ef_type_ident(t, s).
ef_annot(id, s) :- ef_params(p, id, _, _), field(p, "type", t), ef_type_ident(t, s).
ef_import(d, i, st, m) :- node(d, i, "import_from_statement", st, _), ef_doc(d), ef_module(d, m), node_text(i, s), match("(?s)from\\s+\\S+\\s+import\\s+.*", s).
ef_import_top(i) :- ef_import(_, i, _, _), child(mm, i, _), node(_, mm, "module", _, _).
ef_imp_base(i, 0, b) :- ef_import(_, i, _, _), field(i, "module_name", mn), node(_, mn, "dotted_name", _, _), node_text(mn, b), match("\\S+", b).
ef_imp_base(i, k, r) :- ef_import(_, i, _, _), field(i, "module_name", mn), node(_, mn, "relative_import", _, _), node_text(mn, b), match("\\S+", b), child(mn, ip, _), node(_, ip, "import_prefix", _, _), node_text(ip, pt), k = @strlen(pt), r = @substr(b, k, @sub(@strlen(b), k)).
ef_imp_item(i, o, o) :- ef_import(_, i, _, _), field(i, "name", x), node(_, x, "dotted_name", _, _), node_text(x, o), match("\\S+", o).
ef_imp_item(i, o, a) :- ef_import(_, i, _, _), field(i, "name", x), node(_, x, "aliased_import", _, _), field(x, "name", y), node_text(y, o), match("\\S+", o), field(x, "alias", z), text(z, a).
ef_init_path(d) :- ef_doc(d), doc(d, p, _), match("(?s).*/..[iI][nN][iI][tT]..\\.[pP][yY]", p).
ef_rel_strip(i, s, k) :- ef_imp_base(i, dots, _), dots > 0, ef_import(d, i, _, s), ef_init_path(d), k = @sub(dots, 1).
ef_rel_strip(i, s, dots) :- ef_imp_base(i, dots, _), dots > 0, ef_import(d, i, _, s), !ef_init_path(d).
ef_rel_cut(i, s, r) :- ef_rel_strip(i, s, k), k > 0, r = @rx_replace(s, @concat(@concat("(?:\\.?[^.]+){", @to_string(k)), "}$"), "").
ef_rel_prefix(i, s) :- ef_rel_strip(i, s, 0).
ef_rel_prefix(i, r) :- ef_rel_cut(i, s, r), r != s.
ef_rel_prefix(i, "") :- ef_rel_cut(i, s, s).
ef_imp_cand(i, st, m, n, t) :- ef_import(_, i, st, m), ef_imp_base(i, 0, b), ef_imp_item(i, o, n), t = @concat(@concat(b, "."), o).
ef_imp_cand(i, st, m, n, t) :- ef_import(_, i, st, m), ef_imp_base(i, k, r), k > 0, ef_imp_item(i, o, n), ef_rel_prefix(i, p), ef_imp_join(p, r, o, t).
ef_imp_join(p, r, o, t) :- ef_imp_parts(p, r, o), p != "", r != "", t = @concat(@concat(@concat(p, "."), @concat(r, ".")), o).
ef_imp_join(p, r, o, t) :- ef_imp_parts(p, r, o), p = "", r != "", t = @concat(@concat(r, "."), o).
ef_imp_join(p, r, o, t) :- ef_imp_parts(p, r, o), p != "", r = "", t = @concat(@concat(p, "."), o).
ef_imp_join(p, r, o, o) :- ef_imp_parts(p, r, o), p = "", r = "".
ef_imp_parts(p, r, o) :- ef_imp_base(i, k, r), k > 0, ef_imp_item(i, o, _), ef_rel_prefix(i, p).
ef_imp_start(m, n, st) :- ef_imp_cand(_, st, m, n, _).
ef_imp_last(m, n, s) :- ef_imp_start(m, n, _), s = max t : { ef_imp_start(m, n, t) }.
ef_imports(i, m, n, t) :- ef_imp_cand(i, st, m, n, t), ef_imp_last(m, n, st).
ef_reexport(t, fq) :- ef_imports(_, m, n, t), fq = @concat(@concat(m, "."), n), !ef_declared_fq(fq).
ef_resolved(fq, id) :- ef_decl(id, _, _, _, _, _, fq).
ef_resolved(fq, id) :- ef_resolved(t, id), ef_reexport(t, fq).
ef_raw_base(c, b, st, s) :- ef_base_node(d, b, st), ef_doc(d), child(al, b, _), node(_, al, "argument_list", _, _), child(c, al, _), node(_, c, "class_definition", _, _), node_text(b, s).
ef_base_node(d, b, st) :- node(d, b, "identifier", st, _).
ef_base_node(d, b, st) :- node(d, b, "attribute", st, _).
ef_base_node(d, b, st) :- node(d, b, "generic_type", st, _).
ef_base_node(d, b, st) :- node(d, b, "subscript", st, _).
ef_bs_name(s, bn) :- ef_raw_base(_, _, _, s), x = @rx_replace(@rx_replace(s, "(?s)\\[.*$", ""), "^.*\\.", ""), bn = @rx_replace(x, "^ +| +$", ""), bn != "".
ef_base_name(id, m, bn, st) :- ef_raw_base(c, _, st, s), ef_decl(id, _, c, _, _, m, _), ef_bs_name(s, bn).
ef_bv_import(id, o, b) :- ef_base_name(id, m, bn, o), ef_imports(_, m, bn, t), ef_decl(b, _, _, _, "class", _, t).
ef_bv_module(id, o, b) :- ef_base_name(id, m, bn, o), ef_decl(b, _, _, bn, "class", m, _).
ef_class_named(n, id) :- ef_decl(id, _, _, n, "class", _, _).
ef_unique_class(n, id) :- ef_class_named(n, id), k = count : { ef_class_named(n, _) }, k = 1.
ef_has_bv_import(id, o) :- ef_bv_import(id, o, _).
ef_has_bv_module(id, o) :- ef_bv_module(id, o, _).
ef_base_edge(id, b, o) :- ef_bv_import(id, o, b).
ef_base_edge(id, b, o) :- ef_bv_module(id, o, b), !ef_has_bv_import(id, o).
ef_base_edge(id, b, o) :- ef_base_name(id, _, bn, o), ef_unique_class(bn, b), !ef_has_bv_import(id, o), !ef_has_bv_module(id, o).
ef_class_id(id) :- ef_decl(id, _, _, _, "class", _, _).
ef_walk(o, o, "0123456789012345678901234567890123456789012345678901234567890123") :- ef_class_id(o).
ef_walk(o, b, t2) :- ef_walk(o, x, t), @strlen(t) > 1, ef_base_edge(x, b, _), t2 = @substr(t, 1, @sub(@strlen(t), 1)).
ef_walk_k(o, b, k) :- ef_walk(o, b, t), k = @sub(64, @strlen(t)).
ef_depth(o, b, k) :- ef_walk_k(o, b, _), k = min j : { ef_walk_k(o, b, j) }.
ef_hop(o, c, e, x) :- ef_depth(o, c, k), k > 0, ef_base_edge(o, x, e), ef_depth(x, c, j), j = @sub(k, 1).
ef_hop_e(o, c, e) :- ef_hop(o, c, _, _), e = min f : { ef_hop(o, c, f, _) }.
ef_first_hop(o, c, e, x) :- ef_hop(o, c, e, x), ef_hop_e(o, c, e).
ef_route_q(x, c1, c2) :- ef_route_q(o, c1, c2), ef_first_hop(o, c1, e, x), ef_first_hop(o, c2, e, x).
ef_route_lt(o, c1, c2) :- ef_route_q(o, c1, c2), ef_first_hop(o, c1, e1, _), ef_first_hop(o, c2, e2, _), e1 < e2.
ef_route_lt(o, c1, c2) :- ef_route_q(o, c1, c2), ef_first_hop(o, c1, e, x), ef_first_hop(o, c2, e, x), ef_route_lt(x, c1, c2).
ef_property(x) :- ef_decorator(x, n), (suffix("property", n) ; suffix(".setter", n) ; suffix(".deleter", n)).
ef_pm_cand(o, n, id, k, c) :- ef_depth(o, c, k), ef_decl(c, _, _, cn, "class", cm, _), ef_decl(id, _, x, n, "method", cm, _), ef_decl_class(id, cn, _), !prefix("_", n), !ef_pm_excluded(n), !ef_property(x).
ef_pm_k(o, n, k) :- ef_pm_cand(o, n, _, _, _), k = min j : { ef_pm_cand(o, n, _, j, _) }.
ef_pm_best(o, n, id, c) :- ef_pm_cand(o, n, id, k, c), ef_pm_k(o, n, k).
ef_route_q(o, c1, c2) :- ef_pm_best(o, n, _, c1), ef_pm_best(o, n, _, c2), c1 != c2.
ef_pm_beaten(o, n, c) :- ef_pm_best(o, n, _, c), ef_pm_best(o, n, _, c2), ef_route_lt(o, c2, c).
ef_public(o, n, id) :- ef_pm_best(o, n, id, c), !ef_pm_beaten(o, n, c).
ef_all(d, a, st) :- node(d, a, "assignment", st, _), ef_dl(d), field(a, "left", l), node(_, l, "identifier", _, _), text(l, "__all__"), child(es, a, _), node(_, es, "expression_statement", _, _), !inside(a, _, ef_all_block).
ef_has_all(d) :- ef_all(d, _, _).
ef_all_first(d, a) :- ef_all(d, a, st), st = min t : { ef_all(d, _, t) }.
ef_all_array(a, v) :- ef_all_first(_, a), field(a, "right", r), node(_, r, "list", _, _), child(r, v, _).
ef_all_array(a, v) :- ef_all_first(_, a), field(a, "right", r), node(_, r, "tuple", _, _), child(r, v, _).
ef_all_name(d, s) :- ef_all_first(d, a), ef_all_array(a, v), node(_, v, "string", _, _), value(v, s).
ef_all_name(d, s) :- ef_all_first(d, a), ef_all_array(a, v), node(_, v, "concatenated_string", _, _), value(v, s).
ef_export(d, m, n, t) :- ef_imports(i, m, n, t), ef_import_top(i), node(d, i, _, _, _), ef_dl(d).
ef_export(d, m, n, fq) :- ef_decl(_, d, _, n, k, m, fq), k != "method", ef_dl(d).
ef_root(d, m, n, id) :- ef_export(d, m, n, t), ef_resolved(t, id), !prefix("_", n), !ef_has_all(d).
ef_root(d, m, n, id) :- ef_export(d, m, n, t), ef_resolved(t, id), !prefix("_", n), ef_all_name(d, n).
ef_exported(id) :- ef_root(_, _, _, id).
ef_xname(s) :- ef_xcallee(_, s), (s = "_fetchall" ; s = "_fetchone" ; s = "execute" ; s = "execute_async" ; s = "execute_fire_and_forget" ; s = "execute_grammar" ; s = "execute_grammar_fetchall" ; s = "execute_grammar_fetchone" ; s = "execute_raw" ; s = "fetchall" ; s = "fetchall_raw" ; s = "fetchone" ; s = "fetchone_raw" ; s = "grammar_effect_lazy" ; s = "grammar_fetchall" ; s = "grammar_fetchall_async" ; s = "grammar_fetchone" ; s = "grammar_fetchone_async" ; s = "grammar_row_lazy" ; s = "grammar_rows_lazy" ; s = "raw_execute").
ef_xname(s) :- ef_xcallee(_, s), (prefix("execute_grammar", s) ; prefix("grammar_fetch", s)).
ef_xcallee(cl, s) :- node(d, cl, "call", _, _), ef_doc(d), field(cl, "function", fn), node(_, fn, "identifier", _, _), text(fn, s).
ef_xcallee(cl, s) :- node(d, cl, "call", _, _), ef_doc(d), field(cl, "function", fn), node(_, fn, "attribute", _, _), field(fn, "attribute", a), text(a, s).
ef_xlazy(s) :- ef_xname(s), suffix("_lazy", s).
ef_xlazy(s) :- ef_xname(s), prefix("lazy_", s).
ef_xdeco_fn(f) :- ef_func(_, f, _), child(dd, f, _), node(_, dd, "decorated_definition", _, _), child(dd, x, _), node(_, x, "decorator", _, _), node_text(x, s), match("(?s)@\\s*(?:\\w+\\.)*direct_legacy.*", s).
ef_xcall(f, s) :- ef_xcallee(cl, s), ef_xlazy(s), inside(cl, b, ef_blk), child(f, b, _), ef_xdeco_fn(f).
ef_own_deco(id, n) :- ef_decl(id, _, x, _, _, _, _), ef_decorator(x, n).
ef_scoped_deco(id, n) :- ef_own_deco(id, n).
ef_scoped_deco(id, n) :- ef_decl_class(id, _, c), ef_decorator(c, n).
ef_legacy_sync(id) :- ef_own_deco(id, n), (suffix("legacy_sync", n) ; suffix("legacy_module_sync", n) ; suffix("direct_legacy_module_sync", n)).
ef_legacy_async(id) :- ef_own_deco(id, n), (suffix("legacy_async", n) ; suffix("legacy_module_async", n) ; suffix("direct_legacy_module_async", n)).
ef_lazy_deco(n) :- ef_scoped_deco(_, n), (contains("pure_lazy", n) ; contains("apply_lazy_to_public_lazy_methods", n)).
ef_lazy_deco(n) :- ef_scoped_deco(_, n), n = "lazy".
ef_lazy_deco(n) :- ef_scoped_deco(_, n), suffix(".lazy", n).
ef_lazy_decorated(id) :- ef_own_deco(id, n), ef_lazy_deco(n).
ef_lazy_decorated(id) :- ef_decl(id, _, _, name, _, _, _), !prefix("_", name), suffix("_lazy", name), ef_scoped_deco(id, n), ef_lazy_deco(n).
ef_private(id) :- ef_scoped_deco(id, n), (n = "internal_api" ; n = "private_api" ; n = "private_public_api").
ef_private(id) :- ef_scoped_deco(id, n), (suffix(".internal_api", n) ; suffix(".private_api", n) ; suffix(".private_public_api", n)).
ef_abstract(id) :- ef_own_deco(id, n), suffix("abstractmethod", n).
ef_lazy_annot(id) :- ef_annot(id, a), match("(?i)lazyresult|lazyseq|serverplan", a).
ef_lazy_module_exc(id) :- ef_decl(id, d, _, n, "function", _, _), doc(d, p, _), ef_lazy_module(p), prefix("lazy_", n), suffix("_lazy", n).
ef_lazy_module_exc(id) :- ef_decl(id, d, _, n, "function", _, _), doc(d, p, _), ef_lazy_module(p), prefix("lazy_", n), ef_lazy_annot(id).
ef_ctx_exc(id) :- ef_decl(id, d, _, _, _, _, _), doc(d, p, _), ef_ctx_path(p), ef_decl_class(id, c, _), ef_ctx_class(c).
ef_rt(id, s) :- ef_decl_class(id, _, _), ef_decl(id, _, x, _, _, _, _), ef_func_ret(x, s).
ef_rt_u(s, u) :- ef_rt(_, s), u = @rx_replace(s, "^[ '\"]+|[ '\"]+$", "").
ef_self_ret(id) :- ef_rt(id, s), ef_rt_u(s, u), ef_decl_class(id, c, _), u = c.
ef_self_ret(id) :- ef_rt(id, s), ef_rt_u(s, u), ef_decl_class(id, c, _), @strlen(u) > @strlen(c), @substr(u, 0, @add(@strlen(c), 1)) = @concat(c, "[").
ef_base_of(n, b) :- ef_decl(_, _, _, n, _, _, _), b = @rx_replace(n, "_(?:lazy|async|sync)$", "").
ef_surface_ctx(id) :- ef_decl(id, d, _, _, _, _, _), doc(d, p, _), (contains("/graph_query", p) ; contains("/schema_transaction", p) ; contains("/transaction", p) ; contains("/versioned_transactions", p)).
ef_surface_ctx(id) :- ef_decl_class(id, c, _), (icontains("connection", c) ; icontains("query", c) ; icontains("schematransaction", c) ; icontains("transaction", c) ; icontains("versioned", c)).
ef_surface_ctx(id) :- ef_annot(id, a), match("(?i)databaseconnection|lazyresult|lazyseq|readtransaction|serverplan|versioneddatabaseconnection|versionedreadtransaction|versionedwritetransaction|writetransaction", a).
ef_surface_reason(id) :- ef_decl(id, _, _, n, _, _, _), ef_base_of(n, b), ef_verb(b), ef_surface_ctx(id).
ef_surface_reason(id) :- ef_decl(id, _, _, n, _, _, _), suffix("_lazy", n).
ef_surface_reason(id) :- ef_lazy_annot(id).
ef_surface_reason(id) :- ef_legacy_sync(id).
ef_surface_reason(id) :- ef_legacy_async(id).
ef_exec_surface(id) :- ef_surface_reason(id), !ef_abstract(id), !ef_private(id), !ef_lazy_module_exc(id), !ef_ctx_exc(id), !ef_self_ret(id).
ef_pbefore(p, q) :- ef_params(p, id, _, sp), ef_params(q, id, _, sq), sq < sp.
ef_ppos(id, i, n) :- ef_params(p, id, n, _), i = count : { ef_pbefore(p, _) }.
ef_plen(id, k) :- ef_decl(id, _, _, _, _, _, _), k = count : { ef_params(_, id, _, _) }.
ef_direct_wrapper(id) :- ef_own_deco(id, n), match("(?:.*\\.)?direct_legacy[^.]*", n), ef_decl(id, _, x, _, _, _, _), ef_xcall(x, _).
ef_mixed(n) :- ef_decl(_, _, _, n, _, _, _), icontains("lazy", n), (icontains("async", n) ; icontains("sync", n)).
ef_surf("function", m, en, id, n) :- ef_root(_, m, en, id), ef_decl(id, d, _, n, "function", _, _), !prefix("_", n), doc(d, p, _), !prefix("_internal/", p).
ef_surf("method", cn, n, id, n) :- ef_exported(c), ef_decl(c, _, cx, cn, "class", _, _), ef_public(c, _, id), ef_decl(id, _, _, n, _, _, _), !ef_private(c), !ef_private(id), !suffix("Protocol", cn), !prefix("Async", cn), !ef_protocol_base(cx).
ef_protocol_base(c) :- ef_raw_base(c, _, _, s), contains("Protocol", s).
ef_sb(sc, o, ord, id, n, n) :- ef_surf(sc, o, ord, id, n), ef_mixed(n).
ef_sb(sc, o, ord, id, n, b) :- ef_surf(sc, o, ord, id, n), !ef_mixed(n), ef_base_of(n, b).
ef_slotrow("method", o, b, "__invalid_mixed_name__", ord, id) :- ef_sb("method", o, ord, id, n, b), ef_mixed(n).
ef_slotrow(sc, o, b, "lazy", ord, id) :- ef_sb(sc, o, ord, id, n, b), !ef_mixed(n), suffix("_lazy", n).
ef_slotrow(sc, o, b, "async", ord, id) :- ef_sb(sc, o, ord, id, n, b), !ef_mixed(n), !suffix("_lazy", n), suffix("_async", n).
ef_slotrow(sc, o, b, "async", ord, id) :- ef_sb(sc, o, ord, id, n, b), !ef_mixed(n), !suffix("_lazy", n), !suffix("_async", n), ef_legacy_async(id).
ef_slotrow(sc, o, b, "sync", ord, id) :- ef_sb(sc, o, ord, id, n, b), !ef_mixed(n), !suffix("_lazy", n), !suffix("_async", n), !ef_legacy_async(id).
ef_oc_q(a, c) :- ef_slotrow(sc, o, b, _, a, _), ef_slotrow(sc, o, b, _, c, _), a != c.
ef_slot_notlast(sc, o, b, sl, a) :- ef_slotrow(sc, o, b, sl, a, _), ef_slotrow(sc, o, b, sl, c, _), ef_oc_lt(a, c).
ef_slot_notfirst(sc, o, b, sl, a) :- ef_slotrow(sc, o, b, sl, a, _), ef_slotrow(sc, o, b, sl, c, _), ef_oc_lt(c, a).
ef_slots(sc, o, b, sl, id) :- ef_slotrow(sc, o, b, sl, a, id), !ef_slot_notlast(sc, o, b, sl, a).
ef_slot_first(sc, o, b, sl, a) :- ef_slotrow(sc, o, b, sl, a, _), !ef_slot_notfirst(sc, o, b, sl, a).
ef_ex_beaten(sc, o, b, sl) :- ef_slot_first(sc, o, b, sl, f), ef_slot_first(sc, o, b, sl2, f2), sl2 != sl, ef_oc_lt(f2, f).
ef_exemplar(sc, o, b, id) :- ef_slot_first(sc, o, b, sl, _), !ef_ex_beaten(sc, o, b, sl), ef_slots(sc, o, b, sl, id).
ef_gslot(sc, o, b, sl) :- ef_slots(sc, o, b, sl, _).
ef_gmixed(sc, o, b) :- ef_slots(sc, o, b, _, id), ef_decl(id, _, _, n, _, _, _), ef_mixed(n).
ef_gsurface(sc, o, b) :- ef_slots(sc, o, b, _, id), ef_exec_surface(id).
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), (b = "plan" ; b = "query" ; b = "query_unfiltered"), ef_decl(ex, d, _, _, _, _, _), doc(d, p, _), (p = "l2050_transaction/transaction.py" ; p = "l7200_versioned_transactions/versioned_transactions.py"), (o = "ReadTransaction" ; o = "WriteTransaction" ; o = "LazyVersionedReadTransaction" ; o = "LazyVersionedWriteTransaction").
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), o = "CacheTransaction", (b = "commit" ; b = "rollback").
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), o = "BaseMigration", b = "rollback".
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), b = "execute_ddl", (o = "SchemaTransaction" ; o = "AsyncSchemaTransaction").
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), b = "execute_ddl", ef_decl(ex, d, _, _, _, _, _), doc(d, "l2000_connection/schema_transaction.py", _).
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), suffix("Connection", o), b = "table_exists".
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), ef_lazy_only(sc, o, b), icontains("bootstrap", b).
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), ef_lazy_only(sc, o, b), icontains("bootstrap", o).
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), ef_lazy_only(sc, o, b), (b = "check_ddl_lockdown" ; b = "column_exists" ; b = "physical_table_exists_many" ; b = "seal_table_exists_cache").
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), (o = "LazyVersionedReadTransaction" ; o = "LazyVersionedWriteTransaction" ; o = "SyncSessionHandle" ; o = "AsyncSessionHandle" ; o = "SyncVersionHandle" ; o = "AsyncVersionHandle").
ef_excepted(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), match("(?:Sync|Async|Lazy).*(?:Transaction|SchemaTransaction|SessionHandle|VersionHandle)", o).
ef_lazy_only(sc, o, b) :- ef_gslot(sc, o, b, "lazy"), !ef_gslot(sc, o, b, "sync"), !ef_gslot(sc, o, b, "async").
ef_eligible(sc, o, b, ex) :- ef_exemplar(sc, o, b, ex), ef_gmixed(sc, o, b).
ef_eligible(sc, o, b, ex) :- option_on("executionOnly"), ef_exemplar(sc, o, b, ex), !ef_excepted(sc, o, b, ex), ef_gsurface(sc, o, b).
ef_eligible(sc, o, b, ex) :- !option_on("executionOnly"), ef_exemplar(sc, o, b, ex), !ef_excepted(sc, o, b, ex).
ef_ekey(sc, o, b) :- ef_eligible(sc, o, b, _).
ef_impl_missing(sc, b, o1, o2) :- ef_ekey(sc, o1, b), ef_ekey(sc, o2, b), o1 != o2, ef_slots(sc, o1, b, sl, id), !ef_slots(sc, o2, b, sl, id).
ef_same_impl(sc, b, o1, o2) :- ef_ekey(sc, o1, b), ef_ekey(sc, o2, b), o1 != o2, !ef_impl_missing(sc, b, o1, o2), !ef_impl_missing(sc, b, o2, o1).
ef_wc_q(a, c) :- ef_same_impl(_, _, a, c).
ef_dominated(sc, o, b) :- ef_same_impl(sc, b, o, o2), ef_wc_lt(o2, o).
ef_family(sc, o, b, ex) :- ef_eligible(sc, o, b, ex), ef_gmixed(sc, o, b).
ef_family(sc, o, b, ex) :- ef_eligible(sc, o, b, ex), !ef_dominated(sc, o, b).
ef_plain(sc, o, b, ex) :- ef_family(sc, o, b, ex), !ef_gmixed(sc, o, b).
ef_pp(s, l) :- ef_plain(sc, o, b, _), ef_slots(sc, o, b, "sync", s), ef_slots(sc, o, b, "lazy", l).
ef_pp(s, l) :- ef_plain(sc, o, b, _), ef_slots(sc, o, b, "async", s), ef_slots(sc, o, b, "lazy", l).
ef_pp_differ(s, l) :- ef_pp(s, l), ef_plen(s, a), ef_plen(l, c), a != c.
ef_pp_differ(s, l) :- ef_pp(s, l), ef_ppos(s, i, n), ef_ppos(l, i, m), n != m.
ef_same_params(s, l) :- ef_pp(s, l), !ef_pp_differ(s, l).
ef_dw_cand(sc, o, b, id, p, st) :- ef_plain(sc, o, b, _), ef_gslot(sc, o, b, "lazy"), ef_slots(sc, o, b, sl, id), (sl = "sync" ; sl = "async"), ef_direct_wrapper(id), ef_decl(id, d, x, _, _, _, _), doc(d, p, _), node(d, x, _, st, _).
ef_pc_q(p1, p2) :- ef_dw_cand(sc, o, b, _, p1, _), ef_dw_cand(sc, o, b, _, p2, _), p1 != p2.
ef_dw_beaten(sc, o, b, p) :- ef_dw_cand(sc, o, b, _, p, _), ef_dw_cand(sc, o, b, _, p2, _), ef_pc_lt(p2, p).
ef_dw_path(sc, o, b, p) :- ef_dw_cand(sc, o, b, _, p, _), !ef_dw_beaten(sc, o, b, p).
ef_dw_first(sc, o, b, p, s) :- ef_dw_path(sc, o, b, p), s = min t : { ef_dw_cand(sc, o, b, _, p, t) }.
ef_tv("invalid_mixed_lazy_execution_name", id) :- ef_surf("function", _, _, id, n), ef_mixed(n).
ef_tv("invalid_mixed_lazy_execution_name", ex) :- ef_family(sc, o, b, ex), ef_gmixed(sc, o, b).
ef_tv("missing_sync", ex) :- ef_plain(sc, o, b, ex), !ef_gslot(sc, o, b, "sync"), ef_gslot(sc, o, b, "async").
ef_tv("missing_async", ex) :- ef_plain(sc, o, b, ex), !ef_gslot(sc, o, b, "async"), ef_gslot(sc, o, b, "sync").
ef_tv("missing_lazy", ex) :- ef_plain(sc, o, b, ex), !ef_gslot(sc, o, b, "lazy").
ef_tv("missing_legacy_sync", s) :- ef_plain(sc, o, b, _), ef_slots(sc, o, b, "sync", s), ef_slots(sc, o, b, "lazy", l), ef_same_params(s, l), !ef_legacy_sync(s).
ef_tv("missing_legacy_async", s) :- ef_plain(sc, o, b, _), ef_slots(sc, o, b, "async", s), ef_slots(sc, o, b, "lazy", l), ef_same_params(s, l), !ef_legacy_async(s).
ef_tv("missing_lazy_decorator", l) :- ef_plain(sc, o, b, _), ef_slots(sc, o, b, "lazy", l), !ef_lazy_decorated(l).
ef_tv("direct_wrapper_bypasses_lazy_owner", id) :- ef_dw_cand(sc, o, b, id, p, st), ef_dw_first(sc, o, b, p, st).
violation("data-layer-public-api-triples", "exported-families", code, p, l) :- ef_tv(code, id), ef_decl(id, d, x, _, _, _, _), doc(d, p, _), line(x, l).
