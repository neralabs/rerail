complete_identity_compile(g) :- node(_, g, "function_definition", _, _), field(g, "name", nm), node(_, nm, "identifier", _, _), text(nm, "compile").
complete_identity_def(m, m) :- complete_identity_compile(m).
complete_identity_def(m, g) :- node(_, m, "decorated_definition", _, _), child(m, g, _), complete_identity_compile(g).
complete_identity_hit(g, t) :- complete_identity_compile(g), inside(s, g, complete_identity_fdef), node(_, s, k, _, _), complete_identity_strkind(k), value(s, t), complete_identity_key(t), value_type_of(s, "str").
complete_identity_unknown(g) :- complete_identity_compile(g), inside(s, g, complete_identity_fdef), node(_, s, k, _, _), complete_identity_strkind(k), !value_type_of(s, _).
complete_identity_miss(g) :- complete_identity_compile(g), complete_identity_key(t), !complete_identity_hit(g, t).
complete_identity_open(g) :- complete_identity_compile(g), !complete_identity_miss(g).
complete_identity_open(g) :- complete_identity_miss(g), complete_identity_unknown(g).
complete_identity_after(m) :- child(b, m, i), complete_identity_def(m, _), child(b, x, j), j < i, complete_identity_def(x, _).
complete_identity_open_body(b) :- child(b, m, _), complete_identity_def(m, g), !complete_identity_after(m), complete_identity_open(g).
violation("data-layer-readthrough-authority-architecture", "complete-identity", "RTA008", p, l) :- node(d, c, "class_definition", _, _), field(c, "name", nm), node(_, nm, "identifier", _, _), text(nm, "ReadThroughDeleteChangedPrincipalRowsStep"), field(c, "body", b), !complete_identity_open_body(b), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(c, l).
