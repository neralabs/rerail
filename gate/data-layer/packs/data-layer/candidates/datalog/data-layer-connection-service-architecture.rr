option_value("entryPoint", "all").
option_value("parameters", "{}").
in_scope(d) :- doc(d, p, _), glob("l2000_connection/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2200_sql_dialect/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/{sqlite,postgres,mariadb,remote,read_through}/connection.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l5150_fts_polyfill/manager.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test_*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/*_test.py", p).
tape_syntax_error(d) :- syntax_error(d).
violation("data-layer-connection-service-architecture", "source-syntax", "NATIVE-SYNTAX", p, l) :- node(_, n, "module", _, _), node(v1, n, _, _, _), doc(v1, v2, _), never(_), node(d, n, _, _, _), in_scope(d), syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
connection_entry(e) :- option_value("entryPoint", e).
connection_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d).
connection_analysis_path(p) :- connection_doc(_, p), prefix("l2000_connection/", p).
connection_analysis_path(p) :- connection_doc(_, p), prefix("impl/common/l2200_sql_dialect/", p).
connection_slot(f) :- node(_, c, "call", _, _), field(c, "function", f).
connection_slot(o) :- node(_, a, "attribute", _, _), field(a, "object", o).
connection_slot(e) :- node(_, dc, "decorator", _, _), child(dc, e, _), !node(_, e, "comment", _, _).
connection_slot(e) :- connection_stmt(_, s, _), connection_single(s, e).
connection_slot(e) :- node(_, w, "await", _, _), child(w, e, _), !node(_, e, "comment", _, _).
connection_slot(x) :- connection_arg(_, x, _).
connection_slot(x) :- connection_slot(p), node(_, p, "parenthesized_expression", _, _), child(p, x, _), !node(_, x, "comment", _, _).
connection_un(e, e) :- connection_slot(e), !node(_, e, "parenthesized_expression", _, _).
connection_un(e, m) :- connection_slot(e), node(_, e, "parenthesized_expression", _, _), child(e, x, _), !node(_, x, "comment", _, _), connection_un(x, m).
connection_class(d, c, cn) :- node(d, m, "module", _, _), child(m, c, _), node(_, c, "class_definition", _, _), field(c, "name", x), text(x, cn).
connection_class(d, c, cn) :- node(d, m, "module", _, _), child(m, dd, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", c), node(_, c, "class_definition", _, _), field(c, "name", x), text(x, cn).
connection_base_slot(c, b) :- node(_, c, "class_definition", _, _), field(c, "superclasses", al), child(al, b, _), !node(_, b, "keyword_argument", _, _), !node(_, b, "dictionary_splat", _, _), !node(_, b, "comment", _, _).
connection_base_slot(c, x) :- connection_base_slot(c, b), node(_, b, "parenthesized_expression", _, _), child(b, x, _), !node(_, x, "comment", _, _).
connection_base(c, s) :- connection_base_slot(c, b), node(_, b, "identifier", _, _), text(b, s).
connection_base(c, s) :- connection_base_slot(c, b), node(_, b, "attribute", _, _), field(b, "attribute", x), text(x, s).
connection_abstract(c) :- connection_class(_, c, cn), suffix("Protocol", cn).
connection_abstract(c) :- connection_class(_, c, cn), suffix("Contract", cn).
connection_abstract(c) :- connection_class(_, c, cn), suffix("Plan", cn).
connection_abstract(c) :- connection_class(_, c, _), connection_base(c, "Protocol").
connection_abstract(c) :- connection_class(_, c, _), connection_base(c, "TypedDict").
connection_class_start(d, cn, st) :- connection_class(d, c, cn), node(_, c, _, st, _).
connection_first_class(d, c, cn) :- connection_class(d, c, cn), node(_, c, _, st, _), st = min t : { connection_class_start(d, cn, t) }.
connection_method(c, cn, m, mn) :- node(_, c, "class_definition", _, _), field(c, "name", cx), text(cx, cn), field(c, "body", b), child(b, m, _), node(_, m, "function_definition", _, _), field(m, "name", mx), text(mx, mn).
connection_method(c, cn, m, mn) :- node(_, c, "class_definition", _, _), field(c, "name", cx), text(cx, cn), field(c, "body", b), child(b, dd, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", m), node(_, m, "function_definition", _, _), field(m, "name", mx), text(mx, mn).
connection_smethod(d, c, cn, m, mn) :- connection_class(d, c, cn), connection_method(c, cn, m, mn).
connection_method_start(c, mn, st) :- connection_smethod(_, c, _, m, mn), node(_, m, _, st, _).
connection_latest(d, c, cn, m, mn) :- connection_smethod(d, c, cn, m, mn), node(_, m, _, st, _), st = max t : { connection_method_start(c, mn, t) }.
connection_first_method(d, c, cn, m, mn) :- connection_first_class(d, c, cn), connection_smethod(d, c, cn, m, mn), node(_, m, _, st, _), st = min t : { connection_method_start(c, mn, t) }.
connection_async(m) :- node(_, m, "function_definition", _, _), op(m, "async").
connection_deco_root(f, r) :- node(_, f, "function_definition", _, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", f), child(dd, dc, _), node(_, dc, "decorator", _, _), child(dc, r0, _), !node(_, r0, "comment", _, _), connection_un(r0, r).
connection_deco_chain(f, r, r) :- connection_deco_root(f, r).
connection_deco_chain(f, r, y) :- connection_deco_chain(f, r, x), node(_, x, "call", _, _), field(x, "function", y0), connection_un(y0, y).
connection_name_deco(f, r, s) :- connection_deco_chain(f, r, x), node(_, x, "identifier", _, _), text(x, s).
connection_stmt(f, s, i) :- node(_, f, "function_definition", _, _), field(f, "body", b), child(b, s, i), !node(_, s, "comment", _, _).
connection_first_index(f, i) :- connection_stmt(f, _, _), i = min j : { connection_stmt(f, _, j) }.
connection_single(s, e) :- node(_, s, "expression_statement", _, _), child(s, e, _), !node(_, e, "comment", _, _), !node(_, e, "assignment", _, _), !node(_, e, "augmented_assignment", _, _), !connection_several(s).
connection_single(s, e) :- node(_, s, "return_statement", _, _), child(s, e, _), !node(_, e, "comment", _, _), !connection_several(s).
connection_several(s) :- child(s, a, i), child(s, b, j), i < j, !node(_, a, "comment", _, _), !node(_, b, "comment", _, _), node(_, s, "expression_statement", _, _).
connection_several(s) :- child(s, a, i), child(s, b, j), i < j, !node(_, a, "comment", _, _), !node(_, b, "comment", _, _), node(_, s, "return_statement", _, _).
connection_plain(n) :- node(_, n, "string", _, _), !connection_part(n), !connection_fstring(n), value_type_of(n, "str").
connection_plain(n) :- node(_, n, "concatenated_string", _, _), !connection_fpart(n), value_type_of(n, "str").
connection_part(n) :- node(_, c, "concatenated_string", _, _), child(c, n, _).
connection_fstring(n) :- node(_, n, "string", _, _), strprefix(n, p), match("(?s:.*)[fF](?s:.*)", p).
connection_fpart(c) :- node(_, c, "concatenated_string", _, _), child(c, n, _), connection_fstring(n).
connection_str_const(n, v) :- connection_plain(n), value(n, v).
connection_docstring(f, s) :- connection_first_index(f, i), connection_stmt(f, s, i), node(_, s, "expression_statement", _, _), connection_single(s, e0), connection_un(e0, e), connection_plain(e).
connection_body(f, s, i) :- connection_stmt(f, s, i), !connection_docstring(f, s).
connection_body_count(f, k) :- node(_, f, "function_definition", _, _), k = count : { connection_body(f, _, _) }.
connection_body_first(f, s) :- connection_body(f, s, i), i = min j : { connection_body(f, _, j) }.
connection_body_last(f, s) :- connection_body(f, s, i), i = max j : { connection_body(f, _, j) }.
connection_expr(s) :- node(_, s, "expression_statement", _, _), child(s, e, _), !node(_, e, "comment", _, _), !node(_, e, "assignment", _, _), !node(_, e, "augmented_assignment", _, _).
connection_value(s, v) :- connection_single(s, e), connection_un(e, v).
connection_call_value(s) :- connection_value(s, v), node(_, v, "call", _, _).
connection_call_value(s) :- connection_value(s, v), node(_, v, "await", _, _), child(v, x0, _), !node(_, x0, "comment", _, _), connection_un(x0, x), node(_, x, "call", _, _).
connection_delegate(m) :- connection_smethod(_, _, _, m, _), connection_body_last(m, s), node(_, s, "raise_statement", _, _).
connection_delegate(m) :- connection_smethod(_, _, _, m, _), connection_body_count(m, 1), connection_body_first(m, s), node(_, s, "pass_statement", _, _).
connection_delegate(m) :- connection_smethod(_, _, _, m, _), connection_body_count(m, 1), connection_body_first(m, s), connection_expr(s), connection_value(s, v), node(_, v, "ellipsis", _, _).
connection_delegate(m) :- connection_smethod(_, _, _, m, _), connection_body_count(m, 1), connection_body_first(m, s), connection_expr(s), connection_call_value(s).
connection_delegate(m) :- connection_smethod(_, _, _, m, _), connection_body_count(m, 1), connection_body_first(m, s), node(_, s, "return_statement", _, _), connection_call_value(s).
connection_delegate(m) :- connection_smethod(_, _, _, m, _), connection_body_count(m, 2), connection_body_first(m, f), connection_expr(f), connection_body_last(m, s), node(_, s, "return_statement", _, _), connection_call_value(s).
connection_call(c, "Name", s) :- node(_, c, "call", _, _), field(c, "function", f0), connection_un(f0, f), node(_, f, "identifier", _, _), text(f, s).
connection_call(c, "Attribute", s) :- node(_, c, "call", _, _), field(c, "function", f0), connection_un(f0, f), node(_, f, "attribute", _, _), field(f, "attribute", x), text(x, s).
connection_receiver(c, r) :- node(_, c, "call", _, _), field(c, "function", f0), connection_un(f0, f), node(_, f, "attribute", _, _), field(f, "object", o), connection_un(o, r).
connection_arg(c, x, i) :- node(_, c, "call", _, _), field(c, "arguments", al), node(_, al, "argument_list", _, _), child(al, x, i), !node(_, x, "keyword_argument", _, _), !node(_, x, "dictionary_splat", _, _), !node(_, x, "comment", _, _).
connection_arg0_index(c, i) :- connection_arg(c, _, _), i = min j : { connection_arg(c, _, j) }.
connection_arg_at(c, 0, x) :- connection_arg0_index(c, i), connection_arg(c, x0, i), connection_un(x0, x).
connection_arg_at(c, 1, x) :- connection_arg1_index(c, i), connection_arg(c, x0, i), connection_un(x0, x).
connection_arg_later(c, j) :- connection_arg0_index(c, i0), connection_arg(c, _, j), j > i0.
connection_arg1_index(c, i) :- connection_arg_later(c, _), i = min j : { connection_arg_later(c, j) }.
connection_fn_at(c) :- node(_, c, "call", _, _).
connection_fn_at(a) :- node(_, a, "assignment", _, _).
connection_fn(n, f) :- connection_fn_at(n), nearest(n, f, connection_fn_kind), node(_, f, "function_definition", _, _).
connection_fn(n, f) :- connection_fn_at(n), nearest(n, dc, connection_fn_kind), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", f), node(_, f, "function_definition", _, _).
connection_fn(n, f) :- connection_fn_at(n), nearest(n, dc, connection_fn_kind), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", k), node(_, k, "class_definition", _, _), nearest(dd, f, connection_fdef).
connection_chain_top(a, a) :- node(_, a, "assignment", _, _), !connection_chained(a).
connection_chain_top(a, t) :- node(_, p, "assignment", _, _), field(p, "right", a), node(_, a, "assignment", _, _), connection_chain_top(p, t).
connection_chained(a) :- node(_, p, "assignment", _, _), field(p, "right", a), node(_, a, "assignment", _, _).
connection_not_name(n) :- node(_, a, "attribute", _, _), field(a, "attribute", n).
connection_not_name(n) :- node(_, p, "function_definition", _, _), field(p, "name", n).
connection_not_name(n) :- node(_, p, "class_definition", _, _), field(p, "name", n).
connection_not_name(n) :- node(_, p, "keyword_argument", _, _), field(p, "name", n).
connection_not_name(n) :- node(_, p, "default_parameter", _, _), field(p, "name", n).
connection_not_name(n) :- node(_, p, "typed_default_parameter", _, _), field(p, "name", n).
connection_not_name(n) :- node(_, p, "except_clause", _, _), field(p, "alias", n).
connection_not_name(n) :- connection_param_list(p), child(p, n, _), node(_, n, "identifier", _, _).
connection_not_name(n) :- connection_param_list(p), child(p, s, _), connection_splat(s), child(s, n, _), node(_, n, "identifier", _, _).
connection_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, n, _), node(_, n, "identifier", _, _).
connection_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, s, _), connection_splat(s), child(s, n, _), node(_, n, "identifier", _, _).
connection_not_name(n) :- node(_, p, "global_statement", _, _), child(p, n, _).
connection_not_name(n) :- node(_, p, "nonlocal_statement", _, _), child(p, n, _).
connection_not_name(n) :- node(_, n, "identifier", _, _), inside(n, a, connection_import_kind), node(_, a, _, _, _).
connection_param_list(p) :- node(_, p, "parameters", _, _).
connection_param_list(p) :- node(_, p, "lambda_parameters", _, _).
connection_splat(s) :- node(_, s, "list_splat_pattern", _, _).
connection_splat(s) :- node(_, s, "dictionary_splat_pattern", _, _).
connection_named(n, s) :- node(_, n, "identifier", _, _), text(n, s), !connection_not_name(n).
connection_named(a, s) :- node(_, a, "attribute", _, _), field(a, "attribute", x), text(x, s).
connection_target(t) :- node(_, a, "assignment", _, _), field(a, "left", t).
connection_target(t) :- node(_, a, "augmented_assignment", _, _), field(a, "left", t).
connection_target(t) :- node(_, a, "for_statement", _, _), field(a, "left", t).
connection_target(t) :- node(_, a, "for_in_clause", _, _), field(a, "left", t).
connection_target(t) :- node(_, a, "as_pattern_target", _, _), child(a, t, _).
connection_target(e) :- connection_target(t), node(_, t, k, _, _), connection_sequence(k), child(t, e, _), !node(_, e, "comment", _, _).
connection_target(e) :- node(_, s, "delete_statement", _, _), child(s, e, _), !node(_, e, "expression_list", _, _).
connection_target(e) :- node(_, s, "delete_statement", _, _), child(s, l, _), node(_, l, "expression_list", _, _), child(l, e, _).
connection_in_method(x, m) :- connection_smethod(_, _, _, m, _), connection_named(x, _), inside(x, m, connection_fdef).
connection_in_method(x, m) :- connection_smethod(_, _, _, m, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", m), child(dd, dc, _), node(_, dc, "decorator", _, _), connection_named(x, _), inside(x, dc, connection_decorator_kind).
connection_in_function(x, f) :- node(_, f, "function_definition", _, _), node(_, x, "attribute", _, _), inside(x, f, connection_fdef).
connection_in_function(x, f) :- node(_, f, "function_definition", _, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", f), child(dd, dc, _), node(_, dc, "decorator", _, _), node(_, x, "attribute", _, _), inside(x, dc, connection_decorator_kind).
connection_analysis(d, "CONN102", l) :- connection_doc(d, _), node(d, f, "function_definition", _, _), field(f, "name", x), text(x, s), connection_lookup_helper(s), line(f, l).
connection_analysis(d, "CONN600", l) :- connection_doc(d, _), node(d, f, "function_definition", _, _), field(f, "name", x), text(x, s), connection_immediate_reader(s), line(f, l).
connection_analysis(d, "CONN101", l) :- connection_doc(d, _), node(d, a, "attribute", _, _), field(a, "attribute", x), text(x, s), connection_slot_name(s), !connection_target(a), line(a, l).
connection_analysis(d, "CONN102", l) :- connection_doc(d, _), node(d, c, "call", _, _), connection_call(c, _, s), connection_lookup_helper(s), line(c, l).
connection_analysis(d, "CONN500", l) :- connection_doc(d, p), p != "l2000_connection/deferred_imports.py", p != "l2000_connection/schema_transaction_deferred_imports.py", node(d, c, "call", _, _), connection_call(c, _, "load_python_module"), line(c, l).
connection_analysis(d, "CONN102", l) :- connection_doc(d, _), node(d, i, "import_from_statement", _, _), field(i, "name", x), connection_import_name(x, s), connection_lookup_helper(s), line(i, l).
connection_analysis(d, "CONN100", l) :- connection_doc(d, _), connection_probe(c), node(d, c, _, _, _), line(c, l).
connection_analysis(d, "CONN601", l) :- connection_doc(d, "impl/read_through/connection.py"), node(d, c, "call", _, _), connection_call(c, _, "getattr"), connection_arg_at(c, 0, v), node(_, v, "attribute", _, _), field(v, "attribute", x), text(x, s), (s = "_cache" ; s = "_upstream"), field(v, "object", o0), connection_un(o0, o), node(_, o, "identifier", _, _), text(o, "self"), line(c, l).
connection_analysis(d, "CONN200", l) :- connection_latest(d, c, cn, m, mn), !connection_abstract(c), !connection_tx_class(cn), !suffix("_async", mn), connection_twin_name(mn), an = @concat(mn, "_async"), connection_latest(d, c, _, a, an), connection_body_count(m, k), k >= 5, connection_body_count(a, ak), ak >= 5, line(m, l).
connection_analysis(d, "CONN103", l) :- connection_smethod(d, _, cn, m, mn), contains("Connection", cn), !prefix("_", mn), connection_in_method(x, m), connection_named(x, s), connection_probe_name(s), line(m, l).
connection_analysis(d, "CONN103", l) :- connection_smethod(d, _, cn, m, mn), contains("Connection", cn), !prefix("_", mn), connection_async(m), connection_returns_bool(m), connection_positional(m, "table_name"), connection_positional(m, "column_name"), line(m, l).
connection_analysis(d, "CONN300", l) :- connection_owner(d, m, cn, mn), !suffix("Service", cn), k = count : { connection_owner(d, _, _, mn) }, k > 1, line(m, l).
connection_analysis(d, "CONN400", l) :- connection_legacy(d, m, _, stub), !connection_stub_body(m, stub), line(m, l).
connection_analysis(d, "CONN401", l) :- connection_legacy(d, m, _, _), !connection_counterpart(m, _), line(m, l).
connection_analysis(d, "CONN402", l) :- connection_legacy(d, m, _, _), connection_counterpart(m, z), !connection_name_deco(z, _, "pure_lazy"), line(z, l).
connection_import_name(x, s) :- node(_, x, "dotted_name", _, _), name(x, s).
connection_import_name(x, s) :- node(_, x, "aliased_import", _, _), field(x, "name", dn), name(dn, s).
connection_twin_name(s) :- connection_latest(_, _, _, _, s), connection_schema_owned(s).
connection_twin_name(s) :- connection_latest(_, _, _, _, s), prefix("_schema_", s).
connection_twin_name(s) :- connection_latest(_, _, _, _, s), contains("schema", s).
connection_twin_name(s) :- connection_latest(_, _, _, _, s), contains("versioned", s).
connection_twin_name(s) :- connection_latest(_, _, _, _, s), contains("polymorphic", s).
connection_twin_name(s) :- connection_latest(_, _, _, _, s), contains("large_column", s).
connection_twin_name(s) :- connection_latest(_, _, _, _, s), contains("column_exists", s).
connection_returns_bool(m) :- field(m, "return_type", t), node(_, t, "type", _, _), child(t, x, _), node(_, x, "identifier", _, _), text(x, "bool").
connection_param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), node(_, p, "identifier", _, _), text(p, x).
connection_param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), node(_, p, "typed_parameter", _, _), child(p, id, _), node(_, id, "identifier", _, _), text(id, x).
connection_param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), node(_, p, "default_parameter", _, _), field(p, "name", id), node(_, id, "identifier", _, _), text(id, x).
connection_param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), node(_, p, "typed_default_parameter", _, _), field(p, "name", id), text(id, x).
connection_star_at(f, i) :- field(f, "parameters", ps), child(ps, p, i), node(_, p, "list_splat_pattern", _, _).
connection_star_at(f, i) :- field(f, "parameters", ps), child(ps, p, i), node(_, p, "keyword_separator", _, _).
connection_star_at(f, i) :- field(f, "parameters", ps), child(ps, p, i), node(_, p, "typed_parameter", _, _), child(p, s, _), node(_, s, "list_splat_pattern", _, _).
connection_slash_at(f, i) :- field(f, "parameters", ps), child(ps, p, i), node(_, p, "positional_separator", _, _).
connection_positional(f, x) :- connection_param(f, x, i), !connection_star_before(f, i), !connection_slash_after(f, i).
connection_star_before(f, i) :- connection_param(f, _, i), connection_star_at(f, j), j < i.
connection_slash_after(f, i) :- connection_param(f, _, i), connection_slash_at(f, j), j > i.
connection_assign_value(a, v) :- node(_, a, "assignment", _, _), field(a, "right", v), !node(_, v, "assignment", _, _).
connection_assign_value(a, v) :- node(_, a, "assignment", _, _), field(a, "right", r), node(_, r, "assignment", _, _), connection_assign_value(r, v).
connection_slot_string(d, s, e) :- connection_str_const(n, v), connection_slot_name(v), node(d, n, _, s, e).
connection_slot_alias(f, x, s) :- node(d, a, "assignment", _, _), connection_fn(a, f), connection_chain_top(a, s), field(a, "left", t), node(_, t, "identifier", _, _), text(t, x), connection_assign_value(a, v), node(d, v, _, vs, ve), connection_slot_string(d, ks, ke), vs <= ks, ke <= ve.
connection_probe_arg(c, v) :- connection_call(c, _, s), (s = "getattr" ; s = "hasattr"), connection_arg_at(c, 1, v).
connection_probe_arg(c, v) :- connection_call(c, "Attribute", "get"), connection_receiver(c, r), connection_call(r, _, "vars"), connection_arg_at(c, 0, v).
connection_probe(c) :- connection_probe_arg(c, v), node(_, v, "identifier", _, _), text(v, x), connection_fn(c, f), connection_slot_alias(f, x, s), node(rr_earlier1, s, _, _, _), visit_index(s, rr_earlier2), node(rr_earlier1, c, _, _, _), visit_index(c, rr_earlier3), rr_earlier2 < rr_earlier3.
connection_probe(c) :- connection_probe_arg(c, v), connection_str_const(v, s), connection_slot_name(s).
connection_owner(d, m, cn, mn) :- connection_smethod(d, c, cn, m, mn), !connection_abstract(c), connection_schema_owned(mn), !connection_delegate(m).
connection_owner(d, m, cn, mn) :- connection_smethod(d, c, cn, m, mn), !connection_abstract(c), prefix("_schema_", mn), !connection_delegate(m).
connection_legacy_mode(m, s) :- connection_latest(_, c, _, m, _), !connection_abstract(c), connection_name_deco(m, _, s), (s = "legacy_sync" ; s = "legacy_async").
connection_legacy_both(m) :- connection_legacy_mode(m, "legacy_sync"), connection_legacy_mode(m, "legacy_async").
connection_legacy(d, m, "legacy_sync", "_legacy_delegate_stub") :- connection_legacy_mode(m, "legacy_sync"), !connection_legacy_both(m), node(d, m, _, _, _).
connection_legacy(d, m, "legacy_async", "_legacy_delegate_stub_async") :- connection_legacy_mode(m, "legacy_async"), !connection_legacy_both(m), node(d, m, _, _, _).
connection_stub_body(m, stub) :- connection_legacy(_, m, _, stub), connection_body_count(m, 1), connection_body_first(m, s), connection_expr(s), connection_value(s, v), connection_call(v, _, stub).
connection_lazy_kw(m, rs, ki, v) :- connection_legacy(_, m, mode, _), connection_name_deco(m, r, mode), node(_, r, "call", rs, _), field(r, "arguments", al), child(al, k, ki), node(_, k, "keyword_argument", _, _), field(k, "name", kn), text(kn, "lazy_name"), field(k, "value", v0), connection_str_const(v0, v).
connection_lazy_first(m, v) :- connection_lazy_kw(m, rs, _, _), rs = min t : { connection_lazy_kw(m, t, _, _) }, ki = min j : { connection_lazy_kw(m, rs, j, _) }, connection_lazy_kw(m, rs, ki, v).
connection_lazy_name(m, v) :- connection_lazy_first(m, v), v != "".
connection_lazy_name(m, z) :- connection_legacy(_, m, "legacy_async", _), !connection_lazy_given(m), connection_smethod(_, _, _, m, mn), suffix("_async", mn), z = @concat(@substr(mn, 0, @sub(@strlen(mn), 6)), "_lazy").
connection_lazy_name(m, z) :- connection_legacy(_, m, "legacy_async", _), !connection_lazy_given(m), connection_smethod(_, _, _, m, mn), !suffix("_async", mn), z = @concat(mn, "_lazy").
connection_lazy_name(m, z) :- connection_legacy(_, m, "legacy_sync", _), !connection_lazy_given(m), connection_smethod(_, _, _, m, mn), z = @concat(mn, "_lazy").
connection_lazy_given(m) :- connection_lazy_first(m, v), v != "".
connection_own(m, z) :- connection_lazy_name(m, zn), connection_latest(_, c, _, m, _), connection_latest(_, c, _, z, zn).
connection_counterpart(m, z) :- connection_own(m, z).
connection_counterpart(m, z) :- connection_lazy_name(m, zn), !connection_own(m, _), connection_latest(d, _, cn, m, _), (cn = "SyncSchemaTransaction" ; cn = "AsyncSchemaTransaction"), connection_lazy_class(d, lc), connection_latest(d, lc, "LazySchemaTransaction", z, zn).
connection_lazy_class_start(d, st) :- connection_class(d, c, "LazySchemaTransaction"), node(_, c, _, st, _).
connection_lazy_class(d, c) :- connection_class(d, c, "LazySchemaTransaction"), node(_, c, _, st, _), st = min t : { connection_lazy_class_start(d, t) }.
connection_first_class_named(d, cn) :- connection_first_class(d, _, cn).
connection_first_class_method(d, cn, mn) :- connection_first_class(d, c, cn), connection_method(c, cn, _, mn).
connection_sql(d) :- connection_doc(d, "impl/common/l2200_sql_dialect/sql_connection.py"), !connection_first_class_named(d, "_SqlConnectionCore").
connection_sql(d) :- connection_doc(d, "impl/common/l2200_sql_dialect/sql_connection.py"), connection_first_class_method(d, "_SqlConnectionCore", mn), connection_forbidden_wrapper(mn).
connection_sql(d) :- connection_doc(d, "impl/common/l2200_sql_dialect/sql_connection.py"), connection_required(o, _), !connection_first_class_named(d, o).
connection_sql(d) :- connection_doc(d, "impl/common/l2200_sql_dialect/sql_connection.py"), connection_required(o, mn), connection_first_class_named(d, o), !connection_first_class_method(d, o, mn).
connection_init_has(f, s) :- node(_, f, "function_definition", _, _), field(f, "name", x), text(x, "__init__"), connection_in_function(a, f), field(a, "attribute", y), text(y, s), connection_backend_service(s).
connection_init_assembles(d) :- node(d, f, "function_definition", _, _), connection_init_has(f, _), k = count : { connection_init_has(f, _) }, k = 4.
connection_backend_hit(d) :- connection_doc(d, p), connection_backend(p, o), !connection_first_class_named(d, o).
connection_backend_hit(d) :- connection_doc(d, p), connection_backend(p, o), connection_first_class_method(d, o, mn), mn != "__init__".
connection_backend_hit(d) :- connection_doc(d, p), connection_backend(p, o), connection_first_class_named(d, o), !connection_init_assembles(d).
connection_broad_owner(d, m, p, cn, mn) :- connection_entry("all"), connection_owner(d, m, cn, mn), connection_doc(d, p), connection_analysis_path(p).
connection_broad_owner(d, m, p, cn, mn) :- connection_entry(e), e != "all", connection_owner(d, m, cn, mn), connection_doc(d, p).
connection_owner_pair(mn, p, cn) :- connection_broad_owner(_, _, p, cn, mn).
connection_cross(d, l) :- connection_broad_owner(d, m, _, cn, mn), !suffix("Service", cn), k = count : { connection_owner_pair(mn, _, _) }, k > 1, line(m, l).
schema_facade_class(d, cn) :- connection_first_class_named(d, cn), connection_tx_class(cn).
schema_facade_complete(d) :- connection_doc(d, _), k = count : { schema_facade_class(d, _) }, k = 3.
schema_first_method(d, cn, m, mn) :- connection_first_method(d, _, cn, m, mn).
schema_pure_lazy_ok(d) :- schema_first_method(d, "LazySchemaTransaction", m, "ensure_polymorphic_columns_exist_lazy"), connection_name_deco(m, _, "pure_lazy").
schema_legacy_ok(d) :- schema_first_method(d, "AsyncSchemaTransaction", m, "ensure_polymorphic_columns_exist_async"), connection_name_deco(m, r, "legacy_async"), field(r, "arguments", al), child(al, k, _), node(_, k, "keyword_argument", _, _), field(k, "name", kn), text(kn, "lazy_name"), field(k, "value", v), connection_str_const(v, "ensure_polymorphic_columns_exist_lazy").
schema_facade(d) :- connection_doc(d, _), !schema_facade_complete(d).
schema_facade(d) :- schema_facade_complete(d), !schema_pure_lazy_ok(d).
schema_facade(d) :- schema_facade_complete(d), schema_first_method(d, "SyncSchemaTransaction", _, "ensure_polymorphic_columns_exist").
schema_facade(d) :- schema_facade_complete(d), !schema_legacy_ok(d).
schema_facade(d) :- schema_facade_complete(d), schema_first_method(d, "LazySchemaTransaction", _, "ensure_polymorphic_columns_exist_async").
schema_facade(d) :- schema_facade_complete(d), schema_first_method(d, "SyncSchemaTransaction", _, "ensure_polymorphic_columns_exist_async").
connection_row(d, "CONN000", 1) :- connection_sql(d), connection_entry(e), e = "_lint_sql_services".
connection_row(d, "CONN000", 1) :- connection_sql(d), connection_entry(e), e = "all".
connection_row(d, "CONN000", 1) :- connection_sql(d), connection_entry(e), connection_entry_default(e).
connection_row(d, "CONN000", 1) :- connection_backend_hit(d), connection_entry(e), e = "_lint_backend_cores".
connection_row(d, "CONN000", 1) :- connection_backend_hit(d), connection_entry(e), e = "all".
connection_row(d, "CONN000", 1) :- connection_backend_hit(d), connection_entry(e), connection_entry_default(e).
connection_row(d, i, l) :- connection_analysis(d, i, l), connection_entry("analyze_source").
connection_row(d, i, l) :- connection_analysis(d, i, l), connection_entry("_lint_forbidden_connection_level_schema_methods_for_files"), i = "CONN103".
connection_row(d, i, l) :- connection_analysis(d, i, l), connection_entry(e), e = "all", connection_doc(d, p), connection_analysis_path(p).
connection_row(d, i, l) :- connection_analysis(d, i, l), connection_entry(e), connection_entry_default(e), connection_doc(d, p), connection_analysis_path(p).
connection_row(d, "CONN103", l) :- connection_analysis(d, "CONN103", l), connection_entry(e), e = "all", connection_doc(d, "impl/remote/connection.py").
connection_row(d, "CONN103", l) :- connection_analysis(d, "CONN103", l), connection_entry(e), e = "all", connection_doc(d, "impl/read_through/connection.py").
connection_row(d, "CONN103", l) :- connection_analysis(d, "CONN103", l), connection_entry(e), connection_entry_default(e), connection_doc(d, "impl/remote/connection.py").
connection_row(d, "CONN103", l) :- connection_analysis(d, "CONN103", l), connection_entry(e), connection_entry_default(e), connection_doc(d, "impl/read_through/connection.py").
connection_row(d, "CONN301", l) :- connection_cross(d, l), connection_entry(e), e = "_lint_duplicate_service_ownership_across_files".
connection_row(d, "CONN301", l) :- connection_cross(d, l), connection_entry(e), e = "all".
connection_row(d, "CONN301", l) :- connection_cross(d, l), connection_entry(e), connection_entry_default(e).
connection_row(d, "CONN000", 1) :- schema_facade(d), connection_entry("_lint_schema_transaction_facades_source").
connection_entry_default(e) :- connection_entry(e), e != "analyze_source", e != "_lint_schema_transaction_facades_source", e != "_lint_sql_services", e != "_lint_backend_cores", e != "_lint_duplicate_service_ownership_across_files", e != "_lint_forbidden_connection_level_schema_methods_for_files", e != "all".
violation("data-layer-connection-service-architecture", "connection-services", i, p, l) :- connection_row(d, i, l), doc(d, p, _).
violation("data-layer-connection-service-architecture", "schema-transaction-facades", "CONN000", p, 1) :- connection_entry("all"), schema_facade(d), doc(d, p, _), p = "l2000_connection/schema_transaction.py".
