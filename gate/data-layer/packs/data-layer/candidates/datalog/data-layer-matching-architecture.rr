matching_file_contracts(d) :- matching_file_doc(d), doc(d, p, _), prefix("l1470_matching_contracts/", p).
matching_file_finding(d, "MA020", a) :- matching_file_contracts(d), matching_file_class_field(c, a, x, _, "MatchSpec"), node(d, c, _, _, _), match(".*([aA][rR][tT][iI][fF][aA][cC][tT]|[aA][cC][cC][eE][sS][sS]_[mM][eE][tT][hH][oO][dD]|[pP][hH][yY][sS][iI][cC][aA][lL]|[iI][nN][dD][eE][xX]_[gG][eE][nN][eE][rR][aA][tT][iI][oO][nN]|[wW][aA][tT][eE][rR][mM][aA][rR][kK]).*", x).
matching_file_finding(d, "MA030", a) :- matching_file_contracts(d), matching_file_class_field(c, a, _, v, k), prefix("Match", k), node(d, c, _, _, _), matching_file_lbl_is(v, s), matching_file_recursive(s).
matching_file_finding(d, "MA009", a) :- matching_file_contracts(d), matching_file_class_field(c, a, _, v, k), prefix("Match", k), node(d, c, _, _, _), matching_file_unsafe(v).
matching_file_finding(d, "MA012", c) :- matching_file_contracts(d), matching_file_class(c, k), prefix("Match", k), node(d, c, _, _, _), matching_file_base(c, b), matching_file_lbl_last(b, s), suffix("Protocol", s).
matching_file_finding(d, "MA013", c) :- matching_file_contracts(d), matching_file_class(c, k), prefix("Match", k), node(d, c, _, _, _), matching_file_decorator(c, e), matching_file_decorator_label(e, x), matching_file_lbl_is(x, "dataclass").
matching_file_finding(d, "MA013", c) :- matching_file_contracts(d), matching_file_class(c, k), prefix("Match", k), node(d, c, _, _, _), matching_file_decorator(c, e), matching_file_decorator_label(e, x), matching_file_lbl_dotted(x, "dataclasses.dataclass").
matching_file_decorator_label(e, f) :- matching_file_decorator(_, e), matching_file_call(e, f).
matching_file_decorator_label(e, e) :- matching_file_decorator(_, e), !matching_file_call(e, _).
matching_file_two_targets(a) :- matching_file_target(a, t1), matching_file_target(a, t2), t1 != t2.
matching_file_config(c, a, s) :- matching_file_class(c, _), field(c, "body", b), child(b, x, _), node(_, x, "expression_statement", _, _), child(x, a, 0), matching_file_assign_stmt(a), !field(a, "type", _), matching_file_named_target(a, _, "model_config"), !matching_file_two_targets(a), matching_file_value(a, v), matching_file_call(v, f), matching_file_lbl_is(f, "ConfigDict"), node(_, a, _, s, _).
matching_file_frozen_config(c) :- matching_file_config(c, _, _), s = min t : { matching_file_config(c, _, t) }, matching_file_config(c, a, s), matching_file_value(a, v), matching_file_keyword(v, _, "frozen", k), matching_file_const(k, "bool", "True").
matching_file_finding(d, "MA014", c) :- matching_file_contracts(d), matching_file_class(c, k), prefix("Match", k), node(d, c, _, _, _), matching_file_base(c, b), matching_file_lbl_last(b, s), suffix("BaseModel", s), !matching_file_frozen_config(c).
matching_file_probe(c, f) :- matching_file_call(c, _), inside(c, f, matching_file_kind), matching_file_def(f, _).
matching_file_probe(c, f) :- matching_file_call(c, _), inside(c, k, matching_file_decorator_kind), child(w, k, _), field(w, "definition", f), matching_file_def(f, _).
matching_file_def_call(f, c) :- matching_file_def(f, _), matching_file_call(c, _), matching_file_in(c, f).
matching_file_probe(n, f) :- matching_file_slice_subscript(n), inside(n, f, matching_file_kind), matching_file_def(f, _).
matching_file_probe(n, f) :- matching_file_slice_subscript(n), inside(n, k, matching_file_decorator_kind), child(w, k, _), field(w, "definition", f), matching_file_def(f, _).
