option_value("entryPoint", "all").
option_value("parameters", "{}").
in_scope(d) :- doc(d, p, _), glob("data_layer/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("conform/l5250_matching/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l[0-9][0-9][0-9][0-9]_*/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("data_layer_testing/matching_operator.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
matching_project_scan_sources(0) :- option_value("entryPoint", "scan_sources").
matching_project_scan_sources(0) :- option_value("entryPoint", "_scan_tree").
matching_project_file(d, s) :- doc(d, p, _), in_scope(d), !out_scope(d), source(d, sp), text(sp, s).
matching_project_maintenance(d) :- matching_project_file(d, _), doc(d, p, _), match("(.*/)?l5250_matching/.*", p), !prefix("conform/", p).
matching_project_policy(d) :- matching_project_maintenance(d), matching_project_file(d, s), contains("BranchAwareIndexPolicy", s).
matching_project_any_maintenance(0) :- matching_project_maintenance(_).
matching_project_any_policy(0) :- matching_project_policy(_).
violation("data-layer-matching-architecture", "matching-project-ownership", "MA033", "l5250_matching/maintenance.py", 1) :- !matching_project_scan_sources(0), matching_project_any_maintenance(0), !matching_project_any_policy(0).
violation("data-layer-matching-architecture", "matching-project-ownership", "MA034", "data_layer_testing/matching_operator.py", 1) :- !matching_project_scan_sources(0), doc(d, "data_layer_testing/matching_operator.py", _), matching_project_file(d, s), contains("register_table_hook", s).
matching_file_every_module(0) :- option_value("entryPoint", "scan_sources").
matching_file_every_module(0) :- option_value("entryPoint", "_scan_tree").
matching_file_application_path(p) :- option_json("parameters", k, p), match("/applicationPaths(/[^/]*)?", k).
matching_file_application_root(r) :- option_json("parameters", k, r), match("/applicationRoots(/[^/]*)?", k).
matching_file_candidate(d) :- doc(d, _, _), in_scope(d), !out_scope(d), !cpython_syntax_error(d, _, _), node(d, _, "module", _, _).
matching_file_source_text(d, s) :- matching_file_candidate(d), source(d, sp), text(sp, s).
matching_file_under_root(d) :- matching_file_candidate(d), matching_file_application_root("").
matching_file_under_root(d) :- matching_file_candidate(d), doc(d, p, _), matching_file_application_root(r), q = @concat(r, "/"), prefix(q, p).
matching_file_prefixed(d) :- matching_file_candidate(d), doc(d, p, _), match("(?:data_layer/|impl/common/|conform/l5250_matching/|l[0-9]{4}_[^/]+/)(?s:.*)", p).
matching_file_contract_text(d) :- matching_file_source_text(d, s), match("(?s:.*)(?:data_layer\\.matching|l1470_matching_contracts|l5250_matching|MatchSpec|MatchResult|MatchPhysicalPlanError|MatchAccessMethodKind)(?s:.*)", s).
matching_file_layer_path(d) :- matching_file_candidate(d), doc(d, p, _), match("(?s:.*)(?:(?:^|/)l[0-9٠-٩۰-۹߀-߉०-९০-৯੦-੯૦-૯୦-୯௦-௯౦-౯೦-೯൦-൯෦-෯๐-๙໐-໙༠-༩၀-၉႐-႙០-៩᠐-᠙᥆-᥏᧐-᧙᪀-᪉᪐-᪙᭐-᭙᮰-᮹᱀-᱉᱐-᱙꘠-꘩꣐-꣙꤀-꤉꧐-꧙꧰-꧹꩐-꩙꯰-꯹０-９𐒠-𐒩𐴰-𐴹𑁦-𑁯𑃰-𑃹𑄶-𑄿𑇐-𑇙𑋰-𑋹𑑐-𑑙𑓐-𑓙𑙐-𑙙𑛀-𑛉𑜰-𑜹𑣠-𑣩𑥐-𑥙𑱐-𑱙𑵐-𑵙𑶠-𑶩𑽐-𑽙𖩠-𖩩𖫀-𖫉𖭐-𖭙𝟎-𝟿𞅀-𞅉𞋰-𞋹𞓰-𞓹𞥐-𞥙🯰-🯹]{4}_)(?s:.*)", p).
