matching_file_raw_sql(d, c) :- matching_file_callee(c, _, x), (x = "execute" ; x = "executemany"), matching_file_arg(c, a, 0), matching_file_joined(a), node(d, c, _, _, _).
rr_agg12(d, x) :- matching_file_raw_sql(d, c), line(c, x).
matching_file_finding_line(d, "MA027", l) :- matching_file_implementation(d), matching_file_raw_sql(d, _), l = min x : { rr_agg12(d, x) }.
matching_file_resolution(d, n) :- matching_file_attr(n, _, v), matching_file_lbl_is(v, q), matching_file_physical_kind(q), node(d, n, _, _, _).
