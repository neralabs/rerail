matching_file_first(d, "MA040", f, c) :- matching_file_implementation(d), matching_file_def(f, x), contains("candidate", x), matching_file_def_call(f, c), matching_file_callee(c, _, "SqlIsNull"), matching_file_in(k, c), matching_file_attr(k, "candidate_kernel", _), node(d, f, _, _, _).
matching_file_first(d, "MA029", f, c) :- matching_file_implementation(d), matching_file_def(f, x), match(".*([dD][eE][dD][uU][pP][lL][iI][cC][aA][tT]|[rR][aA][nN][kK]).*", x), matching_file_def_call(f, c), matching_file_callee(c, _, y), (y = "sorted" ; y = "setdefault"), node(d, f, _, _, _).
matching_file_first(d, "MA022", f, n) :- matching_file_implementation(d), matching_file_def(f, x), match(".*[pP][aA][gG][iI][nN][aA][tT].*", x), matching_file_def_node(f, n), node(d, f, _, _, _).
matching_file_probe(k, a) :- matching_file_arg(c, a, _), matching_file_binop(a, _, _, _), matching_file_callee(c, _, _), node(d, a, _, _, _), node(d, k, _, _, _), matching_file_constant(k).
matching_file_constant_arg(c) :- matching_file_arg(c, a, _), matching_file_constant(a).
matching_file_constant_arg(c) :- matching_file_arg(c, a, _), matching_file_binop(a, _, _, _), matching_file_in(k, a), matching_file_constant(k).
