matching_file_finding(d, "MA035", c) :- matching_file_implementation(d), matching_file_callee(c, _, "SqlBinaryOp"), matching_file_in(x, c), matching_file_name(x, "pair_count"), matching_file_in(y, c), matching_file_attr(y, "expression_node_count", _), node(d, c, _, _, _).
matching_file_poll(x) :- matching_file_node(x), node(_, x, "for_statement", _, _).
matching_file_poll(x) :- matching_file_node(x), node(_, x, "while_statement", _, _).
matching_file_poll(x) :- matching_file_attr(x, "wait_limit", _).
