.scope text "**/*.[mM][dD]", "**/*.[mM][aA][rR][kK][dD][oO][wW][nN]", "**/*.[rR][sS][tT]", "**/*.[tT][xX][tT]", "**/*.[tT][oO][mM][lL]", "**/*.[cC][fF][gG]", "**/*.[iI][nN][iI]", "**/*.[yY][aA][mM][lL]", "**/*.[yY][mM][lL]"
.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl node_text(n: node, s: symbol)
.decl out_scope(d: number)
.decl sas_after_star(q: node)
.decl sas_ann_any(n: node)
.decl sas_ann_conn(n: node)
.decl sas_ann_txn(n: node)
.decl sas_any_name(s: symbol)
.decl sas_before_slash(q: node)
.decl sas_conn_name(s: symbol)
.decl sas_def(d: number, f: node, name: symbol, s: number, e: number)
.decl sas_earlier_child(g: node, i: number)
.decl sas_first_child(g: node, c: node)
.decl sas_first_param(f: node, q: node)
.decl sas_has_param(f: node)
.decl sas_last(d: number, f: node, name: symbol)
.decl sas_later_pos(q: node)
.decl sas_leaf(n: node, s: symbol)
.decl sas_left_any(n: node)
.decl sas_named_param(q: node)
.decl sas_pos_param(ps: node, q: node, i: number)
.decl sas_splat(q: node)
.decl sas_splat_kind(x: node)
.decl sas_star(z: node)
.decl sas_string_kind(n: node)
.decl sas_superseded(f: node)
.decl sas_sync_key(d: number, k: symbol)
.decl sas_txn_name(s: symbol)
.decl syntax_error(d: number)
.decl tape_syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, syntax_error, node, field, child, text, line, value, value_type_of, node_text
.output violation
sas_conn_name("Connection").
