out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
tape_syntax_error(d) :- syntax_error(d).
sas_named_param(q) :- node(_, q, "identifier", _, _), text(q, s), s != "self".
sas_named_param(q) :- node(_, q, "typed_parameter", _, _), child(q, x, _), node(_, x, "identifier", _, _), text(x, s), s != "self".
sas_named_param(q) :- node(_, q, "default_parameter", _, _), field(q, "name", x), node(_, x, "identifier", _, _), text(x, s), s != "self".
sas_named_param(q) :- node(_, q, "typed_default_parameter", _, _), field(q, "name", x), node(_, x, "identifier", _, _), text(x, s), s != "self".
sas_splat(q) :- sas_splat_kind(q).
sas_splat(q) :- node(_, q, "typed_parameter", _, _), child(q, x, _), sas_splat_kind(x).
sas_splat_kind(x) :- node(_, x, "list_splat_pattern", _, _).
sas_splat_kind(x) :- node(_, x, "dictionary_splat_pattern", _, _).
sas_before_slash(q) :- child(ps, q, i), child(ps, z, j), j > i, node(_, z, "positional_separator", _, _).
sas_star(z) :- node(_, z, "keyword_separator", _, _).
sas_star(z) :- node(_, z, "list_splat_pattern", _, _).
sas_star(z) :- node(_, z, "typed_parameter", _, _), child(z, x, _), node(_, x, "list_splat_pattern", _, _).
sas_after_star(q) :- child(ps, q, i), child(ps, z, j), j < i, sas_star(z).
sas_pos_param(ps, q, i) :- node(_, ps, "parameters", _, _), child(ps, q, i), sas_named_param(q), !sas_splat(q), !sas_before_slash(q), !sas_after_star(q).
sas_has_param(f) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), sas_pos_param(ps, _, _).
sas_later_pos(q) :- sas_pos_param(ps, q, i), sas_pos_param(ps, _, j), j < i.
sas_first_param(f, q) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), sas_pos_param(ps, q, _), !sas_later_pos(q).
sas_any_name(s) :- sas_conn_name(s).
sas_any_name(s) :- sas_txn_name(s).
sas_leaf(n, s) :- node(_, n, "identifier", _, _), text(n, s).
sas_leaf(n, s) :- node(_, n, "attribute", _, _), field(n, "attribute", x), node(_, x, "identifier", _, _), text(x, s).
sas_leaf(n, s) :- sas_string_kind(n), value(n, s), value_type_of(n, "str").
sas_string_kind(n) :- node(_, n, "string", _, _).
sas_string_kind(n) :- node(_, n, "concatenated_string", _, _).
sas_first_child(g, c) :- node(_, g, "generic_type", _, _), child(g, c, i), !sas_earlier_child(g, i).
sas_earlier_child(g, i) :- node(_, g, "generic_type", _, _), child(g, _, i), child(g, _, j), j < i.
sas_ann_any(n) :- sas_leaf(n, s), sas_any_name(s).
sas_ann_any(n) :- node(_, n, "type", _, _), child(n, c, _), sas_ann_any(c).
sas_ann_any(n) :- sas_first_child(n, c), sas_ann_any(c).
sas_ann_any(n) :- node(_, n, "subscript", _, _), field(n, "value", c), sas_ann_any(c).
sas_ann_any(n) :- node(_, n, "binary_operator", _, _), field(n, "left", c), sas_ann_any(c).
sas_ann_any(n) :- node(_, n, "binary_operator", _, _), field(n, "right", c), sas_ann_any(c).
sas_left_any(n) :- node(_, n, "binary_operator", _, _), field(n, "left", c), sas_ann_any(c).
sas_ann_conn(n) :- sas_leaf(n, s), sas_conn_name(s).
sas_ann_conn(n) :- node(_, n, "type", _, _), child(n, c, _), sas_ann_conn(c).
sas_ann_conn(n) :- sas_first_child(n, c), sas_ann_conn(c).
sas_ann_conn(n) :- node(_, n, "subscript", _, _), field(n, "value", c), sas_ann_conn(c).
sas_ann_conn(n) :- node(_, n, "binary_operator", _, _), field(n, "left", c), sas_ann_conn(c).
sas_ann_conn(n) :- node(_, n, "binary_operator", _, _), !sas_left_any(n), field(n, "right", c), sas_ann_conn(c).
sas_ann_txn(n) :- sas_leaf(n, s), sas_txn_name(s).
sas_ann_txn(n) :- node(_, n, "type", _, _), child(n, c, _), sas_ann_txn(c).
sas_ann_txn(n) :- sas_first_child(n, c), sas_ann_txn(c).
sas_ann_txn(n) :- node(_, n, "subscript", _, _), field(n, "value", c), sas_ann_txn(c).
sas_ann_txn(n) :- node(_, n, "binary_operator", _, _), field(n, "left", c), sas_ann_txn(c).
sas_ann_txn(n) :- node(_, n, "binary_operator", _, _), !sas_left_any(n), field(n, "right", c), sas_ann_txn(c).
sas_def(d, f, t, s, e) :- node(d, f, "function_definition", s, e), sas_has_param(f), field(f, "name", nm), text(nm, t).
sas_superseded(f) :- sas_def(d, f, t, _, e), sas_def(d, _, t, s2, _), s2 >= e.
sas_last(d, f, t) :- sas_def(d, f, t, _, _), !sas_superseded(f).
sas_sync_key(d, k) :- sas_last(d, f, b), sas_first_param(f, q), field(q, "type", t), sas_ann_txn(t), k = @concat(b, "_async").
violation("data-layer-sync-async-signatures", "transaction-connection", "sync_async_signature_mismatch", p, l) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), sas_last(d, f, k), sas_sync_key(d, k), field(f, "name", nm), node_text(nm, s), match(".*_async", s), sas_first_param(f, q), field(q, "type", t), sas_ann_conn(t), line(f, l).
