m4($n) :- node(_, $n, "identifier", _, _), text($n, $v1), $v1 = "ClassVar".
m4($n) :- node(_, $n, "attribute", _, _), field($n, "attribute", $v2), node(_, $v2, "identifier", _, _), text($v2, $v3), $v3 = "ClassVar".
.output violation
