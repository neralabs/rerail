m10(n) :- node(_, n, "import_statement", _, _).
m10(n) :- node(_, n, "import_from_statement", _, _).
m10(n) :- node(_, n, "global_statement", _, _).
m10(n) :- node(_, n, "nonlocal_statement", _, _).
m20(n) :- inside(n, v9, k0), m10(v9).
