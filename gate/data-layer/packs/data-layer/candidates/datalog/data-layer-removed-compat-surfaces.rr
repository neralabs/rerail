in_scope(d) :- doc(d, p, _), glob("data_layer/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l4100_queue/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l4400_scheduler/**/*.py", p).
