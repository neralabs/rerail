option_on("sourceGate").
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("data_layer/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("_internal/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l[0-9][0-9][0-9][0-9]_*/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test_*.py", p).
tape_syntax_error(d) :- syntax_error(d).
m13(n) :- node(_, n, "identifier", _, _), text(n, v10), (v10 = "open_provider_read_plan" ; v10 = "open_provider_versioned_read_plan" ; v10 = "open_provider_versioned_write_plan" ; v10 = "open_provider_write_plan" ; v10 = "open_read_plan" ; v10 = "open_write_plan").
m13(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v11), node(_, v11, "identifier", _, _), text(v11, v12), (v12 = "open_provider_read_plan" ; v12 = "open_provider_versioned_read_plan" ; v12 = "open_provider_versioned_write_plan" ; v12 = "open_provider_write_plan" ; v12 = "open_read_plan" ; v12 = "open_write_plan").
m19(n) :- node(_, n, "identifier", _, _), text(n, v16), (v16 = "open_provider_read_plan" ; v16 = "open_provider_versioned_read_plan" ; v16 = "open_provider_versioned_write_plan" ; v16 = "open_provider_write_plan" ; v16 = "open_read_plan" ; v16 = "open_write_plan").
m19(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v17), node(_, v17, "identifier", _, _), text(v17, v18), (v18 = "open_provider_read_plan" ; v18 = "open_provider_versioned_read_plan" ; v18 = "open_provider_versioned_write_plan" ; v18 = "open_provider_write_plan" ; v18 = "open_read_plan" ; v18 = "open_write_plan").
m20(n) :- node(_, n, "call", _, _), field(n, "function", v9), m13(v9).
m20(n) :- node(_, n, "as_pattern", _, _), child(n, v14, _), node(_, v14, "call", _, _), field(v14, "function", v15), m19(v15).
u5(n) :- node(_, n, "with_statement", _, _), child(n, v6, _), node(_, v6, "with_clause", _, _), child(v6, v7, _), node(_, v7, "with_item", _, _), field(v7, "value", v8), m20(v8).
blocked4(low, high) :- inside(low, s, k0), u5(s), inside(s, high, k0).
m24(n) :- node(_, n, "module", _, _), node_text(n, v21), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v21).
m24(n) :- inside(n, v22, k1), node(_, v22, "module", _, _), node_text(v22, v23), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v23).
violation("data-layer-plan-scope-side-effects", "eager-value", "PSE-010", p, l) :- node(_, n, "attribute", _, _), field(n, "attribute", v1), node(_, v1, "identifier", _, _), text(v1, v2), v2 = "resolved_value", inside(n, v3, k0), !blocked4(n, v3), u5(v3), m24(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
m29(n) :- node(_, n, "identifier", _, _), text(n, v26), (v26 = "resolve" ; v26 = "resolve_async").
m29(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v27), node(_, v27, "identifier", _, _), text(v27, v28), (v28 = "resolve" ; v28 = "resolve_async").
blocked31(low, high) :- inside(low, s, k0), u5(s), inside(s, high, k0).
m35(n) :- node(_, n, "module", _, _), node_text(n, v32), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v32).
m35(n) :- inside(n, v33, k1), node(_, v33, "module", _, _), node_text(v33, v34), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v34).
violation("data-layer-plan-scope-side-effects", "eager-call", "PSE-020", p, l) :- node(_, n, "call", _, _), field(n, "function", v25), m29(v25), inside(n, v30, k0), !blocked31(n, v30), u5(v30), m35(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
m40(n) :- node(_, n, "identifier", _, _), text(n, v37), (v37 = "execute_raw" ; v37 = "fetchall_raw" ; v37 = "fetchone_raw" ; v37 = "nonportably_execute_sql").
m40(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v38), node(_, v38, "identifier", _, _), text(v38, v39), (v39 = "execute_raw" ; v39 = "fetchall_raw" ; v39 = "fetchone_raw" ; v39 = "nonportably_execute_sql").
blocked42(low, high) :- inside(low, s, k0), u5(s), inside(s, high, k0).
m46(n) :- node(_, n, "module", _, _), node_text(n, v43), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v43).
m46(n) :- inside(n, v44, k1), node(_, v44, "module", _, _), node_text(v44, v45), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v45).
violation("data-layer-plan-scope-side-effects", "raw-database", "PSE-030", p, l) :- node(_, n, "call", _, _), field(n, "function", v36), m40(v36), inside(n, v41, k0), !blocked42(n, v41), u5(v41), m46(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
blocked51(low, high) :- inside(low, s, k0), u5(s), inside(s, high, k0).
m55(n) :- node(_, n, "module", _, _), node_text(n, v52), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v52).
m55(n) :- inside(n, v53, k1), node(_, v53, "module", _, _), node_text(v53, v54), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v54).
violation("data-layer-plan-scope-side-effects", "legacy-callback", "PSE-040", p, l) :- node(_, n, "call", _, _), field(n, "function", v47), node(_, v47, "attribute", _, _), field(v47, "attribute", v48), node(_, v48, "identifier", _, _), text(v48, v49), (v49 = "read" ; v49 = "read_async" ; v49 = "write" ; v49 = "write_async"), inside(n, v50, k0), !blocked51(n, v50), u5(v50), m55(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
m67(n) :- field(n, "attribute", v63), name(v63, v65), (iglob("asyncio", v65) ; iglob("httpx", v65) ; iglob("os", v65) ; iglob("requests", v65) ; iglob("shutil", v65) ; iglob("socket", v65) ; iglob("subprocess", v65) ; iglob("time", v65)).
m67(n) :- field(n, "object", v66), u61(v66).
m70(n) :- node(_, n, "identifier", _, _), text(n, v62), (iglob("asyncio", v62) ; iglob("httpx", v62) ; iglob("os", v62) ; iglob("requests", v62) ; iglob("shutil", v62) ; iglob("socket", v62) ; iglob("subprocess", v62) ; iglob("time", v62)).
m70(n) :- node(_, n, "attribute", _, _), m67(n).
m70(n) :- node(_, n, "call", _, _), field(n, "function", v68), u61(v68).
m70(n) :- node(_, n, "subscript", _, _), field(n, "value", v69), u61(v69).
u61(n) :- m70(n).
m71(n) :- node(_, n, "identifier", _, _), text(n, v57), v57 = "open".
m71(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v58), node(_, v58, "identifier", _, _), text(v58, v59), (v59 = "Popen" ; v59 = "delete" ; v59 = "get" ; v59 = "open" ; v59 = "patch" ; v59 = "post" ; v59 = "put" ; v59 = "request" ; v59 = "run" ; v59 = "sleep"), field(n, "object", v60), u61(v60).
blocked73(low, high) :- inside(low, s, k0), u5(s), inside(s, high, k0).
m77(n) :- node(_, n, "module", _, _), node_text(n, v74), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v74).
m77(n) :- inside(n, v75, k1), node(_, v75, "module", _, _), node_text(v75, v76), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", v76).
violation("data-layer-plan-scope-side-effects", "python-side-effect", "PSE-050", p, l) :- node(_, n, "call", _, _), field(n, "function", v56), m71(v56), inside(n, v72, k0), !blocked73(n, v72), u5(v72), m77(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
branch_audit_callee(c, s) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, s).
branch_audit_callee(c, s) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", x), node(_, x, "identifier", _, _), text(x, s).
branch_audit_opened(v, s) :- branch_audit_callee(v, s).
branch_audit_opened(v, s) :- node(_, v, "as_pattern", _, _), child(v, c, _), branch_audit_callee(c, s).
branch_audit_opens(w, s) :- node(_, w, "with_statement", _, _), child(w, c, _), node(_, c, "with_clause", _, _), child(c, i, _), node(_, i, "with_item", _, _), field(i, "value", v), branch_audit_opened(v, s).
branch_audit_plan(w) :- branch_audit_opens(w, s), branch_audit_open_name(s).
branch_audit_write_plan(w) :- branch_audit_opens(w, s), branch_audit_write_name(s).
branch_audit_typed_read(c) :- branch_audit_callee(c, s), branch_audit_read_name(s).
branch_audit_direct_read(n) :- branch_audit_typed_read(n).
branch_audit_direct_read(n) :- node(_, n, "parenthesized_expression", _, _), child(n, c, _), branch_audit_direct_read(c).
branch_audit_target(a, t) :- node(_, a, "assignment", _, _), field(a, "right", r), branch_audit_typed_read(r), field(a, "left", t).
branch_audit_target(a, t) :- branch_audit_target(a, q), node(_, q, k, _, _), branch_audit_seqk(k), child(q, t, _).
branch_audit_bound(a, s) :- branch_audit_target(a, t), node(_, t, "identifier", _, _), text(t, s).
branch_audit_site(n) :- node(_, n, "if_statement", _, _).
branch_audit_site(a) :- branch_audit_bound(a, _).
branch_audit_under(n, w) :- branch_audit_site(n), inside(n, w, branch_audit_withk), branch_audit_plan(w).
branch_audit_blocked(n, w) :- branch_audit_under(n, w), branch_audit_under(n, s), inside(s, w, branch_audit_withk).
branch_audit_scope(n, w) :- branch_audit_under(n, w), !branch_audit_blocked(n, w), branch_audit_write_plan(w).
branch_audit_cond(i, c) :- branch_audit_scope(i, _), node(_, i, "if_statement", _, _), field(i, "condition", c).
branch_audit_in_cond(i, c) :- branch_audit_cond(i, c).
branch_audit_in_cond(i, n) :- branch_audit_in_cond(i, q), child(q, n, _).
branch_audit_attr_field(x) :- node(_, q, "attribute", _, _), field(q, "attribute", x).
branch_audit_kw_name(x) :- node(_, q, "keyword_argument", _, _), field(q, "name", x).
branch_audit_read_test(i) :- branch_audit_in_cond(i, x), node(_, x, "identifier", _, _), !branch_audit_attr_field(x), !branch_audit_kw_name(x), text(x, s), branch_audit_scope(i, w), node(_, i, _, is, _), branch_audit_bound(a, s), branch_audit_scope(a, w), node(_, a, _, _, ae), ae <= is.
branch_audit_if(i) :- branch_audit_cond(i, c), branch_audit_direct_read(c).
branch_audit_if(i) :- branch_audit_read_test(i).
branch_audit_gate(d) :- doc(d, _, _), !option_on("sourceGate").
branch_audit_gate(d) :- option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, s), match("(?s:.*)(?:open_provider_read_plan|open_provider_versioned_read_plan|open_provider_versioned_write_plan|open_provider_write_plan|open_read_plan|open_write_plan)(?s:.*)", s).
violation("data-layer-plan-scope-side-effects", "branch-audit", "PSE-AUDIT-010", p, l) :- option_on("oracleAnalyzer"), branch_audit_if(i), node(d, i, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), branch_audit_gate(d), doc(d, p, _), line(i, l).
