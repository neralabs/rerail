in_scope(d) :- doc(d, p, _), glob("l2050_transaction/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l2055_lazy_result/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l2060_query_builder/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l2070_batching/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l4000_permissions/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l7000_versioned_schema/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2070_server_plan/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l4100_queue/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l5150_fts_polyfill/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l5200_sql_query/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l5350_hybrid_search/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l7245_versioned_backends/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l7300_sql_versioned_transactions/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l7350_sparse_versioned_transactions/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l9700_sql_graph_query/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
tape_syntax_error(d) :- syntax_error(d).
introspection_text_doc(d) :- node(d, m, "module", _, _), node_text(m, s), introspection_trigger(x), contains(x, s).
introspection_gate(d, p) :- option_value("entryPoint", "_collect_violations"), node(d, _, "module", _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _).
introspection_gate(d, p) :- option_value("entryPoint", v), v != "_collect_violations", node(d, _, "module", _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _), introspection_text_doc(d).
introspection_marked(d) :- doc(d, p, _), introspection_allowed(m), contains(m, p).
introspection_marked(d) :- doc(d, p, _), introspection_rooted(m), prefix(m, p).
introspection_data_path(d) :- doc(d, p, _), introspection_prefix(x), prefix(x, p), !introspection_marked(d).
introspection_doc(d, p) :- introspection_gate(d, p), option_value("entryPoint", "_collect_violations").
introspection_doc(d, p) :- introspection_gate(d, p), option_value("entryPoint", v), v != "_collect_violations", introspection_data_path(d).
introspection_owner(n, f) :- inside(n, f, introspection_fdef).
introspection_owner(n, f) :- inside(n, dc, introspection_deco), child(dd, dc, _), field(dd, "definition", f), node(_, f, "function_definition", _, _).
introspection_frame(n, f) :- nearest(n, f, introspection_frame_mark), node(_, f, "function_definition", _, _).
introspection_frame(n, f) :- nearest(n, dc, introspection_frame_mark), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", f), node(_, f, "function_definition", _, _).
introspection_frame(n, f) :- nearest(n, dc, introspection_frame_mark), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", k), node(_, k, "class_definition", _, _), nearest(dc, f, introspection_fdef).
introspection_authority(n) :- introspection_owner(n, f), field(f, "name", nm), text(nm, x), introspection_word(w), icontains(w, x).
introspection_peel(c, g) :- node(d, c, "call", _, _), introspection_doc(d, _), field(c, "function", g).
introspection_peel(c, i) :- introspection_peel(c, e), node(_, e, "parenthesized_expression", _, _), child(e, i, 0).
introspection_callee(c, x) :- introspection_peel(c, u), node(_, u, "identifier", _, _), text(u, x).
introspection_callee(c, x) :- introspection_peel(c, u), node(_, u, "attribute", _, _), field(u, "attribute", a), text(a, x).
introspection_primitive_call(c) :- introspection_callee(c, x), node(d, c, _, _, _), doc(d, p, _), introspection_frame(c, f), field(f, "name", nm), text(nm, y), introspection_primitive(p, y, x).
introspection_hit(p, l, x) :- introspection_callee(c, x), introspection_flush(x), node(d, c, _, _, _), introspection_doc(d, p), prefix("impl/common/l7245_versioned_backends/", p), line(c, l).
introspection_hit(p, l, x) :- introspection_callee(c, x), introspection_forbidden(x), !introspection_authority(c), !introspection_primitive_call(c), node(d, c, _, _, _), introspection_doc(d, p), line(c, l).
introspection_in_run(s) :- node(_, c, "concatenated_string", _, _), child(c, s, _).
introspection_lit(s) :- node(d, s, "string", _, _), introspection_doc(d, _), !introspection_in_run(s).
introspection_lit(c) :- node(d, c, "concatenated_string", _, _), introspection_doc(d, _).
introspection_fpart(s) :- node(_, s, "string", _, _), strprefix(s, p), contains("f", p).
introspection_f(s) :- introspection_lit(s), introspection_fpart(s).
introspection_f(c) :- introspection_lit(c), child(c, s, _), introspection_fpart(s).
introspection_stmt_peel(st, e) :- node(_, st, "expression_statement", _, _), child(st, e, 0), !child(st, _, 1), !token(st, _, ",", _, _).
introspection_stmt_peel(st, i) :- introspection_stmt_peel(st, e), node(_, e, "parenthesized_expression", _, _), child(e, i, 0).
introspection_stmt_string(n) :- introspection_stmt_peel(_, n).
introspection_const(e, v) :- introspection_lit(e), !introspection_f(e), value_type_of(e, "str"), value(e, v), !introspection_stmt_string(e).
introspection_fhost(e) :- introspection_lit(e), introspection_f(e).
introspection_fhost(s) :- node(d, s, "format_specifier", _, _), introspection_doc(d, _).
introspection_part(s, s) :- introspection_fhost(s), node(_, s, "string", _, _).
introspection_part(e, s) :- introspection_fhost(e), node(_, e, "concatenated_string", _, _), child(e, s, _), node(_, s, "string", _, _).
introspection_field(e, f, b, fe) :- introspection_part(e, s), child(s, f, _), node(_, f, "interpolation", b, fe).
introspection_field(e, f, b, fe) :- introspection_fhost(e), node(_, e, "format_specifier", _, _), child(e, f, _), node(_, f, "format_expression", b, fe).
introspection_item(e, o, l) :- introspection_part(e, s), introspection_fpart(s), child(s, c, _), node(_, c, "string_content", o, _), line(c, l).
introspection_item(e, o, l) :- introspection_part(e, s), !introspection_fpart(s), node(_, s, _, o, _), line(s, l).
introspection_item(e, o, l) :- introspection_field(e, f, b, _), token(f, _, "=", _, _), o = @add(b, 1), line(f, l).
introspection_slice(e, a, l) :- introspection_fhost(e), node(_, e, "format_specifier", s, _), a = @add(s, 1), line(e, l).
introspection_slice(e, a, l) :- introspection_fhost(e), node(_, e, "format_specifier", _, _), introspection_field(e, f, _, a), end_line(f, l).
introspection_item(e, a, l) :- introspection_slice(e, a, l), node(_, e, _, _, k), a < k, !introspection_field(e, _, a, _).
introspection_after(e, o, b) :- introspection_item(e, o, _), introspection_field(e, _, b, fe), fe > o.
introspection_not_next(e, o, b) :- introspection_after(e, o, b), introspection_after(e, o, b2), b2 < b.
introspection_run(e, k, l) :- introspection_item(e, o, l), introspection_after(e, o, k), !introspection_not_next(e, o, k).
introspection_run(e, k, l) :- introspection_item(e, o, l), !introspection_after(e, o, _), node(_, e, _, _, k).
introspection_run_line(e, k, l) :- introspection_run(e, k, _), l = min l2 : { introspection_run(e, k, l2) }.
rr_ctx4(b, e) :- introspection_field(e, _, b, _).
rr_agg3(b, b2, e, rr_any1, rr_any2) :- rr_demand_agg_rr_agg3(b, e), rr_ctx4(b, e), introspection_field(e, rr_any1, b2, rr_any2), b2 < b.
introspection_ford(e, b, j) :- introspection_field(e, _, b, _), j = count : { rr_agg3(b, _, e, _, _) }.
rr_ctx7(e, i) :- fstring_piece(e, i, "interpolation", _).
rr_agg6(e, i, i2, rr_any5) :- rr_demand_agg_rr_agg6(e, i), rr_ctx7(e, i), fstring_piece(e, i2, "interpolation", rr_any5), i2 < i.
introspection_pord(e, i, j) :- introspection_fhost(e), fstring_piece(e, i, "interpolation", _), j = count : { rr_agg6(e, i, _, _) }.
introspection_later(e, i) :- introspection_fhost(e), fstring_piece(e, i, _, _), fstring_piece(e, i2, _, _), i2 > i.
introspection_fconst(e, v, l) :- introspection_ford(e, b, j), introspection_pord(e, i, j), fstring_piece(e, h, "literal", v), i = @add(h, 1), introspection_run_line(e, b, l).
introspection_fconst(e, v, l) :- introspection_fhost(e), node(_, e, _, _, k), fstring_piece(e, h, "literal", v), !introspection_later(e, h), introspection_run_line(e, k, l).
introspection_hit(p, l, m) :- introspection_const(n, v), introspection_sql_marker(m, re), match(re, v), !introspection_authority(n), node(d, n, _, _, _), introspection_doc(d, p), line(n, l).
introspection_hit(p, l, m) :- introspection_fconst(n, v, l), introspection_sql_marker(m, re), match(re, v), !introspection_authority(n), node(d, n, _, _, _), introspection_doc(d, p).
violation("data-layer-schema-introspection-data-paths", "schema-introspection", "SIDP001", p, l) :- option_value("entryPoint", "_collect_violations"), introspection_hit(p, l, _).
violation("data-layer-schema-introspection-data-paths", "schema-introspection", "SIDP001", p, l) :- option_value("entryPoint", v), v != "_collect_violations", schema_approval_approved(1), introspection_hit(p, l, x), k = @concat(@concat(@concat(p, ":"), @to_string(l)), @concat(":", x)), !schema_approval_entry(k).
schema_approval_listed(1) :- option_json("parameters", "/schemaApprovals/entries", _).
schema_approval_listed(1) :- option_json("parameters", ptr, _), prefix("/schemaApprovals/entries/", ptr).
schema_approval_entry(e) :- option_json("parameters", "/schemaApprovals/entries", e).
schema_approval_entry(e) :- option_json("parameters", ptr, e), match("/schemaApprovals/entries/[^/]*", ptr).
schema_approval_error(1) :- schema_approval_entry(e), prefix("impl/", e).
schema_approval_error(1) :- schema_approval_entry(e), prefix("scripts/", e).
schema_approval_error(1) :- schema_approval_entry(e), match("[^:]*/tests/(?s:.*)", e).
schema_approval_verified(1) :- option_json("parameters", "/schemaApprovals/signatureVerified", v), schema_approval_one(v).
schema_approval_approved(1) :- option_value("parameters", _), !schema_approval_error(1), !schema_approval_listed(1).
schema_approval_approved(1) :- schema_approval_verified(1), !schema_approval_error(1).
violation("data-layer-schema-introspection-data-paths", "schema-approval-configuration", "SIDP000", "scripts/lint_schema_introspection_data_paths.py", 1) :- option_value("entryPoint", v), v != "_collect_violations", schema_approval_error(1).
violation("data-layer-schema-introspection-data-paths", "schema-approval-configuration", "SIDP000", "scripts/lint_schema_introspection_data_paths.py", 1) :- option_value("entryPoint", v), v != "_collect_violations", schema_approval_listed(1), !schema_approval_verified(1).
rr_demand_agg_rr_agg3(b, e) :- introspection_field(e, _, b, _).
rr_demand_agg_rr_agg6(e, i) :- introspection_fhost(e), fstring_piece(e, i, "interpolation", _).
