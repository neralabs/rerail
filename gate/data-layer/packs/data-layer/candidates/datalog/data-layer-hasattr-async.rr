hasattr_args(c, a, s) :- node(_, c, "call", _, _), field(c, "function", fn), node_text(fn, s), field(c, "arguments", a), node(_, a, "argument_list", _, _).
hasattr_extra(a, st) :- hasattr_args(_, a, _), token(a, _, s, st, _), match("(?:#|\\\\)(?s:.*)", s), !hasattr_child_at(a, st).
hasattr_child_at(a, st) :- hasattr_args(_, a, _), child(a, c, _), node(_, c, _, st, _).
rr_ctx2(a, xs) :- child(a, x, i), node(_, x, _, xs, _).
rr_agg1(a, st, xs) :- rr_ctx2(a, xs), hasattr_extra(a, st), st < xs.
hasattr_pos(a, x, k) :- hasattr_args(_, a, _), child(a, x, i), node(_, x, _, xs, _), e = count : { rr_agg1(a, _, xs) }, k = @add(@add(i, e), 1).
hasattr_named(a, k) :- hasattr_args(_, a, _), c = count : { child(a, _, _) }, e = count : { hasattr_extra(a, _) }, k = @add(c, e).
hasattr_call(c, a, s) :- hasattr_args(c, a, s), hasattr_pos(a, x, 2), node(_, x, "string", _, _), node_text(x, t), match("['\"]\\w+_async['\"]", t).
hasattr_allowed(c) :- hasattr_call(c, _, _), node(d, c, _, _, _), line(c, l), tape_line(d, l, sp), text(sp, s), match("(?s:.*)(?:(?:_has_sql_template_support_async)|(?:_has_sql_template_support\\b)|(?:hasattr\\(txn._conn, ['\\\"]_execute_template_with_params)|(?:hasattr\\(txn, ['\\\"]_conn['\\\"].*hasattr\\(txn._conn)|(?:_select_one_direct_async)|(?:insert_many_raw_async)|(?:upsert_many_raw_async)|(?:upsert_many_async)|(?:update_async)|(?:delete_async)|(?:delete_all_async)|(?:delete_many_async)|(?:getattr\\(scheme, ['\\\"]resolve_context_async)|(?:getattr\\(graph_scheme, ['\\\"]resolve_context_async)|(?:keyset_paginate_async)|(?:_execute_aggregate_async)|(?:_execute_windowed_async)|(?:_execute_grammar_async)|(?:fetchall_raw_async)|(?:_update_fts_polyfill_index_async))(?s:.*)", s).
violation("data-layer-hasattr-async", "hasattr", "hasattr", p, l) :- hasattr_call(c, _, f), suffix("hasattr", f), !hasattr_allowed(c), node(d, c, _, _, _), in_scope(d), !out_scope(d), doc(d, p, _), line(c, l).
getattr_three(a) :- hasattr_call(_, a, _), hasattr_pos(a, y, 3), node(_, y, "none", _, _), hasattr_named(a, 3).
violation("data-layer-hasattr-async", "getattr", "getattr", p, l) :- hasattr_call(c, a, f), suffix("getattr", f), getattr_three(a), !hasattr_allowed(c), node(d, c, _, _, _), in_scope(d), !out_scope(d), doc(d, p, _), line(c, l).
