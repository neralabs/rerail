.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl getattr_three(a: node)
.decl hasattr_allowed(c: node)
.decl hasattr_args(c: node, a: node, f: symbol)
.decl hasattr_call(c: node, a: node, f: symbol)
.decl hasattr_child_at(a: node, st: number)
.decl hasattr_extra(a: node, st: number)
.decl hasattr_named(a: node, k: number)
.decl hasattr_pos(a: node, x: node, k: number)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl node_text(n: node, s: symbol)
.decl out_scope(d: number)
.decl rr_agg1(a: node, st: number, xs: number)
.decl rr_ctx2(a: node, xs: number)
.decl tape_line(d: number, l: number, sp: node)
.decl text(n: node, s: symbol)
.decl token(p: node, i: number, s: symbol, start: number, end: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, field, child, text, line, tape_line, node_text, token
.output violation
