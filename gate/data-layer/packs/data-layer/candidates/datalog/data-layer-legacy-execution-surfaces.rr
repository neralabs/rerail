les_walk(r, c2) :- les_walk(r, c), les_open(c), child(c, c2, _).
les_cast_args(c, a) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, "cast"), field(c, "arguments", a).
les_cast_comment(a, s) :- les_cast_args(_, a), token(a, _, t, s, _), prefix("#", t).
rr_ctx2(xs) :- les_cast_args(c, a), child(a, x, j), node(_, x, _, xs, _), j <= 1.
rr_agg1(a, s, xs) :- rr_ctx2(xs), les_cast_comment(a, s), s < xs.
les_cast_arg(c, x) :- les_cast_args(c, a), child(a, x, j), j <= 1, node(_, x, _, xs, _), k = count : { rr_agg1(a, _, xs) }, @add(j, k) = 1.
