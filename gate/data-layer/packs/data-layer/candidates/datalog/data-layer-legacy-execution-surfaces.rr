legacy_execution_graphs_boundary(d, i, a) :- legacy_execution_graphs_from(d, i, m, "legacy_execution_boundary", x), (m = "l2050_transaction.execution_boundary" ; m = "l2000_connection.execution_boundary"), legacy_execution_graphs_alias(x, a).
