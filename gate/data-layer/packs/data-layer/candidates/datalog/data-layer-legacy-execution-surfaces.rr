legacy_execution_graphs_wrappers_from(i) :- legacy_execution_graphs_from(_, i, m, _, _), legacy_execution_graphs_wrappers_module(m).
legacy_execution_graphs_wrappers_from(i) :- legacy_execution_graphs_from(_, i, "l2050_transaction", "legacy_wrappers", _).
legacy_execution_graphs_wrappers_user(d) :- legacy_execution_graphs_from(d, _, m, nm, _), legacy_execution_graphs_wrappers_module(m), nm != "validate_legacy_delegates".
legacy_execution_graphs_l010_file(d, q) :- legacy_execution_graphs_path(d, q), !legacy_execution_graphs_l010_allowed(q), !legacy_execution_graphs_valid(d).
violation("data-layer-legacy-execution-surfaces", "legacy-execution-graphs", "LEG-010", p, l) :- legacy_execution_graphs_wrappers_from(n), node(d, n, _, _, _), legacy_execution_graphs_l010_file(d, q), !match("(?s:.*)(?:(?:^|/)tests/)(?s:.*)", q), doc(d, p, _), line(n, l).
violation("data-layer-legacy-execution-surfaces", "legacy-execution-graphs", "LEG-010", p, l) :- legacy_execution_graphs_wrappers_from(n), node(d, n, _, _, _), legacy_execution_graphs_l010_file(d, q), match("(?s:.*)(?:(?:^|/)tests/)(?s:.*)", q), legacy_execution_graphs_wrappers_user(d), doc(d, p, _), line(n, l).
violation("data-layer-legacy-execution-surfaces", "legacy-execution-graphs", "LEG-010", p, l) :- legacy_execution_graphs_direct(d, n, nm), legacy_execution_graphs_wrappers_module(nm), legacy_execution_graphs_l010_file(d, _), doc(d, p, _), line(n, l).
