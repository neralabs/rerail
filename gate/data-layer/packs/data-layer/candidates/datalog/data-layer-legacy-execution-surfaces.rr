legacy_execution_graphs_cand(d, f, c, q) :- legacy_execution_graphs_active_live(d, f, _, _), legacy_execution_graphs_owned(c, f), legacy_execution_graphs_call(_, c, _, q, _), q != "resolve", q != "resolve_async", q != "_legacy_delegate_stub", q != "legacy_execution_boundary", q != "run_in_legacy_execution_boundary", q != "run_in_legacy_execution_boundary_async".
