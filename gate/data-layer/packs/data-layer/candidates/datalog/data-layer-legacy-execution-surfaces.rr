eager_target(n, o) :- node(_, n, "call", _, _), field(n, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, s), (s = "_execute_impl_async" ; s = "_execute_now" ; s = "delete_by_id" ; s = "delete_by_id_async" ; s = "execute" ; s = "execute_async" ; s = "fetch" ; s = "insert" ; s = "insert_async" ; s = "select" ; s = "select_async" ; s = "select_one" ; s = "select_one_async" ; s = "update" ; s = "update_async"), field(f, "object", o).
