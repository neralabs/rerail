removed_calls_code(c) :- removed_calls_codes(c, "on"), option_on("oracleAnalyzer").
removed_calls_code(c) :- removed_calls_codes(c, "off"), !option_on("oracleAnalyzer").
removed_calls_call(x) :- node(_, x, "call", _, _), field(x, "function", a), node(_, a, "attribute", _, _), field(a, "attribute", at), node(_, at, "identifier", _, _), text(at, s), removed_calls_name(s).
violation("data-layer-raw-execute-regression", "removed-calls", c, p, l) :- option_value("entryPoint", e), removed_calls_entry(e), removed_calls_code(c), node(d, x, _, _, _), removed_calls_call(x), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(x, l).
removed_definitions_code(c) :- removed_definitions_codes(c, "on"), option_on("oracleAnalyzer").
removed_definitions_code(c) :- removed_definitions_codes(c, "off"), !option_on("oracleAnalyzer").
removed_definitions_owner(d, f) :- node(d, f, "function_definition", _, _), field(f, "name", nm), node(_, nm, "identifier", _, _), text(nm, s), removed_definitions_name(s).
removed_definitions_own(f, x) :- removed_definitions_owner(d, f), field(f, "body", b), node(d, b, _, bs, be), node(d, x, _, xs, xe), x != b, bs <= xs, xe <= be, nearest(x, f, removed_definitions_fdef).
removed_definitions_raise(x) :- node(_, x, "raise_statement", _, _).
removed_definitions_raise(x) :- node(_, x, "call", _, _), field(x, "function", a), node(_, a, "attribute", _, _), field(a, "attribute", at), text(at, s), prefix("_raise_", s).
removed_definitions_raises(f) :- removed_definitions_own(f, x), removed_definitions_raise(x).
removed_definitions_calls(f) :- removed_definitions_own(f, x), removed_calls_call(x).
removed_definitions_stubbed(f) :- removed_definitions_owner(d, f), doc(d, p, _), option_item("compatibilityStubFiles", _, p), removed_definitions_raises(f), !removed_definitions_calls(f).
violation("data-layer-raw-execute-regression", "removed-definitions", c, p, l) :- option_value("entryPoint", e), removed_calls_entry(e), removed_definitions_code(c), removed_definitions_owner(d, f), !removed_definitions_stubbed(f), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).
mixed_marker_code(c) :- mixed_marker_codes(c, "on"), option_on("oracleAnalyzer").
mixed_marker_code(c) :- mixed_marker_codes(c, "off"), !option_on("oracleAnalyzer").
mixed_marker_module(p, s, c) :- option_value("entryPoint", e), mixed_marker_entry(e), mixed_marker_code(c), node(d, n, "module", _, _), node_text(n, s), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _).
violation("data-layer-raw-execute-regression", "mixed-marker-0", c, p, 1) :- mixed_marker_module(p, s, c), contains("_execute_sql_or_schema_statement", s).
violation("data-layer-raw-execute-regression", "mixed-marker-1", c, p, 1) :- mixed_marker_module(p, s, c), contains("_execute_sql_or_schema_statement_async", s).
violation("data-layer-raw-execute-regression", "mixed-marker-2", c, p, 1) :- mixed_marker_module(p, s, c), contains("_is_schema_ddl_statement", s).
violation("data-layer-raw-execute-regression", "mixed-marker-3", c, p, 1) :- mixed_marker_module(p, s, c), contains("arbitrary grammar router", s).
violation("data-layer-raw-execute-regression", "mixed-marker-4", c, p, 1) :- mixed_marker_module(p, s, c), contains("compatibility router", s).
