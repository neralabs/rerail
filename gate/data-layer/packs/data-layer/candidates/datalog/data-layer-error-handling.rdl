.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl text(n: node, s: sym)
.decl name(n: node, s: sym)
.decl line(n: node, l: int)
.decl syntax_error(d: int)
.input doc, node, child, text, name, line, syntax_error
.kindset k0 = "expression_statement"
.kindset k1 = "module"
.decl in_scope(d: int)
.decl m17(n: node)
.decl m2(n: node)
.decl m3(n: node)
.decl out_scope(d: int)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "api/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "services/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test_*.py").
m2($n) :- node(_, $n, "identifier", _, _).
m2($n) :- node(_, $n, "call", _, _).
m2($n) :- node(_, $n, "attribute", _, _).
m2($n) :- node(_, $n, "string", _, _).
m2($n) :- node(_, $n, "integer", _, _).
m2($n) :- node(_, $n, "none", _, _).
m3($n) :- child($n, $v1, _), m2($v1).
m17($n) :- node(_, $n, "module", _, _), node($v10, $n, _, _, _), node($v10, $v11, _, _, _), name($v11, $v12), @contains($v12, {"logger.error", "logger.warning", "txn.commit"}).
m17($n) :- inside($n, $v13, k1), node(_, $v13, "module", _, _), node($v14, $v13, _, _, _), node($v14, $v15, _, _, _), name($v15, $v16), @contains($v16, {"logger.error", "logger.warning", "txn.commit"}).
violation("data-layer-error-handling", "admin-commit", "EH001", $p, $l) :- node(_, $n, "call", _, _), node(_, $n, "call", _, _), child($n, $v5, 0), node(_, $v5, "attribute", _, _), child($v5, $v6, 0), node(_, $v6, "identifier", _, _), text($v6, "txn"), child($v5, $v7, 1), node(_, $v7, "identifier", _, _), text($v7, "commit"), !child($v5, _, 2), child($n, $v8, 1), node(_, $v8, "argument_list", _, _), !child($v8, _, 0), !child($n, _, 2), inside($n, $v9, k0), node(_, $v9, "expression_statement", _, _), m17($n), doc($d, $p, $m), @prefix($p, "api/l8000_admin/tools"), node($d, $n, _, _, _), in_scope($d), !syntax_error($d), !out_scope($d), doc($d, $p, _), line($n, $l).
.output violation
