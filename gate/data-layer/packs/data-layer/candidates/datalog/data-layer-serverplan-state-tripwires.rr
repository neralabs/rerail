out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test_*.py", p).
tape_syntax_error(d) :- syntax_error(d).
spt_project(d) :- node(d, m, "module", _, _), node_text(m, s), match("(?s:.*)(?:CompilationContext|CompiledStep|LazyResult|LazySeq|PipelineLifecycleEffect|PipelineResolvedIR|ResolvedRefs|RuntimeBuilder|StepIR|def compile|execute_runtime|execute_runtime_nested_steps|grammar_|in_server_plan_execution|pending_pipeline_effects|post_op|pre_op|preprocess|runtime_builder|runtime_ref|runtime_result)(?s:.*)", s).
spt_admitted(d) :- spt_project(d).
spt_admitted(d) :- doc(d, _, _), option_on("oracleAnalyzer").
spt_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), spt_admitted(d), option_value("entryPoint", e), spt_entry_point(e).
spt_tests_path(d) :- doc(d, p, _), contains("/tests/", p).
spt_named(n, s) :- node(_, n, "identifier", _, _), text(n, s).
spt_named(n, s) :- node(_, n, "attribute", _, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, s).
spt_callee(c, s) :- node(_, c, "call", _, _), field(c, "function", f), spt_named(f, s).
spt_bare_callee(c, s) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, s).
spt_method(c, s, o) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, s), field(f, "object", o).
spt_fn_name(f, s) :- node(_, f, "function_definition", _, _), field(f, "name", x), node(_, x, "identifier", _, _), text(x, s).
spt_kwarg(c, k, v) :- node(_, c, "call", _, _), field(c, "arguments", args), child(args, a, _), node(_, a, "keyword_argument", _, _), field(a, "name", x), node(_, x, "identifier", _, _), text(x, k), field(a, "value", v).
spt_kwarg_name(c, k) :- node(_, c, "call", _, _), field(c, "arguments", args), child(args, a, _), node(_, a, "keyword_argument", _, _), field(a, "name", x), node(_, x, "identifier", _, _), text(x, k).
spt_planning_fn(f) :- spt_fn_name(f, s), (s = "compile" ; s = "lower" ; s = "post_op" ; s = "pre_op" ; s = "preprocess" ; s = "pending_pipeline_effects").
spt_planning_fn(f) :- spt_fn_name(f, s), suffix("_lazy", s).
spt_planning_fn(f) :- spt_fn_name(f, s), glob("apply_*_effect", s).
spt_planning_fn(f) :- node(_, f, "function_definition", _, _), child(w, f, _), node(_, w, "decorated_definition", _, _), child(w, dec, _), node(_, dec, "decorator", _, _), child(dec, x, _), spt_named(x, "pure_lazy").
spt_in_planning(n) :- inside(n, f, spt_fdef), spt_planning_fn(f).
spt_in_preprocess(n) :- inside(n, a, spt_defs), field(a, "name", x), node(_, x, "identifier", _, _), text(x, "preprocess").
spt_grammar_call(c) :- spt_callee(c, s), spt_grammar_name(s).
spt_tail(n, w) :- spt_named(n, w), spt_tail_word(w).
spt_tail(n, w) :- node(_, n, "call", _, _), field(n, "function", f), spt_tail(f, w).
spt_tail(n, w) :- node(_, n, "parenthesized_expression", _, _), child(n, c, _), spt_tail(c, w).
spt_tail_call(c, m, w) :- spt_method(c, m, o), spt_tail(o, w).
spt_io_call(c) :- spt_grammar_call(c).
spt_io_call(c) :- spt_bare_callee(c, s), spt_io_bare(s).
spt_io_call(c) :- spt_tail_call(c, m, w), spt_io_pair(w, m).
violation("data-layer-serverplan-state-tripwires", "queue-auth-definitions", "SPT-001", p, l) :- spt_fn_name(n, s), spt_queue_auth_name(s), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "queue-auth-calls", "SPT-001", p, l) :- spt_callee(n, s), spt_queue_auth_name(s), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "terminal-hydration-definitions", "SPT-002", p, l) :- spt_fn_name(n, s), (s = "hydrate_many_post_op" ; s = "hydrate_one_post_op" ; s = "runtime_sql_conn_from_hydrator"), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "large-column-reentry", "SPT-002", p, l) :- spt_callee(n, s), (s = "explicit_plan_execution_scope" ; s = "hydrate_many_post_op" ; s = "hydrate_one_post_op" ; s = "runtime_sql_conn_from_hydrator"), spt_in_planning(n), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "large-column-hydration", "SPT-002", p, l) :- spt_callee(n, "convert_row_to_model"), spt_in_planning(n), spt_kwarg(n, "hydrate_large_columns", v), node(_, v, "true", _, _), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "direct-planning-io", "SPT-003", p, l) :- spt_grammar_call(n), spt_in_planning(n), !spt_in_preprocess(n), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "query-planning-io", "SPT-003", p, l) :- spt_tail_call(n, m, "query"), (m = "execute" ; m = "execute_async"), spt_in_planning(n), !spt_in_preprocess(n), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "preprocess-io", "SPT-011", p, l) :- spt_io_call(n), spt_in_preprocess(n), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
spt_provider_fn(f) :- spt_fn_name(f, s), (contains("component", s) ; contains("score", s)), node(d, f, _, _, _), doc(d, "impl/common/l2070_server_plan/backend_profiles.py", _).
violation("data-layer-serverplan-state-tripwires", "provider-io", "SPT-019", p, l) :- spt_io_call(n), inside(n, f, spt_fdef), spt_provider_fn(f), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "nested-plan-execution", "SPT-005", p, l) :- spt_callee(n, s), (s = "execute_runtime_nested_steps_async" ; s = "execute_runtime_nested_steps_sync"), spt_in_planning(n), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "executor-plan-execution", "SPT-005", p, l) :- spt_tail_call(n, m, w), (m = "execute" ; m = "execute_async"), (w = "PlanExecutor" ; w = "executor"), spt_in_planning(n), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "materialized-pipeline", "SPT-012", p, l) :- node(d, n, "attribute", _, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, "materialized_pipeline"), spt_in_planning(n), spt_doc(d, p), line(n, l).
spt_ctx_builder_fn(f) :- spt_fn_name(f, s), suffix("sql_builder", s), field(f, "parameters", ps), child(ps, q, _), node(_, q, k, _, _), spt_typed_param_kind(k), field(q, "type", t), node(_, i, "identifier", _, _), text(i, "CompilationContext"), inside(i, t, spt_type_kind).
spt_ctx_scope(n) :- spt_in_planning(n).
spt_ctx_scope(n) :- inside(n, f, spt_fdef), spt_ctx_builder_fn(f).
violation("data-layer-serverplan-state-tripwires", "context-authority", "SPT-020", p, l) :- node(d, n, "attribute", _, _), field(n, "object", o), node(_, o, "identifier", _, _), text(o, "ctx"), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, s), (s = "materialized_pipeline" ; s = "sql_connection" ; s = "txn"), spt_ctx_scope(n), spt_doc(d, p), !spt_tests_path(d), line(n, l).
spt_resolved_object(o) :- spt_named(o, s), (s = "resolved" ; s = "resolved_refs").
spt_resolved_object(o) :- node(_, o, k, _, _), k != "identifier", k != "attribute", node_text(o, s), contains("resolved", s).
violation("data-layer-serverplan-state-tripwires", "resolved-ref-access", "SPT-010", p, l) :- spt_method(n, m, o), (m = "get" ; m = "peek" ; m = "resolve_server_ref"), spt_resolved_object(o), spt_in_planning(n), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "production-ir-class", "SPT-006", p, l) :- node(d, n, "class_definition", _, _), field(n, "name", x), !text(x, "SqlStepIR"), field(n, "superclasses", bs), spt_named(b, s), spt_ir_base_name(s), inside(b, bs, spt_arglist_kind), spt_doc(d, p), !spt_tests_path(d), line(n, l).
spt_ir_ident(n) :- node(_, n, "identifier", _, _), text(n, s), glob("[A-Za-z_]*IR", s), s != "SqlStepIR".
violation("data-layer-serverplan-state-tripwires", "production-ir-construction", "SPT-006", p, l) :- node(d, n, "call", _, _), field(n, "function", f), spt_ir_ident(f), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "production-ir-construction", "SPT-006", p, l) :- node(d, n, "call", _, _), field(n, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), spt_ir_ident(a), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "compiled-ir-value", "SPT-006", p, l) :- spt_callee(n, "CompiledStep"), spt_kwarg(n, "ir", v), !spt_callee(v, "SqlStepIR"), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "test-only-acknowledgement", "SPT-006", p, l) :- spt_kwarg_name(n, "tripwire_acknowledged_test_only"), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "executor-ir-dispatch", "SPT-006", p, l) :- spt_callee(n, "isinstance"), node(d, n, _, _, _), spt_doc(d, p), (p = "impl/common/l2070_server_plan/sql_backend_executor.py" ; p = "l2070_batching/executor.py"), field(n, "arguments", args), child(args, a, 1), spt_ir_ident(a), line(n, l).
violation("data-layer-serverplan-state-tripwires", "executor-ir-dispatch", "SPT-006", p, l) :- spt_callee(n, "isinstance"), node(d, n, _, _, _), spt_doc(d, p), (p = "impl/common/l2070_server_plan/sql_backend_executor.py" ; p = "l2070_batching/executor.py"), field(n, "arguments", args), child(args, a, 1), node(d, a, _, a0, a1), spt_ir_ident(x), node(d, x, _, xs, xe), x != a, xs >= a0, xe <= a1, line(n, l).
spt_step_aware_fn(f) :- node(_, f, "function_definition", _, _), field(f, "body", b), inside(c, b, spt_block_kind), spt_callee(c, s), (s = "in_server_plan_execution" ; s = "in_server_plan_step_execution").
violation("data-layer-serverplan-state-tripwires", "step-aware-eager-helper", "SPT-025", p, l) :- spt_grammar_call(n), node(d, n, _, _, _), spt_doc(d, p), prefix("impl/common/l5150_fts_polyfill/searcher/", p), nearest(n, f, spt_fdef), spt_step_aware_fn(f), !spt_tests_path(d), line(n, l).
spt_gid_loose(t) :- node(_, i, "identifier", _, _), text(i, s), (s = "Any" ; s = "LazyResult" ; s = "object" ; s = "str"), inside(i, t, spt_type_kind).
spt_gid_server_ref(t) :- node(_, i, "identifier", _, _), text(i, s), suffix("ServerRef", s), inside(i, t, spt_type_kind).
spt_gid_type(t) :- spt_gid_loose(t).
spt_gid_type(t) :- node(_, t, _, _, _), !spt_gid_server_ref(t).
spt_gid_config(c) :- node(_, c, "class_definition", _, _), field(c, "name", x), text(x, s), (s = "ContainmentEdgesReadConfig" ; s = "GraphSearchReadConfig").
spt_gid_config(c) :- node(d, c, "class_definition", _, _), field(c, "name", x), text(x, s), contains("Graph", s), suffix("Config", s), doc(d, p, _), contains("graph_read", p).
spt_gid_dataclass(c) :- child(w, c, _), node(_, w, "decorated_definition", _, _), child(w, dec, _), node(_, dec, "decorator", _, _), child(dec, x, _), spt_named(x, "dataclass").
spt_gid_dataclass(c) :- child(w, c, _), node(_, w, "decorated_definition", _, _), child(w, dec, _), node(_, dec, "decorator", _, _), child(dec, x, _), spt_callee(x, "dataclass").
violation("data-layer-serverplan-state-tripwires", "graph-id-config", "SPT-032", p, l) :- node(d, n, "assignment", _, _), field(n, "left", x), node(_, x, "identifier", _, _), text(x, s), contains("graph_id", s), field(n, "type", t), spt_gid_type(t), nearest(n, c, spt_gid_stop), spt_gid_config(c), spt_gid_dataclass(c), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "legacy-preop", "SPT-008", p, l) :- spt_callee(n, "CompiledStep"), spt_kwarg_name(n, k), (k = "async_pre_op" ; k = "pre_op"), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "mcp-default-graph", "SPT-034", p, l) :- spt_callee(n, "resolve_defaults"), nearest(n, f, spt_fdef), spt_fn_name(f, s), (s = "_get_neighbors" ; s = "_get_overview" ; s = "_traverse"), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
spt_graph_chain(n) :- spt_callee(n, "graph_query_builder_lazy").
spt_graph_chain(n) :- node(_, n, "attribute", _, _), field(n, "object", o), spt_graph_chain(o).
spt_graph_chain(n) :- node(_, n, "call", _, _), field(n, "function", f), spt_graph_chain(f).
violation("data-layer-serverplan-state-tripwires", "graph-terminal-chain", "SPT-031", p, l) :- spt_method(n, m, o), spt_lazy_terminal(m), spt_graph_chain(o), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
spt_lct_mark(n) :- spt_callee(n, s), spt_lazy_terminal(s).
spt_lct_mark(n) :- spt_callee(n, s), (s = "LazyBuilderContext" ; s = "_add_intent" ; s = "_add_intent_by_ref" ; s = "_get_lazy_plan").
spt_lct_mark(n) :- node(_, n, "attribute", _, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, "_step_ref_id").
spt_lct_holds(a) :- spt_lct_arg(a), spt_lct_mark(a).
spt_lct_holds(a) :- spt_lct_arg(a), node(d, a, _, a0, a1), spt_lct_mark(x), node(d, x, _, xs, xe), x != a, xs >= a0, xe <= a1.
spt_lct_call(c) :- spt_callee(c, s), (s = "flat_map_lazy_result" ; s = "map_lazy_result").
spt_lct_arg(a) :- spt_lct_positional(_, a).
spt_lct_arg(v) :- spt_lct_keyword(_, v).
spt_lct_positional(c, a) :- spt_lct_call(c), field(c, "arguments", args), child(args, a, i), i != 0, !node(_, a, "keyword_argument", _, _).
spt_lct_keyword(c, v) :- spt_lct_call(c), spt_kwarg(c, k, v), (k = "callback" ; k = "fn" ; k = "func" ; k = "transform").
violation("data-layer-serverplan-state-tripwires", "lazy-callback-terminal", "SPT-030", p, l) :- spt_lct_positional(n, a), spt_lct_holds(a), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "lazy-callback-terminal", "SPT-030", p, l) :- spt_lct_keyword(n, v), spt_lct_holds(v), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "queue-udf-symbols", "SPT-004", p, l) :- node(d, n, k, _, _), spt_string_kind(k), value(n, v), (v = "nera_current_queue_token" ; v = "nera_is_authorized_queue_token"), spt_doc(d, p), !spt_tests_path(d), line(n, l).
spt_ddl_mark(n) :- node(_, n, "string", _, _), value(n, v), match("(?i)\\s*(?:CREATE|ALTER|DROP)\\b(?s:.*)", v).
spt_ddl_mark(n) :- spt_callee(n, s), (prefix("SqlCreate", s) ; prefix("SqlAlter", s) ; prefix("SqlDrop", s)).
spt_ddl_arg(c) :- field(c, "arguments", args), child(args, a, 0), spt_ddl_mark(a).
spt_ddl_arg(c) :- field(c, "arguments", args), child(args, a, 0), node(d, a, _, a0, a1), spt_ddl_mark(x), node(d, x, _, xs, xe), x != a, xs >= a0, xe <= a1.
violation("data-layer-serverplan-state-tripwires", "serverplan-ddl", "SPT-009", p, l) :- spt_callee(n, s), (s = "ddl_effect_lazy" ; s = "grammar_effect_lazy"), prefix("ddl_", s), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
violation("data-layer-serverplan-state-tripwires", "serverplan-ddl", "SPT-009", p, l) :- spt_callee(n, s), (s = "ddl_effect_lazy" ; s = "grammar_effect_lazy"), spt_ddl_arg(n), node(d, n, _, _, _), spt_doc(d, p), !spt_tests_path(d), line(n, l).
spt_plr_file(d) :- doc(d, p, _), (suffix("l9900_auto_api/graph_read_core.py", p) ; suffix("l7200_versioned_transactions/graph_lazy_sql.py", p) ; suffix("impl/common/l2070_server_plan/steps/intent_graph.py", p) ; suffix("impl/common/l9700_sql_graph_query/sql_graph_query_builder.py", p) ; suffix("l9700_graph_query/graph_pattern.py", p) ; suffix("impl/common/l2100_sql_grammar/domain/graph/graph_select_conditions.py", p)).
spt_plr_call(c) :- spt_callee(c, "_lazy_result_step_ref_id").
spt_plr_call(c) :- spt_method(c, "_step_ref_id", _).
spt_plr_call(c) :- spt_bare_callee(c, "getattr"), field(c, "arguments", args), child(args, a, 1), node(_, a, k, _, _), spt_string_kind(k), value(a, "_step_ref_id").
violation("data-layer-serverplan-state-tripwires", "private-lazy-ref", "SPT-033", p, l) :- spt_plr_call(n), node(d, n, _, _, _), spt_plr_file(d), spt_doc(d, p), line(n, l).
spt_pr_scope_name(f) :- node(_, f, k, _, _), spt_pr_def_kind(k), field(f, "name", x), text(x, s), (contains("alias", s) ; contains("extract", s) ; contains("project", s) ; contains("tuple", s)).
spt_pr_file(d) :- spt_doc(d, p), (contains("auto_api", p) ; contains("lazy_orm", p) ; contains("query_builder", p)), !spt_tests_path(d), node(d, m, "module", _, _), node_text(m, s), (contains("evaluate", s) ; contains("execute", s) ; contains("resolve", s)), (contains("alias", s) ; contains("extract", s) ; contains("project", s) ; contains("tuple", s)), node(d, f, _, _, _), spt_pr_scope_name(f).
spt_pr_recovery_call(c) :- spt_callee(c, s), (s = "evaluate" ; s = "execute" ; s = "execute_async" ; s = "resolve" ; s = "resolve_async").
spt_pr_has_recovery(n) :- spt_pr_recovery_call(c), node(d, c, _, cs, ce), node(d, n, _, ns, ne), n != c, cs >= ns, ce <= ne, spt_pr_recovery_holder(n).
spt_pr_recovery_holder(n) :- child(b, n, _), node(_, b, "block", _, _), child(f, b, _), field(f, "body", b), node(_, f, "function_definition", _, _).
spt_pr_recovery_holder(n) :- node(_, n, k, _, _), spt_pr_else_kind(k).
spt_pr_test(n) :- node(_, n, "comparison_operator", _, _), node_text(n, s), match("(?s:.*)\\b(?:in|is)\\b(?s:.*)", s).
spt_pr_test(n) :- spt_callee(n, "isinstance").
spt_pr_in_condition(x, c) :- node(d, c, k, _, _), spt_pr_if_kind(k), spt_pr_file(d), field(c, "condition", q), node(d, q, _, qs, qe), node(d, x, _, xs, xe), xs >= qs, xe <= qe.
spt_pr_candidate(c) :- spt_pr_in_condition(x, c), spt_pr_test(x), inside(c, f, spt_pr_kind), spt_pr_scope_name(f).
spt_pr_interpolated(s) :- node(_, i, "interpolation", _, _), inside(i, s, spt_pr_str_kind).
spt_pr_row_string(n) :- node(_, n, k, _, _), spt_string_kind(k), value(n, v), (v = "row" ; v = "rows"), !spt_pr_interpolated(n).
spt_pr_atom(n) :- node(_, n, "identifier", _, _), text(n, s), (s = "alias" ; s = "key" ; s = "keys" ; s = "row" ; s = "rows").
spt_pr_atom(n) :- spt_pr_row_string(n).
spt_pr_atom_in(c) :- spt_pr_candidate(c), spt_pr_in_condition(x, c), spt_pr_atom(x).
spt_pr_row_constant(d, s) :- node(d, a, "assignment", _, _), spt_pr_file(d), child(e, a, _), node(_, e, "expression_statement", _, _), child(m, e, _), node(_, m, "module", _, _), field(a, "left", x), node(_, x, "identifier", _, _), text(x, s), field(a, "right", r), spt_pr_row_string(r).
spt_pr_named_constant(c) :- spt_pr_candidate(c), spt_pr_in_condition(x, c), node(d, x, "identifier", _, _), text(x, s), spt_pr_row_constant(d, s).
spt_pr_alternative(c) :- spt_pr_candidate(c), child(c, a, _), node(_, a, k, _, _), spt_pr_else_kind(k), spt_pr_has_recovery(a).
spt_pr_later_recovery(c) :- spt_pr_candidate(c), line(c, cl), nearest(c, f, spt_fdef), field(f, "body", b), child(b, s, _), spt_pr_has_recovery(s), line(s, sl), sl > cl.
spt_pr_local(c) :- spt_pr_atom_in(c).
spt_pr_local(c) :- spt_pr_named_constant(c).
spt_pr_recovered(c) :- spt_pr_alternative(c).
spt_pr_recovered(c) :- spt_pr_later_recovery(c).
violation("data-layer-serverplan-state-tripwires", "state-projection-recovery", "SPT-029", p, l) :- spt_pr_candidate(n), spt_pr_local(n), spt_pr_recovered(n), node(d, n, _, _, _), spt_doc(d, p), line(n, l).
spt_sig_source(d) :- node(d, c, "class_definition", _, _), field(c, "superclasses", s), child(s, x, _), node(d, x, k, _, _), k != "keyword_argument", node_text(x, t), match("(?s:.*)(?:ServerPlanStep|IntentStep)(?s:.*)", t).
spt_sig_source(d) :- node(d, c, "class_definition", _, _), field(c, "superclasses", s), child(s, x, _), node(d, x, k, _, _), spt_sig_string_kind(k), value(x, v), match("(?s:.*)(?:ServerPlanStep|IntentStep)(?s:.*)", v).
spt_sig_source(d) :- node(d, c, "class_definition", _, _), field(c, "superclasses", s), token(s, _, t, _, _), prefix("#", t), match("(?s:.*)(?:ServerPlanStep|IntentStep)(?s:.*)", t).
spt_sig_doc(d, p) :- spt_doc(d, p), spt_sig_source(d).
spt_sig_step_class(d, c) :- spt_sig_doc(d, _), node(d, c, "class_definition", _, _), field(c, "superclasses", s), child(s, x, _), node(d, x, k, _, _), k != "keyword_argument", node_text(x, t), match("(?s:.*)(?:ServerPlanStep|IntentStep)(?s:.*)", t).
spt_sig_intent_class(c) :- spt_sig_step_class(d, c), field(c, "superclasses", s), child(s, x, _), node(d, x, k, _, _), k != "keyword_argument", node_text(x, t), match("(?s:.*)IntentStep(?s:.*)", t).
spt_sig_method(d, m, c, mn) :- spt_sig_step_class(d, c), field(c, "body", b), node(d, b, "block", _, _), child(b, m, _), node(d, m, "function_definition", _, _), field(m, "name", x), text(x, mn).
spt_sig_method(d, m, c, mn) :- spt_sig_step_class(d, c), field(c, "body", b), node(d, b, "block", _, _), child(b, w, _), node(d, w, "decorated_definition", _, _), child(w, m, _), node(d, m, "function_definition", _, _), field(m, "name", x), text(x, mn).
spt_sig_nested(m) :- spt_sig_method(_, m, _, _), inside(m, _, spt_sig_fdef).
spt_sig_stub_raise(m, s, b, i) :- spt_sig_method(d, m, _, _), field(m, "body", b), child(b, s, i), node(d, s, "raise_statement", _, _), node_text(s, t), match("raise\\s+NotImplementedError\\s*\\((?s:.*)", t).
spt_sig_valued(e) :- node(_, e, "expression_statement", _, _), child(e, v, _), node(_, v, k, _, _), spt_sig_value_kind(k).
spt_sig_stub_spoiled(s) :- spt_sig_stub_raise(_, s, b, i), child(b, _, j), j > i.
spt_sig_stub_spoiled(s) :- spt_sig_stub_raise(_, s, b, i), child(b, o, j), j < i, node(_, o, k, _, _), !spt_sig_prefix_kind(k).
spt_sig_stub_spoiled(s) :- spt_sig_stub_raise(_, s, b, i), child(b, o, j), j < i, node(_, o, "expression_statement", _, _), !spt_sig_valued(o).
spt_sig_stub(m) :- spt_sig_stub_raise(m, s, _, _), !spt_sig_stub_spoiled(s).
spt_sig_pname(p, s) :- node(_, p, "identifier", _, _), text(p, s).
spt_sig_pname(p, s) :- node(_, p, k, _, _), k != "identifier", spt_sig_param_kind(k), child(p, x, 0), node(_, x, "identifier", _, _), text(x, s).
spt_sig_param(d, p, k, s, m) :- spt_sig_method(d, m, _, _), !spt_sig_nested(m), field(m, "parameters", ps), node(d, ps, "parameters", _, _), child(ps, p, _), node(d, p, k, _, _), spt_sig_param_kind(k), spt_sig_pname(p, s).
spt_sig_r0(p) :- spt_sig_param(_, p, _, _, _).
spt_sig_typed(t) :- spt_sig_param(_, p, _, _, _), field(p, "type", t).
spt_sig_typed(t) :- spt_sig_field(_, f, _), field(f, "type", t).
spt_sig_un(t) :- spt_sig_typed(t), node(d, t, _, _, _), node(d, x, "union_type", _, _), inside(x, t, spt_sig_typek), node_text(x, s), contains("|", s).
spt_sig_un(t) :- spt_sig_typed(t), node(d, t, _, _, _), node(d, x, "binary_operator", _, _), inside(x, t, spt_sig_typek), node_text(x, s), contains("|", s).
spt_sig_un(t) :- spt_sig_typed(t), node(d, t, _, _, _), node(d, x, "identifier", _, _), inside(x, t, spt_sig_typek), text(x, "Optional").
spt_sig_un(t) :- spt_sig_typed(t), node(d, t, _, _, _), node(d, x, "identifier", _, _), inside(x, t, spt_sig_typek), text(x, "Union").
spt_sig_tid(t, s) :- spt_sig_typed(t), node(d, t, _, _, _), node(d, x, "identifier", _, _), inside(x, t, spt_sig_typek), text(x, s).
spt_sig_sr(t) :- spt_sig_tid(t, s), suffix("ServerRef", s).
spt_sig_rb(t) :- spt_sig_tid(t, s), spt_sig_rb_name(s).
spt_sig_hs(t) :- spt_sig_tid(t, "str").
spt_sig_head_cand(t, "type") :- spt_sig_typed(t).
spt_sig_head_cand(t, x) :- spt_sig_typed(t), node(d, t, _, _, _), spt_sig_dc_named(d, x).
spt_sig_head(t, x) :- spt_sig_head_cand(t, x), match("[A-Za-z_]\\w*", x), node_text(t, a), q = @concat(@concat("\\s*(?:[\\w.]+\\.)?", x), "(?:\\.+[\\w&&[^A-Za-z_]]\\w*)*\\.*(?:[^\\w.](?s:.*))?"), match(q, a).
spt_sig_basic(t) :- spt_sig_sr(t), !spt_sig_un(t).
spt_sig_basic(t) :- spt_sig_head(t, "type"), !spt_sig_un(t), node_text(t, a), contains("[", a).
spt_sig_basic(t) :- spt_sig_typed(t), !spt_sig_un(t), node_text(t, a), match("\\s*(?:[A-Za-z_]\\w*\\.)*(?:BackendType|BranchTipMaterialization|CommitBranchContextRefId|ScopedCleanupMode|ServerPlanRefId|SessionId|SqlIndexName|SqlTableName|SysId|VectorBackendKind|VectorIndexMaintenanceOperation)\\s*", a).
spt_sig_basic(t) :- spt_sig_typed(t), !spt_sig_un(t), node_text(t, a), match("\\s*(?:(?:[A-Za-z_]\\w*\\.)*frozenset\\s*\\[\\s*)+(?:[A-Za-z_]\\w*\\.)*(?:BackendType|BranchTipMaterialization|CommitBranchContextRefId|ScopedCleanupMode|ServerPlanRefId|SessionId|SqlIndexName|SqlTableName|SysId|VectorBackendKind|VectorIndexMaintenanceOperation)\\s*(?:\\]\\s*)+", a).
spt_sig_dcdeco(w) :- spt_sig_doc(d, _), node(d, w, "decorated_definition", _, _), node_text(w, s), match("(?s:.*)(?m:^\\s*@(?:[\\w.]*\\.)?dataclass\\b)(?s:.*)", s).
spt_sig_dc(d, c, n) :- spt_sig_dcdeco(w), child(w, c, _), node(d, c, "class_definition", _, _), field(c, "name", x), text(x, n).
spt_sig_dc_fz(c) :- spt_sig_dc(_, c, _), child(w, c, _), spt_sig_dcdeco(w), node_text(w, s), match("(?s:.*)@(?:[\\w.]*\\.)?dataclass\\s*\\([^)]*\\bfrozen\\s*=\\s*True(?s:.*)", s).
spt_sig_static(c) :- spt_sig_dc_fz(c), spt_sig_dc(_, c, n), suffix("Config", n).
spt_sig_static(c) :- spt_sig_dc_fz(c), spt_sig_dc(_, c, n), suffix("Payload", n).
spt_sig_dc_named(d, n) :- spt_sig_dc(d, _, n).
spt_sig_field(d, f, c) :- spt_sig_dc(d, c, _), field(c, "body", b), node(d, b, "block", _, _), child(b, e, _), node(d, e, "expression_statement", _, _), child(e, f, _), node(d, f, "assignment", _, _), field(f, "type", t), node(d, t, "type", _, _).
spt_sig_cf(d, f, n) :- spt_sig_field(d, f, c), spt_sig_dc(d, c, n).
spt_sig_cf_head(f, h) :- spt_sig_cf(_, f, _), field(f, "type", t), spt_sig_head(t, h).
spt_sig_cf_dchead(f) :- spt_sig_cf(d, f, _), spt_sig_cf_head(f, h), spt_sig_dc_named(d, h).
spt_sig_cf_basic(f) :- spt_sig_cf(_, f, _), field(f, "type", t), spt_sig_basic(t).
spt_sig_has_cf(d, n) :- spt_sig_cf(d, _, n).
spt_sig_bad(d, n) :- spt_sig_dc(d, c, n), !spt_sig_static(c), !spt_sig_has_cf(d, n).
spt_sig_bad(d, n) :- spt_sig_dc(d, c, n), !spt_sig_static(c), spt_sig_cf(d, f, n), !spt_sig_cf_basic(f), !spt_sig_cf_dchead(f).
spt_sig_bad(d, n) :- spt_sig_dc(d, c, n), !spt_sig_static(c), spt_sig_cf(d, f, n), !spt_sig_cf_basic(f), spt_sig_cf_head(f, h), spt_sig_bad(d, h).
spt_sig_sp(d, p, k, s, m, mn, c) :- spt_sig_param(d, p, k, s, m), spt_sig_method(d, m, c, mn), !spt_sig_stub(m).
spt_sig_sp_intent(p) :- spt_sig_sp(_, p, _, _, _, _, c), spt_sig_intent_class(c).
spt_sig_sp_type(p, t) :- spt_sig_sp(_, p, _, _, _, _, _), field(p, "type", t).
spt_sig_sp_head(p, h) :- spt_sig_sp_type(p, t), spt_sig_head(t, h).
spt_sig_allowed(p) :- spt_sig_sp_type(p, t), spt_sig_basic(t).
spt_sig_allowed(p) :- spt_sig_sp(d, p, _, _, _, _, _), spt_sig_sp_head(p, h), spt_sig_dc_named(d, h), !spt_sig_bad(d, h).
spt_sig_sp_un(p) :- spt_sig_sp_type(p, t), spt_sig_un(t).
spt_sig_sp_sr(p) :- spt_sig_sp_type(p, t), spt_sig_sr(t).
spt_sig_sp_rb(p) :- spt_sig_sp_type(p, t), spt_sig_rb(t).
spt_sig_sp_hs(p) :- spt_sig_sp_type(p, t), spt_sig_hs(t).
spt_sig_sp_named(p) :- spt_sig_sp(_, p, _, s, _, _, _), s != "self", s != "ref_id".
spt_sig_sp_ctor(p) :- spt_sig_sp(_, p, _, _, _, "__init__", _), spt_sig_sp_intent(p), spt_sig_sp_named(p).
spt_sig_lm(d, m) :- spt_sig_method(d, m, _, "__init__").
spt_sig_lm(d, m) :- spt_sig_method(d, m, _, "lower").
spt_sig_owner_at(n, m, s) :- node(d, n, k, _, _), spt_sig_ownk(k), inside(n, m, spt_sig_fdef), spt_sig_lm(d, m), node(d, m, _, s, _).
spt_sig_owner(n, m) :- spt_sig_owner_at(n, m, s), s = max x : { spt_sig_owner_at(n, _, x) }.
spt_sig_ident(d, i, s, a, b) :- node(d, i, "identifier", a, b), spt_sig_owner(i, _), !spt_sig_r0(i), text(i, s).
spt_sig_r2(f) :- spt_sig_field(_, f, _).
spt_sig_assign(d, a, f, rs, re) :- node(d, a, "assignment", _, _), spt_sig_owner(a, _), !spt_sig_r2(a), nearest(a, f, spt_sig_fdef), field(a, "right", r), node(d, r, _, rs, re).
spt_sig_assign_lt(a, s) :- spt_sig_assign(_, a, _, _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, s).
spt_sig_self_attr(n, x) :- node(_, n, "attribute", _, _), field(n, "object", o), node(_, o, "identifier", _, _), text(o, "self"), field(n, "attribute", i), text(i, x).
spt_sig_assign_x(a, x) :- spt_sig_assign(_, a, _, _, _), field(a, "left", l), spt_sig_self_attr(l, x).
spt_sig_selfattr(d, n, x, m, mn, c) :- spt_sig_self_attr(n, x), spt_sig_owner(n, m), spt_sig_method(d, m, c, mn).
spt_sig_branch(d, b, m, ts, te) :- node(d, b, "conditional_expression", _, _), spt_sig_owner(b, m), child(b, x, 1), node(d, x, _, ts, te).
spt_sig_branch(d, b, m, ts, te) :- node(d, b, k, _, _), spt_sig_owner(b, m), k != "conditional_expression", k != "not_operator", k != "boolean_operator", spt_sig_branch_kind(k), field(b, "condition", x), node(d, x, _, ts, te).
spt_sig_branch(d, b, m, ts, te) :- node(d, b, "not_operator", ts, te), spt_sig_owner(b, m).
spt_sig_branch(d, b, m, ts, te) :- node(d, b, "boolean_operator", ts, te), spt_sig_owner(b, m).
spt_sig_shape_attr(d, c, x) :- spt_sig_sp_ctor(p), !spt_sig_allowed(p), spt_sig_sp(d, p, _, s, m, _, c), spt_sig_assign(d, a, m, rs, re), spt_sig_assign_x(a, x), spt_sig_ident(d, _, s, is, ie), is >= rs, ie <= re.
spt_sig_shape(d, m, s, e) :- spt_sig_selfattr(d, n, x, m, "lower", c), spt_sig_shape_attr(d, c, x), node(d, n, _, s, e).
spt_sig_shape(d, m, is, ie) :- spt_sig_shape(d, m, s, e), spt_sig_assign(d, a, m, rs, re), rs <= s, re >= e, spt_sig_assign_lt(a, t), spt_sig_ident(d, _, t, is, ie), node(d, m, _, ms, me), is >= ms, ie <= me.
spt_sig_shape_branch(d, b) :- spt_sig_branch(d, b, m, ts, te), spt_sig_method(d, m, _, "lower"), spt_sig_shape(d, m, s, e), s >= ts, e <= te.
spt_sig_config_param(p) :- spt_sig_sp(d, p, _, "config", _, _, _), spt_sig_sp_head(p, h), spt_sig_dc_named(d, h).
spt_sig_alias_name(p) :- spt_sig_sp(_, p, _, s, _, _, _), match("(?s:.*)[aA][lL][iI][aA][sS](?s:.*)", s).
violation("data-layer-serverplan-state-tripwires", "state-signatures", "SPT-015", p, l) :- spt_sig_sp(d, n, _, _, _, _, _), spt_sig_sp_named(n), spt_sig_sp_rb(n), !spt_sig_config_param(n), spt_sig_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "state-signatures", "SPT-016", p, l) :- spt_sig_sp_ctor(n), spt_sig_sp(d, n, "default_parameter", _, _, _, _), spt_sig_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "state-signatures", "SPT-016", p, l) :- spt_sig_sp_ctor(n), spt_sig_sp(d, n, "typed_default_parameter", _, _, _, _), spt_sig_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "state-signatures", "SPT-017", p, l) :- spt_sig_sp_ctor(n), !spt_sig_allowed(n), spt_sig_sp(d, n, _, _, _, _, _), spt_sig_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "state-signatures", "SPT-013", p, l) :- spt_sig_sp(d, n, _, s, _, "__init__", _), s != "self", spt_sig_sp_sr(n), spt_sig_sp_un(n), spt_sig_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "state-signatures", "SPT-014", p, l) :- spt_sig_sp(d, n, _, s, _, "__init__", _), s != "self", match("(?s:.*)[tT][aA][bB][lL][eE](?s:.*)", s), !spt_sig_alias_name(n), spt_sig_sp_hs(n), spt_sig_doc(d, p), line(n, l).
violation("data-layer-serverplan-state-tripwires", "state-signatures", "SPT-018", p, l) :- spt_sig_shape_branch(d, b), spt_sig_doc(d, p), line(b, l).
spt_flow_opt("entryPoint", v) :- option_value("entryPoint", v).
spt_flow_opt("oracleAnalyzer", "true") :- option_on("oracleAnalyzer").
spt_flow_opt("oracleAnalyzer", "false") :- spt_flow_digit(0), !option_on("oracleAnalyzer").
spt_flow_opt("sourceProvided", "true") :- option_on("sourceProvided").
spt_flow_opt("sourceProvided", "false") :- spt_flow_digit(0), !option_on("sourceProvided").
spt_flow_rkh(h) :- option_value("returnKindsHex", h).
spt_flow_jb(i, v) :- spt_flow_rkh(h), n = @strlen(h), spt_flow_num(i), @add(@mul(2, i), 1) < n, hi = @substr(h, @mul(2, i), 1), spt_flow_hexd(hi, x), lo = @substr(h, @add(@mul(2, i), 1), 1), spt_flow_hexd(lo, y), v = @add(@mul(16, x), y).
spt_flow_jws(i) :- spt_flow_jb(i, v), v = 32.
spt_flow_jws(i) :- spt_flow_jb(i, v), v = 9.
spt_flow_jws(i) :- spt_flow_jb(i, v), v = 10.
spt_flow_jws(i) :- spt_flow_jb(i, v), v = 13.
spt_flow_jnws(i) :- spt_flow_jb(i, _), !spt_flow_jws(i).
rr_ctx3(p) :- spt_flow_jb(p, _), rr_t4 = @sub(p, 1), spt_flow_jb(rr_t4, 92).
rr_agg2(j, p) :- rr_ctx3(p), spt_flow_jb(j, v), v != 92, j < p.
spt_flow_jbs_odd(p) :- spt_flow_jb(p, _), rr_t1 = @sub(p, 1), spt_flow_jb(rr_t1, 92), m = max j : { rr_agg2(j, p) }, r = @sub(@sub(p, 1), m), @sub(r, @mul(2, @div(r, 2))) = 1.
spt_flow_juq(q) :- spt_flow_jb(q, 34), !spt_flow_jbs_odd(q).
rr_ctx6(q) :- spt_flow_juq(q).
rr_agg5(j, q) :- rr_ctx6(q), spt_flow_juq(j), j < q.
spt_flow_juqn(q, k) :- spt_flow_juq(q), k = count : { rr_agg5(_, q) }.
spt_flow_jstr(o, c) :- spt_flow_juqn(o, k), @sub(k, @mul(2, @div(k, 2))) = 0, rr_t7 = @add(k, 1), spt_flow_juqn(c, rr_t7).
spt_flow_jcand(i, v) :- spt_flow_jb(i, v), v = 123.
spt_flow_jcand(i, v) :- spt_flow_jb(i, v), v = 125.
spt_flow_jcand(i, v) :- spt_flow_jb(i, v), v = 91.
spt_flow_jcand(i, v) :- spt_flow_jb(i, v), v = 93.
spt_flow_jcand(i, v) :- spt_flow_jb(i, v), v = 58.
spt_flow_jcand(i, v) :- spt_flow_jb(i, v), v = 44.
spt_flow_jinstr(i) :- spt_flow_jcand(i, _), spt_flow_jstr(o, c), o < i, i < c.
spt_flow_js(i, v) :- spt_flow_jcand(i, v), !spt_flow_jinstr(i).
spt_flow_jopen(i) :- spt_flow_js(i, 123).
spt_flow_jopen(i) :- spt_flow_js(i, 91).
spt_flow_jclose(i) :- spt_flow_js(i, 125).
spt_flow_jclose(i) :- spt_flow_js(i, 93).
spt_flow_jpt(p) :- spt_flow_jstr(p, _).
spt_flow_jpt(p) :- spt_flow_jopen(p).
spt_flow_jpt(p) :- spt_flow_jclose(p).
rr_ctx9(p) :- spt_flow_jpt(p).
rr_agg8(j, p) :- rr_ctx9(p), spt_flow_jopen(j), j < p.
rr_ctx11(p) :- spt_flow_jpt(p).
rr_agg10(j, p) :- rr_ctx11(p), spt_flow_jclose(j), j < p.
spt_flow_jdepth(p, x) :- spt_flow_jpt(p), a = count : { rr_agg8(_, p) }, b = count : { rr_agg10(_, p) }, x = @sub(a, b).
spt_flow_jafter(c) :- spt_flow_jstr(_, c).
spt_flow_jafter(i) :- spt_flow_js(i, 58).
spt_flow_jnext(p, i) :- spt_flow_jafter(p), i = @add(p, 1), spt_flow_jnws(i).
rr_ctx14(p) :- spt_flow_jafter(p), rr_t15 = @add(p, 1), spt_flow_jws(rr_t15).
rr_agg13(j, p) :- rr_ctx14(p), spt_flow_jnws(j), j > p.
spt_flow_jnext(p, i) :- spt_flow_jafter(p), rr_t12 = @add(p, 1), spt_flow_jws(rr_t12), i = min j : { rr_agg13(j, p) }.
spt_flow_jobj(t) :- spt_flow_rkh(_), t = min j : { spt_flow_jnws(j) }, spt_flow_js(t, 123).
spt_flow_jkeyish(o) :- spt_flow_jstr(o, c), spt_flow_jnext(c, i), spt_flow_js(i, 58).
rr_ctx17(v) :- spt_flow_jobj(_), spt_flow_jkeyish(o), spt_flow_jdepth(o, 1), spt_flow_jstr(o, c), spt_flow_jnext(c, i), spt_flow_jnext(i, v), spt_flow_jopen(v).
rr_agg16(j, v) :- rr_ctx17(v), spt_flow_jclose(j), spt_flow_jdepth(j, 2), j > v.
spt_flow_jentry(o, v, m) :- spt_flow_jobj(_), spt_flow_jkeyish(o), spt_flow_jdepth(o, 1), spt_flow_jstr(o, c), spt_flow_jnext(c, i), spt_flow_jnext(i, v), spt_flow_jopen(v), m = min j : { rr_agg16(j, v) }.
spt_flow_jmember(v, o) :- spt_flow_jentry(_, v, m), spt_flow_jstr(o, _), o > v, o < m, spt_flow_jdepth(o, 2), !spt_flow_jkeyish(o).
spt_flow_jesc(o, p, x) :- spt_flow_jstr(o, c), spt_flow_jb(p, 92), o < p, p < c, !spt_flow_jbs_odd(p), rr_t18 = @add(p, 1), spt_flow_jb(rr_t18, x).
spt_flow_jcons(q) :- spt_flow_jesc(_, p, _), q = @add(p, 1).
spt_flow_jcons(q) :- spt_flow_jesc(_, p, 117), spt_flow_digit(k), k >= 2, k <= 5, q = @add(p, k).
spt_flow_jhexv(i, x) :- spt_flow_jb(i, v), spt_flow_chr(v, ch), spt_flow_hexd(ch, x).
spt_flow_jhex4(p, u) :- spt_flow_jesc(_, p, 117), rr_t19 = @add(p, 2), spt_flow_jhexv(rr_t19, a), rr_t20 = @add(p, 3), spt_flow_jhexv(rr_t20, b), rr_t21 = @add(p, 4), spt_flow_jhexv(rr_t21, c), rr_t22 = @add(p, 5), spt_flow_jhexv(rr_t22, e), u = @add(@add(@add(@mul(4096, a), @mul(256, b)), @mul(16, c)), e).
spt_flow_junit(o, p, ch) :- spt_flow_jstr(o, c), spt_flow_jb(p, v), o < p, p < c, v != 92, !spt_flow_jcons(p), spt_flow_chr(v, ch).
spt_flow_junit(o, p, ch) :- spt_flow_jesc(o, p, x), x = 34, spt_flow_chr(x, ch).
spt_flow_junit(o, p, ch) :- spt_flow_jesc(o, p, x), x = 92, spt_flow_chr(x, ch).
spt_flow_junit(o, p, ch) :- spt_flow_jesc(o, p, x), x = 47, spt_flow_chr(x, ch).
spt_flow_junit(o, p, ch) :- spt_flow_jesc(o, p, 117), spt_flow_jhex4(p, u), spt_flow_chr(u, ch).
spt_flow_jnonprint(p) :- spt_flow_jb(p, v), !spt_flow_chr(v, _).
spt_flow_jbad(o) :- spt_flow_jnonprint(p), spt_flow_jstr(o, c), o < p, p < c.
spt_flow_jbad(o) :- spt_flow_jesc(o, _, x), x != 34, x != 92, x != 47, x != 117.
spt_flow_jbad(o) :- spt_flow_jesc(o, p, 117), !spt_flow_jhex4_print(p).
spt_flow_jhex4_print(p) :- spt_flow_jhex4(p, u), spt_flow_chr(u, _).
spt_flow_jtext(o, s) :- spt_flow_jstr(o, _), !spt_flow_jbad(o), s = join ch by (p) sep "" : { spt_flow_junit(o, p, ch) }.
spt_flow_return_kind(x, k) :- spt_flow_jentry(o, v, _), spt_flow_jtext(o, x), spt_flow_jmember(v, e), spt_flow_jtext(e, k).
spt_flow_ep_ok(1) :- spt_flow_opt("entryPoint", "all").
spt_flow_ep_ok(1) :- spt_flow_opt("entryPoint", "scan_source").
spt_flow_ep_ok(1) :- spt_flow_opt("entryPoint", "scan_tree").
spt_flow_ep_ok(1) :- spt_flow_opt("entryPoint", "scan_project_sources").
spt_flow_sps(1) :- spt_flow_opt("entryPoint", "scan_project_sources").
spt_flow_signed_on(1) :- spt_flow_opt("entryPoint", "all"), spt_flow_opt("oracleAnalyzer", "false").
spt_flow_n_strval(x) :- spt_flow_n_carattr(x).
spt_flow_fsrc(d) :- node(d, m, "module", _, _), node_text(m, s), match("(?s:.*)(?:CompilationContext|CompiledStep|Hydrator|PipelineLifecycleEffect|PlanExecutor|ResolvedRefs|RuntimeBuilderName|RuntimeBuilderSpec|_lazy|_serverplan_runtime_txn|_serverplan_sql_conn|active_pipeline_txn_for_callbacks|builder_name|convert_row_to_model|create_usearch_index_class|def compile|def lower|def post_op|def pre_op|def preprocess|deserialize_embedding|execute_runtime|execute_runtime_nested_steps|get_similarity_function|json\\.dumps|materialized_pipeline|np\\.array|pending_pipeline_effects|post_op_with_refs|pre_op_with_refs|runtime_builder|runtime_builder_post_op|runtime_hydrator|runtime_ref|runtime_refs)(?s:.*)", s).
spt_flow_fsrc(d) :- doc(d, p, _), p = "impl/common/l2070_server_plan/backend_profiles.py".
spt_flow_fdname(f, x) :- node(_, f, "function_definition", _, _), field(f, "name", i), node(_, i, "identifier", _, _), text(i, x).
spt_flow_pure_lazy_ref(x) :- node(_, x, "identifier", _, _), text(x, "pure_lazy").
spt_flow_pure_lazy_ref(x) :- node(_, x, "attribute", _, _), field(x, "attribute", a), node(_, a, "identifier", _, _), text(a, "pure_lazy").
spt_flow_compiledstep_call(c) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, "CompiledStep").
spt_flow_compiledstep_call(c) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, "CompiledStep").
spt_flow_flsrc_fn(f) :- spt_flow_fdname(f, x), spt_flow_n_plan(x).
spt_flow_flsrc_fn(f) :- spt_flow_fdname(f, x), suffix("_lazy", x).
spt_flow_flsrc_fn(f) :- spt_flow_fdname(f, "pending_pipeline_effects").
spt_flow_flsrc_fn(f) :- spt_flow_fdname(f, x), match("(?s:.*)(?:^apply_.*_effect$)(?s:.*)", x).
spt_flow_flsrc_fn(f) :- node(_, f, "function_definition", _, _), child(dd, f, _), node(_, dd, "decorated_definition", _, _), child(dd, dc, _), node(_, dc, "decorator", _, _), child(dc, x, _), spt_flow_pure_lazy_ref(x).
spt_flow_flsrc_fn(f) :- spt_flow_fdname(f, x), suffix("sql_builder", x).
spt_flow_flsrc_fn(f) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), has(ps, x, spt_flow_k_params), node(_, x, "identifier", _, _), text(x, "runtime_refs").
spt_flow_flsrc_fn(f) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), has(ps, x, spt_flow_k_params), node_text(x, s), contains("RuntimeBuilderSpec", s).
spt_flow_flsrc_fn(f) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), node(_, ps, "parameters", _, _), token(ps, _, s, _, _), prefix("#", s), contains("RuntimeBuilderSpec", s).
spt_flow_flsrc_fn(f) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), has(ps, x, spt_flow_k_params), token(x, _, s, _, _), prefix("#", s), contains("RuntimeBuilderSpec", s).
spt_flow_flsrc_fn(f) :- node(_, f, "function_definition", _, _), has(f, c, spt_flow_k_fdef), spt_flow_compiledstep_call(c).
spt_flow_flsrc(d) :- doc(d, p, _), match("(?s:.*)(?:(?:^|/)(?:impl/common/l2070_server_plan/|impl/common/l2070_server_plan/backend_profiles\\.py$))(?s:.*)", p).
spt_flow_flsrc(d) :- spt_flow_flsrc_fn(f), node(d, f, _, _, _).
spt_flow_a1(d) :- doc(d, _, _), spt_flow_sps(1).
spt_flow_a1(d) :- spt_flow_fsrc(d), spt_flow_opt("sourceProvided", "true").
spt_flow_a1(d) :- doc(d, _, _), spt_flow_opt("sourceProvided", "false").
spt_flow_a2(d) :- doc(d, _, _), spt_flow_sps(1).
spt_flow_a2(d) :- spt_flow_flsrc(d).
spt_flow_a3(d) :- doc(d, _, _), spt_flow_opt("oracleAnalyzer", "true").
spt_flow_a3(d) :- spt_project(d).
spt_flow_adoc(d) :- doc(d, _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), spt_flow_ep_ok(1), spt_flow_a1(d), spt_flow_a2(d), spt_flow_a3(d).
spt_flow_pmode(1) :- spt_flow_sps(1), spt_flow_adoc(_).
spt_flow_nested(f) :- node(d, f, "function_definition", _, _), spt_flow_adoc(d), inside(f, _, spt_flow_k_fdef).
spt_flow_top(n, t) :- node(d, n, _, _, _), spt_flow_adoc(d), inside(n, t, spt_flow_k_fdef), !spt_flow_nested(t).
spt_flow_fn(d, f, s, e, x) :- node(d, f, "function_definition", s, e), spt_flow_adoc(d), field(f, "name", i), text(i, x).
spt_flow_fn_rt(f, s) :- spt_flow_fn(_, f, _, _, _), field(f, "return_type", r), node_text(r, s).
spt_flow_fn_dec(f) :- spt_flow_fn(_, f, _, _, _), child(dd, f, _), node(_, dd, "decorated_definition", _, _), node_text(dd, s), match("(?s:.*)(?:(?m)^\\s*@(?:[\\w.]*\\.)?pure_lazy\\b)(?s:.*)", s).
spt_flow_cls_name(k, x) :- node(d, k, "class_definition", _, _), spt_flow_adoc(d), field(k, "name", i), text(i, x).
spt_flow_pfn(i, f, i) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, i, _), node(_, i, "identifier", _, _).
spt_flow_pfn(i, f, tp) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, tp, _), node(_, tp, "typed_parameter", _, _), child(tp, i, _), node(_, i, "identifier", _, _).
spt_flow_pfn(i, f, dp) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, dp, _), node(_, dp, "default_parameter", _, _), field(dp, "name", i), node(_, i, "identifier", _, _).
spt_flow_pfn(i, f, dp) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, dp, _), node(_, dp, "typed_default_parameter", _, _), field(dp, "name", i), node(_, i, "identifier", _, _).
spt_flow_param(d, f, i, x) :- spt_flow_pfn(i, f, _), node(d, i, _, _, _), spt_flow_top(i, _), text(i, x).
spt_flow_param_ann(i, a) :- spt_flow_param(_, _, i, _), spt_flow_pfn(i, _, p), p != i, field(p, "type", t), node_text(t, a).
spt_flow_fn_ann(f, a) :- spt_flow_param(_, f, i, _), spt_flow_param_ann(i, a).
spt_flow_param_before(i, j) :- spt_flow_param(d, f, i, _), node(d, i, _, s, _), spt_flow_param(d, f, j, _), node(d, j, _, t, _), t < s.
spt_flow_param_first(i) :- spt_flow_param(_, _, i, _), !spt_flow_has_param_before(i).
spt_flow_has_param_before(i) :- spt_flow_param_before(i, _).
spt_flow_param_pos(i, 0) :- spt_flow_param_first(i).
spt_flow_param_pos(i, k) :- spt_flow_has_param_before(i), k = count : { spt_flow_param_before(i, _) }.
spt_flow_ctx(d, f, s, e, x) :- spt_flow_fn(d, f, s, e, x), !spt_flow_nested(f).
spt_flow_cls_inner(k) :- spt_flow_cls_name(k, _), inside(k, _, spt_flow_k_cdef).
spt_flow_cls_path(k, x) :- spt_flow_cls_name(k, x), !spt_flow_cls_inner(k).
spt_flow_cls_path(k, p) :- spt_flow_cls_name(k, x), nearest(k, o, spt_flow_k_cdef), spt_flow_cls_path(o, q), p = @concat(@concat(q, "."), x).
spt_flow_ctx_cls(f, p) :- spt_flow_ctx(_, f, _, _, _), nearest(f, k, spt_flow_k_cdef), spt_flow_cls_path(k, p).
spt_flow_ctx_incls(f) :- spt_flow_ctx_cls(f, _).
spt_flow_planning(f) :- spt_flow_ctx(_, f, _, _, x), suffix("_lazy", x).
spt_flow_planning(f) :- spt_flow_ctx(_, f, _, _, x), spt_flow_n_plan(x).
spt_flow_planning(f) :- spt_flow_ctx(_, f, _, _, "pending_pipeline_effects").
spt_flow_planning(f) :- spt_flow_ctx(_, f, _, _, x), match("(?s:.*)(?:^apply_.*_effect$)(?s:.*)", x).
spt_flow_planning(f) :- spt_flow_ctx(_, f, _, _, _), spt_flow_fn_dec(f).
spt_flow_preprocess(f) :- spt_flow_ctx(_, f, _, _, "preprocess").
spt_flow_ctx_helper(f) :- spt_flow_ctx(_, f, _, _, x), suffix("sql_builder", x), spt_flow_fn_ann(f, a), match("(?s:.*)(?:\\bCompilationContext\\b)(?s:.*)", a).
spt_flow_provider_helper(f) :- spt_flow_ctx(d, f, _, _, x), doc(d, "impl/common/l2070_server_plan/backend_profiles.py", _), match("(?s:.*)(?:component|components|score|scores)(?s:.*)", x).
spt_flow_materializer(f) :- spt_flow_ctx(d, f, _, _, x), spt_flow_param(d, f, _, "runtime_refs"), match("(?s:.*)(?:^materialize_.*builder$)(?s:.*)", x).
spt_flow_materializer(f) :- spt_flow_ctx(d, f, _, _, _), spt_flow_param(d, f, _, "runtime_refs"), spt_flow_fn_ann(f, a), match("(?s:.*)(?:\\bRuntimeBuilderSpec\\b)(?s:.*)", a).
spt_flow_argof(x, c) :- node(_, c, "call", _, _), field(c, "arguments", al), child(al, x, _).
spt_flow_interp(s) :- node(_, x, "interpolation", _, _), inside(x, s, spt_flow_ks_str).
spt_flow_poschild(p, c, i) :- child(p, c, i), node(_, c, k, _, _), !spt_flow_k_nonpos(k).
spt_flow_pos0(p, c) :- spt_flow_poschild(p, c, i), i = min j : { spt_flow_poschild(p, _, j) }.
spt_flow_after0(p, c, i) :- spt_flow_pos0(p, c0), spt_flow_poschild(p, c0, i0), spt_flow_poschild(p, c, i), i > i0.
spt_flow_pos1(p, c) :- spt_flow_after0(p, c, i), i = min j : { spt_flow_after0(p, _, j) }.
spt_flow_asg_any(d, a) :- node(d, a, "assignment", _, _), spt_flow_adoc(d).
spt_flow_asg_lt(a, x) :- spt_flow_asg_any(_, a), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x).
spt_flow_asg_mods(a) :- spt_flow_asg_any(_, a), child(es, a, _), node(_, es, "expression_statement", _, _), child(m, es, _), node(_, m, "module", _, _).
spt_flow_forst(d, fs, f) :- node(d, fs, "for_statement", _, _), spt_flow_top(fs, f), field(fs, "right", _), field(fs, "left", _).
spt_flow_forleft_ident(fs, i, x) :- spt_flow_forst(d, fs, _), field(fs, "left", l), node(d, l, _, ls, le), node(d, i, "identifier", s, e), s >= ls, e <= le, spt_flow_top(i, _), text(i, x).
spt_flow_interest(d, x) :- spt_flow_param(d, _, _, x).
spt_flow_interest(d, x) :- spt_flow_asg_any(d, a), spt_flow_asg_lt(a, x).
spt_flow_interest(d, x) :- spt_flow_forst(d, fs, _), spt_flow_forleft_ident(fs, _, x).
spt_flow_bid(d, i, f, x) :- node(d, i, "identifier", _, _), spt_flow_top(i, f), text(i, x), spt_flow_interest(d, x).
spt_flow_bid_ks(i, ks, kr) :- spt_flow_bid(_, i, _, _), field(ks, "subscript", i), node(_, ks, "subscript", _, _), field(ks, "value", v), node(_, v, "identifier", _, _), text(v, kr).
spt_flow_bid_cmp(i, c) :- spt_flow_bid(_, i, _, _), child(c, i, _), node(_, c, "comparison_operator", _, _), node_text(c, s), match("(?s:.*)(?:\\bin\\b)(?s:.*)", s).
spt_flow_bid_kwn(i) :- spt_flow_bid(_, i, _, _), field(k, "name", i), node(_, k, "keyword_argument", _, _).
spt_flow_attr(d, a, f, x, o) :- node(d, a, "attribute", _, _), spt_flow_top(a, f), field(a, "attribute", n), text(n, x), field(a, "object", o).
spt_flow_attr_objt(a, s) :- spt_flow_attr(_, a, _, _, o), node(_, o, "identifier", _, _), text(o, s).
spt_flow_call(d, c, f, fk) :- node(d, c, "call", _, _), spt_flow_top(c, f), field(c, "function", fn), node(_, fn, fk, _, _), field(c, "arguments", _).
spt_flow_call_attr(c, x, r) :- spt_flow_call(_, c, _, "attribute"), field(c, "function", fn), field(fn, "attribute", a), text(a, x), field(fn, "object", r).
spt_flow_callee(c, x) :- spt_flow_call_attr(c, x, _).
spt_flow_callee(c, x) :- spt_flow_call(_, c, _, "identifier"), field(c, "function", fn), text(fn, x).
spt_flow_recvt(c, s) :- spt_flow_call_attr(c, _, r), node(_, r, "identifier", _, _), text(r, s).
spt_flow_full_callee(c, s) :- spt_flow_call_attr(c, x, _), spt_flow_n_fullattr(x), field(c, "function", fn), node_text(fn, s).
spt_flow_full_callee(c, s) :- spt_flow_call(_, c, _, "identifier"), field(c, "function", fn), text(fn, s).
spt_flow_has_full(c) :- spt_flow_call_attr(c, x, _), spt_flow_n_fullattr(x).
spt_flow_call_kw(c, k, x) :- spt_flow_call(_, c, _, _), field(c, "arguments", al), child(al, k, _), node(_, k, "keyword_argument", _, _), field(k, "name", kn), node(_, kn, "identifier", _, _), text(kn, x).
spt_flow_call_refs(c) :- spt_flow_call_kw(c, _, "post_op_with_refs").
spt_flow_call_refs(c) :- spt_flow_call_kw(c, _, "pre_op_with_refs").
spt_flow_call_hyd(c) :- spt_flow_call_kw(c, k, "hydrate_large_columns"), field(k, "value", v), node(_, v, "true", _, _).
spt_flow_call_res(c) :- spt_flow_call_attr(c, _, o), node(_, o, "identifier", _, _), text(o, x), spt_flow_resolved_name(x).
spt_flow_call_res(c) :- spt_flow_call_attr(c, _, o), node(_, o, "attribute", _, _), field(o, "attribute", a), node(_, a, "identifier", _, _), text(a, x), spt_flow_resolved_name(x).
spt_flow_call_res(c) :- spt_flow_call_attr(c, _, o), node(_, o, k, _, _), !spt_flow_k_idattr(k), node_text(o, s), contains("resolved", s).
spt_flow_call_args(c, al) :- spt_flow_call(_, c, _, _), field(c, "arguments", al).
spt_flow_ga(c) :- spt_flow_call(_, c, _, "identifier"), spt_flow_callee(c, "getattr").
spt_flow_ga(c) :- spt_flow_call_attr(c, "get", _).
spt_flow_call_pos(c, 0, a) :- spt_flow_ga(c), field(c, "arguments", al), spt_flow_pos0(al, a).
spt_flow_call_pos(c, 1, a) :- spt_flow_ga(c), field(c, "arguments", al), spt_flow_pos1(al, a).
spt_flow_kw(d, k, c, x, v) :- node(d, k, "keyword_argument", _, _), child(al, k, _), node(_, al, "argument_list", _, _), field(c, "arguments", al), node(_, c, "call", _, _), spt_flow_top(k, _), field(k, "name", kn), text(kn, x), field(k, "value", v).
spt_flow_splat(d, sp, c) :- node(d, sp, "list_splat", _, _), child(al, sp, _), node(_, al, "argument_list", _, _), field(c, "arguments", al), node(_, c, "call", _, _), spt_flow_top(sp, _).
spt_flow_splat(d, sp, c) :- node(d, sp, "dictionary_splat", _, _), child(al, sp, _), node(_, al, "argument_list", _, _), field(c, "arguments", al), node(_, c, "call", _, _), spt_flow_top(sp, _).
spt_flow_asg(d, a, f, lk, v) :- spt_flow_asg_any(d, a), spt_flow_top(a, f), field(a, "left", l), node(_, l, lk, _, _), field(a, "right", v).
spt_flow_sub(d, s, f, v) :- node(d, s, "subscript", _, _), spt_flow_top(s, f), field(s, "value", v).
spt_flow_sub_vt(s, x) :- spt_flow_sub(_, s, _, v), node(_, v, "identifier", _, _), text(v, x).
spt_flow_sub_slice(s) :- spt_flow_sub(_, s, _, _), child(s, x, _), node(_, x, "slice", _, _).
spt_flow_sub_keycand(s, k, t) :- spt_flow_sub(_, s, _, _), field(s, "subscript", k), node(_, k, kk, t, _), spt_flow_k_str(kk), !spt_flow_interp(k), value(k, v), spt_flow_n_carattr(v).
spt_flow_sub_skey(s, k) :- spt_flow_sub_keycand(s, k, t), t = min u : { spt_flow_sub_keycand(s, _, u) }.
spt_flow_barg(d, x, c) :- spt_flow_bid(d, x, _, _), spt_flow_argof(x, c).
spt_flow_barg(d, x, c) :- spt_flow_attr(d, x, _, _, _), spt_flow_argof(x, c).
spt_flow_barg(d, x, c) :- spt_flow_call(d, x, _, _), spt_flow_argof(x, c).
spt_flow_barg(d, x, c) :- spt_flow_sub(d, x, _, _), spt_flow_argof(x, c).
spt_flow_cbparam(d, c, x, kn, pos) :- spt_flow_ctx(d, c, cs, ce, _), spt_flow_call(d, call, c, _), spt_flow_callee(call, "CompiledStep"), spt_flow_kw(d, _, call, kn, v), (kn = "post_op" ; kn = "post_op_with_refs"), node(_, v, "identifier", _, _), text(v, vt), spt_flow_fn(d, nf, ns, ne, vt), ns > cs, ne <= ce, spt_flow_param(d, nf, i, x), spt_flow_param_pos(i, pos), pos = 1.
spt_flow_cbparam(d, c, x, kn, pos) :- spt_flow_ctx(d, c, cs, ce, _), spt_flow_call(d, call, c, _), spt_flow_callee(call, "CompiledStep"), spt_flow_kw(d, _, call, kn, v), (kn = "post_op" ; kn = "post_op_with_refs"), node(_, v, "identifier", _, _), text(v, vt), spt_flow_fn(d, nf, ns, ne, vt), ns > cs, ne <= ce, spt_flow_param(d, nf, i, x), spt_flow_param_pos(i, pos), pos = 2.
spt_flow_pkind(d, f, x, "authority") :- spt_flow_param(d, f, _, x), spt_flow_n_authparam(x).
spt_flow_pkind(d, f, x, "authority") :- spt_flow_param(d, f, i, x), spt_flow_param_ann(i, a), match("(?s:.*)(?:\\b(?:ReadTransaction|SyncDatabaseConnection|SyncSqlConnection|WriteTransaction)\\b)(?s:.*)", a).
spt_flow_pkind(d, f, x, "provider") :- spt_flow_param(d, f, i, x), spt_flow_param_ann(i, a), match("(?s:.*)(?:\\b(?:CrossBranchQueryProvider|HybridSearchProvider|VectorCandidateProvider|VersionedLoweringProvider|VersionedStorageProvider)\\b)(?s:.*)", a).
spt_flow_pkind(d, f, "resolved", "runtime_value") :- spt_flow_param(d, f, _, "resolved").
spt_flow_pkind(d, f, x, "runtime_value") :- spt_flow_param(d, f, i, x), spt_flow_param_ann(i, a), match("(?s:.*)(?:\\bResolvedRefs\\b)(?s:.*)", a).
spt_flow_pkind(d, f, "runtime_refs", "runtime_value") :- spt_flow_param(d, f, _, "runtime_refs"), spt_flow_materializer(f).
spt_flow_pkind(d, f, x, "carrier") :- spt_flow_param(d, f, _, x), spt_flow_n_carparam(x).
spt_flow_pkind(d, f, x, "carrier") :- spt_flow_param(d, f, i, x), spt_flow_param_ann(i, a), match("(?s:.*)(?:\\bHydrator\\b)(?s:.*)", a).
spt_flow_pkind(d, f, x, "carrier") :- spt_flow_cbparam(d, f, x, _, 1).
spt_flow_pkind(d, f, x, "runtime_value") :- spt_flow_cbparam(d, f, x, "post_op_with_refs", 2).
spt_flow_pkind(d, f, x, "carrier") :- spt_flow_cbparam(d, f, x, "post_op_with_refs", 2).
spt_flow_strin(d, s, v) :- node(d, s, k, _, _), spt_flow_k_str(k), spt_flow_adoc(d), !spt_flow_interp(s), spt_flow_strpos(s), value(s, v), spt_flow_n_strval(v).
spt_flow_strpos(s) :- child(p, s, _), node(_, p, "argument_list", _, _).
spt_flow_strpos(s) :- child(p, s, _), node(_, p, "subscript", _, _).
spt_flow_strpos(s) :- field(a, "right", s), node(_, a, "assignment", _, _), spt_flow_asg_mods(a).
spt_flow_sval(d, s, v) :- spt_flow_strin(d, s, v).
spt_flow_sval(d, i, v) :- spt_flow_asg_mods(a), spt_flow_asg_lt(a, x), field(a, "right", s), spt_flow_strin(d, s, v), spt_flow_bid(d, i, _, x).
spt_flow_sattr(d, f, a, "attribute", "context", x) :- spt_flow_attr(d, a, f, x, _), spt_flow_attr_objt(a, "ctx"), spt_flow_n_ctxattr(x).
spt_flow_sattr(d, f, a, "attribute", "carrier", x) :- spt_flow_attr(d, a, f, x, _), spt_flow_n_carattr(x), spt_flow_attr_objt(a, o), o != "ctx", spt_flow_pkind(d, f, o, "carrier").
spt_flow_sattr(d, f, a, "attribute", "carrier", x) :- spt_flow_attr(d, a, f, x, _), spt_flow_n_carattr(x), !spt_flow_n_ctxattr(x), spt_flow_attr_objt(a, "ctx"), spt_flow_pkind(d, f, "ctx", "carrier").
spt_flow_getattr(d, c, f, o, v) :- spt_flow_call(d, c, f, "identifier"), spt_flow_callee(c, "getattr"), spt_flow_call_pos(c, 0, a0), node(_, a0, "identifier", _, _), text(a0, o), spt_flow_call_pos(c, 1, a1), spt_flow_sval(d, a1, v).
spt_flow_sattr(d, f, c, "call", "context", v) :- spt_flow_getattr(d, c, f, "ctx", v), spt_flow_n_ctxattr(v).
spt_flow_sattr(d, f, c, "call", "context", v) :- spt_flow_getattr(d, c, f, "ctx", v), spt_flow_n_carattr(v), spt_flow_pkind(d, f, "ctx", "carrier").
spt_flow_sattr(d, f, c, "call", "carrier", v) :- spt_flow_getattr(d, c, f, o, v), o != "ctx", spt_flow_n_carattr(v), spt_flow_pkind(d, f, o, "carrier").
spt_flow_sattr(d, f, c, "call", "carrier", v) :- spt_flow_call(d, c, f, "attribute"), spt_flow_callee(c, "get"), spt_flow_call_pos(c, 0, a0), spt_flow_sval(d, a0, v), spt_flow_n_carattr(v), spt_flow_recvt(c, r), spt_flow_pkind(d, f, r, "carrier").
spt_flow_sattr(d, f, s, "subscript", "carrier", v) :- spt_flow_sub(d, s, f, _), spt_flow_sub_skey(s, k), spt_flow_sval(d, k, v), spt_flow_sub_vt(s, r), spt_flow_pkind(d, f, r, "carrier").
spt_flow_sattr(d, f, ks, "subscript", "carrier", v) :- spt_flow_bid(d, i, f, _), spt_flow_bid_ks(i, ks, r), spt_flow_sval(d, i, v), spt_flow_n_carattr(v), spt_flow_pkind(d, f, r, "carrier").
spt_flow_in_splat(c, n) :- spt_flow_splat(d, sp, c), node(d, sp, _, s, e), node(d, n, _, ns, ne), ns >= s, ne <= e.
spt_flow_in_kw(c, n) :- spt_flow_kw(d, k, c, _, _), node(d, k, _, s, e), node(d, n, _, ns, ne), ns >= s, ne <= e.
spt_flow_rt_arg(d, f, c) :- spt_flow_call(d, c, f, "identifier"), spt_flow_call_args(c, al), node(d, al, _, as, ae), spt_flow_bid(d, n, _, x), node(d, n, _, ns, ne), ns >= as, ne <= ae, spt_flow_pkind(d, f, x, "carrier"), !spt_flow_in_splat(c, n), !spt_flow_in_kw(c, n).
spt_flow_runtime(d, x) :- spt_flow_ctx(d, c, _, _, x), spt_flow_sattr(d, c, _, _, "carrier", _), spt_flow_pkind(d, c, _, "carrier").
spt_flow_runtime(d, x) :- spt_flow_ctx(d, c, _, _, x), spt_flow_call(d, call, c, "identifier"), spt_flow_callee(call, y), spt_flow_runtime(d, y), spt_flow_rt_arg(d, c, call).
spt_flow_rk(d, x, "runtime_authority") :- spt_flow_runtime(d, x).
spt_flow_rk(d, x, "authority") :- spt_flow_ctx(d, c, _, _, x), spt_flow_fn_rt(c, s), match("(?s:.*)(?:\\b(?:ReadTransaction|SyncDatabaseConnection|SyncSqlConnection|WriteTransaction)\\b)(?s:.*)", s).
spt_flow_rk(d, x, "provider") :- spt_flow_ctx(d, c, _, _, x), spt_flow_fn_rt(c, s), match("(?s:.*)(?:\\b(?:CrossBranchQueryProvider|HybridSearchProvider|VectorCandidateProvider|VersionedLoweringProvider|VersionedStorageProvider)\\b)(?s:.*)", s).
spt_flow_edge(d, f, a, o) :- spt_flow_attr(d, a, f, _, o).
spt_flow_edge(d, f, c, r) :- spt_flow_call(d, c, f, _), spt_flow_call_attr(c, _, r).
spt_flow_edge(d, f, s, v) :- spt_flow_sub(d, s, f, v).
spt_flow_taint(d, f, n, k) :- spt_flow_bid(d, n, f, x), spt_flow_pkind(d, f, x, k), k != "carrier".
spt_flow_taint(d, f, n, "authority") :- spt_flow_sattr(d, f, n, _, "carrier", _).
spt_flow_taint(d, f, n, "authority") :- spt_flow_sattr(d, f, n, _, _, "txn").
spt_flow_taint(d, f, n, "authority") :- spt_flow_sattr(d, f, n, _, _, "sql_connection").
spt_flow_taint(d, f, c, k) :- spt_flow_call(d, c, f, _), spt_flow_callee(c, x), spt_flow_rk(d, x, k).
spt_flow_taint(d, f, c, k) :- spt_flow_call(d, c, f, _), spt_flow_callee(c, x), spt_flow_return_kind(x, k).
spt_flow_taint(d, f, c, k) :- spt_flow_pmode(1), spt_flow_call(d, c, f, _), spt_flow_callee(c, x), spt_flow_rk(_, x, k).
spt_flow_taint(d, f, e, k) :- spt_flow_taint(d, f, n, k), spt_flow_edge(d, f, e, n).
spt_flow_taint(d, f, i, k) :- spt_flow_taint(d, f, n, k), spt_flow_flowkind(k), spt_flow_asg(d, a, f, "identifier", n), spt_flow_asg_lt(a, x), spt_flow_bid(d, i, f, x).
spt_flow_seed(d, f, n) :- spt_flow_taint(d, f, n, "runtime_value").
spt_flow_seed(d, f, n) :- spt_flow_bid(d, n, f, x), spt_flow_pkind(d, f, x, "carrier").
spt_flow_seed(d, f, i) :- spt_flow_seed(d, f, s), node(d, s, _, ss, se), spt_flow_asg(d, a, f, "identifier", v), node(d, v, vk, vs, ve), vs <= ss, se <= ve, !spt_flow_k_excl(vk), spt_flow_asg_lt(a, x), spt_flow_bid(d, i, f, x).
spt_flow_seed(d, f, i) :- spt_flow_seed(d, f, s), spt_flow_asg(d, a, f, "identifier", s), spt_flow_asg_lt(a, x), spt_flow_bid(d, i, f, x).
spt_flow_seed_in(d, f, r) :- spt_flow_seedable(d, f, r), node(d, r, rk, rs, re), !spt_flow_k_excl(rk), spt_flow_seed(d, f, v), node(d, v, _, vs, ve), vs >= rs, ve <= re.
spt_flow_seed_in(d, f, r) :- spt_flow_seedable(d, f, r), spt_flow_seed(d, f, r).
spt_flow_seedable(d, f, r) :- spt_flow_call(d, c, f, _), spt_flow_callee(c, x), spt_flow_n_semmeth(x), spt_flow_call_attr(c, _, r).
spt_flow_seedable(d, f, v) :- spt_flow_sub(d, s, f, v), spt_flow_sub_slice(s).
spt_flow_seedable(d, f, r) :- spt_flow_comp(d, _, f, _, r).
spt_flow_seedable(d, f, r) :- spt_flow_forst(d, fs, f), spt_flow_forright(fs, r).
spt_flow_ev(d, f, n, "eager_sql", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, x), spt_flow_n_grammar(x).
spt_flow_ev(d, f, n, "eager_sql", 1) :- spt_flow_call(d, n, f, "identifier"), spt_flow_callee(n, x), spt_flow_n_exec(x).
spt_flow_ev(d, f, n, "eager_sql", 1) :- spt_flow_call(d, n, f, _), spt_flow_has_full(n), spt_flow_full_callee(n, s), match("(?s:.*)(?:(?:^|\\.)(?:conn(?:\\([^)]*\\))?\\.execute|conn(?:\\([^)]*\\))?\\.execute_async|conn(?:\\([^)]*\\))?\\.fetchall|conn(?:\\([^)]*\\))?\\.fetchall_async|conn(?:\\([^)]*\\))?\\.fetchone|conn(?:\\([^)]*\\))?\\.fetchone_async|connection(?:\\([^)]*\\))?\\.execute|connection(?:\\([^)]*\\))?\\.execute_async|connection(?:\\([^)]*\\))?\\.fetchall|connection(?:\\([^)]*\\))?\\.fetchall_async|connection(?:\\([^)]*\\))?\\.fetchone|connection(?:\\([^)]*\\))?\\.fetchone_async|cursor(?:\\([^)]*\\))?\\.execute|cursor(?:\\([^)]*\\))?\\.executemany|query(?:\\([^)]*\\))?\\.execute|query(?:\\([^)]*\\))?\\.execute_async|query(?:\\([^)]*\\))?\\.fetchall|query(?:\\([^)]*\\))?\\.fetchall_async|query(?:\\([^)]*\\))?\\.fetchone|query(?:\\([^)]*\\))?\\.fetchone_async|txn(?:\\([^)]*\\))?\\.execute|txn(?:\\([^)]*\\))?\\.execute_async|txn(?:\\([^)]*\\))?\\.fetchall|txn(?:\\([^)]*\\))?\\.fetchall_async|txn(?:\\([^)]*\\))?\\.fetchone|txn(?:\\([^)]*\\))?\\.fetchone_async)$)(?s:.*)", s).
spt_flow_ev(d, f, n, "eager_sql", 1) :- spt_flow_taint(d, f, t, "authority"), spt_flow_call(d, n, f, _), spt_flow_call_attr(n, x, t), spt_flow_n_exec(x).
spt_flow_ev(d, f, n, "native_python_work", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, x), spt_flow_n_native(x).
spt_flow_ev(d, f, n, "native_python_work", 1) :- spt_flow_call(d, n, f, _), spt_flow_has_full(n), spt_flow_full_callee(n, s), match("(?s:.*)(?:(?:^|\\.)(?:np(?:\\([^)]*\\))?\\.array|np(?:\\([^)]*\\))?\\.ascontiguousarray|np(?:\\([^)]*\\))?\\.isinf|np(?:\\([^)]*\\))?\\.isnan|numpy(?:\\([^)]*\\))?\\.array|numpy(?:\\([^)]*\\))?\\.ascontiguousarray|numpy(?:\\([^)]*\\))?\\.isinf|numpy(?:\\([^)]*\\))?\\.isnan)$)(?s:.*)", s).
spt_flow_ev(d, f, n, "runtime_callback", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, "CompiledStep"), spt_flow_call_refs(n).
spt_flow_ev(d, f, n, "large_column", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, x), spt_flow_n_large(x).
spt_flow_ev(d, f, n, "large_column", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, "convert_row_to_model"), spt_flow_call_hyd(n).
spt_flow_ev(d, f, n, "resolved_refs", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, "get"), spt_flow_call_res(n).
spt_flow_ev(d, f, n, "resolved_refs", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, "peek"), spt_flow_call_res(n).
spt_flow_ev(d, f, n, "resolved_refs", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, "resolve_server_ref"), spt_flow_call_res(n).
spt_flow_ev(d, f, n, "nested_execute", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, "execute_runtime_nested_steps_async").
spt_flow_ev(d, f, n, "nested_execute", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, "execute_runtime_nested_steps_sync").
spt_flow_ev(d, f, n, "nested_execute", 1) :- spt_flow_call(d, n, f, _), spt_flow_has_full(n), spt_flow_full_callee(n, s), match("(?s:.*)(?:(?:^|\\.)(?:PlanExecutor(?:\\([^)]*\\))?\\.execute|PlanExecutor(?:\\([^)]*\\))?\\.execute_async|executor(?:\\([^)]*\\))?\\.execute|executor(?:\\([^)]*\\))?\\.execute_async)$)(?s:.*)", s).
spt_flow_ev(d, f, n, "materialized_pipeline", 1) :- spt_flow_attr(d, n, f, "materialized_pipeline", _).
spt_flow_ev(d, f, n, "materialized_pipeline", 1) :- spt_flow_sattr(d, f, n, _, "context", "materialized_pipeline").
spt_flow_ev(d, f, n, "ctx_access", 1) :- spt_flow_sattr(d, f, n, _, "context", _).
spt_flow_ev(d, f, n, "runtime_authority", 1) :- spt_flow_sattr(d, f, n, "attribute", "carrier", _).
spt_flow_ev(d, f, n, "runtime_authority", 1) :- spt_flow_sattr(d, f, n, "call", "carrier", _).
spt_flow_ev(d, f, n, "runtime_authority", 1) :- spt_flow_call(d, n, f, _), spt_flow_callee(n, "active_pipeline_txn_for_callbacks").
spt_flow_ev(d, f, n, "runtime_authority", 1) :- spt_flow_taint(d, f, n, "runtime_authority"), spt_flow_call(d, n, f, _).
spt_flow_ev(d, f, n, "runtime_authority", 0) :- spt_flow_taint(d, f, t, "runtime_authority"), spt_flow_asg(d, n, f, _, t).
spt_flow_ev(d, f, n, "runtime_value", 0) :- spt_flow_taint(d, f, t, "runtime_value"), spt_flow_asg(d, n, f, _, t).
spt_flow_ev(d, f, n, "runtime_value", 1) :- spt_flow_taint(d, f, n, "runtime_value"), spt_flow_call(d, n, f, _).
spt_flow_ev(d, f, n, "runtime_value", 1) :- spt_flow_taint(d, f, t, "runtime_value"), spt_flow_call(d, n, f, _), spt_flow_call_attr(n, _, t).
spt_flow_ev(d, f, n, "runtime_value", 1) :- spt_flow_taint(d, f, t, "runtime_value"), spt_flow_barg(d, t, n), spt_flow_call(d, n, f, _).
spt_flow_ev(d, f, n, "runtime_value", 1) :- spt_flow_taint(d, f, t, "runtime_value"), spt_flow_kw(d, _, n, _, t), spt_flow_call(d, n, f, _).
spt_flow_ev(d, f, n, "runtime_value", 1) :- spt_flow_taint(d, f, t, "runtime_value"), spt_flow_sub(d, n, f, t), node(_, t, "identifier", _, _).
spt_flow_ev(d, f, c, "runtime_value", 1) :- spt_flow_taint(d, f, n, "runtime_value"), spt_flow_bid(d, n, f, _), spt_flow_bid_cmp(n, c).
spt_flow_ev(d, f, n, "provider_authority", 1) :- spt_flow_taint(d, f, t, "provider"), spt_flow_call(d, n, f, _), spt_flow_call_attr(n, _, t), spt_flow_authority_arg(d, f, n).
spt_flow_authority_arg(d, f, c) :- spt_flow_barg(d, a, c), spt_flow_taint(d, f, a, "authority").
spt_flow_authority_arg(d, f, c) :- spt_flow_kw(d, _, c, _, v), spt_flow_taint(d, f, v, "authority").
spt_flow_semarg(d, f, c) :- spt_flow_call(d, c, f, _), spt_flow_callee(c, x), spt_flow_n_semfn(x), spt_flow_call_args(c, al), node(d, al, _, as, ae), spt_flow_seed(d, f, v), node(d, v, _, vs, ve), vs >= as, ve <= ae, !spt_flow_in_splat(c, v), !spt_flow_bid_kwn(v).
spt_flow_ev(d, f, c, "runtime_semantic_projection", 1) :- spt_flow_semarg(d, f, c).
spt_flow_ev(d, f, c, "runtime_semantic_projection", 1) :- spt_flow_call(d, c, f, _), spt_flow_callee(c, x), spt_flow_n_semmeth(x), spt_flow_call_attr(c, _, r), spt_flow_seed_in(d, f, r).
spt_flow_ev(d, f, s, "runtime_semantic_projection", 1) :- spt_flow_sub(d, s, f, v), spt_flow_sub_slice(s), spt_flow_seed_in(d, f, v).
spt_flow_comp_right(fic, r, s) :- node(_, fic, "for_in_clause", _, _), field(fic, "right", r), node(_, r, _, s, _).
spt_flow_comp(d, fic, f, comp, r) :- node(d, fic, "for_in_clause", _, _), spt_flow_top(fic, f), spt_flow_comp_right(fic, r, s), s = min t : { spt_flow_comp_right(fic, _, t) }, child(comp, fic, _), node(_, comp, ck, _, _), spt_flow_k_comp(ck), child(comp, ic, _), node(_, ic, "if_clause", _, _).
spt_flow_ev(d, f, comp, "runtime_semantic_projection", 1) :- spt_flow_comp(d, _, f, comp, r), spt_flow_seed_in(d, f, r).
spt_flow_forright(fs, r) :- spt_flow_forst(_, fs, _), field(fs, "right", r).
spt_flow_forapp(fs) :- spt_flow_forst(d, fs, _), node(d, fs, _, s, e), spt_flow_call(d, c, _, _), spt_flow_callee(c, x), (x = "append" ; x = "extend"), node(d, c, _, cs, ce), cs >= s, ce <= e.
spt_flow_prnode(d, p) :- spt_flow_sub(d, p, _, _).
spt_flow_prnode(d, p) :- spt_flow_call(d, p, _, _), spt_flow_callee(p, "get").
spt_flow_prnode(d, p) :- spt_flow_call(d, p, _, _), spt_flow_callee(p, "getattr").
spt_flow_forleft_bid(fs, x) :- spt_flow_forleft_ident(fs, i, x), spt_flow_bid(_, i, _, _).
spt_flow_forpr(fs) :- spt_flow_forst(d, fs, _), node(d, fs, _, s, e), spt_flow_prnode(d, p), node(d, p, _, ps, pe), ps >= s, pe <= e, spt_flow_bid(d, u, _, x), node(d, u, _, us, ue), us >= ps, ue <= pe, spt_flow_forleft_bid(fs, x).
spt_flow_forproj(d, f, fs) :- spt_flow_forst(d, fs, f), spt_flow_forright(fs, r), spt_flow_seed_in(d, f, r), spt_flow_forapp(fs), spt_flow_forpr(fs).
spt_flow_ev(d, f, fs, "runtime_semantic_projection", 1) :- spt_flow_forproj(d, f, fs).
spt_flow_ev(d, f, fs, "runtime_sequence_projection", 1) :- spt_flow_forproj(d, f, fs).
spt_flow_row(d, b, s, e) :- node(d, b, "function_definition", s, e), spt_flow_adoc(d).
spt_flow_row(d, b, s, e) :- node(d, b, "class_definition", s, e), spt_flow_adoc(d).
spt_flow_row(d, b, s, e) :- node(d, b, "assignment", s, e), spt_flow_adoc(d).
spt_flow_row(d, b, s, e) :- node(d, b, k, s, e), spt_flow_k_row(k), spt_flow_top(b, _).
spt_flow_row(d, b, s, e) :- node(d, b, "string", s, e), spt_flow_top(b, _), child(b, x, _), node(_, x, "interpolation", _, _).
spt_flow_ds_prio(d, f, k, p) :- spt_flow_ev(d, f, _, k, _), p = min q : { spt_flow_ev(d, f, _, k, q) }.
spt_flow_ev_span(d, f, n, k, b) :- spt_flow_ds_prio(d, f, k, p), spt_flow_ev(d, f, n, k, p), node(d, n, _, es, ee), node(d, f, _, cs, _), spt_flow_row(d, b, bs, be), bs >= cs, bs <= es, be >= ee.
spt_flow_ev_depth(d, f, n, k, x) :- spt_flow_ev_span(d, f, n, k, _), x = count : { spt_flow_ev_span(d, f, n, k, _) }.
spt_flow_ds_depth(d, f, k, x) :- spt_flow_ds_prio(d, f, k, _), x = min y : { spt_flow_ev_depth(d, f, _, k, y) }.
spt_flow_ds_cand(d, f, k, n, s) :- spt_flow_ds_depth(d, f, k, x), spt_flow_ev_depth(d, f, n, k, x), node(d, n, _, s, _).
spt_flow_ds(d, f, k, n) :- spt_flow_ds_cand(d, f, k, n, s), s = min t : { spt_flow_ds_cand(d, f, k, _, t) }.
spt_flow_dk(d, f, k) :- spt_flow_ds(d, f, k, _).
spt_flow_cg(d, f, c, t) :- spt_flow_call(d, c, f, "identifier"), spt_flow_callee(c, x), spt_flow_ctx(d, t, _, _, x), t != f, !spt_flow_ctx_incls(t).
spt_flow_cg(d, f, c, t) :- spt_flow_call(d, c, f, "attribute"), spt_flow_callee(c, x), spt_flow_ctx(d, t, _, _, x), t != f, spt_flow_ctx_cls(f, cn), spt_flow_ctx_cls(t, cn), spt_flow_recvt(c, "self").
spt_flow_cg(d, f, c, t) :- spt_flow_call(d, c, f, "attribute"), spt_flow_callee(c, x), spt_flow_ctx(d, t, _, _, x), t != f, spt_flow_ctx_cls(f, cn), spt_flow_ctx_cls(t, cn), spt_flow_recvt(c, "cls").
spt_flow_reach(d, f) :- spt_flow_ctx(d, f, _, _, _), spt_flow_planning(f).
spt_flow_reach(d, f) :- spt_flow_ctx(d, f, _, _, _), spt_flow_preprocess(f).
spt_flow_reach(d, f) :- spt_flow_ctx(d, f, _, _, _), spt_flow_materializer(f).
spt_flow_reach(d, f) :- spt_flow_ctx(d, f, _, _, _), spt_flow_ctx_helper(f).
spt_flow_reach(d, f) :- spt_flow_ctx(d, f, _, _, _), spt_flow_provider_helper(f).
spt_flow_reach(d, f) :- spt_flow_ctx(d, f, _, _, _), spt_flow_l2070(d), spt_flow_dk(d, f, "native_python_work").
spt_flow_reach(d, t) :- spt_flow_reach(d, f), spt_flow_cg(d, f, _, t).
spt_flow_l2070(d) :- doc(d, p, _), match("(?s:.*)(?:(?:^|/)impl/common/l2070_server_plan/)(?s:.*)", p).
spt_flow_w(d, f, w) :- spt_flow_ctx(d, f, s, e, _), w = @add(@strlen(@to_string(@add(@mul(s, 16777216), e))), 1).
spt_flow_num3(x) :- spt_flow_digit(a), spt_flow_digit(b), spt_flow_digit(c), x = @add(@add(@mul(a, 100), @mul(b, 10)), c).
spt_flow_num(x) :- spt_flow_num3(y), spt_flow_digit(a), spt_flow_digit(b), x = @add(@add(@mul(a, 10000), @mul(b, 1000)), y).
spt_flow_bound(d, b) :- spt_flow_ctx(d, _, _, _, _), n = count : { spt_flow_ctx(d, _, _, _, _) }, m = max x : { spt_flow_w(d, _, x) }, b = @add(1, @mul(n, m)).
spt_flow_wval(d, w) :- spt_flow_w(d, _, w).
spt_flow_add(d, l, w, l2) :- spt_flow_tdoc(d), spt_flow_bound(d, b), b < 1000, spt_flow_wval(d, w), spt_flow_num3(l), l2 = @add(l, w), l2 <= b.
spt_flow_add(d, l, w, l2) :- spt_flow_tdoc(d), spt_flow_bound(d, b), b >= 1000, spt_flow_wval(d, w), spt_flow_num(l), l2 = @add(l, w), l2 <= b.
spt_flow_tdoc(d) :- spt_flow_dk(d, _, _).
spt_flow_tdoc(d) :- spt_flow_pk(d, _, _).
spt_flow_tl(d, f, k, l, f) :- spt_flow_dk(d, f, k), spt_flow_reach(d, f), spt_flow_w(d, f, w), l = @add(1, w).
spt_flow_tl(d, f, k, l2, o) :- spt_flow_tl(d, t, k, l, o), spt_flow_cg(d, f, _, t), spt_flow_reach(d, f), !spt_flow_dk(d, f, k), spt_flow_w(d, f, w), spt_flow_add(d, l, w, l2).
spt_flow_tmin(d, f, k, l) :- spt_flow_tl(d, f, k, _, _), !spt_flow_dk(d, f, k), l = min x : { spt_flow_tl(d, f, k, x, _) }.
spt_flow_tcand(d, f, k, c, t, l1) :- spt_flow_tmin(d, f, k, l), spt_flow_w(d, f, w), l1 = @sub(l, w), spt_flow_cg(d, f, c, t), spt_flow_tl(d, t, k, l1, _).
rr_agg23(d, f, k, y) :- spt_flow_tcand(d, f, k, c, _, _), node(d, c, _, y, _).
spt_flow_tstart(d, f, k, s) :- spt_flow_tcand(d, f, k, _, _, _), s = min y : { rr_agg23(d, f, k, y) }.
spt_flow_tsite(d, f, k, c) :- spt_flow_tstart(d, f, k, s), spt_flow_tcand(d, f, k, c, _, _), node(d, c, _, s, _).
spt_flow_torig(d, f, k, o, s) :- spt_flow_tsite(d, f, k, c), spt_flow_tcand(d, f, k, c, t, l1), spt_flow_tl(d, t, k, l1, o), node(d, o, _, s, _).
spt_flow_ts(d, f, k, n, f) :- spt_flow_ds(d, f, k, n), spt_flow_reach(d, f).
spt_flow_ts(d, f, k, c, o) :- spt_flow_tsite(d, f, k, c), spt_flow_torig(d, f, k, o, s), s = min y : { spt_flow_torig(d, f, k, _, y) }.
spt_flow_bcall(c, sn) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, sn), spt_flow_n_builder(sn).
spt_flow_bcall(c, sn) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, sn), spt_flow_n_builder(sn).
spt_flow_bcall_skw(c) :- spt_flow_bcall(c, _), field(c, "arguments", al), child(al, k, _), node(_, k, "keyword_argument", _, _), field(k, "name", kn), node(_, kn, "identifier", _, _), text(kn, "builder_name").
spt_flow_bcall_stwo(c) :- spt_flow_bcall(c, _), field(c, "arguments", al), spt_flow_pos1(al, _).
spt_flow_bcmp(x) :- child(c, x, _), node(_, c, "comparison_operator", _, _), child(c, a, _), node(_, a, "attribute", _, _), field(a, "object", o), node(_, o, "identifier", _, _), text(o, "spec"), field(a, "attribute", b), node(_, b, "identifier", _, _), text(b, "builder_name").
spt_flow_btwo(x, c) :- spt_flow_pos1(al, x), node(_, al, "argument_list", _, _), field(c, "arguments", al), spt_flow_bcall(c, _).
spt_flow_bkwp(x, c) :- field(k, "value", x), node(_, k, "keyword_argument", _, _), field(k, "name", kn), node(_, kn, "identifier", _, _), text(kn, "builder_name"), child(al, k, _), node(_, al, "argument_list", _, _), field(c, "arguments", al), spt_flow_bcall(c, _).
spt_flow_bpos(x) :- spt_flow_bcmp(x).
spt_flow_bpos(x) :- spt_flow_btwo(x, _).
spt_flow_bpos(x) :- spt_flow_bkwp(x, _).
spt_flow_bstr_mt(d, x, v) :- spt_flow_sps(1), spt_flow_asg_mods(a), spt_flow_asg_lt(a, x), field(a, "right", s), node(d, s, k, _, _), spt_flow_k_str(k), !spt_flow_interp(s), value(s, v), v != "".
spt_flow_btok(d, f, x, v) :- spt_flow_sps(1), node(d, x, k, _, _), spt_flow_k_str(k), spt_flow_adoc(d), !spt_flow_interp(x), spt_flow_top(x, f), spt_flow_bpos(x), value(x, v), v != "".
spt_flow_btok(d, f, x, at) :- spt_flow_sps(1), node(d, x, "attribute", _, _), spt_flow_adoc(d), field(x, "object", o), node(_, o, "identifier", _, _), text(o, "RuntimeBuilderName"), field(x, "attribute", a), text(a, at), spt_flow_top(x, f), spt_flow_bpos(x).
spt_flow_btok(d, f, x, v) :- spt_flow_sps(1), node(d, x, "identifier", _, _), spt_flow_adoc(d), text(x, t), spt_flow_top(x, f), spt_flow_bpos(x), spt_flow_bstr_mt(d, t, v).
spt_flow_bsite(d, f, s, v) :- spt_flow_btok(d, f, x, v), spt_flow_btwo(x, s), spt_flow_bcall(s, "runtime_builder_post_op").
spt_flow_bsite(d, f, s, v) :- spt_flow_btok(d, f, x, v), spt_flow_btwo(x, s), spt_flow_bcall(s, "RuntimeBuilderSpec"), !spt_flow_bcall_skw(s).
spt_flow_bsite(d, f, s, v) :- spt_flow_btok(d, f, x, v), spt_flow_bkwp(x, s), spt_flow_bcall(s, "RuntimeBuilderSpec").
spt_flow_bsite(d, f, s, v) :- spt_flow_btok(d, f, x, v), spt_flow_bkwp(x, s), spt_flow_bcall(s, "runtime_builder_post_op"), !spt_flow_bcall_stwo(s).
spt_flow_sembuilder(v) :- spt_flow_btok(d, f, x, v), spt_flow_bcmp(x), spt_flow_dk(d, f, "runtime_sequence_projection").
spt_flow_helper(x) :- spt_flow_ctx(d, c, _, _, x), spt_flow_bsite(d, c, _, v), spt_flow_sembuilder(v).
spt_flow_pseed(d, f, s, "builder", 0) :- spt_flow_bsite(d, f, s, v), spt_flow_sembuilder(v).
spt_flow_pseed(d, f, c, "builder", 1) :- spt_flow_call(d, c, f, _), spt_flow_callee(c, x), spt_flow_helper(x), !spt_flow_cg_site(c).
spt_flow_pseed(d, f, n, "semantic", 0) :- spt_flow_pmode(1), spt_flow_ds(d, f, "runtime_semantic_projection", n).
spt_flow_cg_site(c) :- spt_flow_cg(_, _, c, _).
spt_flow_pk(d, f, k) :- spt_flow_pseed(d, f, _, k, _).
spt_flow_pl(d, f, k, l, p, n) :- spt_flow_pseed(d, f, n, k, p), spt_flow_w(d, f, w), l = @add(1, w).
spt_flow_pl(d, f, k, l2, p, n) :- spt_flow_pl(d, t, k, l, p, n), spt_flow_cg(d, f, _, t), !spt_flow_pk(d, f, k), spt_flow_w(d, f, w), spt_flow_add(d, l, w, l2).
spt_flow_plmin(d, f, k, l) :- spt_flow_pl(d, f, k, _, _, _), l = min x : { spt_flow_pl(d, f, k, x, _, _) }.
spt_flow_plprio(d, f, k, l, p) :- spt_flow_plmin(d, f, k, l), p = min q : { spt_flow_pl(d, f, k, l, q, _) }.
rr_agg24(d, f, k, l, p, y) :- spt_flow_pl(d, f, k, l, p, m), node(d, m, _, y, _).
spt_flow_ps(d, f, k, n) :- spt_flow_plprio(d, f, k, l, p), spt_flow_pl(d, f, k, l, p, n), node(d, n, _, s, _), s = min y : { rr_agg24(d, f, k, l, p, y) }.
spt_flow_fhit(d, f, "SPT-003", n) :- spt_flow_ts(d, f, "eager_sql", n, o), o != f, spt_flow_planning(f), !spt_flow_preprocess(f).
spt_flow_fhit(d, f, "SPT-011", n) :- spt_flow_ts(d, f, "eager_sql", n, o), o != f, spt_flow_preprocess(f).
spt_flow_fhit(d, f, "SPT-019", n) :- spt_flow_ts(d, f, "eager_sql", n, o), o != f, spt_flow_provider_helper(f).
spt_flow_fhit(d, f, "SPT-020", n) :- spt_flow_ts(d, f, "ctx_access", n, o), o != f, spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-020", n) :- spt_flow_ts(d, f, "ctx_access", n, o), o != f, spt_flow_ctx_helper(f).
spt_flow_fhit(d, f, "SPT-002", n) :- spt_flow_ts(d, f, "large_column", n, o), o != f, spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-010", n) :- spt_flow_ts(d, f, "resolved_refs", n, o), o != f, spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-005", n) :- spt_flow_ts(d, f, "nested_execute", n, o), o != f, spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-012", n) :- spt_flow_ts(d, f, "materialized_pipeline", n, o), o != f, spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-022", n) :- spt_flow_ts(d, f, "runtime_authority", n, _), spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-024", n) :- spt_flow_ts(d, f, "runtime_value", n, o), spt_flow_planning(f), spt_flow_ctx(d, o, _, _, x), !spt_flow_n_postproc(x), !spt_flow_postop_refs_name(x).
spt_flow_fhit(d, f, "SPT-021", n) :- spt_flow_ts(d, f, "provider_authority", n, _), spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-026", n) :- spt_flow_ts(d, f, "runtime_callback", n, _), spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-028", n) :- spt_flow_ts(d, f, "runtime_semantic_projection", n, _), spt_flow_planning(f).
spt_flow_fhit(d, f, "SPT-028", n) :- spt_flow_ts(d, f, "runtime_sequence_projection", n, f), !spt_flow_planning(f), spt_flow_materializer(f).
spt_flow_fhit(d, f, "SPT-027", n) :- spt_flow_ts(d, f, "native_python_work", n, f), spt_flow_l2070(d).
spt_flow_postop_refs_name(x) :- spt_flow_ctx(_, _, _, _, x), suffix("_post_op_with_refs", x).
spt_flow_qual(f, q) :- spt_flow_ctx(_, f, _, _, x), spt_flow_ctx_cls(f, cn), q = @concat(@concat(cn, "."), x).
spt_flow_qual(f, x) :- spt_flow_ctx(_, f, _, _, x), !spt_flow_ctx_incls(f).
spt_flow_exempt(d, f, code) :- spt_flow_signed_on(1), spt_flow_fhit(d, f, code, _), spt_flow_qual(f, q), doc(d, p, _), spt_flow_signed(code, q, p).
spt_flow_hit(d, code, n) :- spt_flow_fhit(d, f, code, n), !spt_flow_exempt(d, f, code).
spt_flow_hit(d, "SPT-020", n) :- spt_flow_sattr(d, f, n, "call", "context", a), (a = "txn" ; a = "sql_connection"), !spt_tests_path(d), spt_flow_planning(f).
spt_flow_hit(d, "SPT-020", n) :- spt_flow_sattr(d, f, n, "call", "context", a), (a = "txn" ; a = "sql_connection"), !spt_tests_path(d), spt_flow_ctx_helper(f).
spt_flow_hit(d, "SPT-012", n) :- spt_flow_sattr(d, f, n, "call", "context", "materialized_pipeline"), spt_flow_planning(f).
spt_flow_hit(d, "SPT-023", n) :- spt_flow_call(d, n, _, _), spt_flow_callee(n, "convert_row_to_model"), !spt_tests_path(d), node(d, n, _, ns, ne), spt_flow_fn(d, nf, fs, fe, _), fs <= ns, fe >= ne, spt_flow_param(d, nf, _, x), spt_flow_cbparam(d, of, x, _, _), spt_flow_ctx(d, of, os, oe, _), fs > os, fe <= oe.
spt_flow_hit(d, "SPT-028", n) :- spt_flow_sps(1), spt_flow_planning(f), spt_flow_ps(d, f, "builder", n), !spt_flow_pk_sink(d, f, "semantic").
spt_flow_pk_sink(d, f, k) :- spt_flow_ps(d, f, k, _).
violation("data-layer-serverplan-state-tripwires", "state-flow-narrow", code, p, l) :- spt_flow_hit(d, code, n), spt_doc(d, p), line(n, l).
