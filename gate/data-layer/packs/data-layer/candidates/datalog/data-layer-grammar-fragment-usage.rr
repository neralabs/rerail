.scope text "**/*.[mM][dD]", "**/*.[mM][aA][rR][kK][dD][oO][wW][nN]", "**/*.[rR][sS][tT]", "**/*.[tT][xX][tT]", "**/*.[tT][oO][mM][lL]", "**/*.[cC][fF][gG]", "**/*.[iI][nN][iI]", "**/*.[yY][aA][mM][lL]", "**/*.[yY][mM][lL]"
.decl constructor_class_kinds(kind: symbol)
constructor_class_kinds("class_definition").
.decl constructor_fdef_kinds(kind: symbol)
constructor_fdef_kinds("function_definition").
.decl captured_arg_at(g: node, i: number)
.decl captured_assign(a: node, x: symbol)
.decl captured_binding_place(a: node)
.decl captured_bs(n: node)
.decl captured_earlier(f: node)
.decl captured_edge(c: node, caller: symbol, target: symbol)
.decl captured_field(c: node, x: symbol)
.decl captured_first_arg(k: node, c: node)
.decl captured_fragment_call(k: node)
.decl captured_in_concat(n: node)
.decl captured_index(p: node, c: node, k: number)
.decl captured_index_list(p: node)
.decl captured_init(c: node, f: node)
.decl captured_later(f: node)
.decl captured_loose_param(q: node)
.decl captured_loose_type(t: node)
.decl captured_member(c: node, f: node, x: symbol)
.decl captured_method(c: node, m: node, x: symbol)
.decl captured_name_assign(a: node, x: symbol)
.decl captured_owner(c: node, cn: symbol)
.decl captured_param_kinds(kind: symbol)
.decl captured_param_named(q: node, p: symbol)
.decl captured_pattern_kinds(kind: symbol)
.decl captured_reach(c: node, x: symbol)
.decl captured_return(d: number, r: node, c: node, cn: symbol)
.decl captured_return_row(d: number, r: node, c: node, x: symbol)
.decl captured_returns_field(r: node)
.decl captured_rf(x: node, cn: symbol)
.decl captured_rf_need(x: node, cn: symbol)
.decl captured_self_assign(a: node, x: symbol)
.decl captured_self_attr(n: node, x: symbol)
.decl captured_str_method(s: symbol)
.decl captured_string_binding(d: number, x: symbol, e: number)
.decl captured_typed(q: node)
.decl captured_unsafe_field(c: node, x: symbol)
.decl captured_value_list_kinds(kind: symbol)
.decl child(p: node, c: node, i: number)
.decl constructor_base_name(d: number, x: symbol)
.decl constructor_f_concat(c: node)
.decl constructor_forbidden_class(c: node)
.decl constructor_fragment_alias(d: number, x: symbol)
.decl constructor_fragment_import(a: node)
.decl constructor_fragment_type(n: node)
.decl constructor_grammar_base(b: node)
.decl constructor_grammar_class(c: node)
.decl constructor_literal_value(n: node, v: symbol)
.decl constructor_param_shape(q: node)
.decl constructor_plain_literal(n: node)
.decl constructor_plain_part(n: node)
.decl constructor_render_body(c: node)
.decl constructor_self_param(q: node)
.decl constructor_sync_def(f: node)
.decl constructor_type_kinds(kind: symbol)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl node_text(n: node, s: symbol)
.decl op(n: node, s: symbol)
.decl out_scope(d: number)
.decl rr_agg1(p: node, s: number, x: node, xs: number)
.decl rr_ctx2(p: node, s: number)
.decl rr_demand_agg_rr_agg1(p: node, s: number)
.decl strprefix(n: node, p: symbol)
.decl syntax_error(d: number)
.decl tape_syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, field, text, line, syntax_error, child, op, value, strprefix, value_type_of, node_text
.output violation
captured_param_kinds("typed_parameter").
captured_param_kinds("typed_default_parameter").
captured_param_kinds("default_parameter").
captured_pattern_kinds("tuple_pattern").
captured_pattern_kinds("list_pattern").
captured_pattern_kinds("pattern_list").
captured_str_method("casefold").
captured_str_method("format").
captured_str_method("format_map").
captured_str_method("join").
captured_str_method("lower").
captured_str_method("lstrip").
captured_str_method("removeprefix").
captured_str_method("removesuffix").
captured_str_method("replace").
captured_str_method("rstrip").
captured_str_method("strip").
captured_str_method("translate").
captured_str_method("upper").
captured_value_list_kinds("tuple").
captured_value_list_kinds("list").
captured_value_list_kinds("expression_list").
constructor_type_kinds("type").
constructor_type_kinds("generic_type").
constructor_type_kinds("type_parameter").
constructor_type_kinds("union_type").
