constructor_type_kinds("list").
constructor_type_kinds("tuple").
constructor_type_kinds("subscript").
constructor_type_kinds("parenthesized_expression").
in_scope(d) :- doc(d, p, _), glob("api/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("data_layer/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("_internal/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l[0-9]*/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
tape_syntax_error(d) :- syntax_error(d).
violation("data-layer-grammar-fragment-usage", "forbidden-class", "sqlfragment_usage", p, l) :- node(_, n, "class_definition", _, _), field(n, "name", v1), node(_, v1, "identifier", _, _), text(v1, v2), (v2 = "SqlDeferredRenderable" ; v2 = "SqlPreRenderedFragment"), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
violation("data-layer-grammar-fragment-usage", "syntax-error", "python_parse_error", p, 1) :- node(_, n, "module", _, _), node(d, n, _, _, _), in_scope(d), syntax_error(d), !out_scope(d), doc(d, p, _).
constructor_sync_def(f) :- node(_, f, "function_definition", _, _), node_text(f, s), match("def\\s(?s:.*)", s).
constructor_plain_part(n) :- node(_, n, "string", _, _), strprefix(n, x), !contains("f", x).
constructor_f_concat(c) :- node(_, c, "concatenated_string", _, _), child(c, s, _), node(_, s, "string", _, _), strprefix(s, x), contains("f", x).
constructor_plain_literal(n) :- constructor_plain_part(n).
constructor_plain_literal(n) :- node(_, n, "concatenated_string", _, _), !constructor_f_concat(n).
constructor_literal_value(n, v) :- constructor_plain_literal(n), value(n, v), value_type_of(n, "str").
constructor_fragment_import(a) :- node(_, a, "aliased_import", _, _), child(i, a, _), node(_, i, "import_from_statement", _, _), field(a, "name", nm), node_text(nm, "SqlFragment").
constructor_fragment_import(a) :- node(_, a, "aliased_import", _, _), child(i, a, _), node(_, i, "import_from_statement", _, _), field(a, "name", nm), node_text(nm, s), suffix(".SqlFragment", s).
constructor_fragment_alias(d, x) :- constructor_fragment_import(a), node(d, a, _, _, _), field(a, "alias", al), text(al, x).
constructor_fragment_type(n) :- node(_, n, "identifier", _, _), text(n, "SqlFragment").
constructor_fragment_type(n) :- node(_, n, "attribute", _, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, "SqlFragment").
constructor_fragment_type(n) :- node(d, n, "identifier", _, _), text(n, x), constructor_fragment_alias(d, x).
constructor_fragment_type(n) :- constructor_literal_value(n, v), match("(?s:.*)(?:(?:^|[^A-Za-z0-9_])SqlFragment(?:$|[^A-Za-z0-9_]))(?s:.*)", v).
constructor_fragment_type(n) :- constructor_literal_value(n, v), node(d, n, _, _, _), constructor_fragment_alias(d, x), match("[A-Za-z_][A-Za-z0-9_]*", x), w = @concat("(?s:.*)(?:^|[^A-Za-z0-9_])[0-9]*", @concat(x, "(?:$|[^A-Za-z0-9_])(?s:.*)")), match(w, v).
constructor_fragment_type(n) :- node(_, n, k, _, _), constructor_type_kinds(k), child(n, c, _), constructor_fragment_type(c).
constructor_forbidden_class(c) :- node(_, c, "class_definition", _, _), field(c, "name", i), node(_, i, "identifier", _, _), text(i, s), (s = "SqlDeferredRenderable" ; s = "SqlFragment" ; s = "SqlPreRenderedFragment").
constructor_render_body(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, f, _), node(_, f, "function_definition", _, _), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "render").
constructor_render_body(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, g, _), node(_, g, "decorated_definition", _, _), field(g, "definition", f), node(_, f, "function_definition", _, _), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "render").
constructor_grammar_class(c) :- node(_, c, "class_definition", _, _), !constructor_forbidden_class(c), field(c, "name", i), text(i, s), (prefix("Sql", s) ; prefix("_Sql", s)).
constructor_grammar_class(c) :- constructor_render_body(c), !constructor_forbidden_class(c).
constructor_grammar_class(c) :- node(_, c, "class_definition", _, _), !constructor_forbidden_class(c), field(c, "superclasses", sc), child(sc, b, _), constructor_grammar_base(b).
constructor_base_name(d, x) :- node(d, a, "aliased_import", _, _), child(i, a, _), node(_, i, "import_from_statement", _, _), field(a, "name", nm), node_text(nm, s), (prefix("Sql", s) ; prefix("_Sql", s)), field(a, "alias", al), text(al, x).
constructor_base_name(d, x) :- node(d, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x), field(a, "right", r), constructor_grammar_base(r).
constructor_base_name(d, x) :- constructor_grammar_class(c), node(d, c, _, _, _), field(c, "name", i), text(i, x).
constructor_grammar_base(b) :- node(_, b, "identifier", _, _), text(b, s), (prefix("Sql", s) ; prefix("_Sql", s)).
constructor_grammar_base(b) :- node(d, b, "identifier", _, _), text(b, x), constructor_base_name(d, x).
constructor_grammar_base(b) :- node(_, b, "attribute", _, _), field(b, "attribute", a), text(a, s), (prefix("Sql", s) ; prefix("_Sql", s)).
constructor_param_shape(q) :- node(_, q, "identifier", _, _).
constructor_param_shape(q) :- node(_, q, "default_parameter", _, _), field(q, "name", _).
constructor_param_shape(q) :- node(_, q, "typed_default_parameter", _, _), field(q, "name", _).
constructor_param_shape(q) :- node(_, q, "typed_parameter", _, _), child(q, i, _), node(_, i, "identifier", _, _).
constructor_param_shape(q) :- node(_, q, "typed_parameter", _, _), child(q, s, _), node(_, s, "list_splat_pattern", _, _), child(s, i, _), node(_, i, "identifier", _, _).
constructor_param_shape(q) :- node(_, q, "typed_parameter", _, _), child(q, s, _), node(_, s, "dictionary_splat_pattern", _, _), child(s, i, _), node(_, i, "identifier", _, _).
constructor_self_param(q) :- child(q, i, _), node(_, i, "identifier", _, _), text(i, "self").
violation("data-layer-grammar-fragment-usage", "constructor-fragment", "sqlfragment_usage", p, l) :- node(d, f, "function_definition", _, _), constructor_sync_def(f), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "__init__"), nearest(f, c, constructor_class_kinds), constructor_grammar_class(c), field(f, "parameters", ps), child(ps, q, _), constructor_param_shape(q), !constructor_self_param(q), field(q, "type", t), constructor_fragment_type(t), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _), line(f, l).
violation("data-layer-grammar-fragment-usage", "attribute-fragment", "sqlfragment_usage", p, l) :- node(d, a, "assignment", _, _), field(a, "type", t), constructor_fragment_type(t), !inside(a, _, constructor_fdef_kinds), nearest(a, c, constructor_class_kinds), constructor_grammar_class(c), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _), line(a, l).
captured_in_concat(n) :- node(_, n, "string", _, _), child(c, n, _), node(_, c, "concatenated_string", _, _).
captured_bs(n) :- constructor_plain_literal(n), !captured_in_concat(n), value_type_of(n, "str").
captured_bs(n) :- node(_, n, "string", _, _), strprefix(n, x), contains("f", x), !captured_in_concat(n).
captured_bs(n) :- constructor_f_concat(n).
captured_bs(n) :- node(_, n, "format_specifier", _, _).
captured_bs(n) :- node(_, n, "list", _, _), child(n, c, _), captured_bs(c).
captured_bs(n) :- node(_, n, "set", _, _), child(n, c, _), captured_bs(c).
captured_bs(n) :- node(_, n, "tuple", _, _), child(n, c, _), captured_bs(c).
captured_bs(n) :- node(_, n, "dictionary", _, _), child(n, pr, _), node(_, pr, "pair", _, _), field(pr, "value", v), captured_bs(v).
captured_bs(n) :- node(_, n, "binary_operator", _, _), op(n, "+"), field(n, "left", c), captured_bs(c).
captured_bs(n) :- node(_, n, "binary_operator", _, _), op(n, "+"), field(n, "right", c), captured_bs(c).
captured_bs(n) :- node(_, n, "conditional_expression", _, _), child(n, c, 0), captured_bs(c).
captured_bs(n) :- node(_, n, "conditional_expression", _, _), child(n, c, 2), captured_bs(c).
captured_bs(n) :- node(_, n, "parenthesized_expression", _, _), child(n, c, _), captured_bs(c).
captured_bs(n) :- node(_, n, "call", _, _), field(n, "function", g), node(_, g, "identifier", _, _), text(g, "str").
captured_bs(n) :- node(_, n, "call", _, _), field(n, "function", g), node(_, g, "attribute", _, _), field(g, "attribute", a), node(_, a, "identifier", _, _), text(a, s), captured_str_method(s), field(g, "object", o), captured_bs(o).
captured_bs(n) :- node(d, n, "identifier", _, _), text(n, x), node(d, n, _, us, _), captured_string_binding(d, x, ae), ae <= us.
captured_binding_place(a) :- node(_, a, "assignment", _, _), !inside(a, _, constructor_class_kinds).
captured_binding_place(a) :- node(_, a, "assignment", _, _), nearest(a, f, constructor_fdef_kinds), constructor_sync_def(f), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "__init__").
captured_string_binding(d, x, e) :- node(d, a, "assignment", _, e), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x), field(a, "right", r), captured_bs(r), captured_binding_place(a).
captured_name_assign(a, x) :- node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x), field(a, "right", r), captured_bs(r).
captured_name_assign(a, x) :- node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x), field(a, "type", t), node(_, t, "type", _, _), child(t, i, _), node(_, i, "identifier", _, _), text(i, "str").
captured_self_attr(n, x) :- node(_, n, "attribute", _, _), field(n, "object", o), node(_, o, "identifier", _, _), text(o, "self"), field(n, "attribute", a), text(a, x).
captured_self_assign(a, x) :- node(_, a, "assignment", _, _), field(a, "left", l), captured_self_attr(l, x), field(a, "right", r), captured_bs(r).
captured_assign(a, x) :- captured_name_assign(a, x).
captured_assign(a, x) :- captured_self_assign(a, x).
captured_init(c, f) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, f, _), constructor_sync_def(f), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "__init__").
captured_init(c, f) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, g, _), node(_, g, "decorated_definition", _, _), field(g, "definition", f), constructor_sync_def(f), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "__init__").
captured_field(c, x) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, a, _), captured_assign(a, x).
captured_field(c, x) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _), node(_, s, "expression_statement", _, _), child(s, a, _), captured_assign(a, x).
captured_field(c, x) :- captured_init(c, f), node(_, a, "assignment", _, _), inside(a, f, constructor_fdef_kinds), captured_assign(a, x).
captured_field(c, x) :- captured_init(c, f), node(_, a, "assignment", _, _), inside(a, f, constructor_fdef_kinds), field(a, "left", lp), node(_, lp, lk, _, _), captured_pattern_kinds(lk), child(lp, t, _), captured_self_attr(t, x), captured_index(lp, t, i), field(a, "right", rp), node(_, rp, rk, _, _), captured_value_list_kinds(rk), child(rp, v, _), captured_bs(v), captured_index(rp, v, i).
captured_index_list(p) :- node(_, p, k, _, _), captured_pattern_kinds(k).
captured_index_list(p) :- node(_, p, k, _, _), captured_value_list_kinds(k).
rr_ctx2(p, s) :- child(p, c, _), node(_, c, _, s, _).
rr_agg1(p, s, x, xs) :- rr_demand_agg_rr_agg1(p, s), rr_ctx2(p, s), child(p, x, _), node(_, x, _, xs, _), xs < s, !node(_, x, "comment", _, _).
captured_index(p, c, k) :- captured_index_list(p), child(p, c, _), node(_, c, _, s, _), k = count : { rr_agg1(p, s, _, _) }.
captured_param_named(q, p) :- node(_, q, "identifier", _, _), text(q, p).
captured_param_named(q, p) :- node(_, q, k, _, _), captured_param_kinds(k), field(q, "name", n), text(n, p).
captured_param_named(q, p) :- node(_, q, k, _, _), captured_param_kinds(k), child(q, i, _), node(_, i, "identifier", _, _), text(i, p).
captured_loose_type(t) :- node(_, t, "type", _, _), child(t, i, _), node(_, i, "identifier", _, _), text(i, s), (s = "Any" ; s = "str").
captured_loose_type(t) :- node(_, t, "type", _, _), child(t, i, _), node(_, i, "attribute", _, _), field(i, "attribute", a), node(_, a, "identifier", _, _), text(a, s), (s = "Any" ; s = "str").
captured_typed(q) :- field(q, "type", _).
captured_loose_param(q) :- captured_param_named(q, _), !captured_typed(q).
captured_loose_param(q) :- captured_param_named(q, _), field(q, "type", t), captured_loose_type(t).
captured_unsafe_field(c, x) :- captured_init(c, f), node(_, a, "assignment", _, _), inside(a, f, constructor_fdef_kinds), field(a, "left", l), captured_self_attr(l, x), field(a, "right", r), node(_, r, "identifier", _, _), text(r, p), field(f, "parameters", ps), child(ps, q, _), captured_param_named(q, p), captured_loose_param(q).
captured_fragment_call(k) :- node(_, k, "call", _, _), field(k, "function", g), node(_, g, "identifier", _, _), text(g, "SqlFragment").
captured_fragment_call(k) :- node(_, k, "call", _, _), field(k, "function", g), node(_, g, "attribute", _, _), field(g, "object", o), node(_, o, "identifier", _, _), text(o, "SqlFragment"), field(g, "attribute", a), node(_, a, "identifier", _, _), text(a, s), (s = "static" ; s = "with_params").
captured_arg_at(g, i) :- captured_fragment_call(k), field(k, "arguments", g), child(g, c, i), !node(_, c, "comment", _, _).
captured_first_arg(k, c) :- captured_fragment_call(k), field(k, "arguments", g), child(g, c, i), !node(_, c, "comment", _, _), i = min j : { captured_arg_at(g, j) }.
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "binary_operator", _, _), op(x, "+"), field(x, "left", y).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "binary_operator", _, _), op(x, "+"), field(x, "right", y).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "conditional_expression", _, _), child(x, y, 0).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "conditional_expression", _, _), child(x, y, 2).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "subscript", _, _), field(x, "value", y).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "parenthesized_expression", _, _), child(x, y, _).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), captured_first_arg(x, y).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "attribute", _, _), field(x, "object", o), node(_, o, "identifier", _, _), text(o, "self"), field(x, "attribute", a), text(a, f), nearest(x, k, constructor_class_kinds), captured_field(k, f).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "attribute", _, _), field(x, "object", o), text(o, cn), field(x, "attribute", a), text(a, f), nearest(x, k, constructor_class_kinds), captured_field(k, f).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "binary_operator", _, _), op(x, "+"), field(x, "left", y), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "binary_operator", _, _), op(x, "+"), field(x, "right", y), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "conditional_expression", _, _), child(x, y, 0), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "conditional_expression", _, _), child(x, y, 2), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "subscript", _, _), field(x, "value", y), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "parenthesized_expression", _, _), child(x, y, _), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), captured_first_arg(x, y), captured_rf(y, cn).
captured_owner(c, cn) :- constructor_render_body(c), field(c, "name", i), text(i, cn), cn != "SqlDeferredRenderable", cn != "SqlPreRenderedFragment".
captured_member(c, f, x) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, f, _), node(_, f, "function_definition", _, _), field(f, "name", i), text(i, x).
captured_member(c, f, x) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, g, _), node(_, g, "decorated_definition", _, _), field(g, "definition", f), node(_, f, "function_definition", _, _), field(f, "name", i), text(i, x).
captured_earlier(m) :- captured_member(c, m, x), captured_member(c, f, x), node(_, f, _, _, fe), node(_, m, _, ms, _), fe <= ms.
captured_later(m) :- captured_member(c, m, x), captured_member(c, f, x), node(_, f, _, fs, _), node(_, m, _, _, me), fs >= me.
captured_method(c, m, "render") :- captured_owner(c, _), captured_member(c, m, "render"), !captured_earlier(m).
captured_method(c, m, x) :- captured_owner(c, _), captured_member(c, m, x), x != "render", !captured_later(m).
captured_edge(c, x, t) :- node(d, k, "call", _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), field(k, "function", g), node(_, g, "attribute", _, _), field(g, "object", o), node(_, o, "identifier", _, _), text(o, s), (s = "cls" ; s = "self"), field(g, "attribute", a), text(a, t), inside(k, m, constructor_fdef_kinds), captured_method(c, m, x).
captured_return(d, r, c, cn) :- node(d, r, "return_statement", _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), nearest(r, c, constructor_class_kinds), captured_owner(c, cn).
captured_rf_need(x, cn) :- captured_return(_, r, _, cn), child(r, x, _).
captured_returns_field(r) :- captured_return(_, r, _, cn), child(r, x, _), captured_rf(x, cn).
captured_returns_field(r) :- captured_return(_, r, _, _), child(r, x, _), captured_self_attr(x, f), nearest(x, k, constructor_class_kinds), captured_unsafe_field(k, f).
captured_return_row(d, r, c, x) :- captured_return(d, r, c, _), captured_returns_field(r), inside(r, m, constructor_fdef_kinds), captured_method(c, m, x).
captured_reach(c, "render") :- captured_return_row(_, _, c, _).
captured_reach(c, y) :- captured_reach(c, x), captured_edge(c, x, y).
violation("data-layer-grammar-fragment-usage", "captured-return", "sqlfragment_usage", p, l) :- captured_return_row(d, r, c, x), captured_reach(c, x), doc(d, p, _), line(r, l).
rr_demand_agg_rr_agg1(p, s) :- captured_index_list(p), child(p, c, _), node(_, c, _, s, _).
