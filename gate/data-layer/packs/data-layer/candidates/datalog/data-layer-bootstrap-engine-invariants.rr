in_scope(d) :- doc(d, p, _), glob("l3200_metadata/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l2000_connection/schema_transaction.py", p).
in_scope(d) :- doc(d, p, _), glob("l2055_lazy_result/purity.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2200_sql_dialect/{sql_connection,sql_core_support_free_functions,sql_core_support_mixin,sql_execution_mixin,sql_schema_services,sql_bootstrap_metadata_services}.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2070_server_plan/steps/bootstrap_interrogation.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l7245_versioned_backends/{generic_sparse,staged_table_triggers}.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/read_through/connection.py", p).
in_scope(d) :- doc(d, p, _), glob("data_layer_testing/helpers/{bootstrap,bootstrap_manifest}.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
tape_syntax_error(d) :- syntax_error(d).
bootstrap_invariants_entry(v) :- option_value("entryPoint", v).
bootstrap_invariants_params(j) :- option_value("parameters", j).
bootstrap_invariants_has_engine_key(1) :- bootstrap_invariants_params(j), match("(?s:.*)\"enginePaths\"[ \\t\\n\\r]*:[ \\t\\n\\r]*\\[(?s:.*)", j).
bootstrap_invariants_has_bootstrap_key(1) :- bootstrap_invariants_params(j), match("(?s:.*)\"bootstrapPaths\"[ \\t\\n\\r]*:[ \\t\\n\\r]*\\[(?s:.*)", j).
bootstrap_invariants_default_path(d) :- doc(d, p, _), (p = "l3200_metadata/bootstrap_state.py" ; p = "l3200_metadata/bootstrap_coordinator.py").
bootstrap_invariants_engine_path(d) :- bootstrap_invariants_default_path(d), !bootstrap_invariants_has_engine_key(1).
bootstrap_invariants_engine_path(d) :- option_json("parameters", ptr, p), prefix("/enginePaths/", ptr), doc(d, p, _).
bootstrap_invariants_bootstrap_path(d) :- bootstrap_invariants_default_path(d), !bootstrap_invariants_has_bootstrap_key(1).
bootstrap_invariants_bootstrap_path(d) :- option_json("parameters", ptr, p), prefix("/bootstrapPaths/", ptr), doc(d, p, _).
bootstrap_invariants_has_fline(1) :- option_json("parameters", "/functionLine", v), match("-?[0-9]+", v).
bootstrap_invariants_fline_def(f) :- option_json("parameters", "/functionLine", v), node(_, f, "function_definition", _, _), line(f, l), v = @to_string(l).
bootstrap_invariants_raw_key(q, s) :- option_json("parameters", q, s), prefix("/rawSources/", q).
bootstrap_invariants_raw(d, s) :- bootstrap_invariants_raw_key(q, s), doc(d, p, _), t0 = @rx_replace(p, "~", "~0"), t1 = @rx_replace(t0, "/", "~1"), q = @concat("/rawSources/", t1).
bootstrap_invariants_raw_before(d, u, b) :- bootstrap_invariants_raw(d, s), bootstrap_invariants_deleted_surface(_, u, _), contains(u, s), e = @rx_replace(u, "[^0-9A-Za-z_]", "\\$0"), b = @rx_replace(s, @concat(@concat("(?s)", e), ".*"), "").
bootstrap_invariants_raw_line(d, u, l) :- bootstrap_invariants_raw_before(d, u, b), w = @rx_replace(b, "\\n", ""), l = @add(@sub(@strlen(b), @strlen(w)), 1).
bootstrap_invariants_slot(f) :- node(_, c, "call", _, _), field(c, "function", f).
bootstrap_invariants_slot(o) :- node(_, a, "attribute", _, _), field(a, "object", o).
bootstrap_invariants_slot(v) :- node(_, s, "subscript", _, _), field(s, "value", v).
bootstrap_invariants_slot(v) :- node(_, k, "keyword_argument", _, _), field(k, "value", v).
bootstrap_invariants_slot(v) :- node(_, k, "dictionary_splat", _, _), child(k, v, _).
bootstrap_invariants_slot(x) :- bootstrap_invariants_posraw(_, x, _).
bootstrap_invariants_slot(x) :- node(_, b, "boolean_operator", _, _), child(b, x, _).
bootstrap_invariants_slot(x) :- node(_, b, "binary_operator", _, _), field(b, "left", x).
bootstrap_invariants_slot(x) :- node(_, c, "comparison_operator", _, _), child(c, x, _).
bootstrap_invariants_slot(x) :- node(_, c, "conditional_expression", _, _), child(c, x, _).
bootstrap_invariants_slot(x) :- node(_, u, k, _, _), (k = "union_type" ; k = "member_type"), child(u, t, _), node(_, t, "type", _, _), child(t, x, _).
bootstrap_invariants_slot(t) :- node(_, i, "if_statement", _, _), field(i, "condition", t).
bootstrap_invariants_slot(t) :- node(_, i, "elif_clause", _, _), field(i, "condition", t).
bootstrap_invariants_slot(x) :- node(_, s, "delete_statement", _, _), child(s, x, _).
bootstrap_invariants_slot(x) :- node(_, s, "delete_statement", _, _), child(s, l, _), node(_, l, "expression_list", _, _), child(l, x, _).
bootstrap_invariants_slot(x) :- node(_, a, "assignment", _, _), field(a, "left", x).
bootstrap_invariants_slot(x) :- node(_, a, "assignment", _, _), field(a, "right", x).
bootstrap_invariants_slot(x) :- node(_, c, "class_definition", _, _), field(c, "superclasses", al), child(al, x, _), !node(_, x, "keyword_argument", _, _).
bootstrap_invariants_slot(x) :- node(_, dc, "decorator", _, _), child(dc, x, _).
bootstrap_invariants_slot(x) :- node(_, f, "function_definition", _, _), field(f, "return_type", t), child(t, x, _).
bootstrap_invariants_slot(x) :- bootstrap_invariants_slot(p), node(_, p, "parenthesized_expression", _, _), child(p, x, _).
bootstrap_invariants_ast(x, x) :- bootstrap_invariants_slot(x), !node(_, x, "parenthesized_expression", _, _), !node(_, x, "comment", _, _).
bootstrap_invariants_ast(x, e) :- bootstrap_invariants_slot(x), node(_, x, "parenthesized_expression", _, _), child(x, y, _), bootstrap_invariants_ast(y, e).
bootstrap_invariants_not_name(n) :- field(p, "name", n), !node(_, p, "named_expression", _, _).
bootstrap_invariants_not_name(n) :- field(_, "attribute", n).
bootstrap_invariants_not_name(n) :- child(ps, n, _), node(_, ps, k, _, _), bootstrap_invariants_paramk(k).
bootstrap_invariants_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, n, 0).
bootstrap_invariants_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, s, 0), child(s, n, 0), node(_, s, "list_splat_pattern", _, _).
bootstrap_invariants_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, s, 0), child(s, n, 0), node(_, s, "dictionary_splat_pattern", _, _).
bootstrap_invariants_not_name(n) :- child(ps, s, _), node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(s, n, 0), node(_, s, "list_splat_pattern", _, _).
bootstrap_invariants_not_name(n) :- child(ps, s, _), node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(s, n, 0), node(_, s, "dictionary_splat_pattern", _, _).
bootstrap_invariants_not_name(n) :- node(_, n, "identifier", _, _), inside(n, _, bootstrap_invariants_importk).
bootstrap_invariants_not_name(n) :- node(_, g, "global_statement", _, _), child(g, n, _).
bootstrap_invariants_not_name(n) :- node(_, g, "nonlocal_statement", _, _), child(g, n, _).
bootstrap_invariants_not_name(n) :- node(_, x, "except_clause", _, _), child(x, ap, _), node(_, ap, "as_pattern", _, _), field(ap, "alias", t), child(t, n, _).
bootstrap_invariants_not_name(n) :- node(_, x, "except_group_clause", _, _), child(x, ap, _), node(_, ap, "as_pattern", _, _), field(ap, "alias", t), child(t, n, _).
bootstrap_invariants_not_name(n) :- node(_, n, "identifier", _, _), child(p, n, _), node(_, p, k, _, _), bootstrap_invariants_patk(k), inside(n, _, bootstrap_invariants_casek).
bootstrap_invariants_not_name(n) :- node(_, n, "identifier", _, _), child(t, n, _), node(_, t, "as_pattern_target", _, _), inside(n, _, bootstrap_invariants_casek).
bootstrap_invariants_not_name(n) :- node(_, p, "keyword_pattern", _, _), child(p, n, 0), node(_, n, "identifier", _, _).
rr_agg1(c, dn) :- child(dn, c, _), node(_, c, "identifier", _, _).
bootstrap_invariants_pat_dotted(dn, k) :- node(_, dn, "dotted_name", _, _), inside(dn, _, bootstrap_invariants_casek), k = count : { rr_agg1(_, dn) }.
bootstrap_invariants_not_name(n) :- bootstrap_invariants_pat_dotted(dn, 1), child(dn, n, _), !field(_, "key", dn), !bootstrap_invariants_class_head(dn).
bootstrap_invariants_not_name(n) :- bootstrap_invariants_pat_dotted(dn, k), k > 1, child(dn, n, j), j > 0.
bootstrap_invariants_class_head(dn) :- node(_, cp, "class_pattern", _, _), child(cp, dn, 0).
bootstrap_invariants_tplist(l) :- node(_, o, "function_definition", _, _), field(o, "type_parameters", l).
bootstrap_invariants_tplist(l) :- node(_, o, "class_definition", _, _), field(o, "type_parameters", l).
bootstrap_invariants_tplist(l) :- node(_, a, "type_alias_statement", _, _), field(a, "left", t), child(t, g, _), node(_, g, "generic_type", _, _), child(g, l, _), node(_, l, "type_parameter", _, _).
bootstrap_invariants_tparam(p) :- bootstrap_invariants_tplist(l), child(l, p, _), !node(_, p, "type_default", _, _).
bootstrap_invariants_tparam(p) :- bootstrap_invariants_tplist(l), child(l, x, _), node(_, x, "type_default", _, _), field(x, "name", p).
bootstrap_invariants_tpinner(x) :- bootstrap_invariants_tparam(p), node(_, p, "type", _, _), child(p, x, 0).
bootstrap_invariants_tpinner(p) :- bootstrap_invariants_tparam(p), !node(_, p, "type", _, _).
bootstrap_invariants_not_name(n) :- bootstrap_invariants_tpinner(n), node(_, n, "identifier", _, _).
bootstrap_invariants_not_name(n) :- bootstrap_invariants_tpinner(s), node(_, s, "splat_type", _, _), child(s, n, _), node(_, n, "identifier", _, _).
bootstrap_invariants_not_name(n) :- bootstrap_invariants_tpinner(c), node(_, c, "constrained_type", _, _), child(c, n, 0), node(_, n, "identifier", _, _).
bootstrap_invariants_not_name(n) :- bootstrap_invariants_tpinner(c), node(_, c, "constrained_type", _, _), child(c, t, 0), node(_, t, "type", _, _), child(t, n, 0), node(_, n, "identifier", _, _).
bootstrap_invariants_name(n, s) :- node(_, n, "identifier", _, _), text(n, s), !bootstrap_invariants_not_name(n).
bootstrap_invariants_attr(n, s, o) :- node(_, n, "attribute", _, _), field(n, "attribute", a), text(a, s), field(n, "object", o0), bootstrap_invariants_ast(o0, o).
bootstrap_invariants_attr(n, s, o) :- bootstrap_invariants_pat_dotted(dn, k), k > 1, child(dn, n, j), j > 0, text(n, s), i = @sub(j, 1), child(dn, o, i).
bootstrap_invariants_named(n, s) :- bootstrap_invariants_name(n, s).
bootstrap_invariants_named(n, s) :- bootstrap_invariants_attr(n, s, _).
bootstrap_invariants_func(c, f) :- node(_, c, "call", _, _), field(c, "function", f0), bootstrap_invariants_ast(f0, f).
bootstrap_invariants_call(c, "Name", s) :- bootstrap_invariants_func(c, f), node(_, f, "identifier", _, _), text(f, s).
bootstrap_invariants_call(c, "Attribute", s) :- bootstrap_invariants_func(c, f), bootstrap_invariants_attr(f, s, _).
bootstrap_invariants_receiver(c, r) :- bootstrap_invariants_func(c, f), bootstrap_invariants_attr(f, _, r).
bootstrap_invariants_posraw(c, x, i) :- node(_, c, "call", _, _), field(c, "arguments", al), node(_, al, "argument_list", _, _), child(al, x, i), !node(_, x, "keyword_argument", _, _), !node(_, x, "dictionary_splat", _, _), !node(_, x, "comment", _, _).
bootstrap_invariants_posraw(c, g, 0) :- node(_, c, "call", _, _), field(c, "arguments", g), node(_, g, "generator_expression", _, _).
bootstrap_invariants_arg0(c, x) :- bootstrap_invariants_posraw(c, _, _), i = min j : { bootstrap_invariants_posraw(c, _, j) }, bootstrap_invariants_posraw(c, x0, i), bootstrap_invariants_ast(x0, x).
bootstrap_invariants_nargs(c, k) :- bootstrap_invariants_posraw(c, _, _), k = count : { bootstrap_invariants_posraw(c, _, _) }.
bootstrap_invariants_kw(c, k, s, v) :- node(_, c, "call", _, _), field(c, "arguments", al), child(al, k, _), node(_, k, "keyword_argument", _, _), field(k, "name", nm), text(nm, s), field(k, "value", v0), bootstrap_invariants_ast(v0, v).
bootstrap_invariants_kw(c, k, "", v) :- node(_, c, "call", _, _), field(c, "arguments", al), child(al, k, _), node(_, k, "dictionary_splat", _, _), child(k, v0, _), bootstrap_invariants_ast(v0, v).
bootstrap_invariants_haskw(c, s) :- bootstrap_invariants_kw(c, _, s, _).
bootstrap_invariants_elt(t, x) :- node(_, t, "tuple", _, _), child(t, x, _), !node(_, x, "comment", _, _).
bootstrap_invariants_tuple_len(t, k) :- node(_, t, "tuple", _, _), k = count : { bootstrap_invariants_elt(t, _) }.
bootstrap_invariants_noconst(n) :- strprefix(n, x), (contains("f", x) ; contains("t", x)).
bootstrap_invariants_cstr_part(n) :- node(_, c, "concatenated_string", _, _), child(c, n, _).
bootstrap_invariants_cstr_noconst(c) :- node(_, c, "concatenated_string", _, _), child(c, n, _), bootstrap_invariants_noconst(n).
bootstrap_invariants_str(n, s) :- node(_, n, "string", _, _), !bootstrap_invariants_cstr_part(n), !bootstrap_invariants_noconst(n), value_type_of(n, "str"), value(n, s).
bootstrap_invariants_str(c, s) :- node(_, c, "concatenated_string", _, _), !bootstrap_invariants_cstr_noconst(c), value_type_of(c, "str"), value(c, s).
bootstrap_invariants_fhost(n) :- node(_, n, "string", _, _), !bootstrap_invariants_cstr_part(n).
bootstrap_invariants_fhost(n) :- node(_, n, "concatenated_string", _, _).
bootstrap_invariants_fhost(n) :- node(_, n, "format_specifier", _, _).
bootstrap_invariants_fconst(n, s) :- bootstrap_invariants_fhost(n), fstring_piece(n, _, "literal", s).
bootstrap_invariants_zero(x) :- node(_, x, "false", _, _).
bootstrap_invariants_zero(x) :- node(_, x, "integer", _, _), value(x, "0").
bootstrap_invariants_zero(x) :- node(_, x, "float", _, _), value(x, "0.0").
bootstrap_invariants_zero(x) :- node(_, x, "integer", _, _), node_text(x, s), match("[0_]+[jJ]", s).
bootstrap_invariants_zero(x) :- node(_, x, "float", _, _), node_text(x, s), match("[0_]*\\.?[0_]*([eE][+-]?[0-9_]+)?[jJ]", s).
bootstrap_invariants_assign(a) :- node(_, st, "expression_statement", _, _), child(st, a, 0), node(_, a, "assignment", _, _), !field(a, "type", _).
bootstrap_invariants_annassign(a) :- node(_, st, "expression_statement", _, _), child(st, a, 0), node(_, a, "assignment", _, _), field(a, "type", _).
bootstrap_invariants_chain(a, a) :- bootstrap_invariants_assign(a).
bootstrap_invariants_chain(a, b) :- bootstrap_invariants_chain(a, x), field(x, "right", b), node(_, b, "assignment", _, _).
bootstrap_invariants_assign_target(a, t) :- bootstrap_invariants_chain(a, x), field(x, "left", t0), bootstrap_invariants_ast(t0, t).
bootstrap_invariants_assign_target(a, t) :- bootstrap_invariants_annassign(a), field(a, "left", t0), bootstrap_invariants_ast(t0, t).
bootstrap_invariants_assign_value(a, v) :- bootstrap_invariants_chain(a, x), field(x, "right", v0), !node(_, v0, "assignment", _, _), bootstrap_invariants_ast(v0, v).
bootstrap_invariants_del_target(s, t) :- node(_, s, "delete_statement", _, _), child(s, x, _), !node(_, x, "expression_list", _, _), bootstrap_invariants_ast(x, t).
bootstrap_invariants_del_target(s, t) :- node(_, s, "delete_statement", _, _), child(s, l, _), node(_, l, "expression_list", _, _), child(l, x, _), bootstrap_invariants_ast(x, t).
bootstrap_invariants_if(n, t, b) :- node(_, n, "if_statement", _, _), field(n, "condition", t0), bootstrap_invariants_ast(t0, t), field(n, "consequence", b).
bootstrap_invariants_if(n, t, b) :- node(_, n, "elif_clause", _, _), field(n, "condition", t0), bootstrap_invariants_ast(t0, t), field(n, "consequence", b).
bootstrap_invariants_if_span(n, s, e) :- node(_, n, "if_statement", s, e).
bootstrap_invariants_if_span(n, s, e) :- node(_, n, "elif_clause", s, _), child(i, n, _), node(_, i, "if_statement", _, e).
bootstrap_invariants_is_or(x) :- node(_, x, "boolean_operator", _, _), op(x, "or").
bootstrap_invariants_or_inner(x) :- bootstrap_invariants_is_or(x), child(p, x, _), bootstrap_invariants_is_or(p).
bootstrap_invariants_or_part(t, x) :- bootstrap_invariants_is_or(t), !bootstrap_invariants_or_inner(t), child(t, x, _).
bootstrap_invariants_or_part(t, y) :- bootstrap_invariants_or_part(t, x), bootstrap_invariants_is_or(x), child(x, y, _).
bootstrap_invariants_or_value(t, v) :- bootstrap_invariants_or_part(t, x), !bootstrap_invariants_is_or(x), bootstrap_invariants_ast(x, v).
bootstrap_invariants_def(d, f, x) :- node(d, f, "function_definition", _, _), field(f, "name", nm), text(nm, x).
bootstrap_invariants_class(d, c, x) :- node(d, c, "class_definition", _, _), field(c, "name", nm), text(nm, x).
bootstrap_invariants_base_named(c, s) :- node(_, c, "class_definition", _, _), field(c, "superclasses", al), child(al, b0, _), !node(_, b0, "keyword_argument", _, _), bootstrap_invariants_ast(b0, b), bootstrap_invariants_named(b, s).
bootstrap_invariants_deco(f, e) :- node(_, dd, "decorated_definition", _, _), field(dd, "definition", f), child(dd, dc, _), node(_, dc, "decorator", _, _), child(dc, e0, _), bootstrap_invariants_ast(e0, e).
bootstrap_invariants_deco(f, g) :- bootstrap_invariants_deco(f, c), bootstrap_invariants_func(c, g).
bootstrap_invariants_pure_lazy(f) :- bootstrap_invariants_deco(f, e), bootstrap_invariants_named(e, "pure_lazy").
bootstrap_invariants_prec(x, 18) :- node(_, x, k, _, _), (k = "subscript" ; k = "attribute" ; k = "call" ; k = "generic_type" ; k = "member_type").
bootstrap_invariants_prec(x, 9) :- node(_, x, "union_type", _, _).
bootstrap_invariants_prec(x, p) :- node(_, x, "binary_operator", _, _), op(x, o), bootstrap_invariants_binprec(o, p).
bootstrap_invariants_prec(x, 7) :- node(_, x, "comparison_operator", _, _).
bootstrap_invariants_prec(x, 5) :- node(_, x, "boolean_operator", _, _), op(x, "and").
bootstrap_invariants_prec(x, 4) :- node(_, x, "boolean_operator", _, _), op(x, "or").
bootstrap_invariants_prec(x, 3) :- node(_, x, "conditional_expression", _, _).
bootstrap_invariants_leftreq(o, p) :- bootstrap_invariants_binprec(o, p), o != "**".
bootstrap_invariants_bool_chain(x, l) :- node(_, x, "boolean_operator", _, _), op(x, o), field(x, "left", l), node(_, l, "boolean_operator", _, _), op(l, o).
bootstrap_invariants_type_inner(t, x) :- node(_, t, "type", _, _), child(t, x0, _), bootstrap_invariants_ast(x0, x).
bootstrap_invariants_lr(x) :- node(_, x, "subscript", _, _), field(x, "value", v0), bootstrap_invariants_ast(v0, v), node(_, v, "identifier", _, _), text(v, "LazyResult").
bootstrap_invariants_lr(x) :- node(_, x, "generic_type", _, _), child(x, v, 0), node(_, v, "identifier", _, _), text(v, "LazyResult"), child(x, p, 1), node(_, p, "type_parameter", _, _).
bootstrap_invariants_lr(x) :- node(_, x, "subscript", _, _), field(x, "value", v0), bootstrap_invariants_ast(v0, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, 18).
bootstrap_invariants_lr(x) :- node(_, x, "attribute", _, _), field(x, "object", v0), bootstrap_invariants_ast(v0, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, 18).
bootstrap_invariants_lr(x) :- bootstrap_invariants_func(x, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, 18).
bootstrap_invariants_lr(x) :- node(_, x, "member_type", _, _), child(x, t, 0), bootstrap_invariants_type_inner(t, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, 18).
bootstrap_invariants_lr(x) :- node(_, x, "binary_operator", _, _), op(x, o), bootstrap_invariants_leftreq(o, r), field(x, "left", v0), bootstrap_invariants_ast(v0, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, p), p >= r.
bootstrap_invariants_lr(x) :- node(_, x, "union_type", _, _), child(x, t, 0), bootstrap_invariants_type_inner(t, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, p), p >= 9.
bootstrap_invariants_lr(x) :- node(_, x, "comparison_operator", _, _), child(x, v0, 0), bootstrap_invariants_ast(v0, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, p), p >= 8.
bootstrap_invariants_lr(x) :- node(_, x, "conditional_expression", _, _), child(x, v0, 0), bootstrap_invariants_ast(v0, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, p), p >= 4.
bootstrap_invariants_lr(x) :- bootstrap_invariants_bool_chain(x, l), bootstrap_invariants_lr(l).
bootstrap_invariants_lr(x) :- node(_, x, "boolean_operator", _, _), !bootstrap_invariants_bool_chain(x, _), op(x, o), bootstrap_invariants_boolreq(o, r), field(x, "left", v0), bootstrap_invariants_ast(v0, v), bootstrap_invariants_lr(v), bootstrap_invariants_prec(v, p), p >= r.
bootstrap_invariants_lazy_return(f) :- node(_, f, "function_definition", _, _), field(f, "return_type", t), bootstrap_invariants_type_inner(t, x), bootstrap_invariants_lr(x).
bootstrap_invariants_pitem(ps, i, p, "plain") :- node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(ps, p, i), node(_, p, "identifier", _, _).
bootstrap_invariants_pitem(ps, i, nm, "plain") :- node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(ps, p, i), node(_, p, "typed_parameter", _, _), child(p, nm, 0), node(_, nm, "identifier", _, _).
bootstrap_invariants_pitem(ps, i, nm, "star") :- node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(ps, p, i), node(_, p, "typed_parameter", _, _), child(p, s, 0), node(_, s, "list_splat_pattern", _, _), child(s, nm, 0).
bootstrap_invariants_pitem(ps, i, nm, "dstar") :- node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(ps, p, i), node(_, p, "typed_parameter", _, _), child(p, s, 0), node(_, s, "dictionary_splat_pattern", _, _), child(s, nm, 0).
bootstrap_invariants_pitem(ps, i, nm, "plain") :- node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(ps, p, i), node(_, p, "default_parameter", _, _), field(p, "name", nm).
bootstrap_invariants_pitem(ps, i, nm, "plain") :- node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(ps, p, i), node(_, p, "typed_default_parameter", _, _), field(p, "name", nm).
bootstrap_invariants_pitem(ps, i, nm, "star") :- node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(ps, p, i), node(_, p, "list_splat_pattern", _, _), child(p, nm, 0).
bootstrap_invariants_pitem(ps, i, nm, "dstar") :- node(_, ps, k, _, _), bootstrap_invariants_paramk(k), child(ps, p, i), node(_, p, "dictionary_splat_pattern", _, _), child(p, nm, 0).
bootstrap_invariants_slash_after(ps, i) :- bootstrap_invariants_pitem(ps, i, _, "plain"), child(ps, c, j), node(_, c, "positional_separator", _, _), i < j.
bootstrap_invariants_star_before(ps, i) :- bootstrap_invariants_pitem(ps, i, _, "plain"), child(ps, c, j), node(_, c, "keyword_separator", _, _), j < i.
bootstrap_invariants_star_before(ps, i) :- bootstrap_invariants_pitem(ps, i, _, "plain"), bootstrap_invariants_pitem(ps, j, _, "star"), j < i.
bootstrap_invariants_param(o, nm, "vararg", x) :- field(o, "parameters", ps), bootstrap_invariants_pitem(ps, _, nm, "star"), text(nm, x).
bootstrap_invariants_param(o, nm, "kwarg", x) :- field(o, "parameters", ps), bootstrap_invariants_pitem(ps, _, nm, "dstar"), text(nm, x).
bootstrap_invariants_param(o, nm, "posonlyargs", x) :- field(o, "parameters", ps), bootstrap_invariants_pitem(ps, i, nm, "plain"), bootstrap_invariants_slash_after(ps, i), text(nm, x).
bootstrap_invariants_param(o, nm, "kwonlyargs", x) :- field(o, "parameters", ps), bootstrap_invariants_pitem(ps, i, nm, "plain"), bootstrap_invariants_star_before(ps, i), text(nm, x).
bootstrap_invariants_param(o, nm, "args", x) :- field(o, "parameters", ps), bootstrap_invariants_pitem(ps, i, nm, "plain"), !bootstrap_invariants_slash_after(ps, i), !bootstrap_invariants_star_before(ps, i), text(nm, x).
bootstrap_invariants_in(o, n) :- bootstrap_invariants_want(o), inside(n, o, bootstrap_invariants_fdefk).
bootstrap_invariants_in(o, n) :- bootstrap_invariants_want(o), inside(n, o, bootstrap_invariants_classk).
bootstrap_invariants_in(o, n) :- bootstrap_invariants_want(o), node(_, dd, "decorated_definition", _, _), field(dd, "definition", o), child(dd, dc, _), node(_, dc, "decorator", _, _), inside(n, dc, bootstrap_invariants_decok).
bootstrap_invariants_fn(n, f) :- bootstrap_invariants_fn_need(n), nearest(n, f, bootstrap_invariants_framek), node(_, f, "function_definition", _, _).
bootstrap_invariants_fn(n, f) :- bootstrap_invariants_fn_need(n), nearest(n, dc, bootstrap_invariants_framek), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", f), node(_, f, "function_definition", _, _).
bootstrap_invariants_fn_need(c) :- bootstrap_invariants_fn_need(n), nearest(n, dc, bootstrap_invariants_framek), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", c), node(_, c, "class_definition", _, _).
bootstrap_invariants_fn(n, f) :- bootstrap_invariants_fn_need(n), nearest(n, dc, bootstrap_invariants_framek), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", c), node(_, c, "class_definition", _, _), bootstrap_invariants_fn(c, f).
bootstrap_invariants_depth_stmt(n, x) :- bootstrap_invariants_depth_need(n), inside(n, x, bootstrap_invariants_stmtk).
bootstrap_invariants_depth_elif(n, e, e2) :- bootstrap_invariants_depth_need(n), inside(n, e, bootstrap_invariants_elifk), child(p, e, i), child(p, e2, j), node(_, e2, "elif_clause", _, _), j < i.
bootstrap_invariants_depth_else(n, x, e2) :- bootstrap_invariants_depth_need(n), inside(n, x, bootstrap_invariants_elsek), child(p, x, _), node(_, p, "if_statement", _, _), child(p, e2, _), node(_, e2, "elif_clause", _, _).
bootstrap_invariants_depth_a(n, k) :- bootstrap_invariants_depth_need(n), k = count : { bootstrap_invariants_depth_stmt(n, _) }.
bootstrap_invariants_depth_b(n, k) :- bootstrap_invariants_depth_need(n), k = count : { bootstrap_invariants_depth_elif(n, _, _) }.
bootstrap_invariants_depth_c(n, k) :- bootstrap_invariants_depth_need(n), k = count : { bootstrap_invariants_depth_else(n, _, _) }.
bootstrap_invariants_depth(n, k) :- bootstrap_invariants_depth_a(n, a), bootstrap_invariants_depth_b(n, b), bootstrap_invariants_depth_c(n, c), k = @add(@add(a, b), c).
bootstrap_invariants_base(d, b) :- doc(d, p, _), b = @rx_replace(p, "^.*/", "").
bootstrap_invariants_base_bootstrap(d) :- bootstrap_invariants_base(d, b), contains("bootstrap", b).
bootstrap_invariants_engine(d) :- bootstrap_invariants_engine_path(d).
bootstrap_invariants_engine(d) :- bootstrap_invariants_bootstrap_path(d).
bootstrap_invariants_gate(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), bootstrap_invariants_entry(e), e != "_collect_primitive_install_coverage_violations".
bootstrap_invariants_valid(d, p) :- bootstrap_invariants_gate(d, p), !cpython_syntax_error(d, _, _).
bootstrap_invariants_source(d, s) :- bootstrap_invariants_valid(d, _), bootstrap_invariants_raw(d, s).
bootstrap_invariants_source(d, s) :- bootstrap_invariants_valid(d, _), !bootstrap_invariants_raw(d, _), node(d, m, "module", _, _), node_text(m, s).
bootstrap_invariants_scope(d, p) :- bootstrap_invariants_valid(d, p), bootstrap_invariants_entry("_collect_fake_executor_violations").
bootstrap_invariants_scope(d, p) :- bootstrap_invariants_valid(d, p), bootstrap_invariants_bootstrap_path(d).
bootstrap_invariants_scope(d, p) :- bootstrap_invariants_valid(d, p), match("(.*/)?(schema_transaction|sql_connection|bootstrap_interrogation)\\.py", p).
bootstrap_invariants_scope(d, p) :- bootstrap_invariants_valid(d, p), bootstrap_invariants_base_bootstrap(d).
bootstrap_invariants_scope(d, p) :- bootstrap_invariants_valid(d, p), bootstrap_invariants_source(d, s), (contains("Bootstrap", s) ; contains("bootstrap", s) ; contains("schema_transaction", s) ; contains("materialized_pipeline", s) ; contains("physical_table", s) ; contains("reconciliation", s)).
bootstrap_invariants_fnode(d, f, x) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_def(d, f, x), bootstrap_invariants_entry(e), e != "_collect_fake_executor_violations".
bootstrap_invariants_fnode(d, f, x) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_def(d, f, x), bootstrap_invariants_entry("_collect_fake_executor_violations"), !bootstrap_invariants_has_fline(1).
bootstrap_invariants_fnode(d, f, x) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_def(d, f, x), bootstrap_invariants_entry("_collect_fake_executor_violations"), bootstrap_invariants_fline_def(f).
bootstrap_invariants_checked(d, f) :- bootstrap_invariants_fnode(d, f, _), bootstrap_invariants_engine(d).
bootstrap_invariants_checked(d, f) :- bootstrap_invariants_fnode(d, f, x), bootstrap_invariants_base(d, "schema_transaction.py"), (x = "bootstrap_interrogation_lazy" ; x = "bootstrap_interrogation_request_no_io" ; x = "bootstrap_schema_tail_lazy").
bootstrap_invariants_checked(d, f) :- bootstrap_invariants_fnode(d, f, _), bootstrap_invariants_entry("_collect_fake_executor_violations").
bootstrap_invariants_ensure_fn(d, f, x) :- bootstrap_invariants_fnode(d, f, x), bootstrap_invariants_base(d, "schema_transaction.py"), prefix("ensure_bootstrap_", x), suffix("_lazy", x).
bootstrap_invariants_enode_named(d, n, s) :- bootstrap_invariants_scope(d, _), node(d, n, _, _, _), bootstrap_invariants_named(n, s).
bootstrap_invariants_ecall(d, n, kind, s) :- bootstrap_invariants_scope(d, _), node(d, n, "call", _, _), bootstrap_invariants_call(n, kind, s).
bootstrap_invariants_region_name(x) :- bootstrap_invariants_ensure5(x).
bootstrap_invariants_region_name(x) :- bootstrap_invariants_lowerer4(x).
bootstrap_invariants_want(f) :- bootstrap_invariants_fnode(_, f, x), bootstrap_invariants_region_name(x).
bootstrap_invariants_want(f) :- bootstrap_invariants_fnode(_, f, x), prefix("ensure_bootstrap_", x).
bootstrap_invariants_want(f) :- bootstrap_invariants_checked(_, f), bootstrap_invariants_pure_lazy(f).
bootstrap_invariants_want(c) :- bootstrap_invariants_lifecycle_class(_, c).
bootstrap_invariants_want(f) :- primitive_install_fn(_, f, _, _, _).
bootstrap_invariants_surface_hit(d, s, l) :- bootstrap_invariants_scope(d, _), !bootstrap_invariants_raw(d, _), bootstrap_invariants_deleted_surface(_, s, _), src_line_lf(d, l, sp), text(sp, u), contains(s, u).
bootstrap_invariants_surface_hit(d, s, l) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_raw_line(d, s, l).
bootstrap_invariants_surface_in(d, s, i) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_source(d, t), bootstrap_invariants_deleted_surface(fam, s, i), fam < 2, contains(s, t).
bootstrap_invariants_surface_in(d, s, i) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_base(d, "schema_transaction.py"), bootstrap_invariants_source(d, t), bootstrap_invariants_deleted_surface(2, s, i), contains(s, t).
bootstrap_invariants_row(d, i, l) :- bootstrap_invariants_surface_in(d, s, i), bootstrap_invariants_surface_hit(d, s, _), l = min k : { bootstrap_invariants_surface_hit(d, s, k) }.
bootstrap_invariants_lazy_fn(d, f) :- bootstrap_invariants_checked(d, f), bootstrap_invariants_pure_lazy(f).
bootstrap_invariants_row(d, "BEI005", l) :- bootstrap_invariants_lazy_fn(d, f), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_exec_surface(s), line(n, l).
bootstrap_invariants_row(d, "BEI023", l) :- bootstrap_invariants_lazy_fn(d, f), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_boundary_surface(s), line(n, l).
bootstrap_invariants_work(w) :- bootstrap_invariants_call(w, _, s), bootstrap_invariants_exec_surface(s).
bootstrap_invariants_work(w) :- bootstrap_invariants_call(w, _, s), suffix("_direct", s).
bootstrap_invariants_work(w) :- bootstrap_invariants_call(w, _, s), prefix("build_", s).
bootstrap_invariants_row(d, "BEI006", l) :- bootstrap_invariants_lazy_fn(d, f), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, "Attribute", "of"), bootstrap_invariants_receiver(n, r), bootstrap_invariants_name(r, "LazyResult"), bootstrap_invariants_arg0(n, w), bootstrap_invariants_work(w), line(n, l).
bootstrap_invariants_row(d, "BEI007", l) :- bootstrap_invariants_checked(d, f), bootstrap_invariants_def(d, f, "execute_application_plan"), bootstrap_invariants_in(f, n), bootstrap_invariants_del_target(n, t), bootstrap_invariants_name(t, "conn"), line(n, l).
bootstrap_invariants_facts_call(f, n, v) :- bootstrap_invariants_checked(d, f), bootstrap_invariants_def(d, f, "execute_application_plan"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "BootstrapExecutionFacts"), bootstrap_invariants_kw(n, _, "mutation_counts", v), bootstrap_invariants_call(v, _, "BootstrapMutationCounts").
bootstrap_invariants_zero_kw(v, k) :- bootstrap_invariants_facts_call(_, _, v), bootstrap_invariants_kw(v, k, _, x), bootstrap_invariants_zero(x).
bootstrap_invariants_zero_kws(v, k) :- bootstrap_invariants_facts_call(_, _, v), k = count : { bootstrap_invariants_zero_kw(v, _) }.
bootstrap_invariants_zero_branch(f, s, e) :- bootstrap_invariants_facts_call(f, _, _), bootstrap_invariants_in(f, b), bootstrap_invariants_if(b, t, _), node(_, t, "comparison_operator", _, _), child(t, o0, _), bootstrap_invariants_ast(o0, o), bootstrap_invariants_attr(o, "ZERO_APPLICATION_TERMINALS", _), bootstrap_invariants_if_span(b, s, e).
bootstrap_invariants_zero_guarded(n) :- bootstrap_invariants_facts_call(f, n, _), bootstrap_invariants_zero_branch(f, s, e), node(_, n, _, ns, ne), ns >= s, ne <= e.
bootstrap_invariants_row(d, "BEI007", l) :- bootstrap_invariants_facts_call(f, n, v), node(d, n, _, _, _), !bootstrap_invariants_zero_guarded(n), bootstrap_invariants_zero_kws(v, k), k >= 4, line(n, l).
bootstrap_invariants_coord_fn(d, f, x) :- bootstrap_invariants_fnode(d, f, x), bootstrap_invariants_base(d, "bootstrap_coordinator.py").
bootstrap_invariants_coord_checked(d, f, x) :- bootstrap_invariants_coord_fn(d, f, x), bootstrap_invariants_checked(d, f).
bootstrap_invariants_row(d, "BEI016", l) :- bootstrap_invariants_coord_checked(d, f, "_enqueue_application_schema_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "publish_bootstrap_metadata_lazy"), bootstrap_invariants_kw(n, _, "dependency_refs", v), bootstrap_invariants_tuple_len(v, 0), line(n, l).
bootstrap_invariants_tail_line(f, l) :- bootstrap_invariants_coord_checked(_, f, "_enqueue_application_schema_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "bootstrap_schema_tail_lazy"), line(n, l).
bootstrap_invariants_pub_line(f, l) :- bootstrap_invariants_coord_checked(_, f, "_enqueue_application_schema_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "publish_bootstrap_metadata_lazy"), line(n, l).
bootstrap_invariants_tail_last(f, m) :- bootstrap_invariants_tail_line(f, _), m = max l : { bootstrap_invariants_tail_line(f, l) }.
bootstrap_invariants_pub_before(f) :- bootstrap_invariants_tail_last(f, m), bootstrap_invariants_pub_line(f, l), l <= m.
bootstrap_invariants_pub_after(f) :- bootstrap_invariants_tail_last(f, m), bootstrap_invariants_pub_line(f, l), l > m.
bootstrap_invariants_row(d, "BEI012", m) :- bootstrap_invariants_tail_last(f, m), node(d, f, _, _, _), !bootstrap_invariants_pub_before(f).
bootstrap_invariants_row(d, "BEI012", m) :- bootstrap_invariants_tail_last(f, m), node(d, f, _, _, _), bootstrap_invariants_pub_after(f).
bootstrap_invariants_lock_if(d, n, t, b) :- bootstrap_invariants_coord_checked(d, f, "apply_lifecycle_effects"), bootstrap_invariants_in(f, n), bootstrap_invariants_if(n, t, b).
bootstrap_invariants_lock_test(t) :- bootstrap_invariants_lock_if(d, _, t, _), node(d, t, _, s, e), node(d, a, "attribute", as, ae), as >= s, ae <= e, bootstrap_invariants_attr(a, "APPLY_DDL_LOCKDOWN", v), bootstrap_invariants_name(v, "BootstrapLifecycleEffectKind").
bootstrap_invariants_lock_continue(b) :- bootstrap_invariants_lock_if(_, _, _, b), child(b, s, _), node(_, s, "continue_statement", _, _).
bootstrap_invariants_lock_applied(b) :- bootstrap_invariants_lock_if(d, _, _, b), node(d, b, _, s, e), node(d, c, "call", cs, ce), cs >= s, ce <= e, bootstrap_invariants_call(c, _, "apply_bootstrap_ddl_lockdown_effect").
bootstrap_invariants_row(d, "BEI015", l) :- bootstrap_invariants_lock_if(d, n, t, b), bootstrap_invariants_lock_test(t), bootstrap_invariants_lock_continue(b), !bootstrap_invariants_lock_applied(b), line(n, l).
bootstrap_invariants_row(d, "BEI019", l) :- bootstrap_invariants_coord_checked(d, f, "plan_application"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "lower_bootstrap_lifecycle_effects"), line(n, l).
bootstrap_invariants_row(d, "BEI019", l) :- bootstrap_invariants_coord_checked(d, f, "_enqueue_application_schema_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "bootstrap_schema_tail_lazy"), bootstrap_invariants_haskw(n, "lifecycle_effects"), line(n, l).
bootstrap_invariants_st_fn(d, f, x) :- bootstrap_invariants_fnode(d, f, x), bootstrap_invariants_base(d, "schema_transaction.py").
bootstrap_invariants_has_produced_ref(f) :- bootstrap_invariants_param(f, _, fld, "produced_ref"), (fld = "args" ; fld = "kwonlyargs").
bootstrap_invariants_row(d, "BEI024", l) :- bootstrap_invariants_st_fn(d, f, "bootstrap_schema_tail_lazy"), bootstrap_invariants_checked(d, f), !bootstrap_invariants_has_produced_ref(f), line(f, l).
bootstrap_invariants_row(d, "BEI024", l) :- bootstrap_invariants_st_fn(d, f, "bootstrap_schema_tail_lazy"), bootstrap_invariants_checked(d, f), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_tail_flush(s), line(n, l).
bootstrap_invariants_row(d, "BEI025", l) :- bootstrap_invariants_coord_checked(d, f, "_materialize_application_lazy_results"), bootstrap_invariants_in(f, n), bootstrap_invariants_assign(n), bootstrap_invariants_assign_target(n, t), bootstrap_invariants_name(t, "schema_dependency_refs"), bootstrap_invariants_assign_value(n, v), bootstrap_invariants_tuple_len(v, 0), line(n, l).
bootstrap_invariants_row(d, "BEI025", l) :- bootstrap_invariants_coord_checked(d, f, "_materialize_application_lazy_results"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "bootstrap_schema_tail_lazy"), !bootstrap_invariants_haskw(n, "produced_ref"), line(n, l).
bootstrap_invariants_row(d, "BEI026", l) :- bootstrap_invariants_coord_checked(d, f, "_materialize_application_lazy_results"), bootstrap_invariants_in(f, n), bootstrap_invariants_attr(n, _, v), bootstrap_invariants_name(v, "BootstrapDataPrimitiveKind"), line(n, l).
bootstrap_invariants_replay_mention(f, x) :- bootstrap_invariants_coord_checked(_, f, "_transition_replay_plan_for_observation"), bootstrap_invariants_in(f, n), bootstrap_invariants_named(n, x), bootstrap_invariants_replay_ids(x).
bootstrap_invariants_row(d, "BEI027", l) :- bootstrap_invariants_coord_checked(d, f, "_transition_replay_plan_for_observation"), bootstrap_invariants_replay_ids(x), !bootstrap_invariants_replay_mention(f, x), line(f, l).
bootstrap_invariants_row(d, "BEI029", l) :- bootstrap_invariants_coord_checked(d, f, "_enqueue_application_schema_lazy"), !bootstrap_invariants_pure_lazy(f), line(f, l).
bootstrap_invariants_row(d, "BEI029", l) :- bootstrap_invariants_coord_checked(d, f, "_enqueue_application_schema_lazy"), !bootstrap_invariants_lazy_return(f), line(f, l).
bootstrap_invariants_row(d, "BEI033", l) :- bootstrap_invariants_coord_checked(d, f, x), bootstrap_invariants_run_apis(x), !bootstrap_invariants_pure_lazy(f), line(f, l).
bootstrap_invariants_row(d, "BEI033", l) :- bootstrap_invariants_coord_checked(d, f, x), bootstrap_invariants_run_apis(x), !bootstrap_invariants_lazy_return(f), line(f, l).
bootstrap_invariants_run_fn(d, f) :- bootstrap_invariants_coord_checked(d, f, x), (x = "run" ; x = "run_async").
bootstrap_invariants_run_calls(f, x) :- bootstrap_invariants_run_fn(_, f), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, x), bootstrap_invariants_run_apis(x).
bootstrap_invariants_row(d, "BEI034", l) :- bootstrap_invariants_run_fn(d, f), bootstrap_invariants_run_apis(x), !bootstrap_invariants_run_calls(f, x), line(f, l).
bootstrap_invariants_row(d, "BEI034", l) :- bootstrap_invariants_run_fn(d, f), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_run_eager(s), line(n, l).
bootstrap_invariants_row(d, "BEI014", l) :- bootstrap_invariants_coord_fn(d, f, "_enqueue_application_schema_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_legacy5(s), line(n, l).
bootstrap_invariants_row(d, "BEI014", l) :- bootstrap_invariants_st_fn(d, f, x), bootstrap_invariants_ensure5(x), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_legacy5(s), line(n, l).
bootstrap_invariants_row(d, "BEI036", l) :- bootstrap_invariants_st_fn(d, f, "_unsupported_bootstrap_schema_surface_lazy"), line(f, l).
bootstrap_invariants_row(d, "BEI036", l) :- bootstrap_invariants_ensure_fn(d, f, _), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "_unsupported_bootstrap_schema_surface_lazy"), line(n, l).
bootstrap_invariants_row(d, "BEI036", l) :- bootstrap_invariants_ensure_fn(d, f, _), bootstrap_invariants_in(f, n), bootstrap_invariants_str(n, s), bootstrap_invariants_placeholder(w), contains(w, s), line(n, l).
bootstrap_invariants_row(d, "BEI036", l) :- bootstrap_invariants_ensure_fn(d, f, _), bootstrap_invariants_in(f, n), bootstrap_invariants_fconst(n, s), bootstrap_invariants_placeholder(w), contains(w, s), line(n, l).
bootstrap_invariants_st_surface(d, f) :- bootstrap_invariants_ensure_fn(d, f, _).
bootstrap_invariants_st_surface(d, f) :- bootstrap_invariants_st_fn(d, f, x), bootstrap_invariants_st_lazy4(x).
bootstrap_invariants_row(d, "BEI039", l) :- bootstrap_invariants_st_surface(d, f), !bootstrap_invariants_pure_lazy(f), line(f, l).
bootstrap_invariants_row(d, "BEI039", l) :- bootstrap_invariants_st_surface(d, f), !bootstrap_invariants_lazy_return(f), line(f, l).
bootstrap_invariants_kwonly(f, x) :- bootstrap_invariants_ensure_fn(_, f, _), bootstrap_invariants_param(f, _, "kwonlyargs", x).
bootstrap_invariants_row(d, "BEI039", l) :- bootstrap_invariants_ensure_fn(d, f, _), !bootstrap_invariants_kwonly(f, "produced_ref"), line(f, l).
bootstrap_invariants_row(d, "BEI039", l) :- bootstrap_invariants_ensure_fn(d, f, _), !bootstrap_invariants_kwonly(f, "dependency_refs"), line(f, l).
bootstrap_invariants_row(d, "BEI040", l) :- bootstrap_invariants_ensure_fn(d, f, _), bootstrap_invariants_in(f, n), bootstrap_invariants_del_target(n, t), bootstrap_invariants_name(t, x), (x = "produced_ref" ; x = "dependency_refs"), line(n, l).
bootstrap_invariants_row(d, "BEI043", l) :- bootstrap_invariants_coord_fn(d, f, "build_execution_plan_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), (s = "_materialize_application_lazy_results" ; s = "_install_application_lazy_results"), line(n, l).
bootstrap_invariants_row(d, "BEI043", l) :- bootstrap_invariants_coord_fn(d, f, "_enqueue_application_schema_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_attr(n, x, _), (x = "lazy_results" ; x = "application_tail_result"), line(n, l).
bootstrap_invariants_calls_tail(f) :- bootstrap_invariants_coord_fn(_, f, "_enqueue_application_schema_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "bootstrap_schema_tail_lazy").
bootstrap_invariants_row(d, "BEI043", l) :- bootstrap_invariants_coord_fn(d, f, "_enqueue_application_schema_lazy"), !bootstrap_invariants_calls_tail(f), line(f, l).
bootstrap_invariants_row(d, "BEI043", l) :- bootstrap_invariants_coord_fn(d, f, x), (x = "_materialize_application_lazy_results" ; x = "_install_application_lazy_results"), line(f, l).
bootstrap_invariants_row(d, "BEI044", l) :- bootstrap_invariants_st_fn(d, f, x), prefix("ensure_bootstrap_", x), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_step6(s), s != x, line(n, l).
bootstrap_invariants_row(d, "BEI044", l) :- bootstrap_invariants_st_fn(d, f, x), bootstrap_invariants_lowerer4(x), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_step6(s), s != x, line(n, l).
bootstrap_invariants_row(d, "BEI037", l) :- bootstrap_invariants_coord_fn(d, f, x), (x = "_materialize_application_lazy_results" ; x = "_install_application_lazy_results"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_installer12(s), line(n, l).
bootstrap_invariants_row(d, "BEI011", l) :- bootstrap_invariants_coord_fn(d, f, "execute_interrogation_plan"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_helper_refs(s), line(n, l).
bootstrap_invariants_row(d, "BEI011", l) :- bootstrap_invariants_st_fn(d, f, "bootstrap_interrogation_lazy"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_helper_refs(s), line(n, l).
bootstrap_invariants_row(d, "BEI013", l) :- bootstrap_invariants_fnode(d, f, "execute_runtime_rows"), bootstrap_invariants_base(d, "bootstrap_interrogation.py"), bootstrap_invariants_in(f, n), bootstrap_invariants_attr(n, x, v), (x = "TABLE" ; x = "COLUMN" ; x = "INDEX"), bootstrap_invariants_name(v, "BootstrapInterrogationRowKind"), line(n, l).
bootstrap_invariants_row(d, "BEI045", l) :- bootstrap_invariants_fnode(d, f, "ensure_versioning_domain_schema"), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, "ensure_tables"), line(n, l).
bootstrap_invariants_row(d, "BEI046", l) :- bootstrap_invariants_ensure_fn(d, f, _), bootstrap_invariants_in(f, n), bootstrap_invariants_call(n, _, s), bootstrap_invariants_nonbatch7(s), line(n, l).
bootstrap_invariants_test_path(d) :- path_part(d, "tests").
bootstrap_invariants_test_path(d) :- path_part(d, "data_layer_testing").
bootstrap_invariants_fname_lazy(f) :- bootstrap_invariants_fnode(_, f, x), suffix("_lazy", x).
bootstrap_invariants_fname_async(f) :- bootstrap_invariants_fnode(_, f, x), suffix("_async", x).
bootstrap_invariants_fname_sync(f) :- bootstrap_invariants_fnode(_, f, x), suffix("_sync", x).
bootstrap_invariants_variant(f) :- bootstrap_invariants_fnode(_, f, _), op(f, "async").
bootstrap_invariants_variant(f) :- bootstrap_invariants_fname_async(f).
bootstrap_invariants_variant(f) :- bootstrap_invariants_fnode(d, f, x), bootstrap_invariants_fname_sync(f), !bootstrap_invariants_fname_async(f), bootstrap_invariants_def(d, _, y), y = @concat(@substr(x, 0, @sub(@strlen(x), 5)), "_lazy").
bootstrap_invariants_variant(f) :- bootstrap_invariants_fnode(d, f, x), !bootstrap_invariants_fname_sync(f), !bootstrap_invariants_fname_async(f), bootstrap_invariants_def(d, _, y), y = @concat(x, "_lazy").
bootstrap_invariants_bootstrap_file(d) :- bootstrap_invariants_bootstrap_path(d).
bootstrap_invariants_bootstrap_file(d) :- bootstrap_invariants_base_bootstrap(d).
