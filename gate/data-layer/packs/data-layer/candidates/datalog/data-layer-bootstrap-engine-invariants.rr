bootstrap_invariants_defnode(d, n, x) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_def(d, n, x).
bootstrap_invariants_defnode(d, n, x) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_class(d, n, x).
bootstrap_invariants_row(d, "BEI001", l) :- bootstrap_invariants_defnode(d, n, x), bootstrap_invariants_old_symbol(x), line(n, l).
bootstrap_invariants_row(d, "BEI002", l) :- bootstrap_invariants_defnode(d, n, x), bootstrap_invariants_direct_surface(x), line(n, l).
bootstrap_invariants_row(d, "BEI047", l) :- bootstrap_invariants_defnode(d, n, x), (x = "_install_schema_primitive_contract" ; x = "ensure_schema_callback"), line(n, l).
bootstrap_invariants_row(d, "BEI017", l) :- bootstrap_invariants_fnode(d, f, "publish_bootstrap_metadata_lazy"), !op(f, "async"), bootstrap_invariants_param(f, nm, "args", x), (x = "bootstrap_plan" ; x = "model_classes"), line(nm, l).
bootstrap_invariants_lifecycle_class(d, c) :- bootstrap_invariants_scope(d, _), node(d, c, "class_definition", _, _), bootstrap_invariants_base_named(c, "PipelineLifecycleEffect").
bootstrap_invariants_row(d, "BEI032", l) :- bootstrap_invariants_lifecycle_class(d, c), bootstrap_invariants_in(c, nm), bootstrap_invariants_param(_, nm, _, x), bootstrap_invariants_conn_name(x), line(nm, l).
bootstrap_invariants_row(d, "BEI032", l) :- bootstrap_invariants_lifecycle_class(d, c), bootstrap_invariants_in(c, n), bootstrap_invariants_name(n, x), bootstrap_invariants_conn_name(x), line(n, l).
bootstrap_invariants_row(d, "BEI032", l) :- bootstrap_invariants_lifecycle_class(d, c), bootstrap_invariants_in(c, n), bootstrap_invariants_attr(n, x, _), (x = "_conn" ; x = "conn" ; x = "connection" ; x = "sql_conn"), line(n, l).
bootstrap_invariants_row(d, "BEI032", l) :- bootstrap_invariants_lifecycle_class(d, c), bootstrap_invariants_in(c, n), bootstrap_invariants_call(n, _, x), (x = "__setattr__" ; x = "getattr" ; x = "hasattr"), line(n, l).
bootstrap_invariants_row(d, "BEI002", l) :- bootstrap_invariants_enode_named(d, n, x), bootstrap_invariants_direct_surface(x), line(n, l).
bootstrap_invariants_row(d, "BEI047", l) :- bootstrap_invariants_enode_named(d, n, x), (x = "_install_schema_primitive_contract" ; x = "ensure_schema_callback"), line(n, l).
bootstrap_invariants_resolve_call(d, n) :- bootstrap_invariants_ecall(d, n, "Attribute", "resolve"), bootstrap_invariants_engine(d).
bootstrap_invariants_fn_need(n) :- bootstrap_invariants_resolve_call(_, n).
bootstrap_invariants_in_run(n) :- bootstrap_invariants_fn(n, f), bootstrap_invariants_def(_, f, x), (x = "run" ; x = "run_async").
bootstrap_invariants_row(d, "BEI003", l) :- bootstrap_invariants_resolve_call(d, n), !bootstrap_invariants_in_run(n), line(n, l).
bootstrap_invariants_default_factory(n) :- node(_, k, "keyword_argument", _, _), field(k, "name", nm), text(nm, "default_factory"), field(k, "value", v0), bootstrap_invariants_ast(v0, n).
bootstrap_invariants_row(d, "BEI004", l) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_engine(d), node(d, n, "lambda", _, _), !bootstrap_invariants_default_factory(n), line(n, l).
bootstrap_invariants_row(d, "BEI008", l) :- bootstrap_invariants_ecall(d, n, _, "BootstrapServerPlanContract"), bootstrap_invariants_engine(d), bootstrap_invariants_kw(n, _, "step_refs", v), bootstrap_invariants_tuple_len(v, 0), bootstrap_invariants_kw(n, _, "steps", w), bootstrap_invariants_tuple_len(w, k), k <= 1, line(n, l).
bootstrap_invariants_row(d, "BEI009", l) :- bootstrap_invariants_ecall(d, n, _, "_bootstrap_engine_placeholder"), bootstrap_invariants_engine(d), bootstrap_invariants_arg0(n, v), bootstrap_invariants_str(v, "lazy bootstrap index interrogation"), line(n, l).
bootstrap_invariants_row(d, "BEI010", l) :- bootstrap_invariants_ecall(d, n, _, "_plan_physical_schema_contract"), bootstrap_invariants_engine(d), bootstrap_invariants_base(d, "bootstrap_coordinator.py"), bootstrap_invariants_haskw(n, "conn"), line(n, l).
bootstrap_invariants_publish_call(d, n) :- bootstrap_invariants_ecall(d, n, _, "publish_bootstrap_metadata_lazy"), bootstrap_invariants_engine(d).
bootstrap_invariants_row(d, "BEI017", l) :- bootstrap_invariants_publish_call(d, n), bootstrap_invariants_posraw(n, _, _), line(n, l).
bootstrap_invariants_row(d, "BEI017", l) :- bootstrap_invariants_publish_call(d, n), !bootstrap_invariants_haskw(n, "publication_plan"), line(n, l).
bootstrap_invariants_row(d, "BEI017", l) :- bootstrap_invariants_publish_call(d, n), !bootstrap_invariants_haskw(n, "publication_rows"), line(n, l).
bootstrap_invariants_fn_need(n) :- bootstrap_invariants_publish_call(d, n), bootstrap_invariants_base(d, "bootstrap_coordinator.py").
bootstrap_invariants_plan_artifact(v) :- bootstrap_invariants_attr(v, _, o), bootstrap_invariants_name(o, "application_plan").
bootstrap_invariants_row(d, "BEI017", l) :- bootstrap_invariants_publish_call(d, n), bootstrap_invariants_base(d, "bootstrap_coordinator.py"), bootstrap_invariants_fn(n, f), bootstrap_invariants_def(_, f, "_enqueue_application_schema_lazy"), bootstrap_invariants_kw(n, _, x, v), (x = "publication_plan" ; x = "publication_rows"), !bootstrap_invariants_plan_artifact(v), line(v, l).
bootstrap_invariants_refs_get(d, n) :- bootstrap_invariants_ecall(d, n, "Attribute", "get"), bootstrap_invariants_engine(d), bootstrap_invariants_base(d, "bootstrap_coordinator.py"), bootstrap_invariants_receiver(n, r), bootstrap_invariants_name(r, "table_source_refs"), bootstrap_invariants_nargs(n, k), k > 1.
bootstrap_invariants_fn_need(n) :- bootstrap_invariants_refs_get(_, n).
bootstrap_invariants_row(d, "BEI020", l) :- bootstrap_invariants_refs_get(d, n), bootstrap_invariants_fn(n, f), bootstrap_invariants_def(_, f, "_application_sql_assertions_for_plan"), line(n, l).
bootstrap_invariants_row(d, "BEI018", l) :- bootstrap_invariants_fnode(d, f, "plan_bootstrap_schema_generation"), !op(f, "async"), bootstrap_invariants_in(f, n), bootstrap_invariants_name(n, x), (x = "BootstrapObservedState" ; x = "SCHEMA_GENERATION_GLOBAL_TAG"), line(n, l).
bootstrap_invariants_row(d, "BEI018", l) :- bootstrap_invariants_scope(d, _), node(d, t, "boolean_operator", _, _), bootstrap_invariants_or_value(t, n), bootstrap_invariants_attr(n, x, _), (x = "schema_generation" ; x = "schema_version"), line(n, l).
bootstrap_invariants_helper_file(d) :- bootstrap_invariants_scope(d, p), match("^data_layer_testing/helpers/bootstrap[^/]*$", p).
bootstrap_invariants_row(d, "BEI021", l) :- bootstrap_invariants_helper_file(d), bootstrap_invariants_ecall(d, n, _, s), bootstrap_invariants_probe11(s), line(n, l).
bootstrap_invariants_row(d, "BEI021", l) :- bootstrap_invariants_helper_file(d), bootstrap_invariants_enode_named(d, n, x), bootstrap_invariants_proof_state3(x), line(n, l).
bootstrap_invariants_probe_file(d) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_base(d, b), prefix("bootstrap", b).
bootstrap_invariants_probe_file(d) :- bootstrap_invariants_scope(d, _), path_part(d, "bootstrap").
bootstrap_invariants_row(d, "BEI028", l) :- bootstrap_invariants_probe_file(d), !bootstrap_invariants_base(d, "bootstrap_backend_collaborators.py"), bootstrap_invariants_scope(d, _), node(d, n, _, _, _), bootstrap_invariants_attr(n, x, _), bootstrap_invariants_backend5(x), line(n, l).
bootstrap_invariants_dialect_file(d) :- path_part(d, "l2200_sql_dialect").
bootstrap_invariants_row(d, "BEI041", l) :- bootstrap_invariants_ecall(d, n, _, s), bootstrap_invariants_fallback8(s), bootstrap_invariants_dialect_file(d), line(n, l).
bootstrap_invariants_row(d, "BEI041", l) :- bootstrap_invariants_ecall(d, n, _, s), bootstrap_invariants_fallback8(s), bootstrap_invariants_base(d, "generic_sparse.py"), line(n, l).
bootstrap_invariants_row(d, "BEI035", l) :- bootstrap_invariants_dialect_file(d), bootstrap_invariants_scope(d, _), node(d, n, _, _, _), bootstrap_invariants_attr(n, x, v), prefix("pending_", x), bootstrap_invariants_name(v, "deferred_state"), line(n, l).
bootstrap_invariants_row(d, "BEI042", l) :- bootstrap_invariants_enode_named(d, n, x), bootstrap_invariants_scaffold7(x), bootstrap_invariants_base(d, "bootstrap_application_plan.py"), line(n, l).
bootstrap_invariants_row(d, "BEI042", l) :- bootstrap_invariants_enode_named(d, n, x), bootstrap_invariants_scaffold7(x), bootstrap_invariants_base(d, "bootstrap_coordinator.py"), line(n, l).
bootstrap_invariants_row(d, "BEI022", l) :- bootstrap_invariants_fnode(d, f, x), bootstrap_invariants_base(d, "bootstrap_interrogation.py"), bootstrap_invariants_hash_names(x), line(f, l).
bootstrap_invariants_row(d, "BEI022", l) :- bootstrap_invariants_scope(d, _), bootstrap_invariants_base(d, "bootstrap_interrogation.py"), node(d, t, "boolean_operator", _, _), bootstrap_invariants_or_value(t, v), bootstrap_invariants_named(v, x), (x = "request" ; x = "proof_hashes" ; x = "seed_hashes"), line(t, l).
bootstrap_invariants_coverage_error(p) :- bootstrap_invariants_entry("all"), doc(d, p, _), in_scope(d), !out_scope(d), tape_syntax_error(d), (p = "l3200_metadata/bootstrap_coordinator.py" ; p = "l3200_metadata/bootstrap_data_plan.py").
bootstrap_invariants_quiet(1) :- bootstrap_invariants_coverage_error("l3200_metadata/bootstrap_coordinator.py").
bootstrap_invariants_quiet(1) :- bootstrap_invariants_coverage_error(_), bootstrap_invariants_gate(_, "l3200_metadata/bootstrap_coordinator.py").
violation("data-layer-bootstrap-engine-invariants", "bootstrap-invariants", i, p, l) :- bootstrap_invariants_entry("all"), !bootstrap_invariants_quiet(1), bootstrap_invariants_row(d, i, l), doc(d, p, _).
violation("data-layer-bootstrap-engine-invariants", "bootstrap-invariants", "BEI007", p, l) :- bootstrap_invariants_entry("_collect_fake_executor_violations"), bootstrap_invariants_row(d, "BEI007", l), doc(d, p, _).
violation("data-layer-bootstrap-engine-invariants", "bootstrap-invariants", i, p, l) :- bootstrap_invariants_entry(e), e != "all", e != "_collect_fake_executor_violations", bootstrap_invariants_row(d, i, l), doc(d, p, _).
primitive_install_valid(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), !cpython_syntax_error(d, _, _), bootstrap_invariants_entry(e), (e = "_collect_primitive_install_coverage_violations" ; e = "all").
bootstrap_invariants_depth_need(f) :- primitive_install_valid(d, "l3200_metadata/bootstrap_coordinator.py"), bootstrap_invariants_def(d, f, x), primitive_install_install_name(x).
primitive_install_fn(d, f, x, k, s) :- primitive_install_valid(d, "l3200_metadata/bootstrap_coordinator.py"), bootstrap_invariants_def(d, f, x), primitive_install_install_name(x), bootstrap_invariants_depth(f, k), node(d, f, _, s, _).
primitive_install_later(f) :- primitive_install_fn(d, f, x, k, _), primitive_install_fn(d, _, x, k2, _), k2 > k.
primitive_install_later(f) :- primitive_install_fn(d, f, x, k, s), primitive_install_fn(d, _, x, k, s2), s2 > s.
primitive_install_installed(x) :- primitive_install_fn(_, f, _, _, _), !primitive_install_later(f), bootstrap_invariants_in(f, n), bootstrap_invariants_attr(n, x, v), bootstrap_invariants_name(v, "BootstrapDataPrimitiveKind").
bootstrap_invariants_depth_need(c) :- primitive_install_valid(d, "l3200_metadata/bootstrap_data_plan.py"), bootstrap_invariants_class(d, c, "BootstrapDataPrimitiveKind").
primitive_install_class(d, c, k, s) :- primitive_install_valid(d, "l3200_metadata/bootstrap_data_plan.py"), bootstrap_invariants_class(d, c, "BootstrapDataPrimitiveKind"), bootstrap_invariants_depth(c, k), node(d, c, _, s, _).
primitive_install_not_first(c) :- primitive_install_class(d, c, k, _), primitive_install_class(d, _, k2, _), k2 < k.
primitive_install_not_first(c) :- primitive_install_class(d, c, k, s), primitive_install_class(d, _, k, s2), s2 < s.
primitive_install_declared(x) :- primitive_install_class(_, c, _, _), !primitive_install_not_first(c), field(c, "body", b), child(b, st, _), node(_, st, "expression_statement", _, _), child(st, a, 0), bootstrap_invariants_assign_target(a, t), node(_, t, "identifier", _, _), text(t, x).
violation("data-layer-bootstrap-engine-invariants", "primitive-install-coverage", "BEI038", "l3200_metadata/bootstrap_coordinator.py", 1) :- primitive_install_valid(_, "l3200_metadata/bootstrap_coordinator.py"), primitive_install_declared(x), !primitive_install_installed(x).
bootstrap_source_syntax_doc(d, p) :- bootstrap_invariants_entry(e), e != "all", doc(d, p, _), in_scope(d), !out_scope(d), tape_syntax_error(d).
bootstrap_source_syntax_scope(d) :- bootstrap_source_syntax_doc(d, _), bootstrap_invariants_entry("_collect_fake_executor_violations").
bootstrap_source_syntax_scope(d) :- bootstrap_source_syntax_doc(d, _), bootstrap_invariants_bootstrap_path(d).
bootstrap_source_syntax_scope(d) :- bootstrap_source_syntax_doc(d, p), match("(.*/)?(schema_transaction|sql_connection|bootstrap_interrogation)\\.py", p).
bootstrap_source_syntax_scope(d) :- bootstrap_source_syntax_doc(d, _), bootstrap_invariants_base_bootstrap(d).
bootstrap_source_syntax_scope(d) :- bootstrap_source_syntax_doc(d, _), node(d, m, "module", _, _), node_text(m, s), (contains("Bootstrap", s) ; contains("bootstrap", s) ; contains("schema_transaction", s) ; contains("materialized_pipeline", s) ; contains("physical_table", s) ; contains("reconciliation", s)).
violation("data-layer-bootstrap-engine-invariants", "bootstrap-source-syntax", "NATIVE-SYNTAX", p, l) :- bootstrap_source_syntax_scope(d), bootstrap_source_syntax_doc(d, p), node(d, m, "module", _, _), line(m, l).
