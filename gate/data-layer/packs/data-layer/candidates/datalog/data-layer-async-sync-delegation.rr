blocked4(low, high) :- inside(low, high, k0), inside(low, s, k1), node(_, s, "function_definition", _, _), node(_, s, _, v5, v6), node(_, high, _, v7, v8), v7 <= v5, v6 <= v8, s != high.
m9(n) :- node(_, n, "for_statement", _, _).
m9(n) :- node(_, n, "with_statement", _, _).
blocked13(low, high) :- inside(low, high, k0), inside(low, s, k1), node(_, s, "function_definition", _, _), node(_, s, _, v14, v15), node(_, high, _, v16, v17), v16 <= v14, v15 <= v17, s != high.
m18(n) :- node(_, n, "for_statement", _, _).
m18(n) :- node(_, n, "with_statement", _, _).
m35(n) :- node(_, n, "identifier", _, _), text(n, v32), v32 = "legacy_sync".
m35(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v33), node(_, v33, "identifier", _, _), text(v33, v34), v34 = "legacy_sync".
