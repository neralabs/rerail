sync_delegation_core(f, p, nm) :- sync_delegation_fn(f, p, nm), !sync_delegation_awaits(f), !asd_stub(f), !sync_delegation_stub_body(f), !sync_delegation_toggle(f), !sync_delegation_lazy_only(f), !asd_deco(f, "legacy_async"), !asd_deco(f, "legacy_module_async"), !sync_delegation_exempt(f).
sync_delegation_delegates(f) :- sync_delegation_core(f, _, nm), suffix("_async", nm), sync_delegation_own(f, c), node(_, c, "call", _, _), field(c, "function", g), node(_, g, "identifier", _, _), text(g, s), nm = @concat(s, "_async").
sync_delegation_delegates(f) :- sync_delegation_core(f, _, nm), suffix("_async", nm), sync_delegation_own(f, c), node(_, c, "call", _, _), field(c, "function", g), node(_, g, "attribute", _, _), field(g, "attribute", a), text(a, s), nm = @concat(s, "_async").
violation("data-layer-async-sync-delegation", "sync-delegation", "A", p, l) :- sync_delegation_delegates(f), sync_delegation_core(f, p, _), line(f, l).
violation("data-layer-async-sync-delegation", "no-await", "B", p, l) :- sync_delegation_core(f, p, _), !sync_delegation_delegates(f), line(f, l).
wrapper_shape_base(f, "__enter__") :- asd_fname(f, "__aenter__").
wrapper_shape_base(f, "__exit__") :- asd_fname(f, "__aexit__").
wrapper_shape_pub_base(f, b) :- asd_fname(f, nm), suffix("_async", nm), !prefix("_", nm), k = @sub(@strlen(nm), 6), b = @substr(nm, 0, k).
wrapper_shape_cand(f, "dunder", c, i, s) :- wrapper_shape_base(f, b), asd_class_of(f, c, bc), asd_member(bc, i, s), asd_fname(s, b).
wrapper_shape_cand(f, "public", c, i, s) :- wrapper_shape_pub_base(f, b), asd_class_of(f, c, bc), asd_member(bc, i, s), asd_fname(s, b).
wrapper_shape_pair(f, k, c, s) :- wrapper_shape_cand(f, k, c, i, s), i = min j : { wrapper_shape_cand(f, k, c, j, _) }.
wrapper_shape_doc(f, p) :- node(d, f, "function_definition", _, _), asd_doc(d, p), !asd_test_path(p).
wrapper_shape_call_of(x, h) :- node(_, x, "call", _, _), field(x, "function", h), node(_, h, "identifier", _, _).
wrapper_shape_call_of(x, h) :- node(_, x, "call", _, _), field(x, "function", h), node(_, h, "attribute", _, _).
wrapper_shape_stmt(s) :- node(_, s, "return_statement", _, _).
wrapper_shape_stmt(s) :- node(_, s, "expression_statement", _, _).
wrapper_shape_thin(f, h) :- node(_, f, "function_definition", _, _), !op(f, "async"), asd_body_count(f, 1), asd_body_real(f, s), wrapper_shape_stmt(s), child(s, x, _), wrapper_shape_call_of(x, h).
wrapper_shape_thin(f, h) :- node(_, f, "function_definition", _, _), op(f, "async"), asd_body_count(f, 1), asd_body_real(f, s), wrapper_shape_stmt(s), child(s, w, _), node(_, w, "await", _, _), child(w, x, _), wrapper_shape_call_of(x, h).
wrapper_shape_is_thin(f) :- wrapper_shape_thin(f, _).
wrapper_shape_family(f, fam) :- wrapper_shape_thin(f, h), asd_compact(h, s), suffix("_async", s), k = @sub(@strlen(s), 6), fam = @substr(s, 0, k).
wrapper_shape_family(f, fam) :- wrapper_shape_thin(f, h), asd_compact(h, s), suffix("_sync", s), k = @sub(@strlen(s), 5), fam = @substr(s, 0, k).
wrapper_shape_family(f, s) :- wrapper_shape_thin(f, h), asd_compact(h, s), !suffix("_async", s), !suffix("_sync", s).
wrapper_shape_param(f, x) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, x, _).
wrapper_shape_callback(f) :- wrapper_shape_param(f, x), node(_, x, "identifier", _, _), text(x, "callback").
wrapper_shape_callback(f) :- wrapper_shape_param(f, x), node(_, x, "identifier", _, _), text(x, "fn").
wrapper_shape_callback(f) :- wrapper_shape_param(f, x), node(_, x, "typed_parameter", _, _), child(x, y, _), node(_, y, "identifier", _, _), text(y, "callback").
wrapper_shape_callback(f) :- wrapper_shape_param(f, x), node(_, x, "typed_parameter", _, _), child(x, y, _), node(_, y, "identifier", _, _), text(y, "fn").
wrapper_shape_callback(f) :- wrapper_shape_param(f, x), node(_, x, "typed_default_parameter", _, _), child(x, y, _), node(_, y, "identifier", _, _), text(y, "callback").
wrapper_shape_callback(f) :- wrapper_shape_param(f, x), node(_, x, "typed_default_parameter", _, _), child(x, y, _), node(_, y, "identifier", _, _), text(y, "fn").
wrapper_shape_callback(f) :- wrapper_shape_param(f, x), node(_, x, "typed_parameter", _, _), field(x, "type", t), node_text(t, s), contains("Callable", s).
wrapper_shape_callback(f) :- wrapper_shape_param(f, x), node(_, x, "typed_default_parameter", _, _), field(x, "type", t), node_text(t, s), contains("Callable", s).
wrapper_shape_txn(f) :- wrapper_shape_param(f, x), node(_, x, "identifier", _, _), text(x, "base_txn").
wrapper_shape_txn(f) :- wrapper_shape_param(f, x), node(_, x, "identifier", _, _), text(x, "read_txn").
wrapper_shape_txn(f) :- wrapper_shape_param(f, x), node(_, x, "identifier", _, _), text(x, "tx").
wrapper_shape_txn(f) :- wrapper_shape_param(f, x), node(_, x, "identifier", _, _), text(x, "txn").
wrapper_shape_txn(f) :- wrapper_shape_param(f, x), node(_, x, "identifier", _, _), text(x, "vtxn").
wrapper_shape_txn(f) :- wrapper_shape_param(f, x), node(_, x, "identifier", _, _), text(x, "write_txn").
wrapper_shape_txn(f) :- wrapper_shape_param(f, x), node(_, x, "typed_parameter", _, _), field(x, "type", t), node_text(t, s), contains("Transaction", s).
wrapper_shape_txn(f) :- wrapper_shape_param(f, x), node(_, x, "typed_default_parameter", _, _), field(x, "type", t), node_text(t, s), contains("Transaction", s).
wrapper_shape_unsupported(f) :- node(_, f, "function_definition", _, _), inside(c, f, asd_fdef), node(_, c, "call", _, _), field(c, "function", g), node(_, g, "attribute", _, _), field(g, "attribute", a), node(_, a, "identifier", _, _), text(a, "_raise_async_not_supported").
wrapper_shape_cb(f, s) :- wrapper_shape_pair(f, "public", _, s), wrapper_shape_doc(f, _), !asd_stub(f), !asd_stub(s), wrapper_shape_callback(f), !asd_deco(f, "legacy_async"), !asd_deco(s, "legacy_sync"), !wrapper_shape_unsupported(f), !wrapper_shape_unsupported(s).
wrapper_shape_cb(f, s) :- wrapper_shape_pair(f, "public", _, s), wrapper_shape_doc(f, _), !asd_stub(f), !asd_stub(s), wrapper_shape_callback(s), !asd_deco(f, "legacy_async"), !asd_deco(s, "legacy_sync"), !wrapper_shape_unsupported(f), !wrapper_shape_unsupported(s).
wrapper_shape_shape(f, s) :- wrapper_shape_pair(f, "dunder", _, s), wrapper_shape_doc(f, _).
wrapper_shape_shape(f, s) :- wrapper_shape_cb(f, s).
wrapper_shape_bad(f) :- wrapper_shape_shape(f, s), !wrapper_shape_is_thin(s).
wrapper_shape_bad(f) :- wrapper_shape_shape(f, s), wrapper_shape_is_thin(s), !wrapper_shape_is_thin(f).
wrapper_shape_bad(f) :- wrapper_shape_shape(f, s), wrapper_shape_family(s, a), wrapper_shape_family(f, b), a != b.
wrapper_shape_lazy_sibling(c, nm, g) :- wrapper_shape_pair(f, "public", c, _), wrapper_shape_pub_base(f, b), nm = @concat(b, "_lazy"), field(c, "body", bc), asd_member(bc, _, g), asd_fname(g, nm).
wrapper_shape_tx(f, c, s) :- wrapper_shape_pair(f, "public", c, s), wrapper_shape_doc(f, _), !wrapper_shape_callback(f), !wrapper_shape_callback(s), !asd_stub(f), !asd_stub(s), wrapper_shape_txn(f), wrapper_shape_has_lazy(f), !wrapper_shape_legacy_triple(f).
wrapper_shape_tx(f, c, s) :- wrapper_shape_pair(f, "public", c, s), wrapper_shape_doc(f, _), !wrapper_shape_callback(f), !wrapper_shape_callback(s), !asd_stub(f), !asd_stub(s), wrapper_shape_txn(s), wrapper_shape_has_lazy(f), !wrapper_shape_legacy_triple(f).
wrapper_shape_has_lazy(f) :- wrapper_shape_pair(f, "public", c, _), wrapper_shape_pub_base(f, b), nm = @concat(b, "_lazy"), wrapper_shape_lazy_sibling(c, nm, _).
wrapper_shape_legacy_triple(f) :- wrapper_shape_pair(f, "public", c, s), asd_deco(f, "legacy_async"), asd_deco(s, "legacy_sync"), wrapper_shape_pub_base(f, b), nm = @concat(b, "_lazy"), wrapper_shape_lazy_sibling(c, nm, g), wrapper_shape_lazy_surface(g).
wrapper_shape_lazy_surface(g) :- wrapper_shape_lazy_sibling(_, _, g), asd_deco(g, "lazy"), !field(g, "return_type", _).
wrapper_shape_lazy_surface(g) :- wrapper_shape_lazy_sibling(_, _, g), asd_deco(g, "pure_lazy"), !field(g, "return_type", _).
wrapper_shape_lazy_surface(g) :- wrapper_shape_lazy_sibling(_, _, g), asd_deco(g, "lazy"), field(g, "return_type", t), node_text(t, x), (contains("LazyResult", x) ; contains("LazySeq", x) ; contains("ServerPlan", x)).
wrapper_shape_lazy_surface(g) :- wrapper_shape_lazy_sibling(_, _, g), asd_deco(g, "pure_lazy"), field(g, "return_type", t), node_text(t, x), (contains("LazyResult", x) ; contains("LazySeq", x) ; contains("ServerPlan", x)).
wrapper_shape_lazy_surface(g) :- wrapper_shape_lazy_sibling(_, nm, g), suffix("_lazy", nm), field(g, "return_type", t), node_text(t, x), contains("LazyResult", x), inside(c, g, asd_fdef), node(_, c, "call", _, _), field(c, "function", h), node(_, h, "identifier", _, _), text(h, "grammar_effect_lazy").
wrapper_shape_lazy_surface(g) :- wrapper_shape_lazy_sibling(_, nm, g), suffix("_lazy", nm), field(g, "return_type", t), node_text(t, x), contains("LazyResult", x), inside(c, g, asd_fdef), node(_, c, "call", _, _), field(c, "function", h), node(_, h, "identifier", _, _), text(h, "grammar_row_lazy").
wrapper_shape_lazy_surface(g) :- wrapper_shape_lazy_sibling(_, nm, g), suffix("_lazy", nm), field(g, "return_type", t), node_text(t, x), contains("LazyResult", x), inside(c, g, asd_fdef), node(_, c, "call", _, _), field(c, "function", h), node(_, h, "identifier", _, _), text(h, "grammar_rows_lazy").
wrapper_shape_lazy_surface(g) :- wrapper_shape_lazy_sibling(_, nm, g), suffix("_lazy", nm), field(g, "return_type", t), node_text(t, x), contains("LazyResult", x), inside(c, g, asd_fdef), node(_, c, "call", _, _), field(c, "function", h), node(_, h, "identifier", _, _), text(h, "grammar_value_lazy").
wrapper_shape_lazy_fn(c, z) :- node(_, c, "call", _, _), field(c, "function", z), node(_, z, "identifier", _, _), text(z, s), suffix("_lazy", s).
wrapper_shape_lazy_fn(c, z) :- node(_, c, "call", _, _), field(c, "function", z), node(_, z, "attribute", _, _), field(z, "attribute", a), text(a, s), suffix("_lazy", s).
wrapper_shape_resolve_attr(r, m, z) :- node(_, r, "attribute", _, _), field(r, "attribute", a), node(_, a, "identifier", _, _), text(a, m), (m = "resolve" ; m = "resolve_async"), field(r, "object", o), wrapper_shape_lazy_fn(o, z).
wrapper_shape_resolves("sync", x, z) :- node(_, x, "call", _, _), field(x, "function", r), wrapper_shape_resolve_attr(r, "resolve", z).
wrapper_shape_resolves("async", x, z) :- node(_, x, "call", _, _), field(x, "function", r), wrapper_shape_resolve_attr(r, "resolve_async", z).
wrapper_shape_resolves("sync", x, z) :- wrapper_shape_named_call(x, "run_in_legacy_execution_boundary", args), child(args, r, _), wrapper_shape_resolve_attr(r, "resolve", z).
wrapper_shape_resolves("async", x, z) :- wrapper_shape_named_call(x, "run_in_legacy_execution_boundary_async", args), child(args, r, _), wrapper_shape_resolve_attr(r, "resolve_async", z).
wrapper_shape_resolves(mode, x, z) :- wrapper_shape_legacy_lambda(mode, x, st, z), st = min t : { wrapper_shape_legacy_lambda(mode, x, t, _) }.
wrapper_shape_legacy_lambda("sync", x, st, z) :- wrapper_shape_named_call(x, "_resolve_legacy_result_sync", args), inside(lam, args, wrapper_shape_argk), node(_, lam, "lambda", st, _), field(lam, "body", bd), wrapper_shape_lazy_fn(bd, z).
wrapper_shape_legacy_lambda("async", x, st, z) :- wrapper_shape_named_call(x, "_resolve_legacy_result_async", args), inside(lam, args, wrapper_shape_argk), node(_, lam, "lambda", st, _), field(lam, "body", bd), wrapper_shape_lazy_fn(bd, z).
wrapper_shape_named_call(x, fnm, args) :- node(_, x, "call", _, _), field(x, "function", g), node(_, g, "identifier", _, _), text(g, fnm), field(x, "arguments", args).
wrapper_shape_resolving("sync", s, z) :- wrapper_shape_stmt(s), child(s, x, _), wrapper_shape_resolves("sync", x, z).
wrapper_shape_resolving("async", s, z) :- wrapper_shape_stmt(s), child(s, w, _), node(_, w, "await", _, _), child(w, x, _), wrapper_shape_resolves("async", x, z).
wrapper_shape_mode(f, "sync") :- node(_, f, "function_definition", _, _), !op(f, "async").
wrapper_shape_mode(f, "async") :- node(_, f, "function_definition", _, _), op(f, "async").
wrapper_shape_lazy_thin(f, z) :- wrapper_shape_mode(f, md), asd_body_count(f, 1), asd_body_real(f, s), wrapper_shape_resolving(md, s, z).
wrapper_shape_lazy_thin(f, z) :- wrapper_shape_mode(f, md), asd_body_count(f, 1), asd_body_real(f, s), node(_, s, "try_statement", _, _), !wrapper_shape_try_tail(s), field(s, "body", tb), asd_real_count(tb, 1), child(tb, y, _), wrapper_shape_resolving(md, y, z).
wrapper_shape_lazy_thin(f, z) :- wrapper_shape_mode(f, md), asd_body_count(f, 2), field(f, "body", b), child(b, y, i), wrapper_shape_resolving(md, y, z), child(b, e, j), j > i, node(_, e, "expression_statement", _, _), child(e, x, _), wrapper_shape_call_of(x, _).
wrapper_shape_try_tail(s) :- node(_, s, "try_statement", _, _), child(s, x, _), node(_, x, "else_clause", _, _).
wrapper_shape_try_tail(s) :- node(_, s, "try_statement", _, _), child(s, x, _), node(_, x, "finally_clause", _, _).
wrapper_shape_is_lazy_thin(f) :- wrapper_shape_lazy_thin(f, _).
wrapper_shape_lazy_name(f, s) :- wrapper_shape_lazy_thin(f, z), asd_compact(z, s).
wrapper_shape_bad(f) :- wrapper_shape_tx(f, _, s), !wrapper_shape_is_lazy_thin(s).
wrapper_shape_bad(f) :- wrapper_shape_tx(f, _, s), wrapper_shape_is_lazy_thin(s), !wrapper_shape_is_lazy_thin(f).
wrapper_shape_bad(f) :- wrapper_shape_tx(f, _, s), wrapper_shape_lazy_name(s, a), wrapper_shape_lazy_name(f, b), a != b.
violation("data-layer-async-sync-delegation", "wrapper-shape", "C", p, l) :- wrapper_shape_bad(f), wrapper_shape_doc(f, p), line(f, l).
legacy_fn(f, dv, b) :- legacy_variant(dv, _, drop, _), asd_deco_plain(f, dv), asd_fname(f, nm), drop != "", suffix(drop, nm), k = @sub(@strlen(nm), @strlen(drop)), b = @substr(nm, 0, k).
legacy_fn(f, dv, nm) :- legacy_variant(dv, _, drop, _), asd_deco_plain(f, dv), asd_fname(f, nm), drop != "", !suffix(drop, nm).
legacy_fn(f, dv, nm) :- legacy_variant(dv, _, "", _), asd_deco_plain(f, dv), asd_fname(f, nm).
legacy_top(f, m) :- legacy_fn(f, _, _), field(dd, "definition", f), child(m, dd, _), node(_, m, "module", _, _).
legacy_method(f, dv, b, c) :- legacy_fn(f, dv, b), nearest(f, c, asd_class), asd_top_class(c), !legacy_query(f), !legacy_factory(f, c, b).
legacy_query(f) :- legacy_fn(f, _, _), asd_fname(f, nm), (nm = "query" ; nm = "query_sync" ; nm = "query_unfiltered" ; nm = "query_unfiltered_sync"), field(f, "return_type", t), node_text(t, s), contains("Query", s).
legacy_factory(f, c, b) :- legacy_fn(f, _, b), nearest(f, c, asd_class), nm = @concat(b, "_lazy"), field(c, "body", bc), child(bc, x, _), node(_, x, "decorated_definition", _, _), field(x, "definition", g), asd_fname(g, nm), asd_deco(g, "lazy"), field(g, "return_type", t), node_text(t, s), !contains("LazyResult", s), !contains("LazySeq", s), !contains("ServerPlan", s).
legacy_factory(f, c, b) :- legacy_fn(f, _, b), nearest(f, c, asd_class), nm = @concat(b, "_lazy"), field(c, "body", bc), child(bc, x, _), node(_, x, "decorated_definition", _, _), field(x, "definition", g), asd_fname(g, nm), asd_deco(g, "pure_lazy"), field(g, "return_type", t), node_text(t, s), !contains("LazyResult", s), !contains("LazySeq", s), !contains("ServerPlan", s).
legacy_scope(o, o) :- node(_, o, "module", _, _).
legacy_scope(o, ob) :- node(_, o, "class_definition", _, _), field(o, "body", ob).
legacy_rebind(o, i, nm, x) :- legacy_scope(o, ob), child(ob, s, i), node(_, s, "expression_statement", _, _), child(s, a, _), node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, nm), field(a, "right", r), node(_, r, "identifier", _, _), text(r, x).
legacy_last_rebind(o, nm, x) :- legacy_rebind(o, i, nm, x), !legacy_later_rebind(o, i, nm).
legacy_later_rebind(o, i, nm) :- legacy_rebind(o, i, nm, _), legacy_rebind(o, j, nm, _), j > i.
legacy_rebound(o, nm) :- legacy_last_rebind(o, nm, _).
legacy_lazydef(o, nm) :- legacy_scope(o, ob), child(ob, x, _), node(_, x, "decorated_definition", _, _), field(x, "definition", g), asd_fname(g, nm), asd_deco(g, "lazy").
legacy_lazydef(o, nm) :- legacy_scope(o, ob), child(ob, x, _), node(_, x, "decorated_definition", _, _), field(x, "definition", g), asd_fname(g, nm), asd_deco(g, "pure_lazy").
legacy_valid(o, nm) :- legacy_lazydef(o, nm), !legacy_rebound(o, nm).
legacy_valid(o, nm) :- legacy_lazydef(o, nm), legacy_last_rebind(o, nm, nm).
legacy_valid(o, nm) :- legacy_last_rebind(o, nm, x), x != nm, legacy_valid(o, x).
legacy_lazy_ok(o, nm) :- legacy_valid(o, nm), node(d, o, "module", _, _), node(d, i, "identifier", _, _), text(i, nm).
legacy_lazy_ok(o, nm) :- legacy_valid(o, nm), node(_, o, "class_definition", _, _), inside(i, o, asd_class), node(_, i, "identifier", _, _), text(i, nm).
legacy_missing_lazy(f, dv) :- legacy_fn(f, dv, b), legacy_top(f, m), nm = @concat(b, "_lazy"), !legacy_lazy_ok(m, nm).
legacy_missing_lazy(f, dv) :- legacy_method(f, dv, b, c), field(c, "name", cn), text(cn, s), (suffix("Connection", s) ; suffix("SessionHandle", s) ; suffix("VersionHandle", s)), nm = @concat(b, "_lazy"), !legacy_lazy_ok(c, nm).
legacy_has_counterpart(o, cv, nm) :- legacy_scope(o, ob), child(ob, x, _), node(_, x, "decorated_definition", _, _), field(x, "definition", g), asd_fname(g, nm), asd_deco(g, cv).
legacy_counterpart(f, cv, nm) :- legacy_fn(f, dv, b), legacy_variant(dv, cv, _, cp), nm = @concat(b, cp).
legacy_class_other(c, o) :- node(_, c, "class_definition", _, _), field(c, "name", n), text(n, s), prefix("Sync", s), k = @sub(@strlen(s), 4), o = @concat("Async", @substr(s, 4, k)).
legacy_class_other(c, o) :- node(_, c, "class_definition", _, _), field(c, "name", n), text(n, s), prefix("Async", s), k = @sub(@strlen(s), 5), o = @concat("Sync", @substr(s, 5, k)).
legacy_class_other(c, s) :- node(_, c, "class_definition", _, _), field(c, "name", n), text(n, s), !prefix("Sync", s), !prefix("Async", s).
legacy_missing_pair(f, dv) :- legacy_top(f, m), legacy_fn(f, dv, _), legacy_counterpart(f, cv, nm), !legacy_has_counterpart(m, cv, nm).
legacy_missing_pair(f, dv) :- legacy_method(f, dv, _, c), legacy_counterpart(f, cv, nm), !legacy_has_counterpart(c, cv, nm), !legacy_other_class_pair(f).
legacy_other_class_pair(f) :- legacy_method(f, _, _, c), legacy_class_other(c, o), legacy_counterpart(f, cv, nm), node(d, c, _, _, _), node(d, c2, "class_definition", _, _), asd_top_class(c2), field(c2, "name", n2), text(n2, o), legacy_has_counterpart(c2, cv, nm).
legacy_doc(f, p) :- legacy_fn(f, _, _), node(d, f, _, _, _), asd_doc(d, p).
violation("data-layer-async-sync-delegation", "legacy_sync-missing-lazy", "C", p, l) :- legacy_missing_lazy(f, "legacy_sync"), legacy_doc(f, p), line(f, l).
violation("data-layer-async-sync-delegation", "legacy_sync-missing-pair", "C", p, l) :- legacy_missing_pair(f, "legacy_sync"), legacy_doc(f, p), line(f, l).
violation("data-layer-async-sync-delegation", "legacy_async-missing-lazy", "C", p, l) :- legacy_missing_lazy(f, "legacy_async"), legacy_doc(f, p), line(f, l).
violation("data-layer-async-sync-delegation", "legacy_async-missing-pair", "C", p, l) :- legacy_missing_pair(f, "legacy_async"), legacy_doc(f, p), line(f, l).
violation("data-layer-async-sync-delegation", "legacy_module_sync-missing-lazy", "C", p, l) :- legacy_missing_lazy(f, "legacy_module_sync"), legacy_doc(f, p), line(f, l).
violation("data-layer-async-sync-delegation", "legacy_module_sync-missing-pair", "C", p, l) :- legacy_missing_pair(f, "legacy_module_sync"), legacy_doc(f, p), line(f, l).
violation("data-layer-async-sync-delegation", "legacy_module_async-missing-lazy", "C", p, l) :- legacy_missing_lazy(f, "legacy_module_async"), legacy_doc(f, p), line(f, l).
violation("data-layer-async-sync-delegation", "legacy_module_async-missing-pair", "C", p, l) :- legacy_missing_pair(f, "legacy_module_async"), legacy_doc(f, p), line(f, l).
violation("data-layer-async-sync-delegation", "mixed-name", "C", p, l) :- node(d, f, "function_definition", _, _), asd_doc(d, p), !prefix("tests/", p), !prefix("conform/", p), !contains("/tests/", p), !contains("/conform/", p), asd_fname(f, nm), icontains("lazy", nm), icontains("sync", nm), line(f, l).
escape_hatch_call(c, d) :- node(d, c, "call", _, _), field(c, "function", g), node(_, g, "identifier", _, _), text(g, "run_in_executor").
escape_hatch_call(c, d) :- node(d, c, "call", _, _), field(c, "function", g), node(_, g, "identifier", _, _), text(g, "to_thread").
escape_hatch_call(c, d) :- node(d, c, "call", _, _), field(c, "function", g), node(_, g, "identifier", _, _), text(g, "tracked_run_in_executor").
escape_hatch_call(c, d) :- node(d, c, "call", _, _), field(c, "function", g), node(_, g, "identifier", _, _), text(g, "tracked_to_thread").
escape_hatch_call(c, d) :- node(d, c, "call", _, _), field(c, "function", g), node(_, g, "attribute", _, _), field(g, "attribute", a), node(_, a, "identifier", _, _), text(a, "run_in_executor").
escape_hatch_call(c, d) :- node(d, c, "call", _, _), field(c, "function", g), node(_, g, "attribute", _, _), field(g, "attribute", a), node(_, a, "identifier", _, _), text(a, "to_thread").
escape_hatch_call(c, d) :- node(d, c, "call", _, _), field(c, "function", g), node(_, g, "attribute", _, _), field(g, "attribute", a), node(_, a, "identifier", _, _), text(a, "tracked_run_in_executor").
escape_hatch_call(c, d) :- node(d, c, "call", _, _), field(c, "function", g), node(_, g, "attribute", _, _), field(g, "attribute", a), node(_, a, "identifier", _, _), text(a, "tracked_to_thread").
escape_hatch_exempt(c) :- escape_hatch_call(c, d), doc(d, p, _), suffix("impl/common/l2550_storage_backend/backend.py", p), nearest(c, f, asd_fdef), field(f, "name", nmn), text(nmn, "delete_async").
escape_hatch_exempt(c) :- escape_hatch_call(c, d), doc(d, p, _), suffix("impl/common/l2550_storage_backend/backend.py", p), nearest(c, f, asd_fdef), field(f, "name", nmn), text(nmn, "exists_async").
escape_hatch_exempt(c) :- escape_hatch_call(c, d), doc(d, p, _), suffix("impl/common/l2550_storage_backend/backend.py", p), nearest(c, f, asd_fdef), field(f, "name", nmn), text(nmn, "get_metadata_async").
escape_hatch_exempt(c) :- escape_hatch_call(c, d), doc(d, p, _), suffix("impl/common/l2550_storage_backend/backend.py", p), nearest(c, f, asd_fdef), field(f, "name", nmn), text(nmn, "get_stats_async").
escape_hatch_exempt(c) :- escape_hatch_call(c, d), doc(d, p, _), suffix("impl/common/l2550_storage_backend/backend.py", p), nearest(c, f, asd_fdef), field(f, "name", nmn), text(nmn, "iter_content_hashes_async").
escape_hatch_exempt(c) :- escape_hatch_call(c, d), doc(d, p, _), suffix("impl/common/l2550_storage_backend/backend.py", p), nearest(c, f, asd_fdef), field(f, "name", nmn), text(nmn, "retrieve_async").
escape_hatch_exempt(c) :- escape_hatch_call(c, d), doc(d, p, _), suffix("impl/common/l2550_storage_backend/backend.py", p), nearest(c, f, asd_fdef), field(f, "name", nmn), text(nmn, "store_async").
escape_hatch_exempt(c) :- escape_hatch_call(c, d), doc(d, p, _), suffix("impl/sqlite/native_async_wrapper.py", p), nearest(c, f, asd_fdef), field(f, "name", nmn), text(nmn, "_run_sqlite_call_in_thread").
violation("data-layer-async-sync-delegation", "escape-hatch", "C", p, l) :- escape_hatch_call(c, d), asd_doc(d, p), !asd_test_path(p), !escape_hatch_exempt(c), line(c, l).
