blocked4(low, high) :- inside(low, s, k1), node(_, s, "function_definition", _, _), inside(s, high, k1).
m5(n) :- node(_, n, "for_statement", _, _).
m5(n) :- node(_, n, "with_statement", _, _).
blocked9(low, high) :- inside(low, s, k1), node(_, s, "function_definition", _, _), inside(s, high, k1).
m10(n) :- node(_, n, "for_statement", _, _).
m10(n) :- node(_, n, "with_statement", _, _).
m27(n) :- node(_, n, "identifier", _, _), text(n, v24), v24 = "legacy_sync".
