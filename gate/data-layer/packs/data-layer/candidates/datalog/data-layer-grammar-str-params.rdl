.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl name(n: node, s: sym)
.decl op(n: node, s: sym)
.input doc, node, child, field, text, name, op
.kindset k0 = "function_definition"
.kindset k1 = "class_definition"
.decl in_scope(d: int)
.decl m23(n: node)
.decl m30(n: node)
.decl m38(n: node)
.decl m39(n: node)
.decl m4(n: node)
.decl m47(n: node)
.decl m48(n: node)
.decl m58(n: node)
.decl out_scope(d: int)
.decl u1(n: node)
.decl u55(n: node)
.decl u6(n: node)
.decl u60(n: node)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/common/l2100_sql_grammar/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
m4($n) :- node(_, $n, "identifier", _, _), text($n, $v3), $v3 = "self".
m23($n) :- field($n, "name", $v21), node(_, $v21, "identifier", _, _), text($v21, $v22), $v22 in {"CheckExpressionLexer", "SqlAdminToolRawStatement", "SqlColumnConstraint", "SqlColumnType", "SqlEscapedLiteral", "SqlExplain", "SqlFragment", "SqlHybridSearchQuery", "SqlIntegerLiteral", "SqlPreRenderedFragment", "SqlQuotedIdentifier", "SqlTypeRef", "ViewDefinition", "sql_ddl_comment"}.
m30($n) :- node(_, $n, "identifier", _, _), text($n, $v26), @prefix($v26, {"Sql", "_Sql"}).
m30($n) :- node(_, $n, "attribute", _, _), field($n, "attribute", $v27), name($v27, $v29), @prefix($v29, {"Sql", "_Sql"}).
m38($n) :- node(_, $n, "function_definition", _, _), field($n, "name", $v33), node(_, $v33, "identifier", _, _), text($v33, $v34), $v34 = "render", !op($n, "async").
m38($n) :- node(_, $n, "decorated_definition", _, _), field($n, "definition", $v35), node(_, $v35, "function_definition", _, _), field($v35, "name", $v36), node(_, $v36, "identifier", _, _), text($v36, $v37), $v37 = "render", !op($v35, "async").
m39($n) :- field($n, "superclasses", $v24), child($v24, $v25, _), m30($v25).
m39($n) :- field($n, "body", $v31), child($v31, $v32, _), m38($v32).
m47($n) :- node(_, $n, "function_definition", _, _), field($n, "name", $v42), node(_, $v42, "identifier", _, _), text($v42, $v43), $v43 = "__init__", !op($n, "async").
m47($n) :- node(_, $n, "decorated_definition", _, _), field($n, "definition", $v44), node(_, $v44, "function_definition", _, _), field($v44, "name", $v45), node(_, $v45, "identifier", _, _), text($v45, $v46), $v46 = "__init__", !op($v44, "async").
m48($n) :- field($n, "body", $v40), child($v40, $v41, _), m47($v41).
m58($n) :- node(_, $n, "identifier", _, _), text($n, $v57), $v57 = "self".
.output violation
