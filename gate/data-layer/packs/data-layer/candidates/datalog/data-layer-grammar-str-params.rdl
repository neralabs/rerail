.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl op(n: node, s: sym)
.input doc, node, child, field, text, op
.decl name(n: node, s: sym)
name($n, $s) :- text($n, $s).
name($n, @cat($o, $a)) :- node(_, $n, "attribute", _, _), field($n, "object", $x), name($x, $o), field($n, "attribute", $y), text($y, $a).
.kindset k0 = "function_definition"
.kindset k1 = "class_definition"
.decl blocked20(low: node, high: node)
.decl in_scope(d: int)
.decl m23(n: node)
.decl m31(n: node)
.decl m39(n: node)
.decl m4(n: node)
.decl m40(n: node)
.decl m48(n: node)
.decl m49(n: node)
.decl m59(n: node)
.decl names0(s: sym)
.decl names1(s: sym)
.decl names2(s: sym)
.decl names3(s: sym)
.decl names4(s: sym)
.decl out_scope(d: int)
.decl t27(s: sym)
.decl t30(s: sym)
.decl u1(n: node)
.decl u56(n: node)
.decl u6(n: node)
.decl u61(n: node)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
names0("self").
names1("str").
names2("render").
names3("CheckExpressionLexer").
names3("SqlAdminToolRawStatement").
names3("SqlColumnConstraint").
names3("SqlColumnType").
names3("SqlEscapedLiteral").
names3("SqlExplain").
names3("SqlFragment").
names3("SqlHybridSearchQuery").
names3("SqlIntegerLiteral").
names3("SqlPreRenderedFragment").
names3("SqlQuotedIdentifier").
names3("SqlTypeRef").
names3("ViewDefinition").
names3("sql_ddl_comment").
names4("__init__").
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/common/l2100_sql_grammar/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
m4($n) :- node(_, $n, "identifier", _, _), text($n, $v3), names0($v3).
blocked20($low, $high) :- inside($low, $s, k1), node(_, $s, "class_definition", _, _), inside($s, $high, k1).
m23($n) :- field($n, "name", $v21), node(_, $v21, "identifier", _, _), text($v21, $v22), names3($v22).
t27($s) :- text(_, $s), @prefix($s, "Sql").
t27($s) :- text(_, $s), @prefix($s, "_Sql").
t30($s) :- name(_, $s), @prefix($s, "Sql").
t30($s) :- name(_, $s), @prefix($s, "_Sql").
m31($n) :- node(_, $n, "identifier", _, _), text($n, $v26), t27($v26).
m31($n) :- node(_, $n, "attribute", _, _), field($n, "attribute", $v28), name($v28, $v29), t30($v29).
m39($n) :- node(_, $n, "function_definition", _, _), field($n, "name", $v34), node(_, $v34, "identifier", _, _), text($v34, $v35), names2($v35), !op($n, "async").
m39($n) :- node(_, $n, "decorated_definition", _, _), field($n, "definition", $v36), node(_, $v36, "function_definition", _, _), field($v36, "name", $v37), node(_, $v37, "identifier", _, _), text($v37, $v38), names2($v38), !op($v36, "async").
m40($n) :- field($n, "superclasses", $v24), child($v24, $v25, _), m31($v25).
m40($n) :- field($n, "body", $v32), child($v32, $v33, _), m39($v33).
m48($n) :- node(_, $n, "function_definition", _, _), field($n, "name", $v43), node(_, $v43, "identifier", _, _), text($v43, $v44), names4($v44), !op($n, "async").
m48($n) :- node(_, $n, "decorated_definition", _, _), field($n, "definition", $v45), node(_, $v45, "function_definition", _, _), field($v45, "name", $v46), node(_, $v46, "identifier", _, _), text($v46, $v47), names4($v47), !op($v45, "async").
m49($n) :- field($n, "body", $v41), child($v41, $v42, _), m48($v42).
m59($n) :- node(_, $n, "identifier", _, _), text($n, $v58), names0($v58).
.output violation
