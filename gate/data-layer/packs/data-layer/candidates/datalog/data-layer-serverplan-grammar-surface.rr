m30(n) :- inside(n, v23, k1), field(v23, "module_name", v24), node(v25, n, _, v26, v27), node(v25, v24, _, v28, v29), v28 <= v26, v27 <= v29, node(_, v23, "import_from_statement", _, _).
violation("data-layer-serverplan-grammar-surface", "ddl-imports", "SPG-ddl_import", p, l) :- node(_, n, "dotted_name", _, _), text(n, v22), (v22 = "SqlPreRenderedDdlFragment" ; v22 = "SqlPrerenderedDdl"), !m30(n), inside(n, v31, k1), node(_, v31, "import_from_statement", _, _), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
violation("data-layer-serverplan-grammar-surface", "syntax", "SPG-SYNTAX", p, 1) :- node(_, n, "module", _, _), node(d, n, _, _, _), in_scope(d), syntax_error(d), !out_scope(d), doc(d, p, _).
