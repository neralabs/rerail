violation("data-layer-serverplan-grammar-surface", "helper-attributes", "SPG-helper_attribute", p, l) :- node(_, n, "attribute", _, _), field(n, "attribute", v5), node(_, v5, "identifier", _, _), text(v5, v6), (v6 = "grammar_execute" ; v6 = "grammar_execute_async" ; v6 = "grammar_execute_lazy" ; v6 = "grammar_exists" ; v6 = "grammar_exists_async" ; v6 = "grammar_exists_lazy" ; v6 = "grammar_fetchall" ; v6 = "grammar_fetchall_async" ; v6 = "grammar_fetchall_lazy" ; v6 = "grammar_fetchone" ; v6 = "grammar_fetchone_async" ; v6 = "grammar_fetchone_lazy" ; v6 = "grammar_scalar" ; v6 = "grammar_scalar_async" ; v6 = "grammar_scalar_lazy" ; v6 = "grammar_validate" ; v6 = "grammar_validate_async" ; v6 = "grammar_validate_lazy"), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
