.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl strprefix(n: node, s: sym)
.input doc, node, child, field, text, strprefix
.kindset k0 = "function_definition"
.kindset k1 = "assert_statement" | "raise_statement"
.decl in_scope(d: int)
.decl m11(n: node)
.decl m14(n: node)
.decl m2(n: node)
.decl m20(n: node)
.decl m21(n: node)
.decl m28(n: node)
.decl m35(n: node)
.decl m5(n: node)
.decl m6(n: node)
.decl m8(n: node)
.decl out_scope(d: int)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/common/l2100_sql_grammar/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
m2($n) :- strprefix($n, $v1), @contains($v1, "f").
m5($n) :- child($n, $v3, _), node(_, $v3, "string", _, _), strprefix($v3, $v4), @contains($v4, "f").
m6($n) :- node(_, $n, "string", _, _), !m2($n).
m6($n) :- node(_, $n, "concatenated_string", _, _), !m5($n).
m8($n) :- child($v7, $n, _), node(_, $v7, "concatenated_string", _, _).
m11($n) :- child($v10, $n, _), node(_, $v10, "concatenated_string", _, _).
m14($n) :- node(_, $n, "string", _, _), strprefix($n, $v9), @contains($v9, "f"), !m11($n).
m14($n) :- node(_, $n, "concatenated_string", _, _), child($n, $v12, _), node(_, $v12, "string", _, _), strprefix($v12, $v13), @contains($v13, "f").
m14($n) :- node(_, $n, "format_specifier", _, _).
m20($n) :- node(_, $n, "raise_statement", _, _).
m20($n) :- node(_, $n, "assert_statement", _, _).
m21($n) :- inside($n, $v19, k1), m20($v19).
m28($n) :- node(_, $n, "identifier", _, _), text($n, $v23), $v23 = "Template".
m28($n) :- node(_, $n, "attribute", _, _), field($n, "object", $v24), node(_, $v24, "identifier", _, _), text($v24, $v25), $v25 = "SqlFragment", field($n, "attribute", $v26), node(_, $v26, "identifier", _, _), text($v26, $v27), $v27 = "static".
m35($n) :- node(_, $n, "identifier", _, _), text($n, $v30), $v30 = "Template".
m35($n) :- node(_, $n, "attribute", _, _), field($n, "object", $v31), node(_, $v31, "identifier", _, _), text($v31, $v32), $v32 = "SqlFragment", field($n, "attribute", $v33), node(_, $v33, "identifier", _, _), text($v33, $v34), $v34 = "static".
.output violation
