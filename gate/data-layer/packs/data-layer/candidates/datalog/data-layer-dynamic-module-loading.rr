out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
pattern_tc_block(b) :- node(_, b, "block", _, _), field(i, "consequence", b), node(_, i, "if_statement", _, _), field(i, "condition", c), node_text(c, s), contains("TYPE_CHECKING", s).
pattern_in_tc(n) :- inside(n, b, pattern_block), pattern_tc_block(b).
pattern_0_top(n) :- child(m, n, _), node(_, m, "module", _, _).
pattern_0_top(n) :- child(w, n, _), node(_, w, "decorated_definition", _, _), child(m, w, _), node(_, m, "module", _, _).
violation("data-layer-dynamic-module-loading", "pattern-0", "DML001", p, l) :- node(d, n, "function_definition", _, _), field(n, "name", x), node_text(x, "__getattr__"), !op(n, "async"), pattern_0_top(n), in_scope(d), !out_scope(d), doc(d, p, _), line(n, l).
pattern_1_target(s) :- field(a, "left", s), node(_, a, "assignment", _, _).
pattern_1_target(s) :- field(t, "value", s), node(_, t, "subscript", _, _), field(a, "left", t), node(_, a, "assignment", _, _).
violation("data-layer-dynamic-module-loading", "pattern-1", "DML001", p, l) :- node(d, n, "subscript", _, _), field(n, "value", c), node(_, c, "call", _, _), field(c, "function", f), node_text(f, "globals"), field(c, "arguments", g), node_text(g, t), match("\\(\\s*\\)", t), pattern_1_target(n), !pattern_in_tc(n), in_scope(d), !out_scope(d), doc(d, p, _), line(n, l).
pattern_site(n) :- field(c, "function", n), node(_, c, "call", _, _).
pattern_site(n) :- field(a, "attribute", n), node(_, a, "attribute", _, _), field(c, "function", a), node(_, c, "call", _, _).
pattern_site(n) :- field(f, "name", n), node(_, f, "function_definition", _, _).
violation("data-layer-dynamic-module-loading", "pattern-2", "DML001", p, l) :- node(d, n, "identifier", _, _), node_text(n, "__import__"), pattern_site(n), !pattern_in_tc(n), in_scope(d), !out_scope(d), doc(d, p, _), line(n, l).
pattern_layout_line(d, l) :- tape_line(d, l, sp), text(sp, s), match("(?s:.*)(?:(?:^def\\s+__getattr__\\s*\\()|(?:\\bglobals\\s*\\(\\s*\\)\\s*\\[.*\\]\\s*=)|(?:\\b__import__\\s*\\())(?s:.*)", s).
violation("data-layer-dynamic-module-loading", "pattern-3", "DML001", p, l) :- node(d, n, "call", _, _), field(n, "function", f), node(_, f, "attribute", _, _), node_text(f, s), suffix("importlib.import_module", s), !pattern_in_tc(n), line(n, l), !pattern_layout_line(d, l), in_scope(d), !out_scope(d), doc(d, p, _).
violation("data-layer-dynamic-module-loading", "pattern-4", "DML001", p, l) :- node(d, n, "identifier", _, _), node_text(n, "import_module"), pattern_site(n), !pattern_in_tc(n), line(n, l), !pattern_layout_line(d, l), in_scope(d), !out_scope(d), doc(d, p, _).
