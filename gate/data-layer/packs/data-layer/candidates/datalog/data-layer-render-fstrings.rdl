.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl strprefix(n: node, s: sym)
.input doc, node, child, strprefix
.kindset k0 = "function_definition"
.kindset k1 = "module"
.decl in_scope(d: int)
.decl m3(n: node)
.decl m6(n: node)
.decl out_scope(d: int)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/common/l2100_sql_grammar/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
m3($n) :- child($v2, $n, _), node(_, $v2, "concatenated_string", _, _).
m6($n) :- node(_, $n, "string", _, _), strprefix($n, $v1), @contains($v1, "f"), !m3($n).
m6($n) :- node(_, $n, "concatenated_string", _, _), child($n, $v4, _), node(_, $v4, "string", _, _), strprefix($v4, $v5), @contains($v5, "f").
m6($n) :- node(_, $n, "format_specifier", _, _).
.output violation
