cs_role_default("lifecycle", "l2000_connection/connection_lifecycle.py").
cs_role_default("sql", "impl/common/l2200_sql_dialect/sql_connection.py").
cs_role_key("connection", "/connectionPath").
cs_role_key("lifecycle", "/lifecyclePath").
cs_role_key("sql", "/sqlPath").
