option_value("entryPoint", "all").
option_value("parameters", "{}").
in_scope(d) :- doc(d, p, _), glob("l2000_connection/connection.py", p).
in_scope(d) :- doc(d, p, _), glob("l2000_connection/connection_lifecycle.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2200_sql_dialect/sql_connection.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/sqlite/connection.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/postgres/connection.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/mariadb/connection.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/mongodb/connection.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/neo4j/connection.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/conform/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.pytest_cache/**", p).
out_scope(d) :- doc(d, p, _), glob("**/node_modules/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/browser_build/**", p).
tape_syntax_error(d) :- syntax_error(d).
cs_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d).
cs_valid(d, p) :- cs_doc(d, p), node(d, _, "module", _, _), !tape_syntax_error(d).
cs_entry(e) :- option_value("entryPoint", e).
cs_class_mode("first") :- cs_entry(e), (e = "_connection_file_violations" ; e = "_sql_connection_violations").
cs_class_mode("every") :- cs_entry("_lifecycle_violations").
cs_class_mode("last") :- cs_entry(e), e != "_connection_file_violations", e != "_sql_connection_violations", e != "_lifecycle_violations".
cs_role_given(r, p) :- cs_role_key(r, ptr), option_json("parameters", ptr, p), p != "null".
cs_role_set(r) :- cs_role_given(r, _).
cs_role(r, p) :- cs_role_given(r, p).
cs_role(r, p) :- cs_role_default(r, p), !cs_role_set(r).
cs_metric_doc(d, p) :- cs_valid(d, p), cs_role(_, p).
cs_metric_doc(d, p) :- cs_valid(d, p), cs_big_backend(p).
cs_count_given(d, v) :- cs_metric_doc(d, p), e = @rx_replace(@rx_replace(p, "~", "~0"), "/", "~1"), ptr = @concat("/lineCounts/", e), option_json("parameters", ptr, v), v != "null".
cs_count_set(d) :- cs_count_given(d, _).
cs_over(d, 900) :- cs_count_given(d, v), match("0*(?:9(?:0[1-9]|[1-9][0-9])|[1-9][0-9]{3,})(?:\\.[0-9]*)?", v).
cs_over(d, 3000) :- cs_count_given(d, v), match("0*(?:3(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})|[4-9][0-9]{3}|[1-9][0-9]{4,})(?:\\.[0-9]*)?", v).
cs_over(d, 6000) :- cs_count_given(d, v), match("0*(?:6(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})|[7-9][0-9]{3}|[1-9][0-9]{4,})(?:\\.[0-9]*)?", v).
cs_over(d, 900) :- cs_metric_doc(d, _), !cs_count_set(d), line_count(d, k), k > 900.
cs_over(d, 3000) :- cs_metric_doc(d, _), !cs_count_set(d), line_count(d, k), k > 3000.
cs_over(d, 6000) :- cs_metric_doc(d, _), !cs_count_set(d), line_count(d, k), k > 6000.
cs_top(d, n, k, s) :- node(d, m, "module", _, _), child(m, n, _), cs_def(n, k, s).
cs_top(d, n, k, s) :- node(d, m, "module", _, _), child(m, dd, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", n), cs_def(n, k, s).
cs_def(n, "class", s) :- node(_, n, "class_definition", _, _), field(n, "name", x), text(x, s).
cs_def(n, "def", s) :- node(_, n, "function_definition", _, _), field(n, "name", x), text(x, s).
cs_top_start(d, k, s, st) :- cs_top(d, n, k, s), node(_, n, _, st, _).
cs_last_class(d, c, s) :- cs_class_mode("last"), cs_top(d, c, "class", s), node(_, c, _, st, _), st = max t : { cs_top_start(d, "class", s, t) }.
cs_last_class(d, c, s) :- cs_class_mode("first"), cs_top(d, c, "class", s), node(_, c, _, st, _), st = min t : { cs_top_start(d, "class", s, t) }.
cs_last_class(d, c, s) :- cs_class_mode("every"), cs_top(d, c, "class", s).
cs_first_class(d, c, s) :- cs_top(d, c, "class", s), node(_, c, _, st, _), st = min t : { cs_top_start(d, "class", s, t) }.
cs_base_slot(c, b) :- node(_, c, "class_definition", _, _), field(c, "superclasses", al), child(al, b, _), !node(_, b, "keyword_argument", _, _), !node(_, b, "dictionary_splat", _, _), !node(_, b, "comment", _, _).
cs_base_slot(c, x) :- cs_base_slot(c, b), node(_, b, "parenthesized_expression", _, _), child(b, x, _), !node(_, x, "comment", _, _).
cs_all_base(c, b) :- cs_base_slot(c, b), !node(_, b, "parenthesized_expression", _, _).
cs_base(c, b, s) :- cs_base_slot(c, b), node(_, b, "identifier", _, _), text(b, s).
cs_base(c, b, s) :- cs_base_slot(c, b), node(_, b, "attribute", _, _), field(b, "attribute", x), text(x, s).
cs_class_method(c, m, mn) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, m, _), cs_def(m, "def", mn).
cs_class_method(c, m, mn) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, dd, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", m), cs_def(m, "def", mn).
cs_method(d, c, cn, m, mn) :- cs_last_class(d, c, cn), cs_class_method(c, m, mn).
cs_method_start(c, mn, st) :- cs_class_method(c, m, mn), node(_, m, _, st, _).
cs_in_method(x, m) :- cs_method(_, _, _, m, _), inside(x, m, cs_fdef), node(_, x, _, _, _).
cs_in_method(x, m) :- cs_method(_, _, _, m, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", m), child(dd, dc, _), node(_, dc, "decorator", _, _), inside(x, dc, cs_decorator_kind), node(_, x, _, _, _).
cs_func(c, f) :- node(_, c, "call", _, _), field(c, "function", f).
cs_func(c, x) :- cs_func(c, f), node(_, f, "parenthesized_expression", _, _), child(f, x, _), !node(_, x, "comment", _, _).
cs_receiver(o, o) :- cs_func(_, f), node(_, f, "attribute", _, _), field(f, "object", o).
cs_receiver(o, x) :- cs_receiver(o, p), node(_, p, "parenthesized_expression", _, _), child(p, x, _), !node(_, x, "comment", _, _).
cs_self_connect_call(c) :- cs_func(c, f), node(_, f, "attribute", _, _), field(f, "attribute", a), text(a, s), (s = "connect" ; s = "connect_async"), field(f, "object", o), cs_receiver(o, r), node(_, r, "identifier", _, _), text(r, "self").
cs_self_connect(m) :- cs_self_connect_call(c), cs_in_method(c, m).
cs_target(m, t) :- cs_method(_, _, _, m, _), node(_, a, k, _, _), cs_assign_kind(k), inside(a, m, cs_fdef), field(a, "left", t).
cs_target(m, e) :- cs_target(m, t), node(_, t, k, _, _), cs_sequence(k), child(t, e, _), !node(_, e, "comment", _, _).
cs_sync_target(m) :- cs_target(m, t), node(_, t, "attribute", _, _), field(t, "object", o), node(_, o, "identifier", _, _), text(o, "self"), field(t, "attribute", x), text(x, s), (s = "_conn" ; s = "_cursor" ; s = "_introspector" ; s = "_validator").
cs_backend_class(s) :- cs_method(_, _, s, _, _), suffix("Connection", s).
cs_backend_class(s) :- cs_method(_, _, s, _, _), suffix("ConnectionCore", s).
cs_present(p) :- cs_doc(d, p), node(d, _, "module", _, _).
cs_lifecycle_file(p) :- cs_role("lifecycle", p), cs_present(p).
cs_lifecycle_file(p) :- cs_role("connection", p), cs_role("lifecycle", q), !cs_present(q).
cs_lifecycle_method_ok(d, m) :- cs_entry("_lifecycle_violations"), cs_first_class(d, c, "_ConnectionLifecycleMixin"), cs_method(d, c, _, m, mn), node(_, m, _, st, _), st = min t : { cs_method_start(c, mn, t) }.
cs_lifecycle_method_ok(d, m) :- cs_entry(e), e != "_lifecycle_violations", cs_method(d, _, _, m, _).
cs_hit(d, "CSB001", 1) :- cs_role("connection", p), cs_valid(d, p), cs_over(d, 900).
cs_hit(d, "CSB010", 1) :- cs_role("sql", p), cs_valid(d, p), cs_over(d, 6000).
cs_hit(d, "CSB020", 1) :- cs_valid(d, p), cs_big_backend(p), cs_over(d, 3000).
cs_hit(d, "CSB002", l) :- cs_role("connection", p), cs_valid(d, p), cs_top(d, n, _, s), cs_residual(s), line(n, l).
cs_hit(d, "CSB012", l) :- cs_role("sql", p), cs_valid(d, p), cs_top(d, n, _, s), cs_sql_residual(s), line(n, l).
cs_hit(d, "CSB021", l) :- cs_valid(d, p), cs_big_backend(p), cs_top(d, n, _, s), cs_mixin(s), line(n, l).
cs_hit(d, "CSB003", l) :- cs_role("connection", p), cs_valid(d, p), cs_last_class(d, c, "_DatabaseConnectionCore"), cs_base(c, _, s), !cs_good_base(s), line(c, l).
cs_hit(d, "CSB011", 1) :- cs_role("sql", p), cs_valid(d, p), k = count : { cs_top(d, _, _, _) }, k > 90.
cs_hit(d, "CSB013", l) :- cs_role("sql", p), cs_valid(d, p), cs_last_class(d, c, "_SqlConnectionCore"), cs_entry(e), e != "_sql_connection_violations", k = count : { cs_base(c, _, _) }, k > 6, line(c, l).
cs_hit(d, "CSB013", l) :- cs_role("sql", p), cs_valid(d, p), cs_last_class(d, c, "_SqlConnectionCore"), cs_entry("_sql_connection_violations"), k = count : { cs_all_base(c, _) }, k > 6, line(c, l).
cs_hit(d, "CSB030", l) :- cs_lifecycle_file(p), cs_valid(d, p), cs_method(d, _, "_ConnectionLifecycleMixin", m, mn), (mn = "__enter__" ; mn = "__aenter__"), cs_lifecycle_method_ok(d, m), cs_self_connect(m), line(m, l).
cs_hit(d, "CSB031", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, mn), cs_backend_class(cn), cs_lifecycle_method(mn), line(m, l).
cs_hit(d, "CSB032", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, "connect_async"), cs_backend_class(cn), cs_sync_target(m), line(m, l).
cs_hit(d, "CSB033", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, mn), cs_backend_class(cn), !cs_connect_method(mn), cs_self_connect(m), line(m, l).
violation("data-layer-connection-structural-boundaries", "connection-structure", code, p, l) :- cs_hit(d, code, l), cs_entry(e), !cs_entry_case(e), doc(d, p, _).
violation("data-layer-connection-structural-boundaries", "connection-structure", code, p, l) :- cs_hit(d, code, l), cs_entry(e), cs_entry_issue(e, code), doc(d, p, _).
