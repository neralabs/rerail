option_value("parameters", "{}").
in_scope(d) :- doc(d, p, _), glob("impl/common/l2065_plan_core/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l2066_plan_optimizer/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("docs/design/PLAN_OPTIMIZER_V2_INVARIANTS.md", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.pytest_cache/**", p).
optimizer_unparen(e, e) :- node(_, e, k, _, _), k != "parenthesized_expression".
optimizer_unparen(e, m) :- node(_, e, "parenthesized_expression", _, _), child(e, i, 0), optimizer_unparen(i, m).
optimizer_paren_pattern(x) :- node(_, x, "tuple_pattern", _, _), child(x, _, 0), !child(x, _, 1), node_text(x, s), !match("(?s:.*),(?s:\\s*)\\)", s).
optimizer_untarget(t, m) :- optimizer_unparen(t, m), !optimizer_paren_pattern(m).
optimizer_untarget(t, m) :- optimizer_unparen(t, x), optimizer_paren_pattern(x), child(x, i, 0), optimizer_untarget(i, m).
optimizer_form(n, "fstr") :- node(_, n, "string", _, _), child(n, s0, 0), node(_, s0, "string_start", _, _), node_text(s0, t), match("[rRbBuU]*[fF][rR]?[\"'].*", t).
optimizer_form(n, "bytes") :- node(_, n, "string", _, _), child(n, s0, 0), node(_, s0, "string_start", _, _), node_text(s0, t), match("[rR]?[bB][rR]?[\"'].*", t).
optimizer_form(n, "str") :- node(_, n, "string", _, _), child(n, s0, 0), node(_, s0, "string_start", _, _), node_text(s0, t), match("[rRuU]*[\"'].*", t).
optimizer_raw(n) :- node(_, n, "string", _, _), child(n, s0, 0), node(_, s0, "string_start", _, _), node_text(s0, t), match("[a-zA-Z]*[rR][a-zA-Z]*[\"'].*", t).
optimizer_part_of(s, c) :- node(_, c, "concatenated_string", _, _), child(c, s, _), node(_, s, "string", _, _).
optimizer_fstr(n) :- optimizer_form(n, "fstr"), !optimizer_part_of(n, _).
optimizer_fstr(c) :- optimizer_part_of(s, c), optimizer_form(s, "fstr").
optimizer_has_nonstr(c) :- optimizer_part_of(s, c), !optimizer_form(s, "str").
optimizer_parts(c, k) :- node(_, c, "concatenated_string", _, _), !optimizer_has_nonstr(c), k = count : { child(c, _, _) }.
optimizer_part(c, i, v) :- optimizer_parts(c, _), child(c, s, i), str(s, v).
optimizer_str_const(n, v) :- optimizer_form(n, "str"), !optimizer_part_of(n, _), str(n, v).
optimizer_str_const(c, @concat(a, b)) :- optimizer_parts(c, 2), optimizer_part(c, 0, a), optimizer_part(c, 1, b).
optimizer_str_const(c, @concat(@concat(a, b), e)) :- optimizer_parts(c, 3), optimizer_part(c, 0, a), optimizer_part(c, 1, b), optimizer_part(c, 2, e).
optimizer_str_const(c, @concat(@concat(a, b), @concat(e, g))) :- optimizer_parts(c, 4), optimizer_part(c, 0, a), optimizer_part(c, 1, b), optimizer_part(c, 2, e), optimizer_part(c, 3, g).
optimizer_str_tail(c, @concat(@concat(a, b), @concat(e, g))) :- optimizer_parts(c, k), k > 4, i0 = @sub(k, 4), i1 = @sub(k, 3), i2 = @sub(k, 2), i3 = @sub(k, 1), optimizer_part(c, i0, a), optimizer_part(c, i1, b), optimizer_part(c, i2, e), optimizer_part(c, i3, g).
optimizer_str_any(n) :- optimizer_str_const(n, _).
optimizer_str_any(c) :- optimizer_parts(c, _).
optimizer_fpiece(n, c, v) :- optimizer_fstr(n), node(_, n, "string", _, _), child(n, c, _), node(_, c, "string_content", _, _), node_text(c, v).
optimizer_fpiece(j, c, v) :- optimizer_fstr(j), optimizer_part_of(s, j), optimizer_form(s, "fstr"), child(s, c, _), node(_, c, "string_content", _, _), node_text(c, v).
optimizer_fpiece(j, s, v) :- optimizer_fstr(j), optimizer_part_of(s, j), optimizer_form(s, "str"), str(s, v).
optimizer_not_name(n) :- field(p, "attribute", n), node(_, p, "attribute", _, _).
optimizer_not_name(n) :- field(p, "name", n), !node(_, p, "named_expression", _, _).
optimizer_not_name(n) :- node(_, n, "identifier", _, _), inside(n, _, optimizer_import_kinds).
optimizer_not_name(n) :- child(p, n, _), optimizer_param_lists(k), node(_, p, k, _, _).
optimizer_not_name(n) :- child(p, n, 0), node(_, p, "typed_parameter", _, _).
optimizer_not_name(n) :- child(s, n, 0), node(_, s, "list_splat_pattern", _, _), child(p, s, _), optimizer_param_lists(k), node(_, p, k, _, _).
optimizer_not_name(n) :- child(s, n, 0), node(_, s, "list_splat_pattern", _, _), child(p, s, _), node(_, p, "typed_parameter", _, _).
optimizer_not_name(n) :- child(s, n, 0), node(_, s, "dictionary_splat_pattern", _, _), child(p, s, _), optimizer_param_lists(k), node(_, p, k, _, _).
optimizer_not_name(n) :- child(s, n, 0), node(_, s, "dictionary_splat_pattern", _, _), child(p, s, _), node(_, p, "typed_parameter", _, _).
optimizer_not_name(n) :- child(g, n, _), node(_, g, "global_statement", _, _).
optimizer_not_name(n) :- child(g, n, _), node(_, g, "nonlocal_statement", _, _).
optimizer_not_name(n) :- node(_, x, "except_clause", _, _), child(x, ap, _), node(_, ap, "as_pattern", _, _), field(ap, "alias", t), child(t, n, _).
optimizer_name(n, x) :- node(_, n, "identifier", _, _), text(n, x), !optimizer_not_name(n).
optimizer_callee_name(c, x) :- node(_, c, "call", _, _), field(c, "function", f), optimizer_unparen(f, i), node(_, i, "identifier", _, _), text(i, x).
optimizer_callee_attr(c, x) :- node(_, c, "call", _, _), field(c, "function", f), optimizer_unparen(f, a), node(_, a, "attribute", _, _), field(a, "attribute", i), text(i, x).
optimizer_attr(a, x) :- node(_, a, "attribute", _, _), field(a, "attribute", i), text(i, x).
optimizer_posarg(c, a, j) :- node(_, c, "call", _, _), field(c, "arguments", al), node(_, al, "argument_list", _, _), child(al, a, j), !node(_, a, "keyword_argument", _, _), !node(_, a, "dictionary_splat", _, _).
optimizer_arg0(c, m) :- optimizer_posarg(c, a, j), j = min k : { optimizer_posarg(c, _, k) }, optimizer_unparen(a, m).
optimizer_stmt(a, st) :- node(_, st, "expression_statement", _, _), child(st, a, 0), node(_, a, "assignment", _, _).
optimizer_chain(a, a) :- optimizer_stmt(a, _).
optimizer_chain(a, b) :- optimizer_chain(a, x), field(x, "right", b), node(_, b, "assignment", _, _).
optimizer_target(a, t) :- optimizer_chain(a, x), field(x, "left", t).
optimizer_value(a, v) :- optimizer_chain(a, x), field(x, "right", v), !node(_, v, "assignment", _, _).
optimizer_ann(a) :- optimizer_stmt(a, _), field(a, "type", _).
ofc_in_def(n, f) :- inside(n, f, rr_kind_function_definition).
ofc_in_def(n, f) :- inside(n, dd, rr_kind_decorated_definition), field(dd, "definition", f), node(_, f, "function_definition", _, _).
ofc_file(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d).
ofc_base(d, "scope.py") :- ofc_file(d, p), p = "scope.py".
ofc_base(d, "scope.py") :- ofc_file(d, p), suffix("/scope.py", p).
ofc_base(d, "adapter.py") :- ofc_file(d, p), p = "adapter.py".
ofc_base(d, "adapter.py") :- ofc_file(d, p), suffix("/adapter.py", p).
ofc_base(d, "effects.py") :- ofc_file(d, p), p = "effects.py".
ofc_base(d, "effects.py") :- ofc_file(d, p), suffix("/effects.py", p).
ofc_base(d, "passes.py") :- ofc_file(d, p), p = "passes.py".
ofc_base(d, "passes.py") :- ofc_file(d, p), suffix("/passes.py", p).
ofc_core(d) :- ofc_file(d, p), match("(?:.*/)?l2065_plan_core/.*", p).
ofc_at(n, d, p, l) :- node(d, n, _, _, _), ofc_file(d, p), line(n, l).
ofc_import(n, m) :- node(_, n, "import_statement", _, _), field(n, "name", c), node(_, c, "dotted_name", _, _), text(c, m).
ofc_import(n, m) :- node(_, n, "import_statement", _, _), field(n, "name", c), node(_, c, "aliased_import", _, _), field(c, "name", dn), text(dn, m).
ofc_import(n, m) :- node(_, n, "import_from_statement", _, _), field(n, "module_name", dn), node(_, dn, "dotted_name", _, _), text(dn, m).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-001", p, l) :- ofc_import(n, m), match("(?:os|io|socket|subprocess|sqlite3|asyncio|threading|multiprocessing|urllib|http)(?:\\..*)?", m), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-002", p, l) :- ofc_import(n, m), match("(?:l2070_batching|impl\\.common\\.l2070_server_plan|impl\\.common\\.l2100_sql_grammar|impl\\.common\\.l2066_plan_optimizer)(?:\\..*)?", m), ofc_at(n, d, p, l), ofc_core(d).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-003", p, l) :- ofc_import(n, m), match("(?:l2070_batching|impl\\.common\\.l2070_server_plan|impl\\.common\\.l2100_sql_grammar)(?:\\..*)?", m), ofc_at(n, d, p, l), !ofc_core(d), !ofc_base(d, "adapter.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-010", p, l) :- optimizer_attr(n, x), (x = "_bindings" ; x = "_exports"), ofc_at(n, d, p, l), !ofc_base(d, "scope.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-011", p, l) :- optimizer_callee_attr(n, x), (x = "partition" ; x = "rpartition" ; x = "rsplit" ; x = "split"), optimizer_arg0(n, a), optimizer_str_const(a, "."), ofc_at(n, d, p, l), !ofc_base(d, "scope.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-012", p, l) :- optimizer_target(_, t), optimizer_untarget(t, n), node(_, n, "identifier", _, _), text(n, x), suffix("_by_table", x), ofc_at(n, _, p, l).
ofc_plain_param(f, p) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "identifier", _, _).
ofc_plain_param(f, nm) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_parameter", _, _), child(p, nm, 0), node(_, nm, "identifier", _, _).
ofc_plain_param(f, nm) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "default_parameter", _, _), field(p, "name", nm).
ofc_plain_param(f, nm) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_default_parameter", _, _), field(p, "name", nm).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-012", p, l) :- ofc_plain_param(_, n), text(n, x), suffix("_by_table", x), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-020", p, l) :- node(_, n, "comparison_operator", _, _), child(n, o, _), optimizer_unparen(o, k), optimizer_str_const(k, v), (v = "count" ; v = "count_only" ; v = "exists"), ofc_at(n, d, p, l), !ofc_base(d, "adapter.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-021", p, l) :- optimizer_str_const(n, v), suffix("_count", v), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-021", p, l) :- optimizer_str_tail(n, v), suffix("_count", v), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-021", p, l) :- optimizer_fpiece(_, c, v), suffix("_count", v), ofc_at(c, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-021", p, l) :- optimizer_fpiece(j, _, v), suffix("_count", v), ofc_at(j, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-022", p, l) :- node(_, n, "binary_operator", _, _), op(n, "&"), field(n, "left", o), optimizer_unparen(o, c), optimizer_callee_name(c, x), (x = "set" ; x = "frozenset"), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-022", p, l) :- node(_, n, "binary_operator", _, _), op(n, "&"), field(n, "right", o), optimizer_unparen(o, c), optimizer_callee_name(c, x), (x = "set" ; x = "frozenset"), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-022", p, l) :- optimizer_callee_attr(n, "intersection"), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-023", p, l) :- optimizer_callee_name(n, "ColumnSchema"), optimizer_arg0(n, a), optimizer_str_any(a), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-030", p, l) :- optimizer_name(n, x), ofc_introspection(x), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-030", p, l) :- optimizer_attr(n, x), ofc_introspection(x), ofc_at(n, _, p, l).
ofc_piece(s, v) :- optimizer_form(s, "str"), str(s, v).
ofc_piece(c, v) :- optimizer_form(s, "fstr"), child(s, c, _), node(_, c, "string_content", _, _), node_text(c, v).
ofc_piece_raw(s) :- ofc_piece(s, _), optimizer_raw(s).
ofc_piece_raw(c) :- ofc_piece(c, _), node(_, c, "string_content", _, _), child(s, c, _), optimizer_raw(s).
ofc_hint_piece(s) :- ofc_piece(s, v), ofc_piece_raw(s), match("(?s:.*)(?:\\b(?:Fix|Use|Add|Publish|Call|Bind|Project|Split|Map|Cast|Rename|Remove|Inspect|Wrap|Keep)\\b)(?s:.*)", v).
ofc_hint_piece(s) :- ofc_piece(s, v), !ofc_piece_raw(s), match("(?s:.*)(?:(?:\\b|\\\\[abfnrtv])(?:Fix|Use|Add|Publish|Call|Bind|Project|Split|Map|Cast|Rename|Remove|Inspect|Wrap|Keep)\\b)(?s:.*)", v).
ofc_hinted(f) :- ofc_hint_piece(s), ofc_in_def(s, f).
ofc_raise_exc(r, m) :- node(_, r, "raise_statement", _, _), child(r, e, _), !field(r, "cause", e), optimizer_unparen(e, m).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-031", p, l) :- ofc_raise_exc(n, e), !node(_, e, "identifier", _, _), nearest(n, f, rr_kind_function_definition), !ofc_hinted(f), ofc_at(n, _, p, l).
ofc_def_name(f, x) :- node(_, f, "function_definition", _, _), !op(f, "async"), field(f, "name", nm), text(nm, x).
ofc_not_legality_home(d) :- ofc_file(d, _), !ofc_base(d, "effects.py"), !ofc_base(d, "adapter.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :- ofc_def_name(n, x), (x = "can_share_statement_after" ; x = "conflicts_with" ; x = "placement_after" ; x = "repeated_write_keys"), ofc_at(n, d, p, l), ofc_not_legality_home(d).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :- optimizer_attr(n, x), ofc_legality_fact(x), ofc_at(n, d, p, l), ofc_not_legality_home(d).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :- optimizer_callee_attr(n, "can_share_statement_after"), ofc_at(n, d, p, l), ofc_not_legality_home(d).
ofc_lf(d, k) :- ofc_file(d, _), k = count : { src_line_lf(d, _, _) }.
ofc_ends_lf(d) :- ofc_file(d, _), source(d, sp), text(sp, s), suffix("\n", s).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-044", p, 1) :- ofc_lf(d, k), k > 600, ofc_file(d, p).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-044", p, 1) :- ofc_lf(d, 600), ofc_ends_lf(d), ofc_file(d, p).
ofc_in_init(n) :- inside(n, f, rr_kind_function_definition), field(f, "name", nm), text(nm, x), (x = "__init__" ; x = "__post_init__").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-042", p, l) :- optimizer_stmt(n, _), !optimizer_ann(n), field(n, "left", t), optimizer_untarget(t, a), node(_, a, "attribute", _, _), !ofc_in_init(n), ofc_at(n, _, p, l).
ofc_top(s, s) :- node(_, m, "module", _, _), child(m, s, _).
ofc_top(s, x) :- node(_, m, "module", _, _), child(m, s, _), node(_, s, "decorated_definition", _, _), field(s, "definition", x).
ofc_protocol_base(c) :- field(c, "superclasses", al), child(al, b, _), optimizer_unparen(b, k), node(_, k, "identifier", _, _), text(k, "Protocol").
ofc_protocol_base(c) :- field(c, "superclasses", al), child(al, b, _), optimizer_unparen(b, k), optimizer_attr(k, "Protocol").
ofc_pass_class(c, x, st) :- ofc_top(s, c), node(_, c, "class_definition", _, _), field(c, "name", nm), text(nm, x), suffix("Pass", x), !ofc_protocol_base(c), node(_, s, _, st, _).
ofc_class_ann(c, a, x, st) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _), optimizer_stmt(a, s), optimizer_ann(a), field(a, "left", t), node(_, t, "identifier", _, _), text(t, x), node(_, a, _, st, _).
ofc_phase_decl(c, st, v) :- ofc_class_ann(c, a, "phase", st), field(a, "right", r), optimizer_unparen(r, k), optimizer_attr(k, v).
ofc_declared_phase(c, v) :- ofc_pass_class(c, _, _), s = min t : { ofc_phase_decl(c, t, _) }, ofc_phase_decl(c, s, v).
ofc_has_phase(c) :- ofc_phase_decl(c, _, _).
ofc_has_name(c) :- ofc_class_ann(c, _, "name", _).
ofc_has_run(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _), ofc_def_name(s, "run").
ofc_has_run(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _), node(_, s, "decorated_definition", _, _), field(s, "definition", f), ofc_def_name(f, "run").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-040", p, l) :- ofc_pass_class(n, _, _), !ofc_has_phase(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-040", p, l) :- ofc_pass_class(n, _, _), !ofc_has_name(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-040", p, l) :- ofc_pass_class(n, _, _), !ofc_has_run(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").
ofc_pipeline(a, tup, ts) :- node(_, m, "module", _, _), child(m, s, _), optimizer_stmt(a, s), field(a, "left", t), node(_, t, "identifier", _, _), text(t, "DEFAULT_V2_PASSES"), optimizer_value(a, v), optimizer_unparen(v, tup), node(_, tup, "tuple", ts, _).
ofc_pipeline(a, tup, ts) :- node(_, m, "module", _, _), child(m, s, _), optimizer_stmt(a, s), field(a, "left", t), node(_, t, "identifier", _, _), text(t, "DEFAULT_V2_PASSES"), optimizer_value(a, v), optimizer_unparen(v, tup), node(_, tup, "expression_list", ts, _).
ofc_entry(a, i, x, ts) :- ofc_pipeline(a, tup, ts), child(tup, e, i), optimizer_unparen(e, c), optimizer_callee_name(c, x).
ofc_before(a, i, c, t) :- ofc_entry(a, i, x, ts), node(d, a, _, _, _), ofc_pass_class(c, x, t), node(d, c, _, _, _), t < ts.
ofc_entry_phase(a, i, r) :- ofc_entry(a, i, _, _), s = max t : { ofc_before(a, i, _, t) }, ofc_before(a, i, c, s), ofc_declared_phase(c, v), ofc_phase_rank(v, r).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-041", p, l) :- ofc_entry_phase(n, i, r), ofc_entry_phase(n, j, q), i < j, q < r, ofc_at(n, d, p, l), ofc_base(d, "passes.py").
ofc_has_verifier(f) :- optimizer_name(v, "PlanVerifier"), ofc_in_def(v, f).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-043", p, l) :- ofc_top(_, n), ofc_def_name(n, "run_verified_passes"), !ofc_has_verifier(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").
oir_verifier(d) :- doc(d, "impl/common/l2065_plan_core/verifier.py", _), in_scope(d), !out_scope(d), !syntax_error(d).
oir_doc(d) :- doc(d, "docs/design/PLAN_OPTIMIZER_V2_INVARIANTS.md", _), in_scope(d), !out_scope(d).
oir_doc_present(1) :- oir_doc(_).
oir_registered(n, v) :- optimizer_callee_name(n, "OptimizerInvariant"), node(d, n, _, _, _), oir_verifier(d), field(n, "arguments", al), child(al, kw, _), node(_, kw, "keyword_argument", _, _), field(kw, "name", k), text(k, "code"), field(kw, "value", e), optimizer_unparen(e, c), optimizer_str_const(c, v).
oir_code(v) :- oir_registered(_, v).
oir_line(sp, s) :- oir_doc(d), src_line_lf(d, _, sp), text(sp, s), contains("`", s).
oir_num(i) :- oir_digit(a), oir_digit(b), oir_digit(c), oir_digit(e), i = @add(@add(@add(@mul(a, 1000), @mul(b, 100)), @mul(c, 10)), e).
oir_bt(sp, i) :- oir_line(sp, s), oir_num(i), i < @strlen(s), @substr(s, i, 1) = "`".
oir_after(sp, i, k) :- oir_bt(sp, i), oir_bt(sp, k), k > i.
oir_next(sp, i, j) :- oir_bt(sp, i), j = min k : { oir_after(sp, i, k) }.
oir_code_at(sp, i, c) :- oir_next(sp, i, j), oir_line(sp, s), c = @substr(s, @add(i, 1), @sub(@sub(j, i), 1)), match("(?:scope|schema|effects|cardinality|rewrite)\\.[a-z_0-9]+", c).
oir_is_code(sp, i) :- oir_code_at(sp, i, _).
oir_first(sp, i) :- oir_line(sp, _), i = min k : { oir_bt(sp, k) }.
oir_m(sp, i) :- oir_first(sp, i), oir_is_code(sp, i).
oir_nm(sp, i) :- oir_first(sp, i), !oir_is_code(sp, i).
oir_m(sp, j) :- oir_nm(sp, i), oir_next(sp, i, j), oir_is_code(sp, j).
oir_nm(sp, j) :- oir_nm(sp, i), oir_next(sp, i, j), !oir_is_code(sp, j).
oir_nm(sp, j) :- oir_m(sp, i), oir_next(sp, i, j).
oir_doc_code(c) :- oir_m(sp, i), oir_code_at(sp, i, c).
oir_cited(v) :- oir_code(v), oir_verifier(d), source(d, sp), text(sp, s), contains(@concat("(", @concat(v, ")")), s).
oir_at(n, p, l) :- node(d, n, _, _, _), oir_verifier(d), doc(d, p, _), line(n, l).
oir_mode("gated") :- option_value("entryPoint", e), e != "scan_file", e != "find_violations".
oir_mode("ungated") :- option_value("entryPoint", "find_violations").
oir_run(1) :- oir_mode("gated"), oir_verifier(_).
oir_run(1) :- oir_mode("ungated").
oir_any(1) :- oir_mode(_).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-050", p, l) :- oir_any(1), oir_registered(n, v), oir_doc_present(1), !oir_doc_code(v), oir_at(n, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-052", p, l) :- oir_any(1), oir_registered(n, v), oir_doc_present(1), !oir_cited(v), oir_at(n, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-050", "docs/design/PLAN_OPTIMIZER_V2_INVARIANTS.md", 1) :- oir_run(1), !oir_doc_present(1).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-051", p, 1) :- oir_run(1), oir_doc_code(c), !oir_code(c), oir_doc(d), doc(d, p, _).
