-𞓹𞟠-𞟦𞟨-𞟫𞟭-𞟮𞟰-𞟾𞠀-𞣄𞣇-𞣏𞤀-𞥃𞥋𞥐-𞥙𞱱-𞲫𞲭-𞲯𞲱-𞲴𞴁-𞴭𞴯-𞴽𞸀-𞸃𞸅-𞸟𞸡-𞸢𞸤𞸧𞸩-𞸲𞸴-𞸷𞸹𞸻𞹂𞹇𞹉𞹋𞹍-𞹏𞹑-𞹒𞹔𞹗𞹙𞹛𞹝𞹟𞹡-𞹢𞹤𞹧-𞹪𞹬-𞹲𞹴-𞹷𞹹-𞹼𞹾𞺀-𞺉𞺋-𞺛𞺡-𞺣𞺥-𞺩𞺫-𞺻🄀-🄌🯰-🯹𠀀-𪛟𪜀-𫜹𫝀-𫠝𫠠-𬺡𬺰-𮯠𮯰-𮹝丽-𪘀𰀀-𱍊𱍐-𲎯]))(?s:.*)", v).
ofc_hinted(f) :- ofc_hint_piece(s), ofc_in_def(s, f).
ofc_raise_exc(r, m) :- node(_, r, "raise_statement", _, _), child(r, e, _), !field(r, "cause", e), optimizer_unparen(e, m).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-031", p, l) :- ofc_raise_exc(n, e), !node(_, e, "identifier", _, _), nearest(n, f, rr_kind_function_definition), !ofc_hinted(f), ofc_at(n, _, p, l).
ofc_def_name(f, x) :- node(_, f, "function_definition", _, _), !op(f, "async"), field(f, "name", nm), text(nm, x).
ofc_not_legality_home(d) :- ofc_file(d, _), !ofc_base(d, "effects.py"), !ofc_base(d, "adapter.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :- ofc_def_name(n, x), (x = "can_share_statement_after" ; x = "conflicts_with" ; x = "placement_after" ; x = "repeated_write_keys"), ofc_at(n, d, p, l), ofc_not_legality_home(d).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :- optimizer_attr(n, x), ofc_legality_fact(x), ofc_at(n, d, p, l), ofc_not_legality_home(d).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :- optimizer_callee_attr(n, "can_share_statement_after"), ofc_at(n, d, p, l), ofc_not_legality_home(d).
ofc_lf(d, k) :- option_value("entryPoint", "scan_file"), ofc_file(d, _), k = count : { src_line_lf(d, _, _) }.
ofc_ends_lf(d) :- ofc_file(d, _), source(d, sp), text(sp, s), suffix("\n", s).
ofc_tape_lines(d, k) :- !option_value("entryPoint", "scan_file"), ofc_file(d, _), k = count : { tape_line(d, _, _) }.
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-044", p, 1) :- ofc_lf(d, k), k > 600, ofc_file(d, p).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-044", p, 1) :- ofc_lf(d, 600), ofc_ends_lf(d), ofc_file(d, p).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-044", p, 1) :- ofc_tape_lines(d, k), k > 600, ofc_file(d, p).
ofc_in_init(n) :- inside(n, f, rr_kind_function_definition), field(f, "name", nm), text(nm, x), (x = "__init__" ; x = "__post_init__").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-042", p, l) :- optimizer_stmt(n, _), !optimizer_ann(n), field(n, "left", t), optimizer_untarget(t, a), node(_, a, "attribute", _, _), !ofc_in_init(n), ofc_at(n, _, p, l).
ofc_top(s, s) :- node(_, m, "module", _, _), child(m, s, _).
ofc_top(s, x) :- node(_, m, "module", _, _), child(m, s, _), node(_, s, "decorated_definition", _, _), field(s, "definition", x).
ofc_protocol_base(c) :- field(c, "superclasses", al), child(al, b, _), optimizer_unparen(b, k), node(_, k, "identifier", _, _), text(k, "Protocol").
ofc_protocol_base(c) :- field(c, "superclasses", al), child(al, b, _), optimizer_unparen(b, k), optimizer_attr(k, "Protocol").
ofc_pass_class(c, x, st) :- ofc_top(s, c), node(_, c, "class_definition", _, _), field(c, "name", nm), text(nm, x), suffix("Pass", x), !ofc_protocol_base(c), node(_, s, _, st, _).
ofc_class_ann(c, a, x, st) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _), optimizer_stmt(a, s), optimizer_ann(a), field(a, "left", t), node(_, t, "identifier", _, _), text(t, x), node(_, a, _, st, _).
ofc_phase_decl(c, st, v) :- ofc_class_ann(c, a, "phase", st), field(a, "right", r), optimizer_unparen(r, k), optimizer_attr(k, v).
ofc_declared_phase(c, v) :- ofc_pass_class(c, _, _), s = min t : { ofc_phase_decl(c, t, _) }, ofc_phase_decl(c, s, v).
ofc_has_phase(c) :- ofc_phase_decl(c, _, _).
ofc_has_name(c) :- ofc_class_ann(c, _, "name", _).
ofc_has_run(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _), ofc_def_name(s, "run").
ofc_has_run(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _), node(_, s, "decorated_definition", _, _), field(s, "definition", f), ofc_def_name(f, "run").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-040", p, l) :- ofc_pass_class(n, _, _), !ofc_has_phase(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-040", p, l) :- ofc_pass_class(n, _, _), !ofc_has_name(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-040", p, l) :- ofc_pass_class(n, _, _), !ofc_has_run(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").
ofc_pipeline(a, tup, ts) :- node(_, m, "module", _, _), child(m, s, _), optimizer_stmt(a, s), field(a, "left", t), node(_, t, "identifier", _, _), text(t, "DEFAULT_V2_PASSES"), optimizer_value(a, v), optimizer_unparen(v, tup), node(_, tup, "tuple", ts, _).
ofc_pipeline(a, tup, ts) :- node(_, m, "module", _, _), child(m, s, _), optimizer_stmt(a, s), field(a, "left", t), node(_, t, "identifier", _, _), text(t, "DEFAULT_V2_PASSES"), optimizer_value(a, v), optimizer_unparen(v, tup), node(_, tup, "expression_list", ts, _).
ofc_entry(a, i, x, ts) :- ofc_pipeline(a, tup, ts), child(tup, e, i), optimizer_unparen(e, c), optimizer_callee_name(c, x).
ofc_before(a, i, c, t) :- ofc_entry(a, i, x, ts), node(d, a, _, _, _), ofc_pass_class(c, x, t), node(d, c, _, _, _), t < ts.
ofc_entry_phase(a, i, r) :- ofc_entry(a, i, _, _), s = max t : { ofc_before(a, i, _, t) }, ofc_before(a, i, c, s), ofc_declared_phase(c, v), ofc_phase_rank(v, r).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-041", p, l) :- ofc_entry_phase(n, i, r), ofc_entry_phase(n, j, q), i < j, q < r, ofc_at(n, d, p, l), ofc_base(d, "passes.py").
ofc_has_verifier(f) :- optimizer_name(v, "PlanVerifier"), ofc_in_def(v, f).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-043", p, l) :- ofc_top(_, n), ofc_def_name(n, "run_verified_passes"), !ofc_has_verifier(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").
oir_verifier(d) :- doc(d, "impl/common/l2065_plan_core/verifier.py", _), in_scope(d), !out_scope(d), !tape_syntax_error(d), !cpython_syntax_error(d, _, _).
oir_verifier_text(d) :- doc(d, "impl/common/l2065_plan_core/verifier.py", _), in_scope(d), !out_scope(d).
oir_doc(d) :- doc(d, "docs/design/PLAN_OPTIMIZER_V2_INVARIANTS.md", _), in_scope(d), !out_scope(d).
oir_registered(n, v) :- optimizer_callee_name(n, "OptimizerInvariant"), node(d, n, _, _, _), oir_verifier(d), field(n, "arguments", al), child(al, kw, _), node(_, kw, "keyword_argument", _, _), field(kw, "name", k), text(k, "code"), field(kw, "value", e), optimizer_unparen(e, c), optimizer_str_const(c, v).
oir_code(v) :- oir_registered(_, v).
oir_doc_code(c) :- oir_doc(d), source(d, sp), match_group("`(?P<CODE>(?:scope|schema|effects|cardinality|rewrite)\\.[a-z_0-9]+)`", sp, _, "CODE", g), text(g, c).
oir_cited(v) :- oir_code(v), oir_verifier(d), source(d, sp), text(sp, s), contains(@concat("(", @concat(v, ")")), s).
oir_at(n, p, l) :- node(d, n, _, _, _), oir_verifier(d), doc(d, p, _), line(n, l).
oir_mode("gated") :- option_value("entryPoint", e), e != "scan_file", e != "find_violations".
oir_mode("ungated") :- option_value("entryPoint", "find_violations").
oir_run(1) :- oir_mode("gated"), oir_verifier_text(_).
oir_run(1) :- oir_mode("ungated").
oir_any(1) :- oir_mode(_).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-050", p, l) :- oir_any(1), oir_registered(n, v), oir_doc(_), !oir_doc_code(v), oir_at(n, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-052", p, l) :- oir_any(1), oir_registered(n, v), oir_doc(_), !oir_cited(v), oir_at(n, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-050", "docs/design/PLAN_OPTIMIZER_V2_INVARIANTS.md", 1) :- oir_run(1), !oir_doc(_).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-051", p, 1) :- oir_run(1), oir_doc_code(c), !oir_code(c), oir_doc(d), doc(d, p, _).
