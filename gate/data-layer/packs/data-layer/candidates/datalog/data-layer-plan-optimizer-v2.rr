.decl oir_code_at(sp: node, i: number, c: symbol)
.decl oir_digit(x: number)
.decl oir_doc(d: number)
.decl oir_doc_code(c: symbol)
.decl oir_doc_present(k: number)
.decl oir_first(sp: node, i: number)
.decl oir_is_code(sp: node, i: number)
