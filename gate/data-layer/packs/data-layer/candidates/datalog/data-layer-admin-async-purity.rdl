.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl text(n: node, s: sym)
.decl name(n: node, s: sym)
.decl line(n: node, l: int)
.input doc, node, text, name, line
.decl in_scope(d: int)
.decl out_scope(d: int)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "l8000_admin/tools/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/*test_*").
violation("data-layer-admin-async-purity", "pattern-0", "AAP001", $p, $l) :- node(_, $n, "attribute", _, _), name($n, $v1), @glob($v1, {"*.asyncio.to_thread", "asyncio.to_thread"}), node($d, $n, _, _, _), in_scope($d), !out_scope($d), doc($d, $p, _), line($n, $l).
violation("data-layer-admin-async-purity", "pattern-1", "AAP001", $p, $l) :- node(_, $n, "identifier", _, _), text($n, $v2), $v2 = "run_in_executor", node($d, $n, _, _, _), in_scope($d), !out_scope($d), doc($d, $p, _), line($n, $l).
violation("data-layer-admin-async-purity", "pattern-2", "AAP001", $p, $l) :- node(_, $n, "identifier", _, _), text($n, $v3), $v3 = "disable_sync_in_async_check", node($d, $n, _, _, _), in_scope($d), !out_scope($d), doc($d, $p, _), line($n, $l).
.output violation
