.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl field(p: node, f: symbol, c: node)
.input doc, node, field
.decl in_scope(d: number)
.decl m10(n: node)
.decl m11(n: node)
.decl m19(n: node)
.decl m20(n: node)
.decl m28(n: node)
.decl m29(n: node)
.decl m37(n: node)
.decl m38(n: node)
.decl m46(n: node)
.decl m47(n: node)
.decl m55(n: node)
