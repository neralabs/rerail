usage_8_current(d, n) :- usage_8_hit(d, n), esc_doc(d), !usage_8_earlier(n).
esc_found("forbidden-class", p, l) :- forbidden_class_hit(d, n), doc(d, p, _), line(n, l).
esc_found("unsafe-parameter", p, l) :- unsafe_group(d, l, _), doc(d, p, _).
esc_found("usage-0", p, l) :- usage_0_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-1", p, l) :- usage_1_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-2", p, l) :- usage_2_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-3", p, l) :- usage_3_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-4", p, l) :- usage_4_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-5", p, l) :- usage_5_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-6", p, l) :- usage_6_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-7", p, l) :- usage_7_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-8", p, l) :- usage_8_current(d, n), doc(d, p, _), line(n, l).
esc_usage_witness("usage-0", n) :- usage_0_current(_, n).
esc_usage_witness("usage-1", n) :- usage_1_current(_, n).
esc_usage_witness("usage-2", n) :- usage_2_current(_, n).
esc_usage_witness("usage-3", n) :- usage_3_current(_, n).
esc_usage_witness("usage-4", n) :- usage_4_current(_, n).
esc_usage_witness("usage-5", n) :- usage_5_current(_, n).
esc_usage_witness("usage-6", n) :- usage_6_current(_, n).
esc_usage_witness("usage-7", n) :- usage_7_current(_, n).
esc_usage_witness("usage-8", n) :- usage_8_current(_, n).
esc_n_class(k) :- report_when_gt(_), k = count : { forbidden_class_hit(_, _) }.
esc_n_param(k) :- report_when_gt(_), k = count : { unsafe_group(_, _, _) }.
esc_n_usage(k) :- report_when_gt(_), k = count : { esc_usage_witness(_, _) }.
esc_report(1) :- esc_found(_, _, _), !report_when_gt(_).
esc_report(1) :- report_when_gt(g), esc_n_class(a), esc_n_param(b), esc_n_usage(c), k = @add(@add(a, b), c), k > g.
violation("data-layer-sql-grammar-escape-hatches", "forbidden-class", "escape_hatch", p, l) :- esc_found("forbidden-class", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "unsafe-parameter", "escape_hatch", p, l) :- esc_found("unsafe-parameter", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-0", "escape_hatch", p, l) :- esc_found("usage-0", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-1", "escape_hatch", p, l) :- esc_found("usage-1", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-2", "escape_hatch", p, l) :- esc_found("usage-2", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-3", "escape_hatch", p, l) :- esc_found("usage-3", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-4", "escape_hatch", p, l) :- esc_found("usage-4", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-5", "escape_hatch", p, l) :- esc_found("usage-5", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-6", "escape_hatch", p, l) :- esc_found("usage-6", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-7", "escape_hatch", p, l) :- esc_found("usage-7", p, l), esc_report(1).
violation("data-layer-sql-grammar-escape-hatches", "usage-8", "escape_hatch", p, l) :- esc_found("usage-8", p, l), esc_report(1).
