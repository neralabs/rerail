in_scope(d) :- doc(d, p, _), glob("api/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
tape_syntax_error(d) :- syntax_error(d).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlRenderable", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlClause", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlFragment", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlParam", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlRaw", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlBuiltQuery", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlDdlStatement", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlAdminQuery", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlUnsafe", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("SqlLegacy", s).
esc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), contains("_SqlPrebuilt", s).
esc_gate(d) :- node(d, _, "module", _, _), !option_on("sourceGate").
esc_doc(d) :- in_scope(d), !out_scope(d), !tape_syntax_error(d), esc_gate(d).
forbidden_class_line_ok(d, l) :- tape_line(d, l, sp), text(sp, s), match("(?s:.*)(?:(?:SqlAdminQuery|SqlBuiltQuery|SqlDdlStatement|SqlLegacy|SqlRawSql|SqlRawSqlWithParams|SqlUnsafe|_SqlPrebuiltCondition|_SqlPrebuiltQuery)\\(|import (?:SqlAdminQuery|SqlBuiltQuery|SqlDdlStatement|SqlLegacy|SqlRawSql|SqlRawSqlWithParams|SqlUnsafe|_SqlPrebuiltCondition|_SqlPrebuiltQuery)|, (?:SqlAdminQuery|SqlBuiltQuery|SqlDdlStatement|SqlLegacy|SqlRawSql|SqlRawSqlWithParams|SqlUnsafe|_SqlPrebuiltCondition|_SqlPrebuiltQuery))(?s:.*)", s).
forbidden_class_hit(d, n) :- node(d, n, "class_definition", _, _), esc_doc(d), field(n, "name", x), node(d, x, "identifier", _, _), text(x, s), esc_forbidden(s), line(n, l), !forbidden_class_line_ok(d, l).
unsafe_seed(s) :- option_item("grammar_class_names", _, s).
unsafe_class_arg(d, cls, arg) :- node(d, cls, "class_definition", _, _), esc_doc(d), child(cls, al, _), node(d, al, "argument_list", _, _), child(al, arg, _).
unsafe_base_walk(arg, arg) :- unsafe_class_arg(_, _, arg).
unsafe_base_walk(arg, v) :- unsafe_base_walk(arg, n), node(_, n, "subscript", _, _), field(n, "value", v).
unsafe_base_of(arg, b) :- unsafe_base_walk(arg, n), node(_, n, "identifier", _, _), text(n, b).
unsafe_base_of(arg, b) :- unsafe_base_walk(arg, n), node(_, n, "attribute", _, _), field(n, "attribute", x), node(_, x, "identifier", _, _), text(x, b).
unsafe_class_name(cls, c) :- unsafe_class_arg(_, cls, _), field(cls, "name", x), text(x, c).
unsafe_class_edge(b, c) :- unsafe_class_arg(_, cls, arg), unsafe_base_of(arg, b), unsafe_class_name(cls, c).
unsafe_alias_walk(a, r) :- node(d, a, "assignment", _, _), esc_doc(d), field(a, "right", r).
unsafe_alias_walk(a, c) :- unsafe_alias_walk(a, n), node(_, n, "binary_operator", _, _), op(n, "|"), field(n, "left", c).
unsafe_alias_walk(a, c) :- unsafe_alias_walk(a, n), node(_, n, "binary_operator", _, _), op(n, "|"), field(n, "right", c).
unsafe_alias_walk(a, c) :- unsafe_alias_walk(a, n), node(_, n, "parenthesized_expression", _, _), child(n, c, _).
unsafe_alias_from(a, f) :- unsafe_alias_walk(a, n), node(_, n, "identifier", _, _), text(n, f).
unsafe_alias_from(a, f) :- unsafe_alias_walk(a, n), node(_, n, "attribute", _, _), field(n, "attribute", x), node(_, x, "identifier", _, _), text(x, f).
unsafe_alias_edge(f, t) :- unsafe_alias_from(a, f), field(a, "left", x), node(_, x, "identifier", _, _), text(x, t).
unsafe_known_class(s) :- unsafe_seed(s).
unsafe_known_class(c) :- unsafe_known_class(b), unsafe_class_edge(b, c).
unsafe_known(s) :- unsafe_known_class(s).
unsafe_known(t) :- unsafe_known(f), unsafe_alias_edge(f, t).
unsafe_excluded(s) :- esc_forbidden(s).
unsafe_excluded(s) :- option_item("ALLOWLISTED_CLASSES", _, s).
unsafe_excluded(s) :- option_item("SCHEMA_METADATA_CLASSES", _, s).
unsafe_excluded(s) :- option_item("CALLSITE_PROTECTED_CLASSES", _, s).
unsafe_grammar_class(d, cls, owner) :- unsafe_class_arg(d, cls, arg), unsafe_base_of(arg, b), unsafe_known(b), unsafe_class_name(cls, owner), !unsafe_excluded(owner).
unsafe_init_def(f) :- node(_, f, "function_definition", _, _), field(f, "name", x), node(_, x, "identifier", _, _), text(x, "__init__"), node_text(f, s), match("def\\s(?s:.*)", s).
unsafe_init(cls, f) :- unsafe_grammar_class(_, cls, _), field(cls, "body", b), child(b, f, _), unsafe_init_def(f).
unsafe_init(cls, f) :- unsafe_grammar_class(_, cls, _), field(cls, "body", b), child(b, dd, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", f), unsafe_init_def(f).
unsafe_self(p) :- child(p, x, _), node(_, x, "identifier", _, _), text(x, "self").
unsafe_splat(p) :- node(_, p, "typed_parameter", _, _), child(p, x, _), node(_, x, "list_splat_pattern", _, _).
unsafe_splat(p) :- node(_, p, "typed_parameter", _, _), child(p, x, _), node(_, x, "dictionary_splat_pattern", _, _).
unsafe_star(x) :- node(_, x, "keyword_separator", _, _).
unsafe_star(x) :- node(_, x, "list_splat_pattern", _, _).
unsafe_star(x) :- node(_, x, "typed_parameter", _, _), child(x, y, _), node(_, y, "list_splat_pattern", _, _).
unsafe_candidate(f, ps, p, i) :- unsafe_init(_, f), field(f, "parameters", ps), child(ps, p, i), node(_, p, k, _, _), unsafe_param_kind(k).
unsafe_positional(p) :- unsafe_candidate(_, ps, p, i), child(ps, x, j), j > i, node(_, x, "positional_separator", _, _).
unsafe_keyword_only(p) :- unsafe_candidate(_, ps, p, i), child(ps, x, j), j < i, unsafe_star(x).
unsafe_param(f, p, t) :- unsafe_candidate(f, _, p, _), !unsafe_self(p), !unsafe_splat(p), !unsafe_positional(p), !unsafe_keyword_only(p), field(p, "type", t).
unsafe_walk(p, t) :- unsafe_param(_, p, t).
unsafe_walk(p, c) :- unsafe_walk(p, n), node(_, n, "attribute", _, _), field(n, "attribute", c).
unsafe_walk(p, c) :- unsafe_walk(p, n), node(_, n, k, _, _), unsafe_wrapper(k), child(n, c, _).
unsafe_walk(p, c) :- unsafe_walk(p, n), node(_, n, "subscript", _, _), field(n, "value", c).
unsafe_walk(p, c) :- unsafe_walk(p, n), node(_, n, "subscript", _, _), field(n, "subscript", c).
unsafe_walk(p, c) :- unsafe_walk(p, n), node(_, n, "binary_operator", _, _), op(n, "|"), field(n, "left", c).
unsafe_walk(p, c) :- unsafe_walk(p, n), node(_, n, "binary_operator", _, _), op(n, "|"), field(n, "right", c).
unsafe_safe_name(s) :- option_item("safe_param_types", _, s).
unsafe_safe_name(s) :- unsafe_container(s).
unsafe_str_exempt(p) :- unsafe_param(_, p, _), child(p, x, _), node(_, x, "identifier", _, _), text(x, s), option_item("DATA_VALUE_PARAMS", _, s).
unsafe_str_exempt(p) :- unsafe_param(_, p, _), child(p, x, _), node(_, x, "identifier", _, _), text(x, s), option_item("OPERATOR_PARAMS", _, s).
unsafe_leaf(p, s) :- unsafe_walk(p, n), node(_, n, "identifier", _, _), text(n, s), !unsafe_safe_name(s), !unsafe_str_exempt_name(p, s).
unsafe_str_exempt_name(p, "str") :- unsafe_str_exempt(p).
unsafe_literal(p) :- unsafe_walk(p, n), node(_, n, k, _, _), unsafe_literal_kind(k).
unsafe_fpart(n) :- node(_, n, "string", _, _), strprefix(n, f), contains("f", f).
unsafe_fconcat(n) :- node(_, n, "concatenated_string", _, _), child(n, x, _), unsafe_fpart(x).
unsafe_text(p, v) :- unsafe_walk(p, n), node(_, n, "string", _, _), !unsafe_fpart(n), value_type_of(n, "str"), value(n, v).
unsafe_text(p, v) :- unsafe_walk(p, n), node(_, n, "concatenated_string", _, _), !unsafe_fconcat(n), value_type_of(n, "str"), value(n, v).
unsafe_len(v, k) :- unsafe_text(_, v), k = @strlen(v).
unsafe_block(v, j) :- unsafe_len(v, k), unsafe_digit64(a), @mul(a, 4096) < k, unsafe_digit64(b), j = @add(@mul(a, 4096), @mul(b, 64)), j < k.
unsafe_ch(v, i, c) :- unsafe_block(v, j), unsafe_len(v, k), unsafe_digit64(e), i = @add(j, e), i < k, c = @substr(v, i, 1).
unsafe_next(v, i, j) :- unsafe_ch(v, i, _), j = @add(i, 1), unsafe_ch(v, j, _).
unsafe_wc(c) :- unsafe_alpha(c).
unsafe_wc(c) :- unsafe_digit(c).
unsafe_lead(v, 0) :- unsafe_ch(v, 0, c), unsafe_digit(c).
unsafe_lead(v, i) :- unsafe_ch(v, i, c), unsafe_digit(c), i > 0, h = @sub(i, 1), unsafe_ch(v, h, b), !unsafe_wc(b).
unsafe_lead(v, j) :- unsafe_lead(v, i), unsafe_next(v, i, j), unsafe_ch(v, j, c), unsafe_digit(c).
unsafe_word_start(v, 0) :- unsafe_ch(v, 0, c), unsafe_alpha(c).
unsafe_word_start(v, i) :- unsafe_ch(v, i, c), unsafe_alpha(c), i > 0, h = @sub(i, 1), unsafe_ch(v, h, b), !unsafe_wc(b).
unsafe_word_start(v, i) :- unsafe_ch(v, i, c), unsafe_alpha(c), i > 0, h = @sub(i, 1), unsafe_lead(v, h).
unsafe_word_run(v, i, i) :- unsafe_word_start(v, i).
unsafe_word_run(v, i, j) :- unsafe_word_run(v, i, h), unsafe_next(v, h, j), unsafe_ch(v, j, c), unsafe_wc(c).
unsafe_word_end(v, j) :- unsafe_word_run(v, _, j), unsafe_len(v, k), @add(j, 1) = k.
unsafe_word_end(v, j) :- unsafe_word_run(v, _, j), h = @add(j, 1), unsafe_ch(v, h, c), !unsafe_wc(c).
unsafe_word(v, w) :- unsafe_word_run(v, i, j), unsafe_word_end(v, j), w = @substr(v, i, @add(@sub(j, i), 1)).
unsafe_leaf(p, w) :- unsafe_text(p, v), unsafe_word(v, w), !unsafe_safe_name(w), !unsafe_str_exempt_name(p, w).
unsafe_parameter_hit(d, p, owner) :- unsafe_grammar_class(d, cls, owner), unsafe_init(cls, f), unsafe_param(f, p, _), unsafe_leaf(p, s), !unsafe_known(s).
unsafe_parameter_hit(d, p, owner) :- unsafe_grammar_class(d, cls, owner), unsafe_init(cls, f), unsafe_param(f, p, _), unsafe_literal(p).
unsafe_group(d, l, owner) :- unsafe_parameter_hit(d, p, owner), line(p, l).
usage_call_slot(n) :- node(_, p, "call", _, _), field(p, "function", n).
usage_call_slot(n) :- node(_, a, "attribute", _, _), field(a, "attribute", n), node(_, p, "call", _, _), field(p, "function", a).
usage_call_slot(n) :- node(_, c, "class_definition", _, _), field(c, "name", n), field(c, "superclasses", al), node(_, al, "argument_list", _, _).
usage_call_slot(n) :- node(_, f, "function_definition", _, _), field(f, "name", n).
usage_prev(n, s) :- prev_token(n, s).
usage_0_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("SqlAdminQuery", s), usage_call_slot(n).
usage_0_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("SqlAdminQuery", s).
usage_0_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("SqlAdminQuery", s).
usage_0_earlier(n) :- usage_0_hit(d, n), node(d, n, _, ns, _), line(n, l), usage_0_hit(d, m), node(d, m, _, _, me), me <= ns, end_line(m, l).
usage_0_current(d, n) :- usage_0_hit(d, n), esc_doc(d), !usage_0_earlier(n).
usage_1_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("SqlBuiltQuery", s), usage_call_slot(n).
usage_1_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("SqlBuiltQuery", s).
usage_1_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("SqlBuiltQuery", s).
usage_1_earlier(n) :- usage_1_hit(d, n), node(d, n, _, ns, _), line(n, l), usage_1_hit(d, m), node(d, m, _, _, me), me <= ns, end_line(m, l).
usage_1_current(d, n) :- usage_1_hit(d, n), esc_doc(d), !usage_1_earlier(n).
usage_2_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("SqlDdlStatement", s), usage_call_slot(n).
usage_2_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("SqlDdlStatement", s).
usage_2_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("SqlDdlStatement", s).
usage_2_earlier(n) :- usage_2_hit(d, n), node(d, n, _, ns, _), line(n, l), usage_2_hit(d, m), node(d, m, _, _, me), me <= ns, end_line(m, l).
usage_2_current(d, n) :- usage_2_hit(d, n), esc_doc(d), !usage_2_earlier(n).
usage_3_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("SqlLegacy", s), usage_call_slot(n).
usage_3_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("SqlLegacy", s).
usage_3_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("SqlLegacy", s).
usage_3_earlier(n) :- usage_3_hit(d, n), node(d, n, _, ns, _), line(n, l), usage_3_hit(d, m), node(d, m, _, _, me), me <= ns, end_line(m, l).
usage_3_current(d, n) :- usage_3_hit(d, n), esc_doc(d), !usage_3_earlier(n).
usage_4_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("SqlRawSql", s), usage_call_slot(n).
usage_4_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("SqlRawSql", s).
usage_4_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("SqlRawSql", s).
usage_4_earlier(n) :- usage_4_hit(d, n), node(d, n, _, ns, _), line(n, l), usage_4_hit(d, m), node(d, m, _, _, me), me <= ns, end_line(m, l).
usage_4_current(d, n) :- usage_4_hit(d, n), esc_doc(d), !usage_4_earlier(n).
usage_5_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("SqlRawSqlWithParams", s), usage_call_slot(n).
usage_5_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("SqlRawSqlWithParams", s).
usage_5_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("SqlRawSqlWithParams", s).
usage_5_earlier(n) :- usage_5_hit(d, n), node(d, n, _, ns, _), line(n, l), usage_5_hit(d, m), node(d, m, _, _, me), me <= ns, end_line(m, l).
usage_5_current(d, n) :- usage_5_hit(d, n), esc_doc(d), !usage_5_earlier(n).
usage_6_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("SqlUnsafe", s), usage_call_slot(n).
usage_6_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("SqlUnsafe", s).
usage_6_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("SqlUnsafe", s).
usage_6_earlier(n) :- usage_6_hit(d, n), node(d, n, _, ns, _), line(n, l), usage_6_hit(d, m), node(d, m, _, _, me), me <= ns, end_line(m, l).
usage_6_current(d, n) :- usage_6_hit(d, n), esc_doc(d), !usage_6_earlier(n).
usage_7_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("_SqlPrebuiltCondition", s), usage_call_slot(n).
usage_7_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("_SqlPrebuiltCondition", s).
usage_7_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("_SqlPrebuiltCondition", s).
usage_7_earlier(n) :- usage_7_hit(d, n), node(d, n, _, ns, _), line(n, l), usage_7_hit(d, m), node(d, m, _, _, me), me <= ns, end_line(m, l).
