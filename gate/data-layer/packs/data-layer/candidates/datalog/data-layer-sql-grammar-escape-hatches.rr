usage_8_hit(d, n) :- node(d, n, "identifier", _, _), text(n, s), suffix("_SqlPrebuiltQuery", s), usage_call_slot(n).
usage_8_hit(d, n) :- node(d, n, k, _, _), usage_import_kind(k), usage_prev(n, "import"), node_text(n, s), prefix("_SqlPrebuiltQuery", s).
usage_8_hit(d, n) :- node(d, n, k, _, _), usage_comma_kind(k), usage_prev(n, ","), node_text(n, s), prefix("_SqlPrebuiltQuery", s).
