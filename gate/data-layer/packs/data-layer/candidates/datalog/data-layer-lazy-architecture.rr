lazy_clsprefix(f, c, pre) :- lazy_lex(f, c), lazy_af(f), lazy_qual(c, cq), lazy_nd(f, d), lazy_modsym(d, m), pre = @concat(@concat(@concat(@concat(m, "."), cq), "."), "").
lazy_lasttopimport(d, local, name) :- lazy_topimport(d, local, _, _), s = max s2 : { lazy_topimport(d, local, s2, _) }, lazy_topimport(d, local, s, name).
lazy_ev0(f, c, "plan", 0) :- lazy_leafin(f, c, "plan0").
lazy_ev0(f, c, "plan", 1) :- lazy_ock(f, c, "attribute", callee), (callee = "execute" ; callee = "execute_async"), lazy_recvtag(f, c, "plan").
lazy_ev0(f, c, "plan", 1) :- lazy_ock(f, c, "attribute", callee), (callee = "execute_many" ; callee = "execute_one" ; callee = "fetchall" ; callee = "fetchmany" ; callee = "fetchone" ; callee = "_execute_direct_internal" ; callee = "_execute_direct_internal_async").
lazy_ev0(f, c, "plan", 1) :- lazy_ock(f, c, "attribute", callee), (callee = "resolve" ; callee = "resolve_async"), lazy_recvtag(f, c, "lazy").
lazy_ev0(f, c, "intent", 2) :- lazy_leafin(f, c, "intent").
lazy_ev0(f, c, "intent", 2) :- lazy_res(f, c, r), suffix("Intent", r).
lazy_ev0(f, c, "grammar", 3) :- lazy_res(f, c, r), prefix("grammar_", r).
lazy_ev0(f, c, "native", 4) :- lazy_leafin(f, c, "native").
lazy_ev0(f, c, "private", 5) :- lazy_resin(f, c, "vars"), lazy_arg(c, _, 0).
lazy_ev0(f, c, "private", 5) :- lazy_resin(f, c, "private"), lazy_argstr(c, 1, "_conn").
lazy_ev0(f, c, "private", 6) :- lazy_ock(f, c, "attribute", "get"), lazy_recv(c, r), lazy_callee(r, rc), lazy_call(r, _, _), (rc = "vars" ; rc = "builtins.vars"), lazy_argstr(c, 0, "_conn").
lazy_ev0(f, c, "internal", 7) :- lazy_resin(f, c, "getattribute"), lazy_argstr(c, 1, v), lazy_internalname(v), lazy_argtag(f, c, 0, "lazy").
lazy_ev0(f, c, "state", 8) :- lazy_resin(f, c, "setattr"), lazy_argstr(c, 1, v), (v = "_branch_anchor" ; v = "_branch_id" ; v = "_revision_id"), lazy_argtag(f, c, 2, "internal").
lazy_ev0(f, c, "forbidden_pure", 9) :- lazy_leafin(f, c, "forbidden").
lazy_ev0(f, c, "reconciliation", 10) :- lazy_leafin(f, c, "recon"), !lazy_leaf(f, c, "flush_schema_plan").
lazy_ev0(f, c, "reconciliation", 10) :- lazy_leaf(f, c, "flush_schema_plan"), !lazy_flushok(f).
lazy_ev0(f, c, "bootstrap", 11) :- lazy_ock(f, c, "attribute", callee), lazy_mutator(callee), lazy_recv(c, r), lazy_selfrooted(r).
lazy_ev0(f, c, "absence", 12) :- lazy_leaf(f, c, "_record_table_exists_result"), lazy_arg(c, a, 1), lazy_kind(a, "false").
lazy_ev0(f, c, "dynamic", 13) :- lazy_fname(f, name), prefix("materialize_", name), lazy_resin(f, c, "callable"), lazy_argtag(f, c, 0, "dynamic").
lazy_ev0(f, c, "dynamic", 13) :- lazy_fname(f, name), prefix("materialize_", name), lazy_call(c, x, "identifier"), lazy_oc(f, c), lazy_tag(f, x, "dynamic").
lazy_ev0(f, c, "payload", 14) :- lazy_oc(f, c), lazy_kw(c, "closed_post_op", v), lazy_tag(f, v, "callable").
lazy_ev0(f, c, "payload", 14) :- lazy_oc(f, c), lazy_kw(c, _, v), lazy_tag(f, v, "callable"), !lazy_haskw(c, "closed_post_op"), lazy_resin(f, c, "post_op").
lazy_ev0(f, c, "payload", 14) :- lazy_oc(f, c), lazy_kw(c, "literal_kwargs", v), lazy_tag(f, v, "callable"), !lazy_haskw(c, "closed_post_op"), lazy_leaf(f, c, "RuntimeBuilderSpec").
lazy_ev0(f, c, "payload", 14) :- lazy_oc(f, c), lazy_kw(c, k, v), (k = "literal_payload" ; k = "default_value"), lazy_tag(f, v, "callable"), !lazy_haskw(c, "closed_post_op"), lazy_leaf(f, c, "ResultMaterializationSpec").
lazy_ev0(f, c, "payload", 14) :- lazy_resin(f, c, "literal_post_op"), !lazy_haskw(c, "closed_post_op"), lazy_argtag(f, c, 0, "callable").
lazy_ev0(f, n, "dolt", 15) :- lazy_owned(f, o), lazy_n(d, o, _, s, e), lazy_strn(d, n, s, e), lazy_strval(n, v), (icontains("dolt_", v) ; icontains("dolt log", v) ; icontains("dolt branches", v)).
lazy_ev0(f, a, "bootstrap", 16) :- lazy_owned(f, a), lazy_asg(a, l, "attribute"), lazy_selfrooted(l).
lazy_ev0(f, a, "bootstrap", 16) :- lazy_owned(f, a), lazy_asg(a, l, "subscript"), lazy_selfrooted(l).
lazy_ev0(f, r, "of_return", 17) :- lazy_owned(f, r), lazy_ret(r, c), lazy_lazyof(c).
lazy_ev0(f, a, "absence", 18) :- lazy_owned(f, a), lazy_asg(a, _, "identifier"), lazy_asgtext(a, t), (contains("snapshot", t) ; contains("existing", t)), lazy_asgr(a, c), lazy_call(c, _, "identifier"), lazy_callee(c, ce), (ce = "set" ; ce = "frozenset"), lazy_args(c, g, _), !lazy_haskid(g).
lazy_ev0(f, r, "absence", 19) :- lazy_owned(f, r), lazy_ret(r, c), lazy_lazyof(c), lazy_arg(c, a, 0), lazy_kind(a, "false"), lazy_fname(f, name), name != "table_exists_lazy", lazy_fqual(f, q), !icontains("_should_skip_", q), (icontains("schema_fact", q) ; icontains("exists", q) ; icontains("has_", q) ; icontains("table", q) ; icontains("column", q) ; icontains("index", q) ; icontains("trigger", q)).
lazy_ev0(f, f, "context", 20) :- lazy_execctx(f).
lazy_lazyof(c) :- lazy_call(c, x, "attribute"), lazy_attr(x, "of"), lazy_ntext(x, t), t = "LazyResult.of".
lazy_lazyof(c) :- lazy_call(c, x, "attribute"), lazy_attr(x, "of"), lazy_ntext(x, t), suffix(".LazyResult.of", t).
lazy_flushok(f) :- lazy_fname(f, n), (n = "_bulk_schema_plan_context" ; n = "_commit_schema_transaction" ; n = "_create_fts_index_schema_sync" ; n = "create_table_from_schema" ; n = "drop_table").
lazy_flushok(f) :- lazy_fqual(f, q), (q = "LazySchemaTransaction._bulk_schema_plan_context" ; q = "LazySchemaTransaction._commit_schema_transaction" ; q = "LazySchemaTransaction._create_fts_index_schema_sync" ; q = "SyncSchemaTransaction.create_table_from_schema" ; q = "SyncSchemaTransaction.drop_table").
lazy_ev(f, e, cat, ch) :- lazy_ev0(f, e, cat, ch), cat != "bootstrap", cat != "forbidden_pure".
lazy_ev(f, e, cat, ch) :- lazy_ev0(f, e, cat, ch), (cat = "bootstrap" ; cat = "forbidden_pure"), lazy_pure(f).
lazy_evstart(e, s) :- lazy_ev(_, e, _, _), lazy_span(e, s, _).
lazy_evtag(f, e, cat, ch) :- lazy_ev(f, e, cat, ch).
lazy_evtag(f, e, "conn", ch) :- lazy_evconn(f, e), lazy_ev(f, e, "plan", ch).
lazy_evtag(f, e, "resolve", ch) :- lazy_evresolve(f, e), lazy_ev(f, e, "plan", ch).
lazy_evtag(f, e, "orchestration", ch) :- lazy_ev(f, e, "plan", ch), !lazy_evnative(f, e).
lazy_hasspantop(f, s, e) :- lazy_spantop(f, s, e, _).
lazy_amark0(f, x, tag, ch, s) :- lazy_evtag(f, e, tag, ch), lazy_span(e, s, en), lazy_spantop(f, s, en, x).
lazy_afree(f, tag, ch, s) :- lazy_evtag(f, e, tag, ch), lazy_span(e, s, en), !lazy_hasspantop(f, s, en).
lazy_evresolve(f, c) :- lazy_ev(f, c, "plan", 1), lazy_ock(f, c, _, callee), (callee = "resolve" ; callee = "resolve_async").
lazy_evasync(f, c) :- lazy_ev(f, c, "plan", 0), lazy_res(f, c, r), suffix("_async", r).
lazy_evasync(f, c) :- lazy_ev(f, c, "plan", 1), lazy_callee(c, callee), suffix("_async", callee).
lazy_evasync(f, c) :- lazy_ev(f, c, "grammar", 3), lazy_res(f, c, r), suffix("_async", r).
lazy_evnative(f, c) :- lazy_ev(f, c, "plan", _), lazy_recv(c, r), lazy_kind(r, "identifier"), lazy_ntext(r, t), lazy_nativecursor(f, t), lazy_callee(c, callee), (callee = "fetchone" ; callee = "fetchmany" ; callee = "fetchall").
lazy_connattr(d, s, e) :- lazy_n(d, a, "attribute", s, e), lazy_attr(a, "_conn").
lazy_evconn(f, c) :- lazy_ev(f, c, "plan", _), lazy_arg(c, a, 0), lazy_n(d, a, _, ax, ae), lazy_connattr(d, s, e), s >= ax, e <= ae.
lazy_evconn(f, c) :- lazy_ev(f, c, "plan", _), lazy_kw(c, k, v), (k = "owner" ; k = "txn" ; k = "tx" ; k = "conn" ; k = "connection"), lazy_n(d, v, _, vs, ve), lazy_connattr(d, s, e), s >= vs, e <= ve.
lazy_redefined(f) :- lazy_af(f), lazy_qual(f, q), lazy_nd(f, d), lazy_span(f, s, _), lazy_decl(g, "function_definition", _), lazy_qual(g, q), lazy_nd(g, d), lazy_span(g, s2, _), s2 > s.
lazy_symfn(s, f) :- lazy_sym(f, s), !lazy_redefined(f).
lazy_edge(f, c, t) :- lazy_oc(f, c), lazy_target(f, c, s), lazy_symfn(s, t), t != f.
lazy_reach(r, r) :- lazy_af(r).
lazy_reach(r, t) :- lazy_reach(r, n), lazy_nd(n, d), lazy_nd(r, d), lazy_edge(n, _, t).
lazy_foenc(f, r) :- lazy_sym(f, _), inside(f, c, lazy_clsset), lazy_region(c, r).
rr_ctx2(f, r) :- lazy_foenc(f, r).
rr_agg1(f, r, r2) :- rr_ctx2(f, r), lazy_foenc(f, r2), r2 < r.
lazy_foel(f, i, r) :- lazy_foenc(f, r), i = count : { rr_agg1(f, r, _) }.
lazy_foel(f, i, r) :- lazy_sym(f, _), lazy_region(f, r), i = count : { lazy_foenc(f, _) }.
lazy_folen(f, n) :- lazy_sym(f, _), n = count : { lazy_foel(f, _, _) }.
lazy_sympair(f, g) :- lazy_sym(f, s), lazy_sym(g, s), f != g.
lazy_fodiff(f, g, i) :- lazy_sympair(f, g), lazy_foel(f, i, a), lazy_foel(g, i, b), a != b.
lazy_hasfodiff(f, g) :- lazy_fodiff(f, g, _).
lazy_symlater(f) :- lazy_hasfodiff(f, g), i = min j : { lazy_fodiff(f, g, j) }, lazy_foel(f, i, a), lazy_foel(g, i, b), b > a.
lazy_symlater(f) :- lazy_sympair(f, g), !lazy_hasfodiff(f, g), lazy_folen(f, n), lazy_folen(g, m), m > n.
lazy_gf(f) :- lazy_sym(f, _), !lazy_symlater(f).
lazy_gnode(f, g) :- lazy_sym(f, s), lazy_gf(g), lazy_sym(g, s).
lazy_gedge(f, t, c, loc) :- lazy_edge(f, c, t), lazy_gf(f), lazy_gf(t), lazy_span(c, loc, _).
lazy_ge(g, f, t, c, loc) :- lazy_graph(g, _), g != "nonlazy", lazy_gedge(f, t, c, loc).
lazy_ge("nonlazy", f, t, c, loc) :- lazy_gedge(f, t, c, loc), lazy_sym(t, s), !lazy_nonlazycut(s).
lazy_gsink(k, f, loc) :- lazy_gf(f), lazy_localfirst(f, k, loc).
lazy_gsink("legacy", f, loc) :- lazy_gf(f), lazy_legacy(f), lazy_fstart(f, loc).
lazy_gsink("permission", f, loc) :- lazy_gf(f), lazy_sym(f, s), lazy_permsym(s), lazy_fstart(f, loc).
lazy_gsink("eager", f, loc) :- lazy_gf(f), lazy_intrinsic(f, loc).
lazy_gsink("nonlazy", f, loc) :- lazy_gf(f), !lazy_islazy(f), lazy_fstart(f, loc).
lazy_issink(g, n) :- lazy_gsink(g, n, _).
lazy_localfirst(f, k, loc) :- lazy_apick(f, k, loc), (k = "plan" ; k = "intent" ; k = "native" ; k = "dolt" ; k = "orchestration").
lazy_live(g, n) :- lazy_issink(g, n).
lazy_live(g, n) :- lazy_ge(g, n, t, _, _), lazy_issink(g, t).
lazy_live(g, n) :- lazy_ge(g, n, t, _, _), lazy_nd(n, d), lazy_nd(t, d), lazy_live(g, t).
lazy_cr(g, r, n) :- lazy_ge(g, r, n, _, _), lazy_nd(r, d), lazy_nd(n, d), !lazy_issink(g, n).
lazy_cr(g, r, z) :- lazy_cr(g, r, n), lazy_ge(g, n, z, _, _), lazy_nd(n, d), lazy_nd(z, d), !lazy_issink(g, z).
lazy_oncycle(g, r) :- lazy_cr(g, r, r).
lazy_av(g, r, c, c) :- lazy_oncycle(g, r), lazy_ge(g, r, c, _, _), c != r, !lazy_issink(g, c), lazy_nd(r, d), lazy_nd(c, d).
lazy_av(g, r, c, z) :- lazy_av(g, r, c, n), lazy_ge(g, n, z, _, _), z != r, !lazy_issink(g, z), lazy_nd(n, d), lazy_nd(z, d).
lazy_ok(g, r, c) :- lazy_ge(g, r, c, _, _), lazy_issink(g, c).
lazy_ok(g, r, c) :- lazy_ge(g, r, c, _, _), c != r, !lazy_issink(g, c), !lazy_oncycle(g, r), lazy_nd(r, d), lazy_nd(c, d), lazy_live(g, c).
lazy_ok(g, r, c) :- lazy_av(g, r, c, n), lazy_ge(g, n, t, _, _), lazy_issink(g, t).
lazy_bmark(g, r, c, loc) :- lazy_ok(g, r, t), lazy_ge(g, r, t, c, loc).
lazy_brow(g, r, k, x, loc) :- lazy_bmark(g, r, c, loc), lazy_vk(r, c, k), x = @substr(@concat("000000000000", @to_string(loc)), @strlen(@to_string(loc)), 12).
lazy_bhasrow(g, r) :- lazy_brow(g, r, _, _, _).
lazy_bpick(g, r, loc) :- lazy_bhasrow(g, r), s = join x by (k) sep "" : { lazy_brow(g, r, k, x, _) }, lazy_brow(g, r, _, x, loc), x = @substr(s, 0, 12).
lazy_hit(g, r, loc) :- lazy_graph(g, "node"), lazy_gsink(g, r, loc).
lazy_hit(g, r, loc) :- lazy_graph(g, "node"), lazy_gf(r), !lazy_issink(g, r), lazy_bpick(g, r, loc).
lazy_hit(g, r, loc) :- lazy_graph(g, "edge"), lazy_bpick(g, r, loc).
lazy_result(g, f, loc) :- lazy_gnode(f, n), lazy_hit(g, n, loc).
lazy_hasresult(g, f) :- lazy_result(g, f, _).
lazy_legacymatch(f, loc) :- lazy_pure(f), lazy_result("legacy", f, loc).
lazy_haslegacy(f) :- lazy_legacymatch(f, _).
lazy_eager(f, loc) :- lazy_pure(f), !lazy_haslegacy(f), lazy_result("eager", f, loc).
lazy_nonlazy(f, loc) :- lazy_islazy(f), !lazy_purelegacy(f), lazy_result("nonlazy", f, loc).
lazy_purelegacy(f) :- lazy_pure(f), lazy_haslegacy(f).
lazy_intrcat(f, "plan", 4) :- lazy_af(f).
lazy_intrcat(f, "native", 5) :- lazy_af(f).
lazy_intrcat(f, "context", 0) :- lazy_sensitive(f).
lazy_intrcat(f, "internal", 1) :- lazy_sensitive(f).
lazy_intrcat(f, "state", 2) :- lazy_sensitive(f).
lazy_intrcat(f, "private", 3) :- lazy_sensitive(f).
lazy_intrev(f, co, loc) :- lazy_intrcat(f, cat, co), lazy_apick(f, cat, loc).
lazy_hasintrev(f) :- lazy_intrev(f, _, _).
lazy_intrinsic(f, loc) :- lazy_hasintrev(f), co = min c2 : { lazy_intrev(f, c2, _) }, lazy_intrev(f, co, loc).
lazy_intrinsic(f, loc) :- lazy_af(f), !lazy_hasintrev(f), lazy_asyncish(f), lazy_fstart(f, loc).
lazy_asyncish(f) :- lazy_legacy(f).
lazy_asyncish(f) :- lazy_af(f), op(f, "async"), !lazy_pure(f).
lazy_asyncish(f) :- lazy_fname(f, n), suffix("_async", n).
lazy_diag(d, s, code) :- lazy_fdiag(f, s, code, 0), lazy_nd(f, d).
lazy_diag(d, s, code) :- lazy_fdiag(f, s, code, 1), lazy_nd(f, d), !lazy_purelegacy(f).
lazy_firstev(f, cat, loc) :- lazy_apick(f, cat, loc).
lazy_fdiag(f, s, "LA-001", 0) :- lazy_pure(f), lazy_result("plan", f, s).
lazy_fdiag(f, s, "LA-002", 0) :- lazy_result("plan", f, s), lazy_hasresult("intent", f).
lazy_fdiag(f, s, "LA-003", 0) :- lazy_result("plan", f, s), lazy_public(f), !lazy_islazy(f), !lazy_hasresult("intent", f), lazy_fpath(f, _, p), prefix("impl/common/l3500_bulk_ops/", p).
lazy_fdiag(f, s, "LA-003", 0) :- lazy_result("plan", f, s), lazy_public(f), !lazy_islazy(f), !lazy_hasresult("intent", f), lazy_fpath(f, _, p), prefix("impl/common/l7300_revision_history/", p).
lazy_fdiag(f, s, "LA-003", 0) :- lazy_result("plan", f, s), lazy_public(f), !lazy_islazy(f), !lazy_hasresult("intent", f), lazy_fpath(f, _, p), prefix("impl/common/l9700_sql_graph_query/", p).
lazy_fdiag(f, s, "LA-003", 0) :- lazy_result("plan", f, s), lazy_public(f), !lazy_islazy(f), !lazy_hasresult("intent", f), lazy_fpath(f, _, p), p = "impl/common/l5200_sql_query/_insert_from_query.py".
lazy_fdiag(f, s, "LA-004", 0) :- lazy_result("native", f, s), lazy_fpath(f, _, p), !contains("migration", p), lazy_hasresult("orchestration", f).
lazy_fdiag(f, s, "LA-005", 0) :- lazy_la005path(f), lazy_result("dolt", f, s).
lazy_fdiag(f, s, "LA-005", 0) :- lazy_la005path(f), !lazy_hasresult("dolt", f), lazy_result("native", f, s).
lazy_la005path(f) :- lazy_fpath(f, _, p), (prefix("impl/common/l7100_versioned_operations/", p) ; prefix("impl/common/l7248_sparse_versioned_transactions/", p) ; prefix("impl/common/l7300_sql_versioned_transactions/", p) ; prefix("l7250_versioned_operations/", p)).
lazy_fdiag(f, s, "LA-006", 0) :- lazy_apick(f, "conn", s).
lazy_fdiag(f, s, "LA-007", 0) :- lazy_result("plan", f, s), lazy_fname(f, n), prefix("prepare_", n).
lazy_fdiag(f, s, "LA-008", 0) :- lazy_fpath(f, _, p), (prefix("impl/common/l7248_sparse_versioned_transactions/", p) ; prefix("impl/common/l7300_sql_versioned_transactions/", p) ; prefix("impl/doltdb/versioned_write_transaction.py", p)), lazy_reach(f, n), lazy_ev(n, _, "grammar", _), lazy_fname(f, name), aname = @concat(name, "_async"), lazy_fname(a, aname), lazy_nd(a, d), lazy_nd(f, d), lazy_reach(a, m), lazy_evasync(m, _), lazy_fstart(f, s).
lazy_fdiag(f, s, "LA-009", 0) :- lazy_sensitive(f), (cat = "context" ; cat = "internal" ; cat = "state" ; cat = "private"), lazy_firstev(f, cat, s).
lazy_fdiag(f, s, "LA-009", 1) :- lazy_eager(f, s).
lazy_fdiag(f, s, "LA-010", 0) :- lazy_fname(f, n), icontains("lazy", n), icontains("sync", n), lazy_fstart(f, s).
lazy_fdiag(f, s, "LA-011", 0) :- lazy_la011(f), lazy_result("plan", f, s).
lazy_la011(f) :- lazy_fpath(f, _, p), prefix("impl/common/l2070_server_plan/", p), lazy_fname(f, n), (n = "lower" ; n = "compile" ; n = "preprocess" ; n = "pre_op" ; n = "post_op").
lazy_amark0(f, c, "hydration", 0, loc) :- lazy_fpath(f, _, p), prefix("impl/common/l2070_server_plan/", p), lazy_oc(f, c), lazy_target(f, c, t), (t = "hydrate_many_post_op" ; t = "hydrate_one_post_op" ; t = "runtime_sql_conn_from_hydrator"), lazy_span(c, loc, _).
lazy_fdiag(f, s, "LA-011", 0) :- lazy_apick(f, "hydration", s).
lazy_fdiag(f, s, "LA-012", 0) :- !lazy_legacy(f), lazy_af(f), lazy_apick(f, "resolve", s).
lazy_fdiag(f, s, "LA-013", 0) :- lazy_ev(f, e, "forbidden_pure", _), lazy_pure(f), lazy_evstart(e, s).
lazy_fdiag(f, s, "LA-013", 0) :- lazy_legacymatch(f, s).
lazy_fdiag(f, s, "LA-013", 1) :- lazy_nonlazy(f, s).
lazy_fdiag(f, s, "LA-014", 1) :- lazy_ev(f, e, cat, _), (cat = "payload" ; cat = "dynamic"), lazy_la014path(f), lazy_evstart(e, s).
lazy_la014path(f) :- lazy_fpath(f, _, p), prefix("impl/common/l2070_server_plan/", p).
lazy_la014path(f) :- lazy_fpath(f, _, p), p = "impl/common/l2200_sql_dialect/sql_connection.py".
lazy_la014path(f) :- lazy_fpath(f, _, p), p = "l2070_batching/post_op.py".
lazy_fdiag(f, s, "LA-015", 1) :- lazy_ev(f, e, "of_return", _), lazy_bootstrap(f), lazy_evstart(e, s).
lazy_fdiag(f, s, "LA-016", 1) :- lazy_ev(f, e, "bootstrap", _), lazy_bootstrap(f), lazy_pure(f), lazy_evstart(e, s).
lazy_fdiag(f, s, "LA-017", 1) :- lazy_ev(f, e, cat, _), (cat = "reconciliation" ; cat = "absence"), lazy_reconciliation(f), lazy_evstart(e, s).
lazy_fdiag(f, s, "LA-017", 1) :- lazy_evresolve(f, e), lazy_reconname(f), lazy_fpath(f, _, p), prefix("impl/common/l2200_sql_dialect/", p), lazy_evstart(e, s).
lazy_fdiag(f, s, "LA-017", 1) :- lazy_evresolve(f, e), lazy_reconname(f), lazy_fpath(f, _, p), p = "l2000_connection/schema_transaction.py", lazy_evstart(e, s).
lazy_fdiag(f, s, "LA-017", 1) :- lazy_reconciliation(f), lazy_fpath(f, _, p), lazy_fqual(f, q), key = @concat(@concat(p, "::"), q), lazy_cutover(key), lazy_fstart(f, s).
