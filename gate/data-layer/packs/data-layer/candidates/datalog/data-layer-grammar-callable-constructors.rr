.decl constructor_fdef(kind: symbol)
constructor_fdef("function_definition").
.decl constructor_scope_kinds(kind: symbol)
constructor_scope_kinds("function_definition"). constructor_scope_kinds("module").
.decl k0(kind: symbol)
k0("function_definition").
.decl k1(kind: symbol)
k1("class_definition").
