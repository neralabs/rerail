.scope text "**/*.[mM][dD]", "**/*.[mM][aA][rR][kK][dD][oO][wW][nN]", "**/*.[rR][sS][tT]", "**/*.[tT][xX][tT]", "**/*.[tT][oO][mM][lL]", "**/*.[cC][fF][gG]", "**/*.[iI][nN][iI]", "**/*.[yY][aA][mM][lL]", "**/*.[yY][mM][lL]"
.decl constructor_fdef(kind: symbol)
constructor_fdef("function_definition").
.decl constructor_scope_kinds(kind: symbol)
constructor_scope_kinds("function_definition"). constructor_scope_kinds("module").
.decl k0(kind: symbol)
k0("function_definition").
.decl k1(kind: symbol)
k1("class_definition").
.decl untyped_class_kinds(kind: symbol)
untyped_class_kinds("class_definition").
.decl any_type(t: node)
.decl child(p: node, c: node, i: number)
.decl constructor_arg(n: node, x: symbol)
.decl constructor_callee(f: node)
.decl constructor_candidate(n: node, x: symbol)
.decl constructor_climb(n: node, s: node)
