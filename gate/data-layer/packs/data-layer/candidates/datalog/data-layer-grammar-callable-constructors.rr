untyped_param_kinds("typed_parameter").
untyped_param_kinds("typed_default_parameter").
untyped_param_kinds("default_parameter").
in_scope(d) :- doc(d, p, _), glob("impl/common/l2100_sql_grammar/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/fragments.py", p).
tape_syntax_error(d) :- syntax_error(d).
m5(n) :- node(_, n, "identifier", _, _), text(n, v2), v2 = "SimpleNamespace".
m5(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v3), node(_, v3, "identifier", _, _), text(v3, v4), v4 = "SimpleNamespace".
