.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl intval(n: node, v: int)
.decl op(n: node, s: sym)
.decl line(n: node, l: int)
.input doc, node, child, field, text, intval, op, line
.decl name(n: node, s: sym)
name($n, $s) :- text($n, $s).
name($n, @cat($o, $a)) :- node(_, $n, "attribute", _, _), field($n, "object", $x), name($x, $o), field($n, "attribute", $y), text($y, $a).
.kindset k0 = "class_definition" | "function_definition"
.decl in_scope(d: int)
.decl m1(n: node)
.decl m11(n: node)
.decl m12(n: node)
.decl m15(n: node)
.decl m20(n: node)
.decl m22(n: node)
.decl m3(n: node)
.decl m4(n: node)
.decl m8(n: node)
.decl out_scope(d: int)
.decl u17(n: node)
.decl u18(n: node)
.decl violation(rule: sym, clause: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "data_layer/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
m1($n) :- node(_, $n, "import_statement", _, _).
m1($n) :- node(_, $n, "import_from_statement", _, _).
m3($n) :- node(_, $n, "function_definition", _, _).
m3($n) :- node(_, $n, "class_definition", _, _).
m4($n) :- inside($n, $v2, k0), m3($v2).
m8($n) :- name($n, $v7), @prefix($v7, "_").
m11($n) :- node(_, $n, "function_definition", _, _).
m11($n) :- node(_, $n, "class_definition", _, _).
m12($n) :- inside($n, $v10, k0), m11($v10).
m15($n) :- name($n, $v14), @prefix($v14, "_").
m20($n) :- node(_, $n, "identifier", _, _).
m20($n) :- node(_, $n, "attribute", _, _), field($n, "attribute", $v19), node(_, $v19, "identifier", _, _).
u18($n) :- m20($n).
m22($n) :- u18($n).
m22($n) :- node(_, $n, "assignment", _, _), field($n, "right", $v21), u17($v21).
u17($n) :- m22($n).
.output violation
