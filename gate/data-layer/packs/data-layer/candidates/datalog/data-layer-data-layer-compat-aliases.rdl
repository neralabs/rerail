.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl field(p: node, f: sym, c: node)
.decl name(n: node, s: sym)
.input doc, node, field, name
.kindset k0 = "class_definition" | "function_definition"
.decl in_scope(d: int)
.decl m1(n: node)
.decl m12(n: node)
.decl m13(n: node)
.decl m17(n: node)
.decl m22(n: node)
.decl m24(n: node)
.decl m3(n: node)
.decl m4(n: node)
.decl m9(n: node)
.decl out_scope(d: int)
.decl u19(n: node)
.decl u20(n: node)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "data_layer/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
m1($n) :- node(_, $n, "import_statement", _, _).
m1($n) :- node(_, $n, "import_from_statement", _, _).
m3($n) :- node(_, $n, "function_definition", _, _).
m3($n) :- node(_, $n, "class_definition", _, _).
m4($n) :- inside($n, $v2, k0), m3($v2).
m9($n) :- name($n, $v8), @prefix($v8, "_").
m12($n) :- node(_, $n, "function_definition", _, _).
m12($n) :- node(_, $n, "class_definition", _, _).
m13($n) :- inside($n, $v11, k0), m12($v11).
m17($n) :- name($n, $v16), @prefix($v16, "_").
m22($n) :- node(_, $n, "identifier", _, _).
m22($n) :- node(_, $n, "attribute", _, _), field($n, "attribute", $v21), node(_, $v21, "identifier", _, _).
u20($n) :- m22($n).
m24($n) :- u20($n).
m24($n) :- node(_, $n, "assignment", _, _), field($n, "right", $v23), u19($v23).
u19($n) :- m24($n).
.output violation
