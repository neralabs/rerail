.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl fstring_piece(n: node, i: number, kind: symbol, v: symbol)
.decl fstring_template(n: node, marker: symbol, v: symbol)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl observations_bad(key: symbol)
.decl observations_entry(e: symbol)
.decl observations_list(key: symbol)
.decl observations_on(e: symbol)
.decl observations_valid(a: symbol, b: symbol)
.decl op(n: node, s: symbol)
.decl option_json(name: symbol, pointer: symbol, v: symbol)
.decl option_value(name: symbol, v: symbol)
.decl out_scope(d: number)
.decl plan_ann(a: node, t: node)
.decl plan_ann_string(a: node, x: node)
.decl plan_ann_token(a: node, s: symbol)
.decl plan_ann_word(s: symbol)
.decl plan_call(d: number, c: node, f: node)
.decl plan_concat_part(x: node)
.decl plan_doc(d: number)
.decl plan_dotted(y: node, s: symbol)
.decl plan_dotted_parts(dn: node)
.decl plan_fragment_has(f: node, x: symbol)
.decl plan_import_dotted(y: node)
.decl plan_import_later(n: node, i: number)
.decl plan_import_name(n: node, i: number, s: symbol)
.decl plan_imported(n: node, s: symbol)
.decl plan_later_fragment(f: node)
.decl plan_method(d: number, f: node, c: node, x: symbol, s: number, e: number)
.decl plan_mutable(x: symbol)
.decl plan_mutable_ann(v: node)
.decl plan_mutable_name(v: node)
.decl plan_not_name(n: node)
.decl plan_param(p: node)
.decl plan_paren_in(e: node, m: node)
.decl plan_paren_root(e: node)
.decl plan_ret(f: node, v: node)
.decl plan_returns(f: node, v: node)
.decl plan_runtime_import(n: node)
.decl plan_terminal(x: symbol)
.decl plan_toplevel_class(c: node)
.decl plan_tparam(p: node)
.decl plan_tparam_list(l: node)
.decl plan_unparen(e: node, m: node)
.decl plan_within(x: node, t: node)
.decl plan_word_runtime(s: symbol)
.decl rr_agg1(i: number, x: symbol, y: node)
.decl rr_agg2(i: number, v: symbol, x: node)
.decl str(n: node, s: symbol)
.decl syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, line, syntax_error, child, field, text, str, value, value_type_of, fstring_piece, fstring_template, op
.output violation
observations_entry("all").
observations_entry("run_behavior_probes").
observations_list("fingerprints").
observations_list("firstRefs").
observations_list("secondRefs").
option_value("entryPoint", "all").
option_value("parameters", "{}").
plan_mutable("dict").
plan_mutable("list").
plan_mutable("set").
plan_terminal("commit").
plan_terminal("execute").
plan_terminal("execute_async").
plan_terminal("execute_sync").
plan_terminal("resolve").
plan_terminal("resolve_async").
plan_terminal("rollback").
in_scope(d) :- doc(d, p, _), glob("l2070_batching/semantic_plan.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/conform/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.pytest_cache/**", p).
out_scope(d) :- doc(d, p, _), glob("**/node_modules/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/browser_build/**", p).
violation("data-layer-plan-composition-architecture", "source-syntax", "NATIVE-SYNTAX", p, l) :- node(_, n, "module", _, _), node(d, n, _, _, _), in_scope(d), syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
plan_doc(d) :- in_scope(d), !out_scope(d), !syntax_error(d).
plan_word_runtime(s) :- plan_imported(_, s), (contains("cache", s) ; contains("connection", s) ; contains("executor", s) ; contains("plan_flush", s) ; contains("runtime_services", s) ; contains("transaction", s)).
plan_import_dotted(y) :- plan_doc(d), node(d, n, "import_from_statement", _, _), field(n, "module_name", y), node(_, y, "dotted_name", _, _).
plan_import_dotted(y) :- plan_doc(d), node(d, n, "import_from_statement", _, _), field(n, "module_name", r), node(_, r, "relative_import", _, _), child(r, y, _), node(_, y, "dotted_name", _, _).
plan_import_dotted(y) :- plan_doc(d), node(d, n, "import_statement", _, _), child(n, y, _), node(_, y, "dotted_name", _, _).
plan_import_dotted(y) :- plan_doc(d), node(d, n, "import_statement", _, _), child(n, x, _), node(_, x, "aliased_import", _, _), field(x, "name", y).
rr_agg1(i, x, y) :- child(y, c, i), node(_, c, "identifier", _, _), text(c, x).
plan_dotted(y, s) :- plan_import_dotted(y), s = join x by (i) sep "." : { rr_agg1(i, x, y) }.
plan_imported(n, m) :- plan_doc(d), node(d, n, "import_from_statement", _, _), field(n, "module_name", y), plan_dotted(y, m).
plan_imported(n, m) :- plan_doc(d), node(d, n, "import_from_statement", _, _), field(n, "module_name", r), node(_, r, "relative_import", _, _), child(r, y, _), plan_dotted(y, m).
plan_import_name(n, i, s) :- plan_doc(d), node(d, n, "import_statement", _, _), child(n, x, i), node(_, x, "dotted_name", _, _), plan_dotted(x, s).
plan_import_name(n, i, s) :- plan_doc(d), node(d, n, "import_statement", _, _), child(n, x, i), node(_, x, "aliased_import", _, _), field(x, "name", y), plan_dotted(y, s).
plan_import_later(n, i) :- plan_import_name(n, i, _), plan_import_name(n, j, _), j > i.
plan_runtime_import(n) :- plan_imported(n, s), plan_word_runtime(s).
plan_runtime_import(n) :- node(_, n, "import_from_statement", _, _), plan_imported(n, s), (suffix(".lazy_result", s) ; suffix(".lazy_seq", s)).
plan_runtime_import(n) :- plan_import_name(n, i, s), !plan_import_later(n, i), (suffix(".lazy_result", s) ; suffix(".lazy_seq", s)).
violation("data-layer-plan-composition-architecture", "plan-composition", "SPC-001", p, l) :- plan_runtime_import(n), node(d, n, _, _, _), doc(d, p, _), line(n, l).
plan_ann(a, t) :- plan_doc(d), node(d, a, "assignment", _, _), field(a, "type", t).
plan_ann_word(s) :- plan_ann_token(_, s), (contains("Connection", s) ; contains("Cursor", s) ; contains("Executor", s) ; contains("LazyResult", s) ; contains("PlanFlushContext", s) ; contains("Transaction", s)).
plan_within(x, t) :- plan_ann(_, t), node(d, t, _, ts, te), node(d, x, _, xs, xe), xs >= ts, xe <= te.
plan_concat_part(x) :- node(_, c, "concatenated_string", _, _), child(c, x, _).
plan_ann_string(a, x) :- plan_ann(a, t), plan_within(x, t), node(_, x, k, _, _), (k = "string" ; k = "concatenated_string"), !plan_concat_part(x).
plan_ann_token(a, s) :- plan_ann(a, t), plan_within(x, t), node(_, x, "identifier", _, _), text(x, s).
plan_ann_token(a, s) :- plan_ann_string(a, x), fstring_template(x, "{}", s).
plan_ann_token(a, s) :- plan_ann_string(a, x), !fstring_template(x, "{}", _), value_type_of(x, "str"), value(x, s).
plan_ann_token(a, s) :- plan_ann_string(a, x), node(_, x, "string", _, _), value_type_of(x, "bytes"), str(x, s).
rr_agg2(i, v, x) :- child(x, c, i), str(c, v).
plan_ann_token(a, s) :- plan_ann_string(a, x), node(_, x, "concatenated_string", _, _), value_type_of(x, "bytes"), s = join v by (i) sep "" : { rr_agg2(i, v, x) }.
plan_ann_token(a, s) :- plan_ann(a, t), plan_within(x, t), node(_, x, "format_specifier", _, _), fstring_piece(x, _, "literal", s).
violation("data-layer-plan-composition-architecture", "plan-composition", "SPC-002", p, l) :- plan_ann(a, _), plan_ann_token(a, s), plan_ann_word(s), node(d, a, _, _, _), doc(d, p, _), line(a, l).
plan_toplevel_class(c) :- plan_doc(d), node(d, c, "class_definition", _, _), field(c, "name", y), text(y, "SemanticPlanBuilder"), child(m, c, _), node(_, m, "module", _, _).
plan_toplevel_class(c) :- plan_doc(d), node(d, c, "class_definition", _, _), field(c, "name", y), text(y, "SemanticPlanBuilder"), child(dd, c, _), node(_, dd, "decorated_definition", _, _), child(m, dd, _), node(_, m, "module", _, _).
plan_method(d, f, c, x, s, e) :- plan_toplevel_class(c), field(c, "body", b), child(b, f, _), node(d, f, "function_definition", s, e), !op(f, "async"), field(f, "name", y), text(y, x).
plan_method(d, f, c, x, s, e) :- plan_toplevel_class(c), field(c, "body", b), child(b, dd, _), node(_, dd, "decorated_definition", s, _), child(dd, f, _), node(d, f, "function_definition", _, e), !op(f, "async"), field(f, "name", y), text(y, x).
plan_paren_root(v) :- plan_returns(_, v).
plan_paren_root(r) :- plan_ret(_, v), node(_, v, "subscript", _, _), field(v, "value", r).
plan_paren_root(fn) :- plan_call(_, c, _), field(c, "function", fn).
plan_paren_in(e, e) :- plan_paren_root(e).
plan_paren_in(e, c) :- plan_paren_in(e, m), node(_, m, "parenthesized_expression", _, _), child(m, c, _).
plan_unparen(e, m) :- plan_paren_in(e, m), !node(_, m, "parenthesized_expression", _, _).
plan_mutable_name(v) :- node(_, v, "identifier", _, _), text(v, x), plan_mutable(x).
plan_mutable_name(v) :- node(_, v, "attribute", _, _), field(v, "attribute", y), text(y, x), plan_mutable(x).
plan_mutable_ann(v) :- plan_ret(_, v), plan_mutable_name(v).
plan_mutable_ann(v) :- plan_ret(_, v), node(_, v, "subscript", _, _), field(v, "value", r), plan_unparen(r, r2), plan_mutable_name(r2).
plan_mutable_ann(v) :- plan_ret(_, v), node(_, v, "generic_type", _, _), child(v, r, 0), node(_, r, "identifier", _, _), text(r, x), plan_mutable(x).
plan_returns(f, v) :- plan_method(_, f, _, _, _, _), field(f, "return_type", t), node(_, t, "type", _, _), child(t, v, 0).
plan_returns(f, v) :- plan_method(_, f, _, _, _, _), field(f, "return_type", v), !node(_, v, "type", _, _).
plan_ret(f, m) :- plan_returns(f, v), plan_unparen(v, m).
violation("data-layer-plan-composition-architecture", "plan-composition", "SPC-004", p, l) :- plan_method(d, f, _, x, _, _), !prefix("_", x), plan_ret(f, v), plan_mutable_ann(v), doc(d, p, _), line(f, l).
plan_call(d, c, f) :- plan_method(d, f, _, _, s, e), node(d, c, "call", cs, ce), cs >= s, ce <= e.
violation("data-layer-plan-composition-architecture", "plan-composition", "SPC-003", p, l) :- plan_call(d, c, _), field(c, "function", fn), plan_unparen(fn, a), node(_, a, "attribute", _, _), field(a, "attribute", y), text(y, x), plan_terminal(x), doc(d, p, _), line(c, l).
plan_later_fragment(f) :- plan_method(_, f, c, "add_fragment", s, _), plan_method(_, g, c, "add_fragment", t, _), g != f, t < s.
plan_not_name(n) :- node(_, a, "attribute", _, _), field(a, "attribute", n).
plan_not_name(n) :- node(_, dn, "dotted_name", _, _), child(dn, m, j), node(_, m, "identifier", _, _), child(dn, n, i), j < i.
plan_not_name(n) :- node(_, k, "keyword_argument", _, _), field(k, "name", n).
plan_not_name(n) :- node(_, f, "function_definition", _, _), field(f, "name", n).
plan_not_name(n) :- node(_, c, "class_definition", _, _), field(c, "name", n).
plan_param(p) :- node(_, ps, k, _, _), (k = "parameters" ; k = "lambda_parameters"), child(ps, p, _).
plan_param(q) :- plan_param(p), node(_, p, "typed_parameter", _, _), child(p, q, _), node(_, q, "list_splat_pattern", _, _).
plan_param(q) :- plan_param(p), node(_, p, "typed_parameter", _, _), child(p, q, _), node(_, q, "dictionary_splat_pattern", _, _).
plan_not_name(n) :- plan_param(n), node(_, n, "identifier", _, _).
plan_not_name(n) :- plan_param(p), child(p, n, _), node(_, n, "identifier", _, _), !field(p, "value", n).
plan_tparam_list(l) :- node(_, o, k, _, _), (k = "function_definition" ; k = "class_definition"), field(o, "type_parameters", l).
plan_tparam_list(l) :- node(_, o, "type_alias_statement", _, _), field(o, "left", t), node(_, t, "generic_type", _, _), child(t, l, _), node(_, l, "type_parameter", _, _).
plan_tparam_list(l) :- node(_, o, "type_alias_statement", _, _), field(o, "left", t), node(_, t, "type", _, _), child(t, g, _), node(_, g, "generic_type", _, _), child(g, l, _), node(_, l, "type_parameter", _, _).
plan_tparam(p) :- plan_tparam_list(l), child(l, p, _), node(_, p, "type", _, _).
plan_tparam(p) :- plan_tparam_list(l), child(l, e, _), node(_, e, "type_default", _, _), field(e, "name", p).
plan_not_name(n) :- plan_tparam(p), child(p, n, _), node(_, n, "identifier", _, _).
plan_not_name(n) :- plan_tparam(p), child(p, c, _), node(_, c, "constrained_type", _, _), child(c, t, 0), child(t, n, _), node(_, n, "identifier", _, _).
plan_not_name(n) :- plan_tparam(p), child(p, s, _), node(_, s, "splat_type", _, _), child(s, n, _), node(_, n, "identifier", _, _).
plan_not_name(n) :- node(d, i, "import_statement", is, ie), node(d, n, "identifier", s, _), s >= is, s < ie.
plan_not_name(n) :- node(d, i, "import_from_statement", is, ie), node(d, n, "identifier", s, _), s >= is, s < ie.
plan_not_name(n) :- node(_, g, k, _, _), (k = "global_statement" ; k = "nonlocal_statement"), child(g, n, _).
plan_not_name(n) :- node(_, x, "except_clause", _, _), field(x, "alias", n), node(_, n, "identifier", _, _).
plan_dotted_parts(dn) :- node(_, dn, "dotted_name", _, _), child(dn, a, i), node(_, a, "identifier", _, _), child(dn, b, j), node(_, b, "identifier", _, _), i < j.
plan_not_name(n) :- node(_, dn, "dotted_name", _, _), child(cp, dn, _), node(_, cp, "case_pattern", _, _), !plan_dotted_parts(dn), child(dn, n, _), node(_, n, "identifier", _, _).
plan_not_name(n) :- node(_, dn, "dotted_name", _, _), child(cp, dn, _), node(_, cp, "keyword_pattern", _, _), !plan_dotted_parts(dn), child(dn, n, _), node(_, n, "identifier", _, _).
plan_not_name(n) :- node(_, k, "keyword_pattern", _, _), child(k, n, _), node(_, n, "identifier", _, _).
plan_not_name(n) :- node(_, s, "splat_pattern", _, _), child(s, n, _), node(_, n, "identifier", _, _).
plan_not_name(n) :- node(_, ap, "as_pattern", _, _), child(cp, ap, _), node(_, cp, "case_pattern", _, _), child(ap, n, _), node(_, n, "identifier", _, _).
plan_fragment_has(f, x) :- plan_method(d, f, _, "add_fragment", s, e), node(d, n, "identifier", ns, ne), ns >= s, ne <= e, text(n, x), (x = "RefRemap" ; x = "rewrite_exact_plan_refs_payload"), !plan_not_name(n).
violation("data-layer-plan-composition-architecture", "plan-composition", "SPC-005", p, l) :- plan_method(d, f, _, "add_fragment", _, _), !plan_later_fragment(f), !plan_fragment_has(f, "RefRemap"), doc(d, p, _), line(f, l).
violation("data-layer-plan-composition-architecture", "plan-composition", "SPC-005", p, l) :- plan_method(d, f, _, "add_fragment", _, _), !plan_later_fragment(f), !plan_fragment_has(f, "rewrite_exact_plan_refs_payload"), doc(d, p, _), line(f, l).
observations_on(e) :- option_value("entryPoint", e), observations_entry(e).
observations_bad(k) :- observations_list(k), ptr = @concat("/", k), option_json("parameters", ptr, _).
observations_bad(k) :- observations_list(k), pre = @concat(@concat("/", k), "/"), option_json("parameters", ptr, _), prefix(pre, ptr), re = @concat(pre, "[0-9]+"), !match(re, ptr).
observations_bad("fingerprints") :- option_json("parameters", ptr, _), prefix("/fingerprints/", ptr), ptr != "/fingerprints/0", ptr != "/fingerprints/1".
observations_valid(a, b) :- observations_on(_), option_json("parameters", "/fingerprints/0", a), option_json("parameters", "/fingerprints/1", b), !observations_bad("fingerprints"), !observations_bad("firstRefs"), !observations_bad("secondRefs").
violation("data-layer-plan-composition-architecture", "composition-runtime-observations", "SPC-012", "l2070_batching/semantic_plan.py", 1) :- observations_valid(a, b), a != b.
violation("data-layer-plan-composition-architecture", "composition-runtime-observations", "SPC-005", "l2070_batching/semantic_plan.py", 1) :- observations_valid(_, _), option_json("parameters", p, v), prefix("/firstRefs/", p), option_json("parameters", q, v), prefix("/secondRefs/", q).
