tape_syntax_error(d) :- syntax_error(d).
direct_execution_attr(a, id, m) :- node(_, a, "attribute", _, _), field(a, "attribute", id), text(id, m), direct_execution_method(m).
direct_execution_row(d, l, m) :- direct_execution_attr(a, _, m), field(c, "function", a), node(d, c, "call", _, _), line(c, l).
direct_execution_row(d, l, m) :- direct_execution_attr(a, id, m), node_text(a, s), (suffix("._execute_direct_internal", s) ; suffix("._execute_direct_internal_async", s) ; suffix("._fetchall", s) ; suffix("._fetchone", s) ; suffix(".execute_grammar_fetchall", s) ; suffix(".execute_grammar_fetchone", s) ; suffix(".fetchall", s) ; suffix(".fetchone", s)), node(d, a, _, _, e), field(c, "function", a), field(c, "arguments", g), node(_, g, _, e, _), line(id, l).
direct_execution_fts(d) :- doc(d, p, _), match(".*(?:(?:^|/)impl/[^/]+/fts/.*\\.py$).*", p).
direct_execution_allowed(d) :- doc(d, p, _), match(".*(?:(?:(?:^|/)impl/browser/sqljs_sqlite3\\.py$|(?:^|/)impl/common/l1000_cache/backends/sqlite\\.py$|(?:^|/)impl/common/l2070_server_plan/base_server_plan\\.py$|(?:^|/)impl/common/l2070_server_plan/execution_guard\\.py$|(?:^|/)impl/common/l2070_server_plan/operations\\.py$|(?:^|/)impl/common/l2070_server_plan/sql_server_plan\\.py$|(?:^|/)impl/common/l2200_sql_dialect/sql_connection\\.py$|(?:^|/)impl/common/l2510_delta_storage/manager\\.py$|(?:^|/)impl/common/l3150_schema_diff/permission_validation\\.py$|(?:^|/)impl/common/l3150_schema_diff/versioning_validation\\.py$|(?:^|/)impl/common/l3250_migrations/data_validation\\.py$|(?:^|/)impl/common/l3250_migrations/executor\\.py$|(?:^|/)impl/common/l5200_sql_query/_aggregation\\.py$|(?:^|/)impl/common/l5200_sql_query/_pagination\\.py$|(?:^|/)impl/common/l5200_sql_query/_read_ops\\.py$|(?:^|/)impl/common/l5200_sql_query/_write_ops\\.py$|(?:^|/)impl/common/l7050_backend_operations/sql_backend_operations\\.py$|(?:^|/)impl/common/l7100_versioned_operations/versioned_operations\\.py$|(?:^|/)impl/common/l7248_sparse_versioned_transactions/sparse_versioned_write_query\\.py$|(?:^|/)impl/common/l7248_sparse_versioned_transactions/sql_sparse_versioned_write_query\\.py$|(?:^|/)impl/common/l7300_cross_branch/sql_cross_branch_query\\.py$|(?:^|/)impl/common/l7300_sql_versioned_transactions/sql_raw_exec_mixin\\.py$|(?:^|/)impl/common/l7300_sql_versioned_transactions/sql_read_transaction\\.py$|(?:^|/)impl/common/l7300_sql_versioned_transactions/sql_write_transaction\\.py$|(?:^|/)impl/common/l7350_revision_graph/revision_graph\\.py$|(?:^|/)impl/common/l9700_sql_graph_query/sql_graph_query\\.py$|(?:^|/)impl/l1595_llm_cache/write_back_queue\\.py$|(?:^|/)impl/sqlite/native_async_wrapper\\.py$|(?:^|/)impl/[^/]+/connection\\.py$|(?:^|/)impl/[^/]+/tests/|(?:^|/)impl/common/.*/tests/|(?:^|/)impl/.*/test_[^/]+\\.py$|(?:^|/)impl/[^/]+/introspector\\.py$|(?:^|/)impl/[^/]+/validator\\.py$|(?:^|/)impl/[^/]+/fts/|(?:^|/)impl/[^/]+/vector/|(?:^|/)impl/[^/]+/sql_batch\\.py$|(?:^|/)impl/[^/]+/transaction\\.py$|(?:^|/)impl/[^/]+/versioned_.*_transaction\\.py$|(?:^|/)impl/[^/]+/query\\.py$|(?:^|/)impl/[^/]+/graph_query\\.py$|(?:^|/)impl/[^/]+/deferred\\.py$|(?:^|/)impl/[^/]+/merge_strategy\\.py$|(?:^|/)impl/[^/]+/backend_operations\\.py$|(?:^|/)impl/[^/]+/query_instrumentation\\.py$|(?:^|/)impl/common/l2070_server_plan/sql_backend_executor\\.py$|(?:^|/)impl/[^/]+/backend_executor\\.py$|(?:^|/)impl/common/l3500_bulk_ops/database_importer\\.py$|(?:^|/)impl/common/l7050_versioned_schema_builder/polymorphic_widening\\.py$|(?:^|/)impl/common/l7100_versioned_operations/ddl_constraint_management\\.py$|(?:^|/)l3200_metadata/schema_lock\\.py$|(?:^|/)l5200_vector_index/content_addressable_pgvector\\.py$)).*", p).
direct_execution_entry(e) :- option_value("entryPoint", e).
direct_execution_code("IDE001") :- option_on("oracleAnalyzer").
direct_execution_code("direct_execution") :- direct_execution_entry(_), !option_on("oracleAnalyzer").
direct_execution_kept(d, l) :- direct_execution_entry(e), e != "scan_fts_manager_source", e != "scan_fts_manager_direct_execution", direct_execution_row(d, l, _), !direct_execution_allowed(d).
direct_execution_kept(d, l) :- direct_execution_row(d, l, "_execute_direct_internal"), direct_execution_fts(d).
direct_execution_kept(d, l) :- direct_execution_row(d, l, "_execute_direct_internal_async"), direct_execution_fts(d).
violation("data-layer-impl-direct-execution", "direct-execution-lines", c, p, l) :- direct_execution_kept(d, l), direct_execution_code(c), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _).
