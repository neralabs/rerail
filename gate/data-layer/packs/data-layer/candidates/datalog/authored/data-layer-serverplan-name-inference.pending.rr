// PENDING (not read by the converter): column-shape of data-layer-serverplan-name-inference, awaiting `op_at`
// (core.rr: op_at(n, i, s), a node's operator tokens in order; `op` reads only a field `operator`, and a Python
// comparison's tokens are in field `operators`, so `op` holds none). When op_at is bound (comparisons included),
// append this to authored/data-layer-serverplan-name-inference.rr (its declarations and column_shape_line_of are
// there). Checked with a stand-in for op_at (`node_text(n, t), match("(?s:.*)==(?s:.*)", t)`): the replay's two
// column-shape events exact.

.decl op_at(n: node, i: number, s: symbol)

// ---- column-shape (SPNI001) ----
// A comparison_operator with a `==` or `!=` token among its children (`has` stopBy neighbor: every child, anonymous
// tokens included; no named child's text is `==`), its text naming a column, `.keys(` or `set(row…)`, on a line
// quoting a shape column.
.decl column_shape_cmp(n: node)
column_shape_cmp(n) :- node(_, n, "comparison_operator", _, _), op_at(n, _, "==").
column_shape_cmp(n) :- node(_, n, "comparison_operator", _, _), op_at(n, _, "!=").
violation("data-layer-serverplan-name-inference", "column-shape", "SPNI001", p, l) :-
    column_shape_cmp(n),
    node_text(n, t), match("(?s:.*)(?:column|\.keys\s*\(|set\s*\(\s*(?:row|rows|value)\s*\))(?s:.*)", t),
    column_shape_line_of(n, s), match("(?s:.*)['\"](?:count|deleted_count|ok|message|__exists|__result)['\"](?s:.*)", s),
    node(d, n, _, _, _), in_scope(d), !out_scope(d), doc(d, p, _), line(n, l).
