// data-layer-post-op-side-effects, clause signed-surface: the policy's relational clause (SQL stages over AST
// evidence rows) as Datalog. Each input is a relation over the documents in scope with a valid parse
// (`syntax: valid`); each stage is a relation named after it (ss_<stage>). Every finding of `findings` and
// POSTOP000 is at l2070_batching/post_op.py, start_byte 0 (the clause's `locations`), so line 1, whether or not
// that file is in the corpus; the bypass-tree query's at each bypassing module's start, line 1.
//
// Options, read from the converter's option facts (the run's resolved options): entryPoint (option_value: the
// `query` and `trusted_overrides` cases), fateOverrides (option_item), fatesSignature and surfaceSignature
// (option_value; see [signed-default]). All followed.
//
// Signatures. The stages fate_valid, surface_valid and runtime_valid call verify_ed25519(key, message, signature)
// over a canonical JSON message (json_group_array of the sorted entries); the engine has no ed25519, JSON or
// join/group-concat function. Instead:
//   [signed-default] fate_valid and surface_valid check an option. Ed25519 verification is deterministic and the
//             options' default signatures verify (checked offline with PyNaCl against key 7e9776d8…fbb6) exactly
//             one message each: the fates and surface at the pinned revision (ss_fate_signed, ss_surface_signed).
//             A JSON array of distinct strings is an injective encoding of its sorted set, so with the default
//             signature "the signature verifies" is "the entries are exactly that set" (exact, short of an Ed25519
//             forgery). APPROXIMATION: a signature option other than the default (after the cleanup) counts
//             invalid; W verifies it, so a maintainer's re-signing (a new default) needs these facts redone.
//   [runtime-sig] runtime_valid's signature is not a policy constant but the file's ALLOWLIST_SIGNATURE. It counts
//             valid only when the registry is exactly the one signed at the pinned revision (ss_runtime_signed, as
//             a multiset: json_group_array keeps duplicates) and the signature, cleaned as rx_replace does
//             ([^A-Za-z0-9+/=] removed), is the signature recorded for it. APPROXIMATION: any other registry with a
//             fresh valid maintainer signature counts invalid (POSTOP202) here; W verifies it. [b64-lenient]
//             APPROXIMATION: a cleaned signature that is the recorded one plus base64 characters after its "=="
//             padding counts invalid here, as a strict base64 decoder has it; a lenient one (Python's
//             base64.b64decode, which stops at the padding) decodes the same 64 bytes, so it verifies there. The
//             same holds for the signature options. The exact form, with an @ed25519_ok functor, is in the
//             .pending.rr file.
//
// String values. W's `capture.DECODED.text` (substring with value: true) and the `value` matcher read a string's
// decoded value; the engine gives `str`, the content as written. They agree on raw strings and on strings without a
// backslash; a non-raw string with one has no value here [escapes] (APPROXIMATION: that row of strings, registry or
// runtime_refs is missing; a registry string without a value makes runtime_valid false, since its row would be in
// the signed message). A concatenated_string's value is its parts' values joined; one of more than 4 parts, or
// with an f-string part with braces or a bytes part, has no value [parts]. The ALLOWLIST_SIGNATURE literal is
// decoded as Python does for the cleanup only: simple escapes (\n \t \r \\ \' \" \a \b \f \v, backslash-newline)
// give no base64 character;
// an unknown escape keeps its backslash (removed by the cleanup); \x, \u, \U, \N and octal escapes make the
// signature unknown, so invalid [sig-escapes] (APPROXIMATION: W decodes them).
//
// Findings are a set of (path, line, code): the oracle's several rows of one code (one per registry string, per
// membership, …) are one key here.

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl str(n: node, s: symbol)
.decl strprefix(n: node, s: symbol)
.decl op(n: node, s: symbol)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl option_item(name: symbol, v: symbol)
.decl option_value(name: symbol, v: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

.decl ss_unit(x: number)
ss_unit(0).

// ---- inputs -------------------------------------------------------------------------------------------------------

// The documents the inputs read: in scope, with a valid parse (every input says `syntax: valid`).
.decl ss_doc(d: number, p: symbol)
ss_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d).

// A definition at module level: its parent is the module, or a decorated_definition whose parent is the module.
.decl ss_top(n: node)
ss_top(n) :- child(m, n, _), node(_, m, "module", _, _).
ss_top(n) :- child(dd, n, _), node(_, dd, "decorated_definition", _, _), child(m, dd, _), node(_, m, "module", _, _).

// An assignment that is a module-level statement: expression_statement (parent) under the module (grandparent).
.decl ss_top_assign(a: node)
ss_top_assign(a) :- node(_, a, "assignment", _, _), child(es, a, _), node(_, es, "expression_statement", _, _),
    child(m, es, _), node(_, m, "module", _, _).

// An assignment whose `left` is the identifier x.
.decl ss_assign_to(a: node, x: symbol)
ss_assign_to(a, x) :- node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x).

.decl ss_class_k(kind: symbol)
ss_class_k("class_definition").
.decl ss_assign_k(kind: symbol)
ss_assign_k("assignment").
.decl ss_import_k(kind: symbol)
ss_import_k("import_statement"). ss_import_k("import_from_statement").

// functions: module-level function_definitions, their name and span; ss_fn_def those whose text starts `def`
// (`sync`: not async).
.decl ss_fn(d: number, f: node, name: symbol, start: number, end: number)
ss_fn(d, f, x, s, e) :- node(d, f, "function_definition", s, e), ss_doc(d, _), ss_top(f), field(f, "name", nm), text(nm, x).
.decl ss_fn_def(f: node)
ss_fn_def(f) :- ss_fn(_, f, _, _, _), !op(f, "async").

// The first (least start) module-level function of a name in a document.
.decl ss_fn_first(d: number, f: node, name: symbol, start: number, end: number)
ss_fn_first(d, f, x, s, e) :- ss_fn(d, f, x, s, e), s = min t : { ss_fn(d, _, x, t, _) }.

// members: an assignment to an identifier anywhere inside a module-level class (`inside`, stopBy end, so methods'
// assignments too), with that class's name.
.decl ss_member(d: number, cls: symbol, x: symbol)
ss_member(d, c, x) :- ss_assign_to(a, x), node(d, a, _, _, _), ss_doc(d, _), inside(a, k, ss_class_k), ss_top(k),
    field(k, "name", cn), text(cn, c).

// specs: a module-level class named `…Spec`, decorated by `@dataclass` or `@dataclass(…)` (the decorator's own
// child an identifier `dataclass`, or a call whose `function` is one).
.decl ss_dataclass_decorator(dec: node)
ss_dataclass_decorator(dec) :- node(_, dec, "decorator", _, _), child(dec, i, _), node(_, i, "identifier", _, _), text(i, "dataclass").
ss_dataclass_decorator(dec) :- node(_, dec, "decorator", _, _), child(dec, c, _), node(_, c, "call", _, _), field(c, "function", f),
    node(_, f, "identifier", _, _), text(f, "dataclass").
.decl ss_spec(d: number, x: symbol)
ss_spec(d, x) :- node(d, k, "class_definition", _, _), ss_doc(d, _), ss_top(k), field(k, "name", cn), text(cn, x), suffix("Spec", x),
    child(dd, k, _), node(_, dd, "decorated_definition", _, _), child(dd, dec, _), ss_dataclass_decorator(dec).

// A string literal's value (as written, see [escapes] and [parts]).
.decl ss_lit(n: node, v: symbol)
ss_lit(n, v) :- node(_, n, "string", _, _), strprefix(n, p), !contains("f", p), !contains("b", p), contains("r", p), str(n, v).
ss_lit(n, v) :- node(_, n, "string", _, _), strprefix(n, p), !contains("f", p), !contains("b", p), !contains("r", p), str(n, v), !contains("\\", v).
ss_lit(n, v) :- node(_, n, "string", _, _), strprefix(n, p), contains("f", p), !contains("b", p), contains("r", p), str(n, v),
    !contains("{", v), !contains("}", v).
ss_lit(n, v) :- node(_, n, "string", _, _), strprefix(n, p), contains("f", p), !contains("b", p), !contains("r", p), str(n, v),
    !contains("\\", v), !contains("{", v), !contains("}", v).

// A concatenated_string's parts joined. The engine admits no recursion that concatenates along siblings (a value
// cycle not bounded by the tree), so the join is written out for 1 to 4 parts [parts]: APPROXIMATION, a
// concatenated_string of more than 4 parts has no value here.
.decl ss_part(c: node, i: number, v: symbol)
ss_part(c, i, v) :- node(_, c, "concatenated_string", _, _), child(c, s, i), ss_lit(s, v).
.decl ss_join(c: node, v: symbol)
ss_join(c, v) :- ss_part(c, 0, v), !child(c, _, 1).
ss_join(c, cat(a, b)) :- ss_part(c, 0, a), ss_part(c, 1, b), !child(c, _, 2).
ss_join(c, cat(a, cat(b, x))) :- ss_part(c, 0, a), ss_part(c, 1, b), ss_part(c, 2, x), !child(c, _, 3).
ss_join(c, cat(a, cat(b, cat(x, y)))) :- ss_part(c, 0, a), ss_part(c, 1, b), ss_part(c, 2, x), ss_part(c, 3, y), !child(c, _, 4).

// The string evidence: a `string` or `concatenated_string` whose text starts with only r/u prefix letters
// (`(?i)^[ru]*["']`; a concatenated string's text starts with its first part's), in a valid in-scope document.
.decl ss_strnode(d: number, n: node, start: number, end: number)
ss_strnode(d, n, s, e) :- node(d, n, "string", s, e), ss_doc(d, _), strprefix(n, p), match("[ru]*", p).
ss_strnode(d, n, s, e) :- node(d, n, "concatenated_string", s, e), ss_doc(d, _), child(n, f, 0), strprefix(f, p), match("[ru]*", p).

// Its value, where it has one.
.decl ss_val(n: node, v: symbol)
ss_val(n, v) :- ss_strnode(_, n, _, _), node(_, n, "string", _, _), ss_lit(n, v).
ss_val(n, v) :- ss_strnode(_, n, _, _), node(_, n, "concatenated_string", _, _), ss_join(n, v).

// strings: every such string, with its value.
.decl ss_string(d: number, n: node, start: number, end: number, v: symbol)
ss_string(d, n, s, e, v) :- ss_strnode(d, n, s, e), ss_val(n, v).

// registry: the strings anywhere inside a module-level `SIGNED_POST_OP_SYMBOLS = …`; ss_registry_novalue those
// without a value here [escapes].
.decl ss_registry_node(d: number, n: node)
ss_registry_node(d, n) :- ss_strnode(d, n, _, _), inside(n, a, ss_assign_k), ss_assign_to(a, "SIGNED_POST_OP_SYMBOLS"), ss_top_assign(a).
.decl ss_registry(d: number, n: node, v: symbol)
ss_registry(d, n, v) :- ss_registry_node(d, n), ss_val(n, v).
.decl ss_registry_novalue(d: number, n: node)
ss_registry_novalue(d, n) :- ss_registry_node(d, n), !ss_val(n, _).

// signature: the strings anywhere inside a module-level annotated `ALLOWLIST_SIGNATURE: T = …`.
.decl ss_signature(d: number, n: node, start: number)
ss_signature(d, n, s) :- ss_strnode(d, n, s, _), inside(n, a, ss_assign_k), ss_assign_to(a, "ALLOWLIST_SIGNATURE"), field(a, "type", _),
    ss_top_assign(a).

// runtime_refs: a forbidden runtime-ref name as an identifier (not in an import, not the name of a def, class or
// keyword argument, not an attribute's `attribute`), as an attribute's `attribute` (the attribute's row), or as a
// string's value.
.decl ss_ref_name(x: symbol)
ss_ref_name("RebaseResultCollectorSpec"). ss_ref_name("ResolvedRefs"). ss_ref_name("RuntimeReferenceField").
ss_ref_name("RuntimeStructuredResultSpec"). ss_ref_name("lookup_ref"). ss_ref_name("require_runtime_ref").
ss_ref_name("runtime_ref"). ss_ref_name("runtime_ref_ids"). ss_ref_name("runtime_refs"). ss_ref_name("source_ref").
ss_ref_name("source_ref_id"). ss_ref_name("sys_id_ref"). ss_ref_name("validated_expires_at_holder").
ss_ref_name("validation_state_holder"). ss_ref_name("visible_rows_ref").
.decl ss_ref_slot(n: node)
ss_ref_slot(n) :- field(p, "name", n), node(_, p, "function_definition", _, _).
ss_ref_slot(n) :- field(p, "name", n), node(_, p, "class_definition", _, _).
ss_ref_slot(n) :- field(p, "name", n), node(_, p, "keyword_argument", _, _).
ss_ref_slot(n) :- field(p, "attribute", n), node(_, p, "attribute", _, _).
.decl ss_runtime_ref(d: number, n: node)
ss_runtime_ref(d, n) :- node(d, n, "identifier", _, _), ss_doc(d, _), text(n, x), ss_ref_name(x), !inside(n, _, ss_import_k), !ss_ref_slot(n).
ss_runtime_ref(d, n) :- node(d, n, "attribute", _, _), ss_doc(d, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, x), ss_ref_name(x).
ss_runtime_ref(d, n) :- ss_string(d, n, _, _, v), ss_ref_name(v).

// flags: a module-level `ENFORCE_POST_OP_RUNTIME_ALLOWLIST = …`.
.decl ss_flag(d: number)
ss_flag(d) :- ss_assign_to(a, "ENFORCE_POST_OP_RUNTIME_ALLOWLIST"), ss_top_assign(a), node(d, a, _, _, _), ss_doc(d, _).

// verification: a call of `_post_op_allowlist_signature_valid` or `verify_allowlist` (bare, or as an attribute's
// `attribute`), its span and line.
.decl ss_verify_name(x: symbol)
ss_verify_name("_post_op_allowlist_signature_valid"). ss_verify_name("verify_allowlist").
.decl ss_verification(d: number, s: number, e: number, l: number)
ss_verification(d, s, e, l) :- node(d, c, "call", s, e), ss_doc(d, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, x),
    ss_verify_name(x), line(c, l).
ss_verification(d, s, e, l) :- node(d, c, "call", s, e), ss_doc(d, _), field(c, "function", f), node(_, f, "attribute", _, _),
    field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, x), ss_verify_name(x), line(c, l).

// returns: every return_statement, its span and line.
.decl ss_return(d: number, s: number, e: number, l: number)
ss_return(d, s, e, l) :- node(d, r, "return_statement", s, e), ss_doc(d, _), line(r, l).

// ---- stages -------------------------------------------------------------------------------------------------------

// overrides: the fateOverrides items, each split at its first "=" as substr/instr do (no "=": symbol "" and the
// whole entry as fate). ss_override_rest(e, q): q a suffix of e with no "=" before it (suffixes only).
.decl ss_override_rest(e: symbol, q: symbol)
ss_override_rest(e, e) :- option_item("fateOverrides", e).
ss_override_rest(e, t) :- ss_override_rest(e, q), strlen(q) > 0, substr(q, 0, 1) != "=", t = substr(q, 1, 1000000000).
.decl ss_override(entry: symbol, sym: symbol, fate: symbol)
ss_override(e, s, f) :- ss_override_rest(e, q), substr(q, 0, 1) = "=", s = substr(e, 0, strlen(e) - strlen(q)), f = substr(q, 1, 1000000000).
ss_override(e, "", e) :- ss_override_rest(e, "").
.decl ss_override_sym(sym: symbol)
ss_override_sym(s) :- ss_override(_, s, _).

// memberships: PostOpKind/PostOpBehavior members of post_op.py and post_op_specs.py, "Class.NAME".
.decl ss_membership(sym: symbol)
ss_membership(cat(c, cat(".", x))) :- ss_member(d, c, x), ss_doc(d, p), (p = "l2070_batching/post_op.py" ; p = "l2070_batching/post_op_specs.py"),
    (c = "PostOpKind" ; c = "PostOpBehavior").

// fates: each membership's override fate, else audit_required. APPROXIMATION [override-order]: two overrides of one
// symbol give it both fates here (so the fates message is not the signed one); W's scalar subquery takes the first
// in the option's order, which option_item does not keep.
.decl ss_fate(sym: symbol, fate: symbol)
ss_fate(s, f) :- ss_membership(s), ss_override(_, s, f).
ss_fate(s, "audit_required") :- ss_membership(s), !ss_override_sym(s).

// [signed-default]: whether a signature option, cleaned as rx_replace does ([^A-Za-z0-9+/=] removed), is the
// option's default: ss_opt_run(o, q, t) reads option o's value with q left and t left of the default to match
// (suffixes only, as ss_sig_run below).
.decl ss_opt_default(o: symbol, sig: symbol)
ss_opt_default("fatesSignature", "O5p2GYtRWESKK6seL21Gfmhwt2BbRXEnKngA04J0vENAIfu6AjtJFZ19ohuzcRF5cudla5PLEZiRVdCvwyGKAw==").
ss_opt_default("surfaceSignature", "emKOwGOeajpPhSrYX3SEMcDDgJEjK05SpABfUYhg2WFXVJH4GzV55DwdK9Ddy6zisH4M5r1bh1T8OOkaWQYqBg==").
.decl ss_opt_run(o: symbol, q: symbol, t: symbol)
ss_opt_run(o, s, t) :- ss_opt_default(o, t), option_value(o, s).
ss_opt_run(o, q2, t2) :- ss_opt_run(o, q, t), h = substr(q, 0, 1), strlen(h) = 1, match("[A-Za-z0-9+/=]", h), substr(t, 0, 1) = h,
    q2 = substr(q, 1, 1000000000), t2 = substr(t, 1, 1000000000).
ss_opt_run(o, q2, t) :- ss_opt_run(o, q, t), h = substr(q, 0, 1), strlen(h) = 1, !match("[A-Za-z0-9+/=]", h), q2 = substr(q, 1, 1000000000).
.decl ss_opt_signed(o: symbol)
ss_opt_signed(o) :- ss_opt_run(o, "", "").

// fate_valid [signed-default]: fatesSignature is the default and the "symbol=fate" entries are exactly those it signs.
.decl ss_fate_signed(entry: symbol)
ss_fate_signed("PostOpBehavior.EXCEPTION_ONLY=exception_only"). ss_fate_signed("PostOpBehavior.TERMINAL_ARRAY=keep_terminal").
ss_fate_signed("PostOpBehavior.TERMINAL_OBJECT=keep_terminal"). ss_fate_signed("PostOpBehavior.TERMINAL_SCALAR=keep_terminal").
ss_fate_signed("PostOpKind.ASSERT_RESULT=exception_only"). ss_fate_signed("PostOpKind.MATERIALIZE_RESULT=keep_terminal").
.decl ss_fate_entry(entry: symbol)
ss_fate_entry(cat(s, cat("=", f))) :- ss_fate(s, f).
.decl ss_fate_differs(x: number)
ss_fate_differs(0) :- ss_fate_entry(e), !ss_fate_signed(e).
ss_fate_differs(0) :- ss_fate_signed(e), !ss_fate_entry(e).
.decl ss_fate_valid(x: number)
ss_fate_valid(0) :- ss_opt_signed("fatesSignature"), !ss_fate_differs(0).

// surface: post_op.py's PostOpKind/PostOpBehavior members and post_op_specs.py's DomainPostOpDecoderKind members,
// post_op.py's module-level sync `…_post_op` functions, post_op_specs.py's spec classes.
.decl ss_surface(sym: symbol)
ss_surface(cat(c, cat(".", x))) :- ss_member(d, c, x), ss_doc(d, "l2070_batching/post_op.py"), (c = "PostOpKind" ; c = "PostOpBehavior").
ss_surface(cat(c, cat(".", x))) :- ss_member(d, c, x), ss_doc(d, "l2070_batching/post_op_specs.py"), c = "DomainPostOpDecoderKind".
ss_surface(cat("post_op_factory.", x)) :- ss_fn(d, f, x, _, _), ss_doc(d, "l2070_batching/post_op.py"), glob("*_post_op", x), ss_fn_def(f).
ss_surface(cat("post_op_spec.", x)) :- ss_spec(d, x), ss_doc(d, "l2070_batching/post_op_specs.py").

// surface_valid [signed-default]: surfaceSignature is the default and the surface is exactly the set it signs.
.decl ss_surface_signed(sym: symbol)
.decl ss_surface_differs(x: number)
ss_surface_differs(0) :- ss_surface(s), !ss_surface_signed(s).
ss_surface_differs(0) :- ss_surface_signed(s), !ss_surface(s).
.decl ss_surface_valid(x: number)
ss_surface_valid(0) :- ss_opt_signed("surfaceSignature"), !ss_surface_differs(0).

// reachable: the `assertion.*`/`materializer.*` string values strictly inside post_op.py's first
// `post_op_runtime_symbol` (f.start < s.start, s.end <= f.end), and "decoder.DomainPostOpDecoderKind.NAME" for
// post_op_specs.py's DomainPostOpDecoderKind members.
.decl ss_reachable(sym: symbol)
ss_reachable(v) :- ss_string(d, _, s, e, v), ss_doc(d, "l2070_batching/post_op.py"), (prefix("assertion.", v) ; prefix("materializer.", v)),
    ss_fn_first(d, _, "post_op_runtime_symbol", fs, fe), fs < s, fe >= e.
ss_reachable(cat("decoder.", cat(c, cat(".", x)))) :- ss_member(d, c, x), ss_doc(d, "l2070_batching/post_op_specs.py"), c = "DomainPostOpDecoderKind".

// The runtime registry: post_op_allowlist.py's registry strings.
.decl ss_reg(n: node, v: symbol)
ss_reg(n, v) :- ss_registry(d, n, v), ss_doc(d, "l2070_batching/post_op_allowlist.py").
.decl ss_reg_value(v: symbol)
ss_reg_value(v) :- ss_reg(_, v).

// runtime_valid [runtime-sig]: the registry rows are exactly the signed registry (each signed value once, no other
// value, no row without a value) and the first signature string (least start; at a tie, a concatenated_string and
// its first part, the concatenated_string [sig-tie]: APPROXIMATION, SQLite's choice among equal __start is
// unspecified) cleans to the signature recorded for it.
.decl ss_runtime_signed(v: symbol)
.decl ss_runtime_signature(sig: symbol)
ss_runtime_signature("LfKJGRAPH2yBnDMoevmv5KyZcuPE3hsX4bkEUPXblphuoyI3+QG+racYSEau1uxNHvBPDG2bMmsxGgohzanjCQ==").
.decl ss_runtime_differs(x: number)
ss_runtime_differs(0) :- ss_reg_value(v), !ss_runtime_signed(v).
ss_runtime_differs(0) :- ss_runtime_signed(v), !ss_reg_value(v).
ss_runtime_differs(0) :- ss_reg_value(v), k = count : { ss_reg(_, v) }, k > 1.
ss_runtime_differs(0) :- ss_registry_novalue(d, _), ss_doc(d, "l2070_batching/post_op_allowlist.py").

// The signature string: the least start among post_op_allowlist.py's signature strings.
.decl ss_sig_start(s: number)
ss_sig_start(m) :- ss_signature(d, _, _), ss_doc(d, "l2070_batching/post_op_allowlist.py"), m = min s : { ss_signature(d, _, s) }.
.decl ss_sig_node(n: node)
ss_sig_node(n) :- ss_sig_start(m), ss_signature(_, n, m), node(_, n, "concatenated_string", _, _).
ss_sig_node(n) :- ss_sig_start(m), ss_signature(_, n, m), node(_, n, "string", _, _), !ss_sig_concat_at(m).
.decl ss_sig_concat_at(s: number)
ss_sig_concat_at(m) :- ss_sig_start(m), ss_signature(_, n, m), node(_, n, "concatenated_string", _, _).

// The string literals the cleanup reads: the signature string, or each part of it. raw is 1 for an r prefix.
.decl ss_sig_lit(n: node, raw: number, s: symbol)
ss_sig_lit(n, 1, s) :- ss_sig_node(n), node(_, n, "string", _, _), strprefix(n, p), contains("r", p), str(n, s).
ss_sig_lit(n, 0, s) :- ss_sig_node(n), node(_, n, "string", _, _), strprefix(n, p), !contains("r", p), str(n, s).
ss_sig_lit(c, 1, s) :- ss_sig_node(n), node(_, n, "concatenated_string", _, _), child(n, c, _), strprefix(c, p), contains("r", p), str(c, s).
ss_sig_lit(c, 0, s) :- ss_sig_node(n), node(_, n, "concatenated_string", _, _), child(n, c, _), strprefix(c, p), !contains("r", p), str(c, s).

// The cleanup is matched against the recorded signature rather than built (a recursion concatenating characters is
// a value cycle the engine rejects): ss_sig_run(n, raw, q, t) reads literal n with q left to read and t left of
// the recorded signature to match; every step only takes suffixes. A base64 character of the literal must be t's
// next one; any other character is what rx_replace removes. Escapes (non-raw literals): a simple escape decodes to
// a non-base64 character, both characters skipped; an unknown escape keeps its backslash, which is removed; a coded
// escape (\x, \u, \U, \N, octal) stops the run, so the signature does not match [sig-escapes].
.decl ss_simple_escape(e: symbol)
ss_simple_escape("\n"). ss_simple_escape("\\"). ss_simple_escape("'"). ss_simple_escape("\"").
ss_simple_escape("a"). ss_simple_escape("b"). ss_simple_escape("f"). ss_simple_escape("n").
ss_simple_escape("r"). ss_simple_escape("t"). ss_simple_escape("v").
.decl ss_coded_escape(e: symbol)
ss_coded_escape("x"). ss_coded_escape("u"). ss_coded_escape("U"). ss_coded_escape("N").
ss_coded_escape("0"). ss_coded_escape("1"). ss_coded_escape("2"). ss_coded_escape("3").
ss_coded_escape("4"). ss_coded_escape("5"). ss_coded_escape("6"). ss_coded_escape("7").
.decl ss_sig_run(n: node, raw: number, q: symbol, t: symbol)
// A string: from its start, with the whole recorded signature to match.
ss_sig_run(n, r, s, t) :- ss_sig_node(n), node(_, n, "string", _, _), ss_sig_lit(n, r, s), ss_runtime_signature(t).
// A concatenated_string: its first part from there, each next part where the one before it ended.
ss_sig_run(p, r, s, t) :- ss_sig_node(n), node(_, n, "concatenated_string", _, _), child(n, p, 0), ss_sig_lit(p, r, s), ss_runtime_signature(t).
ss_sig_run(p, r, s, t) :- ss_sig_end(o, t), ss_sig_node(n), child(n, o, i), k = i + 1, child(n, p, k), ss_sig_lit(p, r, s).
ss_sig_run(n, r, q2, t2) :- ss_sig_run(n, r, q, t), h = substr(q, 0, 1), strlen(h) = 1, (r = 1 ; h != "\\"), match("[A-Za-z0-9+/=]", h),
    substr(t, 0, 1) = h, q2 = substr(q, 1, 1000000000), t2 = substr(t, 1, 1000000000).
ss_sig_run(n, r, q2, t) :- ss_sig_run(n, r, q, t), h = substr(q, 0, 1), strlen(h) = 1, (r = 1 ; h != "\\"), !match("[A-Za-z0-9+/=]", h),
    q2 = substr(q, 1, 1000000000).
ss_sig_run(n, 0, q2, t) :- ss_sig_run(n, 0, q, t), substr(q, 0, 1) = "\\", e = substr(q, 1, 1), ss_simple_escape(e), q2 = substr(q, 2, 1000000000).
ss_sig_run(n, 0, q2, t) :- ss_sig_run(n, 0, q, t), substr(q, 0, 1) = "\\", e = substr(q, 1, 1), strlen(e) = 1, !ss_simple_escape(e), !ss_coded_escape(e),
    q2 = substr(q, 1, 1000000000).
// ss_sig_end(n, t): literal n read to its end, t of the recorded signature left.
.decl ss_sig_end(n: node, t: symbol)
ss_sig_end(n, t) :- ss_sig_run(n, _, "", t).

// The signature string cleans to the recorded signature: all of it matched at the end of the string, or of the
// concatenated_string's last part.
.decl ss_sig_matches(x: number)
ss_sig_matches(0) :- ss_sig_node(n), node(_, n, "string", _, _), ss_sig_end(n, "").
ss_sig_matches(0) :- ss_sig_node(n), node(_, n, "concatenated_string", _, _), child(n, p, i), k = i + 1, !child(n, _, k), ss_sig_end(p, "").

.decl ss_runtime_valid(x: number)
ss_runtime_valid(0) :- ss_unit(0), !ss_runtime_differs(0), ss_sig_matches(0).

// verifiers: each document's first module-level `assert_post_op_symbol_signed`, and the least line of a
// verification call within its span (none: no row of ss_verifier_first).
.decl ss_verifier(d: number, s: number, e: number)
ss_verifier(d, s, e) :- ss_fn_first(d, _, "assert_post_op_symbol_signed", s, e).
.decl ss_verify_in(d: number, s: number, l: number)
ss_verify_in(d, s, l) :- ss_verifier(d, s, e), ss_verification(d, vs, ve, l), vs >= s, ve <= e.
.decl ss_verifier_first(d: number, s: number, l: number)
ss_verifier_first(d, s, l) :- ss_verify_in(d, s, _), l = min x : { ss_verify_in(d, s, x) }.

// bypass: the documents with the flag, without a verifier, whose verifier verifies nothing, or returns before its
// first verification.
.decl ss_bypass(d: number)
ss_bypass(d) :- ss_doc(d, _), ss_flag(d).
ss_bypass(d) :- ss_doc(d, _), !ss_verifier(d, _, _).
ss_bypass(d) :- ss_verifier(d, s, _), !ss_verifier_first(d, s, _).
ss_bypass(d) :- ss_verifier(d, s, e), ss_verifier_first(d, s, l), ss_return(d, rs, re, rl), rs >= s, re <= e, rl < l.

// The entryPoint option.
.decl ss_entry(ep: symbol)
ss_entry(ep) :- option_value("entryPoint", ep).

// trusted_overrides: every override for entryPoint _collect_violations, else the overrides when fate_valid.
.decl ss_trusted(entry: symbol, sym: symbol, fate: symbol)
ss_trusted(o, s, f) :- ss_override(o, s, f), ss_entry("_collect_violations").
ss_trusted(o, s, f) :- ss_override(o, s, f), ss_entry(ep), ep != "_collect_violations", ss_fate_valid(0).
.decl ss_trusted_sym(sym: symbol)
ss_trusted_sym(s) :- ss_trusted(_, s, _).

// ---- findings ------------------------------------------------------------------------------------------------------

.decl ss_bad_fate(f: symbol)
ss_bad_fate("audit_required"). ss_bad_fate("delete_after_inline"). ss_bad_fate("move_to_domain_step").
ss_bad_fate("move_to_plan_effect"). ss_bad_fate("move_to_sql").
.decl ss_broad(v: symbol)
ss_broad("materializer.generic"). ss_broad("materializer.materialize_result"). ss_broad("materializer.terminal_array").
ss_broad("materializer.terminal_object"). ss_broad("materializer.terminal_scalar").

.decl ss_finding(code: symbol)
// POSTOP200: a runtime ref in post_op.py, post_op_specs.py or post_op_domain_decoders.py.
ss_finding("POSTOP200") :- ss_runtime_ref(d, _), ss_doc(d, p),
    (p = "l2070_batching/post_op.py" ; p = "l2070_batching/post_op_specs.py" ; p = "l2070_batching/post_op_domain_decoders.py").
// POSTOP203: post_op_allowlist.py bypasses verification.
ss_finding("POSTOP203") :- ss_bypass(d), ss_doc(d, "l2070_batching/post_op_allowlist.py").
// POSTOP204: a registry value outside assertion.*, decoder.DomainPostOpDecoderKind.*, materializer.*, or broad.
ss_finding("POSTOP204") :- ss_reg(_, v), !prefix("assertion.", v), !prefix("decoder.DomainPostOpDecoderKind.", v), !prefix("materializer.", v).
ss_finding("POSTOP204") :- ss_reg(_, v), ss_broad(v).
// POSTOP205: a reachable symbol the registry lacks.
ss_finding("POSTOP205") :- ss_reachable(s), !ss_reg_value(s).
// POSTOP206: a registry value not reachable.
ss_finding("POSTOP206") :- ss_reg_value(v), !ss_reachable(v).
// POSTOP202, POSTOP201: the runtime, surface signature does not verify.
ss_finding("POSTOP202") :- ss_unit(0), !ss_runtime_valid(0).
ss_finding("POSTOP201") :- ss_unit(0), !ss_surface_valid(0).
// POSTOP001: a trusted override naming no membership.
ss_finding("POSTOP001") :- ss_trusted(_, s, _), !ss_membership(s).
// POSTOP002: a membership whose trusted fate (else audit_required) must be burnt down.
ss_finding("POSTOP002") :- ss_membership(s), ss_trusted(_, s, f), ss_bad_fate(f).
ss_finding("POSTOP002") :- ss_membership(s), !ss_trusted_sym(s).

.decl ss_any_finding(x: number)
ss_any_finding(0) :- ss_finding(_).

// The query, by entryPoint.
.decl ss_case(ep: symbol)
ss_case("_collect_runtime_allowlist_bypass_violations_from_tree"). ss_case("_collect_violations").
ss_case("_collect_broad_runtime_authority_violations"). ss_case("_collect_exact_runtime_symbol_coverage_violations").
// Any other entryPoint (the default, plugin.reporter): findings, and POSTOP000 when fate_valid fails and there is
// no finding.
violation("data-layer-post-op-side-effects", "signed-surface", c, "l2070_batching/post_op.py", 1) :- ss_entry(ep), !ss_case(ep), ss_finding(c).
violation("data-layer-post-op-side-effects", "signed-surface", "POSTOP000", "l2070_batching/post_op.py", 1) :- ss_entry(ep), !ss_case(ep),
    !ss_fate_valid(0), !ss_any_finding(0).
// _collect_runtime_allowlist_bypass_violations_from_tree: POSTOP203 at the start of each module that bypasses.
violation("data-layer-post-op-side-effects", "signed-surface", "POSTOP203", p, 1) :-
    ss_entry("_collect_runtime_allowlist_bypass_violations_from_tree"), ss_bypass(d), ss_doc(d, p).
// _collect_violations: every finding.
violation("data-layer-post-op-side-effects", "signed-surface", c, "l2070_batching/post_op.py", 1) :- ss_entry("_collect_violations"), ss_finding(c).
// _collect_broad_runtime_authority_violations: POSTOP204 only.
violation("data-layer-post-op-side-effects", "signed-surface", "POSTOP204", "l2070_batching/post_op.py", 1) :-
    ss_entry("_collect_broad_runtime_authority_violations"), ss_finding("POSTOP204").
// _collect_exact_runtime_symbol_coverage_violations: POSTOP205 and POSTOP206.
violation("data-layer-post-op-side-effects", "signed-surface", c, "l2070_batching/post_op.py", 1) :-
    ss_entry("_collect_exact_runtime_symbol_coverage_violations"), ss_finding(c), (c = "POSTOP205" ; c = "POSTOP206").

