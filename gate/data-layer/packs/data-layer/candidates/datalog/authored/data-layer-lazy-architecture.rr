// the files the patterns read (paths: **/*.py, not scripts/**); under entryPoint "scan_files.ast-component",
// "collector-extra" and "analyzed-functions" every pattern is `\b\B`, which matches nothing.
.decl deleted_doc(d: number, p: symbol)
deleted_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), suffix(".py", p), !prefix("scripts/", p),
    !option_value("entryPoint", "scan_files.ast-component"), !option_value("entryPoint", "collector-extra"),
    !option_value("entryPoint", "analyzed-functions").
.decl deleted_at(clause: symbol, d: number, l: number)
deleted_at(c, d, l) :- deleted_doc(d, _), tape_line(d, l, sp), text(sp, t), deleted_surface(c, s), contains(s, t).
.decl deleted_has(clause: symbol, d: number)
deleted_has(c, d) :- deleted_at(c, d, _).
