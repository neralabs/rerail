// data-layer-connection-caches, all four clauses by hand (the converter gaps a regex on an anonymous token and
// `layout`). Source: gate/data-layer/packs/data-layer/candidates/rules-ast/data-layer-connection-caches.json.
// Every `regex` is W's own (the regex crate's search, as W's matcher runs it), written as a whole-string `match`
// (Soufflé's): `(?s:.*)(?:RE)(?s:.*)` (RE's `.` keeps W's meaning), or RE's anchors dropped where it has them, over the text W reads: a node's full
// source text (node_text), a path, a line.
// Options: `sourceGate` is read from option_on (true: the module's text, comments and strings included, matches
// `BranchId|RevisionId|branch_tip|cache|tip_revision`; false: `^`, every module); `oracleAnalyzer` is read by no
// clause.
// No clause asks for `syntax: valid`: files that do not parse are matched too, as W matches them.
.decl option_on(name: symbol)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- shared by every clause ----------------------------------------------------------------------------------
// The source gate: the module's full text matches.
.decl cc_gate(d: number)
cc_gate(d) :- option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, s),
    match("(?s:.*)(?:BranchId|RevisionId|branch_tip|cache|tip_revision)(?s:.*)", s).
cc_gate(d) :- !option_on("sourceGate"), node(d, _, "module", _, _).
// file.path notRegex `(?:^|/)(?:\.pytest_cache|__pycache__|tests)/`.
.decl cc_skipped(d: number)
cc_skipped(d) :- doc(d, p, _), match("(?:(?s:.*)/)?(?:\\.pytest_cache|__pycache__|tests)/(?s:.*)", p).
// The reviewed exceptions, `not any [filePath regex, layout.line regex]`: the path matches the first and the
// node's first line (numbered as `line(n)` numbers it, W's tape lines: tape_line) the second.
.decl cc_exempt(d: number, l: number)
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:staging_bypass\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_expected_tip_revision_id)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:sql_table_hnsw\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_max_layer_cache|_entry_point_cache)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:stmt_versioned\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_tip_revision)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:intent_transaction\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_tip_revision)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:intent_branch_ops\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_tip_revision)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:versioning_intent_steps\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_tip_revision)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:branch_ops_steps\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_tip_revision)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:commit_branch_steps\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_tip_revision)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:sql_versioned_write_transaction\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_cached_tip_revision_id)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:stmt_squash_validation\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_tip_revision_input)(?s:.*)", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s:.*)(?:squash_steps\\.py)", p), tape_line(d, l, sp), text(sp, s),
    match("(?s:.*)(?:_resolved_branch_tip_revision|_branch_tip_scalar_ref_id|_resolved_branch_tip_sql)(?s:.*)", s).
// Every clause's tail at its node n: the exceptions on n's line, the path skip, the gate, the scope.
.decl cc_candidate(n: node)
cc_candidate(n) :- cc_p0_hit(n).
cc_candidate(n) :- cc_p1_hit(n).
cc_candidate(n) :- cc_p2_hit(n).
cc_candidate(n) :- cc_p3_hit(n).
.decl cc_found(n: node, p: symbol, l: number)
cc_found(n, p, l) :- cc_candidate(n), node(d, n, _, _, _), line(n, l), !cc_exempt(d, l), !cc_skipped(d), cc_gate(d),
    in_scope(d), !out_scope(d), doc(d, p, _).

// `has field object regex self$` and `has field attribute <rule>`: an attribute, its object's text ending `self`,
// its attribute identifier's text s.
.decl cc_self_attr(a: node, s: symbol)
cc_self_attr(a, s) :- node(_, a, "attribute", _, _), field(a, "object", o), node_text(o, t), match("(?s:.*)self", t),
    field(a, "attribute", x), node_text(x, s).
// `has field type regex ^dict\[(?:BranchId|RevisionId)`.
.decl cc_keyed(n: node)
cc_keyed(n) :- node(_, n, "assignment", _, _), field(n, "type", t), node_text(t, s), match("dict\\[(?:BranchId|RevisionId)(?s:.*)", s).

// ---- pattern-0: connection-level branch/revision tip cache -----------------------------------------------------
// A `self.<attr>` attribute, attr matching the name regex, followed by `=`, `:`, `==` or `:=` (the policy's
// `precedes` a token `^(?:=|:|==|:=)$`). The tape stores none of those but `==` (RER-131); each marks a place in the
// named structure: an assignment's left side (`=`, and `:` before an annotation), a dict pair's key (`:`), or a
// comparison's first operand before `==`. A `:=` names a plain identifier, never an attribute.
.decl cc_p0_next(a: node)
cc_p0_next(a) :- cc_self_attr(a, _), field(p, "left", a), node(_, p, "assignment", _, _).
cc_p0_next(a) :- cc_self_attr(a, _), field(p, "key", a), node(_, p, "pair", _, _).
cc_p0_next(a) :- cc_self_attr(a, _), child(p, a, 0), node(_, p, "comparison_operator", _, _), op_at(p, 0, "==").
.decl cc_p0_hit(n: node)
cc_p0_hit(a) :- cc_self_attr(a, s), match("_\\w*(?:branch_tip|revision_tip|tip_revision|branch_cache|revision_cache)\\w*", s),
    cc_p0_next(a).
violation("data-layer-connection-caches", "pattern-0", "CC001", p, l) :- cc_p0_hit(n), cc_found(n, p, l).

// ---- pattern-1: connection dict cache keyed by BranchId/RevisionId ---------------------------------------------
.decl cc_p1_hit(n: node)
cc_p1_hit(n) :- cc_keyed(n), field(n, "left", a), cc_self_attr(a, s), match("_\\w*cache\\w*", s).
violation("data-layer-connection-caches", "pattern-1", "CC001", p, l) :- cc_p1_hit(n), cc_found(n, p, l).

// ---- pattern-2: module-level dict keyed by BranchId/RevisionId -------------------------------------------------
// The assignment branch (any depth, as the rule has no `inside`), and a typed_parameter with a direct identifier
// child `^_\w+$`, such a type, and `layout: {before: {to: token, breaks: {min: 1}}}`: the token before it (a `(`
// or `,`, comments passed over) ends on an earlier line. The tape stores neither (RER-131); the token before it ends
// on an earlier line exactly when nothing but space comes before the parameter on its own line.
.decl cc_p2_hit(n: node)
cc_p2_hit(n) :- cc_keyed(n), field(n, "left", x), node(_, x, "identifier", _, _), node_text(x, s), match("_\\w+", s).
cc_p2_hit(n) :- cc_p2_typed(n), node(d, n, _, _, _), line(n, l), tape_line(d, l, sp), text(sp, t), col(n, c),
    match("\\s*", substr(t, 0, c)).
.decl cc_p2_typed(n: node)
cc_p2_typed(n) :- node(_, n, "typed_parameter", _, _), child(n, x, _), node(_, x, "identifier", _, _), node_text(x, xs),
    match("_\\w+", xs), field(n, "type", t), node_text(t, ts), match("dict\\[(?:BranchId|RevisionId)(?s:.*)", ts).
violation("data-layer-connection-caches", "pattern-2", "CC001", p, l) :- cc_p2_hit(n), cc_found(n, p, l).

// ---- pattern-3: instance dict cache mapping BranchId/RevisionId ------------------------------------------------
.decl cc_p3_hit(n: node)
cc_p3_hit(n) :- node(_, n, "assignment", _, _), field(n, "left", a), cc_self_attr(a, s), match("_\\w+", s),
    field(n, "type", t), node_text(t, ts), match("dict\\[(?:BranchId|RevisionId)\\s*,\\s*(?:RevisionId|BranchId)(?s:.*)", ts).
violation("data-layer-connection-caches", "pattern-3", "CC001", p, l) :- cc_p3_hit(n), cc_found(n, p, l).
