// data-layer-connection-caches, all four clauses by hand (the converter gaps a regex on an anonymous token and
// `layout`). Source: gate/data-layer/packs/data-layer/candidates/rules-ast/data-layer-connection-caches.json.
// Every `regex` is W's own (the regex crate's search, as W's matcher runs it), written as a whole-string `match`
// (Soufflé's): `(?s).*(?:RE).*`, or RE's anchors dropped where it has them, over the text W reads: a node's full
// source text (node_text), a path, a line.
// Default options: `sourceGate` true (the module's text, comments and strings included, matches
// `BranchId|RevisionId|branch_tip|cache|tip_revision`); `oracleAnalyzer` is read by no clause.
// No clause asks for `syntax: valid`: files that do not parse are matched too, as W matches them.
// Awaiting relations: data-layer-connection-caches.pending.rr is this file plus the `sourceGate` false case
// (option_on), pattern-0's `==` after a comparison operand (op_at) and pattern-2's typed_parameter branch
// (layout_gap); it replaces this file when those land.
.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl line(n: node, l: number)
.decl node_text(n: node, s: symbol)
.decl tape_line(d: number, l: number, sp: node)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- shared by every clause ----------------------------------------------------------------------------------
// The source gate: the module's full text matches.
.decl cc_gate(d: number)
cc_gate(d) :- node(d, m, "module", _, _), node_text(m, s), match("(?s).*(?:BranchId|RevisionId|branch_tip|cache|tip_revision).*", s).
// file.path notRegex `(?:^|/)(?:\.pytest_cache|__pycache__|tests)/`.
.decl cc_skipped(d: number)
cc_skipped(d) :- doc(d, p, _), match("(?s)(?:.*/)?(?:\\.pytest_cache|__pycache__|tests)/.*", p).
// The reviewed exceptions, `not any [filePath regex, layout.line regex]`: the path matches the first and the
// node's first line (numbered as `line(n)` numbers it, W's tape lines: tape_line) the second.
.decl cc_exempt(d: number, l: number)
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*staging_bypass\\.py", p), tape_line(d, l, sp), text(sp, s),
    match("(?s).*_expected_tip_revision_id.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*sql_table_hnsw\\.py", p), tape_line(d, l, sp), text(sp, s),
    match("(?s).*(?:_max_layer_cache|_entry_point_cache).*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*stmt_versioned\\.py", p), tape_line(d, l, sp), text(sp, s), match("(?s).*_tip_revision.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*intent_transaction\\.py", p), tape_line(d, l, sp), text(sp, s), match("(?s).*_tip_revision.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*intent_branch_ops\\.py", p), tape_line(d, l, sp), text(sp, s), match("(?s).*_tip_revision.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*versioning_intent_steps\\.py", p), tape_line(d, l, sp), text(sp, s),
    match("(?s).*_tip_revision.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*branch_ops_steps\\.py", p), tape_line(d, l, sp), text(sp, s), match("(?s).*_tip_revision.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*commit_branch_steps\\.py", p), tape_line(d, l, sp), text(sp, s),
    match("(?s).*_tip_revision.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*sql_versioned_write_transaction\\.py", p), tape_line(d, l, sp), text(sp, s),
    match("(?s).*_cached_tip_revision_id.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*stmt_squash_validation\\.py", p), tape_line(d, l, sp), text(sp, s),
    match("(?s).*_tip_revision_input.*", s).
cc_exempt(d, l) :- doc(d, p, _), match("(?s).*squash_steps\\.py", p), tape_line(d, l, sp), text(sp, s),
    match("(?s).*(?:_resolved_branch_tip_revision|_branch_tip_scalar_ref_id|_resolved_branch_tip_sql).*", s).
// Every clause's tail at its node n: the exceptions on n's line, the path skip, the gate, the scope.
.decl cc_candidate(n: node)
cc_candidate(n) :- cc_p0_hit(n).
cc_candidate(n) :- cc_p1_hit(n).
cc_candidate(n) :- cc_p2_hit(n).
cc_candidate(n) :- cc_p3_hit(n).
.decl cc_found(n: node, p: symbol, l: number)
cc_found(n, p, l) :- cc_candidate(n), node(d, n, _, _, _), line(n, l), !cc_exempt(d, l), !cc_skipped(d), cc_gate(d),
    in_scope(d), !out_scope(d), doc(d, p, _).

// `has field object regex self$` and `has field attribute <rule>`: an attribute, its object's text ending `self`,
// its attribute identifier's text s.
.decl cc_self_attr(a: node, s: symbol)
cc_self_attr(a, s) :- node(_, a, "attribute", _, _), field(a, "object", o), node_text(o, t), match("(?s).*self", t),
    field(a, "attribute", x), node_text(x, s).
// `has field type regex ^dict\[(?:BranchId|RevisionId)`.
.decl cc_keyed(n: node)
cc_keyed(n) :- node(_, n, "assignment", _, _), field(n, "type", t), node_text(t, s), match("(?s)dict\\[(?:BranchId|RevisionId).*", s).

// ---- pattern-0: connection-level branch/revision tip cache -----------------------------------------------------
// A `self.<attr>` attribute, attr matching the name regex, whose next sibling token (`precedes`, stopBy neighbor,
// anonymous tokens included) matches `^(?:=|:|==|:=)$`. No relation holds token positions, so the places the
// grammar (native/grammars/tree-sitter-python/src/grammar.json) puts one of those tokens right after an
// expression are listed: `=` or `:` after an assignment's left; `:` after an if/elif/while condition, a for's
// iterable, the last expression of an except clause, the last subject of a match, a dict pair's key, a slice's
// start; `==` after a comparison operand (pending: op_at). `:=` follows only identifiers.
// Approximations (noted): `match x,:` (a trailing comma after the last subject) is matched though `,` follows;
// a slice's stop bound followed by a second `:` (`a[:x:]`) is not matched; an f-string `{x=}` (`=` after an
// interpolation's expression) is not matched; a comment between a dict key and its `:` is not seen (W's next
// sibling would be the comment).
.decl cc_p0_condition(kind: symbol)
cc_p0_condition("if_statement"). cc_p0_condition("elif_clause"). cc_p0_condition("while_statement").
.decl cc_p0_token(a: node)
cc_p0_token(a) :- node(_, p, "assignment", _, _), field(p, "left", a).
cc_p0_token(a) :- node(_, p, k, _, _), cc_p0_condition(k), field(p, "condition", a).
cc_p0_token(a) :- node(_, p, "for_statement", _, _), field(p, "right", a).
cc_p0_token(a) :- node(_, p, "pair", _, _), field(p, "key", a).
cc_p0_token(a) :- node(_, p, "slice", s, _), child(p, a, 0), node(_, a, _, s, _).
cc_p0_token(a) :- cc_p0_except_block(p, j), child(p, a, i), i < j, !node(_, a, "comment", _, _), !cc_p0_except_mid(p, i).
cc_p0_token(a) :- cc_p0_last_subject(_, a).
// The except clause's block, child j; cc_p0_except_mid(p, i): a non-comment child after i and before the block.
.decl cc_p0_except_block(p: node, j: number)
cc_p0_except_block(p, j) :- node(_, p, "except_clause", _, _), child(p, b, j), node(_, b, "block", _, _).
.decl cc_p0_except_mid(p: node, i: number)
cc_p0_except_mid(p, i) :- cc_p0_except_block(p, j), child(p, _, i), child(p, c, k), i < k, k < j, !node(_, c, "comment", _, _).
.decl cc_p0_subject(p: node, a: node, i: number)
cc_p0_subject(p, a, i) :- node(_, p, "match_statement", _, _), field(p, "subject", a), child(p, a, i).
.decl cc_p0_last_subject(p: node, a: node)
cc_p0_last_subject(p, a) :- cc_p0_subject(p, a, i), i = max j : { cc_p0_subject(p, _, j) }.
.decl cc_p0_hit(n: node)
cc_p0_hit(a) :- cc_self_attr(a, s), match("_\\w*(?:branch_tip|revision_tip|tip_revision|branch_cache|revision_cache)\\w*", s),
    cc_p0_token(a).
violation("data-layer-connection-caches", "pattern-0", "CC001", p, l) :- cc_p0_hit(n), cc_found(n, p, l).

// ---- pattern-1: connection dict cache keyed by BranchId/RevisionId ---------------------------------------------
.decl cc_p1_hit(n: node)
cc_p1_hit(n) :- cc_keyed(n), field(n, "left", a), cc_self_attr(a, s), match("_\\w*cache\\w*", s).
violation("data-layer-connection-caches", "pattern-1", "CC001", p, l) :- cc_p1_hit(n), cc_found(n, p, l).

// ---- pattern-2: module-level dict keyed by BranchId/RevisionId -------------------------------------------------
// The assignment branch (any depth, as the rule has no `inside`); the typed_parameter branch is pending (layout_gap).
.decl cc_p2_hit(n: node)
cc_p2_hit(n) :- cc_keyed(n), field(n, "left", x), node(_, x, "identifier", _, _), node_text(x, s), match("_\\w+", s).
violation("data-layer-connection-caches", "pattern-2", "CC001", p, l) :- cc_p2_hit(n), cc_found(n, p, l).

// ---- pattern-3: instance dict cache mapping BranchId/RevisionId ------------------------------------------------
.decl cc_p3_hit(n: node)
cc_p3_hit(n) :- node(_, n, "assignment", _, _), field(n, "left", a), cc_self_attr(a, s), match("_\\w+", s),
    field(n, "type", t), node_text(t, ts), match("(?s)dict\\[(?:BranchId|RevisionId)\\s*,\\s*(?:RevisionId|BranchId).*", ts).
violation("data-layer-connection-caches", "pattern-3", "CC001", p, l) :- cc_p3_hit(n), cc_found(n, p, l).
