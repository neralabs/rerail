// data-layer-graphql-plan-ownership: graphql-authority and reported-parser-error (relational, SQL stages over
// CPython's `ast`), by hand over tree-sitter's tree. Source: gate/data-layer/packs/data-layer/rules/data-layer-graphql-plan-ownership.json.
// Options: entryPoint from option_value (the policy's `scan_source` case, else its `default`); parameters is not
// read by either clause.
//
// graphql-authority. Gate: python, syntax valid (W's AST `syntax: valid`, W's own verdict: the tape's tape_syntax_error(d),
// an ERROR or MISSING node), and (entryPoint not "scan_source") the module node's text matches
// `LazyResult|PlanScope|ServerPlan|Transaction` (W's `regex` on the module node: node_text). The pythonAst stage fails
// a file CPython's ast.parse rejects (cpython_syntax_error(d, _, _)), so those give no rows either. The stage
// relations, as CPython's `ast` columns read them:
//   - fn: the nearest enclosing FunctionDef/AsyncFunctionDef, lambdas transparent; a def's decorators, parameter
//     defaults and annotations are in that def; a class's decorators are in the class's fn (graphql_authority_fn).
//   - authority_words: the words of ast.unparse(annotation), scanned by `\A[^A-Za-z_]*([A-Za-z_][\p{L}\p{N}_]*)`.
//     Here: piece by piece (graphql_authority_piece), each piece one unparse writes between non-word characters, so
//     its words are the output's there: each identifier as ast's id (@nfkc of its text, PEP 3131), and each string
//     constant's text as unparse writes it, up to the scan: W's decoded value (escapes decoded, adjacent literals
//     joined) for a str, an f-string's literal pieces (fstring_piece) for a JoinedStr, each character
//     str.isprintable() rejects (which repr writes as `\n`, `\xhh`, `\uhhhh`: a backslash and a word) as " x". One
//     regex says the scan holds a matching word (graphql_authority_word). GAP (blocked: ast.unparse is @unparse, which
//     needs CPython): a bytes constant is read as written, piece by piece (W's value has no bytes text), not as repr
//     writes the bytes; f-string pieces are as 3.12's unparse writes them (`\n`, `\t` escaped); \p{C}/\p{Z} are the
//     regex crate's Unicode tables, not CPython's unicodedata.
//   - authority_seeds: positional-or-keyword, positional-only and keyword-only parameters of a def (not *args,
//     **kwargs) whose annotation has a word in {ServerPlan, BaseServerPlan, _GraphQLServerPlan, LazyResult} or
//     ending in Transaction or PlanScope.
//   - expression_roots: the Name at the bottom of a chain of Attribute.value and Call.func steps (parentheses,
//     which `ast` has no node for, are transparent).
//   - authority_edges / authority: per fn, names assigned (Assign/AnnAssign direct Name targets) from a value whose
//     root is an authority name, to a fixpoint.
// Rows: GPO001 private attribute read on an authority receiver; GPO002 getattr(authority, …); GPO003
// object.__getattribute__(authority, …); GPO004 an annotated field of a @reusable_template class with an authority
// annotation word. Code: the `issue` column; line: the node's line (ast's lineno is the expression's start). Every
// name compared (ast_name: Name id, arg, Attribute attr) is the identifier's ast name, graphql_authority_id (@nfkc).
//
// reported-parser-error. Input: every file in scope; parsed: for entryPoint "scan_source" every one, else those whose
// source matches `ServerPlan|PlanScope|Transaction|LazyResult`; a row (GPO000, line 1) where CPython's ast.parse fails
// (cpython_syntax_error(d, l, msg), CPython 3.13's verdict; l and msg are only the message's, which the
// (path, line, code) key does not carry). The message differs by branch; the key does not.

.decl tape_syntax_error(d: number)
.decl cpython_syntax_error(d: number, l: number, msg: symbol)
.decl option_value(name: symbol, v: symbol)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- graphql-authority -----------------------------------------------------------------------------------------
.decl graphql_authority_file(d: number, p: symbol)
graphql_authority_file(d, p) :- node(d, _, "module", _, _), in_scope(d), !tape_syntax_error(d), !cpython_syntax_error(d, _, _),
    !out_scope(d), graphql_authority_gate(d), doc(d, p, _).
.decl graphql_authority_gate(d: number)
graphql_authority_gate(d) :- option_value("entryPoint", "scan_source"), node(d, _, "module", _, _).
graphql_authority_gate(d) :- !option_value("entryPoint", "scan_source"), node(d, m, "module", _, _), node_text(m, s),
    match("(?s:.*)(?:LazyResult|PlanScope|ServerPlan|Transaction)(?s:.*)", s).

.decl graphql_authority_frame(kind: symbol)
graphql_authority_frame("function_definition"). graphql_authority_frame("decorator").
.decl graphql_authority_type(kind: symbol)
graphql_authority_type("type").

// An identifier's ast name (Name id, arg, attr): CPython NFKC-normalizes identifiers (PEP 3131).
.decl graphql_authority_id(i: node, x: symbol)
graphql_authority_id(i, x) :- node(_, i, "identifier", _, _), text(i, t), x = @nfkc(t).
// fn(n, f): f is n's ast fn.
// mirrors python/ast.rr def_frame (also: a class decorator's fn is the class's fn, as metadata.structure_index visits it)
.decl graphql_authority_fn(n: node, f: node)
graphql_authority_fn(n, f) :- nearest(n, f, graphql_authority_frame), node(_, f, "function_definition", _, _).
graphql_authority_fn(n, f) :- nearest(n, dc, graphql_authority_frame), node(_, dc, "decorator", _, _), child(dd, dc, _),
    field(dd, "definition", f), node(_, f, "function_definition", _, _).
graphql_authority_fn(n, f) :- nearest(n, dc, graphql_authority_frame), node(_, dc, "decorator", _, _), child(dd, dc, _),
    field(dd, "definition", c), node(_, c, "class_definition", _, _), graphql_authority_fn(c, f).

// The pieces of ast.unparse's text the word scan reads (see the header): identifiers; string constants (a string
// not part of a concatenated_string, or a concatenated_string) by W's value or their f-string literal pieces, and
// format specs' literal pieces, each non-printable character as " x"; bytes as written.
.decl graphql_authority_strhost(n: node)
graphql_authority_strhost(n) :- node(_, n, "string", _, _), !graphql_authority_strpart(n).
graphql_authority_strhost(n) :- node(_, n, "concatenated_string", _, _).
.decl graphql_authority_strpart(n: node)
graphql_authority_strpart(n) :- node(_, p, "concatenated_string", _, _), child(p, n, _).
.decl graphql_authority_strtext(n: node, v: symbol)
graphql_authority_strtext(n, v) :- graphql_authority_strhost(n), value(n, v), value_type_of(n, "str").
graphql_authority_strtext(n, v) :- graphql_authority_strhost(n), fstring_piece(n, _, "literal", v).
graphql_authority_strtext(n, v) :- node(_, n, "format_specifier", _, _), fstring_piece(n, _, "literal", v).
.decl graphql_authority_piece(i: node, s: symbol)
graphql_authority_piece(i, s) :- graphql_authority_id(i, s).
graphql_authority_piece(n, s) :- graphql_authority_strtext(n, v), s = @rx_replace(v, "[\\p{C}\\p{Z}--\\x20]", " x").
graphql_authority_piece(n, s) :- node(_, n, "string", _, _), value_type_of(n, "bytes"), str(n, s).
// An annotation (a `type` node) with an authority word.
.decl graphql_authority_word(ty: node)
graphql_authority_word(ty) :- graphql_authority_piece(i, s), inside(i, ty, graphql_authority_type),
    match("(?s)(?:[^A-Za-z_]*[A-Za-z_][\\p{L}\\p{N}_]*[^\\p{L}\\p{N}_])*[^A-Za-z_]*(?:ServerPlan|BaseServerPlan|_GraphQLServerPlan|LazyResult|(?:[A-Za-z_][\\p{L}\\p{N}_]*)?(?:Transaction|PlanScope))(?:[^\\p{L}\\p{N}_].*)?", s).

// authority_seeds: (def, parameter name).
.decl graphql_authority_seed(f: node, x: symbol)
graphql_authority_seed(f, x) :- field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_parameter", _, _),
    child(p, nm, 0), graphql_authority_id(nm, x), field(p, "type", ty), graphql_authority_word(ty).
graphql_authority_seed(f, x) :- field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_default_parameter", _, _),
    field(p, "name", nm), graphql_authority_id(nm, x), field(p, "type", ty), graphql_authority_word(ty).

// expression_roots: root(e, x).
.decl graphql_authority_root(e: node, x: symbol)
graphql_authority_root(e, x) :- graphql_authority_id(e, x).
graphql_authority_root(e, x) :- node(_, e, "parenthesized_expression", _, _), child(e, i, 0), graphql_authority_root(i, x).
graphql_authority_root(e, x) :- node(_, e, "attribute", _, _), field(e, "object", o), graphql_authority_root(o, x).
graphql_authority_root(e, x) :- node(_, e, "call", _, _), field(e, "function", g), graphql_authority_root(g, x).

// An Assign/AnnAssign statement: the outermost assignment of a chain `a = b = v`; its direct Name targets and value.
.decl graphql_authority_inner(a: node)
graphql_authority_inner(a) :- node(_, b, "assignment", _, _), field(b, "right", a), node(_, a, "assignment", _, _).
// mirrors python/ast.rr assign_chain / assign_target / assign_value (here with AnnAssign: one chain of one)
.decl graphql_authority_chain(a: node, b: node)
graphql_authority_chain(a, a) :- node(_, a, "assignment", _, _), !graphql_authority_inner(a).
graphql_authority_chain(a, c) :- graphql_authority_chain(a, b), field(b, "right", c), node(_, c, "assignment", _, _).
.decl graphql_authority_edge(f: node, s: symbol, t: symbol)
graphql_authority_edge(f, s, t) :- graphql_authority_chain(a, b), field(b, "right", v), !node(_, v, "assignment", _, _),
    graphql_authority_root(v, s), graphql_authority_chain(a, b2), field(b2, "left", l), graphql_authority_bare(l, tn),
    graphql_authority_id(tn, t), graphql_authority_fn(a, f).
// A direct Name target: an identifier, or `(t)` (a tuple_pattern of one, no comma), which `ast` reads as Name t.
.decl graphql_authority_bare(l: node, t: node)
graphql_authority_bare(l, l) :- node(_, l, "identifier", _, _).
graphql_authority_bare(l, t) :- node(_, l, "tuple_pattern", _, _), child(l, c, 0), !child(l, _, 1),
    !token(l, _, ",", _, _), graphql_authority_bare(c, t).
// authority(fn, name).
.decl graphql_authority_auth(f: node, x: symbol)
graphql_authority_auth(f, x) :- graphql_authority_seed(f, x).
graphql_authority_auth(f, t) :- graphql_authority_auth(f, s), graphql_authority_edge(f, s, t).

// GPO001: `<authority>._private` in a def.
violation("data-layer-graphql-plan-ownership", "graphql-authority", "GPO001", p, l) :-
    node(d, n, "attribute", _, _), field(n, "attribute", at), graphql_authority_id(at, x), prefix("_", x), field(n, "object", o),
    graphql_authority_fn(n, f), graphql_authority_root(o, r), graphql_authority_auth(f, r),
    graphql_authority_file(d, p), line(n, l).
// A call's first positional argument (ast's args[0]: keywords and **kwargs are not args).
.decl graphql_authority_pos(c: node, a: node, i: number)
graphql_authority_pos(c, a, i) :- node(_, c, "call", _, _), field(c, "arguments", al), node(_, al, "argument_list", _, _),
    child(al, a, i), node(_, a, k, _, _), k != "keyword_argument", k != "dictionary_splat".
.decl graphql_authority_arg0(c: node, a: node)
graphql_authority_arg0(c, a) :- graphql_authority_pos(c, a, i), i = min j : { graphql_authority_pos(c, _, j) }.
// mirrors python/ast.rr unparen
.decl graphql_authority_unparen(e: node, m: node)
graphql_authority_unparen(e, e) :- node(_, e, k, _, _), k != "parenthesized_expression".
graphql_authority_unparen(e, m) :- node(_, e, "parenthesized_expression", _, _), child(e, i, 0), graphql_authority_unparen(i, m).
// GPO002: getattr(<authority>, …).
violation("data-layer-graphql-plan-ownership", "graphql-authority", "GPO002", p, l) :-
    node(d, n, "call", _, _), field(n, "function", g0), graphql_authority_unparen(g0, g), graphql_authority_id(g, "getattr"),
    graphql_authority_arg0(n, a), graphql_authority_fn(n, f), graphql_authority_root(a, r),
    graphql_authority_auth(f, r), graphql_authority_file(d, p), line(n, l).
// GPO003: object.__getattribute__(<authority>, …).
violation("data-layer-graphql-plan-ownership", "graphql-authority", "GPO003", p, l) :-
    node(d, n, "call", _, _), field(n, "function", g0), graphql_authority_unparen(g0, g), node(_, g, "attribute", _, _),
    field(g, "attribute", at), graphql_authority_id(at, "__getattribute__"), field(g, "object", o0),
    graphql_authority_unparen(o0, o), graphql_authority_id(o, "object"), graphql_authority_arg0(n, a), graphql_authority_fn(n, f),
    graphql_authority_root(a, r), graphql_authority_auth(f, r), graphql_authority_file(d, p), line(n, l).
// single_decorators by name: a class's decorators, by Name id / Attribute attr of the expression or a Call's func.
.decl graphql_authority_ref(e: node, x: symbol)
graphql_authority_ref(e, x) :- graphql_authority_id(e, x).
graphql_authority_ref(e, x) :- node(_, e, "attribute", _, _), field(e, "attribute", a), graphql_authority_id(a, x).
// mirrors python/names.rr decorator (by the expression's or its call's Name id / Attribute attr)
.decl graphql_authority_decorator(c: node, x: symbol)
graphql_authority_decorator(c, x) :- field(dd, "definition", c), child(dd, dc, _), node(_, dc, "decorator", _, _),
    child(dc, e0, 0), graphql_authority_unparen(e0, e), !node(_, e, "call", _, _), graphql_authority_ref(e, x).
graphql_authority_decorator(c, x) :- field(dd, "definition", c), child(dd, dc, _), node(_, dc, "decorator", _, _),
    child(dc, e0, 0), graphql_authority_unparen(e0, e), node(_, e, "call", _, _), field(e, "function", g0),
    graphql_authority_unparen(g0, g), graphql_authority_ref(g, x).
// GPO004: an AnnAssign directly in a @reusable_template class's body with an authority annotation word.
violation("data-layer-graphql-plan-ownership", "graphql-authority", "GPO004", p, l) :-
    node(d, c, "class_definition", _, _), graphql_authority_decorator(c, "reusable_template"), field(c, "body", b),
    child(b, es, _), node(_, es, "expression_statement", _, _), child(es, a, 0), node(_, a, "assignment", _, _),
    field(a, "type", ty), graphql_authority_word(ty), graphql_authority_file(d, p), line(a, l).

// ---- reported-parser-error -------------------------------------------------------------------------------------
// The parse fails: CPython's ast.parse rejects the file.
.decl reported_parser_error_invalid(d: number)
reported_parser_error_invalid(d) :- cpython_syntax_error(d, _, _).
violation("data-layer-graphql-plan-ownership", "reported-parser-error", "GPO000", p, 1) :-
    option_value("entryPoint", "scan_source"), reported_parser_error_invalid(d), in_scope(d), !out_scope(d), doc(d, p, _).
// W's rx_matches(source_text, 'ServerPlan|PlanScope|Transaction|LazyResult') searches the file's text.
violation("data-layer-graphql-plan-ownership", "reported-parser-error", "GPO000", p, 1) :-
    !option_value("entryPoint", "scan_source"), reported_parser_error_invalid(d), in_scope(d), !out_scope(d),
    source(d, sp), match_all("ServerPlan|PlanScope|Transaction|LazyResult", sp, _), doc(d, p, _).
