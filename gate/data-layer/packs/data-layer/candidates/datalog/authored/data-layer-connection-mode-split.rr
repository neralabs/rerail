// data-layer-connection-mode-split, clause `mode-split` (relational, partitionBy file), by hand.
// Source: gate/data-layer/packs/data-layer/rules/data-layer-connection-mode-split.json.
//
// The SQL reads CPython's `ast` (the `pythonAst` stage, `canonical`/`a`, columns as
// native/src/code_rule_dsl/value/python_ast/metadata.py at 40e7b6cac builds them: ast_name is the node's first
// str of name/id/arg/attr, ast_line its lineno). Here the same nodes are read on tree-sitter's tree:
// - ClassDef is `class_definition`, its name the `name` field; FunctionDef/AsyncFunctionDef is
//   `function_definition` (async: op "async"). A method (`methods`: field 'body' of a ClassDef) is a def that is a
//   statement of the class's block, bare or decorated. CPython's lineno of a def or class is its `def`/`async`/
//   `class` line (decorators apart), tree-sitter's start line of the definition.
// - Attribute is `attribute` (ast_name its `attribute` field), at its start line (its object's first token).
// - Name is an `identifier` in expression position: not an attribute's `attribute`, not a def/class/keyword/
//   parameter name, not inside an import (imports give alias rows instead), not a `global`/`nonlocal` name, not an
//   `except … as x` alias.
// - Import/ImportFrom alias rows: Import gives the last dotted segment of each imported name, ImportFrom the name;
//   both also give a non-empty asname. Every row sits at the import statement's line.
// The finding's code is the `issue` column, 'connection_mode_split'; the key is (path, line, code).
// The gate (`syntax: valid`, module text matching Async|Connection|…|Sync|…) is !syntax_error(d): every finding is
// a name whose text holds one of the gate's words (Connection, SessionHandle, VersionHandle, Sync, Async), so a file
// with a finding always passes the regex. The outer WHERE reads `parameters` (default "{}": no probeSource, true);
// options (entryPoint, parameters) are at their defaults: the probeSource case is in
// data-layer-connection-mode-split.pending.rr (awaiting option_value).
// Approximations (noted): identifiers inside `case` patterns (MatchClass's cls is a Name, a capture's name is a
// string) are not read as Names; PEP 695 type parameter names are read as Names (CPython: strings); CPython
// NFKC-normalizes identifiers, this reads the source spelling.

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl name(n: node, s: symbol)
.decl op(n: node, s: symbol)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// The old mixed connection classes, and the private connection cores.
.decl mode_split_mixed(s: symbol)
mode_split_mixed("DatabaseConnection"). mode_split_mixed("DoltDBConnection"). mode_split_mixed("MariaDBConnection").
mode_split_mixed("MongoConnection"). mode_split_mixed("Neo4jConnection"). mode_split_mixed("PostgresConnection").
mode_split_mixed("ReadThroughConnection"). mode_split_mixed("SessionHandle"). mode_split_mixed("SqlConnection").
mode_split_mixed("SqliteConnection"). mode_split_mixed("VersionHandle"). mode_split_mixed("VersionedDatabaseConnection").
.decl mode_split_core(s: symbol)
mode_split_core("_DatabaseConnectionCore"). mode_split_core("_SqlConnectionCore"). mode_split_core("_VersionedDatabaseConnectionCore").
// Files where a private core may be named.
.decl mode_split_core_home(p: symbol)
mode_split_core_home("impl/common/l2200_sql_dialect/sql_connection.py"). mode_split_core_home("impl/doltdb/connection.py").
mode_split_core_home("impl/mariadb/connection.py"). mode_split_core_home("impl/mongodb/connection.py").
mode_split_core_home("impl/neo4j/connection.py"). mode_split_core_home("impl/postgres/connection.py").
mode_split_core_home("impl/read_through/connection.py"). mode_split_core_home("impl/sqlite/connection.py").
mode_split_core_home("l2000_connection/connection.py"). mode_split_core_home("l2000_connection/connection_pool.py").
mode_split_core_home("l7000_versioned_schema/versioned_connection.py").
.decl mode_split_core_allowed(d: number)
mode_split_core_allowed(d) :- doc(d, p, _), mode_split_core_home(p).
mode_split_core_allowed(d) :- doc(d, p, _), prefix("impl/", p).
mode_split_core_allowed(d) :- doc(d, p, _), prefix("l2070_batching/", p).

// ---- the `symbols` stage: (document, node, symbol), at the node's line ----
// Identifiers that are not ast.Name nodes.
.decl mode_split_not_name(n: node)
mode_split_not_name(n) :- node(_, a, "attribute", _, _), field(a, "attribute", n).
mode_split_not_name(n) :- node(_, p, "function_definition", _, _), field(p, "name", n).
mode_split_not_name(n) :- node(_, p, "class_definition", _, _), field(p, "name", n).
mode_split_not_name(n) :- node(_, p, "keyword_argument", _, _), field(p, "name", n).
mode_split_not_name(n) :- node(_, p, "default_parameter", _, _), field(p, "name", n).
mode_split_not_name(n) :- node(_, p, "typed_default_parameter", _, _), field(p, "name", n).
mode_split_not_name(n) :- node(_, p, "except_clause", _, _), field(p, "alias", n).
mode_split_not_name(n) :- mode_split_params(p), child(p, n, _), node(_, n, "identifier", _, _).
mode_split_not_name(n) :- mode_split_params(p), child(p, s, _), mode_split_splat(s), child(s, n, _), node(_, n, "identifier", _, _).
mode_split_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, n, _), node(_, n, "identifier", _, _).
mode_split_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, s, _), mode_split_splat(s), child(s, n, _), node(_, n, "identifier", _, _).
mode_split_not_name(n) :- node(_, p, "global_statement", _, _), child(p, n, _).
mode_split_not_name(n) :- node(_, p, "nonlocal_statement", _, _), child(p, n, _).
mode_split_not_name(n) :- node(_, n, "identifier", _, _), inside(n, a, mode_split_imports), node(_, a, _, _, _).
mode_split_not_name(n) :- node(_, n, "identifier", _, _), inside(n, a, mode_split_patterns), node(_, a, _, _, _).
.decl mode_split_params(p: node)
mode_split_params(p) :- node(_, p, "parameters", _, _).
mode_split_params(p) :- node(_, p, "lambda_parameters", _, _).
.decl mode_split_splat(s: node)
mode_split_splat(s) :- node(_, s, "list_splat_pattern", _, _).
mode_split_splat(s) :- node(_, s, "dictionary_splat_pattern", _, _).
.decl mode_split_imports(kind: symbol)
mode_split_imports("import_statement"). mode_split_imports("import_from_statement").
.decl mode_split_patterns(kind: symbol)
mode_split_patterns("case_pattern").

.decl mode_split_symbol(d: number, n: node, s: symbol)
// Name.
mode_split_symbol(d, n, s) :- node(d, n, "identifier", _, _), text(n, s), !mode_split_not_name(n).
// Attribute: its attr.
mode_split_symbol(d, a, s) :- node(d, a, "attribute", _, _), field(a, "attribute", x), text(x, s).
// Import: each name's last dotted segment, and its asname.
mode_split_symbol(d, i, s) :- node(d, i, "import_statement", _, _), field(i, "name", x), mode_split_imported(x, dn),
    mode_split_last(dn, c), text(c, s).
mode_split_symbol(d, i, s) :- node(d, i, "import_statement", _, _), field(i, "name", x), node(_, x, "aliased_import", _, _),
    field(x, "alias", a), text(a, s).
// ImportFrom: each name, and its asname.
mode_split_symbol(d, i, s) :- node(d, i, "import_from_statement", _, _), field(i, "name", x), mode_split_imported(x, dn),
    name(dn, s).
mode_split_symbol(d, i, s) :- node(d, i, "import_from_statement", _, _), field(i, "name", x), node(_, x, "aliased_import", _, _),
    field(x, "alias", a), text(a, s).
// mode_split_imported(x, dn): the dotted name an import's `name` child x imports (x itself or its `name` field).
.decl mode_split_imported(x: node, dn: node)
mode_split_imported(x, x) :- node(_, x, "dotted_name", _, _).
mode_split_imported(x, dn) :- node(_, x, "aliased_import", _, _), field(x, "name", dn), node(_, dn, "dotted_name", _, _).
.decl mode_split_last_index(dn: node, i: number)
mode_split_last_index(dn, i) :- mode_split_imported(_, dn), child(dn, _, _), i = max j : { child(dn, _, j) }.
.decl mode_split_last(dn: node, c: node)
mode_split_last(dn, c) :- mode_split_last_index(dn, i), child(dn, c, i).

// ---- the `methods` stage: (class, its name, method, its name) ----
.decl mode_split_method(c: node, cn: symbol, m: node, mn: symbol)
mode_split_method(c, cn, m, mn) :- node(_, c, "class_definition", _, _), field(c, "name", cx), text(cx, cn),
    field(c, "body", b), child(b, m, _), node(_, m, "function_definition", _, _), field(m, "name", mx), text(mx, mn).
mode_split_method(c, cn, m, mn) :- node(_, c, "class_definition", _, _), field(c, "name", cx), text(cx, cn),
    field(c, "body", b), child(b, dd, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", m),
    node(_, m, "function_definition", _, _), field(m, "name", mx), text(mx, mn).
.decl mode_split_async(m: node)
mode_split_async(m) :- node(_, m, "function_definition", _, _), op(m, "async").
// A facade class: name ends with Connection, SessionHandle or VersionHandle.
.decl mode_split_facade(s: symbol)
mode_split_facade(s) :- mode_split_method(_, s, _, _), suffix("Connection", s).
mode_split_facade(s) :- mode_split_method(_, s, _, _), suffix("SessionHandle", s).
mode_split_facade(s) :- mode_split_method(_, s, _, _), suffix("VersionHandle", s).
.decl mode_split_private(s: symbol)
mode_split_private(s) :- mode_split_method(_, _, _, s), prefix("_", s).
.decl mode_split_async_named(s: symbol)
mode_split_async_named(s) :- mode_split_method(_, _, _, s), suffix("_async", s).
// Sync methods an async facade may define.
.decl mode_split_async_allowed(s: symbol)
mode_split_async_allowed("__aenter__"). mode_split_async_allowed("__aexit__"). mode_split_async_allowed("authenticated_session_lazy").
mode_split_async_allowed("branch_id"). mode_split_async_allowed("connection"). mode_split_async_allowed("domain").
mode_split_async_allowed("invalidate_tip_cache"). mode_split_async_allowed("open_read_plan").
mode_split_async_allowed("open_versioned_read_plan"). mode_split_async_allowed("open_versioned_write_plan").
mode_split_async_allowed("open_write_plan"). mode_split_async_allowed("session"). mode_split_async_allowed("session_id").
mode_split_async_allowed("version").
.decl mode_split_mixed_entry(s: symbol)
mode_split_mixed_entry("read"). mode_split_mixed_entry("read_async"). mode_split_mixed_entry("write"). mode_split_mixed_entry("write_async").

// ---- the final query's six branches ----
// mode_split_hit(d, n): a row at node n of document d.
.decl mode_split_hit(d: number, n: node)
// Old mixed connection classes.
mode_split_hit(d, c) :- node(d, c, "class_definition", _, _), field(c, "name", x), text(x, s), mode_split_mixed(s).
// Old mixed connection names.
mode_split_hit(d, n) :- mode_split_symbol(d, n, s), mode_split_mixed(s).
// Private connection cores outside their homes.
mode_split_hit(d, n) :- mode_split_symbol(d, n, s), mode_split_core(s), !mode_split_core_allowed(d).
// Private handle cores defining mixed entry points.
mode_split_hit(d, m) :- mode_split_method(_, cn, m, mn), (cn = "_SessionHandleCore" ; cn = "_VersionHandleCore"),
    mode_split_mixed_entry(mn), node(d, m, _, _, _).
// Sync facades defining public async methods.
mode_split_hit(d, m) :- mode_split_method(_, cn, m, mn), prefix("Sync", cn), mode_split_facade(cn), mode_split_async(m),
    !mode_split_private(mn), node(d, m, _, _, _).
// Async facades defining public sync methods.
mode_split_hit(d, m) :- mode_split_method(_, cn, m, mn), prefix("Async", cn), mode_split_facade(cn), !mode_split_async(m),
    !mode_split_private(mn), !mode_split_async_named(mn), !mode_split_async_allowed(mn), node(d, m, _, _, _).

violation("data-layer-connection-mode-split", "mode-split", "connection_mode_split", p, l) :-
    mode_split_hit(d, n), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
