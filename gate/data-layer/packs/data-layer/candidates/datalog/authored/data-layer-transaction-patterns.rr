// data-layer-transaction-patterns: the clauses the converter gaps on `semantic value` (the utility
// `annotation-connection`'s and `annotation-has-connection`'s `value: {regex}` on string annotations), from
// candidates/rules-ast/data-layer-transaction-patterns.json (utilities in its `shared` clause). Every clause without a
// `when` is here: internal-5, -6, -9, -10, -11, -13, -14, -15, -16 and category-14, -15, -16 (a function named in one
// category), internal-19, -20, -30 … -37, -39 and category-39 (an unclassified function, by name tests and path).
// The `when: {oracleAnalyzer: true}` clauses are off by default and left to the converter. PENDING:
// data-layer-transaction-patterns.pending.rr is the whole rule (all 58 clauses, the string-annotation branches with
// `value`, every option read from the converter-given option_on / option_item); it replaces this file once those
// relations are bound.
//
// Options: each clause is its default options' (an authored clause cannot read options). `sourceGate` is true (the
// module's text must match `Connection|conn`); the `category-*` lists are their defaults (txn_category below), so
// the categories BACKEND_SPECIFIC, CAPABILITY, ADMIN_TOOLS, VALIDATION, SUBSCRIPTION, SCHEMA_OPS, DEPRECATED, BACKEND_OPS, BULK_OPS, NEEDS_REVIEW, TS_BRIDGE, INTERNAL_TXN_VIOLATION are empty and the clauses naming one of them never fire (their regex
// `^(?:)$` matches only an empty name). `oracleAnalyzer` is read by no clause here.
//
// Not exact: an annotation string's value that W cannot know (an f-string with an interpolation, a `str`/bytes mix)
// is Unknown in W; here it is no value, so the string is not a connection (W's verdict there is three-valued).

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
// A node's full source text (core.rr's node_text).
.decl node_text(n: node, s: symbol)
.input doc, node, child, field, text, line, syntax_error, node_text
.output violation

// ---- the utilities -----------------------------------------------------------------------------------------------

// A string annotation (`value: {regex}` on a string / concatenated_string) AWAITS `value`: those two
// branches, of annotation-has-connection and annotation-connection, are in
// data-layer-transaction-patterns.pending.rr (txn_str_value); until then a string annotation is no connection.

// `annotation-has-connection`. Its binary_operator / union_type branch, `L and L` or `not L and R and R`, is
// `L or R`.
.decl txn_ahc(n: node)
txn_ahc(n) :- node(_, n, "identifier", _, _), text(n, s), contains("Connection", s).
txn_ahc(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c), txn_ahc(c).
txn_ahc(n) :- node(_, n, "subscript", _, _), field(n, "value", c), txn_ahc(c).
txn_ahc(n) :- node(_, n, "generic_type", _, _), child(n, c, _), node(_, c, "identifier", _, _), txn_ahc(c).
txn_ahc(n) :- txn_wrapper(n), child(n, c, _), txn_ahc(c).
txn_ahc(n) :- txn_ahc_left(n).
txn_ahc(n) :- txn_ahc_right(n).
// L: the `left` field, or a union_type's first named child, a `type` (`nthChild: 1`).
.decl txn_ahc_left(n: node)
txn_ahc_left(n) :- txn_binop(n), field(n, "left", c), txn_ahc(c).
txn_ahc_left(n) :- node(_, n, "union_type", _, _), child(n, c, 0), node(_, c, "type", _, _), txn_ahc(c).
// R: the `right` field, or a union_type's second named child, a `type` (`nthChild: 2`).
.decl txn_ahc_right(n: node)
txn_ahc_right(n) :- txn_binop(n), field(n, "right", c), txn_ahc(c).
txn_ahc_right(n) :- node(_, n, "union_type", _, _), child(n, c, 1), node(_, c, "type", _, _), txn_ahc(c).
// The kinds the branches name (a kind is not a symbol to compare: one rule per kind).
.decl txn_wrapper(n: node)
txn_wrapper(n) :- node(_, n, "type", _, _).
txn_wrapper(n) :- node(_, n, "parenthesized_expression", _, _).
.decl txn_binop(n: node)
txn_binop(n) :- node(_, n, "binary_operator", _, _).
txn_binop(n) :- node(_, n, "union_type", _, _).

// `annotation-connection`: `Connection|^conn$`, but not `ConnectionId`; through a binary_operator / union_type,
// the left side where it has a connection (`annotation-has-connection`), else the right.
.decl txn_ac(n: node)
txn_ac(n) :- node(_, n, "identifier", _, _), text(n, s), match("(?s).*(?:Connection|^conn$).*", s), s != "ConnectionId".
txn_ac(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c), txn_ac(c).
txn_ac(n) :- node(_, n, "subscript", _, _), field(n, "value", c), txn_ac(c).
txn_ac(n) :- node(_, n, "generic_type", _, _), child(n, c, _), node(_, c, "identifier", _, _), txn_ac(c).
txn_ac(n) :- txn_wrapper(n), child(n, c, _), txn_ac(c).
txn_ac(n) :- txn_ahc_left(n), txn_ac_left(n).
txn_ac(n) :- txn_binop(n), !txn_ahc_left(n), txn_ahc_right(n), txn_ac_right(n).
.decl txn_ac_left(n: node)
txn_ac_left(n) :- txn_binop(n), field(n, "left", c), txn_ac(c).
txn_ac_left(n) :- node(_, n, "union_type", _, _), child(n, c, 0), node(_, c, "type", _, _), txn_ac(c).
.decl txn_ac_right(n: node)
txn_ac_right(n) :- txn_binop(n), field(n, "right", c), txn_ac(c).
txn_ac_right(n) :- node(_, n, "union_type", _, _), child(n, c, 1), node(_, c, "type", _, _), txn_ac(c).

// `connection-function`: a function_definition whose parameter list (a direct child of `parameters`) has, first
// among those that qualify (`nthChild: {position: 1, ofRule}`, ofRule being the same test less the capture), a
// typed parameter that is neither positional-only (before a `/`) nor keyword-only or variadic (after a `*`, `*args`,
// `**kw` or `*args: T`), whose `type` is a connection annotation and whose name (a direct identifier child; for a
// typed_default_parameter its `name`) is not `self`; `conn` is that name ($CONN). An `identifier` or
// `default_parameter` has no `type`, so only the typed kinds can qualify.
.decl txn_param_name(q: node, c: node)
txn_param_name(q, c) :- node(_, q, "typed_parameter", _, _), child(q, c, _), node(_, c, "identifier", _, _), text(c, s), s != "self".
txn_param_name(q, c) :- node(_, q, "typed_default_parameter", _, _), field(q, "name", c), node(_, c, "identifier", _, _), text(c, s), s != "self".
.decl txn_star(s: node)
txn_star(s) :- node(_, s, "keyword_separator", _, _).
txn_star(s) :- txn_splat(s).
txn_star(s) :- node(_, s, "typed_parameter", _, _), child(s, c, _), txn_splat(c).
.decl txn_splat(s: node)
txn_splat(s) :- node(_, s, "list_splat_pattern", _, _).
txn_splat(s) :- node(_, s, "dictionary_splat_pattern", _, _).
.decl txn_typed(ps: node, q: node, i: number)
txn_typed(ps, q, i) :- node(_, ps, "parameters", _, _), child(ps, q, i), node(_, q, "typed_parameter", _, _).
txn_typed(ps, q, i) :- node(_, ps, "parameters", _, _), child(ps, q, i), node(_, q, "typed_default_parameter", _, _).
.decl txn_before_slash(ps: node, i: number)
txn_before_slash(ps, i) :- txn_typed(ps, _, i), child(ps, s, j), node(_, s, "positional_separator", _, _), i < j.
.decl txn_after_star(ps: node, i: number)
txn_after_star(ps, i) :- txn_typed(ps, _, i), child(ps, s, j), j < i, txn_star(s).
.decl txn_param(ps: node, q: node, i: number)
txn_param(ps, q, i) :-
    txn_typed(ps, q, i), !txn_before_slash(ps, i), !txn_after_star(ps, i),
    field(q, "type", t), txn_ac(t), txn_param_name(q, _).
.decl txn_param_later(ps: node, i: number)
txn_param_later(ps, i) :- txn_param(ps, _, i), txn_param(ps, _, j), j < i.
.decl txn_cf(f: node, conn: symbol)
txn_cf(f, conn) :-
    node(_, f, "function_definition", _, _), field(f, "parameters", ps), txn_param(ps, q, i), !txn_param_later(ps, i),
    txn_param_name(q, c), text(c, conn).

// `internal-transaction`: in the function's `body`, not within a nested function_definition (`stopBy`), a call
// `$CONN.read(…)`, `$CONN.write(…)` or `$CONN.schema_transaction(…)`, $CONN the connection parameter's name.
.decl txn_blocks(kind: symbol)
txn_blocks("block").
.decl txn_functions(kind: symbol)
txn_functions("function_definition").
.decl txn_call(c: node, conn: symbol)
txn_call(c, conn) :-
    node(_, c, "call", _, _), field(c, "function", a), node(_, a, "attribute", _, _),
    field(a, "object", o), node(_, o, "identifier", _, _), text(o, conn),
    field(a, "attribute", m), node(_, m, "identifier", _, _), text(m, s), (s = "read" ; s = "schema_transaction" ; s = "write").
.decl txn_it_blocked(c: node, b: node)
txn_it_blocked(c, b) :- txn_call(c, _), inside(c, s, txn_functions), inside(s, b, txn_blocks).
.decl txn_it(f: node, conn: symbol)
txn_it(f, conn) :-
    txn_call(c, conn), inside(c, b, txn_blocks), field(f, "body", b), node(_, f, "function_definition", _, _),
    !txn_it_blocked(c, b).

// `__init__` of a class whose name matches `Connection|SyncConnectionPool|Transaction|TransactionGenerator`, the
// nearest enclosing class (`inside` with `stopBy: {kind: class_definition}` stops at, and tests, the first).
.decl txn_classes(kind: symbol)
txn_classes("class_definition").
.decl txn_init_in_conn_class(f: node)
txn_init_in_conn_class(f) :-
    node(_, f, "function_definition", _, _), field(f, "name", c), node(_, c, "identifier", _, _), text(c, "__init__"),
    nearest(f, k, txn_classes), field(k, "name", kn), text(kn, s),
    match("(?s).*(?:Connection|SyncConnectionPool|Transaction|TransactionGenerator).*", s).

// `category-<X>`: the function's name is one of the category's (`^(?:a|b|…)$`).
.decl txn_named(f: node, cat: symbol)
txn_named(f, cat) :- field(f, "name", c), node(_, c, "identifier", _, _), text(c, s), txn_category(cat, s).
// `unclassified-function`: not `__init__` of a connection class, and in no category.
.decl txn_classified(f: node)
txn_classified(f) :- txn_named(f, _).
.decl txn_unclassified(f: node)
txn_unclassified(f) :- node(_, f, "function_definition", _, _), !txn_init_in_conn_class(f), !txn_classified(f).

// The source gate (`sourceGate: true`): the function lies in a module whose full text, comments and strings
// included, matches `Connection|conn`. (The clause's first branch, the function being a module, never holds.)
.decl txn_gate(d: number)
txn_gate(d) :- node(d, m, "module", _, _), node_text(m, s), (contains("Connection", s) ; contains("conn", s)).

// The function name tests of the clauses (`has: {regex, stopBy: neighbor, field: name}`), one per regex.
.decl txn_name_1(f: node)
.decl txn_name_2(f: node)
.decl txn_name_3(f: node)
.decl txn_name_4(f: node)
.decl txn_name_5(f: node)
.decl txn_name_6(f: node)
.decl txn_name_7(f: node)
.decl txn_name_8(f: node)
.decl txn_name_9(f: node)
.decl txn_name_10(f: node)
.decl txn_name_11(f: node)
.decl txn_name_12(f: node)
txn_name_1(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:table_exists|get_table|list_tables|introspect).*", s).
txn_name_2(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:initialize|ensure|bootstrap|create_log_table).*", s).
txn_name_3(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:ripple|reaper|background|process_).*", s).
txn_name_4(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:export_|import_|validate_import).*", s).
txn_name_5(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:_detect_|get_capabilities|has_native|get_backend_type|run_after_rollback|attach_renewable_capability_runtime).*", s).
txn_name_6(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:_handler).*", s).
txn_name_7(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:(?i)validat).*", s).
txn_name_8(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:ensure|initialize|(?i:bootstrap)).*", s).
txn_name_9(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:stale|reaper|recover|ripple|process_|enqueue_ripple).*", s).
txn_name_10(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:register_queue|register_table|sync_column|register_trigger).*", s).
txn_name_11(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:subscribe).*", s).
txn_name_12(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s).*(?:export_database|import_database).*", s).

// The category names: each `category-*` option's default.
.decl txn_category(cat: symbol, name: symbol)
txn_category("category-LEGITIMATE", "__enter__").
txn_category("category-LEGITIMATE", "__exit__").
txn_category("category-LEGITIMATE", "_create_introspector").
txn_category("category-LEGITIMATE", "_create_sparse_versioned_backend").
txn_category("category-LEGITIMATE", "_execute_graphql_subscription").
txn_category("category-LEGITIMATE", "_get_conn").
txn_category("category-LEGITIMATE", "_get_data_importer").
txn_category("category-LEGITIMATE", "_get_database_exporter").
txn_category("category-LEGITIMATE", "_get_database_importer").
txn_category("category-LEGITIMATE", "_get_import_validator").
txn_category("category-LEGITIMATE", "_get_introspector_for_connection").
txn_category("category-LEGITIMATE", "_get_migration_executor").
txn_category("category-LEGITIMATE", "_get_migration_history_manager").
