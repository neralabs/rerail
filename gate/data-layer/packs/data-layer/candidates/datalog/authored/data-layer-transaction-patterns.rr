// ---- the clauses ----

violation("data-layer-transaction-patterns", "internal-5", "INTERNAL_TXN_VIOLATION", p, l) :-
    txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-BACKEND_SPECIFIC"), txn_it(f, conn),
    node(d, f, _, _, _), txn_gate(d), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).

violation("data-layer-transaction-patterns", "internal-6", "INTERNAL_TXN_VIOLATION", p, l) :-
    txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-CAPABILITY"), txn_it(f, conn),
    node(d, f, _, _, _), txn_gate(d), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).

violation("data-layer-transaction-patterns", "internal-9", "INTERNAL_TXN_VIOLATION", p, l) :-
    txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-SUBSCRIPTION"), txn_it(f, conn),
    node(d, f, _, _, _), txn_gate(d), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).

violation("data-layer-transaction-patterns", "internal-10", "INTERNAL_TXN_VIOLATION", p, l) :-
    txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-SCHEMA_OPS"), txn_it(f, conn),
    node(d, f, _, _, _), txn_gate(d), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).

violation("data-layer-transaction-patterns", "internal-11", "INTERNAL_TXN_VIOLATION", p, l) :-
    txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-DEPRECATED"), txn_it(f, conn),
    node(d, f, _, _, _), txn_gate(d), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).

violation("data-layer-transaction-patterns", "internal-13", "INTERNAL_TXN_VIOLATION", p, l) :-
    txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-BULK_OPS"), txn_it(f, conn),
    node(d, f, _, _, _), txn_gate(d), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).

violation("data-layer-transaction-patterns", "category-14", "NEEDS_REVIEW", p, l) :-
    txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-NEEDS_REVIEW"), !txn_it(f, conn),
    node(d, f, _, _, _), txn_gate(d), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).

violation("data-layer-transaction-patterns", "internal-14", "INTERNAL_TXN_VIOLATION", p, l) :-
    txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-NEEDS_REVIEW"), txn_it(f, conn),
    node(d, f, _, _, _), txn_gate(d), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).

