// data-layer-hnsw-architecture: clauses `hnsw-architecture` and `hnsw-forbidden-files` (relational), with the
// option entryPoint from the converter's option_value (every recorded event runs `find_hnsw_architecture_findings`;
// the default, "all", gates on the module text and has no HNSW006). Policy: rules/data-layer-hnsw-architecture.json.
//
// The SQL reads CPython's `ast` (the `pythonAst` stage) over the files the gate passes. Here the same rows are read
// on tree-sitter's tree (as data-layer-connection-mode-split.rr does):
// - Name: an `identifier` in expression position (not an attribute's attr, a def/class/keyword/parameter name, an
//   import's names, a global/nonlocal name, an `except … as` alias, inside a case pattern, or a PEP 695 type
//   parameter's name, which CPython keeps as a string); its token its id.
// - Attribute: `attribute`, its token the attr. Lines are tree-sitter start lines, which are CPython's for these.
// - Constant str (`value_kind='str'`): a non-f, non-bytes `string`; a `concatenated_string` of such strings (one
//   Constant, at its start line); and each literal of a JoinedStr (an f-string, a concatenation with an f-string
//   part, a format spec), `fstring_piece`'s literal pieces, CPython 3.12's Constants: their decoded text, adjacent
//   parts merged, a debug field's `x = ` in it, at the line where the piece's first part starts (CPython's lineno:
//   a plain part, even an empty one, a part's text after the interpolation before, the debug text's `{`; in a spec
//   right after its `:` or the nested field before).
// - Import: its token every alias's dotted name; ImportFrom: its module as written (relative dots dropped) and every
//   alias's name, none at all when the module is empty (`from . import x`: SQL's NULL || …).
// - A docstring (excluded from HNSW007): a Constant that is the whole first statement of a module, class or def body.
// A plain string's and a plain concatenation's value is `value`'s (escapes decoded, parts joined), exactly; parentheses
// are seen through (CPython drops them) for a docstring and a Name receiver.
// Two verdicts: the gate's AST query (`syntax: valid`) is W's own, tree-sitter's (`tape_syntax_error(d)`); the `pythonAst`
// stage runs CPython's `ast.parse`, which refuses a file it rejects: CPython 3.13's (`cpython_syntax_error`).
.decl tape_syntax_error(d: number)
.decl cpython_syntax_error(d: number, l: number, msg: symbol)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.decl option_value(name: symbol, v: symbol)
.output violation

.decl hnsw_entry(e: symbol)
hnsw_entry(e) :- option_value("entryPoint", e).
// The six forbidden modules (HNSW006, and left out of the other rows at `find_hnsw_architecture_findings`).
.decl hnsw_forbidden_path(p: symbol)
hnsw_forbidden_path("impl/common/l2100_sql_grammar/domain/sql_table_hnsw/frontier.py").
hnsw_forbidden_path("impl/common/l2100_sql_grammar/domain/sql_table_hnsw/normalized_vectors.py").
hnsw_forbidden_path("impl/common/l2100_sql_grammar/domain/sql_table_hnsw/recovery_schema.py").
hnsw_forbidden_path("impl/common/l2100_sql_grammar/domain/sql_table_hnsw/search_program.py").
hnsw_forbidden_path("impl/common/l2100_sql_grammar/domain/sql_table_hnsw/sqlite_construction.py").
hnsw_forbidden_path("impl/common/l2100_sql_grammar/domain/sql_table_hnsw/sqlite_frontier.py").

// ---- the gate (requireNonemptyInput, per file) ----
// Any other entry point: a valid file whose module text holds HNSW, Hnsw, JSON, Json, hnsw or json.
// `find_hnsw_architecture_findings`: every valid file (its rule is `kind: module`), less the forbidden modules (its
// outer WHERE). Valid: tree-sitter's verdict (the gate) and CPython's (the `pythonAst` stage).
.decl hnsw_architecture_gate(d: number)
hnsw_architecture_gate(d) :- hnsw_entry(e), e != "find_hnsw_architecture_findings", node(d, m, "module", _, _),
    node_text(m, s), !tape_syntax_error(d), !cpython_syntax_error(d, _, _),
    (contains("HNSW", s) ; contains("Hnsw", s) ; contains("JSON", s) ; contains("Json", s) ; contains("hnsw", s) ; contains("json", s)).
hnsw_architecture_gate(d) :- hnsw_entry("find_hnsw_architecture_findings"), node(d, _, "module", _, _), !tape_syntax_error(d),
    !cpython_syntax_error(d, _, _), doc(d, p, _), !hnsw_forbidden_path(p).

// ---- Names ----
.decl hnsw_architecture_not_name(n: node)
hnsw_architecture_not_name(n) :- node(_, a, "attribute", _, _), field(a, "attribute", n).
hnsw_architecture_not_name(n) :- node(_, p, "function_definition", _, _), field(p, "name", n).
hnsw_architecture_not_name(n) :- node(_, p, "class_definition", _, _), field(p, "name", n).
hnsw_architecture_not_name(n) :- node(_, p, "keyword_argument", _, _), field(p, "name", n).
hnsw_architecture_not_name(n) :- node(_, p, "default_parameter", _, _), field(p, "name", n).
hnsw_architecture_not_name(n) :- node(_, p, "typed_default_parameter", _, _), field(p, "name", n).
hnsw_architecture_not_name(n) :- node(_, p, "except_clause", _, _), field(p, "alias", n).
hnsw_architecture_not_name(n) :- hnsw_architecture_params(p), child(p, n, _), node(_, n, "identifier", _, _).
hnsw_architecture_not_name(n) :- hnsw_architecture_params(p), child(p, s, _), hnsw_architecture_splat(s), child(s, n, _), node(_, n, "identifier", _, _).
hnsw_architecture_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, n, _), node(_, n, "identifier", _, _).
hnsw_architecture_not_name(n) :- node(_, p, "typed_parameter", _, _), child(p, s, _), hnsw_architecture_splat(s), child(s, n, _), node(_, n, "identifier", _, _).
hnsw_architecture_not_name(n) :- node(_, p, "global_statement", _, _), child(p, n, _).
hnsw_architecture_not_name(n) :- node(_, p, "nonlocal_statement", _, _), child(p, n, _).
hnsw_architecture_not_name(n) :- node(_, n, "identifier", _, _), inside(n, _, hnsw_architecture_imports).
hnsw_architecture_not_name(n) :- node(_, n, "identifier", _, _), inside(n, _, hnsw_architecture_patterns).
// A PEP 695 type parameter's name (CPython's TypeVar, TypeVarTuple, ParamSpec `name`, a string): the item, or a
// default's `name`; in a `type` its first child; an identifier, a splat's identifier, a bounded one's first part.
hnsw_architecture_not_name(n) :- hnsw_architecture_tinner(n), node(_, n, "identifier", _, _).
hnsw_architecture_not_name(n) :- hnsw_architecture_tinner(i), node(_, i, "splat_type", _, _), child(i, n, _), node(_, n, "identifier", _, _).
hnsw_architecture_not_name(n) :- hnsw_architecture_tinner(i), node(_, i, "constrained_type", _, _), child(i, n, 0), node(_, n, "identifier", _, _).
hnsw_architecture_not_name(n) :- hnsw_architecture_tinner(i), node(_, i, "constrained_type", _, _), child(i, t, 0), node(_, t, "type", _, _),
    child(t, n, 0), node(_, n, "identifier", _, _).
.decl hnsw_architecture_tparam(p: node)
hnsw_architecture_tparam(p) :- node(_, l, "type_parameter", _, _), child(l, p, _), !node(_, p, "type_default", _, _).
hnsw_architecture_tparam(p) :- node(_, l, "type_parameter", _, _), child(l, t, _), node(_, t, "type_default", _, _), field(t, "name", p).
.decl hnsw_architecture_tinner(i: node)
hnsw_architecture_tinner(i) :- hnsw_architecture_tparam(p), node(_, p, "type", _, _), child(p, i, 0).
hnsw_architecture_tinner(p) :- hnsw_architecture_tparam(p), !node(_, p, "type", _, _).
.decl hnsw_architecture_params(p: node)
hnsw_architecture_params(p) :- node(_, p, "parameters", _, _).
hnsw_architecture_params(p) :- node(_, p, "lambda_parameters", _, _).
.decl hnsw_architecture_splat(s: node)
hnsw_architecture_splat(s) :- node(_, s, "list_splat_pattern", _, _).
hnsw_architecture_splat(s) :- node(_, s, "dictionary_splat_pattern", _, _).
.decl hnsw_architecture_imports(kind: symbol)
hnsw_architecture_imports("import_statement"). hnsw_architecture_imports("import_from_statement").
.decl hnsw_architecture_patterns(kind: symbol)
hnsw_architecture_patterns("case_pattern").

// hnsw_architecture_ref(d, n, s): a Name or an Attribute and its name (`kind IN ('Name','Attribute')`).
.decl hnsw_architecture_ref(d: number, n: node, s: symbol)
hnsw_architecture_ref(d, n, s) :- node(d, n, "identifier", _, _), text(n, s), !hnsw_architecture_not_name(n).
hnsw_architecture_ref(d, a, s) :- node(d, a, "attribute", _, _), field(a, "attribute", x), text(x, s).

// ---- Constants (str) ----
// A plain string: no f, no b in its prefix.
.decl hnsw_architecture_plain(n: node)
hnsw_architecture_plain(n) :- node(_, n, "string", _, _), strprefix(n, p), !contains("f", p), !contains("b", p).
.decl hnsw_architecture_fstring(n: node)
hnsw_architecture_fstring(n) :- node(_, n, "string", _, _), strprefix(n, p), contains("f", p).
// hnsw_architecture_const(c, v): Constant c (a plain string in no concatenation, a plain concatenation) and its value.
.decl hnsw_architecture_const(c: node, v: symbol)
hnsw_architecture_const(c, v) :- hnsw_architecture_plain(c), child(q, c, _), !node(_, q, "concatenated_string", _, _), value(c, v).
hnsw_architecture_const(q, v) :- node(_, q, "concatenated_string", _, _), !hnsw_architecture_mixed(q), value(q, v).
// A concatenation with an f-string part is one JoinedStr.
.decl hnsw_architecture_mixed(q: node)
hnsw_architecture_mixed(q) :- node(_, q, "concatenated_string", _, _), child(q, c, _), hnsw_architecture_fstring(c).

// ---- JoinedStr Constants: hnsw_architecture_piece_const(d, l, v) ----
// The hosts: an f-string in no concatenation, a concatenation with an f-string part (string hosts), a format spec.
.decl hnsw_architecture_part_of(h: node)
hnsw_architecture_part_of(h) :- child(q, h, _), node(_, q, "concatenated_string", _, _).
.decl hnsw_architecture_host_str(h: node)
hnsw_architecture_host_str(h) :- hnsw_architecture_fstring(h), !hnsw_architecture_part_of(h).
hnsw_architecture_host_str(q) :- hnsw_architecture_mixed(q).
.decl hnsw_architecture_host_spec(h: node)
hnsw_architecture_host_spec(h) :- node(_, h, "format_specifier", _, _).
// A string host's f-string parts.
.decl hnsw_architecture_fpart(h: node, p: node)
hnsw_architecture_fpart(h, h) :- hnsw_architecture_host_str(h), hnsw_architecture_fstring(h).
hnsw_architecture_fpart(q, p) :- hnsw_architecture_mixed(q), child(q, p, _), hnsw_architecture_fstring(p).
// Its interpolations (a spec's nested fields), each with its rank by start: the k-th is the k-th interpolation piece.
.decl hnsw_architecture_interp(h: node, x: node, s: number)
hnsw_architecture_interp(h, x, s) :- hnsw_architecture_fpart(h, p), child(p, x, _), node(_, x, "interpolation", s, _).
hnsw_architecture_interp(h, x, s) :- hnsw_architecture_host_spec(h), child(h, x, _), node(_, x, "format_expression", s, _).
.decl hnsw_architecture_interp_k(h: node, x: node, k: number)
hnsw_architecture_interp_k(h, x, k) :- hnsw_architecture_interp(h, x, s), k = count : { hnsw_architecture_interp(h, _, t), t < s }.
.decl hnsw_architecture_host(h: node)
hnsw_architecture_host(h) :- hnsw_architecture_host_str(h).
hnsw_architecture_host(h) :- hnsw_architecture_host_spec(h).
.decl hnsw_architecture_piece_node(h: node, i: number, x: node)
hnsw_architecture_piece_node(h, i, x) :- hnsw_architecture_host(h), fstring_piece(h, i, "interpolation", _),
    k = count : { fstring_piece(h, j, "interpolation", _), j < i }, hnsw_architecture_interp_k(h, x, k).
.decl hnsw_architecture_lit(h: node, i: number, v: symbol)
hnsw_architecture_lit(h, i, v) :- hnsw_architecture_host(h), fstring_piece(h, i, "literal", v).
// A string host: the literal's first part, between the interpolation before (or the host's start) and the one after
// (or the host's end): a plain part, a text child of an f-string part, or the next interpolation when its debug text
// is in the literal.
.decl hnsw_architecture_frag(h: node, f: node, s: number)
hnsw_architecture_frag(q, p, s) :- hnsw_architecture_mixed(q), child(q, p, _), node(_, p, "string", s, _), !hnsw_architecture_fstring(p).
hnsw_architecture_frag(h, f, s) :- hnsw_architecture_fpart(h, p), child(p, f, _), node(_, f, k, s, _), k != "interpolation",
    k != "string_start", k != "string_end".
.decl hnsw_architecture_lo(h: node, i: number, a: number)
hnsw_architecture_lo(h, 0, a) :- hnsw_architecture_lit(h, 0, _), hnsw_architecture_host_str(h), node(_, h, _, a, _).
hnsw_architecture_lo(h, i, a) :- hnsw_architecture_lit(h, i, _), hnsw_architecture_host_str(h), i > 0, j = i - 1,
    hnsw_architecture_piece_node(h, j, x), node(_, x, _, _, a).
.decl hnsw_architecture_hi(h: node, i: number, b: number)
hnsw_architecture_hi(h, i, b) :- hnsw_architecture_lit(h, i, _), hnsw_architecture_host_str(h), j = i + 1,
    hnsw_architecture_piece_node(h, j, x), node(_, x, _, b, _).
hnsw_architecture_hi(h, i, b) :- hnsw_architecture_lit(h, i, _), hnsw_architecture_host_str(h), j = i + 1, !fstring_piece(h, j, _, _),
    node(_, h, _, _, b).
.decl hnsw_architecture_run(h: node, i: number, f: node, s: number)
hnsw_architecture_run(h, i, f, s) :- hnsw_architecture_lo(h, i, a), hnsw_architecture_hi(h, i, b), hnsw_architecture_frag(h, f, s),
    s >= a, s < b.
hnsw_architecture_run(h, i, x, s) :- hnsw_architecture_lit(h, i, _), hnsw_architecture_host_str(h), j = i + 1,
    fstring_piece(h, j, "debug", _), hnsw_architecture_piece_node(h, j, x), node(_, x, _, s, _).
.decl hnsw_architecture_run_line(h: node, i: number, l: number)
hnsw_architecture_run_line(h, i, l) :- hnsw_architecture_run(h, i, f, s), s = min t : { hnsw_architecture_run(h, i, _, t) }, line(f, l).
// A spec: its literal text cannot hold a line break, so a literal starts on the line of the `:` (the spec's start)
// or of the nested field before it ends.
hnsw_architecture_run_line(h, 0, l) :- hnsw_architecture_lit(h, 0, _), hnsw_architecture_host_spec(h), line(h, l).
hnsw_architecture_run_line(h, i, l) :- hnsw_architecture_lit(h, i, _), hnsw_architecture_host_spec(h), i > 0, j = i - 1,
    hnsw_architecture_piece_node(h, j, x), end_line(x, l).
.decl hnsw_architecture_piece_const(d: number, l: number, v: symbol)
hnsw_architecture_piece_const(d, l, v) :- hnsw_architecture_lit(h, i, v), hnsw_architecture_run_line(h, i, l), node(d, h, _, _, _).
// x with its parentheses taken off: `((x))` is x.
.decl hnsw_architecture_unparen(o: node, x: node)
hnsw_architecture_unparen(x, x) :- node(_, x, _, _, _), !node(_, x, "parenthesized_expression", _, _).
hnsw_architecture_unparen(o, x) :- node(_, o, "parenthesized_expression", _, _), child(o, i, 0), !child(o, _, 1),
    hnsw_architecture_unparen(i, x).
// A docstring: the whole first statement of a module, class or function body.
.decl hnsw_architecture_docstring(c: node)
hnsw_architecture_docstring(c) :- hnsw_architecture_const(c, _), hnsw_architecture_unparen(w, c), child(e, w, 0),
    node(_, e, "expression_statement", _, _), !child(e, _, 1), child(b, e, 0), hnsw_architecture_body(b).
.decl hnsw_architecture_body(b: node)
hnsw_architecture_body(b) :- node(_, b, "module", _, _).
hnsw_architecture_body(b) :- node(_, o, "class_definition", _, _), field(o, "body", b).
hnsw_architecture_body(b) :- node(_, o, "function_definition", _, _), field(o, "body", b).

// ---- Imports: their tokens ----
.decl hnsw_architecture_alias(i: node, s: symbol)
hnsw_architecture_alias(i, s) :- field(i, "name", x), node(_, x, "dotted_name", _, _), name(x, s).
hnsw_architecture_alias(i, s) :- field(i, "name", x), node(_, x, "aliased_import", _, _), field(x, "name", dn), name(dn, s).
// imported: an Import's alias names; an ImportFrom's module (none for `from . import x`).
.decl hnsw_architecture_imported(d: number, i: node, s: symbol)
hnsw_architecture_imported(d, i, s) :- node(d, i, "import_statement", _, _), hnsw_architecture_alias(i, s).
hnsw_architecture_imported(d, i, s) :- node(d, i, "import_from_statement", _, _), field(i, "module_name", m),
    node(_, m, "dotted_name", _, _), name(m, s).
hnsw_architecture_imported(d, i, s) :- node(d, i, "import_from_statement", _, _), field(i, "module_name", r),
    node(_, r, "relative_import", _, _), child(r, m, _), node(_, m, "dotted_name", _, _), name(m, s).
// The token: imported || ' ' || imported_names, every piece, where imported is not NULL.
.decl hnsw_architecture_import_token(d: number, i: node, s: symbol)
hnsw_architecture_import_token(d, i, s) :- hnsw_architecture_imported(d, i, s).
hnsw_architecture_import_token(d, i, s) :- hnsw_architecture_imported(d, i, _), hnsw_architecture_alias(i, s).

// ---- the rows (document, node, issue) ----
.decl hnsw_architecture_module(d: number)
hnsw_architecture_module(d) :- doc(d, p, _), match("(?i)(?:.*/)?[^/]*hnsw[^/]*", p).
hnsw_architecture_module(d) :- doc(d, p, _), match("(?:.*/)?sql_table_hnsw(?:/.*)?", p).
.decl hnsw_architecture_algorithm(d: number)
hnsw_architecture_algorithm(d) :- doc(d, p, _), match("(?:.*/)?algorithm\\.py", p).
.decl hnsw_architecture_forbidden(s: symbol)
hnsw_architecture_forbidden("SqlHnswBeamLayerSearch"). hnsw_architecture_forbidden("SqlHnswBeamLayerTrace").
hnsw_architecture_forbidden("SqlHnswEpochRecoveryStep"). hnsw_architecture_forbidden("SqlHnswFrontierAdvance").
hnsw_architecture_forbidden("SqlHnswFrontierTickInsert"). hnsw_architecture_forbidden("SqlHnswIncrementalMutationProgram").
hnsw_architecture_forbidden("SqlTableHnswIncrementalUpperEdges"). hnsw_architecture_forbidden("SqlTableHnswRepairContentOrphanNeighbors").
hnsw_architecture_forbidden("SqlTableHnswRepairSourceNeighbors"). hnsw_architecture_forbidden("SqlTableHnswScopedRebuild").
hnsw_architecture_forbidden("_SqlHnswEpochLayerEdges"). hnsw_architecture_forbidden("hnsw_flat_walk_neighbor_limit").
hnsw_architecture_forbidden("hnsw_flat_walk_recursion_limit"). hnsw_architecture_forbidden("hnsw_flat_walk_visited_budget").
hnsw_architecture_forbidden("hnsw_insertion_recursive_iteration_limit"). hnsw_architecture_forbidden("hnsw_recovery_diversity_candidate_limit").
hnsw_architecture_forbidden("hnsw_recovery_exhaustive_candidate_limit"). hnsw_architecture_forbidden("hnsw_recovery_initial_neighbor_limit").
hnsw_architecture_forbidden("hnsw_recovery_pruning_candidate_limit"). hnsw_architecture_forbidden("hnsw_recovery_route_partition_count").
hnsw_architecture_forbidden("hnsw_search_frontier_iteration_limit"). hnsw_architecture_forbidden("scored_pairs_query").

.decl hnsw_architecture_row(d: number, n: node, issue: symbol)
// HNSW007: a JSON token in an HNSW module: a Name/Attribute, a non-docstring str Constant, an import.
hnsw_architecture_row(d, n, "HNSW007") :- hnsw_architecture_ref(d, n, s), hnsw_architecture_module(d),
    match("(?s:.*)(?i:sqljson\\w*|\\bjsonb?(?:_\\w+)?\\b)(?s:.*)", s).
hnsw_architecture_row(d, c, "HNSW007") :- hnsw_architecture_const(c, s), !hnsw_architecture_docstring(c), node(d, c, _, _, _),
    hnsw_architecture_module(d), match("(?s:.*)(?i:sqljson\\w*|\\bjsonb?(?:_\\w+)?\\b)(?s:.*)", s).
hnsw_architecture_row(d, i, "HNSW007") :- hnsw_architecture_import_token(d, i, s), hnsw_architecture_module(d),
    match("(?s:.*)(?i:sqljson\\w*|\\bjsonb?(?:_\\w+)?\\b)(?s:.*)", s).
// HNSW001: a forbidden Name/Attribute, or a class or def of that name.
hnsw_architecture_row(d, n, "HNSW001") :- hnsw_architecture_ref(d, n, s), hnsw_architecture_forbidden(s).
hnsw_architecture_row(d, n, "HNSW001") :- node(d, n, "class_definition", _, _), field(n, "name", x), text(x, s), hnsw_architecture_forbidden(s).
hnsw_architecture_row(d, n, "HNSW001") :- node(d, n, "function_definition", _, _), field(n, "name", x), text(x, s), hnsw_architecture_forbidden(s).
// HNSW003-005, in a file named algorithm.py.
hnsw_architecture_row(d, i, "HNSW003") :- hnsw_architecture_imported(d, i, s), hnsw_architecture_algorithm(d),
    (contains(".sqlite", s) ; contains("sql_dialect", s) ; contains("backend_type", s)).
hnsw_architecture_row(d, f, "HNSW004") :- node(d, f, "function_definition", _, _), !op(f, "async"), field(f, "name", x), text(x, "render"),
    hnsw_architecture_algorithm(d).
hnsw_architecture_row(d, c, "HNSW005") :- node(d, c, "call", _, _), field(c, "function", a), node(_, a, "attribute", _, _),
    field(a, "object", w), hnsw_architecture_unparen(w, o), node(_, o, "identifier", _, _), text(o, "SqlFragment"),
    hnsw_architecture_algorithm(d).
// HNSW002: forbidden state words in str Constants.
hnsw_architecture_row(d, c, "HNSW002") :- hnsw_architecture_const(c, s), node(d, c, _, _, _),
    (contains("in_beam", s) ; contains("beam_iteration_limit", s) ; contains("original_cosine", s) ; contains("recovery_epoch", s) ; contains("route_partition", s)).

// The rows at their lines; a JoinedStr's Constants have a line, not a node.
.decl hnsw_architecture_found(d: number, l: number, issue: symbol)
hnsw_architecture_found(d, l, issue) :- hnsw_architecture_row(d, n, issue), line(n, l).
hnsw_architecture_found(d, l, "HNSW007") :- hnsw_architecture_piece_const(d, l, s), hnsw_architecture_module(d),
    match("(?s:.*)(?i:sqljson\\w*|\\bjsonb?(?:_\\w+)?\\b)(?s:.*)", s).
hnsw_architecture_found(d, l, "HNSW002") :- hnsw_architecture_piece_const(d, l, s),
    (contains("in_beam", s) ; contains("beam_iteration_limit", s) ; contains("original_cosine", s) ; contains("recovery_epoch", s) ; contains("route_partition", s)).

// The outer WHERE: not rust_bridge/generated_*.
.decl hnsw_architecture_generated(d: number)
hnsw_architecture_generated(d) :- doc(d, p, _), match("(?:.*/)?rust_bridge/(?:.*/)?generated_[^/]*", p).

violation("data-layer-hnsw-architecture", "hnsw-architecture", issue, p, l) :-
    hnsw_architecture_found(d, l, issue), hnsw_architecture_gate(d), !hnsw_architecture_generated(d),
    in_scope(d), !out_scope(d), doc(d, p, _).

// hnsw-forbidden-files: every file (a file.content regex: parsed or not) at a forbidden path, at line 1; at any
// other entry point the query ends `WHERE 0`: no rows.
violation("data-layer-hnsw-architecture", "hnsw-forbidden-files", "HNSW006", p, 1) :-
    hnsw_entry("find_hnsw_architecture_findings"), doc(d, p, _), hnsw_forbidden_path(p), in_scope(d), !out_scope(d).
