// data-layer-schema-bootstrap-contracts: the relational clause bootstrap-contracts, by hand.
//
// Its SQL runs over CPython `ast` rows (`pythonAst`); the script it ports is nera-data-layer
// scripts/lint_schema_bootstrap_contracts.py. Here the same questions are asked of tree-sitter's tree read the
// way `ast` reads it (parentheses transparent, a def's decorators its own). The gate is every module of the
// policy's scope (no text test) that is valid twice: W's `syntax: valid` (tree-sitter's verdict, `syntax_error(d)`)
// and CPython's `ast.parse`, which the `pythonAst` stages run (a file it rejects fails them;
// `cpython_syntax_error`). Options: the defaults; the query has no entryPoint cases. The code is the row's `issue`
// column.
//
// Annotation names (_annotation_names): the Names and Attribute attrs below an annotation are its identifiers,
// less keyword-argument and lambda-parameter names. A string annotation (`x: "SyncSchemaTransaction"`, adjacent
// literals joined) is parsed by the script; here its names are found by `word` tests of the names the clause asks
// about in the string's value (W's `value`: escapes decoded, parts joined).
// Approximations, all in string annotations, none in the scoped files today, blocked on CPython's parse of a string
// annotation (core.rr's `parsed`: it needs core.rr's isolated `ast.parse` worker, which the corpus runner does not
// run): a string that does not parse (the script takes the whole string as one name) is read word by word; strings
// nested in the parsed string count; a string slice of `Sequence[…]` always has a name.
.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl strprefix(n: node, s: symbol)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl cpython_syntax_error(d: number, l: number, msg: symbol)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)

.decl bootstrap_doc(d: number)
bootstrap_doc(d) :- doc(d, _, _), in_scope(d), !out_scope(d), !syntax_error(d), !cpython_syntax_error(d, _, _).
.decl bootstrap_fdef(kind: symbol)
bootstrap_fdef("function_definition").
.decl bootstrap_type(kind: symbol)
bootstrap_type("type").
.decl bootstrap_fn(f: node, x: symbol)
bootstrap_fn(f, x) :- node(d, f, "function_definition", _, _), bootstrap_doc(d), field(f, "name", nm), text(nm, x).

// ---- names ----------------------------------------------------------------------------------------------------
// Every name the clause asks about.
.decl bootstrap_interest(x: symbol)
bootstrap_interest("Any"). bootstrap_interest("Collection"). bootstrap_interest("Iterable").
bootstrap_interest("Mapping"). bootstrap_interest("MutableMapping").
bootstrap_interest("MutableSequence"). bootstrap_interest("Sequence"). bootstrap_interest("bytes").
bootstrap_interest("bytearray"). bootstrap_interest("float"). bootstrap_interest("int").
bootstrap_interest("object"). bootstrap_interest("str").
bootstrap_interest(x) :- bootstrap_lazy_forbidden(x).
bootstrap_interest(x) :- bootstrap_conn_type(x).
bootstrap_interest(x) :- bootstrap_txn_type(x).
.decl bootstrap_broad(x: symbol)
bootstrap_broad("Any"). bootstrap_broad("Collection"). bootstrap_broad("Iterable"). bootstrap_broad("Mapping").
bootstrap_broad("MutableMapping"). bootstrap_broad("MutableSequence"). bootstrap_broad("Sequence").
.decl bootstrap_scalar(x: symbol)
bootstrap_scalar("Any"). bootstrap_scalar("bytes"). bootstrap_scalar("bytearray"). bootstrap_scalar("float").
bootstrap_scalar("int"). bootstrap_scalar("object"). bootstrap_scalar("str").
.decl bootstrap_lazy_forbidden(x: symbol)
bootstrap_lazy_forbidden("AsyncDatabaseConnection"). bootstrap_lazy_forbidden("AsyncReadTransaction").
bootstrap_lazy_forbidden("AsyncSchemaTransaction"). bootstrap_lazy_forbidden("AsyncVersionedDatabaseConnection").
bootstrap_lazy_forbidden("AsyncWriteTransaction"). bootstrap_lazy_forbidden("SyncDatabaseConnection").
bootstrap_lazy_forbidden("SyncReadTransaction"). bootstrap_lazy_forbidden("SyncSchemaTransaction").
bootstrap_lazy_forbidden("SyncVersionedDatabaseConnection"). bootstrap_lazy_forbidden("SyncWriteTransaction").
.decl bootstrap_conn_type(x: symbol)
bootstrap_conn_type("AsyncDatabaseConnection"). bootstrap_conn_type("AsyncVersionedDatabaseConnection").
bootstrap_conn_type("SyncDatabaseConnection"). bootstrap_conn_type("SyncVersionedDatabaseConnection").
bootstrap_conn_type("_DatabaseConnectionCore"). bootstrap_conn_type("_SqlConnectionCore").
.decl bootstrap_txn_type(x: symbol)
bootstrap_txn_type("AsyncReadTransaction"). bootstrap_txn_type("AsyncSchemaTransaction").
bootstrap_txn_type("AsyncWriteTransaction"). bootstrap_txn_type("LazySchemaTransaction").
bootstrap_txn_type("ReadTransaction"). bootstrap_txn_type("SyncReadTransaction").
bootstrap_txn_type("SyncSchemaTransaction"). bootstrap_txn_type("SyncWriteTransaction").
bootstrap_txn_type("WriteTransaction").
.decl bootstrap_conn_name(x: symbol)
bootstrap_conn_name("async_conn"). bootstrap_conn_name("conn"). bootstrap_conn_name("connection").
bootstrap_conn_name("db_connection"). bootstrap_conn_name("sql_conn"). bootstrap_conn_name("sync_conn").
.decl bootstrap_txn_name(x: symbol)
bootstrap_txn_name("current_schema_txn"). bootstrap_txn_name("read_txn"). bootstrap_txn_name("schema_transaction").
bootstrap_txn_name("schema_txn"). bootstrap_txn_name("transaction"). bootstrap_txn_name("txn").
bootstrap_txn_name("write_txn").
.decl bootstrap_schema_txn_name(x: symbol)
bootstrap_schema_txn_name("current_schema_txn"). bootstrap_schema_txn_name("schema_transaction").
bootstrap_schema_txn_name("schema_txn").

.decl bootstrap_kwname(i: node)
bootstrap_kwname(i) :- node(_, k, "keyword_argument", _, _), field(k, "name", i).
bootstrap_kwname(i) :- node(_, lp, "lambda_parameters", _, _), child(lp, i, _), node(_, i, "identifier", _, _).
bootstrap_kwname(i) :- node(_, lp, "lambda_parameters", _, _), child(lp, q, _), field(q, "name", i).
bootstrap_kwname(i) :- node(_, lp, "lambda_parameters", _, _), child(lp, q, _), node(_, q, "list_splat_pattern", _, _),
    child(q, i, 0), node(_, i, "identifier", _, _).
bootstrap_kwname(i) :- node(_, lp, "lambda_parameters", _, _), child(lp, q, _),
    node(_, q, "dictionary_splat_pattern", _, _), child(q, i, 0), node(_, i, "identifier", _, _).
// bootstrap_plain_string(s, c): a str Constant (a literal not in an adjacent-string run, or a run; no b or f
// prefix in it) with value c.
.decl bootstrap_fpart(s: node)
bootstrap_fpart(s) :- node(_, s, "string", _, _), strprefix(s, p), contains("f", p).
.decl bootstrap_in_run(s: node)
bootstrap_in_run(s) :- node(_, c, "concatenated_string", _, _), child(c, s, _).
.decl bootstrap_plain_string(s: node, c: symbol)
bootstrap_plain_string(s, c) :- node(_, s, "string", _, _), !bootstrap_in_run(s), !bootstrap_fpart(s),
    value_type_of(s, "str"), value(s, c).
bootstrap_plain_string(r, c) :- node(_, r, "concatenated_string", _, _), !bootstrap_frun(r), value_type_of(r, "str"),
    value(r, c).
.decl bootstrap_frun(r: node)
bootstrap_frun(r) :- node(_, r, "concatenated_string", _, _), child(r, s, _), bootstrap_fpart(s).
// bootstrap_ann_expr(t, e): annotation t's expression, parentheses taken off.
.decl bootstrap_ann_expr(t: node, e: node)
bootstrap_ann_expr(t, e) :- node(_, t, "type", _, _), child(t, e, 0), !child(t, _, 1).
bootstrap_ann_expr(t, i) :- bootstrap_ann_expr(t, e), node(_, e, "parenthesized_expression", _, _), child(e, i, 0).
// bootstrap_ann(t, x): x is in _annotation_names(t) for annotation t (a `type` node), for every x when t is no
// string, for the clause's names when it is one.
.decl bootstrap_ann(t: node, x: symbol)
bootstrap_ann(t, x) :- node(d, i, "identifier", _, _), bootstrap_doc(d), inside(i, t, bootstrap_type), text(i, x),
    !bootstrap_kwname(i), !bootstrap_string_ann(t).
bootstrap_ann(t, x) :- bootstrap_ann_expr(t, s), bootstrap_plain_string(s, c), bootstrap_interest(x), word(x, c).
.decl bootstrap_string_ann(t: node)
bootstrap_string_ann(t) :- bootstrap_ann_expr(t, s), bootstrap_plain_string(s, _).

// ---- parameters -----------------------------------------------------------------------------------------------
// (mirrors python/ast.rr sig_param / param_parts.)
// bootstrap_param(f, nm, x, t): every `arg` of def f (posonly, args, vararg, kwonly, kwarg), named by identifier
// nm with text x, annotated t; bootstrap_bare(f, nm, x): one without annotation.
.decl bootstrap_param(f: node, nm: node, x: symbol, t: node)
bootstrap_param(f, nm, x, t) :- bootstrap_fn(f, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "typed_parameter", _, _), child(p, nm, 0), node(_, nm, "identifier", _, _), text(nm, x),
    field(p, "type", t).
bootstrap_param(f, nm, x, t) :- bootstrap_fn(f, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "typed_parameter", _, _), child(p, s, 0), node(_, s, "list_splat_pattern", _, _), child(s, nm, 0),
    text(nm, x), field(p, "type", t).
bootstrap_param(f, nm, x, t) :- bootstrap_fn(f, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "typed_parameter", _, _), child(p, s, 0), node(_, s, "dictionary_splat_pattern", _, _),
    child(s, nm, 0), text(nm, x), field(p, "type", t).
bootstrap_param(f, nm, x, t) :- bootstrap_fn(f, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "typed_default_parameter", _, _), field(p, "name", nm), text(nm, x), field(p, "type", t).
.decl bootstrap_bare(f: node, nm: node, x: symbol)
bootstrap_bare(f, p, x) :- bootstrap_fn(f, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "identifier", _, _), text(p, x).
bootstrap_bare(f, nm, x) :- bootstrap_fn(f, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "default_parameter", _, _), field(p, "name", nm), text(nm, x).
bootstrap_bare(f, nm, x) :- bootstrap_fn(f, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "list_splat_pattern", _, _), child(p, nm, 0), text(nm, x).
bootstrap_bare(f, nm, x) :- bootstrap_fn(f, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "dictionary_splat_pattern", _, _), child(p, nm, 0), text(nm, x).

// bootstrap_readonly(t): _is_public_readonly_domain_sequence's annotation half: t is `Sequence[E]`, the value's
// names exactly {Sequence}, E with some name and none of the scalar names. (The function half, a public def,
// is in the SBC002 rule.) Tree-sitter writes a subscript in a type as a generic_type, or as a subscript.
.decl bootstrap_seq_elem(t: node, e: node)
bootstrap_seq_elem(t, e) :- node(_, t, "type", _, _), child(t, g, 0), node(_, g, "generic_type", _, _),
    child(g, v, 0), node(_, v, "identifier", _, _), text(v, "Sequence"), child(g, e, 1),
    node(_, e, "type_parameter", _, _).
bootstrap_seq_elem(t, e) :- node(_, t, "type", _, _), child(t, sb, 0), node(_, sb, "subscript", _, _),
    field(sb, "value", v), node(_, v, "identifier", _, _), text(v, "Sequence"), field(sb, "subscript", e).
.decl bootstrap_elem_name(t: node, x: symbol)
bootstrap_elem_name(t, x) :- bootstrap_seq_elem(t, e), node(d, e, _, s0, e0), node(d, i, "identifier", s1, e1),
    s0 <= s1, e1 <= e0, text(i, x), !bootstrap_kwname(i).
bootstrap_elem_name(t, x) :- bootstrap_seq_elem(t, e), node(d, e, _, s0, e0), node(d, s, _, s1, e1),
    s0 <= s1, e1 <= e0, bootstrap_plain_string(s, c), bootstrap_interest(x), word(x, c).
.decl bootstrap_elem_any(t: node)
bootstrap_elem_any(t) :- bootstrap_elem_name(t, _).
bootstrap_elem_any(t) :- bootstrap_seq_elem(t, e), node(d, e, _, s0, e0), node(d, s, _, s1, e1),
    s0 <= s1, e1 <= e0, bootstrap_plain_string(s, _).
.decl bootstrap_readonly(t: node)
bootstrap_readonly(t) :- bootstrap_elem_any(t), !bootstrap_elem_scalar(t).
.decl bootstrap_elem_scalar(t: node)
bootstrap_elem_scalar(t) :- bootstrap_elem_name(t, x), bootstrap_scalar(x).

// bootstrap_broad_other(t): a broad name other than Sequence is in t's names.
.decl bootstrap_broad_other(t: node)
bootstrap_broad_other(t) :- bootstrap_ann(t, x), bootstrap_broad(x), x != "Sequence".

.decl bootstrap_at(n: node, p: symbol, l: number)
bootstrap_at(n, p, l) :- node(d, n, _, _, _), doc(d, p, _), line(n, l).

// SBC001: a def named …_lazy with no decorator named pure_lazy (`@pure_lazy`, `@x.pure_lazy`, `@pure_lazy(…)`).
.decl bootstrap_deco_expr(f: node, e: node)
bootstrap_deco_expr(f, e) :- bootstrap_fn(f, _), field(dd, "definition", f), child(dd, dc, _),
    node(_, dc, "decorator", _, _), child(dc, e, 0).
bootstrap_deco_expr(f, i) :- bootstrap_deco_expr(f, e), node(_, e, "parenthesized_expression", _, _), child(e, i, 0).
bootstrap_deco_expr(f, g) :- bootstrap_deco_expr(f, e), node(_, e, "call", _, _), field(e, "function", g).
.decl bootstrap_pure_lazy(f: node)
bootstrap_pure_lazy(f) :- bootstrap_deco_expr(f, e), node(_, e, "identifier", _, _), text(e, "pure_lazy").
bootstrap_pure_lazy(f) :- bootstrap_deco_expr(f, e), node(_, e, "attribute", _, _), field(e, "attribute", a),
    text(a, "pure_lazy").
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC001", p, l) :-
    bootstrap_fn(f, x), suffix("_lazy", x), !bootstrap_pure_lazy(f), bootstrap_at(f, p, l).

// SBC006: in a def named …_lazy, an annotation (a parameter's, the return's, or any AnnAssign's in the def)
// naming a sync/async type, at the annotation.
.decl bootstrap_fn_ann(f: node, t: node)
bootstrap_fn_ann(f, t) :- bootstrap_param(f, _, _, t).
bootstrap_fn_ann(f, t) :- bootstrap_fn(f, _), field(f, "return_type", t).
bootstrap_fn_ann(f, t) :- bootstrap_fn(f, _), node(_, a, "assignment", _, _), inside(a, f, bootstrap_fdef),
    field(a, "type", t).
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC006", p, l) :-
    bootstrap_fn(f, x), suffix("_lazy", x), bootstrap_fn_ann(f, t), bootstrap_ann(t, y), bootstrap_lazy_forbidden(y),
    bootstrap_at(t, p, l).

// SBC002: a parameter other than self/cls without an annotation; or with a broad name in its annotation,
// unless the only broad name is Sequence and the def is public and the annotation a read-only domain sequence.
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC002", p, l) :-
    bootstrap_bare(_, nm, x), x != "self", x != "cls", bootstrap_at(nm, p, l).
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC002", p, l) :-
    bootstrap_param(_, nm, x, t), x != "self", x != "cls", bootstrap_broad_other(t), bootstrap_at(nm, p, l).
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC002", p, l) :-
    bootstrap_param(f, nm, x, t), x != "self", x != "cls", bootstrap_ann(t, "Sequence"), !bootstrap_broad_other(t),
    !bootstrap_public_readonly(f, t), bootstrap_at(nm, p, l).
.decl bootstrap_public_readonly(f: node, t: node)
bootstrap_public_readonly(f, t) :- bootstrap_param(f, _, _, t), bootstrap_fn(f, y), !prefix("_", y),
    bootstrap_readonly(t).

// SBC006: a schema-transaction parameter (current_schema_txn, schema_transaction, schema_txn) typed Sync- or
// AsyncSchemaTransaction, in a def not named …_lazy.
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC006", p, l) :-
    bootstrap_param(f, nm, x, t), bootstrap_schema_txn_name(x), bootstrap_fn(f, y), !suffix("_lazy", y),
    bootstrap_ann(t, z), (z = "AsyncSchemaTransaction" ; z = "SyncSchemaTransaction"), bootstrap_at(nm, p, l).

// SBC004: a def with an annotated connection-like parameter and an annotated transaction-like one (self and
// cls not counted), at the def.
.decl bootstrap_conn_param(f: node)
bootstrap_conn_param(f) :- bootstrap_param(f, _, x, _), x != "self", x != "cls", bootstrap_conn_name(x).
bootstrap_conn_param(f) :- bootstrap_param(f, _, x, t), x != "self", x != "cls", bootstrap_ann(t, y),
    bootstrap_conn_type(y).
.decl bootstrap_txn_param(f: node)
bootstrap_txn_param(f) :- bootstrap_param(f, _, x, _), x != "self", x != "cls", bootstrap_txn_name(x).
bootstrap_txn_param(f) :- bootstrap_param(f, _, x, t), x != "self", x != "cls", bootstrap_ann(t, y),
    bootstrap_txn_type(y).
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC004", p, l) :-
    bootstrap_conn_param(f), bootstrap_txn_param(f), bootstrap_at(f, p, l).

// SBC003 / SBC005: any call (module level too) of getattr/hasattr/setattr/delattr, or isinstance/issubclass, by
// Name or Attribute, the callee's parentheses taken off.
.decl bootstrap_peel(c: node, e: node)
bootstrap_peel(c, g) :- node(d, c, "call", _, _), bootstrap_doc(d), field(c, "function", g).
bootstrap_peel(c, i) :- bootstrap_peel(c, e), node(_, e, "parenthesized_expression", _, _), child(e, i, 0).
.decl bootstrap_callee(c: node, x: symbol)
bootstrap_callee(c, x) :- bootstrap_peel(c, u), node(_, u, "identifier", _, _), text(u, x).
bootstrap_callee(c, x) :- bootstrap_peel(c, u), node(_, u, "attribute", _, _), field(u, "attribute", a), text(a, x).
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC003", p, l) :-
    bootstrap_callee(c, x), (x = "delattr" ; x = "getattr" ; x = "hasattr" ; x = "setattr"), bootstrap_at(c, p, l).
violation("data-layer-schema-bootstrap-contracts", "bootstrap-contracts", "SBC005", p, l) :-
    bootstrap_callee(c, x), (x = "isinstance" ; x = "issubclass"), bootstrap_at(c, p, l).
