// data-layer-declared-fact-interrogation: both clauses, by hand (decision 0043). The policy is
// candidates/rules/data-layer-declared-fact-interrogation.json; it declares no options.
//
// Notes against W:
// - contract-attribute: `value: {regex: "^(?:…)$"}` on a string is value(s, v) with value_type_of(s, "str"), v
//   one of the names (the regex is anchored at both ends). `nthChild: 2` counts the argument list's named
//   children, comments included (matcher/nth_child.rs: `is_named`); `child` has no comments, so the position is
//   the string's child index plus the comments before it (token rows whose text starts with `#`).
// - override-identity: W's `has: {regex: "^(?:==|!=|…)$"}` tests every child of the comparison, anonymous ones
//   (the operators) and comments included: token rows, by their text (a `not in` with a comment or more than one
//   space inside is no `not in` to W, nor here).

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl node_text(n: node, s: symbol)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl token(p: node, i: number, s: symbol, start: number, end: number)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- contract-attribute: getattr/hasattr(obj, "<declared contract attribute>", …) ----
.decl contract_attribute_name(s: symbol)
contract_attribute_name("auxiliary_query").
contract_attribute_name("column_type_hints").
contract_attribute_name("creates_indexes").
contract_attribute_name("ddl_effect_scope").
contract_attribute_name("declared_column_type_hints").
contract_attribute_name("declared_columns").
contract_attribute_name("defines").
contract_attribute_name("effects_known").
contract_attribute_name("ephemeral").
contract_attribute_name("guarded_creates").
contract_attribute_name("guarded_indexes").
contract_attribute_name("modifies_rows").
contract_attribute_name("reads_outside_itself").
contract_attribute_name("relation_role").
contract_attribute_name("relation_scope").
contract_attribute_name("source_tables").
// The arguments of a getattr/hasattr call.
.decl contract_attribute_args(n: node, a: node)
contract_attribute_args(n, a) :- node(_, n, "call", _, _), field(n, "function", f), node(_, f, "identifier", _, _),
  text(f, x), (x = "getattr" ; x = "hasattr"), field(n, "arguments", a).
// A comment among the arguments, by its end.
.decl contract_attribute_comment(a: node, e: number)
contract_attribute_comment(a, e) :- contract_attribute_args(_, a), token(a, _, t, _, e), match("#(?s:.*)", t).
// The string that is the arguments' second named child, comments counted.
.decl contract_attribute_second(a: node, s: node)
contract_attribute_second(a, s) :- contract_attribute_args(_, a), child(a, s, i), node(_, s, "string", b, _),
  k = count : { contract_attribute_comment(a, e), e <= b }, i + k = 1.
violation("data-layer-declared-fact-interrogation", "contract-attribute", "CONTRACT_ATTR_PROBE", p, l) :-
  contract_attribute_args(n, a), contract_attribute_second(a, s), value_type_of(s, "str"), value(s, v),
  contract_attribute_name(v), node(d, n, _, _, _),
  in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).

// ---- override-identity: `type(x).m is Base.m` (either way round), x not self ----
.decl override_identity_op(s: symbol)
override_identity_op("==").
override_identity_op("!=").
override_identity_op("<").
override_identity_op(">").
override_identity_op("<=").
override_identity_op(">=").
override_identity_op("<>").
override_identity_op("in").
override_identity_op("not in").
// A comparison with a child (an operator, an operand or a comment) whose text is one of those.
.decl override_identity_other_op(n: node)
override_identity_other_op(n) :- node(_, n, "comparison_operator", _, _), token(n, _, s, _, _), override_identity_op(s).
// `^\(\s*self(?:\s*,)?\s*\)$` on the arguments' text: `type(self)`, `type(self,)`.
.decl override_identity_self_args(g: node)
override_identity_self_args(g) :- node(_, g, "argument_list", _, _), node_text(g, s),
  match("\(\s*self(?:\s*,)?\s*\)", s).
// `type(…).m`, the call's arguments not `(self)`.
.decl override_identity_type_attr(a: node)
override_identity_type_attr(a) :- node(_, a, "attribute", _, _), field(a, "object", c), node(_, c, "call", _, _),
  field(c, "function", f), node(_, f, "identifier", _, _), text(f, "type"),
  field(c, "arguments", g), node(_, g, "argument_list", _, _), !override_identity_self_args(g).
violation("data-layer-declared-fact-interrogation", "override-identity", "OVERRIDE_IDENTITY_PROBE", p, l) :-
  node(d, n, "comparison_operator", _, _), !override_identity_other_op(n),
  child(n, a, 0), node(_, a, "attribute", _, _), child(n, b, j), j > 0, node(_, b, "attribute", _, _),
  field(a, "attribute", x), field(b, "attribute", y), text(x, s), text(y, s),
  (override_identity_type_attr(a) ; override_identity_type_attr(b)),
  in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
