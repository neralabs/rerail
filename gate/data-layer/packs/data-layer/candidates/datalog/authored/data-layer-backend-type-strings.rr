comparison_1_bt001_start(c, n) :- comparison_1_bt001_hit(c, _, s), contains("\n", s), comparison_linestart(c, r), match("(?s)[^\n]*(?:dialect\.name\s* in \s*\().*", r), n = strlen(r).
.decl comparison_1_bt001_first(c: node, n: number)
comparison_1_bt001_first(c, n) :- comparison_1_bt001_hit(c, _, s), contains("\n", s), n = max m : { comparison_1_bt001_start(c, m) }.
comparison_first(c, n) :- comparison_1_bt001_first(c, n).
violation("data-layer-backend-type-strings", "comparison-1-BT001", "BT001", p, l) :- comparison_1_bt001_hit(c, d, _), comparison_1_bt001_first(c, n), k = count : { comparison_before(c, n, _) },
    line(c, l0), l = l0 + k, doc(d, p, _).

