// data-layer-backend-type-strings: every clause by hand. Each is a regex over a node's whole source text (comments and strings included, as W
// reads `node.text()`: `node_text`), anchored at the regex's named group AT, which W takes from the first (leftmost)
// match; each regex's AT begins where its match does (`\b` is zero-width). The named groups are dropped (`match`
// with named groups is not lowered): a group that only anchors changes nothing about whether the regex matches.
//
// The line of AT: a node whose text has no newline reports its own line. Otherwise each line start of its text (the
// text, and what follows each newline) is tested with `[^\n]*(?:RE)`, a match of RE starting on that line; the
// first such line (the longest line-start suffix) is AT's, at the node's line plus the newlines before it. The
// suffixes are a recursion through `substr` (one character per step; `substr` shrinks, so it is bounded), run only
// over the matching multi-line nodes. `substr`/`strlen` count characters and only newlines are counted, so the line
// is exact for any text (no byte offsets are used).
// `["']` is the policy's `[\"\']` (the same class). The clauses have no options.

.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)

// ---- shared: the line starts of each matching node whose text spans lines ----
.decl comparison_multi(c: node, s: symbol)
.decl comparison_suffix(c: node, r: symbol)
comparison_suffix(c, s) :- comparison_multi(c, s).
comparison_suffix(c, r) :- comparison_suffix(c, q), strlen(q) > 1, r = substr(q, 1, 1000000000).
// The length of each suffix that starts with a newline.
.decl comparison_nl(c: node, n: number)
comparison_nl(c, n) :- comparison_suffix(c, q), substr(q, 0, 1) = "\n", n = strlen(q).
.decl comparison_linestart(c: node, r: symbol)
comparison_linestart(c, s) :- comparison_multi(c, s).
comparison_linestart(c, r) :- comparison_suffix(c, q), substr(q, 0, 1) = "\n", r = substr(q, 1, 1000000000).
// The newlines before a clause's first matching line start (of length n): the newline suffixes longer than n.
.decl comparison_first(c: node, n: number)
.decl comparison_before(c: node, n: number, q: number)
comparison_before(c, n, q) :- comparison_first(c, n), comparison_nl(c, q), q > n.

// ---- comparison-0-BT002 (BT002) ----
.decl comparison_0_bt002_hit(c: node, d: number, s: symbol)
comparison_0_bt002_hit(c, d, s) :- node(d, c, "comparison_operator", _, _), in_scope(d), !out_scope(d), node_text(c, s), match("(?s:.*)(?:dialect\.name\s*==\s*[\"'](postgresql|neo4j|mariadb|doltdb|mongodb|dolt|mysql|sqlite|postgres|mongo)[\"'])(?s:.*)", s).
violation("data-layer-backend-type-strings", "comparison-0-BT002", "BT002", p, l) :- comparison_0_bt002_hit(c, d, s), !contains("\n", s), doc(d, p, _), line(c, l).
comparison_multi(c, s) :- comparison_0_bt002_hit(c, _, s), contains("\n", s).
.decl comparison_0_bt002_start(c: node, n: number)
comparison_0_bt002_start(c, n) :- comparison_0_bt002_hit(c, _, s), contains("\n", s), comparison_linestart(c, r), match("(?s)[^\n]*(?:dialect\.name\s*==\s*[\"'](postgresql|neo4j|mariadb|doltdb|mongodb|dolt|mysql|sqlite|postgres|mongo)[\"']).*", r), n = strlen(r).
.decl comparison_0_bt002_first(c: node, n: number)
comparison_0_bt002_first(c, n) :- comparison_0_bt002_hit(c, _, s), contains("\n", s), n = max m : { comparison_0_bt002_start(c, m) }.
comparison_first(c, n) :- comparison_0_bt002_first(c, n).
violation("data-layer-backend-type-strings", "comparison-0-BT002", "BT002", p, l) :- comparison_0_bt002_hit(c, d, _), comparison_0_bt002_first(c, n), k = count : { comparison_before(c, n, _) },
    line(c, l0), l = l0 + k, doc(d, p, _).

// ---- comparison-1-BT001 (BT001) ----
.decl comparison_1_bt001_hit(c: node, d: number, s: symbol)
comparison_1_bt001_hit(c, d, s) :- node(d, c, "comparison_operator", _, _), in_scope(d), !out_scope(d), node_text(c, s), match("(?s:.*)(?:dialect\.name\s* in \s*\()(?s:.*)", s).
violation("data-layer-backend-type-strings", "comparison-1-BT001", "BT001", p, l) :- comparison_1_bt001_hit(c, d, s), !contains("\n", s), doc(d, p, _), line(c, l).
