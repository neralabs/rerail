// ---- comparison-7-BT005 (BT005) ----
// A call whose `function` field is an attribute whose `attribute` field's text is `lower` (`has`, stopBy neighbor,
// with a field: that field's child; `^lower$`: its whole text), and the regex over the call's text.
.decl comparison_7_bt005_hit(c: node, d: number, s: symbol)
comparison_7_bt005_hit(c, d, s) :- node(d, c, "call", _, _), in_scope(d), !out_scope(d), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), text(a, "lower"), node_text(c, s), match("(?s:.*)(?:__class__\.__name__\.lower\(\))(?s:.*)", s).
violation("data-layer-backend-type-strings", "comparison-7-BT005", "BT005", p, l) :- comparison_7_bt005_hit(c, d, s), !contains("\n", s), doc(d, p, _), line(c, l).
comparison_multi(c, s) :- comparison_7_bt005_hit(c, _, s), contains("\n", s).
.decl comparison_7_bt005_start(c: node, n: number)
comparison_7_bt005_start(c, n) :- comparison_7_bt005_hit(c, _, s), contains("\n", s), comparison_linestart(c, r), match("(?s)[^\n]*(?:__class__\.__name__\.lower\(\)).*", r), n = strlen(r).
.decl comparison_7_bt005_first(c: node, n: number)
comparison_7_bt005_first(c, n) :- comparison_7_bt005_hit(c, _, s), contains("\n", s), n = max m : { comparison_7_bt005_start(c, m) }.
comparison_first(c, n) :- comparison_7_bt005_first(c, n).
violation("data-layer-backend-type-strings", "comparison-7-BT005", "BT005", p, l) :- comparison_7_bt005_hit(c, d, _), comparison_7_bt005_first(c, n), k = count : { comparison_before(c, n, _) },
    line(c, l0), l = l0 + k, doc(d, p, _).
