.decl comparison_1_bt002_hit(c: node, d: number, s: symbol)
comparison_1_bt002_hit(c, d, s) :- node(d, c, "comparison_operator", _, _), in_scope(d), !out_scope(d), node_text(c, s), match("(?s:.*)(?:dialect\.name\s+in\s+\()(?s:.*)", s), !match("(?s:.*)(?:dialect\.name\s* in \s*\()(?s:.*)", s).
violation("data-layer-backend-type-strings", "comparison-1-BT002", "BT002", p, l) :- comparison_1_bt002_hit(c, d, s), !contains("\n", s), doc(d, p, _), line(c, l).
