// data-layer-no-api-root-imports, clause `examples`: the exact form of examples_string, awaiting `value(n, v)` (W's
// semantic value, escapes decoded). Not read by the converter. When `value` is bound, replace the main file's
// examples_string rule with this one (and its str declaration with value's), and drop the APPROXIMATION note there.
.decl value(n: node, v: symbol)

.decl examples_string(d: number, n: node, first: number, last: number)
examples_string(d, n, first, last) :-
    node(d, n, "string", _, _), in_scope(d), !out_scope(d), !syntax_error(d),
    value(n, v), match("(?ms).*^[ \t]*(?:from api import [^\n]+|import api\\s*(?:\n|$)).*", v),
    line(n, first), end_line(n, last).

