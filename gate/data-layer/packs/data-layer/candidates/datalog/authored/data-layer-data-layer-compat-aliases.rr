// data-layer-data-layer-compat-aliases, both clauses by hand: the converter gaps their `compare`.
// Source: gate/data-layer/packs/data-layer/candidates/rules-ast/data-layer-data-layer-compat-aliases.json.
// Options: `sourceGate` is read from option_on (true: the module's text matches ` as |=`; false: `(?s).*`, every
// module); `oracleAnalyzer` is read by no clause.
.decl tape_syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl option_on(name: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- import-alias (DLA001) ---------------------------------------------------------------------------------------
// An import statement at module level (no function or class around it, any depth) with an aliased_import child
// whose alias is an identifier not starting with `_` (ALIAS) and differs from LEAF. One finding per aliased_import
// (`each: ALIAS_NODE`), at its line.
.decl import_alias_scopes(kind: symbol)
import_alias_scopes("function_definition"). import_alias_scopes("class_definition").
.decl import_alias_statement(d: number, s: node)
import_alias_statement(d, s) :- node(d, s, "import_statement", _, _).
import_alias_statement(d, s) :- node(d, s, "import_from_statement", _, _).
.decl import_alias_nested(s: node)
import_alias_nested(s) :- import_alias_statement(_, s), inside(s, a, import_alias_scopes), node(_, a, _, _, _).
// LEAF is `replace ^.*\. by ""` over SOURCE's text (the `name` child's node_text): the longest prefix of its first
// line that ends in `.` taken off. ALIAS, an identifier (no `.`, no line break, no regex metacharacter), equals LEAF
// exactly when that text is ALIAS, or a line-break-free prefix, a `.`, then ALIAS: the whole-string test below.
.decl import_alias_same(x: node)
import_alias_same(x) :- node(_, x, "aliased_import", _, _), field(x, "alias", a), text(a, alias), field(x, "name", src),
    node_text(src, t), re = cat("(?:[^\\n]*\\.)?", alias), match(re, t).
// The gate: the module's full text (comments and strings included) contains ` as ` or `=`; with `sourceGate`
// false, `(?s).*`: every module.
.decl import_alias_gate(d: number)
import_alias_gate(d) :- option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, s), contains(" as ", s).
import_alias_gate(d) :- option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, s), contains("=", s).
import_alias_gate(d) :- !option_on("sourceGate"), node(d, _, "module", _, _).
// `not regex ^_` on the alias identifier.
.decl import_alias_private(a: node)
import_alias_private(a) :- node(_, a, "identifier", _, _), text(a, s), prefix("_", s).
violation("data-layer-data-layer-compat-aliases", "import-alias", "DLA001", p, l) :-
    import_alias_statement(d, s), !import_alias_nested(s),
    child(s, x, _), node(_, x, "aliased_import", _, _),
    field(x, "alias", a), node(_, a, "identifier", _, _), !import_alias_private(a),
    field(x, "name", _), !import_alias_same(x),
    import_alias_gate(d),
    in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(x, l).

// ---- assignment-alias (DLA002) -----------------------------------------------------------------------------------
// A module-level assignment whose left is an identifier not starting with `_` (TARGET) and whose right is a
// final-alias, SOURCE != TARGET. final-alias: an identifier (SOURCE is it), an attribute (SOURCE its `attribute`
// identifier), or an assignment whose right is a final-alias (`a = b = c`). The gate needs no test here: an
// assignment with a right side has an `=` token, so its module's text contains `=` (and `sourceGate` false passes
// every module).
.decl assignment_alias_scopes(kind: symbol)
assignment_alias_scopes("function_definition"). assignment_alias_scopes("class_definition").
.decl assignment_alias_nested(s: node)
assignment_alias_nested(s) :- node(_, s, "assignment", _, _), inside(s, a, assignment_alias_scopes), node(_, a, _, _, _).
// assignment_alias_source(x, s): x is a final-alias binding SOURCE to the text s. Recursion runs down `right`.
.decl assignment_alias_source(x: node, s: symbol)
assignment_alias_source(x, s) :- node(_, x, "identifier", _, _), text(x, s).
assignment_alias_source(x, s) :- node(_, x, "attribute", _, _), field(x, "attribute", y), node(_, y, "identifier", _, _), text(y, s).
assignment_alias_source(x, s) :- node(_, x, "assignment", _, _), field(x, "right", r), assignment_alias_source(r, s).
.decl assignment_alias_private(t: node)
assignment_alias_private(t) :- node(_, t, "identifier", _, _), text(t, s), prefix("_", s).
violation("data-layer-data-layer-compat-aliases", "assignment-alias", "DLA002", p, l) :-
    node(d, n, "assignment", _, _), !assignment_alias_nested(n),
    field(n, "left", t), node(_, t, "identifier", _, _), text(t, target), !assignment_alias_private(t),
    field(n, "right", r), assignment_alias_source(r, source), target != source,
    in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
