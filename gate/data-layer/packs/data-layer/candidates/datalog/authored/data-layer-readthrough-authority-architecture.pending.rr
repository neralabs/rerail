// data-layer-readthrough-authority-architecture, awaiting `value(n, v)` (W's semantic value, escapes decoded):
// merge into data-layer-readthrough-authority-architecture.rr once the corpus runner binds it.
// The clauses read `value` on `string` and `concatenated_string` nodes as W's `value: { eq: "…" }` does:
// - `value(s, "x")`, s no bytes literal, is W's value equal to the str "x" (W: b"x" == "x" is false). A bytes
//   literal is told by its prefix (`strprefix` has a `b`; a concatenation by a part's), whatever row `value`
//   gives it.
// - no `value` row on a string or concatenated_string is W's Unknown (an f-string with a replacement field, a
//   t-string, a malformed escape, mixed str/bytes, over 64 KiB). Both clauses read values, so W evaluates them
//   three-valued: Unknown never matches, and under `not` it stays Unknown, which reports nothing.
// The leading `regex: (?s).*` of each clause holds for every node and is left out.

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl line(n: node, l: number)
.decl strprefix(n: node, s: symbol)
.decl value(n: node, v: symbol)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl inside(n: node, a: node, set: relation)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)

// ---- runtime-seed -----------------------------------------------------------------------------------------------
// Every string or concatenated_string whose value is "__readthrough_local_overlays" (a string inside a
// concatenated_string is tested on its own value too, as W visits it).
.decl runtime_seed_kind(k: symbol)
runtime_seed_kind("string").
runtime_seed_kind("concatenated_string").

// A bytes literal, or a concatenation with a bytes part (all bytes, or a mix, which W leaves Unknown).
.decl runtime_seed_bytes(s: node)
runtime_seed_bytes(s) :- node(_, s, "string", _, _), strprefix(s, p), contains("b", p).
runtime_seed_bytes(s) :-
    node(_, s, "concatenated_string", _, _), child(s, c, _), strprefix(c, p), contains("b", p).

violation("data-layer-readthrough-authority-architecture", "runtime-seed", "RTA002", p, l) :-
    node(d, s, k, _, _), runtime_seed_kind(k), value(s, "__readthrough_local_overlays"), !runtime_seed_bytes(s),
    in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(s, l).

// ---- complete-identity ------------------------------------------------------------------------------------------
// class ReadThroughDeleteChangedPrincipalRowsStep, unless a direct statement X of its body is a `compile` method
// (a function_definition named compile, or a decorated_definition with one as a direct child) that no earlier
// sibling compile method precedes (`not follows`, stopBy end) and that has, anywhere below it, a string or
// concatenated_string of each of the six identity values. Three-valued as W: a value test on a string with no
// known value is Unknown, so `has` of a key is Unknown when no node matches it and some string below is Unknown;
// the six-way `all` is false when one key is definitely missing, else Unknown when one is Unknown. The class is
// reported only when every X is definitely false; an Unknown X makes the `not` Unknown, which reports nothing.
.decl complete_identity_fdef(k: symbol)
complete_identity_fdef("function_definition").

.decl complete_identity_strkind(k: symbol)
complete_identity_strkind("string").
complete_identity_strkind("concatenated_string").

// As runtime_seed_bytes.
.decl complete_identity_bytes(s: node)
complete_identity_bytes(s) :- node(_, s, "string", _, _), strprefix(s, p), contains("b", p).
complete_identity_bytes(s) :-
    node(_, s, "concatenated_string", _, _), child(s, c, _), strprefix(c, p), contains("b", p).

.decl complete_identity_key(v: symbol)
complete_identity_key("upstream_namespace").
complete_identity_key("authority_namespace").
complete_identity_key("authorization_epoch").
complete_identity_key("catalog_fingerprint").
complete_identity_key("admitted_session_id").
complete_identity_key("principal_user_id").

// A function_definition named compile.
.decl complete_identity_compile(g: node)
complete_identity_compile(g) :-
    node(_, g, "function_definition", _, _), field(g, "name", nm), node(_, nm, "identifier", _, _),
    text(nm, "compile").

// m is a compile method (the `any` of the clause), g its function_definition.
.decl complete_identity_def(m: node, g: node)
complete_identity_def(m, m) :- complete_identity_compile(m).
complete_identity_def(m, g) :-
    node(_, m, "decorated_definition", _, _), child(m, g, _), complete_identity_compile(g).

// Key t has a string of that value below g.
.decl complete_identity_hit(g: node, t: symbol)
complete_identity_hit(g, t) :-
    complete_identity_compile(g), inside(s, g, complete_identity_fdef), node(_, s, k, _, _),
    complete_identity_strkind(k), value(s, t), complete_identity_key(t), !complete_identity_bytes(s).

// Some string below g has no known value.
.decl complete_identity_unknown(g: node)
complete_identity_unknown(g) :-
    complete_identity_compile(g), inside(s, g, complete_identity_fdef), node(_, s, k, _, _),
    complete_identity_strkind(k), !value(s, _).

// Some key has no string of its value below g.
.decl complete_identity_miss(g: node)
complete_identity_miss(g) :- complete_identity_compile(g), complete_identity_key(t), !complete_identity_hit(g, t).

// g's six-way `all` is true or Unknown (not definitely false).
.decl complete_identity_open(g: node)
complete_identity_open(g) :- complete_identity_compile(g), !complete_identity_miss(g).
complete_identity_open(g) :- complete_identity_miss(g), complete_identity_unknown(g).

// m follows an earlier compile method among its siblings.
.decl complete_identity_after(m: node)
complete_identity_after(m) :-
    child(b, m, i), complete_identity_def(m, _), child(b, x, j), j < i, complete_identity_def(x, _).

// The body block b has a statement X that is true or Unknown.
.decl complete_identity_open_body(b: node)
complete_identity_open_body(b) :-
    child(b, m, _), complete_identity_def(m, g), !complete_identity_after(m), complete_identity_open(g).

violation("data-layer-readthrough-authority-architecture", "complete-identity", "RTA008", p, l) :-
    node(d, c, "class_definition", _, _), field(c, "name", nm), node(_, nm, "identifier", _, _),
    text(nm, "ReadThroughDeleteChangedPrincipalRowsStep"), field(c, "body", b), !complete_identity_open_body(b),
    in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(c, l).
