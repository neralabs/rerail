ud81a\udf2f\ud81a\udf40-\ud81a\udf43\ud81a\udf50-\ud81a\udf59\ud81a\udf5b-\ud81a\udf61\ud81a\udf63-\ud81a\udf77\ud81a\udf7d-\ud81a\udf8f\ud81b\ude40-\ud81b\ude96\ud81b\udf00-\ud81b\udf4a\ud81b\udf50\ud81b\udf93-\ud81b\udf9f\ud81b\udfe0-\ud81b\udfe1\ud81b\udfe3\ud81c\udc00-\ud821\udff7\ud822\udc00-\ud823\udcd5\ud823\udd00-\ud823\udd08\ud82b\udff0-\ud82b\udff3\ud82b\udff5-\ud82b\udffb\ud82b\udffd-\ud82b\udffe\ud82c\udc00-\ud82c\udd22\ud82c\udd32\ud82c\udd50-\ud82c\udd52\ud82c\udd55\ud82c\udd64-\ud82c\udd67\ud82c\udd70-\ud82c\udefb\ud82f\udc00-\ud82f\udc6a\ud82f\udc70-\ud82f\udc7c\ud82f\udc80-\ud82f\udc88\ud82f\udc90-\ud82f\udc99\ud834\udec0-\ud834\uded3\ud834\udee0-\ud834\udef3\ud834\udf60-\ud834\udf78\ud835\udc00-\ud835\udc54\ud835\udc56-\ud835\udc9c\ud835\udc9e-\ud835\udc9f\ud835\udca2\ud835\udca5-\ud835\udca6\ud835\udca9-\ud835\udcac\ud835\udcae-\ud835\udcb9\ud835\udcbb\ud835\udcbd-\ud835\udcc3\ud835\udcc5-\ud835\udd05\ud835\udd07-\ud835\udd0a\ud835\udd0d-\ud835\udd14\ud835\udd16-\ud835\udd1c\ud835\udd1e-\ud835\udd39\ud835\udd3b-\ud835\udd3e\ud835\udd40-\ud835\udd44\ud835\udd46\ud835\udd4a-\ud835\udd50\ud835\udd52-\ud835\udea5\ud835\udea8-\ud835\udec0\ud835\udec2-\ud835\udeda\ud835\udedc-\ud835\udefa\ud835\udefc-\ud835\udf14\ud835\udf16-\ud835\udf34\ud835\udf36-\ud835\udf4e\ud835\udf50-\ud835\udf6e\ud835\udf70-\ud835\udf88\ud835\udf8a-\ud835\udfa8\ud835\udfaa-\ud835\udfc2\ud835\udfc4-\ud835\udfcb\ud835\udfce-\ud835\udfff\ud837\udf00-\ud837\udf1e\ud837\udf25-\ud837\udf2a\ud838\udc30-\ud838\udc6d\ud838\udd00-\ud838\udd2c\ud838\udd37-\ud838\udd3d\ud838\udd40-\ud838\udd49\ud838\udd4e\ud838\ude90-\ud838\udead\ud838\udec0-\ud838\udeeb\ud838\udef0-\ud838\udef9\ud839\udcd0-\ud839\udceb\ud839\udcf0-\ud839\udcf9\ud839\udfe0-\ud839\udfe6\ud839\udfe8-\ud839\udfeb\ud839\udfed-\ud839\udfee\ud839\udff0-\ud839\udffe\ud83a\udc00-\ud83a\udcc4\ud83a\udcc7-\ud83a\udccf\ud83a\udd00-\ud83a\udd43\ud83a\udd4b\ud83a\udd50-\ud83a\udd59\ud83b\udc71-\ud83b\udcab\ud83b\udcad-\ud83b\udcaf\ud83b\udcb1-\ud83b\udcb4\ud83b\udd01-\ud83b\udd2d\ud83b\udd2f-\ud83b\udd3d\ud83b\ude00-\ud83b\ude03\ud83b\ude05-\ud83b\ude1f\ud83b\ude21-\ud83b\ude22\ud83b\ude24\ud83b\ude27\ud83b\ude29-\ud83b\ude32\ud83b\ude34-\ud83b\ude37\ud83b\ude39\ud83b\ude3b\ud83b\ude42\ud83b\ude47\ud83b\ude49\ud83b\ude4b\ud83b\ude4d-\ud83b\ude4f\ud83b\ude51-\ud83b\ude52\ud83b\ude54\ud83b\ude57\ud83b\ude59\ud83b\ude5b\ud83b\ude5d\ud83b\ude5f\ud83b\ude61-\ud83b\ude62\ud83b\ude64\ud83b\ude67-\ud83b\ude6a\ud83b\ude6c-\ud83b\ude72\ud83b\ude74-\ud83b\ude77\ud83b\ude79-\ud83b\ude7c\ud83b\ude7e\ud83b\ude80-\ud83b\ude89\ud83b\ude8b-\ud83b\ude9b\ud83b\udea1-\ud83b\udea3\ud83b\udea5-\ud83b\udea9\ud83b\udeab-\ud83b\udebb\ud83c\udd00-\ud83c\udd0c\ud83e\udff0-\ud83e\udff9\ud840\udc00-\ud869\udedf\ud869\udf00-\ud86d\udf39\ud86d\udf40-\ud86e\udc1d\ud86e\udc20-\ud873\udea1\ud873\udeb0-\ud87a\udfe0\ud87a\udff0-\ud87b\ude5d\ud87e\udc00-\ud87e\ude1d\ud880\udc00-\ud884\udf4a\ud884\udf50-\ud888\udfaf]))(?s:.*)", v).
.decl ofc_hinted(f: node)
ofc_hinted(f) :- ofc_hint_piece(s), ofc_in_def(s, f).
.decl ofc_raise_exc(r: node, e: node)
ofc_raise_exc(r, m) :- node(_, r, "raise_statement", _, _), child(r, e, _), !field(r, "cause", e), optimizer_unparen(e, m).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-031", p, l) :- ofc_raise_exc(n, e),
    !node(_, e, "identifier", _, _), nearest(n, f, "function_definition"), !ofc_hinted(f), ofc_at(n, _, p, l).

// PV2-060: a legality predicate defined (a FunctionDef, not async), a legality fact read, or
// `.can_share_statement_after(…)` called, outside effects.py and adapter.py.
.decl ofc_def_name(f: node, x: symbol)
ofc_def_name(f, x) :- node(_, f, "function_definition", _, _), !op(f, "async"), field(f, "name", nm), text(nm, x).
.decl ofc_not_legality_home(d: number)
ofc_not_legality_home(d) :- ofc_file(d, _), !ofc_base(d, "effects.py"), !ofc_base(d, "adapter.py").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :- ofc_def_name(n, x),
    (x = "can_share_statement_after" ; x = "conflicts_with" ; x = "placement_after" ; x = "repeated_write_keys"),
    ofc_at(n, d, p, l), ofc_not_legality_home(d).
.decl ofc_legality_fact(x: symbol)
ofc_legality_fact("cte_rewritable_read_tables"). ofc_legality_fact("estimated_param_count").
ofc_legality_fact("has_unbounded_params"). ofc_legality_fact("requires_materialized_inputs").
ofc_legality_fact("requires_prior_statement_visibility_after_writes"). ofc_legality_fact("requires_runtime_sequential_batch").
ofc_legality_fact("supports_sql_batch_transport").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :- optimizer_attr(n, x),
    ofc_legality_fact(x), ofc_at(n, d, p, l), ofc_not_legality_home(d).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-060", p, l) :-
    optimizer_callee_attr(n, "can_share_statement_after"), ofc_at(n, d, p, l), ofc_not_legality_home(d).

// PV2-044: more than 600 lines, at the Module's line, 1. optimizer_files' line_count is 1 + the number of "\n" in
// its text, which depends on entryPoint (optimizer_contract). "scan_file": the raw source_text, so a CR LF is one
// line and a lone CR none: src_line_lf's lines, plus one where the source ends with "\n". Any other value (the
// default "all" too): the source with CR LF, then each lone CR, made LF, so one more than its `\r\n`, `\r` and `\n`
// terminators: the tape's lines (tape_line, the empty line after a final terminator included).
.decl ofc_lf(d: number, k: number)
ofc_lf(d, k) :- option_value("entryPoint", "scan_file"), ofc_file(d, _), k = count : { src_line_lf(d, _, _) }.
.decl ofc_ends_lf(d: number)
ofc_ends_lf(d) :- ofc_file(d, _), source(d, sp), text(sp, s), suffix("\n", s).
.decl ofc_tape_lines(d: number, k: number)
ofc_tape_lines(d, k) :- !option_value("entryPoint", "scan_file"), ofc_file(d, _), k = count : { tape_line(d, _, _) }.
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-044", p, 1) :- ofc_lf(d, k), k > 600, ofc_file(d, p).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-044", p, 1) :- ofc_lf(d, 600), ofc_ends_lf(d), ofc_file(d, p).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-044", p, 1) :- ofc_tape_lines(d, k), k > 600,
    ofc_file(d, p).

// PV2-042: an Assign (not AnnAssign) whose first target is an Attribute, in no def named __init__/__post_init__.
.decl ofc_in_init(n: node)
ofc_in_init(n) :- inside(n, f, "function_definition"), field(f, "name", nm), text(nm, x), (x = "__init__" ; x = "__post_init__").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-042", p, l) :- optimizer_stmt(n, _),
    !optimizer_ann(n), field(n, "left", t), optimizer_untarget(t, a), node(_, a, "attribute", _, _), !ofc_in_init(n),
    ofc_at(n, _, p, l).

// pass_classes: module-level ClassDefs `*Pass` (a decorated one too) with no Name/Attribute base `Protocol`.
.decl ofc_top(s: node, x: node)                   // x is (the definition of) top-level statement s
ofc_top(s, s) :- node(_, m, "module", _, _), child(m, s, _).
ofc_top(s, x) :- node(_, m, "module", _, _), child(m, s, _), node(_, s, "decorated_definition", _, _), field(s, "definition", x).
.decl ofc_protocol_base(c: node)
ofc_protocol_base(c) :- field(c, "superclasses", al), child(al, b, _), optimizer_unparen(b, k),
    (node(_, k, "identifier", _, _), text(k, "Protocol") ; optimizer_attr(k, "Protocol")).
.decl ofc_pass_class(c: node, x: symbol, st: number)
ofc_pass_class(c, x, st) :- ofc_top(s, c), node(_, c, "class_definition", _, _), field(c, "name", nm), text(nm, x),
    suffix("Pass", x), !ofc_protocol_base(c), node(_, s, _, st, _).
// A class body's direct AnnAssign `<name>: … [= value]`; ofc_phase_decl: `phase: … = <Attribute>`, by start.
.decl ofc_class_ann(c: node, a: node, x: symbol, st: number)
ofc_class_ann(c, a, x, st) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _),
    optimizer_stmt(a, s), optimizer_ann(a), field(a, "left", t), node(_, t, "identifier", _, _), text(t, x),
    node(_, a, _, st, _).
.decl ofc_phase_decl(c: node, st: number, v: symbol)
ofc_phase_decl(c, st, v) :- ofc_class_ann(c, a, "phase", st), field(a, "right", r), optimizer_unparen(r, k), optimizer_attr(k, v).
.decl ofc_declared_phase(c: node, v: symbol)
ofc_declared_phase(c, v) :- ofc_pass_class(c, _, _), s = min t : { ofc_phase_decl(c, t, _) }, ofc_phase_decl(c, s, v).
.decl ofc_has_phase(c: node)
ofc_has_phase(c) :- ofc_phase_decl(c, _, _).
.decl ofc_has_name(c: node)
ofc_has_name(c) :- ofc_class_ann(c, _, "name", _).
.decl ofc_has_run(c: node)
ofc_has_run(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _),
    (ofc_def_name(s, "run") ; node(_, s, "decorated_definition", _, _), field(s, "definition", f), ofc_def_name(f, "run")).

// PV2-040: in passes.py, a pass class missing its phase, its name or its run().
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-040", p, l) :- ofc_pass_class(n, _, _),
    (!ofc_has_phase(n) ; !ofc_has_name(n) ; !ofc_has_run(n)), ofc_at(n, d, p, l), ofc_base(d, "passes.py").

// pipeline_entries: in a Tuple that is a top-level DEFAULT_V2_PASSES assignment's value, each element (parentheses
// off) calling a Name, phased by the last same-named pass class before it.
.decl ofc_phase_rank(v: symbol, r: number)
ofc_phase_rank("NORMALIZE", 0). ofc_phase_rank("ANALYZE", 1). ofc_phase_rank("PHYSICAL", 2).
.decl ofc_pipeline(a: node, tup: node, ts: number)
ofc_pipeline(a, tup, ts) :- node(_, m, "module", _, _), child(m, s, _), optimizer_stmt(a, s),
    field(a, "left", t), node(_, t, "identifier", _, _), text(t, "DEFAULT_V2_PASSES"), optimizer_value(a, v),
    optimizer_unparen(v, tup), (node(_, tup, "tuple", ts, _) ; node(_, tup, "expression_list", ts, _)).
.decl ofc_entry(a: node, i: number, x: symbol, ts: number)
ofc_entry(a, i, x, ts) :- ofc_pipeline(a, tup, ts), child(tup, e, i), optimizer_unparen(e, c), optimizer_callee_name(c, x).
.decl ofc_entry_phase(a: node, i: number, r: number)
.decl ofc_before(a: node, i: number, c: node, t: number)    // a same-named pass class starting before the tuple
ofc_before(a, i, c, t) :- ofc_entry(a, i, x, ts), node(d, a, _, _, _), ofc_pass_class(c, x, t), node(d, c, _, _, _), t < ts.
ofc_entry_phase(a, i, r) :- ofc_entry(a, i, _, _), s = max t : { ofc_before(a, i, _, t) },
    ofc_before(a, i, c, s), ofc_declared_phase(c, v), ofc_phase_rank(v, r).

// PV2-041: in passes.py, a later entry of an earlier phase.
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-041", p, l) :- ofc_entry_phase(n, i, r),
    ofc_entry_phase(n, j, q), i < j, q < r, ofc_at(n, d, p, l), ofc_base(d, "passes.py").

// PV2-043: in passes.py, a top-level `def run_verified_passes` without a Name PlanVerifier in it.
.decl ofc_has_verifier(f: node)
ofc_has_verifier(f) :- optimizer_name(v, "PlanVerifier"), ofc_in_def(v, f).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-043", p, l) :- ofc_top(_, n),
    ofc_def_name(n, "run_verified_passes"), !ofc_has_verifier(n), ofc_at(n, d, p, l), ofc_base(d, "passes.py").

// ---- optimizer-invariant-registry ------------------------------------------------------------------------------
// Repository-wide (no partitionBy): verifier.py's registry against the Markdown doc's codes.
.decl oir_verifier(d: number)                    // verifier.py, parsed (A2): registered_invariants' rows
oir_verifier(d) :- doc(d, "impl/common/l2065_plan_core/verifier.py", _), in_scope(d), !out_scope(d), !tape_syntax_error(d),
    !cpython_syntax_error(d, _, _).
.decl oir_verifier_text(d: number)               // verifier.py's source_text is not NULL
oir_verifier_text(d) :- doc(d, "impl/common/l2065_plan_core/verifier.py", _), in_scope(d), !out_scope(d).
.decl oir_doc(d: number)
oir_doc(d) :- doc(d, "docs/design/PLAN_OPTIMIZER_V2_INVARIANTS.md", _), in_scope(d), !out_scope(d).

// registered_invariants: `OptimizerInvariant(…, code=<str Constant>, …)` calls in verifier.py.
.decl oir_registered(n: node, v: symbol)
oir_registered(n, v) :- optimizer_callee_name(n, "OptimizerInvariant"), node(d, n, _, _, _), oir_verifier(d),
    field(n, "arguments", al), child(al, kw, _), node(_, kw, "keyword_argument", _, _), field(kw, "name", k),
    text(k, "code"), field(kw, "value", e), optimizer_unparen(e, c), optimizer_str_const(c, v).
.decl oir_code(v: symbol)
oir_code(v) :- oir_registered(_, v).

// doc_codes: W's regex over the doc's content, each match's CODE group (match_group: find_iter's matches).
.decl oir_doc_code(c: symbol)
oir_doc_code(c) :- oir_doc(d), source(d, sp),
    match_group("`(?P<CODE>(?:scope|schema|effects|cardinality|rewrite)\\.[a-z_0-9]+)`", sp, _, "CODE", g), text(g, c).

// verifier.py cites `(<code>)` somewhere in its source (W's instr over source_text).
.decl oir_cited(v: symbol)
oir_cited(v) :- oir_code(v), oir_verifier(d), source(d, sp), text(sp, s), contains(cat("(", cat(v, ")")), s).

.decl oir_at(n: node, p: symbol, l: number)
oir_at(n, p, l) :- node(d, n, _, _, _), oir_verifier(d), doc(d, p, _), line(n, l).

// oir_mode("gated"): the default case; oir_mode("ungated"): find_violations.
.decl oir_mode(m: symbol)
oir_mode("gated") :- option_value("entryPoint", e), e != "scan_file", e != "find_violations".
oir_mode("ungated") :- option_value("entryPoint", "find_violations").
.decl oir_run(k: number)                         // the doc and stale-code branches run
oir_run(1) :- oir_mode("gated"), oir_verifier_text(_).
oir_run(1) :- oir_mode("ungated").
.decl oir_any(k: number)                         // any case but scan_file
oir_any(1) :- oir_mode(_).

// PV2-050: a registered code the doc does not list; PV2-052: one verifier.py never cites as `(<code>)`.
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-050", p, l) :- oir_any(1),
    oir_registered(n, v), oir_doc(_), !oir_doc_code(v), oir_at(n, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-052", p, l) :- oir_any(1),
    oir_registered(n, v), oir_doc(_), !oir_cited(v), oir_at(n, p, l).
// PV2-050: no doc at all, reported at the doc's path, line 1.
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-050", "docs/design/PLAN_OPTIMIZER_V2_INVARIANTS.md", 1) :-
    oir_run(1), !oir_doc(_).
// PV2-051: the doc lists a code nobody registers (one finding per code; all at the doc's line 1).
violation("data-layer-plan-optimizer-v2", "optimizer-invariant-registry", "PV2-051", p, 1) :- oir_run(1),
    oir_doc_code(c), !oir_code(c), oir_doc(d), doc(d, p, _).
