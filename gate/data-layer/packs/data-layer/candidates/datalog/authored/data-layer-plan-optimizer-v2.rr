// data-layer-plan-optimizer-v2: both clauses are relational SQL over a `pythonAst` stage (CPython 3.13 `ast` rows:
// value/python_ast/metadata.py `structure_index` and worker.py's `ast_nodes` expansion, every node with a location
// or fields, `ast.arguments` included; origin/jeremybarnes/Data-layer-rule-expressivity at 26704acc4, the first
// with the policy's `ast_level`), which the converter cannot say (decision 0043).
// Policy: gate/data-layer/packs/data-layer/rules/data-layer-plan-optimizer-v2.json.
//
// The `ast` rows are read over tree-sitter's tree. The CPython ↔ tree-sitter mapping, per kind used:
//   Module ↔ module · Import/ImportFrom ↔ import_statement/import_from_statement (level 0 = a dotted_name
//   module_name; relative_import is level > 0; future_import_statement's module `__future__` never matches) ·
//   alias.name ↔ the dotted_name's identifiers joined by "." · Call ↔ call (func = unparen(function)) · Attribute ↔
//   attribute (its ast_name is the attr, the `attribute` field's text) · Name ↔ an identifier in expression position
//   (optimizer_name) · Constant str ↔ a str-form string or a concatenated_string of them (optimizer_str_const) ·
//   JoinedStr ↔ an f-string, a concatenated_string with one (optimizer_fstr), or a format_specifier (a format spec's
//   JoinedStr, at its `:`), and its Constant pieces ↔ W's fstring_piece literals (optimizer_fpiece) · Compare ↔
//   comparison_operator (every named child an operand) · BinOp BitAnd ↔ binary_operator with op "&" ·
//   Assign/AnnAssign ↔ a statement-level assignment (with `type`: AnnAssign), `a = b = v`
//   one Assign with targets a, b and value v · Tuple (a `value`) ↔ tuple or expression_list · Raise ↔
//   raise_statement (exc = its child that is not the `cause`) · FunctionDef ↔ function_definition without op
//   "async"; ClassDef ↔ class_definition, a decorated one's parent being the decorated_definition's.
// Parentheses have no `ast` node: every "child" test goes through optimizer_unparen.
// `ast` preorder ids are compared only between top-level statements of one module (pipeline_entries' `p.id <
// tuple.id`, pass_classes' first AnnAssign): there preorder order is byte order, so starts are compared.
//
// Approximations (named again where they are made):
//   A1 identifiers in `case` patterns and PEP 695 type parameter names count as Names (CPython: MatchAs/TypeVar
//      strings), as in python/ast.rr ast_name.
//   A2 the gate (`syntax: valid`) is W's own verdict, tree-sitter's (`!tape_syntax_error(d)`); the `pythonAst` stage
//      then runs CPython's `ast.parse`, and a file it rejects fails the stage (W's worker raises: the run errors).
//      Here such a file (`cpython_syntax_error`, CPython 3.13's verdict) has no `ast` rows and gives nothing. GAP:
//      W's error itself is not reproduced.
//
// optimizer-invariant-registry reads the Markdown doc `docs/design/PLAN_OPTIMIZER_V2_INVARIANTS.md` as a text
// document (doc/source; its doc_codes input is W's regex over the file, match_group exactly). W's
// `source_text(p) IS NOT NULL` (the doc's, and the default case's verifier.py gate) is read as "p is a document in
// scope": source_text reads the rule scope's source snapshot, so no parse is needed.
//
// Options: entryPoint, read from the converter's option_value. optimizer-file-checks reads it through its
// `optimizer_contract` stage (`SELECT <entryPoint> entry`), in optimizer_files' line_count: PV2-044 (below).
// optimizer-invariant-registry reads it in the registry's `$option` cases: "scan_file" reports nothing (its union
// ends `WHERE 0`); "find_violations" is the four branches without the `source_text(verifier.py) IS NOT NULL` gate;
// any other value (the default "all" too) is the default case, gated. PV2-050/052 need a registered invariant, so a
// parsed verifier.py, either way. `parameters` is read by neither clause.
//
// python/ast.rr lowers in an overlay, but it is not included: its str_const reads str_part (CPython-only, still
// unbound), its ast_name makes no walrus target a Name, and its unparen/assign helpers would come with the whole
// library. The small helpers below mirror it, each saying which and where they differ.

.decl tape_syntax_error(d: number)
.decl cpython_syntax_error(d: number, l: number, msg: symbol)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl option_value(name: symbol, v: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)

// ---- shared: the `ast` view of the tree ------------------------------------------------------------------------

// mirrors python/ast.rr unparen: e without its parentheses.
.decl optimizer_unparen(e: node, m: node)
optimizer_unparen(e, e) :- node(_, e, k, _, _), k != "parenthesized_expression".
optimizer_unparen(e, m) :- node(_, e, "parenthesized_expression", _, _), child(e, i, 0), optimizer_unparen(i, m).
// An assignment target's parentheses: tree-sitter reads `(self.x) = v` as a one-element tuple_pattern; CPython has
// a tuple only with a comma. (Not in python/ast.rr.)
.decl optimizer_paren_pattern(x: node)
optimizer_paren_pattern(x) :- node(_, x, "tuple_pattern", _, _), child(x, _, 0), !child(x, _, 1), node_text(x, s),
    !match("(?s:.*),(?s:\\s*)\\)", s).
.decl optimizer_untarget(t: node, m: node)
optimizer_untarget(t, m) :- optimizer_unparen(t, m), !optimizer_paren_pattern(m).
optimizer_untarget(t, m) :- optimizer_unparen(t, x), optimizer_paren_pattern(x), child(x, i, 0), optimizer_untarget(i, m).

// mirrors python/ast.rr fstring / string_form, over the string_start token's text.
.decl optimizer_form(n: node, f: symbol)
optimizer_form(n, "fstr") :- node(_, n, "string", _, _), child(n, s0, 0), node(_, s0, "string_start", _, _),
    node_text(s0, t), match("[rRbBuU]*[fF][rR]?[\"'].*", t).
optimizer_form(n, "bytes") :- node(_, n, "string", _, _), child(n, s0, 0), node(_, s0, "string_start", _, _),
    node_text(s0, t), match("[rR]?[bB][rR]?[\"'].*", t).
optimizer_form(n, "str") :- node(_, n, "string", _, _), child(n, s0, 0), node(_, s0, "string_start", _, _),
    node_text(s0, t), match("[rRuU]*[\"'].*", t).

// The literals that are one `ast` value: a string not inside an implicit concatenation, or the concatenation.
.decl optimizer_part_of(s: node, c: node)
optimizer_part_of(s, c) :- node(_, c, "concatenated_string", _, _), child(c, s, _), node(_, s, "string", _, _).
.decl optimizer_fstr(n: node)          // mirrors python/ast.rr fstring: an ast.JoinedStr
optimizer_fstr(n) :- optimizer_form(n, "fstr"), !optimizer_part_of(n, _).
optimizer_fstr(c) :- optimizer_part_of(s, c), optimizer_form(s, "fstr").
.decl optimizer_has_nonstr(c: node)
optimizer_has_nonstr(c) :- optimizer_part_of(s, c), !optimizer_form(s, "str").

// mirrors python/ast.rr str_const: n is a str Constant with value v, W's decoded value: a str-form string not in a
// concatenation, or a concatenation of str-form strings (its parts' values joined).
.decl optimizer_str_const(n: node, v: symbol)
optimizer_str_const(n, v) :- optimizer_form(n, "str"), !optimizer_part_of(n, _), value(n, v).
optimizer_str_const(c, v) :- node(_, c, "concatenated_string", _, _), !optimizer_has_nonstr(c), value(c, v).
.decl optimizer_str_any(n: node)
optimizer_str_any(n) :- optimizer_str_const(n, _).

// optimizer_fhost(h): an ast.JoinedStr: an f-string not in a concatenation or a concatenation with one
// (optimizer_fstr), or a format spec (`:>{w}` of `{x:>{w}}`, CPython's format_spec JoinedStr, which starts at the
// `:`). W's fstring_piece at h is CPython's `values`: adjacent literal runs merged, a debug field's `x=` in the
// literal before it, escapes and `{{`/`}}` decoded, a spec's literal text the spec host's own pieces.
.decl optimizer_fhost(h: node)
optimizer_fhost(h) :- optimizer_fstr(h).
optimizer_fhost(h) :- node(_, h, "format_specifier", _, _).
// optimizer_fslot(h, k, s): h's replacement field number k (from 0, in source order): a string's interpolations
// (its parts' in a concatenation), a format spec's format_expressions, as W's parse numbers them.
.decl optimizer_fslot_at(h: node, s: node, st: number)
optimizer_fslot_at(h, s, st) :- optimizer_fstr(h), node(_, h, "string", _, _), child(h, s, _),
    node(_, s, "interpolation", st, _).
optimizer_fslot_at(h, s, st) :- optimizer_fstr(h), optimizer_part_of(p, h), child(p, s, _),
    node(_, s, "interpolation", st, _).
optimizer_fslot_at(h, s, st) :- node(_, h, "format_specifier", _, _), child(h, s, _),
    node(_, s, "format_expression", st, _).
.decl optimizer_fslot(h: node, k: number, s: node)
optimizer_fslot(h, k, s) :- optimizer_fslot_at(h, s, st), k = count : { optimizer_fslot_at(h, _, t), t < st }.
// optimizer_flit(h, i, v, k): h's literal piece i, value v, after k replacement fields.
.decl optimizer_flit(h: node, i: number, v: symbol, k: number)
optimizer_flit(h, i, v, k) :- optimizer_fhost(h), fstring_piece(h, i, "literal", v),
    k = count : { fstring_piece(h, j, "interpolation", _), j < i }.
// The piece's line, CPython 3.13's Constant lineno: where its first character is written. In a string host, the
// first string_content (of any part) after field k-1 and before field k, or, for a literal that is only the debug
// text of field k (`{x=}`), field k's `{` (the text starts right after it). In a spec, the text right after the `:`
// or after field k-1's `}`.
.decl optimizer_fcontent(h: node, c: node, st: number)
optimizer_fcontent(h, c, st) :- optimizer_fstr(h), node(_, h, "string", _, _), child(h, c, _),
    node(_, c, "string_content", st, _).
optimizer_fcontent(h, c, st) :- optimizer_fstr(h), optimizer_part_of(p, h), child(p, c, _),
    node(_, c, "string_content", st, _).
.decl optimizer_flit_lo(h: node, i: number, lo: number)
optimizer_flit_lo(h, i, 0) :- optimizer_flit(h, i, _, 0).
optimizer_flit_lo(h, i, e) :- optimizer_flit(h, i, _, k), k > 0, j = k - 1, optimizer_fslot(h, j, s),
    node(_, s, _, _, e).
.decl optimizer_flit_hi(h: node, i: number, hi: number)
optimizer_flit_hi(h, i, st) :- optimizer_flit(h, i, _, k), optimizer_fslot(h, k, s), node(_, s, _, st, _).
optimizer_flit_hi(h, i, e) :- optimizer_flit(h, i, _, k), !optimizer_fslot(h, k, _), node(_, h, _, _, e).
.decl optimizer_fcand(h: node, i: number, st: number, l: number)
optimizer_fcand(h, i, st, l) :- optimizer_flit_lo(h, i, lo), optimizer_flit_hi(h, i, hi), optimizer_fcontent(h, c, st),
    st >= lo, st < hi, line(c, l).
optimizer_fcand(h, i, st, l) :- optimizer_flit(h, i, _, k), j = i + 1, fstring_piece(h, j, "debug", _),
    optimizer_fslot(h, k, s), node(_, s, _, st, _), line(s, l).
.decl optimizer_fline(h: node, i: number, l: number)
optimizer_fline(h, i, l) :- optimizer_flit(h, i, _, _), optimizer_fstr(h), m = min st : { optimizer_fcand(h, i, st, _) },
    optimizer_fcand(h, i, m, l).
optimizer_fline(h, i, l) :- optimizer_flit(h, i, _, 0), node(_, h, "format_specifier", _, _), line(h, l).
optimizer_fline(h, i, l) :- optimizer_flit(h, i, _, k), k > 0, node(_, h, "format_specifier", _, _), j = k - 1,
    optimizer_fslot(h, j, s), end_line(s, l).
// optimizer_fpiece(h, i, v, l): JoinedStr h's Constant piece i, value v, at line l. A literal has text in a
// string_content or a debug field, so every piece has a candidate; the last rule only keeps a piece if not.
.decl optimizer_fpiece(h: node, i: number, v: symbol, l: number)
optimizer_fpiece(h, i, v, l) :- optimizer_flit(h, i, v, _), optimizer_fline(h, i, l).
optimizer_fpiece(h, i, v, l) :- optimizer_flit(h, i, v, _), !optimizer_fline(h, i, _), line(h, l).

// mirrors python/ast.rr ast_name (nameref less not_name): identifier n is an ast.Name. Unlike ast.rr, a walrus
// target (`(x := …)`, field "name" of named_expression) is a Name, as in CPython.
.decl optimizer_import_kinds(kind: symbol)
optimizer_import_kinds("import_statement"). optimizer_import_kinds("import_from_statement").
optimizer_import_kinds("future_import_statement").
.decl optimizer_param_lists(kind: symbol)
optimizer_param_lists("parameters"). optimizer_param_lists("lambda_parameters").
.decl optimizer_not_name(n: node)
optimizer_not_name(n) :- field(p, "attribute", n), node(_, p, "attribute", _, _).
optimizer_not_name(n) :- field(p, "name", n), !node(_, p, "named_expression", _, _).
optimizer_not_name(n) :- node(_, n, "identifier", _, _), inside(n, _, optimizer_import_kinds).
optimizer_not_name(n) :- child(p, n, _), optimizer_param_lists(k), node(_, p, k, _, _).
optimizer_not_name(n) :- child(p, n, 0), node(_, p, "typed_parameter", _, _).
optimizer_not_name(n) :- child(s, n, 0), (node(_, s, "list_splat_pattern", _, _) ; node(_, s, "dictionary_splat_pattern", _, _)),
    child(p, s, _), (optimizer_param_lists(k), node(_, p, k, _, _) ; node(_, p, "typed_parameter", _, _)).
optimizer_not_name(n) :- child(g, n, _), (node(_, g, "global_statement", _, _) ; node(_, g, "nonlocal_statement", _, _)).
optimizer_not_name(n) :- node(_, x, "except_clause", _, _), child(x, ap, _), node(_, ap, "as_pattern", _, _),
    field(ap, "alias", t), child(t, n, _).
.decl optimizer_name(n: node, x: symbol)
optimizer_name(n, x) :- node(_, n, "identifier", _, _), text(n, x), !optimizer_not_name(n).

// A call's callee, as `calls` gives it: callee_kind Name (an identifier) or Attribute (by its attr).
.decl optimizer_callee_name(c: node, x: symbol)
optimizer_callee_name(c, x) :- node(_, c, "call", _, _), field(c, "function", f), optimizer_unparen(f, i),
    node(_, i, "identifier", _, _), text(i, x).
.decl optimizer_callee_attr(c: node, x: symbol)
optimizer_callee_attr(c, x) :- node(_, c, "call", _, _), field(c, "function", f), optimizer_unparen(f, a),
    node(_, a, "attribute", _, _), field(a, "attribute", i), text(i, x).
.decl optimizer_attr(a: node, x: symbol)          // an ast.Attribute's ast_name
optimizer_attr(a, x) :- node(_, a, "attribute", _, _), field(a, "attribute", i), text(i, x).
// optimizer_arg0(c, a): a is call c's args[0], parentheses off (keywords and `**` are not args).
.decl optimizer_posarg(c: node, a: node, j: number)
optimizer_posarg(c, a, j) :- node(_, c, "call", _, _), field(c, "arguments", al), node(_, al, "argument_list", _, _),
    child(al, a, j), !node(_, a, "keyword_argument", _, _), !node(_, a, "dictionary_splat", _, _).
.decl optimizer_arg0(c: node, a: node)
optimizer_arg0(c, m) :- optimizer_posarg(c, a, j), j = min k : { optimizer_posarg(c, _, k) }, optimizer_unparen(a, m).

// mirrors python/ast.rr assign_chain / assign_target / assign_value: statement-level assignment a as one
// Assign/AnnAssign; t0 its first target (the outer left).
.decl optimizer_stmt(a: node, st: node)           // mirrors names.rr asgstmt
optimizer_stmt(a, st) :- node(_, st, "expression_statement", _, _), child(st, a, 0), node(_, a, "assignment", _, _).
.decl optimizer_chain(a: node, x: node)
optimizer_chain(a, a) :- optimizer_stmt(a, _).
optimizer_chain(a, b) :- optimizer_chain(a, x), field(x, "right", b), node(_, b, "assignment", _, _).
.decl optimizer_target(a: node, t: node)
optimizer_target(a, t) :- optimizer_chain(a, x), field(x, "left", t).
.decl optimizer_value(a: node, v: node)
optimizer_value(a, v) :- optimizer_chain(a, x), field(x, "right", v), !node(_, v, "assignment", _, _).
.decl optimizer_ann(a: node)
optimizer_ann(a) :- optimizer_stmt(a, _), field(a, "type", _).

// ofc_in_def(n, f): n is in def f as `ast` nests it (its decorators too).
.decl ofc_in_def(n: node, f: node)
ofc_in_def(n, f) :- inside(n, f, "function_definition").
ofc_in_def(n, f) :- inside(n, dd, "decorated_definition"), field(dd, "definition", f), node(_, f, "function_definition", _, _).

// ---- optimizer-file-checks ---------------------------------------------------------------------------------------
// optimizer_files: every parsed module of the scope (A2); basename and core from its path.
.decl ofc_file(d: number, p: symbol)
ofc_file(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), !cpython_syntax_error(d, _, _).
.decl ofc_base(d: number, b: symbol)
ofc_base(d, "scope.py") :- ofc_file(d, p), (p = "scope.py" ; suffix("/scope.py", p)).
ofc_base(d, "adapter.py") :- ofc_file(d, p), (p = "adapter.py" ; suffix("/adapter.py", p)).
ofc_base(d, "effects.py") :- ofc_file(d, p), (p = "effects.py" ; suffix("/effects.py", p)).
ofc_base(d, "passes.py") :- ofc_file(d, p), (p = "passes.py" ; suffix("/passes.py", p)).
.decl ofc_core(d: number)
ofc_core(d) :- ofc_file(d, p), match("(?:.*/)?l2065_plan_core/.*", p).
.decl ofc_at(n: node, d: number, p: symbol, l: number)
ofc_at(n, d, p, l) :- node(d, n, _, _, _), ofc_file(d, p), line(n, l).

// optimizer_imports: an Import's aliases, or a level-0 ImportFrom's module, each CPython's alias name: the
// dotted_name's identifiers joined by "." (`import os . path` is "os.path").
.decl ofc_dotted(dn: node, m: symbol)
ofc_dotted(dn, m) :- node(_, dn, "dotted_name", _, _), m = join x by i sep "." : { child(dn, c, i), text(c, x) }.
.decl ofc_import(n: node, m: symbol)
ofc_import(n, m) :- node(_, n, "import_statement", _, _), field(n, "name", c), ofc_dotted(c, m).
ofc_import(n, m) :- node(_, n, "import_statement", _, _), field(n, "name", c), node(_, c, "aliased_import", _, _),
    field(c, "name", dn), ofc_dotted(dn, m).
ofc_import(n, m) :- node(_, n, "import_from_statement", _, _), field(n, "module_name", dn), ofc_dotted(dn, m).

// PV2-001: an I/O module. PV2-002 (core) and PV2-003 (not core, not adapter.py): legacy layers. Their `NOT (io)`
// is implied: the module sets are disjoint.
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-001", p, l) :- ofc_import(n, m),
    match("(?:os|io|socket|subprocess|sqlite3|asyncio|threading|multiprocessing|urllib|http)(?:\\..*)?", m),
    ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-002", p, l) :- ofc_import(n, m),
    match("(?:l2070_batching|impl\\.common\\.l2070_server_plan|impl\\.common\\.l2100_sql_grammar|impl\\.common\\.l2066_plan_optimizer)(?:\\..*)?", m),
    ofc_at(n, d, p, l), ofc_core(d).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-003", p, l) :- ofc_import(n, m),
    match("(?:l2070_batching|impl\\.common\\.l2070_server_plan|impl\\.common\\.l2100_sql_grammar)(?:\\..*)?", m),
    ofc_at(n, d, p, l), !ofc_core(d), !ofc_base(d, "adapter.py").

// PV2-010: PlanScope internals outside scope.py.
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-010", p, l) :- optimizer_attr(n, x),
    (x = "_bindings" ; x = "_exports"), ofc_at(n, d, p, l), !ofc_base(d, "scope.py").

// PV2-011: `.partition/.rpartition/.rsplit/.split(".")` outside scope.py (args[0] the Constant ".").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-011", p, l) :- optimizer_callee_attr(n, x),
    (x = "partition" ; x = "rpartition" ; x = "rsplit" ; x = "split"), optimizer_arg0(n, a), optimizer_str_const(a, "."),
    ofc_at(n, d, p, l), !ofc_base(d, "scope.py").

// PV2-012: an Assign/AnnAssign target Name `*_by_table`; and a def's (async too, not a lambda's) positional-only,
// positional or keyword-only parameter `*_by_table` (not `*args`/`**kwargs`: CPython's vararg/kwarg fields), at
// the arg's line (its name's).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-012", p, l) :- optimizer_target(_, t),
    optimizer_untarget(t, n), node(_, n, "identifier", _, _), text(n, x), suffix("_by_table", x), ofc_at(n, _, p, l).
// mirrors python/ast.rr param_parts (the "plain" forms).
.decl ofc_plain_param(f: node, nm: node)
ofc_plain_param(f, p) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "identifier", _, _).
ofc_plain_param(f, nm) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, p, _),
    node(_, p, "typed_parameter", _, _), child(p, nm, 0), node(_, nm, "identifier", _, _).
ofc_plain_param(f, nm) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, p, _),
    (node(_, p, "default_parameter", _, _) ; node(_, p, "typed_default_parameter", _, _)), field(p, "name", nm).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-012", p, l) :- ofc_plain_param(_, n),
    text(n, x), suffix("_by_table", x), ofc_at(n, _, p, l).

// PV2-020: a Compare operand that is the Constant "count", "count_only" or "exists", outside adapter.py.
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-020", p, l) :-
    node(_, n, "comparison_operator", _, _), child(n, o, _), optimizer_unparen(o, k), optimizer_str_const(k, v),
    (v = "count" ; v = "count_only" ; v = "exists"), ofc_at(n, d, p, l), !ofc_base(d, "adapter.py").

// PV2-021: a str Constant ending `_count` (a JoinedStr's piece too, a spec's included, at the piece's line), and a
// JoinedStr (a spec's too) with such a piece among its values, at the JoinedStr's line. W's `rx_matches(v,
// '_count\z')` is suffix("_count", v), a NUL in v included (`"a\x00_count"`).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-021", p, l) :- optimizer_str_const(n, v),
    suffix("_count", v), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-021", p, l) :- optimizer_fpiece(h, _, v, l),
    suffix("_count", v), node(d, h, _, _, _), ofc_file(d, p).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-021", p, l) :- optimizer_fpiece(h, _, v, _),
    suffix("_count", v), ofc_at(h, _, p, l).

// PV2-022: `set(…) & x` / `x & frozenset(…)`, and any `.intersection(…)` call.
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-022", p, l) :-
    node(_, n, "binary_operator", _, _), op(n, "&"), (field(n, "left", o) ; field(n, "right", o)),
    optimizer_unparen(o, c), optimizer_callee_name(c, x), (x = "set" ; x = "frozenset"), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-022", p, l) :-
    optimizer_callee_attr(n, "intersection"), ofc_at(n, _, p, l).

// PV2-023: `ColumnSchema(<str Constant>, …)`.
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-023", p, l) :-
    optimizer_callee_name(n, "ColumnSchema"), optimizer_arg0(n, a), optimizer_str_any(a), ofc_at(n, _, p, l).

// PV2-030: a Name or Attribute spelled as model introspection (A1).
.decl ofc_introspection(x: symbol)
ofc_introspection("get_type_hints"). ofc_introspection("model_fields"). ofc_introspection("model_json_schema").
ofc_introspection("model_sql_column_type_hints").
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-030", p, l) :- optimizer_name(n, x),
    ofc_introspection(x), ofc_at(n, _, p, l).
violation("data-layer-plan-optimizer-v2", "optimizer-file-checks", "PV2-030", p, l) :- optimizer_attr(n, x),
    ofc_introspection(x), ofc_at(n, _, p, l).

// PV2-031: a `raise <not a Name>` in a def none of whose str Constants (JoinedStr pieces too, a spec's included)
// has a repair word. SQL takes every def around the raise; the innermost has the fewest strings, so it decides.
// The word is searched with Python's `\b`, as the policy spells it: `(?:\A|[^W])(?:Fix|…|Keep)(?:\z|[^W])`, W the
// characters Python 3.13's `re` counts as `\w` (str.isalnum() or `_`), not Rust's Unicode `\w`. The pattern is the
// policy's text verbatim: an .rr literal reads its `\uXXXX` escapes (and the astral ranges' surrogate pairs) as
// JSON does, so the regex is W's, character for character.
.decl ofc_hint_value(s: node, v: symbol)
ofc_hint_value(s, v) :- optimizer_str_const(s, v).
ofc_hint_value(h, v) :- optimizer_fpiece(h, _, v, _).
.decl ofc_hint_piece(s: node)
ofc_hint_piece(s) :- ofc_hint_value(s, v),
    match("(?s:.*)(?:(?:\\A|[^0-9A-Z_a-z\u00aa\u00b2-\u00b3\u00b5\u00b9-\u00ba\u00bc-\u00be\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u02c1\u02c6-\u02d1\u02e0-\u02e4\u02ec\u02ee\u0370-\u0374\u0376-\u0377\u037a-\u037d\u037f\u0386\u0388-\u038a\u038c\u038e-\u03a1\u03a3-\u03f5\u03f7-\u0481\u048a-\u052f\u0531-\u0556\u0559\u0560-\u0588\u05d0-\u05ea\u05ef-\u05f2\u0620-\u064a\u0660-\u0669\u066e-\u066f\u0671-\u06d3\u06d5\u06e5-\u06e6\u06ee-\u06fc\u06ff\u0710\u0712-\u072f\u074d-\u07a5\u07b1\u07c0-\u07ea\u07f4-\u07f5\u07fa\u0800-\u0815\u081a\u0824\u0828\u0840-\u0858\u0860-\u086a\u0870-\u0887\u0889-\u088e\u08a0-\u08c9\u0904-\u0939\u093d\u0950\u0958-\u0961\u0966-\u096f\u0971-\u0980\u0985-\u098c\u098f-\u0990\u0993-\u09a8\u09aa-\u09b0\u09b2\u09b6-\u09b9\u09bd\u09ce\u09dc-\u09dd\u09df-\u09e1\u09e6-\u09f1\u09f4-\u09f9\u09fc\u0a05-\u0a0a\u0a0f-\u0a10\u0a13-\u0a28\u0a2a-\u0a30\u0a32-\u0a33\u0a35-\u0a36\u0a38-\u0a39\u0a59-\u0a5c\u0a5e\u0a66-\u0a6f\u0a72-\u0a74\u0a85-\u0a8d\u0a8f-\u0a91\u0a93-\u0aa8\u0aaa-\u0ab0\u0ab2-\u0ab3\u0ab5-\u0ab9\u0abd\u0ad0\u0ae0-\u0ae1\u0ae6-\u0aef\u0af9\u0b05-\u0b0c\u0b0f-\u0b10\u0b13-\u0b28\u0b2a-\u0b30\u0b32-\u0b33\u0b35-\u0b39\u0b3d\u0b5c-\u0b5d\u0b5f-\u0b61\u0b66-\u0b6f\u0b71-\u0b77\u0b83\u0b85-\u0b8a\u0b8e-\u0b90\u0b92-\u0b95\u0b99-\u0b9a\u0b9c\u0b9e-\u0b9f\u0ba3-\u0ba4\u0ba8-\u0baa\u0bae-\u0bb9\u0bd0\u0be6-\u0bf2\u0c05-\u0c0c\u0c0e-\u0c10\u0c12-\u0c28\u0c2a-\u0c39\u0c3d\u0c58-\u0c5a\u0c5d\u0c60-\u0c61\u0c66-\u0c6f\u0c78-\u0c7e\u0c80\u0c85-\u0c8c\u0c8e-\u0c90\u0c92-\u0ca8\u0caa-\u0cb3\u0cb5-\u0cb9\u0cbd\u0cdd-\u0cde\u0ce0-\u0ce1\u0ce6-\u0cef\u0cf1-\u0cf2\u0d04-\u0d0c\u0d0e-\u0d10\u0d12-\u0d3a\u0d3d\u0d4e\u0d54-\u0d56\u0d58-\u0d61\u0d66-\u0d78\u0d7a-\u0d7f\u0d85-\u0d96\u0d9a-\u0db1\u0db3-\u0dbb\u0dbd\u0dc0-\u0dc6\u0de6-\u0def\u0e01-\u0e30\u0e32-\u0e33\u0e40-\u0e46\u0e50-\u0e59\u0e81-\u0e82\u0e84\u0e86-\u0e8a\u0e8c-\u0ea3\u0ea5\u0ea7-\u0eb0\u0eb2-\u0eb3\u0ebd\u0ec0-\u0ec4\u0ec6\u0ed0-\u0ed9\u0edc-\u0edf\u0f00\u0f20-\u0f33\u0f40-\u0f47\u0f49-\u0f6c\u0f88-\u0f8c\u100