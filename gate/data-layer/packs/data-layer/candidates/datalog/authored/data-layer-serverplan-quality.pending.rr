// data-layer-serverplan-quality, PENDING: the quoted_atoms rules of spq-runtime-state-annotations (SPQ-050).
// Everything else of the rule is in data-layer-serverplan-quality.rr. These rules read `parsed` (core.rr: the
// CPython `ast.parse` worker's tree of a string) and `string_annotation` (Ruff's table of the strings its scope
// table classifies as type definitions), which the corpus runner does not bind; the main file names the gap at the
// clause (a string annotation gives no atom there). Once both are bound, add to the main file's clause:
//   - the declarations below;
//   - `!spq_runtime_state_annotations_pnode(n)` back on spq_runtime_state_annotations_in_type (a node of a parsed
//     annotation tree is no annotation node of its own);
//   - the rules below.
// quoted_atoms' ATOM.text: an identifier's text(), an attribute's node_text() in the parsed tree (for a simple
// string, its exact source bytes; for an escaped or concatenated string W reads the decoded value, which the parsed
// tree's text then is too, as `parsed` parses the string's value).

.decl parsed(s: node, grammar: symbol, root: node)
.input parsed
.decl string_annotation(s: node)
.input string_annotation
.decl spq_runtime_state_annotations_pnode(n: node)
.decl spq_runtime_state_annotations_qstr(d: number, q: node, a: node)

spq_runtime_state_annotations_pnode(n) :- parsed(_, "annotation", n).
spq_runtime_state_annotations_pnode(n) :- parsed(_, "annotation", r), inside(n, r, "expression_statement").
spq_runtime_state_annotations_qstr(d, s, a) :- node(d, s, "string", _, _), spq_runtime_state_annotations_in_type(d, s, a), spq_runtime_state_annotations_ann0(d, a).
spq_runtime_state_annotations_qstr(d, s, a) :- node(d, s, "concatenated_string", _, _), spq_runtime_state_annotations_in_type(d, s, a), spq_runtime_state_annotations_ann0(d, a).
spq_runtime_state_annotations_atom(d, a, cat(cat(cat("quoted:", to_string(ss)), ":"), x), ss, se, x) :- spq_runtime_state_annotations_qstr(d, s, a), node(d, s, _, ss, se), string_annotation(s), parsed(s, "annotation", r), inside(n, r, "expression_statement"), node(_, n, "identifier", _, _), !spq_runtime_state_annotations_in_attr(n), text(n, x).
spq_runtime_state_annotations_atom(d, a, cat(cat(cat("quoted:", to_string(ss)), ":"), x), ss, se, x) :- spq_runtime_state_annotations_qstr(d, s, a), node(d, s, _, ss, se), string_annotation(s), parsed(s, "annotation", r), inside(n, r, "expression_statement"), node(_, n, "attribute", _, _), !spq_runtime_state_annotations_in_attr(n), node_text(n, x).
