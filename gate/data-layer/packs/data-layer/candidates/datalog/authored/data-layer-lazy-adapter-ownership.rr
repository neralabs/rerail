// data-layer-lazy-adapter-ownership, clause adapter-ownership: the relational (SQL) stages as Datalog (port-23).
// No existing program in native/src/code_rule_dsl/logic/programs/data_layer/ covers this rule. One finding per
// (issue, function), code the issue (LAO001-LAO006), at the function_definition (its line, decorators excluded).
//
// The stages' `nodes` table is the named nodes less comment, string_start, string_content, string_end,
// escape_sequence and line_continuation (`excludeKinds`), its `parent`/`ordinal` over those. The joins below read
// `child`; where a stage reads `ordinal = 0` it is the first child of a statement or parameter, which no excluded
// kind can precede (a node starts at its first token), so `child(_, _, 0)` is exact.
// A NULL class_name (a module-level function) is "" here: a class's name is never empty.
// The `entryPoint` option (default scan_source) is read by no stage.

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl node_text(n: node, s: symbol)          // a node's exact source text
.decl value(n: node, v: symbol)              // a literal's static value, escapes decoded (W's `value: true`)
.decl op(n: node, s: symbol)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input node_text, value
.output violation

// The syntax gate (`requireNonemptyInput: syntax_gate`): a valid module in scope.
.decl lao_doc(d: number)
lao_doc(d) :- doc(d, _, _), in_scope(d), !out_scope(d), !syntax_error(d).

// ---- declaration_parents, functions, classes, owned_functions -------------------------------------------------
// The declaration's parent: the decorated_definition's parent where it is decorated, and its region's start.
.decl lao_fn(d: number, f: node, name: symbol, parent: node, region: number)
lao_fn(d, f, nm, gp, rs) :- lao_doc(d), node(d, f, "function_definition", _, _), field(f, "name", ni), text(ni, nm),
  child(w, f, _), node(d, w, "decorated_definition", rs, _), child(gp, w, _).
lao_fn(d, f, nm, p, rs) :- lao_doc(d), node(d, f, "function_definition", rs, _), field(f, "name", ni), text(ni, nm),
  child(p, f, _), !node(d, p, "decorated_definition", _, _).
.decl lao_cls(d: number, name: symbol, body: node, parent: node)
lao_cls(d, nm, b, gp) :- lao_doc(d), node(d, c, "class_definition", _, _), field(c, "name", ni), text(ni, nm), field(c, "body", b),
  child(w, c, _), node(d, w, "decorated_definition", _, _), child(gp, w, _).
lao_cls(d, nm, b, p) :- lao_doc(d), node(d, c, "class_definition", _, _), field(c, "name", ni), text(ni, nm), field(c, "body", b),
  child(p, c, _), !node(d, p, "decorated_definition", _, _).
// A module-level function, or a method of a module-level class.
.decl lao_owned(d: number, f: node, name: symbol, cls: symbol, region: number, end: number)
lao_owned(d, f, nm, "", rs, fe) :- lao_fn(d, f, nm, p, rs), node(d, p, "module", _, _), node(d, f, _, _, fe).
lao_owned(d, f, nm, cn, rs, fe) :- lao_fn(d, f, nm, p, rs), lao_cls(d, cn, p, cp), node(d, cp, "module", _, _), node(d, f, _, _, fe).

// ---- decorators, legacy_decorators ----------------------------------------------------------------------------
// A decorator's name: coalesce(the call's callee, the attribute's attr, the expression's text). Every name a
// stage compares with is an identifier's, so only identifier texts are kept.
.decl lao_dec_expr(d: number, f: node, dec: node, start: number, x: node)
lao_dec_expr(d, f, dec, s, x) :- lao_owned(d, f, _, _, _, _), child(w, f, _), node(d, w, "decorated_definition", _, _),
  child(w, dec, _), node(d, dec, "decorator", s, _), child(dec, x, _).
.decl lao_dec(d: number, f: node, dec: node, start: number, name: symbol)
lao_dec(d, f, dec, s, nm) :- lao_dec_expr(d, f, dec, s, x), node(d, x, "identifier", _, _), text(x, nm).
lao_dec(d, f, dec, s, nm) :- lao_dec_expr(d, f, dec, s, x), node(d, x, "call", _, _), field(x, "function", g), node(d, g, "identifier", _, _), text(g, nm).
lao_dec(d, f, dec, s, nm) :- lao_dec_expr(d, f, dec, s, x), node(d, x, "call", _, _), field(x, "function", g), node(d, g, "attribute", _, _), field(g, "attribute", a), text(a, nm).
lao_dec(d, f, dec, s, nm) :- lao_dec_expr(d, f, dec, s, x), node(d, x, "attribute", _, _), field(x, "attribute", a), text(a, nm).

.decl lao_legacy_name(s: symbol)
lao_legacy_name("legacy_async"). lao_legacy_name("legacy_module_async"). lao_legacy_name("legacy_module_sync"). lao_legacy_name("legacy_sync").
.decl lao_external_name(s: symbol)
lao_external_name("direct_legacy_module_async"). lao_external_name("direct_legacy_module_sync"). lao_external_name("external_io_boundary").
lao_external_name("external_io_boundary_async"). lao_external_name("external_io_boundary_sync").
.decl lao_pure_name(s: symbol)
lao_pure_name("pure_lazy"). lao_pure_name("lazy").

.decl lao_legacy_at(d: number, f: node, dec: node, start: number, name: symbol)
lao_legacy_at(d, f, dec, s, nm) :- lao_dec(d, f, dec, s, nm), lao_legacy_name(nm).
// The first legacy decorator in source order.
.decl lao_legacy(d: number, f: node, dec: node, name: symbol)
lao_legacy(d, f, dec, nm) :- lao_legacy_at(d, f, dec, s, nm), s = min k : { lao_legacy_at(d, f, _, k, _) }.
.decl lao_is_legacy(f: node)
lao_is_legacy(f) :- lao_legacy(_, f, _, _).
.decl lao_external(f: node)
lao_external(f) :- lao_dec(_, f, _, _, nm), lao_external_name(nm).
.decl lao_pure(f: node)
lao_pure(f) :- lao_dec(_, f, _, _, nm), lao_pure_name(nm).

// ---- function_contracts.default_target, target_values, function_targets.target ----------------------------------
.decl lao_strip_both(s: symbol)
lao_strip_both("legacy_async"). lao_strip_both("legacy_sync").
.decl lao_base(f: node, b: symbol)
lao_base(f, b) :- lao_legacy(d, f, _, l), lao_strip_both(l), lao_owned(d, f, n, _, _, _), suffix("_async", n), b = substr(n, 0, strlen(n) - 6).
lao_base(f, b) :- lao_legacy(d, f, _, l), lao_strip_both(l), lao_owned(d, f, n, _, _, _), !suffix("_async", n), suffix("_sync", n), b = substr(n, 0, strlen(n) - 5).
lao_base(f, n) :- lao_legacy(d, f, _, l), lao_strip_both(l), lao_owned(d, f, n, _, _, _), !suffix("_async", n), !suffix("_sync", n).
lao_base(f, b) :- lao_legacy(d, f, _, "legacy_module_async"), lao_owned(d, f, n, _, _, _), suffix("_async", n), b = substr(n, 0, strlen(n) - 6).
lao_base(f, n) :- lao_legacy(d, f, _, "legacy_module_async"), lao_owned(d, f, n, _, _, _), !suffix("_async", n).
lao_base(f, n) :- lao_legacy(d, f, _, "legacy_module_sync"), lao_owned(d, f, n, _, _, _).

// target_values: a keyword_argument named lazy_name whose value is a string or concatenated_string with no prefix
// other than r/u (`(?i)^[ru]*["']` on its text), inside a decorator; the row's start is the keyword argument's.
.decl lao_decorator(kind: symbol)
lao_decorator("decorator").
.decl lao_kw(dec: node, start: number, v: symbol)
lao_kw(dec, k, v) :- lao_legacy(d, _, dec, _), inside(kw, dec, lao_decorator), node(d, kw, "keyword_argument", k, _),
  field(kw, "name", ni), node(d, ni, "identifier", _, _), text(ni, "lazy_name"), field(kw, "value", s), lao_kw_string(s), value(s, v).
.decl lao_kw_string(s: node)
lao_kw_string(s) :- node(_, s, "string", _, _), node_text(s, t), match("(?is)[ru]*[\"'].*", t).
lao_kw_string(s) :- node(_, s, "concatenated_string", _, _), node_text(s, t), match("(?is)[ru]*[\"'].*", t).
.decl lao_has_kw(dec: node)
lao_has_kw(dec) :- lao_kw(dec, _, _).
.decl lao_target(f: node, t: symbol)
lao_target(f, v) :- lao_legacy(_, f, dec, _), lao_kw(dec, k, v), k = min j : { lao_kw(dec, j, _) }.
lao_target(f, t) :- lao_legacy(_, f, dec, _), !lao_has_kw(dec), lao_base(f, b), t = cat(b, "_lazy").

// last_functions: per file, class name and name, the owned function ending last.
.decl lao_last(d: number, cls: symbol, name: symbol, f: node)
lao_last(d, c, nm, f) :- lao_owned(d, f, nm, c, _, e), e = max x : { lao_owned(d, _, nm, c, _, x) }.

// ---- body_statements, stubs ------------------------------------------------------------------------------------
.decl lao_stmt(f: node, n: node, kind: symbol)
lao_stmt(f, n, k) :- lao_owned(d, f, _, _, _, _), field(f, "body", b), child(b, n, _), node(d, n, k, _, _), k != "comment", k != "line_continuation".
// An expression statement that is a docstring (a string or concatenated_string with prefix letters r/u only) or `...`.
.decl lao_quiet(n: node)
lao_quiet(n) :- lao_stmt(_, n, "expression_statement"), child(n, v, 0), lao_kw_string(v).
lao_quiet(n) :- lao_stmt(_, n, "expression_statement"), child(n, v, 0), node(_, v, "ellipsis", _, _).
.decl lao_delegate(s: symbol)
lao_delegate("_legacy_delegate_stub"). lao_delegate("_legacy_delegate_stub_async").
.decl lao_adapter_ok(n: node)
lao_adapter_ok(n) :- lao_stmt(_, n, "pass_statement").
lao_adapter_ok(n) :- lao_stmt(_, n, "raise_statement").
lao_adapter_ok(n) :- lao_stmt(_, n, "delete_statement").
lao_adapter_ok(n) :- lao_quiet(n).
lao_adapter_ok(n) :- lao_stmt(_, n, "expression_statement"), child(n, v, 0), node(_, v, "call", _, _), field(v, "function", g),
  node(_, g, "identifier", _, _), text(g, s), lao_delegate(s).
.decl lao_adapter_bad(f: node)
lao_adapter_bad(f) :- lao_stmt(f, n, _), !lao_adapter_ok(n).
.decl lao_adapter(f: node)
lao_adapter(f) :- lao_stmt(f, _, _), !lao_adapter_bad(f).
.decl lao_abstract_ok(n: node)
lao_abstract_ok(n) :- lao_stmt(_, n, "pass_statement").
lao_abstract_ok(n) :- lao_stmt(_, n, "raise_statement").
lao_abstract_ok(n) :- lao_quiet(n).
.decl lao_abstract_bad(f: node)
lao_abstract_bad(f) :- lao_stmt(f, n, _), !lao_abstract_ok(n).

// ---- parameters, parameter_pieces, transaction_parameters -------------------------------------------------------
// A typed parameter's name (its first child, an identifier) and its annotation's text. parameter_pieces splits the
// text at `[` and `]`, trims spaces, and keeps what follows the last `.`; transaction_parameters keeps a piece that
// GLOBs `*PlanScope`, or `*Transaction` and contains Read, Write or Schema. As one regex over the whole text: a
// run free of `[`, `]` and `.`, after one of them (or the start), ending in PlanScope (or Read/Write/Schema …
// Transaction) and spaces, before a `[`, a `]` or the end.
.decl lao_typed(kind: symbol)
lao_typed("typed_parameter"). lao_typed("typed_default_parameter").
.decl lao_tx(f: node, name: symbol)
lao_tx(f, nm) :- lao_owned(d, f, _, _, _, _), field(f, "parameters", ps), child(ps, p, _), node(d, p, k, _, _), lao_typed(k),
  child(p, n, 0), node(d, n, "identifier", _, _), text(n, nm), field(p, "type", t), node_text(t, s),
  match("(?s)(?:.*[\[\].])?[^\[\].]*(?:PlanScope|(?:Read|Write|Schema)[^\[\].]*Transaction) *(?:[\[\]].*)?", s).
.decl lao_has_tx(f: node)
lao_has_tx(f) :- lao_tx(f, _).

// ---- calls, owned_calls ---------------------------------------------------------------------------------------
// Calls whose callee is an attribute, from the function's region (its decorators included) to its end.
.decl lao_call(f: node, callee: symbol, receiver: node)
lao_call(f, callee, r) :- lao_owned(d, f, _, _, rs, fe), node(d, c, "call", cs, ce), cs >= rs, ce <= fe, field(c, "function", g),
  node(d, g, "attribute", _, _), field(g, "attribute", a), text(a, callee), field(g, "object", r).
.decl lao_terminal(s: symbol)
lao_terminal("execute"). lao_terminal("execute_async"). lao_terminal("fetch"). lao_terminal("fetch_async"). lao_terminal("resolve"). lao_terminal("resolve_async").
.decl lao_eager(f: node)
lao_eager(f) :- lao_call(f, callee, r), !suffix("_lazy", callee), node(_, r, "identifier", _, _), text(r, nm), lao_tx(f, nm).
.decl lao_awaits(f: node)
lao_awaits(f) :- lao_owned(d, f, _, _, rs, fe), node(d, _, "await", s, e), s >= rs, e <= fe.

// ---- the findings ---------------------------------------------------------------------------------------------
.decl lao_issue(d: number, f: node, code: symbol)
lao_issue(d, f, "LAO001") :- lao_legacy(d, f, _, _), !lao_adapter(f).
lao_issue(d, f, "LAO002") :- lao_legacy(d, f, _, _), lao_owned(d, f, _, "", _, _), lao_target(f, t), !lao_last(d, "", t, _).
lao_issue(d, f, "LAO003") :- lao_legacy(d, f, _, _), lao_owned(d, f, _, c, _, _), lao_target(f, t), lao_last(d, c, t, g), !lao_pure(g).
lao_issue(d, f, "LAO004") :- lao_pure(f), lao_owned(d, f, _, _, _, _), lao_call(f, callee, _), lao_terminal(callee).
lao_issue(d, f, "LAO005") :- lao_owned(d, f, _, _, _, _), !lao_is_legacy(f), !lao_external(f), !lao_pure(f), lao_eager(f).
lao_issue(d, f, "LAO006") :- lao_owned(d, f, _, _, _, _), op(f, "async"), !lao_is_legacy(f), !lao_external(f), lao_abstract_bad(f), lao_has_tx(f), !lao_awaits(f).

violation("data-layer-lazy-adapter-ownership", "adapter-ownership", code, p, l) :- lao_issue(d, f, code), doc(d, p, _), line(f, l).
