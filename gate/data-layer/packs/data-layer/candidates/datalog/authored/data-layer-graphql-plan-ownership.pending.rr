// data-layer-graphql-plan-ownership, option-gated (awaiting option_value, ConvertFoundation A9): reported-parser-error
// for every entryPoint. To replace the main file's reported-parser-error rule when A9 lands.
// entryPoint "scan_source": every file in scope is parsed (no regex filter); otherwise (the policy's `default`) only
// those whose source matches `ServerPlan|PlanScope|Transaction|LazyResult`. The message differs by branch; the
// (path, line, code) key does not. graphql-authority does not depend on entryPoint here (its regex gate is implied;
// see the main file), so it is not repeated.
// APPROXIMATION: the verdict is the corpus's `syntax_error(d)` (tree-sitter) or a block with no statement, not
// CPython's `ast.parse` (as in the main file).

.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl text(n: loc, s: symbol)
.decl syntax_error(d: number)
.decl source(d: number, sp: span)
.input source
.decl option_value(name: symbol, v: symbol)
.input option_value
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

.decl reported_parser_error_scan_source()
reported_parser_error_scan_source() :- option_value("entryPoint", "scan_source").
.decl reported_parser_error_stmt(b: node)
reported_parser_error_stmt(b) :- node(_, b, "block", _, _), child(b, c, _), node(_, c, _, _, _).
.decl reported_parser_error_invalid(d: number)
reported_parser_error_invalid(d) :- syntax_error(d).
reported_parser_error_invalid(d) :- node(d, b, "block", _, _), !reported_parser_error_stmt(b).

violation("data-layer-graphql-plan-ownership", "reported-parser-error", "GPO000", p, 1) :-
    reported_parser_error_scan_source(), reported_parser_error_invalid(d), in_scope(d), !out_scope(d), doc(d, p, _).
violation("data-layer-graphql-plan-ownership", "reported-parser-error", "GPO000", p, 1) :-
    !reported_parser_error_scan_source(), reported_parser_error_invalid(d), in_scope(d), !out_scope(d), source(d, sp),
    text(sp, s), (contains("ServerPlan", s) ; contains("PlanScope", s) ; contains("Transaction", s) ; contains("LazyResult", s)),
    doc(d, p, _).
