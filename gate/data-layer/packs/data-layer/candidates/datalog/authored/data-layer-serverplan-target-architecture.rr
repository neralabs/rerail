.decl spta_rc_req_immutable(p: symbol, cls: symbol)
spta_rc_req_immutable("l2070_batching/execution_receipt.py", "BackendExecutionReceipt").
spta_rc_req_immutable("l2070_batching/execution_receipt.py", "PhysicalResultSet").
spta_rc_req_immutable("l2070_batching/physical_program.py", "ClosedApplicationRegion").
spta_rc_req_immutable("l2070_batching/physical_program.py", "ExternalIoRegion").
spta_rc_req_immutable("l2070_batching/physical_program.py", "PhysicalTransportProgram").
spta_rc_req_immutable("l2070_batching/physical_program.py", "PhysicalTransportRequest").
spta_rc_req_immutable("l2070_batching/physical_program.py", "SqlStatementRegion").
spta_rc_req_immutable("l2070_batching/planning_contract.py", "FailureIsolationRequirement").
spta_rc_req_immutable("l2070_batching/planning_contract.py", "OrderedEffect").
spta_rc_req_immutable("l2070_batching/planning_contract.py", "PythonBoundary").
spta_rc_req_immutable("l2070_batching/planning_contract.py", "RecursiveQueryRequirement").
