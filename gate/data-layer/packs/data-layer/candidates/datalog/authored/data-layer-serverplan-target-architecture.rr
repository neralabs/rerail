spta_rc_req_enum("l2070_batching/planning_contract.py", "SessionContextScope", "STATEMENT").
spta_rc_req_enum("l2070_batching/planning_contract.py", "SessionContextScope", "TRANSACTION").
.decl spta_rc_req_union(p: symbol, alias: symbol, name: symbol)
spta_rc_req_union("l2070_batching/physical_program.py", "PhysicalTransportRegion", "ClosedApplicationRegion").
spta_rc_req_union("l2070_batching/physical_program.py", "PhysicalTransportRegion", "ExternalIoRegion").
spta_rc_req_union("l2070_batching/physical_program.py", "PhysicalTransportRegion", "SqlStatementRegion").
spta_rc_req_union("l2070_batching/runtime_application.py", "RuntimeApplication", "ApplyLifecycleEffectApplication").
spta_rc_req_union("l2070_batching/runtime_application.py", "RuntimeApplication", "BuildTerminalPayloadApplication").
spta_rc_req_union("l2070_batching/runtime_application.py", "RuntimeApplication", "DecodeAffectedCountApplication").
spta_rc_req_union("l2070_batching/runtime_application.py", "RuntimeApplication", "DecodeScalarApplication").
spta_rc_req_union("l2070_batching/runtime_application.py", "RuntimeApplication", "HydrateManyApplication").
spta_rc_req_union("l2070_batching/runtime_application.py", "RuntimeApplication", "HydrateOneApplication").
spta_rc_req_union("l2070_batching/runtime_application.py", "RuntimeApplication", "PopulateCacheApplication").

// The findings: each at its required path's first line (start_byte 0), whether or not the file is there.
.decl spta_rc_finding(p: symbol, code: symbol)
spta_rc_finding(p, "SPTA001") :- spta_rc_req_symbol(p, t), !spta_rc_symbol(p, t).
spta_rc_finding(p, "SPTA013") :- spta_rc_req_field(p, k, t), spta_rc_class(p, k, c), !spta_rc_member(c, t, 1).
spta_rc_finding(p, "SPTA013") :- spta_rc_req_immutable(p, k), spta_rc_class(p, k, c), !spta_rc_frozen(c).
spta_rc_finding(p, "SPTA013") :- spta_rc_req_enum(p, k, _), spta_rc_class(p, k, c), !spta_rc_base(c, "StrEnum").
spta_rc_finding(p, "SPTA013") :- spta_rc_req_enum(p, k, t), spta_rc_class(p, k, c), !spta_rc_member(c, t, 0).
spta_rc_finding(p, "SPTA013") :- spta_rc_req_union(p, a, t), spta_rc_symbol(p, a), !spta_rc_union(p, a, t).
spta_rc_finding("l2070_batching/step.py", "SPTA002") :- spta_required_shape(1), !spta_rc_planning_method(1).
spta_rc_finding("l2070_batching/physical_placement.py", "SPTA003") :- spta_required_shape(1), !spta_rc_application_field(1).
spta_rc_finding("l2070_batching/physical_executor.py", "SPTA011") :- spta_required_shape(1), !spta_rc_executor_method(1).
.decl spta_rc_planning_method(ok: number)
spta_rc_planning_method(1) :- spta_rc_class("l2070_batching/step.py", "ServerPlanStep", c), spta_rc_method(c, "planning_contract", f),
    spta_rc_return(f, "StepPlanningContract").
.decl spta_rc_application_field(ok: number)
spta_rc_application_field(1) :- spta_rc_class("l2070_batching/physical_placement.py", "ApplicationPlacementUnit", c),
    spta_rc_annotation(c, "application", "RuntimeApplication").
.decl spta_rc_executor_method(ok: number)
spta_rc_executor_method(1) :- spta_rc_class("l2070_batching/physical_executor.py", "BackendExecutor", c),
    spta_rc_method(c, "execute_program", f), spta_rc_return(f, "BackendExecutionReceipt"), spta_rc_param(f, "PhysicalTransportProgram").

violation("data-layer-serverplan-target-architecture", "required-contracts", code, p, 1) :- spta_required_shape(1), spta_rc_finding(p, code).
