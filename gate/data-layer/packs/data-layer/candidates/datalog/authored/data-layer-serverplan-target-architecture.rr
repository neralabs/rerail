spta_rc_req_immutable("l2070_batching/runtime_application.py", "HydrateOneApplication").
spta_rc_req_immutable("l2070_batching/runtime_application.py", "PopulateCacheApplication").
.decl spta_rc_req_enum(p: symbol, cls: symbol, name: symbol)
spta_rc_req_enum("l2070_batching/planning_contract.py", "FailureIsolationKind", "SAVEPOINT").
spta_rc_req_enum("l2070_batching/planning_contract.py", "FailureIsolationKind", "STATEMENT").
spta_rc_req_enum("l2070_batching/planning_contract.py", "FailureIsolationKind", "TRANSACTION").
spta_rc_req_enum("l2070_batching/planning_contract.py", "PythonBoundaryKind", "CLOSED_APPLICATION").
spta_rc_req_enum("l2070_batching/planning_contract.py", "PythonBoundaryKind", "EXTERNAL_IO").
spta_rc_req_enum("l2070_batching/planning_contract.py", "PythonBoundaryKind", "NONE").
spta_rc_req_enum("l2070_batching/planning_contract.py", "ResultTransportKind", "AFFECTED_COUNT").
spta_rc_req_enum("l2070_batching/planning_contract.py", "ResultTransportKind", "GENERATED_IDENTIFIER").
spta_rc_req_enum("l2070_batching/planning_contract.py", "ResultTransportKind", "LOGICAL_ROW").
spta_rc_req_enum("l2070_batching/planning_contract.py", "ResultTransportKind", "NONE").
spta_rc_req_enum("l2070_batching/planning_contract.py", "ResultTransportKind", "RAW_RELATION").
spta_rc_req_enum("l2070_batching/planning_contract.py", "ResultTransportKind", "TERMINAL_SCALAR").
