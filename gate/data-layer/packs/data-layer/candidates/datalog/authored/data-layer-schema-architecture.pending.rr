// data-layer-schema-architecture, pending: awaiting the converter's option facts (`option_value`, A9).
// The entryPoint cases:
// - schema-lifecycle's query is its `all`/`scan_source`/`_extract_facts` case (every other value: `WHERE 0`). Its
//   gate's `all` case is the main file's (the three directories, the trigger text); every other value's gate is
//   any valid module of the scope, no path or text test (the replay's `schema_fixture.py` events, entryPoint
//   scan_source, need this).
// - reported-parser-error's gate needs `all`.
// - schema-planning's query is its `lint_file`/`standalone` case (other values `WHERE 0`).
// Once option facts are given, in data-layer-schema-architecture.rr: add `option_value("entryPoint", "all")` to
// each lifecycle_doc and parser_error_doc rule; in the SAP004 rule read `lifecycle_sap004_doc(d)` for
// `lifecycle_text_doc(d)`; replace schema_planning_off and its violation rule with the schema_planning rules
// below; append the rest; delete this file.
.decl option_value(name: symbol, v: symbol)
.decl lifecycle_any_path_entry(v: symbol)
lifecycle_any_path_entry("scan_source"). lifecycle_any_path_entry("_extract_facts").
lifecycle_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d), option_value("entryPoint", v),
    lifecycle_any_path_entry(v).
.decl lifecycle_sap004_doc(d: number)
lifecycle_sap004_doc(d) :- lifecycle_text_doc(d), option_value("entryPoint", "all").
lifecycle_sap004_doc(d) :- lifecycle_doc(d, _), option_value("entryPoint", v), lifecycle_any_path_entry(v).

// schema-planning (lint_schema_architecture.py): every valid module of the scope; the gate's text test
// (enqueue_post_|materialize_schema_operation_records|planning_callback) is implied by each finding's names.
.decl schema_planning_doc(d: number, p: symbol)
schema_planning_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d),
    option_value("entryPoint", v), (v = "lint_file" ; v = "standalone").
// An AnnAssign whose target is the Name or Attribute `planning_callback`.
violation("data-layer-schema-architecture", "schema-planning", "forbid-schema-planning-callback-field", p, l) :-
    node(d, a, "assignment", _, _), schema_planning_doc(d, p), field(a, "type", _), field(a, "left", t),
    node(_, t, "identifier", _, _), text(t, "planning_callback"), line(a, l).
violation("data-layer-schema-architecture", "schema-planning", "forbid-schema-planning-callback-field", p, l) :-
    node(d, a, "assignment", _, _), schema_planning_doc(d, p), field(a, "type", _), field(a, "left", t),
    node(_, t, "attribute", _, _), field(t, "attribute", at), text(at, "planning_callback"), line(a, l).
// A call of a callback queue.
violation("data-layer-schema-architecture", "schema-planning", "forbid-schema-callback-queues", p, l) :-
    lifecycle_callee(c, x), (x = "enqueue_post_ddl" ; x = "enqueue_post_schema_ddl_flush" ;
    x = "enqueue_post_commit_schema_exit" ; x = "planning_callback"), node(d, c, _, _, _), schema_planning_doc(d, p),
    line(c, l).
// In a def whose name holds materialize_schema_operation_records (the call's innermost def, its decorators its
// own; mirrors python/ast.rr def_frame), a call that mutates or flushes the plan.
.decl schema_planning_frame_mark(kind: symbol)
schema_planning_frame_mark("function_definition"). schema_planning_frame_mark("decorator").
.decl schema_planning_frame(n: node, f: node)
schema_planning_frame(n, f) :- nearest(n, f, schema_planning_frame_mark), node(_, f, "function_definition", _, _).
schema_planning_frame(n, f) :- nearest(n, dc, schema_planning_frame_mark), node(_, dc, "decorator", _, _),
    child(dd, dc, _), field(dd, "definition", f), node(_, f, "function_definition", _, _).
violation("data-layer-schema-architecture", "schema-planning", "forbid-materialization-plan-mutation", p, l) :-
    lifecycle_callee(c, x), (x = "add_operation" ; x = "_materialize_schema_operation_records" ;
    x = "_materialize_schema_operation_records_async" ; x = "flush_schema_plan" ; x = "flush_schema_plan_async"),
    schema_planning_frame(c, f), field(f, "name", nm), text(nm, y), contains("materialize_schema_operation_records", y),
    node(d, c, _, _, _), schema_planning_doc(d, p), line(c, l).
