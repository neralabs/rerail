// data-layer-plan-helpers-allowlist, authored clause `plan-helper-aliases` (relational, partitionBy file,
// requireNonemptyInput syntax_gate: documents without syntax errors). One relation per SQL stage that matters, the
// stage's name after `helpers_`. Option entryPoint at its default (`scan_repo`, the only case; its query and
// the default query differ only in the path filter, which is the scan_repo one here).
// W's syntax table `nodes` is the tape less comments and string pieces; `parent` is `child`, `X_id`/`X_source` are
// `field` and `text`. A finding is (issue, path, line of start_byte): the issue (the reason text) is the code.
// APPROXIMATIONS, each named where it is used:
// - module_names: the SQL's dotted path (path less `.py`, `/` as `.`) is rebuilt from doc's module (which drops
//   a final `.__init__`) and only tested against the module names the query compares with (the callsite
//   allowlist and plan_helpers itself), by globs; a path holding `\`, `//` or a doubled `.py.py` suffix differs.
// - resolved: the lookup's `row_number() … ORDER BY priority DESC` is the lexicographic maximum over paths of
//   fixed-width segments, chosen greedily hop by hop; two bindings of one name at the same start (one statement)
//   tie in SQL (one arbitrary row) and give both helpers here.
// - the callsite allowlist: `callsite NOT IN (…)` compares the group_concat of the enclosing regions' names;
//   every allowlisted callsite is `M::f` or `M::C.f`, so it is tested as "exactly these regions enclose it".
.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, child, field, text, line, syntax_error
.output violation

// ---- documents: the syntax gate and the final query's path filter ----
// `substr(__path,-3)='.py' AND NOT rx_matches(__path,'(?:^|/)\.py$') AND rx_matches(__path,'(?:^|/)(?:impl|api)(?:/|$)|(?:^|/)l[0-9]{4}_')
// AND NOT rx_matches(__path,'(?:^|/)(?:\.git|\.venv|conform|data_layer_testing|docs|services|terminals|tests|tmp)(?:/|$)')`;
// rx_matches searches, so each is `match` with `.*` around it.
.decl helpers_doc(d: number)
helpers_doc(d) :-
    doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d),
    suffix(".py", p), !match("(?:.*/)?\\.py", p),
    match(".*(?:(?:^|/)(?:impl|api)(?:/|$)|(?:^|/)l[0-9]{4}_).*", p),
    !match(".*(?:^|/)(?:\\.git|\\.venv|conform|data_layer_testing|docs|services|terminals|tests|tmp)(?:/|$).*", p).

// ---- helper_names (name, public, lazy, legacy) ----
.decl helpers_name(x: symbol, public: number, lazy: number, legacy: number)
helpers_name("_ddl_effect_lazy_impl_async", 0, 0, 1). helpers_name("_ddl_effect_lazy_now", 0, 0, 1). helpers_name("_ddl_via_plan_impl_async", 0, 0, 0).
helpers_name("_ddl_via_plan_now", 0, 0, 0). helpers_name("_execute_via_plan_impl_async", 0, 0, 0). helpers_name("_execute_via_plan_now", 0, 0, 0).
helpers_name("_fetchall_via_plan_impl_async", 0, 0, 0). helpers_name("_fetchall_via_plan_now", 0, 0, 0). helpers_name("_fetchone_via_plan_impl_async", 0, 0, 0).
helpers_name("_fetchone_via_plan_now", 0, 0, 0). helpers_name("_grammar_effect_lazy_impl_async", 0, 0, 1). helpers_name("_grammar_effect_lazy_now", 0, 0, 1).
helpers_name("_grammar_row_lazy_impl_async", 0, 0, 1). helpers_name("_grammar_row_lazy_now", 0, 0, 1). helpers_name("_grammar_rows_lazy_impl_async", 0, 0, 1).
helpers_name("_grammar_rows_lazy_now", 0, 0, 1). helpers_name("_grammar_value_lazy_now", 0, 0, 1). helpers_name("_scalar_via_plan_impl_async", 0, 0, 0).
helpers_name("_scalar_via_plan_now", 0, 0, 0). helpers_name("ddl_effect_lazy", 0, 1, 0). helpers_name("ddl_effect_lazy_async", 0, 1, 0).
helpers_name("ddl_via_plan", 1, 0, 0). helpers_name("ddl_via_plan_async", 1, 0, 0). helpers_name("execute_via_plan", 1, 0, 0).
helpers_name("execute_via_plan_async", 1, 0, 0). helpers_name("fetchall_via_plan", 1, 0, 0). helpers_name("fetchall_via_plan_async", 1, 0, 0).
helpers_name("fetchone_via_plan", 1, 0, 0). helpers_name("fetchone_via_plan_async", 1, 0, 0). helpers_name("grammar_effect_lazy", 0, 1, 0).
helpers_name("grammar_effect_lazy_async", 0, 1, 0). helpers_name("grammar_row_lazy", 0, 1, 0). helpers_name("grammar_row_lazy_async", 0, 1, 0).
helpers_name("grammar_rows_lazy", 0, 1, 0). helpers_name("grammar_rows_lazy_async", 0, 1, 0). helpers_name("grammar_value_lazy", 0, 1, 0).
helpers_name("scalar_via_plan", 1, 0, 0).
.decl helpers_known(x: symbol)
helpers_known(x) :- helpers_name(x, _, _, _).

// ---- module_names: see the approximation above. helpers_dotted: the SQL's dotted path ----
.decl helpers_dotted(d: number, s: symbol)
helpers_dotted(d, s) :- helpers_doc(d), doc(d, p, m), suffix("/__init__.py", p), s = cat(m, ".__init__").
helpers_dotted(d, m) :- helpers_doc(d), doc(d, p, m), !suffix("/__init__.py", p).
// The name is the dotted path from its first `impl` component, else after its first `api` component, else from its
// first `l[0-9]{4}_…` component, else all of it. helpers_module(d, M): the name is M, for the M the query reads.
.decl helpers_impl_module(m: symbol)
helpers_impl_module("impl.common.l2070_server_plan.plan_helpers").
helpers_impl_module("impl.common.l2200_sql_dialect.sql_connection").
helpers_impl_module("impl.doltdb.versioned_operations_read").
.decl helpers_l_module(m: symbol)
helpers_l_module("l8000_admin.tools.sql_execution").
helpers_l_module("l8000_admin.tools.versioning_tools").
.decl helpers_module(d: number, m: symbol)
// `impl.…`: D is M, or X.M where X has no `impl` component.
helpers_module(d, m) :- helpers_impl_module(m), helpers_dotted(d, m).
helpers_module(d, m) :-
    helpers_impl_module(m), helpers_dotted(d, s), x = cat("*.", m), glob(x, s),
    i1 = cat("impl.", m), s != i1, i2 = cat("impl.*.", m), !glob(i2, s), i3 = cat("*.impl.", m), !glob(i3, s),
    i4 = cat("*.impl.*.", m), !glob(i4, s).
// `l8000_…`: D has no `impl` or `api` component, and is M or X.M where X has no `l[0-9]{4}_` component.
.decl helpers_impl_or_api(d: number)
helpers_impl_or_api(d) :- helpers_dotted(d, s), match("(?:.*\\.)?(?:impl|api)(?:\\..*)?", s).
helpers_module(d, m) :- helpers_l_module(m), helpers_dotted(d, m), !helpers_impl_or_api(d).
helpers_module(d, m) :-
    helpers_l_module(m), helpers_dotted(d, s), !helpers_impl_or_api(d), x = cat("*.", m), glob(x, s),
    l1 = cat("l[0-9][0-9][0-9][0-9]_*.", m), !glob(l1, s), l2 = cat("*.l[0-9][0-9][0-9][0-9]_*.", m), !glob(l2, s).

// ---- imports (statement n, name node x, its name and local name; `module` for a from-import) ----
.decl helpers_import_kind(k: symbol)
helpers_import_kind("import_statement"). helpers_import_kind("import_from_statement").
.decl helpers_import(d: number, n: node, x: node, name: symbol, local: symbol)
helpers_import(d, n, x, name, local) :-
    helpers_doc(d), node(d, n, k, _, _), helpers_import_kind(k), child(n, x, _), !field(n, "module_name", x),
    node(_, x, "dotted_name", _, _), text(x, name), local = name.
helpers_import(d, n, x, name, local) :-
    helpers_doc(d), node(d, n, k, _, _), helpers_import_kind(k), child(n, x, _), !field(n, "module_name", x),
    node(_, x, "aliased_import", _, _), field(x, "name", y), text(y, name), field(x, "alias", z), text(z, local).
// module_name_source: the text of a dotted_name (a relative_import is never one of the modules compared).
.decl helpers_from(n: node, module: symbol)
helpers_from(n, m) :-
    node(_, n, "import_from_statement", _, _), field(n, "module_name", y), node(_, y, "dotted_name", _, _), text(y, m).

// module_aliases (at, name).
.decl helpers_module_alias(d: number, at: number, name: symbol)
helpers_module_alias(d, at, local) :-
    helpers_import(d, n, _, "plan_helpers", local), helpers_from(n, "impl.common.l2070_server_plan"), node(d, n, _, at, _).
helpers_module_alias(d, at, "plan_helpers") :-
    helpers_import(d, n, _, "impl.common.l2070_server_plan.plan_helpers", "impl.common.l2070_server_plan.plan_helpers"),
    node(d, n, "import_statement", at, _).
helpers_module_alias(d, at, local) :-
    helpers_import(d, n, _, "impl.common.l2070_server_plan.plan_helpers", local), node(d, n, "import_statement", at, _),
    local != "impl.common.l2070_server_plan.plan_helpers".

// An import from plan_helpers itself.
.decl helpers_ph_import(d: number, n: node, x: node, name: symbol, local: symbol)
helpers_ph_import(d, n, x, name, local) :-
    helpers_import(d, n, x, name, local), helpers_from(n, "impl.common.l2070_server_plan.plan_helpers").

// ---- assignments, target_names ----
.decl helpers_pattern_kind(k: symbol)
helpers_pattern_kind("pattern_list"). helpers_pattern_kind("tuple_pattern"). helpers_pattern_kind("list_pattern").
helpers_pattern_kind("tuple"). helpers_pattern_kind("list").
.decl helpers_target(a: node, t: node)
helpers_target(a, t) :- helpers_doc(d), node(d, a, "assignment", _, _), field(a, "left", t).
helpers_target(a, c) :- helpers_target(a, t), node(_, t, k, _, _), helpers_pattern_kind(k), child(t, c, _).
.decl helpers_target_name(d: number, a: node, t: node, name: symbol)
helpers_target_name(d, a, t, name) :- helpers_target(a, t), node(d, t, "identifier", _, _), text(t, name).

// ---- bindings: (name, at) to a helper (imports) or to an expression (assignments) ----
.decl helpers_bind_helper(d: number, name: symbol, at: number, helper: symbol)
helpers_bind_helper(d, local, at, name) :- helpers_ph_import(d, n, _, name, local), helpers_known(name), node(d, n, _, at, _).
helpers_bind_helper(d, local, at, name) :-
    helpers_ph_import(d, n, _, name, local), prefix("_", name), contains("via_plan", name), node(d, n, _, at, _).
.decl helpers_bind_expr(d: number, name: symbol, at: number, expr: node)
helpers_bind_expr(d, name, at, v) :- helpers_target_name(d, a, _, name), field(a, "right", v), node(d, a, _, at, _).

// ---- requests: (request, expr, at) ----
.decl helpers_request(d: number, r: node, expr: node, at: number)
helpers_request(d, c, f, at) :- helpers_doc(d), node(d, c, "call", at, _), field(c, "function", f).
helpers_request(d, a, v, at) :- helpers_doc(d), node(d, a, "assignment", at, _), field(a, "right", v).

// ---- resolved: the lookup, from a state (node, at) ----
.decl helpers_state(d: number, n: node, at: number)
helpers_state(d, e, at) :- helpers_request(d, _, e, at).
helpers_state(d, v, b) :-
    helpers_state(d, n, at), node(_, n, "identifier", _, _), text(n, t), helpers_bind_expr(d, t, b, v), b < at.

// Direct resolutions (segment 0): an identifier named as a helper; an attribute whose attr is one, or matches
// `_*via_plan*` on an identifier object that a module alias bound earlier.
.decl helpers_direct(d: number, n: node, at: number, helper: symbol)
helpers_direct(d, n, at, t) :- helpers_state(d, n, at), node(_, n, "identifier", _, _), text(n, t), helpers_known(t).
helpers_direct(d, n, at, x) :-
    helpers_state(d, n, at), node(_, n, "attribute", _, _), field(n, "attribute", y), text(y, x), helpers_known(x).
helpers_direct(d, n, at, x) :-
    helpers_state(d, n, at), node(_, n, "attribute", _, _), field(n, "attribute", y), text(y, x),
    prefix("_", x), contains("via_plan", x), field(n, "object", o), node(_, o, "identifier", _, _), text(o, ot),
    helpers_module_alias(d, ms, ot), ms < at.

// helpers_resolves: some path from the state reaches a helper.
.decl helpers_resolves(d: number, n: node, at: number)
helpers_resolves(d, n, at) :- helpers_direct(d, n, at, _).
helpers_resolves(d, n, at) :-
    helpers_state(d, n, at), node(_, n, "identifier", _, _), text(n, t), helpers_bind_helper(d, t, b, _), b < at.
helpers_resolves(d, n, at) :-
    helpers_state(d, n, at), node(_, n, "identifier", _, _), text(n, t), helpers_bind_expr(d, t, b, v), b < at,
    helpers_resolves(d, v, b).

// The options of a state by their first segment: 0 direct, `at + 1` through a binding at `at`.
.decl helpers_option(d: number, n: node, at: number, seg: number)
helpers_option(d, n, at, 0) :- helpers_direct(d, n, at, _).
helpers_option(d, n, at, s) :-
    helpers_state(d, n, at), node(_, n, "identifier", _, _), text(n, t), helpers_bind_helper(d, t, b, _), b < at,
    s = b + 1.
helpers_option(d, n, at, s) :-
    helpers_state(d, n, at), node(_, n, "identifier", _, _), text(n, t), helpers_bind_expr(d, t, b, v), b < at,
    helpers_resolves(d, v, b), s = b + 1.
.decl helpers_best(d: number, n: node, at: number, seg: number)
helpers_best(d, n, at, s) :- helpers_resolves(d, n, at), s = max k : { helpers_option(d, n, at, k) }.

.decl helpers_chosen(d: number, n: node, at: number, helper: symbol)
helpers_chosen(d, n, at, h) :- helpers_best(d, n, at, 0), helpers_direct(d, n, at, h).
helpers_chosen(d, n, at, h) :-
    helpers_best(d, n, at, s), s > 0, b = s - 1, node(_, n, "identifier", _, _), text(n, t), helpers_bind_helper(d, t, b, h).
helpers_chosen(d, n, at, h) :-
    helpers_best(d, n, at, s), s > 0, b = s - 1, node(_, n, "identifier", _, _), text(n, t), helpers_bind_expr(d, t, b, v),
    helpers_chosen(d, v, b, h).

.decl helpers_resolved(d: number, r: node, helper: symbol)
helpers_resolved(d, r, h) :- helpers_request(d, r, e, at), helpers_chosen(d, e, at, h).

// ---- raw_issues: (anchor node, kind, helper, local) ----
.decl helpers_raw(d: number, n: node, kind: symbol, helper: symbol, local: symbol)
helpers_raw(d, n, "import", name, local) :- helpers_ph_import(d, n, _, name, local), helpers_name(name, 1, _, _).
helpers_raw(d, n, "import", name, local) :- helpers_ph_import(d, n, _, name, local), helpers_name(name, _, 1, _).
helpers_raw(d, n, "import", name, local) :- helpers_ph_import(d, n, _, name, local), helpers_name(name, _, _, 1).
helpers_raw(d, n, "import", name, local) :-
    helpers_ph_import(d, n, _, name, local), prefix("_", name), contains("via_plan", name).
helpers_raw(d, t, "alias", h, name) :- helpers_target_name(d, a, t, name), helpers_resolved(d, a, h).
// A call's local is NULL; "" stands for it (a call's reason never reads it).
helpers_raw(d, c, "call", h, "") :- node(d, c, "call", _, _), helpers_resolved(d, c, h).

// ---- issues: the reason; the exclusions ----
.decl helpers_legacy_or_via(h: symbol)
helpers_legacy_or_via(h) :- helpers_name(h, _, _, 1).
helpers_legacy_or_via(h) :- helpers_raw(_, _, _, h, _), prefix("_", h), contains("via_plan", h).
.decl helpers_reason(d: number, n: node, reason: symbol)
helpers_reason(d, n, r) :- helpers_raw(d, n, "call", h, _), r = cat(cat("old or private ", h), "() call is forbidden"),
    !helpers_self_call(d, h).
helpers_reason(d, n, r) :- helpers_raw(d, n, k, h, _), k != "call", helpers_forbidden(k, h),
    r = cat(cat(cat(cat("old or private ", h), " "), k), " is forbidden"), !helpers_legacy_alias(k, h).
helpers_reason(d, n, r) :- helpers_raw(d, n, "import", h, l), !helpers_forbidden("import", h), helpers_name(h, _, 1, _),
    helpers_eager(l), r = cat(cat("lazy terminal ", h), " imported under eager alias").
helpers_reason(d, n, r) :- helpers_raw(d, n, "alias", h, l), !helpers_forbidden("alias", h), helpers_name(h, _, 1, _),
    helpers_eager(l), r = cat(cat("lazy terminal ", h), " assigned to eager alias"), !helpers_legacy_alias("alias", h).
// The CASE's second branch: public, `_*via_plan*`, or an import of a legacy helper.
.decl helpers_forbidden(k: symbol, h: symbol)
helpers_forbidden(k, h) :- helpers_raw(_, _, k, h, _), helpers_name(h, 1, _, _).
helpers_forbidden(k, h) :- helpers_raw(_, _, k, h, _), prefix("_", h), contains("via_plan", h).
helpers_forbidden("import", h) :- helpers_raw(_, _, "import", h, _), helpers_name(h, _, _, 1).
// `rx_matches(lower(local),'execute|fetch|scalar|ddl')`.
.decl helpers_eager(l: symbol)
helpers_eager(l) :- helpers_raw(_, _, _, _, l), (icontains("execute", l) ; icontains("fetch", l) ; icontains("scalar", l) ; icontains("ddl", l)).
// WHERE NOT (alias of a legacy helper) AND NOT (a call in plan_helpers itself of `_*via_plan*` or a legacy helper).
.decl helpers_legacy_alias(k: symbol, h: symbol)
helpers_legacy_alias("alias", h) :- helpers_raw(_, _, "alias", h, _), helpers_name(h, _, _, 1).
.decl helpers_self_call(d: number, h: symbol)
helpers_self_call(d, h) :-
    helpers_raw(d, _, "call", h, _), helpers_module(d, "impl.common.l2070_server_plan.plan_helpers"), helpers_legacy_or_via(h).

// ---- regions and the callsite allowlist ----
.decl helpers_class_region(d: number, c: node, name: symbol, s: number, e: number)
helpers_class_region(d, c, x, s, e) :-
    helpers_doc(d), node(d, c, "class_definition", s, e), field(c, "name", y), text(y, x).
.decl helpers_fn_region(d: number, f: node, name: symbol, s: number, e: number)
helpers_fn_region(d, f, x, s, e) :-
    helpers_doc(d), node(d, f, "function_definition", s0, e), field(f, "name", y), text(y, x),
    child(p, f, _), node(_, p, "decorated_definition", s, _), s0 >= s.
helpers_fn_region(d, f, x, s, e) :-
    helpers_doc(d), node(d, f, "function_definition", s, e), field(f, "name", y), text(y, x),
    !helpers_decorated(f).
.decl helpers_decorated(f: node)
helpers_decorated(f) :- node(_, f, "function_definition", _, _), child(p, f, _), node(_, p, "decorated_definition", _, _).

// Regions enclosing an issue's span.
.decl helpers_in_class(n: node, c: node, name: symbol)
helpers_in_class(n, c, x) :- helpers_reason(d, n, _), node(d, n, _, s, e), helpers_class_region(d, c, x, cs, ce), cs <= s, ce >= e.
.decl helpers_in_fn(n: node, f: node, name: symbol)
helpers_in_fn(n, f, x) :- helpers_reason(d, n, _), node(d, n, _, s, e), helpers_fn_region(d, f, x, fs, fe), fs <= s, fe >= e.
.decl helpers_two_classes(n: node)
helpers_two_classes(n) :- helpers_in_class(n, c1, _), helpers_in_class(n, c2, _), c1 != c2.
.decl helpers_two_fns(n: node)
helpers_two_fns(n) :- helpers_in_fn(n, f1, _), helpers_in_fn(n, f2, _), f1 != f2.
.decl helpers_some_class(n: node)
helpers_some_class(n) :- helpers_in_class(n, _, _).

// The allowlist: module, class ("" for none), function.
.decl helpers_allow(m: symbol, c: symbol, f: symbol)
helpers_allow("impl.common.l2070_server_plan.plan_helpers", "", "ddl_via_plan").
helpers_allow("impl.common.l2070_server_plan.plan_helpers", "", "ddl_via_plan_async").
helpers_allow("impl.common.l2070_server_plan.plan_helpers", "", "scalar_via_plan").
helpers_allow("impl.common.l2200_sql_dialect.sql_connection", "SqlConnection", "execute_grammar_with_params").
helpers_allow("impl.common.l2200_sql_dialect.sql_connection", "SqlConnection", "raw_execute").
helpers_allow("impl.common.l2200_sql_dialect.sql_connection", "SqlConnection", "raw_execute_async").
helpers_allow("impl.doltdb.versioned_operations_read", "", "check_doltdb_branch_exists").
helpers_allow("l8000_admin.tools.sql_execution", "", "execute_sql_command").
helpers_allow("l8000_admin.tools.sql_execution", "", "execute_sql_query").
helpers_allow("l8000_admin.tools.sql_execution", "", "explain_query").
helpers_allow("l8000_admin.tools.versioning_tools", "", "_fetch_plan_rows").

.decl helpers_allowed(n: node)
helpers_allowed(n) :-
    helpers_reason(d, n, _), helpers_module(d, m), helpers_allow(m, "", f), !helpers_some_class(n),
    helpers_in_fn(n, _, f), !helpers_two_fns(n).
helpers_allowed(n) :-
    helpers_reason(d, n, _), helpers_module(d, m), helpers_allow(m, c, f), c != "", helpers_in_class(n, _, c),
    !helpers_two_classes(n), helpers_in_fn(n, _, f), !helpers_two_fns(n).

violation("data-layer-plan-helpers-allowlist", "plan-helper-aliases", r, p, l) :-
    helpers_reason(d, n, r), !helpers_allowed(n), doc(d, p, _), line(n, l).
