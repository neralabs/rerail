// data-layer-async-sync-delegation: every clause authored (the converter gaps all 13: the `^async\b` regex on
// for/with, the sourceGate regex on the module's text, `budget`, and `compare` over captures and transforms).
// Read from the policy (candidates/rules-ast/data-layer-async-sync-delegation.json) with W's semantics
// (ast-grep-config: one environment, a relation binds from the FIRST related node that matches, no backtracking).
//
// Options from the converter's facts: sourceGate (default true) through `option_on("sourceGate")` (the gate below);
// oracleAnalyzer (default false) is read by no clause.
//
// Shared readings of the policy's matchers:
// - `syntax: valid`: !tape_syntax_error(d); the scope is the converter's in_scope/out_scope.
// - `regex "^async\b"` on a function_definition / for_statement / with_statement: its `async` token, op(n, "async");
//   `regex "^def\b"` on a function_definition: no `async` token.
// - A regex on an identifier is a test on its text (`text`); `regex "_lazy$"` on an attribute is the same test on its
//   `attribute` identifier (an attribute's text ends with it). Regexes on other nodes (types, return types, the
//   module) read `node_text`, the node's full source text.
// - "Real statements" of a block (the policy's `$_`, not a comment, not a docstring): its named children other than
//   comments and the docstring, an expression_statement whose child is a string or concatenated_string of W's type
//   str (`value: {type: str}`: `value_type_of(x, "str")`) and which is the block's first non-comment named child
//   (`nthChild 1, ofRule not comment`; `child` holds no Python comments, so that is its first `child`). W's value of
//   an f-string with a replacement field is Unknown, not false, and stays unknown under the policy's `not`; here it
//   has no `value_type_of` row, so such a first statement counts as real (a three-valued verdict two-valued).
// - `pattern $X` reusing a bound capture is W's text equality; it is read here as the same node (two functions of
//   identical text in one class body are not told apart).
// - `inside … stopBy <kind>` is the nearest enclosing node of that kind (`nearest`); `has … stopBy
//   function_definition` is every descendant whose nearest enclosing function_definition is the node; `stopBy end`
//   every descendant (`has`).
// - A capture's text with white space removed (the policy's `replace \s by ""`) is `@replace_all(t, "\\s", "")`
//   over its `node_text` (W's `replace` transform over the capture's source text).

.decl tape_syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl option_on(name: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- shared (asd_: async-sync-delegation) -----------------------------------------------------------------------

.decl asd_fdef(kind: symbol)
asd_fdef("function_definition").
.decl asd_class(kind: symbol)
asd_class("class_definition").

// The source gate, every clause's: the module (or, `inside … stopBy end`, a module around the node) matches the
// option's regex. sourceGate true: `async\ def|_async|__aenter__|__aexit__|run_in_executor|to_thread|
// tracked_run_in_executor|tracked_to_thread|legacy_async|legacy_module_async|pure_lazy|resolve_async` over the
// module's text, a search for one of these literals; false: `(?s).*`, which every module matches.
.decl asd_gate(d: number)
asd_gate(d) :- option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, s),
    (contains("async def", s) ; contains("_async", s) ; contains("__aenter__", s) ; contains("__aexit__", s) ;
     contains("run_in_executor", s) ; contains("to_thread", s) ; contains("tracked_run_in_executor", s) ;
     contains("tracked_to_thread", s) ; contains("legacy_async", s) ; contains("legacy_module_async", s) ;
     contains("pure_lazy", s) ; contains("resolve_async", s)).
asd_gate(d) :- !option_on("sourceGate"), node(d, _, "module", _, _).

// A document a clause reports in.
.decl asd_doc(d: number, p: symbol)
asd_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), asd_gate(d).

// `filePath notRegex "(?:^|/)(?:tests|conform)/|(?:^|/)impl/browser/"`.
.decl asd_test_path(p: symbol)
asd_test_path(p) :- doc(_, p, _),
    (prefix("tests/", p) ; prefix("conform/", p) ; prefix("impl/browser/", p) ;
     contains("/tests/", p) ; contains("/conform/", p) ; contains("/impl/browser/", p)).

// A function's name.
.decl asd_fname(f: node, s: symbol)
asd_fname(f, s) :- node(_, f, "function_definition", _, _), field(f, "name", n), text(n, s).

// A str literal.
.decl asd_strlit(x: node)
asd_strlit(x) :- node(_, x, "string", _, _), value_type_of(x, "str").
asd_strlit(x) :- node(_, x, "concatenated_string", _, _), value_type_of(x, "str").

// A named child of its parent before s (`child` has no comments: W's `ofRule not comment` counts none).
.decl asd_noncomment_before(s: node)
asd_noncomment_before(s) :- child(b, s, i), child(b, _, j), j < i.

.decl asd_docstring(s: node)
asd_docstring(s) :- node(_, s, "expression_statement", _, _), child(s, x, _), asd_strlit(x), !asd_noncomment_before(s).

// s is a real statement of b.
.decl asd_real(b: node, s: node)
asd_real(b, s) :- child(b, s, _), !node(_, s, "comment", _, _), !asd_docstring(s).

.decl asd_real_count(b: node, k: number)
asd_real_count(b, k) :- node(_, b, "block", _, _), k = count : { asd_real(b, _) }.

// s is a real statement of f's body; f's body holds exactly k of them.
.decl asd_body_real(f: node, s: node)
asd_body_real(f, s) :- node(_, f, "function_definition", _, _), field(f, "body", b), asd_real(b, s).
.decl asd_body_count(f: node, k: number)
asd_body_count(f, k) :- node(_, f, "function_definition", _, _), field(f, "body", b), asd_real_count(b, k).

// f is the definition of a decorated_definition with a decorator `@nm` / `@x.nm` (plain) or `@nm(…)` / `@x.nm(…)`
// (call): the policy's decorator tests, `has stopBy neighbor` from the decorator.
.decl asd_deco_expr(e: node, nm: symbol)
asd_deco_expr(e, nm) :- node(_, e, "identifier", _, _), text(e, nm).
asd_deco_expr(e, nm) :- node(_, e, "attribute", _, _), field(e, "attribute", a), node(_, a, "identifier", _, _), text(a, nm).
.decl asd_deco_plain(f: node, nm: symbol)
asd_deco_plain(f, nm) :- field(dd, "definition", f), node(_, dd, "decorated_definition", _, _),
    child(dd, dec, _), node(_, dec, "decorator", _, _), child(dec, e, _), asd_deco_expr(e, nm).
.decl asd_deco_call(f: node, nm: symbol)
asd_deco_call(f, nm) :- field(dd, "definition", f), node(_, dd, "decorated_definition", _, _),
    child(dd, dec, _), node(_, dec, "decorator", _, _), child(dec, e, _), node(_, e, "call", _, _),
    field(e, "function", g), asd_deco_expr(g, nm).
.decl asd_deco(f: node, nm: symbol)
asd_deco(f, nm) :- asd_deco_plain(f, nm).
asd_deco(f, nm) :- asd_deco_call(f, nm).

// b5-common-3 (b5-common-2 is its negation): an abstract method or a stub body (one real statement: pass, `...`,
// `raise NotImplementedError(…)`).
.decl asd_stub(f: node)
asd_stub(f) :- asd_deco(f, "abstractmethod").
asd_stub(f) :- asd_body_count(f, 1), asd_body_real(f, s), asd_stub_stmt(s).
.decl asd_stub_stmt(s: node)
asd_stub_stmt(s) :- node(_, s, "pass_statement", _, _).
asd_stub_stmt(s) :- node(_, s, "expression_statement", _, _), child(s, x, _), node(_, x, "ellipsis", _, _).
asd_stub_stmt(s) :- node(_, s, "raise_statement", _, _), child(s, c, _), node(_, c, "call", _, _),
    field(c, "function", g), node(_, g, "identifier", _, _), text(g, "NotImplementedError").

// A capture's text with white space removed: W's `replace` transform (`\s` by "") over the node's source text.
.decl asd_compact(n: node, s: symbol)
asd_compact(n, @replace_all(t, "\\s", "")) :- wrapper_shape_thin(_, n), node_text(n, t).
asd_compact(n, @replace_all(t, "\\s", "")) :- wrapper_shape_lazy_thin(_, n), node_text(n, t).

// Children in order without arithmetic in a recursion: the first, the next after x, the last.
.decl asd_first_child(p: node, x: node)
asd_first_child(p, x) :- child(p, x, 0).
.decl asd_next_child(p: node, x: node, y: node)
asd_next_child(p, x, y) :- child(p, x, i), j = i + 1, child(p, y, j).
.decl asd_last_child(p: node, x: node)
asd_last_child(p, x) :- child(p, x, i), !asd_has_child_after(p, i).
.decl asd_has_child_after(p: node, i: number)
asd_has_child_after(p, i) :- child(p, _, i), j = i + 1, child(p, _, j).

// The nearest class of f, and that class's body block.
.decl asd_class_of(f: node, c: node, bc: node)
asd_class_of(f, c, bc) :- node(_, f, "function_definition", _, _), nearest(f, c, asd_class), field(c, "body", bc).

// x is a direct child of a class body at i, and g its function_definition (x itself, or a decorated_definition's
// definition).
.decl asd_member(bc: node, i: number, g: node)
asd_member(bc, i, g) :- child(bc, g, i), node(_, g, "function_definition", _, _).
asd_member(bc, i, g) :- child(bc, x, i), node(_, x, "decorated_definition", _, _), field(x, "definition", g),
    node(_, g, "function_definition", _, _).

// A class at the top level: its parent is the module, or a decorated_definition whose parent is the module.
.decl asd_top_class(c: node)
asd_top_class(c) :- node(_, c, "class_definition", _, _), child(m, c, _), node(_, m, "module", _, _).
asd_top_class(c) :- node(_, c, "class_definition", _, _), child(dd, c, _), node(_, dd, "decorated_definition", _, _),
    child(m, dd, _), node(_, m, "module", _, _).

// ---- sync-delegation (A) and no-await (B): b5-common-1 ----------------------------------------------------------
// f is an `async def` (name nm) in a reported document at path p.
.decl sync_delegation_fn(f: node, p: symbol, nm: symbol)
sync_delegation_fn(f, p, nm) :- node(d, f, "function_definition", _, _), op(f, "async"), asd_doc(d, p), asd_fname(f, nm).

// `has … stopBy function_definition`: n is below f, not below a nested function_definition.
.decl sync_delegation_own(f: node, n: node)
sync_delegation_own(f, n) :- sync_delegation_fn(f, _, _), nearest(n, f, asd_fdef).

// An await, an `async for` or an `async with` of f's own.
.decl sync_delegation_awaits(f: node)
sync_delegation_awaits(f) :- sync_delegation_own(f, n), node(_, n, "await", _, _).
sync_delegation_awaits(f) :- sync_delegation_own(f, n), node(_, n, "for_statement", _, _), op(n, "async").
sync_delegation_awaits(f) :- sync_delegation_own(f, n), node(_, n, "with_statement", _, _), op(n, "async").

// The body is no real statement, or stub setup ending in an unsupported raise (stub-setup, unsupported-raise).
.decl sync_delegation_unsupported(s: node)
sync_delegation_unsupported(s) :- node(_, s, "raise_statement", _, _), child(s, x, _), node(_, x, "identifier", _, _),
    (text(x, "NotImplementedError") ; text(x, "RuntimeError")).
sync_delegation_unsupported(s) :- node(_, s, "raise_statement", _, _), child(s, x, _), node(_, x, "call", _, _),
    field(x, "function", g), node(_, g, "identifier", _, _), (text(g, "NotImplementedError") ; text(g, "RuntimeError")).

// stub-setup (recursive through `if`).
.decl sync_delegation_setup(s: node)
sync_delegation_setup(s) :- node(_, s, "pass_statement", _, _).
sync_delegation_setup(s) :- node(_, s, "delete_statement", _, _).
sync_delegation_setup(s) :- node(_, s, "expression_statement", _, _), child(s, x, _), node(_, x, "assignment", _, _).
sync_delegation_setup(s) :- node(_, s, "expression_statement", _, _), child(s, x, _), node(_, x, "ellipsis", _, _).
// An if_statement whose consequence has a real statement, and none of whose direct block children (its
// consequence; elif and else are clauses, not blocks) has a real statement that is neither setup nor an
// unsupported raise. The `not has` of the recursion is written as a chain over the block's children ("every child
// so far is fine"), which is positive.
sync_delegation_setup(s) :- node(_, s, "if_statement", _, _), field(s, "consequence", b), asd_real(b, _),
    sync_delegation_blk_ok(b).
.decl sync_delegation_stmt_ok(x: node)
sync_delegation_stmt_ok(x) :- child(b, x, _), node(_, b, "block", _, _), !asd_real(b, x).
sync_delegation_stmt_ok(x) :- sync_delegation_setup(x).
sync_delegation_stmt_ok(x) :- sync_delegation_unsupported(x).
// blk_upto(b, x): x and every child of b before it are fine.
.decl sync_delegation_blk_upto(b: node, x: node)
sync_delegation_blk_upto(b, x) :- node(_, b, "block", _, _), asd_first_child(b, x), sync_delegation_stmt_ok(x).
sync_delegation_blk_upto(b, y) :- sync_delegation_blk_upto(b, x), asd_next_child(b, x, y), sync_delegation_stmt_ok(y).
.decl sync_delegation_blk_ok(b: node)
sync_delegation_blk_ok(b) :- sync_delegation_blk_upto(b, x), asd_last_child(b, x).

// A real statement follows s in its block.
.decl sync_delegation_followed(s: node)
sync_delegation_followed(s) :- child(b, s, i), asd_real(b, y), child(b, y, j), j > i.

.decl sync_delegation_stub_body(f: node)
sync_delegation_stub_body(f) :- sync_delegation_fn(f, _, _), asd_body_count(f, 0).
sync_delegation_stub_body(f) :- sync_delegation_fn(f, _, _), field(f, "body", b), child(b, s, _),
    sync_delegation_unsupported(s), !sync_delegation_followed(s), !sync_delegation_body_other(b).
.decl sync_delegation_body_other(b: node)
sync_delegation_body_other(b) :- asd_real(b, x), !sync_delegation_setup(x), !sync_delegation_unsupported(x).

// _on_last_unsubscribe / start / stop whose body has only pass, assignments to local targets and static returns.
.decl sync_delegation_toggle(f: node)
sync_delegation_toggle(f) :- sync_delegation_fn(f, _, nm), (nm = "_on_last_unsubscribe" ; nm = "start" ; nm = "stop"),
    field(f, "body", b), !sync_delegation_toggle_other(b).
.decl sync_delegation_toggle_other(b: node)
sync_delegation_toggle_other(b) :- asd_real(b, x), !sync_delegation_toggle_ok(x).
.decl sync_delegation_toggle_ok(x: node)
sync_delegation_toggle_ok(x) :- node(_, x, "pass_statement", _, _).
sync_delegation_toggle_ok(x) :- node(_, x, "expression_statement", _, _), child(x, a, _), node(_, a, "assignment", _, _), field(a, "left", l), sync_delegation_local(l).
sync_delegation_toggle_ok(x) :- node(_, x, "expression_statement", _, _), child(x, a, _), node(_, a, "augmented_assignment", _, _), field(a, "left", l), sync_delegation_local(l).
sync_delegation_toggle_ok(x) :- node(_, x, "return_statement", _, _), !sync_delegation_return_dynamic(x).
.decl sync_delegation_return_dynamic(x: node)
sync_delegation_return_dynamic(x) :- node(_, x, "return_statement", _, _), child(x, v, _), !sync_delegation_static(v).

// local-target: an identifier, `self.x`, or a pattern list every element of which is one (a chain over the
// elements, as above).
.decl sync_delegation_local(n: node)
sync_delegation_local(n) :- node(_, n, "identifier", _, _).
sync_delegation_local(n) :- node(_, n, "attribute", _, _), field(n, "object", o), node(_, o, "identifier", _, _), text(o, "self").
sync_delegation_local(n) :- sync_delegation_plist(n), !child(n, _, _).
sync_delegation_local(n) :- sync_delegation_plist(n), sync_delegation_local_upto(n, x), asd_last_child(n, x).
.decl sync_delegation_plist(n: node)
sync_delegation_plist(n) :- node(_, n, "pattern_list", _, _).
sync_delegation_plist(n) :- node(_, n, "tuple_pattern", _, _).
sync_delegation_plist(n) :- node(_, n, "list_pattern", _, _).
.decl sync_delegation_local_upto(n: node, x: node)
sync_delegation_local_upto(n, x) :- sync_delegation_plist(n), asd_first_child(n, x), sync_delegation_local(x).
sync_delegation_local_upto(n, y) :- sync_delegation_local_upto(n, x), asd_next_child(n, x, y), sync_delegation_local(y).

// static-return (`regex (?i)^[rub]*f` on a string: an f prefix); a tuple, list, set or dictionary every element
// (entry) of which is static (a chain, as above).
.decl sync_delegation_static(n: node)
sync_delegation_static(n) :- node(_, n, "integer", _, _).
sync_delegation_static(n) :- node(_, n, "float", _, _).
sync_delegation_static(n) :- node(_, n, "true", _, _).
sync_delegation_static(n) :- node(_, n, "false", _, _).
sync_delegation_static(n) :- node(_, n, "none", _, _).
sync_delegation_static(n) :- node(_, n, "ellipsis", _, _).
sync_delegation_static(n) :- node(_, n, "identifier", _, _).
sync_delegation_static(n) :- node(_, n, "string", _, _), strprefix(n, p), !contains("f", p).
sync_delegation_static(n) :- node(_, n, "concatenated_string", _, _), !sync_delegation_fpart(n).
sync_delegation_static(n) :- node(_, n, "attribute", _, _), field(n, "object", o), node(_, o, "identifier", _, _), text(o, "self").
sync_delegation_static(n) :- sync_delegation_coll(n), !child(n, _, _).
sync_delegation_static(n) :- sync_delegation_coll(n), sync_delegation_static_upto(n, x), asd_last_child(n, x).
.decl sync_delegation_fpart(n: node)
sync_delegation_fpart(n) :- node(_, n, "concatenated_string", _, _), child(n, c, _), node(_, c, "string", _, _),
    strprefix(c, p), contains("f", p).
.decl sync_delegation_coll(n: node)
sync_delegation_coll(n) :- node(_, n, "tuple", _, _).
sync_delegation_coll(n) :- node(_, n, "list", _, _).
sync_delegation_coll(n) :- node(_, n, "set", _, _).
sync_delegation_coll(n) :- node(_, n, "dictionary", _, _).
.decl sync_delegation_static_elem(x: node)
sync_delegation_static_elem(x) :- child(n, x, _), node(_, n, "tuple", _, _), sync_delegation_static(x).
sync_delegation_static_elem(x) :- child(n, x, _), node(_, n, "list", _, _), sync_delegation_static(x).
sync_delegation_static_elem(x) :- child(n, x, _), node(_, n, "set", _, _), sync_delegation_static(x).
sync_delegation_static_elem(x) :- child(n, x, _), node(_, n, "dictionary", _, _), node(_, x, "pair", _, _),
    field(x, "key", a), sync_delegation_static(a), field(x, "value", b), sync_delegation_static(b).
sync_delegation_static_elem(x) :- child(n, x, _), node(_, n, "dictionary", _, _), node(_, x, "dictionary_splat", _, _),
    child(x, a, _), sync_delegation_static(a).
.decl sync_delegation_static_upto(n: node, x: node)
sync_delegation_static_upto(n, x) :- sync_delegation_coll(n), asd_first_child(n, x), sync_delegation_static_elem(x).
sync_delegation_static_upto(n, y) :- sync_delegation_static_upto(n, x), asd_next_child(n, x, y), sync_delegation_static_elem(y).

// A call to a `_lazy` function (identifier, or attribute whose attribute ends `_lazy`), and a safe call.
.decl sync_delegation_lazy_call(c: node)
sync_delegation_lazy_call(c) :- node(_, c, "call", _, _), field(c, "function", g), node(_, g, "identifier", _, _), text(g, s), suffix("_lazy", s).
sync_delegation_lazy_call(c) :- node(_, c, "call", _, _), field(c, "function", g), node(_, g, "attribute", _, _),
    field(g, "attribute", a), text(a, s), suffix("_lazy", s).
.decl sync_delegation_safe_call(c: node)
sync_delegation_safe_call(c) :- sync_delegation_lazy_call(c).
sync_delegation_safe_call(c) :- node(_, c, "call", _, _), field(c, "function", g), node(_, g, "identifier", _, _),
    (text(g, "JSONResponse") ; text(g, "_attach_auto_api_hook_registry") ; text(g, "cast")).
// f calls a `_lazy` function and nothing but lazy and safe calls (`has stopBy end`: nested functions too).
.decl sync_delegation_lazy_only(f: node)
sync_delegation_lazy_only(f) :- sync_delegation_fn(f, _, _), inside(c, f, asd_fdef), sync_delegation_lazy_call(c), !sync_delegation_eager(f).
.decl sync_delegation_eager(f: node)
sync_delegation_eager(f) :- sync_delegation_fn(f, _, _), inside(c, f, asd_fdef), node(_, c, "call", _, _), !sync_delegation_safe_call(c).

// b5-common-5: the exempt paths and names.
.decl sync_delegation_exempt(f: node)
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), contains("/tests/", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), prefix("tests/", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), contains("/conform/", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), prefix("conform/", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), prefix("__", nm), suffix("__", nm).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), contains("/impl/browser/", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), prefix("impl/browser/", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), contains("/api/", p), contains("/l1500_llm/", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), prefix("api/", p), contains("/l1500_llm/", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), contains("/api/", p), suffix("async_executor.py", p).
sync_delegation_exempt(f) :- sync_delegation_fn(f, p, nm), prefix("api/", p), suffix("async_executor.py", p).
