// data-layer-render-raw-strings, authored (decision 0043): all four clauses, which the converter leaves
// (semantic value, parse, arguments).
//
// literal, template, static: a str literal is the policy's kinds (`(?i)^[rub]*f` read on the string node's text)
// with `value_type_of(n, "str")`, and `value: {regex: (?s)^.{2}}` is `value(n, v)` searched, so W's decoder (its
// escapes, `\N{…}` names, refusals and MAX_STRING_BYTES cap) decides, exactly.
//
// fstring-literal: W's `parse: pythonFString` is `fstring_piece`: its literal children are W's, decoded by W
// (escapes, `\N{…}` names, refusals, the MAX_STRING_BYTES cap), so `value: {regex: (?s)^.{2}}` on one is `match`
// on its text, exactly. Only the capture's line is rebuilt here (fstring_piece has no position): a literal child
// is the run of literal text before an interpolation (or at the end), and its line is the run's first decoded
// character's.
//
// The source gate (`inside module` with `render|'|"|Template\(|SqlFragment\.static\(` on the module's text, or
// `(?s).*` with sourceGate off) is `literal_gate`, read from the run's options. oracleAnalyzer is in no clause.
.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl strprefix(n: node, s: symbol)
.decl node_text(n: node, s: symbol)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl fstring_piece(n: node, i: number, kind: symbol, v: symbol)
.decl option_on(name: symbol)
.decl line(n: node, l: number)
.decl end_line(n: node, l: number)
.decl tape_line(d: number, l: number, sp: span)
.decl token(p: node, i: number, s: symbol, start: number, end: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- shared by the clauses ----------------------------------------------------------------------------------
.decl literal_fdef(kind: symbol)
literal_fdef("function_definition").
.decl literal_raise(kind: symbol)
literal_raise("raise_statement").
literal_raise("assert_statement").
// A function named `^render(?:_|$)`.
.decl literal_render(f: node)
literal_render(f) :- node(_, f, "function_definition", _, _), field(f, "name", x), text(x, "render").
literal_render(f) :- node(_, f, "function_definition", _, _), field(f, "name", x), text(x, s), prefix("render_", s).
.decl literal_in_render(n: node)
literal_in_render(n) :- inside(n, f, literal_fdef), literal_render(f).
.decl literal_in_raise(n: node)
literal_in_raise(n) :- inside(n, _, literal_raise).
.decl literal_in_concat(n: node)
literal_in_concat(n) :- child(p, n, _), node(_, p, "concatenated_string", _, _).
// fstring-literal's line: a string part's prefix mode, "p" plain, "f" formatted, "rp" raw, "rf" raw formatted
// (W's decoder reads the prefix letters), and its string_content nodes.
.decl literal_mode(s: node, m: symbol)
literal_mode(s, "p") :- node(_, s, "string", _, _), strprefix(s, x), !contains("r", x), !contains("f", x).
literal_mode(s, "f") :- node(_, s, "string", _, _), strprefix(s, x), !contains("r", x), contains("f", x).
literal_mode(s, "rp") :- node(_, s, "string", _, _), strprefix(s, x), contains("r", x), !contains("f", x).
literal_mode(s, "rf") :- node(_, s, "string", _, _), strprefix(s, x), contains("r", x), contains("f", x).
.decl literal_content(s: node, c: node, m: symbol, t: symbol)
literal_content(s, c, m, t) :- literal_mode(s, m), child(s, c, _), node(_, c, "string_content", _, _), node_text(c, t).

// The policy's repeated kinds: `any [string not f, concatenated_string with no f part]`, not inside a
// concatenated_string; f is `(?i)^[rub]*f` on the string node's text.
.decl literal_fpart(s: node)
literal_fpart(s) :- node(_, s, "string", _, _), node_text(s, t), match("(?i)[rub]*f(?s:.*)", t).
.decl literal_fhas(n: node)
literal_fhas(n) :- node(_, n, "concatenated_string", _, _), child(n, s, _), literal_fpart(s).
.decl literal_kind(n: node)
literal_kind(n) :- node(_, n, "string", _, _), !literal_fpart(n), !literal_in_concat(n).
literal_kind(n) :- node(_, n, "concatenated_string", _, _), !literal_fhas(n), !literal_in_concat(n).
// A str literal (`value: {type: str}`).
.decl literal_str(n: node)
literal_str(n) :- literal_kind(n), value_type_of(n, "str").
// Its value has two characters or more (`value: {regex: (?s)^.{2}}`, W's search).
.decl literal_long(n: node)
literal_long(n) :- literal_str(n), value(n, v), match("(?s:.*)(?:(?s)^.{2})(?s:.*)", v).
// A part of a string or concatenation (fstring-literal's parse reads the parts).
.decl literal_part(n: node, s: node)
literal_part(n, n) :- node(_, n, "string", _, _), !literal_in_concat(n).
literal_part(n, s) :- node(_, n, "concatenated_string", _, _), !literal_in_concat(n), child(n, s, _), node(_, s, "string", _, _).
// The source gate: `inside module` whose text has `render|'|"|Template\(|SqlFragment\.static\(` (sourceGate on),
// or `(?s).*`, which every module's text matches (off).
.decl literal_gate(d: number)
literal_gate(d) :- doc(d, _, _), !option_on("sourceGate").
literal_gate(d) :- option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, t),
    match("(?s:.*)(?:render|\\x27|\\x22|Template\\(|SqlFragment\\.static\\()(?s:.*)", t).

// A call's first positional argument as `arguments` (mode syntactic, Ruff's find_argument) binds it: the first
// named argument that is no keyword and no `**`, unless a `*` comes first.
.decl literal_kwkind(kind: symbol)
literal_kwkind("keyword_argument").
literal_kwkind("dictionary_splat").
.decl literal_earlier(al: node, i: number)
literal_earlier(al, i) :- node(_, al, "argument_list", _, _), child(al, _, i), child(al, b, j), j < i, node(_, b, k, _, _), !literal_kwkind(k).
.decl literal_first_pos(al: node, a: node)
literal_first_pos(al, a) :- node(_, al, "argument_list", _, _), child(al, a, i), node(_, a, k, _, _), !literal_kwkind(k), k != "list_splat", k != "parenthesized_list_splat", !literal_earlier(al, i).
// `Template(…)` and `SqlFragment.static(…)`.
.decl literal_template_fn(f: node)
literal_template_fn(f) :- node(_, f, "identifier", _, _), text(f, "Template").
.decl literal_static_fn(f: node)
literal_static_fn(f) :- node(_, f, "attribute", _, _), field(f, "object", o), node(_, o, "identifier", _, _), text(o, "SqlFragment"),
    field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, "static").
.decl literal_special_fn(f: node)
literal_special_fn(f) :- literal_template_fn(f).
literal_special_fn(f) :- literal_static_fn(f).

// ---- literal ------------------------------------------------------------------------------------------------
// A docstring of an outermost render function: the first statement of its body block.
.decl literal_docstring(n: node)
literal_docstring(n) :- child(es, n, _), node(_, es, "expression_statement", _, _), child(b, es, 0), node(_, b, "block", _, _),
    child(f, b, _), literal_render(f), !literal_in_render(f).
// An argument of an allowed call (`str(…)`, `x.replace(…)`, …).
.decl literal_allowed_name(s: symbol)
literal_allowed_name("SqlAliasName"). literal_allowed_name("SqlColumnName"). literal_allowed_name("SqlIndexName").
literal_allowed_name("SqlIntegerLiteral"). literal_allowed_name("SqlQualifiedIdentifier"). literal_allowed_name("SqlQuotedIdentifier").
literal_allowed_name("SqlTableName"). literal_allowed_name("append"). literal_allowed_name("endswith"). literal_allowed_name("format").
literal_allowed_name("join"). literal_allowed_name("replace"). literal_allowed_name("repr"). literal_allowed_name("startswith").
literal_allowed_name("str").
.decl literal_allowed_fn(f: node)
literal_allowed_fn(f) :- node(_, f, "identifier", _, _), text(f, s), literal_allowed_name(s).
literal_allowed_fn(f) :- node(_, f, "attribute", _, _), field(f, "attribute", x), node(_, x, "identifier", _, _), text(x, s), literal_allowed_name(s).
.decl literal_allowed(n: node)
literal_allowed(n) :- child(al, n, _), node(_, al, "argument_list", _, _), child(c, al, _), node(_, c, "call", _, _), field(c, "function", f), literal_allowed_fn(f).
// The argument a Template/static call reports itself (its first positional, a str literal: `compare CURRENT eq
// FIRST` by node, the `has … pattern $ARG` holding at it).
.decl literal_special_arg(n: node)
literal_special_arg(n) :- child(al, n, _), node(_, al, "argument_list", _, _), child(c, al, _), node(_, c, "call", _, _),
    field(c, "function", f), literal_special_fn(f), literal_first_pos(al, n).
violation("data-layer-render-raw-strings", "literal", "string_literal", p, l) :-
    literal_long(n), literal_in_render(n), !literal_docstring(n), !literal_in_raise(n), !literal_allowed(n), !literal_special_arg(n),
    node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), literal_gate(d), doc(d, p, _), line(n, l).

// ---- fstring-literal ----------------------------------------------------------------------------------------
// The hosts parsed (`parse: pythonFString`): an f-string not in a concatenation, a concatenation with an f part,
// and a format_specifier; each in a render function and not in raise/assert. W's tree is fstring_piece's rows:
// none where W gets none (a bytes or template part, a literal W cannot decode, the MAX_STRING_BYTES cap).
.decl fstring_literal_host(n: node)
fstring_literal_host(n) :- node(_, n, "string", _, _), literal_fpart(n), !literal_in_concat(n).
fstring_literal_host(n) :- literal_fhas(n), !literal_in_concat(n).
fstring_literal_host(n) :- node(_, n, "format_specifier", _, _).
.decl fstring_literal_parsed(n: node)
fstring_literal_parsed(n) :- fstring_literal_host(n), fstring_piece(n, _, _, _), literal_in_render(n), !literal_in_raise(n).
// The host's replacement fields, in W's order (`fields`): a part's interpolations, a spec's format_expressions;
// (host, field, start, end).
.decl fstring_literal_field(n: node, f: node, b: number, e: number)
fstring_literal_field(n, f, b, e) :- fstring_literal_parsed(n), literal_part(n, s), child(s, f, _), node(_, f, "interpolation", b, e).
fstring_literal_field(n, f, b, e) :- fstring_literal_parsed(n), node(_, n, "format_specifier", _, _), child(n, f, _),
    node(_, f, "format_expression", b, e).
// A run of literal text is keyed by the start of the field that ends it, or the host's end. fstring_piece has
// one interpolation per field, in order, and a literal child per run that decodes to something: the j-th
// field's run is the literal right before the j-th interpolation, the last run a literal ending the tree.
.decl fstring_literal_ford(n: node, b: number, j: number)
fstring_literal_ford(n, b, j) :- fstring_literal_field(n, _, b, _), j = count : { fstring_literal_field(n, _, b2, _), b2 < b }.
.decl fstring_literal_pord(n: node, i: number, j: number)
fstring_literal_pord(n, i, j) :- fstring_literal_parsed(n), fstring_piece(n, i, "interpolation", _),
    j = count : { fstring_piece(n, i2, "interpolation", _), i2 < i }.
.decl fstring_literal_later_piece(n: node, i: number)
fstring_literal_later_piece(n, i) :- fstring_literal_parsed(n), fstring_piece(n, i, _, _), fstring_piece(n, i2, _, _), i2 > i.
// A run whose literal has two characters or more (`value: {regex: (?s)^.{2}}`, W's search).
.decl fstring_literal_long(n: node, k: number)
fstring_literal_long(n, b) :- fstring_literal_ford(n, b, j), fstring_literal_pord(n, i, j), fstring_piece(n, h, "literal", v), i = h + 1,
    match("(?s:.*)(?:(?s)^.{2})(?s:.*)", v).
fstring_literal_long(n, e) :- fstring_literal_parsed(n), node(_, n, _, _, e), fstring_piece(n, i, "literal", v), !fstring_literal_later_piece(n, i),
    match("(?s:.*)(?:(?s)^.{2})(?s:.*)", v).
// The pieces of source a run's text is decoded from, each one that decodes to something, at (host, first byte,
// line of its first decoded character): a part's string_content nodes, a debug field's text (`{x = }`'s `x = `,
// from after the `{`: its field's line), and a spec's raw slices between its fields.
.decl fstring_literal_item0(n: node, o: number, l: number)
// A content decodes to nothing when it is only `\<newline>` continuations (not raw). Its first decoded
// character's line is its first line's, or, for a content opening with continuations, the first later line of
// it that is not a lone `\` (the lines between are continuations).
.decl fstring_literal_empty(c: node)
fstring_literal_empty(c) :- literal_content(_, c, "p", t), match("(?:\\\\(?:\\r\\n|\\n|\\r))*", t).
fstring_literal_empty(c) :- literal_content(_, c, "f", t), match("(?:\\\\(?:\\r\\n|\\n|\\r))*", t).
.decl fstring_literal_content(n: node, c: node)
fstring_literal_content(n, c) :- fstring_literal_parsed(n), literal_part(n, s), literal_content(s, c, _, _), !fstring_literal_empty(c).
.decl fstring_literal_cont(c: node)
fstring_literal_cont(c) :- fstring_literal_content(_, c), literal_content(_, c, "p", t), match("\\\\(?:\\r\\n|\\n|\\r)(?s:.*)", t).
fstring_literal_cont(c) :- fstring_literal_content(_, c), literal_content(_, c, "f", t), match("\\\\(?:\\r\\n|\\n|\\r)(?s:.*)", t).
.decl fstring_literal_cnext(c: node, l: number)
fstring_literal_cnext(c, l) :- fstring_literal_cont(c), node(d, c, _, _, _), line(c, l0), end_line(c, le), tape_line(d, l, sp), l > l0, l <= le,
    text(sp, s), s != "\\".
.decl fstring_literal_cnext_later(c: node, l: number)
fstring_literal_cnext_later(c, l) :- fstring_literal_cnext(c, l), fstring_literal_cnext(c, k), k < l.
fstring_literal_item0(n, o, l) :- fstring_literal_content(n, c), !fstring_literal_cont(c), node(_, c, _, o, _), line(c, l).
fstring_literal_item0(n, o, l) :- fstring_literal_content(n, c), fstring_literal_cnext(c, l), !fstring_literal_cnext_later(c, l), node(_, c, _, o, _).
// Debug fields: an anonymous `=` child (W's `debug_end`).
.decl fstring_literal_debug(f: node)
fstring_literal_debug(f) :- node(_, f, "interpolation", _, _), token(f, _, "=", _, _).
fstring_literal_debug(f) :- node(_, f, "format_expression", _, _), token(f, _, "=", _, _).
fstring_literal_item0(n, o, l) :- fstring_literal_field(n, f, b, _), fstring_literal_debug(f), o = b + 1, line(f, l).
// A spec's slices: after its `:` (the spec's line) and after each field (the line of the field's `}`), each
// one holding a byte (no field starts it, the spec does not end there). Residual, blocked on a byte range's text
// (no relation gives the text of a spec's gap between tokens, where the lexer skips `\<newline>`): a non-raw
// slice opening with a `\<newline>` continuation, which decodes to nothing (only in a spec over several lines),
// is placed at the slice's own line, where W's first character is on a later one.
.decl fstring_literal_slice(n: node, a: number, l: number)
fstring_literal_slice(n, a, l) :- fstring_literal_parsed(n), node(_, n, "format_specifier", s, _), a = s + 1, line(n, l).
fstring_literal_slice(n, a, l) :- fstring_literal_parsed(n), node(_, n, "format_specifier", _, _), fstring_literal_field(n, f, _, a), end_line(f, l).
fstring_literal_item0(n, a, l) :- fstring_literal_slice(n, a, l), node(_, n, _, _, e), a < e, !fstring_literal_field(n, _, a, _).
// Each item's run: the first field ending after it, else the host's end.
.decl fstring_literal_after(n: node, o: number, b: number)
fstring_literal_after(n, o, b) :- fstring_literal_item0(n, o, _), fstring_literal_field(n, _, b, fe), fe > o.
.decl fstring_literal_not_next(n: node, o: number, b: number)
fstring_literal_not_next(n, o, b) :- fstring_literal_after(n, o, b), fstring_literal_after(n, o, b2), b2 < b.
.decl fstring_literal_item(n: node, k: number, o: number, l: number)
fstring_literal_item(n, k, o, l) :- fstring_literal_item0(n, o, l), fstring_literal_after(n, o, k), !fstring_literal_not_next(n, o, k).
fstring_literal_item(n, e, o, l) :- fstring_literal_item0(n, o, l), !fstring_literal_after(n, o, _), node(_, n, _, _, e).
// A long run is a PART, reported at its first item's line.
.decl fstring_literal_not_first(n: node, k: number, o: number)
fstring_literal_not_first(n, k, o) :- fstring_literal_item(n, k, o, _), fstring_literal_item(n, k, o2, _), o2 < o.
.decl fstring_literal_at(n: node, l: number)
fstring_literal_at(n, l) :- fstring_literal_long(n, k), fstring_literal_item(n, k, o, l), !fstring_literal_not_first(n, k, o).
violation("data-layer-render-raw-strings", "fstring-literal", "string_literal", p, l) :-
    fstring_literal_at(n, l), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), literal_gate(d), doc(d, p, _).

// ---- template, static ---------------------------------------------------------------------------------------
// A Template(…) / SqlFragment.static(…) call in a render function whose first positional argument is a str
// literal.
.decl template_call(c: node, f: node)
template_call(c, f) :- node(_, c, "call", _, _), field(c, "function", f), field(c, "arguments", al), literal_first_pos(al, a), literal_str(a), literal_in_render(c).
violation("data-layer-render-raw-strings", "template", "template_call", p, l) :-
    template_call(c, f), literal_template_fn(f), node(d, c, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), literal_gate(d), doc(d, p, _), line(c, l).
violation("data-layer-render-raw-strings", "static", "static_call", p, l) :-
    template_call(c, f), literal_static_fn(f), node(d, c, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), literal_gate(d), doc(d, p, _), line(c, l).
