// data-layer-bounded-composed-graph-paths: the 93 text contracts (relational SQL stages over source_text), by hand.
// One family per query shape; each clause's comment names its finding.
//
// The SQL reads N = source_text(path) with CR LF and lone CR made LF (NULL where the file is absent) and runs Rust
// `regex` over it. Here a file is present when an in-scope document has its path (the .rst and .md ones are
// text-only documents). Whole-text tests read `source`'s span, raw: the regexes they run (`(?m)^` written as
// `(?:\A|[\r\n])`, `\s` taking \r as it takes \n) and the needles they look for give the same answer on the raw
// text as on N. Every other test reads N's lines, which are exactly `tape_line`'s (split at \r\n, \r and \n, the
// empty line after a final terminator included, so N is the lines joined with \n; terminators left out), and gives
// each regex its multi-line reading line by line:
// - a `\s*` may run over line breaks: `_nb_next(p, j, j2)` is the first non-blank line j2 after j (the lines between
//   all whitespace), `_ne_next` the first non-empty one; a `\s*` from the end of line j to the next token is a step
//   along them;
// - a class block (the SQL's `rx_extract(... '^class C…:.*') || rx_extract(rest, '\A(.*?)(?:^(?:class |def |async
//   def )|\z)')`) is the header line h through the line before the next line starting `class `, `def ` or `async def
//   `, or through the end of the file; the header's greedy match is W's (match_group on line h), and when the text
//   after it starts with one of those words the block is the header alone (`^` matches at the start of that text);
//   the same for the method block of text-contract-47 with `    @`, `    def `, `    async def `.
// Positions are tied to lines only: every regex here that crosses a line break does it in a `\s` run.

.decl in_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- files: present, whole text, N's lines -------------------------------------------------------------------
.decl text_contract_anchor(k: symbol)
.decl text_contract_present(p: symbol)
text_contract_present(p) :- doc(d, p, _), in_scope(d).
.decl text_contract_src(p: symbol, t: symbol)
text_contract_src(p, t) :- doc(d, p, _), in_scope(d), source(d, sp), text(sp, t).
.decl text_contract_span(p: symbol, l: number, sp: span)
text_contract_span(p, l, sp) :- doc(d, p, _), in_scope(d), tape_line(d, l, sp).
.decl text_contract_line(p: symbol, l: number, u: symbol)
text_contract_line(p, l, u) :- text_contract_span(p, l, sp), text(sp, u).
// next(p, l, j): line j follows line l (the recursions below step along it, creating no values).
.decl text_contract_next(p: symbol, l: number, j: number)
text_contract_next(p, l, j) :- text_contract_line(p, l, _), j = l + 1, text_contract_line(p, j, _).
// A blank line is all `\s` (or empty); an empty one has no characters.
.decl text_contract_blank(p: symbol, l: number)
text_contract_blank(p, l) :- text_contract_line(p, l, u), match("\\s*", u).
.decl text_contract_empty(p: symbol, l: number)
text_contract_empty(p, l) :- text_contract_line(p, l, "").
.decl text_contract_nb_next(p: symbol, j: number, j2: number)
text_contract_nb_next(p, j, j1) :- text_contract_next(p, j, j1), !text_contract_blank(p, j1).
text_contract_nb_next(p, j, j2) :- text_contract_next(p, j, j1), text_contract_blank(p, j1), text_contract_nb_next(p, j1, j2).
.decl text_contract_ne_next(p: symbol, j: number, j2: number)
text_contract_ne_next(p, j, j1) :- text_contract_next(p, j, j1), !text_contract_empty(p, j1).
text_contract_ne_next(p, j, j2) :- text_contract_next(p, j, j1), text_contract_empty(p, j1), text_contract_ne_next(p, j1, j2).
// paren(p, j, j2): from the end of line j, `\s*\(` reaches the `(` that starts line j2's text after its blanks.
.decl text_contract_paren(p: symbol, j: number, j2: number)
text_contract_paren(p, j, j2) :- text_contract_nb_next(p, j, j2), text_contract_line(p, j2, u), match("\\s*\\(.*", u).

// ---- defgone: rx_matches(N, '(?m)^\s*(?:async )?def NAME\s*\(') at its first match's line ----------------------
// The match starts at a line start and `\s*` runs over line breaks, so it starts at the first of the blank lines just
// above the line holding `def NAME` (that line itself when the line above is not blank), and its `\s*\(` may find
// the `(` on a later line.
.decl text_contract_defspec(k: symbol, p: symbol, name: symbol)
.decl text_contract_def(k: symbol, p: symbol, l: number)
text_contract_def(k, p, l) :- text_contract_defspec(k, p, nm), text_contract_line(p, l, u), x = cat("\\s*(?:async )?def ", cat(nm, "\\s*\\(.*")), match(x, u).
text_contract_def(k, p, l) :- text_contract_defspec(k, p, nm), text_contract_line(p, l, u), x = cat("\\s*(?:async )?def ", cat(nm, "\\s*")), match(x, u), text_contract_paren(p, l, _).
.decl text_contract_def_back(k: symbol, p: symbol, l: number)
text_contract_def_back(k, p, l) :- text_contract_def(k, p, l).
text_contract_def_back(k, p, j) :- text_contract_def_back(k, p, l), text_contract_next(p, j, l), text_contract_blank(p, j).
.decl text_contract_def_first(k: symbol, p: symbol, l: number)
text_contract_def_first(k, p, l) :- text_contract_def_back(k, p, _), l = min x : { text_contract_def_back(k, p, x) }.

// ---- word: rx_matches(N, '\bNAME\b') at its first match's line ----------------------------------------------
.decl text_contract_wordspec(k: symbol, p: symbol, name: symbol)
.decl text_contract_word(k: symbol, p: symbol, l: number)
text_contract_word(k, p, l) :- text_contract_wordspec(k, p, nm), text_contract_line(p, l, u), x = cat(".*\\b", cat(nm, "\\b.*")), match(x, u).
.decl text_contract_word_first(k: symbol, p: symbol, l: number)
text_contract_word_first(k, p, l) :- text_contract_word(k, p, _), l = min x : { text_contract_word(k, p, x) }.

// ---- classes: the SQL's class block ------------------------------------------------------------------------------
.decl text_contract_clsspec(p: symbol, c: symbol)
.decl text_contract_hdr(p: symbol, c: symbol, l: number)
text_contract_hdr(p, c, l) :- text_contract_clsspec(p, c), text_contract_line(p, l, u), x = cat("class ", cat(c, "(?:\\[.*\\])?(?:\\(.*\\))?:.*")), match(x, u).
.decl text_contract_cls(p: symbol, c: symbol, l: number)
text_contract_cls(p, c, l) :- text_contract_hdr(p, c, _), l = min x : { text_contract_hdr(p, c, x) }.
.decl text_contract_has_cls(p: symbol, c: symbol)
text_contract_has_cls(p, c) :- text_contract_cls(p, c, _).
// The header's own match (`\A(class C(?:\[[^\n]*\])?(?:\([^\n]*\))?:)`, greedy): the text after it on line h is the
// group `rest` (a class name is a whole identifier: `class C` is followed by `[`, `(` or `:`).
.decl text_contract_cquirk(p: symbol, c: symbol)
text_contract_cquirk(p, c) :- text_contract_cls(p, c, h), text_contract_span(p, h, sp), match_group("\\Aclass (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?(?:\\([^\\n]*\\))?:(?P<rest>.*)\\z", sp, m, "n", gn), text(gn, c), match_group("\\Aclass (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?(?:\\([^\\n]*\\))?:(?P<rest>.*)\\z", sp, m, "rest", gr), text(gr, r), match("(?:class |def |async def ).*", r).
.decl text_contract_top(p: symbol, l: number)
text_contract_top(p, l) :- text_contract_line(p, l, u), match("(?:class |def |async def ).*", u).
.decl text_contract_cafter(p: symbol, c: symbol, l: number)
text_contract_cafter(p, c, t) :- text_contract_cls(p, c, l0), text_contract_top(p, t), t > l0.
.decl text_contract_cend(p: symbol, c: symbol, l: number)
text_contract_cend(p, c, e) :- text_contract_cafter(p, c, _), e = min x : { text_contract_cafter(p, c, x) }.
.decl text_contract_cended(p: symbol, c: symbol)
text_contract_cended(p, c) :- text_contract_cend(p, c, _).
// cin: the block's lines after the header line (no regex read in a block can match the header line: each starts
// with four spaces).
.decl text_contract_cin(p: symbol, c: symbol, l: number, u: symbol)
text_contract_cin(p, c, l, u) :- text_contract_cls(p, c, l0), !text_contract_cquirk(p, c), text_contract_line(p, l, u), l > l0, text_contract_cend(p, c, e), l < e.
text_contract_cin(p, c, l, u) :- text_contract_cls(p, c, l0), !text_contract_cquirk(p, c), text_contract_line(p, l, u), l > l0, !text_contract_cended(p, c).

// ---- a method in a class block: '(?m)^    (?:async )?def NAME(?:\[[^\n]*\])?\s*\(' ----------------------------
.decl text_contract_cmspec(k: symbol, p: symbol, c: symbol, name: symbol)
.decl text_contract_cdef(k: symbol, l: number)
text_contract_cdef(k, l) :- text_contract_cmspec(k, p, c, nm), text_contract_cin(p, c, l, u), x = cat("    (?:async )?def ", cat(nm, "(?:\\[.*\\])?\\s*\\(.*")), match(x, u).
text_contract_cdef(k, l) :- text_contract_cmspec(k, p, c, nm), text_contract_cin(p, c, l, u), x = cat("    (?:async )?def ", cat(nm, "(?:\\[.*\\])?\\s*")), match(x, u), text_contract_paren(p, l, j), text_contract_cin(p, c, j, _).
.decl text_contract_cmok(k: symbol)
text_contract_cmok(k) :- text_contract_cdef(k, _).

// ---- deco: the class block matches '(?m)^    @DECO(?:\([^\n]*\))?\n(?:    @[^\n]+\n)*' and then the method ----------
.decl text_contract_decospec(k: symbol, deco: symbol)
.decl text_contract_deco(k: symbol, l: number)
text_contract_deco(k, l) :- text_contract_decospec(k, dc), text_contract_cmspec(k, p, c, _), text_contract_cin(p, c, l, u), x = cat("    @", cat(dc, "(?:\\(.*\\))?")), match(x, u).
.decl text_contract_dchain(k: symbol, l: number)
text_contract_dchain(k, j) :- text_contract_deco(k, l), text_contract_cmspec(k, p, c, _), text_contract_next(p, l, j), text_contract_cin(p, c, j, _).
text_contract_dchain(k, j) :- text_contract_dchain(k, l), text_contract_cmspec(k, p, c, _), text_contract_cin(p, c, l, u), match("    @.+", u), text_contract_next(p, l, j), text_contract_cin(p, c, j, _).
.decl text_contract_dok(k: symbol)
text_contract_dok(k) :- text_contract_dchain(k, l), text_contract_cdef(k, l).

// ---- fields in a class block: '(?m)^    FIELD\s*:\s*([^\n=]+)(?:\s*=\s*([^\n]+))?' -------------------------------
.decl text_contract_fspec(k: symbol, p: symbol, c: symbol, f: symbol)
// colon(k, a, b, pre): the match from line a has its `:` on line b, and `pre` matches line b through it.
.decl text_contract_fcolon(k: symbol, a: number, b: number, pre: symbol)
text_contract_fcolon(k, a, a, x) :- text_contract_fspec(k, p, c, f), text_contract_cin(p, c, a, u), x = cat("    ", cat(f, "\\s*:")), y = cat(x, ".*"), match(y, u).
text_contract_fcolon(k, a, j, "\\s*:") :- text_contract_fspec(k, p, c, f), text_contract_cin(p, c, a, u), x = cat("    ", cat(f, "\\s*")), match(x, u), text_contract_nb_next(p, a, j), text_contract_cin(p, c, j, w), match("\\s*:.*", w).
// ok(k, a): the match from line a exists: some `\s*` prefix after the colon is followed by a character that is no
// line break and no `=`; that is, the first character after the colon that is no line break is not `=`.
.decl text_contract_fok(k: symbol, a: number)
text_contract_fok(k, a) :- text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = cat(pre, "[^=].*"), match(x, u).
text_contract_fok(k, a) :- text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), match(pre, u), text_contract_ne_next(p, b, j), text_contract_cin(p, c, j, w), match("[^=].*", w).
.decl text_contract_fld(k: symbol)
text_contract_fld(k) :- text_contract_fok(k, _).
// The groups are the first match's (rx_extract): a0 its line.
.decl text_contract_ffirst(k: symbol, a: number)
text_contract_ffirst(k, a) :- text_contract_fok(k, _), a = min x : { text_contract_fok(k, x) }.
// fx(k, j, xp): the first character after the colon that is no `\s` is on line j, `xp` matching line j before it.
.decl text_contract_fx(k: symbol, j: number, xp: symbol)
text_contract_fx(k, b, x) :- text_contract_ffirst(k, a), text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = cat(pre, "\\s*"), y = cat(x, "\\S.*"), match(y, u).
text_contract_fx(k, j, "\\s*") :- text_contract_ffirst(k, a), text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = cat(pre, "\\s*"), match(x, u), text_contract_nb_next(p, b, j), text_contract_cin(p, c, j, _).
// Group 1 holds `None`: when that character is not `=`, group 1 runs from it to the next `=` or line break (when it
// is `=`, the `\s*` gives back a blank and group 1 is blanks).
.decl text_contract_g1none(k: symbol)
text_contract_g1none(k) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(xp, "[^=]*None.*"), match(x, u).
// fq(k, j, qp): the `=` before group 2 is on line j, `qp` matching line j through it: the first `=` of group 1's
// line after it, or, when that line has none, the first character after the line that is no `\s`, when it is `=`;
// when the character itself is `=`, it.
.decl text_contract_fq(k: symbol, j: number, qp: symbol)
text_contract_fq(k, j, x) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(xp, "[^=\\s][^=]*="), y = cat(x, ".*"), match(y, u).
text_contract_fq(k, j3, "\\s*=") :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(xp, "[^=\\s][^=]*"), match(x, u), text_contract_nb_next(p, j, j3), text_contract_cin(p, c, j3, w), match("\\s*=.*", w).
text_contract_fq(k, j, x) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(xp, "="), y = cat(x, ".*"), match(y, u).
// Group 2 is '^[\s\x1c-\x1f]*None[\s\x1c-\x1f]*$': it runs from the first character after that `=` that is no `\s`
// to its line's end (blanks before it are the pattern's own).
.decl text_contract_g2none(k: symbol)
text_contract_g2none(k) :- text_contract_fq(k, j, qp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(qp, "[\\s\\x1c-\\x1f]*None[\\s\\x1c-\\x1f]*"), match(x, u).
text_contract_g2none(k) :- text_contract_fq(k, j, qp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(qp, "\\s*"), match(x, u), text_contract_nb_next(p, j, j2), text_contract_cin(p, c, j2, w), match("[\\s\\x1c-\\x1f]*None[\\s\\x1c-\\x1f]*", w).

// ---- methods: the SQL's method block (text-contract-46, 47) ------------------------------------------------------
// '(?ms)(^    (?:async )?def NAME(?:\[[^\n]*\])?\s*\(.*)' from the file's first such line m0, the `(` on m0 or, through a
// blank run, on a later line (`mcross`: greedy, the bracket's `[^\n]*` takes the line's last `]`, so a line ending in
// `]` or the name and blanks crosses when it can); through the line before the next line starting `    @`,
// `    def ` or `    async def `, or the end of the file.
.decl text_contract_mspec(k: symbol, p: symbol, name: symbol)
.decl text_contract_mcross(k: symbol, a: number, j: number)
text_contract_mcross(k, a, j) :- text_contract_mspec(k, p, nm), text_contract_line(p, a, u), x = cat("    (?:async )?def ", cat(nm, "(?:\\[.*\\])?\\s*")), match(x, u), text_contract_paren(p, a, j).
.decl text_contract_mhdr(k: symbol, a: number)
text_contract_mhdr(k, a) :- text_contract_mspec(k, p, nm), text_contract_line(p, a, u), x = cat("    (?:async )?def ", cat(nm, "(?:\\[.*\\])?\\s*\\(.*")), match(x, u).
text_contract_mhdr(k, a) :- text_contract_mcross(k, a, _).
.decl text_contract_has_m(k: symbol)
text_contract_has_m(k) :- text_contract_mhdr(k, _).
.decl text_contract_m0(k: symbol, a: number)
text_contract_m0(k, a) :- text_contract_mhdr(k, _), a = min x : { text_contract_mhdr(k, x) }.
// The block is the header alone when the text after its `(` starts `    @`, `    def ` or `    async def `.
.decl text_contract_mquirk(k: symbol)
text_contract_mquirk(k) :- text_contract_m0(k, a), text_contract_mcross(k, a, j), text_contract_mspec(k, p, _), text_contract_line(p, j, u), match("\\s*\\((?:    @|    (?:async )?def ).*", u).
text_contract_mquirk(k) :- text_contract_m0(k, a), !text_contract_mcross(k, a, _), text_contract_mspec(k, p, _), text_contract_span(p, a, sp), match_group("\\A(?P<head>    (?:async )?def (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?\\s*\\()(?P<rest>.*)\\z", sp, m, "rest", gr), text(gr, r), match("(?:    @|    (?:async )?def ).*", r).
.decl text_contract_mtop(p: symbol, l: number)
text_contract_mtop(p, l) :- text_contract_line(p, l, u), match("    (?:@|(?:async )?def ).*", u).
.decl text_contract_mafter(k: symbol, l: number)
text_contract_mafter(k, t) :- text_contract_m0(k, l0), text_contract_mspec(k, p, _), text_contract_mtop(p, t), t > l0.
.decl text_contract_mend(k: symbol, l: number)
text_contract_mend(k, e) :- text_contract_mafter(k, _), e = min x : { text_contract_mafter(k, x) }.
.decl text_contract_mended(k: symbol)
text_contract_mended(k) :- text_contract_mend(k, _).
.decl text_contract_min(k: symbol, l: number, u: symbol)
text_contract_min(k, l, u) :- text_contract_m0(k, l0), !text_contract_mquirk(k), text_contract_mspec(k, p, _), text_contract_line(p, l, u), l >= l0, text_contract_mend(k, e), l < e.
text_contract_min(k, l, u) :- text_contract_m0(k, l0), !text_contract_mquirk(k), text_contract_mspec(k, p, _), text_contract_line(p, l, u), l >= l0, !text_contract_mended(k).
// The header alone: line m0 through its `(` (a crossing header's other lines are blanks and `(`).
.decl text_contract_mhead(k: symbol, s: symbol)
text_contract_mhead(k, u) :- text_contract_mquirk(k), text_contract_m0(k, a), text_contract_mcross(k, a, _), text_contract_mspec(k, p, _), text_contract_line(p, a, u).
text_contract_mhead(k, h) :- text_contract_mquirk(k), text_contract_m0(k, a), !text_contract_mcross(k, a, _), text_contract_mspec(k, p, _), text_contract_span(p, a, sp), match_group("\\A(?P<head>    (?:async )?def (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?\\s*\\()(?P<rest>.*)\\z", sp, m, "head", gh), text(gh, h).
.decl text_contract_mok(k: symbol)

// ---- all-present: every regex matches the whole text ------------------------------------------------------------
.decl text_contract_all(k: symbol)

// ---- facts -------------------------------------------------------------------------------------------------------
text_contract_anchor("text-contract-0").
text_contract_defspec("text-contract-1", "l7200_versioned_transactions/versioned_lazy_mixin.py", "graph_query_builder").
text_contract_defspec("text-contract-2", "l7200_versioned_transactions/versioned_lazy_mixin.py", "graph_query_builder_async").
text_contract_defspec("text-contract-3", "l7200_versioned_transactions/versioned_lazy_mixin.py", "graph_query_builder_lazy").
text_contract_defspec("text-contract-4", "l7200_versioned_transactions/versioned_lazy_mixin.py", "graph_traverse").
text_contract_defspec("text-contract-5", "l7200_versioned_transactions/versioned_lazy_mixin.py", "graph_traverse_async").
text_contract_defspec("text-contract-6", "l7200_versioned_transactions/versioned_lazy_mixin.py", "graph_traverse_lazy").
text_contract_anchor("text-contract-7").
text_contract_defspec("text-contract-8", "l7200_versioned_transactions/versioned_transactions.py", "graph_query_builder").
text_contract_defspec("text-contract-9", "l7200_versioned_transactions/versioned_transactions.py", "graph_query_builder_async").
text_contract_defspec("text-contract-10", "l7200_versioned_transactions/versioned_transactions.py", "graph_query_builder_lazy").
text_contract_defspec("text-contract-11", "l7200_versioned_transactions/versioned_transactions.py", "graph_traverse").
text_contract_defspec("text-contract-12", "l7200_versioned_transactions/versioned_transactions.py", "graph_traverse_async").
text_contract_defspec("text-contract-13", "l7200_versioned_transactions/versioned_transactions.py", "graph_traverse_lazy").
text_contract_anchor("text-contract-14").
text_contract_anchor("text-contract-15").
text_contract_cmspec("text-contract-15", "l7200_versioned_transactions/versioned_lazy_mixin.py", "VersionedReadTransactionLazyMixin", "graph_lazy").
text_contract_decospec("text-contract-15", "pure_lazy").
text_contract_anchor("text-contract-16").
text_contract_anchor("text-contract-17").
text_contract_cmspec("text-contract-17", "l7200_versioned_transactions/versioned_transactions.py", "LazyVersionedReadTransaction", "graph").
text_contract_decospec("text-contract-17", "legacy_sync").
text_contract_anchor("text-contract-18").
text_contract_cmspec("text-contract-18", "l7200_versioned_transactions/versioned_transactions.py", "LazyVersionedReadTransaction", "graph_async").
text_contract_decospec("text-contract-18", "legacy_async").
text_contract_anchor("text-contract-19").
text_contract_fspec("text-contract-29", "l9700_graph_query/graph_pattern.py", "PathPattern", "expression").
text_contract_fspec("text-contract-30", "l9700_graph_query/graph_pattern.py", "PathPattern", "edge").
