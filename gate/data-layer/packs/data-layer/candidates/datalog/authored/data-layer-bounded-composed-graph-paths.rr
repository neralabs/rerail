// data-layer-bounded-composed-graph-paths: the 93 text contracts (relational SQL stages over source_text), by hand.
// Generated from the policy's queries, one family per query shape; each clause's comment names its finding.
//
// The SQL reads source_text(path) with CR LF and lone CR made LF: NULL where the file is absent. Here a file is
// present when an in-scope document has its path, and its text is `source`'s span; the per-line forms read
// `src_line` (terminators dropped, so CR LF needs no normalising).
//
// Approximations (each named where it applies):
// - A1 lines: SQL counts lines at LF; src_line splits Python as str.splitlines, which also breaks at \v, \f,
//   \x1c-\x1e, \x85, \u2028, \u2029. A file holding those reports later lines here.
// - A2 per-line regexes: W's `\s*` in `def NAME\s*\(`, `FIELD\s*:\s*`, `class …` may run across a line break
//   (`def f` at a line's end, `(` on the next; `x:` alone on its line). Python allows neither outside strings and
//   brackets; here each such regex is read within one line.
// The clauses on docs/*.rst and docs/design/*.md (text-contract-81 … 89) are in
// data-layer-bounded-composed-graph-paths.pending.rr: they read text-only documents (doc + source, no tree), and
// the corpus runner loads .py and .rs only today, so those files would read as absent.
// `source` and `src_line` are core.rr's (docs/rule-syntax/lib/core.rr), bound by the corpus runner.

.decl doc(d: number, path: symbol, module: symbol)
.decl in_scope(d: number)
.decl source(d: number, sp: span)
.decl src_line(d: number, l: number, sp: span)
.decl text(n: loc, s: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input source, src_line
.output violation

// ---- files: present, whole text, lines ------------------------------------------------------------------------
.decl text_contract_anchor(k: symbol)
.decl text_contract_present(p: symbol)
text_contract_present(p) :- doc(d, p, _), in_scope(d).
.decl text_contract_src(p: symbol, t: symbol)
text_contract_src(p, t) :- doc(d, p, _), in_scope(d), source(d, sp), text(sp, t).
.decl text_contract_line(p: symbol, l: number, u: symbol)
text_contract_line(p, l, u) :- doc(d, p, _), in_scope(d), src_line(d, l, sp), text(sp, u).
// next(p, l, j): line j follows line l (the recursions below step along it, creating no values).
.decl text_contract_next(p: symbol, l: number, j: number)
text_contract_next(p, l, j) :- text_contract_line(p, l, _), j = l + 1, text_contract_line(p, j, _).

// ---- defgone: rx_matches(src, '(?m)^\s*(?:async )?def NAME\s*\(') at its first match's line -------------------
// The match starts at a line start and `\s*` runs over newlines, so it starts at the first of the whitespace-only
// lines just above the first def line (the def line itself when the line above is not blank).
.decl text_contract_def(k: symbol, p: symbol, l: number)
.decl text_contract_ws(p: symbol, l: number)
text_contract_ws(p, l) :- text_contract_line(p, l, u), match("\\s*", u).
.decl text_contract_def_back(k: symbol, p: symbol, l: number)
text_contract_def_back(k, p, l) :- text_contract_def(k, p, l).
text_contract_def_back(k, p, j) :- text_contract_def_back(k, p, l), text_contract_next(p, j, l), text_contract_ws(p, j).
.decl text_contract_def_first(k: symbol, p: symbol, l: number)
text_contract_def_first(k, p, l) :- text_contract_def_back(k, p, _), l = min x : { text_contract_def_back(k, p, x) }.

// ---- word: rx_matches(src, '\bNAME\b') at its first match's line --------------------------------------------
.decl text_contract_word(k: symbol, p: symbol, l: number)
.decl text_contract_word_first(k: symbol, p: symbol, l: number)
text_contract_word_first(k, p, l) :- text_contract_word(k, p, _), l = min x : { text_contract_word(k, p, x) }.

// ---- classes: the SQL's class block --------------------------------------------------------------------------
// The first line `class C[…](…):…`, through the line before the next line starting `class `, `def ` or
// `async def ` (decorators and other top-level statements do not end it), or the end of the file.
.decl text_contract_hdr(p: symbol, c: symbol, l: number)
.decl text_contract_cls(p: symbol, c: symbol, l: number)
text_contract_cls(p, c, l) :- text_contract_hdr(p, c, _), l = min x : { text_contract_hdr(p, c, x) }.
.decl text_contract_has_cls(p: symbol, c: symbol)
text_contract_has_cls(p, c) :- text_contract_cls(p, c, _).
.decl text_contract_top(p: symbol, l: number)
text_contract_top(p, l) :- text_contract_line(p, l, u), match("(?:class |def |async def ).*", u).
.decl text_contract_cafter(p: symbol, c: symbol, l: number)
text_contract_cafter(p, c, t) :- text_contract_cls(p, c, l0), text_contract_top(p, t), t > l0.
.decl text_contract_cend(p: symbol, c: symbol, l: number)
text_contract_cend(p, c, e) :- text_contract_cafter(p, c, _), e = min x : { text_contract_cafter(p, c, x) }.
.decl text_contract_cended(p: symbol, c: symbol)
text_contract_cended(p, c) :- text_contract_cend(p, c, _).
.decl text_contract_cin(p: symbol, c: symbol, l: number, u: symbol)
text_contract_cin(p, c, l, u) :- text_contract_cls(p, c, l0), text_contract_line(p, l, u), l >= l0, text_contract_cend(p, c, e), l < e.
text_contract_cin(p, c, l, u) :- text_contract_cls(p, c, l0), text_contract_line(p, l, u), l >= l0, !text_contract_cended(p, c).

// ---- deco: the class block matches '(?m)^    @DECO(…)?\n(?:    @…\n)*    (?:async )?def NAME[…]\s*\(' --------
.decl text_contract_kcls(k: symbol, p: symbol, c: symbol)
.decl text_contract_deco(k: symbol, p: symbol, l: number)
.decl text_contract_dfn(k: symbol, p: symbol, l: number)
.decl text_contract_dchain(k: symbol, p: symbol, l: number)
text_contract_dchain(k, p, j) :- text_contract_deco(k, p, l), text_contract_next(p, l, j).
text_contract_dchain(k, p, j) :- text_contract_dchain(k, p, l), text_contract_kcls(k, p, c), text_contract_cin(p, c, l, u), match("    @.+", u), text_contract_next(p, l, j).
.decl text_contract_dok(k: symbol)
text_contract_dok(k) :- text_contract_dchain(k, p, l), text_contract_dfn(k, p, l).

// ---- field / method in a class block: some line matches -----------------------------------------------------
// '(?m)^    FIELD\s*:\s*([^\n=]+)…' matches a line `    FIELD:` whose next character is there and is not `=`.
.decl text_contract_fld(k: symbol)
// The first such line (rx_extract's groups are the first match's).
.decl text_contract_fln(k: symbol, l: number, u: symbol)
.decl text_contract_fln_first(k: symbol, l: number)
text_contract_fln_first(k, l) :- text_contract_fln(k, _, _), l = min x : { text_contract_fln(k, x, _) }.

// ---- methods: the SQL's method block ----------------------------------------------------------------------------
// The first line `    (async )?def NAME[…](`, through the line before the next line starting `    @`, `    def ` or
// `    async def `, or the end of the file.
.decl text_contract_mhdr(k: symbol, p: symbol, l: number)
.decl text_contract_has_m(k: symbol)
text_contract_has_m(k) :- text_contract_mhdr(k, _, _).
.decl text_contract_m0(k: symbol, p: symbol, l: number)
text_contract_m0(k, p, l) :- text_contract_mhdr(k, p, _), l = min x : { text_contract_mhdr(k, p, x) }.
.decl text_contract_mtop(p: symbol, l: number)
text_contract_mtop(p, l) :- text_contract_line(p, l, u), match("    (?:@|(?:async )?def ).*", u).
.decl text_contract_mafter(k: symbol, p: symbol, l: number)
text_contract_mafter(k, p, t) :- text_contract_m0(k, p, l0), text_contract_mtop(p, t), t > l0.
.decl text_contract_mend(k: symbol, p: symbol, l: number)
text_contract_mend(k, p, e) :- text_contract_mafter(k, p, _), e = min x : { text_contract_mafter(k, p, x) }.
.decl text_contract_mended(k: symbol, p: symbol)
text_contract_mended(k, p) :- text_contract_mend(k, p, _).
.decl text_contract_min(k: symbol, p: symbol, l: number, u: symbol)
text_contract_min(k, p, l, u) :- text_contract_m0(k, p, l0), text_contract_line(p, l, u), l >= l0, text_contract_mend(k, p, e), l < e.
text_contract_min(k, p, l, u) :- text_contract_m0(k, p, l0), text_contract_line(p, l, u), l >= l0, !text_contract_mended(k, p).
.decl text_contract_mok(k: symbol)

// ---- all-present: every regex matches the whole text ------------------------------------------------------------
.decl text_contract_all(k: symbol)

// ---- facts -------------------------------------------------------------------------------------------------------
text_contract_anchor("text-contract-0").
