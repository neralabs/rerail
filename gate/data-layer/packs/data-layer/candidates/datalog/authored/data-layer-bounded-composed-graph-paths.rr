text_contract_has_m(k) :- text_contract_mhdr(k, _).
.decl text_contract_m0(k: symbol, a: number)
text_contract_m0(k, a) :- text_contract_mhdr(k, _), a = min x : { text_contract_mhdr(k, x) }.
