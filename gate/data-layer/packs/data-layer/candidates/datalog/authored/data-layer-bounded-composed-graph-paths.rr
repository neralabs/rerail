.decl text_contract_g2none(k: symbol)
text_contract_g2none(k) :- text_contract_fq(k, j, qp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(qp, "[\\s\\x1c-\\x1f]*None[\\s\\x1c-\\x1f]*"), match(x, u).
text_contract_g2none(k) :- text_contract_fq(k, j, qp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(qp, "[\\s\\x1c-\\x1f]*"), match(x, u), text_contract_nb_next(p, j, j2), text_contract_cin(p, c, j2, w), match("[\\s\\x1c-\\x1f]*None[\\s\\x1c-\\x1f]*", w).

