text_contract_mhdr(k, a) :- text_contract_mspec(k, p, nm), text_contract_line(p, a, u), x = cat("    (?:async )?def ", cat(nm, "(?:\\[.*\\])?[\\s\\x1c-\\x1f]*\\(.*")), match(x, u).
text_contract_mhdr(k, a) :- text_contract_mcross(k, a, _).
