.decl text_contract_mquirk(k: symbol)
text_contract_mquirk(k) :- text_contract_m0(k, a), text_contract_mcross(k, a, j), text_contract_mspec(k, p, _), text_contract_line(p, j, u), match("[\\s\\x1c-\\x1f]*\\((?:    @|    (?:async )?def ).*", u).
text_contract_mquirk(k) :- text_contract_m0(k, a), !text_contract_mcross(k, a, _), text_contract_mspec(k, p, _), text_contract_span(p, a, sp), match_group("\\A(?P<head>    (?:async )?def (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?[\\s\\x1c-\\x1f]*\\()(?P<rest>.*)\\z", sp, m, "rest", gr), text(gr, r), match("(?:    @|    (?:async )?def ).*", r).
