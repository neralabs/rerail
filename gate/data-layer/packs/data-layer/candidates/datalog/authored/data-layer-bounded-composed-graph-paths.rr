a78b-\ua7ca\ua7d0-\ua7d1\ua7d3\ua7d5-\ua7d9\ua7f2-\ua801\ua803-\ua805\ua807-\ua80a\ua80c-\ua822\ua830-\ua835\ua840-\ua873\ua882-\ua8b3\ua8d0-\ua8d9\ua8f2-\ua8f7\ua8fb\ua8fd-\ua8fe\ua900-\ua925\ua930-\ua946\ua960-\ua97c\ua984-\ua9b2\ua9cf-\ua9d9\ua9e0-\ua9e4\ua9e6-\ua9fe\uaa00-\uaa28\uaa40-\uaa42\uaa44-\uaa4b\uaa50-\uaa59\uaa60-\uaa76\uaa7a\uaa7e-\uaaaf\uaab1\uaab5-\uaab6\uaab9-\uaabd\uaac0\uaac2\uaadb-\uaadd\uaae0-\uaaea\uaaf2-\uaaf4\uab01-\uab06\uab09-\uab0e\uab11-\uab16\uab20-\uab26\uab28-\uab2e\uab30-\uab5a\uab5c-\uab69\uab70-\uabe2\uabf0-\uabf9\uac00-\ud7a3\ud7b0-\ud7c6\ud7cb-\ud7fb\uf900-\ufa6d\ufa70-\ufad9\ufb00-\ufb06\ufb13-\ufb17\ufb1d\ufb1f-\ufb28\ufb2a-\ufb36\ufb38-\ufb3c\ufb3e\ufb40-\ufb41\ufb43-\ufb44\ufb46-\ufbb1\ufbd3-\ufd3d\ufd50-\ufd8f\ufd92-\ufdc7\ufdf0-\ufdfb\ufe70-\ufe74\ufe76-\ufefc\uff10-\uff19\uff21-\uff3a\uff41-\uff5a\uff66-\uffbe\uffc2-\uffc7\uffca-\uffcf\uffd2-\uffd7\uffda-\uffdc\ud800\udc00-\ud800\udc0b\ud800\udc0d-\ud800\udc26\ud800\udc28-\ud800\udc3a\ud800\udc3c-\ud800\udc3d\ud800\udc3f-\ud800\udc4d\ud800\udc50-\ud800\udc5d\ud800\udc80-\ud800\udcfa\ud800\udd07-\ud800\udd33\ud800\udd40-\ud800\udd78\ud800\udd8a-\ud800\udd8b\ud800\ude80-\ud800\ude9c\ud800\udea0-\ud800\uded0\ud800\udee1-\ud800\udefb\ud800\udf00-\ud800\udf23\ud800\udf2d-\ud800\udf4a\ud800\udf50-\ud800\udf75\ud800\udf80-\ud800\udf9d\ud800\udfa0-\ud800\udfc3\ud800\udfc8-\ud800\udfcf\ud800\udfd1-\ud800\udfd5\ud801\udc00-\ud801\udc9d\ud801\udca0-\ud801\udca9\ud801\udcb0-\ud801\udcd3\ud801\udcd8-\ud801\udcfb\ud801\udd00-\ud801\udd27\ud801\udd30-\ud801\udd63\ud801\udd70-\ud801\udd7a\ud801\udd7c-\ud801\udd8a\ud801\udd8c-\ud801\udd92\ud801\udd94-\ud801\udd95\ud801\udd97-\ud801\udda1\ud801\udda3-\ud801\uddb1\ud801\uddb3-\ud801\uddb9\ud801\uddbb-\ud801\uddbc\ud801\ude00-\ud801\udf36\ud801\udf40-\ud801\udf55\ud801\udf60-\ud801\udf67\ud801\udf80-\ud801\udf85\ud801\udf87-\ud801\udfb0\ud801\udfb2-\ud801\udfba\ud802\udc00-\ud802\udc05\ud802\udc08\ud802\udc0a-\ud802\udc35\ud802\udc37-\ud802\udc38\ud802\udc3c\ud802\udc3f-\ud802\udc55\ud802\udc58-\ud802\udc76\ud802\udc79-\ud802\udc9e\ud802\udca7-\ud802\udcaf\ud802\udce0-\ud802\udcf2\ud802\udcf4-\ud802\udcf5\ud802\udcfb-\ud802\udd1b\ud802\udd20-\ud802\udd39\ud802\udd80-\ud802\uddb7\ud802\uddbc-\ud802\uddcf\ud802\uddd2-\ud802\ude00\ud802\ude10-\ud802\ude13\ud802\ude15-\ud802\ude17\ud802\ude19-\ud802\ude35\ud802\ude40-\ud802\ude48\ud802\ude60-\ud802\ude7e\ud802\ude80-\ud802\ude9f\ud802\udec0-\ud802\udec7\ud802\udec9-\ud802\udee4\ud802\udeeb-\ud802\udeef\ud802\udf00-\ud802\udf35\ud802\udf40-\ud802\udf55\ud802\udf58-\ud802\udf72\ud802\udf78-\ud802\udf91\ud802\udfa9-\ud802\udfaf\ud803\udc00-\ud803\udc48\ud803\udc80-\ud803\udcb2\ud803\udcc0-\ud803\udcf2\ud803\udcfa-\ud803\udd23\ud803\udd30-\ud803\udd39\ud803\ude60-\ud803\ude7e\ud803\ude80-\ud803\udea9\ud803\udeb0-\ud803\udeb1\ud803\udf00-\ud803\udf27\ud803\udf30-\ud803\udf45\ud803\udf51-\ud803\udf54\ud803\udf70-\ud803\udf81\ud803\udfb0-\ud803\udfcb\ud803\udfe0-\ud803\udff6\ud804\udc03-\ud804\udc37\ud804\udc52-\ud804\udc6f\ud804\udc71-\ud804\udc72\ud804\udc75\ud804\udc83-\ud804\udcaf\ud804\udcd0-\ud804\udce8\ud804\udcf0-\ud804\udcf9\ud804\udd03-\ud804\udd26\ud804\udd36-\ud804\udd3f\ud804\udd44\ud804\udd47\ud804\udd50-\ud804\udd72\ud804\udd76\ud804\udd83-\ud804\uddb2\ud804\uddc1-\ud804\uddc4\ud804\uddd0-\ud804\uddda\ud804\udddc\ud804\udde1-\ud804\uddf4\ud804\ude00-\ud804\ude11\ud804\ude13-\ud804\ude2b\ud804\ude3f-\ud804\ude40\ud804\ude80-\ud804\ude86\ud804\ude88\ud804\ude8a-\ud804\ude8d\ud804\ude8f-\ud804\ude9d\ud804\ude9f-\ud804\udea8\ud804\udeb0-\ud804\udede\ud804\udef0-\ud804\udef9\ud804\udf05-\ud804\udf0c\ud804\udf0f-\ud804\udf10\ud804\udf13-\ud804\udf28\ud804\udf2a-\ud804\udf30\ud804\udf32-\ud804\udf33\ud804\udf35-\ud804\udf39\ud804\udf3d\ud804\udf50\ud804\udf5d-\ud804\udf61\ud805\udc00-\ud805\udc34\ud805\udc47-\ud805\udc4a\ud805\udc50-\ud805\udc59\ud805\udc5f-\ud805\udc61\ud805\udc80-\ud805\udcaf\ud805\udcc4-\ud805\udcc5\ud805\udcc7\ud805\udcd0-\ud805\udcd9\ud805\udd80-\ud805\uddae\ud805\uddd8-\ud805\udddb\ud805\ude00-\ud805\ude2f\ud805\ude44\ud805\ude50-\ud805\ude59\ud805\ude80-\ud805\udeaa\ud805\udeb8\ud805\udec0-\ud805\udec9\ud805\udf00-\ud805\udf1a\ud805\udf30-\ud805\udf3b\ud805\udf40-\ud805\udf46\ud806\udc00-\ud806\udc2b\ud806\udca0-\ud806\udcf2\ud806\udcff-\ud806\udd06\ud806\udd09\ud806\udd0c-\ud806\udd13\ud806\udd15-\ud806\udd16\ud806\udd18-\ud806\udd2f\ud806\udd3f\ud806\udd41\ud806\udd50-\ud806\udd59\ud806\udda0-\ud806\udda7\ud806\uddaa-\ud806\uddd0\ud806\udde1\ud806\udde3\ud806\ude00\ud806\ude0b-\ud806\ude32\ud806\ude3a\ud806\ude50\ud806\ude5c-\ud806\ude89\ud806\ude9d\ud806\udeb0-\ud806\udef8\ud807\udc00-\ud807\udc08\ud807\udc0a-\ud807\udc2e\ud807\udc40\ud807\udc50-\ud807\udc6c\ud807\udc72-\ud807\udc8f\ud807\udd00-\ud807\udd06\ud807\udd08-\ud807\udd09\ud807\udd0b-\ud807\udd30\ud807\udd46\ud807\udd50-\ud807\udd59\ud807\udd60-\ud807\udd65\ud807\udd67-\ud807\udd68\ud807\udd6a-\ud807\udd89\ud807\udd98\ud807\udda0-\ud807\udda9\ud807\udee0-\ud807\udef2\ud807\udf02\ud807\udf04-\ud807\udf10\ud807\udf12-\ud807\udf33\ud807\udf50-\ud807\udf59\ud807\udfb0\ud807\udfc0-\ud807\udfd4\ud808\udc00-\ud808\udf99\ud809\udc00-\ud809\udc6e\ud809\udc80-\ud809\udd43\ud80b\udf90-\ud80b\udff0\ud80c\udc00-\ud80d\udc2f\ud80d\udc41-\ud80d\udc46\ud811\udc00-\ud811\ude46\ud81a\udc00-\ud81a\ude38\ud81a\ude40-\ud81a\ude5e\ud81a\ude60-\ud81a\ude69\ud81a\ude70-\ud81a\udebe\ud81a\udec0-\ud81a\udec9\ud81a\uded0-\ud81a\udeed\ud81a\udf00-\ud81a\udf2f\ud81a\udf40-\ud81a\udf43\ud81a\udf50-\ud81a\udf59\ud81a\udf5b-\ud81a\udf61\ud81a\udf63-\ud81a\udf77\ud81a\udf7d-\ud81a\udf8f\ud81b\ude40-\ud81b\ude96\ud81b\udf00-\ud81b\udf4a\ud81b\udf50\ud81b\udf93-\ud81b\udf9f\ud81b\udfe0-\ud81b\udfe1\ud81b\udfe3\ud81c\udc00-\ud821\udff7\ud822\udc00-\ud823\udcd5\ud823\udd00-\ud823\udd08\ud82b\udff0-\ud82b\udff3\ud82b\udff5-\ud82b\udffb\ud82b\udffd-\ud82b\udffe\ud82c\udc00-\ud82c\udd22\ud82c\udd32\ud82c\udd50-\ud82c\udd52\ud82c\udd55\ud82c\udd64-\ud82c\udd67\ud82c\udd70-\ud82c\udefb\ud82f\udc00-\ud82f\udc6a\ud82f\udc70-\ud82f\udc7c\ud82f\udc80-\ud82f\udc88\ud82f\udc90-\ud82f\udc99\ud834\udec0-\ud834\uded3\ud834\udee0-\ud834\udef3\ud834\udf60-\ud834\udf78\ud835\udc00-\ud835\udc54\ud835\udc56-\ud835\udc9c\ud835\udc9e-\ud835\udc9f\ud835\udca2\ud835\udca5-\ud835\udca6\ud835\udca9-\ud835\udcac\ud835\udcae-\ud835\udcb9\ud835\udcbb\ud835\udcbd-\ud835\udcc3\ud835\udcc5-\ud835\udd05\ud835\udd07-\ud835\udd0a\ud835\udd0d-\ud835\udd14\ud835\udd16-\ud835\udd1c\ud835\udd1e-\ud835\udd39\ud835\udd3b-\ud835\udd3e\ud835\udd40-\ud835\udd44\ud835\udd46\ud835\udd4a-\ud835\udd50\ud835\udd52-\ud835\udea5\ud835\udea8-\ud835\udec0\ud835\udec2-\ud835\udeda\ud835\udedc-\ud835\udefa\ud835\udefc-\ud835\udf14\ud835\udf16-\ud835\udf34\ud835\udf36-\ud835\udf4e\ud835\udf50-\ud835\udf6e\ud835\udf70-\ud835\udf88\ud835\udf8a-\ud835\udfa8\ud835\udfaa-\ud835\udfc2\ud835\udfc4-\ud835\udfcb\ud835\udfce-\ud835\udfff\ud837\udf00-\ud837\udf1e\ud837\udf25-\ud837\udf2a\ud838\udc30-\ud838\udc6d\ud838\udd00-\ud838\udd2c\ud838\udd37-\ud838\udd3d\ud838\udd40-\ud838\udd49\ud838\udd4e\ud838\ude90-\ud838\udead\ud838\udec0-\ud838\udeeb\ud838\udef0-\ud838\udef9\ud839\udcd0-\ud839\udceb\ud839\udcf0-\ud839\udcf9\ud839\udfe0-\ud839\udfe6\ud839\udfe8-\ud839\udfeb\ud839\udfed-\ud839\udfee\ud839\udff0-\ud839\udffe\ud83a\udc00-\ud83a\udcc4\ud83a\udcc7-\ud83a\udccf\ud83a\udd00-\ud83a\udd43\ud83a\udd4b\ud83a\udd50-\ud83a\udd59\ud83b\udc71-\ud83b\udcab\ud83b\udcad-\ud83b\udcaf\ud83b\udcb1-\ud83b\udcb4\ud83b\udd01-\ud83b\udd2d\ud83b\udd2f-\ud83b\udd3d\ud83b\ude00-\ud83b\ude03\ud83b\ude05-\ud83b\ude1f\ud83b\ude21-\ud83b\ude22\ud83b\ude24\ud83b\ude27\ud83b\ude29-\ud83b\ude32\ud83b\ude34-\ud83b\ude37\ud83b\ude39\ud83b\ude3b\ud83b\ude42\ud83b\ude47\ud83b\ude49\ud83b\ude4b\ud83b\ude4d-\ud83b\ude4f\ud83b\ude51-\ud83b\ude52\ud83b\ude54\ud83b\ude57\ud83b\ude59\ud83b\ude5b\ud83b\ude5d\ud83b\ude5f\ud83b\ude61-\ud83b\ude62\ud83b\ude64\ud83b\ude67-\ud83b\ude6a\ud83b\ude6c-\ud83b\ude72\ud83b\ude74-\ud83b\ude77\ud83b\ude79-\ud83b\ude7c\ud83b\ude7e\ud83b\ude80-\ud83b\ude89\ud83b\ude8b-\ud83b\ude9b\ud83b\udea1-\ud83b\udea3\ud83b\udea5-\ud83b\udea9\ud83b\udeab-\ud83b\udebb\ud83c\udd00-\ud83c\udd0c\ud83e\udff0-\ud83e\udff9\ud840\udc00-\ud869\udedf\ud869\udf00-\ud86d\udf39\ud86d\udf40-\ud86e\udc1d\ud86e\udc20-\ud873\udea1\ud873\udeb0-\ud87a\udfe0\ud87a\udff0-\ud87b\ude5d\ud87e\udc00-\ud87e\ude1d\ud880\udc00-\ud884\udf4a\ud884\udf50-\ud888\udfaf]").
.decl text_contract_wordspec(k: symbol, p: symbol, name: symbol)
.decl text_contract_word(k: symbol, p: symbol, l: number)
text_contract_word(k, p, l) :- text_contract_wordspec(k, p, nm), text_contract_nonword(c), text_contract_line(p, l, u),
    x = cat(".*(?:\\A|", cat(c, cat(")", cat(nm, cat("(?:\\z|", cat(c, ").*")))))), match(x, u).
.decl text_contract_word_first(k: symbol, p: symbol, l: number)
text_contract_word_first(k, p, l) :- text_contract_word(k, p, _), l = min x : { text_contract_word(k, p, x) }.

// ---- classes: the SQL's class block ------------------------------------------------------------------------------
.decl text_contract_clsspec(p: symbol, c: symbol)
.decl text_contract_hdr(p: symbol, c: symbol, l: number)
text_contract_hdr(p, c, l) :- text_contract_clsspec(p, c), text_contract_line(p, l, u), x = cat("class ", cat(c, "(?:\\[.*\\])?(?:\\(.*\\))?:.*")), match(x, u).
.decl text_contract_cls(p: symbol, c: symbol, l: number)
text_contract_cls(p, c, l) :- text_contract_hdr(p, c, _), l = min x : { text_contract_hdr(p, c, x) }.
.decl text_contract_has_cls(p: symbol, c: symbol)
text_contract_has_cls(p, c) :- text_contract_cls(p, c, _).
// The header's own match (`\A(class C(?:\[[^\n]*\])?(?:\([^\n]*\))?:)`, greedy): the text after it on line h is the
// group `rest` (a class name is a whole identifier: `class C` is followed by `[`, `(` or `:`).
.decl text_contract_cquirk(p: symbol, c: symbol)
text_contract_cquirk(p, c) :- text_contract_cls(p, c, h), text_contract_span(p, h, sp), match_group("\\Aclass (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?(?:\\([^\\n]*\\))?:(?P<rest>.*)\\z", sp, m, "n", gn), text(gn, c), match_group("\\Aclass (?P<n>[A-Za-z0-9_]+)(?:\\[[^\\n]*\\])?(?:\\([^\\n]*\\))?:(?P<rest>.*)\\z", sp, m, "rest", gr), text(gr, r), match("(?:class |def |async def ).*", r).
.decl text_contract_top(p: symbol, l: number)
text_contract_top(p, l) :- text_contract_line(p, l, u), match("(?:class |def |async def ).*", u).
.decl text_contract_cafter(p: symbol, c: symbol, l: number)
text_contract_cafter(p, c, t) :- text_contract_cls(p, c, l0), text_contract_top(p, t), t > l0.
.decl text_contract_cend(p: symbol, c: symbol, l: number)
text_contract_cend(p, c, e) :- text_contract_cafter(p, c, _), e = min x : { text_contract_cafter(p, c, x) }.
.decl text_contract_cended(p: symbol, c: symbol)
text_contract_cended(p, c) :- text_contract_cend(p, c, _).
// cin: the block's lines after the header line (no regex read in a block can match the header line: each starts
// with four spaces).
.decl text_contract_cin(p: symbol, c: symbol, l: number, u: symbol)
text_contract_cin(p, c, l, u) :- text_contract_cls(p, c, l0), !text_contract_cquirk(p, c), text_contract_line(p, l, u), l > l0, text_contract_cend(p, c, e), l < e.
text_contract_cin(p, c, l, u) :- text_contract_cls(p, c, l0), !text_contract_cquirk(p, c), text_contract_line(p, l, u), l > l0, !text_contract_cended(p, c).

// ---- a method in a class block: '(?m)^    (?:async )?def NAME(?:\[[^\n]*\])?\s*\(' ----------------------------
.decl text_contract_cmspec(k: symbol, p: symbol, c: symbol, name: symbol)
.decl text_contract_cdef(k: symbol, l: number)
text_contract_cdef(k, l) :- text_contract_cmspec(k, p, c, nm), text_contract_cin(p, c, l, u), x = cat("    (?:async )?def ", cat(nm, "(?:\\[.*\\])?[\\s\\x1c-\\x1f]*\\(.*")), match(x, u).
text_contract_cdef(k, l) :- text_contract_cmspec(k, p, c, nm), text_contract_cin(p, c, l, u), x = cat("    (?:async )?def ", cat(nm, "(?:\\[.*\\])?[\\s\\x1c-\\x1f]*")), match(x, u), text_contract_paren(p, l, j), text_contract_cin(p, c, j, _).
.decl text_contract_cmok(k: symbol)
text_contract_cmok(k) :- text_contract_cdef(k, _).

// ---- deco: the class block matches '(?m)^    @DECO(?:\([^\n]*\))?\n(?:    @[^\n]+\n)*' and then the method ----------
.decl text_contract_decospec(k: symbol, deco: symbol)
.decl text_contract_deco(k: symbol, l: number)
text_contract_deco(k, l) :- text_contract_decospec(k, dc), text_contract_cmspec(k, p, c, _), text_contract_cin(p, c, l, u), x = cat("    @", cat(dc, "(?:\\(.*\\))?")), match(x, u).
.decl text_contract_dchain(k: symbol, l: number)
text_contract_dchain(k, j) :- text_contract_deco(k, l), text_contract_cmspec(k, p, c, _), text_contract_next(p, l, j), text_contract_cin(p, c, j, _).
text_contract_dchain(k, j) :- text_contract_dchain(k, l), text_contract_cmspec(k, p, c, _), text_contract_cin(p, c, l, u), match("    @.+", u), text_contract_next(p, l, j), text_contract_cin(p, c, j, _).
.decl text_contract_dok(k: symbol)
text_contract_dok(k) :- text_contract_dchain(k, l), text_contract_cdef(k, l).

// ---- fields in a class block: '(?m)^    FIELD\s*:\s*([^\n=]+)(?:\s*=\s*([^\n]+))?' -------------------------------
.decl text_contract_fspec(k: symbol, p: symbol, c: symbol, f: symbol)
// colon(k, a, b, pre): the match from line a has its `:` on line b, and `pre` matches line b through it.
.decl text_contract_fcolon(k: symbol, a: number, b: number, pre: symbol)
text_contract_fcolon(k, a, a, x) :- text_contract_fspec(k, p, c, f), text_contract_cin(p, c, a, u), x = cat("    ", cat(f, "[\\s\\x1c-\\x1f]*:")), y = cat(x, ".*"), match(y, u).
text_contract_fcolon(k, a, j, "[\\s\\x1c-\\x1f]*:") :- text_contract_fspec(k, p, c, f), text_contract_cin(p, c, a, u), x = cat("    ", cat(f, "[\\s\\x1c-\\x1f]*")), match(x, u), text_contract_nb_next(p, a, j), text_contract_cin(p, c, j, w), match("[\\s\\x1c-\\x1f]*:.*", w).
// ok(k, a): the match from line a exists: some `\s*` prefix after the colon is followed by a character that is no
// line break and no `=`; that is, the first character after the colon that is no line break is not `=`.
.decl text_contract_fok(k: symbol, a: number)
text_contract_fok(k, a) :- text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = cat(pre, "[^=].*"), match(x, u).
text_contract_fok(k, a) :- text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), match(pre, u), text_contract_ne_next(p, b, j), text_contract_cin(p, c, j, w), match("[^=].*", w).
.decl text_contract_fld(k: symbol)
text_contract_fld(k) :- text_contract_fok(k, _).
// The groups are the first match's (rx_extract): a0 its line.
.decl text_contract_ffirst(k: symbol, a: number)
text_contract_ffirst(k, a) :- text_contract_fok(k, _), a = min x : { text_contract_fok(k, x) }.
// fx(k, j, xp): the first character after the colon that is no `\s` is on line j, `xp` matching line j before it.
.decl text_contract_fx(k: symbol, j: number, xp: symbol)
text_contract_fx(k, b, x) :- text_contract_ffirst(k, a), text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = cat(pre, "[\\s\\x1c-\\x1f]*"), y = cat(x, "[^\\s\\x1c-\\x1f].*"), match(y, u).
text_contract_fx(k, j, "[\\s\\x1c-\\x1f]*") :- text_contract_ffirst(k, a), text_contract_fcolon(k, a, b, pre), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, b, u), x = cat(pre, "[\\s\\x1c-\\x1f]*"), match(x, u), text_contract_nb_next(p, b, j), text_contract_cin(p, c, j, _).
// Group 1 holds `None`: when that character is not `=`, group 1 runs from it to the next `=` or line break (when it
// is `=`, the `\s*` gives back a blank and group 1 is blanks).
.decl text_contract_g1none(k: symbol)
text_contract_g1none(k) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(xp, "[^=]*None.*"), match(x, u).
// fq(k, j, qp): the `=` before group 2 is on line j, `qp` matching line j through it: the first `=` of group 1's
// line after it, or, when that line has none, the first character after the line that is no `\s`, when it is `=`;
// when the character itself is `=`, it.
.decl text_contract_fq(k: symbol, j: number, qp: symbol)
text_contract_fq(k, j, x) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(xp, "[^=\\s\\x1c-\\x1f][^=]*="), y = cat(x, ".*"), match(y, u).
text_contract_fq(k, j3, "[\\s\\x1c-\\x1f]*=") :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(xp, "[^=\\s\\x1c-\\x1f][^=]*"), match(x, u), text_contract_nb_next(p, j, j3), text_contract_cin(p, c, j3, w), match("[\\s\\x1c-\\x1f]*=.*", w).
text_contract_fq(k, j, x) :- text_contract_fx(k, j, xp), text_contract_fspec(k, p, c, _), text_contract_cin(p, c, j, u), x = cat(xp, "="), y = cat(x, ".*"), match(y, u).
