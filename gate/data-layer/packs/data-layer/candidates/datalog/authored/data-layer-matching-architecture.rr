// data-layer-matching-architecture, authored. Source: packs/data-layer/rules/data-layer-matching-architecture.json.
// Options (clause `configuration`): entryPoint (default "all") and parameters (default "{}"), read from the
// converter's option facts: `option_value("entryPoint", v)`, and `parameters`' JSON leaves (`option_json`).
//
// ---- clause matching-project-ownership (cross-file; the `files` input is every file in scope) ----
// entryPoint "scan_sources" takes the query's case `... WHERE 0`: no finding. Any other takes its `default`. The
// findings are at the policy's `locations`, line 1, the code the `issue` column:
// - MA033 at l5250_matching/maintenance.py: some file has an `l5250_matching/` path component and does not start
//   `conform/`, and none of those files' text contains BranchAwareIndexPolicy;
// - MA034 at data_layer_testing/matching_operator.py: that file's text contains register_table_hook.

.decl option_value(name: symbol, v: symbol)
.decl option_json(name: symbol, pointer: symbol, v: symbol)
.decl matching_project_scan_sources(x: number)
matching_project_scan_sources(0) :- option_value("entryPoint", "scan_sources").

.decl doc(d: number, path: symbol, module: symbol)
.decl source(d: number, sp: span)
.input source
.decl text(n: loc, s: symbol)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

.decl matching_project_file(d: number, s: symbol)
matching_project_file(d, s) :- doc(d, p, _), in_scope(d), !out_scope(d), source(d, sp), text(sp, s).
.decl matching_project_maintenance(d: number)
matching_project_maintenance(d) :- matching_project_file(d, _), doc(d, p, _), match("(.*/)?l5250_matching/.*", p), !prefix("conform/", p).
.decl matching_project_policy(d: number)
matching_project_policy(d) :- matching_project_maintenance(d), matching_project_file(d, s), contains("BranchAwareIndexPolicy", s).
.decl matching_project_any_maintenance(x: number)
matching_project_any_maintenance(0) :- matching_project_maintenance(_).
.decl matching_project_any_policy(x: number)
matching_project_any_policy(0) :- matching_project_policy(_).

violation("data-layer-matching-architecture", "matching-project-ownership", "MA033", "l5250_matching/maintenance.py", 1) :-
    !matching_project_scan_sources(0), matching_project_any_maintenance(0), !matching_project_any_policy(0).
violation("data-layer-matching-architecture", "matching-project-ownership", "MA034", "data_layer_testing/matching_operator.py", 1) :-
    !matching_project_scan_sources(0), doc(d, "data_layer_testing/matching_operator.py", _), matching_project_file(d, s),
    contains("register_table_hook", s).

// ---- clause matching-file-checks (per file: partitionBy file; the `gate` input is the files that parse) ----
// The stages read `canonical`, a `pythonAst` stage: CPython `ast` rows. No relation gives those rows; they are
// emulated here over tree-sitter (`matching_file_` relations, the library python/ast.rr's views, written out for the
// fields the stages read). The emulation, and where it is not exact:
// - Name: an identifier in expression position: not an attribute's attr, a def/class/keyword/parameter name, a name
//   in an import, a global/nonlocal name or an `except … as` name. Match-statement capture names and PEP 695 type
//   parameter names are not left out (not modelled).
// - Attribute (attr, value), Call (func, positional `args` by position among the non-keyword arguments, `keywords`),
//   Subscript (`subscript`, and `generic_type` in annotations), BinOp (`binary_operator`; `union_type` as BitOr),
//   Constant (literals other than f-strings, a concatenation one node), JoinedStr (f-strings),
//   Tuple (`tuple`, `expression_list`), Assign/AnnAssign (statement assignments; `a = b = v` one Assign with two
//   targets), Try/ExceptHandler, Return, For/AsyncFor/While, keyword, arg (parameters), ClassDef/FunctionDef,
//   Import/ImportFrom with their aliases; parentheses and `type` wrappers are not nodes.
// - A node's subtree (`BETWEEN id AND last`) is its span; a FunctionDef's includes its decorators.
// - `ast_line` is the tree-sitter node's start line (CPython's lineno for these nodes). "The first by (line, id)"
//   is the minimum line (findings are (path, line, code) keys), so the preorder ties never matter.
// - `ast_function`/`ast_class` (fn, cls): the nearest enclosing def / class.
// - Constant kind and value: `value_type_of` and `value` (W's decoded value, Python's str(v): exactly ast_value but
//   for bytes' hex and complex numbers, which no check reads). An f-string without interpolation: `value`, exactly.
//   An interpolated f-string's and a format spec's literal parts (its Constants): `fstring_piece`'s `literal` rows,
//   decoded and merged across concatenated pieces as CPython's are. Their line is CPython's (3.12+) lineno, read off
//   the tree (`matching_file_part_line`, below).
// - Static text (MA002) through `+` is compared, never built: piece by piece against the constant words, so any
//   depth of `+` and any number of parts is exact. MA007's joined literal parts: `join` over `fstring_piece`.
// Options: entryPoint "scan_sources" or "_scan_tree": the gate and the canonical roots are every module (that
// parses). Any other: the canonical roots are the modules whose path is a production path, or whose source text
// names a matching contract, or a layer module defining `def match(`, or a path listed in parameters'
// `applicationPaths` (`option_json`); the gate (`$option parameters`) at "{}" is the modules whose path is a
// production path, or whose module node's text names a contract or (layer modules) defines `def match(`, every
// module otherwise. `applicationPaths` also makes a file an application. SQL string functions: lower/upper are ASCII
// (character classes, `(?i-u:…)`), ltrim trims spaces.

.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl name(n: node, s: symbol)
.decl strprefix(n: node, s: symbol)
.decl op(n: node, s: symbol)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl cpython_syntax_error(d: number, l: number, msg: symbol)
.decl node_text(n: node, s: symbol)
.input node_text
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl fstring_piece(n: node, i: number, kind: symbol, v: symbol)
.decl end_line(n: node, l: number)

// ---- the files read: parsing, in scope, in the gate and among the canonical roots ----
// The gate (`requireNonemptyInput`) and the roots differ in what their regexes read: the gate's `regex` on the
// module reads its node text, the roots' `source_text(__path)` the whole file. A file is read when it is in both.
// Two verdicts. The gate's AST matcher's `syntax: valid` is W's own: tree-sitter's (`syntax_error`, ERROR and
// MISSING nodes). The `canonical` stage is a `pythonAst` stage: CPython's `ast.parse` reads the file, and a file it
// rejects fails the stage (`cpython_syntax_error`, CPython 3.13's verdict). A file is read when it passes both.
.decl matching_file_every_module(x: number)
matching_file_every_module(0) :- option_value("entryPoint", "scan_sources").
matching_file_every_module(0) :- option_value("entryPoint", "_scan_tree").
// json_each(data, '$.applicationPaths'): the value itself (a scalar), or each element or member of an array or object.
.decl matching_file_application_path(p: symbol)
matching_file_application_path(p) :- option_json("parameters", k, p), match("/applicationPaths(/[^/]*)?", k).
.decl matching_file_candidate(d: number)
matching_file_candidate(d) :- doc(d, _, _), in_scope(d), !out_scope(d), !syntax_error(d), !cpython_syntax_error(d, _, _),
    node(d, _, "module", _, _).
.decl matching_file_contract_text(s: symbol)
matching_file_contract_text(s) :- (matching_file_module_text(_, s) ; matching_file_source_text(_, s)),
    match("(?s:.*)(?:data_layer\\.matching|l1470_matching_contracts|l5250_matching|MatchSpec|MatchResult|MatchPhysicalPlanError|MatchAccessMethodKind)(?s:.*)", s).
.decl matching_file_def_match_text(s: symbol)
matching_file_def_match_text(s) :- (matching_file_module_text(_, s) ; matching_file_source_text(_, s)),
    match("(?s:.*)(?:\\b(?:async\\s+)?def\\s+match(?:_async|_lazy)?\\s*\\()(?s:.*)", s).
.decl matching_file_module_text(d: number, s: symbol)
matching_file_module_text(d, s) :- matching_file_candidate(d), node(d, m, "module", _, _), node_text(m, s).
.decl matching_file_source_text(d: number, s: symbol)
matching_file_source_text(d, s) :- matching_file_candidate(d), source(d, sp), text(sp, s).
.decl matching_file_layer_path(d: number)
matching_file_layer_path(d) :- matching_file_candidate(d), doc(d, p, _), match("(.*/)?l[0-9]{4}_.*", p).
.decl matching_file_gate(d: number)
matching_file_gate(d) :- matching_file_candidate(d), matching_file_every_module(0).
matching_file_gate(d) :- matching_file_candidate(d), !matching_file_every_module(0), !option_value("parameters", "{}").
matching_file_gate(d) :- matching_file_candidate(d), !matching_file_every_module(0), option_value("parameters", "{}"), matching_file_production(d).
matching_file_gate(d) :- matching_file_candidate(d), !matching_file_every_module(0), option_value("parameters", "{}"),
    matching_file_module_text(d, s), matching_file_contract_text(s).
matching_file_gate(d) :- matching_file_candidate(d), !matching_file_every_module(0), option_value("parameters", "{}"),
    matching_file_layer_path(d), matching_file_module_text(d, s), matching_file_def_match_text(s).
.decl matching_file_root(d: number)
matching_file_root(d) :- matching_file_candidate(d), matching_file_every_module(0).
matching_file_root(d) :- matching_file_candidate(d), !matching_file_every_module(0), matching_file_production(d).
matching_file_root(d) :- matching_file_candidate(d), !matching_file_every_module(0), matching_file_source_text(d, s), matching_file_contract_text(s).
matching_file_root(d) :- matching_file_candidate(d), !matching_file_every_module(0), matching_file_layer_path(d),
    matching_file_source_text(d, s), matching_file_def_match_text(s).
matching_file_root(d) :- matching_file_candidate(d), !matching_file_every_module(0), doc(d, p, _), matching_file_application_path(p).
.decl matching_file_doc(d: number)
matching_file_doc(d) :- matching_file_gate(d), matching_file_root(d).

// ---- matching_scope, per file ----
.decl matching_file_production(d: number)
matching_file_production(d) :- doc(d, p, _), match("data_layer/matching\\.py|l1470_matching_contracts/.*|(.*/)?l5250_matching/.*", p).
.decl matching_file_application(d: number)
matching_file_application(d) :- matching_file_doc(d), doc(d, p, _), match("(applications|application|app)/.*|(.*/)?applications/.*", p).
matching_file_application(d) :- matching_file_doc(d), doc(d, p, _), matching_file_application_path(p).
.decl matching_file_facade(d: number)
matching_file_facade(d) :- matching_file_doc(d), doc(d, p, _), (p = "data_layer/matching.py" ; p = "l5250_matching/api.py" ; p = "l5250_matching/__init__.py").
.decl matching_file_conformance(d: number)
matching_file_conformance(d) :- matching_file_doc(d), doc(d, p, _), prefix("conform/l5250_matching/", p).
// layer < 5250: the first `(^|/)l([0-9]{4})_` in the path (rx_extract) has digits below 5250. The components before
// it are those not starting l<4 digits>_.
.decl matching_file_lower_layer(d: number)
matching_file_lower_layer(d) :- matching_file_doc(d), doc(d, p, _),
    match("(([^l/][^/]*|l|l[^0-9/][^/]*|l[0-9]|l[0-9][^0-9/][^/]*|l[0-9]{2}|l[0-9]{2}[^0-9/][^/]*|l[0-9]{3}|l[0-9]{3}[^0-9/][^/]*|l[0-9]{4}|l[0-9]{4}[^_/][^/]*)/)*l(0[0-9]{3}|[1-4][0-9]{3}|5[01][0-9]{2}|52[0-4][0-9])_.*", p).
.decl matching_file_contract_name(s: symbol)
matching_file_contract_name("MatchSpec").
matching_file_contract_name("MatchResult").
matching_file_contract_name("MatchPhysicalPlanError").
matching_file_contract_name("MatchAccessMethodKind").
.decl matching_file_uses_contracts(d: number)
matching_file_uses_contracts(d) :- matching_file_import(d, _, m), (m = "data_layer.matching" ; match("l(1470_matching_contracts|5250_matching)(\\..*)?", m)).
matching_file_uses_contracts(d) :- matching_file_doc(d), node(d, n, _, _, _), matching_file_name(n, x), matching_file_contract_name(x).
matching_file_uses_contracts(d) :- matching_file_doc(d), node(d, n, _, _, _), matching_file_attr(n, x, _), matching_file_contract_name(x).
.decl matching_file_matching(d: number)
matching_file_matching(d) :- matching_file_doc(d), matching_file_production(d).
matching_file_matching(d) :- matching_file_uses_contracts(d).
.decl matching_file_implementation(d: number)
matching_file_implementation(d) :- matching_file_doc(d), doc(d, p, _), prefix("impl/common/", p), match("(.*/)?l5250_matching/.*", p).
matching_file_implementation(d) :- matching_file_uses_contracts(d), doc(d, p, _), prefix("impl/common/", p).

// ---- the ast emulation ----
.decl matching_file_node(n: node)
matching_file_node(n) :- matching_file_doc(d), node(d, n, _, _, _).
.decl matching_file_kind(k: symbol)
matching_file_kind("function_definition").
.decl matching_file_class_kind(k: symbol)
matching_file_class_kind("class_definition").
.decl matching_file_decorator_kind(k: symbol)
matching_file_decorator_kind("decorator").
.decl matching_file_import_kind(k: symbol)
matching_file_import_kind("import_statement").
matching_file_import_kind("import_from_statement").
matching_file_import_kind("future_import_statement").

// mirrors python/ast.rr unparen
.decl matching_file_unparen(e: node, m: node)
matching_file_unparen(e, e) :- matching_file_node(e), !node(_, e, "parenthesized_expression", _, _).
matching_file_unparen(e, m) :- node(_, e, "parenthesized_expression", _, _), matching_file_node(e), child(e, i, 0), matching_file_unparen(i, m).
// An annotation's ast node: a `type` wrapper (and parentheses) taken off.
.decl matching_file_untype(e: node, m: node)
matching_file_untype(e, m) :- matching_file_unparen(e, m), !node(_, m, "type", _, _).
matching_file_untype(e, m) :- matching_file_unparen(e, t), node(_, t, "type", _, _), child(t, i, 0), matching_file_untype(i, m).

// mirrors python/ast.rr ast_name / not_name
.decl matching_file_param_holder(k: symbol)
matching_file_param_holder("parameters").
matching_file_param_holder("lambda_parameters").
matching_file_param_holder("typed_parameter").
.decl matching_file_not_name(n: node)
matching_file_not_name(n) :- node(_, a, "attribute", _, _), field(a, "attribute", n).
matching_file_not_name(n) :- node(_, f, "function_definition", _, _), field(f, "name", n).
matching_file_not_name(n) :- node(_, f, "class_definition", _, _), field(f, "name", n).
matching_file_not_name(n) :- node(_, k, "keyword_argument", _, _), field(k, "name", n).
matching_file_not_name(n) :- node(_, p, k, _, _), matching_file_param_holder(k), child(p, n, _), node(_, n, "identifier", _, _).
matching_file_not_name(n) :- (node(_, p, "default_parameter", _, _) ; node(_, p, "typed_default_parameter", _, _)), field(p, "name", n).
matching_file_not_name(n) :- (node(_, s, "list_splat_pattern", _, _) ; node(_, s, "dictionary_splat_pattern", _, _)), child(h, s, _),
    node(_, h, hk, _, _), matching_file_param_holder(hk), child(s, n, _).
matching_file_not_name(n) :- node(_, n, "identifier", _, _), inside(n, _, matching_file_import_kind).
matching_file_not_name(n) :- (node(_, g, "global_statement", _, _) ; node(_, g, "nonlocal_statement", _, _)), child(g, n, _).
matching_file_not_name(n) :- node(_, x, "except_clause", _, _), child(x, ap, _), node(_, ap, "as_pattern", _, _), field(ap, "alias", t), child(t, n, _).
.decl matching_file_name(n: node, x: symbol)
matching_file_name(n, x) :- matching_file_node(n), node(_, n, "identifier", _, _), text(n, x), !matching_file_not_name(n).
// Attribute: attr and value
.decl matching_file_attr(a: node, x: symbol, v: node)
matching_file_attr(a, x, v) :- matching_file_node(a), node(_, a, "attribute", _, _), field(a, "attribute", i), text(i, x), field(a, "object", o), matching_file_unparen(o, v).
// The ast name column of a Name or Attribute.
.decl matching_file_ref(n: node, x: symbol)
matching_file_ref(n, x) :- matching_file_name(n, x).
matching_file_ref(n, x) :- matching_file_attr(n, x, _).
// qualified: a Name's id, then `.attr` up Attribute values, the same up Call funcs. No name is built recursively:
// the checks compare a qualified name with constants only, and those tests read its components. `qual_root` is the
// chain's Name, `qual_last` its last component, `qual_part` every component, `qual_dotted` that it has an Attribute;
// `qual` its text where it has at most one Attribute, which every equality test needs (no compared name has two
// dots: `dataclasses.dataclass` the most). A prefix, suffix or substring test with a dotless constant reads the root,
// the last component or any component, exactly.
.decl matching_file_qual_root(n: node, x: symbol)
matching_file_qual_root(n, x) :- matching_file_name(n, x).
matching_file_qual_root(a, x) :- matching_file_attr(a, _, v), matching_file_qual_root(v, x).
matching_file_qual_root(c, x) :- matching_file_call(c, f), matching_file_qual_root(f, x).
.decl matching_file_qual_last(n: node, x: symbol)
matching_file_qual_last(n, x) :- matching_file_name(n, x).
matching_file_qual_last(a, x) :- matching_file_attr(a, x, v), matching_file_qual_root(v, _).
matching_file_qual_last(c, x) :- matching_file_call(c, f), matching_file_qual_last(f, x).
.decl matching_file_qual_part(n: node, x: symbol)
matching_file_qual_part(n, x) :- matching_file_name(n, x).
matching_file_qual_part(a, x) :- matching_file_attr(a, x, v), matching_file_qual_root(v, _).
matching_file_qual_part(a, x) :- matching_file_attr(a, _, v), matching_file_qual_part(v, x).
matching_file_qual_part(c, x) :- matching_file_call(c, f), matching_file_qual_part(f, x).
.decl matching_file_qual_dotted(n: node)
matching_file_qual_dotted(a) :- matching_file_attr(a, _, v), matching_file_qual_root(v, _).
matching_file_qual_dotted(c) :- matching_file_call(c, f), matching_file_qual_dotted(f).
.decl matching_file_qual(n: node, q: symbol)
matching_file_qual(n, x) :- matching_file_qual_root(n, x), !matching_file_qual_dotted(n).
matching_file_qual(a, q) :- matching_file_attr(a, x, v), matching_file_qual_root(v, r), !matching_file_qual_dotted(v), q = cat(cat(r, "."), x).
matching_file_qual(c, q) :- matching_file_call(c, f), matching_file_qual_dotted(f), matching_file_qual(f, q).
// Call: func; callee kind and name (the `calls` stage)
.decl matching_file_call(c: node, f: node)
matching_file_call(c, f) :- matching_file_node(c), node(_, c, "call", _, _), field(c, "function", f0), matching_file_unparen(f0, f).
.decl matching_file_callee(c: node, kind: symbol, x: symbol)
matching_file_callee(c, "Name", x) :- matching_file_call(c, f), matching_file_name(f, x).
matching_file_callee(c, "Attribute", x) :- matching_file_call(c, f), matching_file_attr(f, x, _).
// positional args by position, keywords
.decl matching_file_keyword_child(e: node)
matching_file_keyword_child(e) :- node(_, e, "keyword_argument", _, _).
matching_file_keyword_child(e) :- node(_, e, "dictionary_splat", _, _).
.decl matching_file_positional(c: node, e: node, j: number)
matching_file_positional(c, e, j) :- matching_file_call(c, _), field(c, "arguments", al), node(_, al, "argument_list", _, _), child(al, e, j), !matching_file_keyword_child(e).
.decl matching_file_arg(c: node, e: node, i: number)
matching_file_arg(c, e, i) :- matching_file_positional(c, e0, j), matching_file_unparen(e0, e), i = count : { matching_file_positional_before(c, j, _) }.
.decl matching_file_positional_before(c: node, j: number, k: number)
matching_file_positional_before(c, j, k) :- matching_file_positional(c, _, j), matching_file_positional(c, _, k), k < j.
matching_file_arg(c, g, 0) :- matching_file_call(c, _), field(c, "arguments", g), node(_, g, "generator_expression", _, _).
.decl matching_file_keyword(c: node, k: node, x: symbol, v: node)
matching_file_keyword(c, k, x, v) :- matching_file_call(c, _), field(c, "arguments", al), child(al, k, _), node(_, k, "keyword_argument", _, _),
    field(k, "name", i), text(i, x), field(k, "value", v0), matching_file_unparen(v0, v).
// Constant: kind and value
// mirrors python/ast.rr fstring, string_form, str_const, ast_constant
.decl matching_file_fstr(n: node)
matching_file_fstr(n) :- node(_, n, "string", _, _), strprefix(n, p), contains("f", p).
matching_file_fstr(c) :- node(_, c, "concatenated_string", _, _), child(c, s, _), matching_file_fstr(s).
// Constant: a literal that is no f-string (a concatenation is one Constant, its pieces none); its kind as
// ast_value_kind names it (value_type_of's type, NoneType as `none`), and its value as ast_value has it (`value`:
// Python's str(v), escapes decoded, pieces joined). A bytes' or complex's value (hex, `1j`) has no row: no check reads
// one (MA032's `working_memory_bytes` is neither).
.decl matching_file_literal_kind(k: symbol)
matching_file_literal_kind("string"). matching_file_literal_kind("concatenated_string"). matching_file_literal_kind("integer").
matching_file_literal_kind("float"). matching_file_literal_kind("true"). matching_file_literal_kind("false").
matching_file_literal_kind("none"). matching_file_literal_kind("ellipsis").
.decl matching_file_constant(n: node)
matching_file_constant(n) :- matching_file_node(n), node(_, n, k, _, _), matching_file_literal_kind(k), !matching_file_fstr(n), !matching_file_concat_piece(n).
.decl matching_file_const_kind(n: node, kind: symbol)
matching_file_const_kind(n, "none") :- matching_file_constant(n), value_type_of(n, "NoneType").
matching_file_const_kind(n, t) :- matching_file_constant(n), value_type_of(n, t), t != "NoneType".
.decl matching_file_const(n: node, kind: symbol, v: symbol)
matching_file_const(n, t, v) :- matching_file_const_kind(n, t), value(n, v).
// An f-string's interpolations and its literal parts (Constants: `fstring_piece`'s literal rows), in source order.
.decl matching_file_joined(n: node)
matching_file_joined(n) :- matching_file_node(n), matching_file_fstr(n), !matching_file_concat_piece(n).
.decl matching_file_concat_piece(n: node)
matching_file_concat_piece(n) :- child(p, n, _), node(_, p, "concatenated_string", _, _), matching_file_node(n).
.decl matching_file_joined_piece(n: node, p: node)
matching_file_joined_piece(n, n) :- matching_file_joined(n), node(_, n, "string", _, _).
matching_file_joined_piece(n, p) :- matching_file_joined(n), node(_, n, "concatenated_string", _, _), child(n, p, _).
.decl matching_file_interpolated(n: node)
matching_file_interpolated(n) :- matching_file_joined_piece(n, p), child(p, x, _), node(_, x, "interpolation", _, _).
// An f-string without interpolations is a JoinedStr of one Constant (its literal text, decoded, the pieces merged):
// `value` gives that text exactly.
.decl matching_file_joined_value(n: node, s: symbol)
matching_file_joined_value(n, s) :- matching_file_joined(n), !matching_file_interpolated(n), value(n, s).
// A format spec (`{x:>10}`'s `:>10`, a format_specifier, the `:` its first character) is a JoinedStr of its own,
// read by the stages like any other (static_parts' roots are every JoinedStr and Constant).
.decl matching_file_spec(fs: node)
matching_file_spec(fs) :- matching_file_node(fs), node(_, fs, "format_specifier", _, _).
// The literal parts (Constants) of an interpolated f-string n or of a spec n: `fstring_piece`'s literal rows, by index.
.decl matching_file_part(n: node, i: number, v: symbol)
matching_file_part(n, i, v) :- matching_file_interpolated(n), fstring_piece(n, i, "literal", v).
matching_file_part(n, i, v) :- matching_file_spec(n), fstring_piece(n, i, "literal", v).
// A part's window m: the number of interpolations before it (pieces alternate: a literal run between two fields).
.decl matching_file_part_window(n: node, i: number, m: number)
matching_file_part_window(n, i, m) :- matching_file_part(n, i, _), m = count : { fstring_piece(n, j, "interpolation", _), j < i }.
// A part's line, CPython's (3.12+) Constant lineno: where its run's first contributor starts. In an f-string window m
// (after the tree's m-th interpolation), the contributors in source order are a plain (non-f) piece of a
// concatenation, from its quote even when empty; an f-piece's `string_content` that decodes to some text (not only
// line continuations); and last the debug text of the next field (`{x=}`'s `x=`, from after its `{`). In a spec:
// after its `:`, else after the m-th nested field's `}`.
.decl matching_file_field(n: node, x: node, s: number)
matching_file_field(n, x, s) :- matching_file_interpolated(n), matching_file_joined_piece(n, p), child(p, x, _), node(_, x, "interpolation", s, _).
matching_file_field(n, x, s) :- matching_file_spec(n), child(n, x, _), node(_, x, "format_expression", s, _).
.decl matching_file_field_rank(n: node, x: node, m: number)
matching_file_field_rank(n, x, m) :- matching_file_field(n, x, s), m = count : { matching_file_field(n, _, t), t < s }.
.decl matching_file_empty_content(x: node)
matching_file_empty_content(x) :- child(p, x, _), node(_, x, "string_content", _, _), strprefix(p, q), !contains("r", q), node_text(x, t),
    match("(?:\\\\(?:\\r\\n|\\n|\\r))+", t).
.decl matching_file_contrib(n: node, x: node, s: number)
matching_file_contrib(n, p, s) :- matching_file_interpolated(n), matching_file_joined_piece(n, p), node(_, p, "string", s, _), !matching_file_fstr(p).
matching_file_contrib(n, x, s) :- matching_file_interpolated(n), matching_file_joined_piece(n, p), matching_file_fstr(p), child(p, x, _),
    node(_, x, "string_content", s, _), !matching_file_empty_content(x).
.decl matching_file_contrib_window(n: node, x: node, s: number, m: number)
matching_file_contrib_window(n, x, s, m) :- matching_file_contrib(n, x, s), m = count : { matching_file_field(n, _, t), t < s }.
.decl matching_file_has_contrib(n: node, m: number)
matching_file_has_contrib(n, m) :- matching_file_contrib_window(n, _, _, m).
.decl matching_file_part_line(n: node, i: number, l: number)
matching_file_part_line(n, i, l) :- matching_file_interpolated(n), matching_file_part_window(n, i, m), matching_file_has_contrib(n, m),
    s = min t : { matching_file_contrib_window(n, _, t, m) }, matching_file_contrib_window(n, x, s, m), line(x, l).
matching_file_part_line(n, i, l) :- matching_file_interpolated(n), matching_file_part_window(n, i, m), !matching_file_has_contrib(n, m),
    matching_file_field_rank(n, x, m), line(x, l).
matching_file_part_line(n, i, l) :- matching_file_spec(n), matching_file_part_window(n, i, 0), line(n, l).
matching_file_part_line(n, i, l) :- matching_file_spec(n), matching_file_part_window(n, i, m), m > 0, matching_file_field_rank(n, x, m - 1), end_line(x, l).
// The offsets into a word the checks compare static text with (the longest, vector_cosine_ops, has 17 characters).
.decl matching_file_offset(i: number)
matching_file_offset(0). matching_file_offset(1). matching_file_offset(2). matching_file_offset(3). matching_file_offset(4).
matching_file_offset(5). matching_file_offset(6). matching_file_offset(7). matching_file_offset(8). matching_file_offset(9).
matching_file_offset(10). matching_file_offset(11). matching_file_offset(12). matching_file_offset(13). matching_file_offset(14).
matching_file_offset(15). matching_file_offset(16). matching_file_offset(17).
// MA007's test, `upper(ltrim(<the literal parts joined>))` starting with a verb (upper ASCII, ltrim spaces), over the
// JoinedStr's literal parts joined in order: an interpolated f-string's or a spec's `join`, else its `value`.
.decl matching_file_sql_text(s: symbol)
matching_file_sql_text(s) :- matching_file_joined_text(_, s),
    match(" *(?:[sS][eE][lL][eE][cC][tT]|[iI][nN][sS][eE][rR][tT]|[uU][pP][dD][aA][tT][eE]|[dD][eE][lL][eE][tT][eE]|[cC][rR][eE][aA][tT][eE]|[aA][lL][tT][eE][rR])(?s:.*)", s).
.decl matching_file_joined_text(n: node, s: symbol)
matching_file_joined_text(n, s) :- matching_file_joined_value(n, s).
matching_file_joined_text(n, s) :- matching_file_interpolated(n), s = join v by i : { fstring_piece(n, i, "literal", v) }.
matching_file_joined_text(n, s) :- matching_file_spec(n), s = join v by i : { fstring_piece(n, i, "literal", v) }.
.decl matching_file_sql_fstring(n: node)
matching_file_sql_fstring(n) :- matching_file_joined_text(n, s), matching_file_sql_text(s).
// BinOp
.decl matching_file_binop(n: node, o: symbol, l: node, r: node)
matching_file_binop(n, o, l, r) :- matching_file_node(n), node(_, n, "binary_operator", _, _), op(n, o), field(n, "left", l0), field(n, "right", r0),
    matching_file_untype(l0, l), matching_file_untype(r0, r).
matching_file_binop(n, "|", l, r) :- matching_file_node(n), node(_, n, "union_type", _, _), child(n, l0, 0), child(n, r0, 1),
    matching_file_untype(l0, l), matching_file_untype(r0, r).
// Subscript: value and slice
.decl matching_file_subscript(n: node, v: node)
matching_file_subscript(n, v) :- matching_file_node(n), node(_, n, "subscript", _, _), field(n, "value", v0), matching_file_unparen(v0, v).
matching_file_subscript(n, v) :- matching_file_node(n), node(_, n, "generic_type", _, _), child(n, v, 0).
.decl matching_file_slice_subscript(n: node)
matching_file_slice_subscript(n) :- matching_file_subscript(n, _), node(_, n, "subscript", _, _), field(n, "subscript", s), node(_, s, "slice", _, _),
    !matching_file_two_subscripts(n).
.decl matching_file_two_subscripts(n: node)
matching_file_two_subscripts(n) :- node(_, n, "subscript", _, _), field(n, "subscript", a), field(n, "subscript", b), a != b.
// Assign / AnnAssign: target(s) and value
.decl matching_file_assign_stmt(a: node)
matching_file_assign_stmt(a) :- matching_file_node(a), node(_, a, "assignment", _, _), child(s, a, 0), node(_, s, "expression_statement", _, _).
// mirrors python/ast.rr assign_chain, assign_target, assign_value
.decl matching_file_chain(a: node, x: node)
matching_file_chain(a, a) :- matching_file_assign_stmt(a).
matching_file_chain(a, b) :- matching_file_chain(a, x), field(x, "right", b), node(_, b, "assignment", _, _).
.decl matching_file_target(a: node, t: node)
matching_file_target(a, t) :- matching_file_chain(a, x), field(x, "left", t0), matching_file_unparen(t0, t).
.decl matching_file_value(a: node, v: node)
matching_file_value(a, v) :- matching_file_chain(a, x), field(x, "right", v0), !node(_, v0, "assignment", _, _), matching_file_unparen(v0, v).
// Statement assignments with a Name target (Assign `targets` / AnnAssign `target`).
.decl matching_file_named_target(a: node, t: node, x: symbol)
matching_file_named_target(a, t, x) :- matching_file_target(a, t), matching_file_name(t, x).
// Functions, classes, parameters
.decl matching_file_def(f: node, x: symbol)
matching_file_def(f, x) :- matching_file_node(f), node(_, f, "function_definition", _, _), field(f, "name", i), text(i, x).
.decl matching_file_class(c: node, x: symbol)
matching_file_class(c, x) :- matching_file_node(c), node(_, c, "class_definition", _, _), field(c, "name", i), text(i, x).
// A def's or class's span with its decorators: its subtree.
.decl matching_file_span(f: node, d: number, s: number, e: number)
matching_file_span(f, d, s, e) :- (matching_file_def(f, _) ; matching_file_class(f, _)), child(w, f, _), node(d, w, "decorated_definition", s, e).
matching_file_span(f, d, s, e) :- (matching_file_def(f, _) ; matching_file_class(f, _)), node(d, f, _, s, e), !matching_file_decorated(f).
.decl matching_file_decorated(f: node)
matching_file_decorated(f) :- child(w, f, _), node(_, w, "decorated_definition", _, _).
// mirrors python/ast.rr sig_param (in_params, param_parts, param_kind)
// parameters: arg p of def f, its name, field (posonlyargs, args, vararg, kwonlyargs, kwarg) and annotation
.decl matching_file_param_node(f: node, p: node, i: number, x: symbol, form: symbol)
matching_file_param_node(f, p, i, x, "plain") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, p, i), node(_, p, "identifier", _, _), text(p, x).
matching_file_param_node(f, p, i, x, "plain") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, p, i), node(_, p, "typed_parameter", _, _),
    child(p, n, 0), node(_, n, "identifier", _, _), text(n, x).
matching_file_param_node(f, p, i, x, "star") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, p, i), node(_, p, "typed_parameter", _, _),
    child(p, s, 0), node(_, s, "list_splat_pattern", _, _), child(s, n, 0), text(n, x).
matching_file_param_node(f, p, i, x, "dstar") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, p, i), node(_, p, "typed_parameter", _, _),
    child(p, s, 0), node(_, s, "dictionary_splat_pattern", _, _), child(s, n, 0), text(n, x).
matching_file_param_node(f, p, i, x, "plain") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, p, i),
    (node(_, p, "default_parameter", _, _) ; node(_, p, "typed_default_parameter", _, _)), field(p, "name", n), text(n, x).
matching_file_param_node(f, p, i, x, "star") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, p, i), node(_, p, "list_splat_pattern", _, _),
    child(p, n, 0), text(n, x).
matching_file_param_node(f, p, i, x, "dstar") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, p, i), node(_, p, "dictionary_splat_pattern", _, _),
    child(p, n, 0), text(n, x).
.decl matching_file_separator(f: node, i: number, k: symbol)
matching_file_separator(f, i, "/") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, s, i), node(_, s, "positional_separator", _, _).
matching_file_separator(f, i, "*") :- matching_file_def(f, _), field(f, "parameters", ps), child(ps, s, i), node(_, s, "keyword_separator", _, _).
matching_file_separator(f, i, "*") :- matching_file_param_node(f, _, i, _, "star").
.decl matching_file_param(f: node, p: node, i: number, x: symbol, fld: symbol)
matching_file_param(f, p, i, x, "vararg") :- matching_file_param_node(f, p, i, x, "star").
matching_file_param(f, p, i, x, "kwarg") :- matching_file_param_node(f, p, i, x, "dstar").
matching_file_param(f, p, i, x, "posonlyargs") :- matching_file_param_node(f, p, i, x, "plain"), matching_file_separator(f, j, "/"), i < j.
matching_file_param(f, p, i, x, "kwonlyargs") :- matching_file_param_node(f, p, i, x, "plain"), matching_file_separator(f, j, "*"), j < i.
matching_file_param(f, p, i, x, "args") :- matching_file_param_node(f, p, i, x, "plain"), !matching_file_before_slash(f, i), !matching_file_after_star(f, i).
.decl matching_file_before_slash(f: node, i: number)
matching_file_before_slash(f, i) :- matching_file_param_node(f, _, i, _, "plain"), matching_file_separator(f, j, "/"), i < j.
.decl matching_file_after_star(f: node, i: number)
matching_file_after_star(f, i) :- matching_file_param_node(f, _, i, _, "plain"), matching_file_separator(f, j, "*"), j < i.
.decl matching_file_param_annotation(p: node, a: node)
matching_file_param_annotation(p, a) :- matching_file_param(_, p, _, _, _), field(p, "type", t), matching_file_untype(t, a).
// The positional parameters' index (posonlyargs, then args): `argument_index`.
.decl matching_file_positional_param(f: node, p: node, i: number, x: symbol)
matching_file_positional_param(f, p, i, x) :- matching_file_param(f, p, i, x, k), (k = "posonlyargs" ; k = "args").
// mirrors names.rr decorator: decorators of a def or class (the decorator_list), their expressions.
.decl matching_file_decorator(f: node, e: node)
matching_file_decorator(f, e) :- (matching_file_def(f, _) ; matching_file_class(f, _)), child(w, f, _), node(_, w, "decorated_definition", _, _),
    child(w, k, _), node(_, k, "decorator", _, _), child(k, e0, 0), matching_file_unparen(e0, e).
// Class bases (positional superclasses)
.decl matching_file_base(c: node, b: node)
matching_file_base(c, b) :- matching_file_class(c, _), field(c, "superclasses", al), child(al, b0, _), !matching_file_keyword_child(b0), matching_file_unparen(b0, b).
// Imports: matching_imports (one row per Import alias, one per ImportFrom)
.decl matching_file_import(d: number, n: node, module: symbol)
matching_file_import(d, n, m) :- matching_file_doc(d), node(d, n, "import_statement", _, _), child(n, a, _), node(_, a, "dotted_name", _, _), name(a, m).
matching_file_import(d, n, m) :- matching_file_doc(d), node(d, n, "import_statement", _, _), child(n, a, _), node(_, a, "aliased_import", _, _),
    field(a, "name", q), name(q, m).
matching_file_import(d, n, m) :- matching_file_doc(d), node(d, n, "import_from_statement", _, _), matching_file_from_module(n, m).
.decl matching_file_from_module(n: node, m: symbol)
matching_file_from_module(n, m) :- node(_, n, "import_from_statement", _, _), field(n, "module_name", q), node(_, q, "dotted_name", _, _), name(q, m).
matching_file_from_module(n, m) :- node(_, n, "import_from_statement", _, _), field(n, "module_name", r), node(_, r, "relative_import", _, _),
    child(r, q, _), node(_, q, "dotted_name", _, _), name(q, m).
// An ImportFrom's alias names (`from m import a, b as c`: a, b).
.decl matching_file_from_alias(n: node, x: symbol)
matching_file_from_alias(n, x) :- node(_, n, "import_from_statement", _, _), field(n, "name", q), node(_, q, "dotted_name", _, _), name(q, x).
matching_file_from_alias(n, x) :- node(_, n, "import_from_statement", _, _), field(n, "name", a), node(_, a, "aliased_import", _, _), field(a, "name", q), name(q, x).

// A node's subtree: x within r's span (r itself included); a def's or class's span includes its decorators.
.decl matching_file_in(x: node, r: node)
.decl matching_file_probe(x: node, r: node)
matching_file_in(x, r) :- matching_file_probe(x, r), matching_file_span(r, d, s, e), node(d, x, _, xs, xe), xs >= s, xe <= e.
matching_file_in(x, r) :- matching_file_probe(x, r), !matching_file_span(r, _, _, _), node(d, r, _, s, e), node(d, x, _, xs, xe), xs >= s, xe <= e.

// type_labels: the labels of an annotation's leaves (Subscript values, BitOr sides), in order, joined by `|`; a
// leaf's label its qualified name if a Name or Attribute, else ''. The checks test the joined label for equality
// with a name, a prefix, a suffix or a substring, none holding `|` or `.`; so those are, exactly: a root of one leaf
// and its label (label_is, where the label has at most one dot, `qual`), the first leaf's root component
// (label_first), the last leaf's last component (label_last), any leaf's any component (label_any).
.decl matching_file_type_root(t: node)
matching_file_type_root(a) :- matching_file_param_annotation(_, a).
matching_file_type_root(a) :- matching_file_class_field(_, _, _, a, _).
matching_file_type_root(b) :- matching_file_base(_, b).
matching_file_type_root(t) :- matching_file_handler(_, _, t).
.decl matching_file_type_part(t: node)
matching_file_type_part(t) :- matching_file_type_root(t).
matching_file_type_part(v) :- matching_file_type_part(t), matching_file_subscript(t, v0), matching_file_untype(v0, v).
matching_file_type_part(l) :- matching_file_type_part(t), matching_file_binop(t, "|", l, _).
matching_file_type_part(r) :- matching_file_type_part(t), matching_file_binop(t, "|", _, r).
.decl matching_file_leaf_node(t: node)
matching_file_leaf_node(t) :- matching_file_type_part(t), !matching_file_subscript(t, _), !matching_file_binop(t, "|", _, _).
.decl matching_file_leaf(t: node, s: symbol)
matching_file_leaf(t, s) :- matching_file_leaf_node(t), matching_file_ref(t, _), matching_file_qual(t, s).
matching_file_leaf(t, "") :- matching_file_leaf_node(t), !matching_file_ref(t, _).
matching_file_leaf(t, "") :- matching_file_leaf_node(t), matching_file_ref(t, _), !matching_file_qual_root(t, _).
.decl matching_file_first_leaf(t: node, x: node)
matching_file_first_leaf(t, t) :- matching_file_leaf_node(t).
matching_file_first_leaf(t, x) :- matching_file_type_part(t), matching_file_subscript(t, v0), matching_file_untype(v0, v), matching_file_first_leaf(v, x).
matching_file_first_leaf(t, x) :- matching_file_type_part(t), matching_file_binop(t, "|", l, _), matching_file_first_leaf(l, x).
.decl matching_file_last_leaf(t: node, x: node)
matching_file_last_leaf(t, t) :- matching_file_leaf_node(t).
matching_file_last_leaf(t, x) :- matching_file_type_part(t), matching_file_subscript(t, v0), matching_file_untype(v0, v), matching_file_last_leaf(v, x).
matching_file_last_leaf(t, x) :- matching_file_type_part(t), matching_file_binop(t, "|", _, r), matching_file_last_leaf(r, x).
.decl matching_file_any_leaf(t: node, x: node)
matching_file_any_leaf(t, t) :- matching_file_leaf_node(t).
matching_file_any_leaf(t, x) :- matching_file_type_part(t), matching_file_subscript(t, v0), matching_file_untype(v0, v), matching_file_any_leaf(v, x).
matching_file_any_leaf(t, x) :- matching_file_type_part(t), matching_file_binop(t, "|", l, _), matching_file_any_leaf(l, x).
matching_file_any_leaf(t, x) :- matching_file_type_part(t), matching_file_binop(t, "|", _, r), matching_file_any_leaf(r, x).
.decl matching_file_multi(t: node)
matching_file_multi(t) :- matching_file_type_part(t), matching_file_binop(t, "|", _, _).
matching_file_multi(t) :- matching_file_type_part(t), matching_file_subscript(t, v0), matching_file_untype(v0, v), matching_file_multi(v).
.decl matching_file_label_is(t: node, s: symbol)
matching_file_label_is(t, s) :- matching_file_first_leaf(t, x), !matching_file_multi(t), matching_file_leaf(x, s).
.decl matching_file_label_first(t: node, s: symbol)
matching_file_label_first(t, s) :- matching_file_first_leaf(t, x), matching_file_ref(x, _), matching_file_qual_root(x, s).
.decl matching_file_label_last(t: node, s: symbol)
matching_file_label_last(t, s) :- matching_file_last_leaf(t, x), matching_file_ref(x, _), matching_file_qual_last(x, s).
.decl matching_file_label_any(t: node, s: symbol)
matching_file_label_any(t, s) :- matching_file_any_leaf(t, x), matching_file_ref(x, _), matching_file_qual_part(x, s).

// unsafe_annotations
.decl matching_file_unsafe_name(x: symbol)
matching_file_unsafe_name("Any"). matching_file_unsafe_name("Mapping"). matching_file_unsafe_name("bool"). matching_file_unsafe_name("bytes").
matching_file_unsafe_name("dict"). matching_file_unsafe_name("float"). matching_file_unsafe_name("int"). matching_file_unsafe_name("list").
matching_file_unsafe_name("object"). matching_file_unsafe_name("set"). matching_file_unsafe_name("str"). matching_file_unsafe_name("tuple").
.decl matching_file_unsafe(n: node)
matching_file_unsafe(n) :- matching_file_type_part(n), matching_file_qual(n, q), matching_file_ref(n, _), matching_file_unsafe_name(q).
matching_file_unsafe(n) :- matching_file_type_part(n), matching_file_const(n, "none", _).
matching_file_unsafe(n) :- matching_file_binop(n, "|", l, _), matching_file_unsafe(l).
matching_file_unsafe(n) :- matching_file_binop(n, "|", _, r), matching_file_unsafe(r).

// matching_fields: an AnnAssign `name: T` directly in a class body
.decl matching_file_class_field(c: node, a: node, x: symbol, ann: node, cls: symbol)
matching_file_class_field(c, a, x, v, k) :- matching_file_class(c, k), field(c, "body", b), child(b, s, _), node(_, s, "expression_statement", _, _),
    child(s, a, 0), matching_file_assign_stmt(a), field(a, "type", t), matching_file_untype(t, v), field(a, "left", t0), node(_, t0, "identifier", _, _), text(t0, x).

// static_strings: a str Constant, an f-string without interpolation, an f-string's literal part, or an Add of them.
// An f-string without interpolation stands for its one Constant part too: the part has the same text and is no
// earlier (MA002 takes the first line). The literal parts of an interpolated f-string or of a spec are no tree node
// and in no Add (an Add's JoinedStr is a main f-string's): MA002 reads them apart (`matching_file_part`).
.decl matching_file_static_leaf(n: node, s: symbol)
matching_file_static_leaf(n, s) :- matching_file_const(n, "str", s).
matching_file_static_leaf(n, s) :- matching_file_joined_value(n, s).
.decl matching_file_is_static(n: node)
matching_file_is_static(n) :- matching_file_const_kind(n, "str").
matching_file_is_static(n) :- matching_file_joined(n), !matching_file_interpolated(n).
matching_file_is_static(n) :- matching_file_binop(n, "+", l, r), matching_file_is_static(l), matching_file_is_static(r).
// MA002's `lower(text) IN (<words>)`, at any depth without building the text: `static_part(n, w, i, j)`, n's static
// text is w's characters i to j, ASCII case ignored (lower).
.decl matching_file_physical_word(w: symbol)
matching_file_physical_word("bit_hamming_ops"). matching_file_physical_word("halfvec"). matching_file_physical_word("hnsw").
matching_file_physical_word("ivfflat"). matching_file_physical_word("pgvector"). matching_file_physical_word("sql_table_hnsw").
matching_file_physical_word("usearch"). matching_file_physical_word("vector_cosine_ops").
.decl matching_file_static_part(n: node, w: symbol, i: number, j: number)
matching_file_static_part(n, w, i, j) :- matching_file_static_leaf(n, s), matching_file_physical_word(w), matching_file_offset(i), k = strlen(s),
    j = i + k, j <= strlen(w), p = cat(cat("(?i-u:", substr(w, i, k)), ")"), match(p, s).
matching_file_static_part(n, w, i, j) :- matching_file_binop(n, "+", l, r), matching_file_static_part(l, w, i, k), matching_file_static_part(r, w, k, j).

// Handlers: an ExceptHandler of Try n, its type (absent: `except:`)
.decl matching_file_handler(n: node, h: node, t: node)
matching_file_handler(n, h, t) :- matching_file_try_handler(n, h), child(h, e, 0), !node(_, e, "block", _, _), !node(_, e, "as_pattern", _, _), matching_file_unparen(e, t).
matching_file_handler(n, h, t) :- matching_file_try_handler(n, h), child(h, e, 0), node(_, e, "as_pattern", _, _), child(e, e1, 0), matching_file_unparen(e1, t).
.decl matching_file_try_handler(n: node, h: node)
matching_file_try_handler(n, h) :- matching_file_node(n), node(_, n, "try_statement", _, _), child(n, h, _), (node(_, h, "except_clause", _, _) ; node(_, h, "except_group_clause", _, _)).

.decl matching_file_tuple(n: node)
matching_file_tuple(n) :- matching_file_node(n), (node(_, n, "tuple", _, _) ; node(_, n, "expression_list", _, _)).

// ---- the diagnostics ----
.decl matching_file_finding(d: number, code: symbol, n: node)
.decl matching_file_finding_line(d: number, code: symbol, l: number)
matching_file_finding_line(d, c, l) :- matching_file_finding(d, c, n), line(n, l).

// MA001 (application) / MA026 (implementation): the first Name or Attribute BackendType in the file.
.decl matching_file_backend(d: number, n: node)
matching_file_backend(d, n) :- matching_file_ref(n, "BackendType"), node(d, n, _, _, _).
matching_file_finding_line(d, "MA001", l) :- matching_file_application(d), matching_file_backend(d, _), l = min x : { matching_file_backend(d, n), line(n, x) }.
matching_file_finding_line(d, "MA026", l) :- matching_file_implementation(d), matching_file_backend(d, _), l = min x : { matching_file_backend(d, n), line(n, x) }.

// MA002 (application): the first static string naming a physical access method, ASCII case ignored.
.decl matching_file_physical(d: number, l: number)
matching_file_physical(d, l) :- matching_file_is_static(n), matching_file_static_part(n, w, 0, j), j = strlen(w), node(d, n, _, _, _), line(n, l).
matching_file_physical(d, l) :- matching_file_part(n, i, v), node(d, n, _, _, _),
    match("(?i-u:bit_hamming_ops|halfvec|hnsw|ivfflat|pgvector|sql_table_hnsw|usearch|vector_cosine_ops)", v), matching_file_part_line(n, i, l).
matching_file_finding_line(d, "MA002", l) :- matching_file_application(d), matching_file_physical(d, _), l = min x : { matching_file_physical(d, x) }.

// Imports: MA015, MA036 (conformance), MA010 (application), MA041, MA019 (facade), MA008 (layer < 5250).
.decl matching_file_impl_module(m: symbol)
matching_file_impl_module(m) :- matching_file_import(_, _, m), (m = "impl" ; prefix("impl.", m)).
matching_file_finding(d, "MA015", n) :- matching_file_conformance(d), matching_file_import(d, n, m), matching_file_impl_module(m).
matching_file_finding(d, "MA015", n) :- matching_file_conformance(d), matching_file_import(d, n, m), match("l[0-9]{4}_.*", m).
matching_file_finding(d, "MA036", n) :- matching_file_conformance(d), matching_file_import(d, n, "data_layer_testing.matching_operator").
matching_file_finding(d, "MA036", n) :- matching_file_conformance(d), matching_file_import(d, n, "data_layer_testing"), matching_file_from_alias(n, "matching_operator").
matching_file_finding(d, "MA010", n) :- matching_file_application(d), matching_file_import(d, n, m), matching_file_impl_module(m).
matching_file_finding(d, "MA041", n) :- matching_file_facade(d), matching_file_import(d, n, m), (m = "data_layer_testing" ; prefix("data_layer_testing.", m)).
matching_file_finding(d, "MA019", n) :- matching_file_facade(d), matching_file_import(d, n, m), matching_file_impl_module(m).
matching_file_finding(d, "MA008", n) :- matching_file_lower_layer(d), matching_file_import(d, n, m), (m = "l5250_matching" ; prefix("l5250_matching.", m)).

// MA016 (conformance), MA006 (matching): calls by callee.
matching_file_finding(d, "MA016", c) :- matching_file_conformance(d), matching_file_callee(c, _, "nonportably_execute_sql"), node(d, c, _, _, _).
matching_file_finding(d, "MA006", c) :- matching_file_matching(d), matching_file_callee(c, "Attribute", "import_module"), node(d, c, _, _, _).
matching_file_finding(d, "MA006", c) :- matching_file_matching(d), matching_file_callee(c, "Name", x), (x = "__import__" ; x = "import_module"), node(d, c, _, _, _).

// MA031 (implementation): len(X_SQL_STAGES); counters fed by predictions; planned_database_round_trips = ...
matching_file_finding(d, "MA031", c) :- matching_file_implementation(d), matching_file_callee(c, _, "len"), matching_file_arg(c, a, 0), matching_file_name(a, x),
    suffix("_SQL_STAGES", x), node(d, c, _, _, _).
.decl matching_file_predicted(d: number, x: symbol)
matching_file_predicted(d, x) :- matching_file_named_target(a, _, x), matching_file_value(a, v), node(d, a, _, _, _),
    matching_file_value_has(v, "binop"), matching_file_value_has(v, "counter_name").
.decl matching_file_value_has(v: node, what: symbol)
matching_file_probe(x, v) :- matching_file_named_target(a, _, _), matching_file_value(a, v), node(d, v, _, _, _), node(d, x, _, _, _), matching_file_binop(x, _, _, _).
matching_file_probe(x, v) :- matching_file_named_target(a, _, _), matching_file_value(a, v), node(d, v, _, _, _), node(d, x, _, _, _),
    matching_file_name(x, y), (y = "pair_evaluations" ; y = "expression_node_count").
matching_file_value_has(v, "binop") :- matching_file_in(x, v), matching_file_binop(x, _, _, _).
matching_file_value_has(v, "counter_name") :- matching_file_in(x, v), matching_file_name(x, y), (y = "pair_evaluations" ; y = "expression_node_count").
matching_file_finding(d, "MA031", c) :- matching_file_implementation(d), matching_file_callee(c, _, "MatchDatabaseRoundTripCount"), matching_file_arg(c, v, 0),
    matching_file_callee(v, _, "len"), matching_file_arg(v, a, 0), matching_file_name(a, x), !match(".*[a-z].*", x), node(d, c, _, _, _).
matching_file_probe(x, v) :- matching_file_callee(c, _, "MatchExpressionEvaluationCount"), matching_file_arg(c, v, 0), node(d, v, _, _, _), node(d, x, _, _, _),
    matching_file_name(x, "pair_evaluations").
matching_file_finding(d, "MA031", c) :- matching_file_implementation(d), matching_file_callee(c, _, "MatchExpressionEvaluationCount"), matching_file_arg(c, v, 0),
    matching_file_in(x, v), matching_file_name(x, "pair_evaluations"), node(d, c, _, _, _).
matching_file_finding(d, "MA031", c) :- matching_file_implementation(d), matching_file_callee(c, _, "MatchExpressionEvaluationCount"), matching_file_arg(c, v, 0),
    matching_file_name(v, x), node(d, c, _, _, _), matching_file_predicted(d, x).
matching_file_finding(d, "MA031", c) :- matching_file_implementation(d), matching_file_callee(c, _, "MatchStageOperationCount"), matching_file_arg(c, v, 0),
    matching_file_name(v, "hydration_operations"), node(d, c, _, _, _).
matching_file_finding(d, "MA031", a) :- matching_file_implementation(d), matching_file_named_target(a, _, "planned_database_round_trips"), node(d, a, _, _, _).

// MA011 (application): a static string where a match call (or a function forwarding to one) takes its spec.
// The forwarding function: the last (preorder: node id, then call id) `name` with a parameter forwarded as match's
// positional argument 1.
.decl matching_file_forward(d: number, x: symbol, f: node, c: node, i: number)
matching_file_probe(c, f) :- matching_file_def(f, _), matching_file_callee(c, _, m), (m = "match" ; m = "match_async" ; m = "match_lazy"), node(d, f, _, _, _), node(d, c, _, _, _).
// Preorder is source order here: the last def by start offset, then its last such call.
matching_file_forward(d, x, f, c, i) :- matching_file_def(f, x), matching_file_callee(c, _, m), matching_file_match_name(m),
    matching_file_in(c, f), matching_file_positional_param(f, _, j, y), matching_file_arg(c, a, 1), matching_file_name(a, y),
    node(d, f, _, _, _), i = count : { matching_file_param_before(f, j, _) }.
.decl matching_file_param_before(f: node, j: number, k: number)
matching_file_param_before(f, j, k) :- matching_file_positional_param(f, _, j, _), matching_file_positional_param(f, _, k, _), k < j.
.decl matching_file_forward_last(d: number, x: symbol, f: node)
matching_file_forward_last(d, x, f) :- matching_file_forward(d, x, _, _, _), s = max t : { matching_file_forward(d, x, g, _, _), node(_, g, _, t, _) },
    matching_file_forward(d, x, f, _, _), node(_, f, _, s, _).
.decl matching_file_forward_index(d: number, x: symbol, i: number)
matching_file_forward_index(d, x, i) :- matching_file_forward_last(d, x, f), s = max t : { matching_file_forward(d, x, f, k, _), node(_, k, _, t, _) },
    matching_file_forward(d, x, f, c, i), node(_, c, _, s, _).
.decl matching_file_match_name(x: symbol)
matching_file_match_name("match"). matching_file_match_name("match_async"). matching_file_match_name("match_lazy").
matching_file_finding(d, "MA011", c) :- matching_file_application(d), matching_file_callee(c, _, m), (m = "match" ; m = "match_async" ; m = "match_lazy"),
    matching_file_arg(c, a, 1), matching_file_is_static(a), node(d, c, _, _, _).
matching_file_finding(d, "MA011", c) :- matching_file_application(d), matching_file_callee(c, _, x), node(d, c, _, _, _), !matching_file_match_name(x),
    matching_file_forward_index(d, x, i), matching_file_arg(c, a, i), matching_file_is_static(a).

// MA007 (matching): a JoinedStr (an f-string or a spec) whose literal parts, joined, start (spaces trimmed, ASCII case
// ignored) with a SQL verb.
matching_file_finding(d, "MA007", n) :- matching_file_matching(d), matching_file_sql_fstring(n), node(d, n, _, _, _).

// MA004 (matching): a try with a broad or Match* handler, and a handler returning a call.
.decl matching_file_broad(n: node)
matching_file_broad(n) :- matching_file_try_handler(n, h), !matching_file_handler(n, h, _).
matching_file_broad(n) :- matching_file_handler(n, _, t), matching_file_label_is(t, s), (s = "Exception" ; s = "BaseException").
matching_file_broad(n) :- matching_file_handler(n, _, t), matching_file_label_first(t, s), prefix("Match", s).
matching_file_probe(r, h) :- matching_file_try_handler(_, h), node(d, h, _, _, _), node(d, r, "return_statement", _, _).
.decl matching_file_returns_call(n: node)
matching_file_returns_call(n) :- matching_file_try_handler(n, h), matching_file_in(r, h), node(_, r, "return_statement", _, _), child(r, v0, 0),
    matching_file_unparen(v0, v), matching_file_call(v, _).
matching_file_finding(d, "MA004", n) :- matching_file_matching(d), matching_file_broad(n), matching_file_returns_call(n), node(d, n, _, _, _).

// MA027 (implementation): the first raw SQL call in the file.
.decl matching_file_raw_sql(d: number, c: node)
matching_file_raw_sql(d, c) :- matching_file_callee(c, _, x), (x = "nonportably_execute_sql" ; x = "SqlRaw" ; x = "SqlFragment"), node(d, c, _, _, _).
matching_file_raw_sql(d, c) :- matching_file_callee(c, _, x), (x = "execute" ; x = "executemany"), matching_file_arg(c, a, 0),
    (matching_file_constant(a) ; matching_file_joined(a)), node(d, c, _, _, _).
matching_file_finding_line(d, "MA027", l) :- matching_file_implementation(d), matching_file_raw_sql(d, _), l = min x : { matching_file_raw_sql(d, c), line(c, x) }.

// MA021 (facade): the first physical resolution in the file.
.decl matching_file_physical_kind(x: symbol)
matching_file_physical_kind("MatchAccessMethodKind").
matching_file_physical_kind("MatchPhysicalStageKind").
.decl matching_file_resolution(d: number, n: node)
matching_file_resolution(d, n) :- matching_file_attr(n, _, v), matching_file_qual(v, q), matching_file_physical_kind(q), node(d, n, _, _, _).
matching_file_resolution(d, c) :- matching_file_callee(c, _, x), prefix("build_", x), contains("match", x), node(d, c, _, _, _).
matching_file_finding_line(d, "MA021", l) :- matching_file_facade(d), matching_file_resolution(d, _), l = min x : { matching_file_resolution(d, n), line(n, x) }.

// Contract classes in l1470_matching_contracts/: MA020, MA030, MA009 (fields), MA012, MA013, MA014 (classes).
.decl matching_file_contracts(d: number)
matching_file_contracts(d) :- matching_file_doc(d), doc(d, p, _), prefix("l1470_matching_contracts/", p).
matching_file_finding(d, "MA020", a) :- matching_file_contracts(d), matching_file_class_field(c, a, x, _, "MatchSpec"), node(d, c, _, _, _),
    match(".*([aA][rR][tT][iI][fF][aA][cC][tT]|[aA][cC][cC][eE][sS][sS]_[mM][eE][tT][hH][oO][dD]|[pP][hH][yY][sS][iI][cC][aA][lL]|[iI][nN][dD][eE][xX]_[gG][eE][nN][eE][rR][aA][tT][iI][oO][nN]|[wW][aA][tT][eE][rR][mM][aA][rR][kK]).*", x).
.decl matching_file_recursive(s: symbol)
matching_file_recursive("MatchArtifactState"). matching_file_recursive("MatchComplexityBound"). matching_file_recursive("MatchDuplicatePairPolicySpec").
matching_file_recursive("MatchExplanationPolicy"). matching_file_recursive("MatchFilterSpec"). matching_file_recursive("MatchFreshnessDiagnostics").
matching_file_recursive("MatchFreshnessPolicySpec"). matching_file_recursive("MatchIdentitySpec"). matching_file_recursive("MatchMissingRepresentationPolicySpec").
matching_file_recursive("MatchPageState"). matching_file_recursive("MatchPaginationSpec"). matching_file_recursive("MatchPruningBound").
matching_file_recursive("MatchRepresentationAvailabilitySpec"). matching_file_recursive("MatchRepresentationSpec"). matching_file_recursive("MatchResultShapeSpec").
matching_file_recursive("MatchScoreExpression").
matching_file_finding(d, "MA030", a) :- matching_file_contracts(d), matching_file_class_field(c, a, _, v, k), prefix("Match", k), node(d, c, _, _, _),
    matching_file_label_is(v, s), matching_file_recursive(s).
matching_file_finding(d, "MA009", a) :- matching_file_contracts(d), matching_file_class_field(c, a, _, v, k), prefix("Match", k), node(d, c, _, _, _), matching_file_unsafe(v).
matching_file_finding(d, "MA012", c) :- matching_file_contracts(d), matching_file_class(c, k), prefix("Match", k), node(d, c, _, _, _),
    matching_file_base(c, b), matching_file_label_last(b, s), suffix("Protocol", s).
matching_file_finding(d, "MA013", c) :- matching_file_contracts(d), matching_file_class(c, k), prefix("Match", k), node(d, c, _, _, _),
    matching_file_decorator(c, e), !matching_file_call_of_call(e), matching_file_qual(e, q), (q = "dataclass" ; q = "dataclasses.dataclass").
// single_decorators' kind is the func's for a Call (coalesce(c.kind, d.kind)): only a Call of a Call is left out.
.decl matching_file_call_of_call(e: node)
matching_file_call_of_call(e) :- matching_file_call(e, f), matching_file_call(f, _).
.decl matching_file_two_targets(a: node)
matching_file_two_targets(a) :- matching_file_target(a, t1), matching_file_target(a, t2), t1 != t2.
.decl matching_file_frozen_config(c: node)
matching_file_frozen_config(c) :- matching_file_class(c, _), field(c, "body", b), child(b, s, _), node(_, s, "expression_statement", _, _), child(s, a, 0),
    matching_file_assign_stmt(a), !field(a, "type", _), matching_file_named_target(a, _, "model_config"), !matching_file_two_targets(a),
    matching_file_value(a, v), matching_file_call(v, f), matching_file_qual(f, "ConfigDict"), matching_file_keyword(v, _, "frozen", k),
    matching_file_const(k, "bool", "True").
matching_file_finding(d, "MA014", c) :- matching_file_contracts(d), matching_file_class(c, k), prefix("Match", k), node(d, c, _, _, _),
    matching_file_base(c, b), matching_file_label_last(b, s), suffix("BaseModel", s), !matching_file_frozen_config(c).

// Calls in a def's subtree: MA028, MA025, and the first-per-def checks MA039, MA040, MA029, MA023, MA018; MA022 on
// subscripts.
.decl matching_file_def_call(f: node, c: node)
matching_file_probe(c, f) :- matching_file_call(c, _), inside(c, f, matching_file_kind), matching_file_def(f, _).
matching_file_probe(c, f) :- matching_file_call(c, _), inside(c, k, matching_file_decorator_kind), child(w, k, _), field(w, "definition", f), matching_file_def(f, _).
matching_file_def_call(f, c) :- matching_file_def(f, _), matching_file_call(c, _), matching_file_in(c, f).
.decl matching_file_def_node(f: node, n: node)
matching_file_probe(n, f) :- matching_file_slice_subscript(n), inside(n, f, matching_file_kind), matching_file_def(f, _).
matching_file_probe(n, f) :- matching_file_slice_subscript(n), inside(n, k, matching_file_decorator_kind), child(w, k, _), field(w, "definition", f), matching_file_def(f, _).
matching_file_def_node(f, n) :- matching_file_def(f, _), matching_file_slice_subscript(n), matching_file_in(n, f).

matching_file_finding(d, "MA028", c) :- matching_file_matching(d), !matching_file_conformance(d), matching_file_def_call(_, c), matching_file_callee(c, "Attribute", "model_copy"),
    matching_file_keyword(c, _, "update", _), node(d, c, _, _, _).
matching_file_finding(d, "MA025", c) :- matching_file_conformance(d), matching_file_def_call(_, c), matching_file_callee(c, "Attribute", x),
    (x = "model_construct" ; x = "model_copy"), node(d, c, _, _, _).

.decl matching_file_first(d: number, code: symbol, f: node, n: node)
matching_file_probe(x, c) :- matching_file_callee(c, _, "SqlIsNull"), node(d, c, _, _, _), node(d, x, _, _, _), matching_file_attr(x, "candidate_kernel", _).
matching_file_first(d, "MA039", f, c) :- matching_file_implementation(d), matching_file_def(f, x), contains("expression_operation_receipt", x),
    matching_file_def_call(f, c), matching_file_callee(c, _, "_sql_canonical_identity"), node(d, f, _, _, _).
matching_file_first(d, "MA040", f, c) :- matching_file_implementation(d), matching_file_def(f, x), contains("candidate", x),
    matching_file_def_call(f, c), matching_file_callee(c, _, "SqlIsNull"), matching_file_in(k, c), matching_file_attr(k, "candidate_kernel", _), node(d, f, _, _, _).
matching_file_first(d, "MA029", f, c) :- matching_file_implementation(d), matching_file_def(f, x),
    match(".*([dD][eE][dD][uU][pP][lL][iI][cC][aA][tT]|[rR][aA][nN][kK]).*", x),
    matching_file_def_call(f, c), matching_file_callee(c, _, y), (y = "sorted" ; y = "setdefault"), node(d, f, _, _, _).
matching_file_first(d, "MA022", f, n) :- matching_file_implementation(d), matching_file_def(f, x), match(".*[pP][aA][gG][iI][nN][aA][tT].*", x),
    matching_file_def_node(f, n), node(d, f, _, _, _).
.decl matching_file_constant_arg(c: node)
matching_file_probe(k, a) :- matching_file_arg(c, a, _), matching_file_binop(a, _, _, _), matching_file_callee(c, _, _), node(d, a, _, _, _), node(d, k, _, _, _),
    matching_file_constant(k).
matching_file_constant_arg(c) :- matching_file_arg(c, a, _), matching_file_constant(a).
matching_file_constant_arg(c) :- matching_file_arg(c, a, _), matching_file_binop(a, _, _, _), matching_file_in(k, a), matching_file_constant(k).
matching_file_first(d, "MA023", f, c) :- matching_file_implementation(d), matching_file_def_call(f, c), matching_file_callee(c, _, x), prefix("Match", x),
    suffix("Count", x), matching_file_constant_arg(c), node(d, f, _, _, _).
matching_file_first(d, "MA018", f, c) :- matching_file_matching(d), matching_file_def(f, x), contains("dispatch", x),
    matching_file_def_call(f, c), matching_file_callee(c, "Attribute", "get"), matching_file_arg(c, _, 1), node(d, f, _, _, _).
// MA017 (matching): the first parameter of a dispatch def annotated `str`.
matching_file_first(d, "MA017", f, p) :- matching_file_matching(d), matching_file_def(f, x), contains("dispatch", x),
    matching_file_param(f, p, _, _, k), (k = "posonlyargs" ; k = "args" ; k = "kwonlyargs"), matching_file_param_annotation(p, a), matching_file_label_is(a, "str"),
    node(d, f, _, _, _).
.decl matching_file_first_line(d: number, code: symbol, f: node, l: number)
matching_file_first_line(d, k, f, l) :- matching_file_first(d, k, f, _), l = min x : { matching_file_first(d, k, f, n), line(n, x) }.
matching_file_finding_line(d, k, l) :- matching_file_first_line(d, k, _, l).

// MA003 (layer < 5250): a method named match* in a class.
matching_file_finding(d, "MA003", f) :- matching_file_lower_layer(d), matching_file_def(f, x), (x = "match" ; x = "match_async" ; x = "match_lazy"),
    nearest(f, c, matching_file_class_kind), node(d, f, _, _, _), node(d, c, _, _, _).
// MA005 (matching): a match* parameter annotated with a Connection.
matching_file_finding(d, "MA005", p) :- matching_file_matching(d), matching_file_def(f, x), (x = "match" ; x = "match_async" ; x = "match_lazy"),
    matching_file_param(f, p, _, _, k), (k = "posonlyargs" ; k = "args" ; k = "kwonlyargs"), matching_file_param_annotation(p, a),
    matching_file_label_any(a, s), contains("Connection", s), node(d, f, _, _, _).
// MA024 (conformance, test_* files): a test def naming execution_classes/proof_test_ids and calling no match*.
matching_file_probe(x, f) :- matching_file_def(f, _), node(d, f, _, _, _), matching_file_attr(x, y, _), (y = "execution_classes" ; y = "proof_test_ids"), node(d, x, _, _, _).
.decl matching_file_calls_match(f: node)
matching_file_calls_match(f) :- matching_file_def_call(f, c), matching_file_callee(c, _, x), (x = "match" ; x = "match_async" ; x = "match_lazy").
matching_file_finding(d, "MA024", f) :- matching_file_conformance(d), doc(d, p, _), match("(.*/)?test_[^/]*", p), matching_file_def(f, _), node(d, f, _, _, _),
    matching_file_in(x, f), matching_file_attr(x, y, _), (y = "execution_classes" ; y = "proof_test_ids"), !matching_file_calls_match(f).
// MA037 (implementation): a dependency count from resolved names.
.decl matching_file_dependency_count(x: symbol)
matching_file_dependency_count("completed_database_round_trips"). matching_file_dependency_count("database_execution_operations").
matching_file_dependency_count("database_round_trips"). matching_file_dependency_count("dependency_traversal_operations").
.decl matching_file_receipts(x: symbol)
matching_file_receipts("completed_preflight_receipts"). matching_file_receipts("database_receipts").
matching_file_receipts("dependency_receipts"). matching_file_receipts("executed_dependencies").
.decl matching_file_len_receipts(c: node)
matching_file_len_receipts(c) :- matching_file_callee(c, _, "len"), matching_file_arg(c, a, _), matching_file_ref(a, x), matching_file_receipts(x).
.decl matching_file_count_value(v: node)
matching_file_count_value(v) :- matching_file_named_target(a, _, x), matching_file_dependency_count(x), matching_file_value(a, v).
matching_file_count_value(v) :- node(_, k, "keyword_argument", _, _), field(k, "name", i), text(i, x), matching_file_dependency_count(x), field(k, "value", v0),
    matching_file_unparen(v0, v), matching_file_node(v).
matching_file_probe(c, v) :- matching_file_count_value(v), node(d, v, _, _, _), matching_file_len_receipts(c), node(d, c, _, _, _).
matching_file_finding(d, "MA037", a) :- matching_file_implementation(d), matching_file_named_target(a, _, x), matching_file_dependency_count(x), matching_file_value(a, v),
    matching_file_in(c, v), matching_file_len_receipts(c), node(d, a, _, _, _).
matching_file_finding(d, "MA037", v) :- matching_file_implementation(d), node(_, k, "keyword_argument", _, _), field(k, "name", i), text(i, x),
    matching_file_dependency_count(x), field(k, "value", v0), matching_file_unparen(v0, v), matching_file_in(c, v), matching_file_len_receipts(c), node(d, v, _, _, _).
// MA035 (implementation): SqlBinaryOp over pair_count and .expression_node_count.
matching_file_probe(x, c) :- matching_file_callee(c, _, "SqlBinaryOp"), node(d, c, _, _, _), node(d, x, _, _, _), matching_file_name(x, "pair_count").
matching_file_probe(x, c) :- matching_file_callee(c, _, "SqlBinaryOp"), node(d, c, _, _, _), node(d, x, _, _, _), matching_file_attr(x, "expression_node_count", _).
matching_file_finding(d, "MA035", c) :- matching_file_implementation(d), matching_file_callee(c, _, "SqlBinaryOp"), matching_file_in(x, c), matching_file_name(x, "pair_count"),
    matching_file_in(y, c), matching_file_attr(y, "expression_node_count", _), node(d, c, _, _, _).
// MA038 (implementation): a bounded_watermark def that loops or reads .wait_limit.
.decl matching_file_poll(x: node)
matching_file_poll(x) :- matching_file_node(x), (node(_, x, "for_statement", _, _) ; node(_, x, "while_statement", _, _)).
matching_file_poll(x) :- matching_file_attr(x, "wait_limit", _).
matching_file_probe(x, f) :- matching_file_def(f, y), contains("bounded_watermark", y), node(d, f, _, _, _), matching_file_poll(x), node(d, x, _, _, _).
matching_file_finding(d, "MA038", f) :- matching_file_implementation(d), matching_file_def(f, x), contains("bounded_watermark", x), matching_file_in(y, f), matching_file_poll(y),
    node(d, f, _, _, _).
// MA032 (implementation): a tuple of 'working_memory_bytes' and payload_bytes.
.decl matching_file_elt(t: node, e: node)
matching_file_elt(t, e) :- matching_file_tuple(t), child(t, e0, _), matching_file_unparen(e0, e).
matching_file_finding(d, "MA032", t) :- matching_file_implementation(d), matching_file_elt(t, a), matching_file_const(a, _, "working_memory_bytes"),
    matching_file_elt(t, b), matching_file_name(b, "payload_bytes"), node(d, t, _, _, _).

violation("data-layer-matching-architecture", "matching-file-checks", k, p, l) :- matching_file_finding_line(d, k, l), matching_file_doc(d), doc(d, p, _).
