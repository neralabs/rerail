// data-layer-grammar-fragment-usage: `constructor-fragment`, `attribute-fragment` and `captured-return`, hand-written
// (decision 0043). `forbidden-class` and `syntax-error` are the converter's.
//
// The shared utils, as relations (W's semantics; ast-grep's `has`/`inside` without `stopBy` reach one level):
// - `fragment-type` (constructor_fragment_type): `SqlFragment` (a name, or an attribute's last name); a name imported
//   `from … import …SqlFragment as NAME` in the file; a non-f string whose value holds the word `SqlFragment`, or,
//   in a file with such an import, an identifier word equal to an alias (`parse: identifierWords` + `compare`); a
//   type-ish node (type, generic_type, type_parameter, union_type, binary_operator, list, tuple, subscript,
//   parenthesized_expression) with such a child.
// - `grammar-class` (constructor_grammar_class): a class not named SqlDeferredRenderable/SqlFragment/
//   SqlPreRenderedFragment, named `Sql…`/`_Sql…`, or with a `render` method in its body, or with a superclass that
//   is a `grammar-base`: a `Sql…`/`_Sql…` name or attribute, or a name the file binds to one (an aliased
//   `Sql…` import, an assignment from a grammar base, a grammar class of that name).
// - `inside: { matches: R, stopBy: { kind: class_definition } }` is "the nearest enclosing class matches R" (only
//   a class can match R); `nearest(n, c, class kinds)`.
// - `layout: { after|before: { to: capture.X, breaks: { min: 0 } } }` is only "X lies wholly after (before) the
//   node" (matcher/layout.rs: the capture must lie on its side; min 0 breaks always holds): byte offsets.
// - `compare … text: index` is the element's index in its list (matcher/compare.rs `element_index`): the `,` tokens
//   before it among its parent's children (`token`), comments not counted.
// - `regex: ^def\s` on a `function_definition` is its text (`node_text`) starting `def` and a white space.
// `captured-return` is a budget over rows (`group_by: [path, position]`, at most 0): every return row whose method
// the class's `reachable` closure holds is its own group, a violation at the `return`. The closure is per class
// (`partition_by: [path, owner]`), seeded with `render`, along `self.<target>()`/`cls.<target>()` call rows
// (caller -> target). A method counts (as caller or as a return row's method) only if it is the class's
// effective one: the first `render` (`not inside earlier-method`), the last of any other name (`not inside
// later-method`).
//
// Strings, exactly (W's decoder through `value` and `value_type_of`):
// - `value: { type: str }` is `value_type_of(n, "str")`; `value: { regex: R }` (strings only) is
//   `value(n, v), value_type_of(n, "str"), match("(?s:.*)(?:R)(?s:.*)", v)`.
// - `parse: { grammar: identifierWords }` reads the decoded `str` text (`literal::parse_string`, `decode_python`; no
//   words for bytes, a `t` string or an unknown value), words being the leftmost-first runs of `[A-Za-z_][A-Za-z0-9_]*`
//   (literal/identifier_words.rs: a digit before a word does not join it, `9F` holds `F`). An alias `x` (an ASCII
//   identifier, else no word equals it) is a word of `v` exactly when `v` holds `x` with nothing but digits between it
//   and the start or a non-`[A-Za-z0-9_]` character before, and the end or such a character after:
//   `(?s:.*)(?:^|[^A-Za-z0-9_])[0-9]*x(?:$|[^A-Za-z0-9_])(?s:.*)`. The `compare … eq` of the word and the alias is
//   their texts' equality.
//   ASSUMED: `value`'s decoding of a literal (matcher/value.rs) and `decode_python`'s agree (escapes, the size cap).
// The import's `name` regexes (`(?:^|\.)SqlFragment$`, `^(?:Sql|_Sql)`) read the name node's full text (`node_text`).
// Options: none of the policy's (`oracleAnalyzer`, `sourceGate`) is read by these clauses.

.decl tape_syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- shared: kind sets (the axes' sets are used nowhere else) ----
.decl constructor_class_kinds(kind: symbol)
constructor_class_kinds("class_definition").
.decl constructor_fdef_kinds(kind: symbol)
constructor_fdef_kinds("function_definition").
// `all: [{ kind: function_definition }, { regex: ^def\s }]`: a function that is not `async`.
.decl constructor_sync_def(f: node)
constructor_sync_def(f) :- node(_, f, "function_definition", _, _), node_text(f, s), match("def\\s(?s:.*)", s).

// ---- shared: strings ----
// A `string` that is not an f-string (`(?i)^[rub]*f` fails).
.decl constructor_plain_part(n: node)
constructor_plain_part(n) :- node(_, n, "string", _, _), strprefix(n, x), !contains("f", x).
// A concatenation with an f part.
.decl constructor_f_concat(c: node)
constructor_f_concat(c) :- node(_, c, "concatenated_string", _, _), child(c, s, _), node(_, s, "string", _, _), strprefix(s, x), contains("f", x).
// The util's non-f literal: a plain string, or a concatenation with no f part.
.decl constructor_plain_literal(n: node)
constructor_plain_literal(n) :- constructor_plain_part(n).
constructor_plain_literal(n) :- node(_, n, "concatenated_string", _, _), !constructor_f_concat(n).
// Its value when it is a `str`, decoded (`value`; a concatenation's is the parts joined).
.decl constructor_literal_value(n: node, v: symbol)
constructor_literal_value(n, v) :- constructor_plain_literal(n), value(n, v), value_type_of(n, "str").

// ---- shared: fragment-type ----
// `from … import …SqlFragment as NAME`: the file's fragment aliases.
.decl constructor_fragment_import(a: node)
constructor_fragment_import(a) :- node(_, a, "aliased_import", _, _), child(i, a, _), node(_, i, "import_from_statement", _, _), field(a, "name", nm), node_text(nm, "SqlFragment").
constructor_fragment_import(a) :- node(_, a, "aliased_import", _, _), child(i, a, _), node(_, i, "import_from_statement", _, _), field(a, "name", nm), node_text(nm, s), suffix(".SqlFragment", s).
.decl constructor_fragment_alias(d: number, x: symbol)
constructor_fragment_alias(d, x) :- constructor_fragment_import(a), node(d, a, _, _, _), field(a, "alias", al), text(al, x).

.decl constructor_type_kinds(kind: symbol)
constructor_type_kinds("type").
constructor_type_kinds("generic_type").
constructor_type_kinds("type_parameter").
constructor_type_kinds("union_type").
constructor_type_kinds("binary_operator").
constructor_type_kinds("list").
constructor_type_kinds("tuple").
constructor_type_kinds("subscript").
constructor_type_kinds("parenthesized_expression").

.decl constructor_fragment_type(n: node)
constructor_fragment_type(n) :- node(_, n, "identifier", _, _), text(n, "SqlFragment").
constructor_fragment_type(n) :- node(_, n, "attribute", _, _), field(n, "attribute", a), node(_, a, "identifier", _, _), text(a, "SqlFragment").
constructor_fragment_type(n) :- node(d, n, "identifier", _, _), text(n, x), constructor_fragment_alias(d, x).
constructor_fragment_type(n) :- constructor_literal_value(n, v), match("(?s:.*)(?:(?:^|[^A-Za-z0-9_])SqlFragment(?:$|[^A-Za-z0-9_]))(?s:.*)", v).
constructor_fragment_type(n) :- constructor_literal_value(n, v), node(d, n, _, _, _), constructor_fragment_alias(d, x), match("[A-Za-z_][A-Za-z0-9_]*", x),
    w = cat("(?s:.*)(?:^|[^A-Za-z0-9_])[0-9]*", cat(x, "(?:$|[^A-Za-z0-9_])(?s:.*)")), match(w, v).
constructor_fragment_type(n) :- node(_, n, k, _, _), constructor_type_kinds(k), child(n, c, _), constructor_fragment_type(c).

// ---- shared: grammar-class and grammar-base ----
.decl constructor_forbidden_class(c: node)
constructor_forbidden_class(c) :- node(_, c, "class_definition", _, _), field(c, "name", i), node(_, i, "identifier", _, _), text(i, s),
    (s = "SqlDeferredRenderable" ; s = "SqlFragment" ; s = "SqlPreRenderedFragment").
// A class body holding a `render` method, directly or decorated (no `^def\s`: async too).
.decl constructor_render_body(c: node)
constructor_render_body(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, f, _), node(_, f, "function_definition", _, _),
    field(f, "name", i), node(_, i, "identifier", _, _), text(i, "render").
constructor_render_body(c) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, g, _), node(_, g, "decorated_definition", _, _),
    field(g, "definition", f), node(_, f, "function_definition", _, _), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "render").

.decl constructor_grammar_class(c: node)
constructor_grammar_class(c) :- node(_, c, "class_definition", _, _), !constructor_forbidden_class(c), field(c, "name", i), text(i, s),
    (prefix("Sql", s) ; prefix("_Sql", s)).
constructor_grammar_class(c) :- constructor_render_body(c), !constructor_forbidden_class(c).
constructor_grammar_class(c) :- node(_, c, "class_definition", _, _), !constructor_forbidden_class(c), field(c, "superclasses", sc), child(sc, b, _),
    constructor_grammar_base(b).

// A name the file binds to a grammar base: (document, name).
.decl constructor_base_name(d: number, x: symbol)
constructor_base_name(d, x) :- node(d, a, "aliased_import", _, _), child(i, a, _), node(_, i, "import_from_statement", _, _), field(a, "name", nm),
    node_text(nm, s), (prefix("Sql", s) ; prefix("_Sql", s)), field(a, "alias", al), text(al, x).
constructor_base_name(d, x) :- node(d, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x), field(a, "right", r),
    constructor_grammar_base(r).
constructor_base_name(d, x) :- constructor_grammar_class(c), node(d, c, _, _, _), field(c, "name", i), text(i, x).

.decl constructor_grammar_base(b: node)
constructor_grammar_base(b) :- node(_, b, "identifier", _, _), text(b, s), (prefix("Sql", s) ; prefix("_Sql", s)).
constructor_grammar_base(b) :- node(d, b, "identifier", _, _), text(b, x), constructor_base_name(d, x).
constructor_grammar_base(b) :- node(_, b, "attribute", _, _), field(b, "attribute", a), text(a, s), (prefix("Sql", s) ; prefix("_Sql", s)).

// ---- constructor-fragment ----
// A parameter as the clause shapes it (`$PARAM` bound in a name, an identifier child, or a splat's identifier).
.decl constructor_param_shape(q: node)
constructor_param_shape(q) :- node(_, q, "identifier", _, _).
constructor_param_shape(q) :- node(_, q, "default_parameter", _, _), field(q, "name", _).
constructor_param_shape(q) :- node(_, q, "typed_default_parameter", _, _), field(q, "name", _).
constructor_param_shape(q) :- node(_, q, "typed_parameter", _, _), child(q, i, _), node(_, i, "identifier", _, _).
constructor_param_shape(q) :- node(_, q, "typed_parameter", _, _), child(q, s, _), node(_, s, "list_splat_pattern", _, _), child(s, i, _), node(_, i, "identifier", _, _).
constructor_param_shape(q) :- node(_, q, "typed_parameter", _, _), child(q, s, _), node(_, s, "dictionary_splat_pattern", _, _), child(s, i, _), node(_, i, "identifier", _, _).
.decl constructor_self_param(q: node)
constructor_self_param(q) :- child(q, i, _), node(_, i, "identifier", _, _), text(i, "self").

violation("data-layer-grammar-fragment-usage", "constructor-fragment", "sqlfragment_usage", p, l) :-
    node(d, f, "function_definition", _, _), constructor_sync_def(f), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "__init__"),
    nearest(f, c, constructor_class_kinds), constructor_grammar_class(c), field(f, "parameters", ps), child(ps, q, _), constructor_param_shape(q),
    !constructor_self_param(q), field(q, "type", t), constructor_fragment_type(t), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _), line(f, l).

// ---- attribute-fragment ----
violation("data-layer-grammar-fragment-usage", "attribute-fragment", "sqlfragment_usage", p, l) :-
    node(d, a, "assignment", _, _), field(a, "type", t), constructor_fragment_type(t), !inside(a, _, constructor_fdef_kinds),
    nearest(a, c, constructor_class_kinds), constructor_grammar_class(c), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _), line(a, l).

// ---- captured-return: build-string ----
// The util's first alternative: a plain literal not inside a concatenation whose value is a `str`.
.decl captured_in_concat(n: node)
captured_in_concat(n) :- node(_, n, "string", _, _), child(c, n, _), node(_, c, "concatenated_string", _, _).
.decl captured_str_method(s: symbol)
captured_str_method("casefold").
captured_str_method("format").
captured_str_method("format_map").
captured_str_method("join").
captured_str_method("lower").
captured_str_method("lstrip").
captured_str_method("removeprefix").
captured_str_method("removesuffix").
captured_str_method("replace").
captured_str_method("rstrip").
captured_str_method("strip").
captured_str_method("translate").
captured_str_method("upper").

.decl captured_bs(n: node)
captured_bs(n) :- constructor_plain_literal(n), !captured_in_concat(n), value_type_of(n, "str").
captured_bs(n) :- node(_, n, "string", _, _), strprefix(n, x), contains("f", x), !captured_in_concat(n).
captured_bs(n) :- constructor_f_concat(n).
captured_bs(n) :- node(_, n, "format_specifier", _, _).
captured_bs(n) :- node(_, n, "list", _, _), child(n, c, _), captured_bs(c).
captured_bs(n) :- node(_, n, "set", _, _), child(n, c, _), captured_bs(c).
captured_bs(n) :- node(_, n, "tuple", _, _), child(n, c, _), captured_bs(c).
captured_bs(n) :- node(_, n, "dictionary", _, _), child(n, pr, _), node(_, pr, "pair", _, _), field(pr, "value", v), captured_bs(v).
captured_bs(n) :- node(_, n, "binary_operator", _, _), op(n, "+"), field(n, "left", c), captured_bs(c).
captured_bs(n) :- node(_, n, "binary_operator", _, _), op(n, "+"), field(n, "right", c), captured_bs(c).
captured_bs(n) :- node(_, n, "conditional_expression", _, _), child(n, c, 0), captured_bs(c).
captured_bs(n) :- node(_, n, "conditional_expression", _, _), child(n, c, 2), captured_bs(c).
captured_bs(n) :- node(_, n, "parenthesized_expression", _, _), child(n, c, _), captured_bs(c).
captured_bs(n) :- node(_, n, "call", _, _), field(n, "function", g), node(_, g, "identifier", _, _), text(g, "str").
captured_bs(n) :- node(_, n, "call", _, _), field(n, "function", g), node(_, g, "attribute", _, _), field(g, "attribute", a), node(_, a, "identifier", _, _),
    text(a, s), captured_str_method(s), field(g, "object", o), captured_bs(o).
// A name bound to a built string by an assignment wholly before the use, outside any class or in an `__init__`.
captured_bs(n) :- node(d, n, "identifier", _, _), text(n, x), node(d, n, _, us, _), captured_string_binding(d, x, ae), ae <= us.

.decl captured_binding_place(a: node)
captured_binding_place(a) :- node(_, a, "assignment", _, _), !inside(a, _, constructor_class_kinds).
captured_binding_place(a) :- node(_, a, "assignment", _, _), nearest(a, f, constructor_fdef_kinds), constructor_sync_def(f), field(f, "name", i),
    node(_, i, "identifier", _, _), text(i, "__init__").
.decl captured_string_binding(d: number, x: symbol, e: number)
captured_string_binding(d, x, e) :- node(d, a, "assignment", _, e), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x), field(a, "right", r),
    captured_bs(r), captured_binding_place(a).

// ---- captured-return: captured-field and unsafe-field ----
// `FIELD = <built string>` or `FIELD: str`.
.decl captured_name_assign(a: node, x: symbol)
captured_name_assign(a, x) :- node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x), field(a, "right", r), captured_bs(r).
captured_name_assign(a, x) :- node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, x), field(a, "type", t),
    node(_, t, "type", _, _), child(t, i, _), node(_, i, "identifier", _, _), text(i, "str").
// `self.FIELD` and `self.FIELD = <built string>`.
.decl captured_self_attr(n: node, x: symbol)
captured_self_attr(n, x) :- node(_, n, "attribute", _, _), field(n, "object", o), node(_, o, "identifier", _, _), text(o, "self"), field(n, "attribute", a), text(a, x).
.decl captured_self_assign(a: node, x: symbol)
captured_self_assign(a, x) :- node(_, a, "assignment", _, _), field(a, "left", l), captured_self_attr(l, x), field(a, "right", r), captured_bs(r).
.decl captured_assign(a: node, x: symbol)
captured_assign(a, x) :- captured_name_assign(a, x).
captured_assign(a, x) :- captured_self_assign(a, x).

// A class's `__init__` (`^def\s`: not async), directly in its body or decorated there.
.decl captured_init(c: node, f: node)
captured_init(c, f) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, f, _), constructor_sync_def(f),
    field(f, "name", i), node(_, i, "identifier", _, _), text(i, "__init__").
captured_init(c, f) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, g, _), node(_, g, "decorated_definition", _, _),
    field(g, "definition", f), constructor_sync_def(f), field(f, "name", i), node(_, i, "identifier", _, _), text(i, "__init__").

.decl captured_pattern_kinds(kind: symbol)
captured_pattern_kinds("tuple_pattern").
captured_pattern_kinds("list_pattern").
captured_pattern_kinds("pattern_list").
.decl captured_value_list_kinds(kind: symbol)
captured_value_list_kinds("tuple").
captured_value_list_kinds("list").
captured_value_list_kinds("expression_list").

.decl captured_field(c: node, x: symbol)
captured_field(c, x) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, a, _), captured_assign(a, x).
captured_field(c, x) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, s, _), node(_, s, "expression_statement", _, _), child(s, a, _), captured_assign(a, x).
captured_field(c, x) :- captured_init(c, f), node(_, a, "assignment", _, _), inside(a, f, constructor_fdef_kinds), captured_assign(a, x).
captured_field(c, x) :- captured_init(c, f), node(_, a, "assignment", _, _), inside(a, f, constructor_fdef_kinds), field(a, "left", lp), node(_, lp, lk, _, _),
    captured_pattern_kinds(lk), child(lp, t, _), captured_self_attr(t, x), captured_index(lp, t, i), field(a, "right", rp), node(_, rp, rk, _, _),
    captured_value_list_kinds(rk), child(rp, v, _), captured_bs(v), captured_index(rp, v, i).

// `compare … text: index`: an element's index, the `,` tokens before it among its parent's children (for the
// patterns and value lists above only).
.decl captured_index_list(p: node)
captured_index_list(p) :- node(_, p, k, _, _), captured_pattern_kinds(k).
captured_index_list(p) :- node(_, p, k, _, _), captured_value_list_kinds(k).
.decl captured_index(p: node, c: node, k: number)
captured_index(p, c, k) :- captured_index_list(p), child(p, c, _), node(_, c, _, s, e), token(p, i, _, s, e), k = count : { token(p, j, ",", _, _), j < i }.

// A parameter named p (as the util shapes `$PARAM`), and one with no type or an `Any`/`str` one.
.decl captured_param_named(q: node, p: symbol)
captured_param_named(q, p) :- node(_, q, "identifier", _, _), text(q, p).
captured_param_named(q, p) :- node(_, q, k, _, _), captured_param_kinds(k), field(q, "name", n), text(n, p).
captured_param_named(q, p) :- node(_, q, k, _, _), captured_param_kinds(k), child(q, i, _), node(_, i, "identifier", _, _), text(i, p).
.decl captured_param_kinds(kind: symbol)
captured_param_kinds("typed_parameter").
captured_param_kinds("typed_default_parameter").
captured_param_kinds("default_parameter").
.decl captured_loose_type(t: node)
captured_loose_type(t) :- node(_, t, "type", _, _), child(t, i, _), node(_, i, "identifier", _, _), text(i, s), (s = "Any" ; s = "str").
captured_loose_type(t) :- node(_, t, "type", _, _), child(t, i, _), node(_, i, "attribute", _, _), field(i, "attribute", a), node(_, a, "identifier", _, _),
    text(a, s), (s = "Any" ; s = "str").
.decl captured_typed(q: node)
captured_typed(q) :- field(q, "type", _).
.decl captured_loose_param(q: node)
captured_loose_param(q) :- captured_param_named(q, _), !captured_typed(q).
captured_loose_param(q) :- captured_param_named(q, _), field(q, "type", t), captured_loose_type(t).

.decl captured_unsafe_field(c: node, x: symbol)
captured_unsafe_field(c, x) :- captured_init(c, f), node(_, a, "assignment", _, _), inside(a, f, constructor_fdef_kinds), field(a, "left", l), captured_self_attr(l, x),
    field(a, "right", r), node(_, r, "identifier", _, _), text(r, p), field(f, "parameters", ps), child(ps, q, _), captured_param_named(q, p), captured_loose_param(q).

// ---- captured-return: returned-field, by demand from each return's children with its class's name ----
.decl captured_fragment_call(k: node)
captured_fragment_call(k) :- node(_, k, "call", _, _), field(k, "function", g), node(_, g, "identifier", _, _), text(g, "SqlFragment").
captured_fragment_call(k) :- node(_, k, "call", _, _), field(k, "function", g), node(_, g, "attribute", _, _), field(g, "object", o), node(_, o, "identifier", _, _),
    text(o, "SqlFragment"), field(g, "attribute", a), node(_, a, "identifier", _, _), text(a, s), (s = "static" ; s = "with_params").
.decl captured_arg_at(g: node, i: number)
captured_arg_at(g, i) :- captured_fragment_call(k), field(k, "arguments", g), child(g, c, i), !node(_, c, "comment", _, _).
.decl captured_first_arg(k: node, c: node)
captured_first_arg(k, c) :- captured_fragment_call(k), field(k, "arguments", g), child(g, c, i), !node(_, c, "comment", _, _), i = min j : { captured_arg_at(g, j) }.

.decl captured_rf_need(x: node, cn: symbol)
.decl captured_rf(x: node, cn: symbol)
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "binary_operator", _, _), op(x, "+"), field(x, "left", y).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "binary_operator", _, _), op(x, "+"), field(x, "right", y).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "conditional_expression", _, _), child(x, y, 0).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "conditional_expression", _, _), child(x, y, 2).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "subscript", _, _), field(x, "value", y).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), node(_, x, "parenthesized_expression", _, _), child(x, y, _).
captured_rf_need(y, cn) :- captured_rf_need(x, cn), captured_first_arg(x, y).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "attribute", _, _), field(x, "object", o), node(_, o, "identifier", _, _), text(o, "self"),
    field(x, "attribute", a), text(a, f), nearest(x, k, constructor_class_kinds), captured_field(k, f).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "attribute", _, _), field(x, "object", o), text(o, cn),
    field(x, "attribute", a), text(a, f), nearest(x, k, constructor_class_kinds), captured_field(k, f).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "binary_operator", _, _), op(x, "+"), field(x, "left", y), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "binary_operator", _, _), op(x, "+"), field(x, "right", y), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "conditional_expression", _, _), child(x, y, 0), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "conditional_expression", _, _), child(x, y, 2), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "subscript", _, _), field(x, "value", y), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), node(_, x, "parenthesized_expression", _, _), child(x, y, _), captured_rf(y, cn).
captured_rf(x, cn) :- captured_rf_need(x, cn), captured_first_arg(x, y), captured_rf(y, cn).

// ---- captured-return: the classes, their effective methods, the rows ----
// The owner: not SqlDeferredRenderable/SqlPreRenderedFragment, with a `render` method.
.decl captured_owner(c: node, cn: symbol)
captured_owner(c, cn) :- constructor_render_body(c), field(c, "name", i), text(i, cn), cn != "SqlDeferredRenderable", cn != "SqlPreRenderedFragment".
// A function in a class's body, directly or decorated: (class, function, name).
.decl captured_member(c: node, f: node, x: symbol)
captured_member(c, f, x) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, f, _), node(_, f, "function_definition", _, _), field(f, "name", i), text(i, x).
captured_member(c, f, x) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, g, _), node(_, g, "decorated_definition", _, _),
    field(g, "definition", f), node(_, f, "function_definition", _, _), field(f, "name", i), text(i, x).
// `earlier-method`: a same-name member wholly before; `later-method`: one wholly after.
.decl captured_earlier(f: node)
captured_earlier(m) :- captured_member(c, m, x), captured_member(c, f, x), node(_, f, _, _, fe), node(_, m, _, ms, _), fe <= ms.
.decl captured_later(f: node)
captured_later(m) :- captured_member(c, m, x), captured_member(c, f, x), node(_, f, _, fs, _), node(_, m, _, _, me), fs >= me.
.decl captured_method(c: node, m: node, x: symbol)
captured_method(c, m, "render") :- captured_owner(c, _), captured_member(c, m, "render"), !captured_earlier(m).
captured_method(c, m, x) :- captured_owner(c, _), captured_member(c, m, x), x != "render", !captured_later(m).

// The call rows' edges: (class, caller, target) for `self.<target>(…)`/`cls.<target>(…)` anywhere in a method.
.decl captured_edge(c: node, caller: symbol, target: symbol)
captured_edge(c, x, t) :- node(d, k, "call", _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), field(k, "function", g), node(_, g, "attribute", _, _),
    field(g, "object", o), node(_, o, "identifier", _, _), text(o, s), (s = "cls" ; s = "self"), field(g, "attribute", a), text(a, t),
    inside(k, m, constructor_fdef_kinds), captured_method(c, m, x).

// The return rows' candidates: a return whose nearest class is an owner, with its class name.
.decl captured_return(d: number, r: node, c: node, cn: symbol)
captured_return(d, r, c, cn) :- node(d, r, "return_statement", _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), nearest(r, c, constructor_class_kinds), captured_owner(c, cn).
captured_rf_need(x, cn) :- captured_return(_, r, _, cn), child(r, x, _).
// What it returns: a returned field, or `self.FIELD` of an unsafe field of its nearest class.
.decl captured_returns_field(r: node)
captured_returns_field(r) :- captured_return(_, r, _, cn), child(r, x, _), captured_rf(x, cn).
captured_returns_field(r) :- captured_return(_, r, _, _), child(r, x, _), captured_self_attr(x, f), nearest(x, k, constructor_class_kinds), captured_unsafe_field(k, f).
// The row: the return in an effective method of the same class (any enclosing function).
.decl captured_return_row(d: number, r: node, c: node, x: symbol)
captured_return_row(d, r, c, x) :- captured_return(d, r, c, _), captured_returns_field(r), inside(r, m, constructor_fdef_kinds), captured_method(c, m, x).

// `reachable`: per class, from `render` along the edges.
.decl captured_reach(c: node, x: symbol)
captured_reach(c, "render") :- captured_return_row(_, _, c, _).
captured_reach(c, y) :- captured_reach(c, x), captured_edge(c, x, y).

violation("data-layer-grammar-fragment-usage", "captured-return", "sqlfragment_usage", p, l) :-
    captured_return_row(d, r, c, x), captured_reach(c, x), doc(d, p, _), line(r, l).
