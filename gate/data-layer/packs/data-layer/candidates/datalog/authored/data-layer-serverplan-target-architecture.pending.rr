// Pending for data-layer-serverplan-target-architecture (not read by the converter).
// (1) Awaiting the converter's option facts (A9): replace the main file's facts `spta_entry_point(1).` and
//     `spta_required_shape(1).` with these, and declare the option relations.
.decl option_on(name: symbol)
.decl option_value(name: symbol, v: symbol)
spta_entry_point(1) :- option_value("entryPoint", v), (v = "all" ; v = "scan_sources").
spta_required_shape(1) :- option_on("requiredShape").
// (2) Awaiting `value(n: node, v: symbol)` (W's semantic value): strategy-getattr over a concatenated_string too.
//     Replace the main file's strategy-getattr rule (its `node(_, y, "string", _, _), str(y, v)`) with this.
.decl value(n: node, v: symbol)
violation("data-layer-serverplan-target-architecture", "strategy-getattr", "SPTA008", p, l) :-
    spta_entry_point(1), spta_call(_, p, c, "getattr", al), spta_second(al, y), node(_, y, k, _, _),
    (k = "string" ; k = "concatenated_string"), value(y, v), (v = "_stmt" ; v = "_grammar" ; v = "grammar"), line(c, l).
