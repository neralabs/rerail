// data-layer-missing-async-pairs, option-gated form (awaiting the converter's option facts, ConvertFoundation A9).
// Not read by the converter. When `option_on` lands, replace the main file's pair_doc rule with the two below and
// declare option_on: sourceGate (default true) gates on `def\ |async\ def\ ` in the module's text, false passes
// every module. oracleAnalyzer is not read by any clause.
.decl option_on(name: symbol)

.decl pair_doc(d: number)
pair_doc(d) :-
    in_scope(d), !out_scope(d), !syntax_error(d), option_on("sourceGate"),
    node(d, m, "module", _, _), node_text(m, s), contains("def ", s).
pair_doc(d) :- in_scope(d), !out_scope(d), !syntax_error(d), !option_on("sourceGate").
