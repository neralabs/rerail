// data-layer-permission-error, authored clause `raise` (`syntax: valid`).
// The policy: a raise_statement matching `raise PermissionError($$$ARGS)` or `raise PermissionError` (patterns by
// named children, the converter's form: `raise PermissionError(…) from e` has a second child and matches
// neither), and
// - not inside a module that has, anywhere, an import_from_statement lying wholly before the raise
//   (`layout.after: {to: capture.RAISE, breaks: {min: 0}}`: the capture RAISE, the raise itself, must start at or
//   after the import's end; `breaks.min 0` always holds) whose `module_name` child's text contains
//   `l1100_exceptions` and which has a `name` child that is the dotted_name `PermissionError` or the
//   aliased_import `PermissionError as PermissionError`;
// - and neither the raise's first line (`layout.line`) nor the line before it (`layout.previousLine`) contains
//   `lint: allow-builtin-permission-error` (each searched in the physical line's full text).
// The layout gap is written with byte offsets, so it needs no layout relation.
// The lines are `tape_line`'s, numbered as `line(n)` and W's layout number them (`\r\n`, `\r`, `\n`).
.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: loc, s: symbol)
.decl line(n: loc, l: number)
.decl tape_line(d: number, l: number, sp: span)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, child, field, text, line, tape_line, syntax_error
.output violation

// The two patterns.
.decl raise_builtin(d: number, r: node, start: number)
raise_builtin(d, r, s) :-
    node(d, r, "raise_statement", s, _), child(r, x, 0), !child(r, _, 1),
    node(_, x, "identifier", _, _), text(x, "PermissionError").
raise_builtin(d, r, s) :-
    node(d, r, "raise_statement", s, _), child(r, x, 0), !child(r, _, 1),
    node(_, x, "call", _, _), child(x, f, 0), node(_, f, "identifier", _, _), text(f, "PermissionError"),
    child(x, a, 1), node(_, a, "argument_list", _, _), !child(x, _, 2).

// `from …l1100_exceptions… import PermissionError` (or `PermissionError as PermissionError`), ending at `end`.
// The module name is a dotted_name, or a relative_import whose dotted_name holds the name.
.decl raise_module_name(m: node)
raise_module_name(m) :- node(_, m, "dotted_name", _, _), text(m, s), contains("l1100_exceptions", s).
raise_module_name(m) :-
    node(_, m, "relative_import", _, _), child(m, x, _), node(_, x, "dotted_name", _, _), text(x, s),
    contains("l1100_exceptions", s).

.decl raise_imported_name(c: node)
raise_imported_name(c) :- node(_, c, "dotted_name", _, _), text(c, "PermissionError").
raise_imported_name(c) :-
    node(_, c, "aliased_import", _, _), field(c, "name", x), text(x, "PermissionError"),
    field(c, "alias", y), text(y, "PermissionError").

.decl raise_import(d: number, end: number)
raise_import(d, e) :-
    node(d, i, "import_from_statement", _, e), field(i, "module_name", m), raise_module_name(m),
    field(i, "name", c), raise_imported_name(c).

.decl raise_imported(r: node)
raise_imported(r) :- raise_builtin(d, r, s), raise_import(d, e), e <= s.

// The allow marker on the raise's line or the line before.
.decl raise_allowed(r: node)
raise_allowed(r) :-
    raise_builtin(d, r, _), line(r, l), tape_line(d, l, sp), text(sp, t),
    contains("lint: allow-builtin-permission-error", t).
raise_allowed(r) :-
    raise_builtin(d, r, _), line(r, l), k = l - 1, tape_line(d, k, sp), text(sp, t),
    contains("lint: allow-builtin-permission-error", t).

violation("data-layer-permission-error", "raise", "builtin_permission_error", p, l) :-
    raise_builtin(d, r, _), in_scope(d), !out_scope(d), !syntax_error(d),
    !raise_imported(r), !raise_allowed(r), doc(d, p, _), line(r, l).
