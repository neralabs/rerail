spq_sync_async_duplication_admission(n) :- node(_, n, "module", _, _), node_text(n, s81), match("(?s:.*)(?:_async)(?s:.*)", s81), node(d89, n, _, _, _), spq_sync_async_duplication_file88(d89), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
.decl spq_sync_async_duplication_cls(n: node, c: node)
.decl spq_sync_async_duplication_pm(d: number, n: node, c: node, nm: symbol)
.decl spq_sync_async_duplication_pf(d: number, n: node, nm: symbol)
.decl spq_sync_async_duplication_last_m(d: number, n: node, c: node, nm: symbol)
.decl spq_sync_async_duplication_last_f(d: number, n: node, nm: symbol)
.decl spq_sync_async_duplication_admitted(d: number)
.decl spq_sync_async_duplication_hit(d: number, n: node)
// CLS: the class whose body holds the method (directly, or through its decorated_definition).
spq_sync_async_duplication_cls(n, c) :- spq_sync_async_duplication_pair_methods(n), child(b, n, _), node(_, b, "block", _, _), field(c, "body", b), node(_, c, "class_definition", _, _).
spq_sync_async_duplication_cls(n, c) :- spq_sync_async_duplication_pair_methods(n), child(x, n, _), node(_, x, "decorated_definition", _, _), child(b, x, _), node(_, b, "block", _, _), field(c, "body", b), node(_, c, "class_definition", _, _).
// NAME: the function's name field (an identifier).
spq_sync_async_duplication_pm(d, n, c, nm) :- spq_sync_async_duplication_pair_methods(n), node(d, n, _, _, _), spq_sync_async_duplication_cls(n, c), field(n, "name", x), text(x, nm).
spq_sync_async_duplication_pf(d, n, nm) :- spq_sync_async_duplication_pair_functions(n), node(d, n, _, _, _), field(n, "name", x), text(x, nm).
// last_methods / last_functions: the row with the largest __start per key.
spq_sync_async_duplication_last_m(d, n, c, nm) :- spq_sync_async_duplication_pm(d, n, c, nm), node(d, n, _, st, _), st = max s : { spq_sync_async_duplication_pm(d, m, c, nm), node(d, m, _, s, _) }.
spq_sync_async_duplication_last_f(d, n, nm) :- spq_sync_async_duplication_pf(d, n, nm), node(d, n, _, st, _), st = max s : { spq_sync_async_duplication_pf(d, m, nm), node(d, m, _, s, _) }.
spq_sync_async_duplication_admitted(d) :- spq_sync_async_duplication_admission(n), node(d, n, _, _, _).
// The query's first part (methods): not abstract (either), long (either).
spq_sync_async_duplication_hit(d, n) :- spq_sync_async_duplication_pm(d, n, c, nm), spq_sync_async_duplication_last_m(d, s, c, sn), nm = cat(sn, "_async"), !spq_sync_async_duplication_abstract_functions(n), !spq_sync_async_duplication_abstract_functions(s), spq_sync_async_duplication_long_functions(n).
spq_sync_async_duplication_hit(d, n) :- spq_sync_async_duplication_pm(d, n, c, nm), spq_sync_async_duplication_last_m(d, s, c, sn), nm = cat(sn, "_async"), !spq_sync_async_duplication_abstract_functions(n), !spq_sync_async_duplication_abstract_functions(s), spq_sync_async_duplication_long_functions(s).
// The second part (module functions): long (either).
spq_sync_async_duplication_hit(d, n) :- spq_sync_async_duplication_pf(d, n, nm), spq_sync_async_duplication_last_f(d, s, sn), nm = cat(sn, "_async"), spq_sync_async_duplication_long_functions(n).
spq_sync_async_duplication_hit(d, n) :- spq_sync_async_duplication_pf(d, n, nm), spq_sync_async_duplication_last_f(d, s, sn), nm = cat(sn, "_async"), spq_sync_async_duplication_long_functions(s).
violation("data-layer-serverplan-quality", "spq-sync-async-duplication", "SPQ-001", p, l) :- spq_sync_async_duplication_hit(d, n), spq_sync_async_duplication_admitted(d), doc(d, p, _), line(n, l).

