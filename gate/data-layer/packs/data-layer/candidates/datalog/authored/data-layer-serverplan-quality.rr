conditional_architecture_ncall(d, s, e, callee, l) :- conditional_architecture_named_calls(n), node(d, n, _, s, e), field(n, "function", x), node_text(x, callee), line(x, l).
conditional_architecture_store_right(n, x) :- conditional_architecture_self_stores(n), field(n, "right", x).
