quality_local_taxonomy_def(n, s) :- node(_, n, "function_definition", _, _), field(n, "name", c), text(c, s).
quality_local_taxonomy_callee(f, s) :- node(_, f, "identifier", _, _), text(f, s).
quality_local_taxonomy_callee(f, s) :- node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, s).
quality_local_taxonomy_self_call(n, c) :- quality_local_taxonomy_def(n, s), inside(c, n, quality_local_taxonomy_kinds0), node(_, c, "call", _, _), field(c, "function", f), quality_local_taxonomy_callee(f, s).
quality_local_taxonomy_recursive(n) :- quality_local_taxonomy_def(n, _), k = count : { quality_local_taxonomy_self_call(n, _) }, k >= 2.
quality_local_taxonomy_dispatch(n, x) :- quality_local_taxonomy_def(n, _), inside(x, n, quality_local_taxonomy_kinds0), quality_local_taxonomy_21(x).
quality_local_taxonomy_dispatching(n) :- quality_local_taxonomy_def(n, _), k = count : { quality_local_taxonomy_dispatch(n, _) }, k >= 3.
quality_local_taxonomy_part(h, h) :- node(_, h, "string", _, _).
quality_local_taxonomy_part(h, s) :- node(_, h, "concatenated_string", _, _), child(h, s, _), node(_, s, "string", _, _).
quality_local_taxonomy_shape_message(h) :- quality_local_taxonomy_part(h, _), value(h, v), value_type_of(h, "str"), match("(?s:.*)(?:(?is)unsupported.*shape|shape.*unsupported)(?s:.*)", v).
quality_local_taxonomy_shape_message(h) :- quality_local_taxonomy_part(h, _), fstring_piece(h, _, "literal", v), match("(?s:.*)(?:(?is)unsupported.*shape|shape.*unsupported)(?s:.*)", v).
quality_local_taxonomy_message(n) :- quality_local_taxonomy_def(n, _), inside(h, n, quality_local_taxonomy_kinds0), quality_local_taxonomy_shape_message(h).
quality_local_taxonomy_self_loop(n) :- quality_local_taxonomy_self_call(n, c), inside(c, f, quality_local_taxonomy_kinds1), node(_, f, "for_statement", _, _), !quality_local_taxonomy_23(f), inside(f, n, quality_local_taxonomy_kinds0).
quality_local_taxonomy_candidates(d, n) :- quality_local_taxonomy_def(n, _), quality_local_taxonomy_recursive(n), quality_local_taxonomy_dispatching(n), quality_local_taxonomy_message(n), inside(c127, n, quality_local_taxonomy_kinds0), node(_, c127, "raise_statement", _, _), child(c127, c128, _), node(_, c128, "call", _, _), field(c128, "function", c129), node(_, c129, "identifier", _, _), text(c129, s130), match("(?s:.*)(?:^(?:TypeError)$)(?s:.*)", s130), quality_local_taxonomy_126(n), node(d134, n, _, _, _), quality_local_taxonomy_file133(d134), node(d151, n, _, _, _), quality_local_taxonomy_file150(d151), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
quality_local_taxonomy_rows(d, k) :- quality_local_taxonomy_candidates(d, _), k = count : { quality_local_taxonomy_candidates(d, _) }.
violation("data-layer-serverplan-quality", "quality-local-taxonomy", "SPQ-049", p, l) :- quality_local_taxonomy_candidates(d, n), quality_local_taxonomy_rows(d, k), k >= 2, doc(d, p, _), line(n, l).

// ---- quality-project-taxonomy (relational, SPQ-049: recursive payload taxonomy duplication) ----
// Input `candidates` (relation quality_project_taxonomy_candidates(d, n), one row per matched function_definition n of document d):
// a def whose body
//   - calls itself at least twice (quality_project_taxonomy_self_call; W's count over has stopBy end, the call's function an
//     identifier or an attribute's `attribute` whose source text equals the def's name: compare text source);
//   - has at least three if/elif whose condition is, or contains, a type-dispatch test (quality_project_taxonomy_dispatch, count min 3);
//   - has a string or concatenated string reading "unsupported ... shape" (quality_project_taxonomy_shape_message: W's value regex or
//     its pythonFString parse's literal parts, below);
//   - has `raise TypeError(...)`;
//   - has one of the six state-walk pairings (quality_project_taxonomy_walk_* / the translator's helpers), one of which is a
//     non-async for loop holding a self call (quality_project_taxonomy_self_loop);
// in a document outside tests/ and inside the clause's file scope, option-gated: the entryPoint / oracleAnalyzer cases of the policy's `$option` nodes are alternatives gated on option_value / option_on.
// Query: every candidate when the whole run has >= 2 candidate rows (partitionBy null, cross-file): quality_project_taxonomy_rows(k), the run's count.
// The key (issue, identity = start byte) is hashed with the finding id (path included): no rows merge across files.
//
// value + pythonFString parse (quality_project_taxonomy_shape_message), the host a string or concatenated_string
//   (quality_project_taxonomy_part): W's `value` regex is value(h, v) of type str (decoded, parts joined; unknown with
//   an interpolation; a bytes or t-string part has no str value); its `parse: {grammar: pythonFString, has: {kind:
//   literal, regex}}` is fstring_piece(h, _, "literal", v) (the root's literal children, decoded, a debug field's
//   `x = ` in them; no rows where W gets no tree). Exact.
// not async (^async on the for statement's text): node_text, exact.
// Uses node_text (header-declared).
.decl quality_project_taxonomy_any_kind(kind: symbol)
quality_project_taxonomy_any_kind("aliased_import"). quality_project_taxonomy_any_kind("argument_list"). quality_project_taxonomy_any_kind("as_pattern"). quality_project_taxonomy_any_kind("as_pattern_target"). quality_project_taxonomy_any_kind("assert_statement"). quality_project_taxonomy_any_kind("assignment"). quality_project_taxonomy_any_kind("attribute"). quality_project_taxonomy_any_kind("augmented_assignment"). quality_project_taxonomy_any_kind("await"). quality_project_taxonomy_any_kind("binary_operator"). quality_project_taxonomy_any_kind("block"). quality_project_taxonomy_any_kind("boolean_operator"). quality_project_taxonomy_any_kind("break_statement"). quality_project_taxonomy_any_kind("call"). quality_project_taxonomy_any_kind("case_clause"). quality_project_taxonomy_any_kind("case_pattern"). quality_project_taxonomy_any_kind("chevron"). quality_project_taxonomy_any_kind("class_definition"). quality_project_taxonomy_any_kind("class_pattern"). quality_project_taxonomy_any_kind("comparison_operator"). quality_project_taxonomy_any_kind("complex_pattern"). quality_project_taxonomy_any_kind("concatenated_string"). quality_project_taxonomy_any_kind("conditional_expression"). quality_project_taxonomy_any_kind("constrained_type"). quality_project_taxonomy_any_kind("continue_statement"). quality_project_taxonomy_any_kind("decorated_definition"). quality_project_taxonomy_any_kind("decorator"). quality_project_taxonomy_any_kind("default_parameter"). quality_project_taxonomy_any_kind("delete_statement"). quality_project_taxonomy_any_kind("dict_pattern"). quality_project_taxonomy_any_kind("dictionary"). quality_project_taxonomy_any_kind("dictionary_comprehension"). quality_project_taxonomy_any_kind("dictionary_splat"). quality_project_taxonomy_any_kind("dictionary_splat_pattern"). quality_project_taxonomy_any_kind("dotted_name"). quality_project_taxonomy_any_kind("elif_clause"). quality_project_taxonomy_any_kind("ellipsis"). quality_project_taxonomy_any_kind("else_clause"). quality_project_taxonomy_any_kind("escape_interpolation"). quality_project_taxonomy_any_kind("escape_sequence"). quality_project_taxonomy_any_kind("except_clause"). quality_project_taxonomy_any_kind("exec_statement"). quality_project_taxonomy_any_kind("expression_list"). quality_project_taxonomy_any_kind("expression_statement"). quality_project_taxonomy_any_kind("false"). quality_project_taxonomy_any_kind("finally_clause"). quality_project_taxonomy_any_kind("float"). quality_project_taxonomy_any_kind("for_in_clause"). quality_project_taxonomy_any_kind("for_statement"). quality_project_taxonomy_any_kind("format_expression"). quality_project_taxonomy_any_kind("format_specifier"). quality_project_taxonomy_any_kind("function_definition"). quality_project_taxonomy_any_kind("future_import_statement"). quality_project_taxonomy_any_kind("generator_expression"). quality_project_taxonomy_any_kind("generic_type"). quality_project_taxonomy_any_kind("global_statement"). quality_project_taxonomy_any_kind("identifier"). quality_project_taxonomy_any_kind("if_clause"). quality_project_taxonomy_any_kind("if_statement"). quality_project_taxonomy_any_kind("import_from_statement"). quality_project_taxonomy_any_kind("import_prefix"). quality_project_taxonomy_any_kind("import_statement"). quality_project_taxonomy_any_kind("integer"). quality_project_taxonomy_any_kind("interpolation"). quality_project_taxonomy_any_kind("keyword_argument"). quality_project_taxonomy_any_kind("keyword_pattern"). quality_project_taxonomy_any_kind("keyword_separator"). quality_project_taxonomy_any_kind("lambda"). quality_project_taxonomy_any_kind("lambda_parameters"). quality_project_taxonomy_any_kind("line_continuation"). quality_project_taxonomy_any_kind("list"). quality_project_taxonomy_any_kind("list_comprehension"). quality_project_taxonomy_any_kind("list_pattern"). quality_project_taxonomy_any_kind("list_splat"). quality_project_taxonomy_any_kind("list_splat_pattern"). quality_project_taxonomy_any_kind("match_statement"). quality_project_taxonomy_any_kind("member_type"). quality_project_taxonomy_any_kind("module"). quality_project_taxonomy_any_kind("named_expression"). quality_project_taxonomy_any_kind("none"). quality_project_taxonomy_any_kind("nonlocal_statement"). quality_project_taxonomy_any_kind("not_operator"). quality_project_taxonomy_any_kind("pair"). quality_project_taxonomy_any_kind("parameters"). quality_project_taxonomy_any_kind("parenthesized_expression"). quality_project_taxonomy_any_kind("parenthesized_list_splat"). quality_project_taxonomy_any_kind("pass_statement"). quality_project_taxonomy_any_kind("pattern_list"). quality_project_taxonomy_any_kind("positional_separator"). quality_project_taxonomy_any_kind("print_statement"). quality_project_taxonomy_any_kind("raise_statement"). quality_project_taxonomy_any_kind("relative_import"). quality_project_taxonomy_any_kind("return_statement"). quality_project_taxonomy_any_kind("set"). quality_project_taxonomy_any_kind("set_comprehension"). quality_project_taxonomy_any_kind("slice"). quality_project_taxonomy_any_kind("splat_pattern"). quality_project_taxonomy_any_kind("splat_type"). quality_project_taxonomy_any_kind("string"). quality_project_taxonomy_any_kind("string_content"). quality_project_taxonomy_any_kind("string_end"). quality_project_taxonomy_any_kind("string_start"). quality_project_taxonomy_any_kind("subscript"). quality_project_taxonomy_any_kind("true"). quality_project_taxonomy_any_kind("try_statement"). quality_project_taxonomy_any_kind("tuple"). quality_project_taxonomy_any_kind("tuple_pattern"). quality_project_taxonomy_any_kind("type"). quality_project_taxonomy_any_kind("type_alias_statement"). quality_project_taxonomy_any_kind("type_conversion"). quality_project_taxonomy_any_kind("type_default"). quality_project_taxonomy_any_kind("type_parameter"). quality_project_taxonomy_any_kind("typed_default_parameter"). quality_project_taxonomy_any_kind("typed_parameter"). quality_project_taxonomy_any_kind("unary_operator"). quality_project_taxonomy_any_kind("union_pattern"). quality_project_taxonomy_any_kind("union_type"). quality_project_taxonomy_any_kind("while_statement"). quality_project_taxonomy_any_kind("wildcard_import"). quality_project_taxonomy_any_kind("with_clause"). quality_project_taxonomy_any_kind("with_item"). quality_project_taxonomy_any_kind("with_statement"). quality_project_taxonomy_any_kind("yield").
.decl quality_project_taxonomy_kinds0(kind: symbol)
quality_project_taxonomy_kinds0("function_definition").
.decl quality_project_taxonomy_kinds1(kind: symbol)
quality_project_taxonomy_kinds1("for_statement").
