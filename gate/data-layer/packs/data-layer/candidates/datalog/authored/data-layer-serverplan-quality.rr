.decl spq_projection_repairs_admitted(d: number)
.decl spq_projection_repairs_fn_anchor(x: node)
.decl spq_projection_repairs_fn_blocked(x: node, f: node)
.decl spq_projection_repairs_fn_of(x: node, f: node)
.decl spq_projection_repairs_stmt_loop(n: node, lp: node)
.decl spq_projection_repairs_comp_clause(n: node, fic: node)
.decl spq_projection_repairs_loop_names(d: number, f: node, ls: number, le: number, name: symbol)
.decl spq_projection_repairs_dict_call(call: node, args: node)
.decl spq_projection_repairs_dump_call(call: node, attr: node)
.decl spq_projection_repairs_refs(d: number, name: symbol, cs: number, ce: number)
.decl spq_projection_repairs_repaired(f: node)
// requireNonemptyInput "admission", partitionBy file: a document's rows count only where admission has a row in it.
spq_projection_repairs_admitted(d) :- spq_projection_repairs_admission(m), node(d, m, _, _, _).
// capture.FN: walking up from x (the for_statement / for_in_clause), the first node the stop rule (function_definition,
// class_definition, lambda) matches is tested first: FN is x's nearest ancestor of those kinds, if a function_definition.
spq_projection_repairs_fn_anchor(lp) :- spq_projection_repairs_stmt_loop(_, lp).
spq_projection_repairs_fn_anchor(fic) :- spq_projection_repairs_comp_clause(_, fic).
spq_projection_repairs_fn_blocked(x, f) :- spq_projection_repairs_fn_anchor(x), inside(x, s, spq_projection_repairs_kinds1), inside(s, f, spq_projection_repairs_kinds2).
spq_projection_repairs_fn_of(x, f) :- spq_projection_repairs_fn_anchor(x), inside(x, f, spq_projection_repairs_kinds2), !spq_projection_repairs_fn_blocked(x, f).
// statement_loops: capture.LOOP is the for_statement the identifier's ancestor walk enters through `left`.
spq_projection_repairs_stmt_loop(n, lp) :- spq_projection_repairs_statement_loops(n), inside(n, lp, spq_projection_repairs_kinds3), field(lp, "left", x), node(d, x, _, xs, xe), node(d, n, _, ns, ne), xs <= ns, ne <= xe.
// comprehension_loops: the for_in_clause entered through `left`; capture.LOOP is its parent (the comprehension).
spq_projection_repairs_comp_clause(n, fic) :- spq_projection_repairs_comprehension_loops(n), inside(n, fic, spq_projection_repairs_kinds4), field(fic, "left", x), node(d, x, _, xs, xe), node(d, n, _, ns, ne), xs <= ns, ne <= xe.
// stage loop_names: statement_loops UNION comprehension_loops as (__path, fn, loop_start, loop_end, name).
spq_projection_repairs_loop_names(d, f, ls, le, name) :- spq_projection_repairs_stmt_loop(n, lp), spq_projection_repairs_fn_of(lp, f), node(d, lp, _, ls, le), text(n, name).
spq_projection_repairs_loop_names(d, f, ls, le, name) :- spq_projection_repairs_comp_clause(n, fic), spq_projection_repairs_fn_of(fic, f), child(lp, fic, _), node(d, lp, _, ls, le), text(n, name).
// dict_refs: capture.CALL is a call `dict(...)` whose `arguments` child is the identifier or one of its ancestors.
spq_projection_repairs_dict_call(call, args) :- field(call, "function", fnc), node(_, fnc, "identifier", _, _), text(fnc, "dict"), node(_, call, "call", _, _), field(call, "arguments", args).
// dump_refs: capture.CALL is a call `<obj>.dict(...)` / `<obj>.model_dump(...)` whose `<obj>` holds the identifier.
spq_projection_repairs_dump_call(call, attr) :- field(call, "function", attr), node(_, attr, "attribute", _, _), field(attr, "attribute", a), text(a, "dict"), node(_, call, "call", _, _).
spq_projection_repairs_dump_call(call, attr) :- field(call, "function", attr), node(_, attr, "attribute", _, _), field(attr, "attribute", a), text(a, "model_dump"), node(_, call, "call", _, _).
// dict_refs UNION ALL dump_refs as (__path, name, call_start, call_end). Every enclosing CALL candidate is a row here,
// W binds the nearest one only; the nearest lies inside every other, so `repaired` is the same (see the header).
spq_projection_repairs_refs(d, name, cs, ce) :- spq_projection_repairs_dict_refs(n), inside(n, call, spq_projection_repairs_kinds7), spq_projection_repairs_dict_call(call, args), node(d, args, _, gs, ge), node(d, n, _, ns, ne), gs <= ns, ne <= ge, node(d, call, _, cs, ce), text(n, name).
spq_projection_repairs_refs(d, name, cs, ce) :- spq_projection_repairs_dump_refs(n), inside(n, attr, spq_projection_repairs_kinds6), spq_projection_repairs_dump_call(call, attr), field(attr, "object", o), node(d, o, _, bs, be), node(d, n, _, ns, ne), bs <= ns, ne <= be, node(d, call, _, cs, ce), text(n, name).
// stage repaired: a loop variable of fn re-read by a dict / model_dump call inside the same loop.
spq_projection_repairs_repaired(f) :- spq_projection_repairs_loop_names(d, f, ls, le, name), spq_projection_repairs_refs(d, name, cs, ce), cs >= ls, ce <= le.
// query: executing_fns rows whose start is a repaired fn (both function_definition nodes: the same start is the same node).
violation("data-layer-serverplan-quality", "spq-projection-repairs", "SPQ-043", p, l) :- spq_projection_repairs_executing_fns(n), spq_projection_repairs_repaired(n), node(d, n, _, _, _), spq_projection_repairs_admitted(d), doc(d, p, _), line(n, l).

