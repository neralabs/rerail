// data-layer-serverplan-quality: the clauses the converter does not convert (decision 0043).
// Policy: gate/data-layer/packs/data-layer/candidates/rules-ast/data-layer-serverplan-quality.json.
// Older hand-written program for this rule, other clause ids and an older dialect, read for the relational
// stages: native/src/code_rule_dsl/logic/programs/data_layer/serverplan_quality*.rr.
//
// Options as the run resolves them: every `$option` case is an alternative gated on the converter-given
// option_value("entryPoint", v) and option_on("oracleAnalyzer") (defaults: "all", false).
// Every clause of the policy is here. The program reads `parsed` (spq-runtime-state-annotations' quoted_atoms), so
// the string annotations' trees are documents of the run too: their nodes have node/child/field/text rows but no
// doc, in_scope or syntax_error row, and every violation reaches its path through doc(d, p, _), so none is reported
// at one; a relation not joined to a document that reads them (in_attr, dotted) only feeds rules that are.
// The forbid clauses are their matchers rule for rule:
// - `kind` is node(_, n, kind, _, _); `regex` tests the node's whole source text (node_text), or the identifier
//   text where the rule's kinds are identifiers only; a search, as W's `regex` (match() matches the whole string, so
//   the pattern is wrapped as (?s:.*)(?:…)(?s:.*)); `filePath` and `file` the same over the path, per document;
// - `has`/`inside` with stopBy neighbor are child/field; to the end, inside(…) over the kinds of the ancestor's own
//   rule, or, with a field, byte spans within the field child; with a stop rule, a walk that does not enter (has)
//   or pass (inside) a node the stop rule matches, the stop node itself tested;
// - `has` with a field and a stop rule tests the field child and, where it does not stop, its children only
//   (W's FieldRelation::find_has);
// - `nthChild` with `ofRule` counts the siblings ofRule matches (`*_pos*`; every ofRule here excludes comments, and
//   child() has every named tape child but comments, line_continuation included, so it is exact); without, W counts
//   every named tape child, comments included: child()'s index plus the comment tokens before the node (`token` rows
//   whose text starts with `#`, per clause `*_xtok`) where a comment can stand before the node in its parent;
//   elsewhere child()'s index is exact (said per clause);
// - `not`, multi-branch `any` and stop rules are helper relations named after the clause.
// - `syntax: valid` (every AST matcher; the text clause strategy-file-size has none) is `!tape_syntax_error(d)`, the converter's one-column
//   verdict: W's own (tree-sitter ERROR nodes, eval::query's `invalid_syntax` gate), not CPython's. No stage of the
//   policy runs CPython's `ast.parse` (no pythonAst, no relational read of a parser error), so cpython_syntax_error
//   is not read.
// What a clause does not reproduce is named at the clause ("Blocked", "Not modelled").

.decl tape_syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
// A node's whole source text, exact bytes (W's `regex` subject).
// p's tape children in order, anonymous ones and comments included (W's named-sibling count reads comments).
// The type W's value.type gives n's value (the taxonomies' value regex reads str values only).
// W's `parse: {grammar: pythonFString}` root children at a string host (the taxonomies' literal regex).
// W's `parse: {grammar: annotation}` tree of a string Ruff's semantic model reads as a type definition.

// The resolved options (converter-given, read only).
.decl option_value(name: symbol, v: symbol)
.decl option_on(name: symbol)


// ---- spq-ordered-semantic-inventory (SPQ-053): ORDERED_SEMANTIC uses beyond the approved inventory per scope ------------------
// Relational clause, partitionBy file. Inputs (W matchers, translated by tr.py, `syntax: valid`, in scope):
//   spq_ordered_semantic_inventory_ordered(n)        ordered: an attribute `<x>.ORDERED_SEMANTIC` (not under tests/, data_history/, build/);
//                         row spq_ordered_semantic_inventory_row(d, n, start, end, class_name, function_name);
//   spq_ordered_semantic_inventory_scope_classes(n)  scope_classes: class_definitions, row spq_ordered_semantic_inventory_sc(d, n, start, end, NAME);
//   spq_ordered_semantic_inventory_scope_fns(n)      scope_fns: function_definitions, row spq_ordered_semantic_inventory_sf(d, n, start, end, NAME);
//   spq_ordered_semantic_inventory_admission(n)      admission (requireNonemptyInput, per file: spq_ordered_semantic_inventory_admitted(d)).
// Stages: ordered_limits = spq_ordered_semantic_inventory_limit(path, class_name, function_name, maximum), facts from the stage's JSON
// constant (no key repeats, so the scalar subquery is exact); ordered_occurrences = spq_ordered_semantic_inventory_occ(d, n, cls, fn, k):
// class_name / function_name the NAME of the smallest scope_classes / scope_fns row whose span contains the row's
// (spq_ordered_semantic_inventory_cls_in / spq_ordered_semantic_inventory_fn_in, min span), '<module>' where none; k = row_number() OVER (PARTITION BY path,
// class_name, function_name ORDER BY __start, __end DESC) = 1 + the rows of the partition before it
// (spq_ordered_semantic_inventory_before: smaller start, or the same start and a larger end). Query: k > coalesce(maximum, 0) (no limit
// row: every occurrence). Key (issue, identity = __start): one finding per row, at the attribute's line.
// Exact (the inputs are their matchers rule for rule; rows of equal span would tie in the SQL order and in the
// LIMIT 1, and distinct attribute / class / function nodes never share one). Reads node_text (the module `regex`
// gates MAINTENANCE|ORDERED_SEMANTIC and ORDERED_SEMANTIC, W's whole module text).
// Option-gated: the module gates and `file` blocks read entryPoint / oracleAnalyzer (option_value, option_on);
// at entryPoint "all" without oracleAnalyzer the admission is empty (see the default fragment).
.decl spq_ordered_semantic_inventory_kinds0(kind: symbol)
spq_ordered_semantic_inventory_kinds0("module").
.decl spq_ordered_semantic_inventory_26(n: node)
.decl spq_ordered_semantic_inventory_29(n: node)
.decl spq_ordered_semantic_inventory_43(n: node)
.decl spq_ordered_semantic_inventory_46(n: node)
.decl spq_ordered_semantic_inventory_5(n: node)
.decl spq_ordered_semantic_inventory_60(n: node)
.decl spq_ordered_semantic_inventory_63(n: node)
.decl spq_ordered_semantic_inventory_8(n: node)
.decl spq_ordered_semantic_inventory_admission(n: node)
.decl spq_ordered_semantic_inventory_file12(d: number)
.decl spq_ordered_semantic_inventory_file20(d: number)
.decl spq_ordered_semantic_inventory_ordered(n: node)
.decl spq_ordered_semantic_inventory_scope_classes(n: node)
.decl spq_ordered_semantic_inventory_scope_fns(n: node)
spq_ordered_semantic_inventory_5(n) :- node(_, n, "attribute", _, _), option_on("oracleAnalyzer").
spq_ordered_semantic_inventory_5(n) :- !option_on("oracleAnalyzer"), inside(n, c3, spq_ordered_semantic_inventory_kinds0), node(_, c3, "module", _, _), node_text(c3, s4), match("(?s:.*)(?:MAINTENANCE|ORDERED_SEMANTIC)(?s:.*)", s4).
spq_ordered_semantic_inventory_8(n) :- option_value("entryPoint", "all"), spq_ordered_semantic_inventory_5(n).
spq_ordered_semantic_inventory_8(n) :- node(_, n, "attribute", _, _), option_value("entryPoint", "_check_serverplan_quality_source").
spq_ordered_semantic_inventory_8(n) :- node(_, n, "attribute", _, _), option_value("entryPoint", e1), e1 != "all", e1 != "_check_serverplan_quality_source".
spq_ordered_semantic_inventory_file12(d) :- doc(d, p11, _), !match("(?s:.*)(?:(?:^|/)tests(?:/|$)|(?:^|/)(?:data_history|build)(?:/|$))(?s:.*)", p11).
spq_ordered_semantic_inventory_file20(d) :- doc(d, _, _), option_value("entryPoint", "_check_ordered_semantic_batch_inventory").
spq_ordered_semantic_inventory_file20(d) :- doc(d, _, _), option_value("entryPoint", "_check_serverplan_quality_source").
spq_ordered_semantic_inventory_file20(d) :- doc(d, _, _), option_value("entryPoint", "all").
spq_ordered_semantic_inventory_ordered(n) :- node(_, n, "attribute", _, _), spq_ordered_semantic_inventory_8(n), field(n, "attribute", c9), node(_, c9, "identifier", _, _), text(c9, s10), match("(?s:.*)(?:^(?:ORDERED_SEMANTIC)$)(?s:.*)", s10), node(d13, n, _, _, _), spq_ordered_semantic_inventory_file12(d13), field(n, "attribute", c14), node(d21, n, _, _, _), spq_ordered_semantic_inventory_file20(d21), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
spq_ordered_semantic_inventory_26(n) :- node(_, n, "class_definition", _, _), option_on("oracleAnalyzer").
spq_ordered_semantic_inventory_26(n) :- !option_on("oracleAnalyzer"), inside(n, c24, spq_ordered_semantic_inventory_kinds0), node(_, c24, "module", _, _), node_text(c24, s25), match("(?s:.*)(?:MAINTENANCE|ORDERED_SEMANTIC)(?s:.*)", s25).
spq_ordered_semantic_inventory_29(n) :- option_value("entryPoint", "all"), spq_ordered_semantic_inventory_26(n).
spq_ordered_semantic_inventory_29(n) :- node(_, n, "class_definition", _, _), option_value("entryPoint", "_check_serverplan_quality_source").
spq_ordered_semantic_inventory_29(n) :- node(_, n, "class_definition", _, _), option_value("entryPoint", e22), e22 != "all", e22 != "_check_serverplan_quality_source".
spq_ordered_semantic_inventory_scope_classes(n) :- node(_, n, "class_definition", _, _), spq_ordered_semantic_inventory_29(n), field(n, "name", c30), inside(n, c31, spq_ordered_semantic_inventory_kinds0), node(_, c31, "module", _, _), node_text(c31, s32), match("(?s:.*)(?:ORDERED_SEMANTIC)(?s:.*)", s32), node(d38, n, _, _, _), spq_ordered_semantic_inventory_file20(d38), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
spq_ordered_semantic_inventory_43(n) :- node(_, n, "function_definition", _, _), option_on("oracleAnalyzer").
spq_ordered_semantic_inventory_43(n) :- !option_on("oracleAnalyzer"), inside(n, c41, spq_ordered_semantic_inventory_kinds0), node(_, c41, "module", _, _), node_text(c41, s42), match("(?s:.*)(?:MAINTENANCE|ORDERED_SEMANTIC)(?s:.*)", s42).
spq_ordered_semantic_inventory_46(n) :- option_value("entryPoint", "all"), spq_ordered_semantic_inventory_43(n).
spq_ordered_semantic_inventory_46(n) :- node(_, n, "function_definition", _, _), option_value("entryPoint", "_check_serverplan_quality_source").
spq_ordered_semantic_inventory_46(n) :- node(_, n, "function_definition", _, _), option_value("entryPoint", e39), e39 != "all", e39 != "_check_serverplan_quality_source".
spq_ordered_semantic_inventory_scope_fns(n) :- node(_, n, "function_definition", _, _), spq_ordered_semantic_inventory_46(n), field(n, "name", c47), inside(n, c48, spq_ordered_semantic_inventory_kinds0), node(_, c48, "module", _, _), node_text(c48, s49), match("(?s:.*)(?:ORDERED_SEMANTIC)(?s:.*)", s49), node(d55, n, _, _, _), spq_ordered_semantic_inventory_file20(d55), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
spq_ordered_semantic_inventory_60(n) :- node(_, n, "module", _, _), option_on("oracleAnalyzer").
spq_ordered_semantic_inventory_60(n) :- !option_on("oracleAnalyzer"), inside(n, c58, spq_ordered_semantic_inventory_kinds0), node(_, c58, "module", _, _), node_text(c58, s59), match("(?s:.*)(?:MAINTENANCE|ORDERED_SEMANTIC)(?s:.*)", s59).
spq_ordered_semantic_inventory_63(n) :- option_value("entryPoint", "all"), spq_ordered_semantic_inventory_60(n).
spq_ordered_semantic_inventory_63(n) :- node(_, n, "module", _, _), option_value("entryPoint", "_check_serverplan_quality_source").
spq_ordered_semantic_inventory_63(n) :- node(_, n, "module", _, _), option_value("entryPoint", e56), e56 != "all", e56 != "_check_serverplan_quality_source".
spq_ordered_semantic_inventory_admission(n) :- node(_, n, "module", _, _), spq_ordered_semantic_inventory_63(n), node_text(n, s64), match("(?s:.*)(?:ORDERED_SEMANTIC)(?s:.*)", s64), node(d70, n, _, _, _), spq_ordered_semantic_inventory_file20(d70), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
.decl spq_ordered_semantic_inventory_limit(path: symbol, cls: symbol, fn: symbol, maximum: number)
.decl spq_ordered_semantic_inventory_limited(path: symbol, cls: symbol, fn: symbol)
.decl spq_ordered_semantic_inventory_admitted(d: number)
.decl spq_ordered_semantic_inventory_sc(d: number, n: node, b: number, e: number, nm: symbol)
.decl spq_ordered_semantic_inventory_sf(d: number, n: node, b: number, e: number, nm: symbol)
.decl spq_ordered_semantic_inventory_cls_in(n: node, c: node, z: number)
.decl spq_ordered_semantic_inventory_fn_in(n: node, c: node, z: number)
.decl spq_ordered_semantic_inventory_cls_of(n: node, nm: symbol)
.decl spq_ordered_semantic_inventory_fn_of(n: node, nm: symbol)
.decl spq_ordered_semantic_inventory_has_cls(n: node)
.decl spq_ordered_semantic_inventory_has_fn(n: node)
.decl spq_ordered_semantic_inventory_class_name(n: node, nm: symbol)
.decl spq_ordered_semantic_inventory_function_name(n: node, nm: symbol)
.decl spq_ordered_semantic_inventory_row(d: number, n: node, b: number, e: number, cls: symbol, fn: symbol)
.decl spq_ordered_semantic_inventory_before(n: node, m: node)
.decl spq_ordered_semantic_inventory_occ(d: number, n: node, cls: symbol, fn: symbol, k: number)
.decl spq_ordered_semantic_inventory_hit(d: number, n: node)
