conditional_architecture_k_contract("impl.common.l2070_server_plan.sql_backend_executor.SqlBackendExecutor"). conditional_architecture_k_contract("impl.common.l2070_server_plan.steps.sql_conditional.SqlConditionalStep"). conditional_architecture_k_contract("l2070_batching.conditional_step.ConditionalStep").
conditional_architecture_class(d, n, s, e, nm) :- conditional_architecture_classes(n), node(d, n, _, s, e), field(n, "name", x), text(x, nm).
conditional_architecture_fn(d, n, s, e, nm) :- conditional_architecture_fns(n), node(d, n, _, s, e), field(n, "name", x), text(x, nm).
conditional_architecture_digit(0). conditional_architecture_digit(1). conditional_architecture_digit(2). conditional_architecture_digit(3). conditional_architecture_digit(4). conditional_architecture_digit(5). conditional_architecture_digit(6). conditional_architecture_digit(7). conditional_architecture_digit(8). conditional_architecture_digit(9). conditional_architecture_digit(10). conditional_architecture_digit(11). conditional_architecture_digit(12). conditional_architecture_digit(13). conditional_architecture_digit(14). conditional_architecture_digit(15). conditional_architecture_digit(16). conditional_architecture_digit(17). conditional_architecture_digit(18). conditional_architecture_digit(19). conditional_architecture_digit(20). conditional_architecture_digit(21). conditional_architecture_digit(22). conditional_architecture_digit(23). conditional_architecture_digit(24). conditional_architecture_digit(25). conditional_architecture_digit(26). conditional_architecture_digit(27). conditional_architecture_digit(28). conditional_architecture_digit(29). conditional_architecture_digit(30). conditional_architecture_digit(31). conditional_architecture_digit(32). conditional_architecture_digit(33). conditional_architecture_digit(34). conditional_architecture_digit(35). conditional_architecture_digit(36). conditional_architecture_digit(37). conditional_architecture_digit(38). conditional_architecture_digit(39). conditional_architecture_digit(40). conditional_architecture_digit(41). conditional_architecture_digit(42). conditional_architecture_digit(43). conditional_architecture_digit(44). conditional_architecture_digit(45). conditional_architecture_digit(46). conditional_architecture_digit(47). conditional_architecture_digit(48). conditional_architecture_digit(49). conditional_architecture_digit(50). conditional_architecture_digit(51). conditional_architecture_digit(52). conditional_architecture_digit(53). conditional_architecture_digit(54). conditional_architecture_digit(55). conditional_architecture_digit(56). conditional_architecture_digit(57). conditional_architecture_digit(58). conditional_architecture_digit(59). conditional_architecture_digit(60). conditional_architecture_digit(61). conditional_architecture_digit(62). conditional_architecture_digit(63).
conditional_architecture_mpath(d, p) :- conditional_architecture_class(d, _, _, _, _), doc(d, p, _).
conditional_architecture_mpath(d, p) :- conditional_architecture_fn(d, _, _, _, _), doc(d, p, _).
// module_names: rx_extract(path, RE, 1) is the group of @rx_replace(path, '^(?s:.*?)(?:RE)(?s:.*)$', '$1') where RE
// matches (the lazy prefix puts the match where find_iter's first one starts, and RE's own preference is the same).
conditional_architecture_module(d, q) :- conditional_architecture_mpath(d, p), match("(?s:.*)(?:(?:^|/)(?:impl|l2070_batching|scripts)/)(?s:.*)", p), match("(?s:.*)(?:(?:^|/)((?:impl|l2070_batching|scripts)/.*)\\.py$)(?s:.*)", p), u = @rx_replace(p, "^(?s:.*?)(?:(?:^|/)((?:impl|l2070_batching|scripts)/.*)\\.py$)(?s:.*)$", "$1"), q = @rx_replace(u, "/", ".").
conditional_architecture_module(d, q) :- conditional_architecture_mpath(d, p), !match("(?s:.*)(?:(?:^|/)(?:impl|l2070_batching|scripts)/)(?s:.*)", p), match("(?s:.*)(?:(?:^|/)([^/]+)\\.py$)(?s:.*)", p), q = @rx_replace(p, "^(?s:.*?)(?:(?:^|/)([^/]+)\\.py$)(?s:.*)$", "$1").
conditional_architecture_from_item(d, s, i, n) :- conditional_architecture_from_names(n), child(n, i, _), node(d, i, k, s, _), conditional_architecture_k_import_item(k), !field(n, "module_name", i).
conditional_architecture_direct_item(d, s, i, n) :- conditional_architecture_direct_names(n), child(n, i, _), node(d, i, k, s, _), conditional_architecture_k_import_item(k), !field(n, "module_name", i).
conditional_architecture_mfull(n, t) :- conditional_architecture_from_names(n), field(n, "module_name", m), node_text(m, x), t = @rx_replace(x, "^\\.+|\\.+$", "").
conditional_architecture_alias(d, s, l, o) :- conditional_architecture_from_item(d, s, i, n), node(d, i, "dotted_name", _, _), node_text(i, l), conditional_architecture_mfull(n, m), o = cat(cat(m, "."), l).
conditional_architecture_alias(d, s, l, o) :- conditional_architecture_from_item(d, s, i, n), node(d, i, "aliased_import", _, _), field(i, "alias", a), node_text(a, l), field(i, "name", x), node_text(x, nm), conditional_architecture_mfull(n, m), o = cat(cat(m, "."), nm).
conditional_architecture_alias(d, s, l, o) :- conditional_architecture_direct_item(d, s, i, _), node(d, i, "dotted_name", _, _), node_text(i, o), match("\\w(?s:.*)", o), l = @rx_replace(o, "^(\\w+)(?s:.*)$", "$1").
conditional_architecture_alias(d, s, l, o) :- conditional_architecture_direct_item(d, s, i, _), node(d, i, "aliased_import", _, _), field(i, "alias", a), node_text(a, l), field(i, "name", x), node_text(x, o).
conditional_architecture_cclass(d, n, s, e, nm, qn) :- conditional_architecture_class(d, n, s, e, nm), s = max u : { conditional_architecture_class(d, _, u, _, nm) }, conditional_architecture_module(d, m), qn = cat(cat(m, "."), nm).
conditional_architecture_has_qn(qn) :- conditional_architecture_cclass(_, _, _, _, _, qn).
// base_scan: t is the superclasses text without its parentheses, n its commas. A comma (the k-th, from 0) splits at
// depth 0 where the text before it opens as many brackets as it closes (split); the items are the texts between
// consecutive splits (cut: commas skipped before the item, from the start or after a split; stop: the next split or
// the end), trimmed of space, tab, LF and CR. k runs over sup_k: n's digits in base 64, four of them.
conditional_architecture_sup(c, t, n) :- conditional_architecture_class_sups(c), field(c, "superclasses", g), node_text(g, x), t = substr(x, 1, strlen(x) - 2), n = strlen(@rx_replace(t, "[^,]", "")).
conditional_architecture_sup_k1(c, k) :- conditional_architecture_sup(c, _, n), conditional_architecture_digit(a), k = a * 262144, k < n.
conditional_architecture_sup_k2(c, k) :- conditional_architecture_sup_k1(c, h), conditional_architecture_sup(c, _, n), conditional_architecture_digit(a), k = h + a * 4096, k < n.
conditional_architecture_sup_k3(c, k) :- conditional_architecture_sup_k2(c, h), conditional_architecture_sup(c, _, n), conditional_architecture_digit(a), k = h + a * 64, k < n.
conditional_architecture_sup_k(c, k) :- conditional_architecture_sup_k3(c, h), conditional_architecture_sup(c, _, n), conditional_architecture_digit(a), k = h + a, k < n.
conditional_architecture_split(c, k) :- conditional_architecture_sup_k(c, k), conditional_architecture_sup(c, t, _), re = cat(cat("^((?:[^,]*,){", to_string(k)), "}[^,]*),(?s:.*)$"), u = @rx_replace(t, re, "$1"), o = strlen(@rx_replace(u, "[^(\\[{]", "")), z = strlen(@rx_replace(u, "[^)\\]}]", "")), o = z.
conditional_architecture_cut(c, 0) :- conditional_architecture_sup(c, _, _).
conditional_architecture_cut(c, j) :- conditional_architecture_split(c, k), j = k + 1.
conditional_architecture_stop(c, k) :- conditional_architecture_split(c, k).
conditional_architecture_stop(c, n) :- conditional_architecture_sup(c, _, n).
conditional_architecture_item(c, x) :- conditional_architecture_cut(c, j), conditional_architecture_sup(c, t, _), q = min y : { conditional_architecture_stop(c, y), y >= j }, re = cat(cat(cat(cat("^(?:[^,]*,){", to_string(j)), "}([^,]*(?:,[^,]*){"), to_string(q - j)), "})(?:,(?s:.*))?$"), u = @rx_replace(t, re, "$1"), x = @rx_replace(u, "^[ \\t\\n\\r]+|[ \\t\\n\\r]+$", "").
// bases, over the items of a cclasses row (class_bases joins them to it).
conditional_architecture_base(c, x) :- conditional_architecture_cclass(_, c, _, _, _, _), conditional_architecture_item(c, x), match("[A-Za-z_]\\w*(?:\\s*\\.\\s*[A-Za-z_]\\w*)*", x).
conditional_architecture_base(c, x) :- conditional_architecture_cclass(_, c, _, _, _, _), conditional_architecture_item(c, x), match("[A-Za-z_][\\w.\\s]*\\((?s:.*)", x), match("(?s:.*)\\)", x).
conditional_architecture_sp_cand(f, i, ann) :- conditional_architecture_step_params(f), field(f, "parameters", ps), child(ps, tp, i), node(_, tp, k, _, _), conditional_architecture_k_typed(k), child(tp, x, 0), node(_, x, "identifier", _, _), text(x, "step"), field(tp, "type", ann).
conditional_architecture_step_ann(f, ann) :- conditional_architecture_sp_cand(f, i, ann), i = min j : { conditional_architecture_sp_cand(f, j, _) }.
// rx_extract(x,'^([\w]+)',1) and rx_extract(x,'^[\w]+((?:\.[\w]+)*)',1) (with '$' for the step annotation): the groups
// of @rx_replace over the same anchored regex; no head (NULL) gives no row, as NULL equals no name.
conditional_architecture_base_head(x, h) :- conditional_architecture_base(_, x), match("\\w(?s:.*)", x), h = @rx_replace(x, "^(\\w+)(?s:.*)$", "$1").
conditional_architecture_base_suffix(x, sf) :- conditional_architecture_base_head(x, _), sf = @rx_replace(x, "^\\w+((?:\\.\\w+)*)(?s:.*)$", "$1").
conditional_architecture_ann(a, x) :- conditional_architecture_step_ann(_, a), node_text(a, x).
conditional_architecture_ann_head(a, h) :- conditional_architecture_ann(a, x), match("\\w(?s:.*)", x), h = @rx_replace(x, "^(\\w+)(?s:.*)$", "$1").
conditional_architecture_resolve_need(d, h, cs) :- conditional_architecture_cclass(d, c, cs, _, _, _), conditional_architecture_base(c, x), conditional_architecture_base_head(x, h).
conditional_architecture_resolve_need(d, h, fs) :- conditional_architecture_cfunc(d, f, fs, _, "impl.common.l2070_server_plan.steps._conditional_compile.compile_sql_conditional_step"), conditional_architecture_step_ann(f, a), conditional_architecture_ann_head(a, h).
conditional_architecture_resolve_cand(d, h, cs, s) :- conditional_architecture_resolve_need(d, h, cs), conditional_architecture_alias(d, s, h, _), s < cs.
conditional_architecture_has_resolve_cand(d, h, cs) :- conditional_architecture_resolve_cand(d, h, cs, _).
conditional_architecture_resolved(d, h, cs, o) :- conditional_architecture_has_resolve_cand(d, h, cs), m = max s : { conditional_architecture_resolve_cand(d, h, cs, s) }, conditional_architecture_alias(d, m, h, o).
conditional_architecture_resolved(d, h, cs, h) :- conditional_architecture_resolve_need(d, h, cs), !conditional_architecture_has_resolve_cand(d, h, cs).
conditional_architecture_class_base(c, nm) :- conditional_architecture_cclass(d, c, cs, _, _, _), conditional_architecture_base(c, x), conditional_architecture_base_head(x, h), conditional_architecture_resolved(d, h, cs, o), conditional_architecture_base_suffix(x, sf), nm = cat(o, sf).
conditional_architecture_derived("l2070_batching.conditional_step.ConditionalStep").
conditional_architecture_derived(qn) :- conditional_architecture_derived(b), conditional_architecture_class_base(c, b), conditional_architecture_cclass(_, c, _, _, _, qn).
conditional_architecture_fn_in(f, c, cs) :- conditional_architecture_fn(d, f, fs, fe, _), conditional_architecture_class(d, c, cs, ce, _), cs < fs, ce >= fe.
conditional_architecture_fn_cls(f, c) :- conditional_architecture_fn_in(f, c, cs), cs = max u : { conditional_architecture_fn_in(f, _, u) }.
conditional_architecture_has_cls(f) :- conditional_architecture_fn_in(f, _, _).
conditional_architecture_meth_cand(d, c, nm, f, fs, fe) :- conditional_architecture_fn_cls(f, c), conditional_architecture_fn(d, f, fs, fe, nm).
conditional_architecture_cmethod(d, f, fs, fe, nm, c) :- conditional_architecture_meth_cand(d, c, nm, f, fs, fe), conditional_architecture_cclass(d, c, _, _, _, _), fs = max u : { conditional_architecture_meth_cand(d, c, nm, _, u, _) }.
conditional_architecture_cmethod_derived(f) :- conditional_architecture_cmethod(_, f, _, _, _, c), conditional_architecture_cclass(_, c, _, _, _, qn), conditional_architecture_derived(qn).
conditional_architecture_has_method(c, nm) :- conditional_architecture_cmethod(_, _, _, _, nm, c).
conditional_architecture_func_cand(d, nm, f, fs, fe) :- conditional_architecture_fn(d, f, fs, fe, nm), !conditional_architecture_has_cls(f).
conditional_architecture_cfunc(d, f, fs, fe, qn) :- conditional_architecture_func_cand(d, nm, f, fs, fe), fs = max u : { conditional_architecture_func_cand(d, nm, _, u, _) }, conditional_architecture_module(d, m), qn = cat(cat(m, "."), nm).
conditional_architecture_has_cfunc(qn) :- conditional_architecture_cfunc(_, _, _, _, qn).
conditional_architecture_ownee(n) :- conditional_architecture_self_stores(n).
conditional_architecture_ownee(n) :- conditional_architecture_compile_calls(n).
conditional_architecture_ownee(n) :- conditional_architecture_controls(n).
conditional_architecture_ownee(n) :- conditional_architecture_vnodes(n), node(_, n, "block", _, _).
conditional_architecture_own_in(n, f, fs) :- conditional_architecture_ownee(n), node(d, n, _, ns, ne), conditional_architecture_fn(d, f, fs, fe, _), fs < ns, fe >= ne.
conditional_architecture_own_fn(n, f) :- conditional_architecture_own_in(n, f, fs), fs = max u : { conditional_architecture_own_in(n, _, u) }.
conditional_architecture_vchild(p, x) :- conditional_architecture_vnodes(x), child(p, x, _).
conditional_architecture_cblock(b) :- conditional_architecture_vnodes(b), node(_, b, "block", _, _), conditional_architecture_own_fn(b, f), conditional_architecture_cmethod(_, f, _, _, "require_sql_physical_conditional", _).
conditional_architecture_barrier(b, s) :- conditional_architecture_cblock(b), conditional_architecture_vchild(b, x), node(_, x, k, s, _), conditional_architecture_k_barrier(k).
conditional_architecture_has_barrier(b) :- conditional_architecture_barrier(b, _).
conditional_architecture_limit(b, m) :- conditional_architecture_has_barrier(b), m = min s : { conditional_architecture_barrier(b, s) }.
conditional_architecture_limit(b, e) :- conditional_architecture_cblock(b), node(_, b, _, _, e), !conditional_architecture_has_barrier(b).
conditional_architecture_body_stmt(b, x) :- conditional_architecture_cblock(b), conditional_architecture_vchild(b, x), node(_, x, _, xs, _), conditional_architecture_limit(b, l), xs <= l.
conditional_architecture_typeerror(x) :- conditional_architecture_vnodes(x), node(_, x, "raise_statement", _, _), node_text(x, s), match("(?s:.*)(?:^raise\\s+TypeError(?:\\s*\\(|\\s*$))(?s:.*)", s).
conditional_architecture_if_else(x) :- conditional_architecture_vnodes(x), node(_, x, "if_statement", _, _), conditional_architecture_vchild(x, e), node(_, e, "else_clause", _, _).
conditional_architecture_match_case(x) :- conditional_architecture_vnodes(x), node(d, x, "match_statement", xs, xe), conditional_architecture_vnodes(a), node(d, a, "case_clause", a1, a2), a1 > xs, a2 <= xe.
conditional_architecture_cand(x) :- conditional_architecture_if_else(x).
conditional_architecture_cand(x) :- conditional_architecture_match_case(x).
conditional_architecture_sub(x, c) :- conditional_architecture_if_else(x), conditional_architecture_vchild(x, c), conditional_architecture_cblock(c).
conditional_architecture_sub(x, c) :- conditional_architecture_if_else(x), conditional_architecture_vchild(x, a), node(_, a, k, _, _), conditional_architecture_k_arm(k), conditional_architecture_vchild(a, c), conditional_architecture_cblock(c).
conditional_architecture_sub(x, c) :- conditional_architecture_match_case(x), node(d, x, _, xs, xe), conditional_architecture_vnodes(a), node(d, a, "case_clause", a1, a2), a1 > xs, a2 <= xe, conditional_architecture_vchild(a, c), conditional_architecture_cblock(c).
conditional_architecture_sub_before(x, c, c2) :- conditional_architecture_sub(x, c), node(_, c, _, cs, _), conditional_architecture_sub(x, c2), node(_, c2, _, s2, _), s2 < cs.
conditional_architecture_sub_rank(x, c, i) :- conditional_architecture_sub(x, c), i = count : { conditional_architecture_sub_before(x, c, _) }.
conditional_architecture_has_sub(x) :- conditional_architecture_sub(x, _).
conditional_architecture_sub_count(x, k) :- conditional_architecture_has_sub(x), k = count : { conditional_architecture_sub(x, _) }.
conditional_architecture_sub_next(x, c, c2) :- conditional_architecture_sub_rank(x, c, i), conditional_architecture_sub_rank(x, c2, j), j = i + 1.
conditional_architecture_ok_upto(x, c) :- conditional_architecture_sub_rank(x, c, 0), conditional_architecture_raises(c).
conditional_architecture_ok_upto(x, c2) :- conditional_architecture_ok_upto(x, c), conditional_architecture_sub_next(x, c, c2), conditional_architecture_raises(c2).
conditional_architecture_all_ok(x) :- conditional_architecture_cand(x), !conditional_architecture_has_sub(x).
conditional_architecture_all_ok(x) :- conditional_architecture_sub_count(x, k), conditional_architecture_sub_rank(x, c, i), i = k - 1, conditional_architecture_ok_upto(x, c).
conditional_architecture_raises(b) :- conditional_architecture_body_stmt(b, x), conditional_architecture_typeerror(x).
conditional_architecture_raises(b) :- conditional_architecture_body_stmt(b, x), conditional_architecture_cand(x), conditional_architecture_all_ok(x).
conditional_architecture_always(m) :- conditional_architecture_cmethod(_, m, _, _, "require_sql_physical_conditional", _), conditional_architecture_vchild(m, b), node(_, b, "block", _, _), conditional_architecture_raises(b).
conditional_architecture_intret(f, r, v) :- conditional_architecture_int_returns(f), inside(r, f, conditional_architecture_kinds0), node(_, r, "return_statement", _, _), child(r, v, _), node(_, v, k, _, _), conditional_architecture_k_int(k).
conditional_architecture_mret(c, f, r, v) :- conditional_architecture_cmethod(d, m, ms, me, "level", c), conditional_architecture_intret(f, r, v), node(d, r, _, rs, re), rs >= ms, rs <= me, re <= me.
conditional_architecture_zero(v) :- conditional_architecture_intret(_, _, v), node(_, v, "false", _, _).
conditional_architecture_zero(v) :- conditional_architecture_intret(_, _, v), node(_, v, "integer", _, _), node_text(v, s), match("0+(?:[^0-9](?s:.*))?", s).
conditional_architecture_has_mret(c) :- conditional_architecture_mret(c, _, _, _).
conditional_architecture_has_zero_mret(c) :- conditional_architecture_mret(c, _, _, v), conditional_architecture_zero(v).
