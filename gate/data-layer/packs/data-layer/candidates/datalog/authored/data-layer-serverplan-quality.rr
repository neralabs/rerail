spq_preop_functions_admission(n) :- node(_, n, "module", _, _), node_text(n, s68), match("(?s:.*)(?:pre_op)(?s:.*)", s68), node_text(n, s69), match("(?s:.*)(?:CompiledStep)(?s:.*)", s69), node(d77, n, _, _, _), spq_preop_functions_file76(d77), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
.decl spq_preop_functions_admitted(d: number)
.decl spq_preop_functions_fn_name(f: node, name: symbol)
.decl spq_preop_functions_callee(c: node, callee: symbol)
.decl spq_preop_functions_calls_in(d: number, name: symbol, callee: symbol)
.decl spq_preop_functions_imperative(d: number, name: symbol)
.decl spq_preop_functions_preop_kw(kw: symbol)
.decl spq_preop_functions_step_value(n: node, v: symbol)
// requireNonemptyInput "admission", partitionBy file: a document's rows count only where admission has a row in it.
spq_preop_functions_admitted(d) :- spq_preop_functions_admission(m), node(d, m, _, _, _).
// capture.NAME of preop_fns / preop_seeds: the function's `name` child (an identifier: text is its source text).
spq_preop_functions_fn_name(f, s) :- spq_preop_functions_preop_fns(f), field(f, "name", x), text(x, s).
spq_preop_functions_fn_name(f, s) :- spq_preop_functions_preop_seeds(f), field(f, "name", x), text(x, s).
// capture.CALLEE of preop_calls: the `function` child where it is an identifier, else the attribute's `attribute`.
spq_preop_functions_callee(c, s) :- spq_preop_functions_preop_calls(c), field(c, "function", x), node(_, x, "identifier", _, _), text(x, s).
spq_preop_functions_callee(c, s) :- spq_preop_functions_preop_calls(c), field(c, "function", x), node(_, x, "attribute", _, _), field(x, "attribute", a), text(a, s).
// The join preop_fns f x preop_calls c ON c.__start > f.__start AND c.__end <= f.__end: c lies within f's span, i.e.
// c is a descendant of f (nested functions included); f's own start is `def`/`async`, never a call's.
spq_preop_functions_calls_in(d, name, callee) :- spq_preop_functions_callee(c, callee), inside(c, f, spq_preop_functions_kinds1), spq_preop_functions_preop_fns(f), spq_preop_functions_fn_name(f, name), node(d, f, _, _, _).
// stage imperative (WITH RECURSIVE): seeds, then functions of the file calling an imperative name, by name, per file.
spq_preop_functions_imperative(d, name) :- spq_preop_functions_preop_seeds(f), spq_preop_functions_fn_name(f, name), node(d, f, _, _, _).
spq_preop_functions_imperative(d, name) :- spq_preop_functions_calls_in(d, name, callee), spq_preop_functions_imperative(d, callee).
// preop_steps with each VALUE: one row per keyword argument pre_op= / async_pre_op= whose value is an identifier.
spq_preop_functions_preop_kw("pre_op"). spq_preop_functions_preop_kw("async_pre_op").
spq_preop_functions_step_value(n, v) :- spq_preop_functions_preop_steps(n), field(n, "arguments", args), child(args, kw, _), node(_, kw, "keyword_argument", _, _), field(kw, "name", k), text(k, ks), spq_preop_functions_preop_kw(ks), field(kw, "value", x), node(_, x, "identifier", _, _), text(x, v).
// query: preop_steps rows whose value names an imperative function of the same file; key (issue, call start).
violation("data-layer-serverplan-quality", "spq-preop-functions", "SPQ-020", p, l) :- spq_preop_functions_step_value(n, v), node(d, n, _, _, _), spq_preop_functions_admitted(d), spq_preop_functions_imperative(d, v), doc(d, p, _), line(n, l).

