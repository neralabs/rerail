// ---- spq-runtime-state-annotations (SPQ-050) ----
// Relational clause, partitionBy file: every relation is per document d. Policy stages -> relations:
//   admission (+ every input's file / filePath / `inside module` regex gate; requireNonemptyInput) -> spq_runtime_state_annotations_doc(d)
//   fn_scopes, class_scopes, scope_nodes -> spq_runtime_state_annotations_scope(d, s), spq_runtime_state_annotations_scope_name(d, s, name); scope id -1 (no enclosing
//     scope) is the document's module node.
//   annotated, annotations -> spq_runtime_state_annotations_ann(d, a, scope): `ORDER BY s.id DESC LIMIT 1` over scope spans = nearest(a, s,
//     spq_runtime_state_annotations_scope_kinds), exact: within one admitted document the scope nodes are every function/class definition,
//     and a node enclosing another's span with a smaller start is a strict ancestor.
//   scopes, scope_chain (WITH RECURSIVE) -> spq_runtime_state_annotations_chain(d, scope, ancestor, depth): the chain is the scope, then its
//     function_definition ancestors innermost first, then the module; depth counts without recursion (the engine
//     refuses value-creating recursion): an ancestor's depth is 1 + the function ancestors of the scope inside it.
//   from_imports, direct_imports, scope_imports -> spq_runtime_state_annotations_imp(d, scope, name, origin)
//   bound_names, plain_params, typed_params, global_names, nonlocal_names, scope_shadows -> spq_runtime_state_annotations_shadow(d, scope, name)
//   name_atoms, member_atoms, quoted_atoms, annotation_atoms -> spq_runtime_state_annotations_atom(d, annotation, atom_id, start, end, atom)
//   atom_imports -> spq_runtime_state_annotations_ai(d, a, id, origin) (+ spq_runtime_state_annotations_first: the nearest chain depth importing the head name;
//     spq_runtime_state_annotations_shadowed: a shadow of it at depth <= that)
//   resolved_atoms -> spq_runtime_state_annotations_res(d, a, id, start, end, atom, origin), trusted -> spq_runtime_state_annotations_trusted(d, a, id)
//   any_args, later_args -> spq_runtime_state_annotations_arg(d, a, start, end, base_start, base_end, any_arg)
//   ignored_annotation_metadata -> spq_runtime_state_annotations_ign(d, a, id)
//   query (callable: / service: rows, key issue+identity) -> spq_runtime_state_annotations_hit(d, a); both identities are SPQ-050 at the
//     annotation's line, so they collapse in the (path, line, code) set.
// Kept from W/SQL as written:
// - scope_shadows' fourth branch aliases its subquery `s` over the outer `s`, so `s.id<s.__start` is never true and
//   every function/class name shadows at module scope (-1): reproduced as such (spq_runtime_state_annotations_shadow at the module node).
// - rx_extract(x,'^[A-Za-z_]\w*',0) / rx_extract(x,'^[^.]+',0): where x starts with a match, the group of
//   @rx_replace(x, '^(RE)(?s:.*)$', '$1') (the anchored match is the first one, its greedy run the same:
//   spq_runtime_state_annotations_head, spq_runtime_state_annotations_seg); where it does not (NULL), no row, as the SQL join drops it.
// - rx_replace(text,'\s+','') on a dotted member atom is @rx_replace over its node_text (W's capture text).
// - later_args' nthChild "n+2" counts comments in W: an argument is later where child() puts it after the first, or
//   where it is child() 0 and a comment token of the type_parameter precedes it (`Annotated[  # c` NL `T, m]`). The
//   generic_type's nthChild 1 is its base and typed_params' its name, both where the parent starts: exact. A comment
//   as any_args' ARG spans no atom, so it ignores none: exact.
// node_text is used for the module regex, the dotted-chain regex and text, and a relative import's module text.
// quoted_atoms: W parses a string annotation (`x: "Conn"`) with `parse: {grammar: annotation}`, Ruff's
//   `parse_type_annotation` over the string's value, at the strings Ruff's scope table reads as type definitions
//   (`literal::annotation`, `matcher::parse`: no table entry, no match), and reads the tree's identifiers and
//   attributes not under an attribute as atoms (`has` stopBy end from the tree's expression_statement root). That
//   is `parsed(s, "annotation", root)` (only a string_annotation has one) and `inside(n, root, "expression_statement")`:
//   exact. A string Ruff's parser refuses is an ERROR root in W, whose `has` finds nothing, and has no `parsed` row
//   here. A nested string (`"List['A']"`'s `'A'`) is a node of the outer tree, not of the file: W's `has` reads no
//   name inside it, and qstr's string is a node of the admitted file d. ATOM.text is the captured node's text in the
//   tree's source, the decoded value: an identifier's text(), an attribute's node_text() (exact source bytes for a
//   simple string, the value for an escaped or concatenated one, as W). The row is the string's (`each` keeps the
//   matched node's span), so atom_id is 'quoted:'||string start||':'||atom and start/end the string's span.

.decl spq_runtime_state_annotations_scope_kinds(kind: symbol)
spq_runtime_state_annotations_scope_kinds("class_definition"). spq_runtime_state_annotations_scope_kinds("function_definition").
.decl spq_runtime_state_annotations_typed_param_kinds(kind: symbol)
spq_runtime_state_annotations_typed_param_kinds("default_parameter"). spq_runtime_state_annotations_typed_param_kinds("typed_default_parameter"). spq_runtime_state_annotations_typed_param_kinds("typed_parameter").
.decl spq_runtime_state_annotations_doc(d: number)
.decl spq_runtime_state_annotations_in_attr(n: node)
.decl spq_runtime_state_annotations_in_type(d: number, n: node, a: node)
.decl spq_runtime_state_annotations_scope(d: number, s: node)
.decl spq_runtime_state_annotations_scope_name(d: number, s: node, name: symbol)
.decl spq_runtime_state_annotations_root(d: number, m: node)
.decl spq_runtime_state_annotations_ann0(d: number, a: node)
.decl spq_runtime_state_annotations_ann(d: number, a: node, scope: node)
.decl spq_runtime_state_annotations_annscope(d: number, s: node)
.decl spq_runtime_state_annotations_fnanc(s: node, f: node)
.decl spq_runtime_state_annotations_between(s: node, f: node, g: node)
.decl spq_runtime_state_annotations_chain(d: number, s: node, f: node, depth: number)
.decl spq_runtime_state_annotations_from_st(d: number, st: node, module: symbol)
.decl spq_runtime_state_annotations_imp_src(d: number, st: node, name: symbol, origin: symbol)
.decl spq_runtime_state_annotations_seg_s(t: symbol)
.decl spq_runtime_state_annotations_seg(t: symbol, h: symbol)
.decl spq_runtime_state_annotations_imp(d: number, scope: node, name: symbol, origin: symbol)
.decl spq_runtime_state_annotations_bound_ctx(n: node)
.decl spq_runtime_state_annotations_bound_excl(n: node)
.decl spq_runtime_state_annotations_shadow_src(d: number, n: node, name: symbol)
.decl spq_runtime_state_annotations_shadow(d: number, scope: node, name: symbol)
.decl spq_runtime_state_annotations_dotted(n: node)
.decl spq_runtime_state_annotations_atom(d: number, a: node, id: symbol, start: number, end: number, atom: symbol)
.decl spq_runtime_state_annotations_head_s(t: symbol)
.decl spq_runtime_state_annotations_head(t: symbol, h: symbol)
.decl spq_runtime_state_annotations_need(d: number, s: node, h: symbol)
.decl spq_runtime_state_annotations_imp_depth(d: number, s: node, h: symbol, k: number)
.decl spq_runtime_state_annotations_first(d: number, s: node, h: symbol, k: number)
.decl spq_runtime_state_annotations_shd_depth(d: number, s: node, h: symbol, k: number)
.decl spq_runtime_state_annotations_shadowed(d: number, s: node, h: symbol)
.decl spq_runtime_state_annotations_ai(d: number, a: node, id: symbol, origin: symbol)
.decl spq_runtime_state_annotations_ai_any(d: number, a: node, id: symbol)
.decl spq_runtime_state_annotations_trusted(d: number, a: node, id: symbol)
.decl spq_runtime_state_annotations_res(d: number, a: node, id: symbol, start: number, end: number, atom: symbol, origin: symbol)
.decl spq_runtime_state_annotations_arg(d: number, a: node, start: number, end: number, bs: number, be: number, any: number)
.decl spq_runtime_state_annotations_ign(d: number, a: node, id: symbol)
.decl spq_runtime_state_annotations_conn_trusted(d: number, a: node, id: symbol, origin: symbol)
.decl spq_runtime_state_annotations_hit(d: number, a: node)
.decl spq_runtime_state_annotations_qstr(d: number, q: node, a: node)

spq_runtime_state_annotations_doc(d) :- option_value("entryPoint", "_check_serverplan_runtime_state_ingress"), doc(d, p, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), !match("(?s:.*)(?:(?:^|/)tests(?:/|$))(?s:.*)", p), node(d, m, "module", _, _), node_text(m, ms), match("(?s:.*)(?:Callable|AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction)(?s:.*)", ms).
spq_runtime_state_annotations_doc(d) :- option_value("entryPoint", "_check_serverplan_quality_source"), doc(d, p, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), !match("(?s:.*)(?:(?:^|/)tests(?:/|$))(?s:.*)", p), node(d, m, "module", _, _), node_text(m, ms), match("(?s:.*)(?:Callable|AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction)(?s:.*)", ms).
spq_runtime_state_annotations_doc(d) :- option_value("entryPoint", "all"), option_on("oracleAnalyzer"), doc(d, p, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), !match("(?s:.*)(?:(?:^|/)tests(?:/|$))(?s:.*)", p), node(d, m, "module", _, _), node_text(m, ms), match("(?s:.*)(?:Callable|AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction)(?s:.*)", ms).
spq_runtime_state_annotations_doc(d) :- option_value("entryPoint", "all"), !option_on("oracleAnalyzer"), doc(d, p5, _), match("(?s:.*)(?:^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$|^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$))(?s:.*)", p5), !match("(?s:.*)(?:(?:^|/)__init__\\.py$)(?s:.*)", p5), doc(d, p, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), !match("(?s:.*)(?:(?:^|/)tests(?:/|$))(?s:.*)", p), node(d, m, "module", _, _), node_text(m, ms), match("(?s:.*)(?:Callable|AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction)(?s:.*)", ms).
spq_runtime_state_annotations_root(d, m) :- spq_runtime_state_annotations_doc(d), node(d, m, "module", _, _).
spq_runtime_state_annotations_in_attr(n) :- child(p, n, _), node(_, p, "attribute", _, _).
spq_runtime_state_annotations_in_type(d, n, a) :- inside(n, a, "assignment"), field(a, "type", x), node(d, x, _, xs, xe), node(d, n, _, ns, ne), xs <= ns, ne <= xe, spq_runtime_state_annotations_doc(d).
spq_runtime_state_annotations_scope(d, s) :- spq_runtime_state_annotations_doc(d), node(d, s, "function_definition", _, _).
spq_runtime_state_annotations_scope(d, s) :- spq_runtime_state_annotations_doc(d), node(d, s, "class_definition", _, _).
spq_runtime_state_annotations_scope_name(d, s, x) :- spq_runtime_state_annotations_scope(d, s), field(s, "name", c), text(c, x).
spq_runtime_state_annotations_ann0(d, a) :- spq_runtime_state_annotations_doc(d), node(d, a, "assignment", _, _), field(a, "type", _), field(a, "left", l), node(_, l, "identifier", _, _).
spq_runtime_state_annotations_ann(d, a, s) :- spq_runtime_state_annotations_ann0(d, a), nearest(a, s, spq_runtime_state_annotations_scope_kinds).
spq_runtime_state_annotations_ann(d, a, m) :- spq_runtime_state_annotations_ann0(d, a), !inside(a, _, spq_runtime_state_annotations_scope_kinds), spq_runtime_state_annotations_root(d, m).
spq_runtime_state_annotations_annscope(d, s) :- spq_runtime_state_annotations_ann(d, _, s).
spq_runtime_state_annotations_fnanc(s, f) :- spq_runtime_state_annotations_annscope(_, s), inside(s, f, "function_definition").
spq_runtime_state_annotations_between(s, f, g) :- spq_runtime_state_annotations_fnanc(s, f), spq_runtime_state_annotations_fnanc(s, g), inside(g, f, "function_definition").
spq_runtime_state_annotations_chain(d, s, s, 0) :- spq_runtime_state_annotations_annscope(d, s).
spq_runtime_state_annotations_chain(d, s, f, k + 1) :- spq_runtime_state_annotations_annscope(d, s), spq_runtime_state_annotations_fnanc(s, f), k = count : { spq_runtime_state_annotations_between(s, f, _) }.
spq_runtime_state_annotations_chain(d, s, m, k + 1) :- spq_runtime_state_annotations_annscope(d, s), spq_runtime_state_annotations_root(d, m), s != m, k = count : { spq_runtime_state_annotations_fnanc(s, _) }.
spq_runtime_state_annotations_from_st(d, st, x) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_from_statement", _, _), field(st, "module_name", mn), node(_, mn, "dotted_name", _, _), text(mn, x).
spq_runtime_state_annotations_from_st(d, st, x) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_from_statement", _, _), field(st, "module_name", mn), node(_, mn, k, _, _), k != "dotted_name", node_text(mn, x).
spq_runtime_state_annotations_imp_src(d, st, x, cat(cat(mo, "."), x)) :- spq_runtime_state_annotations_from_st(d, st, mo), child(st, c, _), !field(st, "module_name", c), node(_, c, "dotted_name", _, _), text(c, x).
spq_runtime_state_annotations_imp_src(d, st, al, cat(cat(mo, "."), x)) :- spq_runtime_state_annotations_from_st(d, st, mo), child(st, c, _), !field(st, "module_name", c), node(_, c, "aliased_import", _, _), field(c, "name", nm), text(nm, x), field(c, "alias", an), text(an, al).
spq_runtime_state_annotations_seg_s(x) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_statement", _, _), child(st, c, _), node(_, c, "dotted_name", _, _), node_text(c, x).
spq_runtime_state_annotations_seg(x, h) :- spq_runtime_state_annotations_seg_s(x), match("[^.](?s:.*)", x), h = @rx_replace(x, "^([^.]+)(?s:.*)$", "$1").
spq_runtime_state_annotations_imp_src(d, st, h, h) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_statement", _, _), child(st, c, _), node(_, c, "dotted_name", _, _), node_text(c, x), spq_runtime_state_annotations_seg(x, h).
spq_runtime_state_annotations_imp_src(d, st, al, x) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_statement", _, _), child(st, c, _), node(_, c, "aliased_import", _, _), field(c, "name", nm), text(nm, x), field(c, "alias", an), text(an, al).
spq_runtime_state_annotations_imp(d, s, x, o) :- spq_runtime_state_annotations_imp_src(d, st, x, o), nearest(st, s, spq_runtime_state_annotations_scope_kinds).
spq_runtime_state_annotations_imp(d, m, x, o) :- spq_runtime_state_annotations_imp_src(d, st, x, o), !inside(st, _, spq_runtime_state_annotations_scope_kinds), spq_runtime_state_annotations_root(d, m).
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, "assignment"), field(a, "left", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, "augmented_assignment"), field(a, "left", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, "for_statement"), field(a, "left", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, "for_in_clause"), field(a, "left", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, "named_expression"), field(a, "name", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(_, n, "identifier", _, _), inside(n, _, "delete_statement").
spq_runtime_state_annotations_bound_excl(n) :- field(p, "name", n), node(_, p, "function_definition", _, _).
spq_runtime_state_annotations_bound_excl(n) :- field(p, "name", n), node(_, p, "class_definition", _, _).
spq_runtime_state_annotations_bound_excl(n) :- field(p, "name", n), node(_, p, "keyword_argument", _, _).
spq_runtime_state_annotations_bound_excl(n) :- field(p, "attribute", n), node(_, p, "attribute", _, _).
spq_runtime_state_annotations_shadow_src(d, n, x) :- spq_runtime_state_annotations_doc(d), node(d, n, "identifier", _, _), spq_runtime_state_annotations_bound_ctx(n), !spq_runtime_state_annotations_bound_excl(n), text(n, x).
spq_runtime_state_annotations_shadow(d, s, x) :- spq_runtime_state_annotations_shadow_src(d, n, x), nearest(n, s, spq_runtime_state_annotations_scope_kinds).
spq_runtime_state_annotations_shadow(d, m, x) :- spq_runtime_state_annotations_shadow_src(d, n, x), !inside(n, _, spq_runtime_state_annotations_scope_kinds), spq_runtime_state_annotations_root(d, m).
spq_runtime_state_annotations_shadow(d, f, x) :- spq_runtime_state_annotations_doc(d), node(d, n, "identifier", _, _), child(pr, n, _), node(_, pr, "parameters", _, _), child(f, pr, _), node(_, f, "function_definition", _, _), text(n, x).
spq_runtime_state_annotations_shadow(d, f, x) :- spq_runtime_state_annotations_doc(d), node(d, n, "identifier", _, _), child(tp, n, 0), node(_, tp, k, _, _), spq_runtime_state_annotations_typed_param_kinds(k), child(pr, tp, _), node(_, pr, "parameters", _, _), child(f, pr, _), node(_, f, "function_definition", _, _), text(n, x).
spq_runtime_state_annotations_shadow(d, m, x) :- spq_runtime_state_annotations_scope_name(d, _, x), spq_runtime_state_annotations_root(d, m).
spq_runtime_state_annotations_shadow(d, m, x) :- spq_runtime_state_annotations_root(d, m), node(d, n, "identifier", _, _), child(g, n, _), node(_, g, "global_statement", _, _), text(n, x).
spq_runtime_state_annotations_shadow(d, f, x) :- spq_runtime_state_annotations_doc(d), node(d, n, "identifier", _, _), child(g, n, _), node(_, g, "nonlocal_statement", _, _), text(n, x), inside(n, f, "function_definition").
spq_runtime_state_annotations_atom(d, a, cat("name:", to_string(ns)), ns, ne, x) :- node(d, n, "identifier", ns, ne), !spq_runtime_state_annotations_in_attr(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), text(n, x).
spq_runtime_state_annotations_dotted(n) :- node(_, n, "attribute", _, _), node_text(n, s), match("[A-Za-z_]\\w*(?:\\s*\\.\\s*[A-Za-z_]\\w*)*", s).
spq_runtime_state_annotations_atom(d, a, cat(cat(cat("member:", to_string(ns)), ":"), to_string(ne)), ns, ne, v) :- node(d, n, "attribute", ns, ne), !spq_runtime_state_annotations_in_attr(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), spq_runtime_state_annotations_dotted(n), node_text(n, t), v = @rx_replace(t, "\\s+", "").
spq_runtime_state_annotations_atom(d, a, cat(cat(cat("member:", to_string(ns)), ":"), to_string(ne)), ns, ne, x) :- node(d, n, "attribute", ns, ne), !spq_runtime_state_annotations_in_attr(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), !spq_runtime_state_annotations_dotted(n), field(n, "attribute", c), text(c, x).
spq_runtime_state_annotations_atom(d, a, cat(cat(cat("member:", to_string(ns)), ":"), to_string(ne)), ns, ne, v) :- node(d, n, "attribute", ns, ne), !spq_runtime_state_annotations_dotted(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), spq_runtime_state_annotations_dotted(n), node_text(n, t), v = @rx_replace(t, "\\s+", "").
spq_runtime_state_annotations_atom(d, a, cat(cat(cat("member:", to_string(ns)), ":"), to_string(ne)), ns, ne, x) :- node(d, n, "attribute", ns, ne), !spq_runtime_state_annotations_dotted(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), !spq_runtime_state_annotations_dotted(n), field(n, "attribute", c), text(c, x).
spq_runtime_state_annotations_qstr(d, s, a) :- node(d, s, "string", _, _), spq_runtime_state_annotations_in_type(d, s, a), spq_runtime_state_annotations_ann0(d, a).
spq_runtime_state_annotations_qstr(d, s, a) :- node(d, s, "concatenated_string", _, _), spq_runtime_state_annotations_in_type(d, s, a), spq_runtime_state_annotations_ann0(d, a).
spq_runtime_state_annotations_atom(d, a, cat(cat(cat("quoted:", to_string(ss)), ":"), x), ss, se, x) :- spq_runtime_state_annotations_qstr(d, s, a), node(d, s, _, ss, se), parsed(s, "annotation", r), inside(n, r, "expression_statement"), node(_, n, "identifier", _, _), !spq_runtime_state_annotations_in_attr(n), text(n, x).
spq_runtime_state_annotations_atom(d, a, cat(cat(cat("quoted:", to_string(ss)), ":"), x), ss, se, x) :- spq_runtime_state_annotations_qstr(d, s, a), node(d, s, _, ss, se), parsed(s, "annotation", r), inside(n, r, "expression_statement"), node(_, n, "attribute", _, _), !spq_runtime_state_annotations_in_attr(n), node_text(n, x).
spq_runtime_state_annotations_head_s(x) :- spq_runtime_state_annotations_atom(_, _, _, _, _, x).
spq_runtime_state_annotations_head(x, h) :- spq_runtime_state_annotations_head_s(x), match("[A-Za-z_](?s:.*)", x), h = @rx_replace(x, "^([A-Za-z_]\\w*)(?s:.*)$", "$1").
spq_runtime_state_annotations_need(d, s, h) :- spq_runtime_state_annotations_atom(d, a, _, _, _, x), spq_runtime_state_annotations_ann(d, a, s), spq_runtime_state_annotations_head(x, h).
spq_runtime_state_annotations_imp_depth(d, s, h, k) :- spq_runtime_state_annotations_need(d, s, h), spq_runtime_state_annotations_chain(d, s, f, k), spq_runtime_state_annotations_imp(d, f, h, _).
spq_runtime_state_annotations_first(d, s, h, k) :- spq_runtime_state_annotations_need(d, s, h), k = min j : { spq_runtime_state_annotations_imp_depth(d, s, h, j) }.
spq_runtime_state_annotations_shd_depth(d, s, h, j) :- spq_runtime_state_annotations_need(d, s, h), spq_runtime_state_annotations_chain(d, s, f, j), spq_runtime_state_annotations_shadow(d, f, h).
spq_runtime_state_annotations_shadowed(d, s, h) :- spq_runtime_state_annotations_first(d, s, h, k), spq_runtime_state_annotations_shd_depth(d, s, h, j), j <= k.
spq_runtime_state_annotations_ai(d, a, id, o) :- spq_runtime_state_annotations_atom(d, a, id, _, _, x), spq_runtime_state_annotations_ann(d, a, s), spq_runtime_state_annotations_head(x, h), spq_runtime_state_annotations_first(d, s, h, k), spq_runtime_state_annotations_chain(d, s, f, k), spq_runtime_state_annotations_imp(d, f, h, o).
spq_runtime_state_annotations_ai_any(d, a, id) :- spq_runtime_state_annotations_ai(d, a, id, _).
spq_runtime_state_annotations_trusted(d, a, id) :- spq_runtime_state_annotations_ai_any(d, a, id), spq_runtime_state_annotations_atom(d, a, id, _, _, x), spq_runtime_state_annotations_ann(d, a, s), spq_runtime_state_annotations_head(x, h), !spq_runtime_state_annotations_shadowed(d, s, h), c = count : { spq_runtime_state_annotations_ai(d, a, id, _) }, c = 1.
spq_runtime_state_annotations_res(d, a, id, xs, xe, x, cat(o, substr(x, strlen(h), strlen(x) - strlen(h)))) :- spq_runtime_state_annotations_atom(d, a, id, xs, xe, x), spq_runtime_state_annotations_ai(d, a, id, o), spq_runtime_state_annotations_head(x, h).
spq_runtime_state_annotations_res(d, a, id, xs, xe, x, x) :- spq_runtime_state_annotations_atom(d, a, id, xs, xe, x), !spq_runtime_state_annotations_ai_any(d, a, id).
spq_runtime_state_annotations_arg(d, a, xs, xe, bs, be, 1) :- node(d, tp, "type_parameter", _, _), child(g, tp, _), node(_, g, "generic_type", _, _), child(g, b, 0), node(d, b, _, bs, be), spq_runtime_state_annotations_in_type(d, tp, a), spq_runtime_state_annotations_ann0(d, a), child(tp, x, i), node(d, x, _, xs, xe).
spq_runtime_state_annotations_arg(d, a, xs, xe, bs, be, 0) :- node(d, tp, "type_parameter", _, _), child(g, tp, _), node(_, g, "generic_type", _, _), child(g, b, 0), node(d, b, _, bs, be), spq_runtime_state_annotations_in_type(d, tp, a), spq_runtime_state_annotations_ann0(d, a), child(tp, x, i), node(d, x, _, xs, xe), i >= 1.
spq_runtime_state_annotations_arg(d, a, xs, xe, bs, be, 0) :- node(d, tp, "type_parameter", _, _), child(g, tp, _), node(_, g, "generic_type", _, _), child(g, b, 0), node(d, b, _, bs, be), spq_runtime_state_annotations_in_type(d, tp, a), spq_runtime_state_annotations_ann0(d, a), child(tp, x, 0), node(d, x, _, xs, xe), token(tp, _, t, st, _), substr(t, 0, 1) = "#", st < xs.
spq_runtime_state_annotations_ign(d, a, id) :- spq_runtime_state_annotations_res(d, a, id, xs, xe, _, _), spq_runtime_state_annotations_arg(d, a, gs, ge, bs, be, 1), xs >= gs, xe <= ge, spq_runtime_state_annotations_res(d, a, bid, bs, be, _, "typing.Literal"), spq_runtime_state_annotations_trusted(d, a, bid).
spq_runtime_state_annotations_ign(d, a, id) :- spq_runtime_state_annotations_res(d, a, id, xs, xe, _, _), spq_runtime_state_annotations_arg(d, a, gs, ge, bs, be, 1), xs >= gs, xe <= ge, spq_runtime_state_annotations_res(d, a, bid, bs, be, _, "typing_extensions.Literal"), spq_runtime_state_annotations_trusted(d, a, bid).
spq_runtime_state_annotations_ign(d, a, id) :- spq_runtime_state_annotations_res(d, a, id, xs, xe, _, _), spq_runtime_state_annotations_arg(d, a, gs, ge, bs, be, 0), xs >= gs, xe <= ge, spq_runtime_state_annotations_res(d, a, bid, bs, be, _, "typing.Annotated"), spq_runtime_state_annotations_trusted(d, a, bid).
spq_runtime_state_annotations_ign(d, a, id) :- spq_runtime_state_annotations_res(d, a, id, xs, xe, _, _), spq_runtime_state_annotations_arg(d, a, gs, ge, bs, be, 0), xs >= gs, xe <= ge, spq_runtime_state_annotations_res(d, a, bid, bs, be, _, "typing_extensions.Annotated"), spq_runtime_state_annotations_trusted(d, a, bid).
spq_runtime_state_annotations_conn_trusted(d, a, id, "data_layer.types.ConnectionId") :- spq_runtime_state_annotations_res(d, a, id, _, _, _, "data_layer.types.ConnectionId"), spq_runtime_state_annotations_trusted(d, a, id).
spq_runtime_state_annotations_conn_trusted(d, a, id, "l1350_foundational_types.ConnectionId") :- spq_runtime_state_annotations_res(d, a, id, _, _, _, "l1350_foundational_types.ConnectionId"), spq_runtime_state_annotations_trusted(d, a, id).
spq_runtime_state_annotations_conn_trusted(d, a, id, "l1400_types.ConnectionId") :- spq_runtime_state_annotations_res(d, a, id, _, _, _, "l1400_types.ConnectionId"), spq_runtime_state_annotations_trusted(d, a, id).
spq_runtime_state_annotations_hit(d, a) :- spq_runtime_state_annotations_res(d, a, id, _, _, _, o), match("(?s:.*)(?:(?:^|\\.)Callable(?:\\.|$))(?s:.*)", o), !spq_runtime_state_annotations_ign(d, a, id).
spq_runtime_state_annotations_hit(d, a) :- spq_runtime_state_annotations_res(d, a, id, _, _, _, o), !spq_runtime_state_annotations_conn_trusted(d, a, id, o), match("(?s:.*)(?:AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction)(?s:.*)", o), !spq_runtime_state_annotations_ign(d, a, id).
violation("data-layer-serverplan-quality", "spq-runtime-state-annotations", "SPQ-050", p, l) :- spq_runtime_state_annotations_hit(d, a), doc(d, p, _), line(a, l).

// ---- strategy-file-size (forbid regex over file.content, SPQ-010), option-gated ----
// The forbid is an `$option` on entryPoint: the regex for "all" and "_check_serverplan_quality_source", else
// (?<OVERFLOW>\b\B), which never matches.
// The regex is W's, over the whole file (source): its OVERFLOW group, the anchor (capture.OVERFLOW), is a span whose
// line is W's finding's, as the tape numbers lines (match_group; U+2028/U+2029 written \x{2028}/\x{2029}, the same
// class). It matches where a 1501st line starts as Python's str.splitlines counts them. `paths`:
// impl/common/l2070_server_plan/strategies/**/*.py. No `syntax: valid`: a document that does not parse is still read
// (no syntax_error test). Exact.
violation("data-layer-serverplan-quality", "strategy-file-size", "SPQ-010", p, l) :- doc(d, p, _), in_scope(d), !out_scope(d),
    strategy_file_size_entry(e), option_value("entryPoint", e),
    glob("impl/common/l2070_server_plan/strategies/**/*.py", p), source(d, sp),
    match_group("\\A(?:[^\\n\\r\\v\\f\\x1c-\\x1e\\x85\\x{2028}\\x{2029}]*(?:\\r\\n|[\\n\\r\\v\\f\\x1c-\\x1e\\x85\\x{2028}\\x{2029}])){1500}(?<OVERFLOW>[^\\n\\r\\v\\f\\x1c-\\x1e\\x85\\x{2028}\\x{2029}]+|[\\n\\r\\v\\f\\x1c-\\x1e\\x85\\x{2028}\\x{2029}])", sp, _, "OVERFLOW", g),
    line(g, l).
.decl strategy_file_size_entry(e: symbol)
strategy_file_size_entry("all"). strategy_file_size_entry("_check_serverplan_quality_source").

// ---- quality-local-taxonomy (relational, SPQ-049: recursive payload taxonomy duplication) ----
// Input `candidates` (relation quality_local_taxonomy_candidates(d, n), one row per matched function_definition n of document d):
// a def whose body
//   - calls itself at least twice (quality_local_taxonomy_self_call; W's count over has stopBy end, the call's function an
//     identifier or an attribute's `attribute` whose source text equals the def's name: compare text source);
//   - has at least three if/elif whose condition is, or contains, a type-dispatch test (quality_local_taxonomy_dispatch, count min 3);
//   - has a string or concatenated string reading "unsupported ... shape" (quality_local_taxonomy_shape_message: W's value regex or
//     its pythonFString parse's literal parts, below);
//   - has `raise TypeError(...)`;
//   - has one of the six state-walk pairings (quality_local_taxonomy_walk_* / the translator's helpers), one of which is a
//     non-async for loop holding a self call (quality_local_taxonomy_self_loop);
// in a document outside tests/ and inside the clause's file scope, option-gated: the entryPoint / oracleAnalyzer cases of the policy's `$option` nodes are alternatives gated on option_value / option_on.
// Query: candidates whose file has >= 2 candidate rows (partitionBy file): quality_local_taxonomy_rows(d, k), the per-document count.
// The key (issue, identity = start byte) is hashed with the finding id (path included): no rows merge across files.
//
// value + pythonFString parse (quality_local_taxonomy_shape_message), the host a string or concatenated_string
//   (quality_local_taxonomy_part): W's `value` regex is value(h, v) of type str (decoded, parts joined; unknown with
//   an interpolation; a bytes or t-string part has no str value); its `parse: {grammar: pythonFString, has: {kind:
//   literal, regex}}` is fstring_piece(h, _, "literal", v) (the root's literal children, decoded, a debug field's
//   `x = ` in them; no rows where W gets no tree). Exact.
// not async (^async on the for statement's text): node_text, exact.
// Uses node_text (header-declared).
.decl quality_local_taxonomy_any_kind(kind: symbol)
quality_local_taxonomy_any_kind("aliased_import"). quality_local_taxonomy_any_kind("argument_list"). quality_local_taxonomy_any_kind("as_pattern"). quality_local_taxonomy_any_kind("as_pattern_target"). quality_local_taxonomy_any_kind("assert_statement"). quality_local_taxonomy_any_kind("assignment"). quality_local_taxonomy_any_kind("attribute"). quality_local_taxonomy_any_kind("augmented_assignment"). quality_local_taxonomy_any_kind("await"). quality_local_taxonomy_any_kind("binary_operator"). quality_local_taxonomy_any_kind("block"). quality_local_taxonomy_any_kind("boolean_operator"). quality_local_taxonomy_any_kind("break_statement"). quality_local_taxonomy_any_kind("call"). quality_local_taxonomy_any_kind("case_clause"). quality_local_taxonomy_any_kind("case_pattern"). quality_local_taxonomy_any_kind("chevron"). quality_local_taxonomy_any_kind("class_definition"). quality_local_taxonomy_any_kind("class_pattern"). quality_local_taxonomy_any_kind("comparison_operator"). quality_local_taxonomy_any_kind("complex_pattern"). quality_local_taxonomy_any_kind("concatenated_string"). quality_local_taxonomy_any_kind("conditional_expression"). quality_local_taxonomy_any_kind("constrained_type"). quality_local_taxonomy_any_kind("continue_statement"). quality_local_taxonomy_any_kind("decorated_definition"). quality_local_taxonomy_any_kind("decorator"). quality_local_taxonomy_any_kind("default_parameter"). quality_local_taxonomy_any_kind("delete_statement"). quality_local_taxonomy_any_kind("dict_pattern"). quality_local_taxonomy_any_kind("dictionary"). quality_local_taxonomy_any_kind("dictionary_comprehension"). quality_local_taxonomy_any_kind("dictionary_splat"). quality_local_taxonomy_any_kind("dictionary_splat_pattern"). quality_local_taxonomy_any_kind("dotted_name"). quality_local_taxonomy_any_kind("elif_clause"). quality_local_taxonomy_any_kind("ellipsis"). quality_local_taxonomy_any_kind("else_clause"). quality_local_taxonomy_any_kind("escape_interpolation"). quality_loc