.decl spq_vector_filter_constants_fn(d: number, n: node, nm: symbol)
.decl spq_vector_filter_constants_ms(d: number, s: node, nm: symbol, v: symbol)
.decl spq_vector_filter_constants_last(d: number, s: node, nm: symbol, v: symbol)
.decl spq_vector_filter_constants_scope_value(v: symbol)
.decl spq_vector_filter_constants_admitted(d: number)
spq_vector_filter_constants_fn(d, n, nm) :- spq_vector_filter_constants_filter_names(n), node(d, n, _, _, _), text(n, nm).
// NAME: the left identifier; DECODED: the right-hand string's value.
spq_vector_filter_constants_ms(d, s, nm, v) :- spq_vector_filter_constants_module_strings(s), node(d, s, _, _, _), field(s, "left", x), text(x, nm), field(s, "right", r), value(r, v).
// module_string_values: the last assignment per name.
spq_vector_filter_constants_last(d, s, nm, v) :- spq_vector_filter_constants_ms(d, s, nm, v), node(d, s, _, b, _), b = max b2 : { spq_vector_filter_constants_module_strings(o), node(d, o, _, b2, _), field(o, "left", x2), text(x2, nm) }.
spq_vector_filter_constants_scope_value("branch_id").
spq_vector_filter_constants_scope_value("revision_id").
spq_vector_filter_constants_admitted(d) :- spq_vector_filter_constants_admission(n), node(d, n, _, _, _).
violation("data-layer-serverplan-quality", "spq-vector-filter-constants", "SPQ-042", p, l) :- spq_vector_filter_constants_fn(d, n, nm), spq_vector_filter_constants_last(d, _, nm, v), spq_vector_filter_constants_scope_value(v), spq_vector_filter_constants_admitted(d), doc(d, p, _), line(n, l).

// ---- spq-projection-repairs (SPQ-043) [option-gated] ----
// A function that calls .execute/.execute_async/.resolve/.resolve_async (executing_fns) and, inside a for loop or a
// comprehension's for clause, passes a loop variable to dict(...) or calls .dict()/.model_dump() on it (repaired).
// Generated by /tmp/w03/gen_spq-projection-repairs.py from the clause JSON (inputs through tr.py, projections by hand).
// Inputs: spq_projection_repairs_<input>(n) are the nodes each input's rule + file block match (tr.py), in in-scope parsing documents.
//   Projections: capture.NAME of an identifier row is the row node itself (text(n)); executing_fns' NAME is unused.
//   capture.FN / capture.LOOP / capture.CALL are rebuilt from the tree: spq_projection_repairs_fn_of, _stmt_loop, _comp_clause, _refs.
// Stages: loop_names = spq_projection_repairs_loop_names (loop spans as numbers), repaired = spq_projection_repairs_repaired (fn as the node);
//   the query = the violation rule; key (issue, identity=start) collapses to the node; line = the fn's start line.
// partitionBy file / requireNonemptyInput admission: spq_projection_repairs_admitted(d), per document [INFERENCE: per-file admission].
// Exactness notes:
// - dict_refs / dump_refs bind CALL to the nearest qualifying call; here every enclosing qualifying call gives a row.
//   The nearest call lies inside every other (nested arguments / nested receivers), so EXISTS(call within loop) in
//   `repaired` is the same: exact.
// - for_statement / for_in_clause entered through `left`: at most one per identifier (left is a pattern), so LOOP is
//   unique; `left` containment is by byte span, as W's walk entering through the field.
// - At entryPoint "all" / "_check_serverplan_quality_source" every input's matcher also needs the node `inside` a
//   module with the regexes; the admission row is itself a module, which has no module ancestor, so admission is empty
//   and the clause reports nothing at those entry points (W's semantics, kept).
// Reads node_text (the module-text regexes of the `inside module` tests).
.decl spq_projection_repairs_any_kind(kind: symbol)
