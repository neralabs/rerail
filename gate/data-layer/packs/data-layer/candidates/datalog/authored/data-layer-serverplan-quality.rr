violation("data-layer-serverplan-quality", "spq-statement-batch-rowcounts", "SPQ-046", p, l) :- node(_, n, "call", _, _), field(n, "function", c1), spq_statement_batch_rowcounts_5(c1), !spq_statement_batch_rowcounts_10(n), field(n, "arguments", c11), child(c11, c12, _), node(_, c12, "keyword_argument", _, _), field(c12, "name", c13), node(_, c13, "identifier", _, _), text(c13, s14), match("(?s:.*)(?:^(?:collect_results_per_stmt)$)(?s:.*)", s14), field(c12, "value", c15), spq_statement_batch_rowcounts_16(c15), child(c15, c17, _), node(_, c17, "true", _, _), field(n, "arguments", c18), child(c18, c19, _), node(_, c19, "keyword_argument", _, _), field(c19, "name", c20), node(_, c20, "identifier", _, _), text(c20, s21), match("(?s:.*)(?:^(?:needs_returning_per_stmt)$)(?s:.*)", s21), field(c19, "value", c22), spq_statement_batch_rowcounts_16(c22), !spq_statement_batch_rowcounts_27(c22), node(d35, n, _, _, _), spq_statement_batch_rowcounts_file34(d35), doc(d, p, _), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), line(n, l).

