spq_ordered_semantic_inventory_limited(p, c, f) :- spq_ordered_semantic_inventory_limit(p, c, f, _).
spq_ordered_semantic_inventory_admitted(d) :- spq_ordered_semantic_inventory_admission(n), node(d, n, _, _, _).
// scope rows: NAME is the definition's name field (an identifier).
spq_ordered_semantic_inventory_sc(d, n, b, e, nm) :- spq_ordered_semantic_inventory_scope_classes(n), node(d, n, _, b, e), field(n, "name", x), text(x, nm).
spq_ordered_semantic_inventory_sf(d, n, b, e, nm) :- spq_ordered_semantic_inventory_scope_fns(n), node(d, n, _, b, e), field(n, "name", x), text(x, nm).
// The coalesce((SELECT s.name ... s.__start<=n.__start AND s.__end>=n.__end ORDER BY size LIMIT 1),'<module>').
spq_ordered_semantic_inventory_cls_in(n, c, z) :- spq_ordered_semantic_inventory_ordered(n), node(d, n, _, b, e), spq_ordered_semantic_inventory_sc(d, c, b2, e2, _), b2 <= b, e2 >= e, z = e2 - b2.
spq_ordered_semantic_inventory_fn_in(n, c, z) :- spq_ordered_semantic_inventory_ordered(n), node(d, n, _, b, e), spq_ordered_semantic_inventory_sf(d, c, b2, e2, _), b2 <= b, e2 >= e, z = e2 - b2.
spq_ordered_semantic_inventory_cls_of(n, nm) :- spq_ordered_semantic_inventory_cls_in(n, c, z), z = min y : { spq_ordered_semantic_inventory_cls_in(n, _, y) }, spq_ordered_semantic_inventory_sc(_, c, _, _, nm).
spq_ordered_semantic_inventory_fn_of(n, nm) :- spq_ordered_semantic_inventory_fn_in(n, c, z), z = min y : { spq_ordered_semantic_inventory_fn_in(n, _, y) }, spq_ordered_semantic_inventory_sf(_, c, _, _, nm).
spq_ordered_semantic_inventory_has_cls(n) :- spq_ordered_semantic_inventory_cls_in(n, _, _).
spq_ordered_semantic_inventory_has_fn(n) :- spq_ordered_semantic_inventory_fn_in(n, _, _).
spq_ordered_semantic_inventory_class_name(n, nm) :- spq_ordered_semantic_inventory_cls_of(n, nm).
spq_ordered_semantic_inventory_class_name(n, "<module>") :- spq_ordered_semantic_inventory_ordered(n), !spq_ordered_semantic_inventory_has_cls(n).
spq_ordered_semantic_inventory_function_name(n, nm) :- spq_ordered_semantic_inventory_fn_of(n, nm).
spq_ordered_semantic_inventory_function_name(n, "<module>") :- spq_ordered_semantic_inventory_ordered(n), !spq_ordered_semantic_inventory_has_fn(n).
spq_ordered_semantic_inventory_row(d, n, b, e, c, f) :- spq_ordered_semantic_inventory_ordered(n), node(d, n, _, b, e), spq_ordered_semantic_inventory_class_name(n, c), spq_ordered_semantic_inventory_function_name(n, f).
// ordered_occurrences: row_number() over (path, class_name, function_name) ORDER BY __start, __end DESC.
spq_ordered_semantic_inventory_before(n, m) :- spq_ordered_semantic_inventory_row(d, n, b, _, c, f), spq_ordered_semantic_inventory_row(d, m, b2, _, c, f), b2 < b.
spq_ordered_semantic_inventory_before(n, m) :- spq_ordered_semantic_inventory_row(d, n, b, e, c, f), spq_ordered_semantic_inventory_row(d, m, b, e2, c, f), e2 > e.
spq_ordered_semantic_inventory_occ(d, n, c, f, k) :- spq_ordered_semantic_inventory_row(d, n, _, _, c, f), j = count : { spq_ordered_semantic_inventory_before(n, _) }, k = j + 1.
// The query: occurrence > coalesce(maximum, 0).
spq_ordered_semantic_inventory_hit(d, n) :- spq_ordered_semantic_inventory_occ(d, n, c, f, k), doc(d, p, _), spq_ordered_semantic_inventory_limit(p, c, f, mx), k > mx.
spq_ordered_semantic_inventory_hit(d, n) :- spq_ordered_semantic_inventory_occ(d, n, c, f, _), doc(d, p, _), !spq_ordered_semantic_inventory_limited(p, c, f).
violation("data-layer-serverplan-quality", "spq-ordered-semantic-inventory", "SPQ-053", p, l) :- spq_ordered_semantic_inventory_hit(d, n), spq_ordered_semantic_inventory_admitted(d), doc(d, p, _), line(n, l).

// ---- spq-sync-async-duplication (SPQ-001): an `X_async` function that duplicates its sync twin `X` -------------------------
// Relational clause, partitionBy file. Inputs (W matchers, translated by tr.py, `syntax: valid`, in scope):
//   spq_sync_async_duplication_pair_methods(n)       pair_methods: a function_definition directly in a class body (block, or
//                             decorated_definition in it); row (__path, __start, name = NAME, cls = CLS.startByte)
//                             is spq_sync_async_duplication_pm(d, n, cls, name): cls the class_definition node (a class's start byte names
//                             it within its file: two class_definitions never share a start byte);
//   spq_sync_async_duplication_pair_functions(n)     pair_functions: a module-level function_definition (bare or decorated); row
//                             spq_sync_async_duplication_pf(d, n, name);
//   spq_sync_async_duplication_long_functions(n)     long_functions: a body with a 4th statement that is neither a comment nor a literal
//                             expression statement (nthChild 4 ofRule, exact: ofRule leaves comments out);
//   spq_sync_async_duplication_abstract_functions(n) abstract_functions: `@abstractmethod` / `@x.abstractmethod`, or a body whose 1st
//                             real statement is `pass` and that has no 2nd;
//   spq_sync_async_duplication_admission(n)          admission: the module, when its text matches `_async` (requireNonemptyInput: per
//                             file, spq_sync_async_duplication_admitted(d)).
// Stages: last_methods = spq_sync_async_duplication_last_m (the max __start pair_methods row per (path, cls, name)); last_functions =
// spq_sync_async_duplication_last_f (per (path, name)). Query, two UNION ALL parts = the two spq_sync_async_duplication_hit rules groups: n named
// `<sync>_async` (name = cat(sync.name, "_async"), SQL's substr(name,-6)='_async' and sync.name = the prefix),
// joined to the last same-scope twin; methods: neither n nor the twin abstract, and n or the twin long;
// functions: n or the twin long (no abstract test). `f.__start IN (n.__start, sync.__start)` within the file is
// node identity (two function_definitions never share a start byte). Key (issue, identity = n.__start): one
// finding per n, at n's line.
// Exact (the inputs are their matchers rule for rule). Reads node_text (the module `regex` gate `_async` and the
// decorator regex `(?:^|\.)abstractmethod$` on identifier/attribute, W's whole node text).
// Option-gated: the inputs' `file` blocks read entryPoint / oracleAnalyzer (option_value, option_on).
