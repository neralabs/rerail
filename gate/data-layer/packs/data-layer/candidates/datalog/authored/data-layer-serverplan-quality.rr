conditional_architecture_229(n) :- inside(c226, n, conditional_architecture_any_kind), node(_, c226, "attribute", _, _), field(c226, "attribute", c227), node(_, c227, "identifier", _, _), text(c227, s228), match("(?s:.*)(?:^(?:backend_type|is_sql_backend)$)(?s:.*)", s228).
conditional_architecture_236(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c231), node(_, c231, "identifier", _, _), text(c231, s232), match("(?s:.*)(?:^(?:backend_type|is_sql_backend)$)(?s:.*)", s232).
conditional_architecture_236(n) :- inside(c233, n, conditional_architecture_any_kind), node(_, c233, "attribute", _, _), field(c233, "attribute", c234), node(_, c234, "identifier", _, _), text(c234, s235), match("(?s:.*)(?:^(?:backend_type|is_sql_backend)$)(?s:.*)", s235).
conditional_architecture_245(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c240), node(_, c240, "identifier", _, _), text(c240, s241), match("(?s:.*)(?:^(?:backend_type|is_sql_backend)$)(?s:.*)", s241).
conditional_architecture_245(n) :- inside(c242, n, conditional_architecture_any_kind), node(_, c242, "attribute", _, _), field(c242, "attribute", c243), node(_, c243, "identifier", _, _), text(c243, s244), match("(?s:.*)(?:^(?:backend_type|is_sql_backend)$)(?s:.*)", s244).
conditional_architecture_246(n) :- conditional_architecture_222(n), field(n, "condition", c223), conditional_architecture_229(c223).
conditional_architecture_246(n) :- node(_, n, "match_statement", _, _), field(n, "subject", c230), conditional_architecture_236(c230).
// controls' `has: {nthChild: 2}` at a conditional expression: its W-second named tape child. Its first is the value
// (where the expression starts), so it is child() index 1 with no comment token between the two (_cx_shift); a
// comment there is W's second and fails the rule (no attribute in it).
conditional_architecture_246(n) :- node(_, n, "conditional_expression", _, _), child(n, c237, 1), !conditional_architecture_cx_shift(n), conditional_architecture_245(c237).
.decl conditional_architecture_cx_shift(n: node)
conditional_architecture_cx_shift(n) :- node(_, n, "conditional_expression", _, _), token(n, _, t, st, _), substr(t, 0, 1) = "#", child(n, c, 1), node(_, c, _, s, _), st < s.
conditional_architecture_controls(n) :- node(d221, n, _, _, _), conditional_architecture_file6(d221), conditional_architecture_246(n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
conditional_architecture_253(n) :- node(_, n, "raise_statement", _, _).
conditional_architecture_253(n) :- node(_, n, "return_statement", _, _).
conditional_architecture_253(n) :- node(_, n, "if_statement", _, _).
conditional_architecture_253(n) :- node(_, n, "match_statement", _, _).
conditional_architecture_255(n) :- node(_, n, "block", _, _).
conditional_architecture_255(n) :- node(_, n, "elif_clause", _, _).
conditional_architecture_255(n) :- node(_, n, "else_clause", _, _).
conditional_architecture_255(n) :- node(_, n, "case_clause", _, _).
conditional_architecture_255(n) :- conditional_architecture_253(n), child(c254, n, _), node(_, c254, "block", _, _).
conditional_architecture_vnodes(n) :- node(d252, n, _, _, _), conditional_architecture_file6(d252), conditional_architecture_255(n), inside(n, c256, conditional_architecture_kinds0), node(_, c256, "function_definition", _, _), field(c256, "name", c257), node(_, c257, "identifier", _, _), text(c257, s258), match("(?s:.*)(?:^(?:require_sql_physical_conditional)$)(?s:.*)", s258), child(c259, n, _), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
conditional_architecture_263(n) :- field(c262, "attribute", n), node(_, c262, "attribute", _, _).
conditional_architecture_265(n) :- field(c264, "name", n), conditional_architecture_146(c264).
conditional_architecture_267(n) :- child(c266, n, _), conditional_architecture_149(c266).
conditional_architecture_271(n) :- field(c270, "attribute", n), node(_, c270, "attribute", _, _).
conditional_architecture_273(n) :- field(c272, "name", n), conditional_architecture_146(c272).
conditional_architecture_275(n) :- child(c274, n, _), conditional_architecture_149(c274).
conditional_architecture_276(n) :- node(_, n, "identifier", _, _), text(n, s261), match("(?s:.*)(?:^Callable$)(?s:.*)", s261), !conditional_architecture_263(n), !conditional_architecture_265(n), !conditional_architecture_267(n).
conditional_architecture_276(n) :- inside(c268, n, conditional_architecture_any_kind), node(_, c268, "identifier", _, _), text(c268, s269), match("(?s:.*)(?:^Callable$)(?s:.*)", s269), !conditional_architecture_271(c268), !conditional_architecture_273(c268), !conditional_architecture_275(c268).
