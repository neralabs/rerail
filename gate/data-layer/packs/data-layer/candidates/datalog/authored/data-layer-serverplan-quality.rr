quality_project_taxonomy_1(n) :- node(_, n, "elif_clause", _, _).
quality_project_taxonomy_7(n) :- node(_, n, "identifier", _, _), text(n, s4), match("(?s:.*)(?:^(?:get_origin|id|is_dataclass|isinstance|type)$)(?s:.*)", s4).
quality_project_taxonomy_7(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c5), node(_, c5, "identifier", _, _), text(c5, s6), match("(?s:.*)(?:^(?:get_origin|id|is_dataclass|isinstance|type)$)(?s:.*)", s6).
quality_project_taxonomy_10(n) :- node(_, n, "call", _, _), field(n, "function", c3), quality_project_taxonomy_7(c3).
quality_project_taxonomy_10(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c8), node(_, c8, "identifier", _, _), text(c8, s9), match("(?s:.*)(?:^(?:__module__|__name__)$)(?s:.*)", s9).
quality_project_taxonomy_16(n) :- node(_, n, "identifier", _, _), text(n, s13), match("(?s:.*)(?:^(?:get_origin|id|is_dataclass|isinstance|type)$)(?s:.*)", s13).
quality_project_taxonomy_16(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c14), node(_, c14, "identifier", _, _), text(c14, s15), match("(?s:.*)(?:^(?:get_origin|id|is_dataclass|isinstance|type)$)(?s:.*)", s15).
quality_project_taxonomy_19(n) :- node(_, n, "call", _, _), field(n, "function", c12), quality_project_taxonomy_16(c12).
quality_project_taxonomy_19(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c17), node(_, c17, "identifier", _, _), text(c17, s18), match("(?s:.*)(?:^(?:__module__|__name__)$)(?s:.*)", s18).
quality_project_taxonomy_20(n) :- quality_project_taxonomy_10(n).
quality_project_taxonomy_20(n) :- inside(c11, n, quality_project_taxonomy_any_kind), quality_project_taxonomy_19(c11).
quality_project_taxonomy_21(n) :- quality_project_taxonomy_1(n), field(n, "condition", c2), quality_project_taxonomy_20(c2).
quality_project_taxonomy_23(n) :- node_text(n, s22), match("(?s:.*)(?:^async)(?s:.*)", s22).
quality_project_taxonomy_29(n) :- node(_, n, "identifier", _, _), text(n, s26), match("(?s:.*)(?:^(?:id)$)(?s:.*)", s26).
quality_project_taxonomy_29(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c27), node(_, c27, "identifier", _, _), text(c27, s28), match("(?s:.*)(?:^(?:id)$)(?s:.*)", s28).
quality_project_taxonomy_39(n) :- node(_, n, "identifier", _, _), text(n, s36), match("(?s:.*)(?:^(?:id)$)(?s:.*)", s36).
quality_project_taxonomy_39(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c37), node(_, c37, "identifier", _, _), text(c37, s38), match("(?s:.*)(?:^(?:id)$)(?s:.*)", s38).
quality_project_taxonomy_45(n) :- node(_, n, "identifier", _, _), text(n, s42), match("(?s:.*)(?:^(?:id)$)(?s:.*)", s42).
quality_project_taxonomy_45(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c43), node(_, c43, "identifier", _, _), text(c43, s44), match("(?s:.*)(?:^(?:id)$)(?s:.*)", s44).
quality_project_taxonomy_51(n) :- node(_, n, "identifier", _, _), text(n, s48), match("(?s:.*)(?:^(?:fields)$)(?s:.*)", s48).
quality_project_taxonomy_51(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c49), node(_, c49, "identifier", _, _), text(c49, s50), match("(?s:.*)(?:^(?:fields)$)(?s:.*)", s50).
quality_project_taxonomy_58(n) :- node_text(n, s57), match("(?s:.*)(?:^async)(?s:.*)", s57).
quality_project_taxonomy_64(n) :- node(_, n, "identifier", _, _), text(n, s61), match("(?s:.*)(?:^(?:getattr)$)(?s:.*)", s61).
quality_project_taxonomy_64(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c62), node(_, c62, "identifier", _, _), text(c62, s63), match("(?s:.*)(?:^(?:getattr)$)(?s:.*)", s63).
quality_project_taxonomy_68(n) :- inside(c59, n, quality_project_taxonomy_kinds1), node(_, c59, "call", _, _), field(c59, "function", c60), quality_project_taxonomy_64(c60).
quality_project_taxonomy_68(n) :- field(n, "right", c65), node(_, c65, "attribute", _, _), field(c65, "attribute", c66), node(_, c66, "identifier", _, _), text(c66, s67), match("(?s:.*)(?:^(?:model_fields)$)(?s:.*)", s67).
quality_project_taxonomy_69(n) :- inside(c46, n, quality_project_taxonomy_kinds0), node(_, c46, "call", _, _), field(c46, "function", c47), quality_project_taxonomy_51(c47).
quality_project_taxonomy_69(n) :- inside(c52, n, quality_project_taxonomy_kinds0), node(_, c52, "call", _, _), field(c52, "function", c53), node(_, c53, "attribute", _, _), field(c53, "attribute", c54), node(_, c54, "identifier", _, _), text(c54, s55), match("(?s:.*)(?:^(?:internal_plan_payload_state|internal_plan_ref_state|items|model_fields|values)$)(?s:.*)", s55).
quality_project_taxonomy_69(n) :- inside(c56, n, quality_project_taxonomy_kinds0), node(_, c56, "for_statement", _, _), !quality_project_taxonomy_58(c56), quality_project_taxonomy_68(c56).
quality_project_taxonomy_83(n) :- node(_, n, "identifier", _, _), text(n, s80), match("(?s:.*)(?:^(?:fields)$)(?s:.*)", s80).
quality_project_taxonomy_83(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c81), node(_, c81, "identifier", _, _), text(c81, s82), match("(?s:.*)(?:^(?:fields)$)(?s:.*)", s82).
quality_project_taxonomy_90(n) :- node_text(n, s89), match("(?s:.*)(?:^async)(?s:.*)", s89).
quality_project_taxonomy_96(n) :- node(_, n, "identifier", _, _), text(n, s93), match("(?s:.*)(?:^(?:getattr)$)(?s:.*)", s93).
quality_project_taxonomy_96(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c94), node(_, c94, "identifier", _, _), text(c94, s95), match("(?s:.*)(?:^(?:getattr)$)(?s:.*)", s95).
quality_project_taxonomy_100(n) :- inside(c91, n, quality_project_taxonomy_kinds1), node(_, c91, "call", _, _), field(c91, "function", c92), quality_project_taxonomy_96(c92).
quality_project_taxonomy_100(n) :- field(n, "right", c97), node(_, c97, "attribute", _, _), field(c97, "attribute", c98), node(_, c98, "identifier", _, _), text(c98, s99), match("(?s:.*)(?:^(?:model_fields)$)(?s:.*)", s99).
quality_project_taxonomy_101(n) :- inside(c78, n, quality_project_taxonomy_kinds0), node(_, c78, "call", _, _), field(c78, "function", c79), quality_project_taxonomy_83(c79).
quality_project_taxonomy_101(n) :- inside(c84, n, quality_project_taxonomy_kinds0), node(_, c84, "call", _, _), field(c84, "function", c85), node(_, c85, "attribute", _, _), field(c85, "attribute", c86), node(_, c86, "identifier", _, _), text(c86, s87), match("(?s:.*)(?:^(?:internal_plan_payload_state|internal_plan_ref_state|items|model_fields|values)$)(?s:.*)", s87).
quality_project_taxonomy_101(n) :- inside(c88, n, quality_project_taxonomy_kinds0), node(_, c88, "for_statement", _, _), !quality_project_taxonomy_90(c88), quality_project_taxonomy_100(c88).
quality_project_taxonomy_107(n) :- node(_, n, "identifier", _, _), text(n, s104), match("(?s:.*)(?:^(?:fields)$)(?s:.*)", s104).
quality_project_taxonomy_107(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c105), node(_, c105, "identifier", _, _), text(c105, s106), match("(?s:.*)(?:^(?:fields)$)(?s:.*)", s106).
quality_project_taxonomy_114(n) :- node_text(n, s113), match("(?s:.*)(?:^async)(?s:.*)", s113).
quality_project_taxonomy_120(n) :- node(_, n, "identifier", _, _), text(n, s117), match("(?s:.*)(?:^(?:getattr)$)(?s:.*)", s117).
quality_project_taxonomy_120(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c118), node(_, c118, "identifier", _, _), text(c118, s119), match("(?s:.*)(?:^(?:getattr)$)(?s:.*)", s119).
quality_project_taxonomy_124(n) :- inside(c115, n, quality_project_taxonomy_kinds1), node(_, c115, "call", _, _), field(c115, "function", c116), quality_project_taxonomy_120(c116).
quality_project_taxonomy_124(n) :- field(n, "right", c121), node(_, c121, "attribute", _, _), field(c121, "attribute", c122), node(_, c122, "identifier", _, _), text(c122, s123), match("(?s:.*)(?:^(?:model_fields)$)(?s:.*)", s123).
quality_project_taxonomy_125(n) :- inside(c102, n, quality_project_taxonomy_kinds0), node(_, c102, "call", _, _), field(c102, "function", c103), quality_project_taxonomy_107(c103).
quality_project_taxonomy_125(n) :- inside(c108, n, quality_project_taxonomy_kinds0), node(_, c108, "call", _, _), field(c108, "function", c109), node(_, c109, "attribute", _, _), field(c109, "attribute", c110), node(_, c110, "identifier", _, _), text(c110, s111), match("(?s:.*)(?:^(?:internal_plan_payload_state|internal_plan_ref_state|items|model_fields|values)$)(?s:.*)", s111).
quality_project_taxonomy_125(n) :- inside(c112, n, quality_project_taxonomy_kinds0), node(_, c112, "for_statement", _, _), !quality_project_taxonomy_114(c112), quality_project_taxonomy_124(c112).
quality_project_taxonomy_126(n) :- inside(c24, n, quality_project_taxonomy_kinds0), node(_, c24, "call", _, _), field(c24, "function", c25), quality_project_taxonomy_29(c25), inside(c30, n, quality_project_taxonomy_kinds0), node(_, c30, "call", _, _), field(c30, "function", c31), node(_, c31, "attribute", _, _), field(c31, "attribute", c32), node(_, c32, "identifier", _, _), text(c32, s33), match("(?s:.*)(?:^(?:__getattribute__|__new__|__setattr__)$)(?s:.*)", s33).
quality_project_taxonomy_126(n) :- inside(c34, n, quality_project_taxonomy_kinds0), node(_, c34, "call", _, _), field(c34, "function", c35), quality_project_taxonomy_39(c35), quality_project_taxonomy_self_loop(n).
quality_project_taxonomy_126(n) :- inside(c40, n, quality_project_taxonomy_kinds0), node(_, c40, "call", _, _), field(c40, "function", c41), quality_project_taxonomy_45(c41), quality_project_taxonomy_69(n).
quality_project_taxonomy_126(n) :- inside(c70, n, quality_project_taxonomy_kinds0), node(_, c70, "call", _, _), field(c70, "function", c71), node(_, c71, "attribute", _, _), field(c71, "attribute", c72), node(_, c72, "identifier", _, _), text(c72, s73), match("(?s:.*)(?:^(?:__getattribute__|__new__|__setattr__)$)(?s:.*)", s73), quality_project_taxonomy_self_loop(n).
quality_project_taxonomy_126(n) :- inside(c74, n, quality_project_taxonomy_kinds0), node(_, c74, "call", _, _), field(c74, "function", c75), node(_, c75, "attribute", _, _), field(c75, "attribute", c76), node(_, c76, "identifier", _, _), text(c76, s77), match("(?s:.*)(?:^(?:__getattribute__|__new__|__setattr__)$)(?s:.*)", s77), quality_project_taxonomy_101(n).
quality_project_taxonomy_126(n) :- quality_project_taxonomy_self_loop(n), quality_project_taxonomy_125(n).
quality_project_taxonomy_file132(d) :- doc(d, p131, _), match("(?s:.*)(?:(?:^|/)tests(?:/|$))(?s:.*)", p131).
quality_project_taxonomy_file133(d) :- doc(d, _, _), !quality_project_taxonomy_file132(d).
quality_project_taxonomy_file145(d) :- doc(d, _, _), option_value("entryPoint", "all"), !option_on("oracleAnalyzer"), option_value("entryPoint", "all"), !option_on("oracleAnalyzer").
quality_project_taxonomy_file145(d) :- doc(d, _, _), option_value("entryPoint", "all"), !option_on("oracleAnalyzer"), option_value("entryPoint", "_check_recursive_payload_taxonomy_duplication_across_surfaces").
quality_project_taxonomy_file145(d) :- doc(d, _, _), option_value("entryPoint", "_check_recursive_payload_taxonomy_duplication_across_surfaces"), option_value("entryPoint", "all"), !option_on("oracleAnalyzer").
quality_project_taxonomy_file145(d) :- doc(d, _, _), option_value("entryPoint", "_check_recursive_payload_taxonomy_duplication_across_surfaces"), option_value("entryPoint", "_check_recursive_payload_taxonomy_duplication_across_surfaces").
quality_project_taxonomy_def(n, s) :- node(_, n, "function_definition", _, _), field(n, "name", c), text(c, s).
quality_project_taxonomy_callee(f, s) :- node(_, f, "identifier", _, _), text(f, s).
quality_project_taxonomy_callee(f, s) :- node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, s).
quality_project_taxonomy_self_call(n, c) :- quality_project_taxonomy_def(n, s), inside(c, n, quality_project_taxonomy_kinds0), node(_, c, "call", _, _), field(c, "function", f), quality_project_taxonomy_callee(f, s).
quality_project_taxonomy_recursive(n) :- quality_project_taxonomy_def(n, _), k = count : { quality_project_taxonomy_self_call(n, _) }, k >= 2.
quality_project_taxonomy_dispatch(n, x) :- quality_project_taxonomy_def(n, _), inside(x, n, quality_project_taxonomy_kinds0), quality_project_taxonomy_21(x).
quality_project_taxonomy_dispatching(n) :- quality_project_taxonomy_def(n, _), k = count : { quality_project_taxonomy_dispatch(n, _) }, k >= 3.
quality_project_taxonomy_part(h, h) :- node(_, h, "string", _, _).
quality_project_taxonomy_part(h, s) :- node(_, h, "concatenated_string", _, _), child(h, s, _), node(_, s, "string", _, _).
quality_project_taxonomy_shape_message(h) :- quality_project_taxonomy_part(h, _), value(h, v), value_type_of(h, "str"), match("(?s:.*)(?:(?is)unsupported.*shape|shape.*unsupported)(?s:.*)", v).
quality_project_taxonomy_shape_message(h) :- quality_project_taxonomy_part(h, _), fstring_piece(h, _, "literal", v), match("(?s:.*)(?:(?is)unsupported.*shape|shape.*unsupported)(?s:.*)", v).
quality_project_taxonomy_message(n) :- quality_project_taxonomy_def(n, _), inside(h, n, quality_project_taxonomy_kinds0), quality_project_taxonomy_shape_message(h).
quality_project_taxonomy_self_loop(n) :- quality_project_taxonomy_self_call(n, c), inside(c, f, quality_project_taxonomy_kinds1), node(_, f, "for_statement", _, _), !quality_project_taxonomy_23(f), inside(f, n, quality_project_taxonomy_kinds0).
quality_project_taxonomy_candidates(d, n) :- quality_project_taxonomy_def(n, _), quality_project_taxonomy_recursive(n), quality_project_taxonomy_dispatching(n), quality_project_taxonomy_message(n), inside(c127, n, quality_project_taxonomy_kinds0), node(_, c127, "raise_statement", _, _), child(c127, c128, _), node(_, c128, "call", _, _), field(c128, "function", c129), node(_, c129, "identifier", _, _), text(c129, s130), match("(?s:.*)(?:^(?:TypeError)$)(?s:.*)", s130), quality_project_taxonomy_126(n), node(d134, n, _, _, _), quality_project_taxonomy_file133(d134), node(d146, n, _, _, _), quality_project_taxonomy_file145(d146), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d).
quality_project_taxonomy_rows(k) :- quality_project_taxonomy_candidates(_, _), k = count : { quality_project_taxonomy_candidates(_, _) }.
violation("data-layer-serverplan-quality", "quality-project-taxonomy", "SPQ-049", p, l) :- quality_project_taxonomy_candidates(d, n), quality_project_taxonomy_rows(k), k >= 2, doc(d, p, _), line(n, l).

// ---- conditional-architecture (relational, SPQ-029; no partitionBy: one query over every file) ----
// option-gated: every input's `$option` filePath gate (entryPoint conditional_architecture_findings, or "all" without oracleAnalyzer) is an alternative on option_value/option_on.
// The SQL clause rule for rule: each input is its matcher (relation conditional_architecture_<input>(n), the
// matched node, through the translator), its projections by hand; each stage is a relation:
//   classes/fns, class_spans/fn_spans  _class(d, n, start, end, name) / _fn(…)
//   module_names                       _module(d, qualified): rx_extract and replace as @rx_replace
//   aliases (from_names, direct_names) _alias(d, start, local, origin) (_from_item, _direct_item, _mfull: trim)
//   cclasses                           _cclass(d, n, start, end, name, qualified_name): the last class of a name
//   base_scan, bases                   _sup, _split, _cut, _stop, _item(class, item text); _base(class, base text)
//   class_bases                        _class_base(class, name): _base_head/_base_suffix (rx_extract head and
//                                      dotted suffix), _resolved (the latest alias before the class, else the head)
//   derived                            _derived(qualified name): recursion along cclasses (finite)
//   fn_owner                           _fn_cls(f, innermost enclosing class by spans), _has_cls
//   cmethods, cmethods.derived         _cmethod(d, f, start, end, name, class): the last of (class, name); _cmethod_derived
//   cfunctions                         _cfunc(d, f, start, end, qualified_name): the last classless one of a name
//   vtree                              _vchild(parent, vnode): the vnodes input with its PARENT (ids are the nodes)
//   contract_blocks                    _cblock(b); the sequence is not needed (below)
//   block_results                      _raises(b): _barrier/_limit, _body_stmt, _typeerror, _if_else, _match_case,
//                                      _sub (the blocks an if/match statement's value reads), _all_ok
//   always_raises                      _always(method)
//   method_returns                     _mret(class, level fn row, return, value) from _intret (int_returns rows)
//   role_returns, named_calls          _roleret(d, start, end), _ncall(d, start, end, full_callee, callee line)
//   self_stores, callable_params       the input relation, _store_right(store, RIGHT); _cparam(fn, PNAME)
//   step_params                        _step_ann(fn, ANN)
//   declared, owned_declared           _decl_x(X) (the nearest typed assignment ancestor, no function around it),
//                                      _decl_cls(X, innermost enclosing class)
//   compile_calls, branch_vars         _ccall(call, object_text), _bvar(d, VAR name, stmt start, stmt end)
//   owned_stores/compiles/controls     _own_fn(row node, innermost enclosing fn_spans row), also contract_blocks' owner
//   the query's 19 SELECTs             one violation rule each (an OR in a WHERE: one rule per disjunct); the
//                                      EXISTS(cclasses IN …) OR EXISTS(cfunctions …) guard is _present(1).
// A row's line is its start node's (line(n, l)); the four 'missing' rows (path, 0, 0) are the literal location
// path at line 1 (W anchors them to Span::default, recorded at line 1). The key (detector, issue, identity) only
// dedupes rows; the (path, line, code) set is the same.
//
// Exact, by construction (where the SQL text is not followed literally):
// - block_results' fold (blocks in size order, state a JSON map) is a positive recursion over the tree: a block's
//   value reads only blocks strictly inside it (the ones the size order puts first), so the least fixpoint is the
//   fold's final state. "No sub-block fails to raise" is a walk through the sub-blocks in start order (_ok_upto),
//   neither a negation inside the recursion nor a counter in it (the engine refuses both).
// - vtree ids kind:start:end are the nodes (two distinct vnodes never share kind and span).
// - CAST(text AS INTEGER) <= 0 / = 0 on an integer literal: its leading decimal digits are all zeros (SQLite reads
//   the leading digits: '0x10' is 0, '1_000' is 1), _zero.
// - count(*) over method_returns counts (matched level function, return) pairs, as the rows are.
// - First bindings: step_params' ANN is the first typed `step` parameter in child order; int_returns' V the
//   return's one child; self_stores' RIGHT the right field; declared's X the nearest qualifying ancestor.
// - Regexes dropped as implied by their sibling tests: controls' \b(?:backend_type|is_sql_backend)\b (the attribute
//   identifier backend_type / is_sql_backend is a whole word of the text) and callable_params' \bCallable\b on the
//   parameters (the Callable identifier inside the type is a whole word of it).
// - rx_extract(x, RE, g) is the group g of @rx_replace(x, '^(?s:.*?)(?:RE)(?s:.*)$', '$g') where RE matches x (the
//   lazy prefix starts the match where find_iter's first one starts, and RE's own preference picks the same
//   match there), else NULL, which here is no row: module_names, the aliases' local, class_bases' head and suffix
//   (with '$' for compiler-contract's annotation: '' where the whole annotation is no dotted chain).
// - trim(module, '.') is @rx_replace(module, '^\.+|\.+$', ''); replace(q, '/', '.') is @rx_replace(q, '/', '.').
// - module_names gives every class and function a qualified name: the rule's scope is **/*.py, so the else
//   branch's rx_extract always matches (a file named `.py` itself aside, which no corpus holds).
// - base_scan: the SQL scans t (the superclasses text less its parentheses) a character at a time, the depth the
//   count of '(' '[' '{' less ')' ']' '}' before; a comma at depth 0 ends an item. Here comma k (from 0) splits
//   where the prefix before it (@rx_replace with `^((?:[^,]*,){k}[^,]*),.*$`) opens as many brackets as it closes
//   (strlen of the prefix with every other character replaced away), and an item is the text between consecutive
//   splits, trimmed of space, tab, LF and CR as trim(item, char(32,9,10,13)). k runs over 0 … n-1, n the commas of
//   t, written in four base-64 digits (_sup_k1 … _sup_k): exact below 64^4 commas in one superclass list.
//
// Not modelled (named):
// - W rejects the whole result when two rows share (detector, issue, identity) ("relational results have
//   duplicate identities"): backend-control's identity is method start:line, so two controls of one derived method
//   on one line fail the clause in W; here that line's finding is reported. A clause failure has no .rr form.
// - Suppression comments (ignoredBy / rerail-ignore).
// Relations beyond the header's: inside(n, a, set) (the engine's tree relation, as the translator uses it).
// nthChild without ofRule: controls' 2 counts comment tokens (_cx_shift); callable_params' and step_params' 1 is a
// parameter's name, where the parameter starts, so no comment precedes it: child() index 0, exact.
.decl conditional_architecture_any_kind(kind: symbol)
