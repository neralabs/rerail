// data-layer-executor-publication-repairs: four `forbid.regex` clauses over file.content, each a literal pattern
// with `lines: {first: true}` (python terminators, the default). W (query::regex_query_matches) scans the file line
// by line, splitting as str.splitlines does, and keeps at most the first match of each line: one finding per line
// that holds the literal, at that line. src_line splits the same way, so each clause is "the lines containing it".
// `_publication_contract_cache` also matches inside `_cte_publication_contract_cache`, as the regex does.
// A regex clause has no syntax gate: files that do not parse are scanned too.
.decl doc(d: number, path: symbol, module: symbol)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl src_line(d: number, l: number, sp: node)
.decl text(n: node, s: symbol)
.input src_line
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

.decl publication_line(d: number, l: number, s: symbol)
publication_line(d, l, s) :- doc(d, _, _), in_scope(d), !out_scope(d), src_line(d, l, sp), text(sp, s).

violation("data-layer-executor-publication-repairs", "cte_output_columns", "executor_publication_repair", p, l) :-
    publication_line(d, l, s), contains("_cte_output_columns", s), doc(d, p, _).
violation("data-layer-executor-publication-repairs", "cte_column_type_hints", "executor_publication_repair", p, l) :-
    publication_line(d, l, s), contains("_cte_column_type_hints", s), doc(d, p, _).
violation("data-layer-executor-publication-repairs", "publication_contract_cache", "executor_publication_repair", p, l) :-
    publication_line(d, l, s), contains("_publication_contract_cache", s), doc(d, p, _).
violation("data-layer-executor-publication-repairs", "cte_publication_contract_cache", "executor_publication_repair", p, l) :-
    publication_line(d, l, s), contains("_cte_publication_contract_cache", s), doc(d, p, _).
