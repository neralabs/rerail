// data-layer-no-blanket-grammar-bypass, authored clause `keyword`.
// The policy: an identifier whose text matches `(?P<LOWER>allow_direct_execution)`, anchored at the capture
// LOWER. An identifier is one line, so the capture's line is the identifier's line; the regex is a plain
// substring, so `contains` is it exactly. The file test (`notRegex` on the path) and `syntax: valid` are the
// converter's forms for the clause `constant` beside it.
.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl text(n: node, s: symbol)
.decl line(n: node, l: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, text, line, syntax_error
.output violation

// The paths `file.path.notRegex` excludes, exactly (the regex is anchored at both ends).
.decl keyword_exempt_path(p: symbol)
keyword_exempt_path("scripts/lint_impl_direct_execution.py").
keyword_exempt_path("scripts/lint_no_blanket_grammar_bypass.py").
keyword_exempt_path("scripts/tests/test_lint_no_blanket_grammar_bypass.py").

violation("data-layer-no-blanket-grammar-bypass", "keyword", "NGB001", p, l) :-
    node(d, n, "identifier", _, _), text(n, s), contains("allow_direct_execution", s),
    in_scope(d), !out_scope(d), !syntax_error(d), doc(d, p, _), !keyword_exempt_path(p), line(n, l).
