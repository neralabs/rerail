// ---- findings ---------------------------------------------------------------------------------------------------------
// Each clause's findings as keys (a set: J1).
.decl esc_found(clause: symbol, path: symbol, line: number)
esc_found("forbidden-class", p, l) :- forbidden_class_hit(d, n), doc(d, p, _), line(n, l).
esc_found("unsafe-parameter", p, l) :- unsafe_parameter_hit(d, n), doc(d, p, _), line(n, l).
esc_found("usage-0", p, l) :- usage_0_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-1", p, l) :- usage_1_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-2", p, l) :- usage_2_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-3", p, l) :- usage_3_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-4", p, l) :- usage_4_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-5", p, l) :- usage_5_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-6", p, l) :- usage_6_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-7", p, l) :- usage_7_current(d, n), doc(d, p, _), line(n, l).
esc_found("usage-8", p, l) :- usage_8_current(d, n), doc(d, p, _), line(n, l).
// report_when (count > k, converter-given report_when_gt): nothing unless the rule's findings, all files and clauses
// together, number more than k. W counts witnesses; this counts distinct (clause, path, line) keys, the same where no
// clause has two witnesses on one line (findings are a set of keys, J1).
.decl esc_total(k: number)
.decl esc_any(x: number)
esc_any(1) :- esc_found(_, _, _).
esc_total(k) :- esc_any(1), k = count : { esc_found(_, _, _) }.
violation("data-layer-sql-grammar-escape-hatches", "forbidden-class", "escape_hatch", p, l) :- esc_found("forbidden-class", p, l), !report_when_gt(_).
violation("data-layer-sql-grammar-escape-hatches", "forbidden-class", "escape_hatch", p, l) :- esc_found("forbidden-class", p, l), report_when_gt(g), esc_total(k), k > g.
violation("data-layer-sql-grammar-escape-hatches", "unsafe-parameter", "escape_hatch", p, l) :- esc_found("unsafe-parameter", p, l), !report_when_gt(_).
violation("data-layer-sql-grammar-escape-hatches", "unsafe-parameter", "escape_hatch", p, l) :- esc_found("unsafe-parameter", p, l), report_when_gt(g), esc_total(k), k > g.
violation("data-layer-sql-grammar-escape-hatches", "usage-0", "escape_hatch", p, l) :- esc_found("usage-0", p, l), !report_when_gt(_).
violation("data-layer-sql-grammar-escape-hatches", "usage-0", "escape_hatch", p, l) :- esc_found("usage-0", p, l), report_when_gt(g), esc_total(k), k > g.
violation("data-layer-sql-grammar-escape-hatches", "usage-1", "escape_hatch", p, l) :- esc_found("usage-1", p, l), !report_when_gt(_).
violation("data-layer-sql-grammar-escape-hatches", "usage-1", "escape_hatch", p, l) :- esc_found("usage-1", p, l), report_when_gt(g), esc_total(k), k > g.
violation("data-layer-sql-grammar-escape-hatches", "usage-2", "escape_hatch", p, l) :- esc_found("usage-2", p, l), !report_when_gt(_).
violation("data-layer-sql-grammar-escape-hatches", "usage-2", "escape_hatch", p, l) :- esc_found("usage-2", p, l), report_when_gt(g), esc_total(k), k > g.
