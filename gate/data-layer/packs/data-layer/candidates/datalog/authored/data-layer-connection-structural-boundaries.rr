// data-layer-connection-structural-boundaries, clause `connection-structure` (relational, cross-file), by hand.
// Source: gate/data-layer/packs/data-layer/rules/data-layer-connection-structural-boundaries.json.
//
// Options at their defaults: entryPoint "all" (the final query's `default` case: every branch, no issue filter;
// `last_classes` keeps a name's LAST module-level class, `class_order` unused by the keys) and parameters "{}"
// (`roles`: connection l2000_connection/connection.py, lifecycle l2000_connection/connection_lifecycle.py, sql
// impl/common/l2200_sql_dialect/sql_connection.py; `line_metrics`: no lineCounts, each file's own count).
// The SQL reads CPython's `ast` rows (`pythonAst`, columns as
// native/src/code_rule_dsl/value/python_ast/metadata.py at 40e7b6cac builds them); here on tree-sitter's tree:
// - Module rows sit at line 1 (a Module has no lineno); `source_lines` is len(source.splitlines()): line_count;
// - `top` (parent 0) is a module-level class_definition/function_definition, bare or decorated; `methods` a
//   function_definition in a class's body block, bare or decorated; a def's or class's lineno is its
//   `def`/`async`/`class` line, tree-sitter's start line;
// - `bases` are the class's positional superclass arguments that are a Name or an Attribute (parentheses dropped;
//   ast_name an identifier's text, an attribute's `attribute`); keywords and `*x` are not bases;
// - a node `BETWEEN m.id AND m.last` is in m's subtree: a descendant of the function_definition (its decorators
//   are outside it in tree-sitter; approximation noted: a decorator's call is not in the method here);
// - Call: `call`, its func the `function` field, parentheses dropped, the receiver the Attribute func's `object`;
// - Assign/AnnAssign/AugAssign targets: an `assignment` (chained `a = b = c` is one assignment per `=` here, each
//   left a target) or `augmented_assignment` left, and the elements of tuple/list targets, recursively.
// The gate (`syntax: valid`) is !syntax_error(d); `gate`/`invalid_files` (CSB030's choice of file) are the parsed
// documents of the scope, valid or not. The finding's code is the `issue` column.
// Not authored: the entryPoint cases other than the default, and `parameters` (its JSON members connectionPath,
// lifecyclePath, sqlPath, lineCounts): no relation gives an option's JSON members (engine gap, reported).

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl line(n: node, l: number)
.decl line_count(d: number, k: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- documents ---------------------------------------------------------------------------------------------
.decl cs_doc(d: number, p: symbol)
cs_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d).
.decl cs_valid(d: number, p: symbol)
cs_valid(d, p) :- cs_doc(d, p), !syntax_error(d).
.decl cs_backend(p: symbol)
cs_backend("impl/mariadb/connection.py"). cs_backend("impl/mongodb/connection.py"). cs_backend("impl/neo4j/connection.py").
cs_backend("impl/postgres/connection.py"). cs_backend("impl/sqlite/connection.py").
.decl cs_big_backend(p: symbol)
cs_big_backend("impl/sqlite/connection.py"). cs_big_backend("impl/postgres/connection.py"). cs_big_backend("impl/mariadb/connection.py").

// ---- top, last_classes, bases, methods -----------------------------------------------------------------------
// cs_top(d, n, kind, name): a module-level def or class.
.decl cs_top(d: number, n: node, k: symbol, name: symbol)
cs_top(d, n, k, s) :- node(d, m, "module", _, _), child(m, n, _), cs_def(n, k, s).
cs_top(d, n, k, s) :- node(d, m, "module", _, _), child(m, dd, _), node(_, dd, "decorated_definition", _, _),
    field(dd, "definition", n), cs_def(n, k, s).
.decl cs_def(n: node, k: symbol, name: symbol)
cs_def(n, "class", s) :- node(_, n, "class_definition", _, _), field(n, "name", x), text(x, s).
cs_def(n, "def", s) :- node(_, n, "function_definition", _, _), field(n, "name", x), text(x, s).
.decl cs_top_start(d: number, k: symbol, name: symbol, st: number)
cs_top_start(d, k, s, st) :- cs_top(d, n, k, s), node(_, n, _, st, _).
// last_classes: no later module-level class of the same name.
.decl cs_last_class(d: number, c: node, name: symbol)
cs_last_class(d, c, s) :- cs_top(d, c, "class", s), node(_, c, _, st, _), st = max t : { cs_top_start(d, "class", s, t) }.
// bases: positional superclass arguments that are a Name or an Attribute, parentheses dropped.
.decl cs_base_slot(c: node, b: node)
cs_base_slot(c, b) :- node(_, c, "class_definition", _, _), field(c, "superclasses", al), child(al, b, _),
    !node(_, b, "keyword_argument", _, _), !node(_, b, "comment", _, _).
cs_base_slot(c, x) :- cs_base_slot(c, b), node(_, b, "parenthesized_expression", _, _), child(b, x, _), !node(_, x, "comment", _, _).
.decl cs_base(c: node, b: node, name: symbol)
cs_base(c, b, s) :- cs_base_slot(c, b), node(_, b, "identifier", _, _), text(b, s).
cs_base(c, b, s) :- cs_base_slot(c, b), node(_, b, "attribute", _, _), field(b, "attribute", x), text(x, s).
// struct_methods: the methods of a last class.
.decl cs_method(d: number, c: node, cn: symbol, m: node, mn: symbol)
cs_method(d, c, cn, m, mn) :- cs_last_class(d, c, cn), field(c, "body", b), child(b, m, _), cs_def(m, "def", mn).
cs_method(d, c, cn, m, mn) :- cs_last_class(d, c, cn), field(c, "body", b), child(b, dd, _),
    node(_, dd, "decorated_definition", _, _), field(dd, "definition", m), cs_def(m, "def", mn).

// ---- self_connect: a call of self.connect / self.connect_async inside the method --------------------------------
.decl cs_fdef(kind: symbol)
cs_fdef("function_definition").
.decl cs_func(c: node, f: node)
cs_func(c, f) :- node(_, c, "call", _, _), field(c, "function", f).
cs_func(c, x) :- cs_func(c, f), node(_, f, "parenthesized_expression", _, _), child(f, x, _), !node(_, x, "comment", _, _).
.decl cs_receiver(o: node, r: node)
cs_receiver(o, o) :- cs_func(_, f), node(_, f, "attribute", _, _), field(f, "object", o).
cs_receiver(o, x) :- cs_receiver(o, p), node(_, p, "parenthesized_expression", _, _), child(p, x, _), !node(_, x, "comment", _, _).
.decl cs_self_connect_call(c: node)
cs_self_connect_call(c) :- cs_func(c, f), node(_, f, "attribute", _, _), field(f, "attribute", a), text(a, s),
    (s = "connect" ; s = "connect_async"), field(f, "object", o), cs_receiver(o, r), node(_, r, "identifier", _, _), text(r, "self").
.decl cs_self_connect(m: node)
cs_self_connect(m) :- cs_method(_, _, _, m, _), cs_self_connect_call(c), inside(c, m, cs_fdef).

// ---- sync_targets: self._conn/_cursor/_introspector/_validator assigned inside a method -------------------------
.decl cs_assign_kind(kind: symbol)
cs_assign_kind("assignment"). cs_assign_kind("augmented_assignment").
.decl cs_target(m: node, t: node)
cs_target(m, t) :- cs_method(_, _, _, m, _), node(_, a, k, _, _), cs_assign_kind(k), inside(a, m, cs_fdef), field(a, "left", t).
cs_target(m, e) :- cs_target(m, t), node(_, t, k, _, _), cs_sequence(k), child(t, e, _), !node(_, e, "comment", _, _).
.decl cs_sequence(kind: symbol)
cs_sequence("pattern_list"). cs_sequence("tuple_pattern"). cs_sequence("list_pattern").
.decl cs_sync_target(m: node)
cs_sync_target(m) :- cs_target(m, t), node(_, t, "attribute", _, _), field(t, "object", o), node(_, o, "identifier", _, _),
    text(o, "self"), field(t, "attribute", x), text(x, s),
    (s = "_conn" ; s = "_cursor" ; s = "_introspector" ; s = "_validator").

// ---- name lists ------------------------------------------------------------------------------------------------
.decl cs_residual(s: symbol)
cs_residual("AsyncSchemaBootstrapEvidence"). cs_residual("AsyncTableExistsAuthority"). cs_residual("ReadPlanWorkflow").
cs_residual("SchemaBootstrapEvidence"). cs_residual("SingleIntentPlanWorkflow"). cs_residual("WritePlanWorkflow").
cs_residual("_ConnectionMetadataMixin"). cs_residual("_PlanScopeFetchToken"). cs_residual("_plan_scope_fetch_template").
cs_residual("_resolve_bootstrap_scope_exists_in_schema_transaction_lazy"). cs_residual("_resolve_plan_scope_fetch_template").
cs_residual("execute_read_plan_workflow"). cs_residual("execute_read_plan_workflow_async").
cs_residual("execute_single_intent_plan_workflow"). cs_residual("execute_single_intent_plan_workflow_async").
cs_residual("execute_write_plan_workflow"). cs_residual("execute_write_plan_workflow_async").
.decl cs_sql_residual(s: symbol)
cs_sql_residual("AttributedSqlRenderable"). cs_sql_residual("ContentStoreManifest"). cs_sql_residual("PreparedTerminalExecution").
cs_sql_residual("_DirectGrammarExecutionPlan"). cs_sql_residual("_DirectGrammarExecutionRequest").
cs_sql_residual("_LargeColumnHydrationRuntimeStep"). cs_sql_residual("_PolymorphicCheckReconciliationPlan").
cs_sql_residual("_PolymorphicRegistryBootstrapRead"). cs_sql_residual("_SchemaDdlTransaction"). cs_sql_residual("_SqlDirectLazyContext").
cs_sql_residual("_annotation_is_nullable"). cs_sql_residual("_model_field_nullable"). cs_sql_residual("_sql_types_compatible").
cs_sql_residual("_sqlcoresupport__flush_polymorphic_metadata_batch_lazy"). cs_sql_residual("_sqlcoresupport__schema_ensure_model_table_lazy").
cs_sql_residual("_sqlcoresupport_ensure_polymorphic_columns_exist_lazy"). cs_sql_residual("_sqlexecution__replay_cached_schema_ddl_effects_lazy").
.decl cs_mixin(s: symbol)
cs_mixin("_MariaDBCoreSupportMixin"). cs_mixin("_MariaDBExecutionSupportMixin"). cs_mixin("_MariaDBLifecycleExecutionMixin").
cs_mixin("_MariaDBMetadataSchemaMixin"). cs_mixin("_MariaDBVersioningMixin"). cs_mixin("_PostgresBootstrapFeatureMixin").
cs_mixin("_PostgresCoreSupportMixin"). cs_mixin("_PostgresExecutionSupportMixin"). cs_mixin("_PostgresLargeColumnMixin").
cs_mixin("_PostgresLifecycleExecutionMixin"). cs_mixin("_PostgresMetadataSchemaMixin"). cs_mixin("_PostgresVersioningMixin").
cs_mixin("_SqliteCoreSupportMixin"). cs_mixin("_SqliteExecutionSupportMixin"). cs_mixin("_SqliteInstrumentationSupportMixin").
cs_mixin("_SqliteLargeColumnMixin"). cs_mixin("_SqliteLifecycleExecutionMixin"). cs_mixin("_SqliteMetadataSchemaMixin").
cs_mixin("_SqliteVersioningMixin").
.decl cs_good_base(s: symbol)
cs_good_base("ConnectionPayloadOpaqueMarker"). cs_good_base("_ConnectionStateCore"). cs_good_base("_LazyConnectionBase").
.decl cs_lifecycle_method(s: symbol)
cs_lifecycle_method("__aenter__"). cs_lifecycle_method("__aexit__"). cs_lifecycle_method("__enter__"). cs_lifecycle_method("__exit__").
.decl cs_connect_method(s: symbol)
cs_connect_method("connect"). cs_connect_method("connect_async"). cs_connect_method("ensure_connected_async"). cs_connect_method("ensure_connected_sync").
// A backend connection class: name ends with Connection or ConnectionCore.
.decl cs_backend_class(s: symbol)
cs_backend_class(s) :- cs_method(_, _, s, _, _), suffix("Connection", s).
cs_backend_class(s) :- cs_method(_, _, s, _, _), suffix("ConnectionCore", s).

// CSB030's file: the lifecycle file when the scope parsed it (valid or not), else the connection file.
.decl cs_present(p: symbol)
cs_present(p) :- cs_doc(_, p).
.decl cs_lifecycle_path(p: symbol)
cs_lifecycle_path("l2000_connection/connection_lifecycle.py") :- cs_present("l2000_connection/connection_lifecycle.py").
cs_lifecycle_path("l2000_connection/connection.py") :- cs_doc(_, _), !cs_present("l2000_connection/connection_lifecycle.py").

// ---- the final query's branches: (document, issue, line) -------------------------------------------------------
.decl cs_hit(d: number, issue: symbol, l: number)
cs_hit(d, "CSB001", 1) :- cs_valid(d, "l2000_connection/connection.py"), line_count(d, k), k > 900.
cs_hit(d, "CSB010", 1) :- cs_valid(d, "impl/common/l2200_sql_dialect/sql_connection.py"), line_count(d, k), k > 6000.
cs_hit(d, "CSB020", 1) :- cs_valid(d, p), cs_big_backend(p), line_count(d, k), k > 3000.
cs_hit(d, "CSB002", l) :- cs_valid(d, "l2000_connection/connection.py"), cs_top(d, n, _, s), cs_residual(s), line(n, l).
cs_hit(d, "CSB012", l) :- cs_valid(d, "impl/common/l2200_sql_dialect/sql_connection.py"), cs_top(d, n, _, s), cs_sql_residual(s), line(n, l).
cs_hit(d, "CSB021", l) :- cs_valid(d, p), cs_big_backend(p), cs_top(d, n, _, s), cs_mixin(s), line(n, l).
cs_hit(d, "CSB003", l) :- cs_valid(d, "l2000_connection/connection.py"), cs_last_class(d, c, "_DatabaseConnectionCore"),
    cs_base(c, _, s), !cs_good_base(s), line(c, l).
cs_hit(d, "CSB011", 1) :- cs_valid(d, "impl/common/l2200_sql_dialect/sql_connection.py"),
    k = count : { cs_top(d, _, _, _) }, k > 90.
cs_hit(d, "CSB013", l) :- cs_valid(d, "impl/common/l2200_sql_dialect/sql_connection.py"), cs_last_class(d, c, "_SqlConnectionCore"),
    k = count : { cs_base(c, _, _) }, k > 6, line(c, l).
cs_hit(d, "CSB030", l) :- cs_lifecycle_path(p), cs_valid(d, p), cs_method(d, _, "_ConnectionLifecycleMixin", m, mn),
    (mn = "__enter__" ; mn = "__aenter__"), cs_self_connect(m), line(m, l).
cs_hit(d, "CSB031", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, mn), cs_backend_class(cn), cs_lifecycle_method(mn), line(m, l).
cs_hit(d, "CSB032", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, "connect_async"), cs_backend_class(cn),
    cs_sync_target(m), line(m, l).
cs_hit(d, "CSB033", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, mn), cs_backend_class(cn), !cs_connect_method(mn),
    cs_self_connect(m), line(m, l).

violation("data-layer-connection-structural-boundaries", "connection-structure", code, p, l) :- cs_hit(d, code, l), doc(d, p, _).
