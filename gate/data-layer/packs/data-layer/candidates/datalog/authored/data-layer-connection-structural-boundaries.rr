// data-layer-connection-structural-boundaries, clause `connection-structure` (relational, cross-file), by hand.
// Source: gate/data-layer/packs/data-layer/rules/data-layer-connection-structural-boundaries.json.
//
// Options, as the run resolves them:
// - entryPoint (option_value, default "all"): the final query's case. `_connection_file_violations` keeps CSB001-003,
//   `_sql_connection_violations` CSB010-013, `_backend_file_violations` CSB020-021, `_lifecycle_violations`
//   CSB030-033; any other entry (the `default` case) every issue. It also shapes the stages: `last_classes` keeps
//   a name's FIRST module-level class for the connection and sql entries, every class for the lifecycle entry, the
//   LAST otherwise; CSB013 counts every base (`all_bases`) for the sql entry, Name/Attribute bases otherwise; CSB030
//   for the lifecycle entry is only the first such method of the first `_ConnectionLifecycleMixin` class.
//   `class_order` shapes only identities and order, never a key.
// - parameters (option_json, default "{}"): `roles` (`connectionPath`, `lifecyclePath`, `sqlPath`, each its default
//   when absent or JSON null) and `line_metrics` (`lineCounts."<path>"`, else the file's own count). A role that is
//   an object or array (json_extract's JSON text) is read as absent, and a JSON string "null" as JSON null (one leaf
//   text): noted.
// The SQL reads CPython's `ast` rows (`pythonAst`, columns as
// native/src/code_rule_dsl/value/python_ast/metadata.py at 40e7b6cac builds them); here on tree-sitter's tree:
// - Module rows sit at line 1 (a Module has no lineno); `source_lines` is len(source.splitlines()): line_count;
// - `top` (parent 0) is a module-level class_definition/function_definition, bare or decorated; `methods` a
//   function_definition in a class's body block, bare or decorated; a def's or class's lineno is its
//   `def`/`async`/`class` line, tree-sitter's start line; preorder ids of module-level statements are source order;
// - `bases` are the class's positional superclass arguments that are a Name or an Attribute (parentheses dropped;
//   ast_name an identifier's text, an attribute's `attribute`); `all_bases` every positional one (`*x` included);
//   keywords and `**x` are neither;
// - a node `BETWEEN m.id AND m.last` is in m's subtree: a descendant of the function_definition or of one of its
//   decorators (CPython's FunctionDef holds them; tree-sitter's decorated_definition does);
// - Call: `call`, its func the `function` field, parentheses dropped, the receiver the Attribute func's `object`;
// - Assign/AnnAssign/AugAssign targets: an `assignment` (chained `a = b = c` is one assignment per `=` here, each
//   left a target) or `augmented_assignment` left, and the elements of tuple/list targets, recursively.
// The gate (`syntax: valid`) is !syntax_error(d); `gate`/`invalid_files` (CSB030's choice of file) are the scope's
// Python modules, valid or not. The finding's code is the `issue` column.

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl line(n: node, l: number)
.decl line_count(d: number, k: number)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl option_value(name: symbol, v: symbol)
.decl option_json(name: symbol, pointer: symbol, v: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- documents ---------------------------------------------------------------------------------------------
.decl cs_doc(d: number, p: symbol)
cs_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d).
.decl cs_valid(d: number, p: symbol)
cs_valid(d, p) :- cs_doc(d, p), node(d, _, "module", _, _), !syntax_error(d).
.decl cs_backend(p: symbol)
cs_backend("impl/mariadb/connection.py"). cs_backend("impl/mongodb/connection.py"). cs_backend("impl/neo4j/connection.py").
cs_backend("impl/postgres/connection.py"). cs_backend("impl/sqlite/connection.py").
.decl cs_big_backend(p: symbol)
cs_big_backend("impl/sqlite/connection.py"). cs_big_backend("impl/postgres/connection.py"). cs_big_backend("impl/mariadb/connection.py").

// ---- options -------------------------------------------------------------------------------------------------
.decl cs_entry(e: symbol)
cs_entry(e) :- option_value("entryPoint", e).
.decl cs_entry_case(e: symbol)
cs_entry_case("_connection_file_violations"). cs_entry_case("_sql_connection_violations").
cs_entry_case("_backend_file_violations"). cs_entry_case("_lifecycle_violations").
.decl cs_entry_issue(e: symbol, issue: symbol)
cs_entry_issue("_connection_file_violations", "CSB001"). cs_entry_issue("_connection_file_violations", "CSB002").
cs_entry_issue("_connection_file_violations", "CSB003").
cs_entry_issue("_sql_connection_violations", "CSB010"). cs_entry_issue("_sql_connection_violations", "CSB011").
cs_entry_issue("_sql_connection_violations", "CSB012"). cs_entry_issue("_sql_connection_violations", "CSB013").
cs_entry_issue("_backend_file_violations", "CSB020"). cs_entry_issue("_backend_file_violations", "CSB021").
cs_entry_issue("_lifecycle_violations", "CSB030"). cs_entry_issue("_lifecycle_violations", "CSB031").
cs_entry_issue("_lifecycle_violations", "CSB032"). cs_entry_issue("_lifecycle_violations", "CSB033").
// last_classes: which module-level class of a name it keeps.
.decl cs_class_mode(m: symbol)
cs_class_mode("first") :- cs_entry(e), (e = "_connection_file_violations" ; e = "_sql_connection_violations").
cs_class_mode("every") :- cs_entry("_lifecycle_violations").
cs_class_mode("last") :- cs_entry(e), e != "_connection_file_violations", e != "_sql_connection_violations", e != "_lifecycle_violations".
// roles: (role, path).
.decl cs_role_key(r: symbol, pointer: symbol)
cs_role_key("connection", "/connectionPath"). cs_role_key("lifecycle", "/lifecyclePath"). cs_role_key("sql", "/sqlPath").
.decl cs_role_default(r: symbol, p: symbol)
cs_role_default("connection", "l2000_connection/connection.py"). cs_role_default("lifecycle", "l2000_connection/connection_lifecycle.py").
cs_role_default("sql", "impl/common/l2200_sql_dialect/sql_connection.py").
.decl cs_role_given(r: symbol, p: symbol)
cs_role_given(r, p) :- cs_role_key(r, ptr), option_json("parameters", ptr, p), p != "null".
.decl cs_role_set(r: symbol)
cs_role_set(r) :- cs_role_given(r, _).
.decl cs_role(r: symbol, p: symbol)
cs_role(r, p) :- cs_role_given(r, p).
cs_role(r, p) :- cs_role_default(r, p), !cs_role_set(r).

// ---- line_metrics: `json_extract(parameters, '$.lineCounts.'||json_quote(path))`, the JSON pointer
// `/lineCounts/<path, ~ as ~0 and / as ~1>`, else the file's own count; only the files a line-count branch reads.
.decl cs_metric_doc(d: number, p: symbol)
cs_metric_doc(d, p) :- cs_valid(d, p), cs_role(_, p).
cs_metric_doc(d, p) :- cs_valid(d, p), cs_big_backend(p).
.decl cs_count_given(d: number, v: symbol)
cs_count_given(d, v) :- cs_metric_doc(d, p), e = @rx_replace(@rx_replace(p, "~", "~0"), "/", "~1"),
    ptr = cat("/lineCounts/", e), option_json("parameters", ptr, v), v != "null".
.decl cs_count_set(d: number)
cs_count_set(d) :- cs_count_given(d, _).
// CAST(source_lines AS INTEGER) > k, for k 900, 3000 and 6000: a given count is a number's text (a JSON number, or
// a string holding one), its integer part over k (an exponent form, which serde prints for huge floats only, is not
// read: noted); else the file's own count.
.decl cs_over(d: number, k: number)
cs_over(d, 900) :- cs_count_given(d, v), match("0*(?:9(?:0[1-9]|[1-9][0-9])|[1-9][0-9]{3,})(?:\\.[0-9]*)?", v).
cs_over(d, 3000) :- cs_count_given(d, v),
    match("0*(?:3(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})|[4-9][0-9]{3}|[1-9][0-9]{4,})(?:\\.[0-9]*)?", v).
cs_over(d, 6000) :- cs_count_given(d, v),
    match("0*(?:6(?:00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})|[7-9][0-9]{3}|[1-9][0-9]{4,})(?:\\.[0-9]*)?", v).
cs_over(d, 900) :- cs_metric_doc(d, _), !cs_count_set(d), line_count(d, k), k > 900.
cs_over(d, 3000) :- cs_metric_doc(d, _), !cs_count_set(d), line_count(d, k), k > 3000.
cs_over(d, 6000) :- cs_metric_doc(d, _), !cs_count_set(d), line_count(d, k), k > 6000.

// ---- top, last_classes, bases, methods -----------------------------------------------------------------------
// cs_top(d, n, kind, name): a module-level def or class.
.decl cs_top(d: number, n: node, k: symbol, name: symbol)
cs_top(d, n, k, s) :- node(d, m, "module", _, _), child(m, n, _), cs_def(n, k, s).
cs_top(d, n, k, s) :- node(d, m, "module", _, _), child(m, dd, _), node(_, dd, "decorated_definition", _, _),
    field(dd, "definition", n), cs_def(n, k, s).
.decl cs_def(n: node, k: symbol, name: symbol)
cs_def(n, "class", s) :- node(_, n, "class_definition", _, _), field(n, "name", x), text(x, s).
cs_def(n, "def", s) :- node(_, n, "function_definition", _, _), field(n, "name", x), text(x, s).
.decl cs_top_start(d: number, k: symbol, name: symbol, st: number)
cs_top_start(d, k, s, st) :- cs_top(d, n, k, s), node(_, n, _, st, _).
// last_classes, by the entry's mode: no later (last), no earlier (first) module-level class of the same name, or every.
.decl cs_last_class(d: number, c: node, name: symbol)
cs_last_class(d, c, s) :- cs_class_mode("last"), cs_top(d, c, "class", s), node(_, c, _, st, _), st = max t : { cs_top_start(d, "class", s, t) }.
cs_last_class(d, c, s) :- cs_class_mode("first"), cs_top(d, c, "class", s), node(_, c, _, st, _), st = min t : { cs_top_start(d, "class", s, t) }.
cs_last_class(d, c, s) :- cs_class_mode("every"), cs_top(d, c, "class", s).
// The first module-level class of a name (CSB030's lifecycle entry).
.decl cs_first_class(d: number, c: node, name: symbol)
cs_first_class(d, c, s) :- cs_top(d, c, "class", s), node(_, c, _, st, _), st = min t : { cs_top_start(d, "class", s, t) }.
// bases: positional superclass arguments, parentheses dropped; `bases` those that are a Name or an Attribute.
.decl cs_base_slot(c: node, b: node)
cs_base_slot(c, b) :- node(_, c, "class_definition", _, _), field(c, "superclasses", al), child(al, b, _),
    !node(_, b, "keyword_argument", _, _), !node(_, b, "dictionary_splat", _, _), !node(_, b, "comment", _, _).
cs_base_slot(c, x) :- cs_base_slot(c, b), node(_, b, "parenthesized_expression", _, _), child(b, x, _), !node(_, x, "comment", _, _).
.decl cs_all_base(c: node, b: node)
cs_all_base(c, b) :- cs_base_slot(c, b), !node(_, b, "parenthesized_expression", _, _).
.decl cs_base(c: node, b: node, name: symbol)
cs_base(c, b, s) :- cs_base_slot(c, b), node(_, b, "identifier", _, _), text(b, s).
cs_base(c, b, s) :- cs_base_slot(c, b), node(_, b, "attribute", _, _), field(b, "attribute", x), text(x, s).
// methods: every def in a class's body, bare or decorated; struct_methods: the methods of a last class.
.decl cs_class_method(c: node, m: node, mn: symbol)
cs_class_method(c, m, mn) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, m, _), cs_def(m, "def", mn).
cs_class_method(c, m, mn) :- node(_, c, "class_definition", _, _), field(c, "body", b), child(b, dd, _),
    node(_, dd, "decorated_definition", _, _), field(dd, "definition", m), cs_def(m, "def", mn).
.decl cs_method(d: number, c: node, cn: symbol, m: node, mn: symbol)
cs_method(d, c, cn, m, mn) :- cs_last_class(d, c, cn), cs_class_method(c, m, mn).
.decl cs_method_start(c: node, mn: symbol, st: number)
cs_method_start(c, mn, st) :- cs_class_method(c, m, mn), node(_, m, _, st, _).

// ---- m's subtree: the def's descendants and its decorators' ------------------------------------------------------
.decl cs_fdef(kind: symbol)
cs_fdef("function_definition").
.decl cs_decorator_kind(kind: symbol)
cs_decorator_kind("decorator").
.decl cs_in_method(x: node, m: node)
cs_in_method(x, m) :- cs_method(_, _, _, m, _), inside(x, m, cs_fdef), node(_, x, _, _, _).
cs_in_method(x, m) :- cs_method(_, _, _, m, _), node(_, dd, "decorated_definition", _, _), field(dd, "definition", m),
    child(dd, dc, _), node(_, dc, "decorator", _, _), inside(x, dc, cs_decorator_kind), node(_, x, _, _, _).

// ---- self_connect: a call of self.connect / self.connect_async in the method's subtree ---------------------------
.decl cs_func(c: node, f: node)
cs_func(c, f) :- node(_, c, "call", _, _), field(c, "function", f).
cs_func(c, x) :- cs_func(c, f), node(_, f, "parenthesized_expression", _, _), child(f, x, _), !node(_, x, "comment", _, _).
.decl cs_receiver(o: node, r: node)
cs_receiver(o, o) :- cs_func(_, f), node(_, f, "attribute", _, _), field(f, "object", o).
cs_receiver(o, x) :- cs_receiver(o, p), node(_, p, "parenthesized_expression", _, _), child(p, x, _), !node(_, x, "comment", _, _).
.decl cs_self_connect_call(c: node)
cs_self_connect_call(c) :- cs_func(c, f), node(_, f, "attribute", _, _), field(f, "attribute", a), text(a, s),
    (s = "connect" ; s = "connect_async"), field(f, "object", o), cs_receiver(o, r), node(_, r, "identifier", _, _), text(r, "self").
.decl cs_self_connect(m: node)
cs_self_connect(m) :- cs_self_connect_call(c), cs_in_method(c, m).

// ---- sync_targets: self._conn/_cursor/_introspector/_validator assigned inside a method -------------------------
.decl cs_assign_kind(kind: symbol)
cs_assign_kind("assignment"). cs_assign_kind("augmented_assignment").
.decl cs_target(m: node, t: node)
cs_target(m, t) :- cs_method(_, _, _, m, _), node(_, a, k, _, _), cs_assign_kind(k), inside(a, m, cs_fdef), field(a, "left", t).
cs_target(m, e) :- cs_target(m, t), node(_, t, k, _, _), cs_sequence(k), child(t, e, _), !node(_, e, "comment", _, _).
.decl cs_sequence(kind: symbol)
cs_sequence("pattern_list"). cs_sequence("tuple_pattern"). cs_sequence("list_pattern").
.decl cs_sync_target(m: node)
cs_sync_target(m) :- cs_target(m, t), node(_, t, "attribute", _, _), field(t, "object", o), node(_, o, "identifier", _, _),
    text(o, "self"), field(t, "attribute", x), text(x, s),
    (s = "_conn" ; s = "_cursor" ; s = "_introspector" ; s = "_validator").

// ---- name lists ------------------------------------------------------------------------------------------------
.decl cs_residual(s: symbol)
cs_residual("AsyncSchemaBootstrapEvidence"). cs_residual("AsyncTableExistsAuthority"). cs_residual("ReadPlanWorkflow").
cs_residual("SchemaBootstrapEvidence"). cs_residual("SingleIntentPlanWorkflow"). cs_residual("WritePlanWorkflow").
cs_residual("_ConnectionMetadataMixin"). cs_residual("_PlanScopeFetchToken"). cs_residual("_plan_scope_fetch_template").
cs_residual("_resolve_bootstrap_scope_exists_in_schema_transaction_lazy"). cs_residual("_resolve_plan_scope_fetch_template").
cs_residual("execute_read_plan_workflow"). cs_residual("execute_read_plan_workflow_async").
cs_residual("execute_single_intent_plan_workflow"). cs_residual("execute_single_intent_plan_workflow_async").
cs_residual("execute_write_plan_workflow"). cs_residual("execute_write_plan_workflow_async").
.decl cs_sql_residual(s: symbol)
cs_sql_residual("AttributedSqlRenderable"). cs_sql_residual("ContentStoreManifest"). cs_sql_residual("PreparedTerminalExecution").
cs_sql_residual("_DirectGrammarExecutionPlan"). cs_sql_residual("_DirectGrammarExecutionRequest").
cs_sql_residual("_LargeColumnHydrationRuntimeStep"). cs_sql_residual("_PolymorphicCheckReconciliationPlan").
cs_sql_residual("_PolymorphicRegistryBootstrapRead"). cs_sql_residual("_SchemaDdlTransaction"). cs_sql_residual("_SqlDirectLazyContext").
cs_sql_residual("_annotation_is_nullable"). cs_sql_residual("_model_field_nullable"). cs_sql_residual("_sql_types_compatible").
cs_sql_residual("_sqlcoresupport__flush_polymorphic_metadata_batch_lazy"). cs_sql_residual("_sqlcoresupport__schema_ensure_model_table_lazy").
cs_sql_residual("_sqlcoresupport_ensure_polymorphic_columns_exist_lazy"). cs_sql_residual("_sqlexecution__replay_cached_schema_ddl_effects_lazy").
.decl cs_mixin(s: symbol)
cs_mixin("_MariaDBCoreSupportMixin"). cs_mixin("_MariaDBExecutionSupportMixin"). cs_mixin("_MariaDBLifecycleExecutionMixin").
cs_mixin("_MariaDBMetadataSchemaMixin"). cs_mixin("_MariaDBVersioningMixin"). cs_mixin("_PostgresBootstrapFeatureMixin").
cs_mixin("_PostgresCoreSupportMixin"). cs_mixin("_PostgresExecutionSupportMixin"). cs_mixin("_PostgresLargeColumnMixin").
cs_mixin("_PostgresLifecycleExecutionMixin"). cs_mixin("_PostgresMetadataSchemaMixin"). cs_mixin("_PostgresVersioningMixin").
cs_mixin("_SqliteCoreSupportMixin"). cs_mixin("_SqliteExecutionSupportMixin"). cs_mixin("_SqliteInstrumentationSupportMixin").
cs_mixin("_SqliteLargeColumnMixin"). cs_mixin("_SqliteLifecycleExecutionMixin"). cs_mixin("_SqliteMetadataSchemaMixin").
cs_mixin("_SqliteVersioningMixin").
.decl cs_good_base(s: symbol)
cs_good_base("ConnectionPayloadOpaqueMarker"). cs_good_base("_ConnectionStateCore"). cs_good_base("_LazyConnectionBase").
.decl cs_lifecycle_method(s: symbol)
cs_lifecycle_method("__aenter__"). cs_lifecycle_method("__aexit__"). cs_lifecycle_method("__enter__"). cs_lifecycle_method("__exit__").
.decl cs_connect_method(s: symbol)
cs_connect_method("connect"). cs_connect_method("connect_async"). cs_connect_method("ensure_connected_async"). cs_connect_method("ensure_connected_sync").
// A backend connection class: name ends with Connection or ConnectionCore.
.decl cs_backend_class(s: symbol)
cs_backend_class(s) :- cs_method(_, _, s, _, _), suffix("Connection", s).
cs_backend_class(s) :- cs_method(_, _, s, _, _), suffix("ConnectionCore", s).

// CSB030's file: the lifecycle role's when the scope has it as a Python module (valid or not), else the connection
// role's.
.decl cs_present(p: symbol)
cs_present(p) :- cs_doc(d, p), node(d, _, "module", _, _).
.decl cs_lifecycle_file(p: symbol)
cs_lifecycle_file(p) :- cs_role("lifecycle", p), cs_present(p).
cs_lifecycle_file(p) :- cs_role("connection", p), cs_role("lifecycle", q), !cs_present(q).
// CSB030's methods: for the lifecycle entry the first method of the name in the first `_ConnectionLifecycleMixin`
// class; else every struct method.
.decl cs_lifecycle_method_ok(d: number, m: node)
cs_lifecycle_method_ok(d, m) :- cs_entry("_lifecycle_violations"), cs_first_class(d, c, "_ConnectionLifecycleMixin"),
    cs_method(d, c, _, m, mn), node(_, m, _, st, _), st = min t : { cs_method_start(c, mn, t) }.
cs_lifecycle_method_ok(d, m) :- cs_entry(e), e != "_lifecycle_violations", cs_method(d, _, _, m, _).

// ---- the final query's branches: (document, issue, line) -------------------------------------------------------
.decl cs_hit(d: number, issue: symbol, l: number)
cs_hit(d, "CSB001", 1) :- cs_role("connection", p), cs_valid(d, p), cs_over(d, 900).
cs_hit(d, "CSB010", 1) :- cs_role("sql", p), cs_valid(d, p), cs_over(d, 6000).
cs_hit(d, "CSB020", 1) :- cs_valid(d, p), cs_big_backend(p), cs_over(d, 3000).
cs_hit(d, "CSB002", l) :- cs_role("connection", p), cs_valid(d, p), cs_top(d, n, _, s), cs_residual(s), line(n, l).
cs_hit(d, "CSB012", l) :- cs_role("sql", p), cs_valid(d, p), cs_top(d, n, _, s), cs_sql_residual(s), line(n, l).
cs_hit(d, "CSB021", l) :- cs_valid(d, p), cs_big_backend(p), cs_top(d, n, _, s), cs_mixin(s), line(n, l).
cs_hit(d, "CSB003", l) :- cs_role("connection", p), cs_valid(d, p), cs_last_class(d, c, "_DatabaseConnectionCore"),
    cs_base(c, _, s), !cs_good_base(s), line(c, l).
cs_hit(d, "CSB011", 1) :- cs_role("sql", p), cs_valid(d, p), k = count : { cs_top(d, _, _, _) }, k > 90.
cs_hit(d, "CSB013", l) :- cs_role("sql", p), cs_valid(d, p), cs_last_class(d, c, "_SqlConnectionCore"),
    cs_entry(e), e != "_sql_connection_violations", k = count : { cs_base(c, _, _) }, k > 6, line(c, l).
cs_hit(d, "CSB013", l) :- cs_role("sql", p), cs_valid(d, p), cs_last_class(d, c, "_SqlConnectionCore"),
    cs_entry("_sql_connection_violations"), k = count : { cs_all_base(c, _) }, k > 6, line(c, l).
cs_hit(d, "CSB030", l) :- cs_lifecycle_file(p), cs_valid(d, p), cs_method(d, _, "_ConnectionLifecycleMixin", m, mn),
    (mn = "__enter__" ; mn = "__aenter__"), cs_lifecycle_method_ok(d, m), cs_self_connect(m), line(m, l).
cs_hit(d, "CSB031", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, mn), cs_backend_class(cn), cs_lifecycle_method(mn), line(m, l).
cs_hit(d, "CSB032", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, "connect_async"), cs_backend_class(cn),
    cs_sync_target(m), line(m, l).
cs_hit(d, "CSB033", l) :- cs_valid(d, p), cs_backend(p), cs_method(d, _, cn, m, mn), cs_backend_class(cn), !cs_connect_method(mn),
    cs_self_connect(m), line(m, l).

// The entry's case: its issues, or every issue for an entry no case names.
violation("data-layer-connection-structural-boundaries", "connection-structure", code, p, l) :- cs_hit(d, code, l),
    cs_entry(e), !cs_entry_case(e), doc(d, p, _).
violation("data-layer-connection-structural-boundaries", "connection-structure", code, p, l) :- cs_hit(d, code, l),
    cs_entry(e), cs_entry_issue(e, code), doc(d, p, _).
