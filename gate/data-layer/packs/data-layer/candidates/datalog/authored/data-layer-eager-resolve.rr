// data-layer-eager-resolve: the relational clause `eager-resolution`, by hand (decision 0043). The policy is
// packs/data-layer/rules/data-layer-eager-resolve.json. Its SQL stages run per file (`partitionBy: file`) over the
// `nodes` syntax table (named nodes less comments, string_start/content/end, escape sequences and line
// continuations; `text` a node's exact text, here node_text; `ordinal` the index among those siblings, here
// child's index) and `ownership` (a node's nearest-or-self function_definition `fn` and class_definition `cls`,
// here `nearest`). Every join below is within one document. Each relation is named after the stage it ports.
//
// Options as the run resolves them (`option_value`, `option_item`): entryPoint selects the final query's case
// (any value but the five cases, the default `_scan_source` included, is the default query, every family);
// externalIoBoundaries, where it has items, is the approved symbols, else the signed allowlist.
//
// Notes against W:
// - approved_external, externalIoBoundaries null: the signed allowlist's 34 symbols, each kept where its
//   signature verifies (@ed25519_ok over W's canonical message), as W's verify_ed25519 filter.
// - externalIoBoundaries `[]` (no symbol) gives no option fact (option_item has no item, option_json no leaf,
//   option_value no array), as null does, so it reads as null here (W: no approved symbol). GAP: needs a converter
//   fact for an empty array option. No recorded event configures `[]`.
// - raw_strings (`strings`): a string's (or a concatenation's) decoded value is `value` (W's `substring` with
//   `value: true`); one W cannot decode (an interpolation) has no row, as its NULL joins nothing in the SQL.
// - source_lines: the module regex's `LINE` captures, as match_group gives them over the file's source (a
//   capture may cross a line where `\s*` takes a newline), at the tape line W reports. The module's text starts
//   at its first token; the lines before it are blank or comments, which give no direct site either way.
// - function_info's and the multi-line strings' line ranges are `line`..`end_line` (the tape's lines); the SQL
//   counts `\n` in the text: the two differ only where the text holds a lone `\r`.
// - display_values (pythonAst unparse) gives the finding's text only; it has a row for every display root of a
//   file that parses, so it is not read.

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl node_text(n: node, s: symbol)
.decl value(n: node, v: symbol)
.decl op(n: node, s: symbol)
.decl line(n: loc, l: number)
.decl end_line(n: loc, l: number)
.decl text(n: loc, s: symbol)
.decl source(d: number, sp: span)
.decl syntax_error(d: number)
.decl in_scope(d: number)
.decl out_scope(d: number)
.decl option_value(name: symbol, v: symbol)
.decl option_item(name: symbol, i: number, v: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.output violation

// ---- kind sets ----
.decl eager_fdef(kind: symbol)
eager_fdef("function_definition").
.decl eager_cdef(kind: symbol)
eager_cdef("class_definition").
.decl eager_defs(kind: symbol)
eager_defs("function_definition").
eager_defs("class_definition").
.decl eager_lambda_set(kind: symbol)
eager_lambda_set("lambda").
.decl eager_region_set(kind: symbol)
eager_region_set("lambda").
eager_region_set("class_definition").
.decl eager_call_set(kind: symbol)
eager_call_set("call").

// ---- the file: its dotted module as the SQL spells it (`a/__init__.py` is `a.__init__`) ----
.decl eager_modname(d: number, m: symbol)
eager_modname(d, m) :- doc(d, p, m), !suffix("/__init__.py", p).
eager_modname(d, x) :- doc(d, p, m), suffix("/__init__.py", p), x = cat(m, ".__init__").
// serverplan: the path under one of the server-plan packages.
.decl eager_serverplan(d: number)
eager_serverplan(d) :- doc(d, p, _),
  (prefix("impl/common/l2070_server_plan/", p) ; prefix("impl/common/l7300_sql_versioned_transactions/", p) ;
   prefix("l2050_transaction/", p) ; prefix("l2055_lazy_result/", p) ; prefix("l2070_batching/", p) ;
   prefix("l5100_fts/", p) ; prefix("l5200_vector_index/", p) ; prefix("l7200_versioned_transactions/", p)).
// The test paths the transitive and direct families leave out.
.decl eager_test_path(d: number)
eager_test_path(d) :- doc(d, p, _), match("(?:conform/|(?:.*/)?(?:tests|test_[^/]*)/).*", p).
eager_test_path(d) :- doc(d, p, _), match("(?:.*/)?test_[^/]*", p).

// ---- declarations, declaration_links, declaration_contexts, function_info ----
.decl eager_decl(n: node, name: symbol)
eager_decl(n, nm) :- node(_, n, "function_definition", _, _), field(n, "name", x), node_text(x, nm).
eager_decl(n, nm) :- node(_, n, "class_definition", _, _), field(n, "name", x), node_text(x, nm).
// lexical_parent: the nearest enclosing function or class.
.decl eager_lex(n: node, p: node)
eager_lex(n, p) :- eager_decl(n, _), nearest(n, p, eager_defs).
.decl eager_has_lex(n: node)
eager_has_lex(n) :- eager_lex(n, _).
.decl eager_qual(n: node, q: symbol)
eager_qual(n, q) :- eager_decl(n, q), !eager_has_lex(n).
eager_qual(n, q) :- eager_lex(n, p), eager_qual(p, q0), eager_decl(n, nm), q = cat(cat(q0, "."), nm).
// The qualname's dots.
.decl eager_depth(n: node, k: number)
eager_depth(n, 0) :- eager_decl(n, _), !eager_has_lex(n).
eager_depth(n, k) :- eager_lex(n, p), eager_depth(p, j), k = j + 1.
.decl eager_func(f: node, name: symbol)
eager_func(f, nm) :- node(_, f, "function_definition", _, _), eager_decl(f, nm).
.decl eager_symbol(f: node, s: symbol)
eager_symbol(f, s) :- eager_func(f, _), eager_qual(f, q), node(d, f, _, _, _), eager_modname(d, m), s = cat(cat(m, "."), q).
.decl eager_async(f: node)
eager_async(f) :- eager_func(f, _), op(f, "async").
.decl eager_body(f: node, bs: number, be: number)
eager_body(f, bs, be) :- eager_func(f, _), field(f, "body", b), node(_, b, _, bs, be).

// ---- calls, attributes, body_calls, body_attributes, empty_calls ----
.decl eager_call_attr(c: node)
eager_call_attr(c) :- node(_, c, "call", _, _), field(c, "function", g), node(_, g, "attribute", _, _).
.decl eager_call_ident(c: node)
eager_call_ident(c) :- node(_, c, "call", _, _), field(c, "function", g), node(_, g, "identifier", _, _).
.decl eager_attr(a: node, attr: symbol)
eager_attr(a, s) :- node(_, a, "attribute", _, _), field(a, "attribute", x), node_text(x, s).
// callee: an attribute callee's attribute, else the callee's text; full_callee: the callee's text.
.decl eager_callee(c: node, s: symbol)
eager_callee(c, s) :- eager_call_attr(c), field(c, "function", g), eager_attr(g, s).
eager_callee(c, s) :- node(_, c, "call", _, _), field(c, "function", g), !node(_, g, "attribute", _, _), node_text(g, s).
.decl eager_full(c: node, s: symbol)
eager_full(c, s) :- node(_, c, "call", _, _), field(c, "function", g), node_text(g, s).
// receiver: an attribute callee's object.
.decl eager_recv(c: node, r: node)
eager_recv(c, r) :- eager_call_attr(c), field(c, "function", g), field(g, "object", r).
.decl eager_recv_self(c: node)
eager_recv_self(c) :- eager_recv(c, r), node(_, r, "identifier", _, _), node_text(r, "self").
// A class definition between the call and its function (the SQL's `o.cls IS f.function_cls` fails).
.decl eager_cls_between(n: node, f: node)
eager_cls_between(n, f) :- nearest(n, f, eager_fdef), nearest(n, k, eager_cdef), inside(k, f, eager_fdef).
.decl eager_bcall(c: node, f: node)
eager_bcall(c, f) :- node(_, c, "call", cs, ce), nearest(c, f, eager_fdef), eager_body(f, bs, be), cs >= bs, ce <= be,
  !eager_cls_between(c, f), !inside(c, _, eager_lambda_set).
// body_attributes: no lambda or class between the attribute and its function's body.
.decl eager_battr(a: node, f: node)
eager_battr(a, f) :- node(_, a, "attribute", as, ae), nearest(a, f, eager_fdef), eager_body(f, bs, be), as >= bs, ae <= be,
  !eager_battr_region(a, bs).
.decl eager_battr_region(a: node, bs: number)
eager_battr_region(a, bs) :- node(_, a, "attribute", _, _), nearest(a, f, eager_fdef), eager_body(f, bs, _),
  inside(a, l, eager_region_set), node(_, l, _, ls, _), ls > bs.
.decl eager_empty(c: node, f: node)
eager_empty(c, f) :- eager_bcall(c, f), field(c, "arguments", g), !child(g, _, _).

// ---- arguments, keywords ----
.decl eager_nonpos(a: node)
eager_nonpos(a) :- node(_, a, "keyword_argument", _, _).
eager_nonpos(a) :- node(_, a, "list_splat", _, _).
eager_nonpos(a) :- node(_, a, "dictionary_splat", _, _).
.decl eager_argc(c: node, a: node, i: number)
eager_argc(c, a, i) :- node(_, c, "call", _, _), field(c, "arguments", g), node(_, g, "argument_list", _, _),
  child(g, a, i), !eager_nonpos(a).
.decl eager_arg(c: node, a: node, pos: number)
eager_arg(c, a, p) :- eager_argc(c, a, i), p = count : { eager_arg_before(c, i, _) }.
// eager_arg_before(c, i, j): a positional argument of c at child index j before index i.
.decl eager_arg_before(c: node, i: number, j: number)
eager_arg_before(c, i, j) :- eager_argc(c, _, i), eager_argc(c, _, j), j < i.
eager_arg(c, g, 0) :- node(_, c, "call", _, _), field(c, "arguments", g), node(_, g, "generator_expression", _, _).
.decl eager_kw(c: node, name: symbol, v: node)
eager_kw(c, nm, v) :- node(_, c, "call", _, _), field(c, "arguments", g), child(g, k, _), node(_, k, "keyword_argument", _, _),
  field(k, "name", x), node_text(x, nm), field(k, "value", v).

// ---- raw_strings, strings: a string argument (joined by start, as the SQL does) and its value ----
.decl eager_getattr_call(c: node)
eager_getattr_call(c) :- eager_call_ident(c), field(c, "function", g), node_text(g, s), (s = "getattr" ; s = "hasattr").
eager_getattr_call(c) :- eager_call_attr(c), eager_callee(c, s), (s = "__getattribute__" ; s = "getattr_static").
// raw_strings: a string or a concatenation whose text starts `(?i)^[ru]*["']`, inside such a call (at any depth)
// or a subscript's child; its value decoded (`value`).
.decl eager_string_kind(s: node)
eager_string_kind(s) :- node(_, s, "string", _, _).
eager_string_kind(s) :- node(_, s, "concatenated_string", _, _).
.decl eager_raw_string(s: node)
eager_raw_string(s) :- eager_string_kind(s), node_text(s, t), match("(?is)[ru]*[\"'].*", t).
.decl eager_string(s: node, v: symbol)
eager_string(s, v) :- eager_raw_string(s), value(s, v), inside(s, c, eager_call_set), eager_getattr_call(c).
eager_string(s, v) :- eager_raw_string(s), value(s, v), child(p, s, _), node(_, p, "subscript", _, _).
// A node of the file starting where such a string does.
.decl eager_str_at(x: node, v: symbol)
eager_str_at(x, v) :- eager_string(s, v), node(d, s, _, st, _), node(d, x, _, st, _).

// ---- assignments, bound_names ----
.decl eager_asg(a: node, t: node)
eager_asg(a, t) :- node(_, a, "assignment", _, _), field(a, "left", t).
.decl eager_asg_fn(a: node, f: node)
eager_asg_fn(a, f) :- eager_asg(a, _), nearest(a, f, eager_fdef).
.decl eager_asg_module(a: node)
eager_asg_module(a) :- eager_asg(a, _), !inside(a, _, eager_fdef).
// An identifier target's text.
.decl eager_asg_name(a: node, s: symbol)
eager_asg_name(a, s) :- eager_asg(a, t), node(_, t, "identifier", _, _), node_text(t, s).
.decl eager_bound(a: node, n: node)
eager_bound(a, t) :- eager_asg(a, t).
eager_bound(a, n) :- eager_bound(a, m), eager_bound_seq(m), child(m, n, _).
.decl eager_bound_seq(m: node)
eager_bound_seq(m) :- node(_, m, "tuple", _, _).
eager_bound_seq(m) :- node(_, m, "list", _, _).
eager_bound_seq(m) :- node(_, m, "pattern_list", _, _).
eager_bound_seq(m) :- node(_, m, "tuple_pattern", _, _).
eager_bound_seq(m) :- node(_, m, "list_pattern", _, _).

// ---- parameters, typed_parameters; annotations' identifiers ----
.decl eager_param_kind(p: node)
eager_param_kind(p) :- node(_, p, "identifier", _, _).
eager_param_kind(p) :- node(_, p, "typed_parameter", _, _).
eager_param_kind(p) :- node(_, p, "default_parameter", _, _).
eager_param_kind(p) :- node(_, p, "typed_default_parameter", _, _).
.decl eager_param0(f: node, p: node, i: number, nm: symbol)
eager_param0(f, p, i, nm) :- eager_func(f, _), field(f, "parameters", ps), child(ps, p, i), node(_, p, "identifier", _, _),
  node_text(p, nm).
eager_param0(f, p, i, nm) :- eager_func(f, _), field(f, "parameters", ps), child(ps, p, i), eager_param_kind(p),
  !node(_, p, "identifier", _, _), child(p, x, 0), node(_, x, "identifier", _, _), node_text(x, nm).
.decl eager_param(f: node, nm: symbol, pos: number, p: node)
eager_param(f, nm, pos, p) :- eager_param0(f, p, i, nm), pos = count : { eager_param_before(f, i, _) }.
.decl eager_param_before(f: node, i: number, j: number)
eager_param_before(f, i, j) :- eager_param0(f, _, i, _), eager_param0(f, _, j, _), j < i.
// An annotation (a parameter's or an assignment's) and the nodes in it, itself included.
.decl eager_ann(a: node, x: node)
eager_ann(t, t) :- eager_param(_, _, _, p), field(p, "type", t).
eager_ann(t, t) :- eager_asg(a, _), field(a, "type", t).
eager_ann(t, y) :- eager_ann(t, x), child(x, y, _).
.decl eager_ann_name(t: node, s: symbol)
eager_ann_name(t, s) :- eager_ann(t, x), node(_, x, "identifier", _, _), node_text(x, s).
.decl eager_typed(f: node, nm: symbol, ty: symbol)
eager_typed(f, nm, ty) :- eager_param(f, nm, _, p), field(p, "type", t), eager_ann_name(t, ty).

// ---- decorator_names ----
.decl eager_dwalk(f: node, x: node)
eager_dwalk(f, x) :- eager_decl(f, _), child(w, f, _), node(_, w, "decorated_definition", _, _), child(w, dd, _),
  node(_, dd, "decorator", _, _), child(dd, x, _).
eager_dwalk(f, g) :- eager_dwalk(f, c), node(_, c, "call", _, _), field(c, "function", g).
.decl eager_decorator(f: node, nm: symbol)
eager_decorator(f, nm) :- eager_dwalk(f, x), node(_, x, "identifier", _, _), node_text(x, nm).
eager_decorator(f, nm) :- eager_dwalk(f, x), eager_attr(x, nm).
.decl eager_external_io(f: node)
eager_external_io(f) :- eager_func(f, _), eager_decorator(f, "external_io_boundary_eager_async").

// ---- approved_external: externalIoBoundaries' symbols where it has items, else (null) the signed allowlist ----
// W keeps a signed entry only where verify_ed25519 passes on json_object('allowlist', json_array(symbol), 'linter',
// 'lint_eager_resolve:external_io_boundary', 'version', 1), SQLite's compact form, the signature taken as it is.
.decl eager_approved_configured(x: number)
eager_approved_configured(1) :- option_item("externalIoBoundaries", _, _).
.decl eager_approved(s: symbol)
eager_approved(s) :- option_item("externalIoBoundaries", _, s).
eager_approved(s) :- eager_signed(s, sig), !eager_approved_configured(1),
  m = cat("{\"allowlist\":[", cat(@json_str(s), "],\"linter\":\"lint_eager_resolve:external_io_boundary\",\"version\":1}")),
  @ed25519_ok("7e9776d87292ab633115bd6c07892a4bf56450fffb2dfcf13b3eba1866b9fbb6", m, sig) = 1.
.decl eager_signed(s: symbol, sig: symbol)
eager_signed("l6500_evidence.blob_migration.migrate_blob_to_external", "SxVBqPVb9KxkaYdUj/l97y+Rpx7uyR7kQrlNMnCxmlqEV6rWn7k1TawVXskANwmi3z6K8A1oKmVitQVRo0V/DQ==").
eager_signed("l6500_evidence.blob_migration.migrate_blob_to_external_async", "ZijivhYt9hPMIzRAPBVZdFUirXyY5rVlqQPN62XQ3E+/FaJTlZp8M/HKsboWYvnWeJNlW7IS/Wcpet8+4csxBw==").
eager_signed("l6500_evidence.blob_migration.migrate_blob_to_internal", "x2BpGG1GHDMP8Nm+VzYXI9uk1t7r4H6dmchXWRsHO43fwxw/ViwXHrldNzfUR+ujYpzXXlXSyiE+sawIOHKYAQ==").
eager_signed("l6500_evidence.blob_migration.migrate_blob_to_internal_async", "FFyel3rEwEppb6RV378cyla4xTjPIpUeU9hFWWWdnfOOcHqR3kRtrKQEU+mB0HhylaalrNW8BjRalknjOgViDA==").
