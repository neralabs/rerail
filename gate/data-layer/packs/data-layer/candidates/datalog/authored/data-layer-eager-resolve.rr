eager_signed("l6500_evidence.blob_migration.migrate_blobs_batch_async", "9PdwDGHbMp4SvHIODp0Ue/HfA+qGwocDtzqVXUbBIFdIunB/kFpNvI1Fg8y6btjOj7BNFWvRDgZx2iQqHAyyCw==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.reencrypt_blob", "8PbZXPairL4eX0ShonEI9QRzz2NDxjJjv71ezKEqMJEDjgDsj0FOqIeX9jlCEdrhmekub3IAIm+0mY3adx7MCg==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.reencrypt_blob_async", "dXES+mySa6cTtDJRLdXjyEcKcMQ9aHoWUjaDJQDWpyCRQ4sFZWTewv5GoTGPTmXt5MAf27ODB01JHGYiYyddCQ==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.reencrypt_blobs_by_key", "OAQRMC57tWGD3TVnK7c4SoNMzWGBuXAVWaAoG9gKBwUxQo3WZIWo2QdW9SEKWAZF8NUmug2aoUayE/oWptigCg==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.reencrypt_blobs_by_key_async", "bFwGkxEX8VWMjn9TK3U7gTz6CxLLT3Oen+PCfxzk0bJfvQkxJtgey7fP2G3AFeXuDqcl9kJlwGa+z1XcO/jHDg==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.retrieve_blob", "8bedG9GYmwKQurZvg8xkGsvSyqK6rtK2FNtDVsEHw5DIxRH8kjjWGACD198QfvZlPUlOvzNKzoaC3E7/pTOmBg==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.retrieve_blob_async", "Sps4LNefn4qNGle93W+WSj2Db/gu9KdlFmVrJ8dGM9MDGY2dQQRYWIJRLfNLgyQO4zJ8LxhXoMGQYTRf/aiGDg==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.store_blob", "iaaqVCxgFsPXe7hjci5k9m5wwxajavmOLqpnB8atS/rXZCfMbKH5V4CNTq+pqNv5JetiHsMIxFy+EmRCRQKqAg==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.store_blob_async", "0xre2ed+OMC+n+zyS2l/WwF7szoPTUdkLS9n9plkSPFs3POuusXTiwIk/bhJoQDmOfDhVHnfMXlYhsi1P3N8Cw==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.update_blob", "95XWP+nq9n+Wh8a2FyjcotT6aMUq/v/5syUgjh7IZTRNek9pmvgX/V+oPeJP5t5xwD1ikDQKyuzpIVIeKECkDg==").
eager_signed("l6500_evidence.blob_service.EncryptedBlobService.update_blob_async", "bzrXSkqU9391El5po6H4F57AAplUb5l0whRLYZIEQrViMA84TVzsfyHL+9+q1nOGRpvQoDcJzk/1bOdEfciDAA==").
eager_signed("l6500_evidence.sas_http.handle_sas_download", "N/erEChqtYJafCH8ZlIn3YHQb69WLbiXkbSj1yyyCndkxJNcHOlsybGyK3r6MK0D94Fn5wrlY1OfhSQxzINGBw==").
eager_signed("l6500_evidence.sas_http.handle_sas_download_async", "beXjaIVGVQ+YeffcQexHq2m1k5G9qx7Az+TE8LwXZU3YUkCe3LIaXnhfegL1fWPF6S+ag984muFlG3vaOV6SDg==").
eager_signed("l6500_evidence.sas_service.SasUrlService.generate_sas_url_for_blob", "wh78V3IwKiUjGA+MLGRQ+OtusQzuJxr18qxjSYKv64vKLWod6YTv8JL6Q95bk4X3gaF1fmDxvoSBKagj3+NwAA==").
eager_signed("l6500_evidence.sas_service.SasUrlService.generate_sas_url_for_blob_async", "kbzUVWiTCLB0ZI/HAHlA64ICBS60eFyh45dYJiL7BKHBAOAxoMgRq6DqEfTEMDgWDNXrEr+jgkR13/p547LhBg==").
eager_signed("l6500_evidence.sas_service.SasUrlService.generate_token_for_blob", "IIUH3stpPr/HdGlUXMGhht8nSmVE5okrXKrYIecNKEqLZ1CJn3I0nc/treF0/fZ7rgx8Jw8+LJYjxoH5VDRjAg==").
eager_signed("l6500_evidence.sas_service.SasUrlService.generate_token_for_blob_async", "BMjtTQxGUyK0FTnSrdt3Lr41/HIZGf8rH1OYF0IhJNocU6zQfVTXUyv8hp6VfPuuD/5PZ2Z3Zta5Fyig22EgAg==").
eager_signed("l6500_evidence.sas_service.SasUrlService.issue_tracked_token_for_blob", "GQSgzK6hQ/rZIhOSroWjZCpH6yQBWmC0dspVZNZWWlyyG6JKEITgHwVz8nfF7Y0aTQVTBAKdywhhJYZdAngRBA==").
eager_signed("l6500_evidence.sas_service.SasUrlService.issue_tracked_token_for_blob_async", "3W/o1vc9dJsEY56KMth/UfpzDr4f/pq3/ioP9zQKx+TMos9knFH88meh9VU/3ZsRj9vRXJryOayYjTZMq2tGBw==").
eager_signed("l6500_evidence.sas_service.SasUrlService.resolve_access", "X1dLOHxDnX3PwdTArn8hgGes2Kpku2lsLsGOh+lFbk1A1rfqaGB/+c/zdzZiyllnhobyrpC3KIYG3yY5jqraCA==").
eager_signed("l6500_evidence.sas_service.SasUrlService.resolve_access_async", "OA6q+NrjCc2h0vzUC93gkvxs8Edr2z4cMUsisWxxt1Lg2HXcrQ5UV2AAKrgT4dwFSSaaR0r06w+aTMMCaFsvCg==").
eager_signed("l6500_evidence.sas_service.SasUrlService.resolve_and_serve", "GjQ0RwiUr6aLWiBBoxEuDZ+C3HInHoEuxgZKaIewVJ1x4wJ7hcmbTxiXd2j45PDU24K6jtmZKu+pgR/JJZP/CQ==").
eager_signed("l6500_evidence.sas_service.SasUrlService.resolve_and_serve_async", "ijb8tgNmebcvTQZg1u0j2J2ScNqiTYYZu1ebSBhgSZ59RMAauIbdLLOYOuMtUlqyQRMJpOOpU3zntUy2C2SxBg==").
eager_signed("l6500_evidence.sas_service.SasUrlService.validate_and_serve", "wYzZYNSb+CsK658aYDbgnZxQUZuFtceuOLRwguGzxC+mWoIHsC7Df1WPhx7qNNKmcIcBQhPVcVK4GEt8KfrgCw==").
eager_signed("l6500_evidence.sas_service.SasUrlService.validate_and_serve_async", "oAYmZ/jJcMb+/5kFW57Q0EC6vMEFpBub2OXFUnOiE/wgCOkXfG1ypN5uOmS8GESKj386tH5I4HWcFCpIiMRQCQ==").
eager_signed("l6530_managed_secrets.service._resolve_managed_secret_candidate", "5JjmhYeHUK7c6EFlODoRZitt7jDcBKrDYiF/gpXa7UxbGZccmLLXx77z4MUXudVqC8nrY3O6fidjqfeUQyo/AQ==").
eager_signed("l6530_managed_secrets.service.create_managed_secret_async", "NiWtDaqhmV+co/9GQP96AkgDAHPJA1dgC0jwUzJBLsiuY/moDaLKMM46sXsJNXDhhVBFv3Y/JaXRd9tT3cxNAw==").
eager_signed("l6530_managed_secrets.service.delete_managed_secret_async", "ZGPbLZxGELL3JbHbkIDaccknMm1yroIn9LPDh/QErOSwXxwKW+CVsBKoyPMN1s7Kk1UhUJbmfnb5S/6gVg1HCA==").
eager_signed("l6530_managed_secrets.service.rotate_managed_secret_async", "KW677DkqIRmanQeWsxMP9o6a4oK0EmZQmXanKf+JsE7AwjAm7B6l5STi665WSRHcYqC4ySQAiWu32N74enwmAA==").

// ---- eager_edges: `self.m()` to a sibling method, `g()` to a top-level function ----
.decl eager_edge(caller: node, target: node)
eager_edge(f, t) :- eager_bcall(c, f), eager_call_attr(c), eager_recv_self(c), eager_callee(c, nm), eager_func(t, nm),
  node(d, c, _, _, _), node(d, t, _, _, _), eager_lex(t, p), eager_lex(f, p).
eager_edge(f, t) :- eager_bcall(c, f), eager_call_ident(c), eager_callee(c, nm), eager_func(t, nm),
  node(d, c, _, _, _), node(d, t, _, _, _), !eager_has_lex(t).

// ---- phases ----
.decl eager_phase(f: node, ph: symbol)
eager_phase(f, nm) :- eager_func(f, nm), (nm = "preprocess" ; nm = "lower" ; nm = "compile").
eager_phase(t, ph) :- eager_phase(f, ph), eager_edge(f, t).

// ---- legacy_aliases, legacy_functions ----
.decl eager_legacy_name(s: symbol)
eager_legacy_name("legacy_async").
eager_legacy_name("legacy_module_async").
eager_legacy_name("legacy_module_sync").
eager_legacy_name("legacy_sync").
.decl eager_legacy_alias(d: number, s: symbol)
eager_legacy_alias(d, s) :- node(d, _, "module", _, _), eager_legacy_name(s).
eager_legacy_alias(d, s) :- node(d, n, "aliased_import", _, _), child(p, n, _), node(_, p, "import_from_statement", _, _),
  field(p, "module_name", m), node_text(m, "l2050_transaction.legacy_wrappers"), field(n, "name", x), node_text(x, nm),
  eager_legacy_name(nm), field(n, "alias", y), node_text(y, s).
eager_legacy_alias(d, s) :- eager_asg_module(a), node(d, a, _, _, _), field(a, "right", r), node(_, r, "identifier", _, _),
  node_text(r, old), eager_legacy_alias(d, old), eager_bound(a, b), node(_, b, "identifier", _, _), node_text(b, s).
.decl eager_legacy_callee(s: symbol)
eager_legacy_callee("_legacy_delegate_stub").
eager_legacy_callee("_legacy_delegate_stub_async").
eager_legacy_callee("_resolve_legacy_result_sync").
eager_legacy_callee("_resolve_legacy_result_async").
eager_legacy_callee("run_in_legacy_execution_boundary").
eager_legacy_callee("run_in_legacy_execution_boundary_async").
.decl eager_legacy_fn(f: node)
eager_legacy_fn(f) :- eager_func(f, _), eager_decorator(f, s), node(d, f, _, _, _), eager_legacy_alias(d, s).
eager_legacy_fn(f) :- eager_bcall(c, f), eager_full(c, s), eager_legacy_callee(s).

// ---- indirect_targets: getattr(self, "m"), self.__getattribute__("m"), globals()["f"] ----
.decl eager_indirect(e: node, t: node)
eager_indirect(c, t) :- eager_bcall(c, f), eager_call_ident(c), eager_callee(c, "getattr"), eager_arg(c, a0, 0),
  node(_, a0, "identifier", _, _), node_text(a0, "self"), eager_arg(c, a1, 1), eager_str_at(a1, v), eager_func(t, v),
  node(d, c, _, _, _), node(d, t, _, _, _), eager_lex(t, p), eager_lex(f, p).
eager_indirect(c, t) :- eager_bcall(c, f), eager_callee(c, "__getattribute__"), eager_recv_self(c), eager_arg(c, a0, 0),
  eager_str_at(a0, v), eager_func(t, v), node(d, c, _, _, _), node(d, t, _, _, _), eager_lex(t, p), eager_lex(f, p).
eager_indirect(n, t) :- node(d, n, "subscript", _, _), child(n, v0, 0), eager_call_ident(v0), eager_callee(v0, "globals"),
  child(n, s1, 1), eager_str_at(s1, v), eager_func(t, v), node(d, t, _, _, _), !eager_has_lex(t).

// ---- legacy_calls ----
.decl eager_legacy_call(f: node, t: node, nm: symbol)
eager_legacy_call(f, t, nm) :- eager_bcall(c, f), eager_edge(f, t), eager_func(t, nm), eager_callee(c, nm),
  eager_legacy_fn(t), t != f.
eager_legacy_call(f, t, nm) :- eager_bcall(c, f), field(c, "function", e), eager_indirect(e, t), eager_func(t, nm),
  eager_legacy_fn(t), t != f.
eager_legacy_call(f, t, nm) :- eager_bcall(c, f), eager_call_ident(c), eager_callee(c, x), eager_asg_fn(a, f),
  eager_asg_name(a, x), field(a, "right", r), eager_indirect(r, t), eager_func(t, nm), eager_legacy_fn(t), t != f.

// ---- scope_names, scope_calls ----
.decl eager_scope_name(f: node, nm: symbol)
eager_scope_name(f, nm) :- eager_param(f, nm, _, _), suffix("scope", nm).
eager_scope_name(f, nm) :- node(_, n, "as_pattern", _, _), child(n, v, 0), node(_, v, "call", _, _), eager_callee(v, s),
  (s = "open_read_plan" ; s = "open_write_plan"), child(n, al, _), node(_, al, "as_pattern_target", _, _),
  child(al, x, _), node(_, x, "identifier", _, _), node_text(x, nm), nearest(n, f, eager_fdef).
.decl eager_scope_recv(c: node, nm: symbol)
eager_scope_recv(c, nm) :- eager_recv(c, r), node(_, r, "call", _, _), eager_callee(r, "cast"), eager_arg(r, a, 1),
  node(_, a, "identifier", _, _), node_text(a, nm).
eager_scope_recv(c, nm) :- eager_recv(c, r), node(_, r, "identifier", _, _), node_text(r, nm), !eager_scope_cast(c).
.decl eager_scope_cast(c: node)
eager_scope_cast(c) :- eager_recv(c, r), node(_, r, "call", _, _), eager_callee(r, "cast"), eager_arg(r, a, 1),
  node(_, a, "identifier", _, _).
.decl eager_scope_call(c: node)
eager_scope_call(c) :- eager_empty(c, f), eager_call_attr(c), eager_callee(c, "execute"), eager_scope_recv(c, nm),
  eager_scope_name(f, nm).

// ---- lazy_names, lazy_expressions, sql_expressions ----
.decl eager_lazy_name(f: node, nm: symbol, since: number)
eager_lazy_name(f, nm, -1) :- eager_typed(f, nm, "LazyResult").
eager_lazy_name(f, nm, st) :- eager_asg_fn(a, f), eager_asg_name(a, nm), field(a, "right", r), node(_, r, "call", _, _),
  eager_callee(r, s), suffix("_lazy", s), node(_, a, _, st, _).
eager_lazy_name(f, nm, st) :- eager_asg_fn(a, f), eager_asg_name(a, nm), field(a, "type", t), eager_ann_name(t, "LazyResult"),
  node(_, a, _, st, _).
eager_lazy_name(f, nm, st) :- eager_asg_fn(a, f), eager_asg_name(a, nm), field(a, "right", r), node(_, r, "identifier", _, _),
  node_text(r, old), eager_lazy_name(f, old, since), node(_, a, _, st, _), since < st.
.decl eager_lazy_expr(f: node, x: node)
eager_lazy_expr(f, x) :- node(_, x, "identifier", _, _), nearest(x, f, eager_fdef), node_text(x, nm), eager_lazy_name(f, nm, _).
eager_lazy_expr(f, c) :- eager_bcall(c, f), eager_callee(c, s), suffix("_lazy", s).
eager_lazy_expr(f, c) :- eager_bcall(c, f), eager_callee(c, "cast"), eager_arg(c, a, 1), eager_lazy_expr(f, a).
.decl eager_sql_expr(f: node, x: node)
eager_sql_expr(f, c) :- eager_bcall(c, f), eager_callee(c, s), (s = "_resolve_lazy_in_external_boundary" ; s = "_resolve_transaction_value_async").
eager_sql_expr(f, c) :- eager_bcall(c, f), eager_callee(c, s), (prefix("_find_", s) ; prefix("_get_", s) ; prefix("_list_", s)),
  !suffix("_lazy", s).
eager_sql_expr(f, n) :- eager_sql_expr(f, old), eager_asg_fn(a, f), field(a, "right", old), eager_asg_name(a, nm),
  node(d, a, _, ast, _), node(d, n, "identifier", nst, _), node_text(n, nm), nst > ast, nearest(n, f, eager_fdef).
eager_sql_expr(f, n) :- eager_sql_expr(f, old), child(n, old, _), node(_, n, "attribute", _, _).
eager_sql_expr(f, n) :- eager_sql_expr(f, old), child(n, old, _), node(_, n, "await", _, _).

// ---- meaningful_statements, canonical_wrappers ----
.decl eager_docstmt(s: node)
eager_docstmt(s) :- node(_, s, "expression_statement", _, _), child(b, s, 0), child(s, v, _), node(_, v, "string", _, _),
  node(_, b, "block", _, _).
eager_docstmt(s) :- node(_, s, "expression_statement", _, _), child(b, s, 0), child(s, v, _),
  node(_, v, "concatenated_string", _, _), node(_, b, "block", _, _).
.decl eager_meaning(f: node, s: node, st: number)
eager_meaning(f, s, st) :- eager_func(f, _), field(f, "body", b), child(b, s, _), !eager_docstmt(s), node(_, s, _, st, _).
.decl eager_nmeaning(f: node, k: number)
eager_nmeaning(f, k) :- eager_func(f, _), k = count : { eager_meaning(f, _, _) }.
// The call a statement's first child is, through `await` in an async function.
.decl eager_stmt_call(f: node, s: node, c: node)
eager_stmt_call(f, s, c) :- eager_meaning(f, s, _), !eager_async(f), child(s, c, 0), node(_, c, "call", _, _).
eager_stmt_call(f, s, c) :- eager_meaning(f, s, _), eager_async(f), child(s, v, 0), node(_, v, "await", _, _), child(v, c, _),
  node(_, c, "call", _, _).
.decl eager_lazy_callee_call(z: node)
eager_lazy_callee_call(z) :- node(_, z, "call", _, _), eager_callee(z, s), suffix("_lazy", s), eager_full(z, t),
  !contains("(", t), !contains(")", t).
.decl eager_canonical(f: node)
eager_canonical(f) :- eager_nmeaning(f, 1), eager_meaning(f, s, _),
  (node(_, s, "return_statement", _, _) ; node(_, s, "expression_statement", _, _)),
  eager_stmt_call(f, s, c), eager_call_ident(c), eager_callee(c, cn),
  ((eager_async(f), cn = "_resolve_legacy_result_async") ; (!eager_async(f), cn = "_resolve_legacy_result_sync")),
  eager_canonical_build(c, lm), node(_, lm, "lambda", _, _), field(lm, "body", z), eager_lazy_callee_call(z).
.decl eager_canonical_build(c: node, v: node)
eager_canonical_build(c, v) :- eager_arg(c, v, 2).
eager_canonical_build(c, v) :- eager_kw(c, "build_lazy", v).
eager_canonical(f) :- eager_nmeaning(f, 2), eager_meaning(f, s, sst), child(s, a, _), eager_asg_name(a, tt),
  !field(a, "type", _), field(a, "right", z), eager_lazy_callee_call(z),
  eager_meaning(f, r, rst), rst > sst, node(_, r, "return_statement", _, _), eager_stmt_call(f, r, c),
  eager_call_ident(c), eager_callee(c, cn),
  ((eager_async(f), cn = "run_in_legacy_execution_boundary_async") ; (!eager_async(f), cn = "run_in_legacy_execution_boundary")),
  eager_arg(c, term, 0), eager_attr(term, ta), field(term, "object", o), node(_, o, "identifier", _, _), node_text(o, tt),
  ((eager_async(f), ta = "resolve_async") ; (!eager_async(f), ta = "resolve")),
  eager_nargs(c, 1), !eager_kw(c, _, _).
.decl eager_nargs(c: node, k: number)
eager_nargs(c, k) :- node(_, c, "call", _, _), k = count : { eager_arg(c, _, _) }.

// ---- raw_patterns: (function, span, pattern, dirty, transitive) ----
.decl eager_raw(f: node, st: number, en: number, pat: symbol, dirty: number, trans: number)
.decl eager_span(n: node, st: number, en: number)
eager_span(n, st, en) :- node(_, n, _, st, en).
.decl eager_prefix(c: node, s: symbol)
eager_prefix(c, "*.") :- eager_call_attr(c).
eager_prefix(c, "") :- node(_, c, "call", _, _), !eager_call_attr(c).
// 1. `x.resolve()`, `x.resolve_async()`, `x.result()`, no arguments.
eager_raw(f, st, en, p, 1, 1) :- eager_empty(c, f), eager_call_attr(c), eager_callee(c, s),
  (s = "resolve" ; s = "resolve_async" ; s = "result"), eager_span(c, st, en), p = cat(cat("*.", s), "()").
// 2. the resolving helpers, called by name.
eager_raw(f, st, en, p, 1, 1) :- eager_bcall(c, f), eager_call_ident(c), eager_callee(c, s),
  (s = "_resolve_legacy_result_async" ; s = "_resolve_legacy_result_sync" ; s = "resolve_lazy_param" ;
   s = "resolve_lazy_param_str" ; s = "resolve_server_value"), eager_span(c, st, en), p = cat(s, "()").
// 3. the peeking helpers.
.decl eager_peek_helper(s: symbol)
eager_peek_helper("_append_revision_selector_filter").
eager_peek_helper("_effective_diff_to_revision").
eager_peek_helper("_safe_instance_dict").
eager_peek_helper("_safe_type_attr").
eager_peek_helper("deleted_ref_probe_helper").
eager_peek_helper("get_deleted_state_value").
eager_peek_helper("get_server_ref_id").
eager_peek_helper("peek_instance_attr").
eager_peek_helper("peek_resolved_value").
eager_peek_helper("preprocess_resolved_get").
eager_raw(f, st, en, p, 1, 1) :- eager_bcall(c, f), eager_callee(c, s), eager_peek_helper(s), eager_prefix(c, x),
  eager_span(c, st, en), p = cat(cat(x, s), "()").
// 4. deleted_ref_value_helper(), and peek_*() in the server-plan packages: not transitive.
eager_raw(f, st, en, p, 1, 0) :- eager_bcall(c, f), eager_call_ident(c), eager_callee(c, "deleted_ref_value_helper"),
  eager_span(c, st, en), p = "deleted_ref_value_helper()".
eager_raw(f, st, en, p, 1, 0) :- eager_bcall(c, f), node(d, c, _, _, _), eager_serverplan(d), eager_callee(c, s),
  prefix("peek_", s), eager_prefix(c, x), eager_span(c, st, en), p = cat(cat(x, s), "()").
// 5. reads of the resolution slots.
.decl eager_slot(s: symbol)
eager_slot("__dict__").
eager_slot("_deleted_state_slot").
eager_slot("_ref_id").
eager_slot("_step_ref_id").
eager_slot("deleted_state_flag").
eager_slot("deleted_state_value").
eager_slot("is_resolved").
eager_slot("resolved_value").
.decl eager_slot_trans(s: symbol, t: number)
eager_slot_trans(s, 0) :- eager_slot(s), (s = "_step_ref_id" ; s = "__dict__").
eager_slot_trans(s, 1) :- eager_slot(s), s != "_step_ref_id", s != "__dict__".
.decl eager_slot_ok(d: number, s: symbol)
eager_slot_ok(d, s) :- doc(d, _, _), eager_slot(s), s != "__dict__".
eager_slot_ok(d, "__dict__") :- eager_serverplan(d).
// `x.deleted_state_value` where x is annotated PlanningServerValueShape in the function.
.decl eager_planning_shape(a: node)
eager_planning_shape(a) :- eager_battr(a, f), eager_attr(a, "deleted_state_value"), field(a, "object", o), node_text(o, ot),
  eager_asg_fn(x, f), eager_asg(x, t), node_text(t, ot), field(x, "type", ty), eager_ann_name(ty, "PlanningServerValueShape").
eager_raw(f, st, en, p, 1, tr) :- eager_battr(a, f), eager_attr(a, s), node(d, a, _, _, _), eager_slot_ok(d, s),
  eager_slot_trans(s, tr), !eager_planning_shape(a), eager_span(a, st, en), p = cat("*.", s).
// 6. the slots by name: getattr/hasattr(x, "slot"), x.getattr_static(…, "slot"), x.__getattribute__("slot").
.decl eager_slot_arg(c: node, s: symbol)
eager_slot_arg(c, s) :- eager_call_ident(c), eager_callee(c, cn), (cn = "getattr" ; cn = "hasattr"), eager_arg(c, a, 1),
  eager_str_at(a, s), eager_slot(s).
eager_slot_arg(c, s) :- eager_call_attr(c), eager_callee(c, "getattr_static"), node(d, c, _, _, _), eager_serverplan(d),
  eager_arg(c, a, 1), eager_str_at(a, s), eager_slot(s).
eager_slot_arg(c, s) :- eager_call_attr(c), eager_callee(c, "__getattribute__"), eager_arg(c, a, k),
  k = max j : { eager_arg(c, _, j) }, eager_str_at(a, s), eager_slot(s).
eager_raw(f, st, en, p, 1, tr) :- eager_bcall(c, f), eager_slot_arg(c, s), node(d, c, _, _, _), eager_slot_ok(d, s),
  eager_callee(c, cn), eager_slot_call_trans(cn, s, tr), eager_prefix(c, x), eager_span(c, st, en),
  p = cat(cat(cat(cat(x, cn), "("), s), ")").
.decl eager_slot_call_trans(cn: symbol, s: symbol, t: number)
eager_slot_call_trans(cn, s, 0) :- eager_slot_arg(c, s), eager_callee(c, cn), (s = "_step_ref_id" ; s = "__dict__" ; cn = "getattr_static").
eager_slot_call_trans(cn, s, 1) :- eager_slot_arg(c, s), eager_callee(c, cn), s != "_step_ref_id", s != "__dict__", cn != "getattr_static".
// 7. a bound `x.resolve` passed as an argument, or assigned.
eager_raw(f, st, en, p, 1, 1) :- eager_bcall(c, f), eager_kw(c, _, v), eager_attr(v, s), (s = "resolve" ; s = "resolve_async"),
  eager_span(c, st, en), p = cat(cat("*.", s), "<bound>").
eager_raw(f, st, en, p, 1, 1) :- eager_bcall(c, f), eager_arg(c, v, _), eager_attr(v, s), (s = "resolve" ; s = "resolve_async"),
  eager_span(c, st, en), p = cat(cat("*.", s), "<bound>").
eager_raw(f, st, en, p, 1, 1) :- eager_asg_fn(a, f), field(a, "right", v), eager_attr(v, s), (s = "resolve" ; s = "resolve_async"),
  eager_span(a, st, en), p = cat(cat("*.", s), "<bound>").
// 8. a call of a legacy boundary function (span 0, 0: never a phase finding, dirty 0).
eager_raw(f, 0, 0, p, 0, 1) :- eager_legacy_call(f, _, nm), p = cat(cat("legacy-boundary-call:", nm), "()").
// 9. `scope.execute()` on a plan scope.
eager_raw(f, st, en, "plan-scope:*.execute()", 0, 1) :- eager_bcall(c, f), eager_scope_call(c), eager_span(c, st, en).
// 10. a non-lazy call on a transaction parameter.
.decl eager_nonlazy(s: symbol)
eager_nonlazy("count").
eager_nonlazy("count_async").
eager_nonlazy("delete").
eager_nonlazy("delete_async").
eager_nonlazy("delete_by_id").
eager_nonlazy("delete_by_id_async").
eager_nonlazy("delete_by_key_many").
eager_nonlazy("delete_by_key_many_async").
eager_nonlazy("delete_many").
eager_nonlazy("delete_many_async").
eager_nonlazy("delete_many_returning").
eager_nonlazy("delete_many_returning_async").
eager_nonlazy("delete_returning").
eager_nonlazy("delete_returning_async").
eager_nonlazy("execute").
eager_nonlazy("execute_async").
eager_nonlazy("execute_one").
eager_nonlazy("execute_one_async").
eager_nonlazy("execute_raw").
eager_nonlazy("execute_raw_async").
eager_nonlazy("exists").
eager_nonlazy("exists_async").
eager_nonlazy("first").
eager_nonlazy("first_async").
eager_nonlazy("insert").
eager_nonlazy("insert_async").
eager_nonlazy("insert_many").
eager_nonlazy("insert_many_async").
eager_nonlazy("insert_many_raw").
eager_nonlazy("insert_many_raw_async").
eager_nonlazy("select_many").
eager_nonlazy("select_many_async").
eager_nonlazy("select_one").
eager_nonlazy("select_one_async").
eager_nonlazy("update").
eager_nonlazy("update_async").
eager_nonlazy("update_by_id").
eager_nonlazy("update_by_id_async").
eager_nonlazy("update_by_key").
eager_nonlazy("update_by_key_async").
eager_nonlazy("update_by_key_many").
eager_nonlazy("update_by_key_many_async").
eager_nonlazy("update_many").
eager_nonlazy("update_many_async").
eager_nonlazy("upsert").
eager_nonlazy("upsert_async").
eager_nonlazy("upsert_many").
eager_nonlazy("upsert_many_async").
eager_nonlazy("upsert_many_raw").
eager_nonlazy("upsert_many_raw_async").
// expression_roots: the identifier an expression's chain of objects, values, callees and parentheses ends at.
.decl eager_root(e: node, x: node)
eager_root(e, e) :- eager_recv(_, e).
eager_root(e, y) :- eager_root(e, x), node(_, x, "attribute", _, _), field(x, "object", y).
eager_root(e, y) :- eager_root(e, x), node(_, x, "subscript", _, _), field(x, "value", y).
eager_root(e, y) :- eager_root(e, x), node(_, x, "call", _, _), field(x, "function", y).
eager_root(e, y) :- eager_root(e, x), node(_, x, "parenthesized_expression", _, _), child(x, y, 0).
eager_root(e, y) :- eager_root(e, x), node(_, x, "type", _, _), child(x, y, 0).
.decl eager_root_name(e: node, nm: symbol)
eager_root_name(e, nm) :- eager_root(e, x), node(_, x, "identifier", _, _), node_text(x, nm).
.decl eager_txn_name(f: node, nm: symbol)
eager_txn_name(f, nm) :- eager_param(f, nm, _, _),
  (nm = "txn" ; nm = "transaction" ; nm = "read_txn" ; nm = "write_txn" ; suffix("_txn", nm)).
eager_txn_name(f, nm) :- eager_typed(f, nm, "Transaction").
eager_raw(f, st, en, p, 0, 1) :- eager_bcall(c, f), eager_call_attr(c), eager_callee(c, s), eager_nonlazy(s),
  eager_recv(c, r), eager_root_name(r, nm), eager_txn_name(f, nm), !eager_scope_call(c), eager_span(c, st, en),
  p = cat(cat("non-lazy-call:*.", s), "()").
// 11. a callback's terminal `.get()` on a lazy value.
eager_raw(f, st, en, p, 0, 1) :- eager_empty(c, f), eager_func(f, fnm), contains("callback", fnm), eager_call_attr(c),
  eager_callee(c, s), (s = "get" ; s = "get_async"), eager_recv(c, r), node(_, r, "identifier", _, _), node_text(r, rt),
  (rt = "lazy" ; rt = "lazy_row" ; rt = "lazy_value" ; rt = "result" ; rt = "row" ; rt = "value"),
  eager_span(c, st, en), p = cat(cat("callback-terminal:*.", s), "()").
// 12. Python over a lazy value: bool(lazy), lazy[...], for … in lazy, if lazy.
eager_raw(f, st, en, p, 0, 1) :- eager_bcall(c, f), eager_call_ident(c), eager_callee(c, s),
  (s = "bool" ; s = "len" ; s = "list" ; s = "set" ; s = "sorted" ; s = "tuple"), eager_arg(c, a, 0), eager_lazy_expr(f, a),
  eager_span(c, st, en), p = cat(cat("lazy-python:", s), "(lazy)").
eager_raw(f, st, en, "lazy-python:lazy[...]", 0, 1) :- node(_, n, "subscript", st, en), child(n, x, 0), eager_lazy_expr(f, x).
eager_raw(f, st, en, "lazy-python:for lazy", 0, 1) :- node(_, n, "for_statement", st, en), field(n, "right", x), eager_lazy_expr(f, x).
eager_raw(f, st, en, "lazy-python:for lazy", 0, 1) :- node(_, n, "for_in_clause", st, en), field(n, "right", x), eager_lazy_expr(f, x).
eager_raw(f, st, en, "lazy-python:if lazy", 0, 1) :- node(_, n, "if_statement", st, en), field(n, "condition", x),
  node(_, x, "identifier", _, _), eager_lazy_expr(f, x).
eager_raw(f, st, en, "lazy-python:if lazy", 0, 1) :- node(_, n, "conditional_expression", st, en), field(n, "condition", x),
  node(_, x, "identifier", _, _), eager_lazy_expr(f, x).
// 13. a permission check over a value from SQL.
eager_raw(f, st, en, "sql-derived-python:permission-check", 0, 1) :- eager_bcall(c, f), eager_callee(c, s),
  (s = "_has_permission" ; s = "_require_permission"), field(c, "arguments", g), node(_, g, _, gs, ge),
  eager_sql_expr(f, x), node(_, x, _, xs, xe), xs >= gs, xe <= ge, eager_span(c, st, en).
// 14. IN(field(x.required_*_permission), …) outside the permission packages.
eager_raw(f, st, en, "permission-sql:direct-permission-expression", 0, 1) :- eager_bcall(c, f), eager_callee(c, "IN"),
  eager_arg(c, a0, 0), node(_, a0, "call", _, _), eager_callee(a0, "field"), eager_arg(a0, a1, 0), eager_attr(a1, s),
  (s = "required_metadata_read_permission" ; s = "required_read_permission" ; s = "required_resolve_permission" ;
   s = "required_write_permission"),
  node(d, c, _, _, _), doc(d, p, _), !prefix("l4000_permissions/", p), !suffix("permission_scheme.py", p), eager_span(c, st, en).

// ---- seed_patterns, transitive_patterns ----
.decl eager_legacy_wrapper_symbol(s: symbol)
eager_legacy_wrapper_symbol(s) :- eager_symbol(_, s), prefix("l2050_transaction.legacy_wrappers.", s).
eager_legacy_wrapper_symbol("l2070_batching.server_ref.deleted_planning_value_helper").
.decl eager_resolve_exempt(s: symbol)
eager_resolve_exempt(s) :- eager_symbol(_, s),
  match("(?:impl\.common\.l2550_storage_backend\.local_backend\.|impl\.l1570_llm_client\.client\.LLMClient\._resolve_debug_dir|impl\.sqlite\.connection\.SyncSqliteConnection\.database_identity|l1000_schema\.path_validation\.|l1100_exceptions\.safe_file_ops\.|l8000_admin\.tools\.docs_search\.|l8000_admin\.tools\.validation\.|l8100_ops_analytics\.connection\.|l9600_graphs\.dynamic_vector\.resolve_dynamic_embedding_handler).*", s).
.decl eager_result_exempt(s: symbol)
eager_result_exempt("impl.l1570_llm_client.client._run_sync").
eager_result_exempt("l5000_subscriptions.deferred_dispatch._run_async_callback_sync").
.decl eager_approved_pattern(p: symbol)
eager_approved_pattern(p) :- eager_raw(_, _, _, p, _, _), prefix("non-lazy-call:", p).
eager_approved_pattern("*.resolve()").
eager_approved_pattern("*.resolve_async()").
eager_approved_pattern("*.result()").
.decl eager_seed_exempt(f: node, p: symbol)
eager_seed_exempt(f, p) :- eager_raw(f, _, _, p, _, 1), (p = "_resolve_legacy_result_sync()" ; p = "_resolve_legacy_result_async()"),
  eager_canonical(f).
eager_seed_exempt(f, p) :- eager_raw(f, _, _, p, _, 1), eager_symbol(f, s), eager_legacy_wrapper_symbol(s).
eager_seed_exempt(f, "*.resolve()") :- eager_symbol(f, s), eager_resolve_exempt(s).
eager_seed_exempt(f, "*.result()") :- eager_symbol(f, s), eager_result_exempt(s).
eager_seed_exempt(f, p) :- eager_raw(f, _, _, p, _, 1), eager_approved_pattern(p), eager_symbol(f, s), eager_approved(s),
  eager_external_io(f).
.decl eager_dirty(f: node, issue: symbol)
eager_dirty(f, i) :- eager_raw(f, _, _, p, _, 1), eager_func(f, _), !eager_seed_exempt(f, p), i = cat("transitive:", p).
eager_dirty(g, i) :- eager_dirty(f, i), eager_edge(g, f), eager_symbol(g, s), !eager_legacy_wrapper_symbol(s).
.decl eager_transitive_exempt(f: node, i: symbol)
eager_transitive_exempt(f, i) :- eager_dirty(f, i), node(d, f, _, _, _), doc(d, p, _),
  (p = "l2055_lazy_result/lazy_result.py" ; p = "l2055_lazy_result/lazy_seq.py"), eager_symbol(f, s), eager_lazy_core(s).
eager_transitive_exempt(f, i) :- eager_dirty(f, i), node(d, f, _, _, _), doc(d, "l2070_batching/server_ref.py", _),
  (i = "transitive:*._deleted_state_slot" ; i = "transitive:*._ref_id").
eager_transitive_exempt(f, "transitive:*._ref_id") :- eager_dirty(f, "transitive:*._ref_id"), node(d, f, _, _, _),
  doc(d, "l2070_batching/step.py", _), eager_symbol(f, s), prefix("l2070_batching.step.StepRef.", s).
.decl eager_lazy_core(s: symbol)
eager_lazy_core("l2055_lazy_result.lazy_result.NoneResultError.__init__").
eager_lazy_core(s) :- eager_symbol(_, s),
  match("(?:l2055_lazy_result\.lazy_result\.LazyFieldRef\.|l2055_lazy_result\.lazy_result\.LazyResult\.|l2055_lazy_result\.lazy_seq\.LazySeq\.).*", s).
// transitive_patterns (display_nodes: the function of its symbol, itself).
.decl eager_transitive(d: number, l: number, i: symbol)
eager_transitive(d, l, i) :- eager_dirty(f, i), !eager_transitive_exempt(f, i), node(d, f, _, _, _), !eager_test_path(d),
  line(f, l).

// ---- phase_patterns (display_nodes: a call or attribute at the group's min start and min end) ----
.decl eager_phase_pat(f: node, p: symbol)
eager_phase_pat(f, p) :- eager_raw(f, _, _, p, 1, _), eager_phase(f, _), !prefix("_resolve_legacy_result_", p).
.decl eager_phase_span(f: node, p: symbol, st: number, en: number)
eager_phase_span(f, p, st, en) :- eager_phase_pat(f, p), st = min s : { eager_raw(f, s, _, p, 1, _) },
  en = min e : { eager_raw(f, _, e, p, 1, _) }.
.decl eager_phase_site(d: number, l: number, i: symbol)
eager_phase_site(d, l, i) :- eager_phase_span(f, p, st, en), eager_phase(f, ph), eager_func(f, _), node(d, f, _, _, _),
  node(d, n, "call", st, en), line(n, l), i = cat(cat(ph, ":"), p).
eager_phase_site(d, l, i) :- eager_phase_span(f, p, st, en), eager_phase(f, ph), eager_func(f, _), node(d, f, _, _, _),
  node(d, n, "attribute", st, en), line(n, l), i = cat(cat(ph, ":"), p).

// ---- external_definitions ----
.decl eager_external(d: number, l: number, i: symbol)
eager_external(d, l, i) :- eager_external_io(f), eager_func(f, nm), node(d, f, _, _, _), line(f, l),
  i = cat(cat("external-io-boundary:", nm), "()").

// ---- preprocess_patterns ----
.decl eager_resolved_param(f: node)
eager_resolved_param(f) :- eager_param(f, "resolved", pos, p), pos >= 1, !node(_, p, "typed_default_parameter", _, _).
.decl eager_preprocess(d: number, l: number, i: symbol)
eager_preprocess(d, l, i) :- eager_bcall(c, f), eager_func(f, "preprocess"), eager_call_ident(c), eager_callee(c, s),
  (s = "resolve_lazy_param" ; s = "resolve_lazy_param_str" ; s = "resolve_server_value"),
  node(d, c, _, _, _), line(c, l), i = cat(cat("preprocess:", s), "()").
eager_preprocess(d, l, i) :- eager_bcall(c, f), eager_func(f, "preprocess"), eager_call_attr(c), eager_resolved_param(f),
  eager_callee(c, s), (s = "get" ; s = "peek" ; s = "resolve_server_ref"), eager_recv(c, r), node(_, r, "identifier", _, _),
  node_text(r, "resolved"), node(d, c, _, _, _), line(c, l), i = cat(cat("preprocess:resolved.", s), "()").
eager_preprocess(d, l, "preprocess:*.resolve(resolved)") :- eager_bcall(c, f), eager_func(f, "preprocess"), eager_call_attr(c),
  eager_resolved_param(f), eager_callee(c, "resolve"), eager_arg(c, a, _), node(_, a, "identifier", _, _),
  node_text(a, "resolved"), node(d, c, _, _, _), line(c, l).

// ---- source_lines, line_patterns, direct_sites, direct_patterns ----
// source_lines: each `LINE` capture of the module regex, its start line and text.
.decl eager_source_line(d: number, l: number, t: symbol)
eager_source_line(d, l, t) :- source(d, sp),
  match_group("(?m)^(?<LINE>[^\\n]*(?:\.resolve\(\)|\.resolve_async\(\)|\.result\(\)|\bint\(\s*lazy|\bfloat\(\s*lazy|\bbool\(\s*lazy)[^\\n]*)$", sp, _, "LINE", g),
  line(g, l), text(g, t).
.decl eager_line_issue(d: number, l: number, i: symbol)
eager_line_issue(d, l, ".resolve()") :- eager_source_line(d, l, s), match("(?s:.*)(?:\.resolve\(\))(?s:.*)", s).
eager_line_issue(d, l, ".resolve_async()") :- eager_source_line(d, l, s), match("(?s:.*)(?:\.resolve_async\(\))(?s:.*)", s).
eager_line_issue(d, l, ".result()") :- eager_source_line(d, l, s), match("(?s:.*)(?:\.result\(\))(?s:.*)", s).
eager_line_issue(d, l, "int(lazy...)") :- eager_source_line(d, l, s), match("(?s:.*)(?:\bint\(\s*lazy)(?s:.*)", s).
eager_line_issue(d, l, "float(lazy...)") :- eager_source_line(d, l, s), match("(?s:.*)(?:\bfloat\(\s*lazy)(?s:.*)", s).
eager_line_issue(d, l, "bool(lazy...)") :- eager_source_line(d, l, s), match("(?s:.*)(?:\bbool\(\s*lazy)(?s:.*)", s).
.decl eager_comment_line(d: number, l: number)
eager_comment_line(d, l) :- eager_line_issue(d, l, _), eager_source_line(d, l, s), match("\s*#(?s:.*)", s).
// Inside a multi-line string that is no f-string.
.decl eager_mlstr(d: number, a: number, b: number)
eager_mlstr(d, a, b) :- node(d, s, "string", _, _), node_text(s, t), contains("\n", t), !match("(?s)[rRuUbB]*[fF].*", t),
  line(s, a), end_line(s, b).
eager_mlstr(d, a, b) :- node(d, s, "concatenated_string", _, _), node_text(s, t), contains("\n", t),
  !match("(?s)[rRuUbB]*[fF].*", t), line(s, a), end_line(s, b).
.decl eager_in_mlstr(d: number, l: number)
eager_in_mlstr(d, l) :- eager_line_issue(d, l, _), eager_mlstr(d, a, b), a <= l, l <= b.
.decl eager_direct_site(d: number, l: number, i: symbol)
eager_direct_site(d, l, i) :- eager_line_issue(d, l, i), !eager_comment_line(d, l), !eager_test_path(d), !eager_in_mlstr(d, l).
// The line's symbol: the innermost function covering it (most dots in its qualname, then the shortest text).
.decl eager_cover(d: number, l: number, f: node, k: number, n: number)
eager_cover(d, l, f, k, n) :- eager_direct_site(d, l, _), eager_func(f, _), node(d, f, _, _, _), line(f, a), end_line(f, b),
  a <= l, l <= b, eager_depth(f, k), node_text(f, t), n = strlen(t).
.decl eager_cover_depth(d: number, l: number, k: number)
eager_cover_depth(d, l, k) :- eager_cover(d, l, _, _, _), k = max j : { eager_cover(d, l, _, j, _) }.
.decl eager_cover_len(d: number, l: number, n: number)
eager_cover_len(d, l, n) :- eager_cover_depth(d, l, k), n = min m : { eager_cover(d, l, _, k, m) }.
.decl eager_line_symbol(d: number, l: number, s: symbol)
eager_line_symbol(d, l, s) :- eager_cover_len(d, l, n), eager_cover_depth(d, l, k), eager_cover(d, l, f, k, n), eager_symbol(f, s).
eager_line_symbol(d, l, s) :- eager_direct_site(d, l, _), !eager_cover(d, l, _, _, _), eager_modname(d, m), s = cat(m, "::<module>").
.decl eager_direct_exempt(d: number, l: number, i: symbol)
eager_direct_exempt(d, l, i) :- eager_direct_site(d, l, i), doc(d, p, _),
  (p = "l2055_lazy_result/lazy_result.py" ; p = "l2055_lazy_result/lazy_seq.py"), eager_line_symbol(d, l, s), eager_lazy_core(s).
eager_direct_exempt(d, l, ".resolve()") :- eager_direct_site(d, l, ".resolve()"), doc(d, "l2055_lazy_result/lazy_result.py", _),
  eager_line_symbol(d, l, "l2055_lazy_result.lazy_result.LazyResult.result").
eager_direct_exempt(d, l, ".resolve()") :- eager_direct_site(d, l, ".resolve()"), eager_line_symbol(d, l, s), eager_resolve_exempt(s).
eager_direct_exempt(d, l, ".result()") :- eager_direct_site(d, l, ".result()"), eager_line_symbol(d, l, s), eager_result_exempt(s).
eager_direct_exempt(d, l, i) :- eager_direct_site(d, l, i), (i = ".resolve()" ; i = ".resolve_async()" ; i = ".result()"),
  eager_line_symbol(d, l, s), eager_approved(s).
eager_direct_exempt(d, l, ".resolve()") :- eager_direct_site(d, l, ".resolve()"), eager_source_line(d, l, s),
  contains("ResolveVersionedForeignKeyTargetIntent(", s).
// (The SQL's other direct_patterns exclusions test issues no line pattern gives: `transitive:…`, `__dict__`,
// `getattr_static(`, `peek_*`.)
.decl eager_direct(d: number, l: number, i: symbol)
eager_direct(d, l, i) :- eager_direct_site(d, l, i), !eager_direct_exempt(d, l, i).

// ---- the final query: entryPoint's case selects one family; any other value (the default `_scan_source`
// included) is the default query, every family. The code is the issue ----
.decl eager_entry(e: symbol)
eager_entry("_scan_transitive_eager_ast").
eager_entry("_scan_lower_compile_ast").
eager_entry("_scan_preprocess_ast").
eager_entry("_scan_external_io_boundary_definition_ast").
eager_entry("_scan_legacy_boundary_definition_ast").
.decl eager_entry_case(x: number)
eager_entry_case(1) :- option_value("entryPoint", e), eager_entry(e).
.decl eager_finding(d: number, l: number, i: symbol)
eager_finding(d, l, i) :- eager_transitive(d, l, i), !eager_entry_case(1).
eager_finding(d, l, i) :- eager_transitive(d, l, i), option_value("entryPoint", "_scan_transitive_eager_ast").
eager_finding(d, l, i) :- eager_phase_site(d, l, i), !eager_entry_case(1).
eager_finding(d, l, i) :- eager_phase_site(d, l, i), option_value("entryPoint", "_scan_lower_compile_ast"),
  (prefix("lower:", i) ; prefix("compile:", i)).
eager_finding(d, l, i) :- eager_external(d, l, i), !eager_entry_case(1).
eager_finding(d, l, i) :- eager_external(d, l, i), option_value("entryPoint", "_scan_external_io_boundary_definition_ast").
// `_scan_legacy_boundary_definition_ast` is external_definitions `WHERE 0`: nothing.
eager_finding(d, l, i) :- eager_preprocess(d, l, i), !eager_entry_case(1).
eager_finding(d, l, i) :- eager_preprocess(d, l, i), option_value("entryPoint", "_scan_preprocess_ast").
eager_finding(d, l, i) :- eager_direct(d, l, i), !eager_entry_case(1).
violation("data-layer-eager-resolve", "eager-resolution", i, p, l) :- eager_finding(d, l, i),
  in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _).
