violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_cclass(d, n, _, _, _, "impl.common.l2070_server_plan.steps.sql_conditional.SqlConditionalStep"), !conditional_architecture_role_ok(n), doc(d, p, _), line(n, l).
violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_cclass(d, n, _, _, _, "impl.common.l2070_server_plan.steps.sql_conditional.SqlConditionalStep"), !conditional_architecture_phys_compile_ok(n), doc(d, p, _), line(n, l).
