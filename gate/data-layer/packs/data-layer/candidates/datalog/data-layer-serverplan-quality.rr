violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_controls(n), conditional_architecture_own_fn(n, f), conditional_architecture_cmethod(d, f, _, _, _, _), conditional_architecture_cmethod_derived(f), doc(d, p, _), line(n, l).
