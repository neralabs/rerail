conditional_architecture_ownee(n) :- conditional_architecture_controls(n).
conditional_architecture_ownee(n) :- conditional_architecture_vnodes(n), node(_, n, "block", _, _).
conditional_architecture_own_in(n, f, fs) :- conditional_architecture_ownee(n), node(d, n, _, ns, ne), conditional_architecture_fn(d, f, fs, fe, _), fs < ns, fe >= ne.
conditional_architecture_own_fn(n, f) :- conditional_architecture_own_in(n, f, fs), fs = max u : { conditional_architecture_own_in(n, _, u) }.
conditional_architecture_vchild(p, x) :- conditional_architecture_vnodes(x), child(p, x, _).
conditional_architecture_cblock(b) :- conditional_architecture_vnodes(b), node(_, b, "block", _, _), conditional_architecture_own_fn(b, f), conditional_architecture_cmethod(_, f, _, _, "require_sql_physical_conditional", _).
conditional_architecture_barrier(b, s) :- conditional_architecture_cblock(b), conditional_architecture_vchild(b, x), node(_, x, k, s, _), conditional_architecture_k_barrier(k).
conditional_architecture_has_barrier(b) :- conditional_architecture_barrier(b, _).
conditional_architecture_limit(b, m) :- conditional_architecture_has_barrier(b), m = min s : { conditional_architecture_barrier(b, s) }.
conditional_architecture_limit(b, e) :- conditional_architecture_cblock(b), node(_, b, _, _, e), !conditional_architecture_has_barrier(b).
conditional_architecture_body_stmt(b, x) :- conditional_architecture_cblock(b), conditional_architecture_vchild(b, x), node(_, x, _, xs, _), conditional_architecture_limit(b, l), xs <= l.
conditional_architecture_typeerror(x) :- conditional_architecture_vnodes(x), node(_, x, "raise_statement", _, _), node_text(x, s), match("(?s:.*)(?:^raise\\s+TypeError(?:\\s*\\(|\\s*$))(?s:.*)", s).
conditional_architecture_if_else(x) :- conditional_architecture_vnodes(x), node(_, x, "if_statement", _, _), conditional_architecture_vchild(x, e), node(_, e, "else_clause", _, _).
conditional_architecture_match_case(x) :- conditional_architecture_vnodes(x), node(d, x, "match_statement", xs, xe), conditional_architecture_vnodes(a), node(d, a, "case_clause", a1, a2), a1 > xs, a2 <= xe.
conditional_architecture_cand(x) :- conditional_architecture_if_else(x).
conditional_architecture_cand(x) :- conditional_architecture_match_case(x).
conditional_architecture_sub(x, c) :- conditional_architecture_if_else(x), conditional_architecture_vchild(x, c), conditional_architecture_cblock(c).
conditional_architecture_sub(x, c) :- conditional_architecture_if_else(x), conditional_architecture_vchild(x, a), node(_, a, k, _, _), conditional_architecture_k_arm(k), conditional_architecture_vchild(a, c), conditional_architecture_cblock(c).
conditional_architecture_sub(x, c) :- conditional_architecture_match_case(x), node(d, x, _, xs, xe), conditional_architecture_vnodes(a), node(d, a, "case_clause", a1, a2), a1 > xs, a2 <= xe, conditional_architecture_vchild(a, c), conditional_architecture_cblock(c).
conditional_architecture_sub_before(x, c, c2) :- conditional_architecture_sub(x, c), node(_, c, _, cs, _), conditional_architecture_sub(x, c2), node(_, c2, _, s2, _), s2 < cs.
conditional_architecture_sub_rank(x, c, i) :- conditional_architecture_sub(x, c), i = count : { conditional_architecture_sub_before(x, c, _) }.
conditional_architecture_has_sub(x) :- conditional_architecture_sub(x, _).
conditional_architecture_sub_count(x, k) :- conditional_architecture_has_sub(x), k = count : { conditional_architecture_sub(x, _) }.
conditional_architecture_sub_next(x, c, c2) :- conditional_architecture_sub_rank(x, c, i), conditional_architecture_sub_rank(x, c2, j), j = @add(i, 1).
conditional_architecture_ok_upto(x, c) :- conditional_architecture_sub_rank(x, c, 0), conditional_architecture_raises(c).
conditional_architecture_ok_upto(x, c2) :- conditional_architecture_ok_upto(x, c), conditional_architecture_sub_next(x, c, c2), conditional_architecture_raises(c2).
conditional_architecture_all_ok(x) :- conditional_architecture_cand(x), !conditional_architecture_has_sub(x).
conditional_architecture_all_ok(x) :- conditional_architecture_sub_count(x, k), conditional_architecture_sub_rank(x, c, i), i = @sub(k, 1), conditional_architecture_ok_upto(x, c).
conditional_architecture_raises(b) :- conditional_architecture_body_stmt(b, x), conditional_architecture_typeerror(x).
conditional_architecture_raises(b) :- conditional_architecture_body_stmt(b, x), conditional_architecture_cand(x), conditional_architecture_all_ok(x).
conditional_architecture_always(m) :- conditional_architecture_cmethod(_, m, _, _, "require_sql_physical_conditional", _), conditional_architecture_vchild(m, b), node(_, b, "block", _, _), conditional_architecture_raises(b).
conditional_architecture_intret(f, r, v) :- conditional_architecture_int_returns(f), inside(r, f, conditional_architecture_kinds0), node(_, r, "return_statement", _, _), child(r, v, _), node(_, v, k, _, _), conditional_architecture_k_int(k).
conditional_architecture_mret(c, f, r, v) :- conditional_architecture_cmethod(d, m, ms, me, "level", c), conditional_architecture_intret(f, r, v), node(d, r, _, rs, re), rs >= ms, rs <= me, re <= me.
conditional_architecture_zero(v) :- conditional_architecture_intret(_, _, v), node(_, v, "false", _, _).
conditional_architecture_zero(v) :- conditional_architecture_intret(_, _, v), node(_, v, "integer", _, _), node_text(v, s), match("0+(?:[^0-9](?s:.*))?", s).
conditional_architecture_has_mret(c) :- conditional_architecture_mret(c, _, _, _).
conditional_architecture_has_zero_mret(c) :- conditional_architecture_mret(c, _, _, v), conditional_architecture_zero(v).
conditional_architecture_mret_count(c, k) :- conditional_architecture_cclass(_, c, _, _, _, "impl.common.l2070_server_plan.steps.sql_conditional.SqlConditionalStep"), k = count : { conditional_architecture_mret(c, _, _, _) }.
conditional_architecture_roleret(d, s, e) :- conditional_architecture_role_returns(f), inside(r, f, conditional_architecture_kinds0), node(d, r, "return_statement", s, e), child(r, x, _), node_text(x, "StepExecutionRole.SQL").
conditional_architecture_ncall(d, s, e, callee, l) :- conditional_architecture_named_calls(n), node(d, n, _, s, e), field(n, "function", x), node_text(x, callee), line(x, l).
conditional_architecture_store_right(n, x) :- conditional_architecture_self_stores(n), field(n, "right", x).
conditional_architecture_cparam(f, nm) :- conditional_architecture_callable_params(f), field(f, "parameters", ps), child(ps, tp, _), node(_, tp, k, _, _), conditional_architecture_k_typed(k), child(tp, x, 0), node(_, x, "identifier", _, _), text(x, nm), field(tp, "type", c260), conditional_architecture_276(c260).
conditional_architecture_decl_anc(n, a) :- conditional_architecture_declared(n), inside(n, a, conditional_architecture_kinds2), field(a, "type", _).
conditional_architecture_assign_in_fn(a) :- conditional_architecture_decl_anc(_, a), inside(a, _, conditional_architecture_kinds0).
conditional_architecture_decl_cand(n, a, s) :- conditional_architecture_decl_anc(n, a), !conditional_architecture_assign_in_fn(a), node(_, a, _, s, _).
conditional_architecture_decl_x(a) :- conditional_architecture_decl_cand(n, a, s), s = max u : { conditional_architecture_decl_cand(n, _, u) }.
conditional_architecture_decl_cls_in(a, c, cs) :- conditional_architecture_decl_x(a), node(d, a, _, s, e), conditional_architecture_class(d, c, cs, ce, _), cs < s, ce >= e.
conditional_architecture_decl_cls(a, c) :- conditional_architecture_decl_cls_in(a, c, cs), cs = max u : { conditional_architecture_decl_cls_in(a, _, u) }.
conditional_architecture_ccall(n, s) :- conditional_architecture_compile_calls(n), field(n, "function", a), field(a, "object", o), node_text(o, s).
conditional_architecture_bvar(d, nm, s, e) :- conditional_architecture_branch_vars(st), node(d, st, _, s, e), field(st, "left", l), node(d, l, "identifier", _, _), text(l, nm).
conditional_architecture_bvar(d, nm, s, e) :- conditional_architecture_branch_vars(st), node(d, st, _, s, e), field(st, "left", l), node(d, l, _, ls, le), node(d, v, "identifier", vs, ve), ls <= vs, ve <= le, v != l, text(v, nm).
conditional_architecture_present(1) :- conditional_architecture_cclass(_, _, _, _, _, qn), conditional_architecture_k_contract(qn).
conditional_architecture_present(1) :- conditional_architecture_has_cfunc("impl.common.l2070_server_plan.steps._conditional_compile.compile_sql_conditional_step").
conditional_architecture_sem_compile_ok(c) :- conditional_architecture_cmethod(_, m, _, _, "compile", c), conditional_architecture_raising_fns(m).
conditional_architecture_role_ok(c) :- conditional_architecture_cmethod(d, m, ms, me, "execution_role", c), conditional_architecture_roleret(d, s, e), s >= ms, e <= me.
conditional_architecture_phys_compile_ok(c) :- conditional_architecture_cmethod(d, m, ms, me, "compile", c), conditional_architecture_ncall(d, s, e, x, _), s >= ms, e <= me, match("(?s:.*)(?:compile_sql_conditional_step$)(?s:.*)", x).
conditional_architecture_sem_contract_ok(c) :- conditional_architecture_cmethod(_, m, _, _, "require_sql_physical_conditional", c), conditional_architecture_always(m).
conditional_architecture_phys_contract_ok(c) :- conditional_architecture_cmethod(_, m, _, _, "require_sql_physical_conditional", c), !conditional_architecture_always(m), !conditional_architecture_backend_fns(m).
conditional_architecture_lower_ok(c) :- conditional_architecture_cmethod(d, m, ms, me, "_lower_conditional_step", c), conditional_architecture_ncall(d, s, e, x, _), s >= ms, e <= me, match("(?s:.*)(?:SqlConditionalStep\\.from_semantic$)(?s:.*)", x).
conditional_architecture_ann_suffix(a, s) :- conditional_architecture_ann(a, x), match("\\w+(?:\\.\\w+)*", x), s = @rx_replace(x, "^\\w+((?:\\.\\w+)*)$", "$1").
conditional_architecture_ann_suffix(a, "") :- conditional_architecture_ann(a, x), !match("\\w+(?:\\.\\w+)*", x).
conditional_architecture_step_ok(f) :- conditional_architecture_cfunc(d, f, fs, _, "impl.common.l2070_server_plan.steps._conditional_compile.compile_sql_conditional_step"), conditional_architecture_step_ann(f, a), conditional_architecture_ann_head(a, h), conditional_architecture_resolved(d, h, fs, o), conditional_architecture_ann_suffix(a, sf), nm = @concat(o, sf), nm = "impl.common.l2070_server_plan.steps.sql_conditional.SqlConditionalStep".
conditional_architecture_req_call(f, l) :- conditional_architecture_cfunc(d, f, fs, fe, "impl.common.l2070_server_plan.steps._conditional_compile.compile_sql_conditional_step"), conditional_architecture_ncall(d, s, e, "step.require_sql_physical_conditional", l), s >= fs, e <= fe.
conditional_architecture_strat_line(f, l) :- conditional_architecture_cfunc(d, f, fs, fe, "impl.common.l2070_server_plan.steps._conditional_compile.compile_sql_conditional_step"), conditional_architecture_ncall(d, s, e, x, l), s >= fs, e <= fe, match("(?s:.*)(?:_conditional_strategy$)(?s:.*)", x).
conditional_architecture_strat_before(f, l) :- conditional_architecture_req_call(f, l), conditional_architecture_strat_line(f, k), k <= l.
conditional_architecture_req_early(f) :- conditional_architecture_req_call(f, l), !conditional_architecture_strat_before(f, l).
conditional_architecture_compiler_ok(f) :- conditional_architecture_step_ok(f), !conditional_architecture_backend_fns(f), conditional_architecture_req_early(f).
