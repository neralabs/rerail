violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_self_stores(n), conditional_architecture_own_fn(n, f), conditional_architecture_cmethod(d, f, _, _, "__init__", _), conditional_architecture_cmethod_derived(f), conditional_architecture_store_right(n, x), node(_, x, "lambda", _, _), doc(d, p, _), line(n, l).
