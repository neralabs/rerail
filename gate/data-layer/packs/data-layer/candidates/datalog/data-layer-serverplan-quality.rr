quality_local_taxonomy_19(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c17), node(_, c17, "identifier", _, _), text(c17, s18), match("(?s:.*)(?:^(?:__module__|__name__)$)(?s:.*)", s18).
