conditional_architecture_resolve_cand(d, h, cs, s) :- conditional_architecture_resolve_need(d, h, cs), conditional_architecture_alias(d, s, h, _), s < cs.
conditional_architecture_has_resolve_cand(d, h, cs) :- conditional_architecture_resolve_cand(d, h, cs, _).
conditional_architecture_resolved(d, h, cs, o) :- conditional_architecture_has_resolve_cand(d, h, cs), m = max s : { conditional_architecture_resolve_cand(d, h, cs, s) }, conditional_architecture_alias(d, m, h, o).
conditional_architecture_resolved(d, h, cs, h) :- conditional_architecture_resolve_need(d, h, cs), !conditional_architecture_has_resolve_cand(d, h, cs).
