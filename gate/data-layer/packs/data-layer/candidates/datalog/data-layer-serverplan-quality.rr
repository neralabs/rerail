conditional_architecture_sup(c, t, n) :- conditional_architecture_class_sups(c), field(c, "superclasses", g), node_text(g, x), t = @substr(x, 1, @sub(@strlen(x), 2)), n = @strlen(@rx_replace(t, "[^,]", "")).
conditional_architecture_sup_k1(c, k) :- conditional_architecture_sup(c, _, n), conditional_architecture_digit(a), k = @mul(a, 262144), k < n.
conditional_architecture_sup_k2(c, k) :- conditional_architecture_sup_k1(c, h), conditional_architecture_sup(c, _, n), conditional_architecture_digit(a), k = @add(h, @mul(a, 4096)), k < n.
conditional_architecture_sup_k3(c, k) :- conditional_architecture_sup_k2(c, h), conditional_architecture_sup(c, _, n), conditional_architecture_digit(a), k = @add(h, @mul(a, 64)), k < n.
conditional_architecture_sup_k(c, k) :- conditional_architecture_sup_k3(c, h), conditional_architecture_sup(c, _, n), conditional_architecture_digit(a), k = @add(h, a), k < n.
conditional_architecture_split(c, k) :- conditional_architecture_sup_k(c, k), conditional_architecture_sup(c, t, _), re = @concat(@concat("^((?:[^,]*,){", @to_string(k)), "}[^,]*),(?s:.*)$"), u = @rx_replace(t, re, "$1"), o = @strlen(@rx_replace(u, "[^(\\[{]", "")), z = @strlen(@rx_replace(u, "[^)\\]}]", "")), o = z.
conditional_architecture_cut(c, 0) :- conditional_architecture_sup(c, _, _).
conditional_architecture_cut(c, j) :- conditional_architecture_split(c, k), j = @add(k, 1).
conditional_architecture_stop(c, k) :- conditional_architecture_split(c, k).
conditional_architecture_stop(c, n) :- conditional_architecture_sup(c, _, n).
rr_cover7(c) :- conditional_architecture_sup(c, t, _).
rr_ctx8(c, j) :- conditional_architecture_cut(c, j), rr_cover7(c).
rr_agg6(c, j, y) :- rr_demand_agg_rr_agg6(c, j), rr_ctx8(c, j), conditional_architecture_stop(c, y), y >= j.
conditional_architecture_item(c, x) :- conditional_architecture_cut(c, j), conditional_architecture_sup(c, t, _), q = min y : { rr_agg6(c, j, y) }, re = @concat(@concat(@concat(@concat("^(?:[^,]*,){", @to_string(j)), "}([^,]*(?:,[^,]*){"), @to_string(@sub(q, j))), "})(?:,(?s:.*))?$"), u = @rx_replace(t, re, "$1"), x = @rx_replace(u, "^[ \\t\\n\\r]+|[ \\t\\n\\r]+$", "").
conditional_architecture_base(c, x) :- conditional_architecture_cclass(_, c, _, _, _, _), conditional_architecture_item(c, x), match("[A-Za-z_]\\w*(?:\\s*\\.\\s*[A-Za-z_]\\w*)*", x).
conditional_architecture_base(c, x) :- conditional_architecture_cclass(_, c, _, _, _, _), conditional_architecture_item(c, x), match("[A-Za-z_][\\w.\\s]*\\((?s:.*)", x), match("(?s:.*)\\)", x).
