violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_cclass(d, n, _, _, _, "impl.common.l2070_server_plan.steps.sql_conditional.SqlConditionalStep"), !conditional_architecture_role_ok(n), doc(d, p, _), line(n, l).
violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_cclass(d, n, _, _, _, "impl.common.l2070_server_plan.steps.sql_conditional.SqlConditionalStep"), !conditional_architecture_phys_compile_ok(n), doc(d, p, _), line(n, l).
violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_self_stores(n), conditional_architecture_own_fn(n, f), conditional_architecture_cmethod(d, f, _, _, nm, _), conditional_architecture_cmethod_derived(f), nm != "__init__", doc(d, p, _), line(n, l).
violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_self_stores(n), conditional_architecture_own_fn(n, f), conditional_architecture_cmethod(d, f, _, _, "__init__", _), conditional_architecture_cmethod_derived(f), conditional_architecture_store_right(n, x), node(_, x, "lambda", _, _), doc(d, p, _), line(n, l).
