conditional_architecture_derived(qn) :- conditional_architecture_derived(b), conditional_architecture_class_base(c, b), conditional_architecture_cclass(_, c, _, _, _, qn).
conditional_architecture_fn_in(f, c, cs) :- conditional_architecture_fn(d, f, fs, fe, _), conditional_architecture_class(d, c, cs, ce, _), cs < fs, ce >= fe.
conditional_architecture_fn_cls(f, c) :- conditional_architecture_fn_in(f, c, cs), cs = max u : { conditional_architecture_fn_in(f, _, u) }.
conditional_architecture_has_cls(f) :- conditional_architecture_fn_in(f, _, _).
conditional_architecture_meth_cand(d, c, nm, f, fs, fe) :- conditional_architecture_fn_cls(f, c), conditional_architecture_fn(d, f, fs, fe, nm).
conditional_architecture_cmethod(d, f, fs, fe, nm, c) :- conditional_architecture_meth_cand(d, c, nm, f, fs, fe), conditional_architecture_cclass(d, c, _, _, _, _), fs = max u : { conditional_architecture_meth_cand(d, c, nm, _, u, _) }.
conditional_architecture_cmethod_derived(f) :- conditional_architecture_cmethod(_, f, _, _, _, c), conditional_architecture_cclass(_, c, _, _, _, qn), conditional_architecture_derived(qn).
conditional_architecture_has_method(c, nm) :- conditional_architecture_cmethod(_, _, _, _, nm, c).
conditional_architecture_func_cand(d, nm, f, fs, fe) :- conditional_architecture_fn(d, f, fs, fe, nm), !conditional_architecture_has_cls(f).
conditional_architecture_cfunc(d, f, fs, fe, qn) :- conditional_architecture_func_cand(d, nm, f, fs, fe), fs = max u : { conditional_architecture_func_cand(d, nm, _, u, _) }, conditional_architecture_module(d, m), qn = @concat(@concat(m, "."), nm).
