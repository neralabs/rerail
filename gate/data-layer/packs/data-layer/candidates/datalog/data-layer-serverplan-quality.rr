quality_local_taxonomy_64(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c62), node(_, c62, "identifier", _, _), text(c62, s63), match("(?s:.*)(?:^(?:getattr)$)(?s:.*)", s63).
