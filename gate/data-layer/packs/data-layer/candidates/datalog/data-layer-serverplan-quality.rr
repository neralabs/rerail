violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_controls(n), conditional_architecture_own_fn(n, f), conditional_architecture_cmethod(d, f, _, _, _, _), conditional_architecture_cmethod_derived(f), doc(d, p, _), line(n, l).
violation("data-layer-serverplan-quality", "conditional-architecture", "SPQ-029", p, l) :- conditional_architecture_cclass(d, n, _, _, _, "l2070_batching.conditional_step.ConditionalStep"), !conditional_architecture_sem_contract_ok(n), conditional_architecture_present(_), doc(d, p, _), line(n, l).
