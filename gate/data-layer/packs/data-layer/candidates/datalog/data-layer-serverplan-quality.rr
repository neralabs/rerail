spq_runtime_state_annotations_chain(d, s, s, 0) :- spq_runtime_state_annotations_annscope(d, s).
spq_runtime_state_annotations_chain(d, s, f, @add(k, 1)) :- spq_runtime_state_annotations_annscope(d, s), spq_runtime_state_annotations_fnanc(s, f), k = count : { spq_runtime_state_annotations_between(s, f, _) }.
spq_runtime_state_annotations_chain(d, s, m, @add(k, 1)) :- spq_runtime_state_annotations_annscope(d, s), spq_runtime_state_annotations_root(d, m), s != m, k = count : { spq_runtime_state_annotations_fnanc(s, _) }.
spq_runtime_state_annotations_from_st(d, st, x) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_from_statement", _, _), field(st, "module_name", mn), node(_, mn, "dotted_name", _, _), text(mn, x).
spq_runtime_state_annotations_from_st(d, st, x) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_from_statement", _, _), field(st, "module_name", mn), node(_, mn, k, _, _), k != "dotted_name", node_text(mn, x).
spq_runtime_state_annotations_imp_src(d, st, x, @concat(@concat(mo, "."), x)) :- spq_runtime_state_annotations_from_st(d, st, mo), child(st, c, _), !field(st, "module_name", c), node(_, c, "dotted_name", _, _), text(c, x).
spq_runtime_state_annotations_imp_src(d, st, al, @concat(@concat(mo, "."), x)) :- spq_runtime_state_annotations_from_st(d, st, mo), child(st, c, _), !field(st, "module_name", c), node(_, c, "aliased_import", _, _), field(c, "name", nm), text(nm, x), field(c, "alias", an), text(an, al).
spq_runtime_state_annotations_seg_s(x) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_statement", _, _), child(st, c, _), node(_, c, "dotted_name", _, _), node_text(c, x).
spq_runtime_state_annotations_seg(x, h) :- spq_runtime_state_annotations_seg_s(x), match("[^.](?s:.*)", x), h = @rx_replace(x, "^([^.]+)(?s:.*)$", "$1").
spq_runtime_state_annotations_imp_src(d, st, h, h) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_statement", _, _), child(st, c, _), node(_, c, "dotted_name", _, _), node_text(c, x), spq_runtime_state_annotations_seg(x, h).
spq_runtime_state_annotations_imp_src(d, st, al, x) :- spq_runtime_state_annotations_doc(d), node(d, st, "import_statement", _, _), child(st, c, _), node(_, c, "aliased_import", _, _), field(c, "name", nm), text(nm, x), field(c, "alias", an), text(an, al).
spq_runtime_state_annotations_imp(d, s, x, o) :- spq_runtime_state_annotations_imp_src(d, st, x, o), nearest(st, s, spq_runtime_state_annotations_scope_kinds).
spq_runtime_state_annotations_imp(d, m, x, o) :- spq_runtime_state_annotations_imp_src(d, st, x, o), !inside(st, _, spq_runtime_state_annotations_scope_kinds), spq_runtime_state_annotations_root(d, m).
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, rr_kind_assignment), field(a, "left", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, rr_kind_augmented_assignment), field(a, "left", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, rr_kind_for_statement), field(a, "left", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, rr_kind_for_in_clause), field(a, "left", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(d, n, "identifier", ns, ne), inside(n, a, rr_kind_named_expression), field(a, "name", x), node(d, x, _, xs, xe), xs <= ns, ne <= xe.
spq_runtime_state_annotations_bound_ctx(n) :- node(_, n, "identifier", _, _), inside(n, _, rr_kind_delete_statement).
spq_runtime_state_annotations_bound_excl(n) :- field(p, "name", n), node(_, p, "function_definition", _, _).
spq_runtime_state_annotations_bound_excl(n) :- field(p, "name", n), node(_, p, "class_definition", _, _).
spq_runtime_state_annotations_bound_excl(n) :- field(p, "name", n), node(_, p, "keyword_argument", _, _).
spq_runtime_state_annotations_bound_excl(n) :- field(p, "attribute", n), node(_, p, "attribute", _, _).
spq_runtime_state_annotations_shadow_src(d, n, x) :- spq_runtime_state_annotations_doc(d), node(d, n, "identifier", _, _), spq_runtime_state_annotations_bound_ctx(n), !spq_runtime_state_annotations_bound_excl(n), text(n, x).
spq_runtime_state_annotations_shadow(d, s, x) :- spq_runtime_state_annotations_shadow_src(d, n, x), nearest(n, s, spq_runtime_state_annotations_scope_kinds).
spq_runtime_state_annotations_shadow(d, m, x) :- spq_runtime_state_annotations_shadow_src(d, n, x), !inside(n, _, spq_runtime_state_annotations_scope_kinds), spq_runtime_state_annotations_root(d, m).
spq_runtime_state_annotations_shadow(d, f, x) :- spq_runtime_state_annotations_doc(d), node(d, n, "identifier", _, _), child(pr, n, _), node(_, pr, "parameters", _, _), child(f, pr, _), node(_, f, "function_definition", _, _), text(n, x).
spq_runtime_state_annotations_shadow(d, f, x) :- spq_runtime_state_annotations_doc(d), node(d, n, "identifier", _, _), child(tp, n, 0), node(_, tp, k, _, _), spq_runtime_state_annotations_typed_param_kinds(k), child(pr, tp, _), node(_, pr, "parameters", _, _), child(f, pr, _), node(_, f, "function_definition", _, _), text(n, x).
spq_runtime_state_annotations_shadow(d, m, x) :- spq_runtime_state_annotations_scope_name(d, _, x), spq_runtime_state_annotations_root(d, m).
spq_runtime_state_annotations_shadow(d, m, x) :- spq_runtime_state_annotations_root(d, m), node(d, n, "identifier", _, _), child(g, n, _), node(_, g, "global_statement", _, _), text(n, x).
spq_runtime_state_annotations_shadow(d, f, x) :- spq_runtime_state_annotations_doc(d), node(d, n, "identifier", _, _), child(g, n, _), node(_, g, "nonlocal_statement", _, _), text(n, x), inside(n, f, rr_kind_function_definition).
spq_runtime_state_annotations_atom(d, a, @concat("name:", @to_string(ns)), ns, ne, x) :- node(d, n, "identifier", ns, ne), !spq_runtime_state_annotations_in_attr(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), text(n, x).
spq_runtime_state_annotations_dotted(n) :- node(_, n, "attribute", _, _), node_text(n, s), match("[A-Za-z_]\\w*(?:\\s*\\.\\s*[A-Za-z_]\\w*)*", s).
spq_runtime_state_annotations_atom(d, a, @concat(@concat(@concat("member:", @to_string(ns)), ":"), @to_string(ne)), ns, ne, v) :- node(d, n, "attribute", ns, ne), !spq_runtime_state_annotations_in_attr(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), spq_runtime_state_annotations_dotted(n), node_text(n, t), v = @rx_replace(t, "\\s+", "").
spq_runtime_state_annotations_atom(d, a, @concat(@concat(@concat("member:", @to_string(ns)), ":"), @to_string(ne)), ns, ne, x) :- node(d, n, "attribute", ns, ne), !spq_runtime_state_annotations_in_attr(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), !spq_runtime_state_annotations_dotted(n), field(n, "attribute", c), text(c, x).
spq_runtime_state_annotations_atom(d, a, @concat(@concat(@concat("member:", @to_string(ns)), ":"), @to_string(ne)), ns, ne, v) :- node(d, n, "attribute", ns, ne), !spq_runtime_state_annotations_dotted(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), spq_runtime_state_annotations_dotted(n), node_text(n, t), v = @rx_replace(t, "\\s+", "").
spq_runtime_state_annotations_atom(d, a, @concat(@concat(@concat("member:", @to_string(ns)), ":"), @to_string(ne)), ns, ne, x) :- node(d, n, "attribute", ns, ne), !spq_runtime_state_annotations_dotted(n), spq_runtime_state_annotations_in_type(d, n, a), spq_runtime_state_annotations_ann0(d, a), !spq_runtime_state_annotations_dotted(n), field(n, "attribute", c), text(c, x).
spq_runtime_state_annotations_qstr(d, s, a) :- node(d, s, "string", _, _), spq_runtime_state_annotations_in_type(d, s, a), spq_runtime_state_annotations_ann0(d, a).
spq_runtime_state_annotations_qstr(d, s, a) :- node(d, s, "concatenated_string", _, _), spq_runtime_state_annotations_in_type(d, s, a), spq_runtime_state_annotations_ann0(d, a).
spq_runtime_state_annotations_atom(d, a, @concat(@concat(@concat("quoted:", @to_string(ss)), ":"), x), ss, se, x) :- spq_runtime_state_annotations_qstr(d, s, a), node(d, s, _, ss, se), spq_runtime_state_annotations_node(s, n), node(_, n, "identifier", _, _), !spq_runtime_state_annotations_in_attr(n), text(n, x).
spq_runtime_state_annotations_atom(d, a, @concat(@concat(@concat("quoted:", @to_string(ss)), ":"), x), ss, se, x) :- spq_runtime_state_annotations_qstr(d, s, a), node(d, s, _, ss, se), spq_runtime_state_annotations_node(s, n), node(_, n, "attribute", _, _), !spq_runtime_state_annotations_in_attr(n), node_text(n, x).
spq_runtime_state_annotations_node(s, r) :- string_annotation(s), parsed(s, "annotation", r).
spq_runtime_state_annotations_node(s, n) :- string_annotation(s), parsed(s, "annotation", r), within(n, r).
spq_runtime_state_annotations_head_s(x) :- spq_runtime_state_annotations_atom(_, _, _, _, _, x).
spq_runtime_state_annotations_head(x, h) :- spq_runtime_state_annotations_head_s(x), match("[A-Za-z_](?s:.*)", x), h = @rx_replace(x, "^([A-Za-z_]\\w*)(?s:.*)$", "$1").
spq_runtime_state_annotations_need(d, s, h) :- spq_runtime_state_annotations_atom(d, a, _, _, _, x), spq_runtime_state_annotations_ann(d, a, s), spq_runtime_state_annotations_head(x, h).
spq_runtime_state_annotations_imp_depth(d, s, h, k) :- spq_runtime_state_annotations_need(d, s, h), spq_runtime_state_annotations_chain(d, s, f, k), spq_runtime_state_annotations_imp(d, f, h, _).
spq_runtime_state_annotations_first(d, s, h, k) :- spq_runtime_state_annotations_need(d, s, h), k = min j : { spq_runtime_state_annotations_imp_depth(d, s, h, j) }.
spq_runtime_state_annotations_shd_depth(d, s, h, j) :- spq_runtime_state_annotations_need(d, s, h), spq_runtime_state_annotations_chain(d, s, f, j), spq_runtime_state_annotations_shadow(d, f, h).
spq_runtime_state_annotations_shadowed(d, s, h) :- spq_runtime_state_annotations_first(d, s, h, k), spq_runtime_state_annotations_shd_depth(d, s, h, j), j <= k.
spq_runtime_state_annotations_ai(d, a, id, o) :- spq_runtime_state_annotations_atom(d, a, id, _, _, x), spq_runtime_state_annotations_ann(d, a, s), spq_runtime_state_annotations_head(x, h), spq_runtime_state_annotations_first(d, s, h, k), spq_runtime_state_annotations_chain(d, s, f, k), spq_runtime_state_annotations_imp(d, f, h, o).
spq_runtime_state_annotations_ai_any(d, a, id) :- spq_runtime_state_annotations_ai(d, a, id, _).
spq_runtime_state_annotations_trusted(d, a, id) :- spq_runtime_state_annotations_ai_any(d, a, id), spq_runtime_state_annotations_atom(d, a, id, _, _, x), spq_runtime_state_annotations_ann(d, a, s), spq_runtime_state_annotations_head(x, h), !spq_runtime_state_annotations_shadowed(d, s, h), c = count : { spq_runtime_state_annotations_ai(d, a, id, _) }, c = 1.
spq_runtime_state_annotations_res(d, a, id, xs, xe, x, @concat(o, @substr(x, @strlen(h), @sub(@strlen(x), @strlen(h))))) :- spq_runtime_state_annotations_atom(d, a, id, xs, xe, x), spq_runtime_state_annotations_ai(d, a, id, o), spq_runtime_state_annotations_head(x, h).
spq_runtime_state_annotations_res(d, a, id, xs, xe, x, x) :- spq_runtime_state_annotations_atom(d, a, id, xs, xe, x), !spq_runtime_state_annotations_ai_any(d, a, id).
spq_runtime_state_annotations_arg(d, a, xs, xe, bs, be, 1) :- node(d, tp, "type_parameter", _, _), child(g, tp, _), node(_, g, "generic_type", _, _), child(g, b, 0), node(d, b, _, bs, be), spq_runtime_state_annotations_in_type(d, tp, a), spq_runtime_state_annotations_ann0(d, a), child(tp, x, i), node(d, x, _, xs, xe).
spq_runtime_state_annotations_arg(d, a, xs, xe, bs, be, 0) :- node(d, tp, "type_parameter", _, _), child(g, tp, _), node(_, g, "generic_type", _, _), child(g, b, 0), node(d, b, _, bs, be), spq_runtime_state_annotations_in_type(d, tp, a), spq_runtime_state_annotations_ann0(d, a), child(tp, x, i), node(d, x, _, xs, xe), i >= 1.
spq_runtime_state_annotations_arg(d, a, xs, xe, bs, be, 0) :- node(d, tp, "type_parameter", _, _), child(g, tp, _), node(_, g, "generic_type", _, _), child(g, b, 0), node(d, b, _, bs, be), spq_runtime_state_annotations_in_type(d, tp, a), spq_runtime_state_annotations_ann0(d, a), child(tp, x, 0), node(d, x, _, xs, xe), token(tp, _, t, st, _), @substr(t, 0, 1) = "#", st < xs.
spq_runtime_state_annotations_ign(d, a, id) :- spq_runtime_state_annotations_res(d, a, id, xs, xe, _, _), spq_runtime_state_annotations_arg(d, a, gs, ge, bs, be, 1), xs >= gs, xe <= ge, spq_runtime_state_annotations_res(d, a, bid, bs, be, _, "typing.Literal"), spq_runtime_state_annotations_trusted(d, a, bid).
spq_runtime_state_annotations_ign(d, a, id) :- spq_runtime_state_annotations_res(d, a, id, xs, xe, _, _), spq_runtime_state_annotations_arg(d, a, gs, ge, bs, be, 1), xs >= gs, xe <= ge, spq_runtime_state_annotations_res(d, a, bid, bs, be, _, "typing_extensions.Literal"), spq_runtime_state_annotations_trusted(d, a, bid).
spq_runtime_state_annotations_ign(d, a, id) :- spq_runtime_state_annotations_res(d, a, id, xs, xe, _, _), spq_runtime_state_annotations_arg(d, a, gs, ge, bs, be, 0), xs >= gs, xe <= ge, spq_runtime_state_annotations_res(d, a, bid, bs, be, _, "typing.Annotated"), spq_runtime_state_annotations_trusted(d, a, bid).
spq_runtime_state_annotations_ign(d, a, id) :- spq_runtime_state_annotations_res(d, a, id, xs, xe, _, _), spq_runtime_state_annotations_arg(d, a, gs, ge, bs, be, 0), xs >= gs, xe <= ge, spq_runtime_state_annotations_res(d, a, bid, bs, be, _, "typing_extensions.Annotated"), spq_runtime_state_annotations_trusted(d, a, bid).
spq_runtime_state_annotations_conn_trusted(d, a, id, "data_layer.types.ConnectionId") :- spq_runtime_state_annotations_res(d, a, id, _, _, _, "data_layer.types.ConnectionId"), spq_runtime_state_annotations_trusted(d, a, id).
spq_runtime_state_annotations_conn_trusted(d, a, id, "l1350_foundational_types.ConnectionId") :- spq_runtime_state_annotations_res(d, a, id, _, _, _, "l1350_foundational_types.ConnectionId"), spq_runtime_state_annotations_trusted(d, a, id).
spq_runtime_state_annotations_conn_trusted(d, a, id, "l1400_types.ConnectionId") :- spq_runtime_state_annotations_res(d, a, id, _, _, _, "l1400_types.ConnectionId"), spq_runtime_state_annotations_trusted(d, a, id).
spq_runtime_state_annotations_hit(d, a) :- spq_runtime_state_annotations_res(d, a, id, _, _, _, o), match("(?s:.*)(?:(?:^|\\.)Callable(?:\\.|$))(?s:.*)", o), !spq_runtime_state_annotations_ign(d, a, id).
spq_runtime_state_annotations_hit(d, a) :- spq_runtime_state_annotations_res(d, a, id, _, _, _, o), !spq_runtime_state_annotations_conn_trusted(d, a, id, o), match("(?s:.*)(?:AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction)(?s:.*)", o), !spq_runtime_state_annotations_ign(d, a, id).
violation("data-layer-serverplan-quality", "spq-runtime-state-annotations", "SPQ-050", p, l) :- spq_runtime_state_annotations_hit(d, a), doc(d, p, _), line(a, l).
violation("data-layer-serverplan-quality", "strategy-file-size", "SPQ-010", p, l) :- doc(d, p, _), in_scope(d), !out_scope(d), strategy_file_size_entry(e), option_value("entryPoint", e), glob("impl/common/l2070_server_plan/strategies/**/*.py", p), source(d, sp), match_group("\\A(?:[^\\n\\r\\v\\f\\x1c-\\x1e\\x85\\x{2028}\\x{2029}]*(?:\\r\\n|[\\n\\r\\v\\f\\x1c-\\x1e\\x85\\x{2028}\\x{2029}])){1500}(?<OVERFLOW>[^\\n\\r\\v\\f\\x1c-\\x1e\\x85\\x{2028}\\x{2029}]+|[\\n\\r\\v\\f\\x1c-\\x1e\\x85\\x{2028}\\x{2029}])", sp, _, "OVERFLOW", g), line(g, l).
