.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl name(n: node, s: sym)
.decl strprefix(n: node, s: sym)
.decl line(n: node, l: int)
.decl syntax_error(d: int)
.input doc, node, child, field, text, name, strprefix, line, syntax_error
.kindset k0 = "class_definition"
.kindset k1 = "module"
.kindset k2 = "import_from_statement"
.decl blocked6(low: node, high: node)
.decl in_scope(d: int)
.decl m10(n: node)
.decl m21(n: node)
.decl m42(n: node)
.decl m45(n: node)
.decl m46(n: node)
.decl out_scope(d: int)
.decl u25(n: node)
.decl u30(n: node)
.decl u7(n: node)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "api/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "data_layer/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "_internal/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l[0-9]*/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
violation("data-layer-grammar-fragment-usage", "forbidden-class", "sqlfragment_usage", $p, $l) :- node(_, $n, "class_definition", _, _), field($n, "name", $v1), node(_, $v1, "identifier", _, _), text($v1, $v2), $v2 in {"SqlDeferredRenderable", "SqlPreRenderedFragment"}, node($d, $n, _, _, _), in_scope($d), !syntax_error($d), !out_scope($d), doc($d, $p, _), line($n, $l).
blocked6($low, $high) :- inside($low, $s, k0), node(_, $s, "class_definition", _, _), inside($s, $high, k0).
m10($n) :- field($n, "name", $v8), node(_, $v8, "identifier", _, _), text($v8, $v9), $v9 in {"SqlDeferredRenderable", "SqlFragment", "SqlPreRenderedFragment"}.
m21($n) :- node(_, $n, "function_definition", _, _), field($n, "name", $v16), node(_, $v16, "identifier", _, _), text($v16, $v17), $v17 = "render".
m21($n) :- node(_, $n, "decorated_definition", _, _), field($n, "definition", $v18), node(_, $v18, "function_definition", _, _), field($v18, "name", $v19), node(_, $v19, "identifier", _, _), text($v19, $v20), $v20 = "render".
u30($n) :- inside($v31, $n, k2), node(_, $v31, "import_from_statement", _, _), child($v31, $v32, _), node(_, $v32, "aliased_import", _, _), field($v32, "name", $v33), name($v33, $v34), @glob($v34, {"*.SqlFragment", "SqlFragment"}).
m42($n) :- strprefix($n, $v41), @contains($v41, "f").
m45($n) :- child($n, $v43, _), node(_, $v43, "string", _, _), strprefix($v43, $v44), @contains($v44, "f").
m46($n) :- node(_, $n, "string", _, _), !m42($n).
m46($n) :- node(_, $n, "concatenated_string", _, _), !m45($n).
violation("data-layer-grammar-fragment-usage", "syntax-error", "python_parse_error", $p, 1) :- node(_, $n, "module", _, _), node($d, $n, _, _, _), in_scope($d), syntax_error($d), !out_scope($d), doc($d, $p, _).
.output violation
