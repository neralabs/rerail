.input doc, node, child, field, text, name, line, syntax_error, value, value_type_of
.output violation
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/conform/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.pytest_cache/**", p).
out_scope(d) :- doc(d, p, _), glob("**/node_modules/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/browser_build/**", p).
tape_syntax_error(d) :- syntax_error(d).
t5(s) :- doc(_, s, _), (glob("**/test_*", s) ; glob("**/tests/**", s)).
t5(s) :- doc(_, _, s), (glob("**/test_*", s) ; glob("**/tests/**", s)).
violation("data-layer-history-serverplan-projection", "from-imports", "HSP-001", p, l) :- node(v1, n, _, _, _), doc(v1, v2, _), (prefix("impl/", v2) ; prefix("l7200_versioned_transactions/", v2)), node(v3, n, _, _, _), doc(v3, v4, _), !t5(v4), node(_, n, "import_from_statement", _, _), field(n, "module_name", v6), name(v6, v8), v8 = "impl.common.l2070_server_plan.steps.history_runtime_projection", node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
t13(s) :- doc(_, s, _), (glob("**/test_*", s) ; glob("**/tests/**", s)).
t13(s) :- doc(_, _, s), (glob("**/test_*", s) ; glob("**/tests/**", s)).
m19(n) :- child(n, v14, _), node(_, v14, "dotted_name", _, _), text(v14, v15), suffix("history_runtime_projection", v15).
m19(n) :- child(n, v16, _), node(_, v16, "aliased_import", _, _), field(v16, "name", v17), node(_, v17, "dotted_name", _, _), text(v17, v18), suffix("history_runtime_projection", v18).
violation("data-layer-history-serverplan-projection", "imports", "HSP-001", p, l) :- node(v9, n, _, _, _), doc(v9, v10, _), (prefix("impl/", v10) ; prefix("l7200_versioned_transactions/", v10)), node(v11, n, _, _, _), doc(v11, v12, _), !t13(v12), node(_, n, "import_statement", _, _), m19(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
t24(s) :- doc(_, s, _), (glob("**/test_*", s) ; glob("**/tests/**", s)).
t24(s) :- doc(_, _, s), (glob("**/test_*", s) ; glob("**/tests/**", s)).
m31(n) :- node(_, n, "identifier", _, _), text(n, v28), v28 = "CompiledStep".
m31(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v29), node(_, v29, "identifier", _, _), text(v29, v30), v30 = "CompiledStep".
violation("data-layer-history-serverplan-projection", "post-op-refs", "HSP-004", p, l) :- node(v20, n, _, _, _), doc(v20, v21, _), (prefix("impl/", v21) ; prefix("l7200_versioned_transactions/", v21)), node(v22, n, _, _, _), doc(v22, v23, _), !t24(v23), node(v25, n, _, _, _), doc(v25, v26, _), (glob("impl/common/l2070_server_plan/steps/*/**/*/*history*.py", v26) ; glob("impl/common/l2070_server_plan/steps/*/*history*.py", v26) ; glob("impl/common/l2070_server_plan/steps/*history*.py", v26)), node(_, n, "call", _, _), field(n, "function", v27), m31(v27), field(n, "arguments", v32), child(v32, v33, _), node(_, v33, "keyword_argument", _, _), field(v33, "name", v34), node(_, v34, "identifier", _, _), text(v34, v35), v35 = "post_op_with_refs", node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
history_runtime_file(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), match("impl/common/l2070_server_plan/steps/(?:.*/)?[^/]*history[^/]*\\.py", p), !match("(?s:.*)(?:(?:^|/)tests/|(?:^|/)test_[^/]*$)(?s:.*)", p).
history_runtime_shape(n) :- node(_, n, "return_statement", _, _), child(n, c, _), node(_, c, "string", _, _).
history_runtime_shape(n) :- node(_, n, "return_statement", _, _), child(n, c, _), node(_, c, "set", _, _).
history_runtime_shape(n) :- node(_, n, "return_statement", _, _), child(n, c, _), node(_, c, "tuple", _, _).
history_runtime_shape(n) :- node(_, n, "return_statement", _, _), child(n, c, _), node(_, c, "list", _, _).
history_runtime_shape(n) :- node(_, n, "return_statement", _, _), child(n, c, _), node(_, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, "frozenset").
history_runtime_word(n, v) :- node(_, s, "string", _, _), value(s, v), value_type_of(s, "str"), inside(s, n, history_runtime_ret).
violation("data-layer-history-serverplan-projection", "history-runtime", "HSP-002", p, l) :- history_runtime_shape(n), history_runtime_word(n, "history"), history_runtime_word(n, "runtime"), node(d, n, _, _, _), history_runtime_file(d, p), line(n, l).
violation("data-layer-history-serverplan-projection", "sentinel", "HSP-003", p, l) :- history_runtime_shape(n), history_runtime_word(n, "__history_runtime__"), node(d, n, _, _, _), history_runtime_file(d, p), line(n, l).
