in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("data_layer/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("_internal/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l[0-9][0-9][0-9][0-9]_*/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/conform/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.pytest_cache/**", p).
out_scope(d) :- doc(d, p, _), glob("**/node_modules/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/browser_build/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test_*.py", p).
tape_syntax_error(d) :- syntax_error(d).
cpl_doc(d, t) :- doc(d, _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), node(d, m, "module", _, _), node_text(m, t).
cached_gate(d) :- cpl_doc(d, t), cached_gate_re(r), x = @concat(@concat("(?s:.*)(?:", r), ")(?s:.*)"), match(x, t).
memo_gate(d) :- cpl_doc(d, t), memo_gate_re(r), x = @concat(@concat("(?s:.*)(?:", r), ")(?s:.*)"), match(x, t).
cpl_gdoc(d) :- cached_gate(d).
cpl_gdoc(d) :- memo_gate(d).
cpl_kid(p, c) :- child(p, c, _), node(d, c, k, _, _), cpl_gdoc(d), !cpl_excl(k).
cpl_raw(n, r) :- cpl_canon_k(k), node(d, n, k, _, _), cpl_gdoc(d), node_text(n, r).
cpl_txt(n, r) :- cpl_raw(n, r), match("[\\x00-\\x7f]*", r).
cpl_txt(n, t) :- cpl_raw(n, r), !match("[\\x00-\\x7f]*", r), t = @nfkc(@rx_replace(r, "\\\\\\r?\\n|\\s+", "")).
cpl_attr(a, x) :- node(d, a, "attribute", _, _), cpl_gdoc(d), field(a, "attribute", i), cpl_txt(i, x).
cpl_attr_field(n) :- node(d, a, "attribute", _, _), cpl_gdoc(d), field(a, "attribute", n).
cpl_attr_object(n) :- node(d, a, "attribute", _, _), cpl_gdoc(d), field(a, "object", n).
cpl_call(d, c, f, fk) :- node(d, c, "call", _, _), cpl_gdoc(d), field(c, "function", f), node(_, f, fk, _, _).
cpl_callee(c, x) :- cpl_call(_, c, f, "identifier"), cpl_txt(f, x).
cpl_callee(c, x) :- cpl_call(_, c, f, "attribute"), cpl_attr(f, x).
cpl_callfn(f) :- cpl_call(_, _, f, _).
cpl_posarg(c, a) :- cpl_call(_, c, _, _), field(c, "arguments", al), node(_, al, ak, _, _), ak != "generator_expression", cpl_kid(al, a), node(_, a, k, _, _), !cpl_nonpos_k(k).
cpl_posarg(c, al) :- cpl_call(_, c, _, _), field(c, "arguments", al), node(_, al, "generator_expression", _, _).
cpl_isposarg(a) :- cpl_posarg(_, a).
cpl_kwnode(c, k) :- cpl_call(_, c, _, _), field(c, "arguments", al), cpl_kid(al, k), node(_, k, "keyword_argument", _, _).
cpl_kw(c, x, v) :- cpl_kwnode(c, k), field(k, "name", kn), cpl_txt(kn, x), field(k, "value", v).
cpl_assign(d, a, l, lk) :- node(d, a, "assignment", _, _), cpl_gdoc(d), field(a, "left", l), node(_, l, lk, _, _).
cpl_assign_target(l) :- cpl_assign(_, _, l, _).
cpl_assign_value(r) :- cpl_assign(_, a, _, _), field(a, "right", r).
cpl_module(d, m) :- cpl_gdoc(d), doc(d, p, _), match("(?:.*?/)??(?:l[0-9]{4}_[^/]+|impl|_internal|data_layer)/.*\\.py", p), m = @rx_replace(@rx_replace(p, "^(?:.*?/)??((?:l[0-9]{4}_[^/]+|impl|_internal|data_layer)/.*)\\.py$", "${1}"), "/", ".").
cpl_module(d, m) :- cpl_gdoc(d), doc(d, p, _), !match("(?:.*?/)??(?:l[0-9]{4}_[^/]+|impl|_internal|data_layer)/.*\\.py", p), m = @rx_replace(@substr(p, 0, @sub(@strlen(p), 3)), "/", ".").
cpl_decorated(n) :- cpl_decl_k(k), node(d, n, k, _, _), cpl_gdoc(d), child(w, n, _), node(_, w, "decorated_definition", _, _).
cpl_region(n, rs) :- cpl_decl_k(k), node(d, n, k, _, _), cpl_gdoc(d), child(w, n, _), node(_, w, "decorated_definition", rs, _).
cpl_region(n, s) :- cpl_decl_k(k), node(d, n, k, s, _), cpl_gdoc(d), !cpl_decorated(n).
cpl_decl(d, n, k, x, rs, e) :- cpl_decl_k(k), node(d, n, k, _, e), cpl_gdoc(d), field(n, "name", nm), cpl_txt(nm, x), cpl_region(n, rs).
cpl_misplaced(f) :- cpl_decl(_, f, "function_definition", _, _, _), child(p, f, _), node(_, p, pk, _, _), !cpl_stmt_parent_k(pk).
cpl_misplaced(f) :- cpl_decl(_, f, "function_definition", _, _, _), child(w, f, _), node(_, w, "decorated_definition", _, _), child(p, w, _), node(_, p, pk, _, _), !cpl_stmt_parent_k(pk).
cpl_eligible(f) :- cpl_decl(_, f, "function_definition", _, _, _), !cpl_misplaced(f).
cpl_dpart(d, a, rs, e, p) :- cpl_decl(d, a, "function_definition", x, rs, e), p = @concat(x, ".<locals>").
cpl_dpart(d, a, rs, e, x) :- cpl_decl(d, a, "class_definition", x, rs, e).
cpl_named(f) :- cached_sel(_, f, _).
cpl_named(f) :- memo_sel(_, f, _).
cpl_encl(f, ars, p) :- cpl_named(f), cpl_decl(d, f, _, _, rs, e), cpl_dpart(d, _, ars, ae, p), ars < rs, ae >= e.
cpl_qual(f, j) :- cpl_named(f), j = join p by (ars) sep "." : { cpl_encl(f, ars, p) }.
cpl_fname(f, fq) :- cpl_qual(f, ""), cpl_decl(d, f, _, x, _, _), cpl_module(d, m), fq = @concat(@concat(m, "."), x).
cpl_fname(f, fq) :- cpl_qual(f, j), j != "", cpl_decl(d, f, _, x, _, _), cpl_module(d, m), fq = @concat(@concat(@concat(@concat(m, "."), j), "."), x).
cpl_dec_walk(f, dec, x) :- cpl_decl(_, f, _, _, _, _), child(w, f, _), node(_, w, "decorated_definition", _, _), cpl_kid(w, dec), node(_, dec, "decorator", _, _), cpl_kid(dec, x).
cpl_dec_walk(f, dec, y) :- cpl_dec_walk(f, dec, x), cpl_call(_, x, y, _).
cpl_dec_name(f, dec, x, nm) :- cpl_dec_walk(f, dec, x), node(_, x, "identifier", _, _), cpl_txt(x, nm).
cpl_dec_name(f, dec, x, nm) :- cpl_dec_walk(f, dec, x), cpl_attr(x, nm).
cpl_body(f, bs, be) :- cpl_decl(_, f, "function_definition", _, _, _), field(f, "body", b), node(_, b, _, bs, be).
cpl_params(f, ps, s, e) :- cpl_decl(_, f, "function_definition", _, _, _), field(f, "parameters", ps), node(_, ps, _, s, e).
cached_on(0) :- option_value("entryPoint", "policy_violations").
cached_on(0) :- option_value("entryPoint", "all").
cached_import_name(a, x) :- node(d, a, "aliased_import", _, _), cpl_gdoc(d), field(a, "name", c), cpl_txt(c, x).
cached_import_name(a, x) :- cpl_raw(a, _), cpl_txt(a, x).
cached_import_alias(a, x) :- node(d, a, "aliased_import", _, _), cpl_gdoc(d), field(a, "alias", c), cpl_txt(c, x).
cached_import_alias(a, x) :- cached_import_name(a, x), !cpl_hasalias(a).
cpl_hasalias(a) :- node(d, a, "aliased_import", _, _), cpl_gdoc(d), field(a, "alias", _).
cached_alias(d, "cached_pure_lazy") :- cached_gate(d).
cached_alias(d, x) :- cached_gate(d), node(d, i, "import_from_statement", _, _), field(i, "module_name", mn), cpl_txt(mn, "l2055_lazy_result.purity"), cpl_kid(i, a), cached_import_name(a, "cached_pure_lazy"), cached_import_alias(a, x).
cached_alias(d, x) :- cached_gate(d), cpl_assign(d, a, l, "identifier"), cpl_txt(l, x), field(a, "right", r), cpl_attr(r, "cached_pure_lazy").
cached_alias(d, x) :- cpl_assign(d, a, l, "identifier"), cpl_txt(l, x), field(a, "right", r), node(_, r, "identifier", _, _), cpl_txt(r, y), cached_alias(d, y).
cached_sel(d, f, c) :- cached_gate(d), cpl_decl(d, f, "function_definition", _, _, _), cpl_eligible(f), cpl_dec_name(f, dec, x, "cached_pure_lazy"), cpl_call(_, c, x, _), cpl_kid(dec, c).
cached_sel(d, f, c) :- cached_gate(d), cpl_decl(d, f, "function_definition", _, _, _), cpl_eligible(f), cpl_dec_name(f, dec, x, nm), cpl_call(_, c, x, "identifier"), cpl_kid(dec, c), cached_alias(d, nm).
cached_strnode(d, n, s) :- cached_gate(d), cached_str_k(k), node(d, n, k, s, _), node_text(n, t), match("(?i:[ru]*[\"'])(?s:.*)", t).
cached_str(d, s, v) :- cached_strnode(d, n, s), value(n, v).
cached_str(d, s, "") :- cached_strnode(d, n, s), !value(n, _).
cached_kwcount(c, k) :- cached_sel(_, _, c), k = count : { cpl_kwnode(c, _) }.
cached_badcontainer(v) :- cached_sel(_, _, c), cpl_kw(c, "cache_args", v), cpl_kid(v, el), node(_, el, k, _, _), !cached_str_k(k).
cached_el(v, el, s) :- cached_sel(_, _, c), cpl_kw(c, "cache_args", v), node(_, v, vk, _, _), cached_container_k(vk), cpl_kid(v, el), node(_, el, _, s, _).
rr_ctx2(s, v) :- cached_el(v, _, s).
rr_agg1(os, s, v) :- rr_ctx2(s, v), cached_el(v, _, os), os < s.
cached_elpos(v, s, i) :- cached_el(v, _, s), i = count : { rr_agg1(_, s, v) }.
cached_arg(f, i, x) :- cached_sel(d, f, c), cpl_kw(c, "cache_args", v), cached_el(v, _, s), !cpl_isposarg_of(c), cached_kwcount(c, 1), !cached_badcontainer(v), cached_str(d, s, x), cached_elpos(v, s, i).
cpl_isposarg_of(c) :- cpl_posarg(c, _).
cached_param(f, p, "identifier", x, s) :- cached_sel(_, f, _), cpl_params(f, ps, _, _), cpl_kid(ps, p), node(_, p, "identifier", s, _), cpl_txt(p, x).
rr_agg3(p, s2) :- cpl_kid(p, o), node(_, o, _, s2, _).
cached_param(f, p, k, x, s) :- cached_sel(_, f, _), cpl_params(f, ps, _, _), cpl_kid(ps, p), node(_, p, k, s, _), cached_param_k(k), cpl_kid(p, c), node(_, c, "identifier", cs, _), first = min s2 : { rr_agg3(p, s2) }, cs = first, cpl_txt(c, x).
cached_name(f, n) :- cached_sel(d, f, _), cpl_body(f, bs, be), node(d, n, "identifier", s, e), s >= bs, e <= be, cpl_txt(n, x), cached_arg(f, _, x), !cpl_attr_field(n).
cpl_apath(a, x, m) :- cpl_attr(a, m), field(a, "object", o), node(_, o, "identifier", _, _), cpl_txt(o, x).
cpl_apath(a, x, m) :- field(a, "object", o), cpl_apath(o, x, m0), cpl_attr(a, y), m = @concat(@concat(m0, "."), y).
cached_cand(f, a, m, pk, par) :- cached_sel(d, f, _), cpl_body(f, bs, be), node(d, a, "attribute", s, e), s >= bs, e <= be, cpl_apath(a, x, m), cached_arg(f, _, x), child(par, a, _), node(_, par, pk, _, _), !cpl_attr_object(a).
cached_mode(a, "call") :- cached_cand(_, a, _, _, _), cpl_callfn(a).
cached_mode(a, "resolver") :- cached_cand(_, a, _, _, _), !cpl_callfn(a), cpl_isposarg(a).
cached_mode(a, "read") :- cached_cand(_, a, _, _, _), !cpl_callfn(a), !cpl_isposarg(a).
cached_mutated(a) :- cached_cand(_, a, _, _, _), cpl_assign_target(a).
cached_mutated(a) :- cached_cand(_, a, _, "delete_statement", _).
cached_aliased(a) :- cached_cand(_, a, _, _, _), cpl_assign_value(a).
cached_mem(f, mm, mo) :- cached_cand(f, a, m, _, _), !cached_mutated(a), !cached_aliased(a), !cached_dunder(m), cached_mode(a, mo), mm = @rx_replace(m, "\\s+", "").
cpl_top_assign(d, a) :- cpl_assign(d, a, _, _), child(st, a, _), child(m, st, _), node(_, m, "module", _, _).
cached_gwalk(a, r) :- cpl_top_assign(d, a), cached_gate(d), field(a, "right", r).
cached_gwalk(a, c) :- cached_gwalk(a, n), node(_, n, k, _, _), cached_walk_k(k), cpl_kid(n, c).
cached_gwalk(a, c) :- cached_gwalk(a, n), node(_, n, "call", _, _), field(n, "arguments", al), cpl_kid(al, c).
cpl_haskw(c) :- cpl_kwnode(c, _).
cached_immutable(n) :- cached_gwalk(_, n), node(_, n, k, _, _), cached_imm_k(k).
cached_immutable(n) :- cached_gwalk(_, n), node(_, n, k, _, _), cached_str_k(k), node_text(n, t), !match("(?i:f|rf|fr)(?s:.*)", t).
cached_immutable(n) :- cached_gwalk(_, n), cpl_call(_, n, fn, "identifier"), cpl_txt(fn, "frozenset"), !cpl_haskw(n).
cached_mglobal(d, x) :- cpl_top_assign(d, a), cpl_assign(d, a, l, "identifier"), cpl_txt(l, x), cached_gwalk(a, n), !cached_immutable(n).
cached_pcall_a(d, c) :- cpl_callee(c, "cached_pure_lazy"), cpl_call(d, c, _, _), cached_gate(d).
cached_pcall_a(d, c) :- cpl_call(d, c, f, "identifier"), cached_gate(d), cpl_txt(f, x), cached_alias(d, x).
cached_pcall_k(d, c) :- cpl_kw(c, "cache_args", _), cpl_call(d, c, _, _), cached_gate(d).
cached_pdec(c) :- cpl_dec_name(_, dec, x, "cached_pure_lazy"), cpl_call(_, c, x, _), cpl_kid(dec, c).
cached_pdec(c) :- cpl_dec_name(_, dec, x, nm), cpl_call(d, c, x, "identifier"), cpl_kid(dec, c), cached_alias(d, nm).
cpl_entry_ctor(c) :- cpl_callee(c, "CachedPureLazyPolicyEntry").
cached_pseudo(d, c, fq, "cached_pure_lazy must use decorator syntax") :- cached_pcall_a(d, c), !cpl_entry_ctor(c), !cached_pdec(c), cpl_module(d, m), line(c, l), col(c, k), fq = @concat(@concat(@concat(@concat(@concat(m, ".<unsupported_cached_pure_lazy_call_"), @to_string(l)), "_"), @to_string(k)), ">").
cached_pseudo(d, c, fq, "unresolved cache decorator alias is forbidden") :- cached_pcall_k(d, c), !cached_pcall_a(d, c), !cpl_entry_ctor(c), !cached_pdec(c), cpl_module(d, m), line(c, l), col(c, k), fq = @concat(@concat(@concat(@concat(@concat(m, ".<unsupported_cached_pure_lazy_call_"), @to_string(l)), "_"), @to_string(k)), ">").
cached_escape_cand(d, n) :- cached_gate(d), node(d, n, "identifier", _, _), cpl_txt(n, x), cached_alias(d, x).
cached_escape_cand(d, n) :- cached_gate(d), node(d, n, "attribute", _, _), cpl_attr(n, "cached_pure_lazy").
cached_escape_slot(n) :- cached_escape_cand(_, n), node(_, n, "identifier", _, _), child(p, n, _), node(_, p, "parameters", _, _).
cached_escape_slot(n) :- cached_escape_cand(_, n), node(_, n, "identifier", _, _), field(p, "name", n), node(_, p, pk, _, _), cached_named_parent_k(pk).
cached_escape_slot(n) :- cached_escape_cand(_, n), node(_, n, "identifier", _, _), cpl_attr_field(n).
cached_pseudo(d, n, fq, "cached_pure_lazy cannot escape as a first-class value") :- cached_escape_cand(d, n), child(par, n, _), node(_, par, pk, _, _), !cached_import_parent_k(pk), pk != "delete_statement", !cached_escape_slot(n), !cpl_callfn(n), !cpl_assign_target(n), !cpl_assign_value(n), cpl_module(d, m), line(n, l), col(n, k), fq = @concat(@concat(@concat(@concat(@concat(m, ".<escaped_cached_pure_lazy_reference_"), @to_string(l)), "_"), @to_string(k)), ">").
cached_err(f, "cached pure-lazy functions must be synchronous") :- cached_sel(_, f, _), node_text(f, t), match("async\\s(?s:.*)", t).
cached_err(f, "cached pure-lazy functions cannot use variadic arguments") :- cached_sel(d, f, _), cpl_params(f, _, ps, pe), node(d, _, k, s, e), cpl_splat_k(k), s >= ps, e <= pe.
cached_err(f, "cached pure-lazy functions cannot be generators") :- cached_sel(d, f, _), cpl_body(f, bs, be), node(d, _, "yield", s, e), s >= bs, e <= be.
cached_err(f, "a cache argument can only be used through signed member access") :- cached_name(f, n), !cpl_attr_object(n).
cached_err(f, "a cache argument cannot escape through return") :- cached_sel(d, f, _), cpl_body(f, bs, be), node(d, r, "return_statement", rs, re), rs >= bs, re <= be, cpl_kid(r, _), cached_name(f, n), node(_, n, _, ns, ne), ns >= rs, ne <= re.
cached_err(f, "cached pure-lazy functions cannot write mutable global state") :- cached_sel(d, f, _), cpl_body(f, bs, be), node(d, _, k, s, e), cached_globalstmt_k(k), s >= bs, e <= be.
cached_err(f, s) :- cached_cand(f, a, m, _, _), cached_mutated(a), s = @concat(@concat("direct cache attribute mutation '", @rx_replace(m, "'", "''")), "' is forbidden").
cached_err(f, s) :- cached_cand(f, a, m, _, _), cached_aliased(a), s = @concat(@concat("cache member alias '", @rx_replace(m, "'", "''")), "' is forbidden").
cached_err(f, s) :- cached_cand(f, _, m, "subscript", sub), cached_submut(sub), s = @concat(@concat("cache subscript mutation through '", @rx_replace(m, "'", "''")), "' is forbidden").
cached_err(f, s) :- cached_cand(f, _, m, "subscript", sub), !cached_submut(sub), s = @concat(@concat("cache subscript access through '", @rx_replace(m, "'", "''")), "' is forbidden").
cached_err(f, s) :- cached_cand(f, _, m, _, _), cached_dunder(m), s = @concat(@concat("dynamic cache access '", m), "' is forbidden").
cached_err(f, s) :- cached_arg(f, _, x), !cached_annotated(f, x), s = @concat(@concat("cache argument '", @rx_replace(x, "'", "''")), "' requires an exact annotation").
cached_err(f, s) :- cached_arg(f, _, x), cached_param(f, _, k, x, _), cached_default_k(k), s = @concat(@concat("cache argument '", @rx_replace(x, "'", "''")), "' cannot have a default").
cached_err(f, s) :- cached_arg(f, _, x), x != "self", cached_param(f, p, _, x, _), !cached_star_before(f, p), s = @concat(@concat("cache argument '", @rx_replace(x, "'", "''")), "' must be keyword-only").
cached_err(f, "a cache argument cannot be captured by a closure") :- cached_sel(d, f, _), cpl_body(f, bs, be), node(d, _, k, cs, ce), cached_closure_k(k), cs >= bs, ce <= be, cached_name(f, n), node(_, n, _, ns, ne), ns >= cs, ne <= ce.
cached_err(f, s) :- cached_sel(d, f, _), cpl_body(f, bs, be), cpl_call(d, c, fn, "identifier"), node(_, c, _, s0, e0), s0 >= bs, e0 <= be, cpl_txt(fn, x), cached_reflective(x), cpl_posarg(c, a), node(_, a, _, a0, a1), cached_name(f, n), node(_, n, _, ns, ne), ns >= a0, ne <= a1, s = @concat(x, "() on a cache argument is forbidden").
cached_err(f, s) :- cached_sel(d, f, _), cached_mglobal(d, x), cpl_decl(d, f, _, _, rs, _), cpl_body(f, _, be), node(d, n, "identifier", ns, ne), ns >= rs, ne <= be, cpl_txt(n, x), child(par, n, _), node(_, par, pk, _, _), !cached_globalstmt_k(pk), !cpl_attr_field(n), !cpl_assign_target(n), s = @concat(@concat("cached pure-lazy functions cannot read mutable global state '", @rx_replace(x, "'", "''")), "'").
cached_err(n, e) :- cached_pseudo(_, n, _, e).
cached_submut(sub) :- cached_cand(_, _, _, "subscript", sub), cpl_assign_target(sub).
cached_submut(sub) :- cached_cand(_, _, _, "subscript", sub), child(p, sub, _), node(_, p, "delete_statement", _, _).
cached_annotated(f, x) :- cached_param(f, p, _, x, _), field(p, "type", _).
cached_star(f, s) :- cached_sel(_, f, _), cpl_params(f, ps, _, _), cpl_kid(ps, st), node(_, st, k, s, _), cached_star_k(k).
cached_star_before(f, p) :- cached_param(f, p, _, _, ps), cached_star(f, s), s < ps.
cached_rec(d, f, fq, bh, sh, s) :- cached_sel(d, f, _), cpl_fname(f, fq), body_sha256(f, bh), signature_sha256(f, sh), node(d, f, _, s, _).
cached_rec(d, n, fq, h, h, s) :- cached_pseudo(d, n, fq, _), dump_sha256(n, h), node(d, n, _, s, _).
cached_newer(n) :- cached_rec(d, n, fq, _, _, _), cached_rec(d2, _, fq, _, _, _), doc(d, p, _), doc(d2, p2, _), p2 > p.
cached_newer(n) :- cached_rec(d, n, fq, _, _, s), cached_rec(d, _, fq, _, _, s2), s2 > s.
cached_eff(n, fq, bh, sh) :- cached_rec(_, n, fq, bh, sh, _), !cached_newer(n).
cached_effn(fq) :- cached_eff(_, fq, _, _).
cached_leaf(i, r, v) :- option_value("entryPoint", "policy_violations"), option_json("policyEntries", p, v), match("/[0-9]+/(?s:.*)", p), i = @rx_replace(p, "^/([0-9]+)/(?s:.*)$", "${1}"), r = @rx_replace(p, "^/[0-9]+/", "").
cached_leaf(i, r, v) :- option_value("entryPoint", "all"), cached_default(i, r, v).
cached_pfn(i, fq) :- cached_leaf(i, "function", fq).
cached_pnewer(fq, i) :- cached_pfn(i, fq), cached_pfn(j, fq), @strlen(j) > @strlen(i).
cached_pnewer(fq, i) :- cached_pfn(i, fq), cached_pfn(j, fq), @strlen(j) = @strlen(i), j > i.
cached_pe(fq, i) :- cached_pfn(i, fq), !cached_pnewer(fq, i).
cached_pv(fq, r, v) :- cached_pe(fq, i), cached_leaf(i, r, v).
cached_pa(fq, j, x) :- cached_pv(fq, r, x), match("cache_args/[0-9]+", r), j = @rx_replace(r, "^cache_args/", "").
cached_paname(fq, x) :- cached_pa(fq, _, x).
cached_ptn(fq, j, x) :- cached_pv(fq, r, x), match("cache_types/[0-9]+/0", r), j = @rx_replace(@rx_replace(r, "^cache_types/", ""), "/0$", "").
cached_ptname(fq, x) :- cached_ptn(fq, _, x).
cached_ptt(fq, j, t) :- cached_pv(fq, r, t), match("cache_types/[0-9]+/1", r), j = @rx_replace(@rx_replace(r, "^cache_types/", ""), "/1$", "").
cached_pmm(fq, j, m) :- cached_pv(fq, r, m), match("allowed_cache_members/[0-9]+/0", r), j = @rx_replace(@rx_replace(r, "^allowed_cache_members/", ""), "/0$", "").
cached_pmo(fq, j, mo) :- cached_pv(fq, r, mo), match("allowed_cache_members/[0-9]+/1", r), j = @rx_replace(@rx_replace(r, "^allowed_cache_members/", ""), "/1$", "").
cached_pmem(fq, j, m, mo) :- cached_pmm(fq, j, m), cached_pmo(fq, j, mo).
cached_signed(n, fq) :- cached_eff(n, fq, _, _), cached_pe(fq, _).
cached_aarg(n, j, x) :- cached_arg(n, i, x), j = @to_string(i).
cached_ann(f, x, a) :- cached_arg(f, _, x), cached_param(f, p, _, x, _), field(p, "type", ty), a = @py_unparse(ty).
cached_hasann(f, x) :- cached_ann(f, x, _).
cached_mempair(n, m, mo, q) :- cached_mem(n, m, mo), q = @concat(@concat(@concat(@concat("('", @rx_replace(m, "'", "''")), "', '"), @rx_replace(mo, "'", "''")), "')").
cached_hasmem(n) :- cached_mem(n, _, _).
cached_arepr(n, "()") :- cached_signed(n, _), !cached_hasmem(n).
cached_arepr(n, r) :- cached_signed(n, _), cached_hasmem(n), k = count : { cached_mem(n, _, _) }, j = join q by (m, mo) sep ", " : { cached_mempair(n, m, mo, q) }, k = 1, r = @concat(@concat("(", j), ",)").
cached_arepr(n, r) :- cached_signed(n, _), cached_hasmem(n), k = count : { cached_mem(n, _, _) }, j = join q by (m, mo) sep ", " : { cached_mempair(n, m, mo, q) }, k > 1, r = @concat(@concat("(", j), ")").
cached_pmempair(fq, l, i, q) :- cached_pmem(fq, i, m, mo), l = @strlen(i), q = @concat(@concat(@concat(@concat("('", @rx_replace(m, "'", "''")), "', '"), @rx_replace(mo, "'", "''")), "')").
cached_phasmem(fq) :- cached_pmem(fq, _, _, _).
cached_prepr(fq, "()") :- cached_signed(_, fq), !cached_phasmem(fq).
cached_prepr(fq, r) :- cached_signed(_, fq), cached_phasmem(fq), k = count : { cached_pmem(fq, _, _, _) }, j = join q by (l, i) sep ", " : { cached_pmempair(fq, l, i, q) }, k = 1, r = @concat(@concat("(", j), ",)").
cached_prepr(fq, r) :- cached_signed(_, fq), cached_phasmem(fq), k = count : { cached_pmem(fq, _, _, _) }, j = join q by (l, i) sep ", " : { cached_pmempair(fq, l, i, q) }, k > 1, r = @concat(@concat("(", j), ")").
cached_badmode(fq, m, q) :- cached_pmo(fq, _, m), !cached_okmode(m), m != "null", q = @concat(@concat("'", @rx_replace(m, "'", "''")), "'").
cached_issue(s) :- cached_rec(_, n1, fq, _, _, _), cached_rec(_, n2, fq, _, _, _), n1 != n2, s = @concat("duplicate decorator entry: ", fq).
cached_issue(s) :- cached_pfn(i, fq), cached_pfn(j, fq), i != j, s = @concat("duplicate policy entry: ", fq).
cached_issue(s) :- cached_eff(_, fq, _, _), !cached_pe(fq, _), s = @concat("unsigned cached pure-lazy function: ", fq).
cached_issue(s) :- cached_pe(fq, _), !cached_effn(fq), s = @concat("stale cached pure-lazy policy entry: ", fq).
cached_issue(s) :- cached_signed(n, fq), cached_err(n, e), s = @concat(@concat(fq, ": "), e).
cached_issue(s) :- cached_signed(n, fq), cached_aarg(n, j, x), !cached_pa(fq, j, x), s = @concat(fq, ": decorator cache arguments changed").
cached_issue(s) :- cached_signed(n, fq), cached_pa(fq, j, x), !cached_aarg(n, j, x), s = @concat(fq, ": decorator cache arguments changed").
cached_issue(s) :- cached_signed(_, fq), cached_ptn(fq, j1, x), cached_ptn(fq, j2, x), j1 != j2, s = @concat(fq, ": cache type metadata must name each cache argument exactly once").
cached_issue(s) :- cached_signed(_, fq), cached_paname(fq, x), !cached_ptname(fq, x), s = @concat(fq, ": cache type metadata must name each cache argument exactly once").
cached_issue(s) :- cached_signed(_, fq), cached_ptname(fq, x), !cached_paname(fq, x), s = @concat(fq, ": cache type metadata must name each cache argument exactly once").
cached_issue(s) :- cached_signed(_, fq), cached_ptt(fq, _, t), t != "l2070_batching.optimizer_run_cache.OptimizerRunCache", s = @concat(@concat(@concat(fq, ": cache type '"), @rx_replace(t, "'", "''")), "' is not approved").
cached_issue(s) :- cached_signed(n, fq), cached_ptn(fq, j, x), cached_ptt(fq, j, t), !cached_hasann(n, x), s = @concat(@concat(@concat(@concat(@concat(fq, ": cache argument '"), @rx_replace(x, "'", "''")), "' annotation None does not match cache type '"), @rx_replace(t, "'", "''")), "'").
cached_issue(s) :- cached_signed(n, fq), cached_ptn(fq, j, x), cached_ptt(fq, j, t), cached_ann(n, x, a), a != @rx_replace(t, "^.*\\.", ""), s = @concat(@concat(@concat(@concat(@concat(@concat(@concat(fq, ": cache argument '"), @rx_replace(x, "'", "''")), "' annotation "), @py_repr(a)), " does not match cache type '"), @rx_replace(t, "'", "''")), "'").
cached_issue(s) :- cached_signed(_, fq), cached_pv(fq, "owner_scope", o), o != "optimizer_run", o != "null", s = @concat(@concat(@concat(fq, ": owner scope '"), @rx_replace(o, "'", "''")), "' is not approved").
cached_issue(s) :- cached_signed(_, fq), cached_pv(fq, "rationale", r), match(" *", r), s = @concat(fq, ": review rationale is required").
cached_issue(s) :- cached_signed(_, fq), cached_badmode(fq, _, _), l = join q by (m) sep ", " : { cached_badmode(fq, m, q) }, s = @concat(@concat(@concat(fq, ": cache member access modes are invalid: ["), l), "]").
cached_issue(s) :- cached_signed(n, fq), cached_eff(n, fq, bh, _), cached_pv(fq, "body_hash", p), p != "null", bh != p, s = @concat(fq, ": function body hash changed").
cached_issue(s) :- cached_signed(n, fq), cached_eff(n, fq, _, sh), cached_pv(fq, "signature_hash", p), p != "null", sh != p, s = @concat(fq, ": function signature hash changed").
cached_issue(s) :- cached_signed(n, fq), cached_arepr(n, a), cached_prepr(fq, p), a != p, s = @concat(@concat(@concat(@concat(fq, ": cache member access changed: actual="), a), " policy="), p).
violation("data-layer-cached-pure-lazy-allowlist", "cached-policy", s, "l2055_lazy_result/cached_pure_lazy_policy.py", 1) :- cached_on(_), cached_issue(s).
memo_on(0) :- option_value("entryPoint", "memoized_policy_violations").
memo_on(0) :- option_value("entryPoint", "all").
memo_sel(d, f, c) :- memo_gate(d), cpl_decl(d, f, "function_definition", _, _, _), cpl_eligible(f), cpl_dec_name(f, dec, x, "memoized_pure_lazy"), cpl_call(_, c, x, "identifier"), cpl_kid(dec, c).
memo_kwcount(c, k) :- memo_sel(_, _, c), k = count : { cpl_kwnode(c, _) }.
memo_haskw(c) :- memo_sel(_, _, c), cpl_kw(c, "max_entries", _).
memo_bound(f, v, m) :- memo_sel(_, f, c), cpl_kw(c, "max_entries", v), node(_, v, "integer", _, _), node_text(v, t), z = @rx_replace(@rx_replace(@rx_replace(t, "_", ""), "^([0-9]*)(?s:.*)$", "${1}"), "^0+", ""), z != "", m = z.
memo_bound(f, v, "0") :- memo_sel(_, f, c), cpl_kw(c, "max_entries", v), node(_, v, "integer", _, _), node_text(v, t), @rx_replace(@rx_replace(@rx_replace(t, "_", ""), "^([0-9]*)(?s:.*)$", "${1}"), "^0+", "") = "".
memo_bound(f, v, "NULL") :- memo_sel(_, f, c), cpl_kw(c, "max_entries", v), node(_, v, k, _, _), k != "integer".
memo_bound(f, f, "NULL") :- memo_sel(_, f, c), !memo_haskw(c).
memo_marked(f) :- memo_sel(_, f, _), cpl_dec_name(f, dec, x, "pure_lazy"), node(_, x, "identifier", _, _), child(dec, x, _).
memo_err(f, "memoized_pure_lazy requires the canonical pure_lazy marker") :- memo_sel(_, f, _), !memo_marked(f).
memo_err(f, "memoized_pure_lazy requires one literal max_entries keyword") :- memo_sel(_, f, c), memo_kwcount(c, k), k != 1.
memo_err(f, "memoized_pure_lazy requires one literal max_entries keyword") :- memo_sel(_, f, c), !memo_haskw(c).
memo_err(f, "memoized_pure_lazy requires one literal max_entries keyword") :- memo_sel(_, f, c), cpl_isposarg_of(c).
memo_err(f, "memoized_pure_lazy max_entries must be a literal integer") :- memo_sel(_, f, c), cpl_kw(c, "max_entries", v), node(_, v, k, _, _), k != "integer".
memo_err(f, "memoized_pure_lazy max_entries must be positive") :- memo_bound(f, _, "0").
memo_err(f, "memoized pure-lazy functions must be synchronous") :- memo_sel(_, f, _), node_text(f, t), match("async\\s(?s:.*)", t).
memo_err(f, "memoized pure-lazy functions cannot use variadic arguments") :- memo_sel(d, f, _), cpl_params(f, _, ps, pe), node(d, _, k, s, e), cpl_splat_k(k), s >= ps, e <= pe.
memo_err(f, "memoized pure-lazy functions cannot be generators") :- memo_sel(d, f, _), cpl_body(f, bs, be), node(d, _, "yield", s, e), s >= bs, e <= be.
memo_err(n, e) :- memo_alias(_, n, _, e).
memo_outside(d) :- memo_gate(d), doc(d, p, _), !match("(?s:.*)[lL]2055.[lL][aA][zZ][yY].[rR][eE][sS][uU][lL][tT]/[pP][uU][rR][iI][tT][yY]\\.[pP][yY]", p).
memo_selcallee(n) :- memo_sel(_, _, c), field(c, "function", n).
memo_alias(d, i, fq, "memoized_pure_lazy decorator aliases are forbidden") :- memo_gate(d), node(d, i, "import_from_statement", _, _), child(m, i, _), node(_, m, "module", _, _), field(i, "module_name", mn), cpl_txt(mn, "l2055_lazy_result.purity"), cpl_kid(i, a), node(_, a, "aliased_import", _, _), field(a, "name", an), cpl_txt(an, "memoized_pure_lazy"), cpl_module(d, md), line(i, l), fq = @concat(@concat(@concat(md, ".<memoized_decorator_alias_"), @to_string(l)), ">").
memo_alias(d, n, fq, "direct access to private memoization storage is forbidden") :- memo_outside(d), node(d, n, "identifier", _, _), cpl_txt(n, x), memo_private(x), child(par, n, _), node(_, par, pk, _, _), !memo_import_parent_k(pk), cpl_module(d, md), line(n, l), col(n, k), fq = @concat(@concat(@concat(@concat(@concat(md, ".<private_memoized_storage_access_"), @to_string(l)), "_"), @to_string(k)), ">").
memo_alias(d, n, fq, "memoized_pure_lazy cannot escape as a first-class value") :- memo_outside(d), node(d, n, "identifier", _, _), cpl_txt(n, "memoized_pure_lazy"), child(par, n, _), node(_, par, pk, _, _), !memo_import_parent_k(pk), !memo_selcallee(n), cpl_module(d, md), line(n, l), col(n, k), fq = @concat(@concat(@concat(@concat(@concat(md, ".<escaped_memoized_decorator_"), @to_string(l)), "_"), @to_string(k)), ">").
memo_row(d, f, kv, fq, bh, sh, m) :- memo_sel(d, f, _), cpl_fname(f, fq), body_sha256(f, bh), signature_sha256(f, sh), memo_bound(f, kv, m).
memo_row(d, n, n, fq, h, h, "NULL") :- memo_alias(d, n, fq, _), dump_sha256(n, h).
memo_newer(n, kv) :- memo_row(d, n, kv, fq, _, _, _), memo_row(d2, _, _, fq, _, _, _), doc(d, p, _), doc(d2, p2, _), p2 > p.
memo_newer(n, kv) :- memo_row(d, n, kv, fq, _, _, _), memo_row(d, n2, _, fq, _, _, _), node(_, n, _, s, _), node(_, n2, _, s2, _), s2 > s.
memo_newer(n, kv) :- memo_row(_, n, kv, fq, _, _, _), memo_row(_, n, kv2, fq, _, _, _), node(_, kv, _, s, _), node(_, kv2, _, s2, _), s2 > s.
memo_eff(n, kv, fq, bh, sh, m) :- memo_row(_, n, kv, fq, bh, sh, m), !memo_newer(n, kv).
memo_effn(fq) :- memo_eff(_, _, fq, _, _, _).
memo_leaf(i, r, v) :- option_value("entryPoint", "memoized_policy_violations"), option_json("policyEntries", p, v), match("/[0-9]+/(?s:.*)", p), i = @rx_replace(p, "^/([0-9]+)/(?s:.*)$", "${1}"), r = @rx_replace(p, "^/[0-9]+/", "").
memo_leaf(i, r, v) :- option_value("entryPoint", "all"), memo_default(i, r, v).
memo_pfn(i, fq) :- memo_leaf(i, "function", fq).
memo_pnewer(fq, i) :- memo_pfn(i, fq), memo_pfn(j, fq), @strlen(j) > @strlen(i).
memo_pnewer(fq, i) :- memo_pfn(i, fq), memo_pfn(j, fq), @strlen(j) = @strlen(i), j > i.
memo_pe(fq, i) :- memo_pfn(i, fq), !memo_pnewer(fq, i).
memo_pv(fq, r, v) :- memo_pe(fq, i), memo_leaf(i, r, v).
memo_signed(n, kv, fq, m) :- memo_eff(n, kv, fq, _, _, m), memo_pe(fq, _).
memo_issue(s) :- memo_row(_, n1, k1, fq, _, _, _), memo_row(_, n2, k2, fq, _, _, _), n1 != n2, s = @concat("duplicate memoized decorator entry: ", fq).
memo_issue(s) :- memo_row(_, n, k1, fq, _, _, _), memo_row(_, n, k2, fq, _, _, _), k1 != k2, s = @concat("duplicate memoized decorator entry: ", fq).
memo_issue(s) :- memo_pfn(i, fq), memo_pfn(j, fq), i != j, s = @concat("duplicate memoized policy entry: ", fq).
memo_issue(s) :- memo_row(_, n, _, fq, _, _, _), memo_err(n, e), s = @concat(@concat(fq, ": "), e).
memo_issue(s) :- memo_eff(_, _, fq, _, _, _), !memo_pe(fq, _), s = @concat("unsigned memoized pure-lazy function: ", fq).
memo_issue(s) :- memo_pe(fq, _), !memo_effn(fq), s = @concat("stale memoized pure-lazy policy entry: ", fq).
memo_issue(s) :- memo_signed(_, _, fq, "NULL"), memo_pv(fq, "max_entries", v), v != "null", s = @concat(fq, ": memoization bound changed").
memo_issue(s) :- memo_signed(_, _, fq, m), m != "NULL", !memo_pv(fq, "max_entries", m), s = @concat(fq, ": memoization bound changed").
memo_issue(s) :- memo_signed(_, _, fq, _), !memo_pv(fq, "cache_lifetime", "process"), s = @concat(fq, ": cache lifetime is not approved").
memo_issue(s) :- memo_signed(_, _, fq, _), !memo_pv(fq, "key_policy", "bound_explicit_immutable_v1"), s = @concat(fq, ": key policy is not approved").
memo_issue(s) :- memo_signed(_, _, fq, _), !memo_pv(fq, "return_policy", "immutable_no_alias_v1"), s = @concat(fq, ": return policy is not approved").
memo_issue(s) :- memo_signed(_, _, fq, _), !memo_pv(fq, "exception_policy", "successful_results_only_v1"), s = @concat(fq, ": exception policy is not approved").
memo_issue(s) :- memo_signed(_, _, fq, _), memo_pv(fq, "rationale", r), match(" *", r), s = @concat(fq, ": review rationale is required").
memo_issue(s) :- memo_signed(n, kv, fq, _), memo_eff(n, kv, fq, bh, _, _), memo_pv(fq, "body_hash", p), p != "null", bh != p, s = @concat(fq, ": function body hash changed").
memo_issue(s) :- memo_signed(n, kv, fq, _), memo_eff(n, kv, fq, _, sh, _), memo_pv(fq, "signature_hash", p), p != "null", sh != p, s = @concat(fq, ": function signature hash changed").
violation("data-layer-cached-pure-lazy-allowlist", "memoized-policy", s, "l2055_lazy_result/cached_pure_lazy_policy.py", 1) :- memo_on(_), memo_issue(s).
runtime_on(0) :- option_value("entryPoint", "all").
runtime_gate(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), node(d, _, "module", _, _), match("(?:(?s:.*)/)?(?:l2055_lazy_result/(?:purity|cached_pure_lazy_policy)|l2070_batching/optimizer_run_cache)\\.py", p).
runtime_top(n) :- runtime_gate(d, _), node(d, m, "module", _, _), child(m, n, _).
runtime_top(n) :- runtime_gate(d, _), node(d, m, "module", _, _), child(m, w, _), node(_, w, "decorated_definition", _, _), child(w, n, _).
runtime_node(lb, x, n) :- runtime_protected(lb, p, x), runtime_gate(d, p), runtime_def_k(k), node(d, n, k, _, _), runtime_top(n), field(n, "name", nm), node_text(nm, x).
runtime_node(lb, x, n) :- runtime_protected(lb, p, x), runtime_gate(d, p), node(d, n, "assignment", _, _), field(n, "left", l), node_text(l, x), child(es, n, _), node(_, es, "expression_statement", _, _), runtime_top(es).
runtime_dump(x, n, v) :- runtime_node(lb, x, n), s = @ast_dump(n), v = @concat(@concat(@concat(@concat(lb, ":"), x), ":"), s).
runtime_hash(h) :- runtime_dump(_, _, _), j = join v by (x, n) sep "|" : { runtime_dump(x, n, v) }, h = @sha256(j).
runtime_policy_doc(d) :- runtime_gate(d, "l2055_lazy_result/cached_pure_lazy_policy.py").
runtime_meta(x, lj) :- runtime_policy_doc(d), node(d, a, "assignment", _, _), field(a, "left", l), node_text(l, x), runtime_meta_name(x), field(a, "right", r), literal_json(r, lj).
runtime_text(lj, s) :- runtime_meta(_, lj), match("\"[^\"\\\\]*\"", lj), s = @substr(lj, 1, @sub(@strlen(lj), 2)).
runtime_render(x, lj) :- runtime_meta(x, lj), runtime_text(lj, _).
runtime_render(x, lj) :- runtime_meta(x, lj), match("-?[0-9]+", lj).
runtime_render(x, "null") :- runtime_meta_name(x), !runtime_has_meta(x).
runtime_has_meta(x) :- runtime_meta(x, _).
runtime_entries_span(d, s, e) :- runtime_policy_doc(d), node(d, a, "assignment", _, _), field(a, "left", l), node_text(l, x), runtime_entries_name(x), field(a, "right", r), node(_, r, _, s, e).
runtime_entry_call(c, cs) :- runtime_entries_span(d, s, e), node(d, c, "call", cs, ce), cs >= s, ce <= e, field(c, "function", f), node(_, f, "identifier", _, _), node_text(f, x), runtime_ctor(x).
runtime_entry_call(c, cs) :- runtime_entries_span(d, s, e), node(d, c, "call", cs, ce), cs >= s, ce <= e, field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", i), node_text(i, x), runtime_ctor(x).
runtime_entry_kw(c, x, lj) :- runtime_entry_call(c, _), field(c, "arguments", al), child(al, k, _), node(_, k, "keyword_argument", _, _), field(k, "name", kn), node_text(kn, x), field(k, "value", v), literal_json(v, lj).
runtime_has_kw(c) :- runtime_entry_kw(c, _, _).
runtime_entry_pair(c, x, lj, p) :- runtime_entry_kw(c, x, lj), p = @concat(@concat(@json_str(x), ":"), lj).
runtime_value(o, s) :- runtime_entry_call(c, s), runtime_has_kw(c), j = join p by (x, lj) sep "," : { runtime_entry_pair(c, x, lj, p) }, o = @concat(@concat("{", j), "}").
runtime_symjson(lj) :- runtime_meta("CACHED_PURE_LAZY_RUNTIME_SYMBOL_NAMES", lj).
runtime_symjson("null") :- runtime_meta_name("CACHED_PURE_LAZY_RUNTIME_SYMBOL_NAMES"), !runtime_has_meta("CACHED_PURE_LAZY_RUNTIME_SYMBOL_NAMES").
runtime_value(v, -1) :- runtime_render("CACHED_PURE_LAZY_RUNTIME_SOURCE_HASH", h), runtime_symjson(sj), v = @concat(@concat(@concat(@concat("{\"runtime_source_hash\":", h), ",\"runtime_symbols\":"), sj), "}").
runtime_value_q(v, k, q) :- runtime_value(v, k), q = @json_str(v).
runtime_message(m) :- runtime_render("ALLOWLIST_NAME", ln), runtime_render("ALLOWLIST_VERSION", vn), a = join q by (v, k) sep "," : { runtime_value_q(v, k, q) }, m = @concat(@concat(@concat(@concat(@concat(@concat("{\"allowlist\":[", a), "],\"linter\":"), ln), ",\"version\":"), vn), "}").
runtime_valid(0) :- runtime_message(m), runtime_meta("ALLOWLIST_SIGNATURE", lj), runtime_text(lj, sig), @ed25519_ok("7e9776d87292ab633115bd6c07892a4bf56450fffb2dfcf13b3eba1866b9fbb6", m, sig) = 1.
runtime_symbols_ok(0) :- runtime_meta("CACHED_PURE_LAZY_RUNTIME_SYMBOL_NAMES", lj), match("\\[(?:\"[^\"\\\\]*\"(?:,\"[^\"\\\\]*\")*)?\\]", lj), k = count : { runtime_protected(_, _, _) }, @count_matches("\"[^\"]*\"", lj) = k, !runtime_symbol_missing(lj).
runtime_symbol_missing(lj) :- runtime_meta("CACHED_PURE_LAZY_RUNTIME_SYMBOL_NAMES", lj), runtime_protected(_, _, x), !contains(@concat(@concat("\"", x), "\""), lj).
runtime_issue("cached pure-lazy runtime symbol metadata changed") :- runtime_on(_), !runtime_symbols_ok(_).
runtime_issue(s) :- runtime_hash(h), runtime_meta("CACHED_PURE_LAZY_RUNTIME_SOURCE_HASH", lj), runtime_text(lj, v), h != v, s = @concat(@concat(@concat("cached pure-lazy runtime source hash changed: actual=", h), " policy="), v).
runtime_issue(s) :- runtime_hash(h), runtime_meta("CACHED_PURE_LAZY_RUNTIME_SOURCE_HASH", lj), match("-?[0-9]+", lj), s = @concat(@concat(@concat("cached pure-lazy runtime source hash changed: actual=", h), " policy="), lj).
runtime_issue("cached pure-lazy policy signature is invalid") :- runtime_on(_), !runtime_valid(_).
violation("data-layer-cached-pure-lazy-allowlist", "cached-runtime-contract", s, "l2055_lazy_result/cached_pure_lazy_policy.py", 1) :- runtime_on(_), runtime_issue(s).
