violation("data-layer-type-safety-patterns", "text-deprecated_filter_method", "TSP001", p, l) :- node(_, n, "identifier", _, _), text(n, v1), (v1 = "filter_eq" ; v1 = "filter_gt" ; v1 = "filter_gte" ; v1 = "filter_in" ; v1 = "filter_lt" ; v1 = "filter_lte" ; v1 = "filter_ne"), field(v2, "attribute", n), node(_, v2, "attribute", _, _), field(v3, "function", v2), node(_, v3, "call", _, _), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
text_str_union_bin(d, n, sa, sb) :- node(d, n, "binary_operator", _, _), op(n, "|"), field(n, "left", x), node_text(x, sa), field(n, "right", y), node_text(y, sb).
violation("data-layer-type-safety-patterns", "text-str_union_expression", "TSP001", p, l) :- text_str_union_bin(d, n, sa, sb), match("(?s:.*)(?:\\bstr$)(?s:.*)", sa), match("(?s:.*)(?:^Expression)(?s:.*)", sb), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l), !match("(?s:.*)(?:^(?:impl/common/l2060_query_spec/query_spec\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l5200_sql_query/_base\\.py|impl/common/l7248_sparse_versioned_transactions/sparse_versioned_write_query\\.py|impl/common/l7300_cross_branch/sql_cross_branch_query\\.py|l2055_lazy_result/lazy_reads\\.py|l2055_lazy_result/query_spec\\.py|l9700_graph_query/graph_pattern\\.py)$)(?s:.*)", p).
violation("data-layer-type-safety-patterns", "text-str_union_expression", "TSP001", p, l) :- text_str_union_bin(d, n, sa, sb), match("(?s:.*)(?:\\bExpression$)(?s:.*)", sa), match("(?s:.*)(?:^str)(?s:.*)", sb), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l), !match("(?s:.*)(?:^(?:impl/common/l2060_query_spec/query_spec\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l5200_sql_query/_base\\.py|impl/common/l7248_sparse_versioned_transactions/sparse_versioned_write_query\\.py|impl/common/l7300_cross_branch/sql_cross_branch_query\\.py|l2055_lazy_result/lazy_reads\\.py|l2055_lazy_result/query_spec\\.py|l9700_graph_query/graph_pattern\\.py)$)(?s:.*)", p).
violation("data-layer-type-safety-patterns", "text-str_union_field", "TSP001", p, l) :- text_str_union_bin(d, n, sa, sb), match("(?s:.*)(?:\\bstr$)(?s:.*)", sa), match("(?s:.*)(?:^Field)(?s:.*)", sb), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l), !match("(?s:.*)(?:^(?:impl/common/l2060_query_spec/query_spec\\.py|impl/common/l5200_sql_query/_base\\.py|impl/common/l7300_cross_branch/sql_cross_branch_query\\.py|impl/mongodb/query\\.py|l2060_query_builder/plan_query_builder\\.py)$)(?s:.*)", p).
violation("data-layer-type-safety-patterns", "text-str_union_field", "TSP001", p, l) :- text_str_union_bin(d, n, sa, sb), match("(?s:.*)(?:\\bField$)(?s:.*)", sa), match("(?s:.*)(?:^str)(?s:.*)", sb), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l), !match("(?s:.*)(?:^(?:impl/common/l2060_query_spec/query_spec\\.py|impl/common/l5200_sql_query/_base\\.py|impl/common/l7300_cross_branch/sql_cross_branch_query\\.py|impl/mongodb/query\\.py|l2060_query_builder/plan_query_builder\\.py)$)(?s:.*)", p).
violation("data-layer-type-safety-patterns", "text-expression_any_any", "TSP001", p, l) :- node(d, n, k, _, _), text_expression_any_any_kind(k), node_text(n, s), match("(?s:.*)(?:\\bExpression\\s*\\[\\s*Any\\s*,\\s*Any\\s*\\]$)(?s:.*)", s), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l), !match("(?s:.*)(?:^(?:impl/common/l2070_server_plan/steps/intent_cross_branch\\.py|impl/common/l2070_server_plan/steps/intent_history\\.py|impl/common/l2070_server_plan/steps/intent_versioning\\.py|impl/common/l2100_sql_grammar/versioned_aggregate\\.py|impl/common/l4000_policy_expression/translator\\.py|impl/common/l7300_cross_branch/permission_expression_compiler\\.py|impl/common/l7300_sql_versioned_transactions/sql_write_transaction\\.py|impl/neo4j/backend_operations\\.py|l1000_schema/typed_field\\.py|l2000_connection/versioned_protocols\\.py|l2050_transaction/transaction\\.py|l2055_lazy_result/execution_context\\.py|l2055_lazy_result/lazy_reads\\.py|l2055_lazy_result/query_spec\\.py|l2060_query_builder/plan_query_builder\\.py|l2060_query_builder/query_builder\\.py|l2060_query_builder/tuple_query\\.py|l2080_lazy_orm/lazy_column\\.py|l2080_lazy_orm/lazy_table\\.py|l4000_permissions/permission_enforcement\\.py|l4000_permissions/policy_expressions\\.py|l4100_queue/hooks\\.py|l7200_versioned_transactions/revision_history_query\\.py|l7200_versioned_transactions/versioned_transactions\\.py)$)(?s:.*)", p).
text_deprecated_comparison_op_name(n) :- node(_, n, "identifier", _, _), text(n, s), (s = "_lt" ; s = "_gt" ; s = "_le" ; s = "_ge" ; s = "_eq" ; s = "_ne").
text_deprecated_comparison_op_m(n, n) :- text_deprecated_comparison_op_name(n).
text_deprecated_comparison_op_m(n, a) :- text_deprecated_comparison_op_name(n), field(a, "attribute", n), node(_, a, "attribute", _, _).
text_deprecated_comparison_op_hit(m) :- text_deprecated_comparison_op_m(_, m), child(p, m, _), node(_, m, _, s, e), token(p, i, _, s, e), j = @add(i, 1), token(p, j, t, _, _), match("=|==|:|:=", t).
violation("data-layer-type-safety-patterns", "text-deprecated_comparison_op", "TSP001", p, l) :- text_deprecated_comparison_op_m(n, m), text_deprecated_comparison_op_hit(m), node(d, n, _, _, _), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l).
signature_def(d, n, s) :- node(d, n, "function_definition", _, _), field(n, "name", x), node(_, x, "identifier", _, _), text(x, s).
violation("data-layer-type-safety-patterns", "signature-where", "TSP001", p, l) :- signature_def(d, n, "where"), node_text(n, s), match("(?s:.*)(?:expression\\s*:\\s*str\\b|:\\s*str\\s*\\|)(?s:.*)", s), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l).
violation("data-layer-type-safety-patterns", "signature-select", "TSP001", p, l) :- signature_def(d, n, "select"), node_text(n, s), match("(?s:.*)(?:\\*columns\\s*:\\s*str\\b|columns\\s*:\\s*str\\b|:\\s*str\\s*\\|)(?s:.*)", s), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l), !match("(?s:.*)(?:^(?:impl/common/l2060_query_spec/query_spec\\.py|impl/common/l5200_sql_query/_base\\.py|l9700_graph_query/graph_pattern\\.py|l9700_graph_query/query_builder\\.py)$)(?s:.*)", p).
violation("data-layer-type-safety-patterns", "signature-group_by", "TSP001", p, l) :- signature_def(d, n, "group_by"), node_text(n, s), match("(?s:.*)(?:\\*columns\\s*:\\s*str\\b|columns\\s*:\\s*str\\b|:\\s*str\\s*\\|)(?s:.*)", s), doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l), !match("(?s:.*)(?:^(?:impl/common/l2060_query_spec/query_spec\\.py|impl/common/l5200_sql_query/_base\\.py|impl/common/l7248_sparse_versioned_transactions/sparse_versioned_write_query\\.py)$)(?s:.*)", p).
signature_order_by_fn(d, n, l) :- node(d, n, "function_definition", _, _), field(n, "name", x), node(_, x, "identifier", _, _), text(x, "order_by"), doc(d, p, _), !match("(?s:.*)(?:^(?:impl/common/l2060_query_spec/query_spec\\.py|impl/common/l5200_sql_query/_base\\.py|impl/common/l7300_cross_branch/sql_cross_branch_query\\.py|l9750_graphql/executor\\.py)$)(?s:.*)", p), in_scope(d), !out_scope(d), !tape_syntax_error(d), line(n, l).
signature_order_by_line(d, l, s) :- signature_order_by_fn(d, _, l0), signature_order_by_offset(k), l = @add(l0, k), tape_line(d, l, sp), text(sp, s).
signature_order_by_through(d, l) :- signature_order_by_line(d, l, s), match("(?s:.*)(?:\\):|\\) ->)(?s:.*)", s).
signature_order_by_end(n, 0) :- signature_order_by_fn(d, n, l0), signature_order_by_through(d, l0).
signature_order_by_end(n, 1) :- signature_order_by_fn(d, n, l0), rr_t1 = @add(l0, 1), signature_order_by_through(d, rr_t1), !signature_order_by_through(d, l0).
signature_order_by_end(n, 2) :- signature_order_by_fn(d, n, l0), rr_t2 = @add(l0, 2), signature_order_by_through(d, rr_t2), !signature_order_by_through(d, l0), rr_t3 = @add(l0, 1), !signature_order_by_through(d, rr_t3).
signature_order_by_end(n, 3) :- signature_order_by_fn(d, n, l0), rr_t4 = @add(l0, 3), signature_order_by_through(d, rr_t4), !signature_order_by_through(d, l0), rr_t5 = @add(l0, 1), !signature_order_by_through(d, rr_t5), rr_t6 = @add(l0, 2), !signature_order_by_through(d, rr_t6).
