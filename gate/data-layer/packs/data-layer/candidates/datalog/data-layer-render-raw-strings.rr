.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl strprefix(n: node, s: symbol)
.input doc, node, child, field, text, strprefix
.decl k0(kind: symbol)
k0("function_definition").
.decl k1(kind: symbol)
k1("assert_statement"). k1("raise_statement").
.decl in_scope(d: number)
.decl m11(n: node)
.decl m14(n: node)
.decl m2(n: node)
.decl m20(n: node)
.decl m21(n: node)
.decl m28(n: node)
.decl m35(n: node)
.decl m5(n: node)
.decl m6(n: node)
.decl m8(n: node)
.decl out_scope(d: number)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
in_scope(d) :- doc(d, p, _), glob("impl/common/l2100_sql_grammar/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
m2(n) :- strprefix(n, v1), contains("f", v1).
m5(n) :- child(n, v3, _), node(_, v3, "string", _, _), strprefix(v3, v4), contains("f", v4).
m6(n) :- node(_, n, "string", _, _), !m2(n).
m6(n) :- node(_, n, "concatenated_string", _, _), !m5(n).
m8(n) :- child(v7, n, _), node(_, v7, "concatenated_string", _, _).
m11(n) :- child(v10, n, _), node(_, v10, "concatenated_string", _, _).
m14(n) :- node(_, n, "string", _, _), strprefix(n, v9), contains("f", v9), !m11(n).
m14(n) :- node(_, n, "concatenated_string", _, _), child(n, v12, _), node(_, v12, "string", _, _), strprefix(v12, v13), contains("f", v13).
m14(n) :- node(_, n, "format_specifier", _, _).
m20(n) :- node(_, n, "raise_statement", _, _).
m20(n) :- node(_, n, "assert_statement", _, _).
m21(n) :- inside(n, v19, k1), m20(v19).
m28(n) :- node(_, n, "identifier", _, _), text(n, v23), v23 = "Template".
m28(n) :- node(_, n, "attribute", _, _), field(n, "object", v24), node(_, v24, "identifier", _, _), text(v24, v25), v25 = "SqlFragment", field(n, "attribute", v26), node(_, v26, "identifier", _, _), text(v26, v27), v27 = "static".
m35(n) :- node(_, n, "identifier", _, _), text(n, v30), v30 = "Template".
m35(n) :- node(_, n, "attribute", _, _), field(n, "object", v31), node(_, v31, "identifier", _, _), text(v31, v32), v32 = "SqlFragment", field(n, "attribute", v33), node(_, v33, "identifier", _, _), text(v33, v34), v34 = "static".
.output violation
