.scope text "**/*.[mM][dD]", "**/*.[mM][aA][rR][kK][dD][oO][wW][nN]", "**/*.[rR][sS][tT]", "**/*.[tT][xX][tT]", "**/*.[tT][oO][mM][lL]", "**/*.[cC][fF][gG]", "**/*.[iI][nN][iI]", "**/*.[yY][aA][mM][lL]", "**/*.[yY][mM][lL]"
.decl literal_fdef(kind: symbol)
literal_fdef("function_definition").
.decl literal_raise(kind: symbol)
literal_raise("raise_statement"). literal_raise("assert_statement").
.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl end_line(n: node, l: number)
.decl field(p: node, f: symbol, c: node)
.decl fstring_literal_after(n: node, o: number, b: number)
.decl fstring_literal_at(n: node, l: number)
.decl fstring_literal_cnext(c: node, l: number)
.decl fstring_literal_cnext_later(c: node, l: number)
.decl fstring_literal_cont(c: node)
.decl fstring_literal_content(n: node, c: node)
.decl fstring_literal_debug(f: node)
.decl fstring_literal_empty(c: node)
.decl fstring_literal_field(n: node, f: node, b: number, e: number)
.decl fstring_literal_ford(n: node, b: number, j: number)
.decl fstring_literal_host(n: node)
.decl fstring_literal_item(n: node, k: number, o: number, l: number)
.decl fstring_literal_item0(n: node, o: number, l: number)
.decl fstring_literal_later_piece(n: node, i: number)
.decl fstring_literal_long(n: node, k: number)
.decl fstring_literal_not_first(n: node, k: number, o: number)
.decl fstring_literal_not_next(n: node, o: number, b: number)
.decl fstring_literal_parsed(n: node)
.decl fstring_literal_pord(n: node, i: number, j: number)
.decl fstring_literal_slice(n: node, a: number, l: number)
.decl fstring_piece(n: node, i: number, kind: symbol, v: symbol)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl literal_allowed(n: node)
.decl literal_allowed_fn(f: node)
.decl literal_allowed_name(s: symbol)
.decl literal_content(s: node, c: node, m: symbol, t: symbol)
.decl literal_docstring(n: node)
.decl literal_earlier(al: node, i: number)
.decl literal_fhas(n: node)
.decl literal_first_pos(al: node, a: node)
.decl literal_fpart(s: node)
.decl literal_gate(d: number)
.decl literal_in_concat(n: node)
.decl literal_in_raise(n: node)
.decl literal_in_render(n: node)
.decl literal_kind(n: node)
.decl literal_kwkind(kind: symbol)
.decl literal_long(n: node)
.decl literal_mode(s: node, m: symbol)
.decl literal_part(n: node, s: node)
.decl literal_render(f: node)
.decl literal_special_arg(n: node)
.decl literal_special_fn(f: node)
.decl literal_static_fn(f: node)
.decl literal_str(n: node)
.decl literal_template_fn(f: node)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl node_text(n: node, s: symbol)
.decl option_on(name: symbol)
.decl out_scope(d: number)
.decl rr_agg1(b: number, b2: number, n: node)
.decl rr_agg3(i: number, i2: number, n: node)
.decl rr_ctx2(b: number, n: node)
.decl rr_ctx4(i: number, n: node)
.decl rr_demand_agg_rr_agg1(b: number, n: node)
.decl rr_demand_agg_rr_agg3(i: number, n: node)
.decl strprefix(n: node, p: symbol)
.decl syntax_error(d: number)
.decl tape_line(d: number, l: number, sp: node)
.decl tape_syntax_error(d: number)
.decl template_call(c: node, f: node)
.decl text(n: node, s: symbol)
.decl token(p: node, i: number, s: symbol, start: number, end: number)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, syntax_error, node, field, child, text, line, value, strprefix, value_type_of, fstring_piece, tape_line, end_line, node_text, token
.output violation
literal_allowed_name("SqlAliasName").
literal_allowed_name("SqlColumnName").
literal_allowed_name("SqlIndexName").
literal_allowed_name("SqlIntegerLiteral").
literal_allowed_name("SqlQualifiedIdentifier").
literal_allowed_name("SqlQuotedIdentifier").
literal_allowed_name("SqlTableName").
literal_allowed_name("append").
literal_allowed_name("endswith").
literal_allowed_name("format").
literal_allowed_name("join").
literal_allowed_name("replace").
literal_allowed_name("repr").
literal_allowed_name("startswith").
literal_allowed_name("str").
literal_kwkind("keyword_argument").
literal_kwkind("dictionary_splat").
option_on("sourceGate").
in_scope(d) :- doc(d, p, _), glob("impl/common/l2100_sql_grammar/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
tape_syntax_error(d) :- syntax_error(d).
literal_render(f) :- node(_, f, "function_definition", _, _), field(f, "name", x), text(x, "render").
literal_render(f) :- node(_, f, "function_definition", _, _), field(f, "name", x), text(x, s), prefix("render_", s).
literal_in_render(n) :- inside(n, f, literal_fdef), literal_render(f).
literal_in_raise(n) :- inside(n, _, literal_raise).
literal_in_concat(n) :- child(p, n, _), node(_, p, "concatenated_string", _, _).
literal_mode(s, "p") :- node(_, s, "string", _, _), strprefix(s, x), !contains("r", x), !contains("f", x).
literal_mode(s, "f") :- node(_, s, "string", _, _), strprefix(s, x), !contains("r", x), contains("f", x).
literal_mode(s, "rp") :- node(_, s, "string", _, _), strprefix(s, x), contains("r", x), !contains("f", x).
literal_mode(s, "rf") :- node(_, s, "string", _, _), strprefix(s, x), contains("r", x), contains("f", x).
literal_content(s, c, m, t) :- literal_mode(s, m), child(s, c, _), node(_, c, "string_content", _, _), node_text(c, t).
literal_fpart(s) :- node(_, s, "string", _, _), node_text(s, t), match("(?i)[rub]*f(?s:.*)", t).
literal_fhas(n) :- node(_, n, "concatenated_string", _, _), child(n, s, _), literal_fpart(s).
literal_kind(n) :- node(_, n, "string", _, _), !literal_fpart(n), !literal_in_concat(n).
literal_kind(n) :- node(_, n, "concatenated_string", _, _), !literal_fhas(n), !literal_in_concat(n).
literal_str(n) :- literal_kind(n), value_type_of(n, "str").
literal_long(n) :- literal_str(n), value(n, v), match("(?s:.*)(?:(?s)^.{2})(?s:.*)", v).
literal_part(n, n) :- node(_, n, "string", _, _), !literal_in_concat(n).
literal_part(n, s) :- node(_, n, "concatenated_string", _, _), !literal_in_concat(n), child(n, s, _), node(_, s, "string", _, _).
literal_gate(d) :- doc(d, _, _), !option_on("sourceGate").
literal_gate(d) :- option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, t), match("(?s:.*)(?:render|\\x27|\\x22|Template\\(|SqlFragment\\.static\\()(?s:.*)", t).
literal_earlier(al, i) :- node(_, al, "argument_list", _, _), child(al, _, i), child(al, b, j), j < i, node(_, b, k, _, _), !literal_kwkind(k).
literal_first_pos(al, a) :- node(_, al, "argument_list", _, _), child(al, a, i), node(_, a, k, _, _), !literal_kwkind(k), k != "list_splat", k != "parenthesized_list_splat", !literal_earlier(al, i).
literal_template_fn(f) :- node(_, f, "identifier", _, _), text(f, "Template").
literal_static_fn(f) :- node(_, f, "attribute", _, _), field(f, "object", o), node(_, o, "identifier", _, _), text(o, "SqlFragment"), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, "static").
literal_special_fn(f) :- literal_template_fn(f).
literal_special_fn(f) :- literal_static_fn(f).
literal_docstring(n) :- child(es, n, _), node(_, es, "expression_statement", _, _), child(b, es, 0), node(_, b, "block", _, _), child(f, b, _), literal_render(f), !literal_in_render(f).
literal_allowed_fn(f) :- node(_, f, "identifier", _, _), text(f, s), literal_allowed_name(s).
literal_allowed_fn(f) :- node(_, f, "attribute", _, _), field(f, "attribute", x), node(_, x, "identifier", _, _), text(x, s), literal_allowed_name(s).
literal_allowed(n) :- child(al, n, _), node(_, al, "argument_list", _, _), child(c, al, _), node(_, c, "call", _, _), field(c, "function", f), literal_allowed_fn(f).
literal_special_arg(n) :- child(al, n, _), node(_, al, "argument_list", _, _), child(c, al, _), node(_, c, "call", _, _), field(c, "function", f), literal_special_fn(f), literal_first_pos(al, n).
violation("data-layer-render-raw-strings", "literal", "string_literal", p, l) :- literal_long(n), literal_in_render(n), !literal_docstring(n), !literal_in_raise(n), !literal_allowed(n), !literal_special_arg(n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), literal_gate(d), doc(d, p, _), line(n, l).
fstring_literal_host(n) :- node(_, n, "string", _, _), literal_fpart(n), !literal_in_concat(n).
fstring_literal_host(n) :- literal_fhas(n), !literal_in_concat(n).
fstring_literal_host(n) :- node(_, n, "format_specifier", _, _).
fstring_literal_parsed(n) :- fstring_literal_host(n), fstring_piece(n, _, _, _), literal_in_render(n), !literal_in_raise(n).
fstring_literal_field(n, f, b, e) :- fstring_literal_parsed(n), literal_part(n, s), child(s, f, _), node(_, f, "interpolation", b, e).
fstring_literal_field(n, f, b, e) :- fstring_literal_parsed(n), node(_, n, "format_specifier", _, _), child(n, f, _), node(_, f, "format_expression", b, e).
rr_ctx2(b, n) :- fstring_literal_field(n, _, b, _).
rr_agg1(b, b2, n) :- rr_demand_agg_rr_agg1(b, n), rr_ctx2(b, n), fstring_literal_field(n, _, b2, _), b2 < b.
fstring_literal_ford(n, b, j) :- fstring_literal_field(n, _, b, _), j = count : { rr_agg1(b, _, n) }.
rr_ctx4(i, n) :- fstring_piece(n, i, "interpolation", _).
rr_agg3(i, i2, n) :- rr_demand_agg_rr_agg3(i, n), rr_ctx4(i, n), fstring_piece(n, i2, "interpolation", _), i2 < i.
fstring_literal_pord(n, i, j) :- fstring_literal_parsed(n), fstring_piece(n, i, "interpolation", _), j = count : { rr_agg3(i, _, n) }.
fstring_literal_later_piece(n, i) :- fstring_literal_parsed(n), fstring_piece(n, i, _, _), fstring_piece(n, i2, _, _), i2 > i.
fstring_literal_long(n, b) :- fstring_literal_ford(n, b, j), fstring_literal_pord(n, i, j), fstring_piece(n, h, "literal", v), i = @add(h, 1), match("(?s:.*)(?:(?s)^.{2})(?s:.*)", v).
fstring_literal_long(n, e) :- fstring_literal_parsed(n), node(_, n, _, _, e), fstring_piece(n, i, "literal", v), !fstring_literal_later_piece(n, i), match("(?s:.*)(?:(?s)^.{2})(?s:.*)", v).
fstring_literal_empty(c) :- literal_content(_, c, "p", t), match("(?:\\\\(?:\\r\\n|\\n|\\r))*", t).
fstring_literal_empty(c) :- literal_content(_, c, "f", t), match("(?:\\\\(?:\\r\\n|\\n|\\r))*", t).
fstring_literal_content(n, c) :- fstring_literal_parsed(n), literal_part(n, s), literal_content(s, c, _, _), !fstring_literal_empty(c).
fstring_literal_cont(c) :- fstring_literal_content(_, c), literal_content(_, c, "p", t), match("\\\\(?:\\r\\n|\\n|\\r)(?s:.*)", t).
fstring_literal_cont(c) :- fstring_literal_content(_, c), literal_content(_, c, "f", t), match("\\\\(?:\\r\\n|\\n|\\r)(?s:.*)", t).
fstring_literal_cnext(c, l) :- fstring_literal_cont(c), node(d, c, _, _, _), line(c, l0), end_line(c, le), tape_line(d, l, sp), l > l0, l <= le, text(sp, s), s != "\\".
fstring_literal_cnext_later(c, l) :- fstring_literal_cnext(c, l), fstring_literal_cnext(c, k), k < l.
fstring_literal_item0(n, o, l) :- fstring_literal_content(n, c), !fstring_literal_cont(c), node(_, c, _, o, _), line(c, l).
fstring_literal_item0(n, o, l) :- fstring_literal_content(n, c), fstring_literal_cnext(c, l), !fstring_literal_cnext_later(c, l), node(_, c, _, o, _).
fstring_literal_debug(f) :- node(_, f, "interpolation", _, _), token(f, _, "=", _, _).
fstring_literal_debug(f) :- node(_, f, "format_expression", _, _), token(f, _, "=", _, _).
fstring_literal_item0(n, o, l) :- fstring_literal_field(n, f, b, _), fstring_literal_debug(f), o = @add(b, 1), line(f, l).
fstring_literal_slice(n, a, l) :- fstring_literal_parsed(n), node(_, n, "format_specifier", s, _), a = @add(s, 1), line(n, l).
fstring_literal_slice(n, a, l) :- fstring_literal_parsed(n), node(_, n, "format_specifier", _, _), fstring_literal_field(n, f, _, a), end_line(f, l).
fstring_literal_item0(n, a, l) :- fstring_literal_slice(n, a, l), node(_, n, _, _, e), a < e, !fstring_literal_field(n, _, a, _).
fstring_literal_after(n, o, b) :- fstring_literal_item0(n, o, _), fstring_literal_field(n, _, b, fe), fe > o.
fstring_literal_not_next(n, o, b) :- fstring_literal_after(n, o, b), fstring_literal_after(n, o, b2), b2 < b.
fstring_literal_item(n, k, o, l) :- fstring_literal_item0(n, o, l), fstring_literal_after(n, o, k), !fstring_literal_not_next(n, o, k).
fstring_literal_item(n, e, o, l) :- fstring_literal_item0(n, o, l), !fstring_literal_after(n, o, _), node(_, n, _, _, e).
fstring_literal_not_first(n, k, o) :- fstring_literal_item(n, k, o, _), fstring_literal_item(n, k, o2, _), o2 < o.
fstring_literal_at(n, l) :- fstring_literal_long(n, k), fstring_literal_item(n, k, o, l), !fstring_literal_not_first(n, k, o).
violation("data-layer-render-raw-strings", "fstring-literal", "string_literal", p, l) :- fstring_literal_at(n, l), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), literal_gate(d), doc(d, p, _).
template_call(c, f) :- node(_, c, "call", _, _), field(c, "function", f), field(c, "arguments", al), literal_first_pos(al, a), literal_str(a), literal_in_render(c).
violation("data-layer-render-raw-strings", "template", "template_call", p, l) :- template_call(c, f), literal_template_fn(f), node(d, c, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), literal_gate(d), doc(d, p, _), line(c, l).
violation("data-layer-render-raw-strings", "static", "static_call", p, l) :- template_call(c, f), literal_static_fn(f), node(d, c, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), literal_gate(d), doc(d, p, _), line(c, l).
rr_demand_agg_rr_agg1(b, n) :- fstring_literal_field(n, _, b, _).
rr_demand_agg_rr_agg3(i, n) :- fstring_literal_parsed(n), fstring_piece(n, i, "interpolation", _).
