blocked4($low, $high) :- inside($low, $high, k0), inside($low, $s, k1), node(_, $s, "function_definition", _, _), node(_, $s, _, $v5, $v6), node(_, $high, _, $v7, $v8), $v7 <= $v5, $v6 <= $v8, $s != $high.
