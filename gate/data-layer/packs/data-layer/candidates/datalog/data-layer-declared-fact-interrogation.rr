.decl child(p: node, c: node, i: number)
.decl contract_attribute_name(s: symbol)
.decl contract_attribute_str_prefix(p: symbol)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl node_text(n: node, s: symbol)
.decl out_scope(d: number)
.decl override_identity_ascii(n: node, s: symbol, ns: number)
.decl override_identity_other_op(n: node)
.decl override_identity_self_args(g: node)
.decl override_identity_sep(n: node, x: symbol)
.decl override_identity_type_attr(a: node)
.decl str(n: node, s: symbol)
.decl strprefix(n: node, s: symbol)
.decl syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, field, text, child, strprefix, str, syntax_error, line, node_text
.output violation
contract_attribute_name("auxiliary_query").
contract_attribute_name("column_type_hints").
