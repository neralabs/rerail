.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.input doc, node, child, field, text
.kindset k0 = "lambda"
.kindset k1 = "call"
.kindset k2 = "function_definition"
.decl blocked118(low: node, high: node)
.decl blocked124(low: node, high: node)
.decl blocked157(low: node, high: node)
.decl blocked163(low: node, high: node)
.decl blocked55(low: node, high: node)
.decl blocked61(low: node, high: node)
.decl blocked85(low: node, high: node)
.decl blocked91(low: node, high: node)
.decl in_scope(d: int)
.decl m104(n: node)
.decl m137(n: node)
.decl m143(n: node)
.decl m145(n: node)
.decl m149(n: node)
.decl m176(n: node)
.decl m24(n: node)
.decl m26(n: node)
.decl m30(n: node)
.decl m74(n: node)
.decl out_scope(d: int)
.decl u111(n: node)
.decl u141(n: node)
.decl u150(n: node)
.decl u22(n: node)
.decl u31(n: node)
.decl u48(n: node)
.decl u5(n: node)
.decl u78(n: node)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "data_layer/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "_internal/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l[0-9][0-9][0-9][0-9]_*/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test_*.py").
m24($n) :- node(_, $n, "assignment", _, _).
m24($n) :- node(_, $n, "augmented_assignment", _, _).
m24($n) :- node(_, $n, "for_statement", _, _).
m24($n) :- node(_, $n, "for_in_clause", _, _).
m26($n) :- node(_, $n, "pattern_list", _, _).
m26($n) :- node(_, $n, "tuple_pattern", _, _).
m26($n) :- node(_, $n, "list_pattern", _, _).
m26($n) :- node(_, $n, "tuple", _, _).
m26($n) :- node(_, $n, "list", _, _).
m26($n) :- node(_, $n, "list_splat_pattern", _, _).
m26($n) :- node(_, $n, "parenthesized_expression", _, _).
m30($n) :- field($v23, "left", $n), m24($v23).
m30($n) :- child($v25, $n, _), m26($v25), u22($v25).
m30($n) :- child($v27, $n, _), node(_, $v27, "as_pattern_target", _, _), field($v28, "alias", $v27), node(_, $v28, "as_pattern", _, _), child($v29, $v28, _), node(_, $v29, "with_item", _, _).
u22($n) :- m30($n).
blocked55($low, $high) :- nearest($low, $s, k0), inside($s, $high, k2).
blocked61($low, $high) :- nearest($low, $s, k2), inside($s, $high, k1).
m74($n) :- child($n, $v71, _), node(_, $v71, "keyword_argument", _, _), field($v71, "name", $v72), node(_, $v72, "identifier", _, _), text($v72, $v73), $v73 = "fn".
blocked85($low, $high) :- nearest($low, $s, k0), inside($s, $high, k2).
blocked91($low, $high) :- nearest($low, $s, k2), inside($s, $high, k1).
m104($n) :- child($n, $v101, _), node(_, $v101, "keyword_argument", _, _), field($v101, "name", $v102), node(_, $v102, "identifier", _, _), text($v102, $v103), $v103 = "fn".
blocked118($low, $high) :- nearest($low, $s, k0), inside($s, $high, k2).
blocked124($low, $high) :- nearest($low, $s, k2), inside($s, $high, k1).
m137($n) :- child($n, $v134, _), node(_, $v134, "keyword_argument", _, _), field($v134, "name", $v135), node(_, $v135, "identifier", _, _), text($v135, $v136), $v136 = "fn".
m143($n) :- node(_, $n, "assignment", _, _).
m143($n) :- node(_, $n, "augmented_assignment", _, _).
m143($n) :- node(_, $n, "for_statement", _, _).
m143($n) :- node(_, $n, "for_in_clause", _, _).
m145($n) :- node(_, $n, "pattern_list", _, _).
m145($n) :- node(_, $n, "tuple_pattern", _, _).
m145($n) :- node(_, $n, "list_pattern", _, _).
m145($n) :- node(_, $n, "tuple", _, _).
m145($n) :- node(_, $n, "list", _, _).
m145($n) :- node(_, $n, "list_splat_pattern", _, _).
m145($n) :- node(_, $n, "parenthesized_expression", _, _).
m149($n) :- field($v142, "left", $n), m143($v142).
m149($n) :- child($v144, $n, _), m145($v144), u141($v144).
m149($n) :- child($v146, $n, _), node(_, $v146, "as_pattern_target", _, _), field($v147, "alias", $v146), node(_, $v147, "as_pattern", _, _), child($v148, $v147, _), node(_, $v148, "with_item", _, _).
u141($n) :- m149($n).
blocked157($low, $high) :- nearest($low, $s, k0), inside($s, $high, k2).
blocked163($low, $high) :- nearest($low, $s, k2), inside($s, $high, k1).
m176($n) :- child($n, $v173, _), node(_, $v173, "keyword_argument", _, _), field($v173, "name", $v174), node(_, $v174, "identifier", _, _), text($v174, $v175), $v175 = "fn".
.output violation
