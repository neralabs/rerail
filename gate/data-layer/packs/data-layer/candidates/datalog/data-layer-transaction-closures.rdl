.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.input doc, node, child, field, text
.kindset k0 = "lambda"
.kindset k1 = "call"
.kindset k2 = "function_definition"
.decl blocked12(low: node, high: node)
.decl blocked128(low: node, high: node)
.decl blocked134(low: node, high: node)
.decl blocked171(low: node, high: node)
.decl blocked177(low: node, high: node)
.decl blocked39(low: node, high: node)
.decl blocked57(low: node, high: node)
.decl blocked63(low: node, high: node)
.decl blocked91(low: node, high: node)
.decl blocked97(low: node, high: node)
.decl in_scope(d: int)
.decl m114(n: node)
.decl m151(n: node)
.decl m157(n: node)
.decl m159(n: node)
.decl m163(n: node)
.decl m194(n: node)
.decl m25(n: node)
.decl m27(n: node)
.decl m31(n: node)
.decl m80(n: node)
.decl out_scope(d: int)
.decl u121(n: node)
.decl u155(n: node)
.decl u164(n: node)
.decl u23(n: node)
.decl u32(n: node)
.decl u5(n: node)
.decl u50(n: node)
.decl u84(n: node)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "data_layer/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "_internal/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "l[0-9][0-9][0-9][0-9]_*/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test_*.py").
blocked12($low, $high) :- inside($low, $s, k0), node(_, $s, "lambda", _, _), inside($s, $high, k0).
m25($n) :- node(_, $n, "assignment", _, _).
m25($n) :- node(_, $n, "augmented_assignment", _, _).
m25($n) :- node(_, $n, "for_statement", _, _).
m25($n) :- node(_, $n, "for_in_clause", _, _).
m27($n) :- node(_, $n, "pattern_list", _, _).
m27($n) :- node(_, $n, "tuple_pattern", _, _).
m27($n) :- node(_, $n, "list_pattern", _, _).
m27($n) :- node(_, $n, "tuple", _, _).
m27($n) :- node(_, $n, "list", _, _).
m27($n) :- node(_, $n, "list_splat_pattern", _, _).
m27($n) :- node(_, $n, "parenthesized_expression", _, _).
m31($n) :- field($v24, "left", $n), m25($v24).
m31($n) :- child($v26, $n, _), m27($v26), u23($v26).
m31($n) :- child($v28, $n, _), node(_, $v28, "as_pattern_target", _, _), field($v29, "alias", $v28), node(_, $v29, "as_pattern", _, _), child($v30, $v29, _), node(_, $v30, "with_item", _, _).
u23($n) :- m31($n).
blocked39($low, $high) :- inside($low, $s, k0), node(_, $s, "lambda", _, _), inside($s, $high, k0).
blocked57($low, $high) :- inside($low, $s, k0), node(_, $s, "lambda", _, _), inside($s, $high, k2).
blocked63($low, $high) :- inside($low, $high, k1), inside($low, $s, k2), node(_, $s, "function_definition", _, _), node(_, $s, _, $v64, $v65), node(_, $high, _, $v66, $v67), $v66 <= $v64, $v65 <= $v67, $s != $high.
m80($n) :- child($n, $v77, _), node(_, $v77, "keyword_argument", _, _), field($v77, "name", $v78), node(_, $v78, "identifier", _, _), text($v78, $v79), $v79 = "fn".
blocked91($low, $high) :- inside($low, $s, k0), node(_, $s, "lambda", _, _), inside($s, $high, k2).
blocked97($low, $high) :- inside($low, $high, k1), inside($low, $s, k2), node(_, $s, "function_definition", _, _), node(_, $s, _, $v98, $v99), node(_, $high, _, $v100, $v101), $v100 <= $v98, $v99 <= $v101, $s != $high.
m114($n) :- child($n, $v111, _), node(_, $v111, "keyword_argument", _, _), field($v111, "name", $v112), node(_, $v112, "identifier", _, _), text($v112, $v113), $v113 = "fn".
blocked128($low, $high) :- inside($low, $s, k0), node(_, $s, "lambda", _, _), inside($s, $high, k2).
blocked134($low, $high) :- inside($low, $high, k1), inside($low, $s, k2), node(_, $s, "function_definition", _, _), node(_, $s, _, $v135, $v136), node(_, $high, _, $v137, $v138), $v137 <= $v135, $v136 <= $v138, $s != $high.
m151($n) :- child($n, $v148, _), node(_, $v148, "keyword_argument", _, _), field($v148, "name", $v149), node(_, $v149, "identifier", _, _), text($v149, $v150), $v150 = "fn".
m157($n) :- node(_, $n, "assignment", _, _).
m157($n) :- node(_, $n, "augmented_assignment", _, _).
m157($n) :- node(_, $n, "for_statement", _, _).
m157($n) :- node(_, $n, "for_in_clause", _, _).
m159($n) :- node(_, $n, "pattern_list", _, _).
m159($n) :- node(_, $n, "tuple_pattern", _, _).
m159($n) :- node(_, $n, "list_pattern", _, _).
m159($n) :- node(_, $n, "tuple", _, _).
m159($n) :- node(_, $n, "list", _, _).
m159($n) :- node(_, $n, "list_splat_pattern", _, _).
m159($n) :- node(_, $n, "parenthesized_expression", _, _).
m163($n) :- field($v156, "left", $n), m157($v156).
m163($n) :- child($v158, $n, _), m159($v158), u155($v158).
m163($n) :- child($v160, $n, _), node(_, $v160, "as_pattern_target", _, _), field($v161, "alias", $v160), node(_, $v161, "as_pattern", _, _), child($v162, $v161, _), node(_, $v162, "with_item", _, _).
u155($n) :- m163($n).
blocked171($low, $high) :- inside($low, $s, k0), node(_, $s, "lambda", _, _), inside($s, $high, k2).
blocked177($low, $high) :- inside($low, $high, k1), inside($low, $s, k2), node(_, $s, "function_definition", _, _), node(_, $s, _, $v178, $v179), node(_, $high, _, $v180, $v181), $v180 <= $v178, $v179 <= $v181, $s != $high.
m194($n) :- child($n, $v191, _), node(_, $v191, "keyword_argument", _, _), field($v191, "name", $v192), node(_, $v192, "identifier", _, _), text($v192, $v193), $v193 = "fn".
.output violation
