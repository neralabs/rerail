.decl graphql_authority_frame(kind: symbol)
graphql_authority_frame("function_definition"). graphql_authority_frame("decorator").
.decl graphql_authority_type(kind: symbol)
graphql_authority_type("type").
.decl child(p: node, c: node, i: number)
.decl cpython_syntax_error(d: number, l: number, msg: symbol)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl fstring_piece(n: node, i: number, kind: symbol, v: symbol)
.decl graphql_authority_arg0(c: node, a: node)
.decl graphql_authority_auth(f: node, x: symbol)
.decl graphql_authority_bare(l: node, t: node)
.decl graphql_authority_chain(a: node, b: node)
.decl graphql_authority_decorator(c: node, x: symbol)
.decl graphql_authority_edge(f: node, s: symbol, t: symbol)
.decl graphql_authority_file(d: number, p: symbol)
.decl graphql_authority_fn(n: node, f: node)
.decl graphql_authority_gate(d: number)
.decl graphql_authority_id(i: node, x: symbol)
.decl graphql_authority_inner(a: node)
.decl graphql_authority_piece(i: node, s: symbol)
.decl graphql_authority_pos(c: node, a: node, i: number)
.decl graphql_authority_ref(e: node, x: symbol)
.decl graphql_authority_root(e: node, x: symbol)
.decl graphql_authority_seed(f: node, x: symbol)
.decl graphql_authority_strhost(n: node)
.decl graphql_authority_strpart(n: node)
.decl graphql_authority_strtext(n: node, v: symbol)
.decl graphql_authority_unparen(e: node, m: node)
.decl graphql_authority_word(ty: node)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl node_text(n: node, s: symbol)
.decl option_value(name: symbol, v: symbol)
.decl out_scope(d: number)
.decl reported_parser_error_invalid(d: number)
.decl source(d: number, sp: node)
.decl str(n: node, v: symbol)
.decl syntax_error(d: number)
.decl tape_syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl token(p: node, i: number, s: symbol, start: number, end: number)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, syntax_error, node, field, child, text, line, value, str, value_type_of, fstring_piece, source, node_text, token, cpython_syntax_error
.output violation
option_value("entryPoint", "all").
option_value("parameters", "{}").
in_scope(d) :- doc(d, p, _), glob("l9750_graphql/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9900_auto_api/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
tape_syntax_error(d) :- syntax_error(d).
graphql_authority_file(d, p) :- node(d, _, "module", _, _), in_scope(d), !tape_syntax_error(d), !cpython_syntax_error(d, _, _), !out_scope(d), graphql_authority_gate(d), doc(d, p, _).
graphql_authority_gate(d) :- option_value("entryPoint", "scan_source"), node(d, _, "module", _, _).
graphql_authority_gate(d) :- !option_value("entryPoint", "scan_source"), node(d, m, "module", _, _), node_text(m, s), match("(?s:.*)(?:LazyResult|PlanScope|ServerPlan|Transaction)(?s:.*)", s).
graphql_authority_id(i, x) :- node(_, i, "identifier", _, _), text(i, t), x = @nfkc(t).
graphql_authority_fn(n, f) :- nearest(n, f, graphql_authority_frame), node(_, f, "function_definition", _, _).
graphql_authority_fn(n, f) :- nearest(n, dc, graphql_authority_frame), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", f), node(_, f, "function_definition", _, _).
graphql_authority_fn(n, f) :- nearest(n, dc, graphql_authority_frame), node(_, dc, "decorator", _, _), child(dd, dc, _), field(dd, "definition", c), node(_, c, "class_definition", _, _), graphql_authority_fn(c, f).
graphql_authority_strhost(n) :- node(_, n, "string", _, _), !graphql_authority_strpart(n).
graphql_authority_strhost(n) :- node(_, n, "concatenated_string", _, _).
graphql_authority_strpart(n) :- node(_, p, "concatenated_string", _, _), child(p, n, _).
graphql_authority_strtext(n, v) :- graphql_authority_strhost(n), value(n, v), value_type_of(n, "str").
graphql_authority_strtext(n, v) :- graphql_authority_strhost(n), fstring_piece(n, _, "literal", v).
graphql_authority_strtext(n, v) :- node(_, n, "format_specifier", _, _), fstring_piece(n, _, "literal", v).
graphql_authority_piece(i, s) :- graphql_authority_id(i, s).
graphql_authority_piece(n, s) :- graphql_authority_strtext(n, v), s = @rx_replace(v, "[\\p{C}\\p{Z}--\\x20]", " x").
graphql_authority_piece(n, s) :- node(_, n, "string", _, _), value_type_of(n, "bytes"), str(n, s).
graphql_authority_word(ty) :- graphql_authority_piece(i, s), inside(i, ty, graphql_authority_type), match("(?s)(?:[^A-Za-z_]*[A-Za-z_][\\p{L}\\p{N}_]*[^\\p{L}\\p{N}_])*[^A-Za-z_]*(?:ServerPlan|BaseServerPlan|_GraphQLServerPlan|LazyResult|(?:[A-Za-z_][\\p{L}\\p{N}_]*)?(?:Transaction|PlanScope))(?:[^\\p{L}\\p{N}_].*)?", s).
graphql_authority_seed(f, x) :- field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_parameter", _, _), child(p, nm, 0), graphql_authority_id(nm, x), field(p, "type", ty), graphql_authority_word(ty).
graphql_authority_seed(f, x) :- field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_default_parameter", _, _), field(p, "name", nm), graphql_authority_id(nm, x), field(p, "type", ty), graphql_authority_word(ty).
graphql_authority_root(e, x) :- graphql_authority_id(e, x).
graphql_authority_root(e, x) :- node(_, e, "parenthesized_expression", _, _), child(e, i, 0), graphql_authority_root(i, x).
graphql_authority_root(e, x) :- node(_, e, "attribute", _, _), field(e, "object", o), graphql_authority_root(o, x).
graphql_authority_root(e, x) :- node(_, e, "call", _, _), field(e, "function", g), graphql_authority_root(g, x).
graphql_authority_inner(a) :- node(_, b, "assignment", _, _), field(b, "right", a), node(_, a, "assignment", _, _).
graphql_authority_chain(a, a) :- node(_, a, "assignment", _, _), !graphql_authority_inner(a).
graphql_authority_chain(a, c) :- graphql_authority_chain(a, b), field(b, "right", c), node(_, c, "assignment", _, _).
graphql_authority_edge(f, s, t) :- graphql_authority_chain(a, b), field(b, "right", v), !node(_, v, "assignment", _, _), graphql_authority_root(v, s), graphql_authority_chain(a, b2), field(b2, "left", l), graphql_authority_bare(l, tn), graphql_authority_id(tn, t), graphql_authority_fn(a, f).
graphql_authority_bare(l, l) :- node(_, l, "identifier", _, _).
graphql_authority_bare(l, t) :- node(_, l, "tuple_pattern", _, _), child(l, c, 0), !child(l, _, 1), !token(l, _, ",", _, _), graphql_authority_bare(c, t).
graphql_authority_auth(f, x) :- graphql_authority_seed(f, x).
graphql_authority_auth(f, t) :- graphql_authority_auth(f, s), graphql_authority_edge(f, s, t).
violation("data-layer-graphql-plan-ownership", "graphql-authority", "GPO001", p, l) :- node(d, n, "attribute", _, _), field(n, "attribute", at), graphql_authority_id(at, x), prefix("_", x), field(n, "object", o), graphql_authority_fn(n, f), graphql_authority_root(o, r), graphql_authority_auth(f, r), graphql_authority_file(d, p), line(n, l).
graphql_authority_pos(c, a, i) :- node(_, c, "call", _, _), field(c, "arguments", al), node(_, al, "argument_list", _, _), child(al, a, i), node(_, a, k, _, _), k != "keyword_argument", k != "dictionary_splat".
graphql_authority_arg0(c, a) :- graphql_authority_pos(c, a, i), i = min j : { graphql_authority_pos(c, _, j) }.
graphql_authority_unparen(e, e) :- node(_, e, k, _, _), k != "parenthesized_expression".
graphql_authority_unparen(e, m) :- node(_, e, "parenthesized_expression", _, _), child(e, i, 0), graphql_authority_unparen(i, m).
violation("data-layer-graphql-plan-ownership", "graphql-authority", "GPO002", p, l) :- node(d, n, "call", _, _), field(n, "function", g0), graphql_authority_unparen(g0, g), graphql_authority_id(g, "getattr"), graphql_authority_arg0(n, a), graphql_authority_fn(n, f), graphql_authority_root(a, r), graphql_authority_auth(f, r), graphql_authority_file(d, p), line(n, l).
violation("data-layer-graphql-plan-ownership", "graphql-authority", "GPO003", p, l) :- node(d, n, "call", _, _), field(n, "function", g0), graphql_authority_unparen(g0, g), node(_, g, "attribute", _, _), field(g, "attribute", at), graphql_authority_id(at, "__getattribute__"), field(g, "object", o0), graphql_authority_unparen(o0, o), graphql_authority_id(o, "object"), graphql_authority_arg0(n, a), graphql_authority_fn(n, f), graphql_authority_root(a, r), graphql_authority_auth(f, r), graphql_authority_file(d, p), line(n, l).
graphql_authority_ref(e, x) :- graphql_authority_id(e, x).
graphql_authority_ref(e, x) :- node(_, e, "attribute", _, _), field(e, "attribute", a), graphql_authority_id(a, x).
graphql_authority_decorator(c, x) :- field(dd, "definition", c), child(dd, dc, _), node(_, dc, "decorator", _, _), child(dc, e0, 0), graphql_authority_unparen(e0, e), !node(_, e, "call", _, _), graphql_authority_ref(e, x).
graphql_authority_decorator(c, x) :- field(dd, "definition", c), child(dd, dc, _), node(_, dc, "decorator", _, _), child(dc, e0, 0), graphql_authority_unparen(e0, e), node(_, e, "call", _, _), field(e, "function", g0), graphql_authority_unparen(g0, g), graphql_authority_ref(g, x).
violation("data-layer-graphql-plan-ownership", "graphql-authority", "GPO004", p, l) :- node(d, c, "class_definition", _, _), graphql_authority_decorator(c, "reusable_template"), field(c, "body", b), child(b, es, _), node(_, es, "expression_statement", _, _), child(es, a, 0), node(_, a, "assignment", _, _), field(a, "type", ty), graphql_authority_word(ty), graphql_authority_file(d, p), line(a, l).
reported_parser_error_invalid(d) :- cpython_syntax_error(d, _, _).
violation("data-layer-graphql-plan-ownership", "reported-parser-error", "GPO000", p, 1) :- option_value("entryPoint", "scan_source"), reported_parser_error_invalid(d), in_scope(d), !out_scope(d), doc(d, p, _).
violation("data-layer-graphql-plan-ownership", "reported-parser-error", "GPO000", p, 1) :- !option_value("entryPoint", "scan_source"), reported_parser_error_invalid(d), in_scope(d), !out_scope(d), source(d, sp), match_all("ServerPlan|PlanScope|Transaction|LazyResult", sp, _), doc(d, p, _).
