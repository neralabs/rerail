in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("data_layer/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("_internal/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l[0-9][0-9][0-9][0-9]_*/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test_*.py", p).
tape_syntax_error(d) :- syntax_error(d).
txn_str_value(n, v) :- node(_, n, "string", _, _), value(n, v), value_type_of(n, "str").
txn_str_value(n, v) :- node(_, n, "concatenated_string", _, _), value(n, v), value_type_of(n, "str").
txn_ahc(n) :- node(_, n, "identifier", _, _), text(n, s), contains("Connection", s).
txn_ahc(n) :- txn_str_value(n, v), contains("Connection", v).
txn_ahc(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c), txn_ahc(c).
txn_ahc(n) :- node(_, n, "subscript", _, _), field(n, "value", c), txn_ahc(c).
txn_ahc(n) :- node(_, n, "generic_type", _, _), child(n, c, _), node(_, c, "identifier", _, _), txn_ahc(c).
txn_ahc(n) :- txn_wrapper(n), child(n, c, _), txn_ahc(c).
txn_ahc(n) :- txn_ahc_left(n).
txn_ahc(n) :- txn_ahc_right(n).
txn_ahc_left(n) :- txn_binop(n), field(n, "left", c), txn_ahc(c).
txn_ahc_left(n) :- txn_union_nth(n, c, 1), txn_ahc(c).
txn_ahc_right(n) :- txn_binop(n), field(n, "right", c), txn_ahc(c).
txn_ahc_right(n) :- txn_union_nth(n, c, 2), txn_ahc(c).
rr_ctx2(cs, n) :- node(_, n, "union_type", _, _), child(n, c, i), node(_, c, "type", cs, _).
rr_agg1(cs, n, s, st) :- rr_ctx2(cs, n), token(n, _, s, st, _), prefix("#", s), st < cs.
txn_union_nth(n, c, k) :- node(_, n, "union_type", _, _), child(n, c, i), node(_, c, "type", cs, _), j = count : { rr_agg1(cs, n, _, _) }, k = @add(@add(i, j), 1).
txn_wrapper(n) :- node(_, n, "type", _, _).
txn_wrapper(n) :- node(_, n, "parenthesized_expression", _, _).
txn_binop(n) :- node(_, n, "binary_operator", _, _).
txn_binop(n) :- node(_, n, "union_type", _, _).
txn_ac(n) :- node(_, n, "identifier", _, _), text(n, s), match("(?s:.*)(?:Connection|^conn$)(?s:.*)", s), s != "ConnectionId".
txn_ac(n) :- txn_str_value(n, v), match("(?s:.*)(?:Connection|^conn$)(?s:.*)", v), v != "ConnectionId".
txn_ac(n) :- node(_, n, "attribute", _, _), field(n, "attribute", c), txn_ac(c).
txn_ac(n) :- node(_, n, "subscript", _, _), field(n, "value", c), txn_ac(c).
txn_ac(n) :- node(_, n, "generic_type", _, _), child(n, c, _), node(_, c, "identifier", _, _), txn_ac(c).
txn_ac(n) :- txn_wrapper(n), child(n, c, _), txn_ac(c).
txn_ac(n) :- txn_ahc_left(n), txn_ac_left(n).
txn_ac(n) :- txn_binop(n), !txn_ahc_left(n), txn_ahc_right(n), txn_ac_right(n).
txn_ac_left(n) :- txn_binop(n), field(n, "left", c), txn_ac(c).
txn_ac_left(n) :- txn_union_nth(n, c, 1), txn_ac(c).
txn_ac_right(n) :- txn_binop(n), field(n, "right", c), txn_ac(c).
txn_ac_right(n) :- txn_union_nth(n, c, 2), txn_ac(c).
txn_param_name(q, c) :- node(_, q, "typed_parameter", _, _), child(q, c, _), node(_, c, "identifier", _, _), text(c, s), s != "self".
txn_param_name(q, c) :- node(_, q, "typed_default_parameter", _, _), field(q, "name", c), node(_, c, "identifier", _, _), text(c, s), s != "self".
txn_star(s) :- node(_, s, "keyword_separator", _, _).
txn_star(s) :- txn_splat(s).
txn_star(s) :- node(_, s, "typed_parameter", _, _), child(s, c, _), txn_splat(c).
txn_splat(s) :- node(_, s, "list_splat_pattern", _, _).
txn_splat(s) :- node(_, s, "dictionary_splat_pattern", _, _).
txn_typed(ps, q, i) :- node(_, ps, "parameters", _, _), child(ps, q, i), node(_, q, "typed_parameter", _, _).
txn_typed(ps, q, i) :- node(_, ps, "parameters", _, _), child(ps, q, i), node(_, q, "typed_default_parameter", _, _).
txn_before_slash(ps, i) :- txn_typed(ps, _, i), child(ps, s, j), node(_, s, "positional_separator", _, _), i < j.
txn_after_star(ps, i) :- txn_typed(ps, _, i), child(ps, s, j), j < i, txn_star(s).
txn_param(ps, q, i) :- txn_typed(ps, q, i), !txn_before_slash(ps, i), !txn_after_star(ps, i), field(q, "type", t), txn_ac(t), txn_param_name(q, _).
txn_param_later(ps, i) :- txn_param(ps, _, i), txn_param(ps, _, j), j < i.
txn_cf(f, conn) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), txn_param(ps, q, i), !txn_param_later(ps, i), txn_param_name(q, c), text(c, conn).
txn_call(c, conn) :- node(_, c, "call", _, _), field(c, "function", a), node(_, a, "attribute", _, _), field(a, "object", o), node(_, o, "identifier", _, _), text(o, conn), field(a, "attribute", m), node(_, m, "identifier", _, _), text(m, s), (s = "read" ; s = "schema_transaction" ; s = "write").
txn_it_blocked(c, b) :- txn_call(c, _), inside(c, s, txn_functions), inside(s, b, txn_blocks).
txn_it(f, conn) :- txn_call(c, conn), inside(c, b, txn_blocks), field(f, "body", b), node(_, f, "function_definition", _, _), !txn_it_blocked(c, b).
txn_init_in_conn_class(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), node(_, c, "identifier", _, _), text(c, "__init__"), nearest(f, k, txn_classes), field(k, "name", kn), text(kn, s), match("(?s:.*)(?:Connection|SyncConnectionPool|Transaction|TransactionGenerator)(?s:.*)", s).
txn_named(f, cat) :- field(f, "name", c), node(_, c, "identifier", _, _), text(c, s), option_item(cat, _, s), prefix("category-", cat).
txn_classified(f) :- txn_named(f, _).
txn_unclassified(f) :- node(_, f, "function_definition", _, _), !txn_init_in_conn_class(f), !txn_classified(f).
txn_gate(d) :- option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, s), (contains("Connection", s) ; contains("conn", s)).
txn_gate(d) :- node(d, _, "module", _, _), !option_on("sourceGate").
txn_name_1(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:initialize|ensure|bootstrap|create_log_table)(?s:.*)", s).
txn_name_2(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:ripple|reaper|background|process_)(?s:.*)", s).
txn_name_3(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:table_exists|get_table|list_tables|introspect)(?s:.*)", s).
txn_name_4(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:export_|import_|validate_import)(?s:.*)", s).
txn_name_5(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:rbac|permission)(?s:.*)", s).
txn_name_6(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:schema_transaction|begin_)(?s:.*)", s).
txn_name_7(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:_handler)(?s:.*)", s).
txn_name_8(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:(?i)validat)(?s:.*)", s).
txn_name_9(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:ensure|initialize|(?i:bootstrap))(?s:.*)", s).
txn_name_10(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:stale|reaper|recover|ripple|process_|enqueue_ripple)(?s:.*)", s).
txn_name_11(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:_detect_|get_capabilities|has_native|get_backend_type|run_after_rollback|attach_renewable_capability_runtime)(?s:.*)", s).
txn_name_12(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:register_queue|register_table|sync_column|register_trigger)(?s:.*)", s).
txn_name_13(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:subscribe)(?s:.*)", s).
txn_name_14(f) :- node(_, f, "function_definition", _, _), field(f, "name", c), text(c, s), match("(?s:.*)(?:export_database|import_database)(?s:.*)", s).
violation("data-layer-transaction-patterns", "category-1", "LEGITIMATE", p, l) :- txn_cf(f, conn), option_on("oracleAnalyzer"), txn_init_in_conn_class(f), node(d, f, _, _, _), txn_gate(d), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).
violation("data-layer-transaction-patterns", "category-2", "LEGITIMATE", p, l) :- txn_cf(f, conn), option_on("oracleAnalyzer"), !txn_init_in_conn_class(f), txn_named(f, "category-LEGITIMATE"), node(d, f, _, _, _), txn_gate(d), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).
violation("data-layer-transaction-patterns", "category-3", "BOOTSTRAP", p, l) :- txn_cf(f, conn), option_on("oracleAnalyzer"), !txn_init_in_conn_class(f), txn_named(f, "category-BOOTSTRAP"), node(d, f, _, _, _), txn_gate(d), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).
violation("data-layer-transaction-patterns", "category-4", "BACKGROUND", p, l) :- txn_cf(f, conn), option_on("oracleAnalyzer"), !txn_init_in_conn_class(f), txn_named(f, "category-BACKGROUND"), node(d, f, _, _, _), txn_gate(d), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).
violation("data-layer-transaction-patterns", "category-5", "BACKEND_SPECIFIC", p, l) :- txn_cf(f, conn), option_on("oracleAnalyzer"), !txn_init_in_conn_class(f), txn_named(f, "category-BACKEND_SPECIFIC"), !txn_it(f, conn), node(d, f, _, _, _), txn_gate(d), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).
violation("data-layer-transaction-patterns", "internal-5", "INTERNAL_TXN_VIOLATION", p, l) :- txn_cf(f, conn), !txn_init_in_conn_class(f), txn_named(f, "category-BACKEND_SPECIFIC"), txn_it(f, conn), node(d, f, _, _, _), txn_gate(d), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).
violation("data-layer-transaction-patterns", "category-6", "CAPABILITY", p, l) :- txn_cf(f, conn), option_on("oracleAnalyzer"), !txn_init_in_conn_class(f), txn_named(f, "category-CAPABILITY"), !txn_it(f, conn), node(d, f, _, _, _), txn_gate(d), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(f, l).
