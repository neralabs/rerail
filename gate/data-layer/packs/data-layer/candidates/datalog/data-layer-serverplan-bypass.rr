tape_syntax_error(d) :- syntax_error(d).
bypass_call(c, h) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "identifier", _, _), text(f, h).
bypass_call(c, h) :- node(_, c, "call", _, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, h).
bypass_hit(h, p, l) :- option_value("entryPoint", v), bypass_entry(v), bypass_call(c, h), node(d, c, _, _, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), doc(d, p, _), line(c, l).
violation("data-layer-serverplan-bypass", "bypass-_execute_raw_sql", "_execute_raw_sql", p, l) :- bypass_hit("_execute_raw_sql", p, l).
violation("data-layer-serverplan-bypass", "bypass-_execute_raw_sql_async", "_execute_raw_sql_async", p, l) :- bypass_hit("_execute_raw_sql_async", p, l).
violation("data-layer-serverplan-bypass", "bypass-_query_raw_sql_async", "_query_raw_sql_async", p, l) :- bypass_hit("_query_raw_sql_async", p, l).
