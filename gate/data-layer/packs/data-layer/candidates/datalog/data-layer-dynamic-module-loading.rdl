violation("data-layer-dynamic-module-loading", "pattern-1", "DML001", $p, $l) :- node(_, $n, "subscript", _, _), field($n, "value", $v6), node(_, $v6, "call", _, _), field($v6, "function", $v7), name($v7, $v9), $v9 = "globals", field($v6, "arguments", $v10), name($v10, $v12), @glob($v12, "()"), m16($n), !m21($n), node($d, $n, _, _, _), in_scope($d), !out_scope($d), doc($d, $p, _), line($n, $l).
