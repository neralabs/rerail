.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl m1(n: node)
.decl m15(n: node)
.decl m22(n: node)
.decl m25(n: node)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl out_scope(d: number)
.decl syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, child, field, text, line, syntax_error
.output violation
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("data_layer/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("_internal/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l[0-9][0-9][0-9][0-9]_*/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/conform/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.pytest_cache/**", p).
out_scope(d) :- doc(d, p, _), glob("**/node_modules/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/browser_build/**", p).
m1(n) :- node(_, n, "assignment", _, _).
m1(n) :- node(_, n, "augmented_assignment", _, _).
m15(n) :- child(n, v6, _), node(_, v6, "subscript", _, _), field(v6, "value", v7), node(_, v7, "attribute", _, _), field(v7, "attribute", v8), node(_, v8, "identifier", _, _), text(v8, v9), v9 = "cte_refs".
m15(n) :- child(n, v10, _), node(_, v10, "expression_list", _, _), child(v10, v11, _), node(_, v11, "subscript", _, _), field(v11, "value", v12), node(_, v12, "attribute", _, _), field(v12, "attribute", v13), node(_, v13, "identifier", _, _), text(v13, v14), v14 = "cte_refs".
m22(n) :- m1(n), field(n, "left", v2), node(_, v2, "subscript", _, _), field(v2, "value", v3), node(_, v3, "attribute", _, _), field(v3, "attribute", v4), node(_, v4, "identifier", _, _), text(v4, v5), v5 = "cte_refs".
m22(n) :- node(_, n, "delete_statement", _, _), m15(n).
m22(n) :- node(_, n, "call", _, _), field(n, "function", v16), node(_, v16, "attribute", _, _), field(v16, "attribute", v17), node(_, v17, "identifier", _, _), text(v17, v18), (v18 = "clear" ; v18 = "pop" ; v18 = "popitem" ; v18 = "setdefault" ; v18 = "update"), field(v16, "object", v19), node(_, v19, "attribute", _, _), field(v19, "attribute", v20), node(_, v20, "identifier", _, _), text(v20, v21), v21 = "cte_refs".
m25(n) :- node(v23, n, _, _, _), doc(v23, v24, _), glob("**/l2070_batching/compilation.py", v24).
violation("data-layer-publication-registry-writes", "direct-write", "REGISTRY_DIRECT_WRITE", p, l) :- m22(n), !m25(n), node(d, n, _, _, _), in_scope(d), !syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
