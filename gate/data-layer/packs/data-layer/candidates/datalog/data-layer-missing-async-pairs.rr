in_scope(d) :- doc(d, p, _), glob("l2050_transaction/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l7200_versioned_transactions/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l7300_sql_versioned_transactions/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/l7248_sparse_versioned_transactions/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
pair_doc(d) :- in_scope(d), !out_scope(d), !syntax_error(d), option_on("sourceGate"), node(d, m, "module", _, _), node_text(m, s), contains("def ", s).
pair_doc(d) :- in_scope(d), !out_scope(d), !syntax_error(d), !option_on("sourceGate"), node(d, _, "module", _, _).
pair_name_ok(x) :- node(_, f, "function_definition", _, _), field(f, "name", nm), text(nm, x), !pair_excluded(x), !suffix("_lazy", x), !pair_excluded_async(x), !prefix("_", x).
pair_name_ok(x) :- node(_, f, "function_definition", _, _), field(f, "name", nm), text(nm, x), !pair_excluded(x), !suffix("_lazy", x), !pair_excluded_async(x), suffix("_async", x).
pair_name_ok(x) :- node(_, f, "function_definition", _, _), field(f, "name", nm), text(nm, x), !pair_excluded(x), !suffix("_lazy", x), !pair_excluded_async(x), (contains("commit", x) ; contains("commit_branch", x) ; contains("count", x) ; contains("create_branch", x) ; contains("delete_by_id", x) ; contains("delete_many", x) ; contains("execute", x) ; contains("execute_one", x) ; contains("find_object_branches", x) ; contains("find_object_revisions", x) ; contains("first", x) ; contains("get_history", x) ; contains("insert", x) ; contains("insert_many", x) ; contains("insert_many_raw", x) ; contains("rollback", x) ; contains("select_at_revision", x) ; contains("select_many", x) ; contains("select_one", x) ; contains("update", x) ; contains("update_many", x) ; contains("upsert", x) ; contains("upsert_many", x)).
pair_def(d, f, g, x, s, e, 0) :- pair_doc(d), node(d, f, "function_definition", s, e), !inside(f, _, pair_fdef), nearest(f, c, pair_class), field(c, "name", cn), text(cn, g), field(f, "name", nm), text(nm, x), pair_name_ok(x), !op(f, "async").
pair_def(d, f, g, x, s, e, 1) :- pair_doc(d), node(d, f, "function_definition", s, e), !inside(f, _, pair_fdef), nearest(f, c, pair_class), field(c, "name", cn), text(cn, g), field(f, "name", nm), text(nm, x), pair_name_ok(x), op(f, "async").
pair_later(f) :- pair_def(d, f, g, x, _, e, a), pair_def(d, _, g, x, s2, _, a), e <= s2.
pair_selected(d, f, g, x, a) :- pair_def(d, f, g, x, _, _, a), !pair_later(f), g != "_CachedQuery".
pair_param_name(p, t) :- node(_, ps, "parameters", _, _), child(ps, p, _), node(_, p, "identifier", _, _), text(p, t), t != "self".
pair_param_name(p, t) :- node(_, ps, "parameters", _, _), child(ps, p, _), node(_, p, "typed_parameter", _, _), child(p, c, _), node(_, c, "identifier", _, _), text(c, t), t != "self".
pair_param_name(p, t) :- node(_, ps, "parameters", _, _), child(ps, p, _), node(_, p, "default_parameter", _, _), field(p, "name", c), node(_, c, "identifier", _, _), text(c, t), t != "self".
pair_param_name(p, t) :- node(_, ps, "parameters", _, _), child(ps, p, _), node(_, p, "typed_default_parameter", _, _), field(p, "name", c), node(_, c, "identifier", _, _), text(c, t), t != "self".
pair_splat(p) :- pair_param_name(p, _), node(_, p, k, _, _), pair_splat_kind(k).
pair_splat(p) :- pair_param_name(p, _), node(_, p, "typed_parameter", _, _), child(p, c, _), node(_, c, k, _, _), pair_splat_kind(k).
pair_star(q) :- node(_, q, "keyword_separator", _, _).
pair_star(q) :- node(_, q, "list_splat_pattern", _, _).
pair_star(q) :- node(_, q, "typed_parameter", _, _), child(q, c, _), node(_, c, "list_splat_pattern", _, _).
pair_not_pos(p) :- pair_param_name(p, _), child(ps, p, i), child(ps, q, j), j > i, node(_, q, "positional_separator", _, _).
pair_not_pos(p) :- pair_param_name(p, _), child(ps, p, i), child(ps, q, j), j < i, pair_star(q).
pair_pos(ps, p, i, t) :- pair_param_name(p, t), child(ps, p, i), !pair_splat(p), !pair_not_pos(p).
pair_io(f) :- pair_selected(_, f, _, _, _), field(f, "parameters", ps), pair_pos(ps, p, _, t), pair_io_name(t), node(_, p, "identifier", _, _).
pair_io(f) :- pair_selected(_, f, _, _, _), field(f, "parameters", ps), pair_pos(ps, p, _, _), child(p, c, _), node(_, c, "identifier", _, _), text(c, t), pair_io_name(t).
pair_io(f) :- pair_selected(_, f, _, _, _), node(_, c, "call", _, _), inside(c, f, pair_fdef), field(c, "function", fn), node(_, fn, "attribute", _, _), field(fn, "attribute", at), text(at, t), pair_io_call(t).
missing_async_counterpart(f, c) :- pair_selected(d, f, g, x, 0), y = @concat(x, "_async"), pair_def(d, c, g, y, _, _, 1).
missing_async_counterpart(f, c) :- pair_selected(d, f, g, x, 0), !suffix("_async", x), pair_def(d, c, g, x, _, _, 1).
missing_async_paired(f) :- missing_async_counterpart(f, _).
missing_async_public(x) :- pair_selected(_, _, _, x, 0), !prefix("_", x).
missing_async_public(x) :- pair_selected(_, _, _, x, 0), pair_public_sync(x).
violation("data-layer-missing-async-pairs", "missing-async", "missing_pair", p, l) :- pair_selected(d, f, _, x, 0), missing_async_public(x), pair_io(f), !missing_async_paired(f), doc(d, p, _), line(f, l).
missing_sync_paired(f) :- pair_selected(d, f, g, x, 1), pair_def(d, _, g, y, _, _, 0), x = @concat(y, "_async").
missing_sync_paired(f) :- pair_selected(d, f, g, x, 1), !suffix("_async", x), pair_def(d, _, g, x, _, _, 0).
missing_sync_public(x) :- pair_selected(_, _, _, x, 1), !prefix("_", x).
missing_sync_public(x) :- pair_selected(_, _, _, x, 1), pair_public_async(x).
violation("data-layer-missing-async-pairs", "missing-sync", "missing_pair", p, l) :- pair_selected(d, f, _, x, 1), missing_sync_public(x), pair_io(f), !missing_sync_paired(f), doc(d, p, _), line(f, l).
argument_mismatch_def(f) :- pair_selected(_, f, _, _, 0).
argument_mismatch_def(c) :- missing_async_counterpart(_, c).
argument_mismatch_has_pos(f) :- argument_mismatch_def(f), field(f, "parameters", ps), pair_pos(ps, _, _, _).
argument_mismatch_count(f, 0) :- argument_mismatch_def(f), !argument_mismatch_has_pos(f).
argument_mismatch_count(f, k) :- argument_mismatch_has_pos(f), field(f, "parameters", ps), k = count : { pair_pos(ps, _, _, _) }.
argument_mismatch_prior(p, q) :- argument_mismatch_def(f), field(f, "parameters", ps), pair_pos(ps, p, i, _), pair_pos(ps, q, j, _), j < i.
argument_mismatch_has_prior(p) :- argument_mismatch_prior(p, _).
argument_mismatch_param(f, 0, t) :- argument_mismatch_def(f), field(f, "parameters", ps), pair_pos(ps, p, _, t), !argument_mismatch_has_prior(p).
argument_mismatch_param(f, k, t) :- argument_mismatch_def(f), field(f, "parameters", ps), pair_pos(ps, p, _, t), argument_mismatch_has_prior(p), k = count : { argument_mismatch_prior(p, _) }.
argument_mismatch_matched(f, k, t) :- argument_mismatch_param(f, k, t), missing_async_counterpart(f, c), argument_mismatch_param(c, k, t).
argument_mismatch_unmatched(f) :- pair_selected(_, f, _, _, 0), argument_mismatch_param(f, k, t), !argument_mismatch_matched(f, k, t).
argument_mismatch_found(f) :- missing_async_counterpart(f, c), argument_mismatch_count(f, n), argument_mismatch_count(c, m), n != m.
argument_mismatch_found(f) :- missing_async_paired(f), argument_mismatch_unmatched(f).
violation("data-layer-missing-async-pairs", "argument-mismatch", "signature_mismatch", p, l) :- pair_selected(d, f, _, x, 0), missing_async_public(x), argument_mismatch_found(f), doc(d, p, _), line(f, l).
