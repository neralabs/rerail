.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.input doc, node, field, text
.decl in_scope(d: int)
.decl m10(n: node)
.decl m17(n: node)
.decl out_scope(d: int)
.decl t6(s: sym)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "api/**/*.py").
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
t6($s) :- text(_, $s), @icontains($s, "field_info").
t6($s) :- text(_, $s), @isuffix($s, "_info").
m10($n) :- node(_, $n, "identifier", _, _), text($n, $v4), $v4 = "f".
m10($n) :- node(_, $n, "identifier", _, _), text($n, $v5), t6($v5).
m10($n) :- node(_, $n, "subscript", _, _), field($n, "value", $v7), node(_, $v7, "attribute", _, _), field($v7, "attribute", $v8), node(_, $v8, "identifier", _, _), text($v8, $v9), $v9 = "model_fields".
m17($n) :- node(_, $n, "identifier", _, _), text($n, $v14), $v14 in {"TypeAdapter", "get_args", "get_origin", "get_type_hints", "isinstance", "issubclass"}.
m17($n) :- node(_, $n, "attribute", _, _), field($n, "attribute", $v15), node(_, $v15, "identifier", _, _), text($v15, $v16), $v16 in {"TypeAdapter", "get_args", "get_origin", "get_type_hints", "isinstance", "issubclass"}.
.output violation
