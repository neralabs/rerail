.scope text "**/*.[mM][dD]", "**/*.[mM][aA][rR][kK][dD][oO][wW][nN]", "**/*.[rR][sS][tT]", "**/*.[tT][xX][tT]", "**/*.[tT][oO][mM][lL]", "**/*.[cC][fF][gG]", "**/*.[iI][nN][iI]", "**/*.[yY][aA][mM][lL]", "**/*.[yY][mM][lL]"
.decl swe_block(kind: symbol)
swe_block("block").
.decl swe_except(kind: symbol)
swe_except("except_clause").
.decl swe_scope(kind: symbol)
swe_scope("class_definition"). swe_scope("function_definition"). swe_scope("lambda").
.decl swe_stop(kind: symbol)
swe_stop("class_definition"). swe_stop("function_definition"). swe_stop("lambda"). swe_stop("except_clause").
.decl swe_stop_target(kind: symbol)
swe_stop_target("class_definition"). swe_stop_target("function_definition"). swe_stop_target("lambda"). swe_stop_target("except_clause"). swe_stop_target("as_pattern_target").
.decl child(p: node, c: node, i: number)
.decl doc(d: number, path: symbol, module: symbol)
.decl field(p: node, f: symbol, c: node)
.decl in_scope(d: number)
.decl line(n: node, l: number)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl node_text(n: node, s: symbol)
.decl out_scope(d: number)
.decl swe_alias(e: node, s: symbol)
.decl swe_async_with(w: node)
.decl swe_attr(n: node, object: symbol, attribute: symbol)
.decl swe_attr_name(x: node)
.decl swe_before(w: node, i: node)
.decl swe_catches_protocol(e: node)
.decl swe_clause(d: number, p: symbol, e: node)
.decl swe_contextlib_suppress(c: node)
.decl swe_ctx_import(d: number, i: node, s: number, e: number)
.decl swe_deep(e: node)
.decl swe_doc(d: number, p: symbol)
.decl swe_handled(e: node)
.decl swe_imported_suppress(w: node)
.decl swe_imports_suppress(i: node)
.decl swe_in_block(e: node, x: node)
.decl swe_kw_name(x: node)
.decl swe_one_keyerror(c: node)
.decl swe_one_protocol(c: node)
.decl swe_protocol(n: node)
.decl swe_ref(x: node, s: symbol)
.decl swe_reraises(e: node)
.decl swe_second(p: node)
.decl swe_shadowed(w: node, i: node)
.decl swe_suppress_name(c: node)
.decl swe_uses(e: node)
.decl swe_with_call(w: node, c: node)
.decl syntax_error(d: number)
.decl tape_syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, syntax_error, node, field, child, text, line, node_text
.output violation
in_scope(d) :- doc(d, p, _), glob("api/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("services/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("data_layer_testing/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test_*.py", p).
tape_syntax_error(d) :- syntax_error(d).
swe_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d).
swe_second(p) :- child(p, _, i), child(p, _, j), i < j.
swe_attr(n, o, a) :- node(_, n, "attribute", _, _), field(n, "object", x), node(_, x, "identifier", _, _), text(x, o), field(n, "attribute", y), node(_, y, "identifier", _, _), text(y, a).
swe_protocol(n) :- node(_, n, "identifier", _, _), text(n, s), (s = "KeyError" ; s = "StopAsyncIteration" ; s = "StopIteration").
swe_protocol(n) :- swe_attr(n, "queue", "Empty").
swe_protocol(n) :- node(_, n, "parenthesized_expression", _, _), child(n, c, _), swe_protocol(c).
swe_protocol(n) :- node(_, n, "tuple", _, _), child(n, c, _), swe_protocol(c), !swe_second(n).
swe_clause(d, p, e) :- swe_doc(d, p), node(d, e, "except_clause", _, _), !swe_catches_protocol(e).
swe_catches_protocol(e) :- node(_, e, "except_clause", _, _), field(e, "value", v), swe_protocol(v).
swe_catches_protocol(e) :- node(_, e, "except_clause", _, _), field(e, "value", v), node(_, v, "as_pattern", _, _), child(v, c, _), swe_protocol(c).
swe_deep(e) :- node(_, e, "except_clause", _, _), inside(e, x, swe_scope), inside(x, _, swe_except).
swe_in_block(e, x) :- nearest(x, e, swe_stop), node(_, e, "except_clause", _, _), child(e, b, _), node(_, b, "block", _, _), inside(x, b, swe_block).
swe_reraises(e) :- node(_, x, "raise_statement", _, _), swe_in_block(e, x), !swe_deep(e).
swe_alias(e, s) :- node(_, e, "except_clause", _, _), field(e, "alias", a), node(_, a, "identifier", _, _), text(a, s).
swe_alias(e, s) :- node(_, e, "except_clause", _, _), field(e, "value", v), node(_, v, "as_pattern", _, _), field(v, "alias", t), child(t, a, _), node(_, a, "identifier", _, _), text(a, s).
swe_ref(x, s) :- node(_, x, "identifier", _, _), text(x, s), !swe_attr_name(x), !swe_kw_name(x).
swe_attr_name(x) :- field(a, "attribute", x), node(_, a, "attribute", _, _).
swe_kw_name(x) :- field(k, "name", x), node(_, k, "keyword_argument", _, _).
swe_uses(e) :- swe_alias(e, s), swe_ref(x, s), swe_in_block(e, x).
swe_uses(e) :- swe_alias(e, s), field(e, "value", v), swe_ref(v, s).
swe_uses(e) :- swe_alias(e, s), field(e, "value", v), node(_, v, _, vs, ve), swe_ref(x, s), nearest(x, e, swe_stop_target), node(_, x, _, xs, xe), xs >= vs, xe <= ve.
swe_handled(e) :- swe_uses(e), !swe_deep(e).
violation("data-layer-swallowed-exceptions", "except-warning", "WARNING", p, l) :- swe_clause(_, p, e), !swe_reraises(e), !swe_deep(e), swe_uses(e), line(e, l).
violation("data-layer-swallowed-exceptions", "except-critical", "CRITICAL", p, l) :- swe_clause(_, p, e), !swe_reraises(e), !swe_handled(e), line(e, l).
swe_with_call(w, c) :- node(_, w, "with_statement", _, _), child(w, wc, _), node(_, wc, "with_clause", _, _), child(wc, it, _), node(_, it, "with_item", _, _), field(it, "value", c), node(_, c, "call", _, _).
swe_with_call(w, c) :- node(_, w, "with_statement", _, _), child(w, wc, _), node(_, wc, "with_clause", _, _), child(wc, it, _), node(_, it, "with_item", _, _), field(it, "value", v), node(_, v, "as_pattern", _, _), child(v, c, _), node(_, c, "call", _, _).
swe_one_protocol(c) :- field(c, "arguments", al), child(al, a, _), swe_protocol(a), !swe_second(al).
swe_one_keyerror(c) :- field(c, "arguments", al), child(al, a, _), node(_, a, "identifier", _, _), text(a, "KeyError"), !swe_second(al).
swe_suppress_name(c) :- field(c, "function", f), node(_, f, "identifier", _, _), text(f, "suppress").
swe_contextlib_suppress(c) :- field(c, "function", f), swe_attr(f, "contextlib", "suppress").
swe_async_with(w) :- node(_, w, "with_statement", _, _), node_text(w, s), match("(?s)async\\b.*", s).
violation("data-layer-swallowed-exceptions", "suppress-legacy", "CRITICAL", p, l) :- swe_doc(d, p), node(d, w, "with_statement", _, _), !swe_async_with(w), swe_with_call(w, c), swe_suppress_name(c), !swe_one_protocol(c), line(w, l).
violation("data-layer-swallowed-exceptions", "suppress-legacy", "CRITICAL", p, l) :- swe_doc(d, p), node(d, w, "with_statement", _, _), !swe_async_with(w), swe_with_call(w, c), swe_contextlib_suppress(c), !swe_one_protocol(c), line(w, l).
swe_ctx_import(d, i, s, e) :- node(d, i, "import_from_statement", s, e), field(i, "module_name", m), node(_, m, "dotted_name", _, _), node_text(m, "contextlib").
swe_imports_suppress(i) :- swe_ctx_import(_, i, _, _), child(i, x, _), node(_, x, "dotted_name", _, _), node_text(x, "suppress").
swe_imports_suppress(i) :- swe_ctx_import(_, i, _, _), child(i, x, _), node(_, x, "aliased_import", _, _), field(x, "name", y), node(_, y, "dotted_name", _, _), node_text(y, "suppress").
swe_before(w, i) :- node(d, w, "with_statement", ws, _), swe_ctx_import(d, i, _, ie), ws >= ie.
swe_shadowed(w, i) :- swe_before(w, i), swe_ctx_import(d, i, _, ie), swe_ctx_import(d, j, js, je), js >= ie, node(d, w, _, ws, _), ws >= je, j != i.
swe_imported_suppress(w) :- swe_before(w, i), swe_imports_suppress(i), !swe_shadowed(w, i).
violation("data-layer-swallowed-exceptions", "suppress-critical", "CRITICAL", p, l) :- swe_doc(d, p), node(d, w, "with_statement", _, _), swe_with_call(w, c), swe_contextlib_suppress(c), !swe_one_keyerror(c), line(w, l).
violation("data-layer-swallowed-exceptions", "suppress-critical", "CRITICAL", p, l) :- swe_doc(d, p), node(d, w, "with_statement", _, _), swe_with_call(w, c), swe_suppress_name(c), swe_imported_suppress(w), !swe_one_keyerror(c), line(w, l).
