.decl doc(d: int, path: sym, module: sym)
.decl node(d: int, n: node, kind: sym, start: int, end: int)
.decl child(p: node, c: node, i: int)
.decl field(p: node, f: sym, c: node)
.decl text(n: node, s: sym)
.decl name(n: node, s: sym)
.decl line(n: node, l: int)
.decl syntax_error(d: int)
.input doc, node, child, field, text, name, line, syntax_error
.decl in_scope(d: int)
.decl m12(n: node)
.decl out_scope(d: int)
.decl violation(rule: sym, clause: sym, code: sym, path: sym, line: int)
in_scope($d) :- doc($d, $p, _), @glob($p, "impl/**/*.py").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.git/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/.venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/venv/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/__pycache__/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tmp/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/test/**").
out_scope($d) :- doc($d, $p, _), @glob($p, "**/tests/**").
m12($n) :- child($v3, $n, _), node(_, $v3, "block", _, _), field($v4, "body", $v3), node(_, $v4, "class_definition", _, _), field($v4, "name", $v5), name($v5, $v6), @suffix($v6, {"LazyVersionedWriteTransactionSparse", "VersionedWriteTransaction"}).
m12($n) :- child($v7, $n, _), node(_, $v7, "decorated_definition", _, _), child($v8, $v7, _), node(_, $v8, "block", _, _), field($v9, "body", $v8), node(_, $v9, "class_definition", _, _), field($v9, "name", $v10), name($v10, $v11), @suffix($v11, {"LazyVersionedWriteTransactionSparse", "VersionedWriteTransaction"}).
violation("data-layer-versioned-lifecycle-legacy-surfaces", "methods", "VLL001", $p, $l) :- node(_, $n, "function_definition", _, _), field($n, "name", $v1), node(_, $v1, "identifier", _, _), text($v1, $v2), $v2 in {"commit", "commit_async", "commit_branch", "commit_branch_async", "rollback", "rollback_async"}, m12($n), node($d, $n, _, _, _), in_scope($d), !syntax_error($d), !out_scope($d), doc($d, $p, _), line($n, $l).
.output violation
