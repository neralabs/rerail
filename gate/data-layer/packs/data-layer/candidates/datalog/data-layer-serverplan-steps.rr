sc1_m172(n) :- inside(n, v168, sc1_k3), node(_, v168, "raise_statement", _, _), inside(v168, v169, sc1_k0), node(_, v169, "function_definition", _, _), field(v169, "name", v170), node(_, v170, "identifier", _, _), text(v170, v171), v171 = "compile".
sc1_selected(n) :- sc1_m172(n).
sc1_none(v) :- node(_, v, "none", _, _).
sc1_sel_child(p) :- sc1_selected(x), child(p, x, _).
sc1_cmt_fn(f) :- node(_, f, "function_definition", _, _), field(f, "name", x), node(_, x, "identifier", _, _), text(x, s), (s = "cte_column_type_hints" ; s = "cte_output_columns" ; s = "emits_sql_for_accounting" ; s = "execution_role" ; s = "is_executor_owned_runtime_step" ; s = "level" ; s = "step_tags" ; s = "supports_sql_batch_transport" ; s = "tables_read" ; s = "tables_written").
sc1_compile_fn(f) :- node(_, f, "function_definition", _, _), field(f, "name", x), node(_, x, "identifier", _, _), text(x, "compile").
sc1_comment_at(p, s, e) :- node(_, p, k, _, _), sc1_seq_kind(k), token(p, _, t, s, e), prefix("#", t).
sc1_sel_comment(p) :- sc1_comment_at(p, _, _), child(r, p, _), node(_, r, "return_statement", _, _), inside(r, f, sc1_k0), sc1_cmt_fn(f).
sc1_sel_comment(p) :- sc1_comment_at(p, _, _), child(a, p, _), node(_, a, "argument_list", _, _), child(c, a, _), node(_, c, "call", _, _), field(c, "function", x), sc1_m52(x), inside(p, f, sc1_k0), sc1_cmt_fn(f).
sc1_sel_comment(p) :- sc1_comment_at(p, s, e), inside(p, f, sc1_k0), sc1_cmt_fn(f), field(f, "return_type", t), node(_, t, _, ts, te), ts <= s, e <= te.
sc1_sel_comment(p) :- sc1_comment_at(p, _, _), inside(p, f, sc1_k0), field(f, "name", x), node(_, x, "identifier", _, _), text(x, "cte_column_type_hints"), sc1_m68(f).
sc1_sel_comment(p) :- sc1_comment_at(p, s, e), inside(p, i, sc1_k1), field(i, "condition", c), node(_, c, _, cs, ce), cs <= s, e <= ce, sc1_m114(i), inside(i, f, sc1_k0), sc1_compile_fn(f).
sc1_sel_comment(p) :- sc1_comment_at(p, _, _), field(w, "value", p), node(_, w, "keyword_argument", _, _), child(a, w, _), node(_, a, "argument_list", _, _), child(c, a, _), node(_, c, "call", _, _), field(c, "function", x), sc1_m153(x).
sc1_sel_comment(p) :- sc1_comment_at(p, _, _), inside(p, c, sc1_k2), node(_, c, "call", _, _), field(c, "function", x), sc1_m164(x).
sc1_sel_comment(p) :- sc1_comment_at(p, _, _), inside(p, r, sc1_k3), node(_, r, "raise_statement", _, _), inside(r, f, sc1_k0), sc1_compile_fn(f).
sc1_empty_seq(x) :- sc1_selected(x), node(_, x, k, _, _), sc1_seq_kind(k), !sc1_sel_child(x), !sc1_sel_comment(x).
sc1_string(v, s) :- node(_, v, "string", _, _), sps_text(v, s).
sc1_string(v, s) :- node(_, v, "concatenated_string", _, _), sps_text(v, s).
sc1_is_attribute(v) :- node(_, v, "attribute", _, _).
sc1_function(f, s) :- sc1_selected(f), node(_, f, "function_definition", _, _), field(f, "name", x), text(x, s).
sc1_owner(n, f) :- sc1_selected(n), nearest(n, f, sc1_kfn).
sc1_step_base(b) :- sps_text(b, s), match("(?:[A-Za-z_]\\w*\\.)*ServerPlanStep(?:\\[.*\\])?", s).
sc1_step_class(c) :- sc1_selected(c), node(_, c, "class_definition", _, _), child(c, a, _), node(_, a, "argument_list", _, _), sc1_selected(a), child(a, b, _), sc1_selected(b), sc1_step_base(b).
sc1_step_method(f, c, s) :- sc1_function(f, s), child(b, f, _), field(c, "body", b), sc1_step_class(c).
sc1_step_method(f, c, s) :- sc1_function(f, s), child(w, f, _), node(_, w, "decorated_definition", _, _), sc1_selected(w), child(b, w, _), field(c, "body", b), sc1_step_class(c).
sc1_method_start(c, nm, s) :- sc1_step_method(f, c, nm), node(_, f, _, s, _).
sc1_first_start(c, nm, s) :- sc1_method_start(c, nm, _), s = min t : { sc1_method_start(c, nm, t) }.
sc1_first(f, c, nm) :- sc1_step_method(f, c, nm), node(_, f, _, s, _), sc1_first_start(c, nm, s).
sc1_has_first(c, nm) :- sc1_first(_, c, nm).
sc1_method_desc(m, x) :- sc1_selected(x), inside(x, m, sc1_kfn), sc1_step_method(m, _, _).
sc1_return(r, v) :- sc1_selected(r), node(_, r, "return_statement", _, _), child(r, v, _), sc1_selected(v).
sc1_method_return(m, c, nm, r, v) :- sc1_return(r, v), sc1_owner(r, m), sc1_first(m, c, nm).
sc1_call(c) :- sc1_selected(c), node(_, c, "call", _, _), field(c, "function", f), sc1_selected(f).
sc1_full_callee(c, s) :- sc1_call(c), field(c, "function", f), sps_text(f, s).
sc1_callee(c, s) :- sc1_call(c), field(c, "function", f), !sc1_is_attribute(f), sps_text(f, s).
sc1_callee(c, s) :- sc1_call(c), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), text(a, s).
sc1_arg(c, a) :- sc1_call(c), field(c, "arguments", l), child(l, a, _), sc1_selected(a), node(_, a, k, _, _), !sc1_nonarg_kind(k).
sc1_arg_pos(c, a, 0) :- sc1_arg(c, a), !sc1_arg_later(a).
sc1_arg_pos(c, a, i) :- sc1_arg(c, a), sc1_arg_later(a), i = count : { sc1_arg_before(a, _) }.
sc1_arg_before(a, b) :- sc1_arg(c, a), sc1_arg(c, b), node(_, a, _, s, _), node(_, b, _, t, _), t < s.
sc1_arg_later(a) :- sc1_arg_before(a, _).
sc1_has_arg(c) :- sc1_arg(c, _).
sc1_kw(c, s, v) :- sc1_call(c), field(c, "arguments", l), child(l, k, _), sc1_selected(k), node(_, k, "keyword_argument", _, _), field(k, "name", kn), sc1_selected(kn), text(kn, s), field(k, "value", v), sc1_selected(v).
sc1_has_kw(c) :- sc1_kw(c, _, _).
sc1_attr(a, o, s) :- sc1_selected(a), node(_, a, "attribute", _, _), field(a, "object", x), sps_text(x, o), field(a, "attribute", y), sps_text(y, s).
sc1_assign(a, l) :- sc1_selected(a), node(_, a, "assignment", _, _), field(a, "left", l), sc1_selected(l).
sc1_assign_value(a, r) :- sc1_assign(a, _), field(a, "right", r), sc1_selected(r).
sc1_binding(f, nm, a, s) :- sc1_assign(a, l), node(_, l, "identifier", _, _), text(l, nm), sc1_assign_value(a, _), inside(a, f, sc1_kfn), node(_, a, _, s, _).
sc1_binding_last(f, nm, s) :- sc1_binding(f, nm, _, _), s = max t : { sc1_binding(f, nm, _, t) }.
sc1_local_binding(f, nm, v) :- sc1_binding_last(f, nm, s), sc1_binding(f, nm, a, s), sc1_assign_value(a, v).
sc1_empty_tables(m, c, nm) :- sc1_method_return(m, c, nm, _, v), sc1_full_callee(v, "frozenset"), !sc1_has_kw(v), !sc1_has_arg(v).
sc1_empty_tables(m, c, nm) :- sc1_method_return(m, c, nm, _, v), sc1_full_callee(v, "frozenset"), !sc1_has_kw(v), sc1_arg(v, a), sc1_empty_seq(a), k = count : { sc1_arg(v, _) }, k = 1.
sc1_empty_method(m) :- sc1_empty_tables(m, _, _).
sc1_role(c, "VIRTUAL") :- sc1_method_return(_, c, "execution_role", _, v), node(_, v, "attribute", _, _), sps_text(v, "StepExecutionRole.VIRTUAL").
sc1_role(c, "VIRTUAL") :- sc1_method_return(_, c, "execution_role", _, v), !sc1_is_attribute(v), sps_text(v, s), match("['\"]*[vV][iI][rR][tT][uU][aA][lL]['\"]*", s).
sc1_role(c, "SQL") :- sc1_method_return(_, c, "execution_role", _, v), node(_, v, "attribute", _, _), sps_text(v, "StepExecutionRole.SQL").
sc1_role(c, "SQL") :- sc1_method_return(_, c, "execution_role", _, v), !sc1_is_attribute(v), sps_text(v, s), match("['\"]*[sS][qQ][lL]['\"]*", s).
sc1_level_int(c, x, s) :- sc1_step_method(m, c, "level"), sc1_method_desc(m, x), node(_, x, "integer", s, _), sc1_return(_, x).
sc1_level_first(c, s) :- sc1_level_int(c, _, _), s = min t : { sc1_level_int(c, _, t) }.
sc1_level0(c) :- sc1_level_first(c, s), sc1_level_int(c, x, s), sps_text(x, t), match("0+(?:[^0-9](?s:.*))?", t).
sc1_empty_value(v) :- sc1_kw(_, _, v), sc1_none(v).
sc1_empty_value(v) :- sc1_kw(_, _, v), sc1_string(v, s), match("['\"]*", s).
sc1_empty_value(v) :- sc1_kw(_, _, v), sc1_empty_seq(v).
sc1_nonempty_kw(c, nm, v) :- sc1_kw(c, nm, v), !sc1_empty_value(v).
sc1_compiled(c) :- sc1_full_callee(c, "CompiledStep").
sc1_grammar(c) :- sc1_compiled(c), sc1_kw(c, "grammar", v), !sc1_none(v).
sc1_grammarless(c) :- sc1_compiled(c), !sc1_grammar(c).
sc1_refs(c) :- sc1_compiled(c), sc1_nonempty_kw(c, "runtime_ref_ids", _).
sc1_refs(c) :- sc1_compiled(c), sc1_nonempty_kw(c, "source_refs", _).
sc1_sql_surface(c) :- sc1_refs(c).
sc1_sql_surface(c) :- sc1_compiled(c), sc1_nonempty_kw(c, "auxiliary_ctes", _).
sc1_sql_surface(c) :- sc1_grammar(c).
sc1_compile_surface(c) :- sc1_first(m, c, "compile"), sc1_method_desc(m, x), sc1_sql_surface(x).
sc1_zero_io_step(s) :- sc1_compiled(s), !sc1_has_arg(s), !sc1_has_kw(s).
sc1_zero_io_step(s) :- sc1_compiled(s), sc1_kw(s, k, v), sc1_io_kw(k), !sc1_none(v).
sc1_zero_io(c) :- sc1_step_class(c), sc1_level0(c), sc1_empty_tables(_, c, "tables_read"), sc1_empty_tables(_, c, "tables_written"), sc1_first(m, c, "compile"), sc1_method_desc(m, s), sc1_zero_io_step(s).
sc1_resolved(c, s) :- sc1_step_method(m, c, nm), nm != "__init__", sc1_method_desc(m, b), sc1_assign(b, t), sc1_attr(t, "self", s), prefix("_", s).
sc1_alias(m, nm, s) :- sc1_step_method(m, _, "compile"), sc1_assign(a, l), sc1_owner(a, m), node(_, l, "identifier", _, _), text(l, nm), sc1_assign_value(a, v), sc1_attr(v, "self", s), prefix("_", s).
sc1_derived(c) :- sc1_full_callee(c, s), match("(?s:.*)[cC][tT][eE](?s:.)[oO][uU][tT][pP][uU][tT](?s:.)[cC][oO][lL][uU][mM][nN][sS]", s).
sc1_derived(p) :- sc1_derived(c), child(p, c, _).
sc1_derived(n) :- sc1_derived(v), sc1_local_binding(f, nm, v), node(_, n, "identifier", _, _), text(n, nm), sc1_selected(n), sc1_owner(n, f).
sc1_postop_builder(c, b) :- sc1_kw(c, "closed_post_op", v), node(d, v, _, vs, ve), sc1_callee(b, s), sc1_builder_callee(s), node(d, b, _, bs, be), vs <= bs, be <= ve.
sc1_has_postop(c) :- sc1_postop_builder(c, b), sc1_callee(b, "runtime_builder_post_op"), sc1_arg_pos(b, a, 0), sc1_attr(a, "RuntimeBuilderKind", _).
sc1_has_postop(c) :- sc1_postop_builder(c, b), sc1_callee(b, "runtime_builder_post_op"), sc1_arg_pos(b, a, 1), sc1_attr(a, "RuntimeBuilderName", _).
sc1_has_postop(c) :- sc1_postop_builder(c, b), sc1_kw(b, "kind", a), sc1_attr(a, "RuntimeBuilderKind", _).
sc1_has_postop(c) :- sc1_postop_builder(c, b), sc1_kw(b, "builder_name", a), sc1_attr(a, "RuntimeBuilderName", _).
sc1_bad_table_string(s) :- sc1_string(s, t), !match("['\"]*\\*['\"]*", t).
sc1_bad_table_arg(a) :- sc1_arg_pos(_, a, 0), node(_, a, k, _, _), !sc1_seq_kind(k).
sc1_bad_table_arg(a) :- sc1_arg_pos(_, a, 0), child(a, s, _), sc1_selected(s), sc1_bad_table_string(s).
sc1_table_problem(m, r) :- sc1_method_return(m, _, nm, r, v), sc1_table_method(nm), sc1_full_callee(v, "frozenset"), sc1_arg_pos(v, a, 0), sc1_bad_table_arg(a).
sc1_has_table_problem(m) :- sc1_table_problem(m, _).
sc1_tp_start(c, nm, s) :- sc1_table_problem(m, r), sc1_first(m, c, nm), node(_, r, _, s, _).
sc1_tp_first(c, nm, s) :- sc1_tp_start(c, nm, _), s = min t : { sc1_tp_start(c, nm, t) }.
sc1_table_problems(c, nm, r) :- sc1_table_problem(m, r), sc1_first(m, c, nm), node(_, r, _, s, _), sc1_tp_first(c, nm, s).
sc1_table_problems(c, nm, m) :- sc1_first(m, c, nm), sc1_table_method(nm), !sc1_empty_method(m), !sc1_has_table_problem(m).
sc1_has_read_problem(c) :- sc1_table_problems(c, "tables_read", _).
sc1_raises_type_error(r) :- child(r, e, _), sc1_selected(e), sps_text(e, t), sc1_type_error(t).
sc1_raises_type_error(r) :- child(r, e, _), sc1_full_callee(e, t), sc1_type_error(t).
sc1_row("STEP-018", n) :- sps_on("check_compile_must_not_raise"), sc1_selected(n), node(_, n, "raise_statement", _, _), child(b, n, _), field(m, "body", b), sc1_step_method(m, c, "compile"), sc1_level0(c), sc1_raises_type_error(n).
sc1_row("STEP-023", n) :- sps_on("check_zero_io_l0_execution_role_guardrail"), sc1_zero_io(n), !sc1_has_first(n, "execution_role").
sc1_row("STEP-024", n) :- sps_on("check_zero_io_l0_execution_role_enum_semantics"), sc1_first(n, c, "execution_role"), sc1_zero_io(c), field(n, "return_type", t), sc1_selected(t), sps_text(t, s), (s = "str" ; s = "\"str\"" ; s = "'str'").
sc1_row("STEP-025", n) :- sps_on("check_zero_io_l0_execution_role_enum_semantics"), sc1_first(n, c, "execution_role"), sc1_zero_io(c), sc1_method_return(n, _, _, _, v), sc1_string(v, s), match("['\"]*(?:sql|virtual|apply|control)['\"]*", s).
sc1_returns_empty_tuple(m) :- sc1_first(m, _, "cte_output_columns"), sc1_method_desc(m, r), sc1_return(r, v), node(_, v, "tuple", _, _), !sc1_sel_child(v), !sc1_sel_comment(v).
sc1_row("STEP-034", n) :- sps_on("check_sql_visible_steps_declare_cte_type_hints"), sc1_first(n, c, "cte_output_columns"), !sc1_has_first(c, "cte_column_type_hints"), !sc1_returns_empty_tuple(n).
sc1_row("STEP-036", n) :- sps_on("check_virtual_execute_runtime_python_shaping_guardrail"), sc1_first(n, c, "execute_runtime"), sc1_role(c, "VIRTUAL"), sc1_first(m, c, "compile"), sc1_method_desc(m, s), sc1_grammarless(s).
sc1_value_text(x) :- sps_text(x, s), match("['\"]*value['\"]*", s).
sc1_scalar_value(p) :- sc1_arg_pos(p, a, 0), sc1_value_text(a).
sc1_scalar_value(p) :- sc1_kw(p, "column_name", v), sc1_value_text(v).
sc1_row("STEP-033", n) :- sps_on("check_virtual_execute_runtime_scalar_value_guardrail"), sc1_first(n, c, "compile"), sc1_role(c, "VIRTUAL"), sc1_has_first(c, "execute_runtime"), sc1_method_desc(n, s), sc1_grammarless(s), !sc1_refs(s), sc1_kw(s, "closed_post_op", p), sc1_full_callee(p, "scalar_column_post_op"), sc1_scalar_value(p).
sc1_row("STEP-046", n) :- sps_on("check_step_role_contract_guardrails"), sc1_first(n, c, "compile"), sc1_role(c, "VIRTUAL"), sc1_compile_surface(c).
sc1_row("STEP-046", n) :- sps_on("check_step_role_contract_guardrails"), sc1_step_class(n), sc1_role(n, "VIRTUAL"), sc1_has_first(n, "cte_publication_contract").
sc1_row("STEP-046", n) :- sps_on("check_step_role_contract_guardrails"), sc1_step_class(n), sc1_role(n, "VIRTUAL"), sc1_has_first(n, "publication_contract").
sc1_row("STEP-047", n) :- sps_on("check_step_role_contract_guardrails"), sc1_step_class(n), sc1_role(n, "VIRTUAL"), sc1_has_first(n, "execute_runtime").
sc1_row("STEP-047", n) :- sps_on("check_step_role_contract_guardrails"), sc1_step_class(n), sc1_role(n, "VIRTUAL"), sc1_has_first(n, "execute_runtime_async").
sc1_row("STEP-047", n) :- sps_on("check_step_role_contract_guardrails"), sc1_step_class(n), sc1_role(n, "VIRTUAL"), sc1_method_return(_, n, "is_executor_owned_runtime_step", _, v), node(_, v, "true", _, _).
sc1_row("STEP-048", n) :- sps_on("check_step_role_contract_guardrails"), sc1_first(n, c, "step_tags"), sc1_role(c, "VIRTUAL"), sc1_method_desc(n, s), sc1_string(s, t), match("['\"]*(?:__exists|delete|grammar|insert|query|read|update|validation)['\"]*", t).
sc1_row("STEP-049", n) :- sps_on("check_step_role_contract_guardrails"), sc1_first(n, c, "supports_sql_batch_transport"), !sc1_role(c, "SQL"), sc1_method_return(n, _, _, _, v), node(_, v, "true", _, _), !sc1_has_first(c, "cte_publication_contract"), !sc1_compile_surface(c).
sc1_row("STEP-050", n) :- sps_on("check_step_role_contract_guardrails"), sc1_first(n, c, "emits_sql_for_accounting"), sc1_method_return(n, _, _, _, v), node(_, v, "false", _, _), sc1_compile_surface(c).
sc1_cond(n, m, c, q) :- sc1_selected(n), node(_, n, k, _, _), sc1_branch_kind(k), sc1_owner(n, m), sc1_step_method(m, c, "compile"), field(n, "condition", q), sc1_selected(q).
sc1_cond_desc(q, q) :- sc1_cond(_, _, _, q).
sc1_cond_desc(q, x) :- sc1_cond_desc(q, y), child(y, x, _).
sc1_row("STEP-016", n) :- sps_on("check_compile_no_data_branching"), sc1_cond(n, _, c, q), sc1_cond_desc(q, x), sc1_attr(x, "self", a), sc1_resolved(c, a).
sc1_row("STEP-016", n) :- sps_on("check_compile_no_data_branching"), sc1_cond(n, m, c, q), sc1_cond_desc(q, x), sc1_selected(x), node(_, x, "identifier", _, _), sps_text(x, t), sc1_alias(m, t, a), sc1_resolved(c, a).
sc1_type_hints_call(n) :- sc1_callee(n, "SqlColumnTypeHints"), sc1_step_method(m, _, "cte_column_type_hints"), sc1_method_desc(m, n).
sc1_row("STEP-040", n) :- sps_on("check_cte_type_hints_not_inferred_from_column_names"), sc1_type_hints_call(n), sc1_arg(n, a), sc1_derived(a).
sc1_row("STEP-040", n) :- sps_on("check_cte_type_hints_not_inferred_from_column_names"), sc1_type_hints_call(n), sc1_kw(n, _, v), sc1_derived(v).
sc1_row("STEP-040", n) :- sps_on("check_cte_type_hints_not_inferred_from_column_names"), sc1_type_hints_call(n), sc1_selected(x), node(_, x, k, _, _), sc1_computed_kind(k), inside(x, n, sc1_kcall).
sc1_row("STEP-033", n) :- sps_on("check_runtime_refs_without_sql_grammar_guardrail"), sc1_grammarless(c), sc1_nonempty_kw(c, "runtime_ref_ids", n), !sc1_has_postop(c).
sc1_row("STEP-045", n) :- sps_on("check_step_role_contract_guardrails"), sc1_table_problems(c, "tables_read", n), sc1_role(c, "VIRTUAL").
sc1_row("STEP-045", n) :- sps_on("check_step_role_contract_guardrails"), sc1_table_problems(c, _, n), sc1_role(c, "VIRTUAL"), !sc1_has_read_problem(c).
violation("data-layer-serverplan-steps", "step-contracts-1", code, p, l) :- sc1_row(code, n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l).
sc3_m_stmt(n) :- child(p, n, _), node(_, p, "module", _, _).
sc3_m_stmt(n) :- child(b, n, _), node(_, b, "block", _, _), child(c, b, _), node(_, c, "class_definition", _, _).
sc3_m_region(n) :- node(_, n, "module", _, _).
sc3_m_region(n) :- node(_, n, "expression_statement", _, _), sc3_m_stmt(n).
sc3_m_region(n) :- node(_, n, "class_definition", _, _).
sc3_m_region(n) :- node(_, n, "function_definition", _, _).
sc3_m_region(n) :- node(_, n, "decorated_definition", _, _).
sc3_m_region(n) :- node(_, n, "argument_list", _, _), child(c, n, _), node(_, c, "class_definition", _, _).
sc3_m_region(n) :- child(a, n, _), node(_, a, "argument_list", _, _), child(c, a, _), node(_, c, "class_definition", _, _).
sc3_rawresult_param(x) :- node(_, x, k, _, _), sc3_k_typed(k), sps_text(x, s), contains("RawResult", s).
sc3_raw_fn(f) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, x, _), node(_, x, "identifier", _, _), text(x, s), (s = "raw" ; s = "raw_rows" ; s = "rows").
sc3_raw_fn(f) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, x, _), sc3_rawresult_param(x).
sc3_raw_fn(f) :- node(_, f, "function_definition", _, _), field(f, "name", x), node(_, x, "identifier", _, _), text(x, "materialize").
sc3_kw_call(c) :- node(_, c, "call", _, _), field(c, "arguments", a), child(a, k, _), node(_, k, "keyword_argument", _, _), field(k, "name", x), node(_, x, "identifier", _, _), text(x, s), (s = "literal_payload" ; s = "row_materializer" ; s = "terminal_literal").
sc3_sel(n) :- sc3_m_region(n).
sc3_sel(n) :- inside(n, f, sc3_k_fn), sc3_raw_fn(f).
sc3_sel(n) :- sc3_kw_call(n).
sc3_sel(n) :- inside(n, c, sc3_k_call), sc3_kw_call(c).
sc3_fn_name(f, s) :- node(_, f, "function_definition", _, _), field(f, "name", x), text(x, s).
sc3_class(c, s) :- node(_, c, "class_definition", _, _), field(c, "name", x), text(x, s).
sc3_method(f, c, s) :- sc3_fn_name(f, s), child(b, f, _), field(c, "body", b), node(_, c, "class_definition", _, _).
sc3_method(f, c, s) :- sc3_fn_name(f, s), child(dd, f, _), node(_, dd, "decorated_definition", _, _), child(b, dd, _), field(c, "body", b), node(_, c, "class_definition", _, _).
sc3_call(c, f) :- sc3_sel(c), node(_, c, "call", _, _), field(c, "function", f), sc3_sel(f).
sc3_call_full(c, s) :- sc3_call(c, f), sps_text(f, s).
sc3_call_callee(c, s) :- sc3_call(c, f), node(_, f, "attribute", _, _), field(f, "attribute", x), text(x, s).
sc3_call_callee(c, s) :- sc3_call(c, f), !node(_, f, "attribute", _, _), sps_text(f, s).
sc3_arg(c, a) :- sc3_call(c, _), field(c, "arguments", l), child(l, a, _), sc3_sel(a), node(_, a, k, _, _), !sc3_k_nonarg(k).
sc3_arg_later(c, a) :- sc3_arg(c, a), node(_, a, _, sa, _), sc3_arg(c, b), node(_, b, _, sb, _), sb < sa.
sc3_arg0(c, a) :- sc3_arg(c, a), !sc3_arg_later(c, a).
sc3_kw(c, s, v) :- sc3_call(c, _), field(c, "arguments", l), child(l, k, _), sc3_sel(k), node(_, k, "keyword_argument", _, _), field(k, "name", kn), sc3_sel(kn), text(kn, s), field(k, "value", v), sc3_sel(v).
sc3_param(f, p) :- node(_, f, "function_definition", _, _), field(f, "parameters", ps), child(ps, p, _), sc3_sel(p), node(_, p, k, _, _), sc3_k_param(k).
sc3_param_earlier(p, i) :- sc3_param(_, p), child(p, _, i), child(p, m, j), j < i, sc3_sel(m).
sc3_param_name(f, p, s) :- sc3_param(f, p), node(_, p, "identifier", _, _), text(p, s).
sc3_param_name(f, p, s) :- sc3_param(f, p), child(p, n, i), sc3_sel(n), !sc3_param_earlier(p, i), node(_, n, "identifier", _, _), text(n, s).
sc3_rawresult_type(t) :- inside(x, t, sc3_k_type), sc3_sel(x), node(_, x, "identifier", _, _), text(x, "RawResult").
sc3_rawresult_type(t) :- inside(x, t, sc3_k_type), sc3_sel(x), node(_, x, k, _, _), sc3_k_str(k), sps_text(x, s), contains("RawResult", s).
sc3_raw_param(f, s) :- sc3_param_name(f, _, s), (s = "raw" ; s = "raw_rows" ; s = "rows").
sc3_raw_param(f, s) :- sc3_param_name(f, p, s), field(p, "type", t), sc3_sel(t), sc3_rawresult_type(t).
sc3_has_raw_param(f) :- sc3_raw_param(f, _).
sc3_shaper(d, s) :- sc3_fn_name(f, s), node(d, f, _, _, _), sc3_raw_param(f, pn), inside(n, f, sc3_k_fn), sc3_sel(n), node(_, n, k, _, _), sc3_k_loop(k), field(n, "right", rt), sc3_sel(rt), node(_, rt, _, rs, re), inside(r, f, sc3_k_fn), sc3_sel(r), node(_, r, "identifier", s1, e1), text(r, pn), rs <= s1, e1 <= re.
sc3_shaper(d, s) :- sc3_fn_name(f, s), node(d, f, _, _, _), sc3_raw_param(f, pn), inside(c, f, sc3_k_fn), sc3_call_full(c, cs), sc3_k_copy(cs), sc3_arg0(c, a), node(_, a, _, ast, ae), inside(r, c, sc3_k_call), sc3_sel(r), node(_, r, "identifier", s1, e1), text(r, pn), ast <= s1, e1 <= ae.
sc3_shaper(d, s) :- sc3_fn_name(f, s), node(d, f, _, _, _), sc3_has_raw_param(f), inside(c, f, sc3_k_fn), sc3_call_full(c, t), sc3_shaper(d, t).
sc3_shaping_cls(c) :- sc3_method(m, c, "materialize"), node(d, m, _, _, _), sc3_shaper(d, "materialize").
sc3_shaping_cls(c) :- sc3_method(m, c, "materialize"), node(d, m, _, _, _), inside(x, m, sc3_k_fn), sc3_call_full(x, t), sc3_shaper(d, t).
sc3_bad(n) :- sc3_shaping_cls(c), sc3_class(c, s), node(d, c, _, _, _), node(d, n, "identifier", _, _), text(n, s), sc3_sel(n).
sc3_bad(n) :- sc3_shaping_cls(c), sc3_class(c, s), node(d, c, _, _, _), sc3_call_callee(n, s), node(d, n, _, _, _).
sc3_has_literal_payload(c) :- sc3_kw(c, "literal_payload", _).
sc3_payload(v) :- sc3_kw(c, "literal_payload", v), sc3_call_callee(c, "ResultMaterializationSpec").
sc3_payload(v) :- sc3_kw(c, "terminal_literal", v), sc3_call_callee(c, "ResultMaterializationSpec"), !sc3_has_literal_payload(c).
sc3_payload(x) :- sc3_payload(n), sc3_sel(n), node(_, n, k, _, _), sc3_k_container(k), child(n, x, _), sc3_sel(x).
sc3_payload(x) :- sc3_payload(n), sc3_kw(n, _, x).
sc3_payload(x) :- sc3_payload(n), sc3_arg(n, x).
sc3_payload(x) :- sc3_payload(n), sc3_sel(n), node(_, n, "pair", _, _), field(n, "value", x).
violation("data-layer-serverplan-steps", "step-contracts-3", "STEP-039", p, l) :- sc3_kw(_, "row_materializer", n), sc3_bad(n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l), sps_on("check_row_materializer_raw_row_shaping_guardrail").
violation("data-layer-serverplan-steps", "step-contracts-3", "STEP-039", p, l) :- sc3_payload(n), sc3_sel(n), sc3_bad(n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l), sps_on("check_literal_payload_materializer_dispatch_guardrail").
sc4_m277(n) :- child(v274, n, _), node(_, v274, "module", _, _).
sc4_m277(n) :- child(v275, n, _), node(_, v275, "block", _, _), child(v276, v275, _), node(_, v276, "class_definition", _, _).
sc4_m281(n) :- node(_, n, "module", _, _).
sc4_m281(n) :- node(_, n, "expression_statement", _, _), sc4_m277(n).
sc4_m281(n) :- node(_, n, "class_definition", _, _).
sc4_m281(n) :- node(_, n, "function_definition", _, _).
sc4_m281(n) :- node(_, n, "decorated_definition", _, _).
sc4_m281(n) :- node(_, n, "argument_list", _, _), child(v278, n, _), node(_, v278, "class_definition", _, _).
sc4_m281(n) :- child(v279, n, _), node(_, v279, "argument_list", _, _), child(v280, v279, _), node(_, v280, "class_definition", _, _).
sc4_m289(n) :- field(n, "right", v282), node(_, v282, "lambda", _, _).
sc4_m289(n) :- field(n, "left", v283), sps_text(v283, v284), icontains("runtime", v284), sps_text(v283, v285), (icontains("callable", v285) ; icontains("callback", v285) ; icontains("effect", v285) ; icontains("function", v285) ; icontains("hook", v285)).
sc4_m289(n) :- inside(n, v286, sc4_k4), node(_, v286, "class_definition", _, _), field(v286, "name", v287), node(_, v287, "identifier", _, _), text(v287, v288), v288 = "RuntimeBuilderKind".
sc4_m298(n) :- field(n, "right", v291), node(_, v291, "lambda", _, _).
sc4_m298(n) :- field(n, "left", v292), sps_text(v292, v293), icontains("runtime", v293), sps_text(v292, v294), (icontains("callable", v294) ; icontains("callback", v294) ; icontains("effect", v294) ; icontains("function", v294) ; icontains("hook", v294)).
sc4_m298(n) :- inside(n, v295, sc4_k4), node(_, v295, "class_definition", _, _), field(v295, "name", v296), node(_, v296, "identifier", _, _), text(v296, v297), v297 = "RuntimeBuilderKind".
sc4_m303(n) :- node(_, n, "identifier", _, _), text(n, v300), (v300 = "RuntimeBuilderSpec" ; v300 = "runtime_builder_post_op" ; v300 = "runtime_op_post_op").
sc4_m303(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v301), node(_, v301, "identifier", _, _), text(v301, v302), (v302 = "RuntimeBuilderSpec" ; v302 = "runtime_builder_post_op" ; v302 = "runtime_op_post_op").
sc4_m308(n) :- node(_, n, "call", _, _), field(n, "function", v299), sc4_m303(v299).
sc4_m308(n) :- node(_, n, "call", _, _), field(n, "function", v304), sps_text(v304, v305), icontains("runtime", v305), sps_text(v304, v306), icontains("register", v306), sps_text(v304, v307), (icontains("callable", v307) ; icontains("callback", v307) ; icontains("effect", v307) ; icontains("function", v307) ; icontains("hook", v307) ; icontains("processor", v307) ; icontains("transform", v307)).
sc4_m314(n) :- node(_, n, "identifier", _, _), text(n, v311), (v311 = "RuntimeBuilderSpec" ; v311 = "runtime_builder_post_op" ; v311 = "runtime_op_post_op").
sc4_m314(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v312), node(_, v312, "identifier", _, _), text(v312, v313), (v313 = "RuntimeBuilderSpec" ; v313 = "runtime_builder_post_op" ; v313 = "runtime_op_post_op").
sc4_m319(n) :- node(_, n, "call", _, _), field(n, "function", v310), sc4_m314(v310).
sc4_m319(n) :- node(_, n, "call", _, _), field(n, "function", v315), sps_text(v315, v316), icontains("runtime", v316), sps_text(v315, v317), icontains("register", v317), sps_text(v315, v318), (icontains("callable", v318) ; icontains("callback", v318) ; icontains("effect", v318) ; icontains("function", v318) ; icontains("hook", v318) ; icontains("processor", v318) ; icontains("transform", v318)).
sc4_m320(n) :- sc4_m281(n).
sc4_m320(n) :- node(_, n, "assignment", _, _), sc4_m289(n).
sc4_m320(n) :- child(v290, n, _), node(_, v290, "assignment", _, _), sc4_m298(v290).
sc4_m320(n) :- sc4_m308(n).
sc4_m320(n) :- inside(n, v309, sc4_k2), sc4_m319(v309).
sc4_selected(n) :- sc4_m320(n).
sc4_named2(n) :- sc4_selected(n), node(_, n, k, _, _), sc4_k_named(k), sps_text(n, s), match("(?s:.*)(?:[cC][aA][lL][lL][aA][bB][lL][eE]|[cC][aA][lL][lL][bB][aA][cC][kK]|[cC][lL][oO][sS][uU][rR][eE]|[fF][uU][nN][cC][tT][iI][oO][nN]|[lL][aA][mM][bB][dD][aA]|[pP][aA][rR][tT][iI][aA][lL])(?s:.*)", s).
sc4_sel_child(p, n, i) :- child(p, n, i), sc4_selected(n), node(_, p, k, _, _), sc4_k_ordp(k).
sc4_sel_comment(p, s) :- node(_, p, k, _, _), sc4_k_ordp(k), token(p, _, t, s, _), prefix("#", t), inside(p, c, sc4_k2), sc4_m319(c).
sc4_sel_start(p, s) :- sc4_sel_child(p, n, _), node(_, n, _, s, _).
sc4_sel_start(p, s) :- sc4_sel_comment(p, s).
sc4_sel_before(p, s) :- sc4_sel_start(p, s), sc4_sel_start(p, t), t < s.
sc4_ord(n, 0) :- sc4_sel_child(p, n, _), node(_, n, _, s, _), !sc4_sel_before(p, s).
rr_cover2(p, s) :- sc4_sel_before(p, s).
rr_ctx3(p, s) :- sc4_sel_child(p, n, _), node(_, n, _, s, _), rr_cover2(p, s).
rr_agg1(p, s, t) :- rr_demand_agg_rr_agg1(p, s), rr_ctx3(p, s), sc4_sel_start(p, t), t < s.
sc4_ord(n, o) :- sc4_sel_child(p, n, _), node(_, n, _, s, _), sc4_sel_before(p, s), o = count : { rr_agg1(p, s, _) }.
sc4_fn_name(f, s) :- node(_, f, "function_definition", _, _), field(f, "name", x), text(x, s).
sc4_class(c, s) :- node(_, c, "class_definition", _, _), field(c, "name", x), text(x, s).
sc4_attr(a) :- sc4_selected(a), node(_, a, "attribute", _, _).
sc4_call(c, f) :- sc4_selected(c), node(_, c, "call", _, _), field(c, "function", f), sc4_selected(f).
sc4_call_full(c, s) :- sc4_call(c, f), sps_text(f, s).
sc4_callee(c, s) :- sc4_call(c, f), node(_, f, "attribute", _, _), field(f, "attribute", x), text(x, s).
sc4_callee(c, s) :- sc4_call(c, f), !node(_, f, "attribute", _, _), sps_text(f, s).
sc4_arg(c, a) :- sc4_call(c, _), field(c, "arguments", l), child(l, a, _), sc4_selected(a), node(_, a, k, _, _), !sc4_k_nonarg(k).
sc4_arg_before(c, a, b) :- sc4_arg(c, a), node(_, a, _, sa, _), sc4_arg(c, b), node(_, b, _, sb, _), sb < sa.
sc4_arg_later(c, a) :- sc4_arg_before(c, a, _).
sc4_argpos(c, a, 0) :- sc4_arg(c, a), !sc4_arg_later(c, a).
sc4_argpos(c, a, p) :- sc4_arg_later(c, a), p = count : { sc4_arg_before(c, a, _) }.
sc4_kw(c, s, v) :- sc4_call(c, _), field(c, "arguments", l), child(l, k, _), sc4_selected(k), node(_, k, "keyword_argument", _, _), field(k, "name", kn), sc4_selected(kn), text(kn, s), field(k, "value", v), sc4_selected(v).
sc4_return_value(f, v) :- sc4_selected(r), node(_, r, "return_statement", _, _), child(r, v, _), sc4_selected(v), nearest(r, f, sc4_k_fn).
sc4_asg(n, l) :- sc4_selected(n), node(_, n, "assignment", _, _), field(n, "left", l), sc4_selected(l).
sc4_asg_value(n, r) :- sc4_asg(n, _), field(n, "right", r), sc4_selected(r).
sc4_expr_edge(c, p) :- sc4_selected(p), node(_, p, k, _, _), sc4_k_expr_container(k), child(p, c, _), sc4_selected(c).
sc4_expr_edge(c, p) :- sc4_selected(p), node(_, p, "pair", _, _), child(p, c, _), sc4_ord(c, 1).
sc4_expr_edge(c, p) :- sc4_selected(p), node(_, p, "dictionary", _, _), child(p, c, _), sc4_selected(c).
sc4_expr_edge(a, c) :- sc4_arg(c, a).
sc4_expr_edge(v, c) :- sc4_kw(c, _, v).
sc4_expr_edge(v, c) :- sc4_call_full(c, t), node(d, c, _, _, _), sc4_fn_name(f, t), node(d, f, _, _, _), sc4_return_value(f, v).
sc4_callable_edge(o, a) :- sc4_attr(a), field(a, "object", o).
sc4_callable_edge(x, a) :- sc4_attr(a), field(a, "attribute", x).
sc4_callable_edge(f, c) :- sc4_call(c, f).
sc4_callable_edge(a, c) :- sc4_arg(c, a).
sc4_callable_edge(v, c) :- sc4_kw(c, _, v).
sc4_callable_edge(c, n) :- sc4_selected(n), node(_, n, k, _, _), sc4_k_callable_wrap(k), child(n, c, _), sc4_ord(c, 0).
sc4_user_callable(n) :- sc4_selected(n), node(_, n, "lambda", _, _).
sc4_user_callable(n) :- sc4_selected(n), node(_, n, "identifier", _, _), text(n, s), match("(?s:.*)(?:[cC][aA][lL][lL][aA][bB][lL][eE]|[cC][aA][lL][lL][bB][aA][cC][kK]|[dD][eE][cC][oO][dD][eE][rR]|[fF][nN]|[fF][uU][nN][cC][tT][iI][oO][nN]|[hH][oO][oO][kK]|[mM][aA][pP][pP][eE][rR]|[pP][iI][cC][kK][eE][rR]|[pP][rR][oO][cC][eE][sS][sS][oO][rR]|[pP][rR][oO][jJ][eE][cC][tT][oO][rR]|[tT][rR][aA][nN][sS][fF][oO][rR][mM])(?s:.*)", s).
sc4_user_callable(t) :- sc4_user_callable(s), sc4_callable_edge(s, t).
sc4_lambda_target(d, s) :- sc4_asg_value(a, r), node(_, r, "lambda", _, _), sc4_asg(a, l), sps_text(l, s), node(d, a, _, _, _).
sc4_direct_callable(n) :- sc4_selected(n), node(_, n, "lambda", _, _).
sc4_direct_callable(n) :- sc4_selected(n), node(d, n, "identifier", _, _), text(n, s), sc4_fn_name(f, s), node(d, f, _, _, _).
sc4_direct_callable(n) :- sc4_selected(n), node(d, n, "identifier", _, _), text(n, s), sc4_lambda_target(d, s).
sc4_direct_callable(c) :- sc4_call_full(c, "partial").
sc4_direct_callable(c) :- sc4_call_full(c, "functools.partial").
sc4_direct_callable(t) :- sc4_direct_callable(s), sc4_expr_edge(s, t), sc4_selected(t), !node(_, t, "identifier", _, _).
sc4_mutable(n) :- sc4_selected(n), node(_, n, k, _, _), sc4_k_mutable(k).
sc4_mutable(p) :- sc4_mutable(m), child(p, m, _), node(_, p, "tuple", _, _), sc4_selected(p).
sc4_builder(c, s) :- sc4_callee(c, s), sc4_k_builder(s).
sc4_literal_kwargs(v) :- sc4_kw(c, "literal_kwargs", v), sc4_builder(c, "RuntimeBuilderSpec").
sc4_literal_pair(v, kn, x) :- sc4_literal_kwargs(v), child(v, p, _), sc4_selected(p), node(_, p, pk, _, _), sc4_k_pair(pk), child(p, kn, _), sc4_ord(kn, 0), node(_, kn, kk, _, _), sc4_k_str(kk), child(p, x, _), sc4_ord(x, 1).
sc4_key_builder(kn) :- sc4_literal_pair(_, kn, _), sps_text(kn, s), match("['\"]*[bB][uU][iI][lL][dD][eE][rR]['\"]*", s).
sc4_hit(n) :- sc4_asg(n, l), node(_, l, k, _, _), sc4_k_target(k), sps_text(l, s), match("(?s:.*)[rR][uU][nN][tT][iI][mM][eE](?s:.*)", s), match("(?s:.*)(?:[cC][aA][lL][lL][bB][aA][cC][kK]|[cC][aA][lL][lL][aA][bB][lL][eE]|[eE][fF][fF][eE][cC][tT]|[fF][uU][nN][cC][tT][iI][oO][nN]|[hH][oO][oO][kK])(?s:.*)", s).
sc4_kind_member(n) :- sc4_asg(n, _), child(e, n, _), sc4_selected(e), node(_, e, "expression_statement", _, _), child(b, e, _), field(c, "body", b), sc4_class(c, "RuntimeBuilderKind").
sc4_hit(n) :- sc4_kind_member(n), sc4_asg(n, l), node(_, l, "identifier", _, _), sc4_named2(l).
sc4_hit(n) :- sc4_kind_member(n), sc4_asg_value(n, r), node(_, r, k, _, _), sc4_k_str(k), sc4_named2(r).
sc4_hit(n) :- sc4_call_full(n, s), match("(?s:.*)[rR][uU][nN][tT][iI][mM][eE](?s:.*)", s), match("(?s:.*)[rR][eE][gG][iI][sS][tT][eE][rR](?s:.*)", s), match("(?s:.*)(?:[cC][aA][lL][lL][bB][aA][cC][kK]|[cC][aA][lL][lL][aA][bB][lL][eE]|[eE][fF][fF][eE][cC][tT]|[fF][uU][nN][cC][tT][iI][oO][nN]|[hH][oO][oO][kK]|[pP][rR][oO][cC][eE][sS][sS][oO][rR]|[tT][rR][aA][nN][sS][fF][oO][rR][mM])(?s:.*)", s).
sc4_hit(n) :- sc4_builder(n, "runtime_builder_post_op"), sc4_argpos(n, a, 0), node(_, a, k, _, _), sc4_k_target(k), sc4_named2(a).
sc4_hit(n) :- sc4_builder(n, "runtime_builder_post_op"), sc4_argpos(n, a, 1), node(_, a, k, _, _), sc4_k_str(k), sc4_named2(a).
sc4_hit(n) :- sc4_builder(n, "runtime_op_post_op"), sc4_argpos(n, a, 0), node(_, a, k, _, _), sc4_k_str(k), sc4_named2(a).
sc4_hit(n) :- sc4_builder(n, e), e != "runtime_op_post_op", sc4_kw(n, "kind", v), node(_, v, k, _, _), sc4_k_target(k), sc4_named2(v).
sc4_hit(n) :- sc4_builder(n, _), sc4_kw(n, "builder_name", v), node(_, v, k, _, _), sc4_k_str(k), sc4_named2(v).
sc4_builder_kw(s, v) :- sc4_kw(c, s, v), sc4_builder(c, _).
sc4_hit(n) :- sc4_builder_kw(s, n), match("[bB][uU][iI][lL][dD][eE][rR]", s).
sc4_hit(n) :- sc4_builder_kw(s, n), match("(?s:.*)(?:[cC][aA][lL][lL][aA][bB][lL][eE]|[cC][aA][lL][lL][bB][aA][cC][kK]|[cC][lL][oO][sS][uU][rR][eE]|[dD][eE][cC][oO][dD][eE][rR]|[eE][fF][fF][eE][cC][tT]_[iI][dD]|[fF][nN]|[fF][uU][nN][cC][tT][iI][oO][nN]|[hH][oO][oO][kK]|[lL][aA][mM][bB][dD][aA]|[mM][aA][pP][pP][eE][rR]|[pP][aA][rR][tT][iI][aA][lL]|[pP][iI][cC][kK][eE][rR]|[pP][rR][oO][cC][eE][sS][sS][oO][rR]|[pP][rR][oO][jJ][eE][cC][tT][oO][rR]|[rR][eE][gG][iI][sS][tT][rR][yY]_[iI][dD]|[tT][rR][aA][nN][sS][fF][oO][rR][mM])(?s:.*)", s).
sc4_hit(n) :- sc4_builder_kw(_, n), sc4_user_callable(n).
sc4_hit(n) :- sc4_builder_kw(_, n), sc4_direct_callable(n).
sc4_hit(n) :- sc4_builder_kw(s, n), s != "literal_kwargs", sc4_mutable(n).
sc4_hit(n) :- sc4_literal_pair(n, kn, _), sc4_named2(kn).
sc4_hit(n) :- sc4_literal_pair(n, kn, _), sc4_key_builder(kn).
sc4_hit(n) :- sc4_literal_pair(n, _, x), sc4_user_callable(x).
sc4_hit(n) :- sc4_literal_kwargs(n), sc4_user_callable(n).
sc4_hit(n) :- sc4_literal_pair(n, _, x), sc4_direct_callable(x).
sc4_hit(n) :- sc4_literal_kwargs(n), sc4_direct_callable(n).
sc4_hit(n) :- sc4_literal_kwargs(n), sc4_mutable(n).
violation("data-layer-serverplan-steps", "step-contracts-4", "STEP-029", p, l) :- sc4_hit(n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l), sps_on("check_closed_post_op_runtime_builder_no_callable_escape_hatches").
sc6_m430(n) :- child(v427, n, _), node(_, v427, "module", _, _).
sc6_m430(n) :- child(v428, n, _), node(_, v428, "block", _, _), child(v429, v428, _), node(_, v429, "class_definition", _, _).
sc6_m434(n) :- node(_, n, "module", _, _).
sc6_m434(n) :- node(_, n, "expression_statement", _, _), sc6_m430(n).
sc6_m434(n) :- node(_, n, "class_definition", _, _).
sc6_m434(n) :- node(_, n, "function_definition", _, _).
sc6_m434(n) :- node(_, n, "decorated_definition", _, _).
sc6_m434(n) :- node(_, n, "argument_list", _, _), child(v431, n, _), node(_, v431, "class_definition", _, _).
sc6_m434(n) :- child(v432, n, _), node(_, v432, "argument_list", _, _), child(v433, v432, _), node(_, v433, "class_definition", _, _).
sc6_m439(n) :- node(_, n, "identifier", _, _), text(n, v436), v436 = "CompiledStep".
sc6_m439(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v437), node(_, v437, "identifier", _, _), text(v437, v438), v438 = "CompiledStep".
sc6_m444(n) :- node(_, n, "identifier", _, _), text(n, v441), (v441 = "ResultAssertionSpec" ; v441 = "ResultMaterializationSpec" ; v441 = "assert_result" ; v441 = "materialize" ; v441 = "static_exception_post_op").
sc6_m444(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v442), node(_, v442, "identifier", _, _), text(v442, v443), (v443 = "ResultAssertionSpec" ; v443 = "ResultMaterializationSpec" ; v443 = "assert_result" ; v443 = "materialize" ; v443 = "static_exception_post_op").
sc6_m445(n) :- node(_, n, "call", _, _), field(n, "function", v435), sc6_m439(v435).
sc6_m445(n) :- node(_, n, "call", _, _), field(n, "function", v440), sc6_m444(v440).
sc6_m447(n) :- sc6_m445(n).
sc6_m447(n) :- node(_, n, "call", _, _), child(v446, n, _), node(_, v446, "return_statement", _, _).
sc6_m453(n) :- node(_, n, "identifier", _, _), text(n, v450), v450 = "CompiledStep".
sc6_m453(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v451), node(_, v451, "identifier", _, _), text(v451, v452), v452 = "CompiledStep".
sc6_m458(n) :- node(_, n, "identifier", _, _), text(n, v455), (v455 = "ResultAssertionSpec" ; v455 = "ResultMaterializationSpec" ; v455 = "assert_result" ; v455 = "materialize" ; v455 = "static_exception_post_op").
sc6_m458(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v456), node(_, v456, "identifier", _, _), text(v456, v457), (v457 = "ResultAssertionSpec" ; v457 = "ResultMaterializationSpec" ; v457 = "assert_result" ; v457 = "materialize" ; v457 = "static_exception_post_op").
sc6_m459(n) :- node(_, n, "call", _, _), field(n, "function", v449), sc6_m453(v449).
sc6_m459(n) :- node(_, n, "call", _, _), field(n, "function", v454), sc6_m458(v454).
sc6_m461(n) :- sc6_m459(n).
sc6_m461(n) :- node(_, n, "call", _, _), child(v460, n, _), node(_, v460, "return_statement", _, _).
sc6_m468(n) :- node(_, n, "identifier", _, _), text(n, v465), v465 = "CompiledStep".
sc6_m468(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v466), node(_, v466, "identifier", _, _), text(v466, v467), v467 = "CompiledStep".
sc6_m473(n) :- node(_, n, "identifier", _, _), text(n, v470), (v470 = "ResultAssertionSpec" ; v470 = "ResultMaterializationSpec" ; v470 = "assert_result" ; v470 = "materialize" ; v470 = "static_exception_post_op").
sc6_m473(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v471), node(_, v471, "identifier", _, _), text(v471, v472), (v472 = "ResultAssertionSpec" ; v472 = "ResultMaterializationSpec" ; v472 = "assert_result" ; v472 = "materialize" ; v472 = "static_exception_post_op").
sc6_m474(n) :- node(_, n, "call", _, _), field(n, "function", v464), sc6_m468(v464).
sc6_m474(n) :- node(_, n, "call", _, _), field(n, "function", v469), sc6_m473(v469).
sc6_m476(n) :- sc6_m474(n).
sc6_m476(n) :- node(_, n, "call", _, _), child(v475, n, _), node(_, v475, "return_statement", _, _).
sc6_m484(n) :- node(_, n, "identifier", _, _), text(n, v481), v481 = "CompiledStep".
sc6_m484(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v482), node(_, v482, "identifier", _, _), text(v482, v483), v483 = "CompiledStep".
sc6_m489(n) :- node(_, n, "identifier", _, _), text(n, v486), (v486 = "ResultAssertionSpec" ; v486 = "ResultMaterializationSpec" ; v486 = "assert_result" ; v486 = "materialize" ; v486 = "static_exception_post_op").
sc6_m489(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v487), node(_, v487, "identifier", _, _), text(v487, v488), (v488 = "ResultAssertionSpec" ; v488 = "ResultMaterializationSpec" ; v488 = "assert_result" ; v488 = "materialize" ; v488 = "static_exception_post_op").
sc6_m490(n) :- node(_, n, "call", _, _), field(n, "function", v480), sc6_m484(v480).
sc6_m490(n) :- node(_, n, "call", _, _), field(n, "function", v485), sc6_m489(v485).
sc6_m492(n) :- sc6_m490(n).
sc6_m492(n) :- node(_, n, "call", _, _), child(v491, n, _), node(_, v491, "return_statement", _, _).
sc6_m493(n) :- sc6_m447(n).
sc6_m493(n) :- child(v448, n, _), sc6_m461(v448).
sc6_m493(n) :- child(v462, n, _), node(_, v462, "argument_list", _, _), child(v463, v462, _), sc6_m476(v463).
sc6_m493(n) :- child(v477, n, _), node(_, v477, "keyword_argument", _, _), child(v478, v477, _), node(_, v478, "argument_list", _, _), child(v479, v478, _), sc6_m492(v479).
sc6_m499(n) :- field(n, "attribute", v496), name(v496, v497), (icontains("callable", v497) ; icontains("callback", v497) ; icontains("decoder", v497) ; icontains("fn", v497) ; icontains("function", v497) ; icontains("hook", v497) ; icontains("mapper", v497) ; icontains("picker", v497) ; icontains("processor", v497) ; icontains("projector", v497) ; icontains("row_decoder", v497) ; icontains("transform", v497)).
sc6_m499(n) :- field(n, "object", v498), sc6_u494(v498).
sc6_m504(n) :- sc6_u494(n).
sc6_m504(n) :- node(_, n, "keyword_argument", _, _), field(n, "value", v503), sc6_u494(v503).
sc6_m505(n) :- field(n, "function", v500), sc6_u494(v500).
sc6_m505(n) :- field(n, "arguments", v501), child(v501, v502, _), sc6_m504(v502).
sc6_m508(n) :- node(_, n, "lambda", _, _).
sc6_m508(n) :- node(_, n, "identifier", _, _), text(n, v495), (icontains("callable", v495) ; icontains("callback", v495) ; icontains("decoder", v495) ; icontains("fn", v495) ; icontains("function", v495) ; icontains("hook", v495) ; icontains("mapper", v495) ; icontains("picker", v495) ; icontains("processor", v495) ; icontains("projector", v495) ; icontains("row_decoder", v495) ; icontains("transform", v495)).
sc6_m508(n) :- node(_, n, "attribute", _, _), sc6_m499(n).
sc6_m508(n) :- node(_, n, "call", _, _), sc6_m505(n).
sc6_m508(n) :- node(_, n, "subscript", _, _), field(n, "value", v506), sc6_u494(v506).
sc6_m508(n) :- node(_, n, "parenthesized_expression", _, _), child(n, v507, _), sc6_u494(v507).
sc6_m515(n) :- sc6_m434(n).
sc6_m515(n) :- sc6_m493(n).
sc6_m515(n) :- node(_, n, "call", _, _), sc6_u494(n).
sc6_m515(n) :- inside(n, v509, sc6_k2), node(_, v509, "call", _, _), sc6_u494(v509).
sc6_m515(n) :- node(_, n, "assignment", _, _), field(n, "left", v510), node(_, v510, "identifier", _, _), text(v510, v511), v511 = "CLOSED_POST_OP_STRICT".
sc6_m515(n) :- child(v512, n, _), node(_, v512, "assignment", _, _), field(v512, "left", v513), node(_, v513, "identifier", _, _), text(v513, v514), v514 = "CLOSED_POST_OP_STRICT".
sc6_u494(n) :- sc6_m508(n).
sc6_selected(n) :- sc6_m515(n).
sc6_strict_u516(n) :- node(_, n, "module", _, _), child(n, v517, _), node(_, v517, "expression_statement", _, _), child(v517, v518, _), node(_, v518, "assignment", _, _), field(v518, "left", v519), node(_, v519, "identifier", _, _), text(v519, v520), v520 = "CLOSED_POST_OP_STRICT", field(v518, "right", v521), node(_, v521, "true", _, _).
sc6_strict_selected(n) :- node(_, n, "module", _, _), sc6_strict_u516(n).
sc6_strict(n) :- sc6_strict_selected(n).
sc6_strict(n) :- inside(n, m, sc6_k_module), sc6_strict_selected(m).
sc6_sel(n) :- sc6_selected(n), option_on("strictModulesOnly"), sc6_strict(n).
sc6_sel(n) :- sc6_selected(n), !option_on("strictModulesOnly").
sc6_sel_child(p, n, i) :- child(p, n, i), sc6_sel(n), node(_, p, k, _, _), sc6_k_callable_wrap(k).
sc6_comment_at(p, s) :- node(_, p, k, _, _), sc6_k_callable_wrap(k), token(p, _, t, s, _), prefix("#", t), inside(p, c, sc6_k2), node(_, c, "call", _, _), sc6_u494(c).
sc6_sel_comment(p, s) :- sc6_comment_at(p, s), option_on("strictModulesOnly"), sc6_strict(p).
sc6_sel_comment(p, s) :- sc6_comment_at(p, s), !option_on("strictModulesOnly").
sc6_sel_start(p, s) :- sc6_sel_child(p, n, _), node(_, n, _, s, _).
sc6_sel_start(p, s) :- sc6_sel_comment(p, s).
sc6_has_before(p, s) :- sc6_sel_start(p, s), sc6_sel_start(p, t), t < s.
sc6_ord0(n) :- sc6_sel_child(p, n, _), node(_, n, _, s, _), !sc6_has_before(p, s).
sc6_fn_name(f, s) :- sc6_sel(f), node(_, f, "function_definition", _, _), field(f, "name", x), text(x, s).
sc6_attr(a) :- sc6_sel(a), node(_, a, "attribute", _, _).
sc6_call(c, f) :- sc6_sel(c), node(_, c, "call", _, _), field(c, "function", f), sc6_sel(f).
sc6_call_full(c, s) :- sc6_call(c, f), sps_text(f, s).
sc6_arg(c, a) :- sc6_call(c, _), field(c, "arguments", l), child(l, a, _), sc6_sel(a), node(_, a, k, _, _), !sc6_k_nonarg(k).
sc6_kw(c, s, v) :- sc6_call(c, _), field(c, "arguments", l), child(l, k, _), sc6_sel(k), node(_, k, "keyword_argument", _, _), field(k, "name", kn), sc6_sel(kn), text(kn, s), field(k, "value", v), sc6_sel(v).
sc6_callable_edge(o, a) :- sc6_attr(a), field(a, "object", o).
sc6_callable_edge(x, a) :- sc6_attr(a), field(a, "attribute", x).
sc6_callable_edge(f, c) :- sc6_call(c, f).
sc6_callable_edge(a, c) :- sc6_arg(c, a).
sc6_callable_edge(v, c) :- sc6_kw(c, _, v).
sc6_callable_edge(c, n) :- sc6_sel(n), node(_, n, k, _, _), sc6_k_callable_wrap(k), child(n, c, _), sc6_ord0(c).
sc6_user_callable(n) :- sc6_sel(n), node(_, n, "lambda", _, _).
sc6_user_callable(n) :- sc6_sel(n), node(_, n, "identifier", _, _), text(n, s), match("(?s:.*)(?:[cC][aA][lL][lL][aA][bB][lL][eE]|[cC][aA][lL][lL][bB][aA][cC][kK]|[dD][eE][cC][oO][dD][eE][rR]|[fF][nN]|[fF][uU][nN][cC][tT][iI][oO][nN]|[hH][oO][oO][kK]|[mM][aA][pP][pP][eE][rR]|[pP][iI][cC][kK][eE][rR]|[pP][rR][oO][cC][eE][sS][sS][oO][rR]|[pP][rR][oO][jJ][eE][cC][tT][oO][rR]|[tT][rR][aA][nN][sS][fF][oO][rR][mM])(?s:.*)", s).
sc6_user_callable(t) :- sc6_user_callable(s), sc6_callable_edge(s, t).
sc6_opt_in(d) :- !option_on("strictModulesOnly"), node(d, _, "module", _, _), !tape_syntax_error(d).
sc6_opt_in(d) :- sc6_sel(a), node(d, a, "assignment", _, _), field(a, "left", l), sc6_sel(l), sps_text(l, "CLOSED_POST_OP_STRICT"), field(a, "right", r), sc6_sel(r), node(_, r, "true", _, _), !field(a, "type", _), child(p, a, _), sc6_sel(p), child(m, p, _), sc6_sel(m), node(_, m, "module", _, _).
sc6_postop(s, v) :- sc6_kw(c, s, v), (s = "post_op" ; s = "post_op_with_refs"), sc6_call_full(c, "CompiledStep"), node(d, c, _, _, _), sc6_opt_in(d).
sc6_fn_newer(f) :- sc6_fn_name(f, s), node(d, f, _, sf, _), sc6_fn_name(g, s), node(d, g, _, sg, _), sg > sf.
sc6_callback_fn(f) :- sc6_postop(_, v), node(d, v, "identifier", _, _), sps_text(v, s), sc6_fn_name(f, s), node(d, f, _, _, _), !sc6_fn_newer(f).
sc6_hit(n) :- sc6_postop(_, n), sc6_call_full(n, "partial"), sc6_user_callable(n).
sc6_hit(n) :- sc6_postop("post_op_with_refs", n), sc6_call_full(n, t), t != "partial".
sc6_hit(n) :- sc6_postop(_, n), !node(_, n, "call", _, _), sc6_user_callable(n).
sc6_hit(n) :- sc6_callback_fn(f), inside(n, f, sc6_k_fn), sc6_call(n, _), sc6_user_callable(n).
violation("data-layer-serverplan-steps", "step-contracts-6", "STEP-028", p, l) :- sc6_hit(n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l), sps_on("check_legacy_postop_user_callable_escape_hatches").
rr_demand_agg_rr_agg1(p, s) :- sc4_sel_child(p, n, _), node(_, n, _, s, _), sc4_sel_before(p, s).
