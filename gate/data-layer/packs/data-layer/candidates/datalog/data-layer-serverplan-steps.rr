sc5_m418(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v416), node(_, v416, "identifier", _, _), text(v416, v417), (v417 = "ResultAssertionSpec" ; v417 = "assert_result" ; v417 = "static_exception_post_op").
sc5_m424(n) :- node(_, n, "identifier", _, _), text(n, v421), (v421 = "ResultAssertionSpec" ; v421 = "assert_result" ; v421 = "static_exception_post_op").
sc5_m424(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v422), node(_, v422, "identifier", _, _), text(v422, v423), (v423 = "ResultAssertionSpec" ; v423 = "assert_result" ; v423 = "static_exception_post_op").
sc5_m426(n) :- sc5_m328(n).
sc5_m426(n) :- sc5_m387(n).
sc5_m426(n) :- node(_, n, "return_statement", _, _), child(n, v388, _), node(_, v388, "call", _, _).
sc5_m426(n) :- inside(n, v389, sc5_k0), field(v389, "parameters", v390), node(_, n, _, v391, v392), node(_, v390, _, v393, v394), v393 <= v391, v392 <= v394, node(_, v389, "function_definition", _, _), inside(v395, v389, sc5_k0), node(_, v395, "call", _, _), field(v395, "function", v396), sc5_m400(v396), field(v395, "arguments", v401), child(v401, v402, _), node(_, v402, "keyword_argument", _, _), field(v402, "name", v403), node(_, v403, "identifier", _, _), text(v403, v404), v404 = "static_exception", field(v402, "value", v405), node(_, v405, "identifier", _, _).
sc5_m426(n) :- inside(n, v406, sc5_k5), field(v406, "value", v407), node(_, n, _, v408, v409), node(_, v407, _, v410, v411), v410 <= v408, v409 <= v411, node(_, v406, "keyword_argument", _, _), field(v406, "name", v412), node(_, v412, "identifier", _, _), text(v412, v413), v413 = "closed_post_op".
sc5_m426(n) :- node(_, n, "call", _, _), field(n, "function", v414), sc5_m418(v414).
sc5_m426(n) :- inside(n, v419, sc5_k2), node(_, v419, "call", _, _), field(v419, "function", v420), sc5_m424(v420).
sc5_m426(n) :- node(_, n, "raise_statement", _, _).
sc5_m426(n) :- inside(n, v425, sc5_k3), node(_, v425, "raise_statement", _, _).
sc5_selected(n) :- sc5_m426(n).
sc5_nodes(d, n) :- sc5_selected(n), node(d, n, _, _, _).
sc5_functions(d, f) :- sc5_nodes(d, f), node(d, f, "function_definition", _, _).
sc5_function_name(d, f, s) :- sc5_functions(d, f), field(f, "name", x), text(x, s).
sc5_call_fn(d, c, f) :- sc5_nodes(d, c), node(d, c, "call", _, _), field(c, "function", f), sc5_nodes(d, f).
sc5_attribute(n) :- node(_, n, "attribute", _, _).
sc5_callee(c, s) :- sc5_call_fn(_, c, f), !sc5_attribute(f), sps_text(f, s).
sc5_callee(c, s) :- sc5_call_fn(_, c, f), sc5_attribute(f), field(f, "attribute", a), sps_text(a, s).
sc5_full_callee(c, s) :- sc5_call_fn(_, c, f), sps_text(f, s).
sc5_static_exception_post_op_call(c) :- sc5_full_callee(c, s), match("(?is)^.*static.exception.post.op$", s).
sc5_assert_result_call(c) :- sc5_full_callee(c, s), match("(?is)^.*CompiledPostOp\\.assert.result$", s).
sc5_materialize_call(c) :- sc5_full_callee(c, s), match("(?is)^.*CompiledPostOp\\.materialize$", s).
sc5_argument(d, c, a) :- sc5_call_fn(d, c, _), field(c, "arguments", l), child(l, a, _), sc5_nodes(d, a), node(d, a, k, _, _), !sc5_not_argument_kind(k).
sc5_argument_later(c, a) :- sc5_argument(d, c, a), sc5_argument(d, c, b), node(d, a, _, sa, _), node(d, b, _, sb, _), sb < sa.
sc5_argument0(c, a) :- sc5_argument(_, c, a), !sc5_argument_later(c, a).
sc5_has_argument(c) :- sc5_argument(_, c, _).
sc5_keyword(d, c, s, v) :- sc5_call_fn(d, c, _), field(c, "arguments", l), child(l, k, _), sc5_nodes(d, k), node(d, k, "keyword_argument", _, _), field(k, "name", kn), sc5_nodes(d, kn), text(kn, s), field(k, "value", v), sc5_nodes(d, v).
sc5_return_value(d, f, v) :- sc5_nodes(d, r), node(d, r, "return_statement", _, _), child(r, v, _), sc5_nodes(d, v), nearest(r, f, sc5_k0), sc5_functions(d, f).
sc5_parameter(d, f, p) :- sc5_functions(d, f), field(f, "parameters", l), child(l, p, _), sc5_nodes(d, p), node(d, p, k, _, _), sc5_parameter_kind(k).
sc5_parameter_part(d, p, n) :- sc5_parameter(d, _, p), child(p, n, _), sc5_nodes(d, n).
sc5_parameter_part_later(n) :- sc5_parameter_part(d, p, n), sc5_parameter_part(d, p, m), node(d, n, _, sn, _), node(d, m, _, sm, _), sm < sn.
sc5_parameter_part_later(n) :- sc5_parameter_part(d, p, n), sc5_parameter_part(d, p, m), node(d, n, _, s, en), node(d, m, _, s, em), em < en.
sc5_parameter_name(d, f, s) :- sc5_parameter(d, f, p), node(d, p, "identifier", _, _), text(p, s).
sc5_parameter_name(d, f, s) :- sc5_parameter(d, f, p), sc5_parameter_part(d, p, n), node(d, n, "identifier", _, _), !sc5_parameter_part_later(n), text(n, s).
sc5_compiled(c) :- sc5_full_callee(c, "CompiledStep").
sc5_other_static_exception(s) :- sc5_keyword(_, s, "static_exception", v), node(_, v, "attribute", _, _), sps_text(v, x), !sc5_fail_open(x).
sc5_other_static_exception(s) :- sc5_keyword(_, s, "static_exception", v), node(_, v, "identifier", _, _), sps_text(v, x), !sc5_fail_open(x).
sc5_seed(c) :- sc5_static_exception_post_op_call(c), sc5_argument0(c, a), sps_text(a, x), sc5_fail_open(x).
sc5_seed(c) :- sc5_assert_result_call(c), sc5_argument0(c, a), sc5_call_fn(_, a, _), !sc5_other_static_exception(a).
sc5_seed(c) :- sc5_assert_result_call(c), sc5_keyword(_, c, "spec", a), sc5_call_fn(_, a, _), !sc5_has_argument(c), !sc5_other_static_exception(a).
sc5_static_exception_function(d, s) :- sc5_function_name(d, f, s), inside(c, f, sc5_k0), sc5_nodes(d, c), sc5_callee(c, "ResultAssertionSpec"), sc5_keyword(d, c, "static_exception", v), node(d, v, "identifier", _, _), sps_text(v, x), sc5_parameter_name(d, f, x).
sc5_static_exception_function(d, s) :- sc5_function_name(d, f, s), sc5_return_value(d, f, v), sc5_seed(v).
sc5_static_exception_function(d, s) :- sc5_function_name(d, f, s), sc5_return_value(d, f, v), sc5_callee(v, e), sc5_static_exception_function(d, e).
sc5_materializing_call(c) :- sc5_callee(c, "ResultMaterializationSpec").
sc5_materializing_call(c) :- sc5_materialize_call(c).
sc5_materializing_call(c) :- sc5_callee(c, "CompiledStep"), sc5_keyword(_, c, k, _), sc5_post_op_keyword(k).
sc5_materialization_function(f) :- sc5_functions(d, f), inside(c, f, sc5_k0), sc5_nodes(d, c), sc5_materializing_call(c).
sc5_fail_open_raised(e) :- node(_, e, "identifier", _, _), sps_text(e, x), sc5_fail_open(x).
sc5_fail_open_raised(e) :- sc5_full_callee(e, x), sc5_fail_open(x).
sc5_row(d, n) :- sc5_nodes(d, n), node(d, n, "raise_statement", _, _), nearest(n, f, sc5_k0), sc5_materialization_function(f), child(n, e, _), sc5_nodes(d, e), sc5_fail_open_raised(e).
sc5_closed_post_op_value(d, v) :- sc5_keyword(d, c, "closed_post_op", v), sc5_compiled(c), nearest(c, f, sc5_k0), sc5_materialization_function(f).
sc5_row(d, n) :- sc5_closed_post_op_value(d, n), sc5_seed(n).
sc5_row(d, n) :- sc5_closed_post_op_value(d, n), sc5_callee(n, e), sc5_static_exception_function(d, e).
violation("data-layer-serverplan-steps", "step-contracts-5", "STEP-041", p, l) :- sc5_row(d, n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l), sps_on("check_compiled_result_builders_do_not_fail_closed").
sc2_m176(n) :- child(v173, n, _), node(_, v173, "module", _, _).
sc2_m176(n) :- child(v174, n, _), node(_, v174, "block", _, _), child(v175, v174, _), node(_, v175, "class_definition", _, _).
sc2_m180(n) :- node(_, n, "module", _, _).
sc2_m180(n) :- node(_, n, "expression_statement", _, _), sc2_m176(n).
sc2_m180(n) :- node(_, n, "class_definition", _, _).
sc2_m180(n) :- node(_, n, "function_definition", _, _).
sc2_m180(n) :- node(_, n, "decorated_definition", _, _).
sc2_m180(n) :- node(_, n, "argument_list", _, _), child(v177, n, _), node(_, v177, "class_definition", _, _).
sc2_m180(n) :- child(v178, n, _), node(_, v178, "argument_list", _, _), child(v179, v178, _), node(_, v179, "class_definition", _, _).
sc2_m206(n) :- node(_, n, "identifier", _, _), text(n, v203), v203 = "CompiledStep".
sc2_m206(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v204), node(_, v204, "identifier", _, _), text(v204, v205), v205 = "CompiledStep".
sc2_m210(n) :- node(_, n, "call", _, _), inside(n, v198, sc2_k0), node(_, v198, "function_definition", _, _), inside(v198, v199, sc2_k0), node(_, v199, "function_definition", _, _), field(v199, "name", v200), node(_, v200, "identifier", _, _), text(v200, v201), v201 = "compile".
sc2_m210(n) :- node(_, n, "call", _, _), field(n, "function", v202), sc2_m206(v202), inside(n, v207, sc2_k0), node(_, v207, "function_definition", _, _), field(v207, "name", v208), node(_, v208, "identifier", _, _), text(v208, v209), v209 = "compile".
sc2_m220(n) :- node(_, n, "identifier", _, _), text(n, v217), v217 = "CompiledStep".
sc2_m220(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v218), node(_, v218, "identifier", _, _), text(v218, v219), v219 = "CompiledStep".
sc2_m224(n) :- node(_, n, "call", _, _), inside(n, v212, sc2_k0), node(_, v212, "function_definition", _, _), inside(v212, v213, sc2_k0), node(_, v213, "function_definition", _, _), field(v213, "name", v214), node(_, v214, "identifier", _, _), text(v214, v215), v215 = "compile".
sc2_m224(n) :- node(_, n, "call", _, _), field(n, "function", v216), sc2_m220(v216), inside(n, v221, sc2_k0), node(_, v221, "function_definition", _, _), field(v221, "name", v222), node(_, v222, "identifier", _, _), text(v222, v223), v223 = "compile".
sc2_m235(n) :- node(_, n, "identifier", _, _), text(n, v232), v232 = "CompiledStep".
sc2_m235(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v233), node(_, v233, "identifier", _, _), text(v233, v234), v234 = "CompiledStep".
sc2_m239(n) :- node(_, n, "call", _, _), inside(n, v227, sc2_k0), node(_, v227, "function_definition", _, _), inside(v227, v228, sc2_k0), node(_, v228, "function_definition", _, _), field(v228, "name", v229), node(_, v229, "identifier", _, _), text(v229, v230), v230 = "compile".
sc2_m239(n) :- node(_, n, "call", _, _), field(n, "function", v231), sc2_m235(v231), inside(n, v236, sc2_k0), node(_, v236, "function_definition", _, _), field(v236, "name", v237), node(_, v237, "identifier", _, _), text(v237, v238), v238 = "compile".
sc2_m251(n) :- node(_, n, "identifier", _, _), text(n, v248), v248 = "CompiledStep".
sc2_m251(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v249), node(_, v249, "identifier", _, _), text(v249, v250), v250 = "CompiledStep".
sc2_m255(n) :- node(_, n, "call", _, _), inside(n, v243, sc2_k0), node(_, v243, "function_definition", _, _), inside(v243, v244, sc2_k0), node(_, v244, "function_definition", _, _), field(v244, "name", v245), node(_, v245, "identifier", _, _), text(v245, v246), v246 = "compile".
sc2_m255(n) :- node(_, n, "call", _, _), field(n, "function", v247), sc2_m251(v247), inside(n, v252, sc2_k0), node(_, v252, "function_definition", _, _), field(v252, "name", v253), node(_, v253, "identifier", _, _), text(v253, v254), v254 = "compile".
sc2_m260(n) :- node(_, n, "identifier", _, _).
sc2_m260(n) :- node(_, n, "attribute", _, _).
sc2_m266(n) :- node(_, n, "identifier", _, _).
sc2_m266(n) :- node(_, n, "attribute", _, _).
sc2_m273(n) :- sc2_m180(n).
sc2_m273(n) :- inside(n, v181, sc2_k0), field(v181, "parameters", v182), node(_, n, _, v183, v184), node(_, v182, _, v185, v186), v185 <= v183, v184 <= v186, node(_, v181, "function_definition", _, _), inside(v181, v187, sc2_k0), node(_, v187, "function_definition", _, _), field(v187, "name", v188), node(_, v188, "identifier", _, _), text(v188, v189), v189 = "compile".
sc2_m273(n) :- inside(n, v190, sc2_k0), field(v190, "return_type", v191), node(_, n, _, v192, v193), node(_, v191, _, v194, v195), v194 <= v192, v193 <= v195, node(_, v190, "function_definition", _, _), field(v190, "return_type", v196), sps_text(v196, v197), (contains("DatabaseConnection", v197) ; contains("ReadTransaction", v197) ; contains("SqlConnection", v197) ; contains("WriteTransaction", v197)).
sc2_m273(n) :- sc2_m210(n).
sc2_m273(n) :- child(v211, n, _), sc2_m224(v211).
sc2_m273(n) :- child(v225, n, _), node(_, v225, "argument_list", _, _), child(v226, v225, _), sc2_m239(v226).
sc2_m273(n) :- child(v240, n, _), node(_, v240, "keyword_argument", _, _), child(v241, v240, _), node(_, v241, "argument_list", _, _), child(v242, v241, _), sc2_m255(v242).
sc2_m273(n) :- node(_, n, "assignment", _, _), inside(n, v256, sc2_k0), node(_, v256, "function_definition", _, _), field(v256, "name", v257), node(_, v257, "identifier", _, _), text(v257, v258), v258 = "compile", field(n, "left", v259), sc2_m260(v259).
sc2_m273(n) :- child(v261, n, _), node(_, v261, "assignment", _, _), inside(v261, v262, sc2_k0), node(_, v262, "function_definition", _, _), field(v262, "name", v263), node(_, v263, "identifier", _, _), text(v263, v264), v264 = "compile", field(v261, "left", v265), sc2_m266(v265).
sc2_m273(n) :- node(_, n, "attribute", _, _), field(n, "attribute", v267), node(_, v267, "identifier", _, _), text(v267, v268), (v268 = "_conn" ; v268 = "_serverplan_runtime_txn" ; v268 = "_serverplan_sql_conn" ; v268 = "_txn" ; v268 = "conn" ; v268 = "sql_conn" ; v268 = "txn"), inside(n, v269, sc2_k0), node(_, v269, "function_definition", _, _), inside(v269, v270, sc2_k0), node(_, v270, "function_definition", _, _), field(v270, "name", v271), node(_, v271, "identifier", _, _), text(v271, v272), v272 = "compile".
sc2_selected(n) :- sc2_m273(n).
sc2_functions(d, f, x) :- sc2_selected(f), node(d, f, "function_definition", _, _), field(f, "name", nm), text(nm, x).
sc2_ownership(f, f) :- sc2_selected(f), node(_, f, "function_definition", _, _).
sc2_ownership(n, f) :- sc2_selected(n), node(_, n, _, _, _), !sc2_is_function(n), nearest(n, f, sc2_k_fn).
sc2_is_function(n) :- node(_, n, "function_definition", _, _).
sc2_attribute_name(a, x) :- sc2_selected(a), node(_, a, "attribute", _, _), field(a, "attribute", ax), text(ax, x).
sc2_attributes(a, x, ot) :- sc2_attribute_name(a, x), field(a, "object", o), sps_text(o, ot).
sc2_calls(d, c, f) :- sc2_selected(c), node(d, c, "call", _, _), field(c, "function", f), sc2_selected(f), node(d, f, _, _, _).
sc2_is_attribute(n) :- node(_, n, "attribute", _, _).
sc2_calls_full(c, s) :- sc2_calls(_, c, f), sps_text(f, s).
sc2_calls_callee(c, x) :- sc2_calls(_, c, f), sc2_attribute_name(f, x).
sc2_calls_callee(c, s) :- sc2_calls(_, c, f), !sc2_is_attribute(f), sps_text(f, s).
sc2_non_argument(a) :- node(_, a, "comment", _, _).
sc2_non_argument(a) :- node(_, a, "keyword_argument", _, _).
sc2_non_argument(a) :- node(_, a, "list_splat", _, _).
sc2_non_argument(a) :- node(_, a, "dictionary_splat", _, _).
sc2_argument_row(c, a, s) :- sc2_calls(d, c, _), field(c, "arguments", l), child(l, a, _), sc2_selected(a), node(d, a, _, s, _), !sc2_non_argument(a).
sc2_argument_before(c, a, b) :- sc2_argument_row(c, a, s), sc2_argument_row(c, b, s2), s2 < s.
sc2_argument_later(c, a) :- sc2_argument_before(c, a, _).
sc2_arguments(c, a, 0) :- sc2_argument_row(c, a, _), !sc2_argument_later(c, a).
sc2_arguments(c, a, i) :- sc2_argument_later(c, a), i = count : { sc2_argument_before(c, a, _) }.
sc2_keywords(c, k, x, v) :- sc2_calls(d, c, _), field(c, "arguments", l), child(l, k, _), sc2_selected(k), node(d, k, "keyword_argument", _, _), field(k, "name", kn), sc2_selected(kn), node(d, kn, _, _, _), text(kn, x), field(k, "value", v), sc2_selected(v), node(d, v, _, _, _).
sc2_step_base(b) :- sps_text(b, s), match("(?:[A-Za-z_]\\w*\\.)*ServerPlanStep(?:\\[.*\\])?", s).
sc2_step_classes(c) :- sc2_selected(c), node(d, c, "class_definition", _, _), child(c, args, _), sc2_selected(args), node(d, args, "argument_list", _, _), child(args, b, _), sc2_selected(b), node(d, b, _, _, _), sc2_step_base(b).
sc2_step_methods(f, x) :- sc2_functions(_, f, x), child(b, f, _), field(c, "body", b), sc2_step_classes(c).
sc2_step_methods(f, x) :- sc2_functions(d, f, x), child(dd, f, _), sc2_selected(dd), node(d, dd, "decorated_definition", _, _), child(b, dd, _), field(c, "body", b), sc2_step_classes(c).
sc2_compile(d, m, s, e) :- sc2_step_methods(m, "compile"), node(d, m, _, s, e).
sc2_compiled(d, c, s, e) :- sc2_calls(d, c, _), sc2_calls_full(c, "CompiledStep"), node(d, c, _, s, e).
sc2_assignments(a, l) :- sc2_selected(a), node(d, a, "assignment", _, _), field(a, "left", l), sc2_selected(l), node(d, l, _, _, _).
sc2_assignments_value(a, r) :- sc2_assignments(a, _), field(a, "right", r), sc2_selected(r).
sc2_compile_aliases(m, x) :- sc2_compile(_, m, _, _), sc2_assignments(a, l), node(_, l, "identifier", _, _), sc2_ownership(a, m), text(l, x), sc2_assignments_value(a, v), sc2_attributes(v, at, "self"), prefix("_", at).
sc2_newer_function(f, m) :- sc2_compile(d, m, _, me), sc2_functions(d, f, x), node(d, f, _, fs, _), sc2_functions(d, g, x), node(d, g, _, gs, ge), gs > fs, ge <= me.
sc2_callback_links(m, k, kw, f) :- sc2_compile(d, m, ms, me), sc2_compiled(d, c, cs, ce), cs > ms, ce <= me, sc2_ownership(c, m), sc2_keywords(c, k, kw, v), sc2_callback_keyword(kw), node(_, v, "identifier", _, _), text(v, x), sc2_functions(d, f, x), node(d, f, _, fs, fe), fs > ms, fe <= me, !sc2_newer_function(f, m).
sc2_parameter_row(f, p, x, s) :- sc2_functions(d, f, _), field(f, "parameters", ps), child(ps, p, _), sc2_selected(p), node(d, p, "identifier", s, _), text(p, x).
sc2_parameter_row(f, p, x, s) :- sc2_functions(d, f, _), field(f, "parameters", ps), child(ps, p, _), sc2_selected(p), node(d, p, k, s, _), sc2_parameter_kind(k), child(p, n, 0), sc2_selected(n), node(d, n, "identifier", _, _), text(n, x).
sc2_parameter_before(f, p, q) :- sc2_parameter_row(f, p, _, s), sc2_parameter_row(f, q, _, s2), s2 < s.
sc2_parameter_later(f, p) :- sc2_parameter_before(f, p, _).
sc2_parameters(f, p, x, 0) :- sc2_parameter_row(f, p, x, _), !sc2_parameter_later(f, p).
sc2_parameters(f, p, x, i) :- sc2_parameter_row(f, p, x, _), sc2_parameter_later(f, p), i = count : { sc2_parameter_before(f, p, _) }.
sc2_authority_type(s) :- sc2_type_word(s), s != "Hydrator".
sc2_type_names(t, s) :- sc2_selected(x), node(_, x, "identifier", _, _), text(x, s), sc2_type_word(s), inside(x, t, sc2_k_type), sc2_selected(t).
sc2_authority_parameters(f, x) :- sc2_parameters(f, p, x, _), field(p, "type", t), sc2_type_names(t, s), sc2_authority_type(s).
sc2_authority_returns(d, x) :- sc2_functions(d, f, x), field(f, "return_type", t), sc2_type_names(t, s), sc2_authority_type(s).
sc2_callback_carriers(k, x) :- sc2_callback_links(_, k, kw, f), sc2_post_op_keyword(kw), sc2_parameters(f, _, x, 1).
sc2_callback_carriers(k, x) :- sc2_callback_links(_, k, _, f), sc2_parameters(f, p, x, _), field(p, "type", t), sc2_type_names(t, "Hydrator").
sc2_trimmed_carrier(a) :- sc2_arguments(_, a, 1), sps_text(a, s), match("[\"']*(?:_conn|_serverplan_runtime_txn|_serverplan_sql_conn|_txn|conn|sql_conn|txn)[\"']*", s).
sc2_bad_callback_nodes(k, n) :- sc2_callback_links(_, k, _, f), sc2_ownership(n, f), sc2_attributes(n, at, ot), sc2_carrier_attr(at), sc2_callback_carriers(k, ot).
sc2_bad_callback_nodes(k, n) :- sc2_callback_links(_, k, _, f), sc2_ownership(n, f), sc2_calls(_, n, ce), node(_, ce, "identifier", _, _), sc2_calls_callee(n, "active_pipeline_txn_for_callbacks").
sc2_bad_callback_nodes(k, n) :- sc2_callback_links(_, k, _, f), sc2_ownership(n, f), sc2_calls(d, n, ce), node(_, ce, "identifier", _, _), sc2_calls_callee(n, x), sc2_authority_returns(d, x).
sc2_bad_callback_nodes(k, n) :- sc2_callback_links(_, k, _, f), sc2_ownership(n, f), sc2_calls(_, n, _), sc2_arguments(n, a, _), node(_, a, "identifier", _, _), text(a, x), sc2_authority_parameters(f, x).
sc2_bad_callback_nodes(k, n) :- sc2_callback_links(_, k, _, f), sc2_ownership(n, f), sc2_calls_full(n, "getattr"), sc2_arguments(n, a0, 0), node(_, a0, "identifier", _, _), text(a0, x), sc2_callback_carriers(k, x), sc2_arguments(n, a1, 1), sc2_trimmed_carrier(a1).
sc2_postop_callbacks(m, f) :- sc2_compile(d, m, ms, me), sc2_functions(d, f, x), node(d, f, _, fs, fe), fs > ms, fe <= me, x != "on_commit", x != "on_rollback".
sc2_postop_nodes(m, n) :- sc2_postop_callbacks(m, f), inside(n, f, sc2_k_fn), sc2_selected(n).
sc2_bad_span(k, n, s, e) :- sc2_bad_callback_nodes(k, n), node(_, n, _, s, e).
sc2_bad_shadowed(k, n) :- sc2_bad_span(k, n, s, _), sc2_bad_span(k, _, s2, _), s2 < s.
sc2_bad_shadowed(k, n) :- sc2_bad_span(k, n, s, e), sc2_bad_span(k, _, s, e2), e2 > e.
violation("data-layer-serverplan-steps", "step-contracts-2", "STEP-026", p, l) :- sc2_bad_callback_nodes(k, n), !sc2_bad_shadowed(k, n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l), sps_on("check_compile_callbacks_no_runtime_authority").
sc2_step019(n) :- sc2_postop_nodes(m, n), sc2_assignments(n, t), sc2_attributes(t, _, o), sc2_compile_aliases(m, o).
sc2_step019(n) :- sc2_postop_nodes(m, n), sc2_calls(_, n, ci), sc2_calls_callee(n, x), sc2_model_mutator(x), sc2_attributes(ci, _, o), sc2_compile_aliases(m, o).
sc2_step019(n) :- sc2_postop_nodes(m, n), sc2_calls(_, n, ce), node(_, ce, "attribute", _, _), sc2_calls_callee(n, "__setattr__"), sc2_arguments(n, a, 0), node(_, a, "identifier", _, _), text(a, x), sc2_compile_aliases(m, x).
violation("data-layer-serverplan-steps", "step-contracts-2", "STEP-019", p, l) :- sc2_step019(n), node(d, n, _, _, _), in_scope(d), !tape_syntax_error(d), !out_scope(d), doc(d, p, _), line(n, l), sps_on("check_postop_no_resolved_data_manipulation").
