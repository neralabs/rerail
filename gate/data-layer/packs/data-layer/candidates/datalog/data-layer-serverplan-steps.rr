sc1_m172(n) :- child(v136, n, _), node(_, v136, "keyword_argument", _, _), child(v137, v136, _), node(_, v137, "argument_list", _, _), child(v138, v137, _), node(_, v138, "call", _, _), field(v138, "function", v139), sc1_m143(v139).
sc1_m172(n) :- child(v144, n, _), sc1_m145(v144), field(v146, "value", v144), node(_, v146, "keyword_argument", _, _), child(v147, v146, _), node(_, v147, "argument_list", _, _), child(v148, v147, _), node(_, v148, "call", _, _), field(v148, "function", v149), sc1_m153(v149).
sc1_m172(n) :- node(_, n, "call", _, _), field(n, "function", v154), sc1_m158(v154).
