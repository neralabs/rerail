in_scope(d) :- doc(d, p, _), glob("l9850_workflow/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9875_mcp/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9900_auto_api/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
unreachable_doc(d, p, m) :- doc(d, p, _), in_scope(d), !out_scope(d), !syntax_error(d), m = @rx_replace(@rx_replace(p, "/__init__\\.py$|\\.py$", ""), "/", ".").
unreachable_fn(f, d, x) :- node(d, f, "function_definition", _, _), unreachable_doc(d, _, _), !inside(f, _, unreachable_fdef), field(f, "name", n), text(n, x).
unreachable_fn_class(f, c, cx) :- unreachable_fn(f, _, _), nearest(f, c, unreachable_cdef), field(c, "name", n), text(n, cx).
unreachable_cls(c, d, x) :- node(d, c, "class_definition", _, _), unreachable_doc(d, _, _), field(c, "name", n), text(n, x).
unreachable_deco(o, x) :- unreachable_deco_at(o, d, l, c), tape_line(d, l, sp), match_group("@\\s*(?P<n>[^\\s(]+)", sp, m, "n", g), col(m, c), text(g, x).
unreachable_deco_at(o, d, l, c) :- node(d, dd, "decorated_definition", _, _), field(dd, "definition", o), child(dd, dc, _), node(_, dc, "decorator", _, _), line(dc, l), col(dc, c).
unreachable_inv(id, f, d, x, "function", m, fq) :- unreachable_fn(f, d, x), !unreachable_fn_class(f, _, _), unreachable_doc(d, _, m), id = @concat(m, @concat("::", x)), fq = @concat(m, @concat(".", x)).
unreachable_inv(id, f, d, x, "method", m, fq) :- unreachable_fn(f, d, x), unreachable_fn_class(f, _, cx), unreachable_doc(d, _, m), id = @concat(m, @concat("::", @concat(cx, @concat(".", x)))), fq = @concat(m, @concat(".", @concat(cx, @concat(".", x)))).
unreachable_inv(id, c, d, x, "class", m, fq) :- unreachable_cls(c, d, x), unreachable_doc(d, _, m), id = @concat(m, @concat("::", x)), fq = @concat(m, @concat(".", x)).
unreachable_inv_start(id, s) :- unreachable_inv(id, x, _, _, _, _, _), node(_, x, _, s, _).
unreachable_last(id, s) :- unreachable_inv_start(id, _), s = max t : { unreachable_inv_start(id, t) }.
unreachable_decl(id, x, d, n, k, m, fq) :- unreachable_inv(id, x, d, n, k, m, fq), node(_, x, _, s, _), unreachable_last(id, s).
unreachable_decl_class(id, cx) :- unreachable_decl(id, x, _, _, "method", _, _), unreachable_fn_class(x, _, cx).
unreachable_decl_node(x, id) :- unreachable_decl(id, x, _, _, _, _, _).
unreachable_fq(fq, id) :- unreachable_decl(id, _, _, _, _, _, fq).
unreachable_method(m, cx, n, id) :- unreachable_decl(id, _, _, n, "method", m, _), unreachable_decl_class(id, cx).
unreachable_param(p, f, p) :- unreachable_fn(f, _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "identifier", _, _).
unreachable_param(p, f, n) :- unreachable_fn(f, _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_parameter", _, _), child(p, n, _), node(_, n, "identifier", _, _).
unreachable_param(p, f, n) :- unreachable_fn(f, _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "default_parameter", _, _), field(p, "name", n).
unreachable_param(p, f, n) :- unreachable_fn(f, _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_default_parameter", _, _), field(p, "name", n).
unreachable_param_ok(p, f, x) :- unreachable_param(p, f, n), text(n, x), !unreachable_positional(p).
unreachable_positional(p) :- unreachable_param(p, _, _), child(ps, p, i), child(ps, s, j), node(_, s, "positional_separator", _, _), j > i.
unreachable_parameter(p, id) :- unreachable_param_ok(p, f, _), unreachable_decl(id, f, _, _, "function", _, _).
unreachable_parameter(p, id) :- unreachable_param_ok(p, f, x), unreachable_decl(id, f, _, _, "method", _, _), x != "self", x != "cls".
unreachable_ann(id, x) :- unreachable_decl(id, f, _, _, k, _, _), k != "class", field(f, "return_type", t), node(_, i, "identifier", _, _), inside(i, t, unreachable_ann_k), text(i, x).
unreachable_ann(id, x) :- unreachable_decl(id, f, _, _, k, _, _), k != "class", field(f, "return_type", t), node(_, t, "identifier", _, _), text(t, x).
unreachable_ann(id, x) :- unreachable_parameter(p, id), field(p, "type", t), node(_, i, "identifier", _, _), inside(i, t, unreachable_ann_k), text(i, x).
unreachable_ann(id, x) :- unreachable_parameter(p, id), field(p, "type", t), node(_, t, "identifier", _, _), text(t, x).
unreachable_item(i, d, o, x) :- unreachable_import_stmt(i, d), field(i, "name", x), node(_, x, "dotted_name", _, _), name(x, o).
unreachable_item(i, d, o, x) :- unreachable_import_stmt(i, d), field(i, "name", x), node(_, x, "aliased_import", _, _), field(x, "name", dn), name(dn, o).
unreachable_import_stmt(i, d) :- node(d, i, "import_statement", _, _), unreachable_doc(d, _, _).
unreachable_import_stmt(i, d) :- node(d, i, "import_from_statement", _, _), unreachable_doc(d, _, _).
unreachable_alias(x, a) :- unreachable_item(_, _, _, x), node(_, x, "aliased_import", _, _), field(x, "alias", n), text(n, a).
unreachable_abs_base(i, b) :- node(_, i, "import_from_statement", _, _), field(i, "module_name", m), node(_, m, "dotted_name", _, _), name(m, b).
unreachable_rel_base(i, k, rest) :- unreachable_dots(i, dots), k = @strlen(dots), field(i, "module_name", r), unreachable_rel_rest(r, rest).
unreachable_dots(i, dots) :- node(_, i, "import_from_statement", _, _), field(i, "module_name", r), node(_, r, "relative_import", _, _), child(r, ip, _), node(_, ip, "import_prefix", _, _), node_text(ip, dots).
unreachable_rel_rest(r, rest) :- node(_, r, "relative_import", _, _), child(r, m, _), node(_, m, "dotted_name", _, _), name(m, rest).
unreachable_rel_rest(r, "") :- node(_, r, "relative_import", _, _), !unreachable_rel_dotted(r).
unreachable_rel_dotted(r) :- node(_, r, "relative_import", _, _), child(r, m, _), node(_, m, "dotted_name", _, _).
unreachable_init(p) :- unreachable_doc(_, p, _), match("(?s).*/..[iI][nN][iI][tT]..\\.[pP][yY]", p).
unreachable_pkg0(i, m) :- unreachable_rel_base(i, _, _), node(d, i, _, _, _), unreachable_doc(d, p, m), unreachable_init(p).
unreachable_pkg0(i, q) :- unreachable_rel_base(i, _, _), node(d, i, _, _, _), unreachable_doc(d, p, m), !unreachable_init(p), q = @rx_replace(m, "\\.?[^.]+$", "").
unreachable_up(i, left, p) :- unreachable_pkg0(i, p), unreachable_dots(i, dots), left = @substr(dots, 1, @sub(@strlen(dots), 1)).
unreachable_up(i, left2, q) :- unreachable_up(i, left, p), left != "", left2 = @substr(left, 1, @sub(@strlen(left), 1)), q = @substr(p, 0, @strlen(@rx_replace(p, "\\.?[^.]+$", ""))).
unreachable_prefix(i, p) :- unreachable_up(i, "", p).
unreachable_imp_c(i, d, m, a, o, "module") :- node(_, i, "import_statement", _, _), unreachable_item(i, d, o, x), unreachable_doc(d, _, m), unreachable_alias(x, a).
unreachable_imp_c(i, d, m, n, o, "module") :- node(_, i, "import_statement", _, _), unreachable_item(i, d, o, x), unreachable_doc(d, _, m), !unreachable_alias(x, _), unreachable_first(o, n).
unreachable_imp_c(i, d, m, n, t, "symbol") :- unreachable_abs_base(i, b), unreachable_item(i, d, o, x), unreachable_doc(d, _, m), t = @concat(b, @concat(".", o)), unreachable_item_name(x, o, n).
unreachable_imp_c(i, d, m, n, t, "symbol") :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, d, o, x), unreachable_doc(d, _, m), unreachable_join(p, rest, o, t), unreachable_item_name(x, o, n).
unreachable_item_name(x, o, a) :- unreachable_item(_, _, o, x), unreachable_alias(x, a).
unreachable_item_name(x, o, o) :- unreachable_item(_, _, o, x), !unreachable_alias(x, _).
unreachable_join(p, rest, o, t) :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, _, o, _), p != "", rest != "", t = @concat(p, @concat(".", @concat(rest, @concat(".", o)))).
unreachable_join(p, rest, o, t) :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, _, o, _), p = "", rest != "", t = @concat(rest, @concat(".", o)).
unreachable_join(p, rest, o, t) :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, _, o, _), p != "", rest = "", t = @concat(p, @concat(".", o)).
unreachable_join(p, rest, o, o) :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, _, o, _), p = "", rest = "".
unreachable_first(o, o) :- unreachable_item(_, _, o, _), !contains(".", o).
unreachable_first(o, n) :- unreachable_item(_, _, o, _), o = @dot(n, r), !contains(".", n).
unreachable_imp_s(m, n, k, s) :- unreachable_imp_c(i, _, m, n, _, k), node(_, i, _, s, _).
unreachable_imp_last(m, n, k, s) :- unreachable_imp_s(m, n, k, _), s = max t : { unreachable_imp_s(m, n, k, t) }.
unreachable_import(i, d, m, n, t, k) :- unreachable_imp_c(i, d, m, n, t, k), node(_, i, _, s, _), unreachable_imp_last(m, n, k, s).
unreachable_imported_fq(t) :- unreachable_import(_, _, _, _, t, "symbol").
unreachable_resolved(fq, id) :- unreachable_fq(fq, id).
unreachable_resolved(fq, id) :- unreachable_resolved(t, id), unreachable_import(_, _, m, n, t, "symbol"), fq = @concat(m, @concat(".", n)), !unreachable_fq(fq, _).
unreachable_raw_base(c, b) :- unreachable_cls(c, _, _), field(c, "superclasses", al), child(al, b, _), node(_, b, k, _, _), unreachable_base_k(k).
unreachable_base_text(c, s) :- unreachable_raw_base(c, b), node_text(b, s).
unreachable_base_name_of(b, x) :- unreachable_raw_base(_, b), node_text(b, s), x = @rx_replace(@rx_replace(@rx_replace(s, "(?s)\\[.*$", ""), "^.*\\.", ""), "^ +| +$", "").
unreachable_bname(id, m, bn, s) :- unreachable_raw_base(c, b), unreachable_decl(id, c, _, _, "class", m, _), unreachable_base_name_of(b, bn), node(_, b, _, s, _).
unreachable_class_named(n, id) :- unreachable_decl(id, _, _, n, "class", _, _).
unreachable_unique_class(n, id) :- unreachable_class_named(n, id), k = count : { unreachable_class_named(n, _) }, k = 1.
unreachable_has_bi(id, bn) :- unreachable_bname(id, m, bn, _), unreachable_import(_, _, m, bn, t, "symbol"), unreachable_decl(_, _, _, _, "class", _, t).
unreachable_has_bm(id, bn) :- unreachable_bname(id, m, bn, _), unreachable_decl(_, _, _, bn, "class", m, _).
unreachable_base_edge(id, b, s) :- unreachable_bname(id, m, bn, s), unreachable_import(_, _, m, bn, t, "symbol"), unreachable_decl(b, _, _, _, "class", _, t).
unreachable_base_edge(id, b, s) :- unreachable_bname(id, m, bn, s), !unreachable_has_bi(id, bn), unreachable_decl(b, _, _, bn, "class", m, _).
unreachable_base_edge(id, b, s) :- unreachable_bname(id, _, bn, s), !unreachable_has_bi(id, bn), !unreachable_has_bm(id, bn), unreachable_unique_class(bn, b).
unreachable_reach(id, id) :- unreachable_decl(id, _, _, _, "class", _, _).
unreachable_reach(o, b) :- unreachable_reach(o, x), unreachable_base_edge(x, b, _).
rr_ctx2(x) :- unreachable_reach(o, b), unreachable_decl_node(x, b).
rr_agg1(c, o, x, y) :- rr_ctx2(x), unreachable_reach(o, c), unreachable_decl_node(y, c), y <= x.
unreachable_hops(o, k) :- unreachable_reach(o, b), unreachable_decl_node(x, b), k = count : { rr_agg1(_, o, x, _) }.
unreachable_hier_l(id, id, 0) :- unreachable_decl(id, _, _, _, "class", _, _).
unreachable_hier_l(o, b, j) :- unreachable_hier_l(o, x, i), unreachable_base_edge(x, b, _), unreachable_hops(o, j), j = @add(i, 1).
unreachable_hier_d(o, b, k) :- unreachable_hier_l(o, b, _), k = min j : { unreachable_hier_l(o, b, j) }.
unreachable_property(x) :- unreachable_deco(x, n), (suffix("property", n) ; suffix(".setter", n) ; suffix(".deleter", n)).
unreachable_pub(c, n, id) :- unreachable_decl(c, _, _, cn, _, cm, _), unreachable_decl(id, x, _, n, "method", cm, _), unreachable_decl_class(id, cn), !prefix("_", n), !unreachable_excluded(n), !unreachable_property(x).
rr_agg3(j, n, o) :- unreachable_hier_d(o, c2, j), unreachable_pub(c2, n, _).
unreachable_pdist(o, n, k) :- unreachable_hier_d(o, c, _), unreachable_pub(c, n, _), k = min j : { rr_agg3(j, n, o) }.
unreachable_next_c(x, n, k, y, ord) :- unreachable_pdist(x, n, k), k > 0, unreachable_base_edge(x, y, ord), rr_t4 = @sub(k, 1), unreachable_pdist(y, n, rr_t4).
unreachable_next_min(x, n, k, m) :- unreachable_next_c(x, n, k, _, _), m = min q : { unreachable_next_c(x, n, k, _, q) }.
unreachable_next(x, n, k, y) :- unreachable_next_min(x, n, k, m), unreachable_next_c(x, n, k, y, m).
unreachable_walk(o, n, o) :- unreachable_pdist(o, n, _).
unreachable_walk(o, n, y) :- unreachable_walk(o, n, x), unreachable_pdist(x, n, k), unreachable_next(x, n, k, y).
unreachable_public(o, n, id) :- unreachable_walk(o, n, c), unreachable_pdist(c, n, 0), unreachable_pub(c, n, id).
unreachable_all(a, d) :- node(d, a, "assignment", _, _), unreachable_doc(d, p, _), match("data_layer/[^/]+\\.py", p), field(a, "left", l), node(_, l, "identifier", _, _), text(l, "__all__"), child(e, a, _), node(_, e, "expression_statement", _, _), !inside(a, _, unreachable_nest_k).
unreachable_all_start(d, s) :- unreachable_all(a, d), node(_, a, _, s, _).
unreachable_first_all(d, a) :- unreachable_all(a, d), node(_, a, _, s, _), s = min t : { unreachable_all_start(d, t) }.
unreachable_all_array(a, r) :- unreachable_all(a, _), field(a, "right", r), node(_, r, "list", _, _).
unreachable_all_array(a, r) :- unreachable_all(a, _), field(a, "right", r), node(_, r, "tuple", _, _).
unreachable_all_name(a, n) :- unreachable_all_array(a, r), child(r, v, _), node(_, v, "string", _, _), value(v, n).
unreachable_all_name(a, n) :- unreachable_all_array(a, r), child(r, v, _), node(_, v, "concatenated_string", _, _), value(v, n).
unreachable_export(d, n, t) :- unreachable_import(i, d, _, n, t, "symbol"), child(mo, i, _), node(_, mo, "module", _, _), unreachable_doc(d, p, _), match("data_layer/[^/]+\\.py", p).
unreachable_export(d, n, fq) :- unreachable_decl(_, _, d, n, k, _, fq), k != "method", unreachable_doc(d, p, _), match("data_layer/[^/]+\\.py", p).
unreachable_has_all(d) :- unreachable_first_all(d, _).
unreachable_exported(id) :- unreachable_export(d, n, t), unreachable_resolved(t, id), !prefix("_", n), !unreachable_has_all(d).
unreachable_exported(id) :- unreachable_export(d, n, t), unreachable_resolved(t, id), !prefix("_", n), unreachable_first_all(d, a), unreachable_all_name(a, n).
unreachable_base_name(id, b) :- unreachable_decl(id, _, _, n, _, _, _), suffix("_async", n), b = @substr(n, 0, @sub(@strlen(n), 6)).
unreachable_base_name(id, b) :- unreachable_decl(id, _, _, n, _, _, _), suffix("_lazy", n), b = @substr(n, 0, @sub(@strlen(n), 5)).
unreachable_base_name(id, n) :- unreachable_decl(id, _, _, n, _, _, _), !suffix("_async", n), !suffix("_lazy", n).
unreachable_class_id(id, cid) :- unreachable_decl_class(id, cx), unreachable_decl(id, _, _, _, _, m, _), cid = @concat(m, @concat("::", cx)).
unreachable_abstract(id) :- unreachable_decl(id, x, _, _, "class", _, _), unreachable_base_text(x, s), contains("ABC", s).
unreachable_abstract(id) :- unreachable_decl(id, x, _, _, k, _, _), k != "class", unreachable_deco(x, n), suffix("abstractmethod", n).
unreachable_is_property(id) :- unreachable_decl(id, x, _, _, _, _, _), unreachable_property(x).
unreachable_implicit(id) :- unreachable_decl(id, _, _, n, _, _, _), match("__.*__", n).
unreachable_implicit(id) :- unreachable_decl(id, _, _, n, _, _, _), (n = "main" ; n = "pytest_configure" ; n = "pytest_collection_modifyitems").
unreachable_implicit(id) :- unreachable_decl(id, x, _, _, _, _, _), unreachable_deco(x, n), (suffix("validator", n) ; suffix("overload", n)).
unreachable_structural(id) :- unreachable_decl(id, x, _, _, _, _, _), unreachable_base_text(x, s), contains("Protocol", s).
unreachable_protocol(id) :- unreachable_structural(id).
unreachable_protocol(id) :- unreachable_decl(id, _, _, n, _, _, _), suffix("Protocol", n).
unreachable_annotated(m, n) :- unreachable_ann(id, n), unreachable_decl(id, _, _, _, _, m, _).
unreachable_cn_import(m, n, c) :- unreachable_annotated(m, n), unreachable_import(_, _, m, n, t, "symbol"), unreachable_resolved(t, c), unreachable_decl(c, _, _, _, "class", _, _).
unreachable_has_cn_import(m, n) :- unreachable_cn_import(m, n, _).
unreachable_class_names(m, n, c) :- unreachable_cn_import(m, n, c).
unreachable_class_names(m, n, c) :- unreachable_annotated(m, n), !unreachable_has_cn_import(m, n), unreachable_decl(c, _, _, n, "class", m, _).
unreachable_params(ps) :- node(_, ps, "parameters", _, _).
unreachable_params(ps) :- node(_, ps, "lambda_parameters", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, n, _), node(_, n, "identifier", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, n, _), node(_, n, "identifier", _, _), node(_, p, "typed_parameter", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, n, _), node(_, n, "identifier", _, _), node(_, p, "list_splat_pattern", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, n, _), node(_, n, "identifier", _, _), node(_, p, "dictionary_splat_pattern", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, s, _), node(_, s, "list_splat_pattern", _, _), child(s, n, _), node(_, n, "identifier", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, s, _), node(_, s, "dictionary_splat_pattern", _, _), child(s, n, _), node(_, n, "identifier", _, _).
unreachable_param_name(n) :- node(_, p, "default_parameter", _, _), field(p, "name", n).
unreachable_param_name(n) :- node(_, p, "typed_default_parameter", _, _), field(p, "name", n).
unreachable_not_word(w) :- node(_, w, "identifier", _, _), inside(w, _, unreachable_imports_k).
unreachable_not_word(w) :- node(_, a, "attribute", _, _), field(a, "attribute", w).
unreachable_not_word(w) :- node(_, a, "keyword_argument", _, _), field(a, "name", w).
unreachable_not_word(w) :- node(_, a, "function_definition", _, _), field(a, "name", w).
unreachable_not_word(w) :- node(_, a, "class_definition", _, _), field(a, "name", w).
unreachable_not_word(w) :- unreachable_param_name(w).
unreachable_in_fbody(w) :- node(_, w, "identifier", _, _), inside(w, b, unreachable_body_k), field(f, "body", b), node(_, f, "function_definition", _, _).
unreachable_nested(c) :- node(_, c, "class_definition", _, _), inside(c, _, unreachable_cdef), !inside(c, _, unreachable_fdef).
unreachable_control(s) :- node(_, mo, "module", _, _), child(mo, s, _), !unreachable_def_node(s).
unreachable_def_node(s) :- node(_, s, "class_definition", _, _).
unreachable_def_node(s) :- node(_, s, "function_definition", _, _).
unreachable_def_node(s) :- node(_, s, "decorated_definition", _, _).
unreachable_word(w, d, x) :- node(d, w, "identifier", _, _), unreachable_doc(d, _, _), !unreachable_not_word(w), text(w, x).
unreachable_word_ok(w) :- unreachable_word(w, _, _), !unreachable_in_fbody(w).
unreachable_word_ok(w) :- unreachable_word(w, _, _), unreachable_nested(c), inside(w, c, unreachable_cdef).
unreachable_word_ok(w) :- unreachable_word(w, _, _), unreachable_control(s), inside(w, s, unreachable_any_k).
unreachable_dec(w, dd, x, k) :- unreachable_word(w, _, _), inside(w, dd, unreachable_dd_k), field(dd, "definition", x), node(_, x, k, _, _).
unreachable_dec_start(w, k, s) :- unreachable_dec(w, dd, _, k), node(_, dd, _, s, _).
unreachable_dec_near(w, x, k) :- unreachable_dec(w, dd, x, k), node(_, dd, _, s, _), s = max t : { unreachable_dec_start(w, k, t) }.
unreachable_w_fn(w, f) :- unreachable_word(w, _, _), nearest(w, f, unreachable_fdef).
unreachable_w_cls(w) :- unreachable_word(w, _, _), inside(w, _, unreachable_cdef).
unreachable_w_cbody(w) :- unreachable_word(w, _, _), inside(w, b, unreachable_body_k), field(c, "body", b), node(_, c, "class_definition", _, _).
unreachable_w_default(w) :- unreachable_word(w, _, _), inside(w, p, unreachable_default_k), field(p, "value", v), node(d, w, _, ws, we), node(d, v, _, vs, ve), vs <= ws, we <= ve.
unreachable_w_nested(w) :- unreachable_word(w, _, _), unreachable_nested(c), inside(w, c, unreachable_cdef).
unreachable_w_control(w) :- unreachable_word(w, _, _), unreachable_control(s), inside(w, s, unreachable_any_k).
unreachable_header_method(f) :- unreachable_fn_class(f, _, _).
unreachable_w_keep(w) :- unreachable_w_control(w).
unreachable_w_keep(w) :- unreachable_w_nested(w).
unreachable_w_keep(w) :- unreachable_w_dfn_ok(w), unreachable_w_dcls_ok(w), unreachable_w_cls_ok(w), unreachable_w_fn_ok(w).
unreachable_w_dfn_ok(w) :- unreachable_word(w, _, _), !unreachable_dec_near(w, _, "function_definition").
unreachable_w_dfn_ok(w) :- unreachable_dec_near(w, f, "function_definition"), unreachable_header_method(f).
unreachable_w_dcls_ok(w) :- unreachable_word(w, _, _), !unreachable_dec_near(w, _, "class_definition").
unreachable_w_dcls_ok(w) :- unreachable_word(w, _, _), unreachable_w_cbody(w).
unreachable_w_cls_ok(w) :- unreachable_word(w, _, _), !unreachable_w_cls(w).
unreachable_w_cls_ok(w) :- unreachable_w_cbody(w).
unreachable_w_fn_ok(w) :- unreachable_word(w, _, _), !unreachable_w_fn(w, _).
unreachable_w_fn_ok(w) :- unreachable_w_fn(w, f), unreachable_w_default(w), unreachable_header_method(f).
unreachable_module_names(m, x) :- unreachable_word_ok(w), unreachable_w_keep(w), unreachable_word(w, d, x), unreachable_doc(d, _, m).
unreachable_imported_module(t) :- unreachable_import(_, _, _, _, t, "module").
unreachable_imported_module(p) :- unreachable_import(_, _, _, _, t, "symbol"), t = @dot(p, x), !contains(".", x).
unreachable_imported_modules(m) :- unreachable_imported_module(m), m != "".
unreachable_imported_modules(q) :- unreachable_imported_module(m), m = @dot(q, rest), rest != "", q != "".
unreachable_root(s) :- unreachable_exported(s).
unreachable_root(s) :- unreachable_public(o, _, s), unreachable_exported(o).
unreachable_root(s) :- unreachable_imported_modules(m), s = @concat("@module:", m).
unreachable_dyn(d, fq) :- unreachable_dyn_at(d, fq, lm, _), unreachable_dyn_module(d, l0, _), lm > l0.
unreachable_dyn(d, fq) :- unreachable_dyn_at(d, fq, l0, cm), unreachable_dyn_module(d, l0, c0), cm >= c0.
unreachable_dyn_module(d, l, c) :- !option_on("oracleAnalyzer"), unreachable_doc(d, _, _), node(d, mo, "module", _, _), line(mo, l), col(mo, c).
unreachable_dyn_at(d, fq, l, c) :- unreachable_dyn_module(d, _, _), source(d, sp), match_group("(?:\\bimport_module|\\bload_python_module|\\bimportlib\\.import_module)\\(\\s*['\"](?P<module>[^'\"]+)['\"]\\s*\\)\\.(?P<attr>[A-Za-z_][A-Za-z0-9_]*)", sp, m, "module", gm), match_group("(?:\\bimport_module|\\bload_python_module|\\bimportlib\\.import_module)\\(\\s*['\"](?P<module>[^'\"]+)['\"]\\s*\\)\\.(?P<attr>[A-Za-z_][A-Za-z0-9_]*)", sp, m, "attr", ga), line(m, l), col(m, c), text(gm, mn), text(ga, an), fq = @concat(mn, @concat(".", an)).
unreachable_root(s) :- unreachable_dyn(_, fq), unreachable_resolved(fq, s).
unreachable_sibling(b, b) :- unreachable_base_name(_, b).
unreachable_sibling(b, n) :- unreachable_base_name(_, b), n = @concat(b, "_async").
unreachable_sibling(b, n) :- unreachable_base_name(_, b), n = @concat(b, "_lazy").
unreachable_local(m, n) :- unreachable_decl(_, _, _, n, _, m, _).
unreachable_edge(s, t) :- reference_edge(sn, tn, _), unreachable_decl_node(sn, s), unreachable_decl_node(tn, t).
unreachable_edge(o, s) :- unreachable_public(o, _, s).
unreachable_edge(o, mid) :- unreachable_hier_d(o, c, _), unreachable_decl(c, _, _, cn, _, cm, _), unreachable_method(cm, cn, n, mid), unreachable_hook(n).
unreachable_edge(o, b) :- unreachable_base_edge(o, b, _).
unreachable_edge(b, o) :- unreachable_base_edge(o, b, _).
unreachable_edge(id, s) :- unreachable_decl(id, _, _, _, "function", m, _), unreachable_base_name(id, b), unreachable_sibling(b, sn), unreachable_decl(s, _, _, sn, _, m, _), s != id.
unreachable_edge(id, s) :- unreachable_decl(id, _, _, _, "method", _, _), unreachable_base_name(id, b), unreachable_class_id(id, cid), unreachable_sibling(b, sn), s = @concat(cid, @concat(".", sn)), unreachable_decl(s, _, _, _, _, _, _), s != id.
unreachable_edge(id, c) :- unreachable_ann(id, n), unreachable_decl(id, _, _, _, _, m, _), unreachable_class_names(m, n, c).
unreachable_edge(id, s) :- unreachable_decl(id, _, _, _, _, m, _), s = @concat("@module:", m).
unreachable_edge(s, id) :- unreachable_module_names(m, n), unreachable_decl(id, _, _, n, _, m, _), s = @concat("@module:", m).
unreachable_edge(s, id) :- unreachable_module_names(m, n), unreachable_import(_, _, m, n, t, "symbol"), unreachable_decl(id, _, _, _, _, _, t), !unreachable_local(m, n), s = @concat("@module:", m).
unreachable_edge(mid, oid) :- unreachable_class_id(mid, c), unreachable_structural(c), unreachable_decl(mid, _, _, n, _, _, _), unreachable_decl(oid, _, _, n, "method", _, _), unreachable_class_id(oid, oc), oc != c.
unreachable_flow0(s) :- unreachable_root(s).
unreachable_flow0(t) :- unreachable_flow0(n), unreachable_edge(n, t).
unreachable_flowd(o, n) :- unreachable_flow0(n), unreachable_decl(n, _, _, _, "method", _, _), unreachable_class_id(n, cid), unreachable_base_edge(o, cid, _).
unreachable_flowd(o, p) :- unreachable_flowd(n, p), unreachable_base_edge(o, n, _).
unreachable_flowd(b, p) :- unreachable_flowd(n, p), unreachable_base_edge(n, b, _), unreachable_class_id(p, pc), b != pc.
unreachable_flow0(mid) :- unreachable_flowd(n, p), unreachable_decl(n, _, _, cn, _, cm, _), unreachable_decl(p, _, _, pn, _, _, _), unreachable_method(cm, cn, pn, mid).
unreachable_ann_reach(s) :- unreachable_flow0(s).
unreachable_ann_reach(c) :- unreachable_ann_reach(s), unreachable_ann(s, n), unreachable_unique_class(n, c).
unreachable_overrides_abstract(id) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_class_id(id, cid), unreachable_hier_d(cid, b, k), k > 0, unreachable_decl(b, _, _, bn, _, bm, _), unreachable_method(bm, bn, n, mid), unreachable_abstract(mid).
unreachable_owner(id, id) :- unreachable_decl(id, _, _, _, "class", _, _).
unreachable_owner(id, c) :- unreachable_decl(id, _, _, _, k, _, _), k != "class", unreachable_class_id(id, c).
unreachable_abstract_base(id) :- unreachable_owner(id, o), unreachable_hier_d(o, b, k), k > 0, unreachable_ann_reach(b), unreachable_abstract(b).
unreachable_abstract_base(id) :- unreachable_owner(id, o), unreachable_hier_d(o, b, k), k > 0, unreachable_ann_reach(b), unreachable_decl(b, _, _, bn, _, _, _), contains("ABC", bn), unreachable_base_edge(o, b, _).
unreachable_class_protocol(id) :- unreachable_class_id(id, c), unreachable_protocol(c).
unreachable_kept(id) :- unreachable_ann_reach(id).
unreachable_kept(id) :- unreachable_decl(id, _, _, _, _, m, _), match("(?:api|data_layer)\\..*", m).
unreachable_kept(id) :- unreachable_implicit(id).
unreachable_kept(id) :- unreachable_decl(id, _, _, _, _, _, fq), unreachable_imported_fq(fq).
unreachable_kept(id) :- unreachable_decl(id, _, _, _, "class", _, _), unreachable_protocol(id).
unreachable_kept(id) :- unreachable_decl(id, _, _, n, k, _, _), k != "class", unreachable_kept_member(id, n).
unreachable_kept(id) :- unreachable_abstract_base(id).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_abstract(id).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_is_property(id).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), prefix("_lower_", n).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), icontains("register", n).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), match("_create_.*_(?:connection|validator|factory)", n).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_class_protocol(id).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_overrides_abstract(id).
unreachable_high(id, x, d, n, k) :- unreachable_decl(id, x, d, n, k, _, _), !unreachable_kept(id).
unreachable_intent(id) :- unreachable_high(id, _, _, n, "class"), suffix("Intent", n).
unreachable_intent(id) :- unreachable_high(id, x, _, _, "class"), unreachable_base_text(x, s), contains("ServerPlanStep", s).
unreachable_grammar(id) :- unreachable_high(id, _, d, _, "class"), !unreachable_protocol(id), unreachable_doc(d, p, _), contains("/l2100_sql_grammar/", p).
unreachable_grammar(id) :- unreachable_high(id, _, _, n, "class"), !unreachable_protocol(id), suffix("Grammar", n).
unreachable_grammar(id) :- unreachable_high(id, _, _, n, "class"), !unreachable_protocol(id), prefix("Sql", n).
unreachable_grammar(id) :- unreachable_high(id, x, _, _, "class"), !unreachable_protocol(id), unreachable_base_text(x, s), (contains("Sql", s) ; contains("Grammar", s)).
unreachable_category(id, x, d, "high_confidence_functions") :- unreachable_high(id, x, d, _, k), k != "class".
unreachable_category(id, x, d, "high_confidence_intents") :- unreachable_high(id, x, d, _, "class"), unreachable_intent(id).
unreachable_category(id, x, d, "high_confidence_grammar_classes") :- unreachable_high(id, x, d, _, "class"), unreachable_grammar(id).
unreachable_category(id, x, d, "high_confidence_other_classes") :- unreachable_high(id, x, d, _, "class"), !unreachable_intent(id), !unreachable_grammar(id).
unreachable_shown(d) :- unreachable_doc(d, _, _), option_on("oracleAnalyzer").
unreachable_shown(d) :- unreachable_doc(d, p, _), !option_on("oracleAnalyzer"), !prefix("impl/browser/", p).
violation("data-layer-internal-dead-code", "unreachable-internal-symbols", c, p, l) :- unreachable_category(_, x, d, c), unreachable_shown(d), doc(d, p, _), line(x, l).
