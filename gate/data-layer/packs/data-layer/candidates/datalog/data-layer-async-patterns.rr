.decl session_receiver_receiver(c: node)
.decl session_receiver_root_need(o: node, c: node)
.decl session_receiver_session_assign(f: node, l: node, s: symbol)
.decl session_receiver_session_call(v: node)
.decl session_receiver_session_name(x: node, at: node)
.decl session_receiver_session_root(o: node, c: node)
.decl session_receiver_value(v: node, at: node)
.decl session_receiver_value_need(v: node, at: node)
.decl syntax_error(d: number)
.decl tape_line(d: number, l: number, sp: node)
.decl tape_syntax_error(d: number)
.decl text(n: node, s: symbol)
.decl transaction_receiver_annotation(t: node)
.decl transaction_receiver_annotation_wrapper(t: node)
.decl transaction_receiver_assign(f: node, l: node, s: symbol, r: node)
.decl transaction_receiver_decorated(c: node)
.decl transaction_receiver_down(o: node, x: node)
.decl transaction_receiver_literal(t: node)
.decl transaction_receiver_name_need(x: node, at: node)
.decl transaction_receiver_need(o: node)
.decl transaction_receiver_param(q: node, s: symbol)
.decl transaction_receiver_query_assign(f: node, l: node, s: symbol)
.decl transaction_receiver_query_chain(c: node)
.decl transaction_receiver_query_name(x: node, at: node)
.decl transaction_receiver_query_root(o: node, c: node)
.decl transaction_receiver_receiver(c: node)
.decl transaction_receiver_root_need(o: node, c: node)
.decl transaction_receiver_splat(q: node)
.decl transaction_receiver_txn_name(x: node)
.decl transaction_receiver_txn_param_name(s: symbol)
.decl transaction_receiver_txn_root(o: node)
.decl transaction_receiver_txn_type_name(s: symbol)
.decl transaction_receiver_typed(q: node)
.decl transaction_receiver_typed_name(q: node, first: node, s: symbol)
.decl transaction_receiver_value(v: node, at: node)
.decl transaction_receiver_value_need(v: node, at: node)
.decl value(n: node, v: symbol)
.decl value_type_of(n: node, t: symbol)
.decl violation(rule: symbol, clause: symbol, code: symbol, path: symbol, line: number)
.input doc, node, child, field, text, op, line, syntax_error, value, value_type_of, tape_line
.output violation
