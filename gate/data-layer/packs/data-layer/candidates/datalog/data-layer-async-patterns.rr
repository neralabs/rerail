.decl async_patterns_classk(kind: symbol)
async_patterns_classk("class_definition").
.decl async_patterns_fnk(kind: symbol)
async_patterns_fnk("function_definition"). async_patterns_fnk("lambda").
.decl async_patterns_analyzer(d: number, p: symbol)
.decl async_patterns_area(p: symbol, area: symbol)
.decl async_patterns_call(family: symbol, d: number, c: node, o: node)
.decl async_patterns_context(c: node, w: number, s: symbol)
