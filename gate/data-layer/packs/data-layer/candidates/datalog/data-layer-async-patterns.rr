in_scope(d) :- doc(d, p, _), glob("impl/sqlite/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/postgres/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/mariadb/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/doltdb/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/mongodb/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/neo4j/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("impl/common/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("api/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("conform/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/test/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
out_scope(d) :- doc(d, p, _), glob("**/*test_*", p).
tape_syntax_error(d) :- syntax_error(d).
async_patterns_doc(d, p) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d).
async_patterns_plugin(d, p) :- async_patterns_doc(d, p), !option_on("oracleAnalyzer").
async_patterns_call(fam, d, c, o) :- async_patterns_method(fam, m), text(a, m), node(_, a, "identifier", _, _), field(f, "attribute", a), node(_, f, "attribute", _, _), field(c, "function", f), node(d, c, "call", _, _), field(f, "object", o), async_patterns_doc(d, _).
async_patterns_in_async(c) :- async_patterns_call(fam, _, c, _), fam != "to-thread", fam != "executor", nearest(c, f, async_patterns_fnk), node(_, f, "function_definition", _, _), op(f, "async").
async_patterns_marked_class(k) :- node(_, k, "class_definition", _, _), field(k, "name", nm), text(nm, s), (contains("Transaction", s) ; contains("Connection", s) ; contains("Query", s) ; contains("Handle", s) ; contains("Version", s)).
async_patterns_marked_class(k) :- node(_, k, "class_definition", _, _), field(k, "superclasses", sc), child(sc, b, _), node(_, b, "identifier", _, _), text(b, "ABC").
async_patterns_marked_class(k) :- node(_, k, "class_definition", _, _), field(k, "superclasses", sc), child(sc, b, _), node(_, b, "attribute", _, _), field(b, "attribute", a), node(_, a, "identifier", _, _), text(a, "ABC").
async_patterns_in_marked_class(c) :- async_patterns_call(_, _, c, _), nearest(c, k, async_patterns_classk), async_patterns_marked_class(k).
async_patterns_context(c, w, s) :- async_patterns_call(fam, d, c, _), fam != "session-receiver", line(c, l0), async_patterns_window(w, k), l = @add(l0, k), tape_line(d, l, sp), text(sp, s).
async_patterns_waived(c) :- async_patterns_context(c, 5, s), contains("ASYNC_FALLBACK:", s).
async_patterns_waived(c) :- async_patterns_context(c, 5, s), contains("TODO: Implement", s), async_patterns_context(c, 5, t), contains("native async", t).
async_patterns_wrapped(c) :- async_patterns_context(c, 15, s), contains("_wrap_for_executor", s).
violation("data-layer-async-patterns", "to-thread-impl", "ASYNC001", p, l) :- async_patterns_call("to-thread", d, c, _), async_patterns_plugin(d, p), prefix("impl/", p), !async_patterns_waived(c), line(c, l).
violation("data-layer-async-patterns", "to-thread-api", "ASYNC001", p, l) :- async_patterns_call("to-thread", d, c, _), async_patterns_plugin(d, p), prefix("api/", p), !async_patterns_waived(c), !async_patterns_in_marked_class(c), line(c, l).
violation("data-layer-async-patterns", "to-thread-conform", "ASYNC001", p, l) :- async_patterns_call("to-thread", d, c, _), async_patterns_plugin(d, p), prefix("conform/", p), !async_patterns_waived(c), line(c, l).
violation("data-layer-async-patterns", "executor-impl", "ASYNC002", p, l) :- async_patterns_call("executor", d, c, _), async_patterns_plugin(d, p), prefix("impl/", p), !async_patterns_waived(c), line(c, l).
violation("data-layer-async-patterns", "executor-api", "ASYNC002", p, l) :- async_patterns_call("executor", d, c, _), async_patterns_plugin(d, p), prefix("api/", p), !async_patterns_waived(c), !async_patterns_in_marked_class(c), !async_patterns_wrapped(c), line(c, l).
violation("data-layer-async-patterns", "executor-conform", "ASYNC002", p, l) :- async_patterns_call("executor", d, c, _), async_patterns_plugin(d, p), prefix("conform/", p), !async_patterns_waived(c), !async_patterns_wrapped(c), line(c, l).
violation("data-layer-async-patterns", "internal-io-impl", "ASYNC005", p, l) :- async_patterns_call("internal-io", d, c, _), async_patterns_plugin(d, p), prefix("impl/", p), async_patterns_in_async(c), !async_patterns_waived(c), line(c, l).
violation("data-layer-async-patterns", "internal-io-api", "ASYNC005", p, l) :- async_patterns_call("internal-io", d, c, _), async_patterns_plugin(d, p), prefix("api/", p), async_patterns_in_async(c), !async_patterns_waived(c), !async_patterns_in_marked_class(c), line(c, l).
violation("data-layer-async-patterns", "internal-io-conform", "ASYNC005", p, l) :- async_patterns_call("internal-io", d, c, _), async_patterns_plugin(d, p), prefix("conform/", p), async_patterns_in_async(c), !async_patterns_waived(c), line(c, l).
transaction_receiver_decorated(c) :- async_patterns_call("transaction-receiver", _, c, _), nearest(c, f, async_patterns_fnk), node(_, f, "function_definition", _, _), op(f, "async"), child(dd, f, _), node(_, dd, "decorated_definition", _, _), child(dd, dec, _), node(_, dec, "decorator", _, _), child(dec, dc, _), node(_, dc, "call", _, _), field(dc, "function", df), node(_, df, "attribute", _, _), field(df, "attribute", da), node(_, da, "identifier", _, _), text(da, dm), (dm = "write_async" ; dm = "read_async").
transaction_receiver_annotation(t) :- transaction_receiver_txn_type_name(s), text(t, s), node(_, t, "identifier", _, _).
transaction_receiver_annotation(t) :- transaction_receiver_txn_type_name(s), text(a, s), node(_, a, "identifier", _, _), field(t, "attribute", a), node(_, t, "attribute", _, _).
transaction_receiver_annotation(t) :- transaction_receiver_literal(t), value(t, v), value_type_of(t, "str"), match("(?s:.*)(?:LazyVersionedReadTransaction|LazyVersionedWriteTransaction|ReadTransaction|WriteTransaction)(?s:.*)", v).
transaction_receiver_literal(t) :- node(_, t, "string", _, _).
transaction_receiver_literal(t) :- node(_, t, "concatenated_string", _, _).
transaction_receiver_annotation(t) :- transaction_receiver_annotation(x), child(t, x, _), transaction_receiver_annotation_wrapper(t).
transaction_receiver_annotation_wrapper(t) :- node(_, t, "type", _, _).
transaction_receiver_annotation_wrapper(t) :- node(_, t, "type_parameter", _, _).
transaction_receiver_annotation_wrapper(t) :- node(_, t, "generic_type", _, _).
transaction_receiver_annotation_wrapper(t) :- node(_, t, "subscript", _, _).
transaction_receiver_annotation_wrapper(t) :- node(_, t, "tuple", _, _).
transaction_receiver_annotation_wrapper(t) :- node(_, t, "union_type", _, _).
transaction_receiver_annotation_wrapper(t) :- node(_, t, "binary_operator", _, _).
transaction_receiver_param(q, s) :- node(_, q, "identifier", _, _), text(q, s), transaction_receiver_txn_param_name(s), child(ps, q, _), node(_, ps, "parameters", _, _).
transaction_receiver_param(q, s) :- node(_, q, "default_parameter", _, _), field(q, "name", nm), node(_, nm, "identifier", _, _), text(nm, s), transaction_receiver_txn_param_name(s).
transaction_receiver_param(q, s) :- transaction_receiver_splat(q), child(ps, q, _), node(_, ps, "parameters", _, _), child(q, i, _), node(_, i, "identifier", _, _), text(i, s), transaction_receiver_txn_param_name(s).
transaction_receiver_splat(q) :- node(_, q, "list_splat_pattern", _, _).
transaction_receiver_splat(q) :- node(_, q, "dictionary_splat_pattern", _, _).
transaction_receiver_typed(q) :- node(_, q, "typed_parameter", _, _).
transaction_receiver_typed(q) :- node(_, q, "typed_default_parameter", _, _).
transaction_receiver_typed_name(q, c, s) :- transaction_receiver_typed(q), child(q, c, 0), node(_, c, "identifier", _, _), text(c, s).
transaction_receiver_typed_name(q, c, s) :- transaction_receiver_typed(q), child(q, c, 0), child(c, i, _), node(_, i, "identifier", _, _), text(i, s).
transaction_receiver_param(q, s) :- transaction_receiver_typed_name(q, c, s), node(_, c, "identifier", _, _), text(c, t), transaction_receiver_txn_param_name(t).
transaction_receiver_param(q, s) :- transaction_receiver_typed_name(q, _, s), field(q, "type", ty), transaction_receiver_annotation(ty).
transaction_receiver_need(o) :- async_patterns_call("transaction-receiver", _, _, o).
transaction_receiver_need(r) :- transaction_receiver_assign(_, _, _, r).
transaction_receiver_need(x) :- transaction_receiver_need(o), transaction_receiver_down(o, x).
transaction_receiver_need(x) :- transaction_receiver_need(o), node(_, o, "assignment", _, _), field(o, "right", x).
transaction_receiver_down(o, x) :- node(_, o, "attribute", _, _), field(o, "object", x).
transaction_receiver_down(o, x) :- node(_, o, "call", _, _), field(o, "function", x).
transaction_receiver_down(o, x) :- node(_, o, "subscript", _, _), field(o, "value", x).
transaction_receiver_txn_name(x) :- transaction_receiver_need(x), node(_, x, "identifier", _, _), text(x, s), nearest(x, f, async_patterns_fnk), node(_, f, "function_definition", _, _), op(f, "async"), field(f, "parameters", ps), child(ps, q, _), transaction_receiver_param(q, s).
transaction_receiver_txn_root(o) :- transaction_receiver_txn_name(o).
transaction_receiver_txn_root(o) :- transaction_receiver_need(o), transaction_receiver_down(o, x), transaction_receiver_txn_root(x).
transaction_receiver_query_chain(c) :- transaction_receiver_need(c), node(_, c, "call", _, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, m), (m = "select_at_revision" ; m = "query" ; m = "cross_branch"), field(f, "object", o), transaction_receiver_txn_root(o).
transaction_receiver_query_chain(c) :- transaction_receiver_need(c), node(_, c, "call", _, _), field(c, "function", f), node(_, f, "attribute", _, _), field(f, "object", o), transaction_receiver_query_chain(o).
transaction_receiver_assign(f, l, s, r) :- node(_, a, "assignment", _, _), field(a, "left", l), node(_, l, "identifier", _, _), text(l, s), field(a, "right", r), nearest(a, f, async_patterns_fnk), node(_, f, "function_definition", _, _), op(f, "async").
transaction_receiver_value_need(r, l) :- transaction_receiver_assign(_, l, _, r).
transaction_receiver_value_need(x, at) :- transaction_receiver_value_need(v, at), node(_, v, "assignment", _, _), field(v, "right", x).
transaction_receiver_value(v, at) :- transaction_receiver_value_need(v, at), transaction_receiver_query_chain(v).
transaction_receiver_value(v, at) :- transaction_receiver_value_need(v, at), transaction_receiver_query_name(v, at).
transaction_receiver_value(v, at) :- transaction_receiver_value_need(v, at), node(_, v, "assignment", _, _), field(v, "right", x), transaction_receiver_value(x, at).
transaction_receiver_query_assign(f, l, s) :- transaction_receiver_assign(f, l, s, r), transaction_receiver_value(r, l).
transaction_receiver_name_need(v, at) :- transaction_receiver_value_need(v, at), node(_, v, "identifier", _, _).
transaction_receiver_name_need(o, c) :- transaction_receiver_root_need(o, c), node(_, o, "identifier", _, _).
transaction_receiver_query_name(x, at) :- transaction_receiver_name_need(x, at), text(x, s), nearest(x, f, async_patterns_fnk), transaction_receiver_query_assign(f, l, s), node(_, l, _, _, le), node(_, at, _, ats, _), le <= ats.
transaction_receiver_root_need(o, c) :- async_patterns_call("transaction-receiver", _, c, o).
transaction_receiver_root_need(x, c) :- transaction_receiver_root_need(o, c), transaction_receiver_down(o, x).
transaction_receiver_query_root(o, c) :- transaction_receiver_root_need(o, c), transaction_receiver_query_name(o, c).
transaction_receiver_query_root(o, c) :- transaction_receiver_root_need(o, c), transaction_receiver_down(o, x), transaction_receiver_query_root(x, c).
transaction_receiver_receiver(c) :- async_patterns_call("transaction-receiver", _, c, o), node(_, o, "identifier", _, _), text(o, "self").
transaction_receiver_receiver(c) :- async_patterns_call("transaction-receiver", _, c, o), transaction_receiver_txn_root(o).
transaction_receiver_receiver(c) :- async_patterns_call("transaction-receiver", _, c, o), transaction_receiver_query_root(o, c).
transaction_receiver_receiver(c) :- async_patterns_call("transaction-receiver", _, c, o), transaction_receiver_query_chain(o).
violation("data-layer-async-patterns", "transaction-receiver-impl", "ASYNC006", p, l) :- async_patterns_call("transaction-receiver", d, c, _), async_patterns_plugin(d, p), prefix("impl/", p), async_patterns_in_async(c), !transaction_receiver_decorated(c), transaction_receiver_receiver(c), !async_patterns_waived(c), line(c, l).
violation("data-layer-async-patterns", "transaction-receiver-api", "ASYNC006", p, l) :- async_patterns_call("transaction-receiver", d, c, _), async_patterns_plugin(d, p), prefix("api/", p), async_patterns_in_async(c), !transaction_receiver_decorated(c), transaction_receiver_receiver(c), !async_patterns_waived(c), !async_patterns_in_marked_class(c), line(c, l).
violation("data-layer-async-patterns", "transaction-receiver-conform", "ASYNC006", p, l) :- async_patterns_call("transaction-receiver", d, c, _), async_patterns_plugin(d, p), prefix("conform/", p), async_patterns_in_async(c), !transaction_receiver_decorated(c), transaction_receiver_receiver(c), !async_patterns_waived(c), line(c, l).
session_receiver_value_need(r, l) :- transaction_receiver_assign(_, l, _, r).
session_receiver_value_need(x, at) :- session_receiver_value_need(v, at), node(_, v, "assignment", _, _), field(v, "right", x).
session_receiver_session_call(v) :- node(_, v, "call", _, _), field(v, "function", f), node(_, f, "attribute", _, _), field(f, "attribute", a), node(_, a, "identifier", _, _), text(a, "session").
session_receiver_value(v, at) :- session_receiver_value_need(v, at), session_receiver_session_call(v).
session_receiver_value(v, at) :- session_receiver_value_need(v, at), session_receiver_session_name(v, at).
session_receiver_value(v, at) :- session_receiver_value_need(v, at), node(_, v, "assignment", _, _), field(v, "right", x), session_receiver_value(x, at).
session_receiver_session_assign(f, l, s) :- transaction_receiver_assign(f, l, s, r), session_receiver_value(r, l).
session_receiver_name_need(v, at) :- session_receiver_value_need(v, at), node(_, v, "identifier", _, _).
session_receiver_name_need(o, c) :- session_receiver_root_need(o, c), node(_, o, "identifier", _, _).
session_receiver_session_name(x, at) :- session_receiver_name_need(x, at), text(x, s), nearest(x, f, async_patterns_fnk), session_receiver_session_assign(f, l, s), node(_, l, _, _, le), node(_, at, _, ats, _), le <= ats.
session_receiver_root_need(o, c) :- async_patterns_call("session-receiver", _, c, o).
session_receiver_root_need(x, c) :- session_receiver_root_need(o, c), transaction_receiver_down(o, x).
session_receiver_session_root(o, c) :- session_receiver_root_need(o, c), session_receiver_session_name(o, c).
session_receiver_session_root(o, c) :- session_receiver_root_need(o, c), transaction_receiver_down(o, x), session_receiver_session_root(x, c).
session_receiver_receiver(c) :- async_patterns_call("session-receiver", _, c, o), session_receiver_session_root(o, c).
session_receiver_receiver(c) :- async_patterns_call("session-receiver", _, c, o), node(_, o, "attribute", _, _), field(o, "object", s), node(_, s, "identifier", _, _), text(s, "self"), field(o, "attribute", a), node(_, a, "identifier", _, _), text(a, m), (m = "_conn" ; m = "conn" ; m = "connection" ; m = "_connection").
violation("data-layer-async-patterns", "session-receiver-impl", "ASYNC007", p, l) :- async_patterns_call("session-receiver", d, c, _), async_patterns_plugin(d, p), prefix("impl/", p), async_patterns_in_async(c), session_receiver_receiver(c), line(c, l).
violation("data-layer-async-patterns", "session-receiver-api", "ASYNC007", p, l) :- async_patterns_call("session-receiver", d, c, _), async_patterns_plugin(d, p), prefix("api/", p), async_patterns_in_async(c), session_receiver_receiver(c), line(c, l).
violation("data-layer-async-patterns", "session-receiver-conform", "ASYNC007", p, l) :- async_patterns_call("session-receiver", d, c, _), async_patterns_plugin(d, p), prefix("conform/", p), async_patterns_in_async(c), session_receiver_receiver(c), line(c, l).
async_patterns_analyzer(d, p) :- async_patterns_doc(d, p), option_on("oracleAnalyzer").
decorated_write_analyzer_decorator(c, dm) :- async_patterns_call(fam, _, c, _), (fam = "decorated-write" ; fam = "decorated-read"), nearest(c, f, async_patterns_fnk), node(_, f, "function_definition", _, _), op(f, "async"), child(dd, f, _), node(_, dd, "decorated_definition", _, _), child(dd, dec, _), node(_, dec, "decorator", _, _), child(dec, dc, _), node(_, dc, "call", _, _), field(dc, "function", df), node(_, df, "attribute", _, _), field(df, "attribute", da), node(_, da, "identifier", _, _), text(da, dm).
violation("data-layer-async-patterns", "to-thread-analyzer", "ASYNC001", p, l) :- async_patterns_call("to-thread", d, c, _), async_patterns_analyzer(d, p), line(c, l).
violation("data-layer-async-patterns", "executor-analyzer", "ASYNC002", p, l) :- async_patterns_call("executor", d, c, _), async_patterns_analyzer(d, p), line(c, l).
violation("data-layer-async-patterns", "decorated-write-analyzer", "ASYNC004", p, l) :- async_patterns_call("decorated-write", d, c, _), async_patterns_analyzer(d, p), decorated_write_analyzer_decorator(c, "write_async"), line(c, l).
violation("data-layer-async-patterns", "decorated-read-analyzer", "ASYNC004", p, l) :- async_patterns_call("decorated-read", d, c, _), async_patterns_analyzer(d, p), decorated_write_analyzer_decorator(c, dm), (dm = "write_async" ; dm = "read_async"), line(c, l).
violation("data-layer-async-patterns", "internal-io-analyzer", "ASYNC005", p, l) :- async_patterns_call("internal-io", d, c, _), async_patterns_analyzer(d, p), async_patterns_in_async(c), line(c, l).
violation("data-layer-async-patterns", "polymorphic-analyzer", "ASYNC008", p, l) :- async_patterns_call("polymorphic", d, c, _), async_patterns_analyzer(d, p), async_patterns_in_async(c), line(c, l).
violation("data-layer-async-patterns", "transaction-receiver-analyzer", "ASYNC006", p, l) :- async_patterns_call("transaction-receiver", d, c, _), async_patterns_analyzer(d, p), async_patterns_in_async(c), !transaction_receiver_decorated(c), transaction_receiver_receiver(c), line(c, l).
violation("data-layer-async-patterns", "session-receiver-analyzer", "ASYNC007", p, l) :- async_patterns_call("session-receiver", d, c, _), async_patterns_analyzer(d, p), async_patterns_in_async(c), session_receiver_receiver(c), line(c, l).
async_patterns_area(p, "impl") :- async_patterns_plugin(_, p), prefix("impl/", p).
async_patterns_area(p, "api") :- async_patterns_plugin(_, p), prefix("api/", p).
async_patterns_area(p, "conform") :- async_patterns_plugin(_, p), prefix("conform/", p).
