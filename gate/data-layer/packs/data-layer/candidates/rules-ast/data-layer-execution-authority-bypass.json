            ]
          },
          {
            "name": "contexts",
            "query": "WITH RECURSIVE scopes(path,start,qualname,depth) AS (\n SELECT __path,__start,name,is_function FROM parents WHERE parent IS NULL UNION ALL\n SELECT c.__path,c.__start,p.qualname || CASE WHEN c.is_function AND p.depth>0 THEN '.<locals>.' ELSE '.' END || c.name,p.depth+c.is_function\n FROM scopes p CROSS JOIN parents c ON c.__path=p.path AND c.parent=p.start)\n SELECT * FROM scopes",
            "indexes": [
              [
                "path",
                "start"
              ]
            ]
          },
          {
            "name": "sites",
            "query": "SELECT r.*,coalesce((SELECT c.qualname FROM frames f JOIN contexts c ON c.path=f.__path AND c.start=f.__start\n WHERE f.__path=r.__path AND f.lexical_start<=r.__start AND f.__end>=r.__end ORDER BY f.__start DESC LIMIT 1),'<module>') AS qualname,\n replace(rx_replace(r.__path,'\\.py$',''),'/','.') AS module FROM (\n SELECT *, 'AUTH001' AS issue FROM private_symbols UNION ALL SELECT *,'AUTH002' FROM explicit_calls UNION ALL SELECT *,'AUTH003' FROM monkeypatches) r"
          },
