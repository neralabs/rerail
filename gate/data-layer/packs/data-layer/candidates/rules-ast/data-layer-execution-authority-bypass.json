            "query": "SELECT f.*,(SELECT p.__start FROM frames p WHERE p.__path=f.__path AND p.__start<f.__start AND p.__end>=f.__end ORDER BY p.__start DESC LIMIT 1) AS parent FROM frames f",
            "indexes": [
