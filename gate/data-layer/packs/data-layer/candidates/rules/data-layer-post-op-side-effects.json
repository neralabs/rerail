        "stages": [
          {
            "name": "overrides",
            "query": {
              "$option": "fateOverrides",
              "escape": "sql",
              "map": " UNION ALL SELECT {} AS entry",
              "join": "",
              "template": "SELECT '' AS entry WHERE 0{}"
            }
          },
          {
            "name": "memberships",
            "query": "SELECT DISTINCT class_name||'.'||name AS symbol FROM members WHERE (__path='l2070_batching/post_op.py' OR __path='l2070_batching/post_op_specs.py') AND class_name IN ('PostOpKind','PostOpBehavior')"
          },
          {
            "name": "fates",
            "query": "SELECT m.symbol,coalesce((SELECT substr(o.entry,instr(o.entry,'=')+1) FROM overrides o WHERE substr(o.entry,1,instr(o.entry,'=')-1)=m.symbol),'audit_required') AS fate FROM memberships m"
          },
          {
            "name": "surface",
            "query": "SELECT DISTINCT class_name||'.'||name AS symbol FROM members WHERE (__path='l2070_batching/post_op.py' AND class_name IN ('PostOpKind','PostOpBehavior')) OR (__path='l2070_batching/post_op_specs.py' AND class_name='DomainPostOpDecoderKind')\n          UNION SELECT 'post_op_factory.'||name FROM functions WHERE __path='l2070_batching/post_op.py' AND name GLOB '*_post_op' AND sync='def'\n          UNION SELECT 'post_op_spec.'||name FROM specs WHERE __path='l2070_batching/post_op_specs.py'"
          },
          {
            "name": "reachable",
            "query": "SELECT DISTINCT s.value AS symbol FROM strings s WHERE s.__path='l2070_batching/post_op.py' AND (s.value GLOB 'assertion.*' OR s.value GLOB 'materializer.*')\n            AND EXISTS(SELECT 1 FROM functions f WHERE f.__path=s.__path AND f.name='post_op_runtime_symbol' AND f.__start<s.__start AND f.__end>=s.__end\n                AND f.__start=(SELECT min(x.__start) FROM functions x WHERE x.__path=f.__path AND x.name=f.name))\n          UNION SELECT 'decoder.'||class_name||'.'||name FROM members WHERE __path='l2070_batching/post_op_specs.py' AND class_name='DomainPostOpDecoderKind' "
          },
          {
            "name": "fate_valid",
            "query": {
              "$option": "fatesSignature",
              "escape": "sql",
              "template": "SELECT verify_ed25519('7e9776d87292ab633115bd6c07892a4bf56450fffb2dfcf13b3eba1866b9fbb6','{\"allowlist\":'||coalesce((SELECT json_group_array(value) FROM (SELECT symbol||'='||fate AS value FROM fates ORDER BY value)),'[]')||',\"linter\":\"post_op_side_effects\",\"version\":1}',rx_replace({},'[^A-Za-z0-9+/=]','')) AS valid"
            }
          },
          {
            "name": "surface_valid",
            "query": {
              "$option": "surfaceSignature",
              "escape": "sql",
              "template": "SELECT verify_ed25519('7e9776d87292ab633115bd6c07892a4bf56450fffb2dfcf13b3eba1866b9fbb6','{\"allowlist\":'||coalesce((SELECT json_group_array(value) FROM (SELECT symbol AS value FROM surface ORDER BY value)),'[]')||',\"linter\":\"post_op_surface\",\"version\":1}',rx_replace({},'[^A-Za-z0-9+/=]','')) AS valid"
            }
          },
          {
            "name": "runtime_valid",
            "query": "SELECT verify_ed25519('7e9776d87292ab633115bd6c07892a4bf56450fffb2dfcf13b3eba1866b9fbb6','{\"allowlist\":'||coalesce((SELECT json_group_array(value) FROM (SELECT value FROM registry WHERE __path='l2070_batching/post_op_allowlist.py' ORDER BY value)),'[]')||',\"linter\":\"post_op_runtime_allowlist\",\"version\":1}',rx_replace(coalesce((SELECT value FROM signature WHERE __path='l2070_batching/post_op_allowlist.py' ORDER BY __start LIMIT 1),''),'[^A-Za-z0-9+/=]','')) AS valid"
          },
          {
            "name": "verifiers",
            "query": "SELECT f.*,(SELECT min(v.line) FROM verification v WHERE v.__path=f.__path AND v.__start>=f.__start AND v.__end<=f.__end) AS first_verify FROM functions f WHERE f.name='assert_post_op_symbol_signed' AND f.__start=(SELECT min(x.__start) FROM functions x WHERE x.__path=f.__path AND x.name=f.name)"
          },
          {
            "name": "bypass",
            "query": "SELECT m.__path FROM modules m WHERE EXISTS(SELECT 1 FROM flags f WHERE f.__path=m.__path) OR NOT EXISTS(SELECT 1 FROM verifiers f WHERE f.__path=m.__path) OR EXISTS(SELECT 1 FROM verifiers f WHERE f.__path=m.__path AND (f.first_verify IS NULL OR EXISTS(SELECT 1 FROM returns r WHERE r.__path=f.__path AND r.__start>=f.__start AND r.__end<=f.__end AND r.line<f.first_verify)))"
          },
          {
            "name": "trusted_overrides",
            "query": {
              "$option": "entryPoint",
              "cases": {
                "_collect_violations": "SELECT entry FROM overrides"
              },
              "default": "SELECT entry FROM overrides WHERE (SELECT valid FROM fate_valid)"
            }
          },
