{
  "name": "@neralabs/rerail",
  "version": "0.1.0-next.2",
  "description": "Local semantic monitor and rule runtime for AI coding harnesses",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neralabs/rerail.git"
  },
  "bugs": {
    "url": "https://github.com/neralabs/rerail/issues"
  },
  "homepage": "https://github.com/neralabs/rerail#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/engine/rules.d.ts",
      "import": "./dist/engine/rules.js"
    },
    "./schemas": {
      "types": "./dist/engine/schemas.d.ts",
      "import": "./dist/engine/schemas.js"
    }
  },
  "bin": {
    "rerail": "dist/cli/cli.js"
  },
  "omp": {
    "extensions": [
      "./dist/hosts/omp/default-extension.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/hosts/pi/pi-extension.js"
    ]
  },
  "keywords": [
    "pi-package",
    "semantic-search",
    "cosine-similarity"
  ],
  "workspaces": [
    "packs/*"
  ],
  "files": [
    "dist",
    "native/*.node",
    "model",
    "native/src/code_rule_dsl/capabilities.json",
    "LICENSE",
    "NOTICE",
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    "hooks",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES",
    "packs/complexity/pack.json",
    "packs/complexity/rules"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:native && npm run build:js",
    "build:js": "npm run build:ts && npm run build:omp && npm run build:events && npm run build:cursor && npm run build:claude && npm run build:codex && npm run build:ui",
    "build:clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:ui": "node scripts/build/copy-ui.mjs",
    "ensure:sqlite": "node scripts/build/ensure-sqlite.mjs",
    "build:native": "node scripts/build/require-cargo.mjs && napi build --platform --release --manifest-path native/Cargo.toml --output-dir native",
    "build:ts": "tsc -p tsconfig.build.json && esbuild src/presentation/session-presentation.ts --bundle --platform=node --format=esm --outfile=dist/presentation/session-presentation.js",
    "build:omp": "esbuild src/hosts/omp/default-extension.ts --bundle --platform=node --target=node24 --format=esm --external:better-sqlite3 --external:drizzle-orm --outfile=dist/hosts/omp/default-extension.js",
    "build:test-host": "esbuild integration/support/omp-host-extension.ts --bundle --packages=external --platform=node --target=node24 --format=esm --outfile=node_modules/.cache/rerail/omp-host.mjs",
    "build:events": "esbuild src/harness/event-stream.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:drizzle-orm --outfile=dist/harness/event-stream.js",
    "build:cursor": "esbuild src/hosts/cursor/cursor-hook.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:drizzle-orm --outfile=dist/hosts/cursor/cursor-hook.js",
    "build:claude": "esbuild src/hosts/claude/claude-hook.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:drizzle-orm --outfile=dist/hosts/claude/claude-hook.js",
    "build:codex": "esbuild src/hosts/codex/codex-hook.ts --bundle --platform=node --format=esm --external:better-sqlite3 --external:drizzle-orm --outfile=dist/hosts/codex/codex-hook.js",
    "check": "tsc --noEmit && npm run check:boundaries && npm run check:structure && npm run check:windows-paths",
    "check:boundaries": "node scripts/check/check-boundaries.mjs",
    "check:native": "cargo fmt --manifest-path Cargo.toml --all -- --check && cargo clippy --manifest-path Cargo.toml --workspace --all-targets -- -D warnings && cargo clippy --manifest-path native/Cargo.toml --features code-rule-profile --all-targets -- -D warnings",
    "check:all": "npm run check && npm run check:native && npm run check:ui-tokens && npm run check:reference && npm run check:licenses",
    "check:licenses": "node scripts/check/check-licenses.mjs",
    "check:reference": "node scripts/generate/docs/code-rule-dsl-reference.mjs grammar",
    "check:structure": "node scripts/check/check-structure.mjs",
    "check:ui-tokens": "node scripts/check/check-ui-tokens.mjs",
    "check:windows-paths": "node scripts/check/check-windows-paths.mjs",
    "test": "vitest run --dir test",
    "test:conformance": "npm run conformance:languages:check",
    "test:native": "cargo test --manifest-path Cargo.toml --workspace",
    "test:code-rule-dsl-runtime": "vitest run test/engine/native/native-code-rule-dsl-runtime.test.ts",
    "bench:code-rule-dsl": "node --import tsx scripts/dsl/code-rule-dsl-bench.ts",
    "test:integration:built": "npm run build:test-host && vitest run --dir integration",
    "test:integration:code-rule-runtime": "vitest run integration/code-rule-runtime.test.ts",
    "test:integration": "npm run build && npm run test:integration:built",
    "test:e2e:host": "npm run build && node --import tsx scripts/host/host-smoke.ts",
    "test:e2e:lifecycle": "npm run build:ts && node --import tsx scripts/host/host-lifecycle.ts omp",
    "test:e2e:lifecycle:pi": "npm run build:ts && node --import tsx scripts/host/host-lifecycle.ts pi",
    "test:all": "npm run build && npm test && npm run test:conformance && npm run test:scripts && npm run test:reference && npm run test:native && npm run test:integration:built",
    "test:reference": "node --import tsx scripts/generate/docs/code-rule-dsl-reference.mjs examples",
    "test:scripts": "node --test test/scripts/ensure-sqlite.test.mjs && python3 test/docs/test_transducer_design.py",
    "test:watch": "vitest --dir test",
    "conformance:languages": "node --import tsx conformance/languages/cli.ts",
    "conformance:languages:check": "node --import tsx conformance/languages/cli.ts --check",
    "generate:schema": "node --import tsx scripts/generate/schema/schema-sql.ts",
    "generate:languages": "node --import tsx scripts/generate/languages/registry.ts",
    "package:check": "npm run build && npm pack --dry-run",
    "version:packs": "changeset version && node scripts/release/sync-pack-lockfile.mjs",
    "prepack": "node scripts/build/stamp-plugin-versions.mjs stamp",
    "postpack": "node scripts/build/stamp-plugin-versions.mjs restore"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@babel/parser": "^7.29.9",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "diff": "8.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.5",
    "ignore": "7.0.12",
    "superjson": "2.2.6",
    "typebox": "1.3.36",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@babel/types": "^7.29.8",
    "@changesets/cli": "3.0.3",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@napi-rs/cli": "3.10.8",
    "@oh-my-pi/omptype": "18.0.4",
    "@oh-my-pi/pi-agent-core": "18.0.4",
    "@oh-my-pi/pi-ai": "18.0.4",
    "@oh-my-pi/pi-coding-agent": "18.0.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "napi": {
    "binaryName": "rerail_engine",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "author": "Nera Software Inc."
}
