  { "name": "empty-section", "files": { ".sqlfluff": "[sqlfluff]\ndialect = postgres\n" } },
  { "name": "rules-codes", "files": { ".sqlfluff": "[sqlfluff]\nrules = AL04,CV05\n" } },
  { "name": "rules-names", "files": { ".sqlfluff": "[sqlfluff]\nrules = convention.is_null, aliasing.unused\n" } },
  { "name": "rules-core", "files": { ".sqlfluff": "[sqlfluff]\nrules = core\n" } },
  { "name": "rules-group", "files": { ".sqlfluff": "[sqlfluff]\nrules = aliasing,structure\n" } },
  { "name": "rules-aliases", "files": { ".sqlfluff": "[sqlfluff]\nrules = L049,L020,L026\n" } },
  { "name": "rules-shared-name", "files": { ".sqlfluff": "[sqlfluff]\nrules = aliasing.unique\n" } },
  { "name": "rules-glob-codes", "files": { ".sqlfluff": "[sqlfluff]\nrules = AL0*\n" } },
  { "name": "rules-glob-names", "files": { ".sqlfluff": "[sqlfluff]\nrules = convention.*,*.distinct\n" } },
  { "name": "rules-glob-aliases", "files": { ".sqlfluff": "[sqlfluff]\nrules = L04?\n" } },
