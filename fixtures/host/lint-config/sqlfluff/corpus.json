  { "name": "rules-glob-unclosed", "files": { ".sqlfluff": "[sqlfluff]\nrules = [AL04\n" } },
  { "name": "rules-all", "files": { ".sqlfluff": "[sqlfluff]\nrules = all\n" } },
  { "name": "rules-none", "files": { ".sqlfluff": "[sqlfluff]\nrules = None\n" } },
  { "name": "rules-zero", "files": { ".sqlfluff": "[sqlfluff]\nrules = 0\n" } },
  { "name": "rules-lowercase", "files": { ".sqlfluff": "[sqlfluff]\nrules = cv05,al04\n" } },
  { "name": "rules-spaced", "files": { ".sqlfluff": "[sqlfluff]\nrules =  AL04 ,  CV05 ,\n" } },
  { "name": "rules-continued", "files": { ".sqlfluff": "[sqlfluff]\nrules = AL04,\n    CV05,\n    ST01\n" } },
  { "name": "exclude-codes", "files": { ".sqlfluff": "[sqlfluff]\nexclude_rules = AL04,L049\n" } },
  { "name": "exclude-core", "files": { ".sqlfluff": "[sqlfluff]\nexclude_rules = core\n" } },
  { "name": "exclude-glob", "files": { ".sqlfluff": "[sqlfluff]\nexclude_rules = ST*,references.*\n" } },
  { "name": "rules-and-exclude", "files": { ".sqlfluff": "[sqlfluff]\nrules = core\nexclude_rules = AL04,aliasing.unused\n" } },
  { "name": "precedence-ini", "files": { "setup.cfg": "[sqlfluff]\nrules = AL04\nexclude_rules = CV05\n", "tox.ini": "[sqlfluff]\nrules = AL05,CV05\n", "pep8.ini": "[sqlfluff]\nexclude_rules = AL05\n" } },
  { "name": "precedence-sqlfluff", "files": { "setup.cfg": "[sqlfluff]\nrules = AL04\n", ".sqlfluff": "[sqlfluff]\nrules = CV05,AL04\n", "tox.ini": "[sqlfluff]\nexclude_rules = AL04\n" } },
  { "name": "precedence-pyproject", "files": { ".sqlfluff": "[sqlfluff]\nrules = CV05\n", "pyproject.toml": "[tool.sqlfluff.core]\nrules = \"ST01,ST02\"\n" } },
  { "name": "setup-cfg-other-sections", "files": { "setup.cfg": "[flake8]\nmax-line-length = 100\n", ".sqlfluff": "[sqlfluff]\nexclude_rules = ST01\n" } },
  { "name": "toml-list", "files": { "pyproject.toml": "[tool.sqlfluff.core]\nrules = [\"AL04\", \"CV05\", \"structure\"]\nexclude_rules = [\"ST02\"]\n" } },
  { "name": "toml-list-spaced", "files": { "pyproject.toml": "[tool.sqlfluff.core]\nrules = [\" AL04\", \"CV05\"]\n" } },
  { "name": "toml-empty-list", "files": { "pyproject.toml": "[tool.sqlfluff.core]\nrules = []\nexclude_rules = \"\"\n" } },
  { "name": "force-enable-ini", "files": { ".sqlfluff": "[sqlfluff]\ndialect = postgres\n\n[sqlfluff:rules:postgres.excessive_locks]\nforce_enable = True\n\n[sqlfluff:rules:postgres.not_valid_foreign_key]\nforce_enable = False\n" } },
  { "name": "force-enable-generic", "files": { ".sqlfluff": "[sqlfluff]\n\n[sqlfluff:rules]\nforce_enable = True\n" } },
