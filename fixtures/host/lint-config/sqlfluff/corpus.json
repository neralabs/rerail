  { "name": "force-enable-excluded", "files": { ".sqlfluff": "[sqlfluff]\nexclude_rules = PG01\n\n[sqlfluff:rules:postgres.excessive_locks]\nforce_enable = True\n" } },
  { "name": "force-enable-toml", "unknown": [""], "files": { "pyproject.toml": "[tool.sqlfluff.rules.\"postgres.excessive_locks\"]\nforce_enable = true\n\n[tool.sqlfluff.rules.postgres.not_valid_foreign_key]\nforce_enable = \"False\"\n" } },
  { "name": "force-enable-toml-false", "files": { "pyproject.toml": "[tool.sqlfluff.core]\nrules = \"postgres\"\n\n[tool.sqlfluff.rules.\"postgres.excessive_locks\"]\nforce_enable = false\n\n[tool.sqlfluff.rules.\"postgres.not_valid_foreign_key\"]\nforce_enable = 1\n" } },
  { "name": "force-enable-invalid-unselected", "unknown": [""], "files": { ".sqlfluff": "[sqlfluff]\nrules = AL04\n\n[sqlfluff:rules:postgres.excessive_locks]\nforce_enable = yes\n" } },
  { "name": "nested-rules", "files": { ".sqlfluff": "[sqlfluff]\nrules = AL04\n", "models/.sqlfluff": "[sqlfluff]\nrules = CV05\n" } },
  { "name": "nested-exclude-replaces", "files": { ".sqlfluff": "[sqlfluff]\nexclude_rules = AL04\n", "models/staging/.sqlfluff": "[sqlfluff]\nexclude_rules = CV05\n" } },
  { "name": "nested-only", "files": { "models/.sqlfluff": "[sqlfluff]\nexclude_rules = core\n" } },
  { "name": "nested-pyproject", "files": { ".sqlfluff": "[sqlfluff]\nrules = core\n", "migrations/pyproject.toml": "[tool.sqlfluff.core]\nrules = \"postgres\"\n\n[tool.sqlfluff.rules.\"postgres.excessive_locks\"]\nforce_enable = true\n" } },
  { "name": "nested-setup-cfg", "files": { ".sqlfluff": "[sqlfluff]\nrules = AL04,CV05\n", "models/setup.cfg": "[sqlfluff]\nexclude_rules = AL04\n", "other/setup.cfg": "[metadata]\nname = x\n" } },
  { "name": "nested-force-enable", "files": { ".sqlfluff": "[sqlfluff:rules:postgres.excessive_locks]\nforce_enable = True\n", "migrations/.sqlfluff": "[sqlfluff:rules:postgres.excessive_locks]\nforce_enable = False\n" } },
  { "name": "nested-sections-only", "files": { ".sqlfluff": "[sqlfluff]\nrules = AL04,CV05\n", "models/.sqlfluff": "[sqlfluff:rules:aliasing.unique.table]\nforce_enable = True\n" } },
  { "name": "nested-unreadable", "files": { ".sqlfluff": "[sqlfluff]\nrules = AL04,CV05\n", "models/.sqlfluff": "[sqlfluff]\nrules = AL04\nrules = CV05\n" }, "unknown": [""] },
  { "name": "ignore-folders", "files": { ".sqlfluffignore": "# generated\n\nmodels/\nmigrations\n" } },
  { "name": "ignore-anchored", "files": { ".sqlfluffignore": "/models/staging\n/staging\n" } },
  { "name": "ignore-any-depth", "files": { ".sqlfluffignore": "staging\n", ".sqlfluff": "[sqlfluff]\nrules = AL04\n" } },
  { "name": "ignore-double-star", "files": { ".sqlfluffignore": "**/staging/**\nother/**\n" } },
  { "name": "ignore-glob", "unknown": [""], "files": { ".sqlfluffignore": "*.tmp.sql\n" } },
  { "name": "ignore-negation", "unknown": [""], "files": { ".sqlfluffignore": "models/\n!models/staging/\n" } },
  { "name": "ignore-nested", "files": { "models/.sqlfluffignore": "staging\n", ".sqlfluff": "[sqlfluff]\nexclude_rules = AL04\n" } },
  { "name": "ignore-nested-glob", "unknown": ["models"], "files": { "models/.sqlfluffignore": "st*\n" } },
  { "name": "ignore-file", "noted": ["other/legacy.sql"], "files": { ".sqlfluffignore": "legacy.sql\n", "other/legacy.sql": "select 1\n", "migrations/current.sql": "select 1\n" } },
  { "name": "ignore-paths-ini", "files": { ".sqlfluff": "[sqlfluff]\nignore_paths = migrations, other\n" } },
  { "name": "ignore-paths-toml", "files": { "pyproject.toml": "[tool.sqlfluff.core]\nignore_paths = [\"models/staging\", \"other/\"]\nrules = \"AL04,CV05\"\n" } },
  { "name": "ignore-paths-other-ini", "files": { "setup.cfg": "[sqlfluff]\nignore_paths = models\n" } },
  { "name": "ignore-config-inside", "files": { ".sqlfluffignore": "models\n", "models/.sqlfluff": "[sqlfluff]\nrules = AL04\n", "models/staging/.sqlfluff": "[sqlfluff]\nrules = CV05\n" } }
 ]
