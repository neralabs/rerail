  "originalSignerFunctions": "def compute_allowlist_message(\n    linter_name: str,\n    entries: list[str],\n    *,\n    version: int = 1,\n) -> bytes:\n    \"\"\"Compute canonical message for an allowlist.\n\n    Args:\n        linter_name: Identifier for the linter owning this allowlist.\n        entries: Sorted list of allowlist entries.\n        version: Schema version (bump when canonical format changes).\n    \"\"\"\n    canonical: dict[str, object] = {\n        \"allowlist\": entries,\n        \"linter\": linter_name,\n        \"version\": version,\n    }\n    return json.dumps(canonical, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n\n\ndef sign_allowlist(\n    linter_name: str,\n    entries: list[str],\n    *,\n    version: int = 1,\n) -> str | None:\n    \"\"\"Sign an allowlist. Returns base64 signature or None on error.\"\"\"\n    try:\n        import nacl.signing\n    except ImportError:\n        print(\"ERROR: PyNaCl not installed. Run: uv add pynacl\", file=sys.stderr)\n        return None\n\n    key_hex: str | None = os.environ.get(\"NERA_SIGNING_KEY\")\n    if not key_hex:\n        print(\"ERROR: NERA_SIGNING_KEY environment variable not set.\", file=sys.stderr)\n        print(\n            \"Only the user may have access to NERA_SIGNING_KEY. Ask the user to run the \"\n            \"documented `uv run ... --sign-allowlist` command in an environment where \"\n            \"the key is already present.\",\n            file=sys.stderr,\n        )\n        print(\n            \"AI agents must never have access to this proof-of-human key and must never try to obtain it.\",\n            file=sys.stderr,\n        )\n        return None\n\n    try:\n        key_bytes: bytes = bytes.fromhex(key_hex)\n        if len(key_bytes) != 32:\n            print(\"ERROR: NERA_SIGNING_KEY must be 32 bytes\", file=sys.stderr)\n            return None\n    except ValueError as e:\n        print(f\"ERROR: Failed to decode NERA_SIGNING_KEY: {e}\", file=sys.stderr)\n        return None\n\n    signing_key = nacl.signing.SigningKey(key_bytes)\n    message: bytes = compute_allowlist_message(linter_name, entries, version=version)\n    signed = signing_key.sign(message)\n    return base64.b64encode(signed.signature).decode(\"ascii\")\n\n\ndef update_signature_in_file(\n    script_path: Path,\n    variable_name: str,\n    new_signature: str,\n) -> bool:\n    \"\"\"Update a signature variable in a Python script in-place.\n\n    Finds a line matching ``variable_name = \"...\"``,\n    ``variable_name: str = \"...\"``, or a pending sentinel assignment such as\n    ``variable_name: str = NEEDS_SIGNING`` and replaces the value.\n\n    Returns True if the file was updated.\n    \"\"\"\n    source: str = script_path.read_text(encoding=\"utf-8\")\n\n    # Match: VAR = \"...\", VAR: str = \"...\", or bare sentinel constants used\n    # before a maintainer signature has been generated.\n    pattern: str = (\n        rf\"^({re.escape(variable_name)}(?:\\s*:\\s*str)?\\s*=\\s*)\"\n        rf'(?:\"[^\"]*\"|NEEDS_SIGNING|UNSIGNED)(.*)'\n    )\n    new_source, count = re.subn(\n        pattern,\n        rf'\\g<1>\"{new_signature}\"\\2',\n        source,\n        flags=re.MULTILINE,\n    )\n\n    if count == 0:\n        print(\n            f\"ERROR: Could not find {variable_name} in {script_path}\",\n            file=sys.stderr,\n        )\n        return False\n\n    script_path.write_text(new_source, encoding=\"utf-8\")\n    print(f\"Updated {variable_name} in {script_path}\")\n    return True\n\n\ndef sign_and_update_allowlist(\n    script_path: Path,\n    linter_name: str,\n    entries: list[str],\n    variable_name: str,\n    *,\n    version: int = 1,\n) -> bool:\n    \"\"\"Sign an allowlist and write the signature back into the script.\n\n    Args:\n        script_path: Path to the linter script to modify.\n        linter_name: Linter identifier for the canonical message.\n        entries: Sorted allowlist entries.\n        variable_name: Name of the signature variable in the script.\n        version: Schema version.\n\n    Returns:\n        True if signature was written successfully.\n    \"\"\"\n    sig: str | None = sign_allowlist(linter_name, entries, version=version)\n    if sig is None:\n        return False\n    return update_signature_in_file(script_path, variable_name, sig)\n",
