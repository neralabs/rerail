{
  "kind": "code",
  "rule": {
    "format": "rerail.policy/v1",
    "id": "local:spacing-on-4pt-scale",
    "revision": 1,
    "mode": "steer",
    "description": "Keep padding, margin and gaps on the 4-point scale (4, 8, 12, 16, 20, 24, 32, 40, 48); no half steps or arbitrary values.",
    "scope": {
      "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ],
      "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/types/database.ts",
        "src/theme/**"
      ]
    },
    "clauses": [
      {
        "id": "half-step",
        "forbid": {
          "regex": {
            "pattern": "(?:^|[\\s'\"`:])-?(?:p[xytrblse]?|m[xytrblse]?|gap(?:-[xy])?|space-[xy])-[0-9]+\\.5\\b",
            "source": "file.content"
          }
        },
        "violation": {
          "code": "HALF_STEP_SPACING",
          "anchor": "witness.span",
          "message": "Use a whole step instead of this half step: 0.5 becomes 1, 1.5 becomes 1 or 2, 2.5 becomes 2 or 3, 3.5 becomes 3 or 4 (1 step = 4 pt)."
        }
      },
      {
        "id": "arbitrary",
        "forbid": {
          "regex": {
            "pattern": "(?:^|[\\s'\"`:])-?(?:p[xytrblse]?|m[xytrblse]?|gap(?:-[xy])?|space-[xy])-\\[[^\\]\\s-][^\\]\\s]*\\]",
            "source": "file.content"
          }
        },
        "violation": {
          "code": "ARBITRARY_SPACING",
          "anchor": "witness.span",
          "message": "Replace this arbitrary value with the nearest step on the 4-point scale (1=4, 2=8, 3=12, 4=16, 5=20, 6=24, 8=32, 10=40, 12=48)."
        }
      },
      {
        "id": "off-scale",
        "forbid": {
          "regex": {
            "pattern": "(?:^|[\\s'\"`:])-?(?:p[xytrblse]?|m[xytrblse]?|gap(?:-[xy])?|space-[xy])-(?:7|9|11|1[3-9]|[2-9][0-9]|[1-9][0-9]{2})\\b",
            "source": "file.content"
          }
        },
        "violation": {
          "code": "OFF_SCALE_SPACING",
          "anchor": "witness.span",
          "message": "Use a step on the 4-point scale (1, 2, 3, 4, 5, 6, 8, 10, 12 = 4 to 48 pt). If this clears a tab bar or button, pad by its measured height instead."
        }
      }
    ]
  },
  "cases": {
    "caught": [
      {
        "path": "src/app/(tabs)/plans.tsx",
        "content": "<ScrollView contentContainerClassName=\"gap-3.5 px-5 pb-6 pt-1\" />\n"
      },
      {
        "path": "src/components/attention-card.tsx",
        "content": "<Pressable className=\"flex-row gap-3 px-3.5 py-3\" />\n"
      },
      {
        "path": "src/app/a.tsx",
        "content": "<View className=\"m-[7px]\" />\n"
      },
      {
        "path": "src/app/b.tsx",
        "content": "<View className=\"pt-14 -mt-7\" />\n"
      }
    ],
    "passed": [
      {
        "path": "src/app/c.tsx",
        "content": "<View className=\"gap-6 px-5 pb-10 pt-2 p-12 -mt-1 mt-auto space-x-reverse\" />\n"
      },
      {
        "path": "src/app/d.tsx",
        "content": "<Button className=\"h-[52px] size-11 min-w-[88px] top-0.5\" />\n"
      },
      {
        "path": "src/app/d2.tsx",
        "content": "<View className=\"mt-[-1px] border-hairline\" />\n"
      }
    ]
  }
}