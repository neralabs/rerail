      },
      "policy": "rules/probe-cjs-scope-bindings.json",
      "capabilities": [
        "syntax",
        "scope"
      ],
      "match": "line+column"
    },
    {
      "id": "probe-cjs-wrapper-scope",
      "upstream": {
        "tool": "labels",
        "rule": "probe-cjs-wrapper-scope"
      },
      "policy": "rules/probe-cjs-wrapper-scope.json",
