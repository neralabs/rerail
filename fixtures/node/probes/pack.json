{
  "pack": "node-probes",
  "family": "ecma",
  "capabilities": [
    "syntax",
    "scope",
    "value"
  ],
  "corpora": [],
  "tools": [
    {
      "name": "labels",
      "version": "1"
    }
  ],
  "oracles": ".",
