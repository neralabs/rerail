{
  "format": "rerail.rule-pack/v1",
  "id": "vue",
  "name": "Vue",
  "category": "framework",
  "covers": "A fixture pack for Vue, a language core plans but does not read yet.",
  "reason": "matches Vue",
  "match": {
    "any": [
      {
        "files": [
          "**/*.vue"
        ],
        "label": "*.vue files"
      }
    ]
  },
  "rules": [
    {
      "id": "no-v-html",
      "document": "rules/no-v-html.json",
      "title": "No v-html",
      "group": "Vue",
      "examples": {
        "caught": {
          "path": "src/App.vue",
          "text": "<template><div v-html=\"html\"></div></template>\n"
        },
        "passes": {
          "path": "src/App.vue",
          "text": "<template><div>{{ text }}</div></template>\n"
        }
      }
    }
  ]
}
