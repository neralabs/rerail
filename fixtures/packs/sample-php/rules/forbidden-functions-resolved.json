{
  "format": "rerail.policy/v1",
  "id": "forbidden-functions-resolved",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid calls that PHP resolves to sizeof or delete; files with syntax errors are skipped, since an error could hide a declaration.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "forbidden-function-call",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "kind": "function_call_expression",
            "has": {
              "field": "function",
              "resolves": {
                "import": [
                  "sizeof",
                  "delete"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "Generic.PHP.ForbiddenFunctions.FoundWithAlternative",
        "message": "Replace this call to a forbidden function."
      }
    }
  ]
}
