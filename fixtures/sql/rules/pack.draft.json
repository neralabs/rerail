{
  "$comment": "Draft T4 manifest for the future SQL pack (NER-1698). Not under rerail/conformance/languages/ because the kernel has no SQL family yet and the runner would load it; the policies named here are written once the engine exists. `dialects` is a proposed manifest field: per-path dialect selection (docs/design/rerail-pack-sql.md). `paths` are the globs the generators score.",
  "pack": "sql",
  "family": "sql",
  "ticket": "NER-1698",
  "capabilities": [
    "syntax",
    "names",
    "values",
    "suppression"
  ],
  "corpora": [
    {
      "name": "postgres",
      "repository": "https://github.com/postgres/postgres",
      "commit": "724edf9bde9d356724ad384a2e196edc3c9f80f7",
      "paths": [
        "src/test/regress/sql/*.sql",
        "src/pl/plpgsql/src/sql/*.sql",
        "contrib/**/*.sql",
        "src/backend/catalog/*.sql"
      ],
      "exclude": [],
      "dialects": [
        {
          "glob": "src/test/regress/sql/*.sql",
          "dialect": "postgres"
        },
        {
          "glob": "src/pl/plpgsql/src/sql/*.sql",
          "dialect": "postgres"
        },
        {
          "glob": "contrib/**/*.sql",
          "dialect": "postgres"
        },
        {
          "glob": "src/backend/catalog/*.sql",
          "dialect": "postgres"
        }
      ]
    },
    {
      "name": "mattermost",
      "repository": "https://github.com/mattermost/mattermost",
      "commit": "613bb616cd62c584a606919e6978688e7b87d81e",
      "paths": [
        "server/channels/db/migrations/postgres/*.sql",
        "server/channels/db/migrations/mysql/*.sql"
      ],
      "exclude": [],
      "dialects": [
        {
          "glob": "server/channels/db/migrations/postgres/*.sql",
          "dialect": "postgres"
        },
        {
          "glob": "server/channels/db/migrations/mysql/*.sql",
          "dialect": "mysql"
        }
      ]
    },
    {
      "name": "anki",
      "repository": "https://github.com/ankitects/anki",
      "commit": "d52ca669f6deac5966b1c5035bc2dc77c78d3260",
      "paths": [
        "rslib/src/**/*.sql"
      ],
      "exclude": [],
      "dialects": [
        {
          "glob": "rslib/src/**/*.sql",
          "dialect": "sqlite"
        }
      ]
    },
    {
      "name": "application-services",
      "repository": "https://github.com/mozilla/application-services",
      "commit": "c19ea2c24eb2f116dae170f5f82054d325e94a42",
      "paths": [
        "components/**/*.sql"
      ],
      "exclude": [],
      "dialects": [
        {
          "glob": "components/**/*.sql",
          "dialect": "sqlite"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "sqlfluff",
      "version": "4.4.0"
    }
  ],
  "oracles": "rerail-fixtures/sql/rules",
  "rules": [
    {
      "id": "sqlfluff-al04-aliasing-unique-table",
      "upstream": {
        "tool": "sqlfluff",
        "rule": "AL04"
      },
      "policy": "rules/sqlfluff-al04-aliasing-unique-table.json",
      "capabilities": [
        "syntax",
        "names",
        "suppression"
      ],
