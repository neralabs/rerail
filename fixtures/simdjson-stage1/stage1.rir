; simdjson's stage 1 as a transducer block program. Outputs:
;   0 the structural starts;
;   1 control characters inside strings (simdjson's unescaped-characters error);
;   2 inside a string (its last bit set: an unclosed string);
;   3 UTF-8 errors (simdjson's lookup algorithm, utf8_lookup4);
;   4 a UTF-8 sequence still open (its last bit set: an incomplete sequence at the end).
; The extract pass writes output 0's positions: simdjson's structural indexes.
; Names follow simdjson's json_structural_indexer, json_scanner, json_string_scanner and
; utf8_lookup4_algorithm.
program -
  mode set=0 query=0
  ; simdjson's classify table: 0x01 , 0x02 : 0x04 [ ] { } 0x08 space 0x10 \t \n \r 0x20 \
  ; 0x40 " 0x80 every byte below 0x20.
  block 0 table 0 lo=8880c0808080808080909284a1948080 hi=90804902002400040000000000000000
  ; UTF-8: simdjson's byte_1_low (lo) and byte_1_high (hi), read at the byte before; bits
  ; 0x01 TOO_SHORT 0x02 TOO_LONG 0x04 OVERLONG_3 0x08 TOO_LARGE 0x10 SURROGATE 0x20 OVERLONG_2
  ; 0x40 TOO_LARGE_1000 and OVERLONG_4 0x80 TWO_CONTS.
  block 0 table 1 lo=e7a383838bcbcbcbcbcbcbcbcbdbcbcb hi=02020202020202028080808021011549
  ; byte_2_high, read at the byte itself (every low nibble).
  block 0 table 2 lo=ffffffffffffffffffffffffffffffff hi=0101010101010101e6aebaba01010101
  ; 0x01 at least 0xe0, 0x02 at least 0xf0, 0x04 at least 0xc0, 0x08 at least 0x80.
  block 0 table 3 lo=ffffffffffffffffffffffffffffffff hi=0000000000000000080808080c0c0d0f
  block 0 %0 = class t0 0x07      ; op
  block 0 %1 = class t0 0x18      ; whitespace
  block 0 %2 = class t0 0x20      ; backslash
  block 0 %3 = class t0 0x40      ; raw quote
  block 0 %4 = class t0 0x80      ; unescaped (control characters)
  block 0 %5 = after_odd_run %2   ; escaped
  block 0 %6 = andnot %3, %5      ; quote
  block 0 %7 = toggle %6          ; in_string: prefix_xor(quote)
  block 0 %8 = xor %7, %6         ; string_tail
  block 0 %9 = or %0, %1
  block 0 %10 = not %9            ; scalar
  block 0 %11 = andnot %10, %6    ; nonquote_scalar
  block 0 %12 = prev %11, 1       ; follows_nonquote_scalar
  block 0 %13 = andnot %10, %12   ; potential_scalar_start
  block 0 %14 = or %0, %13        ; potential_structural_start
  block 0 %15 = andnot %14, %8    ; structural_start
  block 0 %16 = and %4, %7        ; non_quote_inside_string(unescaped)
  block 0 %17 = class t1 0x01
  block 0 %18 = prev %17, 1
  block 0 %19 = class t2 0x01
  block 0 %20 = and %18, %19      ; special case 0x01
  block 0 %21 = class t3 0x08      ; at least 0x80: not TOO_LONG's byte-before class
  block 0 %22 = prev %21, 1
  block 0 %23 = not %22          ; the byte before is ASCII (or the stream's start)
  block 0 %24 = class t2 0x02
  block 0 %25 = and %23, %24      ; special case 0x02
  block 0 %26 = class t1 0x04
  block 0 %27 = prev %26, 1
  block 0 %28 = class t2 0x04
  block 0 %29 = and %27, %28      ; special case 0x04
  block 0 %30 = class t1 0x08
  block 0 %31 = prev %30, 1
  block 0 %32 = class t2 0x08
  block 0 %33 = and %31, %32      ; special case 0x08
  block 0 %34 = class t1 0x10
  block 0 %35 = prev %34, 1
  block 0 %36 = class t2 0x10
  block 0 %37 = and %35, %36      ; special case 0x10
  block 0 %38 = class t1 0x20
  block 0 %39 = prev %38, 1
  block 0 %40 = class t2 0x20
  block 0 %41 = and %39, %40      ; special case 0x20
  block 0 %42 = class t1 0x40
  block 0 %43 = prev %42, 1
  block 0 %44 = class t2 0x40
  block 0 %45 = and %43, %44      ; special case 0x40
  block 0 %46 = class t1 0x80
  block 0 %47 = prev %46, 1
  block 0 %48 = class t2 0x80
  block 0 %49 = and %47, %48      ; special case 0x80
  block 0 %50 = or %20, %25
  block 0 %51 = or %50, %29
  block 0 %52 = or %51, %33
  block 0 %53 = or %52, %37
  block 0 %54 = or %53, %41
  block 0 %55 = or %54, %45
  block 0 %56 = class t3 0x01      ; at least 0xe0
  block 0 %57 = class t3 0x02      ; at least 0xf0
  block 0 %58 = class t3 0x04      ; at least 0xc0
  block 0 %59 = prev %56, 2
  block 0 %60 = prev %57, 3
  block 0 %61 = or %59, %60    ; must_be_2_3_continuation
  block 0 %62 = xor %61, %49   ; must be one exactly when TWO_CONTS
  block 0 %63 = or %55, %62    ; UTF-8 error
  block 0 %64 = prev %56, 1
  block 0 %65 = prev %57, 2
  block 0 %66 = or %58, %64
  block 0 %67 = or %66, %65  ; a sequence still open after the byte
  block 0 output %15
  block 0 output %16
  block 0 output %7
  block 0 output %63
  block 0 output %67
  ; The extract pass: the structural starts' positions, simdjson's structural indexes.
  block 0 extract %15
  0000 STOP 0
