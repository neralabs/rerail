{
  "format": "rerail.policy/v1",
  "id": "tslint:no-var-keyword",
  "revision": 1,
  "description": "Port of TSLint's `no-var-keyword` rule with its default options (https://palantir.github.io/tslint/rules/no-var-keyword/). Disallows usage of the var keyword; `declare var` and `declare global { var }` are allowed.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "var-keyword",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "pattern": "var"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "variable_declaration",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "ambient_declaration"
                    }
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "variable_declaration",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "statement_block",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "ambient_declaration"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_VAR_KEYWORD",
        "severity": "error",
        "message": "Forbidden 'var' keyword, use 'let' or 'const' instead",
        "fix": "let"
      }
    }
  ]
}
