{
  "format": "rerail.policy/v1",
  "id": "tslint:variable-name",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `variable-name` rule with its default options (https://palantir.github.io/tslint/rules/variable-name/). Checks variable/parameter/property names for lowerCamelCase or UPPER_CASE; alias exemption via same-metavar patterns.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "format",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "^_.*\\p{Ll}|\\p{Ll}.*_$|^\\p{Lu}.*\\p{Ll}|^(?:.*\\p{Ll}.*_.+|.+_.*\\p{Ll}.*)$",
            "matches": "format-target",
            "not": {
              "inside": {
                "stopBy": "end",
                "matches": "declare-statement"
              }
            }
          },
          "utils": {
            "format-target": {
              "any": [
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "variable_declarator",
                    "not": {
                      "matches": "alias-declarator"
                    }
                  },
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "^=$"
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "required_parameter"
                      },
                      {
                        "kind": "optional_parameter"
                      },
                      {
                        "kind": "assignment_pattern"
                      }
                    ]
                  },
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "^=$"
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "array_pattern"
                      },
                      {
                        "kind": "rest_pattern"
                      }
                    ]
                  }
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "pair_pattern"
                  },
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^:$"
                  }
                },
                {
                  "kind": "property_identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "public_field_definition",
                    "not": {
                      "matches": "alias-field"
                    }
                  }
                }
              ]
            },
            "alias-declarator": {
              "any": [
                {
                  "pattern": {
                    "context": "var $N = $N",
                    "selector": "variable_declarator"
                  }
                },
                {
                  "pattern": {
                    "context": "var $N = $O.$N",
                    "selector": "variable_declarator"
                  }
                }
              ]
            },
            "alias-field": {
              "any": [
                {
                  "pattern": {
                    "context": "class A { $N = $N }",
                    "selector": "public_field_definition"
                  }
                },
                {
                  "pattern": {
                    "context": "class A { $N = $O.$N }",
                    "selector": "public_field_definition"
                  }
                }
              ]
            },
            "declare-statement": {
              "any": [
                {
                  "kind": "lexical_declaration"
                },
                {
                  "kind": "variable_declaration"
                }
              ],
              "inside": {
                "stopBy": "neighbor",
                "kind": "ambient_declaration"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "VARIABLE_NAME",
        "message": "variable name must be in lowerCamelCase or UPPER_CASE"
      }
    }
  ]
}
