{
  "format": "rerail.policy/v1",
  "id": "tslint:class-name",
  "revision": 1,
  "description": "Port of TSLint's `class-name` rule with its default options (https://palantir.github.io/tslint/rules/class-name/). Enforces PascalCased class and interface names.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "class-name",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "type_identifier"
              },
              {
                "regex": "^[a-z]|[_-]"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "class_declaration"
                    },
                    {
                      "kind": "class"
                    },
                    {
                      "kind": "abstract_class_declaration"
                    },
                    {
                      "kind": "interface_declaration"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "CLASS_NAME",
        "severity": "error",
        "message": "Class name must be in pascal case"
      }
    }
  ]
}
