{
  "format": "rerail.policy/v1",
  "id": "tslint:no-misused-new",
  "revision": 1,
  "description": "Port of TSLint's `no-misused-new` rule with its default options (https://palantir.github.io/tslint/rules/no-misused-new/). Warns on `constructor` signatures in interfaces/type literals, on `new(): Self` construct signatures in interfaces, and on body-less `new(): Self` methods in classes, Self being the declaring type's name (bound from the return type).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "interface-new-returns-self",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "construct_signature",
                "has": {
                  "kind": "type_annotation",
                  "has": {
                    "any": [
                      {
                        "kind": "type_identifier",
                        "pattern": "$N"
                      },
                      {
                        "kind": "generic_type",
                        "has": {
                          "kind": "type_identifier",
                          "pattern": "$N"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "inside": {
                  "kind": "interface_body",
                  "inside": {
                    "kind": "interface_declaration",
                    "has": {
                      "kind": "type_identifier",
                      "pattern": "$N"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_MISUSED_NEW",
        "severity": "error",
        "message": "Interfaces cannot be constructed, only classes. Did you mean `declare class`?"
      }
    },
    {
      "id": "constructor-signature",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "method_signature"
              },
              {
                "regex": "^[\"']?constructor[\"']?\\s*[<(]"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "interface_body"
                    },
                    {
                      "kind": "object_type"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_MISUSED_NEW",
        "severity": "error",
        "message": "Interfaces cannot be constructed, only classes. Did you mean `declare class`?"
      }
    },
    {
      "id": "class-new-method",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "method_signature"
                  },
                  {
                    "kind": "abstract_method_signature"
                  }
                ]
              },
              {
                "has": {
                  "any": [
                    {
                      "kind": "property_identifier",
                      "regex": "^new$"
                    },
                    {
                      "kind": "string",
                      "regex": "^[\"']new[\"']$"
                    }
                  ]
                }
              },
              {
                "has": {
                  "kind": "type_annotation",
                  "has": {
                    "any": [
                      {
                        "kind": "type_identifier",
                        "pattern": "$N"
                      },
                      {
                        "kind": "generic_type",
                        "has": {
                          "kind": "type_identifier",
                          "pattern": "$N"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "inside": {
                  "kind": "class_body",
                  "inside": {
                    "any": [
                      {
                        "kind": "class_declaration"
                      },
                      {
                        "kind": "abstract_class_declaration"
                      },
                      {
                        "kind": "class"
                      }
                    ],
                    "has": {
                      "kind": "type_identifier",
                      "pattern": "$N"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_MISUSED_NEW",
        "severity": "error",
        "message": "`new` in a class is a method named \"new\". Did you mean `constructor`?"
      }
    }
  ]
}
