{
  "format": "rerail.policy/v1",
  "id": "tslint:typeof-compare",
  "revision": 1,
  "description": "Port of TSLint's `typeof-compare` rule with its default options (https://palantir.github.io/tslint/rules/typeof-compare/). Ensures typeof expressions are only compared to valid typeof result literals.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "faulty-typeof",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "binary_expression"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "regex": "^(==|!=|===|!==)$"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "kind": "unary_expression"
                    },
                    {
                      "regex": "^typeof\\b"
                    }
                  ]
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "all": [
                        {
                          "kind": "string"
                        },
                        {
                          "not": {
                            "regex": "^[\"'](undefined|string|boolean|number|function|object|symbol)[\"']$"
                          }
                        }
                      ]
                    },
                    {
                      "kind": "undefined"
                    },
                    {
                      "kind": "null"
                    },
                    {
                      "kind": "number"
                    },
                    {
                      "kind": "true"
                    },
                    {
                      "kind": "false"
                    },
                    {
                      "kind": "object"
                    },
                    {
                      "kind": "array"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "TYPEOF_COMPARE",
        "severity": "error",
        "message": "'typeof' expression must be compared to one of: \"undefined\", \"string\", \"boolean\", \"number\", \"function\", \"object\", \"symbol\""
      }
    }
  ]
}
