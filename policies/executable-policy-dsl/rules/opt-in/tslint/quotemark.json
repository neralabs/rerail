{
  "format": "rerail.policy/v1",
  "id": "tslint:quotemark",
  "revision": 1,
  "description": "Port of TSLint's `quotemark` rule with its default options (https://palantir.github.io/tslint/rules/quotemark/). Enforces double-quoted string literals (TSLint default option: double).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "double",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string"
              },
              {
                "regex": "^'"
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "QUOTEMARK",
        "severity": "error",
        "message": "' should be \""
      }
    }
  ]
}
