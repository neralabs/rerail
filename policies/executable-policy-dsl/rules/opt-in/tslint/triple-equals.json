{
  "format": "rerail.policy/v1",
  "id": "tslint:triple-equals",
  "revision": 1,
  "description": "Port of TSLint's `triple-equals` rule with its default options (https://palantir.github.io/tslint/rules/triple-equals/). Requires === and !== in place of == and != (TSLint default: no exceptions).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "loose-eq",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^==$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "binary_expression"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "TRIPLE_EQUALS",
        "severity": "error",
        "message": "== should be ==="
      }
    },
    {
      "id": "loose-neq",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^!=$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "binary_expression"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "TRIPLE_EQUALS",
        "severity": "error",
        "message": "!= should be !=="
      }
    }
  ]
}
