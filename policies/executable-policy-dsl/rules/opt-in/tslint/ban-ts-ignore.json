{
  "format": "rerail.policy/v1",
  "id": "tslint:ban-ts-ignore",
  "revision": 1,
  "description": "Port of TSLint's `ban-ts-ignore` rule with its default options (https://palantir.github.io/tslint/rules/ban-ts-ignore/). Bans `// @ts-ignore` comments.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "ts-ignore-comment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "comment"
              },
              {
                "regex": "^///?\\s*@ts-ignore"
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "BAN_TS_IGNORE",
        "severity": "error",
        "message": "Do not use \"// @ts-ignore\" comments because they suppress compilation errors."
      }
    }
  ]
}
