{
  "format": "rerail.policy/v1",
  "id": "tslint:no-default-export",
  "revision": 1,
  "description": "Port of TSLint's `no-default-export` rule with its default options (https://palantir.github.io/tslint/rules/no-default-export/). Disallows default exports in ES6-style modules.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts",
      "**/*.d.ts"
    ]
  },
  "checks": [
    {
      "id": "default-export",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^default$"
              },
              {
                "not": {
                  "kind": "identifier"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "export_statement",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "program"
                  }
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_DEFAULT_EXPORT",
        "severity": "error",
        "message": "Use of default exports is forbidden"
      }
    }
  ]
}
