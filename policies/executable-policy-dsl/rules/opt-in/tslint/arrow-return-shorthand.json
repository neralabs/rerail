{
  "format": "rerail.policy/v1",
  "id": "tslint:arrow-return-shorthand",
  "revision": 1,
  "description": "Port of TSLint's `arrow-return-shorthand` rule with its default options (https://palantir.github.io/tslint/rules/arrow-return-shorthand/). Arrow bodies whose only statement (comments aside) is `return <expr>` should use the expression form (default: single-line bodies only). The fix replaces the block with the expression, parenthesising an object literal; as in TSLint, no fix when a comment sits between the tokens.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "block-body",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "matches": "body"
              },
              {
                "not": {
                  "matches": "commented"
                }
              },
              {
                "not": {
                  "has": {
                    "kind": "return_statement",
                    "has": {
                      "kind": "object"
                    }
                  }
                }
              }
            ]
          },
          "utils": {
            "body": {
              "kind": "statement_block",
              "inside": {
                "kind": "arrow_function"
              },
              "has": {
                "kind": "return_statement",
                "follows": {
                  "matches": "block-open"
                },
                "precedes": {
                  "matches": "block-close"
                },
                "has": {
                  "pattern": "$E",
                  "not": {
                    "kind": "comment"
                  }
                }
              },
              "regex": "^[^\\n]*$"
            },
            "block-open": {
              "any": [
                {
                  "regex": "^\\{$"
                },
                {
                  "kind": "comment",
                  "follows": {
                    "matches": "block-open"
                  }
                }
              ]
            },
            "block-close": {
              "any": [
                {
                  "regex": "^\\}$"
                },
                {
                  "kind": "comment",
                  "precedes": {
                    "matches": "block-close"
                  }
                }
              ]
            },
            "commented": {
              "any": [
                {
                  "follows": {
                    "kind": "comment"
                  }
                },
                {
                  "has": {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "kind": "return_statement",
                        "has": {
                          "kind": "comment"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "ARROW_RETURN_SHORTHAND",
        "severity": "error",
        "message": "This arrow function body can be simplified by omitting the curly braces and the keyword 'return'.",
        "fix": "$E"
      }
    },
    {
      "id": "block-body-object",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "matches": "body"
              },
              {
                "not": {
                  "matches": "commented"
                }
              },
              {
                "has": {
                  "kind": "return_statement",
                  "has": {
                    "kind": "object",
                    "pattern": "$E"
                  }
                }
              }
            ]
          },
          "utils": {
            "body": {
              "kind": "statement_block",
              "inside": {
                "kind": "arrow_function"
              },
              "has": {
                "kind": "return_statement",
                "follows": {
                  "matches": "block-open"
                },
                "precedes": {
                  "matches": "block-close"
                },
                "has": {
                  "pattern": "$E",
                  "not": {
                    "kind": "comment"
                  }
                }
              },
              "regex": "^[^\\n]*$"
            },
            "block-open": {
              "any": [
                {
                  "regex": "^\\{$"
                },
                {
                  "kind": "comment",
                  "follows": {
                    "matches": "block-open"
                  }
                }
              ]
            },
            "block-close": {
              "any": [
                {
                  "regex": "^\\}$"
                },
                {
                  "kind": "comment",
                  "precedes": {
                    "matches": "block-close"
                  }
                }
              ]
            },
            "commented": {
              "any": [
                {
                  "follows": {
                    "kind": "comment"
                  }
                },
                {
                  "has": {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "kind": "return_statement",
                        "has": {
                          "kind": "comment"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "ARROW_RETURN_SHORTHAND",
        "severity": "error",
        "message": "This arrow function body can be simplified by omitting the curly braces and the keyword 'return', and wrapping the object literal in parentheses.",
        "fix": "($E)"
      }
    },
    {
      "id": "block-body-with-comment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "matches": "body"
              },
              {
                "matches": "commented"
              }
            ]
          },
          "utils": {
            "body": {
              "kind": "statement_block",
              "inside": {
                "kind": "arrow_function"
              },
              "has": {
                "kind": "return_statement",
                "follows": {
                  "matches": "block-open"
                },
                "precedes": {
                  "matches": "block-close"
                },
                "has": {
                  "pattern": "$E",
                  "not": {
                    "kind": "comment"
                  }
                }
              },
              "regex": "^[^\\n]*$"
            },
            "block-open": {
              "any": [
                {
                  "regex": "^\\{$"
                },
                {
                  "kind": "comment",
                  "follows": {
                    "matches": "block-open"
                  }
                }
              ]
            },
            "block-close": {
              "any": [
                {
                  "regex": "^\\}$"
                },
                {
                  "kind": "comment",
                  "precedes": {
                    "matches": "block-close"
                  }
                }
              ]
            },
            "commented": {
              "any": [
                {
                  "follows": {
                    "kind": "comment"
                  }
                },
                {
                  "has": {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "kind": "return_statement",
                        "has": {
                          "kind": "comment"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "ARROW_RETURN_SHORTHAND",
        "severity": "error",
        "message": "This arrow function body can be simplified by omitting the curly braces and the keyword 'return'."
      }
    }
  ]
}
