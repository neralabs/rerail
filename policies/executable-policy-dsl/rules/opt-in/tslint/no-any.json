{
  "format": "rerail.policy/v1",
  "id": "tslint:no-any",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-any` rule with its default options (https://palantir.github.io/tslint/rules/no-any/). Disallows usages of `any` as a type declaration.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "any-type",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "predefined_type"
              },
              {
                "regex": "^any$"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_ANY",
        "message": "Type declaration of 'any' loses type-safety. Consider replacing it with a more precise type."
      }
    }
  ]
}
