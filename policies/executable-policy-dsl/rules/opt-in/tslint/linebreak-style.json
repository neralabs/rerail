{
  "format": "rerail.policy/v1",
  "id": "tslint:linebreak-style",
  "revision": 1,
  "description": "Port of TSLint's `linebreak-style` rule with its default options (https://palantir.github.io/tslint/rules/linebreak-style/). Enforces LF line endings (TSLint default).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "crlf-line",
      "forbid": {
        "regex": {
          "source": "file.content",
          "pattern": "(?m)^[^\\r\\n]*\\r\\n"
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "LINEBREAK_STYLE",
        "severity": "error",
        "message": "Expected linebreak to be 'LF'"
      }
    }
  ]
}
