{
  "format": "rerail.policy/v1",
  "id": "tslint:switch-default",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `switch-default` rule with its default options (https://palantir.github.io/tslint/rules/switch-default/). Requires a default case in all switch statements.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "switch-without-default",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "switch_statement"
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "switch_body",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "switch_default"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SWITCH_DEFAULT",
        "message": "Switch statement should include a 'default' case"
      }
    }
  ]
}
