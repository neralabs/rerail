{
  "format": "rerail.policy/v1",
  "id": "tslint:no-duplicate-imports",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-duplicate-imports` rule with its default options (https://palantir.github.io/tslint/rules/no-duplicate-imports/). Disallows multiple imports from the same module: an import whose module text equals an earlier import's in the same statement list; in an external module, imports inside string-named ambient modules share the outer list (TSLint's module-augmentation case).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "duplicate-import",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "import_statement",
            "all": [
              {
                "matches": "import-of-M"
              },
              {
                "any": [
                  {
                    "follows": {
                      "stopBy": "end",
                      "matches": "earlier-import-of-M"
                    }
                  },
                  {
                    "inside": {
                      "kind": "statement_block",
                      "inside": {
                        "matches": "string-module",
                        "inside": {
                          "kind": "ambient_declaration",
                          "inside": {
                            "kind": "program",
                            "has": {
                              "any": [
                                {
                                  "kind": "import_statement"
                                },
                                {
                                  "kind": "export_statement"
                                }
                              ]
                            }
                          },
                          "follows": {
                            "stopBy": "end",
                            "matches": "earlier-import-of-M"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "utils": {
            "import-of-M": {
              "kind": "import_statement",
              "has": {
                "kind": "string",
                "has": {
                  "kind": "string_fragment",
                  "pattern": "$M"
                }
              }
            },
            "string-module": {
              "kind": "module",
              "has": {
                "kind": "string"
              }
            },
            "earlier-import-of-M": {
              "any": [
                {
                  "matches": "import-of-M"
                },
                {
                  "kind": "ambient_declaration",
                  "has": {
                    "matches": "string-module",
                    "has": {
                      "kind": "statement_block",
                      "has": {
                        "matches": "import-of-M"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_DUPLICATE_IMPORTS",
        "message": "Multiple imports from the same module can be combined into one."
      }
    }
  ]
}
