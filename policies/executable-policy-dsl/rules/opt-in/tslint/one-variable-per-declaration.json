{
  "format": "rerail.policy/v1",
  "id": "tslint:one-variable-per-declaration",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `one-variable-per-declaration` rule with its default options (https://palantir.github.io/tslint/rules/one-variable-per-declaration/). Disallows multiple variable definitions in the same declaration statement, including for-loop initializers.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "statement",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "variable_declaration"
                  },
                  {
                    "kind": "lexical_declaration"
                  }
                ]
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "variable_declarator",
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^,$"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "for_statement"
                      },
                      {
                        "kind": "export_statement"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "ONE_VARIABLE_PER_DECLARATION",
        "message": "Multiple variable declarations in the same statement are forbidden"
      }
    },
    {
      "id": "export-statement",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "export_statement"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "variable_declaration"
                        },
                        {
                          "kind": "lexical_declaration"
                        }
                      ]
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "variable_declarator",
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "^,$"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "ONE_VARIABLE_PER_DECLARATION",
        "message": "Multiple variable declarations in the same statement are forbidden"
      }
    },
    {
      "id": "for-initializer",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "variable_declaration"
                  },
                  {
                    "kind": "lexical_declaration"
                  }
                ]
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "variable_declarator",
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^,$"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "for_statement"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "ONE_VARIABLE_PER_DECLARATION",
        "message": "Multiple variable declarations in the same statement are forbidden"
      }
    }
  ]
}
