{
  "format": "rerail.policy/v1",
  "id": "tslint:no-eval",
  "revision": 1,
  "description": "Port of TSLint's `no-eval` rule with its default options (https://palantir.github.io/tslint/rules/no-eval/). Disallows eval function invocations.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "eval-call",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "identifier"
              },
              {
                "regex": "^eval$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "call_expression",
                  "pattern": "eval($$$ARGS)"
                }
              }
            ]
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_EVAL",
        "severity": "error",
        "message": "forbidden eval"
      }
    }
  ]
}
