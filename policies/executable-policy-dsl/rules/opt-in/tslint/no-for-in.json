{
  "format": "rerail.policy/v1",
  "id": "tslint:no-for-in",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-for-in` rule with its default options (https://palantir.github.io/tslint/rules/no-for-in/). Disallows iterating over an object with a for-in loop.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "for-in",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "for_in_statement"
              },
              {
                "regex": "^for\\s*\\(\\s*(?:(?:var|let|const)\\s+)?(?:[\\w$]+|\\[[^\\]]*\\]|\\{[^}]*\\})\\s*in\\b"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_FOR_IN",
        "message": "Use a for...of statement instead of for...in. If iterating over an object, use Object.keys() to access its enumerable keys."
      }
    }
  ]
}
