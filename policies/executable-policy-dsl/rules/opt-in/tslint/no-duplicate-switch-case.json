{
  "format": "rerail.policy/v1",
  "id": "tslint:no-duplicate-switch-case",
  "revision": 1,
  "description": "Port of TSLint's `no-duplicate-switch-case` rule with its default options (https://palantir.github.io/tslint/rules/no-duplicate-switch-case/). Prevents duplicate cases in switch statements: a case value textually equal to the value of an earlier case of the same switch (TSLint compares getText()).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "checks": [
    {
      "id": "duplicate-case",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "pattern": "$V",
            "follows": {
              "regex": "^case$"
            },
            "inside": {
              "kind": "switch_case",
              "follows": {
                "stopBy": "end",
                "kind": "switch_case",
                "has": {
                  "pattern": "$V",
                  "follows": {
                    "regex": "^case$"
                  }
                }
              }
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "NO_DUPLICATE_SWITCH_CASE",
        "severity": "error",
        "message": "Duplicate switch case."
      }
    }
  ]
}
