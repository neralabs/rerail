// calls_p3.rerail: the analysis phase's typing (P3 of decision 0083 §1, note t28) as a program of its own, for the oracle
// tests and the Jedi benchmark. Its rules are the library module python/points-to.rerail, which a rule includes
// (through python/calls and python/types) to have them in its own program; this program names their outputs.
#include "core.rerail"
#include "python/points-to.rerail"

.decl call_lib(c: node)
call_lib(c) :- pt_call_lib(c).
.decl base(c: node, b: node)
base(c, b) :- pt_base(c, b).
.decl finding(rule: symbol, n: node)
finding(r, n) :- pt_finding(r, n).
.decl async_open(c: node)
async_open(c) :- pt_async_open(c).
.decl chain_step(f: node, g: node)
chain_step(f, g) :- pt_chain_step(f, g).
.decl calls(f: node, g: node)
calls(f, g) :- pt_calls(f, g).
.output call_lib, call_target, call_open, base, finding, async_open, chain_step, calls
.output type_of, type_open, proven_type, possible_type, possible_open
