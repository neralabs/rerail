// The spike workload (../souffle/workload.dl) in Rerail's Datalog dialect.
// Tree structure comes from the tape: `nearest($n, $s, set)` is n's nearest strict ancestor whose kind is in `set`.
// No relation materializes it; the planner chooses a climb from n or a descent from s by cost.
// Its cross-file part is one fixpoint over every loaded document, as any program's is (decision 0065).

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl intval(n: node, v: number)
.decl op(n: node, s: symbol)
.input doc, node, child, field, text, intval, op, kind, docof

.decl scope(kind: symbol)
scope("module"). scope("function_definition"). scope("class_definition"). scope("lambda").

.decl kind(n: node, k: symbol)
.decl docof(n: node, d: number)
.decl modnode(d: number, m: node)
modnode(d, m) :- node(d, m, "module", _, _).
.decl finding(rule: symbol, n: node)
.output finding

// W1
.decl exc_type(n: node)
exc_type(n) :- kind(n, "identifier"), text(n, "Exception").
exc_type(n) :- kind(n, "parenthesized_expression"), child(n, c, _), exc_type(c).
.decl has_non_block(e: node)
has_non_block(e) :- kind(e, "except_clause"), child(e, c, _), !kind(c, "block").
.decl catch_all(e: node)
catch_all(e) :- kind(e, "except_clause"), !has_non_block(e).
catch_all(e) :- kind(e, "except_clause"), child(e, c, _), exc_type(c).
catch_all(e) :- kind(e, "except_clause"), child(e, c, _), kind(c, "as_pattern"), child(c, x, _), exc_type(x).
finding("B110", e) :- catch_all(e), child(e, b, _), kind(b, "block"), child(b, p, _), kind(p, "pass_statement"),
    k = count : { child(b, _, _) }, k = 1.

// W2
.decl seqkind(k: symbol)
seqkind("pattern_list"). seqkind("tuple_pattern"). seqkind("list_pattern").
seqkind("expression_list"). seqkind("tuple"). seqkind("list").
.decl mirror(l: node, r: node)
mirror(l, r) :- kind(a, "assignment"), field(a, "left", l), field(a, "right", r).
mirror(l2, r2) :- mirror(l, r), kind(l, kl), seqkind(kl), kind(r, kr), seqkind(kr), child(l, l2, i), child(r, r2, i).
finding("SELF_ASSIGN", l) :- mirror(l, r), kind(l, "identifier"), kind(r, "identifier"), text(l, s), text(r, s).

// W3
.decl binds(d: number, local: symbol, q: symbol)
binds(d, t, t) :- kind(i, "import_statement"), field(i, "name", n), kind(n, "dotted_name"), child(n, c, 0), text(c, t), docof(i, d).
binds(d, a, m) :- kind(i, "import_statement"), field(i, "name", x), kind(x, "aliased_import"),
    field(x, "name", n), text(n, m), field(x, "alias", al), text(al, a), docof(i, d).
binds(d, s, @dot(m, s)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), text(mn, m),
    field(i, "name", n), kind(n, "dotted_name"), text(n, s), docof(i, d).
binds(d, a, @dot(m, s)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), text(mn, m),
    field(i, "name", x), kind(x, "aliased_import"), field(x, "name", n), text(n, s), field(x, "alias", al), text(al, a), docof(i, d).
.decl resolves(n: node, q: symbol)
resolves(n, q) :- kind(n, "identifier"), text(n, s), docof(n, d), binds(d, s, q).
resolves(n, @dot(m, s)) :- kind(n, "attribute"), field(n, "object", o), resolves(o, m), field(n, "attribute", a), text(a, s).
.decl timeout_fn(q: symbol)
timeout_fn("urllib.request.urlopen"). timeout_fn("socket.create_connection").
timeout_fn("http.client.HTTPConnection"). timeout_fn("http.client.HTTPSConnection").
timeout_fn("subprocess.run"). timeout_fn("subprocess.check_output"). timeout_fn("subprocess.call"). timeout_fn("subprocess.check_call").
.decl kwarg(c: node, name: symbol, v: node)
kwarg(c, s, v) :- kind(c, "call"), field(c, "arguments", a), child(a, k, _), kind(k, "keyword_argument"),
    field(k, "name", nm), text(nm, s), field(k, "value", v).
.decl has_splat(c: node)
has_splat(c) :- kind(c, "call"), field(c, "arguments", a), child(a, k, _), kind(k, "dictionary_splat").
.decl has_timeout(c: node)
has_timeout(c) :- kwarg(c, "timeout", _).
finding("NO_TIMEOUT", c) :- kind(c, "call"), field(c, "function", f), resolves(f, q), timeout_fn(q), !has_timeout(c), !has_splat(c).
finding("NO_TIMEOUT", c) :- kind(c, "call"), field(c, "function", f), resolves(f, q), timeout_fn(q), kwarg(c, "timeout", v), kind(v, "none").

// W4
.decl lit_type(k: symbol, t: symbol)
lit_type("integer", "int"). lit_type("float", "float"). lit_type("string", "str"). lit_type("concatenated_string", "str").
lit_type("true", "bool"). lit_type("false", "bool"). lit_type("none", "None").
lit_type("list", "list"). lit_type("list_comprehension", "list"). lit_type("dictionary", "dict").
lit_type("dictionary_comprehension", "dict"). lit_type("set", "set"). lit_type("set_comprehension", "set"). lit_type("tuple", "tuple").
.decl assigns(s: node, x: symbol, r: node)
assigns(s, x, r) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", r), nearest(a, s, scope).
.decl defines_class(s: node, x: symbol, q: symbol)
defines_class(s, x, @dot(m, x)) :- kind(c, "class_definition"), field(c, "name", nm), text(nm, x), nearest(c, s, scope), kind(s, "module"), docof(c, d), doc(d, _, m).
.decl defines_fn(s: node, x: symbol, f: node, q: symbol)
defines_fn(s, x, f, @dot(m, x)) :- kind(f, "function_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, scope), kind(s, "module"), docof(f, d), doc(d, _, m).
.decl class_q(q: symbol)
class_q(q) :- defines_class(_, _, q).
.decl bound_in(s: node, x: symbol)
bound_in(s, x) :- assigns(s, x, _).
bound_in(s, x) :- defines_class(s, x, _).
bound_in(s, x) :- defines_fn(s, x, _, _).
bound_in(f, x) :- kind(f, "function_definition"), field(f, "parameters", ps), child(ps, p, _), kind(p, "identifier"), text(p, x).
bound_in(f, x) :- kind(f, "function_definition"), field(f, "parameters", ps), child(ps, p, _), child(p, i, 0), kind(i, "identifier"), text(i, x).
.decl lookup(n: node, x: symbol, s: node)
lookup(n, x, s) :- kind(n, "identifier"), text(n, x), nearest(n, s, scope), bound_in(s, x).
lookup(n, x, m) :- kind(n, "identifier"), text(n, x), nearest(n, s, scope), !bound_in(s, x), docof(n, d), modnode(d, m), bound_in(m, x).
// W4's cross-file part relates functions' symbols and types alone (decision 0677). Each file gives each typed node
// a type it decides itself (`lt`) or a dependency on what a call of a function gives (`dep`), and each module-level
// function's return the same (`fret`, `fdep`). The cross part solves the returns by the function's symbol (`ret`), and
// type_of places them on each file's own nodes.
// fn_at(d, q): document d defines module-level function q.
.decl fn_at(d: number, q: symbol)
fn_at(d, q) :- defines_fn(_, _, f, q), docof(f, d).
// lt(n, t): node n has type t, as its own file decides: a literal, or a call of a class its scope names.
.decl lt(n: node, t: symbol)
lt(n, t) :- kind(n, k), lit_type(k, t).
lt(n, t) :- lookup(n, x, s), assigns(s, x, r), lt(r, t).
lt(n, t) :- kind(n, "parenthesized_expression"), child(n, c, 0), lt(c, t).
lt(c, q) :- kind(c, "call"), field(c, "function", f), lookup(f, x, s), defines_class(s, x, q).
// dep(n, e, q): node n has the type a call of q gives: the function of document e its own scope names, or (e = -1)
// what a name resolved through an import names, in whichever file defines it.
.decl dep(n: node, e: number, q: symbol)
dep(c, e, q) :- kind(c, "call"), field(c, "function", f), lookup(f, x, s), defines_fn(s, x, g, q), docof(g, e).
dep(c, -1, q) :- kind(c, "call"), field(c, "function", f), resolves(f, q).
dep(n, e, q) :- lookup(n, x, s), assigns(s, x, r), dep(r, e, q).
dep(n, e, q) :- kind(n, "parenthesized_expression"), child(n, c, 0), dep(c, e, q).
// fret(d, q, t), fdep(d, q, e, p): module-level function q of document d returns type t, or what a call of p gives
// (e as dep's).
.decl fret(d: number, q: symbol, t: symbol)
fret(d, q, t) :- defines_fn(_, _, f, q), docof(f, d), kind(r, "return_statement"), nearest(r, f, scope), child(r, x, 0),
    lt(x, t).
.decl fdep(d: number, q: symbol, e: number, p: symbol)
fdep(d, q, e, p) :- defines_fn(_, _, f, q), docof(f, d), kind(r, "return_statement"), nearest(r, f, scope), child(r, x, 0),
    dep(x, e, p).
// returns(d, q, t): module-level function q of document d returns type t. Cross-file: to the fixed point over every
// file's dependencies (decision 0652).
.decl returns(d: number, q: symbol, t: symbol) cross_file
returns(d, q, t) :- fret(d, q, t).
returns(d, q, t) :- fdep(d, q, e, p), gives(e, p, t).
// gives(e, p, t): a call of p, as dep names it, has type t: document e's function p returns it; or, by name, p is a
// class of the run, or a function p of any file returns t, or no file defines p and its declared return is t.
// Declared signatures (`typing::declare`, rerail.types/v1) and dependency summaries (`typing::deps`): the corpus
// runner adds a `declared_ret(q, t)` fact per member name of each declared return. They fill gaps only: a call to a
// name the corpus defines keeps the corpus's types.
.decl declared_ret(q: symbol, t: symbol)
.decl gives(e: number, p: symbol, t: symbol)
gives(e, p, t) :- returns(e, p, t).
gives(-1, p, p) :- class_q(p).
gives(-1, p, t) :- fn_at(e, p), returns(e, p, t).
gives(-1, p, t) :- declared_ret(p, t), !functions(p).
// functions(q): the corpus's functions by symbol. It and returns are what the typing summaries and the declarations'
// conflicts read after the run (`corpus::typing`).
.decl functions(q: symbol)
functions(q) :- fn_at(_, q).
.decl type_of(n: node, t: symbol)
type_of(n, t) :- lt(n, t).
type_of(n, t) :- dep(n, e, p), gives(e, p, t).
.output type_of

// W4b: a declared flat lattice. `top` is its top; the join of two different constants is `top`.
.decl const_kind(k: symbol)
const_kind("integer"). const_kind("identifier"). const_kind("binary_operator"). const_kind("parenthesized_expression").
.decl is_lit(k: symbol)
is_lit(k) :- lit_type(k, _).
.decl aug_op(a: symbol, o: symbol)
aug_op("+=", "+"). aug_op("-=", "-"). aug_op("*=", "*").
.decl augdef(s: node, x: symbol, a: node)
augdef(s, x, a) :- kind(a, "augmented_assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), nearest(a, s, scope).
.decl has_def(n: node)
has_def(n) :- lookup(n, x, s), assigns(s, x, _).
has_def(n) :- lookup(n, x, s), augdef(s, x, _).
.decl binval(n: node, o: symbol, l: node, r: node)
binval(n, o, l, r) :- kind(n, "binary_operator"), op(n, o), field(n, "left", l), field(n, "right", r).
binval(a, o, l, r) :- kind(a, "augmented_assignment"), op(a, o0), aug_op(o0, o), field(a, "left", l), field(a, "right", r).
.decl cv(n: node, v: flat<>)
cv(n, v) :- intval(n, v).
cv(n, top) :- kind(n, "integer"), !intval(n, _).
cv(n, top) :- kind(n, k), !const_kind(k), !is_lit(k).
cv(n, top) :- kind(n, k), is_lit(k), k != "integer".
cv(n, top) :- kind(n, "identifier"), !has_def(n).
cv(n, v) :- lookup(n, x, s), assigns(s, x, r), cv(r, v).
cv(n, v) :- lookup(n, x, s), augdef(s, x, a), cv(a, v).
cv(n, v) :- kind(n, "parenthesized_expression"), child(n, c, 0), cv(c, v).
cv(n, @flat_bin(o, a, b)) :- binval(n, o, l, r), cv(l, a), cv(r, b).
.decl cv_const(n: node, v: number)
cv_const(n, v) :- cv(n, v), v != top, kind(n, "identifier").
cv_const(n, v) :- cv(n, v), v != top, kind(n, "binary_operator").
.output cv_const
