// The phase `py_names` (decisions 0083, 0677): Python module resolution across the workspace's modules, run over the same
// files as the program that reads it, in its language. It hands on symbols alone, keyed by a module, or by a file's path,
// so a per-file rule reading them stays per-file, and no node crosses into the cross-file part (0677). As `tsx_names`,
// it reads the modules' definitions and import statements alone, never a name's use: each file resolves its own names
// against these rows.
//   reads_at(p, m)    the file at path p can name something of workspace module m: its own module, each module its
//                     imports name, each module above or below one in the package tree, and the module of each
//                     definition one of those exports
//   exports(m, x, q)  module m exposes x, which denotes q: re-exports and star imports followed (python/imports)
//   class(m, c)       module m defines class c
//   defined(m, q)     module m defines q: a def or a class, nested ones too (its qualname)
//   public(m, x)      x is part of module m's public interface (public_name: `__all__`, else no leading `_`)
//   ancestor(m, q, b) class q of module m inherits from b, at any depth (0677 fix 3a): each base resolved as
//                     python/scopes' class_base resolves it, re-exports followed, a library's base by its name
//   library_ancestor(m, q, b)  the same where no workspace module defines b: a library's class (`django.forms.Form`)
//   anc_call(m, q, x, f)      a class of the run among class q's ancestors (q of module m) assigns attribute x, in its
//                             body, a call of f (`name = models.CharField(max_length=10)`: x "name", f
//                             "django.db.models.CharField"), f resolved as a base is (0677 fix 3b)
//   anc_kw(m, q, x, k, v)     that call's keyword argument k, its value's text v
//   anc_ref(m, q, x, s)       the right side of such an ancestor's `x = …` names s, at any depth (python/scopes' sym_of)
//   anc_method(m, q, x)       such an ancestor defines method x (a def whose nearest scope is the class)
//   member_call(m, q, x, f), member_kw(m, q, x, k, v), member_method(m, q, x)
//                             the same of class q's own body: a file naming q (read through reads_at) reads them
//   plain_def(m, q)           module m defines function q (a def, nested ones too) with no decorator
//   dj_group(m, q, g, x)      Django (0677 fix 3c): field x is in group g, a set of fields the database keeps unique
//                             together for model q's rows: unique_together, or a UniqueConstraint(fields=[...]) with no
//                             condition, in q's Meta options (dj_opts_from: its own Meta, an abstract base's it takes,
//                             a concrete base's). g names the group: the Meta's class, the option, the element's index
//   dj_cond_group(m, q, g, x) the same of a UniqueConstraint with a condition=
//   dj_opaque(m, q)           q's Meta options hold a uniqueness option not read: not a literal list, an expression
//                             constraint, fields= not a literal list of strings
//   dj_unmanaged(m, q)        q's Meta options set `managed` to anything but True
//   dj_abstract(m, q)         q's own Meta says `abstract = True` (Django passes it on to no subclass)
//   dj_manager_method(m, q, a, x)  q's attribute a (`objects = ...`, its own or an ancestor's of the run) names a class
//                             of the run, at any depth of its right side, which defines or inherits method x
//                             (get_or_create, update_or_create), itself or the class its get_queryset() names
//   dj_hook(m, q, k, h)       a hook of kind k ("save" or "delete") that a bulk write on model q skips, h its
//                             description: q's save()/delete(), or an ancestor's of the run, doing more than call the
//                             base class's (`Book.save() (shop/models.py:22)`); a pre_save/post_save receiver connected
//                             for sender q in any file (`post_save receiver `tag_saved` (shop/signals.py:7)`)
//   dj_receiver_fn(m, f, q)   function f of module m is connected as a pre_save/post_save receiver for sender q
//   dj_deferred_task(m, f)    function f of module m is a Celery task whose decorator names a task class `base=X`
//                             whose delay or apply_async (its own, else an ancestor's of the run) calls
//                             transaction.on_commit (pretix's TransactionAwareTask): its .delay() waits for the commit
//   dj_app_defers(m)          the run's Celery app makes such a class every task's class (`Celery(..., task_cls=X)`):
//                             a fact of the whole run, handed on under every module m, so a file's memo entry, keyed by
//                             the rows of the modules it reads, is keyed by it too
//   dj_task_def(m, f)         function f of module m is decorated as a Celery task (`@shared_task`, `@app.task(...)`,
//                             `@task`)
//   dj_view_model(m, q, s)    class q, or an ancestor of the run, says `model = S` or `queryset = S.objects…` in its
//                             body (S as the file binds it): a view over S
//   dj_anc_clean_call(m, q, x)  a class of the run among class q's ancestors calls `self.x()`, x a `clean_…` method
//                             (a form's clean_<field> it calls itself is a helper, not the field's hook)
// An ancestor's members are handed on under the class's own module, not the ancestor's: a file need not read the
// module an ancestor is defined in (`use.py`'s `Leaf(Mid)`, Mid's base in a module use.py never imports).
// python/names reads them as `py_names__reads_at`, `py_names__exports`, … . This program includes python/scopes, not
// python/names, so it never reads its own exports.

#include "core.rerail"
#include "python/scopes.rerail"
#include "python/django-shared.rerail"

.phase py_names
.export reads_at, exports, class, defined, public, ancestor, library_ancestor, anc_call, anc_kw, anc_ref, anc_method,
    member_call, member_kw, member_method, plain_def, dj_group, dj_cond_group, dj_opaque, dj_unmanaged, dj_abstract,
    dj_manager_method, dj_hook, dj_receiver_fn, dj_deferred_task, dj_app_defers, dj_task_def,
    dj_view_model, dj_anc_clean_call

// imported(p, q): an import statement of the file at path p names q: a module (`import a.b`, `from .m import x`'s
// "pkg.m"), or a name of one ("pkg.m.x").
.decl imported(p: symbol, q: symbol)
imported(p, m) :- import_alias(i, _, m, _, _), docof(i, d), doc(d, p, _).
imported(p, @dot(m, x)) :- import_alias(i, _, m, x, _), x != "", docof(i, d), doc(d, p, _).
// above(q, m): m is q with one or more of its last segments dropped ("pkg" and "pkg.m" for "pkg.m.x").
.decl above(q: symbol, m: symbol)
above(q, m) :- imported(_, q), m = @pkg_up(q, 1), m != "".
above(q, m) :- above(q, m1), m = @pkg_up(m1, 1), m != "".
// named_module(p, m): workspace module m is one the file at p names, or one above or below one it names: a name
// through an import (`pkg.core.App` after `import pkg`) is resolved in the module its last dot ends.
.decl named_module(p: symbol, m: symbol)
named_module(p, m) :- doc(_, p, m).
named_module(p, q) :- imported(p, q), workspace_module(q).
named_module(p, m) :- imported(p, q), above(q, m), workspace_module(m).
named_module(p, m) :- imported(p, q), pkg_above(m, q).

.decl reads_at(p: symbol, m: symbol)
reads_at(p, m) :- named_module(p, m).
reads_at(p, m) :- named_module(p, m0), exports(m0, _, r), defined(m, r).

.decl defined(m: symbol, q: symbol)
defined(m, q) :- qualname(f, q), module_of(f, m).

.decl class(m: symbol, c: symbol)
class(m, c) :- class_def(n, c), module_of(n, m).

.decl public(m: symbol, x: symbol)
public(m, x) :- public_name(m, x).

// base(q, b): class q lists base b (keyword arguments, `metaclass=M`, are none). A name the class's own file binds is
// resolved there (python/scopes' sym_of: its definitions, builtins); a name through an import (qn) by the modules'
// exports (as resolve_export), or itself where no workspace module exports it (`django.db.models.Model`). The same
// three rules python/scopes' class_base reads through python/names' sym_of, with no node handed on.
.decl base_expr(q: symbol, e: node)
base_expr(q, e) :- class_def(c, q), field(c, "superclasses", al), child(al, e, _), !kind(e, "keyword_argument").
.decl base_name(q: symbol, q0: symbol)
base_name(q, q0) :- base_expr(q, e), qn(e, q0).
// base_here(q, b): a base its class's own file resolves, a relation of its own so the node e is joined in the file's
// part: read in base's rule, which is cross-file by its others, the join held e in the cross part (0677).
.decl base_here(q: symbol, b: symbol)
base_here(q, b) :- base_expr(q, e), sym_of(e, b).
.decl base(q: symbol, b: symbol)
base(q, b) :- base_here(q, b).
// resolve_export's two rules, for a base's name (its `export_query` is python/imports' own, decision 0263).
base(q, b) :- base_name(q, q0), split_dot(q0, m, x), exports(m, x, b).
base(q, q0) :- base_name(q, q0), count : { split_dot(q0, m, x), exported(m, x) } = 0.
// A class of the run read as an attribute of a class (`class Meta(Named.Meta)`), as python/names' sym_of rule 3 reads
// it: the object resolved by the file's own binding or through an import, the base its qualname where some module
// defines it.
.decl base_attr_here(q: symbol, c: symbol, a: symbol)
base_attr_here(q, c, a) :- base_expr(q, e), attr_of(e, o, a), sym_of(o, c).
.decl base_attr_name(q: symbol, c0: symbol, a: symbol)
base_attr_name(q, c0, a) :- base_expr(q, e), attr_of(e, o, a), qn(o, c0).
base(q, b) :- base_attr_here(q, c, a), b = @dot(c, a), defined(_, b).
base(q, b) :- base_attr_name(q, c0, a), split_dot(c0, m, x), exports(m, x, c), b = @dot(c, a), defined(_, b).
// anc(q, b): b is among q's bases, at any depth. Linear (a base's ancestors, not a join of two closures): its rows
// are each class's ancestors, the depth of the hierarchy, not its square.
.decl anc(q: symbol, b: symbol)
anc(q, b) :- base(q, b).
anc(q, b) :- base(q, m), anc(m, b).
.decl ancestor(m: symbol, q: symbol, b: symbol)
ancestor(m, q, b) :- class(m, q), anc(q, b).
// A library's class has no bases here (no module of the run defines it), so these are where each line of bases
// leaves the run.
.decl run_class(q: symbol)
run_class(q) :- class(_, q).
.decl library_ancestor(m: symbol, q: symbol, b: symbol)
library_ancestor(m, q, b) :- ancestor(m, q, b), !run_class(b).

// Class members (0677 fix 3b): what each class's body assigns and defines, by symbol, joined to its ancestors by
// symbol. A class body's statements are its children (python/ast's body_stmt reads python/names, which reads these).
.decl own_asg(q: symbol, x: symbol, r: node)
own_asg(q, x, r) :- class_def(c, q), field(c, "body", b), child(b, s, _), kind(s, "expression_statement"), child(s, a, 0),
    kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", r).
// A callee resolved by the three rules a base is (`base`): the file's own binding, a name through an import by the
// modules' exports, else the name itself.
.decl own_call_here(q: symbol, x: symbol, f: symbol)
own_call_here(q, x, f) :- own_asg(q, x, r), kind(r, "call"), field(r, "function", e), sym_of(e, f).
.decl own_call_name(q: symbol, x: symbol, f0: symbol)
own_call_name(q, x, f0) :- own_asg(q, x, r), kind(r, "call"), field(r, "function", e), qn(e, f0).
.decl own_call(q: symbol, x: symbol, f: symbol)
own_call(q, x, f) :- own_call_here(q, x, f).
own_call(q, x, f) :- own_call_name(q, x, f0), split_dot(f0, m, y), exports(m, y, f).
own_call(q, x, f0) :- own_call_name(q, x, f0), count : { split_dot(f0, m, y), exported(m, y) } = 0.
.decl own_kw(q: symbol, x: symbol, k: symbol, v: symbol)
own_kw(q, x, k, v) :- own_asg(q, x, r), kind(r, "call"), field(r, "arguments", al), child(al, ka, _),
    kind(ka, "keyword_argument"), field(ka, "name", n), text(n, k), field(ka, "value", w), node_text(w, v).
.decl own_ref_here(q: symbol, x: symbol, s: symbol)
own_ref_here(q, x, s) :- own_asg(q, x, r), (e = r ; within(e, r)), sym_of(e, s).
.decl own_ref_name(q: symbol, x: symbol, s0: symbol)
own_ref_name(q, x, s0) :- own_asg(q, x, r), (e = r ; within(e, r)), qn(e, s0).
.decl own_ref(q: symbol, x: symbol, s: symbol)
own_ref(q, x, s) :- own_ref_here(q, x, s).
own_ref(q, x, s) :- own_ref_name(q, x, s0), split_dot(s0, m, y), exports(m, y, s).
own_ref(q, x, s0) :- own_ref_name(q, x, s0), count : { split_dot(s0, m, y), exported(m, y) } = 0.
.decl own_method(q: symbol, x: symbol)
own_method(q, x) :- class_def(c, q), kind(f, "function_definition"), nearest(f, c, scope), def_name(f, x).
.decl member_call(m: symbol, q: symbol, x: symbol, f: symbol)
member_call(m, q, x, f) :- class(m, q), own_call(q, x, f).
.decl member_kw(m: symbol, q: symbol, x: symbol, k: symbol, v: symbol)
member_kw(m, q, x, k, v) :- class(m, q), own_kw(q, x, k, v).
.decl member_method(m: symbol, q: symbol, x: symbol)
member_method(m, q, x) :- class(m, q), own_method(q, x).
.decl anc_call(m: symbol, q: symbol, x: symbol, f: symbol)
anc_call(m, q, x, f) :- class(m, q), anc(q, o), own_call(o, x, f).
.decl anc_kw(m: symbol, q: symbol, x: symbol, k: symbol, v: symbol)
anc_kw(m, q, x, k, v) :- class(m, q), anc(q, o), own_kw(o, x, k, v).
.decl anc_ref(m: symbol, q: symbol, x: symbol, s: symbol)
anc_ref(m, q, x, s) :- class(m, q), anc(q, o), own_ref(o, x, s).
.decl anc_method(m: symbol, q: symbol, x: symbol)
anc_method(m, q, x) :- class(m, q), anc(q, o), own_method(o, x).
// plain_def(m, q): each file's undecorated defs, by qualname (plain_here), under the module that defines them.
.decl plain_here(q: symbol)
plain_here(q) :- kind(g, "function_definition"), qualname(g, q), !decorator(g, _).
.decl plain_def(m: symbol, q: symbol)
plain_def(m, q) :- defined(m, q), plain_here(q).

// ---- Django's model options and managers (0677 fix 3c) -------------------------------------------------------------
// Here, not in a phase of Django's own: they need the class line (base, anc) and the names' resolution (sym_of, qn,
// exports) this phase holds, and a phase of their own would run python/scopes over every file a third time. Each
// file's rules turn its Meta classes' bodies into symbols (the dj_own_* relations: a class's own Meta); Django's
// inheritance of Meta options is then joined by symbol, and handed on under the model's own module.
// dj_meta_node(c, n): class c's body declares `class Meta` n.
.decl dj_meta_node(c: node, n: node)
dj_meta_node(c, n) :- kind(c, "class_definition"), kind(n, "class_definition"), def_name(n, "Meta"), nearest(n, c, scope).
// dj_meta_q(q, mt): class q declares Meta, of qualname mt.
.decl dj_meta_q(q: symbol, mt: symbol)
dj_meta_q(q, mt) :- class_def(c, q), dj_meta_node(c, n), class_def(n, mt).
// dj_opt(q, k, v): class q's own Meta sets option k to v (`unique_together = (...)`), parentheses off.
.decl dj_opt(q: symbol, k: symbol, v: node)
dj_opt(q, k, v) :- class_def(c, q), dj_meta_node(c, n), field(n, "body", b), child(b, s, _), kind(s, "expression_statement"),
    child(s, a, 0), kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, k), field(a, "right", r),
    unparen(r, v).
// dj_seq(n): a list or tuple. dj_strings(g): a list or tuple of string literals alone (comments aside), one at least.
.decl dj_seq(n: node)
dj_seq(n) :- kind(n, "list") ; kind(n, "tuple").
.decl dj_odd(g: node)
dj_odd(g) :- dj_seq(g), child(g, e, _), !kind(e, "string"), !kind(e, "comment").
.decl dj_strings(g: node)
dj_strings(g) :- dj_seq(g), child(g, e, _), kind(e, "string"), !dj_odd(g).
// dj_constraint(k): k is a call of UniqueConstraint (`models.UniqueConstraint(...)`, by the name as imported or bound).
.decl dj_constraint(k: node)
dj_constraint(k) :- kind(k, "call"), field(k, "function", f), (sym_of(f, q) ; qn(f, q)), suffix(".UniqueConstraint", q).
// dj_kwarg(k, x, v): call k passes keyword argument x = v, parentheses off.
.decl dj_kwarg(k: node, x: symbol, v: node)
dj_kwarg(k, x, v) :- call_arg(k, -1, x, w), unparen(w, v).
// dj_group_node(q, g, gn, c): list or tuple gn of class q's own Meta is a group, named g; c is "" or "condition" (a
// UniqueConstraint with a condition: whether a row meets it is not known).
.decl dj_group_node(q: symbol, g: symbol, gn: node, c: symbol)
dj_group_node(q, cat(q, "#unique_together"), v, "") :- dj_opt(q, "unique_together", v), dj_strings(v).
dj_group_node(q, cat(q, "#unique_together.", to_string(i)), g, "") :- dj_opt(q, "unique_together", v), dj_seq(v),
    child(v, e, i), unparen(e, g), dj_strings(g).
dj_group_node(q, cat(q, "#constraints.", to_string(i)), g, "") :- dj_opt(q, "constraints", v), dj_seq(v), child(v, k, i),
    dj_constraint(k), dj_kwarg(k, "fields", g), dj_strings(g), !dj_kwarg(k, "condition", _).
dj_group_node(q, cat(q, "#constraints.", to_string(i)), g, "condition") :- dj_opt(q, "constraints", v), dj_seq(v),
    child(v, k, i), dj_constraint(k), dj_kwarg(k, "fields", g), dj_strings(g), dj_kwarg(k, "condition", _).
.decl dj_own_group(q: symbol, g: symbol, c: symbol, x: symbol)
dj_own_group(q, g, c, x) :- dj_group_node(q, g, gn, c), child(gn, e, _), str(e, x).
// dj_own_opaque(q): q's own Meta holds a uniqueness option not read (dj_opaque).
.decl dj_own_opaque(q: symbol)
dj_own_opaque(q) :- (dj_opt(q, "unique_together", v) ; dj_opt(q, "constraints", v)), !dj_seq(v).
dj_own_opaque(q) :- dj_opt(q, "unique_together", v), !dj_strings(v), child(v, e, _), !kind(e, "comment"), unparen(e, g),
    !dj_strings(g).
dj_own_opaque(q) :- dj_opt(q, "constraints", v), child(v, k, _), dj_constraint(k), posarg(k, _, _).
dj_own_opaque(q) :- dj_opt(q, "constraints", v), child(v, k, _), dj_constraint(k), !dj_fields_lit(k).
dj_own_opaque(q) :- dj_opt(q, "constraints", v), child(v, k, _), !kind(k, "comment"), !kind(k, "call").
.decl dj_fields_lit(k: node)
dj_fields_lit(k) :- dj_kwarg(k, "fields", g), dj_strings(g).
.decl dj_own_unmanaged(q: symbol)
dj_own_unmanaged(q) :- dj_opt(q, "managed", v), !text(v, "True").
.decl dj_own_abstract(q: symbol)
dj_own_abstract(q) :- dj_opt(q, "abstract", v), text(v, "True").
// dj_meta_from(c, b): class c takes the Meta of class b, a base of the run, as Django does: c declares no Meta (and so
// inherits its bases' Meta attribute), or c's Meta subclasses b's own (`class Meta(B.Meta)`); through a chain of such.
.decl dj_meta_from(c: symbol, b: symbol)
dj_meta_from(c, b) :- base(c, b), run_class(b), !dj_has_meta(c).
dj_meta_from(c, b) :- base(c, b), dj_meta_q(c, mt), base(mt, mb), dj_meta_q(b, mb).
dj_meta_from(c, a) :- dj_meta_from(c, b), dj_meta_from(b, a).
.decl dj_has_meta(q: symbol)
dj_has_meta(q) :- dj_meta_q(q, _).
// dj_model_q(q): q is a model by its line: a known model base itself, or one among its ancestors.
.decl dj_model_q(q: symbol)
dj_model_q(q) :- run_class(q), anc(q, b), dj_model_base(b).
// dj_opts_from(q, s): class q's Meta options include class s's own Meta's: q's own, an abstract base's q takes
// (dj_meta_from), and a concrete model base's, at any depth (multi-table inheritance or a proxy: that table's
// constraints hold for q's rows too).
.decl dj_opts_from(q: symbol, s: symbol)
dj_opts_from(q, q) :- run_class(q).
dj_opts_from(q, s) :- dj_meta_from(q, s), dj_own_abstract(s).
dj_opts_from(q, s) :- base(q, b), run_class(b), !dj_own_abstract(b), dj_model_q(b), dj_opts_from(b, s).
.decl dj_group(m: symbol, q: symbol, g: symbol, x: symbol)
dj_group(m, q, g, x) :- class(m, q), dj_opts_from(q, s), dj_own_group(s, g, "", x).
.decl dj_cond_group(m: symbol, q: symbol, g: symbol, x: symbol)
dj_cond_group(m, q, g, x) :- class(m, q), dj_opts_from(q, s), dj_own_group(s, g, "condition", x).
.decl dj_opaque(m: symbol, q: symbol)
dj_opaque(m, q) :- class(m, q), dj_opts_from(q, s), dj_own_opaque(s).
.decl dj_unmanaged(m: symbol, q: symbol)
dj_unmanaged(m, q) :- class(m, q), dj_opts_from(q, s), dj_own_unmanaged(s).
.decl dj_abstract(m: symbol, q: symbol)
dj_abstract(m, q) :- class(m, q), dj_own_abstract(q).
// Managers. dj_gq_call(k, f): class k's own get_queryset() calls f, resolved as a member call is (own_call).
.decl dj_gq_call_here(k: symbol, f: symbol)
dj_gq_call_here(k, f) :- class_def(c, k), kind(d, "function_definition"), nearest(d, c, scope), def_name(d, "get_queryset"),
    kind(e, "call"), within(e, d), field(e, "function", fn), sym_of(fn, f).
.decl dj_gq_call_name(k: symbol, f0: symbol)
dj_gq_call_name(k, f0) :- class_def(c, k), kind(d, "function_definition"), nearest(d, c, scope),
    def_name(d, "get_queryset"), kind(e, "call"), within(e, d), field(e, "function", fn), qn(fn, f0).
.decl dj_gq_call(k: symbol, f: symbol)
dj_gq_call(k, f) :- dj_gq_call_here(k, f).
dj_gq_call(k, f) :- dj_gq_call_name(k, f0), split_dot(f0, m, y), exports(m, y, f).
// dj_mgr_class(s, k): manager class s runs its queries through class k of the run: itself, or the class its
// get_queryset() (its own, else an ancestor's) calls (`return SlugQuerySet(self.model, using=self._db)`).
.decl dj_mgr_class(s: symbol, k: symbol)
dj_mgr_class(s, s) :- run_class(s).
dj_mgr_class(s, k) :- own_method(s, "get_queryset"), dj_gq_call(s, k), run_class(k).
dj_mgr_class(s, k) :- run_class(s), !own_method(s, "get_queryset"), anc(s, o), dj_gq_call(o, k), run_class(k).
// dj_row_maker(x): the queryset methods that insert a row when the lookup finds none.
.decl dj_row_maker(x: symbol)
dj_row_maker("get_or_create"). dj_row_maker("update_or_create").
.decl dj_manager_method(m: symbol, q: symbol, a: symbol, x: symbol)
dj_manager_method(m, q, a, x) :- class(m, q), (own_ref(q, a, s) ; anc(q, o), own_ref(o, a, s)), dj_mgr_class(s, k),
    dj_row_maker(x), (own_method(k, x) ; anc(k, o2), own_method(o2, x)).

// ---- Django's model hooks (0677 fix 3d) ----------------------------------------------------------------------------
// What a queryset's bulk write skips (django-practice-bulk-write-skips-hooks): a model's save()/delete() overrides, its
// own and its ancestors', and the pre_save/post_save receivers connected for it in any file. Each file's rules turn its
// own into symbols, keyed by place ("path:line"); the phase joins senders and ancestors by symbol.
// dj_place(n, p): node n's place, "path:line".
.decl dj_place(n: node, p: symbol)
dj_place(n, p) :- docof(n, d), doc(d, path, _), line(n, l), p = cat(path, ":", to_string(l)).
// dj_bare_super(f): f's body, its docstring aside, is one statement calling the base class's method of f's name, maybe
// returned: `super().<name>(…)`, or the old style `models.Model.<name>(self, …)`.
.decl dj_bare_super(f: node)
dj_bare_super(f) :- def_name(f, x), field(f, "body", b), dj_code_len(f, b, 1), body_stmt(b, s, _), !doc_stmt(s, _),
    text(s, t), match(cat("(?s)(return\\s+)?(super\\([^)]*\\)\\.", x, "\\(.*\\)|[\\w.]+\\.", x, "\\(\\s*self\\b.*\\))"), t).
.decl dj_code_len(f: node, b: node, k: number)
dj_code_len(f, b, k) :- field(f, "body", b), body_len(b, n), docstring(f, _), k = n - 1.
dj_code_len(f, b, k) :- field(f, "body", b), body_len(b, k), !docstring(f, _).
// dj_own_hook(o, k, h): class o's own body defines method k, save or delete, doing more than a bare base call.
.decl dj_own_hook(o: symbol, k: symbol, h: symbol)
dj_own_hook(o, k, h) :- class_def(c, o), kind(f, "function_definition"), nearest(f, c, scope), def_name(f, k),
    (k = "save" ; k = "delete"), !dj_bare_super(f), def_name(c, cn), dj_place(f, p), h = cat(cn, ".", k, "() (", p, ")").
// dj_signal(e, x): e names Django's model signal x, pre_save or post_save. dj_receiver_deco(e): e names Django's
// `receiver` decorator. Library names, read as the file binds or imports them.
.decl dj_signal(e: node, x: symbol)
dj_signal(e, x) :- (sym_of(e, q) ; qn(e, q)), split_dot(q, "django.db.models.signals", x), (x = "pre_save" ; x = "post_save").
.decl dj_sig_arg(a: node, x: symbol)
dj_sig_arg(a, x) :- dj_signal(a, x).
dj_sig_arg(a, x) :- (kind(a, "list") ; kind(a, "tuple")), child(a, e, _), dj_signal(e, x).
.decl dj_receiver_deco(e: node)
dj_receiver_deco(e) :- (sym_of(e, q) ; qn(e, q)), (q = "django.dispatch.receiver" ; q = "django.dispatch.dispatcher.receiver").
// dj_rcv_site(k, v, x, fname, a): call k, outside test code, connects a receiver of signal x for the sender v names:
// `@receiver(sig, sender=M)` on def a (sig maybe a list or tuple), or `sig.connect(a, sender=M)`; fname is the
// receiver's name as written.
.decl dj_rcv_site(k: node, v: node, x: symbol, fname: symbol, a: node)
dj_rcv_site(e, v, x, fname, f) :- decorator(f, e), kind(e, "call"), field(e, "function", rf), dj_receiver_deco(rf),
    posarg(e, 0, s), dj_sig_arg(s, x), call_arg(e, -1, "sender", v), def_name(f, fname), docof(e, d), !dj_test_doc(d).
dj_rcv_site(k, v, x, fname, a) :- kind(k, "call"), field(k, "function", fn), attr_of(fn, o, "connect"), dj_signal(o, x),
    call_arg(k, -1, "sender", v), (posarg(k, 0, a) ; call_arg(k, -1, "receiver", a)), text(a, fname), docof(k, d),
    !dj_test_doc(d).
// dj_rcv(p, x, fname): at place p a receiver fname of signal x is connected.
.decl dj_rcv(p: symbol, x: symbol, fname: symbol)
dj_rcv(p, x, fname) :- dj_rcv_site(k, _, x, fname, _), dj_place(k, p).
// The sender and the receiver function at place p, resolved by the three rules a base is (`base`).
.decl dj_rcv_sender_here(p: symbol, q: symbol)
dj_rcv_sender_here(p, q) :- dj_rcv_site(k, v, _, _, _), dj_place(k, p), sym_of(v, q).
.decl dj_rcv_sender_name(p: symbol, q0: symbol)
dj_rcv_sender_name(p, q0) :- dj_rcv_site(k, v, _, _, _), dj_place(k, p), qn(v, q0).
.decl dj_rcv_sender(p: symbol, q: symbol)
dj_rcv_sender(p, q) :- dj_rcv_sender_here(p, q).
dj_rcv_sender(p, q) :- dj_rcv_sender_name(p, q0), split_dot(q0, m, y), exports(m, y, q).
dj_rcv_sender(p, q0) :- dj_rcv_sender_name(p, q0), count : { split_dot(q0, m, y), exported(m, y) } = 0.
.decl dj_rcv_fn_here(p: symbol, f: symbol)
dj_rcv_fn_here(p, fq) :- dj_rcv_site(k, _, _, _, a), dj_place(k, p), kind(a, "function_definition"), qualname(a, fq).
dj_rcv_fn_here(p, fq) :- dj_rcv_site(k, _, _, _, a), dj_place(k, p), sym_of(a, fq).
.decl dj_rcv_fn_name(p: symbol, f0: symbol)
dj_rcv_fn_name(p, f0) :- dj_rcv_site(k, _, _, _, a), dj_place(k, p), qn(a, f0).
.decl dj_rcv_fn(p: symbol, f: symbol)
dj_rcv_fn(p, fq) :- dj_rcv_fn_here(p, fq).
dj_rcv_fn(p, fq) :- dj_rcv_fn_name(p, f0), split_dot(f0, m, y), exports(m, y, fq).
// dj_rcv_hook(q, h): a receiver connected for sender q, described: its signals, its name, its place.
.decl dj_rcv_hook(q: symbol, h: symbol)
dj_rcv_hook(q, h) :- dj_rcv_sender(p, q), dj_rcv(p, _, fname), s = join x by x sep "/" : { dj_rcv(p, x, fname) },
    h = cat(s, " receiver `", fname, "` (", p, ")").
.decl dj_hook(m: symbol, q: symbol, k: symbol, h: symbol)
dj_hook(m, q, k, h) :- class(m, q), dj_own_hook(q, k, h).
dj_hook(m, q, k, h) :- class(m, q), anc(q, o), dj_own_hook(o, k, h).
dj_hook(m, q, "save", h) :- class(m, q), dj_rcv_hook(q, h).
.decl dj_receiver_fn(m: symbol, f: symbol, q: symbol)
dj_receiver_fn(m, fq, q) :- dj_rcv_fn(p, fq), dj_rcv_sender(p, q), defined(m, fq).

// ---- Django's task classes and forms (0677, the tail) --------------------------------------------------------------
// A task's .delay() that already waits for the commit (python/django's dj_task_waits_for_commit), and a form's
// clean_<x> called by an ancestor (django-practice-clean-field-returns-value). Each file's rules turn its own classes,
// task decorators and apps into symbols; the phase joins them by symbol, a class's ancestors by `anc`. A name is read
// as the file binds it or, imported, by its qualified name (`sym_of ; qn`), as dj_signal reads one.
// dj_own_defer(o, x): class o's own method x, delay or apply_async, calls transaction.on_commit.
.decl dj_own_defer(o: symbol, x: symbol)
dj_own_defer(o, x) :- class_def(c, o), kind(h, "function_definition"), nearest(h, c, scope), def_name(h, x),
    (x = "delay" ; x = "apply_async"), kind(oc, "call"), within(oc, h), field(oc, "function", of),
    (sym_of(of, q) ; qn(of, q)), q = "django.db.transaction.on_commit".
// dj_defer_q(q): class q's delay or apply_async calls it: q's own method, else an ancestor's of the run (python/scopes'
// mro_method: with no own method, any ancestor's).
.decl dj_defer_q(q: symbol)
dj_defer_q(q) :- dj_own_defer(q, _).
dj_defer_q(q) :- run_class(q), (x = "delay" ; x = "apply_async"), !own_method(q, x), anc(q, o), dj_own_defer(o, x).
// dj_task_base_here(f, b): def f's decorator is a call passing `base=` the class b names (`@shared_task(base=X)`).
.decl dj_task_base_here(f: symbol, b: symbol)
dj_task_base_here(fq, bq) :- kind(g, "function_definition"), qualname(g, fq), decorator(g, e), kind(e, "call"),
    call_arg(e, _, "base", bv), (sym_of(bv, bq) ; qn(bv, bq)).
.decl dj_deferred_task(m: symbol, f: symbol)
dj_deferred_task(m, fq) :- defined(m, fq), dj_task_base_here(fq, bq), dj_defer_q(bq).
// dj_task_here(f): def f is decorated as a task.
.decl dj_task_here(f: symbol)
dj_task_here(fq) :- kind(g, "function_definition"), qualname(g, fq), decorator(g, e), unparen(e, m), dj_task_deco(m).
.decl dj_task_deco(e: node)
dj_task_deco(e) :- attr_of(e, _, "task").
dj_task_deco(e) :- (sym_of(e, q) ; qn(e, q)), (split_dot(q, _, "task") ; split_dot(q, _, "shared_task")).
dj_task_deco(e) :- kind(e, "call"), field(e, "function", f), dj_task_deco(f).
.decl dj_task_def(m: symbol, f: symbol)
dj_task_def(m, fq) :- defined(m, fq), dj_task_here(fq).
// dj_app_cls_here(b): a `celery.Celery(..., task_cls=X)` call, X naming class b.
.decl dj_app_cls_here(b: symbol)
dj_app_cls_here(bq) :- kind(k, "call"), field(k, "function", f), (sym_of(f, c) ; qn(f, c)), c = "celery.Celery",
    call_arg(k, _, "task_cls", v), (sym_of(v, bq) ; qn(v, bq)).
.decl dj_app_defers(m: symbol)
dj_app_defers(m) :- reads_at(_, m), dj_app_cls_here(bq), dj_defer_q(bq).
// dj_own_view_model(o, s): class o's own body says `model = S` or `queryset = S.objects…`.
.decl dj_own_view_model(o: symbol, s: symbol)
dj_own_view_model(o, s) :- own_asg(o, x, r), (x = "model" ; x = "queryset"), unparen(r, e),
    (w = e ; dj_qs_root(e, w)), (sym_of(w, s) ; qn(w, s)).
.decl dj_view_model(m: symbol, q: symbol, s: symbol)
dj_view_model(m, q, s) :- class(m, q), dj_own_view_model(q, s).
dj_view_model(m, q, s) :- class(m, q), anc(q, o), dj_own_view_model(o, s).
// dj_own_clean_call(o, x): a method of class o calls `self.x()`, x a clean_… method.
.decl dj_own_clean_call(o: symbol, x: symbol)
dj_own_clean_call(o, x) :- class_def(a, o), kind(k, "call"), field(k, "function", fn), attr_of(fn, s, x), prefix("clean_", x),
    text(s, "self"), nearest(k, a, "class_definition").
.decl dj_anc_clean_call(m: symbol, q: symbol, x: symbol)
dj_anc_clean_call(m, q, x) :- class(m, q), anc(q, o), dj_own_clean_call(o, x).
