// The resolver records the binding rows it reads in each answer.
.decl reference_link_input(name: symbol)
.input reference_link_input

.decl reference_link_key(name: symbol, version: symbol)
reference_link_key(n, "link-v3") :- reference_link_input(n).

.decl reference_link_request(name: symbol, version: symbol)
reference_link_request(n, v) :- reference_link_key(n, v).
.decl reference_link_of(name: symbol, version: symbol, result: symbol)
.decl reference_link(name: symbol, version: symbol, result: symbol)
reference_link(n, v, r) :- reference_link_key(n, v), reference_link_of(n, v, r).
.cache reference_link by reference_link_key

.decl reference_name_result(name: symbol, result: symbol)
reference_name_result(n, r) :- reference_link(n, _, r).
.output reference_name_result
