// The resolver records the binding rows it reads in each answer.
.decl reference_link_input(name: symbol, constructors: symbol)
.input reference_link_input

.decl reference_link_key(name: symbol, constructors: symbol, version: symbol)
reference_link_key(n, c, "link-v2") :- reference_link_input(n, c).

.decl reference_link_request(name: symbol, constructors: symbol, version: symbol)
reference_link_request(n, c, v) :- reference_link_key(n, c, v).
.decl reference_link_of(name: symbol, constructors: symbol, version: symbol, result: symbol)
.decl reference_link(name: symbol, constructors: symbol, version: symbol, result: symbol)
reference_link(n, c, v, r) :- reference_link_key(n, c, v), reference_link_of(n, c, v, r).
.cache reference_link by reference_link_key

.decl reference_name_result(name: symbol, result: symbol)
reference_name_result(n, r) :- reference_link(n, _, _, r).
.output reference_name_result
