// calls_p3.rr: the analysis phase, P3 of decision 0083 §1 (note t28). calls_cx.rr's call targets and types over the
// workspace's documents alone: no library document is loaded, and no rule here loads one. A library is read only
// through what the typing phase (types.rr, P2, over struct.rr's P1) hands on, keyed by symbol.
//
// So values are of two sorts. A workspace value is a node, as in calls_cx (`pv(n, k, v)`): this phase parses the
// workspace. A library value is a symbol (`lv(n, k, s)`: n may be the library's s, of kind k):
//   - a name an import binds, resolved through `types__binds` (`lres`), whose module is not the workspace's;
//   - a builtin name, a literal (`builtins.int`), an attribute of a library module, class or instance
//     (`types__attr`, through the class's bases), a library class's call (its instance), a library function's call
//     (its declared return's head, `types__rtype`), an implicit call (`__iter__`, `__getitem__`) on a library
//     instance;
//   - a workspace class's library base (`lbase`): what the workspace class does not bind, the base answers.
// Library values flow back into workspace values where a library declares it: a decorator declared `(f: F) -> F`
// keeps the definition, one declared `(f: Callable[P, A]) -> Callable[P, B]` wraps it (`contextmanager`), a method
// declared `-> Self` returns its receiver.
//
// What calls_cx reads from a library's nodes and this does not yet: generic instantiation through a library's
// classes (`list[C]`'s `__iter__`, `dict[str, C].get`), overloads fitted by arity (every overload's return is
// taken), and `async def` in stubs. Those values are unknown here (`vopen`), never wrong.
//
// What follows is calls_cx.rr's header.
// calls_cx.rr (P3's source): calls.rr with every cross-file lookup a function of the reader's import closure (decision 0076, O114),
// so its fixpoint can be memoised per import component. Generated from calls.rr by
// fixtures/python/calls/make_cx.py; edit calls.rr and regenerate. What differs:
// - a module's bindings (`qv`, `tqv`, `qopen`) are keyed by the module, and a reader sees those of its closure
//   (`rr_cx_reach`); "is q a module" is `rr_cx_sees`;
// - attribute lookups are keyed by the node that asks (`asks`, `fv`, `attr_open`), not by the class asked, and
//   `found` is not cut to the names some reader asks for;
// - closed-world `self` and annotations reach the subclasses in the reader's closure, not every importer's;
// - subtyping (`tsub`, `tsup_open`) is per node, over the classes its closure names;
// - generics' heads (`ghead`, `ghcls`) are made for every subscript argument, an instance attribute's assignment
//   (`iattr`) is keyed by the assignment, and a star import binds every public name, not what importers want.
// Call-target resolution and call chains for Python, in Rerail's Datalog dialect.
//
// One points-to relation, `pv(n, kind, v)`: expression n may evaluate to v, a function (`fn`, a function_definition),
// a class object (`cls`), an instance of a class (`inst`), a module (`mod`), or `super()` in a class (`super`).
// `vopen(n)`: n may also evaluate to something no static name denotes. A call's answer is three-valued, as the
// native `calls` relation's is: `call_open` (unknown), else the definitions `call_target` names (none: no edge).
//
// Python semantics covered: LEGB scope lookup (class scopes are invisible to nested functions), imports (absolute,
// relative (any number of dots), aliased, star, function-local), re-exports through module bindings, later unconditional bindings
// shadowing earlier ones, decorators (transparent ones, workspace decorators through their returns, others unknown),
// classes and inheritance (method lookup through bases, constructors to `__init__`, instances to `__call__`),
// late-bound `self`/`cls` (the class and every workspace subclass), `super()`, and function values flowing through
// assignments, returns and a function's returned parameter.
// Its cross-file part is one fixpoint over every loaded document, as any program's is (decision 0065).

.decl doc(d: number, path: symbol, module: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl op(n: node, s: symbol)
.decl name(n: node, s: symbol)
.decl str(n: node, s: symbol)
.decl value(n: node, s: symbol)
.decl op_at(n: node, i: number, s: symbol)
.decl pkg(d: number, p: symbol)
.input doc, node, child, field, text, op, op_at, name, str, value, pkg, kind, docof
// Guests (decision 0055): parsed(s, "annotation", r) asks for string s's code, rooted at r; host_node(n, h): h is
// the innermost host node over guest node n.
.decl parsed(s: node, grammar: symbol, root: node)
.decl host_node(n: node, h: node)
.input parsed, host_node
// The run's settings (the Python version and platform a branch is decided by, python/conditions.rr). No library
// is loaded: the imports are resolved, and the libraries loaded, by phase 1 (sources.rr).
.decl env(key: symbol, value: symbol)
.decl dir_entry(dir: symbol, name: symbol, is_dir: number)
.decl file_line(path: symbol, i: number, text: symbol)
#include "python/conditions.rr"
// What the earlier phases hand on (struct.rr, types.rr): every document's structure, the workspace's and the
// libraries' its imports reach, by symbol.
.decl struct__def(s: symbol, k: symbol)
.decl struct__base(c: symbol, i: number, b: symbol)
.decl struct__flag(f: symbol, k: symbol)
.decl struct__shape(f: symbol, need: number, cap: number, kw: number)
.decl types__binds(m: symbol, x: symbol, d: symbol)
.decl types__attr(c: symbol, x: symbol, d: symbol, k: symbol)
.decl types__owner(s: symbol, m: symbol)
.decl types__sig(f: symbol, i: number, x: symbol, a: symbol, d: symbol)
.decl types__rtype(f: symbol, a: symbol, d: symbol)
.decl types__vtype(s: symbol, a: symbol, d: symbol)
.decl types__callret(f: symbol, b: symbol, d: symbol)
.decl types__tparam(c: symbol, i: number, y: symbol)
.decl types__tmap(k: symbol, i: number, a: symbol, y: symbol)
.decl types__rvar(f: symbol, y: symbol)
.decl types__rgen(f: symbol, k: symbol, j: number, y: symbol)
.decl types__ropen(f: symbol)
.decl types__wgen(f: symbol, ka: symbol, i: number, kb: symbol, j: number)
.decl types__pgen(f: symbol, i: number, k: symbol, j: number, y: symbol)
.decl types__rcarg(f: symbol, k: symbol, j: number, d: symbol)
.decl types__anc(c: symbol, a: symbol)
.decl types__proto(c: symbol)
.decl struct__param(f: symbol, i: number, x: symbol, a: symbol)
// The import closure, components.rr's (the engine adds it to a program that reads it): rr_cx_reach(d, e), e is in
// d's closure; rr_cx_sees(d, q), q is a module of d's closure.

.decl scope(kind: symbol)
scope("module"). scope("function_definition"). scope("class_definition"). scope("lambda").
// What a name in a scope sees when its own scope does not bind it: class scopes are skipped.
.decl fscope(kind: symbol)
fscope("module"). fscope("function_definition"). fscope("lambda").
.decl fdef(kind: symbol)
fdef("function_definition").

.decl kind(n: node, k: symbol)
.decl docof(n: node, d: number)
.decl modnode(d: number, m: node)
modnode(d, m) :- node(d, m, "module", _, _).
.decl modname(m: node, q: symbol)
modname(m, q) :- modnode(d, m), doc(d, _, q).

// ---- names read, and the scope that binds them ----------------------------------------------------------------
.decl nameref(n: node, x: symbol)
nameref(n, x) :- kind(n, "identifier"), text(n, x), !field(_, "attribute", n), !field(_, "name", n).
.decl rdefn(s: node, x: symbol, f: node)
rdefn(s, x, f) :- kind(f, "function_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, scope), !py_dead_at(f).
rdefn(s, x, f) :- kind(f, "class_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, scope), !py_dead_at(f).
.decl rasg(s: node, x: symbol, r: node, a: node)
rasg(s, x, r, a) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", r), nearest(a, s, scope), !py_dead_at(a).
// `for x in it`: x is bound to the loop target's value, `it.__iter__().__next__()` (implicit calls, `icall`); `with e
// as x`: to the alias's, `e.__enter__()`. Their `async` forms await `it.__aiter__().__anext__()` and `e.__aenter__()`
// (`iawait`).
rasg(s, x, l, a) :- kind(a, "for_statement"), field(a, "left", l), kind(l, "identifier"), text(l, x), nearest(a, s, scope),
    !py_dead_at(a).
rasg(s, x, t, a) :- kind(a, "with_statement"), child(a, wc, _), child(wc, w, _), kind(w, "with_item"), field(w, "value", p),
    kind(p, "as_pattern"), field(p, "alias", t), child(t, i, 0), kind(i, "identifier"), text(i, x), nearest(a, s, scope), !py_dead_at(a).
.decl param(f: node, x: symbol, i: number)
param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), kind(p, "identifier"), text(p, x).
param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), child(p, id, 0), kind(id, "identifier"), text(id, x).
// Targets whose value is not tracked: patterns, loop and comprehension variables, `with`/`except` names, walrus,
// augmented assignment, and names a `global`/`nonlocal` declaration hands to another scope.
.decl patkind(k: symbol)
patkind("pattern_list"). patkind("tuple_pattern"). patkind("list_pattern"). patkind("list_splat_pattern").
patkind("parenthesized_expression"). patkind("tuple"). patkind("list"). patkind("expression_list").
.decl tgt(t: node)
tgt(l) :- kind(a, "assignment"), field(a, "left", l), !kind(l, "identifier").
tgt(l) :- kind(a, "augmented_assignment"), field(a, "left", l).
tgt(l) :- kind(a, "for_statement"), field(a, "left", l), !kind(l, "identifier").
tgt(l) :- kind(a, "for_in_clause"), field(a, "left", l).
tgt(l) :- kind(a, "named_expression"), field(a, "name", l).
tgt(l) :- kind(l, "as_pattern_target").
tgt(c) :- tgt(t), kind(t, k), patkind(k), child(t, c, _).
tgt(c) :- tgt(t), kind(t, "as_pattern_target"), child(t, c, _), !wtgt(t).
// A `with` alias bound by `rasg`.
.decl wtgt(t: node)
wtgt(t) :- rasg(_, _, t, a), kind(a, "with_statement").
.decl rotgt(s: node, x: symbol)
rotgt(s, x) :- tgt(t), kind(t, "identifier"), text(t, x), nearest(t, s, scope).

// Imports, per scope: `ibind(s, x, q)` binds x to the qualified name q; `ifrom` also keeps the module and name.
.decl impmod(i: node, m: symbol)
impmod(i, m) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "dotted_name"), text(mn, m), !py_dead_at(i).
impmod(i, p) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"),
    child(mn, pre, 0), text(pre, "."), !child(mn, _, 1), docof(i, d), pkg(d, p), p != "", !py_dead_at(i).
impmod(i, @dot(p, m)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"),
    child(mn, pre, 0), text(pre, "."), child(mn, dn, 1), text(dn, m), docof(i, d), pkg(d, p), p != "", !py_dead_at(i).
.decl rifrom(s: node, x: symbol, m: symbol, y: symbol)
rifrom(s, y, m, y) :- impmod(i, m), field(i, "name", n), kind(n, "dotted_name"), text(n, y), nearest(i, s, scope).
rifrom(s, a, m, y) :- impmod(i, m), field(i, "name", x), kind(x, "aliased_import"), field(x, "name", n), text(n, y),
    field(x, "alias", al), text(al, a), nearest(i, s, scope).
.decl ribind(s: node, x: symbol, q: symbol)
ribind(s, x, @dot(m, y)) :- rifrom(s, x, m, y).
ribind(s, t, t) :- kind(i, "import_statement"), field(i, "name", n), kind(n, "dotted_name"), child(n, c, 0), text(c, t), nearest(i, s, scope), !py_dead_at(i).
ribind(s, a, m) :- kind(i, "import_statement"), field(i, "name", x), kind(x, "aliased_import"), field(x, "name", n), text(n, m),
    field(x, "alias", al), text(al, a), nearest(i, s, scope), !py_dead_at(i).
// Two dots or more: `..` is the package's parent (`from .. import x` in `pkg.sub.deep` is `pkg`), one level up per dot.
.decl updots(t: symbol, k: number)
updots("..", 1). updots("...", 2). updots("....", 3).
impmod(i, q) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"),
    child(mn, pre, 0), text(pre, t), updots(t, k), !child(mn, _, 1), docof(i, d), pkg(d, p), q = @pkg_up(p, k), q != "", !py_dead_at(i).
impmod(i, @dot(q, m)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"),
    child(mn, pre, 0), text(pre, t), updots(t, k), child(mn, dn, 1), text(dn, m), docof(i, d), pkg(d, p),
    q = @pkg_up(p, k), q != "", !py_dead_at(i).
// A relative import the facts cannot place (more dots than packages, or outside a package): what it binds is unknown.
.decl irel_open(i: node)
irel_open(i) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"), !impmod(i, _).
rotgt(s, y) :- irel_open(i), field(i, "name", n), kind(n, "dotted_name"), text(n, y), nearest(i, s, scope).
rotgt(s, a) :- irel_open(i), field(i, "name", x), kind(x, "aliased_import"), field(x, "alias", al), text(al, a), nearest(i, s, scope).
.decl star(s: node)
star(s) :- kind(i, "import_from_statement"), child(i, w, _), kind(w, "wildcard_import"), nearest(i, s, scope).

// `global x` / `nonlocal x`: the scope's bindings of x are the module's / the enclosing function's.
.decl decl(s: node, x: symbol, t: node)
decl(s, x, m) :- kind(g, "global_statement"), child(g, i, _), text(i, x), nearest(g, s, scope), docof(g, d), modnode(d, m).
decl(s, x, p) :- kind(g, "nonlocal_statement"), child(g, i, _), text(i, x), nearest(g, s, scope), nearest(s, p, fscope).
.decl rbound(s: node, x: symbol)
rbound(s, x) :- rdefn(s, x, _).
rbound(s, x) :- rasg(s, x, _, _).
rbound(s, x) :- rotgt(s, x).
rbound(s, x) :- ribind(s, x, _).
.decl home(s: node, x: symbol, t: node)
home(s, x, s) :- rbound(s, x), !decl(s, x, _).
home(s, x, t) :- rbound(s, x), decl(s, x, t).
.decl defn(s: node, x: symbol, f: node)
defn(t, x, f) :- rdefn(s, x, f), home(s, x, t).
.decl asg(s: node, x: symbol, r: node, a: node)
asg(t, x, r, a) :- rasg(s, x, r, a), home(s, x, t).
.decl otgt(s: node, x: symbol)
otgt(t, x) :- rotgt(s, x), home(s, x, t).
.decl ifrom(s: node, x: symbol, m: symbol, y: symbol)
ifrom(t, x, m, y) :- rifrom(s, x, m, y), home(s, x, t).
.decl ibind(s: node, x: symbol, q: symbol)
ibind(t, x, q) :- ribind(s, x, q), home(s, x, t).

.decl bound_in(s: node, x: symbol)
bound_in(s, x) :- defn(s, x, _).
bound_in(s, x) :- asg(s, x, _, _).
bound_in(f, x) :- param(f, x, _).
bound_in(s, x) :- otgt(s, x).
bound_in(s, x) :- ibind(s, x, _).

// LEGB: from the nearest scope outwards, skipping class scopes, to the first that binds the name.
.decl walk(n: node, x: symbol, s: node)
walk(n, x, s) :- nameref(n, x), nearest(n, s, scope), !host_node(n, _).
// A name in a guest (a quoted annotation's code) is looked up from the string that holds it.
walk(n, x, s) :- nameref(n, x), host_node(n, h), nearest(h, s, scope).
walk(n, x, p) :- walk(n, x, s), !bound_in(s, x), nearest(s, p, fscope).
.decl look(n: node, x: symbol, s: node)
look(n, x, s) :- walk(n, x, s), bound_in(s, x).
// Bound nowhere: a builtin, or (a star import, `globals()`) unknown.
.decl miss(n: node, x: symbol)
miss(n, x) :- walk(n, x, m), kind(m, "module"), !bound_in(m, x).
.decl builtin_ref(n: node, x: symbol)
builtin_ref(n, x) :- miss(n, x), builtin(x), docof(n, d), modnode(d, m), !star(m).

// ---- unconditional rebinding --------------------------------------------------------------------------------------
// A statement of a scope's own body (not inside an `if`, loop or `try`) binding x; a later one replaces an earlier one.
.decl stmt(st: node, s: node)
stmt(st, s) :- kind(s, "module"), child(s, st, _).
stmt(st, s) :- kind(s, "function_definition"), field(s, "body", b), child(b, st, _).
stmt(st, s) :- kind(s, "class_definition"), field(s, "body", b), child(b, st, _).
.decl defstmt(f: node, st: node)
defstmt(f, f) :- kind(f, "function_definition").
defstmt(f, f) :- kind(f, "class_definition").
defstmt(f, st) :- kind(st, "decorated_definition"), field(st, "definition", f).
.decl asgstmt(a: node, st: node)
asgstmt(a, st) :- kind(st, "expression_statement"), child(st, a, 0), kind(a, "assignment").
.decl sbinds(s: node, x: symbol, st: node)
sbinds(s, x, st) :- defn(s, x, f), defstmt(f, st), stmt(st, s).
sbinds(s, x, st) :- asg(s, x, _, a), asgstmt(a, st), stmt(st, s).
// An `@overload` def does not replace an earlier one: a stub's overloads are all the name's (their union is its
// type), and a later def that is not an overload (the implementation) replaces them all. Read from the decorator's
// own name, not its import: what a name is depends on what is live, which depends on this.
.decl ovlstmt(st: node)
ovlstmt(st) :- kind(st, "decorated_definition"), child(st, dc, _), kind(dc, "decorator"), child(dc, e, 0), text(e, "overload").
ovlstmt(st) :- kind(st, "decorated_definition"), child(st, dc, _), kind(dc, "decorator"), child(dc, e, 0), kind(e, "attribute"),
    field(e, "attribute", a), text(a, "overload").
.decl shadowed(st: node)
shadowed(st) :- sbinds(s, x, st), sbinds(s, x, st2), st2 > st, !ovlstmt(st2).
shadowed(st) :- sbinds(s, x, st), sbinds(s, x, st2), st2 > st, !ovlstmt(st).
.decl live_def(s: node, x: symbol, f: node)
live_def(s, x, f) :- defn(s, x, f), defstmt(f, st), !shadowed(st).
.decl live_asg(s: node, x: symbol, r: node)
live_asg(s, x, r) :- asg(s, x, r, a), !asgstmt(a, _).
live_asg(s, x, r) :- asg(s, x, r, a), asgstmt(a, st), !shadowed(st).

// ---- decorators ---------------------------------------------------------------------------------------------------
.decl dexpr(f: node, e: node)
dexpr(f, e) :- kind(dd, "decorated_definition"), field(dd, "definition", f), child(dd, dc, _), kind(dc, "decorator"), child(dc, e, 0).
.decl transparent_q(q: symbol)
transparent_q("abc.abstractmethod"). transparent_q("typing.final"). transparent_q("typing.override").
transparent_q("typing.no_type_check"). transparent_q("typing_extensions.final"). transparent_q("typing_extensions.override").
transparent_q("functools.wraps"). transparent_q("functools.total_ordering"). transparent_q("dataclasses.dataclass").
// The decorators stubs use (t21 §2.4): each gives back what it decorates, as a type checker reads it.
transparent_q("typing.overload"). transparent_q("typing_extensions.overload"). transparent_q("typing.type_check_only").
transparent_q("typing_extensions.deprecated"). transparent_q("warnings.deprecated"). transparent_q("typing.runtime_checkable").
transparent_q("typing_extensions.runtime_checkable"). transparent_q("typing_extensions.type_check_only").
transparent_q("typing_extensions.disjoint_base"). transparent_q("typing.disjoint_base").
.decl transparent(e: node)
transparent(e) :- qn(e, q), transparent_q(q).
transparent(e) :- kind(e, "call"), field(e, "function", g), qn(g, q), transparent_q(q).
// One defined in the module that uses it (typing.pyi's own `@overload`), by its qualified name: syntactic, as what
// a name is depends on the decorators.
// ownq(e, q): identifier e, as a name of its own module (`typing.overload` in typing.pyi).
.decl ownq(e: node, q: symbol)
ownq(e, q) :- kind(e, "identifier"), text(e, x), docof(e, d), doc(d, _, m), q = @dot(m, x).
transparent(e) :- ownq(e, q), transparent_q(q).
transparent(e) :- builtin_ref(e, "staticmethod").
transparent(e) :- builtin_ref(e, "classmethod").
.decl opaque_dec(f: node, e: node)
opaque_dec(f, e) :- dexpr(f, e), !transparent(e).
.decl isstatic(f: node)
isstatic(f) :- dexpr(f, e), builtin_ref(e, "staticmethod").
.decl classmeth(f: node)
classmeth(f) :- dexpr(f, e), builtin_ref(e, "classmethod").
.decl nopaque(f: node, k: number)
nopaque(f, k) :- opaque_dec(f, _), k = count : { opaque_dec(f, _) }.
// The one decorator that replaces the definition, when there is exactly one.
.decl dec1(f: node, e: node)
dec1(f, e) :- nopaque(f, 1), opaque_dec(f, e).

// ---- functions: returns, returned parameters ----------------------------------------------------------------------
.decl isasync(f: node)
isasync(f) :- op(f, "async").
.decl isgen(f: node)
isgen(f) :- kind(y, "yield"), nearest(y, f, fscope), kind(f, "function_definition").
.decl retval(f: node, r: node)
retval(f, r) :- kind(rs, "return_statement"), nearest(rs, f, fscope), kind(f, "function_definition"), child(rs, r, 0).
// A return of the function's own parameter i (`return func`): the call's value is its i-th argument's.
.decl retparam(f: node, i: number, r: node)
retparam(f, i, r) :- retval(f, r), look(r, x, f), param(f, x, i).
.decl posarg(c: node, i: number, a: node)
posarg(c, i, a) :- kind(c, "call"), field(c, "arguments", as), kind(as, "argument_list"), child(as, a, i), !kind(a, "keyword_argument"),
    !kind(a, "list_splat"), !kind(a, "dictionary_splat").
.decl method(f: node, c: node)
method(f, c) :- kind(f, "function_definition"), nearest(f, c, scope), kind(c, "class_definition").

// ---- classes ------------------------------------------------------------------------------------------------------
.decl basex(c: node, e: node)
basex(c, e) :- kind(c, "class_definition"), field(c, "superclasses", al), child(al, e, _), !kind(e, "keyword_argument").
.decl base(c: node, b: node)
base(c, b) :- basex(c, e), pv(e, "cls", b), !special_base(e).
// The class and every workspace subclass: what a late-bound `self` or `cls` may be.
// The attribute lookups the program makes: a class and the attribute read from it (or from a `super()`).
.decl asks(n: node, c: node, a: symbol)
asks(n, c, a) :- alook(n, c, a).
asks(k, c, "__init__") :- callee(k, e), pv(e, "cls", c).
asks(k, c, "__call__") :- callee(k, e), pv(e, "inst", c).
// need_name(a): an attribute name some lookup reads. Every reader of `found` asks with a name of need_attr's or
// alook's, or with __init__, __call__ or __new__.
// Attribute lookup: the class itself, else its bases (union over bases for multiple inheritance), for the names
// lookups read only: a stub's class binds many names no code reads.
.decl found(c: node, a: symbol, at: node)
found(c, a, c) :- bound_in(c, a).
found(c, a, x) :- base(c, b), !bound_in(c, a), found(b, a, x).
.decl anc(c: node, b: node)
anc(c, c) :- kind(c, "class_definition").
anc(c, b) :- anc(c, m), base(m, b).

// ---- declared types (annotations) ---------------------------------------------------------------------------------
// A parameter's, a return's and a class attribute's annotation declare the values they hold. They are trusted, as a
// type checker trusts them: an annotation naming a workspace class C holds an instance of C or of any workspace
// subclass (the closed world `self` already assumes), a builtin class's name a value of it, `None` None. Unions
// (`A | B`, `Optional[A]`, `Union[A, B]`) are their members; a generic (`LazyResult[T]`, `list[int]`) is its class,
// without arguments; `type[C]` is C's class objects; `Self` is the method's class. Any other member (a type
// variable, `Any`, a `Protocol`, an external class) leaves the declaration open: its known members are a lower
// bound. A quoted annotation (`x: "Node"`, `list["Node"]`) is its code, parsed as an annotation (decision 0055).
.decl ann(t: node, e: node)
ann(t, e) :- kind(t, "type"), child(t, e, 0).
// qann(s, e): string s is an annotation's whole expression, and e is its code's expression: the guest is a module
// holding one statement, `(…)`, whose parentheses amem steps through.
.decl qann(s: node, e: node)
qann(s, e) :- kind(t, "type"), child(t, s, 0), kind(s, "string"), parsed(s, "annotation", m), child(m, x, 0),
    kind(x, "expression_statement"), child(x, e, 0).
.decl union_q(q: symbol)
union_q("typing.Optional"). union_q("typing.Union"). union_q("typing_extensions.Optional"). union_q("typing_extensions.Union").
.decl uhead(e: node)
uhead(e) :- kind(e, "generic_type"), child(e, h, 0), qn(h, q), union_q(q).
uhead(e) :- kind(e, "subscript"), field(e, "value", h), qn(h, q), union_q(q).
// amem(t, e): e is a member of annotation t's union, or an expression that has members.
.decl amem(t: node, e: node)
amem(t, e) :- ann(t, e).
amem(t, m) :- amem(t, e), kind(e, "binary_operator"), op(e, "|"), field(e, "left", m).
amem(t, m) :- amem(t, e), kind(e, "binary_operator"), op(e, "|"), field(e, "right", m).
amem(t, m) :- amem(t, e), kind(e, "parenthesized_expression"), child(e, m, 0).
amem(t, r) :- amem(t, s), qann(s, r).
amem(t, m) :- amem(t, e), kind(e, "union_type"), child(e, u, _), child(u, m, 0).
amem(t, m) :- amem(t, e), uhead(e), kind(e, "generic_type"), child(e, p, 1), child(p, u, _), child(u, m, 0).
amem(t, m) :- amem(t, e), uhead(e), kind(e, "subscript"), field(e, "subscript", m).
.decl asplit(e: node)
asplit(e) :- kind(e, "binary_operator"), op(e, "|").
asplit(e) :- kind(e, "parenthesized_expression").
asplit(s) :- qann(s, _).
asplit(e) :- kind(e, "union_type").
asplit(e) :- uhead(e).
// A member that is not split further, and the name it is headed by (`LazyResult` in `LazyResult[T]`).
.decl aleaf(t: node, m: node)
aleaf(t, m) :- amem(t, m), !asplit(m).
aleaf(t, m) :- amem(t, m), kind(m, "binary_operator"), !op(m, "|").
.decl ahead(m: node, h: node)
ahead(m, h) :- aleaf(_, m), kind(m, "generic_type"), child(m, h, 0).
ahead(m, h) :- aleaf(_, m), kind(m, "subscript"), field(m, "value", h).
ahead(m, m) :- aleaf(_, m), !kind(m, "generic_type"), !kind(m, "subscript").
// The argument of a one-argument generic (`C` in `type[C]`).
.decl aarg(m: node, a: node)
aarg(m, a) :- kind(m, "generic_type"), child(m, p, 1), child(p, u, 0), !child(p, _, 1), child(u, a, 0).
aarg(m, a) :- kind(m, "subscript"), field(m, "subscript", a), !kind(a, "expression_list"), !kind(a, "tuple").
// ainst(t, c): t declares instances of class c (and of its workspace subclasses); acls(t, c): c's class objects.
.decl ainst(t: node, c: node)
ainst(t, c) :- aleaf(t, m), ahead(m, h), pv(h, "cls", c).
.decl acls(t: node, c: node)
acls(t, c) :- aleaf(t, m), ahead(m, h), builtin_ref(h, "type"), aarg(m, a), pv(a, "cls", c).
// aself(m): `Self`.
.decl aself(m: node)
aself(m) :- aleaf(_, m), ahead(m, h), qn(h, "typing.Self").
aself(m) :- aleaf(_, m), ahead(m, h), qn(h, "typing_extensions.Self").
// dtype(m, t): member m declares a value of builtin class t, or None.
.decl dtype(m: node, t: symbol)
dtype(m, "None") :- aleaf(_, m), kind(m, "none").
dtype(m, x) :- aleaf(_, m), ahead(m, h), builtin_ref(h, x), bclass(x), x != "object".
// A class whose instances need not derive from it: a `Protocol`.
.decl proto_q(q: symbol)
proto_q("typing.Protocol"). proto_q("typing_extensions.Protocol").
.decl aproto(c: node)
// A protocol lists `Protocol` among its own bases (PEP 544): a class deriving from a protocol is an ordinary class
// (`pathlib.Path` from `os.PathLike[str]`).
aproto(c) :- basex(c, e), qn(e, q), proto_q(q).
aproto(c) :- basex(c, e), kind(e, "generic_type"), child(e, h, 0), qn(h, q), proto_q(q).
aproto(c) :- basex(c, e), kind(e, "subscript"), field(e, "value", h), qn(h, q), proto_q(q).
.decl aknown(t: node, m: node)
aknown(t, m) :- aleaf(t, m), dtype(m, _).
aknown(t, m) :- aleaf(t, m), aself(m).
aknown(t, m) :- aleaf(t, m), ahead(m, h), pv(h, "cls", c), !aproto(c), !builtin_ref(h, "type").
aknown(t, m) :- aleaf(t, m), ahead(m, h), builtin_ref(h, "type"), aarg(m, a), pv(a, "cls", _).
aknown(t, m) :- aleaf(t, m), ahead(m, h), lv(h, "cls", c), !lproto(c), !builtin_ref(h, "type").
aknown(t, m) :- aleaf(t, m), ahead(m, h), builtin_ref(h, "type"), aarg(m, a), lv(a, "cls", _).
.decl aopen(t: node)
aopen(t) :- aleaf(t, m), !aknown(t, m).
// Parameters: `x: T` and `x: T = v` (the default's own value is added as an assignment's is).
.decl pann(f: node, x: symbol, t: node)
pann(f, x, t) :- field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_parameter"), child(p, id, 0), kind(id, "identifier"),
    text(id, x), field(p, "type", t).
pann(f, x, t) :- field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_default_parameter"), field(p, "name", id), text(id, x),
    field(p, "type", t).
.decl pdefault(f: node, x: symbol, v: node)
pdefault(f, x, v) :- field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_default_parameter"), field(p, "name", id), text(id, x),
    field(p, "value", v).
.decl pclosed(f: node, x: symbol)
pclosed(f, x) :- pann(f, x, t), !aopen(t).
// A parameter's declared classes, with their subclasses, only where the parameter is read: a function scope's
// values are read through `look` alone, and a stub's parameters are never read.
.decl pread(f: node, x: symbol)
pread(f, x) :- pann(f, x, _), look(_, x, f).
// uinst: ainst cut to the annotations these rules read (a library's stubs annotate `str` thousands of times; a new
// subclass of it looks up only these).
.decl uann(t: node)
uann(t) :- pann(f, x, t), pread(f, x).
uann(t) :- cann(c, x, t), cread(c, x).
.decl uinst(t: node, c: node)
uinst(t, c) :- uann(t), ainst(t, c).
bv(f, x, "inst", s) :- pann(f, x, t), pread(f, x), uinst(t, c), anc(s, c), docof(f, d9), docof(s, e9), rr_cx_reach(d9, e9).
bv(f, x, "cls", s) :- pann(f, x, t), pread(f, x), acls(t, c), anc(s, c), docof(f, d9), docof(s, e9), rr_cx_reach(d9, e9).
bv(f, x, "inst", s) :- pann(f, x, t), pread(f, x), aleaf(t, m), aself(m), method(f, c), anc(s, c), docof(f, d9), docof(s, e9), rr_cx_reach(d9, e9).
bv(f, x, k, v) :- pdefault(f, x, d), pv(d, k, v).
tbv(f, x, "decl", m) :- pann(f, x, t), aleaf(t, m), dtype(m, _).
tbv(f, x, k, v) :- pdefault(f, x, d), tv(d, k, v).
// Returns: `def f(...) -> T`. A call of f holds T's values (beside what its returns are seen to hold); when T is
// closed, the call is known whatever its returns are.
.decl rann(f: node, t: node)
rann(f, t) :- kind(f, "function_definition"), field(f, "return_type", t).
.decl rclosed(f: node)
rclosed(f) :- rann(f, t), !aopen(t), !isasync(f).
// rret(f, "inst", k): f is declared to return an instance of class k (or of a subclass); "cls" for `type[k]`.
.decl rret(f: node, w: symbol, k: node)
rret(f, "inst", k) :- rann(f, t), !isasync(f), ainst(t, k).
rret(f, "cls", k) :- rann(f, t), !isasync(f), acls(t, k).
rret(f, "inst", k) :- rann(f, t), !isasync(f), aleaf(t, m), aself(m), method(f, k).
// cret(c, w, k): call c's declared return class. Joined with the subclasses last, so a new subclass row reaches
// only the calls declared to return its base.
.decl cret(c: node, w: symbol, k: node)
cret(c, w, k) :- cfn(c, e, f), rret(f, w, k), !rgen(f, _).
pv(c, w, s) :- cret(c, w, k), anc(s, k), docof(c, d9), docof(s, e9), rr_cx_reach(d9, e9).
// awaitf(w, c, f): `await c`, where call c runs the async def f (not an async generator, which is not awaited). Its
// value is what f returns, declared (`async def f() -> K`: the coroutine's result, not the call's) or returned.
.decl awaitf(w: node, c: node, f: node)
awaitf(w, c, f) :- kind(w, "await"), child(w, c, 0), cfn(c, _, f), isasync(f), !isgen(f).
.decl aclosed(f: node)
aclosed(f) :- rann(f, t), !aopen(t), isasync(f).
.decl aret(f: node, w: symbol, k: node)
aret(f, "inst", k) :- rann(f, t), isasync(f), ainst(t, k).
aret(f, "cls", k) :- rann(f, t), isasync(f), acls(t, k).
cret(w, k, c) :- awaitf(w, _, f), aret(f, k, c).
pv(w, k, v) :- awaitf(w, _, f), fret(f, k, v).

// ---- generics (t21 §5.1, first version) --------------------------------------------------------------------------
// A class's type parameters, by position: `Generic[K, V]` (or `Protocol[T]`) among its bases, else the type variables
// its first generic base is given (`class list(MutableSequence[_T])`). A type variable: a module's `x = TypeVar(...)`.
.decl tvarq(m: node, x: symbol)
tvarq(m, x) :- rasg(m, x, r, _), kind(m, "module"), kind(r, "call"), field(r, "function", e), text(e, "TypeVar").
tvarq(m, x) :- rasg(m, x, r, _), kind(m, "module"), kind(r, "call"), field(r, "function", e), field(e, "attribute", a), text(a, "TypeVar").
// sarg(e, j, a): a is the j-th argument of the generic e (`dict[str, int]` as a subscript or an annotation's type).
// pred(i, j): j = i - 1, for the positions a generic's arguments and a method's parameters take.
.decl pred(i: number, j: number)
pred(1, 0). pred(2, 1). pred(3, 2). pred(4, 3). pred(5, 4). pred(6, 5). pred(7, 6). pred(8, 7).
.decl sarg(e: node, j: number, a: node)
sarg(e, j, a) :- kind(e, "subscript"), child(e, a, i), pred(i, j).
sarg(e, j, a) :- kind(e, "generic_type"), child(e, p, 1), kind(p, "type_parameter"), child(p, u, j), child(u, a, 0).
// Read from the bases as written, not their values (which read these): `Generic[...]` and `Protocol[...]` by name.
.decl pform(e: node)
pform(e) :- kind(e, "subscript"), field(e, "value", h), kind(h, "identifier"), text(h, x), pform_name(x).
pform(e) :- kind(e, "subscript"), field(e, "value", h), field(h, "attribute", a), text(a, x), pform_name(x).
.decl pform_name(x: symbol)
pform_name("Generic"). pform_name("Protocol").
.decl explicit_params(c: node)
explicit_params(c) :- basex(c, e), pform(e).
.decl gbase_at(c: node, e: node, j: number)
gbase_at(c, e, j) :- field(c, "superclasses", al), child(al, e, j), kind(e, "subscript"), !pform(e), sarg(e, _, a),
    kind(a, "identifier"), text(a, y), nearest(c, m, scope), tvarq(m, y).
.decl gbase_later(c: node, j: number)
gbase_later(c, j) :- gbase_at(c, _, j), gbase_at(c, _, i), i < j.
.decl cparam(c: node, i: number, y: symbol)
cparam(c, i, y) :- basex(c, e), pform(e), sarg(e, i, a), kind(a, "identifier"), text(a, y).
// Else the type variables of its first base with one as an argument (`_GeneratorContextManager`'s first base takes
// `Generator[_T_co, ...]`, not a type variable).
cparam(c, i, y) :- gbase_at(c, e, j), !gbase_later(c, j), !explicit_params(c), sarg(e, i, a), kind(a, "identifier"), text(a, y),
    nearest(c, m, scope), tvarq(m, y).
// tmap(k, i, a, y): ancestor a's parameter y is k's parameter i; tfix(k, a, y, x): it is the annotation x, fixed by
// k's bases (`class D(M[str, int])`).
.decl tmap(k: node, i: number, a: node, y: symbol)
tmap(k, i, k, y) :- cparam(k, i, y).
tmap(k, i, a, y) :- basex(k, b), gbase(b, bc), sarg(b, j, x), kind(x, "identifier"), text(x, z), cparam(k, i, z), tmap(bc, j, a, y).
.decl tparg(k: node, x: node)
tparg(k, x) :- basex(k, b), sarg(b, _, x), kind(x, "identifier"), text(x, z), cparam(k, _, z).
.decl tfix(k: node, a: node, y: symbol, x: node)
tfix(k, a, y, x) :- basex(k, b), gbase(b, bc), sarg(b, j, x), !tparg(k, x), tmap(bc, j, a, y).
tfix(k, a, y, x) :- base(k, bc), tfix(bc, a, y, x).
// A generic annotation's value: the annotation itself (`dict[str, int]`), beside its class's instances, so a method
// declared to return the class's parameter returns what the annotation gives it.
.decl gleaf(t: node, m: node)
gleaf(t, m) :- uann(t), aleaf(t, m), ahead(m, h), m != h, pv(h, "cls", k), cparam(k, _, _).
bv(f, x, "gen", m) :- pann(f, x, t), pread(f, x), gleaf(t, m).
bv(c, x, "gen", m) :- cann(c, x, t), cread(c, x), gleaf(t, m).
// rtvar(f, a, y): method f of class a is declared to return a's parameter y; rpvar(f, i, y): function f returns its
// own type variable y, which its parameter i is declared to be (`def get(self, key, default: _T) -> _VT | _T`).
.decl rtvar(f: node, a: node, y: symbol)
rtvar(f, a, y) :- rann(f, t), !isasync(f), aleaf(t, r), kind(r, "identifier"), text(r, y), method(f, a), cparam(a, _, y).
.decl rpvar(f: node, i: number, y: symbol)
rpvar(f, i, y) :- rann(f, t), !isasync(f), aleaf(t, r), kind(r, "identifier"), text(r, y), pann(f, x, pt), aleaf(pt, pr),
    kind(pr, "identifier"), text(pr, y), param(f, x, i), !rtvar(f, _, y).
// rgen(f, r): f is declared to return the generic r (`-> Iterator[_T]`, `-> dict[str, V]`), a class's subscript, not a
// special form's (`Optional[...]`, `type[...]`, `Callable[...]`). Read as written, so the recursion can tell its
// calls apart.
.decl rgen(f: node, r: node)
rgen(f, r) :- rann(f, t), ann(t, r), !isasync(f), kind(r, "generic_type"), child(r, h, 0), gname(h, x), !gform_name(x).
rgen(f, r) :- rann(f, t), ann(t, r), !isasync(f), kind(r, "subscript"), field(r, "value", h), gname(h, x), !gform_name(x).
.decl gname(h: node, x: symbol)
gname(h, x) :- kind(h, "identifier"), text(h, x).
gname(h, x) :- kind(h, "attribute"), field(h, "attribute", a), text(a, x).
.decl gform_name(x: symbol)
gform_name("Optional"). gform_name("Union"). gform_name("type"). gform_name("Type"). gform_name("Callable"). gform_name("Literal").
gform_name("Annotated"). gform_name("ClassVar"). gform_name("Final"). gform_name("TypeGuard"). gform_name("TypeIs").
gform_name("Concatenate"). gform_name("Unpack"). gform_name("Required"). gform_name("NotRequired"). gform_name("ReadOnly").
// tvar_of(f, z): argument z of f's declared generic is a parameter of f's class.
.decl tvar_of(f: node, z: node)
tvar_of(f, z) :- rgen(f, r), method(f, a), sarg(r, _, z), kind(z, "identifier"), text(z, y), cparam(a, _, y).
// gfn(c, f): call c (a call, an implicit call) runs f, declared to return its class's parameter or a generic;
// gcall(c, o, f): on o's value.
.decl gret(f: node)
gret(f) :- rtvar(f, _, _).
gret(f) :- rgen(f, _).
.decl gfn(c: node, f: node)
gfn(c, f) :- cfn(c, e, f), gret(f).
gfn(c, f) :- ifn(c, f), gret(f).
.decl gcall(c: node, o: node, f: node)
gcall(c, o, f) :- gfn(c, f), callee(c, n), attr_of(n, o, _).
gcall(c, o, f) :- gfn(c, f), icall(c, o, _).
// A generic value's class and arguments: an annotation's as written (`dict[str, V]`), or a call's declared generic
// return, its type variables bound at the call (`list[V]`'s `__iter__() -> Iterator[_T]` is an Iterator of V). The
// call's node stands for the generic it returns. Its class is exactly the declared one: a subclass's method is
// typed by it.
.decl ghcls(v: node, k: node)
ghcls(m, k) :- gleaf(_, m), ahead(m, h), pv(h, "cls", k).
ghcls(x, k) :- sarg(_, _, x), ghead(x, h), x != h, pv(h, "cls", k), cparam(k, _, _).
ghcls(c, k) :- gfn(c, f), rgen(f, r), ahead(r, h), pv(h, "cls", k).
.decl garg(v: node, i: number, x: node)
garg(m, i, x) :- ghcls(m, _), sarg(m, i, x).
garg(c, j, x) :- gcall(c, _, f), rgen(f, r), sarg(r, j, z), tvar_of(f, z), text(z, y), method(f, a), gpar(c, a, y, x).
garg(c, j, z) :- gfn(c, f), rgen(f, r), sarg(r, j, z), !tvar_of(f, z).
pv(c, "gen", c) :- gfn(c, f), rgen(f, _), ghcls(c, _).
pv(c, "inst", k) :- gfn(c, f), rgen(f, _), ghcls(c, k).
// A wrapper's call (`wrap`) holds the B its decorator g declares, exactly; B's type variables are bound by matching A
// against f's declared return (`Generator[None, None, None]` against `Iterator[_T_co]`, through Generator's bases).
.decl wcall(c: node, f: node, g: node)
wcall(c, f, g) :- callee(c, e), pv(e, "wfn", f), decfn(f, g).
ghcls(c, k) :- wcall(c, _, g), wrap(g, _, b), gann_head(b, h), pv(h, "cls", k).
pv(c, "inst", k) :- wcall(c, _, g), wrap(g, _, b), gann_head(b, h), pv(h, "cls", k).
pv(c, "gen", c) :- wcall(c, _, _), ghcls(c, _).
garg(c, j, x) :- wcall(c, f, g), wrap(g, _, b), sarg(b, j, z), kind(z, "identifier"), text(z, y), wbind(f, g, y, x).
// wbind(f, g, y, x): A's argument i is g's type variable y, and f's declared return rf, whose class kf has A's class
// ka among its ancestors, gives ka's parameter i the annotation x.
.decl wbind(f: node, g: node, y: symbol, x: node)
wbind(f, g, y, x) :- decfn(f, g), wrap(g, a, _), gann_head(a, ha), pv(ha, "cls", ka), sarg(a, i, z), kind(z, "identifier"), text(z, y),
    cparam(ka, i, w), rann(f, t), ann(t, rf), gann_head(rf, hf), pv(hf, "cls", kf), tmap(kf, i2, ka, w), sarg(rf, i2, x).
// gpar(c, a, y, x): at call c, the receiver binds its class a's parameter y to the annotation x: through its generic
// value's arguments, or its class's bases (`class D(M[str, int])`).
.decl gpar(c: node, a: node, y: symbol, x: node)
gpar(c, a, y, x) :- gcall(c, o, f), method(f, a), pv(o, "gen", g), ghcls(g, k), tmap(k, i, a, y), garg(g, i, x).
gpar(c, a, y, x) :- gcall(c, o, f), method(f, a), pv(o, "inst", k), tfix(k, a, y, x).
// gbind(c, x): call c's value is what annotation x declares.
.decl gbind(c: node, x: node)
gbind(c, x) :- gcall(c, _, f), rtvar(f, a, y), gpar(c, a, y, x).
.decl ghead(x: node, h: node)
ghead(x, h) :- sarg(_, _, x), kind(x, "subscript"), field(x, "value", h).
ghead(x, h) :- sarg(_, _, x), kind(x, "generic_type"), child(x, h, 0).
ghead(x, x) :- sarg(_, _, x), !kind(x, "subscript"), !kind(x, "generic_type").
// The bound class first, joined with its subclasses last (as `cret`): a new subclass row then reaches only the calls
// bound to its base, not every class's value.
.decl gcls(c: node, x: node, k: node)
gcls(c, x, k) :- gbind(c, x), ghead(x, h), pv(h, "cls", k).
pv(c, "inst", s) :- gcls(c, _, k), anc(s, k), docof(c, d9), docof(s, e9), rr_cx_reach(d9, e9).
pv(c, "gen", x) :- gcls(c, x, k), ghead(x, h), x != h, cparam(k, _, _).
// A function's own type variable, from the argument its parameter is given (a method's arguments follow `self`).
pv(c, k, v) :- cfn(c, e, f), !method(f, _), rpvar(f, i, _), posarg(c, i, a), pv(a, k, v).
pv(c, k, v) :- cfn(c, e, f), attr_of(e, _, _), method(f, _), rpvar(f, i, _), pred(i, j), posarg(c, j, a), pv(a, k, v).
// Or from the generic its parameter is declared (`sorted(iterable: Iterable[_T]) -> list[_T]`): ownvar(f, y), f's
// return reads its own type variable y; fgp(f, i, ka, w, y), f's parameter i is declared a generic of class ka whose
// parameter w is y; fbind(c, f, y, x), at call c the argument's generic value, or its class's bases, give w the
// annotation x.
.decl ownvar(f: node, y: symbol)
ownvar(f, y) :- rann(f, t), !isasync(f), aleaf(t, r), kind(r, "identifier"), text(r, y), !method(f, _).
ownvar(f, y) :- rann(f, t), !isasync(f), aleaf(t, r), kind(r, "identifier"), text(r, y), method(f, a), !cparam(a, _, y).
ownvar(f, y) :- rgen(f, r), sarg(r, _, z), kind(z, "identifier"), text(z, y), !method(f, _).
ownvar(f, y) :- rgen(f, r), sarg(r, _, z), kind(z, "identifier"), text(z, y), !tvar_of(f, z), method(f, _).
.decl fgp(f: node, i: number, ka: node, w: symbol, y: symbol)
fgp(f, i, ka, w, y) :- ownvar(f, y), pann(f, x, pt), param(f, x, i), ann(pt, g), gann_head(g, h), pv(h, "cls", ka), sarg(g, j, z),
    kind(z, "identifier"), text(z, y), cparam(ka, j, w).
.decl fcall(c: node, f: node, i: number, a: node)
fcall(c, f, i, a) :- cfn(c, e, f), !method(f, _), fgp(f, i, _, _, _), posarg(c, i, a).
fcall(c, f, i, a) :- cfn(c, e, f), attr_of(e, _, _), method(f, _), fgp(f, i, _, _, _), pred(i, j), posarg(c, j, a).
.decl fbind(c: node, f: node, y: symbol, x: node)
fbind(c, f, y, x) :- fcall(c, f, i, a), fgp(f, i, ka, w, y), pv(a, "gen", g), ghcls(g, k), tmap(k, i2, ka, w), garg(g, i2, x).
fbind(c, f, y, x) :- fcall(c, f, i, a), fgp(f, i, ka, w, y), pv(a, "inst", k), tfix(k, ka, w, x).
gbind(c, x) :- fbind(c, f, y, x), rann(f, t), aleaf(t, r), kind(r, "identifier"), text(r, y).
garg(c, j, x) :- fbind(c, f, y, x), rgen(f, r), sarg(r, j, z), kind(z, "identifier"), text(z, y).
// A protocol's parameter, which one of its methods is declared to return (`next(i: SupportsNext[_T]) -> _T`): f
// returns what the argument's method of that name returns, as an implicit call (`i.__next__()`) does. Not an `icall`,
// which is read before values (its receiver is a value root): pfn(c, o, f), call c runs o's method f.
.decl pmeth(ka: node, w: symbol, m: symbol)
pmeth(ka, w, m) :- rtvar(mm, ka, w), aproto(ka), field(mm, "name", n), text(n, m).
.decl pcall(c: node, o: node, m: symbol)
pcall(c, a, m) :- fcall(c, f, i, a), fgp(f, i, ka, w, y), pmeth(ka, w, m), rann(f, t), aleaf(t, r), kind(r, "identifier"), text(r, y).
asks(c, k, m) :- pcall(c, o, m), pv(o, "inst", k).
.decl pfn(c: node, o: node, f: node)
pfn(c, o, f) :- pcall(c, o, m), pv(o, "inst", k), fv(c, k, m, "fn", f).
pv(c, k, v) :- pfn(c, _, f), !isasync(f), !isgen(f), fret(f, k, v).
cret(c, w, k) :- pfn(c, _, f), rret(f, w, k), !rgen(f, _).
gfn(c, f) :- pfn(c, _, f), gret(f).
gcall(c, o, f) :- gfn(c, f), pfn(c, o, f).

// ---- implicit calls -------------------------------------------------------------------------------------------
// icall(c, o, a): c's value is what o's method a returns, a call with no node for the method: a subscript `o[i]` is
// `o.__getitem__(i)`. A class's subscript (`list[int]`, a generic alias) is no call of it.
.decl icall(c: node, o: node, a: symbol)
icall(c, o, "__getitem__") :- vpos(c), kind(c, "subscript"), field(c, "value", o).
// A loop's statement holds its iterator, its target the iterator's next value; a `with` alias the value entered.
icall(a, it, "__iter__") :- rasg(_, _, l, a), kind(a, "for_statement"), !op(a, "async"), field(a, "right", it).
icall(l, a, "__next__") :- rasg(_, _, l, a), kind(a, "for_statement"), !op(a, "async").
icall(t, e, "__enter__") :- rasg(_, _, t, a), kind(a, "with_statement"), !op(a, "async"), kind(t, "as_pattern_target"), field(p, "alias", t),
    child(p, e, 0).
// `async for`: the statement holds `it.__aiter__()`, a plain call; its target the awaited `__anext__()` of that.
icall(a, it, "__aiter__") :- rasg(_, _, l, a), kind(a, "for_statement"), op(a, "async"), field(a, "right", it).
// iawait(c, o, a): c's value is the result of awaiting o's method a, an implicit call: an `async for` target's
// `__anext__()`, an `async with` alias's `__aenter__()`.
.decl iawait(c: node, o: node, a: symbol)
iawait(l, a, "__anext__") :- rasg(_, _, l, a), kind(a, "for_statement"), op(a, "async").
iawait(t, e, "__aenter__") :- rasg(_, _, t, a), kind(a, "with_statement"), op(a, "async"), kind(t, "as_pattern_target"), field(p, "alias", t),
    child(p, e, 0).
vroot(o) :- iawait(_, o, _).
asks(c, k, a) :- iawait(c, o, a), pv(o, "inst", k).
// iafn(c, f): the workspace `async def` an awaited implicit call runs; c holds its coroutine's result, as `await`
// of a call does (`awaitf`).
.decl iafn(c: node, f: node)
iafn(c, f) :- iawait(c, o, a), pv(o, "inst", k), fv(c, k, a, "fn", f), isasync(f), !isgen(f).
cret(c, w, k) :- iafn(c, f), aret(f, w, k).
pv(c, k, v) :- iafn(c, f), fret(f, k, v).
vroot(o) :- icall(_, o, _).
asks(c, k, a) :- icall(c, o, a), pv(o, "inst", k).
// ifn(c, f): the method an implicit call runs.
.decl ifn(c: node, f: node)
ifn(c, f) :- icall(c, o, a), pv(o, "inst", k), fv(c, k, a, "fn", f).
pv(c, k, v) :- ifn(c, f), !isasync(f), !isgen(f), fret(f, k, v).
cret(c, w, k) :- ifn(c, f), rret(f, w, k), !rgen(f, _).
tv(c, "decl", m) :- cfn(c, e, f), !isasync(f), rann(f, t), aleaf(t, m), dtype(m, _).
// Class attributes: `x: T` or `x: T = v` in a class body binds x there; T's values are what instances may read.
.decl cann(c: node, x: symbol, t: node)
cann(c, x, t) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "type", t), nearest(a, c, scope),
    kind(c, "class_definition"), !py_dead_at(a).
// `self.x: T` or `self.x: T = v` in a method declares the attribute on its class, as `x: T` in the body does (`self`:
// the method's first parameter; not `selfparam`, whose static test reads the decorators' values, which read this).
cann(c, x, t) :- kind(a, "assignment"), field(a, "left", l), kind(l, "attribute"), field(l, "object", o), kind(o, "identifier"),
    text(o, sn), field(l, "attribute", at), text(at, x), field(a, "type", t), nearest(a, f, fdef), method(f, c), param(f, sn, 0),
    !py_dead_at(a).
bound_in(c, x) :- cann(c, x, _).
// A class attribute's, only where it is read: through `found` (a name a lookup reads), or by name in the class
// body (`look`).
.decl cread(c: node, x: symbol)
cread(c, x) :- cann(c, x, _).
cread(c, x) :- cann(c, x, _), look(_, x, c).
bv(c, x, "inst", s) :- cann(c, x, t), cread(c, x), uinst(t, k), anc(s, k), docof(c, d9), docof(s, e9), rr_cx_reach(d9, e9).
bv(c, x, "cls", s) :- cann(c, x, t), cread(c, x), acls(t, k), anc(s, k), docof(c, d9), docof(s, e9), rr_cx_reach(d9, e9).
tbv(c, x, "decl", m) :- cann(c, x, t), aleaf(t, m), dtype(m, _).
// An attribute declared closed: assignments elsewhere (`self.x = ...`) conform to it.
.decl adeclared(c: node, a: symbol)
adeclared(c, a) :- found(c, a, at), cann(at, a, t), !aopen(t).
// A decorator declared to return its argument's own type (`def d(fn: F) -> F`, F a type variable: a type
// parameter of d, or a module's `TypeVar`): the decorated name keeps the function, as a type checker reads it.
.decl tvar(g: node, x: symbol)
tvar(g, x) :- field(g, "type_parameters", tp), child(tp, p, _), child(p, e, 0), ann(p, e), kind(e, "identifier"), text(e, x).
tvar(g, x) :- field(g, "type_parameters", tp), child(tp, p, _), child(p, e, 0), ann(p, e), kind(e, "constrained_type"), child(e, u, 0),
    child(u, i, 0), kind(i, "identifier"), text(i, x).
// mtvar(d, x): x is a module-level `TypeVar` of document d, in scope in each of its functions.
.decl mtvar(m: node, x: symbol)
mtvar(m, x) :- modnode(_, m), rasg(m, x, r, _), callee(r, h), qn(h, "typing.TypeVar").
.decl ident_dec(g: node)
ident_dec(g) :- param(g, x, 0), pann(g, x, t), ann(t, e), kind(e, "identifier"), text(e, v), rann(g, r), ann(r, e2), kind(e2, "identifier"),
    text(e2, v), tvar(g, v).
ident_dec(g) :- param(g, x, 0), pann(g, x, t), ann(t, e), kind(e, "identifier"), text(e, v), rann(g, r), ann(r, e2), kind(e2, "identifier"),
    text(e2, v), docof(g, d), modnode(d, mm), mtvar(mm, v).
// A class decorator's form, `(cls: type[T]) -> type[T]`.
ident_dec(g) :- param(g, x, 0), pann(g, x, t), ann(t, e), typeof_var(e, v), rann(g, r), ann(r, e2), typeof_var(e2, v), tvar(g, v).
ident_dec(g) :- param(g, x, 0), pann(g, x, t), ann(t, e), typeof_var(e, v), rann(g, r), ann(r, e2), typeof_var(e2, v), docof(g, d), modnode(d, mm), mtvar(mm, v).
// typeof_var(e, v): e is `type[v]` (or `Type[v]`), v a name.
.decl typeof_var(e: node, v: symbol)
typeof_var(e, v) :- kind(e, "generic_type"), child(e, h, 0), text(h, n), type_form(n), aarg(e, a), kind(a, "identifier"), text(a, v).
typeof_var(e, v) :- kind(e, "subscript"), field(e, "value", h), text(h, n), type_form(n), aarg(e, a), kind(a, "identifier"), text(a, v).
.decl type_form(n: symbol)
type_form("type"). type_form("Type").

// ---- values ---------------------------------------------------------------------------------------------------
.decl attr_of(n: node, o: node, a: symbol)
attr_of(n, o, a) :- kind(n, "attribute"), field(n, "object", o), field(n, "attribute", at), text(at, a).
.decl callee(c: node, e: node)
// A call in a guest (a quoted annotation's code) is not evaluated: only its names are read.
callee(c, e) :- kind(c, "call"), field(c, "function", e), !host_node(c, _).
// Qualified names: an imported name and attributes of one (`os.path.join`), whether or not the workspace defines it.
.decl qn(n: node, q: symbol)
qn(n, q) :- look(n, x, s), ibind(s, x, q).
qn(n, @dot(q, a)) :- attr_of(n, o, a), qn(o, q).
// What a workspace qualified name denotes: a module, or a module-level binding of one.
.decl qv(m: node, q: symbol, k: symbol, v: node)
qv(m, q, "mod", m) :- modname(m, q).
qv(m, @dot(q, x), k, v) :- modname(m, q), bv(m, x, k, v).
// `from n import *` at a module's top level: the module binds each public name of n it does not bind itself
// (`collections.abc` is `_collections_abc`'s names). Only the names asked of it (`wantx`), so no name is made.
.decl star_from(m: node, n: symbol)
star_from(m, n) :- kind(i, "import_from_statement"), child(i, w, _), kind(w, "wildcard_import"), nearest(i, m, scope),
    modname(m, _), impmod(i, n).
.decl starx(m: node, x: symbol, m2: node)
starx(m, x, m2) :- star_from(m, n), modname(m2, n), bv(m2, x, _, _), !prefix("_", x), !rbound(m, x).
bv(m, x, k, v) :- starx(m, x, m2), bv(m2, x, k, v).

// Binding values: what name x of scope s may hold.
.decl bv(s: node, x: symbol, k: symbol, v: node)
bv(s, x, "fn", f) :- live_def(s, x, f), kind(f, "function_definition"), !opaque_dec(f, _).
bv(s, x, "cls", c) :- live_def(s, x, c), kind(c, "class_definition").
// decfn(f, g): f's one decorator is function g; decval(f, k, v): what g returns, f's value. Made first, so each
// join starts from the few decorated definitions, not from every expression that names g.
.decl decfn(f: node, g: node)
decfn(f, g) :- dec1(f, e), pv(e, "fn", g).
.decl decval(f: node, k: symbol, v: node)
decval(f, k, v) :- decfn(f, g), !ident_dec(g), retval(g, r), pv(r, k, v).
// A decorator that returns its argument keeps the definition, a function or a class.
.decl defk(f: node, k: symbol)
defk(f, "fn") :- kind(f, "function_definition").
defk(f, "cls") :- kind(f, "class_definition").
bv(s, x, k, f) :- live_def(s, x, f), decfn(f, g), retparam(g, 0, _), defk(f, k).
bv(s, x, k, v) :- live_def(s, x, f), decval(f, k, v).
bv(s, x, k, f) :- live_def(s, x, f), decfn(f, g), ident_dec(g), defk(f, k).
// A decorator declared `(f: Callable[P, A]) -> Callable[P, B]` (`contextlib.contextmanager`) gives back a wrapper of
// f's parameters: its value is `wfn` f, whose call runs f and holds a B (`wcall`).
.decl wrap(g: node, a: node, b: node)
wrap(g, a, b) :- param(g, x, 0), pann(g, x, t), ann(t, ca), callable_ann(ca, p, a), rann(g, r), ann(r, cb), callable_ann(cb, p, b).
.decl callable_ann(e: node, p: symbol, r: node)
callable_ann(e, p, r) :- gann_head(e, h), gname(h, "Callable"), sarg(e, 0, pe), kind(pe, "identifier"), text(pe, p), sarg(e, 1, r).
// gann_head(e, h): the generic annotation e is headed by h (`Iterator` in `Iterator[_T]`), read as written.
.decl gann_head(e: node, h: node)
gann_head(e, h) :- kind(e, "generic_type"), child(e, h, 0).
gann_head(e, h) :- kind(e, "subscript"), field(e, "value", h).
bv(s, x, "wfn", f) :- live_def(s, x, f), decfn(f, g), wrap(g, _, _), !ident_dec(g).
bv(s, x, k, v) :- live_asg(s, x, r), pv(r, k, v).
bv(s, x, k, v) :- ibind(s, x, q), qv(m9, q, k, v), docof(s, d9), docof(m9, e9), rr_cx_reach(d9, e9).
// `self` (the first parameter of a method that is not static) and `cls` (of a class method) are late bound.
bv(f, x, "inst", s) :- method(f, c), param(f, x, 0), !isstatic(f), !classmeth(f), anc(s, c), docof(f, d9), docof(s, e9), rr_cx_reach(d9, e9).
bv(f, x, "cls", s) :- method(f, c), param(f, x, 0), classmeth(f), anc(s, c), docof(f, d9), docof(s, e9), rr_cx_reach(d9, e9).

.decl pv(n: node, k: symbol, v: node)
pv(n, k, v) :- look(n, x, s), bv(s, x, k, v).
pv(n, k, v) :- qn(n, q), qv(m9, q, k, v), docof(n, d9), docof(m9, e9), rr_cx_reach(d9, e9).
pv(n, k, v) :- alook(n, c, a), fv(n, c, a, k, v).
// fv(c, a, k, v): attribute a of class c, where it is found (on c or a base), may hold a k v.
.decl fv(n: node, c: node, a: symbol, k: symbol, v: node)
fv(n, c, a, k, v) :- asks(n, c, a), found(c, a, at), bv(at, a, k, v).
// alook(n, c, a): the attribute `o.a` at n is looked up on class c: o's class, o itself where o is a class, or each
// base of the class `super()` is in. One join per attribute node, which the lookup above, `need_attr`, `vopen` and
// the method resolution read, in place of each joining the object's values to the class's bindings itself.
.decl alook(n: node, c: node, a: symbol)
alook(n, c, a) :- attr_of(n, o, a), pv(o, "cls", c).
alook(n, c, a) :- attr_of(n, o, a), pv(o, "inst", c).
alook(n, b, a) :- attr_of(n, o, a), pv(o, "super", c), base(c, b).
// pass(n, c): n's value is c's (a parenthesized value, either branch of a conditional, either operand of `and`/`or`,
// an assignment's right side, a walrus's value).
.decl pass(n: node, c: node)
pass(n, c) :- kind(n, "parenthesized_expression"), child(n, c, 0).
pass(n, c) :- kind(n, "conditional_expression"), child(n, c, 0).
pass(n, c) :- kind(n, "conditional_expression"), child(n, c, 2).
pass(n, c) :- kind(n, "boolean_operator"), field(n, "left", c).
pass(n, c) :- kind(n, "boolean_operator"), field(n, "right", c).
pass(n, c) :- kind(n, "assignment"), field(n, "right", c).
pass(n, c) :- kind(n, "named_expression"), field(n, "value", c).
pv(n, k, v) :- pass(n, c), pv(c, k, v).
// Calls: a class makes an instance; a function returns what its returns hold, or the argument it returns.
pv(c, "inst", k) :- callee(c, e), pv(e, "cls", k).
// cfn(c, e, f): call c of e runs f, a function, or an overload its positional arguments fit (`iter(x)` is not typed
// by `iter(f, sentinel)`). A call with a splat, a generator argument or more than eight positional arguments fits every
// overload, and one with keywords every overload with room for its positional arguments. A method's `self` is bound
// by an attribute call.
.decl cfn(c: node, e: node, f: node)
cfn(c, e, f) :- callee(c, e), pv(e, "fn", f), !ovlfn(f).
cfn(c, e, f) :- callee(c, e), pv(e, "fn", f), ovlfn(f), cwild(c).
cfn(c, e, f) :- callee(c, e), pv(e, "fn", f), ovlfn(f), !method(f, _), cposk(c, n, w), ffit(f, n, w).
cfn(c, e, f) :- callee(c, e), pv(e, "fn", f), ovlfn(f), method(f, _), !attr_of(e, _, _), cposk(c, n, w), ffit(f, n, w).
cfn(c, e, f) :- callee(c, e), pv(e, "fn", f), ovlfn(f), method(f, _), attr_of(e, _, _), cposk(c, m, w), pred(n, m), ffit(f, n, w).
.decl ovlfn(f: node)
ovlfn(f) :- ovlstmt(st), field(st, "definition", f).
.decl cwild(c: node)
cwild(c) :- posarg(c, 8, _).
cwild(c) :- kind(c, "call"), field(c, "arguments", as), child(as, a, _), kind(a, "list_splat").
cwild(c) :- kind(c, "call"), field(c, "arguments", as), child(as, a, _), kind(a, "dictionary_splat").
cwild(c) :- kind(c, "call"), field(c, "arguments", g), kind(g, "generator_expression").
.decl ckw(c: node)
ckw(c) :- kind(c, "call"), field(c, "arguments", as), child(as, a, _), kind(a, "keyword_argument").
// cpos(c, n): c has n positional arguments.
.decl cpos(c: node, n: number)
cpos(c, 0) :- kind(c, "call"), field(c, "arguments", as), kind(as, "argument_list"), !posarg(c, _, _), !cwild(c).
cpos(c, n) :- posarg(c, j, _), !posarg(c, n, _), pred(n, j), !cwild(c).
// cposk(c, n, w): c has n positional arguments, and keywords (w = 1) or none (w = 0).
.decl cposk(c: node, n: number, w: number)
cposk(c, n, 1) :- cpos(c, n), ckw(c).
cposk(c, n, 0) :- cpos(c, n), !ckw(c).
// ffit(f, n, w): n positional arguments, with keywords (w = 1) or without, fit overload f: at least its required ones
// and none of its keyword-only ones
// required (unless keywords may give them), at most its positional ones (unless it takes `*args`). Per overload, not
// per call: a call's fit is a lookup.
.decl ffit(f: node, n: number, w: number)
ffit(f, n, 0) :- ovlfn(f), slot(n), fneed(f, r), r <= n, fcap(f, p), n <= p, !fkwreq(f).
ffit(f, n, 1) :- ovlfn(f), slot(n), fcap(f, p), n <= p.
.decl slot(n: number)
slot(0). slot(1). slot(2). slot(3). slot(4). slot(5). slot(6). slot(7). slot(8). slot(9).
// An overload's parameters by position (`self` counted, `/` not), before any `*`, `*args` or `**kw`.
.decl pstar(f: node, k: number)
pstar(f, k) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "keyword_separator").
pstar(f, k) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "list_splat_pattern").
pstar(f, k) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "dictionary_splat_pattern").
pstar(f, k) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "typed_parameter"), child(p, s, 0), kind(s, "list_splat_pattern").
pstar(f, k) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "typed_parameter"), child(p, s, 0), kind(s, "dictionary_splat_pattern").
.decl pstar_before(f: node, k: number)
pstar_before(f, k) :- pstar(f, s), ovlfn(f), field(f, "parameters", ps), child(ps, _, k), s <= k.
.decl psep_before(f: node, k: number)
psep_before(f, k) :- ovlfn(f), field(f, "parameters", ps), child(ps, q, s), kind(q, "positional_separator"), child(ps, _, k), s < k.
.decl ppos(f: node, i: number, p: node)
ppos(f, k, p) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), !kind(p, "positional_separator"), !pstar_before(f, k),
    !psep_before(f, k).
ppos(f, i, p) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), !kind(p, "positional_separator"), !pstar_before(f, k),
    psep_before(f, k), pred(k, i).
.decl preq(f: node, i: number)
preq(f, i) :- ppos(f, i, p), kind(p, "identifier").
preq(f, i) :- ppos(f, i, p), kind(p, "typed_parameter").
.decl fneed(f: node, n: number)
fneed(f, 0) :- ovlfn(f), !preq(f, _).
fneed(f, n) :- preq(f, i), pred(n, i), !preq(f, n).
.decl fkwreq(f: node)
fkwreq(f) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), pstar_before(f, k), !pstar(f, k), kind(p, "identifier").
fkwreq(f) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, k), pstar_before(f, k), !pstar(f, k), kind(p, "typed_parameter").
.decl fstar(f: node)
fstar(f) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, _), kind(p, "list_splat_pattern").
fstar(f) :- ovlfn(f), field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_parameter"), child(p, s, 0), kind(s, "list_splat_pattern").
.decl fcap(f: node, n: number)
fcap(f, 9) :- fstar(f).
fcap(f, 0) :- ovlfn(f), !fstar(f), !ppos(f, _, _).
fcap(f, n) :- ppos(f, i, _), pred(n, i), !ppos(f, n, _), !fstar(f).
pv(c, k, v) :- cfn(c, e, f), !isasync(f), !isgen(f), fret(f, k, v).
// fret(f, k, v): function f may return a k v.
.decl fret(f: node, k: symbol, v: node)
fret(f, k, v) :- retval(f, r), pv(r, k, v).
pv(c, k, v) :- cfn(c, e, f), !method(f, _), retparam(f, i, _), posarg(c, i, a), pv(a, k, v).
pv(c, "super", k) :- callee(c, e), builtin_ref(e, "super"), nearest(c, f, fdef), method(f, k).
// The standard library's `builtins`, where a run loads it (t21): a builtin name is that module's binding of the name
// (`super` keeps its own value above), and a literal is an instance of its builtins class. Not `object`: every class
// is one, so a value declared `object` is any instance at all, which is no knowledge (and every class's rows).
// Each with its qualified name made first (`bq`, `litq`), so the join with `qv` is on that name.
.decl bq(n: node, q: symbol)
bq(n, q) :- builtin_ref(n, x), x != "super", x != "object", q = @dot("builtins", x).
lv(n, k, v) :- bq(n, q), lres(q, d), lval(d, k, v).
// `object` as an attribute's receiver (`object.__getattribute__(v, "x")`, `object.__setattr__`) is the class itself, one
// definite value: its methods are the attribute.
lv(o, "cls", "builtins.object") :- attr_of(_, o, _), builtin_ref(o, "object"), struct__def("builtins.object", "class").
.decl lit_cls(kind: symbol, q: symbol)
lit_cls("integer", "builtins.int"). lit_cls("float", "builtins.float"). lit_cls("string", "builtins.str").
lit_cls("concatenated_string", "builtins.str"). lit_cls("true", "builtins.bool"). lit_cls("false", "builtins.bool").
lit_cls("list", "builtins.list"). lit_cls("list_comprehension", "builtins.list"). lit_cls("dictionary", "builtins.dict").
lit_cls("dictionary_comprehension", "builtins.dict"). lit_cls("set", "builtins.set"). lit_cls("set_comprehension", "builtins.set").
lit_cls("tuple", "builtins.tuple").
.decl litq(n: node, q: symbol)
litq(n, q) :- vpos(n), kind(n, k), lit_cls(k, q), !bytes_lit(n).
litq(n, "builtins.bytes") :- bytes_lit(n).
lv(n, "inst", c) :- litq(n, q), lres(q, c), struct__def(c, "class").

// ---- library values, by symbol (P2's exports) --------------------------------------------------------------------
// wsmod(q): a module of this phase's documents, the workspace's. A symbol whose module is another is a library's.
.decl wsmod(q: symbol)
wsmod(q) :- modname(_, q).
.decl wsown(d: symbol)
wsown(d) :- types__owner(d, m), wsmod(m).
// lres(q, d): the qualified name q (an import, a dotted name read from one, a builtin) is symbol d: a module, else a
// module's name (through its imports and re-exports, `types__binds`), else a class's (through its bases).
.decl lwant(q: symbol)
lwant(q) :- qn(_, q).
lwant(q) :- bq(_, q).
lwant(q) :- litq(_, q).
lwant(q) :- star_from(_, q).
lwant(p) :- lwant(q), split_dot(q, p, _).
.decl lres(q: symbol, d: symbol)
lres(q, q) :- lwant(q), struct__def(q, "module").
lres(q, d) :- lwant(q), !struct__def(q, "module"), split_dot(q, p, y), !contains(".", y), lres(p, m), struct__def(m, "module"), types__binds(m, y, d).
lres(q, d) :- lwant(q), !struct__def(q, "module"), split_dot(q, p, y), !contains(".", y), lres(p, c), struct__def(c, "class"), types__attr(c, y, d, _), d != "".
// lval(d, k, v): library symbol d's value: a module, a class or a function (itself), or a name declared a class's
// instance (`x: C`), or None.
.decl lval(d: symbol, k: symbol, v: symbol)
lval(d, "mod", d) :- struct__def(d, "module"), !wsown(d).
lval(d, "cls", d) :- struct__def(d, "class"), !wsown(d).
lval(d, "fn", d) :- struct__def(d, "function"), !wsown(d).
lval(d, "inst", c) :- types__vtype(d, _, c), struct__def(c, "class"), !struct__def(d, _), !wsown(d).
lval(d, "none", "builtins.None") :- types__vtype(d, _, "builtins.None"), !struct__def(d, _), !wsown(d).
// lret(f, k, v): a call of library function f holds an instance of its declared return's class (each of a union's), or
// None.
.decl lret(f: symbol, k: symbol, v: symbol)
// Not an `async def`'s: its call holds a coroutine (open, as a workspace one's).
lret(f, "inst", t) :- types__rtype(f, _, t), struct__def(t, "class"), !struct__flag(f, "async").
lret(f, "none", "builtins.None") :- types__rtype(f, _, "builtins.None"), !struct__flag(f, "async").
// lopenret(f): some alternative of f's declared return is no class nor None (`Any`, a type variable, a name no
// symbol gives; types.rr's "" row): a call of f may hold what no symbol names. lopenv(s): so is s's declared type.
.decl lopenret(f: symbol)
lopenret(f) :- types__ropen(f), !lself(f).
.decl lopenv(s: symbol)
lopenv(s) :- types__vtype(s, _, ""), !struct__def(s, _).
.decl lself(f: symbol)
lself(f) :- types__rtype(f, _, "typing.Self").
lself(f) :- types__rtype(f, _, "typing_extensions.Self").
// A decorator declared to return its argument's own type, `(f: F) -> F` with F no class (a type variable).
.decl lident(g: symbol)
lident(g) :- types__sig(g, 0, _, a, d), d != "", !struct__def(d, _), types__rtype(g, a, _), match("^[A-Za-z_][A-Za-z_0-9]*$", a).
// A decorator declared `(f: Callable[P, A]) -> Callable[P, B]`: its result calls f and holds a B (`types__callret`).
.decl lwrap(g: symbol, b: symbol)
lwrap(g, b) :- types__sig(g, 0, _, a, _), match("^([A-Za-z_.]*\\.)?Callable\\[(?<p>[A-Za-z_0-9]+), .*$", a), types__callret(g, _, b),
    types__rtype(g, r, _), match("^([A-Za-z_.]*\\.)?Callable\\[(?<q>[A-Za-z_0-9]+), .*$", r), p = q.

// What a scope's names hold of a library's: an import, an assignment, a star import, a workspace module's re-export.
.decl lbv(s: node, x: symbol, k: symbol, v: symbol)
.decl lqv(m: node, q: symbol, k: symbol, v: symbol)
lbv(s, x, k, v) :- ibind(s, x, q), lres(q, d), lval(d, k, v).
lbv(s, x, k, v) :- ibind(s, x, q), lqv(m9, q, k, v), docof(s, d9), docof(m9, e9), rr_cx_reach(d9, e9).
lbv(s, x, k, v) :- live_asg(s, x, r), lv(r, k, v).
lbv(m, x, k, v) :- starx(m, x, m2), lbv(m2, x, k, v).
lbv(m, x, k, v) :- star_from(m, n), lres(n, n2), !wsmod(n2), types__binds(n2, x, d), x != "*", !prefix("_", x), !rbound(m, x), lval(d, k, v).
lqv(m, @dot(q, x), k, v) :- modname(m, q), lbv(m, x, k, v).
// Annotations naming a library's class (`p: Path`, `-> ContextVar[bool]`, `x: Pattern[str]` in a class body): its
// instances; `type[C]`: its class.
.decl linst(t: node, c: symbol)
linst(t, c) :- aleaf(t, m), ahead(m, h), lv(h, "cls", c), !builtin_ref(h, "type").
.decl lcls(t: node, c: symbol)
lcls(t, c) :- aleaf(t, m), ahead(m, h), builtin_ref(h, "type"), aarg(m, a), lv(a, "cls", c).
lbv(f, x, "inst", c) :- pann(f, x, t), pread(f, x), linst(t, c).
lbv(f, x, "cls", c) :- pann(f, x, t), pread(f, x), lcls(t, c).
lbv(c, x, "inst", k) :- cann(c, x, t), cread(c, x), linst(t, k).
lbv(c, x, "cls", k) :- cann(c, x, t), cread(c, x), lcls(t, k).
lv(c, "inst", k) :- cfn(c, _, f), rann(f, t), !isasync(f), linst(t, k).
lv(c, "cls", k) :- cfn(c, _, f), rann(f, t), !isasync(f), lcls(t, k).
lv(c, "inst", k) :- ifn(c, f), rann(f, t), !isasync(f), linst(t, k).
// A library protocol's instances need not derive from it.
.decl lproto(c: symbol)
lproto(c) :- struct__base(c, _, b), match("^([A-Za-z_.]*\\.)?Protocol(\\[.*)?$", b).
// A library decorator: the definition kept (`(f: F) -> F`), or what the decorator returns.
bv(s, x, k, f) :- live_def(s, x, f), dec1(f, e), lv(e, "fn", g), lident(g), defk(f, k).
bv(s, x, "wfn", f) :- live_def(s, x, f), dec1(f, e), lv(e, "fn", g), lwrap(g, _), !lident(g).
lbv(s, x, k, v) :- live_def(s, x, f), dec1(f, e), lv(e, "fn", g), !lident(g), !lwrap(g, _), lret(g, k, v).
.decl ldec_known(f: node)
ldec_known(f) :- dec1(f, e), lv(e, "fn", g), lident(g).
ldec_known(f) :- dec1(f, e), lv(e, "fn", g), lwrap(g, _).
ldec_known(f) :- dec1(f, e), lv(e, "fn", g), lret(g, _, _).

.decl lv(n: node, k: symbol, v: symbol)
lv(n, k, v) :- look(n, x, s), lbv(s, x, k, v).
lv(n, k, v) :- qn(n, q), lres(q, d), lval(d, k, v).
lv(n, k, v) :- pass(n, c), lv(c, k, v).
lv(n, k, v) :- attr_of(n, o, a), lv(o, "mod", m), types__binds(m, a, d), lval(d, k, v).
lv(n, "mod", q) :- attr_of(n, o, a), lv(o, "mod", m), q = @dot(m, a), struct__def(q, "module").
// A workspace class's attribute that holds a library's value (`pattern = re.compile(...)`, `x: Path`).
lv(n, k, v) :- alook(n, c, a), found(c, a, at), lbv(at, a, k, v).
// An attribute of a library class or instance: the class's own or a base's (`types__attr`); an attribute assigned in
// a class body is what it is declared (`x: int`).
.decl llook(n: node, c: symbol, a: symbol)
llook(n, c, a) :- attr_of(n, o, a), lv(o, "inst", c).
llook(n, c, a) :- attr_of(n, o, a), lv(o, "cls", c).
.decl lattr(n: node, k: symbol, v: symbol)
lattr(n, k, v) :- llook(n, c, a), types__attr(c, a, d, _), d != "", lval(d, k, v).
lattr(n, "inst", t) :- llook(n, c, a), types__attr(c, a, "", kc), s = @dot(kc, a), ldecl(s, t).
// ldecl(s, t): library symbol s is declared an instance of class t.
.decl ldecl(s: symbol, t: symbol)
ldecl(s, t) :- types__vtype(s, _, t), struct__def(t, "class").
lv(n, k, v) :- lattr(n, k, v).
// A workspace class's library bases, and the names it reaches through them (as `found`, union over the bases).
.decl lbase(c: node, b: symbol)
lbase(c, b) :- basex(c, e), lv(e, "cls", b).
lbase(c, b) :- basex(c, e), kind(e, "subscript"), field(e, "value", g), lv(g, "cls", b).
.decl lfound(c: node, a: symbol, b: symbol)
lfound(c, a, b) :- lbase(c, b), !bound_in(c, a), types__attr(b, a, _, _).
lfound(c, a, b) :- base(c, w), !bound_in(c, a), lfound(w, a, b).
.decl lwlook(n: node, b: symbol, a: symbol)
lwlook(n, b, a) :- alook(n, c, a), lfound(c, a, b).
lwlook(n, b, a) :- attr_of(n, o, a), pv(o, "super", c), lbase(c, b).
lwlook(n, b, a) :- attr_of(n, o, a), pv(o, "super", c), base(c, w), lfound(w, a, b).
lv(n, k, v) :- lwlook(n, b, a), types__attr(b, a, d, _), d != "", lval(d, k, v).
// Calls: a library class makes its instance, a library function holds what it is declared to return, an instance
// what its `__call__` does; a method declared `-> Self` its receiver.
lv(c, "inst", k) :- callee(c, e), lv(e, "cls", k).
lv(c, k, v) :- lcfn(c, e, f), lret(f, k, v).
// lcfn(c, e, f): call c of e runs library function f, or an overload of it its positional arguments fit (as `cfn`,
// by the overload's `struct__shape`): `os.environ.get(k)` is not typed by `get(k, default: T)`. A method's `self` is
// bound by an attribute call.
.decl lcfn(c: node, e: node, f: symbol)
lcfn(c, e, f) :- callee(c, e), lv(e, "fn", f), !struct__flag(f, "overload").
lcfn(c, e, f) :- callee(c, e), lv(e, "fn", f), struct__flag(f, "overload"), cwild(c).
lcfn(c, e, f) :- callee(c, e), lv(e, "fn", f), struct__flag(f, "overload"), !lmethod(f), cposk(c, n, w), lfit(f, n, w), !lnone(c, f, 0),
    !lkwbad(c, f), !ltybad(c, f, 0).
lcfn(c, e, f) :- callee(c, e), lv(e, "fn", f), struct__flag(f, "overload"), lmethod(f), !attr_of(e, _, _), cposk(c, n, w), lfit(f, n, w), !lnone(c, f, 0),
    !lkwbad(c, f), !ltybad(c, f, 0).
lcfn(c, e, f) :- callee(c, e), lv(e, "fn", f), struct__flag(f, "overload"), lmethod(f), attr_of(e, _, _), cposk(c, m, w), pred(n, m), lfit(f, n, w), !lnone(c, f, 1),
    !lkwbad(c, f), !ltybad(c, f, 1).
// lkwbad(c, f): call c names a keyword that overload f has no parameter of, and f takes no `**kwargs`
// (`os.environ.get(k, default=d)` is not `get(self, key, /)`). By the call's name, as `lnone`.
.decl lkwbad(c: node, f: symbol)
lkwbad(c, f) :- lovname(x, f), cnamed(c, x), ckwname(c, k), !lpname(f, k), !struct__flag(f, "kwargs").
.decl ckwname(c: node, k: symbol)
ckwname(c, k) :- kind(c, "call"), field(c, "arguments", as), child(as, a, _), kind(a, "keyword_argument"), field(a, "name", n), text(n, k).
.decl lpname(f: symbol, k: symbol)
lpname(f, k) :- struct__flag(f, "overload"), struct__param(f, _, k, _).
// lovname(x, f): overload f's name (`os._Environ.get#1`: `get`).
.decl lovname(x: symbol, f: symbol)
lovname(x, f) :- struct__flag(f, "overload"), x = @replace_all(f, "^.*\\.|#[0-9]+$", "").
// ltybad(c, f, s): call c's positional argument, a literal of class k, is no instance of what overload f's parameter
// (s on: a method's `self`) declares: every alternative of the parameter names a class, none a protocol, and k is
// none of them nor derives from one (`int` passes for `float` and `complex`, as PEP 484 has it). Only literals: an
// argument's value read from this phase's values would make the fit depend on itself through a negation.
.decl ltybad(c: node, f: symbol, s: number)
ltybad(c, f, 0) :- lovname(x, f), cnamed(c, x), posarg(c, p, a), litcls(a, k), lsigclosed(f, p), !lsigok(f, p, k).
ltybad(c, f, 1) :- lovname(x, f), cnamed(c, x), pred(p, q), posarg(c, q, a), litcls(a, k), lsigclosed(f, p), !lsigok(f, p, k).
.decl litcls(a: node, k: symbol)
litcls(a, "builtins.str") :- kind(a, "string"), !litbytes(a).
litcls(a, "builtins.bytes") :- litbytes(a).
.decl litbytes(a: node)
litbytes(a) :- kind(a, "string"), text(a, t), match("^[bB].*", t).
litcls(a, "builtins.int") :- kind(a, "integer").
litcls(a, "builtins.float") :- kind(a, "float").
litcls(a, "builtins.bool") :- kind(a, "true").
litcls(a, "builtins.bool") :- kind(a, "false").
litcls(a, "builtins.list") :- kind(a, "list").
litcls(a, "builtins.dict") :- kind(a, "dictionary").
litcls(a, "builtins.set") :- kind(a, "set").
litcls(a, "builtins.tuple") :- kind(a, "tuple").
.decl litk(k: symbol)
litk("builtins.str"). litk("builtins.bytes"). litk("builtins.int"). litk("builtins.float"). litk("builtins.bool").
litk("builtins.list"). litk("builtins.dict"). litk("builtins.set"). litk("builtins.tuple").
.decl lsigclosed(f: symbol, p: number)
lsigclosed(f, p) :- lovname(_, f), types__sig(f, p, _, a, d), a != "", d != "", !types__sig(f, p, _, a, ""), !lsigproto(f, p).
.decl lsigproto(f: symbol, p: number)
lsigproto(f, p) :- lovname(_, f), types__sig(f, p, _, _, d), types__proto(d).
.decl lsigok(f: symbol, p: number, k: symbol)
lsigok(f, p, k) :- lovname(_, f), types__sig(f, p, _, _, k), litk(k).
lsigok(f, p, k) :- lovname(_, f), types__sig(f, p, _, _, d), litk(k), types__anc(k, d).
lsigok(f, p, "builtins.int") :- lovname(_, f), types__sig(f, p, _, _, "builtins.float").
lsigok(f, p, "builtins.int") :- lovname(_, f), types__sig(f, p, _, _, "builtins.complex").
lsigok(f, p, "builtins.float") :- lovname(_, f), types__sig(f, p, _, _, "builtins.complex").
// lnone(c, f, s): overload f declares a parameter None that call c gives a literal of another type (`setdefault(k, [])`
// is not `setdefault(key, default: None = None)`), its arguments shifted by s (a method's `self`). By the overload's
// name and the argument's position first: every overload with a None parameter against every literal argument is a
// cross product otherwise.
.decl lnone(c: node, f: symbol, s: number)
lnone(c, f, 0) :- lnonep(x, p, f), cnamed(c, x), posarg(c, p, a), lnotnone(a).
lnone(c, f, 1) :- lnonep(x, p, f), cnamed(c, x), pred(p, q), posarg(c, q, a), lnotnone(a).
.decl lnonep(x: symbol, p: number, f: symbol)
lnonep(x, p, f) :- types__sig(f, p, _, "None", _), lovname(x, f).
.decl cnamed(c: node, x: symbol)
cnamed(c, x) :- kind(c, "call"), field(c, "function", e), kind(e, "identifier"), text(e, x).
cnamed(c, x) :- kind(c, "call"), field(c, "function", e), kind(e, "attribute"), field(e, "attribute", n), text(n, x).
.decl lnotnone(a: node)
lnotnone(a) :- kind(a, k), lit_kind(k).
.decl lit_kind(k: symbol)
lit_kind("list"). lit_kind("dictionary"). lit_kind("set"). lit_kind("tuple"). lit_kind("string"). lit_kind("concatenated_string").
lit_kind("integer"). lit_kind("float"). lit_kind("true"). lit_kind("false"). lit_kind("list_comprehension").
lit_kind("dictionary_comprehension"). lit_kind("set_comprehension"). lit_kind("lambda").
// lfit(f, n, w): n positional arguments, with keywords (w = 1) or without, fit overload f.
.decl lfit(f: symbol, n: number, w: number)
lfit(f, n, 0) :- struct__shape(f, r, p, 0), slot(n), r <= n, n <= p.
lfit(f, n, 1) :- struct__shape(f, _, p, _), slot(n), n <= p.
// lmethod(f): overloaded library function f is defined in a class. Asked only of overloads, so it starts from them:
// over every library function (splitting each symbol, in every chunk) it was the cold run's costliest stratum.
.decl lmethod(f: symbol)
lmethod(f) :- struct__flag(f, "overload"), struct__member(_, _, f).
.decl struct__member(c: symbol, x: symbol, t: symbol)
// A call that no overload fits is open: its overloads say nothing of it.
.decl lunfit(c: node)
lunfit(c) :- callee(c, e), lv(e, "fn", f), struct__flag(f, "overload"), !lcfn(c, e, _).
.decl lcallf(c: node, f: symbol)
lcallf(c, f) :- callee(c, e), lv(e, "inst", t), types__attr(t, "__call__", f, _), f != "".
lv(c, k, v) :- lcallf(c, f), lret(f, k, v).
lv(c, "inst", t) :- lcfn(c, e, f), lself(f), attr_of(e, o, _), lv(o, "inst", t).
pv(c, "inst", w) :- lcfn(c, e, f), lself(f), attr_of(e, o, _), pv(o, "inst", w).
// A call of a library-wrapped workspace function holds the wrapper's declared B.
lv(c, "inst", b) :- callee(c, e), pv(e, "wfn", f), dec1(f, d), lv(d, "fn", g), lwrap(g, b), struct__def(b, "class").
// B is a generic whose argument j is A's type variable (`types__wgen`): f's declared return gives it, through its
// class's map to A's (`@contextmanager def opened() -> Iterator[V]` is a `_GeneratorContextManager[V]`).
// lwbind(f, g, j, x): f, wrapped by g, gives B's argument j the annotation x.
.decl lwbind(f: node, g: symbol, kb: symbol, j: number, x: node)
lwbind(f, g, kb, j, x) :- dec1(f, d), lv(d, "fn", g), types__wgen(g, ka, i, kb, j), rann(f, t), ann(t, rf), gann_head(rf, hf), lv(hf, "cls", kf),
    types__tparam(ka, i, w), types__tmap(kf, i2, ka, w), sarg(rf, i2, x).
.decl lwgen(c: node, f: node, g: symbol)
lwgen(c, f, g) :- callee(c, e), pv(e, "wfn", f), lwbind(f, g, _, _, _).
lghcls(c, kb) :- lwgen(c, f, g), lwbind(f, g, kb, _, _).
pv(c, "gen", c) :- lwgen(c, _, _).
garg(c, j, x) :- lwgen(c, f, g), lwbind(f, g, _, j, x).
// Implicit calls (`o[i]`, a loop, a `with`) on a library instance.
// liawait(c, f): the library `async def` an awaited implicit call runs: c holds what f declares (a stub's
// `async def __aenter__(self) -> Self`). A plain def that returns an awaitable (`AsyncIterator.__anext__`) is open.
.decl liawait(c: node, f: symbol)
liawait(c, f) :- iawait(c, o, a), lv(o, "inst", t), types__attr(t, a, f, _), f != "", struct__flag(f, "async").
.decl laret(f: symbol)
laret(f) :- types__rtype(f, _, t), struct__def(t, "class").
lv(c, "inst", t) :- liawait(c, f), types__rtype(f, _, t), struct__def(t, "class").
lv(c, "inst", t) :- liawait(c, f), lself(f), iawait(c, o, _), lv(o, "inst", t).
.decl lical(c: node, f: symbol)
lical(c, f) :- icall(c, o, a), lv(o, "inst", t), types__attr(t, a, f, _), f != "".
lv(c, k, v) :- lical(c, f), lret(f, k, v).
lv(c, "inst", t) :- lical(c, f), lself(f), icall(c, o, _), lv(o, "inst", t).
// Library generics: a workspace annotation naming a library generic class (`d: dict[str, C]`, `xs: list[C]`) is a
// generic value, as a workspace class's is (`gleaf`); a library method declared to return its class's type variable
// (`get(...) -> _VT | None`), called on one, holds what the value's argument binds it to, through the class's bases
// (`types__tmap`); one declared to return a generic of it (`__iter__() -> Iterator[_T]`) holds that generic, its
// argument bound (so a loop's `__next__` binds Iterator's `_T_co` to the list's argument).
.decl lgleaf(t: node, m: node)
lgleaf(t, m) :- uann(t), aleaf(t, m), ahead(m, h), m != h, lv(h, "cls", k), types__tparam(k, _, _).
bv(f, x, "gen", m) :- pann(f, x, t), pread(f, x), lgleaf(t, m).
bv(c, x, "gen", m) :- cann(c, x, t), cread(c, x), lgleaf(t, m).
// A workspace module's or function's annotated name (`_ctx: ContextVar[B | None] = ContextVar(...)`,
// `grouped: dict[str, list[V]] = {}`): its declared library generic, beside the value assigned.
.decl wmann(m: node, x: symbol, t: node)
wmann(m, x, t) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "type", t), nearest(a, m, scope),
    kind(m, "module"), !py_dead_at(a).
wmann(m, x, t) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "type", t), nearest(a, m, scope),
    kind(m, "function_definition"), !py_dead_at(a).
uann(t) :- wmann(_, _, t).
bv(m0, x, "gen", m) :- wmann(m0, x, t), lgleaf(t, m).
// lghcls(v, k): generic value v (an annotation, or a call standing for the generic it returns) is of library class k.
.decl lghcls(v: node, k: symbol)
lghcls(m, k) :- lgleaf(_, m), ahead(m, h), lv(h, "cls", k).
lghcls(x, k) :- sarg(_, _, x), ghead(x, h), x != h, lv(h, "cls", k), types__tparam(k, _, _).
lghcls(c, k) :- gfn(c, f), rgen(f, r), ahead(r, h), lv(h, "cls", k).
garg(m, i, x) :- lghcls(m, _), sarg(m, i, x).
pv(c, "gen", c) :- gfn(c, f), rgen(f, _), lghcls(c, _).
.decl lgret(f: symbol)
lgret(f) :- types__rvar(f, _).
lgret(f) :- types__rgen(f, _, _, _).
// lgcall(c, o, f): call c (a call, an implicit call) on o runs library method f, declared to return a type variable
// or a generic of one; lclassof(f, a): f is class a's.
.decl lgcall(c: node, o: node, f: symbol)
lgcall(c, o, f) :- lcfn(c, e, f), lgret(f), attr_of(e, o, _).
lgcall(c, o, f) :- lical(c, f), lgret(f), icall(c, o, _).
.decl lclassof(f: symbol, a: symbol)
lclassof(f, a) :- lgret(f), struct__member(a, _, f).
// lgpar(c, y, x): at call c, the receiver's generic value binds type variable y (a parameter of the method's class)
// to annotation x.
.decl lgpar(c: node, y: symbol, x: node)
lgpar(c, y, x) :- lgcall(c, o, f), lclassof(f, a), pv(o, "gen", g), lghcls(g, k), types__tmap(k, i, a, y), garg(g, i, x).
.decl lgbound(c: node, y: symbol)
lgbound(c, y) :- lgpar(c, y, _).
.decl lgx(c: node, x: node)
lgx(c, x) :- lgcall(c, _, f), types__rvar(f, y), lgpar(c, y, x).
gbind(c, x) :- lgx(c, x).
// A union argument (`ContextVar[B | None]`): each member, the workspace's classes with their subclasses (as `gcls`).
.decl umem(e: node, m: node)
umem(e, m) :- kind(e, "binary_operator"), op(e, "|"), field(e, "left", m).
umem(e, m) :- kind(e, "binary_operator"), op(e, "|"), field(e, "right", m).
umem(e, m) :- kind(e, "parenthesized_expression"), child(e, m, 0).
.decl lgxu(c: node, m: node)
lgxu(c, m) :- lgx(c, e), umem(e, m).
lgxu(c, m) :- lgxu(c, e), umem(e, m).
pv(c, "inst", s) :- lgxu(c, m), pv(m, "cls", k), anc(s, k), docof(c, d9), docof(s, e9), rr_cx_reach(d9, e9).
lv(c, "inst", k) :- lgxu(c, m), lv(m, "cls", k).
lv(c, "inst", k) :- lgx(c, x), ghead(x, h), lv(h, "cls", k).
pv(c, "gen", x) :- lgx(c, x), lghcls(x, _).
lghcls(c, k) :- lgcall(c, _, f), types__rgen(f, k, _, y), lgpar(c, y, _).
garg(c, j, x) :- lgcall(c, _, f), types__rgen(f, _, j, y), lgpar(c, y, x).
pv(c, "gen", c) :- lgcall(c, _, f), types__rgen(f, _, _, y), lgpar(c, y, _).
// A generic value's argument may be a library class, held as its symbol (`lgarg(g, i, d)`): a library function
// declared to return a generic of classes (`dir() -> list[str]`), or a library class built from such a value.
.decl lgarg(g: node, i: number, d: symbol)
lghcls(c, k) :- lcfn(c, _, f), types__rcarg(f, k, _, _).
lgarg(c, j, d) :- lcfn(c, _, f), types__rcarg(f, _, j, d).
pv(c, "gen", c) :- lcfn(c, _, f), types__rcarg(f, _, _, _).
// A library class's call binds its type parameters from its constructor's arguments: `frozenset(xs)`, where
// `__new__(cls, iterable: Iterable[_T_co])` and xs is a `list[str]`, is a `frozenset[str]` (list's parameter 0 is
// Iterable's `_T_co`, `types__tmap`). lccall(c, k, f): call c of library class k runs constructor f (`__new__` or
// `__init__` as k finds it), an overload its positional arguments fit (the class counted as the first).
.decl lctor(k: symbol, f: symbol)
lctor(k, f) :- types__attr(k, "__new__", f, _), types__pgen(f, _, _, _, _).
lctor(k, f) :- types__attr(k, "__init__", f, _), types__pgen(f, _, _, _, _).
.decl lccall(c: node, k: symbol, f: symbol)
lccall(c, k, f) :- callee(c, e), lv(e, "cls", k), lctor(k, f), !struct__flag(f, "overload").
lccall(c, k, f) :- callee(c, e), lv(e, "cls", k), lctor(k, f), struct__flag(f, "overload"), cposk(c, m, w), pred(n, m), lfit(f, n, w).
// lcbind(c, n, g, i): at c, k's parameter n is argument i of g, the generic value passed where the constructor
// declares a generic of that parameter.
.decl lcbind(c: node, n: number, g: node, i: number)
lcbind(c, n, g, i) :- lccall(c, k, f), types__pgen(f, p, h, j, y), types__tparam(k, n, y), pred(p, q), posarg(c, q, a), pv(a, "gen", g),
    lghcls(g, k2), types__tparam(h, j, z), types__tmap(k2, i, h, z).
lghcls(c, k) :- lcbind(c, _, _, _), lccall(c, k, _).
pv(c, "gen", c) :- lcbind(c, _, _, _).
garg(c, n, x) :- lcbind(c, n, g, i), garg(g, i, x).
lgarg(c, n, d) :- lcbind(c, n, g, i), lgarg(g, i, d).
// lgpars(c, y, d): as `lgpar`, the receiver's generic value binds y to the library class d.
.decl lgpars(c: node, y: symbol, d: symbol)
lgpars(c, y, d) :- lgcall(c, o, f), lclassof(f, a), pv(o, "gen", g), lghcls(g, k), types__tmap(k, i, a, y), lgarg(g, i, d).
lgbound(c, y) :- lgpars(c, y, _).
lv(c, "inst", d) :- lgcall(c, _, f), types__rvar(f, y), lgpars(c, y, d).
lghcls(c, k) :- lgcall(c, _, f), types__rgen(f, k, _, y), lgpars(c, y, _).
lgarg(c, j, d) :- lgcall(c, _, f), types__rgen(f, _, j, y), lgpars(c, y, d).
pv(c, "gen", c) :- lgcall(c, _, f), types__rgen(f, _, _, y), lgpars(c, y, _).
// For counting: a call that reaches a library's callable.
.decl call_lib(c: node)
call_lib(c) :- callee(c, e), lv(e, "fn", _).
call_lib(c) :- callee(c, e), lv(e, "cls", _).
call_lib(c) :- lcallf(c, _).
.output call_lib

// ---- unknown values -------------------------------------------------------------------------------------------
// Positions whose value is read: what `vopen` is asked about.
.decl vpos(n: node)
// vroot(e): where a value is read. A guest's (a quoted annotation's code) are not: only its names are read.
.decl vroot(e: node)
vroot(e) :- callee(_, e).
vroot(o) :- attr_of(_, o, _).
vroot(r) :- asg(_, _, r, _).
vroot(r) :- retval(_, r).
vroot(e) :- dexpr(_, e).
vroot(e) :- basex(_, e).
vroot(a) :- posarg(_, _, a).
vroot(v) :- pdefault(_, _, v).
vpos(e) :- vroot(e), !host_node(e, _).
vpos(c) :- vpos(n), kind(n, "parenthesized_expression"), child(n, c, 0).
vpos(c) :- vpos(n), kind(n, "conditional_expression"), child(n, c, 0).
vpos(c) :- vpos(n), kind(n, "conditional_expression"), child(n, c, 2).
vpos(c) :- vpos(n), kind(n, "boolean_operator"), child(n, c, _).
vpos(c) :- vpos(n), kind(n, "assignment"), field(n, "right", c).
vpos(c) :- vpos(n), kind(n, "named_expression"), field(n, "value", c).
.decl tracked(k: symbol)
tracked("identifier"). tracked("attribute"). tracked("call"). tracked("parenthesized_expression"). tracked("conditional_expression").
tracked("boolean_operator"). tracked("assignment"). tracked("named_expression").
// Values that are no workspace callable and whose methods are no workspace definition: literals and operators on them.
tracked("integer"). tracked("float"). tracked("string"). tracked("concatenated_string"). tracked("true"). tracked("false").
tracked("none"). tracked("subscript"). tracked("for_statement"). tracked("as_pattern_target"). tracked("list"). tracked("dictionary"). tracked("set"). tracked("tuple"). tracked("list_comprehension").
tracked("await"). tracked("dictionary_comprehension"). tracked("set_comprehension"). tracked("comparison_operator"). tracked("not_operator").
.decl iattr(t: node, c: node, a: symbol)
iattr(t, c, a) :- field(_, "left", t), kind(t, "attribute"), attr_of(t, o, a), pv(o, "inst", c).
iattr(t, c, a) :- field(_, "left", t), kind(t, "attribute"), attr_of(t, o, a), pv(o, "cls", c).
// A base that is an external class (a qualified name the workspace does not define, or a builtin): what it holds is
// no workspace definition. Any other base that is not a workspace class is unknown.
.decl extb(e: node)
extb(e) :- basex(_, e), qn(e, q), !xknown(e, q).
.decl xknown(e: node, q: symbol)
xknown(e, q) :- basex(_, e), qn(e, q), qv(m9, q, _, _), docof(e, d9), docof(m9, e9), rr_cx_reach(d9, e9).
extb(e) :- basex(_, e), builtin_ref(e, _).
// A library class, or its generic as a subscript (`AbstractContextManager[None]`, `lgbase`): `lbase` answers for it.
extb(e) :- basex(_, e), lv(e, "cls", _).
extb(e) :- lgbase(e).
.decl lgbase(e: node)
lgbase(e) :- basex(_, e), kind(e, "subscript"), field(e, "value", g), lv(g, "cls", _).
// A typing special form as a base (`Generic[T]`, `Protocol`, `TypedDict`): no class to read, and none needed, as the
// members are the class's own. In typeshed these are values (`Generic: type[_Generic]`), so they are named here.
.decl special_base_q(q: symbol)
special_base_q("typing.Generic"). special_base_q("typing.Protocol"). special_base_q("typing.TypedDict").
special_base_q("typing_extensions.Generic"). special_base_q("typing_extensions.Protocol").
special_base_q("typing_extensions.TypedDict").
// A generic class as a base, `K[T]` (`os.PathLike[str]`, `Mapping[K, V]`): the class K. Not a special form: typeshed's
// `Generic: type[_Generic]` reads as `_Generic` or any subclass, and every `class X(Generic[T])` is one, so a special
// form read as a class makes each generic class a base of every other.
.decl gbase(e: node, k: node)
gbase(e, k) :- basex(_, e), kind(e, "subscript"), field(e, "value", g), pv(g, "cls", k), !special_base(e).
base(c, b) :- basex(c, e), gbase(e, b).
.decl special_base(e: node)
special_base(e) :- basex(_, e), qn(e, q), special_base_q(q).
special_base(e) :- basex(_, e), kind(e, "subscript"), field(e, "value", g), qn(g, q), special_base_q(q).
special_base(e) :- basex(_, e), ownq(e, q), special_base_q(q).
special_base(e) :- basex(_, e), kind(e, "subscript"), field(e, "value", g), ownq(g, q), special_base_q(q).
extb(e) :- special_base(e).
.decl base_open(c: node)
base_open(c) :- basex(c, e), vopen(e), !special_base(e), !gbase(e, _), !lgbase(e).
base_open(c) :- basex(c, e), !pv(e, "cls", _), !extb(e), !gbase(e, _).
.decl attr_open(n: node, c: node, a: symbol)
attr_open(n, c, a) :- asks(n, c, a), found(c, a, at), bopen(at, a).
attr_open(n, c, a) :- asks(n, c, a), anc(c, b), base_open(b).
attr_open(n, c, a) :- asks(n, c, a), anc(c, b), iattr(t9, b, a), docof(n, d9), docof(t9, e9), rr_cx_reach(d9, e9), !adeclared(c, a).
// Neither bound by a workspace class nor reachable through an external base: set dynamically, or an AttributeError.
attr_open(n, c, a) :- asks(n, c, a), !found(c, a, _), !ext_base_up(c), a != "__init__", a != "__call__".
// An attribute an external base supplies: calling it runs no workspace definition, but as a value (a receiver, an
// assigned value) it may be anything, a workspace class included (`cls.__class__`).
.decl ext_attr(n: node)
ext_attr(n) :- alook(n, c, a), !found(c, a, _), ext_base_up(c).
.decl ext_base_up(c: node)
ext_base_up(c) :- anc(c, b), basex(b, e), extb(e).
.decl bopen(s: node, x: symbol)
bopen(s, x) :- otgt(s, x).
bopen(f, x) :- param(f, x, i), !selfparam(f, i), !pclosed(f, x).
bopen(f, x) :- pdefault(f, x, v), vopen(v).
bopen(s, x) :- live_asg(s, x, r), vopen(r).
bopen(s, x) :- ifrom(s, x, m, _), docof(s, d9), rr_cx_sees(d9, m), ibind(s, x, q), qopen(m9, q), docof(m9, e9), rr_cx_reach(d9, e9).
bopen(s, x) :- ifrom(s, x, m, _), docof(s, d9), rr_cx_sees(d9, m), ibind(s, x, q), !bknown(s, q).
.decl bknown(s: node, q: symbol)
bknown(s, q) :- ibind(s, _, q), qv(m9, q, _, _), docof(s, d9), docof(m9, e9), rr_cx_reach(d9, e9).
// Or a library's value it holds (`_ctx = contextvars.ContextVar(...)`): `lqv`, as P3 keeps no library node.
bknown(s, q) :- ibind(s, _, q), lqv(m9, q, _, _), docof(s, d9), docof(m9, e9), rr_cx_reach(d9, e9).
bopen(s, x) :- live_def(s, x, f), opaque_dec(f, _), !dec1(f, _).
bopen(s, x) :- live_def(s, x, f), dec1(f, e), !pv(e, "fn", _), !ldec_known(f).
bopen(s, x) :- live_def(s, x, f), dec1(f, e), vopen(e).
bopen(s, x) :- live_def(s, x, f), decfn(f, g), !ident_dec(g), !wrap(g, _, _), retval(g, r), !retparam(g, 0, r), vopen(r).
bopen(s, x) :- live_def(s, x, f), decfn(f, g), !ident_dec(g), !wrap(g, _, _), !retval(g, _).
// A property's value is what its getter returns.
bopen(s, x) :- live_def(s, x, f), dexpr(f, e), builtin_ref(e, "property").
.decl selfparam(f: node, i: number)
selfparam(f, 0) :- method(f, _), !isstatic(f).
// A workspace module's qualified name that it binds to nothing static (a star import may bind it), or binds openly.
.decl qopen(m: node, q: symbol)
qopen(m, @dot(q, x)) :- modname(m, q), bopen(m, x).

.decl vopen(n: node)
vopen(n) :- vpos(n), kind(n, k), !tracked(k).
vopen(n) :- vpos(n), look(n, x, s), bopen(s, x).
vopen(n) :- vpos(n), miss(n, x), !builtin_ref(n, x).
vopen(n) :- vpos(n), qn(n, q), qopen(m9, q), docof(n, d9), docof(m9, e9), rr_cx_reach(d9, e9).
vopen(n) :- vpos(n), attr_of(n, o, _), qn(o, q), docof(n, d9), rr_cx_sees(d9, q), qn(n, q2), !vknown(n, q2).
.decl vknown(n: node, q: symbol)
vknown(n, q) :- vpos(n), attr_of(n, _, _), qn(n, q), qv(m9, q, _, _), docof(n, d9), docof(m9, e9), rr_cx_reach(d9, e9).
vopen(n) :- vpos(n), attr_of(n, o, _), vopen(o).
vopen(n) :- vpos(n), attr_of(n, o, _), kind(o, k), !tracked(k).
vopen(n) :- vpos(n), alook(n, c, a), attr_open(n, c, a).
vopen(n) :- vpos(n), attr_of(n, o, a), pv(o, "super", c), base_open(c).
vopen(n) :- vpos(n), attr_of(n, o, _), pv(o, "fn", _).
vopen(n) :- vpos(n), attr_of(n, o, _), pv(o, "wfn", _).
vopen(n) :- vpos(n), ext_attr(n), !callee(_, n).
vopen(n) :- vpos(n), pass(n, c), !kind(n, "boolean_operator"), vopen(c).
vopen(n) :- vpos(n), kind(n, "boolean_operator"), child(n, c, _), vopen(c).
// A call's value: unknown when the callee is, when no workspace definition is called (an external or builtin
// callable), when a workspace function's return is, and for coroutines and generators.
vopen(c) :- vpos(c), callee(c, e), vopen(e).
vopen(c) :- vpos(c), callee(c, e), !pv(e, _, _), !pv(c, "super", _), !bcall(c, _), !lv(e, _, _).
// A library call whose value is not declared (no return annotation, a type variable, a special form), or an
// instance's call with no `__call__`.
vopen(c) :- vpos(c), lcfn(c, _, f), !lret(f, _, _), !lself(f), !lgbound(c, _).
vopen(c) :- vpos(c), lcfn(c, _, f), lopenret(f).
vopen(c) :- vpos(c), lunfit(c).
// A library call declared to return a type variable nothing binds at it.
vopen(c) :- vpos(c), lcfn(c, _, f), types__rvar(f, y), !lgbound(c, y).
vopen(c) :- vpos(c), lical(c, f), types__rvar(f, y), !lgbound(c, y).
vopen(c) :- vpos(c), lcallf(c, f), types__rvar(f, y).
vopen(c) :- vpos(c), lcallf(c, f), lopenret(f).
vopen(c) :- vpos(c), lical(c, f), lopenret(f).
// A library name, attribute or declared value whose declared type is partly unknown.
vopen(n) :- vpos(n), qn(n, q), lres(q, d), !wsown(d), lopenv(d).
vopen(n) :- vpos(n), llook(n, c, a), types__attr(c, a, d, _), d != "", lopenv(d).
vopen(n) :- vpos(n), llook(n, c, a), types__attr(c, a, "", k), s = @dot(k, a), lopenv(s).
vopen(n) :- vpos(n), attr_of(n, o, a), lv(o, "mod", m), types__binds(m, a, d), lopenv(d).
vopen(c) :- vpos(c), callee(c, e), lv(e, "inst", t), !lcallf(c, _).
vopen(c) :- vpos(c), lcallf(c, f), !lret(f, _, _), !lself(f).
vopen(c) :- vpos(c), callee(c, e), lv(e, "mod", _).
vopen(c) :- vpos(c), callee(c, e), lv(e, "none", _).
// An attribute a library class does not have (set dynamically, or through a base no symbol names), and one of a
// library function.
vopen(n) :- vpos(n), llook(n, _, _), !lattr(n, _, _).
vopen(n) :- vpos(n), attr_of(n, o, _), lv(o, "mod", _), !lv(n, _, _).
vopen(n) :- vpos(n), attr_of(n, o, _), lv(o, "fn", _).
// A name an import binds to a library's value no symbol gives (an alias, `x = y` in a stub).
vopen(n) :- vpos(n), qn(n, q), lres(q, d), !wsown(d), !lv(n, _, _), !pv(n, _, _).
vopen(c) :- vpos(c), cfn(c, e, f), isasync(f).
// `await c`: what the async def c runs returns (as a sync call's value); any other awaited value is open.
vopen(w) :- vpos(w), kind(w, "await"), !awaitf(w, _, _).
vopen(w) :- vpos(w), awaitf(w, c, _), callee(c, e), vopen(e).
vopen(w) :- vpos(w), awaitf(w, _, f), !aclosed(f), retval(f, r), !retparam(f, _, r), vopen(r).
vopen(w) :- vpos(w), awaitf(w, _, f), !aclosed(f), retparam(f, _, _).
vopen(c) :- vpos(c), cfn(c, e, f), !rclosed(f), isgen(f).
vopen(c) :- vpos(c), cfn(c, e, f), !rclosed(f), retval(f, r), !retparam(f, _, r), vopen(r).
vopen(c) :- vpos(c), cfn(c, e, f), !rclosed(f), retparam(f, i, _), !posarg(c, i, _).
vopen(c) :- vpos(c), cfn(c, e, f), !rclosed(f), retparam(f, i, _), posarg(c, i, a), vopen(a).
vopen(c) :- vpos(c), cfn(c, e, f), !rclosed(f), method(f, _), retparam(f, _, _).
vopen(c) :- vpos(c), callee(c, e), pv(e, "inst", _).
vopen(c) :- vpos(c), callee(c, e), pv(e, "mod", _).
// An implicit call's value: unknown when its receiver is, when no workspace method is found, when the method's
// return is.
vopen(c) :- vpos(c), icall(c, o, _), vopen(o).
vopen(c) :- vpos(c), icall(c, _, _), !ifn(c, _), !lical(c, _).
vopen(c) :- vpos(c), iawait(c, o, _), vopen(o).
vopen(c) :- vpos(c), iawait(c, _, _), !iafn(c, _), !liawait(c, _).
vopen(c) :- vpos(c), iafn(c, f), !aclosed(f), retval(f, r), !retparam(f, _, r), vopen(r).
vopen(c) :- vpos(c), iafn(c, f), !aclosed(f), retparam(f, _, _).
vopen(c) :- vpos(c), liawait(c, f), !laret(f), !lself(f).
vopen(c) :- vpos(c), lical(c, f), !lret(f, _, _), !lself(f), !lgbound(c, _).
vopen(c) :- vpos(c), icall(c, o, a), pv(o, "inst", k), attr_open(c, k, a).
vopen(c) :- vpos(c), ifn(c, f), isasync(f).
vopen(c) :- vpos(c), ifn(c, f), !rclosed(f), isgen(f).
vopen(c) :- vpos(c), ifn(c, f), !rclosed(f), retval(f, r), !retparam(f, _, r), vopen(r).
vopen(c) :- vpos(c), ifn(c, f), !rclosed(f), method(f, _), retparam(f, _, _).

// ---- call targets ---------------------------------------------------------------------------------------------
.decl call_target(c: node, f: node)
call_target(c, f) :- callee(c, e), pv(e, "fn", f), !mro_dropped(e, f).
call_target(c, f) :- wcall(c, f, _).
call_target(c, f) :- callee(c, e), pv(e, "wfn", f), dec1(f, d), lv(d, "fn", g), lwrap(g, _).
// Method resolution order. `found` is the union over every base, depth first, so in a diamond (`class D(B, C)`,
// both from `A`) `D.who` finds `A.who` through `B` and `C.who` through `C`. C3 gives `C.who`. A definition found
// on a class that another candidate class subclasses is never the one called, so it is dropped here, at the
// call. Values (`pv`) still flow as the union: `pv` and `found` are one recursive component, where the negation
// cannot go. Candidates neither of which subclasses the other are left to C3's left-to-right merge, which this
// does not model: the call is unknown (`mro_ambiguous`), never both.
.decl mro_cand(n: node, c: node, at: node)
mro_cand(n, c, at) :- alook(n, c, a), found(c, a, at).
// Per receiver class c: a late-bound `self` may be several classes, each with its own resolution.
.decl mro_shadowed(n: node, c: node, at: node)
mro_shadowed(n, c, at) :- mro_cand(n, c, at), mro_cand(n, c, x), x != at, anc(x, at).
.decl mro_kept(n: node, f: node)
mro_kept(n, f) :- mro_cand(n, c, at), !mro_shadowed(n, c, at), attr_of(n, _, a), bv(at, a, "fn", f).
.decl mro_dropped(n: node, f: node)
mro_dropped(n, f) :- mro_cand(n, c, at), mro_shadowed(n, c, at), attr_of(n, _, a), bv(at, a, "fn", f), !mro_kept(n, f).
.decl mro_ambiguous(n: node)
mro_ambiguous(n) :- mro_cand(n, c, x), mro_cand(n, c, y), x != y, !mro_shadowed(n, c, x), !mro_shadowed(n, c, y).
call_target(c, f) :- callee(c, e), pv(e, "cls", k), found(k, "__init__", at), bv(at, "__init__", "fn", f).
call_target(c, f) :- callee(c, e), pv(e, "inst", k), found(k, "__call__", at), bv(at, "__call__", "fn", f).
// A class call also runs the class's `__new__` and its metaclass's `__call__`, where the workspace defines them.
call_target(c, f) :- callee(c, e), pv(e, "cls", k), found(k, "__new__", at), bv(at, "__new__", "fn", f).
call_target(c, f) :- callee(c, e), pv(e, "cls", k), anc(k, b), metacls(b, mc), found(mc, "__call__", at), bv(at, "__call__", "fn", f).
.decl metacls(c: node, m: node)
metacls(c, mc) :- kind(c, "class_definition"), field(c, "superclasses", al), child(al, kw, _), kind(kw, "keyword_argument"),
    field(kw, "name", nm), text(nm, "metaclass"), field(kw, "value", v), pv(v, "cls", mc).
.decl call_open(c: node)
call_open(c) :- callee(c, e), vopen(e).
call_open(c) :- callee(c, e), pv(e, "cls", k), attr_open(c, k, "__init__").
call_open(c) :- callee(c, e), pv(e, "inst", k), attr_open(c, k, "__call__").
call_open(c) :- callee(c, e), pv(e, "mod", _).
call_open(c) :- callee(c, e), pv(e, "super", _).
call_open(c) :- callee(c, e), mro_ambiguous(e).
.decl ext_import(s: node, x: symbol)
ext_import(s, x) :- rifrom(s, x, m, _), docof(s, d9), !rr_cx_sees(d9, m).
ext_import(s, x) :- ribind(s, x, q), !rifrom(s, x, _, _), docof(s, d9), !rr_cx_sees(d9, q).
.output call_target, call_open, base

// ---- call chains ----------------------------------------------------------------------------------------------
// The function whose body holds a call (a lambda's or a nested class body's calls are the enclosing function's).
.decl owner(c: node, f: node)
owner(c, f) :- kind(c, "call"), nearest(c, f, fdef).
.decl calls(f: node, g: node)
calls(f, g) :- owner(c, f), call_target(c, g).
.decl calls_open(f: node)
calls_open(f) :- owner(c, f), call_open(c).
// W5 `ASYNC_BLOCKING`: an async function's call, outside `await`, of a sync function that reaches a blocking call
// through sync functions only (the native `calls` term with `through: sync`).
.decl blocking(q: symbol)
blocking("time.sleep"). blocking("requests.get"). blocking("subprocess.run").
.decl dq(f: node, q: symbol)
dq(f, @dot(m, x)) :- modname(s, m), live_def(s, x, f).
.decl blocks(f: node)
blocks(f) :- owner(c, f), callee(c, e), qn(e, q), blocking(q).
blocks(f) :- owner(c, f), call_target(c, g), dq(g, q), blocking(q).
.decl reach_sync(f: node)
reach_sync(f) :- blocks(f), !isasync(f).
reach_sync(f) :- calls(f, g), reach_sync(g), !isasync(f).
// Unknown: an open call on a sync path, where no path is known to reach.
.decl open_sync(f: node)
open_sync(f) :- calls_open(f), !isasync(f).
open_sync(f) :- calls(f, g), open_sync(g), !isasync(f).
.decl in_await(c: node)
in_await(c) :- kind(c, "call"), child(w, c, 0), kind(w, "await").
.decl finding(rule: symbol, n: node)
finding("ASYNC_BLOCKING", c) :- owner(c, a), isasync(a), !in_await(c), call_target(c, g), reach_sync(g).
.decl async_open(c: node)
async_open(c) :- owner(c, a), isasync(a), !in_await(c), call_target(c, g), open_sync(g), !reach_sync(g).
async_open(c) :- owner(c, a), isasync(a), !in_await(c), call_open(c).
// The witness chain for a message: each step of a reaching path.
.decl chain_step(f: node, g: node)
chain_step(f, g) :- calls(f, g), reach_sync(g), reach_sync(f).
.output finding, async_open, chain_step, calls

.decl builtin(x: symbol)
builtin("abs"). builtin("aiter"). builtin("all"). builtin("anext"). builtin("any"). builtin("ascii"). builtin("bin").
builtin("bool"). builtin("breakpoint"). builtin("bytearray"). builtin("bytes"). builtin("callable"). builtin("chr").
builtin("classmethod"). builtin("compile"). builtin("complex"). builtin("delattr"). builtin("dict"). builtin("dir").
builtin("divmod"). builtin("enumerate"). builtin("eval"). builtin("exec"). builtin("filter"). builtin("float").
builtin("format"). builtin("frozenset"). builtin("getattr"). builtin("globals"). builtin("hasattr"). builtin("hash").
builtin("help"). builtin("hex"). builtin("id"). builtin("input"). builtin("int"). builtin("isinstance").
builtin("issubclass"). builtin("iter"). builtin("len"). builtin("list"). builtin("locals"). builtin("map"). builtin("max").
builtin("memoryview"). builtin("min"). builtin("next"). builtin("object"). builtin("oct"). builtin("open"). builtin("ord").
builtin("pow"). builtin("print"). builtin("property"). builtin("range"). builtin("repr"). builtin("reversed").
builtin("round"). builtin("set"). builtin("setattr"). builtin("slice"). builtin("sorted"). builtin("staticmethod").
builtin("str"). builtin("sum"). builtin("super"). builtin("tuple"). builtin("type"). builtin("vars"). builtin("zip").
builtin("__import__"). builtin("__name__"). builtin("__file__"). builtin("__doc__"). builtin("__spec__"). builtin("__debug__").
builtin("NotImplemented"). builtin("Ellipsis"). builtin("BaseException"). builtin("Exception"). builtin("ValueError").
builtin("TypeError"). builtin("KeyError"). builtin("IndexError"). builtin("AttributeError"). builtin("RuntimeError").
builtin("NotImplementedError"). builtin("OSError"). builtin("ImportError"). builtin("StopIteration"). builtin("LookupError").
builtin("ArithmeticError"). builtin("AssertionError"). builtin("EOFError"). builtin("FileNotFoundError").
builtin("ModuleNotFoundError"). builtin("NameError"). builtin("OverflowError"). builtin("PermissionError").
builtin("RecursionError"). builtin("UnicodeError"). builtin("UnicodeDecodeError"). builtin("UnicodeEncodeError").
builtin("ZeroDivisionError"). builtin("KeyboardInterrupt"). builtin("SystemExit"). builtin("Warning").
builtin("DeprecationWarning"). builtin("UserWarning"). builtin("RuntimeWarning"). builtin("EnvironmentError").
builtin("IOError"). builtin("BufferError"). builtin("ConnectionError"). builtin("TimeoutError"). builtin("GeneratorExit").

// ---- types (decision 0047, point 3) ---------------------------------------------------------------------------
// What a rule reads of a value's type, at the positions whose value the program models (`vpos`: callees and
// receivers, assigned, returned and decorating values, arguments and bases). Three-valued, as calls are:
//   type_of(n, t)        n may hold a value whose class is t: a workspace class's qualified name, or a builtin's
//                        name (`int`, `str`, `None`, ...)
//   type_open(n)         n may also hold a value of a class not listed
//   proven_type(n, t)    `isinstance(n, t)` is true: every class n may hold is t or a subclass of it, and none is
//                        unlisted
//   possible_type(n, t)  `isinstance(n, t)` may be true: some listed class is t or a subclass of it
//   possible_open(n)     possible_type is incomplete: n may hold an unlisted class, or a listed class whose bases
//                        are not all known
// A rule's `possible: t` is `possible_type(n, t)` or `possible_open(n)`; `not proven: t` is `!proven_type(n, t)`.
// A workspace subclass is a closed world: an instance of a class code outside the workspace derives from a
// workspace class reaches the program only through an unknown value (a parameter, an external call).
.decl lit_type(k: symbol, t: symbol)
lit_type("integer", "int"). lit_type("float", "float"). lit_type("string", "str"). lit_type("concatenated_string", "str").
lit_type("true", "bool"). lit_type("false", "bool"). lit_type("none", "None").
lit_type("list", "list"). lit_type("list_comprehension", "list"). lit_type("dictionary", "dict").
lit_type("dictionary_comprehension", "dict"). lit_type("set", "set"). lit_type("set_comprehension", "set").
lit_type("tuple", "tuple"). lit_type("not_operator", "bool").
// A bytes literal: its prefix (`strprefix`, lowercased) has a `b` (`b"..."`, `rb"..."`); a concatenation's
// parts share their kind.
.decl strprefix(n: node, p: symbol)
.input strprefix
.decl bprefix(p: symbol)
bprefix("b"). bprefix("rb"). bprefix("br").
.decl bytes_lit(n: node)
bytes_lit(n) :- vpos(n), kind(n, "string"), strprefix(n, p), bprefix(p).
bytes_lit(n) :- vpos(n), kind(n, "concatenated_string"), child(n, c, 0), strprefix(c, p), bprefix(p).
// A builtin class whose call makes a value of that class.
.decl bclass(x: symbol)
bclass("int"). bclass("float"). bclass("complex"). bclass("str"). bclass("bytes"). bclass("bytearray"). bclass("bool").
bclass("list"). bclass("dict"). bclass("set"). bclass("frozenset"). bclass("tuple"). bclass("object").
.decl bcall(c: node, x: symbol)
bcall(c, x) :- callee(c, e), builtin_ref(e, x), bclass(x).
.decl btype(v: node, t: symbol)
btype(v, t) :- tv(_, "builtin", v), kind(v, k), lit_type(k, t), !bytes_lit(v).
btype(v, "bytes") :- tv(_, "builtin", v), bytes_lit(v).
btype(v, x) :- tv(_, "builtin", v), bcall(v, x).
// Values of builtin and external classes (`tv(n, k, v)`, read by the types only). `builtin`: a literal, or a call of a
// builtin class (`btype` gives v's class). `ext`: a value from outside the workspace (a name an import of an
// external module binds, a builtin name, an attribute of such a value, a comparison), whose class is not named. They
// flow as `pv`'s values do, so `x = str(y)` gives `x` the class `str`, and a name bound both to `None` and to an
// external import is known to hold more than `None`. `tv` reads `pv` and `pv` does not read it: the points-to
// component, which every attribute and cross-file join reads, holds only functions, classes, instances and modules.
.decl tv(n: node, k: symbol, v: node)
.decl tbv(s: node, x: symbol, k: symbol, v: node)
.decl tqv(m: node, q: symbol, k: symbol, v: node)
tv(n, "builtin", n) :- vpos(n), kind(n, k), lit_type(k, _).
tv(c, "builtin", c) :- vpos(c), bcall(c, _).
tv(n, "ext", n) :- vpos(n), builtin_ref(n, _).
tv(n, "ext", n) :- vpos(n), kind(n, "comparison_operator").
tv(n, "ext", n) :- vpos(n), lv(n, _, _).
tv(n, "ext", n) :- vpos(n), attr_of(n, o, _), tv(o, "ext", _).
tbv(s, x, "ext", s) :- ext_import(s, x).
tbv(s, x, k, v) :- live_asg(s, x, r), tv(r, k, v).
tbv(s, x, k, v) :- ibind(s, x, q), tqv(m9, q, k, v), docof(s, d9), docof(m9, e9), rr_cx_reach(d9, e9).
tqv(m, @dot(q, x), k, v) :- modname(m, q), tbv(m, x, k, v).
tv(n, k, v) :- look(n, x, s), tbv(s, x, k, v).
tv(n, k, v) :- qn(n, q), tqv(m9, q, k, v), docof(n, d9), docof(m9, e9), rr_cx_reach(d9, e9).
tv(n, k, v) :- alook(n, c, a), found(c, a, at), tbv(at, a, k, v).
tv(n, k, v) :- pass(n, c), tv(c, k, v).
tv(c, k, v) :- cfn(c, e, f), !isasync(f), !isgen(f), retval(f, r), tv(r, k, v).
tv(c, k, v) :- cfn(c, e, f), !method(f, _), retparam(f, i, _), posarg(c, i, a), tv(a, k, v).
// A workspace class's qualified name: a module's class, or a class's class. Classes in a function have none.
.decl cls_q(c: node, q: symbol)
cls_q(c, @dot(m, x)) :- modname(s, m), rdefn(s, x, c), kind(c, "class_definition").
cls_q(c, @dot(q, x)) :- cls_q(o, q), rdefn(o, x, c), kind(c, "class_definition").

.decl type_of(n: node, t: symbol)
type_of(n, q) :- vpos(n), pv(n, "inst", c), cls_q(c, q).
type_of(n, t) :- vpos(n), tv(n, "builtin", v), btype(v, t).
type_of(n, t) :- vpos(n), tv(n, "decl", m), dtype(m, t).
// A class object's class is `type`, unless a metaclass may make it another: a `metaclass=` keyword, an external base
// (`enum.Enum`, `abc.ABC`) or a base that is no known class, on the class or an ancestor. A builtin base keeps `type`.
type_of(n, "type") :- vpos(n), pv(n, "cls", c), !meta_open(c).
type_of(n, "module") :- vpos(n), pv(n, "mod", _).
type_of(n, "module") :- ext_mod(n).
// A name an `import` statement binds to a module outside the workspace (`import asyncio`), where nothing else binds it.
.decl ext_mod(n: node)
ext_mod(n) :- vpos(n), look(n, x, s), ext_import(s, x), !rifrom(s, x, _, _), !rasg(s, x, _, _), !rdefn(s, x, _).
.decl meta_open(c: node)
meta_open(c) :- anc(c, b), kind(b, "class_definition"), field(b, "superclasses", al), child(al, kw, _), kind(kw, "keyword_argument"),
    field(kw, "name", nm), text(nm, "metaclass").
meta_open(c) :- anc(c, b), basex(b, e), extb(e), !builtin_ref(e, _).
meta_open(c) :- anc(c, b), base_open(b).
.decl type_open(n: node)
type_open(n) :- vpos(n), vopen(n), !ext_mod(n).
type_open(n) :- vpos(n), !vopen(n), !pv(n, _, _), !tv(n, _, _), !ext_mod(n).
// Functions and `super()` objects are values the relations do not name a class for.
type_open(n) :- vpos(n), pv(n, k, _), k != "inst", k != "cls", k != "mod", k != "gen".
type_open(n) :- vpos(n), tv(n, "ext", _), !ext_mod(n).
type_open(n) :- vpos(n), pv(n, "cls", c), meta_open(c).
type_open(n) :- vpos(n), pv(n, "inst", c), !cls_q(c, _).
// A class whose `__new__` or metaclass `__call__` the workspace defines may make something else than its instance.
type_open(c) :- vpos(c), callee(c, e), pv(e, "cls", k), found(k, "__new__", _).
type_open(c) :- vpos(c), callee(c, e), pv(e, "cls", k), anc(k, b), metacls(b, _).
// Subclassing between the names `type_of` gives: a workspace class's workspace bases, its external bases by
// qualified name, and its builtin bases.
.decl tsub(n: node, t: symbol, u: symbol)
tsub(n, t, t) :- type_of(n, t).
tsub(n, t, "object") :- type_of(n, t).
tsub(n, "bool", "int") :- type_of(n, "bool").
tsub(n, t, u) :- type_of(n, t), cls_q(c, t), docof(n, d9), docof(c, e9), rr_cx_reach(d9, e9), anc(c, b), cls_q(b, u).
tsub(n, t, u) :- type_of(n, t), cls_q(c, t), docof(n, d9), docof(c, e9), rr_cx_reach(d9, e9), anc(c, b), basex(b, e), qn(e, u), !xknown(e, u).
tsub(n, t, x) :- type_of(n, t), cls_q(c, t), docof(n, d9), docof(c, e9), rr_cx_reach(d9, e9), anc(c, b), basex(b, e), builtin_ref(e, x).
// A listed class some of whose superclasses are unknown: a base that is no known class, or an external base
// (whose own bases the program does not read).
.decl tsup_open(n: node, t: symbol)
tsup_open(n, t) :- type_of(n, t), cls_q(c, t), docof(n, d9), docof(c, e9), rr_cx_reach(d9, e9), anc(c, b), base_open(b).
tsup_open(n, t) :- type_of(n, t), cls_q(c, t), docof(n, d9), docof(c, e9), rr_cx_reach(d9, e9), anc(c, b), basex(b, e), extb(e), !builtin_ref(e, "object").
.decl type_miss(n: node, u: symbol)
type_miss(n, u) :- type_first(n, t0), tsub(n, t0, u), type_of(n, t), !tsub(n, t, u).
// type_first(n, t): one type of n, the least by symbol atom (the run's interning, not the text: any one will do).
// Every type of a proven n is a subtype of u, this one among them, so u's candidates are its supertypes alone.
.decl type_first(n: node, t: symbol)
type_first(n, t) :- type_of(n, _), t = min t2 : { type_of(n, t2) }.
.decl proven_type(n: node, u: symbol)
proven_type(n, u) :- type_first(n, t), tsub(n, t, u), !type_open(n), !type_miss(n, u).
.decl possible_type(n: node, u: symbol)
possible_type(n, u) :- type_of(n, t), tsub(n, t, u).
.decl possible_open(n: node)
possible_open(n) :- type_open(n).
possible_open(n) :- type_of(n, t), tsup_open(n, t).
.output type_of, type_open, proven_type, possible_type, possible_open
