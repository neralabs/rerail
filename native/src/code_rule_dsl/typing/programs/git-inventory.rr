// The engine embeds core.rr and git.rr before this program.

.decl git_inventory_selection(selection: symbol)
.input git_inventory_selection

.decl inventory_directory(repo: symbol, path: symbol, tree: symbol)
.decl git_inventory_child_request(repo: symbol, selection: symbol, directory: symbol, name: symbol, mode: number, encoding: symbol)
.decl git_inventory_child_of(repo: symbol, selection: symbol, directory: symbol, name: symbol, mode: number, encoding: symbol, path: symbol)

inventory_directory(r, "", t) :- git_source_tree(r, t).
git_object_request(r, tree) :- inventory_directory(r, _, tree).
git_inventory_child_request(r, s, p, n, m, "utf8") :-
    inventory_directory(r, p, t), git_tree_entry(r, t, n, m, _), git_inventory_selection(s).
git_inventory_child_request(r, s, p, n, m, "bytes") :-
    inventory_directory(r, p, t), git_tree_entry_bytes(r, t, n, m, _), git_inventory_selection(s).
// Check a proposed child against the tree at each ancestor placement. Propagate requests up
// its parent chain and proofs down that same chain. Each accepted path contains distinct trees.
.decl inventory_step(repo: symbol, parent: symbol, path: symbol, child: symbol)
inventory_step(r, p, path, child) :-
    inventory_directory(r, p, t), git_tree_entry(r, t, name, 16384, child),
    git_inventory_child_of(r, _, p, name, 16384, "utf8", path).

.decl inventory_ancestor_check(repo: symbol, path: symbol, candidate: symbol)
inventory_ancestor_check(r, parent, candidate) :- inventory_step(r, parent, _, candidate).
inventory_ancestor_check(r, parent, candidate) :-
    inventory_ancestor_check(r, path, candidate), inventory_step(r, parent, path, _).

.decl inventory_ancestor_clear(repo: symbol, path: symbol, candidate: symbol)
inventory_ancestor_clear(r, "", candidate) :-
    inventory_ancestor_check(r, "", candidate), git_source_tree(r, root), root != candidate.
inventory_ancestor_clear(r, path, candidate) :-
    inventory_ancestor_check(r, path, candidate), inventory_step(r, parent, path, tree),
    inventory_ancestor_clear(r, parent, candidate), tree != candidate.
inventory_directory(r, path, child) :-
    inventory_step(r, parent, path, child), inventory_ancestor_clear(r, parent, child).

.decl inventory_file(path: symbol, mode: number, blob: symbol)
inventory_file(p, m, b) :-
    inventory_directory(r, base, t), git_tree_entry(r, t, name, m, b),
    git_inventory_child_of(r, _, base, name, m, "utf8", p), m >= 32768, m < 36864.
source_language_request(path) :- inventory_file(path, _, _).

.decl inventory_language(path: symbol, language: symbol)
inventory_language(p, g) :- source_language(p, g).

.decl inventory_error(path: symbol, tree: symbol, reason: symbol)
inventory_error(p, t, "cycle") :-
    inventory_step(r, parent, p, t), !inventory_ancestor_clear(r, parent, t).
inventory_error(p, t, reason) :- inventory_directory(r, p, t), git_object_of(r, t, "error", _, reason, "", _, _).
inventory_error(p, t, detail) :- inventory_directory(r, p, t), git_object_of(r, t, "error", _, _, detail, _, _), detail != "".
inventory_error(p, t, "not-a-tree") :-
    inventory_directory(r, p, t), git_object_kind(r, t, kind), kind != "tree".
.decl inventory_readable_directory(path: symbol, tree: symbol)
inventory_readable_directory(p, t) :- inventory_directory(r, p, t), git_object_kind(r, t, "tree").
.decl inventory_path_error(directory: symbol, hex_name: symbol)
inventory_path_error(d, n) :- git_inventory_child_of(_, _, d, n, _, "bytes", _).

.output inventory_readable_directory
.output git_inventory_selection
.output inventory_file
.output git_tree_entry
.output git_tree_entry_bytes
.decl inventory_tree_observation(tree: symbol, stamp: symbol)
inventory_tree_observation(t, stamp) :-
    inventory_directory(r, _, t), git_object_of(r, t, "storage", _, stamp, _, _, _).
.output inventory_tree_observation
.output inventory_error
.output inventory_path_error
.output inventory_language
