# Step 6: arrays hold values, so they nest, `[[true], [], null]`.
#
# New: a nested node, which tier 2 runs on a stack (`PUSH`, `RETURN`), and a supertype.

lexer ladder06

class ws    = ' ' '\t' '\n' '\r' 0x0b 0x0c
class alpha = 'a'..'z'
class op    = '[' ']' ','

token word = start starts(alpha) last lasts(alpha)
keywords word { "true" "false" "null" } required
token punctuation = start op
keywords punctuation { "[" "]" "," } required

skip ws
error "a byte no token takes" when ~ws & ~alpha & ~op

tree ladder {
  node document = value
  node array nested = '[' [value (',' value)*] ']'
  choice value supertype _value = array | true | false | null
}
