# Step 4: `null` joins the booleans: a comma-separated list of scalars.
#
# New: a third keyword; the choice is now of every scalar.

lexer ladder04

class ws    = ' ' '\t' '\n' '\r' 0x0b 0x0c
class alpha = 'a'..'z'
class comma = ','

token word = start starts(alpha) last lasts(alpha)
keywords word { "true" "false" "null" } required
token punctuation = start comma
keywords punctuation { "," } required

skip ws
error "a byte no token takes" when ~ws & ~alpha & ~comma

tree ladder {
  node document = scalar (',' scalar)*
  choice scalar = true | false | null
}
