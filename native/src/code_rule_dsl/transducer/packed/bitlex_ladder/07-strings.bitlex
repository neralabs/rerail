# Step 7: strings without escapes, `["a b", "", true]`.
#
# New: simdjson's string state, a carried prefix XOR of the quotes (`toggle`). Inside a string
# every byte is content: tier 1 masks the code outside strings, and only there are words,
# brackets and commas tokens.

lexer ladder07

class ws    = ' ' '\t' '\n' '\r' 0x0b 0x0c
class alpha = 'a'..'z'
class op    = '[' ']' ','
class quote = '"'
class backslash = '\\'
class lf    = '\n'

mask inside  = toggle(quote)          # the opening quote, not the closing one
mask opening = quote & inside
mask closing = quote & ~inside
mask body    = inside & ~opening      # between the quotes
mask code    = ~inside & ~closing

token '"'            = start quote
token string_content = start starts(body) last lasts(body)
token word           = start starts(code & alpha) last lasts(code & alpha)
keywords word { "true" "false" "null" } required
token punctuation    = start code & op
keywords punctuation { "[" "]" "," } required

skip code & ws
error "a byte no token takes"  when code & ~ws & ~alpha & ~op & ~quote
error "newline in a string"    when body & lf
error "an escape (step 8)"     when body & backslash

tree ladder {
  node document = value
  node array nested = '[' [value (',' value)*] ']'
  node string = '"' [string_content] '"'
  choice value supertype _value = array | string | true | false | null
}
