# Step 8: escapes in texts, `#a ^# b#`: a caret escapes the byte after it.
#
# New: simdjson's escaped bytes (`escaped`): in a run of carets, each one at an even offset
# escapes the byte after it. Only `^#`, `^^`, `^n` and `^t` are escapes.

lexer ladder08

class ws    = ' ' '\t' '\n' '\r'
class alpha = 'a'..'z'
class op    = '(' ')' ';'
class quote = '#'
class lf    = '\n'
class caret = '^'

mask escaped  = escaped(caret)
mask q        = quote & ~escaped
mask inside   = toggle(q)
mask opening  = q & inside
mask closing  = q & ~inside
mask body     = inside & ~opening
mask esc      = caret & body & ~escaped     # an escape's caret
mask esc_last = escaped & body              # the byte it escapes
mask content  = body & ~esc & ~esc_last
mask code     = ~inside & ~closing

token '#'          = start q
token contenu      = start starts(content) last lasts(content)
token echappement  = start esc last esc_last
keywords echappement {
  "^#" -> echappement  "^^" -> echappement  "^n" -> echappement  "^t" -> echappement
} required
token word         = start starts(code & alpha) last lasts(code & alpha)
keywords word { "vrai" "fausse" "nul" } required
token punctuation = start code & op
keywords punctuation { "(" ")" ";" } required

skip code & ws
error "a byte no token takes" when code & ~ws & ~alpha & ~op & ~quote
error "a newline in a text"   when body & lf

tree ladder {
  node document = valeur
  node liste nested = '(' [valeur (';' valeur)*] ')'
  node texte = '#' (contenu | echappement)* '#'
  choice valeur supertype _valeur = liste | texte | vrai | fausse | nul
}
