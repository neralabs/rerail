# Step 5: the document is one value; a value is a scalar or a flat array of scalars,
# `[true, null]`.
#
# New: brackets, and a node with its own tokens inside the root.

lexer ladder05

class ws    = ' ' '\t' '\n' '\r' 0x0b 0x0c
class alpha = 'a'..'z'
class op    = '[' ']' ','

token word = start starts(alpha) last lasts(alpha)
keywords word { "true" "false" "null" } required
token punctuation = start op
keywords punctuation { "[" "]" "," } required

skip ws
error "a byte no token takes" when ~ws & ~alpha & ~op

tree ladder {
  node document = value
  choice value = array | scalar
  node array = '[' [scalar (',' scalar)*] ']'
  choice scalar = true | false | null
}
