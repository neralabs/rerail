// A resident tape read in place (PIAT §20.5; decisions 0032, 0289 §4, 0293): a batch binds its chunk block and a
// table of its documents (`DocView`, the one view of `rerail_clif::view`, its MSL generated by
// `residency::slabs::msl` with every field's offset asserted); each document's tape, codes, source and line
// starts are read in the block at `at` plus the part's offset, so a copy into another block changes `at`
// alone. The tape is read where it lies, format 15's columns or format 16's arrays (a 16z tape is laid out as
// format 16 where it is placed): nothing per node is derived beside it. A parent is a search (format 15: back
// over at most 64 nodes, else a descent from the root; format 16: back over the siblings' slots), a child or
// sibling a hop over a subtree. Node indices here are document-local; a batch's numbering is
// `doc.node_base + local`. NONE is u32's max.
// source_base, line_base: the document's place in the batch's numbering of source bytes and lines.
// Format 15: widths are `size`'s, `off`'s and `tail`'s at bits 0, 4, 8, bit 12 tails from the node's
// own start; columns: code, size, base, off, tail. Format 16: widths are the slots', gaps' and lengths'
// at bits 0, 4, 8, the checkpoints' at 12, the side lists' values' at 16, 20, 24, 28; columns: codes,
// slots, gaps, lengths, checkpoints; side, parts: each side list and its part starts.
// `tape::resident::DeviceCode`: flags are named, extra<<1, missing<<2, error<<3.
struct DeviceCode{ushort kind,field;uchar flags,classCount;ushort reserved;ushort classes[8];};
static_assert(sizeof(DeviceCode)==24u,"device code layout");
constant uint TAPE_NONE=0xffffffffu;
// A document's first byte in the batch's chunk block: its parts are offsets from it.
inline device const uchar* tape_doc(device const uchar* chunk,DocView d){return chunk+d.at;}

// ---- the reads (decision 0310): `<ukl/reads/tape.h>`, written from the tape's reads in CLIF, which the CPU's
// JIT and the tape crate read through too; each takes the document's first byte and its view.
#define TAPE_READ(C,D) tape_doc(C,D),(thread const uint*)&(D)
inline uint tape_size(device const uchar* s,DocView d,uint i){return clif_tape_size(TAPE_READ(s,d),i);}
// The node's code's number in its document's (format 16: its language's) table.
inline uint tape_number(device const uchar* doc,DocView d,uint i){return clif_tape_number(doc,(thread const uint*)&d,i);}
// The node's code: its document's table (format 15), or its language's, its block's (format 16): `at + codes`
// modulo 2^32, so a table before the document is reached too (decision 0336 §7).
inline device const DeviceCode& tape_code(device const uchar* s,DocView d,uint i){return ((device const DeviceCode*)(s+(d.at+d.codes)))[tape_number(tape_doc(s,d),d,i)];}
inline uint tape_kind(device const uchar* s,DocView d,uint i){return tape_code(s,d,i).kind;}
inline uint tape_field(device const uchar* s,DocView d,uint i){return tape_code(s,d,i).field;}
inline uint tape_flags(device const uchar* s,DocView d,uint i){return tape_code(s,d,i).flags;}
inline bool tape_named(device const uchar* s,DocView d,uint i){return (tape_flags(s,d,i)&1u)!=0u;}
inline bool tape_has_class(device const uchar* s,DocView d,uint i,uint kind){device const DeviceCode& c=tape_code(s,d,i);for(uint k=0u;k<c.classCount;k++){if(c.classes[k]==kind)return true;if(c.classes[k]>kind)return false;}return false;}
inline uint tape_start(device const uchar* s,DocView d,uint i){return clif_tape_start(TAPE_READ(s,d),i);}
inline uint tape_end(device const uchar* s,DocView d,uint i){return clif_tape_end(TAPE_READ(s,d),i);}
// The parent: a search (format 16 back over the siblings' slots; format 15 back over at most 64 nodes, else a descent
// from the root over the siblings' subtrees).
inline uint tape_parent(device const uchar* s,DocView d,uint i){return clif_tape_parent(TAPE_READ(s,d),i);}
// The node after `i`'s subtree while it is before `end` (its parent's subtree's end).
inline uint tape_next_in(device const uchar* s,DocView d,uint i,uint end){return clif_tape_next_in(TAPE_READ(s,d),i,end);}
inline uint tape_end_of(device const uchar* s,DocView d,uint i){return clif_tape_end_of(TAPE_READ(s,d),i);}
inline uint tape_next(device const uchar* s,DocView d,uint i){return clif_tape_next(TAPE_READ(s,d),i);}
inline uint tape_next_named_in(device const uchar* s,DocView d,uint i,uint end){uint j=tape_next_in(s,d,i,end);while(j!=TAPE_NONE&&!tape_named(s,d,j))j=tape_next_in(s,d,j,end);return j;}
inline uint tape_next_named(device const uchar* s,DocView d,uint i){uint p=tape_parent(s,d,i);if(p==TAPE_NONE)return TAPE_NONE;return tape_next_named_in(s,d,i,tape_end_of(s,d,p));}
inline uint tape_first_child(device const uchar* s,DocView d,uint i){return clif_tape_first_child(TAPE_READ(s,d),i);}
inline uint tape_child_count(device const uchar* s,DocView d,uint i){return clif_tape_child_count(TAPE_READ(s,d),i);}
inline uint tape_child(device const uchar* s,DocView d,uint i,uint k){return clif_tape_child(TAPE_READ(s,d),i,k);}
inline uchar tape_byte(device const uchar* s,DocView d,uint at){return (tape_doc(s,d)+d.source)[at];}
inline device const uchar* tape_source(device const uchar* s,DocView d){return tape_doc(s,d)+d.source;}
// Lines (decision 0336 §6): format 16's newline index, format 15's line starts. A byte's line (from 0), and a
// line's first byte, document-local.
inline uint tape_line(device const uchar* s,DocView d,uint at){return clif_tape_line(TAPE_READ(s,d),at);}
inline uint tape_line_start(device const uchar* s,DocView d,uint line){return clif_tape_line_start(TAPE_READ(s,d),line);}
// A pass's roots (`label_passes::Roots`; decisions 0033, 0293 §10), with no list of them. In
// `roots`: word 0 the batch's file count F, words 1..=F+1 each file's first group of 64 nodes
// (groups start at each document's first node) and the total. A rule at word `at`: its kind (0
// over codes, 1 listed); over codes, a bit per file it runs in (ceil(F/32) words), then its test
// (`code_admits`); listed, its nodes as a row of bits over the batch's nodes. A thread takes a
// pass and a group, finds the group's roots as a 64-bit mask, and walks from each.
constant uint ROOT_GROUP=64u;
inline uint roots_groups(device const uint* roots){return roots[1u+roots[0]];}
inline uint roots_first_group(device const uint* roots,uint file){return roots[1u+file];}
inline uint roots_file_groups(device const uint* roots,uint file){return roots[2u+file]-roots[1u+file];}
// The file holding the batch's group `group`.
inline uint roots_file(device const uint* roots,uint group){uint low=0u,high=roots[0];while(high-low>1u){uint middle=(low+high)/2u;if(roots[1u+middle]<=group)low=middle;else high=middle;}return low;}
// Whether a code passes a rule over codes: {kind count or NONE, kinds, test count, tests (op << 16 | argument)}.
inline bool code_admits(device const uint* rule,device const DeviceCode& code){
 uint kinds=rule[0],at=1u;
 if(kinds!=0xffffffffu){bool found=false;for(uint k=0u;k<kinds;k++)if(rule[1u+k]==code.kind){found=true;break;}if(!found)return false;at+=kinds;}
 for(uint k=0u,tests=rule[at];k<tests;k++){
  uint test=rule[at+1u+k],op=test>>16u,arg=test&0xffffu;
  if(op==1u){if(code.kind!=arg)return false;}
  else{bool found=false;for(uint m=0u;m<code.classCount;m++)if(code.classes[m]==arg){found=true;break;}if(!found)return false;}
 }
 return true;
}
// A row of bits over the batch's nodes, the 64 from batch node `b`.
inline ulong root_row(device const uint* row,uint b){
 uint w=b/32u,sh=b%32u;ulong mask=ulong(row[w])|(ulong(row[w+1u])<<32u);
 return sh!=0u?(mask>>sh)|(ulong(row[w+2u])<<(64u-sh)):mask;
}
// The roots of the rule at `at` among document `d`'s nodes 64*group + lo .. 64*group + hi (file `file` of the batch),
// as bits of the group's 64. A rule over codes with an anchor (kind 2, decision 0365): its row (set by
// `label_formula`) and the rule without it.
inline ulong root_mask_in(device const uchar* s,DocView d,device const uint* roots,uint at,uint file,uint group,uint lo,uint hi){
 uint from=group*ROOT_GROUP;if(from>=d.nodes)return 0ul;
 uint count=min(ROOT_GROUP,d.nodes-from);hi=min(hi,count);if(lo>=hi)return 0ul;
 ulong keep=hi-lo==64u?~0ul:(((1ul<<(hi-lo))-1ul)<<lo);
 ulong mask=0ul,anchor=~0ul;
 if(roots[at]==2u){anchor=root_row(roots+at+2u,d.node_base+from)&keep;if(anchor==0ul)return 0ul;at+=roots[at+1u];}
 if(roots[at]!=0u){
  mask=root_row(roots+at+1u,d.node_base+from);
 }else{
  uint files=roots[0];
  if(((roots[at+1u+file/32u]>>(file%32u))&1u)==0u)return 0ul;
  device const uint* rule=roots+at+1u+(files+31u)/32u;
  for(uint k=lo;k<hi;k++)if(code_admits(rule,tape_code(s,d,from+k)))mask|=1ul<<k;
 }
 mask&=anchor;
 return mask&keep;
}
// Whether document `d`'s node `local` (file `file` of the batch) is a root of the rule at `at`: one node of
// `root_mask_in`'s test, an anchored rule's (kind 2, decision 0365) within its anchor's row.
inline bool root_admits(device const uchar* s,DocView d,device const uint* roots,uint at,uint file,uint local){
 if(roots[at]==2u){device const uint* row=roots+at+2u;uint b=d.node_base+local;if(((row[b/32u]>>(b%32u))&1u)==0u)return false;at+=roots[at+1u];}
 if(roots[at]!=0u){device const uint* row=roots+at+1u;uint b=d.node_base+local;return ((row[b/32u]>>(b%32u))&1u)!=0u;}
 uint files=roots[0];
 if(((roots[at+1u+file/32u]>>(file%32u))&1u)==0u)return false;
 return code_admits(roots+at+1u+(files+31u)/32u,tape_code(s,d,local));
}
// The roots among all the group's nodes.
inline ulong root_mask(device const uchar* s,DocView d,device const uint* roots,uint at,uint file,uint group){return root_mask_in(s,d,roots,at,file,group,0u,ROOT_GROUP);}
// The lowest set bit of a mask.
inline uint root_ctz(ulong m){uint low=uint(m);return low!=0u?ctz(low):32u+ctz(uint(m>>32u));}
// Each root of a mask, document-local: `ROOTS_EACH(mask, group, local) { ... }`. One loop over the
// mask (a fixed two-trip loop over its halves was unrolled, the body compiled twice).
#define ROOTS_EACH(MASK,GROUP,LOCAL) for(ulong rootBits=(MASK);rootBits!=0ul;rootBits&=rootBits-1ul)for(uint LOCAL=(GROUP)*ROOT_GROUP+root_ctz(rootBits),rootOnce=0u;rootOnce==0u;rootOnce=1u)
// A SIMD group's roots, spread over its lanes (decision 0293 §10, work queue Q60). Each lane makes its own mask (a
// micro walk's lane its share of its group's nodes, `root_mask_in`; a pattern's lane its own group's);
// the SIMD group then numbers all its lanes' roots (lane order, then bit order), and round `r` gives lane `l` root
// `32r + l`. The roots are as dense over the lanes as a list of them would be, and nothing lists
// them: a thread looping over its group's roots ran up to 64 walks one after another, and a SIMD group lasted as long
// as its longest lane's sum. Every lane of the SIMD group calls these together (they shuffle); a lane past the
// items holds an empty mask, and only lanes past the grid's end are missing (`active` counts the others).
struct SimdRoots { uint prefix,total,active; };
inline SimdRoots simd_roots(ulong mask){
 uint n=popcount(uint(mask))+popcount(uint(mask>>32u));
 SimdRoots r;r.prefix=simd_prefix_exclusive_sum(n);r.total=simd_sum(n);r.active=simd_sum(1u);return r;
}
// The lane whose mask holds root `i` of the SIMD group: the last lane whose prefix is at or below `i`, by halving.
inline uint simd_root_lane(SimdRoots r,uint i){
 uint lane=0u;
 for(uint step=16u;step>0u;step>>=1u){uint p=simd_shuffle(r.prefix,ushort(lane+step));if(lane+step<r.active&&p<=i)lane+=step;}
 return lane;
}
// The `j`-th set bit of a word (j below its count), by halving.
inline uint word_nth(uint w,uint j){
 uint at=0u;
 for(uint span=16u;span>0u;span>>=1u){uint m=(1u<<span)-1u,low=popcount(w&m);if(j>=low){j-=low;w>>=span;at+=span;}else w&=m;}
 return at;
}
// The `j`-th set bit of a mask given as its halves.
inline uint mask_nth(uint lo,uint hi,uint j){uint c=popcount(lo);return j<c?word_nth(lo,j):32u+word_nth(hi,j-c);}
