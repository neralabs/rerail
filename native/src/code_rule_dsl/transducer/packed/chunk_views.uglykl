// The chunk views' kernels (decision 0289 §2), in UKL (decision 0440 step C): the chunk's structures as
// `rerail-blocks` generates them (`device_chunk::ukl`, prepended by `metal_join.rs`), then `view_expand`, which makes
// each row as `Viewed::value_at` does, and a kind-set axis's solve in the chunk.

#define CH_NONE 0xffffffffu
// A span's items: its own address plus its offset (`rerail_blocks::Span`).
#define ITEMS(T, s) ((UKL_GLOBAL const T*)((UKL_GLOBAL const uint8_t*)&(s) + (s).off))

typedef UKL_GLOBAL const ChunkDoc* DocP;

UKL_INLINE uint32_t view_start(DocP d, uint32_t view) {
    return view == 1u ? d->child_row : (view == 2u ? d->field_row : d->node_row);
}
UKL_INLINE int64_t global_of(DocP d, uint32_t l) {
    uint32_t low = d->preorder != 0u ? l : ITEMS(uint32_t, d->low)[l];
    return (int64_t)((uint64_t)d->key << 32 | (uint64_t)low);
}
// The projection's parent (`Projected::parent`): a node left out of it has the root for parent.
UKL_INLINE uint32_t parent_of(DocP d, uint32_t l) {
    uint32_t q = ITEMS(uint32_t, d->up)[l];
    return (q == CH_NONE && l != 0u) ? 0u : q;
}
// The kind column (`Dialect::kind`) of local `l`: the canonical code's atom.
UKL_INLINE int64_t kind_of(DocP d, uint32_t l) {
    uint32_t code = ITEMS(uint32_t, d->kind)[l] % 1024u;
    if (code == 0u) return (int64_t)(d->tag * 1024u);
    uint32_t c = code < (uint32_t)d->canonical.len ? (uint32_t)ITEMS(uint16_t, d->canonical)[code] : code;
    return (int64_t)(d->tag * 1024u + (c == 0xffffu ? 0u : c));
}

// A node's or span's id (`Projected::global`): past the locals with ids by definition, a span's (`granules::span_low`).
UKL_INLINE int64_t loc_global(DocP d, uint32_t l) {
    uint32_t low;
    if (d->preorder != 0u) {
        low = l;
    } else if (l < (uint32_t)d->low.len) {
        low = ITEMS(uint32_t, d->low)[l];
    } else {
        uint32_t i = l - (uint32_t)d->low.len;
        uint32_t slot = (GR_SLOTS - 1u) - ukl_min(i >> GR_INDEX_BITS, GR_SPAN_SLOTS - 1u);
        low = slot << GR_INDEX_BITS | (i & ((1u << GR_INDEX_BITS) - 1u));
    }
    return (int64_t)((uint64_t)d->key << 32 | (uint64_t)low);
}

// The lines of `st` (`n` starts) starting at or before byte `at` (`core_rr::Lines::line`, before its `max(1)`;
// `Facts::start_line`: `LineTable::line` + 1).
UKL_INLINE uint32_t starts_at_or_before(UKL_GLOBAL const uint32_t* st, uint32_t n, uint32_t at) {
    uint32_t lo = 0u, hi = n;
    while (lo < hi) {
        uint32_t m = (lo + hi) / 2u;
        if (st[m] <= at) lo = m + 1u; else hi = m;
    }
    return lo;
}
UKL_INLINE uint32_t line_of(DocP d, uint32_t at) { return starts_at_or_before(ITEMS(uint32_t, d->lines), (uint32_t)d->lines.len, at); }
UKL_INLINE uint32_t fline_of(DocP d, uint32_t at) { return starts_at_or_before(ITEMS(uint32_t, d->flines), (uint32_t)d->flines.len, at); }

// The document holding node row `row` (of `node`): the last whose rows start at or before it.
UKL_INLINE uint32_t doc_of_node(DocP docs, uint32_t ndocs, uint32_t row) {
    uint32_t lo = 0u, hi = ndocs;
    while (hi - lo > 1u) {
        uint32_t m = (lo + hi) / 2u;
        if (docs[m].node_row <= row) lo = m; else hi = m;
    }
    return lo;
}

// Row `r`'s value `v` in column `c` of the relation `out` makes (decision 0325 step 5: a relation in its block, its
// rows' descriptor at `rows_at`), through the writer written once: a row past its chunks is counted, not written
// (decision 0463).
UKL_INLINE void view_put(UKL_GLOBAL uint8_t* out, uint64_t rows_at, uint32_t r, uint32_t c, int64_t v) {
    clif_rows_put((UKL_GLOBAL const uint8_t*)out, rows_at, r, c, (uint64_t)v);
}

// p: the root's offset, the view (`device_chunk::VIEW_*`), the rows, the columns, 0 (an axis's pairs' place until
// decision 0353 step 5), the made relation's rows' descriptor's offset (low, high), then each column's index.
DEFINE_KERNEL2(join, view_expand,
               ROBUFFER, uint8_t,  B,   "[block]",
               RWBUFFER, uint8_t,  out, "[block]",
               ROBUFFER, uint32_t, p,   "[7 + columns]",
               GID0,     uint32_t, r,   )
{
    uint32_t n = p[2];
    if (r >= n) return;
    uint64_t rows_at = (uint64_t)p[5] | ((uint64_t)p[6] << 32);
    UKL_GLOBAL const ChunkRoot* root = (UKL_GLOBAL const ChunkRoot*)(B + p[0]);
    DocP docs = ITEMS(ChunkDoc, root->docs);
    uint32_t view = p[1];
    if (view >= 5u && view <= 8u) {
        // core.rr's places (`View::Loc`): the document whose `Loc` rows hold `r`, then its local's span.
        uint32_t lo = 0u, hi = root->ndocs;
        while (hi - lo > 1u) {
            uint32_t m = (lo + hi) / 2u;
            if (docs[m].loc_row <= r) lo = m; else hi = m;
        }
        DocP d = &docs[lo];
        uint32_t l = r - d->loc_row;
        uint32_t s, e;
        if (l < d->nodes) {
            s = ITEMS(uint32_t, d->start)[l];
            e = ITEMS(uint32_t, d->end)[l];
        } else {
            s = ITEMS(uint32_t, d->spans)[2u * (l - d->nodes)];
            e = ITEMS(uint32_t, d->spans)[2u * (l - d->nodes) + 1u];
        }
        // A guest's places are its file's, found on the host (`ChunkDoc::placed`).
        bool placed = d->placed.len > 0;
        UKL_GLOBAL const uint32_t* pl = ITEMS(uint32_t, d->placed) + 3u * l;
        for (uint32_t c = 0u; c < p[3]; c++) {
            int64_t v;
            if (p[7 + c] == 0u) {
                v = loc_global(d, l);
            } else if (view == 8u) {
                v = (int64_t)d->file;
            } else if (placed) {
                v = (int64_t)(view == 5u ? pl[0] : (view == 6u ? pl[1] : pl[2]));
            } else {
                uint32_t line = ukl_max(line_of(d, s), 1u);
                if (view == 5u) v = (int64_t)line;
                else if (view == 6u) v = (int64_t)(e > s ? ukl_max(line_of(d, e - 1u), 1u) : line);
                else v = (int64_t)(s - ITEMS(uint32_t, d->lines)[line - 1u]);
            }
            view_put(out, rows_at, r, c, v);
        }
        return;
    }
    // The last document whose rows start at or before `r` holds it (an empty one starts where the next does).
    uint32_t lo = 0u, hi = root->ndocs;
    while (hi - lo > 1u) {
        uint32_t m = (lo + hi) / 2u;
        if (view_start(&docs[m], view) <= r) lo = m; else hi = m;
    }
    DocP d = &docs[lo];
    uint32_t i = r - view_start(d, view);
    uint32_t l = view == 1u ? i + 1u : (view == 2u ? ITEMS(uint32_t, d->fielded)[i] : i);
    uint32_t id = ITEMS(uint32_t, d->core)[l];
    for (uint32_t c = 0u; c < p[3]; c++) {
        uint32_t col = p[7 + c];
        int64_t v;
        if (view == 0u && col == 0u) {
            v = (int64_t)d->file;
        } else if (view == 3u && col == 0u) {
            v = (int64_t)d->key;
        } else if (view == 3u && col == 1u) {
            v = (int64_t)id;
        } else if (view == 0u && col == 2u) {
            v = kind_of(d, l);
        } else if (view == 9u && col == 1u) {
            // `line`'s columns are the node and its start's line, by the facts' lines (`Viewed::value_at`).
            v = (int64_t)fline_of(d, ITEMS(uint32_t, d->start)[l]);
        } else if (view == 0u && col == 3u) {
            v = (int64_t)ITEMS(uint32_t, d->start)[l];
        } else if (view == 0u && col == 4u) {
            v = (int64_t)ITEMS(uint32_t, d->end)[l];
        } else if ((view == 1u || view == 2u) && col == 0u) {
            uint32_t q = parent_of(d, l);
            v = q == CH_NONE ? -1 : global_of(d, q);
        } else if (view == 1u && col == 2u) {
            // `child`'s columns are parent, child, index (`Viewed::columns`).
            v = (int64_t)ITEMS(uint32_t, d->ord)[l];
        } else if (view == 2u && col == 1u) {
            v = (int64_t)(d->tag << 16 | (uint32_t)ITEMS(uint16_t, d->field)[l]);
        } else {
            v = global_of(d, l);
        }
        view_put(out, rows_at, r, c, v);
    }
}

// A kind-set axis's batch solve in the chunk (decision 0289 §2, `Within::solved_in_chunk`), a thread per node row.
// a: p0 the root's offset, p1 the node rows, p2 the members' offset (0: every kind is one), p3 1 for every ancestor in
// the set (`inside`, containment) or 0 for the nearest. The climb is bounded by the document's nodes.
UKL_INLINE bool axis_member(UKL_GLOBAL const uint8_t* B, uint32_t bits_at, DocP d, uint32_t l) {
    if (bits_at == 0u) return true;
    uint32_t at = d->tag * 1024u + ITEMS(uint32_t, d->kind)[l] % 1024u;
    return ((((UKL_GLOBAL const uint32_t*)(B + bits_at))[at >> 5] >> (at & 31u)) & 1u) != 0u;
}

// Each node row's rows (its ancestors in the set), into `start`; the extra value past the last row is 0, so the
// scan after leaves the total there.
DEFINE_KERNEL2(join, axis_count,
               ROBUFFER, uint8_t,  B,     "[block]",
               RWBUFFER, uint32_t, start, "[a.p1 + 1]",
               ARGS,     JoinP,    a,     ,
               GID0,     uint32_t, v,     )
{
    uint32_t n = a.p1;
    if (v > n) return;
    if (v == n) { start[v] = 0u; return; }
    UKL_GLOBAL const ChunkRoot* root = (UKL_GLOBAL const ChunkRoot*)(B + a.p0);
    DocP docs = ITEMS(ChunkDoc, root->docs);
    DocP d = &docs[doc_of_node(docs, root->ndocs, v)];
    uint32_t count = 0u;
    uint32_t up = parent_of(d, v - d->node_row);
    for (uint32_t k = 0u; k < d->nodes && up != CH_NONE; k++) {
        if (axis_member(B, a.p2, d, up)) {
            count++;
            if (a.p3 == 0u) break;
        }
        up = parent_of(d, up);
    }
    start[v] = count;
}

// Each node row's rows from its start (the scanned counts), nearest first: the ids of `n` and `a`, written once into
// the axis's relation (decision 0353 step 5) through the writer written once, bounded by its chunks. p4 is the rows
// the relation holds, the totals read before: a chunk's rows past it write nothing. p5: the first row of this chunk's,
// past the chunks' before. b0: the relation's rows' descriptor's offset in `out`'s block.
DEFINE_KERNEL2(join, axis_write,
               ROBUFFER, uint8_t,  B,     "[block]",
               ROBUFFER, uint32_t, start, "[a.p1 + 1]",
               RWBUFFER, uint8_t,  out,   "[block]",
               ARGS,     JoinP,    a,     ,
               GID0,     uint32_t, v,     )
{
    if (v >= a.p1 || a.p5 + start[a.p1] > a.p4) return;
    uint64_t rows_at = (uint64_t)a.b0;
    UKL_GLOBAL const ChunkRoot* root = (UKL_GLOBAL const ChunkRoot*)(B + a.p0);
    DocP docs = ITEMS(ChunkDoc, root->docs);
    DocP d = &docs[doc_of_node(docs, root->ndocs, v)];
    uint32_t at = a.p5 + start[v];
    uint32_t l = v - d->node_row;
    int64_t n_id = global_of(d, l);
    uint32_t up = parent_of(d, l);
    for (uint32_t k = 0u; k < d->nodes && up != CH_NONE; k++) {
        if (axis_member(B, a.p2, d, up)) {
            view_put(out, rows_at, at, 0u, n_id);
            view_put(out, rows_at, at, 1u, global_of(d, up));
            at++;
            if (a.p3 == 0u) break;
        }
        up = parent_of(d, up);
    }
}
