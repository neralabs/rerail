# corpus: mix: seed 190
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = quote
mask m1 = nul
mask m2 = (escaped(toggle((x | nul))) ^ next((starts(bs) & ~ws), 4))
mask m3 = fill(bs, m2)
