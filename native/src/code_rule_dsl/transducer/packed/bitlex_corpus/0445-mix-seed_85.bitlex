# corpus: mix: seed 85
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = after_odd_run(prev(escaped(x), 1))
mask m1 = (starts(op) & ~after(nul))
mask m2 = after_odd_run((m0 & ~m0))
mask m3 = starts(toggle(quote))
mask m4 = escaped(digit)
