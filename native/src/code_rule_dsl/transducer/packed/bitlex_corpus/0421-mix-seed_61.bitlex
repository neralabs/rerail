# corpus: mix: seed 61
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = starts(digit)
mask m1 = fill(~lf, starts(m0))
mask m2 = (after(fill(prev(op, 10), starts(quote))) & ~lf)
mask m3 = after(escaped(high))
mask m4 = after_odd_run(escaped(toggle(m1)))
