# corpus: mix: seed 100
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (bs & ~ws)
mask m1 = after_odd_run(toggle(lasts(nul)))
mask m2 = fill((m1 & ~toggle(quote)), after_odd_run(prev(alpha, 20)))
mask m3 = toggle(op)
mask m4 = after_odd_run(ws)
mask m5 = after_odd_run(after(alpha))
