# corpus: mix: seed 83
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = starts(aligned((escaped(digit) ^ span(bs, 2)), 8))
mask m1 = aligned((aligned(m0, 4) | (alpha & ~x)), 6)
