# corpus: mix: seed 197
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = next(toggle(lf), 11)
mask m1 = aligned(toggle(m0), 2)
mask m2 = (after(span(op, 17)) & quote)
mask m3 = lasts(escaped(m1))
mask m4 = op
