# corpus: mix: seed 1
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = after_odd_run(nul)
mask m1 = ~~alpha
mask m2 = (nul & ws)
mask m3 = m0
mask m4 = prev(lasts(lasts(prev(m1, 53))), 15)
mask m5 = after_odd_run(x)
