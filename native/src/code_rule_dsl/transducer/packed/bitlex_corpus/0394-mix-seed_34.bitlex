# corpus: mix: seed 34
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = alpha
mask m1 = span(m0, 1)
mask m2 = ~toggle(op)
mask m3 = (starts(quote) ^ prev(digit, 13))
mask m4 = digit
