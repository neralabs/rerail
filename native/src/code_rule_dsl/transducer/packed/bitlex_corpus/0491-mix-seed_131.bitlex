# corpus: mix: seed 131
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = span(aligned(aligned(starts(digit), 5), 8), 5)
mask m1 = (after(digit) & ~op)
mask m2 = toggle(op)
mask m3 = op
