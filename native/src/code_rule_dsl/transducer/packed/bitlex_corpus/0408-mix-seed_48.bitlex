# corpus: mix: seed 48
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = toggle(starts(quote))
mask m1 = escaped(digit)
mask m2 = next(m1, 4)
mask m3 = alpha
mask m4 = span(fill(nul, toggle(x)), 7)
