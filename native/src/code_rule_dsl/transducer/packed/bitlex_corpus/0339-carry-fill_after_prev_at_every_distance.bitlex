# corpus: carry: fill after prev at every distance
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask base = after(toggle(nul | quote))
mask c1 = fill(prev(base, 1), ws | op)
mask c2 = fill(prev(base, 2), ws | op)
mask c3 = fill(prev(base, 3), ws | op)
mask c4 = fill(prev(base, 4), ws | op)
