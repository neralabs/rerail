# corpus: carry: 2 long carries
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask p0 = prev(quote, 63) ^ toggle(digit)
mask p1 = prev(bs, 62) ^ toggle(alpha)
