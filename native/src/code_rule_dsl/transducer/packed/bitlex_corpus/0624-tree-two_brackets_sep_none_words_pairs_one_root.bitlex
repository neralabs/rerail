# corpus: tree: two brackets sep none words pairs one root
lexer corpus
class open  = '[' '{'
class close = ']' '}'
class colon = ':'
class ws    = ' ' '\n' '\t'
class digit = '0'..'9'
class w     = 'a'..'z' '0'..'9' '-' '.'
token punct = start open | close | colon
keywords punct { "[" "]" "{" "}" ":" } required
token atom  = start starts(w) last lasts(w)
skip ws
error "a stray byte" when ~(open | close | ws | w | colon)
tree t {
  node doc = value
  node list nested = '[' value* ']'
  node obj nested = '{' pair* '}'
  node pair = key: atom ':' value: value
  choice value supertype _value = list | obj | atom
}
