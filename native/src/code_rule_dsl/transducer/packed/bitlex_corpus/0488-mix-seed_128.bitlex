# corpus: mix: seed 128
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (toggle(next(after(ws), 6)) ^ (escaped((nul | bs)) & x))
mask m1 = next(op, 3)
mask m2 = (toggle(high) & ~alpha)
