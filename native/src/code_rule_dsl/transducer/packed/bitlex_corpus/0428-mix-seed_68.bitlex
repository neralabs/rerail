# corpus: mix: seed 68
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = alpha
mask m1 = bs
mask m2 = (quote & lf)
mask m3 = x
mask m4 = lasts(high)
mask m5 = after(next(aligned(digit, 2), 1))
