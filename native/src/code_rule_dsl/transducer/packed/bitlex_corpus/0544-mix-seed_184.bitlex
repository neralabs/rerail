# corpus: mix: seed 184
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = bs
mask m1 = bs
mask m2 = fill(bs, quote)
mask m3 = digit
mask m4 = starts(after(m1))
mask m5 = (after_odd_run(after(m2)) | span(alpha, 19))
mask m6 = starts(lf)
