# corpus: mix: seed 92
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (ws | lf)
mask m1 = after(toggle(ws))
mask m2 = lf
mask m3 = (prev(starts(lf), 62) & ~aligned(nul, 6))
