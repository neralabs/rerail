# corpus: mix: seed 46
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = lasts(after_odd_run(after_odd_run(quote)))
mask m1 = (digit | after_odd_run(ws))
mask m2 = starts(fill(alpha, op))
mask m3 = x
mask m4 = fill(bs, digit)
mask m5 = aligned(span(after_odd_run(nul), 17), 3)
