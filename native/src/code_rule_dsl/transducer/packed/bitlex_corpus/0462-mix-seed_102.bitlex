# corpus: mix: seed 102
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (digit ^ digit)
mask m1 = nul
mask m2 = after(m1)
mask m3 = aligned(x, 2)
mask m4 = escaped((toggle((lf & op)) & starts(aligned(m1, 5))))
mask m5 = after_odd_run(after(next(digit, 3)))
mask m6 = next(lasts(after(lf)), 10)
