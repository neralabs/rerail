// A stratum's join plan on the device (decision 0095 §3, §4): the stages, the text functions, the copies, the heads'
// distinct rows, the device-built indexes and the lattices' rounds, in UKL (decision 0440 step C). `metal_join.rs`
// prepends the reads written once (`<ukl/reads/relation.h>`, the views' reads), and holds the host's side.
//
// A stage's parameter block (`Stage`), a copy's (`Copy`), a dedup's (`Dedup`) and an index's (`IxP`) lie in a buffer
// of their own: they are past the parameter block a launch takes on every backend, and a view's directory's address
// in one is a pointer no backend's kernel arguments may hold. The kernel whose SIMD group does a row's work
// (`row_text`) runs in threadgroups of one SIMD group: its loops run as long as its row's bytes say, which every lane
// of the group agrees on, but no two groups do.

#define NONE 0xffffffffu
// The space the kernels read and write their tables, counts, places and texts in, their blocks' (`<ukl/clif.h>`): a
// program's worker (decision 0603) reads in one launch what other groups of it wrote, coherent across the device
// (`CLIF_BLOCKS_COHERENT`).
#define JSPACE CLIF_BLOCK_SPACE
// A struct of whole words read from JSPACE into `dst`: where it is coherent on a backend that copies no such struct
// (CUDA's C++ copies no volatile one; OpenCL 1.2 reads coherent words apart), a word at a time as the coherent loads
// read them (`ukl_ldc_u32`). Metal copies a coherent struct as it is.
#if defined(CLIF_BLOCKS_COHERENT) && !defined(UKL_CPU) && !defined(UKL_METAL)
#define JREAD(T, dst, src)                                                                                             \
    do {                                                                                                               \
        UKL_PRIVATE uint32_t* jr_to = (UKL_PRIVATE uint32_t*)&(dst);                                                   \
        for (uint32_t jr_i = 0u; jr_i < (uint32_t)(sizeof(T) / 4u); jr_i++)                                           \
            jr_to[jr_i] = ukl_ldc_u32((UKL_COHERENT const uint8_t*)(src), 4u * jr_i);                                  \
    } while (0)
#else
#define JREAD(T, dst, src) ((dst) = *(src))
#endif
// The lanes of a SIMD group: a text kernel's threadgroup.
#define SGW ((uint32_t)UKL_SIMD_WIDTH)

typedef struct Stage {
    int64_t key_const[8];
    int64_t par_const[16];
    uint64_t r_at;
    uint64_t r_dead;
    uint32_t ops[64][4];
    uint32_t mode, nslots, cap_in, cap_out, in_slot, out_slot, nr, nkeys, r_index, ntests, nops, nparams, nbinds, npassed, last, counter;
    uint32_t key_kind[8];
    uint32_t key_slot[8];
    uint32_t key_rcol[8];
    uint32_t test_a[8];
    uint32_t test_b[8];
    uint32_t col_kind[16];
    uint32_t col_idx[16];
    uint32_t col_doc[16];
    uint32_t par_kind[16];
    uint32_t par_slot[16];
    uint32_t par_doc[16];
    uint32_t bind_slot[16];
    uint32_t bind_kind[16];
    uint32_t bind_idx[16];
    uint32_t passed[16];
    uint32_t outputs[16];
    uint32_t noutputs;
    uint32_t ncols;
    uint32_t agg[2];
    uint32_t arith[8][4];
    UKL_GLOBAL const ViewDir* v_dir;
    uint32_t r_view;
    uint32_t v_parent;
    // The probed relation's screen (decision 0488): its key `screen - 1`'s column's kept filter, a `bloom::Bloom` at
    // byte `screen_at` of the kernel's `F`; 0 for none.
    uint32_t screen, screen_at;
    // A `has` axis probed off the tape (decision 0353 step 5, `DevRel::has`): its set's kind atoms, ascending, how it
    // is probed (`DevIndex::walk`: 1 by its node, a climb; 2 by its ancestor, the subtree; 0: not), and the atoms'
    // count.
    JSPACE const int64_t* v_set;
    uint32_t v_has, v_nset;
    // The probed relation's first row: a stage reads its rows from `r_from`, by their ids (a fixpoint's delta, its
    // head's rows past those it held: 0353 step 6); 0 for every row. `r_len` 1: its rows are its length as the device
    // claimed it (`clif_rel_len`) past `r_from`, at most `nr` (a recursive component's relation, grown on the device
    // round after round: decision 0603 step 3); 0: `nr`.
    uint32_t r_from, r_len;
} Stage;
UKL_STATIC_ASSERT(sizeof(Stage) == 2352, "Stage: size");
UKL_STATIC_ASSERT(UKL_OFFSETOF(Stage, ops) == 208, "Stage.ops");
UKL_STATIC_ASSERT(UKL_OFFSETOF(Stage, arith) == 2176, "Stage.arith");
UKL_STATIC_ASSERT(UKL_OFFSETOF(Stage, v_dir) == 2304, "Stage.v_dir");

typedef JSPACE const Stage* StageP;
typedef JSPACE const int64_t* Longs;

// A relation the device reads in its block, and the block its chain's far base lies in (decision 0353 step 6: a
// kept relation in its block, this run's rows continuing it in another): `far` is that block's offset from this one,
// made here from the two bindings (`rel_b`), never stored; the reads take it (`clif_rel_get`'s last argument). A
// relation with no far base binds its own block there too (0).
typedef struct RelB { Longs p; uint64_t far; } RelB;
UKL_INLINE RelB rel_b(Longs r, JSPACE const uint8_t* far) {
    if (far == 0) far = (JSPACE const uint8_t*)r;
    RelB b;
    b.p = r;
    b.far = (uint64_t)(far - (JSPACE const uint8_t*)r);
    return b;
}

// A view's row `r`'s value in column `col` (decision 0353 step 4d): the document whose rows hold it (the
// directory's search written once, `clif_dir_doc_of_row`, the caller's `memo` tried first and set to it), then the
// view's read written once, over the document's entry, tape and view where they lie. `kind`: 1 + `device_chunk::VIEW_*`.
UKL_COLD int64_t vread_dir(uint32_t kind, UKL_GLOBAL const ViewDir* d, uint32_t r, uint32_t col, UKL_PRIVATE uint32_t* memo) {
    UKL_GLOBAL const ViewRow* rows = view_rows(d);
    uint32_t k = kind - 1u;
    uint32_t lo = clif_dir_doc_of_row(view_block(d), d->at, k, r, *memo);
    *memo = lo;
    UKL_GLOBAL const ViewRow* e = &rows[lo];
    uint32_t i = r - e->rows[k];
    UKL_GLOBAL const uint32_t* v = e->view;
    UKL_GLOBAL const uint8_t* c = view_block(d);
    UKL_GLOBAL const uint8_t* t = view_tape(d, e);
    UKL_GLOBAL const uint8_t* l = view_lines_base(d, e);
    uint64_t la = e->lines;
    switch (k) {
        case 0u: return (int64_t)clif_view_node(c, e->entry, t, v, l, la, i, col);
        case 1u: return (int64_t)clif_view_child(c, e->entry, t, v, l, la, i, col);
        case 2u: return (int64_t)clif_view_field(c, e->entry, t, v, l, la, i, col);
        case 3u: return (int64_t)clif_view_core(c, e->entry, t, v, l, la, i, col);
        case 4u: return (int64_t)clif_view_line(c, e->entry, t, v, l, la, i, col);
        case 5u: return (int64_t)clif_view_loc_line(c, e->entry, t, v, l, la, i, col);
        case 6u: return (int64_t)clif_view_loc_end(c, e->entry, t, v, l, la, i, col);
        case 7u: return (int64_t)clif_view_loc_col(c, e->entry, t, v, l, la, i, col);
        case 8u: return (int64_t)clif_view_loc_docof(c, e->entry, t, v, l, la, i, col);
        case 9u: return (int64_t)clif_view_tape(c, e->entry, t, v, l, la, i, col);
        case 10u: return (int64_t)clif_view_depth(c, e->entry, t, v, l, la, i, col);
        case 11u: return (int64_t)clif_view_order(c, e->entry, t, v, l, la, i, col);
        default: return (int64_t)clif_view_op(c, e->entry, t, v, l, la, i, col);
    }
}

// A place relation where a program reads spans (Q216, `places::Places`): the `Loc` view's rows, then the places of
// the spans the batch made, a relation in its block (`tail` its base, `at` its descriptor). `rows`: the view's.
typedef struct {
    UKL_GLOBAL const ViewDir* dir;
    JSPACE const uint8_t* tail;
    uint64_t at;
    uint32_t rows;
    uint32_t pad;
} PlacedDir;
UKL_STATIC_ASSERT(sizeof(PlacedDir) == 32, "PlacedDir: size");
// A kind with this bit is a placed relation's: `d` is its `PlacedDir`, the rest of the kind its view's.
#define VIEW_PLACED 16u

// `kind`'s row `r` in column `col`: the view's read, or a placed relation's row, the view's or a span's where it lies.
UKL_COLD int64_t vread(uint32_t kind, UKL_GLOBAL const ViewDir* d, uint32_t r, uint32_t col, UKL_PRIVATE uint32_t* memo) {
    if ((kind & VIEW_PLACED) == 0u) return vread_dir(kind, d, r, col, memo);
    UKL_GLOBAL const PlacedDir* p = (UKL_GLOBAL const PlacedDir*)d;
    if (r < p->rows) return vread_dir(kind & ~VIEW_PLACED, p->dir, r, col, memo);
    // The tail, one relation in its own block: no far base.
    return (int64_t)clif_rel_get(p->tail, p->at, r - p->rows, col, 0ul);
}

// A key's hash, one value at a time: `rerail_blocks::key_hash`, the read written once (`clif_rel_key_mix`, decision
// 0325 step 5), which reads nothing through its descriptor. Every hash of a key on the device is it: a relation's
// index, a probe of it, the heads' set (`dedup`), a lattice's key table.
#define KEY_SEED 0x243F6A8885A308D3ul
UKL_INLINE uint64_t key_mix(uint64_t h, int64_t v) {
    return clif_rel_key_mix((JSPACE const uint8_t*)0, 0ul, h, (uint64_t)v);
}
UKL_INLINE uint64_t key_hash(UKL_PRIVATE const int64_t* kv, uint32_t n) {
    uint64_t h = KEY_SEED;
    for (uint32_t i = 0; i < n && i < 8; i++) h = key_mix(h, kv[i]);
    return h;
}

UKL_INLINE int64_t lane_of(int64_t v, uint32_t w) {
    return w == 16 ? (int64_t)(int16_t)v : (w == 32 ? (int64_t)(int32_t)v : v);
}

// A value of the probed relation: row `r`'s in column `col`, read in its block through the generated reads (`r_at`,
// decision 0325). Every relation the device reads lies in a block (step 5).
UKL_SHARED int64_t rget(StageP s, RelB R, uint32_t r, uint32_t col) {
    uint32_t memo = NONE;
    // A `has` walk's candidate is the node of the column not probed (`by_has`): either column reads its id.
    if (s->v_has != 0u) return vread(1u, s->v_dir, r, 1u, &memo);
    if (s->r_view != 0u) return vread(s->r_view, s->v_dir, r, col, &memo);
    return (int64_t)clif_rel_get((JSPACE const uint8_t*)R.p, s->r_at, r, col, R.far);
}

UKL_INLINE int64_t colval(StageP s, uint32_t k, Longs L, uint32_t t, RelB R, uint32_t r) {
    int64_t v = s->col_kind[k] == 0 ? rget(s, R, r, s->col_idx[k]) : L[(uint64_t)s->col_idx[k] * s->cap_in + t];
    return s->col_doc[k] != 0 ? (v >> 32) : v;
}

UKL_INLINE int64_t parval(StageP s, uint32_t k, Longs L, uint32_t t) {
    int64_t v = s->par_kind[k] == 0 ? s->par_const[k] : L[(uint64_t)s->par_slot[k] * s->cap_in + t];
    return s->par_doc[k] != 0 ? (v >> 32) : v;
}

// Arithmetic bind j's value for one row, as the CPU's checked arithmetic gives it: false where it has none (an
// overflow, a zero divisor). Wrapping operations on uint64_t, then the overflow tested, so nothing is undefined.
UKL_INLINE bool arith(StageP s, uint32_t j, Longs L, uint32_t t, RelB R, uint32_t r, UKL_PRIVATE int64_t* out) {
    JSPACE const uint32_t* a = s->arith[j];
    int64_t x = (a[3] & 1u) != 0 ? parval(s, a[1], L, t) : colval(s, a[1], L, t, R, r);
    int64_t y = (a[3] & 2u) != 0 ? parval(s, a[2], L, t) : colval(s, a[2], L, t, R, r);
    uint64_t ux = (uint64_t)x, uy = (uint64_t)y;
    bool min_by_neg = x == (int64_t)0x8000000000000000ul && y == -1;
    bool ok = true;
    int64_t v = 0;
    if (a[0] == 0u) {
        v = (int64_t)(ux + uy);
        ok = ((x ^ v) & (y ^ v)) >= 0;
    } else if (a[0] == 1u) {
        v = (int64_t)(ux - uy);
        ok = ((x ^ y) & (x ^ v)) >= 0;
    } else if (a[0] == 2u) {
        v = (int64_t)(ux * uy);
        ok = ukl_mulhi64(x, y) == (v >> 63);
    } else if (a[0] == 3u) {
        ok = y != 0 && !min_by_neg;
        v = ok ? x / y : 0;
    } else if (a[0] == 4u) {
        ok = y != 0 && !min_by_neg;
        v = ok ? x % y : 0;
    } else if (a[0] == 5u) {
        v = ukl_max(x, y);
    } else {
        v = ukl_min(x, y);
    }
    *out = v;
    return ok;
}

// Whether every arithmetic bind of the stage has a value for this row.
UKL_SHARED bool defined(StageP s, Longs L, uint32_t t, RelB R, uint32_t r) {
    for (uint32_t b = 0; b < s->nbinds && b < 16; b++) {
        if (s->bind_kind[b] != 3) continue;
        int64_t v = 0;
        if (!arith(s, s->bind_idx[b], L, t, R, r, &v)) return false;
    }
    return true;
}

// The row program's operations for one row: bit x of the result is operation x's value.
UKL_LARGE uint64_t eval(StageP s, Longs L, uint32_t t, RelB R, uint32_t r) {
    uint64_t v = 0;
    for (uint32_t x = 0; x < s->nops && x < 64; x++) {
        JSPACE const uint32_t* o = s->ops[x];
        bool b = false;
        if (o[0] == 0) {
            uint32_t w = (o[3] >> 8) & 255;
            int64_t a = lane_of(colval(s, o[1], L, t, R, r), w);
            int64_t c = (o[2] & 0x80000000u) != 0 ? parval(s, o[2] & 0xffffu, L, t) : colval(s, o[2], L, t, R, r);
            c = lane_of(c, w);
            uint32_t op = o[3] & 255;
            b = op == 0 ? a == c : (op == 1 ? a != c : (op == 2 ? a < c : a <= c));
        } else if (o[0] == 1) {
            b = o[1] != 0;
        } else if (o[0] == 2) {
            b = ((v >> o[1]) & 1) == 0;
        } else if (o[0] == 3) {
            b = ((v >> o[1]) & (v >> o[2]) & 1) != 0;
        } else if (o[0] == 4) {
            b = (((v >> o[1]) | (v >> o[2])) & 1) != 0;
        } else if (o[0] == 5) {
            b = (((v >> o[1]) ^ (v >> o[2])) & 1) != 0;
        } else {
            b = ((v >> o[1]) & ~(v >> o[2]) & 1) != 0;
        }
        v |= (uint64_t)b << x;
    }
    return v;
}

UKL_INLINE bool out_bit(StageP s, uint64_t v, uint32_t k) {
    return ((v >> s->outputs[k]) & 1) != 0;
}

// Entry `q` of the probed relation's index `r_index` (its rows grouped by key, in its block): a row id.
UKL_INLINE uint32_t group_row(StageP s, RelB R, uint32_t q) {
    return clif_rel_group_row((JSPACE const uint8_t*)R.p, s->r_at, s->r_index, q);
}

// The group of index `index` of the relation at `at` for the keys `kv`: [lo, hi) of its entries (every row whose key
// falls in the key's bucket; `matches` tests the key itself).
UKL_INLINE void group_of(RelB R, uint64_t at, uint32_t index, UKL_PRIVATE const int64_t* kv, uint32_t n,
                         UKL_PRIVATE uint32_t* lo, UKL_PRIVATE uint32_t* hi) {
    uint64_t g = clif_rel_group((JSPACE const uint8_t*)R.p, at, index, key_hash(kv, n));
    *lo = (uint32_t)(g >> 32);
    *hi = *lo + (uint32_t)(g & 0xfffffffful);
}

// The `child` view probed by its parent (decision 0353 step 4c, `Stage::v_parent`): the parent's children read off
// the tape, its first child and each next sibling (`clif_view_child_first`, `clif_view_child_next`), with no index of
// the view. A walk of a binding's candidates (`how`): 0 the rows [lo, hi), 1 an index group's entries [lo, hi), 2 a
// parent's children from row lo, each step the next sibling's row (`NONE` ends it), 3 a node's numbered ancestors
// from row lo, each step the next one up (`has_up`; `NONE` ends it).

// A parent `key`'s children: its document by the directory's search on its key (`clif_dir_doc_of_key`; the batch's
// documents are in key order), its numbered node (`clif_view_number`), then its first child. The root's children are also the nodes
// under unnumbered ones (a narrowed projection): its probe walks its document's rows, which `matches` tests.
UKL_INLINE void by_parent(StageP s, int64_t key, UKL_PRIVATE uint32_t* lo, UKL_PRIVATE uint32_t* hi, UKL_PRIVATE uint32_t* how) {
    UKL_GLOBAL const ViewDir* d = s->v_dir;
    *lo = 0u; *hi = 0u; *how = 0u;
    if (key < 0 || d->ndocs == 0u) return;
    uint32_t a = clif_dir_doc_of_key(view_block(d), d->at, (uint32_t)((uint64_t)key >> 32), NONE);
    if (a == NONE) return;
    UKL_GLOBAL const ViewRow* e = &view_rows(d)[a];
    UKL_GLOBAL const uint8_t* ch = view_block(d);
    UKL_GLOBAL const uint8_t* t = view_tape(d, e);
    UKL_GLOBAL const uint8_t* ls = view_lines_base(d, e);
    uint64_t la = e->lines;
    uint32_t l = clif_view_number(ch, e->entry, t, e->view, ls, la, (uint32_t)((uint64_t)key & 0xfffffffful));
    if (l == NONE) return;
    uint32_t first = e->rows[1];
    if (l == 0u) { *lo = first; *hi = a + 1u < d->ndocs ? view_rows(d)[a + 1u].rows[1] : s->nr; return; }
    uint32_t c = clif_view_child_first(ch, e->entry, t, e->view, ls, la, l);
    if (c == NONE) return;
    *lo = first + c; *hi = NONE; *how = 2u;
}

// The next sibling's row of `child` row `r`, or `NONE`: its document as `vread` finds it, then the read.
UKL_INLINE uint32_t child_next(StageP s, uint32_t r) {
    UKL_GLOBAL const ViewDir* d = s->v_dir;
    UKL_GLOBAL const ViewRow* e = &view_rows(d)[clif_dir_doc_of_row(view_block(d), d->at, 1u, r, NONE)];
    uint32_t n = clif_view_child_next(view_block(d), e->entry, view_tape(d, e), e->view, view_lines_base(d, e), e->lines, r - e->rows[1]);
    return n == NONE ? NONE : e->rows[1] + n;
}

// `has` probed off the tape (decision 0353 step 5, `Stage::v_has`), with no rows or index of its own: a candidate is
// a node's row in the `node` view (its document's first row there and its number). Probed by its node (1), its
// rows are the node's numbered ancestors, by a climb (`clif_view_up`), where the node is in the set; by its ancestor
// (2), the numbered nodes of its subtree (`clif_view_end`), those in the set (`matches`). As the host's
// `Within::containers_on` and `contained_on`.

// Whether node row `q`'s kind atom is in the set (the stage's, ascending), by bisection.
UKL_INLINE bool has_member(StageP s, uint32_t q) {
    uint32_t memo = NONE;
    int64_t k = vread(1u, s->v_dir, q, 2u, &memo);
    uint32_t lo = 0u, hi = s->v_nset;
    while (lo < hi) {
        uint32_t m = (lo + hi) / 2u;
        if (s->v_set[m] < k) lo = m + 1u; else hi = m;
    }
    return lo < s->v_nset && s->v_set[lo] == k;
}

// The candidates of node `key`: its document by the directory's search on its key (`clif_dir_doc_of_key`), its
// number, then its walk.
UKL_INLINE void by_has(StageP s, int64_t key, UKL_PRIVATE uint32_t* lo, UKL_PRIVATE uint32_t* hi, UKL_PRIVATE uint32_t* how) {
    UKL_GLOBAL const ViewDir* d = s->v_dir;
    *lo = 0u; *hi = 0u; *how = 0u;
    if (key < 0 || d->ndocs == 0u) return;
    uint32_t a = clif_dir_doc_of_key(view_block(d), d->at, (uint32_t)((uint64_t)key >> 32), NONE);
    if (a == NONE) return;
    UKL_GLOBAL const ViewRow* e = &view_rows(d)[a];
    UKL_GLOBAL const uint8_t* ch = view_block(d);
    UKL_GLOBAL const uint8_t* t = view_tape(d, e);
    UKL_GLOBAL const uint8_t* ls = view_lines_base(d, e);
    uint64_t la = e->lines;
    uint32_t l = clif_view_number(ch, e->entry, t, e->view, ls, la, (uint32_t)((uint64_t)key & 0xfffffffful));
    if (l == NONE) return;
    uint32_t first = e->rows[0];
    if (s->v_has == 1u) {
        if (!has_member(s, first + l)) return;
        uint32_t u = clif_view_up(ch, e->entry, t, e->view, ls, la, l);
        if (u == NONE) return;
        *lo = first + u; *hi = NONE; *how = 3u;
        return;
    }
    *lo = first + l + 1u;
    *hi = first + clif_view_end(ch, e->entry, t, e->view, ls, la, l);
}

// The next numbered ancestor's row of node row `q`, or `NONE`: its document as `vread` finds it, then the climb.
UKL_INLINE uint32_t has_up(StageP s, uint32_t q) {
    UKL_GLOBAL const ViewDir* d = s->v_dir;
    UKL_GLOBAL const ViewRow* e = &view_rows(d)[clif_dir_doc_of_row(view_block(d), d->at, 0u, q, NONE)];
    uint32_t u = clif_view_up(view_block(d), e->entry, view_tape(d, e), e->view, view_lines_base(d, e), e->lines, q - e->rows[0]);
    return u == NONE ? NONE : e->rows[0] + u;
}

// A walk's candidate `q`: its row, and the next candidate.
UKL_INLINE uint32_t cand_row(StageP s, RelB R, uint32_t how, uint32_t q) {
    return how == 1u ? group_row(s, R, q) : q;
}
UKL_INLINE uint32_t cand_next(StageP s, uint32_t how, uint32_t q) {
    return how == 2u ? child_next(s, q) : (how == 3u ? has_up(s, q) : q + 1u);
}

// R's rows from `r_from`: `nr`, or its length on the device past `r_from` (`r_len`), at most `nr`.
UKL_INLINE uint32_t stage_rows(StageP s, RelB R) {
    if (s->r_len == 0u) return s->nr;
    uint32_t len = clif_rel_len((JSPACE const uint8_t*)R.p, s->r_at);
    return len > s->r_from ? ukl_min(len - s->r_from, s->nr) : 0u;
}

// The candidates of keys `kv` in relation R (`s`'s): its index group, a parent's children, or every row.
UKL_INLINE void probe(StageP s, RelB R, UKL_PRIVATE const int64_t* kv, UKL_PRIVATE uint32_t* lo, UKL_PRIVATE uint32_t* hi,
                      UKL_PRIVATE uint32_t* how) {
    if (s->nkeys == 0) { *lo = s->r_from; *hi = s->r_from + stage_rows(s, R); *how = 0u; return; }
    if (s->v_has != 0u) { by_has(s, kv[0], lo, hi, how); return; }
    if (s->v_parent != 0u) { by_parent(s, kv[0], lo, hi, how); return; }
    *how = 1u;
    group_of(R, s->r_at, s->r_index, kv, s->nkeys, lo, hi);
}

// A binding's candidates (`probe`), and its key values.
// A key the probed relation's screen refuses (`Stage::screen`, a column's kept filter: decision 0488) has none, and
// its index group is not read. `F` is the screen's buffer.
UKL_LARGE void candidates(StageP s, Longs L, uint32_t t, RelB R, JSPACE const uint8_t* F, UKL_PRIVATE int64_t* kv,
                           UKL_PRIVATE uint32_t* lo, UKL_PRIVATE uint32_t* hi, UKL_PRIVATE uint32_t* how) {
    *how = 0u;
    if (s->mode == 3) { *lo = 0; *hi = 1; return; }
    for (uint32_t i = 0; i < s->nkeys && i < 8; i++) kv[i] = s->key_kind[i] == 1 ? L[(uint64_t)s->key_slot[i] * s->cap_in + t] : s->key_const[i];
    if (s->screen != 0u && s->screen <= s->nkeys && s->screen <= 8u
        && clif_bloom_may(F, (uint64_t)s->screen_at, clif_bloom_hash(F, 0ul, (uint64_t)kv[s->screen - 1u])) == 0u) {
        *lo = 0; *hi = 0; return;
    }
    probe(s, R, kv, lo, hi, how);
}

// Whether row `r` of the probed relation is live: not marked by its dead rows' delta (`r_dead`, the generated
// `clif_rel_dead`).
UKL_INLINE bool row_live(StageP s, RelB R, uint32_t r) {
    return s->r_dead == 0ul || clif_rel_dead((JSPACE const uint8_t*)R.p, s->r_dead, r) == 0u;
}

// Whether row r matches the binding's keys and the relation's column tests.
UKL_SHARED bool matches(StageP s, RelB R, uint32_t r, UKL_PRIVATE const int64_t* kv) {
    // A `has` walk's candidates hold its key by their making (`by_has`); a descendant is a row where it is in the set.
    // Its two columns are never one node (an ancestor is strict), so a test of them holds for no row.
    if (s->v_has != 0u) return s->ntests == 0u && (s->v_has == 1u || has_member(s, r));
    if (!row_live(s, R, r)) return false;
    for (uint32_t i = 0; i < s->nkeys && i < 8; i++) if (rget(s, R, r, s->key_rcol[i]) != kv[i]) return false;
    for (uint32_t i = 0; i < s->ntests && i < 8; i++) if (rget(s, R, r, s->test_a[i]) != rget(s, R, r, s->test_b[i])) return false;
    return true;
}

// An aggregate's value over the binding's matching rows (mode 4, `Stage::agg`): 0 with `v`, 1 when it has none (a min
// or max of no rows, or a tested value that differs), 2 when a sum passes 64 bits.
UKL_LARGE uint32_t aggregate(StageP s, Longs L, uint32_t t, RelB R, uint32_t lo, uint32_t hi, uint32_t how,
                              UKL_PRIVATE const int64_t* kv, UKL_PRIVATE int64_t* v) {
    uint32_t kind = s->agg[0] & 0xff;
    int64_t cnt = 0, sum = 0, mn = 0, mx = 0;
    bool any = false, over = false;
    for (uint32_t q = lo; q < hi; q = cand_next(s, how, q)) {
        uint32_t r = cand_row(s, R, how, q);
        if (!matches(s, R, r, kv)) continue;
        cnt++;
        if (s->agg[1] == NONE) continue;
        int64_t x = rget(s, R, r, s->agg[1]);
        int64_t y = (int64_t)((uint64_t)sum + (uint64_t)x);
        if ((sum < 0) == (x < 0) && (y < 0) != (sum < 0)) over = true;
        sum = y;
        if (!any || x < mn) mn = x;
        if (!any || x > mx) mx = x;
        any = true;
    }
    if (kind == 1 && over) return 2;
    if ((kind == 2 || kind == 3) && !any) return 1;
    *v = kind == 0 ? cnt : (kind == 1 ? sum : (kind == 2 ? mn : mx));
    if (((s->agg[0] >> 8) & 1) == 0 && L[(uint64_t)s->bind_slot[0] * s->cap_in + t] != *v) return 1;
    return 0;
}

// A key's value: a slot of binding t, or a constant.
UKL_INLINE int64_t key_value(StageP s, Longs L, uint32_t t, uint32_t k) {
    return s->key_kind[k] == 1 ? L[(uint64_t)s->key_slot[k] * s->cap_in + t] : s->key_const[k];
}

// The text arena (`Arena`): its first word the bytes given out (an atomic bump, counting on past the end, so a full
// one says how much was wanted), its second its capacity, its bytes from the 16th.
UKL_INLINE JSPACE const uint8_t* arena_bytes(JSPACE uint32_t* A) { return (JSPACE const uint8_t*)A + 16; }

// An arena text's value: the sign bit, its offset from bit 24, its length in the low 24 bits.
UKL_INLINE int64_t arena_value(uint32_t off, uint32_t len) { return (int64_t)(0x8000000000000000ul | ((uint64_t)off << 24) | (uint64_t)len); }

// A text operand: a symbol's name (b's empty), a held cat's text, never made (a's name, "." when `dot`, b's name), or
// an arena text.
typedef struct Txt { JSPACE const uint8_t* a; uint32_t al; JSPACE const uint8_t* b; uint32_t bl; uint32_t dot; } Txt;

UKL_INLINE uint32_t txt_len(Txt x) { return x.al + x.dot + x.bl; }

UKL_INLINE uint8_t txt_byte(Txt x, uint32_t i) {
    if (i < x.al) return x.a[i];
    i -= x.al;
    if (i < x.dot) return (uint8_t)'.';
    return x.b[i - x.dot];
}

// Eight bytes of x from `at`, big-endian, zero past `end`.
UKL_INLINE uint64_t txt_word(Txt x, uint32_t at, uint32_t end) {
    uint64_t w = 0;
    for (uint32_t k = 0; k < 8; k++) w = (w << 8) | ((at + k) < end ? (uint64_t)txt_byte(x, at + k) : 0ul);
    return w;
}

// Whether n bytes of x from xs are those of y from ys: a word of eight at a time.
UKL_SHARED bool txt_same(Txt x, uint32_t xs, Txt y, uint32_t ys, uint32_t n) {
    for (uint32_t at = 0; at < n; at += 8) if (txt_word(x, xs + at, xs + n) != txt_word(y, ys + at, ys + n)) return false;
    return true;
}

// Symbol v's bytes where the atoms blocks hold them, through the atoms directory D (decision 0478 step 2e): a value
// no atom of D's is (no symbol, or one interned after D was made) reads as empty and sets `unheld` (the stratum then
// runs on the host).
UKL_INLINE JSPACE const uint8_t* sym_text(JSPACE const uint8_t* D, int64_t v, UKL_PRIVATE uint32_t* len, UKL_PRIVATE bool* unheld) {
    uint32_t n = v >= 0 && v <= (int64_t)0xffffffffu ? clif_atoms_len(D, 0ul, (uint32_t)v) : 0xffffffffu;
    if (n == 0xffffffffu) { *unheld = true; *len = 0; return D; }
    *len = n;
    return D + clif_atoms_at(D, 0ul, (uint32_t)v);
}

// Operand kind 0: key k's symbol; 1: `cat`'s text of keys k and k + 1 (b's alone when a's is empty); 2:
// `str_concat`'s; 3: key k's arena text. Symbols read in place through D (`sym_text`).
UKL_INLINE Txt txt_of(StageP s, Longs L, uint32_t t, JSPACE const uint8_t* D, JSPACE uint32_t* A, uint32_t k, uint32_t kind,
                      UKL_PRIVATE bool* unheld) {
    Txt x;
    x.b = D;
    x.bl = 0;
    x.dot = 0;
    int64_t v = key_value(s, L, t, k);
    if (kind == 3) {
        // A value with none (-1: the arena was full) reads as empty: the stage runs again.
        uint64_t off = ((uint64_t)v >> 24) & ((1ul << 39) - 1);
        uint32_t len = (uint32_t)(v & 0xffffff);
        bool ok = v != -1 && off + len <= (uint64_t)A[1];
        x.a = arena_bytes(A) + (ok ? off : 0);
        x.al = ok ? len : 0;
        return x;
    }
    x.a = sym_text(D, v, &x.al, unheld);
    if (kind != 0) {
        x.b = sym_text(D, key_value(s, L, t, k + 1), &x.bl, unheld);
        x.dot = (kind == 1 && x.al > 0) ? 1 : 0;
    }
    return x;
}

// Mode 7: a literal text test of pattern X (keys 0, 1) and subject Y (keys 2, 3), each of kind agg[1] & 15 and
// agg[1] >> 4: by op agg[0] >> 1 & 3, 0 equal, 1 Y begins with X, 2 Y ends with X; as agg[0] & 1 wants.
UKL_INLINE bool textop_one(uint32_t op, Txt x, uint32_t xs, uint32_t lx, Txt y, uint32_t ly) {
    bool fits = op == 0 ? lx == ly : ly >= lx;
    return fits && txt_same(x, xs, y, op >= 2 ? ly - lx : 0, lx);
}

// With `TEXT_SPLIT` (agg[0] bit 5), X is a set of patterns (`strings::SET_SEP` between them, empty ones too, as
// `strings::test` splits it): Y passes when any one does. The separators are found a word of eight at a time (an exact
// mask of the bytes equal to 0x1f), each member compared as one pattern. A bound pattern (`TEXT_BOUND`, agg[0] bit 6)
// that holds the separator is no set: `host` set, and the stratum runs on the host. A constant set is split.
UKL_LARGE bool textop_pass(StageP s, Longs L, uint32_t t, JSPACE const uint8_t* D, JSPACE uint32_t* A, UKL_PRIVATE bool* unheld,
                            UKL_PRIVATE bool* host) {
    Txt x = txt_of(s, L, t, D, A, 0, s->agg[1] & 15, unheld), y = txt_of(s, L, t, D, A, 2, s->agg[1] >> 4, unheld);
    uint32_t lx = txt_len(x), ly = txt_len(y);
    uint32_t op = (s->agg[0] >> 1) & 3;
    bool split = (s->agg[0] & 32) != 0;
    const uint64_t lo7 = 0x7f7f7f7f7f7f7f7ful;
    // Each member of X in turn (X whole when it is no set): one ends at the next separator, the last at X's end.
    // `m` holds the separators not yet taken of the word at `at - 8`.
    bool r = false;
    uint32_t start = 0, at = 0;
    uint64_t m = 0;
    for (;;) {
        while (split && m == 0 && at < lx) {
            uint64_t z = txt_word(x, at, lx) ^ 0x1f1f1f1f1f1f1f1ful;
            // Bytes past the text read 0 (z's 0x1f): never a separator.
            m = ~(((z & lo7) + lo7) | z | lo7);
            *host = *host || (m != 0 && (s->agg[0] & 64) != 0);
            at += 8;
        }
        bool last = m == 0;
        uint32_t end = lx;
        if (!last) {
            uint32_t k = ukl_clz64(m) / 8;
            end = at - 8 + k;
            m &= ~(0x8000000000000000ul >> (8 * k));
        }
        r = r || textop_one(op, x, start, end - start, y, ly);
        if (last) break;
        start = end + 1;
    }
    return r == ((s->agg[0] & 1) != 0);
}

// The characters of x: its bytes less the UTF-8 continuation bytes (`10xxxxxx`), counted a word at a time.
UKL_INLINE uint32_t txt_chars(Txt x) {
    uint32_t n = txt_len(x), cont = 0;
    for (uint32_t at = 0; at < n; at += 8) {
        uint64_t w = txt_word(x, at, n);
        cont += ukl_popcount64(w & ~(w << 1) & 0x8080808080808080ul);
    }
    return n - cont;
}

// A function of names (mode 6), of operands X (keys 0, 1) and Y (keys 2, 3) as mode 7's (kinds agg[1] & 15 and
// agg[1] >> 4), its value into `bind_slot[0]`: by agg[0], 0 `str_cmp` (their order by bytes, a word of eight at a
// time, then their lengths, as Rust's `str::cmp`), 1 `strlen` of X (its characters).
UKL_INLINE int64_t strcmp_value(StageP s, Longs L, uint32_t t, JSPACE const uint8_t* D, JSPACE uint32_t* A, UKL_PRIVATE bool* unheld) {
    Txt x = txt_of(s, L, t, D, A, 0, s->agg[1] & 15, unheld);
    if (s->agg[0] == 1) return (int64_t)txt_chars(x);
    uint32_t lx = txt_len(x);
    Txt y = txt_of(s, L, t, D, A, 2, s->agg[1] >> 4, unheld);
    uint32_t ly = txt_len(y), m = ukl_min(lx, ly);
    for (uint32_t at = 0; at < m; at += 8) {
        uint64_t u = txt_word(x, at, m), v = txt_word(y, at, m);
        if (u != v) return u < v ? -1 : 1;
    }
    return lx == ly ? 0 : (lx < ly ? -1 : 1);
}

// Each binding's rows out (`stage_scatter` writes them at their scanned offsets).
UKL_INLINE void stage_count_one(Longs L, Longs R_rows, JSPACE const uint8_t* R_far, JSPACE const uint32_t* totals, JSPACE uint32_t* counters, JSPACE uint32_t* counts,
                            JSPACE uint32_t* A, JSPACE const uint8_t* D, JSPACE const uint8_t* F, StageP s, uint32_t t)
{
    RelB R = rel_b(R_rows, R_far);
    if (t > s->cap_in) return;
    uint32_t n = ukl_min(totals[s->in_slot], s->cap_in);
    if (t >= n) { counts[t] = 0; return; }
    int64_t kv[8];
    uint32_t lo, hi, how;
    if (s->mode == 6) { counts[t] = 1; return; }
    if (s->mode == 7) {
        bool unheld = false, host = false;
        counts[t] = (uint32_t)textop_pass(s, L, t, D, A, &unheld, &host);
        // A symbol the atoms directory does not hold (`TEXTFN_UNHELD`), a bound pattern holding the separator
        // (`TEXTFN_HOST`): the stratum on the host.
        if (s->counter != NONE && (unheld || host)) ukl_atomic_or(&counters[s->counter], (unheld ? 4u : 0u) | (host ? 2u : 0u));
        return;
    }
    candidates(s, L, t, R, F, kv, &lo, &hi, &how);
    if (s->mode == 4) {
        int64_t v = 0;
        uint32_t st = aggregate(s, L, t, R, lo, hi, how, kv, &v);
        if (st == 2 && s->counter != NONE) ukl_atomic_store(&counters[s->counter], 1u);
        counts[t] = (uint32_t)(st == 0);
        return;
    }
    bool exists = s->mode == 1 || s->mode == 2;
    uint32_t c = 0, p0 = 0;
    uint32_t q_counts[16];
    for (uint32_t m = 0; m < 16; m++) q_counts[m] = 0;
    bool found = false;
    for (uint32_t q = lo; q < hi; q = cand_next(s, how, q)) {
        uint32_t r = cand_row(s, R, how, q);
        if (s->mode == 3 ? !row_live(s, R, r) : !matches(s, R, r, kv)) continue;
        if (exists) { found = true; break; }
        p0++;
        bool ok = defined(s, L, t, R, r);
        uint64_t v = s->nops > 0 ? eval(s, L, t, R, r) : 0;
        for (uint32_t m = 0; m < s->npassed && m < 16; m++) q_counts[m] += s->passed[m] == NONE ? (uint32_t)ok : (uint32_t)(ok && out_bit(s, v, s->passed[m]));
        if (!ok || (s->last != NONE && !out_bit(s, v, s->last))) continue;
        c++;
    }
    if (exists) c = (uint32_t)(found != (s->mode == 2));
    counts[t] = c;
    if (!exists && s->counter != NONE) {
        if (p0 > 0) ukl_atomic_add(&counters[s->counter], p0);
        for (uint32_t m = 0; m < s->npassed && m < 16; m++) if (q_counts[m] > 0) ukl_atomic_add(&counters[s->counter + 1 + m], q_counts[m]);
    }
}

UKL_LARGE void write_row(StageP s, Longs L, uint32_t t, RelB R, uint32_t r, JSPACE int64_t* O, uint32_t at) {
    for (uint32_t k = 0; k < s->nslots; k++) O[(uint64_t)k * s->cap_out + at] = L[(uint64_t)k * s->cap_in + t];
    for (uint32_t b = 0; b < s->nbinds && b < 16; b++) {
        uint32_t kind = s->bind_kind[b];
        int64_t v = 0;
        if (kind == 3) arith(s, s->bind_idx[b], L, t, R, r, &v);
        else v = kind == 0 ? colval(s, s->bind_idx[b], L, t, R, r) : (kind == 1 ? parval(s, s->bind_idx[b], L, t) : rget(s, R, r, s->bind_idx[b]));
        O[(uint64_t)s->bind_slot[b] * s->cap_out + at] = v;
    }
}

// Each binding's rows at its offset; the rows' count into `totals[out_slot]`.
UKL_INLINE void stage_scatter_one(Longs L, Longs R_rows, JSPACE const uint8_t* R_far, JSPACE uint32_t* totals, JSPACE const uint32_t* offsets, JSPACE int64_t* O,
                              JSPACE uint32_t* A, JSPACE uint32_t* counters, JSPACE const uint8_t* D, JSPACE const uint8_t* F, StageP s, uint32_t t)
{
    RelB R = rel_b(R_rows, R_far);
    // Its offsets are its own: the level's scan's, less its first (`Batch::level`).
    uint32_t o0 = offsets[0];
    uint32_t n = ukl_min(totals[s->in_slot], s->cap_in);
    // The offsets past the rows' are not scanned when the grids are sized on the device (`Scan::size`).
    if (t == 0) totals[s->out_slot] = (offsets[n] - o0);
    if (t >= n) return;
    uint32_t at = (offsets[t] - o0);
    if (at >= s->cap_out) return;
    int64_t kv[8];
    uint32_t lo, hi, how;
    if (s->mode == 7) {
        if ((offsets[t + 1] - o0) > at) write_row(s, L, t, R, 0, O, at);
        return;
    }
    if (s->mode == 6) {
        if ((offsets[t + 1] - o0) <= at) return;
        write_row(s, L, t, R, 0, O, at);
        bool unheld = false;
        O[(uint64_t)s->bind_slot[0] * s->cap_out + at] = strcmp_value(s, L, t, D, A, &unheld);
        if (unheld && s->counter != NONE) ukl_atomic_or(&counters[s->counter], 4u);
        return;
    }
    if (s->mode == 4) {
        if ((offsets[t + 1] - o0) <= at) return;
        candidates(s, L, t, R, F, kv, &lo, &hi, &how);
        int64_t v = 0;
        aggregate(s, L, t, R, lo, hi, how, kv, &v);
        write_row(s, L, t, R, 0, O, at);
        if ((s->agg[0] >> 8) & 1) O[(uint64_t)s->bind_slot[0] * s->cap_out + at] = v;
        return;
    }
    if (s->mode == 1 || s->mode == 2) {
        // The count pass decided: a row out is the binding as it is.
        if ((offsets[t + 1] - o0) > at) write_row(s, L, t, R, 0, O, at);
        return;
    }
    candidates(s, L, t, R, F, kv, &lo, &hi, &how);
    for (uint32_t q = lo; q < hi && at < s->cap_out; q = cand_next(s, how, q)) {
        uint32_t r = cand_row(s, R, how, q);
        if (s->mode == 3 ? !row_live(s, R, r) : !matches(s, R, r, kv)) continue;
        if (!defined(s, L, t, R, r)) continue;
        if (s->last != NONE) {
            uint64_t v = eval(s, L, t, R, r);
            if (!out_bit(s, v, s->last)) continue;
        }
        write_row(s, L, t, R, r, O, at);
        at++;
    }
}

// A witness's probe (decision 0277): whether relation R has a row of `b`'s keys (a binding's slots, constants or the
// candidate's columns) and column tests; an anti-join's, whether it has none. One loop over the keys' run.
UKL_LARGE bool witness_probe(StageP b, Longs L, uint32_t t, uint32_t cap_in, StageP a, RelB RA, uint32_t ra, RelB R) {
    int64_t kv[8];
    for (uint32_t i = 0; i < b->nkeys && i < 8; i++) {
        uint32_t k = b->key_kind[i];
        kv[i] = k == 1 ? L[(uint64_t)b->key_slot[i] * cap_in + t] : (k == 2 ? rget(a, RA, ra, b->key_slot[i]) : b->key_const[i]);
    }
    uint32_t lo, hi, how;
    probe(b, R, kv, &lo, &hi, &how);
    bool found = false;
    for (uint32_t q = lo; q < hi; q = cand_next(b, how, q)) {
        uint32_t r = cand_row(b, R, how, q);
        if (matches(b, R, r, kv)) { found = true; break; }
    }
    return found != (b->mode == 2);
}

// A witness's count (mode 11): 1 for a binding with a candidate of the stage's relation that every probe passes,
// found in the candidates' order, the loop ending at the first; else 0. `stage_scatter` (as a semi-join) writes them.
UKL_INLINE void witness_count_one(Longs L, Longs R_rows, JSPACE const uint8_t* R_far, JSPACE const uint32_t* totals, JSPACE uint32_t* counts, StageP bs, Longs R0_rows, Longs R1_rows, Longs R2_rows,
                              JSPACE const uint8_t* R0_far, JSPACE const uint8_t* R1_far, JSPACE const uint8_t* R2_far,
                              JSPACE const uint8_t* F, StageP s, uint32_t t)
{
    RelB R = rel_b(R_rows, R_far);
    RelB R0 = rel_b(R0_rows, R0_far);
    RelB R1 = rel_b(R1_rows, R1_far);
    RelB R2 = rel_b(R2_rows, R2_far);
    if (t > s->cap_in) return;
    uint32_t n = ukl_min(totals[s->in_slot], s->cap_in);
    if (t >= n) { counts[t] = 0; return; }
    int64_t kv[8];
    uint32_t lo, hi, how;
    candidates(s, L, t, R, F, kv, &lo, &hi, &how);
    uint32_t nb = ukl_min(s->agg[0], 3u);
    uint32_t found = 0;
    for (uint32_t q = lo; q < hi; q = cand_next(s, how, q)) {
        uint32_t r = cand_row(s, R, how, q);
        if (!matches(s, R, r, kv)) continue;
        bool all = true;
        if (nb > 0) all = witness_probe(&bs[0], L, t, s->cap_in, s, R, r, R0);
        if (all && nb > 1) all = witness_probe(&bs[1], L, t, s->cap_in, s, R, r, R1);
        if (all && nb > 2) all = witness_probe(&bs[2], L, t, s->cap_in, s, R, r, R2);
        if (all) { found = 1; break; }
    }
    counts[t] = found;
}

// The states after each of m (at most a lane's each) bytes of x, lane l's after byte `first + step * l`, from state `st`: the
// bytes' transition functions (rows of table `tab`, S states of C classes) composed by a prefix over the lanes in
// device scratch `f` (two rows of S bytes a lane), Hillis and Steele's: five steps of a row a lane.
UKL_INLINE uint32_t chunk_states(JSPACE const uint8_t* tab, uint32_t S, uint32_t C, Txt x, int32_t first, int32_t step, uint32_t m,
                                 uint32_t st, JSPACE uint8_t* f, uint32_t lane) {
    JSPACE const uint8_t* cls = tab;
    JSPACE const uint8_t* next = tab + 256;
    JSPACE uint8_t* a = f;
    JSPACE uint8_t* b = f + SGW * S;
    bool has = lane < m;
    uint32_t c = has ? (uint32_t)cls[txt_byte(x, (uint32_t)(first + step * (int32_t)lane))] : 0;
    for (uint32_t q = 0; q < S; q++) a[lane * S + q] = has ? next[q * C + c] : (uint8_t)q;
    ukl_sg_barrier();
    for (uint32_t d = 1; d < SGW; d <<= 1) {
        // The bytes before (lane - d's prefix), then this lane's: applied in order.
        for (uint32_t q = 0; q < S; q++) b[lane * S + q] = lane >= d ? a[lane * S + a[(lane - d) * S + q]] : a[lane * S + q];
        ukl_sg_barrier();
        JSPACE uint8_t* t = a; a = b; b = t;
    }
    uint32_t r = a[lane * S + st];
    ukl_sg_barrier();
    return r;
}

// A text's bytes as a text operand.
UKL_INLINE Txt txt_raw(JSPACE const uint8_t* p, uint32_t n) {
    Txt x;
    x.a = p;
    x.al = n;
    x.b = p;
    x.bl = 0;
    x.dot = 0;
    return x;
}

// The greatest of the lanes' `v`, -1 for none (SIMD groups' maxima are of unsigned words).
UKL_INLINE int32_t sg_max_or_none(int32_t v __UKL_PARAMS) {
    return (int32_t)ukl_sg_max((uint32_t)(v + 1) __UKL_ARGS) - 1;
}

// The byte of character c of x (n bytes; n when it has fewer), a byte a lane at a time: each chunk's characters' first
// bytes counted by a prefix over the lanes.
UKL_INLINE uint32_t char_byte(Txt x, uint32_t n, int64_t c, uint32_t lane __UKL_PARAMS) {
    uint32_t seen = 0;
    for (uint32_t k = 0; k < n; k += SGW) {
        bool first = k + lane < n && (txt_byte(x, k + lane) & 0xc0) != 0x80;
        uint32_t before = ukl_sg_exclusive_sum(first ? 1u : 0u, lane __UKL_ARGS);
        uint32_t hit = ukl_sg_min(first && (int64_t)(seen + before) == c ? lane : SGW __UKL_ARGS);
        if (hit < SGW) return k + hit;
        seen += ukl_sg_sum(first ? 1u : 0u __UKL_ARGS);
    }
    return n;
}

UKL_INLINE int64_t clamp64(int64_t v, int64_t lo, int64_t hi) { return ukl_min(ukl_max(v, lo), hi); }

// The characters [a, b) a substring keeps of nc: `substr(s, i, n)` (f 3, SQLite's substr(s, i + 1, n)), SQLite's
// `substr` (f 7), `slice(s, start, end)` (f 4: negative from the end, clamped).
UKL_INLINE void substr_range(uint32_t f, int64_t n0, int64_t n1, int64_t nc, UKL_PRIVATE int64_t* a, UKL_PRIVATE int64_t* b) {
    if (f != 4) {
        int64_t p1 = f == 3 ? n0 + 1 : n0, p2 = n1;
        bool neg = p2 < 0;
        if (neg) p2 = -p2;
        if (p1 < 0) {
            p1 += nc;
            if (p1 < 0) { p2 = ukl_max(p2 + p1, (int64_t)0); p1 = 0; }
        } else if (p1 > 0) p1 -= 1;
        else if (p2 > 0) p2 -= 1;
        if (neg) {
            p1 -= p2;
            if (p1 < 0) { p2 += p1; p1 = 0; }
        }
        *a = clamp64(p1, 0, nc);
        *b = clamp64(p1 + p2, *a, nc);
    } else {
        *a = clamp64(n0 < 0 ? nc + n0 : n0, 0, nc);
        *b = clamp64(n1 < 0 ? nc + n1 : n1, 0, nc);
        if (*a > *b) *b = *a;
    }
}

// A function's kept range of x [from, to) (`TEXTFN_*` f of numbers n0, n1), by a SIMD group a byte a lane at a time: head
// to the first ".", dir to the last "/" (by a minimum and a maximum over the lanes), substrings by characters counted by
// sums over the lanes, their first bytes found by prefixes; the whole text for the rest. `high`: x has a byte past
// ASCII (`lower`'s, f 0).
UKL_INLINE void text_range(uint32_t f, Txt x, int64_t n0, int64_t n1, uint32_t lane, UKL_PRIVATE uint32_t* from, UKL_PRIVATE uint32_t* to,
                           UKL_PRIVATE bool* high __UKL_PARAMS) {
    uint32_t n = txt_len(x);
    *from = 0;
    *to = n;
    *high = false;
    if (f == 1) {
        for (uint32_t k = 0; k < n; k += SGW) {
            uint32_t d = ukl_sg_min(k + lane < n && txt_byte(x, k + lane) == (uint8_t)'.' ? lane : SGW __UKL_ARGS);
            if (d < SGW) { *to = k + d; break; }
        }
    } else if (f == 2) {
        int32_t last = -1;
        for (uint32_t k = 0; k < n; k += SGW) {
            int32_t d = sg_max_or_none(k + lane < n && txt_byte(x, k + lane) == (uint8_t)'/' ? (int32_t)lane : -1 __UKL_ARGS);
            if (d >= 0) last = (int32_t)k + d;
        }
        *to = last >= 0 ? (uint32_t)last : 0;
    } else if (f == 3 || f == 4 || f == 7) {
        int64_t nc = 0, a, b;
        for (uint32_t k = 0; k < n; k += SGW) nc += (int64_t)ukl_sg_sum(k + lane < n && (txt_byte(x, k + lane) & 0xc0) != 0x80 ? 1u : 0u __UKL_ARGS);
        substr_range(f, n0, n1, nc, &a, &b);
        *from = char_byte(x, n, a, lane __UKL_ARGS);
        *to = char_byte(x, n, b, lane __UKL_ARGS);
    } else if (f == 0) {
        for (uint32_t k = 0; k < n; k += SGW) if (ukl_sg_ballot(k + lane < n && txt_byte(x, k + lane) >= 0x80 __UKL_ARGS) != 0u) *high = true;
    }
}

// `replace_all` of a regex over x (its automata G, `text::table::Replacer`) by z, by a SIMD group a byte a lane at a time:
// each match's end by the forward automaton (the last match before it dies), its start by the reverse one run back
// from the end (the furthest match). The replaced text's length; written to o when `write`. f: the group's scratch
// (two rows a lane of the automata's states).
UKL_INLINE uint32_t rx_replace_txt(JSPACE const uint8_t* G, Txt x, Txt z, bool write, JSPACE uint8_t* o, JSPACE uint8_t* f,
                                   uint32_t lane __UKL_PARAMS) {
    JSPACE const uint32_t* h = (JSPACE const uint32_t*)G;
    uint32_t fS = h[0], fC = h[1], fdead = h[4], rS = h[5], rC = h[6], rdead = h[9];
    JSPACE const uint8_t* ft = G + h[10];
    JSPACE const uint8_t* rt = G + h[11];
    JSPACE const uint8_t* feoi = ft + 256 + fS * fC;
    JSPACE const uint8_t* facc = feoi + fS;
    JSPACE const uint8_t* reoi = rt + 256 + rS * rC;
    JSPACE const uint8_t* racc = reoi + rS;
    uint32_t n = txt_len(x), lz = txt_len(z);
    uint32_t pos = 0, w = 0;
    while (pos < n) {
        // The match's end: the forward automaton's last match before it dies (or at the end of the text).
        uint32_t st = pos == 0 ? h[2] : h[3], last = NONE;
        bool dead = false;
        for (uint32_t k = pos; k < n && !dead; k += SGW) {
            uint32_t m = ukl_min(SGW, n - k);
            uint32_t q = chunk_states(ft, fS, fC, x, (int32_t)k, 1, m, st, f, lane);
            uint32_t d = ukl_sg_min(lane < m && q == fdead ? lane : SGW __UKL_ARGS);
            int32_t lm = sg_max_or_none(lane < m && lane < d && facc[q] != 0 ? (int32_t)lane : -1 __UKL_ARGS);
            if (lm >= 0) last = k + (uint32_t)lm;
            if (d < SGW) dead = true;
            else st = ukl_sg_shuffle(q, m - 1 __UKL_ARGS);
        }
        if (!dead && facc[feoi[st]] != 0) last = n;
        if (last == NONE) break;
        uint32_t e = last;
        // Its start: the reverse automaton's furthest match back from the end, down to the byte before `pos`.
        uint32_t lo = pos > 0 ? pos - 1 : 0, first = NONE;
        uint32_t rs = e == n ? h[7] : h[8];
        bool rd = false;
        for (uint32_t k = e; k > lo && !rd;) {
            uint32_t m = ukl_min(SGW, k - lo);
            uint32_t q = chunk_states(rt, rS, rC, x, (int32_t)k - 1, -1, m, rs, f, lane);
            uint32_t d = ukl_sg_min(lane < m && q == rdead ? lane : SGW __UKL_ARGS);
            int32_t lm = sg_max_or_none(lane < m && lane < d && racc[q] != 0 ? (int32_t)lane : -1 __UKL_ARGS);
            if (lm >= 0) first = k - (uint32_t)lm;
            if (d < SGW) rd = true;
            else rs = ukl_sg_shuffle(q, m - 1 __UKL_ARGS);
            k -= m;
        }
        if (!rd && pos == 0 && racc[reoi[rs]] != 0) first = 0;
        if (first == NONE || first < pos) break;
        if (write) {
            for (uint32_t i = lane; i < first - pos; i += SGW) o[w + i] = txt_byte(x, pos + i);
            for (uint32_t i = lane; i < lz; i += SGW) o[w + first - pos + i] = txt_byte(z, i);
        }
        w += first - pos + lz;
        pos = e;
    }
    if (write) for (uint32_t i = lane; i < n - pos; i += SGW) o[w + i] = txt_byte(x, pos + i);
    return w + n - pos;
}

// Whether text test table `tab` (`text::table::Table`: S states of C classes, from `start`) accepts x, walked by a
// SIMD group a byte a lane at a time (`chunk_states`), the state after the end of text accepting.
UKL_INLINE bool txt_verdict(JSPACE const uint8_t* tab, uint32_t S, uint32_t C, uint32_t start, Txt x, JSPACE uint8_t* f,
                            uint32_t lane __UKL_PARAMS) {
    JSPACE const uint8_t* eoi = tab + 256 + S * C;
    JSPACE const uint8_t* acc = eoi + S;
    uint32_t n = txt_len(x), st = start;
    for (uint32_t k = 0; k < n; k += SGW) {
        uint32_t m = ukl_min(SGW, n - k);
        uint32_t q = chunk_states(tab, S, C, x, (int32_t)k, 1, m, st, f, lane);
        st = ukl_sg_shuffle(q, m - 1 __UKL_ARGS);
    }
    return acc[eoi[st]] != 0;
}

// `replace_all` of literal y (not empty; empty: x itself) in x by z, by a SIMD group: each lane tests whether a match
// starts at its byte (compared a word of eight at a time), the leftmost of a chunk taken, the next looked for past it
// (matches not overlapping). The replaced text's length; written to o when `write`.
UKL_INLINE uint32_t lit_replace_txt(Txt x, Txt y, Txt z, bool write, JSPACE uint8_t* o, uint32_t lane __UKL_PARAMS) {
    uint32_t n = txt_len(x), ly = txt_len(y), lz = txt_len(z), pos = 0, w = 0;
    while (ly > 0 && pos + ly <= n) {
        uint32_t m = NONE;
        for (uint32_t k = pos; k + ly <= n; k += SGW) {
            uint32_t at = k + lane;
            uint32_t d = ukl_sg_min(at + ly <= n && txt_same(x, at, y, 0, ly) ? lane : SGW __UKL_ARGS);
            if (d < SGW) { m = k + d; break; }
        }
        if (m == NONE) break;
        if (write) {
            for (uint32_t i = lane; i < m - pos; i += SGW) o[w + i] = txt_byte(x, pos + i);
            for (uint32_t i = lane; i < lz; i += SGW) o[w + m - pos + i] = txt_byte(z, i);
        }
        w += m - pos + lz;
        pos = m + ly;
    }
    if (write) for (uint32_t i = lane; i < n - pos; i += SGW) o[w + i] = txt_byte(x, pos + i);
    return w + n - pos;
}

// 10 to the power of `k` (k below 20).
UKL_INLINE uint64_t pow10_of(uint32_t k) {
    uint64_t p = 1ul;
    for (uint32_t i = 0; i < k && i < 19; i++) p *= 10ul;
    return p;
}

// Mode 10, a made text per row, by a SIMD group a row (decision 0038's chunked matching, per binding): before its
// scatter, `row_text` gives each row t of L its keep bit (counts[t]) and its value (V[t]), by op agg[0] & 15 of X
// (keys 0, 1, kind agg[1] & 15) and Y (keys 2, 3, kind agg[1] >> 4): 0 `cat`'s text of X and Y ("." between when X
// is not empty), 1 `str_concat`'s, 2 `replace_all` of regex G in X by Y, made into the arena (a bump of the group's
// lane 0; full: the stage's counter word's bit 1, the value -1); 3 a text test of X by table G (P: its states,
// classes, start), kept as agg[0] bit 8 wants; 5 the same test of a symbol, its verdict kept in the rolling cache VC
// (P[5]: the test's id). Symbols are read through the atoms directory D (decision 0478 step 2e); R is unused. P[0]: the
// groups (persistent, a threadgroup each), P[1]: the states a group's scratch holds.
UKL_INLINE void row_text_one(Longs L, JSPACE uint32_t* A, JSPACE const uint32_t* totals, JSPACE uint32_t* counters, JSPACE uint32_t* counts,
                         JSPACE int64_t* V, JSPACE const uint8_t* G, JSPACE uint8_t* scratch, JSPACE const uint32_t* P, JSPACE const uint8_t* D,
                         JSPACE uint8_t* VC, StageP s, uint32_t sg, uint32_t lane __UKL_PARAMS)
{
    uint32_t n = ukl_min(totals[s->in_slot], s->cap_in);
    uint32_t groups = P[0];
    for (uint32_t r = n + sg * SGW + lane; r <= s->cap_in; r += groups * SGW) counts[r] = 0;
    if (sg >= groups) return;
    JSPACE uint8_t* fs = scratch + (uint64_t)sg * 2 * SGW * P[1];
    uint32_t op = s->agg[0] & 15;
    bool want = ((s->agg[0] >> 8) & 1) != 0;
    if (op == 5) {
        // A text test of a symbol, its verdict in the one rolling cache VC (decision 0478 step 2d): each lane looks
        // up a row's, a SIMD group's rows at once; then the group walks table G over each missed symbol's bytes (read
        // through the atoms directory D), a lane a byte at a time, and keeps the verdict. A value no atom holds
        // (negative) fails.
        uint32_t test = P[5];
        for (uint32_t base = sg * SGW; base < n; base += groups * SGW) {
            uint32_t row = base + lane;
            bool has = row < n;
            int64_t v = has ? key_value(s, L, row, 0) : -1;
            bool sym = has && v >= 0 && v <= (int64_t)0xffffffffu;
            // An entry holds 64 symbols of the test, and a lookup that misses makes it. Lanes whose symbols share
            // one would wait on each other's making it, in their own group, which makes no progress while they
            // spin: they run out of spins, and each takes a second entry of the key, splitting its verdicts. So one
            // lane an entry looks first, its entry made and complete, and the lanes that share it look after.
            uint32_t entry = sym ? (uint32_t)v >> 6 : 0xffffffffu;
            uint32_t got = 1u;
            uint32_t todo = ukl_sg_ballot(sym __UKL_ARGS);
            while (todo != 0u) {
                uint32_t first = ukl_ctz32(todo);
                uint32_t its = ukl_sg_shuffle(entry, first __UKL_ARGS);
                uint32_t sharing = ukl_sg_ballot(sym && entry == its __UKL_ARGS);
                todo &= ~sharing;
                if (lane == first) got = clif_verdict_get(VC, 0ul, test, (uint32_t)v);
                // The entry's making, seen by the group (`todo` is the group's, so every lane is here).
                ukl_sg_barrier();
                if (lane != first && sym && entry == its) got = clif_verdict_get(VC, 0ul, test, (uint32_t)v);
            }
            uint32_t miss = ukl_sg_ballot(sym && got == 0u __UKL_ARGS);
            while (miss != 0u) {
                uint32_t l = ukl_ctz32(miss);
                miss &= miss - 1u;
                // A missed symbol is an atom's id (below 2^32): shuffled as a word.
                uint32_t id = ukl_sg_shuffle((uint32_t)v, l __UKL_ARGS);
                uint32_t len = clif_atoms_len(D, 0ul, id);
                bool held = len != 0xffffffffu;
                Txt x = txt_raw(D + (held ? clif_atoms_at(D, 0ul, id) : 0ul), held ? len : 0u);
                bool ok = held && txt_verdict(G, P[2], P[3], P[4], x, fs, lane __UKL_ARGS);
                if (lane == 0 && held) clif_verdict_put(VC, 0ul, test, id, ok ? 2u : 1u);
                if (lane == l) got = held ? (ok ? 2u : 1u) : 3u;
            }
            if (has) counts[row] = (uint32_t)((got == 2u) == want);
            // An atom the directory does not hold: the stage's counter's bit 2, and the stratum runs on the host.
            if (ukl_sg_ballot(got == 3u __UKL_ARGS) != 0u && lane == 0 && s->counter != NONE) ukl_atomic_or(&counters[s->counter], 4u);
        }
        return;
    }
    for (uint32_t row = sg; row < n; row += groups) {
        bool unheld = false;
        Txt x = txt_of(s, L, row, D, A, 0, s->agg[1] & 15, &unheld);
        if (unheld) {
            // A symbol the atoms directory does not hold: `TEXTFN_UNHELD`, the stratum on the host.
            if (lane == 0) {
                if (s->counter != NONE) ukl_atomic_or(&counters[s->counter], 4u);
                V[row] = -1;
                counts[row] = 0;
            }
            continue;
        }
        if (op == 3) {
            bool v = txt_verdict(G, P[2], P[3], P[4], x, fs, lane __UKL_ARGS);
            if (lane == 0) counts[row] = (uint32_t)(v == want);
            continue;
        }
        // A text kept by (functions P[5], source symbol key 7) in the rolling cache VC (`ROW_KEPT`, decision 0478
        // step 2e): one lane looks it up (an entry's offset from VC, what it found in the low bits); a kept text is
        // copied into the arena.
        bool keeps = (s->agg[0] & (1u << 9)) != 0;
        uint32_t ksym = 0;
        if (keeps) {
            int64_t kv = key_value(s, L, row, 7);
            keeps = kv >= 0 && kv <= (int64_t)0xffffffffu;
            ksym = (uint32_t)kv;
        }
        if (keeps) {
            uint64_t r = 0;
            if (lane == 0) r = clif_text_find(VC, 0ul, P[5], ksym);
            r = (uint64_t)ukl_sg_shuffle((uint32_t)r, 0u __UKL_ARGS) | ((uint64_t)ukl_sg_shuffle((uint32_t)(r >> 32), 0u __UKL_ARGS) << 32);
            if ((r & 3ul) == 0ul) {
                // Another group's writes: read coherently (`ukl/grid.h`'s rule; Q367: a plain load of them can be
                // stale, and the text read short, zeros past what was seen).
                UKL_COHERENT const uint8_t* e = (UKL_COHERENT const uint8_t*)(VC + (r & ~3ul));
                uint32_t len = *(UKL_COHERENT const uint32_t*)(e + 12) - 16u;
                uint32_t off = 0;
                if (lane == 0) off = ukl_atomic_add(A, len);
                off = ukl_sg_shuffle(off, 0u __UKL_ARGS);
                bool full = (uint64_t)off + len > ukl_atomic_load(&A[1]);
                if (!full) {
                    JSPACE uint8_t* o = (JSPACE uint8_t*)A + 16 + off;
                    for (uint32_t i = lane; i < len; i += SGW) o[i] = e[16 + i];
                }
                if (lane == 0) {
                    if (full && s->counter != NONE) ukl_atomic_or(&counters[s->counter], 1u);
                    V[row] = full ? -1 : arena_value(off, len);
                    counts[row] = 1;
                }
                continue;
            }
        }
        Txt y = txt_of(s, L, row, D, A, 2, s->agg[1] >> 4, &unheld), z = y;
        uint32_t f = (s->agg[0] >> 16) & 255;
        uint32_t lx = txt_len(x), len = 0, dot = 0, from = 0, to = 0, ndig = 0, pad = 0;
        uint64_t u = 0;
        bool neg = false;
        if (op == 0 || op == 1) {
            dot = op == 0 && lx > 0 ? 1 : 0;
            len = lx + dot + txt_len(y);
        } else if (op == 2) {
            len = rx_replace_txt(G, x, y, false, (JSPACE uint8_t*)A, fs, lane __UKL_ARGS);
        } else if (f == 5 || f == 11) {
            // to_string(n): its decimal digits, a lane each (at most 20). zero_pad(n, w): zeros after the sign up to
            // w columns (0 to 64, as the host's `{:0w$}`).
            int64_t n0 = key_value(s, L, row, 5);
            neg = n0 < 0;
            u = neg ? (uint64_t)(-(n0 + 1)) + 1 : (uint64_t)n0;
            ndig = 1;
            while (ndig < 20 && u >= pow10_of(ndig)) ndig++;
            len = ndig + (neg ? 1 : 0);
            if (f == 11) {
                uint32_t w = (uint32_t)clamp64(key_value(s, L, row, 6), 0, 64);
                pad = w > len ? w - len : 0;
                len += pad;
            }
        } else if (f == 6) {
            // replace_all of a literal pattern (key 2) by key 4's text.
            y = txt_of(s, L, row, D, A, 2, 0, &unheld);
            z = txt_of(s, L, row, D, A, 4, 0, &unheld);
            len = lit_replace_txt(x, y, z, false, (JSPACE uint8_t*)A, lane __UKL_ARGS);
        } else {
            bool high;
            text_range(f, x, key_value(s, L, row, 5), key_value(s, L, row, 6), lane, &from, &to, &high __UKL_ARGS);
            if (f == 0 && high) {
                // lower of a name past ASCII: Unicode's mapping is the host's.
                if (lane == 0) {
                    if (s->counter != NONE) ukl_atomic_or(&counters[s->counter], 2u);
                    V[row] = -1;
                    counts[row] = 1;
                }
                continue;
            }
            len = to - from;
        }
        uint32_t off = 0;
        if (lane == 0) off = ukl_atomic_add(A, len);
        off = ukl_sg_shuffle(off, 0u __UKL_ARGS);
        uint32_t cap = ukl_atomic_load(&A[1]);
        bool full = (uint64_t)off + len > cap;
        if (!full) {
            JSPACE uint8_t* o = (JSPACE uint8_t*)A + 16 + off;
            if (op == 2) rx_replace_txt(G, x, y, true, o, fs, lane __UKL_ARGS);
            else if (op <= 1) for (uint32_t i = lane; i < len; i += SGW) o[i] = i < lx ? txt_byte(x, i) : (i < lx + dot ? (uint8_t)'.' : txt_byte(y, i - lx - dot));
            else if (f == 6) lit_replace_txt(x, y, z, true, o, lane __UKL_ARGS);
            else if (f == 5 || f == 11) {
                uint32_t sign = neg ? 1 : 0;
                for (uint32_t i = lane; i < len; i += SGW) {
                    uint32_t d = i - sign - pad;
                    o[i] = neg && i == 0 ? (uint8_t)'-' : i < sign + pad ? (uint8_t)'0' : (uint8_t)('0' + (u / pow10_of(ndig - 1 - d)) % 10);
                }
            } else {
                for (uint32_t i = lane; i < len; i += SGW) {
                    uint8_t c = txt_byte(x, from + i);
                    if (f == 0 || f == 8) c = (c >= 'A' && c <= 'Z') ? (uint8_t)(c + 32) : c;
                    else if (f == 9) c = (c >= 'a' && c <= 'z') ? (uint8_t)(c - 32) : c;
                    o[i] = c;
                }
            }
        }
        if (keeps && !full && !unheld && len <= 4096u) {
            // Made: kept for the next reader. Its bytes in the arena, written by the group's lanes, copied into an
            // entry taken for them, then completed (another thread finds it pending until then).
            ukl_sg_barrier();
            uint64_t r = 0;
            if (lane == 0) r = clif_text_open(VC, 0ul, P[5], ksym, len);
            r = (uint64_t)ukl_sg_shuffle((uint32_t)r, 0u __UKL_ARGS) | ((uint64_t)ukl_sg_shuffle((uint32_t)(r >> 32), 0u __UKL_ARGS) << 32);
            if ((r & 3ul) == 1ul) {
                // Read by other groups: written coherently, as they read it.
                UKL_COHERENT uint8_t* e = (UKL_COHERENT uint8_t*)(VC + (r & ~3ul));
                JSPACE const uint8_t* o = (JSPACE const uint8_t*)A + 16 + off;
                for (uint32_t i = lane; i < len; i += SGW) e[16 + i] = o[i];
                ukl_sg_barrier();
                if (lane == 0) clif_cache_done(VC, 0ul, r & ~3ul);
            }
        }
        if (lane == 0) {
            if (full && s->counter != NONE) ukl_atomic_or(&counters[s->counter], 1u);
            if (unheld && s->counter != NONE) ukl_atomic_or(&counters[s->counter], 4u);
            V[row] = full ? -1 : arena_value(off, len);
            counts[row] = 1;
        }
    }
}

// Mode 10's rows out: those `row_text` kept, each its value (V's) in `bind_slot[0]` but for a test's.
UKL_INLINE void row_scatter_one(Longs L, Longs V, JSPACE uint32_t* totals, JSPACE const uint32_t* offsets, JSPACE int64_t* O, StageP s, uint32_t t)
{
    // Its offsets are its own: the level's scan's, less its first (`Batch::level`).
    uint32_t o0 = offsets[0];
    uint32_t n = ukl_min(totals[s->in_slot], s->cap_in);
    if (t == 0) totals[s->out_slot] = (offsets[n] - o0);
    if (t >= n) return;
    uint32_t at = (offsets[t] - o0);
    if ((offsets[t + 1] - o0) <= at || at >= s->cap_out) return;
    for (uint32_t k = 0; k < s->nslots; k++) O[(uint64_t)k * s->cap_out + at] = L[(uint64_t)k * s->cap_in + t];
    // A test (a made text's, `ROW_TEST`; a symbol's, `ROW_VERDICT`) binds nothing: its rows pass as they are.
    uint32_t op = s->agg[0] & 15;
    if (op != 3 && op != 5) O[(uint64_t)s->bind_slot[0] * s->cap_out + at] = V[t];
}

// Rows copied (decision 0325 step 5): `n` rows of `ncols` columns (as many as slot `count_slot` of `totals` says, at
// most `n`; all `n` when it is NONE), column k of the destination from source column `src[k]` (or the constant
// `konst[k]` where it is NONE), into rows `dst_off..`. Each side is a binding table (column-major, its stride; its
// offset 0) or a relation in a block: read through the reads written once (`clif_rel_get`, the relation's descriptor
// at `src_at`), written through them (`clif_rows_at`, its rows' descriptor at `dst_rows_at`).
typedef struct Copy {
    int64_t konst[16];
    uint32_t src[16];
    // `src_from`: a source relation's first row (`DevRel::from`): its row `t` is its id `src_from + t`.
    uint32_t n, ncols, src_stride, dst_stride, dst_off, count_slot, src_from, pad1;
    // Where its rows go past `dst_off`: when `flags & 1`, past a word an earlier phase wrote (`sum_one`, rows end to
    // end); when `flags & 2`, past the destination's rows as the device claimed them (`clif_rows_len`, a relation grown
    // on the device: decision 0603 step 3).
    JSPACE const uint32_t* off;
    uint64_t src_at, dst_rows_at;
    UKL_GLOBAL const ViewDir* v_dir;
    uint32_t r_view;
    uint32_t flags;
} Copy;
UKL_STATIC_ASSERT(sizeof(Copy) == 264, "Copy: size");
UKL_STATIC_ASSERT(UKL_OFFSETOF(Copy, v_dir) == 248, "Copy.v_dir");

UKL_INLINE void rows_copy_one(JSPACE const uint8_t* S, JSPACE uint8_t* D, JSPACE const uint32_t* totals, JSPACE const Copy* c, JSPACE const uint8_t* S_far, uint32_t t)
{
    uint32_t n = c->count_slot == NONE ? c->n : ukl_min(totals[c->count_slot], c->n);
    if (t >= n) return;
    uint32_t at = c->dst_off + ((c->flags & 1u) != 0u ? *c->off : 0u) + ((c->flags & 2u) != 0u ? clif_rows_len((JSPACE const uint8_t*)D, c->dst_rows_at) : 0u) + t;
    uint32_t memo = NONE;
    for (uint32_t k = 0; k < c->ncols && k < 16; k++) {
        uint32_t from = c->src[k];
        int64_t v = from == NONE ? c->konst[k]
                  : c->r_view != 0u ? vread(c->r_view, c->v_dir, t, from, &memo)
                  : c->src_at == 0ul ? ((JSPACE const int64_t*)S)[(uint64_t)from * c->src_stride + t]
                  : (int64_t)clif_rel_get(S, c->src_at, c->src_from + t, from, (uint64_t)(S_far - S));
        if (c->dst_rows_at == 0ul) ((JSPACE int64_t*)D)[(uint64_t)k * c->dst_stride + at] = v;
        else clif_rows_put((JSPACE const uint8_t*)D, c->dst_rows_at, at, k, (uint64_t)v);
    }
}

// Slots set in place, in order: a later one may read an earlier one.
UKL_INLINE void stage_map_one(JSPACE int64_t* B, JSPACE const uint32_t* totals, StageP s, uint32_t t)
{
    uint32_t n = ukl_min(totals[s->in_slot], s->cap_in);
    if (t >= n) return;
    for (uint32_t b = 0; b < s->nbinds && b < 16; b++) {
        uint32_t k = s->bind_idx[b];
        int64_t v;
        if (s->bind_kind[b] == 1) {
            v = parval(s, k, B, t);
        } else {
            v = B[(uint64_t)s->col_idx[k] * s->cap_in + t];
            if (s->col_doc[k] != 0) v = v >> 32;
        }
        B[(uint64_t)s->bind_slot[b] * s->cap_in + t] = v;
    }
}

// A join from one binding (a rule's first table): a thread per candidate row, not one thread walking them all.
UKL_INLINE void scan_count_one(Longs L, Longs R_rows, JSPACE const uint8_t* R_far, JSPACE uint32_t* counters, JSPACE uint32_t* counts, JSPACE const uint32_t* totals, StageP s, uint32_t r)
{
    RelB R = rel_b(R_rows, R_far);
    if (r > s->nr) return;
    // Past R's rows (its length on the device, at most `nr`): no candidate, a count of none.
    if (r >= stage_rows(s, R) || totals[s->in_slot] == 0) { counts[r] = 0; return; }
    int64_t kv[8];
    for (uint32_t i = 0; i < s->nkeys && i < 8; i++) kv[i] = s->key_kind[i] == 1 ? L[(uint64_t)s->key_slot[i] * s->cap_in] : s->key_const[i];
    uint32_t c = 0;
    // Thread `r`'s row: the relation's `r_from + r` (its rows from `r_from`).
    uint32_t id = s->r_from + r;
    if (matches(s, R, id, kv)) {
        uint64_t v = s->nops > 0 ? eval(s, L, 0, R, id) : 0;
        if (s->counter != NONE) {
            ukl_atomic_add(&counters[s->counter], 1u);
            for (uint32_t m = 0; m < s->npassed && m < 16; m++) {
                if (s->passed[m] == NONE || out_bit(s, v, s->passed[m])) ukl_atomic_add(&counters[s->counter + 1 + m], 1u);
            }
        }
        c = (uint32_t)(s->last == NONE || out_bit(s, v, s->last));
    }
    counts[r] = c;
}

UKL_INLINE void scan_scatter_one(Longs L, Longs R_rows, JSPACE const uint8_t* R_far, JSPACE uint32_t* totals, JSPACE const uint32_t* offsets, JSPACE int64_t* O, StageP s, uint32_t r)
{
    RelB R = rel_b(R_rows, R_far);
    // Its offsets are its own: the level's scan's, less its first (`Batch::level`).
    uint32_t o0 = offsets[0];
    uint32_t rows = stage_rows(s, R);
    if (r == 0) totals[s->out_slot] = (offsets[rows] - o0);
    if (r >= rows) return;
    uint32_t at = (offsets[r] - o0);
    if ((offsets[r + 1] - o0) > at && at < s->cap_out) write_row(s, L, 0, R, s->r_from + r, O, at);
}

// A rule's head rows made distinct: each row claims a place in an open-addressed table by its columns' hash (the
// least row index of rows equal to it wins), and a row is kept when it holds its place. The kept rows keep their order.
// `cap`: its rows' table's stride; `ocap`: its distinct rows' (a table its size script placed: as many as they are);
// `places`: its places, `mask + 1` (its clear's count).
typedef struct Dedup { uint32_t cap; uint32_t in_slot; uint32_t out_slot; uint32_t ncols; uint32_t mask; uint32_t cols[16]; uint32_t ocap; uint32_t places; } Dedup;
UKL_STATIC_ASSERT(sizeof(Dedup) == 92, "Dedup: size");
typedef JSPACE const Dedup* DedupP;

UKL_INLINE bool same_row(DedupP d, Longs T, uint32_t a, uint32_t b) {
    for (uint32_t c = 0; c < d->ncols && c < 16; c++) if (T[(uint64_t)d->cols[c] * d->cap + a] != T[(uint64_t)d->cols[c] * d->cap + b]) return false;
    return true;
}

UKL_INLINE uint32_t row_hash(DedupP d, Longs T, uint32_t x) {
    uint64_t h = KEY_SEED;
    for (uint32_t c = 0; c < d->ncols && c < 16; c++) h = key_mix(h, T[(uint64_t)d->cols[c] * d->cap + x]);
    return (uint32_t)h & d->mask;
}

UKL_INLINE void dedup_clear_one(JSPACE uint32_t* P, DedupP d, uint32_t i)
{
    if (i <= d->mask) P[i] = 0xffffffffu;
}

UKL_INLINE void dedup_claim_one(Longs T, JSPACE const uint32_t* totals, JSPACE uint32_t* P, DedupP d, uint32_t x)
{
    uint32_t n = ukl_min(totals[d->in_slot], d->cap);
    if (x >= n) return;
    uint32_t at = row_hash(d, T, x);
    // Bounded: a place at a time.
    for (uint32_t k = 0; k <= d->mask; k++) {
        uint32_t seen = ukl_atomic_cas(&P[at], 0xffffffffu, x);
        if (seen == 0xffffffffu) return;
        if (same_row(d, T, seen, x)) { ukl_atomic_min(&P[at], x); return; }
        at = (at + 1) & d->mask;
    }
}

UKL_INLINE void dedup_mark_one(Longs T, JSPACE const uint32_t* totals, JSPACE const uint32_t* P, JSPACE uint32_t* counts, DedupP d, uint32_t x)
{
    if (x > d->cap) return;
    uint32_t n = ukl_min(totals[d->in_slot], d->cap);
    if (x >= n) { counts[x] = 0; return; }
    uint32_t at = row_hash(d, T, x);
    uint32_t keep = 0;
    for (uint32_t k = 0; k <= d->mask; k++) {
        uint32_t y = P[at];
        if (y == 0xffffffffu) break;
        if (y == x) { keep = 1; break; }
        if (same_row(d, T, y, x)) break;
        at = (at + 1) & d->mask;
    }
    counts[x] = keep;
}

UKL_INLINE void dedup_scatter_one(Longs T, JSPACE uint32_t* totals, JSPACE const uint32_t* offsets, JSPACE int64_t* O, DedupP d, uint32_t x)
{
    // Its offsets are its own: the level's scan's, less its first (`Batch::level`).
    uint32_t o0 = offsets[0];
    // Its rows' counts alone: past them, a slot may hold another round's (a phase's items are its rows', 0603 step 5).
    uint32_t n = ukl_min(totals[d->in_slot], d->cap);
    if (x == 0) totals[d->out_slot] = (offsets[n] - o0);
    if (x >= n) return;
    uint32_t at = (offsets[x] - o0);
    if ((offsets[x + 1] - o0) == at) return;
    if (at >= d->ocap) return;
    for (uint32_t c = 0; c < d->ncols && c < 16; c++) O[(uint64_t)c * d->ocap + at] = T[(uint64_t)d->cols[c] * d->cap + x];
}

// ---- A batch's jobs (decisions 0601, 0603): its levels' work, run by its program (`join_run`). ----
//
// A batch queues its stages, maps, text rows, dedups, copies and indexes (`Batch::queue`), a level of them between two
// dependencies: a stratum's rules' stages at one depth, its heads' dedups. A job's buffers are reached by their
// device addresses (`Job`), as a view's directory is; its counts lie in the program's one buffer of counts from
// `base` (its `n` values), which its level's scan makes offsets, each job's its own less its first (`o0`).
typedef struct Job {
    Longs L;
    Longs R;
    JSPACE uint32_t* totals;
    JSPACE uint32_t* counters;
    JSPACE int64_t* O;
    JSPACE uint32_t* A;
    JSPACE const uint8_t* D;
    JSPACE const uint8_t* F;
    Longs W[3];
    JSPACE const uint8_t* G;
    JSPACE uint8_t* S;
    JSPACE uint8_t* VC;
    JSPACE int64_t* V;
    JSPACE uint32_t* H;
    StageP s;
    StageP ws;
    StageP bs;
    DedupP dd;
    JSPACE const uint32_t* P;
    uint32_t base, n;
    // An index's first bucket and first key in its level's sort (`ix_key_one`).
    uint32_t kb, eb;
    // A count an earlier phase wrote (a lattice fold's rows: `LatP::pad & 1`).
    JSPACE const uint32_t* cnt;
    // Where its size script placed its tables in the arena (decision 0603 step 5), each its offset and one (0: none,
    // the pointer's): `L` and `O`, a row's values `V` (8 bytes a unit), a dedup's places `H` (4 bytes).
    uint32_t l_at, o_at, v_at, h_at;
    // The blocks the far bases of the relations it reads through `clif_rel_get` lie in (decision 0353 step 6, `RelB`):
    // `RF` the stage's `R`'s (a copy's or an index's, `L`'s), `WF` the witness probes'. 0: the relation's own block.
    JSPACE const uint8_t* RF;
    JSPACE const uint8_t* WF[3];
} Job;
UKL_STATIC_ASSERT(sizeof(Job) == 240, "Job: size");
// The words of a job's descriptor its level's size script writes: `base`, `l_at`, `o_at`, `v_at`, `h_at`.
#define JOB_BASE_WORD 42u
#define JOB_AT_WORD 48u


// A relation's index built on the device (decision 0325 step 5): each row's bucket, its key's hash (`key_hash`, as
// the host's builder and every probe hash it) masked. A view read in place (decision 0353 step 4d) is read through its
// directory (`dir`, `kind`; kind 0: a relation).
// `ncols`' bit 31 (`IX_LIVE`): its rows are its relation's length on the device (`clif_rel_len`) past `from`, at
// most `n`; a key past them is the index's own last bucket (`mask + 1`), which sorts after its keys and places none.
#define IX_LIVE 0x80000000u
typedef struct IxP {
    uint32_t n;
    uint32_t ncols;
    uint64_t at;
    uint64_t mask;
    uint32_t cols[8];
    UKL_GLOBAL const ViewDir* dir;
    uint64_t kind;
    // The relation's first row: the index is of its rows `from..from + n`, by their ids (a fixpoint's delta).
    uint32_t from, pad;
} IxP;
UKL_STATIC_ASSERT(sizeof(IxP) == 80, "IxP: size");
UKL_STATIC_ASSERT(UKL_OFFSETOF(IxP, dir) == 56, "IxP.dir");

// Its keys are the level's (`Program`, decision 0603): every index of the level sorted at once, each one's buckets
// from its first, `kb`; its rows' keys from its first, `eb`, each with its place among them (the sort's values).
// An index's rows from `from`: `n`, or a live one's relation's length on the device past `from`, at most `n`
// (`IX_LIVE`).
UKL_INLINE uint32_t ix_rows(JSPACE const uint8_t* B, JSPACE const IxP* p) {
    if ((p->ncols & IX_LIVE) == 0u) return p->n;
    uint32_t len = clif_rel_len(B, p->at);
    return len > p->from ? ukl_min(len - p->from, p->n) : 0u;
}

UKL_INLINE void ix_key_one(JSPACE const uint8_t* B, JSPACE uint32_t* out, JSPACE uint32_t* places, JSPACE const IxP* p, JSPACE const uint8_t* B_far, uint32_t kb, uint32_t eb, uint32_t t)
{
    if (t >= p->n) return;
    places[eb + t] = eb + t;
    // Past a live index's rows: its own last bucket, after its keys.
    if (t >= ix_rows(B, p)) { out[eb + t] = kb + (uint32_t)p->mask + 1u; return; }
    uint64_t h = KEY_SEED;
    uint32_t memo = NONE;
    for (uint32_t i = 0; i < (p->ncols & ~IX_LIVE) && i < 8; i++)
        h = key_mix(h, p->kind != 0ul ? vread((uint32_t)p->kind, p->dir, t, p->cols[i], &memo) : (int64_t)clif_rel_get(B, p->at, p->from + t, p->cols[i], (uint64_t)(B_far - B)));
    out[eb + t] = kb + (uint32_t)(h & p->mask);
}

// The index's rows and buckets written into its relation's block, from the level's keys sorted (stably) with their
// places: its sorted place `t` is the level's `eb + t`, its row's id the place it came from less `eb`, past the
// relation's first row `from` (so a bucket's rows are in id order, as the host's builder places them). A place
// whose bucket is not the one before's starts it, and sets the empty buckets' before it; the last place the rest.
// `offs` the buckets in the block, `rows` the rows.
UKL_INLINE void ix_place_one(JSPACE const uint8_t* B, JSPACE const uint32_t* keys, JSPACE const uint32_t* places, JSPACE uint32_t* offs, JSPACE uint32_t* rows,
                             JSPACE const IxP* p, uint32_t kb, uint32_t eb, uint32_t t)
{
    uint32_t n = ix_rows(B, p), cap = (uint32_t)p->mask + 1u;
    // No rows: every bucket empty.
    if (n == 0u && t == 0u) for (uint32_t x = 0u; x <= cap; x++) offs[x] = 0u;
    if (t >= n) return;
    rows[t] = p->from + places[eb + t] - eb;
    uint32_t b = keys[eb + t] - kb;
    uint32_t from = t == 0 ? 0u : keys[eb + t - 1u] - kb + 1u;
    for (uint32_t x = from; x <= b; x++) offs[x] = t;
    if (t == n - 1u) for (uint32_t x = b + 1u; x <= cap; x++) offs[x] = n;
}


// A lattice relation's rounds on the device (decision 0124): a round's rows `U` (a table of `k` slots: the key's
// `nkeys` columns, then the value) folded by key into the lattice's relation `R` itself (its `k` columns, `had` rows
// held: one live row a key), through its key map `H` (decision 0384 step 5, `setfix::keys`), which lies in a block at
// `h_at`: a slot a key, three words: the key's row (EMPTY: none), its changes, its round. `P` groups `U`'s rows by
// key (each place the least row of its key), `best` the key's chosen row (min and max select one of their values),
// `flags` a flat key's conflict. A held key's row is updated where it lies; a new key's row is written past `R`'s
// rows (at `had` on, room the host reserved), and its slot put in `H`. Each changed key's row (key and value) goes to
// `D`, the next round's delta: `counters[0]` of them, `counters[1]` new. `level`: the round, written to a changed or
// new key's slot where the relation keeps levels (decision 0311); 0: none.
typedef struct LatP { int64_t top; uint32_t n; uint32_t had; uint32_t nkeys; uint32_t code; uint32_t after; uint32_t pmask; uint32_t hmask; uint32_t level;
                      uint32_t omask; uint32_t counted; uint64_t r_at, r_rows_at, h_at, h0_at; } LatP;
UKL_REFLECT_STRUCT(LatP, top, n, had, nkeys, code, after, pmask, hmask, level, omask, counted, r_at, r_rows_at, h_at, h0_at)
UKL_STATIC_ASSERT(sizeof(LatP) == 80, "LatP: size");

// The relation `R`'s row `row` in column `c`, and the place to write it: `R` is a relation in its block
// (decision 0325 step 5), its descriptor at `r_at`, its rows' at `r_rows_at`; written through the writer written
// once, bounded by its chunks (decision 0463).
UKL_INLINE int64_t lat_r(JSPACE const uint8_t* R, UKL_PRIVATE const LatP* p, uint32_t row, uint32_t c) {
    // The device's own relation, one part in its block: no far base.
    return (int64_t)clif_rel_get(R, p->r_at, row, c, 0ul);
}
UKL_INLINE void lat_put(JSPACE uint8_t* R, UKL_PRIVATE const LatP* p, uint32_t row, uint32_t c, int64_t v) {
    clif_rows_put((JSPACE const uint8_t*)R, p->r_rows_at, row, c, (uint64_t)v);
}

UKL_INLINE uint32_t lat_hash(UKL_PRIVATE const int64_t* key, uint32_t nk, uint32_t mask) {
    return (uint32_t)key_hash(key, nk) & mask;
}

UKL_INLINE bool lat_same(Longs T, uint32_t stride, uint32_t a, uint32_t b, uint32_t nk) {
    for (uint32_t c = 0; c < nk && c < 8; c++) if (T[(uint64_t)c * stride + a] != T[(uint64_t)c * stride + b]) return false;
    return true;
}

UKL_INLINE void lat_clear_one(JSPACE uint32_t* P, JSPACE uint32_t* best, JSPACE uint32_t* flags, JSPACE const LatP* pp, uint32_t i)
{
    LatP p;
    JREAD(LatP, p, pp);
    if (i > p.pmask) return;
    P[i] = 0xffffffffu;
    best[i] = 0xffffffffu;
    flags[i] = 0;
}

// The key map's slot `i` emptied (a map new, or grown).
UKL_INLINE void lat_hclear_one(JSPACE uint8_t* HB, JSPACE const LatP* pp, uint32_t i)
{
    LatP p;
    JREAD(LatP, p, pp);
    if (i > p.hmask) return;
    JSPACE uint32_t* H = (JSPACE uint32_t*)(HB + p.h_at);
    H[3 * i] = 0xffffffffu;
    H[3 * i + 1] = 0;
    H[3 * i + 2] = 0;
}

// The old map's slot `s` (at `h0_at` in `OB`, `omask + 1` slots) into the new one (grown: every key placed again, its
// changes and round with it); its key read in `R`'s row.
UKL_INLINE void lat_rehash_one(JSPACE const uint8_t* R, JSPACE const uint8_t* OB, JSPACE uint8_t* HB, JSPACE const LatP* pp, uint32_t s)
{
    LatP p;
    JREAD(LatP, p, pp);
    if (s > p.omask) return;
    JSPACE const uint32_t* O = (JSPACE const uint32_t*)(OB + p.h0_at);
    uint32_t t = O[3 * s];
    if (t == 0xffffffffu) return;
    JSPACE uint32_t* H = (JSPACE uint32_t*)(HB + p.h_at);
    int64_t key[8];
    for (uint32_t c = 0; c < p.nkeys && c < 8; c++) key[c] = lat_r(R, &p, t, c);
    uint32_t at = lat_hash(key, p.nkeys, p.hmask);
    // Bounded: a place at a time.
    for (uint32_t k = 0; k <= p.hmask; k++) {
        if (ukl_atomic_cas(&H[3 * at], 0xffffffffu, t) == 0xffffffffu) {
            ukl_atomic_store(&H[3 * at + 1], O[3 * s + 1]);
            ukl_atomic_store(&H[3 * at + 2], O[3 * s + 2]);
            return;
        }
        at = (at + 1) & p.hmask;
    }
}

UKL_INLINE void lat_claim_one(Longs U, JSPACE uint32_t* P, JSPACE const uint32_t* cnt, JSPACE const LatP* pp, uint32_t x)
{
    LatP p;
    JREAD(LatP, p, pp);
    // Its rows: `n` (the stride of `U`'s columns), or as many as the word an earlier phase wrote (`counted`).
    if (x >= ((p.counted & 1u) != 0u ? ukl_min(*cnt, p.n) : p.n)) return;
    int64_t key[8];
    for (uint32_t c = 0; c < p.nkeys && c < 8; c++) key[c] = U[(uint64_t)c * p.n + x];
    uint32_t at = lat_hash(key, p.nkeys, p.pmask);
    for (uint32_t k = 0; k <= p.pmask; k++) {
        uint32_t seen = ukl_atomic_cas(&P[at], 0xffffffffu, x);
        if (seen == 0xffffffffu) return;
        if (lat_same(U, p.n, seen, x, p.nkeys)) { ukl_atomic_min(&P[at], x); return; }
        at = (at + 1) & p.pmask;
    }
}

// The place of row `x`'s key in `P` (claimed: it is there).
UKL_INLINE uint32_t lat_place(Longs U, JSPACE const uint32_t* P, UKL_PRIVATE const LatP* p, uint32_t x) {
    int64_t key[8];
    for (uint32_t c = 0; c < p->nkeys && c < 8; c++) key[c] = U[(uint64_t)c * p->n + x];
    uint32_t at = lat_hash(key, p->nkeys, p->pmask);
    for (uint32_t k = 0; k <= p->pmask; k++) {
        uint32_t y = P[at];
        if (y == 0xffffffffu) return 0xffffffffu;
        if (lat_same(U, p->n, y, x, p->nkeys)) return at;
        at = (at + 1) & p->pmask;
    }
    return 0xffffffffu;
}

// Code 3 (`shortlex_min`, decision 0307): whether arena text `a` is before `b`, by their characters, then their
// bytes (as `ShortlexMin`: `(chars, bytes)`), a word of eight at a time.
UKL_INLINE bool lat_text_less(JSPACE uint32_t* A, int64_t a, int64_t b) {
    uint64_t ua = (uint64_t)a, ub = (uint64_t)b;
    Txt x = txt_raw(arena_bytes(A) + (uint32_t)((ua & 0x7ffffffffffffffful) >> 24), (uint32_t)(ua & 0xfffffful));
    Txt y = txt_raw(arena_bytes(A) + (uint32_t)((ub & 0x7ffffffffffffffful) >> 24), (uint32_t)(ub & 0xfffffful));
    uint32_t cx = txt_chars(x), cy = txt_chars(y);
    if (cx != cy) return cx < cy;
    uint32_t lx = txt_len(x), ly = txt_len(y), m = ukl_min(lx, ly);
    for (uint32_t at = 0; at < m; at += 8) {
        uint64_t u = txt_word(x, at, m), v = txt_word(y, at, m);
        if (u != v) return u < v;
    }
    return lx < ly;
}

// Whether value `a` (of row `ra`) is chosen over `b` (of `rb`): the top absorbs; min the least, max the greatest,
// shortlex the least text (code 3, over the arena `A`); a tie to the first row.
UKL_INLINE bool lat_better(UKL_PRIVATE const LatP* p, JSPACE uint32_t* A, int64_t a, uint32_t ra, int64_t b, uint32_t rb) {
    if (b == p->top) return false;
    if (a == p->top) return true;
    if (a == b) return ra < rb;
    if (p->code == 3) {
        if (lat_text_less(A, a, b)) return true;
        return !lat_text_less(A, b, a) && ra < rb;
    }
    return p->code == 0 ? a < b : a > b;
}

UKL_INLINE void lat_best_one(Longs U, JSPACE const uint32_t* P, JSPACE uint32_t* best, JSPACE uint32_t* flags, JSPACE uint32_t* A, JSPACE const uint32_t* cnt,
                         JSPACE const LatP* pp, uint32_t x)
{
    LatP p;
    JREAD(LatP, p, pp);
    // Its rows: `n` (the stride of `U`'s columns), or as many as the word an earlier phase wrote (`counted`).
    if (x >= ((p.counted & 1u) != 0u ? ukl_min(*cnt, p.n) : p.n)) return;
    uint32_t s = lat_place(U, P, &p, x);
    if (s == 0xffffffffu) return;
    int64_t v = U[(uint64_t)p.nkeys * p.n + x];
    if (p.code == 2) {
        if (v != U[(uint64_t)p.nkeys * p.n + P[s]]) ukl_atomic_or(&flags[s], 1u);
        return;
    }
    uint32_t cur = ukl_atomic_load(&best[s]);
    for (uint32_t k = 0; k < 4 * p.n + 8; k++) {
        if (cur != 0xffffffffu && !lat_better(&p, A, v, x, U[(uint64_t)p.nkeys * p.n + cur], cur)) return;
        uint32_t seen = ukl_atomic_cas(&best[s], cur, x);
        if (seen == cur) return;
        cur = seen;
    }
}

// The join of two present values (`code`: 0 min, 1 max, 2 flat, 3 shortlex over the arena `A`, a tie to `a`), the
// top absorbing.
UKL_INLINE int64_t lat_lub(UKL_PRIVATE const LatP* p, JSPACE uint32_t* A, int64_t a, int64_t b) {
    if (a == p->top || b == p->top) return p->top;
    if (p->code == 3) return lat_text_less(A, b, a) ? b : a;
    if (p->code == 0) return ukl_min(a, b);
    if (p->code == 1) return ukl_max(a, b);
    return a == b ? a : p->top;
}

// A key changed past `after` times: min's or max's value moving on is its top (a finite chain); flat's and
// shortlex's are kept (finite lattices: `widen` keeps the route, decision 0124).
UKL_INLINE int64_t lat_widen(UKL_PRIVATE const LatP* p, int64_t old, int64_t now) {
    if (p->code == 0 && now < old) return p->top;
    if (p->code == 1 && now > old) return p->top;
    return now;
}

UKL_INLINE void lat_merge_one(Longs U, JSPACE const uint32_t* P, JSPACE const uint32_t* best, JSPACE const uint32_t* flags, JSPACE uint8_t* R, JSPACE uint8_t* HB,
                          JSPACE int64_t* D, JSPACE uint32_t* counters, JSPACE uint32_t* A, JSPACE const uint32_t* round, JSPACE const LatP* pp, uint32_t s)
{
    // Its parameter block, a private copy (helpers take its address).
    LatP p;
    JREAD(LatP, p, pp);
    // A relation grown on the device (`counted & 2`): its rows held are its length as the device claimed it; its
    // round (`counted & 4`) the program's round word (decision 0603 step 3).
    if ((p.counted & 2u) != 0u) p.had = clif_rows_len((JSPACE const uint8_t*)R, p.r_rows_at);
    if ((p.counted & 4u) != 0u) p.level = *round;
    JSPACE uint32_t* H = (JSPACE uint32_t*)(HB + p.h_at);
    if (s > p.pmask) return;
    uint32_t rep = P[s];
    if (rep == 0xffffffffu) return;
    uint32_t r = (p.code == 2 || best[s] == 0xffffffffu) ? rep : best[s];
    int64_t v = U[(uint64_t)p.nkeys * p.n + r];
    if (p.code == 2 && flags[s] != 0) v = p.top;
    int64_t key[8];
    for (uint32_t c = 0; c < p.nkeys && c < 8; c++) key[c] = U[(uint64_t)c * p.n + r];
    uint32_t at = lat_hash(key, p.nkeys, p.hmask);
    uint32_t held = 0xffffffffu;
    for (uint32_t i = 0; i <= p.hmask; i++) {
        uint32_t h = ukl_atomic_load(&H[3 * at]);
        if (h == 0xffffffffu) break;
        // A row past `had` is a new key's this round (another key's: each key is one place of `P`).
        bool same = h < p.had;
        for (uint32_t c = 0; same && c < p.nkeys && c < 8; c++) same = lat_r(R, &p, h, c) == key[c];
        if (same) { held = h; break; }
        at = (at + 1) & p.hmask;
    }
    if (held != 0xffffffffu) {
        int64_t o = lat_r(R, &p, held, p.nkeys);
        int64_t m = lat_lub(&p, A, o, v);
        if (m == o) return;
        uint32_t changes = ukl_atomic_load(&H[3 * at + 1]);
        if (p.after != 0xffffffffu && changes >= p.after) {
            m = lat_widen(&p, o, m);
            if (m == o) return;
        }
        lat_put(R, &p, held, p.nkeys, m);
        ukl_atomic_store(&H[3 * at + 1], changes + 1);
        if (p.level != 0) ukl_atomic_store(&H[3 * at + 2], p.level);
        v = m;
    } else {
        uint32_t a = ukl_atomic_add(&counters[1], 1u);
        uint32_t id = p.had + a;
        for (uint32_t c = 0; c < p.nkeys && c < 8; c++) lat_put(R, &p, id, c, key[c]);
        lat_put(R, &p, id, p.nkeys, v);
        uint32_t place = lat_hash(key, p.nkeys, p.hmask);
        for (uint32_t i = 0; i <= p.hmask; i++) {
            if (ukl_atomic_cas(&H[3 * place], 0xffffffffu, id) == 0xffffffffu) {
                ukl_atomic_store(&H[3 * place + 1], 1u);
                ukl_atomic_store(&H[3 * place + 2], p.level);
                break;
            }
            place = (place + 1) & p.hmask;
        }
    }
    uint32_t d = ukl_atomic_add(&counters[0], 1u);
    for (uint32_t c = 0; c < p.nkeys && c < 8; c++) D[(uint64_t)c * p.n + d] = key[c];
    D[(uint64_t)p.nkeys * p.n + d] = v;
}

// Rows of several sources end to end (`Batch::append_rows`): each source's count (`src`) and its offset (`off`, the
// counts before it), and their total (`total`). One thread: a union has a source a rule.
typedef struct SumPart { JSPACE const uint32_t* src; JSPACE uint32_t* off; } SumPart;
typedef struct SumP { uint32_t m, pad; JSPACE uint32_t* total; SumPart part[1]; } SumP;
UKL_INLINE void sum_one(JSPACE const SumP* p, uint32_t t)
{
    if (t != 0u) return;
    uint32_t at = 0u;
    for (uint32_t i = 0u; i < p->m; i++) {
        *p->part[i].off = at;
        at += *p->part[i].src;
    }
    *p->total = at;
}

// A program's gate (`Batch::gate`): a table's rows (`count`, and `plus` too where `has`: a relation's rows and a
// round's new rows onto it) past its room (`cap`) stops the program at this phase
// (`ctl[6]`'s bit 2), before any phase after it writes what it would make from the short table: the host grows the
// table and runs the work again (decision 0540's rerun). A thread a table.
typedef struct GateCheck { JSPACE const uint32_t* count; JSPACE const uint32_t* plus; uint32_t cap, has; } GateCheck;
UKL_STATIC_ASSERT(sizeof(GateCheck) % 4 == 0, "GateCheck: whole words (JREAD)");
typedef struct GateP { uint32_t m, pad0, pad1, pad2; GateCheck check[1]; } GateP;
UKL_INLINE void gate_one(JSPACE const GateP* p, UKL_GLOBAL uint32_t* ctl, uint32_t t)
{
    if (t >= p->m) return;
    GateCheck c;
    JREAD(GateCheck, c, &p->check[t]);
    uint64_t n = (uint64_t)*c.count + (c.has != 0u ? (uint64_t)*c.plus : 0u);
    if (n > (uint64_t)c.cap) ukl_atomic_or(&ctl[6], 2u);
}

// A recursive component's round's end (`Batch::round_end`, decision 0603 step 3): one thread. Its new rows claimed
// and its next deltas' lengths set (`ops`, in order: 0 `*to += *from`, 1 `*to = *from`, 2 `to[0..n)` zeroed, 3
// `to[round] = *from`, a round's count logged by its round (`*round` before it is counted); 4 a count the round made,
// any of them non-zero going on; 5 `to[k] += from[k]` for `k < n`, counts summed over rounds); the round
// counted (`round`: the next round's number; and this launch's, `ctl[8]`); then on to the round after: the next template's first phase
// (`next`), as a jump (`ctl[7]`, the phase and one; its finisher empties that phase's count as it pushes it). With no
// new rows the program ends (`ctl[6]` bit 16); with a round past `max` next it stops (bit 4); after `until` rounds in this launch
// it yields (bit 8, `ctl[9]` the phase and one it goes on from): the host launches it again from there, so a launch's
// GPU time is a few rounds'.
typedef struct RoundOp { JSPACE uint32_t* to; JSPACE const uint32_t* from; uint32_t op, n; } RoundOp;
UKL_STATIC_ASSERT(sizeof(RoundOp) % 4 == 0, "RoundOp: whole words (JREAD)");
typedef struct RoundP { JSPACE uint32_t* round; uint32_t nops, max, until, next, pad0, pad1; RoundOp ops[1]; } RoundP;
UKL_INLINE void round_one(JSPACE const RoundP* p, UKL_GLOBAL uint32_t* ctl, uint32_t t)
{
    if (t != 0u) return;
    bool any = false;
    for (uint32_t i = 0u; i < p->nops; i++) if (p->ops[i].op == 4u && *p->ops[i].from != 0u) any = true;
    uint32_t cur = *p->round;
    for (uint32_t i = 0u; i < p->nops; i++) {
        RoundOp o;
        JREAD(RoundOp, o, &p->ops[i]);
        if (o.op == 0u) *o.to += *o.from;
        else if (o.op == 1u) *o.to = *o.from;
        else if (o.op == 2u) for (uint32_t k = 0u; k < o.n; k++) o.to[k] = 0u;
        else if (o.op == 3u && cur < o.n) o.to[cur] = *o.from;
        else if (o.op == 5u) for (uint32_t k = 0u; k < o.n; k++) o.to[k] += o.from[k];
    }
    *p->round = cur + 1u;
    ukl_fence_device();
    if (!any) { ukl_atomic_or(&ctl[6], 16u); ukl_atomic_store(&ctl[7], 0xFFFFFFFFu); return; }
    if (cur + 1u > p->max) { ukl_atomic_or(&ctl[6], 4u); ukl_atomic_store(&ctl[7], 0xFFFFFFFFu); return; }
    if (ukl_atomic_add(&ctl[8], 1u) + 1u >= p->until) {
        ukl_atomic_store(&ctl[9], p->next + 1u);
        ukl_atomic_or(&ctl[6], 8u);
        ukl_atomic_store(&ctl[7], 0xFFFFFFFFu);
        return;
    }
    ukl_atomic_store(&ctl[7], p->next + 1u);
}

#ifdef JOIN_PROGRAM
// A batch's program (`metal_join::Program`, decision 0603): its levels' work in one launch, a work queue whose items
// are continuations. Its scans and its indexes' sorts are phases too: the library's tile passes over its memory.
#include <ukl/workqueue.h>
#include <ukl/scan.h>
#define UKL_SCAN_NAME(f) f##_prog
#define UKL_SCAN_SPACE JSPACE
#include <ukl/body/scan_tile.h>
#include <ukl/radix.h>
#define UKL_RADIX_NAME(f) f##_u32_prog
#define UKL_RADIX_KEY uint32_t
#define UKL_RADIX_SPACE JSPACE
#include <ukl/body/radix_tile.h>

// What an item runs (`Program`'s `Item::what >> 24`).
#define PK_COPY 1u
#define PK_IX_KEY 2u
#define PK_RADIX_HIST 3u
#define PK_RADIX_SCATTER 4u
#define PK_IX_PLACE 5u
#define PK_DEDUP_CLEAR 6u
#define PK_DEDUP_CLAIM 7u
#define PK_MAP 8u
#define PK_STAGE_COUNT 9u
#define PK_SCAN_COUNT 10u
#define PK_WITNESS_COUNT 11u
#define PK_ROW_TEXT 12u
#define PK_DEDUP_MARK 13u
#define PK_SCAN_SUMS 14u
#define PK_SCAN_TILES 15u
#define PK_STAGE_SCATTER 16u
#define PK_SCAN_SCATTER 17u
#define PK_ROW_SCATTER 18u
#define PK_DEDUP_SCATTER 19u
// A lattice fold's passes (`lat_*_one`): its key map emptied, grown, its places emptied, claimed, the best value a
// key, merged into the relation.
#define PK_LAT_HCLEAR 20u
#define PK_LAT_REHASH 21u
#define PK_LAT_CLEAR 22u
#define PK_LAT_CLAIM 23u
#define PK_LAT_BEST 24u
#define PK_LAT_MERGE 25u
#define PK_SUM 26u
#define PK_GATE 27u
#define PK_ROUND 28u
#define PK_SIZE 29u

// An item: its kind and which job, scan level or sort pass (`kind << 24 | which`), its group in that, its phase, its
// segment and one (`Seg`; 0: none).
typedef struct Item { uint32_t what; uint32_t group; uint32_t phase; uint32_t seg; } Item;
UKL_STATIC_ASSERT(sizeof(Item) == 16, "Item: size");
// A job's items in its phase, as many as a count on the device needs (decision 0603 step 5): `ceil((*count + plus) /
// per)` of its `items` from `first`, at most them; all of them where `per` is 0 (a job of no count). A phase of
// segments pushes theirs, at least one item in all.
typedef struct Seg { JSPACE const uint32_t* count; uint32_t first, items, per, plus; } Seg;
UKL_STATIC_ASSERT(sizeof(Seg) == 24, "Seg: size");
UKL_INLINE uint32_t seg_items(UKL_GLOBAL const Seg* g)
{
    if (g->per == 0u) return g->items;
    uint64_t need = ((uint64_t)*g->count + g->plus + g->per - 1u) / g->per;
    return need < (uint64_t)g->items ? (uint32_t)need : g->items;
}

// A scan's level: its `n` values scanned in place, its tiles' sums (their offsets once scanned), whether it has them.
// A level a size script sizes (decision 0603 step 5) has its `n` and its values' first word in `in` (`at`, its arena
// there) set by it: read as words, coherent, as the script wrote them.
typedef struct ScanLevel { JSPACE uint32_t* in; JSPACE uint32_t* sums; uint32_t n; uint32_t offsets; uint32_t at; uint32_t sums_at; } ScanLevel;
#define SCAN_N_WORD 4u
#define SCAN_AT_WORD 6u
#define SCAN_SUMS_AT_WORD 7u
UKL_STATIC_ASSERT(sizeof(ScanLevel) == 32, "ScanLevel: size");
// A sort's pass: its keys and places in, its histograms (scanned: each digit's offset for each tile), out.
typedef struct SortPass {
    JSPACE uint32_t* keys;
    JSPACE uint32_t* values;
    JSPACE uint32_t* hist;
    JSPACE uint32_t* out_keys;
    JSPACE uint32_t* out_values;
    uint32_t n, shift, tiles, pad;
    uint64_t pad2;
} SortPass;
UKL_STATIC_ASSERT(sizeof(SortPass) == 64, "SortPass: size");
// The program's phases, its queue's capacity, and its first phase's items (the seeds).
// Its phases; its queue's room; its first phase (`first`, a launch from a round's) and that phase's items (`seeds`).
typedef struct ProgP { uint32_t phases; uint32_t capacity; uint32_t seeds; uint32_t first; } ProgP;
UKL_REFLECT_STRUCT(ProgP, phases, capacity, seeds, first)

// A level's sizes (decision 0603 step 5): one thread runs a script of `ops` (`Item::group` of them from
// `Item::what`'s index), over 64-bit registers `r`, in order. Each op's `k` its result's register, `x`/`y` its
// operands', `w` a word's address, `c` a constant:
//  0 `r[k] = w[0] + c`; 2 `r[k] = c`; 3 `r[k] = r[x] + r[y] + c`; 4 `r[k] = r[x] - r[y]` (0 below);
//  5 `r[k] = r[x] * c`; 6 `r[k] = ceil(r[x] / c)`; 7 `r[k] = min(r[x], r[y])`; 8 `r[k] = max(r[x], c)`;
// 13 `r[k]` the least power of two at least `max(r[x], c)`; 14 a check that the arena holds `c` units more past its
//    top (`w`, `y` its room): else the program stops, as a claim past it does;
//  9 a claim of `r[x]` bytes of the program's arena (16 a unit, `w` its top in units, `y` its room in them, `c` its
//    address): `r[k]` their address; past the room, the program stops (`ctl[6]`'s bits 2 and 32) and `r[k]` is
//    the arena's start;
// 11 `w[0] = r[k]`; 12 `r[k] = w[r[x]]`.
// Its writes are words of a job's descriptor and its parameters and of a scan level, which the phases after it read
// as words, coherent (a pointer of theirs is the host's; a size its offset).
typedef struct SizeOp { JSPACE uint32_t* w; uint64_t c; uint32_t op, k, x, y; } SizeOp;
UKL_STATIC_ASSERT(sizeof(SizeOp) == 32, "SizeOp: size");
UKL_INLINE void size_one(UKL_GLOBAL const SizeOp* ops, uint32_t n, UKL_GLOBAL uint32_t* ctl, uint32_t t)
{
    if (t != 0u) return;
    uint64_t r[16];
    for (uint32_t k = 0u; k < 16u; k++) r[k] = 0u;
    for (uint32_t i = 0u; i < n; i++) {
        SizeOp o = ops[i];
        uint32_t k = o.k & 15u, x = o.x & 15u, y = o.y & 15u;
        switch (o.op) {
            case 0u: r[k] = (uint64_t)*o.w + o.c; break;
            case 2u: r[k] = o.c; break;
            case 3u: r[k] = r[x] + r[y] + o.c; break;
            case 4u: r[k] = r[x] > r[y] ? r[x] - r[y] : 0u; break;
            case 5u: r[k] = r[x] * o.c; break;
            case 6u: r[k] = (r[x] + o.c - 1u) / o.c; break;
            case 7u: r[k] = r[x] < r[y] ? r[x] : r[y]; break;
            case 8u: r[k] = r[x] > o.c ? r[x] : o.c; break;
            case 9u: {
                uint64_t units = (r[x] + 15u) / 16u;
                uint32_t got = units > 0xFFFFFFFFu ? 0xFFFFFFFFu : (uint32_t)units;
                uint32_t old = ukl_atomic_add(o.w, got);
                bool full = (uint64_t)old + got > (uint64_t)o.y;
                if (full) ukl_atomic_or(&ctl[6], 2u | 32u);
                r[k] = full ? o.c : o.c + 16u * (uint64_t)old;
                break;
            }
            case 11u: *o.w = (uint32_t)r[k]; break;
            case 12u: r[k] = (uint64_t)o.w[r[x]]; break;
            case 14u:
                if ((uint64_t)*o.w + o.c > (uint64_t)o.y) ukl_atomic_or(&ctl[6], 2u | 32u);
                break;
            case 13u: {
                uint64_t v = r[x] > o.c ? r[x] : o.c, q = 1u;
                for (uint32_t b = 0u; b < 40u && q < v; b++) q <<= 1;
                r[k] = q;
                break;
            }
            default: break;
        }
    }
}

// The threadgroup memory the scans' and sorts' tile passes take.
typedef struct ProgLocal {
    UKL_LOCAL uint32_t* scratch;
    UKL_LOCAL uint32_t* h;
    UKL_LOCAL uint32_t* counts;
    UKL_LOCAL uint32_t* before;
    UKL_LOCAL uint32_t* base;
    UKL_LOCAL uint32_t* digits;
} ProgLocal;

// Item `it`'s work, a group of `JOIN_TG` threads (`l` this one's). The group runs one item at a time, so a tile
// pass's barriers are the group's.
UKL_INLINE void prog_item(UKL_GLOBAL const Job* jobs, UKL_GLOBAL const ScanLevel* scans, UKL_GLOBAL const SortPass* sorts, UKL_GLOBAL const Seg* segs, UKL_GLOBAL const SizeOp* script,
                          JSPACE uint32_t* counts, UKL_GLOBAL uint32_t* ctl, Item it, uint32_t l, ProgLocal m __UKL_PARAMS)
{
    uint32_t kind = it.what >> 24, x = it.what & 0xffffffu, g = it.group, t = kind == PK_SIZE ? 0u : g * JOIN_TG + l;
    // A segment's item strides its job's rows (decision 0603 step 5): its threads `t`, `t + step`, ..., below its
    // count's, `step` the segment's items pushed. Its kernels are a thread a row.
    uint32_t step = 0u, lim = 0u;
    if (it.seg != 0u && segs[it.seg - 1u].per != 0u) {
        UKL_GLOBAL const Seg* sg = &segs[it.seg - 1u];
        step = seg_items(sg) * JOIN_TG;
        lim = *sg->count + sg->plus;
    }
    if (kind == PK_SIZE) {
        if (l == 0u) size_one(script + x, g, ctl, 0u);
        return;
    }
    if (kind == PK_SCAN_SUMS || kind == PK_SCAN_TILES) {
        ScanLevel lv = scans[x];
        // Its sizes as its level's script set them (a word read: the descriptors' pointers are read as written by
        // the host).
        JSPACE const uint32_t* sw = (JSPACE const uint32_t*)(scans + x);
        lv.n = sw[SCAN_N_WORD];
        lv.in += sw[SCAN_AT_WORD];
        lv.sums += sw[SCAN_SUMS_AT_WORD];
        UklScanArgs a;
        a.n = lv.n;
        a.hasOffsets = lv.offsets;
        a.popcount = 0u;
        a.level = 0u;
        // Its tiles: this item's, then each `step` on (its segment's items pushed) while below its values'; tile 0
        // at least (its total).
        uint32_t tiles = (lv.n + JOIN_TG * UKL_SCAN_ITEMS - 1u) / (JOIN_TG * UKL_SCAN_ITEMS), tstep = step / JOIN_TG;
        for (uint32_t tile = g; tile < UKL_WQ_TURNS; tile += tstep) {
            if (kind == PK_SCAN_SUMS) ukl_scan_tile_sum_prog(lv.in, lv.sums, a, m.scratch, tile, l, JOIN_TG __UKL_ARGS);
            else ukl_scan_tile_prog(lv.in, lv.in, lv.sums, a, m.scratch, tile, l, JOIN_TG __UKL_ARGS);
            if (tstep == 0u || tile + tstep >= tiles) break;
        }
        return;
    }
    if (kind == PK_RADIX_HIST || kind == PK_RADIX_SCATTER) {
        SortPass sp = sorts[x];
        UklRadixArgs a;
        a.n = sp.n;
        a.shift = sp.shift;
        a.tiles = sp.tiles;
        if (kind == PK_RADIX_HIST) ukl_radix_hist_tile_u32_prog(sp.keys, sp.hist, a, m.h, g, l, JOIN_TG);
        else ukl_radix_scatter_tile_u32_prog(sp.keys, sp.values, sp.hist, sp.out_keys, sp.out_values, a, m.counts, m.before, m.base, m.digits, g, l, JOIN_TG __UKL_ARGS);
        return;
    }
    UKL_GLOBAL const Job* j = &jobs[x];
    // Its counts' first word, and its tables where its size script placed them, as it set them.
    JSPACE const uint32_t* jw = (JSPACE const uint32_t*)(jobs + x);
    JSPACE uint32_t* c = counts + jw[JOB_BASE_WORD];
    uint32_t l_at = jw[JOB_AT_WORD], o_at = jw[JOB_AT_WORD + 1u], v_at = jw[JOB_AT_WORD + 2u], h_at = jw[JOB_AT_WORD + 3u];
    JSPACE int64_t* arena = (JSPACE int64_t*)counts;
    Longs L = l_at != 0u ? (Longs)(arena + (l_at - 1u)) : j->L;
    JSPACE int64_t* O = o_at != 0u ? arena + (o_at - 1u) : j->O;
    JSPACE int64_t* V = v_at != 0u ? arena + (v_at - 1u) : j->V;
    JSPACE uint32_t* H = h_at != 0u ? counts + (h_at - 1u) : j->H;
    for (uint32_t pass = 0u; pass < UKL_WQ_TURNS; pass++) {
    switch (kind) {
        case PK_COPY: rows_copy_one((JSPACE const uint8_t*)L, (JSPACE uint8_t*)O, j->totals, (JSPACE const Copy*)j->P, j->RF != 0 ? j->RF : (JSPACE const uint8_t*)L, t); break;
        case PK_IX_KEY: ix_key_one((JSPACE const uint8_t*)L, H, (JSPACE uint32_t*)j->S, (JSPACE const IxP*)j->P, j->RF != 0 ? j->RF : (JSPACE const uint8_t*)L, j->kb, j->eb, t); break;
        case PK_IX_PLACE: ix_place_one((JSPACE const uint8_t*)L, (JSPACE const uint32_t*)V, (JSPACE const uint32_t*)j->VC, j->A, j->counters, (JSPACE const IxP*)j->P, j->kb, j->eb, t); break;
        case PK_DEDUP_CLEAR: dedup_clear_one(H, j->dd, t); break;
        case PK_DEDUP_CLAIM: dedup_claim_one(L, j->totals, H, j->dd, t); break;
        case PK_MAP: stage_map_one(O, j->totals, j->s, t); break;
        case PK_STAGE_COUNT: stage_count_one(L, j->R, j->RF, j->totals, j->counters, c, j->A, j->D, j->F, j->s, t); break;
        case PK_SCAN_COUNT: scan_count_one(L, j->R, j->RF, j->counters, c, j->totals, j->s, t); break;
        case PK_WITNESS_COUNT: witness_count_one(L, j->R, j->RF, j->totals, c, j->bs, j->W[0], j->W[1], j->W[2], j->WF[0], j->WF[1], j->WF[2], j->F, j->s, t); break;
        case PK_ROW_TEXT:
            row_text_one(L, j->A, j->totals, j->counters, c, V, j->G, j->S, j->P, j->D, j->VC, j->s, g * (JOIN_TG / SGW) + l / SGW, l % SGW __UKL_ARGS);
            break;
        case PK_DEDUP_MARK: dedup_mark_one(L, j->totals, H, c, j->dd, t); break;
        case PK_STAGE_SCATTER: stage_scatter_one(L, j->R, j->RF, j->totals, c, O, j->A, j->counters, j->D, j->F, j->ws, t); break;
        case PK_SCAN_SCATTER: scan_scatter_one(L, j->R, j->RF, j->totals, c, O, j->s, t); break;
        case PK_ROW_SCATTER: row_scatter_one(L, V, j->totals, c, O, j->s, t); break;
        case PK_DEDUP_SCATTER: dedup_scatter_one(L, j->totals, c, O, j->dd, t); break;
        // A fold's buffers: `L` its rows, `A` its places, `totals` the best row a place, `H` its flags, `S` the relation's
        // block, `VC` its key map's, `G` the old map's, `O` the changed rows, `counters` theirs, `V` the arena.
        case PK_LAT_HCLEAR: lat_hclear_one(j->VC, (JSPACE const LatP*)j->P, t); break;
        case PK_LAT_REHASH: lat_rehash_one((JSPACE const uint8_t*)j->S, j->G, j->VC, (JSPACE const LatP*)j->P, t); break;
        case PK_LAT_CLEAR: lat_clear_one(j->A, j->totals, H, (JSPACE const LatP*)j->P, t); break;
        case PK_LAT_CLAIM: lat_claim_one(L, j->A, j->cnt, (JSPACE const LatP*)j->P, t); break;
        case PK_LAT_BEST: lat_best_one(L, j->A, j->totals, H, (JSPACE uint32_t*)V, j->cnt, (JSPACE const LatP*)j->P, t); break;
        case PK_SUM: sum_one((JSPACE const SumP*)j->P, t); break;
        case PK_GATE: gate_one((JSPACE const GateP*)j->P, ctl, t); break;
        case PK_ROUND: round_one((JSPACE const RoundP*)j->P, ctl, t); break;
        case PK_LAT_MERGE:
            lat_merge_one(L, j->A, j->totals, H, j->S, j->VC, O, j->counters, (JSPACE uint32_t*)V, (JSPACE const uint32_t*)j->G, (JSPACE const LatP*)j->P, t);
            break;
        default: break;
    }
    // Bounded: a pass a stride of its rows.
    if (step == 0u || t + step >= lim || t + step < t) break;
    t += step;
    }
}

// The program, one launch (decision 0603; 0540 step 6's scheme): a group of `JOIN_TG` threads an item. The first
// phase's items are there from the start (the seeds, taken from a counter); the group that finishes a phase's last
// item pushes the next phase's, the continuation, and takes items on: a pushed item has a worker that is running. A
// group that finds nothing to take ends. No group waits for another.
//
// `ctl`: 0-4 the queue's control (head, tail, active, overflow, base), 5 the seeds taken, 6 the program's flags (1:
// a push past the queue's capacity; 2: a gate stopped it; 4, 8, 16: a round's end stopped it past its rounds,
// yielded, ended it; 32: a claim past its arena's room, with 2), `counts` the arena (each level's counts at the offsets
// its size script claimed, decision 0603 step 5), 7 a round's end's jump, 8 the rounds this launch ran, 9 where a yield goes on (the phase and
// one), then each phase's items done (emptied as the phase is pushed: a round runs a phase again), then each phase's
// items as pushed (0: all of them; a phase of segments, theirs). `phases`: each phase's first item, its items, its
// first segment and its segments (`segs`). `phases`: each phase's first item and
// its items. Ordering: a group's writes, a device barrier and fence, then its count; the pusher's fence, then its
// pushes; the taker's fence after its take.
DEFINE_KERNEL2(join, join_run,
               RWBUFFER, Job,       jobs,    "[jobs]",
               ROBUFFER, Item,      items,   "[items]",
               ROBUFFER, uint32_t,  phases,  "[4 * phases]",
               ROBUFFER, Seg,       segs,    "[segs]",
               RWBUFFER, ScanLevel, scans,   "[scans]",
               ROBUFFER, SortPass,  sorts,   "[sorts]",
               ROBUFFER, SizeOp,    script,  "[ops]",
               RWBUFFER, uint32_t,  ctl,     "[10 + 2 * phases]",
               RWBUFFER, uint32_t,  slots,   "[capacity]",
               RWBUFFER, uint32_t,  counts,  "[counts]",
               ARGS,     ProgP,     a,       ,
               SHARED,   uint32_t,  took,    4,
               SHARED,   uint32_t,  scratch, UKL_TG_SCRATCH,
               SHARED,   uint32_t,  h,       UKL_RADIX_DIGITS,
               SHARED,   uint32_t,  rcounts, UKL_RADIX_GROUPS * UKL_RADIX_DIGITS,
               SHARED,   uint32_t,  before,  UKL_RADIX_DIGITS,
               SHARED,   uint32_t,  base,    UKL_RADIX_DIGITS,
               SHARED,   uint32_t,  digits,  UKL_RADIX_SPILL,
               LID0,     uint32_t,  l,       )
{
    UklWorkQueue q;
    q.control = ctl;
    q.slots = slots;
    q.capacity = a.capacity;
    q.ring = 0u;
    q.budget = 0u;
    ProgLocal m;
    m.scratch = scratch;
    m.h = h;
    m.counts = rcounts;
    m.before = before;
    m.base = base;
    m.digits = digits;
    UKL_GLOBAL uint32_t* done = ctl + 10u;
    UKL_GLOBAL uint32_t* target = ctl + 10u + a.phases;
    // Bounded: each turn does an item or ends the group.
    for (uint32_t turn = 0u; turn < UKL_WQ_TURNS; turn++) {
        if (l == 0u) {
            // A seed while any are left, else a continuation; else none (0).
            uint32_t got = 0u, item = 0u;
            if (ukl_atomic_poll(&ctl[5]) < a.seeds) {
                item = ukl_atomic_add(&ctl[5], 1u);
                got = item < a.seeds ? 1u : 0u;
                item += phases[4u * a.first];
            }
            if (got == 0u && ukl_wq_take(q, &item)) got = 2u;
            // What the phase before wrote, seen after the take (the pusher's fence before its push).
            ukl_fence_device();
            took[0] = got;
            took[1] = item;
        }
        ukl_tg_barrier();
        uint32_t got = took[0], item = took[1];
        ukl_tg_barrier();
        if (got == 0u) return;
        Item it = items[item];
        prog_item(jobs, scans, sorts, segs, script, (JSPACE uint32_t*)counts, ctl, it, l, m __UKL_ARGS);
        // The group's writes, then the item counted: the one that brings its phase's count to its items pushes the
        // next phase's.
        ukl_tg_barrier_device();
        if (l == 0u) {
            ukl_fence_device();
            uint32_t p = it.phase;
            uint32_t finished = ukl_atomic_add(&done[p], 1u) + 1u;
            uint32_t want = ukl_atomic_poll(&target[p]);
            bool all = finished == (want != 0u ? want : phases[4u * p + 1u]);
            // A round's end's jump (`ctl[7]`: the phase and one, or the end), else the next phase; a gate that stopped
            // the program (`ctl[6]`'s bit 2): no phase after it.
            uint32_t jump = all ? ukl_atomic_poll(&ctl[7]) : 0u;
            if (jump != 0u) ukl_atomic_store(&ctl[7], 0u);
            took[2] = jump != 0u ? (jump == 0xFFFFFFFFu ? 0u : jump)
                    : all && p + 1u < a.phases && (ukl_atomic_poll(&ctl[6]) & 2u) == 0u ? p + 2u : 0u;
            took[3] = 0u;
            if (took[2] != 0u) {
                // The phase pushed (again, by a round): its count emptied before its items are (its last run's all
                // counted), and its items as its segments' counts need them, at least one.
                uint32_t q = took[2] - 1u, s0 = phases[4u * q + 2u], ns = phases[4u * q + 3u], m = 0u;
                for (uint32_t g = 0u; g < ns; g++) m += seg_items(&segs[s0 + g]);
                took[3] = ns != 0u && m == 0u ? 1u : 0u;
                ukl_atomic_store(&target[q], ns == 0u ? 0u : ukl_max(m, 1u));
                ukl_atomic_store(&done[q], 0u);
            }
            ukl_fence_device();
        }
        ukl_tg_barrier();
        uint32_t next = took[2], none = took[3];
        if (next != 0u) {
            uint32_t pq = next - 1u, first = phases[4u * pq], count = phases[4u * pq + 1u], s0 = phases[4u * pq + 2u], ns = phases[4u * pq + 3u];
            if (ns == 0u) {
                for (uint32_t i = l; i < count; i += JOIN_TG)
                    if (!ukl_wq_push(q, first + i)) ukl_atomic_or(&ctl[6], 1u);
            }
            for (uint32_t g = 0u; g < ns; g++) {
                // A segment's items: its count's, the first segment's first where none needs any (the phase goes on).
                uint32_t m = none != 0u && g == 0u ? 1u : seg_items(&segs[s0 + g]);
                for (uint32_t i = l; i < m; i += JOIN_TG)
                    if (!ukl_wq_push(q, segs[s0 + g].first + i)) ukl_atomic_or(&ctl[6], 1u);
            }
        }
        ukl_tg_barrier_device();
        if (l == 0u && got == 2u) ukl_wq_done(q);
    }
}
#endif

// A kind-set axis's batch solve over a views' directory (decision 0353 step 4, `Within::solved_in`): a thread per row
// of the `node` view, its ancestors read off the tape by the climb written once (`clif_view_up`), as `by_has` reads
// them, each a member where its kind atom's bit is set (`AxisP::bits`, the host's `member`: tag × 1024 + its slot, as
// the `node` view's `kind` column holds it). No node column is made for it. `inside`: every ancestor in the set
// (containment), else the nearest. A climb is bounded by its document's rows.
typedef struct AxisP {
    UKL_GLOBAL const ViewDir* dir;
    // The `node` view's rows; 1 where `bits` holds the set (0: every kind is one); 1 for every ancestor.
    uint32_t n, bits, inside, pad;
    // The relation's rows' descriptor's offset in `out`'s block, and the rows it holds.
    uint64_t rows_at, rows;
} AxisP;
UKL_STATIC_ASSERT(sizeof(AxisP) == 40, "AxisP: size");
UKL_STATIC_ASSERT(UKL_OFFSETOF(AxisP, rows_at) == 24, "AxisP.rows_at");

UKL_INLINE bool axis_in(UKL_GLOBAL const AxisP* p, UKL_GLOBAL const uint32_t* bits, uint32_t q) {
    if (p->bits == 0u) return true;
    uint32_t memo = NONE;
    uint32_t at = (uint32_t)vread(1u, p->dir, q, 2u, &memo);
    return ((bits[at >> 5] >> (at & 31u)) & 1u) != 0u;
}

// Node row `v`'s document's row in the directory, its first `node` row and its rows' end.
UKL_INLINE UKL_GLOBAL const ViewRow* axis_doc(UKL_GLOBAL const ViewDir* d, uint32_t v, UKL_PRIVATE uint32_t* end) {
    uint32_t i = clif_dir_doc_of_row(view_block(d), d->at, 0u, v, NONE);
    UKL_GLOBAL const ViewRow* rows = view_rows(d);
    *end = i + 1u < d->ndocs ? rows[i + 1u].rows[0] : d->ends[0];
    return &rows[i];
}

// Each node row's rows (its ancestors in the set), into `start`; the extra value past the last row is 0, so the scan
// after leaves the total there.
DEFINE_KERNEL2(join, axis_count,
               ROBUFFER, uint32_t, bits,  "[8192]",
               RWBUFFER, uint32_t, start, "[p->n + 1]",
               ROBUFFER, AxisP,    p,     "[1]",
               GID0,     uint32_t, v,     )
{
    uint32_t n = p->n;
    if (v > n) return;
    if (v == n) { start[v] = 0u; return; }
    UKL_GLOBAL const ViewDir* d = p->dir;
    uint32_t end = 0u;
    UKL_GLOBAL const ViewRow* e = axis_doc(d, v, &end);
    UKL_GLOBAL const uint8_t* ch = view_block(d);
    UKL_GLOBAL const uint8_t* t = view_tape(d, e);
    UKL_GLOBAL const uint8_t* ls = view_lines_base(d, e);
    uint64_t la = e->lines;
    uint32_t first = e->rows[0];
    uint32_t count = 0u;
    uint32_t up = clif_view_up(ch, e->entry, t, e->view, ls, la, v - first);
    for (uint32_t k = first; k < end && up != NONE; k++) {
        if (axis_in(p, bits, first + up)) {
            count++;
            if (p->inside == 0u) break;
        }
        up = clif_view_up(ch, e->entry, t, e->view, ls, la, up);
    }
    start[v] = count;
}

// Each node row's rows from its start (the scanned counts), nearest first: the ids of `n` and `a` (the `node` view's
// `n`), written once into the axis's relation (decision 0353 step 5) through the writer written once, bounded by its
// chunks. A solve whose total is past the rows the relation holds writes nothing.
DEFINE_KERNEL2(join, axis_write,
               ROBUFFER, uint32_t, bits,  "[8192]",
               ROBUFFER, uint32_t, start, "[p->n + 1]",
               RWBUFFER, uint8_t,  out,   "[block]",
               ROBUFFER, AxisP,    p,     "[1]",
               GID0,     uint32_t, v,     )
{
    if (v >= p->n || (uint64_t)start[p->n] > p->rows) return;
    UKL_GLOBAL const ViewDir* d = p->dir;
    uint32_t end = 0u;
    UKL_GLOBAL const ViewRow* e = axis_doc(d, v, &end);
    UKL_GLOBAL const uint8_t* ch = view_block(d);
    UKL_GLOBAL const uint8_t* t = view_tape(d, e);
    UKL_GLOBAL const uint8_t* ls = view_lines_base(d, e);
    uint64_t la = e->lines;
    uint32_t first = e->rows[0];
    uint32_t at = start[v];
    uint32_t memo = NONE;
    int64_t n_id = vread(1u, d, v, 1u, &memo);
    uint32_t up = clif_view_up(ch, e->entry, t, e->view, ls, la, v - first);
    for (uint32_t k = first; k < end && up != NONE; k++) {
        if (axis_in(p, bits, first + up)) {
            clif_rows_put((UKL_GLOBAL const uint8_t*)out, p->rows_at, at, 0u, (uint64_t)n_id);
            clif_rows_put((UKL_GLOBAL const uint8_t*)out, p->rows_at, at, 1u, (uint64_t)vread(1u, d, first + up, 1u, &memo));
            at++;
            if (p->inside == 0u) break;
        }
        up = clif_view_up(ch, e->entry, t, e->view, ls, la, up);
    }
}
