// The next sibling (`NEXT`) or a following one (`FOLLOWING`, the rest forked). False: the task stopped (its `status` says why).
UKL_LARGE bool step_next(uint32_t op,uint32_t mode,UKL_PRIVATE const NodeTable* nodes,UKL_GLOBAL const Supertype* supertypes,UKL_GLOBAL const uint32_t* words,UKL_GLOBAL Link* captures,UKL_GLOBAL Link* cursors,UKL_GLOBAL RepeatLink* repeats,UKL_GLOBAL QueuedState* queuedStates,UKL_GLOBAL Pending* pending,Task task,File file,Program program,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,UKL_GLOBAL Status* status,UKL_PRIVATE Path* pathAt,UKL_PRIVATE uint32_t* pendingCountAt,UKL_PRIVATE bool* keepAt){Path path=*pathAt;uint32_t pendingCount=*pendingCountAt;bool keep=*keepAt;{uint32_t first=node_next(nodes,path.node,mode!=0u);if(first==NONE)keep=false;else{bool simpleRepeat=false,simpleChoice=false;uint32_t choiceFirst=0u,choiceSecond=0u;if(op==20u&&path.repeats&&path.pc+4u<program.wordCount){uint32_t w1=words[program.wordStart+path.pc+1u],w2=words[program.wordStart+path.pc+2u],w3=words[program.wordStart+path.pc+3u],w4=words[program.wordStart+path.pc+4u];simpleRepeat=(w1&255u)==1u&&(w2&255u)==32u&&(w3&255u)==34u&&(w4&255u)==49u&&(uint32_t)((uint16_t)(w3>>16u))==repeats[path.repeats-1u].value;if(!simpleRepeat&&path.pc+7u<program.wordCount){uint32_t w5=words[program.wordStart+path.pc+5u],w6=words[program.wordStart+path.pc+6u],w7=words[program.wordStart+path.pc+7u];simpleChoice=(w1&255u)==48u&&(w2&255u)==1u&&(w3&255u)==32u&&(w4&255u)==49u&&(w5&255u)==1u&&(w6&255u)==34u&&(w7&255u)==49u&&(uint32_t)((uint16_t)(w6>>16u))==repeats[path.repeats-1u].value;choiceFirst=(uint32_t)((uint16_t)(w2>>16u));choiceSecond=(uint32_t)((uint16_t)(w5>>16u));}}if(simpleRepeat||simpleChoice){uint32_t kind=simpleRepeat?(uint32_t)((uint16_t)(words[program.wordStart+path.pc+1u]>>16u)):choiceFirst,kindMode=simpleRepeat?(words[program.wordStart+path.pc+1u]>>8u)&255u:0u;bool matches=Node_kind(node_at(nodes,first))==kind||(simpleChoice&&Node_kind(node_at(nodes,first))==choiceSecond)||(kindMode&&has_supertype(supertypes,file,nodes,first,kind));if(!matches)first=node_next(nodes,firs