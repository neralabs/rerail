// The batch runtime (decision 0440 step C, was `metal_batch_runtime.metal`): the interpreter of packed and resident
// label batches, one lane a thread taking tasks from the batch's cursor. UKL, after the tape view and its reads
// (`metal_program_backend::prefix`). The JIT splices its own text at the markers (`/*FETCH*/`, `/*JIT_SUPPORT*/`,
// `/*JIT_CONTEXT*/`, `/*JIT_OUTPUT_CONTEXT*/`, the opcode switch and the output call), whose bodies it pastes into
// its step functions: they are written in `run_task_in`'s names. The sweep (`label_sweep.uglykl`) is compiled after it.
#define NONE 0xffffffffu
#define FORMAT_VERSION 4u
typedef struct BatchHeader { uint32_t formatVersion,taskCount,fileCount,programCount,nodeCount,childCount,supertypeCount,lineStartCount,stringCount,structuralWordCount,valueInstructionCount,captureInstructionCount,outputInstructionCount,workspaceByteCount,evaluationCount,queryBucketByteStart,schedulerByteCount,queryMemberByteStart,queuedStateByteStart,greedyEntryByteStart,markScratch,markCounts; } BatchHeader;
typedef struct File { uint32_t nodeStart,nodeCount,sourceStart,source_length,lineStart,line_count,superStart,superCount; } File;
typedef struct Program { uint32_t wordStart,wordCount,longStart,longCount,stringStart,stringCount,valueStart,valueCount,captureStart,captureCount,outputStart,outputCount,labelStart,labelCount,maxCursor,maxLuaCapture,flags; } Program;
typedef struct Supertype { uint32_t node,kind; } Supertype;
typedef struct StringRecord { uint32_t start,length; } StringRecord;
typedef struct ValueRecord { uint32_t kind,operand,auxiliary,stateStart,stateCount; } ValueRecord;
typedef struct NfaState { uint32_t kind,dataStart,dataCount,next; } NfaState;
typedef struct NfaRange { uint32_t start,end,target; } NfaRange;
typedef struct LuaInstruction { uint32_t kind,first,second,matcherKind,matcherFirst,matcherSecond,dataStart,dataCount; } LuaInstruction;
typedef struct LuaMember { uint32_t kind,first,second,negated; } LuaMember;
typedef struct Assertion { uint32_t kind,first,second,dataStart,dataCount,flags; } Assertion;
typedef struct Path { uint32_t pc,node,start,captures,cursors,repeats,steps,following,captureHash,cursorHash,repeatHash; } Path;
typedef struct Pending { uint32_t kind,greedySlot; Path path; } Pending;
typedef struct Link { uint32_t previous,first,second; } Link;
typedef struct RepeatLink { uint32_t previous,value,previousHash; } RepeatLink;
typedef struct Seen { uint32_t occupied,pc,node,following,captureHash,cursorHash,repeatHash,captures,cursors,repeats; } Seen;
typedef struct QueryBucket { uint32_t occupied,hash,pc,node,siblingRequirement,cursors,repeats,firstMember; } QueryBucket;
typedef struct QueryMember { uint32_t nextMember,captures,captureCount,captureHash; } QueryMember;
typedef struct QueuedState { uint32_t occupied,hash,pc,node,siblingRequirement,captures,cursors,repeats; } QueuedState;
typedef struct GreedyEntry { uint32_t occupied,hash,pc,start,captures,cursors,repeats; Path path; } GreedyEntry;
typedef struct Result { uint32_t taskOrdinal,localOrdinal,start,label,captureStart,captureCount,propertyStart,propertyCount,dynamicStart,dynamicCount; } Result;
typedef struct OutputInstruction { uint32_t kind,first,second,third,fourth,fifth; } OutputInstruction;
typedef struct FinalCapture { uint32_t label,node,start,end,textStart,textLength,propertyStart,propertyCount,retained; } FinalCapture;
typedef struct Property { uint32_t kind,owner,key,value,keyStart,keyLength,valueStart,valueLength; } Property;
typedef struct Status { uint32_t error,resultCount,captureCount,programCounter,finalCaptureCount,propertyCount,outputByteCount,reserved; } Status;
typedef struct SharedArena { uint32_t start,capacity; uint32_t cursor; } SharedArena;
typedef struct EvaluationQuota { uint32_t used; uint32_t limit; } EvaluationQuota;
typedef struct LazyArenaBlock { uint32_t start,limit; uint32_t state; uint32_t reserved; } LazyArenaBlock;
typedef struct Evaluation { uint32_t outcome; uint32_t generation,failureArena,failureTask,failurePc; uint32_t workUsed; uint32_t workLimit,taskStart,taskCount,program,file,rootRule,rootReserved; EvaluationQuota quotas[14]; LazyArenaBlock pending,capture,cursor,repeat,valueState,candidate,queryBucket,queryMember,queuedState,greedyEntry; } Evaluation;
typedef struct GlobalArenas { SharedArena arenas[14]; uint32_t taskCursor; uint32_t reserved[3]; } GlobalArenas;
typedef struct Task { uint32_t evaluation,ordinal,file,program,root,estimate,workLimit; } Task;
// A path's and a value's steps: the task's budget, and at most the CPU's per path (`MAX_STEPS_PER_PATH`).
UKL_INLINE uint32_t step_limit(Task task){return ukl_min(task.workLimit,1u<<20u);}

// The tapes a batch reads (decisions 0032, 0293, 0310): each task's file is a document in the batch's
// chunk block (0289 §4), read in place, packed batch or resident label batch alike. `nodes` answers a node's record from the
// tape when read (its kind, field, flags, span and subtree; no parent or sibling links, which are
// `node_parent` and `node_next`, a search on the tape), and `lineStarts` and `files` are tables over
// it that answer in the batch's numbering, spans and line starts offset by the document's place in
// the batch's source. `source` is the document's bytes, addressed by the batch's offsets. Children
// are hops over their elder siblings' subtrees (`descendantEnd`): no child list is read. The chunk is
// bound where the node records were (`nodes`).
// `RERAIL_RESIDENT` (the label passes) chooses the task model alone: tasks from roots, not records.
typedef struct NodeTable { UKL_GLOBAL const uint8_t* s; DocView d; } NodeTable;
// A node of the batch: its table and its number, each field read on the tape when asked (decision 0310), no record.
typedef struct Node { UKL_PRIVATE const NodeTable* t; uint32_t g; } Node;
UKL_INLINE Node node_at(UKL_PRIVATE const NodeTable* t,uint32_t g){Node n={t,g};return n;}
UKL_INLINE bool node_has_class(UKL_PRIVATE const NodeTable* t,uint32_t g,uint32_t kind){return tape_has_class(t->s,t->d,g-t->d.node_base,kind);}
UKL_SHARED uint32_t Node_kind(Node n){return tape_kind(n.t->s,n.t->d,n.g-n.t->d.node_base);}
UKL_SHARED uint32_t Node_field(Node n){return tape_field(n.t->s,n.t->d,n.g-n.t->d.node_base);}
UKL_SHARED uint32_t Node_flags(Node n){return tape_flags(n.t->s,n.t->d,n.g-n.t->d.node_base);}
UKL_SHARED uint32_t Node_sourceStart(Node n){return n.t->d.source_base+tape_start(n.t->s,n.t->d,n.g-n.t->d.node_base);}
UKL_SHARED uint32_t Node_sourceEnd(Node n){return n.t->d.source_base+tape_end(n.t->s,n.t->d,n.g-n.t->d.node_base);}
UKL_SHARED uint32_t Node_descendantEnd(Node n){return n.g+tape_size(n.t->s,n.t->d,n.g-n.t->d.node_base);}
UKL_INLINE uint32_t node_parent(UKL_PRIVATE const NodeTable* t,uint32_t g){uint32_t p=tape_parent(t->s,t->d,g-t->d.node_base);return p==TAPE_NONE?NONE:p+t->d.node_base;}
UKL_INLINE uint32_t node_end(UKL_PRIVATE const NodeTable* t,uint32_t g){return g+tape_size(t->s,t->d,g-t->d.node_base);}
UKL_INLINE uint32_t node_flags(UKL_PRIVATE const NodeTable* t,uint32_t g){return tape_flags(t->s,t->d,g-t->d.node_base);}
UKL_INLINE uint32_t node_field(UKL_PRIVATE const NodeTable* t,uint32_t g){return tape_field(t->s,t->d,g-t->d.node_base);}
// The next sibling (named: the next named one), or NONE.
UKL_SHARED uint32_t node_next(UKL_PRIVATE const NodeTable* t,uint32_t g,bool named){uint32_t i=g-t->d.node_base,p=tape_parent(t->s,t->d,i);if(p==TAPE_NONE)return NONE;uint32_t end=tape_end_of(t->s,t->d,p);uint32_t j=named?tape_next_named_in(t->s,t->d,i,end):tape_next_in(t->s,t->d,i,end);return j==TAPE_NONE?NONE:j+t->d.node_base;}
// The task's document's lines in the batch's numbering of source bytes, read off its tape (`tape_line`): a byte's
// line (from 0, past the end the last), and a line's first byte.
typedef struct LineTable { UKL_GLOBAL const uint8_t* s; DocView d; } LineTable;
UKL_INLINE uint32_t line_of(UKL_PRIVATE const LineTable* t,uint32_t byte){return tape_line(t->s,t->d,ukl_min(byte-ukl_min(byte,t->d.source_base),t->d.source_len));}
UKL_INLINE uint32_t line_start(UKL_PRIVATE const LineTable* t,uint32_t k){return t->d.source_base+tape_line_start(t->s,t->d,k);}
typedef struct FileTable { UKL_GLOBAL const DocView* docs; } FileTable;
UKL_INLINE File file_at(UKL_PRIVATE const FileTable* t,uint32_t i){DocView d=t->docs[i];File f;f.nodeStart=d.node_base;f.nodeCount=d.nodes;f.sourceStart=d.source_base;f.source_length=d.source_len;f.lineStart=d.line_base;f.line_count=d.line_count;f.superStart=0u;f.superCount=0u;return f;}

UKL_SHARED bool reserve_atomic(UKL_GLOBAL uint32_t* cursor,uint32_t capacity,uint32_t count,UKL_PRIVATE uint32_t* start){uint32_t old=ukl_atomic_poll(cursor);while(true){if(old>capacity||count>capacity-old)return false;uint32_t next=old+count;if(ukl_atomic_cas(cursor,old,next)==old){(*start)=old;return true;}old=ukl_atomic_poll(cursor);}}
UKL_SHARED uint32_t reserve_shared(UKL_GLOBAL EvaluationQuota* quota,UKL_GLOBAL SharedArena* globalArena,uint32_t count,UKL_PRIVATE uint32_t* offset){uint32_t logical=0u;if(!reserve_atomic(&quota->used,quota->limit,count,&(logical)))return 1u;uint32_t physical=0u;if(!reserve_atomic(&globalArena->cursor,globalArena->capacity,count,&(physical)))return 2u;if(physical>0xffffffffu-globalArena->start)return 2u;(*offset)=globalArena->start+physical;return 0u;}
UKL_INLINE uint32_t reserve_transient(UKL_GLOBAL EvaluationQuota* quota,UKL_GLOBAL LazyArenaBlock* block,uint32_t count,UKL_PRIVATE uint32_t* offset){uint32_t logical=0u;if(!reserve_atomic(&quota->used,quota->limit,count,&(logical)))return 1u;if(logical>0xffffffffu-block->start)return 2u;(*offset)=block->start+logical;return 0u;}
UKL_COLD uint32_t ensure_lazy_block(UKL_GLOBAL LazyArenaBlock* block,UKL_GLOBAL SharedArena* globalArena,UKL_PRIVATE uint32_t* start){while(true){uint32_t state=ukl_atomic_poll(&block->state);if(state==0xffffffffu)return 2u;if(state>=2u){(*start)=state-2u;return 0u;}if(state==0u){if(ukl_atomic_cas(&block->state,0u,1u)==0u){uint32_t relative=0u;if(!reserve_atomic(&globalArena->cursor,globalArena->capacity,block->limit,&(relative))||relative>0xfffffffdu-globalArena->start){ukl_atomic_store(&block->state,0xffffffffu);return 2u;}(*start)=globalArena->start+relative;block->start=(*start);ukl_atomic_store(&block->state,(*start)+2u);return 0u;}}}}

UKL_INLINE uint32_t mix(uint32_t h,uint32_t value){h^=value+0x9e3779b9u+(h<<6u)+(h>>2u);return h;}
UKL_INLINE uint32_t cursor_value(UKL_GLOBAL const Link* links,uint32_t base,uint32_t head,uint32_t slot){while(head){Link x=links[base+head-1u];if(x.first==slot)return x.second;head=x.previous;}return NONE;}
UKL_INLINE bool cursor_equal(UKL_GLOBAL const Link* links,uint32_t base,uint32_t a,uint32_t b,uint32_t slots){for(uint32_t i=0;i<slots;i++)if(cursor_value(links,base,a,i)!=cursor_value(links,base,b,i))return false;return true;}
UKL_INLINE bool repeat_equal(UKL_GLOBAL const RepeatLink* links,uint32_t base,uint32_t a,uint32_t b){while(a&&b){RepeatLink x=links[base+a-1u],y=links[base+b-1u];if(x.value!=y.value)return false;a=x.previous;b=y.previous;}return a==b;}
UKL_INLINE bool push_path(UKL_GLOBAL Pending* pending,Task task,UKL_PRIVATE uint32_t* count,Path path,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){if((*count)>=evaluation->quotas[0].limit)return false;{Pending ukl_item={0u,0u,path};pending[evaluation->pending.start+(*count)++]=ukl_item;}return true;}
UKL_INLINE bool capture_chain_contains(UKL_GLOBAL const Link* captures,uint32_t left,uint32_t right){if(left==right)return true;for(uint32_t head=left;head;head=captures[head-1u].previous)if(head==right)return true;return false;}
UKL_INLINE uint32_t sibling_requirement(UKL_GLOBAL const uint32_t* words,Program program,uint32_t pc){uint32_t op=words[program.wordStart+pc]&255u;return op==17u?1u:(op==7u?2u:(op==8u?3u:0u));}
// Query capture containment, the CPU's `capture_containment`: captures group by byte span, and left contains
// right when each group's (label, node) sequence on the right, oldest first, is a prefix of the left's.
UKL_LARGE bool capture_query_contains(UKL_GLOBAL const Link* captures,UKL_PRIVATE const NodeTable* nodes,uint32_t left,uint32_t right){for(uint32_t r=right;r;r=captures[r-1u].previous){Link x=captures[r-1u];uint32_t s=Node_sourceStart(node_at(nodes,x.second)),e=Node_sourceEnd(node_at(nodes,x.second)),older=0u,total=0u;for(uint32_t h=x.previous;h;h=captures[h-1u].previous){Node n=node_at(nodes,captures[h-1u].second);if(Node_sourceStart(n)==s&&Node_sourceEnd(n)==e)older++;}for(uint32_t h=left;h;h=captures[h-1u].previous){Node n=node_at(nodes,captures[h-1u].second);if(Node_sourceStart(n)==s&&Node_sourceEnd(n)==e)total++;}if(older>=total)return false;uint32_t newer=total-1u-older,seen=0u;bool match=false;for(uint32_t h=left;h;h=captures[h-1u].previous){Link y=captures[h-1u];Node n=node_at(nodes,y.second);if(Node_sourceStart(n)==s&&Node_sourceEnd(n)==e){if(seen++==newer){match=y.first==x.first&&y.second==x.second;break;}}}if(!match)return false;}return true;}
// Queued and greedy states compare captures as the CPU JIT's do (`exact_state_equal`): the same captures, in any order.
UKL_LARGE uint32_t capture_occurrences(UKL_GLOBAL const Link* links,uint32_t base,uint32_t head,uint32_t label,uint32_t node){uint32_t n=0;while(head){Link x=links[base+head-1u];if(x.first==label&&x.second==node)n++;head=x.previous;}return n;}
UKL_LARGE bool query_capture_contains(UKL_GLOBAL const Link* captures,Task task,uint32_t left,uint32_t right,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){for(uint32_t head=right;head;head=captures[head-1u].previous){Link value=captures[head-1u];if(capture_occurrences(captures,0u,left,value.first,value.second)<capture_occurrences(captures,0u,right,value.first,value.second))return false;}return true;}
UKL_INLINE bool query_capture_equal(UKL_GLOBAL const Link* captures,Task task,uint32_t left,uint32_t right,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){return query_capture_contains(captures,task,left,right,evaluation,globalArenas)&&query_capture_contains(captures,task,right,left,evaluation,globalArenas);}
UKL_LARGE uint32_t query_admit(Path path,Task task,Program program,UKL_GLOBAL const uint32_t* words,UKL_GLOBAL QueryBucket* buckets,UKL_GLOBAL QueryMember* members,UKL_GLOBAL const Link* captures,UKL_PRIVATE const NodeTable* nodes,UKL_GLOBAL const Link* cursors,UKL_GLOBAL const RepeatLink* repeats,UKL_PRIVATE uint32_t* memberCount,UKL_PRIVATE uint32_t* work,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){uint32_t sibling=sibling_requirement(words,program,path.pc);uint32_t h=mix(mix(mix(mix(path.pc,path.node),path.cursorHash),path.repeatHash),sibling);uint32_t slot=h%evaluation->quotas[4].limit,found=NONE;for(uint32_t probe=0;probe<evaluation->quotas[4].limit;probe++){if((*work)==0xffffffffu||++(*work)>task.workLimit)return 3u;UKL_GLOBAL QueryBucket* old=&(buckets[evaluation->queryBucket.start+slot]);if(old->occupied!=evaluation->generation){{QueryBucket ukl_item={evaluation->generation,h,path.pc,path.node,sibling,path.cursors,path.repeats,0u};(*old)=ukl_item;}found=slot;break;}if(old->hash==h&&old->pc==path.pc&&old->node==path.node&&old->siblingRequirement==sibling&&cursor_equal(cursors,0u,old->cursors,path.cursors,program.maxCursor)&&repeat_equal(repeats,0u,old->repeats,path.repeats)){found=slot;break;}slot=(slot+1u)%evaluation->quotas[4].limit;}if(found==NONE)return 2u;UKL_GLOBAL QueryBucket* bucket=&(buckets[evaluation->queryBucket.start+found]);uint32_t count=0u;for(uint32_t head=path.captures;head;head=captures[head-1u].previous)count++;// A state is seen when its captures equal an admitted one's, as the CPU's (`admit_query_state`): containment
   // would prune paths whose candidates the CPU numbers (raw candidate ordinals).
   for(uint32_t member=bucket->firstMember;member;){if((*work)==0xffffffffu||++(*work)>task.workLimit)return 3u;UKL_GLOBAL QueryMember* old=&(members[evaluation->queryMember.start+member-1u]);if(old->captureCount==count&&old->captureHash==path.captureHash&&capture_query_contains(captures,nodes,old->captures,path.captures))return 0u;member=old->nextMember;}if((*memberCount)>=evaluation->quotas[5].limit)return 2u;{QueryMember ukl_item={bucket->firstMember,path.captures,count,path.captureHash};members[evaluation->queryMember.start+(*memberCount)]=ukl_item;}bucket->firstMember=++(*memberCount);return 1u;}
UKL_INLINE uint32_t queued_hash(Path path,uint32_t sibling){return mix(mix(mix(mix(mix(path.pc,path.node),path.captureHash),path.cursorHash),path.repeatHash),sibling);}
UKL_LARGE uint32_t queued_insert(Path path,Task task,Program program,UKL_GLOBAL const uint32_t* words,UKL_GLOBAL QueuedState* queued,UKL_GLOBAL const Link* captures,UKL_GLOBAL const Link* cursors,UKL_GLOBAL const RepeatLink* repeats,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){if(!evaluation->quotas[6].limit)return 2u;uint32_t sibling=sibling_requirement(words,program,path.pc),h=queued_hash(path,sibling),slot=h%evaluation->quotas[6].limit,available=NONE;for(uint32_t probe=0;probe<evaluation->quotas[6].limit;probe++){UKL_GLOBAL QueuedState* old=&(queued[evaluation->queuedState.start+slot]);if(old->occupied!=evaluation->generation&&old->occupied!=evaluation->generation+1u){if(available==NONE)available=slot;break;}if(old->occupied==evaluation->generation+1u){if(available==NONE)available=slot;}else if(old->hash==h&&old->pc==path.pc&&old->node==path.node&&old->siblingRequirement==sibling&&query_capture_equal(captures,task,old->captures,path.captures,evaluation,globalArenas)&&cursor_equal(cursors,0u,old->cursors,path.cursors,program.maxCursor)&&repeat_equal(repeats,0u,old->repeats,path.repeats))return 0u;slot=(slot+1u)%evaluation->quotas[6].limit;}if(available==NONE)return 2u;{QueuedState ukl_item={evaluation->generation,h,path.pc,path.node,sibling,path.captures,path.cursors,path.repeats};queued[evaluation->queuedState.start+available]=ukl_item;}return 1u;}
UKL_INLINE bool queued_remove(Path path,Task task,Program program,UKL_GLOBAL const uint32_t* words,UKL_GLOBAL QueuedState* queued,UKL_GLOBAL const Link* captures,UKL_GLOBAL const Link* cursors,UKL_GLOBAL const RepeatLink* repeats,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){if(!evaluation->quotas[6].limit)return false;uint32_t sibling=sibling_requirement(words,program,path.pc),h=queued_hash(path,sibling),slot=h%evaluation->quotas[6].limit;for(uint32_t probe=0;probe<evaluation->quotas[6].limit;probe++){UKL_GLOBAL QueuedState* old=&(queued[evaluation->queuedState.start+slot]);if(old->occupied!=evaluation->generation&&old->occupied!=evaluation->generation+1u)return false;if(old->occupied==evaluation->generation&&old->hash==h&&old->pc==path.pc&&old->node==path.node&&old->siblingRequirement==sibling&&query_capture_equal(captures,task,old->captures,path.captures,evaluation,globalArenas)&&cursor_equal(cursors,0u,old->cursors,path.cursors,program.maxCursor)&&repeat_equal(repeats,0u,old->repeats,path.repeats)){old->occupied=evaluation->generation+1u;return true;}slot=(slot+1u)%evaluation->quotas[6].limit;}return false;}
UKL_LARGE uint32_t enqueue_path(UKL_GLOBAL Pending* pending,Task task,Program program,UKL_GLOBAL const uint32_t* words,UKL_GLOBAL QueuedState* queued,UKL_GLOBAL const Link* captures,UKL_GLOBAL const Link* cursors,UKL_GLOBAL const RepeatLink* repeats,UKL_PRIVATE uint32_t* count,Path path,uint32_t kind,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){if(evaluation->quotas[4].limit){uint32_t outcome=queued_insert(path,task,program,words,queued,captures,cursors,repeats,evaluation,globalArenas);if(outcome!=1u)return outcome;}if((*count)>=evaluation->quotas[0].limit)return 2u;{Pending ukl_item={kind,0u,path};pending[evaluation->pending.start+(*count)++]=ukl_item;}return 1u;}
UKL_INLINE uint32_t greedy_hash(Path path){return mix(mix(mix(mix(path.pc,path.start),path.captureHash),path.cursorHash),path.repeatHash);}
UKL_INLINE uint64_t greedy_schedule(Path path,Task task,Program program,UKL_GLOBAL GreedyEntry* entries,UKL_GLOBAL const Link* captures,UKL_GLOBAL const Link* cursors,UKL_GLOBAL const RepeatLink* repeats,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){if(!evaluation->quotas[7].limit)return (uint64_t)(-1);uint32_t h=greedy_hash(path),slot=h%evaluation->quotas[7].limit,available=NONE;for(uint32_t probe=0;probe<evaluation->quotas[7].limit;probe++){UKL_GLOBAL GreedyEntry* old=&(entries[evaluation->greedyEntry.start+slot]);if(old->occupied!=evaluation->generation&&old->occupied!=evaluation->generation+1u){if(available==NONE)available=slot;break;}if(old->occupied==evaluation->generation+1u){if(available==NONE)available=slot;}else if(old->hash==h&&old->pc==path.pc&&old->start==path.start&&query_capture_equal(captures,task,old->captures,path.captures,evaluation,globalArenas)&&cursor_equal(cursors,0u,old->cursors,path.cursors,program.maxCursor)&&repeat_equal(repeats,0u,old->repeats,path.repeats)){old->path=path;return (uint64_t)(slot);}slot=(slot+1u)%evaluation->quotas[7].limit;}if(available==NONE)return (uint64_t)(-1);{GreedyEntry ukl_item={evaluation->generation,h,path.pc,path.start,path.captures,path.cursors,path.repeats,path};entries[evaluation->greedyEntry.start+available]=ukl_item;}return (1ul<<32u)|(uint64_t)(available);}
UKL_INLINE bool has_supertype(UKL_GLOBAL const Supertype* values,File file,UKL_PRIVATE const NodeTable* nodes,uint32_t node,uint32_t kind){if(kind>=16384u){uint32_t words=values[0].kind;UKL_GLOBAL const uint32_t* bits=(UKL_GLOBAL const uint32_t*)(values+1);return ((bits[(kind-16384u)*words+node/32u]>>(node%32u))&1u)!=0u;}
return node_has_class(nodes,node,kind);
}
UKL_INLINE bool ascii_word(uint8_t byte){return (byte>='a'&&byte<='z')||(byte>='A'&&byte<='Z')||(byte>='0'&&byte<='9')||byte=='_';}
UKL_INLINE bool unicode_word(uint32_t scalar,UKL_GLOBAL const uint32_t* ranges){uint32_t low=0u,high=ranges[0];while(low<high){uint32_t middle=low+(high-low)/2u,start=ranges[1u+middle*2u],end=ranges[2u+middle*2u];if(scalar<start)high=middle;else if(scalar>end)low=middle+1u;else return true;}return false;}
UKL_INLINE uint32_t utf8_scalar(UKL_GLOBAL const uint8_t* source,uint32_t at,uint32_t end){if(at>=end)return 0u;uint32_t lead=source[at];if(lead<128u)return lead;uint32_t count=(lead&0xe0u)==0xc0u?2u:((lead&0xf0u)==0xe0u?3u:((lead&0xf8u)==0xf0u?4u:1u));if(at+count>end)return 0u;uint32_t scalar=lead&((1u<<(7u-count))-1u);for(uint32_t i=1u;i<count;i++){uint32_t byte=source[at+i];if((byte&0xc0u)!=0x80u)return 0u;scalar=(scalar<<6u)|(byte&0x3fu);}return scalar;}
UKL_INLINE bool unicode_word_right(UKL_GLOBAL const uint8_t* source,uint32_t at,uint32_t end,UKL_GLOBAL const uint32_t* ranges){return at<end&&unicode_word(utf8_scalar(source,at,end),ranges);}
UKL_INLINE bool unicode_word_left(UKL_GLOBAL const uint8_t* source,uint32_t start,uint32_t at,UKL_GLOBAL const uint32_t* ranges){if(at<=start)return false;uint32_t before=at-1u;while(before>start&&(source[before]&0xc0u)==0x80u)before--;return unicode_word(utf8_scalar(source,before,at),ranges);}
UKL_LARGE uint32_t look_matches(uint32_t kind,UKL_GLOBAL const uint8_t* source,uint32_t start,uint32_t end,uint32_t at,UKL_GLOBAL const uint32_t* ranges){bool left=at>start&&ascii_word(source[at-1u]),right=at<end&&ascii_word(source[at]);bool unicodeKind=kind==256u||kind==512u||kind==4096u||kind==8192u||kind==65536u||kind==131072u;bool unicodeLeft=unicodeKind&&unicode_word_left(source,start,at,ranges),unicodeRight=unicodeKind&&unicode_word_right(source,at,end,ranges);switch(kind){case 1u:return at==start;case 2u:return at==end;case 4u:return at==start||source[at-1u]=='\n';case 8u:return at==end||source[at]=='\n';case 16u:return at==start||source[at-1u]=='\n'||(source[at-1u]=='\r'&&(at==end||source[at]!='\n'));case 32u:return at==end||source[at]=='\r'||(source[at]=='\n'&&(at==start||source[at-1u]!='\r'));case 64u:return left!=right;case 128u:return left==right;case 256u:return unicodeLeft!=unicodeRight;case 512u:return unicodeLeft==unicodeRight;case 1024u:return !left&&right;case 2048u:return left&&!right;case 4096u:return !unicodeLeft&&unicodeRight;case 8192u:return unicodeLeft&&!unicodeRight;case 16384u:return !left;case 32768u:return !right;case 65536u:return !unicodeLeft;case 131072u:return !unicodeRight;default:return 2u;}}
UKL_INLINE uint32_t nfa_closure(ValueRecord value,uint32_t state,uint32_t at,UKL_GLOBAL const uint8_t* source,uint32_t start,uint32_t end,Task task,UKL_GLOBAL const NfaState* states,UKL_GLOBAL const uint32_t* data,UKL_GLOBAL uint32_t* work,uint32_t outputStart,UKL_PRIVATE uint32_t* outputCount,UKL_PRIVATE uint32_t* steps,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,uint32_t valueBase,uint32_t valueCapacity){uint32_t n=value.stateCount,seenStart=valueBase,stackStart=seenStart+n;uint32_t stackCount=0u;if(state>=n)return 2u;work[stackStart+stackCount++]=state;while(stackCount){if(++(*steps)>step_limit(task))return 3u;uint32_t current=work[stackStart+--stackCount];if(current>=n)return 2u;if(work[seenStart+current])continue;work[seenStart+current]=1u;NfaState found=states[value.stateStart+current];if(found.kind==0u){if((*outputCount)>=n)return 4u;work[outputStart+(*outputCount)++]=current;}else if(found.kind==1u){uint32_t matched=look_matches(found.dataStart,source,start,end,at,data);if(matched==2u)return 2u;if(matched){if(stackCount>=n)return 4u;work[stackStart+stackCount++]=found.next;}}else if(found.kind==2u){for(uint32_t index=found.dataCount;index>0u;index--){if(stackCount>=n)return 4u;work[stackStart+stackCount++]=data[found.dataStart+index-1u];}}else if(found.kind==3u){if(stackCount>=n)return 4u;work[stackStart+stackCount++]=found.next;}else if(found.kind==5u)return 1u;else if(found.kind!=4u)return 2u;}return 0u;}
UKL_LARGE uint32_t evaluate_nfa(ValueRecord value,UKL_GLOBAL const uint8_t* source,Node node,Task task,UKL_GLOBAL const NfaState* states,UKL_GLOBAL const uint32_t* data,UKL_GLOBAL const NfaRange* ranges,UKL_GLOBAL uint32_t* work,UKL_PRIVATE uint32_t* steps,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,uint32_t valueBase,uint32_t valueCapacity){uint32_t n=value.stateCount;if(n==0u)return 2u;if(valueCapacity<n*4u)return 4u;uint32_t seen=valueBase,current=seen+2u*n,next=seen+3u*n;for(uint32_t i=0;i<n;i++)work[seen+i]=0u;uint32_t currentCount=0u;uint32_t outcome=nfa_closure(value,value.operand,Node_sourceStart(node),source,Node_sourceStart(node),Node_sourceEnd(node),task,states,data,work,current,&(currentCount),steps,evaluation,globalArenas,valueBase,valueCapacity);if(outcome)return outcome;for(uint32_t at=Node_sourceStart(node);at<Node_sourceEnd(node);at++){for(uint32_t i=0;i<n;i++)work[seen+i]=0u;uint32_t nextCount=0u;for(uint32_t index=0;index<currentCount;index++){NfaState state=states[value.stateStart+work[current+index]];for(uint32_t rangeIndex=0;rangeIndex<state.dataCount;rangeIndex++){if(++(*steps)>step_limit(task))return 3u;NfaRange range=ranges[state.dataStart+rangeIndex];uint8_t byte=source[at];if(byte>=range.start&&byte<=range.end){outcome=nfa_closure(value,range.target,at+1u,source,Node_sourceStart(node),Node_sourceEnd(node),task,states,data,work,next,&(nextCount),steps,evaluation,globalArenas,valueBase,valueCapacity);if(outcome)return outcome;}}}uint32_t swap=current;current=next;next=swap;currentCount=nextCount;}return 0u;}
UKL_SHARED bool lua_class(uint32_t kind,uint8_t byte){uint8_t lower=kind>='A'&&kind<='Z'?kind+32:kind;switch(lower){case 'a':return (byte>='a'&&byte<='z')||(byte>='A'&&byte<='Z');case 'c':return byte<32u||byte==127u;case 'd':return byte>='0'&&byte<='9';case 'g':return byte>=33u&&byte<=126u;case 'l':return byte>='a'&&byte<='z';case 'p':return byte>=33u&&byte<=126u&&!((byte>='a'&&byte<='z')||(byte>='A'&&byte<='Z')||(byte>='0'&&byte<='9'));case 's':return byte==' '||byte=='\t'||byte=='\n'||byte==11u||byte==12u||byte=='\r';case 'u':return byte>='A'&&byte<='Z';case 'w':return (byte>='a'&&byte<='z')||(byte>='A'&&byte<='Z')||(byte>='0'&&byte<='9');case 'x':return (byte>='0'&&byte<='9')||(byte>='a'&&byte<='f')||(byte>='A'&&byte<='F');case 'z':return byte==0u;default:return false;}}
UKL_INLINE bool lua_match(LuaInstruction instruction,uint8_t byte,UKL_GLOBAL const LuaMember* members){if(instruction.matcherKind==0u)return true;if(instruction.matcherKind==1u)return byte==instruction.matcherFirst;if(instruction.matcherKind==2u)return lua_class(instruction.matcherFirst,byte)!=(instruction.matcherSecond!=0u);bool found=false;for(uint32_t i=0;i<instruction.dataCount;i++){LuaMember member=members[instruction.dataStart+i];bool matched=member.kind==0u?byte==member.first:(member.kind==1u?byte>=member.first&&byte<=member.second:lua_class(member.first,byte)!=(member.negated!=0u));found|=matched;}return found!=(instruction.matcherFirst!=0u);}
UKL_INLINE bool lua_push(UKL_GLOBAL uint32_t* work,uint32_t base,uint32_t stride,uint32_t maximum,UKL_PRIVATE uint32_t* count,uint32_t item,uint32_t at,uint32_t current,uint32_t slots){if((*count)>=maximum)return false;uint32_t target=base+(*count)*stride;work[target]=item;work[target+1u]=at;for(uint32_t i=0;i<slots*3u;i++)work[target+2u+i]=work[current+i];(*count)++;return true;}
UKL_LARGE uint32_t nfa_ordered_closure(ValueRecord value,uint32_t state,uint32_t at,UKL_GLOBAL const uint8_t* source,uint32_t inputStart,uint32_t inputEnd,Task task,UKL_GLOBAL const NfaState* states,UKL_GLOBAL const uint32_t* data,UKL_GLOBAL uint32_t* work,uint32_t outputStart,UKL_PRIVATE uint32_t* outputCount,UKL_PRIVATE uint32_t* steps,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,uint32_t valueBase,uint32_t valueCapacity){uint32_t n=value.stateCount,seenStart=valueBase,stackStart=seenStart+n;uint32_t stackCount=0u;if(state>=n)return 2u;work[stackStart+stackCount++]=state;while(stackCount){if(++(*steps)>step_limit(task))return 3u;uint32_t current=work[stackStart+--stackCount];if(current>=n)return 2u;if(work[seenStart+current])continue;work[seenStart+current]=1u;NfaState found=states[value.stateStart+current];if(found.kind==0u||found.kind==5u){if((*outputCount)>=n)return 4u;work[outputStart+(*outputCount)++]=current;}else if(found.kind==1u){uint32_t matched=look_matches(found.dataStart,source,inputStart,inputEnd,at,data);if(matched==2u)return 2u;if(matched){if(stackCount>=n)return 4u;work[stackStart+stackCount++]=found.next;}}else if(found.kind==2u){for(uint32_t index=found.dataCount;index>0u;index--){if(stackCount>=n)return 4u;work[stackStart+stackCount++]=data[found.dataStart+index-1u];}}else if(found.kind==3u){if(stackCount>=n)return 4u;work[stackStart+stackCount++]=found.next;}else if(found.kind!=4u)return 2u;}return 0u;}
UKL_LARGE uint64_t nfa_find(ValueRecord value,UKL_GLOBAL const uint8_t* source,uint32_t inputStart,uint32_t inputEnd,uint32_t candidate,Task task,UKL_GLOBAL const NfaState* states,UKL_GLOBAL const uint32_t* data,UKL_GLOBAL const NfaRange* ranges,UKL_GLOBAL uint32_t* work,UKL_PRIVATE uint32_t* steps,UKL_PRIVATE uint32_t* error,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,uint32_t valueBase,uint32_t valueCapacity){uint32_t n=value.stateCount;if(n==0u){(*error)=2u;return (uint64_t)(-1);}if(valueCapacity<n*4u){(*error)=4u;return (uint64_t)(-1);}uint32_t seen=valueBase,current=seen+2u*n,next=seen+3u*n;for(uint32_t i=0;i<n;i++)work[seen+i]=0u;uint32_t currentCount=0u;(*error)=nfa_ordered_closure(value,value.auxiliary,candidate,source,inputStart,inputEnd,task,states,data,work,current,&(currentCount),steps,evaluation,globalArenas,valueBase,valueCapacity);if((*error))return (uint64_t)(-1);uint32_t fallback=NONE;for(uint32_t at=candidate;;at++){uint32_t limit=currentCount;for(uint32_t i=0;i<currentCount;i++)if(states[value.stateStart+work[current+i]].kind==5u){fallback=at;limit=i;break;}if(at==inputEnd){if(fallback!=NONE)return ((uint64_t)(candidate)<<32u)|fallback;return (uint64_t)(-1);}for(uint32_t i=0;i<n;i++)work[seen+i]=0u;uint32_t nextCount=0u;for(uint32_t index=0;index<limit;index++){NfaState state=states[value.stateStart+work[current+index]];for(uint32_t rangeIndex=0;rangeIndex<state.dataCount;rangeIndex++){if(++(*steps)>step_limit(task)){(*error)=3u;return (uint64_t)(-1);}NfaRange range=ranges[state.dataStart+rangeIndex];uint8_t byte=source[at];if(byte>=range.start&&byte<=range.end){(*error)=nfa_ordered_closure(value,range.target,at+1u,source,inputStart,inputEnd,task,states,data,work,next,&(nextCount),steps,evaluation,globalArenas,valueBase,valueCapacity);if((*error))return (uint64_t)(-1);}}}if(nextCount==0u){if(fallback!=NONE)return ((uint64_t)(candidate)<<32u)|fallback;return (uint64_t)(-1);}uint32_t swap=current;current=next;next=swap;currentCount=nextCount;}}
UKL_LARGE uint32_t evaluate_lua(ValueRecord value,UKL_GLOBAL const LuaInstruction* instructions,UKL_GLOBAL const LuaMember* members,UKL_GLOBAL const uint8_t* source,Node node,Task task,UKL_GLOBAL uint32_t* work,UKL_PRIVATE uint32_t* steps,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,uint32_t valueBase,uint32_t valueCapacity){uint32_t slots=value.operand>>2u,stride=2u+slots*3u,currentWords=slots*3u;if(valueCapacity<stride+currentWords)return 4u;uint32_t maximum=(valueCapacity-currentWords)/stride,current=valueBase+maximum*stride,count=0u;for(uint32_t i=0;i<currentWords;i++)work[current+i]=0u;if(value.operand&1u){if(!lua_push(work,valueBase,stride,maximum,&(count),0u,Node_sourceStart(node),current,slots))return 4u;}else for(uint32_t cursor=Node_sourceEnd(node)+1u;cursor>Node_sourceStart(node);cursor--)if(!lua_push(work,valueBase,stride,maximum,&(count),0u,cursor-1u,current,slots))return 4u;while(count){uint32_t record=valueBase+(--count)*stride,item=work[record],at=work[record+1u];for(uint32_t i=0;i<currentWords;i++)work[current+i]=work[record+2u+i];while(true){if(++(*steps)>step_limit(task))return 3u;if(item>=value.stateCount){if(!(value.operand&2u)||at==Node_sourceEnd(node))return 1u;break;}LuaInstruction instruction=instructions[value.stateStart+item];if(instruction.kind==0u){uint32_t available=0u;while(at+available<Node_sourceEnd(node)&&lua_match(instruction,source[at+available],members))available++;uint32_t minimum=1u,maximumCount=1u;bool greedy=true;if(instruction.first==1u){minimum=0u;maximumCount=ukl_min(1u,available);}else if(instruction.first==2u){minimum=0u;maximumCount=available;}else if(instruction.first==3u){minimum=0u;maximumCount=available;greedy=false;}else if(instruction.first==4u){minimum=1u;maximumCount=available;}if(available<minimum)break;if(greedy){for(uint32_t used=minimum;used<=maximumCount;used++)if(!lua_push(work,valueBase,stride,maximum,&(count),item+1u,at+used,current,slots))return 4u;}else{for(uint32_t used=maximumCount+1u;used>minimum;used--)if(!lua_push(work,valueBase,stride,maximum,&(count),item+1u,at+used-1u,current,slots))return 4u;}break;}if(instruction.kind==1u){uint8_t previous=at>Node_sourceStart(node)?source[at-1u]:0u,currentByte=at<Node_sourceEnd(node)?source[at]:0u;if(lua_match(instruction,previous,members)||!lua_match(instruction,currentByte,members))break;item++;continue;}if(instruction.kind==2u){if(at>=Node_sourceEnd(node)||source[at]!=instruction.first)break;uint32_t depth=1u,end=at+1u;while(end<Node_sourceEnd(node)){if(++(*steps)>step_limit(task))return 3u;if(source[end]==instruction.first)depth++;else if(source[end]==instruction.second&&--depth==0u)break;end++;}if(depth)break;at=end+1u;item++;continue;}uint32_t slot=instruction.first;if(slot>=slots)return 2u;uint32_t capture=current+slot*3u;if(instruction.kind==3u){work[capture]=1u;work[capture+1u]=at;item++;continue;}if(instruction.kind==4u){if(work[capture]!=1u)break;work[capture]=2u;work[capture+2u]=at;item++;continue;}if(instruction.kind==5u){work[capture]=3u;work[capture+1u]=at;item++;continue;}if(instruction.kind==6u){if(work[capture]!=2u)break;uint32_t start=work[capture+1u],end=work[capture+2u],length=end-start;if(at+length>Node_sourceEnd(node))break;bool equal=true;for(uint32_t i=0;i<length;i++)equal&=source[start+i]==source[at+i];if(!equal)break;at+=length;item++;continue;}return 2u;}}return 0u;}
UKL_LARGE uint32_t evaluate_text(UKL_GLOBAL const ValueRecord* values,UKL_GLOBAL const StringRecord* strings,UKL_GLOBAL const NfaState* nfaStates,UKL_GLOBAL const uint32_t* nfaData,UKL_GLOBAL const NfaRange* nfaRanges,UKL_GLOBAL const LuaInstruction* luaInstructions,UKL_GLOBAL const LuaMember* luaMembers,UKL_GLOBAL uint32_t* valueWork,UKL_GLOBAL const uint8_t* stringBytes,UKL_GLOBAL const uint8_t* source,Program program,Node node,Task task,uint32_t value,UKL_PRIVATE uint32_t* steps,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,uint32_t valueBase,uint32_t valueCapacity){if(value>=program.valueCount)return 2u;ValueRecord found=values[program.valueStart+value];if(found.kind==2u)return evaluate_nfa(found,source,node,task,nfaStates,nfaData,nfaRanges,valueWork,steps,evaluation,globalArenas,valueBase,valueCapacity);if(found.kind==3u)return evaluate_lua(found,luaInstructions,luaMembers,source,node,task,valueWork,steps,evaluation,globalArenas,valueBase,valueCapacity);if(found.kind>1u)return 2u;uint32_t stringId=found.operand;if(stringId>=program.stringCount)return 2u;StringRecord expected=strings[program.stringStart+stringId];uint32_t actualLength=Node_sourceEnd(node)-Node_sourceStart(node);if(found.kind==0u&&actualLength!=expected.length)return 0u;if(found.kind==1u&&actualLength<expected.length)return 0u;for(uint32_t i=0;i<expected.length;i++)if(source[Node_sourceStart(node)+i]!=stringBytes[expected.start+i])return 0u;return 1u;}
UKL_INLINE uint32_t label_count(UKL_GLOBAL const Link* captures,Task task,uint32_t head,uint32_t label,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){uint32_t count=0u;while(head){Link capture=captures[head-1u];if(capture.first==label)count++;head=capture.previous;}return count;}
UKL_INLINE uint32_t label_node(UKL_GLOBAL const Link* captures,Task task,uint32_t head,uint32_t label,uint32_t ordinal,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){uint32_t count=label_count(captures,task,head,label,evaluation,globalArenas),newest=count-1u-ordinal,index=0u;while(head){Link capture=captures[head-1u];if(capture.first==label){if(index==newest)return capture.second;index++;}head=capture.previous;}return NONE;}
// Bytes `at` to `at + n` (`n` of 1 to 4) of `s`, little-endian, from the aligned words that hold them: `s` is a
// buffer's start (the batch's block, the strings' bytes), and only a word one of the bytes lies in is read (Q54).
UKL_INLINE uint32_t source_bytes(UKL_GLOBAL const uint8_t* s,uint32_t at,uint32_t n){UKL_GLOBAL const uint32_t* words=(UKL_GLOBAL const uint32_t*)(s+(at&~3u));uint32_t shift=(at&3u)*8u,w=words[0]>>shift;if(shift!=0u&&(at&3u)+n>4u)w|=words[1]<<(32u-shift);return n==4u?w:w&((1u<<(8u*n))-1u);}
// Whether `length` bytes of `a` from `at` and of `b` from `bt` are equal: a word at a time, no step a byte (Q54).
UKL_INLINE bool bytes_equal(UKL_GLOBAL const uint8_t* a,uint32_t at,UKL_GLOBAL const uint8_t* b,uint32_t bt,uint32_t length){for(uint32_t i=0u;i<length;i+=4u){uint32_t n=ukl_min(4u,length-i);if(source_bytes(a,at+i,n)!=source_bytes(b,bt+i,n))return false;}return true;}
UKL_INLINE bool text_equal(Node left,Node right,UKL_GLOBAL const uint8_t* source){uint32_t length=Node_sourceEnd(left)-Node_sourceStart(left);if(length!=Node_sourceEnd(right)-Node_sourceStart(right))return false;return bytes_equal(source,Node_sourceStart(left),source,Node_sourceStart(right),length);}
UKL_INLINE bool string_equal(Node node,StringRecord value,UKL_GLOBAL const uint8_t* source,UKL_GLOBAL const uint8_t* bytes){uint32_t length=Node_sourceEnd(node)-Node_sourceStart(node);if(length!=value.length)return false;return bytes_equal(source,Node_sourceStart(node),bytes,value.start,length);}
// Row `row` of the batch's rows over its nodes (`supertypes`: a record of the derived classes and the words a row,
// then the rows), node `node`'s bit: a contains test's row is the text layer's, made with the batch (Q54).
UKL_INLINE bool batch_row(UKL_GLOBAL const Supertype* rows,uint32_t row,uint32_t node){uint32_t words=rows[0].kind;UKL_GLOBAL const uint32_t* bits=(UKL_GLOBAL const uint32_t*)(rows+1);return (bits[row*words+node/32u]>>(node%32u)&1u)!=0u;}
UKL_INLINE uint32_t node_line(File file,Node node,UKL_PRIVATE const LineTable* starts){return line_of(starts,Node_sourceStart(node));}
UKL_LARGE uint32_t evaluate_assertion(Assertion assertion,UKL_GLOBAL const uint32_t* data,UKL_GLOBAL const Link* captures,uint32_t head,Task task,File file,Program program,UKL_PRIVATE const NodeTable* nodes,UKL_GLOBAL const Supertype* supertypes,UKL_GLOBAL const uint8_t* source,UKL_GLOBAL const StringRecord* strings,UKL_GLOBAL const uint8_t* stringBytes,UKL_GLOBAL const ValueRecord* values,UKL_GLOBAL const NfaState* nfaStates,UKL_GLOBAL const uint32_t* nfaData,UKL_GLOBAL const NfaRange* nfaRanges,UKL_GLOBAL const LuaInstruction* luaInstructions,UKL_GLOBAL const LuaMember* luaMembers,UKL_GLOBAL uint32_t* valueWork,UKL_PRIVATE const LineTable* lineStarts,UKL_PRIVATE uint32_t* steps,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,uint32_t valueBase,uint32_t valueCapacity){bool any=(assertion.flags&2u)!=0u,positive=any?false:true,negative=any?false:true;uint32_t resultCount=0u,labelled=0u;if(assertion.kind==0u||assertion.kind==6u){uint32_t count=ukl_min(label_count(captures,task,head,assertion.first,evaluation,globalArenas),label_count(captures,task,head,assertion.second,evaluation,globalArenas));for(uint32_t i=0;i<count;i++){uint32_t left=label_node(captures,task,head,assertion.first,i,evaluation,globalArenas),right=label_node(captures,task,head,assertion.second,i,evaluation,globalArenas);bool result=assertion.kind==0u?text_equal(node_at(nodes,left),node_at(nodes,right),source):node_line(file,node_at(nodes,left),lineStarts)==node_line(file,node_at(nodes,right),lineStarts);positive=any?(positive||result):(positive&&result);negative=any?(negative||!result):(negative&&!result);resultCount++;}}else{uint32_t count=label_count(captures,task,head,assertion.first,evaluation,globalArenas);labelled=count;for(uint32_t i=0;i<count;i++){uint32_t nodeId=label_node(captures,task,head,assertion.first,i,evaluation,globalArenas);Node node=node_at(nodes,nodeId);bool result=false;if(assertion.kind==1u){uint32_t outcome=evaluate_text(values,strings,nfaStates,nfaData