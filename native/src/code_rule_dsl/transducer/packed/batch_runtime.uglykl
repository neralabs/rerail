}
// A resident label batch's task (decision 0033): no task records. Its evaluation names its
// program, its document and its roots' rule in `roots` (the run's, bound in place of the tasks);
// task `index` is a group of 64 of the document's nodes, and a root of it (`root_mask`) is `local`.
UKL_INLINE Task resident_task(UKL_GLOBAL const uint8_t* chunk,DocView doc,UKL_GLOBAL const Evaluation* evaluation,uint32_t evaluationIndex,uint32_t index,uint32_t here){
 {Task ukl_item={evaluationIndex,index,evaluation->file,evaluation->program,doc.node_base+here,0u,resident_work(chunk,doc,evaluation->workLimit,here)};return ukl_item;}
}
// The evaluation holding task `index`: tasks are numbered through the evaluations in order.
UKL_INLINE uint32_t resident_evaluation(UKL_GLOBAL const Evaluation* evaluations,uint32_t count,uint32_t index){uint32_t low=0u,high=count;while(high-low>1u){uint32_t middle=(low+high)/2u;if(evaluations[middle].taskStart<=index)low=middle;else high=middle;}return low;}
#endif

UKL_INLINE void run_task(Task task,UKL_GLOBAL const BatchHeader* header,UKL_GLOBAL const DocView* files,UKL_GLOBAL const uint8_t* nodes,UKL_GLOBAL const Program* programs,UKL_GLOBAL const uint32_t* words,UKL_GLOBAL const uint64_t* longs,UKL_GLOBAL const uint8_t* children,UKL_GLOBAL const Supertype* supertypes,UKL_GLOBAL Pending* pending,UKL_GLOBAL Link* captures,UKL_GLOBAL Link* cursors,UKL_GLOBAL RepeatLink* repeats,UKL_GLOBAL uint8_t* schedulerStorage,UKL_GLOBAL Result* results,UKL_GLOBAL Status* status,UKL_GLOBAL const ValueRecord* values,UKL_GLOBAL const StringRecord* strings,UKL_GLOBAL const NfaState* nfaStates,UKL_GLOBAL const uint32_t* nfaData,UKL_GLOBAL const NfaRange* nfaRanges,UKL_GLOBAL const LuaInstruction* luaInstructions,UKL_GLOBAL const LuaMember* luaMembers,UKL_GLOBAL const Assertion* assertions,UKL_GLOBAL const uint32_t* assertionData,UKL_GLOBAL const uint8_t* stringBytes,UKL_GLOBAL const uint8_t* source,UKL_GLOBAL uint32_t* valueWork,UKL_GLOBAL const uint8_t* lineStarts,UKL_GLOBAL FinalCapture* finalCaptures,UKL_GLOBAL uint8_t* outputStorage,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL Evaluation* sharedEvaluation){
 DocView doc=files[task.file];UKL_GLOBAL const uint8_t* chunk=nodes;
 NodeTable nodeTable={chunk,doc};LineTable lineTable={chunk,doc};FileTable fileTable={files};
 run_task_in(task,header,&(fileTable),&(nodeTable),programs,words,longs,children,supertypes,pending,captures,cursors,repeats,schedulerStorage,results,status,values,strings,nfaStates,nfaData,nfaRanges,luaInstructions,luaMembers,assertions,assertionData,stringBytes,tape_doc(chunk,doc)+doc.source-doc.source_base,valueWork,&(lineTable),finalCaptures,outputStorage,evaluation,sharedEvaluation);
}



// A lane's lazy arenas, each taken from its global arena when the lane first needs it; whether one is full.
UKL_INLINE bool lane_arenas_full(UKL_GLOBAL Evaluation* lane,UKL_GLOBAL GlobalArenas* globalArenas){
 uint32_t ignored=0u;
 return (lane->pending.limit&&ensure_lazy_block(&lane->pending,&globalArenas->arenas[0],&ignored))||
    (lane->capture.limit&&ensure_lazy_block(&lane->capture,&globalArenas->arenas[1],&ignored))||
    (lane->cursor.limit&&ensure_lazy_block(&lane->cursor,&globalArenas->arenas[2],&ignored))||
    (lane->repeat.limit&&ensure_lazy_block(&lane->repeat,&globalArenas->arenas[3],&ignored))||
    (lane->valueState.limit&&ensure_lazy_block(&lane->valueState,&globalArenas->arenas[8],&ignored))||
    (lane->candidate.limit&&ensure_lazy_block(&lane->candidate,&globalArenas->arenas[9],&ignored))||
    (lane->queryBucket.limit&&ensure_lazy_block(&lane->queryBucket,&globalArenas->arenas[4],&ignored))||
    (lane->queryMember.limit&&ensure_lazy_block(&lane->queryMember,&globalArenas->arenas[5],&ignored))||
    (lane->queuedState.limit&&ensure_lazy_block(&lane->queuedState,&globalArenas->arenas[6],&ignored))||
    (lane->greedyEntry.limit&&ensure_lazy_block(&lane->greedyEntry,&globalArenas->arenas[7],&ignored));
}

// A lane's quotas for a task of `evaluation`: its limits, and nothing used (the pending arena's use is the lane's).
UKL_INLINE void lane_begin(UKL_GLOBAL Evaluation* lane,UKL_GLOBAL const Evaluation* evaluation){
 lane->generation+=2u;
 for(uint32_t kind=0u;kind<=9u;kind++)lane->quotas[kind].limit=evaluation->quotas[kind].limit;
 for(uint32_t kind=1u;kind<=9u;kind++)ukl_atomic_store(&lane->quotas[kind].used,0u);
}

// The batch's rows, in the slots' order (`metal_program_backend`'s binds): the tasks (a resident batch's roots'
// rule), the header, the documents and their block, the programs, the scheduler's storage, and the outputs.
DEFINE_KERNEL2(batch_runtime, run_batch,
               ROBUFFER, Task,           tasks,           "[header.taskCount]",
               ROBUFFER, BatchHeader,    header,          "[1]",
               ROBUFFER, DocView,        files,           "[header.fileCount]",
               ROBUFFER, uint8_t,        nodes,           "[the batch's block]",
               ROBUFFER, Program,        programs,        "[header.programCount]",
               ROBUFFER, uint32_t,       words,           "[header.structuralWordCount]",
               ROBUFFER, uint64_t,       longs,           "[longs]",
               ROBUFFER, uint8_t,        children,        "[header.childCount]",
               ROBUFFER, Supertype,      supertypes,      "[header.supertypeCount]",
               RWBUFFER, Pending,        pending,         "[arena 0]",
               RWBUFFER, Link,           captures,        "[arena 1]",
               RWBUFFER, Link,           cursors,         "[arena 2]",
               RWBUFFER, RepeatLink,     repeats,         "[arena 3]",
               RWBUFFER, uint8_t,        schedulerStorage, "[header's scheduler bytes]",
               RWBUFFER, Result,         results,         "[results]",
               RWBUFFER, Status,         statuses,        "[header.taskCount]",
               ROBUFFER, ValueRecord,    values,          "[header.valueInstructionCount]",
               ROBUFFER, StringRecord,   strings,         "[header.stringCount]",
               ROBUFFER, NfaState,       nfaStates,       "[nfa states]",
               ROBUFFER, uint32_t,       nfaData,         "[nfa data]",
               ROBUFFER, NfaRange,       nfaRanges,       "[nfa ranges]",
               ROBUFFER, LuaInstruction, luaInstructions, "[lua instructions]",
               ROBUFFER, LuaMember,      luaMembers,      "[lua members]",
               ROBUFFER, Assertion,      assertions,      "[assertions]",
               ROBUFFER, uint32_t,       assertionData,   "[assertion data]",
               ROBUFFER, uint8_t,        stringBytes,     "[string bytes]",
               ROBUFFER, uint8_t,        source,          "[the batch's source]",
               RWBUFFER, uint32_t,       valueWork,       "[value work]",
               ROBUFFER, uint8_t,        lineStarts,      "[the batch's block]",
               RWBUFFER, FinalCapture,   finalCaptures,   "[final captures]",
               RWBUFFER, uint8_t,        outputStorage,   "[output bytes]",
               GID0, uint32_t, tid, )
{
 // A lowered matcher's round already settled (`metal_label_passes`): the label prefix head says skip.
 if(header->supertypeCount!=0u&&(supertypes[0].node&0x80000000u)!=0u)return;
 UKL_GLOBAL GlobalArenas* globalArenas=(UKL_GLOBAL GlobalArenas*)schedulerStorage;
 UKL_GLOBAL Evaluation* evaluations=(UKL_GLOBAL Evaluation*)(schedulerStorage+sizeof(GlobalArenas));
 UKL_GLOBAL Evaluation* lane=evaluations+header->evaluationCount+tid;
 if(lane_arenas_full(lane,globalArenas)){
#ifdef RERAIL_RESIDENT
  statuses[tid].error=2u;
#else
  for(uint32_t task=0u;task<header->taskCount;task++)statuses[task].error=2u;
#endif
  return;
 }
#ifdef RERAIL_RESIDENT
 // A lane's status is its own, reused by its tasks; it keeps their first error (`label_sink`).
 UKL_GLOBAL const uint8_t* chunk=nodes;
 UKL_GLOBAL Status* status=&statuses[tid];
 uint32_t firstError=0u;
#endif
 while(true){
  uint32_t task=ukl_atomic_add(&globalArenas->taskCursor,1u);
  if(task>=header->taskCount)break;
#ifdef RERAIL_RESIDENT
  uint32_t evaluationIndex=resident_evaluation(evaluations,header->evaluationCount,task);
  UKL_GLOBAL Evaluation* evaluation=&evaluations[evaluationIndex];
  DocView rootDoc=files[evaluation->file];
  uint32_t rootGroup=task-evaluation->taskStart;
  uint64_t rootMask=root_mask(chunk,rootDoc,(UKL_GLOBAL const uint32_t*)tasks,evaluation->rootRule,evaluation->file,rootGroup);
  ROOTS_EACH(rootMask,rootGroup,rootLocal){
   Task own=resident_task(chunk,rootDoc,evaluation,evaluationIndex,task,rootLocal);
   lane_begin(lane,evaluation);
   run_task(own,header,files,nodes,programs,words,longs,children,supertypes,pending,captures,cursors,repeats,schedulerStorage,results,status,values,strings,nfaStates,nfaData,nfaRanges,luaInstructions,luaMembers,assertions,assertionData,stringBytes,source,valueWork,lineStarts,finalCaptures,outputStorage,lane,evaluation);
   // A stop at a budget below the ceiling is an overrun (decision 0334): the run is replanned, not failed. Its
   // evaluation records it (bit 1; bit 2 a stop at the ceiling), which the host reads to replan that evaluation alone
   // (`Runner::unfinished`).
   if(status->error==4u&&own.workLimit<(1u<<26u))status->error=8u;
   if(status->error==8u||status->error==4u)ukl_atomic_or(&evaluation->outcome,status->error==8u?1u:2u);
   if(firstError==0u)firstError=status->error;
  }
#else
  UKL_GLOBAL Evaluation* evaluation=&evaluations[tasks[task].evaluation];
  Task own=tasks[task];
  lane_begin(lane,evaluation);
  run_task(own,header,files,nodes,programs,words,longs,children,supertypes,pending,captures,cursors,repeats,schedulerStorage,results,&statuses[task],values,strings,nfaStates,nfaData,nfaRanges,luaInstructions,luaMembers,assertions,assertionData,stringBytes,source,valueWork,lineStarts,finalCaptures,outputStorage,lane,evaluation);
#endif
 }
#ifdef RERAIL_RESIDENT
 statuses[tid].error=firstError;
#endif
}
