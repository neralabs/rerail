UKL_LARGE bool step_child(uint32_t op,uint32_t mode,Node node,UKL_PRIVATE const NodeTable* nodes,UKL_GLOBAL const uint32_t* words,UKL_GLOBAL Link* captures,UKL_GLOBAL Link* cursors,UKL_GLOBAL RepeatLink* repeats,UKL_GLOBAL QueuedState* queuedStates,UKL_GLOBAL Pending* pending,Task task,Program program,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas,UKL_GLOBAL Status* status,UKL_PRIVATE Path* pathAt,UKL_PRIVATE uint32_t* pendingCountAt,UKL_PRIVATE bool* keepAt){Path path=*pathAt;uint32_t pendingCount=*pendingCountAt;bool keep=*keepAt;{uint32_t first=NONE;if(op==16u){for(uint32_t child=path.node+1u;child<Node_descendantEnd(node);child=node_end(nodes,child))if(mode==0u||(node_flags(nodes,child)&1u)){first=child;break;}if(first!=NONE){uint32_t pushed=pendingCount;for(uint32_t alternate=node_end(nodes,first);alternate<Node_descendantEnd(node);alternate=node_end(nodes,alternate))if(mode==0u||(node_flags(nodes,alternate)&1u)){Path branch=path;branch.node=alternate;branch.pc++;if(enqueue_path(pending,task,program,words,queuedStates,captures,cursors,repeats,&(pendingCount),branch,0u,evaluation,globalArenas)==2u){status->error=2u;return false;}}for(uint32_t low=evaluation->pending.start+pushed,high=evaluation->pending.start+pendingCount;high>low+1u;low++,high--){Pending swap=pending[low];pending[low]=pending[high-1u];pending[high-1u]=swap;}}}else{for(uint32_t child=path.node+1u;child<Node_descendantEnd(node);child++)if(mode==0u||(node_flags(nodes,child)&1u)){first=child;break;}if(first!=NONE)for(uint32_t child=Node_descendantEnd(node);child>first+1u;child--){uint32_t alternate=child-1u;if(mode==0u||(node_flags(nodes,alternate)&1u)){Path branch=path;branch.node=alternate;branch.pc++;if(enqueue_path(pending,task,program,words,queuedStates,captures,cursors,repeats,&(pendingCount),branch,0u,evaluation,globalArenas)==2u){status->error=2u;return false;}}}}if(first==NONE)keep=false;else path.node=first;}*pathAt=path;*pendingCountAt=pendingCount;*keepAt=keep;r