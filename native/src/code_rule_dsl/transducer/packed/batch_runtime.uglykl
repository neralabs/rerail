UKL_INLINE Link capture_oldest(UKL_GLOBAL const Link* captures,Task task,uint32_t head,uint32_t count,uint32_t ordinal,UKL_GLOBAL Evaluation* evaluation,UKL_GLOBAL GlobalArenas* globalArenas){uint32_t wanted=count-1u-ordinal,index=0u;while(head){Link capture=captures[head-1u];if(index++==wanted)return capture;head=capture.previous;}{Link ukl_item={0u,0u,NONE};return ukl_item;}}
UKL_INLINE uint32_t line_for(File file,uint32_t byte,UKL_PRIVATE const LineTable* starts){return line_of(starts,byte);}
UKL_INLINE uint32_t byte_for(File file,int row,int column,UKL_PRIVATE const LineTable* starts,UKL_GLOBAL const uint8_t* source){if(row<0||column<0||(uint32_t)(row)>=file.line_count)return NONE;uint32_t start=line_start(starts,(uint32_t)(row)),end=(uint32_t)(row)+1u<file.line_count?line_start(starts,(uint32_t)(row)+1u)-1u:file.sourceStart+file.source_length;uint32_t byte=start+(uint32_t)(column);if(byte>end||(byte<file.sourceStart+file.source_length&&(source[byte]&0xc0u)==0x80u))return NONE;return byte;}
UKL_INLINE Property property_of(uint32_t kind,uint32_t owner,uint32_t key,uint32_t value,uint32_t keyStart,uint32_t keyLength,uint32_t valueStart,uint32_t valueLength){Property p={kind,owner,key,value,keyStart,keyLength,valueStart,valueLength};return p;}
