raw_fstring_parts(p, v) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"any": [{"any": [{"filePath": {"regex": "^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$"}}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$)"}}]}]}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:l9750_graphql/|l2080_lazy_orm/|l2060_query_builder/|l9900_auto_api/)"}}]}]}}}}, "default": {"filePath": {"regex": "(?s).*"}}}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^(?:fr|rf|f)[\"']"}, {"not": {"inside": {"kind": "concatenated_string", "stopBy": "neighbor"}}}]}, {"all": [{"kind": "concatenated_string"}, {"has": {"all": [{"kind": "string"}, {"regex": "(?i)^(?:fr|rf|f)[\"']"}], "stopBy": "end"}}]}]}, {"parse": {"grammar": "pythonFString", "has": {"kind": "literal", "capture": "PART"}}}]}]}}, PART: p), text(p, v).
// each IMPORTED, anchored at the statement. ALIAS is bound by one `any` branch only: read by the tree relations of
