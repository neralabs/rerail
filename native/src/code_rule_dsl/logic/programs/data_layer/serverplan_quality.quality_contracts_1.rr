// data-layer-serverplan-quality in Rerail logic: clause `quality-contracts-1` (part file; the rule's header, `.policy`
// and its other clauses are in serverplan_quality.rdl). Options at their defaults: oracleAnalyzer false, entryPoint
// "all" (every `diagnostics_N` stage takes its `all` case; the matchers keep their `$option` objects verbatim).
// Source: gate/data-layer/packs/data-layer/candidates/rules/data-layer-serverplan-quality.json.
//
// One relation per SQL stage, under the stage's name. The clause is per file (partitionBy file): a row keyed by
// (__path, __start) is a node, and a join on __path is implied by the node. W's `syntax` declaration (`nodes`, `edges`,
// `ownership`) maps to the tape: `nodes` = `snode` (gated by `syntax_gate`, excludeKinds dropped), `parent` /
// `edge_parent` / `edges` = `child`, `X_id` / `X_start` / `X_kind` / `X_source` = `field` + `node` / `kind` / `text`,
// `ordinal` = `ordinal` (rank among the visible children), `ownership.fn` / `.cls` = nearest function / class
// ancestor-or-self (`own_fn`, `own_cls`; `top_fn` is not read). The `descendants` and `import_descendants` reachability
// stages (ancestor-or-self over visible nodes, from their roots) are `@within`. A nullable column is a side relation
// that holds where it is not NULL; a boolean column is a side relation that holds where it is true.
//
// Builtins: @rx_matches, @rx_extract, @rx_replace, @substr, @length, @add, @sub, @concat, @printf, @instr, @lower,
// @trim, @within (tape); new: @id (a node's `nodes.id` as text, for identities and atom ids), @like (SQL LIKE: ASCII
// case-insensitive, `%` any run), @cast_int (SQL CAST(x AS INTEGER)), @substr_bytes (SQL substr over CAST(x AS BLOB),
// byte positions, read back as text). A builtin with no value (SQL NULL) binds nothing.
//
// OUTSIDE: call_paths (stage 30) — a path-text carrier: each node's dotted text is concatenated along attribute/call
//   chains (`path || suffix` recursion over path_edges, E0 #20, no lattice and no non-recursive tape form); declared
//   `.input call_paths` so execution_calls and its readers parse.
// missing fact: `parse` captures (raw_fstring_parts PART, quoted_atoms ATOM) are nodes of a string's re-parse
//   (grammars pythonFString, annotation), not tape nodes; they are read here through `node` / `text` as if the tape
//   held them.
// findings layer (§8): the final query's UNION ALL multiplicity (a set here) and its row key [detector, issue,
//   identity]; `identity` and `detector` stay columns of diagnostics_N, `finding`'s key is `issue` (the clause's code).
// findings layer (§8): file_starts rows anchor at `file.start`; here the module node they match.
// LIMIT/choice: `LIMIT 1` over the file's module node (scopes, scope_owners): a file has one module node; no choice.
// ties: none — every row_number() (class_levels, last_methods, last_module_functions, module_string_values) orders
//   by a node's start within one partition, and distinct nodes there have distinct starts.
// scoped_nodes (E0 #19), scope_chain (E0 #22): tree recursions, written without recursion — scoped_nodes as the
//   nearest def/class/lambda strict ancestor (`nearest`), scope_chain's depth as a count of enclosing functions.

.decl fdef(kind: symbol)
fdef("function_definition").
.decl cdef(kind: symbol)
cdef("class_definition").
.decl walk_stop(kind: symbol)
walk_stop("function_definition"). walk_stop("class_definition"). walk_stop("lambda").

.decl finding(clause: symbol, key: symbol, n: node)
.output finding

// ---- inputs (evidence) ----
// syntax_gate: the files whose syntax tables load (W's `gate`).
.decl syntax_gate(d: number)
syntax_gate(d) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"any": [{"any": [{"filePath": {"regex": "^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$"}}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$)"}}]}]}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:l9750_graphql/|l2080_lazy_orm/|l2060_query_builder/|l9900_auto_api/)"}}]}]}}}}, "default": {"filePath": {"regex": "(?s).*"}}}, {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "_check_batched_step_construction_sets_batching_hint": {"filePath": {"regex": "(?s).*"}}, "_check_branch_fetch_batchability_helper": {"filePath": {"regex": "(?s).*"}}, "_check_can_batch_lock_snapshot_policy": {"filePath": {"regex": "(?s).*"}}, "_check_compile_direct_io": {"filePath": {"regex": "(?s).*"}}, "_check_conditional_dialect_test_compiler_seam": {"filePath": {"regex": "(?s).*"}}, "_check_conditional_serverplan_fallback": {"filePath": {"regex": "(?s).*"}}, "_check_conditional_sql_compile_ownership": {"filePath": {"regex": "(?s).*"}}, "_check_contract_first_relationship_runtime": {"filePath": {"regex": "(?s).*"}}, "_check_control_flow_child_compile_calls": {"filePath": {"regex": "(?s).*"}}, "_check_duck_typed_context": {"filePath": {"regex": "(?s).*"}}, "_check_dynamic_child_steps": {"filePath": {"regex": "(?s).*"}}, "_check_executor_execute_runtime_bypass": {"filePath": {"regex": "(?s).*"}}, "_check_executor_python_execution": {"filePath": {"regex": "(?s).*"}}, "_check_forbidden_sqlcompoundwrite_usage": {"filePath": {"regex": "(?s).*"}}, "_check_graphql_serverplan_boundary": {"filePath": {"regex": "(?s).*"}}, "_check_imperative_lazy_resolution": {"filePath": {"regex": "(?s).*"}}, "_check_imperative_preop_execution": {"filePath": {"regex": "(?s).*"}}, "_check_include_through_shared_lowering": {"filePath": {"regex": "(?s).*"}}, "_check_intent_boilerplate": {"filePath": {"regex": "(?s).*"}}, "_check_lifecycle_entanglement": {"filePath": {"regex": "(?s).*"}}, "_check_materialized_row_semantics_fallback": {"filePath": {"regex": "(?s).*"}}, "_check_order_by_compile_helper_escape_hatches": {"filePath": {"regex": "(?s).*"}}, "_check_plan_analysis_field_reassignment": {"filePath": {"regex": "(?s).*"}}, "_check_plan_analysis_object_id_cache": {"filePath": {"regex": "(?s).*"}}, "_check_postop_hydration": {"filePath": {"regex": "(?s).*"}}, "_check_projection_helper_execution_fallback": {"filePath": {"regex": "(?s).*"}}, "_check_result_resolution_duplication": {"filePath": {"regex": "(?s).*"}}, "_check_runtime_replay_batching_uses_structured_analysis": {"filePath": {"regex": "(?s).*"}}, "_check_runtime_result_compiled_steps": {"filePath": {"regex": "(?s).*"}}, "_check_runtime_sequential_step_optins": {"filePath": {"regex": "(?s).*"}}, "_check_runtime_sequential_strategies": {"filePath": {"regex": "(?s).*"}}, "_check_serverplan_cleanup_ratchets": {"filePath": {"regex": "(?s).*"}}, "_check_serverplan_runtime_state_ingress": {"filePath": {"regex": "(?s).*"}}, "_check_sql_statement_batch_requires_category": {"filePath": {"regex": "(?s).*"}}, "_check_sync_async_duplication": {"filePath": {"regex": "(?s).*"}}, "_check_unused_raw_data": {"filePath": {"regex": "(?s).*"}}, "_check_vector_scope_filters_use_expressions": {"filePath": {"regex": "(?s).*"}}, "_check_versioned_forking": {"filePath": {"regex": "(?s).*"}}, "_check_serverplan_quality_source": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"kind": "module"}]}]}}).
