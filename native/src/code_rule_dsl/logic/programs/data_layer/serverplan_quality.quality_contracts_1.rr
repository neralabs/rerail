// The arms' shared path and source conditions.
.decl in_tests(d: number)
in_tests(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)tests(?:/|$)") = 1.
.decl steps_file(d: number)
steps_file(d) :- files(d, _), doc(d, p), @substr(p, 1, 36) = "impl/common/l2070_server_plan/steps/".
steps_file(d) :- files(d, _), doc(d, p), @substr(p, 1, 51) = "impl/common/l7300_sql_versioned_transactions/steps/".
steps_file(d) :- files(d, _), doc(d, p), @substr(p, 1, 40) = "impl/common/l9700_sql_graph_query/steps/".
// (p IN exec5 OR p IN ('…/sql_backend_executor.py')) AND NOT p = 'l2070_batching/executor.py'
.decl executor_scope(d: number)
executor_scope(d) :- files(d, _), doc(d, p), in_list("exec5", p), p != "l2070_batching/executor.py".
executor_scope(d) :- files(d, _), doc(d, "impl/common/l2070_server_plan/sql_backend_executor.py").
.decl exec_helper_source(d: number)
exec_helper_source(d) :- files(d, src), @rx_matches(src, "_execute_nested_steps|_execute_nested_steps_async|_execute_runtime_sequential_batch|_execute_runtime_sequential_batch_async|_execute_runtime_sequential_batch_async_impl|_execute_runtime_sequential_batch_sync|_execute_runtime_sequential_batch_sync_impl|_finish_replay_like_step|_force_runtime_conditionals|_prepare_runtime_sequential_child|_preprocess_replay_loop|_resolve_conditional|_resolve_conditional_step|_restore_runtime_conditionals|_start_runtime_sequential_batch|_store_runtime_sequential_child_result") = 1.
.decl prim_or_fallback(d: number)
prim_or_fallback(d) :- primary_file(d).
prim_or_fallback(d) :- fallback_file(d).
.decl graphql_file(d: number)
graphql_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)l9750_graphql/") = 1.
.decl graphql_executor_file(d: number)
graphql_executor_file(d) :- graphql_file(d), doc(d, p), @rx_matches(p, "(?:^|/)executor\\.py$") = 1.
.decl contract_first_file(d: number)
contract_first_file(d) :- files(d, _), !in_tests(d), doc(d, p), @rx_matches(p, "(?:^|/)(?:l9750_graphql|l9900_auto_api)/") = 1.
.decl relationship_compat_exempt(d: number)
relationship_compat_exempt(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)(?:schema_builder|__init__|graphql|relationship_compat)\\.py$") = 1.
.decl fallback_source(d: number)
fallback_source(d) :- files(d, src), @rx_matches(src, "_add_intent|_add_intent_by_ref|_get_lazy_plan|enqueue_lazy_plan_intent|execute_later|return_result") = 1,
    @rx_matches(src, "execute|execute_async|query|query_async|load_with_includes") = 1.
.decl executor_batch_file(d: number)
executor_batch_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)l2070_batching/(?:.*/)?executor\\.py$") = 1.
// Shared EXISTS subqueries.
.decl descendant_callee(r: node, callee: symbol)
descendant_callee(r, ce) :- descendants(r, c), calls(c, _, _, _, ce).
.decl descendant_attr(r: node, attr: symbol)
descendant_attr(r, a) :- descendants(r, x), attributes(x, a, _, _).
.decl string_argument(call: node, position: number, value: symbol)
string_argument(c, i, v) :- arguments(c, a, i), string_at(a, v).
.decl contains_(outer: node, inner: node)
contains_(o, n) :- functions(o, _), docof(o, d), node(d, o, _, os, oe), node(d, n, _, ns, ne), os <= ns, oe >= ne.
.decl not_async_text(f: node)
not_async_text(f) :- functions(f, _), text(f, t), @substr(t, 1, 5) != "async".

// ---- diagnostics_0 ----
.decl diagnostics_0(n: node, issue: symbol, identity: symbol, detector: symbol)
diagnostics_0(n, "SPQ-003", id, "_check_postop_hydration") :- functions(n, "post_op"), docof(n, d), doc(d, p), @rx_matches(p, "(?:^|/)_compile_helpers\\.py$") = 0,
    descendants(n, c), calls(c, _, _, "convert_row_db_to_python", _), steps_file(d), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-004", id, "_check_duck_typed_context") :- calls(n, _, _, fc, _), in_list("duck", fc), docof(n, d), doc(d, p), in_list("exec5", p),
    p != "l2070_batching/conditional_step.py", primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-005", id, "_check_versioned_forking") :- methods(n, c, "lower", _), base_names(c, "ServerPlanStep"),
    descendant_callee(n, "get_versioned_staging_ctx"), docof(n, d), steps_file(d), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-011", id, "_check_compile_direct_io") :- calls(n, _, "attribute", _, ce), in_list("direct_io", ce), method_nodes(_, c, "compile", _, n),
    base_names(c, "ServerPlanStep"), docof(n, d), files(d, src), @instr(src, "compile") > 0, @rx_matches(src, "cursor|execute|fetch") = 1, primary_file(d),
    id = @id(n).
diagnostics_0(n, "SPQ-015", id, "_check_runtime_sequential_step_optins") :- methods(n, c, "requires_runtime_sequential_batch", _), base_names(c, "ServerPlanStep"),
    literal_bools(n, "true"), docof(n, d), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-016", id, "_check_dynamic_child_steps") :- methods(n, c, name, _), in_list("child_step_methods", name), base_names(c, "ServerPlanStep"),
    docof(n, d), files(d, src), @instr(src, "child_steps") > 0, primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-016", id, "_check_dynamic_child_steps") :- attributes(n, attr, _, _), @rx_matches(attr, "(?:child_steps|materialized_terminal_steps)$") = 1,
    docof(n, d), node(d, n, _, s, e), node(d, l, _, s, e), field(as, "left", l), snode(as), kind(as, "assignment"),
    method_nodes(_, c, _, _, n), base_names(c, "ServerPlanStep"), files(d, src), @instr(src, "child_steps") > 0, primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-017", id, "_check_runtime_result_compiled_steps") :- calls(n, _, _, _, ce), in_list("compiled_step", ce), keywords(n, k, kn, v),
    in_list("runtime_result_kw", kn), kind(v, vk), vk != "none", docof(n, d), !in_tests(d), files(d, src), @instr(src, "runtime_result") > 0,
    primary_file(d), id = @id(k).
diagnostics_0(n, "SPQ-020", id, "_check_imperative_lazy_resolution") :- calls(n, _, "attribute", _, ce), in_list("lazy_resolution", ce), !has_argument(n),
    !keyword_any(n), docof(n, d), primary_file(d), id = @id(n).
.decl keyword_any(call: node)
keyword_any(c) :- keywords(c, _, _, _).
// callee = 'compile' OR callee LIKE 'Sql…' OR (callee = 'CompiledStep' AND a `grammar` keyword)
.decl spq021_callee(c: node)
spq021_callee(n) :- calls(n, _, _, _, "compile").
spq021_callee(n) :- calls(n, _, _, _, ce), @substr(ce, 1, 3) = "Sql".
spq021_callee(n) :- calls(n, _, _, _, "CompiledStep"), keyword_named(n, "grammar").
diagnostics_0(n, "SPQ-021", id, "_check_conditional_sql_compile_ownership") :- spq021_callee(n), docof(n, d), doc(d, "l2070_batching/conditional_step.py"),
    method_nodes(_, _, "compile", "ConditionalStep", n), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-022", id, "_check_control_flow_child_compile_calls") :- calls(n, _, _, _, "compile"), docof(n, d), doc(d, p),
    p != "impl/common/l2070_server_plan/steps/_conditional_compile.py", method_nodes(_, c, "compile", cn, n), in_list("control_flow_classes", cn),
    class_levels(c, 4), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-023", id, "_check_conditional_dialect_test_compiler_seam") :- calls(n, f, _, _, "compile"), docof(n, d),
    doc(d, "impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects.py"), attributes(f, _, _, ot), in_list("conditional_receivers", ot),
    primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-026", id, "_check_branch_fetch_batchability_helper") :- functions(n, "_can_batch_fetch_branch_and_staged"), docof(n, d),
    doc(d, "impl/common/l2070_server_plan/steps/commit_branch_steps.py"), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-027", id, "_check_plan_analysis_object_id_cache") :- calls(n, _, _, "id", _), docof(n, d), doc(d, "l2070_batching/optimizer.py"),
    arguments(n, a, 0), kind(a, "identifier"), text(a, "step"), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-027", id, "_check_plan_analysis_object_id_cache") :- py_names(n, "step_fact_step_ids"), docof(n, d), doc(d, "l2070_batching/optimizer.py"),
    primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-027", id, "_check_plan_analysis_object_id_cache") :- attributes(n, "step_fact_step_ids", _, _), docof(n, d), doc(d, "l2070_batching/optimizer.py"),
    primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-045", id, "_check_forbidden_sqlcompoundwrite_usage") :- py_names(n, "SqlCompoundWrite"), docof(n, d), !in_tests(d), doc(d, p),
    @rx_matches(p, "(?:^|/)stmt_compound_write\\.py$") = 0, primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-046", id, "_check_sql_statement_batch_requires_category") :- calls(n, _, _, _, "SqlStatementBatch"), !keyword_named(n, "category"),
    docof(n, d), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-048", id, "_check_batched_step_construction_sets_batching_hint") :- functions(n, _), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)batch_fusion\\.py$") = 1, descendant_callee(n, "PhysicalStatementGroup"), !descendant_callee(n, "_set_batching_metrics_hint"),
    primary_file(d), id = @id(n).
// sync: the last method / module function named the `_async` name less its suffix.
diagnostics_0(n, "SPQ-001", id, "_check_sync_async_duplication") :- methods(n, c, name, _), @substr(name, -6) = "_async",
    base = @substr(name, 1, @sub(@length(name), 6)), last_methods(sync, c, base), !abstract_functions(n), !abstract_functions(sync),
    statement_count(n, k), k > 3, docof(n, d), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-001", id, "_check_sync_async_duplication") :- methods(n, c, name, _), @substr(name, -6) = "_async",
    base = @substr(name, 1, @sub(@length(name), 6)), last_methods(sync, c, base), !abstract_functions(n), !abstract_functions(sync),
    statement_count(sync, k), k > 3, docof(n, d), primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-001", id, "_check_sync_async_duplication") :- module_functions(n, name), @substr(name, -6) = "_async",
    base = @substr(name, 1, @sub(@length(name), 6)), docof(n, d), last_module_functions(sync, base), docof(sync, d),
    statement_count(n, k), k > 3, primary_file(d), id = @id(n).
diagnostics_0(n, "SPQ-001", id, "_check_sync_async_duplication") :- module_functions(n, name), @substr(name, -6) = "_async",
    base = @substr(name, 1, @sub(@length(name), 6)), docof(n, d), last_module_functions(sync, base), docof(sync, d),
    statement_count(sync, k), k > 3, primary_file(d), id = @id(n).

// ---- diagnostics_1 ----
.decl earlier_statement(fn: node, s: node)
earlier_statement(f, s) :- statements(f, s, _), statements(f, o, _), start(o, os), start(s, ss), os < ss.
.decl raise_error_child(s: node)
raise_error_child(s) :- statements(_, s, "raise_statement"), visible_child(s, e), text(e, t), in_list("raise_errors", t).
raise_error_child(s) :- statements(_, s, "raise_statement"), visible_child(s, e), calls(e, _, _, fc, _), in_list("raise_errors", fc).
.decl inside_plan_analysis(n: node)
inside_plan_analysis(n) :- classes(c, "PlanAnalysis"), docof(c, d), node(d, c, _, cs, ce), node(d, n, _, ns, ne), snode(n), cs <= ns, ce >= ne.
.decl analysis_writer(n: node)
analysis_writer(n) :- own_fn(n, f), functions(f, fname), in_list("analysis_writers", fname), inside_plan_analysis(n).
// CASE stmt.kind WHEN if/elif THEN condition_id ELSE id
.decl lock_root(st: node, r: node)
lock_root(st, c) :- snode(st), kind(st, k), in_list("branch_kind", k), field(st, "condition", c).
lock_root(st, st) :- snode(st), kind(st, k), !in_list("branch_kind", k).
.decl lock_x(x: node)
lock_x(x) :- py_names(x, _), kind(x, "identifier").
lock_x(x) :- snode(x), kind(x, k), in_list("lock_x_kinds", k).
.decl diagnostics_1(n: node, issue: symbol, identity: symbol, detector: symbol)
diagnostics_1(n, "SPQ-002", id, "_check_intent_boilerplate") :- classes(n, _), base_names(n, "ServerPlanStep"), class_levels(n, 4),
    methods(m, n, "compile", _), statements(m, s, "raise_statement"), !earlier_statement(m, s), raise_error_child(s),
    docof(n, d), steps_file(d), primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-006", id, "_check_result_resolution_duplication") :- last_methods(n, c, "_execute_new_pipeline_async"),
    last_methods(sync, c, "_execute_new_pipeline"), descendant_attr(sync, "_returns"), descendant_attr(n, "_returns"), docof(n, d), doc(d, p),
    in_list("exec5", p), p != "l2070_batching/conditional_step.py", primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-007", id, "_check_lifecycle_entanglement") :- assignments(n, t), !assignment_typed(n), attributes(t, attr, _, _), in_list("plan_attrs", attr),
    docof(n, d), node(d, n, _, ns, ne), methods(own, _, on, _), on != "__init__", node(d, own, _, os, oe), os < ns, oe >= ne,
    doc(d, p), in_list("plan_state_paths", p), primary_file(d), id = @concat(@id(own), ":", @id(n)).
diagnostics_1(n, "SPQ-007", id, "_check_lifecycle_entanglement") :- assignments(n, t), !assignment_typed(n), attributes(t, attr, _, _), in_list("plan_attrs", attr),
    docof(n, d), node(d, n, _, ns, ne), module_functions(own, _), node(d, own, _, os, oe), os < ns, oe >= ne,
    doc(d, p), in_list("plan_state_paths", p), primary_file(d), id = @concat(@id(own), ":", @id(n)).
diagnostics_1(n, "SPQ-008", id, "_check_unused_raw_data") :- assignments(n, t), !assignment_typed(n), kind(t, tk), in_list("unpack_targets", tk),
    assignment_value(n, v), calls(v, _, _, _, "_build_query_spec_and_raw"), visible_child(t, el), ordinal(el, 1), kind(el, "identifier"), text(el, "_"),
    docof(n, d), steps_file(d), primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-024", id, "_check_order_by_compile_helper_escape_hatches") :- py_names(n, t), in_list("order_by_names", t), docof(n, d),
    doc(d, "impl/common/l2070_server_plan/steps/_compile_helpers.py"), primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-024", id, "_check_order_by_compile_helper_escape_hatches") :- attributes(n, t, _, _), in_list("order_by_names", t), docof(n, d),
    doc(d, "impl/common/l2070_server_plan/steps/_compile_helpers.py"), primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-024", id, "_check_order_by_compile_helper_escape_hatches") :- classes(n, t), in_list("order_by_names", t), docof(n, d),
    doc(d, "impl/common/l2070_server_plan/steps/_compile_helpers.py"), primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-024", id, "_check_order_by_compile_helper_escape_hatches") :- functions(n, t), in_list("order_by_names", t), docof(n, d),
    doc(d, "impl/common/l2070_server_plan/steps/_compile_helpers.py"), primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-024", id, "_check_order_by_compile_helper_escape_hatches") :- strings(n, v), @rx_matches(v, "(?:^|\\s)(?:JSON_EXISTS|JSON_GET|JSON_GET_BOOL|JSON_GET_FLOAT|JSON_GET_INT|JSON_GET_TEXT|JSON_KEYS|JSON_LENGTH|JSON_TYPE|JsonAccessKind|SqlJsonAccess|SqlJsonPath|SqlOrderByItem|SqlOrderByItems|build_query_spec_order_by)(?:\\s|$)") = 1,
    node(d, n, _, s, e), doc(d, "impl/common/l2070_server_plan/steps/_compile_helpers.py"), primary_file(d), id = @printf("%d:%d", s, e).
diagnostics_1(n, "SPQ-025", id, "_check_can_batch_lock_snapshot_policy") :- functions(n, "can_batch"), field(n, "body", b), visible_child(b, st), kind(st, sk),
    in_list("lock_stmt", sk), lock_root(st, r), descendants(r, x), lock_x(x), text(x, t),
    @rx_matches(@lower(t), "for_update|lock|locked|snapshot|use_for_update") = 1, docof(n, d), primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-028", id, "_check_plan_analysis_field_reassignment") :- snode(n), kind(n, k), in_list("assignment_kinds", k), field(n, "left", l),
    descendants(l, x), attributes(x, attr, _, "analysis"), in_list("analysis_fields", attr), !analysis_writer(n), docof(n, d), files(d, src),
    @instr(src, "PlanAnalysis") > 0, primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-028", id, "_check_plan_analysis_field_reassignment") :- snode(n), kind(n, k), in_list("assignment_kinds", k), field(n, "left", l),
    descendants(l, x), attributes(x, attr, _, "self"), in_list("analysis_fields", attr), inside_plan_analysis(n), !analysis_writer(n), docof(n, d),
    files(d, src), @instr(src, "PlanAnalysis") > 0, primary_file(d), id = @id(n).
diagnostics_1(n, "SPQ-012", id, "_check_executor_python_execution") :- functions(n, name), in_list("exec_helpers", name), docof(n, d), executor_scope(d),
    exec_helper_source(d), primary_file(d), id = @concat("function:", @id(n)).

// ---- diagnostics_2 ----
.decl diagnostics_2(n: node, issue: symbol, identity: symbol, detector: symbol)
diagnostics_2(n, "SPQ-012", id, "_check_executor_python_execution") :- methods(n, _, name, cn), in_list("executor_classes", cn), in_list("exec_helpers", name),
    docof(n, d), executor_scope(d), exec_helper_source(d), primary_file(d), id = @concat("method:", @id(n)).
diagnostics_2(n, "SPQ-013", id, "_check_executor_python_execution") :- classes(n, name), in_list("replay_protocols", name), base_names(n, "Protocol"),
    docof(n, d), executor_scope(d), exec_helper_source(d), primary_file(d), id = @id(n).
diagnostics_2(n, "SPQ-013", id, "_check_executor_python_execution") :- calls(n, _, _, "isinstance", _), contains_(f, n), arguments(n, a, 1), ir_names(a, irn),
    irn != "SqlStepIR", docof(n, d), doc(d, "impl/common/l2070_server_plan/sql_backend_executor.py"), exec_helper_source(d), primary_file(d),
    id = @concat("helper:", @id(f), ":", @id(n), ":", irn).
diagnostics_2(n, "SPQ-013", id, "_check_executor_python_execution") :- calls(n, _, _, "isinstance", _), method_nodes(m, _, _, cn, n), in_list("executor_classes", cn),
    arguments(n, a, 1), ir_names(a, irn), irn != "SqlStepIR", docof(n, d), executor_scope(d), exec_helper_source(d), primary_file(d),
    id = @concat("method:", @id(m), ":", @id(n), ":", irn).
diagnostics_2(n, "SPQ-013", id, "_check_executor_python_execution") :- calls(n, _, _, "isinstance", _), method_nodes(m, _, _, cn, n), in_list("executor_classes", cn),
    arguments(n, a, 1), ir_names(a, irn), in_list("control_flow_classes", irn), docof(n, d), executor_scope(d), exec_helper_source(d), primary_file(d),
    id = @concat("method:", @id(m), ":", @id(n), ":", irn).
diagnostics_2(n, "SPQ-013", id, "_check_executor_python_execution") :- calls(n, _, "attribute", _, ce), in_list("runtime_seq_attrs", ce), method_nodes(_, _, _, cn, n),
    in_list("executor_classes", cn), docof(n, d), executor_scope(d), exec_helper_source(d), primary_file(d), id = @id(n).
diagnostics_2(n, "SPQ-012", id, "_check_executor_python_execution") :- calls(n, _, "attribute", _, ce), in_list("dispatch_helpers", ce), method_nodes(_, _, _, cn, n),
    in_list("executor_classes", cn), docof(n, d), executor_scope(d), exec_helper_source(d), primary_file(d), id = @id(n).
// p = 'l2070_batching/executor.py' OR executor_scope
diagnostics_2(n, "SPQ-013", id, "_check_executor_execute_runtime_bypass") :- calls(n, _, _, "object.__getattribute__", _), string_argument(n, 1, "execute_runtime"),
    method_nodes(_, _, _, "PlanExecutor", n), docof(n, d), doc(d, "l2070_batching/executor.py"), primary_file(d), id = @id(n).
diagnostics_2(n, "SPQ-013", id, "_check_executor_execute_runtime_bypass") :- calls(n, _, _, "object.__getattribute__", _), string_argument(n, 1, "execute_runtime"),
    method_nodes(_, _, _, "PlanExecutor", n), docof(n, d), executor_scope(d), primary_file(d), id = @id(n).
diagnostics_2(n, "SPQ-013", id, "_check_executor_python_execution") :- attributes(n, "child_steps", _, _), method_nodes(_, _, _, cn, n), in_list("executor_classes", cn),
    docof(n, d), executor_scope(d), exec_helper_source(d), primary_file(d), id = @id(n).

// ---- diagnostics_3 ----
.decl strategies_file(d: number)
strategies_file(d) :- files(d, _), doc(d, p), @substr(p, 1, 41) = "impl/common/l2070_server_plan/strategies/".
.decl diagnostics_3(n: node, issue: symbol, identity: symbol, detector: symbol)
diagnostics_3(n, "SPQ-018", id, "_check_executor_python_execution") :- attributes(n, attr, _, _), in_list("runtime_result_kw", attr), method_nodes(_, _, _, cn, n),
    in_list("executor_classes", cn), docof(n, d), executor_scope(d), exec_helper_source(d), primary_file(d), id = @id(n).
diagnostics_3(n, "SPQ-014", id, "_check_runtime_sequential_strategies") :- methods(n, c, "uses_runtime_sequential_execution", _), base_names(c, "PhysicalRegionCodegen"),
    literal_bools(n, "true"), docof(n, d), strategies_file(d), primary_file(d), id = @id(n).
diagnostics_3(n, "SPQ-014", id, "_check_runtime_sequential_strategies") :- methods(n, c, name, _), in_list("strategy_methods", name), base_names(c, "PhysicalRegionCodegen"),
    descendant_callee(n, "NotImplementedError"), docof(n, d), strategies_file(d), primary_file(d), id = @id(n).
diagnostics_3(n, "SPQ-014", id, "_check_runtime_sequential_strategies") :- calls(n, _, _, "getattr", _), string_argument(n, 1, "requires_runtime_sequential_batch"),
    method_nodes(_, c, _, _, n), base_names(c, "PhysicalRegionCodegen"), docof(n, d), strategies_file(d), primary_file(d), id = @id(n).
diagnostics_3(n, "SPQ-014", id, "_check_runtime_sequential_strategies") :- calls(n, _, _, _, ce), @like(ce, "%IR") = 1, ce != "SqlStepIR",
    method_nodes(_, c, _, _, n), base_names(c, "PhysicalRegionCodegen"), docof(n, d), strategies_file(d), primary_file(d), id = @id(n).
diagnostics_3(n, "SPQ-032", id, "_check_graphql_serverplan_boundary") :- py_names(n, t), in_list("graphql_private", t), docof(n, d), graphql_file(d),
    prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-032", id, "_check_graphql_serverplan_boundary") :- attributes(n, t, _, _), in_list("graphql_private", t), docof(n, d), graphql_file(d),
    prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-032", id, "_check_graphql_serverplan_boundary") :- calls(n, _, _, fc, _), in_list("duck", fc), string_argument(n, 1, v),
    in_list("graphql_private", v), docof(n, d), graphql_file(d), prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-034", id, "_check_graphql_serverplan_boundary") :- py_names(n, "RelationshipType"), !in_list("graphql_private", "RelationshipType"),
    docof(n, d), graphql_executor_file(d), prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-033", id, "_check_graphql_serverplan_boundary") :- classes(n, name), in_list("relationship_specs", name), docof(n, d), graphql_file(d),
    prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-033", id, "_check_graphql_serverplan_boundary") :- classes(n, name), @like(name, "%RelationshipSpec") = 1, docof(n, d), graphql_file(d),
    prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-033", id, "_check_graphql_serverplan_boundary") :- calls(n, _, _, _, ce), in_list("relationship_builders", ce), docof(n, d), graphql_file(d),
    prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-036", id, "_check_contract_first_relationship_runtime") :- attributes(n, "relationships", _, ot), @rx_matches(ot, "(?:^|\\.)registry(?:\\.|$)") = 1,
    docof(n, d), contract_first_file(d), prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-036", id, "_check_contract_first_relationship_runtime") :- calls(n, _, _, _, "get_relationship"), docof(n, d), contract_first_file(d),
    prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-036", id, "_check_contract_first_relationship_runtime") :- calls(n, _, _, _, "_relationship_descriptor"), docof(n, d), contract_first_file(d),
    doc(d, p), @rx_matches(p, "(?:^|/)l9900_auto_api/rest_router\\.py$") = 1, prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-036", id, "_check_contract_first_relationship_runtime") :- functions(n, "_relationship_descriptor"), not_async_text(n), docof(n, d),
    contract_first_file(d), doc(d, p), @rx_matches(p, "(?:^|/)l9900_auto_api/rest_router\\.py$") = 1, prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-037", id, "_check_contract_first_relationship_runtime") :- calls(n, _, _, _, ce), in_list("relationship_nodes", ce), docof(n, d),
    contract_first_file(d), graphql_executor_file(d), prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-037", id, "_check_contract_first_relationship_runtime") :- calls(n, _, _, _, "isinstance"), arguments(n, a, 1), kind(a, "identifier"), text(a, t),
    in_list("belongs_has", t), docof(n, d), contract_first_file(d), graphql_executor_file(d), prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-038", id, "_check_serverplan_cleanup_ratchets") :- py_names(n, t), in_list("relationship_info", t), docof(n, d), !in_tests(d),
    !relationship_compat_exempt(d), prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-039", id, "_check_serverplan_cleanup_ratchets") :- attributes(n, "source_flush_context", _, _), docof(n, d), !in_tests(d), prim_or_fallback(d),
    id = @id(n).
diagnostics_3(n, "SPQ-039", id, "_check_serverplan_cleanup_ratchets") :- attributes(n, "steps", _, "bundle"), docof(n, d), !in_tests(d), prim_or_fallback(d),
    id = @id(n).
diagnostics_3(n, "SPQ-039", id, "_check_serverplan_cleanup_ratchets") :- calls(n, _, _, _, "PlanPrerequisiteBundle"), keywords(n, k, kn, _), in_list("cleanup_kw", kn),
    docof(n, d), !in_tests(d), prim_or_fallback(d), id = @id(k).
diagnostics_3(n, "SPQ-040", id, "_check_serverplan_cleanup_ratchets") :- calls(n, _, _, _, "_build_include_query_step"), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)l2070_server_plan/.*intent_include\\.py$") = 1, functions(f, "_lower_include_load_intent"), not_async_text(f), contains_(f, n),
    prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-041", id, "_check_serverplan_cleanup_ratchets") :- functions(n, "_format_embedded_object"), not_async_text(n), docof(n, d),
    graphql_executor_file(d), prim_or_fallback(d), id = @id(n).
diagnostics_3(n, "SPQ-041", id, "_check_serverplan_cleanup_ratchets") :- calls(n, _, _, _, "_format_embedded_object"), docof(n, d), graphql_executor_file(d),
    prim_or_fallback(d), id = @id(n).

// ---- diagnostics_4 ----
.decl projection_prefix(d: number)
projection_prefix(d) :- files(d, _), doc(d, p), @substr(p, 1, 20) = "l2060_query_builder/".
projection_prefix(d) :- files(d, _), doc(d, p), @substr(p, 1, 30) = "impl/common/l2070_server_plan/".
projection_prefix(d) :- files(d, _), doc(d, p), @substr(p, 1, 15) = "l2080_lazy_orm/".
projection_prefix(d) :- files(d, _), doc(d, p), @substr(p, 1, 15) = "l9900_auto_api/".
.decl non_false_child(v: node)
non_false_child(v) :- visible_child(v, x), kind(x, k), k != "false", k != "comment".
.decl row_semantics_node(y: node)
row_semantics_node(y) :- calls(y, _, _, _, ce), in_list("row_helpers", ce).
row_semantics_node(y) :- calls(y, _, "attribute", _, "evaluate").
row_semantics_node(y) :- snode(y), kind(y, "subscript"), field(y, "value", v), kind(v, "identifier"), text(v, vt), in_list("row_names", vt),
    visible_child(y, sl), kind(sl, "slice").
.decl fn_has_build(f: node)
fn_has_build(f) :- functions(f, _), descendants(f, c), exec_build(c).
.decl fn_has_direct(f: node)
fn_has_direct(f) :- functions(f, _), descendants(f, c), exec_direct(c).
// (then_build AND else_direct) OR (else_build AND then_direct)
.decl branch_mixed(b: node)
branch_mixed(b) :- branch_then_build(b), branch_else_direct(b).
branch_mixed(b) :- branch_else_build(b), branch_then_direct(b).
.decl branch_any_direct(b: node)
branch_any_direct(b) :- branch_then_direct(b).
branch_any_direct(b) :- branch_else_direct(b).
// A `x is (not) None` comparison in the condition: two visible children, a `none` and an identifier.
.decl none_check_condition(b: node)
none_check_condition(b) :- branch_flags(b), field(b, "condition", c), descendants(c, cmp), kind(cmp, "comparison_operator"), text(cmp, t),
    @rx_matches(t, "\\bis(?: not)?\\b") = 1, child_count(cmp, 2), visible_child(cmp, e1), kind(e1, "none"), visible_child(cmp, e2), kind(e2, "identifier").
.decl branch_in_fn(b: node, fn: node)
branch_in_fn(b, f) :- branch_flags(b), contains_(f, b), fn_has_build(f), fn_has_direct(f).
// A direct / build execution call after the branch and inside the function.
.decl later_direct(b: node, fn: node)
later_direct(b, f) :- branch_in_fn(b, f), docof(b, d), node(d, b, _, _, be), node(d, f, _, _, fe), exec_direct(x), node(d, x, _, xs, xe), xs > be, xe <= fe.
.decl later_build(b: node, fn: node)
later_build(b, f) :- branch_in_fn(b, f), docof(b, d), node(d, b, _, _, be), node(d, f, _, _, fe), exec_build(x), node(d, x, _, xs, xe), xs > be, xe <= fe.
.decl scope_value(n: node)
scope_value(n) :- string_at(n, v), in_list("scope_columns", v).
scope_value(n) :- snode(n), kind(n, "identifier"), text(n, t), docof(n, d), module_string_values(d, t, v), in_list("scope_columns", v).
.decl diagnostics_4(n: node, issue: symbol, identity: symbol, detector: symbol)
diagnostics_4(n, "SPQ-045", id, "_check_forbidden_sqlcompoundwrite_usage") :- from_imports(n, i, "impl.common.l2100_sql_grammar.domain.infra.stmt_compound_write", "SqlCompoundWrite"),
    docof(n, d), !in_tests(d), doc(d, p), @rx_matches(p, "(?:^|/)stmt_compound_write\\.py$") = 0, primary_file(d), start(n, s),
    from_import_alias_text(i, al), id = @printf("%d:%s:%s", s, "SqlCompoundWrite", al).
diagnostics_4(n, "SPQ-038", id, "_check_serverplan_cleanup_ratchets") :- from_imports(n, i, m, name), in_list("graphql_compat_modules", m), in_list("relationship_info", name),
    docof(n, d), !in_tests(d), !relationship_compat_exempt(d), prim_or_fallback(d), start(n, s), from_import_alias_text(i, al),
    id = @printf("%d:%s:%s", s, name, al).
diagnostics_4(n, "SPQ-046", id, "_check_sql_statement_batch_requires_category") :- calls(n, _, _, _, "SqlStatementBatch"), !keyword_named(n, "statement_kinds_per_stmt"),
    keywords(n, _, "collect_results_per_stmt", cv), kind(cv, ck), in_list("list_tuple", ck), visible_child(cv, tv), kind(tv, "true"),
    keywords(n, _, "needs_returning_per_stmt", nv), kind(nv, nk), in_list("list_tuple", nk), !non_false_child(nv),
    docof(n, d), primary_file(d), id = @concat("rowcounts:", @id(n)).
diagnostics_4(n, "SPQ-043", id, "_check_projection_helper_execution_fallback") :- functions(n, _), docof(n, d), !in_tests(d), projection_prefix(d),
    scoped_nodes(n, c), calls(c, _, "attribute", _, ce), in_list("projection_execs", ce), projection_repairs(n), files(d, src),
    @rx_matches(src, "extract|project|projected|projection|tuple") = 1, @rx_matches(src, "execute|execute_async|resolve|resolve_async") = 1,
    prim_or_fallback(d), id = @id(n).
diagnostics_4(n, "SPQ-044", id, "_check_materialized_row_semantics_fallback") :- functions(n, _), docof(n, d), !in_tests(d), doc(d, p),
    @substr(p, 1, 15) = "l9900_auto_api/", scoped_nodes(n, x), py_names(x, t), in_list("row_names", t), scoped_nodes(n, y), row_semantics_node(y),
    files(d, src), @rx_matches(src, "_apply_orderby_to_dict_rows|_parse_orderby_clauses|_stable_sort_with_nulls_last|all_rows|candidates|group_rows|items|ordered_rows|out|page|page_rows|parse_filter_for_fields|parse_odata_filter_expression|rows|source_rows") = 1,
    prim_or_fallback(d), id = @id(n).
diagnostics_4(n, "SPQ-030", id, "_check_conditional_serverplan_fallback") :- branch_in_fn(n, f), branch_mixed(n), docof(n, d), fallback_source(d),
    prim_or_fallback(d), id = @concat("branch:", @id(f), ":", @id(n)).
diagnostics_4(n, "SPQ-031", id, "_check_conditional_serverplan_fallback") :- branch_in_fn(n, f), !branch_mixed(n), branch_any_direct(n), none_check_condition(n),
    docof(n, d), fallback_source(d), prim_or_fallback(d), id = @concat(@id(f), ":", @id(n)).
diagnostics_4(n, "SPQ-030", id, "_check_conditional_serverplan_fallback") :- branch_in_fn(n, f), kind(n, "if_statement"), field(f, "body", b), child(b, n, _),
    branch_then_build(n), later_direct(n, f), docof(n, d), fallback_source(d), prim_or_fallback(d), id = @concat("later:", @id(f), ":", @id(n)).
diagnostics_4(n, "SPQ-030", id, "_check_conditional_serverplan_fallback") :- branch_in_fn(n, f), kind(n, "if_statement"), field(f, "body", b), child(b, n, _),
    branch_then_direct(n), later_build(n, f), docof(n, d), fallback_source(d), prim_or_fallback(d), id = @concat("later:", @id(f), ":", @id(n)).
diagnostics_4(n, "SPQ-042", id, "_check_vector_scope_filters_use_expressions") :- calls(c, _, _, _, "QueryFilter"), arguments(c, n, 0), snode(n), scope_value(n),
    docof(n, d), doc(d, "impl/common/l2070_server_plan/steps/intent_vector_query.py"), primary_file(d), id = @id(n).
diagnostics_4(n, "SPQ-042", id, "_check_vector_scope_filters_use_expressions") :- calls(c, _, _, _, "QueryFilter"), keywords(c, _, "column", n), snode(n), scope_value(n),
    docof(n, d), doc(d, "impl/common/l2070_server_plan/steps/intent_vector_query.py"), primary_file(d), id = @id(n).
diagnostics_4(n, "SPQ-035", id, "_check_include_through_shared_lowering") :- branches(n), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)l2070_server_plan/.*intent_include\\.py$") = 1, branch_then(n, t), descendants(t, x), kind(x, "continue_statement"),
    field(n, "condition", cd), through_conditions(cd), prim_or_fallback(d), id = @id(n).

// ---- diagnostics_5 ----
.decl doc_py_name(d: number, text: symbol)
doc_py_name(d, t) :- py_names(x, t), docof(x, d).
.decl doc_callee(d: number, callee: symbol)
doc_callee(d, ce) :- calls(x, _, _, _, ce), docof(x, d).
// An assignment `x[…] = None` directly in the branch's then-block.
.decl then_none_reset(b: node)
then_none_reset(b) :- branch_then(b, t), visible_child(t, stmt), visible_child(stmt, a), assignments(a, tg), !assignment_typed(a), assignment_value(a, v),
    kind(v, "none"), kind(tg, "subscript").
.decl condition_py_name(b: node, text: symbol)
condition_py_name(b, t) :- branches(b), field(b, "condition", c), descendants(c, x), py_names(x, t).
.decl condition_attr(b: node, attr: symbol)
condition_attr(b, a) :- branches(b), field(b, "condition", c), descendants(c, x), attributes(x, a, _, _).
.decl in_finish_batched_step(b: node)
in_finish_batched_step(b) :- branches(b), functions(f, "_finish_batched_step"), contains_(f, b).
.decl binop_operand(n: node, o: node)
binop_operand(n, o) :- snode(n), kind(n, "binary_operator"), field(n, "left", o).
binop_operand(n, o) :- snode(n), kind(n, "binary_operator"), field(n, "right", o).
.decl getattr_string(f: node, value: symbol)
getattr_string(f, v) :- descendants(f, c), calls(c, _, _, _, "getattr"), string_argument(c, _, v).
.decl diagnostics_5(n: node, issue: symbol, identity: symbol, detector: symbol)
diagnostics_5(n, "SPQ-020", id, "_check_imperative_preop_execution") :- calls(n, _, _, _, ce), in_list("compiled_step", ce), keywords(n, k, kn, v),
    in_list("preop_kw", kn), kind(v, "identifier"), text(v, t), docof(n, d), preop_functions(d, t), !in_tests(d), primary_file(d), id = @id(k).
diagnostics_5(n, "SPQ-020", id, "_check_imperative_preop_execution") :- calls(n, _, _, _, ce), in_list("compiled_step", ce), keywords(n, k, kn, v),
    in_list("preop_kw", kn), kind(v, vk), vk != "none", vk != "identifier", descendant_callee(v, rc), in_list("preop_runtime", rc), docof(n, d), !in_tests(d),
    primary_file(d), id = @id(k).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- functions(n, "_can_fuse_replay_terminal_steps"), not_async_text(n),
    docof(n, d), doc(d, p), @rx_matches(p, "(?:^|/)sql_backend_executor\\.py$") = 1, primary_file(d), id = @id(n).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- functions(n, "supports_sql_batch_transport"),
    descendant_callee(n, "sql_visible_dependencies"), docof(n, d), primary_file(d), id = @id(n).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- strings(n, v), @rx_matches(v, "^[\\p{L}\\p{N}_]+\\(.*\\)$") = 1,
    functions(f, "split_for_outer_cte"), contains_(f, n), node(d, n, _, s, e), primary_file(d), id = @printf("%d:%d", s, e).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- functions(n, "_relation_output_columns"), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)dependent_read_cte\\.py$") = 1, descendant_attr(n, "relation_output_columns"), primary_file(d), id = @id(n).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- functions(n, "_relation_output_columns"), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)dependent_read_cte\\.py$") = 1, getattr_string(n, "relation_output_columns"), primary_file(d), id = @id(n).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- functions(n, "requires_prior_step_boundary"), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)versioned_query_steps\\.py$") = 1, descendant_callee(n, "_query_spec_has_json_function_filter"), primary_file(d), id = @id(n).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- functions(n, "requires_prior_step_boundary"), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)versioned_query_steps\\.py$") = 1, descendant_attr(n, "_after_refs"), primary_file(d), id = @id(n).
diagnostics_5(n, "SPQ-047", "dependent-order", "_check_runtime_replay_batching_uses_structured_analysis") :- file_starts(n), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)dependent_read_cte\\.py$") = 1, !doc_py_name(d, "_BATCH_ROW_ORDINAL"), primary_file(d).
diagnostics_5(n, "SPQ-047", "dependent-order", "_check_runtime_replay_batching_uses_structured_analysis") :- file_starts(n), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)dependent_read_cte\\.py$") = 1, !doc_callee(d, "with_order_by"), primary_file(d).
diagnostics_5(n, "SPQ-047", "child-exports", "_check_runtime_replay_batching_uses_structured_analysis") :- file_starts(n), docof(n, d), doc(d, p),
    @rx_matches(p, "(?:^|/)compound_sequence\\.py$") = 1, !doc_callee(d, "exports_child_bindings"), primary_file(d).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- branches(n), docof(n, d), executor_batch_file(d),
    in_finish_batched_step(n), then_none_reset(n), condition_py_name(n, "empty_result_allowed"), primary_file(d), id = @concat("empty:", @id(n)).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- branches(n), docof(n, d), executor_batch_file(d),
    in_finish_batched_step(n), then_none_reset(n), condition_py_name(n, "omitted_projection_indices"), !condition_attr(n, "closed_post_op"), primary_file(d),
    id = @concat("omitted:", @id(n)).
diagnostics_5(n, "SPQ-047", id, "_check_runtime_replay_batching_uses_structured_analysis") :- snode(n), kind(n, "binary_operator"), text(n, t), @rx_matches(t, "&") = 1,
    binop_operand(n, c), calls(c, _, "attribute", _, "step_tags"), binop_operand(n, sv), kind(sv, "set"), visible_child(sv, el), string_at(el, v),
    in_list("step_tag_values", v), docof(n, d), executor_batch_file(d), primary_file(d), id = @id(n).
diagnostics_5(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- annotations(n, _), assignments(n, tg), text(tg, tt), in_list("runtime_state", tt),
    docof(n, d), !in_tests(d), primary_file(d), id = @concat("owner:", @id(n)).
diagnostics_5(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- annotations(n, _), !annotation_function_local(n), assignments(n, tg), text(tg, tt),
    @rx_matches(tt, "AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction|bundle|runtime") = 1,
    docof(n, d), !in_tests(d), primary_file(d), id = @concat("field:", @id(n)).
diagnostics_5(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- annotations(n, _), resolved_atoms(n, aid, _, _, o),
    @rx_matches(o, "(?:^|\\.)Callable(?:\\.|$)") = 1, !ignored_annotation_metadata(n, aid), docof(n, d), !in_tests(d), primary_file(d),
    id = @concat("callable:", @id(n)).
// NOT (trusted AND origin IN connection_ids): one rule per disjunct.
diagnostics_5(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- annotations(n, _), resolved_atoms(n, aid, _, _, o), !resolved_trusted(n, aid, o),
    @rx_matches(o, "AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction") = 1,
    !ignored_annotation_metadata(n, aid), docof(n, d), !in_tests(d), primary_file(d), id = @concat("service:", @id(n)).
diagnostics_5(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- annotations(n, _), resolved_atoms(n, aid, _, _, o), !in_list("connection_ids", o),
    @rx_matches(o, "AsyncCapabilityTokenService|BackendExecutor|CapabilityTokenService|CapabilityTokenStore|Connection|Cursor|Hydrator|RuntimeBundle|SyncDatabaseConnection|TokenStore|Transaction") = 1,
    !ignored_annotation_metadata(n, aid), docof(n, d), !in_tests(d), primary_file(d), id = @concat("service:", @id(n)).

// ---- diagnostics_6 ----
.decl diagnostics_6(n: node, issue: symbol, identity: symbol, detector: symbol)
diagnostics_6(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- assignments(n, tg), !assignment_typed(n), kind(tg, "identifier"), text(tg, tt),
    @instr(tt, "UNWRAP") > 0, assignment_value(n, v), kind(v, vk), in_list("unwrap_kinds", vk), visible_child(v, item), string_at(item, s),
    in_list("runtime_state", s), docof(n, d), !in_tests(d), primary_file(d), id = @concat("unwrap:", @id(n)).
diagnostics_6(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- assignments(n, tg), !assignment_typed(n), kind(tg, "identifier"), text(tg, tt),
    @instr(tt, "OWNER") > 0, assignment_value(n, v), kind(v, vk), in_list("unwrap_kinds", vk), visible_child(v, item), string_at(item, s),
    in_list("runtime_state", s), docof(n, d), !in_tests(d), primary_file(d), id = @concat("unwrap:", @id(n)).
diagnostics_6(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- attributes(n, "renewable_capability_bundle", _, _), docof(n, d), !in_tests(d),
    primary_file(d), id = @id(n).
diagnostics_6(n, "SPQ-050", id, "_check_serverplan_runtime_state_ingress") :- calls(n, _, _, _, "runtime_builder_post_op"), keywords(n, k, kn, _),
    in_list("runtime_builder_kw", kn), docof(n, d), !in_tests(d), primary_file(d), id = @id(k).

// ---- the clause's query: SELECT * FROM diagnostics_0 UNION ALL … diagnostics_6 ----
finding("quality-contracts-1", issue, n) :- diagnostics_0(n, issue, _, _).
finding("quality-contracts-1", issue, n) :- diagnostics_1(n, issue, _, _).
finding("quality-contracts-1", issue, n) :- diagnostics_2(n, issue, _, _).
finding("quality-contracts-1", issue, n) :- diagnostics_3(n, issue, _, _).
finding("quality-contracts-1", issue, n) :- diagnostics_4(n, issue, _, _).
finding("quality-contracts-1", issue, n) :- diagnostics_5(n, issue, _, _).
finding("quality-contracts-1", issue, n) :- diagnostics_6(n, issue, _, _).
