in_list("direct_callee", "execute"). in_list("direct_callee", "execute_async"). in_list("direct_callee", "graph"). in_list("direct_callee", "graph_async").
in_list("direct_callee", "load_with_includes"). in_list("direct_callee", "load_with_includes_async"). in_list("direct_callee", "query"). in_list("direct_callee", "query_async").
in_list("branch_kind", "if_statement"). in_list("branch_kind", "elif_clause").
in_list("else_kind", "else_clause"). in_list("else_kind", "elif_clause").
in_list("eq_op", "=="). in_list("eq_op", "!="). in_list("in_op", "in"). in_list("in_op", "not in").
in_list("collection_kind", "set"). in_list("collection_kind", "list"). in_list("collection_kind", "tuple").
in_list("scalar_kind", "integer"). in_list("scalar_kind", "float"). in_list("scalar_kind", "true"). in_list("scalar_kind", "false"). in_list("scalar_kind", "none").
in_list("preop_runtime", "_execute_compound_async"). in_list("preop_runtime", "_execute_compound_sync"). in_list("preop_runtime", "_run_sync").
in_list("preop_runtime", "async_pre_op"). in_list("preop_runtime", "build_sql_fts_components"). in_list("preop_runtime", "build_sql_fts_components_async").
in_list("preop_runtime", "execute_async"). in_list("preop_runtime", "execute_ir"). in_list("preop_runtime", "execute_ir_async"). in_list("preop_runtime", "execute_sync").
in_list("preop_runtime", "get_sql_fts_components"). in_list("preop_runtime", "get_sql_fts_components_async"). in_list("preop_runtime", "materialize_ir").
in_list("preop_runtime", "pre_op"). in_list("preop_runtime", "search_unversioned_scores"). in_list("preop_runtime", "search_unversioned_scores_async").
in_list("scope_kind", "module"). in_list("scope_kind", "class_definition"). in_list("scope_kind", "function_definition").
in_list("left_binding", "assignment"). in_list("left_binding", "augmented_assignment"). in_list("left_binding", "for_statement"). in_list("left_binding", "for_in_clause").
in_list("fdcd", "function_definition"). in_list("fdcd", "class_definition").
in_list("metadata_origin", "typing.Literal"). in_list("metadata_origin", "typing_extensions.Literal").
in_list("metadata_origin", "typing.Annotated"). in_list("metadata_origin", "typing_extensions.Annotated").
in_list("literal_origin", "typing.Literal"). in_list("literal_origin", "typing_extensions.Literal").

// ---- the syntax tables over the tape ----
.decl snode(n: node)
snode(n) :- node(d, n, k, _, _), syntax_gate(d), !in_list("excluded_kind", k).
.decl module_root(d: number, m: node)
module_root(d, m) :- node(d, m, "module", _, _), snode(m).
.decl visible_child(p: node, c: node)
visible_child(p, c) :- child(p, c, _), snode(c).
.decl child_count(p: node, k: number)
child_count(p, k) :- visible_child(p, _), k = count : { visible_child(p, _) }.
// nodes.ordinal: the rank among the visible children of the parent.
.decl sib_upto(n: node, m: node)
sib_upto(n, m) :- child(p, n, i), snode(n), child(p, m, j), snode(m), j <= i.
.decl ordinal(n: node, i: number)
ordinal(n, i) :- sib_upto(n, _), k = count : { sib_upto(n, _) }, i = @sub(k, 1).
// ownership.fn / ownership.cls: nearest function / class ancestor-or-self.
.decl own_fn(n: node, f: node)
own_fn(n, n) :- snode(n), kind(n, "function_definition").
own_fn(n, f) :- snode(n), kind(n, k), k != "function_definition", nearest(n, f, fdef).
.decl own_cls(n: node, c: node)
own_cls(n, n) :- snode(n), kind(n, "class_definition").
own_cls(n, c) :- snode(n), kind(n, k), k != "class_definition", nearest(n, c, cdef).
.decl has_own_fn(n: node)
has_own_fn(n) :- own_fn(n, _).
.decl has_own_cls(n: node)
has_own_cls(n) :- own_cls(n, _).

// ---- functions, classes, methods, attributes, calls, arguments, keywords ----
// name = name_source: a function_definition / class_definition always has its `name`.
.decl functions(f: node, name: symbol)
functions(f, name) :- snode(f), kind(f, "function_definition"), field(f, "name", x), text(x, name).
.decl classes(c: node, name: symbol)
classes(c, name) :- snode(c), kind(c, "class_definition"), field(c, "name", x), text(x, name).
.decl methods(m: node, cls: node, name: symbol, class_name: symbol)
methods(f, c, n, cn) :- functions(f, n), classes(c, cn), field(c, "body", b), child(b, f, _).
methods(f, c, n, cn) :- functions(f, n), classes(c, cn), field(c, "body", b), child(w, f, _), snode(w), kind(w, "decorated_definition"), child(b, w, _).
// attr = attribute_source, object = object_id, object_text = object_source: an attribute always has both fields.
.decl attributes(a: node, attr: symbol, object: node, object_text: symbol)
attributes(a, attr, o, ot) :- snode(a), kind(a, "attribute"), field(a, "attribute", x), text(x, attr), field(a, "object", o), text(o, ot).
.decl is_attribute(a: node)
is_attribute(a) :- attributes(a, _, _, _).
// callee = COALESCE(a.attr, f.text); receiver = a.object (nullable).
.decl calls(c: node, callee_id: node, callee_kind: symbol, full_callee: symbol, callee: symbol)
calls(c, f, k, t, a) :- snode(c), kind(c, "call"), field(c, "function", f), snode(f), kind(f, k), text(f, t), attributes(f, a, _, _).
calls(c, f, k, t, t) :- snode(c), kind(c, "call"), field(c, "function", f), snode(f), kind(f, k), text(f, t), !is_attribute(f).
.decl calls_receiver(c: node, receiver: node)
calls_receiver(c, o) :- calls(c, f, _, _, _), attributes(f, _, o, _).
// position = row_number() OVER (PARTITION BY call ORDER BY __start) - 1: the count of arguments up to this one, less one.
.decl argument_node(call: node, a: node)
argument_node(c, n) :- calls(c, _, _, _, _), field(c, "arguments", l), child(l, n, _), snode(n), kind(n, k), !in_list("non_argument", k).
.decl argument_upto(call: node, a: node, b: node)
argument_upto(c, n, m) :- argument_node(c, n), argument_node(c, m), start(n, s), start(m, t), t <= s.
.decl arguments(call: node, a: node, position: number)
arguments(c, n, p) :- argument_node(c, n), k = count : { argument_upto(c, n, _) }, p = @sub(k, 1).
.decl has_argument(call: node)
has_argument(c) :- arguments(c, _, _).
.decl keywords(call: node, keyword: node, name: symbol, value: node)
keywords(c, k, name, v) :- calls(c, _, _, _, _), field(c, "arguments", l), child(l, k, _), snode(k), kind(k, "keyword_argument"),
    field(k, "name", kn), snode(kn), text(kn, name), field(k, "value", v), snode(v).
.decl keyword_named(call: node, name: symbol)
keyword_named(c, name) :- keywords(c, _, name, _).

// ---- descendants: ancestor-or-self pairs below the roots (a `reachability` syntax stage) ----
.decl desc_root(r: node)
desc_root(r) :- snode(r), kind(r, k), in_list("desc_root_kind", k).
desc_root(p) :- snode(n), kind(n, "for_in_clause"), child(p, n, _).
desc_root(c) :- snode(c), child(p, c, _), snode(p), kind(p, "comparison_operator").
desc_root(c) :- snode(p), field(p, f, c), in_list("desc_root_field", f).
desc_root(a) :- arguments(_, a, _).
.decl descendants(root: node, n: node)
descendants(r, r) :- desc_root(r), snode(r).
descendants(r, n) :- desc_root(r), docof(r, d), node(d, n, _, _, _), snode(n), @within(n, r) = 1.

// ---- returns, assignments, parameters ----
.decl returns(r: node, value: node)
returns(r, v) :- snode(r), kind(r, "return_statement"), visible_child(r, v).
.decl returns_fn(r: node, fn: node)
returns_fn(r, f) :- returns(r, _), own_fn(r, f).
// target = left_id; value = right_id (nullable); typed = type_start IS NOT NULL.
.decl assignments(a: node, target: node)
assignments(a, l) :- snode(a), kind(a, "assignment"), field(a, "left", l), snode(l).
.decl assignment_value(a: node, value: node)
assignment_value(a, r) :- assignments(a, _), field(a, "right", r), snode(r).
.decl assignment_typed(a: node)
assignment_typed(a) :- assignments(a, _), field(a, "type", _).
.decl assignment_fn(a: node, fn: node)
assignment_fn(a, f) :- assignments(a, _), own_fn(a, f).
.decl param_node(fn: node, p: node)
param_node(f, p) :- functions(f, _), field(f, "parameters", ps), child(ps, p, _), snode(p), kind(p, k), in_list("param_kind", k).
// The name: the parameter itself if an identifier, else its first visible child when that is an identifier. Only
// (fn, name) is read later; `position` is projected away.
.decl parameters(fn: node, name: symbol)
parameters(f, n) :- param_node(f, p), kind(p, "identifier"), text(p, n).
parameters(f, n) :- param_node(f, p), visible_child(p, x), ordinal(x, 0), kind(x, "identifier"), text(x, n).

// ---- files: the module node's text and the path classes (callback_file is projected away) ----
.decl files(d: number, source: symbol)
files(d, src) :- module_root(d, m), text(m, src).
.decl primary_file(d: number)
primary_file(d) :- files(d, _), doc(d, p), in_list("primary_path", p).
primary_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @substr(p, 1, 36) = "impl/common/l2070_server_plan/steps/".
primary_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @substr(p, 1, 51) = "impl/common/l7300_sql_versioned_transactions/steps/".
primary_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @substr(p, 1, 40) = "impl/common/l9700_sql_graph_query/steps/".
primary_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @substr(p, 1, 41) = "impl/common/l2070_server_plan/strategies/".
primary_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @rx_matches(p, "^impl/common/l2070_server_plan/[^/]+$") = 1.
.decl fallback_file(d: number)
fallback_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @substr(p, 1, 14) = "l9750_graphql/".
fallback_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @substr(p, 1, 15) = "l2080_lazy_orm/".
fallback_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @substr(p, 1, 20) = "l2060_query_builder/".
fallback_file(d) :- files(d, _), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0, @substr(p, 1, 15) = "l9900_auto_api/".

// ---- base_names, method_nodes ----
// COALESCE(rx_extract(text, …, 1), text): the extract when the pattern matches (its group is mandatory), else the text.
.decl base_names(cls: node, name: symbol)
base_names(c, name) :- classes(c, _), visible_child(c, args), kind(args, "argument_list"), visible_child(args, b), kind(b, k), k != "keyword_argument",
    text(b, t), name = @rx_extract(t, "(?:^|\\.)([A-Za-z_]\\w*)(?:\\[.*\\])?$", 1).
base_names(c, t) :- classes(c, _), visible_child(c, args), kind(args, "argument_list"), visible_child(args, b), kind(b, k), k != "keyword_argument",
    text(b, t), @rx_matches(t, "(?:^|\\.)([A-Za-z_]\\w*)(?:\\[.*\\])?$") = 0.
.decl method_nodes(method: node, cls: node, method_name: symbol, class_name: symbol, node: node)
method_nodes(m, c, mn, cn, x) :- methods(m, c, mn, cn), descendants(m, x).

// ---- import_descendants, import_identifiers, py_names ----
.decl import_descendants(root: node, n: node)
import_descendants(r, r) :- snode(r), kind(r, "import_statement").
import_descendants(r, r) :- snode(r), kind(r, "import_from_statement").
import_descendants(r, n) :- snode(r), kind(r, "import_statement"), docof(r, d), node(d, n, _, _, _), snode(n), @within(n, r) = 1.
import_descendants(r, n) :- snode(r), kind(r, "import_from_statement"), docof(r, d), node(d, n, _, _, _), snode(n), @within(n, r) = 1.
.decl import_identifiers(n: node)
import_identifiers(n) :- import_descendants(_, n), kind(n, "identifier").
// Not a def/class/keyword name (`n.__start = p.name_start`), not an attribute's name, not inside an import.
.decl py_name_excluded(n: node)
py_name_excluded(n) :- snode(n), kind(n, "identifier"), child(p, n, _), kind(p, k), in_list("name_owner", k), field(p, "name", x), start(x, s), start(n, s).
py_name_excluded(n) :- snode(n), kind(n, "identifier"), child(p, n, _), kind(p, "attribute"), field(p, "attribute", x), start(x, s), start(n, s).
.decl py_names(n: node, text: symbol)
py_names(n, t) :- snode(n), kind(n, "identifier"), child(p, n, _), snode(p), text(n, t), !py_name_excluded(n), !import_identifiers(n).

// ---- class_levels: the first integer a `level` method returns (row_number() by __start = 1) ----
.decl level_candidate(cls: node, i: node)
level_candidate(c, i) :- method_nodes(_, c, "level", _, r), returns(r, i), kind(i, "integer").
.decl level_start(cls: node, s: number)
level_start(c, s) :- level_candidate(c, i), start(i, s).
.decl level_first(cls: node, s: number)
level_first(c, s) :- level_start(c, _), s = min t : { level_start(c, t) }.
.decl class_levels(cls: node, level: number)
class_levels(c, l) :- level_candidate(c, i), start(i, s), level_first(c, s), text(i, t), l = @cast_int(t).

// ---- statements, literal_bools, strings ----
.decl docstring_like(s: node)
docstring_like(s) :- snode(s), kind(s, "expression_statement"), visible_child(s, v), kind(v, k), in_list("literal_kind", k).
.decl statements(fn: node, s: node, kind: symbol)
statements(f, s, k) :- functions(f, _), field(f, "body", b), visible_child(b, s), kind(s, k), k != "comment", !docstring_like(s).
.decl statement_count(fn: node, k: number)
statement_count(f, k) :- statements(f, _, _), k = count : { statements(f, _, _) }.
.decl literal_bools(fn: node, value: symbol)
literal_bools(f, k) :- statements(f, s, "return_statement"), visible_child(s, v), kind(v, k), in_list("bool_kind", k), statement_count(f, 1).
.decl strings(x: node, value: symbol)
strings(x, v) :- raw_strings(x, v).
strings(x, v) :- raw_fstring_parts(x, v).

// ---- module_functions, abstract_functions, last_methods, last_module_functions ----
.decl module_functions(f: node, name: symbol)
module_functions(f, n) :- functions(f, n), child(p, f, _), snode(p), kind(p, "module").
module_functions(f, n) :- functions(f, n), child(p, f, _), snode(p), kind(p, "decorated_definition"), child(r, p, _), snode(r), kind(r, "module").
.decl abstract_functions(f: node)
abstract_functions(f) :- functions(f, _), child(w, f, _), snode(w), visible_child(w, dec), kind(dec, "decorator"), visible_child(dec, v), kind(v, k),
    in_list("ident_or_attr", k), text(v, t), @rx_matches(t, "(?:^|\\.)abstractmethod$") = 1.
abstract_functions(f) :- functions(f, _), statement_count(f, 1), statements(f, _, "pass_statement").
// row_number() OVER (PARTITION BY cls, name ORDER BY __start DESC) = 1: the last definition.
.decl method_start(cls: node, name: symbol, s: number)
method_start(c, n, s) :- methods(m, c, n, _), start(m, s).
.decl method_last(cls: node, name: symbol, s: number)
method_last(c, n, s) :- method_start(c, n, _), s = max t : { method_start(c, n, t) }.
.decl last_methods(m: node, cls: node, name: symbol)
last_methods(m, c, n) :- methods(m, c, n, _), start(m, s), method_last(c, n, s).
.decl mf_start(d: number, name: symbol, s: number)
mf_start(d, n, s) :- module_functions(f, n), docof(f, d), start(f, s).
.decl mf_last(d: number, name: symbol, s: number)
mf_last(d, n, s) :- mf_start(d, n, _), s = max t : { mf_start(d, n, t) }.
.decl last_module_functions(f: node, name: symbol)
last_module_functions(f, n) :- module_functions(f, n), docof(f, d), start(f, s), mf_last(d, n, s).

// ---- ir_names, scoped_nodes, loop_names, projection_repairs ----
.decl ir_names(root: node, name: symbol)
ir_names(r, t) :- descendants(r, x), py_names(x, t), @like(t, "%IR") = 1.
ir_names(r, a) :- descendants(r, x), attributes(x, a, _, _), @like(a, "%IR") = 1.
// The SQL walks `edges` down from each function, not entering a nested def/class/lambda (E0 #19, a bag over a forest):
// the function itself, and every visible node of another kind whose nearest def/class/lambda strict ancestor is it.
.decl scoped_nodes(fn: node, n: node)
scoped_nodes(f, f) :- functions(f, _).
scoped_nodes(f, n) :- snode(n), kind(n, k), k != "function_definition", k != "class_definition", k != "lambda", nearest(n, f, walk_stop), functions(f, _).
.decl loop_names(fn: node, loop: node, name: symbol)
loop_names(f, n, name) :- scoped_nodes(f, n), kind(n, "for_statement"), field(n, "left", l), descendants(l, x), py_names(x, name).
loop_names(f, p, name) :- scoped_nodes(f, n), kind(n, "for_in_clause"), child(p, n, _), field(n, "left", l), descendants(l, x), py_names(x, name).
.decl projection_repairs(fn: node)
projection_repairs(f) :- loop_names(f, l, name), descendants(l, c), calls(c, _, _, "dict", _), arguments(c, a, _), descendants(a, r), py_names(r, name).
projection_repairs(f) :- loop_names(f, l, name), descendants(l, c), calls(c, _, "attribute", _, ce), in_list("projection_callee", ce), calls_receiver(c, o),
    descendants(o, r), py_names(r, name).

// ---- path_edges, call_paths, execution_calls ----
.decl path_edges(src: node, dst: node, suffix: symbol)
path_edges(o, a, sfx) :- attributes(a, attr, o, _), sfx = @concat(".", attr).
path_edges(f, c, "") :- calls(c, f, _, _, _).
// OUTSIDE: call_paths — `names(id, path)`: py_names' text, extended by `path || suffix` along path_edges (E0 #20, a
// path-text carrier; no non-recursive tape form).
.decl call_paths(x: node, path: symbol)
.input call_paths
// build / direct: boolean columns; the row exists where either holds (and the callee has a call path).
.decl exec_build(c: node)
exec_build(c) :- calls(c, f, _, _, ce), call_paths(f, _), in_list("build_callee", ce).
exec_build(c) :- calls(c, f, _, _, _), call_paths(f, p), @rx_matches(p, "(?:^|\\.)(?:ServerPlan|BaseServerPlan|[A-Za-z_]\\w*Intent)(?:\\.|$)") = 1.
.decl exec_direct(c: node)
exec_direct(c) :- calls(c, f, _, _, ce), call_paths(f, _), in_list("direct_callee", ce), @like(ce, "load_with_includes%") = 1.
exec_direct(c) :- calls(c, f, _, _, ce), call_paths(f, p), in_list("direct_callee", ce), @rx_matches(p, "(?:^|\\.)(?:txn|tx|vrtxn|conn|query)\\.[^.]+$") = 1.
.decl execution_calls(c: node)
execution_calls(c) :- exec_build(c).
execution_calls(c) :- exec_direct(c).

// ---- branches, branch_flags ----
.decl branches(b: node)
branches(b) :- snode(b), kind(b, k), in_list("branch_kind", k).
.decl branch_then(b: node, t: node)
branch_then(b, t) :- branches(b), field(b, "consequence", t).
// else_start / else_end: min start / max end of the else/elif siblings after the branch (under the if_statement).
.decl branch_alt(b: node, alt: node)
branch_alt(b, a) :- branches(b), kind(b, "if_statement"), visible_child(b, a), kind(a, k), in_list("else_kind", k), start(a, as), start(b, bs), as > bs.
branch_alt(b, a) :- branches(b), kind(b, "elif_clause"), child(p, b, _), visible_child(p, a), kind(a, k), in_list("else_kind", k), start(a, as), start(b, bs), as > bs.
.decl branch_alt_start(b: node, s: number)
branch_alt_start(b, s) :- branch_alt(b, a), start(a, s).
.decl branch_alt_end(b: node, e: number)
branch_alt_end(b, e) :- branch_alt(b, a), node(_, a, _, _, e).
.decl branch_else_start(b: node, s: number)
branch_else_start(b, s) :- branch_alt_start(b, _), s = min x : { branch_alt_start(b, x) }.
.decl branch_else_end(b: node, e: number)
branch_else_end(b, e) :- branch_alt_end(b, _), e = max x : { branch_alt_end(b, x) }.
.decl branch_else(b: node, s: number, e: number)
branch_else(b, s, e) :- branch_else_start(b, s), branch_else_end(b, e).
.decl branch_flags(b: node)
branch_flags(b) :- branches(b).
.decl branch_then_build(b: node)
branch_then_build(b) :- branch_then(b, t), descendants(t, c), exec_build(c).
.decl branch_then_direct(b: node)
branch_then_direct(b) :- branch_then(b, t), descendants(t, c), exec_direct(c).
.decl branch_else_build(b: node)
branch_else_build(b) :- branch_else(b, s, e), docof(b, d), exec_build(c), node(d, c, _, cs, ce), cs >= s, ce <= e.
.decl branch_else_direct(b: node)
branch_else_direct(b) :- branch_else(b, s, e), docof(b, d), exec_direct(c), node(d, c, _, cs, ce), cs >= s, ce <= e.

// ---- module_string_values: the last module-level `NAME = "…"` per name (row_number() by __start DESC = 1) ----
.decl msv_candidate(d: number, name: symbol, value: symbol, s: number)
msv_candidate(d, name, v, s) :- assignments(a, t), !assignment_typed(a), kind(t, "identifier"), text(t, name), child(expr, a, _), snode(expr),
    child(root, expr, _), snode(root), kind(root, "module"), field(a, "right", r), docof(a, d), node(d, r, _, rs, re),
    strings(x, v), node(d, x, _, rs, re), start(a, s).
.decl msv_start(d: number, name: symbol, s: number)
msv_start(d, name, s) :- msv_candidate(d, name, _, s).
.decl msv_last(d: number, name: symbol, s: number)
msv_last(d, name, s) :- msv_start(d, name, _), s = max t : { msv_start(d, name, t) }.
.decl module_string_values(d: number, name: symbol, value: symbol)
module_string_values(d, name, v) :- msv_candidate(d, name, v, s), msv_last(d, name, s).

// ---- through_conditions: `x == "through"` / `x in {"through"}` comparisons ----
.decl cmp_operand(c: node, o: node)
cmp_operand(c, o) :- snode(c), kind(c, "comparison_operator"), visible_child(c, o), kind(o, k), k != "comment".
.decl cmp_between(c: node, p: node, o: node)
cmp_between(c, p, o) :- cmp_operand(c, o), cmp_operand(c, p), cmp_operand(c, x), start(p, ps), start(x, xs), start(o, os), ps < xs, xs < os.
.decl cmp_adjacent(c: node, p: node, o: node)
cmp_adjacent(c, p, o) :- cmp_operand(c, o), cmp_operand(c, p), start(p, ps), start(o, os), ps < os, !cmp_between(c, p, o).
// The operator: TRIM of the comparison's bytes between the two operands.
.decl cmp_op(c: node, p: node, o: node, op: symbol)
cmp_op(c, p, o, op) :- cmp_adjacent(c, p, o), text(c, ct), node(_, c, _, cs, _), node(_, p, _, _, pe), start(o, os),
    op = @trim(@substr_bytes(ct, @add(@sub(pe, cs), 1), @sub(os, pe))).
.decl string_at(n: node, value: symbol)
string_at(n, v) :- snode(n), node(d, n, _, s, e), strings(x, v), node(d, x, _, s, e).
.decl through_el(o: node, el: node)
through_el(o, el) :- visible_child(o, el), string_at(el, "through").
.decl through_el_count(o: node, k: number)
through_el_count(o, k) :- through_el(o, _), k = count : { through_el(o, _) }.
.decl through_bad_scalar(o: node)
through_bad_scalar(o) :- visible_child(o, el), kind(el, k), in_list("scalar_kind", k).
.decl through_other(o: node)
through_other(o) :- visible_child(o, el), string_at(el, v), v != "through".
.decl through_conditions(c: node)
through_conditions(c) :- cmp_op(c, _, o, op), in_list("eq_op", op), descendants(o, lit), string_at(lit, "through").
through_conditions(c) :- cmp_op(c, _, o, op), in_list("in_op", op), kind(o, k), in_list("collection_kind", k), through_el_count(o, 1),
    !through_bad_scalar(o), !through_other(o).

// ---- preop_functions: a set recursion over the in-file call graph by name ----
.decl preop_functions(d: number, name: symbol)
preop_functions(d, n) :- functions(f, n), docof(f, d), descendants(f, c), calls(c, _, _, _, ce), in_list("preop_runtime", ce).
preop_functions(d, n) :- functions(f, n), docof(f, d), descendants(f, c), calls(c, _, _, _, ce), preop_functions(d, ce).

// ---- scopes, scope_owners, scope_chain ----
.decl scopes(s: node, kind: symbol)
scopes(s, k) :- snode(s), kind(s, k), in_list("scope_kind", k).
// enclosing: NULL for the module; else the parent's ownership.fn, else the file's module.
.decl scope_parent_fn(s: node)
scope_parent_fn(s) :- scopes(s, k), k != "module", child(p, s, _), own_fn(p, _).
.decl scope_enclosing(s: node, e: node)
scope_enclosing(s, f) :- scopes(s, k), k != "module", child(p, s, _), own_fn(p, f).
scope_enclosing(s, m) :- scopes(s, k), k != "module", !scope_parent_fn(s), docof(s, d), module_root(d, m).
// scope: the class when it lies within the function (or there is no function), else the function, else the module.
.decl scope_owners(n: node, scope: node)
scope_owners(n, c) :- own_cls(n, c), own_fn(n, f), node(_, c, _, cs, ce), node(_, f, _, fs, fe), cs >= fs, ce <= fe.
scope_owners(n, c) :- own_cls(n, c), !has_own_fn(n).
scope_owners(n, f) :- own_fn(n, f), own_cls(n, c), node(_, c, _, cs, _), node(_, f, _, fs, _), cs < fs.
scope_owners(n, f) :- own_fn(n, f), own_cls(n, c), node(_, c, _, _, ce), node(_, f, _, _, fe), ce > fe.
scope_owners(n, f) :- own_fn(n, f), !has_own_cls(n).
scope_owners(n, m) :- snode(n), !has_own_fn(n), !has_own_cls(n), docof(n, d), module_root(d, m).
// The SQL climbs `enclosing` one scope per round, depth + 1 (E0 #22, a bag over a forest). Following `enclosing`
// from a scope visits each function strictly above it, then the module: the ancestors are those, and the depth of
// one is the number of chain members up to it (the functions strictly above the scope and within-or-equal to it,
// plus it).
.decl fn_ancestor(s: node, f: node)
fn_ancestor(s, f) :- scopes(s, k), k != "module", docof(s, d), node(d, f, "function_definition", _, _), snode(f), @within(s, f) = 1.
.decl chain_pair(s: node, a: node)
chain_pair(s, a) :- fn_ancestor(s, a).
chain_pair(s, m) :- scopes(s, k), k != "module", docof(s, d), module_root(d, m).
.decl chain_hop(s: node, a: node, f: node)
chain_hop(s, a, a) :- chain_pair(s, a).
chain_hop(s, a, f) :- chain_pair(s, a), fn_ancestor(s, f), @within(f, a) = 1.
.decl scope_chain(scope: node, ancestor: node, depth: number)
scope_chain(s, s, 0) :- scopes(s, _).
scope_chain(s, a, k) :- chain_pair(s, a), k = count : { chain_hop(s, a, _) }.

// ---- scope_imports, scope_shadows ----
.decl scope_imports(scope: node, name: symbol, origin: symbol)
scope_imports(sc, a, o) :- from_imports(st, i, m, n), kind(st, "import_from_statement"), scope_owners(st, sc), from_import_alias(i, a), o = @concat(m, ".", n).
scope_imports(sc, n, o) :- from_imports(st, i, m, n), kind(st, "import_from_statement"), scope_owners(st, sc), !from_import_alias(i, _), o = @concat(m, ".", n).
scope_imports(sc, a, n) :- direct_imports(st, i, n), kind(st, "import_statement"), scope_owners(st, sc), direct_import_alias(i, a).
scope_imports(sc, h, h) :- direct_imports(st, i, n), kind(st, "import_statement"), scope_owners(st, sc), !direct_import_alias(i, _), h = @rx_extract(n, "^[^.]+", 0).
// target_root: the statement for `del`, `name` for a walrus, else `left`.
.decl binding_target(n: node, t: node)
binding_target(n, n) :- snode(n), kind(n, "delete_statement").
binding_target(n, t) :- snode(n), kind(n, "named_expression"), field(n, "name", t).
binding_target(n, t) :- snode(n), kind(n, k), in_list("left_binding", k), field(n, "left", t).
.decl scope_shadows(scope: node, name: symbol)
scope_shadows(sc, name) :- binding_target(n, t), scope_owners(n, sc), descendants(t, x), py_names(x, name).
scope_shadows(f, name) :- parameters(f, name).
scope_shadows(sc, name) :- snode(n), kind(n, k), in_list("fdcd", k), child(p, n, _), scope_owners(p, sc), field(n, "name", x), text(x, name).
scope_shadows(s, name) :- snode(n), kind(n, "global_statement"), docof(n, d), node(d, n, _, ns, ne), scopes(s, "module"), node(d, s, _, ss, se),
    ns >= ss, ne <= se, visible_child(n, x), kind(x, "identifier"), text(x, name).
scope_shadows(s, name) :- snode(n), kind(n, "nonlocal_statement"), docof(n, d), node(d, n, _, ns, ne), scopes(s, "function_definition"), node(d, s, _, ss, se),
    ns >= ss, ne <= se, visible_child(n, x), kind(x, "identifier"), text(x, name).

// ---- annotations and their atoms ----
.decl annotations(a: node, scope: node)
annotations(a, sc) :- assignments(a, t), assignment_typed(a), kind(t, "identifier"), scope_owners(a, sc), scopes(sc, _).
.decl annotation_function_local(a: node)
annotation_function_local(a) :- annotations(a, sc), scopes(sc, "function_definition").
// atom_id: the node's id, or 'quoted:' || string start || ':' || atom for an atom of a quoted annotation.
.decl annotation_atoms(ann: node, scope: node, atom_id: symbol, s: number, e: number, atom: symbol)
annotation_atoms(a, sc, id, s, e, t) :- annotations(a, sc), field(a, "type", ty), descendants(ty, n), kind(n, "identifier"), child(p, n, _), kind(p, pk),
    pk != "attribute", node(_, n, _, s, e), text(n, t), id = @id(n).
annotation_atoms(a, sc, id, s, e, atom) :- annotations(a, sc), field(a, "type", ty), descendants(ty, n), attributes(n, _, _, _), child(p, n, _), kind(p, pk),
    pk != "attribute", text(n, t), @rx_matches(t, "^[A-Za-z_]\\w*(?:\\s*\\.\\s*[A-Za-z_]\\w*)*$") = 1, atom = @rx_replace(t, "\\s+", ""), node(_, n, _, s, e), id = @id(n).
annotation_atoms(a, sc, id, s, e, attr) :- annotations(a, sc), field(a, "type", ty), descendants(ty, n), attributes(n, attr, _, _), text(n, t),
    @rx_matches(t, "^[A-Za-z_]\\w*(?:\\s*\\.\\s*[A-Za-z_]\\w*)*$") = 0, node(_, n, _, s, e), id = @id(n).
annotation_atoms(a, sc, id, s, e, atom) :- quoted_atoms(q, ann, atom), docof(q, d), node(d, ann, _, as, ae), annotations(a, sc), node(d, a, _, as, ae),
    node(d, q, _, s, e), id = @printf("quoted:%d:%s", s, atom).
// atom_imports: the imports of the atom's head name at the nearest scope of its chain that has one; unshadowed when
// no scope up to that depth binds the name.
.decl atom_import_cand(ann: node, atom_id: symbol, scope: node, ancestor: node, depth: number, name: symbol, origin: symbol)
atom_import_cand(a, id, sc, anc, dep, h, o) :- annotation_atoms(a, sc, id, _, _, t), h = @rx_extract(t, "^[A-Za-z_]\\w*", 0), scope_chain(sc, anc, dep),
    scope_imports(anc, h, o).
.decl atom_import_nearer(ann: node, atom_id: symbol, depth: number)
atom_import_nearer(a, id, dep) :- atom_import_cand(a, id, sc, _, dep, h, _), scope_chain(sc, near, nd), nd < dep, scope_imports(near, h, _).
.decl atom_shadowed(ann: node, atom_id: symbol, depth: number)
atom_shadowed(a, id, dep) :- atom_import_cand(a, id, sc, _, dep, h, _), scope_chain(sc, sa, sd), sd <= dep, scope_shadows(sa, h).
.decl atom_imports(ann: node, atom_id: symbol, origin: symbol)
atom_imports(a, id, o) :- atom_import_cand(a, id, _, _, dep, _, o), !atom_import_nearer(a, id, dep).
.decl atom_unshadowed(ann: node, atom_id: symbol, origin: symbol)
atom_unshadowed(a, id, o) :- atom_import_cand(a, id, _, _, dep, _, o), !atom_import_nearer(a, id, dep), !atom_shadowed(a, id, dep).
.decl has_atom_import(ann: node, atom_id: symbol)
has_atom_import(a, id) :- atom_imports(a, id, _).
.decl atom_origin_count(ann: node, atom_id: symbol, k: number)
atom_origin_count(a, id, k) :- atom_imports(a, id, _), k = count : { atom_imports(a, id, _) }.
// origin: the import's origin || the atom past its head; trusted: unshadowed and one distinct origin.
.decl resolved_atoms(ann: node, atom_id: symbol, s: number, e: number, origin: symbol)
resolved_atoms(a, id, s, e, o) :- annotation_atoms(a, _, id, s, e, t), atom_imports(a, id, io), h = @rx_extract(t, "^[A-Za-z_]\\w*", 0),
    o = @concat(io, @substr(t, @add(@length(h), 1))).
resolved_atoms(a, id, s, e, t) :- annotation_atoms(a, _, id, s, e, t), !has_atom_import(a, id).
.decl resolved_trusted(ann: node, atom_id: symbol, origin: symbol)
resolved_trusted(a, id, o) :- annotation_atoms(a, _, id, _, _, t), atom_unshadowed(a, id, io), atom_origin_count(a, id, 1),
    h = @rx_extract(t, "^[A-Za-z_]\\w*", 0), o = @concat(io, @substr(t, @add(@length(h), 1))).
// Atoms inside a trusted Literal[…] (any argument) or Annotated[…] (past the first) of the annotation's type.
.decl generic_arg(ann: node, origin: symbol, arg: node)
generic_arg(a, io, arg) :- annotations(a, _), field(a, "type", ty), docof(a, d), node(d, ty, _, ts, te), node(d, g, "generic_type", gs, ge), snode(g),
    gs >= ts, ge <= te, visible_child(g, base), ordinal(base, 0), bid = @id(base), resolved_trusted(a, bid, io), in_list("metadata_origin", io),
    visible_child(g, params), kind(params, "type_parameter"), visible_child(params, arg).
.decl ignored_annotation_metadata(ann: node, atom_id: symbol)
ignored_annotation_metadata(a, id) :- resolved_atoms(a, id, as, ae, _), generic_arg(a, io, arg), in_list("literal_origin", io), node(_, arg, _, rs, re),
    as >= rs, ae <= re.
ignored_annotation_metadata(a, id) :- resolved_atoms(a, id, as, ae, _), generic_arg(a, _, arg), ordinal(arg, k), k > 0, node(_, arg, _, rs, re),
    as >= rs, ae <= re.

// ---- diagnostics_0 … diagnostics_6: one rule per UNION ALL arm (an OR inside an arm: one rule per branch) ----
// Each row: the anchor node n, issue, identity (node ids through @id, as the SQL's `||`), detector. The arms' `(1)`
// filler conditions are dropped. `JOIN files p` holds whenever primary_file / fallback_file does.
in_list("duck", "getattr"). in_list("duck", "hasattr").
