.decl from_imports(st: node, imported: node, module: symbol, name: symbol)
from_imports(st, i, m, n) :- ast(d, st, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"any": [{"any": [{"filePath": {"regex": "^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$"}}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$)"}}]}]}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:l9750_graphql/|l2080_lazy_orm/|l2060_query_builder/|l9900_auto_api/)"}}]}]}}}}, "default": {"filePath": {"regex": "(?s).*"}}}, {"all": [{"kind": "import_from_statement"}, {"has": {"pattern": "$MODULE", "stopBy": "neighbor", "field": "module_name"}}, {"has": {"any": [{"all": [{"kind": "dotted_name"}, {"pattern": "$IMPORTED"}]}, {"all": [{"kind": "aliased_import"}, {"has": {"pattern": "$IMPORTED", "stopBy": "neighbor", "field": "name"}}, {"has": {"pattern": "$ALIAS", "stopBy": "neighbor", "field": "alias"}}]}], "stopBy": "neighbor", "field": "name"}}]}]}}, MODULE: mn, IMPORTED: i), text(mn, m), text(i, n).
.decl from_import_alias(imported: node, alias: symbol)
from_import_alias(i, a) :- from_imports(_, i, _, _), field(ai, "name", i), kind(ai, "aliased_import"), field(ai, "alias", x), text(x, a).
// COALESCE(alias, '')
.decl from_import_alias_text(imported: node, alias: symbol)
from_import_alias_text(i, a) :- from_import_alias(i, a).
from_import_alias_text(i, "") :- from_imports(_, i, _, _), !from_import_alias(i, _).
.decl direct_imports(st: node, imported: node, name: symbol)
direct_imports(st, i, n) :- ast(d, st, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"any": [{"any": [{"filePath": {"regex": "^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$"}}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$)"}}]}]}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:l9750_graphql/|l2080_lazy_orm/|l2060_query_builder/|l9900_auto_api/)"}}]}]}}}}, "default": {"filePath": {"regex": "(?s).*"}}}, {"all": [{"kind": "import_statement"}, {"has": {"any": [{"all": [{"kind": "dotted_name"}, {"pattern": "$IMPORTED"}]}, {"all": [{"kind": "aliased_import"}, {"has": {"pattern": "$IMPORTED", "stopBy": "neighbor", "field": "name"}}, {"has": {"pattern": "$ALIAS", "stopBy": "neighbor", "field": "alias"}}]}], "stopBy": "neighbor", "field": "name"}}]}]}}, IMPORTED: i), text(i, n).
.decl direct_import_alias(imported: node, alias: symbol)
direct_import_alias(i, a) :- direct_imports(_, i, _), field(ai, "name", i), kind(ai, "aliased_import"), field(ai, "alias", x), text(x, a).
// each ATOM (a node of the annotation string's re-parse), anchored at the string; ANN is the assignment.
