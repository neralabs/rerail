// data-layer-serverplan-steps in Rerail logic: clause `runtime-reference-summaries` (STEP-033, STEP-034, STEP-035), a
// part of serverplan_steps.rdl; options at their defaults (entryPoint "all"). Source:
// gate/data-layer/packs/data-layer/candidates/rules/data-layer-serverplan-steps.json.
//
// One relation per SQL stage, under the stage's name. The clause is per file (partitionBy file): an id
// `kind:start:end` is that node, a function's `__start` is the function node, and text joins stay in one document
// (`docof`). Inputs are matcher atoms with the rule's matchers verbatim; `calls`' optional captures are a tree relation
// (TERM: the function field, an identifier, or an attribute's attribute field) and second atoms whose matcher is the
// capture's condition alone, on the same node (DECLARED, RUNTIME_REFS; with the matcher's `empty-refs` util).
// `postops` rows are anchored at VALUE (the evidence's `anchor`).
//
// Builtins: @within. A builtin with no value (SQL NULL) binds nothing.
// findings layer (§8): detector and identity (`fn || ':' || keyword`, `f.__start`); a finding is (issue, node).
// ties: `locals` keeps the last binding of a name by start; distinct bindings do not share a start.

.decl finding(clause: symbol, key: symbol, n: node)
.output finding

// ---- inputs (evidence) ----
.decl functions(f: node, name: symbol)
functions(f, s) :- ast(d, f, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "function_definition"}, {"has": {"pattern": "$NAME", "stopBy": "neighbor", "field": "name"}}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, NAME: x), text(x, s).
.decl calls(c: node, full_callee: symbol)
calls(c, t) :- ast(d, c, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "call"}, {"pattern": "$CALL"}, {"has": {"pattern": "$FUNC", "stopBy": "neighbor", "field": "function"}}, {"any": [{"has": {"any": [{"all": [{"kind": "identifier"}, {"pattern": "$TERM"}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}, {"pattern": "$_"}]}, {"any": [{"all": [{"has": {"has": {"all": [{"kind": "keyword_argument"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:runtime_ref_ids|source_refs)$"}], "stopBy": "neighbor", "field": "name"}}, {"has": {"not": {"matches": "empty-refs"}, "stopBy": "neighbor", "field": "value"}}], "stopBy": "neighbor"}, "stopBy": "neighbor", "field": "arguments"}}, {"pattern": "$DECLARED"}]}, {"pattern": "$_"}]}, {"any": [{"all": [{"has": {"has": {"all": [{"kind": "keyword_argument"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:runtime_ref_ids)$"}], "stopBy": "neighbor", "field": "name"}}, {"has": {"not": {"matches": "empty-refs"}, "stopBy": "neighbor", "field": "value"}}], "stopBy": "neighbor"}, "stopBy": "neighbor", "field": "arguments"}}, {"pattern": "$RUNTIME_REFS"}]}, {"pattern": "$_"}]}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, FUNC: x), text(x, t).
.decl calls_callee(c: node, callee: symbol)
calls_callee(c, s) :- calls(c, _), field(c, "function", x), kind(x, "identifier"), text(x, s).
calls_callee(c, s) :- calls(c, _), field(c, "function", x), kind(x, "attribute"), field(x, "attribute", t), text(t, s).
// refs: DECLARED.startByte, a non-empty runtime_ref_ids or source_refs keyword.
.decl calls_refs(c: node)
calls_refs(c) :- calls(c, _), docof(c, d), ast(d, c, {"language": "python", "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}, "rule": {"has": {"has": {"all": [{"kind": "keyword_argument"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:runtime_ref_ids|source_refs)$"}], "stopBy": "neighbor", "field": "name"}}, {"has": {"not": {"matches": "empty-refs"}, "stopBy": "neighbor", "field": "value"}}], "stopBy": "neighbor"}, "stopBy": "neighbor", "field": "arguments"}}}).
// runtime_refs: RUNTIME_REFS.startByte, a non-empty runtime_ref_ids keyword.
.decl calls_runtime_refs(c: node)
calls_runtime_refs(c) :- calls(c, _), docof(c, d), ast(d, c, {"language": "python", "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}, "rule": {"has": {"has": {"all": [{"kind": "keyword_argument"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:runtime_ref_ids)$"}], "stopBy": "neighbor", "field": "name"}}, {"has": {"not": {"matches": "empty-refs"}, "stopBy": "neighbor", "field": "value"}}], "stopBy": "neighbor"}, "stopBy": "neighbor", "field": "arguments"}}}).
.decl positional_edges(src: node, dst: node)
positional_edges(s, t) :- ast(d, s, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"any": [{"kind": "identifier"}, {"kind": "call"}, {"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}, {"kind": "dictionary"}, {"kind": "expression_list"}, {"kind": "parenthesized_expression"}]}, {"pattern": "$SRC"}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "call"}, {"pattern": "$DST"}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, DST: t).
.decl keyword_edges(src: node, dst: node)
keyword_edges(s, t) :- ast(d, k, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "keyword_argument"}, {"has": {"all": [{"any": [{"kind": "identifier"}, {"kind": "call"}, {"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}, {"kind": "dictionary"}, {"kind": "expression_list"}, {"kind": "parenthesized_expression"}]}, {"pattern": "$SRC"}], "stopBy": "neighbor", "field": "value"}}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "call"}, {"pattern": "$DST"}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, SRC: s, DST: t).
.decl container_edges(src: node, dst: node)
container_edges(s, t) :- ast(d, s, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"any": [{"kind": "identifier"}, {"kind": "call"}, {"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}, {"kind": "dictionary"}, {"kind": "expression_list"}, {"kind": "parenthesized_expression"}]}, {"pattern": "$SRC"}, {"inside": {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}, {"kind": "expression_list"}, {"kind": "parenthesized_expression"}]}, {"pattern": "$DST"}], "stopBy": "neighbor"}}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, DST: t).
.decl dictionary_edges(src: node, dst: node)
dictionary_edges(s, t) :- ast(d, p, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "pair"}, {"has": {"all": [{"any": [{"kind": "identifier"}, {"kind": "call"}, {"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}, {"kind": "dictionary"}, {"kind": "expression_list"}, {"kind": "parenthesized_expression"}]}, {"pattern": "$SRC"}], "stopBy": "neighbor", "field": "value"}}, {"inside": {"all": [{"kind": "dictionary"}, {"pattern": "$DST"}], "stopBy": "neighbor"}}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, SRC: s, DST: t).
.decl spread_edges(src: node, dst: node)
spread_edges(s, t) :- ast(d, p, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "dictionary_splat"}, {"has": {"all": [{"any": [{"kind": "identifier"}, {"kind": "call"}, {"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}, {"kind": "dictionary"}, {"kind": "expression_list"}, {"kind": "parenthesized_expression"}]}, {"pattern": "$SRC"}], "stopBy": "neighbor"}}, {"any": [{"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "call"}, {"pattern": "$DST"}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}, {"inside": {"all": [{"kind": "dictionary"}, {"pattern": "$DST"}], "stopBy": "neighbor"}}]}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, SRC: s, DST: t).
// fn: FN.startByte, the function node.
.decl returns(r: node, value: node, fn: node)
returns(r, v, f) :- ast(d, r, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "return_statement"}, {"has": {"all": [{"pattern": "$VALUE"}, {"not": {"kind": "comment"}}], "stopBy": "neighbor"}}, {"inside": {"all": [{"kind": "function_definition"}, {"pattern": "$FN"}], "stopBy": {"any": [{"kind": "function_definition"}, {"kind": "lambda"}]}}}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, VALUE: v, FN: f).
.decl bindings(b: node, name: symbol, value: node)
bindings(b, s, v) :- ast(d, b, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "assignment"}, {"has": {"all": [{"kind": "identifier"}, {"pattern": "$NAME"}], "stopBy": "neighbor", "field": "left"}}, {"has": {"pattern": "$VALUE", "stopBy": "neighbor", "field": "right"}}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, NAME: x, VALUE: v), text(x, s).
// call: CALL.startByte; keyword: KW.startByte, the matched keyword argument.
.decl postops(value: node, keyword: node, call: node)
postops(v, k, c) :- ast(d, k, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_runtime_ref_closed_post_op_consumption_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_helper_anchored_runtime_ref_post_op_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_post_op_requires_runtime_refs_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "keyword_argument"}, {"pattern": "$KW"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:closed_post_op)$"}], "stopBy": "neighbor", "field": "name"}}, {"has": {"pattern": "$VALUE", "stopBy": "neighbor", "field": "value"}}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "call"}, {"pattern": "$CALL"}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}]}, "utils": {"empty-refs": {"any": [{"kind": "none"}, {"all": [{"any": [{"all": [{"kind": "string"}, {"regex": "(?i)^[ru]*[\"']"}]}, {"all": [{"kind": "concatenated_string"}, {"not": {"has": {"kind": "interpolation", "stopBy": "end"}}}]}]}, {"value": {"eq": ""}}]}, {"all": [{"any": [{"kind": "tuple"}, {"kind": "list"}, {"kind": "set"}]}, {"not": {"has": {"not": {"kind": "comment"}, "stopBy": "neighbor"}}}]}, {"all": [{"kind": "parenthesized_expression"}, {"has": {"matches": "empty-refs", "stopBy": "neighbor"}}]}]}}}, VALUE: v, CALL: c).

// ---- edges, nodes ----
.decl edges(src: node, dst: node)
edges(s, t) :- positional_edges(s, t).
edges(s, t) :- keyword_edges(s, t).
edges(s, t) :- container_edges(s, t).
edges(s, t) :- dictionary_edges(s, t).
edges(s, t) :- spread_edges(s, t).
// text: max(text) per node is its text, except a call seen only in `calls` ('' there); only identifiers' text is read.
.decl nodes(n: node)
nodes(s) :- edges(s, _).
nodes(t) :- edges(_, t).
nodes(c) :- calls(c, _).
nodes(v) :- returns(_, v, _).
nodes(v) :- bindings(_, _, v).

// ---- contexts, locals, flows ----
// f.__start <= n.start AND f.__end >= n.end: the node is inside the function (no expression spans a def). Every
// enclosing function, not only the nearest.
.decl contexts(n: node, fn: node)
contexts(n, f) :- nodes(n), functions(f, _), @within(n, f) = 1.
// b.__start > f.__start AND b.__end <= f.__end, row_number() OVER (PARTITION BY fn, name ORDER BY b.__start DESC) = 1.
.decl local_row(fn: node, name: symbol, s: number, value: node)
local_row(f, s, st, v) :- functions(f, _), bindings(b, s, v), @within(b, f) = 1, start(b, st).
.decl local_last(fn: node, name: symbol, s: number)
local_last(f, s, st) :- local_row(f, s, _, _), st = max t : { local_row(f, s, t, _) }.
.decl locals(fn: node, name: symbol, value: node)
locals(f, s, v) :- local_row(f, s, st, v), local_last(f, s, st).
.decl flows(fn: node, src: node, dst: node)
flows(f, s, t) :- edges(s, t), contexts(t, f).
flows(f, v, n) :- nodes(n), kind(n, "identifier"), contexts(n, f), text(n, s), locals(f, s, v).

// ---- consumers, refless: set recursions over (fn, node), intra-function flows and returns to call sites (E0 rows 67, 68) ----
// A returned node of a function reaches each in-file call of the function's name, in every function enclosing the call.
.decl returned_call(fn: node, value: node, call: node)
returned_call(f, v, c) :- returns(_, v, f), functions(f, s), docof(f, d), calls(c, s), docof(c, d).
.decl consumers(fn: node, id: node)
consumers(f, c) :- calls(c, _), calls_refs(c), contexts(c, f).
consumers(f, t) :- consumers(f, s), flows(f, s, t).
consumers(g, c) :- consumers(f, v), returned_call(f, v, c), contexts(c, g).
// c.__start || ':' || c.__end = substr(e.dst, 6): the flow's target is such a call (its id less the 'call:' prefix).
.decl refs_post_op_call(c: node)
refs_post_op_call(c) :- calls(c, _), calls_callee(c, "runtime_refs_post_op").
.decl refless(fn: node, id: node)
refless(f, c) :- refs_post_op_call(c), !calls_refs(c), contexts(c, f).
refless(f, t) :- refless(f, s), flows(f, s, t), !refs_post_op_call(t).
refless(g, c) :- refless(f, v), returned_call(f, v, c), contexts(c, g).
refless(g, n) :- refless(f, v), returns(_, v, f), functions(f, s), docof(f, d), nodes(n), kind(n, "identifier"), text(n, s),
    docof(n, d), contexts(n, g), !locals(g, s, _).

// ---- the clause's query ----
// call.__start = p.call: every `calls` row starting where the post-op's call starts.
.decl postop_call(value: node, call: node)
postop_call(v, c2) :- postops(v, _, c), start(c, s), docof(c, d), calls(c2, _), start(c2, s), docof(c2, d).
.decl postop_consumed(value: node, call: node)
postop_consumed(v, c2) :- postop_call(v, c2), contexts(v, f), consumers(f, v).
// STEP-033: a consumed closed_post_op value of a call that declares runtime_ref_ids.
finding("runtime-reference-summaries", "STEP-033", v) :- postop_consumed(v, c2), calls_runtime_refs(c2).
// STEP-035: a consumed closed_post_op value of a call that does not.
finding("runtime-reference-summaries", "STEP-035", v) :- postop_consumed(v, c2), !calls_runtime_refs(c2).
// STEP-034: a function whose name some function shares that returns a refless runtime_refs_post_op.
finding("runtime-reference-summaries", "STEP-034", f) :- functions(f, s), docof(f, d), functions(a, s), docof(a, d), returns(_, v, a),
    refless(a, v).
