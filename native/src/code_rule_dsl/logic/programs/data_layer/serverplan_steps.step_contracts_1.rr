// data-layer-serverplan-steps in Rerail logic: clause `step-contracts-1` (31 stages, partitionBy file), a part file
// of serverplan_steps.rdl. Options at their defaults: entryPoint "all" (the matchers' `$option` file filter passes
// every file; the query is the `all` case, every check's branch), strictModulesOnly true (`relaxed` matches no file).
// Source: gate/data-layer/packs/data-layer/candidates/rules/data-layer-serverplan-steps.json.
//
// One relation per SQL stage, under the stage's name; a nullable or boolean column is a side relation
// `<stage>_<column>` that holds where the column is not NULL (true). A SQL row's id (kind:start:end) is a node; the
// clause is per file, so a join on a name keeps the document (`docof`). Inputs are matcher atoms with the rule's
// matchers verbatim (their `$option` cases included).
//
// Builtins: @cast_int (new: SQL CAST(text AS INTEGER), the leading integer, else 0), @depth (tape: the node's depth),
// @rx_extract, @rx_matches, @substr, @trim(s, chars) (SQL two-argument trim: strip those characters at both ends),
// @upper, @within (tape: strict descendant). A builtin with no value (SQL NULL) binds nothing.
// recursion: column_derived (E0 #51) is a set recursion (up `edges`, through local bindings); ownership (#49) and
// descendants (#50) are tape forms (`nearest`, `@within`).
// findings layer (§8): the rows' `entry` column (the Python check a row reproduces) and the identity text; the
// finding is (issue, node).
// OUTSIDE: none. missing fact: none. LIMIT/choice: none.
// ties: none. first_methods, levels, table_problems (least __start) and local_bindings (greatest __start) pick
// among nodes of distinct starts; the ordinal and position columns are exact.

.decl fdef(kind: symbol)
fdef("function_definition").
.decl cdef(kind: symbol)
cdef("class_definition").

// ---- inputs (evidence) ----
// raw_nodes: the selected nodes. Its captures are read by tree relations: PARENT is the tree parent (`child`), a field
// capture (NAME, BODY, VALUE, …) the node's `field` child, ANCESTOR the nearest selected strict ancestor (below).
.decl raw_nodes(n: node)
raw_nodes(n) :- ast(d, n, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_compile_must_not_raise": {"filePath": {"regex": "(?s).*"}}, "check_compile_no_data_branching": {"filePath": {"regex": "(?s).*"}}, "check_cte_type_hints_not_inferred_from_column_names": {"filePath": {"regex": "(?s).*"}}, "check_runtime_refs_without_sql_grammar_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_sql_visible_steps_declare_cte_type_hints": {"filePath": {"regex": "(?s).*"}}, "check_step_role_contract_guardrails": {"filePath": {"regex": "(?s).*"}}, "check_virtual_execute_runtime_python_shaping_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_virtual_execute_runtime_scalar_value_guardrail": {"filePath": {"regex": "(?s).*"}}, "check_zero_io_l0_execution_role_enum_semantics": {"filePath": {"regex": "(?s).*"}}, "check_zero_io_l0_execution_role_guardrail": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"any": [{"any": [{"kind": "module"}, {"all": [{"kind": "expression_statement"}, {"any": [{"inside": {"kind": "module", "stopBy": "neighbor"}}, {"inside": {"all": [{"kind": "block"}, {"inside": {"kind": "class_definition", "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}]}, {"kind": "class_definition"}, {"kind": "function_definition"}, {"kind": "decorated_definition"}, {"all": [{"kind": "argument_list"}, {"inside": {"kind": "class_definition", "stopBy": "neighbor"}}]}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"kind": "class_definition", "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}, {"all": [{"inside": {"all": [{"kind": "function_definition"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:cte_column_type_hints|cte_output_columns|emits_sql_for_accounting|execution_role|is_executor_owned_runtime_step|level|step_tags|supports