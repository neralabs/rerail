// data-layer-internal-dead-code in Rerail logic: clause `unreachable-internal-symbols`, options at their defaults
// (oracleAnalyzer false). Source: gate/data-layer/packs/data-layer/candidates/rules/data-layer-internal-dead-code.json.
//
// One relation per SQL stage, under the stage's name. A SQL row keyed by (__path, __start) is a node here; a nullable
// column is a side relation that holds where the column is not NULL. Inputs are matcher atoms with the rule's matchers
// verbatim; an atom exports only captures every match binds, and an optional capture (`any: [X, {pattern: $_}]`) is
// read by a second atom whose matcher is X alone, on the same node. The clause is repository-wide (no partitionBy):
// symbols are joined across documents on computed names (`@cat`, `@concat`).
//
// Builtins (t17's catalogue; only `@cat` is built): @rx_replace, @rx_extract, @rx_matches, @replace, @concat, @substr,
// @instr, @lower, @length, @ltrim, @trim, @sub (a − b − …), @printf, @drop_components (drop k trailing dotted components), @join_nonempty
// (join the non-empty arguments after the first with the first). A builtin with no value (SQL NULL) binds nothing.
.policy {"format": "rerail.policy/v1", "id": "data-layer-internal-dead-code", "revision": 2, "mode": "log", "description": "Candidate port of nera-data-layer internal_dead_code at 2b1504adc4291daaf080b2e932962b134da1a69a.", "scope": {"include": ["api/**/*.py", "impl/**/*.py", "data_layer/**/*.py", "_internal/**/*.py", "l1000_cache/**/*.py", "l1000_schema/**/*.py", "l1050_model_registry/**/*.py", "l1050_polymorphism/**/*.py", "l1100_exceptions/**/*.py", "l1200_capabilities/**/*.py", "l1200_content_hash/**/*.py", "l1200_json/**/*.py", "l1200_versioned_ids/**/*.py", "l1250_security/**/*.py", "l1300_session/**/*.py", "l1350_foundational_types/**/*.py", "l1400_config/**/*.py", "l1400_types/**/*.py", "l1450_index_policy_contracts/**/*.py", "l1450_keys/**/*.py", "l1470_matching_contracts/**/*.py", "l1500_llm/**/*.py", "l1900_retry/**/*.py", "l2000_connection/**/*.py", "l2050_transaction/**/*.py", "l2055_lazy_result/**/*.py", "l2060_query_builder/**/*.py", "l2070_batching/**/*.py", "l2080_lazy_orm/**/*.py", "l2090_byte_tracking/**/*.py", "l2090_response/**/*.py", "l2091_rtt_tracking/**/*.py", "l2092_timing_tracking/**/*.py", "l2100_include/**/*.py", "l2110_limits/**/*.py", "l2150_prepared_cache/**/*.py", "l2200_notification/**/*.py", "l2500_binary_diff/**/*.py", "l3000_schema_builder/**/*.py", "l3100_schema_introspector/**/*.py", "l3150_schema_diff/**/*.py", "l3200_metadata/**/*.py", "l3250_migrations/**/*.py", "l3260_startup/**/*.py", "l3500_bulk_ops/**/*.py", "l4000_permissions/**/*.py", "l4050_background_reaper/**/*.py", "l4100_queue/**/*.py", "l4150_scheduler/**/*.py", "l4170_inbound_bridge/**/*.py", "l4200_event_pipeline/**/*.py", "l4250_timers/**/*.py", "l4300_ipc/**/*.py", "l4300_timers/**/*.py", "l4350_timer_driver/**/*.py", "l4400_scheduler/**/*.py", "l4500_trust/**/*.py", "l5000_search_index_policy/**/*.py", "l5000_subscriptions/**/*.py", "l5100_fts/**/*.py", "l5100_llm_router/**/*.py", "l5175_chunking/**/*.py", "l5195_embedding_compute_tables/**/*.py", "l5200_vec