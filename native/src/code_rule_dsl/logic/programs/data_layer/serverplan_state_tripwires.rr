{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:LazyBuilderContext|_add_intent|_add_intent_by_ref|_get_lazy_plan|aggregate_later|bindings_later|count_lazy|execute_aggregate_lazy|execute_bindings_lazy|execute_graph_lazy|execute_lazy|exists_lazy)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:LazyBuilderContext|_add_intent|_add_intent_by_ref|_get_lazy_plan|aggregate_later|bindings_later|count_lazy|execute_aggregate_lazy|execute_bindings_lazy|execute_graph_lazy|execute_lazy|exists_lazy)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:_step_ref_id)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "end"}}], "stopBy": "neighbor", "field": "value"}}], "stopBy": "neighbor"}, "stopBy": "neighbor", "field": "arguments"}}]}]}, {"pattern": "$ROOT"}, {"any": [{"inside": {"all": [{"kind": "function_definition"}, {"pattern": "$SCOPE"}], "stopBy": {"kind": "function_definition"}}}, {"pattern": "$_"}]}, {"any": [{"any": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"pattern": "$TERM"}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"all": [{"any": [{"kind": "class_definition"}, {"kind": "function_definition"}]}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "name"}}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}]}, {"pattern": "$_"}]}]}]}}).
.decl events_detail(clause: symbol, n: node, detail: symbol)
events_detail("compiled-ir-value", n, s) :- ast(d, n, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"any": [{"matches": "state-project-source"}, {"inside": {"matches": "state-project-source", "stopBy": "end"}}]}}}, {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "scan_source": {"filePath": {"regex": "(?s).*"}}, "scan_tree": {"filePath": {"regex": "(?s).*"}}, "scan_project_sources": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:CompiledStep)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:CompiledStep)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"not": {"filePath": {"regex": "/tests/"}}}, {"has": {"has": {"all": [{"kind": "keyword_argument"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:ir)$"}], "stopBy": "neighbor", "field": "name"}}, {"has": {"all": [{"pattern": "$IR"}, {"not": {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:SqlStepIR)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:SqlStepIR)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}}], "stopBy": "neighbor", "field": "value"}}], "stopBy": "neighbor"}, "stopBy": "neighbor", "field": "arguments"}}]}, {"pattern": "$ROOT"}, {"any": [{"inside": {"all": [{"kind": "function_definition"}, {"pattern": "$SCOPE"}], "stopBy": {"kind": "function_definition"}}}, {"pattern": "$_"}]}, {"any": [{"any": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"pattern": "$TERM"}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"all": [{"any": [{"kind": "class_definition"}, {"kind": "function_definition"}]}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "name"}}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}]}, {"pattern": "$_"}]}]}]}}, IR: x), text(x, s).
events_detail("executor-ir-dispatch", n, s) :- ast(d, n, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"any": [{"matches": "state-project-source"}, {"inside": {"matches": "state-project-source", "stopBy": "end"}}]}}}, {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "scan_source": {"filePath": {"regex": "(?s).*"}}, "scan_tree": {"filePath": {"regex": "(?s).*"}}, "scan_project_sources": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:isinstance)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:isinstance)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/sql_backend_executor\\.py|l2070_batching/executor\\.py)$"}}, {"has": {"has": {"all": [{"any": [{"all": [{"all": [{"kind": "identifier"}, {"regex": "^(?:StepIR|PipelineResolvedIR|[A-Za-z_]\\w*IR)$"}, {"not": {"all": [{"kind": "identifier"}, {"regex": "^(?:SqlStepIR)$"}]}}]}, {"pattern": "$IR_NAME"}]}, {"has": {"all": [{"all": [{"kind": "identifier"}, {"regex": "^(?:StepIR|PipelineResolvedIR|[A-Za-z_]\\w*IR)$"}, {"not": {"all": [{"kind": "identifier"}, {"regex": "^(?:SqlStepIR)$"}]}}]}, {"pattern": "$IR_NAME"}], "stopBy": "end"}}]}, {"nthChild": {"position": 2, "ofRule": {"not": {"kind": "comment"}}}}], "stopBy": "neighbor"}, "stopBy": "neighbor", "field": "arguments"}}, {"not": {"filePath": {"regex": "/tests/"}}}]}, {"pattern": "$ROOT"}, {"any": [{"inside": {"all": [{"kind": "function_definition"}, {"pattern": "$SCOPE"}], "stopBy": {"kind": "function_definition"}}}, {"pattern": "$_"}]}, {"any": [{"any": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"pattern": "$TERM"}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"all": [{"any": [{"kind": "class_definition"}, {"kind": "function_definition"}]}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "name"}}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}]}, {"pattern": "$_"}]}]}]}}, IR_NAME: x), text(x, s).
events_detail("graph-id-config", n, s) :- ast(d, n, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"any": [{"matches": "state-project-source"}, {"inside": {"matches": "state-project-source", "stopBy": "end"}}]}}}, {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "scan_source": {"filePath": {"regex": "(?s).*"}}, "scan_tree": {"filePath": {"regex": "(?s).*"}}, "scan_project_sources": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "assignment"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "graph_id"}, {"pattern": "$FIELD"}], "stopBy": "neighbor", "field": "left"}}, {"has": {"any": [{"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:Any|LazyResult|object|str)$"}]}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:Any|LazyResult|object|str)$"}], "stopBy": "end"}}]}, {"not": {"any": [{"all": [{"kind": "identifier"}, {"regex": "ServerRef$"}]}, {"has": {"all": [{"kind": "identifier"}, {"regex": "ServerRef$"}], "stopBy": "end"}}]}}], "stopBy": "neighbor", "field": "type"}}, {"inside": {"all": [{"kind": "class_definition"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:ContainmentEdgesReadConfig|GraphSearchReadConfig)$"}]}, {"all": [{"regex": "Graph"}, {"regex": "Config$"}, {"filePath": {"regex": "graph_read"}}]}], "stopBy": "neighbor", "field": "name"}}, {"inside": {"all": [{"kind": "decorated_definition"}, {"has": {"all": [{"kind": "decorator"}, {"has": {"any": [{"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:dataclass)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:dataclass)$"}], "stopBy": "neighbor", "field": "attribute"}}]}]}, {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:dataclass)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:dataclass)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}], "stopBy": {"any": [{"kind": "class_definition"}, {"kind": "function_definition"}]}}}]}, {"pattern": "$ROOT"}, {"any": [{"inside": {"all": [{"kind": "function_definition"}, {"pattern": "$SCOPE"}], "stopBy": {"kind": "function_definition"}}}, {"pattern": "$_"}]}, {"any": [{"any": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"pattern": "$TERM"}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"all": [{"any": [{"kind": "class_definition"}, {"kind": "function_definition"}]}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "name"}}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$TERM", "stopBy": "neighbor", "field": "attribute"}}]}]}, {"pattern": "$_"}]}]}]}}, FIELD: x), text(x, s).
events(c, n) :- events_detail(c, n, _).
.decl detail_clause(clause: symbol)
detail_clause("compiled-ir-value"). detail_clause("executor-ir-dispatch"). detail_clause("graph-id-config").

// ---- the projected columns: line, scope, terminal ----
// scope = capture.SCOPE.startByte: the nearest strict function_definition ancestor's start.
.decl events_scope(clause: symbol, n: node, s: number)
events_scope(c, n, s) :- events(c, n), nearest(n, f, fdef), start(f, s).
// terminal = capture.TERM.
.decl events_term(clause: symbol, n: node, term: symbol)
events_term(c, n, t) :- events(c, n), kind(n, "call"), field(n, "function", f), kind(f, "identifier"), text(f, t).
events_term(c, n, t) :- events(c, n), kind(n, "call"), field(n, "function", f), kind(f, "attribute"), field(f, "attribute", x), text(x, t).
events_term(c, n, t) :- events(c, n), kind(n, "class_definition"), field(n, "name", x), text(x, t).
events_term(c, n, t) :- events(c, n), kind(n, "function_definition"), field(n, "name", x), text(x, t).
events_term(c, n, t) :- events(c, n), kind(n, "attribute"), field(n, "attribute", x), text(x, t).
// coalesce(scope, ''), coalesce(terminal, ''): the partition keys, NULL as ''.
.decl scope_key(clause: symbol, n: node, k: symbol)
scope_key(c, n, k) :- events_scope(c, n, s), k = @printf("%d", s).
scope_key(c, n, "") :- events(c, n), !has_scope(c, n).
.decl has_scope(clause: symbol, n: node)
has_scope(c, n) :- events_scope(c, n, _).
.decl term_key(clause: symbol, n: node, k: symbol)
term_key(c, n, t) :- events_term(c, n, t).
term_key(c, n, "") :- events(c, n), !has_term(c, n).
.decl has_term(clause: symbol, n: node)
has_term(c, n) :- events_term(c, n, _).
// One row per (node, detail); detail '' for the clauses without one (a constant partition column).
.decl event_row(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, n: node)
event_row(c, d, l, sk, tk, "", n) :- events(c, n), !detail_clause(c), docof(n, d), l = @line(n), scope_key(c, n, sk), term_key(c, n, tk).
event_row(c, d, l, sk, tk, dk, n) :- events_detail(c, n, dk), docof(n, d), l = @line(n), scope_key(c, n, sk), term_key(c, n, tk).

// ---- the clauses' query: row_number() OVER (PARTITION BY __path, line, scope, terminal[, detail] ORDER BY __start, __end) = 1 ----
.decl event_start(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, s: number)
event_start(c, d, l, sk, tk, dk, s) :- event_row(c, d, l, sk, tk, dk, n), start(n, s).
.decl first_start(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, s: number)
first_start(c, d, l, sk, tk, dk, s) :- event_start(c, d, l, sk, tk, dk, _), s = min t : { event_start(c, d, l, sk, tk, dk, t) }.
.decl event_end(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, e: number)
event_end(c, d, l, sk, tk, dk, e) :- event_row(c, d, l, sk, tk, dk, n), node(_, n, _, s, e), first_start(c, d, l, sk, tk, dk, s).
.decl first_end(clause: symbol, d: number, line: number, scope: symbol, term: symbol, detail: symbol, e: number)
first_end(c, d, l, sk, tk, dk, e) :- event_end(c, d, l, sk, tk, dk, _), e = min x : { event_end(c, d, l, sk, tk, dk, x) }.
.decl chosen(clause: symbol, line: number, scope: symbol, term: symbol, detail: symbol, n: node)
chosen(c, l, sk, tk, dk, n) :- event_row(c, d, l, sk, tk, dk, n), node(_, n, _, s, e), first_start(c, d, l, sk, tk, dk, s),
    first_end(c, d, l, sk, tk, dk, e).
finding(c, k, n) :- chosen(c, l, sk, tk, dk, n), k = @printf("%d|%s|%s|%s", l, sk, tk, dk).
