.decl lt_count(d: number, k: number)
lt_count(d, k) :- lt_candidates(d, _, _), k = count : { lt_candidates(d, _, _) }.
finding("quality-local-taxonomy", "SPQ-049", n) :- lt_candidates(d, n, _), lt_count(d, k), k >= 2.

// ==== quality-project-taxonomy (repository-wide; no stages) ====
