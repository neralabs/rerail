.decl pt_count(k: number)
pt_count(k) :- pt_candidates(_, _, _), k = count : { pt_candidates(_, _, _) }.
finding("quality-project-taxonomy", "SPQ-049", n) :- pt_candidates(_, n, _), pt_count(k), k >= 2.
