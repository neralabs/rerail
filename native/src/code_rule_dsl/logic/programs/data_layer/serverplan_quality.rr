.decl c3_has_limit(path: symbol, class_name: symbol, function_name: symbol)
c3_has_limit(p, c, f) :- c3_ordered_limits(p, c, f, _).

// ---- diagnostics_0 (the clause's query): SPQ-052, SPQ-053 ----
finding("quality-contracts-3", "SPQ-052", n) :- c3_attributes(n, _), docof(n, d), c3_files(d), text(n, t),
    @rx_matches(t, "(?:^|\\.)BatchingBarrierKind\\.MAINTENANCE_BATCH$") = 1.
finding("quality-contracts-3", "SPQ-052", n) :- c3_assignments(n, "identifier", "MAINTENANCE_BATCH"), c3_assignments_expr_kind(n, k),
    k != "assignment", child(e, n, _), c3_nodes(e), child(b, e, _), c3_classes(c, b, "BatchingBarrierKind"), docof(n, d), c3_files(d).
finding("quality-contracts-3", "SPQ-052", n) :- c3_attributes(n, _), docof(n, d), c3_files(d), text(n, t),
    @rx_matches(t, "(?:^|\\.)SqlStatementBatchCategory\\.MAINTENANCE$") = 1.
finding("quality-contracts-3", "SPQ-052", n) :- c3_assignments(n, "identifier", "MAINTENANCE"), c3_assignments_expr_kind(n, k),
    k != "assignment", child(e, n, _), c3_nodes(e), child(b, e, _), c3_classes(c, b, "SqlStatementBatchCategory"), docof(n, d), c3_files(d).
// occurrence > coalesce(maximum, 0).
.decl c3_inventory_file(d: number, path: symbol)
c3_inventory_file(d, p) :- c3_files(d), doc(d, p), @rx_matches(p, "(?:^|/)tests(?:/|$)") = 0,
    @rx_matches(p, "(?:^|/)(?:data_history|build)(?:/|$)") = 0.
finding("quality-contracts-3", "SPQ-053", n) :- c3_ordered_occurrences(n, d, c, f, k), c3_inventory_file(d, p),
    c3_ordered_limits(p, c, f, m), k > m.
finding("quality-contracts-3", "SPQ-053", n) :- c3_ordered_occurrences(n, d, c, f, k), c3_inventory_file(d, p),
    !c3_has_limit(p, c, f), k > 0.

// ==== quality-local-taxonomy (partitionBy file; no stages) ====
