lt_candidates(d, n, name) :- ast(d, n, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"any": [{"filePath": {"regex": "^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$"}}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$)"}}]}]}}}, "_check_recursive_payload_taxonomy_duplication": {"filePath": {"regex": "(?s).*"}}, "_check_serverplan_quality_source": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "function_definition"}, {"pattern": "$FN"}, {"has": {"pattern": "$FN_NAME", "stopBy": "neighbor", "field": "name"}}, {"count": {"has": {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"pattern": "$CALLEE"}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$CALLEE", "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}, {"compare": {"left": "FN_NAME", "right": "CALLEE", "op": "eq", "text": "source"}}], "stopBy": "end"}, "min": 2}}, {"count": {"has": {"all": [{"any": [{"kind": "if_statement"}, {"kind": "elif_clause"}]}, {"has": {"any": [{"any": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:get_origin|id|is_dataclass|isinstance|type)$"}]}, {"all": [{"ki