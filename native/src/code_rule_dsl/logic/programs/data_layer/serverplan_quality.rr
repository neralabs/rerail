pt_candidates(d, n, name) :- ast(d, n, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "\\b\\B"}}, "false": {"filePath": {"regex": "(?s).*"}}}}, "_check_recursive_payload_taxonomy_duplication_across_surfaces": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"all": [{"kind": "function_definition"}, {"pattern": "$FN"}, {"has": {"pattern": "$FN_NAME", "stopBy": "neighbor", "field": "name"}}, {"count": {"has": {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"pattern": "$CALLEE"}]}, {"all": [{"kind": "attribute"}, {"has": {"pattern": "$CALLEE", "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}, {"compare": {"left": "FN_NAME", "right": "CALLEE", "op": "eq", "text": "source"}}], "stopBy": "end"}, "min": 2}}, {"count": {"has": {"all": [{"any": [{"kind": "if_statement"}, {"kind": "elif_clause"}]}, {"has": {"any": [{"any": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:get_origin|id|is_dataclass|isinstance|type)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:get_origin|id|is_dataclass|isinstance|type)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:__module__|__name__)$"}], "stopBy": "neighbor", "field": "attribute"}}]}]}, {"has": {"any": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:get_origin|id|is_dataclass|isinstance|type)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:get_origin|id|is_dataclass|isinstance|type)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"all": [