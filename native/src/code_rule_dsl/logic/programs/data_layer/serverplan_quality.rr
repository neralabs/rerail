TYPE", "stopBy": "neighbor", "field": "type"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$FUNCTION", "stopBy": "neighbor", "field": "function"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$OBJECT", "stopBy": "neighbor", "field": "object"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$ATTRIBUTE", "stopBy": "neighbor", "field": "attribute"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$BODY", "stopBy": "neighbor", "field": "body"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$PARAMETERS", "stopBy": "neighbor", "field": "parameters"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$CONDITION", "stopBy": "neighbor", "field": "condition"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$SUBJECT", "stopBy": "neighbor", "field": "subject"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$ALIAS", "stopBy": "neighbor", "field": "alias"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$MODULE_NAME", "stopBy": "neighbor", "field": "module_name"}}, {"pattern": "$_"}]}]}}}}, {"id": "quality-contracts-1", "relational": "rdl", "violation": {"code": "architecture", "message": "Architecture contract violation", "anchor": "witness.span"}}, {"id": "quality-contracts-2", "relational": "rdl", "violation": {"code": "architecture", "message": "Architecture contract violation", "anchor": "witness.span"}}, {"id": "quality-contracts-3", "relational": "rdl", "violation": {"code": "architecture", "message": "Architecture contract violation", "anchor": "witness.span"}}, {"id": "strategy-file-size", "forbid": "rdl", "violation": {"code": "SPQ-010", "message": "Strategy file exceeds the line threshold", "anchor": "capture.OVERFLOW"}}, {"id": "quality-local-taxonomy", "relational": "rdl", "violation": {"code": "SPQ-049", "message": "Recursive payload taxonomy duplication", "anchor": "witness.span"}}, {"id": "quality-project-taxonomy", "relational": "rdl", "violation": {"code": "SPQ-049", "message": "Recursive payload taxonomy duplication", "anchor": "witness.span"}}, {"id": "quality-conditional-1", "relational": "rdl", "violation": {"code": "architecture", "message": "Architecture contract violation", "anchor": "witness.span"}}]}

.decl fdef(kind: symbol)
fdef("function_definition").
.decl cdef(kind: symbol)
cdef("class_definition").

// ---- forbid clauses ----
.decl violation(policy: symbol, clause: symbol, d: number, n: node)
.output violation

// strategy-file-size (entryPoint "all"): file.content has a 1501st line, in impl/common/l2070_server_plan/strategies/**/*.py.
.decl file_content(d: number, s: symbol)
file_content(d, s) :- source(d, sp), text(sp, s).
violation("data-layer-serverplan-quality", "strategy-file-size", D, N) :- doc(D, p),
    @rx_matches(p, "^impl/common/l2070_server_plan/strategies/(?:.*/)?[^/]*\\.py$") = 1, file_content(D, s),
    @rx_matches(s, "\\A(?:[^\\n\\r\\v\\f\\x1c-\\x1e\\x85\\u2028\\u2029]*(?:\\r\\n|[\\n\\r\\v\\f\\x1c-\\x1e\\x85\\u2028\\u2029])){1500}(?<OVERFLOW>[^\\n\\r\\v\\f\\x1c-\\x1e\\x85\\u2028\\u2029]+|[\\n\\r\\v\\f\\x1c-\\x1e\\x85\\u2028\\u2029])") = 1,
    node(D, N, "module", _, _).

.decl finding(clause: symbol, key: symbol, n: node)
.output finding

// excludeKinds of both syntax tables.
.decl excluded_kind(k: symbol)
excluded_kind("comment"). excluded_kind("string_start"). excluded_kind("string_content"). excluded_kind("string_end").
excluded_kind("escape_sequence"). excluded_kind("line_continuation").

// ==== quality-contracts-2 (partitionBy file) ====
// ---- input syntax_gate; the syntax table ----
.decl c2_syntax_gate(d: number)
c2_syntax_gate(d) :- ast(d, m, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"all": [{"any": [{"any": [{"filePath": {"regex": "^(?:api/l2070_batching/executor\\.py|impl/common/l2070_server_plan/base_server_plan\\.py|impl/common/l2070_server_plan/plan_helpers\\.py|impl/common/l2070_server_plan/sql_backend_executor\\.py|impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects\\.py|l2070_batching/compilation\\.py|l2070_batching/conditional_step\\.py|l2070_batching/optimizer\\.py|l2070_batching/plan_prerequisites\\.py)$"}}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:impl/common/l2070_server_plan/steps/|impl/common/l7300_sql_versioned_transactions/steps/|impl/common/l9700_sql_graph_query/steps/|impl/common/l2070_server_plan/strategies/|impl/common/l2070_server_plan/[^/]+$)"}}]}]}, {"all": [{"not": {"filePath": {"regex": "(?:^|/)__init__\\.py$"}}}, {"filePath": {"regex": "^(?:impl|l[0-9]{4}_[^/]+)/"}}]}]}, {"any": [{"matches": "quality-source-trigger"}, {"inside": {"matches": "quality-source-trigger", "stopBy": "end"}}]}]}}}}, "default": {"filePath": {"regex": "(?s).*"}}}, {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "_check_deleted_callback_architecture_surfaces": {"filePath": {"regex": "(?s).*"}}, "_check_serverplan_quality_source": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"kind": "module"}]}]}, "utils": {"quality-source-trigger": {"all": [{"kind": "module"}, {"regex": "CompiledStep|HandleTransactionEntryStep|PipelineLifecycleEffect|_legacy_module_preflight|legacy_module_preflight|pending_pipeline_callbacks|pending_pipeline_effects|success_callbacks"}]}}}).
.decl c2_nodes(n: node)
c2_nodes(n) :- c2_syntax_gate(d), node(d, n, k, _, _), !excluded_kind(k).

// ---- functions, classes, attributes, calls, keywords, assignments ----
.decl c2_functions(f: node, name: symbol)
c2_functions(f, name) :- c2_nodes(f), kind(f, "function_definition"), field(f, "name", x), text(x, name).
.decl c2_classes(c: node, body: node, name: symbol)
c2_classes(c, b, name) :- c2_nodes(c), kind(c, "class_definition"), field(c, "body", b), field(c, "name", x), text(x, name).
.decl c2_attributes(a: node, attr: symbol)
c2_attributes(a, attr) :- c2_nodes(a), kind(a, "attribute"), field(a, "attribute", x), text(x, attr).
.decl c2_attribute_node(a: node)
c2_attribute_node(a) :- c2_attributes(a, _).
// callee = coalesce(a.attr, f.text), a the attributes row of the callee f.
.decl c2_calls(c: node, callee: symbol)
c2_calls(c, callee) :- c2_nodes(c), kind(c, "call"), field(c, "function", f), c2_nodes(f), c2_attributes(f, callee).
c2_calls(c, callee) :- c2_nodes(c), kind(c, "call"), field(c, "function", f), c2_nodes(f), !c2_attribute_node(f), text(f, callee).
.decl c2_calls_arguments(c: node, arguments: node)
c2_calls_arguments(c, g) :- c2_calls(c, _), field(c, "arguments", g).
.decl c2_keywords(call: node, keyword: node, name: symbol, value: node)
c2_keywords(c, k, name, v) :- c2_calls_arguments(c, g), child(g, k, _), c2_nodes(k), kind(k, "keyword_argument"),
    field(k, "name", kn), c2_nodes(kn), text(kn, name), field(k, "value", v), c2_nodes(v).
.decl c2_assignments(a: node, target_kind: symbol, target_text: symbol)
c2_assignments(a, tk, tt) :- c2_nodes(a), kind(a, "assignment"), field(a, "left", l), c2_nodes(l), kind(l, tk), text(l, tt).

// ---- files: the gate's modules; primary_file, callback_file ----
.decl c2_files(d: number)
c2_files(d) :- c2_nodes(m), kind(m, "module"), docof(m, d).
// The two `__path IN (…)` lists.
.decl c2_primary_path(p: symbol)
c2_primary_path("api/l2070_batching/executor.py"). c2_primary_path("impl/common/l2070_server_plan/base_server_plan.py").
c2_primary_path("impl/common/l2070_server_plan/plan_helpers.py"). c2_primary_path("impl/common/l2070_server_plan/sql_backend_executor.py").
c2_primary_path("l2070_batching/conditional_step.py"). c2_primary_path("impl/common/l2070_server_plan/steps/tests/test_conditional_compile_dialects.py").
c2_primary_path("l2070_batching/compilation.py"). c2_primary_path("l2070_batching/optimizer.py"). c2_primary_path("l2070_batching/plan_prerequisites.py").
.decl c2_non_init(d: number)
c2_non_init(d) :- c2_files(d), doc(d, p), @rx_matches(p, "(?:^|/)__init__\\.py$") = 0.
.decl c2_primary_file(d: number)
c2_primary_file(d) :- c2_files(d), doc(d, p), c2_primary_path(p).
c2_primary_file(d) :- c2_non_init(d), doc(d, p), @substr(p, 1, 36) = "impl/common/l2070_server_plan/steps/".
c2_primary_file(d) :- c2_non_init(d), doc(d, p), @substr(p, 1, 51) = "impl/common/l7300_sql_versioned_transactions/steps/".
c2_primary_file(d) :- c2_non_init(d), doc(d, p), @substr(p, 1, 40) = "impl/common/l9700_sql_graph_query/steps/".
c2_primary_file(d) :- c2_non_init(d), doc(d, p), @substr(p, 1, 41) = "impl/common/l2070_server_plan/strategies/".
c2_primary_file(d) :- c2_non_init(d), doc(d, p), @rx_matches(p, "^impl/common/l2070_server_plan/[^/]+$") = 1.
.decl c2_callback_file(d: number)
c2_callback_file(d) :- c2_non_init(d), doc(d, p), @rx_matches(p, "^(?:impl|l[0-9]{4}_[^/]+)/") = 1.

// ---- base_names: coalesce(rx_extract(b.text, …), b.text) ----
.decl c2_base_arg(cls: node, text: symbol)
c2_base_arg(c, t) :- c2_classes(c, _, _), child(c, g, _), c2_nodes(g), kind(g, "argument_list"), child(g, b, _), c2_nodes(b),
    kind(b, k), k != "keyword_argument", text(b, t).
.decl c2_base_names(cls: node, name: symbol)
c2_base_names(c, n) :- c2_base_arg(c, t), n = @rx_extract(t, "(?:^|\\.)([A-Za-z_]\\w*)(?:\\[.*\\])?$", 1).
c2_base_names(c, t) :- c2_base_arg(c, t), @rx_matches(t, "(?:^|\\.)([A-Za-z_]\\w*)(?:\\[.*\\])?$") = 0.

// ---- import_descendants, import_identifiers, py_names ----
.decl c2_import_roots(r: node)
c2_import_roots(r) :- c2_nodes(r), kind(r, "import_statement").
c2_import_roots(r) :- c2_nodes(r), kind(r, "import_from_statement").
.decl c2_import_descendants(root: node, n: node)
c2_import_descendants(r, r) :- c2_import_roots(r).
c2_import_descendants(r, n) :- c2_import_roots(r), docof(r, d), c2_nodes(n), docof(n, d), @within(n, r) = 1.
.decl c2_import_identifiers(n: node)
c2_import_identifiers(n) :- c2_import_descendants(_, n), kind(n, "identifier").
// A name read: not a definition's or keyword's name, not an attribute's attribute, not inside an import.
.decl c2_def_kind(k: symbol)
c2_def_kind("function_definition"). c2_def_kind("class_definition"). c2_def_kind("keyword_argument").
.decl c2_def_name_at(p: node, s: number)
c2_def_name_at(p, s) :- c2_nodes(p), kind(p, k), c2_def_kind(k), field(p, "name", x), start(x, s).
.decl c2_attr_name_at(p: node, s: number)
c2_attr_name_at(p, s) :- c2_nodes(p), kind(p, "attribute"), field(p, "attribute", x), start(x, s).
.decl c2_py_names(n: node, text: symbol)
c2_py_names(n, t) :- c2_nodes(n), kind(n, "identifier"), child(p, n, _), c2_nodes(p), start(n, s), !c2_def_name_at(p, s),
    !c2_attr_name_at(p, s), !c2_import_identifiers(n), text(n, t).

// ---- diagnostics_0 (the clause's query): SPQ-051 ----
.decl c2_scope(d: number)
c2_scope(d) :- c2_primary_file(d), doc(d, p), @rx_matches(p, "(?:^|/)tests(?:/|$)") = 0.
c2_scope(d) :- c2_callback_file(d), doc(d, p), @rx_matches(p, "(?:^|/)tests(?:/|$)") = 0.
.decl c2_deleted_name(s: symbol)
c2_deleted_name("HandleTransactionEntryStep"). c2_deleted_name("_legacy_module_preflight"). c2_deleted_name("legacy_module_preflight").
c2_deleted_name("pending_pipeline_callbacks"). c2_deleted_name("success_callbacks").
.decl c2_owner_name(s: symbol)
c2_owner_name("conn"). c2_owner_name("connection"). c2_owner_name("owner"). c2_owner_name("transaction_owner"). c2_owner_name("txn").
finding("quality-contracts-2", "SPQ-051", n) :- c2_py_names(n, t), c2_deleted_name(t), docof(n, d), c2_scope(d).
finding("quality-contracts-2", "SPQ-051", n) :- c2_attributes(n, a), c2_deleted_name(a), docof(n, d), c2_scope(d).
finding("quality-contracts-2", "SPQ-051", n) :- c2_calls(n, "CompiledStep"), c2_keywords(n, _, "on_commit", _), docof(n, d), c2_scope(d).
finding("quality-contracts-2", "SPQ-051", n) :- c2_calls(n, "CompiledStep"), c2_keywords(n, _, "on_rollback", _), docof(n, d), c2_scope(d).
// An owner-named assignment whose statement sits in the body of a PipelineLifecycleEffect subclass.
finding("quality-contracts-2", "SPQ-051", n) :- c2_assignments(n, "identifier", t), c2_owner_name(t), child(e, n, _), c2_nodes(e),
    child(b, e, _), c2_classes(c, b, _), c2_base_names(c, "PipelineLifecycleEffect"), docof(n, d), c2_scope(d).
// A lambda inside pending_pipeline_effects (span containment of distinct nodes: `@within`).
finding("quality-contracts-2", "SPQ-051", n) :- c2_nodes(n), kind(n, "lambda"), c2_functions(f, "pending_pipeline_effects"),
    @within(n, f) = 1, docof(n, d), c2_scope(d).

// ==== quality-contracts-3 (partitionBy file) ====
// ---- input syntax_gate; the syntax table ----
.decl c3_syntax_gate(d: number)
c3_syntax_gate(d) :- ast(d, m, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"$option": "oracleAnalyzer", "cases": {"true": {"filePath": {"regex": "(?s).*"}}, "false": {"all": [{"filePath": {"regex": "(?s).*"}}, {"any": [{"matches": "quality-source-trigger"}, {"inside": {"matches": "quality-source-trigger", "stopBy": "end"}}]}]}}}}, "default": {"filePath": {"regex": "(?s).*"}}}, {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "_check_ordered_semantic_batch_inventory": {"filePath": {"regex": "(?s).*"}}, "_check_removed_maintenance_batch_architecture": {"filePath": {"regex": "(?s).*"}}, "_check_serverplan_quality_source": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"kind": "module"}]}]}, "utils": {"quality-source-trigger": {"all": [{"kind": "module"}, {"regex": "MAINTENANCE|ORDERED_SEMANTIC"}]}}}).
.decl c3_nodes(n: node)
c3_nodes(n) :- c3_syntax_gate(d), node(d, n, k, _, _), !excluded_kind(k).

// ---- functions, classes, attributes, assignments, files ----
.decl c3_functions(f: node, name: symbol)
c3_functions(f, name) :- c3_nodes(f), kind(f, "function_definition"), field(f, "name", x), text(x, name).
.decl c3_classes(c: node, body: node, name: symbol)
c3_classes(c, b, name) :- c3_nodes(c), kind(c, "class_definition"), field(c, "body", b), field(c, "name", x), text(x, name).
.decl c3_attributes(a: node, attr: symbol)
c3_attributes(a, attr) :- c3_nodes(a), kind(a, "attribute"), field(a, "attribute", x), text(x, attr).
.decl c3_assignments(a: node, target_kind: symbol, target_text: symbol)
c3_assignments(a, tk, tt) :- c3_nodes(a), kind(a, "assignment"), field(a, "left", l), c3_nodes(l), kind(l, tk), text(l, tt).
// expr_kind: the right side's kind (LEFT JOIN: none without a right side in the table).
.decl c3_assignments_expr_kind(a: node, expr_kind: symbol)
c3_assignments_expr_kind(a, k) :- c3_assignments(a, _, _), field(a, "right", r), c3_nodes(r), kind(r, k).
.decl c3_files(d: number)
c3_files(d) :- c3_nodes(m), kind(m, "module"), docof(m, d).

// ---- ordered_occurrences: ORDERED_SEMANTIC attributes, ranked per (path, class name, function name) ----
// class_name/function_name: the smallest enclosing class/function (ORDER BY size LIMIT 1), the nearest ancestor.
.decl c3_occurrence_class(n: node, class_name: symbol)
c3_occurrence_class(n, c) :- c3_attributes(n, "ORDERED_SEMANTIC"), nearest(n, x, cdef), c3_classes(x, _, c).
c3_occurrence_class(n, "<module>") :- c3_attributes(n, "ORDERED_SEMANTIC"), !c3_in_class(n).
.decl c3_in_class(n: node)
c3_in_class(n) :- c3_attributes(n, "ORDERED_SEMANTIC"), nearest(n, x, cdef), c3_classes(x, _, _).
.decl c3_occurrence_function(n: node, function_name: symbol)
c3_occurrence_function(n, f) :- c3_attributes(n, "ORDERED_SEMANTIC"), nearest(n, x, fdef), c3_functions(x, f).
c3_occurrence_function(n, "<module>") :- c3_attributes(n, "ORDERED_SEMANTIC"), !c3_in_function(n).
.decl c3_in_function(n: node)
c3_in_function(n) :- c3_attributes(n, "ORDERED_SEMANTIC"), nearest(n, x, fdef), c3_functions(x, _).
.decl c3_occurrence_key(n: node, d: number, class_name: symbol, function_name: symbol)
c3_occurrence_key(n, d, c, f) :- c3_occurrence_class(n, c), c3_occurrence_function(n, f), docof(n, d).
// row_number() OVER (PARTITION BY __path, class_name, function_name ORDER BY __start, __end DESC): the rows at or
// before the node in that order, the node included.
.decl c3_occurrence_before(n: node, m: node)
c3_occurrence_before(n, m) :- c3_occurrence_key(n, d, c, f), c3_occurrence_key(m, d, c, f), start(n, s), start(m, t), t < s.
c3_occurrence_before(n, m) :- c3_occurrence_key(n, d, c, f), c3_occurrence_key(m, d, c, f), node(d, n, _, s, e),
    node(d, m, _, s, em), em >= e.
.decl c3_ordered_occurrences(n: node, d: number, class_name: symbol, function_name: symbol, occurrence: number)
c3_ordered_occurrences(n, d, c, f, k) :- c3_occurrence_key(n, d, c, f), k = count : { c3_occurrence_before(n, _) }.

// ---- ordered_limits: json_each over a constant array, as facts ----
.decl c3_ordered_limits(path: symbol, class_name: symbol, function_name: symbol, maximum: number)
c3_ordered_limits("impl/common/l2070_server_plan/codegen/compound_sequence.py", "CompoundSequenceCodegen", "compile_batch", 1).
