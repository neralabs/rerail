nodes_parent(n, p) :- nodes(n), child(p, n, _).
.decl nodes_has_parent(n: node)
nodes_has_parent(n) :- nodes_parent(n, _).
// X_kind/X_start/X_end: `has` binds the field's first child (`subject`, `name`, `right` repeat in some kinds).
.decl nodes_role(role: symbol)
nodes_role("name"). nodes_role("left"). nodes_role("right"). nodes_role("value"). nodes_role("type"). nodes_role("function").
nodes_role("arguments"). nodes_role("object"). nodes_role("attribute"). nodes_role("return_type"). nodes_role("subject").
.decl nodes_field_start(n: node, role: symbol, s: number)
nodes_field_start(n, r, s) :- nodes(n), nodes_role(r), field(n, r, c), start(c, s).
.decl nodes_field_first(n: node, role: symbol, s: number)
nodes_field_first(n, r, s) :- nodes_field_start(n, r, _), s = min t : { nodes_field_start(n, r, t) }.
.decl nodes_field(n: node, role: symbol, c: node)
nodes_field(n, r, c) :- nodes_field_first(n, r, s), field(n, r, c), start(c, s).
// ordinal: row_number() OVER (PARTITION BY parent ORDER BY __start, __end, kind) - 1, among the rows.
.decl nodes_sibling_before(n: node, m: node)
nodes_sibling_before(n, m) :- nodes_parent(n, p), nodes_parent(m, p), node(_, n, _, sn, _), node(_, m, _, sm, _), sm < sn.
nodes_sibling_before(n, m) :- nodes_parent(n, p), nodes_parent(m, p), node(_, n, _, s, en), node(_, m, _, s, em), em < en.
nodes_sibling_before(n, m) :- nodes_parent(n, p), nodes_parent(m, p), node(_, n, kn, s, e), node(_, m, km, s, e), km < kn.
.decl nodes_ordinal(n: node, o: number)
nodes_ordinal(n, o) :- nodes_parent(n, _), o = count : { nodes_sibling_before(n, _) }.
// The NULL-parent partition holds at most the document's root.
nodes_ordinal(n, 0) :- nodes(n), !nodes_has_parent(n).

// ---- edges, fields, functions ----
.decl edges(src: node, dst: node, ordinal: number)
edges(p, n, o) :- nodes_parent(n, p), nodes_ordinal(n, o).
.decl fields(owner: node, role: symbol, child: node)
fields(n, "value", c) :- nodes_field(n, "value", c).
.decl functions(f: node)
functions(f) :- nodes(f), kind(f, "function_definition").
.decl functions_name(f: node, name: symbol)
functions_name(f, s) :- functions(f), nodes_field(f, "name", x), text(x, s).

// ---- ownership: the walk down `edges` from each row with no parent row ----
// The recursion carries the nearest function and class and the outermost function, ancestor-or-self, along the walk.
// A walk from root r reaches the nodes whose nearest root ancestor-or-self is r (`own_root_of`): each column is an
// ancestor-or-self of its kind with the node's root.
.decl own_linked(n: node)
own_linked(n) :- nodes_parent(n, p), nodes(p).
.decl own_root(n: node)
own_root(n) :- nodes(n), !own_linked(n).
.decl own_root_between(n: node, r: node)
own_root_between(n, r) :- own_linked(n), own_root(r), @within(n, r) = 1, own_root(q), @within(n, q) = 1, @within(q, r) = 1.
.decl own_root_of(n: node, r: node)
own_root_of(n, n) :- own_root(n).
own_root_of(n, r) :- own_linked(n), own_root(r), @within(n, r) = 1, !own_root_between(n, r).
.decl ownership(n: node)
ownership(n) :- own_root_of(n, _).
.decl ownership_fn(n: node, fn: node)
ownership_fn(n, n) :- ownership(n), kind(n, "function_definition").
ownership_fn(n, f) :- own_root_of(n, r), !kind(n, "function_definition"), nearest(n, f, fndef), own_root_of(f, r).
// cls and top_fn: read by no later stage.
.decl ownership_cls(n: node, cls: node)
ownership_cls(n, n) :- ownership(n), kind(n, "class_definition").
ownership_cls(n, c) :- own_root_of(n, r), !kind(n, "class_definition"), nearest(n, c, clsdef), own_root_of(c, r).
.decl ownership_nested_fn(f: node)
ownership_nested_fn(f) :- ownership_fn(f, f), nearest(f, g, fndef), own_root_of(f, r), own_root_of(g, r).
.decl ownership_top_fn(n: node, top: node)
ownership_top_fn(n, f) :- ownership_fn(n, f), !ownership_nested_fn(f).
ownership_top_fn(n, t) :- ownership_fn(n, f), ownership_nested_fn(f), own_root_of(f, r), ownership_fn(t, t),
    !ownership_nested_fn(t), own_root_of(t, r), @within(f, t) = 1.

// ---- attributes, calls, arguments ----
.decl attributes(n: node, attr: symbol, object: node, object_text: symbol)
attributes(n, attr, o, ot) :- nodes(n), kind(n, "attribute"), nodes_field(n, "attribute", a), nodes(a), text(a, attr),
    nodes_field(n, "object", o), nodes(o), text(o, ot).
.decl attributes_node(n: node)
attributes_node(n) :- attributes(n, _, _, _).
// callee = coalesce(a.attr, f.text); receiver = a.object.
.decl calls(n: node, callee_id: node, callee_kind: symbol, callee: symbol)
calls(n, f, fk, c) :- nodes(n), kind(n, "call"), nodes_field(n, "function", f), nodes(f), kind(f, fk), attributes(f, c, _, _).
calls(n, f, fk, c) :- nodes(n), kind(n, "call"), nodes_field(n, "function", f), nodes(f), kind(f, fk), !attributes_node(f), text(f, c).
.decl calls_receiver(n: node, receiver: node)
calls_receiver(n, o) :- calls(n, f, _, _), attributes(f, _, o, _).
.decl arguments_member(n: node, call: node)
arguments_member(n, c) :- calls(c, _, _, _), nodes_field(c, "arguments", a), child(a, n, _), nodes(n), kind(n, k),
    k != "comment", k != "keyword_argument", k != "list_splat", k != "dictionary_splat".
.decl arguments_before(call: node, n: node, m: node)
arguments_before(c, n, m) :- arguments_member(n, c), arguments_member(m, c), start(n, sn), start(m, sm), sm < sn.
.decl arguments(n: node, call: node, position: number)
arguments(n, c, p) :- arguments_member(n, c), p = count : { arguments_before(c, n, _) }.

// ---- descendants: the reflexive walk down `edges` from every row ----
.decl descendants(root: node, n: node)
descendants(r, r) :- nodes(r).
descendants(r, n) :- own_root_of(n, q), own_root_of(r, q), @within(n, r) = 1.

// ---- executor_types: names that alias BackendExecutor (E0 row #16) ----
.decl et_import_kind(k: symbol)
et_import_kind("aliased_import"). et_import_kind("dotted_name").
// coalesce(rx_extract(… as NAME), rx_extract(… NAME)): the second where the first has no match.
.decl et_import(d: number, name: symbol)
et_import(d, a) :- nodes(n), kind(n, k), et_import_kind(k), text(n, t),
    @rx_matches(t, "(?:^|\\b)[A-Za-z_]*BackendExecutor(?:\\s+as\\s+[A-Za-z_]\\w*)?$") = 1, docof(n, d),
    a = @rx_extract(t, "\\bas\\s+([A-Za-z_]\\w*)$", 1).
et_import(d, a) :- nodes(n), kind(n, k), et_import_kind(k), text(n, t),
    @rx_matches(t, "(?:^|\\b)[A-Za-z_]*BackendExecutor(?:\\s+as\\s+[A-Za-z_]\\w*)?$") = 1, docof(n, d),
    @rx_matches(t, "\\bas\\s+([A-Za-z_]\\w*)$") = 0, a = @rx_extract(t, "([A-Za-z_]\\w*)$", 1).
.decl et_assign(d: number, left: symbol, right: symbol)
et_assign(d, ls, rs) :- nodes(n), kind(n, "assignment"), nodes_field(n, "left", l), nodes(l), kind(l, "identifier"),
    nodes_field(n, "right", r), nodes(r), kind(r, "identifier"), text(l, ls), text(r, rs), docof(n, d).
// A header whose class name is not [A-Za-z_]\w* gives SQL a NULL name, which no later join matches: no row here.
.decl et_class(d: number, n: node, name: symbol)
et_class(d, n, c) :- nodes(n), kind(n, "class_definition"), text(n, t), c = @rx_extract(t, "^class\\s+([A-Za-z_]\\w*)", 1), docof(n, d).
// Every name an arm can make, recursion or not; the header edges over them.
.decl et_name(d: number, name: symbol)
et_name(d, "BackendExecutor") :- nodes(n), docof(n, d).
et_name(d, a) :- et_import(d, a).
et_name(d, l) :- et_assign(d, l, _).
et_name(d, c) :- et_class(d, _, c).
.decl et_header(d: number, name: symbol, class: symbol)
et_header(d, w, c) :- et_name(d, w), et_class(d, n, c), text(n, t), re = @concat("^class\\s+\\w+\\([^\\n:]*\\b", w, "\\b"),
    @rx_matches(t, re) = 1.
.decl executor_types(d: number, name: symbol)
executor_types(d, "BackendExecutor") :- nodes(n), docof(n, d).
executor_types(d, a) :- et_import(d, a).
executor_types(d, l) :- et_assign(d, l, r), executor_types(d, r).
executor_types(d, c) :- et_header(d, w, c), executor_types(d, w).

// ---- annotation_edges ----
.decl ae_wrapper_kind(k: symbol)
ae_wrapper_kind("type"). ae_wrapper_kind("parenthesized_expression"). ae_wrapper_kind("union_type").
.decl annotation_edges(src: node, dst: node)
annotation_edges(c, p) :- nodes(p), kind(p, k), ae_wrapper_kind(k), nodes_parent(c, p).
annotation_edges(c, p) :- nodes(p), kind(p, "binary_operator"), text(p, t), @instr(t, "|") > 0, nodes_parent(c, p).
annotation_edges(a, g) :- nodes(g), kind(g, "subscript"), nodes_parent(h, g), nodes_ordinal(h, 0), text(h, ht),
    @rx_matches(ht, "(?:^|\\.)(?:Annotated|Awaitable|Coroutine|Optional)$") = 1, nodes_parent(a, g), nodes_ordinal(a, o), o > 0.
annotation_edges(c, g) :- nodes(g), kind(g, "generic_type"), nodes_parent(h, g), nodes_ordinal(h, 0), text(h, ht),
    @rx_matches(ht, "(?:^|\\.)(?:Annotated|Awaitable|Coroutine|Optional)$") = 1, nodes_parent(q, g), kind(q, "type_parameter"),
    ae_single_element(q), nodes_parent(c, q).
// (SELECT count(*) … element.kind != 'comment') = 1.
.decl ae_element(params: node, e: node)
ae_element(q, e) :- nodes(q), kind(q, "type_parameter"), nodes_parent(e, q), !kind(e, "comment").
.decl ae_single_element(params: node)
ae_single_element(q) :- ae_element(q, _), k = count : { ae_element(q, _) }, k = 1.

// ---- annotations: a set recursion up `annotation_edges` (E0 row #17) ----
.decl annotations(n: node)
annotations(n) :- nodes(n), kind(n, "identifier"), text(n, t), docof(n, d), executor_types(d, t).
annotations(n) :- nodes(n), kind(n, "identifier"), text(n, t), @rx_matches(t, "(?i)BackendExecutor$") = 1.
annotations(n) :- nodes(n), kind(n, "attribute"), nodes_field(n, "attribute", a), text(a, t), docof(n, d), executor_types(d, t).
annotations(n) :- nodes(n), kind(n, "attribute"), nodes_field(n, "attribute", a), text(a, t), @rx_matches(t, "(?i)BackendExecutor$") = 1.
annotations(n) :- nodes(n), kind(n, "string"), text(n, t),
    @rx_matches(t, "(?:^|[\\x22\\x27| ])(?:[A-Za-z_]\\w*\\.)*(?:[A-Za-z_]\\w*BackendExecutor|BackendExecutor)(?:[\\x22\\x27| ]|$)") = 1.
annotations(p) :- annotations(c), annotation_edges(c, p).

// ---- factories ----
.decl factories(d: number, name: symbol)
factories(d, s) :- functions(f), nodes_field(f, "return_type", r), annotations(r), functions_name(f, s), docof(f, d).
factories(d, "_create_backend_executor") :- nodes(n), docof(n, d).

// ---- bindings ----
.decl bindings_kind(k: symbol)
bindings_kind("assignment"). bindings_kind("for_statement"). bindings_kind("for_in_clause").
.decl bindings(n: node, target: node, value: node)
bindings(n, l, r) :- nodes(n), kind(n, k), bindings_kind(k), nodes_field(n, "left", l), nodes(l), nodes_field(n, "right", r), nodes(r).
bindings(n, l, r) :- nodes(n), kind(n, "named_expression"), nodes_field(n, "name", l), nodes(l), nodes_field(n, "value", r), nodes(r).
.decl bindings_fn(n: node, fn: node)
bindings_fn(n, f) :- bindings(n, _, _), ownership_fn(n, f).

// ---- name_sites: identifiers in a function ----
.decl name_sites(n: node, text: symbol, fn: node)
name_sites(n, t, f) :- nodes(n), kind(n, "identifier"), ownership_fn(n, f), functions(f), text(n, t).
.decl name_sites_store(n: node)
name_sites_store(n) :- name_sites(n, _, _), bindings(_, n, _).
// The bindings in a function whose target has a text: one row per binding node.
.decl ns_binding(fn: node, text: symbol, b: node)
ns_binding(f, t, b) :- bindings(b, l, _), bindings_fn(b, f), text(l, t).
.decl name_sites_binding_count(n: node, k: number)
name_sites_binding_count(n, k) :- name_sites(n, t, f), k = count : { ns_binding(f, t, _) }.
// latest_target: ORDER BY b.__start DESC LIMIT 1 over the earlier bindings; ties all kept.
.decl ns_prior(n: node, s: number)
ns_prior(n, bs) :- name_sites(n, t, f), ns_binding(f, t, b), start(b, bs), start(n, s), bs < s.
.decl ns_latest(n: node, s: number)
ns_latest(n, m) :- ns_prior(n, _), m = max x : { ns_prior(n, x) }.
.decl name_sites_latest_target(n: node, target: node)
name_sites_latest_target(n, l) :- ns_latest(n, m), name_sites(n, t, f), ns_binding(f, t, b), start(b, m), bindings(b, l, _).

// ---- propagation ----
.decl prop_wrapper_kind(k: symbol)
prop_wrapper_kind("parenthesized_expression"). prop_wrapper_kind("type"). prop_wrapper_kind("await"). prop_wrapper_kind("unary_operator").
prop_wrapper_kind("list"). prop_wrapper_kind("tuple"). prop_wrapper_kind("set"). prop_wrapper_kind("list_splat").
prop_wrapper_kind("expression_list"). prop_wrapper_kind("pattern_list").
.decl pattern_kind(k: symbol)
pattern_kind("pattern_list"). pattern_kind("tuple_pattern"). pattern_kind("list_pattern").
.decl sequence_kind(k: symbol)
sequence_kind("expression_list"). sequence_kind("tuple"). sequence_kind("list").
.decl capture_pattern_kind(k: symbol)
capture_pattern_kind("as_pattern"). capture_pattern_kind("splat_pattern").
.decl self_or_cls(t: symbol)
self_or_cls("self"). self_or_cls("cls").
.decl pipeline_scope_name(name: symbol)
pipeline_scope_name("async_pipeline_execution_scope"). pipeline_scope_name("get_lowering_context").
pipeline_scope_name("native_pipeline_execution_receipt"). pipeline_scope_name("pipeline_execution_scope").
.decl propagation(src: node, dst: node)
propagation(o, n) :- attributes(n, _, o, _).
propagation(c, n) :- nodes(n), kind(n, k), prop_wrapper_kind(k), nodes_parent(c, n).
propagation(c, n) :- nodes(n), kind(n, "boolean_operator"), nodes_parent(c, n).
propagation(c, n) :- nodes(n), kind(n, "conditional_expression"), nodes_parent(c, n), nodes_ordinal(c, 0).
propagation(c, n) :- nodes(n), kind(n, "conditional_expression"), nodes_parent(c, n), nodes_ordinal(c, 2).
propagation(c, n) :- nodes(n), kind(n, "pair"), fields(n, "value", c), nodes(c).
propagation(c, n) :- nodes(n), kind(n, "named_expression"), fields(n, "value", c), nodes(c).
propagation(c, n) :- nodes(n), kind(n, "dictionary"), nodes_parent(c, n).
propagation(o, n) :- calls(n, _, _, callee), calls_receiver(n, o), !pipeline_scope_name(callee).
propagation(a, n) :- calls(n, _, _, "getattr"), arguments(a, n, 0).
propagation(r, l) :- bindings(_, l, r), kind(l, k), !pattern_kind(k).
propagation(rv, lt) :- bindings(_, l, r), kind(l, lk), pattern_kind(lk), kind(r, rk), sequence_kind(rk),
    nodes_parent(lt, l), nodes_parent(rv, r), nodes_ordinal(lt, o), nodes_ordinal(rv, o).
propagation(r, lt) :- bindings(_, l, r), kind(l, lk), pattern_kind(lk), kind(r, rk), !sequence_kind(rk), nodes_parent(lt, l).
// Name sites: (p.fn = n.fn OR n.binding_count = 0) AND (n.binding_count <= 1 OR p.id = n.latest_target), as three rules.
propagation(p, n) :- name_sites(p, t, pf), name_sites(n, t, nf), !name_sites_store(n), docof(p, d), docof(n, d),
    node(_, pf, _, ps, pe), node(_, nf, _, ns, ne), ps <= ns, pe >= ne, pf = nf, name_sites_binding_count(n, k), k <= 1.
propagation(p, n) :- name_sites(p, t, pf), name_sites(n, t, nf), !name_sites_store(n), docof(p, d), docof(n, d),
    node(_, pf, _, ps, pe), node(_, nf, _, ns, ne), ps <= ns, pe >= ne, pf = nf, name_sites_latest_target(n, p).
propagation(p, n) :- name_sites(p, t, pf), name_sites(n, t, nf), !name_sites_store(n), docof(p, d), docof(n, d),
    node(_, pf, _, ps, pe), node(_, nf, _, ns, ne), ps <= ns, pe >= ne, name_sites_binding_count(n, 0).
// match subject → names its case patterns capture.
propagation(s, n) :- nodes(m), kind(m, "match_statement"), nodes_field(m, "subject", s), descendants(m, n), nodes(n),
    kind(n, "identifier"), nodes_parent(n, p), nodes(p), kind(p, pk), capture_pattern_kind(pk).
propagation(s, n) :- nodes(m), kind(m, "match_statement"), nodes_field(m, "subject", s), descendants(m, n), nodes(n),
    kind(n, "identifier"), nodes_parent(n, p), nodes(p), kind(p, "dotted_name"), nodes_parent(p, cp), nodes(cp),
    kind(cp, "case_pattern"), text(cp, ct), @rx_matches(ct, "^[A-Za-z_]\\w*$") = 1.
propagation(p, n) :- attributes(p, a, _, pt), self_or_cls(pt), attributes(n, a, _, nt), self_or_cls(nt), docof(p, d), docof(n, d).

// ---- subscripts, carrier_edges ----
.decl subscripts(n: node, container: node, container_kind: symbol, container_text: symbol)
subscripts(n, c, ck, ct) :- nodes(n), kind(n, "subscript"), nodes_parent(c, n), nodes_ordinal(c, 0), kind(c, ck), text(c, ct).
.decl indexed_sequence_kind(k: symbol)
indexed_sequence_kind("list"). indexed_sequence_kind("tuple").
.decl carrier_edges(src: node, dst: node)
carrier_edges(c, s) :- subscripts(s, c, ck, _), ck != "list", ck != "tuple", ck != "dictionary".
carrier_edges(e, s) :- subscripts(s, c, ck, _), indexed_sequence_kind(ck), nodes_parent(x, s), nodes_ordinal(x, 1), kind(x, "integer"),
    text(x, xt), i = @cast_int(xt), nodes_parent(e, c), nodes_ordinal(e, i).
carrier_edges(v, s) :- subscripts(s, c, "dictionary", _), nodes_parent(x, s), nodes_ordinal(x, 1), text(x, xt),
    nodes_parent(pair, c), nodes_parent(k, pair), nodes_ordinal(k, 0), text(k, xt), nodes_parent(v, pair), nodes_ordinal(v, 1).

// ---- owner_seeds ----
.decl seed_parameter_name(t: symbol)
seed_parameter_name("backend"). seed_parameter_name("executor").
.decl typed_parameter_kind(k: symbol)
typed_parameter_kind("typed_parameter"). typed_parameter_kind("typed_default_parameter").
// An assignment strictly inside (by span) a class whose header starts `class BaseServerPlan`.
.decl inside_base_server_plan(n: node)
inside_base_server_plan(n) :- nodes(n), kind(n, "assignment"), node(d, n, _, ns, ne), nodes(c), kind(c, "class_definition"),
    node(d, c, _, cs, ce), text(c, ct), @rx_matches(ct, "^class BaseServerPlan\\b") = 1, cs < ns, ce > ne.
.decl owner_seeds(n: node)
owner_seeds(n) :- nodes(n), kind(n, "identifier"), nodes_parent(n, p), nodes(p), kind(p, "parameters"), text(n, t), seed_parameter_name(t).
owner_seeds(n) :- nodes(n), kind(n, "identifier"), nodes_parent(n, p), nodes(p), kind(p, pk), typed_parameter_kind(pk),
    nodes_ordinal(n, 0), nodes_field(p, "type", ty), annotations(ty).
owner_seeds(c) :- calls(c, _, _, callee), docof(c, d), factories(d, callee).
owner_seeds(c) :- calls(c, _, _, callee), docof(c, d), executor_types(d, callee).
owner_seeds(c) :- calls(c, _, _, callee), @rx_matches(callee, "(?i)backend_executor") = 1.
owner_seeds(c) :- calls(c, _, _, "cast"), arguments(a, c, 0), annotations(a).
owner_seeds(l) :- nodes(n), kind(n, "assignment"), nodes_field(n, "left", l), nodes(l), nodes_field(n, "type", ty), annotations(ty).
owner_seeds(a) :- attributes(a, attr, _, ot), self_or_cls(ot), docof(a, d), nodes(n), kind(n, "assignment"), docof(n, d),
    nodes_field(n, "left", l), nodes(l), kind(l, "identifier"), text(l, attr), nodes_field(n, "type", ty), annotations(ty),
    inside_base_server_plan(n).

// ---- owners: a set recursion over propagation ∪ carrier_edges (E0 row #18) ----
.decl owners_all_edges(src: node, dst: node)
owners_all_edges(s, t) :- propagation(s, t).
owners_all_edges(s, t) :- carrier_edges(s, t).
.decl owners(n: node)
owners(n) :- owner_seeds(n).
owners(n) :- owners(s), owners_all_edges(s, n).

// ---- the clause's query: SPD001 anywhere, SPD005 in base_server_plan.py ----
.decl spd_file(d: number)
spd_file(d) :- doc(d, "impl/common/l2070_server_plan/base_server_plan.py").
.decl family_attribute(name: symbol)
family_attribute("is_document_backend"). family_attribute("is_graph_backend"). family_attribute("is_mysql_family"). family_attribute("is_sql_backend").
.decl connection_attribute(name: symbol)
connection_attribute("_async_conn"). connection_attribute("_conn"). connection_attribute("native_pipeline"). connection_attribute("native_pipeline_async").
.decl reflective_callee(name: symbol)
reflective_callee("delattr"). reflective_callee("getattr"). reflective_callee("getattr_static"). reflective_callee("hasattr").
reflective_callee("setattr"). reflective_callee("vars"). reflective_callee("__getattribute__").
.decl passing_callee(name: symbol)
passing_callee("PlanExecutor"). passing_callee("attrgetter"). passing_callee("cast"). passing_callee("delattr"). passing_callee("getattr").
passing_callee("getattr_static"). passing_callee("hasattr"). passing_callee("run_executable_pipeline").
passing_callee("run_executable_pipeline_async"). passing_callee("setattr"). passing_callee("vars").
// Owned by the function named _create_backend_executor.
.decl spd_in_factory(n: node)
spd_in_factory(n) :- ownership_fn(n, f), functions_name(f, "_create_backend_executor").
.decl spd_owned_child(n: node)
spd_owned_child(n) :- nodes(x), nodes_parent(x, n), owners(x).
.decl spd_owned_identifier_child(n: node)
spd_owned_identifier_child(n) :- nodes(x), nodes_parent(x, n), kind(x, "identifier"), owners(x).
// trim(a.text, '"' || "'") of the second argument names a pipeline scope.
.decl spd_scope_argument(call: node)
spd_scope_argument(c) :- arguments(a, c, 1), text(a, t), s = @trim(t, "\"'"), pipeline_scope_name(s).
.decl spd_owned_argument(call: node)
spd_owned_argument(c) :- arguments(a, c, _), owners(a).
finding("executor-provenance", "SPD001", n) :- attributes(n, a, _, _), family_attribute(a).
finding("executor-provenance", "SPD005", n) :- attributes(n, a, _, _), docof(n, d), spd_file(d), connection_attribute(a).
finding("executor-provenance", "SPD005", n) :- attributes(n, a, o, _), docof(n, d), spd_file(d), owners(o), !pipeline_scope_name(a).
finding("executor-provenance", "SPD005", n) :- subscripts(n, _, _, _), docof(n, d), spd_file(d), owners(n).
finding("executor-provenance", "SPD005", n) :- nodes(n), kind(n, "return_statement"), docof(n, d), spd_file(d), !spd_in_factory(n),
    spd_owned_identifier_child(n).
finding("executor-provenance", "SPD005", n) :- nodes(n), kind(n, "yield"), docof(n, d), spd_file(d), !spd_in_factory(n),
    spd_owned_identifier_child(n).
finding("executor-provenance", "SPD005", n) :- nodes(n), kind(n, "assignment"), docof(n, d), spd_file(d), nodes_field(n, "left", l),
    kind(l, "attribute"), nodes_field(n, "right", r), owners(r).
finding("executor-provenance", "SPD005", n) :- nodes(n), kind(n, "assignment"), docof(n, d), spd_file(d), nodes_field(n, "left", l),
    kind(l, "subscript"), nodes_field(n, "right", r), owners(r).
finding("executor-provenance", "SPD005", n) :- nodes(n), kind(n, "comparison_operator"), docof(n, d), spd_file(d), !spd_in_factory(n),
    spd_owned_child(n).
finding("executor-provenance", "SPD005", n) :- calls(n, _, _, callee), docof(n, d), spd_file(d), reflective_callee(callee),
    arguments(a, n, 0), owners(a), !spd_scope_argument(n).
finding("executor-provenance", "SPD005", n) :- calls(n, _, ck, callee), docof(n, d), spd_file(d), ck != "attribute",
    !passing_callee(callee), spd_owned_argument(n).
