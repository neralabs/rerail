// data-layer-serverplan-dispatch-architecture in Rerail logic: the 8 forbid clauses (backend-family, backend-identity,
// step-isinstance, step-type-compare, step-class-match, step-name-compare, dialect-compare, dialect-truth) and the
// relational clause `executor-provenance`, options at their defaults (entryPoint "all", oracleAnalyzer false).
// Source: gate/data-layer/packs/data-layer/candidates/rules/data-layer-serverplan-dispatch-architecture.json.
//
// Forbid clauses: yaml's form (`violation(...) :- ast(...)`). Each matcher selects a file filter by entryPoint
// (`$option`); its default case "all", `{"filePath": {"regex": "(?s).*"}}`, is written in place by hand.
//
// executor-provenance (partitionBy file): one relation per SQL stage, under the stage's name. Its 25 inputs are shards
// of one syntax table (base_server_plan.py's nodes); a row's id `kind:start:end` is a node here, its parent the PARENT
// capture, its field columns (`X_kind:X_start:X_end`) `nodes_field`. A nullable column is a side relation that holds
// where it is not NULL. Text-keyed relations (`executor_types`, `factories`) carry the document.
//
// Builtins: @rx_matches, @rx_extract, @concat, @instr, @trim (two arguments: strip the second's characters from both
// ends), @within, @cast_int (SQLite's CAST(x AS INTEGER): the text's leading decimal integer, 0 if none). A builtin
// with no value (SQL NULL) binds nothing.
// Tree recursion (ownership, descendants): tree builtins (`nearest`, `@within`) over the walk's roots (E0 rows #14, #15).
// Graph recursion (executor_types, annotations, owners): set recursion (E0 rows #16–#18).
// String recursion: executor_types' class-header arm builds its regex from the recursive value; its edges (name in a
// class header → the class) are materialised first over every name an arm can make, so no builtin is in the cycle.
// LIMIT/choice: name_sites.latest_target (ORDER BY b.__start DESC LIMIT 1): every binding at the greatest start before
// the site is kept.
// ties: nodes.ordinal (row_number by start, end, kind) and arguments.position (row_number by start): siblings never
// share a start in a valid tree, so none.
// LIKE '%BackendExecutor' (SQLite: ASCII case-insensitive): @rx_matches with "(?i)BackendExecutor$".
// findings layer (§8): path/start_byte/end_byte are the node's; identity ('family'||id, 'attribute'||id, …) is the arm
// and the node; UNION ALL's duplicates collapse to one finding per (issue, node).
// No stage is OUTSIDE; no fact is missing.
.policy {"format": "rerail.policy/v1", "id": "data-layer-serverplan-dispatch-architecture", "revision": 1, "mode": "block", "description": "Candidate port of nera-data-layer serverplan_dispatch_architecture at 2b1504adc4291daaf080b2e932962b134da1a69a.", "scope": {"include": ["impl/common/l2065_plan_core/**/*.py", "impl/common/l2066_plan_optimizer/**/*.py", "impl/common/l2070_server_plan/optimizers/**/*.py", "impl/common/l2070_server_plan/steps/**/*.py", "impl/common/l2070_server_plan/strategies/**/*.py", "impl/common/l7300_sql_versioned_transactions/**/*.py", "impl/common/l9700_sql_graph_query/**/*.py", "l2070_batching/**/*.py", "impl/common/l2070_server_plan/base_server_plan.py"], "exclude": ["**/.git/**", "**/.venv/**", "**/venv/**", "**/tmp/**", "**/__pycache__/**", "**/tests/**", "**/test_*.py"]}, "clauses": [{"id": "shared", "define": {"options": {"oracleAnalyzer": {"type": "boolean", "default": false}, "entryPoint": {"type": "string", "default": "all"}}, "language": "python", "utils": {"backend-source": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:backend_type)$"}]}, {"all": [{"kind": "attribute"}, {"any": [{"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:backend_type)$"}], "stopBy": "neighbor", "field": "attribute"}}, {"has": {"matches": "backend-source", "stopBy": "neighbor", "field": "object"}}]}]}, {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:backend_type_for|get_backend_type|get_backend_type_async)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:backend_type_for|get_backend_type|get_backend_type_async)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}]}, "step-type": {"any": [{"any": [{"all": [{"kind": "identifier"}, {"all": [{"regex": "^(?:ConditionalStep|PhysicalStatementGroup|[A-Za-z_]\\w*(?:Intent|Step|Strategy))$"}, {"not": {"all": [{"kind": "identifier"}, {"regex": "^(?:CompiledStep|IntentS