": "neighbor", "field": "name"}}, {"pattern": "$CLASS_NODE"}], "stopBy": {"kind": "class_definition"}}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$RET", "stopBy": "neighbor", "field": "return_type"}}, {"pattern": "$_"}]}, {"has": {"pattern": "$BODY", "stopBy": "neighbor", "field": "body"}}], "stopBy": {"kind": "function_definition"}}}, "b5-common-3": {"regex": "^(?:_fetchall|_fetchone|execute|execute_async|execute_fire_and_forget|execute_grammar|execute_grammar_fetchall|execute_grammar_fetchone|execute_raw|fetchall|fetchall_raw|fetchone|fetchone_raw|grammar_effect_lazy|grammar_fetchall|grammar_fetchall_async|grammar_fetchone|grammar_fetchone_async|grammar_row_lazy|grammar_rows_lazy|raw_execute)$|^(?:execute_grammar|grammar_fetch)"}}}}, {"id": "exported-families", "relational": "rdl", "violation": {"code": "public_triple", "message": "Public execution family coverage", "anchor": "witness.span"}}]}

.decl cdef(kind: symbol)
cdef("class_definition").
.decl finding(clause: symbol, key: symbol, n: node)
.output finding

// ---- inputs (evidence) ----
.decl raw_function(f: node, name: symbol)
raw_function(f, name) :- ast(d, f, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "function_definition"}, {"not": {"inside": {"kind": "function_definition", "stopBy": "end"}}}, {"pattern": "$OWNER"}, {"has": {"pattern": "$FNAME", "stopBy": "neighbor", "field": "name"}}, {"any": [{"inside": {"all": [{"kind": "class_definition"}, {"has": {"pattern": "$CLASS", "stopBy": "neighbor", "field": "name"}}, {"pattern": "$CLASS_NODE"}], "stopBy": {"kind": "class_definition"}}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$RET", "stopBy": "neighbor", "field": "return_type"}}, {"pattern": "$_"}]}, {"has": {"pattern": "$BODY", "stopBy": "neighbor", "field": "body"}}]}}, FNAME: n), text(n, name).
// CLASS/CLASS_NODE: `inside` a class_definition, stopping at the first one, of a function in no function: its nearest.
.decl raw_function_class(f: node, c: node, class: symbol)
raw_function_class(f, c, class) :- raw_function(f, _), nearest(f, c, cdef), field(c, "name", n), text(n, class).
// RET: the function's `return_type` child.
.decl raw_function_return(f: node, annotation: symbol)
raw_function_return(f, r) :- raw_function(f, _), field(f, "return_type", t), text(t, r).
.decl raw_class(c: node, name: symbol)
raw_class(c, name) :- ast(d, c, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "class_definition"}, {"has": {"pattern": "$NAME", "stopBy": "neighbor", "field": "name"}}, {"has": {"pattern": "$BODY", "stopBy": "neighbor", "field": "body"}}]}}, NAME: n), text(n, name).
.decl raw_decorator(owner: node, name: symbol)
raw_decorator(o, name) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "decorator"}, {"pattern": "$DECO"}, {"inside": {"all": [{"kind": "decorated_definition"}, {"has": {"all": [{"any": [{"kind": "function_definition"}, {"kind": "class_definition"}]}, {"pattern": "$DECL"}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}}, DECL: o), text(x, s), name = @rx_extract(s, "^@\\s*([^\\s(]+)", 1).
.decl raw_parameter(p: node, owner: node, name: symbol)
raw_parameter(p, o, name) :- ast(d, p, {"language": "python", "syntax": "valid", "rule": {"all": [{"all": [{"matches": "b5-common-1"}, {"not": {"any": [{"kind": "list_splat_pattern"}, {"kind": "dictionary_splat_pattern"}, {"all": [{"kind": "typed_parameter"}, {"has": {"any": [{"kind": "list_splat_pattern"}, {"kind": "dictionary_splat_pattern"}], "stopBy": "neighbor"}}]}]}}, {"not": {"precedes": {"kind": "positional_separator", "stopBy": "end"}}}, {"inside": {"kind": "parameters", "stopBy": "neighbor"}}, {"matches": "b5-common-2"}, {"pattern": "$PARAM"}]}, {"any": [{"has": {"pattern": "$TYPE", "stopBy": "neighbor", "field": "type"}}, {"pattern": "$_"}]}]}}, OWNER: o, NAME: n), text(n, name).
.decl raw_parameter_annotation(owner: node, p: node, name: symbol)
raw_parameter_annotation(o, p, name) :- ast(d, t, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "identifier"}, {"pattern": "$TOKEN"}, {"inside": {"all": [{"matches": "b5-common-1"}, {"not": {"any": [{"kind": "list_splat_pattern"}, {"kind": "dictionary_splat_pattern"}, {"all": [{"kind": "typed_parameter"}, {"has": {"any": [{"kind": "list_splat_pattern"}, {"kind": "dictionary_splat_pattern"}], "stopBy": "neighbor"}}]}]}}, {"not": {"precedes": {"kind": "positional_separator", "stopBy": "end"}}}, {"inside": {"kind": "parameters", "stopBy": "neighbor"}}, {"matches": "b5-common-2"}, {"pattern": "$PARAM"}], "field": "type", "stopBy": "end"}}]}}, OWNER: o, PARAM: p), text(t, name).
.decl raw_return_annotation(owner: node, name: symbol)
raw_return_annotation(o, name) :- ast(d, t, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "identifier"}, {"pattern": "$TOKEN"}, {"inside": {"all": [{"kind": "function_definition"}, {"not": {"inside": {"kind": "function_definition", "stopBy": "end"}}}, {"pattern": "$OWNER"}, {"has": {"pattern": "$FNAME", "stopBy": "neighbor", "field": "name"}}, {"any": [{"inside": {"all": [{"kind": "class_definition"}, {"has": {"pattern": "$CLASS", "stopBy": "neighbor", "field": "name"}}, {"pattern": "$CLASS_NODE"}], "stopBy": {"kind": "class_definition"}}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$RET", "stopBy": "neighbor", "field": "return_type"}}, {"pattern": "$_"}]}, {"has": {"pattern": "$BODY", "stopBy": "neighbor", "field": "body"}}], "field": "return_type", "stopBy": "end"}}]}}, OWNER: o), text(t, name).
.decl raw_import(i: node)
raw_import(i) :- ast(d, i, {"language": "python", "syntax": "valid", "rule": {"all": [{"any": [{"kind": "import_from_statement"}, {"kind": "import_statement"}]}, {"regex": "(?s)^(?:from\\s+(?P<BASE>[^\\s]+)\\s+)?import\\s+(?P<ITEMS>.*)$"}, {"any": [{"all": [{"inside": {"kind": "module", "stopBy": "neighbor"}}, {"pattern": "$TOP"}]}, {"pattern": "$_"}]}]}}).
.decl raw_import_base(i: node, base: symbol)
raw_import_base(i, b) :- ast(d, i, {"language": "python", "syntax": "valid", "rule": {"all": [{"any": [{"kind": "import_from_statement"}, {"kind": "import_statement"}]}, {"regex": "(?s)^(?:from\\s+(?P<BASE>[^\\s]+)\\s+)?import\\s+(?P<ITEMS>.*)$"}, {"any": [{"all": [{"inside": {"kind": "module", "stopBy": "neighbor"}}, {"pattern": "$TOP"}]}, {"pattern": "$_"}]}]}}, BASE: b).
// TOP: the statement is a child of the module.
.decl raw_import_top(i: node)
raw_import_top(i) :- raw_import(i), child(m, i, _), kind(m, "module").
.decl raw_base(owner: node, b: node, name: symbol)
raw_base(c, b, name) :- ast(d, b, {"language": "python", "syntax": "valid", "rule": {"all": [{"any": [{"kind": "identifier"}, {"kind": "attribute"}, {"kind": "generic_type"}, {"kind": "subscript"}]}, {"pattern": "$BASE"}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"all": [{"kind": "class_definition"}, {"pattern": "$CLASS"}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}}, CLASS: c), text(b, name).
.decl raw_all(a: node)
raw_all(a) :- ast(d, a, {"language": "python", "syntax": "valid", "rule": {"all": [{"all": [{"kind": "assignment"}, {"has": {"pattern": "__all__", "stopBy": "neighbor", "field": "left"}}, {"pattern": "$ALL"}, {"inside": {"kind": "expression_statement", "stopBy": "neighbor"}}, {"inside": {"kind": "module", "stopBy": "end"}}, {"not": {"inside": {"any": [{"kind": "function_definition"}, {"kind": "class_definition"}, {"kind": "if_statement"}, {"kind": "try_statement"}], "stopBy": "end"}}}]}, {"any": [{"has": {"all": [{"any": [{"kind": "list"}, {"kind": "tuple"}]}, {"pattern": "$ARRAY"}], "stopBy": "neighbor", "field": "right"}}, {"pattern": "$_"}]}]}, "file": {"path": {"regex": "^data_layer/[^/]+\\.py$"}}}).
// ARRAY: the assignment's right side, a list or tuple.
.decl raw_all_array(a: node)
raw_all_array(a) :- raw_all(a), field(a, "right", r), kind(r, "list").
raw_all_array(a) :- raw_all(a), field(a, "right", r), kind(r, "tuple").
.decl raw_all_name(owner: node, name: symbol)
raw_all_name(a, name) :- ast(d, v, {"language": "python", "syntax": "valid", "rule": {"all": [{"any": [{"kind": "string"}, {"kind": "concatenated_string"}]}, {"pattern": "$VALUE"}, {"inside": {"all": [{"any": [{"kind": "list"}, {"kind": "tuple"}]}, {"inside": {"all": [{"kind": "assignment"}, {"has": {"pattern": "__all__", "stopBy": "neighbor", "field": "left"}}, {"pattern": "$ALL"}, {"inside": {"kind": "expression_statement", "stopBy": "neighbor"}}, {"inside": {"kind": "module", "stopBy": "end"}}, {"not": {"inside": {"any": [{"kind": "function_definition"}, {"kind": "class_definition"}, {"kind": "if_statement"}, {"kind": "try_statement"}], "stopBy": "end"}}}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}, "transform": {"TEXT": {"replace": {"source": "$VALUE", "value": true, "replace": "\\b\\B", "by": ""}}}, "file": {"path": {"regex": "^data_layer/[^/]+\\.py$"}}}, ALL: a, TEXT: name).
.decl raw_execution_call(owner: node, name: symbol)
raw_execution_call(o, name) :- ast(d, x, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"all": [{"pattern": "$CALLEE"}, {"matches": "b5-common-3"}, {"regex": "_lazy$|^lazy_"}]}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"pattern": "$CALLEE"}, {"matches": "b5-common-3"}, {"regex": "_lazy$|^lazy_"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}, {"inside": {"all": [{"kind": "block"}, {"inside": {"all": [{"kind": "function_definition"}, {"not": {"inside": {"kind": "function_definition", "stopBy": "end"}}}, {"pattern": "$OWNER"}, {"inside": {"all": [{"kind": "decorated_definition"}, {"has": {"all": [{"kind": "decorator"}, {"regex": "^@\\s*(?:\\w+\\.)*direct_legacy[^.\\s(]*"}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}], "stopBy": "neighbor"}}], "stopBy": "end"}}]}}, OWNER: o, CALLEE: c), text(c, name).

// ---- inventory, declarations ----
.decl inventory(id: symbol, x: node, d: number, name: symbol, kind: symbol, module: symbol, fqname: symbol)
inventory(id, f, d, name, "function", m, fq) :- raw_function(f, name), !raw_function_class(f, _, _), docof(f, d), path_module(d, m),
    id = @concat(m, "::", name), fq = @dot(m, name).
inventory(id, f, d, name, "method", m, fq) :- raw_function(f, name), raw_function_class(f, _, c), docof(f, d), path_module(d, m),
    q = @dot(c, name), id = @concat(m, "::", q), fq = @dot(m, q).
inventory(id, c, d, name, "class", m, fq) :- raw_class(c, name), docof(c, d), path_module(d, m),
    id = @concat(m, "::", name), fq = @dot(m, name).
// row_number() OVER (PARTITION BY id ORDER BY __start DESC) = 1: the last definition of each id.
.decl inventory_start(id: symbol, s: number)
inventory_start(id, s) :- inventory(id, x, _, _, _, _, _), start(x, s).
.decl last_start(id: symbol, s: number)
last_start(id, s) :- inventory_start(id, _), s = max t : { inventory_start(id, t) }.
.decl declarations(id: symbol, x: node, d: number, name: symbol, kind: symbol, module: symbol, fqname: symbol)
declarations(id, x, d, n, k, m, fq) :- inventory(id, x, d, n, k, m, fq), start(x, s), last_start(id, s).
// class_name, class_start, return_annotation.
.decl decl_class(id: symbol, class: symbol)
decl_class(id, c) :- declarations(id, x, _, _, "method", _, _), raw_function_class(x, _, c).
.decl decl_class_node(id: symbol, c: node)
decl_class_node(id, c) :- declarations(id, x, _, _, "method", _, _), raw_function_class(x, c, _).
.decl decl_return(id: symbol, annotation: symbol)
decl_return(id, r) :- declarations(id, x, _, _, _, _, _), raw_function_return(x, r).
.decl declared_fq(fqname: symbol)
declared_fq(fq) :- declarations(_, _, _, _, _, _, fq).

// ---- parameters, annotation_names ----
.decl parameters(p: node, symbol: symbol, name: symbol)
parameters(p, id, n) :- raw_parameter(p, o, n), declarations(id, o, _, _, _, _, _), !decl_class(id, _).
parameters(p, id, n) :- raw_parameter(p, o, n), declarations(id, o, _, _, _, _, _), n != "self", n != "cls".
.decl annotation_names(symbol: symbol, name: symbol)
annotation_names(id, n) :- raw_return_annotation(o, n), declarations(id, o, _, _, _, _, _).
annotation_names(id, n) :- raw_parameter_annotation(_, p, n), parameters(p, id, _).

// ---- imports ----
// The SQL splits the statement's text at commas (`tokens`, a recursion through @substr) and strips leading package
// components one per round (`relative`, a counter-bounded recursion). Over the tape the items are the statement's
// `name` children, and the stripping is one builtin: no recursion.
.decl import_item(i: node, x: node, original: symbol)
import_item(i, x, o) :- raw_import(i), field(i, "name", x), kind(x, "dotted_name"), text(x, o).
import_item(i, x, o) :- raw_import(i), field(i, "name", x), kind(x, "aliased_import"), field(x, "name", n), text(n, o).
.decl import_alias(x: node, alias: symbol)
import_alias(x, a) :- import_item(_, x, _), field(x, "alias", n), text(n, a).
// The package a relative import starts from: the module for a package's __init__.py, else its parent.
.decl import_package(i: node, module: symbol, package: symbol)
import_package(i, m, m) :- raw_import_base(i, _), docof(i, d), doc(d, p), path_module(d, m), @rx_matches(p, "/__init__\\.py$") = 1.
import_package(i, m, pkg) :- raw_import_base(i, _), docof(i, d), doc(d, p), path_module(d, m), @rx_matches(p, "/__init__\\.py$") = 0,
    pkg = @rx_replace(m, "\\.?[^.]+$", "").
.decl import_candidate(i: node, module: symbol, name: symbol, target: symbol, kind: symbol)
import_candidate(i, m, a, o, "module") :- import_item(i, x, o), !raw_import_base(i, _), docof(i, d), path_module(d, m), import_alias(x, a).
import_candidate(i, m, n, o, "module") :- import_item(i, x, o), !raw_import_base(i, _), docof(i, d), path_module(d, m), !import_alias(x, _),
    n = @rx_extract(o, "^[^.]+", 0).
import_candidate(i, m, n, t, "symbol") :- import_item(i, x, o), raw_import_base(i, b), @substr(b, 1, 1) != ".", docof(i, d), path_module(d, m),
    t = @dot(b, o), import_alias(x, n).
import_candidate(i, m, o, t, "symbol") :- import_item(i, x, o), raw_import_base(i, b), @substr(b, 1, 1) != ".", docof(i, d), path_module(d, m),
    t = @dot(b, o), !import_alias(x, _).
import_candidate(i, m, n, t, "symbol") :- import_item(i, x, o), raw_import_base(i, b), @substr(b, 1, 1) = ".", import_package(i, m, pkg),
    up = @sub(@length(b), @length(@ltrim(b, ".")), 1), prefix = @drop_components(pkg, up), t = @join_nonempty(".", prefix, @ltrim(b, "."), o),
    import_alias(x, n).
import_candidate(i, m, o, t, "symbol") :- import_item(i, x, o), raw_import_base(i, b), @substr(b, 1, 1) = ".", import_package(i, m, pkg),
    up = @sub(@length(b), @length(@ltrim(b, ".")), 1), prefix = @drop_components(pkg, up), t = @join_nonempty(".", prefix, @ltrim(b, "."), o),
    !import_alias(x, _).
// row_number() OVER (PARTITION BY module, name, base IS NULL ORDER BY ordinal DESC) = 1: the last import of a name.
.decl import_start(module: symbol, name: symbol, kind: symbol, s: number)
import_start(m, n, k, s) :- import_candidate(i, m, n, _, k), start(i, s).
.decl import_last(module: symbol, name: symbol, kind: symbol, s: number)
import_last(m, n, k, s) :- import_start(m, n, k, _), s = max t : { import_start(m, n, k, t) }.
.decl imports(i: node, module: symbol, name: symbol, target: symbol, kind: symbol)
imports(i, m, n, t, k) :- import_candidate(i, m, n, t, k), start(i, s), import_last(m, n, k, s).

// ---- resolved_names: a set recursion over the re-export graph ----
.decl reexport(target: symbol, fqname: symbol)
reexport(t, fq) :- imports(_, m, n, t, "symbol"), fq = @dot(m, n), !declared_fq(fq).
.decl resolved_names(fqname: symbol, symbol: symbol)
resolved_names(fq, id) :- declarations(id, _, _, _, _, _, fq).
resolved_names(fq, id) :- resolved_names(t, id), reexport(t, fq).

// ---- base_edges ----
// coalesce(three lookups): the first that finds a class. The first two end in LIMIT 1 with no ORDER BY, an arbitrary
// row; here every row they could pick is kept.
.decl base_name(owner: symbol, module: symbol, name: symbol, ordinal: number)
base_name(id, m, bn, s) :- raw_base(c, r, name), declarations(id, c, _, _, _, m, _), start(r, s),
    bn = @trim(@rx_replace(@rx_replace(name, "(?s)\\[.*$", ""), "^.*\\.", "")).
.decl base_via_import(owner: symbol, base: symbol)
base_via_import(id, b) :- base_name(id, m, bn, _), imports(_, m, bn, t, "symbol"), declarations(b, _, _, _, "class", _, t).
.decl base_via_module(owner: symbol, base: symbol)
base_via_module(id, b) :- base_name(id, m, bn, _), declarations(b, _, _, bn, "class", m, _).
.decl class_named(name: symbol, id: symbol)
class_named(n, id) :- declarations(id, _, _, n, "class", _, _).
// (SELECT min(c.id) … HAVING count(*) = 1): the one class of that name.
.decl unique_class(name: symbol, id: symbol)
unique_class(n, id) :- class_named(n, id), k = count : { class_named(n, _) }, k = 1.
.decl base_target(owner: symbol, base: symbol)
base_target(id, b) :- base_via_import(id, b).
base_target(id, b) :- base_via_module(id, b), !has_base_via_import(id).
base_target(id, b) :- base_name(id, _, bn, _), unique_class(bn, b), !has_base_via_import(id), !has_base_via_module(id).
.decl has_base_via_import(owner: symbol)
has_base_via_import(id) :- base_via_import(id, _).
.decl has_base_via_module(owner: symbol)
has_base_via_module(id) :- base_via_module(id, _).
.decl base_edges(owner: symbol, base: symbol, ordinal: number)
base_edges(id, b, s) :- base_name(id, _, _, s), base_target(id, b).

// ---- hierarchy: every base of a class, at the least (depth, route) ----
// The SQL enumerates every simple path (`seen` guards cycles) and keeps row_number() = 1 by (depth, route). Each hop
// appends 13 characters to the route, so (depth, route) orders as (length, text): a best-witness lattice under
// shortlex. A least route is a shortest path, hence simple, so the guard is not needed (E0 § 2.2).
.lattice shortlex_min<symbol> { Lub -> @shortlex_min }
.decl hierarchy(owner: symbol, base: symbol, route: shortlex_min<>) widen 64
hierarchy(id, id, "") :- declarations(id, _, _, _, "class", _, _).
hierarchy(o, b, r) :- hierarchy(o, x, r0), base_edges(x, b, ord), r = @concat(r0, @printf("%012d.", ord)).

// ---- exports ----
// explicit_exports: row_number() OVER (PARTITION BY __path ORDER BY __start) = 1, the first __all__ of a file.
.decl all_start(d: number, s: number)
all_start(d, s) :- raw_all(a), docof(a, d), start(a, s).
.decl first_all_start(d: number, s: number)
first_all_start(d, s) :- all_start(d, _), s = min t : { all_start(d, t) }.
.decl first_all(d: number, a: node)
first_all(d, a) :- raw_all(a), docof(a, d), start(a, s), first_all_start(d, s).
.decl has_all(d: number)
has_all(d) :- first_all(d, _).
.decl export_names(d: number, module: symbol, name: symbol, target: symbol)
export_names(d, m, n, t) :- imports(i, m, n, t, "symbol"), raw_import_top(i), docof(i, d), doc(d, p), @rx_matches(p, "^data_layer/[^/]+\\.py$") = 1.
export_names(d, m, n, fq) :- declarations(id, _, d, n, k, m, fq), k != "method", doc(d, p), @rx_matches(p, "^data_layer/[^/]+\\.py$") = 1.
.decl exported_roots(d: number, export_module: symbol, export_name: symbol, symbol: symbol)
exported_roots(d, m, n, id) :- export_names(d, m, n, t), resolved_names(t, id), @substr(n, 1, 1) != "_", !has_all(d).
exported_roots(d, m, n, id) :- export_names(d, m, n, t), resolved_names(t, id), @substr(n, 1, 1) != "_", first_all(d, a), raw_all_array(a),
    raw_all_name(a, n).
.decl exported_symbol(symbol: symbol)
exported_symbol(id) :- exported_roots(_, _, _, id).

// ---- public_methods: of exported classes only ----
.decl property_like(x: node)
property_like(x) :- raw_decorator(x, n), @rx_matches(n, "property$|\\.setter$|\\.deleter$") = 1.
.decl excluded_method(name: symbol)
excluded_method("__aenter__"). excluded_method("__aexit__"). excluded_method("__enter__"). excluded_method("__exit__").
excluded_method("__init__"). excluded_method("__repr__"). excluded_method("__str__"). excluded_method("authorize_internal_access").
excluded_method("disable_thread_affinity_checks"). excluded_method("get_thread_checks_disabled"). excluded_method("set_disable_thread_checks").
excluded_method("validate_legacy_delegates"). excluded_method("versioned_read"). excluded_method("versioned_write").
.decl public_candidate(owner: symbol, name: symbol, symbol: symbol, len: number, route: symbol)
public_candidate(o, n, id, l, r) :- exported_symbol(o), hierarchy(o, c, r), declarations(c, _, _, cn, _, cm, _),
    declarations(id, x, _, n, "method", cm, _), decl_class(id, cn), @substr(n, 1, 1) != "_", !excluded_method(n), !property_like(x),
    l = @length(r).
// row_number() OVER (PARTITION BY owner, name ORDER BY depth, route) = 1, as two aggregates.
.decl public_len(owner: symbol, name: symbol, len: number)
public_len(o, n, l) :- public_candidate(o, n, _, l, _).
.decl public_best_len(owner: symbol, name: symbol, len: number)
public_best_len(o, n, l) :- public_len(o, n, _), l = min k : { public_len(o, n, k) }.
.decl public_route(owner: symbol, name: symbol, route: symbol)
public_route(o, n, r) :- public_candidate(o, n, _, l, r), public_best_len(o, n, l).
.decl public_best_route(owner: symbol, name: symbol, route: symbol)
public_best_route(o, n, r) :- public_route(o, n, _), r = min q : { public_route(o, n, q) }.
.decl public_methods(owner: symbol, name: symbol, symbol: symbol)
public_methods(o, n, id) :- public_candidate(o, n, id, _, r), public_best_route(o, n, r).

// ---- traits: declarations' rows; each computed column a relation over the id ----
.decl traits(id: symbol, x: node, d: number, name: symbol, kind: symbol)
traits(id, x, d, n, k) :- declarations(id, x, d, n, k, _, _).
// x.owner = d.__start; x.owner = d.__start OR x.owner = d.class_start.
.decl own_decorator(id: symbol, name: symbol)
own_decorator(id, n) :- traits(id, x, _, _, _), raw_decorator(x, n).
.decl scoped_decorator(id: symbol, name: symbol)
scoped_decorator(id, n) :- own_decorator(id, n).
scoped_decorator(id, n) :- decl_class_node(id, c), raw_decorator(c, n).
.decl legacy_sync(id: symbol)
legacy_sync(id) :- own_decorator(id, n), @rx_matches(n, "(?:legacy_sync|legacy_module_sync|direct_legacy_module_sync)$") = 1.
.decl legacy_async(id: symbol)
legacy_async(id) :- own_decorator(id, n), @rx_matches(n, "(?:legacy_async|legacy_module_async|direct_legacy_module_async)$") = 1.
.decl lazy_decorated(id: symbol)
lazy_decorated(id) :- own_decorator(id, n), @rx_matches(n, "pure_lazy|apply_lazy_to_public_lazy_methods|(?:^|\\.)lazy$") = 1.
lazy_decorated(id) :- traits(id, _, _, name, _), @substr(name, 1, 1) != "_", @rx_matches(name, "_lazy$") = 1, scoped_decorator(id, n),
    @rx_matches(n, "pure_lazy|apply_lazy_to_public_lazy_methods|(?:^|\\.)lazy$") = 1.
.decl private_api(id: symbol)
private_api(id) :- scoped_decorator(id, n), @rx_matches(n, "(?:^|\\.)(?:internal_api|private_api|private_public_api)$") = 1.
// execution_surface: no exclusion holds, and a reason does.
.decl abstract_decorated(id: symbol)
abstract_decorated(id) :- own_decorator(id, n), @rx_matches(n, "abstractmethod$") = 1.
.decl lazy_type(name: symbol)
lazy_type("lazyresult"). lazy_type("lazyseq"). lazy_type("serverplan").
.decl lazy_annotated(id: symbol)
lazy_annotated(id) :- annotation_names(id, n), l = @lower(n), lazy_type(l).
.decl lazy_module_path(path: symbol)
lazy_module_path("l2055_lazy_result/lazy_reads.py"). lazy_module_path("l2055_lazy_result/lazy_writes.py"). lazy_module_path("l2055_lazy_result/transform.py").
.decl lazy_module_exception(id: symbol)
lazy_module_exception(id) :- traits(id, _, d, n, "function"), doc(d, p), lazy_module_path(p), @instr(n, "lazy_") = 1, @rx_matches(n, "_lazy$") = 1.
lazy_module_exception(id) :- traits(id, _, d, n, "function"), doc(d, p), lazy_module_path(p), @instr(n, "lazy_") = 1, lazy_annotated(id).
// coalesce((path IN … AND class_name IN …), 0): false where class_name is NULL.
.decl context_path(path: symbol)
context_path("l2055_lazy_result/execution_context.py"). context_path("l2055_lazy_result/lazy_result.py"). context_path("l2055_lazy_result/lazy_seq.py").
context_path("l2055_lazy_result/transform.py").
.decl context_class(name: symbol)
context_class("BatchContext"). context_class("EagerContext"). context_class("LazyResult"). context_class("LazySeq"). context_class("OnAccessContext").
.decl context_class_exception(id: symbol)
context_class_exception(id) :- traits(id, _, d, _, _), doc(d, p), context_path(p), decl_class(id, c), context_class(c).
// coalesce((class_name IS NOT NULL AND (trim(return_annotation, ' ''"') = class_name OR …)), 0).
.decl self_returning(id: symbol)
self_returning(id) :- decl_class(id, c), decl_return(id, r), @trim(r, " '\"") = c.
self_returning(id) :- decl_class(id, c), decl_return(id, r), @instr(@trim(r, " '\""), @concat(c, "[")) = 1.
.decl execution_verb(name: symbol)
execution_verb("aggregate"). execution_verb("commit"). execution_verb("commit_branch"). execution_verb("count").
execution_verb("create_branch"). execution_verb("cursor_paginate"). execution_verb("cursor_paginate_with_total").
execution_verb("delete_by_id"). execution_verb("delete_by_key"). execution_verb("delete_by_key_many").
execution_verb("delete_many"). execution_verb("execute"). execution_verb("execute_one"). execution_verb("exists").
execution_verb("find_object_branches"). execution_verb("find_object_revisions"). execution_verb("first").
execution_verb("fts_search"). execution_verb("get_history"). execution_verb("graph"). execution_verb("graph_query").
execution_verb("insert"). execution_verb("insert_many"). execution_verb("insert_many_raw").
execution_verb("keyset_paginate"). execution_verb("keyset_paginate_with_total"). execution_verb("query").
execution_verb("query_unfiltered"). execution_verb("read"). execution_verb("read_version").
execution_verb("rollback"). execution_verb("search"). execution_verb("select_at_revision").
execution_verb("select_many"). execution_verb("select_one"). execution_verb("table_exists").
execution_verb("traverse"). execution_verb("update"). execution_verb("update_by_key").
execution_verb("update_by_key_many"). execution_verb("update_many"). execution_verb("upsert").
execution_verb("upsert_many"). execution_verb("vector_search"). execution_verb("write").
execution_verb("write_version").
.decl surface_annotation(name: symbol)
surface_annotation("databaseconnection"). surface_annotation("lazyresult"). surface_annotation("lazyseq").
surface_annotation("readtransaction"). surface_annotation("serverplan").
surface_annotation("versioneddatabaseconnection"). surface_annotation("versionedreadtransaction").
surface_annotation("versionedwritetransaction"). surface_annotation("writetransaction").
// The verb's context: the path, the class name (lower(coalesce(class_name, '')): none without a class), an annotation.
.decl surface_context(id: symbol)
surface_context(id) :- traits(id, _, d, _, _), doc(d, p), @rx_matches(p, "(?:/graph_query|/schema_transaction|/transaction|/versioned_transactions)") = 1.
surface_context(id) :- decl_class(id, c), @rx_matches(@lower(c), "(?:connection|query|schematransaction|transaction|versioned)") = 1.
surface_context(id) :- annotation_names(id, n), l = @lower(n), surface_annotation(l).
.decl surface_reason(id: symbol)
surface_reason(id) :- traits(id, _, _, n, _), b = @rx_replace(n, "_(?:lazy|async|sync)$", ""), execution_verb(b), surface_context(id).
surface_reason(id) :- traits(id, _, _, n, _), @rx_matches(n, "_lazy$") = 1.
surface_reason(id) :- lazy_annotated(id).
surface_reason(id) :- legacy_sync(id).
surface_reason(id) :- legacy_async(id).
.decl execution_surface(id: symbol)
execution_surface(id) :- surface_reason(id), !abstract_decorated(id), !private_api(id), !lazy_module_exception(id), !context_class_exception(id),
    !self_returning(id).
// params: the parameter names by __start, as (position, name); position = the parameters before it.
.decl param_before(p: node, q: node)
param_before(p, q) :- parameters(p, id, _), parameters(q, id, _), start(p, sp), start(q, sq), sq < sp.
.decl params(symbol: symbol, i: number, name: symbol)
params(id, i, n) :- parameters(p, id, n), i = count : { param_before(p, _) }.
.decl params_len(symbol: symbol, k: number)
params_len(id, k) :- traits(id, _, _, _, _), k = count : { parameters(_, id, _) }.
// direct_lazy_wrapper: a direct_legacy decorator and a lazy execution call in the body.
.decl execution_call_name(name: symbol)
execution_call_name("_fetchall"). execution_call_name("_fetchone"). execution_call_name("execute").
execution_call_name("execute_async"). execution_call_name("execute_fire_and_forget").
execution_call_name("execute_grammar"). execution_call_name("execute_grammar_fetchall").
execution_call_name("execute_grammar_fetchone"). execution_call_name("execute_raw"). execution_call_name("fetchall").
execution_call_name("fetchall_raw"). execution_call_name("fetchone"). execution_call_name("fetchone_raw").
execution_call_name("grammar_effect_lazy"). execution_call_name("grammar_fetchall").
execution_call_name("grammar_fetchall_async"). execution_call_name("grammar_fetchone").
execution_call_name("grammar_fetchone_async"). execution_call_name("grammar_row_lazy").
execution_call_name("grammar_rows_lazy"). execution_call_name("raw_execute").
.decl execution_call_family(name: symbol)
execution_call_family(c) :- raw_execution_call(_, c), execution_call_name(c).
execution_call_family(c) :- raw_execution_call(_, c), @instr(c, "execute_grammar") = 1.
execution_call_family(c) :- raw_execution_call(_, c), @instr(c, "grammar_fetch") = 1.
.decl lazy_call_name(name: symbol)
lazy_call_name(c) :- raw_execution_call(_, c), @rx_matches(c, "_lazy$") = 1.
lazy_call_name(c) :- raw_execution_call(_, c), @instr(c, "lazy_") = 1.
.decl direct_lazy_wrapper(id: symbol)
direct_lazy_wrapper(id) :- own_decorator(id, n), @rx_matches(n, "(?:^|\\.)direct_legacy[^.]*$") = 1, traits(id, x, _, _, _),
    raw_execution_call(x, c), execution_call_family(c), lazy_call_name(c).

// ---- surfaces ----
.decl mixed_name(name: symbol)
mixed_name(n) :- traits(_, _, _, n, _), l = @lower(n), @rx_matches(l, "lazy") = 1, @rx_matches(l, "async|sync") = 1.
.decl protocol_base(c: node)
protocol_base(c) :- raw_base(c, _, b), @instr(b, "Protocol") > 0.
.decl surface_row(scope: symbol, owner: symbol, ordinal: symbol, symbol: symbol, name: symbol)
surface_row("function", m, o, id, n) :- exported_roots(_, m, en, id), traits(id, _, d, n, "function"), @substr(n, 1, 1) != "_", doc(d, p),
    @instr(p, "_internal/") != 1, o = @concat(m, @char(0), en).
surface_row("method", cn, n, id, n) :- exported_symbol(c), traits(c, cx, _, cn, "class"), public_methods(c, _, id), traits(id, _, _, n, _),
    !private_api(c), !private_api(id), @rx_matches(cn, "Protocol$|^Async") = 0, !protocol_base(cx).
// base_name: CASE WHEN mixed THEN name ELSE rx_replace(…) END.
.decl surface_base(scope: symbol, owner: symbol, ordinal: symbol, symbol: symbol, name: symbol, base_name: symbol)
surface_base(sc, o, ord, id, n, n) :- surface_row(sc, o, ord, id, n), mixed_name(n).
surface_base(sc, o, ord, id, n, b) :- surface_row(sc, o, ord, id, n), !mixed_name(n), b = @rx_replace(n, "_(?:lazy|async|sync)$", "").
// slot: one rule per CASE branch.
.decl invalid_mixed(scope: symbol, name: symbol)
invalid_mixed("method", n) :- mixed_name(n).
.decl surfaces(scope: symbol, owner: symbol, ordinal: symbol, symbol: symbol, name: symbol, base_name: symbol, slot: symbol)
surfaces(sc, o, ord, id, n, b, "__invalid_mixed_name__") :- surface_base(sc, o, ord, id, n, b), invalid_mixed(sc, n).
surfaces(sc, o, ord, id, n, b, "lazy") :- surface_base(sc, o, ord, id, n, b), !invalid_mixed(sc, n), @rx_matches(n, "_lazy$") = 1.
surfaces(sc, o, ord, id, n, b, "async") :- surface_base(sc, o, ord, id, n, b), !invalid_mixed(sc, n), @rx_matches(n, "_lazy$") = 0,
    @rx_matches(n, "_async$") = 1.
surfaces(sc, o, ord, id, n, b, "async") :- surface_base(sc, o, ord, id, n, b), !invalid_mixed(sc, n), @rx_matches(n, "_lazy$") = 0,
    @rx_matches(n, "_async$") = 0, legacy_async(id).
surfaces(sc, o, ord, id, n, b, "sync") :- surface_base(sc, o, ord, id, n, b), !invalid_mixed(sc, n), @rx_matches(n, "_lazy$") = 0,
    @rx_matches(n, "_async$") = 0, !legacy_async(id).

// ---- slots: per (scope, owner, base_name, slot), the row at the greatest ordinal, with the least ordinal ----
.decl function_mixed(scope: symbol, name: symbol)
function_mixed("function", n) :- mixed_name(n).
.decl slot_candidate(scope: symbol, owner: symbol, base_name: symbol, slot: symbol, ordinal: symbol, symbol: symbol)
slot_candidate(sc, o, b, sl, ord, id) :- surfaces(sc, o, ord, id, n, b, sl), !function_mixed(sc, n).
.decl slot_first(scope: symbol, owner: symbol, base_name: symbol, slot: symbol, ordinal: symbol)
slot_first(sc, o, b, sl, f) :- slot_candidate(sc, o, b, sl, _, _), f = min t : { slot_candidate(sc, o, b, sl, t, _) }.
.decl slot_last(scope: symbol, owner: symbol, base_name: symbol, slot: symbol, ordinal: symbol)
slot_last(sc, o, b, sl, l) :- slot_candidate(sc, o, b, sl, _, _), l = max t : { slot_candidate(sc, o, b, sl, t, _) }.
.decl slots(scope: symbol, owner: symbol, base_name: symbol, slot: symbol, symbol: symbol, first_ordinal: symbol)
slots(sc, o, b, sl, id, f) :- slot_candidate(sc, o, b, sl, l, id), slot_last(sc, o, b, sl, l), slot_first(sc, o, b, sl, f).
.decl slot_symbol(scope: symbol, owner: symbol, base_name: symbol, slot: symbol, symbol: symbol)
slot_symbol(sc, o, b, sl, id) :- slots(sc, o, b, sl, id, _).
.decl group_slot(scope: symbol, owner: symbol, base_name: symbol, slot: symbol)
group_slot(sc, o, b, sl) :- slots(sc, o, b, sl, _, _).

// ---- family_groups: GROUP BY (scope, owner, base_name) ----
.decl family_groups(scope: symbol, owner: symbol, base_name: symbol)
family_groups(sc, o, b) :- slots(sc, o, b, _, _, _).
.decl group_first(scope: symbol, owner: symbol, base_name: symbol, first_ordinal: symbol)
group_first(sc, o, b, f) :- family_groups(sc, o, b), f = min t : { slots(sc, o, b, _, _, t) }.
.decl group_exemplar(scope: symbol, owner: symbol, base_name: symbol, symbol: symbol)
group_exemplar(sc, o, b, id) :- slots(sc, o, b, _, id, f), group_first(sc, o, b, f).
// max(CASE WHEN slot = … THEN symbol END): NULL where the slot is absent (`group_slot`).
.decl group_sync(scope: symbol, owner: symbol, base_name: symbol, symbol: symbol)
group_sync(sc, o, b, id) :- group_slot(sc, o, b, "sync"), id = max s : { slot_symbol(sc, o, b, "sync", s) }.
.decl group_async(scope: symbol, owner: symbol, base_name: symbol, symbol: symbol)
group_async(sc, o, b, id) :- group_slot(sc, o, b, "async"), id = max s : { slot_symbol(sc, o, b, "async", s) }.
.decl group_lazy(scope: symbol, owner: symbol, base_name: symbol, symbol: symbol)
group_lazy(sc, o, b, id) :- group_slot(sc, o, b, "lazy"), id = max s : { slot_symbol(sc, o, b, "lazy", s) }.
.decl group_mixed(scope: symbol, owner: symbol, base_name: symbol)
group_mixed(sc, o, b) :- slots(sc, o, b, _, id, _), traits(id, _, _, n, _), mixed_name(n).
.decl group_surface(scope: symbol, owner: symbol, base_name: symbol)
group_surface(sc, o, b) :- slots(sc, o, b, _, id, _), execution_surface(id).

// ---- eligible_groups (executionOnly true): mixed, or an execution surface no exception names ----
.decl plan_verb(name: symbol)
plan_verb("plan"). plan_verb("query"). plan_verb("query_unfiltered").
.decl transaction_path(path: symbol)
transaction_path("l2050_transaction/transaction.py"). transaction_path("l7200_versioned_transactions/versioned_transactions.py").
.decl transaction_owner(name: symbol)
transaction_owner("ReadTransaction"). transaction_owner("WriteTransaction"). transaction_owner("LazyVersionedReadTransaction").
transaction_owner("LazyVersionedWriteTransaction").
.decl bootstrap_verb(name: symbol)
bootstrap_verb("check_ddl_lockdown"). bootstrap_verb("column_exists"). bootstrap_verb("physical_table_exists_many"). bootstrap_verb("seal_table_exists_cache").
.decl handle_owner(name: symbol)
handle_owner("LazyVersionedReadTransaction"). handle_owner("LazyVersionedWriteTransaction"). handle_owner("SyncSessionHandle").
handle_owner("AsyncSessionHandle"). handle_owner("SyncVersionHandle"). handle_owner("AsyncVersionHandle").
.decl bootstrap_only(scope: symbol, owner: symbol, base_name: symbol)
bootstrap_only(sc, o, b) :- group_slot(sc, o, b, "lazy"), !group_slot(sc, o, b, "sync"), !group_slot(sc, o, b, "async").
.decl group_excepted(scope: symbol, owner: symbol, base_name: symbol, exemplar: symbol)
group_excepted(sc, o, b, ex) :- group_exemplar(sc, o, b, ex), plan_verb(b), traits(ex, _, d, _, _), doc(d, p), transaction_path(p), transaction_owner(o).
group_excepted(sc, "CacheTransaction", "commit", ex) :- group_exemplar(sc, "CacheTransaction", "commit", ex).
group_excepted(sc, "CacheTransaction", "rollback", ex) :- group_exemplar(sc, "CacheTransaction", "rollback", ex).
group_excepted(sc, "BaseMigration", "rollback", ex) :- group_exemplar(sc, "BaseMigration", "rollback", ex).
group_excepted(sc, "SchemaTransaction", "execute_ddl", ex) :- group_exemplar(sc, "SchemaTransaction", "execute_ddl", ex).
group_excepted(sc, "AsyncSchemaTransaction", "execute_ddl", ex) :- group_exemplar(sc, "AsyncSchemaTransaction", "execute_ddl", ex).
group_excepted(sc, o, "execute_ddl", ex) :- group_exemplar(sc, o, "execute_ddl", ex), traits(ex, _, d, _, _), doc(d, "l2000_connection/schema_transaction.py").
group_excepted(sc, o, "table_exists", ex) :- group_exemplar(sc, o, "table_exists", ex), @rx_matches(o, "Connection$") = 1.
group_excepted(sc, o, b, ex) :- group_exemplar(sc, o, b, ex), bootstrap_only(sc, o, b), @instr(@lower(b), "bootstrap") > 0.
group_excepted(sc, o, b, ex) :- group_exemplar(sc, o, b, ex), bootstrap_only(sc, o, b), @instr(@lower(o), "bootstrap") > 0.
group_excepted(sc, o, b, ex) :- group_exemplar(sc, o, b, ex), bootstrap_only(sc, o, b), bootstrap_verb(b).
group_excepted(sc, o, b, ex) :- group_exemplar(sc, o, b, ex), handle_owner(o).
group_excepted(sc, o, b, ex) :- group_exemplar(sc, o, b, ex),
    @rx_matches(o, "^(?:Sync|Async|Lazy).*(?:Transaction|SchemaTransaction|SessionHandle|VersionHandle)$") = 1.
.decl eligible_groups(scope: symbol, owner: symbol, base_name: symbol, exemplar: symbol)
eligible_groups(sc, o, b, ex) :- group_exemplar(sc, o, b, ex), group_mixed(sc, o, b).
eligible_groups(sc, o, b, ex) :- group_exemplar(sc, o, b, ex), !group_excepted(sc, o, b, ex), group_surface(sc, o, b).

// ---- families: mixed groups, and per (scope, base_name, implementations) the least owner ----
.decl eligible_key(scope: symbol, owner: symbol, base_name: symbol)
eligible_key(sc, o, b) :- eligible_groups(sc, o, b, _).
// A (slot, symbol) of group o1 that group o2 (same scope and base_name) lacks.
.decl implementation_missing(scope: symbol, base_name: symbol, o1: symbol, o2: symbol)
implementation_missing(sc, b, o1, o2) :- eligible_key(sc, o1, b), eligible_key(sc, o2, b), slot_symbol(sc, o1, b, sl, id),
    !slot_symbol(sc, o2, b, sl, id).
.decl same_implementations(scope: symbol, base_name: symbol, o1: symbol, o2: symbol)
same_implementations(sc, b, o1, o2) :- eligible_key(sc, o1, b), eligible_key(sc, o2, b), o1 != o2,
    !implementation_missing(sc, b, o1, o2), !implementation_missing(sc, b, o2, o1).
.decl dominated(scope: symbol, owner: symbol, base_name: symbol)
dominated(sc, o, b) :- same_implementations(sc, b, o, o2), o2 < o.
.decl families(scope: symbol, owner: symbol, base_name: symbol, exemplar: symbol)
families(sc, o, b, ex) :- eligible_groups(sc, o, b, ex), group_mixed(sc, o, b).
families(sc, o, b, ex) :- eligible_groups(sc, o, b, ex), !dominated(sc, o, b).

// ---- triple_violations ----
.decl plain_family(scope: symbol, owner: symbol, base_name: symbol, exemplar: symbol)
plain_family(sc, o, b, ex) :- families(sc, o, b, ex), !group_mixed(sc, o, b).
// s.params = l.params, for the (sync, lazy) and (async, lazy) pairs compared.
.decl params_pair(s: symbol, l: symbol)
params_pair(s, l) :- plain_family(sc, o, b, _), group_sync(sc, o, b, s), group_lazy(sc, o, b, l).
params_pair(s, l) :- plain_family(sc, o, b, _), group_async(sc, o, b, s), group_lazy(sc, o, b, l).
.decl params_differ(s: symbol, l: symbol)
params_differ(s, l) :- params_pair(s, l), params_len(s, a), params_len(l, c), a != c.
params_differ(s, l) :- params_pair(s, l), params(s, i, n), params(l, i, m), n != m.
.decl same_params(s: symbol, l: symbol)
same_params(s, l) :- params_pair(s, l), !params_differ(s, l).
// direct_wrapper_bypasses_lazy_owner: row_number() OVER (PARTITION BY family ORDER BY d.__path, d.__start) = 1, as
// two aggregates; a family is its group.
.decl wrapper_candidate(scope: symbol, owner: symbol, base_name: symbol, symbol: symbol, path: symbol, s: number)
wrapper_candidate(sc, o, b, id, p, s) :- plain_family(sc, o, b, _), group_slot(sc, o, b, "lazy"), slot_symbol(sc, o, b, "sync", id),
    direct_lazy_wrapper(id), traits(id, x, d, _, _), doc(d, p), start(x, s).
wrapper_candidate(sc, o, b, id, p, s) :- plain_family(sc, o, b, _), group_slot(sc, o, b, "lazy"), slot_symbol(sc, o, b, "async", id),
    direct_lazy_wrapper(id), traits(id, x, d, _, _), doc(d, p), start(x, s).
.decl wrapper_path(scope: symbol, owner: symbol, base_name: symbol, path: symbol)
wrapper_path(sc, o, b, p) :- wrapper_candidate(sc, o, b, _, p, _).
.decl wrapper_first_path(scope: symbol, owner: symbol, base_name: symbol, path: symbol)
wrapper_first_path(sc, o, b, p) :- wrapper_path(sc, o, b, _), p = min q : { wrapper_path(sc, o, b, q) }.
.decl wrapper_start(scope: symbol, owner: symbol, base_name: symbol, s: number)
wrapper_start(sc, o, b, s) :- wrapper_candidate(sc, o, b, _, p, s), wrapper_first_path(sc, o, b, p).
.decl wrapper_first_start(scope: symbol, owner: symbol, base_name: symbol, s: number)
wrapper_first_start(sc, o, b, s) :- wrapper_start(sc, o, b, _), s = min t : { wrapper_start(sc, o, b, t) }.
.decl triple_violations(issue: symbol, symbol: symbol)
triple_violations("invalid_mixed_lazy_execution_name", id) :- surfaces("function", _, _, id, n, _, _), mixed_name(n).
triple_violations("invalid_mixed_lazy_execution_name", ex) :- families(sc, o, b, ex), group_mixed(sc, o, b).
triple_violations("missing_sync", ex) :- plain_family(sc, o, b, ex), !group_slot(sc, o, b, "sync"), group_slot(sc, o, b, "async").
triple_violations("missing_async", ex) :- plain_family(sc, o, b, ex), !group_slot(sc, o, b, "async"), group_slot(sc, o, b, "sync").
triple_violations("missing_lazy", ex) :- plain_family(sc, o, b, ex), !group_slot(sc, o, b, "lazy").
triple_violations("missing_legacy_sync", s) :- plain_family(sc, o, b, _), group_sync(sc, o, b, s), group_lazy(sc, o, b, l), same_params(s, l),
    !legacy_sync(s).
triple_violations("missing_legacy_async", s) :- plain_family(sc, o, b, _), group_async(sc, o, b, s), group_lazy(sc, o, b, l), same_params(s, l),
    !legacy_async(s).
triple_violations("missing_lazy_decorator", l) :- plain_family(sc, o, b, _), group_lazy(sc, o, b, l), !lazy_decorated(l).
triple_violations("direct_wrapper_bypasses_lazy_owner", id) :- wrapper_candidate(sc, o, b, id, p, s), wrapper_first_path(sc, o, b, p),
    wrapper_first_start(sc, o, b, s).

// ---- the clause's query: one finding per violation, at the symbol's declaration ----
finding("exported-families", i, x) :- triple_violations(i, id), traits(id, x, _, _, _).
