// data-layer-public-api-triples in Rerail logic: clause `exported-families`, options at their defaults
// (oracleAnalyzer false, sourceGate true, executionOnly true: `eligible_groups` is its "true" case). Source:
// gate/data-layer/packs/data-layer/candidates/rules/data-layer-public-api-triples.json.
//
// One relation per SQL stage, under the stage's name. A SQL row keyed by (__path, __start) is a node here; a nullable
// column is a side relation that holds where the column is not NULL, a boolean column a relation that holds where it
// is true. Inputs are matcher atoms with the rule's matchers verbatim; an atom exports only captures every match binds,
// and an optional capture is read by exact tree relations on the same node. The clause is repository-wide (no
// partitionBy): symbols are joined across documents on computed names (`@cat`, `@concat`). The stages through
// `hierarchy` and the exports are internal_dead_code.rdl's (same SQL); `decorators`, `bases`, `all_names` and
// `execution_calls` are their raw inputs with the owner as a node (the CAST).
//
// Builtins (t17's catalogue; only `@cat` is built): @rx_replace, @rx_extract, @rx_matches, @replace, @concat, @cat,
// @substr, @instr, @lower, @length, @ltrim, @trim (SQL trim(X) and trim(X, Y)), @sub (a − b − …), @printf, @char (SQL
// char(n)), @drop_components (drop k trailing dotted components), @join_nonempty (join the non-empty arguments after
// the first with the first). A builtin with no value (SQL NULL) binds nothing.
// Tape form: `imports`' `tokens` and `relative` (string unfolds, E0 § 2.5 row 11) are the statement's `name` children
// and @drop_components, as in internal_dead_code.rdl.
// Tape form: `traits.params` (json_group_array of parameter names by __start) is `params` (position, name) and
// `params_len`; `s.params = l.params` is equal length and no position whose names differ.
// LIMIT/choice: `base_edges`' first two lookups (LIMIT 1, no ORDER BY) keep every row they could pick.
// LIMIT/choice: `family_groups.exemplar` (ORDER BY first_ordinal LIMIT 1) keeps every slot at the least first_ordinal;
// `eligible_groups` and `families` carry it as a column.
// ties: `slots` (row_number() ORDER BY ordinal DESC) keeps every row at the greatest ordinal (same-named classes, or an
// export name that resolves to several symbols).
// ties: `families` compares `implementations` (json_group_array of (slot, symbol) ORDER BY slot) as a set of pairs,
// which differs from the text only under ties in slot order.
// findings layer (§8): `family` (json_array of scope, owner, base_name and the function's ordinal or the group's
// implementations), the finding's text column; and the multiplicity of `surfaces`/`triple_violations` (UNION ALL bags
// here sets).
.policy {"format": "rerail.policy/v1", "id": "data-layer-public-api-triples", "revision": 2, "mode": "log", "description": "Candidate port of nera-data-layer public_api_triples at 2b1504adc4291daaf080b2e932962b134da1a69a.", "scope": {"include": ["api/**/*.py", "impl/**/*.py", "data_layer/**/*.py", "_internal/**/*.py", "l1000_cache/**/*.py", "l1000_schema/**/*.py", "l1050_model_registry/**/*.py", "l1050_polymorphism/**/*.py", "l1100_exceptions/**/*.py", "l1200_capabilities/**/*.py", "l1200_content_hash/**/*.py", "l1200_json/**/*.py", "l1200_versioned_ids/**/*.py", "l1250_security/**/*.py", "l1300_session/**/*.py", "l1350_foundational_types/**/*.py", "l1400_config/**/*.py", "l1400_types/**/*.py", "l1450_index_policy_contracts/**/*.py", "l1450_keys/**/*.py", "l1470_matching_contracts/**/*.py", "l1500_llm/**/*.py", "l1900_retry/**/*.py", "l2000_connection/**/*.py", "l2050_transaction/**/*.py", "l2055_lazy_result/**/*.py", "l2060_query_builder/**/*.py", "l2070_batching/**/*.py", "l2080_lazy_orm/**/*.py", "l2090_byte_tracking/**/*.py", "l2090_response/**/*.py", "l2091_rtt_tracking/**/*.py", "l2092_timing_tracking/**/*.py", "l2100_include/**/*.py", "l2110_limits/**/*.py", "l2150_prepared_cache/**/*.py", "l2200_notification/**/*.py", "l2500_binary_diff/**/*.py", "l3000_schema_builder/**/*.py", "l3100_schema_introspector/**/*.py", "l3150_schema_diff/**/*.py", "l3200_metadata/**/*.py", "l3250_migrations/**/*.py", "l3260_startup/**/*.py", "l3500_bulk_ops/**/*.py", "l4000_permissions/**/*.py", "l4050_background_reaper/**/*.py", "l4100_queue/**/*.py", "l4150_scheduler/**/*.py", "l4170_inbound_bridge/**/*.py", "l4200_event_pipeline/**/*.py", "l4250_timers/**/*.py", "l4300_ipc/**/*.py", "l4300_timers/**/*.py", "l4350_timer_driver/**/*.py", "l4400_scheduler/**/*.py", "l4500_trust/**/*.py", "l5000_search_index_policy/**/*.py", "l5000_subscriptions/**/*.py", "l5100_fts/**/*.py", "l5100_llm_router/**/*.py", "l5175_chunking/**/*.py", "l5195_embedding_compute_tables/**/*.py", "l5200_vec