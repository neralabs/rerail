// data-layer-serverplan-steps in Rerail logic: clause `step-contracts-5` (STEP-041), a part of serverplan_steps.rdl;
// options at their defaults (entryPoint "all", strictModulesOnly true). Source:
// gate/data-layer/packs/data-layer/candidates/rules/data-layer-serverplan-steps.json.
//
// One relation per SQL stage, under the stage's name. The clause is per file (partitionBy file): a SQL row keyed by
// (__path, id) is a node, `id = kind:start:end` being that node, and text joins stay in one document (`docof`).
// `nodes` is the set `raw_nodes` matches; a stage that joins `nodes` on a captured id needs that node in the set. The
// optional captures are tree relations: NAME, VALUE, TYPE, FUNCTION, ARGUMENTS, OBJECT, ATTRIBUTE, PARAMETERS
// (`has $X, field f, stopBy neighbor`) are `field`, PARENT (`inside $X, stopBy neighbor`) is `child`, ANCESTOR (the
// nearest strict ancestor matching the region selector, which is the selector of `nodes`) is the deepest strict
// ancestor in `nodes`. A nullable column is a side relation that holds where it is not NULL; a boolean column a
// relation that holds where it is true.
//
// Builtins: @rx_matches, @trim, @within, @depth. A builtin with no value (SQL NULL) binds nothing.
// findings layer (§8): identity (node id) and entry; a finding is (issue, node).
// ties: `ordinal` (start, end, kind) and `position` (start) cannot tie on distinct nodes.

.decl fdef(kind: symbol)
fdef("function_definition").
.decl cdef(kind: symbol)
cdef("class_definition").
.decl finding(clause: symbol, key: symbol, n: node)
.output finding

// ---- inputs (evidence) ----
.decl raw_nodes(n: node)
raw_nodes(n) :- ast(d, n, {"language": "python", "syntax": "valid", "rule": {"all": [{"$option": "entryPoint", "cases": {"all": {"filePath": {"regex": "(?s).*"}}, "check_compiled_result_builders_do_not_fail_closed": {"filePath": {"regex": "(?s).*"}}, "_scan_source": {"filePath": {"regex": "(?s).*"}}, "_scan_file": {"filePath": {"regex": "(?s).*"}}}, "default": {"filePath": {"regex": "\\b\\B"}}}, {"any": [{"any": [{"kind": "module"}, {"all": [{"kind": "expression_statement"}, {"any": [{"inside": {"kind": "module", "stopBy": "neighbor"}}, {"inside": {"all": [{"kind": "block"}, {"inside": {"kind": "class_definition", "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}]}, {"kind": "class_definition"}, {"kind": "function_definition"}, {"kind": "decorated_definition"}, {"all": [{"kind": "argument_list"}, {"inside": {"kind": "class_definition", "stopBy": "neighbor"}}]}, {"inside": {"all": [{"kind": "argument_list"}, {"inside": {"kind": "class_definition", "stopBy": "neighbor"}}], "stopBy": "neighbor"}}]}, {"any": [{"any": [{"any": [{"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:CompiledStep)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:CompiledStep)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}, {"all": [{"kind": "call"}, {"has": {"any": [{"all": [{"kind": "identifier"}, {"regex": "^(?:ResultAssertionSpec|ResultMaterializationSpec|assert_result|materialize|static_exception_post_op)$"}]}, {"all": [{"kind": "attribute"}, {"has": {"all": [{"kind": "identifier"}, {"regex": "^(?:ResultAssertionSpec|ResultMaterializationSpec|assert_result|materialize|static_exception_post_op)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}]}]}, {"all": [{"kind": "call"}, {"inside": {"kind": "return_statement", "stopBy": "neighbor"}}]}]}, {"inside": {"any": [{"any": [{"all": [{"kind": "call"}, {"has": {"