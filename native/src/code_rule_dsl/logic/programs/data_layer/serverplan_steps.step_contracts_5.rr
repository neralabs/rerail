ssert_result|static_exception_post_op)$"}], "stopBy": "neighbor", "field": "attribute"}}]}], "stopBy": "neighbor", "field": "function"}}], "stopBy": "end"}}, {"kind": "raise_statement"}, {"inside": {"kind": "raise_statement", "stopBy": "end"}}]}}}, {"pattern": "$_"}]}, {"pattern": "$NODE"}, {"any": [{"inside": {"pattern": "$PARENT", "stopBy": "neighbor"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$NAME", "stopBy": "neighbor", "field": "name"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$VALUE", "stopBy": "neighbor", "field": "value"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$TYPE", "stopBy": "neighbor", "field": "type"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$FUNCTION", "stopBy": "neighbor", "field": "function"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$ARGUMENTS", "stopBy": "neighbor", "field": "arguments"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$OBJECT", "stopBy": "neighbor", "field": "object"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$ATTRIBUTE", "stopBy": "neighbor", "field": "attribute"}}, {"pattern": "$_"}]}, {"any": [{"has": {"pattern": "$PARAMETERS", "stopBy": "neighbor", "field": "parameters"}}, {"pattern": "$_"}]}]}}).
// `relaxed` is not read by the clause's SQL.
.decl relaxed(d: number)
relaxed(d) :- ast(d, m, {"language": "python", "syntax": "valid", "rule": {"all": [{"kind": "module"}, {"$option": "strictModulesOnly", "cases": {"true": {"filePath": {"regex": "\\b\\B"}}, "false": {"filePath": {"regex": "(?s).*"}}}}]}}).

// ---- nodes, edges ----
.decl nodes(n: node)
nodes(n) :- raw_nodes(n).
.decl nodes_parent(n: node, p: node)
nodes_parent(n, p) :- nodes(n), child(p, n, _).
// edge_parent: ANCESTOR, the deepest node of `nodes` strictly above.
.decl nodes_above(n: node, a: node, depth: number)
nodes_above(n, a, k) :- nodes(n), nodes(a), @within(n, a) = 1, k = @depth(a).
.decl nodes_above_deepest(n: node, depth: number)
nodes_above_deepest(n, k) :- nodes_above(n, _, _), k = max j : { nodes_above(n, _, j) }.
.decl nodes_edge_parent(n: node, a: node)
nodes_edge_parent(n, a) :- nodes_above(n, a, k), nodes_above_deepest(n, k).
// ordinal: row_number() OVER (PARTITION BY parent ORDER BY __start, __end, kind) - 1, among `nodes`.
.decl nodes_before(n: node, m: node)
nodes_before(n, m) :- nodes_parent(n, p), nodes_parent(m, p), start(n, sn), start(m, sm), sm < sn.
nodes_before(n, m) :- nodes_parent(n, p), nodes_parent(m, p), node(_, n, _, s, en), node(_, m, _, s, em), em < en.
nodes_before(n, m) :- nodes_parent(n, p), nodes_parent(m, p), node(_, n, kn, s, e), node(_, m, km, s, e), km < kn.
.decl nodes_has_before(n: node)
nodes_has_before(n) :- nodes_before(n, _).
.decl nodes_ordinal(n: node, ordinal: number)
nodes_ordinal(n, 0) :- nodes(n), !nodes_has_before(n).
nodes_ordinal(n, k) :- nodes_has_before(n), k = count : { nodes_before(n, _) }.
.decl edges(src: node, dst: node, ordinal: number)
edges(s, n, o) :- nodes_edge_parent(n, s), nodes_ordinal(n, o).

// ---- functions, ownership, attributes ----
.decl functions(f: node)
functions(f) :- nodes(f), kind(f, "function_definition").
.decl functions_name(f: node, name: symbol)
functions_name(f, s) :- functions(f), field(f, "name", x), text(x, s).
// The SQL walks `edges` down from the roots, carrying the nearest function and class and the outermost function
// (E0 row 61). Every function_definition and class_definition is in `nodes`, so these are ancestors-or-self on the tape.
.decl ownership(n: node)
ownership(n) :- nodes(n).
.decl ownership_fn(n: node, fn: node)
ownership_fn(n, n) :- nodes(n), kind(n, "function_definition").
ownership_fn(n, f) :- nodes(n), kind(n, k), k != "function_definition", nearest(n, f, fdef).
.decl ownership_cls(n: node, cls: node)
ownership_cls(n, n) :- nodes(n), kind(n, "class_definition").
ownership_cls(n, c) :- nodes(n), kind(n, k), k != "class_definition", nearest(n, c, cdef).
.decl fn_nested(f: node)
fn_nested(f) :- functions(f), nearest(f, g, fdef).
.decl ownership_top_fn(n: node, fn: node)
ownership_top_fn(n, n) :- functions(n), !fn_nested(n).
ownership_top_fn(n, f) :- nodes(n), functions(f), @within(n, f) = 1, !fn_nested(f).
.decl attributes(a: node)
attributes(a) :- nodes(a), kind(a, "attribute").
.decl attributes_attr(a: node, attr: symbol)
attributes_attr(a, s) :- attributes(a), field(a, "attribute", x), text(x, s).
.decl attributes_object(a: node, object: node)
attributes_object(a, o) :- attributes(a), field(a, "object", o).

// ---- calls, arguments, keywords, descendants ----
// callee = coalesce(attribute's attr, function text).
.decl calls(c: node, callee_id: node, full_callee: symbol, callee: symbol)
calls(c, f, t, a) :- nodes(c), kind(c, "call"), field(c, "function", f), nodes(f), text(f, t), attributes_attr(f, a).
calls(c, f, t, t) :- nodes(c), kind(c, "call"), field(c, "function", f), nodes(f), text(f, t), !attributes_attr(f, _).
.decl calls_receiver(c: node, receiver: node)
calls_receiver(c, o) :- calls(c, f, _, _), attributes_object(f, o).
.decl argument_row(n: node, call: node)
argument_row(n, c) :- calls(c, _, _, _), field(c, "arguments", l), child(l, n, _), nodes(n), kind(n, k),
    k != "comment", k != "keyword_argument", k != "list_splat", k != "dictionary_splat".
.decl argument_before(n: node, m: node)
argument_before(n, m) :- argument_row(n, c), argument_row(m, c), start(n, sn), start(m, sm), sm < sn.
.decl argument_has_before(n: node)
argument_has_before(n) :- argument_before(n, _).
.decl arguments(n: node, call: node, position: number)
arguments(n, c, 0) :- argument_row(n, c), !argument_has_before(n).
arguments(n, c, p) :- argument_row(n, c), argument_has_before(n), p = count : { argument_before(n, _) }.
.decl keywords(call: node, keyword: node, name: symbol, value: node)
keywords(c, k, s, v) :- calls(c, _, _, _), field(c, "arguments", l), child(l, k, _), nodes(k), kind(k, "keyword_argument"),
    field(k, "name", kn), nodes(kn), text(kn, s), field(k, "value", v), nodes(v).
// The SQL's reflexive closure of `edges` (E0 row 62): a node of `nodes` and every node of `nodes` below it, since
// `edges` links each node to the deepest one above it.
.decl descendants(root: node, node: node)
descendants(n, n) :- nodes(n).
descendants(r, n) :- nodes(n), nodes(r), @within(n, r) = 1.

// ---- returns, parameters ----
.decl returns(n: node, value: node)
returns(n, v) :- nodes(n), kind(n, "return_statement"), child(n, v, _), nodes(v).
.decl returns_fn(n: node, fn: node)
returns_fn(n, f) :- returns(n, _), ownership_fn(n, f).
// A parameter is a child of the function's PARAMETERS; its name is itself (an identifier) or its first child in
// `nodes` when that is an identifier.
.decl parameter_row(fn: node, p: node, name: symbol)
parameter_row(f, p, s) :- functions(f), field(f, "parameters", l), child(l, p, _), nodes(p), kind(p, "identifier"), text(p, s).
parameter_row(f, p, s) :- functions(f), field(f, "parameters", l), child(l, p, _), nodes(p), kind(p, k), parameter_kind(k),
    child(p, n, _), nodes(n), nodes_ordinal(n, 0), kind(n, "identifier"), text(n, s).
.decl parameter_kind(k: symbol)
parameter_kind("identifier"). parameter_kind("typed_parameter"). parameter_kind("default_parameter"). parameter_kind("typed_default_parameter").
.decl parameter_before(fn: node, p: node, q: node)
parameter_before(f, p, q) :- parameter_row(f, p, _), parameter_row(f, q, _), start(p, sp), start(q, sq), sq < sp.
.decl parameter_has_before(fn: node, p: node)
parameter_has_before(f, p) :- parameter_before(f, p, _).
.decl parameters(fn: node, p: node, name: symbol, position: number)
parameters(f, p, s, 0) :- parameter_row(f, p, s), !parameter_has_before(f, p).
parameters(f, p, s, i) :- parameter_row(f, p, s), parameter_has_before(f, p), i = count : { parameter_before(f, p, _) }.
.decl parameters_annotation(p: node, annotation: node)
parameters_annotation(p, t) :- parameters(_, p, _, _), field(p, "type", t).

// ---- nonempty_keywords, compiled ----
.decl string_kind(k: symbol)
string_kind("string"). string_kind("concatenated_string").
.decl container_kind(k: symbol)
container_kind("list"). container_kind("tuple"). container_kind("set").
.decl keyword_empty(v: node)
keyword_empty(v) :- keywords(_, _, _, v), kind(v, "none").
keyword_empty(v) :- keywords(_, _, _, v), kind(v, k), string_kind(k), text(v, s), @trim(s, "\"'") = "".
keyword_empty(v) :- keywords(_, _, _, v), kind(v, k), container_kind(k), !has_node_child(v).
.decl has_node_child(p: node)
has_node_child(p) :- nodes(c), nodes_parent(c, p).
.decl nonempty_keywords(call: node, keyword: node, name: symbol, value: node)
nonempty_keywords(c, k, s, v) :- keywords(c, k, s, v), !keyword_empty(v).
.decl compiled(c: node)
compiled(c) :- calls(c, _, "CompiledStep", _).
// grammarless is NOT compiled_grammar.
.decl compiled_grammar(c: node)
compiled_grammar(c) :- compiled(c), keywords(c, _, "grammar", v), kind(v, k), k != "none".
.decl compiled_refs(c: node)
compiled_refs(c) :- compiled(c), nonempty_keywords(c, _, "runtime_ref_ids", _).
compiled_refs(c) :- compiled(c), nonempty_keywords(c, _, "source_refs", _).
.decl compiled_sql_surface(c: node)
compiled_sql_surface(c) :- compiled_refs(c).
compiled_sql_surface(c) :- compiled(c), nonempty_keywords(c, _, "auxiliary_ctes", _).
compiled_sql_surface(c) :- compiled_grammar(c).

// ---- static_exception_seeds ----
// LIKE '%x' is a suffix test, ASCII case-insensitive.
.decl fail_open_exception(s: symbol)
fail_open_exception("RuntimeError"). fail_open_exception("TypeError"). fail_open_exception("NotImplementedError").
.decl assert_result_call(c: node)
assert_result_call(c) :- calls(c, _, t, _), @rx_matches(t, "(?is)CompiledPostOp\\.assert_result$") = 1.
// A spec call that names a static_exception other than the three.
.decl spec_static_exception(spec: node)
spec_static_exception(s) :- calls(s, _, _, _), keywords(s, _, "static_exception", v), kind(v, k), static_exception_kind(k),
    text(v, x), !fail_open_exception(x).
.decl static_exception_kind(k: symbol)
static_exception_kind("identifier"). static_exception_kind("attribute").
.decl call_has_argument(c: node)
call_has_argument(c) :- arguments(_, c, _).
.decl static_exception_seeds(c: node)
static_exception_seeds(c) :- calls(c, _, t, _), @rx_matches(t, "(?is)static_exception_post_op$") = 1, arguments(a, c, 0), text(a, x),
    fail_open_exception(x).
static_exception_seeds(c) :- assert_result_call(c), arguments(a, c, 0), calls(a, _, _, _), !spec_static_exception(a).
static_exception_seeds(c) :- assert_result_call(c), keywords(c, _, "spec", s), calls(s, _, _, _), !call_has_argument(c),
    !spec_static_exception(s).

// ---- static_exception_functions: a set recursion over the in-file call graph by name (E0 row 63) ----
.decl static_exception_functions(d: number, name: symbol)
static_exception_functions(d, s) :- functions_name(f, s), docof(f, d), descendants(f, c), calls(c, _, _, "ResultAssertionSpec"),
    keywords(c, _, "static_exception", v), kind(v, "identifier"), text(v, x), parameters(f, _, x, _).
static_exception_functions(d, s) :- functions_name(f, s), docof(f, d), returns_fn(r, f), returns(r, v), static_exception_seeds(v).
static_exception_functions(d, s) :- functions_name(f, s), docof(f, d), returns_fn(r, f), returns(r, v), calls(v, _, _, e),
    static_exception_functions(d, e).

// ---- materialization_functions ----
.decl materializing_call(c: node)
materializing_call(c) :- calls(c, _, _, "ResultMaterializationSpec").
materializing_call(c) :- calls(c, _, t, _), @rx_matches(t, "(?is)CompiledPostOp\\.materialize$") = 1.
materializing_call(c) :- calls(c, _, _, "CompiledStep"), keywords(c, _, s, _), post_op_keyword(s).
.decl post_op_keyword(s: symbol)
post_op_keyword("post_op"). post_op_keyword("closed_post_op"). post_op_keyword("post_op_with_refs").
.decl materialization_functions(f: node)
materialization_functions(f) :- functions(f), descendants(f, c), materializing_call(c).

// ---- the clause's query: STEP-041 ----
// A raise of a fail-open exception (named, or called) in a materialization function.
.decl fail_open_raised(e: node)
fail_open_raised(e) :- nodes(e), kind(e, "identifier"), text(e, x), fail_open_exception(x).
fail_open_raised(e) :- nodes(e), calls(e, _, x, _), fail_open_exception(x).
finding("step-contracts-5", "STEP-041", n) :- nodes(n), kind(n, "raise_statement"), ownership_fn(n, f), materialization_functions(f),
    nodes_parent(e, n), fail_open_raised(e).
// A closed_post_op of a CompiledStep in a materialization function that is a fail-open seed, or calls a helper that returns one.
.decl closed_post_op_value(v: node)
closed_post_op_value(v) :- keywords(c, _, "closed_post_op", v), compiled(c), ownership_fn(c, f), materialization_functions(f).
finding("step-contracts-5", "STEP-041", n) :- closed_post_op_value(n), nodes(n), static_exception_seeds(n).
finding("step-contracts-5", "STEP-041", n) :- closed_post_op_value(n), nodes(n), calls(n, _, _, e), docof(n, d), static_exception_functions(d, e).
