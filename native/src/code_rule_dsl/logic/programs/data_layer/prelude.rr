// The inputs every data-layer program reads (prepended to each by `logic::front`'s data-layer test).
//
// The tape, in T's relations (`typing/programs/calls.rdl`): one row per node. `text` is a node's source text, any
// node's (a builtin over the tape's source; decision 0026 stores no per-node rows). `doc` holds the document's path.
.decl doc(d: number, path: symbol)
.decl node(d: number, n: node, kind: symbol, start: number, end: number)
.decl child(p: node, c: node, i: number)
.decl field(p: node, f: symbol, c: node)
.decl text(n: node, s: symbol)
.decl source(d: number, sp: node)
.input doc, node, child, field, text, source
.decl kind(n: node, k: symbol)
kind(n, k) :- node(_, n, k, _, _).
.decl docof(n: node, d: number)
docof(n, d) :- node(d, n, _, _, _).
.decl start(n: node, s: number)
start(n, s) :- node(_, n, _, s, _).

// Facts the rules read that no producer makes yet (t17, census category `facts:crossfile`).
// `reference_edge`: W's `references` linker, a definition referring to another, across files.
.decl reference_edge(n: node, t: node)
.input reference_edge

// `module_of`: W's `file.module` (`python_module_path`). The packages are the directories holding an `__init__.py`
// ("" for the root's). From a file's directory, climbing while each directory is a package, the highest reached is
// the package root; the module is the path below the root's parent, the file by its stem, with dots. Outside a
// package, or where the climb reaches the root's own package, it is the stem.
.decl dl_package(x: symbol)
dl_package(x) :- doc(_, p), @rx_matches(p, "(^|/)__init__[.]py$") = 1, x = @rx_replace(p, "/?__init__[.]py$", "").
.decl dl_package_root(x: symbol, r: symbol)
dl_package_root(x, x) :- dl_package(x), x != "", y = @rx_replace(x, "(^|/)[^/]*$", ""), !dl_package(y).
dl_package_root(x, r) :- dl_package(x), x != "", y = @rx_replace(x, "(^|/)[^/]*$", ""), y != "", dl_package(y),
    dl_package_root(y, r).
.decl dl_rooted(x: symbol)
dl_rooted(x) :- dl_package_root(x, _).
.decl dl_module_file(d: number, p: symbol, x: symbol)
dl_module_file(d, p, x) :- doc(d, p), @rx_matches(p, "[.]pyi?$") = 1, x = @rx_replace(p, "(^|/)[^/]*$", "").
.decl dl_module_path(d: number, q: symbol)
dl_module_path(d, q) :- dl_module_file(d, p, x), dl_package_root(x, r), @rx_replace(r, "(^|/)[^/]*$", "") = "", q = p.
dl_module_path(d, q) :- dl_module_file(d, p, x), dl_package_root(x, r), b = @rx_replace(r, "(^|/)[^/]*$", ""), b != "",
    q = @substr(p, @length(b) + 2, @length(p)).
dl_module_path(d, q) :- dl_module_file(d, p, x), !dl_rooted(x), q = @rx_replace(p, "^.*/", "").
.decl module_of(d: number, m: symbol)
module_of(d, m) :- dl_module_path(d, q), m = @replace(@rx_replace(q, "(.)[.][^./]*$", "$1"), "/", ".").

// The document's module from its path alone, as the rules' SQL computes it.
.decl path_module(d: number, m: symbol)
path_module(d, m) :- doc(d, p), s = @rx_replace(p, "/__init__\\.py$|\\.py$", ""), m = @replace(s, "/", ".").
