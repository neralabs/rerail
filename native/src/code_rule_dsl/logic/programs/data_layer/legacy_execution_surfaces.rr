forbid_include("post-fetch-filter_query_results_async", "api/reqs/**").
forbid_exclude("post-fetch-filter_query_results_async", "docs/data_history/**").
forbid_include("graph-fallback-text", "impl/common/l9700_sql_graph_query/**").
forbid_include("graph-fallback-text", "api/impl/common/l9700_sql_graph_query/**").
forbid_exclude("graph-fallback-text", "impl/common/l9700_sql_graph_query/sql_graph_query.py").
forbid_exclude("graph-fallback-text", "api/impl/common/l9700_sql_graph_query/sql_graph_query.py").
forbid_include("inventory-export_cursor.py", "**/*").
forbid_exclude("inventory-export_cursor.py", "impl/doltdb/export_cursor.py").
forbid_exclude("inventory-export_cursor.py", "impl/mariadb/export_cursor.py").
forbid_exclude("inventory-export_cursor.py", "impl/mongodb/export_cursor.py").
forbid_exclude("inventory-export_cursor.py", "impl/neo4j/export_cursor.py").
forbid_exclude("inventory-export_cursor.py", "impl/postgres/export_cursor.py").
forbid_exclude("inventory-export_cursor.py", "impl/sqlite/export_cursor.py").
