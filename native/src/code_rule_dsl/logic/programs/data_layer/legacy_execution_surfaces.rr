forbid_include("inventory-legacy_wrappers.py", "**/*").
forbid_exclude("inventory-legacy_wrappers.py", "l2050_transaction/legacy_wrappers.py").
// regex.paths: a file the clause reads (removed-read-leaves has no `paths`: every file).
.decl forbid_excluded(clause: symbol, d: number)
forbid_excluded(c, d) :- forbid_exclude(c, g), doc(d, p), glob(g, p).
.decl forbid_file(clause: symbol, d: number)
forbid_file(c, d) :- forbid_include(c, g), doc(d, p), glob(g, p), !forbid_excluded(c, d).
forbid_file("removed-read-leaves", d) :- doc(d, _).
// The witness node: the document's module (its text is file.content past leading white space).
.decl root(d: number, n: node)
root(d, n) :- node(d, n, "module", _, _).
// file.content, entryPoint "all".
violation("data-layer-legacy-execution-surfaces", "post-fetch-filter_query_results", D, N) :- forbid_file("post-fetch-filter_query_results", D),
    root(D, N), text(N, s), @rx_matches(s, "filter_query_results") = 1.
violation("data-layer-legacy-execution-surfaces", "post-fetch-filter_query_results_async", D, N) :- forbid_file("post-fetch-filter_query_results_async", D),
    root(D, N), text(N, s), @rx_matches(s, "filter_query_results_async") = 1.
violation("data-layer-legacy-execution-surfaces", "graph-fallback-text", D, N) :- forbid_file("graph-fallback-text", D),
    root(D, N), text(N, s), @rx_matches(s, "grammar_rows_lazy|grammar_row_lazy|fetchone_via_plan|fetchall_via_plan") = 1.
// file.path, oracleAnalyzer false.
violation("data-layer-legacy-execution-surfaces", "inventory-export_cursor.py", D, N) :- forbid_file("inventory-export_cursor.py", D),
    doc(D, p), @rx_matches(p, "(?:^|/)export_cursor\\.py$") = 1, root(D, N).
violation("data-layer-legacy-execution-surfaces", "inventory-fts_searcher.py", D, N) :- forbid_file("inventory-fts_searcher.py", D),
    doc(D, p), @rx_matches(p, "(?:^|/)fts_searcher\\.py$") = 1, root(D, N).
violation("data-layer-legacy-execution-surfaces", "inventory-legacy_wrappers.py", D, N) :- forbid_file("inventory-legacy_wrappers.py", D),
    doc(D, p), @rx_matches(p, "(?:^|/)legacy_wrappers\\.py$") = 1, root(D, N).
violation("data-layer-legacy-execution-surfaces", "removed-read-leaves", D, N) :- forbid_file("removed-read-leaves", D),
    doc(D, p), @rx_matches(p, "^(?:impl/common/l5200_sql_query/_aggregate_query_leaf\\.py|impl/common/l5200_sql_query/_pagination_leaf\\.py|impl/common/l5200_sql_query/_read_query_leaf\\.py)$") = 1,
    root(D, N).

