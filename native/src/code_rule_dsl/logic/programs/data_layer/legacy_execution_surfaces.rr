// data-layer-legacy-execution-surfaces in Rerail logic: the seven regex forbid clauses (post-fetch-filter_query_results,
// post-fetch-filter_query_results_async, graph-fallback-text, inventory-export_cursor.py, inventory-fts_searcher.py,
// inventory-legacy_wrappers.py, removed-read-leaves) and the relational clause `legacy-execution-graphs`, options at
// their defaults (entryPoint "all", oracleAnalyzer false). Source:
// gate/data-layer/packs/data-layer/candidates/rules/data-layer-legacy-execution-surfaces.json.
//
// One relation per SQL stage, under the stage's name. A SQL row keyed by (__path, __start) is a node here, and a node id
// `kind:start:end` is the tape node; a nullable column is a side relation that holds where the column is not NULL.
// Inputs are matcher atoms with the rule's matchers verbatim (their `$option` nodes included, resolved at the defaults
// by the matcher compiler). The clause is partitioned by file: every join is within one document.
// None of the forbid clauses is an `ast` forbid (yaml's form), so the generated forbid block is empty; each is a
// `violation` rule by hand, its `$option` pattern at the default case.
//
// Builtins (t17's catalogue): @rx_matches, @lower, @substr, @length, @sub (a − b), @concat, @instr, @printf, @within
// (tape), @glob (1 when a path matches a glob: `**` any run of segments, `*` within one segment), @class_prefix (tape:
// the `name` texts of a node's class_definition ancestors, outermost first, each followed by "."; "" with none).
// A builtin with no value (SQL NULL) binds nothing.
// fold: function_symbols' `group_concat` of the enclosing classes' names (ordered by start) is the tape builtin
// @class_prefix, the non-recursive ordered ancestor fold of E0 § 2.5 rows 1 and 34.
// findings layer (§8): a file.content regex forbid (lines.first) reports one witness per matching line, at its first
// match's span, which is no node; here one violation per document, at its module node.
// ties: nodes.ordinal = 0 (first child by start, end, kind), active_functions (last definition of a symbol by start),
// eager_anchors (first anchor by start, then end descending): exact ties keep every candidate.
.policy {"format": "rerail.policy/v1", "id": "data-layer-legacy-execution-surfaces", "revision": 1, "mode": "block", "description": "Candidate port of nera-data-layer legacy_execution_surfaces at 2b1504adc4291daaf080b2e932962b134da1a69a.", "scope": {"include": ["docs/**/*.py", "impl/common/l2070_server_plan/**/*.py", "impl/common/l5200_sql_query/**/*.py", "impl/common/l9700_sql_graph_query/**/*.py", "impl/mariadb/fts/**/*.py", "impl/postgres/fts/**/*.py", "impl/sqlite/fts/**/*.py", "l2050_transaction/**/*.py", "l4000_permissions/**/*.py", "l5200_vector_index/**/*.py", "l7200_versioned_transactions/**/*.py", "l8000_admin/tools/**/*.py", "l9900_auto_api/**/*.py", "reqs/**/*.py"], "exclude": ["**/.git/**", "**/.mypy_cache/**", "**/.pytest_cache/**", "**/.ruff_cache/**", "**/.venv/**", "**/__pycache__/**", "**/tmp/**", "**/tests/**", "**/test/**", "**/conform/**"]}, "clauses": [{"id": "shared", "define": {"options": {"oracleAnalyzer": {"type": "boolean", "default": false}, "entryPoint": {"type": "string", "default": "all"}}}}, {"id": "legacy-execution-graphs", "relational": "rdl", "violation": {"code": "architecture", "message": "Architecture contract violation", "anchor": "witness.span"}}, {"id": "post-fetch-filter_query_results", "forbid": "rdl", "violation": {"code": "LEG-071", "message": "SQL-facing post-fetch filter", "anchor": "witness.span"}}, {"id": "post-fetch-filter_query_results_async", "forbid": "rdl", "violation": {"code": "LEG-071", "message": "SQL-facing post-fetch filter", "anchor": "witness.span"}}, {"id": "graph-fallback-text", "forbid": "rdl", "violation": {"code": "LEG-061", "message": "Fallback grammar bridge", "anchor": "witness.span"}}, {"id": "inventory-export_cursor.py", "forbid": "rdl", "violation": {"code": "LEG-001", "message": "Legacy file outside inventory", "anchor": "witness.span"}}, {"id": "inventory-fts_searcher.py", "forbid": "rdl", "violation": {"code": "LEG-001", "message": "Legacy file outside inventory", "anchor": "witness.span"}}, {"id": "inventory-legacy_wrappers.py", "forbid": "rdl", "violation": {"code": "LEG-001", "message": "Legacy file outside inventory", "anchor": "witness.span"}}, {"id": "removed-read-leaves", "forbid": "rdl", "violation": {"code": "LEG-070", "message": "Removed SQL read leaf", "anchor": "witness.span"}}]}

.decl fdef(kind: symbol)
fdef("function_definition").
.decl cdef(kind: symbol)
cdef("class_definition").

// ---- forbid clauses ----
.decl violation(policy: symbol, clause: symbol, d: number, n: node)
.output violation
.decl forbid_include(clause: symbol, glob: symbol)
.decl forbid_exclude(clause: symbol, glob: symbol)
forbid_include("post-fetch-filter_query_results", "docs/**").
forbid_include("post-fetch-filter_query_results", "api/docs/**").
forbid_include("post-fetch-filter_query_results", "impl/common/l2070_server_plan/**").
forbid_include("post-fetch-filter_query_results", "api/impl/common/l2070_server_plan/**").
forbid_include("post-fetch-filter_query_results", "impl/common/l5200_sql_query/**").
forbid_include("post-fetch-filter_query_results", "api/impl/common/l5200_sql_query/**").
