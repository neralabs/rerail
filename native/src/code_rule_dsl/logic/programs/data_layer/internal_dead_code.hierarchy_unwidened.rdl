// expect: UnboundedLattice
// internal_dead_code.rdl's `hierarchy` without its `widen 64`. A best witness under shortlex is a min over routes, which
// has infinite descending chains in general, so the front end rejects the declaration. On the class graph the least
// route is a simple path, bounded by the number of classes: a bound in the data, which the declaration cannot state.
.decl class(id: sym)
.decl base_edges(owner: sym, base: sym, ordinal: int)
.input class, base_edges
.decl hierarchy(owner: sym, base: sym; route: sym) merge @shortlex_min
hierarchy($id, $id, "") :- class($id).
hierarchy($o, $b, $r) :- hierarchy($o, $x, $r0), base_edges($x, $b, $ord), $r = @concat($r0, @printf("%012d.", $ord)).
.output hierarchy
