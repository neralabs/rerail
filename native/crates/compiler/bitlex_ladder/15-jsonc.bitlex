# Step 15: JSON with comments, as tree-sitter-json parses it: step 14 and `//` and `/* */`
# comments, extras placed where tree-sitter places them.
#
# Every file step 14 accepts, this one accepts with the same nodes. A comment adds a leaf
# `comment` in the lowest node holding the tokens on either side.
#
# The string state is found without comments, as simdjson's; so a comment holding a quote, or
# one kind of comment holding the other's opener, goes to tree-sitter. Neither is in a file
# without comments.

lexer jsonc

# Two tiers, as simdjson's two stages: tier 1 over every byte (classes, the string state, each
# token's first and last byte, UTF-8, the errors a byte shows by itself); tier 2 over every
# token (kinds, keywords, the number check, nesting, keys).

# --- Byte classes --------------------------------------------------------------------------------

class quote     = '"'
class backslash = '\\'
class ws        = ' ' '\t' '\n' '\r'
class control   = 0x00..0x1f
# The structural bytes: one class, as simdjson's. Which one a token is, tier 2 reads.
class op        = '{' '}' '[' ']' ',' ':'
class digit     = '0'..'9'
class nonzero   = '1'..'9'
class expo      = 'e' 'E'
class hex       = '0'..'9' 'a'..'f' 'A'..'F'
class u         = 'u'
class dee       = 'd' 'D'
class high_2    = '8' '9' 'a' 'b' 'A' 'B'
class low_2     = 'c'..'f' 'C'..'F'
class slash     = '/'
class star      = '*'
class lf        = '\n'

# --- UTF-8, as simdjson's stage 1 checks it --------------------------------------------------------

class cont      = 0x80..0xbf
class lead2     = 0xc2..0xdf
class lead3     = 0xe0..0xef
class lead4     = 0xf0..0xf4
class never     = 0xc0 0xc1 0xf5..0xff
class e0        = 0xe0
class ed        = 0xed
class f0        = 0xf0
class f4        = 0xf4
class below_a0  = 0x80..0x9f
class from_a0   = 0xa0..0xbf
class below_90  = 0x80..0x8f
class from_90   = 0x90..0xbf

mask last_byte  = ~next(~empty)
# A UTF-8 byte order mark at the start of the file, which simdjson skips before its loop: the
# stream starts after it (decisions 0335, 0389), so no class, token or error has its bytes.
prefix 0xef 0xbb 0xbf

# simdjson's form (`lookup4`): every rule of two bytes is the byte before's class with this
# byte's, so the compiler makes them one lookup of each (decision 0404):
#   - a lead byte before a byte that is not a continuation (too short);
#   - a continuation after none of the lead bytes or continuations, or first (too long);
#   - the overlong and surrogate pairs, and the code points past 0x10ffff;
#   - two continuations in a row, exactly where a lead byte 2 or 3 bytes back needs a third or a
#     fourth (simdjson's `TWO_CONTS` against `must_be_2_3_continuation`).
class not_cont  = 0x00..0x7f 0xc0..0xff
class high      = 0x80..0xff
class lead      = 0xc0..0xff
class third     = 0xe0..0xff
class fourth    = 0xf0..0xff
error "invalid UTF-8" when never
                         | (prev(lead, 1) & not_cont) | (cont & ~prev(high, 1))
                         | (prev(e0, 1) & below_a0) | (prev(ed, 1) & from_a0)
                         | (prev(f0, 1) & below_90) | (prev(f4, 1) & from_90)
                         | ((prev(cont, 1) & cont) ^ (prev(third, 2) | prev(fourth, 3)))
error "UTF-8 cut short at the end" when ((lead2 | lead3 | lead4) & last_byte)
                                      | ((lead3 | lead4) & next(last_byte)) | (lead4 & next(last_byte, 2))

# --- Strings: simdjson's stage 1 -----------------------------------------------------------------

# In a run of backslashes, each one at an even offset escapes the byte after it.
mask escaped    = escaped(backslash)
mask q          = quote & ~escaped
mask inside     = toggle(q)                      # the opening quote, not the closing one
mask opening    = q & inside
mask closing    = q & ~inside
mask body       = inside & ~opening              # between the quotes
mask esc        = backslash & body & ~escaped    # an escape's backslash
mask esc_last   = escaped & body                 # the byte it escapes
mask content    = body & ~esc & ~esc_last
mask unicode    = esc_last & u

error "a control byte in a string" when body & control
# Each `\u`'s own test, at its `u`, of the bytes after it: tier 2 runs it at the escape's
# token, and tier 1 makes the `u`s only (decision 0399).
error "\\u without four hex digits" when unicode & ~(next(hex, 1) & next(hex, 2) & next(hex, 3) & next(hex, 4))
# A surrogate escape, at its `u`: `\uD800` to `\uDBFF` must be followed by one of `\uDC00` to
# `\uDFFF`, six bytes on, and that one must follow one (simdjson refuses either alone).
mask high       = unicode & next(dee, 1) & next(high_2, 2)
mask low        = unicode & next(dee, 1) & next(low_2, 2)
# After a high one's four hex digits, a backslash can only start an escape: its test is the
# bytes'.
error "a lone high surrogate" when high & ~(next(backslash, 5) & next(u, 6) & next(dee, 7) & next(low_2, 8))
error "a lone low surrogate" when low & ~prev(high, 6)

# --- Outside strings -----------------------------------------------------------------------------

mask outside    = ~inside & ~closing
# A line comment: from `//` up to, not including, the end of the line.
mask line       = fill(outside & slash & next(slash), lf)
# A block comment: from `/*` to the first `*/` after it, the opener's `*` not counted.
mask opener     = outside & slash & next(star)
mask closer     = star & next(slash) & ~prev(opener, 1)   # the closing `*`
mask block      = fill(opener, prev(closer, 2))
mask shut       = block & prev(closer, 1)                 # the closing `/`
mask comment    = line | block
mask code       = outside & ~comment
# Any other byte outside a string is in a word: a number or a literal, checked per token.
mask word       = code & ~ws & ~op & ~slash

# --- Tokens --------------------------------------------------------------------------------------

token '"'             = start q
token string_content  = start starts(content) last lasts(content)
token escape_sequence = start esc last esc_last
keywords escape_sequence {
  "\\\"" -> escape_sequence  "\\\\" -> escape_sequence  "\\/" -> escape_sequence
  "\\b" -> escape_sequence   "\\f" -> escape_sequence   "\\n" -> escape_sequence
  "\\r" -> escape_sequence   "\\t" -> escape_sequence   "\\u" -> escape_sequence
} required
# A comment starts at its opener, unless inside another comment of its kind; it ends at the
# end of its line, or at its closing `/`.
token comment         = start slash & (starts(line) | (opener & ~prev(block & ~shut, 1))) last lasts(line) | shut
token punctuation     = start code & op
keywords punctuation { "{"  "}"  "["  "]"  ","  ":" } required
# A run of word bytes is one token, as simdjson's stage 1 leaves it: a keyword, or a number,
# which tier 2 checks as simdjson's stage 2 parses one.
token number          = start starts(word) last lasts(word)
keywords number { "true" -> true  "false" -> false  "null" -> null }

skip code & ws

error "a slash outside a comment" when code & slash
error "an unclosed block comment" when block & ~shut & last_byte
escape "a quote in a comment" when comment & quote
escape "a comment opened in a comment" when (line & slash & next(star)) | (block & ~opener & slash & next(slash))

check number = ['-'] ('0' | nonzero digit*) ['.' digit+] [expo ['+' | '-'] digit+]

# --- The tree: tier 2, simdjson's stage 2, with tree-sitter-json's nodes -------------------------

tree json {
  extra comment
  node document               = value
  node object nested          = '{' [pair (',' pair)*] '}'
  node pair                   = key: string ':' value: value
  node array nested           = '[' [value (',' value)*] ']'
  node string                 = '"' (string_content | escape_sequence)* '"'
  choice value supertype _value = object | array | string | number | true | false | null
  # Named-only, as the engine's tapes: each token here is a delimiter its node implies, so it
  # makes no leaf. `true`, `false` and `null` are nodes of their own.
  implied object '{' ',' '}'
  implied pair ':'
  implied array '[' ',' ']'
  implied string '"'
}
