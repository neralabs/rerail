# Step 3: booleans separated by semicolons, `vrai; fausse; vrai`.
#
# New: a one-byte token, and a repetition in the tree.

lexer ladder03

class ws    = ' ' '\t' '\n' '\r'
class alpha = 'a'..'z'
class op    = ';'
mask code   = ~empty

token word = start starts(alpha) last lasts(alpha)
keywords word { "vrai" "fausse" } required
token punctuation = start code & op
keywords punctuation { ";" } required

skip ws
error "a byte no token takes" when ~ws & ~alpha & ~op

tree ladder {
  node document = booleen (';' booleen)*
  choice booleen = vrai | fausse
}
