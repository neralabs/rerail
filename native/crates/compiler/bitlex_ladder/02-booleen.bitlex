# Step 2: `vrai` or `fausse`.
#
# New: a choice of two keywords, so tier 2 switches on the token's first byte.

lexer ladder02

class ws    = ' ' '\t' '\n' '\r'
class alpha = 'a'..'z'

token word = start starts(alpha) last lasts(alpha)
keywords word { "vrai" "fausse" } required

skip ws
error "a byte no token takes" when ~ws & ~alpha

tree ladder {
  node document = booleen
  choice booleen = vrai | fausse
}
