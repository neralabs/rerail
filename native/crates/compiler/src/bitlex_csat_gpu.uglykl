// The prover's circuit solver on the device (decision 0670, step 3): CDCL over a batch of formulas, a SIMD group a
// formula, each read where it was built (`bitlex_grown`: its gates, fanout and plain clauses in the formula block,
// bound once as `blk`). The rules are the CPU's (`bitlex_csat::Solver`): each gate kind's propagation is unit
// propagation of its clauses, a reason is a gate and the argument it names (`why`), a conflict's first unique
// implication point is learned, the search jumps back to the clause's second-highest level. Its own:
// - **A round** takes the trail's next literals, up to a lane each. Lane 0 visits the clauses watching their
//   negations (a clause is watched as on the CPU: two literals, a node each, linked from a literal's head); then the
//   lanes check the literals' gates, a gate a lane, 32 at a time (`items`). A gate implies one literal, or (an `And`
//   true, a `One` held) each of its unset arguments in turn.
// - **What a step implies** goes on the trail in lane order: of the lanes that set one variable, the lowest
//   (`ukl_sg_match`); a slot by the rank among the winners. A variable two lanes set apart is set by the first; the
//   other's gate is checked again when the variable's turn comes, and meets the conflict then. So the answer and the
//   search do not depend on how the lanes are scheduled.
// - **Analysis, decisions** are lane 0's: the clause is learned into the formula's own arena (`D_LEARNED` clauses,
//   `D_ARENA` literals); past it the formula is unknown (sound). Decisions are the CPU's (`bitlex_sat::Order`): the
//   most active unset variable from a max-heap (activity, then the higher number), false first; a variable met in
//   analysis is bumped, and the bump grows by a twentieth a conflict. Activities are integers, the same on every
//   backend: past `BUMP_MAX` every one is shifted down `BUMP_SHIFT` bits (the order kept, old bumps decayed). (A queue in bump order, VMTF, made clauses 4 to
//   18 times as long on the CPU's hard formulas, and 3 to 7 times the conflicts.)
// - **Learned clauses are reduced** (`cs_reduce`) when they pass `H_REDUCE` or fill three quarters of the arena: the
//   search goes back to level 0, where no learned clause is a reason analysis reads, keeps those of at most
//   `KEEP_LBD` levels and the newer half, drops those level 0 satisfies, compacts the arena in order and watches every
//   clause again. Each clause's levels (LBD) are counted when it is learned.
// - **Every loop is bounded** (a heap walk by its depth, a watch list by its nodes, a gate's items by its width,
//   analysis by the trail): a fault ends the formula `BROKEN`, never a launch that does not end.
// - **Slots**: a SIMD group is a slot, which takes the batch's formulas from a queue one after another, its state
//   in the slot; the batch's memory is the slots' (see `csat_solve`).
// - **Launches are bounded**: a launch runs each slot `args.steps` steps (a round, a conflict, a decision) and
//   leaves its state; the host launches again while any formula runs.
//
// Memory: `blk` the formula block (u32 words); `table` `DESC` words a formula (its descriptor, below, in the block
// too); `state` the slots' states (`slot_words` each, a formula's `state_words` on the host); `out` 16 words a
// formula, once it is done: its status, conflicts, decisions, rounds, learned clauses and their literals; `models` a
// satisfiable formula's model; `queue` the slots' queue. A literal is DIMACS (`v` or
// `-v`, a variable from 1). A gate's record is 4 words: `kind | width << 2`, its output, and its arguments where at
// most two, else where in `D_ARGS` they begin.

#include <ukl/simd.h>

#define NONE 0xFFFFFFFFu
#define GATE 0x80000000u
#define FIXED 3u
#define SEEN 0x80000000u
#define LEVELS 0x1FFFFFFFu

// A formula's descriptor: word offsets in the block, counts.
#define D_VARS 0u
#define D_BASE 1u     // the window's gates: those `D_FSTARTS` / `D_FGATES` list
#define D_GATES 2u    // all its gates: past `D_BASE`, a solve's own (`D_OSTARTS` / `D_OGATES`, or NONE)
#define D_REC 3u
#define D_ARGS 4u
#define D_FSTARTS 5u
#define D_FGATES 6u
#define D_OSTARTS 7u
#define D_OGATES 8u
#define D_LITS 9u
#define D_ENDS 10u
#define D_CLAUSES 11u
#define D_MODEL 12u   // word offset of its model in `models`
#define D_LEARNED 13u
#define D_ARENA 14u
#define D_BUDGET 15u  // conflicts
#define D_FVARS 16u   // the variables `D_FSTARTS` covers (the window's)
#define D_WIDE 17u    // the widest gate's width and 2: a conflict's or an explanation's room
#define DESC 20u

// A state's header.
#define H_STATUS 0u
#define H_TRAIL 1u
#define H_HEAD 2u
#define H_LEVEL 3u
#define H_CONFLICTS 4u
#define H_LEARNED 5u
#define H_USED 6u
#define H_HEAP 7u     // the heap's size
#define H_STEPS 8u    // the steps it took
#define H_BUMP 10u    // the next bump

// The bumps: the first, and where every activity is scaled down (an activity stays below 21 bumps, in 32 bits).
#define BUMP_FIRST 1024u
#define BUMP_MAX (1u << 24)
#define BUMP_SHIFT 14u
#define H_CONFLICT 11u  // the conflict's clause: a clause's number, or NONE for `cbuf`'s
#define H_CLEN 12u      // `cbuf`'s length
#define H_DECISIONS 13u
#define H_ROUNDS 14u
#define H_FLAG 15u      // a round's conflict, from lane 0's clauses
#define H_VISITS 18u   // watch nodes visited
#define H_ITEMS 19u    // gate items checked
#define H_REDUCE 20u   // the learned clauses' count past which they are reduced
#define H_REDUCES 21u  // reductions made
#define H_LBD 22u      // the clause just learned: its levels
// The device's cycles by part, over 256 (`ukl_clock`, lane 0's; 0 where the backend has no clock): watch visits,
// gate items, analysis, jumps back, decisions, reductions.
#define H_T_VISIT 23u
#define H_T_ITEMS 24u
#define H_T_ANALYZE 25u
#define H_T_BACK 26u
#define H_T_DECIDE 27u
#define H_T_REDUCE 28u
#define H_T_START 29u
#define H_EXN 30u      // an explanation's length, from lane 0
#define H_EXID 31u     // and its clause's number

// Reductions: the first after `REDUCE_FIRST` learned clauses, each next `REDUCE_STEP` later; a clause of at most
// `KEEP_LBD` levels is kept.
#define REDUCE_FIRST 2000u
#define REDUCE_STEP 300u
// (Or when the clauses fill three quarters of the room, `D_LEARNED` or `D_ARENA`.)
#define KEEP_LBD 3u
// A formula's steps at most (a round, a conflict, a decision), past which it is unknown.
#define MAX_STEPS (1u << 24)
#define HEADER 32u

// Statuses.
#define RUNNING 0u
#define SAT 1u
#define UNSAT 2u
#define UNKNOWN 3u   // the conflicts' budget spent
#define ROOMLESS 4u  // the learned clauses' room full
#define BROKEN 5u    // a loop past its bound: the state is not what the solver keeps (a fault, which the host reports)

// What a gate's check found.
#define M_NONE 0u
#define M_ONE 1u   // one literal (`lit`, `why`)
#define M_AND 2u   // the output true: each unset argument
#define M_HELD 3u  // a `One`'s argument `why` held: each other unset argument false
#define M_CONFLICT 4u

typedef struct Args {
    uint32_t n;
    uint32_t steps;
    uint32_t init;
    uint32_t slots;
    uint32_t slot_words;
    uint32_t pad0;
    uint32_t pad1;
    uint32_t pad2;
} Args;
UKL_REFLECT_STRUCT(Args, n, steps, init, slots, slot_words, pad0, pad1, pad2)

typedef struct Csat {
    UKL_GLOBAL const uint32_t* b;
    UKL_GLOBAL uint32_t* s;
    uint32_t lane;
    uint32_t vars, fvars, base, gates, rec, args, fs, fg, os, og, lits, ends, clauses, lcap, acap, budget;
    // The state's arrays (word offsets in `s`).
    uint32_t wide;
    // `val`: a variable's word (below); `rw`: its reason and the argument that implied it (`why`), side by side.
    uint32_t val, rw, trail, limits, act, heap, hat, whead, wnext, wlit, lstart, arena, cbuf, ebuf, lmark, lbd, scratch;
} Csat;

typedef struct Check {
    uint32_t mode;
    int32_t lit;
    uint32_t why;
    uint32_t cursor;
} Check;

UKL_INLINE uint32_t cs_lvar(int32_t l) { return (uint32_t)(l < 0 ? -l : l); }
// A literal's watch list: the clauses watching it, visited when it turns false.
UKL_INLINE uint32_t cs_lslot(int32_t l) { return 2u * cs_lvar(l) + (l < 0 ? 1u : 0u); }

// A variable's word: 0 unset, else its level `<< 2`, 1 true or 2 false, and `SEEN` while analysis has marked it.
UKL_INLINE int32_t cs_value(UKL_PRIVATE Csat* c, int32_t l)
{
    uint32_t w = c->s[c->val + cs_lvar(l)];
    if (w == 0u)
        return 0;
    int32_t t = (w & 1u) != 0u ? 1 : -1;
    return l > 0 ? t : -t;
}
UKL_INLINE uint32_t cs_level_of(UKL_PRIVATE Csat* c, uint32_t v) { return (c->s[c->val + v] >> 2) & LEVELS; }

UKL_INLINE uint32_t cs_g_kind(UKL_PRIVATE Csat* c, uint32_t g) { return c->b[c->rec + 4u * g] & 3u; }
UKL_INLINE uint32_t cs_g_width(UKL_PRIVATE Csat* c, uint32_t g) { return c->b[c->rec + 4u * g] >> 2; }
UKL_INLINE int32_t cs_g_out(UKL_PRIVATE Csat* c, uint32_t g) { return (int32_t)c->b[c->rec + 4u * g + 1u]; }
UKL_INLINE int32_t cs_g_arg(UKL_PRIVATE Csat* c, uint32_t g, uint32_t n, uint32_t i)
{
    uint32_t r = c->rec + 4u * g;
    return n <= 2u ? (int32_t)c->b[r + 2u + i] : (int32_t)c->b[c->args + c->b[r + 2u] + i];
}

// A clause's literals: the formula's plain ones (below `clauses`), then its learned ones, in the arena.
UKL_INLINE uint32_t cs_cl_begin(UKL_PRIVATE Csat* c, uint32_t id)
{
    if (id < c->clauses)
        return id == 0u ? 0u : c->b[c->ends + id - 1u];
    return c->s[c->lstart + id - c->clauses];
}
UKL_INLINE uint32_t cs_cl_end(UKL_PRIVATE Csat* c, uint32_t id)
{
    return id < c->clauses ? c->b[c->ends + id] : c->s[c->lstart + id - c->clauses + 1u];
}
UKL_INLINE int32_t cs_cl_lit(UKL_PRIVATE Csat* c, uint32_t id, uint32_t k)
{
    return id < c->clauses ? (int32_t)c->b[c->lits + k] : (int32_t)c->s[c->arena + k];
}

// The trail's next slot (lane 0's, or a step's winners' by rank).
UKL_INLINE void cs_put(UKL_PRIVATE Csat* c, uint32_t at, int32_t l, uint32_t reason, uint32_t why)
{
    uint32_t v = cs_lvar(l);
    c->s[c->val + v] = (c->s[H_LEVEL] << 2) | (l > 0 ? 1u : 2u);
    c->s[c->rw + 2u * v] = reason;
    c->s[c->rw + 2u * v + 1u] = why;
    c->s[c->trail + at] = (uint32_t)l;
}
// Lane 0's: at the trail's end.
UKL_INLINE void cs_assign(UKL_PRIVATE Csat* c, int32_t l, uint32_t reason, uint32_t why)
{
    uint32_t at = c->s[H_TRAIL];
    cs_put(c, at, l, reason, why);
    c->s[H_TRAIL] = at + 1u;
}

// A literal at the end of `cbuf` (a conflict's clause) or `ebuf` (an explanation).
UKL_INLINE void cs_emit(UKL_PRIVATE Csat* c, uint32_t buf, UKL_PRIVATE uint32_t* n, int32_t l)
{
    c->s[buf + *n] = (uint32_t)l;
    *n = *n + 1u;
}

// Gate `g` checked against the values, as the CPU's `Solver::check`: what it implies, or a conflict, whose clause
// it writes to `cbuf` when `write`.
UKL_INLINE Check cs_check(UKL_PRIVATE Csat* c, uint32_t g, bool write)
{
    Check r;
    r.mode = M_NONE;
    r.lit = 0;
    r.why = 0u;
    r.cursor = 0u;
    uint32_t n = cs_g_width(c, g), kind = cs_g_kind(c, g), len = 0u;
    int32_t o = cs_g_out(c, g);
    if (kind == 0u) {
        // And.
        int32_t vo = cs_value(c, o);
        uint32_t unset = 0u, unset_at = 0u;
        for (uint32_t i = 0u; i < n; i++) {
            int32_t a = cs_g_arg(c, g, n, i);
            int32_t va = cs_value(c, a);
            if (va == -1) {
                if (vo == 1) {
                    r.mode = M_CONFLICT;
                    if (write) {
                        cs_emit(c, c->cbuf, &len, -o);
                        cs_emit(c, c->cbuf, &len, a);
                    }
                } else if (vo == 0) {
                    r.mode = M_ONE;
                    r.lit = -o;
                    r.why = i;
                }
                if (write)
                    c->s[H_CLEN] = len;
                return r;
            }
            if (va == 0) {
                if (unset == 0u) {
                    unset = 1u;
                    unset_at = i;
                } else if (a != cs_g_arg(c, g, n, unset_at)) {
                    unset++;
                }
            }
        }
        if (vo == 1) {
            if (unset > 0u)
                r.mode = M_AND;
        } else if (vo == 0 && unset == 0u) {
            r.mode = M_ONE;
            r.lit = o;
        } else if (vo == -1 && unset == 0u) {
            r.mode = M_CONFLICT;
            if (write) {
                cs_emit(c, c->cbuf, &len, o);
                for (uint32_t i = 0u; i < n; i++)
                    cs_emit(c, c->cbuf, &len, -cs_g_arg(c, g, n, i));
            }
        } else if (vo == -1 && unset == 1u) {
            r.mode = M_ONE;
            r.lit = -cs_g_arg(c, g, n, unset_at);
            r.why = unset_at;
        }
    } else if (kind == 1u) {
        // Xor.
        int32_t a = cs_g_arg(c, g, n, 0u), b = cs_g_arg(c, g, n, 1u);
        if (cs_lvar(a) == cs_lvar(b)) {
            int32_t want = a == b ? -o : o;
            int32_t vw = cs_value(c, want);
            if (vw == 0) {
                r.mode = M_ONE;
                r.lit = want;
                r.why = FIXED;
            } else if (vw == -1) {
                r.mode = M_CONFLICT;
                if (write)
                    cs_emit(c, c->cbuf, &len, want);
            }
        } else {
            int32_t p[3];
            p[0] = o;
            p[1] = a;
            p[2] = b;
            int32_t v0 = cs_value(c, o), v1 = cs_value(c, a), v2 = cs_value(c, b);
            uint32_t unset = (v0 == 0 ? 1u : 0u) + (v1 == 0 ? 1u : 0u) + (v2 == 0 ? 1u : 0u);
            bool t0 = v0 == 1, t1 = v1 == 1, t2 = v2 == 1;
            if (unset == 0u && t0 != (t1 != t2)) {
                r.mode = M_CONFLICT;
                if (write)
                    for (uint32_t k = 0u; k < 3u; k++)
                        cs_emit(c, c->cbuf, &len, cs_value(c, p[k]) == 1 ? -p[k] : p[k]);
            } else if (unset == 1u) {
                uint32_t k = v0 == 0 ? 0u : (v1 == 0 ? 1u : 2u);
                bool holds = k == 0u ? (t1 != t2) : (k == 1u ? (t0 != t2) : (t0 != t1));
                r.mode = M_ONE;
                r.lit = holds ? p[k] : -p[k];
                r.why = k;
            }
        }
    } else {
        // One.
        uint32_t held = NONE, unset = 0u, unset_at = 0u;
        for (uint32_t i = 0u; i < n; i++) {
            int32_t a = cs_g_arg(c, g, n, i);
            int32_t va = cs_value(c, a);
            if (va == 1) {
                if (held != NONE) {
                    r.mode = M_CONFLICT;
                    if (write) {
                        cs_emit(c, c->cbuf, &len, -cs_g_arg(c, g, n, held));
                        cs_emit(c, c->cbuf, &len, -a);
                        c->s[H_CLEN] = len;
                    }
                    return r;
                }
                held = i;
            } else if (va == 0) {
                unset++;
                unset_at = i;
            }
        }
        if (held != NONE) {
            if (unset > 0u) {
                r.mode = M_HELD;
                r.why = held;
            }
        } else if (unset == 0u) {
            r.mode = M_CONFLICT;
            if (write)
                for (uint32_t i = 0u; i < n; i++)
                    cs_emit(c, c->cbuf, &len, cs_g_arg(c, g, n, i));
        } else if (unset == 1u) {
            r.mode = M_ONE;
            r.lit = cs_g_arg(c, g, n, unset_at);
            r.why = unset_at;
        }
    }
    if (write)
        c->s[H_CLEN] = len;
    return r;
}

// Whether a gate can imply with nothing set.
UKL_INLINE bool cs_seed(UKL_PRIVATE Csat* c, uint32_t g)
{
    uint32_t n = cs_g_width(c, g), kind = cs_g_kind(c, g);
    if (kind == 0u)
        return n == 0u;
    if (kind == 2u)
        return n <= 1u;
    return cs_lvar(cs_g_arg(c, g, n, 0u)) == cs_lvar(cs_g_arg(c, g, n, 1u));
}

// The lanes' gates (`active`), checked: a conflict (the lowest lane's, its clause in `cbuf`), or what they imply on
// the trail. Every lane calls it. True on a conflict.
UKL_INLINE bool cs_items(UKL_PRIVATE Csat* c, uint32_t g, bool active __UKL_PARAMS)
{
    Check k;
    k.mode = M_NONE;
    if (active)
        k = cs_check(c, g, false);
    uint32_t first = ukl_sg_first(k.mode == M_CONFLICT __UKL_ARGS);
    if (first != UKL_NONE) {
        if (c->lane == first) {
            cs_check(c, g, true);
            c->s[H_CONFLICT] = NONE;
        }
        ukl_sg_barrier();
        return true;
    }
    uint32_t n = active ? cs_g_width(c, g) : 0u;
    bool once = k.mode == M_ONE;
    // A lane puts at most its gate's width and one more.
    uint32_t bound = ukl_sg_max(n __UKL_ARGS) + 2u;
    for (uint32_t step = 0u;; step++) {
        if (step > bound) {
            if (c->lane == 0u)
                c->s[H_STATUS] = BROKEN;
            ukl_sg_barrier();
            return true;
        }
        // This lane's next literal: its one, or the next unset argument.
        int32_t l = 0;
        uint32_t why = 0u;
        if (once) {
            l = k.lit;
            why = k.why;
            once = false;
            k.mode = M_NONE;
        } else if (k.mode == M_AND || k.mode == M_HELD) {
            while (k.cursor < n) {
                uint32_t i = k.cursor++;
                if (k.mode == M_HELD && i == k.why)
                    continue;
                int32_t a = cs_g_arg(c, g, n, i);
                if (cs_value(c, a) == 0) {
                    l = k.mode == M_AND ? a : -a;
                    why = k.mode == M_AND ? i : k.why;
                    break;
                }
            }
            if (l == 0)
                k.mode = M_NONE;
        }
        if (ukl_sg_ballot(l != 0 __UKL_ARGS) == 0u)
            return false;
        uint32_t v = l != 0 ? cs_lvar(l) : NONE - c->lane;
        ukl_mask_t same = ukl_sg_match(v __UKL_ARGS);
        bool win = l != 0 && ukl_mask_lowest(same) == c->lane && cs_value(c, l) == 0;
        ukl_mask_t wins = ukl_sg_ballot(win __UKL_ARGS);
        uint32_t at = c->s[H_TRAIL];
        ukl_sg_barrier();
        if (win)
            cs_put(c, at + ukl_mask_rank(wins, c->lane), l, GATE | g, why);
        ukl_sg_barrier();
        if (c->lane == 0u)
            c->s[H_TRAIL] = at + ukl_mask_count(wins);
        ukl_sg_barrier();
    }
}

// Every lane: the clauses watching `x`, which turned false. The group walks the list together (each lane reads the
// same node); a clause's literals are scanned by the lanes 32 at a time, the first in its order that is not `x`, not
// the other watch and not false taken, as a scan in order would. Lane 0 writes. True on a conflict (`H_CONFLICT`
// its clause).
UKL_INLINE bool cs_visit(UKL_PRIVATE Csat* c, int32_t x __UKL_PARAMS)
{
    uint32_t link = c->whead + cs_lslot(x);
    uint32_t k = c->s[link], nodes = 2u * (c->clauses + c->lcap);
    for (uint32_t seen = 0u; k != NONE; seen++) {
        if (seen > nodes) {
            if (c->lane == 0u)
                c->s[H_STATUS] = BROKEN;
            ukl_sg_barrier();
            return true;
        }
        uint32_t id = k >> 1, nk = c->s[c->wnext + k];
        int32_t other = (int32_t)c->s[c->wlit + (k ^ 1u)];
        int32_t vo = cs_value(c, other);
        if (c->lane == 0u)
            c->s[H_VISITS]++;
        if (vo == 1) {
            link = c->wnext + k;
            k = nk;
            continue;
        }
        int32_t y = 0;
        for (uint32_t j0 = cs_cl_begin(c, id), e = cs_cl_end(c, id); j0 < e && y == 0; j0 += UKL_SIMD_WIDTH) {
            uint32_t j = j0 + c->lane;
            int32_t q = j < e ? cs_cl_lit(c, id, j) : 0;
            bool can = q != 0 && q != x && q != other && cs_value(c, q) != -1;
            uint32_t first = ukl_sg_first(can __UKL_ARGS);
            if (first != UKL_NONE)
                y = (int32_t)ukl_sg_shuffle((uint32_t)q, first __UKL_ARGS);
        }
        if (y != 0) {
            if (c->lane == 0u) {
                c->s[link] = nk;
                c->s[c->wlit + k] = (uint32_t)y;
                c->s[c->wnext + k] = c->s[c->whead + cs_lslot(y)];
                c->s[c->whead + cs_lslot(y)] = k;
            }
            ukl_sg_barrier();
            k = nk;
            continue;
        }
        if (vo == 0) {
            if (c->lane == 0u)
                cs_assign(c, other, id, 0u);
            ukl_sg_barrier();
            link = c->wnext + k;
            k = nk;
            continue;
        }
        if (c->lane == 0u)
            c->s[H_CONFLICT] = id;
        ukl_sg_barrier();
        return true;
    }
    return false;
}

// Lane 0: clause `id` watched by its literals `a` and `b`.
UKL_INLINE void cs_watch(UKL_PRIVATE Csat* c, uint32_t id, int32_t a, int32_t b)
{
    uint32_t k = 2u * id;
    c->s[c->wlit + k] = (uint32_t)a;
    c->s[c->wnext + k] = c->s[c->whead + cs_lslot(a)];
    c->s[c->whead + cs_lslot(a)] = k;
    c->s[c->wlit + k + 1u] = (uint32_t)b;
    c->s[c->wnext + k + 1u] = c->s[c->whead + cs_lslot(b)];
    c->s[c->whead + cs_lslot(b)] = k + 1u;
}

// A variable's gates: the window's, then the solve's own.
UKL_INLINE uint32_t cs_fan_window(UKL_PRIVATE Csat* c, uint32_t v)
{
    return v <= c->fvars ? c->b[c->fs + v + 1u] - c->b[c->fs + v] : 0u;
}
UKL_INLINE uint32_t cs_fan_count(UKL_PRIVATE Csat* c, uint32_t v)
{
    uint32_t n = cs_fan_window(c, v);
    if (c->os != NONE)
        n += c->b[c->os + v + 1u] - c->b[c->os + v];
    return n;
}
UKL_INLINE uint32_t cs_fan_gate(UKL_PRIVATE Csat* c, uint32_t v, uint32_t k)
{
    uint32_t w = cs_fan_window(c, v);
    return k < w ? c->b[c->fg + c->b[c->fs + v] + k] : c->b[c->og + c->b[c->os + v] + k - w];
}

// A round: the trail's next literals, a lane each; their clauses (lane 0), then their gates. True on a conflict.
UKL_INLINE bool cs_round(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    uint64_t t_round = ukl_clock();
    uint32_t hd = c->s[H_HEAD], tl = c->s[H_TRAIL];
    uint32_t f = tl - hd < UKL_SIMD_WIDTH ? tl - hd : UKL_SIMD_WIDTH;
    // Each lane its literal; the group visits the watch lists that are not empty, in trail order.
    int32_t lit = c->lane < f ? (int32_t)c->s[c->trail + hd + c->lane] : 0;
    bool watched = lit != 0 && c->s[c->whead + cs_lslot(-lit)] != NONE;
    ukl_mask_t lists = ukl_sg_ballot(watched __UKL_ARGS);
    for (uint32_t i = 0u; i < f; i++)
        if (((lists >> i) & 1u) != 0u && cs_visit(c, -(int32_t)ukl_sg_shuffle((uint32_t)lit, i __UKL_ARGS) __UKL_ARGS))
            return true;
    uint64_t t_visited = ukl_clock();
    if (c->lane == 0u)
        c->s[H_T_VISIT] += (uint32_t)((t_visited - t_round) >> 8);
    uint32_t v = c->lane < f ? cs_lvar(lit) : 0u;
    if (ukl_sg_ballot(v > c->vars __UKL_ARGS) != 0u) {
        if (c->lane == 0u)
            c->s[H_STATUS] = BROKEN;
        ukl_sg_barrier();
        return true;
    }
    uint32_t mine = c->lane < f ? cs_fan_count(c, v) : 0u;
    uint32_t off = ukl_sg_exclusive_sum(mine, c->lane __UKL_ARGS);
    uint32_t total = ukl_sg_sum(mine __UKL_ARGS);
    if (c->lane == 0u)
        c->s[H_ITEMS] += total;
    for (uint32_t t0 = 0u; t0 < total; t0 += UKL_SIMD_WIDTH) {
        uint32_t t = t0 + c->lane;
        // The literal whose gates hold item `t`: the last lane whose first item is at or before it.
        uint32_t owner = 0u;
        for (uint32_t step = UKL_SIMD_WIDTH / 2u; step > 0u; step >>= 1) {
            uint32_t probe = owner + step;
            uint32_t at = ukl_sg_shuffle(off, probe < UKL_SIMD_WIDTH ? probe : 0u __UKL_ARGS);
            if (probe < f && at <= t)
                owner = probe;
        }
        uint32_t ov = ukl_sg_shuffle(v, owner __UKL_ARGS);
        uint32_t oo = ukl_sg_shuffle(off, owner __UKL_ARGS);
        bool active = t < total;
        uint32_t g = active ? cs_fan_gate(c, ov, t - oo) : 0u;
        if (cs_items(c, g, active __UKL_ARGS))
            return true;
    }
    if (c->lane == 0u) {
        c->s[H_HEAD] = hd + f;
        c->s[H_T_ITEMS] += (uint32_t)((ukl_clock() - t_visited) >> 8);
    }
    ukl_sg_barrier();
    return false;
}

// Lane 0: the decisions' heap (`bitlex_sat::Order`): `act` each variable's activity, `heap` the variables by it,
// `hat` each one's place there (NONE: out).
UKL_INLINE bool cs_before(UKL_PRIVATE Csat* c, uint32_t a, uint32_t b)
{
    uint32_t x = c->s[c->act + a], y = c->s[c->act + b];
    return x > y || (x == y && a > b);
}
UKL_INLINE void cs_down(UKL_PRIVATE Csat* c, uint32_t i)
{
    uint32_t v = c->s[c->heap + i], n = c->s[H_HEAP];
    for (uint32_t depth = 0u;; depth++) {
        if (depth > 32u) {
            c->s[H_STATUS] = BROKEN;
            return;
        }
        uint32_t k = 2u * i + 1u;
        if (k >= n)
            break;
        if (k + 1u < n && cs_before(c, c->s[c->heap + k + 1u], c->s[c->heap + k]))
            k++;
        uint32_t kv = c->s[c->heap + k];
        if (!cs_before(c, kv, v))
            break;
        c->s[c->heap + i] = kv;
        c->s[c->hat + kv] = i;
        i = k;
    }
    c->s[c->heap + i] = v;
    c->s[c->hat + v] = i;
}
// Every lane: heap entry `i` moved up (as a serial sift-up moves it), its path to the root read at once: lane `k` reads the
// ancestor `k + 1` levels up, the entry stops below the first it does not come before, and the ancestors below that
// move down a level each.
UKL_INLINE void cs_up_all(UKL_PRIVATE Csat* c, uint32_t i __UKL_PARAMS)
{
    uint32_t v = c->s[c->heap + i], k = c->lane + 1u;
    uint32_t up = k < 32u ? (i + 1u) >> k : 0u;
    bool exists = up >= 1u;
    uint32_t a = exists ? up - 1u : 0u, av = exists ? c->s[c->heap + a] : 0u;
    uint32_t stop = ukl_sg_first(!exists || !cs_before(c, v, av) __UKL_ARGS);
    ukl_sg_barrier();
    if (c->lane < stop) {
        // To the place one level down the path: the ancestor `lane` levels up (entry `i` itself at 0).
        uint32_t below = ((i + 1u) >> c->lane) - 1u;
        c->s[c->heap + below] = av;
        c->s[c->hat + av] = below;
    }
    if (c->lane == 0u) {
        uint32_t at = ((i + 1u) >> stop) - 1u;
        c->s[c->heap + at] = v;
        c->s[c->hat + v] = at;
    }
    ukl_sg_barrier();
}
// Every lane: `v` into the heap, if it is out.
UKL_INLINE void cs_insert_all(UKL_PRIVATE Csat* c, uint32_t v __UKL_PARAMS)
{
    if (c->s[c->hat + v] != NONE)
        return;
    uint32_t i = c->s[H_HEAP];
    ukl_sg_barrier();
    if (c->lane == 0u) {
        c->s[H_HEAP] = i + 1u;
        c->s[c->heap + i] = v;
        c->s[c->hat + v] = i;
    }
    ukl_sg_barrier();
    cs_up_all(c, i __UKL_ARGS);
}
// The most active variable, taken out (NONE: the heap is empty).
UKL_INLINE uint32_t cs_pop(UKL_PRIVATE Csat* c)
{
    uint32_t n = c->s[H_HEAP];
    if (n == 0u)
        return NONE;
    uint32_t top = c->s[c->heap];
    c->s[c->hat + top] = NONE;
    c->s[H_HEAP] = n - 1u;
    if (n > 1u) {
        c->s[c->heap] = c->s[c->heap + n - 1u];
        cs_down(c, 0u);
    }
    return top;
}
// Every lane: a variable's activity raised by the bump.
UKL_INLINE void cs_bump_all(UKL_PRIVATE Csat* c, uint32_t v __UKL_PARAMS)
{
    uint32_t at = c->s[c->hat + v];
    ukl_sg_barrier();
    if (c->lane == 0u)
        c->s[c->act + v] += c->s[H_BUMP];
    ukl_sg_barrier();
    if (at != NONE)
        cs_up_all(c, at __UKL_ARGS);
}

// Lane 0: the clause that implied `v`'s value, into `ebuf` (its literal first, every other false), or the number of
// the clause that did (`*id`).
UKL_INLINE uint32_t cs_explain(UKL_PRIVATE Csat* c, uint32_t v, UKL_PRIVATE uint32_t* id)
{
    uint32_t r = c->s[c->rw + 2u * v], w = c->s[c->rw + 2u * v + 1u], len = 0u;
    *id = NONE;
    if ((r & GATE) == 0u) {
        *id = r;
        return 0u;
    }
    int32_t l = (c->s[c->val + v] & 1u) != 0u ? (int32_t)v : -(int32_t)v;
    uint32_t g = r & ~GATE, n = cs_g_width(c, g), kind = cs_g_kind(c, g);
    int32_t o = cs_g_out(c, g);
    if (kind == 0u) {
        if (o != 0 && cs_lvar(o) == v) {
            if (l == o) {
                cs_emit(c, c->ebuf, &len, o);
                for (uint32_t i = 0u; i < n; i++)
                    cs_emit(c, c->ebuf, &len, -cs_g_arg(c, g, n, i));
            } else {
                cs_emit(c, c->ebuf, &len, -o);
                cs_emit(c, c->ebuf, &len, cs_g_arg(c, g, n, w));
            }
        } else if (l == cs_g_arg(c, g, n, w)) {
            cs_emit(c, c->ebuf, &len, l);
            cs_emit(c, c->ebuf, &len, -o);
        } else {
            cs_emit(c, c->ebuf, &len, l);
            cs_emit(c, c->ebuf, &len, o);
            for (uint32_t i = 0u; i < n; i++)
                if (i != w)
                    cs_emit(c, c->ebuf, &len, -cs_g_arg(c, g, n, i));
        }
    } else if (kind == 1u) {
        cs_emit(c, c->ebuf, &len, l);
        if (w != FIXED) {
            int32_t p[3];
            p[0] = o;
            p[1] = cs_g_arg(c, g, n, 0u);
            p[2] = cs_g_arg(c, g, n, 1u);
            for (uint32_t k = 0u; k < 3u; k++)
                if (k != w)
                    cs_emit(c, c->ebuf, &len, cs_value(c, p[k]) == 1 ? -p[k] : p[k]);
        }
    } else {
        if (l == cs_g_arg(c, g, n, w)) {
            cs_emit(c, c->ebuf, &len, l);
            for (uint32_t i = 0u; i < n; i++)
                if (i != w)
                    cs_emit(c, c->ebuf, &len, cs_g_arg(c, g, n, i));
        } else {
            cs_emit(c, c->ebuf, &len, l);
            cs_emit(c, c->ebuf, &len, -cs_g_arg(c, g, n, w));
        }
    }
    return len;
}

// Every lane: the conflict's first unique implication point, learned at the arena's end (its asserting literal
// first, the highest of the rest second); its length, or 0 where the room is full. `*back`: the level to jump back
// to. As a serial analysis: a clause's literals are filtered by the lanes 32 at a time (a variable's first in the
// clause's order taken), and lane 0 bumps them in that order; the trail is searched back 32 entries at a time.
UKL_INLINE uint32_t cs_analyze(UKL_PRIVATE Csat* c, UKL_PRIVATE uint32_t* back __UKL_PARAMS)
{
    uint32_t here = c->s[H_LEVEL], u = c->s[H_USED], len = 1u, count = 0u, at = c->s[H_TRAIL];
    if (c->s[H_LEARNED] >= c->lcap || u >= c->acap)
        return 0u;
    // The clause read: a numbered one (`id`), or `cbuf`'s or `ebuf`'s literals.
    uint32_t id = c->s[H_CONFLICT], buf = c->cbuf, n = c->s[H_CLEN];
    int32_t p = 0;
    for (;;) {
        uint32_t j0 = id != NONE ? cs_cl_begin(c, id) : 0u, j1 = id != NONE ? cs_cl_end(c, id) : n;
        for (uint32_t jb = j0; jb < j1; jb += UKL_SIMD_WIDTH) {
            uint32_t j = jb + c->lane;
            int32_t q = j < j1 ? (id != NONE ? cs_cl_lit(c, id, j) : (int32_t)c->s[buf + j]) : 0;
            uint32_t v = q != 0 ? cs_lvar(q) : 0u;
            uint32_t lv = q != 0 ? cs_level_of(c, v) : 0u;
            bool can = q != 0 && q != p && lv != 0u && (c->s[c->val + v] & SEEN) == 0u;
            ukl_mask_t same = ukl_sg_match(can ? v : NONE - c->lane __UKL_ARGS);
            can = can && ukl_mask_lowest(same) == c->lane;
            ukl_mask_t cands = ukl_sg_ballot(can __UKL_ARGS);
            ukl_mask_t lows = ukl_sg_ballot(can && lv != here __UKL_ARGS);
            uint32_t pushes = ukl_mask_count(lows);
            if (u + len + pushes > c->acap)
                return 0u;
            if (can) {
                c->s[c->val + v] |= SEEN;
                c->s[c->scratch + ukl_mask_rank(cands, c->lane)] = v;
                if (lv != here)
                    c->s[c->arena + u + len + ukl_mask_rank(lows, c->lane)] = (uint32_t)q;
            }
            count += ukl_mask_count(cands) - pushes;
            len += pushes;
            ukl_sg_barrier();
            for (uint32_t k = 0u, e = ukl_mask_count(cands); k < e; k++)
                cs_bump_all(c, c->s[c->scratch + k] __UKL_ARGS);
        }
        // The trail's last marked entry below `at`: 32 entries at a time.
        for (;;) {
            if (at == 0u || count == 0u) {
                if (c->lane == 0u)
                    c->s[H_STATUS] = BROKEN;
                ukl_sg_barrier();
                return 0u;
            }
            uint32_t lo = at > UKL_SIMD_WIDTH ? at - UKL_SIMD_WIDTH : 0u, i = lo + c->lane;
            bool hit = i < at && (c->s[c->val + cs_lvar((int32_t)c->s[c->trail + i])] & SEEN) != 0u;
            ukl_mask_t m = ukl_sg_ballot(hit __UKL_ARGS);
            if (m != 0u) {
                at = lo + 63u - ukl_clz64((uint64_t)m);
                break;
            }
            at = lo;
        }
        int32_t l = (int32_t)c->s[c->trail + at];
        ukl_sg_barrier();
        count--;
        if (c->lane == 0u) {
            c->s[c->val + cs_lvar(l)] &= ~SEEN;
            if (count == 0u) {
                c->s[c->arena + u] = (uint32_t)(-l);
            } else {
                uint32_t eid = NONE;
                c->s[H_EXN] = cs_explain(c, cs_lvar(l), &eid);
                c->s[H_EXID] = eid;
            }
        }
        ukl_sg_barrier();
        if (count == 0u)
            break;
        p = l;
        n = c->s[H_EXN];
        id = c->s[H_EXID];
        buf = c->ebuf;
        ukl_sg_barrier();
    }
    // The rest unmarked; the highest level's first literal second; the levels counted (LBD), each marked with this
    // conflict's number.
    uint32_t hi = 0u, hk = 1u, mark = c->s[H_CONFLICTS], lbd = 1u;
    if (c->lane == 0u)
        c->s[c->lmark + here] = mark;
    ukl_sg_barrier();
    for (uint32_t kb = 1u; kb < len; kb += UKL_SIMD_WIDTH) {
        uint32_t k = kb + c->lane, lv = 0u;
        if (k < len) {
            uint32_t v = cs_lvar((int32_t)c->s[c->arena + u + k]);
            c->s[c->val + v] &= ~SEEN;
            lv = cs_level_of(c, v);
        }
        uint32_t top = ukl_sg_max(lv __UKL_ARGS);
        uint32_t at_top = ukl_sg_first(k < len && lv == top __UKL_ARGS);
        if (top > hi) {
            hi = top;
            hk = kb + at_top;
        }
        bool fresh = k < len && c->s[c->lmark + lv] != mark;
        ukl_mask_t same = ukl_sg_match(fresh ? lv : NONE - c->lane __UKL_ARGS);
        fresh = fresh && ukl_mask_lowest(same) == c->lane;
        lbd += ukl_sg_count(fresh __UKL_ARGS);
        ukl_sg_barrier();
        if (fresh)
            c->s[c->lmark + lv] = mark;
        ukl_sg_barrier();
    }
    if (c->lane == 0u) {
        if (len > 1u) {
            uint32_t t = c->s[c->arena + u + 1u];
            c->s[c->arena + u + 1u] = c->s[c->arena + u + hk];
            c->s[c->arena + u + hk] = t;
        }
        c->s[H_BUMP] += c->s[H_BUMP] / 20u;
        c->s[H_LBD] = lbd;
    }
    ukl_sg_barrier();
    *back = hi;
    return len;
}

// Every lane: the trail back to level `to`, its variables unset; those out of the heap (decided, or met set at a
// decision) put back, in trail order.
UKL_INLINE void cs_back_to(UKL_PRIVATE Csat* c, uint32_t to __UKL_PARAMS)
{
    uint32_t start = c->s[c->limits + to], tl = c->s[H_TRAIL];
    for (uint32_t i0 = start; i0 < tl; i0 += UKL_SIMD_WIDTH) {
        uint32_t i = i0 + c->lane;
        uint32_t v = i < tl ? cs_lvar((int32_t)c->s[c->trail + i]) : 0u;
        bool out = i < tl && c->s[c->hat + v] == NONE;
        if (i < tl)
            c->s[c->val + v] = 0u;
        ukl_mask_t outs = ukl_sg_ballot(out __UKL_ARGS);
        ukl_sg_barrier();
        for (uint32_t k = 0u; k < UKL_SIMD_WIDTH; k++)
            if (((outs >> k) & 1u) != 0u)
                cs_insert_all(c, ukl_sg_shuffle(v, k __UKL_ARGS) __UKL_ARGS);
    }
    if (c->lane == 0u) {
        c->s[H_TRAIL] = start;
        c->s[H_HEAD] = start;
        c->s[H_LEVEL] = to;
    }
    ukl_sg_barrier();
}

UKL_INLINE void cs_finish(UKL_PRIVATE Csat* c, uint32_t status)
{
    if (c->lane == 0u && c->s[H_STATUS] != BROKEN)
        c->s[H_STATUS] = status;
    ukl_sg_barrier();
}

// Every lane: a conflict met at a level past 0: learned, jumped back, its literal asserted.
UKL_INLINE void cs_conflict(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    if (c->s[H_STATUS] != RUNNING)
        return;
    if (c->s[H_LEVEL] == 0u) {
        cs_finish(c, UNSAT);
        return;
    }
    if (c->s[H_CONFLICTS] >= c->budget) {
        cs_finish(c, UNKNOWN);
        return;
    }
    uint32_t back = 0u, len = 0u;
    if (c->lane == 0u)
        c->s[H_CONFLICTS]++;
    ukl_sg_barrier();
    uint64_t t_an = ukl_clock();
    len = cs_analyze(c, &back __UKL_ARGS);
    if (c->lane == 0u)
        c->s[H_T_ANALYZE] += (uint32_t)((ukl_clock() - t_an) >> 8);
    // Past `BUMP_MAX`: every activity scaled down alike, across the lanes.
    if (c->s[H_BUMP] > BUMP_MAX) {
        for (uint32_t v = c->lane; v <= c->vars; v += UKL_SIMD_WIDTH)
            c->s[c->act + v] >>= BUMP_SHIFT;
        ukl_sg_barrier();
        if (c->lane == 0u)
            c->s[H_BUMP] >>= BUMP_SHIFT;
    }
    ukl_sg_barrier();
    if (len == 0u) {
        cs_finish(c, ROOMLESS);
        return;
    }
    uint64_t t_back = ukl_clock();
    cs_back_to(c, back __UKL_ARGS);
    if (c->lane == 0u)
        c->s[H_T_BACK] += (uint32_t)((ukl_clock() - t_back) >> 8);
    if (c->lane == 0u) {
        uint32_t u = c->s[H_USED];
        int32_t first = (int32_t)c->s[c->arena + u];
        if (len == 1u) {
            cs_assign(c, first, NONE, 0u);
        } else {
            uint32_t j = c->s[H_LEARNED], id = c->clauses + j;
            c->s[c->lstart + j] = u;
            c->s[c->lstart + j + 1u] = u + len;
            c->s[c->lbd + j] = c->s[H_LBD];
            c->s[H_USED] = u + len;
            c->s[H_LEARNED] = j + 1u;
            cs_watch(c, id, first, (int32_t)c->s[c->arena + u + 1u]);
            cs_assign(c, first, id, 0u);
        }
    }
    ukl_sg_barrier();
}

// Every lane: the learned clauses reduced, at level 0 (above). False where a clause is now false at level 0 (the
// formula unsatisfiable).
UKL_INLINE bool cs_reduce(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    // At level 0 already, its trail is all level 0's (`limits` holds an older level 1's start).
    if (c->s[H_LEVEL] > 0u)
        cs_back_to(c, 0u __UKL_ARGS);
    uint32_t slots = 2u * (c->vars + 1u);
    for (uint32_t k = c->lane; k < slots; k += UKL_SIMD_WIDTH)
        c->s[c->whead + k] = NONE;
    ukl_sg_barrier();
    bool ok = true;
    if (c->lane == 0u) {
        // Level 0's values: none rests on a learned clause past here (analysis never reads level 0).
        uint32_t tl = c->s[H_TRAIL];
        for (uint32_t i = 0u; i < tl; i++) {
            uint32_t v = cs_lvar((int32_t)c->s[c->trail + i]);
            uint32_t r = c->s[c->rw + 2u * v];
            if ((r & GATE) == 0u && r != NONE && r >= c->clauses)
                c->s[c->rw + 2u * v] = NONE;
        }
        // Kept: the short (by levels) and the newer half, newest first while they fit in half the arena; dropped: those
        // level 0 satisfies. Marked (the LBD's top bit), then compacted in order.
        uint32_t n = c->s[H_LEARNED], kept = 0u, used = 0u, room = c->acap / 2u;
        for (uint32_t j = n; j > 0u; j--) {
            uint32_t i = j - 1u, b = c->s[c->lstart + i], e = c->s[c->lstart + i + 1u];
            bool sat = false;
            for (uint32_t k = b; k < e && !sat; k++)
                sat = cs_value(c, (int32_t)c->s[c->arena + k]) == 1;
            bool want = !sat && (c->s[c->lbd + i] <= KEEP_LBD || 2u * i >= n);
            if (want && used + (e - b) <= room) {
                used += e - b;
                c->s[c->lbd + i] |= 0x80000000u;
            }
        }
        used = 0u;
        for (uint32_t j = 0u; j < n; j++) {
            uint32_t b = c->s[c->lstart + j], e = c->s[c->lstart + j + 1u], lbd = c->s[c->lbd + j];
            if ((lbd & 0x80000000u) == 0u)
                continue;
            for (uint32_t k = b; k < e; k++)
                c->s[c->arena + used + k - b] = c->s[c->arena + k];
            c->s[c->lstart + kept] = used;
            c->s[c->lbd + kept] = lbd & 0x7FFFFFFFu;
            used += e - b;
            kept++;
            c->s[c->lstart + kept] = used;
        }
        c->s[c->lstart + kept] = used;
        c->s[H_LEARNED] = kept;
        c->s[H_USED] = used;
        c->s[H_REDUCE] = kept + REDUCE_FIRST + REDUCE_STEP * (c->s[H_REDUCES] + 1u);
        c->s[H_REDUCES]++;
        // Every clause watched again by two literals not false; one level 0 satisfies left out; one with a single
        // such literal implies it; with none, the formula is unsatisfiable.
        uint32_t all = c->clauses + kept;
        for (uint32_t id = 0u; id < all && ok; id++) {
            int32_t a = 0, b = 0;
            bool sat = false;
            for (uint32_t k = cs_cl_begin(c, id), e = cs_cl_end(c, id); k < e && !sat; k++) {
                int32_t q = cs_cl_lit(c, id, k);
                int32_t vq = cs_value(c, q);
                if (vq == 1)
                    sat = true;
                else if (vq == 0 && a == 0)
                    a = q;
                else if (vq == 0 && b == 0 && q != a)
                    b = q;
            }
            if (sat)
                continue;
            if (a == 0)
                ok = false;
            else if (b == 0)
                cs_assign(c, a, id, 0u);
            else
                cs_watch(c, id, a, b);
        }
        c->s[H_FLAG] = ok ? 1u : 0u;
    }
    ukl_sg_barrier();
    ok = c->s[H_FLAG] != 0u;
    ukl_sg_barrier();
    return ok;
}

// Lane 0's decision: the most active unset variable, false; none left, the formula holds.
UKL_INLINE void cs_decide(UKL_PRIVATE Csat* c)
{
    if (c->lane == 0u && c->s[H_HEAP] > c->vars)
        c->s[H_STATUS] = BROKEN;
    if (c->lane == 0u && c->s[H_STATUS] == RUNNING) {
        uint32_t v = cs_pop(c);
        while (v != NONE && c->s[c->val + v] != 0u)
            v = cs_pop(c);
        if (v == NONE) {
            c->s[H_STATUS] = SAT;
        } else if (c->budget == 0u) {
            // No conflict to spend: propagation at level 0 alone (the prover's rounds, decision 0654).
            c->s[H_STATUS] = UNKNOWN;
        } else {
            uint32_t lv = c->s[H_LEVEL];
            c->s[c->limits + lv] = c->s[H_TRAIL];
            c->s[H_LEVEL] = lv + 1u;
            c->s[H_DECISIONS]++;
            cs_assign(c, -(int32_t)v, NONE, 0u);
        }
    }
    ukl_sg_barrier();
}

// Every lane: the state laid out, the plain clauses watched (their units set), the gates that imply with nothing set
// checked. False where that met a contradiction.
UKL_INLINE void cs_start(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    uint32_t n = c->vars + 1u;
    for (uint32_t v = c->lane; v < n; v += UKL_SIMD_WIDTH) {
        c->s[c->val + v] = 0u;
        c->s[c->lmark + v] = 0u;
        // Every activity 0: the heap is the numbers, highest first.
        c->s[c->act + v] = 0u;
        c->s[c->hat + v] = v == 0u ? NONE : c->vars - v;
        if (v < c->vars)
            c->s[c->heap + v] = c->vars - v;
        c->s[c->whead + 2u * v] = NONE;
        c->s[c->whead + 2u * v + 1u] = NONE;
    }
    if (c->lane == 0u) {
        for (uint32_t h = 0u; h < HEADER; h++)
            c->s[h] = 0u;
        c->s[H_HEAP] = c->vars;
        c->s[H_REDUCE] = REDUCE_FIRST;
        c->s[H_BUMP] = BUMP_FIRST;
    }
    ukl_sg_barrier();
    if (c->lane == 0u) {
        // The plain clauses, as the CPU's `add`: a tautology dropped, a unit set, the rest watched by their first two
        // literals apart.
        for (uint32_t id = 0u; id < c->clauses && c->s[H_STATUS] == RUNNING; id++) {
            uint32_t b0 = cs_cl_begin(c, id), e = cs_cl_end(c, id);
            bool taut = false;
            int32_t a = 0, b = 0;
            for (uint32_t j = b0; j < e && !taut; j++) {
                int32_t q = cs_cl_lit(c, id, j);
                for (uint32_t k = j + 1u; k < e; k++)
                    if (cs_cl_lit(c, id, k) == -q)
                        taut = true;
                if (a == 0)
                    a = q;
                else if (b == 0 && q != a)
                    b = q;
            }
            if (taut)
                continue;
            if (a == 0) {
                c->s[H_STATUS] = UNSAT;
            } else if (b == 0) {
                int32_t va = cs_value(c, a);
                if (va == -1)
                    c->s[H_STATUS] = UNSAT;
                else if (va == 0)
                    cs_assign(c, a, NONE, 0u);
            } else {
                cs_watch(c, id, a, b);
            }
        }
    }
    ukl_sg_barrier();
    if (c->s[H_STATUS] != RUNNING)
        return;
    for (uint32_t g0 = 0u; g0 < c->gates; g0 += UKL_SIMD_WIDTH) {
        uint32_t g = g0 + c->lane;
        bool active = g < c->gates && cs_seed(c, g);
        if (ukl_sg_ballot(active __UKL_ARGS) == 0u)
            continue;
        if (cs_items(c, g, active __UKL_ARGS)) {
            cs_finish(c, UNSAT);
            return;
        }
    }
}

// A formula's state laid out in its slot, from its descriptor.
UKL_INLINE void cs_setup(UKL_PRIVATE Csat* c, UKL_GLOBAL const uint32_t* d)
{
    c->vars = d[D_VARS];
    c->fvars = d[D_FVARS];
    c->base = d[D_BASE];
    c->gates = d[D_GATES];
    c->rec = d[D_REC];
    c->args = d[D_ARGS];
    c->fs = d[D_FSTARTS];
    c->fg = d[D_FGATES];
    c->os = d[D_OSTARTS];
    c->og = d[D_OGATES];
    c->lits = d[D_LITS];
    c->ends = d[D_ENDS];
    c->clauses = d[D_CLAUSES];
    c->lcap = d[D_LEARNED];
    c->acap = d[D_ARENA];
    c->budget = d[D_BUDGET];
    c->wide = d[D_WIDE];
    uint32_t n = c->vars + 1u, nodes = 2u * (c->clauses + c->lcap);
    // What every step reads first, the learned clauses' room last: a search touches the room's pages only as it
    // fills them. (`state_words` on the host.)
    c->val = HEADER;
    c->rw = c->val + n;
    c->trail = c->rw + 2u * n;
    c->limits = c->trail + n;
    c->act = c->limits + n;
    c->heap = c->act + n;
    c->hat = c->heap + n;
    c->lmark = c->hat + n;
    c->whead = c->lmark + n;
    c->cbuf = c->whead + 2u * n;
    c->ebuf = c->cbuf + c->wide;
    c->scratch = c->ebuf + c->wide;
    c->lbd = c->scratch + UKL_SIMD_WIDTH;
    c->lstart = c->lbd + c->lcap;
    c->wnext = c->lstart + c->lcap + 1u;
    c->wlit = c->wnext + nodes;
    c->arena = c->wlit + nodes;
}

// Every lane: a finished formula's report (`out`, 16 words) and, satisfiable, its model (`models`, a bit a variable).
UKL_INLINE void cs_report(UKL_PRIVATE Csat* c, UKL_GLOBAL uint32_t* o, UKL_GLOBAL uint32_t* model __UKL_PARAMS)
{
    if (c->s[H_STATUS] == SAT)
        for (uint32_t v0 = 0u; v0 <= c->vars; v0 += UKL_SIMD_WIDTH) {
            uint32_t v = v0 + c->lane;
            ukl_mask_t m = ukl_sg_ballot(v <= c->vars && (c->s[c->val + v] & 1u) != 0u __UKL_ARGS);
            if (c->lane == 0u)
                model[v0 / 32u] = (uint32_t)m;
        }
    if (c->lane == 0u) {
        for (uint32_t k = 1u; k < 16u; k++)
            o[k] = 0u;
        o[1] = c->s[H_CONFLICTS];
        o[2] = c->s[H_DECISIONS];
        o[3] = c->s[H_ROUNDS];
        o[4] = c->s[H_LEARNED];
        o[5] = c->s[H_USED];
        o[6] = c->s[H_VISITS];
        o[7] = c->s[H_ITEMS];
        o[8] = c->s[H_REDUCES];
        for (uint32_t k = 0u; k < 6u; k++)
            o[9u + k] = c->s[H_T_VISIT + k];
        // The status last: the host reads a formula's report once it is set.
        ukl_fence_device();
        o[0] = c->s[H_STATUS];
    }
    ukl_sg_barrier();
}

// A slot (a SIMD group) solves the batch's formulas one after another, each taken from the queue (`queue[0]`, the
// next formula's number) when its last one is done; `queue[1 + slot]` its formula, or NONE. A formula's state is in
// its slot, so a batch's memory is the slots', not the formulas': as many slots as the device keeps running at once,
// each a search whose memory reads the others' hide. A launch runs a slot `args.steps` steps at most; a formula is
// unknown past `MAX_STEPS` of its own (`bitlex_csat_lanes::STEPS`). The first launch (`args.init`) clears the
// reports and the queue.
DEFINE_KERNEL2(prover, csat_solve,
               ARGS,     Args,     args,   ,
               ROBUFFER, uint32_t, blk,    "[block]",
               ROBUFFER, uint32_t, table,  "[n * 20]",
               RWBUFFER, uint32_t, state,  "[slots * slot_words]",
               RWBUFFER, uint32_t, out,    "[n * 16]",
               RWBUFFER, uint32_t, models, "[model words]",
               RWBUFFER, uint32_t, queue,  "[1 + slots]",
               TGID0,    uint32_t, slot,   ,
               LANE,     uint32_t, lane,   )
{
    if (args.init != 0u) {
        for (uint32_t i = slot * UKL_SIMD_WIDTH + lane; i < args.n; i += args.slots * UKL_SIMD_WIDTH)
            out[i * 16u] = RUNNING;
        if (lane == 0u)
            queue[1u + slot] = NONE;
        if (slot == 0u && lane == 0u)
            queue[0] = 0u;
        return;
    }
    Csat cs;
    UKL_PRIVATE Csat* c = &cs;
    c->b = blk;
    c->s = state + slot * args.slot_words;
    c->lane = lane;
    uint32_t steps = 0u;
    while (steps < args.steps) {
        uint32_t f = queue[1u + slot];
        ukl_sg_barrier();
        if (f == NONE) {
            uint32_t got = 0u;
            if (lane == 0u)
                got = ukl_atomic_add(queue, 1u);
            f = ukl_sg_shuffle(got, 0u __UKL_ARGS);
            if (f >= args.n)
                return;
            if (lane == 0u)
                queue[1u + slot] = f;
            cs_setup(c, table + f * DESC);
            cs_start(c __UKL_ARGS);
            steps++;
        } else {
            cs_setup(c, table + f * DESC);
        }
        uint32_t n = c->vars + 1u;
        while (steps < args.steps && c->s[H_STATUS] == RUNNING) {
            if (c->s[H_STEPS] >= MAX_STEPS) {
                cs_finish(c, UNKNOWN);
                break;
            }
            steps++;
            if (lane == 0u)
                c->s[H_STEPS]++;
            ukl_sg_barrier();
            // The trail within its room: past it, every loop over it would be unbounded.
            if (c->s[H_TRAIL] > n || c->s[H_HEAD] > c->s[H_TRAIL] || c->s[H_LEVEL] >= n) {
                cs_finish(c, BROKEN);
                break;
            }
            if (c->s[H_HEAD] == c->s[H_TRAIL]) {
                if (c->s[H_LEARNED] >= c->s[H_REDUCE] || 4u * c->s[H_LEARNED] >= 3u * c->lcap || 4u * c->s[H_USED] >= 3u * c->acap) {
                    uint64_t t_r = ukl_clock();
                    if (!cs_reduce(c __UKL_ARGS))
                        cs_finish(c, UNSAT);
                    if (lane == 0u)
                        c->s[H_T_REDUCE] += (uint32_t)((ukl_clock() - t_r) >> 8);
                    continue;
                }
                uint64_t t_d = ukl_clock();
                cs_decide(c);
                if (lane == 0u)
                    c->s[H_T_DECIDE] += (uint32_t)((ukl_clock() - t_d) >> 8);
                continue;
            }
            if (lane == 0u)
                c->s[H_ROUNDS]++;
            if (cs_round(c __UKL_ARGS))
                cs_conflict(c __UKL_ARGS);
        }
        ukl_sg_barrier();
        if (c->s[H_STATUS] == RUNNING)
            return;
        UKL_GLOBAL const uint32_t* d = table + f * DESC;
        cs_report(c, out + f * 16u, models + d[D_MODEL] __UKL_ARGS);
        if (lane == 0u)
            queue[1u + slot] = NONE;
        ukl_sg_barrier();
    }
}
