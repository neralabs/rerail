// The prover's circuit solver on the device (decision 0670, step 3): CDCL over a batch of formulas, a SIMD group a
// formula, each read where it was built (`bitlex_grown`: its gates, fanout and plain clauses in the formula block,
// bound once as `blk`). The rules are the CPU's (`bitlex_csat::Solver`): each gate kind's propagation is unit
// propagation of its clauses, a reason is a gate and the argument it names (`why`), a conflict's first unique
// implication point is learned, the search jumps back to the clause's second-highest level. Its own:
// - **A round** takes the trail's next literals, up to a lane each. Lane 0 visits the clauses watching their
//   negations (a clause is watched as on the CPU: two literals, a node each, linked from a literal's head); then the
//   lanes check the literals' gates, a gate a lane, 32 at a time (`items`). A gate implies one literal, or (an `And`
//   true, a `One` held) each of its unset arguments in turn.
// - **What a step implies** goes on the trail in lane order: of the lanes that set one variable, the lowest
//   (`ukl_sg_match`); a slot by the rank among the winners. A variable two lanes set apart is set by the first; the
//   other's gate is checked again when the variable's turn comes, and meets the conflict then. So the answer and the
//   search do not depend on how the lanes are scheduled.
// - **Analysis, decisions** are lane 0's: the clause is learned into the formula's own arena (`D_LEARNED` clauses,
//   `D_ARENA` literals); past it the formula is unknown (sound). Decisions are the CPU's (`bitlex_sat::Order`): the
//   most active unset variable (activity, then the higher number), false first, from a tree of 32-way maxima
//   (`cs_top`); a variable met in analysis is bumped, and the bump grows by a twentieth a conflict. Activities are integers, the same on every
//   backend: past `BUMP_MAX` every one is shifted down `BUMP_SHIFT` bits (the order kept, old bumps decayed). (A queue in bump order, VMTF, made clauses 4 to
//   18 times as long on the CPU's hard formulas, and 3 to 7 times the conflicts.)
// - **Learned clauses are reduced** (`cs_reduce`) when they pass `H_REDUCE` or fill three quarters of the arena: the
//   search goes back to level 0, where no learned clause is a reason analysis reads, keeps those of at most
//   `KEEP_LBD` levels and the newer half, drops those level 0 satisfies, compacts the arena in order and watches every
//   clause again. Each clause's levels (LBD) are counted when it is learned.
// - **Threadgroup memory** holds what every step reads: the header, and each variable's value as 2 bits (`cs_bits`),
//   set and unset by adds; the state holds them between launches.
// - **Every loop is bounded** (a decision's pops by the variables, a watch list by its nodes, a gate's items by its width,
//   analysis by the trail): a fault ends the formula `BROKEN`, never a launch that does not end.
// - **Slots**: a SIMD group is a slot, which takes the batch's formulas from a queue one after another, its state
//   in the slot; the batch's memory is the slots' (see `csat_solve`).
// - **Launches are bounded**: a launch runs each slot `args.steps` steps (a round, a conflict, a decision) and
//   leaves its state; the host launches again while any formula runs.
//
// Memory: `blk` the formula block (u32 words); `table` `DESC` words a formula (its descriptor, below, in the block
// too); `state` the slots' states (`slot_words` each, a formula's `state_words` on the host); `out` 16 words a
// formula, once it is done: its status, conflicts, decisions, rounds, learned clauses and their literals; `models` a
// satisfiable formula's model; `queue` the slots' queue. A literal is DIMACS (`v` or
// `-v`, a variable from 1). A gate's record is 4 words: `kind | width << 2`, its output, and its arguments where at
// most two, else where in `D_ARGS` they begin.

#include <ukl/simd.h>

#define NONE 0xFFFFFFFFu
#define GATE 0x80000000u
#define FIXED 3u
#define SEEN 0x80000000u
// A level-0 value a learned clause rests on (analysis left it out, or a reduction dropped the clause it was the
// reason of): a root of a refuted solve's core (`cs_used`).
#define RESTED 0x40000000u
#define LEVELS 0x0FFFFFFFu
// A conflict's clause where it is the window's Start's (`D_START_CONFLICT`).
#define START_CONFLICT 0xFFFFFFFEu

// A formula's descriptor: word offsets in the block, counts.
#define D_VARS 0u
#define D_BASE 1u     // the window's gates: those `D_FSTARTS` / `D_FGATES` list
#define D_GATES 2u    // all its gates: past `D_BASE`, a solve's own (`D_OSTARTS` / `D_OGATES`, or NONE)
#define D_REC 3u
#define D_ARGS 4u
#define D_FSTARTS 5u
#define D_FGATES 6u
#define D_OSTARTS 7u
#define D_OGATES 8u
#define D_LITS 9u
#define D_ENDS 10u
#define D_CLAUSES 11u
#define D_MODEL 12u   // word offset of its model in `models`
#define D_LEARNED 13u
#define D_ARENA 14u
#define D_BUDGET 15u  // conflicts
#define D_FVARS 16u   // the variables `D_FSTARTS` covers (the window's)
#define D_WIDE 17u    // the widest gate's width and 2: a conflict's or an explanation's room
// A window's solve (`bitlex_csat_lanes::Resume`), where `D_RESUME` is 1: the window's level 0 (`Start`: its values
// as three words each, the literal, its reason and argument; or its contradiction's clause), the window's plain
// clauses (the first `D_OWN_FROM`: past them a solve's own, each with `-D_ASSUME` after its end), what its earlier
// solves carried (`D_CLITS` / `D_CENDS`, `D_CN` clauses, numbered after the plain ones), and where its report of
// what it carries out and its core go.
#define D_RESUME 18u
#define D_OWN_FROM 19u
#define D_ASSUME 20u
#define D_CARRY_VARS 21u  // the variables what it carries is over; 0: nothing carried
#define D_START_SET 22u
#define D_START_N 23u
#define D_START_CONFLICT 24u
#define D_START_CN 25u
#define D_START_BROKEN 26u
#define D_CLITS 27u
#define D_CENDS 28u
#define D_CN 29u
#define D_CARRY 30u      // word offset of its room in `carry` (`CARRY_ROOM` words and its count)
// Beside each fanout's gates (`D_FGATES`, `D_OGATES`), entry for entry, what a value of the variable adds to the
// gate's counter (`bitlex_csat::Fanout`'s `counts`: its arguments that are the variable's positive literal and its
// negative one, `pos | neg << 16`): the window's, and a solve's own (NONE: none).
#define D_FCOUNTS 31u
#define D_OCOUNTS 32u
#define DESC 40u

// A state's header.
#define H_STATUS 0u
#define H_TRAIL 1u
#define H_HEAD 2u
#define H_LEVEL 3u
#define H_CONFLICTS 4u
#define H_LEARNED 5u
#define H_USED 6u
#define H_COUNTED 7u  // the trail's values the gates' counters hold: its first ones
#define H_STEPS 8u    // the steps it took
#define H_BEGAN 9u    // a resumed solve's trail where its search began: values learned at level 0 lie past it
#define H_BUMP 10u    // the next bump

// The bumps: the first, and where every activity is scaled down (an activity stays below 21 bumps, in 32 bits).
#define BUMP_FIRST 1024u
#define BUMP_MAX (1u << 24)
#define BUMP_SHIFT 14u
#define H_CONFLICT 11u  // the conflict's clause: a clause's number, or NONE for `cbuf`'s
#define H_CLEN 12u      // `cbuf`'s length
#define H_DECISIONS 13u
#define H_ROUNDS 14u
#define H_FLAG 15u      // a round's conflict, from lane 0's clauses
#define H_VISITS 18u   // watch nodes visited
#define H_ITEMS 19u    // gate items checked
#define H_REDUCE 20u   // the learned clauses' count past which they are reduced
#define H_REDUCES 21u  // reductions made
#define H_LBD 22u      // the clause just learned: its levels
// The device's cycles by part, over 256 (`ukl_clock`, lane 0's; 0 where the backend has no clock): watch visits,
// gate items, analysis, jumps back, decisions, reductions.
#define H_T_VISIT 23u
#define H_T_ITEMS 24u
#define H_T_ANALYZE 25u
#define H_T_BACK 26u
#define H_T_DECIDE 27u
#define H_T_REDUCE 28u
#define H_T_START 29u

// Reductions: the first after `REDUCE_FIRST` learned clauses, each next `REDUCE_STEP` later; a clause of at most
// `KEEP_LBD` levels is kept.
#define REDUCE_FIRST 2000u
#define REDUCE_STEP 300u
// (Or when the clauses fill three quarters of the room, `D_LEARNED` or `D_ARENA`.)
#define KEEP_LBD 3u
// A formula's steps at most (a round, a conflict, a decision), past which it is unknown.
#define MAX_STEPS (1u << 24)
#define HEADER 32u
// What a solve carries out at most, in words (`bitlex_csat_lanes::CARRY_ROOM`), and the longest clause.
#define CARRY_ROOM 4096u
#define CARRIED_LONGEST 64u

// Statuses.
#define RUNNING 0u
#define SAT 1u
#define UNSAT 2u
#define UNKNOWN 3u   // the conflicts' budget spent
#define ROOMLESS 4u  // the learned clauses' room full
#define BROKEN 5u    // a loop past its bound: the state is not what the solver keeps (a fault, which the host reports)

// The queue's words (pinned host memory the host writes while a launch runs): the formulas taken, those the host has
// published (`avail`), the host's stop (no formula taken, every slot ends), then each slot's formula or NONE.
#define Q_TAKE 0u
#define Q_AVAIL 1u
#define Q_STOP 2u
#define Q_ENDED 3u
#define Q_SLOT 4u

// What a gate's check found.
#define M_NONE 0u
#define M_ONE 1u   // one literal (`lit`, `why`)
#define M_AND 2u   // the output true: each unset argument
#define M_HELD 3u  // a `One`'s argument `why` held: each other unset argument false
#define M_CONFLICT 4u

typedef struct Args {
    uint32_t n;
    uint32_t steps;
    uint32_t init;
    uint32_t slots;
    uint32_t slot_words;
    uint32_t room;      // a slot's threadgroup words past its header and bump queue: its counters, then values
    uint32_t pad1;
    uint32_t pad2;
} Args;
UKL_REFLECT_STRUCT(Args, n, steps, init, slots, slot_words, room, pad1, pad2)

typedef struct Csat {
    UKL_GLOBAL const uint32_t* b;
    UKL_GLOBAL uint32_t* s;
    uint32_t lane;
    uint32_t vars, fvars, base, gates, rec, args, fs, fg, os, og, lits, ends, clauses, lcap, acap, budget;
    // A window's solve: its own clauses from `own_from` (NONE: none), the assumption, the carried clauses, and the
    // plain ones in all (the formula's and the carried; a learned clause's number is past them).
    uint32_t resume, own_from, clits, cends, plain;
    int32_t assume;
    // Its window's level 0 (`D_START_*`), and what it carries out: over which variables, where.
    uint32_t start_set, start_n, start_conflict, start_cn, start_broken, carry_vars, carry_at;
    // The state's arrays (word offsets in `s`).
    uint32_t wide;
    // `vr`: a variable's record (`cs_vr`); `act` and `tree` the decisions' (`cs_top`).
    uint32_t vr, trail, limits, act, tree, wnext, wlit, lstart, arena, cbuf, ebuf, lmark, lbd;
    // The tree's levels above the activities.
    uint32_t tlevels;
    // The gates' counters (`cnt` in the state, the first `cwn` in threadgroup memory, `cw`), and what a value adds
    // to them, beside each fanout's gates (the window's `fc`, a solve's own `oc`).
    uint32_t fc, oc, cnt, cwn;
    UKL_LOCAL uint32_t* cw;
    // Threadgroup memory: the header (`h`, the state's first `HEADER` words while the slot runs it) and the values
    // of the variables below `svars`, 2 bits each (`sv`, as a variable's word's low bits).
    UKL_LOCAL uint32_t* h;
    UKL_LOCAL uint32_t* sv;
    // Analysis's bumped variables in the heap not yet raised in the tree, and their activities (`BQ` each).
    UKL_LOCAL uint32_t* bq;
    uint32_t svars;
} Csat;

typedef struct Check {
    uint32_t mode;
    int32_t lit;
    uint32_t why;
    uint32_t cursor;
} Check;

UKL_INLINE uint32_t cs_lvar(int32_t l) { return (uint32_t)(l < 0 ? -l : l); }
// A variable's record, 8 words (one 32-byte sector: what a value's assignment writes and a round reads together):
// its word (below), its reason and the argument that implied it (`why`), its trail position, and the heads of its
// literals' watch lists (positive, negative); 2 words unused.
#define VR 8u
UKL_INLINE uint32_t cs_vr(UKL_PRIVATE Csat* c, uint32_t v) { return c->vr + VR * v; }
// The watch list's head of literal slot `k` (`cs_lslot`).
UKL_INLINE uint32_t cs_wh(UKL_PRIVATE Csat* c, uint32_t k) { return c->vr + VR * (k >> 1) + 5u + (k & 1u); }
// A literal's watch list: the clauses watching it, visited when it turns false.
UKL_INLINE uint32_t cs_lslot(int32_t l) { return 2u * cs_lvar(l) + (l < 0 ? 1u : 0u); }

// A variable's word: 0 unset, else its level `<< 2`, 1 true or 2 false, and `SEEN` while analysis has marked it.
// Its value (the low 2 bits) read from threadgroup memory where the variable is below `svars`.
UKL_INLINE uint32_t cs_bits(UKL_PRIVATE Csat* c, uint32_t v)
{
    return v < c->svars ? (c->sv[v >> 4] >> (2u * (v & 15u))) & 3u : c->s[cs_vr(c, v)] & 3u;
}
// A variable's value bits added to (`add`) or taken from its threadgroup word: no two lanes' fields overlap, and a
// field is 0 when set and its bits when unset, so an add sets it and a subtract unsets it.
UKL_INLINE void cs_sv_add(UKL_PRIVATE Csat* c, uint32_t v, uint32_t bits, bool add)
{
    if (v < c->svars) {
        uint32_t x = bits << (2u * (v & 15u));
        ukl_atomic_add_local(c->sv + (v >> 4), add ? x : 0u - x);
    }
}
UKL_INLINE int32_t cs_value(UKL_PRIVATE Csat* c, int32_t l)
{
    uint32_t w = cs_bits(c, cs_lvar(l));
    if (w == 0u)
        return 0;
    int32_t t = (w & 1u) != 0u ? 1 : -1;
    return l > 0 ? t : -t;
}
UKL_INLINE uint32_t cs_level_of(UKL_PRIVATE Csat* c, uint32_t v) { return (c->s[cs_vr(c, v)] >> 2) & LEVELS; }

UKL_INLINE uint32_t cs_g_kind(UKL_PRIVATE Csat* c, uint32_t g) { return c->b[c->rec + 4u * g] & 3u; }
UKL_INLINE uint32_t cs_g_width(UKL_PRIVATE Csat* c, uint32_t g) { return c->b[c->rec + 4u * g] >> 2; }
UKL_INLINE int32_t cs_g_out(UKL_PRIVATE Csat* c, uint32_t g) { return (int32_t)c->b[c->rec + 4u * g + 1u]; }
UKL_INLINE int32_t cs_g_arg(UKL_PRIVATE Csat* c, uint32_t g, uint32_t n, uint32_t i)
{
    uint32_t r = c->rec + 4u * g;
    return n <= 2u ? (int32_t)c->b[r + 2u + i] : (int32_t)c->b[c->args + c->b[r + 2u] + i];
}

// A clause's literals: the formula's plain ones (below `clauses`; a solve's own, from `own_from`, with `-assume`
// one past its end), the carried ones (below `plain`), then the learned ones, in the arena. `k` from its begin to
// its end.
UKL_INLINE uint32_t cs_cl_begin(UKL_PRIVATE Csat* c, uint32_t id)
{
    if (id < c->clauses)
        return id == 0u ? 0u : c->b[c->ends + id - 1u];
    if (id < c->plain)
        return id == c->clauses ? 0u : c->b[c->cends + id - c->clauses - 1u];
    return c->s[c->lstart + id - c->plain];
}
UKL_INLINE uint32_t cs_cl_end(UKL_PRIVATE Csat* c, uint32_t id)
{
    if (id < c->clauses)
        return c->b[c->ends + id] + (id >= c->own_from ? 1u : 0u);
    if (id < c->plain)
        return c->b[c->cends + id - c->clauses];
    return c->s[c->lstart + id - c->plain + 1u];
}
UKL_INLINE int32_t cs_cl_lit(UKL_PRIVATE Csat* c, uint32_t id, uint32_t k)
{
    if (id < c->clauses)
        return id >= c->own_from && k == c->b[c->ends + id] ? -c->assume : (int32_t)c->b[c->lits + k];
    if (id < c->plain)
        return (int32_t)c->b[c->clits + k];
    return (int32_t)c->s[c->arena + k];
}

// A gate's counter: its arguments false (the low 16 bits) and true (the high), as the trail's first `H_COUNTED`
// values set them (`bitlex_csat_lanes::Search::cnt`). Each gate has one: the first `cwn` in threadgroup memory, the
// rest in the state. A value's adds are reductions (nothing waits for their result).
#define REPEATS 0x80000000u
UKL_INLINE uint32_t cs_cnt(UKL_PRIVATE Csat* c, uint32_t g)
{
    // The state's read where the adds are made (L2), never a stale line of L1.
    return g < c->cwn ? c->cw[g] : ukl_atomic_poll(c->s + c->cnt + g);
}
UKL_INLINE void cs_cnt_add(UKL_PRIVATE Csat* c, uint32_t g, uint32_t x)
{
    if (g < c->cwn)
        ukl_atomic_add_local(c->cw + g, x);
    else
        ukl_atomic_add(c->s + c->cnt + g, x);
}

// The last lane whose first item (`off`, an exclusive sum over the first `f` lanes) is at or before item `t`: the
// lane whose items hold it.
UKL_INLINE uint32_t cs_owner(uint32_t off, uint32_t f, uint32_t t __UKL_PARAMS)
{
    uint32_t owner = 0u;
    for (uint32_t step = UKL_SIMD_WIDTH / 2u; step > 0u; step >>= 1) {
        uint32_t probe = owner + step;
        uint32_t at = ukl_sg_shuffle(off, probe < UKL_SIMD_WIDTH ? probe : 0u __UKL_ARGS);
        if (probe < f && at <= t)
            owner = probe;
    }
    return owner;
}

// The trail's next slot (lane 0's, or a step's winners' by rank).
UKL_INLINE void cs_put(UKL_PRIVATE Csat* c, uint32_t at, int32_t l, uint32_t reason, uint32_t why)
{
    uint32_t v = cs_lvar(l), bits = l > 0 ? 1u : 2u;
    c->s[cs_vr(c, v)] = (c->h[H_LEVEL] << 2) | bits;
    cs_sv_add(c, v, bits, true);
    c->s[cs_vr(c, v) + 1u] = reason;
    c->s[cs_vr(c, v) + 2u] = why;
    c->s[c->trail + at] = (uint32_t)l;
    c->s[cs_vr(c, v) + 3u] = at;
}
// Lane 0's: at the trail's end.
UKL_INLINE void cs_assign(UKL_PRIVATE Csat* c, int32_t l, uint32_t reason, uint32_t why)
{
    uint32_t at = c->h[H_TRAIL];
    cs_put(c, at, l, reason, why);
    c->h[H_TRAIL] = at + 1u;
}

// A literal at the end of `cbuf` (a conflict's clause) or `ebuf` (an explanation).
UKL_INLINE void cs_emit(UKL_PRIVATE Csat* c, uint32_t buf, UKL_PRIVATE uint32_t* n, int32_t l)
{
    c->s[buf + *n] = (uint32_t)l;
    *n = *n + 1u;
}

// Gate `g` checked against the values, as the CPU's `Solver::check`: what it implies, or a conflict, whose clause
// it writes to `cbuf` when `write`.
UKL_INLINE Check cs_check(UKL_PRIVATE Csat* c, uint32_t g, bool write)
{
    Check r;
    r.mode = M_NONE;
    r.lit = 0;
    r.why = 0u;
    r.cursor = 0u;
    uint32_t n = cs_g_width(c, g), kind = cs_g_kind(c, g), len = 0u;
    int32_t o = cs_g_out(c, g);
    // The first two arguments' values read at once, not one after the other (their reads are a pass's latency).
    int32_t pre[2];
    pre[0] = n > 0u ? cs_value(c, cs_g_arg(c, g, n, 0u)) : 0;
    pre[1] = n > 1u ? cs_value(c, cs_g_arg(c, g, n, 1u)) : 0;
    if (kind == 0u) {
        // And.
        int32_t vo = cs_value(c, o);
        uint32_t unset = 0u, unset_at = 0u;
        for (uint32_t i = 0u; i < n; i++) {
            int32_t a = cs_g_arg(c, g, n, i);
            int32_t va = i < 2u ? pre[i] : cs_value(c, a);
            if (va == -1) {
                if (vo == 1) {
                    r.mode = M_CONFLICT;
                    if (write) {
                        cs_emit(c, c->cbuf, &len, -o);
                        cs_emit(c, c->cbuf, &len, a);
                    }
                } else if (vo == 0) {
                    r.mode = M_ONE;
                    r.lit = -o;
                    r.why = i;
                }
                if (write)
                    c->h[H_CLEN] = len;
                return r;
            }
            if (va == 0) {
                if (unset == 0u) {
                    unset = 1u;
                    unset_at = i;
                } else if (a != cs_g_arg(c, g, n, unset_at)) {
                    unset++;
                }
            }
        }
        if (vo == 1) {
            if (unset > 0u)
                r.mode = M_AND;
        } else if (vo == 0 && unset == 0u) {
            r.mode = M_ONE;
            r.lit = o;
        } else if (vo == -1 && unset == 0u) {
            r.mode = M_CONFLICT;
            if (write) {
                cs_emit(c, c->cbuf, &len, o);
                for (uint32_t i = 0u; i < n; i++)
                    cs_emit(c, c->cbuf, &len, -cs_g_arg(c, g, n, i));
            }
        } else if (vo == -1 && unset == 1u) {
            r.mode = M_ONE;
            r.lit = -cs_g_arg(c, g, n, unset_at);
            r.why = unset_at;
        }
    } else if (kind == 1u) {
        // Xor.
        int32_t a = cs_g_arg(c, g, n, 0u), b = cs_g_arg(c, g, n, 1u);
        if (cs_lvar(a) == cs_lvar(b)) {
            int32_t want = a == b ? -o : o;
            int32_t vw = cs_value(c, want);
            if (vw == 0) {
                r.mode = M_ONE;
                r.lit = want;
                r.why = FIXED;
            } else if (vw == -1) {
                r.mode = M_CONFLICT;
                if (write)
                    cs_emit(c, c->cbuf, &len, want);
            }
        } else {
            int32_t p[3];
            p[0] = o;
            p[1] = a;
            p[2] = b;
            int32_t v0 = cs_value(c, o), v1 = cs_value(c, a), v2 = cs_value(c, b);
            uint32_t unset = (v0 == 0 ? 1u : 0u) + (v1 == 0 ? 1u : 0u) + (v2 == 0 ? 1u : 0u);
            bool t0 = v0 == 1, t1 = v1 == 1, t2 = v2 == 1;
            if (unset == 0u && t0 != (t1 != t2)) {
                r.mode = M_CONFLICT;
                if (write)
                    for (uint32_t k = 0u; k < 3u; k++)
                        cs_emit(c, c->cbuf, &len, cs_value(c, p[k]) == 1 ? -p[k] : p[k]);
            } else if (unset == 1u) {
                uint32_t k = v0 == 0 ? 0u : (v1 == 0 ? 1u : 2u);
                bool holds = k == 0u ? (t1 != t2) : (k == 1u ? (t0 != t2) : (t0 != t1));
                r.mode = M_ONE;
                r.lit = holds ? p[k] : -p[k];
                r.why = k;
            }
        }
    } else {
        // One.
        uint32_t held = NONE, unset = 0u, unset_at = 0u;
        for (uint32_t i = 0u; i < n; i++) {
            int32_t a = cs_g_arg(c, g, n, i);
            int32_t va = i < 2u ? pre[i] : cs_value(c, a);
            if (va == 1) {
                if (held != NONE) {
                    r.mode = M_CONFLICT;
                    if (write) {
                        cs_emit(c, c->cbuf, &len, -cs_g_arg(c, g, n, held));
                        cs_emit(c, c->cbuf, &len, -a);
                        c->h[H_CLEN] = len;
                    }
                    return r;
                }
                held = i;
            } else if (va == 0) {
                unset++;
                unset_at = i;
            }
        }
        if (held != NONE) {
            if (unset > 0u) {
                r.mode = M_HELD;
                r.why = held;
            }
        } else if (unset == 0u) {
            r.mode = M_CONFLICT;
            if (write)
                for (uint32_t i = 0u; i < n; i++)
                    cs_emit(c, c->cbuf, &len, cs_g_arg(c, g, n, i));
        } else if (unset == 1u) {
            r.mode = M_ONE;
            r.lit = cs_g_arg(c, g, n, unset_at);
            r.why = unset_at;
        }
    }
    if (write)
        c->h[H_CLEN] = len;
    return r;
}

// `cs_check` (without its clause) of a gate of at most two arguments, straight on: its record's words and the three
// values read at once, the cases chosen by selects (a lane's And, Xor and One take the same few steps).
UKL_INLINE Check cs_check_narrow(UKL_PRIVATE Csat* c, uint32_t g)
{
    uint32_t r = c->rec + 4u * g, head = c->b[r], n = head >> 2, kind = head & 3u;
    int32_t o = (int32_t)c->b[r + 1u], a0 = (int32_t)c->b[r + 2u], a1 = (int32_t)c->b[r + 3u];
    int32_t vo = cs_value(c, o), v0 = n > 0u ? cs_value(c, a0) : 0, v1 = n > 1u ? cs_value(c, a1) : 0;
    Check k;
    k.mode = M_NONE;
    k.lit = 0;
    k.why = 0u;
    k.cursor = 0u;
    if (kind == 0u) {
        // And: an argument false (the first) makes the output false; else its unset ones (a literal twice, once).
        bool f0 = n > 0u && v0 == -1, f1 = n > 1u && v1 == -1;
        bool u0 = n > 0u && v0 == 0, u1 = n > 1u && v1 == 0;
        uint32_t unset = (u0 ? 1u : 0u) + (u1 && !(u0 && a1 == a0) ? 1u : 0u), at = u0 ? 0u : 1u;
        if (f0 || f1) {
            k.mode = vo == 1 ? M_CONFLICT : (vo == 0 ? M_ONE : M_NONE);
            k.lit = -o;
            k.why = f0 ? 0u : 1u;
        } else if (vo == 1) {
            k.mode = unset > 0u ? M_AND : M_NONE;
        } else if (vo == 0) {
            k.mode = unset == 0u ? M_ONE : M_NONE;
            k.lit = o;
        } else {
            k.mode = unset == 0u ? M_CONFLICT : (unset == 1u ? M_ONE : M_NONE);
            k.lit = -(at == 0u ? a0 : a1);
            k.why = at;
        }
    } else if (kind == 1u) {
        // Xor: of one variable twice, its output fixed; else the one unset of the three set by the other two.
        if (cs_lvar(a0) == cs_lvar(a1)) {
            int32_t want = a0 == a1 ? -o : o;
            int32_t vw = want == o ? vo : -vo;
            k.mode = vw == 0 ? M_ONE : (vw == -1 ? M_CONFLICT : M_NONE);
            k.lit = want;
            k.why = FIXED;
        } else {
            uint32_t unset = (vo == 0 ? 1u : 0u) + (v0 == 0 ? 1u : 0u) + (v1 == 0 ? 1u : 0u);
            bool t0 = vo == 1, t1 = v0 == 1, t2 = v1 == 1;
            uint32_t at = vo == 0 ? 0u : (v0 == 0 ? 1u : 2u);
            bool holds = at == 0u ? (t1 != t2) : (at == 1u ? (t0 != t2) : (t0 != t1));
            int32_t p = at == 0u ? o : (at == 1u ? a0 : a1);
            k.mode = unset == 0u ? (t0 != (t1 != t2) ? M_CONFLICT : M_NONE) : (unset == 1u ? M_ONE : M_NONE);
            k.lit = holds ? p : -p;
            k.why = at;
        }
    } else {
        // One: two true is a conflict; one true (the first) makes the rest false; none, the one unset (the last).
        bool t0 = n > 0u && v0 == 1, t1 = n > 1u && v1 == 1;
        bool u0 = n > 0u && v0 == 0, u1 = n > 1u && v1 == 0;
        uint32_t unset = (u0 ? 1u : 0u) + (u1 ? 1u : 0u);
        if (t0 && t1) {
            k.mode = M_CONFLICT;
        } else if (t0 || t1) {
            k.mode = unset > 0u ? M_HELD : M_NONE;
            k.why = t0 ? 0u : 1u;
        } else {
            k.mode = unset == 0u ? M_CONFLICT : (unset == 1u ? M_ONE : M_NONE);
            k.lit = u1 ? a1 : a0;
            k.why = u1 ? 1u : 0u;
        }
    }
    return k;
}

// A mask's highest lane.
UKL_INLINE uint32_t cs_mask_highest(ukl_mask_t m)
{
    return sizeof(ukl_mask_t) == 8u ? 63u - ukl_clz64((uint64_t)m) : 31u - ukl_clz32((uint32_t)m);
}
// The lanes from `lo` to `hi`, clamped to the group.
UKL_INLINE ukl_mask_t cs_mask_range(int32_t lo, int32_t hi)
{
    int32_t w = (int32_t)UKL_SIMD_WIDTH;
    uint32_t a = (uint32_t)(lo < 0 ? 0 : (lo > w ? w : lo)), b = (uint32_t)(hi < 0 ? 0 : (hi > w ? w : hi));
    return ukl_mask_below(b) & ~ukl_mask_below(a);
}

// How many chunks of a pass's wide arguments are read at once.
#define WIDE_CHUNKS 4u

// The lane whose wide gate holds argument `f` of the pass's stream (`p` each lane's first).
UKL_INLINE uint32_t cs_wide_owner(uint32_t p, uint32_t f __UKL_PARAMS)
{
    uint32_t own = 0u;
    for (uint32_t step = UKL_SIMD_WIDTH / 2u; step != 0u; step >>= 1u)
        if (ukl_sg_shuffle(p, own + step __UKL_ARGS) <= f)
            own += step;
    return own;
}

// Every lane: the lanes' wide gates (`wide`: an And or a One whose arguments are in `args`) checked together, as
// `cs_check` would each (without its clause). Their arguments are one stream over the lanes, `WIDE_CHUNKS` chunks of
// it read at once, and each lane folds its own gate's from the chunks' ballots: an And's first false and first unset
// argument (and whether every unset one is that literal), a One's first true, its trues and unset ones and its last
// unset one.
UKL_INLINE Check cs_check_wide(UKL_PRIVATE Csat* c, uint32_t g, bool wide __UKL_PARAMS)
{
    Check r;
    r.mode = M_NONE;
    r.lit = 0;
    r.why = 0u;
    r.cursor = 0u;
    uint32_t kind = wide ? cs_g_kind(c, g) : 0u, n = wide ? cs_g_width(c, g) : 0u;
    uint32_t base = wide ? c->b[c->rec + 4u * g + 2u] : 0u;
    int32_t o = wide ? cs_g_out(c, g) : 0;
    int32_t vo = wide && kind == 0u ? cs_value(c, o) : 0;
    uint32_t p = ukl_sg_exclusive_sum(n, c->lane __UKL_ARGS), total = ukl_sg_sum(n __UKL_ARGS);
    uint32_t first_false = NONE, first_unset = NONE, held = NONE, trues = 0u, unset = 0u, last_unset = 0u, other = 0u;
    int32_t au = 0;
    for (uint32_t j0 = 0u; j0 < total; j0 += WIDE_CHUNKS * UKL_SIMD_WIDTH) {
        int32_t a[WIDE_CHUNKS], va[WIDE_CHUNKS];
        uint32_t owner[WIDE_CHUNKS];
        for (uint32_t k = 0u; k < WIDE_CHUNKS; k++) {
            uint32_t f = j0 + k * UKL_SIMD_WIDTH + c->lane;
            uint32_t own = cs_wide_owner(p, f __UKL_ARGS);
            uint32_t at = ukl_sg_shuffle(base, own __UKL_ARGS) + f - ukl_sg_shuffle(p, own __UKL_ARGS);
            a[k] = f < total ? (int32_t)c->b[c->args + at] : 0;
            owner[k] = own;
        }
        for (uint32_t k = 0u; k < WIDE_CHUNKS; k++)
            va[k] = a[k] != 0 ? cs_value(c, a[k]) : 2;
        for (uint32_t k = 0u; k < WIDE_CHUNKS; k++) {
            uint32_t s0 = j0 + k * UKL_SIMD_WIDTH;
            ukl_mask_t bf = ukl_sg_ballot(va[k] == -1 __UKL_ARGS), bu = ukl_sg_ballot(va[k] == 0 __UKL_ARGS);
            ukl_mask_t bt = ukl_sg_ballot(va[k] == 1 __UKL_ARGS);
            ukl_mask_t m = wide ? cs_mask_range((int32_t)p - (int32_t)s0, (int32_t)(p + n) - (int32_t)s0) : 0u;
            bf &= m;
            bu &= m;
            bt &= m;
            uint32_t from = bu != 0u ? ukl_mask_lowest(bu) : 0u;
            int32_t got = (int32_t)ukl_sg_shuffle((uint32_t)a[k], from __UKL_ARGS);
            if (bf != 0u && first_false == NONE)
                first_false = s0 + ukl_mask_lowest(bf) - p;
            if (bu != 0u && first_unset == NONE) {
                first_unset = s0 + from - p;
                au = got;
            }
            if (bt != 0u && held == NONE)
                held = s0 + ukl_mask_lowest(bt) - p;
            trues += ukl_mask_count(bt);
            unset += ukl_mask_count(bu);
            if (bu != 0u)
                last_unset = s0 + cs_mask_highest(bu) - p;
            // An And's unset arguments that are not its first unset one's literal. That one is the earliest chunk's
            // with one, so it is known here for every unset argument of this chunk and the earlier ones.
            int32_t want = (int32_t)ukl_sg_shuffle((uint32_t)au, owner[k] __UKL_ARGS);
            other += ukl_mask_count(ukl_sg_ballot(va[k] == 0 && a[k] != want __UKL_ARGS) & m);
        }
    }
    if (kind == 0u) {
        if (!wide)
            return r;
        if (first_false != NONE) {
            if (vo == 1) {
                r.mode = M_CONFLICT;
            } else if (vo == 0) {
                r.mode = M_ONE;
                r.lit = -o;
                r.why = first_false;
            }
            return r;
        }
        if (vo == 1) {
            if (first_unset != NONE)
                r.mode = M_AND;
        } else if (vo == 0 && first_unset == NONE) {
            r.mode = M_ONE;
            r.lit = o;
        } else if (vo == -1 && first_unset == NONE) {
            r.mode = M_CONFLICT;
        } else if (vo == -1 && other == 0u) {
            r.mode = M_ONE;
            r.lit = -au;
            r.why = first_unset;
        }
        return r;
    }
    // One.
    if (trues >= 2u) {
        r.mode = M_CONFLICT;
    } else if (held != NONE) {
        if (unset > 0u) {
            r.mode = M_HELD;
            r.why = held;
        }
    } else if (unset == 0u) {
        r.mode = M_CONFLICT;
    } else if (unset == 1u) {
        r.mode = M_ONE;
        r.lit = cs_g_arg(c, g, n, last_unset);
        r.why = last_unset;
    }
    return r;
}

// Whether a gate can imply with nothing set.
UKL_INLINE bool cs_seed(UKL_PRIVATE Csat* c, uint32_t g)
{
    uint32_t n = cs_g_width(c, g), kind = cs_g_kind(c, g);
    if (kind == 0u)
        return n == 0u;
    if (kind == 2u)
        return n <= 1u;
    return cs_lvar(cs_g_arg(c, g, n, 0u)) == cs_lvar(cs_g_arg(c, g, n, 1u));
}

// A variable's gates: the window's, then the solve's own.
UKL_INLINE uint32_t cs_fan_window(UKL_PRIVATE Csat* c, uint32_t v)
{
    return v <= c->fvars ? c->b[c->fs + v + 1u] - c->b[c->fs + v] : 0u;
}
UKL_INLINE uint32_t cs_fan_count(UKL_PRIVATE Csat* c, uint32_t v)
{
    uint32_t n = cs_fan_window(c, v);
    if (c->os != NONE)
        n += c->b[c->os + v + 1u] - c->b[c->os + v];
    return n;
}
UKL_INLINE uint32_t cs_fan_gate(UKL_PRIVATE Csat* c, uint32_t v, uint32_t k)
{
    uint32_t w = cs_fan_window(c, v);
    return k < w ? c->b[c->fg + c->b[c->fs + v] + k] : c->b[c->og + c->b[c->os + v] + k - w];
}
// Its entry's counts (`D_FCOUNTS`, beside the gate).
UKL_INLINE uint32_t cs_fan_counts(UKL_PRIVATE Csat* c, uint32_t v, uint32_t k)
{
    uint32_t w = cs_fan_window(c, v);
    return k < w ? c->b[c->fc + c->b[c->fs + v] + k] : c->b[c->oc + c->b[c->os + v] + k - w];
}

// Every lane: the trail's values from `from` to `to` added to (or taken from) their gates' counters, a lane an
// entry, 32 at a time.
UKL_INLINE void cs_count(UKL_PRIVATE Csat* c, uint32_t from, uint32_t to, bool add __UKL_PARAMS)
{
    for (uint32_t i0 = from; i0 < to; i0 += UKL_SIMD_WIDTH) {
        uint32_t i = i0 + c->lane, f = to - i0 < UKL_SIMD_WIDTH ? to - i0 : UKL_SIMD_WIDTH;
        int32_t l = i < to ? (int32_t)c->s[c->trail + i] : 0;
        uint32_t mine = i < to ? cs_fan_count(c, cs_lvar(l)) : 0u;
        uint32_t off = ukl_sg_exclusive_sum(mine, c->lane __UKL_ARGS), total = ukl_sg_sum(mine __UKL_ARGS);
        for (uint32_t t0 = 0u; t0 < total; t0 += UKL_SIMD_WIDTH) {
            uint32_t t = t0 + c->lane, owner = cs_owner(off, f, t __UKL_ARGS);
            int32_t ol = (int32_t)ukl_sg_shuffle((uint32_t)l, owner __UKL_ARGS);
            uint32_t oo = ukl_sg_shuffle(off, owner __UKL_ARGS);
            if (t < total) {
                uint32_t g = cs_fan_gate(c, cs_lvar(ol), t - oo), pn = cs_fan_counts(c, cs_lvar(ol), t - oo);
                uint32_t pos = pn & 0xFFFFu, neg = pn >> 16, x = ol > 0 ? (neg | pos << 16) : (pos | neg << 16);
                if (x != 0u)
                    cs_cnt_add(c, g, add ? x : 0u - x);
            }
        }
    }
    ukl_sg_barrier();
}

// Whether gate `g`'s check can find anything, from its counter and its output's value alone, its arguments not read
// (`bitlex_csat_lanes::Search::may`). The counter lags the trail (a round counts its own literals, not those it
// implies): a gate passed over here is judged again in the round that counts the rest.
UKL_INLINE bool cs_may(UKL_PRIVATE Csat* c, uint32_t g)
{
    uint32_t r = c->rec + 4u * g, head = c->b[r], n = head >> 2, kind = head & 3u;
    int32_t o = (int32_t)c->b[r + 1u], a0 = (int32_t)c->b[r + 2u], a1 = (int32_t)c->b[r + 3u];
    uint32_t x = cs_cnt(c, g), F = x & 0xFFFFu, T = x >> 16;
    int32_t vo = kind != 2u ? cs_value(c, o) : 0;
    if (kind == 1u)
        return cs_lvar(a0) == cs_lvar(a1) || F + T + (vo != 0 ? 1u : 0u) >= 2u;
    if (n >= 0x10000u)
        return true;
    uint32_t U = n - F - T;
    if (kind == 2u)
        return T >= 2u || (T == 1u && U > 0u) || (T == 0u && U <= 1u);
    if (F > 0u)
        return vo != -1;
    if (vo == 1)
        return U > 0u;
    if (vo == 0)
        return U == 0u;
    bool repeats = n == 2u ? a0 == a1 : (n > 2u && ((uint32_t)a1 & REPEATS) != 0u);
    return U <= 1u || repeats;
}

// The lanes' gates (`active`), checked: a conflict (the lowest lane's, its clause in `cbuf`), or what they imply on
// the trail. Every lane calls it. True on a conflict.
UKL_INLINE bool cs_items(UKL_PRIVATE Csat* c, uint32_t g, bool active __UKL_PARAMS)
{
    Check k;
    k.mode = M_NONE;
    // Only the gates whose counters say their check can find something are checked: the wide Ands and Ones by the
    // group together (`cs_check_wide`), the rest each lane alone.
    bool may = active && cs_may(c, g);
    bool wide = may && cs_g_kind(c, g) != 1u && cs_g_width(c, g) > 2u;
    if (may && !wide)
        k = cs_check_narrow(c, g);
    if (ukl_sg_ballot(wide __UKL_ARGS) != 0u) {
        Check w = cs_check_wide(c, g, wide __UKL_ARGS);
        if (wide)
            k = w;
    }
    uint32_t first = ukl_sg_first(k.mode == M_CONFLICT __UKL_ARGS);
    if (first != UKL_NONE) {
        if (c->lane == first) {
            cs_check(c, g, true);
            c->h[H_CONFLICT] = NONE;
        }
        ukl_sg_barrier();
        return true;
    }
    uint32_t n = active ? cs_g_width(c, g) : 0u;
    bool once = k.mode == M_ONE;
    // A lane puts at most its gate's width and one more.
    uint32_t bound = ukl_sg_max(n __UKL_ARGS) + 2u;
    for (uint32_t step = 0u;; step++) {
        if (step > bound) {
            if (c->lane == 0u)
                c->h[H_STATUS] = BROKEN;
            ukl_sg_barrier();
            return true;
        }
        // This lane's next literal: its one, or the next unset argument.
        int32_t l = 0;
        uint32_t why = 0u;
        if (once) {
            l = k.lit;
            why = k.why;
            once = false;
            k.mode = M_NONE;
        } else if (k.mode == M_AND || k.mode == M_HELD) {
            while (k.cursor < n) {
                uint32_t i = k.cursor++;
                if (k.mode == M_HELD && i == k.why)
                    continue;
                int32_t a = cs_g_arg(c, g, n, i);
                if (cs_value(c, a) == 0) {
                    l = k.mode == M_AND ? a : -a;
                    why = k.mode == M_AND ? i : k.why;
                    break;
                }
            }
            if (l == 0)
                k.mode = M_NONE;
        }
        if (ukl_sg_ballot(l != 0 __UKL_ARGS) == 0u)
            return false;
        uint32_t v = l != 0 ? cs_lvar(l) : NONE - c->lane;
        ukl_mask_t same = ukl_sg_match(v __UKL_ARGS);
        bool win = l != 0 && ukl_mask_lowest(same) == c->lane && cs_value(c, l) == 0;
        ukl_mask_t wins = ukl_sg_ballot(win __UKL_ARGS);
        uint32_t at = c->h[H_TRAIL];
        ukl_sg_barrier();
        if (win)
            cs_put(c, at + ukl_mask_rank(wins, c->lane), l, GATE | g, why);
        ukl_sg_barrier();
        if (c->lane == 0u)
            c->h[H_TRAIL] = at + ukl_mask_count(wins);
        ukl_sg_barrier();
    }
}

// Every lane: the clauses watching `x`, which turned false. The group walks the list together (each lane reads the
// same node); a clause's literals are scanned by the lanes 32 at a time, the first in its order that is not `x`, not
// the other watch and not false taken, as a scan in order would. Lane 0 writes. True on a conflict (`H_CONFLICT`
// its clause).
UKL_INLINE bool cs_visit(UKL_PRIVATE Csat* c, int32_t x __UKL_PARAMS)
{
    uint32_t link = cs_wh(c, cs_lslot(x));
    uint32_t k = c->s[link], nodes = 2u * (c->plain + c->lcap);
    // A node's next, its clause's other watch and the clause's literals' range: read together (each from the node's
    // number alone), and the next node's while this one is visited (visiting one changes no other's).
    uint32_t nk = NONE, cb = 0u, ce = 0u;
    int32_t other = 0;
    if (k != NONE) {
        nk = c->s[c->wnext + k];
        other = (int32_t)c->s[c->wlit + (k ^ 1u)];
        cb = cs_cl_begin(c, k >> 1);
        ce = cs_cl_end(c, k >> 1);
    }
    for (uint32_t seen = 0u; k != NONE; seen++) {
        if (seen > nodes) {
            if (c->lane == 0u)
                c->h[H_STATUS] = BROKEN;
            ukl_sg_barrier();
            return true;
        }
        uint32_t id = k >> 1, nnk = NONE, nb = 0u, ne = 0u;
        int32_t nother = 0;
        if (nk != NONE) {
            nnk = c->s[c->wnext + nk];
            nother = (int32_t)c->s[c->wlit + (nk ^ 1u)];
            nb = cs_cl_begin(c, nk >> 1);
            ne = cs_cl_end(c, nk >> 1);
        }
        int32_t vo = cs_value(c, other);
        if (c->lane == 0u)
            c->h[H_VISITS]++;
        int32_t y = 0;
        if (vo != 1) {
            for (uint32_t j0 = cb; j0 < ce && y == 0; j0 += UKL_SIMD_WIDTH) {
                uint32_t j = j0 + c->lane;
                int32_t q = j < ce ? cs_cl_lit(c, id, j) : 0;
                bool can = q != 0 && q != x && q != other && cs_value(c, q) != -1;
                uint32_t first = ukl_sg_first(can __UKL_ARGS);
                if (first != UKL_NONE)
                    y = (int32_t)ukl_sg_shuffle((uint32_t)q, first __UKL_ARGS);
            }
        }
        if (vo == 1) {
            link = c->wnext + k;
        } else if (y != 0) {
            if (c->lane == 0u) {
                c->s[link] = nk;
                c->s[c->wlit + k] = (uint32_t)y;
                c->s[c->wnext + k] = c->s[cs_wh(c, cs_lslot(y))];
                c->s[cs_wh(c, cs_lslot(y))] = k;
            }
            ukl_sg_barrier();
        } else if (vo == 0) {
            if (c->lane == 0u)
                cs_assign(c, other, id, 0u);
            ukl_sg_barrier();
            link = c->wnext + k;
        } else {
            if (c->lane == 0u)
                c->h[H_CONFLICT] = id;
            ukl_sg_barrier();
            return true;
        }
        k = nk;
        nk = nnk;
        other = nother;
        cb = nb;
        ce = ne;
    }
    return false;
}

// Lane 0: clause `id` watched by its literals `a` and `b`.
UKL_INLINE void cs_watch(UKL_PRIVATE Csat* c, uint32_t id, int32_t a, int32_t b)
{
    uint32_t k = 2u * id;
    c->s[c->wlit + k] = (uint32_t)a;
    c->s[c->wnext + k] = c->s[cs_wh(c, cs_lslot(a))];
    c->s[cs_wh(c, cs_lslot(a))] = k;
    c->s[c->wlit + k + 1u] = (uint32_t)b;
    c->s[c->wnext + k + 1u] = c->s[cs_wh(c, cs_lslot(b))];
    c->s[cs_wh(c, cs_lslot(b))] = k + 1u;
}

// A round: the trail's next literals, a lane each; their clauses (lane 0), then their gates. True on a conflict.
UKL_INLINE bool cs_round(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    uint64_t t_round = ukl_clock();
    uint32_t hd = c->h[H_HEAD], tl = c->h[H_TRAIL];
    uint32_t f = tl - hd < UKL_SIMD_WIDTH ? tl - hd : UKL_SIMD_WIDTH;
    // Each lane its literal; the group visits the watch lists that are not empty, in trail order.
    int32_t lit = c->lane < f ? (int32_t)c->s[c->trail + hd + c->lane] : 0;
    bool watched = lit != 0 && c->s[cs_wh(c, cs_lslot(-lit))] != NONE;
    ukl_mask_t lists = ukl_sg_ballot(watched __UKL_ARGS);
    for (uint32_t i = 0u; i < f; i++)
        if (((lists >> i) & 1u) != 0u && cs_visit(c, -(int32_t)ukl_sg_shuffle((uint32_t)lit, i __UKL_ARGS) __UKL_ARGS))
            return true;
    uint64_t t_visited = ukl_clock();
    if (c->lane == 0u)
        c->h[H_T_VISIT] += (uint32_t)((t_visited - t_round) >> 8);
    uint32_t v = c->lane < f ? cs_lvar(lit) : 0u;
    if (ukl_sg_ballot(v > c->vars __UKL_ARGS) != 0u) {
        if (c->lane == 0u)
            c->h[H_STATUS] = BROKEN;
        ukl_sg_barrier();
        return true;
    }
    // The round's values counted, then their gates judged by the counters.
    uint32_t from = c->h[H_COUNTED] > hd ? c->h[H_COUNTED] : hd;
    cs_count(c, from, hd + f, true __UKL_ARGS);
    if (c->lane == 0u)
        c->h[H_COUNTED] = hd + f;
    ukl_sg_barrier();
    uint32_t mine = c->lane < f ? cs_fan_count(c, v) : 0u;
    uint32_t off = ukl_sg_exclusive_sum(mine, c->lane __UKL_ARGS);
    uint32_t total = ukl_sg_sum(mine __UKL_ARGS);
    if (c->lane == 0u)
        c->h[H_ITEMS] += total;
    for (uint32_t t0 = 0u; t0 < total; t0 += UKL_SIMD_WIDTH) {
        uint32_t t = t0 + c->lane;
        // The literal whose gates hold item `t`.
        uint32_t owner = cs_owner(off, f, t __UKL_ARGS);
        uint32_t ov = ukl_sg_shuffle(v, owner __UKL_ARGS);
        uint32_t oo = ukl_sg_shuffle(off, owner __UKL_ARGS);
        bool active = t < total;
        uint32_t g = active ? cs_fan_gate(c, ov, t - oo) : 0u;
        if (cs_items(c, g, active __UKL_ARGS))
            return true;
    }
    if (c->lane == 0u) {
        c->h[H_HEAD] = hd + f;
        c->h[H_T_ITEMS] += (uint32_t)((ukl_clock() - t_visited) >> 8);
    }
    ukl_sg_barrier();
    return false;
}

// The decisions' tree: the most active variable in the heap (`bitlex_csat_lanes`'s heap, whose top it always is).
// `act` each variable's activity, `OUT` set while it is out of the heap (decided, or taken set); above them
// `tlevels` levels of nodes, each the most active (the activity, then the higher number) of the 32 below it, as two
// words (the activity and the variable; 0, 0 where none is in). The top level is one node. A pop reads the levels
// once each, the lanes a node's 32 children together; a raise (a bump, an insertion) writes each level's ancestor at
// once, a lane a level. No serial walk: a level's read is one read of the group.
#define OUT 0x80000000u

// The nodes of level `k` (0: the activities): `n` divided by 32 `k` times, rounded up.
UKL_INLINE uint32_t cs_tcount(uint32_t n, uint32_t k)
{
    return 5u * k >= 32u ? 1u : ((n - 1u) >> (5u * k)) + 1u;
}
// Level `k`'s first node's word (`k` from 1).
UKL_INLINE uint32_t cs_tlevel(UKL_PRIVATE Csat* c, uint32_t k)
{
    uint32_t off = 0u, n = c->vars + 1u;
    for (uint32_t j = 1u; j < k; j++)
        off += cs_tcount(n, j);
    return c->tree + 2u * off;
}
UKL_INLINE bool cs_key_before(uint32_t a, uint32_t v, uint32_t b, uint32_t w)
{
    return a > b || (a == b && v > w);
}
// The group's best key (`*a`, `*v`) of each lane's.
UKL_INLINE void cs_sg_best(UKL_PRIVATE uint32_t* a, UKL_PRIVATE uint32_t* v __UKL_PARAMS)
{
    uint32_t top = ukl_sg_max(*a __UKL_ARGS);
    uint32_t w = ukl_sg_max(*a == top ? *v : 0u __UKL_ARGS);
    *a = top;
    *v = w;
}
// Every lane: node `i` of level `k` made again from the 32 below it.
UKL_INLINE void cs_tfix(UKL_PRIVATE Csat* c, uint32_t k, uint32_t i __UKL_PARAMS)
{
    uint32_t n = c->vars + 1u, j = 32u * i + c->lane, a = 0u, v = 0u;
    if (k == 1u) {
        uint32_t w = j < n ? c->s[c->act + j] : OUT;
        if ((w & OUT) == 0u) {
            a = w;
            v = j;
        }
    } else if (j < cs_tcount(n, k - 1u)) {
        uint32_t below = cs_tlevel(c, k - 1u);
        a = c->s[below + 2u * j];
        v = c->s[below + 2u * j + 1u];
    }
    cs_sg_best(&a, &v __UKL_ARGS);
    ukl_sg_barrier();
    if (c->lane == 0u) {
        uint32_t at = cs_tlevel(c, k) + 2u * i;
        c->s[at] = a;
        c->s[at + 1u] = v;
    }
    ukl_sg_barrier();
}
// Every lane: the whole tree made again from the activities (after they are scaled), a lane a node.
UKL_INLINE void cs_tbuild(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    uint32_t n = c->vars + 1u;
    for (uint32_t k = 1u; k <= c->tlevels; k++) {
        uint32_t here = cs_tlevel(c, k), below = k > 1u ? cs_tlevel(c, k - 1u) : 0u, m = cs_tcount(n, k - 1u);
        for (uint32_t i = c->lane; i < cs_tcount(n, k); i += UKL_SIMD_WIDTH) {
            uint32_t a = 0u, v = 0u;
            for (uint32_t j = 32u * i; j < 32u * i + 32u && j < m; j++) {
                uint32_t x = 0u, w = 0u;
                if (k == 1u) {
                    uint32_t y = c->s[c->act + j];
                    if ((y & OUT) == 0u) {
                        x = y;
                        w = j;
                    }
                } else {
                    x = c->s[below + 2u * j];
                    w = c->s[below + 2u * j + 1u];
                }
                if (cs_key_before(x, w, a, v)) {
                    a = x;
                    v = w;
                }
            }
            c->s[here + 2u * i] = a;
            c->s[here + 2u * i + 1u] = v;
        }
        ukl_sg_barrier();
    }
}
// Every lane: the most active variable in the heap (0: none).
UKL_INLINE uint32_t cs_top(UKL_PRIVATE Csat* c)
{
    return c->s[cs_tlevel(c, c->tlevels) + 1u];
}
// Every lane: `v` out of the heap, its ancestors made again.
UKL_INLINE void cs_take(UKL_PRIVATE Csat* c, uint32_t v __UKL_PARAMS)
{
    if (c->lane == 0u)
        c->s[c->act + v] |= OUT;
    ukl_sg_barrier();
    for (uint32_t k = 1u; k <= c->tlevels; k++)
        cs_tfix(c, k, v >> (5u * k) __UKL_ARGS);
}
// Every lane: each lane's variable `v` where `ok` (in the heap, its activity `a` raised or just in), its ancestors
// raised to it. Of the lanes under one ancestor, the best writes it.
UKL_INLINE void cs_raise(UKL_PRIVATE Csat* c, bool ok, uint32_t v, uint32_t a __UKL_PARAMS)
{
    if (ukl_sg_ballot(ok __UKL_ARGS) == 0u)
        return;
    for (uint32_t k = 1u; k <= c->tlevels; k++) {
        uint32_t i = v >> (5u * k);
        ukl_mask_t same = ukl_sg_match(ok ? i : NONE - c->lane __UKL_ARGS);
        bool best = ok;
        // Lanes sharing an ancestor: each group's best by two reductions, a group at a time.
        ukl_mask_t shared = ukl_sg_ballot(ok && ukl_mask_count(same) > 1u __UKL_ARGS);
        while (shared != 0u) {
            uint32_t lead = ukl_mask_lowest(shared);
            bool in = ok && ((same >> lead) & 1u) != 0u;
            uint32_t ga = in ? a : 0u, gv = in ? v : 0u;
            cs_sg_best(&ga, &gv __UKL_ARGS);
            if (in)
                best = a == ga && v == gv;
            shared &= ~ukl_sg_ballot(in __UKL_ARGS);
        }
        if (best) {
            uint32_t at = cs_tlevel(c, k) + 2u * i;
            if (cs_key_before(a, v, c->s[at], c->s[at + 1u])) {
                c->s[at] = a;
                c->s[at + 1u] = v;
            }
        }
        ukl_sg_barrier();
    }
}
// Every lane: each lane's variable `v` where `ok` back in the heap, if it is out.
UKL_INLINE void cs_insert(UKL_PRIVATE Csat* c, bool ok, uint32_t v __UKL_PARAMS)
{
    uint32_t w = ok ? c->s[c->act + v] : 0u;
    bool out = ok && (w & OUT) != 0u;
    ukl_sg_barrier();
    if (out)
        c->s[c->act + v] = w & ~OUT;
    cs_raise(c, out, v, w & ~OUT __UKL_ARGS);
}
// Every lane: the tree with every variable in, every activity 0: a node's best is its highest variable.
UKL_INLINE void cs_tstart(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    uint32_t n = c->vars + 1u;
    for (uint32_t v = c->lane; v < n; v += UKL_SIMD_WIDTH)
        c->s[c->act + v] = v == 0u ? OUT : 0u;
    for (uint32_t k = 1u; k <= c->tlevels; k++) {
        uint32_t here = cs_tlevel(c, k);
        for (uint32_t i = c->lane; i < cs_tcount(n, k); i += UKL_SIMD_WIDTH) {
            uint32_t hi = (i + 1u) << (5u * k);
            hi = 5u * k >= 32u || hi > n ? n - 1u : hi - 1u;
            c->s[here + 2u * i] = 0u;
            c->s[here + 2u * i + 1u] = hi;
        }
    }
    ukl_sg_barrier();
}

// Lane 0: the clause that implied `v`'s value, into `ebuf` (its literal first, every other false), or the number of
// the clause that did (`*id`).
UKL_INLINE uint32_t cs_explain(UKL_PRIVATE Csat* c, uint32_t v, UKL_PRIVATE uint32_t* id)
{
    uint32_t r = c->s[cs_vr(c, v) + 1u], w = c->s[cs_vr(c, v) + 2u], len = 0u;
    *id = NONE;
    if ((r & GATE) == 0u) {
        *id = r;
        return 0u;
    }
    int32_t l = (c->s[cs_vr(c, v)] & 1u) != 0u ? (int32_t)v : -(int32_t)v;
    uint32_t g = r & ~GATE, n = cs_g_width(c, g), kind = cs_g_kind(c, g);
    int32_t o = cs_g_out(c, g);
    if (kind == 0u) {
        if (o != 0 && cs_lvar(o) == v) {
            if (l == o) {
                cs_emit(c, c->ebuf, &len, o);
                for (uint32_t i = 0u; i < n; i++)
                    cs_emit(c, c->ebuf, &len, -cs_g_arg(c, g, n, i));
            } else {
                cs_emit(c, c->ebuf, &len, -o);
                cs_emit(c, c->ebuf, &len, cs_g_arg(c, g, n, w));
            }
        } else if (l == cs_g_arg(c, g, n, w)) {
            cs_emit(c, c->ebuf, &len, l);
            cs_emit(c, c->ebuf, &len, -o);
        } else {
            cs_emit(c, c->ebuf, &len, l);
            cs_emit(c, c->ebuf, &len, o);
            for (uint32_t i = 0u; i < n; i++)
                if (i != w)
                    cs_emit(c, c->ebuf, &len, -cs_g_arg(c, g, n, i));
        }
    } else if (kind == 1u) {
        cs_emit(c, c->ebuf, &len, l);
        if (w != FIXED) {
            int32_t p[3];
            p[0] = o;
            p[1] = cs_g_arg(c, g, n, 0u);
            p[2] = cs_g_arg(c, g, n, 1u);
            for (uint32_t k = 0u; k < 3u; k++)
                if (k != w)
                    cs_emit(c, c->ebuf, &len, cs_value(c, p[k]) == 1 ? -p[k] : p[k]);
        }
    } else {
        if (l == cs_g_arg(c, g, n, w)) {
            cs_emit(c, c->ebuf, &len, l);
            for (uint32_t i = 0u; i < n; i++)
                if (i != w)
                    cs_emit(c, c->ebuf, &len, cs_g_arg(c, g, n, i));
        } else {
            cs_emit(c, c->ebuf, &len, l);
            cs_emit(c, c->ebuf, &len, -cs_g_arg(c, g, n, w));
        }
    }
    return len;
}

// Gate `g`'s explanation of `l` (its argument `w` implied it): its length, and its literal `j`, in `cs_explain`'s
// order (its literal first, every other false), each lane its own.
UKL_INLINE uint32_t cs_ex_len(UKL_PRIVATE Csat* c, uint32_t g, uint32_t w, int32_t l)
{
    uint32_t n = cs_g_width(c, g), kind = cs_g_kind(c, g);
    int32_t o = cs_g_out(c, g);
    if (kind == 0u) {
        if (o != 0 && cs_lvar(o) == cs_lvar(l))
            return l == o ? n + 1u : 2u;
        return l == cs_g_arg(c, g, n, w) ? 2u : n + 1u;
    }
    if (kind == 1u)
        return w != FIXED ? 3u : 1u;
    return l == cs_g_arg(c, g, n, w) ? n : 2u;
}
UKL_INLINE int32_t cs_ex_lit(UKL_PRIVATE Csat* c, uint32_t g, uint32_t w, int32_t l, uint32_t j)
{
    uint32_t n = cs_g_width(c, g), kind = cs_g_kind(c, g);
    int32_t o = cs_g_out(c, g);
    if (j == 0u && !(kind == 0u && o != 0 && cs_lvar(o) == cs_lvar(l) && l != o))
        return kind == 0u && o != 0 && cs_lvar(o) == cs_lvar(l) ? o : l;
    if (kind == 0u) {
        if (o != 0 && cs_lvar(o) == cs_lvar(l)) {
            if (l == o)
                return -cs_g_arg(c, g, n, j - 1u);
            return j == 0u ? -o : cs_g_arg(c, g, n, w);
        }
        if (l == cs_g_arg(c, g, n, w))
            return -o;
        if (j == 1u)
            return o;
        return -cs_g_arg(c, g, n, j - 2u < w ? j - 2u : j - 1u);
    }
    if (kind == 1u) {
        uint32_t k = j - 1u < w ? j - 1u : j;
        int32_t p = k == 0u ? o : cs_g_arg(c, g, n, k - 1u);
        return cs_value(c, p) == 1 ? -p : p;
    }
    if (l == cs_g_arg(c, g, n, w))
        return cs_g_arg(c, g, n, j - 1u < w ? j - 1u : j);
    return -cs_g_arg(c, g, n, w);
}

// The most gates' counters in threadgroup memory (the first gates'): the rest are the state's.
#define CW_ROOM 512u

// Every lane: the bump queue's `n` variables raised in the tree, a lane each, and the queue emptied.
#define BQ 32u
UKL_INLINE void cs_raise_queued(UKL_PRIVATE Csat* c, uint32_t n __UKL_PARAMS)
{
    for (uint32_t i0 = 0u; i0 < n; i0 += UKL_SIMD_WIDTH) {
        bool ok = i0 + c->lane < n;
        uint32_t v = ok ? c->bq[i0 + c->lane] : 0u, a = ok ? c->bq[BQ + i0 + c->lane] : 0u;
        cs_raise(c, ok, v, a __UKL_ARGS);
    }
    ukl_sg_barrier();
}

// A lane's room for the pending marks of a conflict's analysis.
#define PEND 4u

// Every lane: the conflict's first unique implication point, learned at the arena's end (its asserting literal
// first, the highest of the rest second); its length, or 0 where the room is full. `*back`: the level to jump back
// to. As a serial analysis: a clause's literals are filtered by the lanes 32 at a time (a variable's first in the
// clause's order taken), and lane 0 bumps them in that order; the trail is searched back 32 entries at a time.
UKL_INLINE uint32_t cs_analyze(UKL_PRIVATE Csat* c, UKL_PRIVATE uint32_t* back __UKL_PARAMS)
{
    uint32_t here = c->h[H_LEVEL], u = c->h[H_USED], len = 1u, count = 0u, at = c->h[H_TRAIL];
    if (c->h[H_LEARNED] >= c->lcap || u >= c->acap)
        return 0u;
    // The marked variables of this level not yet resolved: each one's trail position (and 1) and its literal there,
    // `PEND` a lane, kept by the lane that met it; the next resolved is the highest. Past a lane's room (`spill`),
    // the trail is searched back for the marks instead.
    uint32_t pp[PEND];
    int32_t pl[PEND];
    for (uint32_t k = 0u; k < PEND; k++) {
        pp[k] = 0u;
        pl[k] = 0;
    }
    bool spill = false;
    // The bump queue's length.
    uint32_t queued = 0u;
    // The clause read: a numbered one (`id`), `cbuf`'s literals (the conflict's, from a gate), or gate `eg`'s
    // explanation of `el` (its argument `ew`), each lane its literals.
    uint32_t id = c->h[H_CONFLICT], n = c->h[H_CLEN], eg = NONE, ew = 0u;
    int32_t p = 0, el = 0;
    for (;;) {
        uint32_t j0 = id != NONE ? cs_cl_begin(c, id) : 0u;
        uint32_t j1 = eg != NONE ? cs_ex_len(c, eg, ew, el) : (id != NONE ? cs_cl_end(c, id) : n);
        for (uint32_t jb = j0; jb < j1; jb += UKL_SIMD_WIDTH) {
            uint32_t j = jb + c->lane;
            int32_t q = 0;
            if (j < j1)
                q = eg != NONE ? cs_ex_lit(c, eg, ew, el, j) : (id != NONE ? cs_cl_lit(c, id, j) : (int32_t)c->s[c->cbuf + j]);
            uint32_t v = q != 0 ? cs_lvar(q) : 0u;
            uint32_t lv = q != 0 ? cs_level_of(c, v) : 0u, tp = q != 0 ? c->s[cs_vr(c, v) + 3u] : 0u;
            // A level-0 value left out: a root of the core (lanes on one variable write the same word).
            if (q != 0 && q != p && lv == 0u)
                c->s[cs_vr(c, v)] |= RESTED;
            bool can = q != 0 && q != p && lv != 0u && (c->s[cs_vr(c, v)] & SEEN) == 0u;
            ukl_mask_t same = ukl_sg_match(can ? v : NONE - c->lane __UKL_ARGS);
            can = can && ukl_mask_lowest(same) == c->lane;
            ukl_mask_t cands = ukl_sg_ballot(can __UKL_ARGS);
            ukl_mask_t lows = ukl_sg_ballot(can && lv != here __UKL_ARGS);
            uint32_t pushes = ukl_mask_count(lows);
            if (u + len + pushes > c->acap)
                return 0u;
            // Each one met bumped, at once (a lane each: the bumps' order is not the tree's).
            uint32_t w = 0u;
            if (can) {
                c->s[cs_vr(c, v)] |= SEEN;
                w = c->s[c->act + v] + c->h[H_BUMP];
                c->s[c->act + v] = w;
                if (lv != here)
                    c->s[c->arena + u + len + ukl_mask_rank(lows, c->lane)] = (uint32_t)q;
            }
            count += ukl_mask_count(cands) - pushes;
            len += pushes;
            bool full = can && lv == here;
            for (uint32_t k = 0u; k < PEND; k++)
                if (full && pp[k] == 0u) {
                    pp[k] = tp + 1u;
                    pl[k] = -q;
                    full = false;
                }
            spill = spill || ukl_sg_ballot(full __UKL_ARGS) != 0u;
            // The bumped ones in the heap queued (raised 32 at a time: the tree is read only at the next decision).
            bool raise = can && (w & OUT) == 0u;
            ukl_mask_t rs = ukl_sg_ballot(raise __UKL_ARGS);
            uint32_t nr = ukl_mask_count(rs);
            if (queued + nr > BQ) {
                cs_raise_queued(c, queued __UKL_ARGS);
                queued = 0u;
            }
            if (nr > BQ) {
                cs_raise(c, raise, v, w __UKL_ARGS);
            } else {
                if (raise) {
                    c->bq[queued + ukl_mask_rank(rs, c->lane)] = v;
                    c->bq[BQ + queued + ukl_mask_rank(rs, c->lane)] = w;
                }
                queued += nr;
            }
            ukl_sg_barrier();
        }
        int32_t l = 0;
        if (!spill) {
            // The highest pending position, from its lane.
            uint32_t m = 0u;
            for (uint32_t k = 0u; k < PEND; k++)
                m = pp[k] > m ? pp[k] : m;
            uint32_t top = ukl_sg_max(m __UKL_ARGS);
            if (top == 0u || count == 0u) {
                if (c->lane == 0u)
                    c->h[H_STATUS] = BROKEN;
                ukl_sg_barrier();
                return 0u;
            }
            int32_t mine = 0;
            for (uint32_t k = 0u; k < PEND; k++)
                if (pp[k] == top) {
                    mine = pl[k];
                    pp[k] = 0u;
                }
            uint32_t holder = ukl_sg_first(m == top __UKL_ARGS);
            l = (int32_t)ukl_sg_shuffle((uint32_t)mine, holder __UKL_ARGS);
            at = top - 1u;
        } else {
            // The trail's last marked entry below `at`: 32 entries at a time.
            for (;;) {
                if (at == 0u || count == 0u) {
                    if (c->lane == 0u)
                        c->h[H_STATUS] = BROKEN;
                    ukl_sg_barrier();
                    return 0u;
                }
                uint32_t lo = at > UKL_SIMD_WIDTH ? at - UKL_SIMD_WIDTH : 0u, i = lo + c->lane;
                bool hit = i < at && (c->s[cs_vr(c, cs_lvar((int32_t)c->s[c->trail + i]))] & SEEN) != 0u;
                ukl_mask_t m = ukl_sg_ballot(hit __UKL_ARGS);
                if (m != 0u) {
                    at = lo + 63u - ukl_clz64((uint64_t)m);
                    break;
                }
                at = lo;
            }
            l = (int32_t)c->s[c->trail + at];
        }
        ukl_sg_barrier();
        count--;
        if (c->lane == 0u) {
            c->s[cs_vr(c, cs_lvar(l))] &= ~SEEN;
            if (count == 0u)
                c->s[c->arena + u] = (uint32_t)(-l);
        }
        ukl_sg_barrier();
        if (count == 0u) {
            cs_raise_queued(c, queued __UKL_ARGS);
            break;
        }
        // Its reason next: a clause, or a gate and the argument that implied it.
        p = l;
        uint32_t r = c->s[cs_vr(c, cs_lvar(l)) + 1u];
        if ((r & GATE) != 0u) {
            eg = r & ~GATE;
            ew = c->s[cs_vr(c, cs_lvar(l)) + 2u];
            el = l;
            id = NONE;
        } else {
            eg = NONE;
            id = r;
        }
    }
    // The rest unmarked; the highest level's first literal second; the levels counted (LBD), each marked with this
    // conflict's number.
    uint32_t hi = 0u, hk = 1u, mark = c->h[H_CONFLICTS], lbd = 1u;
    if (c->lane == 0u)
        c->s[c->lmark + here] = mark;
    ukl_sg_barrier();
    for (uint32_t kb = 1u; kb < len; kb += UKL_SIMD_WIDTH) {
        uint32_t k = kb + c->lane, lv = 0u;
        if (k < len) {
            uint32_t v = cs_lvar((int32_t)c->s[c->arena + u + k]);
            c->s[cs_vr(c, v)] &= ~SEEN;
            lv = cs_level_of(c, v);
        }
        uint32_t top = ukl_sg_max(lv __UKL_ARGS);
        uint32_t at_top = ukl_sg_first(k < len && lv == top __UKL_ARGS);
        if (top > hi) {
            hi = top;
            hk = kb + at_top;
        }
        bool fresh = k < len && c->s[c->lmark + lv] != mark;
        ukl_mask_t same = ukl_sg_match(fresh ? lv : NONE - c->lane __UKL_ARGS);
        fresh = fresh && ukl_mask_lowest(same) == c->lane;
        lbd += ukl_sg_count(fresh __UKL_ARGS);
        ukl_sg_barrier();
        if (fresh)
            c->s[c->lmark + lv] = mark;
        ukl_sg_barrier();
    }
    if (c->lane == 0u) {
        if (len > 1u) {
            uint32_t t = c->s[c->arena + u + 1u];
            c->s[c->arena + u + 1u] = c->s[c->arena + u + hk];
            c->s[c->arena + u + hk] = t;
        }
        c->h[H_BUMP] += c->h[H_BUMP] / 20u;
        c->h[H_LBD] = lbd;
    }
    ukl_sg_barrier();
    *back = hi;
    return len;
}

// Every lane: the trail back to level `to`, its variables unset; those out of the heap (decided, or met set at a
// decision) put back.
UKL_INLINE void cs_back_to(UKL_PRIVATE Csat* c, uint32_t to __UKL_PARAMS)
{
    uint32_t start = c->s[c->limits + to], tl = c->h[H_TRAIL], counted = c->h[H_COUNTED];
    // The values counted taken from their gates' counters.
    if (start < counted) {
        cs_count(c, start, counted < tl ? counted : tl, false __UKL_ARGS);
        if (c->lane == 0u)
            c->h[H_COUNTED] = start;
        ukl_sg_barrier();
    }
    for (uint32_t i0 = start; i0 < tl; i0 += UKL_SIMD_WIDTH) {
        uint32_t i = i0 + c->lane;
        int32_t l = i < tl ? (int32_t)c->s[c->trail + i] : 0;
        uint32_t v = cs_lvar(l);
        if (i < tl) {
            c->s[cs_vr(c, v)] = 0u;
            cs_sv_add(c, v, l > 0 ? 1u : 2u, false);
        }
        cs_insert(c, i < tl, v __UKL_ARGS);
    }
    if (c->lane == 0u) {
        c->h[H_TRAIL] = start;
        c->h[H_HEAD] = start;
        c->h[H_LEVEL] = to;
    }
    ukl_sg_barrier();
}

UKL_INLINE void cs_finish(UKL_PRIVATE Csat* c, uint32_t status)
{
    if (c->lane == 0u && c->h[H_STATUS] != BROKEN)
        c->h[H_STATUS] = status;
    ukl_sg_barrier();
}

// Every lane: a conflict met at a level past 0: learned, jumped back, its literal asserted.
UKL_INLINE void cs_conflict(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    if (c->h[H_STATUS] != RUNNING)
        return;
    // At level 0, or at the assumption's: unsatisfiable, no conflict spent.
    uint32_t lv = c->h[H_LEVEL];
    if (lv == 0u || (lv == 1u && c->assume != 0 && (int32_t)c->s[c->trail + c->s[c->limits]] == c->assume)) {
        cs_finish(c, UNSAT);
        return;
    }
    if (c->h[H_CONFLICTS] >= c->budget) {
        cs_finish(c, UNKNOWN);
        return;
    }
    uint32_t back = 0u, len = 0u;
    if (c->lane == 0u)
        c->h[H_CONFLICTS]++;
    ukl_sg_barrier();
    uint64_t t_an = ukl_clock();
    len = cs_analyze(c, &back __UKL_ARGS);
    if (c->lane == 0u)
        c->h[H_T_ANALYZE] += (uint32_t)((ukl_clock() - t_an) >> 8);
    // Past `BUMP_MAX`: every activity scaled down alike, across the lanes (out of the heap or not), and the tree
    // made again (two activities scaled to one may now be ordered by their numbers).
    if (c->h[H_BUMP] > BUMP_MAX) {
        for (uint32_t v = c->lane; v <= c->vars; v += UKL_SIMD_WIDTH) {
            uint32_t w = c->s[c->act + v];
            c->s[c->act + v] = (w & OUT) | ((w & ~OUT) >> BUMP_SHIFT);
        }
        ukl_sg_barrier();
        cs_tbuild(c __UKL_ARGS);
        if (c->lane == 0u)
            c->h[H_BUMP] >>= BUMP_SHIFT;
    }
    ukl_sg_barrier();
    if (len == 0u) {
        cs_finish(c, ROOMLESS);
        return;
    }
    uint64_t t_back = ukl_clock();
    cs_back_to(c, back __UKL_ARGS);
    if (c->lane == 0u)
        c->h[H_T_BACK] += (uint32_t)((ukl_clock() - t_back) >> 8);
    if (c->lane == 0u) {
        uint32_t u = c->h[H_USED];
        int32_t first = (int32_t)c->s[c->arena + u];
        if (len == 1u) {
            cs_assign(c, first, NONE, 0u);
        } else {
            uint32_t j = c->h[H_LEARNED], id = c->plain + j;
            c->s[c->lstart + j] = u;
            c->s[c->lstart + j + 1u] = u + len;
            c->s[c->lbd + j] = c->h[H_LBD];
            c->h[H_USED] = u + len;
            c->h[H_LEARNED] = j + 1u;
            cs_watch(c, id, first, (int32_t)c->s[c->arena + u + 1u]);
            cs_assign(c, first, id, 0u);
        }
    }
    ukl_sg_barrier();
}

// Every lane: the learned clauses reduced, at level 0 (above). False where a clause is now false at level 0 (the
// formula unsatisfiable).
UKL_INLINE bool cs_reduce(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    // At level 0 already, its trail is all level 0's (`limits` holds an older level 1's start).
    if (c->h[H_LEVEL] > 0u)
        cs_back_to(c, 0u __UKL_ARGS);
    uint32_t slots = 2u * (c->vars + 1u);
    for (uint32_t k = c->lane; k < slots; k += UKL_SIMD_WIDTH)
        c->s[cs_wh(c, k)] = NONE;
    ukl_sg_barrier();
    bool ok = true;
    if (c->lane == 0u) {
        // Level 0's values: none rests on a learned clause past here (analysis never reads level 0).
        uint32_t tl = c->h[H_TRAIL];
        for (uint32_t i = 0u; i < tl; i++) {
            uint32_t v = cs_lvar((int32_t)c->s[c->trail + i]);
            uint32_t r = c->s[cs_vr(c, v) + 1u];
            if ((r & GATE) == 0u && r != NONE && r >= c->plain) {
                // What the clause read stays among the core's roots: the clause goes.
                for (uint32_t k = cs_cl_begin(c, r), e = cs_cl_end(c, r); k < e; k++)
                    c->s[cs_vr(c, cs_lvar(cs_cl_lit(c, r, k)))] |= RESTED;
                c->s[cs_vr(c, v) + 1u] = NONE;
            }
        }
        // Kept: the short (by levels) and the newer half, newest first while they fit in half the arena; dropped: those
        // level 0 satisfies. Marked (the LBD's top bit), then compacted in order.
        uint32_t n = c->h[H_LEARNED], kept = 0u, used = 0u, room = c->acap / 2u;
        for (uint32_t j = n; j > 0u; j--) {
            uint32_t i = j - 1u, b = c->s[c->lstart + i], e = c->s[c->lstart + i + 1u];
            bool sat = false;
            for (uint32_t k = b; k < e && !sat; k++)
                sat = cs_value(c, (int32_t)c->s[c->arena + k]) == 1;
            bool want = !sat && (c->s[c->lbd + i] <= KEEP_LBD || 2u * i >= n);
            if (want && used + (e - b) <= room) {
                used += e - b;
                c->s[c->lbd + i] |= 0x80000000u;
            }
        }
        used = 0u;
        for (uint32_t j = 0u; j < n; j++) {
            uint32_t b = c->s[c->lstart + j], e = c->s[c->lstart + j + 1u], lbd = c->s[c->lbd + j];
            if ((lbd & 0x80000000u) == 0u)
                continue;
            for (uint32_t k = b; k < e; k++)
                c->s[c->arena + used + k - b] = c->s[c->arena + k];
            c->s[c->lstart + kept] = used;
            c->s[c->lbd + kept] = lbd & 0x7FFFFFFFu;
            used += e - b;
            kept++;
            c->s[c->lstart + kept] = used;
        }
        c->s[c->lstart + kept] = used;
        c->h[H_LEARNED] = kept;
        c->h[H_USED] = used;
        c->h[H_REDUCE] = kept + REDUCE_FIRST + REDUCE_STEP * (c->h[H_REDUCES] + 1u);
        c->h[H_REDUCES]++;
        // Every clause watched again by two literals not false; one level 0 satisfies left out; one with a single
        // such literal implies it; with none, the formula is unsatisfiable.
        uint32_t all = c->plain + kept;
        for (uint32_t id = 0u; id < all && ok; id++) {
            int32_t a = 0, b = 0;
            bool sat = false;
            for (uint32_t k = cs_cl_begin(c, id), e = cs_cl_end(c, id); k < e && !sat; k++) {
                int32_t q = cs_cl_lit(c, id, k);
                int32_t vq = cs_value(c, q);
                if (vq == 1)
                    sat = true;
                else if (vq == 0 && a == 0)
                    a = q;
                else if (vq == 0 && b == 0 && q != a)
                    b = q;
            }
            if (sat)
                continue;
            if (a == 0) {
                ok = false;
                c->h[H_CONFLICT] = id;
            } else if (b == 0) {
                cs_assign(c, a, id, 0u);
            } else {
                cs_watch(c, id, a, b);
            }
        }
        c->h[H_FLAG] = ok ? 1u : 0u;
    }
    ukl_sg_barrier();
    ok = c->h[H_FLAG] != 0u;
    ukl_sg_barrier();
    return ok;
}

// Every lane: a decision, the most active unset variable, false (those met set are taken out of the heap on the
// way); none left, the formula holds.
UKL_INLINE void cs_decide(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    // The assumption first, at level 1; false at level 0, the solve is refuted by what implied it.
    bool decided = false;
    if (c->lane == 0u && c->h[H_STATUS] == RUNNING && c->h[H_LEVEL] == 0u && c->assume != 0) {
        int32_t va = cs_value(c, c->assume);
        if (va == 0) {
            c->s[c->limits] = c->h[H_TRAIL];
            c->h[H_LEVEL] = 1u;
            cs_assign(c, c->assume, NONE, 0u);
            decided = true;
        } else if (va == -1) {
            c->s[c->cbuf] = (uint32_t)c->assume;
            c->h[H_CLEN] = 1u;
            c->h[H_CONFLICT] = NONE;
            c->h[H_STATUS] = UNSAT;
        }
    }
    decided = ukl_sg_shuffle(decided ? 1u : 0u, 0u __UKL_ARGS) != 0u;
    ukl_sg_barrier();
    if (decided || c->h[H_STATUS] != RUNNING)
        return;
    uint32_t v = NONE;
    for (uint32_t taken = 0u;; taken++) {
        if (taken > c->vars) {
            cs_finish(c, BROKEN);
            return;
        }
        uint32_t top = cs_top(c);
        if (top == 0u)
            break;
        cs_take(c, top __UKL_ARGS);
        if (cs_bits(c, top) == 0u) {
            v = top;
            break;
        }
    }
    if (c->lane == 0u) {
        if (v == NONE) {
            c->h[H_STATUS] = SAT;
        } else if (c->budget == 0u) {
            // No conflict to spend: propagation at level 0 alone (the prover's rounds, decision 0654).
            c->h[H_STATUS] = UNKNOWN;
        } else {
            uint32_t lv = c->h[H_LEVEL];
            c->s[c->limits + lv] = c->h[H_TRAIL];
            c->h[H_LEVEL] = lv + 1u;
            c->h[H_DECISIONS]++;
            cs_assign(c, -(int32_t)v, NONE, 0u);
        }
    }
    ukl_sg_barrier();
}

// Every lane: a window's solve from its window's level 0 (`bitlex_csat_lanes::Start`): its values set as the
// window's propagation set them (a lane each, in trail order); every plain and carried clause watched by two
// literals not false (one level 0 satisfies left out, one with a single such literal implying it; in order, as the
// watch lists' order is the search's); each of the solve's own gates checked once.
UKL_INLINE void cs_resume(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    uint32_t sn = c->start_n;
    for (uint32_t i = c->lane; i < sn; i += UKL_SIMD_WIDTH) {
        uint32_t t = c->start_set + 3u * i;
        cs_put(c, i, (int32_t)c->b[t], c->b[t + 1u], c->b[t + 2u]);
    }
    ukl_sg_barrier();
    // The window's values counted: no round counts them.
    cs_count(c, 0u, sn, true __UKL_ARGS);
    if (c->lane == 0u) {
        c->h[H_COUNTED] = sn;
        c->h[H_TRAIL] = sn;
        c->h[H_HEAD] = sn;
        if (c->start_broken != 0u) {
            c->h[H_CONFLICT] = START_CONFLICT;
            c->h[H_STATUS] = UNSAT;
        }
        for (uint32_t id = 0u; id < c->plain && c->h[H_STATUS] == RUNNING; id++) {
            int32_t a = 0, b = 0;
            bool sat = false;
            for (uint32_t k = cs_cl_begin(c, id), e = cs_cl_end(c, id); k < e && !sat; k++) {
                int32_t q = cs_cl_lit(c, id, k);
                int32_t vq = cs_value(c, q);
                if (vq == 1)
                    sat = true;
                else if (vq == 0 && a == 0)
                    a = q;
                else if (vq == 0 && b == 0 && q != a)
                    b = q;
            }
            if (sat)
                continue;
            if (a == 0) {
                c->h[H_CONFLICT] = id;
                c->h[H_STATUS] = UNSAT;
            } else if (b == 0) {
                cs_assign(c, a, id, 0u);
            } else {
                cs_watch(c, id, a, b);
            }
        }
        c->h[H_BEGAN] = c->h[H_TRAIL];
    }
    ukl_sg_barrier();
    if (c->h[H_STATUS] != RUNNING)
        return;
    for (uint32_t g0 = c->base; g0 < c->gates; g0 += UKL_SIMD_WIDTH) {
        uint32_t g = g0 + c->lane;
        if (cs_items(c, g, g < c->gates __UKL_ARGS)) {
            cs_finish(c, UNSAT);
            return;
        }
    }
}

// Every lane: the state laid out, the plain clauses watched (their units set), the gates that imply with nothing set
// checked. False where that met a contradiction.
UKL_INLINE void cs_start(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    uint32_t n = c->vars + 1u;
    for (uint32_t v = c->lane; v < n; v += UKL_SIMD_WIDTH) {
        c->s[cs_vr(c, v)] = 0u;
        c->s[c->lmark + v] = 0u;
        c->s[cs_vr(c, v) + 5u] = NONE;
        c->s[cs_vr(c, v) + 6u] = NONE;
    }
    for (uint32_t w = c->lane; 16u * w < c->svars; w += UKL_SIMD_WIDTH)
        c->sv[w] = 0u;
    for (uint32_t k = c->lane; k < c->cwn; k += UKL_SIMD_WIDTH)
        c->cw[k] = 0u;
    for (uint32_t k = c->cwn + c->lane; k < c->gates; k += UKL_SIMD_WIDTH)
        c->s[c->cnt + k] = 0u;
    cs_tstart(c __UKL_ARGS);
    if (c->lane == 0u) {
        for (uint32_t h = 0u; h < HEADER; h++)
            c->h[h] = 0u;
        c->h[H_REDUCE] = REDUCE_FIRST;
        c->h[H_BUMP] = BUMP_FIRST;
    }
    ukl_sg_barrier();
    if (c->resume != 0u) {
        cs_resume(c __UKL_ARGS);
        return;
    }
    if (c->lane == 0u) {
        // The plain clauses, as the CPU's `add`: a tautology dropped, a unit set, the rest watched by their first two
        // literals apart.
        for (uint32_t id = 0u; id < c->clauses && c->h[H_STATUS] == RUNNING; id++) {
            uint32_t b0 = cs_cl_begin(c, id), e = cs_cl_end(c, id);
            bool taut = false;
            int32_t a = 0, b = 0;
            for (uint32_t j = b0; j < e && !taut; j++) {
                int32_t q = cs_cl_lit(c, id, j);
                for (uint32_t k = j + 1u; k < e; k++)
                    if (cs_cl_lit(c, id, k) == -q)
                        taut = true;
                if (a == 0)
                    a = q;
                else if (b == 0 && q != a)
                    b = q;
            }
            if (taut)
                continue;
            if (a == 0) {
                c->h[H_STATUS] = UNSAT;
            } else if (b == 0) {
                int32_t va = cs_value(c, a);
                if (va == -1)
                    c->h[H_STATUS] = UNSAT;
                else if (va == 0)
                    cs_assign(c, a, NONE, 0u);
            } else {
                cs_watch(c, id, a, b);
            }
        }
    }
    ukl_sg_barrier();
    if (c->h[H_STATUS] != RUNNING)
        return;
    for (uint32_t g0 = 0u; g0 < c->gates; g0 += UKL_SIMD_WIDTH) {
        uint32_t g = g0 + c->lane;
        bool active = g < c->gates && cs_seed(c, g);
        if (ukl_sg_ballot(active __UKL_ARGS) == 0u)
            continue;
        if (cs_items(c, g, active __UKL_ARGS)) {
            cs_finish(c, UNSAT);
            return;
        }
    }
}

// A formula's state laid out in its slot, from its descriptor.
UKL_INLINE void cs_setup(UKL_PRIVATE Csat* c, UKL_GLOBAL const uint32_t* d, UKL_LOCAL uint32_t* room_at, uint32_t room)
{
    c->vars = d[D_VARS];
    // The slot's threadgroup room split by its formula alone, never by the batch (a search resumed in another batch
    // keeps the same counters and values there): the first gates' counters (`CW_ROOM` at most), then the values, 16
    // variables a word, as many as fit.
    c->gates = d[D_GATES];
    c->cwn = c->gates < CW_ROOM ? c->gates : CW_ROOM;
    if (c->cwn > room)
        c->cwn = room;
    c->cw = room_at;
    c->sv = room_at + c->cwn;
    c->svars = c->vars + 1u < 16u * (room - c->cwn) ? c->vars + 1u : 16u * (room - c->cwn);
    c->fc = d[D_FCOUNTS];
    c->oc = d[D_OCOUNTS];
    c->fvars = d[D_FVARS];
    c->base = d[D_BASE];
    c->rec = d[D_REC];
    c->args = d[D_ARGS];
    c->fs = d[D_FSTARTS];
    c->fg = d[D_FGATES];
    c->os = d[D_OSTARTS];
    c->og = d[D_OGATES];
    c->lits = d[D_LITS];
    c->ends = d[D_ENDS];
    c->clauses = d[D_CLAUSES];
    c->lcap = d[D_LEARNED];
    c->acap = d[D_ARENA];
    c->budget = d[D_BUDGET];
    c->wide = d[D_WIDE];
    c->resume = d[D_RESUME];
    c->own_from = d[D_OWN_FROM];
    c->assume = (int32_t)d[D_ASSUME];
    c->carry_vars = d[D_CARRY_VARS];
    c->start_set = d[D_START_SET];
    c->start_n = d[D_START_N];
    c->start_conflict = d[D_START_CONFLICT];
    c->start_cn = d[D_START_CN];
    c->start_broken = d[D_START_BROKEN];
    c->clits = d[D_CLITS];
    c->cends = d[D_CENDS];
    c->plain = c->clauses + d[D_CN];
    c->carry_at = d[D_CARRY];
    uint32_t n = c->vars + 1u, nodes = 2u * (c->plain + c->lcap);
    // What every step reads first, the learned clauses' room last: a search touches the room's pages only as it
    // fills them. (`state_words` on the host.)
    c->vr = HEADER;
    c->trail = c->vr + VR * n;
    c->limits = c->trail + n;
    c->act = c->limits + n;
    c->tree = c->act + n;
    c->tlevels = 1u;
    while (cs_tcount(n, c->tlevels) > 1u)
        c->tlevels++;
    c->cnt = cs_tlevel(c, c->tlevels) + 2u;
    c->lmark = c->cnt + c->gates;
    c->cbuf = c->lmark + n;
    c->ebuf = c->cbuf + c->wide;
    c->lbd = c->ebuf + c->wide;
    c->lstart = c->lbd + c->lcap;
    c->wnext = c->lstart + c->lcap + 1u;
    c->wlit = c->wnext + nodes;
    c->arena = c->wlit + nodes;
}

// Every lane: a held formula's header and values into threadgroup memory, from its state (a launch's start).
UKL_INLINE void cs_load(UKL_PRIVATE Csat* c __UKL_PARAMS)
{
    for (uint32_t k = c->lane; k < HEADER; k += UKL_SIMD_WIDTH)
        c->h[k] = c->s[k];
    for (uint32_t k = c->lane; k < c->cwn; k += UKL_SIMD_WIDTH)
        c->cw[k] = c->s[c->cnt + k];
    // A lane a word: its 16 variables' low bits (16 reads at once).
    for (uint32_t w = c->lane; 16u * w < c->svars; w += UKL_SIMD_WIDTH) {
        uint32_t x = 0u;
        for (uint32_t k = 0u; k < 16u; k++) {
            uint32_t v = 16u * w + k;
            x |= v < c->svars ? (c->s[cs_vr(c, v)] & 3u) << (2u * k) : 0u;
        }
        c->sv[w] = x;
    }
    ukl_sg_barrier();
}

// Lane 0: a literal's variable among a refuted solve's core.
UKL_INLINE void cs_core(UKL_PRIVATE Csat* c, int32_t l) { c->s[cs_vr(c, cs_lvar(l))] |= SEEN; }

// Lane 0: a refuted window's solve's core (`bitlex_csat_lanes::Search::used`), marked `SEEN` with the `RESTED`
// ones: its contradiction's clause, the level-0 values its learned clauses rest on, and back along the trail
// through each one's reason (a reason's values lie before the value it implied).
UKL_INLINE void cs_used(UKL_PRIVATE Csat* c)
{
    uint32_t id = c->h[H_CONFLICT];
    if (id == START_CONFLICT) {
        for (uint32_t k = 0u; k < c->start_cn; k++)
            cs_core(c, (int32_t)c->b[c->start_conflict + k]);
    } else if (id != NONE) {
        for (uint32_t k = cs_cl_begin(c, id), e = cs_cl_end(c, id); k < e; k++)
            cs_core(c, cs_cl_lit(c, id, k));
    } else {
        for (uint32_t k = 0u, n = c->h[H_CLEN]; k < n; k++)
            cs_core(c, (int32_t)c->s[c->cbuf + k]);
    }
    for (uint32_t i = c->h[H_TRAIL]; i > 0u; i--) {
        uint32_t v = cs_lvar((int32_t)c->s[c->trail + i - 1u]);
        if ((c->s[cs_vr(c, v)] & (SEEN | RESTED)) == 0u || c->s[cs_vr(c, v) + 1u] == NONE)
            continue;
        uint32_t eid = NONE, len = cs_explain(c, v, &eid);
        if (eid != NONE) {
            for (uint32_t k = cs_cl_begin(c, eid), e = cs_cl_end(c, eid); k < e; k++)
                cs_core(c, cs_cl_lit(c, eid, k));
        } else {
            for (uint32_t k = 0u; k < len; k++)
                cs_core(c, (int32_t)c->s[c->ebuf + k]);
        }
    }
}

// Every lane: what a window's solve carries out (`bitlex_csat_lanes::Search::carry`), into `room`: its count of
// words, then each clause's length and literals. The learned clauses it holds of at most `CARRIED_LONGEST` literals
// over the window's variables without `-assume`, then the values learned at level 0 (reason NONE past `H_BEGAN`),
// each where it fits in what is left. A lane a clause, its place given in lane order.
UKL_INLINE void cs_carry(UKL_PRIVATE Csat* c, UKL_GLOBAL uint32_t* room __UKL_PARAMS)
{
    uint32_t used = 0u, vars = c->carry_vars;
    for (uint32_t pass = 0u; pass < 2u && vars != 0u; pass++) {
        uint32_t zero = c->h[H_LEVEL] == 0u ? c->h[H_TRAIL] : c->s[c->limits];
        uint32_t began = c->h[H_BEGAN];
        uint32_t n = pass == 0u ? c->h[H_LEARNED] : (zero > began ? zero - began : 0u);
        for (uint32_t j0 = 0u; j0 < n; j0 += UKL_SIMD_WIDTH) {
            uint32_t j = j0 + c->lane, b = 0u, e = 0u;
            bool ok = j < n;
            if (ok && pass == 0u) {
                b = c->s[c->lstart + j];
                e = c->s[c->lstart + j + 1u];
                ok = e - b <= CARRIED_LONGEST;
            } else if (ok) {
                b = began + j;
                e = b + 1u;
                ok = c->s[cs_vr(c, cs_lvar((int32_t)c->s[c->trail + b])) + 1u] == NONE;
            }
            for (uint32_t k = b; k < e && ok; k++) {
                int32_t q = (int32_t)c->s[(pass == 0u ? c->arena : c->trail) + k];
                ok = cs_lvar(q) <= vars && q != -c->assume;
            }
            uint32_t len = ok ? e - b : 0u, at = NONE;
            for (uint32_t k = 0u; k < UKL_SIMD_WIDTH; k++) {
                uint32_t ok_k = ukl_sg_shuffle(ok ? 1u : 0u, k __UKL_ARGS), len_k = ukl_sg_shuffle(len, k __UKL_ARGS);
                if (ok_k != 0u && used + 1u + len_k <= CARRY_ROOM) {
                    if (k == c->lane)
                        at = used;
                    used += 1u + len_k;
                }
            }
            if (at != NONE) {
                room[1u + at] = len;
                for (uint32_t k = 0u; k < len; k++)
                    room[2u + at + k] = c->s[(pass == 0u ? c->arena : c->trail) + b + k];
            }
        }
    }
    if (c->lane == 0u)
        room[0] = used;
    ukl_sg_barrier();
}

// Every lane: a finished formula's report (`out`, 16 words) and, satisfiable, its model (`models`, a bit a
// variable); a refuted window's solve, its core there instead; a window's solve, what it carries out (`carry`).
UKL_INLINE void cs_report(UKL_PRIVATE Csat* c, UKL_GLOBAL uint32_t* o, UKL_GLOBAL uint32_t* model, UKL_GLOBAL uint32_t* carry __UKL_PARAMS)
{
    uint32_t st = c->h[H_STATUS];
    if (c->carry_at != NONE)
        cs_carry(c, carry + c->carry_at __UKL_ARGS);
    bool core = st == UNSAT && c->resume != 0u;
    if (core && c->lane == 0u)
        cs_used(c);
    ukl_sg_barrier();
    if (st == SAT || core)
        for (uint32_t v0 = 0u; v0 <= c->vars; v0 += UKL_SIMD_WIDTH) {
            uint32_t v = v0 + c->lane, w = v <= c->vars ? c->s[cs_vr(c, v)] : 0u;
            ukl_mask_t m = ukl_sg_ballot(st == SAT ? (w & 1u) != 0u : (w & (SEEN | RESTED)) != 0u __UKL_ARGS);
            if (c->lane == 0u)
                model[v0 / 32u] = (uint32_t)m;
        }
    if (c->lane == 0u) {
        for (uint32_t k = 1u; k < 16u; k++)
            o[k] = 0u;
        o[1] = c->h[H_CONFLICTS];
        o[2] = c->h[H_DECISIONS];
        o[3] = c->h[H_ROUNDS];
        o[4] = c->h[H_LEARNED];
        o[5] = c->h[H_USED];
        o[6] = c->h[H_VISITS];
        o[7] = c->h[H_ITEMS];
        o[8] = c->h[H_REDUCES];
        for (uint32_t k = 0u; k < 6u; k++)
            o[9u + k] = c->h[H_T_VISIT + k];
        // The status last, past a fence the host's reads see: the host reads a report once it is set.
        ukl_fence_system();
        ukl_atomic_cas(o, RUNNING, c->h[H_STATUS]);
    }
    ukl_sg_barrier();
}

// A slot's look at the queue, between steps (lane 0's, every lane's answer): 1 where the slot should end its
// launch, its state kept: the host's stop, or formulas published that no slot takes while a slot has ended (its
// room unused this launch), which the next launch's slots take. While every slot runs, a waiting formula waits for
// the first slot done.
UKL_INLINE uint32_t cs_look(UKL_GLOBAL uint32_t* queue, uint32_t lane __UKL_PARAMS)
{
    uint32_t v = 0u;
    if (lane == 0u && (ukl_atomic_poll(queue + Q_STOP) != 0u
                       || (ukl_atomic_poll(queue + Q_ENDED) != 0u && ukl_atomic_poll(queue + Q_AVAIL) > ukl_atomic_poll(queue + Q_TAKE))))
        v = 1u;
    return ukl_sg_shuffle(v, 0u __UKL_ARGS);
}

// A slot's launch ended: counted, so the slots still running end theirs where formulas wait (`cs_look`).
UKL_INLINE void cs_ended(UKL_GLOBAL uint32_t* queue, uint32_t lane)
{
    if (lane == 0u)
        ukl_atomic_add(queue + Q_ENDED, 1u);
}

// One launch on the device while the host adds formulas (decision 0670): a slot (a SIMD group) takes the published
// formulas one after another from the queue (`Q_TAKE` up to `Q_AVAIL`, which the host raises as it adds them) and
// ends where none is left: the host launches again when it has more and no launch runs. Each result is out the
// moment it is (`cs_report`: the status last, past a system fence), read by the host while the launch runs. A
// formula's state is in its slot (`queue[Q_SLOT + slot]` its formula), so a batch's memory is the slots', not the
// formulas'. A launch is bounded: a slot runs `args.steps` steps at most, and ends early (its state kept, resumed
// by the next launch) where formulas wait that no slot takes while a slot has ended (`cs_look`), or the host stops it; a formula is unknown past
// `MAX_STEPS` of its own (`bitlex_csat_lanes::STEPS`). The host clears the queue and the reports.
DEFINE_KERNEL2(prover, csat_solve,
               ARGS,     Args,     args,   ,
               ROBUFFER, uint32_t, blk,    "[block]",
               ROBUFFER, uint32_t, table,  "[n * 40]",
               RWBUFFER, uint32_t, state,  "[slots * slot_words]",
               RWBUFFER, uint32_t, out,    "[n * 16]",
               RWBUFFER, uint32_t, models, "[model words]",
               RWBUFFER, uint32_t, carry,  "[carry words]",
               RWBUFFER, uint32_t, queue,  "[4 + slots]",
               RWLOCAL,  uint32_t, sh,     "[HEADER + 2 * BQ + room]",
               TGID0,    uint32_t, slot,   ,
               LANE,     uint32_t, lane,   )
{
    Csat cs;
    UKL_PRIVATE Csat* c = &cs;
    c->b = blk;
    c->s = state + slot * args.slot_words;
    c->lane = lane;
    c->h = sh;
    c->bq = sh + HEADER;
    uint32_t steps = 0u;
    while (steps < args.steps) {
        uint32_t f = queue[Q_SLOT + slot];
        ukl_sg_barrier();
        if (f == NONE) {
            uint32_t got = NONE;
            if (lane == 0u && ukl_atomic_poll(queue + Q_STOP) == 0u) {
                // The next published formula, taken by a compare-and-swap: the count never passes those published
                // (an increment taken back past them would let another slot's take in between skip one and repeat
                // another). Bounded: each failed swap is another slot's take.
                uint32_t avail = ukl_atomic_poll(queue + Q_AVAIL);
                uint32_t t = ukl_atomic_poll(queue + Q_TAKE);
                for (uint32_t tries = 0u; t < avail && tries <= args.n; tries++) {
                    uint32_t was = ukl_atomic_cas(queue + Q_TAKE, t, t + 1u);
                    if (was == t) {
                        got = t;
                        break;
                    }
                    t = was;
                }
            }
            f = ukl_sg_shuffle(got, 0u __UKL_ARGS);
            if (f == NONE) {
                cs_ended(queue, lane);
                return;
            }
            ukl_fence_device();
            if (lane == 0u)
                queue[Q_SLOT + slot] = f;
            cs_setup(c, table + f * DESC, sh + HEADER + 2u * BQ, args.room);
            cs_start(c __UKL_ARGS);
            steps++;
        } else {
            // Held from a launch before: its header and values into threadgroup memory.
            cs_setup(c, table + f * DESC, sh + HEADER + 2u * BQ, args.room);
            cs_load(c __UKL_ARGS);
        }
        uint32_t n = c->vars + 1u;
        while (steps < args.steps && c->h[H_STATUS] == RUNNING) {
            if ((steps & 7u) == 7u) {
                if (cs_look(queue, lane __UKL_ARGS) != 0u)
                    break;
            }
            if (c->h[H_STEPS] >= MAX_STEPS) {
                cs_finish(c, UNKNOWN);
                break;
            }
            steps++;
            if (lane == 0u)
                c->h[H_STEPS]++;
            ukl_sg_barrier();
            // The trail within its room: past it, every loop over it would be unbounded.
            if (c->h[H_TRAIL] > n || c->h[H_HEAD] > c->h[H_TRAIL] || c->h[H_LEVEL] >= n) {
                cs_finish(c, BROKEN);
                break;
            }
            if (c->h[H_HEAD] == c->h[H_TRAIL]) {
                if (c->h[H_LEARNED] >= c->h[H_REDUCE] || 4u * c->h[H_LEARNED] >= 3u * c->lcap || 4u * c->h[H_USED] >= 3u * c->acap) {
                    uint64_t t_r = ukl_clock();
                    if (!cs_reduce(c __UKL_ARGS))
                        cs_finish(c, UNSAT);
                    if (lane == 0u)
                        c->h[H_T_REDUCE] += (uint32_t)((ukl_clock() - t_r) >> 8);
                    continue;
                }
                uint64_t t_d = ukl_clock();
                cs_decide(c __UKL_ARGS);
                if (lane == 0u)
                    c->h[H_T_DECIDE] += (uint32_t)((ukl_clock() - t_d) >> 8);
                continue;
            }
            if (lane == 0u)
                c->h[H_ROUNDS]++;
            if (cs_round(c __UKL_ARGS))
                cs_conflict(c __UKL_ARGS);
        }
        ukl_sg_barrier();
        if (c->h[H_STATUS] == RUNNING) {
            // Kept for the next launch: its header back in its state.
            for (uint32_t k = lane; k < HEADER; k += UKL_SIMD_WIDTH)
                c->s[k] = c->h[k];
            for (uint32_t k = lane; k < c->cwn; k += UKL_SIMD_WIDTH)
                c->s[c->cnt + k] = c->cw[k];
            cs_ended(queue, lane);
            return;
        }
        UKL_GLOBAL const uint32_t* d = table + f * DESC;
        cs_report(c, out + f * 16u, models + d[D_MODEL], carry __UKL_ARGS);
        if (lane == 0u)
            queue[Q_SLOT + slot] = NONE;
        ukl_sg_barrier();
    }
    cs_ended(queue, lane);
}
