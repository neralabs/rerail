// The preprocessor's evaluation as a persistent grid (decision 0460 §4): G groups of 256 threads,
// resident together, run the passes as phases, each group a share of each pass's items; a
// device-wide barrier (`ukl_grid_barrier`) separates a phase from the next, and the scans,
// segmented scans and sorts are the grid's own (`ukl/grid.h`). Every count a phase needs is read
// from the arena, so the host sizes nothing but the arena.
//
// Launches, the same for every unit:
// - `pp_setup`: the front passes, the definitions, the visibility and the top level, to the
//   queue's seed;
// - `px_expand`, twice: the queue's first phase, the top level's rollback and places, the
//   queue's second phase. A stage word lets the second launch take up where the first ended (a
//   queue whose workers all gave up waiting while work remained);
// - `pp_check`: the refusals.
//
// The kernels bind the arena (`arena`: every store at its offset, `lay` the offsets by slot,
// `S_*`), and the slab the unit's documents are in (`data`).

#define AT(T, s) ((UKL_GLOBAL T*)(arena + lay[S_##s]))
#define C32(s) ((UKL_COHERENT uint32_t*)(arena + lay[S_##s]))
#define C64(s) ((UKL_COHERENT uint64_t*)(arena + lay[S_##s]))
#define W(s) lay[S_##s]
// Each of `n` items, a thread each, over the grid.
#define EACH(t, n) for (uint32_t t = g.group * g.lsz + g.lid, t##_n = (n); t < t##_n; t += g.groups * g.lsz)
// One thread of the grid.
#define ONE(t) for (uint32_t t = 0u; g.group == 0u && g.lid == 0u && t < 1u; t++)
// A measurement's stop (`STOP`): the kernel ends before its phase `stop` (0: never).
#define TICK() if (++phase == stop) return
#define BARRIER() TICK(); if (!ukl_grid_barrier(g, &tg->flag)) return
// Scans sharing their barriers (`ukl_grid_scans`): `JOB(k, …)` each, then `SCANS(k)`.
#define JOB(j, n_, in_, out_, total_) jobs[j].n = (n_); jobs[j].in = C32(in_); jobs[j].out = C32(out_); jobs[j].total = C32(total_)
#define SCANS(k) TICK(); if (!ukl_grid_scans(g, jobs, (k), C32(SUMS), tg->scratch, &tg->flag __UKL_ARGS)) return
#define SCAN(n, in, out, total) TICK(); if (!ukl_grid_scan_n(g, (n), C32(in), C32(out), C32(total), C32(SUMS), tg->scratch, &tg->flag __UKL_ARGS)) return
#define SEG(op, n, in, heads, out) TICK(); if (!ukl_grid_seg_scan_n(g, (op), (n), C32(in), C32(heads), C32(out), C32(SUMS), tg->big, tg->big + 256u, &tg->flag)) return
#define SORT(n, bits, keys, va, kb, vb, hist) TICK(); if (!ukl_grid_sort_u64(g, (n), (bits), true, C64(keys), C32(va), C64(kb), C32(vb), C32(hist), C32(SUMS), sl, tg->scratch, &tg->flag __UKL_ARGS)) return
// A sort whose rows are already in the order of their low `low` bits: only the digits above pass.
#define SORT_FROM(n, low, bits, keys, va, kb, vb, hist) TICK(); if (!ukl_grid_sort_u64_from(g, (n), (low), (bits), true, C64(keys), C32(va), C64(kb), C32(vb), C32(hist), C32(SUMS), sl, tg->scratch, &tg->flag __UKL_ARGS)) return
// A count the passes before wrote.
#define N(s) AT(const uint32_t, s)[0]

// A top level, as the expansion's passes read it: its tokens' nodes, its stretches' first tokens
// and their count's store, their first nodes' places, and its tokens' count's store. The text's
// (its active stretches in the unit's order), and the tests' lines' (decision 0467 §4).
#define TEXT_TOP AT(const uint32_t, TEXT_NODES), AT(const uint32_t, GAT), AT(const uint32_t, N_GAPS), AT(const uint32_t, GFIRSTS), AT(const uint32_t, GTOTAL)
// Each top stretch's instance.
#define TEXT_INST AT(const uint32_t, SINST)
#define IF_INST AT(const uint32_t, IF_INST)
#define IF_TOP AT(const uint32_t, IF_NODES), AT(const uint32_t, IF_AT), AT(const uint32_t, N_DIRS), AT(const uint32_t, IF_AT), AT(const uint32_t, IF_TOTAL)
// The same without the tokens' count.
#define TEXT_STRETCHES AT(const uint32_t, TEXT_NODES), AT(const uint32_t, GAT), AT(const uint32_t, N_GAPS), AT(const uint32_t, GFIRSTS)
#define IF_STRETCHES AT(const uint32_t, IF_NODES), AT(const uint32_t, IF_AT), AT(const uint32_t, N_DIRS), AT(const uint32_t, IF_AT)

// The queue's workers over a top: each SIMD group of the grid one, until the queue is idle.
#define PX_WORK_ON(T, CLOSES)                                                                        \
    px_worker(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const PpDef, DEFS), AT(const uint32_t, ITEMS), \
              AT(const uint64_t, SORT_KEYS), AT(const uint32_t, SORT_VA), AT(const uint32_t, N_ROWS), AT(const uint64_t, NAME_KEYS), \
              AT(const uint32_t, VALUES), T##_TOP, T##_INST, AT(const PpNode, P1_NODES), AT(const uint32_t, P1_UFILE), AT(const uint32_t, DEPTH), AT(PxList, LISTS),                                      \
              AT(uint32_t, TOKENS), AT(PxArg, ARGS), AT(uint32_t, OUT), AT(uint32_t, SLOTS), AT(uint32_t, QCTL),                  \
              AT(uint32_t, CTL), AT(const uint32_t, WORDS), AT(PxScratch, SCRATCH), CLOSES, AT(const uint32_t, CLOSE_TOTAL), AT(const uint32_t, FLOORS), W(N_UNITS), \
              AT(const uint64_t, IF_OPKEYS), AT(const uint32_t, IF_OPKINDS), W(N_IFOP), AT(const uint64_t, IF_FEATKEYS), AT(const uint64_t, IF_FEATVALS), W(N_FEAT), \
              AT(uint32_t, CNT), W(CNT_CAP), lane __UKL_ARGS)

// The top level's rollback, its sizes and places, over a top of `nt_` tokens (`px_expand`'s
// stage 0, after the queue's first phase).
#define PX_PLACES(T, TOKS, nt_)                                                                      \
    EACH(s, nt_) px_top_xflag(AT(const uint32_t, STATE), AT(const uint32_t, OID), AT(const PxList, LISTS), TOKS, AT(uint32_t, XFLAG), s); \
    BARRIER();                                                                                         \
    SCAN(nt_, XFLAG, XAT, XTOTAL);                                                                     \
    EACH(s, nt_) px_top_xlist(AT(const uint32_t, XFLAG), AT(const uint32_t, XAT), TOKS, AT(uint32_t, XPOS), s); \
    BARRIER();                                                                                         \
    if (g.group == 0u) px_top_cover(AT(const uint32_t, XPOS), AT(const uint32_t, XTOTAL), AT(const uint32_t, OID), AT(PxList, LISTS), AT(uint32_t, XCOVER), AT(uint32_t, CTL), g.lid, lane __UKL_ARGS); \
    BARRIER();                                                                                         \
    EACH(s, nt_) px_top_sizes(AT(uint32_t, STATE), AT(const uint32_t, OID), AT(PxList, LISTS), TOKS, AT(uint32_t, V), AT(const uint32_t, XPOS), AT(const uint32_t, XTOTAL), AT(const uint32_t, XCOVER), s); \
    BARRIER();                                                                                         \
    SCAN(nt_, V, OBASE, VTOTAL);                                                                       \
    EACH(s, nt_) px_top_place(files, data, AT(const uint32_t, BASES), nf, AT(const uint32_t, STATE), AT(const uint32_t, OID), AT(PxList, LISTS), TOKS, AT(const uint32_t, OBASE), T##_STRETCHES, AT(uint32_t, OUT), AT(uint32_t, SLOTS), AT(uint32_t, QCTL), AT(uint32_t, CTL), W(OUT_CAP), W(Q_CAP), s); \
    BARRIER()

// The queue made ready for another top: the slots the last one used emptied (the queue is
// linear: a slot is used once), the arena's tops back to the file literals' (`CTL` 6 and 7 keep
// them). The refusals stay.
#define PX_RESET()                                                                                     \
    EACH(k, ukl_min(AT(const uint32_t, QCTL)[1], W(Q_CAP))) AT(uint32_t, SLOTS)[k] = 0u;               \
    BARRIER();                                                                                         \
    ONE(x) {                                                                                           \
        UKL_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);                                                    \
        c_[0] = 0u; c_[1] = 0u; c_[3] = 0u; c_[4] = c_[6]; c_[5] = c_[7];                              \
        AT(uint32_t, QCTL)[1] = 0u;                                                                    \
    }                                                                                                  \
    BARRIER()

// The queue's workers over a top, launched again in the kernel while work remains, a bounded
// number of times.
#define PX_RUNS (8u)
#define PX_DRAIN(T, CLOSES)                                                                          \
    for (uint32_t run = 0u; run < PX_RUNS; run++) {                                                    \
        PX_WORK_ON(T, CLOSES);                                                                       \
        BARRIER();                                                                                     \
        if (ukl_atomic_load(&AT(uint32_t, QCTL)[2]) == 0u) break;                                      \
        if (run + 1u == PX_RUNS) ONE(x) px_refuse(AT(uint32_t, CTL), X_QUEUE);                         \
    }

// The file table and the requests, as the tests' and the includes' passes read them.
#define IF_FILES(fx, nm)                                                                               \
    IfFiles fx;                                                                                        \
    fx.ft_keys = AT(const uint64_t, P1_FTKEYS); fx.ft_files = AT(const uint32_t, P1_FTFILES); fx.n_ft = W(N_FT); \
    fx.found_by = AT(const uint32_t, P1_FOUNDBY); fx.unit_file = AT(const uint32_t, P1_UFILE); fx.reqs = AT(PpReq, P1_REQS); \
    fx.n_reqs = AT(uint32_t, P1_NREQ); fx.req_cap = W(DC); fx.flags = AT(uint32_t, P1_FLAGS);                \
    IfNames nm;                                                                                        \
    nm.bytes = AT(uint8_t, P1_RNAMES); nm.top = AT(uint32_t, P1_RNTOP); nm.cap = W(RNC)

// The unit as the tests' passes read it (`Ux`): its files, definitions and table, and the tests'
// lines as its top.
#define IF_UX(u)                                                                                       \
    Ux u;                                                                                              \
    u.files = files; u.data = data; u.bases = AT(const uint32_t, BASES); u.n_files = nf; u.keys = AT(const uint64_t, KEYS); \
    u.defs = AT(const PpDef, DEFS); u.items = AT(const uint32_t, ITEMS); u.sorted = AT(const uint64_t, SORT_KEYS);          \
    u.perm = AT(const uint32_t, SORT_VA); u.n_rows = N(N_ROWS); u.name_keys = AT(const uint64_t, NAME_KEYS);                 \
    u.values = AT(const uint32_t, VALUES); u.text_nodes = AT(const uint32_t, IF_NODES); u.gat = AT(const uint32_t, IF_AT);  \
    u.n_gaps = N(N_DIRS); u.firsts = AT(const uint32_t, IF_AT); u.n_toks = N(IF_TOTAL); u.tdepth = AT(const uint32_t, DEPTH); \
    u.va_opt = 0ul; u.stoks = AT(const PxScratch, SCRATCH);                                                                   \
    u.sbytes = (UKL_GLOBAL const uint8_t*)(AT(const PxScratch, SCRATCH) + AT(const uint32_t, WORDS)[9]);                      \
    u.relex_options = 0u; u.closes = AT(const uint64_t, CLOSE_KEYS); u.n_close = 0u;                                          \
    u.floors = AT(const uint32_t, FLOORS); u.n_units = W(N_UNITS); u.tinst = AT(const uint32_t, IF_INST); u.nodes = AT(const PpNode, P1_NODES); \
    u.unit_file = AT(const uint32_t, P1_UFILE); u.op_keys = AT(const uint64_t, IF_OPKEYS); u.op_kinds = AT(const uint32_t, IF_OPKINDS); \
    u.n_ops = W(N_IFOP); u.feat_keys = AT(const uint64_t, IF_FEATKEYS); u.feat_vals = AT(const uint64_t, IF_FEATVALS); u.n_feat = W(N_FEAT)

// A group's threadgroup memory: the barrier's flag, the scans' scratch, and the sorts' counts or
// a sorted tile (the segmented scans' two rows alias them: no phase runs two of them).
#define PP_TG_BIG (UKL_GRID_SORT_TILE_WORDS > UKL_RADIX_GROUPS * UKL_RADIX_DIGITS + 3u * UKL_RADIX_DIGITS ? UKL_GRID_SORT_TILE_WORDS : UKL_RADIX_GROUPS * UKL_RADIX_DIGITS + 3u * UKL_RADIX_DIGITS)
typedef struct PpTg {
    uint32_t flag;
    uint32_t scratch[UKL_TG_SCRATCH];
    uint32_t big[PP_TG_BIG];
} PpTg;

// The stage word of `GRID` (after the barrier's three): 0 the queue's first phase, 1 its second,
// 2 done.
#define PG_STAGE (3u)
// Set where P1 ends the round before the expansion (requests, or a refusal: decision 0467 §1).
#define PG_STOP (4u)

// The rows of every grid kernel: the arena, the slab, the layout, the group's memory, and where
// the thread is.
#define PP_GRID_ROWS                                                                                   \
    RWBUFFER, uint8_t,  arena, "[arena]",                                                              \
    ROBUFFER, uint8_t,  data,  "[data]",                                                               \
    ROBUFFER, uint32_t, lay,   "[slots]",                                                              \
    SHARED,   PpTg,     tg,    1,                                                                      \
    GSZ0,     uint32_t, gsz,   ,                                                                       \
    TGID0,    uint32_t, group, ,                                                                       \
    LID0,     uint32_t, lid,   ,                                                                       \
    LSZ0,     uint32_t, lsz,

#define PP_GRID_BEGIN                                                                                  \
    UklGrid g;                                                                                         \
    g.ctl = AT(uint32_t, GRID); g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;      \
    uint32_t lane = lid % UKL_SIMD_WIDTH;                                                              \
    UklGridSortLocal sl;                                                                               \
    sl.counts = tg->big; sl.h = tg->big + UKL_RADIX_GROUPS * UKL_RADIX_DIGITS;                           \
    sl.before = sl.h + UKL_RADIX_DIGITS; sl.base = sl.before + UKL_RADIX_DIGITS; sl.tile = tg->big;     \
    UKL_GLOBAL const PpFile* files = AT(const PpFile, FILES);                                              \
    uint32_t nf = W(N_FILES);                                                                              \
    uint32_t stop = 0u, phase = 0u;                                                                        \
    UklScanJob jobs[UKL_GRID_SCANS];                                                                   \
    (void)lane; (void)data; (void)files; (void)nf; (void)sl; (void)stop; (void)phase; (void)jobs;

DEFINE_KERNEL2(pp, pp_setup, PP_GRID_ROWS)
{
    PP_GRID_BEGIN
    stop = W(STOP);
    if (ukl_grid_failed(g)) return;
    uint32_t last = W(LAST);
    // --- The front: the nodes, the names, the directives, the text map, the guards ----------
    // A node a thread, and a scan or a sort between: no thread walks a file (decision 0460).
    uint32_t nn = N(TOTAL);
    EACH(n, nn) {
        pp_names(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint64_t, KEYS), nf, n);
        if (W(NODES_FLAG) != 0u) pp_nodes(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint32_t, NODES_OUT), nf, n);
        pp_node_flags(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint32_t, DFLAG), AT(uint32_t, GFLAG), AT(uint32_t, DEV), AT(uint32_t, OWNER_IN), nf, n);
    }
    BARRIER();
    JOB(0, nn, DFLAG, DRANK, DIR_TOTAL);
    JOB(1, nn, GFLAG, GRANK, N_GROUPS);
    JOB(2, nn, DEV, NDEPTH, DEV_TOTAL);
    SCANS(3);
    SEG(UKL_SEG_MAX, nn, OWNER_IN, VHEADS, OWNER);
    EACH(n, nn) pp_node_depths(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(const uint32_t, GFLAG), AT(const uint32_t, GRANK), AT(const uint32_t, OWNER), AT(uint32_t, AFLAG), AT(uint32_t, TFLAG), AT(uint64_t, GRP_KEYS), nf, n);
    BARRIER();
    JOB(0, nn, TFLAG, TRANK, TTOTAL);
    JOB(1, nn, AFLAG, ARANK, N_ARMS);
    SCANS(2);
    EACH(n, nn) {
        pp_arm_keys(AT(const uint32_t, TOTAL), AT(const uint32_t, AFLAG), AT(const uint32_t, ARANK), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(uint64_t, ARM_KEYS), n);
        pe_text_nodes(AT(const uint32_t, TFLAG), AT(const uint32_t, TRANK), AT(const uint32_t, TOTAL), AT(uint32_t, TEXT_NODES), n);
    }
    EACH(f, nf) pp_file_dirs(AT(const uint32_t, BASES), AT(const uint32_t, DRANK), AT(const uint32_t, ARANK), AT(const uint32_t, N_ARMS), AT(uint32_t, DIR_BASES), AT(uint32_t, DIR_GROUPS), nf, f);
    BARRIER();
    SORT(N(N_ARMS), 64u, ARM_KEYS, ASORT_VA, ASORT_KB, ASORT_VB, ASORT_HIST);
    SORT(N(N_GROUPS), 64u, GRP_KEYS, PSORT_VA, PSORT_KB, PSORT_VB, PSORT_HIST);
    EACH(n, nn) pp_rows(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(const uint32_t, DFLAG), AT(const uint32_t, DRANK), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(const uint32_t, TRANK), AT(const uint32_t, ARANK), AT(const uint32_t, GRANK), AT(const uint64_t, ARM_KEYS), AT(const uint32_t, N_ARMS), AT(const uint64_t, GRP_KEYS), AT(const uint32_t, N_GROUPS), AT(PpDir, ROWS), nf, n);
    BARRIER();
    EACH(r, N(DIR_TOTAL)) {
        pp_dir_keys(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(uint64_t, DIR_KEYS), AT(uint32_t, DIR_ACTS), nf, r);
        pp_guard_marks(AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(uint32_t, G_OUT), AT(uint32_t, G_ARMS), nf, r);
    }
    BARRIER();
    EACH(f, nf) pp_guards(AT(const uint32_t, BASES), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(const uint32_t, TRANK), AT(const uint32_t, TTOTAL), AT(const uint32_t, G_OUT), AT(const uint32_t, G_ARMS), AT(const uint64_t, DIR_KEYS), AT(uint32_t, GUARDED), AT(uint64_t, GUARDS), nf, f);
    if (last == 1u) return;
    // --- The definitions --------------------------------------------------------------------
    EACH(r, N(DIR_TOTAL)) pd_defs(files, data, AT(const uint32_t, BASES), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(PpDef, DEFS), AT(uint32_t, PCOUNT), AT(uint32_t, BCOUNT), nf, r);
    BARRIER();
    JOB(0, N(DIR_TOTAL), PCOUNT, PFIRST, PTOTAL);
    JOB(1, N(DIR_TOTAL), BCOUNT, IFIRST, ITOTAL);
    SCANS(2);
    EACH(s, N(PTOTAL)) pd_params(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(PpDef, DEFS), AT(const uint32_t, PFIRST), AT(const uint32_t, PTOTAL), AT(uint64_t, PKEYS), AT(uint32_t, ROOM), nf, W(VA_LO), W(VA_HI), W(CAP), s);
    BARRIER();
    EACH(s, N(ITOTAL)) pd_items(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(PpDef, DEFS), AT(const uint32_t, IFIRST), AT(const uint32_t, ITOTAL), AT(const uint64_t, PKEYS), AT(uint32_t, ITEMS), AT(uint32_t, ROOM), nf, W(CAP), s);
    if (last == 2u) return;
    // --- P1 (decision 0467): the include tree, its layout and its conditionals, iterated -----
    // Each iteration from the last one's state: the tree's words and layout (§2), the groups'
    // activity, the definitions' table (§3), the tests and the groups (§4), the includes (§5).
    // The iterations end at the first that changes nothing.
    BARRIER();
    UKL_GLOBAL PpNode* nodes = AT(PpNode, P1_NODES);
    EACH(w, W(DC)) p1_words_init(AT(uint32_t, P1_MADE), AT(uint32_t, P1_MADEF), AT(uint32_t, P1_ENTER), W(DC), w);
    EACH(r, W(P1_ITERS)) AT(uint32_t, P1_ICHANGED)[r] = 0u;
    EACH(u, W(N_UNITS)) AT(uint32_t, P1_UFIRST)[u] = PP_NONE;
    // The arena's tops past the file literals, kept for each top's reset.
    ONE(x) { UKL_GLOBAL uint32_t* c_ = AT(uint32_t, CTL); c_[6] = c_[4]; c_[7] = c_[5]; }
    BARRIER();
    uint64_t defined_key = AT(const uint64_t, IF_KEYS)[0], true_key = AT(const uint64_t, IF_KEYS)[1];
    uint32_t iter = 0u, grp_from = 0u;
    for (; iter < W(P1_ITERS); iter++) {
        uint32_t ni = N(N_INSTS);
        UKL_GLOBAL uint32_t* ichanged = AT(uint32_t, P1_ICHANGED) + iter;
        // The tree's words, and the iteration's resets.
        EACH(i, ni) p1_counts(nodes, ni, AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const uint32_t, DIR_GROUPS), AT(uint32_t, P1_NDIRS), AT(uint32_t, P1_NGAPS), AT(uint32_t, P1_GCOUNT), nf, i);
        EACH(w, W(DC)) AT(uint32_t, P1_CSIZE)[w] = 0u;
        EACH(u, W(N_UNITS)) AT(uint32_t, P1_USIZE)[u] = 0u;
        EACH(f, nf) p1_once_reset(AT(uint32_t, P1_ONCE), nf, f);
        EACH(r, W(STK_ROUNDS)) AT(uint32_t, STK_CHANGED)[r] = 0u;
        EACH(r, W(P1_JUMPS)) AT(uint32_t, P1_JCHANGED)[r] = 0u;
        ONE(x) { AT(uint32_t, N_STACK)[0] = 0u; AT(uint32_t, P1_NREQ)[0] = 0u; AT(uint32_t, P1_RNTOP)[0] = 0u; }
        // The built-ins' rows' sort keys, again (the last iteration's sort moved them).
        EACH(p, W(N_BUILTIN)) AT(uint64_t, SORT_KEYS)[p] = AT(const uint64_t, NAME_KEYS)[p] & 0xffffffff00000000ul;
        BARRIER();
        JOB(0, ni, P1_NDIRS, P1_DFIRST, N_DIRS);
        JOB(1, ni, P1_NGAPS, P1_GFIRST, N_GAPS);
        JOB(2, ni, P1_GCOUNT, P1_GRPF, P1_NGRP);
        SCANS(3);
        if (N(N_DIRS) > W(DC) || N(N_GAPS) > W(GC) || N(P1_NGRP) > W(NQ)) { ONE(x) ukl_atomic_or(AT(uint32_t, P1_FLAGS), P1_ROOM); break; }
        uint32_t nd = N(N_DIRS), ng = N(N_GAPS), nq = N(P1_NGRP);
        EACH(i, ni) p1_insts(nodes, ni, AT(const uint32_t, P1_DFIRST), AT(const uint32_t, P1_GFIRST), AT(PpInst, INSTS), AT(uint32_t, P1_LIVE), i);
