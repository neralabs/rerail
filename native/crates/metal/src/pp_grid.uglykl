        BARRIER();
        SCAN(N(N_GAPS), RSTART, RUNX, RUNTOT);
        EACH(p, N(N_GAPS)) pe_run_ends(AT(const uint32_t, GAT), AT(const uint32_t, GCOUNTS), AT(const uint32_t, RSTART), AT(const uint32_t, RUNX), AT(const uint32_t, N_GAPS), AT(uint32_t, RUN_END), p);
        BARRIER();
        // The active text past its room: the round again, at P1's next rung.
        ONE(x) AT(uint32_t, P1_NEED)[NEED_TEXT_TOP] = ukl_max(AT(uint32_t, P1_NEED)[NEED_TEXT_TOP], N(GTOTAL));
        if (N(GTOTAL) > W(TC)) { ONE(x) ukl_atomic_or(AT(uint32_t, P1_FLAGS), P1_ROOM); break; }
        EACH(p, N(N_GAPS)) p1_unit_firsts(AT(const uint32_t, SSLOT), AT(const uint32_t, N_GAPS), AT(const uint32_t, FLOORS), W(N_UNITS), AT(uint32_t, P1_UFIRST), p);
        EACH(s, N(GTOTAL)) pe_lookups(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, TEXT_NODES), AT(const uint32_t, GAT), AT(const uint32_t, N_GAPS), AT(const uint32_t, GFIRSTS), AT(const uint32_t, SSLOT), AT(const uint32_t, GTOTAL), AT(const uint64_t, SORT_KEYS), AT(const uint32_t, SORT_VA), AT(const uint32_t, N_ROWS), AT(const uint64_t, NAME_KEYS), AT(const uint32_t, VALUES), AT(const uint32_t, FLOORS), W(N_UNITS), AT(uint32_t, LOOKUPS), AT(uint32_t, TOPNODE), AT(uint32_t, TROWS), AT(uint32_t, VBAD), nf, s);
        BARRIER();
        // The top level: depth, the close table, the calls, the outermost, the lists.
        PX_RESET();
        // The facts this pass writes start empty; the last pass's key stays to compare.
        // The refusals so far are the lines' (the text's are the expansion's).
        // [10] counts the text passes (for measurements).
        // [13]: the loop's pieces (decision 0588).
        ONE(x) { PP_GLOBAL uint32_t* n_ = AT(uint32_t, TRN); n_[0] = 0u; n_[1] = 0u; n_[4] = 0u; n_[5] = 0u; n_[8] = 0u; n_[9] = AT(const uint32_t, CTL)[2]; n_[10] += 1u; n_[13] = 0u; }
        uint32_t nt = N(GTOTAL);
        // The loop (decision 0588): a piece a thread, written where it is made, then placed.
        RX_LOOP_CALL(false);
        {
            TEXT_UX(u);
            PX_COUNTERS(u, 0u);
        }
        // The facts' key against the last text pass's: the same ends the iterations.
        EACH(k, 3u * W(CNT_CAP)) tf_key(TFACTS, AT(uint32_t, CTL), k);
        BARRIER();
        ONE(x) {
            PP_GLOBAL uint32_t* n_ = AT(uint32_t, TRN);
            if (n_[4] != n_[6] || n_[5] != n_[7]) { n_[8] = 1u; n_[6] = n_[4]; n_[7] = n_[5]; }
        }
        BARRIER();
        if (AT(const uint32_t, TRN)[8] == 0u) { text_done = true; break; }
        // Not the last: its refusals are of facts the next pass changes.
        ONE(x) AT(uint32_t, CTL)[2] = AT(const uint32_t, TRN)[9];
        BARRIER();
    }
    if (iter == W(P1_ITERS)) ONE(x) ukl_atomic_or(AT(uint32_t, P1_FLAGS), P1_ITERATIONS);
    if (!text_done) ONE(x) AT(uint32_t, TRN)[9] = AT(const uint32_t, CTL)[2];
    // P1's iterations run (for measurements).
    ONE(x) AT(uint32_t, TRN)[11] = iter + (text_done ? 1u : 0u);
    TICK();
    // Requests or a refusal: the round ends here, before the expansion (§1).
    if (N(P1_FLAGS) != 0u || N(P1_NREQ) != 0u || !text_done) {
        ONE(x) AT(uint32_t, GRID)[PG_STOP] = 1u;
        return;
    }
    ONE(x) AT(uint32_t, GRID)[PG_STAGE] = 2u;
}

// The grid over one unit: every group dispatched that joins it (decision 0540 §3).
DEFINE_KERNEL2(pp, pp_setup, PP_GRID_ROWS)
{
    PP_GRID_BEGIN
    // The grid is the groups that run: a group past the count's close ends here.
    if (!ukl_grid_join(&g, gsz / lsz, tg->join)) return;
    pp_unit(arena, data, lay, tg, g __UKL_ARGS);
}

// A batch's units, a team each (decision 0588 §6): a team is one or more groups, a unit's setup
// their grid, its barriers among them alone (on the unit's grid words). `teams`: the units `n`, the
// seats taken (a counter), the seats in all, then each unit's slots' byte offset in the arena, its
// first seat and its seats. A group takes the next seat, and runs its team's unit as that team's
// group `seat - first`; then the next. The host orders the units largest first, so the teams of
// more than one group are the first wave's; and the earliest team not done has every seat taken
// before any later seat is, by a group that is running, so a team's barrier waits only for groups
// that come.
DEFINE_KERNEL2(pp, pp_teams,
               RWBUFFER, uint8_t,  arena, "[arena]",
               ROBUFFER, uint8_t,  data,  "[data]",
               RWBUFFER, uint32_t, teams, "[teams]",
               SHARED,   PpTg,     tg,    1,
               GSZ0,     uint32_t, gsz,   ,
               TGID0,    uint32_t, group, ,
               LID0,     uint32_t, lid,   ,
               LSZ0,     uint32_t, lsz,   )
{
    (void)gsz;
    if (lid == 0u) tg->hw = group;
    uint32_t n = teams[0], seats = teams[2];
    for (uint32_t turn = 0u; turn <= seats; turn++) {
        ukl_tg_barrier();
        if (lid == 0u) tg->join[0] = ukl_atomic_add(&teams[1], 1u);
        ukl_tg_barrier();
        uint32_t seat = tg->join[0];
        if (seat >= seats) break;
        uint32_t t = 0u;
        while (t + 1u < n && teams[3u + 3u * (t + 1u) + 1u] <= seat) t++;
        UKL_GLOBAL const uint32_t* e = teams + 3u + 3u * t;
        ROBUFFER(uint32_t) lay = (ROBUFFER(uint32_t))(arena + e[0]);
        UklGrid g;
        g.ctl = IN(uint32_t, GRID); g.groups = e[2]; g.group = seat - e[1]; g.lid = lid; g.lsz = lsz;
        pp_unit(arena, data, lay, tg, g __UKL_ARGS);
    }
    // No team left: the group helps the units still reading (decision 0613 §4), each loop open to it with items
    // waiting (`PG_LOOP`), from a unit of its own turn on, so the helpers spread. It registers (`PG_HELP`) before it
    // looks at the loop again, so a loop closed since is not read; it ends where every unit is done, or past its
    // bound of looks that found nothing.
    for (uint32_t look = 0u, miss = 0u; miss < RX_IDLE_POLLS; look++) {
        ukl_tg_barrier();
        if (lid == 0u) {
            uint32_t pick = 0xffffffffu, kind = 0u;
            bool open = false;
            for (uint32_t i = 0u; i < n && pick == 0xffffffffu; i++) {
                uint32_t t = (group + look + i) % n;
                ROBUFFER(uint32_t) lay = (ROBUFFER(uint32_t))(arena + teams[3u + 3u * t]);
                UKL_GLOBAL uint32_t* gc = IN(uint32_t, GRID);
                if (ukl_atomic_poll(&gc[PG_STAGE]) == 2u || ukl_atomic_poll(&gc[PG_STOP]) != 0u || (ukl_atomic_poll(&gc[2]) & 1u) != 0u) continue;
                open = true;
                uint32_t f = ukl_atomic_poll(&gc[PG_LOOP]);
                PP_GLOBAL uint32_t* q = AT(uint32_t, LPQ);
                if (f == 0u || ukl_atomic_poll(&q[1]) <= ukl_atomic_poll(&q[0])) continue;
                ukl_atomic_add(&gc[PG_HELP], 1u);
                ukl_fence_device();
                if (ukl_atomic_poll(&gc[PG_LOOP]) == f) { pick = t; kind = f; }
                else ukl_atomic_sub(&gc[PG_HELP], 1u);
            }
            tg->join[0] = pick; tg->join[1] = open ? kind : 0xffffffffu;
        }
        ukl_tg_barrier();
        uint32_t t = tg->join[0], kind = tg->join[1];
        if (kind == 0xffffffffu) return;
        if (t == 0xffffffffu) { miss++; ukl_poll_yield(); continue; }
        miss = 0u;
        UKL_GLOBAL const uint32_t* e = teams + 3u + 3u * t;
        ROBUFFER(uint32_t) lay = (ROBUFFER(uint32_t))(arena + e[0]);
        UklGrid g;
        g.ctl = IN(uint32_t, GRID); g.groups = 1u; g.group = 0u; g.lid = lid; g.lsz = lsz;
        rx_help(arena, data, lay, tg, g, kind == 2u __UKL_ARGS);
        ukl_tg_barrier();
        if (lid == 0u) { ukl_fence_device(); ukl_atomic_sub(&g.ctl[PG_HELP], 1u); }
    }
}

// A unit's refusals (`pp_check`, `pp_check_teams`): the output's room, a setup that did not reach
// its end (`X_QUEUE`), and a failed barrier (a wait past its bound, among the groups that joined the
// grid: the host's run is `BackendFailure`).
UKL_INLINE void pp_check_unit(RWBUFFER(uint8_t) arena, ROBUFFER(uint32_t) lay)
{
    PP_GLOBAL uint32_t* ctl = AT(uint32_t, CTL);
    PP_GLOBAL const uint32_t* grid = AT(const uint32_t, GRID);
    if (grid[PG_STOP] != 0u) return;
    // The failure bit (`ukl/grid.h`: the bits above it are the beats).
    if ((grid[2] & 1u) != 0u) px_refuse(ctl, X_BARRIER);
    else if (AT(const uint32_t, OPTOTAL)[0] > W(OUT_CAP)) px_refuse(ctl, X_ROOM);
    if ((grid[2] & 1u) == 0u && grid[PG_STAGE] != 2u) px_refuse(ctl, X_QUEUE);
}

// The refusals, one thread.
DEFINE_KERNEL2(pp, pp_check,
               RWBUFFER, uint8_t,  arena, "[arena]",
               ROBUFFER, uint32_t, lay,   "[slots]",
               GID0,     uint32_t, i,     )
{
    if (i == 0u) pp_check_unit(arena, lay);
}

// A batch's refusals (`pp_teams`), a thread a unit.
DEFINE_KERNEL2(pp, pp_check_teams,
               RWBUFFER, uint8_t,  arena, "[arena]",
               RWBUFFER, uint32_t, teams, "[teams]",
               GID0,     uint32_t, i,     )
{
    if (i < teams[0]) pp_check_unit(arena, (ROBUFFER(uint32_t))(arena + teams[3u + 3u * i]));
}

