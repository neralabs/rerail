        PP_GLOBAL const uint64_t* closes = ukl_grid_sort_in_input(W(CLOSE_BITS)) ? AT(const uint64_t, CLOSE_KEYS) : AT(const uint64_t, CSORT_KB);
        TICK();
        EACH(s, nt) px_top_calls(files, data, AT(const uint32_t, BASES), AT(const PpDef, DEFS), AT(const uint32_t, LOOKUPS), AT(const uint32_t, TEXT_NODES), AT(const uint32_t, GAT), AT(const uint32_t, N_GAPS), AT(const uint32_t, GFIRSTS), AT(const uint32_t, GTOTAL), TEXT_SCOPE, AT(const uint32_t, DEPTH), closes, AT(const uint32_t, CLOSE_TOTAL), AT(uint32_t, CEND), AT(uint32_t, CTL), nf, s);
        BARRIER();
        SEG(UKL_SEG_MAX, nt, CEND, EHEADS, REACH);
        EACH(s, nt) px_top_outer(AT(const uint32_t, CEND), AT(const uint32_t, REACH), AT(const uint32_t, GTOTAL), AT(uint32_t, STATE), AT(uint32_t, OFLAG), s);
        BARRIER();
        SCAN(nt, OFLAG, OID, OTOTAL);
        EACH(s, nt) px_top_lists(AT(const uint32_t, LOOKUPS), AT(const uint32_t, CEND), AT(const uint32_t, STATE), AT(const uint32_t, OID), AT(const uint32_t, GTOTAL), AT(const uint32_t, SSLOT), AT(const uint32_t, GAT), AT(const uint32_t, N_GAPS), 1u, AT(PxList, LISTS), AT(uint32_t, TRIE), W(TRIE_LV), AT(uint32_t, SLOTS), AT(uint32_t, CTL), AT(const PpDef, DEFS), W(LIST_CAP), s);
        ONE(i) px_seed(AT(const uint32_t, OTOTAL), AT(uint32_t, QCTL), AT(uint32_t, CTL), W(LIST_CAP), i);
        BARRIER();
        // The rounds, the top level's rollback, sizes and places, the places' rounds.
        PX_DRAIN_CALL(false, closes);
        PX_PLACES(TEXT, AT(const uint32_t, GTOTAL), nt);
        PX_DRAIN_CALL(false, closes);
        PX_OUT_RUNS();
        {
            TEXT_UX(u);
            PX_COUNTERS(u, 0u);
        }
        // The facts' key against the last text pass's: the same ends the iterations.
        EACH(k, 3u * W(CNT_CAP)) tf_key(TFACTS, AT(uint32_t, CTL), k);
        BARRIER();
        ONE(x) {
            PP_GLOBAL uint32_t* n_ = AT(uint32_t, TRN);
            if (n_[4] != n_[6] || n_[5] != n_[7]) { n_[8] = 1u; n_[6] = n_[4]; n_[7] = n_[5]; }
        }
        BARRIER();
        if (AT(const uint32_t, TRN)[8] == 0u) { text_done = true; break; }
        // Not the last: its refusals are of facts the next pass changes.
        ONE(x) AT(uint32_t, CTL)[2] = AT(const uint32_t, TRN)[9];
        BARRIER();
    }
    if (iter == W(P1_ITERS)) ONE(x) ukl_atomic_or(AT(uint32_t, P1_FLAGS), P1_ITERATIONS);
    if (!text_done) ONE(x) AT(uint32_t, TRN)[9] = AT(const uint32_t, CTL)[2];
    // P1's iterations run (for measurements).
    ONE(x) AT(uint32_t, TRN)[11] = iter + (text_done ? 1u : 0u);
    TICK();
    // Requests or a refusal: the round ends here, before the expansion (§1).
    if (N(P1_FLAGS) != 0u || N(P1_NREQ) != 0u || !text_done) {
        ONE(x) AT(uint32_t, GRID)[PG_STOP] = 1u;
        return;
    }
    ONE(x) AT(uint32_t, GRID)[PG_STAGE] = 2u;
}

// The refusals, one thread: the rounds' (work left, or their bound reached: `X_QUEUE`), the
// output's room, and a failed barrier (a wait past its bound, among the groups that joined the
// grid: the host's run is `BackendFailure`).
DEFINE_KERNEL2(pp, pp_check,
               RWBUFFER, uint8_t,  arena, "[arena]",
               ROBUFFER, uint32_t, lay,   "[slots]",
               GID0,     uint32_t, i,     )
{
    if (i != 0u) return;
    PP_GLOBAL uint32_t* ctl = AT(uint32_t, CTL);
    PP_GLOBAL const uint32_t* grid = AT(const uint32_t, GRID);
    if (grid[PG_STOP] != 0u) return;
    if (grid[2] != 0u) px_refuse(ctl, X_BARRIER);
    else px_check(AT(uint32_t, QCTL), AT(const uint32_t, OPTOTAL), ctl, W(OUT_CAP), 0u);
    if (grid[2] == 0u && grid[PG_STAGE] != 2u) px_refuse(ctl, X_QUEUE);
}
