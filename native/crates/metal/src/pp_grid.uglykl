// The preprocessor's evaluation as a persistent grid (decision 0468 §4): G groups of 256 threads,
// resident together, run the passes as phases, each group a share of each pass's items; a
// device-wide barrier (`ukl_grid_barrier`) separates a phase from the next, and the scans,
// segmented scans and sorts are the grid's own (`ukl/grid.h`). Every count a phase needs is read
// from the arena, so the host sizes nothing but the arena.
//
// Launches, the same for every unit:
// - `pp_setup`: the front passes, the definitions, then P1's iterations (decision 0467) with the
//   text pass inside them once they hold (decision 0485): the top level's loop (decision 0588),
//   to the output;
// - `pp_check`: the refusals.
//
// The kernels bind the arena (`arena`: every store at its offset, `lay` the offsets by slot,
// `S_*`), and the slab the unit's documents are in (`data`).

// A store, as the passes read and write it: `PP_GLOBAL`, coherent on a GPU, since a phase reads what other groups
// wrote before the barrier (`ukl/grid.h`). A store the host writes and the device only reads (`IN`: the files'
// views), or one only atomics touch (the grid's control words), is a plain device pointer.
#define AT(T, s) ((PP_GLOBAL T*)(arena + lay[S_##s]))
#define IN(T, s) ((UKL_GLOBAL T*)(arena + lay[S_##s]))
#define C32(s) ((UKL_COHERENT uint32_t*)(arena + lay[S_##s]))
#define C64(s) ((UKL_COHERENT uint64_t*)(arena + lay[S_##s]))
#define W(s) lay[S_##s]
// Each of `n` items, a thread each, over the grid.
#define EACH(t, n) for (uint32_t t = g.group * g.lsz + g.lid, t##_n = (n); t < t##_n; t += g.groups * g.lsz)
// One thread of the grid.
#define ONE(t) for (uint32_t t = 0u; g.group == 0u && g.lid == 0u && t < 1u; t++)
// A measurement's stop (`STOP`): the kernel ends before its phase `stop` (0: never). A phase
// that ends the kernel leaves it by `PX_QUIT`: a return in the kernel, a false in a phase
// function (`rx_loop`), which gives its phase count back.
#define PX_QUIT return
// A trace (`STOP` at `PP_TRACE_ON`): each phase's source line and the device's clock (`ukl_clock_ns`), written by the
// grid's first thread at the phase's tick into `GRID`'s words past the grid's 8.
#define PP_TRACE_ON 0xffffffffu
#define PP_TRACE_N 2048u
#define TICK() if (stop == PP_TRACE_ON && g.group == 0u && g.lid == 0u && phase < PP_TRACE_N) { uint64_t t_ = ukl_clock_ns(); g.ctl[8u + 3u * phase] = __LINE__; g.ctl[9u + 3u * phase] = (uint32_t)t_; g.ctl[10u + 3u * phase] = (uint32_t)(t_ >> 32); } if (++phase == stop) PX_QUIT
#define BARRIER() TICK(); if (!ukl_grid_barrier(g, &tg->flag)) PX_QUIT
// Scans sharing their barriers (`ukl_grid_scans`): `JOB(k, …)` each, then `SCANS(k)`.
#define JOB(j, n_, in_, out_, total_) jobs[j].n = (n_); jobs[j].in = C32(in_); jobs[j].out = C32(out_); jobs[j].total = C32(total_)
#define SCANS(k) TICK(); if (!ukl_grid_scans(g, jobs, (k), C32(SUMS), tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
#define SCAN(n, in, out, total) TICK(); if (!ukl_grid_scan_n(g, (n), C32(in), C32(out), C32(total), C32(SUMS), tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
#define SEG(op, n, in, heads, out) TICK(); if (!ukl_grid_seg_scan_n(g, (op), (n), C32(in), C32(heads), C32(out), C32(SUMS), tg->big, tg->big + 256u, &tg->flag __UKL_ARGS)) PX_QUIT
#define SORT(n, bits, keys, va, kb, vb, hist) TICK(); if (!ukl_grid_sort_u64(g, (n), (bits), true, C64(keys), C32(va), C64(kb), C32(vb), C32(hist), C32(SUMS), sl, tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
// A sort that carries the values given (a stable sort of rows already ordered by another key).
#define SORTV(n, bits, keys, va, kb, vb, hist) TICK(); if (!ukl_grid_sort_u64(g, (n), (bits), false, C64(keys), C32(va), C64(kb), C32(vb), C32(hist), C32(SUMS), sl, tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
// A count the passes before wrote.
#define N(s) AT(const uint32_t, s)[0]

// A top level, as the expansion's passes read it: its tokens' nodes, its stretches' first tokens
// and their count's store, their first nodes' places, and its tokens' count's store. The text's
// (its active stretches in the unit's order), and the tests' lines' (decision 0467 §4).
#define TEXT_TOP AT(const uint32_t, TEXT_NODES), AT(const uint32_t, GAT), AT(const uint32_t, N_GAPS), AT(const uint32_t, GFIRSTS), AT(const uint32_t, GTOTAL)
// Each top stretch's instance.
#define TEXT_SCOPE mk_scope(1u, AT(const uint32_t, RSTART), AT(const uint32_t, RUNX), AT(const uint32_t, RUN_END), AT(const uint32_t, SINST), AT(const uint32_t, SSLOT))
#define IF_SCOPE mk_scope(0u, AT(const uint32_t, RSTART), AT(const uint32_t, RUNX), AT(const uint32_t, RUN_END), AT(const uint32_t, IF_INST), AT(const uint32_t, DSLOT))
// The text pass's facts (decision 0485).
#define TFACTS mk_tf(AT(uint64_t, TR_SK), AT(uint64_t, TR_NK), AT(uint32_t, TR_TY), AT(uint32_t, TO_F), AT(uint32_t, TO_S), AT(uint32_t, CU_SLOT), AT(uint32_t, CU_SUB), AT(uint32_t, CU_UNIT), \
                     AT(uint32_t, TRN), W(CNT_CAP), AT(const uint32_t, RTYPES), AT(const uint32_t, LREAD))
#define TEXT_INST AT(const uint32_t, SINST), AT(const PpNode, P1_NODES), AT(const uint32_t, P1_UFILE), AT(const uint32_t, SLINE), AT(const uint32_t, SLINEN), TEXT_SCOPE, TFACTS
#define IF_INST AT(const uint32_t, IF_INST), AT(const PpNode, P1_NODES), AT(const uint32_t, P1_UFILE), AT(const uint32_t, ILINE), AT(const uint32_t, ILINEN), IF_SCOPE, TFACTS
#define IF_TOP AT(const uint32_t, IF_NODES), AT(const uint32_t, IF_AT), AT(const uint32_t, N_DIRS), AT(const uint32_t, IF_AT), AT(const uint32_t, IF_TOTAL)

// The arena and the unit over a top, as the loop reads them.
#define PX_UA(T)                                                                                       \
    Ux xu; Ar xa;                                                                                      \
    px_make(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const PpDef, DEFS), AT(const uint32_t, ITEMS), \
              AT(const uint64_t, SORT_KEYS), AT(const uint32_t, SORT_VA), AT(const uint32_t, N_ROWS), AT(const uint64_t, NAME_KEYS), \
              AT(const uint32_t, VALUES), T##_TOP, T##_INST,                                          \
              AT(uint32_t, TOKENS), AT(uint32_t, OUT), AT(uint32_t, CTL), AT(const uint32_t, WORDS), AT(PxScratch, SCRATCH), AT(const uint32_t, FLOORS), W(N_UNITS), \
              AT(const uint64_t, IF_OPKEYS), AT(const uint32_t, IF_OPKINDS), W(N_IFOP), AT(const uint64_t, IF_FEATKEYS), AT(const uint64_t, IF_FEATVALS), W(N_FEAT), \
              AT(uint32_t, CNT), W(CNT_CAP), AT(const uint32_t, LDELTA), AT(const uint32_t, LCTL)[0], &xu, &xa); \
    xu.vai = AT(const uint32_t, VAI); xu.irows = AT(const uint32_t, IROWS); xu.trows = AT(const uint32_t, TROWS);                         \
    xa.lpq = AT(uint32_t, LPQ); xa.lpq_top = W(LPQ_TOP);                                               \
    xu.tnode = is_if ? AT(const uint32_t, IF_NODES) : AT(const uint32_t, TOPNODE)

// The arena made ready for another top: its fronts back to the file literals' (`CTL` 6 and 7 keep
// them). The refusals stay.
#define PX_RESET()                                                                                     \
    ONE(x) {                                                                                           \
        PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);                                                    \
        /* Each top's high water first (`Exp::room` sizes the next run from it). */                     \
        c_[8] = ukl_max(c_[8], c_[0]); c_[11] = ukl_max(c_[11], c_[4]); c_[12] = ukl_max(c_[12], c_[5]); \
        c_[14] = ukl_max(c_[14], AT(const uint32_t, OPTOTAL)[0]);                                       \
        c_[0] = 0u; c_[4] = c_[6]; c_[5] = c_[7]; c_[26] = 0u;                                         \
        AT(uint32_t, CNT)[1] = 0u;                                                                     \
    }                                                                                                  \
    BARRIER()

// `__COUNTER__`'s uses of the top just expanded placed, then counted (decision 0485 §3): `part`
// 0 the text, 1 the lines.
#define PX_COUNTERS(u, part)                                                                              \
    if (ukl_min(AT(const uint32_t, CNT)[1], W(CNT_CAP)) != 0u) {                                       \
        /* The uses wrote their places themselves (`lp_counter`); the ranking's rows are twice the \
           counters' room (`SC_CAP`). */                                                               \
        ONE(x) AT(uint32_t, TRN)[2u + (part)] = ukl_min(AT(const uint32_t, CNT)[1], W(CNT_CAP));    \
        BARRIER();                                                                                 \
        /* The uses of both passes ranked (`px_cv_*`). */                                          \
        Tf tf_ = TFACTS;                                                                           \
        uint32_t m0_ = ukl_min(tf_.n[2], tf_.cap), cm_ = m0_ + ukl_min(tf_.n[3], tf_.cap);        \
        EACH(c, cm_) px_cv_key(tf_, m0_, cm_, AT(uint64_t, SC_CKEYS), c);                          \
        SORT(cm_, 32u, SC_CKEYS, SC_VA, SC_KB, SC_VB, SC_HIST);                                    \
        EACH(p, cm_) px_cv_key2(tf_, m0_, cm_, AT(uint64_t, SC_CKEYS), AT(const uint32_t, SC_VA), p); \
        SORTV(cm_, 64u, SC_CKEYS, SC_VA, SC_KB, SC_VB, SC_HIST);                                   \
        EACH(p, cm_) px_cv_heads(tf_, m0_, cm_, AT(const uint32_t, SC_VA), AT(uint32_t, SC_CLOSE), AT(uint32_t, SC_CEND), AT(uint32_t, SC_REACH), p); \
        BARRIER();                                                                                 \
        SEG(UKL_SEG_MAX, cm_, SC_CLOSE, SC_REACH, SC_LIVE);                                        \
        SEG(UKL_SEG_MAX, cm_, SC_CEND, SC_REACH, SC_RANK);                                         \
        EACH(p, cm_) px_cv_rank(cm_, AT(const uint32_t, SC_VA), AT(const uint32_t, SC_LIVE), AT(const uint32_t, SC_RANK), AT(uint32_t, SC_DEPTH), p); \
        BARRIER();                                                                                 \
        EACH(i, W(CNT_CAP)) px_counter_value(tf_, AT(const uint32_t, CNT), W(CNT_CAP), (part), AT(PxScratch, SCRATCH), \
                                             (PP_GLOBAL uint8_t*)(AT(PxScratch, SCRATCH) + AT(const uint32_t, WORDS)[9]), AT(const uint32_t, SC_DEPTH), i); \
        BARRIER();                                                                                 \
    } else {                                                                                           \
        ONE(x) AT(uint32_t, TRN)[2u + (part)] = 0u;                                                    \
        BARRIER();                                                                                     \
    }

// The unit as the text's counters read it: its stretches in the unit's order, their instances
// and slots.
#define TEXT_UX(u)                                                                                     \
    Ux u;                                                                                              \
    u.nodes = AT(const PpNode, P1_NODES); u.tinst = AT(const uint32_t, SINST); u.gat = AT(const uint32_t, GAT); \
    u.n_gaps = N(N_GAPS); u.sc = TEXT_SCOPE

// The file table and the requests, as the tests' and the includes' passes read them.
#define IF_FILES(fx, nm)                                                                               \
    IfFiles fx;                                                                                        \
    fx.ft_keys = AT(const uint64_t, P1_FTKEYS); fx.ft_files = AT(const uint32_t, P1_FTFILES); fx.n_ft = W(N_FT); \
    fx.found_by = AT(const uint32_t, P1_FOUNDBY); fx.unit_file = AT(const uint32_t, P1_UFILE); fx.reqs = AT(PpReq, P1_REQS); \
    fx.n_reqs = AT(uint32_t, P1_NREQ); fx.req_cap = W(RQC); fx.flags = AT(uint32_t, P1_FLAGS); fx.grid = g.ctl; \
    IfNames nm;                                                                                        \
    nm.bytes = AT(uint8_t, P1_RNAMES); nm.top = AT(uint32_t, P1_RNTOP); nm.cap = W(RNC)

// The unit as the tests' passes read it (`Ux`): its files, definitions and table, and the tests'
// lines as its top.
#define IF_UX(u)                                                                                       \
    Ux u;                                                                                              \
    u.files = files; u.data = data; u.bases = AT(const uint32_t, BASES); u.n_files = nf; u.keys = AT(const uint64_t, KEYS); \
    u.defs = AT(const PpDef, DEFS); u.items = AT(const uint32_t, ITEMS); u.vai = AT(const uint32_t, VAI); u.irows = AT(const uint32_t, IROWS); u.trows = AT(const uint32_t, TROWS); u.tnode = AT(const uint32_t, IF_NODES); u.sorted = AT(const uint64_t, SORT_KEYS);          \
    u.perm = AT(const uint32_t, SORT_VA); u.n_rows = N(N_ROWS); u.name_keys = AT(const uint64_t, NAME_KEYS);                 \
    u.values = AT(const uint32_t, VALUES); u.text_nodes = AT(const uint32_t, IF_NODES); u.gat = AT(const uint32_t, IF_AT);  \
    u.n_gaps = N(N_DIRS); u.firsts = AT(const uint32_t, IF_AT); u.n_toks = N(IF_TOTAL);                                     \
    u.stoks = AT(const PxScratch, SCRATCH);                                                                                   \
    u.sbytes = (PP_GLOBAL const uint8_t*)(AT(const PxScratch, SCRATCH) + AT(const uint32_t, WORDS)[9]);                      \
    u.relex_options = 0u;                                                                                                     \
    u.floors = AT(const uint32_t, FLOORS); u.n_units = W(N_UNITS); u.tinst = AT(const uint32_t, IF_INST); u.nodes = AT(const PpNode, P1_NODES); \
    u.unit_file = AT(const uint32_t, P1_UFILE); u.op_keys = AT(const uint64_t, IF_OPKEYS); u.op_kinds = AT(const uint32_t, IF_OPKINDS); \
    u.n_ops = W(N_IFOP); u.feat_keys = AT(const uint64_t, IF_FEATKEYS); u.feat_vals = AT(const uint64_t, IF_FEATVALS); u.n_feat = W(N_FEAT); \
    u.tline = AT(const uint32_t, ILINE); u.tlinen = AT(const uint32_t, ILINEN); u.ldelta = AT(const uint32_t, LDELTA); u.lt0 = AT(const uint32_t, LCTL)[0]; \
    u.sc = IF_SCOPE

// A group's threadgroup memory: the barrier's flag, the scans' scratch, and the sorts' counts or
// a sorted tile (the segmented scans' two rows alias them: no phase runs two of them).
#define PP_TG_BIG UKL_GRID_SORT_WORDS
typedef struct PpTg {
    uint32_t flag;
    // The group's ticket and the grid's count (`ukl_grid_join`).
    uint32_t join[2];
    // The group's place in its dispatch: a team's group or a helper, it reads one unit at a time.
    uint32_t hw;
    uint32_t scratch[UKL_TG_SCRATCH];
    uint32_t big[PP_TG_BIG];
} PpTg;


// The stage word of `GRID` (after the grid's four: the barrier's three and the join's tickets,
// `ukl/grid.h`): 2 where the setup reached its end.
#define PG_STAGE (4u)
// Set where P1 ends the round before the expansion (requests, or a refusal: decision 0467 §1).
#define PG_STOP (5u)
// The unit's loop open to helpers (decision 0613 §4: a group with no team left reads another unit's items,
// `rx_help`): 0 closed, 1 the text's, 2 the tests' lines'; and the helpers in it now, whom the team waits out
// before its queue is emptied for another loop.
#define PG_LOOP (6u)
#define PG_HELP (7u)
// A team's wait for its helpers to leave, at most (they poll an empty queue `RX_HELP_POLLS` times).
#define PG_HELP_WAIT (1u << 20)

// The rows of every grid kernel: the arena, the slab, the layout, the group's memory, and where
// the thread is.
#define PP_GRID_ROWS                                                                                   \
    RWBUFFER, uint8_t,  arena, "[arena]",                                                              \
    ROBUFFER, uint8_t,  data,  "[data]",                                                               \
    ROBUFFER, uint32_t, lay,   "[slots]",                                                              \
    SHARED,   PpTg,     tg,    1,                                                                      \
    GSZ0,     uint32_t, gsz,   ,                                                                       \
    TGID0,    uint32_t, group, ,                                                                       \
    LID0,     uint32_t, lid,   ,                                                                       \
    LSZ0,     uint32_t, lsz,

// The grid sort's threadgroup words, in the group's `big` (`ukl/grid.h`'s `UklGridSortLocal`).
#define PP_SORT_LOCAL                                                                                  \
    UklGridSortLocal sl;                                                                               \
    sl.counts = tg->big; sl.h = tg->big + UKL_RADIX_GROUPS * UKL_RADIX_DIGITS;                           \
    sl.before = sl.h + UKL_RADIX_DIGITS; sl.base = sl.before + UKL_RADIX_DIGITS;                          \
    sl.digits = sl.base + UKL_RADIX_DIGITS; sl.tile = tg->big

#define PP_GRID_BEGIN                                                                                  \
    UklGrid g;                                                                                         \
    g.ctl = IN(uint32_t, GRID); g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;      \
    if (lid == 0u) tg->hw = group;                                                                     \
    ukl_tg_barrier();                                                                                  \
    PP_SORT_LOCAL;                                                                                     \
    UKL_GLOBAL const PpFile* files = IN(const PpFile, FILES);                                              \
    uint32_t nf = W(N_FILES);                                                                              \
    uint32_t stop = 0u, phase = 0u;                                                                        \
    UklScanJob jobs[UKL_GRID_SCANS];                                                                   \
    (void)data; (void)files; (void)nf; (void)sl; (void)stop; (void)phase; (void)jobs;

// A top as the loop reads it (`rx_loop`, compiled once for both calls): the tests' lines (`is_if`)
// or the text.
#define DR_TOP                                                                                         \
    is_if ? AT(const uint32_t, IF_NODES) : AT(const uint32_t, TEXT_NODES),                             \
    is_if ? AT(const uint32_t, IF_AT) : AT(const uint32_t, GAT),                                       \
    is_if ? AT(const uint32_t, N_DIRS) : AT(const uint32_t, N_GAPS),                                   \
    is_if ? AT(const uint32_t, IF_AT) : AT(const uint32_t, GFIRSTS),                                   \
    is_if ? AT(const uint32_t, IF_TOTAL) : AT(const uint32_t, GTOTAL)
#define DR_INST                                                                                        \
    is_if ? AT(const uint32_t, IF_INST) : AT(const uint32_t, SINST), AT(const PpNode, P1_NODES),       \
    AT(const uint32_t, P1_UFILE),                                                                      \
    is_if ? AT(const uint32_t, ILINE) : AT(const uint32_t, SLINE),                                     \
    is_if ? AT(const uint32_t, ILINEN) : AT(const uint32_t, SLINEN),                                   \
    mk_scope(is_if ? 0u : 1u, AT(const uint32_t, RSTART), AT(const uint32_t, RUNX), AT(const uint32_t, RUN_END), \
             is_if ? AT(const uint32_t, IF_INST) : AT(const uint32_t, SINST),                          \
             is_if ? AT(const uint32_t, DSLOT) : AT(const uint32_t, SSLOT)),                           \
    TFACTS
// What the requests read besides the unit (`RxIn`): the tops' lookups, the lines' marks and states, the tops'
// requests (`XFLAG`), the counts, the rows, the tops' places.
#define RX_IN(in)                                                                                      \
    RxIn in;                                                                                           \
    in.lookups = AT(const uint32_t, LOOKUPS); in.ops = AT(const uint32_t, IF_OPS); in.state = AT(uint32_t, STATE); \
    in.tops = AT(uint32_t, XFLAG); in.trn = AT(uint32_t, TRN); in.xrows = AT(uint32_t, XROWS); in.xrows_cap = W(XROWS_CAP); \
    in.obase = AT(uint32_t, OBASE); in.is_if = is_if ? 1u : 0u;                                       \
    in.close = AT(const uint32_t, DEPTH); in.tp0 = AT(const uint32_t, LOB); in.tp1 = AT(const uint32_t, PLAST); \
    in.tpt0 = AT(const uint32_t, XTOTAL); in.tpt1 = AT(const uint32_t, VTOTAL);                       \
    in.nt = (is_if ? AT(const uint32_t, IF_TOTAL) : AT(const uint32_t, GTOTAL))[0]
// A helper's reading of the loop open at `lay` (`PG_LOOP`: the tests' lines' where `is_if`), by a group with no
// team left (`pp_teams`): the unit's items until its queue has none active.
UKL_ONCE void rx_help(RWBUFFER(uint8_t) arena, ROBUFFER(uint8_t) data, ROBUFFER(uint32_t) lay, UKL_LOCAL PpTg* tg, UklGrid g, bool is_if __UKL_PARAMS)
{
    UKL_GLOBAL const PpFile* files = IN(const PpFile, FILES);
    (void)files; (void)tg;
    PX_UA(DR);
    RX_IN(in);
    rx_work(xu, xa, in, g.lid & (UKL_SIMD_WIDTH - 1u), RX_HELP_POLLS __UKL_ARGS);
}
#undef PX_QUIT
#define PX_QUIT return (*phasep = phase, false)
// The unit's queue emptied for a loop's next stage (its helpers gone first, `PG_HELP`: one still polling would take
// this stage's items as the last one's), its items pushed, the groups' workers (and helpers) until none is active.
#define RX_QUEUE_RESET()                                                                               \
    ONE(x) {                                                                                           \
        uint32_t t = 0u;                                                                               \
        for (; t < PG_HELP_WAIT && ukl_atomic_poll(&g.ctl[PG_HELP]) != 0u; t++) ukl_poll_yield();      \
        if (t == PG_HELP_WAIT) px_refuse(AT(uint32_t, CTL), X_ROOM);                                   \
    }                                                                                                  \
    BARRIER();                                                                                         \
    EACH(i, ukl_min(AT(const uint32_t, LPQ)[0], qcap)) AT(uint32_t, LPQ)[RXQ_CTL + i] = 0u;            \
    BARRIER();                                                                                         \
    ONE(x) for (uint32_t i = 0u; i < 5u; i++) AT(uint32_t, LPQ)[i] = 0u;                               \
    BARRIER()
#define RX_WORK()                                                                                      \
    ONE(x) { ukl_fence_device(); ukl_atomic_store(&g.ctl[PG_LOOP], is_if ? 2u : 1u); }                 \
    {                                                                                                  \
        PX_UA(DR);                                                                                     \
        RX_IN(in);                                                                                     \
        EACH(s, g.groups * g.lsz) rx_work(xu, xa, in, g.lid & (UKL_SIMD_WIDTH - 1u), RX_IDLE_POLLS __UKL_ARGS); \
    }                                                                                                  \
    BARRIER();                                                                                         \
    ONE(x) ukl_atomic_store(&g.ctl[PG_LOOP], 0u);                                                      \
    /* Items left (an idle bound reached) or the queue past its room: refused. */                      \
    ONE(x) if (AT(const uint32_t, LPQ)[2] != 0u || AT(const uint32_t, LPQ)[3] != 0u) px_refuse(AT(uint32_t, CTL), X_ROOM); \
    BARRIER()
// The expansion of a top (decision 0613; notes t51), compiled once for the text and the tests' lines (`is_if`):
// each run a request, every call a request found by its key or made, run by the SIMD groups from a queue with
// continuations (`pp_req.uglykl`); then the roll-up: the tops' places and rows by scans, the occurrences and rows
// top down, the pieces written where they go and sorted by their places.
UKL_ONCE bool rx_loop(RWBUFFER(uint8_t) arena, ROBUFFER(uint8_t) data, ROBUFFER(uint32_t) lay, UKL_LOCAL PpTg* tg,
                      UklGrid g, UKL_PRIVATE uint32_t* phasep, uint32_t stop, bool is_if __UKL_PARAMS)
{
    PP_SORT_LOCAL;
    UKL_GLOBAL const PpFile* files = IN(const PpFile, FILES);
    uint32_t phase = *phasep;
    UklScanJob jobs[UKL_GRID_SCANS];
    (void)sl; (void)jobs; (void)files;
    PP_GLOBAL const uint32_t* toks = is_if ? AT(const uint32_t, IF_TOTAL) : AT(const uint32_t, GTOTAL);
    uint32_t nt = toks[0];
    uint32_t tc = AT(const uint32_t, WORDS)[1], qcap = 8u * W(LPQ_TOP) + 64u + tc / 3u;
    // The memo's table at the heap's front: a power of two of slots, four words each, at most half a word a room token.
    uint32_t mslots = 16u;
    while (mslots * 2u * 4u <= tc && mslots < (1u << 24)) mslots *= 2u;
    ONE(x) {
        PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);
        c_[RX_MSLOTS] = mslots; c_[RX_FRONT] = 4u * mslots; c_[RX_PIECES] = 0u; c_[0] = 0u;
        // Record ids are heap words below 2^30 (`QI_KIND`'s bits above them). The queue's counts from 0 (`RXS_*`).
        if (RX_HEAP * tc >= (1u << 30) - 64u) px_refuse(c_, X_ROOM);
        for (uint32_t i = 5u; i < RXQ_CTL; i++) AT(uint32_t, LPQ)[i] = 0u;
    }
    RX_QUEUE_RESET();
    EACH(i, 4u * mslots) AT(uint32_t, TOKENS)[i] = 0u;
    // The top text's parentheses paired and its prefix hashes (`rx_top_terms`; t51 §3): its depth by a scan, its
    // pairs by a sort by depth and place.
    {
        PX_UA(DR);
        EACH(s, nt) rx_top_terms(xu, AT(uint32_t, DELTA), AT(uint32_t, XAT), AT(uint32_t, XPOS), s);
    }
    BARRIER();
    SCAN(nt, DELTA, THEADS, OPTOTAL);
    SCAN(nt, XAT, LOB, XTOTAL);
    SCAN(nt, XPOS, PLAST, VTOTAL);
    {
        PX_UA(DR);
        EACH(s, nt) rx_top_keys(xu, AT(const uint32_t, THEADS), AT(uint64_t, OKEYS), AT(uint32_t, OVA), AT(uint32_t, DEPTH), s);
    }
    BARRIER();
    SORT(nt, 64u, OKEYS, OVA, OKB, OVB, OHIST);
    {
        PX_UA(DR);
        EACH(i, nt) rx_top_pairs(xu, AT(const uint64_t, OKEYS), AT(const uint32_t, OVA), AT(uint32_t, DEPTH), nt, i);
    }
    BARRIER();
    // Each run's pieces (`rx_cut`): the cuts by three passes, in stores the windows take later (`V`, `OPV`), and
    // bit 0 of each token's state.
    {
        PX_UA(DR);
        EACH(s, nt) rx_cut_base(xu, AT(const uint32_t, THEADS), AT(uint32_t, V), AT(uint32_t, OPV), nt, s);
    }
    BARRIER();
    {
        PX_UA(DR);
        EACH(s, nt) rx_cut_low(xu, AT(const uint32_t, THEADS), AT(const uint32_t, V), AT(uint32_t, OPV), nt, s);
    }
    BARRIER();
    {
        PX_UA(DR);
        RX_IN(in);
        EACH(s, nt) rx_cut(xu, in, AT(const uint32_t, THEADS), AT(const uint32_t, V), AT(const uint32_t, OPV), nt, s);
    }
    BARRIER();
    // The pieces in windows, each run on an empty heap (its memo table too): its requests, the tops' lengths and
    // rows (their places and first rows by scans, after the windows' before), the occurrences and their rows, the
    // pieces written where they go. A window whose heap ran past its room runs again from its start, half as wide
    // (what it wrote undone: the scratch's, the pieces', the counters' and the text facts' counts, the refusals); a
    // piece alone past it refuses the unit (`X_ROOM`: it runs again larger). A unit that fits is one window.
    uint32_t w0 = 0u, span = nt, ocarry = 0u, rcarry = 0u, most = 0u;
    for (uint32_t turn = 0u; w0 < nt && turn < (1u << 20); turn++) {
        ONE(x) {
            PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);
            PP_GLOBAL const uint32_t* st_ = AT(const uint32_t, STATE);
            uint32_t e = span < nt - w0 ? w0 + span : nt;
            while (e < nt && (st_[e] & 1u) == 0u) e++;
            uint32_t n2 = w0 + 1u;
            while (n2 < nt && (st_[n2] & 1u) == 0u) n2++;
            c_[RX_WEND] = e; c_[RX_WONE] = n2 >= e ? 1u : 0u;
        }
        BARRIER();
        uint32_t w1 = AT(const uint32_t, CTL)[RX_WEND], one = AT(const uint32_t, CTL)[RX_WONE];
        uint32_t sv2 = AT(const uint32_t, CTL)[2], sv4 = AT(const uint32_t, CTL)[4], sv5 = AT(const uint32_t, CTL)[5];
        uint32_t svp = AT(const uint32_t, CTL)[RX_PIECES], svc = AT(const uint32_t, CNT)[1];
        uint32_t svt0 = AT(const uint32_t, TRN)[0], svt1 = AT(const uint32_t, TRN)[1], svt2 = AT(const uint32_t, TRN)[2];
        uint32_t svt3 = AT(const uint32_t, TRN)[3], svt4 = AT(const uint32_t, TRN)[4], svt5 = AT(const uint32_t, TRN)[5];
        uint32_t svq5 = AT(const uint32_t, LPQ)[5], svq6 = AT(const uint32_t, LPQ)[6], svq11 = AT(const uint32_t, LPQ)[11];
        uint32_t svq12 = AT(const uint32_t, LPQ)[12], svq13 = AT(const uint32_t, LPQ)[13];
        BARRIER();
        ONE(x) {
            PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);
            c_[RX_FRONT] = 4u * mslots; c_[RX_FULL] = 0u;
        }
        EACH(i, 4u * mslots) AT(uint32_t, TOKENS)[i] = 0u;
        RX_QUEUE_RESET();
        {
            PX_UA(DR);
            RX_IN(in);
            EACH(k, w1 - w0) rx_top(xu, xa, in, toks, w0 + k);
        }
        BARRIER();
        RX_WORK();
        bool ok = AT(const uint32_t, CTL)[RX_FULL] == 0u;
        if (ok) {
            {
                PX_UA(DR);
                RX_IN(in);
                EACH(s, nt) {
                    if (s >= w0 && s < w1) rx_roll_count(xa, in, toks, AT(uint32_t, V), AT(uint32_t, OPV), s);
                    else { AT(uint32_t, V)[s] = 0u; AT(uint32_t, OPV)[s] = 0u; }
                }
            }
            BARRIER();
            SCAN(nt, V, OVA, VTOTAL);
            SCAN(nt, OPV, OVB, OPTOTAL);
            EACH(k, w1 - w0) {
                AT(uint32_t, OBASE)[w0 + k] = AT(const uint32_t, OVA)[w0 + k] + ocarry;
                AT(uint32_t, OPBASE)[w0 + k] = AT(const uint32_t, OVB)[w0 + k] + rcarry;
            }
            ONE(x) {
                PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);
                c_[26] = rcarry + AT(const uint32_t, OPTOTAL)[0];
                if (c_[26] > W(XROWS_CAP)) px_refuse(c_, X_ROOM);
            }
            BARRIER();
            uint32_t r1 = ukl_min(AT(const uint32_t, CTL)[26], W(XROWS_CAP)), wv = AT(const uint32_t, VTOTAL)[0];
            // Every counted row empty until its occurrence makes it: a run cut short leaves rows unmade, and `rx_row`
            // reads only the made ones, never an earlier run's.
            EACH(k, r1 > rcarry ? r1 - rcarry : 0u) AT(uint32_t, XROWS)[3u * (rcarry + k)] = 0u;
            BARRIER();
            // The occurrences, top down, and their rows.
            RX_QUEUE_RESET();
            {
                PX_UA(DR);
                RX_IN(in);
                EACH(k, w1 - w0) rx_root(xa, in, toks, AT(const uint32_t, OPBASE), w0 + k);
            }
            BARRIER();
            RX_WORK();
            ok = AT(const uint32_t, CTL)[RX_FULL] == 0u;
            if (ok) {
                {
                    PX_UA(DR);
                    RX_IN(in);
                    EACH(k, r1 > rcarry ? r1 - rcarry : 0u) rx_row(xu, xa, in, rcarry + k);
                }
                BARRIER();
                // The pieces, each where it goes.
                RX_QUEUE_RESET();
                {
                    PX_UA(DR);
                    RX_IN(in);
                    EACH(k, w1 - w0) rx_root_emit(xa, in, toks, AT(const uint32_t, OBASE), w0 + k);
                }
                BARRIER();
                RX_WORK();
                ok = AT(const uint32_t, CTL)[RX_FULL] == 0u;
            }
            if (ok) { ocarry += wv; rcarry = r1; }
        }
        most = ukl_max(most, AT(const uint32_t, CTL)[RX_FRONT]);
        if (ok) {
            // The next window as wide again as this one's span, twice it once it fitted.
            w0 = w1;
            span = span < (nt >> 1) ? 2u * span : nt;
        } else {
            // Undone: what the window wrote past where it started.
            ONE(x) {
                PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);
                c_[2] = one != 0u ? sv2 | X_ROOM : sv2;
                c_[4] = sv4; c_[5] = sv5; c_[RX_PIECES] = svp; AT(uint32_t, CNT)[1] = svc;
                PP_GLOBAL uint32_t* t_ = AT(uint32_t, TRN);
                t_[0] = svt0; t_[1] = svt1; t_[2] = svt2; t_[3] = svt3; t_[4] = svt4; t_[5] = svt5;
                // The queue's counts (`RXS_*`): a drained window's waits were never resumed. A unit refused keeps
                // its requests, hits and steps (the log's: how far its window went).
                PP_GLOBAL uint32_t* q_ = AT(uint32_t, LPQ);
                q_[11] = svq11; q_[12] = svq12;
                if (one == 0u) { q_[5] = svq5; q_[6] = svq6; q_[13] = svq13; }
            }
            BARRIER();
            if (one != 0u) break;
            span = ukl_max((w1 - w0) / 2u, 1u);
        }
    }
    // The output past its room: refused, the next run sized from it (`CTL` 14); the heap's use, the most a window
    // took, as the tokens' rows (`CTL` 0: `Exp::room`) and its front (`RX_FRONT`: `Exp::heap`); the text's length.
    uint32_t np = ukl_min(AT(const uint32_t, CTL)[RX_PIECES], W(OUT_CAP));
    ONE(x) {
        PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);
        c_[14] = ukl_max(c_[14], c_[RX_PIECES]);
        if (c_[RX_PIECES] > W(OUT_CAP)) px_refuse(c_, X_ROOM);
        // The rows past their room (`XROWS_CAP`, a quarter of the tokens' rows) as 4 heap rows each.
        c_[0] = ukl_max((most + RX_HEAP - 1u) / RX_HEAP, c_[26] > W(XROWS_CAP) ? 4u * c_[26] : 0u);
        c_[RX_FRONT] = most;
        AT(uint32_t, OPTOTAL)[0] = np;
        AT(uint32_t, VTOTAL)[0] = ocarry;
    }
    // Their order: sorted by their places (the output's sixth column).
    EACH(i, np) {
        AT(uint64_t, OKEYS)[i] = (uint64_t)AT(const uint32_t, OUT)[3u * W(OUT_CAP) + i];
        AT(uint32_t, OVA)[i] = i;
    }
    BARRIER();
    SORT(np, 32u, OKEYS, OVA, OKB, OVB, OHIST);
    EACH(i, np) AT(uint32_t, OUT)[5u * W(OUT_CAP) + i] = AT(const uint32_t, OVA)[i];
    BARRIER();
    // A run's pieces' top text written by each its own (`rx_cut`): contiguous ones one piece, the order compacted.
    EACH(k, np) rx_piece_head(AT(const uint32_t, OUT), W(OUT_CAP), AT(uint32_t, OVB), k);
    BARRIER();
    SCAN(np, OVB, OKB, OPTOTAL);
    EACH(k, np) rx_piece_merge(AT(uint32_t, OUT), W(OUT_CAP), AT(const uint32_t, OVB), AT(const uint32_t, OKB), AT(uint32_t, OVA), np, k);
    BARRIER();
    EACH(i, AT(const uint32_t, OPTOTAL)[0]) AT(uint32_t, OUT)[5u * W(OUT_CAP) + i] = AT(const uint32_t, OVA)[i];
    BARRIER();
    *phasep = phase;
    return true;
}
#undef PX_QUIT
#define PX_QUIT return
#define RX_LOOP_CALL(is_if) if (!rx_loop(arena, data, lay, tg, g, &phase, stop, (is_if) __UKL_ARGS)) return

// One unit's setup over the arena laid out as `lay`, by the grid `g`: the whole dispatch's groups
// (`pp_setup`), or one group, the unit's team (`pp_teams`, decision 0588 §6), whose barriers are its
// own threadgroup's.
UKL_ONCE void pp_unit(RWBUFFER(uint8_t) arena, ROBUFFER(uint8_t) data, ROBUFFER(uint32_t) lay, UKL_LOCAL PpTg* tg, UklGrid g __UKL_PARAMS)
{
    PP_SORT_LOCAL;
    UKL_GLOBAL const PpFile* files = IN(const PpFile, FILES);
    uint32_t nf = W(N_FILES);
    uint32_t stop = 0u, phase = 0u;
    UklScanJob jobs[UKL_GRID_SCANS];
    (void)data; (void)files; (void)nf; (void)sl; (void)stop; (void)phase; (void)jobs;
    stop = W(STOP);
    if (ukl_grid_failed(g)) return;
    uint32_t last = W(LAST);
    // --- The front: the nodes, the names, the directives, the text map, the guards ----------
    // A node a thread, and a scan or a sort between: no thread walks a file (decision 0468).
    uint32_t nn = N(TOTAL);
    EACH(n, nn) {
        pp_names(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint64_t, KEYS), nf, n);
        if (W(NODES_FLAG) != 0u) pp_nodes(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint32_t, NODES_OUT), nf, n);
        pp_node_flags(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint32_t, DFLAG), AT(uint32_t, GFLAG), AT(uint32_t, DEV), AT(uint32_t, OWNER_IN), nf, n);
    }
    BARRIER();
    JOB(0, nn, DFLAG, DRANK, DIR_TOTAL);
    JOB(1, nn, GFLAG, GRANK, N_GROUPS);
    JOB(2, nn, DEV, NDEPTH, DEV_TOTAL);
    SCANS(3);
    SEG(UKL_SEG_MAX, nn, OWNER_IN, VHEADS, OWNER);
    EACH(n, nn) pp_node_depths(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(const uint32_t, GFLAG), AT(const uint32_t, GRANK), AT(const uint32_t, OWNER), AT(uint32_t, AFLAG), AT(uint32_t, TFLAG), AT(uint64_t, GRP_KEYS), nf, n);
    BARRIER();
    JOB(0, nn, TFLAG, TRANK, TTOTAL);
    JOB(1, nn, AFLAG, ARANK, N_ARMS);
    SCANS(2);
    EACH(n, nn) {
        pp_arm_keys(AT(const uint32_t, TOTAL), AT(const uint32_t, AFLAG), AT(const uint32_t, ARANK), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(uint64_t, ARM_KEYS), n);
        pe_text_nodes(AT(const uint32_t, TFLAG), AT(const uint32_t, TRANK), AT(const uint32_t, TOTAL), AT(uint32_t, TEXT_NODES), n);
    }
    EACH(f, nf) pp_file_dirs(AT(const uint32_t, BASES), AT(const uint32_t, DRANK), AT(const uint32_t, ARANK), AT(const uint32_t, N_ARMS), AT(uint32_t, DIR_BASES), AT(uint32_t, DIR_GROUPS), nf, f);
    BARRIER();
    SORT(N(N_ARMS), 64u, ARM_KEYS, ASORT_VA, ASORT_KB, ASORT_VB, ASORT_HIST);
    SORT(N(N_GROUPS), 64u, GRP_KEYS, PSORT_VA, PSORT_KB, PSORT_VB, PSORT_HIST);
    EACH(n, nn) pp_rows(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(const uint32_t, DFLAG), AT(const uint32_t, DRANK), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(const uint32_t, TRANK), AT(const uint32_t, ARANK), AT(const uint32_t, GRANK), AT(const uint64_t, ARM_KEYS), AT(const uint32_t, N_ARMS), AT(const uint64_t, GRP_KEYS), AT(const uint32_t, N_GROUPS), AT(PpDir, ROWS), nf, n);
    BARRIER();
    EACH(r, N(DIR_TOTAL)) {
        pp_dir_keys(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(uint64_t, DIR_KEYS), AT(uint32_t, DIR_ACTS), nf, r);
        pp_guard_marks(AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(uint32_t, G_OUT), AT(uint32_t, G_ARMS), nf, r);
    }
    BARRIER();
    EACH(f, nf) pp_guards(AT(const uint32_t, BASES), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(const uint32_t, TRANK), AT(const uint32_t, TTOTAL), AT(const uint32_t, G_OUT), AT(const uint32_t, G_ARMS), AT(const uint64_t, DIR_KEYS), AT(uint32_t, GUARDED), AT(uint64_t, GUARDS), nf, f);
    if (last == 1u) return;
    // --- The definitions --------------------------------------------------------------------
    EACH(r, N(DIR_TOTAL)) pd_defs(files, data, AT(const uint32_t, BASES), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(PpDef, DEFS), AT(uint32_t, PCOUNT), AT(uint32_t, BCOUNT), nf, r);
    BARRIER();
    JOB(0, N(DIR_TOTAL), PCOUNT, PFIRST, PTOTAL);
    JOB(1, N(DIR_TOTAL), BCOUNT, IFIRST, ITOTAL);
    SCANS(2);
    EACH(s, N(PTOTAL)) pd_params(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(PpDef, DEFS), AT(const uint32_t, PFIRST), AT(const uint32_t, PTOTAL), AT(uint64_t, PKEYS), AT(uint32_t, ROOM), nf, W(VA_LO), W(VA_HI), W(CAP), s);
    BARRIER();
    EACH(s, N(ITOTAL)) {
        pd_items(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(PpDef, DEFS), AT(const uint32_t, IFIRST), AT(const uint32_t, ITOTAL), AT(const uint64_t, PKEYS), AT(uint32_t, ITEMS), AT(uint32_t, ROOM), nf, W(CAP), s);
        if (s < W(CAP)) AT(uint32_t, VAI)[s] = 0u;
    }
    BARRIER();
    EACH(s, N(ITOTAL)) pd_va_opt(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(PpDef, DEFS), AT(const uint32_t, IFIRST), AT(const uint32_t, ITOTAL), AT(uint32_t, VAI), nf, ((uint64_t)(W(VO_LO))) | (((uint64_t)(W(VO_HI))) << 32), W(CAP), s);
    if (last == 2u) return;
    // --- P1 (decision 0467): the include tree, its layout and its conditionals, iterated -----
    // Each iteration from the last one's state: the tree's words and layout (§2), the groups'
    // activity, the definitions' table (§3), the tests and the groups (§4), the includes (§5).
    // The iterations end at the first that changes nothing.
    BARRIER();
    PP_GLOBAL PpNode* nodes = AT(PpNode, P1_NODES);
    EACH(w, W(DC)) p1_words_init(AT(uint32_t, P1_MADE), AT(uint32_t, P1_MADEF), AT(uint32_t, P1_ENTER), W(DC), w);
    EACH(r, W(P1_ITERS)) AT(uint32_t, P1_ICHANGED)[r] = 0u;
    EACH(u, W(N_UNITS)) AT(uint32_t, P1_UFIRST)[u] = PP_NONE;
    // The `#line` rows' room in the scratch (two tokens a directive word, and their bytes), then
    // the arena's tops past it and the file literals, kept for each top's reset.
    ONE(x) {
        PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);
        PP_GLOBAL uint32_t* l_ = AT(uint32_t, LCTL);
        l_[0] = c_[5]; c_[5] += 2u * W(DC);
        l_[1] = c_[4]; c_[4] += W(LB_CAP);
        if (c_[5] > AT(const uint32_t, WORDS)[9] || c_[4] > AT(const uint32_t, WORDS)[8]) { AT(uint32_t, P1_FLAGS)[0] |= P1_ROOM; AT(uint32_t, P1_NEED)[NEED_REQS] = 0xffffffffu; }
        c_[6] = c_[4]; c_[7] = c_[5];
    }
    BARRIER();
    uint64_t defined_key = AT(const uint64_t, IF_KEYS)[0], true_key = AT(const uint64_t, IF_KEYS)[1];
    uint32_t iter = 0u, grp_from = 0u;
    bool text_done = false;
    for (; iter < W(P1_ITERS); iter++) {
        uint32_t ni = N(N_INSTS);
        PP_GLOBAL uint32_t* ichanged = AT(uint32_t, P1_ICHANGED) + iter;
        // The tree's words, and the iteration's resets.
        EACH(i, ni) p1_counts(nodes, ni, AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const uint32_t, DIR_GROUPS), AT(uint32_t, P1_NDIRS), AT(uint32_t, P1_NGAPS), AT(uint32_t, P1_GCOUNT), nf, i);
        EACH(w, W(DC)) AT(uint32_t, P1_CSIZE)[w] = 0u;
        EACH(u, W(N_UNITS)) AT(uint32_t, P1_USIZE)[u] = 0u;
        EACH(f, nf) p1_once_reset(AT(uint32_t, P1_ONCE), nf, f);
        EACH(r, W(STK_ROUNDS)) AT(uint32_t, STK_CHANGED)[r] = 0u;
        EACH(r, W(P1_JUMPS)) AT(uint32_t, P1_JCHANGED)[r] = 0u;
        ONE(x) { AT(uint32_t, N_STACK)[0] = 0u; AT(uint32_t, P1_NREQ)[0] = 0u; AT(uint32_t, P1_RNTOP)[0] = 0u; AT(uint32_t, LCTL)[2] = 0u; }
        // The built-ins' rows' sort keys, again (the last iteration's sort moved them).
        EACH(p, W(N_BUILTIN)) AT(uint64_t, SORT_KEYS)[p] = AT(const uint64_t, NAME_KEYS)[p] & 0xffffffff00000000ul;
        BARRIER();
        JOB(0, ni, P1_NDIRS, P1_DFIRST, N_DIRS);
        JOB(1, ni, P1_NGAPS, P1_GFIRST, N_GAPS);
        JOB(2, ni, P1_GCOUNT, P1_GRPF, P1_NGRP);
        SCANS(3);
        // Each room's high water (`P1_NEED`), whether or not it ran out: a settled run's rooms
        // are sized from it (decision 0486 §8).
        ONE(x) {
            PP_GLOBAL uint32_t* nd_ = AT(uint32_t, P1_NEED);
