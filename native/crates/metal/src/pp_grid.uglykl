// The preprocessor's evaluation as a persistent grid (decision 0468 §4): G groups of 256 threads,
// resident together, run the passes as phases, each group a share of each pass's items; a
// device-wide barrier (`ukl_grid_barrier`) separates a phase from the next, and the scans,
// segmented scans and sorts are the grid's own (`ukl/grid.h`). Every count a phase needs is read
// from the arena, so the host sizes nothing but the arena.
//
// Launches, the same for every unit:
// - `pp_setup`: the front passes, the definitions, then P1's iterations (decision 0467) with the
//   text pass inside them once they hold (decision 0485): the top level, the rounds (decision
//   0527) and the places, to the output;
// - `pp_check`: the refusals.
//
// The kernels bind the arena (`arena`: every store at its offset, `lay` the offsets by slot,
// `S_*`), and the slab the unit's documents are in (`data`).

// A store, as the passes read and write it: `PP_GLOBAL`, coherent on a GPU, since a phase reads what other groups
// wrote before the barrier (`ukl/grid.h`). A store the host writes and the device only reads (`IN`: the files'
// views), or one only atomics touch (the grid's control words), is a plain device pointer.
#define AT(T, s) ((PP_GLOBAL T*)(arena + lay[S_##s]))
#define IN(T, s) ((UKL_GLOBAL T*)(arena + lay[S_##s]))
#define C32(s) ((UKL_COHERENT uint32_t*)(arena + lay[S_##s]))
#define C64(s) ((UKL_COHERENT uint64_t*)(arena + lay[S_##s]))
#define W(s) lay[S_##s]
// Each of `n` items, a thread each, over the grid.
#define EACH(t, n) for (uint32_t t = g.group * g.lsz + g.lid, t##_n = (n); t < t##_n; t += g.groups * g.lsz)
// One thread of the grid.
#define ONE(t) for (uint32_t t = 0u; g.group == 0u && g.lid == 0u && t < 1u; t++)
// A measurement's stop (`STOP`): the kernel ends before its phase `stop` (0: never). A phase
// that ends the kernel leaves it by `PX_QUIT`: a return in the kernel, a false in a phase
// function (`px_drain`), which gives its phase count back.
#define PX_QUIT return
#define TICK() if (++phase == stop) PX_QUIT
#define BARRIER() TICK(); if (!ukl_grid_barrier(g, &tg->flag)) PX_QUIT
// Scans sharing their barriers (`ukl_grid_scans`): `JOB(k, …)` each, then `SCANS(k)`.
#define JOB(j, n_, in_, out_, total_) jobs[j].n = (n_); jobs[j].in = C32(in_); jobs[j].out = C32(out_); jobs[j].total = C32(total_)
#define SCANS(k) TICK(); if (!ukl_grid_scans(g, jobs, (k), C32(SUMS), tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
// A scan of stores given by pointer (columns within a slot's).
#define SCANP(n, in, out, total) TICK(); if (!ukl_grid_scan_n(g, (n), (UKL_COHERENT const uint32_t*)(in), (UKL_COHERENT uint32_t*)(out), (UKL_COHERENT uint32_t*)(total), C32(SUMS), tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
#define SCAN(n, in, out, total) TICK(); if (!ukl_grid_scan_n(g, (n), C32(in), C32(out), C32(total), C32(SUMS), tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
#define SEG(op, n, in, heads, out) TICK(); if (!ukl_grid_seg_scan_n(g, (op), (n), C32(in), C32(heads), C32(out), C32(SUMS), tg->big, tg->big + 256u, &tg->flag __UKL_ARGS)) PX_QUIT
#define SORT(n, bits, keys, va, kb, vb, hist) TICK(); if (!ukl_grid_sort_u64(g, (n), (bits), true, C64(keys), C32(va), C64(kb), C32(vb), C32(hist), C32(SUMS), sl, tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
// A sort that carries the values given (a stable sort of rows already ordered by another key).
#define SORTV(n, bits, keys, va, kb, vb, hist) TICK(); if (!ukl_grid_sort_u64(g, (n), (bits), false, C64(keys), C32(va), C64(kb), C32(vb), C32(hist), C32(SUMS), sl, tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
// A sort whose rows are already in the order of their low `low` bits: only the digits above pass.
#define SORT_FROM(n, low, bits, keys, va, kb, vb, hist) TICK(); if (!ukl_grid_sort_u64_from(g, (n), (low), (bits), true, C64(keys), C32(va), C64(kb), C32(vb), C32(hist), C32(SUMS), sl, tg->scratch, &tg->flag __UKL_ARGS)) PX_QUIT
// A count the passes before wrote.
#define N(s) AT(const uint32_t, s)[0]

// A top level, as the expansion's passes read it: its tokens' nodes, its stretches' first tokens
// and their count's store, their first nodes' places, and its tokens' count's store. The text's
// (its active stretches in the unit's order), and the tests' lines' (decision 0467 §4).
#define TEXT_TOP AT(const uint32_t, TEXT_NODES), AT(const uint32_t, GAT), AT(const uint32_t, N_GAPS), AT(const uint32_t, GFIRSTS), AT(const uint32_t, GTOTAL)
// Each top stretch's instance.
#define TEXT_SCOPE mk_scope(1u, AT(const uint32_t, RSTART), AT(const uint32_t, RUNX), AT(const uint32_t, RUN_END), AT(const uint32_t, SINST), AT(const uint32_t, SSLOT))
#define IF_SCOPE mk_scope(0u, AT(const uint32_t, RSTART), AT(const uint32_t, RUNX), AT(const uint32_t, RUN_END), AT(const uint32_t, IF_INST), AT(const uint32_t, DSLOT))
// The text pass's facts (decision 0485).
#define TFACTS mk_tf(AT(uint64_t, TR_SK), AT(uint64_t, TR_NK), AT(uint32_t, TR_TY), AT(uint32_t, TO_F), AT(uint32_t, TO_S), AT(uint32_t, CU_SLOT), AT(uint32_t, CU_SUB), AT(uint32_t, CU_UNIT), \
                     AT(uint32_t, TRN), W(CNT_CAP), AT(const uint32_t, RTYPES), AT(const uint32_t, LREAD))
#define TEXT_INST AT(const uint32_t, SINST), AT(const PpNode, P1_NODES), AT(const uint32_t, P1_UFILE), AT(const uint32_t, SLINE), AT(const uint32_t, SLINEN), TEXT_SCOPE, TFACTS
#define IF_INST AT(const uint32_t, IF_INST), AT(const PpNode, P1_NODES), AT(const uint32_t, P1_UFILE), AT(const uint32_t, ILINE), AT(const uint32_t, ILINEN), IF_SCOPE, TFACTS
#define IF_TOP AT(const uint32_t, IF_NODES), AT(const uint32_t, IF_AT), AT(const uint32_t, N_DIRS), AT(const uint32_t, IF_AT), AT(const uint32_t, IF_TOTAL)
// The same without the tokens' count.
#define TEXT_STRETCHES AT(const uint32_t, TEXT_NODES), AT(const uint32_t, GAT), AT(const uint32_t, N_GAPS), AT(const uint32_t, GFIRSTS)
#define IF_STRETCHES AT(const uint32_t, IF_NODES), AT(const uint32_t, IF_AT), AT(const uint32_t, N_DIRS), AT(const uint32_t, IF_AT)

// A round's items over a top (decision 0527): the arena and the unit as its phases read them.
#define PX_UA(T, CLOSES)                                                                        \
    Ux xu; Ar xa;                                                                                      \
    px_make(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const PpDef, DEFS), AT(const uint32_t, ITEMS), \
              AT(const uint64_t, SORT_KEYS), AT(const uint32_t, SORT_VA), AT(const uint32_t, N_ROWS), AT(const uint64_t, NAME_KEYS), \
              AT(const uint32_t, VALUES), T##_TOP, T##_INST, AT(const uint32_t, DEPTH), AT(PxList, LISTS),                                      \
              AT(uint32_t, TOKENS), AT(PxArg, ARGS), AT(uint32_t, OUT), AT(uint32_t, SLOTS), AT(uint32_t, QCTL),                  \
              AT(uint32_t, CTL), AT(const uint32_t, WORDS), AT(PxScratch, SCRATCH), CLOSES, AT(const uint32_t, CLOSE_TOTAL), AT(const uint32_t, FLOORS), W(N_UNITS), \
              AT(const uint64_t, IF_OPKEYS), AT(const uint32_t, IF_OPKINDS), W(N_IFOP), AT(const uint64_t, IF_FEATKEYS), AT(const uint64_t, IF_FEATVALS), W(N_FEAT), \
              AT(uint32_t, CNT), W(CNT_CAP), AT(const uint32_t, LDELTA), AT(const uint32_t, LCTL)[0], \
              AT(uint32_t, SCANS), AT(uint32_t, SUBS), AT(uint32_t, CALLS), AT(uint32_t, FINS), AT(uint32_t, PLACES), &xu, &xa); \
    xu.vai = AT(const uint32_t, VAI); xa.trie = AT(uint32_t, TRIE); xa.tlv = W(TRIE_LV);    \
    xa.hx = AT(uint32_t, HX); xa.hmask = W(HX_MASK)
// A round's items (decision 0527): a thread each.
#define PX_WORK_ON(T, CLOSES)                                                                          \
    {                                                                                                  \
        PX_UA(T, CLOSES);                                                                            \
        EACH(k, ukl_min(ukl_atomic_poll(&AT(uint32_t, QCTL)[2]), W(Q_CAP))) px_item(xu, xa, k);       \
    }

// A round's scan (decision 0527 §2): every list its items gave, a thread a token of each.
// A round's exits (`px_ex_*`, decision 0527 §2), inside `PX_SCANS` (`sc_`, `xu`, `xa`): taken
// from the scanned lists, their frames climbed a step a frame while one climbs, their joins.
#define PX_EXITS()                                                                                     \
    {                                                                                                  \
        Ex ex_;                                                                                        \
        ex_.l = AT(uint32_t, SB_L); ex_.qcap = W(Q_CAP); ex_.n = AT(uint32_t, SC_N); ex_.base = AT(uint32_t, SC_BASE); \
        ex_.delta = AT(uint32_t, SC_DELTA); ex_.heads = AT(uint32_t, SC_HEADS); ex_.depth = AT(uint32_t, SC_DEPTH); \
        ex_.ctr = AT(uint32_t, SC_FIRST) + 1u; ex_.total = 0u;                                         \
        EACH(i, sc_.ns) px_ex_take(xa, sc_, ex_, i);                                                   \
        BARRIER();                                                                                     \
        ex_.ne = ukl_min(ukl_atomic_poll(&ex_.ctr[0]), W(Q_CAP));                                      \
        if (ex_.ne != 0u) {                                                                            \
            for (uint32_t st_ = 0u; st_ + 1u < MAX_SEGS; st_++) {                                      \
                EACH(e, ex_.ne) px_ex_frame(xu, xa, ex_, e);                                           \
                BARRIER();                                                                             \
                SCAN(ex_.ne, SC_N, SC_BASE, SC_TOTAL);                                                 \
                ex_.total = N(SC_TOTAL);                                                               \
                if (ex_.total > W(SC_CAP)) {                                                           \
                    ONE(x) { AT(uint32_t, CTL)[24] = ukl_max(AT(const uint32_t, CTL)[24], ex_.total); px_refuse(AT(uint32_t, CTL), X_ROOM); } \
                    break;                                                                             \
                }                                                                                      \
                /* The climbing count zeroed where each thread has read the last step's. */             \
                ONE(x) ex_.ctr[1] = 0u;                                                                \
                EACH(t, ex_.total) px_ex_tok(xu, xa, ex_, t);                                          \
                BARRIER();                                                                             \
                SEG(UKL_SEG_ADD, ex_.total, SC_DELTA, SC_HEADS, SC_DEPTH);                             \
                EACH(t, ex_.total) px_ex_close(ex_, t);                                                \
                BARRIER();                                                                             \
                EACH(e, ex_.ne) px_ex_step(xa, ex_, e);                                                \
                BARRIER();                                                                             \
                if (ukl_atomic_poll(&ex_.ctr[1]) == 0u) break;                                         \
            }                                                                                          \
            EACH(e, ex_.ne) px_ex_join(xu, xa, ex_, e);                                                \
            BARRIER();                                                                                 \
            SCAN(ex_.ne, SC_N, SC_BASE, SC_TOTAL);                                                     \
            ex_.total = N(SC_TOTAL);                                                                   \
            EACH(q, ex_.total) px_ex_piece(xa, ex_, q);                                                \
            BARRIER();                                                                                 \
            EACH(e, ex_.ne) px_ex_lref(xu, xa, ex_, e);                                                \
            BARRIER();                                                                                 \
        }                                                                                              \
    }

#define PX_SCANS(T, CLOSES)                                                                          \
    {                                                                                                  \
        PX_UA(T, CLOSES);                                                                            \
        Sc sc_;                                                                                        \
        sc_.scans = AT(const uint32_t, SCANS); sc_.ns = ukl_min(ukl_atomic_poll(&AT(uint32_t, QCTL)[5]), W(Q_CAP)); \
        sc_.n = AT(uint32_t, SC_N); sc_.base = AT(uint32_t, SC_BASE); sc_.xj = AT(uint32_t, SC_XJ);    \
        sc_.m = AT(uint32_t, SC_M); sc_.k = AT(uint32_t, SC_K); sc_.e = AT(uint32_t, SC_E);            \
        sc_.delta = AT(uint32_t, SC_DELTA); sc_.heads = AT(uint32_t, SC_HEADS); sc_.depth = AT(uint32_t, SC_DEPTH); \
        sc_.close = AT(uint32_t, SC_CLOSE); sc_.cat = AT(uint32_t, SC_CAT); sc_.ckeys = AT(uint64_t, SC_CKEYS); \
        sc_.cend = AT(uint32_t, SC_CEND); sc_.reach = AT(uint32_t, SC_REACH); sc_.live = AT(uint32_t, SC_LIVE); sc_.rank = AT(uint32_t, SC_RANK); \
        sc_.total = 0u; sc_.ltotal = 0u; sc_.first = 0u;                                               \
        if (sc_.ns != 0u) {                                                                            \
            EACH(i, sc_.ns) px_sc_count(xa, sc_, i);                                                   \
            BARRIER();                                                                                 \
            SCAN(sc_.ns, SC_N, SC_BASE, SC_TOTAL);                                                     \
            sc_.total = N(SC_TOTAL);                                                                   \
            ONE(x) AT(uint32_t, CTL)[24] = ukl_max(AT(const uint32_t, CTL)[24], sc_.total);           \
            if (sc_.total > W(SC_CAP)) {                                                               \
                ONE(x) px_refuse(AT(uint32_t, CTL), X_ROOM);                                           \
            } else {                                                                                   \
                EACH(t, sc_.total) px_sc_tok(xu, xa, sc_, t);                                          \
                BARRIER();                                                                             \
                SEG(UKL_SEG_ADD, sc_.total, SC_DELTA, SC_HEADS, SC_DEPTH);                             \
                SCAN(sc_.total, SC_CLOSE, SC_CAT, SC_CTOTAL);                                          \
                EACH(t, sc_.total) px_sc_ckeys(xa, sc_, t);                                            \
                BARRIER();                                                                             \
                SORT_FROM(N(SC_CTOTAL), 24u, W(CLOSE_BITS), SC_CKEYS, SC_VA, SC_KB, SC_VB, SC_HIST);  \
                PP_GLOBAL const uint64_t* scl_ = ukl_grid_sort_in_input(W(CLOSE_BITS)) ? AT(const uint64_t, SC_CKEYS) : AT(const uint64_t, SC_KB); \
                uint32_t ncl_ = N(SC_CTOTAL);                                                          \
                EACH(t, sc_.total) px_sc_ends(xa, sc_, scl_, ncl_, t);                                 \
                BARRIER();                                                                             \
                SEG(UKL_SEG_MAX, sc_.total, SC_CEND, SC_HEADS, SC_REACH);                              \
                EACH(t, sc_.total) px_sc_live(sc_, t);                                                 \
                BARRIER();                                                                             \
                SCAN(sc_.total, SC_LIVE, SC_RANK, SC_LTOTAL);                                          \
                sc_.ltotal = N(SC_LTOTAL);                                                             \
                ONE(x) {                                                                               \
                    AT(uint32_t, SC_FIRST)[1] = 0u;                                                    \
                    uint32_t nl_ = N(SC_LTOTAL), f_ = nl_ == 0u ? 0u : px_list_ids(xa, nl_);           \
                    if (f_ == NO_POS) px_refuse(AT(uint32_t, CTL), X_ROOM);                            \
                    AT(uint32_t, SC_FIRST)[0] = f_;                                                    \
                }                                                                                      \
                EACH(i, sc_.ns) px_sc_kids(xa, sc_, i);                                                \
                BARRIER();                                                                             \
                sc_.ltotal = N(SC_LTOTAL); sc_.first = N(SC_FIRST);                                    \
                EACH(t, sc_.total) px_sc_child(xu, xa, sc_, t);                                        \
                BARRIER();                                                                             \
                PX_EXITS();                                                                            \
                EACH(i, sc_.ns) px_sc_done(xa, sc_, i);                                                \
            }                                                                                          \
        }                                                                                              \
    }

// A round's calls' phases (decision 0527 §2) over `c_`, in the given forms of a phase over `n`
// elements, a barrier, a scan (of slots, and of stores by pointer), a segmented scan, and one
// thread: the grid's, or group 0's alone.
#define PX_CALL_PHASES(EACHM, BARM, SCANM, SCANPM, SEGM, ONEM)                                         \
    EACHM(i, c_.ns) px_cl_count(xu, xa, c_, i);                                                        \
    BARM();                                                                                            \
    SCANM(c_.ns, SC_N, SC_BASE, SC_TOTAL);                                                             \
    c_.toks = N(SC_TOTAL);                                                                             \
    if (c_.toks > W(SC_CAP)) {                                                                         \
        ONEM(x) { AT(uint32_t, CTL)[24] = ukl_max(AT(const uint32_t, CTL)[24], c_.toks); px_refuse(AT(uint32_t, CTL), X_ROOM); } \
    } else {                                                                                           \
        EACHM(t, c_.toks) px_cl_tok(xu, xa, c_, t);                                                    \
        BARM();                                                                                        \
        SEGM(UKL_SEG_ADD, c_.toks, SC_DELTA, SC_HEADS, SC_DEPTH);                                      \
        EACHM(t, c_.toks) px_cl_comma(xu, xa, c_, t);                                                  \
        BARM();                                                                                        \
        SCANPM(c_.toks, c_.comma, c_.rank, ct_ + 0u);                                                  \
        c_.commas = ukl_atomic_poll(&ct_[0]);                                                          \
        EACHM(i, c_.ns) px_cl_args(xu, xa, c_, i);                                                     \
        BARM();                                                                                        \
        SCANPM(c_.ns, px_cl_col(c_, CL_IN), px_cl_col(c_, CL_IB), ct_ + 1u);                           \
        SCANPM(c_.ns, px_cl_col(c_, CL_PN), px_cl_col(c_, CL_PB), ct_ + 2u);                           \
        c_.items = ukl_atomic_poll(&ct_[1]); c_.params = ukl_atomic_poll(&ct_[2]);                     \
        EACHM(t, c_.toks) px_cl_split(c_, xa, t);                                                      \
        BARM();                                                                                        \
        EACHM(t, c_.items) px_cl_item(xu, xa, c_, t);                                                  \
        BARM();                                                                                        \
        if (c_.params > W(SC_CAP)) {                                                                   \
            ONEM(x) { AT(uint32_t, CTL)[24] = ukl_max(AT(const uint32_t, CTL)[24], c_.params); px_refuse(AT(uint32_t, CTL), X_ROOM); } \
        } else {                                                                                       \
            EACHM(p, c_.params) px_cl_param(xa, c_, p);                                                \
            BARM();                                                                                    \
            SCANM(c_.params, SC_M, SC_K, SC_CTOTAL);                                                   \
            c_.atoks = N(SC_CTOTAL);                                                                   \
            EACHM(x, c_.atoks) px_cl_atok(xu, xa, c_, x);                                              \
            BARM();                                                                                    \
            EACHM(p, c_.params) px_cl_make(xa, c_, p);                                                 \
            BARM();                                                                                    \
            EACHM(t, c_.items) px_cl_order(xu, xa, c_, t);                                             \
            BARM();                                                                                    \
            EACHM(i, c_.ns) px_cl_ready(xa, c_, i);                                                    \
            BARM();                                                                                    \
        }                                                                                              \
    }

// A round's calls (decision 0527 §2): every call its items gave, a thread a token, a body item, an
// argument and an argument's token. The scan's stores hold them, and the substitutions' list
// columns (`SB_L`) the calls' (it runs after). A set whose calls and tokens a group holds is group
// 0's alone, with its own barriers (each group reads the calls and decides alike).
#define PX_CALLS(T, CLOSES)                                                                          \
    {                                                                                                  \
        PX_UA(T, CLOSES);                                                                            \
        Cl c_;                                                                                         \
        c_.set = AT(const uint32_t, CALLS); c_.ns = ukl_min(ukl_atomic_poll(&AT(uint32_t, QCTL)[7]), W(Q_CAP)); c_.qcap = W(Q_CAP); \
        c_.l = AT(uint32_t, SB_L); c_.n = AT(uint32_t, SC_N); c_.base = AT(uint32_t, SC_BASE);       \
        c_.delta = AT(uint32_t, SC_DELTA); c_.heads = AT(uint32_t, SC_HEADS); c_.depth = AT(uint32_t, SC_DEPTH); \
        c_.comma = AT(uint32_t, SC_CLOSE); c_.rank = AT(uint32_t, SC_CAT);                             \
        c_.v = AT(uint32_t, SC_M); c_.off = AT(uint32_t, SC_K); c_.live = AT(uint32_t, SC_E);         \
        c_.toks = 0u; c_.commas = 0u; c_.items = 0u; c_.params = 0u; c_.atoks = 0u;                   \
        PP_GLOBAL uint32_t* ct_ = px_cl_col(c_, CL_TOTALS);                                           \
        if (c_.ns != 0u) {                                                                             \
            bool small_ = c_.ns <= UKL_GRID_SMALL;                                                     \
            if (small_) {                                                                              \
                uint32_t mine_ = 0u;                                                                   \
                for (uint32_t i_ = g.lid; i_ < c_.ns; i_ += g.lsz) mine_ += px_cl_size(xu, xa, c_, i_);    \
                small_ = ukl_tg_sum(mine_, g.lid, g.lsz, tg->scratch __UKL_ARGS) <= UKL_GRID_SMALL;   \
            }                                                                                          \
            if (small_) {                                                                              \
                if (g.group == 0u) { PX_CALL_PHASES(G_EACH, G_BARRIER, G_SCAN, G_SCANP, G_SEG, G_ONE); } \
                BARRIER();                                                                             \
            } else {                                                                                   \
                PX_CALL_PHASES(EACH, BARRIER, SCAN, SCANP, SEG, ONE);                                  \
            }                                                                                          \
        }                                                                                              \
    }

// A round's substitutions' phases over `s_` (decision 0527 §2), in the given forms (as
// `PX_CALL_PHASES`), `ID` this thread's index in the form's width `WIDTH`.
#define PX_SUB_PHASES(EACHM, BARM, SCANM, SEGM, ONEM, ID, WIDTH)                                       \
    EACHM(i, s_.ns) px_sb_count(xu, xa, s_, i);                                                        \
    BARM();                                                                                            \
    SCANM(s_.ns, SC_N, SC_BASE, SC_TOTAL);                                                             \
    s_.items = N(SC_TOTAL);                                                                            \
    if (s_.items <= W(SC_CAP)) {                                                                       \
        EACHM(t, s_.items) px_sb_item(xu, xa, s_, t);                                                  \
        BARM();                                                                                        \
        SCANM(s_.items, SC_M, SC_CAT, SC_CTOTAL);                                                      \
        s_.pieces = N(SC_CTOTAL);                                                                      \
    }                                                                                                  \
    if (s_.items > W(SC_CAP) || s_.pieces > W(SC_CAP)) {                                               \
        ONEM(x) { AT(uint32_t, CTL)[24] = ukl_max(AT(const uint32_t, CTL)[24], ukl_max(s_.items, s_.pieces)); px_refuse(AT(uint32_t, CTL), X_ROOM); } \
    } else {                                                                                           \
        EACHM(i, s_.ns) px_sb_alloc(xa, s_, i);                                                        \
        BARM();                                                                                        \
        EACHM(p, s_.pieces) px_sb_piece(xu, xa, s_, p);                                                \
        BARM();                                                                                        \
        if (ukl_atomic_poll(&AT(uint32_t, QCTL)[9]) != 0u) {                                           \
            SCANM(s_.pieces, SC_HEADS, SC_K, SC_LTOTAL);                                               \
            uint32_t nh_ = N(SC_LTOTAL);                                                               \
            EACHM(p, s_.pieces) px_sb_str_rank(s_, p);                                                 \
            BARM();                                                                                    \
            SCANM(nh_, SC_CLOSE, SC_LIVE, SC_TOTAL);                                                   \
            uint32_t nt_ = N(SC_TOTAL);                                                                \
            if (nt_ > W(SC_CAP)) {                                                                     \
                ONEM(x) { AT(uint32_t, CTL)[24] = ukl_max(AT(const uint32_t, CTL)[24], nt_); px_refuse(AT(uint32_t, CTL), X_ROOM); } \
            } else {                                                                                   \
                EACHM(x, nt_) px_sb_str_bytes(xu, xa, s_, nh_, nt_, x);                                \
                BARM();                                                                                \
                SCANM(nt_, SC_REACH, SC_DEPTH, SC_CTOTAL);                                             \
                uint32_t nb_ = N(SC_CTOTAL);                                                           \
                ONEM(x) px_sb_str_alloc(xa, nh_, nb_, AT(uint32_t, SC_FIRST));                         \
                BARM();                                                                                \
                EACHM(x, nt_) px_sb_str_write(xu, xa, s_, nh_, nt_, AT(const uint32_t, SC_FIRST), x);  \
                EACHM(h, nh_) px_sb_str_lit(xa, s_, nh_, nt_, nb_, AT(const uint32_t, SC_FIRST), h);   \
                BARM();                                                                                \
            }                                                                                          \
        }                                                                                              \
        EACHM(t, s_.items) px_sb_va(xu, xa, s_, t);                                                    \
        BARM();                                                                                        \
        EACHM(p, s_.pieces) px_sb_paste(xu, xa, s_, p);                                                \
        BARM();                                                                                        \
        EACHM(p, s_.pieces) px_sb_flags(xa, s_, p);                                                    \
        BARM();                                                                                        \
        SEGM(UKL_SEG_ADD, s_.pieces, SC_K, SC_HEADS, SC_DEPTH);                                        \
        SEGM(UKL_SEG_MAX, s_.pieces, SC_E, SC_HEADS, SC_CLOSE);                                        \
        SCANM(s_.pieces, SC_LIVE, SC_RANK, SC_LTOTAL);                                                 \
        s_.kept = N(SC_LTOTAL);                                                                        \
        EACHM(p, s_.pieces) px_sb_run(s_, p);                                                          \
        EACHM(i, s_.ns) px_sb_kbase(s_, i);                                                            \
        BARM();                                                                                        \
        /* The compaction in place: a chunk of the form's width read, then written. */                 \
        for (uint32_t c0_ = 0u; c0_ < s_.pieces; c0_ += (WIDTH)) {                                     \
            Pc pc_ = px_sb_take(xa, s_, c0_ + (ID));                                                   \
            BARM();                                                                                    \
            px_sb_put(xa, pc_);                                                                        \
            BARM();                                                                                    \
        }                                                                                              \
        if (s_.kept != 0u) {                                                                           \
            EACHM(k, s_.kept) px_sb_klen(xa, s_, k);                                                   \
            BARM();                                                                                    \
            SEGM(UKL_SEG_ADD, s_.kept, SC_K, SC_HEADS, SC_DEPTH);                                      \
        }                                                                                              \
        EACHM(k, s_.kept) px_sb_place(xa, s_, k);                                                      \
        EACHM(i, s_.ns) px_sb_finish(xu, xa, s_, i);                                                   \
        BARM();                                                                                        \
    }

// A round's substitutions (decision 0527 §2): every list its items gave, a thread a body item,
// then a thread a piece. The scan's stores hold them (it runs after). A set whose lists and
// items a group holds is group 0's alone (as the calls').
#define PX_SUBSTS(T, CLOSES)                                                                         \
    {                                                                                                  \
        PX_UA(T, CLOSES);                                                                            \
        Sb s_;                                                                                         \
        s_.set = AT(const uint32_t, SUBS); s_.ns = ukl_min(ukl_atomic_poll(&AT(uint32_t, QCTL)[6]), W(Q_CAP)); s_.qcap = W(Q_CAP); \
        s_.l = AT(uint32_t, SB_L); s_.n = AT(uint32_t, SC_N); s_.base = AT(uint32_t, SC_BASE);       \
        s_.v = AT(uint32_t, SC_M); s_.off = AT(uint32_t, SC_CAT);                                      \
        s_.brk = AT(uint32_t, SC_HEADS); s_.lenv = AT(uint32_t, SC_K); s_.sum = AT(uint32_t, SC_DEPTH); \
        s_.hv = AT(uint32_t, SC_E); s_.hidx = AT(uint32_t, SC_CLOSE); s_.keep = AT(uint32_t, SC_LIVE); \
        s_.rank = AT(uint32_t, SC_RANK); s_.run = AT(uint32_t, SC_REACH);                              \
        s_.items = 0u; s_.pieces = 0u; s_.kept = 0u;                                                   \
        if (s_.ns != 0u) {                                                                             \
            bool small_ = s_.ns <= UKL_GRID_SMALL;                                                     \
            if (small_) {                                                                              \
                uint32_t mine_ = 0u;                                                                   \
                for (uint32_t i_ = g.lid; i_ < s_.ns; i_ += g.lsz) mine_ += px_sb_size(xu, xa, s_, i_); \
                small_ = ukl_tg_sum(mine_, g.lid, g.lsz, tg->scratch __UKL_ARGS) <= UKL_GRID_SMALL;   \
            }                                                                                          \
            if (small_) {                                                                              \
                if (g.group == 0u) { PX_SUB_PHASES(G_EACH, G_BARRIER, G_SCAN, G_SEG, G_ONE, g.lid, g.lsz); } \
                BARRIER();                                                                             \
            } else {                                                                                   \
                PX_SUB_PHASES(EACH, BARRIER, SCAN, SEG, ONE, g.group * g.lsz + g.lid, g.groups * g.lsz); \
            }                                                                                          \
        }                                                                                              \
    }

// A walk's phases over the iteration's set `w_` (decision 0527 §2), in the given forms of a phase
// over `n` elements, a barrier, a scan and a segmented scan: the grid's, or group 0's alone.
// A parent's chains' sums by pointer doubling (`px_ch_jump`, decision 0527 §2), over `n_`
// positions from `c0_` (its seed) into `out_`; no next (`links_`), no round. A chain's calls are
// at most its nexts + 1, so the rounds stop past them.
#define PX_CH_DOUBLE(EACHM, BARM, n_, c0_, c1_, links_, out_)                                          \
    {                                                                                                  \
        out_ = (c0_);                                                                                  \
        Ch o_ = (c1_);                                                                                 \
        uint32_t nl_ = ukl_atomic_poll(links_);                                                        \
        for (uint32_t d_ = 1u; d_ <= nl_; d_ *= 2u) {                                                  \
            EACHM(x, (n_)) px_ch_jump(out_, o_, (n_), x);                                              \
            BARM();                                                                                    \
            Ch s_ = out_; out_ = o_; o_ = s_;                                                          \
        }                                                                                              \
    }

#define PX_WALK_PHASES(EACHM, BARM, SCANM, SEGM, which_, ROOMOUT)                                     \
    EACHM(i, w_.ns) px_wk_count(xa, w_, i);                                                          \
    BARM();                                                                                            \
    SCANM(w_.ns, SC_N, SC_BASE, SC_TOTAL);                                                           \
    w_.total = N(SC_TOTAL);                                                                            \
    if (w_.total > W(SC_CAP)) { ROOMOUT; }                                                           \
    EACHM(t, w_.total) px_wk_clear(xa, w_, t);                                                       \
    BARM();                                                                                            \
    EACHM(t, w_.total) px_wk_node(xa, w_, t);                                                        \
    BARM();                                                                                            \
    EACHM(t, w_.total) px_wk_seed(xa, w_, t);                                                        \
    BARM();                                                                                            \
    PX_CH_DOUBLE(EACHM, BARM, w_.total, w_.c0, w_.c1, w_.links, w_.c);                               \
    w_.hb = w_.c0.nx; w_.ht = w_.c1.nx;                                                                \
    EACHM(t, w_.total) px_wk_kid(xa, w_, t);                                                         \
    BARM();                                                                                            \
    if (ukl_atomic_poll(&w_.claims[0]) != 0u) {                                                        \
        SCANM(w_.total, SC_CAT, SC_RANK, SC_LTOTAL);                                                   \
        uint32_t nc_ = N(SC_LTOTAL);                                                                   \
        EACHM(t, w_.total) px_wk_claim(w_, t);                                                         \
        BARM();                                                                                        \
        PP_GLOBAL uint32_t* j0_ = AT(uint32_t, SC_REACH);                                             \
        PP_GLOBAL uint32_t* j1_ = AT(uint32_t, SC_DEPTH);                                             \
        PP_GLOBAL uint32_t* on_ = AT(uint32_t, SC_CLOSE);                                             \
        EACHM(x, nc_) px_wk_next(xa, w_, nc_, j0_, on_, x);                                            \
        BARM();                                                                                        \
        for (uint32_t d_ = 1u; d_ < nc_; d_ *= 2u) {                                                   \
            EACHM(x, nc_) px_live_jump(nc_, j0_, j1_, on_, x);                                         \
            BARM();                                                                                    \
            PP_GLOBAL uint32_t* js_ = j0_; j0_ = j1_; j1_ = js_;                                      \
        }                                                                                              \
        EACHM(x, nc_) px_wk_live(w_, nc_, on_, x);                                                     \
        BARM();                                                                                        \
    }                                                                                                  \
    SEGM(UKL_SEG_MAX, w_.total, SC_K, SC_HEADS, SC_DEPTH);                                           \
    SEGM(UKL_SEG_MAX, w_.total, SC_E, SC_HEADS, SC_CLOSE);                                           \
    EACHM(t, w_.total) px_wk_tok(xu, xa, w_, t);                                                     \
    BARM();                                                                                            \
    EACHM(t, w_.total) px_wk_piece(xa, w_, t);                                                       \
    BARM();                                                                                            \
    SEGM(UKL_SEG_ADD, w_.total, SC_DELTA, SC_HEADS, SC_LIVE);                                        \
    SEGM(UKL_SEG_ADD, w_.total, SC_REACH, SC_HEADS, SC_RANK);                                        \
    SEGM(UKL_SEG_ADD, w_.total, SC_K, SC_E, SC_DEPTH);                                               \
    EACHM(t, w_.total) px_wk_runs(xa, w_, t);                                                        \
    BARM();                                                                                            \
    if ((which_) != 0u) {                                                                              \
        EACHM(t, w_.total) px_wk_write(xu, xa, w_, t);                                               \
        BARM();                                                                                        \
        EACHM(t, w_.total) px_wk_member(xa, w_, t);                                                    \
        BARM();                                                                                        \
    }                                                                                                  \
    EACHM(i, w_.ns) px_wk_end(xa, w_, i);                                                            \
    BARM()

// Group 0's forms: its threads alone, its own barriers.
#define G_EACH(t, n) for (uint32_t t = g.lid, t##_n = (n); t < t##_n; t += g.lsz)
#define G_BARRIER() ukl_tg_barrier_device()
#define G_SCAN(n, in, out, total) ukl_group_scan_n(g, (n), C32(in), C32(out), C32(total), tg->scratch __UKL_ARGS)
#define G_SEG(op, n, in, heads, out) ukl_group_seg_scan_n(g, (op), (n), C32(in), C32(heads), C32(out), tg->big, tg->big + 256u __UKL_ARGS)
#define G_SCANP(n, in, out, total) ukl_group_scan_n(g, (n), (UKL_COHERENT const uint32_t*)(in), (UKL_COHERENT uint32_t*)(out), (UKL_COHERENT uint32_t*)(total), tg->scratch __UKL_ARGS)
#define G_ONE(t) for (uint32_t t = 0u; g.lid == 0u && t < 1u; t++)

// The walk's set `which_` (0 the lists made final, 1 the lists to place), `wc_` its control words
// (`px_set_later`): the next iteration's taken (its half the iteration's), into `w_`.
#define PX_WALK_SET(which_, wc_, n_)                                                                   \
    Wk w_;                                                                                             \
    w_.set = ((which_) == 0u ? AT(const uint32_t, FINS) : AT(const uint32_t, PLACES)) + (ukl_atomic_poll(&wc_[1]) & 1u) * W(Q_CAP); \
    w_.ns = (n_); w_.place = (which_) != 0u;                                                           \
    w_.n = AT(uint32_t, SC_N); w_.base = AT(uint32_t, SC_BASE); w_.stop = AT(uint32_t, SC_XJ);         \
    w_.child = AT(uint32_t, SC_M); w_.xlive = AT(uint32_t, SC_K); w_.ends = AT(uint32_t, SC_E);       \
    w_.heads = AT(uint32_t, SC_HEADS); w_.cb = AT(uint32_t, SC_DEPTH); w_.incl = AT(uint32_t, SC_CLOSE); \
    w_.pi = AT(uint32_t, SC_CAT); w_.fl = AT(uint32_t, SC_CEND); w_.v = AT(uint32_t, SC_DELTA);        \
    w_.pv = AT(uint32_t, SC_REACH); w_.off = AT(uint32_t, SC_LIVE); w_.poff = AT(uint32_t, SC_RANK); \
    w_.claims = AT(uint32_t, SC_FIRST) + 1u;                                                         \
    w_.c0 = px_ch(AT(uint32_t, CH), W(SC_CAP), 0u); w_.c1 = px_ch(AT(uint32_t, CH), W(SC_CAP), 1u);  \
    w_.c = w_.c0; w_.hb = w_.c0.nx; w_.ht = w_.c1.nx; w_.links = AT(uint32_t, CHW)

// A round's walks (decision 0527 §2) of the set `which_`: an iteration a set, each one's lists'
// tokens a thread each, until an iteration makes none (a chain's finals climb it, a list's places
// go down it). The scan's stores hold them. A set whose lists and tokens a group holds is group
// 0's alone, with its own barriers, one such after another (a chain's climb: no grid barrier a
// level); a larger one is the grid's. `CTL` 26 + 3 `which_` + 2 says which: 0 none left, 1 a large
// one next.
#define PX_WALKS(T, CLOSES, which_)                                                                  \
    {                                                                                                  \
        PP_GLOBAL uint32_t* wc_ = AT(uint32_t, CTL) + 26u + 3u * (which_);                            \
        for (uint32_t wi_ = 0u; wi_ < MAX_CHAIN; wi_++) {                                              \
            PX_UA(T, CLOSES);                                                                          \
            if (g.group == 0u) {                                                                       \
                uint32_t left_ = 0u;                                                                   \
                for (uint32_t si_ = 0u; si_ < MAX_CHAIN; si_++) {                                      \
                    ukl_tg_barrier_device();                                                           \
                    uint32_t n_ = ukl_atomic_poll(&wc_[0]);                                            \
                    if (n_ == 0u) break;                                                               \
                    if (n_ > ukl_min(W(Q_CAP), UKL_GRID_SMALL)) { left_ = 1u; break; }                 \
                    /* The next set's tokens: within a group's, or the grid's. */                      \
                    PP_GLOBAL const uint32_t* nx_ = ((which_) == 0u ? AT(const uint32_t, FINS) : AT(const uint32_t, PLACES)) + (1u - (ukl_atomic_load(&wc_[1]) & 1u)) * W(Q_CAP); \
                    uint32_t mine_ = 0u;                                                               \
                    for (uint32_t i_ = g.lid; i_ < n_; i_ += g.lsz) mine_ += xa.lists[nx_[i_]].len;    \
                    if (ukl_tg_sum(mine_, g.lid, g.lsz, tg->scratch __UKL_ARGS) > UKL_GRID_SMALL) { left_ = 1u; break; } \
                    ukl_tg_barrier_device();                                                           \
                    if (g.lid == 0u) {                                                                 \
                        ukl_atomic_store(&wc_[0], 0u);                                                 \
                        ukl_atomic_store(&wc_[1], (ukl_atomic_load(&wc_[1]) & 1u) ^ 1u);               \
                    }                                                                                  \
                    ukl_tg_barrier_device();                                                           \
                    PX_WALK_SET(which_, wc_, n_);                                                      \
                    PX_WALK_PHASES(G_EACH, G_BARRIER, G_SCAN, G_SEG, which_, if (g.lid == 0u) px_refuse(AT(uint32_t, CTL), X_ROOM); break); \
                }                                                                                      \
                if (g.lid == 0u) ukl_atomic_store(&wc_[2], left_);                                     \
            }                                                                                          \
            BARRIER();                                                                                 \
            if (ukl_atomic_poll(&wc_[2]) == 0u) break;                                                 \
            /* A large set: the grid's phases. */                                                      \
            ONE(x) {                                                                                   \
                uint32_t n_ = ukl_min(ukl_atomic_poll(&wc_[0]), W(Q_CAP));                             \
                ukl_atomic_store(&wc_[2], n_);                                                         \
                ukl_atomic_store(&wc_[0], 0u);                                                         \
                ukl_atomic_store(&wc_[1], (ukl_atomic_load(&wc_[1]) & 1u) ^ 1u);                       \
            }                                                                                          \
            BARRIER();                                                                                 \
            PX_WALK_SET(which_, wc_, ukl_atomic_poll(&wc_[2]));                                        \
            PX_WALK_PHASES(EACH, BARRIER, SCAN, SEG, which_, ONE(x) { AT(uint32_t, CTL)[24] = ukl_max(AT(const uint32_t, CTL)[24], w_.total); px_refuse(AT(uint32_t, CTL), X_ROOM); } BARRIER(); break); \
        }                                                                                              \
    }

// The top level's exit-bearing calls decided live (`px_top_claim`), and `XCOVER` the max scan of
// the live ones' ends. `V`, `OPV` and `OBASE` (made after it) hold the jumps and the marks.
#define PX_TOP_COVER(TOKS, nt_)                                                                        \
    {                                                                                                  \
        EACH(s, nt_) px_top_node0(AT(const uint32_t, HX), W(HX_MASK), tc0_, AT(uint32_t, CHW) + 1u, TOKS, s); \
        BARRIER();                                                                                     \
        EACH(s, nt_) px_top_node(AT(const uint32_t, STATE), AT(const uint32_t, OID), AT(const PxList, LISTS), tc0_, TOKS, s); \
        BARRIER();                                                                                     \
        EACH(s, nt_) px_ch_seed(AT(const PxList, LISTS), tc0_, TOP, 0u, TOKS[0], AT(uint32_t, CHW) + 1u, s); \
        BARRIER();                                                                                     \
        PX_CH_DOUBLE(EACH, BARRIER, nt_, tc0_, tc1_, AT(uint32_t, CHW) + 1u, tc_);                     \
        uint32_t nx_ = N(XTOTAL);                                                                      \
        EACH(i, nx_) px_top_claim(AT(const uint32_t, XPOS), AT(const uint32_t, XTOTAL), AT(const uint32_t, OID), AT(PxList, LISTS), tc_, AT(uint32_t, XAT), AT(uint32_t, XFLAG), i); \
        BARRIER();                                                                                     \
        PP_GLOBAL uint32_t* j0_ = AT(uint32_t, V);                                                    \
        PP_GLOBAL uint32_t* j1_ = AT(uint32_t, OPV);                                                  \
        PP_GLOBAL uint32_t* on_ = AT(uint32_t, OBASE);                                                \
        EACH(i, nx_) px_top_next(AT(const uint32_t, XPOS), AT(const uint32_t, XTOTAL), AT(const uint32_t, XAT), j0_, on_, i); \
        BARRIER();                                                                                     \
        for (uint32_t d_ = 1u; d_ < nx_; d_ *= 2u) {                                                   \
            EACH(i, nx_) px_live_jump(nx_, j0_, j1_, on_, i);                                          \
            BARRIER();                                                                                 \
            PP_GLOBAL uint32_t* js_ = j0_; j0_ = j1_; j1_ = js_;                                      \
        }                                                                                              \
        EACH(i, nx_) px_top_live(AT(const uint32_t, XTOTAL), on_, AT(uint32_t, XAT), i);              \
        BARRIER();                                                                                     \
        SEG(UKL_SEG_MAX, nx_, XAT, XFLAG, XCOVER);                                                     \
    }

// The top level's rollback, its sizes and places, over a top of `nt_` tokens (after the rounds,
// when every list is final).
#define PX_PLACES(T, TOKS, nt_)                                                                      \
    {                                                                                                  \
    Ch tc0_ = px_ch(AT(uint32_t, TCH), W(TCH_CAP), 0u), tc1_ = px_ch(AT(uint32_t, TCH), W(TCH_CAP), 1u), tc_ = tc0_; \
    EACH(s, nt_) px_top_xflag(AT(const uint32_t, STATE), AT(const uint32_t, OID), AT(const PxList, LISTS), TOKS, AT(uint32_t, XFLAG), s); \
    BARRIER();                                                                                         \
    SCAN(nt_, XFLAG, XAT, XTOTAL);                                                                     \
    EACH(s, nt_) px_top_xlist(AT(const uint32_t, XFLAG), AT(const uint32_t, XAT), TOKS, AT(uint32_t, XPOS), s); \
    BARRIER();                                                                                         \
    PX_TOP_COVER(TOKS, nt_);                                                                           \
    EACH(s, nt_) px_top_sizes(AT(uint32_t, STATE), AT(const uint32_t, OID), AT(PxList, LISTS), tc_, tc0_.nx, TOKS, AT(uint32_t, V), AT(const uint32_t, XPOS), AT(const uint32_t, XTOTAL), AT(const uint32_t, XCOVER), s); \
    BARRIER();                                                                                         \
    EACH(s, nt_) px_top_pieces(AT(const uint32_t, STATE), AT(const uint32_t, OID), AT(PxList, LISTS), tc_, TOKS, AT(uint32_t, OPV), s); \
    BARRIER();                                                                                         \
    SCAN(nt_, V, OBASE, VTOTAL);                                                                       \
    SCAN(nt_, OPV, OPBASE, OPTOTAL);                                                                      \
    EACH(s, nt_) px_top_place(AT(const uint32_t, STATE), AT(const uint32_t, OID), AT(PxList, LISTS), tc_, tc0_.nx, tc1_.nx, TOKS, AT(const uint32_t, OBASE), AT(const uint32_t, OPBASE), AT(uint32_t, OUT), AT(uint32_t, CTL), W(OUT_CAP), s); \
    BARRIER();                                                                                         \
    EACH(s, nt_) px_top_member(AT(PxList, LISTS), tc_, tc0_.nx, tc1_.nx, TOKS, AT(uint32_t, SLOTS), AT(uint32_t, QCTL), AT(uint32_t, CTL), W(Q_CAP), s); \
    /* The second phase places what the first made: no compaction. */                                  \
    ONE(x) px_marks_off(AT(uint32_t, CTL));                                                            \
    BARRIER();                                                                                         \
    }

// The top level's runs' lengths, once the second phase placed every piece of the output.
#define PX_OUT_RUNS()                                                                                  \
    EACH(i, ukl_min(N(OPTOTAL), W(OUT_CAP))) px_out_run(AT(uint32_t, OUT), W(OUT_CAP), AT(const uint32_t, OPTOTAL), AT(const uint32_t, VTOTAL), i); \
    BARRIER()

// The rounds made ready for another top: their items' counts emptied, the arena's tops back to the file literals' (`CTL` 6 and 7 keep
// them). The refusals stay.
#define PX_RESET()                                                                                     \
    ONE(x) {                                                                                           \
        PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);                                                    \
        /* Each top's high water first (`Exp::room` sizes the next run from it). */                     \
        c_[8] = ukl_max(c_[8], c_[0]); c_[9] = ukl_max(c_[9], c_[1]); c_[10] = ukl_max(c_[10], c_[3]);  \
        c_[11] = ukl_max(c_[11], c_[4]); c_[12] = ukl_max(c_[12], c_[5]);                              \
        c_[14] = ukl_max(c_[14], AT(const uint32_t, OPTOTAL)[0]);                                       \
        c_[0] = 0u; c_[1] = 0u; c_[3] = 0u; c_[4] = c_[6]; c_[5] = c_[7];                              \
        c_[15] = AT(const uint32_t, WORDS)[11]; c_[18] = AT(const uint32_t, WORDS)[12]; c_[19] = AT(const uint32_t, WORDS)[13]; \
        AT(uint32_t, QCTL)[0] = 0u; AT(uint32_t, QCTL)[1] = 0u; AT(uint32_t, QCTL)[2] = 0u; AT(uint32_t, QCTL)[4] = 0u; AT(uint32_t, CNT)[1] = 0u; \
    }                                                                                                  \
    /* The pools empty (decision 0486 §10): the tokens' heads past their five columns, the lists'    \
       and the arguments' past their links. */                                                         \
    EACH(h, W(HX_MASK) + 1u) px_hx_clear(AT(uint32_t, HX), W(HX_MASK), h);                             \
    EACH(c, UKL_POOL_CLASSES) {                                                                        \
        AT(uint32_t, TOKENS)[5u * AT(const uint32_t, WORDS)[1] + c] = UKL_POOL_NONE;                  \
        ((UKL_GLOBAL uint32_t*)(AT(PxList, LISTS) + W(LIST_CAP)))[W(LIST_CAP) + c] = UKL_POOL_NONE;    \
        ((UKL_GLOBAL uint32_t*)(AT(PxArg, ARGS) + AT(const uint32_t, WORDS)[3]))[AT(const uint32_t, WORDS)[3] + c] = UKL_POOL_NONE; \
    }                                                                                                  \
    BARRIER()

// A top's rounds (decision 0527): each round takes the items the one before made (`QCTL` 1 to 2,
// the halves swapped), runs them on the whole grid, and the next starts at a barrier. Between
// rounds, where a store's front passed its mark (`px_past_marks`), the blocks and ids no item reads
// again are given back (decision 0486 §10), at most `WORDS` 15 times. A top's items at most
// `WORDS` 14 (`X_WORK` past it: an expansion that would hold a launch too long; no store ran out,
// so no rung is larger for it). `CTL` 17 is one thread's decision, read by all past a barrier.
#define PX_DRAIN(T, CLOSES)                                                                          \
    {                                                                                                  \
        uint32_t gives_ = 0u, gmax_ = AT(const uint32_t, WORDS)[15], work_ = AT(const uint32_t, WORDS)[14]; \
        PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);                                                    \
        for (uint32_t it_ = 0u; it_ < work_ + gmax_ + 2u; it_++) {                                     \
            ONE(x) {                                                                                   \
                PP_GLOBAL uint32_t* q_ = AT(uint32_t, QCTL);                                          \
                uint32_t n_ = ukl_min(ukl_atomic_poll(&q_[1]), W(Q_CAP));                              \
                c_[13] = ukl_max(c_[13], n_);                                                          \
                uint32_t go_ = n_ == 0u ? 0u : 1u;                                                     \
                if (n_ != 0u && q_[0] + n_ > work_) { px_refuse(c_, X_WORK); go_ = 0u; }               \
                else if (n_ != 0u) {                                                                   \
                    q_[0] += n_;                                                                       \
                    ukl_atomic_store(&q_[2], n_);                                                      \
                    ukl_atomic_store(&q_[1], 0u);                                                      \
                    ukl_atomic_store(&q_[5], 0u);                                                      \
                    ukl_atomic_store(&q_[6], 0u);                                                      \
                    ukl_atomic_store(&q_[7], 0u);                                                      \
                    ukl_atomic_store(&q_[9], 0u);                                                      \
                    ukl_atomic_store(&q_[4], (q_[4] & 1u) ^ 1u);                                       \
                    c_[25]++;                                                                          \
                }                                                                                      \
                ukl_atomic_store(&c_[17], go_);                                                        \
            }                                                                                          \
            BARRIER();                                                                                 \
            if (ukl_atomic_poll(&c_[17]) == 0u) break;                                                 \
            PX_ROUND(px_r_work, CLOSES, 0u);                                                           \
            BARRIER();                                                                                 \
            PX_ROUND(px_r_calls, CLOSES, 0u);                                                          \
            PX_ROUND(px_r_substs, CLOSES, 0u);                                                         \
            PX_ROUND(px_r_scans, CLOSES, 0u);                                                          \
            BARRIER();                                                                                 \
            PX_ROUND(px_r_walks, CLOSES, 0u);                                                          \
            PX_ROUND(px_r_walks, CLOSES, 1u);                                                          \
            ONE(x) {                                                                                   \
                ukl_atomic_store(&AT(uint32_t, QCTL)[2], 0u);                                          \
                ukl_atomic_store(&c_[17], px_past_marks(c_) ? 2u : 1u);                                \
            }                                                                                          \
            BARRIER();                                                                                 \
            if (ukl_atomic_poll(&c_[17]) == 2u) {                                                      \
                if (gives_ == gmax_) { ONE(x) px_refuse(c_, X_QUEUE); break; }                          \
                PX_ROUND(px_r_give, CLOSES, 0u); gives_++;                                                                \
            }                                                                                          \
        }                                                                                              \
    }

// A pause's forwarding and givings (`px_gv_*`), a thread a list, a slot or a piece, in the round's
// scan's stores (no scan runs in a pause): the lists' slots numbered; the forwardings' chains'
// ends by doubling, each list's stop, the slots forwarded and their chains' calls dead; each
// slot's span, the slots reached by doubling, each list's last, the pieces each takes out and
// their scan, the last reached slot at each; each list given back (a dead one's blocks) and its
// pieces kept counted; the pieces of the lists that lose some numbered, a moving list's new block,
// its kept pieces moved, its old block and its end given back.
#define PX_GIVE_LISTS()                                                                                \
    Gv v_;                                                                                             \
    v_.lists = AT(PxList, LISTS); v_.cols = AT(uint32_t, TOKENS); v_.pool = gv_p; v_.ctl = gv_c;       \
    v_.tc = gv_tc; v_.n = gv_nl; v_.ns = 0u; v_.pnd = 0u; v_.np = 0u;                                  \
    v_.base = AT(uint32_t, SC_K); v_.cnt = AT(uint32_t, SC_M); v_.fwd = AT(uint32_t, SC_E);            \
    v_.fstop = AT(uint32_t, SC_DEPTH); v_.gstop = AT(uint32_t, SC_CKEYS); v_.mark = AT(uint32_t, SC_CAT); \
    v_.flags = AT(uint32_t, SC_CEND); v_.npn = AT(uint32_t, SC_M); v_.pcnt = AT(uint32_t, SC_HEADS);   \
    v_.pbase = AT(uint32_t, SC_VB); v_.nf = AT(uint32_t, SC_LIVE);                                     \
    v_.lo = AT(uint32_t, SC_REACH); v_.pend = AT(uint32_t, SC_LIVE); v_.pscan = AT(uint32_t, SC_RANK); \
    v_.e = AT(uint32_t, SC_M); v_.st = AT(uint32_t, SC_HEADS); v_.on = AT(uint32_t, SC_DEPTH);         \
    v_.k = AT(uint32_t, SC_CAT); v_.kscan = AT(uint32_t, SC_CLOSE); v_.pa = AT(uint32_t, SC_DELTA);     \
    v_.top = AT(uint32_t, SC_VA); v_.rin = AT(uint32_t, SC_LIVE); v_.heads = AT(uint32_t, SC_RANK);    \
    v_.words = AT(uint32_t, SC_FIRST);                                                                 \
    ONE(x) v_.words[0] = 0u;                                                                           \
    EACH(i, gv_nl) px_gv_count(v_, i);                                                                 \
    BARRIER();                                                                                         \
    SCAN(gv_nl, SC_M, SC_K, SC_TOTAL);                                                                 \
    v_.ns = N(SC_TOTAL);                                                                               \
    if (v_.ns != 0u) {                                                                                 \
        PP_GLOBAL uint32_t* j0_ = AT(uint32_t, SC_DELTA);                                             \
        PP_GLOBAL uint32_t* j1_ = AT(uint32_t, SC_HEADS);                                             \
        EACH(c, gv_nl) px_gv_fwd(v_, j0_, c);                                                          \
        BARRIER();                                                                                     \
        if (ukl_atomic_poll(&v_.words[0]) != 0u) {                                                     \
            for (uint32_t d_ = 1u; d_ < gv_nl; d_ *= 2u) {                                             \
                EACH(c, gv_nl) px_gv_jump(gv_nl, j0_, j1_, c);                                         \
                BARRIER();                                                                             \
                PP_GLOBAL uint32_t* js_ = j0_; j0_ = j1_; j1_ = js_;                                  \
            }                                                                                          \
            EACH(s_, v_.ns) px_gv_fstop(v_, j0_, s_);                                                  \
            BARRIER();                                                                                 \
            EACH(s_, v_.ns) px_gv_forward(v_, j0_, s_);                                                \
            BARRIER();                                                                                 \
            EACH(c, gv_nl) px_gv_dead(v_, j0_, c);                                                     \
            BARRIER();                                                                                 \
        }                                                                                              \
        v_.xc = px_ch(AT(uint32_t, CH), W(SC_CAP), 0u);                                                \
        {                                                                                              \
            Ch x1_ = px_ch(AT(uint32_t, CH), W(SC_CAP), 1u);                                           \
            ONE(x) ukl_atomic_store(&AT(uint32_t, CHW)[2], 0u);                                        \
            BARRIER();                                                                                 \
            EACH(c, gv_nl) px_gv_xseed(AT(const PxList, LISTS), gv_nl, v_.xc, AT(uint32_t, CHW) + 2u, c); \
            BARRIER();                                                                                 \
            uint32_t xl_ = ukl_atomic_poll(&AT(uint32_t, CHW)[2]);                                     \
            for (uint32_t d_ = 1u; d_ <= xl_; d_ *= 2u) {                                              \
                EACH(c, gv_nl) px_gv_xjump(v_.xc, x1_, gv_nl, c);                                      \
                BARRIER();                                                                             \
                Ch xs_ = v_.xc; v_.xc = x1_; x1_ = xs_;                                                \
            }                                                                                          \
        }                                                                                              \
        EACH(s_, v_.ns) px_gv_slot(v_, s_);                                                            \
        BARRIER();                                                                                     \
        SCAN(v_.ns, SC_LIVE, SC_RANK, SC_LTOTAL);                                                      \
        v_.pnd = N(SC_LTOTAL);                                                                         \
        PP_GLOBAL uint32_t* k0_ = AT(uint32_t, SC_VA);                                                \
        PP_GLOBAL uint32_t* k1_ = AT(uint32_t, SC_VB);                                                \
        EACH(s_, v_.ns) px_gv_span(v_, k0_, s_);                                                       \
        BARRIER();                                                                                     \
        for (uint32_t d_ = 1u; d_ < v_.ns; d_ *= 2u) {                                                 \
            EACH(s_, v_.ns) px_live_jump(v_.ns, k0_, k1_, v_.on, s_);                                  \
            BARRIER();                                                                                 \
            PP_GLOBAL uint32_t* ks_ = k0_; k0_ = k1_; k1_ = ks_;                                      \
        }                                                                                              \
        EACH(s_, v_.ns) px_gv_stop(v_, s_);                                                            \
        BARRIER();                                                                                     \
        EACH(s_, v_.ns) px_gv_take(v_, s_);                                                            \
        BARRIER();                                                                                     \
        SCAN(v_.ns, SC_CAT, SC_CLOSE, SC_CTOTAL);                                                      \
        SEG(UKL_SEG_MAX, v_.ns, SC_LIVE, SC_RANK, SC_VA);                                              \
    }                                                                                                  \
    EACH(i, gv_nl) px_gv_keep(v_, i);                                                                  \
    BARRIER();                                                                                         \
    SCAN(gv_nl, SC_HEADS, SC_VB, SC_LTOTAL);                                                           \
    v_.np = N(SC_LTOTAL);                                                                              \
    if (v_.np != 0u) {                                                                                 \
        EACH(q, v_.np) px_gv_moves(v_, q);                                                             \
        BARRIER();                                                                                     \
        EACH(i, gv_nl) px_gv_block(v_, i);                                                             \
        BARRIER();                                                                                     \
        EACH(q, v_.np) px_gv_move(v_, q);                                                              \
        BARRIER();                                                                                     \
        EACH(i, gv_nl) px_gv_end(v_, i);                                                               \
        BARRIER();                                                                                     \
    }

// The blocks given back: the lists' dead marks, then each list's blocks to the pool; the next
// mark `WORDS` 11 past the front (a fixed gap: halving it as the front nears the room's end spent
// the bound on givings that each found little new). `CTL` 16 counts them.
#define PX_GIVE()                                                                                      \
    {                                                                                                  \
        PP_GLOBAL uint32_t* gv_c = AT(uint32_t, CTL);                                                  \
        uint32_t gv_tc = AT(const uint32_t, WORDS)[1];                                                 \
        uint32_t gv_nl = ukl_min(ukl_atomic_poll(&gv_c[1]), W(LIST_CAP));                              \
        UklPool gv_p; gv_p.heads = (UKL_GLOBAL uint32_t*)(AT(uint32_t, TOKENS) + 5u * gv_tc); gv_p.next = (UKL_GLOBAL uint32_t*)AT(uint32_t, TOKENS); \
        if (gv_nl > W(SC_CAP)) {                                                                       \
            ONE(x) { gv_c[24] = ukl_max(gv_c[24], gv_nl); px_refuse(gv_c, X_ROOM); }                   \
        } else {                                                                                       \
            /* The dead lists: each owner chain's by doubling. */                                      \
            PP_GLOBAL uint32_t* u0_ = AT(uint32_t, SC_K);                                             \
            PP_GLOBAL uint32_t* h0_ = AT(uint32_t, SC_M);                                             \
            PP_GLOBAL uint32_t* u1_ = AT(uint32_t, SC_E);                                             \
            PP_GLOBAL uint32_t* h1_ = AT(uint32_t, SC_DELTA);                                         \
            EACH(i, gv_nl) px_gc_seed(AT(const PxList, LISTS), gv_nl, u0_, h0_, i);                    \
            BARRIER();                                                                                 \
            for (uint32_t d_ = 1u; d_ < gv_nl; d_ *= 2u) {                                             \
                EACH(i, gv_nl) px_gc_jump(gv_nl, u0_, h0_, u1_, h1_, i);                               \
                BARRIER();                                                                             \
                PP_GLOBAL uint32_t* us_ = u0_; u0_ = u1_; u1_ = us_;                                  \
                PP_GLOBAL uint32_t* hs_ = h0_; h0_ = h1_; h1_ = hs_;                                  \
            }                                                                                          \
            EACH(i, gv_nl) px_gc_dead(AT(PxList, LISTS), h0_, i);                                      \
            BARRIER();                                                                                 \
            PX_GIVE_LISTS();                                                                           \
            /* The lists' ids and the arguments' entries no item reads again. */                       \
            UklPool gv_lp; gv_lp.next = (UKL_GLOBAL uint32_t*)(AT(PxList, LISTS) + W(LIST_CAP)); gv_lp.heads = gv_lp.next + W(LIST_CAP);\
            UklPool gv_ap; gv_ap.next = (UKL_GLOBAL uint32_t*)(AT(PxArg, ARGS) + AT(const uint32_t, WORDS)[3]); gv_ap.heads = gv_ap.next + AT(const uint32_t, WORDS)[3];\
            bool gv_counted = ukl_atomic_poll(&AT(uint32_t, CNT)[1]) != 0u;                            \
            EACH(i, gv_nl) px_free_mark(AT(PxList, LISTS), gv_ap, gv_counted, i);                      \
            BARRIER();                                                                                 \
            EACH(i, gv_nl) px_free_run(AT(const PxList, LISTS), gv_nl, AT(uint32_t, SC_M), AT(uint32_t, SC_K), i);\
            BARRIER();                                                                                 \
            SEG(UKL_SEG_MAX, gv_nl, SC_M, SC_K, SC_E);                                                 \
            EACH(i, gv_nl) px_free_give(AT(const PxList, LISTS), gv_lp, gv_nl, AT(const uint32_t, SC_E), i);\
            BARRIER();                                                                                 \
            EACH(i, gv_nl) px_free_done(AT(PxList, LISTS), i);                                         \
            BARRIER();                                                                                 \
            /* The exits' table without the dead ones. */                                              \
            EACH(h, W(HX_MASK) + 1u) px_hx_clear(AT(uint32_t, HX), W(HX_MASK), h);                     \
            BARRIER();                                                                                 \
            EACH(i, gv_nl) px_hx_keep(AT(const PxList, LISTS), AT(uint32_t, HX), W(HX_MASK), gv_c, gv_nl, i); \
        }                                                                                              \
        BARRIER();                                                                                     \
        ONE(x) {                                                                                       \
            uint32_t front_ = ukl_min(ukl_atomic_poll(&gv_c[0]), gv_tc);                               \
            ukl_atomic_store(&gv_c[15], front_ + AT(const uint32_t, WORDS)[11]);                       \
            ukl_atomic_store(&gv_c[18], ukl_min(ukl_atomic_poll(&gv_c[1]), W(LIST_CAP)) + AT(const uint32_t, WORDS)[12]); \
            ukl_atomic_store(&gv_c[19], ukl_min(ukl_atomic_poll(&gv_c[3]), AT(const uint32_t, WORDS)[3]) + AT(const uint32_t, WORDS)[13]); \
            ukl_atomic_store(&gv_c[20], 0u); ukl_atomic_store(&gv_c[21], 0u); ukl_atomic_store(&gv_c[22], 0u); \
            gv_c[16] += 1u;                                                                            \
        }                                                                                              \
        BARRIER();                                                                                     \
    }

// `__COUNTER__`'s uses of the top just expanded placed, then counted (decision 0485 §3): `part`
// 0 the text, 1 the lines.
#define PX_COUNTERS(u, part)                                                                           \
    if (ukl_min(AT(const uint32_t, CNT)[1], W(CNT_CAP)) != 0u) {                                       \
        PP_GLOBAL uint32_t* cc_ = AT(uint32_t, CTL);                                                  \
        uint32_t cn_ = ukl_min(ukl_atomic_poll(&cc_[1]), W(LIST_CAP)), cs_ = W(SC_CAP);                \
        if (2u * cn_ > cs_ || 2u * W(CNT_CAP) > cs_) {                                                 \
            ONE(x) { cc_[24] = ukl_max(cc_[24], ukl_max(2u * cn_, 2u * W(CNT_CAP))); px_refuse(cc_, X_ROOM); } \
            BARRIER();                                                                                 \
        } else {                                                                                       \
            /* The lists' tree, its tour, and each arc's sums to its end (`px_ct_*`). */               \
            Ct ct_;                                                                                    \
            ct_.keys = AT(uint64_t, SC_CKEYS); ct_.perm = AT(uint32_t, SC_VA); ct_.n = cn_;           \
            ct_.first = AT(uint32_t, SC_M); ct_.next = AT(uint32_t, SC_K); ct_.use = AT(uint32_t, SC_E); \
            ct_.bad = AT(uint32_t, SC_DELTA); ct_.root = AT(uint32_t, CHW) + 3u;                       \
            PP_GLOBAL uint32_t* chs_ = AT(uint32_t, CH);                                              \
            ct_.succ = chs_; ct_.w = chs_ + cs_;                                                       \
            PP_GLOBAL uint32_t* n0_ = chs_ + 2u * cs_; PP_GLOBAL uint32_t* n1_ = chs_ + 3u * cs_;    \
            PP_GLOBAL uint32_t* s0_ = chs_ + 4u * cs_; PP_GLOBAL uint32_t* s1_ = chs_ + 5u * cs_;    \
            EACH(x, cn_) px_ct_key(AT(const PxList, LISTS), ct_, x);                                   \
            BARRIER();                                                                                 \
            EACH(i, W(CNT_CAP)) px_ct_use(AT(const uint32_t, CNT), W(CNT_CAP), ct_, i);                \
            SORT(cn_, 64u, SC_CKEYS, SC_VA, SC_KB, SC_VB, SC_HIST);                                    \
            EACH(p, cn_) px_ct_sib(ct_, p);                                                            \
            BARRIER();                                                                                 \
            EACH(x, cn_) px_ct_arcs(AT(const PxList, LISTS), ct_, n0_, s0_, x);                       \
            BARRIER();                                                                                 \
            for (uint32_t r_ = 0u; r_ < 2u; r_++) {                                                    \
                for (uint32_t d_ = 1u; d_ < 2u * cn_; d_ *= 2u) {                                      \
                    EACH(a, 2u * cn_) px_ct_jump(2u * cn_, n0_, s0_, n1_, s1_, a);                     \
                    BARRIER();                                                                         \
                    PP_GLOBAL uint32_t* ns_ = n0_; n0_ = n1_; n1_ = ns_;                              \
                    PP_GLOBAL uint32_t* ss_ = s0_; s0_ = s1_; s1_ = ss_;                              \
                }                                                                                      \
                if (r_ == 0u) {                                                                        \
                    /* The sums now in `s0_`: the rolled back ones; then the uses from `s1_`. */      \
                    EACH(x, cn_) px_ct_good(ct_, s0_, n1_, s1_, x);                                    \
                    BARRIER();                                                                         \
                    PP_GLOBAL uint32_t* ns_ = n0_; n0_ = n1_; n1_ = ns_;                              \
                    PP_GLOBAL uint32_t* ss_ = s0_; s0_ = s1_; s1_ = ss_;                              \
                }                                                                                      \
            }                                                                                          \
            EACH(i, W(CNT_CAP)) px_counter_place(u, AT(const PxList, LISTS), AT(const uint32_t, CNT), W(CNT_CAP), TFACTS, (part), cc_, ct_, s0_, i); \
            BARRIER();                                                                                 \
            /* The uses of both passes ranked (`px_cv_*`). */                                          \
            Tf tf_ = TFACTS;                                                                           \
            uint32_t m0_ = ukl_min(tf_.n[2], tf_.cap), cm_ = m0_ + ukl_min(tf_.n[3], tf_.cap);        \
            EACH(c, cm_) px_cv_key(tf_, m0_, cm_, AT(uint64_t, SC_CKEYS), c);                          \
            SORT(cm_, 32u, SC_CKEYS, SC_VA, SC_KB, SC_VB, SC_HIST);                                    \
            EACH(p, cm_) px_cv_key2(tf_, m0_, cm_, AT(uint64_t, SC_CKEYS), AT(const uint32_t, SC_VA), p); \
            SORTV(cm_, 64u, SC_CKEYS, SC_VA, SC_KB, SC_VB, SC_HIST);                                   \
            EACH(p, cm_) px_cv_heads(tf_, m0_, cm_, AT(const uint32_t, SC_VA), AT(uint32_t, SC_CLOSE), AT(uint32_t, SC_CEND), AT(uint32_t, SC_REACH), p); \
            BARRIER();                                                                                 \
            SEG(UKL_SEG_MAX, cm_, SC_CLOSE, SC_REACH, SC_LIVE);                                        \
            SEG(UKL_SEG_MAX, cm_, SC_CEND, SC_REACH, SC_RANK);                                         \
            EACH(p, cm_) px_cv_rank(cm_, AT(const uint32_t, SC_VA), AT(const uint32_t, SC_LIVE), AT(const uint32_t, SC_RANK), AT(uint32_t, SC_DEPTH), p); \
            BARRIER();                                                                                 \
            EACH(i, W(CNT_CAP)) px_counter_value(tf_, AT(const uint32_t, CNT), W(CNT_CAP), (part), AT(PxScratch, SCRATCH), \
                                                 (PP_GLOBAL uint8_t*)(AT(PxScratch, SCRATCH) + AT(const uint32_t, WORDS)[9]), AT(const uint32_t, SC_DEPTH), i); \
            BARRIER();                                                                                 \
        }                                                                                              \
    } else {                                                                                           \
        ONE(x) AT(uint32_t, TRN)[2u + (part)] = 0u;                                                    \
        BARRIER();                                                                                     \
    }

// The unit as the text's counters read it: its stretches in the unit's order, their instances
// and slots.
#define TEXT_UX(u)                                                                                     \
    Ux u;                                                                                              \
    u.nodes = AT(const PpNode, P1_NODES); u.tinst = AT(const uint32_t, SINST); u.gat = AT(const uint32_t, GAT); \
    u.n_gaps = N(N_GAPS); u.sc = TEXT_SCOPE

// The file table and the requests, as the tests' and the includes' passes read them.
#define IF_FILES(fx, nm)                                                                               \
    IfFiles fx;                                                                                        \
    fx.ft_keys = AT(const uint64_t, P1_FTKEYS); fx.ft_files = AT(const uint32_t, P1_FTFILES); fx.n_ft = W(N_FT); \
    fx.found_by = AT(const uint32_t, P1_FOUNDBY); fx.unit_file = AT(const uint32_t, P1_UFILE); fx.reqs = AT(PpReq, P1_REQS); \
    fx.n_reqs = AT(uint32_t, P1_NREQ); fx.req_cap = W(RQC); fx.flags = AT(uint32_t, P1_FLAGS);                \
    IfNames nm;                                                                                        \
    nm.bytes = AT(uint8_t, P1_RNAMES); nm.top = AT(uint32_t, P1_RNTOP); nm.cap = W(RNC)

// The unit as the tests' passes read it (`Ux`): its files, definitions and table, and the tests'
// lines as its top.
#define IF_UX(u)                                                                                       \
    Ux u;                                                                                              \
    u.files = files; u.data = data; u.bases = AT(const uint32_t, BASES); u.n_files = nf; u.keys = AT(const uint64_t, KEYS); \
    u.defs = AT(const PpDef, DEFS); u.items = AT(const uint32_t, ITEMS); u.vai = AT(const uint32_t, VAI); u.sorted = AT(const uint64_t, SORT_KEYS);          \
    u.perm = AT(const uint32_t, SORT_VA); u.n_rows = N(N_ROWS); u.name_keys = AT(const uint64_t, NAME_KEYS);                 \
    u.values = AT(const uint32_t, VALUES); u.text_nodes = AT(const uint32_t, IF_NODES); u.gat = AT(const uint32_t, IF_AT);  \
    u.n_gaps = N(N_DIRS); u.firsts = AT(const uint32_t, IF_AT); u.n_toks = N(IF_TOTAL); u.tdepth = AT(const uint32_t, DEPTH); \
    u.va_opt = 0ul; u.stoks = AT(const PxScratch, SCRATCH);                                                                   \
    u.sbytes = (PP_GLOBAL const uint8_t*)(AT(const PxScratch, SCRATCH) + AT(const uint32_t, WORDS)[9]);                      \
    u.relex_options = 0u; u.closes = AT(const uint64_t, CLOSE_KEYS); u.n_close = 0u;                                          \
    u.floors = AT(const uint32_t, FLOORS); u.n_units = W(N_UNITS); u.tinst = AT(const uint32_t, IF_INST); u.nodes = AT(const PpNode, P1_NODES); \
    u.unit_file = AT(const uint32_t, P1_UFILE); u.op_keys = AT(const uint64_t, IF_OPKEYS); u.op_kinds = AT(const uint32_t, IF_OPKINDS); \
    u.n_ops = W(N_IFOP); u.feat_keys = AT(const uint64_t, IF_FEATKEYS); u.feat_vals = AT(const uint64_t, IF_FEATVALS); u.n_feat = W(N_FEAT); \
    u.tline = AT(const uint32_t, ILINE); u.tlinen = AT(const uint32_t, ILINEN); u.ldelta = AT(const uint32_t, LDELTA); u.lt0 = AT(const uint32_t, LCTL)[0]; \
    u.sc = IF_SCOPE

// A group's threadgroup memory: the barrier's flag, the scans' scratch, and the sorts' counts or
// a sorted tile (the segmented scans' two rows alias them: no phase runs two of them).
#define PP_TG_BIG UKL_GRID_SORT_WORDS
typedef struct PpTg {
    uint32_t flag;
    // The group's ticket and the grid's count (`ukl_grid_join`).
    uint32_t join[2];
    uint32_t scratch[UKL_TG_SCRATCH];
    uint32_t big[PP_TG_BIG];
} PpTg;

// The stage word of `GRID` (after the grid's four: the barrier's three and the join's tickets,
// `ukl/grid.h`): 0 the rounds, 1 the places' rounds, 2 done.
#define PG_STAGE (4u)
// Set where P1 ends the round before the expansion (requests, or a refusal: decision 0467 §1).
#define PG_STOP (5u)

// The rows of every grid kernel: the arena, the slab, the layout, the group's memory, and where
// the thread is.
#define PP_GRID_ROWS                                                                                   \
    RWBUFFER, uint8_t,  arena, "[arena]",                                                              \
    ROBUFFER, uint8_t,  data,  "[data]",                                                               \
    ROBUFFER, uint32_t, lay,   "[slots]",                                                              \
    SHARED,   PpTg,     tg,    1,                                                                      \
    GSZ0,     uint32_t, gsz,   ,                                                                       \
    TGID0,    uint32_t, group, ,                                                                       \
    LID0,     uint32_t, lid,   ,                                                                       \
    LSZ0,     uint32_t, lsz,

// The grid sort's threadgroup words, in the group's `big` (`ukl/grid.h`'s `UklGridSortLocal`).
#define PP_SORT_LOCAL                                                                                  \
    UklGridSortLocal sl;                                                                               \
    sl.counts = tg->big; sl.h = tg->big + UKL_RADIX_GROUPS * UKL_RADIX_DIGITS;                           \
    sl.before = sl.h + UKL_RADIX_DIGITS; sl.base = sl.before + UKL_RADIX_DIGITS;                          \
    sl.digits = sl.base + UKL_RADIX_DIGITS; sl.tile = tg->big

#define PP_GRID_BEGIN                                                                                  \
    UklGrid g;                                                                                         \
    g.ctl = IN(uint32_t, GRID); g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;      \
    PP_SORT_LOCAL;                                                                                     \
    UKL_GLOBAL const PpFile* files = IN(const PpFile, FILES);                                              \
    uint32_t nf = W(N_FILES);                                                                              \
    uint32_t stop = 0u, phase = 0u;                                                                        \
    UklScanJob jobs[UKL_GRID_SCANS];                                                                   \
    (void)data; (void)files; (void)nf; (void)sl; (void)stop; (void)phase; (void)jobs;

// A top's rounds (`PX_DRAIN`), compiled once for the four calls: the tests' lines (`is_if`) or
// the text, before and after the places. Expanded at each, the kernel held its rounds four
// times over.
#define DR_TOP                                                                                         \
    is_if ? AT(const uint32_t, IF_NODES) : AT(const uint32_t, TEXT_NODES),                             \
    is_if ? AT(const uint32_t, IF_AT) : AT(const uint32_t, GAT),                                       \
    is_if ? AT(const uint32_t, N_DIRS) : AT(const uint32_t, N_GAPS),                                   \
    is_if ? AT(const uint32_t, IF_AT) : AT(const uint32_t, GFIRSTS),                                   \
    is_if ? AT(const uint32_t, IF_TOTAL) : AT(const uint32_t, GTOTAL)
#define DR_INST                                                                                        \
    is_if ? AT(const uint32_t, IF_INST) : AT(const uint32_t, SINST), AT(const PpNode, P1_NODES),       \
    AT(const uint32_t, P1_UFILE),                                                                      \
    is_if ? AT(const uint32_t, ILINE) : AT(const uint32_t, SLINE),                                     \
    is_if ? AT(const uint32_t, ILINEN) : AT(const uint32_t, SLINEN),                                   \
    mk_scope(is_if ? 0u : 1u, AT(const uint32_t, RSTART), AT(const uint32_t, RUNX), AT(const uint32_t, RUN_END), \
             is_if ? AT(const uint32_t, IF_INST) : AT(const uint32_t, SINST),                          \
             is_if ? AT(const uint32_t, DSLOT) : AT(const uint32_t, SSLOT)),                           \
    TFACTS
#undef PX_QUIT
#define PX_QUIT return (*phasep = phase, false)
// A round's sets of phases, each a function (`PX_ROUND`).
#define PX_PHASE_PARAMS                                                                                \
    RWBUFFER(uint8_t) arena, ROBUFFER(uint8_t) data, ROBUFFER(uint32_t) lay, UKL_LOCAL PpTg* tg,        \
    UklGrid g, UKL_PRIVATE uint32_t* phasep, uint32_t stop, bool is_if, PP_GLOBAL const uint64_t* closes, \
    uint32_t which __UKL_PARAMS
#define PX_PHASE_BEGIN                                                                                 \
    PP_SORT_LOCAL;                                                                                     \
    UKL_GLOBAL const PpFile* files = IN(const PpFile, FILES);                                          \
    uint32_t phase = *phasep;                                                                          \
    UklScanJob jobs[UKL_GRID_SCANS];                                                                   \
    (void)sl; (void)jobs; (void)files; (void)which; (void)is_if; (void)closes
#define PX_PHASE_END *phasep = phase; return true
#define PX_ROUND(f, CLOSES, w) if (!f(arena, data, lay, tg, g, &phase, stop, is_if, (CLOSES), (w) __UKL_ARGS)) PX_QUIT
UKL_CALLED bool px_r_work(PX_PHASE_PARAMS) { PX_PHASE_BEGIN; PX_WORK_ON(DR, closes); PX_PHASE_END; }
UKL_CALLED bool px_r_calls(PX_PHASE_PARAMS) { PX_PHASE_BEGIN; PX_CALLS(DR, closes); PX_PHASE_END; }
UKL_CALLED bool px_r_substs(PX_PHASE_PARAMS) { PX_PHASE_BEGIN; PX_SUBSTS(DR, closes); PX_PHASE_END; }
UKL_CALLED bool px_r_scans(PX_PHASE_PARAMS) { PX_PHASE_BEGIN; PX_SCANS(DR, closes); PX_PHASE_END; }
UKL_CALLED bool px_r_walks(PX_PHASE_PARAMS) { PX_PHASE_BEGIN; PX_WALKS(DR, closes, which); PX_PHASE_END; }
UKL_CALLED bool px_r_give(PX_PHASE_PARAMS) { PX_PHASE_BEGIN; PX_GIVE(); PX_PHASE_END; }
UKL_CALLED bool px_drain(RWBUFFER(uint8_t) arena, ROBUFFER(uint8_t) data, ROBUFFER(uint32_t) lay, UKL_LOCAL PpTg* tg,
                         UklGrid g, UKL_PRIVATE uint32_t* phasep, uint32_t stop, bool is_if,
                         PP_GLOBAL const uint64_t* closes __UKL_PARAMS)
{
    PP_SORT_LOCAL;
    UKL_GLOBAL const PpFile* files = IN(const PpFile, FILES);
    uint32_t phase = *phasep;
    UklScanJob jobs[UKL_GRID_SCANS];
    (void)sl; (void)jobs; (void)files;
    PX_DRAIN(DR, closes);
    *phasep = phase;
    return true;
}
#undef PX_QUIT
#define PX_QUIT return
#define PX_DRAIN_CALL(is_if, closes) if (!px_drain(arena, data, lay, tg, g, &phase, stop, (is_if), (closes) __UKL_ARGS)) return

DEFINE_KERNEL2(pp, pp_setup, PP_GRID_ROWS)
{
    PP_GRID_BEGIN
    // The grid is the groups that run (decision 0540 §3): a group past the count's close ends here.
    if (!ukl_grid_join(&g, gsz / lsz, tg->join)) return;
    stop = W(STOP);
    if (ukl_grid_failed(g)) return;
    uint32_t last = W(LAST);
    // --- The front: the nodes, the names, the directives, the text map, the guards ----------
    // A node a thread, and a scan or a sort between: no thread walks a file (decision 0468).
    uint32_t nn = N(TOTAL);
    EACH(n, nn) {
        pp_names(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint64_t, KEYS), nf, n);
        if (W(NODES_FLAG) != 0u) pp_nodes(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint32_t, NODES_OUT), nf, n);
        pp_node_flags(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(uint32_t, DFLAG), AT(uint32_t, GFLAG), AT(uint32_t, DEV), AT(uint32_t, OWNER_IN), nf, n);
    }
    BARRIER();
    JOB(0, nn, DFLAG, DRANK, DIR_TOTAL);
    JOB(1, nn, GFLAG, GRANK, N_GROUPS);
    JOB(2, nn, DEV, NDEPTH, DEV_TOTAL);
    SCANS(3);
    SEG(UKL_SEG_MAX, nn, OWNER_IN, VHEADS, OWNER);
    EACH(n, nn) pp_node_depths(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(const uint32_t, GFLAG), AT(const uint32_t, GRANK), AT(const uint32_t, OWNER), AT(uint32_t, AFLAG), AT(uint32_t, TFLAG), AT(uint64_t, GRP_KEYS), nf, n);
    BARRIER();
    JOB(0, nn, TFLAG, TRANK, TTOTAL);
    JOB(1, nn, AFLAG, ARANK, N_ARMS);
    SCANS(2);
    EACH(n, nn) {
        pp_arm_keys(AT(const uint32_t, TOTAL), AT(const uint32_t, AFLAG), AT(const uint32_t, ARANK), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(uint64_t, ARM_KEYS), n);
        pe_text_nodes(AT(const uint32_t, TFLAG), AT(const uint32_t, TRANK), AT(const uint32_t, TOTAL), AT(uint32_t, TEXT_NODES), n);
    }
    EACH(f, nf) pp_file_dirs(AT(const uint32_t, BASES), AT(const uint32_t, DRANK), AT(const uint32_t, ARANK), AT(const uint32_t, N_ARMS), AT(uint32_t, DIR_BASES), AT(uint32_t, DIR_GROUPS), nf, f);
    BARRIER();
    SORT(N(N_ARMS), 64u, ARM_KEYS, ASORT_VA, ASORT_KB, ASORT_VB, ASORT_HIST);
    SORT(N(N_GROUPS), 64u, GRP_KEYS, PSORT_VA, PSORT_KB, PSORT_VB, PSORT_HIST);
    EACH(n, nn) pp_rows(files, data, AT(const uint32_t, BASES), AT(const uint32_t, TOTAL), AT(const uint32_t, DFLAG), AT(const uint32_t, DRANK), AT(const uint32_t, NDEPTH), AT(const uint32_t, DEV), AT(const uint32_t, TRANK), AT(const uint32_t, ARANK), AT(const uint32_t, GRANK), AT(const uint64_t, ARM_KEYS), AT(const uint32_t, N_ARMS), AT(const uint64_t, GRP_KEYS), AT(const uint32_t, N_GROUPS), AT(PpDir, ROWS), nf, n);
    BARRIER();
    EACH(r, N(DIR_TOTAL)) {
        pp_dir_keys(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(uint64_t, DIR_KEYS), AT(uint32_t, DIR_ACTS), nf, r);
        pp_guard_marks(AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(uint32_t, G_OUT), AT(uint32_t, G_ARMS), nf, r);
    }
    BARRIER();
    EACH(f, nf) pp_guards(AT(const uint32_t, BASES), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(const uint32_t, TRANK), AT(const uint32_t, TTOTAL), AT(const uint32_t, G_OUT), AT(const uint32_t, G_ARMS), AT(const uint64_t, DIR_KEYS), AT(uint32_t, GUARDED), AT(uint64_t, GUARDS), nf, f);
    if (last == 1u) return;
    // --- The definitions --------------------------------------------------------------------
    EACH(r, N(DIR_TOTAL)) pd_defs(files, data, AT(const uint32_t, BASES), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const PpDir, ROWS), AT(PpDef, DEFS), AT(uint32_t, PCOUNT), AT(uint32_t, BCOUNT), nf, r);
    BARRIER();
    JOB(0, N(DIR_TOTAL), PCOUNT, PFIRST, PTOTAL);
    JOB(1, N(DIR_TOTAL), BCOUNT, IFIRST, ITOTAL);
    SCANS(2);
    EACH(s, N(PTOTAL)) pd_params(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(PpDef, DEFS), AT(const uint32_t, PFIRST), AT(const uint32_t, PTOTAL), AT(uint64_t, PKEYS), AT(uint32_t, ROOM), nf, W(VA_LO), W(VA_HI), W(CAP), s);
    BARRIER();
    EACH(s, N(ITOTAL)) {
        pd_items(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(PpDef, DEFS), AT(const uint32_t, IFIRST), AT(const uint32_t, ITOTAL), AT(const uint64_t, PKEYS), AT(uint32_t, ITEMS), AT(uint32_t, ROOM), nf, W(CAP), s);
        if (s < W(CAP)) AT(uint32_t, VAI)[s] = 0u;
    }
    BARRIER();
    EACH(s, N(ITOTAL)) pd_va_opt(files, data, AT(const uint32_t, BASES), AT(const uint64_t, KEYS), AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(PpDef, DEFS), AT(const uint32_t, IFIRST), AT(const uint32_t, ITOTAL), AT(uint32_t, VAI), nf, ((uint64_t)(W(VO_LO))) | (((uint64_t)(W(VO_HI))) << 32), W(CAP), s);
    if (last == 2u) return;
    // --- P1 (decision 0467): the include tree, its layout and its conditionals, iterated -----
    // Each iteration from the last one's state: the tree's words and layout (§2), the groups'
    // activity, the definitions' table (§3), the tests and the groups (§4), the includes (§5).
    // The iterations end at the first that changes nothing.
    BARRIER();
    PP_GLOBAL PpNode* nodes = AT(PpNode, P1_NODES);
    EACH(w, W(DC)) p1_words_init(AT(uint32_t, P1_MADE), AT(uint32_t, P1_MADEF), AT(uint32_t, P1_ENTER), W(DC), w);
    EACH(r, W(P1_ITERS)) AT(uint32_t, P1_ICHANGED)[r] = 0u;
    EACH(u, W(N_UNITS)) AT(uint32_t, P1_UFIRST)[u] = PP_NONE;
    // The `#line` rows' room in the scratch (two tokens a directive word, and their bytes), then
    // the arena's tops past it and the file literals, kept for each top's reset.
    ONE(x) {
        PP_GLOBAL uint32_t* c_ = AT(uint32_t, CTL);
        PP_GLOBAL uint32_t* l_ = AT(uint32_t, LCTL);
        l_[0] = c_[5]; c_[5] += 2u * W(DC);
        l_[1] = c_[4]; c_[4] += W(LB_CAP);
        if (c_[5] > AT(const uint32_t, WORDS)[9] || c_[4] > AT(const uint32_t, WORDS)[8]) { AT(uint32_t, P1_FLAGS)[0] |= P1_ROOM; AT(uint32_t, P1_NEED)[NEED_REQS] = 0xffffffffu; }
        c_[6] = c_[4]; c_[7] = c_[5];
    }
    BARRIER();
    uint64_t defined_key = AT(const uint64_t, IF_KEYS)[0], true_key = AT(const uint64_t, IF_KEYS)[1];
    uint32_t iter = 0u, grp_from = 0u;
    bool text_done = false;
    for (; iter < W(P1_ITERS); iter++) {
        uint32_t ni = N(N_INSTS);
        PP_GLOBAL uint32_t* ichanged = AT(uint32_t, P1_ICHANGED) + iter;
        // The tree's words, and the iteration's resets.
        EACH(i, ni) p1_counts(nodes, ni, AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const uint32_t, DIR_GROUPS), AT(uint32_t, P1_NDIRS), AT(uint32_t, P1_NGAPS), AT(uint32_t, P1_GCOUNT), nf, i);
        EACH(w, W(DC)) AT(uint32_t, P1_CSIZE)[w] = 0u;
        EACH(u, W(N_UNITS)) AT(uint32_t, P1_USIZE)[u] = 0u;
        EACH(f, nf) p1_once_reset(AT(uint32_t, P1_ONCE), nf, f);
        EACH(r, W(STK_ROUNDS)) AT(uint32_t, STK_CHANGED)[r] = 0u;
        EACH(r, W(P1_JUMPS)) AT(uint32_t, P1_JCHANGED)[r] = 0u;
        ONE(x) { AT(uint32_t, N_STACK)[0] = 0u; AT(uint32_t, P1_NREQ)[0] = 0u; AT(uint32_t, P1_RNTOP)[0] = 0u; AT(uint32_t, LCTL)[2] = 0u; }
        // The built-ins' rows' sort keys, again (the last iteration's sort moved them).
        EACH(p, W(N_BUILTIN)) AT(uint64_t, SORT_KEYS)[p] = AT(const uint64_t, NAME_KEYS)[p] & 0xffffffff00000000ul;
        BARRIER();
        JOB(0, ni, P1_NDIRS, P1_DFIRST, N_DIRS);
        JOB(1, ni, P1_NGAPS, P1_GFIRST, N_GAPS);
        JOB(2, ni, P1_GCOUNT, P1_GRPF, P1_NGRP);
        SCANS(3);
        // Each room's high water (`P1_NEED`), whether or not it ran out: a settled run's rooms
        // are sized from it (decision 0486 §8).
        ONE(x) {
            PP_GLOBAL uint32_t* nd_ = AT(uint32_t, P1_NEED);
            nd_[NEED_DIRS] = ukl_max(nd_[NEED_DIRS], N(N_DIRS)); nd_[NEED_GAPS] = ukl_max(nd_[NEED_GAPS], N(N_GAPS)); nd_[NEED_GROUPS] = ukl_max(nd_[NEED_GROUPS], N(P1_NGRP));
        }
        if (N(N_DIRS) > W(DC) || N(N_GAPS) > W(GC) || N(P1_NGRP) > W(NQ)) {
            ONE(x) ukl_atomic_or(AT(uint32_t, P1_FLAGS), P1_ROOM);
            break;
        }
        uint32_t nd = N(N_DIRS), ng = N(N_GAPS), nq = N(P1_NGRP);
        EACH(i, ni) p1_insts(nodes, ni, AT(const uint32_t, P1_DFIRST), AT(const uint32_t, P1_GFIRST), AT(PpInst, INSTS), AT(uint32_t, P1_LIVE), i);
        EACH(q, nq) p1_grp_init(AT(const uint32_t, P1_GRPF), ni, AT(const uint32_t, P1_NGRP), grp_from, AT(uint32_t, P1_GA), AT(uint32_t, P1_TAKEN), q);
        grp_from = nq;
        BARRIER();
        for (uint32_t dep = 1u; dep <= N(P1_DEPTHN); dep++) {
            EACH(i, ni) p1_live(nodes, ni, AT(const PpInst, INSTS), AT(const uint32_t, P1_ENTER), AT(uint32_t, P1_LIVE), dep, i);
            BARRIER();
        }
        // The layout: sizes bottom-up, the shifts, the units' floors, bases top-down, the slots.
        EACH(i, ni) p1_sizes(nodes, ni, AT(const uint32_t, DIR_BASES), AT(const uint32_t, DIR_TOTAL), AT(const uint32_t, BASES), AT(const uint32_t, TRANK), AT(const uint32_t, TTOTAL), AT(const uint32_t, P1_LIVE), AT(uint32_t, P1_SIZE), nf, i);
        BARRIER();
        for (uint32_t dep = N(P1_DEPTHN); dep > 0u; dep--) {
            EACH(i, ni) p1_up(nodes, AT(const uint32_t, N_INSTS), AT(const PpInst, INSTS), AT(const uint32_t, P1_LIVE), AT(uint32_t, P1_SIZE), AT(uint32_t, P1_CSIZE), dep, i);
            BARRIER();
        }
        EACH(w, ng) p1_gap_words(AT(const PpInst, INSTS), AT(const uint32_t, N_INSTS), AT(const uint32_t, N_GAPS), AT(const uint32_t, P1_CSIZE), AT(uint32_t, P1_GC), AT(uint32_t, P1_GHEADS), w);
        EACH(i, ni) p1_unit_sizes(nodes, AT(const uint32_t, N_INSTS), AT(const uint32_t, P1_SIZE), AT(uint32_t, P1_USIZE), i);
        BARRIER();
        SEG(UKL_SEG_ADD, ng, P1_GC, P1_GHEADS, P1_GSHIFT);
        EACH(u, W(N_UNITS)) p1_unit_spans(AT(uint32_t, P1_USIZE), W(N_UNITS), u);
        BARRIER();
        SCAN(W(N_UNITS), P1_USIZE, FLOORS, P1_UTOTAL);
        EACH(i, ni) p1_root_base(nodes, AT(const uint32_t, N_INSTS), AT(const uint32_t, P1_SIZE), AT(const uint32_t, FLOORS), AT(uint32_t, P1_BASE), i);
        BARRIER();
        for (uint32_t dep = 1u; dep <= N(P1_DEPTHN); dep++) {
            EACH(i, ni) p1_down(nodes, AT(const uint32_t, N_INSTS), AT(const PpInst, INSTS), AT(const uint32_t, DIR_BASES), AT(const PpDir, ROWS), AT(const uint32_t, P1_GSHIFT), AT(const uint32_t, P1_GC), AT(const uint32_t, P1_LIVE), AT(uint32_t, P1_BASE), dep, i);
            BARRIER();
        }
        EACH(w, nd) p1_dir_slot(AT(const PpInst, INSTS), AT(const uint32_t, N_INSTS), AT(const uint32_t, N_DIRS), AT(const uint32_t, DIR_BASES), AT(const PpDir, ROWS), AT(const uint32_t, P1_GSHIFT), AT(const uint32_t, P1_GC), AT(const uint32_t, P1_BASE), AT(const uint32_t, P1_LIVE), AT(uint32_t, DSLOT), w);
        EACH(w, ng) p1_gap_slot(AT(const PpInst, INSTS), AT(const uint32_t, N_INSTS), AT(const uint32_t, N_GAPS), AT(const uint32_t, DIR_BASES), AT(const PpDir, ROWS), AT(const uint32_t, P1_GSHIFT), AT(const uint32_t, P1_GC), AT(const uint32_t, P1_BASE), AT(const uint32_t, P1_LIVE), AT(uint32_t, GSLOT), w);
        // The activity, from the groups.
        EACH(w, nd) p1_dir_act(AT(const PpInst, INSTS), AT(const uint32_t, N_INSTS), AT(const uint32_t, N_DIRS), AT(const uint32_t, DIR_BASES), AT(const PpDir, ROWS), AT(const uint32_t, P1_GRPF), AT(const uint32_t, P1_GA), AT(const uint32_t, P1_LIVE), AT(uint32_t, DACTIVE), w);
        EACH(w, ng) p1_gap_act(AT(const PpInst, INSTS), AT(const uint32_t, N_INSTS), AT(const uint32_t, N_GAPS), AT(const uint32_t, DIR_BASES), AT(const PpDir, ROWS), AT(const uint32_t, P1_GRPF), AT(const uint32_t, P1_GA), AT(const uint32_t, P1_LIVE), AT(uint32_t, GACTIVE), w);
        BARRIER();
        // The definitions' table.
