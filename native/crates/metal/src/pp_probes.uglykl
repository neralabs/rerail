// The evaluator's probes, for its tests and measurements alone: its searches, the relexer, and
// the grid's sort and barriers by themselves (decision 0468). Each scalar is a field of `args`.

typedef struct PpProbeArgs { uint32_t a, b, c, d; } PpProbeArgs;
UKL_REFLECT_STRUCT(PpProbeArgs, a, b, c, d)

// Each of `nq[args.b]` queries' lower bound in `sorted` (`ns[args.a]` keys).
DEFINE_KERNEL2(pp, pb_search,
               ROBUFFER, uint64_t,    sorted,  "[n]",
               ROBUFFER, uint32_t,    ns,      "[n]",
               ROBUFFER, uint64_t,    queries, "[n]",
               ROBUFFER, uint32_t,    nq,      "[n]",
               RWBUFFER, uint32_t,    out,     "[n]",
               ARGS,     PpProbeArgs, args,    ,
               GID0,     uint32_t,    i,       )
{
    if (i < nq[args.b]) out[i] = pb_lower_bound(sorted, ns[args.a], queries[i]);
}

// Each of `total[0]` output elements' item and its rank in the item (`n[args.a]` items).
DEFINE_KERNEL2(pp, pb_expand,
               ROBUFFER, uint32_t,    offsets, "[n]",
               ROBUFFER, uint32_t,    n,       "[n]",
               ROBUFFER, uint32_t,    total,   "[n]",
               RWBUFFER, uint32_t,    item,    "[n]",
               RWBUFFER, uint32_t,    rank,    "[n]",
               ARGS,     PpProbeArgs, args,    ,
               GID0,     uint32_t,    j,       )
{
    if (j >= total[0]) return;
    uint32_t k = pb_item_of(offsets, n[args.a], j);
    item[j] = k;
    rank[j] = j - offsets[k];
}

// Each spelling's answer (`offsets[i]..offsets[i + 1]` of `bytes`): `args.a` spellings, the
// dialect's options `args.b`.
DEFINE_KERNEL2(pp, pd_relex_test,
               ROBUFFER, uint8_t,     bytes,   "[n]",
               ROBUFFER, uint32_t,    offsets, "[n]",
               RWBUFFER, uint32_t,    out,     "[n]",
               ARGS,     PpProbeArgs, args,    ,
               GID0,     uint32_t,    i,       )
{
    if (i >= args.a) return;
    uint32_t a = offsets[i];
    out[i] = relex(bytes + a, offsets[i + 1u] - a, args.b);
}

#if UKL_SIMD_WIDTH >= 8
// For measurements: the grid's sort alone (`ukl_grid_sort_u64_from`), `args.a` keys by their
// bits `args.c..args.b`.
DEFINE_KERNEL2(pp, pb_sort_alone,
               RWBUFFER, uint32_t,    ctl,     "[3]",
               RWBUFFER, uint64_t,    keys,    "[n]",
               RWBUFFER, uint32_t,    values,  "[n]",
               RWBUFFER, uint64_t,    keys2,   "[n]",
               RWBUFFER, uint32_t,    values2, "[n]",
               RWBUFFER, uint32_t,    hist,    "[n]",
               RWBUFFER, uint32_t,    sums,    "[n]",
               ARGS,     PpProbeArgs, args,    ,
               SHARED,   uint32_t,    flag,    1,
               SHARED,   uint32_t,    scratch, UKL_TG_SCRATCH,
               SHARED,   uint32_t,    big,     UKL_GRID_SORT_WORDS,
               GSZ0,     uint32_t,    gsz,     ,
               TGID0,    uint32_t,    group,   ,
               LID0,     uint32_t,    lid,     ,
               LSZ0,     uint32_t,    lsz,     )
{
    UklGrid g;
    g.ctl = ctl; g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;
    UklGridSortLocal sl;
    sl.counts = big; sl.h = big + UKL_RADIX_GROUPS * UKL_RADIX_DIGITS;
    sl.before = sl.h + UKL_RADIX_DIGITS; sl.base = sl.before + UKL_RADIX_DIGITS;
    sl.digits = sl.base + UKL_RADIX_DIGITS; sl.tile = big;
    ukl_grid_sort_u64_from(g, args.a, args.c, args.b, true, (UKL_COHERENT uint64_t*)keys, (UKL_COHERENT uint32_t*)values,
                           (UKL_COHERENT uint64_t*)keys2, (UKL_COHERENT uint32_t*)values2, (UKL_COHERENT uint32_t*)hist,
                           (UKL_COHERENT uint32_t*)sums, sl, scratch, flag __UKL_ARGS);
}
#endif

// For measurements: `args.a` grid barriers, then (`args.b` 1) `args.a` device fences, (2)
// threadgroup barriers with device scope, (3) dependent coherent loads by thread 0, (4) plain ones.
DEFINE_KERNEL2(pp, pb_barriers_alone,
               RWBUFFER, uint32_t,    ctl,     "[3]",
               RWBUFFER, uint32_t,    data,    "[512]",
               ARGS,     PpProbeArgs, args,    ,
               SHARED,   uint32_t,    flag,    1,
               GSZ0,     uint32_t,    gsz,     ,
               TGID0,    uint32_t,    group,   ,
               LID0,     uint32_t,    lid,     ,
               LSZ0,     uint32_t,    lsz,     )
{
    UklGrid g;
    g.ctl = ctl; g.groups = gsz / lsz; g.group = group; g.lid = lid; g.lsz = lsz;
    uint32_t n = args.a, what = args.b;
    if (what == 0u) { for (uint32_t k = 0u; k < n; k++) if (!ukl_grid_barrier(g, flag)) return; }
    if (what == 1u) { for (uint32_t k = 0u; k < n; k++) { ukl_fence_device(); data[lid] += k; } }
    if (what == 2u) { for (uint32_t k = 0u; k < n; k++) { ukl_tg_barrier_device(); data[lid] += k; } }
    if (what == 3u && lid == 0u) {
        UKL_COHERENT uint32_t* c = (UKL_COHERENT uint32_t*)data;
        uint32_t at = 0u;
        for (uint32_t k = 0u; k < n; k++) at = c[at & 255u] + k;
        data[256] = at;
    }
    if (what == 4u && lid == 0u) {
        uint32_t at = 0u;
        for (uint32_t k = 0u; k < n; k++) at = data[at & 255u] + k;
        data[256] = at;
    }
}
