        if (me) {
            rp->q[0] = ask ? 1u : 0u; rp->q[1] = q_kind; rp->q[2] = q_def; rp->q[3] = q_at;
            rp->q[4] = q_end; rp->q[5] = q_slot; rp->q[6] = q_floor; rp->q[7] = q_fend; rp->q[8] = q_off; rp->q[9] = q_hoff;
        }
        ukl_sg_barrier();
        if (rp->q[0] == 0u) break;
        q_kind = rp->q[1]; q_def = rp->q[2]; q_at = rp->q[3]; q_end = rp->q[4];
        q_slot = rp->q[5]; q_floor = rp->q[6]; q_fend = rp->q[7]; q_off = rp->q[8]; q_hoff = rp->q[9];
        uint32_t p = q_at + ln;
        if (q_kind == LQ_NAMES) {
            bool plain = p < q_end && lp_ahead(u, a, q_def, p, q_slot, q_floor);
            uint32_t k = ukl_min(ukl_ctz64((uint64_t)(ukl_sg_ballot(!plain __UKL_ARGS))), q_end - q_at);
            if (me) { rp->run = k; rp->noask = k == 0u; }
            // The run stops at a name that may be a call's: its arguments' `(`, `)` and `,` are the next
            // tokens', read now (`LQ_PUNCT`'s window, from the token after it), not by an ask of their own.
            uint32_t b = q_at + k + 1u;
            if (k < q_end - q_at && b + 1u < q_fend) lp_window(rp, u, q_def, b, ukl_min(q_fend, b + LP_WIN), ln, me __UKL_ARGS);
        } else if (q_kind == LQ_LIST) {
            // The list's next entries (region 0 from `q_def`), a lane each, and their tokens laid out in a
            // row (a span its tokens, any other entry one): a lane a token of the row's first, looked up.
            // An entry is plain where its tokens are all before the row's first that is not; the plain
            // ones before the first that is not, each given the thread by its lane, are taken in one step.
            LpTok x; x.src = 0u; x.st = 0u; x.flags = 0u; x.org = 0u; x.xp = 0u;
            uint32_t len = 0u, full = 0u;
            bool longe = false;
            if (p < q_end) {
                uint32_t i = q_def + p;
                x.src = a.psrc[i]; x.st = a.pst[i]; x.flags = a.pn[i]; x.org = a.pexp[i]; x.xp = a.pxp[i];
                x = lp_xin(x, q_off, q_hoff);
                // A node: one place (taken whole into an argument's expansion, else read by the thread).
                len = lp_is_span(x) && !lp_is_node(x) && !LP_IS_HOLE(x) ? lp_span_len(x) : 1u;
                full = len;
                // A span longer than the row: one place, not plain (the thread reads it).
                if (len > UKL_SIMD_WIDTH) { longe = true; len = 1u; }
            }
            uint32_t at0 = ukl_sg_exclusive_sum(len, ln __UKL_ARGS);
            uint32_t tot = ukl_sg_shuffle(at0 + len, UKL_SIMD_WIDTH - 1u __UKL_ARGS);
            // This lane's token's entry: the last whose first place is at or before it. The entries'
            // first places are distinct, so their bits' sum is the row's starts, one reduction: the entry
            // is the starts at or before the lane's place, counted, and its first place the last of them.
            uint32_t starts = ukl_sg_sum(len != 0u && at0 < UKL_SIMD_WIDTH ? 1u << at0 : 0u __UKL_ARGS);
            uint32_t upto = starts & (0xffffffffu >> (31u - ln));
            uint32_t j = upto != 0u ? ukl_popcount32(upto) - 1u : 0u;
            uint32_t yat = upto != 0u ? 31u - ukl_clz32(upto) : 0u;
            LpTok y;
            y.src = ukl_sg_shuffle(x.src, j __UKL_ARGS); y.st = ukl_sg_shuffle(x.st, j __UKL_ARGS);
            y.flags = ukl_sg_shuffle(x.flags, j __UKL_ARGS); y.org = ukl_sg_shuffle(x.org, j __UKL_ARGS); y.xp = ukl_sg_shuffle(x.xp, j __UKL_ARGS);
            bool ylong = ukl_sg_shuffle(longe ? 1u : 0u, j __UKL_ARGS) != 0u;
            bool tok = ln < tot, ok = true;
            if (tok) {
                if (ylong || LP_IS_HOLE(y)) ok = false;
                else if (lp_is_node(y)) ok = a.pn[y.st] == 0u && (q_fend != 0u || a.pexp[y.st] == 0u);
                else if (lp_is_span(y)) ok = lp_ahead(u, a, y.src & ~P_KIND, y.st + (ln - yat), q_slot, q_floor);
                else ok = (y.flags & T_NOEXP) != 0u || lp_tok_plain(u, a, y, q_slot, q_floor);
            }
            uint32_t bad = ukl_min((uint32_t)ukl_ctz64((uint64_t)(ukl_sg_ballot(tok && !ok __UKL_ARGS))), (uint32_t)UKL_SIMD_WIDTH);
            bool plain = p < q_end && !longe && at0 + len <= bad;
            uint32_t k = ukl_min(ukl_ctz64((uint64_t)(ukl_sg_ballot(!plain __UKL_ARGS))), q_end - q_at);
            // Into an argument's expansion: the entries as they are (a span's tokens are its, its first's
            // flags its own: `lp_span_tok`), each written by its lane at once, in the room the thread made.
            bool spans = ukl_sg_ballot(ln < k && lp_is_span(x) __UKL_ARGS) != 0u;
            uint32_t dst = LP_NONE;
            if (me && k != 0u && rp->nc != 0u && rp->stop == 0u) {
                uint32_t at = lp_alloc(rp, a, 1u, k);
                if (at != LP_NONE) {
                    dst = rp->mem[1].base + at;
                    rp->fr[(rp->sp - 1u) & (LP_DEPTH - 1u)].at += k;
                    // A span taken was a frame pushed and popped (`lp_list_take`): its mark freed.
                    if (spans && rp->collecting) rp->cfree = ukl_min(rp->cfree, rp->mem[0].top);
                }
            }
            dst = ukl_sg_shuffle(dst, lead __UKL_ARGS);
            bool whole = ukl_sg_shuffle(me && k != 0u && rp->nc != 0u ? 1u : 0u, lead __UKL_ARGS) != 0u;
            if (whole) {
                if (dst != LP_NONE && ln < k) { a.psrc[dst + ln] = x.src; a.pst[dst + ln] = x.st; a.pn[dst + ln] = x.flags; a.pexp[dst + ln] = x.org; a.pxp[dst + ln] = x.xp; }
                ukl_sg_barrier();
            } else {
                for (uint32_t j = 0u; j < k; j++) {
                    LpTok y;
                    y.src = ukl_sg_shuffle(x.src, j __UKL_ARGS); y.st = ukl_sg_shuffle(x.st, j __UKL_ARGS);
                    y.flags = ukl_sg_shuffle(x.flags, j __UKL_ARGS); y.org = ukl_sg_shuffle(x.org, j __UKL_ARGS); y.xp = ukl_sg_shuffle(x.xp, j __UKL_ARGS);
                    if (me && rp->stop == 0u) lp_list_take(rp, &o, u, a, y);
                }
            }
            // The first entry a span longer than the row: its frame pushed (`lp_lex`'s), and its first tokens
            // looked at now, a lane each (`LQ_NAMES`'s), so the thread runs them next, not a token a step.
            bool first_long = ukl_sg_shuffle(longe ? 1u : 0u, 0u __UKL_ARGS) != 0u;
            if (k == 0u && first_long) {
                uint32_t fsrc = ukl_sg_shuffle(x.src, 0u __UKL_ARGS), fst = ukl_sg_shuffle(x.st, 0u __UKL_ARGS);
                uint32_t flen = ukl_sg_shuffle(full, 0u __UKL_ARGS);
                uint32_t fflags = ukl_sg_shuffle(x.flags, 0u __UKL_ARGS), forg = ukl_sg_shuffle(x.org, 0u __UKL_ARGS), fxp = ukl_sg_shuffle(x.xp, 0u __UKL_ARGS);
                uint32_t n = ukl_min(flen, (uint32_t)UKL_SIMD_WIDTH);
                bool pl = ln < n && lp_ahead(u, a, fsrc & ~P_KIND, fst + ln, q_slot, q_floor);
                uint32_t kk = ukl_min(ukl_ctz64((uint64_t)(ukl_sg_ballot(!pl __UKL_ARGS))), n);
                if (me && rp->stop == 0u) {
                    if (lp_fpush(rp, a)) {
                        LpTok e; e.src = fsrc; e.st = fst; e.flags = fflags; e.org = forg; e.xp = fxp;
                        rp->fr[(rp->sp - 1u) & (LP_DEPTH - 1u)].at++;
                        UKL_LOCAL LpFrame* g = &rp->fr[(rp->sp++) & (LP_DEPTH - 1u)];
                        FR_SET_KIND(*g, FK_SPAN); g->def = e.src & ~P_KIND; g->at = e.st; g->end = e.st + lp_span_len(e); g->mark = rp->mem[0].top; FR_SET_NSP(*g, e.flags & 15u); g->org = e.org; g->xp = e.xp;
                        rp->run = kk; rp->noask = kk == 0u;
                    }
                }
            } else if (me) {
                rp->noask = k == 0u;
            }
        } else {
            lp_window(rp, u, q_def, q_at, q_end, ln, me __UKL_ARGS);
        }
    }
}
// The pieces a SIMD group's lanes start (`lp_piece`), one at a time, every lane with each.
UKL_INLINE void lp_run(Ux u, Ar a, PP_GLOBAL const uint32_t* ops, PP_GLOBAL uint32_t* state, PP_GLOBAL const uint32_t* lookups, PP_GLOBAL const uint32_t* start, PP_GLOBAL uint32_t* v, PP_GLOBAL uint32_t* opv, PP_GLOBAL uint32_t* lob, PP_GLOBAL uint32_t* plast,
                       PP_GLOBAL uint32_t* pend, PP_GLOBAL uint32_t* pjoin, PP_GLOBAL uint32_t* joined, PP_GLOBAL uint32_t* trn, PP_GLOBAL uint32_t* ovr, PP_GLOBAL const uint32_t* list, uint32_t ln,
                       UKL_LOCAL LpRun* rp __UKL_PARAMS) {
    // The items taken from the unit's queue (`lp_wq`, decision 0613 §4): its pieces, then the requests they
    // post and the pieces read again, a SIMD group's lane 0 taking the next while one is left: a group that
    // ends a short item takes another, so the team's groups end together whatever the items' lengths (a
    // group a window of 32 tokens ran 1.5 times the even share on `tif_getimage.c`, 2026-11-22). A group that
    // finds nothing to take ends at once (decision 0540 step 7): it never polls for others' posts, since a group
    // that posts is still reading and takes on. `ln` is the lane.
    (void)list;
    UklWorkQueue q = lp_wq(a);
    if (ln == 0u) { rp->sc_cap = 0u; rp->sp_cap = 0u; }
    for (;;) {
        uint32_t item = 0u;
        bool got = false;
        if (ln == 0u) got = ukl_wq_take(q, &item);
        got = ukl_sg_shuffle(got ? 1u : 0u, 0u __UKL_ARGS) != 0u;
        if (!got) break;
        // What its poster wrote before the push (a request's record, its arguments' entries; a piece read again,
        // its requests' results) seen by every lane: the take's acquire.
        ukl_fence_device();
        item = ukl_sg_shuffle(item, 0u __UKL_ARGS);
        uint32_t kind = item & LQ_KIND, x = item & ~LQ_KIND;
        uint32_t s0 = kind == LQ_REQ ? (ln == 0u ? a.psrc[x + 6u] : 0u) : x;
        // An argument's request its user claimed (read it inline): nothing to read.
        uint32_t skip = 0u;
        if (kind == LQ_REQ && ln == 0u && a.psrc[LP_ROW(x)] == LP_RQARG && ukl_atomic_cas(&a.pst[LP_ROW(x) + 6u], 0u, 1u) != 0u) skip = 1u;
        skip = ukl_sg_shuffle(skip, 0u __UKL_ARGS);
        if (skip != 0u) {
        } else if (kind == LQ_FIN) {
            if (ln == 0u) lp_rq_finish(a, trn, x);
        } else {
            lp_piece(u, a, ops, state, lookups, start, v, opv, lob, plast, pend, pjoin, joined, trn, ovr, s0, kind == LQ_REQ ? x : LP_NONE, kind == LQ_AGAIN, rp, ln == 0u, ln, 0u __UKL_ARGS);
        }
        if (ln == 0u) ukl_wq_done(q);
    }
}
// The pieces into the unit's queue (`lp_run`'s items): a start `s`.
UKL_INLINE void lp_queue(Ar a, PP_GLOBAL const uint32_t* start, PP_GLOBAL const uint32_t* n_toks, uint32_t s) {
    if (s < n_toks[0] && start[s] != 0u && !ukl_wq_push(lp_wq(a), LQ_PIECE | s)) px_refuse(a.ctl, X_ROOM);
}
