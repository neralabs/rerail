// Block programs' shared code in UKL (decision 0440 step C; was block_carry.metal, block_sinks.metal and the
// helpers block_program.rs wrote as MSL): the file table and a file's bytes, the carries, the sinks and the
// look-backs between groups. The interpreter (`block_program.uglykl`) and the generated kernels (block_program.rs,
// block_serial.rs) are compiled after it.
//
// Compiled for one lane word: `BW` its bits (16, 32 or 64) and `BM` its type, defined in front of the source; and
// `BLOCK_POLL_RMW` (0 or 1), how a poll reads (`poll`). A group is one SIMD group of 32 lanes, each owning `BW / 8`
// bytes of a file: its ballots are 32-bit words, and the host runs block programs only where the SIMD width is 32.
//
// Carries (`docs/parser-generators/06-block-parallel.md` §2, §5): each carried operation has a lane summary, an
// associative combine and an apply. A group combines its lanes' summaries with SIMD-group operations; between
// groups the combined summaries pass through look-back states. Kinds: 0 parity (`toggle`), 1 borrow (`escaped`,
// `fill`: bit 0 generate, bit 1 propagate). `prev` needs no scan: its carry is a halo, the 64 bits before a lane,
// from the lanes before it in the group and the group before's last 64 bits.
#include <ukl/backend.h>
#include <ukl/bits.h>
#include <ukl/simd.h>

// Metal's `select(a, b, c)`: `b` where `c`, else `a`. A C conditional, so it evaluates one of `a` and `b`: a
// SIMD-group operation is never in an operand (a lane that skips it leaves its lanes reading an inactive lane, and
// under emulation stops the group), but a statement of its own before.
#define SEL(a, b, c) ((c) ? (b) : (a))
// Conversions, as the generated code writes them.
#define BMC(x) ((BM)(x))
#define U16(x) ((uint16_t)(x))
#define U32(x) ((uint32_t)(x))
#define U64(x) ((uint64_t)(x))
#define I32(x) ((int32_t)(x))
// A group's lanes.
#define GROUP_LANES 32u

// The lane code is straight-line (parser_tests' `check_lowering`): selects, never branches.
UKL_INLINE int32_t clamp_i32(int32_t x, int32_t lo, int32_t hi) { return SEL(SEL(x, hi, x > hi), lo, x < lo); }
// A rotate right by `n` (0..63): at 0 both halves are `x`.
UKL_INLINE uint64_t rotr64(uint64_t x, uint64_t n) { n &= 63ul; return (x >> n) | (x << ((64ul - n) & 63ul)); }
// The bits of `x` in reverse order (Metal's `reverse_bits`), by swaps of halves: six steps, no loop.
UKL_INLINE uint64_t reverse64(uint64_t x)
{
    x = ((x >> 1) & 0x5555555555555555ul) | ((x & 0x5555555555555555ul) << 1);
    x = ((x >> 2) & 0x3333333333333333ul) | ((x & 0x3333333333333333ul) << 2);
    x = ((x >> 4) & 0x0f0f0f0f0f0f0f0ful) | ((x & 0x0f0f0f0f0f0f0f0ful) << 4);
    x = ((x >> 8) & 0x00ff00ff00ff00fful) | ((x & 0x00ff00ff00ff00fful) << 8);
    x = ((x >> 16) & 0x0000ffff0000fffful) | ((x & 0x0000ffff0000fffful) << 16);
    return (x >> 32) | (x << 32);
}

// The SIMD group's operations the carries use, on the lane word and on 64 bits.
UKL_INLINE uint32_t sg_bcast(uint32_t x, uint32_t lane __UKL_PARAMS) { return ukl_sg_shuffle(x, lane __UKL_ARGS); }
UKL_INLINE uint64_t sg_bcast64(uint64_t x, uint32_t lane __UKL_PARAMS)
{
    return (uint64_t)ukl_sg_shuffle((uint32_t)x, lane __UKL_ARGS) | ((uint64_t)ukl_sg_shuffle((uint32_t)(x >> 32), lane __UKL_ARGS) << 32);
}
UKL_INLINE uint64_t sg_up64(uint64_t x, uint32_t d __UKL_PARAMS)
{
    return (uint64_t)ukl_sg_shuffle_up((uint32_t)x, d __UKL_ARGS) | ((uint64_t)ukl_sg_shuffle_up((uint32_t)(x >> 32), d __UKL_ARGS) << 32);
}
UKL_INLINE uint64_t sg_down64(uint64_t x, uint32_t d __UKL_PARAMS)
{
    return (uint64_t)ukl_sg_shuffle_down((uint32_t)x, d __UKL_ARGS) | ((uint64_t)ukl_sg_shuffle_down((uint32_t)(x >> 32), d __UKL_ARGS) << 32);
}
#if BW == 64
#define SG_UP_BM(x, d) sg_up64((x), (d) __UKL_ARGS)
#define SG_BCAST_BM(x, l) sg_bcast64((x), (l) __UKL_ARGS)
#else
#define SG_UP_BM(x, d) ((BM)ukl_sg_shuffle_up((uint32_t)(x), (d) __UKL_ARGS))
#define SG_BCAST_BM(x, l) ((BM)ukl_sg_shuffle((uint32_t)(x), (l) __UKL_ARGS))
#endif
UKL_INLINE bool sg_any(bool b __UKL_PARAMS) { return ukl_sg_ballot(b __UKL_ARGS) != 0u; }
UKL_INLINE bool sg_all(bool b __UKL_PARAMS) { return ukl_sg_ballot(!b __UKL_ARGS) == 0u; }

// A lane word's set bits, and its lowest set bit's place.
#if BW == 64
#define POPCOUNT_BM(x) ukl_popcount64((uint64_t)(x))
#define CTZ_BM(x) ukl_ctz64((uint64_t)(x))
#else
#define POPCOUNT_BM(x) ukl_popcount32((uint32_t)(x))
#define CTZ_BM(x) ukl_ctz32((uint32_t)(x))
#endif

// 16 bytes of a file, as four 32-bit words (`uint4` in MSL): a 16-byte chunk.
typedef struct B4 { uint32_t x, y, z, w; } B4;
UKL_INLINE B4 b4(uint32_t x, uint32_t y, uint32_t z, uint32_t w) { B4 v; v.x = x; v.y = y; v.z = z; v.w = w; return v; }
UKL_INLINE B4 b4_or(B4 a, B4 b) { return b4(a.x | b.x, a.y | b.y, a.z | b.z, a.w | b.w); }
UKL_INLINE B4 b4_and(B4 a, B4 b) { return b4(a.x & b.x, a.y & b.y, a.z & b.z, a.w & b.w); }
UKL_INLINE B4 b4_ands(B4 a, uint32_t s) { return b4(a.x & s, a.y & s, a.z & s, a.w & s); }
UKL_INLINE uint32_t b4_any(B4 a) { return a.x | a.y | a.z | a.w; }

// A file of the batch (decision 0066). Lane words are indexed in the file: output k of lane gl at
// out_base + k * groups * 32 + gl; carry j of group g at state_base + j * groups + g (a halo's three words from
// halo_base + (j * groups + g) * 3); counted output c's state of group g at ext_base + c * groups + g, and its total
// at tot_base + c; extract e's positions from pos_base + e * max(len, 1); in passes, block b's slot k at
// slot_base + b * SLOTS + k.
typedef struct FileRow { uint32_t src16, len, program, group0, groups, out_base, state_base, halo_base, ext_base, pos_base, slab, tot_base, slot_base; } FileRow;
// A slab's bytes, as the kernels bind it: 32-bit words, four a chunk.
typedef UKL_GLOBAL const uint32_t* Bytes;

// The word of a chunk's `k`-th four bytes that a file of `have` bytes in the chunk keeps.
UKL_INLINE uint32_t keep_word(uint32_t v, int32_t have, int32_t k)
{
    int32_t keep = clamp_i32(have - 4 * k, 0, 4);
    return SEL(v & ((1u << ((uint32_t)keep * 8u)) - 1u), v, keep == 4);
}
// Chunk `c` of a file, read in place in its slab: zero at and past its length (a neighbour's bytes never read as its
// own).
UKL_INLINE B4 load16(Bytes bytes, FileRow f, uint32_t c)
{
    uint32_t chunks = ukl_max((f.len + 15u) / 16u, 1u);
    uint64_t at = 4ul * (uint64_t)(f.src16 + ukl_min(c, chunks - 1u));
    int32_t have = clamp_i32((int32_t)f.len - (int32_t)(c * 16u), 0, 16);
    return b4(keep_word(bytes[at], have, 0), keep_word(bytes[at + 1ul], have, 1), keep_word(bytes[at + 2ul], have, 2), keep_word(bytes[at + 3ul], have, 3));
}
// The byte before chunk c of a file (0x00 before its first byte).
UKL_INLINE uint32_t file_byte_before(Bytes bytes, FileRow f, uint32_t c) { return SEL(0u, load16(bytes, f, ukl_max(c, 1u) - 1u).w >> 24, c > 0u); }
// 16 bytes one back: each byte replaced by the byte before it, `before` the byte before the first.
UKL_INLINE B4 bytes_before(B4 v, uint32_t before)
{
    return b4((v.x << 8) | before, (v.y << 8) | (v.x >> 24), (v.z << 8) | (v.y >> 24), (v.w << 8) | (v.z >> 24));
}

// Four bytes' high bits (`z`, each byte's bit 7) as four bits.
UKL_INLINE uint32_t gather4(uint32_t z) { return (((z >> 7) * 0x00204081u) >> 21) & 0xfu; }
UKL_INLINE uint32_t gather16(B4 z) { return gather4(z.x) | (gather4(z.y) << 4) | (gather4(z.z) << 8) | (gather4(z.w) << 12); }
// An exact zero-byte test: each zero byte's high bit.
UKL_INLINE uint32_t zero_bytes(uint32_t x) { return ~(((x & 0x7f7f7f7fu) + 0x7f7f7f7fu) | x) & 0x80808080u; }
UKL_INLINE uint32_t nonzero_bytes(uint32_t x) { return (((x & 0x7f7f7f7fu) + 0x7f7f7f7fu) | x) & 0x80808080u; }
// 16 bytes equal to c (repeated in c4) as 16 bits, by SWAR on four words.
UKL_INLINE uint32_t eq16(B4 v, uint32_t c4) { return gather16(b4(zero_bytes(v.x ^ c4), zero_bytes(v.y ^ c4), zero_bytes(v.z ^ c4), zero_bytes(v.w ^ c4))); }
// 16 bytes that are not zero as 16 bits.
UKL_INLINE uint32_t nz16(B4 v) { return gather16(b4(nonzero_bytes(v.x), nonzero_bytes(v.y), nonzero_bytes(v.z), nonzero_bytes(v.w))); }
// Bit k of 16 bytes as 16 bits: each byte's bit k moved to its high bit, then the gather.
UKL_INLINE uint32_t plane16(B4 v, uint32_t k)
{
    uint32_t s = 7u - k;
    return gather16(b4((v.x << s) & 0x80808080u, (v.y << s) & 0x80808080u, (v.z << s) & 0x80808080u, (v.w << s) & 0x80808080u));
}
// Hacker's Delight's 8x8 bit transpose: byte `i` bit `j` to byte `j` bit `i`.
UKL_INLINE uint64_t transpose8(uint64_t x)
{
    uint64_t t = (x ^ (x >> 7)) & 0x00AA00AA00AA00AAul;
    x = x ^ t ^ (t << 7);
    t = (x ^ (x >> 14)) & 0x0000CCCC0000CCCCul;
    x = x ^ t ^ (t << 14);
    t = (x ^ (x >> 28)) & 0x00000000F0F0F0F0ul;
    return x ^ t ^ (t << 28);
}

// The lane word's bits, as a 64-bit value with nothing above the lane's width. The parity is of those bits only:
// for 16-bit lanes Metal's compiler has been seen to count bits above 16 that the conversion should have dropped (a
// `prev` by 25 to 31 there, in the Bitlex corpus).
UKL_INLINE uint64_t lane_bits(BM a) { return (uint64_t)a & (~0ul >> (64u - (uint32_t)BW)); }

// A lane's word of a byte test over its chunks, from chunk `first` of the file.
UKL_INLINE BM eq_file(Bytes bytes, FileRow f, uint32_t first, uint32_t c4)
{
    BM out = BMC(0);
    for (uint32_t c = 0u; c < (uint32_t)BW / 16u; c++) out = BMC(out | BMC((uint64_t)eq16(load16(bytes, f, first + c), c4) << (16u * c)));
    return out;
}
UKL_INLINE BM plane_file(Bytes bytes, FileRow f, uint32_t first, uint32_t k)
{
    BM out = BMC(0);
    for (uint32_t c = 0u; c < (uint32_t)BW / 16u; c++) out = BMC(out | BMC((uint64_t)plane16(load16(bytes, f, first + c), k) << (16u * c)));
    return out;
}
// The lane's bits of a 64-bit pattern that repeats every 64 bytes.
UKL_INLINE BM pattern(uint64_t c, uint32_t lane) { return BMC(c >> ((lane * (uint32_t)BW) & 63u)); }

// A look-back state: a flag in the top two bits (1: the group's aggregate, 2: its inclusive prefix), the value below.
#define CARRY_AGGREGATE (1u << 30)
#define CARRY_INCLUSIVE (2u << 30)
#define CARRY_VALUE ((1u << 30) - 1u)
#define HALO_FLAG (1u << 31)

UKL_INLINE uint32_t carry_identity(uint32_t kind) { return SEL(0u, 2u, kind == 1u); }
// `a` then `b`.
UKL_INLINE uint32_t combine_parity(uint32_t a, uint32_t b) { return (a ^ b) & 1u; }
UKL_INLINE uint32_t combine_borrow(uint32_t a, uint32_t b)
{
    uint32_t g = (b & 1u) | ((b >> 1) & a & 1u);
    uint32_t p = (a >> 1) & (b >> 1) & 1u;
    return g | (p << 1);
}
UKL_INLINE uint32_t combine_carry(uint32_t kind, uint32_t a, uint32_t b) { return SEL(combine_parity(a, b), combine_borrow(a, b), kind == 1u); }

// The group's aggregate of its lanes' summaries. The borrow's carry-lookahead is a 32-lane add: a group of 32 lanes
// at most.
#if UKL_SIMD_WIDTH > 32
#  error "block_common: the borrow's carry-lookahead adds 32 lanes' masks"
#endif
UKL_INLINE uint32_t reduce_parity(uint32_t s __UKL_PARAMS) { return ukl_mask_count(ukl_sg_ballot((s & 1u) != 0u __UKL_ARGS)) & 1u; }
UKL_INLINE uint32_t reduce_borrow(uint32_t s __UKL_PARAMS)
{
    uint32_t G = ukl_sg_ballot((s & 1u) != 0u __UKL_ARGS), P = ukl_sg_ballot((s & 2u) != 0u __UKL_ARGS);
    uint32_t g = (uint32_t)(((uint64_t)(G | P) + (uint64_t)G) >> 32);
    return g | ((uint32_t)(P == 0xffffffffu) << 1);
}
// A lane's carry in: the group's exclusive prefix `e` combined with the lanes before it. One bit's prefix parity:
// the parity of the ballot below the lane.
UKL_INLINE uint32_t lane_in_parity(uint32_t s, uint32_t e, uint32_t l __UKL_PARAMS)
{
    return (e ^ ukl_mask_rank(ukl_sg_ballot((s & 1u) != 0u __UKL_ARGS), l)) & 1u;
}
UKL_INLINE uint32_t lane_in_borrow(uint32_t s, uint32_t e, uint32_t l __UKL_PARAMS)
{
    // Carry-lookahead as a 32-bit add: lane l generates when G, propagates when P; the carry into bit l of
    // (G | P) + G + carry-in is lane l's carry in.
    uint32_t G = ukl_sg_ballot((s & 1u) != 0u __UKL_ARGS), P = ukl_sg_ballot((s & 2u) != 0u __UKL_ARGS);
    uint32_t A = G | P;
    uint32_t sum = (uint32_t)((uint64_t)A + (uint64_t)G + (uint64_t)(e & 1u));
    return ((sum ^ A ^ G) >> l) & 1u;
}

// The 64 bits before lane l (the newest at bit 63): the words of the lanes before it, then the group before's last
// 64 bits `P` where the group runs out. Lane l - d's word: `w` (shuffled up by d) inside the group, else the word
// `d - l` back in `P`.
UKL_INLINE uint64_t halo_word(uint64_t w, uint32_t d, uint32_t l, uint64_t P, uint32_t bits)
{
    uint32_t back = (uint32_t)ukl_max((int32_t)d - (int32_t)l, 1);
    return SEL(w, P >> (64u - back * bits), l < d);
}
#if BW == 16
UKL_INLINE uint64_t halo_before(BM a, uint32_t l, uint64_t P __UKL_PARAMS)
{
    uint64_t m = 0xfffful;
    uint32_t x = (uint32_t)a;
    return ((halo_word(ukl_sg_shuffle_up(x, 1u __UKL_ARGS), 1u, l, P, 16u) & m) << 48) |
           ((halo_word(ukl_sg_shuffle_up(x, 2u __UKL_ARGS), 2u, l, P, 16u) & m) << 32) |
           ((halo_word(ukl_sg_shuffle_up(x, 3u __UKL_ARGS), 3u, l, P, 16u) & m) << 16) |
           (halo_word(ukl_sg_shuffle_up(x, 4u __UKL_ARGS), 4u, l, P, 16u) & m);
}
// The group's last 64 bits, for the group after.
UKL_INLINE uint64_t halo_last(BM a __UKL_PARAMS)
{
    uint32_t x = (uint32_t)a;
    return ((uint64_t)(ukl_sg_shuffle(x, 31u __UKL_ARGS) & 0xffffu) << 48) | ((uint64_t)(ukl_sg_shuffle(x, 30u __UKL_ARGS) & 0xffffu) << 32) |
           ((uint64_t)(ukl_sg_shuffle(x, 29u __UKL_ARGS) & 0xffffu) << 16) | (uint64_t)(ukl_sg_shuffle(x, 28u __UKL_ARGS) & 0xffffu);
}
#elif BW == 32
UKL_INLINE uint64_t halo_before(BM a, uint32_t l, uint64_t P __UKL_PARAMS)
{
    uint64_t m = 0xfffffffful;
    return ((halo_word(ukl_sg_shuffle_up(a, 1u __UKL_ARGS), 1u, l, P, 32u) & m) << 32) | (halo_word(ukl_sg_shuffle_up(a, 2u __UKL_ARGS), 2u, l, P, 32u) & m);
}
UKL_INLINE uint64_t halo_last(BM a __UKL_PARAMS) { return ((uint64_t)ukl_sg_shuffle(a, 31u __UKL_ARGS) << 32) | (uint64_t)ukl_sg_shuffle(a, 30u __UKL_ARGS); }
#else
UKL_INLINE uint64_t halo_before(BM a, uint32_t l, uint64_t P __UKL_PARAMS)
{
    uint64_t up = sg_up64(a, 1u __UKL_ARGS);
    return SEL(up, P, l == 0u);
}
UKL_INLINE uint64_t halo_last(BM a __UKL_PARAMS) { return sg_bcast64(a, 31u __UKL_ARGS); }
#endif
// `prev` by k (1..63): the word shifted up, the newest k bits of the halo below.
UKL_INLINE BM apply_prev(BM a, uint32_t k, uint64_t before) { return BMC(lane_bits(BMC(((uint64_t)a << k) | (before >> (64u - k))))); }

// An XOR prefix scan of a word across the group (Hillis-Steele, five shuffles): for scans of more than one bit; one
// bit's parity is a ballot's popcount (`lane_in_parity`).
UKL_INLINE uint32_t sg_prefix_inclusive_xor32(uint32_t v, uint32_t l __UKL_PARAMS)
{
    uint32_t u;
    u = ukl_sg_shuffle_up(v, 1u __UKL_ARGS); v ^= SEL(0u, u, l >= 1u);
    u = ukl_sg_shuffle_up(v, 2u __UKL_ARGS); v ^= SEL(0u, u, l >= 2u);
    u = ukl_sg_shuffle_up(v, 4u __UKL_ARGS); v ^= SEL(0u, u, l >= 4u);
    u = ukl_sg_shuffle_up(v, 8u __UKL_ARGS); v ^= SEL(0u, u, l >= 8u);
    u = ukl_sg_shuffle_up(v, 16u __UKL_ARGS); v ^= SEL(0u, u, l >= 16u);
    return v;
}

// A word's prefix XOR (bit i: the parity of bits 0..=i).
UKL_INLINE BM prefix_xor(BM x)
{
    x = BMC(x ^ BMC(x << 1)); x = BMC(x ^ BMC(x << 2)); x = BMC(x ^ BMC(x << 4)); x = BMC(x ^ BMC(x << 8));
#if BW >= 32
    x = BMC(x ^ BMC(x << 16));
#endif
#if BW == 64
    x = BMC(x ^ BMC(x << 32));
#endif
    return x;
}
UKL_INLINE uint32_t summary_toggle(BM a) { return POPCOUNT_BM(lane_bits(a)) & 1u; }
UKL_INLINE BM apply_toggle(BM a, uint32_t cin) { return BMC(prefix_xor(a) ^ BMC(BMC(0) - BMC(cin))); }

// simdjson's find_escaped_branchless on a lane word, with the carry in; `overflow` is the carry out.
UKL_INLINE BM escaped(BM run, BM cin, UKL_PRIVATE uint32_t* overflow)
{
    BM even = BMC(0x5555555555555555ul);
    BM b = BMC(run & BMC(~cin));
    BM follows = BMC(BMC(b << 1) | cin);
    BM odd_starts = BMC(b & BMC(~even) & BMC(~follows));
    BM sequences = BMC(odd_starts + b);
    *overflow = (uint32_t)(sequences < odd_starts);
    return BMC(BMC(even ^ BMC(sequences << 1)) & follows);
}
UKL_INLINE uint32_t summary_escaped(BM a)
{
    uint32_t c0 = 0u, c1 = 0u;
    escaped(a, BMC(0), &c0);
    escaped(a, BMC(1), &c1);
    return c0 | ((c1 & ~c0) << 1);
}
UKL_INLINE BM apply_escaped(BM a, uint32_t cin)
{
    uint32_t unused = 0u;
    return escaped(a, BMC(cin), &unused);
}

// Bitlex's `fill(s, e)` on a lane word (`block::carry::fill`): the carry into each bit of s + (s | ~e) + cin is the
// fill coming into that byte; `out` is the carry out, the last bit. Computed on 64 bits with the lane's mask: on
// 16-bit words the arithmetic in the word gave a correct result but a wrong ballot of the summary on Apple's
// compiler.
UKL_INLINE BM fill_word(BM s, BM e, BM cin, UKL_PRIVATE uint32_t* out)
{
    uint64_t mask = ~0ul >> (64u - (uint32_t)BW);
    uint64_t S = (uint64_t)s, b = S | (~(uint64_t)e & mask);
    uint64_t into = (S + b + (uint64_t)cin) ^ S ^ b;
    uint64_t f = (S | (~(uint64_t)e & into)) & mask;
    *out = (uint32_t)(f >> ((uint32_t)BW - 1u)) & 1u;
    return BMC(f);
}
UKL_INLINE uint32_t summary_fill(BM s, BM e)
{
    uint32_t c0 = 0u, c1 = 0u;
    fill_word(s, e, BMC(0), &c0);
    fill_word(s, e, BMC(1), &c1);
    return c0 | ((c1 & ~c0) << 1);
}
UKL_INLINE BM apply_fill(BM s, BM e, uint32_t cin)
{
    uint32_t unused = 0u;
    return fill_word(s, e, BMC(cin), &unused);
}

// `within`: the bits of the word whose bytes, from stream byte `first`, are below the stream's end `len`. Two
// shifts, so a full 64-bit word needs no shift by 64.
UKL_INLINE BM within_lane(uint32_t len, uint32_t first)
{
    uint32_t t = (uint32_t)clamp_i32((int32_t)len - (int32_t)first, 0, (int32_t)BW);
    return BMC(((1ul << (t >> 1)) << (t - (t >> 1))) - 1ul);
}

// The group's exclusive prefix of a finished round, from its state array: the inclusive prefix of the group before
// (the identity for the first group).
UKL_INLINE uint32_t carry_before(UKL_GLOBAL uint32_t* state, uint32_t kind, uint32_t g)
{
    uint32_t v = ukl_atomic_load(&state[ukl_max(g, 1u) - 1u]) & CARRY_VALUE;
    return SEL(carry_identity(kind), v, g > 0u);
}

// `poll`: a read of a word another group of the launch publishes (a look-back's state, a halo, an exchange's
// record). On the M1 Max (Apple GPU family 7, Q123) a relaxed load in a poll loop kept reading the polling core's
// copy and never saw the store of a group running beside it; a relaxed read-modify-write reads the coherent copy.
// The host says which (`BLOCK_POLL_RMW`, block_program.rs's `poll_rmw`).
#if BLOCK_POLL_RMW
UKL_INLINE uint32_t poll(UKL_GLOBAL uint32_t* x) { return ukl_atomic_or(x, 0u); }
#else
UKL_INLINE uint32_t poll(UKL_GLOBAL uint32_t* x) { return ukl_atomic_load(x); }
#endif

// Tables of 1-bit carry vectors (`table_helpers(1)` for 1, block_program.rs): apply, compose (`a` then `b`), the
// identity, and the group's exclusive scan with the group's total.
UKL_INLINE uint32_t tapply1(uint32_t t, uint32_t c) { return (t >> (c * 1u)) & 1u; }
UKL_INLINE uint32_t tcompose1(uint32_t a, uint32_t b) { return (tapply1(b, tapply1(a, 0u)) << 0u) | (tapply1(b, tapply1(a, 1u)) << 1u); }
#define TID1 2u
UKL_INLINE uint32_t texclusive1(uint32_t t, uint32_t l, UKL_PRIVATE uint32_t* total __UKL_PARAMS)
{
    uint32_t x = t, u;
    u = ukl_sg_shuffle_up(x, 1u __UKL_ARGS); x = SEL(x, tcompose1(u, x), l >= 1u);
    u = ukl_sg_shuffle_up(x, 2u __UKL_ARGS); x = SEL(x, tcompose1(u, x), l >= 2u);
    u = ukl_sg_shuffle_up(x, 4u __UKL_ARGS); x = SEL(x, tcompose1(u, x), l >= 4u);
    u = ukl_sg_shuffle_up(x, 8u __UKL_ARGS); x = SEL(x, tcompose1(u, x), l >= 8u);
    u = ukl_sg_shuffle_up(x, 16u __UKL_ARGS); x = SEL(x, tcompose1(u, x), l >= 16u);
    *total = ukl_sg_shuffle(x, GROUP_LANES - 1u __UKL_ARGS);
    u = ukl_sg_shuffle_up(x, 1u __UKL_ARGS);
    return SEL(u, TID1, l == 0u);
}

// One scanned carry's look-back (`06-block-parallel.md` §5): the lanes' tables (bit `c` is the lane's carry-out for
// carry-in `c`) scanned in the group, the group's aggregate published, then the predecessors' states read back to
// an inclusive one. Each predecessor is polled once and `spins` more times; false when one has published nothing
// yet.
UKL_INLINE bool look_back(UKL_GLOBAL uint32_t* state, uint32_t g, uint32_t l, uint32_t t, uint32_t spins, UKL_PRIVATE uint32_t* cin __UKL_PARAMS)
{
    uint32_t agg = 0u;
    uint32_t e = texclusive1(t, l, &agg __UKL_ARGS);
    if (l == 0u) ukl_atomic_store(&state[g], CARRY_AGGREGATE | agg);
    uint32_t prefix = TID1;
    for (uint32_t back = 1u; back <= g; back++) {
        uint32_t st = 0u;
        for (uint32_t spin = 0u; spin <= spins && (st >> 30) == 0u; spin++) st = ukl_sg_shuffle(poll(&state[g - back]), 0u __UKL_ARGS);
        if ((st >> 30) == 0u) return false;
        prefix = tcompose1(st & CARRY_VALUE, prefix);
        if ((st >> 30) == 2u) break;
    }
    if (l == 0u) ukl_atomic_store(&state[g], CARRY_INCLUSIVE | tcompose1(prefix, agg));
    *cin = tapply1(e, tapply1(prefix, 0u));
    return true;
}

// A carried `prev`'s halo: the group's last 64 bits of the operand, published as three words of 30, 30 and 4 bits,
// each with a flag (no fence: every word says whether it is written), and the group before's read back. False when
// the group before has not published it yet.
UKL_INLINE bool halo_exchange(UKL_GLOBAL uint32_t* halos, uint32_t g, uint32_t l, uint64_t last, uint32_t spins, UKL_PRIVATE uint64_t* before __UKL_PARAMS)
{
    if (l == 0u) {
        ukl_atomic_store(&halos[g * 3u], HALO_FLAG | (uint32_t)(last & 0x3ffffffful));
        ukl_atomic_store(&halos[g * 3u + 1u], HALO_FLAG | (uint32_t)((last >> 30) & 0x3ffffffful));
        ukl_atomic_store(&halos[g * 3u + 2u], HALO_FLAG | (uint32_t)(last >> 60));
    }
    *before = 0ul;
    if (g == 0u) return true;
    for (uint32_t w = 0u; w < 3u; w++) {
        uint32_t x = 0u;
        for (uint32_t spin = 0u; spin <= spins && (x & HALO_FLAG) == 0u; spin++) x = ukl_sg_shuffle(poll(&halos[(g - 1u) * 3u + w]), 0u __UKL_ARGS);
        if ((x & HALO_FLAG) == 0u) return false;
        *before |= (uint64_t)(x & 0x3ffffffful) << (30u * w);
    }
    return true;
}

// One word of an exchange (block_program.rs's `Plan::exchanges`), by the lane that owns it; a group's record has
// `stride` words, and `rec` is this word's place in group 0's. Kind 0: a halo word, published with a flag and the
// group before's read once it is; kind 3 the same, published only (its value is known). Kind 1: a scan's table, and
// kind 2: a count, each published as an aggregate and read back to an inclusive prefix by `look_back`'s protocol.
// `got`: the halo word, or the prefix before the group. False when a predecessor has published nothing after `spins`
// polls; a lane past the exchange's words (`owns` false) has nothing to do. Every lane of a group polls its own word
// at once, so an exchange of many values waits about as long as one: no SIMD-group operation here.
//
// A table that gives the same carry for either carry in has one state: a group whose own table is constant
// publishes it as its inclusive prefix at once, and a look-back stops at the first constant prefix, since nothing
// before it changes the carry.
UKL_INLINE bool exchange_word(UKL_GLOBAL uint32_t* rec, uint32_t g, uint32_t stride, uint32_t kind, uint32_t mine, uint32_t spins, bool owns, UKL_PRIVATE uint32_t* got)
{
    *got = 0u;
    if (!owns) return true;
    if (kind == 3u) {
        ukl_atomic_store(&rec[g * stride], HALO_FLAG | mine);
        return true;
    }
    if (kind == 0u) {
        ukl_atomic_store(&rec[g * stride], HALO_FLAG | mine);
        if (g == 0u) return true;
        uint32_t x = 0u;
        for (uint32_t spin = 0u; spin <= spins && (x & HALO_FLAG) == 0u; spin++) x = poll(&rec[(g - 1u) * stride]);
        *got = x & 0x3ffffffful;
        return (x & HALO_FLAG) != 0u;
    }
    bool single = kind == 1u && tapply1(mine, 0u) == tapply1(mine, 1u);
    ukl_atomic_store(&rec[g * stride], SEL(CARRY_AGGREGATE, CARRY_INCLUSIVE, single) | mine);
    uint32_t prefix = SEL(0u, TID1, kind == 1u);
    for (uint32_t back = 1u; back <= g; back++) {
        uint32_t st = 0u;
        for (uint32_t spin = 0u; spin <= spins && (st >> 30) == 0u; spin++) st = poll(&rec[(g - back) * stride]);
        if ((st >> 30) == 0u) return false;
        prefix = SEL(prefix + (st & CARRY_VALUE), tcompose1(st & CARRY_VALUE, prefix), kind == 1u);
        if ((st >> 30) == 2u || (kind == 1u && tapply1(prefix, 0u) == tapply1(prefix, 1u))) break;
    }
    ukl_atomic_store(&rec[g * stride], CARRY_INCLUSIVE | SEL(prefix + mine, tcompose1(prefix, mine), kind == 1u));
    *got = prefix;
    return true;
}

// The sinks, each lowered from the IR (`native_ir::BlockNative`): the output masks at their delays, the extracts'
// positions and the totals. Written in the same launch as the masks. A chunk is one group's span of a file (32
// lanes of BW / 8 bytes).

// A lane's word cut to the stream at delay `d`: the bits `d <= gl * BW + i < len + d`.
UKL_INLINE BM stream_cut(BM v, uint32_t gl, uint32_t len, uint32_t d)
{
    return BMC(v & within_lane(len + d, gl * (uint32_t)BW) & BMC(~within_lane(d, gl * (uint32_t)BW)));
}

// Bits ORed into word `j` of an output of lane words, by 32-bit atomics.
UKL_INLINE void or_word(UKL_GLOBAL uint32_t* o, uint32_t j, BM x)
{
#if BW == 16
    ukl_atomic_or(&o[j >> 1], (uint32_t)x << ((j & 1u) * 16u));
#elif BW == 32
    ukl_atomic_or(&o[j], (uint32_t)x);
#else
    ukl_atomic_or(&o[2u * j], (uint32_t)x);
    ukl_atomic_or(&o[2u * j + 1u], (uint32_t)((uint64_t)x >> 32));
#endif
}

// An output at delay `d` (`native_ir::BlockNative::outputs`): lane gl's bit i is the stream's byte gl * BW + i - d.
// With q = d / BW and r = d % BW, its bits land in the stream's words gl - q (`v >> r`) and gl - q - 1
// (`v << (BW - r)`). Both are ORed in, since the lanes of one stream word can be in two groups; the buffer starts
// zeroed. A word before the stream takes nothing: its bits are cut.
UKL_INLINE void write_output(UKL_GLOBAL BM* out, uint32_t base, uint32_t gl, uint32_t len, uint32_t d, BM v)
{
    uint32_t W = (uint32_t)BW;
    BM w = stream_cut(v, gl, len, d);
    uint32_t r = d % W;
    int32_t j1 = (int32_t)gl - (int32_t)(d / W), j0 = j1 - 1;
    BM lo = BMC(lane_bits(w) >> r);
    BM hi = BMC(SEL(0ul, lane_bits(BMC((uint64_t)w << ((W - r) % W))), r != 0u));
    UKL_GLOBAL uint32_t* o = (UKL_GLOBAL uint32_t*)out;
    or_word(o, base + (uint32_t)ukl_max(j1, 0), BMC(SEL(BMC(0), lo, j1 >= 0)));
    or_word(o, base + (uint32_t)ukl_max(j0, 0), BMC(SEL(BMC(0), hi, j0 >= 0)));
}

// Each of a lane's set bits `w` as a position, at the count before them `at`, one per set bit (at most BW).
UKL_INLINE void write_positions(BM w, uint32_t at, uint32_t gl, uint32_t delay, UKL_GLOBAL uint32_t* positions, uint32_t capacity)
{
    for (uint32_t j = 0u; j < (uint32_t)BW && w != BMC(0); j++) {
        if (at + j < capacity) positions[at + j] = gl * (uint32_t)BW + CTZ_BM(w) - delay;
        w = BMC(w & BMC(w - BMC(1)));
    }
}

// A counted output (`native_ir::BlockNative::extracts` and `totals`): the stream's set bits, counted from the file's
// start. The count is a carry like the others, combined by addition: the lanes' counts summed in the group, the
// group's aggregate published, and the predecessors' states read back to an inclusive count, by `look_back`'s
// protocol. The file's last group writes the total. With `write`, each lane's bits are written as positions. False
// when a predecessor has not published its count yet.
UKL_INLINE bool count_sink(BM v, uint32_t gl, uint32_t g, uint32_t l, uint32_t groups, uint32_t len, uint32_t delay, UKL_GLOBAL uint32_t* state,
                           UKL_GLOBAL uint32_t* positions, uint32_t capacity, bool write, UKL_GLOBAL uint32_t* total, uint32_t spins __UKL_PARAMS)
{
    BM w = stream_cut(v, gl, len, delay);
    uint32_t n = POPCOUNT_BM(lane_bits(w));
    uint32_t agg = ukl_sg_sum(n __UKL_ARGS);
    if (l == 0u) ukl_atomic_store(&state[g], CARRY_AGGREGATE | agg);
    uint32_t prefix = 0u;
    for (uint32_t back = 1u; back <= g; back++) {
        uint32_t st = 0u;
        for (uint32_t spin = 0u; spin <= spins && (st >> 30) == 0u; spin++) st = ukl_sg_shuffle(poll(&state[g - back]), 0u __UKL_ARGS);
        if ((st >> 30) == 0u) return false;
        prefix += st & CARRY_VALUE;
        if ((st >> 30) == 2u) break;
    }
    if (l == 0u) ukl_atomic_store(&state[g], CARRY_INCLUSIVE | (prefix + agg));
    // An extract's count; a total's flag: whether the output has a bit (`BlockProgram::totals`).
    if (l == 0u && g + 1u == groups) *total = write ? prefix + agg : (uint32_t)(prefix + agg != 0u);
    uint32_t at = prefix + ukl_sg_exclusive_sum(n, l __UKL_ARGS);
    if (write) write_positions(w, at, gl, delay, positions, capacity);
    return true;
}

// A total's flag: set when any lane of the group has a bit of `w`. Every group that sets it writes the same 1, so no
// group waits on another.
UKL_INLINE void totals_or(BM w, uint32_t l, UKL_GLOBAL uint32_t* total __UKL_PARAMS)
{
    bool any = sg_any(lane_bits(w) != 0ul __UKL_ARGS);
    if (l == 0u && any) ukl_atomic_or(total, 1u);
}

// A counted output once its count before the group is known (`prefix`, from generated code's exchange of every
// count at once): the file's last group writes the total; with `write`, each lane's bits `w` (`n` of them, `agg` in
// the group) are written as positions at the count before them.
UKL_INLINE void count_finish(BM w, uint32_t n, uint32_t agg, uint32_t prefix, uint32_t gl, uint32_t g, uint32_t l, uint32_t groups, uint32_t delay,
                             UKL_GLOBAL uint32_t* positions, uint32_t capacity, bool write, UKL_GLOBAL uint32_t* total __UKL_PARAMS)
{
    if (l == 0u && g + 1u == groups) *total = prefix + agg;
    uint32_t at = prefix + ukl_sg_exclusive_sum(n, l __UKL_ARGS);
    if (write) write_positions(w, at, gl, delay, positions, capacity);
}
