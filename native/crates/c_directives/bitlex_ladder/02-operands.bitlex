# C's and C++'s directives, step 2: each directive's kind, its bytes and its operands (decision
# 0327, mode (a)): a `#define`'s name, parameters and body; an include's header, as spelled; a
# conditional's expression; a `#pragma`'s first two words and text; a `#line`'s number, file and
# the rest; the text after any other directive's word. Each operand is a field's node.
#
#   #  define  X  1   /* a comment */
#   ^^^^^^^^^^^^^^^^ the directive: from its `#` to its line's last token's end
#
# The reference is the lean scan (`rerail_c_pp::directives`): a directive is a logical line (its
# `\`-newlines spliced) whose first token is `#`, a comment before it a blank. Its kind is the
# word after the `#` (`null` for none, `line_marker` for a number, `unknown` for anything else).
# Every directive is recorded, in every group: no configuration is read here.
#
# What the step does not read goes to the lean scan, so no row is wrong: a carriage return, a
# trigraph, a digraph `%:`, a raw string, a `'` after a digit (a digit separator), a string or a
# character constant open at a line's end, a splice inside a word or a comment's opener, and a
# block comment open at the file's end.

lexer c_directives

class dquote    = '"'
class squote    = '\''
class backslash = '\\'
class lf        = '\n'
class cr        = '\r'
class blankc    = ' ' '\t' 0x0b 0x0c
class slash     = '/'
class star      = '*'
class hash      = '#'
class qmark     = '?'
# The trigraphs' third bytes: a configuration may read `??=` as `#`.
class tri       = '=' '/' '\'' '(' ')' '!' '<' '>' '-'
class percent   = '%'
class colon     = ':'
class c_r       = 'R'
class bom1      = 0xef
class bom2      = 0xbb
class bom3      = 0xbf
class digit     = '0'..'9'
class lparen    = '('
class dot       = '.'
class idstart   = 'a'..'z' 'A'..'Z' '_' '$' 0x80..0xff
class wordc     = 'a'..'z' 'A'..'Z' '0'..'9' '_' '$' 0x80..0xff

mask last_byte  = ~next(~empty)
mask first_byte = ~prev(~empty)

# --- What the step hands over ------------------------------------------------------------------

escape "a carriage return" when cr
escape "a trigraph" when qmark & next(qmark) & next(tri, 2)
escape "a digraph `%:`" when percent & next(colon)

# --- Splices and regions -----------------------------------------------------------------------

# A `\` right before a line break splices the two lines (phase 2): neither byte is in a token.
mask splice_bs  = backslash & next(lf)
mask splice_lf  = lf & prev(backslash)
mask splice     = splice_bs | splice_lf
# A line's end: a line break no `\` splices.
mask nl         = lf & ~splice_lf
escape "a splice inside a word" when splice_bs & prev(wordc) & next(wordc, 2)
escape "a splice inside a comment's opener" when slash & next(backslash) & next(lf, 2)

mask escaped    = escaped(backslash)
mask q          = dquote & ~escaped
mask sq         = squote & ~escaped
mask line_open  = slash & next(slash)
mask block_open = slash & next(star)
# `*/`'s `/`, but not the `/` of `/*/`.
mask block_end  = slash & prev(star) & ~prev(block_open, 2)
# The regions, left to right: strings, character constants and comments hide each other's
# openers. A line comment's line break ends its line; a spliced one does not end the comment.
regions hidden {
  str   = q .. q | nl
  chr   = sq .. sq | nl
  line  = line_open .. nl outside
  block = block_open .. block_end
}
# A string or a character constant a line break closes (`don't`): the lean scan ends its token
# before the break.
escape "a string or a character constant open at a line's end" when nl & prev(f_str | f_chr)
escape "a block comment open at the end of the file" when f_block & last_byte
escape "a string open at the end of the file" when (f_str | f_chr) & last_byte

mask region     = hidden | o_str | o_chr | o_line | o_block
mask code       = ~region
escape "a raw string" when o_str & prev(c_r)
escape "a digit separator" when o_chr & prev(digit)

# A comment's bytes, its `*/` too: a blank, as the lexer reads it.
mask comment    = f_line | f_block | (block_end & prev(f_block))
# A UTF-8 byte order mark at the file's start, which the lean scan skips: a blank.
mask bom        = first_byte & bom1 & next(bom2) & next(bom3, 2)
mask bom_bytes  = bom | prev(bom) | prev(bom, 2)
mask blank      = (code & blankc) | comment | splice | bom_bytes

# --- Directives --------------------------------------------------------------------------------

# A line's first byte: the file's first, or the byte after a line break, one inside a block
# comment too (clang's start of a line).
mask line_first = first_byte | prev(nl)
# The blanks a line starts with.
mask lead       = fill(line_first & blank, ~blank)
mask dir_hash   = code & hash & (line_first | prev(lead))
# A directive's line: from its `#` to its line break, a line break in a block comment aside.
mask eol        = nl & ~f_block
mask dir_line   = fill(dir_hash, eol)

mask d_code     = dir_line & code & ~blank & ~nl
mask d_word     = d_code & wordc
# A `(` right after a word, no blank between: a function-like macro's parameters open (only a
# `#define` reads it so; elsewhere it is one more token).
mask fn_paren   = d_code & lparen & prev(d_word)
# `...`: three dots (a longer run of dots is one token too).
mask d_dot      = d_code & dot
mask dots_start = d_dot & next(d_dot) & next(d_dot, 2) & ~prev(d_dot)
mask in_dots    = fill(dots_start, ~d_dot)

# --- Tokens ------------------------------------------------------------------------------------

# A run is a directive line's (`d_word`), not the class's: Metal takes a token's last from its
# run's mask over the whole file, where the code between directives has words too.

pairs two_start = "##"
# A string's bytes, its quotes too, and a character constant's: a directive line's runs, for
# the same reason. Two strings in a row (`"a" "b"` without the blank) are one run, one token.
mask s_bytes    = (f_str | (q & prev(f_str))) & dir_line
mask c_bytes    = (f_chr | (sq & prev(f_chr))) & dir_line
token string     = start q & o_str & dir_line run s_bytes
token char_lit   = start sq & o_chr & dir_line run c_bytes
token hash       = start dir_hash pair two_start
token identifier = start d_word & idstart & ~prev(d_word) run d_word
token number     = start d_word & digit & ~prev(d_word) run d_word
mask d_punct    = d_code & ~d_word & ~dir_hash & ~o_str & ~o_chr
token fn_open    = start fn_paren
token ellipsis   = start dots_start run in_dots
token punct      = start d_punct & ~fn_paren & ~in_dots & ~prev(two_start & d_punct) pair two_start
keywords punct { "(" ")" "," "<" ">" }
keywords identifier { } soft { "define" "undef" "include" "include_next" "import" "embed" "if" "ifdef" "ifndef" "elif" "elifdef" "elifndef" "else" "endif" "line" "error" "warning" "pragma" "ident" "sccs" "assert" "unassert" }

skip ~dir_line | blank | nl

# A directive's end: its line's break, or the file's end. Hidden: a line break after the last
# directive gives the file's end a second.
mask dir_end     = eol & prev(dir_line)
mark eol_mark = dir_end, end
hidden eol_mark

# --- The tree ----------------------------------------------------------------------------------

tree c_directives {
  node directives whole = directive*
  # A directive's node is `unknown` until its word names it.
  node unknown = hash (retag null eol_mark
                      | named eol_mark)
  choice named = retag define 'define' define_tail
               | retag undef 'undef' [name: identifier (any)* | not_ident (any)*]
               | retag include 'include' include_tail | retag include_next 'include_next' include_tail
               | retag import 'import' include_tail | retag embed 'embed' embed_tail
               | retag if 'if' cond_tail | retag ifdef 'ifdef' cond_tail | retag ifndef 'ifndef' cond_tail
               | retag elif 'elif' cond_tail | retag elifdef 'elifdef' cond_tail
               | retag elifndef 'elifndef' cond_tail | retag else 'else' cond_tail
               | retag endif 'endif' cond_tail
               | retag line 'line' [rest: line_rest] | retag line_marker rest: marker_rest
               | retag pragma 'pragma' [text: pragma_text]
               | retag error 'error' text_tail | retag warning 'warning' text_tail
               | retag ident 'ident' text_tail | retag sccs 'sccs' text_tail
               | retag assert 'assert' text_tail | retag unassert 'unassert' text_tail
               | not_number text_tail
  # A name, then a parameter list where a `(` touches it, then the replacement list. No name:
  # no macro (the lean scan's malformed `#define`).
  choice define_tail = name: identifier (params: params [body: operands] | [body: plain_body]) | [not_ident (any)*]
  node params = fn_open [param_list] ')'
  # `...`, or a parameter then GNU's `...`, or a `,` and the rest: nothing after a `...`.
  choice param_list nested = variadic: ellipsis | param: identifier [variadic: ellipsis | ',' param_list]
  # The header: `"…"`, `<…>` (to its first `>`), or tokens a macro makes one of.
  choice include_tail = spelled: string (any)* | spelled: header (any)* | [spelled: macro_header]
  # `#embed`'s parameters after the header are not the header's.
  choice embed_tail = spelled: string (any)* | spelled: header (any)* | [spelled: not_header (any)*]
  node header = '<' (any except '>')* '>'
  choice cond_tail = [expr: operands]
  choice text_tail = [text: operands]
  node pragma_text = first: identifier [second: identifier (any)* | not_ident (any)*] | not_ident (any)*
  # A line's number where it is one, then its file where the next token is a string.
  node line_rest = (n: number | not_number) line_after
  node marker_rest = n: number line_after
  choice line_after = [file: string (any)* | not_string (any)*]
  # Tokens a macro makes a header name of: no string or `<` first.
  node macro_header = not_header (any)*
  # A replacement list no parameter list opens: its first token is no `(` touching the name.
  node plain_body = not_fn (any)*
  # Tokens by what they are not (`any except` names literals only).
  choice other = punct | '(' | ')' | ',' | '<' | '>' | hash | char_lit | ellipsis
  choice not_number = identifier | other | string | fn_open
  choice not_ident = number | other | string | fn_open
  choice not_string = identifier | number | other | fn_open
  choice not_fn = identifier | number | other | string
  choice not_header = identifier | number | punct | '(' | ')' | ',' | '>' | hash | char_lit | ellipsis | fn_open
  # A directive's tokens after its word.
  node operands = any (any)*
  choice directive = unknown
}
