  0338 PUSH @0340
  0339 GOTO @0007
  0340 IS m=0 8
  0341 GOTO @0344
  0342 KEEP 0
  0343 GOTO @0338
  0344 IF m=1 0
  0345 PUSH @0347
  0346 GOTO @0371
  0347 EXPR m=14 0
  0348 GOTO @0368
  0349 GOTO @0310
  0350 LINE 0
  0351 GOTO @0353
  0352 GOTO @0310
  0353 IS m=0 0
  0354 GOTO @0356
  0355 GOTO @0310
  0356 LOOKUP 0
  0357 GOTO @0368
  0358 GOTO @0310
  0359 LINE 0
  0360 GOTO @0362
  0361 GOTO @0368
  0362 IS m=0 0
