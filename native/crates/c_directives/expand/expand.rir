  ppop s65
  ppop s66
  ppop s67
  ppop s68
  ppop s69
  ppop s70
  ppop s71
  ppop s72
  ppop s73
  ppsuffix  ; C++ only
  ppcpp  ; C++ only
  ; main: the TU's tokens, macros expanded, onto the output tape.
  0000 PUSH @0002
  0001 GOTO @0007
  0002 IS m=0 8  ; EOF
  0003 GOTO @0006
  0004 PUT 0
  0005 GOTO @0000
  0006 ACCEPT 0
  ; one: T <- the next token, macros expanded (lean `Pp::next`).
  0007 PUSH @0009
  0008 GOTO @0131
  0009 IS m=4 0  ; in an `#if`'s line, `defined` is an operator
  0010 GOTO @0014
  0011 LOOKUP 0  ; an identifier, not painted, naming a macro
  0012 GOTO @0017
  0013 RETURN 0
  0014 DEFINED 0
  0015 RETURN 0
  0016 GOTO @0011
  0017 MACRO m=0 0  ; being expanded: painted
  0018 GOTO @0025
  0019 MACRO m=2 0  ; a built-in
  0020 GOTO @0027
  0021 MACRO m=1 0
  0022 GOTO @0057
  0023 FRAME 0  ; object-like
  0024 GOTO @0086
  0025 PAINT 0
  0026 RETURN 0
  ; A built-in: its value, its operand read raw to its `)` (and expanded where it asks).
  0027 MACRO m=1 0
  0028 GOTO @0031
  0029 BUILTIN m=0 0
  0030 RETURN 0
  0031 PEEK m=1 s0
  0032 GOTO @0034
  0033 RETURN 0
  0034 BUILTIN m=1 0  ; an operator here: its operand's level opened
  0035 GOTO @0037
  0036 RETURN 0
  0037 READ 0  ; its `(`
  0038 PUSH @0040
  0039 GOTO @0131
  0040 IS m=0 8
  0041 GOTO @0045
  0042 BUILTIN m=2 0
  0043 GOTO @0045
  0044 GOTO @0038
  0045 BUILTIN m=3 0  ; the operand to be expanded, else T its value
  0046 GOTO @0048
  0047 RETURN 0
  0048 PUSH @0050
  0049 GOTO @0007
  0050 IS m=0 8
  0051 GOTO @0054
  0052 KEEP 0
  0053 GOTO @0048
  0054 BUILTIN m=4 0  ; T its value, or `_Pragma` carried out
  0055 RETURN 0
  0056 GOTO @0007
  0057 PEEK m=1 s0  ; a call only where `(` follows
  0058 GOTO @0060
  0059 RETURN 0
  0060 FRAME 0
  0061 READ 0  ; the `(`
  ; args: the call's arguments, unexpanded, to its `)`.
  0062 PUSH @0064
  0063 GOTO @0131
  0064 IS m=0 8  ; EOF (or a stop source's end): no `)`
  0065 GOTO @0084
  0066 IS m=1 s0
  0067 GOTO @0074
  0068 IS m=1 s1
  0069 GOTO @0076
  0070 IS m=1 s2
  0071 GOTO @0079
  0072 ARG m=0 0
  0073 GOTO @0062
  0074 ARG m=1 0
  0075 GOTO @0062
  0076 ARG m=2 0  ; the call's `)`, at depth 0
  0077 GOTO @0081
  0078 GOTO @0062
  0079 ARG m=3 0
  0080 GOTO @0062
  0081 ARG m=4 0  ; the count right
  0082 GOTO @0086
  0083 RETURN 0  ; else T is the call's name, painted
  0084 ARG m=5 0
  0085 GOTO @0007
  ; pre: each argument substitution expands, expanded in isolation, in the order it asks.
  0086 PRE m=0 0
  0087 GOTO @0089
  0088 GOTO @0097
  0089 PUSH @0091
  0090 GOTO @0007
  0091 IS m=0 8  ; the argument's end
  0092 GOTO @0095
  0093 KEEP 0
  0094 GOTO @0089
  0095 PRE m=1 0
  0096 GOTO @0086
  ; subst: the top frame's body substituted, a body token a turn (`SUB`), its `__VA_OPT__`s'
  ; contents walked in place, `#`'s literals made a token a turn (`STR`), then its pastes (`GLUE`);
  ; then read, its macro disabled while it is.
  0097 SUB m=0 0
  0098 SUB m=1 0  ; the body's next token, B
  0099 GOTO @0107
  0100 SUB m=7 0  ; a __VA_OPT__'s content ended
  0101 GOTO @0120
  0102 SUB m=9 0  ; the output's pastes
  0103 GLUE 0
  0104 GOTO @0103
  0105 SUB m=10 0
  0106 GOTO @0007
  0107 SUB m=2 0  ; `#` and a parameter
  0108 GOTO @0115
  0109 SUB m=3 0  ; `#__VA_OPT__(`
  0110 GOTO @0098
  0111 SUB m=4 0  ; `__VA_OPT__(`
  0112 GOTO @0098
  0113 SUB m=5 0  ; a parameter's argument, or B
  0114 GOTO @0098
  0115 STR m=0 0
  0116 STR m=1 0
  0117 GOTO @0116
  0118 STR m=2 0
  0119 GOTO @0098
  0120 SUB m=6 0  ; a `#__VA_OPT__`'s content: pasted, then stringized
  0121 GOTO @0123
  0122 GOTO @0098
  0123 GLUE 0
  0124 GOTO @0123
  0125 SUB m=8 0
  0126 STR m=0 0
  0127 STR m=1 0
  0128 GOTO @0127
  0129 STR m=3 0
  0130 GOTO @0098
  ; raw: T <- the next token, unexpanded; directives carried out as their `#` is read.
  0131 READ 0
  0132 IS m=3 0
  0133 GOTO @0135
  0134 RETURN 0
  0135 LINE 0
  0136 GOTO @0138
  0137 GOTO @0131  ; the null directive
  0138 IS m=0 1  ; a number: GNU's line marker
  0139 GOTO @0192
  0140 IS m=1 s3
  0141 GOTO @0218
  0142 IS m=1 s4
  0143 GOTO @0220
  0144 IS m=1 s5
  0145 GOTO @0248
  0146 IS m=1 s6
  0147 GOTO @0222
  0148 IS m=1 s7
  0149 GOTO @0232
  0150 IS m=1 s8
  0151 GOTO @0261
  0152 IS m=1 s9
  0153 GOTO @0261
  0154 IS m=1 s10
  0155 GOTO @0261
  0156 IS m=1 s11
  0157 GOTO @0261
  0158 IS m=1 s12
  0159 GOTO @0269
  0160 IS m=1 s13
  0161 GOTO @0204
  0162 IS m=1 s14
  0163 GOTO @0204
  0164 IS m=1 s15
  0165 GOTO @0204
  0166 IS m=1 s16
  0167 GOTO @0202
  0168 IS m=1 s17
  0169 GOTO @0193
  0170 IS m=1 s18
  0171 GOTO @0174
  0172 SKIPLINE 0
  0173 GOTO @0131
  ; `#embed`: its name (expanded where it is not spelled), then its parameters expanded, then its
  ; file's bytes.
  0174 EMBED m=0 0
  0175 GOTO @0184
  0176 PUSH @0178
  0177 GOTO @0007
  0178 IS m=0 8
  0179 GOTO @0182
  0180 KEEP 0
  0181 GOTO @0176
  0182 EMBED m=2 0
  0183 GOTO @0131
  0184 PUSH @0186
  0185 GOTO @0007
  0186 IS m=0 8
  0187 GOTO @0190
  0188 KEEP 0
  0189 GOTO @0184
  0190 EMBED m=1 0
  0191 GOTO @0176
  0192 LINEDIR m=0 0
  0193 IF m=2 0  ; its line expanded
  0194 PUSH @0196
  0195 GOTO @0007
  0196 IS m=0 8
  0197 GOTO @0200
  0198 KEEP 0
  0199 GOTO @0194
  0200 LINEDIR m=1 0
  0201 GOTO @0131
  0202 PRAGMA 0
  0203 GOTO @0131
  ; An include: its header name as mode (a) read it, or made of its line expanded.
  0204 INCLUDE m=0 0
  0205 GOTO @0216
  0206 IF m=2 0
  0207 PUSH @0209
  0208 GOTO @0007
  0209 IS m=0 8
  0210 GOTO @0213
  0211 KEEP 0
  0212 GOTO @0207
  0213 INCLUDE m=1 0
  0214 GOTO @0216
  0215 GOTO @0131  ; malformed, or a name the host resolves for the next round
  0216 INCLUDE m=2 0
  0217 GOTO @0131
  0218 DEFINE 0
  0219 GOTO @0131
  0220 UNDEF 0
  0221 GOTO @0131
  ; `#ifdef` and `#ifndef`: no name is not defined (the lean pass's reading).
  0222 LINE 0
  0223 GOTO @0226
  0224 COND m=0 0
  0225 GOTO @0272
  0226 IS m=0 0  ; an identifier
  0227 GOTO @0229
  0228 GOTO @0245
  0229 LOOKUP 0
  0230 GOTO @0242
  0231 GOTO @0245
  0232 LINE 0
  0233 GOTO @0236
  0234 COND m=1 0
  0235 GOTO @0131
  0236 IS m=0 0
  0237 GOTO @0239
  0238 GOTO @0242
  0239 LOOKUP 0
  0240 GOTO @0245
  0241 GOTO @0242
  0242 SKIPLINE 0
  0243 COND m=1 0
  0244 GOTO @0131
  0245 SKIPLINE 0
  0246 COND m=0 0
  0247 GOTO @0272
  ; `#if`: its line expanded, `defined` an operator, then evaluated.
  0248 IF m=0 0
  0249 PUSH @0251
  0250 GOTO @0007
  0251 IS m=0 8
  0252 GOTO @0255
  0253 KEEP 0
  0254 GOTO @0249
  0255 IF m=1 0
  0256 GOTO @0259
  0257 COND m=0 0
  0258 GOTO @0272
  0259 COND m=1 0
  0260 GOTO @0131
  ; An `#elif…` or `#else` read: its chain was taken, so the rest of it is passed, to its `#endif`.
  0261 COND m=2 0
  0262 GOTO @0265
  0263 SKIPLINE 0  ; no group open: unmatched
  0264 GOTO @0131
  0265 IS m=1 s11
  0266 COND m=5 0
  0267 SKIPLINE 0
  0268 GOTO @0272
  0269 SKIPLINE 0
  0270 COND m=6 0
  0271 GOTO @0131
  ; skip: a group not taken, passed by its chain to the next directive of it (lean `skip_group`).
  0272 SKIP 0
  0273 READ 0  ; its `#`
  0274 IS m=0 8  ; the file's end, the chain open
  0275 GOTO @0131
  0276 LINE 0
  0277 GOTO @0279
  0278 GOTO @0272
  0279 IS m=1 s12
  0280 GOTO @0269
  0281 COND m=3 0  ; taken already, or past its `#else`: passed too
  0282 GOTO @0292
  0283 IS m=1 s11
  0284 GOTO @0295
  0285 IS m=1 s8
  0286 GOTO @0299
  0287 IS m=1 s9
  0288 GOTO @0309
  0289 IS m=1 s10
  0290 GOTO @0318
  0291 GOTO @0272
  0292 IS m=1 s11
  0293 COND m=5 0
  0294 GOTO @0272
  0295 SKIPLINE 0
  0296 COND m=5 0
  0297 COND m=4 0
  0298 GOTO @0131
  0299 IF m=0 0
  0300 PUSH @0302
  0301 GOTO @0007
  0302 IS m=0 8
  0303 GOTO @0306
  0304 KEEP 0
  0305 GOTO @0300
  0306 IF m=1 0
  0307 GOTO @0327
  0308 GOTO @0272
  0309 LINE 0
  0310 GOTO @0312
  0311 GOTO @0272
  0312 IS m=0 0
  0313 GOTO @0315
  0314 GOTO @0272
  0315 LOOKUP 0
  0316 GOTO @0327
  0317 GOTO @0272
  0318 LINE 0
  0319 GOTO @0321
  0320 GOTO @0327
  0321 IS m=0 0
  0322 GOTO @0324
  0323 GOTO @0327
  0324 LOOKUP 0
  0325 GOTO @0272
  0326 GOTO @0327
  0327 SKIPLINE 0
  0328 COND m=4 0
  0329 GOTO @0131
