  ; `#define`: its name, its parameters, its body marked, its uses walked, a token a turn.
  0236 DEFINE m=0 0  ; its name
  0237 GOTO @0239
  0238 GOTO @0131
  0239 DEFINE m=1 0  ; `(` right after it
  0240 GOTO @0242
  0241 GOTO @0247
  0242 DEFINE m=2 0  ; a parameter list's token
  0243 GOTO @0242
  0244 DEFINE m=3 0  ; the list closed
  0245 GOTO @0247
  0246 GOTO @0131
  0247 DEFINE m=4 0
  0248 DEFINE m=5 0  ; a body token marked
  0249 GOTO @0248
  0250 DEFINE m=6 0
  0251 DEFINE m=7 0  ; a use walked
  0252 GOTO @0251
  0253 DEFINE m=8 0
  0254 GOTO @0131
  0255 UNDEF 0
  0256 GOTO @0131
  ; `#ifdef` and `#ifndef`: no name is not defined (the lean pass's reading).
  0257 LINE 0
  0258 GOTO @0261
  0259 COND m=0 0
  0260 GOTO @0310
  0261 IS m=0 0  ; an identifier
  0262 GOTO @0264
  0263 GOTO @0280
  0264 LOOKUP 0
  0265 GOTO @0277
  0266 GOTO @0280
  0267 LINE 0
  0268 GOTO @0271
  0269 COND m=1 0
  0270 GOTO @0131
  0271 IS m=0 0
  0272 GOTO @0274
