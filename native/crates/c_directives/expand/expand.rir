program - ir=7 grammar=none
; Decision 0348: a translation unit's preprocessing, as preprocessing words (the compiler's
; `pp_words`, which says what each word does). The lean preprocessor's `Pp` is its reference.
; A line ending `; C++ only` is left out of C's program (`expand::program`). Generated from a
; labeled text, the words numbered and their strings listed.
  mode set=0 query=0
  string 0 "("
  string 1 ")"
  string 2 ","
  string 3 "define"
  string 4 "undef"
  string 5 "if"
  string 6 "ifdef"
  string 7 "ifndef"
  string 8 "elif"
  string 9 "elifdef"
  string 10 "elifndef"
  string 11 "else"
  string 12 "endif"
  string 13 "include"
  string 14 "include_next"
  string 15 "import"
  string 16 "pragma"
  string 17 "line"
  string 18 "embed"
  string 19 "<<="
  string 20 ">>="
  string 21 "..."
  string 22 "->*"
  string 23 "<=>"
  string 24 "->"
  string 25 "++"
  string 26 "--"
  string 27 "<<"
  string 28 ">>"
  string 29 "<="
  string 30 ">="
  string 31 "=="
  string 32 "!="
  string 33 "&&"
  string 34 "||"
  string 35 "*="
  string 36 "/="
  string 37 "%="
  string 38 "+="
  string 39 "-="
