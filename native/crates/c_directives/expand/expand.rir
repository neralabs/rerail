  string 66 "*"
  string 67 "/"
  string 68 "%"
  string 69 "^"
  string 70 "&"
  string 71 "|"
  string 72 "<"
  string 73 ">"
  ppop s19
  ppop s20
  ppop s21
  ppop s22  ; C++ only
  ppop s23  ; C++ only
  ppop s24
  ppop s25
  ppop s26
  ppop s27
  ppop s28
  ppop s29
  ppop s30
