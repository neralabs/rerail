  ppop s69
  ppop s70
  ppop s71
  ppop s72
  ppop s73
  ppsuffix  ; C++ only
  ppcpp  ; C++ only
  ; main: the TU's tokens, macros expanded, onto the output tape.
  0000 PUSH @0002
  0001 GOTO @0007
  0002 IS m=0 8  ; EOF
  0003 GOTO @0006
  0004 PUT 0
  0005 GOTO @0000
  0006 ACCEPT 0
  ; one: T <- the next token, macros expanded (lean `Pp::next`).
  0007 PUSH @0009
  0008 GOTO @0099
  0009 IS m=4 0  ; in an `#if`'s line, `defined` is an operator
  0010 GOTO @0014
  0011 LOOKUP 0  ; an identifier, not painted, naming a macro
  0012 GOTO @0017
  0013 RETURN 0
  0014 DEFINED 0
  0015 RETURN 0
  0016 GOTO @0011
  0017 MACRO m=0 0  ; being expanded: painted
  0018 GOTO @0025
  0019 MACRO m=2 0  ; a built-in
  0020 GOTO @0027
  0021 MACRO m=1 0
  0022 GOTO @0057
  0023 FRAME 0  ; object-like
  0024 GOTO @0086
  0025 PAINT 0
  0026 RETURN 0
  ; A built-in: its value, its operand read raw to its `)` (and expanded where it asks).
  0027 MACRO m=1 0
  0028 GOTO @0031
  0029 BUILTIN m=0 0
  0030 RETURN 0
  0031 PEEK m=1 s0
  0032 GOTO @0034
  0033 RETURN 0
  0034 BUILTIN m=1 0  ; an operator here: its operand's level opened
  0035 GOTO @0037
  0036 RETURN 0
  0037 READ 0  ; its `(`
  0038 PUSH @0040
  0039 GOTO @0099
  0040 IS m=0 8
  0041 GOTO @0045
  0042 BUILTIN m=2 0
  0043 GOTO @0045
  0044 GOTO @0038
  0045 BUILTIN m=3 0  ; the operand to be expanded, else T its value
  0046 GOTO @0048
  0047 RETURN 0
  0048 PUSH @0050
  0049 GOTO @0007
  0050 IS m=0 8
  0051 GOTO @0054
  0052 KEEP 0
  0053 GOTO @0048
  0054 BUILTIN m=4 0  ; T its value, or `_Pragma` carried out
  0055 RETURN 0
  0056 GOTO @0007
  0057 PEEK m=1 s0  ; a call only where `(` follows
  0058 GOTO @0060
  0059 RETURN 0
  0060 FRAME 0
  0061 READ 0  ; the `(`
  ; args: the call's arguments, unexpanded, to its `)`.
  0062 PUSH @0064
  0063 GOTO @0099
  0064 IS m=0 8  ; EOF (or a stop source's end): no `)`
  0065 GOTO @0084
  0066 IS m=1 s0
  0067 GOTO @0074
  0068 IS m=1 s1
  0069 GOTO @0076
  0070 IS m=1 s2
  0071 GOTO @0079
  0072 ARG m=0 0
  0073 GOTO @0062
  0074 ARG m=1 0
  0075 GOTO @0062
  0076 ARG m=2 0  ; the call's `)`, at depth 0
  0077 GOTO @0081
  0078 GOTO @0062
  0079 ARG m=3 0
  0080 GOTO @0062
  0081 ARG m=4 0  ; the count right
  0082 GOTO @0086
  0083 RETURN 0  ; else T is the call's name, painted
  0084 ARG m=5 0
  0085 GOTO @0007
  ; pre: each argument substitution expands, expanded in isolation, in the order it asks.
  0086 PRE m=0 0
  0087 GOTO @0089
  0088 GOTO @0097
  0089 PUSH @0091
  0090 GOTO @0007
  0091 IS m=0 8  ; the argument's end
  0092 GOTO @0095
  0093 KEEP 0
  0094 GOTO @0089
  0095 PRE m=1 0
  0096 GOTO @0086
  0097 SUBST 0  ; read next, its macro disabled while it is
  0098 GOTO @0007
  ; raw: T <- the next token, unexpanded; directives carried out as their `#` is read.
  0099 READ 0
  0100 IS m=3 0
  0101 GOTO @0103
  0102 RETURN 0
  0103 LINE 0
  0104 GOTO @0106
  0105 GOTO @0099  ; the null directive
  0106 IS m=0 1  ; a number: GNU's line marker
  0107 GOTO @0160
  0108 IS m=1 s3
  0109 GOTO @0186
  0110 IS m=1 s4
  0111 GOTO @0188
  0112 IS m=1 s5
  0113 GOTO @0216
  0114 IS m=1 s6
  0115 GOTO @0190
  0116 IS m=1 s7
  0117 GOTO @0200
  0118 IS m=1 s8
  0119 GOTO @0229
  0120 IS m=1 s9
  0121 GOTO @0229
  0122 IS m=1 s10
  0123 GOTO @0229
  0124 IS m=1 s11
  0125 GOTO @0229
  0126 IS m=1 s12
  0127 GOTO @0237
  0128 IS m=1 s13
  0129 GOTO @0172
  0130 IS m=1 s14
  0131 GOTO @0172
  0132 IS m=1 s15
  0133 GOTO @0172
  0134 IS m=1 s16
  0135 GOTO @0170
  0136 IS m=1 s17
  0137 GOTO @0161
  0138 IS m=1 s18
  0139 GOTO @0142
  0140 SKIPLINE 0
  0141 GOTO @0099
  ; `#embed`: its name (expanded where it is not spelled), then its parameters expanded, then its
  ; file's bytes.
  0142 EMBED m=0 0
  0143 GOTO @0152
  0144 PUSH @0146
  0145 GOTO @0007
  0146 IS m=0 8
  0147 GOTO @0150
  0148 KEEP 0
  0149 GOTO @0144
  0150 EMBED m=2 0
  0151 GOTO @0099
  0152 PUSH @0154
  0153 GOTO @0007
  0154 IS m=0 8
  0155 GOTO @0158
  0156 KEEP 0
  0157 GOTO @0152
  0158 EMBED m=1 0
  0159 GOTO @0144
  0160 LINEDIR m=0 0
  0161 IF m=2 0  ; its line expanded
  0162 PUSH @0164
  0163 GOTO @0007
  0164 IS m=0 8
  0165 GOTO @0168
  0166 KEEP 0
  0167 GOTO @0162
  0168 LINEDIR m=1 0
  0169 GOTO @0099
  0170 PRAGMA 0
  0171 GOTO @0099
  ; An include: its header name as mode (a) read it, or made of its line expanded.
  0172 INCLUDE m=0 0
  0173 GOTO @0184
  0174 IF m=2 0
  0175 PUSH @0177
  0176 GOTO @0007
  0177 IS m=0 8
  0178 GOTO @0181
  0179 KEEP 0
  0180 GOTO @0175
  0181 INCLUDE m=1 0
  0182 GOTO @0184
  0183 GOTO @0099  ; malformed, or a name the host resolves for the next round
  0184 INCLUDE m=2 0
  0185 GOTO @0099
  0186 DEFINE 0
  0187 GOTO @0099
  0188 UNDEF 0
  0189 GOTO @0099
  ; `#ifdef` and `#ifndef`: no name is not defined (the lean pass's reading).
  0190 LINE 0
  0191 GOTO @0194
  0192 COND m=0 0
  0193 GOTO @0240
  0194 IS m=0 0  ; an identifier
  0195 GOTO @0197
  0196 GOTO @0213
  0197 LOOKUP 0
  0198 GOTO @0210
  0199 GOTO @0213
  0200 LINE 0
  0201 GOTO @0204
  0202 COND m=1 0
  0203 GOTO @0099
  0204 IS m=0 0
  0205 GOTO @0207
  0206 GOTO @0210
  0207 LOOKUP 0
  0208 GOTO @0213
  0209 GOTO @0210
  0210 SKIPLINE 0
  0211 COND m=1 0
  0212 GOTO @0099
  0213 SKIPLINE 0
  0214 COND m=0 0
  0215 GOTO @0240
  ; `#if`: its line expanded, `defined` an operator, then evaluated.
  0216 IF m=0 0
  0217 PUSH @0219
  0218 GOTO @0007
  0219 IS m=0 8
  0220 GOTO @0223
  0221 KEEP 0
  0222 GOTO @0217
  0223 IF m=1 0
  0224 GOTO @0227
  0225 COND m=0 0
  0226 GOTO @0240
  0227 COND m=1 0
  0228 GOTO @0099
  ; An `#elif…` or `#else` read: its chain was taken, so the rest of it is passed, to its `#endif`.
  0229 COND m=2 0
  0230 GOTO @0233
  0231 SKIPLINE 0  ; no group open: unmatched
  0232 GOTO @0099
  0233 IS m=1 s11
  0234 COND m=5 0
  0235 SKIPLINE 0
  0236 GOTO @0240
  0237 SKIPLINE 0
  0238 COND m=6 0
  0239 GOTO @0099
  ; skip: a group not taken, passed by its chain to the next directive of it (lean `skip_group`).
  0240 SKIP 0
  0241 READ 0  ; its `#`
  0242 IS m=0 8  ; the file's end, the chain open
  0243 GOTO @0099
  0244 LINE 0
  0245 GOTO @0247
  0246 GOTO @0240
  0247 IS m=1 s12
  0248 GOTO @0237
  0249 COND m=3 0  ; taken already, or past its `#else`: passed too
  0250 GOTO @0260
  0251 IS m=1 s11
  0252 GOTO @0263
  0253 IS m=1 s8
  0254 GOTO @0267
  0255 IS m=1 s9
  0256 GOTO @0277
  0257 IS m=1 s10
  0258 GOTO @0286
  0259 GOTO @0240
  0260 IS m=1 s11
  0261 COND m=5 0
  0262 GOTO @0240
  0263 SKIPLINE 0
  0264 COND m=5 0
  0265 COND m=4 0
  0266 GOTO @0099
  0267 IF m=0 0
  0268 PUSH @0270
  0269 GOTO @0007
  0270 IS m=0 8
  0271 GOTO @0274
  0272 KEEP 0
  0273 GOTO @0268
  0274 IF m=1 0
  0275 GOTO @0295
  0276 GOTO @0240
  0277 LINE 0
  0278 GOTO @0280
  0279 GOTO @0240
  0280 IS m=0 0
  0281 GOTO @0283
  0282 GOTO @0240
  0283 LOOKUP 0
  0284 GOTO @0295
  0285 GOTO @0240
  0286 LINE 0
  0287 GOTO @0289
  0288 GOTO @0295
  0289 IS m=0 0
  0290 GOTO @0292
  0291 GOTO @0295
