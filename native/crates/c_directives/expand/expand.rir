  0276 GOTO @0277
  0277 SKIPLINE 0
  0278 COND m=1 0
  0279 GOTO @0131
  0280 SKIPLINE 0
  0281 COND m=0 0
  0282 GOTO @0310
  ; `#if`: its line expanded, `defined` an operator, then evaluated.
  0283 IF m=0 0
  0284 PUSH @0286
  0285 GOTO @0007
  0286 IS m=0 8
  0287 GOTO @0290
  0288 KEEP 0
  0289 GOTO @0284
  0290 IF m=1 0
  0291 PUSH @0293
  0292 GOTO @0371
  0293 EXPR m=14 0  ; whole, and true
  0294 GOTO @0297
  0295 COND m=0 0
  0296 GOTO @0310
  0297 COND m=1 0
  0298 GOTO @0131
  ; An `#elif…` or `#else` read: its chain was taken, so the rest of it is passed, to its `#endif`.
  0299 COND m=2 0
  0300 GOTO @0303
  0301 SKIPLINE 0  ; no group open: unmatched
  0302 GOTO @0131
  0303 IS m=1 s11
  0304 COND m=5 0
