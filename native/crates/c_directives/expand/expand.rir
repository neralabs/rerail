program - ir=7 grammar=none
; Decision 0348: a translation unit's preprocessing, as preprocessing words (the compiler's
; `pp_words`, which says what each word does). The lean preprocessor's `Pp` is its reference.
; A line ending `; C++ only` is left out of C's program (`expand::program`). Generated from a
; labeled text, the words numbered and their strings listed.
  mode set=0 query=0
  string 0 "("
  string 1 ")"
  string 2 ","
  string 3 "define"
  string 4 "undef"
  string 5 "if"
  string 6 "ifdef"
  string 7 "ifndef"
  string 8 "elif"
  string 9 "elifdef"
  string 10 "elifndef"
  string 11 "else"
  string 12 "endif"
  string 13 "include"
  string 14 "include_next"
  string 15 "import"
  string 16 "pragma"
  string 17 "<<="
  string 18 ">>="
  string 19 "..."
  string 20 "->*"
  string 21 "<=>"
  string 22 "->"
  string 23 "++"
  string 24 "--"
  string 25 "<<"
  string 26 ">>"
  string 27 "<="
  string 28 ">="
  string 29 "=="
  string 30 "!="
  string 31 "&&"
  string 32 "||"
  string 33 "*="
  string 34 "/="
  string 35 "%="
  string 36 "+="
  string 37 "-="
  string 38 "&="
  string 39 "^="
  string 40 "|="
  string 41 "::"
  string 42 ".*"
  string 43 "<:"
  string 44 ":>"
  string 45 "<%"
  string 46 "%>"
  string 47 "%:"
  string 48 "%:%:"
  string 49 "##"
  string 50 "#"
  string 51 "["
  string 52 "]"
  string 53 "{"
  string 54 "}"
  string 55 ";"
  string 56 "~"
  string 57 "?"
  string 58 ":"
  string 59 "."
  string 60 "="
  string 61 "!"
  string 62 "+"
  string 63 "-"
  string 64 "*"
  string 65 "/"
  string 66 "%"
  string 67 "^"
  string 68 "&"
  string 69 "|"
  string 70 "<"
  string 71 ">"
  ppop s17
  ppop s18
  ppop s19
  ppop s20  ; C++ only
  ppop s21  ; C++ only
  ppop s22
  ppop s23
  ppop s24
  ppop s25
  ppop s26
  ppop s27
  ppop s28
  ppop s29
  ppop s30
  ppop s31
  ppop s32
  ppop s33
  ppop s34
  ppop s35
  ppop s36
  ppop s37
  ppop s38
  ppop s39
  ppop s40
  ppop s41
  ppop s42  ; C++ only
  ppop s43
  ppop s44
  ppop s45
  ppop s46
  ppop s47
  ppop s48
  ppop s49
  ppop s50
  ppop s0
  ppop s1
  ppop s51
  ppop s52
  ppop s53
  ppop s54
  ppop s55
  ppop s2
  ppop s56
  ppop s57
  ppop s58
  ppop s59
  ppop s60
  ppop s61
  ppop s62
  ppop s63
  ppop s64
  ppop s65
  ppop s66
  ppop s67
  ppop s68
  ppop s69
  ppop s70
  ppop s71
  ppsuffix  ; C++ only
  ppcpp  ; C++ only
  ; main: the TU's tokens, macros expanded, onto the output tape.
  0000 PUSH @0002
  0001 GOTO @0007
  0002 IS m=0 8  ; EOF
  0003 GOTO @0006
  0004 PUT 0
  0005 GOTO @0000
  0006 ACCEPT 0
  ; one: T <- the next token, macros expanded (lean `Pp::next`).
  0007 PUSH @0009
  0008 GOTO @0067
  0009 IS m=4 0  ; in an `#if`'s line, `defined` is an operator
  0010 GOTO @0014
  0011 LOOKUP 0  ; an identifier, not painted, naming a macro
  0012 GOTO @0017
  0013 RETURN 0
  0014 DEFINED 0
  0015 RETURN 0
  0016 GOTO @0011
  0017 MACRO m=0 0  ; being expanded: painted
  0018 GOTO @0023
  0019 MACRO m=1 0
  0020 GOTO @0025
  0021 FRAME 0  ; object-like
  0022 GOTO @0054
  0023 PAINT 0
  0024 RETURN 0
  0025 PEEK m=1 s0  ; a call only where `(` follows
  0026 GOTO @0028
  0027 RETURN 0
  0028 FRAME 0
  0029 READ 0  ; the `(`
  ; args: the call's arguments, unexpanded, to its `)`.
  0030 PUSH @0032
  0031 GOTO @0067
  0032 IS m=0 8  ; EOF (or a stop source's end): no `)`
  0033 GOTO @0052
  0034 IS m=1 s0
  0035 GOTO @0042
  0036 IS m=1 s1
  0037 GOTO @0044
  0038 IS m=1 s2
  0039 GOTO @0047
  0040 ARG m=0 0
  0041 GOTO @0030
  0042 ARG m=1 0
  0043 GOTO @0030
  0044 ARG m=2 0  ; the call's `)`, at depth 0
  0045 GOTO @0049
  0046 GOTO @0030
  0047 ARG m=3 0
  0048 GOTO @0030
  0049 ARG m=4 0  ; the count right
  0050 GOTO @0054
  0051 RETURN 0  ; else T is the call's name, painted
  0052 ARG m=5 0
  0053 GOTO @0007
  ; pre: each argument substitution expands, expanded in isolation, in the order it asks.
  0054 PRE m=0 0
  0055 GOTO @0057
  0056 GOTO @0065
  0057 PUSH @0059
  0058 GOTO @0007
  0059 IS m=0 8  ; the argument's end
  0060 GOTO @0063
  0061 KEEP 0
  0062 GOTO @0057
  0063 PRE m=1 0
  0064 GOTO @0054
  0065 SUBST 0  ; read next, its macro disabled while it is
  0066 GOTO @0007
  ; raw: T <- the next token, unexpanded; directives carried out as their `#` is read.
  0067 READ 0
  0068 IS m=3 0
  0069 GOTO @0071
  0070 RETURN 0
  0071 LINE 0
  0072 GOTO @0074
  0073 GOTO @0067  ; the null directive
  0074 IS m=1 s3
  0075 GOTO @0120
  0076 IS m=1 s4
  0077 GOTO @0122
  0078 IS m=1 s5
  0079 GOTO @0150
  0080 IS m=1 s6
  0081 GOTO @0124
  0082 IS m=1 s7
  0083 GOTO @0134
  0084 IS m=1 s8
  0085 GOTO @0163
  0086 IS m=1 s9
  0087 GOTO @0163
  0088 IS m=1 s10
  0089 GOTO @0163
  0090 IS m=1 s11
  0091 GOTO @0163
  0092 IS m=1 s12
  0093 GOTO @0171
  0094 IS m=1 s13
  0095 GOTO @0106
  0096 IS m=1 s14
  0097 GOTO @0106
  0098 IS m=1 s15
  0099 GOTO @0106
  0100 IS m=1 s16
  0101 GOTO @0104
  0102 SKIPLINE 0
  0103 GOTO @0067
  0104 PRAGMA 0
  0105 GOTO @0067
  ; An include: its header name as mode (a) read it, or made of its line expanded.
  0106 INCLUDE m=0 0
  0107 GOTO @0118
  0108 IF m=2 0
  0109 PUSH @0111
  0110 GOTO @0007
  0111 IS m=0 8
  0112 GOTO @0115
  0113 KEEP 0
  0114 GOTO @0109
  0115 INCLUDE m=1 0
  0116 GOTO @0118
  0117 GOTO @0067  ; malformed, or a name the host resolves for the next round
  0118 INCLUDE m=2 0
  0119 GOTO @0067
  0120 DEFINE 0
  0121 GOTO @0067
  0122 UNDEF 0
  0123 GOTO @0067
  ; `#ifdef` and `#ifndef`: no name is not defined (the lean pass's reading).
  0124 LINE 0
  0125 GOTO @0128
  0126 COND m=0 0
  0127 GOTO @0174
  0128 IS m=0 0  ; an identifier
  0129 GOTO @0131
  0130 GOTO @0147
  0131 LOOKUP 0
  0132 GOTO @0144
  0133 GOTO @0147
  0134 LINE 0
  0135 GOTO @0138
  0136 COND m=1 0
  0137 GOTO @0067
  0138 IS m=0 0
  0139 GOTO @0141
  0140 GOTO @0144
  0141 LOOKUP 0
  0142 GOTO @0147
  0143 GOTO @0144
  0144 SKIPLINE 0
  0145 COND m=1 0
  0146 GOTO @0067
  0147 SKIPLINE 0
  0148 COND m=0 0
  0149 GOTO @0174
  ; `#if`: its line expanded, `defined` an operator, then evaluated.
  0150 IF m=0 0
  0151 PUSH @0153
  0152 GOTO @0007
  0153 IS m=0 8
  0154 GOTO @0157
  0155 KEEP 0
  0156 GOTO @0151
  0157 IF m=1 0
  0158 GOTO @0161
  0159 COND m=0 0
  0160 GOTO @0174
  0161 COND m=1 0
  0162 GOTO @0067
  ; An `#elif…` or `#else` read: its chain was taken, so the rest of it is passed, to its `#endif`.
  0163 COND m=2 0
  0164 GOTO @0167
  0165 SKIPLINE 0  ; no group open: unmatched
  0166 GOTO @0067
  0167 IS m=1 s11
  0168 COND m=5 0
  0169 SKIPLINE 0
  0170 GOTO @0174
  0171 SKIPLINE 0
  0172 COND m=6 0
  0173 GOTO @0067
  ; skip: a group not taken, passed by its chain to the next directive of it (lean `skip_group`).
  0174 SKIP 0
  0175 READ 0  ; its `#`
  0176 IS m=0 8  ; the file's end, the chain open
  0177 GOTO @0067
  0178 LINE 0
  0179 GOTO @0181
  0180 GOTO @0174
  0181 IS m=1 s12
  0182 GOTO @0171
  0183 COND m=3 0  ; taken already, or past its `#else`: passed too
  0184 GOTO @0194
  0185 IS m=1 s11
  0186 GOTO @0197
  0187 IS m=1 s8
  0188 GOTO @0201
  0189 IS m=1 s9
  0190 GOTO @0211
  0191 IS m=1 s10
  0192 GOTO @0220
  0193 GOTO @0174
  0194 IS m=1 s11
  0195 COND m=5 0
  0196 GOTO @0174
  0197 SKIPLINE 0
  0198 COND m=5 0
  0199 COND m=4 0
  0200 GOTO @0067
  0201 IF m=0 0
  0202 PUSH @0204
  0203 GOTO @0007
  0204 IS m=0 8
  0205 GOTO @0208
  0206 KEEP 0
  0207 GOTO @0202
  0208 IF m=1 0
  0209 GOTO @0229
  0210 GOTO @0174
  0211 LINE 0
  0212 GOTO @0214
  0213 GOTO @0174
  0214 IS m=0 0
  0215 GOTO @0217
  0216 GOTO @0174
  0217 LOOKUP 0
  0218 GOTO @0229
  0219 GOTO @0174
  0220 LINE 0
  0221 GOTO @0223
  0222 GOTO @0229
  0223 IS m=0 0
  0224 GOTO @0226
  0225 GOTO @0229
  0226 LOOKUP 0
  0227 GOTO @0174
  0228 GOTO @0229
  0229 SKIPLINE 0
  0230 COND m=4 0
  0231 GOTO @0067
