  ppop s65
  ppop s66
  ppop s67
  ppop s68
  ppop s69
  ppop s70
  ppop s71
  ppop s72
  ppsuffix  ; C++ only
  ppcpp  ; C++ only
  ; main: the TU's tokens, macros expanded, onto the output tape.
  0000 PUSH @0002
  0001 GOTO @0007
  0002 IS m=0 8  ; EOF
  0003 GOTO @0006
  0004 PUT 0
  0005 GOTO @0000
  0006 ACCEPT 0
  ; one: T <- the next token, macros expanded (lean `Pp::next`).
  0007 PUSH @0009
  0008 GOTO @0099
  0009 IS m=4 0  ; in an `#if`'s line, `defined` is an operator
  0010 GOTO @0014
  0011 LOOKUP 0  ; an identifier, not painted, naming a macro
  0012 GOTO @0017
  0013 RETURN 0
  0014 DEFINED 0
  0015 RETURN 0
  0016 GOTO @0011
  0017 MACRO m=0 0  ; being expanded: painted
  0018 GOTO @0025
  0019 MACRO m=2 0  ; a built-in
  0020 GOTO @0027
  0021 MACRO m=1 0
  0022 GOTO @0057
  0023 FRAME 0  ; object-like
  0024 GOTO @0086
  0025 PAINT 0
  0026 RETURN 0
  ; A built-in: its value, its operand read raw to its `)` (and expanded where it asks).
  0027 MACRO m=1 0
  0028 GOTO @0031
  0029 BUILTIN m=0 0
  0030 RETURN 0
  0031 PEEK m=1 s0
  0032 GOTO @0034
  0033 RETURN 0
  0034 BUILTIN m=1 0  ; an operator here: its operand's level opened
  0035 GOTO @0037
  0036 RETURN 0
  0037 READ 0  ; its `(`
  0038 PUSH @0040
  0039 GOTO @0099
  0040 IS m=0 8
  0041 GOTO @0045
  0042 BUILTIN m=2 0
  0043 GOTO @0045
  0044 GOTO @0038
  0045 BUILTIN m=3 0  ; the operand to be expanded, else T its value
  0046 GOTO @0048
  0047 RETURN 0
  0048 PUSH @0050
  0049 GOTO @0007
  0050 IS m=0 8
  0051 GOTO @0054
  0052 KEEP 0
  0053 GOTO @0048
  0054 BUILTIN m=4 0  ; T its value, or `_Pragma` carried out
  0055 RETURN 0
  0056 GOTO @0007
  0057 PEEK m=1 s0  ; a call only where `(` follows
  0058 GOTO @0060
  0059 RETURN 0
  0060 FRAME 0
  0061 READ 0  ; the `(`
  ; args: the call's arguments, unexpanded, to its `)`.
  0062 PUSH @0064
  0063 GOTO @0099
  0064 IS m=0 8  ; EOF (or a stop source's end): no `)`
  0065 GOTO @0084
  0066 IS m=1 s0
  0067 GOTO @0074
  0068 IS m=1 s1
  0069 GOTO @0076
  0070 IS m=1 s2
  0071 GOTO @0079
  0072 ARG m=0 0
  0073 GOTO @0062
  0074 ARG m=1 0
  0075 GOTO @0062
  0076 ARG m=2 0  ; the call's `)`, at depth 0
  0077 GOTO @0081
  0078 GOTO @0062
  0079 ARG m=3 0
  0080 GOTO @0062
  0081 ARG m=4 0  ; the count right
  0082 GOTO @0086
  0083 RETURN 0  ; else T is the call's name, painted
  0084 ARG m=5 0
  0085 GOTO @0007
  ; pre: each argument substitution expands, expanded in isolation, in the order it asks.
  0086 PRE m=0 0
  0087 GOTO @0089
  0088 GOTO @0097
  0089 PUSH @0091
  0090 GOTO @0007
  0091 IS m=0 8  ; the argument's end
  0092 GOTO @0095
  0093 KEEP 0
  0094 GOTO @0089
  0095 PRE m=1 0
  0096 GOTO @0086
  0097 SUBST 0  ; read next, its macro disabled while it is
  0098 GOTO @0007
  ; raw: T <- the next token, unexpanded; directives carried out as their `#` is read.
  0099 READ 0
  0100 IS m=3 0
  0101 GOTO @0103
  0102 RETURN 0
  0103 LINE 0
  0104 GOTO @0106
  0105 GOTO @0099  ; the null directive
  0106 IS m=0 1  ; a number: GNU's line marker
  0107 GOTO @0140
  0108 IS m=1 s3
  0109 GOTO @0166
  0110 IS m=1 s4
  0111 GOTO @0168
  0112 IS m=1 s5
  0113 GOTO @0196
  0114 IS m=1 s6
  0115 GOTO @0170
  0116 IS m=1 s7
  0117 GOTO @0180
  0118 IS m=1 s8
  0119 GOTO @0209
  0120 IS m=1 s9
  0121 GOTO @0209
  0122 IS m=1 s10
  0123 GOTO @0209
  0124 IS m=1 s11
  0125 GOTO @0209
  0126 IS m=1 s12
  0127 GOTO @0217
  0128 IS m=1 s13
  0129 GOTO @0152
  0130 IS m=1 s14
  0131 GOTO @0152
  0132 IS m=1 s15
  0133 GOTO @0152
  0134 IS m=1 s16
  0135 GOTO @0150
  0136 IS m=1 s17
  0137 GOTO @0141
  0138 SKIPLINE 0
  0139 GOTO @0099
  0140 LINEDIR m=0 0
  0141 IF m=2 0  ; its line expanded
  0142 PUSH @0144
  0143 GOTO @0007
  0144 IS m=0 8
  0145 GOTO @0148
  0146 KEEP 0
  0147 GOTO @0142
  0148 LINEDIR m=1 0
  0149 GOTO @0099
  0150 PRAGMA 0
  0151 GOTO @0099
  ; An include: its header name as mode (a) read it, or made of its line expanded.
  0152 INCLUDE m=0 0
  0153 GOTO @0164
  0154 IF m=2 0
  0155 PUSH @0157
  0156 GOTO @0007
  0157 IS m=0 8
  0158 GOTO @0161
  0159 KEEP 0
  0160 GOTO @0155
  0161 INCLUDE m=1 0
  0162 GOTO @0164
  0163 GOTO @0099  ; malformed, or a name the host resolves for the next round
  0164 INCLUDE m=2 0
  0165 GOTO @0099
  0166 DEFINE 0
  0167 GOTO @0099
  0168 UNDEF 0
  0169 GOTO @0099
  ; `#ifdef` and `#ifndef`: no name is not defined (the lean pass's reading).
  0170 LINE 0
  0171 GOTO @0174
  0172 COND m=0 0
  0173 GOTO @0220
  0174 IS m=0 0  ; an identifier
  0175 GOTO @0177
  0176 GOTO @0193
  0177 LOOKUP 0
  0178 GOTO @0190
  0179 GOTO @0193
  0180 LINE 0
  0181 GOTO @0184
  0182 COND m=1 0
  0183 GOTO @0099
  0184 IS m=0 0
  0185 GOTO @0187
  0186 GOTO @0190
  0187 LOOKUP 0
  0188 GOTO @0193
  0189 GOTO @0190
  0190 SKIPLINE 0
  0191 COND m=1 0
  0192 GOTO @0099
  0193 SKIPLINE 0
  0194 COND m=0 0
  0195 GOTO @0220
  ; `#if`: its line expanded, `defined` an operator, then evaluated.
  0196 IF m=0 0
  0197 PUSH @0199
  0198 GOTO @0007
  0199 IS m=0 8
  0200 GOTO @0203
  0201 KEEP 0
  0202 GOTO @0197
  0203 IF m=1 0
  0204 GOTO @0207
  0205 COND m=0 0
  0206 GOTO @0220
  0207 COND m=1 0
  0208 GOTO @0099
  ; An `#elif…` or `#else` read: its chain was taken, so the rest of it is passed, to its `#endif`.
  0209 COND m=2 0
  0210 GOTO @0213
  0211 SKIPLINE 0  ; no group open: unmatched
  0212 GOTO @0099
  0213 IS m=1 s11
  0214 COND m=5 0
  0215 SKIPLINE 0
  0216 GOTO @0220
  0217 SKIPLINE 0
  0218 COND m=6 0
  0219 GOTO @0099
  ; skip: a group not taken, passed by its chain to the next directive of it (lean `skip_group`).
  0220 SKIP 0
  0221 READ 0  ; its `#`
  0222 IS m=0 8  ; the file's end, the chain open
  0223 GOTO @0099
  0224 LINE 0
  0225 GOTO @0227
  0226 GOTO @0220
  0227 IS m=1 s12
  0228 GOTO @0217
  0229 COND m=3 0  ; taken already, or past its `#else`: passed too
  0230 GOTO @0240
  0231 IS m=1 s11
  0232 GOTO @0243
  0233 IS m=1 s8
  0234 GOTO @0247
  0235 IS m=1 s9
  0236 GOTO @0257
  0237 IS m=1 s10
  0238 GOTO @0266
  0239 GOTO @0220
  0240 IS m=1 s11
  0241 COND m=5 0
  0242 GOTO @0220
  0243 SKIPLINE 0
  0244 COND m=5 0
  0245 COND m=4 0
  0246 GOTO @0099
  0247 IF m=0 0
  0248 PUSH @0250
  0249 GOTO @0007
  0250 IS m=0 8
  0251 GOTO @0254
  0252 KEEP 0
  0253 GOTO @0248
  0254 IF m=1 0
  0255 GOTO @0275
  0256 GOTO @0220
  0257 LINE 0
  0258 GOTO @0260
  0259 GOTO @0220
  0260 IS m=0 0
  0261 GOTO @0263
  0262 GOTO @0220
  0263 LOOKUP 0
  0264 GOTO @0275
  0265 GOTO @0220
  0266 LINE 0
  0267 GOTO @0269
  0268 GOTO @0275
  0269 IS m=0 0
  0270 GOTO @0272
  0271 GOTO @0275
  0272 LOOKUP 0
  0273 GOTO @0220
  0274 GOTO @0275
  0275 SKIPLINE 0
  0276 COND m=4 0
  0277 GOTO @0099
