  ; `#embed`: its name (expanded where it is not spelled), then its parameters expanded, then its
  ; file's bytes.
  0174 EMBED m=0 0
  0175 GOTO @0202
  0176 PUSH @0178
  0177 GOTO @0007
  0178 IS m=0 8
  0179 GOTO @0182
  0180 KEEP 0
  0181 GOTO @0176
  0182 EMBED m=2 0
  0183 EMBED m=3 0  ; a parameter
  0184 GOTO @0188
  0185 EMBED m=7 0  ; the file, its first tokens
