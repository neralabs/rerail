  0049 GOTO @0007
  0050 IS m=0 8
  0051 GOTO @0054
  0052 KEEP 0
  0053 GOTO @0048
  0054 BUILTIN m=4 0  ; T its value, or `_Pragma` carried out
  0055 RETURN 0
  0056 GOTO @0007
  0057 PEEK m=1 s0  ; a call only where `(` follows
  0058 GOTO @0060
  0059 RETURN 0
  0060 FRAME 0
  0061 READ 0  ; the `(`
  ; args: the call's arguments, unexpanded, to its `)`.
  0062 PUSH @0064
  0063 GOTO @0131
  0064 IS m=0 8  ; EOF (or a stop source's end): no `)`
  0065 GOTO @0084
  0066 IS m=1 s0
  0067 GOTO @0074
  0068 IS m=1 s1
  0069 GOTO @0076
  0070 IS m=1 s2
  0071 GOTO @0079
  0072 ARG m=0 0
  0073 GOTO @0062
  0074 ARG m=1 0
  0075 GOTO @0062
  0076 ARG m=2 0  ; the call's `)`, at depth 0
  0077 GOTO @0081
  0078 GOTO @0062
  0079 ARG m=3 0
  0080 GOTO @0062
  0081 ARG m=4 0  ; the count right
  0082 GOTO @0086
  0083 RETURN 0  ; else T is the call's name, painted
  0084 ARG m=5 0
  0085 GOTO @0007
  ; pre: each argument substitution expands, expanded in isolation, in the order it asks.
  0086 PRE m=0 0
  0087 GOTO @0089
  0088 GOTO @0097
  0089 PUSH @0091
  0090 GOTO @0007
  0091 IS m=0 8  ; the argument's end
  0092 GOTO @0095
  0093 KEEP 0
  0094 GOTO @0089
  0095 PRE m=1 0
  0096 GOTO @0086
  ; subst: the top frame's body substituted, a body token a turn (`SUB`), its `__VA_OPT__`s'
  ; contents walked in place, `#`'s literals made a token a turn (`STR`), then its pastes (`GLUE`);
  ; then read, its macro disabled while it is.
  0097 SUB m=0 0
  0098 SUB m=1 0  ; the body's next token, B
  0099 GOTO @0107
  0100 SUB m=7 0  ; a __VA_OPT__'s content ended
  0101 GOTO @0120
  0102 SUB m=9 0  ; the output's pastes
  0103 GLUE 0
  0104 GOTO @0103
  0105 SUB m=10 0
  0106 GOTO @0007
  0107 SUB m=2 0  ; `#` and a parameter
  0108 GOTO @0115
  0109 SUB m=3 0  ; `#__VA_OPT__(`
  0110 GOTO @0098
  0111 SUB m=4 0  ; `__VA_OPT__(`
  0112 GOTO @0098
  0113 SUB m=5 0  ; a parameter's argument, or B
  0114 GOTO @0098
  0115 STR m=0 0
  0116 STR m=1 0
  0117 GOTO @0116
  0118 STR m=2 0
  0119 GOTO @0098
  0120 SUB m=6 0  ; a `#__VA_OPT__`'s content: pasted, then stringized
  0121 GOTO @0123
  0122 GOTO @0098
  0123 GLUE 0
  0124 GOTO @0123
  0125 SUB m=8 0
  0126 STR m=0 0
  0127 STR m=1 0
  0128 GOTO @0127
  0129 STR m=3 0
  0130 GOTO @0098
  ; raw: T <- the next token, unexpanded; directives carried out as their `#` is read.
  0131 READ 0
  0132 IS m=3 0
  0133 GOTO @0135
  0134 RETURN 0
  0135 LINE 0
  0136 GOTO @0138
  0137 GOTO @0131  ; the null directive
  0138 IS m=0 1  ; a number: GNU's line marker
  0139 GOTO @0210
  0140 IS m=1 s3
  0141 GOTO @0236
  0142 IS m=1 s4
  0143 GOTO @0255
  0144 IS m=1 s5
  0145 GOTO @0283
  0146 IS m=1 s6
  0147 GOTO @0257
  0148 IS m=1 s7
  0149 GOTO @0267
  0150 IS m=1 s8
  0151 GOTO @0299
  0152 IS m=1 s9
  0153 GOTO @0299
  0154 IS m=1 s10
  0155 GOTO @0299
  0156 IS m=1 s11
  0157 GOTO @0299
  0158 IS m=1 s12
  0159 GOTO @0307
  0160 IS m=1 s13
  0161 GOTO @0222
  0162 IS m=1 s14
  0163 GOTO @0222
  0164 IS m=1 s15
  0165 GOTO @0222
  0166 IS m=1 s16
  0167 GOTO @0220
  0168 IS m=1 s17
  0169 GOTO @0211
  0170 IS m=1 s18
  0171 GOTO @0174
  0172 SKIPLINE 0
