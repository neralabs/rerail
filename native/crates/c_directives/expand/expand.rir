  0204 IS m=0 8
  0205 GOTO @0208
  0206 KEEP 0
  0207 GOTO @0202
  0208 EMBED m=1 0
  0209 GOTO @0176
  0210 LINEDIR m=0 0
  0211 IF m=2 0  ; its line expanded
  0212 PUSH @0214
  0213 GOTO @0007
  0214 IS m=0 8
  0215 GOTO @0218
  0216 KEEP 0
  0217 GOTO @0212
  0218 LINEDIR m=1 0
  0219 GOTO @0131
  0220 PRAGMA 0
  0221 GOTO @0131
  ; An include: its header name as mode (a) read it, or made of its line expanded.
  0222 INCLUDE m=0 0
  0223 GOTO @0234
  0224 IF m=2 0
  0225 PUSH @0227
  0226 GOTO @0007
  0227 IS m=0 8
  0228 GOTO @0231
  0229 KEEP 0
  0230 GOTO @0225
  0231 INCLUDE m=1 0
