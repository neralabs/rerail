  ; skip: a group not taken, passed by its chain to the next directive of it (lean `skip_group`).
  0310 SKIP 0
  0311 READ 0  ; its `#`
  0312 IS m=0 8  ; the file's end, the chain open
  0313 GOTO @0131
  0314 LINE 0
  0315 GOTO @0317
  0316 GOTO @0310
  0317 IS m=1 s12
  0318 GOTO @0307
  0319 COND m=3 0  ; taken already, or past its `#else`: passed too
  0320 GOTO @0330
  0321 IS m=1 s11
  0322 GOTO @0333
  0323 IS m=1 s8
  0324 GOTO @0337
  0325 IS m=1 s9
  0326 GOTO @0350
  0327 IS m=1 s10
  0328 GOTO @0359
  0329 GOTO @0310
  0330 IS m=1 s11
  0331 COND m=5 0
  0332 GOTO @0310
  0333 SKIPLINE 0
  0334 COND m=5 0
  0335 COND m=4 0
  0336 GOTO @0131
