; main: the TU's tokens, macros expanded, onto the output tape.
main:   PUSH @m1
        GOTO @one
m1:     IS m=0 8          ; EOF
        GOTO @end
        PUT 0
        GOTO @main
end:    ACCEPT 0
; one: T <- the next token, macros expanded (lean `Pp::next`).
one:    PUSH @o1
        GOTO @raw
o1:     IS m=4 0          ; in an `#if`'s line, `defined` is an operator
        GOTO @odef
o2:     LOOKUP 0          ; an identifier, not painted, naming a macro
        GOTO @found
        RETURN 0
odef:   DEFINED 0
        RETURN 0
        GOTO @o2
found:  MACRO m=0 0       ; being expanded: painted
        GOTO @paint
        MACRO m=1 0
        GOTO @fn
        FRAME 0           ; object-like
        GOTO @pre
paint:  PAINT 0
        RETURN 0
fn:     PEEK m=1 "("      ; a call only where `(` follows
        GOTO @call
        RETURN 0
call:   FRAME 0
        READ 0            ; the `(`
; args: the call's arguments, unexpanded, to its `)`.
args:   PUSH @a1
        GOTO @raw
a1:     IS m=0 8          ; EOF (or a stop source's end): no `)`
        GOTO @unterm
        IS m=1 "("
        GOTO @open
        IS m=1 ")"
        GOTO @close
        IS m=1 ","
        GOTO @comma
        ARG m=0 0
        GOTO @args
open:   ARG m=1 0
        GOTO @args
close:  ARG m=2 0         ; the call's `)`, at depth 0
        GOTO @done
        GOTO @args
comma:  ARG m=3 0
        GOTO @args
done:   ARG m=4 0         ; the count right
        GOTO @pre
        RETURN 0          ; else T is the call's name, painted
unterm: ARG m=5 0
        GOTO @one
; pre: each argument substitution expands, expanded in isolation, in the order it asks.
pre:    PRE m=0 0
        GOTO @pl
        GOTO @subst
pl:     PUSH @p1
        GOTO @one
p1:     IS m=0 8          ; the argument's end
        GOTO @pend
        KEEP 0
        GOTO @pl
pend:   PRE m=1 0
        GOTO @pre
subst:  SUBST 0           ; read next, its macro disabled while it is
        GOTO @one
; raw: T <- the next token, unexpanded; directives carried out as their `#` is read.
raw:    READ 0
        IS m=3 0
        GOTO @dir
        RETURN 0
dir:    LINE 0
        GOTO @named
        GOTO @raw         ; the null directive
named:  IS m=1 "define"
        GOTO @def
        IS m=1 "undef"
        GOTO @undef
        IS m=1 "if"
        GOTO @if
        IS m=1 "ifdef"
        GOTO @ifdef
        IS m=1 "ifndef"
        GOTO @ifndef
        IS m=1 "elif"
        GOTO @chain
        IS m=1 "elifdef"
        GOTO @chain
        IS m=1 "elifndef"
        GOTO @chain
        IS m=1 "else"
        GOTO @chain
        IS m=1 "endif"
        GOTO @endif
        IS m=1 "include"
        GOTO @inc
        IS m=1 "include_next"
        GOTO @inc
        IS m=1 "import"
        GOTO @inc
        IS m=1 "pragma"
        GOTO @pragma
        SKIPLINE 0
        GOTO @raw
pragma: PRAGMA 0
        GOTO @raw
; An include: its header name as mode (a) read it, or made of its line expanded.
inc:    INCLUDE m=0 0
        GOTO @enter
        IF m=2 0
hl:     PUSH @h1
        GOTO @one
h1:     IS m=0 8
        GOTO @he
        KEEP 0
        GOTO @hl
he:     INCLUDE m=1 0
        GOTO @enter
        GOTO @raw         ; malformed, or a name the host resolves for the next round
enter:  INCLUDE m=2 0
        GOTO @raw
def:    DEFINE 0
        GOTO @raw
undef:  UNDEF 0
        GOTO @raw
; `#ifdef` and `#ifndef`: no name is not defined (the lean pass's reading).
ifdef:  LINE 0
        GOTO @ifd1
        COND m=0 0
        GOTO @skip
ifd1:   IS m=0 0          ; an identifier
        GOTO @ifd2
        GOTO @untaken
ifd2:   LOOKUP 0
        GOTO @taken
        GOTO @untaken
ifndef: LINE 0
        GOTO @ifn1
        COND m=1 0
        GOTO @raw
ifn1:   IS m=0 0
        GOTO @ifn2
        GOTO @taken
ifn2:   LOOKUP 0
        GOTO @untaken
        GOTO @taken
taken:  SKIPLINE 0
        COND m=1 0
        GOTO @raw
untaken: SKIPLINE 0
        COND m=0 0
        GOTO @skip
; `#if`: its line expanded, `defined` an operator, then evaluated.
if:     IF m=0 0
il:     PUSH @i1
        GOTO @one
i1:     IS m=0 8
        GOTO @ie
        KEEP 0
        GOTO @il
ie:     IF m=1 0
        GOTO @iftrue
        COND m=0 0
        GOTO @skip
iftrue: COND m=1 0
        GOTO @raw
; An `#elif…` or `#else` read: its chain was taken, so the rest of it is passed, to its `#endif`.
chain:  COND m=2 0
        GOTO @ch1
        SKIPLINE 0        ; no group open: unmatched
        GOTO @raw
ch1:    IS m=1 "else"
        COND m=5 0
        SKIPLINE 0
        GOTO @skip
endif:  SKIPLINE 0
        COND m=6 0
        GOTO @raw
; skip: a group not taken, passed by its chain to the next directive of it (lean `skip_group`).
skip:   SKIP 0
        READ 0            ; its `#`
        IS m=0 8          ; the file's end, the chain open
        GOTO @raw
        LINE 0
        GOTO @sk1
        GOTO @skip
sk1:    IS m=1 "endif"
        GOTO @endif
        COND m=3 0        ; taken already, or past its `#else`: passed too
        GOTO @skon
        IS m=1 "else"
        GOTO @skelse
        IS m=1 "elif"
        GOTO @skelif
        IS m=1 "elifdef"
        GOTO @skedef
        IS m=1 "elifndef"
        GOTO @skendef
        GOTO @skip
skon:   IS m=1 "else"
        COND m=5 0
        GOTO @skip
skelse: SKIPLINE 0
        COND m=5 0
        COND m=4 0
        GOTO @raw
skelif: IF m=0 0
sel:    PUSH @se1
        GOTO @one
se1:    IS m=0 8
        GOTO @see
        KEEP 0
        GOTO @sel
see:    IF m=1 0
        GOTO @sktake
        GOTO @skip
skedef: LINE 0
        GOTO @sed1
        GOTO @skip
sed1:   IS m=0 0
        GOTO @sed2
        GOTO @skip
sed2:   LOOKUP 0
        GOTO @sktake
        GOTO @skip
skendef: LINE 0
        GOTO @sen1
        GOTO @sktake
sen1:   IS m=0 0
        GOTO @sen2
        GOTO @sktake
sen2:   LOOKUP 0
        GOTO @skip
        GOTO @sktake
sktake: SKIPLINE 0
        COND m=4 0
        GOTO @raw
