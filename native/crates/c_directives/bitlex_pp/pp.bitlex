# The preprocessor tape (decision 0436): every preprocessing token of a C or C++ file a leaf, once
# and in order, and over them the directives (named by their word, their operands as fields),
# the conditional groups and the lines of text (`code`). The lean writer of the same tape,
# `rerail_c_pp::tape::image`, is its reference: a file this grammar reads gives the same bytes,
# and one it does not read goes to the lean writer.
#
# The lexer is `bitlex_tokens/tokens.bitlex`'s (the tokens, their kinds, what it refuses); the
# tree is `bitlex_ladder/06-raw.bitlex`'s, over those tokens:
#
#   #  define  F(a)  a + 1
#   ^  ^^^^^^  ^^^^  ^^^^^ hash, its word (an identifier), params: params, body: operands
#
# Where the tree must tell tokens of one kind apart, a soft keyword names them there only (a
# word, `(`, `)`, `,`, `<`, `>`, `...`) and `as` gives the leaf its kind again. What the lexer
# alone knows is a hidden mark: a `(` touching a macro's name, a header's `"`.

lexer c_pp

class dquote    = '"'
class squote    = '\''
class backslash = '\\'
class lf        = '\n'
class cr        = '\r'
class blankc    = ' ' '\t' 0x0b 0x0c
class slash     = '/'
class star      = '*'
class hash      = '#'
class qmark     = '?'
# The trigraphs' third bytes: a configuration may read `??=` as `#`.
class tri       = '=' '/' '\'' '(' ')' '!' '<' '>' '-'
class percent   = '%'
class colon     = ':'
class c_r       = 'R'
class c_pre     = 'L' 'U' 'u'
class c_u       = 'u'
class c_8       = '8'
class rparen    = ')'
class bom1      = 0xef
class bom2      = 0xbb
class bom3      = 0xbf
class digit     = '0'..'9'
class lparen    = '('
class dot       = '.'
# ASCII only: a byte past it in code is refused (below), a byte order mark's included.
class idstart   = 'a'..'z' 'A'..'Z' '_' '$'
class wordc     = 'a'..'z' 'A'..'Z' '0'..'9' '_' '$'

mask last_byte  = ~next(~empty)
mask first_byte = ~prev(~empty)

# --- What the step hands over ------------------------------------------------------------------

escape "a carriage return not before a line break" when cr & ~next(lf)
escape "a trigraph" when qmark & next(qmark) & next(tri, 2)
escape "a digraph `%:`" when percent & next(colon)

# --- Splices and regions -----------------------------------------------------------------------

# A `\` right before a line break splices the two lines (phase 2): neither byte is in a token.
# Or a `\` before `\r\n`: the three bytes.
mask splice_bs  = backslash & (next(lf) | (next(cr) & next(lf, 2)))
mask splice_cr  = cr & prev(backslash) & next(lf)
mask splice_lf  = lf & (prev(backslash) | (prev(cr) & prev(backslash, 2)))
mask splice     = splice_bs | splice_cr | splice_lf
# A line's end: a line break no `\` splices.
mask nl         = lf & ~splice_lf
# A `\`, blanks, then a line break: clang's and GCC's splice too, which this step does not read.
mask bs_blanks  = fill(backslash & next(blankc), blankc)
escape "a splice with blanks before its line break" when (lf & prev(bs_blanks) & prev(blankc)) | (lf & prev(cr) & prev(bs_blanks, 2) & prev(blankc, 2))
escape "a splice inside a word" when splice_bs & prev(wordc) & (next(wordc, 2) | (next(cr) & next(wordc, 3)))
escape "a splice inside a comment's opener" when slash & next(backslash) & (next(lf, 2) | (next(cr, 2) & next(lf, 3)))

# A raw string's `"`: after an `R` that starts its word, or after `L`, `U`, `u` or `u8` that do,
# with a `(` next (no delimiter).
mask r_alone    = c_r & ~prev(wordc)
mask r_pre      = c_r & prev(c_pre) & ~prev(wordc, 2)
mask r_u8       = c_r & prev(c_8) & prev(c_u, 2) & ~prev(wordc, 3)
mask raw_open   = dquote & next(lparen) & prev(r_alone | r_pre | r_u8)
# Its end: the first `)"` (a `\` is no escape in it).
mask raw_close  = dquote & prev(rparen)
mask escaped    = escaped(backslash)
mask q          = dquote & ~escaped
# A digit separator (C23, C++14): a `'` in a pp-number before a letter, a digit or `_`
# (`1'000'000`, `0x'1`). The regions need it first, as no quote: so it is found from a run of
# numbers made without them, and checked against the numbers below (an escape where the two
# differ).
class sep_after = 'a'..'z' 'A'..'Z' '0'..'9' '_'
class c_exp     = 'e' 'E' 'p' 'P'
class sign      = '+' '-'
mask sep_cand   = squote & next(sep_after)
# A number starts at a digit no word byte, `.`, `'` or `\` is before, or at a `.` before a digit.
mask sep_start  = (digit & ~prev(wordc | dot | squote | backslash)) | (dot & next(digit))
mask sep_run    = fill(sep_start, ~(wordc | dot | (sign & prev(c_exp)) | sep_cand))
mask sep        = sep_cand & prev(sep_run)
mask sq         = squote & ~escaped & ~sep
mask line_open  = slash & next(slash)
mask block_open = slash & next(star)
# `*/`'s `/`, but not the `/` of `/*/`.
mask block_end  = slash & prev(star) & ~prev(block_open, 2)
# The regions, left to right: strings, character constants and comments hide each other's
# openers. A line comment's line break ends its line; a spliced one does not end the comment.
regions hidden {
  raw   = raw_open .. raw_close
  str   = q .. q | nl
  chr   = sq .. sq | nl
  line  = line_open .. nl outside
  block = block_open .. block_end
}
# A string or a character constant a line break closes (`don't`): the lean scan ends its token
# before the break.
escape "a string or a character constant open at a line's end" when nl & prev(f_str | f_chr)
escape "a block comment open at the end of the file" when f_block & last_byte
escape "a raw string open at the end of the file" when f_raw & last_byte
# Phase 2's splices are undone inside a raw string: not read here.
escape "a splice inside a raw string" when splice_bs & f_raw
escape "a string open at the end of the file" when (f_str | f_chr) & last_byte

mask region     = hidden | o_raw | o_str | o_chr | o_line | o_block
mask code       = ~region
escape "a raw string with a delimiter" when o_str & prev(c_r)

# A comment's bytes, its `*/` too: a blank, as the lexer reads it.
mask comment    = f_line | f_block | (block_end & prev(f_block))
# A UTF-8 byte order mark at the file's start, which the lean scan skips: a blank.
mask bom        = first_byte & bom1 & next(bom2) & next(bom3, 2)
mask bom_bytes  = bom | prev(bom) | prev(bom, 2)
# A `\r` before a line break: a blank (phase 1 makes the pair one new-line).
mask blank      = (code & blankc) | (cr & next(lf)) | comment | splice | bom_bytes

# --- What this grammar hands over too ------------------------------------------------------------

class high      = 0x80..0xff
escape "a byte past ASCII in code" when code & high & ~bom_bytes
class ucn_u     = 'u' 'U'
mask lone_bs    = code & backslash & ~splice_bs
escape "a `\u` or `\U` in code" when lone_bs & next(ucn_u)
# A splice with code right before it and right after it: the lean lexer reads the two as one text.
mask solid      = code & ~blank & ~lf & ~cr
escape "a splice between two tokens' bytes" when splice_bs & prev(solid) & (next(solid, 2) | (next(cr) & next(solid, 3)))
escape "C++'s `<::`" when code & lt & next(colon) & next(colon, 2)   # C++ only

# --- Directives ----------------------------------------------------------------------------------

# A line's end for the lexer's `BOL`: a line break outside a block comment and a raw string.
mask eol        = nl & ~f_block & ~f_raw
mask gap        = blank | nl
# A byte with only blanks since a line's end (or the file's start): where a token has `BOL`.
mask bol_at     = first_byte | prev(fill(eol | (first_byte & gap), ~gap))
# A directive's `#`: a `#` token (no `##`) with `BOL`, as the lean scan finds it.
mask dir_hash   = code & hash & bol_at & ~next(hash)
# A directive's line: from its `#` to its line's end (a line break in a block comment aside).
mask dir_line   = fill(dir_hash, eol)
mask dir_end    = eol & prev(dir_line)
# A directive's word's first byte: after its `#` and the blanks after it.
mask hash_lead  = fill(dir_hash, ~(blank | hash))
mask word0      = code & prev(hash_lead) & ~hash_lead
class c_i       = 'i'
class c_f       = 'f'
class c_d       = 'd'
class c_e       = 'e'
class c_n       = 'n'
class c_l       = 'l'
class c_s       = 's'
# The conditional words, each a whole word, at a directive's word's first byte.
mask w_if       = word0 & c_i & next(c_f)
mask w_elif     = word0 & c_e & next(c_l) & next(c_i, 2) & next(c_f, 3)
mask wk_if      = (w_if & ~next(wordc, 2))
                | (w_if & next(c_d, 2) & next(c_e, 3) & next(c_f, 4) & ~next(wordc, 5))
                | (w_if & next(c_n, 2) & next(c_d, 3) & next(c_e, 4) & next(c_f, 5) & ~next(wordc, 6))
mask wk_next    = (w_elif & ~next(wordc, 4))
                | (w_elif & next(c_d, 4) & next(c_e, 5) & next(c_f, 6) & ~next(wordc, 7))
                | (w_elif & next(c_n, 4) & next(c_d, 5) & next(c_e, 6) & next(c_f, 7) & ~next(wordc, 8))
                | (word0 & c_e & next(c_l) & next(c_s, 2) & next(c_e, 3) & ~next(wordc, 4))
mask wk_end     = word0 & c_e & next(c_n) & next(c_d, 2) & next(c_i, 3) & next(c_f, 4) & ~next(wordc, 5)
# Each at its directive's `#`: the word 16 bytes after it at most, every byte between a blank
# of its lead (`lead_k`: the `k` bytes after the `#` are).
mask lead_bl    = hash_lead & ~hash
mask lead_1      = next(lead_bl, 1)
mask lead_2      = lead_1 & next(lead_bl, 2)
mask lead_3      = lead_2 & next(lead_bl, 3)
mask lead_4      = lead_3 & next(lead_bl, 4)
mask lead_5      = lead_4 & next(lead_bl, 5)
mask lead_6      = lead_5 & next(lead_bl, 6)
mask lead_7      = lead_6 & next(lead_bl, 7)
mask lead_8      = lead_7 & next(lead_bl, 8)
mask lead_9      = lead_8 & next(lead_bl, 9)
mask lead_10     = lead_9 & next(lead_bl, 10)
mask lead_11     = lead_10 & next(lead_bl, 11)
mask lead_12     = lead_11 & next(lead_bl, 12)
mask lead_13     = lead_12 & next(lead_bl, 13)
mask lead_14     = lead_13 & next(lead_bl, 14)
mask lead_15     = lead_14 & next(lead_bl, 15)
escape "a directive's word far from its `#`" when word0 & ~nl & ~(prev(dir_hash, 1) | prev(dir_hash, 2) | prev(dir_hash, 3) | prev(dir_hash, 4) | prev(dir_hash, 5) | prev(dir_hash, 6) | prev(dir_hash, 7) | prev(dir_hash, 8) | prev(dir_hash, 9) | prev(dir_hash, 10) | prev(dir_hash, 11) | prev(dir_hash, 12) | prev(dir_hash, 13) | prev(dir_hash, 14) | prev(dir_hash, 15) | prev(dir_hash, 16))
mask at_if      = dir_hash & (next(wk_if, 1)
                  | (lead_1 & next(wk_if, 2))
                  | (lead_2 & next(wk_if, 3))
                  | (lead_3 & next(wk_if, 4))
                  | (lead_4 & next(wk_if, 5))
                  | (lead_5 & next(wk_if, 6))
                  | (lead_6 & next(wk_if, 7))
                  | (lead_7 & next(wk_if, 8))
                  | (lead_8 & next(wk_if, 9))
                  | (lead_9 & next(wk_if, 10))
                  | (lead_10 & next(wk_if, 11))
                  | (lead_11 & next(wk_if, 12))
                  | (lead_12 & next(wk_if, 13))
                  | (lead_13 & next(wk_if, 14))
                  | (lead_14 & next(wk_if, 15))
                  | (lead_15 & next(wk_if, 16)))
mask at_next    = dir_hash & (next(wk_next, 1)
                  | (lead_1 & next(wk_next, 2))
                  | (lead_2 & next(wk_next, 3))
                  | (lead_3 & next(wk_next, 4))
                  | (lead_4 & next(wk_next, 5))
                  | (lead_5 & next(wk_next, 6))
                  | (lead_6 & next(wk_next, 7))
                  | (lead_7 & next(wk_next, 8))
                  | (lead_8 & next(wk_next, 9))
                  | (lead_9 & next(wk_next, 10))
                  | (lead_10 & next(wk_next, 11))
                  | (lead_11 & next(wk_next, 12))
                  | (lead_12 & next(wk_next, 13))
                  | (lead_13 & next(wk_next, 14))
                  | (lead_14 & next(wk_next, 15))
                  | (lead_15 & next(wk_next, 16)))
mask at_end     = dir_hash & (next(wk_end, 1)
                  | (lead_1 & next(wk_end, 2))
                  | (lead_2 & next(wk_end, 3))
                  | (lead_3 & next(wk_end, 4))
                  | (lead_4 & next(wk_end, 5))
                  | (lead_5 & next(wk_end, 6))
                  | (lead_6 & next(wk_end, 7))
                  | (lead_7 & next(wk_end, 8))
                  | (lead_8 & next(wk_end, 9))
                  | (lead_9 & next(wk_end, 10))
                  | (lead_10 & next(wk_end, 11))
                  | (lead_11 & next(wk_end, 12))
                  | (lead_12 & next(wk_end, 13))
                  | (lead_13 & next(wk_end, 14))
                  | (lead_14 & next(wk_end, 15))
                  | (lead_15 & next(wk_end, 16)))
mask plain_dir  = dir_hash & ~at_if & ~at_next & ~at_end

# --- Numbers -------------------------------------------------------------------------------------

class lt        = '<'
# A pp-number goes on over word bytes, `.`, a sign after `e`, `E`, `p` or `P`, and a digit
# separator.
mask num_cont   = code & (wordc | dot | (sign & prev(c_exp)) | sep)
# It starts at a digit after no word byte or `.`, or at a `.` before a digit that no number
# before reaches (`a.5` is `a` and `.5`; `1.5.6` one number): twice, then settled or refused.
# A digit after an exponent's sign is no start where the sign is a number's (`1e+3`), and is one
# where it is not (`e+3`).
mask dig_cand   = code & digit & ~prev(code & (wordc | dot | sep))
mask num_c      = fill(dig_cand, ~num_cont)
mask dig_head   = dig_cand & ~prev(num_c & sign)
mask dot_cand   = code & dot & next(digit)
mask num0       = fill(dig_head, ~num_cont)
mask dot_head1  = dot_cand & ~prev(num0)
mask num1       = fill(dig_head | dot_head1, ~num_cont)
mask dot_head   = dot_cand & ~prev(num1)
mask number_b   = fill(dig_head | dot_head, ~num_cont)
mask dot_head3  = dot_cand & ~prev(number_b)
escape "a run of numbers and dots past the bound" when dot_head ^ dot_head3
mask num_start  = dig_head | dot_head
# The separators found before the regions, against the numbers: one inside a character
# constant (`'.5'a`, its closer taken for one), a `'` the numbers would take that was none, or
# one no number reaches.
escape "a digit separator the regions do not read" when (sep & f_chr) | (code & sep_cand & prev(number_b) & ~sep) | (code & sep & ~prev(number_b))

# --- Literals ------------------------------------------------------------------------------------

# A literal's prefix starts a word and ends at its opener: `L`, `u`, `U`, `u8`, then `R` before a
# raw string's.
mask o_q        = o_str | o_chr
mask p_one      = c_pre & next(o_q) & ~prev(wordc)
mask p_u8       = c_u & next(c_8) & next(o_q, 2) & ~prev(wordc)
mask p_r        = c_r & next(o_raw) & ~prev(wordc)
mask p_one_r    = c_pre & next(c_r) & next(o_raw, 2) & ~prev(wordc)
mask p_u8_r     = c_u & next(c_8) & next(c_r, 2) & next(o_raw, 3) & ~prev(wordc)
mask pre_start  = code & (p_one | p_u8 | p_r | p_one_r | p_u8_r)
mask opener     = o_q | o_raw
mask pre_bytes  = fill(pre_start, opener)
mask lit_start  = pre_start | (opener & ~prev(pre_bytes))
# Its closer: a string's or a character constant's quote, a raw string's `"`.
mask closer     = (q & prev(f_str)) | (sq & prev(f_chr)) | (raw_close & prev(f_raw))
mask lit_body   = pre_bytes | f_str | f_chr | f_raw | closer
# C++'s user-defined suffix: a word right after its closer.
mask suffix     = empty   # C only
mask suffix     = code & wordc & fill(closer & next(idstart), ~(code & wordc)) & ~closer   # C++ only
mask lit_bytes  = lit_body | suffix

# --- Tokens --------------------------------------------------------------------------------------

mask word       = code & wordc
mask id_start   = word & idstart & ~prev(word) & ~number_b & ~pre_bytes & ~suffix
token identifier = start id_start run word
token number     = start num_start run num_cont
# Its own kind's next start ends it (`"a""b"` is two): a run holds no start of its kind.
token literal    = start lit_start run lit_bytes & ~lit_start

class opc       = '(' ')' '[' ']' '{' '}' ';' ',' '~' '?' ':' '.' '=' '!' '+' '-' '*' '/' '%' '^' '&' '|' '<' '>' '#'
munch op over code & opc & ~number_b {
  "<<=" -> punct ">>=" -> punct "..." -> punct
  "->*" -> punct "<=>" -> punct   # C++ only
  "->" -> punct "++" -> punct "--" -> punct "<<" -> punct ">>" -> punct "<=" -> punct ">=" -> punct "==" -> punct "!=" -> punct
  "&&" -> punct "||" -> punct "*=" -> punct "/=" -> punct "%=" -> punct "+=" -> punct "-=" -> punct "&=" -> punct "^=" -> punct "|=" -> punct "::" -> punct
  ".*" -> punct   # C++ only
  "<:" -> digraph ":>" -> digraph "<%" -> digraph "%>" -> digraph
  "##" -> hashhash "#" -> hash
  "(" -> punct ")" -> punct "[" -> punct "]" -> punct "{" -> punct "}" -> punct ";" -> punct "," -> punct "~" -> punct "?" -> punct ":" -> punct "." -> punct "=" -> punct "!" -> punct "+" -> punct "-" -> punct "*" -> punct "/" -> punct "%" -> punct "^" -> punct "&" -> punct "|" -> punct "<" -> punct ">" -> punct
}

class otherc    = 0x00..0x08 0x0e..0x1f '@' '`' 0x7f
token other      = start (code & otherc) | lone_bs

keywords identifier { } soft { "define" "undef" "include" "include_next" "import" "embed" "if" "ifdef" "ifndef" "elif" "elifdef" "elifndef" "else" "endif" "line" "error" "warning" "pragma" "ident" "sccs" "assert" "unassert" }
keywords punct { } soft { "(" ")" "," "<" ">" "..." }

skip blank | (nl & code)

mask starts     = id_start | num_start | lit_start | munch_op_win3 | (code & otherc) | lone_bs
# A directive's end: its line's end, or the file's. Hidden: a line break after the last
# directive gives the file's end a second.
mark eol_mark = dir_end, end
hidden eol_mark
# A `(` touching the word before it: a function-like macro's parameters, after its name.
mark touch    = code & lparen & prev(code & wordc) & dir_line
hidden touch
# A literal that opens with `"` (no prefix) on a directive's line: a quoted header, a line's file.
mark qstr     = lit_start & dquote & dir_line
hidden qstr
# A line of text's first token: the tokens with `BOL` but a directive's `#`.
mark cline    = starts & bol_at & ~dir_hash
# A directive whose word is no conditional one; a conditional one, by its word after the `#`.
mark dline    = plain_dir
mark if_on    = at_if
mark next_on  = at_next
mark end_on   = at_end

# --- The tree ------------------------------------------------------------------------------------

tree c_pp {
  # The items, inline (a choice of them would be a level the parser calls, and leaves only at a
  # token): an `#elif…`, `#else` or `#endif` no group is open for is a directive (the lean scan's
  # unmatched).
  node pp whole = (if_on group | next_on directive | end_on directive | dline directive | cline code)*
  # Its opener, the items in its first branch, each further branch (an `#elif…` or `#else`, then
  # its items), and its `#endif`. A file that does not close a group is refused.
  node group nested = directive (if_on group | dline directive | cline code)* (next_on directive (if_on group | dline directive | cline code)*)* end_on directive
  # A line of text: its tokens, to the next line's first or a directive.
  node code = tok (tok)*
  choice tok = identifier | number | literal | punct | digraph | hash | hashhash | other
  # A directive's node is `unknown` until its word names it.
  node unknown = hash (retag null eol_mark | named)
  choice directive = unknown
  # Each directive's tail takes its line's end itself (a called level ends at a token it takes),
  # and takes a token first (a level that returns with none is refused): a directive with no
  # operands is its word, then its line's end.
  choice named = retag define ('define' as identifier) (define_tail | eol_mark)
               | retag undef ('undef' as identifier) (name: identifier (any)* eol_mark | not_ident (any)* eol_mark | eol_mark)
               | retag include ('include' as identifier) (include_tail | eol_mark)
               | retag include_next ('include_next' as identifier) (include_tail | eol_mark)
               | retag import ('import' as identifier) (include_tail | eol_mark)
               | retag embed ('embed' as identifier) (include_tail | eol_mark)
               | retag if ('if' as identifier) (cond_tail | eol_mark) | retag ifdef ('ifdef' as identifier) (cond_tail | eol_mark)
               | retag ifndef ('ifndef' as identifier) (cond_tail | eol_mark) | retag elif ('elif' as identifier) (cond_tail | eol_mark)
               | retag elifdef ('elifdef' as identifier) (cond_tail | eol_mark) | retag elifndef ('elifndef' as identifier) (cond_tail | eol_mark)
               | retag else ('else' as identifier) (cond_tail | eol_mark) | retag endif ('endif' as identifier) (cond_tail | eol_mark)
               | retag line ('line' as identifier) (rest: line_rest eol_mark | eol_mark)
               | retag line_marker rest: marker_rest eol_mark
               | retag pragma ('pragma' as identifier) (text: pragma_text eol_mark | eol_mark)
               | retag error ('error' as identifier) (text_tail | eol_mark) | retag warning ('warning' as identifier) (text_tail | eol_mark)
               | retag ident ('ident' as identifier) (text_tail | eol_mark) | retag sccs ('sccs' as identifier) (text_tail | eol_mark)
               | retag assert ('assert' as identifier) (text_tail | eol_mark) | retag unassert ('unassert' as identifier) (text_tail | eol_mark)
               | not_number (text_tail | eol_mark)
  # A name, then a parameter list where a `(` touches it, then the replacement list. No name: no
  # macro (the lean scan's malformed `#define`).
  choice define_tail = name: identifier (touch params: params [body: operands] | [body: operands]) eol_mark | not_ident (any)* eol_mark
  node params = ('(' as punct) [param_list] (')' as punct)
  # `...`, or a parameter then GNU's `...`, or a `,` and the rest: nothing after a `...`.
  choice param_list nested = variadic: ('...' as punct) | param: identifier [variadic: ('...' as punct) | (',' as punct) param_list]
  # The header: `"…"`, `<…>` (to its first `>`), or tokens a macro makes one of. (`#embed`'s
  # parameters after its header are not the header's: `(any)*`.)
  choice include_tail = qstr spelled: literal (any)* eol_mark | spelled: header (any)* eol_mark | spelled: macro_header eol_mark
  node header = ('<' as punct) (any except '>')* ('>' as punct)
  node macro_header = (any except '<') (any)*
  choice cond_tail = expr: operands eol_mark
  choice text_tail = text: operands eol_mark
  # A pragma's first word, and its second where the first is one.
  node pragma_text = first: identifier [second: identifier (any)* | not_ident (any)*] | not_ident (any)*
  # A line's number, then its file where the next token is a `"…"`.
  node line_rest = (n: number | not_number) line_after
  node marker_rest = n: number line_after
  choice line_after = [qstr file: literal (any)* | any (any)*]
  # Tokens by what they are not.
  choice not_number = identifier | literal | punct | digraph | hash | hashhash | other
  choice not_ident = number | literal | punct | digraph | hash | hashhash | other
  # A directive's tokens after its word.
  node operands = any (any)*
}
