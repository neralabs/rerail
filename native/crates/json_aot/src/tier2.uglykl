               ARGS,     json_t2_TArgs, args,   ,
               ROBUFFER, uint8_t,  src,    "[n + 64]",
               ROBUFFER, uint32_t, starts, "[count + 3]",
               ROBUFFER, uint32_t, list,   "[n]",
               RWBUFFER, uint32_t, tokens, "[count * 5]",
               GID0,     uint32_t, j,      )
{
    if (j >= args.n)
        return;
    uint32_t r = list[j];
    uint32_t b = src[starts[r]];
    uint32_t t[5] = {0u, json_t2_NONE, 0u, 0u, json_t2_NONE};
    if (b == 0x22u || b == 0x74u || b == 0x66u || b == 0x6eu || b == 0x2du || (b >= 0x30u && b <= 0x39u)) {
        json_t2_Tok d;
        d.kind = 0u;
        d.nodes = 0u;
        d.last = 0u;
        uint32_t i = r;
        uint32_t nn[5] = {0u, 1u, 2u, 3u, 4u};
        json_t2_R x = json_t2_value_primitive_Tok(src, starts, &d, &i, nn);
        if (x.ok) {
            t[0] = x.v;
            t[1] = d.kind;
            t[2] = d.nodes;
            t[3] = d.last;
        } else {
            t[4] = x.v;
        }
    }
    for (uint32_t k = 0u; k < 5u; k++)
        tokens[r * 5u + k] = t[k];
}

// Pass 2 (`write_range`), chunk `c` from its state `a` (pass 3's, in the pool), through a cursor from the middle on
// the writer's region (its state at 0, its blocks made): counting its side-list entries, or writing them. Its frames'
// room is placed by its first record and its number (`5 * (span + 1)` frames: those open at its entry, and as many as
// its records open); its levels in its row of `rets`. Where it stopped: its two words of `out`, its stop's kind and
// record (4: no state, 5: past its room, 6: after the end).
UKL_ONCE void ukl_run_write(UKL_PRIVATE UklRun* r, uint32_t c, uint32_t a, uint32_t start, uint32_t stop, bool count)
{
    UklMidPool pool = r->m;
    UklMidPool out = pool + pool[UKL_RUN_O_OUT];
    out[c * 2u + 1u] = 0u;
    if (a >= UKL_MID_FULL || pool[a + 5u] != 0u) {
        out[c * 2u] = a >= UKL_MID_FULL ? 4u : 6u;
        return;
    }
    uint32_t span = stop - start;
    uint32_t nret = pool[a + 9u], nf = pool[a + 10u];
    if (nf + 3u * span + 4u > 5u * (span + 1u)) {
        out[c * 2u] = 5u;
        return;
    }
    UKL_GLOBAL uint32_t* room = r->f2 + UKL_WMID_FRAME * 5u * (start + c);
    for (uint32_t k = 0u; k < nf * UKL_WMID_FRAME; k++)
        room[k] = pool[a + UKL_AT_HEAD + nret + k];
    UKL_GLOBAL uint8_t* ret = r->rets + c * json_t2_DEPTH;
    uint32_t base = pool[a + 2u] - nret;
    for (uint32_t k = 0u; k < nret; k++)
        ret[base + k] = (uint8_t)pool[a + UKL_AT_HEAD + k];
    json_t2_Lx lx;
    lx.starts = r->starts;
    lx.count = r->count;
    lx.len = r->len;
    json_t2_Entry en;
    en.i = pool[a];
    en.e = pool[a + 1u];
    en.depth = pool[a + 2u];
    en.st = pool[a + 3u];
    uint64_t prev = (uint64_t)pool[a + 7u] | ((uint64_t)pool[a + 8u] << 32);
    UklWMid d = ukl_wmid_resume(r->t, 0u, pool[a + 4u], prev, room, nf, count);
    json_t2_Stop x = json_t2_run_range_Mid(r->src, lx, &d, en, ret, 0u, stop);
    out[c * 2u] = x.kind;
    out[c * 2u + 1u] = x.en.i;
}

// The span of a walk that stopped at `r` (`Span::of`), from its shadow `d`: its offset in the pool, or `UKL_MID_FULL`.
UKL_INLINE uint32_t json_t2_span_of(UklMidPool m, json_t2_Stop r, UKL_PRIVATE const json_t2_Sh* d)
{
    bool end = r.kind >= 2u;
    uint32_t nt = d->closed + 1u;
    uint32_t npf = end ? 0u : d->nown;
    uint32_t at = ukl_mid_take(m, UKL_SPAN_HEAD + 2u * nt + UKL_MID_FRAME * npf);
    if (at == UKL_MID_FULL)
        return at;
    m[at] = r.kind == 0u ? r.en.i : 0u;
    m[at + 1u] = r.kind == 0u ? r.en.e : 0u;
    m[at + 2u] = r.kind == 0u ? r.en.depth : 0u;
    m[at + 3u] = r.kind == 0u ? r.en.st : 0u;
    m[at + 4u] = d->n;
    m[at + 5u] = r.kind == 2u ? 1u : r.kind == 3u ? 2u : 0u;
    m[at + 6u] = r.kind == 3u ? r.err : 0u;
    m[at + 7u] = d->closed;
    m[at + 8u] = nt;
    m[at + 9u] = npf;
    m[at + 10u] = d->has_last ? (uint32_t)d->last_start : 0u;
    m[at + 11u] = d->has_last ? (uint32_t)(d->last_start >> 32) : 0u;
    m[at + 12u] = d->has_last ? 1u : 0u;
    uint32_t w = at + UKL_SPAN_HEAD;
    for (uint32_t k = 0u; k < nt; k++) {
        bool has = !end && k < d->ntouch;
        m[w++] = has ? d->touch[2u * k] : 0u;
        m[w++] = has ? d->touch[2u * k + 1u] : json_t2_NONE;
    }
    for (uint32_t k = 0u; k < UKL_MID_FRAME * npf; k++)
        m[w++] = d->own[k];
    return at;
}

// Pass 1 (`span`): chunk `c`'s one walk, from the place and the levels' places its open levels' kinds `k` give (the
// levels it closes, its word `w`'s anti-opens), so it never reads a level it does not know. Kinds of none are after
// the file's refusal, as one deeper than the walk goes: the span ends at its first record. Its frames are kept in
// `f1` (`2 * span + 2`), its writes into its entry's in `touch` (`span + 1`), each placed by its first record and its
// number; its levels' places in its row of `rets`.
UKL_ONCE uint32_t ukl_run_span(UKL_PRIVATE UklRun* r, uint32_t c, uint32_t start, uint32_t stop, uint32_t depth0, uint32_t k, uint32_t w)
{
    UklMidPool pool = r->m;
    uint32_t span = stop - start;
    json_t2_Sh d;
    d.toks = r->toks;
    d.ntoks = r->ntoks;
    d.n = 0u;
    d.own = r->f1 + UKL_MID_FRAME * 2u * (start + c);
    d.nown = 0u;
    d.most_own = 2u * span + 2u;
    d.touch = r->touch + 2u * (start + c);
    d.ntouch = 0u;
    d.most_touch = span + 1u;
    d.closed = 0u;
    d.last_start = 0u;
    d.has_last = false;
    d.full = false;
    json_t2_Stop x = json_t2_stop_err(r->starts[start]);
    bool walk = k != UKL_MID_NONE && depth0 <= json_t2_DEPTH;
    uint32_t st = 0u, known = 0u;
    UKL_GLOBAL uint8_t* ret = r->rets + c * json_t2_DEPTH;
    if (walk) {
        uint32_t nk = pool[k], anti = pool[w];
        uint32_t inner = pool[k + nk];
        known = anti < nk - 1u ? anti : nk - 1u;
        known = known < depth0 ? known : depth0;
        if (start != 0u) {
            walk = inner != json_t2_ROOT;
            st = walk ? json_t2_cycle(inner) : 0u;
        }
        for (uint32_t j = 0u; j < known; j++)
            ret[depth0 - 1u - j] = (uint8_t)json_t2_cont(pool[k + 1u + nk - 2u - j]);
    }
    if (walk) {
        json_t2_Lx lx;
        lx.starts = r->starts;
        lx.count = r->count;
        lx.len = r->len;
        json_t2_Entry en;
        en.i = start;
        en.e = 0u;
        en.depth = depth0;
        en.st = st;
        x = json_t2_run_range_Sh(r->src, lx, &d, en, ret, depth0 - known, stop);
        // A level its word does not close: the walk closes a level only at a closer.
        if (x.kind == 1u) {
            x = json_t2_stop_err(r->starts[start]);
            d.n = 0u;
            d.nown = 0u;
            d.ntouch = 0u;
            d.closed = 0u;
            d.has_last = false;
        }
    }
    return d.full ? UKL_MID_FULL : json_t2_span_of(pool, x, &d);
}

UKL_INLINE uint32_t ukl_run_bracket(uint32_t b) { return json_t2_bracket(b); }
UKL_INLINE bool ukl_run_sep(uint32_t b) { return b == 44u; }
UKL_INLINE uint32_t ukl_run_root(void) { return json_t2_ROOT; }
UKL_INLINE uint32_t ukl_run_cont(uint32_t k) { return json_t2_cont(k); }

typedef struct json_t2_RArgs {
    uint32_t count;
    uint32_t len;
    uint32_t ntoks;
    uint32_t size;
    uint32_t runs;
    uint32_t most;
    uint32_t capacity;
    uint32_t budget;
} json_t2_RArgs;
UKL_REFLECT_STRUCT(json_t2_RArgs, count, len, ntoks, size, runs, most, capacity, budget)

// Tier 2 from the middle as one program (`<ukl/middle_run.h>`): a persistent dispatch whose SIMD groups take the
// chain's items from the work queue (`slots`, `control`) until none is left or their budget is spent; the host
// launches it again while any are left. The pool holds every value an item hands on (its header the host's layout);
// `t` is the writer's region, its state at 0, room reserved for the tape and its tail.
DEFINE_KERNEL2(tier2, json_t2_run,
               ARGS,     json_t2_RArgs, args,    ,
               ROBUFFER, uint8_t,  src,     "[len + 64]",
               ROBUFFER, uint32_t, starts,  "[count + 3]",
               ROBUFFER, uint32_t, toks,    "[ntoks * 5]",
               RWBUFFER, uint32_t, pool,    "[pool]",
               RWBUFFER, uint8_t,  t,       "[region]",
               RWBUFFER, uint8_t,  rets,    "[runs * json_t2_DEPTH]",
               RWBUFFER, uint32_t, f1,      "[(count + 1 + runs) * 10]",
               RWBUFFER, uint32_t, touch,   "[(count + 1 + runs) * 2]",
               RWBUFFER, uint32_t, f2,      "[(count + 1 + runs) * 25]",
               RWBUFFER, uint32_t, slots,   "[capacity]",
               RWBUFFER, uint32_t, control, "[5]",
               LANE,     uint16_t, lane,    )
{
    UklRun r;
    r.src = src;
    r.starts = starts;
    r.toks = toks;
    r.m = (UklMidPool)pool;
    r.t = t;
    r.rets = rets;
    r.f1 = f1;
    r.touch = touch;
    r.f2 = f2;
    r.q.slots = slots;
    r.q.control = control;
    r.q.capacity = args.capacity;
    r.q.ring = 0u;
    r.q.budget = args.budget;
    r.count = args.count;
    r.len = args.len;
    r.ntoks = args.ntoks;
    r.size = args.size;
    r.runs = args.runs;
    r.most = args.most;
    ukl_run_worker(&r, lane __UKL_ARGS);
}
