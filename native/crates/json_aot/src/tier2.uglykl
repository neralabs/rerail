    uint32_t t[5] = {0u, json_t2_NONE, 0u, 0u, json_t2_NONE};
    if (b == 0x22u || b == 0x74u || b == 0x66u || b == 0x6eu || b == 0x2du || (b >= 0x30u && b <= 0x39u)) {
        json_t2_Tok d;
        d.kind = 0u;
        d.nodes = 0u;
        d.last = 0u;
        uint32_t i = r;
        uint32_t nn[5] = {0u, 1u, 2u, 3u, 4u};
        json_t2_R x = json_t2_value_primitive_Tok(src, starts, &d, &i, nn);
        if (x.ok) {
            t[0] = x.v;
            t[1] = d.kind;
            t[2] = d.nodes;
            t[3] = d.last;
        } else {
            t[4] = x.v;
        }
    }
    for (uint32_t k = 0u; k < 5u; k++)
        tokens[r * 5u + k] = t[k];
}

typedef struct json_t2_WArgs {
    uint32_t chunks;
    uint32_t count;
    uint32_t len;
    uint32_t write;
} json_t2_WArgs;
UKL_REFLECT_STRUCT(json_t2_WArgs, chunks, count, len, write)

// Pass 2: chunk `c`'s nodes written from its state (`write_range`), through a cursor from the middle on the writer's
// region `t` (its state at 0, its blocks made): counting its side-list entries (`args.write` 0), or writing them. Its
// state, `ats`' 13 words: its entry (`i`, `e`, `depth`, `st`), the record it stops at, its first node, the start
// before it (two words), its frames' room in `f` (`FRAME` words each), the frames open at its entry (their count and
// place in `frames`: node, children, last child, start's two words), and the levels it holds (their count and place in
// `levels`, the innermost last). Where it stopped: `out`'s two words, its stop's kind and record.
DEFINE_KERNEL2(tier2, json_t2_write,
               ARGS,     json_t2_WArgs, args,   ,
               ROBUFFER, uint8_t,  src,    "[len + 64]",
               ROBUFFER, uint32_t, starts, "[count + 3]",
               RWBUFFER, uint8_t,  t,      "[region]",
               ROBUFFER, uint32_t, ats,    "[chunks * 13]",
               ROBUFFER, uint32_t, frames, "[entry frames * 5]",
               ROBUFFER, uint8_t,  levels, "[entry levels]",
               RWBUFFER, uint32_t, f,      "[room * 5]",
               RWBUFFER, uint8_t,  rets,   "[chunks * json_t2_DEPTH]",
               RWBUFFER, uint32_t, out,    "[chunks * 2]",
               GID0,     uint32_t, c,      )
{
    if (c >= args.chunks)
        return;
    UKL_GLOBAL const uint32_t* a = ats + c * 13u;
    UKL_GLOBAL uint32_t* room = f + a[8] * UKL_WMID_FRAME;
    for (uint32_t k = 0u; k < a[9] * UKL_WMID_FRAME; k++)
        room[k] = frames[a[10] * UKL_WMID_FRAME + k];
    UKL_GLOBAL uint8_t* ret = rets + c * json_t2_DEPTH;
    uint32_t base = a[2] - a[11];
    for (uint32_t k = 0u; k < a[11]; k++)
        ret[base + k] = levels[a[12] + k];
    json_t2_Lx lx;
    lx.starts = starts;
    lx.count = args.count;
    lx.len = args.len;
    json_t2_Entry en;
    en.i = a[0];
    en.e = a[1];
    en.depth = a[2];
    en.st = a[3];
    UklWMid d = ukl_wmid_resume(t, 0u, a[5], (uint64_t)a[6] | ((uint64_t)a[7] << 32), room, a[9], args.write == 0u);
    json_t2_Stop r = json_t2_run_range_Mid(src, lx, &d, en, ret, 0u, a[4]);
    out[c * 2u] = r.kind;
    out[c * 2u + 1u] = r.en.i;
}

// Pass 1's summaries: a chunk's at most `LANES` lanes, after its status (0 made; 1 more lanes than its room before
// they fold, 2 its pool's room or `LANES` passed, 3 its frames' or levels' room passed) and their count, their offsets
// in the pool.
#define json_t2_LANES 16u
#define json_t2_SUM (2u + json_t2_LANES)
// The lanes a chunk's walks leave before they fold, at most.
#define json_t2_RAW 64u

typedef struct json_t2_LArgs {
    uint32_t chunks;
    uint32_t count;
    uint32_t len;
    uint32_t ntoks;
} json_t2_LArgs;
UKL_REFLECT_STRUCT(json_t2_LArgs, chunks, count, len, ntoks)

// The lane of a walk that stopped at `r`, its levels' places `kc` (`path`'s, two words a level), its shadow `d`
// (`Lane::of`): its offset in the pool, or `UKL_LANE_NONE` past the pool's room.
UKL_INLINE uint32_t json_t2_lane_of(UklLanePool m, uint32_t st0, UKL_GLOBAL const uint32_t* path, uint32_t nkc, UKL_GLOBAL const uint8_t* ret, uint32_t low,
                                json_t2_Stop r, UKL_PRIVATE const json_t2_Sh* d)
{
    bool end = r.kind >= 2u;
    uint32_t np = r.kind == 0u ? r.en.depth - low : 0u;
    uint32_t nt = d->closed + 1u;
    uint32_t npf = end ? 0u : d->nown;
    uint32_t at = ukl_lane_take(m, UKL_LANE_HEAD + nkc + np + 2u * nt + UKL_LANE_FRAME * npf);
    if (at == UKL_LANE_NONE)
        return at;
    m[at + UKL_LANE_ST0] = st0;
    m[at + UKL_LANE_NKC] = nkc;
    m[at + UKL_LANE_NP] = np;
    m[at + UKL_LANE_EXIT] = r.kind == 0u ? r.en.i : 0u;
    m[at + UKL_LANE_EXIT + 1u] = r.kind == 0u ? r.en.e : 0u;
    m[at + UKL_LANE_EXIT + 2u] = r.kind == 0u ? r.en.depth : 0u;
    m[at + UKL_LANE_EXIT + 3u] = r.kind == 0u ? r.en.st : 0u;
    m[at + UKL_LANE_NODES] = d->n;
    m[at + UKL_LANE_END] = r.kind == 2u ? 1u : r.kind == 3u ? 2u : 0u;
    m[at + UKL_LANE_ERR] = r.kind == 3u ? r.err : 0u;
    m[at + UKL_LANE_FKC] = d->closed;
    m[at + UKL_LANE_NTOUCH] = nt;
    m[at + UKL_LANE_NPF] = npf;
    m[at + UKL_LANE_LAST] = d->has_last ? (uint32_t)d->last_start : 0u;
    m[at + UKL_LANE_LAST + 1u] = d->has_last ? (uint32_t)(d->last_start >> 32) : 0u;
    m[at + UKL_LANE_HAS_LAST] = d->has_last ? 1u : 0u;
    m[at + UKL_LANE_NREF] = 0u;
    uint32_t w = at + UKL_LANE_HEAD;
    for (uint32_t k = 0u; k < nkc; k++)
        m[w++] = path[2u * k];
    for (uint32_t k = 0u; k < np; k++)
        m[w++] = ret[low + k];
    for (uint32_t k = 0u; k < nt; k++) {
        bool has = !end && k < d->ntouch;
        m[w++] = has ? d->touch[2u * k] : 0u;
        m[w++] = has ? d->touch[2u * k + 1u] : json_t2_NONE;
    }
    for (uint32_t k = 0u; k < UKL_LANE_FRAME * npf; k++)
        m[w++] = d->own[k];
    return at;
}

// Pass 1 (`lanes`): chunk `c`'s summary, its first record at depth `depths[c]`: from each place its first record can
// be at, the walk, forked where it closes a level below its entry, once for each place a level returns to. A fork is
// the walk again from the chunk's start with the levels' places chosen so far (`path`), each fork in the order the
// Rust's work list takes them, so the lanes and their fold are its. The chunk's room: its levels' places in `rets`,
// its frames (`2 * span + 2`) in `f` and what it writes into its entry's (`span + 1`) in `touch`, each placed by its
// first record and its number, so no chunk's meets another's.
DEFINE_KERNEL2(tier2, json_t2_lanes,
               ARGS,     json_t2_LArgs, args,   ,
               ROBUFFER, uint8_t,  src,    "[len + 64]",
               ROBUFFER, uint32_t, starts, "[count + 3]",
               ROBUFFER, uint32_t, toks,   "[ntoks * 5]",
               ROBUFFER, uint32_t, chunks, "[chunks]",
               ROBUFFER, uint32_t, depths, "[chunks]",
               RWBUFFER, uint8_t,  rets,   "[chunks * json_t2_DEPTH]",
               RWBUFFER, uint32_t, f,      "[(count + 1 + chunks) * 10]",
               RWBUFFER, uint32_t, touch,  "[(count + 1 + chunks) * 2]",
               RWBUFFER, uint32_t, path,   "[(count + 1 + chunks) * 2]",
               RWBUFFER, uint32_t, raw,    "[chunks * RAW * 2]",
               RWBUFFER, uint32_t, pool,   "[pool]",
               RWBUFFER, uint32_t, sums,   "[chunks * SUM]",
               GID0,     uint32_t, c,      )
{
    if (c >= args.chunks)
        return;
    UKL_GLOBAL uint32_t* s = sums + c * json_t2_SUM;
    uint32_t start = chunks[c];
    uint32_t stop = c + 1u < args.chunks ? chunks[c + 1u] : args.count + 1u;
    uint32_t depth0 = depths[c];
    uint32_t span = stop - start;
    UKL_GLOBAL uint8_t* ret = rets + c * json_t2_DEPTH;
    UKL_GLOBAL uint32_t* own = f + UKL_LANE_FRAME * 2u * (start + c);
    UKL_GLOBAL uint32_t* tch = touch + 2u * (start + c);
    UKL_GLOBAL uint32_t* pth = path + 2u * (start + c);
    UKL_GLOBAL uint32_t* rw = raw + c * 2u * json_t2_RAW;
    json_t2_Lx lx;
    lx.starts = starts;
    lx.count = args.count;
    lx.len = args.len;
    bool deeper = depth0 > json_t2_DEPTH;
    uint32_t np = start == 0u ? 1u : json_t2_NCYCLES;
    uint32_t nraw = 0u, status = 0u;
    for (uint32_t q0 = 0u; q0 < np && status == 0u; q0++) {
        // The Rust's work list takes the last place first; deeper than the walk goes, each place in order.
        uint32_t q = deeper ? q0 : np - 1u - q0;
        uint32_t st0 = start == 0u ? 0u : json_t2_cycles(q);
        uint32_t nkc = 0u;
        while (true) {
            json_t2_Sh d;
            d.toks = toks;
            d.ntoks = args.ntoks;
            d.n = 0u;
            d.own = own;
            d.nown = 0u;
            d.most_own = 2u * span + 2u;
            d.touch = tch;
            d.ntouch = 0u;
            d.most_touch = span + 1u;
            d.closed = 0u;
            d.last_start = 0u;
            d.has_last = false;
            d.full = false;
            json_t2_Entry en;
            en.i = start;
            en.e = 0u;
            en.depth = depth0;
            en.st = st0;
            uint32_t low = depth0, j = 0u;
            bool extend = false;
            json_t2_Stop r = json_t2_stop_err(starts[start]);
            while (!deeper) {
                r = json_t2_run_range_Sh(src, lx, &d, en, ret, low, stop);
                if (r.kind != 1u || d.full)
                    break;
                if (j < nkc) {
                    uint32_t k = pth[2u * j];
                    ret[r.en.depth] = (uint8_t)k;
                    low = r.en.depth;
                    en = r.en;
                    en.st = k;
                    j++;
                    continue;
                }
                extend = true;
                break;
            }
            if (d.full) {
                status = 3u;
                break;
            }
            if (extend) {
                if (nkc > span) {
                    status = 3u;
                    break;
                }
                pth[2u * nkc] = json_t2_rets(json_t2_NRETS - 1u);
                pth[2u * nkc + 1u] = json_t2_NRETS - 1u;
                nkc++;
                continue;
            }
            if (nraw >= json_t2_RAW) {
                status = 1u;
                break;
            }
            uint32_t at = json_t2_lane_of(pool, st0, pth, nkc, ret, low, r, &d);
            if (at == UKL_LANE_NONE) {
                status = 2u;
                break;
            }
            rw[nraw++] = at;
            // The next fork: the last level with a place left, its next place.
            while (nkc > 0u && pth[2u * (nkc - 1u) + 1u] == 0u)
                nkc--;
            if (nkc == 0u)
                break;
            uint32_t ci = pth[2u * (nkc - 1u) + 1u] - 1u;
            pth[2u * (nkc - 1u) + 1u] = ci;
            pth[2u * (nkc - 1u)] = json_t2_rets(ci);
        }
    }
    uint32_t n = 0u;
    if (status == 0u) {
        n = ukl_lane_fold(pool, rw, nraw, rw + json_t2_RAW, s + 2u, json_t2_LANES);
        if (n == UKL_LANE_NONE) {
            status = 2u;
            n = 0u;
        }
    }
    s[0] = status;
    s[1] = n;
}
