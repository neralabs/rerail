#define json_t2_NCYCLES 2u
UKL_INLINE uint32_t json_t2_cycles(uint32_t k) { return k == 0u ? 2u : 5u; }
#define json_t2_NRETS 3u
UKL_INLINE uint32_t json_t2_rets(uint32_t k) { return k == 0u ? 3u : k == 1u ? 6u : 7u; }
#define json_t2_NCONT 3u
UKL_INLINE uint32_t json_t2_cont(uint32_t k) { return k == 0u ? 6u : k == 1u ? 3u : 7u; }
#define json_t2_NCYCLE 2u
UKL_INLINE uint32_t json_t2_cycle(uint32_t k) { return k == 0u ? 5u : 2u; }
#define json_t2_NSTEP_CONT 3u
UKL_INLINE uint32_t json_t2_step_cont_t(uint32_t k) { return k == 0u ? 8u : k == 1u ? 4u : 14u; }
#define json_t2_ROOT (json_t2_NCONT - 1u)
UKL_INLINE uint32_t json_t2_bracket(uint32_t b) { return b == 0x5bu ? 1u : b == 0x5du ? 0u : b == 0x7bu ? 3u : b == 0x7du ? 2u : json_t2_NONE; }
typedef struct json_t2_TArgs {
    uint32_t n;
    uint32_t count;
} json_t2_TArgs;
UKL_REFLECT_STRUCT(json_t2_TArgs, n, count)

// The token at record `list[j]` (the token pass's), written; its nodes.
UKL_INLINE uint32_t json_t2_token_at(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, UKL_GLOBAL const uint32_t* list, UKL_GLOBAL uint32_t* tokens, uint32_t j)
{
    uint32_t r = list[j];
    uint32_t b = src[starts[r]];
    uint32_t t[5] = {0u, json_t2_NONE, 0u, 0u, json_t2_NONE};
    if (b == 0x22u || b == 0x74u || b == 0x66u || b == 0x6eu || b == 0x2du || (b >= 0x30u && b <= 0x39u)) {
        json_t2_Tok d;
        d.kind = 0u;
        d.nodes = 0u;
        d.last = 0u;
        uint32_t i = r;
        uint32_t nn[5] = {0u, 1u, 2u, 3u, 4u};
        json_t2_R x = json_t2_value_primitive_Tok(src, starts, &d, &i, nn);
        if (x.ok) {
            t[0] = x.v;
            t[1] = d.kind;
            t[2] = d.nodes;
            t[3] = d.last;
        } else {
            t[4] = x.v;
        }
    }
    for (uint32_t k = 0u; k < 5u; k++)
        tokens[r * 5u + k] = t[k];
    return t[2];
}

// Stage 2: the token at record `list[j]`, read on its own (`token_at`): its end, its first node's number among the
// primitive's alternatives, its nodes, the last one's start, or the byte it is refused at (`err`, else `NONE`). The
// list is tier 1's types' (`<ukl/lex_run.h>`), as many as its pool says (`lexed`); the grid `args.n` threads, at
// least that many. A record that starts no token keeps the none tier 1 wrote. The tokens' nodes are summed in the
// pool (`UKL_LEX_NODES`, a SIMD group's sum an add): with the records, tier 2's room for the tape's nodes.
DEFINE_KERNEL2(tier2, json_t2_tokens,
               ARGS,     json_t2_TArgs, args,   ,
               ROBUFFER, uint8_t,  src,    "[n + 64]",
               ROBUFFER, uint32_t, starts, "[count + 3]",
               ROBUFFER, uint32_t, list,   "[n]",
               RWBUFFER, uint32_t, lexed,  "[32]",
               RWBUFFER, uint32_t, tokens, "[count * 5]",
               GID0,     uint32_t, j,      ,
               LANE,     uint16_t, lane,   )
{
    // Every lane goes on to the group's sum.
    bool mine = j < args.n && j < lexed[UKL_LEX_TYPED] && lexed[UKL_LEX_REFUSED] == 0u && lexed[UKL_LEX_SHORT] == 0u;
    uint32_t nodes = mine ? json_t2_token_at(src, starts, list, tokens, j) : 0u;
    uint32_t sum = ukl_sg_sum(nodes __UKL_ARGS);
    if (lane == 0u && sum != 0u)
        ukl_atomic_add(&((UklLexPool)lexed)[UKL_LEX_NODES], sum);
}

// Pass 2 (`write_range`), chunk `c` from its state `a` (pass 3's, in the pool), through a cursor from the middle on
// the writer's region (its state at 0, its blocks made): counting its side-list entries, or writing them. Its frames'
// room is placed by its first record and its number (`5 * (span + 1)` frames: those open at its entry, and as many as
// its records open); its levels in its row of `rets`. Where it stopped: its two words of `out`, its stop's kind and
// record (4: no state, 5: past its room, 6: after the end).
UKL_ONCE void ukl_run_write(UKL_PRIVATE UklRun* r, uint32_t c, uint32_t a, uint32_t start, uint32_t stop, bool count)
{
    UklMidPool pool = r->m;
    UklMidPool out = pool + pool[UKL_RUN_O_OUT];
    out[c * 2u + 1u] = 0u;
    if (a >= UKL_MID_FULL || pool[a + 5u] != 0u) {
        out[c * 2u] = a >= UKL_MID_FULL ? 4u : 6u;
        return;
    }
    uint32_t span = stop - start;
    uint32_t nret = pool[a + 9u], nf = pool[a + 10u];
    if (nf + 3u * span + 4u > 5u * (span + 1u)) {
        out[c * 2u] = 5u;
        return;
    }
    UKL_GLOBAL uint32_t* room = r->f2 + UKL_WMID_FRAME * 5u * (start + c);
    for (uint32_t k = 0u; k < nf * UKL_WMID_FRAME; k++)
        room[k] = pool[a + UKL_AT_HEAD + nret + k];
    UKL_GLOBAL uint8_t* ret = r->rets + c * json_t2_DEPTH;
    uint32_t base = pool[a + 2u] - nret;
    for (uint32_t k = 0u; k < nret; k++)
        ret[base + k] = (uint8_t)pool[a + UKL_AT_HEAD + k];
    json_t2_Lx lx;
    lx.starts = r->starts;
    lx.count = r->count;
    lx.len = r->len;
    json_t2_Entry en;
    en.i = pool[a];
    en.e = pool[a + 1u];
    en.depth = pool[a + 2u];
    en.st = pool[a + 3u];
    uint64_t prev = (uint64_t)pool[a + 7u] | ((uint64_t)pool[a + 8u] << 32);
    UklWMid d = ukl_wmid_resume(r->t, 0u, pool[a + 4u], prev, room, nf, count);
    json_t2_Stop x = json_t2_run_range_Mid(r->src, lx, &d, en, ret, 0u, stop);
    out[c * 2u] = x.kind;
    out[c * 2u + 1u] = x.en.i;
}

// The span of a walk that stopped at `r` (`Span::of`), from its shadow `d`: its offset in the pool, or `UKL_MID_FULL`.
UKL_INLINE uint32_t json_t2_span_of(UklMidPool m, json_t2_Stop r, UKL_PRIVATE const json_t2_Sh* d)
{
    bool end = r.kind >= 2u;
    uint32_t nt = d->closed + 1u;
    uint32_t npf = end ? 0u : d->nown;
    uint32_t at = ukl_mid_take(m, UKL_SPAN_HEAD + 2u * nt + UKL_MID_FRAME * npf);
    if (at == UKL_MID_FULL)
        return at;
    m[at] = r.kind == 0u ? r.en.i : 0u;
    m[at + 1u] = r.kind == 0u ? r.en.e : 0u;
    m[at + 2u] = r.kind == 0u ? r.en.depth : 0u;
    m[at + 3u] = r.kind == 0u ? r.en.st : 0u;
    m[at + 4u] = d->n;
    m[at + 5u] = r.kind == 2u ? 1u : r.kind == 3u ? 2u : 0u;
    m[at + 6u] = r.kind == 3u ? r.err : 0u;
    m[at + 7u] = d->closed;
    m[at + 8u] = nt;
    m[at + 9u] = npf;
    m[at + 10u] = d->has_last ? (uint32_t)d->last_start : 0u;
    m[at + 11u] = d->has_last ? (uint32_t)(d->last_start >> 32) : 0u;
    m[at + 12u] = d->has_last ? 1u : 0u;
    uint32_t w = at + UKL_SPAN_HEAD;
    for (uint32_t k = 0u; k < nt; k++) {
        bool has = !end && k < d->ntouch;
        m[w++] = has ? d->touch[2u * k] : 0u;
        m[w++] = has ? d->touch[2u * k + 1u] : json_t2_NONE;
    }
    for (uint32_t k = 0u; k < UKL_MID_FRAME * npf; k++)
        m[w++] = d->own[k];
    return at;
}

// Pass 1 (`span`): chunk `c`'s one walk, from the place and the levels' places its open levels' kinds `k` give (the
// levels it closes, its word `w`'s anti-opens), so it never reads a level it does not know. Kinds of none are after
// the file's refusal, as one deeper than the walk goes: the span ends at its first record. Its frames are kept in
// `f1` (`2 * span + 2`), its writes into its entry's in `touch` (`span + 1`), each placed by its first record and its
// number; its levels' places in its row of `rets`.
UKL_ONCE uint32_t ukl_run_span(UKL_PRIVATE UklRun* r, uint32_t c, uint32_t start, uint32_t stop, uint32_t depth0, uint32_t k, uint32_t w)
{
    UklMidPool pool = r->m;
    uint32_t span = stop - start;
    json_t2_Sh d;
    d.toks = r->toks;
    d.ntoks = r->ntoks;
    d.n = 0u;
    d.own = r->f1 + UKL_MID_FRAME * 2u * (start + c);
    d.nown = 0u;
    d.most_own = 2u * span + 2u;
    d.touch = r->touch + 2u * (start + c);
    d.ntouch = 0u;
    d.most_touch = span + 1u;
    d.closed = 0u;
    d.last_start = 0u;
    d.has_last = false;
    d.full = false;
    json_t2_Stop x = json_t2_stop_err(r->starts[start]);
    bool walk = k != UKL_MID_NONE && depth0 <= json_t2_DEPTH;
    uint32_t st = 0u, known = 0u;
    UKL_GLOBAL uint8_t* ret = r->rets + c * json_t2_DEPTH;
    if (walk) {
        uint32_t nk = pool[k], anti = pool[w];
        uint32_t inner = pool[k + nk];
        known = anti < nk - 1u ? anti : nk - 1u;
        known = known < depth0 ? known : depth0;
        if (start != 0u) {
            walk = inner != json_t2_ROOT;
            st = walk ? json_t2_cycle(inner) : 0u;
        }
        for (uint32_t j = 0u; j < known; j++)
            ret[depth0 - 1u - j] = (uint8_t)json_t2_cont(pool[k + 1u + nk - 2u - j]);
    }
    if (walk) {
        json_t2_Lx lx;
        lx.starts = r->starts;
        lx.count = r->count;
        lx.len = r->len;
        json_t2_Entry en;
        en.i = start;
        en.e = 0u;
        en.depth = depth0;
        en.st = st;
        x = json_t2_run_range_Sh(r->src, lx, &d, en, ret, depth0 - known, stop);
        // A level its word does not close: the walk closes a level only at a closer.
        if (x.kind == 1u) {
            x = json_t2_stop_err(r->starts[start]);
            d.n = 0u;
            d.nown = 0u;
            d.ntouch = 0u;
            d.closed = 0u;
            d.has_last = false;
        }
    }
    return d.full ? UKL_MID_FULL : json_t2_span_of(pool, x, &d);
}

UKL_INLINE uint32_t ukl_run_bracket(uint32_t b) { return json_t2_bracket(b); }
UKL_INLINE bool ukl_run_sep(uint32_t b) { return b == 44u; }
UKL_INLINE uint32_t ukl_run_root(void) { return json_t2_ROOT; }
UKL_INLINE uint32_t ukl_run_cont(uint32_t k) { return json_t2_cont(k); }


typedef struct json_t2_RArgs {
    uint32_t count;
    uint32_t len;
    uint32_t ntoks;
    uint32_t size;
    uint32_t runs;
    uint32_t most;
    uint32_t phase;
    uint32_t pad;
} json_t2_RArgs;
UKL_REFLECT_STRUCT(json_t2_RArgs, count, len, ntoks, size, runs, most, phase, pad)

// The 16z program's kernels take nothing but their buffers.
typedef struct json_t2_ZArgs {
    uint32_t pad;
    uint32_t pad2;
} json_t2_ZArgs;
UKL_REFLECT_STRUCT(json_t2_ZArgs, pad, pad2)

// Tier 2 from the middle (`<ukl/middle_run.h>`), its scan phases (the mask 0x72f), the phase `args.phase`: its
// SIMD groups take the phase's items by ticket until none is left. The pool holds every value an item hands on (its header the host's layout); `t` is the writer's
// region, its state at 0, room reserved for the tape and its tail.
DEFINE_KERNEL2(tier2, json_t2_run_scan,
               ARGS,     json_t2_RArgs, args,    ,
               ROBUFFER, uint8_t,  src,     "[len + 64]",
               ROBUFFER, uint32_t, starts,  "[count + 3]",
               ROBUFFER, uint32_t, toks,    "[ntoks * 5]",
               RWBUFFER, uint32_t, pool,    "[pool]",
               RWBUFFER, uint8_t,  t,       "[region]",
               RWBUFFER, uint8_t,  rets,    "[runs * json_t2_DEPTH]",
               RWBUFFER, uint32_t, f1,      "[(count + 1 + runs) * 10]",
               RWBUFFER, uint32_t, touch,   "[(count + 1 + runs) * 2]",
               RWBUFFER, uint32_t, f2,      "[(count + 1 + runs) * 25]",
               ROBUFFER, uint32_t, lexed,   "[32]",
               RWBUFFER, uint32_t, meet,    "[5 * tn]",
               LANE,     uint16_t, lane,    )
{
    UklRun r;
    r.src = src;
    r.starts = starts;
    r.toks = toks;
    r.m = (UklMidPool)pool;
    r.t = t;
    r.rets = rets;
    r.f1 = f1;
    r.touch = touch;
    r.f2 = f2;
    r.meet = meet;
    r.phase = args.phase;
    // The records tier 1 found (`args.count` and `args.runs` bound them: the buffers' room).
    r.count = lexed[UKL_LEX_COUNT];
    r.refused = lexed[UKL_LEX_REFUSED];
    r.len = args.len;
    r.ntoks = r.count;
    r.size = args.size;
    r.runs = (r.count + args.size - 1u) / args.size;
    r.runs = r.runs == 0u ? 1u : r.runs;
    r.most = args.most;
    ukl_run_worker(&r, 1839u, lane __UKL_ARGS);
}

// Tier 2 from the middle (`<ukl/middle_run.h>`), its walk phases (the mask 0x10), the phase `args.phase`: its
// SIMD groups take the phase's items by ticket until none is left. The pool holds every value an item hands on (its header the host's layout); `t` is the writer's
// region, its state at 0, room reserved for the tape and its tail.
DEFINE_KERNEL2(tier2, json_t2_run_walk,
               ARGS,     json_t2_RArgs, args,    ,
               ROBUFFER, uint8_t,  src,     "[len + 64]",
               ROBUFFER, uint32_t, starts,  "[count + 3]",
               ROBUFFER, uint32_t, toks,    "[ntoks * 5]",
               RWBUFFER, uint32_t, pool,    "[pool]",
               RWBUFFER, uint8_t,  t,       "[region]",
               RWBUFFER, uint8_t,  rets,    "[runs * json_t2_DEPTH]",
               RWBUFFER, uint32_t, f1,      "[(count + 1 + runs) * 10]",
               RWBUFFER, uint32_t, touch,   "[(count + 1 + runs) * 2]",
               RWBUFFER, uint32_t, f2,      "[(count + 1 + runs) * 25]",
               ROBUFFER, uint32_t, lexed,   "[32]",
               RWBUFFER, uint32_t, meet,    "[5 * tn]",
               LANE,     uint16_t, lane,    )
{
    UklRun r;
    r.src = src;
    r.starts = starts;
    r.toks = toks;
    r.m = (UklMidPool)pool;
    r.t = t;
    r.rets = rets;
    r.f1 = f1;
    r.touch = touch;
    r.f2 = f2;
    r.meet = meet;
    r.phase = args.phase;
    // The records tier 1 found (`args.count` and `args.runs` bound them: the buffers' room).
    r.count = lexed[UKL_LEX_COUNT];
    r.refused = lexed[UKL_LEX_REFUSED];
    r.len = args.len;
    r.ntoks = r.count;
    r.size = args.size;
    r.runs = (r.count + args.size - 1u) / args.size;
    r.runs = r.runs == 0u ? 1u : r.runs;
    r.most = args.most;
    ukl_run_worker(&r, 16u, lane __UKL_ARGS);
}

// Tier 2 from the middle (`<ukl/middle_run.h>`), its write phases (the mask 0xc0), the phase `args.phase`: its
// SIMD groups take the phase's items by ticket until none is left. The pool holds every value an item hands on (its header the host's layout); `t` is the writer's
// region, its state at 0, room reserved for the tape and its tail.
DEFINE_KERNEL2(tier2, json_t2_run_write,
               ARGS,     json_t2_RArgs, args,    ,
               ROBUFFER, uint8_t,  src,     "[len + 64]",
               ROBUFFER, uint32_t, starts,  "[count + 3]",
               ROBUFFER, uint32_t, toks,    "[ntoks * 5]",
               RWBUFFER, uint32_t, pool,    "[pool]",
               RWBUFFER, uint8_t,  t,       "[region]",
               RWBUFFER, uint8_t,  rets,    "[runs * json_t2_DEPTH]",
               RWBUFFER, uint32_t, f1,      "[(count + 1 + runs) * 10]",
               RWBUFFER, uint32_t, touch,   "[(count + 1 + runs) * 2]",
               RWBUFFER, uint32_t, f2,      "[(count + 1 + runs) * 25]",
               ROBUFFER, uint32_t, lexed,   "[32]",
               RWBUFFER, uint32_t, meet,    "[5 * tn]",
               LANE,     uint16_t, lane,    )
{
    UklRun r;
    r.src = src;
    r.starts = starts;
    r.toks = toks;
    r.m = (UklMidPool)pool;
    r.t = t;
    r.rets = rets;
    r.f1 = f1;
    r.touch = touch;
    r.f2 = f2;
    r.meet = meet;
    r.phase = args.phase;
    // The records tier 1 found (`args.count` and `args.runs` bound them: the buffers' room).
    r.count = lexed[UKL_LEX_COUNT];
    r.refused = lexed[UKL_LEX_REFUSED];
    r.len = args.len;
    r.ntoks = r.count;
    r.size = args.size;
    r.runs = (r.count + args.size - 1u) / args.size;
    r.runs = r.runs == 0u ? 1u : r.runs;
    r.most = args.most;
    ukl_run_worker(&r, 192u, lane __UKL_ARGS);
}

// Tier 2 as phases (`<ukl/t2_phases.h>`), its phase `args.phase`: SIMD groups take the phase's items by ticket until
// none is left. Tier 1's pool says the records (`lexed`); the phases' pool holds the host's layout words, the trees and
// the arrays the phases write.
typedef struct json_t2_PArgs {
    uint32_t phase;
    uint32_t pad;
} json_t2_PArgs;
UKL_REFLECT_STRUCT(json_t2_PArgs, phase, pad)
DEFINE_KERNEL2(tier2, json_t2_phases,
               ARGS,     json_t2_PArgs, args,    ,
               ROBUFFER, uint8_t,  src,     "[len + 64]",
               ROBUFFER, uint32_t, starts,  "[count + 3]",
               ROBUFFER, uint32_t, lexed,   "[32]",
               RWBUFFER, uint32_t, pool,    "[pool]",
               RWBUFFER, uint32_t, meet,    "[trees * ms]",
               RWBUFFER, uint32_t, arrays,  "[arrays]",
               ROBUFFER, uint32_t, toks,    "[count * 5]",
               RWBUFFER, uint8_t,  rets,    "[chunks * json_t2_DEPTH]",
               RWBUFFER, uint8_t,  t,       "[region]",
               RWBUFFER, uint32_t, f2,      "[(count + 1 + chunks) * 25]",
               LANE,     uint16_t, lane,    )
{
    UklPh r;
    r.m = (UklPhPool)pool;
    r.meet = meet;
    r.phase = args.phase;
    r.src = src;
    r.starts = starts;
    r.arrays = arrays;
    r.toks = toks;
    r.rets = rets;
    r.t = t;
    r.f2 = f2;
    r.len = lexed[UKL_LEX_LEN];
    r.n = lexed[UKL_LEX_COUNT];
    r.refused = lexed[UKL_LEX_REFUSED] != 0u || lexed[UKL_LEX_SHORT] != 0u;
    r.z = (UKL_GLOBAL uint8_t*)0;
    r.table = (UKL_LOCAL uint32_t*)0;
    ukl_ph_worker(&r, lane __UKL_ARGS);
}

// The program's phases of group items (16z's ZP1 and ZP4): SIMD groups, a group a threadgroup, each its LZ4 table in
// threadgroup memory, taking an item at a time by ticket; 16z's tape at `z`.
DEFINE_KERNEL2(tier2, json_t2_zphases,
               ARGS,     json_t2_PArgs, args,    ,
               ROBUFFER, uint8_t,  src,     "[len + 64]",
               ROBUFFER, uint32_t, starts,  "[count + 3]",
               ROBUFFER, uint32_t, lexed,   "[32]",
               RWBUFFER, uint32_t, pool,    "[pool]",
               RWBUFFER, uint32_t, meet,    "[trees * ms]",
               RWBUFFER, uint32_t, arrays,  "[arrays]",
               RWBUFFER, uint8_t,  t,       "[region]",
               RWBUFFER, uint8_t,  z,       "[zroom]",
               SHARED,   uint32_t, table,   UKL_LZ4E_TABLE,
               LANE,     uint16_t, lane,    )
{
    UklPh r;
    r.m = (UklPhPool)pool;
    r.meet = meet;
    r.phase = args.phase;
    r.src = src;
    r.starts = starts;
    r.arrays = arrays;
    r.toks = (UKL_GLOBAL const uint32_t*)0;
    r.rets = (UKL_GLOBAL uint8_t*)0;
    r.t = t;
    r.f2 = (UKL_GLOBAL uint32_t*)0;
    r.z = z;
    r.table = table;
    r.len = lexed[UKL_LEX_LEN];
    r.n = lexed[UKL_LEX_COUNT];
    r.refused = lexed[UKL_LEX_REFUSED] != 0u || lexed[UKL_LEX_SHORT] != 0u;
    ukl_ph_worker_sg(&r, lane __UKL_ARGS);
}

// The finished tape stored as 16z where it lies (`<ukl/z16_run.h>`), its phase count: SIMD groups, a group a
// threadgroup, each its LZ4 table in threadgroup memory, taking the phase's items by ticket.
DEFINE_KERNEL2(tier2, json_t2_z_count,
               ARGS,     json_t2_ZArgs, args,    ,
               ROBUFFER, uint8_t,  t,       "[region]",
               RWBUFFER, uint8_t,  z,       "[zroom]",
               RWBUFFER, uint32_t, pool,    "[pool]",
               SHARED,   uint32_t, table,   UKL_LZ4E_TABLE,
               LANE,     uint16_t, lane,    )
{
    UklZ16 r;
    // The tape: the writer's region's OUT part, where the chain finished it.
    r.t = t + ukl_z16_u32(t, ukl_w_part_field(CLIF_W_PART_OUT, CLIF_W_AT_P_AT));
    r.z = z;
    r.m = (UklZ16Pool)pool;
    r.phase = 0u;
    r.table = table;
    ukl_z16_worker(&r, lane __UKL_ARGS);
}

// The finished tape stored as 16z where it lies (`<ukl/z16_run.h>`), its phase write: SIMD groups, a group a
// threadgroup, each its LZ4 table in threadgroup memory, taking the phase's items by ticket.
DEFINE_KERNEL2(tier2, json_t2_z_write,
               ARGS,     json_t2_ZArgs, args,    ,
               ROBUFFER, uint8_t,  t,       "[region]",
               RWBUFFER, uint8_t,  z,       "[zroom]",
               RWBUFFER, uint32_t, pool,    "[pool]",
               SHARED,   uint32_t, table,   UKL_LZ4E_TABLE,
               LANE,     uint16_t, lane,    )
{
    UklZ16 r;
    // The tape: the writer's region's OUT part, where the chain finished it.
    r.t = t + ukl_z16_u32(t, ukl_w_part_field(CLIF_W_PART_OUT, CLIF_W_AT_P_AT));
    r.z = z;
    r.m = (UklZ16Pool)pool;
    r.phase = 1u;
    r.table = table;
    ukl_z16_worker(&r, lane __UKL_ARGS);
}
#define json_t2_KEYS 256u
#define json_t2_STEP_PLACES 17u
#define json_t2_STEP_DEPTH json_t2_DEPTH
#define json_t2_STEP_REFUSED 255u
#define json_t2_STEP_ENDS 254u
#define json_t2_SHAPE_W 10u
#define json_t2_FRAME_W UKL_WMID_FRAME
UKL_INLINE uint32_t json_t2_bracket_code(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, uint32_t r)
{
if ((r >= n)) {
return json_t2_NONE;
}
return json_t2_bracket(src[((uint32_t)(starts[r]))]);
}

UKL_INLINE bool json_t2_empty_close_at(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, uint32_t r)
{
if ((r == 0u)) {
return false;
}
uint32_t x = json_t2_bracket_code(src, starts, n, r);
uint32_t y = json_t2_bracket_code(src, starts, n, (r - 1u));
return (((x != json_t2_NONE) && ((x % 2u) == 0u)) && (y == (x + 1u)));
}

UKL_INLINE void json_t2_p1_unit(UKL_COHERENT uint32_t* out)
{
(*(out + 0u)) = json_t2_D0;
(*(out + 1u)) = json_t2_D0;
(*(out + 2u)) = 0u;
}

UKL_INLINE void json_t2_p1_run(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, uint32_t a, uint32_t b, UKL_COHERENT uint32_t* out)
{
uint32_t d = json_t2_D0;
uint32_t m = json_t2_D0;
uint32_t k = 0u;
for (uint32_t r = a; r < b; r++) {
uint32_t x = json_t2_bracket_code(src, starts, n, r);
if ((x == json_t2_NONE)) {
k += 1u;
} else if (((x % 2u) == 1u)) {
d += 1u;
k += 2u;
} else {
d -= 1u;
k += 1u;
if ((d < m)) {
m = d;
}
}
}
(*(out + 0u)) = d;
(*(out + 1u)) = m;
(*(out + 2u)) = k;
}

UKL_INLINE void json_t2_p1_merge(UKL_COHERENT const uint32_t* a, UKL_COHERENT const uint32_t* b, UKL_COHERENT uint32_t* out)
{
uint32_t d = ((a[0u] + b[0u]) - json_t2_D0);
uint32_t mb = ((a[0u] + b[1u]) - json_t2_D0);
uint32_t m = ((mb < a[1u]) ? mb : a[1u]);
(*(out + 0u)) = d;
(*(out + 1u)) = m;
(*(out + 2u)) = (a[2u] + b[2u]);
}

UKL_INLINE void json_t2_p1_write(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, uint32_t a, uint32_t b, UKL_COHERENT const uint32_t* sum, UKL_GLOBAL uint32_t* depth, UKL_GLOBAL uint32_t* items, UKL_GLOBAL uint32_t* head_at)
{
uint32_t d = sum[0u];
uint32_t k = ((uint32_t)(sum[2u]));
for (uint32_t r = a; r < b; r++) {
(*(depth + r)) = d;
uint32_t x = json_t2_bracket_code(src, starts, n, r);
// The level of its item in the level order: its depth (an empty container's closer one less), at least 0.
uint32_t level = ((d > json_t2_D0) ? (d - json_t2_D0) : 0u);
if ((((x != json_t2_NONE) && ((x % 2u) == 0u)) && json_t2_empty_close_at(src, starts, n, r))) {
level = ((d > (json_t2_D0 + 1u)) ? ((d - json_t2_D0) - 1u) : 0u);
}
(*(items + (3u * k))) = level;
(*(items + ((3u * k) + 1u))) = ((uint32_t)(r));
(*(items + ((3u * k) + 2u))) = 0u;
k += 1u;
if (((x != json_t2_NONE) && ((x % 2u) == 1u))) {
(*(items + (3u * k))) = ((d - json_t2_D0) + 1u);
(*(items + ((3u * k) + 1u))) = ((uint32_t)(r));
(*(items + ((3u * k) + 2u))) = 1u;
k += 1u;
d += 1u;
} else {
(*(head_at + r)) = json_t2_NONE;
if ((x != json_t2_NONE)) {
d -= 1u;
}
}
}
}

UKL_INLINE void json_t2_add1_unit(UKL_COHERENT uint32_t* out)
{
(*out) = 0u;
}

UKL_INLINE void json_t2_add1_merge(UKL_COHERENT const uint32_t* a, UKL_COHERENT const uint32_t* b, UKL_COHERENT uint32_t* out)
{
(*out) = (a[0u] + b[0u]);
}

UKL_INLINE void json_t2_p2_unit(UKL_COHERENT uint32_t* out)
{
for (uint32_t g = 0u; g < json_t2_KEYS; g++) {
(*(out + g)) = 0u;
}
}

UKL_INLINE void json_t2_p2_merge(UKL_COHERENT const uint32_t* a, UKL_COHERENT const uint32_t* b, UKL_COHERENT uint32_t* out)
{
for (uint32_t g = 0u; g < json_t2_KEYS; g++) {
(*(out + g)) = (a[g] + b[g]);
}
}

UKL_INLINE void json_t2_p2_run(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, uint32_t shift, UKL_COHERENT uint32_t* out)
{
json_t2_p2_unit(out);
for (uint32_t x = a; x < b; x++) {
uint32_t g = ((uint32_t)(((items[(3u * x)] >> shift) & 0xffu)));
(*(out + g)) += 1u;
}
}

UKL_INLINE void json_t2_p2_write(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, uint32_t shift, UKL_COHERENT uint32_t* sum, UKL_GLOBAL const uint32_t* keys, UKL_GLOBAL uint32_t* out)
{
for (uint32_t x = a; x < b; x++) {
uint32_t g = ((uint32_t)(((items[(3u * x)] >> shift) & 0xffu)));
uint32_t at = ((uint32_t)((keys[g] + (*(sum + g)))));
(*(out + (3u * at))) = items[(3u * x)];
(*(out + ((3u * at) + 1u))) = items[((3u * x) + 1u)];
(*(out + ((3u * at) + 2u))) = items[((3u * x) + 2u)];
(*(sum + g)) += 1u;
}
}

UKL_INLINE bool json_t2_starts_level(UKL_GLOBAL const uint32_t* items, uint32_t x)
{
return ((x == 0u) || (items[(3u * (x - 1u))] != items[(3u * x)]));
}

UKL_INLINE void json_t2_last_unit(UKL_COHERENT uint32_t* out)
{
(*(out + 0u)) = 0u;
(*(out + 1u)) = json_t2_NONE;
}

UKL_INLINE void json_t2_last_merge(UKL_COHERENT const uint32_t* a, UKL_COHERENT const uint32_t* b, UKL_COHERENT uint32_t* out)
{
if ((b[0u] != 0u)) {
(*(out + 0u)) = b[0u];
(*(out + 1u)) = b[1u];
} else {
(*(out + 0u)) = a[0u];
(*(out + 1u)) = ((b[1u] != json_t2_NONE) ? b[1u] : a[1u]);
}
}

UKL_INLINE void json_t2_p3_run(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, UKL_COHERENT uint32_t* out)
{
uint32_t reset = 0u;
uint32_t v = json_t2_NONE;
for (uint32_t x = a; x < b; x++) {
bool head = (items[((3u * x) + 2u)] != 0u);
if (json_t2_starts_level(items, x)) {
reset = 1u;
v = json_t2_NONE;
}
if (head) {
v = items[((3u * x) + 1u)];
}
}
(*(out + 0u)) = reset;
(*(out + 1u)) = v;
}

UKL_INLINE void json_t2_p3_write(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, UKL_COHERENT const uint32_t* sum, UKL_GLOBAL uint32_t* container, UKL_GLOBAL uint32_t* head_at)
{
uint32_t v = sum[1u];
for (uint32_t x = a; x < b; x++) {
bool head = (items[((3u * x) + 2u)] != 0u);
uint32_t r = ((uint32_t)(items[((3u * x) + 1u)]));
if (json_t2_starts_level(items, x)) {
v = json_t2_NONE;
}
if (head) {
v = items[((3u * x) + 1u)];
(*(head_at + r)) = ((uint32_t)(x));
} else {
(*(container + r)) = v;
}
}
}

UKL_INLINE uint32_t json_t2_step_cont(uint32_t k)
{
return json_t2_step_cont_t(k);
}

UKL_INLINE uint32_t json_t2_walk_depth_at(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, UKL_GLOBAL const uint32_t* depth, uint32_t r)
{
uint32_t e = (json_t2_empty_close_at(src, starts, n, r) ? 1u : 0u);
return ((depth[r] >= (json_t2_D0 + e)) ? ((uint32_t)(((depth[r] - json_t2_D0) - e))) : 0u);
}

UKL_INLINE uint32_t json_t2_known_rets(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, UKL_GLOBAL const uint32_t* depth, UKL_GLOBAL const uint32_t* container, uint32_t low, uint32_t a, UKL_GLOBAL uint8_t* ret)
{
uint32_t wd = json_t2_walk_depth_at(src, starts, n, depth, a);
if ((wd > json_t2_STEP_DEPTH)) {
return 0u;
}
uint32_t e = (json_t2_empty_close_at(src, starts, n, a) ? 1u : 0u);
uint32_t below = (json_t2_D0 - low);
uint32_t closes = ((below >= e) ? ((uint32_t)((below - e))) : 0u);
uint32_t len = (closes < wd ? closes : wd);
// The open levels' openers, innermost first: the record's container, its container's, ...
uint32_t o = container[a];
for (uint32_t i = 1u; i < (len + 1u); i++) {
if ((o != json_t2_NONE)) {
o = container[((uint32_t)(o))];
}
uint32_t k = ((o != json_t2_NONE) ? (json_t2_bracket_code(src, starts, n, ((uint32_t)(o))) / 2u) : ((uint32_t)(json_t2_ROOT)));
ret[(wd - i)] = ((uint32_t)(json_t2_step_cont(((uint32_t)(k)))));
}
return len;
}

UKL_INLINE void json_t2_places_unit_w(UKL_COHERENT uint32_t* out)
{
for (uint32_t p = 0u; p < json_t2_STEP_PLACES; p++) {
(*(out + p)) = ((uint32_t)(p));
}
}

UKL_INLINE void json_t2_places_merge_w(UKL_COHERENT const uint32_t* a, UKL_COHERENT const uint32_t* b, UKL_COHERENT uint32_t* out)
{
for (uint32_t p = 0u; p < json_t2_STEP_PLACES; p++) {
uint32_t x = a[p];
(*(out + p)) = ((x < ((uint32_t)(json_t2_STEP_PLACES))) ? b[((uint32_t)(x))] : x);
}
}

UKL_INLINE void json_t2_shape_unit(UKL_COHERENT uint32_t* out)
{
for (uint32_t k = 0u; k < json_t2_SHAPE_W; k++) {
(*(out + k)) = 0u;
}
(*(out + 3u)) = json_t2_D0;
(*(out + 4u)) = json_t2_D0;
}

UKL_INLINE void json_t2_shape_merge(UKL_COHERENT const uint32_t* a, UKL_COHERENT const uint32_t* b, UKL_COHERENT uint32_t* out)
{
(*(out + 0u)) = (a[0u] + b[0u]);
(*(out + 1u)) = (a[1u] + b[1u]);
(*(out + 2u)) = (a[2u] + b[2u]);
(*(out + 3u)) = ((a[3u] + b[3u]) - json_t2_D0);
uint32_t lb = ((a[3u] + b[4u]) - json_t2_D0);
(*(out + 4u)) = ((lb < a[4u]) ? lb : a[4u]);
if ((b[7u] != 0u)) {
(*(out + 5u)) = b[5u];
(*(out + 6u)) = b[6u];
(*(out + 7u)) = 1u;
} else {
(*(out + 5u)) = a[5u];
(*(out + 6u)) = a[6u];
(*(out + 7u)) = a[7u];
}
if ((b[9u] != 0u)) {
(*(out + 8u)) = b[8u];
(*(out + 9u)) = 1u;
} else {
(*(out + 8u)) = a[8u];
(*(out + 9u)) = a[9u];
}
}

UKL_INLINE void json_t2_p8a_write(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, UKL_COHERENT const uint32_t* sum, UKL_GLOBAL uint32_t* frame_of)
{
uint32_t v = sum[1u];
for (uint32_t x = a; x < b; x++) {
if (json_t2_starts_level(items, x)) {
v = json_t2_NONE;
}
if ((items[((3u * x) + 2u)] != 0u)) {
v = items[((3u * x) + 1u)];
}
(*(frame_of + x)) = v;
}
}

UKL_INLINE void json_t2_kids_unit(UKL_COHERENT uint32_t* out)
{
(*(out + 0u)) = 0u;
(*(out + 1u)) = 0u;
(*(out + 2u)) = json_t2_NONE;
}

UKL_INLINE void json_t2_kids_merge(UKL_COHERENT const uint32_t* a, UKL_COHERENT const uint32_t* b, UKL_COHERENT uint32_t* out)
{
if ((b[0u] != 0u)) {
(*(out + 0u)) = b[0u];
(*(out + 1u)) = b[1u];
(*(out + 2u)) = b[2u];
} else {
(*(out + 0u)) = a[0u];
(*(out + 1u)) = (a[1u] + b[1u]);
(*(out + 2u)) = ((b[2u] != json_t2_NONE) ? b[2u] : a[2u]);
}
}

UKL_INLINE void json_t2_p8b_run(UKL_GLOBAL const uint32_t* items, UKL_GLOBAL const uint32_t* events, uint32_t a, uint32_t b, UKL_COHERENT uint32_t* out)
{
uint32_t reset = 0u;
uint32_t count = 0u;
uint32_t last = json_t2_NONE;
for (uint32_t x = a; x < b; x++) {
bool head = (items[((3u * x) + 2u)] != 0u);
if ((json_t2_starts_level(items, x) || head)) {
reset = 1u;
count = 0u;
last = json_t2_NONE;
}
if ((!head)) {
count += 1u;
last = events[((8u * ((uint32_t)(items[((3u * x) + 1u)]))) + 2u)];
}
}
(*(out + 0u)) = reset;
(*(out + 1u)) = count;
(*(out + 2u)) = last;
}

UKL_INLINE void json_t2_p8b_write(UKL_GLOBAL const uint32_t* items, UKL_GLOBAL const uint32_t* events, uint32_t a, uint32_t b, UKL_COHERENT const uint32_t* sum, UKL_GLOBAL uint32_t* kids)
{
uint32_t reset = sum[0u];
uint32_t count = sum[1u];
uint32_t last = sum[2u];
for (uint32_t x = a; x < b; x++) {
bool head = (items[((3u * x) + 2u)] != 0u);
if ((json_t2_starts_level(items, x) || head)) {
reset = 1u;
count = 0u;
last = json_t2_NONE;
}
if ((!head)) {
count += 1u;
last = events[((8u * ((uint32_t)(items[((3u * x) + 1u)]))) + 2u)];
}
(*(kids + (3u * x))) = reset;
(*(kids + ((3u * x) + 1u))) = count;
(*(kids + ((3u * x) + 2u))) = last;
}
}

UKL_INLINE uint32_t json_t2_chunk_frames(UKL_GLOBAL const uint32_t* eitems, uint32_t ne, UKL_GLOBAL const uint32_t* frame_of, UKL_GLOBAL const uint32_t* kids, UKL_GLOBAL const uint32_t* events, UKL_GLOBAL const uint32_t* at, uint32_t low, UKL_GLOBAL uint32_t* out)
{
uint32_t fd = ((uint32_t)((at[3u] - json_t2_D0)));
uint32_t up = ((uint32_t)(((json_t2_D0 + 1u) - low)));
uint32_t need = ((up < fd) ? up : fd);
uint32_t w = 0u;
for (uint32_t k = (fd - need); k < fd; k++) {
uint32_t level = ((uint32_t)((k + 1u)));
uint32_t lo = 0u;
uint32_t hi = ne;
while ((lo < hi)) {
uint32_t mid = ((lo + hi) / 2u);
uint32_t l = eitems[(3u * mid)];
if (((l < level) || ((l == level) && (eitems[((3u * mid) + 1u)] < at[1u])))) {
lo = (mid + 1u);
} else {
hi = mid;
}
}
uint32_t x = (lo - 1u);
bool head = (eitems[((3u * x) + 2u)] != 0u);
uint32_t o = ((uint32_t)(frame_of[x]));
(*(out + (json_t2_FRAME_W * w))) = events[((8u * o) + 2u)];
(*(out + ((json_t2_FRAME_W * w) + 1u))) = (head ? 0u : kids[((3u * x) + 1u)]);
(*(out + ((json_t2_FRAME_W * w) + 2u))) = (head ? json_t2_NONE : kids[((3u * x) + 2u)]);
(*(out + ((json_t2_FRAME_W * w) + 3u))) = events[((8u * o) + 4u)];
(*(out + ((json_t2_FRAME_W * w) + 4u))) = events[((8u * o) + 5u)];
w += 1u;
}
return w;
}

UKL_INLINE void ukl_ph_merge(uint32_t op, UKL_COHERENT const uint32_t* a, UKL_COHERENT const uint32_t* b, UKL_COHERENT uint32_t* out)
{
    if (op == UKL_T2_OP_P1)
        json_t2_p1_merge(a, b, out);
    else if (op == UKL_T2_OP_ADD1)
        json_t2_add1_merge(a, b, out);
    else if (op == UKL_T2_OP_KEYS)
        json_t2_p2_merge(a, b, out);
    else if (op == UKL_T2_OP_LAST)
        json_t2_last_merge(a, b, out);
    else if (op == UKL_T2_OP_PLACES)
        json_t2_places_merge_w(a, b, out);
    else if (op == UKL_T2_OP_SHAPE)
        json_t2_shape_merge(a, b, out);
    else if (op == UKL_T2_OP_KIDS)
        json_t2_kids_merge(a, b, out);
}
UKL_INLINE void ukl_ph_unit(uint32_t op, UKL_COHERENT uint32_t* out)
{
    if (op == UKL_T2_OP_P1)
        json_t2_p1_unit(out);
    else if (op == UKL_T2_OP_ADD1)
        json_t2_add1_unit(out);
    else if (op == UKL_T2_OP_KEYS)
        json_t2_p2_unit(out);
    else if (op == UKL_T2_OP_LAST)
        json_t2_last_unit(out);
    else if (op == UKL_T2_OP_PLACES)
        json_t2_places_unit_w(out);
    else if (op == UKL_T2_OP_SHAPE)
        json_t2_shape_unit(out);
    else if (op == UKL_T2_OP_KIDS)
        json_t2_kids_unit(out);
}
UKL_INLINE void ukl_t2_p1_run(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, uint32_t a, uint32_t b, UKL_COHERENT uint32_t* out) { json_t2_p1_run(src, starts, n, a, b, out); }
UKL_INLINE void ukl_t2_p2_run(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, uint32_t shift, UKL_COHERENT uint32_t* out) { json_t2_p2_run(items, a, b, shift, out); }
UKL_INLINE void ukl_t2_p2_write(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, uint32_t shift, UKL_COHERENT uint32_t* sum, UKL_GLOBAL const uint32_t* keys, UKL_GLOBAL uint32_t* out) { json_t2_p2_write(items, a, b, shift, sum, keys, out); }
UKL_INLINE void ukl_t2_p3_run(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, UKL_COHERENT uint32_t* out) { json_t2_p3_run(items, a, b, out); }
UKL_INLINE void ukl_t2_p3_write(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, UKL_COHERENT const uint32_t* sum, UKL_GLOBAL uint32_t* container, UKL_GLOBAL uint32_t* head_at) { json_t2_p3_write(items, a, b, sum, container, head_at); }
UKL_INLINE void ukl_t2_p8a_write(UKL_GLOBAL const uint32_t* items, uint32_t a, uint32_t b, UKL_COHERENT const uint32_t* sum, UKL_GLOBAL uint32_t* frame_of) { json_t2_p8a_write(items, a, b, sum, frame_of); }
UKL_INLINE void ukl_t2_p8b_run(UKL_GLOBAL const uint32_t* items, UKL_GLOBAL const uint32_t* events, uint32_t a, uint32_t b, UKL_COHERENT uint32_t* out) { json_t2_p8b_run(items, events, a, b, out); }
UKL_INLINE void ukl_t2_p8b_write(UKL_GLOBAL const uint32_t* items, UKL_GLOBAL const uint32_t* events, uint32_t a, uint32_t b, UKL_COHERENT const uint32_t* sum, UKL_GLOBAL uint32_t* kids) { json_t2_p8b_write(items, events, a, b, sum, kids); }
// P6 (`write_step`): chunk `a..b` from its state on the cursor from the middle, on the writer's region `t`: counting
// its side lists' entries (`count`), or writing them. Its frames (`chunk_frames`, from its sum `at` and its own
// shape's lowest frame depth `slow`) into its room, its levels (`known_rets`) in its row `ret`. Its stop: 0 at its
// end, 1 the file's end, 2 deeper than the walk goes, else 2 and its stop's kind.
UKL_INLINE uint32_t ukl_t2_write(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, uint32_t len, UKL_GLOBAL const uint8_t* t,
                                 UKL_GLOBAL const uint32_t* depth, UKL_GLOBAL const uint32_t* container, uint32_t low, uint32_t a, uint32_t b, uint32_t pl,
                                 UKL_GLOBAL uint8_t* ret, UKL_GLOBAL const uint32_t* eitems, uint32_t ne, UKL_GLOBAL const uint32_t* frame_of,
                                 UKL_GLOBAL const uint32_t* kids, UKL_GLOBAL const uint32_t* events, UKL_GLOBAL const uint32_t* at, uint32_t slow,
                                 UKL_GLOBAL uint32_t* room, bool count)
{
    uint32_t wd = json_t2_walk_depth_at(src, starts, n, depth, a);
    if (wd > json_t2_STEP_DEPTH)
        return 2u;
    json_t2_known_rets(src, starts, n, depth, container, low, a, ret);
    uint32_t nf = json_t2_chunk_frames(eitems, ne, frame_of, kids, events, at, slow, room);
    // Its room: the frames open at its entry, and as many as its records open (`5 * (span + 1)` frames).
    if (nf + 3u * (b - a) + 4u > 5u * (b - a + 1u))
        return 7u;
    json_t2_Lx lx;
    lx.starts = starts;
    lx.count = n;
    lx.len = len;
    json_t2_Entry en;
    en.i = a;
    en.e = at[9] != 0u ? at[8] : 0u;
    en.depth = wd;
    en.st = pl;
    uint64_t prev = at[7] != 0u ? (uint64_t)at[5] | ((uint64_t)at[6] << 32) : 0u;
    UklWMid d = ukl_wmid_resume(t, 0u, at[0], prev, room, nf, count);
    json_t2_Stop x = json_t2_run_step_Mid(src, lx, &d, en, ret, 0u, b);
    if (x.kind == 0u && x.en.i == b)
        return 0u;
    return x.kind == 2u ? 1u : 2u + x.kind;
}
UKL_INLINE uint32_t ukl_t2_places(void) { return json_t2_STEP_PLACES; }
UKL_INLINE uint32_t ukl_t2_depth(void) { return json_t2_DEPTH; }
UKL_INLINE uint32_t ukl_t2_walk_refused(void) { return json_t2_STEP_REFUSED; }
// P4 and P5: chunk `a..b` walked from place `pl` (`Phases::walk`), its known levels (`known_rets`, P1's lowest depth
// `low`, P3's containers) in its row of levels `ret`, each event folded into its shape `s` (`SHAPE_W` words) and where
// `write` written from its sum `at` (`<json_t2_Ev>`): its place past it, `STEP_REFUSED` or `STEP_ENDS`; the last token's
// end in its shape where it stops at a place.
UKL_INLINE uint32_t ukl_t2_walk(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, uint32_t len, UKL_GLOBAL const uint32_t* toks,
                                UKL_GLOBAL const uint32_t* depth, UKL_GLOBAL const uint32_t* container, uint32_t low, uint32_t a, uint32_t b, uint32_t pl,
                                UKL_GLOBAL uint8_t* ret, UKL_PRIVATE uint32_t* s, bool write, UKL_GLOBAL uint32_t* ev, UKL_GLOBAL uint32_t* items, UKL_COHERENT const uint32_t* at)
{
    for (uint32_t k = 0u; k < json_t2_SHAPE_W; k++)
        s[k] = 0u;
    s[3] = json_t2_D0;
    s[4] = json_t2_D0;
    uint32_t wd = json_t2_walk_depth_at(src, starts, n, depth, a);
    if (wd > json_t2_STEP_DEPTH)
        return json_t2_STEP_REFUSED;
    uint32_t known = json_t2_known_rets(src, starts, n, depth, container, low, a, ret);
    json_t2_Lx lx;
    lx.starts = starts;
    lx.count = n;
    lx.len = len;
    json_t2_Ev d;
    d.toks = toks;
    d.ntoks = n;
    d.s = s;
    d.ev = ev;
    d.items = items;
    d.at = at;
    d.write = write;
    json_t2_Entry en;
    en.i = a;
    en.e = json_t2_NONE;
    en.depth = wd;
    en.st = pl;
    json_t2_Stop x = json_t2_run_step_Ev(src, lx, &d, en, ret, wd - known, b);
    if (x.kind == 0u && x.en.i >= b) {
        if (x.en.e != json_t2_NONE) {
            s[8] = x.en.e;
            s[9] = 1u;
        }
        return x.en.st;
    }
    return x.kind == 2u ? json_t2_STEP_ENDS : json_t2_STEP_REFUSED;
}
UKL_INLINE void ukl_t2_p1_write(UKL_GLOBAL const uint8_t* src, UKL_GLOBAL const uint32_t* starts, uint32_t n, uint32_t a, uint32_t b, UKL_COHERENT const uint32_t* sum, UKL_GLOBAL uint32_t* depth, UKL_GLOBAL uint32_t* items, UKL_GLOBAL uint32_t* head_at) { json_t2_p1_write(src, starts, n, a, b, sum, depth, items, head_at); }
