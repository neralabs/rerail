               ARGS,     json_t2_TArgs, args,   ,
               ROBUFFER, uint8_t,  src,    "[n + 64]",
               ROBUFFER, uint32_t, starts, "[count + 3]",
               ROBUFFER, uint32_t, list,   "[n]",
               RWBUFFER, uint32_t, tokens, "[count * 5]",
               GID0,     uint32_t, j,      )
{
    if (j >= args.n)
        return;
    uint32_t r = list[j];
    uint32_t b = src[starts[r]];
    uint32_t t[5] = {0u, json_t2_NONE, 0u, 0u, json_t2_NONE};
    if (b == 0x22u || b == 0x74u || b == 0x66u || b == 0x6eu || b == 0x2du || (b >= 0x30u && b <= 0x39u)) {
        json_t2_Tok d;
        d.kind = 0u;
        d.nodes = 0u;
        d.last = 0u;
        uint32_t i = r;
        uint32_t nn[5] = {0u, 1u, 2u, 3u, 4u};
        json_t2_R x = json_t2_value_primitive_Tok(src, starts, &d, &i, nn);
        if (x.ok) {
            t[0] = x.v;
            t[1] = d.kind;
            t[2] = d.nodes;
            t[3] = d.last;
        } else {
            t[4] = x.v;
        }
    }
    for (uint32_t k = 0u; k < 5u; k++)
        tokens[r * 5u + k] = t[k];
}

typedef struct json_t2_WArgs {
    uint32_t chunks;
    uint32_t count;
    uint32_t len;
    uint32_t write;
} json_t2_WArgs;
UKL_REFLECT_STRUCT(json_t2_WArgs, chunks, count, len, write)

// Pass 2: chunk `c`'s nodes written from its state (`write_range`), pass 3's in the pool (`states[c]`), through a
// cursor from the middle on the writer's region `t` (its state at 0, its blocks made): counting its side-list entries
// (`args.write` 0), or writing them. The chunk's frames' room in `f` is placed by its first record and its number
// (`5 * (span + 1)` frames: those open at its entry, and as many as its records open); its levels in its row of `rets`.
// Where it stopped: `out`'s two words, its stop's kind and record (4: no state, 5: past its room, 6: after the end).
DEFINE_KERNEL2(tier2, json_t2_write,
               ARGS,     json_t2_WArgs, args,   ,
               ROBUFFER, uint8_t,  src,    "[len + 64]",
               ROBUFFER, uint32_t, starts, "[count + 3]",
               RWBUFFER, uint8_t,  t,      "[region]",
               ROBUFFER, uint32_t, chunks, "[chunks]",
               ROBUFFER, uint32_t, pool,   "[pool]",
               ROBUFFER, uint32_t, states, "[chunks]",
               RWBUFFER, uint32_t, f,      "[(count + 1 + chunks) * 25]",
               RWBUFFER, uint8_t,  rets,   "[chunks * json_t2_DEPTH]",
               RWBUFFER, uint32_t, out,    "[chunks * 2]",
               GID0,     uint32_t, c,      )
{
    if (c >= args.chunks)
        return;
    uint32_t a = states[c];
    out[c * 2u + 1u] = 0u;
    if (a >= UKL_MID_FULL || pool[a + 5u] != 0u) {
        out[c * 2u] = a >= UKL_MID_FULL ? 4u : 6u;
        return;
    }
    uint32_t start = chunks[c];
    uint32_t stop = c + 1u < args.chunks ? chunks[c + 1u] : args.count + 1u;
    uint32_t span = stop - start;
    uint32_t nret = pool[a + 9u], nf = pool[a + 10u];
    if (nf + 3u * span + 4u > 5u * (span + 1u)) {
        out[c * 2u] = 5u;
        return;
    }
    UKL_GLOBAL uint32_t* room = f + UKL_WMID_FRAME * 5u * (start + c);
    for (uint32_t k = 0u; k < nf * UKL_WMID_FRAME; k++)
        room[k] = pool[a + UKL_AT_HEAD + nret + k];
    UKL_GLOBAL uint8_t* ret = rets + c * json_t2_DEPTH;
    uint32_t base = pool[a + 2u] - nret;
    for (uint32_t k = 0u; k < nret; k++)
        ret[base + k] = (uint8_t)pool[a + UKL_AT_HEAD + k];
    json_t2_Lx lx;
    lx.starts = starts;
    lx.count = args.count;
    lx.len = args.len;
    json_t2_Entry en;
    en.i = pool[a];
    en.e = pool[a + 1u];
    en.depth = pool[a + 2u];
    en.st = pool[a + 3u];
    uint64_t prev = (uint64_t)pool[a + 7u] | ((uint64_t)pool[a + 8u] << 32);
    UklWMid d = ukl_wmid_resume(t, 0u, pool[a + 4u], prev, room, nf, args.write == 0u);
    json_t2_Stop r = json_t2_run_range_Mid(src, lx, &d, en, ret, 0u, stop);
    out[c * 2u] = r.kind;
    out[c * 2u + 1u] = r.en.i;
}

typedef struct json_t2_BArgs {
    uint32_t most;
    uint32_t end;
} json_t2_BArgs;
UKL_REFLECT_STRUCT(json_t2_BArgs, most, end)

// The tape's blocks made before pass 2 (`make_blocks`), a thread a block, as many as the file's end state's nodes
// fill (at most `most`), from the writer's region `t` (its state at 0).
DEFINE_KERNEL2(tier2, json_t2_blocks,
               ARGS,     json_t2_BArgs, args,   ,
               RWBUFFER, uint8_t,  t,      "[region]",
               ROBUFFER, uint32_t, pool,   "[pool]",
               ROBUFFER, uint32_t, states, "[end + 1]",
               GID0,     uint32_t, b,      )
{
    uint32_t a = states[args.end];
    if (a >= UKL_MID_FULL || pool[a + 5u] != 1u)
        return;
    uint32_t nb = (pool[a + 4u] + CLIF_W_Z - 1u) / CLIF_W_Z;
    nb = nb == 0u ? 1u : nb;
    if (b >= nb || nb > args.most)
        return;
    ukl_wmid_make_block(t, 0u, b);
    if (b == 0u)
        ukl_wmid_made(t, 0u, nb);
}

// The tape after pass 2 (`end_middle`), a thread a block: each side list's count, and the state's nodes and last start
// the file's end state's.
DEFINE_KERNEL2(tier2, json_t2_ended,
               ARGS,     json_t2_BArgs, args,   ,
               RWBUFFER, uint8_t,  t,      "[region]",
               ROBUFFER, uint32_t, pool,   "[pool]",
               ROBUFFER, uint32_t, states, "[end + 1]",
               GID0,     uint32_t, b,      )
{
    uint32_t a = states[args.end];
    if (a >= UKL_MID_FULL || pool[a + 5u] != 1u)
        return;
    uint32_t n = pool[a + 4u];
    uint32_t nb = (n + CLIF_W_Z - 1u) / CLIF_W_Z;
    nb = nb == 0u ? 1u : nb;
    if (b >= nb || nb > args.most)
        return;
    ukl_wmid_end_block(t, 0u, b);
    if (b == 0u)
        ukl_wmid_ended(t, 0u, n, (uint64_t)pool[a + 7u] | ((uint64_t)pool[a + 8u] << 32));
}

// Pass 1's room: what a chunk's walks keep of the writer's frames (its frames, `2 * span + 2`, in `f`; what it writes
// into its entry's, `span + 1`, in `touch`), and its levels' places in its row of `rets`.
typedef struct json_t2_LArgs {
    uint32_t chunks;
    uint32_t count;
    uint32_t len;
    uint32_t ntoks;
} json_t2_LArgs;
UKL_REFLECT_STRUCT(json_t2_LArgs, chunks, count, len, ntoks)

// The bracket scan's word of chunk `c` (`Word::of`): its records' first bytes, an opener pushed, a closer cancelling
// the innermost open or an anti-open. At `words[c]` (its offset in the pool), no walk.
DEFINE_KERNEL2(tier2, json_t2_words,
               ARGS,     json_t2_LArgs, args,   ,
               ROBUFFER, uint8_t,  src,    "[len + 64]",
               ROBUFFER, uint32_t, starts, "[count + 3]",
               ROBUFFER, uint32_t, chunks, "[chunks]",
               RWBUFFER, uint32_t, pool,   "[pool]",
               RWBUFFER, uint32_t, words,  "[nodes]",
               GID0,     uint32_t, c,      )
{
    if (c >= args.chunks)
        return;
    uint32_t start = chunks[c];
    uint32_t stop = c + 1u < args.chunks ? chunks[c + 1u] : args.count;
    uint32_t w = ukl_mid_take(pool, 3u + stop - start);
    words[c] = w;
    if (w == UKL_MID_FULL)
        return;
    pool[w] = 0u;
    pool[w + 1u] = 0u;
    pool[w + 2u] = 0u;
    for (uint32_t t = start; t < stop; t++) {
        uint32_t b = json_t2_bracket(src[starts[t]]);
        if (b == json_t2_NONE)
            continue;
        if ((b & 1u) != 0u) {
            pool[w + 3u + pool[w] + pool[w + 1u]] = b >> 1;
            pool[w + 1u] += 1u;
        } else {
            ukl_word_cancel(pool, w, b >> 1);
        }
    }
}

typedef struct json_t2_SArgs {
    uint32_t n;
    uint32_t low;
    uint32_t up;
    uint32_t end;
    uint32_t op;
} json_t2_SArgs;
UKL_REFLECT_STRUCT(json_t2_SArgs, n, low, up, end, op)

// A scan's composition (`op` 0: the bracket words', `Word::then`; 1: the spans', `Span::then`).
UKL_INLINE uint32_t json_t2_then(UklMidPool m, uint32_t op, uint32_t a, uint32_t b)
{
    if (a >= UKL_MID_FULL || b >= UKL_MID_FULL)
        return UKL_MID_FULL;
    return op == 0u ? ukl_word_then(m, a, b) : ukl_span_then(m, a, b);
}
// A scan's state after a value (`op` 0: the kinds after a word; 1: the state after a span).
UKL_INLINE uint32_t json_t2_after(UklMidPool m, uint32_t op, uint32_t a, uint32_t x)
{
    if (x >= UKL_MID_FULL)
        return UKL_MID_FULL;
    return op == 0u ? ukl_kinds_after(m, a, x, json_t2_ROOT) : ukl_at_after(m, a, x);
}
// A scan's state as a node's range reads it.
UKL_INLINE uint32_t json_t2_keep(UklMidPool m, uint32_t op, uint32_t a, uint32_t x)
{
    if (x >= UKL_MID_FULL)
        return a >= UKL_MID_FULL ? a : UKL_MID_FULL;
    return op == 0u ? ukl_kinds_keep(m, a, x) : ukl_at_keep(m, a, x);
}

// A scan's up-sweep (`tree_of`), a level a launch: node `i` of the level above `n` values (from node `low` of
// `tree`, an offset in the pool each) the composition of two of them, the last alone where they are odd, at node
// `up + i`.
DEFINE_KERNEL2(tier2, json_t2_up,
               ARGS,     json_t2_SArgs, args, ,
               RWBUFFER, uint32_t, pool, "[pool]",
               RWBUFFER, uint32_t, tree, "[nodes]",
               GID0,     uint32_t, i,    )
{
    if (i >= (args.n + 1u) / 2u)
        return;
    uint32_t a = tree[args.low + 2u * i];
    tree[args.up + i] = 2u * i + 1u < args.n ? json_t2_then(pool, args.op, a, tree[args.low + 2u * i + 1u]) : a;
}

// A scan's root (`down`): the file's start (the root's kinds, or the first state) as the top reads it, at
// `states[up]`, and the state after the whole file at `states[end]`.
DEFINE_KERNEL2(tier2, json_t2_root,
               ARGS,     json_t2_SArgs, args,   ,
               RWBUFFER, uint32_t, pool,   "[pool]",
               ROBUFFER, uint32_t, tree,   "[nodes]",
               RWBUFFER, uint32_t, states, "[nodes + 1]",
               GID0,     uint32_t, i,      )
{
    if (i != 0u)
        return;
    uint32_t start = UKL_MID_FULL;
    if (args.op == 0u) {
        start = ukl_mid_take(pool, 2u);
        if (start != UKL_MID_FULL) {
            pool[start] = 1u;
            pool[start + 1u] = json_t2_ROOT;
        }
    } else {
        start = ukl_at_new(pool, 0u, 0u);
    }
    uint32_t top = tree[args.up];
    states[args.end] = start >= UKL_MID_FULL ? start : json_t2_after(pool, args.op, start, top);
    states[args.up] = start >= UKL_MID_FULL ? start : json_t2_keep(pool, args.op, start, top);
}

// A scan's down-sweep (`down`), a level a launch: node `c` of a level of `n` (from node `low`) its state from its
// parent's (from node `up`): a left child's its parent's, a right child's its state through its left sibling's
// value, each as the node's range reads it.
DEFINE_KERNEL2(tier2, json_t2_down,
               ARGS,     json_t2_SArgs, args,   ,
               RWBUFFER, uint32_t, pool,   "[pool]",
               ROBUFFER, uint32_t, tree,   "[nodes]",
               RWBUFFER, uint32_t, states, "[nodes + 1]",
               GID0,     uint32_t, c,      )
{
    if (c >= args.n)
        return;
    uint32_t at = states[args.up + c / 2u];
    if (c % 2u == 1u)
        at = json_t2_after(pool, args.op, at, tree[args.low + c - 1u]);
    states[args.low + c] = json_t2_keep(pool, args.op, at, tree[args.low + c]);
}

// The span of a walk that stopped at `r` (`Span::of`), from its shadow `d`: its offset in the pool, or `UKL_MID_FULL`.
UKL_INLINE uint32_t json_t2_span_of(UklMidPool m, json_t2_Stop r, UKL_PRIVATE const json_t2_Sh* d)
{
    bool end = r.kind >= 2u;
    uint32_t nt = d->closed + 1u;
    uint32_t npf = end ? 0u : d->nown;
    uint32_t at = ukl_mid_take(m, UKL_SPAN_HEAD + 2u * nt + UKL_MID_FRAME * npf);
    if (at == UKL_MID_FULL)
        return at;
    m[at] = r.kind == 0u ? r.en.i : 0u;
    m[at + 1u] = r.kind == 0u ? r.en.e : 0u;
    m[at + 2u] = r.kind == 0u ? r.en.depth : 0u;
    m[at + 3u] = r.kind == 0u ? r.en.st : 0u;
    m[at + 4u] = d->n;
    m[at + 5u] = r.kind == 2u ? 1u : r.kind == 3u ? 2u : 0u;
    m[at + 6u] = r.kind == 3u ? r.err : 0u;
    m[at + 7u] = d->closed;
    m[at + 8u] = nt;
    m[at + 9u] = npf;
    m[at + 10u] = d->has_last ? (uint32_t)d->last_start : 0u;
    m[at + 11u] = d->has_last ? (uint32_t)(d->last_start >> 32) : 0u;
    m[at + 12u] = d->has_last ? 1u : 0u;
    uint32_t w = at + UKL_SPAN_HEAD;
    for (uint32_t k = 0u; k < nt; k++) {
        bool has = !end && k < d->ntouch;
        m[w++] = has ? d->touch[2u * k] : 0u;
        m[w++] = has ? d->touch[2u * k + 1u] : json_t2_NONE;
    }
    for (uint32_t k = 0u; k < UKL_MID_FRAME * npf; k++)
        m[w++] = d->own[k];
    return at;
}

// Pass 1 (`span`): chunk `c`'s one walk, from the place and the levels' places its open levels' kinds give (the
// bracket scan's `kinds[c]`; the levels it closes, its word's anti-opens, `words[c]`), so it never reads a level it
// does not know. Its span at `spans[c]`. A chunk with no kinds is after the file's refusal, as one deeper than the walk
// goes: its span ends at its first record.
DEFINE_KERNEL2(tier2, json_t2_spans,
               ARGS,     json_t2_LArgs, args,   ,
               ROBUFFER, uint8_t,  src,    "[len + 64]",
               ROBUFFER, uint32_t, starts, "[count + 3]",
               ROBUFFER, uint32_t, toks,   "[ntoks * 5]",
               ROBUFFER, uint32_t, chunks, "[chunks]",
               ROBUFFER, uint32_t, depths, "[chunks]",
               ROBUFFER, uint32_t, words,  "[chunks]",
               ROBUFFER, uint32_t, kinds,  "[chunks]",
               RWBUFFER, uint8_t,  rets,   "[chunks * json_t2_DEPTH]",
               RWBUFFER, uint32_t, f,      "[(count + 1 + chunks) * 10]",
               RWBUFFER, uint32_t, touch,  "[(count + 1 + chunks) * 2]",
               RWBUFFER, uint32_t, pool,   "[pool]",
               RWBUFFER, uint32_t, spans,  "[nodes]",
               GID0,     uint32_t, c,      )
{
    if (c >= args.chunks)
        return;
    uint32_t start = chunks[c];
    uint32_t stop = c + 1u < args.chunks ? chunks[c + 1u] : args.count + 1u;
    uint32_t depth0 = depths[c];
    uint32_t span = stop - start;
    uint32_t k = kinds[c], w = words[c];
    if (k == UKL_MID_FULL || w == UKL_MID_FULL) {
        spans[c] = UKL_MID_FULL;
        return;
    }
    json_t2_Sh d;
    d.toks = toks;
    d.ntoks = args.ntoks;
    d.n = 0u;
    d.own = f + UKL_MID_FRAME * 2u * (start + c);
    d.nown = 0u;
    d.most_own = 2u * span + 2u;
    d.touch = touch + 2u * (start + c);
    d.ntouch = 0u;
    d.most_touch = span + 1u;
    d.closed = 0u;
    d.last_start = 0u;
    d.has_last = false;
    d.full = false;
    json_t2_Stop r = json_t2_stop_err(starts[start]);
    bool walk = k != UKL_MID_NONE && depth0 <= json_t2_DEPTH;
    uint32_t st = 0u, known = 0u;
    if (walk) {
        uint32_t nk = pool[k], anti = pool[w];
        uint32_t inner = pool[k + nk];
        known = anti < nk - 1u ? anti : nk - 1u;
        known = known < depth0 ? known : depth0;
        if (start != 0u) {
            walk = inner != json_t2_ROOT;
            st = walk ? json_t2_cycle(inner) : 0u;
        }
        UKL_GLOBAL uint8_t* ret = rets + c * json_t2_DEPTH;
        for (uint32_t j = 0u; j < known; j++)
            ret[depth0 - 1u - j] = (uint8_t)json_t2_cont(pool[k + 1u + nk - 2u - j]);
    }
    if (walk) {
        json_t2_Lx lx;
        lx.starts = starts;
        lx.count = args.count;
        lx.len = args.len;
        json_t2_Entry en;
        en.i = start;
        en.e = 0u;
        en.depth = depth0;
        en.st = st;
        r = json_t2_run_range_Sh(src, lx, &d, en, rets + c * json_t2_DEPTH, depth0 - known, stop);
        // A level its word does not close: the walk closes a level only at a closer.
        if (r.kind == 1u) {
            r = json_t2_stop_err(starts[start]);
            d.n = 0u;
            d.nown = 0u;
            d.ntouch = 0u;
            d.closed = 0u;
            d.has_last = false;
        }
    }
    spans[c] = d.full ? UKL_MID_FULL : json_t2_span_of(pool, r, &d);
}

// Each chunk's state with its levels' places, those it closes (`entries`' last step), from its kinds: `ats[c]`, and
// the file's end at `ats[chunks]`.
DEFINE_KERNEL2(tier2, json_t2_levels,
               ARGS,     json_t2_SArgs, args,   ,
               RWBUFFER, uint32_t, pool,   "[pool]",
               ROBUFFER, uint32_t, words,  "[n]",
               ROBUFFER, uint32_t, kinds,  "[n]",
               ROBUFFER, uint32_t, states, "[end + 1]",
               RWBUFFER, uint32_t, ats,    "[n + 1]",
               GID0,     uint32_t, c,      )
{
    if (c > args.n)
        return;
    uint32_t a = states[c == args.n ? args.end : c];
    if (c == args.n || a >= UKL_MID_FULL || pool[a + 5u] != 0u || kinds[c] >= UKL_MID_FULL || words[c] >= UKL_MID_FULL) {
        ats[c] = a;
        return;
    }
    uint32_t k = kinds[c], nk = pool[k], anti = pool[words[c]], depth = pool[a + 2u];
    uint32_t known = anti < nk - 1u ? anti : nk - 1u;
    known = known < depth ? known : depth;
    uint32_t nf = pool[a + 10u];
    uint32_t at = ukl_at_new(pool, known, nf);
    if (at == UKL_MID_FULL) {
        ats[c] = at;
        return;
    }
    for (uint32_t x = 0u; x < 9u; x++)
        pool[at + x] = pool[a + x];
    for (uint32_t m = 0u; m < known; m++)
        pool[at + UKL_AT_HEAD + m] = json_t2_cont(pool[k + 1u + nk - 2u - (known - 1u - m)]);
    for (uint32_t x = 0u; x < UKL_MID_FRAME * nf; x++)
        pool[at + UKL_AT_HEAD + known + x] = pool[a + UKL_AT_HEAD + pool[a + 9u] + x];
    ats[c] = at;
}
