UKL_INLINE void json_t2_open_Sh(UKL_PRIVATE json_t2_Sh* d, uint32_t number, uint64_t start)
{
// SAFETY: the cursor's state's room is reserved for the run (`parse`).
json_t2_Sh_open(d, number, start);
}

UKL_INLINE void json_t2_leaf_Sh(UKL_PRIVATE json_t2_Sh* d, uint32_t number, uint64_t start, uint64_t end)
{
// SAFETY: as `open`'s.
