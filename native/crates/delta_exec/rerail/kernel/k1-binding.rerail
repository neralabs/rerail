// k1-binding (decision 0686): the first lowering. A filter (a negation or a comparison) is moved to just after the
// atom that binds the last of its variables; atoms keep their order. Its input is K-form (`k_`), its output K-form
// again (`k1_`).
//
// Nothing is dropped: a filter of no variable runs first; a filter with a variable no atom binds is put last, where
// the executor refuses the rule as it refuses one read so.
//
// Its strata are stated (the executor computes none): each head's stratum follows the strata of what it reads, one
// past a head it negates or reads.

stratum("in_atom", 1).
stratum("filter", 1).
stratum("bound_before", 2).
stratum("in_filter", 2).
stratum("binds", 3).
stratum("has_var", 3).
stratum("bound", 4).
stratum("waits", 4).
stratum("unbound", 5).
stratum("place", 6).
stratum("k1_rule", 7).
stratum("k1_step", 7).
stratum("k1_arg", 7).
stratum("k1_var", 7).
stratum("k1_str", 7).
stratum("k1_num", 7).
stratum("k1_wild", 7).
stratum("k1_fn", 7).
stratum("k1_order", 7).

// Variable v is an argument of atom step k.
in_atom(m, r, v, k) :- k_step(m, r, k, "atom", _), k_arg(m, r, k, _, t), k_var(m, t, v).
// A filter.
filter(m, r, f) :- k_step(m, r, f, "not", _).
filter(m, r, f) :- k_step(m, r, f, "cmp", _).

// v is an argument of an atom before atom k.
bound_before(m, r, v, k) :- in_atom(m, r, v, k), in_atom(m, r, v, j), j < k.
// A filter's variables.
in_filter(m, r, f, v) :- filter(m, r, f), k_arg(m, r, f, _, t), k_var(m, t, v).

// Atom k binds v: the first atom v is an argument of.
binds(m, r, v, k) :- in_atom(m, r, v, k), !bound_before(m, r, v, k).
// A filter with a variable.
has_var(m, r, f) :- in_filter(m, r, f, _).

// Some atom binds v.
bound(m, r, v) :- binds(m, r, v, _).
// Filter f's variable bound at k is not its last: another is bound at a later atom.
waits(m, r, f, k) :- in_filter(m, r, f, v), binds(m, r, v, k), in_filter(m, r, f, w), binds(m, r, w, j), k < j.

// Filter f has a variable no atom binds.
unbound(m, r, f) :- in_filter(m, r, f, v), !bound(m, r, v).

// Filter f runs after atom k: the one binding its last variable.
place(m, r, f, k) :- in_filter(m, r, f, v), binds(m, r, v, k), !waits(m, r, f, k), !unbound(m, r, f).

// The steps, numbered again: a filter of no variable at f, first; atom k at 2^20 (k + 1); a filter placed after
// atom p at 2^20 (p + 1) + 1 + f; a filter with an unbound variable at 2^40 + f, last.
k1_step(m, r, k * 1048576 + 1048576, "atom", x) :- k_step(m, r, k, "atom", x).
k1_arg(m, r, k * 1048576 + 1048576, i, t) :- k_step(m, r, k, "atom", _), k_arg(m, r, k, i, t).
k1_step(m, r, p * 1048576 + 1048577 + f, s, x) :- place(m, r, f, p), k_step(m, r, f, s, x).
k1_arg(m, r, p * 1048576 + 1048577 + f, i, t) :- place(m, r, f, p), k_arg(m, r, f, i, t).
k1_step(m, r, f, s, x) :- filter(m, r, f), !has_var(m, r, f), k_step(m, r, f, s, x).
k1_arg(m, r, f, i, t) :- filter(m, r, f), !has_var(m, r, f), k_arg(m, r, f, i, t).
k1_step(m, r, f + 1099511627776, s, x) :- unbound(m, r, f), k_step(m, r, f, s, x).
k1_arg(m, r, f + 1099511627776, i, t) :- unbound(m, r, f), k_arg(m, r, f, i, t).

// The rest as read.
k1_rule(m, r, h) :- k_rule(m, r, h).
k1_arg(m, r, -1, i, t) :- k_arg(m, r, -1, i, t).
k1_var(m, t, v) :- k_var(m, t, v).
k1_str(m, t, s) :- k_str(m, t, s).
k1_num(m, t, n) :- k_num(m, t, n).
k1_wild(m, t) :- k_wild(m, t).
k1_fn(m, t, op, l, r) :- k_fn(m, t, op, l, r).
k1_order(m, h, k) :- k_order(m, h, k).
