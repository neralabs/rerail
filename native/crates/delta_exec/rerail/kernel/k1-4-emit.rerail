// The fourth stratum (negates the third): the rules in K-form, a moved filter at key (p, f) after the atom p that binds
// its last variable, every other step where it was read, at (k, -1). No arithmetic (the rebuild plan, O2): steps run
// in (k, j) order, and (p, f) sorts after (p, -1) and before (p + 1, -1).
k_rule(d, r, h) :- read_rule(d, r, h).
k_step(d, r, p, f, s, x) :- place(d, r, f, p), read_step(d, r, f, -1, s, x).
k_step(d, r, k, -1, s, x) :- read_step(d, r, k, -1, s, x), !moved(d, r, k).
k_arg(d, r, p, f, i, t) :- place(d, r, f, p), read_arg(d, r, f, -1, i, t).
k_arg(d, r, k, j, i, t) :- read_arg(d, r, k, j, i, t), !moved(d, r, k).
k_var(d, t, v) :- read_var(d, t, v).
k_str(d, t, s) :- read_str(d, t, s).
k_num(d, t, n) :- read_num(d, t, n).
k_wild(d, t) :- read_wild(d, t).
// Strata are files, as at L2: a module's stratum its file's place, boot(path, k).
k_order(d, k) :- boot(p, k), doc(d, p, _).
