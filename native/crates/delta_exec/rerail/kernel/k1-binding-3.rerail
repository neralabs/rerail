// k1-binding, stratum 3 of 3: the lowered program.

// Filter f runs after atom k: the one binding its last variable.
place(m, r, f, k) :- in_filter(m, r, f, v), binds(m, r, v, k), !waits(m, r, f, k).

// The steps, numbered again: atom k at 16k, a filter f placed after atom p at 16p + 1 + f (a body of at most 8
// steps; K0 has no arithmetic, so the numbers are facts).
k1_step(m, r, k2, "atom", x) :- k_step(m, r, k, "atom", x), atom_at(k, k2).
k1_arg(m, r, k2, i, t) :- k_step(m, r, k, "atom", _), atom_at(k, k2), k_arg(m, r, k, i, t).
k1_step(m, r, k2, s, x) :- place(m, r, f, p), filter_at(p, f, k2), k_step(m, r, f, s, x).
k1_arg(m, r, k2, i, t) :- place(m, r, f, p), filter_at(p, f, k2), k_arg(m, r, f, i, t).

// The rest as read.
k1_rule(m, r, h) :- k_rule(m, r, h).
k1_arg(m, r, -1, i, t) :- k_arg(m, r, -1, i, t).
k1_var(m, t, v) :- k_var(m, t, v).
k1_str(m, t, s) :- k_str(m, t, s).
k1_num(m, t, n) :- k_num(m, t, n).
k1_wild(m, t) :- k_wild(m, t).
k1_order(m, k) :- k_order(m, k).

atom_at(0, 0). atom_at(1, 16). atom_at(2, 32). atom_at(3, 48). atom_at(4, 64). atom_at(5, 80). atom_at(6, 96). atom_at(7, 112).
filter_at(0, 0, 1). filter_at(0, 1, 2). filter_at(0, 2, 3). filter_at(0, 3, 4). filter_at(0, 4, 5). filter_at(0, 5, 6). filter_at(0, 6, 7). filter_at(0, 7, 8).
