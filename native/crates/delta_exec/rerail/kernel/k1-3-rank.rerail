// Each shared variable's column (negates the third): the least at 0, each next one past it, by the numbers' chain.
succ(d, x, v, w) :- gt(d, x, v, w), !between(d, x, v, w).
least(d, x, v) :- shared(d, x, v), !has_smaller(d, x, v).
rank(d, x, v, 0) :- least(d, x, v).
rank(d, x, w, m) :- rank(d, x, v, n), succ(d, x, v, w), next(n, m).
// An aggregate's own variables (no key), and its step's terms: the relation it folds (-1 for a body that is not one
// atom, which the executor refuses), its answer, its value (its answer's term for a `count` of none), then its atom's
// arguments from 3.
agg_own(d, t) :- agg_under(d, g, t), kind(d, t, "variable"), text(d, t, v), !agg_outer(d, g, v).
agg_rel(d, a, r) :- agg_atom(d, _, a), field(d, a, "relation", n), text(d, n, r).
agg_rel(d, b, -1) :- kind(d, g, "aggregate"), !agg_one(d, g), field(d, g, "body", b).
agg_arg(d, g, 0, a) :- agg_atom(d, g, a), kind(d, a, _).
agg_arg(d, g, 0, b) :- kind(d, g, "aggregate"), !agg_one(d, g), field(d, g, "body", b).
agg_arg(d, g, 1, g) :- kind(d, g, "aggregate").
agg_arg(d, g, 2, v) :- kind(d, g, "aggregate"), field(d, g, "value", v).
agg_arg(d, g, 2, g) :- kind(d, g, "aggregate"), !field(d, g, "value", _).
call_in(d, e, k, t) :- call_fn(d, e, _), field(d, e, "arguments", al), child(d, al, t, i), next(i, k).
agg_pat(d, g, k, t) :- agg_atom(d, g, a), field(d, a, "arguments", al), child(d, al, t, i), next(i, i1), next(i1, i2), next(i2, k).
