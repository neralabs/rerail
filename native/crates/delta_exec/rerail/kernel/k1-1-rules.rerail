// K1's rules (B§6, L3: "several heads", "disjunction split into rules"), a stratum negating the reader's: a clause is
// one rule for each head, named by the head; a clause whose body has one disjunction is one rule for each alternative,
// named by the alternative. A rule's steps are its literals, each at its node (k, -1): nodes number a tape in source
// order, so the steps of a group's alternative stand where the group was written, with no arithmetic (the rebuild plan,
// O2).
inst(d, c, h, h) :- head_of(d, c, h), !split(d, c).
inst(d, c, a, h) :- head_of(d, c, h), alt(d, c, a), !several(d, c).
inst(d, c, a, h) :- head_of(d, c, h), group_alt(d, c, _, a), !several(d, c), !groups(d, c).
read_rule(d, r, n) :- inst(d, _, r, h), field(d, h, "relation", x), text(d, x, n).
read_arg(d, r, -1, -1, i, a) :- inst(d, _, r, h), field(d, h, "arguments", l), child(d, l, a, i).
in_rule(d, r, l) :- inst(d, c, r, r), field(d, c, "body", b), field(d, b, "literal", l).
in_rule(d, r, l) :- inst(d, c, r, _), alt(d, c, r), field(d, r, "literal", l).
in_rule(d, r, l) :- inst(d, c, r, _), group_alt(d, c, _, r), field(d, r, "literal", l).
in_rule(d, r, l) :- inst(d, c, r, _), group_alt(d, c, _, r), field(d, c, "body", b), field(d, b, "literal", l).
read_step(d, r, l, -1, s, x) :- in_rule(d, r, l), lit_step(d, l, s, x).
// The argument's own node read, as the head's rule reads its own: a relation's rules are single-file or cross-file
// alike (B§3, sentence 5).
read_arg(d, r, l, -1, i, a) :- in_rule(d, r, l), lit_arg(d, l, i, a), kind(d, a, _).
