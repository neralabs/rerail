// The last stratum (negates the fifth): the rules in K-form, a step that moves at key (p, t) after the atom p that binds
// its last variable, t its turn there, every other step where it was read, at (k, -1). No arithmetic (the rebuild
// plan, O2): steps run in (k, j) order, and (p, t) sorts after (p, -1) and before (p + 1, -1).
k_rule(d, r, h) :- read_rule(d, r, h).
k_step(d, r, p, n, s, x) :- at(d, r, f, p), turn(d, r, f, n), read_step(d, r, f, -1, s, x).
k_step(d, r, k, -1, s, x) :- read_step(d, r, k, -1, s, x), !placed(d, r, k).
k_arg(d, r, p, n, i, t) :- at(d, r, f, p), turn(d, r, f, n), read_arg(d, r, f, -1, i, t).
k_arg(d, r, k, j, i, t) :- read_arg(d, r, k, j, i, t), !placed(d, r, k).
k_var(d, t, v) :- read_var(d, t, v).
k_str(d, t, s) :- read_str(d, t, s).
k_num(d, t, n) :- read_num(d, t, n).
k_wild(d, t) :- read_wild(d, t).
k_decl(d, r, i, t) :- read_decl(d, r, i, t).
