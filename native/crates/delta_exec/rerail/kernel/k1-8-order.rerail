// The fourth stratum (negates the third): an operator of constants alone goes first, at -1, before every step a
// node's key holds (the head's key, (-1, -1), is no step's). The steps at one place, in the order they run: a step
// under another before it (an operand before its operator, an operator before its filter), else in source order.
at(d, r, f, p) :- place(d, r, f, p).
at(d, r, e, -1) :- const_op(d, r, e).
// A step that moves where no atom binds its variables (an answer's do, `y = x + 1, z = y * 2`, or it has none) stays
// where it was written: after the last atom written before it, at -1 when none is. At one place with the steps under
// it, so an operand runs before its operator there, as for every place.
stays(d, r, f) :- mover(d, r, f), !moved(d, r, f), !const_op(d, r, f).
at(d, r, f, p) :- stays(d, r, f), atom_before(d, r, f, p), !later_atom(d, r, f, p).
at(d, r, f, -1) :- stays(d, r, f), !some_atom_before(d, r, f).
before(d, r, a, b) :- at(d, r, a, p), at(d, r, b, p), below(d, b, a).
before(d, r, a, b) :- at(d, r, a, p), at(d, r, b, p), a < b, !below(d, a, b).
twixt(d, r, a, b) :- before(d, r, a, c), before(d, r, c, b).
not_first(d, r, b) :- before(d, r, _, b).
