// Includes resolved (bootstrap.rerail's phase 0, at L4; L4-g option 1): the program's files are its roots,
// `root(path, module)`, each loaded, and every `#include` of a loaded file asks for the file it names, until none is
// new (the level's rounds). An include's candidates, in order: the library's (`p0_lib(dir)`), then its file's own
// directory. Existence is the load answer's: a candidate is asked, and a miss is a row of `missing`. The second
// candidate is asked only once the first missed, so no file loads that its include does not resolve to.
load(p, m, "rr") :- root(p, m).
load(c, c, "rr") :- p0_cand(_, _, _, 1, c).
// A pattern's code (L4-h, c-16), a text the load answer parses.
load(t, t, "rr") :- pat(_, _, t).
load(c, c, "rr") :- p0_cand(f, at, n, 2, c), p0_cand(f, at, n, 1, l), missing(l).
// What each loaded file names: its includes, at their offsets, and `core.rerail` first for a root not in T's shape.
p0_names(f, at, n) :- kind(d, i, "include"), field(d, i, "path", p), value(d, p, n), doc(d, f, _), node(d, i, _, at, _).
p0_from(f, at, n) :- p0_names(f, at, n).
p0_from(f, -1, "core.rerail") :- root(f, _), doc(d, f, _), !p0_declares_doc(d).
p0_cand(f, at, n, 1, c) :- p0_from(f, at, n), p0_lib(l), c = @join(l, n).
p0_cand(f, at, n, 2, c) :- p0_from(f, at, n), c = @join(@dir(f), n).
// The first candidate that is there: one read as a document, the ones before it missing.
p0_resolved(f, at, n, c) :- p0_cand(f, at, n, 1, c), doc(_, c, _), !missing(c).
p0_resolved(f, at, n, c) :- p0_cand(f, at, n, 2, c), p0_cand(f, at, n, 1, l), missing(l), doc(_, c, _), !missing(c).
p0_found(f, at, n) :- p0_resolved(f, at, n, _).
// The outputs: each include's file, each candidate that is not there (a file appearing there changes the graph),
// and the include graph between files.
p0_include(f, at, n, c) :- p0_resolved(f, at, n, c).
p0_absent(c) :- p0_cand(_, _, _, _, c), missing(c).
p0_includes(a, b) :- p0_resolved(a, _, _, b), a != b.
p0_reach(a, b) :- p0_includes(a, b).
p0_reach(a, c) :- p0_reach(a, b), p0_includes(b, c).
