// A pattern's rule, as K-form's rows read them (c-10 writes them), in the code's module: its terms are the code's
// node p's, `p * 16 + slot`:
//   0 p's variable (a metavariable's name at its first node; else `~v` and p), 1 its kind, 2 its place,
//   3 its text, 4 its value, 5 its field, 6 its children's count, 7 a wildcard, 8 the document's variable `~d`,
//   9 its last child's place, 10 a child's place from the end, 11 that place in the node it matches, 12 a name
//   two nodes share, 13 one, 14 the place after the last, 15 the fewest children a `$$$` list matches.
// Its head: the document, its root, then each metavariable by its column. Its steps at node p, at (p, j), in the
// tree's order (a node's id is after its parent's, so its parent is bound first):
//   0, 1  p from its parent: `child` at its place (after a `$$$`, its place from the end), else `field`;
//   2     its kind, unless it is a metavariable (the root's, any kind);
//   3, 4  its text or value; a metavariable's later node, the same text as its first;
//   5     no more children than the code's, unless they hold a `$$$`;
//   6-9   for a list with children after its `$$$`: its last child, and at least as many as the code's others.
p_real(pd, p) :- p_in(pd, _, p), !p_mv(pd, p, _), !p_many(pd, p).
p_pre(pd, r, q, p, i) :- p_child(pd, r, q, p, i), !p_many(pd, p), !p_after(pd, q, p, _).
p_suf(pd, r, q, p, e) :- p_child(pd, r, q, p, _), !p_many(pd, p), p_after(pd, q, p, e).
p_kinded(pd, r, p, t) :- p_in(pd, r, p), p_real(pd, p), t = p * 16 + 1.
p_kinded(pd, r, r, t) :- p_root(pd, _, r), p_mv(pd, r, _), t = r * 16 + 7.
p_again(pd, r, p, f) :- p_var(pd, r, x, p), p_first(pd, r, x, f), p != f.
p_tail(pd, r, q, n) :- p_in(pd, r, q), p_after(pd, q, _, _), p_last(pd, q, l), n = l - 1.
p_count(pd, p, n) :- p_last(pd, p, i), n = i + 1.
p_count(pd, p, 0) :- p_leaf(pd, p).
// Its head.
p_arg(pd, r, -1, -1, 0, t) :- p_root(pd, _, r), !p_bad(pd, r), kind(pd, r, _), t = r * 16 + 8.
p_arg(pd, r, -1, -1, 0, t) :- p_root(pd, _, r), p_bad(pd, r), kind(pd, r, _), t = r * 16 + 12.
p_arg(pd, r, -1, -1, 1, t) :- p_root(pd, _, r), kind(pd, r, _), t = r * 16.
p_arg(pd, r, -1, -1, i, t) :- p_first(pd, r, x, p), p_rank(pd, r, x, n), kind(pd, p, _), i = n + 2, t = p * 16.
// 0, 1: from its parent.
p_step(pd, r, p, 1, "atom", "child") :- p_pre(pd, r, _, p, _), kind(pd, p, _).
p_arg(pd, r, p, 1, 0, t) :- p_pre(pd, r, _, p, _), kind(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 1, 1, t) :- p_pre(pd, r, q, p, _), kind(pd, p, _), t = q * 16.
p_arg(pd, r, p, 1, 2, t) :- p_pre(pd, r, _, p, _), kind(pd, p, _), t = p * 16.
p_arg(pd, r, p, 1, 3, t) :- p_pre(pd, r, _, p, _), kind(pd, p, _), t = p * 16 + 2.
p_knum(pd, t, i) :- p_pre(pd, _, _, p, i), kind(pd, p, _), t = p * 16 + 2.
p_step(pd, r, p, 0, "atom", "-") :- p_suf(pd, r, _, p, _), kind(pd, p, _).
p_arg(pd, r, p, 0, 0, t) :- p_suf(pd, r, q, p, _), kind(pd, p, _), t = q * 16 + 9.
p_arg(pd, r, p, 0, 1, t) :- p_suf(pd, r, _, p, _), kind(pd, p, _), t = p * 16 + 10.
p_arg(pd, r, p, 0, 2, t) :- p_suf(pd, r, _, p, _), kind(pd, p, _), t = p * 16 + 11.
p_knum(pd, t, e) :- p_suf(pd, _, _, p, e), kind(pd, p, _), t = p * 16 + 10.
p_kvar(pd, t, s) :- p_suf(pd, _, _, p, _), kind(pd, p, _), s = @cat("~i", @to_string(p)), t = p * 16 + 11.
p_step(pd, r, p, 1, "atom", "child") :- p_suf(pd, r, _, p, _), kind(pd, p, _).
p_arg(pd, r, p, 1, 0, t) :- p_suf(pd, r, _, p, _), kind(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 1, 1, t) :- p_suf(pd, r, q, p, _), kind(pd, p, _), t = q * 16.
p_arg(pd, r, p, 1, 2, t) :- p_suf(pd, r, _, p, _), kind(pd, p, _), t = p * 16.
p_arg(pd, r, p, 1, 3, t) :- p_suf(pd, r, _, p, _), kind(pd, p, _), t = p * 16 + 11.
p_step(pd, r, p, 1, "atom", "field") :- p_field(pd, r, _, _, p), kind(pd, p, _).
p_arg(pd, r, p, 1, 0, t) :- p_field(pd, r, _, _, p), kind(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 1, 1, t) :- p_field(pd, r, q, _, p), kind(pd, p, _), t = q * 16.
p_arg(pd, r, p, 1, 2, t) :- p_field(pd, r, _, _, p), kind(pd, p, _), t = p * 16 + 5.
p_arg(pd, r, p, 1, 3, t) :- p_field(pd, r, _, _, p), kind(pd, p, _), t = p * 16.
p_kstr(pd, t, f) :- p_field(pd, _, _, f, p), kind(pd, p, _), t = p * 16 + 5.
// 2: its kind.
p_step(pd, r, p, 2, "atom", "kind") :- p_kinded(pd, r, p, _), kind(pd, p, _).
p_arg(pd, r, p, 2, 0, t) :- p_kinded(pd, r, p, _), kind(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 2, 1, t) :- p_kinded(pd, r, p, _), kind(pd, p, _), t = p * 16.
p_arg(pd, r, p, 2, 2, t) :- p_kinded(pd, r, p, t), kind(pd, p, _).
p_kstr(pd, t, k) :- p_real(pd, p), kind(pd, p, k), t = p * 16 + 1.
// 3, 4: its text or value, or a metavariable's name again.
p_step(pd, r, p, 3, "atom", "text") :- p_in(pd, r, p), p_real(pd, p), text(pd, p, _).
p_arg(pd, r, p, 3, 0, t) :- p_in(pd, r, p), p_real(pd, p), text(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 3, 1, t) :- p_in(pd, r, p), p_real(pd, p), text(pd, p, _), t = p * 16.
p_arg(pd, r, p, 3, 2, t) :- p_in(pd, r, p), p_real(pd, p), text(pd, p, _), t = p * 16 + 3.
p_kstr(pd, t, s) :- p_real(pd, p), text(pd, p, s), t = p * 16 + 3.
p_step(pd, r, p, 3, "atom", "value") :- p_in(pd, r, p), p_real(pd, p), value(pd, p, _).
p_arg(pd, r, p, 3, 0, t) :- p_in(pd, r, p), p_real(pd, p), value(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 3, 1, t) :- p_in(pd, r, p), p_real(pd, p), value(pd, p, _), t = p * 16.
p_arg(pd, r, p, 3, 2, t) :- p_in(pd, r, p), p_real(pd, p), value(pd, p, _), t = p * 16 + 4.
p_kstr(pd, t, v) :- p_real(pd, p), value(pd, p, v), !kind(pd, p, "number"), t = p * 16 + 4.
p_knum(pd, t, v) :- p_real(pd, p), value(pd, p, v), kind(pd, p, "number"), t = p * 16 + 4.
p_step(pd, r, p, 3, "atom", "text") :- p_again(pd, r, p, _), kind(pd, p, _).
p_arg(pd, r, p, 3, 0, t) :- p_again(pd, r, p, _), kind(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 3, 1, t) :- p_again(pd, r, p, _), kind(pd, p, _), t = p * 16.
p_arg(pd, r, p, 3, 2, t) :- p_again(pd, r, p, _), kind(pd, p, _), t = p * 16 + 12.
p_step(pd, r, p, 4, "atom", "text") :- p_again(pd, r, p, _), kind(pd, p, _).
p_arg(pd, r, p, 4, 0, t) :- p_again(pd, r, p, _), kind(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 4, 1, t) :- p_again(pd, r, p, f), kind(pd, p, _), t = f * 16.
p_arg(pd, r, p, 4, 2, t) :- p_again(pd, r, p, _), kind(pd, p, _), t = p * 16 + 12.
p_kvar(pd, t, s) :- p_again(pd, _, p, _), kind(pd, p, _), s = @cat("~s", @to_string(p)), t = p * 16 + 12.
// 5: no more children.
p_step(pd, r, p, 5, "not", "child") :- p_in(pd, r, p), p_real(pd, p), kind(pd, p, _), !p_many_at(pd, p, _).
p_arg(pd, r, p, 5, 0, t) :- p_in(pd, r, p), p_real(pd, p), kind(pd, p, _), !p_many_at(pd, p, _), t = r * 16 + 8.
p_arg(pd, r, p, 5, 1, t) :- p_in(pd, r, p), p_real(pd, p), kind(pd, p, _), !p_many_at(pd, p, _), t = p * 16.
p_arg(pd, r, p, 5, 2, t) :- p_in(pd, r, p), p_real(pd, p), kind(pd, p, _), !p_many_at(pd, p, _), t = p * 16 + 7.
p_arg(pd, r, p, 5, 3, t) :- p_in(pd, r, p), p_real(pd, p), kind(pd, p, _), !p_many_at(pd, p, _), t = p * 16 + 6.
p_knum(pd, t, n) :- p_real(pd, p), p_count(pd, p, n), kind(pd, p, _), t = p * 16 + 6.
// 6-9: a list with children after its `$$$`: its last child's place l (no child at l + 1), l at least the fewest.
p_step(pd, r, q, 6, "atom", "child") :- p_tail(pd, r, q, _), kind(pd, q, _).
p_arg(pd, r, q, 6, 0, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = r * 16 + 8.
p_arg(pd, r, q, 6, 1, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16.
p_arg(pd, r, q, 6, 2, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 7.
p_arg(pd, r, q, 6, 3, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 9.
p_step(pd, r, q, 7, "atom", "+") :- p_tail(pd, r, q, _), kind(pd, q, _).
p_arg(pd, r, q, 7, 0, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 9.
p_arg(pd, r, q, 7, 1, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 13.
p_arg(pd, r, q, 7, 2, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 14.
p_step(pd, r, q, 8, "not", "child") :- p_tail(pd, r, q, _), kind(pd, q, _).
p_arg(pd, r, q, 8, 0, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = r * 16 + 8.
p_arg(pd, r, q, 8, 1, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16.
p_arg(pd, r, q, 8, 2, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 7.
p_arg(pd, r, q, 8, 3, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 14.
p_step(pd, r, q, 9, "cmp", ">=") :- p_tail(pd, r, q, _), kind(pd, q, _).
p_arg(pd, r, q, 9, 0, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 9.
p_arg(pd, r, q, 9, 1, t) :- p_tail(pd, r, q, _), kind(pd, q, _), t = q * 16 + 15.
p_knum(pd, t, 1) :- p_tail(pd, _, q, _), kind(pd, q, _), t = q * 16 + 13.
p_knum(pd, t, n) :- p_tail(pd, _, q, n), kind(pd, q, _), t = q * 16 + 15.
p_kvar(pd, t, s) :- p_tail(pd, _, q, _), kind(pd, q, _), s = @cat("~l", @to_string(q)), t = q * 16 + 9.
p_kvar(pd, t, s) :- p_tail(pd, _, q, _), kind(pd, q, _), s = @cat("~m", @to_string(q)), t = q * 16 + 14.
// Its variables and wildcards.
p_kvar(pd, t, "~d") :- p_root(pd, _, r), kind(pd, r, _), t = r * 16 + 8.
p_kvar(pd, t, "a list of two $$$") :- p_root(pd, _, r), p_bad(pd, r), kind(pd, r, _), t = r * 16 + 12.
p_kvar(pd, t, x) :- p_first(pd, _, x, p), kind(pd, p, _), t = p * 16.
p_kvar(pd, t, s) :- p_in(pd, _, p), !p_first(pd, _, _, p), kind(pd, p, _), s = @cat("~v", @to_string(p)), t = p * 16.
p_kwild(pd, t) :- p_in(pd, _, p), kind(pd, p, _), t = p * 16 + 7.
// The literal's side: each metavariable's term in its clause (the first that names it; none: a wildcard).
pat_mvterm(d, m, n, u) :- pat_mv(d, m, x, n), mv_use(d, m, x, u), !mv_later(d, m, x, u).
pat_mvwild(d, m, n) :- pat_mv(d, m, x, n), !mv_use(d, m, x, _).
