// The passes' per-rule rewrite group (the program-bistate page's §4: "which rules match the rewrite's pattern"),
// today's constant folding: each variable a rule's body equates to a constant (`v = "s"`, `3 = v`) is that constant,
// in the head and every step, and the equation goes. A variable equated to two is left as it is (its equations are
// its filters), and so is one with a term another rule has too (a disjunction's rules share their nodes, and a
// term's value is the module's). This stratum: the equations and the variables' terms.
const_term(d, t) :- read_str(d, t, _) ; read_num(d, t, _).
eq_const(d, r, f, v, c) :- read_step(d, r, f, -1, "cmp", "="), read_arg(d, r, f, -1, 0, a), read_var(d, a, v), read_arg(d, r, f, -1, 1, c), const_term(d, c).
eq_const(d, r, f, v, c) :- read_step(d, r, f, -1, "cmp", "="), read_arg(d, r, f, -1, 1, a), read_var(d, a, v), read_arg(d, r, f, -1, 0, c), const_term(d, c).
two_eq(d, r, v) :- eq_const(d, r, f, v, _), eq_const(d, r, g, v, _), f != g.
var_term(d, r, v, t) :- read_arg(d, r, _, _, _, t), read_var(d, t, v).
fold_shared(d, r, v) :- var_term(d, r, v, t), read_arg(d, q, _, _, _, t), q != r.
