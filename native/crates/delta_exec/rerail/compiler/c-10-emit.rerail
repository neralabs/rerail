// The last stratum (negates the fifth): the rules in K-form, a step that moves at key (p, t) after the atom p that binds
// its last variable, t its turn there, every other step where it was read, at (k, -1): steps run in (k, j) order,
// and (p, t) sorts after (p, -1) and before (p + 1, -1).
// A phase's file (c-21..c-23) is written through its map: its relations renamed, its fact space its own.
k_rule(d, r, h) :- read_rule(d, r, h), !ph_module(d).
k_rule(d, r, n) :- read_rule(d, r, h), ph_own(d, h, n).
k_step(d, r, p, n, s, x) :- at(d, r, f, p), turn(d, r, f, n), read_step(d, r, f, -1, s, x), !ph_module(d).
k_step(d, r, p, n, s, y) :- at(d, r, f, p), turn(d, r, f, n), read_step(d, r, f, -1, s, x), ph_step(d, s, x, y).
k_step(d, r, k, -1, s, x) :- read_step(d, r, k, -1, s, x), !placed(d, r, k), !ph_module(d).
k_step(d, r, k, -1, s, y) :- read_step(d, r, k, -1, s, x), !placed(d, r, k), ph_step(d, s, x, y).
k_arg(d, r, p, n, i, t) :- at(d, r, f, p), turn(d, r, f, n), read_arg(d, r, f, -1, i, t).
k_arg(d, r, k, j, i, t) :- read_arg(d, r, k, j, i, t), !placed(d, r, k).
k_var(d, t, v) :- read_var(d, t, v), !is_text(d).
k_str(d, t, s) :- read_str(d, t, s), !is_text(d).
k_str(d, t, s) :- agg_rel(d, t, s), !is_text(d), !ph_module(d).
k_str(d, t, y) :- agg_rel(d, t, s), ph_rel(d, s, y).
k_num(d, t, n) :- read_num(d, t, n), !is_text(d).
k_wild(d, t) :- read_wild(d, t), !is_text(d).
k_decl(d, r, i, t) :- read_decl(d, r, i, t), !is_text(d), !ph_module(d).
k_decl(d, y, i, t) :- read_decl(d, r, i, t), ph_rel(d, r, y), i != -1.
k_decl(d, r, -1, t) :- read_decl(d, r, -1, t), ph_module(d).
// A phase's refusals (c-23): a rule of the module whose head variable, named by why, no step binds.
k_rule(d, x, h) :- ph_refuse(d, x, h, _).
k_arg(d, x, -1, -1, 0, x) :- ph_refuse(d, x, _, _).
k_var(d, x, m) :- ph_refuse(d, x, _, m).
// Each pattern's rule (L4-h, c-20), in its code's module.
k_rule(pd, r, s) :- p_rule(pd, r, s).
k_step(pd, r, k, j, s, x) :- p_step(pd, r, k, j, s, x).
k_arg(pd, r, k, j, i, t) :- p_arg(pd, r, k, j, i, t).
k_var(pd, t, v) :- p_kvar(pd, t, v).
k_str(pd, t, s) :- p_kstr(pd, t, s).
k_num(pd, t, n) :- p_knum(pd, t, n).
k_wild(pd, t) :- p_kwild(pd, t).
