// Phase programs (c-21), what each phase asks and owns. A file asks for each phase it reads (not its own): the phase's
// file in the phase programs' directory (`p0_phase`, c-14 loads it as an include). A phase's own relations are those
// its file writes: an export is renamed `<phase>__<export>`, any other `<phase>/<name>`.
ph_cand(f, p, c) :- ph_named(d, _, p, _), !ph_name(d, p), doc(d, f, _), p0_phase_lib(l), c = @join(l, @cat(p, ".rerail")).
p0_phase(f, p, c) :- ph_cand(f, p, c).
ph_own(d, h, n) :- ph_name(d, p), read_rule(d, _, h), ph_export(d, h), n = @cat(p, "__", h).
ph_own(d, h, n) :- ph_name(d, p), read_rule(d, _, h), !ph_export(d, h), n = @cat(p, "/", h).
ph_owned(d, h) :- ph_own(d, h, _).
// The relations a phase's file names: its reads (an atom's, a negation's, an aggregate's) and its declarations (a
// column's, and `widen`'s; a lattice's place -1 names a lattice).
ph_used(d, x) :- ph_module(d), read_step(d, _, _, -1, "atom", x).
ph_used(d, x) :- ph_module(d), read_step(d, _, _, -1, "not", x).
ph_used(d, x) :- ph_module(d), agg_rel(d, _, x).
ph_used(d, r) :- ph_module(d), read_decl(d, r, i, _), i != -1.
// Refused (as today's runner refuses them): a read of a relation a phase does not export, and an export with a node
// column (an export names symbols, never nodes: an edit renumbers a node).
ph_unexported(d, x, p, e) :- ph_named(d, x, p, e), doc(d, f, _), ph_cand(f, p, c), doc(pd, c, _), ph_name(pd, p), !ph_export(pd, e).
ph_node_export(pd, x, p, e) :- ph_name(pd, p), ph_export(pd, e), ph_decl(pd, x, e), read_decl(pd, e, _, "node").
