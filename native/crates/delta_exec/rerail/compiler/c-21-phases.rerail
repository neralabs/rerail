// Phase programs (B§6's L4 row: "the passes … as phases"; B§8: "an export may hold several programs: the user's phase
// DAG"; decision 0083 §1; today's `phases.rs` and `bootstrap.rerail`'s `p0_phase`). A phase program is a file that
// names itself and the relations it hands on:
//
//   .phase struct                          .decl struct__binds(m: symbol, x: symbol, t: symbol)
//   .export def, binds                     r(m, x) :- struct__binds(m, x, _).
//
// A file that declares `<phase>__<export>` reads phase `<phase>`'s export: the phase's file, `<phase>.rerail` in the
// phase programs' directory (`p0_phase_lib(dir)`), loads as an include does. The phase runs in a fact space of its
// own: the relations its file writes are renamed (c-22, c-23), an export to `<phase>__<export>` and any other to
// `<phase>/<name>`, which no rule can name. So a reader sees only the exports, and the module graph (c-11) puts the
// phase before its readers, the phase DAG's order. The files a phase includes are modules as any include's are.
//
// What a file is: a phase (`.phase p`, a setting), its exports (`.export e, …`), and the relations it declares.
ph_name(d, p) :- kind(d, s, "setting"), field(d, s, "name", w), text(d, w, "phase"), field(d, s, "argument", a), text(d, a, p).
ph_module(d) :- ph_name(d, _).
ph_export(d, e) :- kind(d, s, "setting"), field(d, s, "name", w), text(d, w, "export"), field(d, s, "argument", a), kind(d, a, "identifier"), text(d, a, e).
ph_decl(d, x, r) :- kind(d, x, "declaration"), field(d, x, "name", n), text(d, n, r).
// A declared relation of a phase: `<phase>__<export>`, the phase no typing program's or the engine's own.
ph_named(d, x, p, e) :- ph_decl(d, x, r), p = @before(r, "__"), e = @after(r, "__"), p != "", e != "", @substr(p, 0, 7) != "typing_", @substr(p, 0, 3) != "rr_".
