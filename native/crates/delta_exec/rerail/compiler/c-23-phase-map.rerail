// Phase programs (c-21, c-22), the rename as a map: each relation a phase's file names, to its name in the program,
// its own renamed and any other as it is; and the steps it reads (an atom's and a negation's relation; a call's
// function, a comparison's operator as they are). c-10 writes the program through it, and c-11's graph reads it.
ph_rel(d, x, n) :- ph_own(d, x, n).
ph_rel(d, x, x) :- ph_used(d, x), !ph_owned(d, x).
ph_step(d, "atom", x, y) :- read_step(d, _, _, -1, "atom", x), ph_rel(d, x, y).
ph_step(d, "not", x, y) :- read_step(d, _, _, -1, "not", x), ph_rel(d, x, y).
ph_step(d, s, x, x) :- ph_module(d), read_step(d, _, _, -1, s, x), s != "atom", s != "not".
// A refusal, as a rule of the module, `<path>: refused`, whose head variable no step binds, named by why (the executor
// refuses it so).
ph_refuse(d, x, h, m) :- ph_unexported(d, x, p, e), doc(d, f, _), h = @cat(f, ": refused"), m = @cat("phase ", p, " does not export ", e, " (a phase's other relations are its own)").
ph_refuse(d, x, h, m) :- ph_node_export(d, x, p, e), doc(d, f, _), h = @cat(f, ": refused"), m = @cat("phase ", p, "'s export ", e, " has a node column (an export names symbols, never nodes)").
