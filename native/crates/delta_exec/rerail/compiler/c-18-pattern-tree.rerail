// A pattern's root: the first node of its selector's kind in the code, else the first on the chain that has not one
// child; the nodes of its tree, each under its parent by a counted child's place, else by a field (an operator).
p_root(pd, "", p) :- chain(pd, p), kind(pd, p, _), !p_one(pd, p).
p_root(pd, k, p) :- sel(pd, k), kind(pd, p, k), !sel_later(pd, k, p).
p_in(pd, r, r) :- p_root(pd, _, r), kind(pd, r, _).
p_in(pd, r, c) :- p_in(pd, r, p), child(pd, p, c, _).
p_in(pd, r, c) :- p_in(pd, r, p), field(pd, p, _, c).
p_child(pd, r, q, p, i) :- p_in(pd, r, q), child(pd, q, p, i).
p_field(pd, r, q, f, p) :- p_in(pd, r, q), field(pd, q, f, p), !child(pd, q, p, _).
// Its metavariables (by name; `_` names none), each one's nodes, and their order.
p_var(pd, r, x, p) :- p_in(pd, r, p), p_mv(pd, p, x), x != "_".
p_var_later(pd, r, x, p) :- p_var(pd, r, x, p), p_var(pd, r, x, q), q < p.
p_vgt(pd, r, x, y) :- p_var(pd, r, x, _), p_var(pd, r, y, _), x < y.
// A child after its list's `$$$`, by its place from the list's end; a list of two `$$$` has no rule (its head's
// document is a variable nothing binds, which the executor refuses, naming it).
p_after(pd, q, p, e) :- child(pd, q, p, i), p_many_at(pd, q, a), i > a, p_last(pd, q, l), e = l - i.
p_two(pd, q) :- p_many_at(pd, q, a), p_many_at(pd, q, b), a < b.
p_bad(pd, r) :- p_in(pd, r, q), p_two(pd, q).
// Each literal's root, and its relation, named by its code's path and its root (a tape's `name` names only a clause,
// a disjunction, a group and an expression).
pat_root(d, m, pd, r) :- pat_doc(d, m, pd), pat_sel(d, m, k), p_root(pd, k, r).
pat_root(d, m, pd, r) :- pat_doc(d, m, pd), !pat_sel(d, m, _), p_root(pd, "", r).
pat_rel(d, m, s) :- pat_root(d, m, pd, r), doc(pd, t, _), s = @cat("~", t, "@", @to_string(r)).
