// The compiler's reader (decision 0686; Bootstrap from one tape, §6, L4; B§10 step 9): the kernel's K1 reader
// (kernel/k1-1-read) written in the language the kernel lowers, so the compiler reads its own files (the
// self-hosting check: P4 reading compiler/ gives P4). What a file says, read from its tape, for the lowering after it.
//
// A clause's heads (several heads: one rule each), and the disjunction at the top of its body (split into rules,
// one an alternative).
head_of(d, c, h) :- kind(d, c, "clause"), field(d, c, "head", h).
several(d, c) :- head_of(d, c, h), head_of(d, c, g), h < g.
alt(d, c, a) :- kind(d, c, "clause"), field(d, c, "body", b), kind(d, b, "disjunction"), field(d, b, "alternative", a).
// A group, wherever it is: each alternative of its disjunction, or its one conjunction.
group_alt(d, g, a) :- kind(d, g, "group"), field(d, g, "body", x), kind(d, x, "disjunction"), field(d, x, "alternative", a).
group_alt(d, g, x) :- kind(d, g, "group"), field(d, g, "body", x), kind(d, x, "conjunction").
split(d, c) :- alt(d, c, _).
// A disjunction made a relation of its own (K1-b), named by its node (the `name` view): each group, and a top-level
// disjunction under several heads. Each of its alternatives is a rule of it.
aux_alt(d, x, a) :- group_alt(d, x, a), kind(d, x, "group").
aux_alt(d, b, a) :- alt(d, c, a), several(d, c), field(d, c, "body", b).
scope(d, x) :- aux_alt(d, x, _).
// The nodes under a scope, and under a clause; a variable's later occurrences under a scope.
under(d, x, y) :- scope(d, x), field(d, x, _, y).
under(d, x, z) :- under(d, x, y), field(d, y, _, z).
in_clause(d, c, y) :- kind(d, c, "clause"), field(d, c, _, y).
in_clause(d, c, z) :- in_clause(d, c, y), field(d, y, _, z).
// The nodes a scope lies under, up to its clause.
up(d, x, p) :- scope(d, x), field(d, p, _, x).
up(d, x, q) :- up(d, x, p), field(d, q, _, p).
later(d, x, v, t) :- under(d, x, t), read_var(d, t, v), under(d, x, u), read_var(d, u, v), u < t.
// A literal, wherever it is: its step (kind and relation, or a comparison's operator) and its arguments.
lit_step(d, l, "atom", r) :- kind(d, l, "atom"), field(d, l, "relation", n), text(d, n, r).
lit_arg(d, l, i, a) :- kind(d, l, "atom"), field(d, l, "arguments", al), child(d, al, a, i).
lit_step(d, l, "not", r) :- kind(d, l, "negation"), field(d, l, "operand", o), field(d, o, "relation", n), text(d, n, r).
lit_arg(d, l, i, a) :- kind(d, l, "negation"), field(d, l, "operand", o), field(d, o, "arguments", al), child(d, al, a, i).
lit_step(d, l, "cmp", op) :- kind(d, l, "comparison"), field(d, l, "operator", o), text(d, o, op).
lit_arg(d, l, 0, a) :- kind(d, l, "comparison"), field(d, l, "left", a).
lit_arg(d, l, 1, a) :- kind(d, l, "comparison"), field(d, l, "right", a).
lit_step(d, x, "atom", s) :- scope(d, x), name(d, x, s).
// What a term is.
read_var(d, t, v) :- kind(d, t, "variable"), text(d, t, v).
// Arithmetic (K1-a): an expression is a variable of its own, named by its node, its operator's answer; parentheses
// are the term inside them.
expr(d, e) :- kind(d, e, "binary_expression") ; kind(d, e, "unary_expression") ; kind(d, e, "aggregate") ; kind(d, e, "functor_call") ; kind(d, e, "call").
read_var(d, e, s) :- expr(d, e), name(d, e, s).
paren(d, p, e) :- kind(d, p, "parenthesized_expression"), field(d, p, "expression", e).
read_var(d, p, v) :- paren(d, p, e), read_var(d, e, v), kind(d, p, _).
read_str(d, p, s) :- paren(d, p, e), read_str(d, e, s), kind(d, p, _).
read_num(d, p, n) :- paren(d, p, e), read_num(d, e, n), kind(d, p, _).
// Each expression's step: its operator, its operands, its answer last. `-` of one operand is 0 minus it.
op_step(d, e, op) :- kind(d, e, "binary_expression"), field(d, e, "operator", o), text(d, o, op).
op_step(d, e, "-") :- kind(d, e, "unary_expression").
op_arg(d, e, 0, a) :- kind(d, e, "binary_expression"), field(d, e, "left", a).
op_arg(d, e, 1, a) :- kind(d, e, "binary_expression"), field(d, e, "right", a).
op_arg(d, e, 2, e) :- kind(d, e, "binary_expression").
op_arg(d, e, 0, a) :- kind(d, e, "unary_expression"), field(d, e, "operand", a).
op_arg(d, e, 1, e) :- kind(d, e, "unary_expression").
// A call (step 9, L4-f option 3), `@f(…)` or `f(…)`: an expression, a step of kind `call` naming its function, its
// answer first (the executor puts it last), its arguments after it.
call_fn(d, e, f) :- kind(d, e, "functor_call"), field(d, e, "function", n), text(d, n, f).
call_fn(d, e, f) :- kind(d, e, "call"), field(d, e, "function", n), text(d, n, f).
op_arg(d, e, 0, e) :- call_fn(d, e, _), kind(d, e, _).
op_arg(d, e, k, t) :- call_fn(d, e, _), field(d, e, "arguments", al), child(d, al, t, i), k = i + 1.
// The nodes in a literal's or a head's terms (no scope lies there).
term_root(d, l) :- kind(d, l, "atom") ; kind(d, l, "negation") ; kind(d, l, "comparison") ; head_of(d, _, l), kind(d, l, _).
in_term(d, l, y) :- term_root(d, l), field(d, l, _, y).
in_term(d, l, z) :- in_term(d, l, y), !kind(d, y, "aggregate"), field(d, y, _, z).
// An aggregate (step 9, L4-f): a step of its operator, tagged so no relation is named it (`count` implied where no
// operator is written), the nodes under it, and its body's literals.
op_step(d, g, "count:") :- kind(d, g, "aggregate"), !field(d, g, "operator", _).
op_step(d, g, "count:") :- kind(d, g, "aggregate"), field(d, g, "operator", o), kind(d, o, "count").
op_step(d, g, "sum:") :- kind(d, g, "aggregate"), field(d, g, "operator", o), kind(d, o, "sum").
op_step(d, g, "min:") :- kind(d, g, "aggregate"), field(d, g, "operator", o), kind(d, o, "min").
op_step(d, g, "max:") :- kind(d, g, "aggregate"), field(d, g, "operator", o), kind(d, o, "max").
op_step(d, g, "mean:") :- kind(d, g, "aggregate"), field(d, g, "operator", o), kind(d, o, "mean").
agg_under(d, g, t) :- kind(d, g, "aggregate"), field(d, g, _, t).
agg_under(d, g, u) :- agg_under(d, g, t), field(d, t, _, u).
agg_lit(d, g, l) :- kind(d, g, "aggregate"), field(d, g, "body", b), field(d, b, "literal", l).
agg_multi(d, g) :- agg_lit(d, g, a), agg_lit(d, g, b), a < b.
read_str(d, t, s) :- kind(d, t, "string"), value(d, t, s).
read_num(d, t, n) :- kind(d, t, "number"), value(d, t, n).
read_wild(d, t) :- kind(d, t, "wildcard").
// A declaration (K1-d): its relation's columns, each by its place and its type's name.
read_decl(d, r, i, t) :- kind(d, x, "declaration"), field(d, x, "name", n), text(d, n, r), field(d, x, "columns", l), child(d, l, c, i), field(d, c, "type", y), field(d, y, "name", tn), text(d, tn, t).
