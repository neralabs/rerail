// bootstrap-l0 (decision 0686; Bootstrap from one tape, §4 and §5): the rules that read a K0 file's tape into
// K-form, and the rule that orders the bootstrap's modules. The K0 pass (L1, in Rust) reads this file into the
// same rows these rules give when run over it: P2 reads P2.
// A view's first column is its document; a K-form row's first column is its module, the document it was read from.
// A step is at key (k, -1) as read; the head at (-1, -1).

// A clause is a rule: its head's relation.
k_rule(d, c, h) :- kind(d, c, "clause"), field(d, c, "head", hd), field(d, hd, "relation", n), text(d, n, h).
// The head's arguments.
k_arg(d, c, -1, -1, i, a) :- kind(d, c, "clause"), field(d, c, "head", hd), field(d, hd, "arguments", l), child(d, l, a, i).
// A body is a conjunction: its k-th literal is step k. An atom joins.
k_step(d, c, k, -1, "atom", r) :- kind(d, c, "clause"), field(d, c, "body", b), child(d, b, l, k), kind(d, l, "atom"), field(d, l, "relation", n), text(d, n, r).
k_arg(d, c, k, -1, i, a) :- kind(d, c, "clause"), field(d, c, "body", b), child(d, b, l, k), kind(d, l, "atom"), field(d, l, "arguments", al), child(d, al, a, i).
// A negated atom is an anti-join.
k_step(d, c, k, -1, "not", r) :- kind(d, c, "clause"), field(d, c, "body", b), child(d, b, l, k), kind(d, l, "negation"), field(d, l, "operand", o), field(d, o, "relation", n), text(d, n, r).
k_arg(d, c, k, -1, i, a) :- kind(d, c, "clause"), field(d, c, "body", b), child(d, b, l, k), kind(d, l, "negation"), field(d, l, "operand", o), field(d, o, "arguments", al), child(d, al, a, i).
// A comparison filters: its operator, its left and right terms.
k_step(d, c, k, -1, "cmp", op) :- kind(d, c, "clause"), field(d, c, "body", b), child(d, b, l, k), kind(d, l, "comparison"), field(d, l, "operator", o), text(d, o, op).
k_arg(d, c, k, -1, 0, a) :- kind(d, c, "clause"), field(d, c, "body", b), child(d, b, l, k), kind(d, l, "comparison"), field(d, l, "left", a).
k_arg(d, c, k, -1, 1, a) :- kind(d, c, "clause"), field(d, c, "body", b), child(d, b, l, k), kind(d, l, "comparison"), field(d, l, "right", a).
// What a term is.
k_var(d, t, v) :- kind(d, t, "variable"), text(d, t, v).
k_str(d, t, s) :- kind(d, t, "string"), value(d, t, s).
k_num(d, t, n) :- kind(d, t, "number"), value(d, t, n).
k_wild(d, t) :- kind(d, t, "wildcard").

// Strata are files: a bootstrap module's stratum is its file's place in the bootstrap, boot(path, k). The bootstrap
// has its own relation; load is the engine's, load(path, module, grammar), and there is no separate strata fact.
k_order(d, k) :- boot(p, k), doc(d, p, _).

// The kernel's files, one a stratum, come as boot rows with its files (rebuild plan, M10).
