// The delta executor's operations (decision 0686, Operations §3): each one's interface, declared once
// (`<ukl/operation.h>`). The registry's table of interfaces is read from here (`build.rs`), and every version of an
// operation, its twin first, is registered against its interface.
#pragma once
#include <ukl/operation.h>

// rerail_delta_exec::answer
DECLARE_KERNEL2(delta_exec, answer_load,
    ROBUFFER, ukl_control_block, plan, "[block]",
    RWBUFFER, ukl_tape_block, tapes, "[block]",
    RWBUFFER, ukl_control_block, control, "[block]",
    WOBUFFER, ukl_facts_block, facts, "[block]",
    ARGS, NoParams, p, )

// rerail_delta_exec::answer
DECLARE_KERNEL2(delta_exec, parse,
    RWBUFFER, ukl_tape_block, tapes, "[block]",
    RWBUFFER, ukl_control_block, control, "[block]",
    ARGS, NoParams, p, )

