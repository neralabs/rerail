// `intern` (`rerail_delta_twins::intern`): a document's names into the store's atoms, each node's symbols into its
// symbols block. The hash phase (an item a node) finds each node's names and marks the rest; the scan (one item, in
// node order) makes them, so new ids follow node order. The document is read where it lies (`<ukl/delta/rr.h>`).
#include <ukl/delta/atoms.h>
#include <ukl/delta/rr.h>

// The launch's blocks: the source's, the tape's, the atoms, the symbols block and the language's table.
UKL_INLINE Rr doc_of(CBlk t, UKL_GLOBAL const uint32_t* slots, UKL_GLOBAL const uint8_t* p) {
    InternP q = PARAMS(InternP);
    return rr_of(SLOT(0), q.src_at, SLOT(1), q.tape_at, SLOT(3), SLOT(4));
}

UKL_INLINE uint32_t syms_n(CBlk syms) { return (uint32_t)U64(syms, SYMS_N_AT); }

// What a node names: its text (`make`: an identifier's or a variable's; else an operator's, found only) and its
// value (a string's body), each `has` when it names one.
typedef struct Names {
    Text text, value;
    bool has_text, make, has_value;
} Names;

UKL_INLINE Names names_of(UKL_PRIVATE const Rr* r, uint32_t n) {
    uint32_t k = rr_kind(r, n);
    Names m;
    m.text = rr_text(r, n);
    m.make = k == KIND_IDENTIFIER || k == KIND_VARIABLE;
    m.has_text = m.make || (k >= FIRST_ANONYMOUS && rr_leaf(r, n));
    m.has_value = rr_string(r, n, &m.value);
    return m;
}

// The hash phase: each node's names found, the rest marked (SYM_NEW, SYM_FIND). It writes no atom.
DELTA_COUNT(intern_hash_items) { return syms_n(SLOT(3)); }
DELTA_LANES(intern_hash)
{
    DELTA_ITEM(n);
    Rr r = doc_of(t, slots, p);
    Atoms atoms = atoms_of(SLOT(2));
    Names m = names_of(&r, n);
    uint32_t tx = 0u, vx = 0u;
    if (m.has_text) {
        tx = atoms_find(atoms, m.text, atom_hash(m.text));
        if (tx == NONE) tx = m.make ? SYM_NEW : SYM_FIND;
    }
    if (m.has_value) {
        vx = atoms_find(atoms, m.value, atom_hash(m.value));
        if (vx == NONE) vx = SYM_NEW;
    }
    Blk syms = SLOT(3);
    uint64_t at = rr_sym_at(&r, n);
    U32(syms, at) = tx;
    U32(syms, at + 4u) = vx;
}

// Bytes `at..end` of block `b`, as written.
UKL_INLINE Text text_in(CBlk b, uint32_t at, uint32_t end) { Text x = {b, at, end, false}; return x; }

// The language's names, interned once: on the first run that finds its last one missing.
UKL_INLINE void intern_language(Atoms atoms, CBlk lang) {
    uint32_t nn = rr_lang_names(lang);
    Text last = rr_lang_name(lang, nn - 1u);
    if (atoms_find(atoms, last, atom_hash(last)) != NONE) return;
    for (uint32_t k = 0u; k < nn; k++) atoms_put(atoms, rr_lang_name(lang, k));
}

// The scan: the language's names, the path and the module, then each marked name in node order.
DELTA_ONE(intern_scan)
{
    if (i != 0u) return;
    Rr r = doc_of(t, slots, p);
    Atoms atoms = atoms_of(SLOT(2));
    Blk syms = SLOT(3);
    intern_language(atoms, r.lang);
    uint32_t pl = U32(syms, SYMS_PATH_LEN_AT), ml = U32(syms, SYMS_MODULE_LEN_AT);
    U32(syms, SYMS_PATH_SYM_AT) = atoms_put(atoms, text_in(syms, SYMS_NAMES_AT, SYMS_NAMES_AT + pl));
    U32(syms, SYMS_MODULE_SYM_AT) = atoms_put(atoms, text_in(syms, SYMS_NAMES_AT + pl, SYMS_NAMES_AT + pl + ml));
    for (uint32_t n = 0u, len = syms_n(syms); n < len; n++) {
        uint64_t at = rr_sym_at(&r, n);
        uint32_t tx = U32(syms, at), vx = U32(syms, at + 4u);
        if (tx != SYM_NEW && tx != SYM_FIND && vx != SYM_NEW) continue;
        Names m = names_of(&r, n);
        if (m.has_text && tx == SYM_NEW) U32(syms, at) = atoms_put(atoms, m.text);
        if (m.has_text && tx == SYM_FIND) {
            uint32_t id = atoms_find(atoms, m.text, atom_hash(m.text));
            U32(syms, at) = id == NONE ? 0u : id;
        }
        if (m.has_value && vx == SYM_NEW) U32(syms, at + 4u) = atoms_put(atoms, m.value);
    }
}
