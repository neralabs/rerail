// The K0 pass's operations over its documents (`rerail_delta_twins::k0`): `docs_of`, the documents a selection reads;
// `room_of`, the room a run's runs need; `named_blocks`, the blocks a document set names, each one item; and
// `k0_pass`, the walk of every document's statements into K-form's δ runs.
#include <ukl/delta/docs.h>
#include <ukl/delta/rr.h>
#include <ukl/delta/atoms.h>
#include <ukl/delta/runs.h>
#include <ukl/delta/parts.h>
#include <ukl/delta/cache.h>

// The blob named by the four words at column `at` of the selection's row `k`.
UKL_INLINE bool row_blob(CBlk t, uint32_t blobs, CBlk rows, uint32_t k, uint32_t at, UKL_PRIVATE Blob* b) {
    int64_t w[4];
    for (uint32_t c = 0u; c < 4u; c++) w[c] = runs_get(rows, k, at + c);
    return blob_find(t, blobs, w, b);
}

// Each +1 row of the selection a document, its blobs found by their names, written into the docs block in the
// selection's order; the blocks it names, `(block << 32) | the furthest offset referred to`, into the blocks' list.
// One threadgroup: a lane a row, a round of rows placed by an exclusive scan; the first row missing a blob (the least)
// names the missing document.
DELTA_COUNT(docs_of_docs_of_items) { return 1u; }
DELTA_GROUPS(docs_of_docs_of)
{
    DELTA_GROUP_ITEM(one);
    DocsOfP q = PARAMS(DocsOfP);
    CBlk rows = SLOT(0);
    Blk docs = SLOT(2), blocks = SLOT(3);
    uint32_t blobs = (uint32_t)q.blobs, n = 0u, len = runs_len(rows);
    uint64_t missing = 0x7FFFFFFFFFFFFFFFull;
    for (uint32_t base = 0u; base < len; base += lsz) {
        uint32_t k = base + lid;
        Blob s, tp, y;
        bool row = k < len && runs_sign(rows, k) > 0, found = false;
        if (row) {
            found = row_blob(t, blobs, rows, k, q.source, &s);
            found = row_blob(t, blobs, rows, k, q.tape, &tp) && found;
            found = row_blob(t, blobs, rows, k, q.syms, &y) && found;
        }
        UklScan e = ukl_tg_exclusive_sum(found ? 1u : 0u, lid, lsz, scratch __UKL_ARGS);
        uint64_t m = ukl_tg_reduce64(UKL_MIN_I64, row && !found ? (uint64_t)k : 0x7FFFFFFFFFFFFFFFull, lid, lsz, scratch __UKL_ARGS);
        missing = m < missing ? m : missing;
        if (found) {
            uint32_t d = n + e.exclusive;
            uint64_t w[8] = {(uint64_t)runs_get(rows, k, q.module), s.block, tp.block, y.block, s.at, s.len, tp.at, tp.len};
            for (uint32_t c = 0u; c < DOC_WORDS; c++) DOC(docs, d, c) = w[c];
            parts_put(blocks, 3u * d, (int64_t)(((uint64_t)s.block << 32) | s.at));
            parts_put(blocks, 3u * d + 1u, (int64_t)(((uint64_t)tp.block << 32) | tp.at));
            parts_put(blocks, 3u * d + 2u, (int64_t)(((uint64_t)y.block << 32) | BODY_AT));
        }
        n += e.total;
    }
    ukl_tg_barrier_device();
    if (lid != 0u) return;
    if (missing != 0x7FFFFFFFFFFFFFFFull && I64(docs, DOCS_MISSING_AT) == NO_DOC) I64(docs, DOCS_MISSING_AT) = runs_get(rows, (uint32_t)missing, q.module);
    docs_seal(docs, n);
    parts_seal(blocks, 3u * n);
}

// Document `d`'s sizes, if the cache holds them, added to `need`, by relation.
UKL_INLINE void room_add(CBlk cache, uint32_t d, UKL_PRIVATE uint64_t* need) {
    uint32_t at = cache_sizes(cache, d);
    if (at == NONE) return;
    for (uint32_t r = 0u, n = U32(cache, at + 24u); r < n && r < K0_RELATIONS; r++)
        need[r] += U32(cache, at + CACHE_ENTRY_BYTES + 4u * r);
}

// The room a run's runs need, by relation: each gone document's kept rows and each read one's as they were, an eighth
// more for an edit that grew. One threadgroup: a lane a document, the sums by the group's reductions.
DELTA_COUNT(room_of_room_of_items) { return 1u; }
DELTA_GROUPS(room_of_room_of)
{
    DELTA_GROUP_ITEM(one);
    CBlk cache = SLOT(0), gone = SLOT(1), docs = SLOT(2);
    Blk room = SLOT(3);
    uint64_t need[K0_RELATIONS];
    for (uint32_t r = 0u; r < K0_RELATIONS; r++) need[r] = 0u;
    uint32_t ng = parts_len(gone), nd = docs_len(docs);
    for (uint32_t k = lid; k < ng + nd; k += lsz) room_add(cache, k < ng ? (uint32_t)parts_get(gone, k) : (uint32_t)docs_module(docs, k - ng), need);
    for (uint32_t r = 0u; r < K0_RELATIONS; r++) {
        uint64_t v = ukl_tg_reduce64(UKL_SUM_U64, need[r], lid, lsz, scratch __UKL_ARGS);
        if (lid == 0u) U64(room, BODY_AT + 8u * r) = v + v / 8u;
    }
}

// Row `id`'s blobs (source, tape, symbols) found: a bit each, their blocks into `b`.
UKL_INLINE uint32_t named_row(CBlk t, NamedP q, uint32_t id, UKL_PRIVATE uint32_t* b) {
    uint32_t at[3] = {q.source, q.tape, q.syms}, found = 0u;
    for (uint32_t k = 0u; k < 3u; k++) {
        int64_t w[4];
        for (uint32_t c = 0u; c < 4u; c++) w[c] = state_get(t, (uint32_t)q.set, id, at[k] + c);
        Blob x;
        if (blob_find(t, (uint32_t)q.blobs, w, &x)) {
            found |= 1u << k;
            b[k] = x.block;
        }
    }
    return found;
}

// Every live row of the document set, its blobs found by their names: the blocks they lie in, and the documents whose
// source or tape no blobs' row names (to load), each a parts block. One threadgroup: a lane a row, a round of rows
// placed by exclusive scans.
DELTA_COUNT(named_blocks_named_blocks_items) { return 1u; }
DELTA_GROUPS(named_blocks_named_blocks)
{
    DELTA_GROUP_ITEM(one);
    NamedP q = PARAMS(NamedP);
    Blk blocks = SLOT(2), missing = SLOT(3);
    uint32_t set = (uint32_t)q.set, nb = 0u, nm = 0u;
    for (uint32_t base = 0u, end = state_end(t, set); base < end; base += lsz) {
        uint32_t id = base + lid, b[3] = {0u, 0u, 0u}, found = 0u;
        bool live = id < end && state_live(t, set, id);
        if (live) found = named_row(t, q, id, b);
        uint32_t nf = (found & 1u) + (found >> 1 & 1u) + (found >> 2 & 1u);
        bool miss = live && (found & 3u) != 3u;
        UklScan e = ukl_tg_exclusive_sum(nf, lid, lsz, scratch __UKL_ARGS);
        UklScan m = ukl_tg_exclusive_sum(miss ? 1u : 0u, lid, lsz, scratch __UKL_ARGS);
        for (uint32_t k = 0u, j = 0u; k < 3u; k++)
            if ((found >> k & 1u) != 0u) parts_put(blocks, nb + e.exclusive + j++, b[k]);
        if (miss) parts_put(missing, nm + m.exclusive, state_get(t, set, id, q.module));
        nb += e.total;
        nm += m.total;
    }
    ukl_tg_barrier_device();
    if (lid != 0u) return;
    parts_seal(blocks, nb);
    parts_seal(missing, nm);
}

// ---- k0_pass -------------------------------------------------------------------------------------------------------

#define R K0_RELATIONS

// Each K-form relation's arity (`kform::RELATIONS`).
UKL_INLINE uint32_t k_arity(uint32_t r) {
    const uint32_t a[R] = {3u, 6u, 6u, 3u, 3u, 3u, 2u, 2u};
    return a[r];
}

// Document `k` of the docs block, read where it lies.
UKL_INLINE Rr k0_doc(CBlk t, CBlk docs, CBlk lang, uint32_t k) {
    return rr_of(blk(t, (uint32_t)DOC(docs, k, 1u)), DOC(docs, k, 4u), blk(t, (uint32_t)DOC(docs, k, 2u)), DOC(docs, k, 6u), blk(t, (uint32_t)DOC(docs, k, 3u)), lang);
}

// Where a walk's rows go: counted (`runs` unset), or written at `at[r]` of each relation's runs block with `diff`.
typedef struct Put {
    uint32_t n[R], at[R];
    Blk runs[R];
    bool place;
    int32_t diff;
} Put;

UKL_INLINE void k0_put(UKL_PRIVATE Put* o, uint32_t r, UKL_PRIVATE const int64_t* row) {
    if (o->place && o->at[r] != K0_UNCLAIMED) {
        for (uint32_t c = 0u; c < k_arity(r); c++) runs_set(o->runs[r], o->at[r], c, row[c]);
        runs_diff(o->runs[r], o->at[r], o->diff);
        o->at[r]++;
    }
    o->n[r]++;
}

#define PUT(r, ...) do { const int64_t row_[] = {__VA_ARGS__}; k0_put(o, r, row_); } while (0)
// A refusal: the node, and why (the twins' `WHY`); a walk returns it at once.
#define REFUSE(node, why) do { *bad = (node); return (why); } while (0)
#define TRY(x) do { uint32_t w_ = (x); if (w_ != NONE) return w_; } while (0)
#define OK NONE

// The walk's reads: the document, its module and its step kinds' symbols.
typedef struct Walk {
    Rr r;
    int64_t d, atom, not_, cmp;
} Walk;

UKL_INLINE int64_t k0_text(UKL_PRIVATE const Walk* w, uint32_t n) { return (int64_t)rr_sym_text(&w->r, n); }

// A term: what it is, by its node.
UKL_INLINE uint32_t k0_term(UKL_PRIVATE const Walk* w, UKL_PRIVATE Put* o, uint32_t n, UKL_PRIVATE uint32_t* bad) {
    uint32_t k = rr_kind(&w->r, n);
    int64_t v;
    if (k == KIND_VARIABLE) PUT(3u, w->d, n, k0_text(w, n));
    else if (k == KIND_STRING) {
        if (rr_sym_value(&w->r, n) == 0u) REFUSE(n, 0u);
        PUT(4u, w->d, n, rr_sym_value(&w->r, n));
    } else if (k == KIND_NUMBER) {
        if (!rr_number(&w->r, n, &v)) REFUSE(n, 1u);
        PUT(5u, w->d, n, v);
    } else if (k == KIND_WILDCARD) PUT(6u, w->d, n);
    else REFUSE(n, 2u);
    return OK;
}

// An argument list's arguments, as step `k`'s of clause `c`.
UKL_INLINE uint32_t k0_args(UKL_PRIVATE const Walk* w, UKL_PRIVATE Put* o, uint32_t c, int64_t k, uint32_t list, UKL_PRIVATE uint32_t* bad) {
    int64_t i = 0;
    RR_CHILDREN(&w->r, list, a) {
        if (!rr_counted(&w->r, a)) continue;
        PUT(2u, w->d, c, k, -1, i++, a);
        TRY(k0_term(w, o, a, bad));
    }
    return OK;
}

// Node `n`'s relation's symbol.
UKL_INLINE uint32_t k0_relation(UKL_PRIVATE const Walk* w, uint32_t n, UKL_PRIVATE int64_t* rel, UKL_PRIVATE uint32_t* bad) {
    uint32_t f = rr_child(&w->r, n, FIELD_RELATION);
    if (f == NONE) REFUSE(n, 3u);
    *rel = k0_text(w, f);
    return OK;
}

// An atom's or a negated atom's step `i` of clause `c` (`kind`: its step kind's symbol), and its arguments.
UKL_INLINE uint32_t k0_atom(UKL_PRIVATE const Walk* w, UKL_PRIVATE Put* o, uint32_t c, int64_t i, int64_t kind, uint32_t a, UKL_PRIVATE uint32_t* bad) {
    int64_t rel;
    TRY(k0_relation(w, a, &rel, bad));
    PUT(1u, w->d, c, i, -1, kind, rel);
    uint32_t list = rr_child(&w->r, a, FIELD_ARGUMENTS);
    return list == NONE ? OK : k0_args(w, o, c, i, list, bad);
}

// Statement `c`'s rows (`k0::statement`): its head, then its body's literals in the order written.
UKL_INLINE uint32_t k0_walk(UKL_PRIVATE const Walk* w, UKL_PRIVATE Put* o, uint32_t c, UKL_PRIVATE uint32_t* bad) {
    UKL_PRIVATE const Rr* r = &w->r;
    if (rr_kind(r, c) != KIND_CLAUSE) REFUSE(c, 4u);
    uint32_t h = NONE, heads = 0u;
    RR_CHILDREN(r, c, x) if (rr_field(r, x) == FIELD_HEAD) { h = heads == 0u ? x : h; heads++; }
    if (heads != 1u) REFUSE(c, 5u);
    if (rr_child(r, h, FIELD_MODAL) != NONE) REFUSE(h, 6u);
    if (rr_child(r, c, FIELD_EDIT) != NONE) REFUSE(c, 7u);
    int64_t rel;
    TRY(k0_relation(w, h, &rel, bad));
    PUT(0u, w->d, c, rel);
    uint32_t list = rr_child(r, h, FIELD_ARGUMENTS);
    if (list != NONE) TRY(k0_args(w, o, c, -1, list, bad));
    uint32_t b = rr_child(r, c, FIELD_BODY);
    if (b == NONE) return OK;
    if (rr_kind(r, b) != KIND_CONJUNCTION) REFUSE(b, 8u);
    int64_t i = 0;
    RR_CHILDREN(r, b, l) {
        if (!rr_counted(r, l)) continue;
        uint32_t lk = rr_kind(r, l);
        if (lk == KIND_ATOM) TRY(k0_atom(w, o, c, i, w->atom, l, bad));
        else if (lk == KIND_NEGATION) {
            uint32_t a = rr_child(r, l, FIELD_OPERAND);
            if (a == NONE) REFUSE(l, 9u);
            if (rr_kind(r, a) != KIND_ATOM) REFUSE(a, 10u);
            TRY(k0_atom(w, o, c, i, w->not_, a, bad));
        } else if (lk == KIND_COMPARISON) {
            uint32_t op = rr_child(r, l, FIELD_OPERATOR);
            if (op == NONE) REFUSE(l, 11u);
            PUT(1u, w->d, c, i, -1, w->cmp, k0_text(w, op));
            for (uint32_t j = 0u; j < 2u; j++) {
                uint32_t a = rr_child(r, l, j == 0u ? FIELD_LEFT : FIELD_RIGHT);
                if (a == NONE) REFUSE(l, 12u);
                PUT(2u, w->d, c, i, -1, j, a);
                TRY(k0_term(w, o, a, bad));
            }
        } else REFUSE(l, 13u);
        i++;
    }
    return OK;
}

// The UKL version's control, past the twin's header (its facts read only the refusal and what was placed): the step
// kinds' symbols (3 words, then one free), each document's statements (one word a document) and their total, then
// each statement's places by relation (`R` words a statement), then each statement's document and node (2 words).
#define K0_KINDS_AT K0_PLACES_AT
#define K0_DOCN_AT (K0_PLACES_AT + 16u)

UKL_INLINE CBlk k0_docs(CBlk t, UKL_GLOBAL const uint8_t* p) { return blk(t, (uint32_t)PARAMS(K0P).docs); }
UKL_INLINE uint32_t k0_total(CBlk control, uint32_t nd) { return U32(control, K0_DOCN_AT + 4u * nd); }
UKL_INLINE uint32_t k0_places(uint32_t nd) { return K0_DOCN_AT + 4u * (nd + 1u); }
// Statement `item`'s place in relation `r`, and its document and node.
#define PLACE(control, item, r) U32(control, k0_places(nd) + 4u * (R * (item) + (r)))
#define STMT(control, item, w) U32(control, k0_places(nd) + 4u * R * k0_total(control, nd) + 4u * (2u * (item) + (w)))
// What every k0_pass kernel reads first: control, the documents and their count.
#define K0_CTL                                                                                                     \
    Blk control = SLOT(K0_CONTROL);                                                                                 \
    CBlk docs = k0_docs(t, p), lang = SLOT(K0_LANG);                                                                \
    uint32_t nd = docs_len(docs);                                                                                   \
    (void)lang

// Whether node `n` of document `r` is a statement: a counted child of the root.
UKL_INLINE bool k0_is_statement(UKL_PRIVATE const Rr* r, uint32_t n) {
    return n != 0u && clif_f16_parent(r->tape, r->v, n) == 0u && rr_counted(r, n);
}
UKL_INLINE uint32_t k0_nodes(CBlk t, CBlk docs, uint32_t k) { return (uint32_t)U64(blk(t, (uint32_t)DOC(docs, k, 3u)), SYMS_N_AT); }

// Statement `item`'s walk's reads, its document's place and its node (from the statements' list).
UKL_INLINE uint32_t k0_item(CBlk t, UKL_GLOBAL const uint32_t* slots, UKL_GLOBAL const uint8_t* p, uint32_t item, UKL_PRIVATE Walk* w, UKL_PRIVATE uint32_t* k) {
    K0_CTL;
    *k = STMT(control, item, 0u);
    w->r = k0_doc(t, docs, lang, *k);
    w->d = docs_module(docs, *k);
    w->atom = (int64_t)U32(control, K0_KINDS_AT);
    w->not_ = (int64_t)U32(control, K0_KINDS_AT + 4u);
    w->cmp = (int64_t)U32(control, K0_KINDS_AT + 8u);
    return STMT(control, item, 1u);
}

// `docs`: a threadgroup a document, its nodes a lane each, its statements counted. The first group finds the step
// kinds' symbols (the language's last three names, `intern::STEP_KINDS`: 0 for none).
DELTA_COUNT(k0_pass_docs_items) { return docs_len(k0_docs(t, p)); }
DELTA_GROUPS(k0_pass_docs)
{
    DELTA_GROUP_ITEM(k);
    K0_CTL;
    if (!REACH(K0_CONTROL, k0_places(nd))) return;
    if (k == 0u && lid == 0u) {
        Atoms atoms = atoms_of(SLOT(K0_ATOMS));
        for (uint32_t j = 0u; j < 3u; j++) {
            Text x = rr_lang_name(lang, rr_lang_names(lang) - 3u + j);
            uint32_t id = atoms_find(atoms, x, atom_hash(x));
            U32(control, K0_KINDS_AT + 4u * j) = id == NONE ? 0u : id;
        }
    }
    Rr r = k0_doc(t, docs, lang, k);
    uint32_t n = 0u, nodes = k0_nodes(t, docs, k);
    for (uint32_t c = lid; c < nodes; c += lsz) n += k0_is_statement(&r, c) ? 1u : 0u;
    n = ukl_tg_sum(n, lid, lsz, scratch __UKL_ARGS);
    if (lid == 0u) U32(control, K0_DOCN_AT + 4u * k) = n;
}

// `stmts`: a threadgroup a document again, its statements listed in node order from the document's start (the
// statements of the documents before it); the count kernel totals them.
DELTA_COUNT(k0_pass_stmts_items)
{
    K0_CTL;
    uint32_t total = 0u;
    for (uint32_t k = 0u; k < nd; k++) total += U32(control, K0_DOCN_AT + 4u * k);
    U32(control, K0_DOCN_AT + 4u * nd) = total;
    return nd;
}
DELTA_GROUPS(k0_pass_stmts)
{
    DELTA_GROUP_ITEM(k);
    K0_CTL;
    uint32_t total = k0_total(control, nd);
    if (!REACH(K0_CONTROL, k0_places(nd) + 4u * (R + 2u) * (total > 0u ? total : 1u))) return;
    uint32_t start = 0u;
    for (uint32_t j = 0u; j < k; j++) start += U32(control, K0_DOCN_AT + 4u * j);
    Rr r = k0_doc(t, docs, lang, k);
    uint32_t nodes = k0_nodes(t, docs, k);
    for (uint32_t base = 0u; base < nodes; base += lsz) {
        uint32_t c = base + lid;
        bool is = c < nodes && k0_is_statement(&r, c);
        UklScan s = ukl_tg_exclusive_sum(is ? 1u : 0u, lid, lsz, scratch __UKL_ARGS);
        if (is) {
            STMT(control, start + s.exclusive, 0u) = k;
            STMT(control, start + s.exclusive, 1u) = c;
        }
        start += s.total;
    }
}

// `count`: each statement's rows by relation; a refused one marks its first word K0_UNCLAIMED (`scan` finds the
// first in document and node order).
DELTA_COUNT(k0_pass_count_items) { K0_CTL; return k0_total(control, nd); }
DELTA_LANES(k0_pass_count)
{
    DELTA_ITEM(item);
    Walk w;
    uint32_t k, bad = NONE;
    uint32_t c = k0_item(t, slots, p, item, &w, &k);
    Put o = {{0u}, {0u}, {0}, false, 0};
    uint32_t why = k0_walk(&w, &o, c, &bad);
    K0_CTL;
    for (uint32_t r = 0u; r < R; r++) PLACE(control, item, r) = o.n[r];
    if (why != OK) PLACE(control, item, 0u) = K0_UNCLAIMED;
}

// `scan`: one threadgroup. The first refused statement (the least marked) walked again by one thread, its refusal
// into control; else the counts' exclusive prefix sums by relation, a round of the group's statements at a time, then
// each relation's places claimed in its runs block at once (one thread) and added.
DELTA_COUNT(k0_pass_scan_items) { return 1u; }
DELTA_GROUPS(k0_pass_scan)
{
    DELTA_GROUP_ITEM(one);
    K0_CTL;
    uint32_t items = k0_total(control, nd);
    uint64_t least = 0x7FFFFFFFFFFFFFFFull;
    for (uint32_t base = 0u; base < items; base += lsz) {
        uint32_t q = base + lid;
        uint64_t v = q < items && PLACE(control, q, 0u) == K0_UNCLAIMED ? (uint64_t)q : 0x7FFFFFFFFFFFFFFFull;
        v = ukl_tg_reduce64(UKL_MIN_I64, v, lid, lsz, scratch __UKL_ARGS);
        least = v < least ? v : least;
    }
    if (least != 0x7FFFFFFFFFFFFFFFull) {
        if (lid != 0u) return;
        Walk w;
        uint32_t k, bad = NONE;
        uint32_t c = k0_item(t, slots, p, (uint32_t)least, &w, &k);
        Put o = {{0u}, {0u}, {0}, false, 0};
        U32(control, K0_REFUSED_WHY_AT) = k0_walk(&w, &o, c, &bad);
        U64(control, K0_REFUSED_NODE_AT) = bad;
        U32(control, K0_REFUSED_DOC_AT) = k;
        I64(control, K0_REFUSED_MODULE_AT) = w.d;
        return;
    }
    uint32_t total[R];
    for (uint32_t r = 0u; r < R; r++) total[r] = 0u;
    for (uint32_t base = 0u; base < items; base += lsz) {
        uint32_t q = base + lid;
        for (uint32_t r = 0u; r < R; r++) {
            uint32_t n = q < items ? PLACE(control, q, r) : 0u;
            UklScan s = ukl_tg_exclusive_sum(n, lid, lsz, scratch __UKL_ARGS);
            if (q < items) PLACE(control, q, r) = total[r] + s.exclusive;
            total[r] += s.total;
        }
    }
    if (lid == 0u) {
        uint32_t placed = 0u;
        for (uint32_t r = 0u; r < R; r++) {
            uint32_t base = total[r] == 0u ? 0u : runs_claim(SLOT(K0_RUNS + r), total[r]);
            sh[r] = base;
            U32(control, K0_ENDS_AT + 4u * r) = base == NONE ? K0_UNCLAIMED : base + total[r];
            placed += base == NONE ? 0u : total[r];
        }
        U64(control, K0_PLACED_AT) = placed;
    }
    ukl_tg_barrier();
    for (uint32_t q = lid; q < items; q += lsz)
        for (uint32_t r = 0u; r < R; r++) PLACE(control, q, r) = sh[r] == NONE ? K0_UNCLAIMED : sh[r] + PLACE(control, q, r);
}

// `place`: each statement walked again, its rows written at its places with the run's sign.
DELTA_COUNT(k0_pass_place_items) { K0_CTL; return U64(control, K0_REFUSED_NODE_AT) != 0xFFFFFFFFFFFFFFFFull ? 0u : k0_total(control, nd); }
DELTA_LANES(k0_pass_place)
{
    DELTA_ITEM(item);
    Walk w;
    uint32_t k, bad = NONE;
    uint32_t c = k0_item(t, slots, p, item, &w, &k);
    K0_CTL;
    Put o = {{0u}, {0u}, {0}, true, (int32_t)PARAMS(K0P).diff};
    for (uint32_t r = 0u; r < R; r++) {
        o.at[r] = PLACE(control, item, r);
        o.runs[r] = SLOT(K0_RUNS + r);
    }
    k0_walk(&w, &o, c, &bad);
}

// Statement `item`'s first place in relation `r` (past the last: the relation's end).
UKL_INLINE uint32_t k0_start(CBlk control, uint32_t nd, uint32_t items, uint32_t item, uint32_t r) {
    return item == items ? U32(control, K0_ENDS_AT + 4u * r) : PLACE(control, item, r);
}

// The cache's sizes entry for document `d` of `R` counts: its own, else a let-go one; NONE for neither.
UKL_INLINE uint32_t k0_entry(CBlk h, uint32_t d) {
    uint32_t end = CACHE_ENTRIES_AT + (uint32_t)U64(h, CACHE_USED_AT), dead = NONE;
    for (uint32_t at = CACHE_ENTRIES_AT; at < end; at = cache_next(h, at)) {
        if (U32(h, at + 4u) != 0u || U32(h, at + 24u) != R) continue;
        if (U32(h, at) == d) return at;
        if (U32(h, at) == CACHE_DEAD && dead == NONE) dead = at;
    }
    return dead;
}

// `keep`: one item. L1's cache: the documents gone let go of their entries, then each document's sizes (the rows its
// statements were given by relation), over its entry, a let-go one, or appended at the cursor, room asked past the
// cache's capacity. A refused run, or one whose runs were too small, keeps no size.
DELTA_ONE(k0_pass_keep)
{
    if (i != 0u) return;
    CBlk control = SLOT(K0_CONTROL);
    if (U64(control, K0_REFUSED_NODE_AT) != 0xFFFFFFFFFFFFFFFFull) return;
    Blk h = SLOT(K0_CACHE);
    CBlk gone = SLOT(K0_GONE);
    for (uint32_t g = 0u; g < parts_len(gone); g++) {
        uint32_t at = cache_sizes(h, (uint32_t)parts_get(gone, g));
        if (at != NONE) U32(h, at) = CACHE_DEAD;
    }
    for (uint32_t r = 0u; r < R; r++)
        if (U32(control, K0_ENDS_AT + 4u * r) == K0_UNCLAIMED) return;
    CBlk docs = k0_docs(t, p);
    uint32_t nd = docs_len(docs), items = k0_total(control, nd), first = 0u;
    for (uint32_t k = 0u; k < nd; k++) {
        uint32_t n = U32(control, K0_DOCN_AT + 4u * k), d = (uint32_t)docs_module(docs, k);
        uint32_t at = k0_entry(h, d), len = CACHE_ENTRY_BYTES + 4u * R;
        bool append = at == NONE;
        if (append) at = CACHE_ENTRIES_AT + (uint32_t)U64(h, CACHE_USED_AT);
        if (append && !REACH(K0_CACHE, at + len)) return;
        U32(h, at + 4u) = 0u;
        for (uint32_t c = 0u; c < 4u; c++) *(CLIF_BLOCK_SPACE uint16_t*)(h + at + 8u + 2u * c) = 0u;
        U32(h, at + 24u) = R;
        U32(h, at + 28u) = 0u;
        for (uint32_t x = 0u; x < R; x++) U32(h, at + CACHE_ENTRY_BYTES + 4u * x) = k0_start(control, nd, items, first + n, x) - k0_start(control, nd, items, first, x);
        // The document named last, and an appended entry counted last.
        U32(h, at) = d;
        if (append) U64(h, CACHE_USED_AT) = at + len - CACHE_ENTRIES_AT;
        first += n;
    }
}
#undef R
