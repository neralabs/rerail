# corpus: mix: seed 81
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = toggle(prev(after(toggle(nul)), 31))
mask m1 = next(after(lf), 10)
mask m2 = (after_odd_run(fill(op, digit)) ^ (fill(m1, ws) | digit))
mask m3 = m0
