# corpus: mix: seed 84
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (after_odd_run(digit) & ~prev(nul, 37))
mask m1 = toggle((high | fill(next(bs, 7), alpha)))
mask m2 = high
mask m3 = prev(m2, 29)
mask m4 = toggle(fill(alpha, x))
