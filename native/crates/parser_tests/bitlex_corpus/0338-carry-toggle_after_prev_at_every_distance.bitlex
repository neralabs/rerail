# corpus: carry: toggle after prev at every distance
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask base = after(toggle(nul | quote))
mask c1 = toggle(prev(base, 1))
mask c2 = toggle(prev(base, 2))
mask c3 = toggle(prev(base, 3))
mask c4 = toggle(prev(base, 4))
mask c5 = toggle(prev(base, 5))
