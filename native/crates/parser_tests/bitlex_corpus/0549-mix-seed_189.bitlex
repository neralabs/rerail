# corpus: mix: seed 189
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = op
mask m1 = fill((bs | aligned(after(op), 6)), lf)
mask m2 = ((high & alpha) ^ ~lf)
mask m3 = toggle(span(m2, 18))
