# corpus: mix: seed 147
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = ~after(op)
mask m1 = toggle(ws)
mask m2 = ws
mask m3 = after_odd_run(toggle(after_odd_run(ws)))
mask m4 = (starts((quote ^ m3)) | span(~ws, 18))
