# corpus: mix: seed 130
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (lf ^ quote)
mask m1 = span(op, 9)
mask m2 = (op & ~x)
mask m3 = prev((~x & ~starts(m2)), 49)
mask m4 = after_odd_run(m2)
