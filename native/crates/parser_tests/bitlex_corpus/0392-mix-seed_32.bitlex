# corpus: mix: seed 32
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = op
mask m1 = next((x & ~lf), 12)
mask m2 = lf
mask m3 = (after_odd_run(m2) ^ toggle(~lf))
