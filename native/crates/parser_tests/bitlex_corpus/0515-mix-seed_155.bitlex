# corpus: mix: seed 155
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = fill(x, digit)
mask m1 = lasts(quote)
mask m2 = x
mask m3 = fill(bs, next(ws, 4))
mask m4 = lasts((m3 & op))
mask m5 = (ws | m1)
mask m6 = aligned(alpha, 5)
