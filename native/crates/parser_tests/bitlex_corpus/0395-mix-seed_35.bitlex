# corpus: mix: seed 35
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = quote
mask m1 = after_odd_run(~high)
mask m2 = after(prev(~op, 36))
mask m3 = next(starts(((x ^ bs) | x)), 4)
mask m4 = alpha
