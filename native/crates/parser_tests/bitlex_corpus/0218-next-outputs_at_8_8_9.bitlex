# corpus: next: outputs at 8 8 9
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask a = quote
mask b = next(digit, 8)
mask c = next(ws, 8) & prev(alpha, 9)
mask d = next(nul, 9)
