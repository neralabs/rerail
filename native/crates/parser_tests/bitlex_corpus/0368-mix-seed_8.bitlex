# corpus: mix: seed 8
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = ~span(lf, 18)
mask m1 = starts(op)
mask m2 = after(m1)
mask m3 = (span(lf, 20) & ws)
mask m4 = span(bs, 10)
mask m5 = starts(escaped((m3 ^ m4)))
mask m6 = toggle(m1)
