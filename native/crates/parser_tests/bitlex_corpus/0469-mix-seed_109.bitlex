# corpus: mix: seed 109
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = ~quote
mask m1 = starts((after_odd_run(nul) & ~~bs))
mask m2 = escaped(high)
mask m3 = (m0 & ~m2)
