# corpus: mix: seed 123
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = ~next(lf, 8)
mask m1 = aligned(x, 9)
mask m2 = quote
mask m3 = ws
mask m4 = after_odd_run(escaped(escaped(nul)))
mask m5 = m0
