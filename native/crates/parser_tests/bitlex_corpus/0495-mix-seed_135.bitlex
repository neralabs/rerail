# corpus: mix: seed 135
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = span(bs, 13)
mask m1 = starts(prev(after(after_odd_run(bs)), 28))
mask m2 = x
mask m3 = after_odd_run(escaped(lf))
mask m4 = toggle(m0)
mask m5 = (next(span((m3 & quote), 10), 8) ^ ~(prev(m2, 37) & ~toggle(alpha)))
