# corpus: mix: seed 156
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = alpha
mask m1 = span(nul, 3)
mask m2 = after_odd_run((m1 | lf))
mask m3 = (~m0 | fill(op, alpha))
mask m4 = after(m2)
mask m5 = after_odd_run(op)
mask m6 = ~next(m1, 1)
