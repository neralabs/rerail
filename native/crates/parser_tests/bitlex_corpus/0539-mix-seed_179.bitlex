# corpus: mix: seed 179
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = after(~starts(ws))
mask m1 = toggle(lf)
mask m2 = aligned(after(x), 1)
mask m3 = toggle(fill((prev(m0, 59) ^ toggle(digit)), ~(alpha | alpha)))
mask m4 = (m3 ^ op)
