# corpus: mix: seed 77
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = after_odd_run(next(lf, 2))
mask m1 = (lasts(nul) | (x ^ ws))
mask m2 = prev(prev(digit, 12), 3)
mask m3 = starts(x)
mask m4 = m0
mask m5 = (after_odd_run(after(bs)) & escaped(escaped(m1)))
