# corpus: mix: seed 64
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = after(ws)
mask m1 = (~after(alpha) & ~lf)
mask m2 = (aligned((m1 ^ op), 2) & ~(lf | after(m1)))
mask m3 = (ws | ws)
