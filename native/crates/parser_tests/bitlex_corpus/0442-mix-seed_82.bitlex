# corpus: mix: seed 82
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = prev(op, 1)
mask m1 = span(span(toggle(fill(bs, nul)), 6), 9)
mask m2 = toggle(aligned(toggle(high), 3))
mask m3 = lasts(after(ws))
