# corpus: mix: seed 216
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (ws ^ (digit | op))
mask m1 = next(toggle(x), 6)
mask m2 = m0
mask m3 = starts(escaped(high))
