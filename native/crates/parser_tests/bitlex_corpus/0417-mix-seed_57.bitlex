# corpus: mix: seed 57
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (alpha | (lf & ws))
mask m1 = prev((quote ^ next(op, 10)), 10)
mask m2 = lasts((ws | (lf & m1)))
mask m3 = fill(m1, high)
mask m4 = (bs | m1)
