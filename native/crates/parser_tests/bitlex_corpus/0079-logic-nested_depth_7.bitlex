# corpus: logic: nested depth 7
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m = (~(~(((quote | quote) & ~~high) & ~(op | alpha)) & ~(((~lf & ws) ^ (digit & ws)) ^ ((lf | high) | alpha))) ^ ((((~(bs & nul) & ~((x ^ quote) & quote)) | ((x & op) & bs)) & x) ^ bs))
