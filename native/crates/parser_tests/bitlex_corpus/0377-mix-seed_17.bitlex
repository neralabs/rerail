# corpus: mix: seed 17
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = lasts((bs & ws))
mask m1 = lasts((fill(lf, nul) ^ prev(quote, 44)))
mask m2 = digit
