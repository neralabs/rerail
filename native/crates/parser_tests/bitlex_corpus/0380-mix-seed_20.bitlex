# corpus: mix: seed 20
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (alpha | lf)
mask m1 = escaped(alpha)
mask m2 = fill(aligned(high, 1), after(m1))
mask m3 = aligned(quote, 7)
mask m4 = (toggle(aligned(digit, 6)) ^ m3)
mask m5 = m2
