# corpus: mix: seed 168
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = quote
mask m1 = (toggle(alpha) & after_odd_run(quote))
mask m2 = escaped((m0 | lf))
mask m3 = after_odd_run(span(digit, 6))
mask m4 = digit
mask m5 = span(digit, 8)
