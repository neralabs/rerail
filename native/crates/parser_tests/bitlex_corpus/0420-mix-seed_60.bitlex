# corpus: mix: seed 60
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = (nul & x)
mask m1 = lf
mask m2 = toggle(aligned((starts(lf) | (digit & ~bs)), 8))
mask m3 = starts(after((high & next(digit, 1))))
