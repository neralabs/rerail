# corpus: mix: seed 52
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = fill(digit, lf)
mask m1 = (lasts(quote) & ~(prev(after_odd_run(op), 37) | alpha))
mask m2 = ~span(alpha, 18)
mask m3 = toggle(quote)
mask m4 = lasts(escaped(prev(starts(m3), 21)))
