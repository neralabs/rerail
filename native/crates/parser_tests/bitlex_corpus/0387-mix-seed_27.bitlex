# corpus: mix: seed 27
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = aligned(fill(alpha, ws), 9)
mask m1 = bs
mask m2 = escaped(((x ^ quote) | after_odd_run(lf)))
mask m3 = escaped(aligned(m0, 3))
mask m4 = lf
mask m5 = span(nul, 1)
