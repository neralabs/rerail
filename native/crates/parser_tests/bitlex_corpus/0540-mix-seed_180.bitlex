# corpus: mix: seed 180
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = escaped(high)
mask m1 = (starts(digit) & ~bs)
mask m2 = escaped(ws)
mask m3 = next((digit & ~m0), 9)
mask m4 = ~after_odd_run(toggle(m1))
mask m5 = ~toggle(high)
