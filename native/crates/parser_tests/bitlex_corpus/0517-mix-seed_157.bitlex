# corpus: mix: seed 157
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = span(fill(x, lf), 7)
mask m1 = (toggle(aligned(digit, 6)) & lasts((ws | lf)))
mask m2 = (nul & ~m1)
