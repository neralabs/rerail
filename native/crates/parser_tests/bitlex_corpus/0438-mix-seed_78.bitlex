# corpus: mix: seed 78
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = ((op & ~digit) | prev(digit, 30))
mask m1 = (m0 & bs)
mask m2 = span(toggle(digit), 8)
mask m3 = aligned(prev(ws, 50), 8)
mask m4 = after_odd_run(after(alpha))
mask m5 = starts(m1)
