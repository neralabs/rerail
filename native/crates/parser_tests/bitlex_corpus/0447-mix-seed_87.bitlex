# corpus: mix: seed 87
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = bs
mask m1 = next((toggle((digit & alpha)) | high), 11)
mask m2 = (lf & alpha)
mask m3 = lasts(span(aligned(m0, 5), 1))
