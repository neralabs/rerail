# corpus: mix: seed 174
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = bs
mask m1 = (lf | quote)
mask m2 = starts(escaped(~m1))
mask m3 = (toggle((m2 ^ fill(bs, m0))) & after_odd_run((prev(m1, 3) | fill(alpha, m1))))
mask m4 = prev((prev(starts(quote), 61) ^ lf), 47)
mask m5 = ws
mask m6 = x
