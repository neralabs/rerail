# corpus: mix: seed 204
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = fill(~alpha, (quote & ws))
mask m1 = after(high)
mask m2 = toggle(aligned(ws, 8))
mask m3 = escaped(after(escaped(m0)))
mask m4 = bs
mask m5 = after(span(~lasts(m3), 10))
