# corpus: tree: one bracket sep comma numbers values many roots
lexer corpus
class open  = '['
class close = ']'
class sep   = ','
class ws    = ' ' '\n' '\t'
class digit = '0'..'9'
class w     = 'a'..'z' '0'..'9' '-' '.'
token punct = start open | close | sep
keywords punct { "[" "]" "," } required
token atom  = start starts(w) last lasts(w)
check atom = ['-'] digit+ ['.' digit*]
skip ws
error "a stray byte" when ~(open | close | ws | w | sep)
tree t {
  node doc = value*
  node list nested = '[' [value (',' value)*] ']'
  choice value supertype _value = list | atom
}
