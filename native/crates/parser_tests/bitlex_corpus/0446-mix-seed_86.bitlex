# corpus: mix: seed 86
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = x
mask m1 = ~quote
mask m2 = high
mask m3 = (m0 & ~high)
mask m4 = aligned(after(x), 7)
mask m5 = prev(quote, 27)
