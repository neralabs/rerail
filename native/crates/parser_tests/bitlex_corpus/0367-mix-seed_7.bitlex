# corpus: mix: seed 7
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = fill((bs | lf), after_odd_run(lf))
mask m1 = ((after(lf) & (ws | bs)) ^ after_odd_run(alpha))
mask m2 = toggle(bs)
mask m3 = span(lf, 5)
mask m4 = after(m2)
mask m5 = prev(starts(digit), 5)
mask m6 = next(fill(lf, alpha), 12)
