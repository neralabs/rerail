# corpus: mix: seed 215
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = lasts(digit)
mask m1 = ~after(digit)
mask m2 = after_odd_run(op)
mask m3 = m0
mask m4 = bs
