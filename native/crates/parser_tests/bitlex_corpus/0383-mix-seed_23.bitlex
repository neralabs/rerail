# corpus: mix: seed 23
lexer corpus
class quote = '"'
class bs    = '\\'
class ws    = ' ' '\t' '\n' '\r'
class digit = '0'..'9'
class alpha = 'a'..'z' 'A'..'Z'
class high  = 0x80..0xff
class nul   = 0x00
class lf    = '\n'
class op    = '{' '}' '[' ']' ',' ':'
class x     = 'x'
mask m0 = digit
mask m1 = escaped(ws)
mask m2 = ((digit | span((alpha & nul), 14)) & ~prev(toggle((alpha & ~nul)), 6))
mask m3 = (aligned(lf, 4) & ~high)
