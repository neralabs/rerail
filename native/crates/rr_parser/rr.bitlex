# `.rerail`, the rule language, as the engine's parser (logic/rr/syntax.rs, the reference) reads it, with a named-only
# tape (docs/parser-generators/32-named-only-rr-tapes.md). It reads:
#   - `//` and `/* */` comments, `#include "…"` lines;
#   - settings (`.mode x`, `.scope dirs "a", "b"`: a word and the rest of its line), declarations
#     (`.decl r(a: number, b: flat<x>) inline`) and the other directives;
#   - clauses (`r(x, "a", 1), s(_) :- t(x, f(y), k: z), u().`), with strings, backtick literals, `!`,
#     `must`/`may`, arithmetic, comparisons, disjunctions and groups, a parenthesized term at a literal's start;
#   - aggregates (`n = count : { s(_) }`, `m = sum v by k sep "," : { t(k, v) }`, `min (…) : { … }`), an
#     aggregate as another's value;
#   - violations, edits, JSON objects and policy documents (nested to any depth), a `.violation`'s continuation
#     words;
#   - floats, `\u` escapes in strings, a column in braces that is no single name;
#   - a rule file's tests:
#
#   .fixtures app
#       .fixture "a.py" ```x = 1```
#   .end
#   .test t exactly uses app
#       seen(1).
#       .expect B101 at "a.py":1
#   .end
#
# A `.test` or a `.fixtures` block runs to its `.end` (decision 0130); its statements are a file's, but for
# another block: blocks do not nest. Its `.`, its word, `uses` and its `,`, and the `.end` are implied; its
# name, `exactly` and each set `uses` names are stored:
#   - `test_on`, `fixtures_on`: a statement's `.` and the block's word; the statement is the block.
#   - `end_on`: the `.` of a `.end`, which ends a block's statements. A statement that starts
#     with one is refused, as the lean parser refuses it.

lexer rr

class quote     = '"'
class backslash = '\\'
class ws        = ' ' '\t' '\n' '\r' 0x0c
class lf        = '\n'
class slash     = '/'
class star      = '*'
class hash      = '#'
# The bytes no token begins with, outside the regions: the lean lexer's `bad input`, each its own `Bad` token,
# a character of more bytes one (its lead byte and the bytes that continue it).
class junk      = 0x00..0x08 0x0b 0x0e..0x1f '$' '\'' '?' '\\' 0x7f
class high      = 0x80..0xff
class cont      = 0x80..0xbf
class word      = 'a'..'z' 'A'..'Z' '0'..'9' '_'
class alpha     = 'a'..'z' 'A'..'Z' '_'
class digit     = '0'..'9'
class nonzero   = '1'..'9'
class dot       = '.'
class comma     = ','
class u         = 'u'
class hex       = '0'..'9' 'a'..'f' 'A'..'F'
class lbrace    = '{'
class punct     = '(' ')' ',' '.' ';' ':' '=' '<' '>' '!' '|' '@' '*' '[' ']' '-' '+' '/' '%' '~' '^' '&' '{' '}'
class minus     = '-'
class tick      = '`'
class ctl       = 0x00..0x1f
class jesc      = '"' '\\' '/' 'b' 'f' 'n' 'r' 't' 'u'
class ff        = 0x0c
class zero      = '0'
class at_sign   = '@'
class lparen    = '('
class rparen    = ')'
class rbrace    = '}'
class lbracket  = '['
class rbracket  = ']'
class c_i       = 'i'
class c_n       = 'n'
class c_p       = 'p'
class c_t       = 't'
class c_o       = 'o'
class c_f       = 'f'
class c_x       = 'x'
class c_s       = 's'
class c_r       = 'r'
class c_e       = 'e'
class c_l       = 'l'
class c_c       = 'c'
class c_y       = 'y'
class c_v       = 'v'
class c_m       = 'm'
class c_a       = 'a'
class c_j       = 'j'
class c_u       = 'u'
class c_h       = 'h'
class c_g       = 'g'
class c_w       = 'w'
class c_k       = 'k'
class c_b       = 'b'

mask last_byte  = ~next(~empty)

# --- Regions -----------------------------------------------------------------------------------

# Each kind of region by its opener `o_*` and its closer, from the raw bytes: the bytes from an
# opener to before its closer are `f_* = fill(o_*, closer)`. The hidden bytes, where no opener
# counts, run from the byte after an opener through its closer: `prev` of the fills (a two- or
# three-byte closer, `prev` by two or three too). A line comment's `\n` is not hidden: it ends
# the line.
mask escaped    = escaped(backslash)
mask q          = quote & ~escaped
mask line_open  = slash & next(slash)
mask block_open = slash & next(star)
mask block_end  = slash & prev(star)
mask tt         = tick & next(tick)
mask ttt        = tt & next(tick, 2)
mask tick1      = tick & ~next(tick)
mask tick2      = tt & ~next(tick, 2)
mask tick3      = ttt & ~next(tick, 3)
# The regions, left to right: each opener not hidden opens its region, to its closer's first
# byte after it. The hidden bytes run from the byte after the opener through the closer's
# last (`bytes`), but not a line comment's `\n` (`outside`): it ends the line. Two backticks
# with no `` `` `` later in the file open no region: they are the empty literal, `e_t2`. A
# string, a block comment or a literal of one or three backticks open at the file's end is a
# `bad` token to the end (`open`), as the lean lexer's `Bad`: its statement recovers. Any quote
# outside the regions opens a string, as the lean lexer's (a backslash before it is a `bad`
# token); an escape is read only inside one, where it keeps a quote from closing it (`q`).
regions hidden {
  str   = quote .. q open bad
  line  = line_open .. lf outside
  block = block_open .. block_end open bad
  t1    = tick1 .. tick open bad
  t2    = tick2 .. tt bytes 2 else e_t2 bytes 2
  t3    = tick3 .. ttt bytes 3 open bad
}

mask o_tick     = o_t1 | o_t2 | o_t3 | e_t2
mask region     = hidden | o_str | o_line | o_block | o_tick

# Four backticks: the token loop's, whose reader finds no opener at a backtick (decision 0177).
escape "a run of four backticks or more" by tokens when ttt & next(tick, 3) & ~hidden
# A `\u` in a string is the string's, whatever its digits: a lexer reads the string to its
# closing quote, and a string is a string (a checker's reading, as tree-sitter's, not the
# engine's `unescape`). JSON's `\u`, four hex digits, is `json_bad`'s (below). `uesc`: an
# escaped `u`; `h4`: four hex digits after it.
mask uesc       = escaped & u
mask h4         = next(hex) & next(hex, 2) & next(hex, 3) & next(hex, 4)

# --- Code --------------------------------------------------------------------------------------

mask code       = ~region
# The depth of the code's braces and brackets: past 127 the file goes to the engine.
scan depth      = count(code & (lbrace | lbracket), code & (rbrace | rbracket)) max 127

# `#` and its word.
mask directive  = code & hash
mask hashword   = fill(directive, ~(code & word))

# --- Words and numbers -------------------------------------------------------------------------

mask w          = code & word & ~hashword
mask ident      = fill(w & alpha, ~w)           # from a run's first letter to its end
mask num        = w & ~ident                    # the digits before it
# A float, `1.5`: a `.` between digits (`f_dot`); the digits after it, its fraction. A `.`
# after a fraction is no float's, as the engine reads it: `1.2.3` is `1.2`, `.` and `3`, and
# `1.2.3.4` is `1.2`, `.` and `3.4`. The token loop reads that as a lexer does: a number's run
# takes one `.` and stops at the next (`once`, below). The masks say the same of every byte at
# once, for the tokens' starts (which the CPU's loop finds, and makes no mask of): a chain's
# dots between digits (`c_dot`) are a float's by turns, the first, the third, …, their parity
# in the chain, the parity so far (a prefix xor, `toggle`) against the parity at the chain's
# first digit, filled over the chain.
mask c_dot      = code & dot & prev(num) & next(digit)
mask chain      = num | c_dot
mask c_par      = toggle(c_dot)
mask c_odd      = fill(chain & ~prev(chain) & c_par, ~chain)
mask f_dot      = c_dot & (c_par ^ c_odd)
mask frac       = fill(prev(f_dot), ~digit)
mask int        = num & ~frac                   # an integer's digits
# A float is one token, as simdjson's number is one scalar: a number with a `.`. Its own token
# says so (`float_at`, below), and tier 2 reads it a float there, as the lean lexer's number arm
# writes a float where it read a `.`.
# A number's digits are its text, an integer's as a float's: one of 19 digits or more is a
# number, as a checker reads it (tree-sitter's), though the engine's i64 holds none past
# 9223372036854775807.

# Directives the engine refuses by the token after them: token marks, after the other marks.

# A name's first byte: a `.end`'s word starts at one.
mask id_first   = alpha & ident & ~prev(ident)

# --- Punctuation -------------------------------------------------------------------------------

# The two-byte spellings. Their mask is a spelling's first byte; in a run of them (`:->`),
# every other one, from the left. Not masked by `code`: no run of them crosses a region's edge
# (no closer is one). The token loop reads the byte after a token's first instead, as a lexer
# does (`pair two_start`, below): it starts each token after the one before, so a run needs
# nothing more.
pairs two_start = ":-" "=>" "!=" "<=" "<:" ">=" "->"
mask second     = prev(two_start) & code
mask p          = code & punct & ~f_dot
mask p_start    = p & ~second
mask p_last     = (p_start & ~two_start) | second

# A byte no token begins with: each its own `bad` token, as the lean lexer's `Bad`, and a character
# of more bytes one (`bad_char`): from its lead byte, or a byte that continues none, through the
# bytes that continue it. No state takes either: its statement recovers.
mask bad_first  = code & junk
mask char_first = code & high & ~(cont & prev(code & high))

# A token ended by a rule (`run`, `pair`) ends at its start on the CPU, by its run or its pair
# bit (decision 0177); the others by their last byte's mask. The rules read no `code`: the token
# loop starts each token after the one before, so never inside a region (2c). A number's run is
# its digits and its `.`s between digits, one of them (`once dot`): the second ends it.
mask num_run    = digit | (dot & prev(digit) & next(digit))
# A number's first digit: an integer's, not after one of its digits.
mask int_first  = digit & int & ~prev(int)
# What the token loop reads of the masks above at a token's start (decision 0607): a token starts
# where the one before ended, so never in a region (the regions open only at a token's start), a
# word, a number's run or a pair. The prover proves each, or a test build checks it.
assume "a token starts in code: the regions open only at a token's start" at starts code = ~empty
assume "a quote at a start opens a string: any quote outside the regions opens one" at starts o_str = quote
assume "a `//` at a start opens a line comment" at starts o_line = line_open
assume "a `/*` at a start opens a block comment" at starts o_block = block_open
assume "a backtick at a start opens a literal of one, two or three" at starts o_tick = tick1 | tick2 | tick3
assume "a name starts at a letter: a start is never in a word" at starts id_first = alpha
assume "a number starts at a digit: a start is never in a word or a float's fraction" at starts int_first = digit
assume "a byte no token begins with is a bad token of its own" at starts bad_first = junk
assume "a byte past ASCII at a start begins a character: a character's run takes the bytes that continue it" at starts char_first = high
assume "an operator starts at its first byte: a start is never a pair's second or a float's `.`" at starts p_start = punct

# --- Tokens ------------------------------------------------------------------------------------

# A region's token is read, as a lexer reads a string or a comment: from its opener to its
# closer (`read`), each region's last byte its meaning.
token string     = start quote & o_str read str
token comment    = start slash & (o_line | o_block) read line | block
token code_literal = start tick & o_tick read t1 | t2 | t3
token hash_word  = start hash & directive run word
keywords hash_word { "#include" }
token identifier = start id_first run word
# A float's `.` and fraction are its number's: one token.
mask numeral    = int | f_dot | frac
token number     = start int_first run num_run once dot
token punct      = start punct & p_start pair two_start
token bad        = start bad_first pair empty
token bad_char   = start char_first run cont
# The directives' words are words, keywords only where a statement's `.` comes before them;
# `_`, only where a term can be a wildcard; `must` and `may`, only at a head's start; the
# aggregates' words, `by` and `sep`, only where an aggregate can be; a `.violation`'s words
# only in one; `true`, `false` and `null`, only in JSON.
keywords identifier { } soft { "test" "fixtures" "exactly" "uses" "end" "decl" "violation" "policy" "edit" "functor" "type" "input" "output" "lattice" "pragma" "true" "false" "null" "_" "must" "may" "count" "min" "max" "sum" "product" "mean" "join" "by" "at" "sep" "code" "in" "tag" "fix" "safe" "suppress" "over" "options" }
keywords punct { "(" ")" "," "." ";" ":" "=" "<" ">" "!" "|" "@" "*" "[" "]" "-" "+" "/" "%" "~" "^" "&" "{" "}" ":-" "=>" "!=" "<=" ">=" "<:" "->" } required

skip ws

# --- Line breaks -------------------------------------------------------------------------------

# A float: a number with a `.`, as a lexer knows the number it read. First of the marks, at the
# number's own token, which tier 2 reads where it reads the number.
mark float_at    = empty, at number when count(dot) at least 1
# The file's end ends a line too: a setting ends there.
mark line        = lf, end
# A line break, but not after a `,`: a list goes on over lines. The gap's, from the grammar
# token before, as lean's parser asks it. The line breaks' marks come before the marks of
# tokens: a statement takes one where it ends, without taking the token, and no mark of tokens
# taken there may follow, so each is a peek at the tokens (decision 0673 step 1).
mark newline     = lf unless after ",", end
# An I/O directive's relations end at once where a `.` is next, as the lean parser's `list(DOT, …)`; else it reads
# one at least. Taken at the next statement's `.`, so declared before every mark a statement tests there: it passes
# the line breaks' alone.
mark io_none     = tokens "."
# The marks of tokens (decision 0129): each holds at a token the tokens after it (and the one
# before, `after`) follow, comments between them skipped. Tier 2 reads them from the records.
# Before a `.violation`'s continuation word, where the tokens after it are the engine's.
mark fix_on      = tokens "fix" identifier
mark suppress_on = tokens "suppress" identifier string
mark options_on  = tokens "options" "{"
mark over_on     = tokens "over" "{"
# A `{` around one name: a column's name, not its raw text.
mark one_name    = tokens "{" identifier "}"
# `at` and a string after a pattern's literal: its selector.
mark at_on       = tokens "at" string
# A `.end`'s `.`: a `.` token before the word `end`, past blanks and comments.
mark end_on      = tokens "." "end"
# What JSON refuses: in a string, a control byte or an escape it has not; a comment; a form
# feed; a `-` not right before a digit; a leading zero. Only a JSON document's levels refuse it.
# Each at its token, as a lexer checks what it reads: a string's bytes (a control byte, an
# escape JSON has not, a `\u` without four hex digits) mark the token after it; a comment, the
# token after it; a `-` and a leading zero, their own tokens. A form feed between tokens marks
# the next (one in a backtick literal too: no JSON document holds one).
mask str_bad     = ctl | (escaped & ~jesc)
mark json_bad    = ff,
                   after string when count(str_bad) at least 1,
                   after string when count(uesc & ~h4) at least 1,
                   after comment when count(line_open | block_open) at least 1,
                   at punct when run(minus & ~next(digit)) at least 1,
                   at number when run(zero & next(digit)) at least 1

# Token marks past the code's bits: tier 2 tests their tokens alone, as the engine peeks.
# A `,` and a string: a suppress line's next rule. A `,` before anything else ends the line, as the engine reads it.
mark comma_rule  = tokens "," string
# `@` and a name with no `(` after it: a lattice's functor named, not called, as the engine peeks.
mark bare_functor = tokens "@" identifier ~"("
# A statement's `.` and its word: the directive it is, as the lean parser's `statement` peeks at
# the word after the `.`. `.policy`, then a `{`: a policy document; any other `.policy` is a setting.
mark test_on     = tokens "." "test"
mark fixtures_on = tokens "." "fixtures"
mark policy_on   = tokens "." "policy" "{"
mark decl_on     = tokens "." "decl"
mark violation_on = tokens "." "violation"
mark edit_on     = tokens "." "edit"
mark functor_on  = tokens "." "functor"
mark type_on     = tokens "." "type"
mark io_on       = tokens "." "input" | "output"
mark lattice_on  = tokens "." "lattice"
mark pragma_on   = tokens "." "pragma"
# A `{` whose JSON object is on one line: no line break before any of its tokens, its `}` too. The lean parser asks
# whether a setting's word is on its line from the word before's first byte: a JSON object over lines ends the setting.
mark json_flat   = tokens "{" (string | code_literal | hash_word | identifier | number | punct | bad | bad_char without line)* nest ("{" to "}") "}" without line
# A `(` and what follows its `)`, as the lean parser's `literal` reads a group and goes back where its `)` has after it
# an operator or a comparison (`paren_term`), or a `~` (`paren_tilde`); and a `)` (`paren_closes`): parentheses alone
# in parentheses.
mark paren_term  = tokens "(" (string | code_literal | hash_word | identifier | number | punct | bad | bad_char)* nest ("(" to ")") ")" "=" | "!=" | "<" | "<=" | ">" | ">=" | "+" | "-" | "*" | "/" | "%"
mark paren_tilde = tokens "(" (string | code_literal | hash_word | identifier | number | punct | bad | bad_char)* nest ("(" to ")") ")" "~"
mark paren_closes = tokens "(" (string | code_literal | hash_word | identifier | number | punct | bad | bad_char)* nest ("(" to ")") ")" ")"
# An aggregate at its word, as the lean parser's `primary`: `count` and a `:`; an aggregate's word, its `(…)` and a `:`
# (`call_or_aggregate`, which reads the call and goes back); an aggregate's word and a token a term starts with, but a
# `-` or a `(`.
mark count_on    = tokens "count" ":"
mark agg_call    = tokens "min" | "max" | "sum" | "product" | "mean" | "join" "(" (string | code_literal | hash_word | identifier | number | punct | bad | bad_char)* nest ("(" to ")") ")" ":"
mark agg_word    = tokens "min" | "max" | "sum" | "product" | "mean" | "join" number | string | code_literal | identifier | "{" | "@"

# --- The tree ----------------------------------------------------------------------------------

tree rr {
  # A `.end` outside a block is refused, as the lean parser refuses a statement that starts with one; a block's
  # statements end at theirs (`block_body`).
  node source_file whole = (include | end_on refused | statement | clause)*
  # A statement that fails: cut back to its first token, and one ERROR leaf from it to where the next can start, as the
  # engine's parser recovers (decision 0650): at a `#` word, at a `.` first on its line before a name, past any other `.`.
  recover source_file at hash_word | "#include", at first "." identifier, past "."
  node include          = '#include' path: string
  # A statement at a `.`: the word after it says which, as the lean parser's `statement` (decision 0673 step 4).
  choice statement      = test_on test_block | fixtures_on fixtures_block | directive
  choice directive      = policy_on policy_document | decl_on declaration | violation_on violation_declaration
                        | edit_on edit_declaration | functor_on functor_declaration | type_on type_declaration
                        | io_on io_directive | lattice_on lattice_declaration | pragma_on pragma | setting
  # A setting: a name and the rest of its line, as the lean parser's: a `{` a JSON object, any other token a word. A
  # name on the line after the `.` has none. Its `.` is stored: its arguments may hold a `.`.
  node setting          = '.' (line name: identifier | name: identifier (json_flat argument: json | argument: word | punctuation)* (newline | argument: json))
  # A `.test` or a `.fixtures` block (decision 0130). Its statements are a file's, but a block's own: blocks do
  # not nest, as the lean parser's `test` refuses one before it reads a statement.
  node test_block       = '.' 'test' name: identifier [modifier: ('exactly' as identifier)] ['uses' argument: identifier (',' argument: identifier)*] block_body
  node fixtures_block   = '.' 'fixtures' name: identifier block_body
  choice block_body     = (body: block_statement)* end_on '.' 'end'
  choice block_statement nested = include | test_on refused | fixtures_on refused | directive | clause
  # A word of a setting's, a declaration's tail: a leaf with a field.
  choice word           = value | code_literal
  node edit_declaration = '.' 'edit' name: identifier columns: column_list
  # A declaration's `.` and a functor's are stored: their modifiers may hold one.
  node functor_declaration = '.' 'functor' name: identifier columns: column_list ':' return_type: functor_type (modifier: word | punctuation | '{')* line
  node declaration      = '.' 'decl' name: identifier columns: column_list (modifier: word | punctuation | '{')* line
  node type_declaration = '.' 'type' name: identifier (definition: raw_line | relabel definition line)
  # `.input`, `.output`: a level of its own, which takes every name after it as a relation.
  node io_directive nested = '.' (merge '.input' 'input' | merge '.output' 'output') (io_none | relation: io_relation (',' relation: io_relation)*)
  node pragma           = '.' 'pragma' (argument: string)*
  node lattice_declaration = '.' 'lattice' name: identifier '<' [base: identifier] '>' '{' [operation: lattice_operation (',' operation: lattice_operation)*] '}'
  node policy_document  = '.' 'policy' document: leaf json_object json_document
  node violation_declaration = '.' 'violation' name: identifier columns: column_list (code_part | tag_part)* message: string (fix_on fix: fix_line | suppress_on suppress: suppress_line | options_on 'options' options: json)*
  # A type of its own level: a `<` after its name is its own, not a modifier's (the engine reads
  # the type first).
  node functor_type nested = retag type name: identifier ['<' (drop argument: identifier '>' | angle_close)]
  # `.type`'s definition: the rest of the line, one leaf; none, and the name takes its field.
  choice raw_line       = any as raw_text (merge raw_text any)* line
  node io_relation      = name: identifier ['(' (drop parameters: io_parameters ')' | relabel parameters paren_close)]
  # The tokens inside the parentheses, pairs counted: one leaf.
  choice io_parameters nested = (any except '(' ')' as raw_text | '(' as raw_text io_inner) (merge raw_text any except '(' ')' | merge raw_text '(' io_inner)*
  choice io_inner nested = (merge raw_text any except '(' ')' | merge raw_text '(' io_inner)* merge raw_text ')'
  # A value: `@` and a name with no `(` after it, a functor named, not called (`bare_functor`); else a term, as
  # the engine reads it.
  node lattice_operation = name: identifier '->' (bare_functor value: lattice_functor | value: term)
  node lattice_functor  = retag functor_call '@' function: identifier
  # A policy document is JSON: JSON's grammar, read into one leaf (`leaf json_object json_document`), as the lean
  # parser reads its braces and checks the text is JSON. JSON refuses `json_bad`.
  choice json_document nested = '{' [json_member (',' json_member)*] '}'
  choice json_member    = string ':' json_value
  choice json_value     = string | number | '-' number | 'true' | 'false' | 'null' | json_document | json_array
  choice json_array nested = '[' [json_value (',' json_value)*] ']'
  refuse json_bad in json_document json_array
  # `code "X"`; `code {c}`, the word and the column in a node, which takes the word's field.
  choice code_part      = 'code' (drop code: string | relabel code (wrap code_column _ drop braced_column ['in' codes: string]))
  choice tag_part       = 'tag' relabel tag (wrap tag_column _ drop braced_column)
  # `{c}`: the name between the braces; any other braces, one `raw_text` leaf.
  choice braced_column  = one_name '{' column: identifier '}' | column: raw_braces
  choice raw_braces     = balanced raw_text '{' '}'
  # `fix safe rel "…"`; before a string `safe` is the relation.
  node fix_line         = 'fix' ('safe' (relation: identifier description: string | relabel relation as identifier description: string)
                               | relation: identifier description: string)
  node suppress_line    = 'suppress' tool: identifier rule: string (comma_rule ',' rule: string)* [over_on 'over' (one_name '{' over: identifier '}' | over: raw_braces)]
  choice json           = balanced json_object '{' '}'
  node column_list      = '(' [column: column (',' column: column)*] ')'
  node column           = name: identifier ':' type: type
  node type             = name: identifier ['<' (drop argument: identifier '>' | angle_close)]
  choice value          = identifier | numeric | string
  node clause           = head: head (',' head: head)* [':-' body: body] ['=>' edit: term (',' edit: term)*] '.'
  # A head's modal: `must` or `may`, then the relation. Before a `(` it was the relation: the
  # `(` relabels it, an identifier.
  node head             = modal: ('must' | 'may') (relation: identifier arguments: argument_list
                                                  | relabel relation as identifier arguments: argument_list)
                        | relation: identifier arguments: argument_list
  node argument_list nested = '(' [argument: term (',' argument: term)*] ')'
  # A body: a conjunction; a `;` after it wraps it in a disjunction of alternatives.
  choice body           = conjunction [wrap disjunction alternative (';' alternative: conjunction)+]
  node conjunction nested = literal: literal (',' literal: literal)*
  node group nested     = '(' body: body ')'
  # A literal, as the lean parser's `literal` (decision 0673 step 5): a negation; a `(` whose `)` an operator or a
  # comparison follows (`paren_term`), a term, where the lean parser's group fails or goes back; one a `~` follows
  # (`paren_tilde`), a pattern's term in parentheses (`paren_subject`); any other `(`, a group; else a term. A term's
  # comparison or pattern after it makes it a literal's (`literal_tail`).
  # A literal decided (`decide`) has no field of its own: its caller's, `literal` or a negation's
  # `operand`, set where it returns, as the lean parser's `self.literal()?; self.field(..)`.
  choice literal nested = negation | paren_term term [literal_tail] | paren_tilde paren_subject pattern_tail | group
                        | term [literal_tail]
  # A term alone is a call, an atom (the lean parser's `retag_atom`), its function the relation; any other term alone
  # is refused where the literal ends, as the lean parser's `if !call { return Err(()) }`.
  ending literal call as atom inner relation
  ending literal variable refused
  ending literal number refused
  ending literal float refused
  ending literal string refused
  ending literal code_literal refused
  ending literal wildcard refused
  ending literal unary_expression refused
  ending literal binary_expression refused
  ending literal parenthesized_expression refused
  ending literal functor_call refused
  ending literal aggregate refused
  ending literal json_object refused
  ending literal named_argument refused
  choice literal_tail   = decide (comparison_tail | pattern_tail)
  # `(…) ~`: the term in parentheses, nested ones too. A call alone there is refused: the lean parser reads it as a
  # group, which no `~` follows.
  node paren_subject nested = retag parenthesized_expression '(' expression: paren_inner ')'
  choice paren_inner nested = paren_closes paren_subject | term
  ending paren_inner call refused
  # `!` before any literal, which is never a comparison: the lean parser's `inner == Lit::Cmp`, asked
  # where the negation ends (`ending`).
  node negation nested  = '!' operand: literal
  ending negation comparison refused
  choice comparison_tail = wrap comparison left operator: comparison_operator right: term
  # A pattern's literal, then `at` and a string: the node kind it selects.
  choice pattern_tail   = wrap pattern_match subject '~' pattern: code_literal [at_on 'at' selector: string]
  choice comparison_operator = '=' | '!=' | '<' | '<=' | '>' | '>='
  # Terms by precedence, each operator around the left side so far.
  choice term nested    = product (wrap binary_expression left operator: additive right: product)*
  choice product        = primary (wrap binary_expression left operator: multiplicative right: primary)*
  choice additive       = '+' | '-'
  choice multiplicative = '*' | '/' | '%'
  # A word is a variable, unless a `(` or a `:` after it makes it a call's function or a named
  # argument's name, or it starts an aggregate, as the lean parser's `primary`: `count` and a `:`; an aggregate's
  # word, its `(…)` and a `:` (`agg_call`, where the lean parser reads a call and goes back); an aggregate's word and
  # a term's first token (`agg_word`). An aggregate's word is no named argument's name.
  choice primary        = numeric | unsigned
  # A number, a float where its token says so: one leaf.
  choice numeric nested = float_at number as float | number
  choice unsigned nested = string | code_literal | '_' as wildcard | minus | functor_call | json
                        | count_on aggregate | agg_call aggregate | agg_word aggregate
                        | aggregate_word as variable [wrap call function as identifier arguments: argument_list]
                        | identifier as variable [wrap call function as identifier arguments: argument_list
                                                 | unless no_named (wrap named_argument name as identifier ':' value: term)]
                        | parenthesized_expression
  # `-` and a number: one number leaf (a float, where its token says so). Else `-` and its
  # operand, a primary that is no number.
  choice minus          = '-' (float_at merge float number | merge number number | wrap unary_expression _ drop operand: unsigned)
  node parenthesized_expression = '(' expression: term ')'
  node functor_call     = '@' function: identifier arguments: argument_list
  # The aggregates' words but `count`. `product`, the one past `join`, has no kind of its own: an identifier, as the
  # engine stores it.
  choice aggregate_word = 'min' | 'max' | 'sum' | 'mean' | 'join' | 'product' as identifier
  # An aggregate, as the lean parser's `aggregate`: `count` and its body alone (`count` implied); else its word, its
  # value, then `by` and its keys, `sep` and its separator, and its body. Its value and a single key are terms with no
  # named argument in them (`no_named`, down through all they hold), as the lean parser's `agg_part`. Its `:` is
  # stored, and its `{` after a key list's `)` with no `sep` after it.
  flag no_named
  node aggregate        = 'count' agg_body
                        | operator: aggregate_word value: with no_named term ('by' ('(' key: term (',' key: term)* ')' keyed_body | key: with no_named term agg_tail) | agg_tail)
  choice agg_tail       = ['sep' separator: string] agg_body
  choice keyed_body     = 'sep' separator: string agg_body | ':' '{' body: body '}'
  choice agg_body       = ':' '{' body: body '}'
  # Every punctuation but `{`, which opens a setting's JSON object: a declaration's tail takes it besides.
  choice punctuation    = '(' | ')' | ',' | '.' | ';' | ':' | '=' | '<' | '>' | '!' | '|' | '@' | '*' | '[' | ']' | '-' | '+' | '/' | '%' | '~' | '^' | '&' | '}' | ':-' | '=>' | '!=' | '<=' | '>=' | '<:' | '->' | '#include' | hash_word as identifier
  # A `#` word but `#include`: an identifier with no field, as the engine stores any token on the line.
  # A type's `<>`, and an io relation's `()`: stored, as the named children do not say them.
  choice angle_close    = '>'
  choice paren_close    = ')'
  # The tokens the grammar implies: no leaf.
  implied include '#include'
  implied test_block '.' 'test' 'uses' ','
  implied fixtures_block '.' 'fixtures'
  implied block_body '.' 'end'
  implied edit_declaration '.' 'edit'
  implied functor_declaration 'functor'
  implied policy_document '.' 'policy'
  implied functor_type '>'
  implied type_declaration '.' 'type'
  implied io_directive ','
  implied io_relation ')'
  implied pragma '.' 'pragma'
  implied lattice_declaration '.' 'lattice' '<' '>' '{' ',' '}'
  implied lattice_operation '->'
  implied lattice_functor '@'
  implied declaration 'decl'
  implied violation_declaration '.' 'violation' 'options'
  implied code_part 'in'
  implied braced_column '{' '}'
  implied suppress_line 'suppress' ',' 'over' '{' '}'
  implied column_list '(' ',' ')'
  implied column ':'
  implied type '>'
  implied clause ',' ':-' '=>' '.'
  implied argument_list '(' ',' ')'
  implied body ';'
  implied conjunction ','
  implied group '(' ')'
  implied negation '!'
  implied pattern_tail '~' 'at'
  implied unsigned ':'
  implied paren_subject '(' ')'
  implied parenthesized_expression '(' ')'
  implied functor_call '@'
  implied aggregate 'count' ','
  implied agg_body '{' '}'
  implied keyed_body '}'
  hidden float_at line newline io_none end_on test_on fixtures_on policy_on decl_on violation_on edit_on functor_on type_on io_on lattice_on pragma_on json_flat paren_term paren_tilde paren_closes count_on agg_call agg_word json_bad fix_on suppress_on options_on over_on one_name at_on comma_rule bare_functor
  extra comment
  # The lexer's errors, a byte's and a character's: no rule takes them, nor `any`, as the lean
  # parser fails at a `Bad` where it reads any token (its raw line's).
  untaken bad bad_char
}
