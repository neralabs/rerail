# Kotlin, step 36: no back fills (decision 0406).
#
# The grammar asks what comes next where the lean parser does: at the token. A mark that the
# token after its gap decides says so (`before`, `unless before`), as the scanner's semicolon
# asks of the next token (`Lexer::asi`); the next tokens are a token mark's run, as the parser
# peeks. No mask reads the bytes after it.
#
# Step 35: templates in raw strings.
#
#   val x = """a ${b} "c" $d"""
#
# A raw string closes at its `"""` or at a template's `$` (`or t_dollar`: its closer is three
# bytes, the `$` one). After the template's `}`, the string goes on as the kind of string the
# template is in: a tail (`tail`) after a string, a raw tail (`rtail`) after a raw string. A
# region kind's `after` says which: it opens only where the last region opened before, of the
# kinds with no `after`, is one it names. A raw tail is read as the raw string's bytes are:
# a run of them that reaches a quote first is a part of its own.
#
# Refused: a string, a character or a backtick name in a raw string's template's code (its `}`
# would open a tail), and a raw string in a template's code.
#
# Steps 1 to 34 read headers, comments, declarations, types, statements, expressions, strings
# with templates, raw strings, characters, backtick names, callable references, trailing
# commas, lambdas with destructured parameters, annotations, numbers, a class's members, `when`,
# `;`, `try`, `as`, receivers, generic functions, delegation, object literals, secondary
# constructors, destructuring, type arguments, enum classes, jumps to labels, `as?`, reified
# type parameters, spread arguments, named function type parameters, parenthesized types, type
# aliases, collection literals, strings in templates' code, a class's delegate before its body,
# variance, `get` and `set` as names and a local delegate with dots, function types with a receiver
# or `suspend`, annotated `if` and `when`, a `when` entry's trailing comma, swallowed block comments,
# soft keywords after a template's `$`, `constructor` after
# modifiers at a line's start, modifier words after a `.`, and
# `constructor` and `by` as names (`01-headers.bitlex` to `34-soft-names.bitlex`).
#
# A template's code ends at the first `}` on its line, found from the bytes before the
# regions. A string or a character in the code is a region of its own, as anywhere in code.
# Where that `}` is inside one (`"${f("}")}"`), it opens no tail: refused.
#
# The reference is the lean parser (`rerail_kotlin_lean`), whose tapes are tree-sitter-kotlin's
# (decision 0305). What this step does not read is refused, and goes to the lean parser: a
# template's code holding a brace, a template or a line break; `fun interface`, `suspend`
# function types, an annotated expression, a function type's receiver, labels' definitions,
# and more.

lexer kotlin

class ws        = ' ' '\t' '\n' '\r' 0x0c
class lf        = '\n'
class slash     = '/'
class star      = '*'
class word      = 'a'..'z' 'A'..'Z' '0'..'9' '_'
class alpha     = 'a'..'z' 'A'..'Z' '_'
class digit     = '0'..'9'
class dot       = '.'
class at_sign   = '@'
class semicolon = ';'
class rbrace    = '}'
# What a lambda's parameters are made of, up to their `->` (the lean parser's `lambda_params_end`).
class dq        = '"'
class sq        = '\''
class bt        = '`'
class sq_bt     = '\'' '`'
class u_letter  = 'u'
class zero      = '0'
class x_letter  = 'x' 'X'
class b_letter  = 'b' 'B'
class e_letter  = 'e' 'E'
class f_letter  = 'f' 'F'
class sign      = '+' '-'
class underscore = '_'
class decd      = '0'..'9' '_'
class hexd      = '0'..'9' 'a'..'f' 'A'..'F' '_'
class bind      = '0' '1' '_'
class backslash = '\\'
class dollar    = '$'
class lbrace    = '{'
class high      = 0x80..0xff
class punct     = '.' '*' '/' ';' ',' ':' '(' ')' '{' '}' '[' ']' '<' '>' '=' '+' '-' '!' '?' '&' '|' '%' '^' '~' '@' '#' '$' '\\'
# The bytes a line may start with and go on the line before (the scanner's no semicolon).
class goes_on   = ',' '.' ':' '*' '%' '>' '<' '=' '{' '[' '(' '?' '|' '&' '/'

mask last_byte  = ~next(~empty)

# --- Regions -----------------------------------------------------------------------------------

mask line_open  = slash & next(slash)
mask block_open = slash & next(star)
mask block_end  = slash & prev(star)
# A string's closer: a `"` no backslash escapes.
mask dq_close   = dq & ~escaped(backslash)
mask sq_close   = sq & ~escaped(backslash)
# A template, as its bytes show it: `${`, then code to the first `}` on its line. It is one
# where its `$` closes a string's region; a `${` in a comment or a character is no template.
mask t_dollar   = dollar & next(lbrace) & ~escaped(backslash)
mask t_lex      = prev(t_dollar)
mask t_body     = fill(prev(t_lex) & ~rbrace & ~lf, rbrace | lf)
mask t_close    = rbrace & (prev(t_lex) | prev(t_body))
# A raw string: `"""`, then to the last three quotes of the next run of three or more.
mask dq3        = dq & next(dq) & next(dq, 2)
mask rclose     = dq3 & ~next(dq, 3)
regions hidden {
  line  = line_open .. lf outside
  block = block_open .. block_end
  rstr  = dq3 .. rclose bytes 3 or t_dollar
  str   = dq & ~dq3 .. dq_close | t_dollar
  chr   = sq .. sq_close
  tick  = bt .. bt
  tail  = t_close .. dq_close | t_dollar after str chr tick
  rtail = t_close .. rclose bytes 3 or t_dollar after rstr
}
# Where a token in a region starts: a string's, a character's or a backtick name's opener.
mask opens      = o_str | o_chr | o_tick | o_tail | o_rstr | o_rtail
mask region     = hidden | o_line | o_block | opens
# A template's `{`: its `$`'s token's, not code.
mask t_brace    = t_lex & prev(hidden) & ~hidden
mask code       = ~region & ~t_brace

# A template's code: not read yet with a brace, a template, a comment or a line break in it,
# nor with none. A `$` in code is no template's. A string or a character in it is a region;
# the `}` the bytes end the code at opens the tail, unless it is inside one of them.
mask t_code     = fill(prev(t_brace), rbrace)
escape "a `${…}` template with a brace, a template, a comment or a line break" when t_code & (lbrace | lf | line_open | block_open | dollar & next(lbrace))
escape "a `${…}` template whose `}` is in a string of its code" when rbrace & prev(t_code) & ~o_tail & ~o_rtail
# A raw string's template: its `$` closed a raw string or a raw tail. A string, a character or a
# backtick name in its code would make its `}` a tail's; a raw string in a string's template's
# code, a raw tail's.
mask rt_brace   = t_brace & prev(f_rstr | f_rtail, 2)
mask rt_code    = fill(prev(rt_brace), rbrace)
escape "a string, a character or a backtick name in a raw string's template" when rt_code & (o_str | o_chr | o_tick)
escape "a raw string in a template's code" when t_code & o_rstr
escape "an empty `${}`" when prev(t_brace) & rbrace
escape "a `$` outside a string" when code & dollar

error "a block comment open at the end of the file" by tokens when f_block & last_byte
error "a string open at the end of the file" by tokens when (f_str | f_tail | f_rstr | f_rtail) & last_byte
error "a character open at the end of the file" by tokens when f_chr & last_byte
error "a backtick name open at the end of the file" by tokens when f_tick & last_byte
# None of them goes over a line in Kotlin: one that does is not read.
escape "a string, a character or a backtick name over a line" when (f_str | f_tail | f_chr | f_tick) & lf

# --- Strings -----------------------------------------------------------------------------------

# A raw string's bytes after its `"""`, and a raw tail's after its `}`. No backslash escapes in it: a `\$` is not read yet.
mask rbody      = f_rstr & ~o_rstr & ~prev(o_rstr) & ~prev(o_rstr, 2) | f_rtail & ~o_rtail
escape "a backslash before `$` in a raw string" when rbody & dollar & prev(backslash)
# The lean parser keeps the quotes of a closing run past three as none of the string's leaves.
escape "a raw string closed by four quotes or more" when rbody & dq & next(rclose)
# An opener's run past three quotes but for the empty raw string's six: its closer would be
# found within the run.
escape "a raw string opened by four quotes or more" when o_rstr & next(dq, 3) & ~(next(dq, 4) & next(dq, 5) & ~next(dq, 6))
mask body       = f_str & ~o_str | f_tail & ~o_tail | rbody
mask s_word     = body & word
mask s_dollar   = body & dollar & ~escaped(backslash)
escape "a `$` before a backtick" when s_dollar & next(bt)
# `$name`: the `$`, then the name to its last word byte.
mask id_dollar  = s_dollar & next(alpha)
mask id_last    = s_word & ~next(s_word)
# A `$` before no name: a content token of its own, the content after it another.
mask lone       = s_dollar & ~next(alpha)

# --- Characters --------------------------------------------------------------------------------

mask c_body     = f_chr & ~o_chr
# An escape: a `\` no backslash escapes; `\u` and four hex digits, else two bytes.
mask c_esc      = c_body & backslash & ~escaped(backslash)
mask c_uesc     = c_esc & next(u_letter)
escape "a byte above 0x7f outside a comment" when code & high
escape "a nested block comment" when f_block & ~o_block & block_open
# The scanner's semicolon is the line break; a `;` that starts a line, or ends the file, comes
# with one: not read yet.

# --- Words -------------------------------------------------------------------------------------

mask w          = code & word
mask word_run       = fill(w & alpha & ~prev(w), ~w)
# A digit after a `.` is a fraction's, but after `..` a number's first (`1..2`).
mask num_start  = w & digit & ~prev(w) & ~prev(dot & ~prev(dot))

# A number, as the lean lexer reads one: hex (`0x`) and binary (`0b`) digits; else decimal
# digits, then a fraction (a `.` and digits), an exponent (`e`, a sign, digits) and an `f`,
# each where it may come. A `.` before a digit starts one too (`.5`), but not after a word or
# a `.` (`1..2` is a range).
mask hex_at     = num_start & zero & next(x_letter)
mask bin_at     = num_start & zero & next(b_letter)
mask hx         = fill(prev(hex_at, 2) & hexd, ~hexd)
mask bx         = fill(prev(bin_at, 2) & bind, ~bind)
escape "a `0x` or `0b` with no digit" when prev(hex_at, 2) & ~hexd | prev(bin_at, 2) & ~bind
mask dot_at     = code & dot & next(digit) & ~prev(w) & ~prev(dot)
mask di         = fill(num_start & ~hex_at & ~bin_at, ~decd)
mask frac_dot   = code & dot & prev(di) & next(digit)
mask fr         = fill(prev(frac_dot | dot_at), ~decd)
mask e_at       = code & e_letter & prev(di | fr) & (next(digit) | next(sign) & next(digit, 2))
mask e_sign     = sign & prev(e_at)
mask ex         = fill(prev(e_at) & digit | prev(e_sign), ~decd)
mask f_at       = code & f_letter & prev(di | fr | ex)
mask nb         = di | frac_dot | dot_at | fr | e_at | e_sign | ex | f_at
mask n_last     = nb & ~next(nb)
# A decimal number's kind is told at its end, as the lean lexer tells it once it has read the
# number: a fraction, an exponent or an `f` make it real (`real`, a test of the token's bytes).
# One that starts with a `.` is real.
mask int_at     = num_start & ~hex_at & ~bin_at
mask h_last     = hx & ~next(hx)
mask b_last     = bx & ~next(bx)
# A suffix: the word right after an integer (`L`, `u`, `uL`), a keyword token of its own. A
# name of the same text elsewhere is not read, so the grammar takes the word after an integer
# as its suffix only where it touches it.
mask int_last   = n_last & di | h_last | b_last
mask sfx        = w & alpha & prev(int_last)
escape "a digit after a binary number" when w & digit & prev(int_last)
mask sfx_text   = (text("L") | text("u") | text("U")) & ~next(w) | (text("uL") | text("UL")) & ~next(w, 2)
escape "a word touching a number, no suffix" when sfx & ~sfx_text | n_last & ~di & next(w)
escape "a name `L`, `u`, `U`, `uL` or `UL`" when w & alpha & ~prev(w) & sfx_text
escape "a number that ends in `_`" when (n_last | h_last | b_last) & underscore
mask number     = fill(num_start, ~w) | nb
error "a byte no token takes" by tokens when code & ~ws & ~word_run & ~number & ~punct
# Operators of three bytes are not read yet.
# `===`, `!==` and `..<`: a token of three bytes, a row of its own.
mask three      = code & (text("===") | text("!==") | text("..<"))

# A word ends here (no word byte after it) and starts here (none before it).
mask kw_start   = w & ~prev(w)
mask else_w     = kw_start & text("else") & ~next(w, 4)
mask as_w       = kw_start & text("as") & ~next(w, 2)
mask where_w    = kw_start & text("where") & ~next(w, 5)
mask catch_w    = kw_start & text("catch") & ~next(w, 5)
mask finally_w  = kw_start & text("finally") & ~next(w, 7)
mask by_w       = kw_start & text("by") & ~next(w, 2)
mask ctor_w     = kw_start & text("constructor") & ~next(w, 11)

# --- The scanner's semicolon -----------------------------------------------------------------

# A byte of code that is not blank, or a string's opener: where a token starts or goes on.
mask solid      = (code | opens) & ~ws
# What a line may start with and go on the line before: tree-sitter-kotlin's scanner, which
# inserts no semicolon before these (`scan_automatic_semicolon`). `by` and `constructor` go on
# everywhere here: they are keywords of this grammar, so a line they start where the scanner
# would end the one before is refused.
# A class's header, from `class` to its `(`, `{` or `=`: the scanner's `constructor` context, where
# a line starting with `constructor` goes on the one before (a primary constructor). In a class
# body it starts a member: a secondary constructor.
mask class_kw   = kw_start & text("class") & ~next(w, 5) & ~prev(text("::"), 2)
# A class's header, and the run back from `constructor`, stop at a declaration's keyword: in `class A` then `internal
# class B private constructor(…)`, A's header ends at its line.
mask head_stop  = class_kw | kw_start & (text("fun") & ~next(w, 3) | text("val") & ~next(w, 3) | text("var") & ~next(w, 3) | text("object") & ~next(w, 6) | text("interface") & ~next(w, 9))
mask class_head = fill(class_kw, code & (lbrace | text("(") | text("=") | semicolon) | head_stop)
# `class A : I by d {`: the lean parser ends the delegate's expression before the body's `{`,
# where a name followed by `{` is a call with a trailing lambda. That `{` (after a `by` in the
# header, or an object's) has the mark a class body takes (`dotted`), which ends the
# expression.
mask class_decl = fill(class_kw, code & lbrace)
mask head_brace = code & lbrace & prev(class_decl)
mask object_w   = kw_start & text("object") & ~next(w, 6)
mask obj_decl   = fill(object_w, code & lbrace)
mask del_brace  = head_brace & prev(fill(by_w & class_decl, lbrace)) | code & lbrace & prev(obj_decl) & prev(fill(by_w & obj_decl, lbrace))
mask vis_w      = kw_start & (text("private") & ~next(w, 7) | text("protected") & ~next(w, 9) | text("internal") & ~next(w, 8) | text("public") & ~next(w, 6))
# The `constructor` that an annotation or a visibility modifier in a class's header reaches over
# words, blanks, dots and `@`s (`ann_ctor`, from `S`'s bytes): the primary constructor's
# modifiers. Told at the `constructor`, as the lean lexer's `modifier_then_constructor` reads on.
mask ctor_stop  = ctor_w & class_head | ~(code & (word | ws | dot | at_sign)) | head_stop
# A line break in code where the next token does not go on the line: the statement's end. Before
# a `}`, a mark of its own: a block's statements may end with one, a class body's members must.
# A line break after a `;` (and blanks or comments): the `;` was the semicolon.
mask after_semi = fill(prev(code & semicolon), solid)
# The line breaks that may end a statement: the semicolon's gap. Its tokens after decide (`semi`).
mask lf_end     = lf & code & ~after_semi
# A `}` after a `;`: the `;` closed the line, so the `}` closes as after a line break.
mask close_at   = lf_end | code & rbrace & (prev(after_semi) | prev(code & semicolon))

# A block comment the lean lexer's `asi` reads (one that starts the line after a line break where
# a semicolon may come): what follows it decides, as there. Each test is told at the byte that
# decides it, after the comment, as the lexer reads on: the first solid byte after a block
# comment's end (`after_blk`), and after an `else` there, the solid byte after the word.
mask after_blk  = solid & prev(fill(block_end, solid))
# Where what follows goes on, tree-sitter loses the comment (a comment of no width): not read
# yet. What goes on, at the first solid byte after the comment: a byte of `goes_on`, `!=`, `as`,
# `where`, `catch`, `finally`, `by`, `constructor` in a class's header, `else` but a `when`
# entry's (`else ->`), and an annotation or a visibility modifier before a header's `constructor`.
mask goes_now   = code & goes_on | code & text("!=") | as_w | where_w | catch_w | finally_w | by_w | ctor_w & class_head
mask else_blk   = else_w & after_blk
mask else_next  = solid & (prev(else_blk, 4) | prev(fill(prev(else_blk, 4) & ~solid, solid)))
mask ann_blk    = code & (at_sign | vis_w) & class_head & after_blk
mask ann_ctor   = ctor_w & class_head & prev(fill(ann_blk, ctor_stop))
escape "a block comment before a token that goes on the line" when goes_now & after_blk | else_next & ~text("->") | ann_ctor
# A block comment that starts a line after a token's line: the scanner reads it. (Where what
# follows goes on, the escape above refuses the file, so the line break is any that may end a
# statement.)
mask asked_blk  = fill(o_block & prev(fill(lf_end & prev(fill(solid, lf)), solid)), block_end)
# After a token's line, before another comment, the scanner reads it through and the tree keeps
# a comment of no width where the next one starts: not read yet.
escape "a block comment that starts a line, before a comment" when (o_line | o_block) & prev(fill(block_end & prev(asked_blk), ~ws))
# Before a word that starts with `a`, `e` or `w` (`abstract`, `external`), and that is not `as`,
# `else` or `where`, the scanner swallows the comment into the semicolon it inserts after it (the
# lean lexer's `Asi::Swallow`), and the tree loses it: the semicolon drops it (`drops`). Right
# after a delegation specifier or a property with no initializer, a word with `b` does the same
# (open, 0332).
# Swallowed where a semicolon may come: after a line that ends with a word, `)`, `]`, `}` or a
# quote (`sw_blk`), and that is no header's (a header holds its semicolon, so its node would end
# at the word), before no `else` (a `when` entry holds its line break the same way). After a `{`
# (`br_blk`) none may, and the comment is read as any other. After any other line end, not read
# yet.
mask awe_word   = code & word & ~prev(w) & (text("a") | text("e") | text("w")) & ~as_w & ~where_w & ~else_w
mask hdr_line   = fill(kw_start & (prev(fill(lf & code, solid)) | ~prev(~empty)) & (text("package") | text("import")), lf)
mask hdr_gap    = fill(prev(hdr_line) & lf, solid)
# (A fill holds at its start even where that is a stop: `& ~solid`, so that the last solid
# byte before the line break is the one named.)
mask ok_lf      = lf & fill(prev(code & (word | text(")") | text("]") | rbrace) | dq | text("'")) & ~solid, solid) & ~hdr_gap
mask brace_lf   = lf & fill(prev(code & lbrace) & ~solid, solid)
mask sw_blk     = fill(o_block & prev(fill(lf_end & prev(fill(solid, lf)) & ok_lf, solid)), block_end)
mask br_blk     = fill(o_block & prev(fill(lf_end & brace_lf, solid)), block_end)
mask after_odd  = solid & prev(fill(block_end & prev(asked_blk) & ~prev(sw_blk) & ~prev(br_blk), solid))
mask after_sw   = solid & prev(fill(block_end & prev(sw_blk), solid))
# A `when` entry's `else ->` after one: the `->`.
mask else_odd   = else_w & after_odd
mask else_sw    = else_w & after_sw
mask arrow_odd  = code & text("->") & (prev(else_odd, 4) | prev(fill(prev(else_odd, 4) & ~solid, solid)))
mask arrow_sw   = code & text("->") & (prev(else_sw, 4) | prev(fill(prev(else_sw, 4) & ~solid, solid)))
escape "a block comment before a word with `a`, `e` or `w`" when awe_word & after_odd | arrow_odd
escape "a block comment before `else`" when arrow_sw
# The word after a swallowed comment, where the semicolon drops it.
mask swallow_at = awe_word & after_sw
# The first token of each line, and the bytes of a line from an `@` or a visibility modifier
# that starts it: `constructor` there may be a primary constructor's (the scanner's
# `check_modifier_then_constructor`), not read yet.
mask line_first = solid & prev(fill(lf & code, solid))
escape "a `;` that starts a line" when code & semicolon & line_first
# No solid byte after it, at the file's last byte.
escape "a `;` that ends the file" when last_byte & fill(code & semicolon, solid)
mask line_mod   = fill(line_first & (at_sign | text("private") | text("protected") | text("internal") | text("public")), lf | head_stop)
mask ctor_reach = ctor_w & class_head & prev(fill(line_first & (at_sign | vis_w) & class_head, ctor_stop))
escape "`constructor` after modifiers at a line's start" when ctor_w & line_mod & class_head & ~ctor_reach
# `@Test // c` before a declaration: the annotation takes the line's semicolon, so the comment
# would be the annotation's, where the lean parser keeps it the declaration's: not read yet.
mask at_line    = fill(line_first & at_sign, lf)
escape "a comment on an annotation's line" when (o_line | o_block) & at_line
# `get` or `set` first on a line: an accessor, which tree-sitter reads as a declaration of its own
# after a property's; not read yet.
# A getter or setter on a line of its own: a mark a class body's member takes. Elsewhere (a
# property's at the top level, a call to `get` starting a line in a function) it refuses.
mask acc_vis    = prev(text("private "), 8) | prev(text("protected "), 10) | prev(text("internal "), 9) | prev(text("public "), 7)
# A declaration's receiver. From after `fun`, `val` or `var` to its `(`, `:`, `=`, `{` or line
# end (`decl_run`): its last `.` ends a receiver (`rdot_at`), which starts at the run's first
# token, past the function's type parameters (`rstart`). A type parameter's bound's `:` is
# inside them (`tp_body`): the run goes on past it. Nested type arguments in the parameters
# (`<T : C<T>>`) end `tp_body` early, and the receiver's start is then refused.
mask decl_kw    = kw_start & (text("fun") | text("val") | text("var")) & ~next(w, 3)
mask after_kw   = prev(decl_kw, 3)
mask first_tok  = solid & (after_kw | prev(fill(after_kw & ~solid, solid)))
mask tp_body    = fill(first_tok & text("<"), text(">"))
# And the byte after a `by` (from its `b` the run would wait on the bytes after it).
mask decl_stop  = code & (text("(") | text(":") & ~tp_body | text("=") | lbrace | lf) | prev(by_w, 2)
mask decl_run   = fill(after_kw, decl_stop)
mask after_tp   = prev(text(">") & prev(tp_body))
mask rstart     = code & (first_tok & ~text("<") | solid & (after_tp | prev(fill(after_tp & ~solid, solid))))
# `String?.f`: the lexer reads `?.` as one operator, so the receiver's `.` is no token of its own.
escape "a nullable receiver" when code & text("?.") & decl_run
# The type after `as`: its names, dots and blanks on its line (`as_run`). A `<` after a dot in
# it: the lean parser reads `x as a.b.C<D>` as a comparison over navigation where an
# expression follows, else as a type. Not read.
mask as_kw      = kw_start & text("as") & ~next(w, 2)
mask as_run     = fill(prev(as_kw, 2), ~(code & (word | dot | text(" ") | text("?"))))
escape "a dotted type after `as` before a `<`" when code & text("<") & prev(fill(as_run & dot, ~as_run))
# A property's accessor: its `get` or `set` at a line's start (or after a visibility word
# there), where no `.` or `:` follows it, and, for `get`, no `(` with arguments.
mask acc_word   = code & (line_first | line_mod & acc_vis) & (text("get") | text("set")) & ~next(w, 3)

# --- Tokens ------------------------------------------------------------------------------------

token line_comment = start slash & o_line read line
token multiline_comment = start slash & o_block read block
# A word and the `@` it touches: `return@` (`break@`, `continue@`, `this@`, `super@`), or a
# label's definition (`loop@`). `as?`, and `enum` before `class`: one token each.
mask at_after   = code & at_sign & prev(w)
mask jat        = kw_start & (text("return@") | text("break@") | text("continue@") | text("this@") | text("super@"))
mask jat_last   = at_after & prev(fill(jat, at_sign))
mask lab_last   = at_after & ~jat_last
# A label's definition (`loop@`): a row at every letter beside `simple_identifier`'s, which
# doubles tier 2's tests at letters: not read yet.
escape "a label's definition" when lab_last
mask asq        = kw_start & text("as?")
mask word_start = word_run & ~prev(word_run) | sfx
# A name's token ends at its word's last byte, or at the `@` of `return@` (and the others) or the
# `?` of `as?`: one token, a keyword of its own.
mask name_tok   = fill(word_start, ~w)
mask name_last  = name_tok & ~next(name_tok) & ~next(jat_last) & ~next(prev(asq, 2)) | jat_last | prev(asq, 2)
token simple_identifier = start word_start last name_last
token integer_literal = start int_at last n_last
token real_literal = start dot_at last n_last
token hex_literal = start hex_at last h_last
token bin_literal = start bin_at last b_last
# A raw string's content runs through a run of quotes (the lean lexer's scanner ends its token
# after the run it read, looking for `"""`), or to a template: each run is a part of its own, to
# the first of a run of quotes' last quote and its own last byte (`r_end`).
mask r_q        = rbody & dq & ~next(dq)
mask r_id       = fill(prev(id_dollar), prev(id_last))
mask r_stop     = ~rbody | r_q | id_dollar | lone | r_id
mask r_x        = rbody & ~id_dollar & ~lone & ~r_id
mask r_start    = r_x & (~prev(r_x) | prev(r_q))
mask r_end      = r_x & ~next(r_x)
# A string: its opener, its parts, and its closer, a `"` or a template's `${`. After the
# template, the tail: its `}`, its parts, and the same closers.
# A string and a raw string: one reader at `"` (`read str | rstr`), each region's closer its
# own. A raw string's `"""` is its opener's byte and a part, `'""'`, for the two after it; its
# closer is three bytes, of the reader's kind.
token '"'       = start o_str | o_rstr read str | rstr parts {
                    '""' = prev(o_rstr) bytes 2
                    string_content = r_start last r_q | r_end
                    interpolation_identifier_start = id_dollar bytes 1
                    interpolated_identifier = prev(id_dollar) last id_last
                    string_content = lone bytes 1
                  } else string_content closes {
                    interpolation_expression_start = t_dollar bytes 2
                  }
token interpolation_expression_end = start o_tail | o_rtail read tail | rtail parts {
                    string_content = r_start last r_q | r_end
                    interpolation_identifier_start = id_dollar bytes 1
                    interpolated_identifier = prev(id_dollar) last id_last
                    string_content = lone bytes 1
                  } else string_content closes {
                    '"' = dq_close & prev(f_tail) bytes 1
                    '"' = rclose & prev(f_rtail) bytes 3
                    interpolation_expression_start = t_dollar bytes 2
                  }
# `\uXXXX`: tree-sitter keeps its `\u` as a token under the escape's node, its digits none.
token "'"       = start o_chr read chr parts {
                    "\\u" = c_uesc bytes 2
                    uni_digits = prev(c_uesc, 2) bytes 4
                    character_escape_seq = c_esc & ~next(u_letter) bytes 2
                  } else char_content
token backtick_name = start o_tick read tick
pairs two_start = "->" "==" "!=" "<=" ">=" "&&" "||" "++" "--" "+=" "-=" "*=" "/=" "%=" "::" "?." "?:" ".." "!!"
mask second     = prev(two_start) & code
mask p_start    = code & punct & ~second & ~nb & ~jat_last & ~prev(asq, 2) & ~three & ~prev(three) & ~prev(three, 2)
token punct     = start p_start pair two_start
token op3       = start three last prev(three, 2)

# The hard keywords: no name. (`by` and `constructor` are soft, as in tree-sitter-kotlin.)
keywords simple_identifier {
  "as" "break" "class" "continue" "do" "else" "false" "for" "fun" "if" "in" "interface" "is"
  "null" "object" "return" "super" "this" "throw" "true" "try" "typealias" "val" "var" "when"
  "while" "return@" "break@" "continue@" "this@" "super@" "as?" "vararg" "noinline" "crossinline" "L" "u" "U" "uL" "UL"
} soft {
  "package" "import" "by" "constructor"
  "expect" "data" "inner" "value" "actual" "set" "get" "override" "suspend" "annotation" "sealed" "lateinit" "tailrec" "operator" "infix" "inline" "external" "public" "private" "internal" "protected" "abstract" "final" "open" "const" "reified" "field" "property" "receiver" "param" "setparam" "delegate" "companion" "init" "dynamic" "where" "catch" "finally" "enum" "file" "out"
}
keywords interpolated_identifier { } soft { "expect" "data" "inner" "value" "actual" "set" "get" "override" "suspend" "annotation" "sealed" "lateinit" "tailrec" "operator" "infix" "inline" "external" "public" "private" "internal" "protected" "abstract" "final" "open" "const" "vararg" "noinline" "crossinline" "reified" "field" "property" "receiver" "param" "setparam" "delegate" "companion" "constructor" "init" "dynamic" "where" "catch" "finally" "enum" "out" }
keywords op3 { "===" "!==" "..<" } required
keywords punct { "." "*" "/" "," ":" "(" ")" "{" "}" "[" "]" ";" "<" ">" "=" "+" "-" "!" "?" "%" "@" "->" "==" "!=" "<=" ">=" "&&" "||" "++" "--" "+=" "-=" "*=" "/=" "%=" "?." "?:" ".." "!!" "::" } required

skip ws

# A line break that ends a statement, or the file's end: the scanner's semicolon (the lean lexer's
# `asi`), unless the next token goes on the line: one that starts with a byte of `goes_on`, `!=`,
# `as`, `where`, `catch`, `finally`, `by`, and `else` but a `when` entry's (`else ->`). Before a
# `}`, `semi_close`. In a class's header (the scanner's `constructor` context), `constructor` goes
# on too, and so does an annotation or a visibility modifier before it. The comments before it
# are the statement's (`settles`).
mark semi       = lf_end & ~class_head, unless before "}" | "," | "." | ".." | "..<" | ":" | "::" | "*" | "*=" | "%" | "%=" | ">" | ">=" | "<" | "<=" | "=" | "==" | "===" | "{" | "[" | "(" | "?" | "?." | "?:" | "||" | "&&" | "/" | "/=" | "!=" | "!==" | "as" | "as?" | "where" | "catch" | "finally" | "by", unless before "else" ~"->", unless before "else" end, end, settles, ends, drops swallow_at
mark semi       = lf_end & class_head, unless before "}" | "," | "." | ".." | "..<" | ":" | "::" | "*" | "*=" | "%" | "%=" | ">" | ">=" | "<" | "<=" | "=" | "==" | "===" | "{" | "[" | "(" | "?" | "?." | "?:" | "||" | "&&" | "/" | "/=" | "!=" | "!==" | "as" | "as?" | "where" | "catch" | "finally" | "by", unless before "else" ~"->", unless before "else" end, unless before "constructor", unless before "@" | "public" | "private" | "internal" | "protected" (simple_identifier | "." | "@")* "constructor", end, settles, ends, drops swallow_at
mark semi_close = close_at, before "}", settles, ends
# A receiver's `.`, where the name's loop of `.`s must stop (with the receiver's first token,
# where the optional part opens), and a delegation's `{`. Before `generic`, which holds at a
# receiver's first token too.
# The receiver's first token: a run of the type's tokens to a `.` and a name that no `.` or type
# argument follows, but a delegated property's name (`val x by a.b`); its last `.`: that `.` and
# name. One mark (a code holds 16): each `before`
# starts with its own token.
mark dotted     = rstart & decl_run | code & dot & decl_run | del_brace, before simple_identifier | backtick_name (simple_identifier | backtick_name | "in" | "." | "<" | ">" | "," | "?" | "*")* "." simple_identifier | backtick_name ~("." | "<" | ">" | "?." | ","), before "." simple_identifier | backtick_name ~("." | "<" | ">" | "?." | ","), before "{", unless before simple_identifier | backtick_name "by"
# A property's accessor: its `get` or `set` at a line's start (or after a visibility word there).
mark acc        = acc_word, unless before "get" | "set" "." | ":", unless before "get" "(" ~")"
# A `{` after `)`, `else`, `do`, `try` or `finally`: where a control structure's body goes, a
# block, not a lambda; after a call's arguments, the call's own lambda (the lean parser's
# `call`), not another call's. Before the lambda's marks, which hold at the same token.
mark blk        = tokens after ")" | "else" | "do" | "try" | "finally" | "->" "{"
# A lambda with no parameters before its `->`.
mark lam_bare   = tokens "{" "->"
# A lambda's parameters, before its `->` (the lean parser's `lambda_params_end`): from the `{`,
# the tokens parameters are made of, then a `->` where the brackets are closed. `(`, `[` and `<`
# go one deeper and their closers one out, on one depth, as the lean parser counts them; a closer
# at depth 0 ends the run. A `{` inside them is another lambda's: it ends the run, so an inner
# lambda's `->` does not mark the outer `{`. It holds at `{ ->` too, as the lean parser's does;
# `lam_bare`, a mark before it, is tested first and takes that.
mark lam_params = tokens "{" (simple_identifier | backtick_name | "in" | "," | ":" | "." | "?" | "*" | "@" | "(" | ")" | "[" | "]" | "<" | ">" | "->")* nest ("(" | "[" | "<" to ")" | "]" | ">") "->"
# A `!` that starts a line before `in` or `is`: a `when` entry's negated test. `named`'s token
# marks (below) are its other cases.
mask bang_test  = code & text("!") & prev(fill(lf & code, solid)) & next(text("in") & ~next(w, 2) | text("is") & ~next(w, 2))
mark named      = bang_test
# A `<` that opens type arguments in an expression (the lean parser's `type_args_end`): the tokens
# from it are a type's (names, `, . ? * @ : -> ( ) [ ] < >`) up to a `>` that `(`, `{`, `.`, `?.`
# or `::` follows. It touches the name before it, as a comparison's `<` seldom does (the lean
# parser does not ask: a spaced `f <T>()` is refused, read as a comparison). In a type it opens
# type arguments or parameters anyway, which take it. Where no rule takes it, the file is refused.
# The run counts `<` `>` and `(` `)` as the lean parser does: the `>` is the one whose depth closes
# the `<`, and a `)` with no `(` ends the run.
# And a parenthesized type's `(`: after a `:`, before another `(`; and a `suspend` there.
mask colon_ty   = code & text(":") & ~text("::") & ~prev(text(":")) & ~prev(text("?"))
mask after_ty   = prev(fill(prev(colon_ty), solid))
# And a function type's receiver's first name: names, dots and type arguments from it to a `.`
# before a `(`.
# One mark: each `before` starts with its own token (a receiver's name not `suspend`).
mask frecv_at   = w & ~prev(w | dot | text("<") | text(">")) & ~text("suspend")
mark generic    = code & text("<") & ~text("<=") & prev(w) | code & text("(") & after_ty | code & text("suspend") & ~next(w, 7) & after_ty | frecv_at, before "<" (simple_identifier | backtick_name | "in" | "," | "." | "?" | "*" | "@" | ":" | "->" | "(" | ")" | "[" | "]" | "<" | ">")* nest ("<" to ">") ("(" to ")") ">" "(" | "{" | "." | "?." | "::", before "(" "(", before "suspend" "(", before simple_identifier (simple_identifier | "." | "<" | ">")* "." "("
# A decimal number with a fraction, an exponent or an `f`: a real one.
mark real       = empty, at integer_literal when count(frac_dot | e_at | f_at) at least 1
# A backtick name before `::`: no rule takes it, so the file is refused where it holds. It
# refuses at every level, tested once a token by its bit: the code holds it (decision 0407).
mark bt_cref    = tokens backtick_name "::"
# The token marks that tier 2 tests alone, after the marks the code holds (decision 0407): no
# bit of the code, no mask; each its tokens, read at the token as the lean parser peeks.
# A modifier word where a declaration follows it, not a name.
# An `@` that starts an annotated expression, as the lean parser's `declaration_ahead` finds no
# declaration (Q225): from it, past annotations (their arguments counted, never a declaration's
# hard keyword, a `{`, a `}`, a `;` or a use-site target's `:`), where the run's last token ends an annotation (a name, a
# `)` or a `>`), a token that goes on no annotation and is no modifier and no declaration's word.
# Where it does not hold, the `@` starts a declaration's modifiers. (`get` and `set` are an
# accessor's only after a property, where this mark is not asked.)
mark ann_expr   = tokens "@" (~("fun" | "val" | "var" | "class" | "interface" | "object" | "typealias" | "{" | "}" | ";" | ":"))* nest ("(" to ")") ending (simple_identifier | backtick_name | ")" | ">") ~("@" | "." | ":" | "(" | "<" | "?." | "::" | "public" | "private" | "internal" | "protected" | "abstract" | "final" | "open" | "override" | "lateinit" | "const" | "sealed" | "annotation" | "data" | "inner" | "value" | "tailrec" | "operator" | "infix" | "inline" | "external" | "suspend" | "vararg" | "noinline" | "crossinline" | "expect" | "actual" | "fun" | "val" | "var" | "class" | "interface" | "object" | "typealias" | "companion" | "constructor" | "init" | "enum")
mark decl_mod   = tokens after ~("." | "?." | "::") "public" | "private" | "internal" | "protected" | "abstract" | "final" | "open" | "override" | "lateinit" | "const" | "sealed" | "annotation" | "data" | "inner" | "value" | "tailrec" | "operator" | "infix" | "inline" | "external" | "suspend" | "vararg" | "noinline" | "crossinline" | "expect" | "actual" "public" | "private" | "internal" | "protected" | "abstract" | "final" | "open" | "override" | "lateinit" | "const" | "sealed" | "annotation" | "data" | "inner" | "value" | "tailrec" | "operator" | "infix" | "inline" | "external" | "suspend" | "vararg" | "noinline" | "crossinline" | "expect" | "actual" | "fun" | "val" | "var" | "class" | "interface" | "object" | "get" | "set" | "companion" | "constructor" | "enum" | "typealias" | "@"
# An annotation's use-site target (`@get:`), and a file annotation's `@` (`@file:`).
mark use_site   = tokens after "@" "field" | "property" | "get" | "set" | "receiver" | "param" | "setparam" | "delegate" ":"
mark file_at    = tokens "@" "file" ":"
# A list's trailing comma, before its closer.
mark trail      = tokens "," ")" | ">" | "]" | "}" | "->"
# An import's `.` before its `*`, where the name's loop of `.`s stops.
mark wild       = tokens "." "*"
# An object literal's `object`, before its `:` or `{`, not a companion's: an expression, where a
# statement's `object` declares one.
mark obj_lit    = tokens after ~"companion" "object" ":" | "{"
# A function type's receiver's `.`: a `(` after it (no expression has `.(`).
mark ft_dot_at  = tokens "." "("
# A name before `::`, but `this` (a hard keyword, as every one): a callable reference's receiver.
mark cref       = tokens simple_identifier "::"
# A name and `=` (or an assignment's operator): an assignment to it, or a named argument; and a
# name and `:`, a function type's named parameter (`(url: String) -> Unit`).
mark named      = tokens simple_identifier "=" | "+=" | "-=" | "*=" | "/=" | "%="
mark named      = tokens simple_identifier ":"
# An enum class's `enum`, a soft word elsewhere.
mark enum_class = tokens "enum" "class"

tree kotlin {
  node source_file whole = (file_at file_annotation semi)* [package_header] [import_list] (statement (semi | ';'))*
  # A name: a word, or a soft keyword, which tree-sitter keeps as a leaf under the name's node.
  # `file` is a keyword for `@file:` alone: as a name, the lean parser's plain one (no word leaf).
  choice name           = simple_identifier | backtick_name as simple_identifier | soft_name | 'file' as simple_identifier | 'out' as simple_identifier | 'by' as simple_identifier
  node soft_name        = retag simple_identifier soft_word
  choice type_name      = simple_identifier as type_identifier | backtick_name as type_identifier | soft_type_name | 'file' as type_identifier
  node soft_type_name   = retag type_identifier soft_word
  choice soft_word      = 'constructor' | 'expect' | 'data' | 'inner' | 'value' | 'actual' | 'set' | 'get' | 'override' | 'suspend' | 'annotation' | 'sealed' | 'lateinit' | 'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'public' | 'private' | 'internal' | 'protected' | 'abstract' | 'final' | 'open' | 'const' | 'field' | 'property' | 'receiver' | 'param' | 'setparam' | 'delegate' | 'companion' | 'init' | 'dynamic' | 'where' | 'catch' | 'finally' | 'enum'
  node package_header   = 'package' identifier (semi | ';')
  node identifier       = name ('.' name)*
  node import_list      = import_header+
  node import_header    = 'import' import_identifier [wild '.' '*' as wildcard_import | import_alias] (semi | ';')
  node import_identifier = retag identifier name ('.' name)*
  node import_alias     = 'as' type_name

  # --- Statements --------------------------------------------------------------------------------

  choice statement nested = declaration | for_statement | while_statement | do_while_statement | assignment | expression [assign_tail]
  # Statements in a block: a line break between them, and before the `}` if it likes.
  node statements nested = statement (semi statement | ';' [statement])* [semi_close]
  choice block          = '{' [statements] '}'
  node control_structure_body = blk block | statement
  node for_statement    = 'for' '(' (variable_declaration | multi_variable_declaration) 'in' expression ')' [control_structure_body]
  node while_statement  = 'while' '(' expression ')' control_structure_body
  node do_while_statement = 'do' control_structure_body 'while' '(' expression ')'
  # `x = …`: the name the assignment's target.
  node assignment       = named directly_assignable_expression assignment_operator expression
  node directly_assignable_expression = name
  choice assignment_operator = '=' | '+=' | '-=' | '*=' | '/=' | '%='
  # `a.b = …`, `a[i] += …`: the navigations and indexings read so far, the target's, flat.
  choice assign_tail    = wrap assignment _ reread assignable assignment_operator expression
  reading assignable    = root as directly_assignable_expression, navigation_expression gone, indexing_expression gone,
                          keep simple_identifier soft_name navigation_suffix indexing_suffix call_expression parenthesized_expression this_expression

  # --- Declarations ------------------------------------------------------------------------------

  # A declaration's node is opened at its first token: its modifiers' or its keyword's.
  node declaration nested = [modifiers] declaration_rest
  choice declaration_rest = retag function_declaration function_rest | retag property_declaration property_rest
                          | retag class_declaration class_rest | retag object_declaration object_rest
                          | retag type_alias alias_rest
  choice alias_rest     = 'typealias' type_name [type_parameters] '=' type
  choice function_rest  = 'fun' [type_parameters] [receiver] name function_value_parameters [':' type] [function_body]
  choice property_rest  = binding_pattern_kind [receiver] (variable_declaration | multi_variable_declaration) ['=' expression | property_delegate | getter_inline]
  node property_delegate = 'by' expression
  choice class_rest     = ('class' | 'interface') type_name [type_parameters] [primary_constructor] [':' delegation_specifier (',' delegation_specifier)*] [class_body]
                        | enum_class 'enum' 'class' type_name [type_parameters] [primary_constructor] [':' delegation_specifier (',' delegation_specifier)*] [enum_class_body]
  # An enum's entries, `,` between them, a line break where one may come; then after a `;`, the
  # members.
  node enum_class_body  = '{' [enum_entry (',' [semi] enum_entry)*] (trail_brace | [semi_close] [';' [semi] [class_member ((semi | ';') class_member)* [semi_close]]] '}')
  node enum_entry       = name [value_arguments] [class_body]
  choice object_rest    = 'object' type_name [':' delegation_specifier (',' delegation_specifier)*] [class_body]
  node binding_pattern_kind = 'val' | 'var'
  node variable_declaration = name [':' type]
  # `(` is a leaf of the lean tape, `)` none.
  node multi_variable_declaration = '(' variable_declaration (',' variable_declaration)* ')'
  node function_value_parameters = '(' [function_value_parameter (',' function_value_parameter)*] (trail_paren | ')')
  choice function_value_parameter = [parameter_modifiers] parameter ['=' expression]
  node parameter        = name ':' type
  node parameter_modifiers = (annotation | parameter_modifier)+
  node function_body    = block | '=' expression
  node primary_constructor = [[modifiers] 'constructor'] '(' [class_parameter (',' class_parameter)*] (trail_paren | ')')
  node class_parameter  = [modifiers] [binding_pattern_kind] name ':' type ['=' expression]
  node delegation_specifier = user_type [wrap constructor_invocation _ value_arguments | wrap explicit_delegation _ 'by' expression]
  node class_body       = [dotted] '{' [class_member (semi class_member | ';' [class_member])* semi_close] '}'
  node class_member nested = [modifiers] member_rest
  choice member_rest    = declaration_rest | retag companion_object companion_rest | retag anonymous_initializer init_rest
                        | retag secondary_constructor ctor_rest
                        | acc accessor
  choice accessor       = retag getter getter_rest | retag setter setter_rest
  node getter_inline nested = getter_retag
  choice getter_retag   = retag getter getter_rest
  choice getter_rest    = 'get' ['(' ')' [':' type] function_body]
  choice setter_rest    = 'set' ['(' parameter_with_optional_type ')' [':' type] function_body]
  node parameter_with_optional_type = name [':' type]
  choice companion_rest = 'companion' 'object' [type_name] [':' delegation_specifier (',' delegation_specifier)*] [class_body]
  choice init_rest      = 'init' block
  choice ctor_rest      = 'constructor' function_value_parameters [':' constructor_delegation_call] [blk '{' [statements] '}']
  node constructor_delegation_call = ('this' | 'super') value_arguments
  node type_parameters  = [generic] '<' type_parameter (',' type_parameter)* (trail_angle | '>')
  node type_parameter   = [type_parameter_modifiers] type_name [':' type]
  node type_parameter_modifiers = (reification_modifier | variance_modifier)+
  node reification_modifier = 'reified'

  # Modifiers: an annotation, or a word a declaration follows (`decl_mod`).
  node modifiers        = (annotation | decl_mod modifier)+
  choice modifier       = class_modifier | member_modifier | visibility_modifier | function_modifier | property_modifier | inheritance_modifier | parameter_modifier | platform_modifier
  node class_modifier   = 'sealed' | 'annotation' | 'data' | 'inner' | 'value'
  node member_modifier  = 'override' | 'lateinit'
  node visibility_modifier = 'public' | 'private' | 'internal' | 'protected'
  node function_modifier = 'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'suspend'
  node property_modifier = 'const'
  node inheritance_modifier = 'abstract' | 'final' | 'open'
  node parameter_modifier = 'vararg' | 'noinline' | 'crossinline'
  node platform_modifier = 'expect' | 'actual'
  # `@A`, `@A.B`, `@A(x)`: its arguments after the type, always.
  # A line break after an annotation is the scanner's semicolon; the lean parser reads on to
  # what it annotates.
  node annotation       = '@' [use_site use_site_target] user_type [wrap constructor_invocation _ value_arguments] [semi]
  node use_site_target  = ('field' | 'property' | 'get' | 'set' | 'receiver' | 'param' | 'setparam' | 'delegate') ':'
  node file_annotation  = '@' 'file' ':' user_type [wrap constructor_invocation _ value_arguments]

  # --- Types -------------------------------------------------------------------------------------

  choice type nested    = user_type [wrap nullable_type _ ('?' as quest)+] | function_type
                        | generic (parenthesized_type [wrap nullable_type _ ('?' as quest)+] | recv_function_type | type_modifiers function_type)
  node recv_function_type = retag function_type receiver: fn_receiver ft_dot_at '.' function_type_parameters '->' type
  node fn_receiver      = retag receiver_type fn_receiver_type
  # Its first name is no soft word, which `suspend` would be (a soft word's receiver is refused).
  node fn_receiver_type = retag user_type fn_name [type_arguments] ('.' type_name [type_arguments])*
  choice fn_name        = simple_identifier as type_identifier | backtick_name as type_identifier
  node type_modifiers   = 'suspend'
  node parenthesized_type = '(' type ')'
  choice receiver       = dotted receiver: receiver_type dotted '.'
  node receiver_type    = type
  node user_type        = type_name [type_arguments] ('.' type_name [type_arguments])*
  node type_arguments   = [generic] '<' type_projection (',' type_projection)* (trail_angle | '>')
  node type_projection  = [type_projection_modifiers] type | '*'
  node type_projection_modifiers = variance_modifier+
  node variance_modifier = 'in' | 'out'
  node function_type    = function_type_parameters '->' type
  node function_type_parameters = '(' [ft_parameter (',' ft_parameter)*] (trail_paren | ')')
  choice ft_parameter   = named parameter | type

  # --- Expressions -------------------------------------------------------------------------------

  # By tree-sitter-kotlin's precedences, each operation around the left side so far.
  choice expression nested = unary_level (as_op)* (mul_op)* (add_op)* (range_op)* (infix_op)* (elvis_op)* (check_op)* (cmp_op)* (eq_op)* (conj_op)* (disj_op)*
  choice mul_op         = wrap multiplicative_expression _ ('*' | '/' | '%') as_operand
  # The type after `as`: a dotted name, or one name with type arguments. With both, the lean
  # parser reads a comparison where an expression follows on the next line: refused.
  choice as_op          = wrap as_expression _ ('as' | 'as?') as_type
  choice as_type        = as_user_type [wrap nullable_type _ ('?' as quest)+] | function_type
  node as_user_type     = retag user_type type_name (type_arguments | ('.' type_name)*)
  choice as_operand nested = unary_tight (as_op)*
  choice add_op         = wrap additive_expression _ ('+' | '-') add_operand
  choice range_op       = wrap range_expression _ ('..' | '..<') range_operand
  choice infix_op       = wrap infix_expression _ name infix_operand
  choice elvis_op       = wrap elvis_expression _ '?:' elvis_operand
  choice check_op       = wrap check_expression _ ['!'] ('in' check_operand | 'is' type)
  choice cmp_op         = wrap comparison_expression _ ('<' | '>' | '<=' | '>=') cmp_operand
  choice eq_op          = wrap equality_expression _ ('==' | '!=' | '===' | '!==') eq_operand
  choice conj_op        = wrap conjunction_expression _ '&&' conj_operand
  choice disj_op        = wrap disjunction_expression _ '||' disj_operand
  # Each operator's right side: the operations that bind tighter.
  choice add_operand nested = unary_tight (as_op)* (mul_op)*
  choice range_operand nested = unary_tight (as_op)* (mul_op)* (add_op)*
  choice infix_operand nested = unary_tight (as_op)* (mul_op)* (add_op)* (range_op)*
  choice elvis_operand nested = unary_tight (as_op)* (mul_op)* (add_op)* (range_op)* (infix_op)*
  choice check_operand nested = unary_tight (as_op)* (mul_op)* (add_op)* (range_op)* (infix_op)* (elvis_op)*
  choice cmp_operand nested = unary_tight (as_op)* (mul_op)* (add_op)* (range_op)* (infix_op)* (elvis_op)* (check_op)*
  choice eq_operand nested = unary_level (as_op)* (mul_op)* (add_op)* (range_op)* (infix_op)* (elvis_op)* (check_op)* (cmp_op)*
  choice conj_operand nested = unary_level (as_op)* (mul_op)* (add_op)* (range_op)* (infix_op)* (elvis_op)* (check_op)* (cmp_op)* (eq_op)*
  choice disj_operand nested = unary_level (as_op)* (mul_op)* (add_op)* (range_op)* (infix_op)* (elvis_op)* (check_op)* (cmp_op)* (eq_op)* (conj_op)*

  # A prefix operator's operand: the postfix operations bind tighter.
  choice unary_level nested = prefix_expression | primary_tight (postfix_level)*
  # A generic call, after a name or a navigation: only where the operand is no tighter operator's
  # (`a ?: f<T>()` is the call over the whole, in tree-sitter's GLR parse: refused).
  choice postfix_level  = postfix_op | generic (wrap call_expression _ generic_suffix)
  # The right operand of a comparison or of an operator that binds tighter: the lean parser puts a
  # generic call's type arguments there over the whole operation (`a to f<T>()` is
  # `call(infix(a, f), <T>())`), not read yet. Its `generic` mark is taken by no rule: refused.
  choice unary_tight nested = prefix_expression | primary_tight (postfix_op)*
  node prefix_expression = ('!' | '-' | '+' | '++' | '--') unary_level | ann_expr annotation expression
  choice postfix_op     = wrap call_expression _ call_suffix
                        | wrap navigation_expression _ navigation_suffix
                        | wrap indexing_expression _ indexing_suffix
                        | wrap postfix_expression _ ('++' | '--' | '!!')
  node call_suffix      = value_arguments [blk annotated_lambda] | annotated_lambda
  node annotated_lambda = lambda_literal
  node lambda_literal   = lam_bare lambda_bare_open [statements] '}'
                        | lam_params '{' lambda_parameters '->' [statements] '}'
                        | '{' [statements] '}'
  # `{ ->`: not the tokens the grammar implies, so both are leaves.
  choice lambda_bare_open = '{' '->'
  node lambda_parameters = lambda_parameter (',' lambda_parameter)*
  choice lambda_parameter = variable_declaration | multi_variable_declaration [':' type]
  node navigation_suffix = ('.' | '?.' | '::') ('class' | name)
  node indexing_suffix  = '[' expression (',' expression)* (trail_bracket | ']')
  node value_arguments  = '(' [value_argument (',' value_argument)*] (trail_paren | ')')
  node value_argument   = named name '=' expression | spread_expression | expression
  node spread_expression = '*' expression

  choice primary_tight nested = name | obj_lit object_literal
                        | number_literal | string_literal | character_literal | boolean_literal | 'null' as null_literal | this_expression
                        | parenthesized_expression | jump_expression | if_expression | when_expression | try_expression | callable_reference
                        | lambda_literal | super_expression | collection_literal
  node collection_literal = '[' expression (',' expression)* (trail_bracket | ']')
  node callable_reference = [cref type_name] '::' ('class' | name)
  node generic_suffix   = retag call_suffix type_arguments (value_arguments [blk annotated_lambda] | annotated_lambda)
  node boolean_literal  = 'true' | 'false'
  node character_literal = "'" [character_escape_seq | uni_escape | char_content] "'"
  node uni_escape       = retag character_escape_seq "\\u" uni_digits
  # An integer and its suffix: the suffix's node wraps the integer, and keeps no leaf of it.
  choice number_literal nested = real integer_literal as real_literal | (integer_literal | hex_literal | bin_literal) [wrap long_literal _ 'L' | wrap unsigned_literal _ ('u' | 'U' | 'uL' | 'UL')] | real_literal
  choice interp_id      = interpolated_identifier | soft_interp
  node soft_interp      = retag interpolated_identifier interp_soft
  choice interp_soft    = 'expect' | 'data' | 'inner' | 'value' | 'actual' | 'set' | 'get' | 'override' | 'suspend' | 'annotation' | 'sealed' | 'lateinit' | 'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'public' | 'private' | 'internal' | 'protected' | 'abstract' | 'final' | 'open' | 'const' | 'vararg' | 'noinline' | 'crossinline' | 'reified' | 'field' | 'property' | 'receiver' | 'param' | 'setparam' | 'delegate' | 'companion' | 'constructor' | 'init' | 'dynamic' | 'where' | 'catch' | 'finally' | 'enum' | 'out'
  node string_literal   = '"' ['""'] (string_content | interpolation_identifier_start interp_id
                          | interpolation_expression_start interpolated_expression interpolation_expression_end)* '"'
  node interpolated_expression = expression
  node this_expression  = 'this' | 'this@' type_name
  node object_literal   = 'object' [':' delegation_specifier (',' delegation_specifier)*] [class_body]
  node super_expression = 'super'
  node parenthesized_expression = '(' expression ')'
  node jump_expression  = 'return' [expression] | 'return@' simple_identifier as label [expression] | 'throw' expression
                        | 'break' | 'continue' | ('break@' | 'continue@') simple_identifier as label
  # A `try`: its block's statements, its catches, its `finally`.
  node try_expression   = 'try' blk '{' [statements] '}' (catch_block)* [finally_block]
  node catch_block      = 'catch' '(' name ':' type ')' blk '{' [statements] '}'
  node finally_block    = 'finally' blk '{' [statements] '}'
  # A `when`: its subject, then its entries, each ended by a line break.
  # An entry holds the line break that ends it (tree-sitter's `when_entry` takes its `_semi`), so
  # a comment before the break is the entry's.
  node when_expression  = 'when' [when_subject blk] '{' (when_entry)* '}'
  node when_subject     = '(' ['val' variable_declaration '='] expression ')'
  node when_entry       = (when_condition (',' when_condition)* [when_trail] | 'else') '->' control_structure_body (semi | semi_close)
  node when_condition   = named neg_test | range_test | type_test | expression
  # One node from the `!`: a `range_test`, retagged a `type_test` at an `is`.
  node neg_test         = retag range_test '!' ('in' expression | neg_is)
  choice neg_is         = retag type_test 'is' type
  node range_test       = 'in' expression
  node type_test        = 'is' type
  node if_expression    = 'if' '(' condition: expression ')' consequence: control_structure_body ['else' alternative: control_structure_body]
  # An annotated `if` or `when`'s annotation. Its arguments are not optional: a `(` after the
  # name could begin the operand too.

  # A trailing comma: the lean parser leaves a list's tokens out only where they are the ones the
  # grammar implies, so after one the `,` and the closer are leaves.
  choice trail_paren    = trail ',' ')'
  # A `when` entry's: its own choice, so that `when_entry`'s implied `,` is not this one.
  choice when_trail     = trail ','
  choice trail_angle    = trail ',' '>'
  choice trail_bracket  = trail ',' ']'
  choice trail_brace    = trail ',' [semi_close] '}'

  # --- The tokens the grammar implies: no leaf ---------------------------------------------------

  implied package_header 'package' ';'
  implied import_header 'import' '.' ';'
  implied import_identifier '.'
  implied import_alias 'as'
  implied block '{' '}'
  implied lambda_literal '{' '}'
  implied lambda_parameters ','
  implied for_statement 'for' '(' ')' 'in'
  implied while_statement 'while' '(' ')'
  implied do_while_statement 'do' 'while' '(' ')'
  implied function_rest 'fun'
  implied property_rest '='
  implied class_rest ':' ','
  implied enum_class_body '{' '}' ',' ';'
  implied spread_expression '*'
  implied this_expression 'this@'
  implied object_rest 'object' ':' ','
  implied object_literal ','
  implied ctor_rest 'constructor' ':' '{' '}'
  implied multi_variable_declaration ',' ')'
  implied function_body '='
  implied function_value_parameters '(' ')' ','
  implied function_value_parameter '='
  implied parameter ':'
  implied primary_constructor 'constructor' '(' ')' ','
  implied class_parameter ':' '='
  implied class_body '{' '}' ';'
  implied source_file ';'
  implied statements ';'
  implied getter_rest '(' ')'
  implied setter_rest 'set' '(' ')'
  implied companion_rest 'companion' 'object' ':' ','
  implied init_rest 'init'
  implied type_parameters '<' '>' ','
  implied user_type '.'
  implied fn_receiver_type '.'
  implied as_user_type '.'
  implied type_arguments '<' '>' ','
  implied function_type '->'
  implied recv_function_type '.' '->'
  implied function_type_parameters '(' ')' ','
  implied elvis_op '?:'
  implied conj_op '&&'
  implied disj_op '||'
  implied indexing_suffix '[' ']' ','
  implied collection_literal '[' ']' ','
  implied parenthesized_type '(' ')'
  implied alias_rest 'typealias' '='
  implied value_arguments '(' ')' ','
  implied this_expression 'this'
  implied string_literal '"' '""'
  implied character_literal "'" char_content
  implied uni_escape uni_digits
  implied number_literal 'L' 'u' 'U' 'uL' 'UL'
  implied parenthesized_expression '(' ')'
  implied if_expression 'if' '(' ')'
  implied when_expression 'when' '{' '}'
  implied property_delegate 'by'
  implied delegation_specifier 'by'
  implied try_expression 'try' '{' '}'
  implied catch_block 'catch' '(' ':' ')' '{' '}'
  implied finally_block 'finally' '{' '}'
  implied when_subject '(' ')' 'val' '='
  implied when_entry ',' 'else'
  implied callable_reference '::' 'class'
  hidden semi semi_close named cref trail lam_params lam_bare blk use_site file_at real ann_expr
  extra line_comment multiline_comment
}
