# Kotlin.
#
# Reads headers, comments, declarations, types, statements, expressions, strings with
# templates, raw strings with templates, characters, backtick names, callable references,
# trailing commas, lambdas with destructured parameters, annotations, numbers, a class's
# members, `when`, `;`, `try`, `as`, receivers, generic functions, delegation, object literals,
# secondary constructors, destructuring, type arguments, enum classes, jumps to labels, `as?`,
# reified type parameters, spread arguments, named function type parameters, parenthesized
# types, type aliases, collection literals, strings in templates' code, a class's delegate
# before its body, variance, `get` and `set` as names and a local delegate with dots, function
# types with a receiver or `suspend`, annotated `if` and `when`, a `when` entry's trailing comma,
# swallowed block comments, soft keywords after a template's `$`, `constructor` after modifiers
# at a line's start, modifier words after a `.`, and `constructor` and `by` as names.
#
# The grammar asks what comes next where the lean parser does: at the token. A mark that the
# token after its gap decides says so (`before`, `unless before`), as the scanner's semicolon
# asks of the next token (`Lexer::asi`); the next tokens are a token mark's run, as the parser
# peeks. No mask reads the bytes after it (no back fills, decision 0416).
#
# A string closes at its `"` or at a template's `$` (`or t_dollar`), a raw string at its `"""`
# or at the `$` (its closer is three bytes, the `$` one). After the template's `}`, the string
# goes on as the kind of string the template is in: a tail (`tail`) after a string, a raw tail
# (`rtail`) after a raw string. A region kind's `after` says which: it opens only where the
# last region closed at its `or` (the template's `$`) is one it names, as the lean lexer's
# string reader goes back to its loop after the template's code. A string, a character or a
# comment in the code closes at its own closer and leaves it so. A raw tail is read as the raw
# string's bytes are: a run of them that reaches a quote first is a part of its own.
#
# A template's code ends at the first `}` on its line, found from the bytes before the
# regions. A string or a character in the code is a region of its own, as anywhere in code.
# Where that `}` is inside one (`"${f("}")}"`), it opens no tail: refused.
#
# The reference is the lean parser (`rerail_kotlin_lean`), whose tapes are tree-sitter-kotlin's
# (decision 0305). What the grammar does not read is refused, and goes to the lean parser: a
# template's code holding a brace, a template or a line break; `fun interface`, labels'
# definitions, and more.

lexer kotlin

class ws        = ' ' '\t' '\n' '\r' 0x0c
class lf        = '\n'
class slash     = '/'
class star      = '*'
class word      = 'a'..'z' 'A'..'Z' '0'..'9' '_'
class alpha     = 'a'..'z' 'A'..'Z' '_'
class digit     = '0'..'9'
class dot       = '.'
class at_sign   = '@'
class semicolon = ';'
class rbrace    = '}'
class gt        = '>'
# What a lambda's parameters are made of, up to their `->` (the lean parser's `lambda_params_end`).
class dq        = '"'
class sq        = '\''
class bt        = '`'
class sq_bt     = '\'' '`'
class u_letter  = 'u'
class zero      = '0'
class x_letter  = 'x' 'X'
class b_letter  = 'b' 'B'
class e_letter  = 'e' 'E'
class f_letter  = 'f' 'F'
class sign      = '+' '-'
class underscore = '_'
class decd      = '0'..'9' '_'
class hexd      = '0'..'9' 'a'..'f' 'A'..'F' '_'
class hex_digit = '0'..'9' 'a'..'f' 'A'..'F'
class bind      = '0' '1' '_'
class backslash = '\\'
class dollar    = '$'
class lbrace    = '{'
class high      = 0x80..0xff
class punct     = '.' '*' '/' ';' ',' ':' '(' ')' '{' '}' '[' ']' '<' '>' '=' '+' '-' '!' '?' '&' '|' '%' '^' '~' '@' '#' '$' '\\'
# The bytes a line may start with and go on the line before (the scanner's no semicolon).
class goes_on   = ',' '.' ':' '*' '%' '>' '<' '=' '{' '[' '(' '?' '|' '&' '/'

mask last_byte  = ~next(~empty)

# --- Regions -----------------------------------------------------------------------------------

mask line_open  = slash & next(slash)
mask block_open = slash & next(star)
# Its `*/`, not over the opener's `*` (`/*/` is open): the lean lexer reads from two bytes past the `/*`.
mask block_end  = slash & prev(star) & ~prev(block_open, 2)
# A string's closer: a `"` no backslash escapes.
mask dq_close   = dq & ~escaped(backslash)
mask sq_close   = sq & ~escaped(backslash)
# A template: `${`, where its `$` closes a string's region (a `${` in a comment or a character
# is no template), then code to the first `}` outside the code's own strings and characters:
# the regions say which `}` (a tail opens at a `}` only while a template is open, and a tail
# closed at its quote ends the string), as the lean lexer reads a template's code.
mask t_dollar   = dollar & next(lbrace) & ~escaped(backslash)
mask t_lex      = prev(t_dollar)
mask t_close    = rbrace
# A raw string: `"""`, then to the last three quotes of the next run of three or more past it
# (`bytes 3`, as the lean lexer looks from the opener's end): the opener's run of four or five
# quotes (`""""x"""`) is its `"""` and content, and the run of six its opener and its closer
# (`""""""`). A closing run's quotes before its last three are the closer's (`r_lead`).
mask dq3        = dq & next(dq) & next(dq, 2)
mask rclose     = dq3 & ~next(dq, 3)
# A template's code nests: its braces, and its strings' templates, as the lean lexer's
# `interpolation_end` counts them (decision 0621). A tail opens at the `}` that closes its
# template, not a brace's.
regions hidden nests lbrace .. rbrace depth 4 else t_deep {
  line  = line_open .. lf outside
  block = block_open .. block_end
  rstr  = dq3 bytes 3 .. rclose bytes 3 or t_dollar
  str   = dq & ~dq3 .. dq_close or t_dollar
  chr   = sq .. sq_close
  tick  = bt .. bt
  tail  = t_close .. dq_close or t_dollar resumes str
  rtail = t_close .. rclose bytes 3 or t_dollar resumes rstr
}
# Where a token in a region starts: a string's, a character's or a backtick name's opener.
mask opens      = o_str | o_chr | o_tick | o_tail | o_rstr | o_rtail
mask region     = hidden | o_line | o_block | opens
# A template's `{`: its `$`'s token's, not code.
mask t_brace    = t_lex & prev(hidden) & ~hidden
assume "a template's `{` is the last byte of its string's token, after the `$` that closes it" at ends t_brace
mask code       = ~region & ~t_brace

# A template's code: to the `}` its tail opens at, with its templates, comments, braces and line
# breaks, as the lean lexer's `interpolation_end` reads them. Not read yet past 4 levels, nor with
# no code. A `$` in code is no template's.
escape "a template's code nested past 4 levels" when t_deep
# An empty `${}`: a tail opens right after the `{` (a brace's would close at that `}`).
escape "an empty `${}`" when (o_tail | o_rtail) & prev(lbrace)
escape "a `$` outside a string" when code & dollar

error "a block comment open at the end of the file" by tokens when f_block & last_byte
error "a string open at the end of the file" by tokens when (f_str | f_tail | f_rstr | f_rtail) & last_byte
error "a character open at the end of the file" by tokens when f_chr & last_byte
error "a backtick name open at the end of the file" by tokens when f_tick & last_byte
# A character or a backtick name over a line is not read (the lean lexer refuses them). A
# string over a line is: the lean lexer reads it to its quote.
escape "a character or a backtick name over a line" when (f_chr | f_tick) & lf

# --- Strings -----------------------------------------------------------------------------------

# A raw string's bytes after its `"""`, and a raw tail's after its `}`. No backslash escapes in it.
mask rbody      = f_rstr & ~o_rstr & ~prev(o_rstr) & ~prev(o_rstr, 2) | f_rtail & ~o_rtail
# A `\$` there is content, and the lean parser's reader passes the byte after it too: before a
# quote it ends the string after that one quote, and a `$` after it starts no template. Those
# are not read.
escape "a `\$` before a quote or a `$` in a raw string" when rbody & dollar & escaped(backslash) & next(dq | dollar)
mask body       = f_str & ~o_str | f_tail & ~o_tail | rbody
mask s_word     = body & word
mask s_dollar   = body & dollar & ~escaped(backslash)
escape "a `$` before a backtick" when s_dollar & next(bt)
# `$name`: the `$`, then the name to its last word byte.
mask id_dollar  = s_dollar & next(alpha)
mask id_last    = s_word & ~next(s_word)
# A `$` before no name: a content token of its own, the content after it another.
mask lone       = s_dollar & ~next(alpha)

# --- Characters --------------------------------------------------------------------------------

mask c_body     = f_chr & ~o_chr
# An escape: a `\` no backslash escapes; `\u` and four hex digits, else two bytes.
mask c_esc      = c_body & backslash & ~escaped(backslash)
mask c_uesc     = c_esc & next(u_letter)
# `\u` and four hex digits, as the lean lexer's `char_escape_end`: else refused.
escape "a `\\u` without four hex digits" when prev(c_uesc, 2) & ~(hex_digit & next(hex_digit) & next(hex_digit, 2) & next(hex_digit, 3))
escape "a byte above 0x7f outside a comment" when code & high
escape "a nested block comment" when f_block & ~o_block & block_open
# The scanner's semicolon is the line break; a `;` that starts a line, or ends the file, comes
# with one: not read yet.

# --- Words -------------------------------------------------------------------------------------

mask w          = code & word
mask word_run       = fill(w & alpha & ~prev(w), ~w)
# A digit after a `.` is a fraction's, but after `..` a number's first (`1..2`).
mask num_start  = w & digit & ~prev(w) & ~prev(dot & ~prev(dot))

# A number, as the lean lexer reads one: hex (`0x`) and binary (`0b`) digits; else decimal
# digits, then a fraction (a `.` and digits), an exponent (`e`, a sign, digits) and an `f`,
# each where it may come. A `.` before a digit starts one too (`.5`), but not after a word or
# a `.` (`1..2` is a range).
mask hex_at     = num_start & zero & next(x_letter)
mask bin_at     = num_start & zero & next(b_letter)
mask hx         = fill(prev(hex_at, 2) & hexd, ~hexd)
mask bx         = fill(prev(bin_at, 2) & bind, ~bind)
escape "a `0x` or `0b` with no digit" when prev(hex_at, 2) & ~hexd | prev(bin_at, 2) & ~bind
mask dot_at     = code & dot & next(digit) & ~prev(w) & ~prev(dot)
mask di         = fill(num_start & ~hex_at & ~bin_at, ~decd)
mask frac_dot   = code & dot & prev(di) & next(digit)
mask fr         = fill(prev(frac_dot | dot_at), ~decd)
mask e_at       = code & e_letter & prev(di | fr) & (next(digit) | next(sign) & next(digit, 2))
mask e_sign     = sign & prev(e_at)
mask ex         = fill(prev(e_at) & digit | prev(e_sign), ~decd)
mask f_at       = code & f_letter & prev(di | fr | ex)
mask nb         = di | frac_dot | dot_at | fr | e_at | e_sign | ex | f_at
mask n_last     = nb & ~next(nb)
# A decimal number's kind is told at its end, as the lean lexer tells it once it has read the
# number: a fraction, an exponent or an `f` make it real (`real`, a test of the token's bytes).
# One that starts with a `.` is real.
mask int_at     = num_start & ~hex_at & ~bin_at
mask h_last     = hx & ~next(hx)
mask b_last     = bx & ~next(bx)
# A suffix (`L`, `u`, `uL`) is the name token after an integer, touching it: the integer's
# rule asks (`sfx`, below), as the lean parser's `integer` does.
mask int_last   = n_last & di | h_last | b_last
# The suffix's first byte: a name starts there, though it touches the number.
mask sfx_start  = w & alpha & prev(int_last)
escape "a digit after a binary number" when w & digit & prev(int_last)
escape "a word touching a real number" when n_last & ~di & next(w)
escape "a number that ends in `_`" when (n_last | h_last | b_last) & underscore
mask number     = fill(num_start, ~w) | nb
error "a byte no token takes" by tokens when code & ~ws & ~word_run & ~number & ~punct

# A word ends here (no word byte after it) and starts here (none before it).
mask kw_start   = w & ~prev(w)

# --- The scanner's semicolon -----------------------------------------------------------------

# A byte of code that is not blank, or a string's opener: where a token starts or goes on.
mask solid      = (code | opens) & ~ws
# A line break in code where the next token does not go on the line: the statement's end. Before
# a `}`, a mark of its own: a block's statements may end with one, a class body's members must.
# A line break after a `;` (and blanks or comments): the `;` was the semicolon.
mask after_semi = fill(prev(code & semicolon), solid)
# The line breaks that may end a statement: the semicolon's gap. Its tokens after decide (`semi`).
mask lf_end     = lf & code & ~after_semi
# A `}` after a `;`: the `;` closed the line, so the `}` closes as after a line break.
mask close_at   = lf_end | code & rbrace & (prev(after_semi) | prev(code & semicolon))

# The first token of each line, and the bytes of a line from an `@` or a visibility modifier
# that starts it (an accessor's, `acc_word`).
mask line_first = solid & prev(fill(lf & code, solid))
escape "a `;` that starts a line" when code & semicolon & line_first
# No solid byte after it, at the file's last byte.
escape "a `;` that ends the file" when last_byte & fill(code & semicolon, solid)
# `get` or `set` first on a line: an accessor, which tree-sitter reads as a declaration of its own
# after a property's; not read yet.
# A getter or setter on a line of its own: a mark a class body's member takes. Elsewhere (a
# property's at the top level, a call to `get` starting a line in a function) it refuses.
# The type after `as`, `as?` or `is`: its names, dots, angles and blanks on its line (`as_run`).
# Where a `<` after a dot in it (`as_lt`) runs to a `>` that ends the line, the lean parser's
# `split_type` reads `x as a.b.C<D>` as tree-sitter does: navigations over `x as a`, then a
# call's type arguments where `(` or `{` starts the next line, or comparisons where an operand
# does (`as_open`, `as_split`). A blank, a comment or a `\r` after that `>`, which the lean
# parser reads past to the next line: not read.
mask as_kw      = kw_start & (text("as") | text("is")) & ~next(w, 2)
mask as_run     = fill(prev(as_kw, 2), ~(code & (word | dot | text(" ") | text("?") | text("<") | text(">"))))
mask as_dot     = fill(as_run & dot, ~as_run)
mask as_lt      = fill(as_dot & text("<"), ~as_dot)
escape "a blank, a comment or a `\r` after a type the lean parser may split" when (text(" ") | slash | text("\r")) & prev(as_lt) & prev(gt)

# --- Tokens ------------------------------------------------------------------------------------

token line_comment = start slash & o_line read line
token multiline_comment = start slash & o_block read block
# `return@`, `this@`, `as?` and a label's `loop@` are two tokens each, as the lean lexer reads
# them; tier 2 joins them where its rule takes them (`apart` and the token marks after it).
mask at_after   = code & at_sign & prev(w)
mask word_start = word_run & ~prev(word_run) | sfx_start
# A name's token ends at its word's last byte.
mask name_tok   = fill(word_start, ~w)
# A name runs over its word's bytes after its first, as the lean lexer's word reader. A number
# runs over its bytes: a decimal's, or a `0x`'s or `0b`'s letter and digits.
mask name_more  = name_tok & ~word_start
# What the token loop reads of the masks above at a token's start (decision 0552): the regions
# open only at a token's start, so no start is in one, and the token before a start ends there.
assume "a name starts at a word's first letter: a start is never in a word" at starts word_start = alpha
assume "a number starts at a digit not after one `.`: a start is never in a word" at starts int_at = digit & ~(zero & (next(x_letter) | next(b_letter))) & ~prev(dot & ~prev(dot))
assume "a `0x` starts a hex number at a start" at starts hex_at = zero & next(x_letter) & ~prev(dot & ~prev(dot))
assume "a `0b` starts a binary number at a start" at starts bin_at = zero & next(b_letter) & ~prev(dot & ~prev(dot))
assume "a `.` starts a real number before a digit, not after a word or a `.`" at starts dot_at = dot & next(digit) & ~prev(word) & ~prev(dot)
assume "an operator starts at its first byte: a start is never a pair's second" at starts p_start = punct & ~(prev(two_start) | prev(two_start_three, 2)) & ~(dot & next(digit) & ~prev(word) & ~prev(dot))
# A token's bytes after its start are code: the regions open only at a token's start.
assume "a name runs over its word's bytes" in simple_identifier name_more = word
assume "a number's bytes are code" in integer_literal code = ~empty
assume "a number's bytes are code" in real_literal code = ~empty
assume "a number's bytes are code" in hex_literal code = ~empty
assume "a number's bytes are code" in bin_literal code = ~empty
token simple_identifier = start word_start run name_more
token integer_literal = start int_at run nb
token real_literal = start dot_at run nb
token hex_literal = start hex_at run prev(hex_at) | hx
token bin_literal = start bin_at run prev(bin_at) | bx
# A raw string's content runs through a run of quotes (the lean lexer's scanner ends its token
# after the run it read, looking for `"""`), or to a template: each run is a part of its own, to
# the first of a run of quotes' last quote and its own last byte (`r_end`).
mask r_q        = rbody & dq & ~next(dq)
mask r_id       = fill(prev(id_dollar), prev(id_last))
mask r_stop     = ~rbody | r_q | id_dollar | lone | r_id
# The quotes of a closing run before its last three (three quotes after each, which only a
# closing run has in a body): the closer's, as the lean lexer's closer takes the run.
mask r_lead     = rbody & dq3 & next(dq, 3)
mask r_x        = rbody & ~id_dollar & ~lone & ~r_id & ~r_lead
mask r_start    = r_x & (~prev(r_x) | prev(r_q))
mask r_end      = r_x & ~next(r_x)
# A string: its opener, its parts, and its closer, a `"` or a template's `${`. After the
# template, the tail: its `}`, its parts, and the same closers.
# A string and a raw string: one reader at `"` (`read str | rstr`), each region's closer its
# own. A raw string's `"""` is its opener's byte and a part, `'""'`, for the two after it; its
# closer is three bytes, of the reader's kind.
token '"'       = start o_str | o_rstr read str | rstr parts {
                    '""' = prev(o_rstr) bytes 2
                    string_content = r_start last r_q | r_end
                    '""' = r_lead bytes 1
                    interpolation_identifier_start = id_dollar bytes 1
                    interpolated_identifier = prev(id_dollar) last id_last
                    string_content = lone bytes 1
                  } else string_content closes {
                    interpolation_expression_start = t_dollar bytes 2
                  }
token interpolation_expression_end = start o_tail | o_rtail read tail | rtail parts {
                    string_content = r_start last r_q | r_end
                    '""' = r_lead bytes 1
                    interpolation_identifier_start = id_dollar bytes 1
                    interpolated_identifier = prev(id_dollar) last id_last
                    string_content = lone bytes 1
                  } else string_content closes {
                    '"' = dq_close & prev(f_tail) bytes 1
                    '"' = rclose & prev(f_rtail) bytes 3
                    interpolation_expression_start = t_dollar bytes 2
                  }
# `\uXXXX`: tree-sitter keeps its `\u` as a token under the escape's node, its digits none.
token "'"       = start o_chr read chr parts {
                    "\\u" = c_uesc bytes 2
                    uni_digits = prev(c_uesc, 2) bytes 4
                    character_escape_seq = c_esc & ~next(u_letter) bytes 2
                  } else char_content
token backtick_name = start o_tick read tick
# An operator: one byte, a pair, or a pair and the byte after (`===`, `!==`, `..<`), as the
# lean lexer reads its first byte, then the next two.
pairs two_start = "->" "==" "!=" "<=" "&&" "||" "++" "--" "+=" "-=" "*=" "/=" "%=" "::" "?:" ".." "!!" "===" "!==" "..<"
mask second     = (prev(two_start) | prev(two_start_three, 2)) & code
mask p_start    = code & punct & ~second & ~nb
token punct     = start p_start pair two_start

# The hard keywords: no name. (`by` and `constructor` are soft, as in tree-sitter-kotlin.)
keywords simple_identifier {
  "as" "break" "class" "continue" "do" "else" "false" "for" "fun" "if" "in" "interface" "is"
  "null" "object" "return" "super" "this" "throw" "true" "try" "typealias" "val" "var" "when"
  "while"
} soft {
  "package" "import" "by" "constructor" "L" "u" "U" "uL" "UL" "vararg" "noinline" "crossinline"
  "expect" "data" "inner" "value" "actual" "set" "get" "override" "suspend" "annotation" "sealed" "lateinit" "tailrec" "operator" "infix" "inline" "external" "public" "private" "internal" "protected" "abstract" "final" "open" "const" "reified" "field" "property" "receiver" "param" "setparam" "delegate" "companion" "init" "dynamic" "where" "catch" "finally" "enum" "file" "out"
}
keywords interpolated_identifier { } soft { "expect" "data" "inner" "value" "actual" "set" "get" "override" "suspend" "annotation" "sealed" "lateinit" "tailrec" "operator" "infix" "inline" "external" "public" "private" "internal" "protected" "abstract" "final" "open" "const" "vararg" "noinline" "crossinline" "reified" "field" "property" "receiver" "param" "setparam" "delegate" "companion" "constructor" "init" "dynamic" "where" "catch" "finally" "enum" "out" }
keywords punct { "." "*" "/" "," ":" "(" ")" "{" "}" "[" "]" ";" "<" ">" "=" "+" "-" "!" "?" "%" "@" "->" "==" "!=" "<=" ">=" "&&" "||" "++" "--" "+=" "-=" "*=" "/=" "%=" "?." "?:" ".." "!!" "::" "===" "!==" "..<" } required

skip ws

# A line break that ends a statement, or the file's end: the scanner's semicolon (the lean lexer's
# `asi`), unless the next token goes on the line: one that starts with a byte of `goes_on`, `!=`,
# `as`, `where`, `catch`, `finally`, `by`, and `else` but a `when` entry's (`else ->`). Before a
# `}`, `semi_close`. In a class's header (the scanner's `constructor` context), `constructor` goes
# on too, and so does an annotation or a visibility modifier before it. The comments before it
# are the statement's (`settles`).
# After a class's name (or its type parameters), the scanner's `constructor` context: a line
# that starts with `constructor`, or with annotations or a visibility modifier before it, goes
# on, a primary constructor (the lean parser's one `asi` with `AsiCtx::ctor`). The class's rule
# takes this mark there, before `semi` (declared first). After it, `semi` ends no level at that
# token: the level has made the line break's one decision, as the lean parser's. A modifier has
# `constructor` on its line (`without semi`), as the lean lexer reads them; annotations may end
# theirs. A block comment that starts the line before them the scanner reads through, where the
# grammar does not say yet: refused where the class's rule takes the mark (`refuses taken`).
mark head_ctor  = lf & code, before "constructor", before "public" | "private" | "internal" | "protected" "constructor" without semi, before "@" (~("fun" | "val" | "var" | "class" | "interface" | "object" | "typealias" | "{" | "}" | ";" | ":" | "=" | "constructor" | "public" | "private" | "internal" | "protected"))* nest ("(" to ")") "constructor", before "@" (~("fun" | "val" | "var" | "class" | "interface" | "object" | "typealias" | "{" | "}" | ";" | ":" | "=" | "constructor"))* nest ("(" to ")") ending ("public" | "private" | "internal" | "protected") "constructor" without semi,
  refuses taken after ~";" multiline_comment with semi
# A line break before `by` where a property's delegate or a supertype's may come: the lean
# lexer's `asi` reads `by` on the next line there (`cx.by`), and ends the statement elsewhere.
mark by_lf      = lf & code, before "by"
# The line break an annotation reads past (`annotation`): `semi`'s, but no semicolon of
# tree-sitter's scanner (none is valid after an annotation) and no `asi` of the lean parser's:
# it settles nothing and asks no question, so a comment after the annotation is the next
# token's node's. Before `semi`, so a level that takes it takes it before it ends at `semi`;
# taken, it passes `semi`.
mark ann_lf     = lf & code unless after ";", unless before "}" | "," | "." | ".." | "..<" | ":" | "::" | "*" | "*=" | "%" | "%=" | ">" | "<" | "<=" | "=" | "==" | "===" | "{" | "[" | "(" | "?" | "?:" | "||" | "&&" | "/" | "/=" | "!=" | "!==" | "as" | "where" | "catch" | "finally" | "by", unless before "else" ~"->", unless before "else" end, passes semi
# A block comment first on the line after a line break where a semicolon may come (not after a
# `;`): the lean lexer's `asi` reads it through, then decides by the token after it, as `semi`'s
# questions do at that token (decision 0451), the comment's record holding `semi`'s bit of its
# own gap.
# - Before a word that starts with `a`, `e` or `w` (`abstract`, `external`, a `when` entry's
#   `else ->`), and that is not `as`, `where` or an `if`'s `else`, the scanner swallows the comment into the semicolon it inserts
#   after it (`Asi::Swallow`), and the tree loses it: the semicolon drops it (`drops`), and the
#   nodes it closes end at the word, where the semicolon of no width is. Wherever the parser's
#   state takes a semicolon: elsewhere (a call's arguments, after an operator) the comment is
#   any other. Right after a delegation specifier or a property with no initializer, a word
#   with `b` does the same (open, 0332).
# - Where what follows goes on (a byte of `goes_on`, `!=`, `as`, `where`, `by`, an `if`'s
#   `else`), the scanner
#   reads the comment as part of the line, and tree-sitter loses its bytes: a comment of no
#   width at the token after it (`asi`'s `lost`). Wherever tier 2 asks for `semi` (`loses`), as
#   the lean parser asks `asi` only where its state takes a semicolon.
# - Before another comment, the scanner reads the comment through, finds that the line goes on
#   (a `/`), and loses its bytes: a comment of no width at the next comment's start, in its
#   place (`loses since`: from the grammar token before), and the scanner asked again after
#   that one. After a line comment a line break comes, and the next line decides as the line
#   break after a token does: `semi`'s other questions, at the token. After a block comment a
#   token may come on its line, where the scanner inserts none: refused there.
# - Before `catch` or `finally`, the scanner inserts a semicolon of no width before the
#   comment, which the parser of a `try` never asks: the comment is the `try`'s, as any other.
mark semi       = lf & code unless after ";", unless before "}" | "," | "." | ".." | "..<" | ":" | "::" | "*" | "*=" | "%" | "%=" | ">" | "<" | "<=" | "=" | "==" | "===" | "{" | "[" | "(" | "?" | "?:" | "||" | "&&" | "/" | "/=" | "!=" | "!==" | "as" | "where" | "catch" | "finally", unless before "else" ~"->", unless before "else" end, end, settles, ends,
  drops after ~";" multiline_comment with semi before starting "aew",
  drops unless after multiline_comment before "as" | "where",
  drops unless after multiline_comment before "else" ~"->",
  loses after ~";" multiline_comment with semi before starting ",.:*%><={[(?|&/",
  loses after ~";" multiline_comment with semi before "!=" | "!==" | "as" | "where" | "by",
  loses after ~";" multiline_comment with semi before "else" ~"->",
  loses since ~";" multiline_comment with semi line_comment,
  refuses since ~";" multiline_comment with semi multiline_comment
mark semi_close = close_at, before "}", settles, ends
# The next line's first token after a type the lean parser may split (`as_lt`), but one no
# operand starts: only the split's rules take it (`as_split`), so wherever the grammar reads
# that type whole, or splits no type, the file is refused. After `semi`: a statement's end does
# not pass it.
mark as_open    = lf & code & prev(as_lt) & prev(gt), unless before "}" | ")" | "]" | "," | "." | "?:" | "&&" | "||" | "->" | ":" | "else" | "val" | "var"
# Something between two tokens: a blank or a comment. A token without it touches the token
# before, as the lean parser's `adjacent(0)` asks.
mark apart      = ws & code | o_line | o_block
# A function type's receiver's first name (`fn_recv`): where a type starts, the type rule's
# decision, as the lean parser's at the type's first token.
# A decimal number with a fraction, an exponent or an `f`: a real one.
mark real       = empty, at integer_literal when count(frac_dot | e_at | f_at) at least 1
# A backtick name before `::`: no rule takes it, so the file is refused where it holds. It
# refuses at every level, tested once a token by its bit: the code holds it (decision 0407).
mark bt_cref    = tokens backtick_name "::"
# A label's definition (`loop@`): a `@` touching a name. No rule takes it, so the file is
# refused where it holds, as the lean parser's `label_ahead` would read it.
mark label_at   = tokens simple_identifier "@" without apart, unless before simple_identifier "@" "for" | "while" | "do" | "{"
# A loop's label: the statement's own, before it (the lean parser's `statement_inner`); a trailing
# lambda's, where `{` follows it (the lean parser's `postfix`, `label_ahead` and `{`).
mark lab_loop   = tokens simple_identifier "@" without apart "for" | "while" | "do"
mark lab_lam    = tokens simple_identifier "@" without apart "{"
# Token marks, after the mask marks: they hold no bit of the code (decision 0407).
# `this@`, `return@`, `break@`, `continue@` and `as?`: a word and the `@` or `?` touching it,
# one leaf where the rule takes the mark (the lean parser's `adjacent(0)`).
mark this_at    = tokens "this" "@" without apart
mark jump_at    = tokens "return" | "break" | "continue" "@" without apart
# `as` or `as?` (`is`: `is_split`) where the lean parser splits the type after it (`as_split`): a dotted name,
# `<`, names and dots, `>` at the line's end, and the next line a call's `(` or `{` or an
# operand's first token (a keyword no expression starts with is the lean parser's trial read's
# failure: the type whole). A string or a character there is `as_open`'s but none of these (a
# mark's quoted name is a word, and those tokens have none): refused. Before `as_q`, which
# taking it would pass.
mark as_split   = tokens "as" simple_identifier "." (simple_identifier | "." | "<" | ">")* ending (">") "(" | "{" | simple_identifier | backtick_name | integer_literal | hex_literal | bin_literal | real_literal | "-" | "+" | "!" | "++" | "--" | "@" | "this" | "super" | "null" | "true" | "false" | "if" | "when" | "try" | "return" | "throw" | "break" | "continue" | "object" with as_open
mark is_split   = tokens "is" simple_identifier "." (simple_identifier | "." | "<" | ">")* ending (">") "(" | "{" | simple_identifier | backtick_name | integer_literal | hex_literal | bin_literal | real_literal | "-" | "+" | "!" | "++" | "--" | "@" | "this" | "super" | "null" | "true" | "false" | "if" | "when" | "try" | "return" | "throw" | "break" | "continue" | "object" with as_open
mark is_split   = tokens "!" "is" simple_identifier "." (simple_identifier | "." | "<" | ">")* ending (">") "(" | "{" | simple_identifier | backtick_name | integer_literal | hex_literal | bin_literal | real_literal | "-" | "+" | "!" | "++" | "--" | "@" | "this" | "super" | "null" | "true" | "false" | "if" | "when" | "try" | "return" | "throw" | "break" | "continue" | "object" with as_open
mark as_split   = tokens "as" "?" without apart simple_identifier "." (simple_identifier | "." | "<" | ">")* ending (">") "(" | "{" | simple_identifier | backtick_name | integer_literal | hex_literal | bin_literal | real_literal | "-" | "+" | "!" | "++" | "--" | "@" | "this" | "super" | "null" | "true" | "false" | "if" | "when" | "try" | "return" | "throw" | "break" | "continue" | "object" with as_open
mark as_q       = tokens "as" "?" without apart
# A safe call's `?.`: lexed as its `?` and its `.`, as the lean parser reads a `?.` after a type
# (`String?.f`, `x as T?.f`, `as?.`: `split_at`), and one leaf again where it is a safe call.
mark qdot       = tokens "?" "." without apart
# A comparison's `>=`: lexed as its `>` and its `=`, as the lean parser reads a `>=` that closes
# type arguments (`List<Int>= x`: `expect_gt`), and one leaf again where it is a comparison.
mark ge         = tokens ">" "=" without apart
# A name touching an integer: its suffix, where the integer's rule takes one (`L`, `u`, `U`,
# `uL`, `UL`), else refused there, as the lean parser's `integer` reads the token after.
mark sfx        = tokens integer_literal | hex_literal | bin_literal simple_identifier without apart
# A `{` after `)`, `else`, `do`, `try` or `finally`: where a control structure's body goes, a
# block, not a lambda; after a call's arguments, the call's own lambda (the lean parser's
# `call`), not another call's. Before the lambda's marks, which hold at the same token.
mark blk        = tokens after ")" | "else" | "do" | "try" | "finally" | "->" "{"
# A lambda with no parameters before its `->`.
mark lam_bare   = tokens "{" "->"
# A lambda's parameters, before its `->` (the lean parser's `lambda_params_end`): from the `{`,
# the tokens parameters are made of, then a `->` where the brackets are closed. `(`, `[` and `<`
# go one deeper and their closers one out, on one depth, as the lean parser counts them; a closer
# at depth 0 ends the run. A `{` inside them is another lambda's: it ends the run, so an inner
# lambda's `->` does not mark the outer `{`. It holds at `{ ->` too, as the lean parser's does;
# `lam_bare`, a mark before it, is tested first and takes that.
mark lam_params = tokens "{" (simple_identifier | backtick_name | "in" | "," | ":" | "." | "?" | "*" | "@" | "(" | ")" | "[" | "]" | "<" | ">" | "->")* nest ("(" | "[" | "<" to ")" | "]" | ">") "->"
# The token marks that tier 2 tests alone, after the marks the code holds (decision 0407): no
# bit of the code, no mask; each its tokens, read at the token as the lean parser peeks.
# A modifier word where a declaration follows it, not a name.
# An `@` that starts an annotated expression, as the lean parser's `declaration_ahead` finds no
# declaration (Q342): from it, past annotations (their arguments counted, never a declaration's
# hard keyword, a `{`, a `}`, a `;` or a use-site target's `:`), where the run's last token ends an annotation (a name, a
# `)` or a `>`), a token that goes on no annotation and is no modifier and no declaration's word.
# Where it does not hold, the `@` starts a declaration's modifiers. (`get` and `set` are an
# accessor's only after a property, where this mark is not asked.)
mark ann_expr   = tokens "@" (~("fun" | "val" | "var" | "class" | "interface" | "object" | "typealias" | "{" | "}" | ";" | ":"))* nest ("(" to ")") ending (simple_identifier | backtick_name | ")" | ">") ~("@" | "." | ":" | "(" | "<" | "::" | "public" | "private" | "internal" | "protected" | "abstract" | "final" | "open" | "override" | "lateinit" | "const" | "sealed" | "annotation" | "data" | "inner" | "value" | "tailrec" | "operator" | "infix" | "inline" | "external" | "suspend" | "vararg" | "noinline" | "crossinline" | "expect" | "actual" | "fun" | "val" | "var" | "class" | "interface" | "object" | "typealias" | "companion" | "constructor" | "init" | "enum")
mark decl_mod   = tokens after ~("." | "::") "public" | "private" | "internal" | "protected" | "abstract" | "final" | "open" | "override" | "lateinit" | "const" | "sealed" | "annotation" | "data" | "inner" | "value" | "tailrec" | "operator" | "infix" | "inline" | "external" | "suspend" | "vararg" | "noinline" | "crossinline" | "expect" | "actual" "public" | "private" | "internal" | "protected" | "abstract" | "final" | "open" | "override" | "lateinit" | "const" | "sealed" | "annotation" | "data" | "inner" | "value" | "tailrec" | "operator" | "infix" | "inline" | "external" | "suspend" | "vararg" | "noinline" | "crossinline" | "expect" | "actual" | "fun" | "val" | "var" | "class" | "interface" | "object" | "get" | "set" | "companion" | "constructor" | "enum" | "typealias" | "@"
# An annotation's use-site target (`@get:`), and a file annotation's `@` (`@file:`).
mark use_site   = tokens after "@" "field" | "property" | "get" | "set" | "receiver" | "param" | "setparam" | "delegate" ":"
mark file_at    = tokens "@" "file" ":"
# A list's trailing comma, before its closer.
mark trail      = tokens "," ")" | ">" | "]" | "}" | "->"
# An import's `.` before its `*`, where the name's loop of `.`s stops.
mark wild       = tokens "." "*"
# An object literal's `object`, before its `:` or `{`, not a companion's: an expression, where a
# statement's `object` declares one.
mark obj_lit    = tokens after ~"companion" "object" ":" | "{"
# A function type's receiver's `.`: a `(` after it (no expression has `.(`).
mark ft_dot_at  = tokens "." "("
# A `<` that opens type arguments in an expression (the lean parser's `type_args_end`): the tokens
# from it are a type's (names, `, . ? * @ : -> ( ) [ ] < >`) up to a `>` that `(`, `{`, `.`, `?.`
# or `::` follows. It touches the word before it (`without apart`), as a comparison's `<`
# seldom does (the lean parser does not ask: a spaced `f <T>()` is refused, read as a comparison). In a type it opens
# type arguments or parameters anyway, which take it. Where no rule takes it, the file is refused.
# The run counts `<` `>` and `(` `)` as the lean parser does: the `>` is the one whose depth closes
# the `<`, and a `)` with no `(` ends the run.
mark generic    = tokens after simple_identifier "<" without apart (simple_identifier | backtick_name | "in" | "," | "." | "?" | "*" | "@" | ":" | "->" | "(" | ")" | "[" | "]" | "<" | ">")* nest ("<" to ">") ("(" to ")") ">" "(" | "{" | "." | "::"
# A function type's `(`: its `)` (the lean parser's `paren_end`) before `->`, as the lean
# parser's `ty_core` reads it; another `(` in a type is a parenthesized type's.
mark fn_paren   = tokens "(" (simple_identifier | backtick_name | "in" | "," | "." | "?" | "*" | "@" | ":" | "->" | "(" | ")" | "[" | "]" | "<" | ">")* nest ("(" to ")") ("<" to ">") ")" "->"
# `suspend` before a type (a name, `(` or `@`): a type modifier, as the lean parser's
# `type_modifiers_ahead` reads it.
mark ty_susp    = tokens "suspend" simple_identifier | backtick_name | "(" | "@"
# A delegation specifier's `suspend`, before a function type (the lean parser's
# `delegation_specifiers`): the specifier's own leaf.
mark ds_susp    = tokens "suspend" simple_identifier | backtick_name | "("
# A function parameter's modifier: `vararg`, `noinline` or `crossinline` a name or `@` follows
# (the lean parser's `parameter_modifiers_ahead(true)`); else the word is the parameter's name.
# An `import` on the line of the header before it: the lean lexer's `asi` ends the header there
# with a semicolon of no width.
mark imp_same   = tokens "import" without semi
mark pm         = tokens "vararg" | "noinline" | "crossinline" simple_identifier | backtick_name | "@"
# A type parameter's `reified` a name, `@`, `in` or `out` follows (the lean parser's
# `type_parameter_modifiers_ahead`); else the word is the parameter's name.
mark tpm        = tokens "reified" simple_identifier | backtick_name | "@" | "in" | "out"
# A class parameter's modifier: any modifier a name, `@` or another word follows (the lean
# parser's `parameter_modifiers_ahead(false)`).
mark cp_mod     = tokens "public" | "private" | "internal" | "protected" | "abstract" | "final" | "open" | "override" | "lateinit" | "const" | "sealed" | "annotation" | "data" | "inner" | "value" | "tailrec" | "operator" | "infix" | "inline" | "external" | "suspend" | "vararg" | "noinline" | "crossinline" | "expect" | "actual" simple_identifier | backtick_name | "@" | "val" | "var" | "public" | "private" | "internal" | "protected" | "abstract" | "final" | "open" | "override" | "lateinit" | "const" | "sealed" | "annotation" | "data" | "inner" | "value" | "tailrec" | "operator" | "infix" | "inline" | "external" | "suspend" | "vararg" | "noinline" | "crossinline" | "expect" | "actual"
# A name before `::`, but `this` (a hard keyword, as every one): a callable reference's receiver.
mark cref       = tokens simple_identifier "::"
# A name and `=` (or an assignment's operator): an assignment to it, or a named argument; and a
# name and `:`, a function type's named parameter (`(url: String) -> Unit`).
mark named      = tokens simple_identifier "=" | "+=" | "-=" | "*=" | "/=" | "%=" | ":"
# A `!` after a line break before `in` or `is`: a `when` entry's negated test.
mark named      = tokens "!" with semi "in" | "is"
# An enum class's `enum`, a soft word elsewhere.
mark enum_class = tokens "enum" "class"
# `fun interface`: a class's, as the lean parser's `declaration_ahead` reads `fun` before
# `interface`.
mark fun_iface  = tokens "fun" "interface"
# A function type's receiver's first name: names, dots and type arguments from it to a `.`
# before a `(`; not `suspend`, and not after a `.`, `<` or `>`.
mark fn_recv    = tokens after ~("." | "<" | ">") simple_identifier (simple_identifier | "." | "<" | ">")* "." "(", unless before "suspend"
# A property's accessor: its `get` or `set` after a line break, or on the line of a visibility
# word after one, as the lean parser's `declaration_ahead` asks `accessor_ahead` at the token: where
# no `.` or `:` follows it, for `get` no `(` with arguments, and no token on its line but `(`,
# `;` or `}` (`get + 1` is an expression).
mark acc        = tokens "get" | "set" with semi, unless before "get" | "set" "." | ":", unless before "get" | "set" simple_identifier | backtick_name | integer_literal | hex_literal | bin_literal | real_literal | "." | "*" | "/" | "," | ":" | ")" | "{" | "[" | "]" | "<" | ">" | "=" | "+" | "-" | "!" | "?" | "%" | "@" | "->" | "==" | "!=" | "<=" | "&&" | "||" | "++" | "--" | "+=" | "-=" | "*=" | "/=" | "%=" | "?:" | ".." | "!!" | "::" | "===" | "!==" | "..<" without semi, unless before "get" "(" ~")"
mark acc        = tokens after "private" | "protected" | "internal" | "public" with semi "get" | "set" without semi, unless before "get" | "set" "." | ":", unless before "get" | "set" simple_identifier | backtick_name | integer_literal | hex_literal | bin_literal | real_literal | "." | "*" | "/" | "," | ":" | ")" | "{" | "[" | "]" | "<" | ">" | "=" | "+" | "-" | "!" | "?" | "%" | "@" | "->" | "==" | "!=" | "<=" | "&&" | "||" | "++" | "--" | "+=" | "-=" | "*=" | "/=" | "%=" | "?:" | ".." | "!!" | "::" | "===" | "!==" | "..<" without semi, unless before "get" "(" ~")"
# A declaration's receiver, as the lean parser's `receiver_end` reads it from the token after
# `fun`, `val` or `var` and the type parameters: a run of the type's tokens to a `.` and a name
# that no `.`, type argument or `,` follows; but a delegated property's name (`val x by a.b`).
# The rule asks it where the receiver may come. A nullable receiver (`String?.f`) is its `?`
# and its `.` (`qdot`).
mark recv       = tokens simple_identifier | backtick_name (simple_identifier | backtick_name | "in" | "." | "<" | ">" | "," | "?" | "*")* "." simple_identifier | backtick_name ~("." | "<" | ">" | ","), unless before simple_identifier | backtick_name "by"
# A receiver's `.` that is not its last: another `.`, a type argument or a `,` follows its name.
# The receiver's loop of names goes on there.
mark dotted     = tokens "." simple_identifier | backtick_name "." | "<" | ">" | ","

tree kotlin {
  node source_file whole padded = (file_at file_annotation semi)* [package_header] [import_list] (statement (semi | ';'))*
  # A name: a word, or a soft keyword, which tree-sitter keeps as a leaf under the name's node.
  # `file` is a keyword for `@file:` alone: as a name, the lean parser's plain one (no word leaf).
  choice name           = simple_identifier | backtick_name as simple_identifier | soft_name | 'file' as simple_identifier | 'out' as simple_identifier | 'by' as simple_identifier
  node soft_name        = retag simple_identifier soft_word
  choice type_name      = simple_identifier as type_identifier | backtick_name as type_identifier | soft_type_name | 'file' as type_identifier
  node soft_type_name   = retag type_identifier soft_word
  choice soft_word      = 'constructor' | 'expect' | 'data' | 'inner' | 'value' | 'actual' | 'set' | 'get' | 'override' | 'suspend' | 'annotation' | 'sealed' | 'lateinit' | 'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'public' | 'private' | 'internal' | 'protected' | 'abstract' | 'final' | 'open' | 'const' | 'vararg' | 'noinline' | 'crossinline' | 'reified' | 'field' | 'property' | 'receiver' | 'param' | 'setparam' | 'delegate' | 'companion' | 'init' | 'dynamic' | 'where' | 'catch' | 'finally' | 'enum'
  node package_header   = 'package' identifier (semi | ';' | imp_same)
  node identifier       = name ('.' name)*
  node import_list      = import_header+
  node import_header    = 'import' import_identifier [wild '.' '*' as wildcard_import | import_alias] (semi | ';' | imp_same)
  node import_identifier = retag identifier name ('.' name)*
  node import_alias     = 'as' type_name

  # --- Statements --------------------------------------------------------------------------------

  choice statement nested = declaration | lab_loop label (for_statement | while_statement | do_while_statement) | for_statement | while_statement | do_while_statement | assignment | expression [assign_tail]
  # Statements in a block: a line break between them, and before the `}` if it likes.
  node statements nested = statement (semi statement | ';' [statement])* [semi_close]
  choice block          = '{' [statements] '}'
  node control_structure_body = blk block | statement
  node for_statement    = 'for' '(' (variable_declaration | multi_variable_declaration) 'in' expression ')' [control_structure_body]
  node while_statement  = 'while' '(' expression ')' control_structure_body
  node do_while_statement = 'do' control_structure_body 'while' '(' expression ')'
  # `x = …`: the name the assignment's target.
  node assignment       = named directly_assignable_expression assignment_operator expression
  node directly_assignable_expression = name
  choice assignment_operator = '=' | '+=' | '-=' | '*=' | '/=' | '%='
  # `a.b = …`, `a[i] += …`: the navigations and indexings read so far, the target's, flat.
  choice assign_tail    = wrap assignment _ reread assignable assignment_operator expression
  reading assignable    = root as directly_assignable_expression, navigation_expression gone, indexing_expression gone, postfix_expression gone,
                          keep simple_identifier soft_name navigation_suffix indexing_suffix call_expression parenthesized_expression this_expression '!!' '++' '--'

  # --- Declarations ------------------------------------------------------------------------------

  # A declaration's node is opened at its first token: its modifiers' or its keyword's.
  node declaration nested = [modifiers] declaration_rest
  choice declaration_rest = retag class_declaration class_rest | retag function_declaration function_rest
                          | retag property_declaration property_rest | retag object_declaration object_rest
                          | retag type_alias alias_rest
                          # An accessor wherever a declaration may come, as the lean parser's
                          # `declaration_ahead` reads it: in a class body, and alone at a
                          # statement's level (a property's on the line after).
                          | acc accessor
  choice alias_rest     = 'typealias' type_name [type_parameters] '=' type
  choice function_rest  = 'fun' [type_parameters] [receiver] name function_value_parameters [':' type] [type_constraints] [function_body]
  choice property_rest  = binding_pattern_kind [type_parameters] [receiver] (variable_declaration | multi_variable_declaration) [type_constraints] ['=' expression | [by_lf] property_delegate | getter_inline]
  node property_delegate = 'by' expression
  choice class_rest     = ('class' | 'interface') type_name [type_parameters] [head_ctor] [primary_constructor] [':' delegation_specifier (',' delegation_specifier)*] [type_constraints] [class_body]
                        | fun_iface 'fun' 'interface' type_name [type_parameters] [head_ctor] [primary_constructor] [':' delegation_specifier (',' delegation_specifier)*] [class_body]
                        | enum_class 'enum' 'class' type_name [type_parameters] [head_ctor] [primary_constructor] [':' delegation_specifier (',' delegation_specifier)*] [enum_class_body]
  # An enum's entries, `,` between them, a line break where one may come; then after a `;`, the
  # members.
  node enum_class_body  = '{' [enum_entry (',' [semi] enum_entry)*] (trail_brace | [semi_close] [';' [semi] [class_member ((semi | ';') class_member)* [semi_close]]] '}')
  node enum_entry       = name [value_arguments] [class_body]
  choice object_rest    = 'object' type_name [':' delegation_specifier (',' delegation_specifier)*] [class_body]
  node binding_pattern_kind = 'val' | 'var'
  node variable_declaration = name [':' type]
  # `(` is a leaf of the lean tape, `)` none.
  node multi_variable_declaration = '(' variable_declaration (',' variable_declaration)* ')'
  node function_value_parameters = '(' [function_value_parameter (',' function_value_parameter)*] (trail_paren | ')')
  choice function_value_parameter = [parameter_modifiers] parameter ['=' expression]
  node parameter        = name ':' type
  node parameter_modifiers = (annotation | pm parameter_modifier)+
  node function_body    = block | '=' expression
  node primary_constructor = [[modifiers] 'constructor'] '(' [class_parameter (',' class_parameter)*] (trail_paren | ')')
  node class_parameter  = [class_parameter_modifiers] [binding_pattern_kind] name ':' type ['=' expression]
  # A delegate's expression takes no trailing lambda (`no_lambda`, the lean parser's): `class A : I by
  # d {` ends it before the body's `{`. An object literal's specifiers are read so too. The flag
  # is clear again inside parentheses, as the lean parser's `level` clears it.
  flag no_lambda
  # As the lean parser's `delegation_specifiers`: `suspend` and a type, a function type or a
  # parenthesized one, a function type with a receiver, or a user type and its constructor's
  # arguments; then a delegate.
  node delegation_specifier = ds_head [wrap explicit_delegation _ [by_lf] 'by' with no_lambda expression]
  choice ds_head        = ds_susp 'suspend' type | fn_paren function_type | parenthesized_type [wrap nullable_type _ ('?' as quest)+]
                        | fn_recv recv_function_type | user_type [wrap constructor_invocation _ value_arguments]
  node class_body       = '{' [class_member (semi class_member | ';' [class_member])* semi_close] '}'
  node class_member nested = [modifiers] member_rest
  choice member_rest    = declaration_rest | retag companion_object companion_rest | retag anonymous_initializer init_rest
                        | retag secondary_constructor ctor_rest
  choice accessor       = retag getter getter_rest | retag setter setter_rest
  node getter_inline nested = getter_retag
  choice getter_retag   = retag getter getter_rest
  choice getter_rest    = 'get' ['(' ')' [':' type] function_body]
  choice setter_rest    = 'set' ['(' parameter_with_optional_type ')' [':' type] function_body]
  node parameter_with_optional_type = name [':' type]
  choice companion_rest = 'companion' 'object' [type_name] [':' delegation_specifier (',' delegation_specifier)*] [class_body]
  choice init_rest      = 'init' block
  choice ctor_rest      = 'constructor' function_value_parameters [':' constructor_delegation_call] [blk '{' [statements] '}']
  node constructor_delegation_call = ('this' | 'super') value_arguments
  node type_parameters  = [generic] '<' type_parameter (',' type_parameter)* (trail_angle | '>')
  node type_parameter   = [type_parameter_modifiers] type_name [':' type]
  # `where T : A, U : B`, as the lean parser's `type_constraints`.
  node type_constraints = 'where' type_constraint (',' type_constraint)*
  node type_constraint  = (annotation)* type_name ':' type
  node type_parameter_modifiers = (tpm reification_modifier | variance_modifier)+
  node reification_modifier = 'reified'

  # Modifiers: an annotation, or a word a declaration follows (`decl_mod`).
  node modifiers        = (annotation | decl_mod modifier)+
  node class_parameter_modifiers = retag modifiers (annotation | cp_mod modifier)+
  choice modifier       = class_modifier | member_modifier | visibility_modifier | function_modifier | property_modifier | inheritance_modifier | parameter_modifier | platform_modifier
  node class_modifier   = 'sealed' | 'annotation' | 'data' | 'inner' | 'value'
  node member_modifier  = 'override' | 'lateinit'
  node visibility_modifier = 'public' | 'private' | 'internal' | 'protected'
  node function_modifier = 'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'suspend'
  node property_modifier = 'const'
  node inheritance_modifier = 'abstract' | 'final' | 'open'
  node parameter_modifier = 'vararg' | 'noinline' | 'crossinline'
  node platform_modifier = 'expect' | 'actual'
  # `@A`, `@A.B`, `@A(x)`: its arguments after the type, always.
  # A line break after an annotation is no semicolon (`ann_lf`): the lean parser reads on to
  # what it annotates.
  node annotation nested = '@' [use_site use_site_target] user_type [wrap constructor_invocation _ value_arguments] [ann_lf]
  node use_site_target  = ('field' | 'property' | 'get' | 'set' | 'receiver' | 'param' | 'setparam' | 'delegate') ':'
  node file_annotation  = '@' 'file' ':' user_type [wrap constructor_invocation _ value_arguments]

  # --- Types -------------------------------------------------------------------------------------

  # A type, as the lean parser's `ty`: its modifiers (annotations, `suspend`), then a function
  # type, a parenthesized one, a function type with a receiver, or a user type, the last two
  # nullable.
  choice type nested    = [type_modifiers] type_core
  choice type_core      = fn_paren function_type | parenthesized_type [wrap nullable_type _ ('?' as quest)+]
                        | fn_recv recv_function_type | user_type [wrap nullable_type _ ('?' as quest)+]
  node recv_function_type = retag function_type receiver: fn_receiver ft_dot_at '.' function_type_parameters '->' type
  node fn_receiver      = retag receiver_type fn_receiver_type
  # Its first name is no soft word, which `suspend` would be (a soft word's receiver is refused).
  node fn_receiver_type = retag user_type fn_name [type_arguments] ('.' type_name [type_arguments])*
  choice fn_name        = simple_identifier as type_identifier | backtick_name as type_identifier
  node type_modifiers   = (annotation | ty_susp 'suspend')+
  node parenthesized_type = '(' type ')'
  choice receiver       = recv receiver: receiver_type '.'
  node receiver_type    = recv_type [wrap nullable_type _ ('?' as quest)+]
  node recv_type        = retag user_type type_name [type_arguments] (dotted '.' type_name [type_arguments])*
  node user_type        = type_name [type_arguments] ('.' type_name [type_arguments])*
  node type_arguments   = [generic] '<' type_projection (',' type_projection)* (trail_angle | '>')
  node type_projection  = [type_projection_modifiers] type | '*'
  node type_projection_modifiers = variance_modifier+
  node variance_modifier = 'in' | 'out'
  node function_type    = function_type_parameters '->' type
  node function_type_parameters = '(' [ft_parameter (',' ft_parameter)*] (trail_paren | ')')
  choice ft_parameter   = named parameter | type

  # --- Expressions -------------------------------------------------------------------------------

  # By tree-sitter-kotlin's precedences, each operation around the left side so far: one loop, as
  # the lean parser's `expr_in` (decision 0492). An operator's right operand takes every operator
  # that binds tighter, so the loop never meets one after a looser one.
  choice expression nested = unary_tight (gen_op | as_op | mul_op | add_op | range_op | infix_op | elvis_op | check_op | cmp_op | eq_op | conj_op | disj_op)*
  # A generic call's type arguments after a tighter operator's operand: over the whole operation
  # read so far (`a to f<T>()` is `call(infix(a, f), <T>())`, tree-sitter's GLR reading), then
  # the postfix operations over it. Asked where a comparison may come, as the lean parser's
  # `expr_in` asks it at `min <= COMPARISON`.
  choice gen_op         = generic (wrap call_expression _ generic_suffix) (postfix_op | unless no_lambda lambda_call)*
  choice mul_op         = wrap multiplicative_expression _ ('*' | '/' | '%') as_operand
  # The type after `as`: a user type. Split (`as_split`):
  # its first name, then the navigations over the `as` expression; the loop reads the rest (a
  # generic call, or the comparisons), as the lean parser's `split_type`.
  choice as_op          = as_split as_head (wrap navigation_expression _ navigation_suffix)+
                        | wrap as_expression _ (as_q 'as' merge 'as?' '?' | 'as') as_type
  choice as_head        = wrap as_expression _ (as_q 'as' merge 'as?' '?' | 'as') as_name
  node as_name          = retag user_type type_name
  choice as_type        = [type_modifiers] as_core
  choice as_core        = fn_paren function_type | parenthesized_type [wrap nullable_type _ ('?' as quest)+]
                        | fn_recv recv_function_type | as_user_type [wrap nullable_type _ ('?' as quest)+]
  node as_user_type     = retag user_type type_name [type_arguments] ('.' type_name [type_arguments])*
  choice as_operand nested = unary_tight (as_op)*
  choice add_op         = wrap additive_expression _ ('+' | '-') add_operand
  choice range_op       = wrap range_expression _ ('..' | '..<') range_operand
  choice infix_op       = wrap infix_expression _ name infix_operand
  choice elvis_op       = wrap elvis_expression _ '?:' elvis_operand
  choice check_op       = is_split is_head (wrap navigation_expression _ navigation_suffix)+
                        | wrap check_expression _ ['!'] ('in' check_operand | 'is' type)
  choice is_head        = wrap check_expression _ ['!'] 'is' as_name
  choice cmp_op         = wrap comparison_expression _ ('<' | ge '>' merge '>=' '=' | '>' [as_open] | '<=') cmp_operand
  choice eq_op          = wrap equality_expression _ ('==' | '!=' | '===' | '!==') eq_operand
  choice conj_op        = wrap conjunction_expression _ '&&' conj_operand
  choice disj_op        = wrap disjunction_expression _ '||' disj_operand
  # Each operator's right side: the operations that bind tighter, in one loop.
  choice add_operand nested = unary_tight (as_op | mul_op)*
  choice range_operand nested = unary_tight (as_op | mul_op | add_op)*
  choice infix_operand nested = unary_tight (as_op | mul_op | add_op | range_op)*
  choice elvis_operand nested = unary_tight (as_op | mul_op | add_op | range_op | infix_op)*
  choice check_operand nested = unary_tight (as_op | mul_op | add_op | range_op | infix_op | elvis_op)*
  choice cmp_operand nested = unary_tight (gen_op | as_op | mul_op | add_op | range_op | infix_op | elvis_op | check_op)*
  choice eq_operand nested = unary_tight (gen_op | as_op | mul_op | add_op | range_op | infix_op | elvis_op | check_op | cmp_op)*
  choice conj_operand nested = unary_tight (gen_op | as_op | mul_op | add_op | range_op | infix_op | elvis_op | check_op | cmp_op | eq_op)*
  choice disj_operand nested = unary_tight (gen_op | as_op | mul_op | add_op | range_op | infix_op | elvis_op | check_op | cmp_op | eq_op | conj_op)*

  # An operand: a prefix operation, or a primary and its postfix operations, as the lean parser's
  # `unary` and `postfix`. No generic call: the operator loop reads it (`gen_op`).
  choice unary_tight nested = prefix_expression | primary_tight (postfix_op | unless no_lambda lambda_call)*
  # A prefix operator's operand: the postfix operations, no generic call (the lean parser's
  # `expr(PREFIX)`): the loop reads one over the prefix (`-h<T>()` is `call(prefix(-, h), <T>())`).
  node prefix_expression = ('!' | '-' | '+' | '++' | '--') unary_tight | ann_expr annotation expression | label_at label expression | lab_lam label expression
  choice postfix_op     = wrap call_expression _ call_suffix
                        | wrap navigation_expression _ navigation_suffix
                        | wrap indexing_expression _ indexing_suffix
                        | wrap postfix_expression _ ('++' | '--' | '!!')
  node call_suffix      = value_arguments [unless no_lambda (blk annotated_lambda)]
  # A call by a trailing lambda alone (`f { }`): asked in the postfix loops, where the lean parser
  # asks `T::LBrace if !self.no_lambda`.
  choice lambda_call    = wrap call_expression _ lambda_suffix
  node lambda_suffix    = retag call_suffix annotated_lambda
  node annotated_lambda = [lab_lam label] lambda_literal
  # A label: its name and `@`, one leaf (the lean parser's `label`).
  choice label          = simple_identifier merge label '@'
  node lambda_literal   = lam_bare lambda_bare_open [statements] '}'
                        | lam_params '{' lambda_parameters '->' [statements] '}'
                        | '{' [statements] '}'
  # `{ ->`: not the tokens the grammar implies, so both are leaves.
  choice lambda_bare_open = '{' '->'
  node lambda_parameters = lambda_parameter (',' lambda_parameter)* [lam_trail]
  choice lambda_parameter = variable_declaration | multi_variable_declaration [':' type]
  node navigation_suffix = ('.' | qdot '?' merge '?.' '.' | '::') ('class' | name)
  node indexing_suffix  = '[' expression (',' expression)* (trail_bracket | ']')
  node value_arguments  = '(' [without no_lambda value_argument (',' without no_lambda value_argument)*] (trail_paren | ')')
  node value_argument   = named name '=' expression | spread_expression | expression
  node spread_expression = '*' expression

  choice primary_tight nested = name | obj_lit object_literal
                        | number_literal | string_literal | character_literal | boolean_literal | 'null' as null_literal | this_expression
                        | parenthesized_expression | jump_expression | if_expression | when_expression | try_expression | callable_reference
                        | lambda_literal | super_expression | collection_literal
  node collection_literal = '[' expression (',' expression)* (trail_bracket | ']')
  node callable_reference = [cref type_name] '::' ('class' | name)
  node generic_suffix   = retag call_suffix type_arguments [as_open] (value_arguments [unless no_lambda (blk annotated_lambda)] | unless no_lambda annotated_lambda)
  node boolean_literal  = 'true' | 'false'
  node character_literal = "'" [character_escape_seq | uni_escape | char_content] "'"
  node uni_escape       = retag character_escape_seq "\\u" uni_digits
  # An integer and its suffix: the suffix's node wraps the integer, and keeps no leaf of it.
  choice number_literal nested = real integer_literal as real_literal | sfx (integer_literal | hex_literal | bin_literal) (wrap long_literal _ 'L' | wrap unsigned_literal _ ('u' | 'U' | 'uL' | 'UL'))
                        | integer_literal | hex_literal | bin_literal | real_literal
  choice interp_id      = interpolated_identifier | soft_interp
  node soft_interp      = retag interpolated_identifier interp_soft
  choice interp_soft    = 'expect' | 'data' | 'inner' | 'value' | 'actual' | 'set' | 'get' | 'override' | 'suspend' | 'annotation' | 'sealed' | 'lateinit' | 'tailrec' | 'operator' | 'infix' | 'inline' | 'external' | 'public' | 'private' | 'internal' | 'protected' | 'abstract' | 'final' | 'open' | 'const' | 'vararg' | 'noinline' | 'crossinline' | 'reified' | 'field' | 'property' | 'receiver' | 'param' | 'setparam' | 'delegate' | 'companion' | 'constructor' | 'init' | 'dynamic' | 'where' | 'catch' | 'finally' | 'enum' | 'out'
  # A raw string's `""` after its first quote, and its closing run's quotes before its last
  # three: implied, no leaves.
  node string_literal   = '"' (string_content | '""' | interpolation_identifier_start interp_id
                          | interpolation_expression_start interpolated_expression interpolation_expression_end)* '"'
  node interpolated_expression = expression
  node this_expression  = this_label | 'this'
  choice this_label     = this_at 'this' '@' type_name
  node object_literal   = 'object' [':' with no_lambda delegation_specifier (',' with no_lambda delegation_specifier)*] [class_body]
  node super_expression = 'super'
  node parenthesized_expression = '(' without no_lambda expression ')'
  node jump_expression  = jump_at ('return' merge 'return@' '@' simple_identifier as label [expression]
                                  | 'break' merge 'break@' '@' simple_identifier as label
                                  | 'continue' merge 'continue@' '@' simple_identifier as label)
                        | 'return' [expression] | 'throw' expression | 'break' | 'continue' 
  # A `try`: its block's statements, its catches, its `finally`.
  node try_expression   = 'try' blk '{' [statements] '}' (catch_block)* [finally_block]
  node catch_block      = 'catch' '(' name ':' type ')' blk '{' [statements] '}'
  node finally_block    = 'finally' blk '{' [statements] '}'
  # A `when`: its subject, then its entries, each ended by a line break, a `;` or nothing (the
  # lean parser's `semi`, tree-sitter's `optional(_semi)`: `{ else -> 1 }`).
  # An entry holds the line break that ends it (tree-sitter's `when_entry` takes its `_semi`), so
  # a comment before the break is the entry's.
  node when_expression  = 'when' [when_subject blk] '{' (when_entry)* '}'
  node when_subject     = '(' ['val' variable_declaration '='] expression ')'
  node when_entry       = (when_condition (',' when_condition)* [when_trail] | 'else') '->' control_structure_body [semi | semi_close | ';']
  node when_condition   = named neg_test | range_test | type_test | expression
  # One node from the `!`: a `range_test`, retagged a `type_test` at an `is`.
  node neg_test         = retag range_test '!' ('in' expression | neg_is)
  choice neg_is         = retag type_test 'is' type
  node range_test       = 'in' expression
  node type_test        = 'is' type
  node if_expression    = 'if' '(' condition: expression ')' consequence: control_structure_body ['else' alternative: control_structure_body]
  # An annotated `if` or `when`'s annotation. Its arguments are not optional: a `(` after the
  # name could begin the operand too.

  # A trailing comma: the lean parser leaves a list's tokens out only where they are the ones the
  # grammar implies, so after one the `,` and the closer are leaves.
  choice trail_paren    = trail ',' ')'
  # A `when` entry's: its own choice, so that `when_entry`'s implied `,` is not this one.
  choice when_trail     = trail ','
  # A lambda's parameters': its own choice, so that `lambda_parameters`' implied `,` is not this
  # one (the lean parser keeps the trailing comma's leaf).
  choice lam_trail      = trail ','
  choice trail_angle    = trail ',' '>'
  choice trail_bracket  = trail ',' ']'
  choice trail_brace    = trail ',' [semi_close] '}'

  # --- The tokens the grammar implies: no leaf ---------------------------------------------------

  implied package_header 'package' ';'
  implied import_header 'import' '.' ';'
  implied import_identifier '.'
  implied import_alias 'as'
  implied block '{' '}'
  implied lambda_literal '{' '}'
  implied lambda_parameters ','
  implied for_statement 'for' '(' ')' 'in'
  implied while_statement 'while' '(' ')'
  implied do_while_statement 'do' 'while' '(' ')'
  implied function_rest 'fun'
  implied property_rest '='
  implied class_rest ':' ','
  implied enum_class_body '{' '}' ',' ';'
  implied spread_expression '*'
  implied object_rest 'object' ':' ','
  implied object_literal ','
  implied ctor_rest 'constructor' ':' '{' '}'
  implied multi_variable_declaration ',' ')'
  implied function_body '='
  implied function_value_parameters '(' ')' ','
  implied function_value_parameter '='
  implied parameter ':'
  implied type_constraints 'where' ','
  implied type_constraint ':'
  implied primary_constructor 'constructor' '(' ')' ','
  implied class_parameter ':' '='
  implied class_body '{' '}' ';'
  implied source_file ';'
  implied statements ';'
  implied getter_rest '(' ')'
  implied setter_rest 'set' '(' ')'
  implied companion_rest 'companion' 'object' ':' ','
  implied init_rest 'init'
  implied type_parameters '<' '>' ','
  implied user_type '.'
  implied fn_receiver_type '.'
  implied recv_type '.'
  implied as_user_type '.'
  implied type_arguments '<' '>' ','
  implied function_type '->'
  implied recv_function_type '.' '->'
  implied function_type_parameters '(' ')' ','
  implied elvis_op '?:'
  implied conj_op '&&'
  implied disj_op '||'
  implied indexing_suffix '[' ']' ','
  implied collection_literal '[' ']' ','
  implied parenthesized_type '(' ')'
  implied alias_rest 'typealias' '='
  implied value_arguments '(' ')' ','
  implied this_expression 'this'
  implied this_label 'this' '@'
  implied string_literal '"' '""'
  implied character_literal "'" char_content
  implied uni_escape uni_digits
  implied number_literal 'L' 'u' 'U' 'uL' 'UL'
  implied parenthesized_expression '(' ')'
  implied if_expression 'if' '(' ')'
  implied when_expression 'when' '{' '}'
  implied property_delegate 'by'
  implied delegation_specifier 'by'
  implied try_expression 'try' '{' '}'
  implied catch_block 'catch' '(' ':' ')' '{' '}'
  implied finally_block 'finally' '{' '}'
  implied when_subject '(' ')' 'val' '='
  implied when_entry ',' 'else' ';'
  implied callable_reference '::' 'class'
  # Every mark a rule takes is asked only where a rule takes it, as the lean parser asks each
  # question where it branches (decision 0492). Not hidden: `generic`, where a `<` that opens type
  # arguments no rule reads refuses the file.
  hidden apart this_at jump_at as_q as_split is_split qdot ge sfx recv dotted fn_recv semi ann_lf semi_close head_ctor named cref trail lam_params lam_bare blk use_site file_at real ann_expr decl_mod wild obj_lit ft_dot_at enum_class fun_iface acc by_lf fn_paren ty_susp ds_susp cp_mod pm tpm imp_same
  extra line_comment multiline_comment
}
