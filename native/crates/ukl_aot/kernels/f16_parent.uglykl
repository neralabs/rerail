// A test kernel of rerail-ukl-aot (decision 0567 step 3): every node's parent over a format 16 tape in place, by one
// step a node and a chase of the steps' links, no walk over the slots. A walk's only state is its node, so a node
// whose first step (`clif_f16_parent_step`, `<ukl/reads/tape_f16.h>`) goes on from a previous sibling's node `j` has
// `j`'s parent.
//
// One launch, groups of 256 threads, every thread one node: each node's step as one word in its group's threadgroup
// memory, its parent or (`LINKED`) the node `j` it is linked to (a node's number is below 2^31: a node takes 2 bytes
// of the tape at least, whose offsets are u32, so the high bit is free; NONE is a parent). A barrier, then each
// linked node follows its links there, at most K - 1 = 7 (every K-th sibling names the parent); a link that leaves
// the group, or a chain still linked after 7 (a slot no tape's), is the walk from that link's node, whose parent it
// is (`clif_f16_parent`). A node's slot is read once, and a node not linked reads only its own word.
//
// (Two launches, the steps through device memory, and pointer jumping, rounds that read and write two arrays of
// every node, were slower on an M3's Metal: the traffic, not the threads. On the CPU the barrier parts the kernel's
// Rust in two phases, each chunk's first before any chunk's second: `rerail-ukl-vec`'s `rs.rs`.)

#define CLIF_VIEW_SPACE UKL_GLOBAL
#include <ukl/backend.h>
#include <ukl/reads/tape.h>

#define LINKED 2147483648u

typedef struct ParentArgs { uint32_t nodes, pad0, pad1, pad2; } ParentArgs;
UKL_REFLECT_STRUCT(ParentArgs, nodes, pad0, pad1, pad2)

DEFINE_KERNEL2(f16, parent_group,
               ROBUFFER, uint8_t,    tape,  "[bytes]",
               ROBUFFER, uint32_t,   view,  "[words]",
               RWBUFFER, uint32_t,   out,   "[args.nodes]",
               ARGS,     ParentArgs, args,  ,
               SHARED,   uint32_t,   steps, 256,
               GID0,     uint32_t,   i,     ,
               LID0,     uint32_t,   lid,   )
{
  uint32_t first=i-lid;
  uint32_t r=CLIF_T_NONE;
  if(i<args.nodes){
    uint64_t s=clif_f16_parent_step(tape,view,i);
    r=(s&CLIF_T_LINK)!=0u?LINKED|(uint32_t)s:(uint32_t)s;
  }
  steps[lid]=r;
  ukl_tg_barrier();
  if(i>=args.nodes)return;
  for(uint32_t k=0u;k<7u&&r!=CLIF_T_NONE&&(r&LINKED)!=0u&&(r&(LINKED-1u))>=first;k++)
    r=steps[(r&(LINKED-1u))-first];
  if(r!=CLIF_T_NONE&&(r&LINKED)!=0u)
    r=clif_f16_parent(tape,view,r&(LINKED-1u));
  out[i]=r;
}

// Spike, no barrier, a look-back: `out` is the shared word, every node's, `NOT_READY` until its parent is written. A
// node's link goes to an earlier node `j` (whose parent is its own), so a thread takes `out[j]` where it is already
// written, and only where it is not takes `j`'s step itself and goes on: never a wait, and a step at most computed
// again, the same. The threads' places are the SIMD groups' tickets (`ukl_sg_ticket`), so the groups started earlier
// hold the earlier nodes, mostly written by the time a later one looks back.
#include <ukl/simd.h>

#define NOT_READY 4294967294u

// Whether word `r` is a link (`LINKED | j`), not a parent (NONE among them) nor `NOT_READY`.
#define PARENT_BACK_LINKED(r) (((r)&LINKED)!=0u&&(r)<NOT_READY)

// Node `i`'s parent into `out[i]` (its place: a parameter, so its lanes stay consecutive where it is the id). Its
// step goes there first, for the nodes after it; then each link is the word there, a step's only where none is yet.
UKL_INLINE void parent_back_node(UKL_GLOBAL const uint8_t* tape, UKL_GLOBAL const uint32_t* view, UKL_GLOBAL uint32_t* out, uint32_t nodes, uint32_t i)
{
  if(i>=nodes)return;
  uint64_t s=clif_f16_parent_step(tape,view,i);
  uint32_t r=(s&CLIF_T_LINK)!=0u?LINKED|(uint32_t)s:(uint32_t)s;
  ukl_atomic_store(&out[i],r);
  for(uint32_t k=0u;k<7u&&PARENT_BACK_LINKED(r);k++){
    uint32_t j=r&(LINKED-1u);
    uint32_t q=ukl_atomic_load(&out[j]);
    if(q==NOT_READY){
      uint64_t t=clif_f16_parent_step(tape,view,j);
      q=(t&CLIF_T_LINK)!=0u?LINKED|(uint32_t)t:(uint32_t)t;
    }
    r=q;
  }
  if(PARENT_BACK_LINKED(r))
    r=clif_f16_parent(tape,view,r&(LINKED-1u));
  ukl_atomic_store(&out[i],r);
}

DEFINE_KERNEL2(f16, parent_back,
               ROBUFFER, uint8_t,    tape,   "[bytes]",
               ROBUFFER, uint32_t,   view,   "[words]",
               RWBUFFER, uint32_t,   out,    "[args.nodes]",
               RWBUFFER, uint32_t,   ticket, "[1]",
               ARGS,     ParentArgs, args,   ,
               GID0,     uint32_t,   g,      ,
               LID0,     uint32_t,   lid,    )
{
  parent_back_node(tape,view,out,args.nodes,ukl_sg_ticket(ticket,g,lid%UKL_SIMD_WIDTH));
}

// `parent_back`'s words before a launch: every node's `NOT_READY`, the ticket 0.
DEFINE_KERNEL2(f16, parent_back_clear,
               RWBUFFER, uint32_t,   out,    "[args.nodes]",
               RWBUFFER, uint32_t,   ticket, "[1]",
               ARGS,     ParentArgs, args,   ,
               GID0,     uint32_t,   i,      )
{
  if(i==0u)ticket[0]=0u;
  if(i<args.nodes)out[i]=NOT_READY;
}
