// A test kernel of rerail-ukl-aot (decision 0567 step 3): each thread's 64-bit values through every operation the
// CPU's vector code has of 64-bit lanes, each result its own row of `out` (row `k`, the thread's column):
//
// - arithmetic with a carry or a borrow between the halves, and a product, a quotient and a product's high half;
// - shifts by a constant below and past 32, and by each lane's count, logical and arithmetic;
// - comparisons, unsigned and signed, and a value's truth;
// - a 32-bit value widened (zero and sign) and a 64-bit one cut to 32;
// - an `if` whose sides set a 64-bit value, a loop that carries one, a load of another thread's;
// - a function of early returns that answers a value or a flag at bit 32 and a value, as a parent walk's step does.
// - a window of 8 bytes at consecutive lanes times a uniform width (8: one load of the lanes; 4: each lane's), as a
//   slot's array read is; a function of consecutive lanes that shifts and masks them at bit 8 (where a chunk crosses
//   no multiple of 256, one value and consecutive lanes; else each lane's).
// - a call that few lanes of a chunk take.

#include <ukl/backend.h>
#include <ukl/memory.h>

typedef struct WideArgs { uint32_t n, pad; uint64_t k; } WideArgs;
UKL_REFLECT_STRUCT(WideArgs, n, pad, k)

// The rows each thread writes.
#define WIDE_ROWS 27u

// A rare case's read, a loop over its argument: a call few of a chunk's lanes take (each lane's own call of it, by
// one value, where at most two do).
UKL_INLINE uint64_t wide_rare(uint64_t a, uint32_t c)
{
  uint64_t h = a;
  for (uint32_t q = 0u; q < (c & 15u); q += 2u) h = h * 31u + q;
  return h;
}

UKL_INLINE uint64_t wide_part(uint32_t j)
{
  return (uint64_t)(j >> 8) * 1000u + (j & 255u);
}

UKL_INLINE uint64_t wide_step(uint64_t a, uint32_t c)
{
  if((a&1u)==0u)return c;
  uint32_t s=(uint32_t)(a>>2);
  if(s-1u>=c)return 0xFFFFFFFFu;
  if((a&2u)!=0u)return c-s;
  return (((uint64_t)1)<<32)|(c-s);
}

DEFINE_KERNEL2(wide, wide_lanes,
               ROBUFFER, uint64_t, a,    "[args.n]",
               ROBUFFER, uint64_t, b,    "[args.n]",
               ROBUFFER, uint32_t, c,    "[args.n]",
               RWBUFFER, uint64_t, out,  "[args.n * WIDE_ROWS]",
               ARGS,     WideArgs, args, ,
               GID0,     uint32_t, i,    )
{
  if(i>=args.n)return;
  uint64_t x=a[i];
  uint64_t y=b[i];
  uint32_t z=c[i];
  uint32_t sh=z&63u;
  uint32_t n=args.n;
  uint32_t w=(args.k&1u)!=0u?8u:4u;
  out[0u*n+i]=x+y;
  out[1u*n+i]=x-y;
  out[2u*n+i]=x<<sh;
  out[3u*n+i]=x>>sh;
  out[4u*n+i]=(uint64_t)((int64_t)x>>sh);
  out[5u*n+i]=(x<<13)|(y>>51);
  out[6u*n+i]=x<<40;
  out[7u*n+i]=x>>35;
  out[8u*n+i]=(uint64_t)((int64_t)x>>40);
  out[9u*n+i]=x*y;
  out[10u*n+i]=y!=0u?x/y:7u;
  out[11u*n+i]=(uint64_t)(x<y)|((uint64_t)(x<=y)<<1)|((uint64_t)(x==y)<<2)|((uint64_t)(x!=y)<<3)
              |((uint64_t)((int64_t)x<(int64_t)y)<<4)|((uint64_t)((int64_t)x>=(int64_t)y)<<5)|((uint64_t)(x>y)<<6);
  out[12u*n+i]=(uint64_t)z+x;
  out[13u*n+i]=(uint64_t)(int64_t)(int32_t)z;
  out[14u*n+i]=(uint64_t)(uint32_t)(x>>3);
  uint64_t r;
  if(x&1u){ r=x^y; } else { r=x+z; }
  out[15u*n+i]=r;
  out[16u*n+i]=(uint64_t)ukl_popcount64(x)+((uint64_t)ukl_clz64(y)<<8);
  out[17u*n+i]=a[z%n];
  out[18u*n+i]=wide_step(x,z);
  uint64_t acc=x;
  for(uint32_t k=0u;k<(z&7u);k++){ acc=acc*3u+y; }
  out[19u*n+i]=acc;
  out[20u*n+i]=x+args.k+(args.k<<3);
  out[21u*n+i]=(x&0xFFFFFFFFu)==(y&0xFFFFFFFFu)?1u:2u;
  out[22u*n+i]=x?5u:6u;
  out[23u*n+i]=ukl_umulhi64(x,y);
  out[24u*n+i]=ukl_ld_window((UKL_GLOBAL const uint8_t*)a,i*w,8u);
  out[25u*n+i]=wide_part(i+3u);
  out[26u*n+i]=(x&3u)==0u?wide_rare(y,z):x;
}
