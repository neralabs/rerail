+      drop_statement($, $.keyword_conversion, $.object_reference),
+      drop_statement($, $.keyword_statistics, $.object_reference),
+      drop_statement(
+        $,
+        seq(
+          $.keyword_text,
+          $.keyword_search,
+          choice($.keyword_parser, $.keyword_dictionary, $.keyword_template, $.keyword_configuration),
