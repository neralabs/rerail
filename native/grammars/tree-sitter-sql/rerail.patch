+      optional(seq($.keyword_as, choice($.keyword_implicit, $.keyword_assignment))),
+    ),
+
+    // Rerail patch 103: one node, drop_object, for the DROP statements of the object kinds patches
+    // 44-55 read; drop_table, drop_index and the other upstream DROP nodes stay.
+    drop_object: $ => choice(
+      // Rerail patch 44: DROP CAST [IF EXISTS] (source AS target) [CASCADE | RESTRICT].
+      seq(
+        $.keyword_drop,
+        $.keyword_cast,
+        optional($._if_exists),
+        $._cast_types,
+        optional($._drop_behavior),
+      ),
+      // Rerail patch 46: DROP DOMAIN [IF EXISTS] name [, ...] [CASCADE | RESTRICT].
+      seq(
+        $.keyword_drop,
+        $.keyword_domain,
+        optional($._if_exists),
+        comma_list($.object_reference, true),
