+        ),
+      ),
+      seq(
+        $.keyword_alter,
+        $.keyword_rule,
+        $.identifier,
+        $.keyword_on,
+        $.object_reference,
+        $.keyword_rename,
+        $.keyword_to,
+        $.identifier,
+      ),
+      // Rerail patch 59: ALTER COLLATION | CONVERSION | STATISTICS | TEXT SEARCH ... | [PROCEDURAL]
+      // LANGUAGE | EVENT TRIGGER | TABLESPACE | LARGE OBJECT, as gram.y's AlterCollationStmt,
+      // AlterStatsStmt, AlterTSDictionaryStmt, AlterTSConfigurationStmt, AlterEventTrigStmt,
+      // AlterTblSpcStmt, RenameStmt, AlterOwnerStmt and AlterObjectSchemaStmt read them.
+      seq(
+        $.keyword_alter,
+        $.keyword_collation,
+        $.object_reference,
+        choice(
+          seq($.keyword_refresh, $.keyword_version),
+          $.rename_object,
+          $.change_ownership,
+          $.set_schema,
+        ),
+      ),
+      seq(
+        $.keyword_alter,
+        $.keyword_conversion,
+        $.object_reference,
+        choice($.rename_object, $.change_ownership, $.set_schema),
+      ),
+      seq(
+        $.keyword_alter,
+        $.keyword_statistics,
+        optional($._if_exists),
+        $.object_reference,
+        choice(
+          seq($.keyword_set, $.keyword_statistics, choice($.literal, $.keyword_default)),
+          $.rename_object,
+          $.change_ownership,
+          $.set_schema,
+        ),
+      ),
+      seq(
+        $.keyword_alter,
+        $.keyword_text,
+        $.keyword_search,
+        choice($.keyword_parser, $.keyword_dictionary, $.keyword_template, $.keyword_configuration),
+        $.object_reference,
+        choice(
+          $._definition,
+          seq(
+            choice(
+              seq($.keyword_add, $.keyword_mapping),
