+
+    _rule_notify: $ => $.notify_statement,
+
+    // Rerail patch 49: DISCARD ALL | PLANS | SEQUENCES | TEMP | TEMPORARY (gram.y's DiscardStmt).
+    discard_statement: $ => seq(
+      $.keyword_discard,
+      choice(
+        $.keyword_all,
+        $.keyword_plans,
+        $.keyword_sequences,
+        $.keyword_temp,
+        $.keyword_temporary,
+      ),
+    ),
+
+    // Rerail patch 49: NOTIFY channel [, payload], LISTEN channel, UNLISTEN channel | *.
+    notify_statement: $ => seq(
+      $.keyword_notify,
+      $.identifier,
+      optional(seq(',', alias($._literal_string, $.literal))),
+    ),
+
+    listen_statement: $ => seq($.keyword_listen, $.identifier),
+
+    unlisten_statement: $ => seq($.keyword_unlisten, choice($.identifier, '*')),
+
+    // Rerail patch 49: CHECKPOINT and LOAD 'file'.
+    checkpoint_statement: $ => $.keyword_checkpoint,
+
+    load_statement: $ => seq($.keyword_load, alias($._literal_string, $.literal)),
+
+    // Rerail patch 50: CALL procedure(arguments), as gram.y's CallStmt reads it.
