+      // Rerail patch 47: DROP FOREIGN TABLE | FOREIGN DATA WRAPPER | SERVER [IF EXISTS] names.
+      drop_statement(
+        $,
+        seq($.keyword_foreign, $.keyword_table),
+        $.object_reference,
+      ),
+      drop_statement(
+        $,
+        seq($.keyword_foreign, $.keyword_data, $.keyword_wrapper),
+        $.identifier,
+      ),
+      drop_statement($, $.keyword_server, $.identifier),
+      seq(
+        $.keyword_drop,
+        $.keyword_user,
+        $.keyword_mapping,
+        optional($._if_exists),
+        $._user_mapping_target,
+      ),
+      // Rerail patch 55: DROP OWNED BY roles [CASCADE | RESTRICT] and REASSIGN OWNED BY roles TO
