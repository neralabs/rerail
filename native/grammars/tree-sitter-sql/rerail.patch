+    function_reset: $ => seq($.keyword_reset, choice($.object_reference, $.keyword_all)),
+
+    // Rerail patch 103: one node, alter_object, for the ALTER statements of the object kinds patches
+    // 41-59 read (aggregate, operator and its classes and families, policy, trigger, rule,
+    // collation, conversion, statistics, text search objects, language, event trigger, tablespace,
+    // large object, publication, subscription, foreign data wrapper, server, user mapping): most
+    // only rename, change owner or set schema, and no rule tells them apart.
+    alter_object: $ => choice(
+      // Rerail patch 41: ALTER AGGREGATE name (args) RENAME TO | OWNER TO | SET SCHEMA.
+      seq(
+        $.keyword_alter,
+        $.keyword_aggregate,
+        $.object_reference,
+        $.aggregate_arguments,
+        choice($.rename_object, $.change_ownership, $.set_schema),
+      ),
+      // Rerail patch 59: ALTER OPERATOR FAMILY name USING method ADD items | DROP items | RENAME |
+      // OWNER | SET SCHEMA, and ALTER OPERATOR CLASS name USING method RENAME | OWNER | SET SCHEMA.
+      seq(
+        $.keyword_alter,
+        $.keyword_operator,
+        choice($.keyword_family, $.keyword_class),
+        $.object_reference,
+        $.keyword_using,
+        $.identifier,
+        choice(
+          seq($.keyword_add, comma_list($._operator_class_item, true)),
+          seq(
+            $.keyword_drop,
+            comma_list(seq(
+              choice($.keyword_operator, $.keyword_function),
+              alias($._natural_number, $.literal),
+              paren_list(choice($.keyword_none, $._type), true),
+            ), true),
+          ),
+          $.rename_object,
+          $.change_ownership,
+          $.set_schema,
+        ),
+      ),
+      // Rerail patch 59: ALTER OPERATOR op (left, right) OWNER TO | SET SCHEMA | SET (options).
