+      ),
+      seq($.keyword_function, $._function_with_argtypes),
+      seq($.keyword_type, $._type),
+      seq($.keyword_cast, $._cast_types),
+    ),
+
+    // The designators COMMENT ON did not read before patch 43.
+    _object_designator_other: $ => choice(
+      seq(
+        choice(
+          seq($.keyword_foreign, $.keyword_table),
+          $.keyword_collation,
+          $.keyword_conversion,
+          $.keyword_statistics,
+          seq(
+            $.keyword_text,
+            $.keyword_search,
+            choice(
+              $.keyword_parser,
+              $.keyword_dictionary,
+              $.keyword_template,
+              $.keyword_configuration,
+            ),
+          ),
+        ),
+        $.object_reference,
+      ),
+      seq(
+        choice(
+          seq($.keyword_access, $.keyword_method),
+          seq($.keyword_event, $.keyword_trigger),
+          seq($.keyword_foreign, $.keyword_data, $.keyword_wrapper),
+          seq(optional($.keyword_procedural), $.keyword_language),
+          $.keyword_publication,
+          $.keyword_server,
+          $.keyword_subscription,
+        ),
+        $.identifier,
+      ),
+      seq($.keyword_aggregate, $.object_reference, $.aggregate_arguments),
+      seq($.keyword_domain, $._type),
+      seq(choice($.keyword_procedure, $.keyword_routine), $._function_with_argtypes),
+      seq($.keyword_operator, $._operator_with_argtypes),
+      seq(
+        $.keyword_operator,
+        choice($.keyword_class, $.keyword_family),
+        $.object_reference,
+        $.keyword_using,
+        $.identifier,
+      ),
+      seq($.keyword_transform, $.keyword_for, $._type, $.keyword_language, $.identifier),
+    ),
+
+    // Rerail patch 43: gram.y's any_operator: an operator, optionally schema-qualified.
+    _operator_name: $ => seq(
+      optional(seq($.identifier, '.')),
+      alias(
+        choice($.op_other, '+', '-', '*', '/', '%', '^', '<', '>', '=', '<=', '>=', '<>', '!=', '&&'),
+        $.operator,
+      ),
+    ),
+
+    // Rerail patch 43: gram.y's operator_with_argtypes: op (left, right), NONE for a prefix
+    // operator's left side.
