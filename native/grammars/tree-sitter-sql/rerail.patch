+            ),
+            optional(seq($.keyword_for, comma_list($.identifier, true))),
+            choice(
+              seq($.keyword_with, comma_list($.object_reference, true)),
+              seq($.keyword_replace, $.object_reference, $.keyword_with, $.object_reference),
+            ),
+          ),
+          seq(
+            $.keyword_drop,
+            $.keyword_mapping,
+            optional($._if_exists),
+            $.keyword_for,
+            comma_list($.identifier, true),
+          ),
+          $.rename_object,
+          $.change_ownership,
+          $.set_schema,
+        ),
+      ),
+      seq(
+        $.keyword_alter,
+        optional($.keyword_procedural),
+        $.keyword_language,
+        $.identifier,
+        choice($.rename_object, $.change_ownership),
+      ),
+      seq(
+        $.keyword_alter,
+        $.keyword_event,
+        $.keyword_trigger,
+        $.identifier,
+        choice(
+          seq($.keyword_enable, optional(choice($.keyword_replica, $.keyword_always))),
+          $.keyword_disable,
+          $.rename_object,
+          $.change_ownership,
+        ),
+      ),
+      seq(
+        $.keyword_alter,
+        $.keyword_tablespace,
+        $.identifier,
+        choice(
+          $.set_storage_parameters,
+          $.reset_storage_parameters,
+          $.rename_object,
+          $.change_ownership,
+        ),
+      ),
+      seq(
+        $.keyword_alter,
+        $.keyword_large,
+        $.keyword_object,
+        alias($._integer, $.literal),
+        $.change_ownership,
+      ),
+      // Rerail patch 59: ALTER PUBLICATION name ADD | SET | DROP objects | SET (...) | RENAME |
+      // OWNER (AlterPublicationStmt).
+      seq(
+        $.keyword_alter,
+        $.keyword_publication,
+        $.identifier,
+        choice(
+          seq(choice($.keyword_add, $.keyword_set, $.keyword_drop), comma_list($._publication_object, true)),
+          seq($.keyword_set, $._definition),
+          $.rename_object,
+          $.change_ownership,
+        ),
+      ),
+      // Rerail patch 59: ALTER SUBSCRIPTION (AlterSubscriptionStmt, RenameStmt, AlterOwnerStmt).
+      seq(
+        $.keyword_alter,
+        $.keyword_subscription,
+        $.identifier,
+        choice(
+          seq($.keyword_connection, alias($._literal_string, $.literal)),
+          seq(
+            $.keyword_refresh,
+            $.keyword_publication,
+            optional(seq($.keyword_with, $._definition)),
+          ),
+          seq(
+            choice($.keyword_add, $.keyword_drop, $.keyword_set),
+            $.keyword_publication,
+            comma_list($.identifier, true),
+            optional(seq($.keyword_with, $._definition)),
