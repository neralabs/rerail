+// Rerail patch 101: gram.y's opt_createfunc_opt_list opt_routine_body: the options, among them
+// `AS` with the body string, in any order; a SQL-standard body (RETURN, BEGIN ATOMIC) comes last.
+function routine_options_and_body($) {
+  return seq(
+    repeat($._function_option),
+    choice(
+      // ensure that there's only one function body -- other specifiers are less
+      // variable but the body can have all manner of conflicting stuff
+      seq(alias($._function_body_as, $.function_body), repeat($._function_option)),
+      $.function_body,
+    ),
+  );
+}
+
+// Rerail patches 96-97: gram.y's select_no_parens tail: [sort_clause], then select_limit
+// (LIMIT / OFFSET / FETCH) and for_locking_clause in either order.
+function select_tail($) {
+  const select_limit = choice(
+    $.limit,
+    seq($.offset, optional(choice($.limit, $.fetch_clause))),
+    $.fetch_clause,
+  );
+  return seq(
+    optional($.order_by),
+    optional(choice(
+      seq(select_limit, repeat($.for_clause)),
+      seq(repeat1($.for_clause), optional(select_limit)),
+    )),
+  );
+}
+
+// A function argument: [DISTINCT] arg [ORDER BY ...], inline so that the invocation forms stay
+// one LR decision.
+function invocation_argument($) {
+  return seq(
+    optional($.keyword_distinct),
+    field('parameter', choice($.named_argument, $.term)),
+    optional($.order_by),
+  );
+}
+
+// Rerail patch 92: gram.y's VARIADIC func_arg_expr [sort_clause].
+function variadic_argument($) {
+  return seq(
+    $.keyword_variadic,
+    field('parameter', choice($.named_argument, $.term)),
+    optional($.order_by),
+  );
+}
