+        $.keyword_alter,
+        $.keyword_operator,
+        $._operator_with_argtypes,
+        choice(
+          $.change_ownership,
+          $.set_schema,
+          seq($.keyword_set, $._definition),
+        ),
+      ),
+      // Rerail patch 59: ALTER POLICY name ON table RENAME TO new | [TO roles] [USING (expr)]
+      // [WITH CHECK (expr)].
