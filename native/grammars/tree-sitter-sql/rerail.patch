+          $.keyword_enable,
+          $.keyword_disable,
+          seq(choice($.keyword_set, $.keyword_skip), $._definition),
+          $.rename_object,
+          $.change_ownership,
+        ),
+      ),
+      // Rerail patch 47: ALTER FOREIGN DATA WRAPPER (AlterFdwStmt, RenameStmt, AlterOwnerStmt).
+      seq(
+        $.keyword_alter,
+        $.keyword_foreign,
+        $.keyword_data,
+        $.keyword_wrapper,
+        $.identifier,
+        choice(
+          seq(repeat1($._fdw_option), optional($._alter_generic_options)),
+          $._alter_generic_options,
+          $.rename_object,
+          $.change_ownership,
+        ),
+      ),
+      // Rerail patch 47: ALTER SERVER (AlterForeignServerStmt, RenameStmt, AlterOwnerStmt).
+      seq(
+        $.keyword_alter,
+        $.keyword_server,
+        $.identifier,
+        choice(
+          seq($._server_version, optional($._alter_generic_options)),
+          $._alter_generic_options,
+          $.rename_object,
+          $.change_ownership,
+        ),
+      ),
+      seq(
+        $.keyword_alter,
+        $.keyword_user,
+        $.keyword_mapping,
+        $._user_mapping_target,
+        $._alter_generic_options,
+      ),
+    ),
+
+    // Rerail patch 45: gram.y's aggr_args: (*), (args), (args ORDER BY args), (ORDER BY args).
+    aggregate_arguments: $ => wrapped_in_parenthesis(choice(
+      '*',
+      seq(
+        comma_list($._aggregate_argument, true),
+        optional(seq($.keyword_order, $.keyword_by, comma_list($._aggregate_argument, true))),
+      ),
+      seq($.keyword_order, $.keyword_by, comma_list($._aggregate_argument, true)),
+    )),
+
+    // gram.y's aggr_arg is a func_arg: no default.
+    _aggregate_argument: $ => alias(
+      choice(
+        seq(optional($._argmode), optional($._param_name), $._type),
+        seq($._param_name, $._argmode, $._type),
+      ),
+      $.function_argument,
+    ),
+
+    // Rerail patch 42: ALTER EXTENSION name UPDATE [TO version] | ADD/DROP object | SET SCHEMA,
+    // as gram.y's AlterExtensionStmt, AlterExtensionContentsStmt and AlterObjectSchemaStmt read it.
+    alter_extension: $ => seq(
+      $.keyword_alter,
+      $.keyword_extension,
+      $.identifier,
+      choice(
+        seq(
+          $.keyword_update,
+          optional(seq($.keyword_to, choice($.identifier, alias($._literal_string, $.literal)))),
