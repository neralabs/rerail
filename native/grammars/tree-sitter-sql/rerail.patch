+        $.keyword_drop,
+        $.keyword_operator,
+        choice($.keyword_class, $.keyword_family),
+        optional($._if_exists),
+        $.object_reference,
+        $.keyword_using,
+        $.identifier,
+        optional($._drop_behavior),
