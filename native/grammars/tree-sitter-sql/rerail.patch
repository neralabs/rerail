+    ),
+
+    // Rerail patch 43: an object as COMMENT ON, SECURITY LABEL ON and ALTER EXTENSION ADD/DROP
+    // name it in gram.y (object_type_any_name any_name, object_type_name name, AGGREGATE, CAST,
+    // DOMAIN, FUNCTION, OPERATOR, TRANSFORM, TYPE, ...).
+    _object_designator: $ => choice(
+      $._object_designator_other,
+      seq(
+        choice(
+          $.keyword_table,
+          $.keyword_sequence,
+          $.keyword_view,
+          seq($.keyword_materialized, $.keyword_view),
+          $.keyword_index,
+        ),
+        $.object_reference,
+      ),
+      seq(
+        choice(
+          $.keyword_database,
+          $.keyword_role,
+          $.keyword_schema,
+          $.keyword_tablespace,
+          $.keyword_extension,
