# Dependabot falls back to the repo-root .npmrc when this directory has none, and the root sets
# legacy-peer-deps=true. That drops peer-only packages (vite and its tree, via vitest) from
# Dependabot's rerail lockfile, which CI's `npm ci --prefix rerail` then rejects as out of sync.
# Pin npm's default here so every tool resolves rerail's lockfile the same way.
legacy-peer-deps=false
