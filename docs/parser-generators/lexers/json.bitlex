# tree-sitter-json's tokens, without branches.
#
# Every token below is a leaf kind of tree-sitter-json 0.24.8:
#   '{' '}' '[' ']' ',' ':' '"'  string_content  escape_sequence  number  true  false  null
#   comment (an extra) is not lexed: a file with one escapes to tree-sitter.
#
# Observed facts this file relies on (tree-sitter-json 0.24.8, checked with its parser):
#   - `\s` in the extras is ASCII: space, \t \n \v \f \r. U+00A0, U+2028, U+3000 and U+FEFF are
#     errors. Outside strings, any byte of 0x80 or above is an error.
#   - `//.*` ends before '\n' and keeps a '\r': `//x\r\n` is the comment "//x\r".
#   - `/*/ */` is one comment: the '*' of `/*` cannot start the `*/`. `/**/` is a comment.
#   - number is -?(0|[1-9][0-9]*)(\.[0-9]*)?([eE]-?[0-9]+)? (grammar.js): an exponent's sign is
#     '-' only, so `1e+5` is an error; `1.` and `1.e5` are numbers (the number masks below send
#     them to tree-sitter).
#   - escape_sequence is two bytes, even for \u: "\u00e9" is escape_sequence "\u" and then
#     string_content "00e9". A raw tab or control byte is string_content; '\n' is an error.
#   - A comment's parent is the lowest common ancestor of the tokens before and after it, or the
#     document at either end of the file (01-branch-free-design.md §5). Nothing here depends on it.

lexer json

# Two tiers, as simdjson's two stages (docs/final-shape/decisions/0049-two-tiers.md):
#   - tier 1, every byte: the classes, the string state, each token's first and last byte, and
#     the errors a byte shows by itself;
#   - tier 2, every token (the tree section): kinds, keywords, the number check, nesting, keys.

# --- Byte classes --------------------------------------------------------------------------------

class quote     = '"'
class backslash = '\\'
class ws        = ' ' '\t' '\n' '\r' 0x0b 0x0c
class lf        = '\n'
# The structural bytes: one class, as simdjson's. Which one a token is, tier 2 reads.
class op        = '{' '}' '[' ']' ',' ':'
# A number's bytes.
class digit     = '0'..'9'
class zero      = '0'
class minus     = '-'
class dot       = '.'
class expo      = 'e' 'E'

# --- Strings: simdjson's stage 1 -----------------------------------------------------------------

# simdjson's escaped bytes: in a run of backslashes, each one at an even offset escapes the byte
# after it, a backslash or not. The backslashes not escaped start escapes.
mask escaped    = escaped(backslash)
mask q          = quote & ~escaped
mask inside     = toggle(q)                      # the opening quote, not the closing one
mask opening    = q & inside
mask closing    = q & ~inside
mask body       = inside & ~opening              # between the quotes
mask esc        = backslash & body & ~escaped    # an escape's backslash
mask esc_last   = escaped & body                 # the byte it escapes
mask content    = body & ~esc & ~esc_last

# --- Outside strings -----------------------------------------------------------------------------

mask code       = ~inside & ~closing
# Any other byte outside a string is in a word: a number or a literal, checked per token. A byte
# no JSON word holds (a '/', a non-ASCII byte) fails the check, and the file goes to tree-sitter.
mask word       = code & ~ws & ~op

# --- Tokens: each one's first and last byte ------------------------------------------------------

token '"'             = start q
token string_content  = start starts(content) last lasts(content)
token escape_sequence = start esc last esc_last
# tree-sitter-json's escapes: any other is an error, and the file goes to tree-sitter.
keywords escape_sequence {
  "\\\"" -> escape_sequence  "\\\\" -> escape_sequence  "\\/" -> escape_sequence
  "\\b" -> escape_sequence   "\\f" -> escape_sequence   "\\n" -> escape_sequence
  "\\r" -> escape_sequence   "\\t" -> escape_sequence   "\\u" -> escape_sequence
} required
# One token per structural byte; its kind is its text (tier 2).
token punctuation     = start code & op
keywords punctuation { "{"  "}"  "["  "]"  ","  ":" } required
# A run of word bytes is one token: a number if it starts with a digit or '-', else a keyword
# (tier 2 compares it once; any other word sends the file to tree-sitter).
token number          = start starts(word) & (digit | minus) last lasts(word)
token atom            = start starts(word) & ~(digit | minus) last lasts(word)
keywords atom { "true" -> true  "false" -> false  "null" -> null } required

skip code & ws

# --- Errors a byte shows by itself: the file goes to tree-sitter ---------------------------------

error "newline in a string"        when body & lf

# A string open at the end of the file is tier 2's: its node has no end, as simdjson's stage 1
# finds it from the final carry, not per byte.

# A number's syntax, as masks (doc 18 §4): -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE]-?[0-9]+)?. A word
# that starts with a digit or '-' is a number; one that starts otherwise is a keyword, which
# tier 2 compares once. (`1.` is a number for tree-sitter; it goes to tree-sitter here.)
mask wstart     = starts(word)
mask num        = fill(wstart & (digit | minus), ~word)
mask seen_dot   = fill(num & (dot | expo), ~num)        # from a dot or an exponent to the end
mask seen_expo  = fill(num & expo, ~num)
error "a stray byte in a number"   when num & ~(digit | minus | dot | expo)
error "a '-' inside a number"      when num & minus & ~wstart & ~prev(expo)
error "a '-' without a digit"      when num & minus & ~next(digit)
error "a leading zero"             when num & zero & (wstart | prev(wstart & minus)) & next(digit)
error "a '.' between non-digits"   when num & dot & ~(prev(digit) & next(digit))
error "a second '.' or one in an exponent" when num & dot & prev(seen_dot)
error "an exponent between non-digits" when num & expo & ~(prev(digit) & next(digit | minus))
error "a second exponent"          when num & expo & prev(seen_expo)
error "a number ending in a non-digit" when num & lasts(word) & ~digit

# A comment (valid for tree-sitter-json, an extra) is in a word: no grammar rule takes it, and
# the file goes to tree-sitter.

# --- The tree: tier 2, simdjson's stage 2 (18-tree-as-grammar.md) ---------------------------------
#
# Each node's content, as tree-sitter-json's grammar.js states it. The compiler makes one state
# machine per nesting level from it: the states are stage 2's labels, and a token no state takes
# sends the file to tree-sitter. Every token is a leaf node.
#
# Observed (tree-sitter-json 0.24.8, runtime 0.27.1):
#   - `document` spans the file from its first token to its last;
#   - string_content is split around escapes, as the tokens are;
#   - a value has the supertype `_value`; a key has the field `key`, a pair's value `value`.

tree json {
  node document               = value
  node object nested          = '{' [pair (',' pair)*] '}'
  node pair                   = key: string ':' value: value
  node array nested           = '[' [value (',' value)*] ']'
  node string                 = '"' (string_content | escape_sequence)* '"'
  choice value supertype _value = object | array | string | number | true | false | null
}
