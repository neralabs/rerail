# tree-sitter-json's tokens, without branches.
#
# Every token below is a leaf kind of tree-sitter-json 0.24.8:
#   '{' '}' '[' ']' ',' ':' '"'  string_content  escape_sequence  number  true  false  null
#   comment (an extra) is not lexed: a file with one escapes to tree-sitter.
#
# Observed facts this file relies on (tree-sitter-json 0.24.8, checked with its parser):
#   - `\s` in the extras is ASCII: space, \t \n \v \f \r. U+00A0, U+2028, U+3000 and U+FEFF are
#     errors. Outside strings, any byte of 0x80 or above is an error.
#   - `//.*` ends before '\n' and keeps a '\r': `//x\r\n` is the comment "//x\r".
#   - `/*/ */` is one comment: the '*' of `/*` cannot start the `*/`. `/**/` is a comment.
#   - number is -?(0|[1-9][0-9]*)(\.[0-9]*)?([eE]-?[0-9]+)? (grammar.js): an exponent's sign is
#     '-' only, so `1e+5` is an error; `1.` and `1.e5` are numbers (rule 4 below sends them to tree-sitter).
#   - escape_sequence is two bytes, even for \u: "\u00e9" is escape_sequence "\u" and then
#     string_content "00e9". A raw tab or control byte is string_content; '\n' is an error.
#   - A comment's parent is the lowest common ancestor of the tokens before and after it, or the
#     document at either end of the file (01-branch-free-design.md §5). Nothing here depends on it.

lexer json

# --- Byte classes --------------------------------------------------------------------------------

class quote     = '"'
class backslash = '\\'
class ws        = ' ' '\t' '\n' '\r' 0x0b 0x0c
class lf        = '\n'
class lbrace    = '{'
class rbrace    = '}'
class lbracket  = '['
class rbracket  = ']'
class comma     = ','
class colon     = ':'
class slash     = '/'
class star      = '*'
class high      = 0x80..0xff
# Bytes a number or a literal word may contain. Which word it is gets checked per token below.
class scalar    = '-' '+' '.' '0'..'9' 'a'..'z' 'A'..'Z'
class digit     = '0'..'9'
class zero      = '0'
class letter    = 'a'..'z' 'A'..'Z'
class minus     = '-'
class sign      = '+' '-'
class dot       = '.'
class expc      = 'e' 'E'
# The letters that may follow a backslash in tree-sitter-json's escape_sequence.
class escapable = '"' '\\' '/' 'b' 'f' 'n' 'r' 't' 'u'

# --- Strings -------------------------------------------------------------------------------------

# simdjson's carry trick: the byte after an odd run of backslashes is escaped.
mask escaped    = after_odd_run(backslash)

# Strings are toggle(q), as in simdjson. Comments are not lexed here: the first '/' or '*'
# outside a string escapes the file to tree-sitter (below). None of the 28,470 data-layer JSON
# files has one ('/' is 0.41% of bytes, all inside strings).
mask q          = quote & ~escaped
mask inside     = toggle(q)                      # the opening quote, not the closing one
mask opening    = q & inside
mask closing    = q & ~inside
mask body       = inside & ~opening              # between the quotes

# An escape is a backslash at an even offset in its run of backslashes, and the byte after it.
mask esc        = backslash & body & aligned(backslash, 2)
mask esc_bytes  = span(esc, 2)
mask content    = body & ~esc_bytes

# --- Outside strings -----------------------------------------------------------------------------

mask code       = ~inside & ~closing
mask word       = code & scalar

# --- Tokens --------------------------------------------------------------------------------------

token '"'             = start q
token string_content  = start starts(content) through content
token escape_sequence = start esc through esc_bytes
token '{'             = start code & lbrace
token '}'             = start code & rbrace
token '['             = start code & lbracket
token ']'             = start code & rbracket
token ','             = start code & comma
token ':'             = start code & colon
# A run of scalar bytes is one token. One that starts with a letter must be `true`, `false` or
# `null`; any other is a number, checked below.
mask wstart     = starts(word)
mask lit        = fill(wstart & letter, ~word)
mask num        = word & ~lit
token number          = start wstart & ~letter through num
token literal         = start wstart & letter through lit
keywords literal { "true" -> true  "false" -> false  "null" -> null } required

skip code & ws

# --- Errors: the file goes to tree-sitter --------------------------------------------------------

error "unterminated string"        when inside & lasts(~empty)
error "newline in a string"        when body & lf
error "invalid escape"             when prev(esc) & ~escapable
error "non-ASCII outside a string" when code & high

# --- Escapes: valid JSON that this file does not lex goes to tree-sitter ---------------------------

escape "a comment"                 when code & (slash | star)

# --- Numbers: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE]-?[0-9]+)? as masks -------------------------------
#
# The pattern is a fixed sequence of parts, so it needs no automaton. A token matches it exactly
# when no byte breaks one of the rules below. Each rule looks at most two bytes away, or asks
# whether a '.' or an 'e' came earlier in the same token: a `fill`, whose carry is one bit.
# About 25 mask operations per 64 bytes, the same for every block, however many numbers it holds.
#
#   token     -0.5e-10     01      1.e5     1e5.0
#   breaks    nothing      rule 6  rule 4   rule 3

mask nstart     = wstart & num
mask after_dot  = fill(prev(dot & num) & num, ~num)        # bytes after a '.' in the same token
mask after_e    = fill(prev(expc & num) & num, ~num)       # bytes after an 'e' in the same token
mask int_first  = (nstart & digit) | (prev(nstart & minus) & num)

# 1. Only digits, '.', 'e', 'E', '+' and '-'.
error "number: bad byte"        when num & ~(digit | dot | expc | sign)
# 2. It starts with '-' or a digit, and a '-' is followed by a digit.
error "number: bad start"       when (nstart & ~(digit | minus)) | (nstart & minus & ~next(digit))
# 3. At most one '.', at most one 'e', and no '.' after the 'e'.
error "number: '.' or e twice"  when (dot & (after_dot | after_e)) | (expc & after_e)
# 4. A '.' has a digit on each side.
error "number: bare '.'"        when num & dot & ~(prev(digit) & next(digit))
# 5. A sign is '-', first or right after the 'e'.
error "number: misplaced sign"  when num & sign & ~(minus & (prev(expc) | nstart))
# 6. The integer part is 0, or does not start with 0.
error "number: leading zero"    when int_first & zero & next(digit)
# 7. An 'e' follows a digit, and is followed by a digit or by a sign and a digit.
error "number: bare e"          when expc & num & (~prev(digit)
                                                   | ~(next(digit) | (next(minus) & next(digit, 2))))
# 8. The last byte is a digit.
error "number: bad end"         when lasts(num) & ~digit

# --- The tree: tree-sitter-json's nodes, for the tape (13-tape-on-the-gpu.md) -------------------
#
# Each token above is a leaf node. The section adds the inner nodes, each a start mask and an
# end mask: a node ends at the first bit of its end mask at or after its start, at its start's
# depth when it has a level. Where several start at one byte, the one listed first is outermost.
#
# Observed (tree-sitter-json 0.24.8, runtime 0.27.1):
#   - `document` starts at the first byte that is not whitespace and ends at the end of the file;
#   - string_content is split around escapes, as the tokens are;
#   - a value has the supertype `_value`; a key has the field `key`, a pair's value `value`;

tree json {
  # Bytes between tokens that carry no structure: whitespace.
  mask gap         = code & ws
  mask solid       = ~gap
  mask first_solid = solid & ~prev(fill(solid, empty))
  mask last_byte   = ~next(~empty)

  # Bracket depth, after each byte. A compiled count is 4 bit-planes and a deeper file goes to
  # tree-sitter: 4 of the 28,470 data-layer files nest past 13 (the deepest, 28).
  scan depth = count(code & (lbrace | lbracket), code & (rbrace | rbracket)) max 13

  # The first solid byte after a ':', and after a '{' or ','.
  mask after_colon = fill(prev(code & colon), prev(solid)) & solid
  mask after_open  = fill(prev(code & (lbrace | comma)), prev(solid)) & solid

  # A key is known from what comes before it, as in simdjson's stage 2: a string that opens
  # inside an object, right after its '{' or a ','. Its closing quote ends the key.
  mask key_quote   = opening & after_open & depth.frame(code & lbrace)
  mask key_end     = closing & prev(fill(key_quote, closing))

  mask value_start = (code & (lbrace | lbracket)) | (opening & ~key_quote) | wstart
  mask value_end   = (code & (rbrace | rbracket)) | (closing & ~key_end) | lasts(word)

  node document start first_solid       end last_byte
  # A pair ends with its value: the key's end is not a value end, and the level skips values
  # nested deeper.
  node pair     start key_quote         end value_end            level depth
  node object   start code & lbrace     end code & rbrace        level depth
  node array    start code & lbracket   end code & rbracket      level depth
  node string   start opening           end closing

  field key of string = key_quote
  field value of object array string number true false null = value_start & after_colon
  supertype _value of object array string number true false null = value_start
}
