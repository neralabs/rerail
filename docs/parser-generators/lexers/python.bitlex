# tree-sitter-python's leaves, without branches.
#
# The reference is tree-sitter-python 0.25.0 as Rerail vendors it (native/grammars/tree-sitter-python).
# Every token below is one of its leaf kinds. Layout (NEWLINE, INDENT, DEDENT) is not a token
# here: 02-python.md §4 computes it from this lexer's masks.
#
# Two automata do the work no bit trick can:
#   strings   strings and comments, over the whole file, about one event per 53 bytes
#   fstrings  interpolations, over f-string bodies only; a second instance runs over the bodies
#             of f-strings nested in an interpolation
# Everything else is masks, plus one Unicode lookup per non-ASCII character in code (§7).
#
# Observed facts this file relies on (tree-sitter-python 0.25.0, checked with its parser):
#   - The extras are comment, line_continuation and [\s\f\uFEFF\u2060\u200B]|\r?\n, and `\s` is
#     ASCII: U+00A0, U+0085, U+2028 and U+3000 are errors. A byte-order mark is the extra U+FEFF,
#     so `module` starts after it.
#   - identifier is [_\p{XID_Start}][_\p{XID_Continue}]*, with tables generated into parser.c:
#     sym_identifier_character_set_1 (682 ranges) and _2 (796 ranges). `x·y` and `x\u0301` are
#     identifiers; `x²` is an error at `²`, and so is `＿x`.
#   - line_continuation is '\' then '\r', '\r\n', '\n' or NUL.
#   - A comment inside an interpolation is an extra child of `interpolation`. An f-string inside
#     one is a `string` with its own string_start, interpolations and string_end.

lexer python

# === 1. Byte classes ==============================================================================

class sqc     = "'"
class dqc     = '"'
class hashc   = '#'
class lf      = '\n'
class cr      = '\r'
class bslash  = '\\'
class nul     = 0x00
class blank   = ' ' '\t' 0x0b '\f' '\r'
class lbrace  = '{'
class rbrace  = '}'
class lbrack  = '(' '['
class rbrack  = ')' ']'
class colonc  = ':'
class eqc     = '='
class bangc   = '!'
class dotc    = '.'
class ident   = 'a'..'z' 'A'..'Z' '_' '0'..'9' 0x80..0xff   # for prefixes and numbers only
class idstart = 'a'..'z' 'A'..'Z' '_'
class idcont  = 'a'..'z' 'A'..'Z' '_' '0'..'9'
class digit   = '0'..'9'
class hexdig  = '0'..'9' 'a'..'f' 'A'..'F'
class numc    = '0'..'9' 'a'..'z' 'A'..'Z' '_' '.'
class expc    = 'e' 'E'
class signc   = '+' '-'
class radixc  = 'x' 'X' 'o' 'O' 'b' 'B'
class xradix  = 'x' 'X'
class oradix  = 'o' 'O'
class bradix  = 'b' 'B'
class octdig  = '0'..'7'
class bindig  = '0' '1'
class usc     = '_'
class lsuf    = 'l' 'L'
class jsuf    = 'j' 'J'
class zeroc   = '0'
class pfx     = 'r' 'R' 'b' 'B' 'f' 'F' 'u' 'U'
class fpfx    = 'f' 'F'
class rpfx    = 'r' 'R'
class lower   = 'a'..'z'
class high    = 0x80..0xff
class opc     = '+' '-' '*' '/' '%' '@' '&' '|' '^' '~' '<' '>' '=' '!' ':' '.' ',' ';'
                '(' ')' '[' ']' '{' '}'
# Letters after a backslash that make a one-letter escape_sequence (tree-sitter-python's list).
class esc1c   = '\\' "'" '"' 'a' 'b' 'f' 'n' 'r' 't' 'v'
class xc      = 'x'
class uc      = 'u'
class Uc      = 'U'
class Nc      = 'N'

# === 2. Escapes, quotes, line ends ================================================================

# The byte after an odd run of backslashes is escaped. This is mode-independent: in a raw string
# too, a backslash keeps the next quote from ending the string.
mask escaped  = after_odd_run(bslash)
mask sq       = sqc & ~escaped
mask dq       = dqc & ~escaped
mask sq3      = sq & next(sq) & next(sq, 2)          # starts three single quotes in a row
mask dq3      = dq & next(dq) & next(dq, 2)

# A newline that ends a line: not escaped, and not the '\n' of an escaped "\r\n".
mask nl       = lf & ~escaped & ~(prev(cr) & prev(escaped))

# Only these newlines can end a comment or a short string: those ending a line that holds a
# quote or a '#'. They are 0.49% of bytes, against 2.47% for all newlines.
mask line_end = line_has(sq | dq | hashc, nl)

# === 3. Strings and comments: the `strings` automaton =============================================
#
# Treats an f-string like any other string. Section 5 catches the one case where that is wrong.
#
#   input    x = '''a'b''' # c'
#   events       ^^^ ^ ^^^ ^   ^          one per quote byte, '#' and line end
#   states       os2,os1,s3 ... cs2,cs1,code   comment

machine strings {
  events {
    q3s = sq3          # listed first: a quote that starts three wins over a plain quote
    q3d = dq3
    qs  = sq
    qd  = dq
    hash = hashc
    eol  = line_end
  }
  states code comment s1 d1 s3 d3 os2 os1 od2 od1 cs2 cs1 error
  group string  = s1 d1 s3 d3 os2 os1 od2 od1   # opening quotes .. last byte before the closing quotes
  group closing = cs2 cs1                        # inside a closing '''
  start code
  final code comment

  code    on hash -> comment,  on qs -> s1,  on qd -> d1,  on q3s -> os2,  on q3d -> od2
  comment on eol -> code

  s1      on qs -> code,  on q3s -> code,  on eol -> error     # closes at the first quote
  d1      on qd -> code,  on q3d -> code,  on eol -> error

  os2     on any -> os1                                        # the 2nd and 3rd opening quotes
  os1     on any -> s3
  od2     on any -> od1
  od1     on any -> d3

  s3      on q3s -> cs2                                        # only three quotes close it
  d3      on q3d -> cs2
  cs2     on any -> cs1                                        # the 2nd and 3rd closing quotes
  cs1     on any -> code
}

mask in_str   = strings.in(string)
mask in_cmt   = strings.in(comment)
mask opened   = strings.on(code -> s1 | d1 | os2 | od2)        # first byte of each opening quote
mask open3    = strings.in(os2 | os1) | prev(strings.in(os1))  # the three bytes of an opening '''
mask closed1  = strings.on(s1 | d1 -> code)                    # a closing ' or "
mask close3   = strings.in(closing) | prev(strings.in(cs1))    # the three bytes of a closing '''
mask body     = in_str & ~opened & ~open3                      # between the quotes

# === 4. Prefixes ==================================================================================
#
# One or two letters right before an opening quote, not themselves the end of a longer word:
# `rb"…"` has a prefix, and `if"…"` has none.

mask pre1     = prev(pfx) & ~prev(ident, 2)
mask pre2     = prev(pfx) & prev(pfx, 2) & ~prev(ident, 3)
mask has_f    = (pre1 & prev(fpfx)) | (pre2 & (prev(fpfx) | prev(fpfx, 2)))
mask has_r    = (pre1 & prev(rpfx)) | (pre2 & (prev(rpfx) | prev(rpfx, 2)))

# From each opening quote to just before its closing quote, for f-strings and for raw strings.
mask fstr     = fill(opened & has_f, after(in_str))
mask raw      = fill(opened & has_r, after(in_str))
mask fbody    = body & fstr

# === 5. Interpolations: the `fstrings` automaton ==================================================
#
# Runs over the bytes of `body` and `end` only: an f-string's body and its closing quote. Bracket
# depth inside an interpolation is bounded at 4; the deepest in either corpus is 4 (CPython: 1
# file, data layer: 3). Depth tells a `}` that closes the interpolation from one that closes a dict
# or set inside it. A ':' at depth 0 starts the format spec, as Python requires: a lambda or a
# walrus inside an interpolation must be parenthesised.
#
#   input    f"a{x[1]:>{w}}{{"
#   states     L I0 I1 I0 SPEC SPECX SPEC L LSKIP L
#
# A string inside an interpolation is opaque here, f-string or not. Before Python 3.12 it cannot
# hold the outer quote, so its first own quote closes it. A nested f-string's body is the input
# of a second instance (§5.1).
#
# 25 states. One 16-byte table lookup holds 16, so each event costs two (05-many-states.md §2).
# Indexed states: `i[0..4]` declares i0 … i4. A rule on `i[d]` stands for one rule per index; a
# target whose index is out of range is `error`. A rule on a named state such as `i0` replaces
# the indexed rule for the same event.

machine fstrings(body, end) {
  events {                                   # where several match, the first listed wins
    lb2   = lbrace & next(lbrace) & body
    lb    = lbrace & body
    rb2   = rbrace & next(rbrace) & body
    rb    = rbrace & body
    open  = lbrack & body
    close = rbrack & body
    colon = colonc & body                        # f"{x:=10}" is the spec '=10', not a walrus
    q3s   = sq3 & body                           # three quotes in a row
    q3d   = dq3 & body
    qs    = sq & body
    qd    = dq & body
    hash  = hashc & body
    eol   = nl & body                            # ends a comment in a triple-quoted f-string
    end   = end
  }
  states lit lskip i[0..4] qs[0..4] qd[0..4] cm[0..4] spec specx error
  group interp = i[*]
  group inner  = qs[*] qd[*]
  group cmt    = cm[*]
  start lit

  # Literal text: '{{' and '}}' are escapes; a single '{' opens an interpolation.
  lit    on lb -> i0,  on lb2 -> lskip,  on rb2 -> lskip,  on rb -> error,  on end -> lit
  lskip  on end -> error,  on any -> lit                       # the second brace of '{{' or '}}'

  # Code at bracket depth d. The fifth nested bracket and an unmatched close are errors.
  i[d]   on lb | lb2 | open -> i[d+1],  on rb | rb2 | close -> i[d-1],
         on qs -> qs[d],  on qd -> qd[d],  on hash -> cm[d],
         on q3s | q3d | end -> error           # a triple-quoted string inside: beyond the states
  i0     on rb | rb2 -> lit,  on colon -> spec

  # A string inside an interpolation. If it uses the f-string's own quote (Python 3.12),
  # `strings` has already ended the f-string there: `end` arrives here and the file falls back.
  qs[d]  on qs | q3s -> i[d],  on end -> error
  qd[d]  on qd | q3d -> i[d],  on end -> error
  # A comment inside an interpolation, to the end of its line.
  cm[d]  on eol -> i[d],  on end -> error

  # The format spec: literal text, with nested replacement fields such as `{w}`.
  spec   on lb | lb2 -> specx,  on rb | rb2 -> lit,  on end -> error
  specx  on rb | rb2 -> spec,   on lb | lb2 | end -> error
}

mask fend      = after(in_str) & prev(fstr)
machine f1     = fstrings(fbody, fend)

# --- 5.1 F-strings inside an interpolation ---
# f1 sees each one as an opaque string. Its body is the input of f2, the same machine again.
# Deeper nesting would be f3; one CPython file has it, and falls back.
mask f2_open   = f1.on(interp -> inner) & has_f
mask f2_str    = fill(f2_open, f1.on(inner -> interp))         # its opening quote .. its body
mask f2_body   = f2_str & ~f2_open
machine f2     = fstrings(f2_body, after(f2_str))
mask fbody_all = fbody | f2_body

# `fstrings*` is the union over the instances, f1 | f2. An instance's in() and on() hold only on
# its body and end bytes.
mask interp_open  = fstrings*.on(lit -> i0)                    # '{' of an interpolation
mask interp_close = fstrings*.on(interp | spec -> lit)         # its '}'
mask spec_colon   = fstrings*.on(i0 -> spec)
mask specx_open   = fstrings*.on(spec -> specx)
mask specx_close  = fstrings*.on(specx -> spec)
mask spec_text    = fstrings*.in(spec) & ~spec_colon & ~specx_close & ~interp_close
mask lit_text     = fbody_all & fstrings*.in(lit | lskip) & ~interp_close
mask inner_open   = fstrings*.on(interp -> inner)
mask inner_close  = fstrings*.on(inner -> interp)
mask inner_text   = fstrings*.in(inner) & ~inner_open & ~f2_str  # plain strings; f2 lexes the rest
mask icmt_start   = fstrings*.on(interp -> cmt)
mask icmt         = fstrings*.in(cmt)

# === 6. String tokens =============================================================================

mask s_open   = opened | inner_open
# The text of every string: plain bodies, f-string literal text, and strings inside interpolations.
mask s_text   = (body & ~fstr) | lit_text | inner_text
mask s_raw    = raw | fill(inner_open & has_r, inner_close)

# Prefix letters belong to string_start.
mask prefix   = next(s_open & (pre1 | pre2)) | next(s_open & pre2, 2)
mask s_start  = (s_open & ~pre1 & ~pre2) | next(s_open & pre1) | next(s_open & pre2, 2)

token string_start   = start s_start  through prefix | s_open | open3
token string_end     = start closed1 | starts(close3) | inner_close  through close3
# string_content is not split at escapes: escape_sequence and escape_interpolation are its
# children (02-python.md §5.5).
token string_content = start starts(s_text)  through s_text

# Escape sequences in non-raw text, as tree-sitter-python's escape_sequence defines them:
#   \x41 = 4 bytes, ሴ = 6, \U00012345 = 10, \N{NAME} through its '}', \7 \07 \007 = 2 to 4,
#   \ + newline = 2 (3 for \r\n), and \n \t \\ \' … = 2. Any other backslash is plain content.
mask e        = bslash & s_text & ~s_raw & ~escaped
mask e_x      = e & next(xc) & next(hexdig, 2) & next(hexdig, 3)
mask e_u      = e & next(uc) & next(hexdig, 2) & next(hexdig, 3) & next(hexdig, 4) & next(hexdig, 5)
mask e_U      = e & next(Uc) & next(hexdig, 2) & next(hexdig, 3) & next(hexdig, 4) & next(hexdig, 5)
                  & next(hexdig, 6) & next(hexdig, 7) & next(hexdig, 8) & next(hexdig, 9)
mask e_N      = e & next(Nc) & next(lbrace, 2)
mask e_d      = e & next(digit)
mask e_nl     = e & (next(lf) | next(cr))
mask e_1      = e & next(esc1c) & ~e_nl
mask esc_bytes = span(e_x, 4) | span(e_u, 6) | span(e_U, 10)
               | fill(e_N, prev(rbrace & s_text))                   # through the '}'
               | span(e_d, 2) | span(e_d & next(digit, 2), 3) | span(e_d & next(digit, 2) & next(digit, 3), 4)
               | span(e_nl, 2) | span(e_nl & next(cr) & next(lf, 2), 3)
               | span(e_1, 2)

token escape_sequence      = start e_x | e_u | e_U | e_N | e_d | e_nl | e_1  through esc_bytes
token escape_interpolation = start fstrings*.on(lit -> lskip)  through span(fstrings*.on(lit -> lskip), 2)

# Interpolation punctuation and the format spec.
mask conv     = bangc & fstrings*.in(i0) & next(lower)              # '!r': one named leaf
token type_conversion      = start conv  through span(conv, 2)
token '{'                  = start interp_open | specx_open
token '}'                  = start interp_close | specx_close
token ':'                  = start spec_colon
skip spec_text                                   # spec text is no node (02-python.md §5.5)

# === 7. Code ======================================================================================

# Code is everything outside strings and comments, plus the code inside interpolations and
# inside a format spec's nested fields.
mask code     = ((~in_str & ~in_cmt & ~close3 & ~closed1)
                 | (fstrings*.in(interp | specx) & ~interp_open & ~specx_open & ~inner_close
                    & ~span(conv, 2)))
              & ~prefix                          # also the 'b' of {b'x'} inside an interpolation

# tree-sitter-python's comment is '#' and then [^\r\n]*.
token comment = start strings.on(code -> comment) | icmt_start  through (in_cmt | icmt) & ~cr

# --- Numbers ---
# A number starts at a digit, or at a '.' before a digit, that does not continue a word.
mask num_start = code & ~prev(ident & code) & (digit | (dotc & next(digit)))
mask num_base  = fill(num_start, ~(numc & code))
# 0x…, 0o…, 0b…: the whole token. 1e-5: a sign continues a decimal number right after its e or E;
# in 0x1e+2 it does not.
mask based     = fill(num_start & zeroc & next(radixc), after(num_base))
mask sign_cont = code & signc & prev(expc) & prev(num_base) & ~prev(based)
mask number    = num_base | fill(sign_cont, ~(numc & code) & ~sign_cont)
# A float has a '.' or a decimal exponent somewhere in its token. `back_fill` carries that fact
# back to the token's first byte. 1j is an integer in tree-sitter-python.
mask floaty    = number & (dotc | (expc & ~based))
mask is_float  = num_start & back_fill(floaty, ~number)
token integer  = start num_start & ~is_float  through number
token float    = start is_float  through number

# --- Numbers: tree-sitter-python's patterns as masks ---
#
#   integer  (0[xX](_?[A-Fa-f0-9]+)+ | 0[oO](_?[0-7]+)+ | 0[bB](_?[01]+)+)[Ll]?
#          | ([0-9]+_?)+([Ll]|[jJ])?
#   float    mantissa ([0-9]+_?)+ '.' optional digits, or '.' and digits;
#            then optional [eE][+-]?([0-9]+_?)+; then optional [jJ]
#
# Each pattern is a fixed sequence of parts, so a token matches it exactly when no byte breaks
# one of the rules below. No automaton runs. Every rule looks at most two bytes away, or asks
# whether a '.' or an 'e' came earlier in the token: a `fill`, carrying one bit.
#
# Checked on tree-sitter-python: 1_  007  1_.5  1.e5  0x_1f  1_j  1.5_ are numbers;
# 0b12  1__2  1._5 are errors (rules 1, 4 and 6 below).

mask flt       = fill(is_float, ~number) & number           # the bytes of float tokens
mask dec       = number & ~flt & ~based                     # the bytes of decimal integers
mask radix_at  = based & prev(num_start)                    # the x, o or b
mask body      = based & ~num_start & ~radix_at             # what follows it
mask hdig      = (fill(radix_at & xradix, ~number) & hexdig)
               | (fill(radix_at & oradix, ~number) & octdig)
               | (fill(radix_at & bradix, ~number) & bindig) # a digit of the token's own base
mask after_dot = fill(prev(dotc & number), ~number) & number
mask after_e   = fill(prev(expc & flt), ~number) & number

# 1. Only the bytes each kind allows.
error "number: bad byte"     when (body & ~(hdig | usc | lsuf)) | (dec & ~(digit | usc | lsuf | jsuf))
                                  | (flt & ~(digit | usc | dotc | expc | signc | jsuf))
# 2. A suffix (l, L, j, J) is the last byte.
error "number: inner suffix" when number & (lsuf | jsuf) & ~lasts(number)
# 3. 0x, 0o, 0b are followed by a digit of the base or a '_'.
error "number: bare radix"   when radix_at & ~next(hdig | usc)
# 4. In 0x… a '_' is followed by a digit of the base; elsewhere it follows a decimal digit.
error "number: bad '_'"      when (body & usc & ~next(hdig))
                                  | ((dec | flt) & usc & ~prev(digit))
# 5. At most one '.', at most one e, and no '.' after the e.
error "number: '.' or e twice" when (flt & dotc & (after_dot | after_e)) | (flt & expc & after_e)
# 6. A '.' is not followed by '_'.
error "number: '._'"         when flt & dotc & next(usc)
# 7. An e is followed by a digit, or by a sign and a digit.
error "number: bare e"       when flt & expc & ~(next(digit) | (next(signc) & next(digit, 2)))

# --- Unicode ---
# UTF-8 needs no decoding to find ASCII facts: every byte of a multi-byte character is 0x80 or
# above, so no class above ever matches inside one. Only identifiers and the three non-ASCII
# extras ask for a code point, and only in code. `ucode` decodes the characters whose lead byte is
# in its `over` mask and sets each class on all bytes of the characters in it (03-bitlex.md
# §2.6, 04-unicode-and-numbers.md §3). In the corpora such characters are a few per million bytes.
ucode over code & high {
  class xid_start    = table "parser.c" sym_identifier_character_set_1
  class xid_continue = table "parser.c" sym_identifier_character_set_2
  class uspace       = U+FEFF U+2060 U+200B
}

# --- Words: identifiers and keywords ---
mask idc       = code & (idcont | xid_continue)
mask wstart    = code & (idstart | xid_start) & ~prev(idc) & ~number
mask word      = fill(wstart, ~idc)
token identifier = start wstart  through word
keywords identifier {
  "and" "as" "assert" "async" "await" "break" "class" "continue" "def" "del" "elif" "else"
  "except" "finally" "for" "from" "global" "if" "import" "in" "is" "lambda" "nonlocal" "not"
  "or" "pass" "raise" "return" "try" "while" "with" "yield"
  "True" -> true  "False" -> false  "None" -> none
} soft { "match" "case" "type" "print" "exec" "__future__" "_" }
# Soft keywords are keywords only in some positions: `__future__` after `from`, `_` as a case
# pattern. Which one a word is gets decided with the tree (02-python.md §5.1).
# Keywords are ASCII, so a word with a non-ASCII character is always an identifier.

# --- Line continuations ---
# '\' then '\r', '\r\n', '\n' or NUL. A node, except right before a string start, where tree-sitter's
# external scanner skips it (02-python.md §3): walk back from each string start over blanks and
# continuations, and drop the continuations reached.
mask lcont       = code & bslash & (next(lf) | next(cr) | next(nul))
mask lcont_bytes = span(lcont, 2) | span(lcont & next(cr) & next(lf, 2), 3)
mask before_str  = back_fill(prev(s_start), ~(blank | lcont_bytes))
token line_continuation = start lcont & ~before_str  through lcont_bytes
skip lcont_bytes

# --- Operators ---
munch op over code & opc & ~number {
  "**=" "//=" ">>=" "<<="
  "..." -> ellipsis
  "->" ":=" "!=" "<>" "==" "<=" ">=" "**" "//" "<<" ">>"
  "+=" "-=" "*=" "/=" "%=" "@=" "&=" "|=" "^="
  "+" "-" "*" "/" "%" "@" "&" "|" "^" "~" "<" ">" "=" "." "," ";" ":"
  "(" ")" "[" "]" "{" "}"
}

skip code & (blank | lf | uspace)

# === 8. Errors: the file goes to tree-sitter ======================================================

error "unterminated string, or a newline in a short one"  when strings.reached(error) | ~strings.final(code | comment)
error "an f-string beyond the automaton's bounds"         when fstrings*.reached(error)
error "a '!' that is neither '!=' nor a conversion"       when code & bangc & ~next(eqc)
# tree-sitter emits an anonymous '\' leaf for a backslash before '{{' or '}}' in f-string text
# (9 in CPython, all in test_fstring.py). Not modelled.
error "a backslash before an escaped brace"                when bslash & lit_text & (next(lbrace) | next(rbrace))
error "an f-string nested three deep"                     when f2.on(interp -> inner) & has_f
error "a non-ASCII character tree-sitter rejects in code"   when code & high & ~xid_continue & ~uspace
error "an identifier that starts with a non-start character" when code & high & ~prev(idc) & ~xid_start & ~uspace
# A prefix test reads the byte before a prefix letter without knowing whether it is code (§4).
# A non-ASCII byte there is taken as part of a word; if it is U+200B and the like, it is not.
error "a non-ASCII character right before a string prefix" when opened & prev(pfx) & (prev(high, 2) | (prev(pfx, 2) & prev(high, 3)))
# Implicit (03-bitlex.md §2.4): overlapping tokens, bytes in no token and not skipped, a `munch`
# whose fixed point did not settle, and a `check` that failed.
