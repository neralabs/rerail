    .decl reported(p: symbol, s: number, z: number, n: number, other: symbol)
    reported(p, s, z, n, w) :- block(d, s, z, n), doc(d, p, _), copy_of(d, s, w).
    .expect only reported("src/a.ts", 2, 46, 45, "src/b.ts:1")
    .expect only reported("src/b.ts", 1, 45, 45, "src/a.ts:2")
    .expect DUPLICATE_BLOCK at "src/a.ts":2
    .expect DUPLICATE_BLOCK at "src/b.ts":1
.end

.test a_block_twice_in_one_file exactly
    .fixture "src/a.ts" ```
        const a01 = compute("a", 1, 7);
        const a02 = compute("a", 2, 3);
        const a03 = compute("a", 3, 10);
        const a04 = compute("a", 4, 6);
        const a05 = compute("a", 5, 2);
        const a06 = compute("a", 6, 9);
