    .fixture "src/b.ts" ```
        function wrap() {
        const a01   =   compute("a",  1,  7);
            const a02   =   compute("a",  2,  3);
        const a03   =   compute("a",  3,  10);
            const a04   =   compute("a",  4,  6);
        const a05   =   compute("a",  5,  2);
            const a06   =   compute("a",  6,  9);
        const a07   =   compute("a",  7,  5);
            const a08   =   compute("a",  8,  1);
        const a09   =   compute("a",  9,  8);
            const a10   =   compute("a",  10,  4);

        const a11   =   compute("a",  11,  0);
            const a12   =   compute("a",  12,  7);
        const a13   =   compute("a",  13,  3);
            const a14   =   compute("a",  14,  10);
        const a15   =   compute("a",  15,  6);
            const a16   =   compute("a",  16,  2);
        const a17   =   compute("a",  17,  9);
            const a18   =   compute("a",  18,  5);
        const a19   =   compute("a",  19,  1);
            const a20   =   compute("a",  20,  8);
        // a note the copy added
        /**
         * and a doc block
         */
        const a21   =   compute("a",  21,  4);
            const a22   =   compute("a",  22,  0);
        const a23   =   compute("a",  23,  7);
            const a24   =   compute("a",  24,  3);
        const a25   =   compute("a",  25,  10);
            const a26   =   compute("a",  26,  6);
        const a27   =   compute("a",  27,  2);
            const a28   =   compute("a",  28,  9);
        const a29   =   compute("a",  29,  5);
            const a30   =   compute("a",  30,  1);
        }
        ```
    .expect DUPLICATE_BLOCK at "src/a.ts":1
    .expect DUPLICATE_BLOCK at "src/b.ts":2
.end

