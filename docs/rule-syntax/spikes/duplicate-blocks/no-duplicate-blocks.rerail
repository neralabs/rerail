.policy "no-duplicate-blocks" revision 1
.description "No block of 30 or more consecutive lines appears twice in the repository: across files, or twice in one file."
.mode steer
.scope include "src/**", "test/**", "packs/**"
.scope text "**/*"
// Left out: what is copied on purpose or not written by hand. Pack rules (JSON, translated from upstream or
// generated), licence texts, lock files, fixtures and snapshots, generated and minified files, and binaries.
.scope exclude "**/node_modules/**", "**/*.d.ts", "**/*.min.js", "**/*.map", "packs/*/rules/**", "packs/*/candidates/**", "**/LICENSE*", "**/licenses/**", "**/LICENSES/**", "**/NOTICE*", "**/*.lock", "**/package-lock.json", "**/fixtures/**", "**/__snapshots__/**", "**/*.snap", "**/*.expected.*", "**/*.generated.*", "**/generated/**", "**/*.png", "**/*.jpg", "**/*.gif", "**/*.ico", "**/*.svg", "**/*.wasm", "**/*.gz", "**/*.zip", "**/*.sqlite", "**/*.bin", "**/*.woff", "**/*.woff2", "**/*.ttf", "**/*.pdf"
// Duplicated code, as jscpd or PMD's CPD find it, by lines: a run of 30 or more consecutive lines that is somewhere
// else too. Each copy is reported once, at its first line, naming the other copy.
//
// The files are read as text (`.scope text`): no tree is needed, so no file is parsed, and every language is read
// the same way.
//
// Normalisation: each line's whitespace runs become one space, and the line is trimmed. A line then counts unless
// it is blank, or a comment's line: it starts with `//`, `/*` or `*` (a JSDoc block's inner and closing lines), or,
// in a language whose comments start with `#` (Python, shell, YAML, TOML, Ruby), with `#`. So a copy that was
// re-indented, or had blank lines or comments added, is still the same block. A line inside a block comment that
// does not start with `*` counts, as the text alone cannot tell it from code.
//
// How it works:
//   1. Per file. The lines that count, chained: j1(d, l, x), x the next line after l that counts. Jumps of 2, 4, 8
//      and 16 lines are made from it by doubling, and each run of 2^i lines starting at l gets a key the same way:
//      h2 of two lines' text, h4 of two h2s, … A window of 30 is 16 + 8 + 4 + 2 lines, so its key is made of four
//      keys. Each key is a 64-bit number (core's @hash64 and @hash64_pair): never the window's text.
//   2. Across files: dup_key(k), the only relation declared cross_file for the count, holds a key alone: one that
//      two places share. A file hands on its keys with how many windows of its own have each (win_n), so a line
//      edit that moves a block, without changing it, changes nothing dup_key reads.
//   3. The windows whose key is in dup_key are duplicated; consecutive ones (by the chain) are one run, and the run
//      is the block reported, from its first window's first line to its last window's last line.
//   4. The other copies are named by the places where the run's first key also occurs, as text ("src/a.ts:12"):
//      dup_place, declared cross_file, holds the places of the keys runs start with, and no other.

// ---- 1. per file: lines, chain, keys -----------------------------------------------------------------------
// hash_comments(d): document d's comments start with `#`, by its extension.
.decl hash_comments(d: number)
hash_comments(d) :- doc(d, p, _), match(".*\\.(?:py|pyi|sh|bash|zsh|ya?ml|toml|rb|pl|r|cfg|ini|conf|properties)", p).
// code_line(d, l, t): line l of document d, normalised, when it is not blank or a `//`, `/*` or `*` line.
.decl code_line(d: number, l: number, t: symbol)
code_line(d, l, t) :- split_line(d, l, raw), t = @replace_all(@replace_all(raw, "\\s+", " "), "^ | $", ""), t != "",
    !match("(?://|/\\*|\\*).*", t).
// norm(d, l, t): line l of document d, normalised, when it counts.
.decl norm(d: number, l: number, t: symbol)
norm(d, l, t) :- code_line(d, l, t), !hash_comments(d).
norm(d, l, t) :- code_line(d, l, t), hash_comments(d), !match("#.*", t).
// skip(d, l): line l exists and does not count.
.decl skip(d: number, l: number)
skip(d, l) :- split_line(d, l, _), !norm(d, l, _).
// after(d, l, x): x is the first counted line after line l (any line l). Each rule binds l from the line after it,
// so the join is by (d, line): written from l instead, the plan joined every line of a file with every other one.
.decl after(d: number, l: number, x: number)
after(d, l, x) :- norm(d, x, _), l = x - 1, l > 0.
after(d, l, x) :- skip(d, y), l = y - 1, l > 0, after(d, y, x).
// jN(d, l, x): x is the counted line N counted lines after counted line l.
.decl j1(d: number, l: number, x: number)
j1(d, l, x) :- norm(d, l, _), after(d, l, x).
.decl j2(d: number, l: number, x: number)
j2(d, l, x) :- j1(d, l, y), j1(d, y, x).
.decl j4(d: number, l: number, x: number)
j4(d, l, x) :- j2(d, l, y), j2(d, y, x).
.decl j8(d: number, l: number, x: number)
j8(d, l, x) :- j4(d, l, y), j4(d, y, x).
.decl j16(d: number, l: number, x: number)
j16(d, l, x) :- j8(d, l, y), j8(d, y, x).
// hN(d, l, h): the key of the N counted lines from l.
.decl h2(d: number, l: number, h: number)
h2(d, l, h) :- norm(d, l, a), j1(d, l, y), norm(d, y, b), h = @hash64_pair(@hash64(a), @hash64(b)).
.decl h4(d: number, l: number, h: number)
h4(d, l, h) :- h2(d, l, a), j2(d, l, y), h2(d, y, b), h = @hash64_pair(a, b).
.decl h8(d: number, l: number, h: number)
h8(d, l, h) :- h4(d, l, a), j4(d, l, y), h4(d, y, b), h = @hash64_pair(a, b).
.decl h16(d: number, l: number, h: number)
h16(d, l, h) :- h8(d, l, a), j8(d, l, y), h8(d, y, b), h = @hash64_pair(a, b).
// win(d, l, k): the window of 30 counted lines from l (16 + 8 + 4 + 2) has key k.
.decl win(d: number, l: number, k: number)
win(d, l, k) :- h16(d, l, a), j16(d, l, y1), h8(d, y1, b), j8(d, y1, y2), h4(d, y2, c), j4(d, y2, y3), h2(d, y3, e),
    k = @hash64_pair(@hash64_pair(@hash64_pair(a, b), c), e).
// win_n(d, k, n): document d has n windows of key k. What the file hands on: no line.
.decl win_n(d: number, k: number, n: number)
win_n(d, k, n) :- win(d, _, k), n = count : { win(d, _, k) }.

// ---- 2. across files: the keys two places share ------------------------------------------------------------
// A key and nothing else: the repository's duplicated windows, as a set.
.decl dup_key(k: number) cross_file
dup_key(k) :- win_n(_, k, n), n > 1.
dup_key(k) :- win_n(d, k, _), win_n(e, k, _), d != e.

// ---- 3. per file again: runs of duplicated windows ----------------------------------------------------------
.decl dup_at(d: number, l: number, k: number)
dup_at(d, l, k) :- win(d, l, k), dup_key(k).
.decl dup_start(d: number, s: number, k: number)
dup_start(d, s, k) :- dup_at(d, s, k), !dup_after_dup(d, s).
.decl dup_after_dup(d: number, l: number)
dup_after_dup(d, l) :- dup_at(d, l, _), j1(d, p, l), dup_at(d, p, _).
// run(d, s, l): window l is in the run that starts at s.
.decl run(d: number, s: number, l: number)
run(d, s, s) :- dup_start(d, s, _).
run(d, s, x) :- run(d, s, l), j1(d, l, x), dup_at(d, x, _).
// block(d, s, z, n): the run from s covers lines s to z, n counted lines.
.decl block(d: number, s: number, z: number, n: number)
block(d, s, z, n) :- dup_start(d, s, _), e = max l : { run(d, s, l) }, w = count : { run(d, s, _) }, n = w + 29,
    j16(d, e, a), j8(d, a, b), j4(d, b, c), j1(d, c, z).

// ---- 4. the other copies, named by their places -----------------------------------------------------------------
// dup_place(k, w): a window of key k starts at w ("path:line"), for the keys a run starts with.
.decl dup_place(k: number, w: symbol) cross_file
dup_place(k, w) :- dup_start(_, _, k), win(e, l, k), doc(e, p, _), w = cat(p, ":", to_string(l)).
// copy_of(d, s, ws): the block at s in document d is also at each place of ws, in text order.
.decl copy_of(d: number, s: number, ws: symbol)
copy_of(d, s, ws) :- dup_start(d, s, k), doc(d, p, _), own = cat(p, ":", to_string(s)),
    ws = join w by w sep ", " : { dup_place(k, w), w != own }.

// One finding at each copy's first line.
.violation DUPLICATE_BLOCK(at: loc, s: number, z: number, n: number, others: symbol)
    "Lines {s}-{z} ({n} lines of code) are also at {others}: extract the shared code"
DUPLICATE_BLOCK(@place(p, s), s, z, n, ws) :- copy_of(d, s, ws), doc(d, p, _), block(d, s, z, n).

// ---- tests (decision 0130): rerail-engine test-rr <this file> --------------------------------------------------
.test thirty_shared_lines_are_reported_in_both_files exactly
    .fixture "src/a.ts" ```
        import { x } from "./x";

        const a01 = compute("a", 1, 7);
        const a02 = compute("a", 2, 3);
        const a03 = compute("a", 3, 10);
        const a04 = compute("a", 4, 6);
        const a05 = compute("a", 5, 2);
        const a06 = compute("a", 6, 9);
        const a07 = compute("a", 7, 5);
        const a08 = compute("a", 8, 1);
        const a09 = compute("a", 9, 8);
        const a10 = compute("a", 10, 4);
        const a11 = compute("a", 11, 0);
        const a12 = compute("a", 12, 7);
        const a13 = compute("a", 13, 3);
        const a14 = compute("a", 14, 10);
        const a15 = compute("a", 15, 6);
        const a16 = compute("a", 16, 2);
        const a17 = compute("a", 17, 9);
        const a18 = compute("a", 18, 5);
        const a19 = compute("a", 19, 1);
        const a20 = compute("a", 20, 8);
        const a21 = compute("a", 21, 4);
        const a22 = compute("a", 22, 0);
        const a23 = compute("a", 23, 7);
        const a24 = compute("a", 24, 3);
        const a25 = compute("a", 25, 10);
        const a26 = compute("a", 26, 6);
        const a27 = compute("a", 27, 2);
        const a28 = compute("a", 28, 9);
        const a29 = compute("a", 29, 5);
        const a30 = compute("a", 30, 1);
        export const onlyA = 1;
        ```
    .fixture "src/b.ts" ```
        export function b() {
          return 2;
        }
        const a01 = compute("a", 1, 7);
        const a02 = compute("a", 2, 3);
        const a03 = compute("a", 3, 10);
        const a04 = compute("a", 4, 6);
        const a05 = compute("a", 5, 2);
        const a06 = compute("a", 6, 9);
        const a07 = compute("a", 7, 5);
        const a08 = compute("a", 8, 1);
        const a09 = compute("a", 9, 8);
        const a10 = compute("a", 10, 4);
        const a11 = compute("a", 11, 0);
        const a12 = compute("a", 12, 7);
        const a13 = compute("a", 13, 3);
        const a14 = compute("a", 14, 10);
        const a15 = compute("a", 15, 6);
        const a16 = compute("a", 16, 2);
        const a17 = compute("a", 17, 9);
        const a18 = compute("a", 18, 5);
        const a19 = compute("a", 19, 1);
        const a20 = compute("a", 20, 8);
        const a21 = compute("a", 21, 4);
        const a22 = compute("a", 22, 0);
        const a23 = compute("a", 23, 7);
        const a24 = compute("a", 24, 3);
        const a25 = compute("a", 25, 10);
        const a26 = compute("a", 26, 6);
        const a27 = compute("a", 27, 2);
        const a28 = compute("a", 28, 9);
        const a29 = compute("a", 29, 5);
        const a30 = compute("a", 30, 1);
        ```
    .expect DUPLICATE_BLOCK at "src/a.ts":3
    .expect DUPLICATE_BLOCK at "src/b.ts":4
.end

