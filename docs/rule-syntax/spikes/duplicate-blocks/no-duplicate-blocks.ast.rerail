.policy "no-duplicate-blocks-ast" revision 1
.description "No piece of code of 30 or more lines appears twice in the repository, compared by its syntax tree."
.language typescript
.mode steer
.scope include "src/**", "test/**", "packs/**"
.scope exclude "**/node_modules/**", "**/*.d.ts", "**/*.min.js", "packs/*/rules/**", "packs/*/candidates/**", "**/fixtures/**", "**/__snapshots__/**", "**/*.generated.*", "**/generated/**"
// no-duplicate-blocks.rerail compares lines of text. This one compares the parsed tree, with the tape's own
// structural digest (core's tree_digest): a node's kind, its children's fields and digests in order, a leaf's text, a
// literal's value. Comments, punctuation, layout and parentheses are left out, so `'x'` and `"x"`, `0x10` and `16`,
// a trailing comma or a reflowed call are the same code. Identifiers are compared by their text, so a copy with its
// variables renamed is not found. Where the grammar's tree differs, the code differs: `x => x` and `(x) => x` are
// two trees in tree-sitter's TypeScript (an identifier against formal_parameters).
//
// Two shapes of copy, both at least 30 lines from first to last line:
//   1. One node: a function, a class, a method, an object or array literal, a statement. Reported only where no
//      node around it is reported too.
//   2. A run of siblings: consecutive children of one node (statements of a block, members of a class, an object's
//      properties, an array's elements, a call's arguments), comments left out. Windows of 4 siblings are keyed as
//      the line rule keys its lines, and consecutive duplicated windows merge into one run.
// What crosses: a key (a number) and nothing else, as in the line rule; places are named as text.

// ---- per file ------------------------------------------------------------------------------------------------
// sib(d, pv, i, v, h, a, b): child i of the node numbered pv is the node numbered v, with key h, from line a to line
// b. Comments are no siblings. A node's number is its start line, column and depth (`at`): visit_index has no rows
// for TypeScript, and the depth tells a node from its first child, which starts where it does.
.decl at(n: node, v: number)
at(n, v) :- line(n, a), col(n, c), ast_depth(n, k), v = (a * 65536 + c) * 256 + k.
.decl sib(d: number, pv: number, i: number, v: number, h: number, a: number, b: number)
sib(d, pv, i, v, h, a, b) :- child(p, n, i), !kind(n, "comment"), docof(n, d), at(p, pv), at(n, v),
    h = @hash64(@tree_digest(n)), line(n, a), end_line(n, b).
.decl gap(d: number, pv: number, i: number)
gap(d, pv, i) :- child(p, n, i), kind(n, "comment"), docof(n, d), at(p, pv).
// after(d, pv, i, w): w is the first sibling after child i (comments skipped).
.decl after(d: number, pv: number, i: number, w: number)
after(d, pv, i, w) :- sib(d, pv, j, w, _, _, _), i = j - 1, i >= 0.
after(d, pv, i, w) :- gap(d, pv, j), i = j - 1, i >= 0, after(d, pv, j, w).
// j1(d, v, w): sibling w follows sibling v; j2 two siblings on.
.decl j1(d: number, v: number, w: number)
j1(d, v, w) :- sib(d, pv, i, v, _, _, _), after(d, pv, i, w).
.decl j2(d: number, v: number, w: number)
j2(d, v, w) :- j1(d, v, x), j1(d, x, w).
.decl h2(d: number, v: number, h: number)
h2(d, v, h) :- sib(d, _, _, v, a, _, _), j1(d, v, w), sib(d, _, _, w, b, _, _), h = @hash64_pair(a, b).
// win(d, v, k, a, b): the 4 siblings from v have key k, and run from line a to line b. The lines are made here, in
// the file, so that the runs below join nothing of the file's but these rows.
.decl win(d: number, v: number, k: number, a: number, b: number)
win(d, v, k, a, b) :- h2(d, v, x), j2(d, v, w), h2(d, w, y), k = @hash64_pair(x, y), sib(d, _, _, v, _, a, _),
    j1(d, w, z), sib(d, _, _, z, _, _, b).
// big(d, v, h, a, b): node v is 30 lines or more (a comment is none).
.decl big(d: number, v: number, h: number, a: number, b: number)
big(d, v, h, a, b) :- sib(d, _, _, v, h, a, b), b - a >= 29.
// A file hands on its keys and how many of each it has: no node, no line.
.decl key_n(d: number, k: number, n: number)
key_n(d, k, n) :- win(d, _, k, _, _), n = count : { win(d, _, k, _, _) }.
key_n(d, h, n) :- big(d, _, h, _, _), n = count : { big(d, _, h, _, _) }.

// ---- across files -------------------------------------------------------------------------------------------
.decl dup_key(k: number) cross_file
dup_key(k) :- key_n(_, k, n), n > 1.
dup_key(k) :- key_n(d, k, _), key_n(e, k, _), d != e.

// ---- the copies ----------------------------------------------------------------------------------------------
// 1. Runs of duplicated windows, from s; the run's lines are its first sibling's first to its last window's last.
.decl dup_win(d: number, v: number, k: number, a: number, b: number)
dup_win(d, v, k, a, b) :- win(d, v, k, a, b), dup_key(k).
.decl win_after_win(d: number, v: number)
win_after_win(d, v) :- dup_win(d, v, _, _, _), j1(d, u, v), dup_win(d, u, _, _, _).
.decl run(d: number, s: number, v: number)
run(d, s, s) :- dup_win(d, s, _, _, _), !win_after_win(d, s).
run(d, s, w) :- run(d, s, v), j1(d, v, w), dup_win(d, w, _, _, _).
// copy(d, s, k, a, b): a copy starts at node s, keyed k (its first window's or its node's), lines a to b.
.decl copy(d: number, s: number, k: number, a: number, b: number)
copy(d, s, k, a, b) :- dup_win(d, s, k, a, _), !win_after_win(d, s), e = max v : { run(d, s, v) },
    dup_win(d, e, _, _, b), b - a >= 29.
// 2. One node.
copy(d, v, h, a, b) :- big(d, v, h, a, b), dup_key(h).
// A copy inside another copy of its file is part of it.
.decl inner(d: number, v: number)
inner(d, v) :- copy(d, v, _, a, b), copy(d, u, _, a2, b2), u != v, a2 <= a, b <= b2, (a2 < a ; b < b2 ; u < v).
.decl shown(d: number, v: number, k: number, a: number, b: number)
shown(d, v, k, a, b) :- copy(d, v, k, a, b), !inner(d, v).

// ---- the other places ----------------------------------------------------------------------------------------
.decl place_of(k: number, w: symbol) cross_file
place_of(k, w) :- shown(_, _, k, _, _), copy(e, _, k, a, _), doc(e, p, _), w = cat(p, ":", to_string(a)).

.violation DUPLICATE_CODE(at: loc, a: number, b: number, others: symbol)
    "Lines {a}-{b} are the same code as {others}: extract the shared code"
DUPLICATE_CODE(@place(p, a), a, b, ws) :- shown(d, _, k, a, b), doc(d, p, _), own = cat(p, ":", to_string(a)),
    ws = join w by w sep ", " : { place_of(k, w), w != own }, ws != "".

// ---- tests (decision 0130): rerail-engine test-rr <this file> --------------------------------------------------
