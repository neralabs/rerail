.policy "local:no-explicitly-nested-routers" revision 1
.description "Avoid explicitly nesting imported routers through host JSX elements and fragments."
.language typescript
.mode log
.scope include "src/**/*.tsx", "src/**/*.jsx"
.scope exclude "**/*.test.*", "**/*.spec.*", "**/fixtures/**"
// B1: the JSON rule's meaning, unchanged.
// Inputs: the tape relations (kind, field, text, string_value), plus ref_site(ref, site) from the
// TypeScript scope table (the fact behind resolves.binding.site).
//
// How to read this file
//   1. tag() reads an element's tag name; imported() lists `import { … } from "…"` specifiers.
//   2. router_el() joins them: an element whose tag resolves to a router imported from react-router.
//   3. stop() is the set of nodes where the climb upwards from a router ends.
//   4. NESTED_ROUTER_JSX: a router whose nearest stop node above it is another router.
// Each relation corresponds to one part of nested-routers.json: router-name and router-element are its utils,
// stop is its stopBy list, and the violation is its top-level rule.

// The packages and export names that count as a router: the JSON's string list and its name regex, as sets.
.set router_module = "react-router" | "react-router-dom" | "react-router/dom"
                   | "react-router-dom/server" | "react-router/dom/server" | "react-router/server"
.set router_export = "BrowserRouter" | "HashRouter" | "MemoryRouter" | "Router" | "RouterProvider"
                   | "HistoryRouter" | "unstable_HistoryRouter" | "StaticRouter"
// Kind sets: grammar node kinds, usable with nearest() and with `$k in …`.
.kindset import_stmt = "import_statement"
// Nodes that end the climb: entering a function or a JSX attribute means the inner router is not rendered as a
// direct child any more (it is in a callback or a prop), so the JSON stops there.
.kindset barrier     = "arrow_function" | "function_expression" | "function_declaration"
                     | "method_definition" | "jsx_attribute"

// The tag name of a JSX element. Fragments (<>…</>) have none.
// `<X>…</X>` keeps its name under the opening tag; `<X/>` has it directly. The JSON's two router-element branches.
.decl tag(e: node, t: node)
tag($e, $t) :- kind($e, "jsx_element"), field($e, "open_tag", $o), field($o, "name", $t).
tag($e, $t) :- kind($e, "jsx_self_closing_element"), field($e, "name", $t).

// `import { x as y } from "m"`: the specifier binds y to m's export x.
// x is the imported name (the specifier's `name` field), so an alias such as `BrowserRouter as R` still counts.
// nearest(…, import_stmt) climbs from the specifier to its import statement; the JSON's `inside … stopBy: end`.
.decl imported(spec: node, m: sym, x: sym)
imported($s, $m, $x) :- kind($s, "import_specifier"), field($s, "name", $n), text($n, $x),
    nearest($s, $i, import_stmt), field($i, "source", $src), string_value($src, $m).

// router_el(e): e is a JSX element whose tag is an identifier bound by an import of a router export.
// ref_site follows the tag to the specifier that declares it: a local variable named BrowserRouter does not count.
// Member tags such as <RR.BrowserRouter> are not identifiers, so this B1 form misses them, as the JSON does.
.decl router_el(e: node)
router_el($e) :- tag($e, $t), kind($t, "identifier"), ref_site($t, $s),
    imported($s, $m, $x), $m in router_module, $x in router_export.

// Climbing from a router, the first of these ends the climb. The stop node itself is tested, as stopBy does.
// A barrier ends it without a finding. A router ends it with one. A composite (component) element ends it because
// what a component does with its children is unknown here. Host elements (<div>) and fragments let the climb pass.
.decl stop(n: node)
stop($n) :- kind($n, $k), $k in barrier.
stop($n) :- router_el($n).
// The negated group is "the tag is not an identifier starting with a lowercase letter": component tags (<Layout>)
// and member tags (<Foo.Bar>) stop the climb; <div> does not. Fragments have no tag, so tag() fails and they pass.
stop($e) :- kind($e, "jsx_element"), !router_el($e), tag($e, $t),          // a composite element:
    !(kind($t, "identifier"), text($t, $s), $s =~ "^[a-z]").                //   not a lowercase host tag

// The finding: an inner router whose closest stop ancestor is a router. nearest() returns only the first stop node
// above $inner, so a router inside <Layout> inside another router is not reported (B2 handles that case).
.violation NESTED_ROUTER_JSX(at: node)
    "Remove this inner router and use the outer router for its children."
NESTED_ROUTER_JSX($inner) :- router_el($inner), nearest($inner, $outer, stop), router_el($outer).
