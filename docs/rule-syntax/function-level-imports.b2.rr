.policy "data-layer:function-level-imports" revision 2
.description "Each function-level import, classified by the evidence for why it is deferred."
.language python
.mode block
.scope dirs "public"
.scope tests false
.budget FUNCTION_IMPORT by code { "total": 7844 }   // per-code budgets re-baselined on the first signed run

// allow(path, scope): imports that are deliberate and never reported. A fact written inline (a rule with no body).
.decl allow(path: symbol, scope: symbol)
allow("_internal/dynamic_import.py", "load_python_module").   // closed deferred-import registry
// Accurate version: classifies from evidence, not from module names.
//   typing-only          under `if TYPE_CHECKING:`, or every name it binds is read only in annotations
//   unread               it binds nothing that is read: unused, or imported for its side effects
//   test-helper          inside a test function or a pytest fixture
//   optional-dependency  inside `try:` with a handler for ImportError
//   circular-avoidance   moving it to the top would close an import cycle, proven on the module graph
//   deferred-no-cycle    a workspace module that could move to the top (the linter counts these as circular-avoidance)
//   heavy-dependency     a known expensive package (the Python declares KNOWN_EXPENSIVE_IMPORTS and never uses it)
//   other
//
// How to read this file
//   1. The libraries give each import statement its module, the modules it loads, and the names it binds.
//   2. import_time / runs / reaches build the module graph that exists when modules are imported, and its
//      transitive closure: reaches(a, b) means importing a eventually runs b.
//   3. local_import picks the imports inside a function: the only ones this rule reports.
//   4. cycle, workspace, guarded, read, value_read, test_fn, allowed are one fact of evidence each.
//   5. candidate lists every code whose evidence holds, with a priority; FUNCTION_IMPORT takes the first.
// Unlike the linter, nothing here matches module names against a list of internal packages; the module graph decides.

#include "python/imports.rr"
//   import_stmt(i)      i is an import or from-import statement
//   module_text(i, m)   the module as written, absolute (relative imports resolved against the file's package)
//   loads(i, q)         running i loads workspace module q, and each package above it. `from p import m` loads p.m
//                       when p.m is a module.
//   pkg_above(a, q)     q is a package containing module a (already initialising when a runs)
//   binds(i, s)         s is a binding site that i creates, one per alias
//   module_of(n, q)     node n is in workspace module q
#include "python/names.rr"
//   ref_site(r, s)            reference r reads binding site s (the scope table behind resolves.binding)
//   annotation(r)             r is in an annotation, including a string annotation's parsed body
//   sym_of(n, q)              n denotes qualified name q (resolves.import)
//   type_checking_block(b)    b is the body of `if TYPE_CHECKING:`, with TYPE_CHECKING resolved, not matched by name
//   catches(x, q)             except clause x catches q, tuples included
//   decorator(f, d), def_name(f, s), scope_name(n, s)   scope_name is "Class.method", as the Python reports it

// fn_or_lambda (python/imports): what counts as "inside a function" for this rule, a def or a lambda.
// Exception names an optional-dependency guard may catch, as resolved qualified names.
.decl import_error(v: symbol)
import_error("builtins.ImportError"). import_error("builtins.ModuleNotFoundError").

// The import graph at import time (module-level and class-body statements, outside TYPE_CHECKING) comes from
// python/imports:
//   import_time(i)  i runs when its module is first imported: no enclosing def or lambda (a class body runs at
//                   import time), and not under `if TYPE_CHECKING:`, which is false at run time
//   runs(a, b)      importing module a directly loads module b (an edge of the graph)
//   reaches(a, b)   importing a eventually loads b, through any chain of runs edges. The one recursive relation;
//                   the magic-transform pragma computes it only for the (target, importer) pairs asked about here.

// local_import(i): an import inside a def or lambda. Every finding is about one of these.
.decl local_import(i: node)
local_import(i) :- import_stmt(i), nearest(i, _, fn_or_lambda).

// The evidence.
.decl cycle(i: node)  // importing b at the top of a would close a → b → … → a
// Module a holds the import of b. b != a: importing yourself is no cycle. !pkg_above: a package that contains a is
// already initialising when a runs, so importing it is no cycle either. reaches(b, a): b already leads back to a.
cycle(i) :- local_import(i), module_of(i, a), loads(i, b), b != a, !pkg_above(a, b), reaches(b, a).
// workspace(i): i loads at least one module of this repository (third-party and stdlib imports load none).
.decl workspace(i: node)
workspace(i) :- local_import(i), loads(i, _).
// guarded(i): i sits in the body of a `try:` that has an `except` catching ImportError or ModuleNotFoundError.
// Only the try body counts: an import inside an except or finally branch is not guarded.
.decl guarded(i: node)
guarded(i) :- local_import(i), within(i, body), field(t, "body", body), kind(t, "try_statement"),
    child(t, x, _), catches(x, q), import_error(q).
// read(i): some reference anywhere reads a name that i binds.
.decl read(i: node)
read(i) :- binds(i, s), ref_site(_, s).
// value_read(i): some read of a name i binds is outside annotations, so the name is needed at run time.
.decl value_read(i: node)
value_read(i) :- binds(i, s), ref_site(r, s), !annotation(r).
// test_fn(f): f is a test (name starts test_) or a pytest fixture, the decorator resolved by sym_of, not by its text.
.decl test_fn(f: node)
test_fn(f) :- def_name(f, n), match("test_.*", n).
test_fn(f) :- decorator(f, d), sym_of(d, "pytest.fixture").
// allowed(i): i matches an allow() row: same file path, and its enclosing scope has the listed name.
.decl allowed(i: node)
allowed(i) :- allow(p, s), docof(i, d), doc(d, p, _), scope_name(i, s).

// The finding: one per local import that is not allowed, with one code.
// scope is the enclosing "Class.method" (scope_name); a statement has one, so it adds no findings.
.violation FUNCTION_IMPORT(at: node, code: symbol, scope: symbol) "{at.text} (in {scope})"
    fix safe hoist_import "Move `{at.text}` to the top of the module"
    fix remove_import "Delete `{at.text}`: nothing reads what it binds"
// The code is the highest-priority one whose evidence holds: min picks the lowest rank among the candidates.
FUNCTION_IMPORT(i, c, s) :- local_import(i), !allowed(i), scope_name(i, s),
    r = min k : { candidate(i, k, _) }, candidate(i, r, c).

// candidate(i, rank, code): code's evidence holds for i. The rank is a priority: stronger, more specific evidence
// first. An unread import is reported as unread even inside a test, and a cycle is only claimed for imports that
// are read, unguarded and not test code.
.decl candidate(i: node, rank: number, code: symbol)
// Explicitly deferred for type checking (the block never runs).
candidate(i, 1, "typing-only")         :- local_import(i), within(i, b), type_checking_block(b).
// No name it binds is read anywhere.
candidate(i, 2, "unread")              :- local_import(i), !read(i).
// Read, but only in annotations. Ranks after "unread" so that an unused import is not called typing-only.
candidate(i, 3, "typing-only")         :- local_import(i), !value_read(i).
// Any enclosing function is a test or fixture, not only the nearest one.
candidate(i, 4, "test-helper")         :- local_import(i), within(i, f), test_fn(f).
candidate(i, 5, "optional-dependency") :- local_import(i), guarded(i).
candidate(i, 6, "circular-avoidance")  :- local_import(i), cycle(i).
// Loads workspace code but closes no cycle: it could move to the top of the file.
candidate(i, 7, "deferred-no-cycle")   :- local_import(i), workspace(i).
// The package name alone or followed by a dot: numpy, numpy.linalg, not numpyx.
candidate(i, 8, "heavy-dependency")    :- local_import(i), module_text(i, m),
    match("(torch|tensorflow|numpy|pandas|scipy|matplotlib)(\\..*)?", m).
candidate(i, 9, "other")               :- local_import(i).

// ---- fixes ----------------------------------------------------------------------------------------------------------
// A fix relation has the violation's columns. Its rules end in `=> edits`; the finding's columns arrive bound, so
// these rules run once per finding, never over the whole repository.
//
// hoist_import is `safe`: Rerail may apply it without review. That is only claimed where the evidence says the
// move cannot change behaviour, which is what this version's classification is for:
//   - "deferred-no-cycle": the import loads workspace code and moving it closes no import cycle (cycle is false);
//   - the import is a plain statement of the function body, not inside if/try/with/for, so it runs unconditionally
//     whenever the function does and no exception handler around it is lost;
//   - nothing at module level already binds the same name to something else (clash).
// The library edit `hoist` (python/imports) deletes the statement, leaving `pass` if the body would be empty, and
// adds the same text among the top-level imports, or only deletes it if the module already has that import.
hoist_import(i, "deferred-no-cycle", _) :- plain_stmt(i), !clash(i) => hoist(i).

// remove_import is a suggestion (the default): "unread" also covers imports kept for their side effects, such as
// registering plugins, so a person or the agent decides. remove_stmt keeps the function body valid.
remove_import(i, "unread", _) => remove_stmt(i).

// plain_stmt(i): i sits directly in a function's body block.
.decl plain_stmt(i: node)
plain_stmt(i) :- child(b, i, _), field(f, "body", b), kind(f, "function_definition").
// clash(i): at module level, a name i binds is already bound by something other than the same import (a def, an
// assignment, a different import), or the module reads it as a builtin elsewhere. Hoisting would change its meaning.
.decl clash(i: node)
clash(i) :- import_alias(i, _, m, x, l), docof(i, d), modnode(d, mod), binding(mod, l, s, _),
    count : { import_alias(_, s, m, x, l) } = 0.
clash(i) :- import_alias(i, _, _, _, l), docof(i, d), global_ref(r, l), docof(r, d).
