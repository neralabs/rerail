.policy "rerail-ui-color-tokens" revision 2
.description "Use Nera's design tokens for dashboard colours instead of raw colour values, and don't redefine a Nera token outside its generated sheet."
.language html
.mode steer
.scope include "ui/**/*.html"
// rerail-ui-color-tokens for the dashboard's pages: the same seven text searches as its CSS policy
// (rerail-ui-color-tokens.rerail, which shows an example of each), over .html files:
//   <meta name="theme-color" content="#D4700A">          UI_RAW_HEX_COLOUR
//   <div style="color: red">                             UI_NAMED_COLOUR
//   <a href="#rules">                                    not reported (a fragment, not a colour)

#include "rr/rerail-ui-colours.rerail"

.violation UI_RAW_HEX_COLOUR(at: span, c: symbol) "Use a Nera token or a base.css page-local token built from Nera tokens (var(), color-mix(); getComputedStyle in a canvas) for {c}. Leave it if it is an id, fragment or private field."
UI_RAW_HEX_COLOUR(g, c) :- raw_hex(g), text(g, c).
.violation UI_RAW_COLOUR_IN_DATA_URI(at: span) "A data: image can't read the page's tokens: draw this icon as inline SVG with currentColor, or as a mask-image over a background from a Nera token."
UI_RAW_COLOUR_IN_DATA_URI(g) :- data_uri_hex(g).
.violation UI_RAW_COLOUR_FUNCTION(at: span) "Replace this raw colour with a Nera token from tokens.generated.css, or a base.css page-local token built from them (var(), color-mix(); getComputedStyle in a canvas)."
UI_RAW_COLOUR_FUNCTION(g) :- colour_function(g).
.violation UI_NAMED_COLOUR(at: span, c: symbol) "Replace {c} with a Nera token from tokens.generated.css, or a base.css page-local token built from them (var(), color-mix(); getComputedStyle in a canvas)."
UI_NAMED_COLOUR(g, c) :- named_colour(g), text(g, c).
.violation UI_EFFECT_COLOUR(at: span) "Effect tokens hold only a black or white alpha; take this colour from a Nera token or a base.css page-local token built from Nera tokens."
UI_EFFECT_COLOUR(g) :- effect_colour(g).
.violation UI_NERA_TOKEN_REDEFINED(at: span, t: symbol) "{t} is Nera's and comes only from tokens.generated.css: add a page-local token with its own name in base.css's token block and use that. Fix a wrong Nera value in Nera."
UI_NERA_TOKEN_REDEFINED(g, t) :- nera_token_defined(g), text(g, t).
.violation UI_NERA_TOKEN_SET(at: span, t: symbol) "{t} is Nera's and comes only from tokens.generated.css: add a page-local token with its own name in base.css's token block and use that. Fix a wrong Nera value in Nera."
UI_NERA_TOKEN_SET(g, t) :- nera_token_set(g), text(g, t).

.test page_colours_are_reported exactly
    .fixture "ui/index.html" ```
        <!doctype html>
        <meta name="theme-color" content="#D4700A">
        <div style="color: red"></div>
        <style>:root { --primary: rgb(11 87 208); }</style>
        ```
    .expect UI_RAW_HEX_COLOUR at "ui/index.html":2
    .expect UI_NAMED_COLOUR at "ui/index.html":3
    .expect UI_NERA_TOKEN_REDEFINED at "ui/index.html":4
    .expect UI_RAW_COLOUR_FUNCTION at "ui/index.html":4
.end

.test fragments_and_tokens_pass exactly
    .fixture "ui/index.html" ```
        <!doctype html>
        <a href="#rules">Rules</a>
        <div style="color: var(--primary-foreground)"></div>
        ```
.end
