.policy "rerail-start-state" revision 2
.description "Turn a checkout's status into a start state, or decide from one whether Rerail runs, only through src/runtime/repository-start.ts, outside engine and activation code; copies drift."
.language typescript
.mode log
.scope include "src/**/*.ts"
.scope exclude "src/runtime/repository-start.ts", "src/engine/**", "src/activation/**", "**/*.test.ts", "**/*.generated.ts"
// src/runtime/repository-start.ts owns how a checkout's status becomes a start state ("started", "stopped",
// "not-set-up") and whether Rerail runs in it. Three text searches over each file, as the JSON's regex clauses:
//   setUp ? "started" : "not-set-up"                       START_STATE_MAPPED_OUTSIDE_OWNER
//   status.started && status.setUp                         STARTED_AND_SET_UP_OUTSIDE_OWNER
//   if (answered !== "stopped") …                          RUNS_HERE_DECIDED_OUTSIDE_OWNER
//   stateOf({ started, setUp, startedBy: "repository" })   not reported
// A finding sits where the match starts. The regexes are the JSON's, copied exactly.

.violation START_STATE_MAPPED_OUTSIDE_OWNER(at: span) "Turn this status into a start state with stateOf from src/runtime/repository-start.ts (workspaceSetUp when only set-up matters), instead of mapping started and setUp here."
START_STATE_MAPPED_OUTSIDE_OWNER(m) :- source(_, sp), match_all("[^\\w$]setUp\\s*\\?\\s*\"(?:started|ok)\"|!\\s*(?:[\\w$.#]*(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.)?setUp\\s*\\?\\s*\"not-set-up\"|!\\s*(?:\\w*[Ss]tatus(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.)?started\\s*\\?\\s*\"stopped\"|!\\s*(?:\\w*[Ss]tatus(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.)?(?:started|setUp)\\s*\\)\\s*\\{?\\s*(?:return\\s+[^;\\n]*?|[\\w$.#]+\\s*=\\s*)\"(?:stopped|not-set-up)\"|configuredAt\\s*(?:===|!==)\\s*null\\s*\\?\\s*\"(?:not-set-up|started)\"", sp, m).

.violation STARTED_AND_SET_UP_OUTSIDE_OWNER(at: span) "Started and set up is stateOf(status) === \"started\": import stateOf from src/runtime/repository-start.ts instead of combining started and setUp here."
STARTED_AND_SET_UP_OUTSIDE_OWNER(m) :- source(_, sp), match_all("\\.started\\s*&&\\s*[\\w$.#]*(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.setUp\\b|\\.setUp\\s*&&\\s*[\\w$.#]*(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.started\\b|!\\s*[\\w$.#]*(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.started\\s*\\|\\|\\s*!\\s*[\\w$.#]*(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.setUp\\b|!\\s*[\\w$.#]*(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.setUp\\s*\\|\\|\\s*!\\s*[\\w$.#]*(?:\\((?:[^()\\n]|\\([^()\\n]*\\))*\\))?\\.started\\b", sp, m).

.violation RUNS_HERE_DECIDED_OUTSIDE_OWNER(at: span) "Ask isRerailStarted in src/runtime/repository-start.ts whether Rerail runs here. For a state already in hand (a daemon or CLI answer), add one predicate beside the RepositoryStartState type."
RUNS_HERE_DECIDED_OUTSIDE_OWNER(m) :- source(_, sp), match_all("(?:[\\w$#]*[Ss]tate|answered)\\s*!==\\s*\"stopped\"|[Ss]tate\\((?:[^()\\n]|\\([^()\\n]*\\))*\\)\\)?\\s*!==\\s*\"stopped\"|\"stopped\"\\s*!==\\s*[\\w$#.]*(?:[Ss]tate|answered)\\b|\\[\\s*\"(?:started|not-set-up)\"\\s*,\\s*\"(?:started|not-set-up)\"\\s*\\]|===\\s*\"started\"\\s*\\|\\|\\s*[\\w$.#]+\\s*===\\s*\"not-set-up\"|===\\s*\"not-set-up\"\\s*\\|\\|\\s*[\\w$.#]+\\s*===\\s*\"started\"|case\\s+\"(?:started|not-set-up)\"\\s*:\\s*case\\s+\"(?:started|not-set-up)\"\\s*:", sp, m).

// The pack's example (packs/rerail/pack.json).
.test deciding_from_a_state_is_reported exactly
    .fixture "src/harness/hook-host.ts" ```
        export async function hookRerailStarted(host: RerailHost, workspace: string, databasePath?: string): Promise<boolean> {
          const answered = await readRepositoryState(workspace, host);
          if (answered !== null) return answered !== "stopped";
          return isRerailStarted(workspace, databasePath);
        }
        ```
    .expect RUNS_HERE_DECIDED_OUTSIDE_OWNER at "src/harness/hook-host.ts":3
.end

.test mapping_and_combining_are_reported exactly
    .fixture "src/cli/status.ts" ```
        const state = status.started ? (status.setUp ? "started" : "not-set-up") : "stopped";
        const both = status.started && status.setUp;
        ```
    .expect START_STATE_MAPPED_OUTSIDE_OWNER at "src/cli/status.ts":1
    .expect STARTED_AND_SET_UP_OUTSIDE_OWNER at "src/cli/status.ts":2
.end

// The pack's passing example, and the owner itself.
.test the_owner_and_its_callers_pass exactly
    .fixture "src/api/repository-summary.ts" ```
        import { stateOf } from "../runtime/repository-start.js";

        export const summaryState = (repository: RepositoryListing) =>
          stateOf({ started: repository.started, setUp: repository.configuredAt !== null, startedBy: "repository" });
        ```
    .fixture "src/runtime/repository-start.ts" ```
        export const isStarted = (state: string) => state !== "stopped";
        ```
.end
