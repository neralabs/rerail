.policy "ruff-pyi054-numeric-literal-too-long" revision 2
.description "Replace long numeric literals in stub files with an ellipsis; a value that long is an implementation detail or varies by system."
.language python
.mode steer
.scope include "**/*.pyi"

// Ruff PYI054 (flake8-pyi), stubs only: a number literal written with more than 10 characters, anywhere,
// annotations included. `-1234567890` is fine: the literal is the 10 digits. Inside a string type definition, the
// number is found in its parsed tree; Ruff can place it only in a plain string (no escapes, no adjacent
// pieces). Otherwise every node of the parsed tree has the whole string's range (python/type-string-places), so
// Ruff measures that: any number in such a string written with more than 10 characters is reported, at the string.
//   x: int = 12345678901        ← PYI054
//   y: Literal[1_000_000_000]   ← PYI054
//   z: "Literal[1]" ""          ← PYI054 at the string: its range is 15 characters
#include "python/type-string-places.rerail"

.violation PYI054(at: node, msg: symbol) code "PYI054" "{msg}"
    suppress ruff "PYI054"
PYI054(n, "Replace this long numeric literal with `...` in the stub; the exact value is an implementation detail that stubs should not pin.") :-
    long_number(n), stub_node(n), !unplaced(n).
PYI054(s, "Write this string annotation as one plain string without escapes, and replace any numeric literal in it longer than ten characters with `...`; stubs should not pin exact values.") :-
    str_node(s), stub_node(s), !simple_string(s), !unplaced(s), under(s, n), number_lit(n), text(s, t), strlen(t) > 10.
.decl long_number(n: node)
long_number(n) :- number_lit(n), text(n, t), strlen(t) > 10.
// stub_node(n): n is in a stub, or in the tree parsed from a string of one (a guest document).
.decl stub_node(n: node)
stub_node(n) :- in_stub(n).
stub_node(n) :- parsed_in(n, h), in_stub(h).
// under(s, n): n is in the tree parsed from string s, or from a string nested in it.
.decl under(s: node, n: node)
under(s, n) :- str_tree(s, n).
under(s, n) :- str_tree(s, s2), under(s2, n).
