.policy "ruff-async116-long-sleep-not-forever" revision 2
.description "Use sleep_forever() instead of trio or anyio sleep calls longer than 24 hours; a sleep that long is almost always meant to never end."
.language python
.mode steer
.scope include "**/*"

// Ruff ASYNC116 (flake8-async): `trio.sleep(n)` or `anyio.sleep(n)` for more than 24 hours (86400 s), which is
// meant as `sleep_forever()`. The one argument (positional, or `seconds=` / `delay=`) must be an int or float
// literal; a name or an expression is not read.
//   await trio.sleep(86401)        ← ASYNC116
//   await anyio.sleep(1e10)        ← ASYNC116
//   await trio.sleep(86400)        not reported: exactly 24 hours
#include "python/misc2-async.rr"

.violation ASYNC116(at: node, m: symbol) code "ASYNC116"
    "`{m}.sleep()` with >24 hour interval should usually be `{m}.sleep_forever()`"
    suppress ruff "ASYNC116"
ASYNC116(c, m) :- async_call(c, _, q), async_sleep_arg(q, m, x), async_one_arg(c, x, a), async_over_a_day(a).
// An int literal over 86400 (Ruff also reports one too large for a u64), or a float literal over it.
.decl async_over_a_day(a: node)
// The value is normalised (no leading zeros), so it is compared by its digits: six or more, or five above 86400.
async_over_a_day(a) :- ruff_int(a, v), match("[1-9][0-9]{5,}|8640[1-9]|864[1-9][0-9]|86[5-9][0-9]{2}|8[7-9][0-9]{3}|9[0-9]{4}", v).
async_over_a_day(a) :- unparen(a, m), async_float(m, t), to_float(t) > 86400.0.
// A float with a positive exponent of three significant digits (1e100, 1e999, 1e0100) is over a day unless its mantissa is 0.
async_over_a_day(a) :- unparen(a, m), kind(m, "float"), match("[0-9_.]*[1-9][0-9_.]*[eE]\\+?0*[1-9][0-9_]{2,}", m).
// async_float(m, t): float literal m's text without `_`, when to_float can read it: not imaginary, and no
// exponent of three significant digits (leading zeros aside: 1e010 is read), which may overflow or underflow a double.
.decl async_float(m: node, t: symbol)
async_float(m, @replace_all(t, "_", "")) :- kind(m, "float"), text(m, t), !match("[\\s\\S]*[jJ]", t),
    !match("[0-9_.]*[eE][-+]?0*[1-9][0-9_]{2,}", t).
