.policy "ruff-async221-run-process-in-async-function" revision 2
.description "Don't run processes with subprocess.run, os.system or other blocking process calls inside async functions; they block the event loop until the process exits."
.language python
.mode steer
.scope include "**/*"

// Ruff ASYNC221 (flake8-async): a call that runs a process to completion inside an async def: os.system,
// os.posix_spawn[p], subprocess.run / call / check_call / check_output / getoutput / getstatusoutput, and an
// `os.spawn*` call in P_WAIT mode. The mode is the `mode` argument (or the first): absent, `os.P_WAIT`, or a
// name bound to it. Other spawn modes only start the process (ASYNC220).
//   async def f(): subprocess.run(cmd)                ← ASYNC221
//   async def f(): os.spawnl(os.P_WAIT, "x")          ← ASYNC221
//   async def f(): os.spawnl(os.P_NOWAIT, "x")        not reported: ASYNC220
#include "python/misc2-async.rr"

.violation ASYNC221(at: node) code "ASYNC221"
    "Async functions should not run processes with blocking methods"
    suppress ruff "ASYNC221"
ASYNC221(f) :- async_blocking(_, f, q), async_runs(q).
ASYNC221(f) :- async_blocking(c, f, q), async_spawn(q), !async_mode_arg(c, _).
ASYNC221(f) :- async_blocking(c, f, q), async_spawn(q), async_mode_arg(c, a), async_p_wait(a).
.decl async_runs(q: symbol)
async_runs("os.system"). async_runs("os.posix_spawn"). async_runs("os.posix_spawnp").
async_runs(cat("subprocess.", x)) :-
    (x = "run" ; x = "call" ; x = "check_call" ; x = "check_output" ; x = "getoutput" ; x = "getstatusoutput").
.decl async_spawn(q: symbol)
async_spawn(cat("os.spawn", x)) :-
    (x = "l" ; x = "le" ; x = "lp" ; x = "lpe" ; x = "v" ; x = "ve" ; x = "vp" ; x = "vpe").
// The mode: keyword `mode`, else the first positional argument.
.decl async_mode_arg(c: node, a: node)
async_mode_arg(c, a) :- async_blocking(c, _, q), async_spawn(q), call_kwarg(c, "mode", a).
async_mode_arg(c, a) :- async_blocking(c, _, q), async_spawn(q), !call_kwarg(c, "mode", _), ruff_arg(c, 0, a).
// `os.P_WAIT`, or a name whose binding in effect has that value (Ruff's find_assigned_value): `m = os.P_WAIT`,
// `with os.P_WAIT as m`.
.decl async_p_wait(a: node)
async_p_wait(a) :- async_mode_arg(_, a), ruff_qual(a, "os.P_WAIT").
async_p_wait(a) :- async_mode_arg(_, a), unparen(a, n), !ruff_qual(n, _), async_name_value(n, v),
    ruff_qual(v, "os.P_WAIT").
