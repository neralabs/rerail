.policy "ruff-pth124-py-path" revision 3
.description "Use pathlib instead of py.path.local; the py library's path API is in maintenance mode."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH124 (flake8-use-pathlib): every call of `py.path.local`, however it is imported. Reported at the
// callee. A reference that is not called is not reported.
//   py.path.local("../foo")                       ← PTH124
//   from py.path import local as path; path("x")  ← PTH124
//   f = py.path.local                             not reported
#include "python/python-21.rerail"
//   pth_checked_call(c, q, f)   c calls q in code Ruff checks; f the callee

.violation PTH124(at: node) code "PTH124"
    "Use `pathlib.Path(...)` instead of `py.path.local(...)` and port the py.path methods called on it (`join`, `ensure`, `check`, `read`); keep it where an API still requires a `py.path.local`."
    suppress ruff "PTH124"
PTH124(f) :- pth_checked_call(_, "py.path.local", f).

// Tests (decision 0130), from the python-21 review: each expects exactly what Ruff 0.17.6 reports.
// S1 `cast` strings, S2 escaped strings and S4 forward references in a function are reported; of S3's implicit
// concatenations only the call whose last name is its own head (`os.getcwd(" ")`) is; S5's function body runs after
// the module rebinds the import, so nothing there is.
.test review_shared exactly
    .fixture "shared.py" ```
        import os
        import py
        from typing import cast
        p = "x"

        # S1
        c101 = cast("os.chmod(p, 0o644)", p)
        c106 = cast("os.rmdir(p)", p)
        c107 = cast("os.remove(p)", p)
        c108 = cast("os.unlink(p)", p)
        c109 = cast("os.getcwd()", p)
        c110 = cast("os.path.exists(p)", p)
        c111 = cast("os.path.expanduser(p)", p)
        c124 = cast("py.path.local(p)", p)

        # S2
        e101: "os.chmod('a\\tb', 0o644)"
        e106: "os.rmdir('a\\tb')"
        e107: "os.remove('a\\tb')"
        e108: "os.unlink('a\\tb')"
        e109: "(os.getcwd(), 'a\\tb')"
        e110: "os.path.exists('a\\tb')"
        e111: "os.path.expanduser('a\\tb')"
        e124: "py.path.local('a\\tb')"

        # S3 (the all-rule rerun is shown separately below)
        s101: "os.chmod(" "p, 0o644)"
        s106: "os.rmdir(" "p)"
        s107: "os.remove(" "p)"
        s108: "os.unlink(" "p)"
        s109: "os.getcwd(" ")"
        s110: "os.path.exists(" "p)"
        s111: "os.path.expanduser(" "p)"
        s124: "py.path.local(" "p)"

        # S4
        def forward_scope():
            os = None
            py = None
            f101: "os.chmod(p, 0o644)"
            f106: "os.rmdir(p)"
            f107: "os.remove(p)"
            f108: "os.unlink(p)"
            f109: "os.getcwd()"
            f110: "os.path.exists(p)"
            f111: "os.path.expanduser(p)"
            f124: "py.path.local(p)"

        # S5
        import os as late_os
        import py as late_py
        def deferred_scope():
            late_os.chmod(p, 0o644)
            late_os.rmdir(p)
            late_os.remove(p)
            late_os.unlink(p)
            late_os.getcwd()
            late_os.path.exists(p)
            late_os.path.expanduser(p)
            late_py.path.local(p)
        late_os = None
        late_py = None
        ```
    .expect PTH124 at "shared.py":14
    .expect PTH124 at "shared.py":24
    .expect PTH124 at "shared.py":47
.end

// Implicit concatenations whose last name is not the callee's head: Ruff reports none.
.test review_concat exactly
    .fixture "concat.py" ```
        import os
        import py
        p = "x"
        s101: "os.chmod(" "p, 0o644)"
        s106: "os.rmdir(" "p)"
        s107: "os.remove(" "p)"
        s108: "os.unlink(" "p)"
        s109: "os.getcwd(" "p)"
        s110: "os.path.exists(" "p)"
        s111: "os.path.expanduser(" "p)"
        s124: "py.path.local(" "p)"
        ```
.end

// Imports of py.path, rebound and deleted names, deferred bodies.
.test import_forms exactly
    .fixture "import_forms.py" ```
        import py
        from py.path import local as L
        from py import path as pp
        import os
        from os import getcwd, getcwdb
        p = "x"
        py.path.local(p)
        L(p)
        pp.local(p)
        getcwd()
        getcwdb()
        a: "L()" ""
        b: "getcwdb(" ")"
        c: "pp.local(L)" ""
        d: "getcwd(int)" ""
        def g():
            py = None
            py.path.local(p)
            q: "py.path.local(p)"
            getcwd()
        lam = lambda: L(p)
        class C:
            getcwd()
            def m(self):
                getcwd()
        del getcwd
        getcwd()
        L = None
        ```
    .expect PTH124 at "import_forms.py":7
    .expect PTH124 at "import_forms.py":8
    .expect PTH124 at "import_forms.py":9
    .expect PTH124 at "import_forms.py":19
.end
