.policy "ruff-pth112-os-path-isdir" revision 2
.description "Use Path.is_dir() instead of os.path.isdir(); path objects read better than string-based os.path calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH112 (flake8-use-pathlib): a call of `os.path.isdir`, however it is imported, with exactly one argument:
// the `s` parameter, by position or by keyword. pathlib's form is `Path(p).is_dir()`.
// Reported at the callee.
//   os.path.isdir(p)                ← PTH112
//   from os.path import isdir
//   isdir(s=p)                      ← PTH112
//   os.path.isdir(path=p)           not reported: the parameter is `s`
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH112(at: node, s: node) code "PTH112"
    "Use `Path({s}).is_dir()` from pathlib instead of `os.path.isdir({s})`; leave it where the argument is a bytes path or a file descriptor."
    suppress ruff "PTH112"
PTH112(f, a) :- single_arg(_, "os.path.isdir", "s", f, a).
