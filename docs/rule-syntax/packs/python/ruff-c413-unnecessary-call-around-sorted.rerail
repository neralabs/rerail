.policy "ruff-c413-unnecessary-call-around-sorted" revision 3
.description "Remove a list or reversed call wrapped around sorted; sorted already returns a new list and can sort in reverse order itself."
.language python
.mode steer
.scope include "**/*"

// Ruff C413 (flake8-comprehensions): the builtin list or reversed (by name or as `builtins.list`) whose
// first argument is a call of the builtin sorted; in the file and in string type definitions. `sorted` already
// returns a new list, and sorts in reverse with `reverse=True`. Ruff's fix for list is safe: here it is offered
// for `list(sorted(…))` in the file alone. Its fix for reversed is unsafe (equal items come out in another
// order); none here.
//   list(sorted(x))        ← C413: sorted(x)        list(sorted\n (x))   ← C413: (sorted\n (x))
//   reversed(sorted(x))    ← C413: sorted(x, reverse=True)
//   [reversed(sorted(x)) for reversed in y]       not reported: the element reads the target
#include "python/python-15.rerail"
//   p15_builtin_call(c, x), p15_str_call(c, x), p15_first(c, a); call_only(c, a) (python/ruff)

.violation C413(at: node, outer: symbol, id: symbol, msg: symbol) code "C413" "{msg}"
    suppress ruff "C413"
    fix safe unwrap "Remove unnecessary `list()` call"
C413(c, "list", "list-call-around-sorted", "Remove the `list()` call around `sorted()`; `sorted()` already returns a new list.") :-
    around_sorted(c, "list", _).
C413(c, "reversed", "reversed-call-around-sorted",
    "Pass `reverse=True` (or flip the existing `reverse=`) to `sorted()` instead of wrapping it in `reversed()`; keep `reversed()` if equal elements must come out in reverse input order.") :-
    around_sorted(c, "reversed", _).
.decl around_sorted(c: node, outer: symbol, s: node)
around_sorted(c, x, s) :- (p15_builtin_call(c, x) ; p15_str_call(c, x)), (x = "list" ; x = "reversed"),
    p15_first(c, s), (p15_builtin_call(s, "sorted") ; p15_str_call(s, "sorted")).
p15_name("list"). p15_name("reversed"). p15_name("sorted").
// The argument as written, parentheses kept; a call over several lines gets parentheses, so it stays valid.
unwrap(c, "list", _, _) :- call_only(c, a), around_sorted(c, "list", _), one_line(c) => replace(c, `$a`).
unwrap(c, "list", _, _) :- call_only(c, a), around_sorted(c, "list", _), !one_line(c) => replace(c, `($a)`).
.decl one_line(c: node)
one_line(c) :- around_sorted(c, "list", _), text(c, t), !contains("\n", t).

// Ruff 0.17.6 (python-15 review): an alias imported from builtins is the builtin, and `builtins.list` is looked
// up in a string type definition too.
.test aliases_and_qualified_names_in_strings exactly
    .fixture "case.py" ```
        from builtins import list as builtin_list
        import builtins
        xs = [2, 1]
        alias_case = builtin_list(sorted(xs))
        qualified_string_case: "builtins.list(sorted(xs))"
        ```
    .expect C413 at "case.py":4
    .expect C413 at "case.py":5
.end
