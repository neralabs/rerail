.policy "ruff-pth205-os-path-getctime" revision 2
.description "Use Path.stat().st_ctime instead of os.path.getctime(); path objects read better than string-based os.path calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH205 (flake8-use-pathlib): a call of `os.path.getctime`, however it is imported, with exactly one argument:
// the `filename` parameter, by position or by keyword. pathlib's form is `Path(p).stat().st_ctime`.
// Reported at the callee.
//   os.path.getctime(p)             ← PTH205
//   from os.path import getctime
//   getctime(filename=p)            ← PTH205
//   os.path.getctime(*ps)           not reported: Ruff does not look past `*`
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH205(at: node, s: node) code "PTH205"
    "Use `Path({s}).stat().st_ctime` instead of `os.path.getctime({s})` (without the `Path(...)` wrapper if `{s}` is already a path); leave it where the argument is a bytes path or a file descriptor."
    suppress ruff "PTH205"
PTH205(f, a) :- single_arg(_, "os.path.getctime", "filename", f, a).
