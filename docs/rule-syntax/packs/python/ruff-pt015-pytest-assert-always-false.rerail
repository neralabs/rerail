.policy "ruff-pt015-pytest-assert-always-false" revision 2
.description "Use pytest.fail instead of an assert on a value that is always false; it states the intent to fail the test more clearly."
.language python
.mode steer
.scope include "**/*"

// Ruff PT015 (flake8-pytest-style): an `assert` whose test is always false (Ruff's Truthiness): False, None,
// 0, 0.0, 0j, "", b"", f"" (or f"{''}"), an empty list, tuple, set or dict display, or `list()`, `tuple()`, `set()`,
// `dict()`, `frozenset()` of the builtin called with nothing or with one falsy argument. `pytest.fail` says it.
//   assert False, "unreachable"      ← PT015
//   assert list([])                  ← PT015
//   assert not True                  not reported: Ruff does not evaluate `not`
#include "python/ruff.rerail"
//   truth_of(m, t): Ruff's Truthiness; list_like(e, t)

.violation PT015(at: node) code "PT015"
    "Replace this always-failing `assert` with `pytest.fail(...)`, passing any assertion message to it; leave it alone outside pytest tests."
    suppress ruff "PT015"
PT015(a) :- assert_test(a, t), truth_of(t, f), (f = "false" ; f = "none").
PT015(a) :- assert_test(a, t), list_like(t, _), unparen(t, m), count : { child(m, c, _), !blank(c) } = 0.

// A line continuation is a node of tree-sitter's and whitespace to Ruff: `assert \` puts one before the test, and
// `assert ( \` + `)` is the empty tuple, which truth_of (counting the continuation as an element) calls true.
.decl blank(c: node)
blank(c) :- kind(c, "comment").
blank(c) :- kind(c, "line_continuation").
.decl assert_test(a: node, t: node)  // t is assert a's test, parentheses off
assert_test(a, t) :- kind(a, "assert_statement"), child(a, t0, j), !blank(t0),
    count : { child(a, x, k), k < j, !blank(x) } = 0, unparen(t0, t).
