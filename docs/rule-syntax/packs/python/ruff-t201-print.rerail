.policy "ruff-t201-print" revision 3
.description "Use a logger instead of print; printed output can leak sensitive data and cannot be configured by clients."
.language python
.mode steer
.scope include "**/*"

// Ruff T201 (flake8-print): a call of the builtin `print`. Output meant for users goes to `sys.stdout` or
// `sys.stderr`, so those (and `file=None`) are reported too; a call writing to any other `file=` is not. Ruff checks
// the code of string type definitions too (`cast("print(1)", x)`, a TypeVar's bound), where `print` is the builtin
// unless the module binds the name (python/type-string-names). Reported at the callee. (Ruff's fix deletes the
// statement, unsafely; none here.)
//   print("Hello, world!", file=sys.stderr)     ← T201
//   print("Hello, world!", file=fp)             not reported
//   T = TypeVar("T", bound="print(8)")          ← T201
#include "python/type-string-names.rerail"

.violation T201(at: node) code "T201"
    "Replace this `print` with a `logging` call (`logger.debug`, `logger.info`), or remove it if it was debug output; leave it where the program's job is to write to the terminal."
    suppress ruff "T201"
T201(f) :- p10_call_q(c, "builtins.print"), field(c, "function", f), !print_elsewhere(c).

// print_elsewhere(c): c passes `file=` a value other than None, sys.stdout or sys.stderr.
.decl print_elsewhere(c: node)
print_elsewhere(c) :- p10_kwarg(c, "file", v), !p10_stdio(v).
