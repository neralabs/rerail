.policy "ruff-tc006-runtime-cast-value" revision 2
.description "Quote the type expression passed to typing.cast; a quoted type is not evaluated at runtime and every cast call reads the same."
.language python
.mode steer
.scope include "**/*"

// Ruff TC006 (flake8-type-checking): the type argument of `typing.cast` (the first argument, or `typ=`) is
// not a string. Python evaluates it on every call; a string is not evaluated. Not in stubs. Ruff's fix quotes
// it (safe unless a comment is inside); no fix is offered here, since quoting must rewrite inner string quotes.
//   cast(int, 3.0)               ← TC006 at `int`
//   cast(typ=int, val=3.0)       ← TC006
//   t.cast(t.Literal["3.0"], x)  ← TC006, with `import typing as t`
//   cast("int", 3.0)             not reported
#include "python/misc2-typecheck.rr"
//   tc_cast_type(c, t), stub_file(d)

.violation TC006(at: node) code "TC006"
    "Quote the type expression passed to this `cast()` call, as in `cast(\"list[int]\", value)`."
    suppress ruff "TC006"
TC006(t) :- tc_cast_type(_, t), !str_literal(t), docof(t, d), !stub_file(d).
// A str literal, adjacent ones included; an f-string or bytes literal is not one (Ruff's is_string_literal_expr).
.decl str_literal(t: node)
str_literal(t) :- string_form(t, "str").
str_literal(t) :- kind(t, "concatenated_string"), count : { child(t, p, _), !string_form(p, "str") } = 0.
