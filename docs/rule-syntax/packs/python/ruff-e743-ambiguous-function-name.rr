.policy "ruff-e743-ambiguous-function-name" revision 2
.description "Avoid naming functions or methods l, I or O; in many fonts they are hard to tell apart from 1 and 0."
.language python
.mode steer
.scope include "**/*"

// Ruff E743 (pycodestyle): a function or method named `l`, `I` or `O`, letters that many fonts draw like 1 and 0.
//   def l(): ...                 ← E743 at `l`
//   class X: def O(self): ...    ← E743 at `O`
#include "python/pyflakes.rr"
//   ambiguous_name(x)  x is "l", "I" or "O"

.violation E743(at: node, x: symbol) code "E743"
    "Rename function `{x}` to a descriptive name; in many fonts it is easy to confuse with 1 or 0."
    suppress ruff "E743"
E743(nm, x) :- kind(f, "function_definition"), field(f, "name", nm), text(nm, x), ambiguous_name(x).
