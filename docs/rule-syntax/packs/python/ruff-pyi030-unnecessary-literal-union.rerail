.policy "ruff-pyi030-unnecessary-literal-union" revision 2
.description "Merge the Literal members of a union into a single Literal listing all the values; it means the same thing and is shorter."
.language python
.mode steer
.scope include "**/*"

// Ruff PYI030 (flake8-pyi), every file: a union with two or more `Literal[…]` members, which can be one
// Literal. Nested unions are flattened and reported once, at the outermost; `|` counts anywhere, at runtime too,
// and in string annotations.
//   x: Literal[1] | Literal[2] | None      ← PYI030: write `Literal[1, 2] | None`
// A "complex" string annotation, one with an escape (`"Literal[\"a\"] | …"`) or implicitly concatenated
// (`"Literal[1] " "| Literal[2]"`), Ruff parses with every node at the string's position, and it keys a name's
// binding by position: each name in it reads the binding of the last name Ruff resolved there. A head still has to
// be spelled `Literal` (or `….Literal`). So `"Literal[1] | Literal[2] | int" ""` is not reported (`Literal` reads
// the builtin `int`), and neither is any `Union[…]` of Literals in such a string.
#include "python/typing.rerail"

.violation PYI030(at: node) code "PYI030" "Merge the `Literal[...]` members of this union into one `Literal[...]`, keeping the other members, e.g. `Literal[1, 2] | str`; leave it alone if fewer than two members are `Literal[...]`."
    suppress ruff "PYI030"
PYI030(u) :- union_top(u), !parsed_in(u, _), count : { union_leaf(u, m), typing_subscript(m, "Literal") } >= 2.
PYI030(u) :- s_top(u), count : { s_leaf(u, m), s_head(m, "Literal") } >= 2.

// In a string annotation's parsed tree. typing's union relations do not read those trees, so these are their
// copies that do (each reaches `parsed_in`).
// s_head(m, x): m is `x[…]` for typing's x as Ruff reads it in the string.
.decl s_head(m: node, x: symbol)
s_head(m, x) :- parsed_in(m, s), !complex_str(s), typing_subscript(m, x).
// In a complex string: the head spelled `x` and the last resolved name typing's x, or spelled `….x` and the last
// resolved name the module typing.
s_head(m, x) :- parsed_in(m, s), complex_str(s), tsub(m, h, 0, _), last_res(s, l),
    (kind(h, "identifier"), text(h, x), typing_sym(l, x) ;
     attr_of(h, o, x), kind(o, "identifier"), pyi_sym(l, q), typing_mod(q)).
// complex_str(s): an annotation string Ruff parses as complex: implicitly concatenated, or with an escape (its
// text differs from its value; a raw string's never does).
.decl complex_str(s: node)
complex_str(s) :- parsed(s, "annotation", _), kind(s, "concatenated_string").
complex_str(s) :- parsed(s, "annotation", _), kind(s, "string"), match("(?s)[^rR\"']*[\"'].*\\\\.*", s).
// last_res(s, l): l is the last name in complex string s that resolves: to a binding of the file, or a builtin.
.decl last_res(s: node, l: node)
last_res(s, l) :- s_res(s, l), count : { s_res(s, n), n > l } = 0.
.decl s_res(s: node, n: node)
s_res(s, n) :- parsed_in(n, s), complex_str(s), ast_name(n, x), (look(n, x, sc), bound_in(sc, x) ; miss(n, x), builtin(x)).
// s_union(u): a `|` or a `Union[…]`; s_part(u, m) its members; s_top(u) one in no other; s_leaf(u, m) the members
// of top union u that are not unions.
.decl s_union(u: node)
s_union(u) :- parsed_in(u, _), kind(u, "binary_operator"), op(u, "|").
s_union(u) :- s_head(u, "Union").
.decl s_part(u: node, m: node)
s_part(u, m) :- s_union(u), kind(u, "binary_operator"), (field(u, "left", x) ; field(u, "right", x)), s_unparen(x, m).
s_part(u, m) :- s_union(u), s_head(u, "Union"), tsub(u, _, _, m).
.decl s_unparen(x: node, m: node)
s_unparen(x, x) :- parsed_in(x, _), !kind(x, "parenthesized_expression").
s_unparen(x, m) :- parsed_in(x, _), kind(x, "parenthesized_expression"), child(x, y, _), !kind(y, "comment"),
    s_unparen(y, m).
.decl s_top(u: node)
s_top(u) :- s_union(u), !s_nested(u).
.decl s_nested(u: node)
s_nested(u) :- s_part(_, u), s_union(u).
.decl s_leaf(u: node, m: node)
s_leaf(u, m) :- s_top(u), s_down(u, m).
.decl s_down(x: node, m: node)
s_down(x, m) :- s_union(x), s_part(x, m), !s_union(m).
s_down(x, m) :- s_union(x), s_part(x, y), s_union(y), s_down(y, m).
