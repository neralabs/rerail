.policy "ruff-pth115-os-readlink" revision 2
.description "Use Path.readlink() instead of os.readlink(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH115 (flake8-use-pathlib): a call of `os.readlink`, however it is imported, with exactly one argument:
// the `path` parameter, by position or by keyword. pathlib's form is `Path(p).readlink()`.
// `Path.readlink` is new in Python 3.9, so the rule needs a `pythonVersion` of 3.9 or later (default 3.10).
// Reported at the callee.
//   os.readlink(p)                  ← PTH115
//   from os import readlink
//   readlink(path=p)                ← PTH115
//   os.readlink(p, dir_fd=None)     not reported: two arguments
#include "python/pathlib.rr"
#include "python/upgrade.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)
//   targets(m)   the target is Python 3.m or later (python/upgrade)

.violation PTH115(at: node, s: node) code "PTH115"
    "Use `Path({s}).readlink()` from pathlib instead of `os.readlink({s})`; it returns a `Path`, not a string, so adjust code that uses the result, and leave bytes paths alone."
    suppress ruff "PTH115"
PTH115(f, a) :- single_arg(_, "os.readlink", "path", f, a), targets(9).
