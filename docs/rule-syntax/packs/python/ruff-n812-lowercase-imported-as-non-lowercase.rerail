.policy "ruff-n812-lowercase-imported-as-non-lowercase" revision 3
.description "Keep the alias of an imported lowercase name lowercase; an uppercase alias makes readers mistake a function or module for a class or constant."
.language python
.mode steer
.scope include "**/*"

// Ruff N812 (pep8-naming): a lowercase name imported under an alias with a letter that is not lowercase. Names
// are read NFKC-normalised and cased by Unicode (`ᴬbc` is "Abc"; `日本` has no lowercase letter). Exempt when the
// name or the alias matches `pep8-naming.ignore-names`.
//   from mod import lowercase as Lowercase    ← N812
//   from mod import foo as 日本                ← N812
//   import os.path as osp                      not reported
#include "python/python-19.rerail"

.violation N812(at: node, x: symbol, a: symbol) code "N812"
    "Use a lowercase alias instead of `{a}` for `{x}` and update its uses; leave it if `{x}` is really a class or constant despite its lowercase name."
    suppress ruff "N812"
N812(i, x, a) :- alias_import(i, x0, a0), x = @nfkc(x0), a = @nfkc(a0), pep8_cased_lower(i, x), !pep8_lower(i, a),
    !pep8_ignored(i, x), !pep8_ignored(i, a).

.test alias_case_uses_the_linters_unicode_version exactly
    .fixture "app/aliases.py" ```
        from mod import foo as lower
        from mod import foo as Lower
        from mod import foo as ˤx
        from mod import foo as 日本
        from mod import foo as ǅx
        ```
    .expect N812 at "app/aliases.py":2
    .expect N812 at "app/aliases.py":3
    .expect N812 at "app/aliases.py":4
    .expect N812 at "app/aliases.py":5
.end
