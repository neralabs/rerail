.policy "ruff-f524-string-dot-format-missing-arguments" revision 2
.description "Pass an argument for every placeholder in a str.format() string; a missing one raises IndexError or KeyError at runtime."
.language python
.mode steer
.scope include "**/*"

// Ruff F524 (pyflakes): `S.format(…)` lacks an argument a field of S needs: an index `{i}` or an automatic `{}`
// past the positional arguments, or a `{name}` with no such keyword. Python raises IndexError or KeyError. Not
// checked when the call has `*args` or `**kwargs`.
//   "{} {}".format(1)             ← F524
//   "{bar}".format()              ← F524
#include "python/pyflakes-format.rerail"
//   format_call(c, v), brace_auto(c, n), brace_index(c, i), brace_keyword(c, x), call_npos(c, n), call_kw(c, x, a)

.violation F524(at: node) code "F524" "`.format` call is missing argument(s) for placeholder(s)"
    suppress ruff "F524"
F524(c) :- open_call(c, n), brace_auto(c, a), a > n.
F524(c) :- open_call(c, n), brace_index(c, i), i >= n.
F524(c) :- open_call(c, _), brace_keyword(c, x), !call_kw(c, x, _).
// open_call(c, n): c formats its string with n positional arguments and no `*args` or `**kwargs`.
.decl open_call(c: node, n: number)
open_call(c, n) :- format_call(c, _), brace_ok(c), !call_star(c), !call_kwsplat(c), call_npos(c, n).
