.policy "ruff-try300-try-consider-else" revision 2
.description "Move the final return of a try body into an else block; code that runs only on success should not sit under the handlers' protection."
.language python
.mode steer
.scope include "**/*"

// Ruff TRY300 (tryceratops): a try body of two or more statements that ends in a `return`, in a try with
// handlers and no `else`. The return belongs in `else`, out of the handlers' reach. A return value that may have
// a side effect (Ruff's contains_effect: a call, a subscript, an await, a comprehension, a walrus, an operator on
// a non-literal) is left alone.
//   try:
//       x = f()
//       return x               ← TRY300
//   except E: ...
//
//   try:
//       x = f()
//       return g(x)            not reported: g(x) may raise E
//   except E: ...
#include "python/exceptions.rr"
//   exc_handler(t, x), unparen(e, m)

.violation TRY300(at: node) code "TRY300"
    "Move this `return` into an `else` clause after the handlers so the `try` body holds only the code the handlers guard."
    suppress ruff "TRY300"
TRY300(r) :- exc_handler(t, _), !has_else(t), field(t, "body", b),
    count : { child(b, s, _), !kind(s, "comment") } > 1,
    child(b, r, i), kind(r, "return_statement"), count : { child(b, s, j), j > i, !kind(s, "comment") } = 0,
    !effect_return(r).
.decl effect_return(r: node)
effect_return(r) :- kind(r, "return_statement"), child(r, v, 0), may_effect(v).

.decl has_else(t: node)  // the try's own else clause (not one of a nested if or loop)
has_else(t) :- child(t, e, _), kind(e, "else_clause").
// may_effect(v): v, or something in it, may have an effect (SideEffect::Present).
.decl may_effect(v: node)
may_effect(v) :- child(_, v, _), effect_at(v).
may_effect(v) :- child(_, v, _), has(v, n, effect_node), effect_at(n).
.decl effect_node(k: symbol)
effect_node("call"). effect_node("binary_operator"). effect_node("named_expression"). effect_node("await").
effect_node("list_comprehension"). effect_node("set_comprehension"). effect_node("dictionary_comprehension").
effect_node("generator_expression"). effect_node("subscript"). effect_node("yield").
.decl effect_at(n: node)
effect_at(n) :- kind(n, k), effect_node(k), k != "call", k != "binary_operator".
// A call has an effect, except `list()`, `tuple()`, `set()`, `dict()` or `frozenset()` of the builtin.
effect_at(c) :- kind(c, "call"), !empty_init(c).
.decl empty_init(c: node)
empty_init(c) :- exc_no_args(c), exc_call(c, q), (q = "builtins.list" ; q = "builtins.tuple" ; q = "builtins.set" ;
    q = "builtins.dict" ; q = "builtins.frozenset"), field(c, "function", f), kind(f, "identifier").
// An operator has an effect unless both operands are literals or displays (`__add__` may run anything).
effect_at(o) :- kind(o, "binary_operator"), (field(o, "left", a) ; field(o, "right", a)), unparen(a, m),
    kind(m, k), !safe_operand(k).
.decl safe_operand(k: symbol)
safe_operand("string"). safe_operand("concatenated_string"). safe_operand("integer"). safe_operand("float").
safe_operand("true"). safe_operand("false"). safe_operand("none"). safe_operand("ellipsis"). safe_operand("list").
safe_operand("tuple"). safe_operand("set"). safe_operand("dictionary"). safe_operand("list_comprehension").
safe_operand("set_comprehension"). safe_operand("dictionary_comprehension").
