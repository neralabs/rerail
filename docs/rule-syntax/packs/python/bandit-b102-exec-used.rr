.policy "bandit-b102-exec-used" revision 3
.description "Avoid exec() calls in Python, including through import aliases; running text as code is dangerous unless that text is fully trusted."
.language python
.mode steer
.scope include "**/*.py"
// Bandit's B102 (exec_used): a call whose qualified name, as Bandit reads it, is exactly "exec".
//   exec(code)                           B102
//   (exec)(code)                         B102: `ast` has no parentheses
//   from . import exec as run; run(c)    B102: a relative import without a module maps run to "exec"
//   from builtins import exec; exec(c)   not reported: Bandit reads "builtins.exec"
//   def f(exec): exec(c)                 B102: Bandit does not see local bindings

#include "python/security.rr"   // qual_call: the callee's name as Bandit reads it

.violation B102(at: node) code "B102"
    "Replace this exec call with code that performs the intended operation directly, unless the executed text is fully trusted."
    suppress nosec "B102"
B102(c) :- qual_call(c, "exec").
