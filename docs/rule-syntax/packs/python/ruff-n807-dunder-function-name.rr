.policy "ruff-n807-dunder-function-name" revision 2
.description "Don't name a function with leading and trailing double underscores; that naming is reserved for Python's special methods."
.language python
.mode steer
.scope include "**/*"

// Ruff N807 (pep8-naming): a function outside a class named `__x__`. Module-level `__getattr__` and `__dir__`
// (PEP 562) are allowed, as are names matching `pep8-naming.ignore-names`.
//   def __bad__(): ...           ← N807
//   class C:
//       def __eq__(self, o): ... not reported: a method
#include "python/naming.rr"

.violation N807(at: node, x: symbol) code "N807"
    "Rename `{x}` without the leading and trailing double underscores and update its callers; only a method of a class should use such a name."
    suppress ruff "N807"
N807(nm, x) :- kind(f, "function_definition"), field(f, "name", nm), text(nm, x), dunder(x),
    nearest(f, s, scope), !kind(s, "class_definition"), !pep562(s, x), !naming_ignored(x).
.decl pep562(s: node, x: symbol)  // module-level __getattr__ / __dir__
pep562(s, x) :- kind(s, "module"), (x = "__getattr__" ; x = "__dir__").
