.policy "ruff-d406-missing-new-line-after-section-name" revision 2
.description "End a NumPy-style section name at the end of its line, with no colon or trailing whitespace after it."
.language python
.mode steer
.scope include "**/*"

// Ruff D406 (pydocstyle): in a NumPy-style docstring, a section header with anything after the name on its
// line: a colon, or trailing spaces. Google-style docstrings (by `pydocstyle.convention`, or by their own
// sections when it is unset) are not checked.
//   Returns:                 ← D406
//   -------
#include "python/docstrings-sections.rerail"
#include "python/docstrings-ruff-reads.rerail"

.violation D406(at: span, k: symbol) code "D406"
    "Remove the colon or trailing whitespace after the section name `{k}` so the line holds only the name."
    suppress ruff "D406"
D406(at, v) :- numpy_doc(s), ruff_doc(s), doc_sec(s, "numpy", i), head_line(s, i, v, _, _, suf), suf != "",
    doc_at(s, i, at).
// numpy_doc(s): s is read in the NumPy convention: by the option, or, unset, by its sections. This is the
// library's doc_style but for its tie: `tie` binds g twice (`g = count …, g = count …`), which the engine does not
// read as a test, so every docstring with a Google section counts as a tie and is NumPy too (NOTES). A Google one
// is not checked:
//   """
//   TODO:              one Google section, no NumPy one: Google, no D406
//       -
//   """
.decl numpy_doc(s: node)
numpy_doc(s) :- doc_checked(s), option("pydocstyle.convention", "numpy").
numpy_doc(s) :- doc_checked(s), !option("pydocstyle.convention", "google"), !option("pydocstyle.convention", "numpy"),
    numpy_params(s).
numpy_doc(s) :- doc_checked(s), !option("pydocstyle.convention", "google"), !option("pydocstyle.convention", "numpy"),
    !numpy_params(s), !google_args(s), g = count : { doc_sec(s, "google", _) }, n = count : { doc_sec(s, "numpy", _) },
    (n > g ; n = g, !tie_by(s, "google")).
