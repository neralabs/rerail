.policy "ruff-pth108-os-unlink" revision 2
.description "Use Path.unlink() instead of os.unlink(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH108 (flake8-use-pathlib): a call of `os.unlink`, however it is imported, with exactly one argument:
// the `path` parameter, by position or by keyword. pathlib's form is `Path(p).unlink()`.
// Reported at the callee.
//   os.unlink(p)                    ← PTH108
//   from os import unlink
//   unlink(path=p)                  ← PTH108
//   os.unlink(p, dir_fd=3)          not reported: two arguments
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH108(at: node, s: node) code "PTH108"
    "Use `Path({s}).unlink()` from pathlib instead of `os.unlink({s})`; leave it where the argument is a bytes path."
    suppress ruff "PTH108"
PTH108(f, a) :- single_arg(_, "os.unlink", "path", f, a).
