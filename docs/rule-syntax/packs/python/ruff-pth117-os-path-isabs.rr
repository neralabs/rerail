.policy "ruff-pth117-os-path-isabs" revision 2
.description "Use Path.is_absolute() instead of os.path.isabs(); path objects read better than string-based os.path calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH117 (flake8-use-pathlib): a call of `os.path.isabs`, however it is imported, with exactly one argument:
// the `s` parameter, by position or by keyword. pathlib's form is `Path(p).is_absolute()`.
// Reported at the callee.
//   os.path.isabs(p)                ← PTH117
//   from os.path import isabs
//   isabs(s=p)                      ← PTH117
//   os.path.isabs(path=p)           not reported: the parameter is `s`
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH117(at: node, s: node) code "PTH117"
    "Use `Path({s}).is_absolute()` from pathlib instead of `os.path.isabs({s})`; leave it where the argument is a bytes path."
    suppress ruff "PTH117"
PTH117(f, a) :- single_arg(_, "os.path.isabs", "s", f, a).
