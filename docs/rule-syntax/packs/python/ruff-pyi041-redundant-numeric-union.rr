.policy "ruff-pyi041-redundant-numeric-union" revision 2
.description "Don't combine int, float and complex in a parameter annotation union; a float parameter already accepts ints and a complex parameter accepts both."
.language python
.mode steer
.scope include "**/*"

// Ruff PYI041 (flake8-pyi), every file: a parameter annotated with a union of `int` and `float`, or of either
// with `complex`. A float parameter accepts ints, and a complex one both (PEP 484's numeric tower). Only a union
// that is the whole annotation is checked: `list[int | float]` is not. Return annotations are not checked.
//   def f(x: int | float): ...              ← PYI041: write `float`
//   def g(x: int | float | complex): ...    ← PYI041: write `complex`
#include "python/typing.rr"

.violation PYI041(at: node, msg: symbol) code "PYI041" "{msg}"
    suppress ruff "PYI041"
PYI041(u, "Drop the `int` and `float` members from this parameter union and keep `complex`, which already accepts both.") :-
    param_union(u), has_num(u, "complex"), (has_num(u, "int") ; has_num(u, "float")).
PYI041(u, "Remove `int` from this parameter union where `float` is also listed; `float` already accepts ints.") :-
    param_union(u), !has_num(u, "complex"), has_num(u, "int"), has_num(u, "float").
// param_union(u): a def parameter's annotation is the union u.
.decl param_union(u: node)
param_union(u) :- kind(f, "function_definition"), sig_param(f, _, _, _, _, a, _), !unset(a), type_bare(a, u), union_top(u).
.decl has_num(u: node, x: symbol)  // the builtin x is a member
has_num(u, x) :- union_leaf(u, m), sym_of(m, q), split_dot(q, "builtins", x).
