.policy "ruff-int003-printf-in-get-text-func-call" revision 2
.description "Pass a constant template to a gettext call and format the translated result; a printf-style formatted string is evaluated before the catalog lookup."
.language python
.mode steer
.scope include "**/*"

// Ruff INT003 (flake8-gettext): a translation call whose first positional argument is `<str literal> % …`. The text is
// formatted before the catalog lookup, so the lookup is for the formatted string, which no catalog has.
// Translation calls: a plain name in option `flake8-gettext.function-names` (default `_`, `gettext`, `ngettext`; plus
// `extend-function-names`), `builtins.<one of them>`, and gettext.gettext / gettext.ngettext through imports.
// Ruff checks ngettext's second argument only in preview.
//   _("Hello, %s!" % name)                ← INT003
//   _(template % name)                     not reported: the left side is not a literal
//   _("Hello, %s!") % name                 not reported: translated first
#include "python/misc2-messages.rr"

.violation INT003(at: node) code "INT003"
    "Translate the template, then format the result: `_(\"Hello, %s!\") % name`, not `_(\"Hello, %s!\" % name)`. Leave it if the callee is not a translation function or the text is a computed catalog key."
    suppress ruff "INT003"
INT003(a) :- msg_gettext(c), msg_arg(c, 0, a), msg_form(a, "printf").
