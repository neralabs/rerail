.policy "ruff-pyi057-byte-string-usage" revision 3
.description "Avoid ByteString from typing and collections.abc; it is deprecated and unclear, so use Buffer or a union of bytes types instead."
.language python
.mode steer
.scope include "**/*"

// Ruff PYI057 (flake8-pyi), every file: `ByteString` from typing or collections.abc, deprecated since 3.9 and
// removed in 3.14. Ruff reports the import of the name, and each dotted use (`typing.ByteString`, also inside a
// string annotation, and in a match pattern: a value, a class, a key, or the head of a longer dotted name); a
// bare `ByteString` after the import is not reported again. The module is resolved through the file's imports.
//   from typing import ByteString          ← PYI057 at `ByteString`
//   def f(x: collections.abc.ByteString)   ← PYI057
//   case t.ByteString.x: ...               ← PYI057, after `import typing as t`
#include "python/typing.rerail"

.violation PYI057(at: node) code "PYI057" "Use `collections.abc.Buffer` (`typing_extensions.Buffer` before Python 3.12) or `bytes | bytearray | memoryview` instead of `ByteString`; it is deprecated and has unclear semantics."
    suppress ruff "PYI057"
PYI057(a) :- kind(i, "import_from_statement"), from_module_raw(i, m), bytestring_module(m), field(i, "name", a),
    (kind(a, "dotted_name"), text(a, "ByteString") ; kind(a, "aliased_import"), field(a, "name", n), text(n, "ByteString")).
PYI057(e) :- kind(e, "attribute"), pyi_sym(e, q), split_dot(q, m, "ByteString"), bytestring_module(m).
// A match pattern's `typing.ByteString` is a dotted name, not an attribute: resolve its first segment, then
// add the others one by one.
PYI057(d) :- pattern_sym(d, i, q), i > 0, split_dot(q, m, "ByteString"), bytestring_module(m).
.decl pattern_sym(d: node, i: number, q: symbol)  // the first i+1 segments of pattern name d name q
pattern_sym(d, 0, q) :- kind(d, "dotted_name"), inside(d, _, "case_clause"), child(d, c, 0), pyi_sym(c, q).
pattern_sym(d, i, @dot(q, x)) :- pattern_sym(d, h, q), i = h + 1, child(d, c, i), text(c, x).
.decl bytestring_module(m: symbol)
bytestring_module("typing"). bytestring_module("collections.abc").
