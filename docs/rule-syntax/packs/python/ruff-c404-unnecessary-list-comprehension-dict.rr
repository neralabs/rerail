.policy "ruff-c404-unnecessary-list-comprehension-dict" revision 2
.description "Write a dict comprehension instead of passing a list comprehension of pairs to dict(); it skips building a throwaway list."
.language python
.mode steer
.scope include "**/*"

// Ruff C404 (flake8-comprehensions): `dict(…)` of the builtin dict, whose one argument is a list
// comprehension of two-element tuples. Ruff counts the elements only, so `(k, *v)` counts too. Its fix is
// unsafe; none here.
//   dict([(k, v) for k, v in pairs])   ← C404: {k: v for k, v in pairs}
//   dict([(k, v, w) for … ])           not reported
#include "python/comprehensions.rr"
//   c4_call(c, x), c4_only(c, a), c4_comp(e, k), c4_elt(e, x)

.violation C404(at: node) code "C404"
    "Rewrite `dict([(k, v) for ...])` as the dict comprehension `{{k: v for ...}}`; check the result when the pair unpacks with `*`, as in `(k, *v)`."
    suppress ruff "C404"
C404(c) :- c4_call(c, "dict"), c4_only(c, l), c4_comp(l, "list"), c4_elt(l, x), kind(x, "tuple"),
    count : { child(x, i, _), !kind(i, "comment") } = 2.
