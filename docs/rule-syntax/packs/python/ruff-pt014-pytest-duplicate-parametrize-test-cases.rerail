.policy "ruff-pt014-pytest-duplicate-parametrize-test-cases" revision 2
.description "Remove duplicate test cases from pytest parametrize values; a repeated case runs the same test twice and covers nothing new."
.language python
.mode steer
.scope include "**/*"

// Ruff PT014 (flake8-pytest-style): a parametrize value list or tuple with the same case twice. Each repeat is
// reported, compared as Ruff's ComparableExpr does (python/compare's cmp_same: parentheses, spacing, comments and
// quotes aside; "ab" is "a" "b" and 1.0 is 1.00, but b"a" and f"a" are not "a"). One place where parentheses do
// count: Ruff's parser makes `a and b and c` one BoolOp of three values and `(a and b) and c` a BoolOp in a BoolOp.
//   @pytest.mark.parametrize("x", [1, 1, 2])     ← PT014 at the second 1
//   @pytest.mark.parametrize("x", [(1, 2), (1,2)])    ← PT014
//   @pytest.mark.parametrize("x", [a and b and c, (a and b) and c])    not reported
#include "python/python-23.rerail"
//   exc_call(c, q), pt_argument(c, k, i, a): a line continuation is no argument
#include "python/compare.rerail"
//   cmp_same(a, b), cmp_same_ask(a, b), and inside it same_pair(x, y), same_child(x, i, c)

.violation PT014(at: node, i: number) code "PT014"
    "Remove this repeat of case {i} of the parametrize values, or fix its values if it was meant to differ; keep it when the element is a call that yields a new object each time."
    suppress ruff "PT014"
PT014(m, i) :- repeat(b, _), i = min k : { repeat(b, k) }, unparen(b, m).
.decl repeat(b: node, i: number)  // element b repeats element i of the same values
repeat(b, i) :- case(v, a, i), case(v, b, j), i < j, cmp_same(a, b), !bool_split(a, b).

.decl case(v: node, e: node, i: number)  // e is the i-th element of the values argument v
case(v, e, i) :- exc_call(c, "pytest.mark.parametrize"), pt_argument(c, "argvalues", 1, v),
    (kind(v, "list") ; kind(v, "tuple")), child(v, e, j), !kind(e, "comment"),
    i = count : { child(v, x, k), k < j, !kind(x, "comment") }.
cmp_same_ask(a, b) :- case(v, a, i), case(v, b, j), i < j.

// bool_split(a, b): somewhere in cases a and b, matching `and` (or `or`) operators have at one position an operand
// with the same operator, written in parentheses on one side only: one side's chain goes on, the other's nests.
.decl bool_split(a: node, b: node)
bool_split(a, b) :- cmp_same_ask(a, b), same_pair(x, y), (unparen(a, x) ; within(x, a)), (unparen(b, y) ; within(y, b)),
    same_child(x, i, c), same_child(y, i, d), (bool_nested(x, c), bool_chained(y, d) ; bool_chained(x, c), bool_nested(y, d)).
.decl bool_chained(x: node, c: node)  // c is x's operand `a and b` in `a and b and c`
bool_chained(x, c) :- bool_same(x, c), kind(c, "boolean_operator").
.decl bool_nested(x: node, c: node)   // c is x's operand `(a and b)` in `(a and b) and c`
bool_nested(x, c) :- bool_same(x, c), kind(c, "parenthesized_expression").
.decl bool_same(x: node, c: node)     // operand c of `and`/`or` x is, parentheses off, the same operator
bool_same(x, c) :- kind(x, "boolean_operator"), op(x, t), child(x, c, _), unparen(c, m), kind(m, "boolean_operator"),
    op(m, t).
