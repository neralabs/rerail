.policy "bandit-b105-hardcoded-password-string" revision 3
.description "Don't assign or compare a string literal to a variable, attribute, or key named like a password, token, or secret; read credentials from the environment or a secret store."
.language python
.mode steer
.scope include "**/*.py", "**/*.pyi"
.scope exclude "**/node_modules/**", "**/dist/**", "**/build/**", "**/out/**", "**/.next/**", "**/coverage/**", "**/vendor/**", "**/.venv/**", "**/.yarn/**", "**/generated/**", "**/__generated__/**", "**/*.generated.*", "**/*.gen.*", "**/*.min.js"
// Bandit 1.9.4's B105 (hardcoded_password_string). It looks at each str constant (not bytes, not an f- or t-string;
// adjacent literals are one) by its parent in CPython's ast, and reports at the constant. A name is a candidate
// when it is, or has as an `_`-separated part, password (pas+wo?r?d), pass, passphrase, pwd, token or secret(e),
// in any case: `db_password`, `TOKEN`, `api_token_v2`; not `tokens` or `passwords`.
//   password = "hunter2"              the value of an Assign with a candidate target (a Name, or an attribute's attr)
//   cfg = {"api_token": None}         a candidate key of a dict whose value is any constant: reported at the key
//   env["secret"] = "x"               a candidate key subscripting a target of an Assign whose value is a str
//   if self.pwd == "admin": …         a str compared with a candidate on the left, when the first comparator is a str
// Annotated assignments (`password: str = "x"`), `+=`, tuple targets and values, and parenthesised parts are seen
// as CPython sees them: the first three are not reported, parentheses change nothing.

#include "python/ast.rerail"   // assign_target, assign_value, unparen, plain_str_node, plain_str, ast_constant

.violation B105(at: node) code "B105"
    "Possible hard-coded password. Read it from the environment or a secret store."
    suppress nosec "B105"
.violation B105_COMPARE(at: node) code "B105"
    "Compare against a credential read from the environment or a secret store instead of a string literal."
    suppress nosec "B105"

// candidate(x): Bandit's RE_CANDIDATES.search(x), `(^W$|_W_|^W_|_W$)` ignoring case. Python's `$` also matches before
// a final newline, which only a key's value can hold.
.decl candidate(x: symbol)
candidate(x) :- name_text(x),
    match("(?is)(?:.*_)?(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:_.*|\n)?", x).
.decl name_text(x: symbol)  // the texts candidate tests: names and attributes in targets and comparisons, keys
name_text(x) :- assign_target(_, t), unparen(t, u), target_name(u, x).
name_text(x) :- kind(c, "comparison_operator"), child(c, l, 0), unparen(l, u), target_name(u, x).
name_text(x) :- key_str(s), plain_str(s, x).
// target_name(t, x): t is a Name x, or an Attribute whose attr is x.
.decl target_name(t: node, x: symbol)
target_name(t, x) :- kind(t, "identifier"), text(t, x).
target_name(t, x) :- kind(t, "attribute"), field(t, "attribute", n), text(n, x).
// assign(a): a plain Assign, `a = b = v` one statement; not `x: T = v`.
.decl assign(a: node)
assign(a) :- assign_value(a, _), !field(a, "type", _).
.decl str_value(a: node, s: node)  // Assign a's value is the str constant s
str_value(a, s) :- assign(a), assign_value(a, v), unparen(v, s), plain_str_node(s).

// password = "x", a.token = "x", t = password = "x"
B105(s) :- str_value(a, s), assign_target(a, t), unparen(t, u), target_name(u, x), candidate(x).

// {"password": "x"}: a dict display's key, not a comprehension's; the value any constant.
.decl key_str(s: node)
key_str(s) :- kind(d, "dictionary"), child(d, p, _), kind(p, "pair"), field(p, "key", k), unparen(k, s),
    plain_str_node(s).
key_str(s) :- kind(sub, "subscript"), subscript_key(sub, s).
B105(s) :- kind(d, "dictionary"), child(d, p, _), kind(p, "pair"), field(p, "key", k), unparen(k, s),
    plain_str_node(s), plain_str(s, x), candidate(x), field(p, "value", v), unparen(v, w), ast_constant(w).

// d["password"] = "x": the key is the subscript's whole slice (`d["a", "password"]` and `d["password",]` subscript a
// Tuple; the tape keeps no `,` in a subscript, so the trailing one is read off its text).
.decl subscript_key(sub: node, s: node)
subscript_key(sub, s) :- kind(sub, "subscript"), field(sub, "subscript", k), count : { field(sub, "subscript", _) } = 1,
    node_text(sub, t), !match("(?s).*,\\s*\\]", t), unparen(k, s), plain_str_node(s).
B105(s) :- subscript_key(sub, s), plain_str(s, x), candidate(x), assign_target(a, t), unparen(t, sub),
    str_value(a, _).

// password == "x", self.token != "x" in xs: every str operand once the left is a candidate and the first
// comparator a str.
B105_COMPARE(s) :- kind(c, "comparison_operator"), child(c, l, 0), unparen(l, u), target_name(u, x), candidate(x),
    child(c, r, 1), unparen(r, r0), plain_str_node(r0), child(c, o, i), i > 0, unparen(o, s), plain_str_node(s).
