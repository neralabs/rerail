.policy "ruff-pth106-os-rmdir" revision 3
.description "Use Path.rmdir() instead of os.rmdir(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH106 (flake8-use-pathlib): a call of `os.rmdir`, however it is imported, with exactly one argument:
// the `path` parameter, by position or by keyword. pathlib's form is `Path(p).rmdir()`.
// Reported at the callee.
//   os.rmdir(p)                     ← PTH106
//   from os import rmdir
//   rmdir(path=p)                   ← PTH106
//   os.rmdir(p, dir_fd=None)        not reported: two arguments
#include "python/python-21.rerail"
//   pth_checked_single_arg(c, q, x, f, a)   checked c calls q with one argument a for parameter x; f the callee

.violation PTH106(at: node, s: node) code "PTH106"
    "Use `Path({s}).rmdir()` from pathlib instead of `os.rmdir({s})`; leave it where the argument is a bytes path."
    suppress ruff "PTH106"
PTH106(f, a) :- pth_checked_single_arg(_, "os.rmdir", "path", f, a).

// Tests (decision 0130), from the python-21 review: each expects exactly what Ruff 0.17.6 reports.
// S1 `cast` strings, S2 escaped strings and S4 forward references in a function are reported; of S3's implicit
// concatenations only the call whose last name is its own head (`os.getcwd(" ")`) is; S5's function body runs after
// the module rebinds the import, so nothing there is.
.test review_shared exactly
    .fixture "shared.py" ```
        import os
        import py
        from typing import cast
        p = "x"

        # S1
        c101 = cast("os.chmod(p, 0o644)", p)
        c106 = cast("os.rmdir(p)", p)
        c107 = cast("os.remove(p)", p)
        c108 = cast("os.unlink(p)", p)
        c109 = cast("os.getcwd()", p)
        c110 = cast("os.path.exists(p)", p)
        c111 = cast("os.path.expanduser(p)", p)
        c124 = cast("py.path.local(p)", p)

        # S2
        e101: "os.chmod('a\\tb', 0o644)"
        e106: "os.rmdir('a\\tb')"
        e107: "os.remove('a\\tb')"
        e108: "os.unlink('a\\tb')"
        e109: "(os.getcwd(), 'a\\tb')"
        e110: "os.path.exists('a\\tb')"
        e111: "os.path.expanduser('a\\tb')"
        e124: "py.path.local('a\\tb')"

        # S3 (the all-rule rerun is shown separately below)
        s101: "os.chmod(" "p, 0o644)"
        s106: "os.rmdir(" "p)"
        s107: "os.remove(" "p)"
        s108: "os.unlink(" "p)"
        s109: "os.getcwd(" ")"
        s110: "os.path.exists(" "p)"
        s111: "os.path.expanduser(" "p)"
        s124: "py.path.local(" "p)"

        # S4
        def forward_scope():
            os = None
            py = None
            f101: "os.chmod(p, 0o644)"
            f106: "os.rmdir(p)"
            f107: "os.remove(p)"
            f108: "os.unlink(p)"
            f109: "os.getcwd()"
            f110: "os.path.exists(p)"
            f111: "os.path.expanduser(p)"
            f124: "py.path.local(p)"

        # S5
        import os as late_os
        import py as late_py
        def deferred_scope():
            late_os.chmod(p, 0o644)
            late_os.rmdir(p)
            late_os.remove(p)
            late_os.unlink(p)
            late_os.getcwd()
            late_os.path.exists(p)
            late_os.path.expanduser(p)
            late_py.path.local(p)
        late_os = None
        late_py = None
        ```
    .expect PTH106 at "shared.py":8
    .expect PTH106 at "shared.py":18
    .expect PTH106 at "shared.py":41
.end

// Implicit concatenations whose last name is not the callee's head: Ruff reports none.
.test review_concat exactly
    .fixture "concat.py" ```
        import os
        import py
        p = "x"
        s101: "os.chmod(" "p, 0o644)"
        s106: "os.rmdir(" "p)"
        s107: "os.remove(" "p)"
        s108: "os.unlink(" "p)"
        s109: "os.getcwd(" "p)"
        s110: "os.path.exists(" "p)"
        s111: "os.path.expanduser(" "p)"
        s124: "py.path.local(" "p)"
        ```
.end

// Complex strings (concatenated or escaped): the callee's head resolves as the last name of the call Ruff resolved.
.test complex_strings exactly
    .fixture "complex_strings.py" ```
        import os
        p = "x"
        a1: "os.rmdir(" "p)"
        a2: "os.rmdir(" "'x')"
        a3: "os.rmdir(" "1)"
        a4: "os.rmdir(p" ")"
        a5: "os.rmdir" "(p)"
        a6: "os.rmdir(p)" ""
        a7: "" "os.rmdir(p)"
        a8: "os.rmdir(p)" " "
        a9: "os.getcwd(" ")"
        a10: "os.getcwd(" "p)"
        a11: "os.getcwd(p" ")"
        a12: "os.getcwd()" "  "
        a13: "os." "getcwd()"
        a14: "os.rmdir(q)" ""
        a15: "os.rmdir('a\\tb')"
        a16: "os.rmdir(p, '\\t')"
        a17: "os.rmdir(p)  # \\t"
        a18: "os.chmod(" "p, 1)"
        a19: "os.chmod(p, " "1)"
        a20: "os.chmod(p, 1" ")"
        a21: "os.chmod(p, 1)" ""
        ```
    .expect PTH106 at "complex_strings.py":4
    .expect PTH106 at "complex_strings.py":5
    .expect PTH106 at "complex_strings.py":16
    .expect PTH106 at "complex_strings.py":17
.end

// Complex strings: a builtin is a resolved name, an undefined one is not; names after the call do not count.
.test complex_string_names exactly
    .fixture "complex_string_names.py" ```
        import os
        import typing
        p = "x"
        b1: "os.rmdir(os)" ""
        b2: "os.rmdir(int)" ""
        b3: "os.rmdir(str(1))" ""
        b4: "os.rmdir(p.x)" ""
        b5: "os.rmdir(-1)" ""
        b6: "os.rmdir([1])" ""
        b7: "os.rmdir('a' + 'b')" ""
        b8: "list[os.rmdir(1)]" ""
        b9: "list[p, os.rmdir(1)]" ""
        b10: "os.rmdir(1) or p" ""
        b11: "os.rmdir(p) or '\\t'"
        b12: "os.rmdir(typing)" ""
        b13: "os.chmod('x', 1)" ""
        b14: "os.chmod('x', p)" ""
        def f(q):
            c1: "os.rmdir(q)" ""
        x = typing.cast("os.rmdir(p)" "", 1)
        ```
    .expect PTH106 at "complex_string_names.py":4
    .expect PTH106 at "complex_string_names.py":8
    .expect PTH106 at "complex_string_names.py":9
    .expect PTH106 at "complex_string_names.py":10
    .expect PTH106 at "complex_string_names.py":11
    .expect PTH106 at "complex_string_names.py":12
    .expect PTH106 at "complex_string_names.py":13
.end

// Strings in a function resolve against the module first; plain annotations there read the function's names.
.test forward_references exactly
    .fixture "forward_references.py" ```
        import os
        p = "x"
        def f1():
            os = None
            x: "os.rmdir(p)"
        def f2():
            import shutil as os
            x: "os.rmdir(p)"
        def f3():
            os = None
            x: os.rmdir(p)
        def f4():
            os = None
            x: "os.rmdir(p)" = 1
        def f5():
            import os as o2
            x: "o2.rmdir(p)"
        def f6():
            o3 = os
            x: "o3.rmdir(p)"
        class C:
            os = None
            x: "os.rmdir(p)"
        def f7(os):
            x: "os.rmdir(p)"
        def f8():
            x: "os.rmdir(p)"
            os = None
        ```
    .expect PTH106 at "forward_references.py":5
    .expect PTH106 at "forward_references.py":8
    .expect PTH106 at "forward_references.py":14
    .expect PTH106 at "forward_references.py":17
    .expect PTH106 at "forward_references.py":23
    .expect PTH106 at "forward_references.py":25
    .expect PTH106 at "forward_references.py":27
.end

// Function and lambda bodies, and every type string, read the module's last binding; class bodies and defaults read it in place.
.test deferred_bodies exactly
    .fixture "deferred_bodies.py" ```
        import os
        from typing import TypeVar, Annotated, cast
        p = "x"
        a1: "os.rmdir(p)"
        os.rmdir(p)
        class C:
            os.rmdir(p)
            def m(self):
                os.rmdir(p)
        f = lambda: os.rmdir(p)
        def g(a=os.rmdir(p)):
            os.rmdir(p)
        def o():
            import os as q
            def i():
                q.rmdir(p)
            q.rmdir(p)
            q = None
        T = TypeVar("T", bound="os.rmdir(p)")
        U = TypeVar("U", "os.rmdir(p)", "os.unlink(p)")
        b: Annotated[int, "os.rmdir(p)"]
        c = cast("list['os.rmdir(p)']", p)
        os = None
        ```
    .expect PTH106 at "deferred_bodies.py":5
    .expect PTH106 at "deferred_bodies.py":7
    .expect PTH106 at "deferred_bodies.py":11
    .expect PTH106 at "deferred_bodies.py":17
.end

// Under `from __future__ import annotations` every annotation is a forward reference.
.test future_annotations exactly
    .fixture "future_annotations.py" ```
        from __future__ import annotations
        import os
        from typing import Annotated
        from dataclasses import dataclass
        p = "x"
        a: os.rmdir(p)
        b: Annotated[int, os.rmdir(p)]
        class C:
            os = None
            x: os.rmdir(p)
        @dataclass
        class D:
            x: os.rmdir(p)
        def f(a: os.rmdir(p)) -> os.rmdir(p):
            y: os.rmdir(p) = 1
            import shutil as os
            z: os.rmdir(p)
        c: list[os.rmdir(p)]
        ```
    .expect PTH106 at "future_annotations.py":6
    .expect PTH106 at "future_annotations.py":7
    .expect PTH106 at "future_annotations.py":10
    .expect PTH106 at "future_annotations.py":13
    .expect PTH106 at "future_annotations.py":14
    .expect PTH106 at "future_annotations.py":14
    .expect PTH106 at "future_annotations.py":15
    .expect PTH106 at "future_annotations.py":17
    .expect PTH106 at "future_annotations.py":18
.end
