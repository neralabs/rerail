.policy "ruff-pth113-os-path-isfile" revision 2
.description "Use Path.is_file() instead of os.path.isfile(); path objects read better than string-based os.path calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH113 (flake8-use-pathlib): a call of `os.path.isfile`, however it is imported, with exactly one argument:
// the `path` parameter, by position or by keyword. pathlib's form is `Path(p).is_file()`.
// Reported at the callee.
//   os.path.isfile(p)               ← PTH113
//   from os.path import isfile
//   isfile(path=p)                  ← PTH113
//   os.path.isfile()                not reported: no argument
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH113(at: node, s: node) code "PTH113"
    "Use `Path({s}).is_file()` from pathlib instead of `os.path.isfile({s})`; leave it where the argument is a bytes path or a file descriptor."
    suppress ruff "PTH113"
PTH113(f, a) :- single_arg(_, "os.path.isfile", "path", f, a).
