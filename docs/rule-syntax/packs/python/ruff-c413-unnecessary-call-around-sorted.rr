.policy "ruff-c413-unnecessary-call-around-sorted" revision 2
.description "Remove a list or reversed call wrapped around sorted; sorted already returns a new list and can sort in reverse order itself."
.language python
.mode steer
.scope include "**/*"

// Ruff C413 (flake8-comprehensions): the builtin list or reversed (by name or as `builtins.list`) whose
// first argument is a call of the builtin sorted. `sorted` already returns a new list, and sorts in reverse
// with `reverse=True`. Ruff's fix for list is safe: here it is offered for `list(sorted(…))` alone.
// Its fix for reversed is unsafe (equal items come out in another order); none here.
//   list(sorted(x))        ← C413: sorted(x)        list(sorted\n (x))   ← C413: (sorted\n (x))
//   reversed(sorted(x))    ← C413: sorted(x, reverse=True)
#include "python/comprehensions.rr"
//   c4_builtin(c, x), c4_first(c, a), c4_only(c, a)

.violation C413(at: node, outer: symbol, id: symbol, msg: symbol) code "C413" "{msg}"
    suppress ruff "C413"
    fix safe unwrap "Remove unnecessary `list()` call"
C413(c, "list", "list-call-around-sorted", "Remove the `list()` call around `sorted()`; `sorted()` already returns a new list.") :-
    around_sorted(c, "list", _).
C413(c, "reversed", "reversed-call-around-sorted",
    "Pass `reverse=True` (or flip the existing `reverse=`) to `sorted()` instead of wrapping it in `reversed()`; keep `reversed()` if equal elements must come out in reverse input order.") :-
    around_sorted(c, "reversed", _).
.decl around_sorted(c: node, outer: symbol, s: node)
around_sorted(c, x, s) :- c4_builtin(c, x), (x = "list" ; x = "reversed"), c4_first(c, s), c4_builtin(s, "sorted").
// The argument as written, parentheses kept; a call over several lines gets parentheses, so it stays valid.
unwrap(c, "list", _, _) :- call_only(c, a), around_sorted(c, "list", _), one_line(c) => replace(c, `$a`).
unwrap(c, "list", _, _) :- call_only(c, a), around_sorted(c, "list", _), !one_line(c) => replace(c, `($a)`).
.decl one_line(c: node)
one_line(c) :- around_sorted(c, "list", _), text(c, t), !contains("\n", t).
