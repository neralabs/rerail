.policy "ruff-pth110-os-path-exists" revision 2
.description "Use Path.exists() instead of os.path.exists(); path objects read better than string-based os.path calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH110 (flake8-use-pathlib): a call of `os.path.exists`, however it is imported, with exactly one argument:
// the `path` parameter, by position or by keyword. pathlib's form is `Path(p).exists()`.
// Reported at the callee.
//   os.path.exists(p)               ← PTH110
//   from os.path import exists
//   exists(path=p)                  ← PTH110
//   os.path.exists(**kw)            not reported: Ruff cannot see into `**`
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH110(at: node, s: node) code "PTH110"
    "Use `Path({s}).exists()` from pathlib instead of `os.path.exists({s})`; leave it for bytes paths, file descriptors, or a value that can be an empty string (`Path('')` is `.`)."
    suppress ruff "PTH110"
PTH110(f, a) :- single_arg(_, "os.path.exists", "path", f, a).
