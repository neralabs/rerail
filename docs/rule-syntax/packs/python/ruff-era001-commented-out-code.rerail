.policy "ruff-era001-commented-out-code" revision 3
.description "Remove commented-out code; version control keeps the history, and dead code left in comments goes stale."
.language python
.mode steer
.scope include "**/*"

// Ruff ERA001 (eradicate): a comment on its own line that holds code. Ruff strips the leading `#`s and spaces,
// then: no code sign (a bracket, `:`, `=`, `%`, return, break, continue, import) means prose; two names in a row
// (`this is`) mean prose; a first word that is a task tag (TODO, FIXME, XXX), a tool pragma (`noqa`,
// `type: ignore`, `fmt: off`, `pylint`…) or `#` and a digit (`Issue #12`) means not code. A trailing `\`, or an
// `else:` / `except …:` header, a dict entry `"k": v,`, an assignment opening a bracket, or brackets alone mean
// code; otherwise the text is code when it parses as a Python module. The block of a `# /// script` header
// (PEP 723), up to its last `# ///`, is skipped.
//   #import os              ← ERA001
//   # x = foo(1, 2)         ← ERA001
//   # This is a (real) comment.    not reported: `This is`
//   # Issue #999: not code         not reported: `#9`
// Ruff's final test is its own Python parser, through @py_parses. No bound on line length or nesting, and no
// separate expression grammar that could mistake prose for Python.
#include "python/misc2-noqa.rerail"
//   own_line_comment(c): no token comes before comment c on its line

.violation ERA001(at: node) code "ERA001"
    "Delete this commented-out code; version control keeps the history. Leave it only if the comment is prose or an example that merely looks like code."
    suppress ruff "ERA001"
.decl era_candidate(c: node, l: symbol)
era_candidate(c, l) :- era_line(c, l), own_line_comment(c), !era_script(c), !era_prose(c).
ERA001(c) :- era_candidate(c, l), (match("[\\s\\S]*\\\\", l) ; era_header(c)).
// Parse only the remaining candidates, not prose, inline comments, pragmas or known partial statements.
ERA001(c) :- era_candidate(c, l), !match("[\\s\\S]*\\\\", l), !era_header(c), @py_parses(l) = 1.

// era_line(c, l): comment c's text without its leading `#`s and spaces, nor trailing spaces, when it has a code sign.
.decl era_line(c: node, l: symbol)
era_line(c, l) :- comment(c, _), text(c, s), match("[# \\t\\f]*(?<l>[\\s\\S]*?)\\s*", s),
    match("[\\s\\S]*([()\\[\\]{}:=%]|return|break|continue|import)[\\s\\S]*", l).
// Ruff's tokenizer distinguishes identifiers from string prefixes and quoted text. A regex word scan cannot:
// `exceptions we've seen, though: ...` starts with two names despite the apostrophe after `we`.
.decl era_prose(n: node)
era_prose(n) :- era_line(n, l), @py_consecutive_names(l) = 1.
era_prose(n) :- era_line(n, l), match("(?:TODO|FIXME|XXX)(?:[ :(][\\s\\S]*)?", l).
era_prose(n) :- era_line(n, l), match("(?:pyright|pyrefly|ruff\\s*:\\s*(?:disable|enable|ignore|file-ignore)|mypy:|type:\\s*ignore|ty:\\s*ignore|SPDX-License-Identifier:|fmt:\\s*(?:on|off|skip)|region|endregion|[nN][oO][qQ][aA]|[pP][yY][lL][iI][nN][tT]|[nN][oO][sS][eE][cC]|[iI][sS][oO][rR][tT]:\\s*(?:on|off|skip|skip_file|split|dont-add-imports)|(?:[eE][nN])?[cC][oO][dD][iI][nN][gG][:=][ \\t]*[-_.A-Za-z0-9]+|language=[-_.a-zA-Z0-9]+)[\\s\\S]*", l).
era_prose(n) :- era_line(n, l), match("[\\s\\S]*#\\d[\\s\\S]*", l).
// era_header(n): comment n's line is one of Ruff's POSITIVE_CASES. Tests stay keyed by comment, not by text,
// so no table of every file's comments crosses into the cross-file part (decision 0677).
.decl era_header(n: node)
era_header(n) :- era_line(n, l), (match("(?:elif\\s+.*\\s*:.*|else\\s*:.*|try\\s*:.*|finally\\s*:.*|except.*:.*|case\\s+.*\\s*:.*)", l) ;
    match("['\"]\\w+['\"]\\s*:.+[,{]\\s*(#.*)?", l) ; match("(?:[(\\[]\\s*)?(?:\\w+\\s*,\\s*)*\\w+\\s*([)\\]]\\s*)?=.*[(\\[{]\\s*(#.*)?", l) ;
    match("[()\\[\\]{}\\s]+\\s*(#.*)?", l)).

// era_script(c): c lies in a PEP 723 block: a line `# /// script`, then lines `#` or `# …` (from column 0) up to the
// last `# ///` before the first other line.
.decl era_script(c: node)
era_script(c) :- comment(c, _), docof(c, d), line(c, l), era_block(d, l0, e), l0 <= l, l <= e.
.decl era_cline(d: number, l: number, s: symbol)
era_cline(d, l, s) :- era_has_script(d), src_line(d, l, sp), text(sp, s), match("#(?: [\\s\\S]*)?", s).
.decl era_has_script(d: number)
era_has_script(d) :- comment(c, _), text(c, "# /// script"), docof(c, d).
.decl era_run(d: number, l0: number, l: number)
era_run(d, l0, l0) :- era_cline(d, l0, "# /// script").
era_run(d, l0, l + 1) :- era_run(d, l0, l), era_cline(d, l + 1, _).
.decl era_block(d: number, l0: number, e: number)
era_block(d, l0, e) :- era_run(d, l0, _), e = max l : { era_run(d, l0, l), era_cline(d, l, "# ///") }.

// The fixture's last line is `#`, U+00A0 (a no-break space, not an ordinary space) and `x = 1`: not ERA001, unlike
// line 3. Ruff's comment_contains_code trims only `#` and is_python_whitespace (space, tab, form feed), as era_line
// does, so the U+00A0 reaches the parser, which rejects the line.
.test comments_are_parsed_not_guessed exactly
    .fixture "app/comments.py" ```
        # SIM103 (but not fixable)
        # (See: http://example.test/revision)
        # x = 1
        # import os
        # x = (((((((((((1)))))))))))
        # value = "a valid assignment with a long literal that is intentionally longer than the old two hundred character heuristic, but remains ordinary Python code regardless of its length; the real Python parser accepts this without an arbitrary rule-side cutoff."
        # This is a (real) comment.
        # x = 1  #٣
        # 'month'. Eg: "Title must be unique for pub_date year"
        # exceptions we've seen, though: this call failing in other ways can reveal
        # x = "hello world"
        # x = 1
        ```
    .expect ERA001 at "app/comments.py":3
    .expect ERA001 at "app/comments.py":4
    .expect ERA001 at "app/comments.py":5
    .expect ERA001 at "app/comments.py":6
    .expect ERA001 at "app/comments.py":9
    .expect ERA001 at "app/comments.py":11
.end
