.policy "ruff-d209-new-line-after-last-paragraph" revision 3
.description "Put the closing quotes of a multi-line docstring on their own line."
.language python
.mode steer
.scope include "**/*"

// Ruff D209 (pydocstyle): a triple-quoted docstring with two or more lines of text whose closing quotes are not
// on a line of their own.
//   """Summary.
//
//   More text."""            ← D209
#include "python/docstrings.rerail"

.violation D209(at: node) code "D209"
    "Move this docstring's closing quotes onto a new line after its last line of text."
    suppress ruff "D209"
// The last body line has text, and an earlier line does too. doc_line treats LF, CRLF and bare CR alike.
D209(s) :- doc_checked(s), doc_triple(s), doc_nlines(s, n), n > 1, i = n - 1, !doc_blank(s, i),
    doc_line(s, j, _), j < i, !doc_blank(s, j).
