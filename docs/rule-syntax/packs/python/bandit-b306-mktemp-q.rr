.policy "bandit-b306-mktemp-q" revision 2
.description "Use tempfile.mkstemp() or NamedTemporaryFile instead of tempfile.mktemp(); mktemp returns a name another process can claim before you create the file."
.language python
.mode steer
.scope include "**/*.py"
// Bandit's B306 (its B001 blacklist): a call to tempfile.mktemp. Bandit reads the callee's text, so `tempfile.mktemp()`
// is reported even where tempfile is not imported.
//   tempfile.mktemp()                          B306
//   from tempfile import mktemp as m; m()      B306
//   tempfile.mkstemp()                         not reported
// How Bandit reads the call's name, and the list: python/security.rr (blacklisted).

#include "python/security.rr"   // blacklisted: Bandit's B001 over calls and imports

.violation B306(at: node) code "B306"
    "Replace tempfile.mktemp with mkstemp or NamedTemporaryFile, which create the file atomically."
    suppress nosec "B306"
B306(n) :- blacklisted(n, "B306").
