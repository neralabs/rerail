.policy "ruff-f722-forward-annotation-syntax-error" revision 3
.description "Keep string type annotations and other forward references valid Python expressions; a syntax error there breaks type checking and runtime evaluation."
.language python
.mode steer
.scope include "**/*"

// Ruff F722 (pyflakes): a string annotation (a forward reference) that is not a valid Python expression, so type
// checkers and typing.get_type_hints() cannot read it. Strings inside a string annotation are annotations too.
// Not checked: the annotations of a def decorated with `@no_type_check` (on a class it does nothing), the
// arguments of `Literal[...]` and the metadata of `Annotated[T, ...]`, which are values, and jaxtyping shape
// strings, which are not Python (`Float[Array, "batch dim"]`).
//   def g() -> "///": ...                 ← F722
//   X: """List[int]"""'☃' = []            ← F722: the parts join into one invalid annotation
//   def f(a: "'' and 'b'"): ...           ← F722: the inner '' is an annotation too, and empty
//   w: "\tNoReturn"                       ← F722: Ruff parses the value as it is, so the tab is an indent
//   def f() -> "A": ...                   not reported
//   def f() -> "Literal[0]#": ...         not reported: a comment ends it
#include "python/pyflakes.rerail"
//   string_annotation(s)       s is a string Ruff reads as a type, nested ones included (core)
//   str(s, v), value(s, v)     a string's, a concatenated string's decoded value (core)
//   parse_of(x, "python", t)   x parsed as a module, tape t: a text that does not parse has no doc_root (core)

.violation F722(at: node) code "F722" "Syntax error in forward annotation"
    suppress ruff "F722"
F722(s) :- ann_parse(s, t), !one_expression(t), !no_type_check(s), !not_a_type(s).
// How Ruff's parser reads a string annotation (`ruff_python_parser::typing::parse_type_annotation`): a single
// triple-quoted string whose source contents are its value, in parentheses (its lines may break and indent); any
// other, its value as it is, so a leading space is an indent and a line break ends it. The engine's own guest
// (`parsed(s, "annotation", r)`) wraps every string as `( … )`, which accepts those and refuses
// `"Literal[0]#"` (its comment swallows the `)`), and reads `''` as `()`: it is not Ruff's verdict.
.decl ann_parse(s: node, t: tape)
ann_parse(s, t) :- ann_text(s, x), parse_of(x, "python", t).
.decl ann_text(s: node, x: symbol)
ann_text(s, cat("(", cat(v, "\n)"))) :- ann_string(s), kind(s, "string"), str(s, v), parenthesized(s, v).
ann_text(s, v) :- ann_string(s), kind(s, "string"), str(s, v), !parenthesized(s, v).
ann_text(s, v) :- ann_string(s), kind(s, "concatenated_string"), value(s, v).
.decl parenthesized(s: node, v: symbol)
parenthesized(s, v) :- str(s, v), text(s, t), strprefix(s, p), k = strlen(p), q = @slice(t, k, k + 3),
    (q = "\"\"\"" ; q = "'''"), v = @slice(t, k + 3, -3).
// one_expression(t): tape t's module is one expression statement, not an assignment (CPython's `eval` mode accepts
// it). Equal texts share a tape, so the engine's own annotation guest of `"x"` (`(x)`, a fragment) is a document of
// the tape `@parse("python", "(x)")` makes too: only the module counts. The value document's rows are read in this
// one rule: a separate relation over its nodes (`statement_form(e)`) was found empty. `syntax_error` is not read:
// a text that does not parse is withheld (no doc_root), and a policy that reads it is not given the files CPython
// 3.13 refuses, such as those with t-strings, which Ruff reads.
.decl one_expression(t: tape)
one_expression(t) :- tape_of(d, t), doc_root(d, m), kind(m, "module"), child(m, e, _),
    kind(e, "expression_statement"), count : { child(m, c, _), kind(c, k1), !extra(k1) } = 1,
    count : { child(e, a, _), kind(a, k2), statement_form(k2) } = 0.
.decl extra(k: symbol)
extra("comment"). extra("line_continuation").
.decl statement_form(k: symbol)
statement_form("assignment"). statement_form("augmented_assignment"). statement_form("yield").
// ann_string(s): a whole string literal (adjacent parts together) Ruff reads as a type. Its guest is asked
// (`sub_tape`, which a guest that does not parse has too): the strings nested in it are annotations only once it is
// a document (`def f(a: "'' and 'b'")`: the '' is F722).
.decl ann_string(s: node)
ann_string(s) :- string_annotation(s), !piece(s), sub_tape(s, "annotation", _).
.decl piece(s: node)  // one part of adjacent literals
piece(s) :- kind(c, "concatenated_string"), child(c, s, _).
// no_type_check(s): s is in a def decorated with typing's no_type_check.
.decl no_type_check(s: node)
no_type_check(s) :- inside(s, f, "function_definition"), decorator(f, e), imported_sym(e, q), no_type_check_name(q).
.decl no_type_check_name(q: symbol)
no_type_check_name("typing.no_type_check"). no_type_check_name("typing_extensions.no_type_check").
no_type_check_name("_typeshed.no_type_check").
// not_a_type(s): Ruff does not read s as an annotation: an argument of `Literal[...]`, an argument after the first
// of `Annotated[T, ...]` (typing or typing_extensions), or a jaxtyping shape (`jaxtyping.X[dtype, "shape"]`).
//   x: Literal["a b"]                     not reported
//   y: Annotated[int, "some text"]        not reported
//   w: list["a b"]                        ← F722
.decl not_a_type(s: node)
not_a_type(s) :- sub_arg(h, a, _), imported_sym(h, q), (q = "typing.Literal" ; q = "typing_extensions.Literal"),
    (s = a ; within(s, a)).
not_a_type(s) :- sub_arg(h, a, 0), imported_sym(h, q), (q = "typing.Annotated" ; q = "typing_extensions.Annotated"),
    (s = a ; within(s, a)).
not_a_type(s) :- sub_arg(h, a, 0), imported_sym(h, q), prefix("jaxtyping.", q), (s = a ; within(s, a)).
// sub_arg(h, a, first): a is an argument of `h[...]`, first = 1 for the first one. A subscript in an expression,
// or a generic type where tree-sitter parses an annotation (`[`, then the arguments as `type` nodes).
.decl sub_arg(h: node, a: node, first: number)
sub_arg(h, a, f) :- kind(g, "subscript"), field(g, "value", h), field(g, "subscript", a),
    n = count : { field(g, "subscript", a0), a0 < a }, (n = 0, f = 1 ; n > 0, f = 0).
sub_arg(h, a, f) :- kind(g, "generic_type"), child(g, h, 0), child(g, tp, 1), kind(tp, "type_parameter"),
    child(tp, a, i), kind(a, "type"), (i = 1, f = 1 ; i > 1, f = 0).
