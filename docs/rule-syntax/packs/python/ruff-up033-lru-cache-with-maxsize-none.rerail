.policy "ruff-up033-lru-cache-with-maxsize-none" revision 2
.description "Use functools.cache instead of functools.lru_cache with maxsize=None; it is the same unbounded cache without the call."
.language python
.mode steer
.scope include "**/*"

// Ruff UP033 (pyupgrade): a decorator `@functools.lru_cache(maxsize=None)`, with that one keyword and nothing
// else; parentheses count for nothing (`@(functools.lru_cache)(maxsize=(None))`). Python 3.9 added
// `functools.cache`, the same unbounded cache; below a 3.9 target the rule is off. Ruff's range starts where the
// decorator's function ends, so the finding is at the function's last name.
//   @functools.lru_cache(maxsize=None)        ← UP033
//   @(functools.lru_cache  # c
//   )(maxsize=None)                           ← UP033 on the first line, where lru_cache ends
//   @lru_cache(user_func, maxsize=None)       not reported
#include "python/upgrade.rerail"
//   sym_at(e, q): e names q, through the bindings visible where it runs; targets(m): Python 3.m or later

.violation UP033(at: node) code "UP033"
    "Replace `lru_cache(maxsize=None)` with `functools.cache` (importing `cache` from functools if needed); it is the same unbounded cache and takes no call."
    suppress ruff "UP033"
UP033(at) :- targets(9), decorator(_, e), unparen(e, c), kind(c, "call"), field(c, "function", f), unparen(f, f0),
    sym_at(f0, "functools.lru_cache"), (kind(f0, "identifier"), at = f0 ; field(f0, "attribute", at)),
    field(c, "arguments", al), count : { child(al, a, _), !kind(a, "comment") } = 1, child(al, k, _),
    kind(k, "keyword_argument"), field(k, "name", n), text(n, "maxsize"), field(k, "value", v0), unparen(v0, v),
    kind(v, "none").
