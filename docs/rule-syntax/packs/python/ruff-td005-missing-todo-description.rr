.policy "ruff-td005-missing-todo-description" revision 2
.description "Describe the work after a TODO, FIXME or XXX tag instead of leaving the tag bare; readers need to know what is meant to be done."
.language python
.mode steer
.scope include "**/*"

// Ruff TD005 (flake8-todos): a TODO, FIXME or XXX with nothing after the tag and its author, or nothing after
// their colon.
//   # TODO(charlie)        ← TD005
//   # TODO:                ← TD005
//   # TODO: fix this       not reported
#include "python/misc2-todo-span.rr"   // todo_at; python/misc2-todo: todo_item and the TD helpers

.violation TD005(at: span, tag: symbol) code "TD005"
    "Say what needs doing after `{tag}`, on the same comment line (for example `{tag}(name): what to fix`); if the work is already done, remove the comment instead."
    suppress ruff "TD005"
TD005(t, D) :- todo_item(c, D, _), (todo_shape(c, "empty") ; todo_shape(c, "colon-empty")), todo_at(c, t).
