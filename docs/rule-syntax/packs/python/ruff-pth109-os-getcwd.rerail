.policy "ruff-pth109-os-getcwd" revision 3
.description "Use Path.cwd() instead of os.getcwd() or os.getcwdb(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH109 (flake8-use-pathlib): every call of `os.getcwd` or `os.getcwdb`, however it is imported.
// Reported at the callee.
//   os.getcwd()                          ← PTH109: `Path.cwd()`
//   from os import getcwdb; getcwdb()    ← PTH109, with the bytes message
#include "python/python-21.rerail"
//   pth_checked_call(c, q, f)   c calls q in code Ruff checks; f the callee

.violation PTH109(at: node, msg: symbol) code "PTH109" "{msg}"
    suppress ruff "PTH109"
PTH109(f, "Use `Path.cwd()` from pathlib instead of `os.getcwd()`; it returns a `Path`, so wrap it in `str()` or adjust the code where a string is required.") :-
    pth_checked_call(_, "os.getcwd", f).
PTH109(f, "Use `Path.cwd()` from pathlib instead of `os.getcwdb()`; it returns a `Path`, not bytes, so leave it where a bytes value is required.") :-
    pth_checked_call(_, "os.getcwdb", f).

// Tests (decision 0130), from the python-21 review: each expects exactly what Ruff 0.17.6 reports.
// S1 `cast` strings, S2 escaped strings and S4 forward references in a function are reported; of S3's implicit
// concatenations only the call whose last name is its own head (`os.getcwd(" ")`) is; S5's function body runs after
// the module rebinds the import, so nothing there is.
.test review_shared exactly
    .fixture "shared.py" ```
        import os
        import py
        from typing import cast
        p = "x"

        # S1
        c101 = cast("os.chmod(p, 0o644)", p)
        c106 = cast("os.rmdir(p)", p)
        c107 = cast("os.remove(p)", p)
        c108 = cast("os.unlink(p)", p)
        c109 = cast("os.getcwd()", p)
        c110 = cast("os.path.exists(p)", p)
        c111 = cast("os.path.expanduser(p)", p)
        c124 = cast("py.path.local(p)", p)

        # S2
        e101: "os.chmod('a\\tb', 0o644)"
        e106: "os.rmdir('a\\tb')"
        e107: "os.remove('a\\tb')"
        e108: "os.unlink('a\\tb')"
        e109: "(os.getcwd(), 'a\\tb')"
        e110: "os.path.exists('a\\tb')"
        e111: "os.path.expanduser('a\\tb')"
        e124: "py.path.local('a\\tb')"

        # S3 (the all-rule rerun is shown separately below)
        s101: "os.chmod(" "p, 0o644)"
        s106: "os.rmdir(" "p)"
        s107: "os.remove(" "p)"
        s108: "os.unlink(" "p)"
        s109: "os.getcwd(" ")"
        s110: "os.path.exists(" "p)"
        s111: "os.path.expanduser(" "p)"
        s124: "py.path.local(" "p)"

        # S4
        def forward_scope():
            os = None
            py = None
            f101: "os.chmod(p, 0o644)"
            f106: "os.rmdir(p)"
            f107: "os.remove(p)"
            f108: "os.unlink(p)"
            f109: "os.getcwd()"
            f110: "os.path.exists(p)"
            f111: "os.path.expanduser(p)"
            f124: "py.path.local(p)"

        # S5
        import os as late_os
        import py as late_py
        def deferred_scope():
            late_os.chmod(p, 0o644)
            late_os.rmdir(p)
            late_os.remove(p)
            late_os.unlink(p)
            late_os.getcwd()
            late_os.path.exists(p)
            late_os.path.expanduser(p)
            late_py.path.local(p)
        late_os = None
        late_py = None
        ```
    .expect PTH109 at "shared.py":11
    .expect PTH109 at "shared.py":21
    .expect PTH109 at "shared.py":31
    .expect PTH109 at "shared.py":44
.end

// Implicit concatenations whose last name is not the callee's head: Ruff reports none.
.test review_concat exactly
    .fixture "concat.py" ```
        import os
        import py
        p = "x"
        s101: "os.chmod(" "p, 0o644)"
        s106: "os.rmdir(" "p)"
        s107: "os.remove(" "p)"
        s108: "os.unlink(" "p)"
        s109: "os.getcwd(" "p)"
        s110: "os.path.exists(" "p)"
        s111: "os.path.expanduser(" "p)"
        s124: "py.path.local(" "p)"
        ```
.end

// Imports of os.getcwd(b), rebound and deleted names, deferred bodies.
.test import_forms exactly
    .fixture "import_forms.py" ```
        import py
        from py.path import local as L
        from py import path as pp
        import os
        from os import getcwd, getcwdb
        p = "x"
        py.path.local(p)
        L(p)
        pp.local(p)
        getcwd()
        getcwdb()
        a: "L()" ""
        b: "getcwdb(" ")"
        c: "pp.local(L)" ""
        d: "getcwd(int)" ""
        def g():
            py = None
            py.path.local(p)
            q: "py.path.local(p)"
            getcwd()
        lam = lambda: L(p)
        class C:
            getcwd()
            def m(self):
                getcwd()
        del getcwd
        getcwd()
        L = None
        ```
    .expect PTH109 at "import_forms.py":10
    .expect PTH109 at "import_forms.py":11
    .expect PTH109 at "import_forms.py":13
    .expect PTH109 at "import_forms.py":23
.end
