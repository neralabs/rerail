.policy "ruff-pth111-os-path-expanduser" revision 2
.description "Use Path.expanduser() instead of os.path.expanduser(); path objects read better than string-based os.path calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH111 (flake8-use-pathlib): a call of `os.path.expanduser`, however it is imported, with exactly one argument:
// the `path` parameter, by position or by keyword. pathlib's form is `Path(p).expanduser()`.
// Reported at the callee.
//   os.path.expanduser(p)           ← PTH111
//   from os.path import expanduser
//   expanduser(path=p)              ← PTH111
//   os.path.expanduser(p, q)        not reported: two arguments
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH111(at: node, s: node) code "PTH111"
    "Use `Path({s}).expanduser()` from pathlib instead of `os.path.expanduser({s})`; it returns a `Path` and raises `RuntimeError` if the home can't be resolved; leave bytes paths alone."
    suppress ruff "PTH111"
PTH111(f, a) :- single_arg(_, "os.path.expanduser", "path", f, a).
