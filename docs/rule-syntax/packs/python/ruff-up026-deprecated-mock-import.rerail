.policy "ruff-up026-deprecated-mock-import" revision 2
.description "Use the standard library unittest.mock instead of the separate mock package; it has been built into Python since version 3.3."
.language python
.mode steer
.scope include "**/*"

// Ruff UP026 (pyupgrade): the `mock` backport, which the standard library has had as `unittest.mock` since 3.3.
// Three forms, each where Ruff reports it:
//   import mock, sys            ← UP026 at `mock` (each `mock` or `mock.mock` item, aliased or not)
//   from mock import patch      ← UP026 at the statement (from `mock` only: `from mock.mock import x` is not)
//   mock.mock.Mock()            ← UP026 at `mock.mock`: the object of an attribute, `mock.mock` by spelling
//                                 (parentheses off), once Ruff has seen an import of the `mock` package
//   x = mock.mock               not reported: nothing is read from it
// "Once seen" is Ruff's walk order (seen_module): the module first, then function bodies a nesting level at a
// time (all bodies of depth 1 in source order, then depth 2, …), then lambda bodies, then deferred annotations
// (string annotations; every annotation in a stub, under `from __future__ import annotations`, or from 3.14).
//   def f(): return mock.mock.X       not reported: f's body is walked before outer's, which holds the import
//   def outer():
//       def inner(): return (mock).mock.X     ← UP026: depth 2, after the import at depth 1
//       import mock
// The JSON's three clauses, one message each.
#include "python/upgrade-imports.rerail"
//   plain_import(i, a, m, l), from_stmt(i, m), late_annotation(n) (python/upgrade)

.violation UP026(at: node, msg: symbol) code "UP026" "{msg}"
    suppress ruff "UP026"
UP026(a, m) :- item_spelled(_, a, y), (y = "mock" ; y = "mock.mock"), says("import", m).
UP026(i, m) :- from_stmt(i, "mock"), says("from", m).
UP026(e, m) :- mock_attr(e), mock_seen(e), says("attribute", m).

// mock_attr(e): e is `mock.mock`, parentheses off, and the object of an attribute.
.decl mock_attr(e: node)
mock_attr(e) :- attr_of(_, o, _), unparen(o, e), attr_of(e, h0, "mock"), unparen(h0, h), kind(h, "identifier"),
    text(h, "mock").
// item_spelled(i, a, y): item a of `import` statement i names module y, spaces taken out (`mock . mock`).
.decl item_spelled(i: node, a: node, y: symbol)
item_spelled(i, a, @replace_all(x, "\\s+", "")) :- plain_import(i, a, x, _).
// mock_import(i, d): statement i of document d imports the `mock` package or a module in it (Ruff's add_module:
// the first segment of an `import` item or of a non-relative `from` module).
.decl mock_import(i: node, d: number)
mock_import(i, d) :- item_spelled(i, _, y), @head(y) = "mock", docof(i, d).
mock_import(i, d) :- from_stmt(i, x), @head(x) = "mock", docof(i, d).
// mock_seen(e): Ruff has visited a mock import before it visits e.
.decl mock_seen(e: node)
mock_seen(e) :- mock_attr(e), mock_late(e, d), mock_import(_, d).
mock_seen(e) :- mock_attr(e), !mock_late(e, _), walk_depth(e, de), node(d, e, _, se, _), mock_import(i, d),
    walk_depth(i, di), node(d, i, _, si, _), (di < de ; di = de, si < se).
// mock_late(e, d): e of document d is walked after every function body: in a lambda's body, or an annotation
// Ruff defers (a string annotation's tree belongs to the string's document).
.decl mock_late(e: node, d: number)
mock_late(e, d) :- mock_attr(e), kind(l, "lambda"), field(l, "body", b), (e = b ; within(e, b)), docof(e, d).
mock_late(e, d) :- mock_attr(e), parsed_in(e, s), docof(s, d).
mock_late(e, d) :- mock_attr(e), late_annotation(e), docof(e, d).
// walk_depth(n, k): n is walked with the function bodies of nesting depth k (0: the module's own walk). A def's
// decorators, defaults and annotations are walked with the code around it; only its body is deferred.
.decl fn_body(b: node)
fn_body(b) :- kind(f, "function_definition"), field(f, "body", b).
.decl def_depth(f: node, k: number)
def_depth(f, 0) :- kind(f, "function_definition"), !nearest(f, _, fn_body).
def_depth(f, k + 1) :- kind(f, "function_definition"), nearest(f, b, fn_body), field(g, "body", b), def_depth(g, k).
.decl walk_depth(n: node, k: number)
walk_depth(n, 0) :- (mock_attr(n) ; mock_import(n, _)), !nearest(n, _, fn_body).
walk_depth(n, k + 1) :- (mock_attr(n) ; mock_import(n, _)), nearest(n, b, fn_body), field(g, "body", b),
    def_depth(g, k).

.decl says(form: symbol, msg: symbol)
says("import", "Import mock from the standard library with `from unittest import mock` (add `as NAME` if it is aliased). Keep the separate package only if the code must still run on Python 2.").
says("from", "Import from `unittest.mock` instead of `mock`; `from mock import mock` becomes `from unittest import mock`. Keep the separate package only if the code must still run on Python 2.").
says("attribute", "Drop the redundant `.mock`: write `mock.NAME` instead of `mock.mock.NAME`.").
