.policy "ruff-td004-missing-todo-colon" revision 2
.description "Put a colon straight after the TODO tag and its author, so every TODO comment has the same shape."
.language python
.mode steer
.scope include "**/*"

// Ruff TD004 (flake8-todos): a TODO, FIXME or XXX whose tag (and author, if any) is not followed straight
// away by a colon.
//   # TODO(charlie) fix this       ← TD004
//   # TODO fix this                ← TD004
//   # TODO (charlie): fix this     not reported: spaces before the author are skipped
//   # TODO(charlie): fix this      not reported
#include "python/misc2-todo-span.rr"   // todo_at; python/misc2-todo: todo_item and the TD helpers

.violation TD004(at: span, tag: symbol) code "TD004"
    "Put a colon right after `{tag}` or its author, as in `{tag}(name): text`, with the description after the colon."
    suppress ruff "TD004"
TD004(t, D) :- todo_item(c, D, _), todo_shape(c, "no-colon"), todo_at(c, t).
