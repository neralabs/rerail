.policy "bandit-b302-marshal" revision 2
.description "Avoid marshal.load() and marshal.loads(); marshal is not safe against malicious or malformed data, so never use it on untrusted input."
.language python
.mode steer
.scope include "**/*.py"
// Bandit's B302 (its B001 blacklist): a call to marshal.load or marshal.loads.
//   import marshal; marshal.loads(data)        B302
//   from marshal import load; load(f)           B302
// How Bandit reads the call's name, and the list: python/security.rr (blacklisted).

#include "python/security.rr"   // blacklisted: Bandit's B001 over calls and imports

.violation B302(at: node) code "B302"
    "Load this data with json or another data-only format instead of marshal, which is unsafe on untrusted input."
    suppress nosec "B302"
B302(n) :- blacklisted(n, "B302").
