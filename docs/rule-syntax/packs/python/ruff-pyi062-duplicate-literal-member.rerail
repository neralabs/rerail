.policy "ruff-pyi062-duplicate-literal-member" revision 3
.description "Remove duplicate members from a Literal type; repeating a value adds nothing."
.language python
.mode steer
.scope include "**/*"

// Ruff PYI062 (flake8-pyi), every file: a member of `Literal[…]` equal to an earlier one, nested Literals
// flattened and a parenthesised tuple slice read as the members (python-09's lit_member). Members compare by
// value, not spelling: "a" and 'a' are one; True and 1 are two. Separate Literals in a union are not compared
// (PYI030 merges them), and a string inside a Literal is a value, not code.
//   x: Literal[1, 2, 1]        ← PYI062 at the second 1
//   y: Literal[(1, 1)]         ← PYI062
#include "python/python-09.rerail"

.violation PYI062(at: node) code "PYI062" "Remove the repeated member `{at}` from this Literal; an earlier member already covers it."
    suppress ruff "PYI062"
PYI062(m) :- lit_member(l, m), lit_member_key(m, k), lit_member(l, e), e < m, lit_member_key(e, k).
PYI062(m) :- lit_member(l, m), kind(m, t), value(m, v), lit_member(l, e), e < m, kind(e, t), value(e, v).
