.policy "ruff-pt015-pytest-assert-always-false" revision 2
.description "Use pytest.fail instead of an assert on a value that is always false; it states the intent to fail the test more clearly."
.language python
.mode steer
.scope include "**/*"

// Ruff PT015 (flake8-pytest-style): an `assert` whose test is always false (Ruff's Truthiness): False, None,
// 0, 0.0, 0j, "", b"", f"" (or f"{''}"), an empty list, tuple, set or dict display, or `list()`, `tuple()`, `set()`,
// `dict()`, `frozenset()` of the builtin called with nothing or with one falsy argument. `pytest.fail` says it.
//   assert False, "unreachable"      ← PT015
//   assert list([])                  ← PT015
//   assert not True                  not reported: Ruff does not evaluate `not`
#include "python/pytest.rr"
//   exc_call(c, q), exc_no_args(c), exc_arg(c, i, a), pytest_empty_or_null(e)

.violation PT015(at: node) code "PT015"
    "Replace this always-failing `assert` with `pytest.fail(...)`, passing any assertion message to it; leave it alone outside pytest tests."
    suppress ruff "PT015"
PT015(a) :- kind(a, "assert_statement"), child(a, t0, 0), exc_unparen(t0, t), always_false(t).

.decl always_false(e: node)
always_false(e) :- falsy_atom(e).
always_false(c) :- empty_maker(c), exc_no_args(c).
always_false(c) :- empty_maker(c), exc_arg(c, 0, a), !exc_arg(c, 1, _), !has(c, _, "keyword_argument"),
    !kind(a, "integer"), !kind(a, "float"), !kind(a, "true"), !kind(a, "false"), !kind(a, "none"),
    !kind(a, "ellipsis"), always_false(a).
.decl falsy_atom(e: node)  // a falsy literal or empty display
falsy_atom(e) :- kind(e, k), (k = "false" ; k = "none").
falsy_atom(e) :- (kind(e, "integer") ; kind(e, "float")), text(e, x), !match("0[xXoObB].*", x),
    to_float(@replace_all(x, "[_jJ]", "")) = 0.0.
falsy_atom(e) :- kind(e, "integer"), text(e, x), match("0[xXoObB][0_]+", x).
falsy_atom(e) :- (kind(e, "list") ; kind(e, "tuple") ; kind(e, "set") ; kind(e, "dictionary")),
    count : { child(e, x, _), !kind(x, "comment") } = 0.
falsy_atom(e) :- empty_piece(e).
falsy_atom(e) :- kind(e, "concatenated_string"), count : { child(e, p, _), kind(p, "string"), !empty_piece(p) } = 0.
.decl empty_piece(s: node)  // "", b"", or an f-string with no text whose fields are all "" (f"", f"{''}")
empty_piece(s) :- string_kind(s, _), value(s, "").
empty_piece(s) :- kind(s, "string"), strprefix(s, p), contains("f", p), !has(s, _, "string_content"),
    count : { child(s, i, _), kind(i, "interpolation"), !empty_field(i) } = 0.
.decl empty_field(i: node)  // `{''}`: an empty str, no `=`, conversion or format spec
empty_field(i) :- kind(i, "interpolation"), field(i, "expression", x), unparen(x, m), string_kind(m, "str"), value(m, ""),
    !child(i, _, 1), !op(i, "=").
.decl empty_maker(c: node)  // a call of the builtin list, tuple, set, dict or frozenset, by its bare name
empty_maker(c) :- exc_call(c, q), (q = "builtins.list" ; q = "builtins.tuple" ; q = "builtins.set" ;
    q = "builtins.dict" ; q = "builtins.frozenset"), field(c, "function", f), kind(f, "identifier").
