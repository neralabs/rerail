.policy "ruff-sim223-expr-and-false" revision 2
.description "Simplify an and expression holding an always-falsy value such as False, None, zero or an empty literal; the operands after it never run."
.language python
.mode steer
.scope include "**/*"

// Ruff SIM223 (flake8-simplify): an `and` with an operand that is always false (`False`, `None`, `0`, an empty
// literal or display, `list()`, …; python/simplify's sim_truth), so the operands after it never run and the
// result is that value. Ruff walks the operands in pairs: an operand of unknown truth stops nothing, but
// outside a boolean test, or when it has a side effect, the finding starts after it. So `x and False` is
// reported in an `if` test only (elsewhere its value may be x), and `f() and False` not at all. Ruff's fix is
// unsafe; none here.
//   if x and False: …        ← SIM223 (the test is False)
//   y = None and x           ← SIM223 (y is None)
//   y = x and False          not reported
#include "python/simplify.rr"
//   sim_operand(t, o, i, v), sim_nops(t, n), sim_truth(e, b), side_effect(e), sim_bool_test(e), in_string_ann(e)

.violation SIM223(at: node, v: node) code "SIM223"
    "Drop the operands after `{v}` in this `and`; it is always false, so they never run and the result is `{v}`."
    suppress ruff "SIM223"
SIM223(at, v) :- short_circuit(t, i, v), !in_string_ann(t), from(t, i, at).   // Ruff skips string annotations

// pass_over(t, i): operand i is of unknown truth and may not be dropped: the finding starts after it.
.decl pass_over(t: node, i: number)
pass_over(t, i) :- sim_operand(t, "and", i, v), !sim_truth(v, _), (!sim_bool_test(t) ; side_effect(v)).
// stop(t, i, v): Ruff's loop ends at pair (i, i + 1), on v, an always-false operand of the two.
.decl stop(t: node, i: number, v: node)
stop(t, i, v) :- sim_operand(t, "and", i, v), sim_nops(t, n), i < n - 1, !pass_over(t, i), sim_truth(v, "false").
stop(t, i, w) :- sim_operand(t, "and", i, v), sim_nops(t, n), i < n - 1, !pass_over(t, i), !sim_truth(v, "false"),
    sim_operand(t, "and", i + 1, w), sim_truth(w, "false").
.decl short_circuit(t: node, i: number, v: node)
short_circuit(t, i, v) :- stop(t, i, v), i = min j : { stop(t, j, _) }.
// from(t, i, at): the finding starts at the operand after the last one passed over before i, else at t.
.decl from(t: node, i: number, at: node)
from(t, i, t) :- short_circuit(t, i, _), count : { pass_over(t, k), k < i } = 0.
from(t, i, at) :- short_circuit(t, i, _), k = max j : { pass_over(t, j), j < i }, sim_operand(t, "and", k + 1, at).
