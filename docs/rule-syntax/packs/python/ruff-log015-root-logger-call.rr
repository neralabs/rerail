.policy "ruff-log015-root-logger-call" revision 2
.description "Use a logger from logging.getLogger(__name__) instead of the logging module's root logger functions; root logger messages carry no source information."
.language python
.mode steer
.scope include "**/*"

// Ruff LOG015 (flake8-logging): a call of the root logger's functions, `logging.info(…)` and the like, through
// the module or a `from logging import …`. Their records come from the root logger and carry no module name;
// a `logging.getLogger(__name__)` logger does. A name rebound to something else is not the function.
//   logging.debug("Lorem")            ← LOG015
//   from logging import log; log("x") ← LOG015
//   logger.info("ipsum")              not reported
#include "python/logging.rr"

.violation LOG015(at: node, m: symbol) code "LOG015"
    "Replace this root logger `{m}()` call with the same call on a module-level `logger = logging.getLogger(__name__)`; root logger messages carry no source information. Leave it in a one-off script."
    suppress ruff "LOG015"
LOG015(c, m) :- call_q(c, q), split_dot(q, "logging", m), log_method(m), docof(c, d), seen_module(d, "logging").
