.policy "bandit-b101-assert-used" revision 2
.description "Avoid assert statements in Python code; they are stripped when Python runs with optimization, so any check they perform silently disappears."
.language python
.mode steer
.scope include "**/*"
.scope exclude "**/tests/**", "**/test_*.py", "**/*_test.py", "**/conftest.py"
// Bandit's B101 (assert_used): every assert statement. `python -O` compiles them away.
//   assert user.is_admin                 B101
//   if not user.is_admin: raise Denied   not reported
// Bandit's `skips` option (file globs to leave out) has no counterpart in the JSON and is not ported.

.violation B101(at: node) code "B101"
    "Replace this assert with an if check that raises an exception; asserts are stripped when Python runs with -O."
    suppress nosec "B101"
B101(a) :- kind(a, "assert_statement").

// Tests (decision 0119): run by `rerail-engine test-rr`, left out of the rule otherwise.
.test asserts_are_reported
    .fixture "app/views.py" ```
        def view(user):
            assert user.is_admin
            return render(user)
        ```
    .expect B101 at "app/views.py":2
    .expect no B101 at "app/views.py":3
.end

// `exactly`: these findings and no others. The test files are out of the scope.
.test test_files_are_out_of_scope exactly
    .fixture "app/a.py" ```
        assert x
        ```
    .fixture "app/tests/test_a.py" ```
        assert x
        ```
    .fixture "conftest.py" ```
        assert x
        ```
    .expect B101 at "app/a.py":1
.end

// A raise is the replacement: nothing to report.
.test a_raise_passes
    .fixture "app/b.py" ```
        if not user.is_admin:
            raise Denied()
        ```
    .expect no B101
.end
