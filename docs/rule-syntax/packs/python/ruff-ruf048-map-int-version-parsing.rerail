.policy "ruff-ruf048-map-int-version-parsing" revision 1
.description "Parse a version string with a real version parser, not by mapping int over its dot-separated parts; versions can contain non-numeric parts."
.language python
.mode steer
.scope include "**/*"

// Ruff RUF048: `map(int, v.split("."))` where v is `__version__` or `x.__version__`, split on "." alone
// (positionally or as `sep=`, nothing else). A version like "1.2.post1" has a part int cannot read.
//   tuple(map(int, __version__.split(".")))           ← RUF048 at the map call
//   tuple(map(int, (__version__.split)(".")))         ← RUF048: parentheses do not matter
//   [*map(int, __version__.split("."))]               ← RUF048
//   x: "map(int, __version__.split('.'))"             ← RUF048: Ruff checks string type definitions too
//   x: "map(int, __version__.split('.' ''))"          ← RUF048: adjacent strings are one, "."
//   tuple(map(int, __version__.split(".", 1)))        not reported: a maxsplit
// `map` and `int` are read where Ruff reads them (python/python-03's ruff_call, ruff_sym).
#include "python/python-03.rerail"

.violation RUF048(at: node) code "RUF048"
    "`int` fails on non-numeric version parts such as `post1`; parse with `packaging.version.parse(...)` instead, unless the version is known to be purely numeric."
    suppress ruff "RUF048"
RUF048(at) :- map_call(c, at), call_nargs(c, 2), call_nkwargs(c, 0), ruff_arg(c, 0, f), ruff_sym(f, "builtins.int"),
    ruff_arg(c, 1, s), unparen(s, sc), split_call(sc), call_nargs(sc, a), call_nkwargs(sc, k), a + k = 1,
    (ruff_arg(sc, 0, d) ; call_kwarg(sc, "sep", d)), unparen(d, ds), plain_str(ds, ".").
// In a type string, with python/python-03's argument relations; a guest's strings have no decoded value, so the
// separator is read by its text.
RUF048(c) :- type_str_node(c), ruff_call(c, "builtins.map"), type_nargs(c, 2), type_nkwargs(c, 0), type_arg(c, 0, f),
    ruff_sym(f, "builtins.int"), type_arg(c, 1, s), unparen(s, sc), split_call(sc), type_nargs(sc, a),
    type_nkwargs(sc, k), a + k = 1, (type_arg(sc, 0, d) ; type_kwarg(sc, "sep", d)), unparen(d, ds), type_dot(ds).
// type_dot(d): a type string's str literal that reads "." by its text: `'.'`, or adjacent ones of which one is `'.'`
// and the others empty (`'.' ''`). The parts are counted as derived rows (python/python-03: aggregates do not see
// a guest's nodes).
.decl type_dot(d: node)
type_dot(d) :- type_str_node(d), kind(d, "string"), type_lit(d, "dot").
type_dot(d) :- type_str_node(d), kind(d, "concatenated_string"), count : { type_part(d, _, "dot") } = 1,
    count : { type_part(d, _, "other") } = 0.
.decl type_part(d: node, s: node, w: symbol)
type_part(d, s, w) :- type_str_node(d), kind(d, "concatenated_string"), child(d, s, _), !kind(s, "comment"),
    type_lit(s, w).
.decl type_lit(s: node, w: symbol)  // "dot" for `'.'`, "empty" for `''`, "other" for anything else
type_lit(s, "dot") :- type_str_node(s), kind(s, "string"), text(s, t), match("[rRuU]?('\\.'|\"\\.\")", t).
type_lit(s, "empty") :- type_str_node(s), kind(s, "string"), text(s, t), match("[rRuU]?(''|\"\")", t).
type_lit(s, "other") :- type_str_node(s), text(s, t), !match("[rRuU]?('\\.'|\"\\.\"|''|\"\")", t).
// map_call(c, at): c calls map, reported at at. In a list, set or tuple display tree-sitter reads `*map(…)` as a
// call of `*map`, where Ruff's parser reads `*` of the call `map(…)`: there the report is at `map`.
.decl map_call(c: node, at: node)
map_call(c, c) :- ruff_call(c, "builtins.map").
map_call(c, m) :- kind(c, "call"), field(c, "function", f), kind(f, "list_splat"), child(f, m, _), kind(m, "identifier"),
    ruff_sym(m, "builtins.map").
// split_call(sc): sc calls `.split` on `__version__` or `x.__version__`, parentheses anywhere.
.decl split_call(sc: node)
split_call(sc) :- kind(sc, "call"), field(sc, "function", m0), unparen(m0, m), attr_of(m, o, "split"), version_name(o).
.decl version_name(o: node)
version_name(o) :- unparen(o, m), kind(m, "identifier"), text(m, "__version__").
version_name(o) :- unparen(o, m), attr_of(m, _, "__version__").

// Review python-03 counterexample: Ruff 0.17.6 reports exactly these lines.
.test concatenated_separator_in_a_type_string exactly
    .fixture "case.py" ```
        value: "map(int, __version__.split('.' ''))"
        ```
    .expect RUF048 at "case.py":1
.end

.test adjacent_separators_in_a_type_string exactly
    .fixture "case.py" ```
        value: "map(int, __version__.split('' '.' ''))"
        other: "map(int, __version__.split('.' 'x'))"
        third: "map(int, __version__.split(r'.'))"
        y = b"a" b"" b"b" if t else b'ab'
        z = b"a" b"c" if t else b"ab"
        ```
    .expect RUF048 at "case.py":1
    .expect RUF048 at "case.py":3
.end
