.policy "ruff-d205-missing-blank-line-after-summary" revision 3
.description "Separate a multi-line docstring's summary line from the description below it with exactly one blank line."
.language python
.mode steer
.scope include "**/*"

// Ruff D205 (pydocstyle): a triple-quoted docstring with more than its summary whose summary line is not
// followed by exactly one blank line. Blank lines before the summary do not count.
//   """Summary.
//   More text."""            ← D205: no blank line
//   """Summary.
//
//   More text."""            not reported
#include "python/docstrings.rerail"

.violation D205(at: node) code "D205"
    "Leave exactly one blank line between this docstring's summary line and the description; if the summary wraps onto a second line, shorten it to fit on one line instead."
    suppress ruff "D205"
// The first non-blank line is the summary. A later non-blank line starts the description; exactly one physical
// line must be blank between them. doc_line treats LF, CRLF and bare CR alike.
.decl d205_summary(s: node, i: number)
d205_summary(s, i) :- doc_checked(s), i = min j : { doc_line(s, j, _), !doc_blank(s, j) }.
.decl d205_gap(s: node, k: number)
d205_gap(s, k) :- d205_summary(s, a),
    z = min j : { doc_line(s, j, _), j > a, !doc_blank(s, j) }, k = z - a - 1.
D205(s) :- doc_triple(s), d205_gap(s, k), k != 1.
