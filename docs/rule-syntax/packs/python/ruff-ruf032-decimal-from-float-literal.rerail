.policy "ruff-ruf032-decimal-from-float-literal" revision 2
.description "Pass Decimal a string instead of a float literal; a float is already rounded, so the decimal value is not the one written."
.language python
.mode steer
.scope include "**/*"

// Ruff RUF032: `decimal.Decimal(1.1)`, a float literal (signed with `+` and `-` any number of times), which is
// rounded to binary before Decimal sees it: Decimal(0.1) is 0.1000000000000000055511151231257827….
//   Decimal(10.0)         ← RUF032  `Decimal("10.0")`
//   Decimal(-+4.0)        ← RUF032
//   Decimal("10.0")       not reported
//   Decimal(~4.0)         not reported: not a signed literal
//   x: "Decimal(1.5)" = 1 ← RUF032: Ruff checks the expressions of string type definitions too
// `Decimal` is read where Ruff reads it (python/python-03's ruff_call): in a function, a class Decimal defined
// below the call is not bound yet, and a module-level rebinding below the function is.
#include "python/python-03.rerail"

.violation RUF032(at: node) code "RUF032"
    "Pass the number as a string, such as `Decimal(\"1.2345\")`, so it keeps the exact decimal value; keep the float only if its exact binary value is intended."
    suppress ruff "RUF032"
RUF032(a) :- ruff_call(c, "decimal.Decimal"), ruff_arg(c, 0, a), signed_float(a).
RUF032(a) :- type_str_node(c), ruff_call(c, "decimal.Decimal"), type_arg(c, 0, a), signed_float(a).
.decl signed_float(e: node)
signed_float(e) :- unparen(e, m), kind(m, "float"), text(m, t), !match("[\\s\\S]*[jJ]", t).
signed_float(e) :- unparen(e, m), kind(m, "unary_operator"), (op(m, "-") ; op(m, "+")), field(m, "argument", a),
    signed_float(a).

// Review python-03 counterexample: Ruff 0.17.6 reports exactly these lines.
.test import_read_before_a_later_local_class exactly
    .fixture "case.py" ```
        from decimal import Decimal
        
        def f():
            value = Decimal(1.0)
            class Decimal: pass
            return value
        ```
    .expect RUF032 at "case.py":4
.end

.test module_rebinding_below_a_function
    .fixture "case.py" ```
        from decimal import Decimal
        from collections import deque
        import math

        def f():
            a = Decimal(1.0)
            b = deque([])
            c = int(math.ceil(1.2))
            d = (math).floor(1.2)
            return a, b, c, d

        Decimal = str
        deque = list
        math = None
        ```
    .expect no RUF032
.end
