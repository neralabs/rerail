.policy "ruff-pth114-os-path-islink" revision 2
.description "Use Path.is_symlink() instead of os.path.islink(); path objects read better than string-based os.path calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH114 (flake8-use-pathlib): a call of `os.path.islink`, however it is imported, with exactly one argument:
// the `path` parameter, by position or by keyword. pathlib's form is `Path(p).is_symlink()`.
// Reported at the callee.
//   os.path.islink(p)               ← PTH114
//   from os.path import islink
//   islink(path=p)                  ← PTH114
//   os.path.islink(*ps)             not reported: Ruff does not look past `*`
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH114(at: node, s: node) code "PTH114"
    "Use `Path({s}).is_symlink()` from pathlib instead of `os.path.islink({s})`; leave it where the argument is a bytes path."
    suppress ruff "PTH114"
PTH114(f, a) :- single_arg(_, "os.path.islink", "path", f, a).
