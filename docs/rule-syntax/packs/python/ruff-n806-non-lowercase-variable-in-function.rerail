.policy "ruff-n806-non-lowercase-variable-in-function" revision 3
.description "Name local variables inside functions in lowercase snake_case, as PEP 8 recommends, so they read differently from classes and constants."
.language python
.mode steer
.scope include "**/*"

// Ruff N806 (pep8-naming): a name stored while Ruff is in a function's own scope (assignment, loop, `with`,
// walrus or match capture target) that, NFKC-normalised, has a letter that is not lowercase. Ruff's scope is where
// the expression runs: a def's or lambda's defaults, and a comprehension's first iterable, run in the scope around
// them; the rest of a comprehension is its own scope. A def's parameter and return annotations are never in a
// function's scope for Ruff (a walrus there is not reported). Exempt: a name the function declares `global`;
// assignments that make a type (namedtuple, NamedTuple, TypedDict, TypeVar, NewType, `X: TypeAlias = …`,
// `type X = …`); Django's `X = apps.get_model(…, "X")` and `X = import_string("….X")`; names matching
// `pep8-naming.ignore-names`.
//   def f():
//       Camel = 0                     ← N806
//       T = TypeVar("T")              not reported
//       Stream = apps.get_model("app", "Stream")    not reported
//       a = [x for x in (Y := g())]   ← N806: the first iterable runs in f
//       match v:
//           case Point(x=Px): ...     ← N806
#include "python/python-19.rerail"

.violation N806(at: node, x: symbol) code "N806"
    "Rename `{x}` to lowercase snake_case and update its uses; keep the name if it holds a class."
    suppress ruff "N806"
N806(n, x) :- n806_store(n, t), n806_scope(n, f), kind(f, "function_definition"), pep8_name(n, x), !pep8_lower(n, x),
    !n806_def_ann(n), !global_name(f, t), !type_store(n), !model_import(n, t), !pep8_ignored(n, x).
// n806_store(n, t): identifier n stores t: store_name's sites, and match captures, which ast keeps as strings.
.decl n806_store(n: node, t: symbol)
n806_store(n, t) :- store_name(n, t, _).
n806_store(n, t) :- py_capture(n), text(n, t).
// n806_scope(n, s): the scope Ruff is in when it visits n: n's nearest scope or comprehension, or, when n is in
// the part of it that runs outside (n806_head), that one's own.
.decl n806_scope(n: node, s: node)
n806_scope(n, s) :- n806_ask(n), nearest(n, s, lscope), !n806_head(n, s).
n806_scope(n, v) :- n806_ask(n), nearest(n, s, lscope), n806_head(n, s), n806_scope(s, v).
.decl n806_ask(n: node)
n806_ask(n) :- n806_store(n, _).
n806_ask(s) :- n806_ask(n), nearest(n, s, lscope), n806_head(n, s).
// n806_head(n, s): n is in a def's or lambda's parameters, or a comprehension's first iterable.
.decl n806_head(n: node, s: node)
n806_head(n, s) :- n806_ask(n), nearest(n, s, lscope), field(s, "parameters", r), within(n, r).
n806_head(n, s) :- n806_ask(n), nearest(n, s, lscope), kind(s, k), comp_scope(k), child(s, c, i), kind(c, "for_in_clause"),
    count : { child(s, d, j), kind(d, "for_in_clause"), j < i } = 0, field(c, "right", r), within(n, r).
// n806_def_ann(n): n is in a def's parameter or return annotation.
//   def f():
//       def g(p: (Aa := int)) -> (Bb := int): ...     not reported
.decl n806_def_ann(n: node)
n806_def_ann(n) :- n806_store(n, _), nearest(n, g, lscope), kind(g, "function_definition"), field(g, "return_type", r),
    within(n, r).
n806_def_ann(n) :- n806_store(n, _), nearest(n, g, lscope), kind(g, "function_definition"), field(g, "parameters", ps),
    child(ps, p, _), field(p, "type", t), within(n, t).
.decl global_name(f: node, x: symbol)  // `global x` in f (not `nonlocal x`)
global_name(f, x) :- decl(f, x, m), kind(m, "module").
.decl type_store(n: node)
type_store(n) :- store_makes(n, _).
type_store(n) :- store_name(n, _, _), inside(n, _, "type_alias_statement").
// model_import(n, x): Django loads model x by name. get_model's model name is its `model_name` keyword or its
// last positional argument; a non-literal name may be anything, so it exempts too. import_string's path is its
// `dotted_path` keyword or its first positional argument.
.decl model_import(n: node, x: symbol)
model_import(n, x) :- model_call(n, x, c), field(c, "function", g), dotted_expr(g, s),
    (s = "get_model" ; suffix(".get_model", s)), model_arg(c, "model_name", v), (value(v, x) ; !kind(v, "string")).
model_import(n, x) :- model_call(n, x, c), field(c, "function", g), sym_of(g, "django.utils.module_loading.import_string"),
    model_arg(c, "dotted_path", v), value(v, p), suffix(cat(".", x), p).
.decl model_call(n: node, x: symbol, c: node)
model_call(n, x, c) :- store_name(n, x, _), store_stmt(n, a), assign_value(a, c), kind(c, "call").
// model_arg(c, k, v): Ruff's find_argument_value: keyword k, else the last (get_model) or first (import_string)
// positional argument.
.decl model_arg(c: node, k: symbol, v: node)
model_arg(c, k, v) :- model_call(_, _, c), (k = "model_name" ; k = "dotted_path"), model_kwarg(c, k, v).
model_arg(c, "model_name", v) :- model_pos(c, v, i), !model_kwarg(c, "model_name", _),
    count : { model_pos(c, _, j), j > i } = 0.
model_arg(c, "dotted_path", v) :- model_pos(c, v, i), !model_kwarg(c, "dotted_path", _),
    count : { model_pos(c, _, j), j < i } = 0.
.decl model_kwarg(c: node, k: symbol, v: node)
model_kwarg(c, k, v) :- model_call(_, _, c), field(c, "arguments", al), child(al, a, _), kind(a, "keyword_argument"),
    field(a, "name", kn), text(kn, k), field(a, "value", v).
.decl model_pos(c: node, v: node, i: number)
model_pos(c, v, i) :- model_call(_, _, c), field(c, "arguments", al), child(al, v, i), !kind(v, "keyword_argument"),
    !kind(v, "comment").
