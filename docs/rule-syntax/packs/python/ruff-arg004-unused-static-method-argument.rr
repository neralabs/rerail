.policy "ruff-arg004-unused-static-method-argument" revision 2
.description "Remove static method parameters the body never reads, or prefix them with an underscore when the signature must stay and no caller passes them by keyword."
.language python
.mode steer
.scope include "**/*"

// Ruff ARG004 (flake8-unused-arguments): a static method's parameter that the body never reads, every
// parameter counted. `__new__` is an implicit static method: its parameters after `cls` are checked under this
// code too. Names matching dummy-variable-rgx, stubs, @abstractmethod, @override, @overload, other dunders and
// defs that call `locals()` are skipped.
//   class C:
//       @staticmethod
//       def f(x): print(1)              ← ARG004 at x
//       def __new__(cls, x): print(1)   ← ARG004 at x
#include "python/misc2-args.rr"
//   options: dummy-variable-rgx, flake8-unused-arguments.ignore-variadic-names (see the library)

.violation ARG004(at: node, name: symbol) code "ARG004"
    "Remove `{name}` if no caller passes it. If the signature must stay, such as to match a base class, prefix it with an underscore, but keep the name when callers pass it by keyword."
    suppress ruff "ARG004"
ARG004(nm, x) :- arg_unused(_, nm, x, "ARG004").
