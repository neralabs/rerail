.policy "ruff-arg005-unused-lambda-argument" revision 3
.description "Remove lambda parameters the body never reads, or prefix them with an underscore when the caller passes them anyway."
.language python
.mode steer
.scope include "**/*"

// Ruff ARG005 (flake8-unused-arguments): a lambda parameter that the body never reads (a default is read in
// the scope around the lambda). Names matching dummy-variable-rgx are left out, and lambdas that call `locals()`
// in their own scope, not in a nested lambda or a comprehension past its first iterable. In a class body Ruff
// checks a lambda whatever it calls.
//   lambda x: print(1)                  ← ARG005 at x
//   lambda _: print(1)                  not reported: a dummy name
//   lambda a: [y for y in locals()]     not reported: locals() in the lambda's scope
//   lambda a, c=a: c                    ← ARG005 at a
#include "python/pt1120-python-07.rerail"
//   options: dummy-variable-rgx, flake8-unused-arguments.ignore-variadic-names (see the library)

.violation ARG005(at: node, name: symbol) code "ARG005"
    "Remove `{name}` if no caller passes it, or prefix it with an underscore if the lambda must accept it; keep the name when callers pass it by keyword."
    suppress ruff "ARG005"
ARG005(nm, x) :- p07_unused(_, nm, x, "ARG005").
