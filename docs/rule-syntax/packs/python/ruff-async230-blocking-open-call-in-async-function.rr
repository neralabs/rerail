.policy "ruff-async230-blocking-open-call-in-async-function" revision 2
.description "Don't open files with open(), io.open or Path.open() inside async functions; use an async file API so file I/O doesn't block the event loop."
.language python
.mode steer
.scope include "**/*"

// Ruff ASYNC230 (flake8-async): opening a file with a blocking call inside an async def: the builtin `open`,
// `io.open`, `io.open_code`, or `.open()` on a `pathlib.Path(…)` call or on a name bound to one.
//   async def f(): open("a")                      ← ASYNC230
//   async def f(): p = Path("a"); p.open()        ← ASYNC230 at p.open
//   async def f(): await anyio.open_file("a")     not reported
#include "python/async-demand.rr"

.violation ASYNC230(at: node) code "ASYNC230"
    "Open this file with an async file API, such as `anyio.open_file()`, `trio.open_file()` or `aiofiles.open()`."
    suppress ruff "ASYNC230"
ASYNC230(f) :- async_blocking(_, f, q), (q = "builtins.open" ; q = "io.open" ; q = "io.open_code").
ASYNC230(f) :- async_open_receiver(f,o), async_path_value(o).
async_api_target("builtins.open"). async_api_target("io.open"). async_api_target("io.open_code").
