.policy "ruff-up007-non-pep604-annotation-union" revision 2
.description "Write union types as X | Y instead of Union[X, Y]; the union operator is shorter and needs no typing import."
.language python
.mode steer
.scope include "**/*"

// Ruff UP007 (pyupgrade): `Union[a, b]` (typing or typing_extensions) where `a | b` works (PEP 604): from
// Python 3.10, in a stub always, and from 3.7 in annotations under `from __future__ import annotations`
// (python/upgrade-typing's rewritable). `Optional[a]` is UP045, not this rule. Not reported:
//   Union[*Ts]                         an unpacked argument has no `|` form
//   Union[NamedTuple, int]             NamedTuple is a type constructor, not a type
//   def f(x: Union["str", int]): ...   a quoted member (or one in a tuple) where the expression runs: "str" | int fails
//   def f(x: Union[str, int]): ...     ← UP007 at the subscript
//   def f(): x: Union["a", "b"]        ← UP007: a local variable's annotation is never evaluated, nor is code under
//                                      `if TYPE_CHECKING:`, a PEP 695 bound or a `type X = …` value
//   def f(x: "Union[str, int]"): ...   ← UP007 inside the string, and in strings Ruff reads as types elsewhere
//                                      (`TypeAliasType("X", "Union[a, b]")`, `cast("Union[a, b]", v)`)
#include "python/python-10.rerail"
#include "python/typing-context.rerail"
//   up_typing_sub(s, x), type_arg(s, i, a), rewritable(n, m) (python/upgrade-typing);
//   str_typing_sub(s, x), str_rewritable(n, m), str_typing_ref(e, x): the same inside strings (python/python-10);
//   tsub(s, h, i, a) (python/typing); typing_only_ctx(n): code Python never evaluates (python/typing-context)

.violation UP007(at: node) code "UP007"
    "Write `Union[X, Y]` as `X | Y`, and drop the `Union` import if nothing else uses it. Leave it where a library reads annotations at runtime on Python below 3.10."
    suppress ruff "UP007"
UP007(s) :- up_typing_sub(s, "Union"), rewritable(s, 10), !unpacked(s), !constructor(s), !quoted_at_runtime(s).
UP007(s) :- str_typing_sub(s, "Union"), str_rewritable(s, 10), !str_unpacked(s), !str_constructor(s),
    str_type(s, s0), !complex_str(s0).
// complex_str(s): Ruff skips a string type whose source is not its value: adjacent strings, or an escape (`\x74`,
// a backslash-newline). UP006 does not: `"Li" "st[int]"` is UP006, `"Union[a, " "b]"` is not UP007.
.decl complex_str(s: node)
complex_str(s) :- str_type(_, s), kind(s, "concatenated_string").
complex_str(s) :- str_type(_, s), kind(s, "string"), match("(?s).*\\\\.*", s).
.decl unpacked(s: node)
unpacked(s) :- type_arg(s, _, a), (kind(a, "list_splat") ; kind(a, "splat_type")).
.decl constructor(s: node)
constructor(s) :- type_arg(s, _, a), typing_ref(a, "NamedTuple").
.decl str_unpacked(s: node)
str_unpacked(s) :- str_typing_sub(s, _), tsub(s, _, _, a), (kind(a, "list_splat") ; kind(a, "splat_type")).
.decl str_constructor(s: node)
str_constructor(s) :- str_typing_sub(s, _), tsub(s, _, _, a), str_typing_ref(a, "NamedTuple").
.decl quoted_at_runtime(s: node)
quoted_at_runtime(s) :- type_arg(s, _, a), quoted(a), !typing_only_ctx(s).
.decl quoted(a: node)  // a string, or a tuple holding one: `Union[("a", "b"), c]`
quoted(a) :- kind(a, "string").
quoted(a) :- kind(a, "concatenated_string").
quoted(t) :- kind(t, "tuple"), child(t, c, _), unparen(c, a), quoted(a).
