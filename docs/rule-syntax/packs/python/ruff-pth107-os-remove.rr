.policy "ruff-pth107-os-remove" revision 2
.description "Use Path.unlink() instead of os.remove(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"

// Ruff PTH107 (flake8-use-pathlib): a call of `os.remove`, however it is imported, with exactly one argument:
// the `path` parameter, by position or by keyword. pathlib's form is `Path(p).unlink()`.
// Reported at the callee.
//   os.remove(p)                    ← PTH107
//   from os import remove
//   remove(path=p)                  ← PTH107
//   os.remove(p, dir_fd=3)          not reported: two arguments
#include "python/pathlib.rr"
//   single_arg(c, q, x, f, a)   c calls q with one argument a, for parameter x; f the callee (python/pathlib)

.violation PTH107(at: node, s: node) code "PTH107"
    "Use `Path({s}).unlink()` from pathlib instead of `os.remove({s})`; leave it where the argument is a bytes path."
    suppress ruff "PTH107"
PTH107(f, a) :- single_arg(_, "os.remove", "path", f, a).
