.policy "ruff-air303-airflow3-incompatible-function-signature" revision 2
.description "Update calls and methods whose Airflow 3 signature changed: pass lineage asset arguments and dataset extras by keyword, and give get_link a ti_key parameter."
.language python
.mode steer
.scope include "**/*"

// Ruff AIR303 (Airflow): a call or method whose signature changed in Airflow 3, in a file that imports airflow.
//   - `HookLineageCollector().create_asset(…)` (or on a name assigned one) with a positional or `*` argument,
//     at the method name;
//   - `Dataset(uri, {…})` or `Asset(uri, {…})` with a dict as the second positional argument (a dict display or
//     comprehension, `dict(…)`, or a name bound once to a dict), at the callee;
//   - a `get_link` method of a BaseOperatorLink subclass that is not `(self, operator, *, ti_key)` or
//     `(self, operator, ti_key)`, at the method name.
//   hlc = HookLineageCollector(); hlc.create_asset("uri")    ← AIR303
//   Dataset("ds1", {"extra": "metadata"})                     ← AIR303: pass `extra=`
//   class L(BaseOperatorLink):
//       def get_link(self, operator, dttm): ...               ← AIR303
#include "python/misc-airflow.rr"
#include "python/ruff-classes.rr"   // class_base_expr

.violation AIR303(at: node, x: symbol, how: symbol) code "AIR303"
    "`{x}` has an incompatible signature in Airflow 3.0: {how}."
    suppress ruff "AIR303"
AIR303(a, "create_asset", "pass positional arguments as keyword arguments (e.g., `create_asset(uri=...)`)") :-
    air303_call(c), field(c, "function", f), unparen(f, g), attr_of(g, o, "create_asset"), field(g, "attribute", a),
    air303_lineage(o), (ruff_arg(c, 0, _) ; call_item(c, s, _), kind(s, "list_splat")).
AIR303(f, x, "use keyword argument `extra` instead of passing a dict as the second positional argument") :-
    air303_call(c), call_q(c, q), (q = "airflow.Dataset" ; q = "airflow.datasets.Dataset" ; q = "airflow.sdk.Asset"),
    split_dot(q, m, x), m != "", ruff_arg(c, 1, a), unparen(a, d), air303_dict(d), field(c, "function", f).
AIR303(n, "get_link", "use `def get_link(self, operator, *, ti_key)` or `def get_link(self, operator, ti_key)`") :-
    kind(f, "function_definition"), field(f, "name", n), text(n, "get_link"), nearest(f, k, scope), kind(k, "class_definition"), class_base_expr(k, b),
    ruff_qual(b, q), match("airflow\\.(models|sdk)(\\..*)?\\.BaseOperatorLink", q), docof(f, d),
    seen_module(d, "airflow"), !air303_link_ok(f).

.decl air303_call(c: node)
air303_call(c) :- kind(c, "call"), docof(c, d), seen_module(d, "airflow").
// air303_lineage(o): o is `HookLineageCollector()`, or a name whose current binding is that call.
.decl air303_lineage(o: node)
air303_lineage(o) :- unparen(o, m), call_q(m, "airflow.lineage.hook.HookLineageCollector").
air303_lineage(o) :- air_instance(o, "airflow.lineage.hook.HookLineageCollector").
.decl air303_dict(d: node)
air303_dict(d) :- kind(d, "dictionary") ; kind(d, "dictionary_comprehension") ; call_q(d, "builtins.dict") ;
    typed_as(d, "dict").
// air303_link_ok(f): two positional parameters and a keyword-only `ti_key`, or three with the third `ti_key`.
.decl air303_link_ok(f: node)
air303_link_ok(f) :- air303_npos(f, 2), sig_param(f, _, nm, _, "kwonly", _, _), text(nm, "ti_key").
air303_link_ok(f) :- air303_npos(f, 3), air303_pos(f, nm, i), text(nm, "ti_key"), count : { air303_pos(f, _, j), j < i } = 2.
.decl air303_pos(f: node, nm: node, i: number)  // a positional parameter (positional-only or not)
air303_pos(f, nm, i) :- sig_param(f, _, nm, i, k, _, _), (k = "posonly" ; k = "pos").
.decl air303_npos(f: node, n: number)
air303_npos(f, n) :- kind(f, "function_definition"), n = count : { air303_pos(f, _, _) }.
