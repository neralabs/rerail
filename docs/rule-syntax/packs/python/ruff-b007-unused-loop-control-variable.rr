.policy "ruff-b007-unused-loop-control-variable" revision 2
.description "Rename for-loop variables the loop body never uses to start with an underscore; it shows the value is deliberately ignored."
.language python
.mode steer
.scope include "**/*"

// Ruff B007 (flake8-bugbear): a for loop's variable that its body never mentions. Rename it with a leading
// underscore to say the value is ignored. Names matching Ruff's dummy-variable pattern (`_`, `_x`) are skipped.
// A body that calls the builtin `locals()`, `globals()`, `vars()`, `exec()` or `eval()` may read it unseen, and
// the message says "may not be used". Any mention counts as a use, even in a nested def or an assignment.
//   for i in range(10):
//       print(10)                         ← B007 at `i`
//   for i, (j, (k, l)) in g(): print(j, l)   ← B007 at `i` and at `k`
//   for foo, bar in xs: f(**locals())     ← B007 "may not be used" at `bar`
#include "python/bugbear-loops.rr"

.violation B007(at: node, x: symbol, what: symbol) code "B007" "Loop control variable `{x}` {what} within loop body"
    suppress ruff "B007"
B007(n, x, w) :- for_stored(f, n, x), !loop_body_name(f, x), !dummy(x), certainty(f, w).
.decl dummy(x: symbol)  // Ruff's default dummy-variable-rgx
dummy(x) :- for_stored(_, _, x), match("_+|_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?", x).
.decl certainty(f: node, w: symbol)
certainty(f, "may not be used") :- kind(f, "for_statement"), reads_by_name(f).
certainty(f, "not used") :- kind(f, "for_statement"), !reads_by_name(f).
.decl reads_by_name(f: node)  // the body calls a builtin that reads variables by name
reads_by_name(f) :- kind(f, "for_statement"), field(f, "body", b), kind(c, "call"), within(c, b),
    field(c, "function", g), builtin_ref(g, x), (x = "locals" ; x = "globals" ; x = "vars" ; x = "exec" ; x = "eval").
