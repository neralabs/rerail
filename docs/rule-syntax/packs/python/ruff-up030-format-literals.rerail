.policy "ruff-up030-format-literals" revision 2
.description "Use automatic {} fields instead of explicit positional indices such as {0} and {1} in str.format() calls."
.language python
.mode steer
.scope include "**/*"

// Ruff UP030 (pyupgrade): `"…".format(…)` on a str literal whose fields are all explicit indices, with no
// nested field in a spec. Indices 0, 1, …, n-1 in order become `{}` as they are. Any other order must be a
// permutation of 0…n-1, and the call must have at least n plain positional arguments and no keywords, so that
// the arguments can be reordered to match.
//   "{0} {1}".format(a, b)        ← UP030: "{} {}".format(a, b)
//   "{1} {0}".format(a, b)        ← UP030: "{} {}".format(b, a)
//   "{0} {0}".format(a)   "{1} {0}".format(*args)   "{0:<{1}}".format(a, 4)     not reported
#include "python/pyflakes-format.rerail"
//   format_call(c, v), brace_ok(c), brace_name, brace_arg, brace_nested; call_pos, call_kw, call_kwsplat

.violation UP030(at: node) code "UP030"
    "Replace the explicit indices (`{{0}}`, `{{1}}`) with automatic `{{}}` fields; if they are out of order, also reorder the arguments to match, unless that would change the order of side effects."
    suppress ruff "UP030"
UP030(c) :- indexed(c), in_order(c).
UP030(c) :- indexed(c), !in_order(c), permutation(c, n), count : { call_pos(c, _, _) } >= n,
    !call_kw(c, _, _), !call_kwsplat(c).

// indexed(c): c's string parses, has fields, every one an index, and none nested in a spec.
.decl indexed(c: node)
indexed(c) :- brace_ok(c), brace_name(c, _, _, _), !brace_nested(c, _, _, _, _, _),
    count : { brace_arg(c, _, a), !match("[0-9]+", a) } = 0.
// index_at(c, r, i): the r-th field of c's string (from 0) refers to argument i.
.decl index_at(c: node, r: number, i: number)
index_at(c, r, to_number(a)) :- indexed(c), brace_arg(c, k, a), r = count : { brace_name(c, k2, _, _), k2 < k }.
.decl in_order(c: node)
in_order(c) :- indexed(c), count : { index_at(c, r, i), r != i } = 0.
// permutation(c, n): c's string's n fields name 0 … n-1, each once.
.decl permutation(c: node, n: number)
permutation(c, n) :- indexed(c), n = count : { index_at(c, _, _) }, count : { index_at(c, _, i), i >= n } = 0,
    count : { index_at(c, r1, i), index_at(c, r2, i), r1 != r2 } = 0.
