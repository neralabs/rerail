.policy "rr-no-node-crosses-files" revision 2
.description "A rule hands a node, line, match or token to the cross-file part: by a cross_file declaration, a place in a node column, a located clause reading an input that names no document, or a recursion through a relation of no location."
.language rr
.mode steer
.scope include "**/*.rerail"

// Decision 0727: no node, line, match or token reaches the cross-file part, as a value of any relation, a finding's
// place included. The split refuses a program that hands one on, and names each relation with its chain; this policy
// finds three of its shapes in the rule files themselves, before a pack runs:
//
//   .decl used_at(n: node, q: symbol) cross_file        ← RR301: a cross-file relation holding a node
//   listed(c, x, @place(f, l)) :- …                     ← RR302: a place in `listed`'s node column names no document,
//                                                          so `locate` moves the relation to the cross part
//   published(d) :- pkg_file(d, …), …, !npm_ignored(f).  ← RR303: `npm_ignored(path)` names no document, so the
//                                                          clause is cross-file, and reads `pkg_file`, a located
//                                                          relation, there; every reader of `published` follows it
//   holds(rel, i, k) :- head_arg(c, …), var_holds(c, …).
//   holds(rel, i, "node") :- declared(rel, i, "node").
//   var_holds(c, x, k) :- body_arg(c, …), holds(…).       ← RR304: a relation of nodes in a recursion through one
//                                                          with no location that a rule fills from no file (the
//                                                          declarations of every file): the cycle is the cross
//                                                          part's, its nodes with it
//
// The fix is 0727's: the cross part derives a relation of names (staged before the files' rules, 0709), and the file
// joins its own nodes to it (`unused(f) :- def(f, q), !used(q).`).
//
// The facts about declarations are relations of names, read from every file (a library declares what a pack reads);
// each finding is made in its clause's own file. No relation of nodes reads one of them through a recursion.

// ---- what the declarations say (names) -------------------------------------------------------------------------

// node_col(rel, i): rel's column i is declared a node, line, match or token.
.decl node_col(rel: symbol, i: number)
node_col(rel, i) :- (kind(d, "declaration") ; kind(d, "violation_declaration")), field(d, "name", n), text(n, rel),
    field(d, "columns", cl), child(cl, col, i), field(col, "type", ty), field(ty, "name", tn), text(tn, t),
    (t = "node" ; t = "line" ; t = "match" ; t = "token").

// holds_node(rel): some column of rel is one.
.decl holds_node(rel: symbol)
holds_node(rel) :- node_col(rel, _).

// located_col(rel): some column of rel is a node, or a document key (a number named `d`, `doc` or `document`, as
// the libraries name them): a read of it can be placed. Any number was too loose: `holds(rel, i, k)`'s `i` is a
// column's index, and its recursion was not found.
.decl located_col(rel: symbol)
located_col(rel) :- holds_node(rel).
located_col(rel) :- kind(d, "declaration"), field(d, "name", n), text(n, rel), field(d, "columns", cl), child(cl, col, _),
    field(col, "type", ty), field(ty, "name", tn), text(tn, "number"), field(col, "name", cn), text(cn, x),
    (x = "d" ; x = "doc" ; x = "document").

// input_rel(rel): a `.input` directive names rel.
.decl input_rel(rel: symbol)
input_rel(rel) :- kind(io, "io_directive"), text(io, s), match("\\s*\\.input\\b.*", s), child(io, r, _), kind(r, "io_relation"),
    text(r, rel).

// nowhere_input(rel): an input none of whose columns places a row (`npm_ignored(path: symbol)`): every reader of it
// reads it with no location. Not core.rerail's own (`option`, `unset`, `file`, …): the run binds those once, as
// constants or functions, and a rule reading one joins no document by it.
.decl nowhere_input(rel: symbol)
nowhere_input(rel) :- input_rel(rel), kind(d, "declaration"), field(d, "name", n), text(n, rel), !located_col(rel),
    !core_decl(rel), !bound_by_run(rel).
// bound_by_run(rel): an input the run binds once beside every chunk, as core's are, though a library declares it:
// the selected tree (`phased::SELECTION`), the host's grammar registry, a program image's kind sets (`view::Given`).
.decl bound_by_run(rel: symbol)
bound_by_run("git_inventory_selection"). bound_by_run("git_inventory_host_registry"). bound_by_run("img_kindset").
.decl core_decl(rel: symbol)
core_decl(rel) :- kind(d, "declaration"), field(d, "name", n), text(n, rel), docof(d, f), doc(f, p, _),
    match("(?:.*/)?core\\.rerail", p).

// reads_in(f, h, x): in rule file f, a clause of h reads x (positively, negated, or in an aggregate). By the file:
// relation names are a program's, and across the tree one name is many relations (`root`, `named`, `decl`), whose
// reads made cycles no program has.
.decl reads_in(f: number, h: symbol, x: symbol)
reads_in(f, h, x) :- kind(c, "clause"), docof(c, f), field(c, "head", hd), field(hd, "relation", r), text(r, h),
    field(c, "body", b), kind(a, "atom"), within(a, b), field(a, "relation", ar), text(ar, x).

// node_rel_in(f, rel): file f declares rel with a node, line, match or token column (by the file: one name is
// many relations across the tree).
.decl node_rel_in(f: number, rel: symbol)
node_rel_in(f, rel) :- (kind(d, "declaration") ; kind(d, "violation_declaration")), docof(d, f), field(d, "name", n),
    text(n, rel), field(d, "columns", cl), child(cl, col, _), field(col, "type", ty), field(ty, "name", tn), text(tn, t),
    (t = "node" ; t = "line" ; t = "match" ; t = "token").

// unplaced_rule(f, y): in file f, a clause of y reads no located relation: its rows are of no file (`holds(rel, i,
// "node") :- declared(rel, i, "node")`, declarations read from every file). Its relation is the cross part's.
.decl unplaced_rule(f: number, y: symbol)
unplaced_rule(f, y) :- kind(c, "clause"), docof(c, f), field(c, "head", hd), field(hd, "relation", r), text(r, y),
    field(c, "body", b), count : { kind(a, "atom"), within(a, b), field(a, "relation", ar), text(ar, x), located_col(x) } = 0.

// unplaced_read(f, y): in file f, a relation of nodes reads y, a relation with no location column (not core's), one
// of whose rules reads no located relation.
.decl unplaced_read(f: number, y: symbol)
unplaced_read(f, y) :- reads_in(f, h, y), node_rel_in(f, h), declared(y), !located_col(y), !core_decl(y), unplaced_rule(f, y).

// reach(f, y, x): in file f, unplaced_read y reads x, directly or through the relations it reads there (from those
// alone: the closure of every relation was the whole tree's pairs, past 4 GB).
.decl reach(f: number, y: symbol, x: symbol)
reach(f, y, x) :- unplaced_read(f, y), reads_in(f, y, x).
reach(f, y, x) :- reach(f, y, z), reads_in(f, z, x).

// declared(rel): a `.decl` names rel (an undeclared name is a library's or an error, which the checker reports).
.decl declared(rel: symbol)
declared(rel) :- kind(d, "declaration"), field(d, "name", n), text(n, rel).

// plain_node_col(rel, i): node_col from a `.decl`: a relation a rule reads on, not a finding (a finding's `@place`
// is placed by its path, as `.violation` says).
.decl plain_node_col(rel: symbol, i: number)
plain_node_col(rel, i) :- node_col(rel, i), kind(d, "declaration"), field(d, "name", n), text(n, rel).

// ---- the findings (each in its clause's file) ------------------------------------------------------------------

.violation cross_node(at: node, rel: symbol) code "RR301"
    "`{rel}` is declared cross_file and holds a node, line, match or token (decision 0727): derive a relation of names in the cross part, and join the file's nodes to it in a per-file rule"
cross_node(q, rel) :- kind(d, "declaration"), field(d, "name", n), text(n, rel), child(d, q, _), kind(q, "identifier"),
    text(q, "cross_file"), q != n, node_col(rel, _).

.violation place_in_node(at: node, rel: symbol, i: number) code "RR302"
    "`@place` in `{rel}`'s column {i}, declared a node: a place names no document, so the relation is moved to the cross-file part with its nodes (decision 0727). Keep the rule's node there, or give the place a relation of its own"
place_in_node(a, rel, i) :- kind(c, "clause"), field(c, "head", h), field(h, "relation", r), text(r, rel),
    field(h, "arguments", al), child(al, a, i), kind(a, "functor_call"), child(a, f, _), kind(f, "identifier"),
    text(f, "place"), plain_node_col(rel, i).

.violation reads_nowhere(at: node, rel: symbol, input: symbol) code "RR303"
    "`{rel}` reads `{input}`, an input that names no document, beside a located relation: the clause is cross-file, and reads that relation there (decision 0727). Key the input by a document or path (a setting, `.keyed … by_path`), or read it in a relation of names the file joins"
reads_nowhere(a, rel, x) :- kind(c, "clause"), field(c, "head", h), field(h, "relation", r), text(r, rel),
    field(c, "body", b), kind(a, "atom"), within(a, b), field(a, "relation", ar), text(ar, x), nowhere_input(x),
    kind(a2, "atom"), within(a2, b), field(a2, "relation", ar2), text(ar2, y), located_col(y).

.violation recursion_of_nowhere(at: node, rel: symbol, through: symbol) code "RR304"
    "`{rel}` holds a node and recurses through `{through}`, a relation with no location column that a rule fills from no file: the cycle is the cross part's, and `{rel}`'s nodes with it (decision 0727). Keep the rows of no file in a relation of their own, outside the recursion, and follow the file's own in the file (key `{through}` by the clause's node or document)"
recursion_of_nowhere(a, rel, y) :- kind(c, "clause"), docof(c, f), field(c, "head", h), field(h, "relation", r),
    text(r, rel), node_rel_in(f, rel), field(c, "body", b), kind(a, "atom"), within(a, b), field(a, "relation", ar),
    text(ar, y), unplaced_read(f, y), reach(f, y, rel).
