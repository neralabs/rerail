.policy "rr-cross-part-reads-a-base-relation" revision 2
.description "A cross-file relation's rule reads a base relation: the cross part reads none (decision 0727)."
.language rr
.mode steer
.scope include "**/*.rerail"

// Decision 0727: no node, line, match or token crosses into the cross part, and the cross part reads no base
// relation. A document's own facts (`doc`, `kind`, `text`, `tape_of`, ...) are read in its file's rules; what crosses
// is what those rules derive from them: a relation of module names, of paths, of document keys.
//
//   .decl dep(a: number, b: number) cross_file
//   dep(a, b) :- dep_from(a, m), doc(b, _, m).        ← RR301 at doc: dep is cross-file
//
//   .decl mod_doc(d: number, m: symbol)
//   mod_doc(d, m) :- doc(d, _, m).                    each file's own row
//   dep(a, b) :- dep_from(a, m), mod_doc(b, m).       fine: the cross part reads what the files derived
//
// The engine refuses such a program when it runs it (`corpus.rs`, "the cross-file part reads the base
// relation(s)"); this finds the rules without running them. What is cross-file is what is declared so (decision
// 0729): `cross_file`, or `staged` (a cross-file relation of names). Nothing becomes cross-file by reading one.

// Each library file (`lib/`) is one program, the library, whose relations every other file sees; each other file is
// a program of its own beside it. What this rule hands from file to file is relations of names alone.

// ---- each file's program ---------------------------------------------------------------------------------------

// xb_lib(p): p is a library file: the library is one program.
.decl xb_lib(p: symbol)
xb_lib(p) :- doc(_, p, _), match("(?:.*/)?lib/.*", p).

// xb_key(d, k): document d's rules are program k's: "lib" for the library, else its own path.
.decl xb_key(d: doc, k: symbol)
xb_key(d, "lib") :- doc(d, p, _), xb_lib(p).
xb_key(d, p) :- doc(d, p, _), !xb_lib(p).

// ---- what each program declares -------------------------------------------------------------------------------

// xb_declared(k, r): program k declares r (a `.decl`).
.decl xb_declared(k: symbol, r: symbol)
xb_declared(k, r) :- kind(x, "declaration"), field(x, "name", n), text(n, r), docof(x, d), xb_key(d, k).

// xb_decl_cross(k, r): program k declares r `cross_file`.
.decl xb_decl_cross(k: symbol, r: symbol)
xb_decl_cross(k, r) :- kind(x, "declaration"), field(x, "name", n), text(n, r), field(x, "modifier", w),
    text(w, "cross_file"), docof(x, d), xb_key(d, k).

// xb_decl_cross(k, r): program k declares r `staged`, a cross-file relation of names (decision 0729).
xb_decl_cross(k, r) :- kind(x, "declaration"), field(x, "name", n), text(n, r), field(x, "modifier", w),
    text(w, "staged"), docof(x, d), xb_key(d, k).

// ---- the base relations ----------------------------------------------------------------------------------------

// xb_base(r): a document's own facts: what core.rerail lists as `.input`, but the repository's facts and the
// functions of strings (`parse_of`, `split_dot`), which are no document's.
.decl xb_base(r: symbol)
xb_base(r) :- kind(io, "io_directive"), text(io, s), match("\\.input.*", s), field(io, "relation", ir),
    field(ir, "name", n), text(n, r), docof(io, d), doc(d, p, _), match("(?:.*/)?lib/core\\.rerail", p),
    !xb_repository(r).

.decl xb_repository(r: symbol)
xb_repository("git_root_repo").
xb_repository("git_root_view").
xb_repository("git_repository").
xb_repository("git_source_tree").
xb_repository("git_source_commit").
xb_repository("git_rev").
xb_repository("source_grammar_suffix").
xb_repository("source_grammar_registry").
xb_repository("source_tape_version").
xb_repository("file").
xb_repository("package").
xb_repository("package_export").
xb_repository("package_for").
xb_repository("package_field").
xb_repository("tsconfig").
xb_repository("tsconfig_for").
xb_repository("tsconfig_path").
xb_repository("option").
xb_repository("option_item").
xb_repository("signed_list").
xb_repository("input_error").
xb_repository("parse_of").
xb_repository("unparse_of").
xb_repository("splice_of").
xb_repository("split_dot").

// ---- what is cross-file ----------------------------------------------------------------------------------------

// xb_prog(k): k is a program.
.decl xb_prog(k: symbol)
xb_prog(k) :- xb_key(_, k).

// xb_cross(k, r): r as program k reads it is declared cross-file: by its own declaration, else the library's.
.decl xb_cross(k: symbol, r: symbol)
xb_cross(k, r) :- xb_decl_cross(k, r).
xb_cross(k, r) :- xb_prog(k), xb_decl_cross("lib", r), !xb_declared(k, r).

// ---- the finding -----------------------------------------------------------------------------------------------

// xb_base_read(a, k, h, r): atom a, of base relation r, is in the body of a rule of program k with head h.
.decl xb_base_read(a: node, k: symbol, h: symbol, r: symbol)
xb_base_read(a, k, h, r) :- kind(c, "clause"), field(c, "head", hd), field(hd, "relation", hn), text(hn, h),
    field(c, "body", b), kind(a, "atom"), within(a, b), field(a, "relation", an), text(an, r), docof(c, d),
    xb_key(d, k), xb_base(r).

.violation cross_base_read(at: node, h: symbol, r: symbol) code "RR301"
    "A cross-file relation's rule reads this base relation: the cross part reads none (decision 0727). Read the document's facts in its file's own rules and join what they derive (a relation of names or of document keys)"
cross_base_read(a, h, r) :- xb_base_read(a, k, h, r), xb_cross(k, h).
