.policy "django-practice-save-ignores-update-fields" revision 1
.description "When a model's save() override sets a field before calling super().save(), add that field to update_fields when the caller gave one."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. It matches a `save` method written in a Django model (reported at its name) that
// calls `super().save(...)` forwarding the caller's `**kwargs` after assigning `self.<field> = …` for a field the
// model (or a model base in the run) declares, or a foreign key's `<fk>_id`, when nothing in the method mentions
// `update_fields` (a parameter, a `kwargs["update_fields"]` read, a string) and the method never rebinds its
// `**kwargs` (`kwargs = helper(kwargs)` may add to update_fields). With `save(update_fields=[...])`, and with every
// update_or_create() since Django 4.2, the assigned field is then not written.
// It leaves alone assignments and calls made only when the row is new: under an `if` or `elif` testing
// `not self.pk`, `self.pk is None`, `self._state.adding`, `not self.present_in_database`, `kwargs.get("force_insert")`
// (alone or before `and`, or a local set from one of these); in the `elif`/`else` branches of an `if` testing that
// the row exists (`if self.pk:`, `if self.pk is not None:`, `if not self._state.adding:`, `if self.present_in_database:`);
// and after such an `if` whose body returns. An insert writes every field whatever update_fields says.
//   def save(self, *args, **kwargs):                           reported
//       self.slug = slugify(self.title)
//       super().save(*args, **kwargs)
//   def save(self, *args, update_fields=None, **kwargs): ...   not reported: handles update_fields

#include "python/django.rerail"

.violation SaveIgnoresUpdateFields(at: node, fields: symbol) "This save() sets {fields} and then passes the caller's arguments to super().save(); when the caller gives `update_fields` (save(update_fields=...), and every update_or_create() since Django 4.2), that change is silently not written. If update_fields is given, add the fields you set to it before calling super().save(); if the value is set only for a new row, test `self._state.adding` around it."
SaveIgnoresUpdateFields(n, fs) :- siuf_save(f), field(f, "name", n),
    fs = join q by x sep ", " : { siuf_sets(f, x), q = cat("`self.", x, "`") }, fs != "".

// siuf_call(f, s): s is a `super().save(..., **kwargs)` call whose own def (its nearest dj_region_stop) is model
// method `save` f, not only for a new row.
.decl siuf_call(f: node, s: node)
siuf_call(f, s) :- kind(s, "call"), field(s, "function", e), attr_of(e, o, "save"), kind(o, "call"), field(o, "function", sp),
    text(sp, "super"), field(s, "arguments", al), child(al, k, _), kind(k, "dictionary_splat"),
    nearest(s, f, dj_region_stop), dj_model_method(_, f, "save"), !siuf_insert_only(s, f).
// siuf_save(f): f has such a call, never mentions update_fields, never rebinds its **kwargs, and is not test or
// migration code.
.decl siuf_save(f: node)
siuf_save(f) :- siuf_call(f, _), !siuf_mentions(f), !siuf_rebinds(f), docof(f, d), !dj_test_doc(d), !dj_migration_doc(d).
.decl siuf_mentions(f: node)
siuf_mentions(f) :- kind(n, "identifier"), text(n, "update_fields"), within(n, f), siuf_call(f, _).
siuf_mentions(f) :- kind(n, "string"), str(n, "update_fields"), within(n, f), siuf_call(f, _).
.decl siuf_rebinds(f: node)
siuf_rebinds(f) :- siuf_call(f, _), field(f, "parameters", ps), child(ps, p, _), kind(p, "dictionary_splat_pattern"),
    child(p, i, 0), text(i, k), kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, k),
    nearest(a, f, dj_region_stop).
// siuf_sets(f, x): before a forwarding call, save method f assigns `self.x` for a field x of its model (dj_attname:
// declared in it or a base class of the run, or `x_id` for a foreign key x), outside a new-row-only branch.
.decl siuf_sets(f: node, x: symbol)
siuf_sets(f, x) :- siuf_assign(a, x), nearest(a, f, dj_region_stop), siuf_save(f), siuf_call(f, s), earlier(a, s),
    dj_model_method(c, f, "save"), dj_attname(c, x, _), !siuf_insert_only(a, f).
.decl siuf_assign(a: node, x: symbol)
siuf_assign(a, x) :- (kind(a, "assignment") ; kind(a, "augmented_assignment")), field(a, "left", l), attr_of(l, o, x),
    text(o, "self").
// siuf_insert_only(n, f): n runs in save method f only for a new row: in the body of an `if`/`elif` whose test says
// the row is new, in the `elif`/`else` branches of an `if` whose test says it exists, or after such an `if` whose
// body returns.
.decl siuf_insert_only(n: node, f: node)
siuf_insert_only(n, f) :- siuf_new_if(i, f), field(i, "consequence", t), within(n, t).
siuf_insert_only(n, f) :- siuf_old_if(i, f), field(i, "alternative", t), within(n, t).
siuf_insert_only(n, f) :- siuf_old_if(i, f), field(i, "consequence", t), child(t, r, _), kind(r, "return_statement"),
    precedes(i, st), (n = st ; within(n, st)).
// siuf_new_if(i, f): `if` statement or `elif` clause i in save method f tests for a new row (siuf_new_test), or tests
// a local set to such a test, alone or before `and` (`is_new = self.pk is None` … `if is_new and not self.x:`).
.decl siuf_new_if(i: node, f: node)
siuf_new_if(i, f) :- (kind(i, "if_statement") ; kind(i, "elif_clause")), field(i, "condition", cnd), node_text(cnd, s),
    siuf_new_test(p), match(p, s), nearest(i, f, dj_region_stop), dj_model_method(_, f, "save").
siuf_new_if(i, f) :- siuf_new_local(f, x), (kind(i, "if_statement") ; kind(i, "elif_clause")), nearest(i, f, dj_region_stop),
    field(i, "condition", cnd), node_text(cnd, s), (s = x ; prefix(cat(x, " and "), s)).
// siuf_old_if(i, f): `if` statement i in save method f tests, with nothing else, that the row already exists.
.decl siuf_old_if(i: node, f: node)
siuf_old_if(i, f) :- kind(i, "if_statement"), field(i, "condition", cnd), node_text(cnd, s), siuf_old_test(p), match(p, s),
    nearest(i, f, dj_region_stop), dj_model_method(_, f, "save").
.decl siuf_old_test(p: symbol)
siuf_old_test("^(bool\\()?self\\.(pk|id)\\)?$"). siuf_old_test("^self\\.(pk|id) +is +not +None$").
siuf_old_test("^not +self\\._state\\.adding$"). siuf_old_test("^self\\.present_in_database$").
// siuf_new_local(f, x): save method f assigns local x a new-row test.
.decl siuf_new_local(f: node, x: symbol)
siuf_new_local(f, x) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", r),
    node_text(r, s), siuf_new_test(p), match(p, s), nearest(a, f, dj_region_stop), dj_model_method(_, f, "save").
// siuf_new_test(p): the test is true only for a row not yet in the database, whatever follows an `and`.
.decl siuf_new_test(p: symbol)
siuf_new_test("^not +(bool\\()?self\\.(pk|id)\\)?( +and .*)?$"). siuf_new_test("^self\\.(pk|id) +is +None( +and .*)?$").
siuf_new_test("^self\\._state\\.adding( +and .*)?$"). siuf_new_test("^not +self\\.present_in_database( +and .*)?$").
siuf_new_test("^kwa?r?g?s?\\.get\\(.force_insert.[^)]*\\)( +and .*)?$").
siuf_new_test("^not +self\\.(pk|id) +or +kwa?r?g?s?\\.get\\(.force_insert.[^)]*\\)$").

// The cases, `cases/django-practice-save-ignores-update-fields/`, read as one repository: each line ending in `#
// caught` is reported, and no other line.
.test cases exactly
    .fixture "blog/base.py" from "cases/django-practice-save-ignores-update-fields/blog/base.py"
    .fixture "blog/branches.py" from "cases/django-practice-save-ignores-update-fields/blog/branches.py"
    .fixture "blog/models.py" from "cases/django-practice-save-ignores-update-fields/blog/models.py"
    .fixture "blog/tests/test_models.py" from "cases/django-practice-save-ignores-update-fields/blog/tests/test_models.py"
    .expect _ at "blog/branches.py":42
    .expect _ at "blog/branches.py":65
    .expect _ at "blog/models.py":19
    .expect _ at "blog/models.py":30
    .expect _ at "blog/models.py":39
    .expect _ at "blog/models.py":48
    .expect _ at "blog/models.py":145
    .expect _ at "blog/models.py":180
.end
