.policy "django-practice-async-request-user" revision 1
.description "Inside async def, get the user with await request.auser() instead of reading request.user."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. request.user is a lazy object: its first use loads the session and the user from the
// database, synchronously, which raises SynchronousOnlyOperation in a coroutine unless a sync middleware happened to
// resolve it first. It matches a read of `request.user` (or `getattr(request, "user")`) in the body of an
// `async def` and not inside a nested def, lambda or class, where `request` is a function's parameter, or
// `self.request` in a method, in a file that imports Django or DRF (python/django's dj_django_doc: Starlette and
// other ASGI frameworks have a `request.user` of their own). A `request.user` passed whole to `sync_to_async(f)(...)`
// is only handed to the thread, not evaluated, so it is left alone.
//   async def view(request): if request.user.is_authenticated: ...      reported
//   async def get(self, request): user = self.request.user               reported
//   async def view(request): user = await request.auser()               not reported
//   async def view(request): await sync_to_async(check)(request.user)   not reported: evaluated in the thread
//   async def view(request): await sync_to_async(lambda: request.user.pk)()   not reported: the lambda runs in a thread
//   async def middleware(request): request.user = SimpleLazyObject(...)   not reported: a write
//   async def me(request): request.user.display_name   in a Starlette file: not reported

#include "python/django.rerail"

.violation AsyncRequestUser(at: node) "`request.user` is a lazy object whose first use queries the session and user tables synchronously, which raises SynchronousOnlyOperation inside `async def` unless a sync middleware already resolved it. Use `user = await request.auser()` (Django 5.0+) and read the user from that. If your own middleware always sets `request.user` to a loaded user, this read is safe, but `await request.auser()` still keeps the view independent of that."
AsyncRequestUser(a) :- attr_of(a, o, "user"), aru_request(o), expr_ctx(a, "load"), aru_in_async(a), !aru_handed_off(a).
AsyncRequestUser(c) :- kind(c, "call"), field(c, "function", f), sym_of(f, "builtins.getattr"), posarg(c, 0, o),
    aru_request(o), posarg(c, 1, k), str(k, "user"), aru_in_async(c).

// aru_request(o): o is the request: a name `request` bound as a function's parameter, or `self.request`.
.decl aru_request(o: node)
aru_request(o) :- kind(o, "identifier"), text(o, "request"), look(o, "request", f), param(f, "request", _).
aru_request(o) :- attr_of(o, s, "request"), kind(s, "identifier"), text(s, "self").
// aru_in_async(n): n runs in an async def's own frame, in a Django file outside test code.
.decl aru_in_async(n: node)
aru_in_async(n) :- nearest(n, f, dj_region_stop), is_async(f), docof(n, d), dj_django_doc(d), !dj_test_doc(d).
// aru_handed_off(a): a is a whole argument of `sync_to_async(f)(...)` or `database_sync_to_async(f)(...)`.
.decl aru_handed_off(a: node)
aru_handed_off(a) :- call_name(w, x), (x = "sync_to_async" ; x = "database_sync_to_async"), field(c, "function", w),
    call_arg(c, _, _, v), unparen(v, a).

// The cases, `cases/django-practice-async-request-user/`, read as one repository: each line ending in `# caught` is
// reported, and no other line.
.test cases exactly
    .fixture "api/app.py" from "cases/django-practice-async-request-user/api/app.py"
    .fixture "shop/api/drf.py" from "cases/django-practice-async-request-user/shop/api/drf.py"
    .fixture "shop/tests/test_views.py" from "cases/django-practice-async-request-user/shop/tests/test_views.py"
    .fixture "shop/views.py" from "cases/django-practice-async-request-user/shop/views.py"
    .expect _ at "shop/api/drf.py":7
    .expect _ at "shop/views.py":7
    .expect _ at "shop/views.py":9
    .expect _ at "shop/views.py":13
    .expect _ at "shop/views.py":19
    .expect _ at "shop/views.py":20
    .expect _ at "shop/views.py":26
.end
