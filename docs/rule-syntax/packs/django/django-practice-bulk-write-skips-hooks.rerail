.policy "django-practice-bulk-write-skips-hooks" revision 1
.description "A queryset bulk write skips the model's save()/delete() overrides and its pre_save/post_save receivers; call them or do their work."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. Django's bulk writes run SQL directly: `update()`, `bulk_create()` and
// `bulk_update()` call no save() and send no pre_save/post_save; `delete()` on a queryset calls no delete() method
// (it still sends pre_delete/post_delete). A bulk write on `M.objects…` is reported when M, or a base class of M in
// the run, overrides the method the write skips with more than a bare base-class call (`super().save(…)`,
// `models.Model.save(self, …)`), or when a pre_save/post_save receiver for `sender=M` is connected anywhere in the
// run (`@receiver(post_save, sender=M)`, `post_save.connect(fn, sender=M)`). The message names each skipped hook and
// where it is defined. It leaves alone an `update()` whose every value is `F("x") ± n` on its own field x: an atomic
// counter bump, the write Django documents for counters (and django-practice-read-modify-write recommends).
//   Book.objects.filter(x=1).update(y=2)       reported when Book.save() sets a slug, or a post_save for Book exists
//   Book.objects.bulk_create(books)            reported likewise
//   Book.objects.filter(x=1).delete()          reported only when Book (or a base) overrides delete()
//   Note.objects.filter(x=1).update(y=2)       not reported: Note has no save() override and no receiver
//   Book.objects.filter(pk=pk).update(views=F("views") + 1)   not reported: a counter bump
//   in Book.save() or a Book receiver: Book.objects.filter(pk=self.pk).update(slug=s)   not reported: the hook itself
// Migrations and tests are skipped.
// Gaps: querysets not rooted at a manager name (related managers, `self.get_queryset()`, a queryset in a variable);
// string senders (`sender="app.Model"`); hooks in base classes outside the run; a counter bump whose model's hooks
// do depend on that counter.

#include "python/django.rerail"

.violation BulkWriteSkipsHooks(at: node, op: symbol, model: symbol, hooks: symbol) "`{op}()` writes {model} rows in bulk and skips {hooks}. Django's bulk writes call no save()/delete() method and send no pre_save/post_save signal; if this write needs that work, do it here or save the objects one by one (for a counter, `obj.n = F(\"n\") + 1` then `obj.save()`, so no concurrent change is lost)."

BulkWriteSkipsHooks(c, m, mn, hs) :- dj_qs_call(c, m), bwh_skips(m, k), field(c, "function", fn), attr_of(fn, o, _),
    dj_qs_model(o, mc), class_def(mc, mq), def_name(mc, mn), bwh_hook(mq, k, _), !bwh_in_hook(c, mq),
    !bwh_counter_update(c), docof(c, d), !dj_test_doc(d), !path_part(d, "unittests"), !dj_migration_doc(d),
    hs = join h by h sep "; " : { bwh_hook(mq, k, h) }, hs != "".

// bwh_counter_update(c): c is `….update(x=F("x") + n, …)`, every value an F() of its own field plus or minus
// something: the database does the arithmetic, the documented way to bump a counter.
.decl bwh_counter_update(c: node)
bwh_counter_update(c) :- dj_qs_call(c, "update"), field(c, "arguments", al), child(al, a, _), bwh_counter_kw(a),
    !bwh_other_arg(c).
.decl bwh_other_arg(c: node)
bwh_other_arg(c) :- dj_qs_call(c, "update"), field(c, "arguments", al), child(al, a, _), !kind(a, "comment"),
    !bwh_counter_kw(a).
.decl bwh_counter_kw(a: node)
bwh_counter_kw(a) :- kind(a, "keyword_argument"), field(a, "name", n), text(n, x), field(a, "value", v), unparen(v, b),
    kind(b, "binary_operator"), (op(b, "+") ; op(b, "-")), child(b, e, _), bwh_f_of(e, x).
.decl bwh_f_of(e: node, x: symbol)
bwh_f_of(e, x) :- kind(e, "call"), field(e, "function", fn), sym_of(fn, q),
    (q = "django.db.models.F" ; q = "django.db.models.expressions.F"), posarg(e, 0, a), str(a, x).

// bwh_skips(m, k): queryset method m skips the hooks of kind k ("save" or "delete").
.decl bwh_skips(m: symbol, k: symbol)
bwh_skips("update", "save"). bwh_skips("bulk_create", "save"). bwh_skips("bulk_update", "save").
bwh_skips("delete", "delete").

// bwh_method(mq, x, f): model class mq, or a class it inherits from in the run, defines method x as f.
// Cross-file (decision 0652): the method may be a base class's, in another file than the model.
.decl bwh_method(mq: symbol, x: symbol, f: node) cross_file
bwh_method(mq, x, f) :- class_def(mc, mq), dj_model(mc), (x = "save" ; x = "delete"), method(mq, x, f).
bwh_method(mq, x, f) :- class_def(mc, mq), dj_model(mc), (x = "save" ; x = "delete"), subclass(mq, b), method(b, x, f).
// bwh_bare_super(f): f's body, its docstring aside, is one statement calling the base class's method of f's name,
// maybe returned: `super().<name>(…)`, or the old style `models.Model.<name>(self, …)`.
.decl bwh_bare_super(f: node)
bwh_bare_super(f) :- def_name(f, x), field(f, "body", b), bwh_code_len(f, b, 1), body_stmt(b, s, _), !doc_stmt(s, _),
    text(s, t), match(cat("(?s)(return\\s+)?(super\\([^)]*\\)\\.", x, "\\(.*\\)|[\\w.]+\\.", x, "\\(\\s*self\\b.*\\))"), t).
.decl bwh_code_len(f: node, b: node, k: number)
bwh_code_len(f, b, k) :- field(f, "body", b), body_len(b, n), docstring(f, _), k = n - 1.
bwh_code_len(f, b, k) :- field(f, "body", b), body_len(b, k), !docstring(f, _).

// bwh_signal(e, x): e names Django's model signal x, pre_save or post_save.
.decl bwh_signal(e: node, x: symbol)
bwh_signal(e, x) :- sym_of(e, q), split_dot(q, "django.db.models.signals", x), (x = "pre_save" ; x = "post_save").
// bwh_receiver(mq, x, f, at): f receives signal x for sender mq, connected at `at`: a `@receiver(sig, sender=M)`
// decorator (sig maybe a list or tuple), or `sig.connect(f, sender=M)`.
.decl bwh_receiver(mq: symbol, x: symbol, fname: symbol, f: node, at: node)
bwh_receiver(mq, x, fname, f, e) :- decorator(f, e), kind(e, "call"), field(e, "function", rf), sym_of(rf, rq),
    (rq = "django.dispatch.receiver" ; rq = "django.dispatch.dispatcher.receiver"), posarg(e, 0, a),
    bwh_sig_arg(a, x), call_arg(e, -1, "sender", v), sym_of(v, mq), def_name(f, fname).
bwh_receiver(mq, x, fname, c, c) :- kind(c, "call"), field(c, "function", fn), attr_of(fn, o, "connect"),
    bwh_signal(o, x), call_arg(c, -1, "sender", v), sym_of(v, mq), bwh_connected(c, a), text(a, fname).
.decl bwh_connected(c: node, a: node)
bwh_connected(c, a) :- posarg(c, 0, a).
bwh_connected(c, a) :- call_arg(c, -1, "receiver", a).
.decl bwh_sig_arg(a: node, x: symbol)
bwh_sig_arg(a, x) :- bwh_signal(a, x).
bwh_sig_arg(a, x) :- (kind(a, "list") ; kind(a, "tuple")), child(a, e, _), bwh_signal(e, x).

// bwh_hook(mq, k, h): h describes a hook of kind k on model mq that a bulk write skips.
.decl bwh_hook(mq: symbol, k: symbol, h: symbol)
bwh_hook(mq, x, h) :- bwh_method(mq, x, f), !bwh_bare_super(f), nearest(f, cb, scope), def_name(cb, cn),
    bwh_place(f, p), h = cat(cn, ".", x, "() (", p, ")").
bwh_hook(mq, "save", h) :- bwh_receiver(mq, _, fname, _, at), docof(at, d), !dj_test_doc(d), bwh_place(at, p),
    s = join x by x sep "/" : { bwh_receiver(mq, x, fname, _, at) }, h = cat(s, " receiver `", fname, "` (", p, ")").
.decl bwh_place(n: node, p: symbol)
bwh_place(n, p) :- docof(n, d), doc(d, path, _), line(n, l), p = cat(path, ":", to_string(l)).

// bwh_in_hook(c, mq): c runs inside one of mq's own save()/delete() methods or one of its receivers (a decorated
// def, or the def a `.connect(fn, …)` names), which write in bulk on purpose (to skip the hooks they are).
// Cross-file (decision 0652): a connected receiver is named by its qualified name, in another file.
.decl bwh_in_hook(c: node, mq: symbol) cross_file
bwh_in_hook(c, mq) :- bwh_method(mq, _, f), within(c, f).
bwh_in_hook(c, mq) :- bwh_receiver(mq, _, _, f, _), kind(f, "function_definition"), within(c, f).
bwh_in_hook(c, mq) :- bwh_receiver(mq, _, _, k, k), kind(k, "call"), bwh_connected(k, a), sym_of(a, q), qualname(f, q),
    kind(f, "function_definition"), within(c, f).

// The cases, `cases/django-practice-bulk-write-skips-hooks/`, read as one repository: each line ending in `# caught` is
// reported, and no other line.
.test cases exactly
    .fixture "shop/__init__.py" from "cases/django-practice-bulk-write-skips-hooks/shop/__init__.py"
    .fixture "shop/migrations/0002_fill.py" from "cases/django-practice-bulk-write-skips-hooks/shop/migrations/0002_fill.py"
    .fixture "shop/migrations/__init__.py" from "cases/django-practice-bulk-write-skips-hooks/shop/migrations/__init__.py"
    .fixture "shop/models.py" from "cases/django-practice-bulk-write-skips-hooks/shop/models.py"
    .fixture "shop/signals.py" from "cases/django-practice-bulk-write-skips-hooks/shop/signals.py"
    .fixture "shop/tests/__init__.py" from "cases/django-practice-bulk-write-skips-hooks/shop/tests/__init__.py"
    .fixture "shop/tests/test_books.py" from "cases/django-practice-bulk-write-skips-hooks/shop/tests/test_books.py"
    .fixture "shop/views.py" from "cases/django-practice-bulk-write-skips-hooks/shop/views.py"
    .fixture "unittests/dojo_test_case.py" from "cases/django-practice-bulk-write-skips-hooks/unittests/dojo_test_case.py"
    .expect _ at "shop/models.py":31
    .expect _ at "shop/models.py":34
    .expect _ at "shop/views.py":7
    .expect _ at "shop/views.py":8
    .expect _ at "shop/views.py":9
    .expect _ at "shop/views.py":11
    .expect _ at "shop/views.py":14
    .expect _ at "shop/views.py":15
    .expect _ at "shop/views.py":17
    .expect _ at "shop/views.py":19
    .expect _ at "shop/views.py":20
.end
