.policy "django-practice-read-modify-write" revision 1
.description "Update a counter in the database with F() (or under select_for_update()), not by reading it into Python, changing it and saving it back."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. In one function, `obj.f += n`, `obj.f -= n` or `obj.f = obj.f ± n`, followed by
// `obj.save(...)`, writes back a value read earlier: two concurrent requests both read the old value and one change
// is lost. It reports only when f is a numeric field (IntegerField, DecimalField, FloatField, ...) that obj's model
// declares, in its body or a base class of the run, and obj's model is known: `self` in a model's method, or obj
// bound in the function from a queryset of a model (`M.objects...get()/first()/last()/latest()/earliest()`,
// `obj, created = M.objects...get_or_create(...)`, `get_object_or_404(M, ...)`, `for obj in M.objects...`). It leaves
// alone a function that calls select_for_update() anywhere, and a new instance (`obj = M(...)`), which is inserted,
// not updated. The message offers both F() forms: on the instance, which still runs M's save() and its signals, and
// `update()`, which skips them (django-practice-bulk-write-skips-hooks leaves such a counter update alone).
//   a = Article.objects.get(pk=pk); a.hits += 1; a.save()           reported
//   def like(self): self.likes += 1; self.save()                     reported (in a model method)
//   a.hits = F("hits") + 1; a.save()                                 not reported
//   Article.objects.filter(pk=pk).update(hits=F("hits") + 1)         not reported
//   a = Article.objects.select_for_update().get(pk=pk); a.hits += 1; a.save()   not reported
// Gaps: obj as an attribute chain (`self.object.hits += 1`), a parameter whose model only callers know, a save()
// in a helper; a model method is reported even when every caller locks the row.

#include "python/django.rerail"

.violation ReadModifyWrite(at: node, o: symbol, x: symbol, model: symbol) "{o}.{x} is read into Python, changed and saved back with {o}.save(): two concurrent requests both read the old value and one change is lost. Let the database do the arithmetic: `{o}.{x} = F(\"{x}\") + n` before {o}.save() (save() and its signals still run; call {o}.refresh_from_db() before reading {o}.{x} again), or `{model}.objects.filter(pk={o}.pk).update({x}=F(\"{x}\") + n)`, which skips them; or lock the row with select_for_update() inside transaction.atomic()."
ReadModifyWrite(s, o, x, m) :- rmw_change(f, s, o, x), rmw_save(f, sv, o), earlier(s, sv), !rmw_locked(f),
    rmw_model(f, o, mc), rmw_numeric(mc, x), def_name(mc, m), docof(s, d), !dj_test_doc(d).

// rmw_change(f, s, o, x): statement s in function f sets `o.x` from its own value: `o.x += n`, `o.x -= n`,
// `o.x = o.x + n`, `o.x = n + o.x`, `o.x = o.x - n`; o is a plain name.
.decl rmw_target(a: node, o: symbol, x: symbol)
rmw_target(a, o, x) :- field(a, "left", l), attr_of(l, on, x), kind(on, "identifier"), text(on, o).
.decl rmw_change(f: node, s: node, o: symbol, x: symbol)
rmw_change(f, s, o, x) :- kind(s, "augmented_assignment"), (op(s, "+=") ; op(s, "-=")), rmw_target(s, o, x),
    nearest(s, f, fdef).
rmw_change(f, s, o, x) :- kind(s, "assignment"), rmw_target(s, o, x), field(s, "right", r), unparen(r, b),
    kind(b, "binary_operator"), (op(b, "+") ; op(b, "-")), child(b, e, _), attr_of(e, on, x), kind(on, "identifier"),
    text(on, o), nearest(s, f, fdef).
// rmw_save(f, c, o): call c in function f (not in a nested def) is `o.save(...)`.
.decl rmw_save(f: node, c: node, o: symbol)
rmw_save(f, c, o) :- kind(c, "call"), field(c, "function", e), attr_of(e, on, "save"), kind(on, "identifier"),
    text(on, o), nearest(c, f, fdef).
// rmw_locked(f): f calls select_for_update() somewhere.
.decl rmw_locked(f: node)
rmw_locked(f) :- kind(f, "function_definition"), kind(c, "call"), within(c, f), field(c, "function", e),
    attr_of(e, _, "select_for_update").

// rmw_model(f, o, mc): in function f, o holds an instance of model mc read from the database (not created: a new
// instance is inserted, so `M(...)` and `create()` are left out).
.decl rmw_model(f: node, o: symbol, mc: node)
rmw_model(f, "self", mc) :- dj_model_method(mc, f, _).
rmw_model(f, o, mc) :- asg(f, o, r, _), unparen(r, c), dj_qs_call(c, m), dj_row_method(m), m != "create",
    field(c, "function", e), attr_of(e, q, _), dj_qs_model(q, mc).
rmw_model(f, o, mc) :- asg(f, o, r, _), unparen(r, c), kind(c, "call"), field(c, "function", g),
    sym_of(g, "django.shortcuts.get_object_or_404"), posarg(c, 0, a), (dj_qs_model(a, mc) ; rmw_class(a, mc)).
rmw_model(f, o, mc) :- kind(a, "assignment"), nearest(a, f, fdef), field(a, "left", l),
    (kind(l, "pattern_list") ; kind(l, "tuple_pattern")), child(l, n, 0), kind(n, "identifier"), text(n, o),
    field(a, "right", r), unparen(r, c), (dj_qs_call(c, "get_or_create") ; dj_qs_call(c, "update_or_create")),
    field(c, "function", e), attr_of(e, q, _), dj_qs_model(q, mc).
rmw_model(f, o, mc) :- kind(s, "for_statement"), nearest(s, f, fdef), field(s, "left", l), kind(l, "identifier"),
    text(l, o), field(s, "right", r), unparen(r, q), dj_qs_model(q, mc).
// rmw_class(e, mc): e names model class mc of the run.
.decl rmw_class(e: node, mc: node) cross_file  // pairs two files' class nodes: decision 0677 fix 3b (models by symbol)
rmw_class(e, mc) :- sym_of(e, q), class_def(mc, q), dj_model(mc).

// rmw_numeric(mc, x): model mc has numeric field x (python/django's dj_number_field, or a DurationField), declared in
// its body or in a base class of the run.
.decl rmw_numeric(mc: node, x: symbol)
rmw_numeric(mc, x) :- dj_has_field(mc, x, t), (dj_number_field(t) ; t = "DurationField").

// The cases, `cases/django-practice-read-modify-write/`, read as one repository: each line ending in `# caught` is
// reported, and no other line.
.test cases exactly
    .fixture "shop/models.py" from "cases/django-practice-read-modify-write/shop/models.py"
    .fixture "shop/tests/test_models.py" from "cases/django-practice-read-modify-write/shop/tests/test_models.py"
    .fixture "shop/views.py" from "cases/django-practice-read-modify-write/shop/views.py"
    .expect _ at "shop/models.py":18
    .expect _ at "shop/models.py":22
    .expect _ at "shop/views.py":10
    .expect _ at "shop/views.py":16
    .expect _ at "shop/views.py":22
    .expect _ at "shop/views.py":28
    .expect _ at "shop/views.py":35
.end
