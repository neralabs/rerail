.policy "django-practice-middleware-ignores-streaming" revision 1
.description "In middleware, check response.streaming before reading or writing response.content."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. StreamingHttpResponse and FileResponse have no `content`: middleware that reads it
// fails with AttributeError on every streamed response, and one that sets it breaks the stream. It matches
// `<r>.content` in a middleware's response phase, where r is the response: the third parameter of a
// `process_response` method, or a name the function assigns from `get_response(…)` / `self.get_response(…)` (awaited
// or not), in a function that never mentions streaming: no `.streaming` or `.streaming_content`, no
// StreamingHttpResponse or FileResponse, no `isinstance(r, …)`, and no `hasattr(r, "content")` or
// `getattr(r, "content", …)` (or of `streaming`). A read inside a `try` whose handler catches AttributeError (or
// Exception) is guarded too. One finding per function, at its first `<r>.content`.
//   def process_response(self, request, response):
//       response.content = minify(response.content)       reported
//       if not response.streaming:
//           response.content = minify(response.content)   not reported
//   response = self.get_response(request)
//   size = len(response.content)                          reported
//   size = len(other.content)                             not reported: not the response
//   try: body = response.content
//   except AttributeError: return response                not reported: streamed responses are passed through
// Gaps: helpers the response is handed to; a response reached another way (`super().__call__`,
// `process_template_response`).

#include "python/django.rerail"

.violation MiddlewareIgnoresStreaming(at: node, r: symbol) "Streaming responses (StreamingHttpResponse, FileResponse) have no `content`, so `{r}.content` fails with AttributeError on them. Check `{r}.streaming` first and pass streaming responses through (or wrap `{r}.streaming_content`)."

// mis_response(f, x): in middleware function f, the name x holds the response.
.decl mis_response(f: node, x: symbol)
mis_response(f, x) :- kind(f, "function_definition"), def_name(f, "process_response"), param(f, x, 2).
mis_response(f, x) :- kind(f, "function_definition"), asg(f, x, v0, _), unparen(v0, v1), mis_awaited(v1, v),
    call_name(v, "get_response").
.decl mis_awaited(e: node, c: node)
mis_awaited(c, c) :- kind(c, "call").
mis_awaited(a, c) :- kind(a, "await"), child(a, c0, 0), unparen(c0, c), kind(c, "call").
// mis_guarded(f, x): f handles streaming responses, or tests the response's type or attributes.
.decl mis_guarded(f: node, x: symbol)
mis_guarded(f, x) :- mis_response(f, x), attr_of(n, _, a), (a = "streaming" ; a = "streaming_content"), within(n, f).
mis_guarded(f, x) :- mis_response(f, x), kind(n, "identifier"), (text(n, "StreamingHttpResponse") ;
    text(n, "FileResponse")), within(n, f).
mis_guarded(f, x) :- mis_response(f, x), kind(c, "call"), within(c, f), field(c, "function", g),
    sym_of(g, "builtins.isinstance"), posarg(c, 0, a), text(a, x).
mis_guarded(f, x) :- mis_response(f, x), kind(c, "call"), within(c, f), field(c, "function", g),
    (sym_of(g, "builtins.hasattr") ; sym_of(g, "builtins.getattr")), posarg(c, 0, a), text(a, x), posarg(c, 1, k),
    (str(k, "content") ; str(k, "streaming") ; str(k, "streaming_content")).

// mis_caught(n): n is in the body of a `try` with a handler for AttributeError (or a superclass).
.decl mis_caught(n: node)
mis_caught(n) :- mis_content(_, _, n), kind(t, "try_statement"), field(t, "body", b), within(n, b), child(t, x, _),
    kind(x, "except_clause"), catches(x, q), (q = "builtins.AttributeError" ; q = "builtins.Exception" ;
    q = "builtins.BaseException").
// mis_content(f, x, n): n is `x.content` of response x in f.
.decl mis_content(f: node, x: symbol, n: node)
mis_content(f, x, n) :- mis_response(f, x), attr_of(n, o, "content"), kind(o, "identifier"), text(o, x),
    look(o, x, f).
// mis_read(f, x, n): n is an unguarded `x.content` of response x in f.
.decl mis_read(f: node, x: symbol, n: node)
mis_read(f, x, n) :- mis_content(f, x, n), !mis_guarded(f, x), !mis_caught(n), docof(n, d), !dj_test_doc(d).

// mis_later(n): another unguarded read of the same response comes before n in f.
.decl mis_later(n: node)
mis_later(n) :- mis_read(f, x, n), mis_read(f, x, m), earlier(m, n).

MiddlewareIgnoresStreaming(n, x) :- mis_read(_, x, n), !mis_later(n).

// The cases, `cases/django-practice-middleware-ignores-streaming/`, read as one repository: each line ending in `# caught` is reported, and no
// other line.
.test cases exactly
    .fixture "core/__init__.py" from "cases/django-practice-middleware-ignores-streaming/core/__init__.py"
    .fixture "core/middleware.py" from "cases/django-practice-middleware-ignores-streaming/core/middleware.py"
    .fixture "core/tests/test_middleware.py" from "cases/django-practice-middleware-ignores-streaming/core/tests/test_middleware.py"
    .expect _ at "core/middleware.py":8
    .expect _ at "core/middleware.py":18
    .expect _ at "core/middleware.py":23
    .expect _ at "core/middleware.py":30
    .expect _ at "core/middleware.py":40
    .expect _ at "core/middleware.py":122
.end
