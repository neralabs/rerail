.policy "django-practice-get-or-create-needs-unique" revision 1
.description "Give get_or_create() and update_or_create() a lookup the database keeps unique, or concurrent calls insert duplicate rows."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. get_or_create() and update_or_create() run a SELECT, then an INSERT when it found
// nothing; only a unique index stops two concurrent calls from both inserting. The rule reports a call on a model of
// the run, `M.objects.get_or_create(...)` (or through all(), using(), select_for_update(), or `cls.objects` in a
// classmethod of a concrete model), whose lookup (every keyword but `defaults` and `create_defaults`) holds no field
// the database keeps unique for M: no lookup is `pk` or `id`, or a field declared with unique=True or
// primary_key=True or as a OneToOneField, and no unique_together group or UniqueConstraint(fields=[...]) in M's Meta
// lies within the lookup (one with condition= is unknown: the row may meet it). Fields, Meta and bases resolve across the run's files (`x_id` is
// field x). A lookup it cannot read is unknown and not reported: `__` in a keyword, `**kwargs`, a positional Q, a
// field the run does not declare, a Meta with an expression UniqueConstraint or an option it cannot read, an unmanaged
// model (`managed = False`: its table and indexes are made outside Django), a manager of the model whose class (or
// queryset class) in the run overrides the method (it may look up a unique hash instead).
//   Author.objects.get_or_create(name=n)                     reported: name is not unique
//   Author.objects.get_or_create(email=e, defaults={...})    not reported: email = EmailField(unique=True)
//   Book.objects.get_or_create(author=a, title=t)            not reported: UniqueConstraint(fields=["author", "title"])
//   a.book_set.get_or_create(title=t)                        not reported: related managers are not followed

#include "python/django.rr"

.violation GetOrCreateNeedsUnique(at: node, m: symbol, model: symbol, keys: symbol) "{m}() on {model} looks up ({keys}), which no unique field or unique constraint covers, so concurrent calls can each insert a row and leave duplicates. Add a UniqueConstraint(fields=[{keys}]) (or unique=True) to {model}, or look up a field that is unique."
GetOrCreateNeedsUnique(c, m, x, ks) :- goc_call(c, m, mc), !goc_unknown(c), !goc_unique(c, mc), def_name(mc, x),
    ks = join q by k sep ", " : { goc_key(c, k, _), q = cat("\"", k, "\"") }, ks != "", docof(c, d), !dj_test_doc(d).

// goc_call(c, m, mc): c is `M.objects...m(...)`, m get_or_create or update_or_create, M model class mc of the run.
.decl goc_method(m: symbol)
goc_method("get_or_create"). goc_method("update_or_create").
.decl goc_chain(m: symbol)
goc_chain("all"). goc_chain("using"). goc_chain("select_for_update").
.decl goc_root(q: node, r: node)
goc_root(q, o) :- dj_manager(q), attr_of(q, o, _).
goc_root(q, r) :- kind(q, "call"), field(q, "function", f), attr_of(f, o, m), goc_chain(m), goc_root(o, r).
.decl goc_call(c: node, m: symbol, mc: node)
goc_call(c, m, mc) :- goc_method(m), kind(c, "call"), field(c, "function", f), attr_of(f, o, m), goc_root(o, r),
    sym_of(r, q), class_def(mc, q), dj_model(mc).
goc_call(c, m, mc) :- goc_method(m), kind(c, "call"), field(c, "function", f), attr_of(f, o, m), goc_root(o, r),
    kind(r, "identifier"), text(r, "cls"), dj_model_method(mc, fd, _), nearest(c, fd, fdef), !goc_abstract(mc).
// goc_mgr(q, mn): the queryset chain q starts at manager attribute mn (`objects`).
.decl goc_mgr(q: node, mn: symbol)
goc_mgr(q, mn) :- dj_manager(q), attr_of(q, _, mn).
goc_mgr(q, mn) :- kind(q, "call"), field(q, "function", f), attr_of(f, o, m), goc_chain(m), goc_mgr(o, mn).
// goc_mgr_def(mc, mn, r): model mc, or a base class of the run, sets manager `mn = r` in its body.
.decl goc_mgr_def(mc: node, mn: symbol, r: node)
goc_mgr_def(mc, mn, r) :- dj_model(mc), goc_body_asg(mc, mn, r).
goc_mgr_def(mc, mn, r) :- dj_model(mc), class_def(mc, q), subclass(q, b), class_def(cb, b), goc_body_asg(cb, mn, r).
.decl goc_body_asg(c: node, x: symbol, r: node)
goc_body_asg(c, x, r) :- kind(c, "class_definition"), field(c, "body", b), body_stmt(b, s, _), child(s, a, 0),
    kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", r).
.decl goc_abstract(mc: node)
goc_abstract(mc) :- goc_meta_opt(mc, "abstract", v), text(v, "True").

// goc_key(c, k, f): lookup keyword k of call c names field f of its model (`x_id` names ForeignKey x).
.decl goc_kw(c: node, k: symbol)
goc_kw(c, k) :- goc_call(c, _, _), call_arg(c, -1, k, _), k != "defaults", k != "create_defaults".
.decl goc_key(c: node, k: symbol, f: symbol)
goc_key(c, k, k) :- goc_kw(c, k), goc_call(c, _, mc), goc_field(mc, k, _, _).
goc_key(c, k, x) :- goc_kw(c, k), goc_call(c, _, mc), goc_field(mc, x, _, t), (t = "ForeignKey" ; t = "OneToOneField"),
    k = cat(x, "_id").
// goc_unknown(c): the lookup holds something the rule cannot read.
.decl goc_unknown(c: node)
goc_unknown(c) :- goc_kw(c, k), !goc_key(c, k, _), k != "pk", k != "id".
goc_unknown(c) :- goc_call(c, _, _), posarg(c, _, _).
goc_unknown(c) :- goc_call(c, _, _), field(c, "arguments", al), child(al, s, _), kind(s, "dictionary_splat").
goc_unknown(c) :- goc_call(c, _, mc), goc_opaque(mc).
// A conditional UniqueConstraint within the lookup may hold for the row (`condition=~Q(engine="")` with `engine=x`).
goc_unknown(c) :- goc_call(c, _, mc), goc_cond_group(mc, g), !goc_missing(c, g).
// The manager is the model's own and its class (or queryset class) in the run defines the method: it may add a key.
goc_unknown(c) :- goc_call(c, m, mc), field(c, "function", f), attr_of(f, o, m), goc_mgr(o, mn), goc_mgr_def(mc, mn, r),
    (e = r ; within(e, r)), sym_of(e, q), mro_method(q, m, _).
// An unmanaged model's table (Meta.managed = False) is made outside Django, with indexes the model does not show.
goc_unknown(c) :- goc_call(c, _, mc), goc_meta_opt(mc, "managed", v), !text(v, "True").

// goc_field(mc, x, call, t): model mc has field x, declared in its body or in a base class of the run.
.decl goc_field(mc: node, x: symbol, call: node, t: symbol)
goc_field(mc, x, call, t) :- dj_field(mc, x, call, t).
goc_field(mc, x, call, t) :- dj_model(mc), class_def(mc, q), subclass(q, b), class_def(cb, b), dj_class_field(cb, x, call, t).
// goc_meta_opt(mc, k, v): `k = v` in the Meta of model mc or of a base class of the run.
.decl goc_meta_opt(mc: node, k: symbol, v: node)
goc_meta_opt(mc, k, v) :- dj_model(mc), goc_meta_of(mc, k, v).
goc_meta_opt(mc, k, v) :- dj_model(mc), class_def(mc, q), subclass(q, b), class_def(cb, b), goc_meta_of(cb, k, v).
.decl goc_meta_of(c: node, k: symbol, v: node)
goc_meta_of(c, k, v) :- kind(c, "class_definition"), kind(mt, "class_definition"), def_name(mt, "Meta"),
    nearest(mt, c, scope), field(mt, "body", b), body_stmt(b, s, _), child(s, a, 0), kind(a, "assignment"),
    field(a, "left", l), text(l, k), field(a, "right", r), unparen(r, v).

// goc_unique(c, mc): the database keeps some subset of c's lookup unique.
.decl goc_unique(c: node, mc: node)
goc_unique(c, mc) :- goc_call(c, _, mc), (goc_kw(c, "pk") ; goc_kw(c, "id")).
goc_unique(c, mc) :- goc_call(c, _, mc), goc_key(c, _, x), goc_field(mc, x, _, "OneToOneField").
goc_unique(c, mc) :- goc_call(c, _, mc), goc_key(c, _, x), goc_field(mc, x, call, _), call_arg(call, -1, o, v),
    (o = "unique" ; o = "primary_key"), !text(v, "False").
goc_unique(c, mc) :- goc_call(c, _, mc), goc_group(mc, g), !goc_missing(c, g).
.decl goc_missing(c: node, g: node)
goc_missing(c, g) :- goc_call(c, _, mc), (goc_group(mc, g) ; goc_cond_group(mc, g)), goc_member(g, x), !goc_covers(c, x).
// goc_covers(c, x): c looks up field x, named in Meta as itself or, for a relation, as its column `x_id`.
.decl goc_covers(c: node, x: symbol)
goc_covers(c, x) :- goc_key(c, _, x).
goc_covers(c, y) :- goc_key(c, _, x), y = cat(x, "_id").

// goc_group(mc, g): list or tuple g names a set of fields kept unique together, from unique_together (one group, or
// a list of groups) or a UniqueConstraint's fields= without a condition.
.decl goc_seq(n: node)
goc_seq(n) :- kind(n, "list") ; kind(n, "tuple").
.decl goc_member(g: node, x: symbol)
goc_member(g, x) :- goc_seq(g), child(g, e, _), str(e, x).
.decl goc_strings(g: node)
goc_strings(g) :- goc_seq(g), child(g, e, _), kind(e, "string"), !goc_odd(g).
.decl goc_odd(g: node)
goc_odd(g) :- goc_seq(g), child(g, e, _), !kind(e, "string"), !kind(e, "comment").
.decl goc_group(mc: node, g: node)
goc_group(mc, v) :- goc_meta_opt(mc, "unique_together", v), goc_strings(v).
goc_group(mc, g) :- goc_meta_opt(mc, "unique_together", v), goc_seq(v), child(v, e, _), unparen(e, g), goc_strings(g).
goc_group(mc, g) :- goc_meta_opt(mc, "constraints", v), goc_seq(v), child(v, k, _), goc_constraint(k),
    call_arg(k, -1, "fields", f), unparen(f, g), goc_strings(g), !call_arg(k, -1, "condition", _).
// goc_cond_group(mc, g): a UniqueConstraint with a condition: whether the looked-up row meets it is not known.
.decl goc_cond_group(mc: node, g: node)
goc_cond_group(mc, g) :- goc_meta_opt(mc, "constraints", v), goc_seq(v), child(v, k, _), goc_constraint(k),
    call_arg(k, -1, "fields", f), unparen(f, g), goc_strings(g), call_arg(k, -1, "condition", _).
.decl goc_constraint(k: node)
goc_constraint(k) :- kind(k, "call"), field(k, "function", f), sym_of(f, q), suffix(".UniqueConstraint", q).
// goc_opaque(mc): mc's Meta has a uniqueness option the rule cannot read: not a literal list, an unreadable
// unique_together element, an expression constraint (`UniqueConstraint(Lower("name"), ...)`), fields= not a literal.
.decl goc_opaque(mc: node)
goc_opaque(mc) :- (goc_meta_opt(mc, "unique_together", v) ; goc_meta_opt(mc, "constraints", v)), !goc_seq(v).
goc_opaque(mc) :- goc_meta_opt(mc, "unique_together", v), !goc_strings(v), child(v, e, _), !kind(e, "comment"),
    unparen(e, g), !goc_strings(g).
goc_opaque(mc) :- goc_meta_opt(mc, "constraints", v), child(v, k, _), goc_constraint(k), posarg(k, _, _).
goc_opaque(mc) :- goc_meta_opt(mc, "constraints", v), child(v, k, _), goc_constraint(k), !goc_fields_lit(k).
goc_opaque(mc) :- goc_meta_opt(mc, "constraints", v), child(v, k, _), !kind(k, "comment"), !kind(k, "call").
.decl goc_fields_lit(k: node)
goc_fields_lit(k) :- call_arg(k, -1, "fields", f), unparen(f, g), goc_strings(g).
