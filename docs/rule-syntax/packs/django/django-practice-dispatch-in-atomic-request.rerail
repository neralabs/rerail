.policy "django-practice-dispatch-in-atomic-request" revision 1
.description "With ATOMIC_REQUESTS on, every view runs in a transaction: enqueue tasks and send mail from views through transaction.on_commit, so they run only after the request's data is committed."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. When a settings module sets `"ATOMIC_REQUESTS": True` on a database (a dict entry,
// `DATABASES["default"]["ATOMIC_REQUESTS"] = True`, `dict(ATOMIC_REQUESTS=True)`, or a parameter defaulting to True
// that feeds the entry), Django opens a transaction before each sync view and commits it after the response. A
// Celery `.delay()`/`.apply_async()`/`send_task()`, a Django 6 task `.enqueue()`, django-q `async_task()` or a mail
// (send_mail, mail_admins, EmailMessage.send) in a view, or in code a view calls (the cross-file call graph), then
// runs before the commit: the worker may read rows that are not committed yet, or act on a request that rolls back.
// Views: a def whose first parameter is `request` (not a method, and not the inner `def middleware(request)` of a
// function-style middleware `def m(get_response)`, which runs outside the view's transaction), and every method of a
// Django or DRF view class; not async views (Django refuses ATOMIC_REQUESTS for them) and not views marked
// non_atomic_requests (a decorator on the def, the class or one of its methods, `non_atomic_requests(...)` in the
// class's `as_view`, or a urls-level `non_atomic_requests(views.f)`). What counts as a dispatch, and what is left
// alone, is django-practice-enqueue-on-commit's: `.delay()` on a parameter or local (`client.delay(2.0)`) is not
// known to be a task; a task whose `base=X` class, or the run's `Celery(task_cls=X)` class, sends through on_commit
// already waits for the commit; a call in an except handler that always re-raises stays (the request rolls back, so
// on_commit would drop the failure mail); `r = task.apply_async(...)` whose result the function reads afterwards
// stays. Calls inside an atomic block are enqueue-on-commit's. A top-level `ATOMIC_REQUESTS = True` is not a Django
// setting and turns nothing on.
//   def place(request): notify.delay(order.pk)                                  reported
//   def place(request): helpers.notify_later(order)   # which calls .delay()    reported, at the .delay()
//   def place(request): transaction.on_commit(notify.delay(order.pk))            reported: delay() runs now
//   def place(request): transaction.on_commit(partial(notify.delay, order.pk))  not reported
//   def place(request): notify.delay_on_commit(order.pk)                        not reported
//   def place(request): with transaction.atomic(): notify.delay(1)               not reported: enqueue-on-commit's
//   @transaction.non_atomic_requests  def hook(request): notify.delay(1)         not reported

#include "python/django.rerail"

.violation DispatchInAtomicRequest(at: node, what: symbol) "`{what}` runs inside a request while ATOMIC_REQUESTS wraps every view in a transaction (here or in a view that calls this code): a worker can pick the task up (or the mail goes out) before the request commits, so it may read rows that are not committed yet or act on changes that roll back. Run it after commit: `transaction.on_commit(partial(...))`, or Celery's `.delay_on_commit()`."
// What a dispatch is, and which ones stay, is python/django's side-effect vocabulary, shared with
// django-practice-enqueue-on-commit; a call in a transaction its own function opens (dj_in_transaction) is that
// rule's.
DispatchInAtomicRequest(c, w) :- dar_on(), dj_side_effect(c, w), owner(c, f), pt_tm(f, fq), dar_live(fq), !dar_after_commit(c),
    !dj_task_waits_for_commit(c), !dj_dispatch_in_failing_handler(c), !dj_dispatch_result_used(c),
    !dj_in_transaction(c), docof(c, d), !dj_test_doc(d).

// dar_on(): some settings module turns ATOMIC_REQUESTS on (dj_atomic_requests_value), with the literal True or a
// parameter defaulting to it (an env-driven value is unknown).
.decl dar_on()
dar_on() :- dj_atomic_requests_value(v), dar_true(v).
// dar_true(v): v is True, or names a parameter of its def whose default is True (`def db(atomic_requests=True)`).
.decl dar_true(v: node)
dar_true(v) :- kind(v, "true").
dar_true(v) :- kind(v, "identifier"), text(v, x), nearest(v, f, fdef), sig_param(f, _, nm, _, _, _, dv), text(nm, x),
    kind(dv, "true").

// dar_view(f): def f is a sync view that ATOMIC_REQUESTS wraps; dar_live(f): f runs inside one, by calls. Both by the
// def's symbol (decision 0677), as `call_target` names it; dar_call is each file's own calls.
.decl dar_view(f: symbol)
dar_view(fq) :- param(f, "request", 0), nearest(f, s, scope), !kind(s, "class_definition"), !is_async(f),
    !dar_middleware(f), !dar_non_atomic(f), !dar_non_atomic_wrapped(f), docof(f, d), !dj_test_doc(d), pt_tm(f, fq).
dar_view(fq) :- dj_view_class(k), kind(f, "function_definition"), nearest(f, k, scope), !is_async(f),
    !dar_non_atomic(k), !dar_non_atomic_member(k), docof(f, d), !dj_test_doc(d), pt_tm(f, fq).
.decl dar_live(f: symbol)
dar_live(fq) :- dar_on(), dar_view(fq).
dar_live(gq) :- dar_live(fq), dar_call(fq, gq).
.decl dar_call(f: symbol, g: symbol)
dar_call(fq, gq) :- owner(c, f), call_target(c, gq), !dar_after_commit(c), pt_tm(f, fq).
// dar_middleware(f): f is the inner def of a function-style middleware, `def m(get_response): def middleware(request)`.
// Django wraps only the resolved view in the request's transaction (BaseHandler.make_view_atomic).
.decl dar_middleware(f: node)
dar_middleware(f) :- kind(f, "function_definition"), nearest(f, g, scope), kind(g, "function_definition"),
    param(g, "get_response", _).
// dar_non_atomic(o): def or class o has a decorator that mentions transaction.non_atomic_requests
// (`@non_atomic_requests`, `@method_decorator(transaction.non_atomic_requests, name="dispatch")`).
.decl dar_non_atomic_ref(n: node)
dar_non_atomic_ref(n) :- sym_of(n, "django.db.transaction.non_atomic_requests").
.decl dar_non_atomic(o: node)
dar_non_atomic(o) :- decorator(o, e), (n = e ; within(n, e)), dar_non_atomic_ref(n).
// dar_non_atomic_member(k): view class k names non_atomic_requests in its body: on a method, or wrapping the view
// in `as_view` (`return non_atomic_requests(super().as_view(**kw))`).
.decl dar_non_atomic_member(k: node)
dar_non_atomic_member(k) :- kind(k, "class_definition"), field(k, "body", b), within(n, b), dar_non_atomic_ref(n).
// dar_non_atomic_wrapped(f): some file wraps f by call, `path("x/", non_atomic_requests(views.f))`.
// Cross-file (decision 0652): the wrapping call is in another file than f.
.decl dar_non_atomic_wrapped(f: node) cross_file
dar_non_atomic_wrapped(f) :- kind(c, "call"), field(c, "function", n), dar_non_atomic_ref(n), posarg(c, 0, a),
    sym_of(a, q), qualname(f, q).
// dar_on_commit(oc): oc is `transaction.on_commit(...)`, or `.on_commit(...)` on a connection
// (`connection.on_commit(...)`, `connections["x"].on_commit(...)`); dar_after_commit(n): n is in a lambda or def
// written in its arguments, which runs after the commit. A call in the arguments themselves runs at once:
// `on_commit(notify.delay(1))` enqueues now and hands on_commit the result.
.decl dar_on_commit(oc: node)
dar_on_commit(oc) :- kind(oc, "call"), field(oc, "function", f), sym_of(f, "django.db.transaction.on_commit").
dar_on_commit(oc) :- kind(oc, "call"), field(oc, "function", f), attr_of(f, _, "on_commit").
.decl dar_after_commit(n: node)
dar_after_commit(n) :- dar_on_commit(oc), within(l, oc), (kind(l, "lambda") ; kind(l, "function_definition")),
    within(n, l).

// The cases, `cases/django-practice-dispatch-in-atomic-request/`, read as one repository: each line ending in `#
// caught` is reported, and no other line.
.test cases exactly
    .fixture "proj/settings.py" from "cases/django-practice-dispatch-in-atomic-request/proj/settings.py"
    .fixture "shop/api/viewsets.py" from "cases/django-practice-dispatch-in-atomic-request/shop/api/viewsets.py"
    .fixture "shop/middleware.py" from "cases/django-practice-dispatch-in-atomic-request/shop/middleware.py"
    .fixture "shop/models.py" from "cases/django-practice-dispatch-in-atomic-request/shop/models.py"
    .fixture "shop/tasks.py" from "cases/django-practice-dispatch-in-atomic-request/shop/tasks.py"
    .fixture "shop/tests/test_views.py" from "cases/django-practice-dispatch-in-atomic-request/shop/tests/test_views.py"
    .fixture "shop/urls.py" from "cases/django-practice-dispatch-in-atomic-request/shop/urls.py"
    .fixture "shop/views.py" from "cases/django-practice-dispatch-in-atomic-request/shop/views.py"
    .expect _ at "shop/api/viewsets.py":9
    .expect _ at "shop/tasks.py":12
    .expect _ at "shop/views.py":15
    .expect _ at "shop/views.py":16
    .expect _ at "shop/views.py":17
    .expect _ at "shop/views.py":18
    .expect _ at "shop/views.py":20
    .expect _ at "shop/views.py":60
    .expect _ at "shop/views.py":65
    .expect _ at "shop/views.py":103
    .expect _ at "shop/views.py":127
.end
