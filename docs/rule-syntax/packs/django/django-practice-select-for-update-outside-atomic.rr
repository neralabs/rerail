.policy "django-practice-select-for-update-outside-atomic" revision 1
.description "Evaluate a select_for_update() queryset inside transaction.atomic(), in the function or in every caller chain that reaches it."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. In autocommit mode a select_for_update() queryset raises TransactionManagementError
// on PostgreSQL, MySQL and Oracle; TestCase wraps every test in a transaction, so the tests pass and production
// raises. It matches `<qs>.select_for_update(…)` in a def f (outside tests), not inside `with transaction.atomic()`
// or an `@transaction.atomic` def, when f may run outside a transaction (sfu_exposed):
//   - f is an entry point: no call in the run reaches it (python/calls), no call of unknown target has its name,
//     and it is not a view of a project with ATOMIC_REQUESTS;
//   - or a function that may run outside a transaction calls f, and that call is not inside an atomic region.
// A function some caller calls inside `with transaction.atomic()` is covered on that path only.
//   @shared_task def expire(pk): Hold.objects.select_for_update().get(pk=pk)              reported: a task, no transaction
//   def lock(pk): return Hold.objects.select_for_update().get(pk=pk)
//   def view(request): lock(1)                                                             reported in lock: view calls it bare
//   def view(request): with transaction.atomic(): lock(1)                                  not reported
//   def expire(pk): with transaction.atomic(): Hold.objects.select_for_update().get(pk=pk) not reported

#include "python/django.rr"

.violation SelectForUpdateOutsideAtomic(at: node, f: symbol, why: symbol) "`select_for_update()` in `{f}` runs outside transaction.atomic(): {why}. In autocommit mode Django raises TransactionManagementError here, though a TestCase (which wraps each test in a transaction) passes; wrap the locking read and the writes that depend on it in `transaction.atomic()`."
SelectForUpdateOutsideAtomic(c, x, why) :- sfu_site(c, f), def_name(f, x), sfu_exposed(f), sfu_why(f, why).

// sfu_site(c, f): call c is `<qs>.select_for_update(…)` in def f, outside tests and outside an atomic region.
.decl sfu_site(c: node, f: node)
sfu_site(c, f) :- kind(c, "call"), field(c, "function", e), attr_of(e, _, "select_for_update"), owner(c, f),
    !sfu_in_atomic(c), !sfu_guarded(c), docof(c, d), !dj_test_doc(d).
// sfu_guarded(c): c runs only when a test on atomicity holds: `if self.is_atomic: qs = qs.select_for_update()`,
// `qs.select_for_update() if connection.in_atomic_block else qs`. The same flag opens the transaction.
.decl sfu_guarded(c: node)
sfu_guarded(c) :- kind(i, "if_statement"), field(i, "condition", t), text(t, s), contains("atomic", s),
    field(i, "consequence", b), within(c, b).
sfu_guarded(c) :- kind(x, "conditional_expression"), child(x, b, 0), child(x, t, 1), text(t, s), contains("atomic", s),
    (c = b ; within(c, b)).
// A lock its caller switches on with a parameter (`if lock_message: qs = qs.select_for_update()`, `else:` of
// `if for_read:`): the call sites decide, and those passing the flag are the ones that must hold a transaction, which
// this rule cannot tell from the argument values.
sfu_guarded(c) :- owner(c, f), kind(i, "if_statement"), field(i, "condition", t), sfu_reads_param(t, f), within(c, i),
    !within(c, t).
sfu_guarded(c) :- owner(c, f), kind(x, "conditional_expression"), child(x, t, 1), sfu_reads_param(t, f), within(c, x),
    !within(c, t).
// sfu_reads_param(t, f): expression t reads a parameter of def f other than self/cls.
.decl sfu_reads_param(t: node, f: node)
sfu_reads_param(t, f) :- param(f, x, _), x != "self", x != "cls", look(n, x, f), kind(n, "identifier"), text(n, x),
    (t = n ; within(n, t)).

// sfu_in_atomic(n): n runs in a transaction: inside an atomic region (dj_in_atomic), or in a with-item after a
// `transaction.atomic()` item of the same with statement (`with transaction.atomic(), self.lock_rows(qs):`).
.decl sfu_in_atomic(n: node)
sfu_in_atomic(n) :- dj_in_atomic(n, _).
sfu_in_atomic(n) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wa, i),
    kind(wa, "with_item"), field(wa, "value", v), (unparen(v, e) ; kind(v, "as_pattern"), child(v, v0, 0), unparen(v0, e)),
    dj_atomic(e), child(wc, wb, j), i < j, kind(wb, "with_item"), within_stop(n, wb, dj_region_stop).

// sfu_up(f): def f holds a site, or calls a sfu_up def outside any atomic region: the only defs whose exposure
// matters. (An atomic call site, or an atomic def, ends the walk up the callers.)
.decl sfu_up(f: node)
sfu_up(f) :- sfu_site(_, f), sfu_plain(f).
sfu_up(g) :- sfu_up(f), sfu_target(c, f), owner(c, g), !sfu_in_atomic(c), sfu_plain(g).
// sfu_target(c, f): call c may call def f: python/calls' answer, or, where that is open, the def the callee's name
// resolves to (a def behind a decorator python/calls cannot see through, such as `@contextmanager`).
.decl sfu_target(c: node, f: node)
sfu_target(c, f) :- call_target(c, f).
sfu_target(c, f) :- sfu_up(f), qualname(f, q), call_open(c), field(c, "function", e), sym_of(e, q).
// sfu_exposed(f): def f may run with no transaction open.
.decl sfu_exposed(f: node)
sfu_exposed(f) :- sfu_entry(f).
sfu_exposed(f) :- sfu_bare_call(_, f).
// sfu_bare_call(c, f): call c, in a def that may run with no transaction open (or at module level), reaches f and
// is not inside an atomic region.
.decl sfu_bare_call(c: node, f: node)
sfu_bare_call(c, f) :- sfu_up(f), sfu_target(c, f), owner(c, g), sfu_exposed(g), !sfu_in_atomic(c).
sfu_bare_call(c, f) :- sfu_up(f), sfu_target(c, f), !owner(c, _), docof(c, d), !dj_test_doc(d).
// sfu_plain(f): def f, outside tests, does not open a transaction around its whole body.
.decl sfu_plain(f: node)
sfu_plain(f) :- kind(f, "function_definition"), !dj_atomic_def(f), docof(f, d), !dj_test_doc(d).
// sfu_entry(f): no code outside tests calls f, by a known or an unknown target, so a framework (a URL route, a task
// queue, a command, a signal) does; a view is in a transaction when the project sets ATOMIC_REQUESTS. Test callers
// do not count: they run in TestCase's transaction, and a task a test calls directly is still an entry point.
.decl sfu_entry(f: node)
sfu_entry(f) :- sfu_up(f), !sfu_called(f), def_name(f, x), !sfu_open_name(x), !sfu_atomic_view(f).
.decl sfu_called(f: node)
sfu_called(f) :- sfu_up(f), sfu_target(c, f), docof(c, d), !dj_test_doc(d).
// sfu_open_name(x): a call of unknown target outside tests is spelled `x(…)` or `<obj>.x(…)`, x a sfu_up def's name.
.decl sfu_open_name(x: symbol)
sfu_open_name(x) :- sfu_up(f), def_name(f, x), call_open(c), field(c, "function", e),
    (attr_of(e, _, x) ; kind(e, "identifier"), text(e, x)), docof(c, d), !dj_test_doc(d).
// sfu_atomic_view(f): the project wraps requests in transactions and f is a view: it takes `request`, or it is a
// method of a view class.
.decl sfu_atomic_view(f: node)
sfu_atomic_view(f) :- sfu_atomic_requests(), (param(f, "request", _) ; dj_view_class(k), nearest(f, k, scope)).
.decl sfu_atomic_requests()
sfu_atomic_requests() :- kind(p, "pair"), field(p, "key", k), str(k, "ATOMIC_REQUESTS"), field(p, "value", v), text(v, "True").

// sfu_why(f, why): how f runs outside a transaction.
.decl sfu_why(f: node, why: symbol)
sfu_why(f, "no code in the project calls it, so it is an entry point (a view, task, command or receiver) and nothing opens a transaction around it") :-
    sfu_entry(f).
sfu_why(f, cat("`", cat(g, cat("` calls it outside a transaction at ", cat(p, cat(":", to_string(l))))))) :-
    sfu_bare_call(c, f), !sfu_entry(f), l = min m : { sfu_bare_call(b, f), line(b, m) }, line(c, l), owner(c, h), def_name(h, g),
    docof(c, d), doc(d, p, _).
