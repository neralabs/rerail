.policy "django-practice-receiver-never-connected" revision 1
.description "A @receiver function connects only when its module is imported; import the signals module in the app's AppConfig.ready()."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. `@receiver(sig)` connects the function when its module is executed, so a receiver
// in a module nothing imports never runs. Reported: a `@receiver(...)` (django.dispatch.receiver) on a def of module m
// that is not nested in a function (a nested one connects when that function runs), outside tests, when nothing in
// the run loads m:
//   - no file outside tests imports m or a module below it (`import m`, `from m import x`, `from pkg import sub`,
//     relative forms; an import of m's dotted tail, `app.signals` for `src.app.signals`, counts);
//   - m is not one Django or Celery imports itself: `models` (and modules under a models package), `admin`, `apps`,
//     a name passed to `autodiscover_modules("x")`, `tasks` when the run calls `autodiscover_tasks`;
//   - no apps.py or AppConfig module holds m's last name as a string (an app config importing submodules by name);
//   - no string names m or a module below it (`import_module("app.signals")`, INSTALLED_APPS, dotted settings
//     paths), and no string ends in `.x` for m's last name x around a placeholder (`f"{app}.signals"`, "%s.signals").
//   shop/handlers.py: @receiver(post_save, sender=Book) def f(...)     reported when nothing imports shop.handlers
//   shop/signals.py, with shop/apps.py ready(): `from . import signals`  not reported
//   shop/models.py: @receiver(...)                                     not reported: Django imports models

#include "python/django.rr"
#include "python/modules.rr"

.violation ReceiverNeverConnected(at: node, fname: symbol, m: symbol, last: symbol) "`{fname}` is connected by `@receiver` only when module `{m}` is imported, and no code outside tests imports it, so the receiver never runs in production. Import the module in its app's AppConfig.ready() (`from . import {last}`)."

ReceiverNeverConnected(e, fname, m, x) :- decorator(f, e), kind(e, "call"), field(e, "function", rf), sym_of(rf, rq),
    (rq = "django.dispatch.receiver" ; rq = "django.dispatch.dispatcher.receiver"), def_name(f, fname),
    !rnc_in_def(f), docof(f, d), doc(d, _, m), m != "", !dj_test_doc(d), !rnc_loaded(m),
    rnc_last(m, x).

// rnc_in_def(f): def f is nested in a function, so its decorators run when that function runs.
.decl rnc_in_def(f: node)
rnc_in_def(f) :- kind(f, "function_definition"), nearest(f, _, fdef).
// rnc_mod(m): a module holding a receiver.
.decl rnc_mod(m: symbol)
rnc_mod(m) :- decorator(f, e), kind(e, "call"), field(e, "function", rf), sym_of(rf, rq),
    (rq = "django.dispatch.receiver" ; rq = "django.dispatch.dispatcher.receiver"), docof(f, d), doc(d, _, m), m != "".
// rnc_tail(m, s): s is m or a dotted tail of it of two names or more: `src.app.signals` gives itself and
// `app.signals`. The run's module names start at its root, which may sit above the import root.
.decl rnc_tail(m: symbol, s: symbol)
rnc_tail(m, m) :- rnc_mod(m).
rnc_tail(m, t) :- rnc_tail(m, s), h = @head(s), h != s, t = substr(s, strlen(h) + 1, strlen(s) - strlen(h) - 1),
    contains(".", t).
// rnc_last(m, x): x is m's last name.
.decl rnc_last(m: symbol, x: symbol)
rnc_last(m, x) :- rnc_mod(m), split_dot(m, _, x).
rnc_last(m, m) :- rnc_mod(m), !contains(".", m).

// rnc_name(q): a module name an import outside tests loads, or a string outside tests holds.
.decl rnc_name(q: symbol)
rnc_name(q) :- py_import(i, q), docof(i, d), !dj_test_doc(d).
rnc_name(q) :- py_from_import(i, p, x), q = @dot(p, x), docof(i, d), !dj_test_doc(d).
rnc_name(q) :- str(n, q), docof(n, d), !dj_test_doc(d).
// rnc_suffix(x): a string outside tests ends in `.x` and is no plain dotted name: a module named from a placeholder.
.decl rnc_suffix(x: symbol)
rnc_suffix(x) :- rnc_last(_, x), (str(n, v) ; str_part(n, _, v, _, _)), suffix(cat(".", x), v),
    !match("[A-Za-z_][A-Za-z0-9_.]*", v), docof(n, d), !dj_test_doc(d).
// rnc_autoload(x): modules named x in every app are imported by Django, Celery or an autodiscover_modules call.
.decl rnc_autoload(x: symbol)
rnc_autoload("models"). rnc_autoload("admin"). rnc_autoload("apps").
rnc_autoload(x) :- kind(c, "call"), field(c, "function", f), sym_of(f, "django.utils.module_loading.autodiscover_modules"),
    posarg(c, _, a), str(a, x).
rnc_autoload("tasks") :- kind(c, "call"), field(c, "function", f), attr_of(f, _, "autodiscover_tasks"),
    !call_arg(c, -1, "related_name", _).
rnc_autoload(x) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, "autodiscover_tasks"),
    call_arg(c, -1, "related_name", a), str(a, x).

// rnc_appconfig_name(x): an apps.py, or a module defining a class whose base is named `…AppConfig`, holds the
// string x: an app config that loads its app's modules by name (`import_module(f"{self.name}.{x}")` for each x it
// lists). The base is matched by name: a project's own AppConfig base may not resolve across the run's files.
.decl rnc_appconfig_name(x: symbol)
rnc_appconfig_name(x) :- rnc_last(_, x), str(n, x), docof(n, d), rnc_appconfig_doc(d).
.decl rnc_appconfig_doc(d: number)
rnc_appconfig_doc(d) :- file_name(d, "apps.py").
rnc_appconfig_doc(d) :- class_base(c, b), split_dot(b, _, bn), suffix("AppConfig", bn), docof(c, d).

// rnc_loaded(m): something loads module m.
.decl rnc_loaded(m: symbol)
rnc_loaded(m) :- rnc_tail(m, s), rnc_name(q), (q = s ; prefix(cat(s, "."), q)).
rnc_loaded(m) :- rnc_last(m, x), (rnc_autoload(x) ; rnc_suffix(x) ; rnc_appconfig_name(x)).
rnc_loaded(m) :- rnc_mod(m), contains(".models.", m).
