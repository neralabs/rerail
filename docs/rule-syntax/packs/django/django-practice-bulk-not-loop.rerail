.policy "django-practice-bulk-not-loop" revision 1
.description "Create, update or fetch model rows in bulk (bulk_create, bulk_update, in_bulk) rather than with one query per loop iteration."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. A query per loop iteration costs one round trip per row; Django's bulk methods do
// the same work in one query (or one per batch). Three shapes, each in the body of a `for` (or a comprehension), not
// in a def or lambda nested in it:
//   for row in rows: Book.objects.create(title=row)                 reported: bulk_create
//   for book in books: book.save()                                   reported: bulk_update (the loop's own target)
//   for pk in ids: Book.objects.get(pk=pk)                           reported: in_bulk (keyed by the loop variable)
//   for row in rows: book = Book.objects.create(title=row); book.tags.add(t)
//                                                     not reported: the new row is used at once
//   for book in books: other.save()                   not reported: not the loop's target
//   for pk in ids: Book.objects.get(slug="x")         not reported: the lookup does not depend on the loop
//   for model in models: model.objects.get(pk=1)      not reported: another table each time
//   for pk in ids: Book.objects.select_for_update().get(pk=pk)
//                                                     not reported: a row lock per iteration is the point
//   for form in forms: form.save(state)               not reported: Model.save() takes no positional argument
//   for alias in connections: Book.objects.using(alias).get(pk=pk)
//                                                     not reported: one row per database, which no bulk query joins
//   for a in authors: Book.objects.filter(author=a).order_by("-pk").first()
//                                                     not reported: the newest row per key is a Subquery or window
//                                                     query, not in_bulk
//   for a in qs: a.hits -= 1; a.save()                not reported: a counter moved from its old value needs
//                                                     `update(hits=F("hits") - 1)` (django-practice-read-modify-write)
// Gaps: the commonest bulk_create shape, `book = Book(...); book.save()` (only the loop's own target's save() is
// read); loops in helpers and `while` loops; per-row `.update()`, `.delete()` and `get_or_create()`; related-manager
// `.create()`; a custom manager `create()` with another signature is matched.

#include "python/django.rerail"

.violation QueryInLoop(at: node, what: symbol, fix: symbol) "`{what}` in a loop runs one query per iteration; collect the rows and use {fix} instead. bulk_create and bulk_update do not call the model's save() or send pre_save/post_save signals: keep the loop where those must run."
QueryInLoop(c, "objects.create()", "`bulk_create()`") :- bnl_loop(_, body), dj_qs_call(c, "create"),
    within_stop(c, body, dj_region_stop), bnl_result_dropped(c), !bnl_model_is(c, body), docof(c, d), !dj_test_doc(d).
// Model.save() takes no positional argument (Django 5.1 deprecated them): `form.save(state)` is some other save.
QueryInLoop(c, ".save()", "`bulk_update()` (or `QuerySet.update()` when every row gets the same value)") :-
    bnl_loop(v, body), kind(c, "call"), field(c, "function", f), attr_of(f, o, "save"), kind(o, "identifier"),
    text(o, v), within_stop(c, body, dj_region_stop), !posarg(c, 0, _), !bnl_counter(body, v), docof(c, d),
    !dj_test_doc(d).
QueryInLoop(c, cat(cat("objects.", m), "()"), "`in_bulk()` or one `filter(..__in=...)` query before the loop") :-
    bnl_loop(v, body), bnl_fetch(c, m), within_stop(c, body, dj_region_stop), bnl_uses(c, v), !bnl_model_is(c, body),
    !bnl_locks(c), docof(c, d), !dj_test_doc(d).

// bnl_counter(body, v): the loop body moves a number field of v from its old value (`v.hits -= 1`,
// `v.hits = v.hits + n`): bulk_update would write the Python-computed values and keep the lost update; the fix is
// `QuerySet.update(hits=F("hits") - 1)`, which django-practice-read-modify-write gives, so this rule leaves it. A
// number field: the step is a number literal, or some model of the run declares the field numeric. A string built
// on its old value (`v.name = v.name + suffix`) stays reported.
.decl bnl_counter(body: node, v: symbol)
bnl_counter(body, v) :- bnl_loop(v, body), kind(a, "augmented_assignment"), within(a, body), (op(a, "+=") ; op(a, "-=")),
    field(a, "left", l), attr_of(l, o, x), kind(o, "identifier"), text(o, v), field(a, "right", r),
    (bnl_number_lit(r) ; bnl_number_field(x)).
bnl_counter(body, v) :- bnl_loop(v, body), kind(a, "assignment"), within(a, body), field(a, "left", l),
    attr_of(l, o, x), kind(o, "identifier"), text(o, v), text(l, lt), field(a, "right", rr), unparen(rr, r),
    kind(r, "binary_operator"), (op(r, "+") ; op(r, "-")), child(r, e, _), text(e, lt), child(r, n, _), n != e,
    (bnl_number_lit(n) ; bnl_number_field(x)).
// Field x moved by step n is a number: n is an int or float literal (bnl_number_lit), or a model of the run declares
// x as a number field (bnl_number_field, python/django's dj_number_field).
.decl bnl_number_lit(n: node)
bnl_number_lit(n) :- unparen(n, m), (kind(m, "integer") ; kind(m, "float")).
// Cross-file: the run's models, in any file (decision 0652).
.decl bnl_number_field(x: symbol) cross_file
bnl_number_field(x) :- dj_has_field(_, x, _, t), dj_number_field(t).

// bnl_model_is(c, body): c's manager belongs to a name the loop that runs body binds each iteration, as its target
// (`for model in models: model.objects.get(...)`) or in its body (`cls = apps.get_model(...)`): each iteration may
// query another table, which no bulk method joins.
.decl bnl_model_is(c: node, body: node)
bnl_model_is(c, body) :- dj_qs_call(c, _), field(c, "function", f), dj_manager(mg), within(mg, f), attr_of(mg, o, _),
    kind(o, "identifier"), text(o, v), bnl_loop(v, body), within(c, body).
bnl_model_is(c, body) :- dj_qs_call(c, _), bnl_loop(_, body), within(c, body), field(c, "function", f), dj_manager(mg),
    within(mg, f), attr_of(mg, o, _), kind(o, "identifier"), text(o, v), kind(a, "assignment"), within(a, body),
    field(a, "left", l), kind(l, "identifier"), text(l, v).
// bnl_locks(c): the chain locks its row (`select_for_update()`): one row per iteration is usually the point (skip_locked
// work queues, lock-then-recheck).
.decl bnl_locks(c: node)
bnl_locks(c) :- bnl_fetch(c, _), field(c, "function", f), kind(s, "call"), within(s, f), field(s, "function", sf),
    attr_of(sf, _, "select_for_update").

// bnl_loop(v, body): a loop binding name v (alone or in a tuple target) and running body each iteration: a `for`
// statement's block, or a comprehension (its body is the whole comprehension).
.decl bnl_loop(v: symbol, body: node)
bnl_loop(v, b) :- kind(s, "for_statement"), field(s, "left", l), bnl_target(l, v), field(s, "body", b).
bnl_loop(v, comp) :- kind(fc, "for_in_clause"), field(fc, "left", l), bnl_target(l, v), child(comp, fc, _),
    (kind(comp, "list_comprehension") ; kind(comp, "set_comprehension") ; kind(comp, "dictionary_comprehension") ;
    kind(comp, "generator_expression")).
.decl bnl_target(l: node, v: symbol)
bnl_target(l, v) :- kind(l, "identifier"), text(l, v).
bnl_target(l, v) :- (kind(l, "pattern_list") ; kind(l, "tuple_pattern")), child(l, i, _), kind(i, "identifier"),
    text(i, v).
// bnl_result_dropped(c): the created object is thrown away or only appended to a list.
.decl bnl_result_dropped(c: node)
bnl_result_dropped(c) :- kind(s, "expression_statement"), child(s, c, 0).
bnl_result_dropped(c) :- kind(a, "call"), field(a, "function", f), attr_of(f, _, "append"), posarg(a, 0, c).
// bnl_fetch(c, m): c fetches one row: `X.objects.get(...)`, or `.first()`/`.last()` on a filtered chain.
.decl bnl_fetch(c: node, m: symbol)
bnl_fetch(c, "get") :- dj_qs_call(c, "get").
// A `.first()`/`.last()` after `order_by(...)` picks the top row per key (greatest-n-per-group), which in_bulk and
// `__in` do not express: left alone.
bnl_fetch(c, cat("filter().", m)) :- dj_qs_call(c, m), (m = "first" ; m = "last"), !bnl_ordered(c).
.decl bnl_ordered(c: node)
bnl_ordered(c) :- dj_qs_call(c, _), field(c, "function", f), kind(s, "call"), within(s, f), field(s, "function", sf),
    attr_of(sf, _, "order_by").
// bnl_uses(c, v): an argument of c (or, for `.first()`, of the chain it ends) reads name v.
.decl bnl_uses(c: node, v: symbol)
// A name read only to pick the database or the lookup's column (`.using(alias)`) does not count: rows of several databases join in no query.
bnl_uses(c, v) :- bnl_fetch(c, _), field(c, "function", f), within(i, f), kind(i, "identifier"), text(i, v),
    !bnl_attr_name(i), !bnl_kwarg_name(i), !bnl_in_using(i), !bnl_lookup_key(i).
bnl_uses(c, v) :- bnl_fetch(c, _), field(c, "arguments", al), within(i, al), kind(i, "identifier"), text(i, v),
    !bnl_attr_name(i), !bnl_kwarg_name(i), !bnl_lookup_key(i).
// bnl_lookup_key(i): i names the lookup, not its value (`filter(**{field: value})`): another column each iteration.
.decl bnl_lookup_key(i: node)
bnl_lookup_key(i) :- kind(p, "pair"), field(p, "key", k), (i = k ; within(i, k)).
.decl bnl_in_using(i: node)
bnl_in_using(i) :- kind(u, "call"), field(u, "function", uf), attr_of(uf, _, "using"), field(u, "arguments", ua),
    within(i, ua).
// bnl_attr_name(i) / bnl_kwarg_name(i): identifier i is the name after a dot, or a keyword's name, not a read.
.decl bnl_attr_name(i: node)
bnl_attr_name(i) :- kind(a, "attribute"), field(a, "attribute", i).
.decl bnl_kwarg_name(i: node)
bnl_kwarg_name(i) :- kind(k, "keyword_argument"), field(k, "name", i).

// The cases, `cases/django-practice-bulk-not-loop/`, read as one repository: each line ending in `# caught` is
// reported, and no other line.
.test cases exactly
    .fixture "shop/imports.py" from "cases/django-practice-bulk-not-loop/shop/imports.py"
    .fixture "shop/models.py" from "cases/django-practice-bulk-not-loop/shop/models.py"
    .fixture "shop/tests/test_imports.py" from "cases/django-practice-bulk-not-loop/shop/tests/test_imports.py"
    .expect _ at "shop/imports.py":7
    .expect _ at "shop/imports.py":8
    .expect _ at "shop/imports.py":15
    .expect _ at "shop/imports.py":21
    .expect _ at "shop/imports.py":26
    .expect _ at "shop/imports.py":29
    .expect _ at "shop/imports.py":31
    .expect _ at "shop/imports.py":82
    .expect _ at "shop/imports.py":90
    .expect _ at "shop/imports.py":98
    .expect _ at "shop/imports.py":118
    .expect _ at "shop/imports.py":122
.end
