.policy "django-practice-index-not-concurrent" revision 1
.description "On PostgreSQL, build an index on an existing table with AddIndexConcurrently in a non-atomic migration, not with AddIndex or a db_index/unique/ForeignKey field."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. A plain CREATE INDEX locks out writes to the table until the index is built; on a
// large table that is an outage. It matches, in a migration of a project on PostgreSQL, an operation that builds an
// index on a model whose CreateModel is in an earlier migration of the same app (a numbered file before this one):
//   - `migrations.AddIndex(model_name=…, index=…)`;
//   - `migrations.AddField(…, field=…)` with a field that has an index: db_index=True, unique=True, a OneToOneField,
//     or a ForeignKey without db_index=False;
//   - `migrations.AlterField(…)` with such a field, when an earlier migration defined that field and none gave it
//     the same kind of index (unique or not): altering an indexed field's max_length builds nothing.
// Skipped: operations under a SeparateDatabaseAndState's state_operations (no SQL), migrations that override
// `apply`, `initial = True` migrations (a new app's first migration split in parts: its tables are empty), unmanaged
// models. The project is on PostgreSQL when code outside tests names a PostgreSQL backend
// ("django.db.backends.postgresql", "…postgis") or imports from one (a project backend subclassing it), names a
// postgres:// URL, or uses django.contrib.postgres (INSTALLED_APPS, an import of its fields or operations).
//   0002: migrations.AddIndex(model_name="book", index=models.Index(fields=["title"], name="b_t"))   reported
//   0002: migrations.AddField("book", "isbn", models.CharField(max_length=13, unique=True))          reported
//   0002: AddIndexConcurrently(model_name="book", index=…)  (atomic = False)                        not reported
//   0002: migrations.CreateModel("Shelf", …) then migrations.AddIndex(model_name="shelf", …)        not reported: the table is new

#include "python/django.rr"
#include "python/modules.rr"

.violation IndexNotConcurrent(at: node, op: symbol, m: symbol, fix: symbol) "`{op}` on `{m}`, a table an earlier migration created, builds its index with a plain CREATE INDEX, which locks out writes to the table on PostgreSQL until the build ends. {fix}"
IndexNotConcurrent(c, "AddIndex", m, "Use `AddIndexConcurrently` (django.contrib.postgres.operations) in a migration with `atomic = False`.") :-
    inc_pg(_), inc_op(c, "AddIndex"), inc_existing(c, m).
IndexNotConcurrent(c, "AddField", m, fix) :- inc_pg(_), inc_op(c, "AddField"), inc_field_arg(c, fc), inc_field_index(fc, k),
    inc_existing(c, m), inc_fix(k, fix).
IndexNotConcurrent(c, "AlterField", m, fix) :- inc_pg(_), inc_op(c, "AlterField"), inc_field_arg(c, fc), inc_field_index(fc, k),
    inc_existing(c, m), inc_prior(c, _), !inc_had_index(c, k), inc_fix(k, fix).

.decl inc_fix(k: symbol, fix: symbol)
inc_fix("index", "Add the field without the index (db_index=False), then build it with `AddIndexConcurrently` in a migration with `atomic = False`.").
inc_fix("unique", "Build the unique index with CREATE UNIQUE INDEX CONCURRENTLY in a migration with `atomic = False` (SeparateDatabaseAndState), then attach the constraint.").

// inc_pg(v): the project runs on PostgreSQL: v is a backend name, a database URL or an import that says so.
.decl inc_pg(v: symbol)
inc_pg(v) :- str(s, v), (glob("*backends.postgresql*", v) ; glob("*backends.postgis", v) ; glob("postgres://*", v) ;
    glob("postgresql://*", v) ; glob("postgis://*", v) ; v = "django.contrib.postgres"), docof(s, d), !dj_test_doc(d).
inc_pg(q) :- py_import(i, q), (prefix("django.contrib.postgres", q) ; prefix("django.db.backends.postgresql", q) ;
    prefix("django.contrib.gis.db.backends.postgis", q)), docof(i, d), !dj_test_doc(d).

// inc_any_op(c, d, op): call c in migration document d constructs the migration operation op. Migrations of test
// apps (under a tests/ or test/ directory) are skipped; dj_test_doc's file-name tests are not used, since a migration
// may be named `0301_reference_test.py`.
.decl inc_any_op(c: node, d: number, op: symbol)
inc_any_op(c, d, op) :- kind(c, "call"), field(c, "function", f), sym_of(f, q), split_dot(q, m, op),
    prefix("django.db.migrations", m), docof(c, d), dj_migration_doc(d), !path_part(d, "tests"), !path_part(d, "test").
// inc_op(c, op): operation c runs its SQL on a table in use: it is not in a SeparateDatabaseAndState's
// state_operations, its Migration class does not override `apply` (which may skip the operations or run them
// otherwise), and its migration is not an initial one.
.decl inc_op(c: node, op: symbol)
inc_op(c, op) :- inc_any_op(c, d, op), !inc_state_only(c), !inc_own_apply(d), !inc_initial(d).
.decl inc_state_only(c: node)
inc_state_only(c) :- inc_any_op(s, _, "SeparateDatabaseAndState"), call_arg(s, i, k, v), (k = "state_operations" ; i = 1),
    inc_any_op(c, _, _), within(c, v).
// inc_initial(d): migration d says `initial = True`: makemigrations split a new app's first migration in parts
// (0002_initial_part_2 adds the foreign keys 0001 could not), and the tables are all new and empty when it runs.
.decl inc_initial(d: number)
inc_initial(d) :- inc_mig_class(k, d), field(k, "body", b), body_stmt(b, s, _), kind(s, "expression_statement"),
    child(s, a, 0), kind(a, "assignment"), field(a, "left", l), text(l, "initial"), field(a, "right", v), text(v, "True").
.decl inc_mig_class(k: node, d: number)
inc_mig_class(k, d) :- class_def(k, _), def_name(k, "Migration"), class_base(k, "django.db.migrations.Migration"), docof(k, d).
.decl inc_own_apply(d: number)
inc_own_apply(d) :- inc_mig_class(k, d), kind(f, "function_definition"), def_name(f, "apply"), nearest(f, k, scope).
// inc_model(c, m): operation c is about the model named m, lowercased (`model_name="book"`, CreateModel `name="Book"`).
.decl inc_model(c: node, m: symbol)
inc_model(c, @lower(s)) :- inc_any_op(c, _, op), op != "CreateModel", (call_arg(c, -1, "model_name", v) ; call_arg(c, 0, "", v)),
    str(v, s).
inc_model(c, @lower(s)) :- inc_any_op(c, _, "CreateModel"), (call_arg(c, -1, "name", v) ; call_arg(c, 0, "", v)), str(v, s).
// inc_mig(d, dir, n): migration d sits in directory dir and its file name starts with number n ("0002_…").
.decl inc_mig(d: number, dir: symbol, n: number)
inc_mig(d, @dir(p), to_number(k)) :- dj_migration_doc(d), doc(d, p, _), file_name(d, s), match("(?<k>[0-9]+)_.*", s).
// inc_existing(c, m): operation c, on model m, runs after an earlier migration of its app created m's table, and
// its own migration does not create m. An unmanaged model (`options={"managed": False}`) has no table Django builds.
.decl inc_existing(c: node, m: symbol)
inc_existing(c, m) :- inc_any_op(c, d, _), inc_model(c, m), inc_mig(d, dir, n), inc_any_op(k, e, "CreateModel"),
    inc_model(k, m), inc_mig(e, dir, n0), n0 < n, !inc_created_in(d, m), !inc_unmanaged(dir, m).
.decl inc_created_in(d: number, m: symbol)
inc_created_in(d, m) :- inc_any_op(k, d, "CreateModel"), inc_model(k, m).
.decl inc_unmanaged(dir: symbol, m: symbol)
inc_unmanaged(dir, m) :- inc_any_op(k, e, "CreateModel"), inc_model(k, m), inc_mig(e, dir, _), call_arg(k, -1, "options", o),
    kind(o, "dictionary"), child(o, p, _), kind(p, "pair"), field(p, "key", x), str(x, "managed"), field(p, "value", v),
    text(v, "False").

// inc_field_arg(c, fc): AddField/AlterField c's field (`field=…`, or the third positional argument).
.decl inc_field_arg(c: node, fc: node)
inc_field_arg(c, fc) :- inc_any_op(c, _, op), (op = "AddField" ; op = "AlterField"),
    (call_arg(c, -1, "field", v) ; call_arg(c, 2, "", v)), unparen(v, fc).
// inc_field_index(fc, k): field call fc gets an index of kind k: "unique" (unique=True, OneToOneField) or "index"
// (db_index=True, or a ForeignKey that does not say db_index=False).
.decl inc_field_index(fc: node, k: symbol)
inc_field_index(fc, "unique") :- inc_unique(fc).
inc_field_index(fc, "index") :- kind(fc, "call"), call_arg(fc, -1, "db_index", v), text(v, "True"), !inc_unique(fc).
inc_field_index(fc, "index") :- dj_field_call(fc, t), (t = "ForeignKey" ; t = "ParentalKey"), !call_arg(fc, -1, "db_index", _),
    !inc_unique(fc).
.decl inc_unique(fc: node)
inc_unique(fc) :- kind(fc, "call"), call_arg(fc, -1, "unique", v), text(v, "True").
inc_unique(fc) :- dj_field_call(fc, "OneToOneField"), !call_arg(fc, -1, "unique", _).
// inc_fielddef(d, m, x, fc): migration d defines field x of model m as fc: AddField/AlterField, or a CreateModel's
// `fields=[("x", fc), …]`. State-only operations count: they say what the field already is.
.decl inc_fielddef(d: number, m: symbol, x: symbol, fc: node)
inc_fielddef(d, m, x, fc) :- inc_any_op(c, d, op), (op = "AddField" ; op = "AlterField"), inc_model(c, m),
    (call_arg(c, -1, "name", n) ; call_arg(c, 1, "", n)), str(n, x), inc_field_arg(c, fc).
inc_fielddef(d, m, x, fc) :- inc_any_op(c, d, "CreateModel"), inc_model(c, m), (call_arg(c, -1, "fields", l) ; call_arg(c, 1, "", l)),
    child(l, t, _), kind(t, "tuple"), child(t, n, 0), str(n, x), child(t, v, 1), unparen(v, fc).
// inc_prior(c, fc): AlterField c's field was defined as fc before: in an earlier migration, or earlier in c's own
// migration (a squashed one adds a field, then alters it). With no prior definition (a RenameField renamed it, a
// squash dropped it) the field's index is unknown and c is not reported.
.decl inc_prior(c: node, fc: node)
inc_prior(c, fc) :- inc_altered(c, d, m, x), inc_mig(d, dir, k1), inc_fielddef(e, m, x, fc), inc_mig(e, dir, k0), k0 < k1.
inc_prior(c, fc) :- inc_altered(c, d, m, x), inc_fielddef(d, m, x, fc), earlier(fc, c).
// inc_had_index(c, k): a prior definition of AlterField c's field already had an index of kind k.
.decl inc_had_index(c: node, k: symbol)
inc_had_index(c, k) :- inc_prior(c, fc), inc_field_index(fc, k).
// inc_altered(c, d, m, x): AlterField c in migration d alters field x of model m.
.decl inc_altered(c: node, d: number, m: symbol, x: symbol)
inc_altered(c, d, m, x) :- inc_any_op(c, d, "AlterField"), inc_model(c, m), (call_arg(c, -1, "name", n) ; call_arg(c, 1, "", n)),
    str(n, x).
