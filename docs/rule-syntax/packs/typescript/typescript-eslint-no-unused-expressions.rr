.policy "typescript-eslint-no-unused-expressions" revision 6
.description "Remove TypeScript expression statements that have no effect, such as a bare value or comparison; they are usually a missing call or assignment."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"

#include "tsx/modules.rr"
//   directive
#include "tsx/ts-b.rr"
//   module_directive
#include "tsx/eslint-a-common.rr"
//   deparen

// typescript-eslint's no-unused-expressions: ESLint's rule. An expression statement whose value is thrown away and
// that does nothing else is reported: a name, a literal, a member read, an operator other than `void` and `delete`,
// a function or class expression, `a ? b : c`, `a && b`. Calls, `new`, assignments, `++`, `await`, `yield` and
// directives ("use strict", also at the head of a namespace) are fine. TypeScript's wrappers are looked through: `a as T`, `<T>a`, `a!` and `f<T>`
// are judged by what they wrap; `a satisfies T` is never reported.
//   a;   a.b;   a == b;   a!;   x as any;   f<string>;   a?.b;          → reported
//   f();   a = 1;   delete a.b;   void 0;   a?.b();   (f as any)();       fine
// Options (all false by default):
//   allowShortCircuit      `a && f()`: judge the right side only          allowTernary  `a ? f() : g()`: each branch
//   allowTaggedTemplates   tag`x` is fine                                  enforceForJSX `<A />;` is reported
//   ignoreDirectives       with ecmaVersion 3, where there are no directives, still allow "use strict";
.violation no_unused_expressions(at: node) code "@typescript-eslint/no-unused-expressions" "Expected an assignment or function call and instead saw an expression."
    suppress eslint "@typescript-eslint/no-unused-expressions"
    suppress oxlint "no-unused-expressions"
no_unused_expressions(s) :- kind(s, "expression_statement"), child(s, e, 0), bare(e, x), idle(x), !kept_directive(s).

// bare(e, x): x is e without parentheses and TypeScript's type wrappers, which ESTree keeps but the rule sees through.
.decl bare(e: node, x: node)
bare(e, x) :- deparen(e, y), !ts_wrapper(y), x = y.
bare(e, x) :- deparen(e, y), ts_wrapper(y), child(y, z, 0), bare(z, x).
.decl ts_wrapper(y: node)  // `a as T`, `<T>a` (its operand is child 1), `a!`, `f<T>`
ts_wrapper(y) :- kind(y, "as_expression") ; kind(y, "non_null_expression") ; kind(y, "instantiation_expression").
bare(e, x) :- deparen(e, y), kind(y, "type_assertion"), child(y, z, 1), bare(z, x).

// idle(x): ESLint's Checker.isDisallowed.
.decl idle(x: node)
idle(x) :- kind(x, k), idle_kind(k).
idle(x) :- kind(x, "unary_expression"), !op(x, "void"), !op(x, "delete").
idle(x) :- kind(x, "binary_expression"), !logical(x).
idle(x) :- logical(x), !option("allowShortCircuit", "true").
idle(x) :- logical(x), option("allowShortCircuit", "true"), field(x, "right", r), bare(r, y), idle(y).
idle(x) :- kind(x, "ternary_expression"), !option("allowTernary", "true").
idle(x) :- kind(x, "ternary_expression"), option("allowTernary", "true"),
    (field(x, "consequence", b) ; field(x, "alternative", b)), bare(b, y), idle(y).
idle(x) :- kind(x, "call_expression"), field(x, "arguments", t), kind(t, "template_string"),
    !option("allowTaggedTemplates", "true").
idle(x) :- (kind(x, "jsx_element") ; kind(x, "jsx_self_closing_element")), option("enforceForJSX", "true").
.decl idle_kind(k: symbol)
idle_kind("array"). idle_kind("arrow_function"). idle_kind("class"). idle_kind("function_expression").
idle_kind("generator_function"). idle_kind("identifier"). idle_kind("undefined"). idle_kind("string").
idle_kind("number"). idle_kind("regex"). idle_kind("true"). idle_kind("false"). idle_kind("null").
idle_kind("member_expression"). idle_kind("subscript_expression"). idle_kind("meta_property"). idle_kind("object").
idle_kind("sequence_expression"). idle_kind("template_string"). idle_kind("this").
.decl logical(x: node)  // ESTree's LogicalExpression: tree-sitter writes it as a binary_expression
logical(x) :- kind(x, "binary_expression"), (op(x, "&&") ; op(x, "||") ; op(x, "??")).

// kept_directive(s): a directive of the prologue ("use strict"; "use client"), unless the parser is ES3.
.decl kept_directive(s: node)
kept_directive(s) :- directive(_, s, _), !option("ecmaVersion", "3").
kept_directive(s) :- module_directive(s).
kept_directive(s) :- directive(_, s, _), option("ecmaVersion", "3"), option("ignoreDirectives", "true").
