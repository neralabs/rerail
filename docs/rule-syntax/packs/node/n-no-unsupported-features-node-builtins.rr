.policy "n-no-unsupported-features-node-builtins" revision 4
.description "Use only the Node.js built-in APIs that every Node.js version in the package's engines.node range provides, or raise that range."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
// eslint-plugin-n 18.4.1's n/no-unsupported-features/node-builtins. Every use of a Node.js built-in (a module,
// a member, a global; read, called or constructed) whose supported releases do not cover every version the package
// may run on. The data is a table, one row per API; this file is the check.
//   1. use: each API use (lib/tsx/values.rr), less the names the `ignores` option lists.
//   2. range_of: the releases that have the API: ">=since", plus "^v" for each backport; the same for the releases
//      where it is experimental. basis: which of the two decides; experimental only under allowExperimental.
//   3. node_runs_on: the range the file must run on: a valid `version` option, else values.rr's node_range.
//   4. a finding where runs_on is not a subset of that range, or where no release supports the API in that form.
// Not ported: ESLint's settings.node.version.

#include "tsx/values.rr"
#include "../packs/node/n-no-unsupported-features-node-builtins.facts.rr"   // api_since, api_backport, …

// use(at, api, how): a use of a tabled API. `export * from "fs"` uses every direct member of fs ("fs#x", not
// "fs#x.y"), as ReferenceTracker reports each one at the statement.
.decl use(at: node, api: symbol, how: symbol)
use(at, p, how) :- api_use(at, p, how), tabled(p, how), !ignored(p).
use(e, p, "read") :- export_all(e, m), tabled(p, "read"), match("(?<pm>[^#]+)#[^.]+", p), pm = m, !ignored(p).
.decl tabled(api: symbol, how: symbol)
tabled(p, how) :- api_since(p, how, _).
tabled(p, how) :- api_never(p, how).
// ignores lists names as the plugin spells them: "fs.promises.readFile", "process.getBuiltinModule"; "fs" covers
// node:fs too. One option row per list entry.
.decl ignored(p: symbol)
ignored(p) :- tabled(p, _), option("ignores", i), @replace_all(@replace_all(p, "^node:", ""), "#", ".") = i.

// range_of(api, how, kind, since, r): kind "supported" or "experimental", since the latest such release, r the
// range: ("process.getBuiltinModule", "read", "supported", "22.3.0", ">=22.3.0 || ^20.16.0").
.decl range_of(api: symbol, how: symbol, kind: symbol, since: symbol, r: symbol)
range_of(p, how, k, s, cat(cat(">=", s), bs)) :- first(p, how, k, s),
    bs = join x by b sep "" : { also(p, how, k, b), x = cat(" || ^", b) }, @semver_valid(cat(cat(">=", s), bs)) = 1.
.decl first(api: symbol, how: symbol, kind: symbol, v: symbol)
first(p, how, "supported", v) :- api_since(p, how, v).
first(p, how, "experimental", v) :- api_experimental_since(p, how, v).
.decl also(api: symbol, how: symbol, kind: symbol, v: symbol)
also(p, how, "supported", v) :- api_backport(p, how, v).
also(p, how, "experimental", v) :- api_experimental_backport(p, how, v).
// basis(api, how, kind): allowExperimental judges an API that has experimental releases by those alone, as the
// plugin does (it then never looks at the supported ones); every other API by its supported releases.
.decl basis(api: symbol, how: symbol, kind: symbol)
basis(p, how, "experimental") :- trial(p, how).
basis(p, how, "supported") :- tabled(p, how), !trial(p, how).
.decl trial(api: symbol, how: symbol)
trial(p, how) :- option("allowExperimental", "true"), api_experimental_since(p, how, _).

// node_runs_on(d, r) (values.rr): the range document d must run on; a `version` that is no range is ignored.

// The findings. Both share the plugin's code, so a finding's key is (policy, code, path, line), as in the JSON.
.violation unsupported(at: node, api: symbol, kind: symbol, since: symbol, ok: symbol, cfg: symbol) code "n/no-unsupported-features/node-builtins"
    "{api} is {kind} from Node.js {since} on ({ok}); the configured range {cfg} includes earlier versions."
    suppress eslint "n/no-unsupported-features/node-builtins"
unsupported(at, p, k, s, r, t) :- use(at, p, how), basis(p, how, k), range_of(p, how, k, s, r), docof(at, d),
    node_runs_on(d, t), @semver_subset(t, r) = 0.

.violation experimental(at: node, api: symbol) code "n/no-unsupported-features/node-builtins"
    "{api} is still experimental in every Node.js release; do not rely on it."
    suppress eslint "n/no-unsupported-features/node-builtins"
// No release supports p used this way: an experimental API, or a form no release has (zlib.Gzip() without new).
experimental(at, p) :- use(at, p, how), api_never(p, how), basis(p, how, "supported").
