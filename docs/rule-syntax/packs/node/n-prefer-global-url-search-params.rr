.policy "n-prefer-global-url-search-params" revision 6
.description "Use the global URLSearchParams instead of importing or requiring it from the url module; it is always available in Node.js."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
// eslint-plugin-n's n/prefer-global/url-search-params: use the global URLSearchParams, not the url module's URLSearchParams. Option "always" (the
// default) reports each use of the module's URLSearchParams; "never" reports each use of the global:
//   const { URLSearchParams } = require("url")     import { URLSearchParams } from "node:url"     require("url").URLSearchParams
//   export * from "url"                  reported (the export re-exports URLSearchParams)
//   "never":  URLSearchParams  globalThis.URLSearchParams                                             reported
// The module is traced through require(), process.getBuiltinModule() and imports (node-trace.rr).

#include "tsx/node-trace.rr"   // prefer_global_use
module_global("URLSearchParams", "url", "URLSearchParams").

.violation prefer_global(at: node, msg: symbol) code "n/prefer-global/url-search-params" "{msg}"
    suppress eslint "n/prefer-global/url-search-params"
prefer_global(n, m) :- prefer_global_use(n, m).
