.policy "n-prefer-global-url" revision 6
.description "Use the global URL instead of importing or requiring it from the url module; it is always available in Node.js."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
// eslint-plugin-n's n/prefer-global/url: use the global URL, not the url module's URL. Option "always" (the
// default) reports each use of the module's URL; "never" reports each use of the global:
//   const { URL } = require("url")     import { URL } from "node:url"     require("url").URL
//   export * from "url"                  reported (the export re-exports URL)
//   "never":  URL  globalThis.URL                                             reported
// The module is traced through require(), process.getBuiltinModule() and imports (node-trace.rr).

#include "tsx/node-trace.rr"   // prefer_global_use
module_global("URL", "url", "URL").

.violation prefer_global(at: node, msg: symbol) code "n/prefer-global/url" "{msg}"
    suppress eslint "n/prefer-global/url"
prefer_global(n, m) :- prefer_global_use(n, m).
