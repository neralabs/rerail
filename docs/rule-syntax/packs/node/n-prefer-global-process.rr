.policy "n-prefer-global-process" revision 3
.description "Use the global process instead of importing or requiring the process module; it is always available in Node.js."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
// eslint-plugin-n's n/prefer-global/process: use the global process, not the process module. Option "always" (the default)
// reports each load of the module; "never" reports each use of the global:
//   const process = require("process")    process.getBuiltinModule("node:process")    import process from "process"
//   export * from "node:process"      reported (a re-export loads the module too)
//   "never":  process.x  globalThis.process                                          reported
// The module is traced through require(), process.getBuiltinModule() and imports (node-trace.rr).

#include "tsx/node-trace.rr"   // prefer_global_use
module_global("process", "process", "").

.violation prefer_global(at: node, msg: symbol) code "n/prefer-global/process" "{msg}"
    suppress eslint "n/prefer-global/process"
prefer_global(n, m) :- prefer_global_use(n, m).
