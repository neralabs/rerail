.policy "eslint-no-unexpected-multiline" revision 4
.description "Avoid line breaks before a call's parentheses, a computed property bracket, a tagged template or a division slash; without a semicolon the lines merge unexpectedly."
.language typescript
.mode steer
.scope include "**/*"

#include "tsx/eslint-b-control.rr"
//   deparen

// ESLint's no-unexpected-multiline: a line that starts with `(`, `[`, a template or `/…/flags` continues the
// expression on the line before, since no semicolon is inserted there. Reported at that token. No options.
//   const a = b⏎ (f || g)()       the `(` makes b a call            → "function"
//   const a = b⏎ [1, 2].map(f)    the `[` indexes b                 → "property"
//   const a = f⏎ `x`              f becomes a tag                    → "tagged-template"
//   const a = b⏎ /foo/g.test(c)   b / foo / g                        → "division"
//   f⏎ ()   (no arguments)   a⏎ ?.[b]   a?.⏎ (b)     fine
.violation no_unexpected_multiline(at: loc, msg: symbol) code "no-unexpected-multiline" "{msg}"
    suppress eslint "no-unexpected-multiline"
    suppress oxlint "no-unexpected-multiline"
no_unexpected_multiline(t, "Move the ( onto the line of the function it calls, or add a semicolon if the previous line ends a statement.") :-
    kind(c, "call_expression"), !field(c, "optional_chain", _), field(c, "arguments", a), kind(a, "arguments"),
    count : { child(a, x, _), !kind(x, "comment") } > 0, before_line(a, l), !line(a, l), t = a.
layout_at(a) :- kind(c, "call_expression"), field(c, "arguments", a), kind(a, "arguments").
no_unexpected_multiline(t, "Move the [ onto the line of the object it indexes, or add a semicolon if the previous line ends a statement.") :-
    kind(m, "subscript_expression"), !field(m, "optional_chain", _), field(m, "index", i), structural_before(i, g),
    match("(?s)[^\\[]*\\n[^\\[]*\\[\\s*", g), w = @replace_all(g, "(?s)^.*\\[", ""), line(i, li),
    l = li - (strlen(w) - strlen(@replace_all(w, "\\n", ""))), node(d, m, _, _, _), src_line(d, l, t).   // at the `[`'s line (the tape keeps no `[`)
no_unexpected_multiline(q, "Move the template literal onto the line of its tag, or add a semicolon if the previous line ends a statement.") :-
    kind(c, "call_expression"), field(c, "arguments", q), kind(q, "template_string"), before_line(q, l),
    !line(q, l).
layout_at(q) :- kind(c, "call_expression"), field(c, "arguments", q), kind(q, "template_string").
// `a⏎ /b/g`: a `/` whose left side is a division, followed at once by regex flags. The flags are ESLint 10's,
// with d and v (9.39 knows only gimsuy).
no_unexpected_multiline(t, "Move the / onto the line of the numerator, or add a semicolon if the next line starts a regular expression.") :-
    kind(b, "binary_expression"), op(b, "/"), field(b, "left", e), deparen(e, n), kind(n, "binary_expression"),
    op(n, "/"), field(b, "right", r), structural_before(r, ""), text(r, g), match("(?s)[dgimsuvy]+\\b.*", g),
    field(n, "left", x), after_line(x, l), !end_line(x, l), div_op(x, t).
layout_at(x) :- kind(n, "binary_expression"), op(n, "/"), field(n, "left", x).
// div_op(x, t): the operator after left operand x.
.stored div_op "a binary operator is a choice, so the tape keeps the token after the left operand"
.decl div_op(x: node, t: span)
div_op(x, t) :- kind(n, "binary_expression"), op(n, "/"), field(n, "left", x), token_after(x, t).

