.policy "eslint-class-methods-use-this" revision 6
.description "Make JavaScript class methods that never use this or super static, or move them out of the class; they don't depend on the instance."
.language javascript
.mode steer
.scope include "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

#include "tsx/eslint-a-functions.rr"
//   fn_holder, held_value, deparen, holder_key, private_key, is_static, member_kind, fn_words, fn_head,
//   this_owner (which function, field value or static block a `this` belongs to)
#include "tsx/modules.rr"
//   fn_region

// ESLint's class-methods-use-this: an instance method that never uses `this` or `super`.
//   class A { foo() { return 1; } }          → Expected 'this' to be used by class method 'foo'.
//   class A { foo() { return this.x; } }     fine
//   class A { static foo() {} }              fine: static, as are constructors
// Arrow functions see their method's `this`; a nested `function` has its own. Options:
//   exceptMethods                 names to skip ("#x" for a private one); computed names are always checked
//   enforceForClassFields         (default true) also check fields holding a function: `foo = () => {}`
//   ignoreOverrideMethods         skip `override` methods (TypeScript)
//   ignoreClassesWithImplements   "all": skip classes with `implements`; "public-fields": only their public members
.violation class_methods_use_this(at: node, name: symbol) code "class-methods-use-this"
    "Expected 'this' to be used by class {name}. Make it static or move it out of the class."
    suppress eslint "class-methods-use-this"
    suppress oxlint "class-methods-use-this"
    suppress biome "lint/nursery/useThisInClassMethods"
class_methods_use_this(at, s) :- checked(h, f), !skipped(h), count : { uses_this(h, t) } = 0,
    fn_words(f, s), fn_head(f, at).

// checked(h, f): instance member h of a class holds function f: a method (not a constructor), or, with
// enforceForClassFields, a field whose value is a function expression or an arrow.
.decl checked(h: node, f: node)
checked(m, m) :- member_kind(m, k), k != "constructor", !is_static(m), class_member(m).
checked(h, f) :- field_fn(h, f), !is_static(h), !option("enforceForClassFields", "false").
.decl field_fn(h: node, f: node)
field_fn(h, f) :- (kind(h, "field_definition") ; kind(h, "public_field_definition")), held_value(h, v),
    deparen(v, f), (kind(f, "function_expression") ; kind(f, "generator_function") ; kind(f, "arrow_function")).

// uses_this(h, t): `this` or `super` t belongs to member h. Each one belongs to its nearest this-scope: a
// function other than an arrow, a field's initialiser, or a static block. So
//   class A { m() { [1].map(x => this.f(x)); } }    uses this;    class A { m() { function g() { this; } } }  does not
.decl uses_this(h: node, t: node)
uses_this(h, t) :- this_owner(t, s), member_frame(h, s).
.decl member_frame(h: node, s: node)  // the `this` owners that are h's own: the method, or the field's value
member_frame(h, h) :- checked(h, h).
member_frame(h, v) :- checked(h, f), h != f, held_value(h, v).
member_frame(h, f) :- checked(h, f), h != f.

// skipped(h): the options exempt h. A computed name is always checked, whatever the options say.
.decl skipped(h: node)
skipped(h) :- named(h), except_name(h, x), option_item("exceptMethods", _, x).
skipped(h) :- named(h), option("ignoreOverrideMethods", "true"), child(h, o, _), kind(o, "override_modifier").
skipped(h) :- named(h), implementing(h), option("ignoreClassesWithImplements", "all").
skipped(h) :- named(h), implementing(h), option("ignoreClassesWithImplements", "public-fields"), !private_key(h, _),
    count : { child(h, a, _), kind(a, "accessibility_modifier"), !text(a, "public") } = 0.
.decl named(h: node)  // h's key is not computed
named(h) :- holder_key(h, k), !kind(k, "computed_property_name").
.decl except_name(h: node, x: symbol)  // the name exceptMethods compares: "foo", "#foo", a literal's value
except_name(h, x) :- private_key(h, x).
except_name(h, x) :- !private_key(h, _), static_key(h, x).
.decl implementing(h: node)  // h is in a class declaration with an `implements` clause
implementing(h) :- checked(h, _), child(b, h, _), field(c, "body", b), kind(c, "class_declaration"),
    child(c, ch, _), kind(ch, "class_heritage"), child(ch, i, _), kind(i, "implements_clause").
