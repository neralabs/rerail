.policy "clippy-unneeded-wildcard-pattern" revision 3
.description "Remove wildcard patterns next to a rest pattern in Rust; the rest pattern already ignores those elements."
.language rust
.mode steer
.scope include "**/*"

#include "rust/syntax-patterns.rr"
//   rest_pat(p, r)   the `..` of a tuple pattern;   wild_before(x, w) / wild_after(x, w)   a `_` element next to x
//   wild_field(f)    a struct-pattern field `name: _`

// Clippy's unneeded_wildcard_pattern (complexity): `_` elements next to a `..` in a tuple or tuple-struct
// pattern, which `..` already skips; and `name: _` fields before a struct pattern's `..`.
//   (0, _, ..)   (0, _, _, ..)   reported at the first `_` of the run
//   (0, .., _)   (0, .., _, _,)  reported right after the `..` (Clippy's span starts there)
//   S { a, c: _, d: _, .. }      reported at `c`
//   (_, 0, ..)   (0, _, _, _)   S { a, d: _ }   not reported
.violation unneeded_wildcard_pattern(at: loc, msg: symbol) code "unneeded_wildcard_pattern" "{msg}"
    suppress clippy "clippy::unneeded_wildcard_pattern", "clippy::all", "clippy::complexity", "warnings"
unneeded_wildcard_pattern(w, "Remove the _ wildcards before this ..; the rest pattern already skips them.") :-
    rest_pat(p, r), !kind(p, "slice_pattern"), left_run(r, w), !wild_before(w, _).
unneeded_wildcard_pattern(c, "Remove the _ wildcards after this ..; the rest pattern already skips them.") :-
    rest_pat(p, r), !kind(p, "slice_pattern"), wild_after(r, _), token_after(r, c).
unneeded_wildcard_pattern(f, "Remove the field: _ entries before this ..; the rest pattern already skips those fields.") :-
    field_run(r, f), !next_field(_, f).
unneeded_wildcard_pattern(f, "Remove the field: _ entries before this ..; the rest pattern already skips those fields.") :-
    field_run(r, f), next_field(g, f), !field_run(r, g).

// left_run(r, w): w is a `_` in the unbroken run of `_` elements before the `..` r.
.decl left_run(r: node, w: span)
left_run(r, w) :- rest_pat(_, r), wild_before(r, w).
left_run(r, w) :- left_run(r, x), wild_before(x, w).
// field_run(r, f): f is a `name: _` field in the unbroken run before the struct pattern's `..` r (always last).
.decl field_run(r: node, f: node)
field_run(r, f) :- kind(r, "remaining_field_pattern"), child(s, r, _), kind(s, "struct_pattern"),
    next_field(f, r), wild_field(f).
field_run(r, f) :- field_run(r, x), next_field(f, x), wild_field(f).
// next_field(f, g): g is the field (or `..`) after f, comments skipped.
.decl next_field(f: node, g: node)
next_field(f, g) :- child(s, f, _), kind(s, "struct_pattern"), !comment(f, _), next_sibling(f, g), !comment(g, _).
next_field(f, g) :- child(s, f, _), kind(s, "struct_pattern"), !comment(f, _), next_sibling(f, c), comment(c, _),
    skip_to(c, g).
.decl skip_to(c: node, g: node)
skip_to(c, g) :- next_sibling(c, g), !comment(g, _).
skip_to(c, g) :- next_sibling(c, d), comment(d, _), skip_to(d, g).
