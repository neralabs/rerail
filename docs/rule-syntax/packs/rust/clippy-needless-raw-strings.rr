.policy "clippy-needless-raw-strings" revision 2
.description "Use a plain Rust string literal instead of a raw one when the contents hold no backslash or quote."
.language rust
.mode steer
.scope include "**/*"

#include "rust/syntax-literals.rr"
//   raw_str(n, hashes, body)   a raw string literal's `#` count and contents

// Clippy's needless_raw_strings (restriction): a raw string (r, br or cr) whose contents hold no `\` and no
// `"`, so a plain literal says the same.
//   r"aaa"   br#"aaa"#   cr""    reported        r"\d+"   r#"a "b""#   "aaa"   not reported
.violation needless_raw_strings(at: node) code "needless_raw_strings"
    "Write this as a plain string literal, e.g. \"text\" instead of r\"text\"; it holds no backslash or quote."
    suppress clippy "clippy::needless_raw_strings", "clippy::restriction", "warnings"
needless_raw_strings(n) :- raw_str(n, _, b), !contains("\\", b), !contains("\"", b).
