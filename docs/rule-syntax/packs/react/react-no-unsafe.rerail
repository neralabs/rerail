.policy "react-no-unsafe" revision 2
.description "Avoid the UNSAFE_componentWillMount, UNSAFE_componentWillReceiveProps and UNSAFE_componentWillUpdate lifecycle methods in class components; they break under async rendering."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

// react/no-unsafe: a class component or createReactClass spec that declares UNSAFE_componentWillMount,
// UNSAFE_componentWillReceiveProps or UNSAFE_componentWillUpdate, as a method, field, spec property, abstract method
// or overload signature (tsx/react's class_component and create_class, tsx/react-class's method_key).
//   class Foo extends React.Component { UNSAFE_componentWillMount() {} }     reported, at the member
//   /** @extends React.Component */ class Foo { UNSAFE_componentWillMount() {} }   reported: JSDoc says component
//   class Foo { UNSAFE_componentWillMount() {} }                             not: not a component
// The option checkAliases (also the unprefixed names) is not in the JSON. A member with decorators is reported
// where its first decorator starts, as ESTree's range includes them. With overloads, the first signature.
#include "tsx/react-class.rerail"

.violation will_mount(at: node)
    code "react/no-unsafe"
    "Move the work in UNSAFE_componentWillMount to componentDidMount (side effects, subscriptions) or the constructor (initial state); it is unsafe with async rendering."
    suppress eslint "react/no-unsafe"
    suppress oxlint "no-unsafe"
.violation will_receive_props(at: node)
    code "react/no-unsafe"
    "Replace UNSAFE_componentWillReceiveProps: derive state from props in static getDerivedStateFromProps, and react to prop changes in componentDidUpdate."
    suppress eslint "react/no-unsafe"
    suppress oxlint "no-unsafe"
.violation will_update(at: node)
    code "react/no-unsafe"
    "Move the work in UNSAFE_componentWillUpdate to componentDidUpdate, reading any DOM values it needs from before the update in getSnapshotBeforeUpdate."
    suppress eslint "react/no-unsafe"
    suppress oxlint "no-unsafe"
will_mount(at) :- unsafe_member("UNSAFE_componentWillMount", at).
will_receive_props(at) :- unsafe_member("UNSAFE_componentWillReceiveProps", at).
will_update(at) :- unsafe_member("UNSAFE_componentWillUpdate", at).

// The plugin reports the first member with the name (getPropertyName: the key's name, so #x and [x] count). A
// component's members are siblings (class body, spec object), so "first" is: no earlier sibling has the name.
.decl unsafe_member(x: symbol, at: node)
unsafe_member(x, at) :- react_component(k), member_named(k, x, m), unsafe_name(x), docof(k, d), react_doc(d),
    !later_twin(k, x, m), member_at(m, at).
.decl later_twin(k: node, x: symbol, m: node)  // m has the name x, and so does a member of k before it
later_twin(k, x, m) :- member_named(k, x, m), unsafe_name(x), member_named(k, x, m2), precedes(m2, m).
.decl unsafe_name(x: symbol)
unsafe_name("UNSAFE_componentWillMount"). unsafe_name("UNSAFE_componentWillReceiveProps").
unsafe_name("UNSAFE_componentWillUpdate").
// member_at(m, at): m, or the first of the decorators just before it (tree-sitter makes them m's siblings).
.decl member_at(m: node, at: node)
member_at(m, m) :- member_named(_, x, m), unsafe_name(x), !decorated(m, _).
member_at(m, a) :- decorated(m, a), count : { next_sibling(b, a), kind(b, "decorator") } = 0.
.decl decorated(m: node, a: node)
decorated(m, a) :- member_named(_, x, m), unsafe_name(x), next_sibling(a, m), kind(a, "decorator").
decorated(m, b) :- decorated(m, a), next_sibling(b, a), kind(b, "decorator").

// Review (react-04): a component declared by its JSDoc, `new createReactClass`, a parenthesised superclass, an
// abstract method, overloads (the first signature), a parenthesised computed key, and the `@jsx` pragma. Each line
// below is ESLint's.
.test review_jsdoc_components exactly
    .fixture "src/us-jsdoc.jsx" ```
        /**
         * @extends React.Component
         */
        class Legacy {
          UNSAFE_componentWillMount() {}
        }
        /** @augments React.PureComponent */
        export class Legacy2 {
          UNSAFE_componentWillUpdate() {}
        }
        /** @extends React.Component */

        class Gap {
          UNSAFE_componentWillMount() {}
        }
        ```
    .fixture "src/us-jsdoc-export.jsx" ```
        /** @extends React.Component */
        export default class Legacy {
          UNSAFE_componentWillMount() {}
        }
        ```
    .expect "react/no-unsafe" at "src/us-jsdoc.jsx":5
    .expect "react/no-unsafe" at "src/us-jsdoc.jsx":9
    .expect "react/no-unsafe" at "src/us-jsdoc-export.jsx":3
.end

.test review_es5_and_superclass exactly
    .fixture "src/us-new.jsx" ```
        const N = new createReactClass({
          UNSAFE_componentWillMount() {},
        });
        ```
    .fixture "src/us-parens-super.jsx" ```
        class A extends (React.Component) {
          UNSAFE_componentWillMount() {}
        }
        ```
    .fixture "src/us-computed-parens.jsx" ```
        class A extends React.Component {
          [(UNSAFE_componentWillMount)]() {}
        }
        ```
    .expect "react/no-unsafe" at "src/us-new.jsx":2
    .expect "react/no-unsafe" at "src/us-parens-super.jsx":2
    .expect "react/no-unsafe" at "src/us-computed-parens.jsx":2
.end

.test review_typescript_signatures exactly
    .fixture "src/us-abstract.tsx" ```
        import React from "react";
        export abstract class Base extends React.Component<{}> {
          abstract UNSAFE_componentWillMount(): void;
        }
        ```
    .fixture "src/us-overload.tsx" ```
        import React from "react";
        export class A extends React.Component<{}> {
          UNSAFE_componentWillReceiveProps(next: {}): void;
          UNSAFE_componentWillReceiveProps(next: {}, ctx: unknown): void;
          UNSAFE_componentWillReceiveProps(next: {}, ctx?: unknown) {}
        }
        ```
    .expect "react/no-unsafe" at "src/us-abstract.tsx":3
    .expect "react/no-unsafe" at "src/us-overload.tsx":3
.end

.test review_jsx_pragma exactly
    .fixture "src/us-pragma.jsx" ```
        /** @jsx h */
        import { h, Component } from "./my-jsx";
        class A extends React.Component {
          UNSAFE_componentWillMount() {}
        }
        class B extends h.Component {
          UNSAFE_componentWillMount() {}
        }
        ```
    .expect "react/no-unsafe" at "src/us-pragma.jsx":7
.end
