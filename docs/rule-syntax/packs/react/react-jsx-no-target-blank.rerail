.policy "react-jsx-no-target-blank" revision 2
.description "Add rel=\"noreferrer\" to links that open in a new tab."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

// react/jsx-no-target-blank, at its defaults (links only, no referrer allowed, spreads trusted, dynamic links
// enforced): an <a> whose target may be "_blank", whose href is external or computed, and whose rel does not
// surely contain "noreferrer". React keeps the last of repeated props, and so does the rule.
//   <a target="_blank" href="https://x">            reported, at the open tag
//   <a target="_blank" href={url} rel="noreferrer">  not reported
//   <a target="_blank" href="/local">               not: a relative link stays on the site
//   <a target={x ? "_blank" : null} href={u} rel={x ? "noreferrer" : ""}>   not: rel follows the same test
// ESLint's fix (add or extend rel) is not offered: the JSON has none.
#include "tsx/react.rerail"

.violation target_blank(at: node)
    code "react/jsx-no-target-blank"
    "Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations"
    suppress eslint "react/jsx-no-target-blank"
    suppress oxlint "jsx-no-target-blank"
target_blank(o) :- react_open(_, o), plain_tag(o, "a"),
    last_prop(o, "target", t), may_blank(t), risky_link(o), !secure_rel(o).

// ESTree has no parentheses, so the plugin reads target={("_blank")}, rel={(c ? "noreferrer" : x)} and a test `(c)`
// as the literal, ternary or name inside: pv and arm take them off.
.decl pv(a: node, v: node)  // prop a's value, parentheses off
pv(a, v) :- prop_value(a, v0), deparen(v0, v).
.decl arm(c: node, f: symbol, v: node)  // ternary c's consequence or alternative f, parentheses off
arm(c, f, v) :- kind(c, "ternary_expression"), (f = "consequence" ; f = "alternative"), field(c, f, v0),
    deparen(v0, v).

// A JSX attribute string is its text with HTML entities decoded (target="_blan&#107;" is "_blank"). Only the
// characters these checks compare can change an outcome: letters (either case), `_`, space, `:` and `/`. jsx_re
// gives each compared word as a regex over the text as written: each such character, or its decimal (&#107;) or
// hex (&#x6b;, lower-case x) reference, leading zeros allowed, as acorn-jsx and TypeScript decode them.
.decl jsx_re(w: symbol, re: symbol)
jsx_re("_blank", "(?:_|&#0*95;|&#x0*5[fF];)(?:[Bb]|&#0*66;|&#x0*42;|&#0*98;|&#x0*62;)(?:[Ll]|&#0*76;|&#x0*4[cC];|&#0*108;|&#x0*6[cC];)(?:[Aa]|&#0*65;|&#x0*41;|&#0*97;|&#x0*61;)(?:[Nn]|&#0*78;|&#x0*4[eE];|&#0*110;|&#x0*6[eE];)(?:[Kk]|&#0*75;|&#x0*4[bB];|&#0*107;|&#x0*6[bB];)").
jsx_re("noreferrer", "(?:[Nn]|&#0*78;|&#x0*4[eE];|&#0*110;|&#x0*6[eE];)(?:[Oo]|&#0*79;|&#x0*4[fF];|&#0*111;|&#x0*6[fF];)(?:[Rr]|&#0*82;|&#x0*52;|&#0*114;|&#x0*72;)(?:[Ee]|&#0*69;|&#x0*45;|&#0*101;|&#x0*65;)(?:[Ff]|&#0*70;|&#x0*46;|&#0*102;|&#x0*66;)(?:[Ee]|&#0*69;|&#x0*45;|&#0*101;|&#x0*65;)(?:[Rr]|&#0*82;|&#x0*52;|&#0*114;|&#x0*72;)(?:[Rr]|&#0*82;|&#x0*52;|&#0*114;|&#x0*72;)(?:[Ee]|&#0*69;|&#x0*45;|&#0*101;|&#x0*65;)(?:[Rr]|&#0*82;|&#x0*52;|&#0*114;|&#x0*72;)").
jsx_re(" ", "(?: |&#0*32;|&#x0*20;)").
// `\w+:` or `//` at the start, \w as JavaScript's (ASCII: [A-Za-z0-9_]; the engine's \w is Unicode).
jsx_re("link", "(?s)(?:(?:[A-Za-z0-9_]|&#0*(?:4[89]|5[0-7]|6[5-9]|[78][0-9]|90|95|9[7-9]|1[01][0-9]|12[0-2]);|&#x0*(?:3[0-9]|4[1-9a-fA-F]|5[0-9aA]|5[fF]|6[1-9a-fA-F]|7[0-9aA]);)+(?::|&#0*58;|&#x0*3[aA];)|(?:/|&#0*47;|&#x0*2[fF];){2}).*").

// The target: target="_BLANK", target={"_blank"}, or a ternary with "_blank" on either side (case ignored).
.decl may_blank(t: node)
may_blank(t) :- pv(t, v), blank_lit(v).
may_blank(t) :- pv(t, c), arm(c, _, v), blank_lit(v).
// String literals are read with str, not value: a rule that reads value makes the engine's later negations on its
// nodes wrong (NOTES-react-03, "value() and negation").
.decl blank_lit(v: node)
blank_lit(v) :- kind(v, "string"), jsx_string(v, s), jsx_re("_blank", re), match(re, s).
blank_lit(v) :- kind(v, "string"), !jsx_string(v, _), str(v, s), @lower(s) = "_blank".
// The link: the last href is a literal with a scheme or `//` (href="mailto:x" counts), or some href is {…}.
.decl risky_link(o: node)
risky_link(o) :- last_prop(o, "href", h), child(h, v, 1), jsx_string(v, u), jsx_re("link", re), match(re, u).
risky_link(o) :- jsx_prop(o, "href", h), child(h, v, 1), kind(v, "jsx_expression").

// The last rel is secure when every value it may have is a string whose space-separated words include noreferrer
// (case ignored). rel_value(o, r, s, j) is one possible value as text, j = 1 for a JSX attribute string (entities
// decoded) and 0 for a JavaScript string; rel_unknown(r) a possible value that is no string.
.decl secure_rel(o: node)
secure_rel(o) :- last_prop(o, "rel", r), !rel_unknown(o, r), count : { rel_value(o, r, s, j), !noreferrer(s, j) } = 0.
// split(' ') keeps a newline inside a word: "noopener\n  noreferrer" has the word noreferrer, hence (?s).
.decl noreferrer(s: symbol, j: number)
noreferrer(s, 0) :- rel_value(_, _, s, 0), match("(?s)(.* )?noreferrer( .*)?", @lower(s)).
noreferrer(s, 1) :- rel_value(_, _, s, 1), jsx_re("noreferrer", w), jsx_re(" ", sp),
    match(cat("(?s)(.*", sp, ")?", w, "(", sp, ".*)?"), s).
.decl rel_value(o: node, r: node, s: symbol, j: number)
rel_value(o, r, s, 1) :- last_prop(o, "rel", r), child(r, v, 1), jsx_string(v, s).
rel_value(o, r, s, 0) :- last_prop(o, "rel", r), rel_expr(r, v), kind(v, "string"), str(v, s).
// `{`noreferrer ${x}`}`: the text before the first substitution.
rel_value(o, r, @replace_all(t, "^`|\\$\\{[\\s\\S]*$|`$", ""), 0) :- last_prop(o, "rel", r), rel_expr(r, v),
    kind(v, "template_string"), text(v, t).
rel_value(o, r, s, 0) :- rel_branch(o, r, v), kind(v, "string"), str(v, s).
.decl rel_unknown(o: node, r: node)
rel_unknown(o, r) :- last_prop(o, "rel", r), !child(r, _, 1).                    // <a rel>
rel_unknown(o, r) :- last_prop(o, "rel", r), child(r, j, 1), kind(j, "jsx_expression"), !rel_expr(r, _).  // rel={}
rel_unknown(o, r) :- last_prop(o, "rel", r), rel_expr(r, v), !kind(v, "string"), !kind(v, "template_string"),
    !kind(v, "ternary_expression").
rel_unknown(o, r) :- rel_branch(o, r, v), !kind(v, "string").
rel_unknown(o, r) :- last_prop(o, "rel", r), rel_expr(r, c), kind(c, "ternary_expression"), paired(o, c, tc),
    count : { arm(tc, "consequence", b), blank_exact(b) } = 0,
    count : { arm(tc, "alternative", b), blank_exact(b) } = 0.
.decl rel_expr(r: node, v: node)
rel_expr(r, v) :- kind(r, "jsx_attribute"), child(r, j, 1), kind(j, "jsx_expression"), pv(r, v).
// rel={c ? "noreferrer" : ""} has both values, unless target is a ternary on the same test: then only the side
// where target is exactly "_blank". ESLint compares the tests' names (`test.name`), so two tests with no name
// (a.b, f()) count as the same; `undefined` is a name, though tree-sitter gives it a kind of its own.
.decl rel_branch(o: node, r: node, v: node)
rel_branch(o, r, v) :- last_prop(o, "rel", r), rel_expr(r, c), kind(c, "ternary_expression"), !paired(o, c, _),
    arm(c, _, v).
rel_branch(o, r, v) :- last_prop(o, "rel", r), rel_expr(r, c), paired(o, c, tc), arm(tc, "consequence", b),
    blank_exact(b), arm(c, "consequence", v).
rel_branch(o, r, v) :- last_prop(o, "rel", r), rel_expr(r, c), paired(o, c, tc), arm(tc, "alternative", b),
    blank_exact(b), count : { arm(tc, "consequence", b2), blank_exact(b2) } = 0, arm(c, "alternative", v).
.decl paired(o: node, c: node, tc: node)  // rel's ternary c and target's ternary tc test the same name
paired(o, c, tc) :- last_prop(o, "rel", r), rel_expr(r, c), kind(c, "ternary_expression"), last_prop(o, "target", t),
    pv(t, tc), kind(tc, "ternary_expression"), field(c, "condition", a0), deparen(a0, a), field(tc, "condition", b0),
    deparen(b0, b), (test_name(a, x), test_name(b, x) ; !test_name(a, _), !test_name(b, _)).
.decl test_name(a: node, x: symbol)
test_name(a, x) :- (kind(a, "identifier") ; kind(a, "undefined")), text(a, x).
.decl blank_exact(b: node)
blank_exact(b) :- kind(b, "string"), str(b, "_blank").

// The review's counterexamples (react-03.review.md) and a few more, each checked against ESLint 9.39.5 and
// eslint-plugin-react 7.37.5: parentheses are no nodes, a rel's words may be split by a newline, \w is ASCII, a test
// named `undefined` has a name, and attribute strings have their entities decoded (JavaScript strings do not).
.test review_cases exactly
    .fixture "tb-paren.jsx" ```
        const a = <a target={("_blank")} href="https://x.example">x</a>;
        const b = <a target={(open ? "_blank" : null)} href="https://x.example">x</a>;
        const c = <a target={open ? ("_blank") : null} href="https://x.example">x</a>;
        const d = <a target="_blank" href="https://x.example" rel={("noreferrer")}>x</a>;
        const e = <a target="_blank" href="https://x.example" rel={(dev ? "noreferrer" : "noopener noreferrer")}>x</a>;
        const f = <a target="_blank" href="https://x.example" rel={dev ? ("noreferrer") : "noreferrer"}>x</a>;
        const g = <a target={(t) ? "_blank" : null} href={u} rel={t ? "noreferrer" : "x"}>x</a>;
        ```
    .fixture "tb-newline.jsx" ```
        const a = <a target="_blank" href="https://x.example" rel="noopener
          noreferrer">x</a>;
        ```
    .fixture "tb-unicode.jsx" ```
        const a = <a target="_blank" href="ü:x">x</a>;
        ```
    .fixture "tb-undefined.jsx" ```
        const a = <a target={undefined ? "_blank" : null} href={u} rel={x.y ? "noreferrer" : "x"}>x</a>;
        ```
    .fixture "tb-entity.jsx" ```
        const a = <a target="_blan&#107;" href="https://x.example">x</a>;
        const b = <a target="_blank" href="https://x.example" rel="noreferrer&#32;noopener">x</a>;
        ```
    .fixture "tb-extra.jsx" ````
        const a = <a target="_blank" href="https&#58;//x.example">x</a>;
        const b = <a target="_blank" href="&#x2f;/x.example">x</a>;
        const c = <a target="_blank" href="https://x.example" rel={"noopener&#32;noreferrer"}>x</a>;
        const d = <a target="_blan&#X6b;" href="https://x.example">x</a>;
        const e = <a target="_BLAN&#x4B;" href="https://x.example">x</a>;
        const f = <a target="_blank" href="https://x.example" rel="NoReferrer&#x20;x">x</a>;
        const g = <a target="_blank" href="https://x.example" rel="x&#0032;noreferrer">x</a>;
        const h = <a target={((open)) ? (("_blank")) : null} href={u} rel={(open) ? ("noreferrer") : null}>x</a>;
        const i = <a target={open ? "_blank" : null} href={u} rel={((open)) ? "noreferrer" : null}>x</a>;
        const j = <a target={undefined ? "_blank" : null} href={u} rel={undefined ? "noreferrer" : "x"}>x</a>;
        const k = <a target={x.y ? "_blank" : null} href={u} rel={a.b ? "noreferrer" : "x"}>x</a>;
        const l = <a target="_blank" href="1:x">x</a>;
        const m = <a target="_blank" href="ab:x">x</a>;
        const n = <a target="_blank" href={`//x`} rel={(`noreferrer ${x}`)}>x</a>;
        ````
    .expect "react/jsx-no-target-blank" at "tb-paren.jsx":1
    .expect "react/jsx-no-target-blank" at "tb-paren.jsx":2
    .expect "react/jsx-no-target-blank" at "tb-paren.jsx":3
    .expect "react/jsx-no-target-blank" at "tb-undefined.jsx":1
    .expect "react/jsx-no-target-blank" at "tb-entity.jsx":1
    .expect "react/jsx-no-target-blank" at "tb-extra.jsx":1
    .expect "react/jsx-no-target-blank" at "tb-extra.jsx":2
    .expect "react/jsx-no-target-blank" at "tb-extra.jsx":3
    .expect "react/jsx-no-target-blank" at "tb-extra.jsx":5
    .expect "react/jsx-no-target-blank" at "tb-extra.jsx":12
    .expect "react/jsx-no-target-blank" at "tb-extra.jsx":13
.end
