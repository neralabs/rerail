.policy "react-no-did-update-set-state" revision 2
.description "Avoid calling setState in componentDidUpdate; it triggers a second render after every update and can loop."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

// react/no-did-update-set-state: this.setState(…) inside a method, property or class field named componentDidUpdate,
// unless it sits in a nested function (the default mode, "allow-in-func"; "disallow-in-func" is not in the JSON).
//   componentDidUpdate() { this.setState({ a: 1 }); }                       reported, at the callee
//   componentDidUpdate() { fetch(u).then(() => this.setState({ a: 1 })); }  not: inside a callback
// Any key named componentDidUpdate counts, in a component or not, and an arrow is a function here as any other.
// The plugin makes the rule a no-op where settings name React 16.3 or later; with no version set (the
// recording) it assumes the latest and checks.
#include "tsx/react-class.rr"
//   set_state_in(f, x)  f calls this.setState in a member keyed x, in no function nested in the member

.violation no_did_update_set_state(at: node)
    code "react/no-did-update-set-state"
    "Derive this value from props during render instead of calling setState in componentDidUpdate; leave it only when a prevProps or prevState check guards it."
    suppress eslint "react/no-did-update-set-state"
    suppress oxlint "no-did-update-set-state"
no_did_update_set_state(f) :- set_state_in(f, "componentDidUpdate"), docof(f, d), react_doc(d).
