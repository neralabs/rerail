.policy "react-no-access-state-in-setstate" revision 2
.description "Compute class component state updates from the updater callback's previous-state argument instead of this.state; setState batches updates, so this.state may be stale."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

// react/no-access-state-in-setstate: in a class component or createReactClass spec, a read of this.state that
// reaches the first argument of this.setState(…):
//   this.setState({ value: this.state.value + 1 });                        directly
//   const next = this.state.value + 1; this.setState({ value: next });     through a variable in the same scope
//   const { state } = this; this.setState({ value: state.value + 1 });     through `state` destructured from this
//   getNext() { return this.state.value; }  …  this.setState(getNext());    through a method, called by bare name
// The plugin walks the file once, in order, so a variable or method counts only once its this.state read has
// been seen (src_before: core's earlier has no rows on JavaScript and TypeScript yet); and only a bare call
// `getNext()` is matched to a method, `this.getNext()` is not.
//   this.setState(s => ({ value: s.value + 1 }));                           not reported
#include "tsx/react-class.rerail"
//   comp_owner(n, k)  n is in class component or spec k;  this_call(c, x, f): c calls this.x(…)
#include "tsx/next-01.rerail"
//   src_before(m, n)  m starts before n in the same document

.violation direct(at: node)
    code "react/no-access-state-in-setstate"
    "Pass setState an updater function and read the previous state from its argument instead of this.state."
    suppress eslint "react/no-access-state-in-setstate"
.violation variable(at: node, decl: symbol)
    code "react/no-access-state-in-setstate"
    "This this.state read reaches setState through {decl}; pass setState an updater function and read the previous state from its argument."
    suppress eslint "react/no-access-state-in-setstate"
.violation destructured_state(at: node)
    code "react/no-access-state-in-setstate"
    "The state destructured from this here reaches setState; pass setState an updater function and read the previous state from its argument."
    suppress eslint "react/no-access-state-in-setstate"
.violation method_call(at: node, callee: symbol)
    code "react/no-access-state-in-setstate"
    "This this.state read reaches a setState call through {callee}; pass setState an updater function and read the previous state from its argument."
    suppress eslint "react/no-access-state-in-setstate"

// read(m, s): this.state m in a component, and s the first of these above it: a setState call whose first argument
// holds m, a method, a function keyed by a property or field, or a variable declarator.
.decl read(m: node, s: node)
read(m, s) :- state_read(m), comp_owner(m, _), docof(m, d), react_doc(d),
    k = max j : { stop(m, t), ast_depth(t, j) }, stop(m, s), ast_depth(s, k).
.decl stop(m: node, s: node)
stop(m, c) :- state_read(m), this_call(c, "setState", _), in_first_arg(m, c).
stop(m, f) :- state_read(m), inside(m, f, "method_definition").
stop(m, f) :- state_read(m), inside(m, f, "function_expression"), estree_parent(f, p), kind(p, k), keyed_kind(k).
stop(m, v) :- state_read(m), inside(m, v, "variable_declarator").
.decl in_first_arg(n: node, c: node)  // n is c's first argument or inside it
in_first_arg(n, c) :- call_arg(c, a, 0), (n = a ; within(n, a)), this_call(c, "setState", _).

direct(m) :- read(m, c), kind(c, "call_expression").
// Through a variable: `next` read as an object (next.x) or a property value ({ value: next }), maybe inside
// a binary expression, in a setState's first argument, in the scope the read was in.
variable(m, x) :- read(m, v), kind(v, "variable_declarator"), field(v, "name", n), kind(n, "identifier"), text(n, x),
    use_in_set_state(u, x), same_scope(m, u), src_before(m, u).
// `const { state } = this` counts anywhere, in a component or not: the plugin's ObjectPattern visitor asks for none
// (React.createClass({ onClick() { var { state } = this; this.setState({ v: state.v }); } }) is reported).
destructured_state(k) :- kind(o, "object_pattern"), estree_parent(o, v), kind(v, "variable_declarator"),
    field(v, "value", t), kind(t, "this"), child(o, p, _), state_key(p, k), docof(o, d), react_doc(d),
    use_in_set_state(u, "state"), same_scope(o, u), src_before(o, u).
.decl state_key(p: node, k: node)  // { state }, { state: s }, { state = x }: the key named state
state_key(p, p) :- kind(p, "shorthand_property_identifier_pattern"), text(p, "state").
state_key(p, k) :- kind(p, "pair_pattern"), field(p, "key", k), estree_name(k, "state").
state_key(p, l) :- kind(p, "object_assignment_pattern"), field(p, "left", l), text(l, "state").
.decl use_in_set_state(u: node, x: symbol)
use_in_set_state(u, x) :- used_as_value(u, x), this_call(c, "setState", _), in_first_arg(u, c).
// The plugin's Identifier visitor: the name is a property's value ({ v: next }) or a member's object (next.x,
// next[0]), maybe first climbing BinaryExpressions. ESTree makes &&, || and ?? a LogicalExpression, which it does not
// climb, so { v: next || 0 } is no use; tree-sitter makes them binary_expressions too.
.decl used_as_value(u: node, x: symbol)
used_as_value(u, x) :- kind(u, "identifier"), text(u, x), above_binary(u, t), estree_parent(t, p),
    (kind(p, "pair"), field(p, "value", v), deparen(v, t) ;
    (kind(p, "member_expression") ; kind(p, "subscript_expression")), field(p, "object", o), deparen(o, t)).
used_as_value(u, x) :- kind(u, "shorthand_property_identifier"), text(u, x).
.decl above_binary(u: node, t: node)  // t is u or a binary expression u sits in (through binary expressions only)
above_binary(u, u) :- kind(u, "identifier").
above_binary(u, b) :- above_binary(u, t), estree_parent(t, b), kind(b, "binary_expression"), !op(b, "&&"),
    !op(b, "||"), !op(b, "??").

// Through a method: a method whose this.state read was seen, called inside a setState's first argument; and a
// class method that calls such a method by its bare name inherits it. The plugin matches names with `===`, and a
// method whose key has no `.name` (['compute']() {}, 'compute'() {}) is recorded as undefined, as is a call whose
// callee is no identifier (Object.assign(…), this.helper()): those match each other. "" stands for undefined.
method_call(m, s) :- holds_read(x, m, t), callee_name(c, x), comp_owner(c, _), this_call(sc, "setState", _),
    in_first_arg(c, sc), src_before(t, c), (x != "", s = cat(x, "()") ; x = "", s = "a method whose key has no name").
.decl callee_name(c: node, x: symbol)  // ESTree's callee.name of call c: an identifier's text, else undefined ("")
callee_name(c, x) :- called(c, f), kind(f, "identifier"), text(f, x).
callee_name(c, "") :- called(c, f), !kind(f, "identifier"), !kind(f, "import").
.decl holds_read(x: symbol, m: node, t: node)  // method x holds this.state read m, known from node t on
holds_read(x, m, m) :- read(m, s), (kind(s, "method_definition") ; kind(s, "function_expression")), method_name_of(s,
    x).
// The caller is the nearest class method around the call (an object literal's method is a Property, not one).
holds_read(y, m, c) :- holds_read(x, m, t), x != "", callee_name(c, x), comp_owner(c, _), src_before(t, c),
    nearest(c, g, class_method), key_name(g, y).
.decl class_method(g: node)
class_method(g) :- kind(g, "method_definition"), child(b, g, _), kind(b, "class_body").
.decl method_name_of(s: node, x: symbol)  // the key of method s, or of the property or field holding function s
method_name_of(s, x) :- kind(s, "method_definition"), key_name(s, x).
method_name_of(s, x) :- kind(s, "function_expression"), estree_parent(s, p), key_name(p, x).
.decl key_name(m: node, x: symbol)  // keyed node m's key.name, or "" when its key has none
key_name(m, x) :- method_key(m, x).
key_name(m, "") :- kind(m, k), keyed_kind(k), (field(m, "name", n) ; field(m, "property", n) ; field(m, "key", n)),
    !estree_name(n, _).

// The review's counterexamples (react-03.review.md) and a few more, each checked against ESLint 9.39.5 and
// eslint-plugin-react 7.37.5: &&, || and ?? are no use of a variable, x[i] is, parentheses are no nodes, and a
// method whose key has no name is matched to any call whose callee has none.
.test review_cases exactly
    .fixture "as-logical.jsx" ```
        class A extends React.Component {
          f() { const next = this.state.n; this.setState({ n: next || 0 }); }
          g() { const q = this.state.q; this.setState({ q: q && 1 }); }
          h() { const r = this.state.r; this.setState({ r: r ?? 1 }); }
        }
        ```
    .fixture "as-subscript.jsx" ```
        class A extends React.Component {
          g() { const list = this.state.list; this.setState({ first: list[0] }); }
        }
        ```
    .fixture "as-paren.jsx" ```
        class A extends React.Component {
          a() { (this.setState)({ x: this.state.x }); }
          b() { this.setState({ x: (this).state.x }); }
        }
        ```
    .fixture "as-unnamed.jsx" ```
        class A extends React.Component {
          ['compute']() { return this.state.x; }
          onClick() { this.setState({ x: Object.assign({}, this.props) }); }
        }
        ```
    .fixture "as-extra.jsx" ```
        class A extends React.Component {
          a() { const n = this.state.n; this.setState({ v: (n) + 1 }); }
          b() { const m = this.state.m; this.setState({ v: m + 1 || 2 }); }
          c() { const k = this.state.k; this.setState({ v: (k)[0] }); }
          d() { const p = this.state.p; this.setState({ v: p.q && 1 }); }
          'quoted'() { return this.state.y; }
          e() { this.setState({ v: quoted() }); }
          f() { this.setState({ v: this.helper() }); }
          [computedKey]() { return this.state.z; }
          g() { this.setState({ v: computedKey() }); }
        }
        ```
    .expect "react/no-access-state-in-setstate" at "as-subscript.jsx":2
    .expect "react/no-access-state-in-setstate" at "as-paren.jsx":2
    .expect "react/no-access-state-in-setstate" at "as-paren.jsx":3
    .expect "react/no-access-state-in-setstate" at "as-unnamed.jsx":2
    .expect "react/no-access-state-in-setstate" at "as-extra.jsx":2
    .expect "react/no-access-state-in-setstate" at "as-extra.jsx":4
    .expect "react/no-access-state-in-setstate" at "as-extra.jsx":5
    .expect "react/no-access-state-in-setstate" at "as-extra.jsx":6
    .expect "react/no-access-state-in-setstate" at "as-extra.jsx":9
.end
