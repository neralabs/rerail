.policy "react-hooks-globals" revision 2
.description "Don't reassign variables declared outside a component or hook while it renders; React may render it any number of times, in any order."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

// react-hooks/globals (React Compiler): rendering must not reassign a variable the component or hook does not
// own, a module-level `let` or an undeclared global, in its render code or in a function that may run then.
//   let count = 0;
//   function Counter() { count = count + 1; … }                  reported
//   [a, b] = pair;  ({ last } = next);                           reported: each name a pattern assigns
//   const bump = () => { count += 1; }; items.map(bump);         reported: bump may run during render
//   const bump = () => { count += 1; }; return <b>{bump}</b>;    reported: an element's child may be called
//   useEffect(() => { count = 0; });  <b onClick={() => { count = 0; }}/>   not: they run later
//   <Menu items={[{ run: () => { count = 0; } }]}/>              not: handed on inside the prop (tsx/react-01)
// Changing a property of an outer object (`config.x = 1`) is react-hooks/immutability's.
// `count++` is not reported by the compiler (an update expression is not a reassignment to it), nor here; neither
// is `for (count of items)`.
#include "tsx/react-01.rerail"

.violation globals(at: node, name: node)
    code "react-hooks/globals"
    "Update `{name}` in an effect or event handler instead of during render, or keep the value in state or a ref; it is declared outside the component or hook."
    suppress eslint "react-hooks/globals"
    suppress oxlint "globals"
globals(n, n) :- reassigned(n), rc_own(n, h), (rc_render_fn(h, f) ; r01_live_fn(h, f)), !owned_by(n, f).
// reassigned(n): name n is assigned: `n = v`, `n += v`, or a name a pattern assigns, `[n, …rest] = v`.
.decl reassigned(n: node)
reassigned(n) :- write_target(n, a), (kind(a, "assignment_expression") ; kind(a, "augmented_assignment_expression")),
    (field(a, "left", n) ; bound_name(n, _)).
// owned_by(n, f): n names a binding declared inside f.
.decl owned_by(n: node, f: node)
owned_by(n, f) :- ref_site(n, s), within(s, f), rc_compiled(f).

// Review react-01, globals 1: destructuring assignments reassign each global they name.
.test each_name_a_pattern_assigns_is_reported exactly
    .fixture "src/g1.jsx" ```
        let a = 0, b = 0;
        export function Pair() {
          [a, b] = [1, 2];
          return <b>{a}</b>;
        }
        ```
    .fixture "src/g4.jsx" ```
        let last = null;
        export function Track({ id }) {
          ({ last } = { last: id });
          return <b>{id}</b>;
        }
        ```
    .expect "react-hooks/globals" at "src/g1.jsx":3
    .expect "react-hooks/globals" at "src/g4.jsx":3
.end

// Review react-01, globals 2: an element's child gets the compiler's Render effect; a fragment's does not.
.test a_function_rendered_as_a_child_may_run exactly
    .fixture "src/g8.jsx" ```
        let n = 0;
        export function C() {
          const bump = () => { n = n + 1; };
          return <b>{bump}</b>;
        }
        ```
    .fixture "src/frag.jsx" ```
        let n = 0;
        export function C() {
          const bump = () => { n = n + 1; };
          return <>{bump}</>;
        }
        ```
    .expect "react-hooks/globals" at "src/g8.jsx":3
.end
