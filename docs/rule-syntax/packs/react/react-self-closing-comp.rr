.policy "react-self-closing-comp" revision 2
.description "Self-close JSX elements that have no children."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

// react/self-closing-comp: an element with nothing between its tags should be written <X />. Both of the rule's
// options (component, html) default to true, so components and DOM elements are both checked.
//   <Foo></Foo>        reported, at the open tag      <div>\n  </div>    reported: only blank lines inside
//   <div> </div>       not: one space is a text child  <a:b></a:b>        reported; <A:b></A:b> is neither kind
// tree-sitter drops JSX text that is blank and has a line break, as React does, so "no child" covers both
// of the rule's cases (no children; one child of spaces holding a newline). A non-breaking space is kept.
#include "tsx/react.rr"

.violation self_closing(at: node)
    code "react/self-closing-comp"
    "Empty components are self-closing"
    suppress eslint "react/self-closing-comp"
    suppress oxlint "self-closing-comp"
    fix self_close "Self-close the element"
self_closing(o) :- react_open(e, o), kind(e, "jsx_element"), field(o, "name", n), checked_name(n),
    count : { child(e, c, _), !field(e, "open_tag", c), !field(e, "close_tag", c) } = 0.
// A component (<Foo>, <Foo.Bar>) or a DOM element (<div>, <svg:path>); a namespaced name only when lower-case.
.decl checked_name(n: node)
checked_name(n) :- kind(n, "identifier") ; kind(n, "member_expression").
checked_name(n) :- kind(n, "jsx_namespace_name"), glob("[a-z]**", n).
// ESLint's fix: everything from the open tag's `>` to the end of the close tag becomes ` />`.
// The `>` is o's last character (its kind implies it; the tape keeps none).
self_close(o) :- match("(?s).*(?<gt>>)", o), jsx_open(e, o), field(e, "close_tag", c) => replace(gt, ` />`), delete(c).
