.policy "react-hooks-set-state-in-effect" revision 2
.description "Avoid setting state synchronously in the body of a useEffect, useLayoutEffect or useInsertionEffect callback; derive the value during render or set it from a subscription callback."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

// react-hooks/set-state-in-effect (React Compiler): a setter called synchronously in an effect's body renders
// again right after every commit; the value can usually be derived during render instead.
//   useEffect(() => { setItems(filter(all)); }, [all]);          reported at the setter call
//   useEffect(() => { fetch(u).then(r => setItems(r)); }, [u]);  not: the callback runs later
//   const sync = () => setItems(…); useEffect(sync, []);          reported at `sync`, the effect
//   useEffect(() => { sync(); }, []);                              reported at sync(): it sets state now
// One finding per effect, at the first such call, as the compiler stops at it. A function a component stores
// (`const f = () => …`, `function f() {}`, `const f = useCallback(() => …, [])`) is followed one level; one
// declared inside the effect is not, nor one that names itself (`const f = () => { setTimeout(() => f()); }`: the
// compiler makes it a context variable, which it does not track). The effect hook must be React's (imported from
// "react", React.useEffect, or an unimported global): `import useLayoutEffect from 'use-isomorphic-layout-effect'`
// is another library's.
// Values from refs are the exception (the compiler's enableAllowSetStateFromRefsInEffects, on by default):
//   useLayoutEffect(() => { setW(ref.current.offsetWidth); }, []);       not: the value comes from a ref, and
//                                                                        the compiler stops looking at this effect
//   useEffect(() => { const el = ref.current; if (!el) return; setW(f(el)); });   not, for the same reason
//   useEffect(() => { if (ref.current) setOpen(true); });                 not: the call is controlled by a ref
#include "tsx/react-02.rerail"
#include "tsx/react-practice-a.rerail"   // react_api

.violation set_state_in_effect(at: node, msg: symbol)
    code "react-hooks/set-state-in-effect"
    "{msg}"
    suppress eslint "react-hooks/set-state-in-effect"
    suppress oxlint "set-state-in-effect"
set_state_in_effect(c, m) :- effect_body(g), first(g, c), !from_ref(g, c), says("inline", m).
set_state_in_effect(a, m) :- effect(e), call_arg(e, a, 0), kind(a, "identifier"), ref_site(a, s), local_fn(s, l),
    sets_state(l), says("named", m).

// effect(e): React's useEffect(…), useLayoutEffect(…) or useInsertionEffect(…) in a compiled function's render
// code; effect_body(g): its callback, written in place.
.decl effect(e: node)
effect(e) :- rc_effect_call(e), rc_own(e, h), rc_render_fn(h, _), field(e, "function", f), react_api(f, x, src, _),
    (src = "react" ; src = ""), effect_hook(x).
.decl effect_body(g: node)
effect_body(g) :- effect(e), call_arg(e, a, 0), deparen(a, g), rc_fn(g).
// local_fn(s, l): binding s of the render code holds function l, written in place or wrapped in useCallback
// (the compiler drops manual memoization before it validates), and l does not name s.
.decl local_fn(s: node, l: node)
local_fn(s, l) :- held_fn(s, l), count : { ref_site(r, s), within(r, l) } = 0.
.decl held_fn(s: node, l: node)
held_fn(s, l) :- rc_fn_at(s, l), rc_own(l, h), rc_render_fn(h, _).
held_fn(s, l) :- kind(s, "variable_declarator"), field(s, "value", v), deparen(v, c), rc_react_call(c, "useCallback"),
    call_arg(c, a, 0), deparen(a, l), rc_fn(l), rc_own(s, h), rc_render_fn(h, _).
// checked(g): a function the compiler asks "does it set state?" (getSetStateCall): an effect's callback, a local
// function.
.decl checked(g: node)
checked(g) :- effect_body(g).
checked(l) :- local_fn(_, l).

// The compiler walks g's code in order and takes the first setter call that a ref does not control; when that
// call's argument comes from a ref, g sets no state at all. Order is start offset.
//   direct_first(g, c): over g's own setter calls; sets_state(l): local function l sets state.
//   first(g, c): over an effect's setter calls and its calls of local functions that set state.
.decl direct(g: node, c: node)  // a setter call in g's own code, after the setter's useState
direct(g, c) :- checked(g), rcx_set_state(c), rc_own(c, g), field(c, "function", n), ref_site(n, s), rcx_before(s, c).
.decl direct_first(g: node, c: node)
direct_first(g, c) :- checked(g), i = min j : { direct(g, x), counts(g, x), node(_, x, _, j, _) }, direct(g, c),
    node(_, c, _, i, _).
.decl sets_state(l: node)
sets_state(l) :- local_fn(_, l), direct_first(l, c), !from_ref(l, c).
.decl call(g: node, c: node)
call(g, c) :- effect_body(g), direct(g, c).
call(g, k) :- effect_body(g), rc_own(k, g), kind(k, "call_expression"), field(k, "function", n), kind(n, "identifier"),
    ref_site(n, s), local_fn(s, l), sets_state(l).
.decl first(g: node, c: node)
first(g, c) :- effect_body(g), i = min j : { call(g, x), counts(g, x), node(_, x, _, j, _) }, call(g, c),
    node(_, c, _, i, _).
// counts(g, c): the call decides: its argument comes from a ref (the compiler stops, finding nothing), or no ref
// controls it (the compiler reports it). A call a ref controls is passed over.
.decl counts(g: node, c: node)
counts(g, c) :- checked(g), rc_own(c, g), kind(c, "call_expression"), (from_ref(g, c) ; !ref_controlled(g, c)).
.decl from_ref(g: node, c: node)  // c's first argument is derived from a ref
from_ref(g, c) :- checked(g), rc_own(c, g), kind(c, "call_expression"), call_arg(c, a, 0), derived(g, a).

// derived(g, e): expression e in g reads a ref, or a variable of g that holds a value derived from one: the
// compiler's refDerivedValues, where an instruction with a derived operand derives its result.
//   const r = ref.current.getBoundingClientRect();  const { a } = stateRef.current;  x = f(ref);  o.k = el;
//   let v = n; if (keyRef.current) { v = 1; }       v: a phi with an operand from a block a ref controls
.decl derived(g: node, e: node)
derived(g, e) :- checked(g), reads_ref(g, n), (e = n ; within(n, e)), within(e, g).
.decl reads_ref(g: node, n: node)
reads_ref(g, n) :- checked(g), kind(n, "identifier"), within(n, g), ref_site(n, s), (rc_ref_site(s) ; tainted(g, s)).
.decl tainted(g: node, s: node)  // binding site s, in g, gets a derived value
tainted(g, d) :- kind(d, "variable_declarator"), field(d, "value", v), derived(g, v).
tainted(g, s) :- kind(d, "variable_declarator"), field(d, "value", v), field(d, "name", p), within(s, p), derived(g, v).
tainted(g, s) :- kind(a, "assignment_expression"), field(a, "right", v), derived(g, v), field(a, "left", l),
    (n = l ; field(l, "object", n)), kind(n, "identifier"), ref_site(n, s).
tainted(g, s) :- kind(a, "assignment_expression"), ref_controlled(g, a), field(a, "left", n), kind(n, "identifier"),
    ref_site(n, s).

// ref_controlled(g, c): a branch whose test is derived decides whether c runs (c's block has it in its
// post-dominance frontier): c is in a branch of an if, ?:, && || ?? or switch on a derived test, or follows an
// `if (derived) … return` and is in no branch that starts after it (that branch's test decides c's block).
//   const el = ref.current; if (el && el.offsetWidth < el.scrollWidth) setTip(true);
//   const menu = ref.current; if (!menu) return; if (x) f(); setHeight(f(menu));   not reported
//   if (!ref.current) return; switch (s) { case 1: setS(2); }                       reported: the switch decides
.decl ref_controlled(g: node, c: node)
ref_controlled(g, c) :- checked(g), rc_own(c, g), inside(c, s, "if_statement"), within(s, g), field(s, "condition", t),
    derived(g, t), !within(c, t).
ref_controlled(g, c) :- checked(g), rc_own(c, g), inside(c, s, "ternary_expression"), within(s, g),
    field(s, "condition", t), derived(g, t), !within(c, t).
ref_controlled(g, c) :- checked(g), rc_own(c, g), inside(c, s, "binary_expression"), within(s, g), rc_lazy(s),
    field(s, "left", t), derived(g, t), !within(c, t).
ref_controlled(g, c) :- checked(g), rc_own(c, g), inside(c, s, "switch_statement"), within(s, g), field(s, "value", t),
    derived(g, t), !within(c, t).
ref_controlled(g, c) :- checked(g), rc_own(c, g), kind(s, "if_statement"), rc_own(s, g), field(s, "condition", t),
    derived(g, t), has(s, r, return_kind), rc_own(r, g), node(_, s, _, _, e), node(_, c, _, i, _), e <= i,
    count : { inside(c, b, rc_branch_kind), rc_own(b, g), node(_, b, _, j, _), e <= j } = 0,
    count : { inside(c, b, "binary_expression"), rc_lazy(b), rc_own(b, g), node(_, b, _, j, _), e <= j } = 0.
.decl return_kind(k: symbol)  // a throw is no exit to the compiler's post-dominators
return_kind("return_statement").

.decl says(id: symbol, m: symbol)
says("inline", "Don't set state synchronously in this effect: derive the value during render, or set it from a callback the effect subscribes; a setState here re-renders right after every commit.").
says("named", "Don't pass a function that sets state synchronously as this effect: derive the value during render, or set it from a callback the effect subscribes.").
