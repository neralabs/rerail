.policy "react-no-did-mount-set-state" revision 2
.description "Avoid calling setState directly in componentDidMount; it triggers a second render before the browser paints."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"

// react/no-did-mount-set-state: this.setState(…) inside a method, property or class field named componentDidMount,
// unless it sits in a nested function (the default mode, "allow-in-func"; "disallow-in-func" is not in the JSON).
//   componentDidMount() { this.setState({ a: 1 }); }                       reported, at the callee
//   componentDidMount() { fetch(u).then(() => this.setState({ a: 1 })); }  not: inside a callback
// Any key named componentDidMount counts, in a component or not, and an arrow is a function here as any other.
// The plugin makes the rule a no-op where settings name React 16.3 or later; with no version set (the
// recording) it assumes the latest and checks.
#include "tsx/react-class.rerail"
//   set_state_in(f, x)  f calls this.setState in a member keyed x, in no function nested in the member

.violation no_did_mount_set_state(at: node)
    code "react/no-did-mount-set-state"
    "Initialize this state in the constructor or set it from a later callback; keep it here only when it depends on measuring the rendered DOM, such as a tooltip's position."
    suppress eslint "react/no-did-mount-set-state"
    suppress oxlint "no-did-mount-set-state"
no_did_mount_set_state(f) :- set_state_in(f, "componentDidMount"), docof(f, d), react_doc(d).

// The review's counterexamples (react-03.review.md), each checked against ESLint 9.39.5 and eslint-plugin-react
// 7.37.5: parentheses around `this` or the callee, a shorthand default in a pattern, an `accessor` field (skipped),
// a parenthesised computed key.
.test review_cases exactly
    .fixture "sm-paren.jsx" ```
        class A extends React.Component {
          componentDidMount() { (this.setState)({ a: 1 }); }
          componentDidUpdate() { (this).setState({ a: 1 }); }
        }
        ```
    .fixture "sm-default.jsx" ```
        class A extends React.Component {
          load() { const { componentDidMount = this.setState({}) } = this.props; }
          save() { const { componentDidUpdate = this.setState({}) } = this.props; }
        }
        ```
    .fixture "sm-accessor.tsx" ```
        import React from "react";
        class B extends React.Component {
          accessor componentDidMount = this.setState({ a: 1 });
          accessor componentDidUpdate = () => { this.setState({ a: 1 }); };
        }
        ```
    .fixture "sm-computed-paren.jsx" ```
        class A extends React.Component {
          m() { const o = { [(componentDidMount)]: this.setState({}) }; }
        }
        ```
    .fixture "sm-extra.jsx" ```
        class A extends React.Component {
          m(o) { const f = ({ componentDidMount = this.setState({}) }) => 1; }
          n() { const { componentDidMount: c = this.setState({}) } = this.props; }
          o() { const { componentDidUpdate = () => this.setState({}) } = this.props; }
          p() { const [componentDidMount = this.setState({})] = []; }
          componentDidMount() { ((this)).setState({}); }
          componentDidUpdate() { ((this.setState))({}); }
          q() { const o = { [((componentDidUpdate))]: this.setState({}) }; }
        }
        ```
    .expect "react/no-did-mount-set-state" at "sm-paren.jsx":2
    .expect "react/no-did-mount-set-state" at "sm-default.jsx":2
    .expect "react/no-did-mount-set-state" at "sm-computed-paren.jsx":2
    .expect "react/no-did-mount-set-state" at "sm-extra.jsx":2
    .expect "react/no-did-mount-set-state" at "sm-extra.jsx":3
    .expect "react/no-did-mount-set-state" at "sm-extra.jsx":6
.end
