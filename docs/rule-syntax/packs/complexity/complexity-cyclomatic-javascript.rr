.policy "complexity-cyclomatic-javascript" revision 3
.description "Keep JavaScript functions at cyclomatic complexity 6 or below, counting each if, loop, catch, switch, ternary and && or ||; branch-heavy functions are hard to follow and test."
.language javascript
.mode steer
.scope include "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
.scope exclude "**/node_modules/**", "**/dist/**", "**/build/**", "**/out/**", "**/.next/**", "**/coverage/**"
.scope exclude "**/generated/**", "**/__generated__/**", "**/*.generated.js", "**/*.generated.jsx", "**/*.gen.js"
.scope exclude "**/*.min.js", "**/*.test.*", "**/*.spec.*", "**/__tests__/**"

#include "complexity/ecma.rr"
//   cc_report(f, msg)   function f has cyclomatic complexity over 6 (lizard's decision points; nested ones apart)

// The complexity pack's ceiling, with lizard 1.24.0's count: 1 + each if, for, for…in/of, while, do, catch,
// &&, ||, &&=, ||=, ?: and switch with a case (once). Each function is scored on its own, nested ones apart;
// one with no name takes its variable's, field's or key's. Reported over the whole function:
//   const grade = (s) => { if (a) … else if (b && c) … for (…) … while (…) … try {…} catch {…} }
//   -> `grade` has cyclomatic complexity 7, over the ceiling of 6.
// lizard reads `??` as two `?` and counts 2; it counts 0 here, as the pack's README says (Deviations).
.violation complexity(at: node, msg: symbol) code "CYCLOMATIC_COMPLEXITY" "{msg}"
complexity(f, msg) :- cc_report(f, msg).
