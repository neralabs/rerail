.policy "eslint-plugin-vue-no-setup-props-reactivity-loss" revision 2
.guests off
.description "Don't destructure Vue props or copy their values at the top level of setup() or script setup; the copies lose reactivity."
.language vue
.mode steer
.scope include "**/*.vue"
#include "vue/vue-02.rerail"
//   vv_site(r, d), vv_marker(m, k), vv_marked(o)

// eslint-plugin-vue's no-setup-props-reactivity-loss over the component's view (vue/view). No options. The props are
// setup()'s first parameter (context "setup"), or what `defineProps()` (or `withDefaults(defineProps(), …)`) is
// assigned to at the top of <script setup> (context "script"). Destructuring them there is reported at the pattern:
//   setup({ count }) {}         const [a] = defineProps(…)         const { a: { b } } = defineProps(…)
// Reading a value out of them is reported where the read is in the context's own scope, as eslint-scope draws it (no
// nested function, class, block, `catch`, switch body, or `for` that declares with let or const, between): a call
// holding the read, an array or object literal assigned, the base of an assigned member chain, a template literal or
// a conditional assigned, or a pattern assigned from them:
//   const x = props.x        foo(props.x)        const o = { x: props.x }        const { x } = props
//   const c = computed(() => props.x)            not reported: read in a nested function
// A name destructured from defineProps (`const { x } = defineProps()`) counts as a read wherever it is read so.
.violation destructured(at: node) code "vue/no-setup-props-reactivity-loss"
    "Keep `props` whole and read its fields where used, or destructure with toRefs, so the values stay reactive."
    suppress eslint "vue/no-setup-props-reactivity-loss"
destructured(n) :- docof(n, g), (guest(g, _, _, "javascript") ; guest(g, _, _, "typescript") ; guest(g, _, _, "tsx")),
    pattern(n), (param_slot(n) ; nested_pattern(n)).
destructured(n) :- docof(n, g), (guest(g, _, _, "javascript") ; guest(g, _, _, "typescript") ; guest(g, _, _, "tsx")),
    kind(n, "array_pattern"), field(d, "name", n), setup_decl(d).
.violation lost(at: node, where: symbol) code "vue/no-setup-props-reactivity-loss"
    "Read this from `props` inside a computed, watcher or function{where}, or use toRefs, so it stays reactive."
    suppress eslint "vue/no-setup-props-reactivity-loss"
lost(n, w) :- docof(n, g), (guest(g, _, _, "javascript") ; guest(g, _, _, "typescript") ; guest(g, _, _, "tsx")),
    read_at(n, c), where(c, w).
.decl where(c: symbol, w: symbol)
where("setup", " in setup()"). where("script", "").

// read_at(n, c): the get-property cases, in context c.
.decl read_at(n: node, c: symbol)
read_at(n, c) :- kind(n, "call_expression"), !tagged(n), own_code(n, c), within(r, n), member_ref(r, c).
read_at(n, c) :- (kind(n, "array") ; kind(n, "object")), rhs_slot(n), own_code(n, c), within(r, n), member_ref(r, c).
read_at(n, c) :- kind(n, "identifier"), member_ref(n, c), chain_up(n),
    count : { chain_up_pattern(n), props_id(n, c) } = 0.
read_at(n, c) :- !kind(n, "parenthesized_expression"), holds_ref(n, c), child(s, n, _),
    kind(s, "template_substitution"), child(t, s, _), kind(t, "template_string"), chain_up(t),
    count : { chain_up_pattern(t), child(t, s2, _), kind(s2, "template_substitution"), child(s2, i, _), props_id(i, c) } = 0,
    count : { precedes(e, s), kind(e, "template_substitution"), child(e, x, _), holds_ref(x, c) } = 0.
read_at(n, c) :- !kind(n, "parenthesized_expression"), holds_ref(n, c), ternary_slot(n, c).
read_at(n, c) :- pattern(n), (field(d, "name", n), kind(d, "variable_declarator"), field(d, "value", v) ;
    field(d, "left", n), kind(d, "assignment_expression"), field(d, "right", v)), chain_has_props(v, c).
.decl tagged(n: node)  // a tagged template, foo`…`
tagged(n) :- field(n, "arguments", a), kind(a, "template_string").
.decl pattern(n: node)
pattern(n) :- kind(n, "object_pattern") ; kind(n, "array_pattern").

// ---- where the props come from -------------------------------------------------------------------------------------
// props_id(n, c): identifier n reads the props object of context c, from that context's own code.
.decl props_id(n: node, c: symbol)
props_id(n, "setup") :- kind(n, "identifier"), nearest(n, f, barrier), setup_fn(f), vv_site(n, d), occurrence(d, o),
    kind(o, "identifier"), param_slot(o).
props_id(n, "script") :- kind(n, "identifier"), !in_barrier(n), vv_site(n, d), occurrence(d, o), kind(o, "identifier"),
    (field(sd, "name", o), setup_decl(sd) ; child(r, o, _), kind(r, "rest_pattern"), child(l, r, _), setup_pattern(l)).
// member_ref(n, c): n reads a prop: the props object as a member access's object, or (script) a destructured prop.
.decl member_ref(n: node, c: symbol)
member_ref(n, c) :- props_id(n, c), field(m, "object", n), (kind(m, "member_expression") ; kind(m, "subscript_expression")).
member_ref(n, "script") :- (kind(n, "identifier") ; kind(n, "shorthand_property_identifier")), !write_position(n),
    !in_barrier(n), vv_site(n, d), occurrence(d, o), destructured_prop(o).
.decl destructured_prop(o: node)  // `{ a }`, `{ a = 1 }`, `{ x: a }`, `{ x: a = 1 }` of `… = defineProps()`
destructured_prop(o) :- kind(o, "shorthand_property_identifier_pattern"), child(l, o, _), setup_pattern(l).
destructured_prop(o) :- kind(o, "shorthand_property_identifier_pattern"), field(p, "left", o),
    kind(p, "object_assignment_pattern"), child(l, p, _), setup_pattern(l).
destructured_prop(o) :- kind(o, "identifier"), field(p, "value", o), kind(p, "pair_pattern"), child(l, p, _),
    setup_pattern(l).
destructured_prop(o) :- kind(o, "identifier"), field(a, "left", o), kind(a, "assignment_pattern"), field(p, "value", a),
    kind(p, "pair_pattern"), child(l, p, _), setup_pattern(l).
.decl holds_ref(n: node, c: symbol)  // n is, or holds, a member_ref
holds_ref(n, c) :- member_ref(n, c).
holds_ref(n, c) :- member_ref(r, c), within(r, n).
// occurrence(d, o): the variable declared at d is named at o: its declaration's name, or a reference.
.decl occurrence(d: node, o: node)
occurrence(d, o) :- vv_site(_, d), (o = d, (kind(d, "identifier") ; kind(d, "shorthand_property_identifier_pattern")) ;
    field(d, "name", o) ; vv_site(o, d)).
.decl write_position(n: node)
write_position(n) :- field(a, "left", n), kind(a, "assignment_expression").
write_position(n) :- field(p, "value", n), kind(p, "pair_pattern").
write_position(n) :- field(l, "left", n), kind(l, "for_in_statement").
write_position(n) :- child(p, n, _), kind(p, "array_pattern").

// The props pattern: setup()'s first parameter, and <script setup>'s `const … = defineProps()`.
.decl param_slot(n: node)  // `setup(props)`, `setup(props = {})`, `setup(props: P)`, `setup: props => …`
param_slot(n) :- first_param(n).
param_slot(n) :- field(a, "left", n), kind(a, "assignment_pattern"), first_param(a).
param_slot(n) :- field(p, "pattern", n), (kind(p, "required_parameter") ; kind(p, "optional_parameter")), first_param(p).
param_slot(n) :- field(f, "parameter", n), kind(f, "arrow_function"), setup_fn(f).
.decl first_param(n: node)
first_param(n) :- child(fp, n, _), kind(fp, "formal_parameters"), child(f, fp, _), setup_fn(f), !kind(n, "comment"),
    count : { child(fp, b, _), !kind(b, "comment"), precedes(b, n) } = 0.
.decl nested_pattern(n: node)  // `const { a: { b } } = defineProps()`, `{ a: [b] = [] }`
nested_pattern(n) :- field(p, "value", n), kind(p, "pair_pattern"), child(l, p, _), setup_pattern(l).
nested_pattern(n) :- field(a, "left", n), kind(a, "assignment_pattern"), field(p, "value", a), kind(p, "pair_pattern"),
    child(l, p, _), setup_pattern(l).
.decl setup_pattern(l: node)
setup_pattern(l) :- kind(l, "object_pattern"), field(d, "name", l), setup_decl(d).
// setup_decl(d): `const props = defineProps(…)` (or withDefaults(defineProps(…), …)) at <script setup>'s top level.
.decl setup_decl(d: node)
setup_decl(d) :- kind(d, "variable_declarator"), field(d, "value", v), macro_call(v), child(s, d, _),
    (kind(s, "lexical_declaration") ; kind(s, "variable_declaration")), child(p, s, _), kind(p, "program"),
    precedes_stop(m, s, any_marker), vv_marker(m, "setup").
.decl any_marker(m: node)
any_marker(m) :- vv_marker(m, _).
.decl macro_call(v: node)
macro_call(v) :- props_call(v).
macro_call(v) :- kind(v, "call_expression"), field(v, "function", f), kind(f, "identifier"), text(f, "withDefaults"),
    field(v, "arguments", as), child(as, a, _), props_call(a), !kind(a, "comment"),
    count : { child(as, b, _), !kind(b, "comment"), precedes(b, a) } = 0.
macro_call(v) :- kind(v, "parenthesized_expression"), child(v, c, _), macro_call(c).
.decl props_call(v: node)
props_call(v) :- kind(v, "call_expression"), field(v, "function", f), kind(f, "identifier"), text(f, "defineProps").
props_call(v) :- kind(v, "parenthesized_expression"), child(v, c, _), props_call(c).

// ---- the context's own code ----------------------------------------------------------------------------------------
// own_code(n, c): no barrier lies between n and its context: setup() itself, or <script setup>'s program.
.decl own_code(n: node, c: symbol)
own_code(n, "setup") :- nearest(n, f, barrier), setup_fn(f).
own_code(n, "script") :- node(_, n, _, _, _), !in_barrier(n).
.decl in_barrier(n: node)
in_barrier(n) :- nearest(n, _, barrier).
// barrier(b): what opens a scope of its own (eslint-scope): a function, a class, a `catch`, a switch's body (not its
// discriminant), a `for` whose head declares with let or const (not `for (i = 0; …)` nor `for (var x of …)`), or a
// block that is no function's body.
.decl barrier(b: node)
barrier(b) :- kind(b, "function_expression") ; kind(b, "arrow_function") ; kind(b, "function_declaration") ;
    kind(b, "generator_function") ; kind(b, "generator_function_declaration") ; kind(b, "method_definition") ;
    kind(b, "class_declaration") ; kind(b, "class") ; kind(b, "class_static_block") ; kind(b, "switch_body") ;
    kind(b, "catch_clause").
barrier(b) :- kind(b, "for_statement"), field(b, "initializer", i), kind(i, "lexical_declaration").
barrier(b) :- kind(b, "for_in_statement"), (op(b, "let") ; op(b, "const")).
barrier(b) :- kind(b, "statement_block"), !fn_body(b).
.decl fn_body(b: node)
fn_body(b) :- field(f, "body", b), (kind(f, "function_expression") ; kind(f, "arrow_function") ;
    kind(f, "function_declaration") ; kind(f, "generator_function") ; kind(f, "generator_function_declaration") ;
    kind(f, "method_definition")).

// ---- what is assigned ----------------------------------------------------------------------------------------------
// rhs(n): n is assigned (a declarator's value, an assignment's right); rhs_pattern(n): to a pattern.
.decl rhs(n: node)
rhs(n) :- field(d, "value", n), kind(d, "variable_declarator").
rhs(n) :- field(a, "right", n), (kind(a, "assignment_expression") ; kind(a, "augmented_assignment_expression")).
.decl rhs_pattern(n: node)
rhs_pattern(n) :- field(d, "value", n), kind(d, "variable_declarator"), field(d, "name", l), pattern(l).
rhs_pattern(n) :- field(a, "right", n), kind(a, "assignment_expression"), field(a, "left", l), pattern(l).
// chain_up(n): n heads, through member accesses and parentheses, what is assigned; chain_up_pattern: to a pattern.
.decl chain_up(n: node)
chain_up(n) :- rhs(n).
chain_up(n) :- field(m, "object", n), (kind(m, "member_expression") ; kind(m, "subscript_expression")), chain_up(m).
chain_up(n) :- child(p, n, _), kind(p, "parenthesized_expression"), chain_up(p).
.decl chain_up_pattern(n: node)
chain_up_pattern(n) :- rhs_pattern(n).
chain_up_pattern(n) :- field(m, "object", n), (kind(m, "member_expression") ; kind(m, "subscript_expression")),
    chain_up_pattern(m).
chain_up_pattern(n) :- child(p, n, _), kind(p, "parenthesized_expression"), chain_up_pattern(p).
.decl rhs_slot(n: node)  // n is assigned, through parentheses
rhs_slot(n) :- rhs(n).
rhs_slot(n) :- child(p, n, _), kind(p, "parenthesized_expression"), rhs_slot(p).
// chain_has_props(v, c): v is the props object of c, or a member chain, template or conditional over it.
.decl chain_has_props(v: node, c: symbol)
chain_has_props(v, c) :- props_id(v, c).
chain_has_props(v, c) :- (kind(v, "member_expression") ; kind(v, "subscript_expression")), field(v, "object", o),
    chain_has_props(o, c).
chain_has_props(v, c) :- kind(v, "parenthesized_expression"), child(v, o, _), chain_has_props(o, c).
chain_has_props(v, c) :- kind(v, "template_string"), child(v, s, _), kind(s, "template_substitution"), child(s, i, _),
    props_id(i, c).
chain_has_props(v, c) :- kind(v, "ternary_expression"), child(v, i, _), props_id(i, c).
// ternary_slot(n, c): n is a branch of an assigned conditional, and no earlier branch holds a read.
.decl ternary_slot(n: node, c: symbol)
ternary_slot(n, c) :- field(t, "condition", n), assigned_ternary(t, c).
ternary_slot(n, c) :- field(t, "consequence", n), assigned_ternary(t, c), !branch_reads(t, "condition", c).
ternary_slot(n, c) :- field(t, "alternative", n), assigned_ternary(t, c), !branch_reads(t, "condition", c),
    !branch_reads(t, "consequence", c).
ternary_slot(n, c) :- child(p, n, _), kind(p, "parenthesized_expression"), ternary_slot(p, c).
.decl assigned_ternary(t: node, c: symbol)
assigned_ternary(t, c) :- kind(t, "ternary_expression"), chain_up(t), context(c),
    count : { chain_up_pattern(t), child(t, i, _), kind(i, "identifier"), props_id(i, c) } = 0.
.decl branch_reads(t: node, b: symbol, c: symbol)
branch_reads(t, b, c) :- (b = "condition" ; b = "consequence"), field(t, b, x), holds_ref(x, c).
.decl context(c: symbol)
context("setup"). context("script").

// ---- the component's definition ----------------------------------------------------------------------------------
// setup_fn(f): `setup() {}`, `setup: function () {}`, `setup: () => …` of the component's definition object.
.decl setup_fn(f: node)
setup_fn(f) :- kind(f, "method_definition"), field(f, "name", k), setup_key(k), child(o, f, _), vue_object(o).
setup_fn(f) :- (kind(f, "function_expression") ; kind(f, "arrow_function") ; kind(f, "generator_function")),
    field(p, "value", f), kind(p, "pair"), field(p, "key", k), setup_key(k), child(o, p, _), vue_object(o).
.decl setup_key(k: node)  // setup, "setup", ["setup"], [`setup`]
setup_key(k) :- kind(k, "property_identifier"), text(k, "setup").
setup_key(k) :- kind(k, "string"), child(k, s, _), kind(s, "string_fragment"), text(s, "setup").
setup_key(k) :- kind(k, "computed_property_name"), child(k, s, _), setup_key_literal(s).
.decl setup_key_literal(s: node)
setup_key_literal(s) :- kind(s, "string"), child(s, f, _), kind(f, "string_fragment"), text(f, "setup").
setup_key_literal(s) :- kind(s, "template_string"), text(s, "`setup`").
// vue_object(o): `export default { … }` (not `{ … } as T` nor `satisfies T`: the plugin's isVueComponentFile wants
// the object itself), the last argument of defineComponent(…) and the like, the first of `new Vue(…)`, or an object
// under a `// @vue/component` line.
.decl vue_object(o: node)
vue_object(o) :- kind(o, "object"), field(e, "value", o), kind(e, "export_statement").
vue_object(o) :- vv_marked(o).
vue_object(o) :- kind(o, "object"), child(as, o, _), kind(as, "arguments"), child(c, as, _), definition_call(c),
    count : { child(as, b, _), !kind(b, "comment"), precedes(o, b) } = 0.
vue_object(o) :- kind(o, "object"), child(as, o, _), kind(as, "arguments"), child(c, as, _), kind(c, "new_expression"),
    field(c, "constructor", v), kind(v, "identifier"), text(v, "Vue"),
    count : { child(as, b, _), !kind(b, "comment"), precedes(b, o) } = 0.
.decl definition_call(c: node)
definition_call(c) :- kind(c, "call_expression"), field(c, "function", f), definer(f).
.decl definer(f: node)
definer(f) :- kind(f, "member_expression"), field(f, "object", o), kind(o, "identifier"), field(f, "property", p),
    (text(o, "Vue"), match("component|mixin|extend", p) ; match("component|mixin", p)).
definer(f) :- kind(f, "identifier"), text(f, "defineNuxtComponent").
definer(f) :- kind(f, "identifier"), match("component|createApp|defineComponent", f),
    count : { vv_site(f, s), (d = s ; within(s, d)), own_binding(d) } = 0.
.decl own_binding(d: node)  // a function, a class, or an import from elsewhere than Vue (Nuxt's #imports is Vue's)
own_binding(d) :- kind(d, "function_declaration") ; kind(d, "class_declaration").
own_binding(d) :- kind(d, "import_specifier"),
    count : { inside(d, i, "import_statement"), field(i, "source", m),
              match("['\"](vue|@vue/composition-api|@nuxtjs/composition-api|#imports)['\"]", m) } = 0.

// Tests (decision 0130): run by `rerail-engine test-rr`, left out of the rule otherwise. The review's counterexamples
// (review/vue-02.review.md) and the cases its fixes raised, each expecting exactly the lines ESLint 9.39.5 with
// eslint-plugin-vue 10.11.1 reports.
// eslint-scope opens the switch's scope after its discriminant: a call there holding props.size is reported; a bare
// props.kind is not.
.test a_switch_discriminant_is_setups_own_code exactly
    .fixture "p01-switch.vue" ```
        <script>
        export default {
          setup(props) {
            switch (String(props.size)) {
              case 'a': break
            }
            switch (props.kind) {
              default: break
            }
          }
        }
        </script>
        ```
    .expect "vue/no-setup-props-reactivity-loss" at "p01-switch.vue":4
.end

// The same at <script setup>'s top level.
.test a_switch_discriminant_in_script_setup exactly
    .fixture "p02-switch-script.vue" ```
        <script setup>
        const props = defineProps({ size: String })
        switch (normalize(props.size)) {
          default: break
        }
        </script>
        ```
    .expect "vue/no-setup-props-reactivity-loss" at "p02-switch-script.vue":3
.end

// `for (i = 0; …)` and `for (var x of …)` open no scope, so their head and braceless body are setup()'s;
// `for (const y of …)` does.
.test a_for_without_let_or_const_opens_no_scope exactly
    .fixture "p03-for-novar.vue" ```
        <script>
        export default {
          setup(props) {
            let i
            for (i = 0; i < 3; i++) track(props.a)
            for (var x of toList(props.list)) {}
            for (const y of toList(props.list)) {}
          }
        }
        </script>
        ```
    .expect "vue/no-setup-props-reactivity-loss" at "p03-for-novar.vue":5
    .expect "vue/no-setup-props-reactivity-loss" at "p03-for-novar.vue":6
.end

// A `let` head opens a scope; a `var` for-in's head and body do not; a switch's cases are in its scope.
.test for_heads_and_switch_cases exactly
    .fixture "x02-for-let.vue" ```
        <script>
        export default {
          setup(props) {
            for (let i = 0; i < 3; i++) track(props.a)
            for (var k in toObj(props.o)) track(props.b)
            switch (f(props.c)) {
              case 1: g(props.d)
            }
          }
        }
        </script>
        ```
    .expect "vue/no-setup-props-reactivity-loss" at "x02-for-let.vue":5
    .expect "vue/no-setup-props-reactivity-loss" at "x02-for-let.vue":6
.end

// isVueComponentFile wants the exported object itself: `{ … } as any` is no component, so its setup() is not checked.
.test export_default_as_is_no_component exactly
    .fixture "p04-export-as.vue" ```
        <script lang="ts">
        export default {
          setup(props: any) {
            const a = props.a
          }
        } as any
        </script>
        ```
.end

// Nor is `{ … } satisfies Component`.
.test export_default_satisfies_is_no_component exactly
    .fixture "p05-export-satisfies.vue" ```
        <script lang="ts">
        import type { Component } from 'vue'
        export default {
          setup(props: any) {
            const a = props.a
          }
        } satisfies Component
        </script>
        ```
.end

// getVueObjectType's "mark": the object on the line after `// @vue/component`. Only the read in setup() is
// reported, not the object assigned at the top level.
.test an_object_under_vue_component_is_a_component exactly
    .fixture "p06-vue-component-comment.vue" ```
        <script>
        // @vue/component
        const Comp = {
          setup(props) {
            const a = props.a
          }
        }
        export default Comp
        </script>
        ```
    .expect "vue/no-setup-props-reactivity-loss" at "p06-vue-component-comment.vue":5
.end

// defineComponent imported from #imports is Vue's (createCompositionApiTraceMap).
.test define_component_from_nuxt_imports exactly
    .fixture "p07-imports.vue" ```
        <script>
        import { defineComponent } from '#imports'
        export default defineComponent({
          setup(props) {
            const a = props.a
          }
        })
        </script>
        ```
    .expect "vue/no-setup-props-reactivity-loss" at "p07-imports.vue":5
.end
