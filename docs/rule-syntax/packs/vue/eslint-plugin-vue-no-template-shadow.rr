.policy "eslint-plugin-vue-no-template-shadow" revision 2
.description "Avoid naming a v-for alias or slot parameter after an outer template variable, prop, data, computed, method or setup binding; it shadows that name."
.language vue
.mode steer
.scope include "**/*.vue"
#include "vue/component.rr"
//   tvar(e, x, id, k), vname(o, g, x, n), vprop_name(c, x, n), vscript(p, setup), vsetup_doc(d), decl_site(…)

// eslint-plugin-vue's no-template-shadow: a template variable (v-for alias, slot parameter) whose name is already
// taken by
//   an outer element's template variable, or an earlier one of the same element;
//   a name the component declares: props, computed, data, asyncData, methods, setup (vue/component's vname), or a
//   <script setup> prop (defineProps);
//   in a file with <script setup>, a top-level declaration of its scripts (imports included).
// Option allow: names that may shadow.
//   <li v-for="item in items"><p v-for="item in item.parts" /></li>    the inner item is reported
//   data() { return { item: 1 } } … <li v-for="item in items" />       reported
.violation shadow(at: node, x: symbol) code "vue/no-template-shadow" "Variable '{x}' is already declared in the upper scope."
    suppress eslint "vue/no-template-shadow"
shadow(id, x) :- tvar(e, x, id, _), !option_item("allow", _, x), taken(e, id, x).
.decl taken(e: node, id: node, x: symbol)
taken(e, id, x) :- tvar(e, x, id, _), within(e, p), tvar(p, x, _, _).
taken(e, id, x) :- tvar(e, x, id, _), tvar(e, x, j, _), earlier(j, id).
taken(e, id, x) :- tvar(e, x, id, _), docof(id, d), script_name(d, x).
// script_name(d, x): what document d's script declares for the template.
.decl script_name(d: number, x: symbol)
script_name(d, x) :- vname(o, g, x, _), group(g), docof(o, d).
script_name(d, x) :- vprop_name(c, x, _), docof(c, d).
script_name(d, x) :- vsetup_doc(d), vscript(p, _), docof(p, d), decl_site(p, x, _, _, _).
.decl group(g: symbol)
group("props"). group("computed"). group("data"). group("asyncData"). group("methods"). group("setup").
