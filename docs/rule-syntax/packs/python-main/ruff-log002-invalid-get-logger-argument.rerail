.policy "ruff-log002-invalid-get-logger-argument" revision 1
.description "Pass __name__ to logging.getLogger() instead of __file__ or __cached__; logger names should be dotted module names, not file paths."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/names.rerail"

// LOG002(n): a finding at node n, from clause `invalid-get-logger-argument`.
// Each rule below is one way the JSON `rule` can match.
.violation LOG002(at: node) "Pass `__name__` to `logging.getLogger()` instead of `__file__` or `__cached__`; logger names should be dotted module names, not paths. Keep it only if existing config targets the path-named logger."
    suppress noqa "LOG002"
LOG002(n) :- kind(n, "identifier"), glob("{__file__,__cached__}", n),
    (global_ref(n, "__file__") ; global_ref(n, "__cached__")),
    count : { field(p1, "name", n), kind(p1, "keyword_argument") } = 0,
    ( within_stop(n, p2, log002_stop_2), kind(p2, "keyword_argument"), log002_tok_has_3(p2), child(p3, p2, _), log002_get_logger_args(p3)
    ; log002_first_positional(n)
    ).


// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
.decl log002_callee(n: node)
log002_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "logging.getLogger").
log002_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), log002_callee(c1).

// get_logger_args(n): the JSON util `get-logger-args`, used where the JSON says `matches: "get-logger-args"`
.decl log002_get_logger_args(n: node)
log002_get_logger_args(n) :- kind(n, "argument_list"), child(p1, n, _), kind(p1, "call"),
    field(p1, "function", c2), log002_callee(c2).

// first_positional(n): the JSON util `first-positional`, used where the JSON says `matches: "first-positional"`
.decl log002_first_positional(n: node)
log002_first_positional(n) :- child(p1, n, _), log002_counted_1(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), log002_counted_1(s2) }, k3 = 0,
    !kind(n, "keyword_argument"), !kind(n, "dictionary_splat"), !kind(n, "comment"),
    !kind(n, "line_continuation"), child(p4, n, _), log002_get_logger_args(p4),
    count : { child(p4, c5, _), kind(c5, "keyword_argument"), log002_tok_has_1(c5) } = 0.
log002_first_positional(n) :- child(p14, n, _), kind(p14, "parenthesized_expression"),
    log002_first_positional(p14).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^name$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl log002_tok_has_1(n: node)
.stored log002_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
log002_tok_has_1(n) :- field(n, "name", c6), glob("name", c6).
log002_tok_has_1(n) :- op(n, t7), match("name", t7).
log002_tok_has_1(n) :- child(n, c13, _), structural_before(c13, g8),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g8).
log002_tok_has_1(n) :- child(n, c13, _), structural_after(c13, g8),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g8).
log002_tok_has_1(n) :- node_text(n, g8), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g8).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^name$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl log002_tok_has_2(n: node)
.stored log002_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
log002_tok_has_2(n) :- field(n, "name", c3), glob("name", c3).
log002_tok_has_2(n) :- op(n, t4), match("name", t4).
log002_tok_has_2(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g5).
log002_tok_has_2(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g5).
log002_tok_has_2(n) :- node_text(n, g5), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g5).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^name$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl log002_tok_has_3(n: node)
.stored log002_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
log002_tok_has_3(n) :- field(n, "name", c2), glob("name", c2).
log002_tok_has_3(n) :- op(n, t3), match("name", t3).
log002_tok_has_3(n) :- child(n, c9, _), structural_before(c9, g4),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g4).
log002_tok_has_3(n) :- child(n, c9, _), structural_after(c9, g4),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g4).
log002_tok_has_3(n) :- node_text(n, g4), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:name)(?:\\W.*)?)$", g4).

// counted_1(n): the siblings the JSON `nthChild.ofRule` counts
.decl log002_counted_1(n: node)
log002_counted_1(n) :- node(_, n, _, _, _), !kind(n, "keyword_argument"),
    !kind(n, "dictionary_splat"), !kind(n, "comment"), !kind(n, "line_continuation").

// stop_2(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl log002_stop_2(n: node)
log002_stop_2(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").
