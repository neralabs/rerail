pt028_tok_has_6(n) :- child(n, c17, _), structural_after(c17, g12),
    match("(?s)^(?:(?:.*\\W)?(?:__init__).*)$", g12).
pt028_tok_has_6(n) :- node_text(n, g12), !child(n, _, _),
