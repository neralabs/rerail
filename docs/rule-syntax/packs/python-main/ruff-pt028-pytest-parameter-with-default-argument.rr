.stored pt028_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt028_tok_has_4(n) :- field(n, "name", c30), glob("__init__", c30).
pt028_tok_has_4(n) :- op(n, t31), match("__init__", t31).
pt028_tok_has_4(n) :- child(n, c37, _), structural_before(c37, g32),
