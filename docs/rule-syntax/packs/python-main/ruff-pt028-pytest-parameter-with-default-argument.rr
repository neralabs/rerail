pt028_tok_has_6(n) :- field(n, "name", c10), glob("__init__", c10).
pt028_tok_has_6(n) :- op(n, t11), match("__init__", t11).
pt028_tok_has_6(n) :- child(n, c17, _), structural_before(c17, g12),
