.stored pt028_tok_has_9 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt028_tok_has_9(n) :- field(n, "name", c22), glob("__init__", c22).
pt028_tok_has_9(n) :- op(n, t23), match("__init__", t23).
pt028_tok_has_9(n) :- child(n, c29, _), structural_before(c29, g24),
