.decl pt028_tok_has_7(n: node)
.stored pt028_tok_has_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt028_tok_has_7(n) :- field(n, "name", c3), prefix("Test", c3).
pt028_tok_has_7(n) :- op(n, t4), match("Test.*", t4).
pt028_tok_has_7(n) :- child(n, c10, _), structural_before(c10, g5),
