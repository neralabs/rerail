.policy "ruff-perf402-manual-list-copy" revision 1
.guests off
.description "Use list or extend to copy an iterable into a list instead of appending items one by one in a for loop."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PERF402(n): a finding at node n, from clause `manual-list-copy`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on L are added to every rule.
.violation PERF402(at: node, l: loc) "Copy the iterable in one step: `{l}.extend(<iterable>)`, or `{l} = list(<iterable>)` if `{l}` is a fresh empty list; keep the loop if code after it reads the loop variable."
    suppress noqa "PERF402"
PERF402(n, L) :- perf402_call(n, A, L), child(p1, n, _), kind(p1, "expression_statement"),
    perf402_only_stmt(p1), child(p2, p1, _), kind(p2, "block"), child(p3, p2, _), perf402_loop(p3, A),
    perf402_list_bound(L).

// list_expr(n): the JSON util `list-expr`, used where the JSON says `matches: "list-expr"`
.decl perf402_list_expr(n: node)
perf402_list_expr(n) :- perf402_list_expr_u7(n).

// list_callee(n): the JSON util `list-callee`, used where the JSON says `matches: "list-callee"`
.decl perf402_list_callee(n: node)
perf402_list_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "list"), sym_of(n, "builtins.list").
perf402_list_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    perf402_list_callee(c1).

// list_init(n): the JSON util `list-init`, used where the JSON says `matches: "list-init"`
.decl perf402_list_init(n: node)
perf402_list_init(n) :- perf402_list_expr(n).
perf402_list_init(n) :- kind(n, "call"), child(n, c1, _), perf402_list_callee(c1),
    next_sibling(c1, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")).

// list_ann(n): the JSON util `list-ann`, used where the JSON says `matches: "list-ann"`
.decl perf402_list_ann(n: node)
perf402_list_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "list"),
    sym_of(n, "builtins.list").
perf402_list_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.List")
    ; sym_of(n, "_typeshed.List")
    ; sym_of(n, "typing_extensions.List")
    ).

perf402_list_ann(n) :- (kind(n, "subscript") ; kind(n, "generic_type")), child(n, c1, _),
    !perf402_tok_follows_5(c1), perf402_list_ann(c1).
perf402_list_ann(n) :- kind(n, "parenthesized_expression"), child(n, c9, _), perf402_list_ann(c9).

// list_bound(n): the JSON util `list-bound`, used where the JSON says `matches: "list-bound"`
.decl perf402_list_bound(n: node)
perf402_list_bound(n) :- kind(n, "identifier"),
    ( ref_site(n, b1), site_only(b1), binding_value(b1, x1), perf402_list_init(x1), count : { child(b1, c1, _), kind(c1, "type") } = 0
    ; ref_site(n, b2), site_only(b2), site_annotation(b2, o1), perf402_list_ann(o1), count : { child(b2, c2, _), (kind(c2, "list_splat_pattern") ; kind(c2, "dictionary_splat_pattern")) } = 0
    ; ref_site(n, b3), site_only(b3), perf402_alt_3(b3)
    ).


// plain_name(n): the JSON util `plain-name`, used where the JSON says `matches: "plain-name"`
//   L: metavariable this relation binds for the calling rule
.decl perf402_plain_name(n: node, l: loc)
perf402_plain_name(n, L) :- kind(n, "identifier"), node(_, n, _, _, _), L = n.
perf402_plain_name(n, L) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    perf402_plain_name(c1, L).

// call(n): the JSON util `call`, used where the JSON says `matches: "call"`
//   A, L: metavariables this relation binds for the calling rule
.decl perf402_call(n: node, a: loc, l: loc)
perf402_call(n, A, L) :- kind(n, "call"), field(n, "function", c1), kind(c1, "attribute"),
    field(c1, "object", c2), perf402_plain_name(c2, L), field(c1, "attribute", c3),
    kind(c3, "identifier"), glob("{append,insert}", c3), field(n, "arguments", c4),
    perf402_alt_8(c4, A).

// only_stmt(n): the JSON util `only-stmt`, used where the JSON says `matches: "only-stmt"`
.decl perf402_only_stmt(n: node)
perf402_only_stmt(n) :- node(_, n, _, _, _), !perf402_alt_13(n).

// loop_target(n): the JSON util `loop-target`, used where the JSON says `matches: "loop-target"`
//   T: metavariable this relation binds for the calling rule
.decl perf402_loop_target(n: node, t: loc)
perf402_loop_target(n, T) :- kind(n, "identifier"), node(_, n, _, _, _), T = n.
perf402_loop_target(n, T) :- kind(n, "tuple_pattern"), !perf402_tok_has_8(n), child(n, c9, _),
    perf402_loop_target(c9, T).

