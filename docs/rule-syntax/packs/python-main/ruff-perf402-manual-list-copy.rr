.decl perf402_tok_precedes_6(n: node)
.stored perf402_tok_precedes_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf402_tok_precedes_6(n) :- next_sibling(n, s9), glob("as", s9).
perf402_tok_precedes_6(n) :- structural_after(n, g11), match("\\s*", g11), child(p12, n, _),
    node(_, n, _, _, en15), o13 = en15 + strlen(g11), token(p12, _, t10, o13, _),
    match("as", t10).
perf402_tok_precedes_6(n) :- structural_after(n, g11),
    match("(?s)^(?:\\s*(?:as)(?:\\W.*)?)$", g11).

// tok_precedes_7(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf402_tok_precedes_7(n: node)
.stored perf402_tok_precedes_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf402_tok_precedes_7(n) :- next_sibling(n, s2), glob("as", s2).
perf402_tok_precedes_7(n) :- structural_after(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, _, en8), o6 = en8 + strlen(g4), token(p5, _, t3, o6, _),
    match("as", t3).
perf402_tok_precedes_7(n) :- structural_after(n, g4),
    match("(?s)^(?:\\s*(?:as)(?:\\W.*)?)$", g4).

// tok_has_8(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf402_tok_has_8(n: node)
.stored perf402_tok_has_8 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf402_tok_has_8(n) :- child(n, c1, _), glob("\\,", c1).
perf402_tok_has_8(n) :- op(n, t2), match(",", t2).
perf402_tok_has_8(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
perf402_tok_has_8(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
perf402_tok_has_8(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// tok_has_9(n): a child of n, a named node or an anonymous token, matches "^async$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf402_tok_has_9(n: node)
.stored perf402_tok_has_9 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf402_tok_has_9(n) :- child(n, c1, _), glob("async", c1).
perf402_tok_has_9(n) :- op(n, t2), match("async", t2).
perf402_tok_has_9(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g3).
perf402_tok_has_9(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g3).
perf402_tok_has_9(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g3).

// demand_loop: the rows of loop its callers ask for (the metavariable columns they pass in)
.decl perf402_demand_loop(n: node, a: loc)
perf402_demand_loop(p3, A) :- perf402_call(n, A, L), child(p1, n, _), kind(p1, "expression_statement"),
    perf402_only_stmt(p1), child(p2, p1, _), kind(p2, "block"), child(p3, p2, _),
    perf402_list_bound(L).

// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl perf402_alt_1_u0_empty(n: node)

// alt_2_u0_empty: level -1 of an unrolled recursion, empty
.decl perf402_alt_2_u0_empty(n: node)

// list_expr_u0_empty: level -1 of an unrolled recursion, empty
.decl perf402_list_expr_u0_empty(n: node)

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl perf402_alt_1(n: node)
perf402_alt_1(n) :- perf402_alt_1_u7(n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl perf402_alt_2(n: node)
perf402_alt_2(n) :- perf402_alt_2_u7(n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl perf402_alt_3(n: node)
perf402_alt_3(n) :- kind(n, "as_pattern"), child(n, c1, _), perf402_tok_precedes_7(c1), perf402_list_init(c1).
perf402_alt_3(n) :- kind(n, "function_definition"), field(n, "return_type", c9),
    kind(c9, "type"), child(c9, c10, _), perf402_list_ann(c10).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl perf402_alt_6(n: node)
perf402_alt_6(n) :- kind(n, "comment").
perf402_alt_6(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl perf402_alt_10(n: node)
perf402_alt_10(n) :- (kind(n, "comment") ; kind(n, "keyword_argument") ; kind(n, "dictionary_splat")).
perf402_alt_10(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
//   A: metavariable this relation binds for the calling rule
.decl perf402_alt_8(n: node, a: loc)
perf402_alt_8(n, A) :- kind(n, "generator_expression"), node(_, n, _, _, _), A = n.
perf402_alt_8(n, A) :- kind(n, "argument_list"), k2 = count : { child(n, c1, _), !perf402_alt_6(c1) },
    k2 >= 1, k2 <= 1, child(n, c3, _), node(_, c3, _, _, _), A = c3, !perf402_alt_10(c3).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl perf402_alt_11(n: node)
perf402_alt_11(n) :- kind(n, "comment").
perf402_alt_11(n) :- node(_, n, _, _, _), glob(";", n).

// alt_13(n): the JSON `any`: n matches if any one of these rules does
.decl perf402_alt_13(n: node)
perf402_alt_13(n) :- precedes(s1, n), !perf402_alt_11(s1).
perf402_alt_13(n) :- precedes(n, s2), !perf402_alt_11(s2).
