PYI019(R, n, N) :- kind(n, "function_definition"), pyi019_method(n, N),
    match("(?:async[ \\t]+)?def[ \\t]+\\w+(?P<R>(?:\"[^\"\\n]*\"|\\x27[^\\x27\\n]*\\x27|[^-]|-[^>])*?\\)|(?:\"[^\"\\n]*\"|\\x27[^\\x27\\n]*\\x27|[^-]|-[^>])*?\\)(?:[ \\t]|\\\\\\r?\\n)*->(?:[^:\\[\\]]|\\[(?:[^\\[\\]]|\\[[^\\]]*\\])*\\])*?|(?:\"[^\"\\n]*\"|\\x27[^\\x27\\n]*\\x27|[^-]|-[^>])*?\\)(?:[ \\t]|\\\\\\r?\\n)*->[^:]*?)[ \\t]*:(?s:.*)", n),
    count : { field(n, "return_type", c1), child(c1, c2, _), kind(c2, "parenthesized_expression") } = 0.
PYI019(R, n, N) :- kind(n, "function_definition"), pyi019_method(n, N),
    match("(?:async[ \\t]+)?def[ \\t]+\\w+(?P<R>(?:\"[^\"\\n]*\"|\\x27[^\\x27\\n]*\\x27|[^-\"\\x27]|-[^>\"\\x27])*?\\)(?:[ \\t]|\\\\\\r?\\n)*->[ \\t]*(?:\\(\\s*)+(?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*?)(?:(?:\\s|#[^\\n]*)*\\))+[ \\t]*:(?s:.*)", n),
    field(n, "return_type", c1), child(c1, c2, _),
    kind(c2, "parenthesized_expression").

