pyi019_demand_own_type_param_n(n, N) :- kind(n, "identifier"), node(_, n, _, _, _), N = n.
pyi019_demand_own_type_param_n(n, N) :- pyi019_demand_typevar_named_n(n, N).

// demand_typevar_assigned_n: the rows of typevar_assigned_n its callers ask for (the metavariable columns they pass in)
.decl pyi019_demand_typevar_assigned_n(n: node, n_mv: loc)
pyi019_demand_typevar_assigned_n(n, N) :- pyi019_demand_typevar_named_n(n, N).

// demand_scope_typevar_n: the rows of scope_typevar_n its callers ask for (the metavariable columns they pass in)
.decl pyi019_demand_scope_typevar_n(n: node, n_mv: loc)
pyi019_demand_scope_typevar_n(p1, N) :- pyi019_demand_typevar_assigned_n(n, N),
    within_stop(n, p1, "class_definition"), kind(p1, "class_definition").
pyi019_demand_scope_typevar_n(p2, N) :- pyi019_demand_typevar_assigned_n(n, N),
    within_stop(n, p1, "class_definition"), kind(p1, "class_definition"),
    within(p1, p2), (kind(p2, "function_definition") ; kind(p2, "module")).

// demand_stop_1: the rows of stop_1 its callers ask for (the metavariable columns they pass in)
.decl pyi019_demand_stop_1(n: node, n_mv: loc)
pyi019_demand_stop_1(m_s1, N) :- pyi019_demand_typevar_assigned_n(n, N),
    within_stop(n, p1, "class_definition"), kind(p1, "class_definition"),
    within(p1, p2), (kind(p2, "function_definition") ; kind(p2, "module")),
    within(p1, m_s1), within(m_s1, p2).

// demand_alt_11: the rows of alt_11 its callers ask for (the metavariable columns they pass in)
.decl pyi019_demand_alt_11(n: node, n_mv: loc)
pyi019_demand_alt_11(c1, N) :- pyi019_demand_scope_typevar_n(n, N), within_stop(c1, n, pyi019_stop_13),
    kind(c1, "expression_statement"), child(c1, c2, _), kind(c2, "assignment"),
    field(c2, "left", c4), kind(c4, "identifier"), node(_, c4, _, _, _), L = c4, field(c2, "right", c5),
    pyi019_typevar_rhs(c5), text(L, t6), text(N, t6), @doc(L) = @doc(N).

// demand_scope_binds_n: the rows of scope_binds_n its callers ask for (the metavariable columns they pass in)
.decl pyi019_demand_scope_binds_n(n: node, n_mv: loc)
pyi019_demand_scope_binds_n(n, N) :- pyi019_demand_stop_1(n, N),
    (kind(n, "function_definition") ; kind(n, "module")).

// demand_later_binds_n: the rows of later_binds_n its callers ask for (the metavariable columns they pass in)
.decl pyi019_demand_later_binds_n(n: node, n_mv: loc)
pyi019_demand_later_binds_n(s1, N) :- pyi019_demand_alt_11(n, N), precedes(n, s1).
pyi019_demand_later_binds_n(s3, N) :- pyi019_demand_alt_11(n, N), within_stop(n, p2, pyi019_stop_10),
    precedes(p2, s3).

// demand_binds_n: the rows of binds_n its callers ask for (the metavariable columns they pass in)
.decl pyi019_demand_binds_n(n: node, n_mv: loc)
pyi019_demand_binds_n(c8, N) :- pyi019_demand_binds_n(n, N), kind(n, "decorated_definition"),
    field(n, "definition", c8).
pyi019_demand_binds_n(c1, N) :- pyi019_demand_scope_binds_n(n, N), within_stop(c1, n, pyi019_stop_13).
pyi019_demand_binds_n(n, N) :- pyi019_demand_later_binds_n(n, N).
pyi019_demand_binds_n(c1, N) :- pyi019_demand_later_binds_n(n, N), within_stop(c1, n, pyi019_stop_13).

// demand_metaclass_base: the nodes metaclass_base is asked at (its recursion looks at every descendant)
.decl pyi019_demand_metaclass_base(n: node)
pyi019_demand_metaclass_base(c5) :- pyi019_demand_metaclass_base(n), kind(n, "identifier"),
    ref_site(n, b2), (st3 = b2 ; within(b2, st3)), kind(st3, "class_definition"),
    field(st3, "superclasses", c4), child(c4, c5, _).
pyi019_demand_metaclass_base(c6) :- pyi019_demand_metaclass_base(n),
    kind(n, "parenthesized_expression"), child(n, c6, _).
pyi019_demand_metaclass_base(c3) :- kind(n, "function_definition"),
    within_stop(n, p1, pyi019_stop_14), kind(p1, "class_definition"),
    field(p1, "superclasses", c2), child(c2, c3, _).

// stop_10: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi019_stop_10(kind: symbol)
pyi019_stop_10("function_definition"). pyi019_stop_10("class_definition").
pyi019_stop_10("decorated_definition"). pyi019_stop_10("module").

// stop_13: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi019_stop_13(kind: symbol)
pyi019_stop_13("function_definition"). pyi019_stop_13("class_definition").
pyi019_stop_13("decorated_definition").

// stop_14: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi019_stop_14(kind: symbol)
pyi019_stop_14("function_definition"). pyi019_stop_14("class_definition").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl pyi019_stop_1(n: node, n_mv: loc)
pyi019_stop_1(n, N) :- pyi019_demand_stop_1(n, N),
    (kind(n, "function_definition") ; kind(n, "module")), pyi019_scope_binds_n(n, N).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl pyi019_alt_4(n: node)
pyi019_alt_4(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
pyi019_alt_4(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable this relation binds for the calling rule
.decl pyi019_alt_6(n: node, n_mv: loc)
pyi019_alt_6(n, N) :- child(n, c1, _), kind(c1, "identifier"), N = c1.
pyi019_alt_6(n, N) :- child(n, c2, _), kind(c2, "parenthesized_expression"), child(c2, c3, _),
    kind(c3, "identifier"), N = c3.

// alt_11(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl pyi019_alt_11(n: node, n_mv: loc)
pyi019_alt_11(n, N) :- pyi019_demand_alt_11(n, N), precedes(n, s1), pyi019_later_binds_n(s1, N).
pyi019_alt_11(n, N) :- pyi019_demand_alt_11(n, N), within_stop(n, p2, pyi019_stop_10),
    !kind(p2, "function_definition"), !kind(p2, "class_definition"),
    !kind(p2, "decorated_definition"), !kind(p2, "module"), precedes(p2, s3),
    pyi019_later_binds_n(s3, N).

// alt_15(n): the JSON `any`: n matches if any one of these rules does
.decl pyi019_alt_15(n: node)
pyi019_alt_15(n) :- pyi019_static_fn(n).
pyi019_alt_15(n) :- pyi019_abstract_fn(n).
pyi019_alt_15(n) :- pyi019_overload_fn(n).
