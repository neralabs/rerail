// demand_alt_2: the nodes alt_2 is asked at (its recursion looks at every descendant)
.decl n804_demand_alt_2(n: node)
n804_demand_alt_2(s3) :- n804_demand_meta_class(n), kind(n, "class_definition"), child(n, c1, _),
