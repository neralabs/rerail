n804_demand_tainted_attr(n) :- n804_demand_call_tainted(n).

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl n804_up_1(n: node, p: node)
n804_up_1(n, p) :- n804_demand_class_method(n), within_stop(n, p, n804_stop_11),
