n804_call_tainted(n) :- n804_demand_call_tainted(n), n804_tainted_attr(n, P).
n804_call_tainted(n) :- n804_demand_call_tainted(n), kind(n, "subscript"), field(n, "value", c3),
    n804_call_tainted(c3).
n804_call_tainted(n) :- n804_demand_call_tainted(n), kind(n, "parenthesized_expression"),
