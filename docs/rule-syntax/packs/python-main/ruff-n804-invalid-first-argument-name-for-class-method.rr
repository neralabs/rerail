n804_demand_call_tainted(n) :- n804_demand_alt_2(n).

// demand_call_tainted_class: the nodes call_tainted_class is asked at (its recursion looks at every descendant)
.decl n804_demand_call_tainted_class(n: node)
n804_demand_call_tainted_class(st2) :- n804_demand_call_tainted(n), kind(n, "identifier"),
