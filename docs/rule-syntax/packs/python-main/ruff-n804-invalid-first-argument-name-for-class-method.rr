    (n804_static_ref(c3) ; kind(c3, "call"), field(c3, "function", c1), n804_static_ref(c1)).

// class_decorated(n): the JSON util `class-decorated`, used where the JSON says `matches: "class-decorated"`
.decl n804_class_decorated(n: node)
n804_class_decorated(n) :- child(p1, n, _), kind(p1, "decorated_definition"),
    child(p1, c2, _), kind(c2, "decorator"), child(c2, c3, _),
    (n804_class_ref(c3) ; kind(c3, "call"), field(c3, "function", c1), n804_class_ref(c1)).

// first_slot(n): the JSON util `first-slot`, used where the JSON says `matches: "first-slot"`
.decl n804_first_slot(n: node)
n804_first_slot(n) :- n804_demand_first_slot(n), child(p1, n, _), n804_counted_10(n),
