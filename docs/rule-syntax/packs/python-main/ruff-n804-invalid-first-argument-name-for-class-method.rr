// class_method(n): the JSON util `class-method`, used where the JSON says `matches: "class-method"`
.decl n804_class_method(n: node)
n804_class_method(n) :- n804_demand_class_method(n), kind(n, "function_definition"), n804_up_2(n, p1),
    !n804_static_decorated(n),
    ( n804_class_decorated(n)
    ; field(n, "name", c1), glob("{__init_subclass__,__class_getitem__}", c1)
    ; count : { field(n, "name", c2), glob("__new__", c2) } = 0, n804_up_1(n, p2)
    ).


// static_decorated(n): the JSON util `static-decorated`, used where the JSON says `matches: "static-decorated"`
.decl n804_static_decorated(n: node)
n804_static_decorated(n) :- child(p1, n, _), kind(p1, "decorated_definition"),
