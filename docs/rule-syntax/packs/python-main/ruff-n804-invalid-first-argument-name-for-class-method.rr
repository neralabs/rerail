.policy "ruff-n804-invalid-first-argument-name-for-class-method" revision 1
.guests off
.description "Name the first parameter of class methods cls, as PEP 8 recommends, so it reads as the class and not as an instance."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// cls_name(n): the JSON util `cls-name`, used where the JSON says `matches: "cls-name"`
.decl n804_cls_name(n: node)
n804_cls_name(n) :- node(_, n, _, _, _), glob("cls", n).
n804_cls_name(n) :- node(_, n, _, _, _),
    glob("{setUp,tearDown,setUpClass,tearDownClass,setUpModule,tearDownModule,asyncSetUp,asyncTearDown,setUpTestData,failureException,longMessage,maxDiff}", n).

// class_ref(n): the JSON util `class-ref`, used where the JSON says `matches: "class-ref"`
.decl n804_class_ref(n: node)
n804_class_ref(n) :- global_ref(n, "classmethod"),
    (sym_of(n, "builtins.classmethod") ; sym_of(n, "abc.abstractclassmethod")).

// static_ref(n): the JSON util `static-ref`, used where the JSON says `matches: "static-ref"`
.decl n804_static_ref(n: node)
n804_static_ref(n) :- global_ref(n, "staticmethod"),
    (sym_of(n, "builtins.staticmethod") ; sym_of(n, "abc.abstractstaticmethod")).

// type_ref(n): the JSON util `type-ref`, used where the JSON says `matches: "type-ref"`
.decl n804_type_ref(n: node)
n804_type_ref(n) :- global_ref(n, "type"), sym_of(n, "builtins.type").

// meta_base(n): the JSON util `meta-base`, used where the JSON says `matches: "meta-base"`
.decl n804_meta_base(n: node)
n804_meta_base(n) :- n804_type_ref(n).
n804_meta_base(n) :-
    ( sym_of(n, "abc.ABCMeta")
    ; sym_of(n, "enum.EnumMeta")
    ; sym_of(n, "enum.EnumType")
    ).

n804_meta_base(n) :- kind(n, "subscript"), field(n, "value", c1), n804_type_ref(c1).
n804_meta_base(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), n804_meta_base(c2).

// meta_class(n): the JSON util `meta-class`, used where the JSON says `matches: "meta-class"`
.decl n804_meta_class(n: node)
n804_meta_class(n) :- n804_demand_meta_class(n), kind(n, "class_definition"), child(n, c1, _),
    kind(c1, "argument_list"), child(c1, c2, _), n804_alt_1(c2),
    count : { precedes(s3, c2), n804_alt_2(s3) } = 0.

// local_meta(n): the JSON util `local-meta`, used where the JSON says `matches: "local-meta"`
.decl n804_local_meta(n: node)
n804_local_meta(n) :- n804_demand_local_meta(n), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), n804_meta_class(st2), site_scope(b1, "module"),
    site_latest(b1).
n804_local_meta(n) :- n804_demand_local_meta(n), n804_meta_attr(n, P).
n804_local_meta(n) :- n804_demand_local_meta(n), kind(n, "subscript"), field(n, "value", c3),
    n804_local_meta(c3).
n804_local_meta(n) :- n804_demand_local_meta(n), kind(n, "parenthesized_expression"),
    child(n, c4, _), n804_local_meta(c4).

// call_tainted_class(n): the JSON util `call-tainted-class`, used where the JSON says `matches: "call-tainted-class"`
.decl n804_call_tainted_class(n: node)
n804_call_tainted_class(n) :- n804_demand_call_tainted_class(n), kind(n, "class_definition"),
    child(n, c1, _), kind(c1, "argument_list"), child(c1, c2, _), n804_alt_2(c2).

// call_tainted(n): the JSON util `call-tainted`, used where the JSON says `matches: "call-tainted"`
.decl n804_call_tainted(n: node)
n804_call_tainted(n) :- n804_demand_call_tainted(n), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), n804_call_tainted_class(st2), site_scope(b1, "module"),
