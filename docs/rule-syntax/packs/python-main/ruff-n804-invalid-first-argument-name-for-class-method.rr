// scope_node(n): the JSON util `scope-node`, used where the JSON says `matches: "scope-node"`
.decl n804_scope_node(n: node)
n804_scope_node(n) :- (kind(n, "function_definition") ; kind(n, "class_definition")).

// N804(n): a finding at node n, from clause `invalid-first-argument-name`.
// Each rule below is one way the JSON `rule` can match.
.violation N804(at: node) "Rename this class method's first parameter to `cls` and update its uses in the body, unless another parameter already has that name; keep it if the project follows another convention."
    suppress noqa "N804"
N804(n) :- kind(n, "identifier"), n804_first_slot(n), !n804_cls_name(n).
N804(n) :- kind(n, "identifier"), !n804_cls_name(n), field(p1, "name", n),
    kind(p1, "default_parameter"), n804_first_slot(p1).
N804(n) :- kind(n, "typed_parameter"), n804_first_slot(n), child(n, c2, _),
    kind(c2, "identifier"), !n804_cls_name(c2).

// N804_invalid_first_argument_name_annotated_default(n): a finding at node n, from clause `invalid-first-argument-name-annotated-default`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation N804_invalid_first_argument_name_annotated_default(at: node, param: node) code "N804" "Rename this class method's first parameter to `cls` and update its uses in the body, unless another parameter already has that name; keep it if the project follows another convention."
    suppress noqa "N804"
N804_invalid_first_argument_name_annotated_default(PARAM, n) :- kind(n, "typed_default_parameter"),
    n804_first_slot(n),
    match("(?P<PARAM>(?:[^=\\[\\]()\"']|\"[^\"]*\"|'[^']*'|\\[(?:[^\\[\\]]|\\[(?:[^\\[\\]]|\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\])*\\])*\\]|\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))+?)\\s*=.*", n),
    field(n, "name", c1), !n804_cls_name(c1).

// demand_first_slot: the rows of first_slot its callers ask for (the metavariable columns they pass in)
.decl n804_demand_first_slot(n: node)
n804_demand_first_slot(n) :- kind(n, "identifier").
n804_demand_first_slot(p1) :- kind(n, "identifier"), field(p1, "name", n),
    kind(p1, "default_parameter").
n804_demand_first_slot(n) :- kind(n, "typed_parameter"), child(n, c2, _),
    kind(c2, "identifier").
n804_demand_first_slot(n) :- kind(n, "typed_default_parameter"),
    match("(?P<PARAM>(?:[^=\\[\\]()\"']|\"[^\"]*\"|'[^']*'|\\[(?:[^\\[\\]]|\\[(?:[^\\[\\]]|\\[(?:[^\\[\\]]|\\[[^\\[\\]]*\\])*\\])*\\])*\\]|\\((?:[^()]|\\((?:[^()]|\\([^()]*\\))*\\))*\\))+?)\\s*=.*", n),
    field(n, "name", c1).

// demand_class_method: the rows of class_method its callers ask for (the metavariable columns they pass in)
.decl n804_demand_class_method(n: node)
n804_demand_class_method(p6) :- n804_demand_first_slot(n), child(p1, n, _), n804_counted_10(n),
    child(p5, n, _), kind(p5, "parameters"), child(p6, p5, _),
    kind(p6, "function_definition").

