n804_demand_local_meta(n) :- n804_demand_alt_1(n).

// demand_meta_attr: the nodes meta_attr is asked at (its recursion looks at every descendant)
.decl n804_demand_meta_attr(n: node)
n804_demand_meta_attr(n) :- n804_demand_local_meta(n).

// demand_meta_class: the nodes meta_class is asked at (its recursion looks at every descendant)
.decl n804_demand_meta_class(n: node)
n804_demand_meta_class(st2) :- n804_demand_local_meta(n), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), site_scope(b1, "module"), site_latest(b1).
n804_demand_meta_class(p2) :- n804_demand_class_method(n), kind(n, "function_definition"),
    n804_up_2(n, p1), n804_up_3(n, p2).
n804_demand_meta_class(c6) :- n804_demand_meta_attr(n), kind(n, "attribute"),
    field(n, "attribute", c1), node(_, c1, _, _, _), A = c1, field(n, "object", c2),
    kind(c2, "identifier"), ref_site(c2, b3), site_scope(b3, "module"),
    site_latest(b3), (st4 = b3 ; within(b3, st4)), kind(st4, "class_definition"),
