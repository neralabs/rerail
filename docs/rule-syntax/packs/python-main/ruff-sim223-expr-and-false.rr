.decl sim223_fexpr_empty_u7(n: node)
sim223_fexpr_empty_u7(n) :- sim223_alt_20_u6(n).
sim223_fexpr_empty_u7(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
