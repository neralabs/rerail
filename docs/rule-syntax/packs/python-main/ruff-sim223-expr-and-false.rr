.decl sim223_fexpr_empty_u3(n: node)
sim223_fexpr_empty_u3(n) :- sim223_alt_20_u2(n).
sim223_fexpr_empty_u3(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    sim223_fexpr_empty_u2(c1).

.decl sim223_fexpr_empty_u4(n: node)
sim223_fexpr_empty_u4(n) :- sim223_alt_20_u3(n).
sim223_fexpr_empty_u4(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
