.decl sim223_fexpr_empty_u5(n: node)
sim223_fexpr_empty_u5(n) :- sim223_alt_20_u4(n).
sim223_fexpr_empty_u5(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
