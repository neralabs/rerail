.decl sim223_interp_empty_u1(n: node)
sim223_interp_empty_u1(n) :- count : { child(n, c1, _), sim223_alt_19(c1) } = 0, child(n, c2, _),
    sim223_tok_follows_7(c2), sim223_fexpr_empty_u0(c2).

.decl sim223_interp_empty_u2(n: node)
sim223_interp_empty_u2(n) :- count : { child(n, c1, _), sim223_alt_19(c1) } = 0, child(n, c2, _),
    sim223_tok_follows_7(c2), sim223_fexpr_empty_u1(c2).

.decl sim223_interp_empty_u3(n: node)
sim223_interp_empty_u3(n) :- count : { child(n, c1, _), sim223_alt_19(c1) } = 0, child(n, c2, _),
    sim223_tok_follows_7(c2), sim223_fexpr_empty_u2(c2).

