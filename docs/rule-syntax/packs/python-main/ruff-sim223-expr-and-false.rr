// truthy_value: b is "true" when n's value is truthy (Python's bool(v)), "false" when it is falsy
.decl sim223_truthy_value(n: node, b: symbol)
sim223_truthy_value(n, "false") :- sim223_value(n, x), value_type(x, "NoneType").
sim223_truthy_value(n, b) :- sim223_value(n, x), value_type(x, "boolean"), b = x.
sim223_truthy_value(n, "false") :- sim223_value(n, x),
    (value_type(x, "int") ; value_type(x, "float")),
    (x = "0" ; x = "0.0" ; x = "-0.0").
sim223_truthy_value(n, "true") :- sim223_value(n, x),
    (value_type(x, "int") ; value_type(x, "float")), x != "0", x != "0.0", x != "-0.0".
sim223_truthy_value(n, "false") :- sim223_value(n, x),
    (value_type(x, "str") ; value_type(x, "bytes")), x = "".
sim223_truthy_value(n, "true") :- sim223_value(n, x),
    (value_type(x, "str") ; value_type(x, "bytes")), x != "".

