.decl sim223_fexpr_empty_u6(n: node)
sim223_fexpr_empty_u6(n) :- sim223_alt_20_u5(n).
sim223_fexpr_empty_u6(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
