.policy "ruff-log015-root-logger-call" revision 1
.guests off
.description "Use a logger from logging.getLogger(__name__) instead of the logging module's root logger functions; root logger messages carry no source information."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// LOG015(n): a finding at node n, from clause `root-logger-call`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation LOG015(at: node, m: loc) "Replace this root logger `{m}()` call with the same call on a module-level `logger = logging.getLogger(__name__)`; root logger messages carry no source information. Leave it in a one-off script."
    suppress noqa "LOG015"
LOG015(n, M) :- kind(n, "call"), field(n, "function", c1), log015_root_callee(c1, M).

// root_callee(n): the JSON util `root-callee`, used where the JSON says `matches: "root-callee"`
//   M: metavariable this relation binds for the calling rule
.decl log015_root_callee(n: node, m: loc)
log015_root_callee(n, M) :- kind(n, "identifier"), sym_of(n, q1), log015_set_1(q1), node(_, n, _, _, _), M = n.
log015_root_callee(n, M) :- kind(n, "attribute"), sym_of(n, q2), log015_set_1(q2),
    field(n, "attribute", c3), node(_, c3, _, _, _), M = c3.
log015_root_callee(n, M) :- kind(n, "parenthesized_expression"), child(n, c4, _),
    log015_root_callee(c4, M).

// set_1: symbols from the JSON `resolves.import`
.decl log015_set_1(v: symbol)
log015_set_1("logging.debug"). log015_set_1("logging.info"). log015_set_1("logging.warn").
log015_set_1("logging.warning"). log015_set_1("logging.error"). log015_set_1("logging.critical").
log015_set_1("logging.log"). log015_set_1("logging.exception").
