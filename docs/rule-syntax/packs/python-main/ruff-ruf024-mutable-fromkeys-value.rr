.policy "ruff-ruf024-mutable-fromkeys-value" revision 1
.guests off
.description "Don't pass a mutable object such as a list, dict or set as the value to dict.fromkeys; every key shares the same instance."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// RUF024(n): a finding at node n, from clause `mutable-fromkeys-value`.
// Each rule below is one way the JSON `rule` can match.
.violation RUF024(at: node) "Build the dict with a comprehension that creates a fresh value per key, e.g. `{{key: [] for key in keys}}`; `dict.fromkeys` shares one mutable value across all keys. Leave it if sharing is intended."
    suppress noqa "RUF024"
RUF024(n) :- kind(n, "call"), field(n, "function", c1), ruf024_fromkeys_callee(c1),
    field(n, "arguments", c2), kind(c2, "argument_list"), child(c2, c3, _),
    ruf024_positional(c3), count : { precedes(c3, s4), ruf024_positional(s4) } = 0, precedes(s5, c3),
    ruf024_positional(s5), ruf024_mutable_value(c3),
    k7 = count : { precedes(s6, c3), ruf024_positional(s6) }, k7 >= 1, k7 <= 1.

// dict_ref(n): the JSON util `dict-ref`, used where the JSON says `matches: "dict-ref"`
.decl ruf024_dict_ref(n: node)
ruf024_dict_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "dict"),
    sym_of(n, "builtins.dict").
ruf024_dict_ref(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    !kind(c1, "comment"), ruf024_dict_ref(c1).

// fromkeys_callee(n): the JSON util `fromkeys-callee`, used where the JSON says `matches: "fromkeys-callee"`
.decl ruf024_fromkeys_callee(n: node)
ruf024_fromkeys_callee(n) :- kind(n, "attribute"), field(n, "object", c1), ruf024_dict_ref(c1),
    field(n, "attribute", c2), glob("fromkeys", c2).
ruf024_fromkeys_callee(n) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    !kind(c3, "comment"), ruf024_fromkeys_callee(c3).

// mutable_name(n): the JSON util `mutable-name`, used where the JSON says `matches: "mutable-name"`
.decl ruf024_mutable_name(n: node)
ruf024_mutable_name(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (global_ref(n, "dict") ; global_ref(n, "list") ; global_ref(n, "set")),
    sym_of(n, q1), ruf024_set_1(q1).
ruf024_mutable_name(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    !kind(c2, "comment"), ruf024_mutable_name(c2).

// mutable_callee(n): the JSON util `mutable-callee`, used where the JSON says `matches: "mutable-callee"`
.decl ruf024_mutable_callee(n: node)
ruf024_mutable_callee(n) :- ruf024_mutable_name(n).
ruf024_mutable_callee(n) :- kind(n, "subscript"), field(n, "value", c1), ruf024_mutable_name(c1).
ruf024_mutable_callee(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    !kind(c2, "comment"), ruf024_mutable_callee(c2).

// mutable_value(n): the JSON util `mutable-value`, used where the JSON says `matches: "mutable-value"`
.decl ruf024_mutable_value(n: node)
ruf024_mutable_value(n) :- kind(n, k1), ruf024_set_2(k1).
ruf024_mutable_value(n) :- kind(n, "call"), field(n, "function", c2), ruf024_mutable_callee(c2).
ruf024_mutable_value(n) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    !kind(c3, "comment"), ruf024_mutable_value(c3).

// positional(n): the JSON util `positional`, used where the JSON says `matches: "positional"`
.decl ruf024_positional(n: node)
ruf024_positional(n) :- node(_, n, _, _, _), !ruf024_alt_3(n).

// set_1: symbols from the JSON `resolves.import`
.decl ruf024_set_1(v: symbol)
ruf024_set_1("builtins.dict"). ruf024_set_1("builtins.list"). ruf024_set_1("builtins.set").
ruf024_set_1("collections.Counter"). ruf024_set_1("collections.OrderedDict").
ruf024_set_1("collections.defaultdict"). ruf024_set_1("collections.deque").

// set_2: node kinds from a JSON `any`
.decl ruf024_set_2(v: symbol)
ruf024_set_2("list"). ruf024_set_2("dictionary"). ruf024_set_2("set"). ruf024_set_2("list_comprehension").
ruf024_set_2("dictionary_comprehension"). ruf024_set_2("set_comprehension").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl ruf024_alt_3(n: node)
ruf024_alt_3(n) :- (kind(n, "comment") ; kind(n, "keyword_argument") ; kind(n, "dictionary_splat")).
ruf024_alt_3(n) :- node(_, n, _, _, _), glob("[(),]", n).
