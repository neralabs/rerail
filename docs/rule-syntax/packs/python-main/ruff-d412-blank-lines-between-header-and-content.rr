.decl d412_spaced_first_google(n: node, f: loc)
d412_spaced_first_google(n, F) :- node(_, n, _, _, _),
    match("(?m)(?s:.*?)(?:(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*|^[^\\S\\n]*\\n[ ]{5}[^\\S\\n]*)(?:(?:a(?i:(?:rg(?:s|uments)|tt(?:ention|ributes)))|c(?i:aution)|d(?i:anger)|e(?i:(?:rror|xamples?))|h(?i:int)|i(?i:mportant)|k(?i:eyword arg(?:s|uments))|m(?i:ethods)|n(?i:otes?)|o(?i:ther arg(?:s|uments))|r(?i:(?:aises|e(?:ferences|turns?)))|s(?i:ee also)|t(?i:(?:ip|odo))|w(?i:arn(?:ings?|s))|y(?i:ields?))):?[^\\S\\n]*$(?:(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*-+[^\\S\\n]*$)?(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|xamples?)|hint|important|keyword arg(?:s|uments)|methods|notes?|other arg(?:s|uments)|r(?:aises|e(?:ferences|turns?))|see also|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$|(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*|^[^\\S\\n]*\\n[ ]{5}[^\\S\\n]*)(?P<F>(?:a(?i:(?:rg(?:s|uments)|tt(?:ention|ributes)))|c(?i:aution)|d(?i:anger)|e(?i:(?:rror|xamples?))|h(?i:int)|i(?i:mportant)|k(?i:eyword arg(?:s|uments))|m(?i:ethods)|n(?i:otes?)|o(?i:ther arg(?:s|uments))|r(?i:(?:aises|e(?:ferences|turns?)))|s(?i:ee also)|t(?i:(?:ip|odo))|w(?i:arn(?:ings?|s))|y(?i:ields?))):?[^\\S\\n]*$(?:(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?:[^\\s\\-.]|-+[^\\S\\n]*[^\\s\\-]|\\.(?:[^.\\n]|$)|\\.\\.(?:[^ \\n]|$))|(?:\\n[^\\S\\n]*){2,}\\n[^\\S\\n]*\\.\\.[ ]|(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*-+[^\\S\\n]*$(?:(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?:[^\\s.]|\\.(?:[^.\\n]|$)|\\.\\.(?:[^ \\n]|$))|(?:\\n[^\\S\\n]*){2,}\\n[^\\S\\n]*\\.\\.[ ]))|(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|xamples?)|hint|important|keyword arg(?:s|uments)|methods|notes?|other arg(?:s|uments)|r(?:aises|e(?:ferences|turns?))|see also|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$|\\n[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|xamples?)|hint|important|keyword arg(?:s|uments)|methods|notes?|other arg(?:s|uments)|r(?:aises|e(?:ferences|turns?))|see also|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$))(?s:.*)", n).

// D412(n): findings from clauses `blank-lines-between-header-and-content-numpy-lowercase-after-blank`, `blank-lines-between-header-and-content-google-lowercase-after-blank`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation D412(at: node, l: node) "Remove the blank lines between the `{l}` header and its content; keep one blank line only when the content is a reStructuredText directive (`.. `)."
    suppress noqa "D412"
// L: not bound by this rule, so empty (unset) here, as in ast-grep.
D412(rr_at, L) :- kind(n, "string_content"), child(p1_5, n, _), d412_docstring(p1_5), (d412_spaced_header_numpy(n, w5_k, L, w5_n) ; d412_spaced_first_numpy(n, w5_f)), d412_numpy_mode(n), !d412_directive_hides_header(n),
    unset(L),
    (unset(L), rr_at = n ; !unset(L), rr_at = L).
// L: not bound by this rule, so empty (unset) here, as in ast-grep.
D412(rr_at, L) :- kind(n, "string_content"), child(p1_1, n, _), d412_docstring(p1_1), (d412_spaced_header_google(n, w1_k, L, w1_n) ; d412_spaced_first_google(n, w1_f)), !d412_numpy_mode(n), !d412_directive_hides_header(n),
    unset(L),
    (unset(L), rr_at = n ; !unset(L), rr_at = L).

