d412_spaced_first_numpy(n, F) :- node(_, n, _, _, _),
    match("(?m)(?s:.*?)(?:(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*|^[^\\S\\n]*\\n[ ]{5}[^\\S\\n]*)(?:(?:a(?i:ttributes)|e(?i:x(?:amples|tended summary))|m(?i:ethods)|n(?i:otes)|o(?i:ther param(?:eters|s))|p(?i:arameters)|r(?i:(?:aises|e(?:ceives|ferences|turns)))|s(?i:(?:ee also|hort summary))|w(?i:arn(?:ings|s))|y(?i:ields))):?[^\\S\\n]*$(?:(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*-+[^\\S\\n]*$)?(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$|(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*|^[^\\S\\n]*\\n[ ]{5}[^\\S\\n]*)(?P<F>(?:a(?i:ttributes)|e(?i:x(?:amples|tended summary))|m(?i:ethods)|n(?i:otes)|o(?i:ther param(?:eters|s))|p(?i:arameters)|r(?i:(?:aises|e(?:ceives|ferences|turns)))|s(?i:(?:ee also|hort summary))|w(?i:arn(?:ings|s))|y(?i:ields))):?[^\\S\\n]*$(?:(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?:[^\\s\\-.]|-+[^\\S\\n]*[^\\s\\-]|\\.(?:[^.\\n]|$)|\\.\\.(?:[^ \\n]|$))|(?:\\n[^\\S\\n]*){2,}\\n[^\\S\\n]*\\.\\.[ ]|(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*-+[^\\S\\n]*$(?:(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?:[^\\s.]|\\.(?:[^.\\n]|$)|\\.\\.(?:[^ \\n]|$))|(?:\\n[^\\S\\n]*){2,}\\n[^\\S\\n]*\\.\\.[ ]))|(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$|\\n[^\\S\\n]*(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$))(?s:.*)", n).

