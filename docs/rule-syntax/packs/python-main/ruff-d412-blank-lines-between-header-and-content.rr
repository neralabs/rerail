.policy "ruff-d412-blank-lines-between-header-and-content" revision 1
.guests off
.description "Start each docstring section's content on the line right after its header, without blank lines in between, for a consistent docstring layout."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// doc_stmt(n): the JSON util `doc-stmt`, used where the JSON says `matches: "doc-stmt"`
.decl d412_doc_stmt(n: node)
d412_doc_stmt(n) :- kind(n, "expression_statement"), !d412_alt_1(n),
    ( child(p1, n, _), kind(p1, "module")
    ; child(p2, n, _), kind(p2, "block"), child(p3, p2, _), (kind(p3, "function_definition") ; kind(p3, "class_definition"))
    ).


// doc_holder(n): the JSON util `doc-holder`, used where the JSON says `matches: "doc-holder"`
.decl d412_doc_holder(n: node)
d412_doc_holder(n) :- d412_doc_stmt(n).
d412_doc_holder(n) :- kind(n, "parenthesized_expression"), child(p1, n, _), d412_doc_holder(p1).

// docstring(n): the JSON util `docstring`, used where the JSON says `matches: "docstring"`
.decl d412_docstring(n: node)
d412_docstring(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0,
    child(p2, n, _), d412_doc_holder(p2).

// numpy_mode(n): the JSON util `numpy-mode`, used where the JSON says `matches: "numpy-mode"`
.decl d412_numpy_mode(n: node)
d412_numpy_mode(n) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:other param(?:eters|s)|parameters)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:other param(?:eters|s)|parameters)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n).
d412_numpy_mode(n) :- !match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:arg(?:s|uments)|keyword arg(?:s|uments)|other arg(?:s|uments))):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:arg(?:s|uments)|keyword arg(?:s|uments)|other arg(?:s|uments))):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n),
    match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n),
    d412_alt_4(n).

// underlined(n): the JSON util `underlined`, used where the JSON says `matches: "underlined"`
.decl d412_underlined(n: node)
d412_underlined(n) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)\\n[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|x(?:amples?|tended summary))|hint|important|keyword arg(?:s|uments)|methods|notes?|other (?:arg(?:s|uments)|param(?:eters|s))|parameters|r(?:aises|e(?:ceives|ferences|turns?))|s(?:ee also|hort summary)|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$\\n[^\\S\\n]*-+[^\\S\\n]*$(?s:.*)", n).

// directive_hides_header(n): the JSON util `directive-hides-header`, used where the JSON says `matches: "directive-hides-header"`
.decl d412_directive_hides_header(n: node)
d412_directive_hides_header(n) :- child(p1, n, _), kind(p1, "string"),
    value(p1, v2), match("(?s:.*)\\n([^\\S\\n]*)\\.\\.[ ][^\\n]*(?:\\n(?:[^\\S\\n]*|\\1[^\\S\\n]+[^\\n]*))*\\n\\1[^\\S\\n]+(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|x(?:amples?|tended summary))|hint|important|keyword arg(?:s|uments)|methods|notes?|other (?:arg(?:s|uments)|param(?:eters|s))|parameters|r(?:aises|e(?:ceives|ferences|turns?))|s(?:ee also|hort summary)|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*(?:\\n|\\z)(?s:.*)", v2).

// spaced_header_numpy(n): the JSON util `spaced-header-numpy`, used where the JSON says `matches: "spaced-header-numpy"`
//   K, L, N: metavariables this relation binds for the calling rule
.decl d412_spaced_header_numpy(n: node, k: loc, l: loc, n_mv: loc)
d412_spaced_header_numpy(n, K, L, N) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)(?:(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?:A(?i:ttributes)|E(?i:x(?:amples|tended summary))|M(?i:ethods)|N(?i:otes)|O(?i:ther param(?:eters|s))|P(?i:arameters)|R(?i:(?:aises|e(?:ceives|ferences|turns)))|S(?i:(?:ee also|hort summary))|W(?i:arn(?:ings|s))|Y(?i:ields)):?[^\\S\\n]*$|^[^\\S\\n]*\\n[ ]{0,4}(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$)(?:(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*-+[^\\S\\n]*$)?(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$|(?:^[^\\S\\n]*\\n[ ]{0,4}(?P<L>(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields))):?[^\\S\\n]*$|(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?P<N>(?:A(?i:ttributes)|E(?i:x(?:amples|tended summary))|M(?i:ethods)|N(?i:otes)|O(?i:ther param(?:eters|s))|P(?i:arameters)|R(?i:(?:aises|e(?:ceives|ferences|turns)))|S(?i:(?:ee also|hort summary))|W(?i:arn(?:ings|s))|Y(?i:ields))):?[^\\S\\n]*$)(?:(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?:[^\\s\\-.]|-+[^\\S\\n]*[^\\s\\-]|\\.(?:[^.\\n]|$)|\\.\\.(?:[^ \\n]|$))|(?:\\n[^\\S\\n]*){2,}\\n[^\\S\\n]*\\.\\.[ ]|(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*-+[^\\S\\n]*$(?:(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?:[^\\s.]|\\.(?:[^.\\n]|$)|\\.\\.(?:[^ \\n]|$))|(?:\\n[^\\S\\n]*){2,}\\n[^\\S\\n]*\\.\\.[ ]))|\\n[^\\S\\n]*(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$\\n[^\\S\\n]*-+[^\\S\\n]*$(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$|\\n[^\\S\\n]*(?P<K>(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields))):?[^\\S\\n]*$\\n[^\\S\\n]*-+[^\\S\\n]*$(?:(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?:[^\\s.]|\\.(?:[^.\\n]|$)|\\.\\.(?:[^ \\n]|$))|(?:\\n[^\\S\\n]*){2,}\\n[^\\S\\n]*\\.\\.[ ]))(?s:.*)", n).

