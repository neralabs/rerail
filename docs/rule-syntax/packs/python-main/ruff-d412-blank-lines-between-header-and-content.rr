.violation D412_blank_lines_between_header_and_content_numpy_underlined(at: node, k: node) code "D412" "Remove the blank lines between the `{k}` header and its content; keep one blank line only when the content is a reStructuredText directive (`.. `)."
    suppress noqa "D412"
// K: not bound by this rule, so empty (unset) here, as in ast-grep.
D412_blank_lines_between_header_and_content_numpy_underlined(rr_at, K) :- kind(n, "string_content"), child(p1_7, n, _), d412_docstring(p1_7), (d412_spaced_header_numpy(n, K, w7_l, w7_n) ; d412_spaced_first_numpy(n, w7_f)), d412_numpy_mode(n), !d412_directive_hides_header(n),
    unset(K),
    (unset(K), rr_at = n ; !unset(K), rr_at = K).
// K: not bound by this rule, so empty (unset) here, as in ast-grep.
D412_blank_lines_between_header_and_content_numpy_underlined(rr_at, K) :- kind(n, "string_content"), child(p1_3, n, _), d412_docstring(p1_3), (d412_spaced_header_google(n, K, w3_l, w3_n) ; d412_spaced_first_google(n, w3_f)), !d412_numpy_mode(n), !d412_directive_hides_header(n),
    unset(K),
    (unset(K), rr_at = n ; !unset(K), rr_at = K).

// D412_blank_lines_between_header_and_content_numpy_first_lowercase(n): findings from clauses `blank-lines-between-header-and-content-numpy-first-lowercase`, `blank-lines-between-header-and-content-google-first-lowercase`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation D412_blank_lines_between_header_and_content_numpy_first_lowercase(at: node, f: node) code "D412" "Remove the blank lines between the `{f}` header and its content; keep one blank line only when the content is a reStructuredText directive (`.. `)."
    suppress noqa "D412"
// F: not bound by this rule, so empty (unset) here, as in ast-grep.
D412_blank_lines_between_header_and_content_numpy_first_lowercase(rr_at, F) :- kind(n, "string_content"), child(p1_8, n, _), d412_docstring(p1_8), (d412_spaced_header_numpy(n, w8_k, w8_l, w8_n) ; d412_spaced_first_numpy(n, F)), d412_numpy_mode(n), !d412_directive_hides_header(n),
    unset(F),
    (unset(F), rr_at = n ; !unset(F), rr_at = F).
// F: not bound by this rule, so empty (unset) here, as in ast-grep.
D412_blank_lines_between_header_and_content_numpy_first_lowercase(rr_at, F) :- kind(n, "string_content"), child(p1_4, n, _), d412_docstring(p1_4), (d412_spaced_header_google(n, w4_k, w4_l, w4_n) ; d412_spaced_first_google(n, F)), !d412_numpy_mode(n), !d412_directive_hides_header(n),
    unset(F),
    (unset(F), rr_at = n ; !unset(F), rr_at = F).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d412_tok_has_1(n: node)
.stored d412_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d412_tok_has_1(n) :- child(n, c1, _), glob("\\,", c1).
d412_tok_has_1(n) :- op(n, t2), match(",", t2).
d412_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d412_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d412_tok_has_1(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl d412_alt_1(n: node)
d412_alt_1(n) :- d412_tok_has_1(n).
d412_alt_1(n) :- precedes(s9, n), !kind(s9, "comment").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl d412_alt_3(n: node)
d412_alt_3(n) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n).
d412_alt_3(n) :- d412_underlined(n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl d412_alt_4(n: node)
d412_alt_4(n) :- node(_, n, _, _, _),
    !match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n).
d412_alt_4(n) :- !match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n),
    d412_alt_3(n).
d412_alt_4(n) :- match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n),
    d412_underlined(n).
