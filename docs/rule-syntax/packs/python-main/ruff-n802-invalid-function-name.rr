.policy "ruff-n802-invalid-function-name" revision 1
.guests off
.description "Name functions and methods in lowercase snake_case, as PEP 8 recommends, so they read differently from classes and constants."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// typing_exempt(n): the JSON util `typing-exempt`, used where the JSON says `matches: "typing-exempt"`
.decl n802_typing_exempt(n: node)
n802_typing_exempt(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), n802_set_1(q1).
n802_typing_exempt(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    n802_typing_exempt(c2).

// visitor_base(n): the JSON util `visitor-base`, used where the JSON says `matches: "visitor-base"`
.decl n802_visitor_base(n: node)
n802_visitor_base(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (sym_of(n, "ast.NodeVisitor") ; sym_of(n, "ast.NodeTransformer")).
n802_visitor_base(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    n802_visitor_base(c1).

// handler_base(n): the JSON util `handler-base`, used where the JSON says `matches: "handler-base"`
.decl n802_handler_base(n: node)
n802_handler_base(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "http.server.BaseHTTPRequestHandler")
    ; sym_of(n, "http.server.CGIHTTPRequestHandler")
    ; sym_of(n, "http.server.SimpleHTTPRequestHandler")
    ).

n802_handler_base(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    n802_handler_base(c1).

// direct_method(n): the JSON util `direct-method`, used where the JSON says `matches: "direct-method"`
.decl n802_direct_method(n: node)
n802_direct_method(n) :- child(p1, n, _), kind(p1, "block"), child(p2, p1, _),
    kind(p2, "class_definition").
n802_direct_method(n) :- child(p3, n, _), kind(p3, "decorated_definition"),
    child(p4, p3, _), kind(p4, "block"), child(p5, p4, _),
    kind(p5, "class_definition").

// bad_function_name(n): the JSON util `bad-function-name`, used where the JSON says `matches: "bad-function-name"`
//   NAME: metavariable this relation binds for the calling rule
.decl n802_bad_function_name(n: node, name: loc)
n802_bad_function_name(n, NAME) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n,
    match(".*[\\x{149}\\x{2E4}\\x{1D2C}-\\x{1D2E}\\x{1D30}-\\x{1D3A}\\x{1D3C}-\\x{1D42}\\x{1E9A}\\x{2C7D}\\x{A7F1}-\\x{A7F4}\\x{A7F8}\\x{107B6}-\\x{107B9}[\\p{Alphabetic}--\\p{Lowercase}--\\x{FF9E}--\\x{FF9F}]].*", n),
    !n802_alt_3(n), field(p5, "name", n), kind(p5, "function_definition"),
    count : { child(p6, p5, _), kind(p6, "decorated_definition"), child(p6, c7, _), kind(c7, "decorator"), child(c7, c8, _), n802_typing_exempt(c8) } = 0.

// visitor_class(n): the JSON util `visitor-class`, used where the JSON says `matches: "visitor-class"`
.decl n802_visitor_class(n: node)
n802_visitor_class(n) :- n802_demand_visitor_class(n), kind(n, "class_definition"),
    child(n, c1, _), kind(c1, "argument_list"), child(c1, c2, _), n802_alt_5(c2).

// local_visitor(n): the JSON util `local-visitor`, used where the JSON says `matches: "local-visitor"`
.decl n802_local_visitor(n: node)
n802_local_visitor(n) :- n802_demand_local_visitor(n), kind(n, "identifier"), ref_site(n, b1),
    n802_visitor_class(b1), (site_scope(b1, "module") ; site_scope(b1, "function")).
n802_local_visitor(n) :- n802_demand_local_visitor(n), n802_visitor_attr(n, P).
n802_local_visitor(n) :- n802_demand_local_visitor(n), kind(n, "subscript"),
    field(n, "value", c2), n802_local_visitor(c2).
n802_local_visitor(n) :- n802_demand_local_visitor(n), kind(n, "parenthesized_expression"),
    child(n, c3, _), n802_local_visitor(c3).

// handler_class(n): the JSON util `handler-class`, used where the JSON says `matches: "handler-class"`
.decl n802_handler_class(n: node)
n802_handler_class(n) :- n802_demand_handler_class(n), kind(n, "class_definition"),
    child(n, c1, _), kind(c1, "argument_list"), child(c1, c2, _), n802_alt_6(c2).

// local_handler(n): the JSON util `local-handler`, used where the JSON says `matches: "local-handler"`
.decl n802_local_handler(n: node)
n802_local_handler(n) :- n802_demand_local_handler(n), kind(n, "identifier"), ref_site(n, b1),
    n802_handler_class(b1), (site_scope(b1, "module") ; site_scope(b1, "function")).
n802_local_handler(n) :- n802_demand_local_handler(n), n802_handler_attr(n, P).
n802_local_handler(n) :- n802_demand_local_handler(n), kind(n, "subscript"),
    field(n, "value", c2), n802_local_handler(c2).
n802_local_handler(n) :- n802_demand_local_handler(n), kind(n, "parenthesized_expression"),
    child(n, c3, _), n802_local_handler(c3).

// visitor_attr(n, …): the JSON util `visitor-attr`, called with `matches` and arguments P
.decl n802_visitor_attr(n: node, p: node)
// P: not bound by this rule, so empty (unset) here, as in ast-grep.
n802_visitor_attr(n, P) :- n802_demand_visitor_attr(n), kind(n, "attribute"),
    field(n, "attribute", c1), node(_, c1, _, _, _), A = c1, field(n, "object", c2),
    kind(c2, "identifier"), ref_site(c2, b3),
    (site_scope(b3, "module") ; site_scope(b3, "function")),
    kind(b3, "class_definition"), field(b3, "body", c4), within_stop(c5, c4, n802_stop_7),
    kind(c5, "class_definition"), n802_visitor_class(c5), field(c5, "name", c6), node(_, c6, _, _, _), A = c6,
    unset(P).

// handler_attr(n, …): the JSON util `handler-attr`, called with `matches` and arguments P
.decl n802_handler_attr(n: node, p: node)
// P: not bound by this rule, so empty (unset) here, as in ast-grep.
n802_handler_attr(n, P) :- n802_demand_handler_attr(n), kind(n, "attribute"),
    field(n, "attribute", c1), node(_, c1, _, _, _), A = c1, field(n, "object", c2),
    kind(c2, "identifier"), ref_site(c2, b3),
    (site_scope(b3, "module") ; site_scope(b3, "function")),
    kind(b3, "class_definition"), field(b3, "body", c4), within_stop(c5, c4, n802_stop_7),
    kind(c5, "class_definition"), n802_handler_class(c5), field(c5, "name", c6), node(_, c6, _, _, _), A = c6,
    unset(P).

// N802(n): a finding at node n, from clause `invalid-method-name`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation N802(at: node, name: loc) "Rename method `{name}` to lowercase snake_case and update its callers; if it overrides a superclass method, decorate it with `@typing.override` instead."
    suppress noqa "N802"
N802(n, NAME) :- n802_bad_function_name(n, NAME), field(p1, "name", n),
    kind(p1, "function_definition"), n802_direct_method(p1).

// N802_invalid_function_name(n): a finding at node n, from clause `invalid-function-name`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation N802_invalid_function_name(at: node, name: loc) code "N802" "Rename function `{name}` to lowercase snake_case, such as `my_function`, and update its callers; keep the name if code outside this project calls it."
    suppress noqa "N802"
N802_invalid_function_name(n, NAME) :- n802_bad_function_name(n, NAME),
    count : { field(p1, "name", n), kind(p1, "function_definition"), n802_direct_method(p1) } = 0.

// demand_alt_3: the rows of alt_3 its callers ask for (the metavariable columns they pass in)
.decl n802_demand_alt_3(n: node)
n802_demand_alt_3(n) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n,
    match(".*[\\x{149}\\x{2E4}\\x{1D2C}-\\x{1D2E}\\x{1D30}-\\x{1D3A}\\x{1D3C}-\\x{1D42}\\x{1E9A}\\x{2C7D}\\x{A7F1}-\\x{A7F4}\\x{A7F8}\\x{107B6}-\\x{107B9}[\\p{Alphabetic}--\\p{Lowercase}--\\x{FF9E}--\\x{FF9F}]].*", n),
    field(p5, "name", n), kind(p5, "function_definition").

// demand_alt_5: the nodes alt_5 is asked at (its recursion looks at every descendant)
.decl n802_demand_alt_5(n: node)
n802_demand_alt_5(c2) :- n802_demand_visitor_class(n), kind(n, "class_definition"),
    child(n, c1, _), kind(c1, "argument_list"), child(c1, c2, _).

// demand_local_visitor: the nodes local_visitor is asked at (its recursion looks at every descendant)
.decl n802_demand_local_visitor(n: node)
n802_demand_local_visitor(c2) :- n802_demand_local_visitor(n), kind(n, "subscript"),
    field(n, "value", c2).
n802_demand_local_visitor(c3) :- n802_demand_local_visitor(n),
    kind(n, "parenthesized_expression"), child(n, c3, _).
n802_demand_local_visitor(n) :- n802_demand_alt_5(n).

// demand_visitor_attr: the nodes visitor_attr is asked at (its recursion looks at every descendant)
.decl n802_demand_visitor_attr(n: node)
n802_demand_visitor_attr(n) :- n802_demand_local_visitor(n).

// demand_visitor_class: the nodes visitor_class is asked at (its recursion looks at every descendant)
.decl n802_demand_visitor_class(n: node)
n802_demand_visitor_class(b1) :- n802_demand_local_visitor(n), kind(n, "identifier"),
    ref_site(n, b1), (site_scope(b1, "module") ; site_scope(b1, "function")).
n802_demand_visitor_class(c5) :- n802_demand_visitor_attr(n), kind(n, "attribute"),
    field(n, "attribute", c1), node(_, c1, _, _, _), A = c1, field(n, "object", c2),
    kind(c2, "identifier"), ref_site(c2, b3),
    (site_scope(b3, "module") ; site_scope(b3, "function")),
    kind(b3, "class_definition"), field(b3, "body", c4), within_stop(c5, c4, n802_stop_7),
    kind(c5, "class_definition"), field(c5, "name", c6), node(_, c6, _, _, _), A = c6.
n802_demand_visitor_class(p2) :- n802_demand_alt_3(n), glob("{visit,do}_**", n), prefix("v", n),
    field(p1, "name", n), kind(p1, "function_definition"), n802_direct_method(p1),
    within_stop(p1, p2, "class_definition").

// demand_alt_6: the nodes alt_6 is asked at (its recursion looks at every descendant)
.decl n802_demand_alt_6(n: node)
n802_demand_alt_6(c2) :- n802_demand_handler_class(n), kind(n, "class_definition"),
    child(n, c1, _), kind(c1, "argument_list"), child(c1, c2, _).

// demand_handler_attr: the nodes handler_attr is asked at (its recursion looks at every descendant)
.decl n802_demand_handler_attr(n: node)
n802_demand_handler_attr(n) :- n802_demand_local_handler(n).

// demand_handler_class: the nodes handler_class is asked at (its recursion looks at every descendant)
.decl n802_demand_handler_class(n: node)
n802_demand_handler_class(b1) :- n802_demand_local_handler(n), kind(n, "identifier"),
    ref_site(n, b1), (site_scope(b1, "module") ; site_scope(b1, "function")).
n802_demand_handler_class(c5) :- n802_demand_handler_attr(n), kind(n, "attribute"),
    field(n, "attribute", c1), node(_, c1, _, _, _), A = c1, field(n, "object", c2),
    kind(c2, "identifier"), ref_site(c2, b3),
    (site_scope(b3, "module") ; site_scope(b3, "function")),
    kind(b3, "class_definition"), field(b3, "body", c4), within_stop(c5, c4, n802_stop_7),
    kind(c5, "class_definition"), field(c5, "name", c6), node(_, c6, _, _, _), A = c6.
n802_demand_handler_class(p4) :- n802_demand_alt_3(n), glob("{visit,do}_**", n), prefix("d", n),
    field(p3, "name", n), kind(p3, "function_definition"), n802_direct_method(p3),
    within_stop(p3, p4, "class_definition").

// demand_local_handler: the nodes local_handler is asked at (its recursion looks at every descendant)
.decl n802_demand_local_handler(n: node)
n802_demand_local_handler(c2) :- n802_demand_local_handler(n), kind(n, "subscript"),
    field(n, "value", c2).
n802_demand_local_handler(c3) :- n802_demand_local_handler(n),
    kind(n, "parenthesized_expression"), child(n, c3, _).
n802_demand_local_handler(n) :- n802_demand_alt_6(n).

// set_1: symbols from the JSON `resolves.import`
.decl n802_set_1(v: symbol)
n802_set_1("typing.override"). n802_set_1("typing_extensions.override").
n802_set_1("_typeshed.override"). n802_set_1("typing.overload").
n802_set_1("typing_extensions.overload"). n802_set_1("_typeshed.overload").

// stop_7: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl n802_stop_7(kind: symbol)
n802_stop_7("function_definition"). n802_stop_7("class_definition").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl n802_alt_3(n: node)
n802_alt_3(n) :- n802_demand_alt_3(n),
    glob("{setUp,tearDown,setUpClass,tearDownClass,setUpModule,tearDownModule,asyncSetUp,asyncTearDown,setUpTestData,failureException,longMessage,maxDiff}", n).
n802_alt_3(n) :- n802_demand_alt_3(n), glob("{visit,do}_**", n),
    ( prefix("v", n), field(p1, "name", n), kind(p1, "function_definition"), n802_direct_method(p1), within_stop(p1, p2, "class_definition"), n802_visitor_class(p2)
    ; prefix("d", n), field(p3, "name", n), kind(p3, "function_definition"), n802_direct_method(p3), within_stop(p3, p4, "class_definition"), n802_handler_class(p4)
    ).


// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl n802_alt_5(n: node)
n802_alt_5(n) :- n802_demand_alt_5(n), n802_visitor_base(n).
n802_alt_5(n) :- n802_demand_alt_5(n), n802_local_visitor(n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl n802_alt_6(n: node)
n802_alt_6(n) :- n802_demand_alt_6(n), n802_handler_base(n).
n802_alt_6(n) :- n802_demand_alt_6(n), n802_local_handler(n).
