.policy "ruff-log007-exception-without-exc-info" revision 1
.guests off
.description "Use error instead of exception when a logging call sets exc_info to a falsy value; it logs the same message and states the intent plainly."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// LOG007(n): a finding at node n, from clause `exception-without-exc-info`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation LOG007(at: node, c: node) "Call `error` instead of `exception` and drop the falsy `exc_info` argument: the log output is the same and the intent is clearer."
    suppress noqa "LOG007"
LOG007(C, n) :- log007_bad_call(n), node(_, n, _, _, _), C = n.
LOG007(C, n) :- log007_call_in_string(n, C).

// logger_object(n): the JSON util `logger-object`, used where the JSON says `matches: "logger-object"`
.decl log007_logger_object(n: node)
log007_logger_object(n) :- kind(n, "call"), child(n, c1, _),
    (sym_of(c1, "logging.getLogger") ; sym_of(c1, "logging.Logger")).
log007_logger_object(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    log007_logger_object(c2).
log007_logger_object(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (sym_of(n, "logging") ; sym_of(n, "flask.current_app.logger")).
log007_logger_object(n) :-
    ( kind(n, "identifier"), match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", n)
    ; kind(n, "attribute"), match(".*(?:\\W(log|LOG)\\w*|(logger|logging|LOGGER|LOGGING))", n), child(n, c1, _), log007_name_chain(c1), !log007_tok_follows_2(c1)
    ),
    !sym_of(n, _).

// name_chain(n): the JSON util `name-chain`, used where the JSON says `matches: "name-chain"`
.decl log007_name_chain(n: node)
log007_name_chain(n) :- kind(n, "identifier").
log007_name_chain(n) :- kind(n, "attribute"), child(n, c1, _), log007_name_chain(c1),
    !log007_tok_follows_2(c1).
log007_name_chain(n) :- kind(n, "parenthesized_expression"), child(n, c9, _), log007_name_chain(c9).

// exception_callee(n): the JSON util `exception-callee`, used where the JSON says `matches: "exception-callee"`
.decl log007_exception_callee(n: node)
log007_exception_callee(n) :- kind(n, "attribute"), match(".*\\Wexception", n),
    child(n, c1, _), log007_logger_object(c1), !log007_tok_follows_2(c1).
log007_exception_callee(n) :- kind(n, "identifier"), sym_of(n, "logging.exception").
log007_exception_callee(n) :- kind(n, "parenthesized_expression"), child(n, c9, _),
    log007_exception_callee(c9).

// filler(n): the JSON util `filler`, used where the JSON says `matches: "filler"`
.decl log007_filler(n: node)
log007_filler(n) :- node(_, n, _, _, _), glob("[\\[\\](){},]", n).
log007_filler(n) :- kind(n, "comment").

// iterable_builtin(n): the JSON util `iterable-builtin`, used where the JSON says `matches: "iterable-builtin"`
.decl log007_iterable_builtin(n: node)
log007_iterable_builtin(n) :- kind(n, "identifier"), global_ref(n, g1), log007_set_2(g1).
log007_iterable_builtin(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    log007_iterable_builtin(c2).

// empty_part(n): the JSON util `empty-part`, used where the JSON says `matches: "empty-part"`
.decl log007_empty_part(n: node)
log007_empty_part(n) :- kind(n, "string"),
    (value(n, v1), log007_truthy_value(n, "false") ; log007_f_empty(n)).

// f_string(n): the JSON util `f-string`, used where the JSON says `matches: "f-string"`
.decl log007_f_string(n: node)
log007_f_string(n) :- kind(n, "string"), child(n, c1, _), kind(c1, "string_start"),
    match("[A-Za-z]*[fF].*", c1).

