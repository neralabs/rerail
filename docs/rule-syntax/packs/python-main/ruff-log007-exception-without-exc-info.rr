    count : { child(n, c2, _), !log007_filler(c2) } = 0.
log007_falsy_iterable_u0(n) :- kind(n, "call"), child(n, c3, _), log007_iterable_builtin(c3),
    child(n, c4, _), kind(c4, "argument_list"),
    k6 = count : { child(c4, c5, _), !log007_filler(c5) }, k6 <= 1,
    count : { child(c4, c7, _) } = 0.

.decl log007_falsy_iterable_u1(n: node)
log007_falsy_iterable_u1(n) :- log007_empty_part(n).
log007_falsy_iterable_u1(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), !log007_empty_part(c1) } = 0.
log007_falsy_iterable_u1(n) :- (kind(n, "list") ; kind(n, "tuple") ; kind(n, "dictionary")),
    count : { child(n, c2, _), !log007_filler(c2) } = 0.
