    child(n, c4, _), kind(c4, "argument_list"),
    k6 = count : { child(c4, c5, _), !log007_filler(c5) }, k6 <= 1,
    count : { child(c4, c7, _), !log007_alt_11_u0(c7) } = 0.
log007_falsy_iterable_u1(n) :- kind(n, "parenthesized_expression"), child(n, c8, _),
    log007_falsy_iterable_u0(c8).

