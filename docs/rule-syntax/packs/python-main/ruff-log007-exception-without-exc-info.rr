// set_2: names from the JSON `resolves.global`
.decl log007_set_2(v: symbol)
log007_set_2("list"). log007_set_2("tuple"). log007_set_2("set"). log007_set_2("dict"). log007_set_2("frozenset").

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl log007_alt_4(n: node)
log007_alt_4(n) :- log007_alt_4_u7(n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl log007_alt_6(n: node)
log007_alt_6(n) :- log007_alt_6_u7(n).

// alt_9(n): the JSON `any`: n matches if any one of these rules does
.decl log007_alt_9(n: node)
log007_alt_9(n) :- (kind(n, "type_conversion") ; kind(n, "format_specifier")).
log007_alt_9(n) :- node(_, n, _, _, _), glob("=", n).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl log007_alt_11(n: node)
log007_alt_11(n) :- log007_alt_11_u7(n).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl log007_alt_12(n: node, c: loc)
log007_alt_12(n, C) :- log007_bad_call(n), C = n.
log007_alt_12(n, C) :- log007_call_in_string(n, C).
