// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl log007_tok_follows_1(n: node)
.stored log007_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
log007_tok_follows_1(n) :- next_sibling(s4, n), match("(?s).*..*", s4).
log007_tok_follows_1(n) :- structural_before(n, g6), match("\\s*", g6), child(p7, n, _),
    node(_, n, _, st9, _), o8 = st9 - strlen(g6), token(p7, _, t5, _, o8),
    match("(?s).*..*", t5).
log007_tok_follows_1(n) :- structural_before(n, g6), match("(?s)^.*\\S\\s*$", g6).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl log007_tok_follows_2(n: node)
.stored log007_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
log007_tok_follows_2(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
log007_tok_follows_2(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
log007_tok_follows_2(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// truthy_value: b is "true" when n's value is truthy (Python's bool(v)), "false" when it is falsy
.decl log007_truthy_value(n: node, b: symbol)
log007_truthy_value(n, "false") :- value(n, x), value_type(x, "NoneType").
log007_truthy_value(n, b) :- value(n, x), value_type(x, "boolean"), b = x.
log007_truthy_value(n, "false") :- value(n, x),
    (value_type(x, "int") ; value_type(x, "float")),
    (x = "0" ; x = "0.0" ; x = "-0.0").
log007_truthy_value(n, "true") :- value(n, x),
    (value_type(x, "int") ; value_type(x, "float")), x != "0", x != "0.0", x != "-0.0".
log007_truthy_value(n, "false") :- value(n, x),
    (value_type(x, "str") ; value_type(x, "bytes")), x = "".
log007_truthy_value(n, "true") :- value(n, x),
    (value_type(x, "str") ; value_type(x, "bytes")), x != "".

// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\{$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl log007_tok_follows_3(n: node)
.stored log007_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
log007_tok_follows_3(n) :- next_sibling(s3, n), glob("\\{", s3).
log007_tok_follows_3(n) :- structural_before(n, g5), match("\\s*", g5), child(p6, n, _),
    node(_, n, _, st8, _), o7 = st8 - strlen(g5), token(p6, _, t4, _, o7),
    match("\\{", t4).
log007_tok_follows_3(n) :- structural_before(n, g5), match("(?s)^(?:.*(?:\\{)\\s*)$", g5).

// alt_4_u0_empty: level -1 of an unrolled recursion, empty
.decl log007_alt_4_u0_empty(n: node)

