pyi053_set_3("collections.abc.ValuesView"). pyi053_set_3("contextlib.AbstractAsyncContextManager").
pyi053_set_3("contextlib.AbstractContextManager"). pyi053_set_3("re.Match"). pyi053_set_3("re.Pattern").
pyi053_set_3("weakref.WeakKeyDictionary"). pyi053_set_3("weakref.WeakSet").
pyi053_set_3("weakref.WeakValueDictionary").

// set_19: symbols from the JSON `resolves.import`
.decl pyi053_set_19(v: symbol)
pyi053_set_19("mypy_extensions.Arg"). pyi053_set_19("mypy_extensions.DefaultArg").
pyi053_set_19("mypy_extensions.NamedArg"). pyi053_set_19("mypy_extensions.DefaultNamedArg").
pyi053_set_19("mypy_extensions.VarArg"). pyi053_set_19("mypy_extensions.KwArg").

// ref_of_case: one row per relation folded into ref_of: its key, then the strings that differed.
.decl pyi053_ref_of_case(key: symbol, s1: symbol, s2: symbol, s3: symbol)
pyi053_ref_of_case("alias", "typing.TypeAlias", "typing_extensions.TypeAlias", "_typeshed.TypeAlias").
pyi053_ref_of_case("aliastype", "typing.TypeAliasType", "typing_extensions.TypeAliasType", "_typeshed.TypeAliasType").
pyi053_ref_of_case("cast", "typing.cast", "typing_extensions.cast", "_typeshed.cast").
pyi053_ref_of_case("namedtuple", "typing.NamedTuple", "typing_extensions.NamedTuple", "_typeshed.NamedTuple").
pyi053_ref_of_case("newtype", "typing.NewType", "typing_extensions.NewType", "_typeshed.NewType").
pyi053_ref_of_case("typeddict", "typing.TypedDict", "typing_extensions.TypedDict", "_typeshed.TypedDict").
pyi053_ref_of_case("typeform", "typing.TypeForm", "typing_extensions.TypeForm", "_typeshed.TypeForm").
pyi053_ref_of_case("typevar", "typing.TypeVar", "typing_extensions.TypeVar", "_typeshed.TypeVar").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pyi053_alt_1(n: node)
pyi053_alt_1(n) :- node(_, n, _, _, _),
    match("(?:[bB]\"(?:\\\\\\r?\\n)*(?:(?:[^\\\\\"]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))(?:\\\\\\r?\\n)*){51,}\"|(?:[bB][rR]|[rR][bB])\"(?:[^\\\\\"]|\\\\\"?){51,}\"|[bB]\"\"\"(?:\\\\\\r?\\n)*(?:(?:[^\\\\]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))(?:\\\\\\r?\\n)*){51,}\"\"\"|(?:[bB][rR]|[rR][bB])\"\"\"(?:[^\\\\]|\\\\\"?){51,}\"\"\"|[bB]'(?:\\\\\\r?\\n)*(?:(?:[^\\\\']|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))(?:\\\\\\r?\\n)*){51,}'|(?:[bB][rR]|[rR][bB])'(?:[^\\\\']|\\\\'?){51,}'|[bB]'''(?:\\\\\\r?\\n)*(?:(?:[^\\\\]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))(?:\\\\\\r?\\n)*){51,}'''|(?:[bB][rR]|[rR][bB])'''(?:[^\\\\]|\\\\'?){51,}''')", n).
pyi053_alt_1(n) :- match("(?:[fF]\"(?:\\\\\\r?\\n)*(?:(?:[^\\\\\"]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))(?:\\\\\\r?\\n)*){51,}\"|(?:[fF][rR]|[rR][fF])\"(?:[^\\\\\"]|\\\\\"?){51,}\"|[fF]\"\"\"(?:\\\\\\r?\\n)*(?:(?:[^\\\\]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))(?:\\\\\\r?\\n)*){51,}\"\"\"|(?:[fF][rR]|[rR][fF])\"\"\"(?:[^\\\\]|\\\\\"?){51,}\"\"\"|[fF]'(?:\\\\\\r?\\n)*(?:(?:[^\\\\']|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))(?:\\\\\\r?\\n)*){51,}'|(?:[fF][rR]|[rR][fF])'(?:[^\\\\']|\\\\'?){51,}'|[fF]'''(?:\\\\\\r?\\n)*(?:(?:[^\\\\]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))(?:\\\\\\r?\\n)*){51,}'''|(?:[fF][rR]|[rR][fF])'''(?:[^\\\\]|\\\\'?){51,}''')", n),
    has(n, c1, "interpolation").
pyi053_alt_1(n) :- value(n, v2), match("[\\s\\S]{51}.*", v2),
    !match("[a-zA-Z]*[tT][a-zA-Z]*['\"].*", n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pyi053_alt_2(n: node)
pyi053_alt_2(n) :- value(n, v1), match("[\\s\\S]{51}.*", v1).
pyi053_alt_2(n) :- child(n, c2, _), pyi053_long_part(c2).
pyi053_alt_2(n) :- node(_, n, _, _, _),
    match("(?:[bB][rR]?|[rR][bB])[\\\"'](?:(?:[\\\"'][ \\t\\f\\r\\n]*(?:(?:#[^\\r\\n]*|\\\\)\\r?\\n[ \\t\\f\\r\\n]*)*(?:[bB][rR]?|[rR][bB])[\\\"']|\\\\\\r?\\n)*(?:[^\\\\\\\"']|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))){51,}(?:[\\\"'][ \\t\\f\\r\\n]*(?:(?:#[^\\r\\n]*|\\\\)\\r?\\n[ \\t\\f\\r\\n]*)*(?:[bB][rR]?|[rR][bB])[\\\"']|\\\\\\r?\\n)*[\\\"']", n).
pyi053_alt_2(n) :- match("[fFuU]?[\\\"'](?:(?:[\\\"'][ \\t\\f\\r\\n]*(?:(?:#[^\\r\\n]*|\\\\)\\r?\\n[ \\t\\f\\r\\n]*)*[fFuU]?[\\\"']|\\\\\\r?\\n)*(?:[^\\\\\\\"']|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))){51,}(?:[\\\"'][ \\t\\f\\r\\n]*(?:(?:#[^\\r\\n]*|\\\\)\\r?\\n[ \\t\\f\\r\\n]*)*[fFuU]?[\\\"']|\\\\\\r?\\n)*[\\\"']", n),
    has(n, c3, "interpolation").

// counted(n): 8 identical copies of one rule set (`counted_10`, `counted_11`, `counted_4` and 5 more), folded into one.
.decl pyi053_counted(n: node)
pyi053_counted(n) :- node(_, n, _, _, _), !kind(n, "comment").

// stop_12(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi053_stop_12(n: node)
pyi053_stop_12(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// stop_13(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi053_stop_13(n: node)
pyi053_stop_13(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression"),
    !kind(n, "keyword_argument").

// counted_14(n): the siblings the JSON `nthChild.ofRule` counts
.decl pyi053_counted_14(n: node)
pyi053_counted_14(n) :- kind(n, "for_in_clause").

// alt_15(n): the JSON `any`: n matches if any one of these rules does
.decl pyi053_alt_15(n: node)
pyi053_alt_15(n) :- pyi053_long_literal(n).
pyi053_alt_15(n) :- within(c1, n), pyi053_long_literal(c1).

// counted_17(n): the siblings the JSON `nthChild.ofRule` counts
.decl pyi053_counted_17(n: node)
pyi053_counted_17(n) :- kind(n, "for_in_clause").

// alt_16(n): the JSON `any`: n matches if any one of these rules does
.decl pyi053_alt_16(n: node)
pyi053_alt_16(n) :- (kind(n, "class_definition") ; kind(n, "function_definition") ; kind(n, "lambda")).
pyi053_alt_16(n) :-
    ( kind(n, "list_comprehension")
    ; kind(n, "set_comprehension")
    ; kind(n, "dictionary_comprehension")
    ; kind(n, "generator_expression")
    ),

    count : { child(n, c1, _), kind(c1, "for_in_clause"), child(p2, c1, _), pyi053_counted_17(c1), k4 = count : { child(p2, s3, _), precedes(s3, c1), pyi053_counted_17(s3) }, k4 = 0, field(c1, "right", c5), pyi053_alt_15(c5) } = 0.

// counted_of(n): 6 identical copies of one rule set (`counted_20`, `counted_21`, `counted_22` and 3 more), folded into one.
.decl pyi053_counted_of(n: node)
pyi053_counted_of(n) :- node(_, n, _, _, _), !kind(n, "comment"),
    !kind(n, "keyword_argument"), !kind(n, "dictionary_splat").

// alt_24(n): the JSON `any`: n matches if any one of these rules does
.decl pyi053_alt_24(n: node)
pyi053_alt_24(n) :- child(n, c1, _), child(p2, c1, _), pyi053_counted_of(c1),
    k4 = count : { child(p2, s3, _), precedes(s3, c1), pyi053_counted_of(s3) }, k4 = 1,
    !kind(c1, "none").
pyi053_alt_24(n) :- child(n, c5, _), child(p6, c5, _), pyi053_counted_of(c5),
    k8 = count : { child(p6, s7, _), precedes(s7, c5), pyi053_counted_of(s7) }, k8 = 2.

// main's file condition {"regex": "\\.pyi$"}
.decl PYI053_raw(at: node)
PYI053(v0) :- PYI053_raw(v0), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).
