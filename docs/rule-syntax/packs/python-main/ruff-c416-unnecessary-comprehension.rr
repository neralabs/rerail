// demand_fn_body: the nodes fn_body is asked at (it looks at every ancestor of every node)
.decl c416_demand_fn_body(n: node)
c416_demand_fn_body(n) :- node(_, KN, _, _, _),
    c416_demand_list_comprehension_in_annotation(n, W),
    (kind(n, "string") ; kind(n, "concatenated_string")), parsed(n, "annotation", r1),
    within(c2, r1), inside(n, p1_28, "module"), within(c2_28, p1_28),
    (kind(c2_28, "identifier") ; kind(c2_28, "dotted_name")), node(_, c2_28, _, _, _), BN = c2_28,
    text(BN, t1_7_28), text(KN, t1_7_28), site_scope(c2_28, "module").
c416_demand_fn_body(n) :- node(_, KN, _, _, _),
    c416_demand_set_comprehension_in_annotation(n, W),
    (kind(n, "string") ; kind(n, "concatenated_string")), parsed(n, "annotation", r1),
    within(c2, r1), inside(n, p1_40, "module"), within(c2_40, p1_40),
    (kind(c2_40, "identifier") ; kind(c2_40, "dotted_name")), node(_, c2_40, _, _, _), BN = c2_40,
    text(BN, t1_7_40), text(KN, t1_7_40), site_scope(c2_40, "module").
