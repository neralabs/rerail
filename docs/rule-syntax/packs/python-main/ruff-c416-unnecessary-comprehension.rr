c416_tok_follows_1(n) :- next_sibling(s3, n), glob(":=", s3).
c416_tok_follows_1(n) :- structural_before(n, g5), match("\\s*", g5), child(p6, n, _),
    node(_, n, _, st8, _), o7 = st8 - strlen(g5), token(p6, _, t4, _, o7),
    match(":=", t4).
c416_tok_follows_1(n) :- structural_before(n, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::=)\\s*)$", g5).

