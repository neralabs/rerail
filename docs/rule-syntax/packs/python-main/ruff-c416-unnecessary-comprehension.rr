// stop_15: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl c416_stop_15(kind: symbol)
c416_stop_15("function_definition"). c416_stop_15("lambda").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_1(n: node)
c416_alt_1(n) :- c416_alt_1_u7(n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_3(n: node)
c416_alt_3(n) :- ref_site(n, b1), (st2 = b1 ; within(b1, st2)),
    ( kind(st2, "dictionary_splat_pattern"), child(p1, st2, _), kind(p1, "parameters")
    ; kind(st2, "typed_parameter"), child(p2, st2, _), kind(p2, "parameters"), child(st2, c1, _), kind(c1, "dictionary_splat_pattern")
    ).

c416_alt_3(n) :- ref_site(n, b6), binding_value(b6, x7), c416_dict_init(x7),
    (st8 = b6 ; within(b6, st8)), count : { child(st8, c9, _), kind(c9, "type") } = 0.
c416_alt_3(n) :- ref_site(n, b10), (st11 = b10 ; within(b10, st11)),
    kind(st11, "as_pattern"), child(p12, st11, _), kind(p12, "with_item"),
    child(st11, c13, _), c416_dict_init(c13), c416_tok_precedes_5(c13), child(st11, c21, _),
    kind(c21, "as_pattern_target"), child(c21, c22, _), c416_plain_target(c22).
c416_alt_3(n) :- ref_site(n, b23), site_annotation(b23, o24), c416_dict_ann(o24),
    (st25 = b23 ; within(b23, st25)),
    count : { child(st25, c26, _), (kind(c26, "list_splat_pattern") ; kind(c26, "dictionary_splat_pattern")) } = 0.
c416_alt_3(n) :- ref_site(n, b27), (st28 = b27 ; within(b27, st28)),
    kind(st28, "function_definition"), child(st28, c29, _), kind(c29, "type"),
    child(c29, c30, _), c416_dict_ann(c30).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
