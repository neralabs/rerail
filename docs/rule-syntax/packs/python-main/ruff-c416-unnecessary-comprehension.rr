.decl c416_name_elt(n: node, e: loc)
c416_name_elt(n, E) :- kind(n, "identifier"), node(_, n, _, _, _), E = n.
c416_name_elt(n, E) :- kind(n, "parenthesized_expression"), child(n, c1, _),
