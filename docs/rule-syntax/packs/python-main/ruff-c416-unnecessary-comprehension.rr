    field(c4_5, "left", c5_5), c416_target_tuple_pair(c5_5, TK, TV), text(EK, t6_5),
    text(TK, t6_5), text(EV, t8_5), text(TV, t8_5), node(_, n, _, _, _), COMP = n,
