.decl c416_target_tuple_pair(n: node, tk: loc, tv: loc)
c416_target_tuple_pair(n, TK, TV) :- (kind(n, "pattern_list") ; kind(n, "tuple_pattern")),
    k2 = count : { child(n, c1, _), !c416_alt_5(c1) }, k2 >= 2, k2 <= 2,
    count : { child(n, c3, _), !c416_alt_6(c3) } = 0, child(n, c4, _), c416_tgt_key(c4, TK),
    precedes(c4, s5), c416_tgt_value(s5, TV).
c416_target_tuple_pair(n, TK, TV) :- kind(n, "tuple_pattern"), !c416_tok_has_7(n),
    child(n, c14, _), c416_target_tuple_pair(c14, TK, TV).

// tuple_pair(n): the JSON util `tuple-pair`, used where the JSON says `matches: "tuple-pair"`
//   EK, EV: metavariables this relation binds for the calling rule
.decl c416_tuple_pair(n: node, ek: loc, ev: loc)
c416_tuple_pair(n, EK, EV) :- kind(n, "tuple"),
    k2 = count : { child(n, c1, _), !c416_alt_5(c1) }, k2 >= 2, k2 <= 2,
    count : { child(n, c3, _), !c416_alt_10(c3) } = 0, child(n, c4, _), c416_name_key(c4, EK),
    precedes(c4, s5), c416_name_value(s5, EV).
c416_tuple_pair(n, EK, EV) :- kind(n, "parenthesized_expression"), child(n, c6, _),
