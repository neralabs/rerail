    within(c2, r1), inside(n, p1_52, "module"), within(c2_52, p1_52),
    (kind(c2_52, "identifier") ; kind(c2_52, "dotted_name")), node(_, c2_52, _, _, _), BN = c2_52,
    text(BN, t1_7_52), text(KN, t1_7_52), site_scope(c2_52, "module").
c416_demand_fn_body(n) :- c416_demand_alt_17(n, W), kind(n, "list_comprehension"),
    c416_single_for(n, IT),
    ( field(n, "body", c1_1_26), c416_name_elt(c1_1_26, E), child(n, c2_1_26, _), kind(c2_1_26, "for_in_clause"), field(c2_1_26, "left", c3_1_26), c416_name_tgt(c3_1_26, T), text(E, t4_1_26), text(T, t4_1_26), @doc(E) = @doc(T) ; child(n, c6_2_26, _), kind(c6_2_26, "for_in_clause"), field(c6_2_26, "right", c7_2_26), c416_items_call(c7_2_26), field(c6_2_26, "left", c8_2_26), c416_target_pair(c8_2_26, TK, TV), field(n, "body", c9_2_26), c416_tuple_pair(c9_2_26, EK, EV), text(EK, t10_2_26), text(TK, t10_2_26), text(EV, t12_2_26), text(TV, t12_2_26), @doc(EK) = @doc(TK), @doc(EV) = @doc(TV) ),
    node(_, n, _, _, _), COMP = n, inside(n, p1_64, "module"), within(c2_64, p1_64),
    (kind(c2_64, "identifier") ; kind(c2_64, "dotted_name")), node(_, c2_64, _, _, _), BN = c2_64,
    text(BN, t1_7_64), text(w64_kn, t1_7_64), site_scope(c2_64, "module"), @doc(BN) = @doc(w64_kn).
c416_demand_fn_body(n) :- c416_demand_alt_19(n, W), kind(n, "set_comprehension"),
    c416_single_for(n, IT),
    ( field(n, "body", c1_3_27), c416_name_elt(c1_3_27, E), child(n, c2_3_27, _), kind(c2_3_27, "for_in_clause"), field(c2_3_27, "left", c3_3_27), c416_name_tgt(c3_3_27, T), text(E, t4_3_27), text(T, t4_3_27), @doc(E) = @doc(T) ; child(n, c6_4_27, _), kind(c6_4_27, "for_in_clause"), field(c6_4_27, "right", c7_4_27), c416_items_call(c7_4_27), field(c6_4_27, "left", c8_4_27), c416_target_pair(c8_4_27, TK, TV), field(n, "body", c9_4_27), c416_tuple_pair(c9_4_27, EK, EV), text(EK, t10_4_27), text(TK, t10_4_27), text(EV, t12_4_27), text(TV, t12_4_27), @doc(EK) = @doc(TK), @doc(EV) = @doc(TV) ),
    node(_, n, _, _, _), COMP = n, inside(n, p1_76, "module"), within(c2_76, p1_76),
