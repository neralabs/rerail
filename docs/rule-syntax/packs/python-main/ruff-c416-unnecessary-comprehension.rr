// any_pname(n): the JSON util `any-pname`, used where the JSON says `matches: "any-pname"`
.decl c416_any_pname(n: node)
c416_any_pname(n) :- kind(n, "identifier").
c416_any_pname(n) :- kind(n, "tuple_pattern"), !c416_tok_has_6(n), child(n, c9, _),
