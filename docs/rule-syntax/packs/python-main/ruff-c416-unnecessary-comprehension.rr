// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `transform` computes KN from other metavariables' text; its literals end each rule.
.violation C416_dict_comprehension(at: node, c416_comp: node, it: loc) code "C416" "Replace this comprehension with `dict({it})`; if `{it}` is a mapping whose keys are pairs, use `dict({it}.keys())`; keep it inside `__len__`, where `dict()` can recurse."
    suppress noqa "C416"
C416_dict_comprehension(COMP, n, IT) :- node(_, n, _, _, _), W = n, c416_alt_20(n, COMP, _, _, IT, KN, _, _),
    text(W, t1), KN = @replace_all(t1, "(?s)^.*$", "dict").

.decl c416_alt_1_u0(n: node)
c416_alt_1_u0(n) :- node(_, n, _, _, _), glob("{and,or}", n).
c416_alt_1_u0(n) :- kind(n, "comment").

.decl c416_alt_1_u1(n: node)
c416_alt_1_u1(n) :- node(_, n, _, _, _), glob("{and,or}", n).
c416_alt_1_u1(n) :- kind(n, "comment").
c416_alt_1_u1(n) :- c416_dict_expr_u0(n).

.decl c416_alt_1_u2(n: node)
c416_alt_1_u2(n) :- node(_, n, _, _, _), glob("{and,or}", n).
c416_alt_1_u2(n) :- kind(n, "comment").
c416_alt_1_u2(n) :- c416_dict_expr_u1(n).

.decl c416_alt_1_u3(n: node)
c416_alt_1_u3(n) :- node(_, n, _, _, _), glob("{and,or}", n).
c416_alt_1_u3(n) :- kind(n, "comment").
c416_alt_1_u3(n) :- c416_dict_expr_u2(n).

.decl c416_alt_1_u4(n: node)
c416_alt_1_u4(n) :- node(_, n, _, _, _), glob("{and,or}", n).
c416_alt_1_u4(n) :- kind(n, "comment").
c416_alt_1_u4(n) :- c416_dict_expr_u3(n).

.decl c416_alt_1_u5(n: node)
c416_alt_1_u5(n) :- node(_, n, _, _, _), glob("{and,or}", n).
c416_alt_1_u5(n) :- kind(n, "comment").
c416_alt_1_u5(n) :- c416_dict_expr_u4(n).

.decl c416_alt_1_u6(n: node)
c416_alt_1_u6(n) :- node(_, n, _, _, _), glob("{and,or}", n).
c416_alt_1_u6(n) :- kind(n, "comment").
c416_alt_1_u6(n) :- c416_dict_expr_u5(n).

.decl c416_alt_1_u7(n: node)
c416_alt_1_u7(n) :- node(_, n, _, _, _), glob("{and,or}", n).
c416_alt_1_u7(n) :- kind(n, "comment").
c416_alt_1_u7(n) :- c416_dict_expr_u6(n).

.decl c416_dict_expr_u0(n: node)
c416_dict_expr_u0(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
c416_dict_expr_u0(n) :- kind(n, "boolean_operator"), count : { child(n, c26, _) } = 0.

.decl c416_dict_expr_u1(n: node)
c416_dict_expr_u1(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
c416_dict_expr_u1(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_dict_expr_u0(c1).
c416_dict_expr_u1(n) :- kind(n, "named_expression"), child(n, c2, _), c416_tok_follows_1(c2),
    c416_dict_expr_u0(c2).
c416_dict_expr_u1(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    c416_tok_precedes_2(c10), c416_dict_expr_u0(c10), child(n, c18, _), c416_tok_follows_3(c18),
    c416_dict_expr_u0(c18).
c416_dict_expr_u1(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !c416_alt_1_u0(c26) } = 0.

.decl c416_dict_expr_u2(n: node)
c416_dict_expr_u2(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
c416_dict_expr_u2(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_dict_expr_u1(c1).
c416_dict_expr_u2(n) :- kind(n, "named_expression"), child(n, c2, _), c416_tok_follows_1(c2),
    c416_dict_expr_u1(c2).
c416_dict_expr_u2(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    c416_tok_precedes_2(c10), c416_dict_expr_u1(c10), child(n, c18, _), c416_tok_follows_3(c18),
    c416_dict_expr_u1(c18).
c416_dict_expr_u2(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !c416_alt_1_u1(c26) } = 0.

.decl c416_dict_expr_u3(n: node)
c416_dict_expr_u3(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
c416_dict_expr_u3(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_dict_expr_u2(c1).
c416_dict_expr_u3(n) :- kind(n, "named_expression"), child(n, c2, _), c416_tok_follows_1(c2),
    c416_dict_expr_u2(c2).
c416_dict_expr_u3(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    c416_tok_precedes_2(c10), c416_dict_expr_u2(c10), child(n, c18, _), c416_tok_follows_3(c18),
    c416_dict_expr_u2(c18).
c416_dict_expr_u3(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !c416_alt_1_u2(c26) } = 0.

.decl c416_dict_expr_u4(n: node)
c416_dict_expr_u4(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
c416_dict_expr_u4(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_dict_expr_u3(c1).
c416_dict_expr_u4(n) :- kind(n, "named_expression"), child(n, c2, _), c416_tok_follows_1(c2),
    c416_dict_expr_u3(c2).
c416_dict_expr_u4(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    c416_tok_precedes_2(c10), c416_dict_expr_u3(c10), child(n, c18, _), c416_tok_follows_3(c18),
    c416_dict_expr_u3(c18).
c416_dict_expr_u4(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !c416_alt_1_u3(c26) } = 0.

.decl c416_dict_expr_u5(n: node)
c416_dict_expr_u5(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
c416_dict_expr_u5(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_dict_expr_u4(c1).
c416_dict_expr_u5(n) :- kind(n, "named_expression"), child(n, c2, _), c416_tok_follows_1(c2),
    c416_dict_expr_u4(c2).
c416_dict_expr_u5(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    c416_tok_precedes_2(c10), c416_dict_expr_u4(c10), child(n, c18, _), c416_tok_follows_3(c18),
    c416_dict_expr_u4(c18).
c416_dict_expr_u5(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !c416_alt_1_u4(c26) } = 0.

.decl c416_dict_expr_u6(n: node)
c416_dict_expr_u6(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
c416_dict_expr_u6(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_dict_expr_u5(c1).
c416_dict_expr_u6(n) :- kind(n, "named_expression"), child(n, c2, _), c416_tok_follows_1(c2),
    c416_dict_expr_u5(c2).
c416_dict_expr_u6(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    c416_tok_precedes_2(c10), c416_dict_expr_u5(c10), child(n, c18, _), c416_tok_follows_3(c18),
    c416_dict_expr_u5(c18).
c416_dict_expr_u6(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !c416_alt_1_u5(c26) } = 0.

.decl c416_dict_expr_u7(n: node)
c416_dict_expr_u7(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
c416_dict_expr_u7(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_dict_expr_u6(c1).
c416_dict_expr_u7(n) :- kind(n, "named_expression"), child(n, c2, _), c416_tok_follows_1(c2),
    c416_dict_expr_u6(c2).
c416_dict_expr_u7(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    c416_tok_precedes_2(c10), c416_dict_expr_u6(c10), child(n, c18, _), c416_tok_follows_3(c18),
    c416_dict_expr_u6(c18).
c416_dict_expr_u7(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !c416_alt_1_u6(c26) } = 0.

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^:=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_follows_1(n: node)
.stored c416_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_follows_1(n) :- next_sibling(s3, n), glob(":=", s3).
c416_tok_follows_1(n) :- structural_before(n, g5), match("\\s*", g5), child(p6, n, _),
    node(_, n, _, st8, _), o7 = st8 - strlen(g5), token(p6, _, t4, _, o7),
    match(":=", t4).
c416_tok_follows_1(n) :- structural_before(n, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::=)\\s*)$", g5).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_precedes_2(n: node)
.stored c416_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_precedes_2(n) :- next_sibling(n, s11), glob("if", s11).
c416_tok_precedes_2(n) :- structural_after(n, g13), match("\\s*", g13), child(p14, n, _),
    node(_, n, _, _, en17), o15 = en17 + strlen(g13), token(p14, _, t12, o15, _),
    match("if", t12).
c416_tok_precedes_2(n) :- structural_after(n, g13),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g13).

// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_follows_3(n: node)
.stored c416_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_follows_3(n) :- next_sibling(s19, n), glob("else", s19).
c416_tok_follows_3(n) :- structural_before(n, g21), match("\\s*", g21), child(p22, n, _),
    node(_, n, _, st24, _), o23 = st24 - strlen(g21), token(p22, _, t20, _, o23),
    match("else", t20).
c416_tok_follows_3(n) :- structural_before(n, g21),
    match("(?s)^(?:(?:.*\\W)?(?:else)\\s*)$", g21).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_follows_4(n: node)
.stored c416_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_follows_4(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
c416_tok_follows_4(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
c416_tok_follows_4(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_precedes_5(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_precedes_5(n: node)
.stored c416_tok_precedes_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_precedes_5(n) :- precedes(n, s11), glob("as", s11).
c416_tok_precedes_5(n) :- child(p14, n, _), node(_, n, _, _, en17),
    token(p14, _, t12, st16, _), st16 >= en17, match("as", t12).
c416_tok_precedes_5(n) :- structural_after(n, g13),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g13).
c416_tok_precedes_5(n) :- precedes(n, o15), structural_after(o15, g13),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g13).

// tok_has_6(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_has_6(n: node)
.stored c416_tok_has_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_has_6(n) :- child(n, c1, _), glob("\\,", c1).
c416_tok_has_6(n) :- op(n, t2), match(",", t2).
c416_tok_has_6(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
c416_tok_has_6(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
c416_tok_has_6(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// tok_has_7(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_has_7(n: node)
.stored c416_tok_has_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_has_7(n) :- child(n, c6, _), glob("\\,", c6).
c416_tok_has_7(n) :- op(n, t7), match(",", t7).
c416_tok_has_7(n) :- child(n, c13, _), structural_before(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
c416_tok_has_7(n) :- child(n, c13, _), structural_after(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
c416_tok_has_7(n) :- node_text(n, g8), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g8).

// demand_alt_17: the nodes alt_17 is asked at (its recursion looks at every descendant)
.decl c416_demand_alt_17(n: node)
c416_demand_alt_17(c2) :- c416_demand_list_comprehension_in_annotation(n),
    (kind(n, "string") ; kind(n, "concatenated_string")), parsed(n, "annotation", r1),
    within(c2, r1).
c416_demand_alt_17(n) :- node(_, n, _, _, _), W = n, text(W, t1).

// demand_list_comprehension_in_annotation: the nodes list_comprehension_in_annotation is asked at (its recursion looks at every descendant)
.decl c416_demand_list_comprehension_in_annotation(n: node)
c416_demand_list_comprehension_in_annotation(n) :- c416_demand_alt_17(n).

// demand_alt_19: the nodes alt_19 is asked at (its recursion looks at every descendant)
.decl c416_demand_alt_19(n: node)
c416_demand_alt_19(c2) :- c416_demand_set_comprehension_in_annotation(n),
    (kind(n, "string") ; kind(n, "concatenated_string")), parsed(n, "annotation", r1),
    within(c2, r1).
c416_demand_alt_19(n) :- node(_, n, _, _, _), W = n, text(W, t1).

// demand_set_comprehension_in_annotation: the nodes set_comprehension_in_annotation is asked at (its recursion looks at every descendant)
.decl c416_demand_set_comprehension_in_annotation(n: node)
c416_demand_set_comprehension_in_annotation(n) :- c416_demand_alt_19(n).

// demand_alt_20: the nodes alt_20 is asked at (its recursion looks at every descendant)
.decl c416_demand_alt_20(n: node)
c416_demand_alt_20(c2) :- c416_demand_dict_comprehension_in_annotation(n),
    (kind(n, "string") ; kind(n, "concatenated_string")), parsed(n, "annotation", r1),
    within(c2, r1).
c416_demand_alt_20(n) :- node(_, n, _, _, _), W = n, text(W, t1).

// demand_dict_comprehension_in_annotation: the nodes dict_comprehension_in_annotation is asked at (its recursion looks at every descendant)
.decl c416_demand_dict_comprehension_in_annotation(n: node)
c416_demand_dict_comprehension_in_annotation(n) :- c416_demand_alt_20(n).

// demand_fn_body: the nodes fn_body is asked at (it looks at every ancestor of every node)
.decl c416_demand_fn_body(n: node)
c416_demand_fn_body(n) :- inside(n, p1, "module"), within(c2, p1), c416_kind_name(c2, KN),
    site_scope(c2, "module").

// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl c416_alt_1_u0_empty(n: node)

// dict_expr_u0_empty: level -1 of an unrolled recursion, empty
.decl c416_dict_expr_u0_empty(n: node)

// stop_15: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl c416_stop_15(kind: symbol)
c416_stop_15("function_definition"). c416_stop_15("lambda").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_1(n: node)
c416_alt_1(n) :- c416_alt_1_u7(n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_3(n: node)
c416_alt_3(n) :- ref_site(n, b1),
    ( kind(b1, "dictionary_splat_pattern"), child(p1, b1, _), kind(p1, "parameters")
    ; kind(b1, "typed_parameter"), child(p2, b1, _), kind(p2, "parameters"), child(b1, c1, _), kind(c1, "dictionary_splat_pattern")
    ).

c416_alt_3(n) :- ref_site(n, b5), binding_value(b5, x6), c416_dict_init(x6),
    count : { child(b5, c7, _), kind(c7, "type") } = 0.
c416_alt_3(n) :- ref_site(n, b8), kind(b8, "as_pattern"), child(p9, b8, _),
    kind(p9, "with_item"), child(b8, c10, _), c416_dict_init(c10), c416_tok_precedes_5(c10),
    child(b8, c18, _), kind(c18, "as_pattern_target"), child(c18, c19, _),
    c416_plain_target(c19).
c416_alt_3(n) :- ref_site(n, b20), site_annotation(b20, o21), c416_dict_ann(o21),
    count : { child(b20, c22, _), (kind(c22, "list_splat_pattern") ; kind(c22, "dictionary_splat_pattern")) } = 0.
c416_alt_3(n) :- ref_site(n, b23), kind(b23, "function_definition"), child(b23, c24, _),
    kind(c24, "type"), child(c24, c25, _), c416_dict_ann(c25).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_5(n: node)
c416_alt_5(n) :- node(_, n, _, _, _), glob("[(),\\[\\]]", n).
c416_alt_5(n) :- kind(n, "comment").

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_6(n: node)
c416_alt_6(n) :- c416_any_pname(n).
c416_alt_6(n) :- node(_, n, _, _, _), glob("[(),\\[\\]]", n).
c416_alt_6(n) :- kind(n, "comment").

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_10(n: node)
c416_alt_10(n) :- c416_any_xname(n).
c416_alt_10(n) :- node(_, n, _, _, _), glob("[(),\\[\\]]", n).
c416_alt_10(n) :- kind(n, "comment").

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_11(n: node)
c416_alt_11(n) :- kind(n, "if_clause").
c416_alt_11(n) :- kind(n, "for_in_clause"), match("async\\b.*", n).

// alt_13(n): the JSON `any`: n matches if any one of these rules does
//   F, KN: metavariables of the calling rule, passed in (bound by the caller)
.decl c416_alt_13(n: node, f: loc, kn: symbol)
c416_alt_13(n, F, KN) :- node(_, F, _, _, _), node(_, W, _, _, _), precedes(s1, n),
    within(c2, s1), c416_kind_name(c2, KN), !site_form(c2, "except"),
    !site_form(c2, "annotation"),
    (site_scope(c2, "function") ; site_scope(c2, "lambda")), within(c2, p3),
    (kind(p3, "function_definition") ; kind(p3, "lambda")), node(_, p3, _, _, _), G = p3,
    text(G, t4), text(F, t4), text(W, t1_td),
    KN = @replace_all(t1_td, "(?s)^.*$", "dict"), @doc(G) = @doc(F).
c416_alt_13(n, F, KN) :- node(_, F, _, _, _), node(_, W, _, _, _), within(n, p6),
    precedes(s7, p6), within(c8, s7), c416_kind_name(c8, KN), !site_form(c8, "except"),
    !site_form(c8, "annotation"),
    (site_scope(c8, "function") ; site_scope(c8, "lambda")), within(c8, p9),
    (kind(p9, "function_definition") ; kind(p9, "lambda")), node(_, p9, _, _, _), G = p9,
    text(G, t10), text(F, t10), text(W, t1_td),
    KN = @replace_all(t1_td, "(?s)^.*$", "dict"), @doc(G) = @doc(F).

// alt_14(n): the JSON `any`: n matches if any one of these rules does
//   F, KN: metavariables of the calling rule, passed in (bound by the caller)
.decl c416_alt_14(n: node, f: loc, kn: symbol)
c416_alt_14(n, F, KN) :- node(_, F, _, _, _), node(_, W, _, _, _), precedes(s1, n),
    within(c2, s1), c416_kind_name(c2, KN), !site_form(c2, "except"),
    !site_form(c2, "annotation"), site_scope(c2, "class"),
