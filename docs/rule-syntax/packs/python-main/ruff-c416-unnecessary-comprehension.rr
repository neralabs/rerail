// target_pair(n): the JSON util `target-pair`, used where the JSON says `matches: "target-pair"`
//   TK, TV: metavariables this relation binds for the calling rule
.decl c416_target_pair(n: node, tk: loc, tv: loc)
c416_target_pair(n, TK, TV) :- (kind(n, "pattern_list") ; kind(n, "tuple_pattern") ; kind(n, "list_pattern")),
    k2 = count : { child(n, c1, _), !c416_alt_5(c1) }, k2 >= 2, k2 <= 2,
    count : { child(n, c3, _), !c416_alt_6(c3) } = 0, child(n, c4, _), c416_tgt_key(c4, TK),
    precedes(c4, s5), c416_tgt_value(s5, TV).
c416_target_pair(n, TK, TV) :- kind(n, "tuple_pattern"), !c416_tok_has_7(n), child(n, c14, _),
