.policy "ruff-c416-unnecessary-comprehension" revision 1
.guests off
.description "Pass the iterable to list, set or dict directly instead of a comprehension that rebuilds it unchanged."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/names.rr"

// dict_expr(n): the JSON util `dict-expr`, used where the JSON says `matches: "dict-expr"`
.decl c416_dict_expr(n: node)
c416_dict_expr(n) :- c416_dict_expr_u7(n).

// dict_callee(n): the JSON util `dict-callee`, used where the JSON says `matches: "dict-callee"`
.decl c416_dict_callee(n: node)
c416_dict_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "dict"), sym_of(n, "builtins.dict").
c416_dict_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_dict_callee(c1).

// dict_init(n): the JSON util `dict-init`, used where the JSON says `matches: "dict-init"`
.decl c416_dict_init(n: node)
c416_dict_init(n) :- c416_dict_expr(n).
c416_dict_init(n) :- kind(n, "call"), child(n, c1, _), c416_dict_callee(c1),
    next_sibling(c1, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")).

// dict_ann(n): the JSON util `dict-ann`, used where the JSON says `matches: "dict-ann"`
.decl c416_dict_ann(n: node)
c416_dict_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "dict"),
    sym_of(n, "builtins.dict").
c416_dict_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Dict")
    ; sym_of(n, "_typeshed.Dict")
    ; sym_of(n, "typing_extensions.Dict")
    ).

c416_dict_ann(n) :- (kind(n, "subscript") ; kind(n, "generic_type")), child(n, c1, _),
    !c416_tok_follows_4(c1), c416_dict_ann(c1).
c416_dict_ann(n) :- kind(n, "parenthesized_expression"), child(n, c9, _), c416_dict_ann(c9).

// plain_target(n): the JSON util `plain-target`, used where the JSON says `matches: "plain-target"`
.decl c416_plain_target(n: node)
c416_plain_target(n) :- kind(n, "identifier").
c416_plain_target(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c416_plain_target(c1).

// dict_bound(n): the JSON util `dict-bound`, used where the JSON says `matches: "dict-bound"`
.decl c416_dict_bound(n: node)
c416_dict_bound(n) :- kind(n, "identifier"), c416_alt_3(n).

// receiver_name(n): the JSON util `receiver-name`, used where the JSON says `matches: "receiver-name"`
.decl c416_receiver_name(n: node)
c416_receiver_name(n) :- c416_dict_bound(n).
c416_receiver_name(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
