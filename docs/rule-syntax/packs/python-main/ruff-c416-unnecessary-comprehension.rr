// single_for(n): the JSON util `single-for`, used where the JSON says `matches: "single-for"`
//   IT: metavariable this relation binds for the calling rule
.decl c416_single_for(n: node, it: loc)
c416_single_for(n, IT) :- k2 = count : { child(n, c1, _), kind(c1, "for_in_clause") },
    k2 >= 1, k2 <= 1, count : { child(n, c3, _), c416_alt_11(c3) } = 0, child(n, c4, _),
    kind(c4, "for_in_clause"), field(c4, "right", c5), node(_, c5, _, _, _), IT = c5.

// items_call(n): the JSON util `items-call`, used where the JSON says `matches: "items-call"`
.decl c416_items_call(n: node)
c416_items_call(n) :- kind(n, "call"), field(n, "function", c1), kind(c1, "attribute"),
    field(c1, "object", c2), c416_receiver_name(c2), field(c1, "attribute", c3),
    glob("items", c3).
c416_items_call(n) :- kind(n, "parenthesized_expression"), child(n, c4, _), c416_items_call(c4).

