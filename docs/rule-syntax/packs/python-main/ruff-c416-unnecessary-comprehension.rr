.decl c416_tuple_pair(n: node, ek: loc, ev: loc)
c416_tuple_pair(n, EK, EV) :- kind(n, "tuple"),
    k2 = count : { child(n, c1, _), !c416_alt_5(c1) }, k2 >= 2, k2 <= 2,
    count : { child(n, c3, _), !c416_alt_10(c3) } = 0, child(n, c4, _), c416_name_key(c4, EK),
    precedes(c4, s5), c416_name_value(s5, EV).
c416_tuple_pair(n, EK, EV) :- kind(n, "parenthesized_expression"), child(n, c6, _),
