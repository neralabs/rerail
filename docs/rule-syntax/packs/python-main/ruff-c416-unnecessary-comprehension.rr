// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^:=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_follows_1(n: node)
.stored c416_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_follows_1(n) :- next_sibling(s3, n), glob(":=", s3).
c416_tok_follows_1(n) :- structural_before(n, g5), match("\\s*", g5), child(p6, n, _),
    node(_, n, _, st8, _), o7 = st8 - strlen(g5), token(p6, _, t4, _, o7),
    match(":=", t4).
c416_tok_follows_1(n) :- structural_before(n, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::=)\\s*)$", g5).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_precedes_2(n: node)
.stored c416_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_precedes_2(n) :- next_sibling(n, s11), glob("if", s11).
c416_tok_precedes_2(n) :- structural_after(n, g13), match("\\s*", g13), child(p14, n, _),
    node(_, n, _, _, en17), o15 = en17 + strlen(g13), token(p14, _, t12, o15, _),
    match("if", t12).
c416_tok_precedes_2(n) :- structural_after(n, g13),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g13).

// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_follows_3(n: node)
.stored c416_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_follows_3(n) :- next_sibling(s19, n), glob("else", s19).
c416_tok_follows_3(n) :- structural_before(n, g21), match("\\s*", g21), child(p22, n, _),
    node(_, n, _, st24, _), o23 = st24 - strlen(g21), token(p22, _, t20, _, o23),
    match("else", t20).
c416_tok_follows_3(n) :- structural_before(n, g21),
    match("(?s)^(?:(?:.*\\W)?(?:else)\\s*)$", g21).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_follows_4(n: node)
.stored c416_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_follows_4(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
c416_tok_follows_4(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
c416_tok_follows_4(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_precedes_5(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_precedes_5(n: node)
.stored c416_tok_precedes_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_precedes_5(n) :- precedes(n, s14), glob("as", s14).
c416_tok_precedes_5(n) :- child(p17, n, _), node(_, n, _, _, en20),
    token(p17, _, t15, st19, _), st19 >= en20, match("as", t15).
c416_tok_precedes_5(n) :- structural_after(n, g16),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g16).
c416_tok_precedes_5(n) :- precedes(n, o18), structural_after(o18, g16),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g16).

// tok_has_6(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_has_6(n: node)
.stored c416_tok_has_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_has_6(n) :- child(n, c1, _), glob("\\,", c1).
c416_tok_has_6(n) :- op(n, t2), match(",", t2).
c416_tok_has_6(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
c416_tok_has_6(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
c416_tok_has_6(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// tok_has_7(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl c416_tok_has_7(n: node)
.stored c416_tok_has_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
c416_tok_has_7(n) :- child(n, c6, _), glob("\\,", c6).
c416_tok_has_7(n) :- op(n, t7), match(",", t7).
c416_tok_has_7(n) :- child(n, c13, _), structural_before(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
c416_tok_has_7(n) :- child(n, c13, _), structural_after(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
c416_tok_has_7(n) :- node_text(n, g8), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g8).

// demand_alt_17: the rows of alt_17 its callers ask for (the metavariable columns they pass in)
