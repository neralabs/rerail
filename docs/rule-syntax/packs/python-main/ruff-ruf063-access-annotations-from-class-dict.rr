.policy "ruff-ruf063-access-annotations-from-class-dict" revision 1
.guests off
.description "Use the dedicated get_annotations function instead of reading annotations from an object's __dict__; direct access is not forward-compatible with deferred annotation evaluation."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// annotations_literal(n): the JSON util `annotations-literal`, used where the JSON says `matches: "annotations-literal"`
.decl ruf063_annotations_literal(n: node)
ruf063_annotations_literal(n) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    value(n, v1), value_type(v1, "str"), v1 = "__annotations__",
    count : { has(n, c2, "string_start"), glob("**[fFtT]**", c2) } = 0.
ruf063_annotations_literal(n) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    ruf063_annotations_literal(c3).

// dict_access(n): the JSON util `dict-access`, used where the JSON says `matches: "dict-access"`
.decl ruf063_dict_access(n: node)
ruf063_dict_access(n) :- kind(n, "attribute"), child(n, c1, _), kind(c1, "identifier"),
    ruf063_tok_follows_1(c1), glob("__dict__", c1).
ruf063_dict_access(n) :- kind(n, "parenthesized_expression"), child(n, c9, _),
    ruf063_dict_access(c9).

// get_method(n): the JSON util `get-method`, used where the JSON says `matches: "get-method"`
.decl ruf063_get_method(n: node)
ruf063_get_method(n) :- kind(n, "attribute"), child(n, c1, _), kind(c1, "identifier"),
    ruf063_tok_follows_1(c1), glob("get", c1), child(n, c9, _), ruf063_dict_access(c9),
    ruf063_tok_precedes_2(c9).
ruf063_get_method(n) :- kind(n, "parenthesized_expression"), child(n, c17, _),
    ruf063_get_method(c17).

// argument(n): the JSON util `argument`, used where the JSON says `matches: "argument"`
.decl ruf063_argument(n: node)
ruf063_argument(n) :- node(_, n, _, _, _), !ruf063_alt_1(n).

// get_call(n): the JSON util `get-call`, used where the JSON says `matches: "get-call"`
.decl ruf063_get_call(n: node)
ruf063_get_call(n) :- kind(n, "call"), child(n, c1, _), ruf063_get_method(c1), next_sibling(c1, s2),
    kind(s2, "argument_list"), child(n, c3, _), kind(c3, "argument_list"),
    count : { child(c3, c4, _), (kind(c4, "keyword_argument") ; kind(c4, "dictionary_splat")) } = 0,
    k6 = count : { child(c3, c5, _), ruf063_argument(c5) }, k6 >= 1, k6 <= 2,
    child(c3, c7, _), ruf063_annotations_literal(c7),
    count : { precedes(s8, c7), ruf063_argument(s8) } = 0.

// subscript_access(n): the JSON util `subscript-access`, used where the JSON says `matches: "subscript-access"`
.decl ruf063_subscript_access(n: node)
ruf063_subscript_access(n) :- kind(n, "subscript"), child(n, c1, _), ruf063_dict_access(c1),
    ruf063_tok_precedes_3(c1), child(n, c9, _), ruf063_annotations_literal(c9), ruf063_tok_follows_4(c9),
    !ruf063_tok_has_5(n).

// get_in_string(n): the JSON util `get-in-string`, used where the JSON says `matches: "get-in-string"`
//   HIT: metavariable this relation binds for the calling rule
.decl ruf063_get_in_string(n: node, hit: loc)
ruf063_get_in_string(n, HIT) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ruf063_alt_2(c2, HIT).

// subscript_in_string(n): the JSON util `subscript-in-string`, used where the JSON says `matches: "subscript-in-string"`
//   HIT: metavariable this relation binds for the calling rule
.decl ruf063_subscript_in_string(n: node, hit: loc)
ruf063_subscript_in_string(n, HIT) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ruf063_alt_3(c2, HIT).

// RUF063(n, detail): findings from clauses `annotations-from-dict-get`, `annotations-from-dict-subscript`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF063(at: node, hit: node, detail: symbol) "Use `annotationlib.get_annotations(obj)` (3.14+), `inspect.get_annotations(obj)` (3.10+) or `typing_extensions.get_annotations(obj)` instead of {detail}."
    suppress noqa "RUF063"
RUF063(HIT, n, "`__dict__.get(\"__annotations__\")`") :- ruf063_get_call(n), node(_, n, _, _, _), HIT = n.
RUF063(HIT, n, "`__dict__.get(\"__annotations__\")`") :- ruf063_get_in_string(n, HIT).
RUF063(HIT, n, "`__dict__[\"__annotations__\"]`") :- ruf063_subscript_access(n), node(_, n, _, _, _), HIT = n.
RUF063(HIT, n, "`__dict__[\"__annotations__\"]`") :- ruf063_subscript_in_string(n, HIT).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\.$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf063_tok_follows_1(n: node)
.stored ruf063_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf063_tok_follows_1(n) :- precedes(s2, n), glob(".", s2).
ruf063_tok_follows_1(n) :- child(p5, n, _), node(_, n, _, st7, _), token(p5, _, t3, _, en8),
    en8 <= st7, match("\\.", t3).
ruf063_tok_follows_1(n) :- structural_before(n, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).
ruf063_tok_follows_1(n) :- precedes(o6, n), structural_before(o6, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^\\.$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf063_tok_precedes_2(n: node)
.stored ruf063_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf063_tok_precedes_2(n) :- precedes(n, s10), glob(".", s10).
ruf063_tok_precedes_2(n) :- child(p13, n, _), node(_, n, _, _, en16),
    token(p13, _, t11, st15, _), st15 >= en16, match("\\.", t11).
ruf063_tok_precedes_2(n) :- structural_after(n, g12),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g12).
ruf063_tok_precedes_2(n) :- precedes(n, o14), structural_after(o14, g12),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g12).

// tok_precedes_3(n): a later sibling of n, a named node or an anonymous token, matches "^\\[$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf063_tok_precedes_3(n: node)
.stored ruf063_tok_precedes_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf063_tok_precedes_3(n) :- precedes(n, s2), glob("\\[", s2).
ruf063_tok_precedes_3(n) :- child(p5, n, _), node(_, n, _, _, en8), token(p5, _, t3, st7, _),
    st7 >= en8, match("\\[", t3).
ruf063_tok_precedes_3(n) :- structural_after(n, g4), match("(?s)^(?:.*(?:\\[).*)$", g4).
ruf063_tok_precedes_3(n) :- precedes(n, o6), structural_after(o6, g4),
    match("(?s)^(?:.*(?:\\[).*)$", g4).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\[$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf063_tok_follows_4(n: node)
.stored ruf063_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf063_tok_follows_4(n) :- precedes(s10, n), glob("\\[", s10).
ruf063_tok_follows_4(n) :- child(p13, n, _), node(_, n, _, st15, _),
    token(p13, _, t11, _, en16), en16 <= st15, match("\\[", t11).
ruf063_tok_follows_4(n) :- structural_before(n, g12), match("(?s)^(?:.*(?:\\[).*)$", g12).
ruf063_tok_follows_4(n) :- precedes(o14, n), structural_before(o14, g12),
    match("(?s)^(?:.*(?:\\[).*)$", g12).

// tok_has_5(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf063_tok_has_5(n: node)
.stored ruf063_tok_has_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf063_tok_has_5(n) :- child(n, c17, _), glob("\\,", c17).
ruf063_tok_has_5(n) :- op(n, t18), match(",", t18).
ruf063_tok_has_5(n) :- child(n, c24, _), structural_before(c24, g19),
    match("(?s)^(?:.*(?:,).*)$", g19).
ruf063_tok_has_5(n) :- child(n, c24, _), structural_after(c24, g19),
    match("(?s)^(?:.*(?:,).*)$", g19).
ruf063_tok_has_5(n) :- node_text(n, g19), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g19).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl ruf063_alt_1(n: node)
ruf063_alt_1(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
ruf063_alt_1(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   HIT: metavariable this relation binds for the calling rule
.decl ruf063_alt_2(n: node, hit: loc)
ruf063_alt_2(n, HIT) :- ruf063_get_call(n), HIT = n.
ruf063_alt_2(n, HIT) :- ruf063_get_in_string(n, HIT).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
//   HIT: metavariable this relation binds for the calling rule
.decl ruf063_alt_3(n: node, hit: loc)
ruf063_alt_3(n, HIT) :- ruf063_subscript_access(n), HIT = n.
ruf063_alt_3(n, HIT) :- ruf063_subscript_in_string(n, HIT).
