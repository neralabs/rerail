ruf008_set_1("bool"). ruf008_set_1("bytes"). ruf008_set_1("complex"). ruf008_set_1("float"). ruf008_set_1("int").
ruf008_set_1("object"). ruf008_set_1("range"). ruf008_set_1("str"). ruf008_set_1("frozenset"). ruf008_set_1("tuple").

