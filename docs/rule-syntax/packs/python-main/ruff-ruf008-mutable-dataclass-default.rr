.stored ruf008_tok_has_20 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf008_tok_has_20(n) :- child(n, c57, _), glob("\\,", c57).
ruf008_tok_has_20(n) :- op(n, t58), match(",", t58).
ruf008_tok_has_20(n) :- child(n, c64, _), structural_before(c64, g59),
    match("(?s)^(?:.*(?:,).*)$", g59).
ruf008_tok_has_20(n) :- child(n, c64, _), structural_after(c64, g59),
    match("(?s)^(?:.*(?:,).*)$", g59).
ruf008_tok_has_20(n) :- node_text(n, g59), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g59).

// all_expr: x is a module-level `__all__ =`, `+=` or `: T =` value, or a part of one that lists names
//   (Ruff's extract_dunder_all_names: `+` chains, parentheses, walrus values, list(...) and tuple(...))
.decl ruf008_all_expr(x: node)
ruf008_all_expr(x) :- (kind(st, "assignment") ; kind(st, "augmented_assignment")),
    field(st, "left", l), kind(l, "identifier"), text(l, "__all__"), child(es, st, _),
    kind(es, "expression_statement"), child(m, es, _), kind(m, "module"),
    field(st, "right", x).
ruf008_all_expr(y) :- ruf008_all_expr(x), kind(x, "assignment"), field(x, "right", y).
ruf008_all_expr(y) :- ruf008_all_expr(x), kind(x, "binary_operator"),
    (field(x, "left", y) ; field(x, "right", y)).
ruf008_all_expr(y) :- ruf008_all_expr(x), kind(x, "parenthesized_expression"), child(x, y, _),
    !kind(y, "comment").
ruf008_all_expr(y) :- ruf008_all_expr(x), kind(x, "named_expression"), field(x, "value", y).
ruf008_all_expr(y) :- ruf008_all_expr(x), kind(x, "call"), field(x, "function", f),
    kind(f, "identifier"), (text(f, "list") ; text(f, "tuple")),
    field(x, "arguments", a), child(a, y, _).

// all_entry: string e is an entry of a module `__all__` definition, exporting the name x
.decl ruf008_all_entry(e: node, x: symbol)
ruf008_all_entry(e, x) :- ruf008_all_expr(l), (kind(l, "list") ; kind(l, "tuple")), child(l, e, _),
    (kind(e, "string") ; kind(e, "concatenated_string")),
    count : { within(i, e), kind(i, "interpolation") } = 0, str(e, x).

// tok_follows_21(n): an earlier sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf008_tok_follows_21(n: node)
.stored ruf008_tok_follows_21 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf008_tok_follows_21(n) :- next_sibling(s1, n), glob("=", s1).
ruf008_tok_follows_21(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("=", t2).
ruf008_tok_follows_21(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)\\s*)$", g3).

// demand_class_var_import_follows: the nodes class_var_import_follows is asked at (it looks at every ancestor of every node)
.decl ruf008_demand_class_var_import_follows(n: node)
ruf008_demand_class_var_import_follows(n) :- kind(n, "identifier"), glob("ClassVar", n),
    docof(n, d3), modnode(d3, m4).

