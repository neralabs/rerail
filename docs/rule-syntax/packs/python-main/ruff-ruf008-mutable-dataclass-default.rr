ruf008_alt_31(n) :- ruf008_alt_31_u7(n).

// alt_56(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_56(n: node)
ruf008_alt_56(n) :- ruf008_immutable_annotation(n).
ruf008_alt_56(n) :- ruf008_class_var_annotation(n).

// alt_58(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_58(n: node)
ruf008_alt_58(n) :- node(_, n, _, _, _), glob("[(),]", n).
ruf008_alt_58(n) :- kind(n, "comment").

// alt_59(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_59(n: node)
ruf008_alt_59(n) :- ruf008_alt_59_u7(n).

// stop_13_within: within_stop over the stop set stop_13, read inside an aggregate
.decl ruf008_stop_13_within(n: node, a: node)
ruf008_stop_13_within(x, y) :- within_stop(x, y, ruf008_stop_13).
