// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_10(n: node)
ruf008_alt_10(n) :- node(_, n, _, _, _), match("[\\[\\],|]", n).
ruf008_alt_10(n) :- kind(n, "comment").

// alt_9(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_9(n: node)
ruf008_alt_9(n) :- ruf008_alt_9_u7(n).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_11(n: node)
ruf008_alt_11(n) :- kind(n, "subscript"), ruf008_tok_has_7(n).
ruf008_alt_11(n) :- kind(n, "generic_type"), child(n, c9, _), kind(c9, "type_parameter"),
    ruf008_tok_has_8(c9).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_12(n: node)
ruf008_alt_12(n) :- ruf008_alt_12_u7(n).

// stop_13(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf008_stop_13(n: node)
ruf008_stop_13(n) :- node(_, n, _, _, _), !kind(n, "type_parameter").

// stop_14(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf008_stop_14(n: node)
ruf008_stop_14(n) :- node(_, n, _, _, _), !kind(n, "type_parameter"), !kind(n, "type"),
    !kind(n, "parenthesized_expression").

// alt_15(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_15(n: node)
ruf008_alt_15(n) :- ruf008_alt_15_u7(n).

// alt_21(n): the JSON `any`: n matches if any one of these rules does
.decl ruf008_alt_21(n: node)
ruf008_alt_21(n) :- ruf008_alt_21_u7(n).

