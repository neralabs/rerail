.policy "ruff-ytt201-sys-version-info0-eq3" revision 1
.guests off
.description "Compare sys.version_info against a tuple instead of testing whether its major version equals 3; the test breaks on a future major version."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// YTT201(n, detail): findings from clauses `sys-version-info0-eq3`, `sys-version-info0-ne3`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation YTT201(at: node, c: node, detail: symbol) "Replace `sys.version_info[0] {detail} on Python 4 and later."
    suppress noqa "YTT201"
YTT201(C, n, "== 3` with `sys.version_info >= (3,)`; the equality is false") :- ytt201_target(n),
    node(_, n, _, _, _), C = n.
YTT201(C, n, "== 3` with `sys.version_info >= (3,)`; the equality is false") :- ytt201_in_string(n, C).
YTT201(C, n, "!= 3` with `sys.version_info < (3,)`; the inequality is true") :- ytt201_target_sys_version_info0_ne3(n),
    node(_, n, _, _, _), C = n.
YTT201(C, n, "!= 3` with `sys.version_info < (3,)`; the inequality is true") :- ytt201_in_string_sys_version_info0_ne3(n, C).

// sys_version_info(n): the JSON util `sys-version-info`, used where the JSON says `matches: "sys-version-info"`
.decl ytt201_sys_version_info(n: node)
ytt201_sys_version_info(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "sys.version_info").
ytt201_sys_version_info(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ytt201_sys_version_info(c1).

// eq_compare(n): the JSON util `eq-compare`, used where the JSON says `matches: "eq-compare"`
.decl ytt201_eq_compare(n: node)
ytt201_eq_compare(n) :- kind(n, "comparison_operator"), ytt201_tok_has_1(n), child(n, c9, _),
    child(p10, c9, _), ytt201_counted(c9),
    k12 = count : { child(p10, s11, _), precedes(s11, c9), ytt201_counted(s11) }, k12 = 1,
    ytt201_three_literal(c9),
    count : { child(n, c13, _), child(p14, c13, _), ytt201_counted(c13), k16 = count : { child(p14, s15, _), precedes(s15, c13), ytt201_counted(s15) }, k16 = 2 } = 0.

// left_operand(n): the JSON util `left-operand`, used where the JSON says `matches: "left-operand"`
.decl ytt201_left_operand(n: node)
ytt201_left_operand(n) :- child(p1, n, _), ytt201_counted(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), ytt201_counted(s2) }, k3 = 0,
    child(p4, n, _), ytt201_eq_compare(p4).
ytt201_left_operand(n) :- child(p5, n, _), kind(p5, "parenthesized_expression"),
    ytt201_left_operand(p5).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl ytt201_target(n: node)
ytt201_target(n) :- kind(n, "subscript"), ytt201_left_operand(n), field(n, "value", c1),
    ytt201_sys_version_info(c1), field(n, "subscript", c2), ytt201_zero_literal(c2), !ytt201_tok_has_2(n).

// in_string(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   C: metavariable this relation binds for the calling rule
.decl ytt201_in_string(n: node, c: loc)
ytt201_in_string(n, C) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ytt201_alt_4(c2, C).

// zero_literal(n): the JSON util `zero-literal`, used where the JSON says `matches: "zero-literal"`
.decl ytt201_zero_literal(n: node)
ytt201_zero_literal(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int"), v1 = 0.
ytt201_zero_literal(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    ytt201_zero_literal(c2).

// three_literal(n): the JSON util `three-literal`, used where the JSON says `matches: "three-literal"`
.decl ytt201_three_literal(n: node)
ytt201_three_literal(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int"), v1 = 3.
ytt201_three_literal(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    ytt201_three_literal(c2).

// sys_version_info_sys_version_info0_ne3(n): the JSON util `sys-version-info`, used where the JSON says `matches: "sys-version-info"`
.decl ytt201_sys_version_info_sys_version_info0_ne3(n: node)
ytt201_sys_version_info_sys_version_info0_ne3(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "sys.version_info").
ytt201_sys_version_info_sys_version_info0_ne3(n) :- kind(n, "parenthesized_expression"),
    child(n, c1, _), ytt201_sys_version_info_sys_version_info0_ne3(c1).

// eq_compare_sys_version_info0_ne3(n): the JSON util `eq-compare`, used where the JSON says `matches: "eq-compare"`
.decl ytt201_eq_compare_sys_version_info0_ne3(n: node)
ytt201_eq_compare_sys_version_info0_ne3(n) :- kind(n, "comparison_operator"), ytt201_tok_has_3(n),
    child(n, c9, _), child(p10, c9, _), ytt201_counted(c9),
    k12 = count : { child(p10, s11, _), precedes(s11, c9), ytt201_counted(s11) }, k12 = 1,
    ytt201_three_literal_sys_version_info0_ne3(c9),
    count : { child(n, c13, _), child(p14, c13, _), ytt201_counted(c13), k16 = count : { child(p14, s15, _), precedes(s15, c13), ytt201_counted(s15) }, k16 = 2 } = 0.

// left_operand_sys_version_info0_ne3(n): the JSON util `left-operand`, used where the JSON says `matches: "left-operand"`
.decl ytt201_left_operand_sys_version_info0_ne3(n: node)
ytt201_left_operand_sys_version_info0_ne3(n) :- child(p1, n, _), ytt201_counted(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), ytt201_counted(s2) }, k3 = 0,
    child(p4, n, _), ytt201_eq_compare_sys_version_info0_ne3(p4).
ytt201_left_operand_sys_version_info0_ne3(n) :- child(p5, n, _),
    kind(p5, "parenthesized_expression"), ytt201_left_operand_sys_version_info0_ne3(p5).

// target_sys_version_info0_ne3(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl ytt201_target_sys_version_info0_ne3(n: node)
ytt201_target_sys_version_info0_ne3(n) :- kind(n, "subscript"),
    ytt201_left_operand_sys_version_info0_ne3(n), field(n, "value", c1),
    ytt201_sys_version_info_sys_version_info0_ne3(c1), field(n, "subscript", c2),
    ytt201_zero_literal_sys_version_info0_ne3(c2), !ytt201_tok_has_2(n).

// in_string_sys_version_info0_ne3(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   C: metavariable this relation binds for the calling rule
.decl ytt201_in_string_sys_version_info0_ne3(n: node, c: loc)
ytt201_in_string_sys_version_info0_ne3(n, C) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ytt201_alt_8(c2, C).

// zero_literal_sys_version_info0_ne3(n): the JSON util `zero-literal`, used where the JSON says `matches: "zero-literal"`
.decl ytt201_zero_literal_sys_version_info0_ne3(n: node)
ytt201_zero_literal_sys_version_info0_ne3(n) :- kind(n, "integer"), value(n, v1),
    value_type(v1, "int"), v1 = 0.
ytt201_zero_literal_sys_version_info0_ne3(n) :- kind(n, "parenthesized_expression"),
    child(n, c2, _), ytt201_zero_literal_sys_version_info0_ne3(c2).

// three_literal_sys_version_info0_ne3(n): the JSON util `three-literal`, used where the JSON says `matches: "three-literal"`
.decl ytt201_three_literal_sys_version_info0_ne3(n: node)
ytt201_three_literal_sys_version_info0_ne3(n) :- kind(n, "integer"), value(n, v1),
    value_type(v1, "int"), v1 = 3.
ytt201_three_literal_sys_version_info0_ne3(n) :- kind(n, "parenthesized_expression"),
    child(n, c2, _), ytt201_three_literal_sys_version_info0_ne3(c2).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^==$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ytt201_tok_has_1(n: node)
.stored ytt201_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ytt201_tok_has_1(n) :- child(n, c1, _), glob("==", c1).
ytt201_tok_has_1(n) :- op(n, t2), match("==", t2).
ytt201_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:==)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ytt201_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:==)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ytt201_tok_has_1(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:==)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ytt201_tok_has_2(n: node)
.stored ytt201_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ytt201_tok_has_2(n) :- child(n, c3, _), glob("\\,", c3).
ytt201_tok_has_2(n) :- op(n, t4), match(",", t4).
ytt201_tok_has_2(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
ytt201_tok_has_2(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
ytt201_tok_has_2(n) :- node_text(n, g5), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g5).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^!=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ytt201_tok_has_3(n: node)
.stored ytt201_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ytt201_tok_has_3(n) :- child(n, c1, _), glob("!=", c1).
ytt201_tok_has_3(n) :- op(n, t2), match("!=", t2).
ytt201_tok_has_3(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:!=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ytt201_tok_has_3(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:!=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ytt201_tok_has_3(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:!=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).

// counted(n): 6 identical copies of one rule set (`counted_1`, `counted_2`, `counted_3` and 3 more), folded into one.
.decl ytt201_counted(n: node)
ytt201_counted(n) :- node(_, n, _, _, _), !kind(n, "comment"), !kind(n, "line_continuation").

// alt_4(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl ytt201_alt_4(n: node, c: loc)
ytt201_alt_4(n, C) :- ytt201_target(n), C = n.
ytt201_alt_4(n, C) :- ytt201_in_string(n, C).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl ytt201_alt_8(n: node, c: loc)
ytt201_alt_8(n, C) :- ytt201_target_sys_version_info0_ne3(n), C = n.
ytt201_alt_8(n, C) :- ytt201_in_string_sys_version_info0_ne3(n, C).
