.policy "bandit-b415-import-pyghmi" revision 1
.guests off
.description "Avoid importing pyghmi; IPMI is an insecure protocol, so prefer an encrypted management protocol."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// B415(n): a finding at node n, from clause `B415`.
// Each rule below is one way the JSON `rule` can match.
.violation B415(at: node) "Replace this pyghmi import with a client for an encrypted management protocol such as Redfish over HTTPS; IPMI is insecure."
    suppress nosec "B415"
B415(n) :- n ~ `import pyghmi`.
B415(n) :- n ~ `import pyghmi as $ALIAS`.
B415(n) :- n ~ `from pyghmi import $$$NAMES`.
