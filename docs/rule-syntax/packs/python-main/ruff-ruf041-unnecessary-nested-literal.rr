// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF041_nested_literal_in_string(at: node, c: node) code "RUF041" "Flatten this nested `Literal` into one `Literal[...]` listing every value; if an inner group is reused, name it as an alias (`Mode = Literal[...]`) and nest the alias instead."
    suppress noqa "RUF041"
RUF041_nested_literal_in_string(C, n) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ruf041_lit(c2), ruf041_holds_lit(c2),
    !ruf041_under_lit(c2), C = c2.

