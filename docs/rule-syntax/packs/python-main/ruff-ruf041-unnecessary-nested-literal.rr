ruf041_holds_lit(n) :- kind(n, "generic_type"), child(n, c25, _), kind(c25, "type_parameter"),
    child(c25, c26, _), kind(c26, "type"), ruf041_elem_lit(c26).
ruf041_holds_lit(n) :- kind(n, "generic_type"), child(n, c27, _), kind(c27, "type_parameter"),
    !ruf041_tok_has_4(c27), child(c27, c36, _), kind(c36, "type"), ruf041_tuple_lit(c36).

// under_lit0(n): the JSON util `under-lit0`, used where the JSON says `matches: "under-lit0"`
.decl ruf041_under_lit0(n: node)
ruf041_under_lit0(n) :- ruf041_tok_follows_5(n), child(p8, n, _), ruf041_lit_sub(p8).
ruf041_under_lit0(n) :- child(p9, n, _), kind(p9, "type_parameter"), child(p10, p9, _),
