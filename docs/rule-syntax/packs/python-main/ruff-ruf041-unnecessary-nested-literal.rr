.policy "ruff-ruf041-unnecessary-nested-literal" revision 1
.guests off
.description "Flatten a Literal that wraps another Literal into a single Literal; the nesting adds nothing but noise."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// lit_name(n): the JSON util `lit-name`, used where the JSON says `matches: "lit-name"`
.decl ruf041_lit_name(n: node)
ruf041_lit_name(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Literal")
    ; sym_of(n, "typing_extensions.Literal")
    ; sym_of(n, "_typeshed.Literal")
    ).

ruf041_lit_name(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf041_lit_name(c1).

// lit_sub(n): the JSON util `lit-sub`, used where the JSON says `matches: "lit-sub"`
.decl ruf041_lit_sub(n: node)
ruf041_lit_sub(n) :- kind(n, "subscript"), field(n, "value", c1), ruf041_lit_name(c1).

// lit_gen(n): the JSON util `lit-gen`, used where the JSON says `matches: "lit-gen"`
.decl ruf041_lit_gen(n: node)
ruf041_lit_gen(n) :- kind(n, "generic_type"), child(n, c1, _), kind(c1, "identifier"),
    ruf041_lit_name(c1).

// lit(n): the JSON util `lit`, used where the JSON says `matches: "lit"`
.decl ruf041_lit(n: node)
ruf041_lit(n) :- ruf041_lit_sub(n).
ruf041_lit(n) :- ruf041_lit_gen(n).

// elem_lit(n): the JSON util `elem-lit`, used where the JSON says `matches: "elem-lit"`
.decl ruf041_elem_lit(n: node)
ruf041_elem_lit(n) :- ruf041_lit(n).
ruf041_elem_lit(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type")),
    child(n, c1, _), ruf041_elem_lit(c1).

// tuple_lit(n): the JSON util `tuple-lit`, used where the JSON says `matches: "tuple-lit"`
.decl ruf041_tuple_lit(n: node)
ruf041_tuple_lit(n) :- kind(n, "tuple"), child(n, c1, _), ruf041_elem_lit(c1).
ruf041_tuple_lit(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type")),
    child(n, c2, _), ruf041_tuple_lit(c2).

// holds_lit(n): the JSON util `holds-lit`, used where the JSON says `matches: "holds-lit"`
.decl ruf041_holds_lit(n: node)
ruf041_holds_lit(n) :- kind(n, "subscript"), child(n, c1, _), ruf041_elem_lit(c1), ruf041_tok_follows_1(c1).
ruf041_holds_lit(n) :- kind(n, "subscript"), !ruf041_tok_has_2(n), child(n, c17, _), ruf041_tuple_lit(c17),
