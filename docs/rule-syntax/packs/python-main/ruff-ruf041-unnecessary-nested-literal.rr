// under_lit(n): the JSON util `under-lit`, used where the JSON says `matches: "under-lit"`
.decl ruf041_under_lit(n: node)
ruf041_under_lit(n) :- ruf041_under_lit0(n).
ruf041_under_lit(n) :- child(p1, n, _), kind(p1, "tuple"), ruf041_lone_slice(p1).

// lone_slice(n): the JSON util `lone-slice`, used where the JSON says `matches: "lone-slice"`
.decl ruf041_lone_slice(n: node)
ruf041_lone_slice(n) :- ruf041_tok_follows_5(n), child(p8, n, _), ruf041_lit_sub(p8), !ruf041_tok_has_2(p8).
ruf041_lone_slice(n) :- child(p17, n, _), kind(p17, "type_parameter"), !ruf041_tok_has_6(p17),
