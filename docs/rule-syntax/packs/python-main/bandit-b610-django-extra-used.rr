.policy "bandit-b610-django-extra-used" revision 2
.guests off
.description "Pass only literal strings to the where, tables and select arguments of Django QuerySet.extra(); dynamic values open the query to SQL injection."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// B610(n): a finding at node n, from clause `django-extra-used`.
// Each rule below is one way the JSON `rule` can match.
.violation B610(at: node) "Pass only literal strings to where, tables and select in this .extra() call, with values in params; dynamic SQL allows injection."
    suppress nosec "B610"
B610(n) :- n ~ `$R.extra($$$)`, field(n, "function", c1), field(c1, "object", c2),
    b610_queryset_receiver(c2), b610_alt_7(n).

// queryset_receiver(n): the JSON util `queryset-receiver`, used where the JSON says `matches: "queryset-receiver"`
.decl b610_queryset_receiver(n: node)
b610_queryset_receiver(n) :- kind(n, "identifier"),
    match("(?:[A-Za-z0-9_]*_)?(?:qs|QS|querysets?|objects|managers?)", n).
b610_queryset_receiver(n) :- kind(n, "attribute"), field(n, "attribute", c1),
    match("(?:[A-Za-z0-9_]*_)?(?:qs|QS|querysets?|objects|managers?)", c1).
b610_queryset_receiver(n) :- kind(n, "call"), field(n, "function", c2),
    kind(c2, "attribute"), field(c2, "object", c3), b610_queryset_receiver(c3).
b610_queryset_receiver(n) :- kind(n, "call"), field(n, "function", c4),
    ( kind(c4, "identifier"), glob("get_queryset", c4)
    ; kind(c4, "attribute"), field(c4, "attribute", c1), glob("get_queryset", c1)
    ).

b610_queryset_receiver(n) :- (kind(n, "identifier"), glob("self", n) ; n ~ `super()`),
    inside(n, p6, "class_definition"), field(p6, "superclasses", c7),
    match(".*(?:^|[(,\\s])(?:[A-Za-z_][A-Za-z0-9_]*\\.)*(?:[A-Za-z0-9_]*QuerySet|Manager|BaseManager|BaseUserManager)\\b.*", c7).

// string(n): the JSON util `string`, used where the JSON says `matches: "string"`
.decl b610_string(n: node)
b610_string(n) :- kind(n, "string"), !match("[A-Za-z]*[fFbBtT].*", n).
b610_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[fFbBtT].*", c1) } = 0.

// strings(n): the JSON util `strings`, used where the JSON says `matches: "strings"`
.decl b610_strings(n: node)
b610_strings(n) :- kind(n, "list"), count : { child(n, c1, _), !b610_alt_3(c1) } = 0.

// string_pairs(n): the JSON util `string-pairs`, used where the JSON says `matches: "string-pairs"`
.decl b610_string_pairs(n: node)
b610_string_pairs(n) :- kind(n, "dictionary"), count : { child(n, c1, _), !b610_alt_5(c1) } = 0.

// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl b610_args_plain(l: node, a: node, i: number)
b610_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl b610_args_splat(l: node, i: number)
b610_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl b610_args_pos(l: node, a: node, j: number)
b610_args_pos(l, a, j) :- b610_args_plain(l, a, i), count : { b610_args_splat(l, k), k < i } = 0,
    j = count : { b610_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl b610_args_star(l: node, j: number)
b610_args_star(l, j) :- b610_args_splat(l, i), count : { b610_args_splat(l, k), k < i } = 0,
    j = count : { b610_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl b610_args_kwp(l: node, k: symbol, v: node)
b610_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl b610_args_lit_dict(s: node, d: node)
b610_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !b610_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl b610_args_str_pair(p: node)
b610_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl b610_args_kw(l: node, k: symbol, v: node)
b610_args_kw(l, k, v) :- b610_args_kwp(l, k, v).
b610_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), b610_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl b610_args_kw_spread(l: node)
b610_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !b610_args_lit_dict(s, _).

// arg_where_1: call n passes v for slot `where` of (select, where, params, tables, order_by, select_params), as Python binds the call
.decl b610_arg_where_1(n: node, v: node)
b610_arg_where_1(n, v) :- kind(n, "call"), field(n, "arguments", l), b610_args_pos(l, v, 1),
    !b610_args_kw(l, "where", _).
b610_arg_where_1(n, v) :- kind(n, "call"), field(n, "arguments", l), b610_args_kw(l, "where", v),
    count : { b610_args_kw(l, "where", _) } = 1, !b610_args_pos(l, _, 1).

// arg_no_where_1: call n does not pass slot `where` of (select, where, params, tables, order_by, select_params), as Python binds the call
.decl b610_arg_no_where_1(n: node)
b610_arg_no_where_1(n) :- kind(n, "call"), field(n, "arguments", l), !b610_args_pos(l, _, 1),
    count : { b610_args_star(l, j), j <= 1 } = 0, !b610_args_kw(l, "where", _),
    !b610_args_kw_spread(l).

// arg_tables_2: call n passes v for slot `tables` of (select, where, params, tables, order_by, select_params), as Python binds the call
.decl b610_arg_tables_2(n: node, v: node)
b610_arg_tables_2(n, v) :- kind(n, "call"), field(n, "arguments", l), b610_args_pos(l, v, 3),
    !b610_args_kw(l, "tables", _).
b610_arg_tables_2(n, v) :- kind(n, "call"), field(n, "arguments", l),
    b610_args_kw(l, "tables", v), count : { b610_args_kw(l, "tables", _) } = 1,
    !b610_args_pos(l, _, 3).

// arg_no_tables_2: call n does not pass slot `tables` of (select, where, params, tables, order_by, select_params), as Python binds the call
.decl b610_arg_no_tables_2(n: node)
b610_arg_no_tables_2(n) :- kind(n, "call"), field(n, "arguments", l), !b610_args_pos(l, _, 3),
    count : { b610_args_star(l, j), j <= 3 } = 0, !b610_args_kw(l, "tables", _),
    !b610_args_kw_spread(l).

// arg_select_3: call n passes v for slot `select` of (select, where, params, tables, order_by, select_params), as Python binds the call
.decl b610_arg_select_3(n: node, v: node)
b610_arg_select_3(n, v) :- kind(n, "call"), field(n, "arguments", l), b610_args_pos(l, v, 0),
    !b610_args_kw(l, "select", _).
b610_arg_select_3(n, v) :- kind(n, "call"), field(n, "arguments", v),
    kind(v, "generator_expression").
b610_arg_select_3(n, v) :- kind(n, "call"), field(n, "arguments", l),
    b610_args_kw(l, "select", v), count : { b610_args_kw(l, "select", _) } = 1,
    !b610_args_pos(l, _, 0).

// arg_no_select_3: call n does not pass slot `select` of (select, where, params, tables, order_by, select_params), as Python binds the call
.decl b610_arg_no_select_3(n: node)
b610_arg_no_select_3(n) :- kind(n, "call"), field(n, "arguments", l), !b610_args_pos(l, _, 0),
    count : { b610_args_star(l, j), j <= 0 } = 0, !kind(l, "generator_expression"),
    !b610_args_kw(l, "select", _), !b610_args_kw_spread(l).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl b610_alt_3(n: node)
b610_alt_3(n) :- b610_string(n).
b610_alt_3(n) :- node(_, n, _, _, _), glob("[\\[\\],]", n).
b610_alt_3(n) :- kind(n, "comment").

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl b610_alt_4(n: node)
b610_alt_4(n) :- b610_string(n).
b610_alt_4(n) :- node(_, n, _, _, _), glob(":", n).
b610_alt_4(n) :- kind(n, "comment").

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl b610_alt_5(n: node)
b610_alt_5(n) :- kind(n, "pair"), count : { child(n, c1, _), !b610_alt_4(c1) } = 0.
b610_alt_5(n) :- node(_, n, _, _, _), glob("[{},]", n).
b610_alt_5(n) :- kind(n, "comment").

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl b610_alt_7(n: node)
b610_alt_7(n) :- kind(n, "call"), b610_arg_where_1(n, a1), W = a1, within(c2, n), node(_, c2, _, _, _), W = c2,
    !b610_strings(c2).
b610_alt_7(n) :- kind(n, "call"), b610_arg_tables_2(n, a3), T = a3, within(c4, n), node(_, c4, _, _, _), T = c4,
    !b610_strings(c4).
b610_alt_7(n) :- kind(n, "call"), b610_arg_select_3(n, a5), S = a5, within(c6, n), node(_, c6, _, _, _), S = c6,
    !b610_string_pairs(c6).
