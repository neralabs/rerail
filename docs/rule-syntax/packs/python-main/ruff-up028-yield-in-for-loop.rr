.policy "ruff-up028-yield-in-for-loop" revision 1
.guests off
.description "Use yield from to delegate to an iterable instead of looping over it and yielding each item."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// UP028(n): a finding at node n, from clause `yield-in-for-loop`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation UP028(at: node, loop: node, it: loc) "Replace this loop with `yield from {it}` (parenthesize a bare tuple). Keep the loop if its target is declared global or nonlocal, or if callers send values the iterable cannot accept."
    suppress noqa "UP028"
UP028(LOOP, n, IT) :- kind(n, "for_statement"),
    count : { field(n, "alternative", c1), kind(c1, "else_clause") } = 0,
    count : { up028_stop_11_within(n, p2), kind(p2, "function_definition"), up028_tok_has_2(p2) } = 0,
    field(n, "left", c11),
    count : { within(c12, c11), (kind(c12, "attribute") ; kind(c12, "subscript") ; kind(c12, "list_splat_pattern") ; kind(c12, "list_pattern")) } = 0,
    up028_alt_32(c11, T), field(n, "body", c30), kind(c30, "block"),
    k32 = count : { child(c30, c31, _), kind(c31, "expression_statement") }, k32 >= 1,
    k32 <= 1, count : { child(c30, c33, _), !up028_alt_33(c33) } = 0, child(c30, c34, _),
    kind(c34, "expression_statement"), node(_, c34, _, _, _), S = c34, child(c34, c35, _), up028_yielded(c35, V),
    field(n, "right", c36), node(_, c36, _, _, _), IT = c36, value(T, t37), value(V, t37),
    count : { field(n, "left", c39), (kind(c39, "identifier"), node(_, c39, _, _, _), N = c39, up028_stop_1_within(c39, p1_2_4), (kind(p1_2_4, "function_definition") ; kind(p1_2_4, "class_definition") ; kind(p1_2_4, "module")), node(_, p1_2_4, _, _, _), G = p1_2_4, within(c2_2_4, p1_2_4), kind(c2_2_4, "identifier"), node(_, c2_2_4, _, _, _), J = c2_2_4, text(J, t1_1_2_4), text(N, t1_1_2_4), count : { inside(c2_2_4, p3_1_2_4, "expression_statement"), node(_, p3_1_2_4, _, _, _), S2 = p3_1_2_4, text(S2, t4_1_2_4), text(S, t4_1_2_4), @doc(S2) = @doc(S) } = 0, ref_site(c2_2_4, b6_1_2_4), (site_scope(b6_1_2_4, "function") ; site_scope(b6_1_2_4, "class") ; site_scope(b6_1_2_4, "module")), (st7_1_2_4 = b6_1_2_4 ; within(b6_1_2_4, st7_1_2_4)), up028_stop_1_within(st7_1_2_4, p8_1_2_4), (kind(p8_1_2_4, "function_definition") ; kind(p8_1_2_4, "class_definition") ; kind(p8_1_2_4, "module")), node(_, p8_1_2_4, _, _, _), G2 = p8_1_2_4, text(G, t9_1_2_4), text(G2, t9_1_2_4), count : { up028_stop_1_within(c2_2_4, p11_1_2_4), !up028_scope(p11_1_2_4), up028_alt_8(p11_1_2_4, N) } = 0, @doc(J) = @doc(N), @doc(G) = @doc(G2) ; within(c1_5, c39), kind(c1_5, "identifier"), node(_, c1_5, _, _, _), N = c1_5, up028_stop_1_within(c1_5, p1_3_5), (kind(p1_3_5, "function_definition") ; kind(p1_3_5, "class_definition") ; kind(p1_3_5, "module")), node(_, p1_3_5, _, _, _), G = p1_3_5, within(c2_3_5, p1_3_5), kind(c2_3_5, "identifier"), node(_, c2_3_5, _, _, _), J = c2_3_5, text(J, t1_1_3_5), text(N, t1_1_3_5), count : { inside(c2_3_5, p3_1_3_5, "expression_statement"), node(_, p3_1_3_5, _, _, _), S2 = p3_1_3_5, text(S2, t4_1_3_5), text(S, t4_1_3_5), @doc(S2) = @doc(S) } = 0, ref_site(c2_3_5, b6_1_3_5), (site_scope(b6_1_3_5, "function") ; site_scope(b6_1_3_5, "class") ; site_scope(b6_1_3_5, "module")), (st7_1_3_5 = b6_1_3_5 ; within(b6_1_3_5, st7_1_3_5)), up028_stop_1_within(st7_1_3_5, p8_1_3_5), (kind(p8_1_3_5, "function_definition") ; kind(p8_1_3_5, "class_definition") ; kind(p8_1_3_5, "module")), n