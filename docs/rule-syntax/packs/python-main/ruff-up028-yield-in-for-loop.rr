    within_stop(c1, n, up028_stop_12), kind(c1, "identifier"), node(_, c1, _, _, _), D = c1, text(D, t2),
    text(N, t2), within_stop(n, p1, up028_stop_1), precedes(p1, s2), @doc(D) = @doc(N).

