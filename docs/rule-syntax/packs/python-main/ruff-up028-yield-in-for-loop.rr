.decl up028_alt_8(n: node, n_mv: loc)
up028_alt_8(n, N) :- up028_demand_alt_8(n, N), up028_restarting_del(n, N).
up028_alt_8(n, N) :- up028_demand_alt_8(n, N), precedes(n, s1),
    (up028_restarting_del(s1, N) ; within_stop(c1, s1, up028_stop_11), up028_restarting_del(c1, N)).

// stop_12(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl up028_stop_12(n: node)
up028_stop_12(n) :- node(_, n, _, _, _), !kind(n, "expression_list"),
    !kind(n, "parenthesized_expression"), !kind(n, "tuple"), !kind(n, "list").

// alt_17(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl up028_alt_17(n: node, n_mv: loc)
up028_alt_17(n, N) :- up028_demand_alt_17(n, N), up028_bind_x(n, N).
up028_alt_17(n, N) :- up028_demand_alt_17(n, N), within_stop(c1, n, up028_stop_11), up028_bind_x(c1, N).

// alt_32(n): the JSON `any`: n matches if any one of these rules does
//   T: metavariable this relation binds for the calling rule
.decl up028_alt_32(n: node, t: loc)
up028_alt_32(n, T) :- node(_, n, _, _, _), T = n, (kind(n, "identifier") ; kind(n, "pattern_list")).
up028_alt_32(n, T) :- node(_, n, _, _, _), T = n, kind(n, "tuple_pattern"), up028_tok_has_5(n).
up028_alt_32(n, T) :- kind(n, "tuple_pattern"), !up028_tok_has_6(n), child(n, c17, _),
    kind(c17, "identifier"), node(_, c17, _, _, _), T = c17.

// alt_33(n): the JSON `any`: n matches if any one of these rules does
.decl up028_alt_33(n: node)
up028_alt_33(n) :- (kind(n, "comment") ; kind(n, "expression_statement")).
up028_alt_33(n) :- node(_, n, _, _, _), glob(";", n).

// stop_11_within: within_stop over the stop set stop_11, read inside an aggregate
.decl up028_stop_11_within(n: node, a: node)
up028_stop_11_within(x, y) :- within_stop(x, y, up028_stop_11).

// stop_1_within: within_stop over the stop set stop_1, read inside an aggregate
.decl up028_stop_1_within(n: node, a: node)
up028_stop_1_within(x, y) :- within_stop(x, y, up028_stop_1).

// stop_12_within: within_stop over the stop set stop_12, read inside an aggregate
.decl up028_stop_12_within(n: node, a: node)
up028_stop_12_within(x, y) :- within_stop(x, y, up028_stop_12).
