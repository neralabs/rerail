.policy "ruff-npy001-numpy-deprecated-type-alias" revision 1
.guests off
.description "Use the builtin int, float, complex, object or str instead of NumPy's removed aliases for them."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// NPY001(n, detail): findings from clauses `numpy-unicode-alias`, `numpy-builtin-alias`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation NPY001(at: node, name: node, detail: symbol) "Replace `{name}`, {detail} and drop its NumPy import."
    suppress noqa "NPY001"
NPY001(NAME, n, "NumPy's removed alias `numpy.unicode`, with the builtin `str`") :- npy001_alias(n),
    node(_, n, _, _, _), NAME = n.
NPY001(NAME, n, "NumPy's removed alias `numpy.unicode`, with the builtin `str`") :- npy001_in_string(n, NAME).
NPY001(NAME, n, "a removed NumPy alias of a builtin, with that builtin (`numpy.int` is `int`; likewise `float`, `complex`, `object`, `str`)") :- npy001_alias_numpy_builtin_alias(n),
    node(_, n, _, _, _), NAME = n.
NPY001(NAME, n, "a removed NumPy alias of a builtin, with that builtin (`numpy.int` is `int`; likewise `float`, `complex`, `object`, `str`)") :- npy001_in_string_numpy_builtin_alias(n, NAME).

// alias(n): the JSON util `alias`, used where the JSON says `matches: "alias"`
.decl npy001_alias(n: node)
npy001_alias(n) :- (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, "numpy.unicode").
npy001_alias(n) :- kind(n, "dotted_name"), match("\\w+\\s*\\.\\s*(?:unicode)", n),
    inside(n, p1, "case_pattern"), child(n, c2, _), kind(c2, "identifier"),
    sym_of(c2, "numpy").

// in_string(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   NAME: metavariable this relation binds for the calling rule
.decl npy001_in_string(n: node, name: loc)
npy001_in_string(n, NAME) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), npy001_alt_1(c2, NAME).

// alias_numpy_builtin_alias(n): the JSON util `alias`, used where the JSON says `matches: "alias"`
.decl npy001_alias_numpy_builtin_alias(n: node)
npy001_alias_numpy_builtin_alias(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), npy001_set_2(q1).
npy001_alias_numpy_builtin_alias(n) :- kind(n, "dotted_name"),
    match("\\w+\\s*\\.\\s*(?:int|float|complex|object|str)", n),
    inside(n, p2, "case_pattern"), child(n, c3, _), kind(c3, "identifier"),
    sym_of(c3, "numpy").

// in_string_numpy_builtin_alias(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   NAME: metavariable this relation binds for the calling rule
.decl npy001_in_string_numpy_builtin_alias(n: node, name: loc)
npy001_in_string_numpy_builtin_alias(n, NAME) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), npy001_alt_3(c2, NAME).

// set_2: symbols from the JSON `resolves.import`
.decl npy001_set_2(v: symbol)
npy001_set_2("numpy.int"). npy001_set_2("numpy.float"). npy001_set_2("numpy.complex"). npy001_set_2("numpy.object").
npy001_set_2("numpy.str").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl npy001_alt_1(n: node, name: loc)
npy001_alt_1(n, NAME) :- npy001_alias(n), NAME = n.
npy001_alt_1(n, NAME) :- npy001_in_string(n, NAME).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl npy001_alt_3(n: node, name: loc)
npy001_alt_3(n, NAME) :- npy001_alias_numpy_builtin_alias(n), NAME = n.
npy001_alt_3(n, NAME) :- npy001_in_string_numpy_builtin_alias(n, NAME).
