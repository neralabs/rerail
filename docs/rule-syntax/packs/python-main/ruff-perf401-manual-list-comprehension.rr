.stored perf401_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf401_tok_follows_3(n) :- next_sibling(s19, n), glob("else", s19).
perf401_tok_follows_3(n) :- structural_before(n, g21), match("\\s*", g21), child(p22, n, _),
    node(_, n, _, st24, _), o23 = st24 - strlen(g21), token(p22, _, t20, _, o23),
    match("else", t20).
perf401_tok_follows_3(n) :- structural_before(n, g21),
    match("(?s)^(?:(?:.*\\W)?(?:else)\\s*)$", g21).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "^\\+$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf401_tok_has_4(n: node)
.stored perf401_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf401_tok_has_4(n) :- child(n, c27, _), glob("+", c27).
perf401_tok_has_4(n) :- op(n, t28), match("\\+", t28).
perf401_tok_has_4(n) :- child(n, c34, _), structural_before(c34, g29),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\+)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g29).
perf401_tok_has_4(n) :- child(n, c34, _), structural_after(c34, g29),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\+)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g29).
perf401_tok_has_4(n) :- node_text(n, g29), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\+)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g29).

// tok_follows_5(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf401_tok_follows_5(n: node)
.stored perf401_tok_follows_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf401_tok_follows_5(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
perf401_tok_follows_5(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
perf401_tok_follows_5(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_precedes_6(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf401_tok_precedes_6(n: node)
.stored perf401_tok_precedes_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf401_tok_precedes_6(n) :- next_sibling(n, s12), glob("as", s12).
perf401_tok_precedes_6(n) :- structural_after(n, g14), match("\\s*", g14), child(p15, n, _),
    node(_, n, _, _, en18), o16 = en18 + strlen(g14), token(p15, _, t13, o16, _),
    match("as", t13).
perf401_tok_precedes_6(n) :- structural_after(n, g14),
    match("(?s)^(?:\\s*(?:as)(?:\\W.*)?)$", g14).

// tok_precedes_7(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf401_tok_precedes_7(n: node)
.stored perf401_tok_precedes_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf401_tok_precedes_7(n) :- next_sibling(n, s2), glob("as", s2).
perf401_tok_precedes_7(n) :- structural_after(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, _, en8), o6 = en8 + strlen(g4), token(p5, _, t3, o6, _),
    match("as", t3).
perf401_tok_precedes_7(n) :- structural_after(n, g4),
    match("(?s)^(?:\\s*(?:as)(?:\\W.*)?)$", g4).

// tok_has_8(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf401_tok_has_8(n: node)
.stored perf401_tok_has_8 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf401_tok_has_8(n) :- child(n, c1, _), glob("\\,", c1).
perf401_tok_has_8(n) :- op(n, t2), match(",", t2).
perf401_tok_has_8(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
perf401_tok_has_8(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
perf401_tok_has_8(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// tok_has_9(n): a child of n, a named node or an anonymous token, matches "^async$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf401_tok_has_9(n: node)
.stored perf401_tok_has_9 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf401_tok_has_9(n) :- child(n, c1, _), glob("async", c1).
perf401_tok_has_9(n) :- op(n, t2), match("async", t2).
perf401_tok_has_9(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g3).
perf401_tok_has_9(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g3).
perf401_tok_has_9(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g3).

// tok_has_10(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf401_tok_has_10(n: node)
.stored perf401_tok_has_10 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf401_tok_has_10(n) :- child(n, c2, _), glob("\\,", c2).
perf401_tok_has_10(n) :- op(n, t3), match(",", t3).
perf401_tok_has_10(n) :- child(n, c9, _), structural_before(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
perf401_tok_has_10(n) :- child(n, c9, _), structural_after(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
perf401_tok_has_10(n) :- node_text(n, g4), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g4).

// demand_alt_17: the rows of alt_17 its callers ask for (the metavariable columns they pass in)
.decl perf401_demand_alt_17(n: node, for: loc)
perf401_demand_alt_17(n, FOR) :- kind(n, "for_statement"), node(_, n, _, _, _), FOR = n, field(n, "left", c1),
    perf401_loop_target(c1, T).

// demand_alt_19: the rows of alt_19 its callers ask for (the metavariable columns they pass in)
.decl perf401_demand_alt_19(n: node, t: loc)
perf401_demand_alt_19(n, T) :- kind(n, "for_statement"), node(_, n, _, _, _), FOR = n, field(n, "left", c1),
    perf401_loop_target(c1, T), inside(n, p5, "function_definition"), node(_, p5, _, _, _).

// demand_has_ref: the rows of has_ref its callers ask for (the metavariable columns they pass in)
.decl perf401_demand_has_ref(n: node, l: loc)
perf401_demand_has_ref(c2_4, L) :- perf401_call(n, A, L), within_stop(n, p1, perf401_stop_22),
    kind(p1, "expression_statement"), perf401_only_stmt(p1), perf401_list_bound(L), child(p4, p1, _),
    kind(p4, "block"), child(p5, p4, _), kind(p5, "if_statement"), perf401_only_stmt(p5),
    child(p6, p5, _), kind(p6, "block"), child(p7, p6, _),
    field(p5, "condition", c2_4).
perf401_demand_has_ref(A, L) :- perf401_call(n, A, L), within_stop(n, p1, perf401_stop_22),
    kind(p1, "expression_statement"), perf401_only_stmt(p1), perf401_list_bound(L).

// demand_has_nonlocal: the rows of has_nonlocal its callers ask for (the metavariable columns they pass in)
.decl perf401_demand_has_nonlocal(n: node, t: loc)
perf401_demand_has_nonlocal(s1, T) :- perf401_demand_alt_19(n, T), precedes(n, s1).
perf401_demand_has_nonlocal(s3, T) :- perf401_demand_alt_19(n, T), within_stop(n, p2, perf401_stop_18),
    precedes(p2, s3).

// demand_has_post_ref: the rows of has_post_ref its callers ask for (the metavariable columns they pass in)
.decl perf401_demand_has_post_ref(n: node, for: loc)
perf401_demand_has_post_ref(s1, FOR) :- perf401_demand_alt_17(n, FOR), precedes(n, s1).
perf401_demand_has_post_ref(s3, FOR) :- perf401_demand_alt_17(n, FOR), within(n, p2), precedes(p2, s3).

// demand_ref: the rows of ref its callers ask for (the metavariable columns they pass in)
.decl perf401_demand_ref(n: node, l: loc)
perf401_demand_ref(n, L) :- perf401_demand_has_ref(n, L).
perf401_demand_ref(c1, L) :- perf401_demand_has_ref(n, L), within(c1, n).

// demand_post_ref: the rows of post_ref its callers ask for (the metavariable columns they pass in)
.decl perf401_demand_post_ref(n: node, for: loc)
perf401_demand_post_ref(n, FOR) :- perf401_demand_has_post_ref(n, FOR).
perf401_demand_post_ref(c1, FOR) :- perf401_demand_has_post_ref(n, FOR), within(c1, n).

// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl perf401_alt_1_u0_empty(n: node)

// alt_2_u0_empty: level -1 of an unrolled recursion, empty
.decl perf401_alt_2_u0_empty(n: node)

// list_expr_u0_empty: level -1 of an unrolled recursion, empty
.decl perf401_list_expr_u0_empty(n: node)

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_1(n: node)
perf401_alt_1(n) :- perf401_alt_1_u7(n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_2(n: node)
perf401_alt_2(n) :- perf401_alt_2_u7(n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_3(n: node)
perf401_alt_3(n) :- kind(n, "as_pattern"), child(n, c1, _), perf401_tok_precedes_7(c1), perf401_list_init(c1).
perf401_alt_3(n) :- kind(n, "function_definition"), field(n, "return_type", c9),
    kind(c9, "type"), child(c9, c10, _), perf401_list_ann(c10).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_4(n: node)
perf401_alt_4(n) :- ref_site(n, b1), site_only(b1), binding_value(b1, x2), perf401_list_init(x2),
    (st3 = b1 ; within(b1, st3)), count : { child(st3, c4, _), kind(c4, "type") } = 0.
perf401_alt_4(n) :- ref_site(n, b5), site_only(b5), site_annotation(b5, o6), perf401_list_ann(o6),
    (st7 = b5 ; within(b5, st7)),
    count : { child(st7, c8, _), (kind(c8, "list_splat_pattern") ; kind(c8, "dictionary_splat_pattern")) } = 0.
perf401_alt_4(n) :- ref_site(n, b9), site_only(b9), (st10 = b9 ; within(b9, st10)),
    perf401_alt_3(st10).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_6(n: node)
perf401_alt_6(n) :- kind(n, "comment").
perf401_alt_6(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_10(n: node)
perf401_alt_10(n) :- (kind(n, "comment") ; kind(n, "keyword_argument") ; kind(n, "dictionary_splat")).
perf401_alt_10(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
//   A: metavariable this relation binds for the calling rule
.decl perf401_alt_8(n: node, a: loc)
perf401_alt_8(n, A) :- kind(n, "generator_expression"), node(_, n, _, _, _), A = n.
perf401_alt_8(n, A) :- kind(n, "argument_list"), k2 = count : { child(n, c1, _), !perf401_alt_6(c1) },
    k2 >= 1, k2 <= 1, child(n, c3, _), node(_, c3, _, _, _), A = c3, !perf401_alt_10(c3).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_11(n: node)
perf401_alt_11(n) :- kind(n, "comment").
perf401_alt_11(n) :- node(_, n, _, _, _), glob(";", n).

// alt_13(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_13(n: node)
perf401_alt_13(n) :- precedes(s1, n), !perf401_alt_11(s1).
perf401_alt_13(n) :- precedes(n, s2), !perf401_alt_11(s2).

// alt_16(n): the JSON `any`: n matches if any one of these rules does
.decl perf401_alt_16(n: node)
perf401_alt_16(n) :- field(p1, "attribute", n), kind(p1, "attribute").
perf401_alt_16(n) :- field(p2, "name", n),
    (kind(p2, "keyword_argument") ; kind(p2, "default_parameter")).
perf401_alt_16(n) :- child(p3, n, _),
    ( kind(p3, "lambda_parameters")
    ; kind(p3, "list_splat_pattern")
    ; kind(p3, "dictionary_splat_pattern")
    ).


// alt_17(n): the JSON `any`: n matches if any one of these rules does
//   FOR: metavariable of the calling rule, passed in (bound by the caller)
.decl perf401_alt_17(n: node, for: loc)
perf401_alt_17(n, FOR) :- perf401_demand_alt_17(n, FOR), precedes(n, s1), perf401_has_post_ref(s1, FOR).
perf401_alt_17(n, FOR) :- perf401_demand_alt_17(n, FOR), within(n, p2), !kind(p2, "module"),
    precedes(p2, s3), perf401_has_post_ref(s3, FOR).

// stop_18(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl perf401_stop_18(n: node)
perf401_stop_18(n) :- kind(n, "block"), child(p1, n, _), kind(p1, "function_definition").

// alt_19(n): the JSON `any`: n matches if any one of these rules does
//   T: metavariable of the calling rule, passed in (bound by the caller)
.decl perf401_alt_19(n: node, t: loc)
perf401_alt_19(n, T) :- perf401_demand_alt_19(n, T), precedes(n, s1), perf401_has_nonlocal(s1, T).
perf401_alt_19(n, T) :- perf401_demand_alt_19(n, T), within_stop(n, p2, perf401_stop_18), precedes(p2, s3),
    perf401_has_nonlocal(s3, T).

// stop_22(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl perf401_stop_22(n: node)
perf401_stop_22(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").
