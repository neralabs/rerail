.policy "ruff-perf401-manual-list-comprehension" revision 1
.guests off
.description "Use a list comprehension or extend instead of appending to a list inside a for loop; it is shorter and faster."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PERF401(n): a finding at node n, from clause `manual-list-comprehension`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on L, A are added to every rule.
.violation PERF401(at: node, l: loc) "Replace this loop with a list comprehension; if `{l}` is not a fresh empty list assigned just before the loop, use `{l}.extend(...)` of a generator (of a list comprehension under `async for`)."
    suppress noqa "PERF401"
PERF401(n, L) :- perf401_call(n, A, L), within_stop(n, p1, perf401_stop_22),
    kind(p1, "expression_statement"), perf401_only_stmt(p1), !perf401_tok_has_10(p1),
    ( child(p2, p1, _), kind(p2, "block"), child(p3, p2, _), perf401_loop(p3, T), (perf401_tok_has_9(p3) ; count : { value(A, t9_2_5), value(T, t9_2_5) } = 0)
    ; child(p4, p1, _), kind(p4, "block"), child(p5, p4, _), kind(p5, "if_statement"), perf401_only_stmt(p5), count : { field(p5, "alternative", c1_3), (kind(c1_3, "elif_clause") ; kind(c1_3, "else_clause")) } = 0, count : { field(p5, "condition", c2_4), perf401_has_ref(c2_4, L) } = 0, child(p6, p5, _), kind(p6, "block"), child(p7, p6, _), perf401_loop(p7, T)
    ),
    perf401_list_bound(L), !perf401_has_ref(A, L).

// list_expr(n): the JSON util `list-expr`, used where the JSON says `matches: "list-expr"`
.decl perf401_list_expr(n: node)
perf401_list_expr(n) :- perf401_list_expr_u7(n).

// list_callee(n): the JSON util `list-callee`, used where the JSON says `matches: "list-callee"`
.decl perf401_list_callee(n: node)
perf401_list_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "list"), sym_of(n, "builtins.list").
perf401_list_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    perf401_list_callee(c1).

// list_init(n): the JSON util `list-init`, used where the JSON says `matches: "list-init"`
.decl perf401_list_init(n: node)
perf401_list_init(n) :- perf401_list_expr(n).
perf401_list_init(n) :- kind(n, "call"), child(n, c1, _), perf401_list_callee(c1),
    next_sibling(c1, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")).

// list_ann(n): the JSON util `list-ann`, used where the JSON says `matches: "list-ann"`
.decl perf401_list_ann(n: node)
perf401_list_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "list"),
    sym_of(n, "builtins.list").
perf401_list_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.List")
    ; sym_of(n, "_typeshed.List")
    ; sym_of(n, "typing_extensions.List")
    ).

perf401_list_ann(n) :- (kind(n, "subscript") ; kind(n, "generic_type")), child(n, c1, _),
    !perf401_tok_follows_5(c1), perf401_list_ann(c1).
perf401_list_ann(n) :- kind(n, "parenthesized_expression"), child(n, c9, _), perf401_list_ann(c9).

