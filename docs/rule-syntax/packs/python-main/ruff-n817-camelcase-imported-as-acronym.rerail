.policy "ruff-n817-camelcase-imported-as-acronym" revision 1
.guests off
.description "Avoid aliasing a CamelCase import to an acronym of its capital letters; the alias reads like a constant and hides what the name is."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

// N817(n): a finding at node n, from clause `camelcase-imported-as-acronym`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `transform` computes ACRONYM from other metavariables' text; its literals end each rule.
.violation N817(at: node, name: loc, asname: loc) "Import `{name}` under its own name, or a descriptive CamelCase alias, instead of the acronym `{asname}`, and update its uses; keep the alias if your project's convention requires it."
    suppress noqa "N817"
N817(n, NAME, ASNAME) :- kind(n, "aliased_import"), field(n, "name", c2),
    kind(c2, "dotted_name"), child(c2, c3, _), kind(c3, "identifier"),
    child(p4, c3, _), n817_counted_1(c3),
    k6 = count : { child(p4, s5, _), precedes(c3, s5), n817_counted_1(s5) }, k6 = 0,
    node(_, c3, _, _, _), NAME = c3, match(".*\\p{Lowercase}.*", c3), match(".*\\p{Uppercase}.*", c3),
    !contains("_", c3),
    !glob("{setUp,tearDown,setUpClass,tearDownClass,setUpModule,tearDownModule,asyncSetUp,asyncTearDown,setUpTestData,failureException,longMessage,maxDiff}", c3),
    field(n, "alias", c7), kind(c7, "identifier"), node(_, c7, _, _, _), ASNAME = c7,
    text(ASNAME, ACRONYM), !n817_alt_2(n), text(NAME, t1),
    ACRONYM = @replace_all(t1, "\\P{Uppercase}", "").

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^ET$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl n817_tok_has_1(n: node)
.stored n817_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
n817_tok_has_1(n) :- field(n, "alias", c12), glob("ET", c12).
n817_tok_has_1(n) :- op(n, t13), match("ET", t13).
n817_tok_has_1(n) :- child(n, c19, _), structural_before(c19, g14),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g14).
n817_tok_has_1(n) :- child(n, c19, _), structural_after(c19, g14),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g14).
n817_tok_has_1(n) :- node_text(n, g14), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g14).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^ET$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl n817_tok_has_2(n: node)
.stored n817_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
n817_tok_has_2(n) :- field(n, "alias", c23), glob("ET", c23).
n817_tok_has_2(n) :- op(n, t24), match("ET", t24).
n817_tok_has_2(n) :- child(n, c30, _), structural_before(c30, g25),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g25).
n817_tok_has_2(n) :- child(n, c30, _), structural_after(c30, g25),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g25).
n817_tok_has_2(n) :- node_text(n, g25), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g25).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^ET$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl n817_tok_has_3(n: node)
.stored n817_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
n817_tok_has_3(n) :- field(n, "alias", c3), glob("ET", c3).
n817_tok_has_3(n) :- op(n, t4), match("ET", t4).
n817_tok_has_3(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g5).
n817_tok_has_3(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g5).
n817_tok_has_3(n) :- node_text(n, g5), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g5).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "^ET$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl n817_tok_has_4(n: node)
.stored n817_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
n817_tok_has_4(n) :- field(n, "alias", c14), glob("ET", c14).
n817_tok_has_4(n) :- op(n, t15), match("ET", t15).
n817_tok_has_4(n) :- child(n, c21, _), structural_before(c21, g16),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g16).
n817_tok_has_4(n) :- child(n, c21, _), structural_after(c21, g16),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g16).
n817_tok_has_4(n) :- node_text(n, g16), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:ET)(?:\\W.*)?)$", g16).

// counted_1(n): the siblings the JSON `nthChild.ofRule` counts
.decl n817_counted_1(n: node)
n817_counted_1(n) :- kind(n, "identifier").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl n817_alt_2(n: node)
n817_alt_2(n) :- child(p1, n, _), kind(p1, "import_statement"), field(n, "name", c2),
    kind(c2, "dotted_name"),
    match("xml[\\s\\\\]*\\.[\\s\\\\]*etree[\\s\\\\]*\\.[\\s\\\\]*ElementTree", c2),
    n817_tok_has_3(n).
n817_alt_2(n) :- child(p11, n, _), kind(p11, "import_from_statement"),
    field(p11, "module_name", c12), kind(c12, "dotted_name"),
    match("xml[\\s\\\\]*\\.[\\s\\\\]*etree", c12), field(n, "name", c13),
    kind(c13, "dotted_name"), glob("ElementTree", c13), n817_tok_has_4(n).
