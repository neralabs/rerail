.policy "ruff-com818-trailing-comma-on-bare-tuple" revision 1
.guests off
.description "Remove a stray comma at the end of a statement, or parenthesize the tuple; a trailing comma silently turns the value into a tuple."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

// COM818(n): findings from clauses `trailing-comma-on-bare-tuple`, `trailing-comma-at-end-of-file`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation COM818(at: loc, comma: node) "Remove the trailing comma if a single value was meant; if a tuple is intended, parenthesize it as `(value,)`."
    suppress noqa "COM818"
COM818(COMMA, n) :- match(".*(?P<COMMA>,)", n), !kind(n, "comment"), child(p1, n, _),
    (kind(p1, "module") ; kind(p1, "block")),
    ( com818_line_ends_after(n), count : { has(n, c1, "block"), node(_, c1, _, _, _) } = 0
    ; next_sibling(n, s1), kind(s1, "line_continuation"), com818_ends_line(s1)
    ).

COM818(COMMA, n) :- kind(n, "module"),
    match("(?m)(?s:.*)^(?:[^\\r\\n]*?(?:\"\"\"|'''))??(?:[^#'\"\\r\\n]|'(?:[^'\\\\\\r\\n]|\\\\.)*'|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|['\"])*(?P<COMMA>,)[ \\t\\f]*(?:#[^\\r\\n]*|(?:\\\\\\r?\\n[ \\t\\f]*)*\\\\\\r?\\n(?:[ \\t\\f]+(?:#[^\\r\\n]*)?|#[^\\r\\n]*))?", n).

// line_ends_after(n): the JSON util `line-ends-after`, used where the JSON says `matches: "line-ends-after"`
.decl com818_line_ends_after(n: node)
com818_line_ends_after(n) :-
    ( com818_code_after_line(n, l4), end_line(n, l3), k1 = l4 - l3, k1 >= 1
    ; count : { com818_code_after_line(n, l4) } = 0, end_line(n, l3), docof(n, d5), line_count(d5, k6), k1 = k6 - l3, k1 >= 1
    ).


// ends_line(n): the JSON util `ends-line`, used where the JSON says `matches: "ends-line"`
.decl com818_ends_line(n: node)
com818_ends_line(n) :- com818_line_ends_after(n).
com818_ends_line(n) :- next_sibling(n, s1), kind(s1, "line_continuation"), com818_ends_line(s1).

// COM818_trailing_comma_before_assignment_line(n): a finding at node n, from clause `trailing-comma-before-assignment-line`.
// Each rule below is one way the JSON `rule` can match.
.violation COM818_trailing_comma_before_assignment_line(at: node) code "COM818" "Remove the trailing comma if a single value was meant; if a tuple is intended, parenthesize it as `(value,)`."
    suppress noqa "COM818"
COM818_trailing_comma_before_assignment_line(n) :- glob("\\,", n),
    com818_ends_line_trailing_comma_before_assignment_line(n), child(p1, n, _),
    kind(p1, "pattern_list"), child(p2, p1, _),
    (kind(p2, "assignment") ; kind(p2, "augmented_assignment")).

// line_ends_after_trailing_comma_before_assignment_line(n): the JSON util `line-ends-after`, used where the JSON says `matches: "line-ends-after"`
.decl com818_line_ends_after_trailing_comma_before_assignment_line(n: node)
com818_line_ends_after_trailing_comma_before_assignment_line(n) :-
    ( com818_code_after_line(n, l4), end_line(n, l3), k1 = l4 - l3, k1 >= 1
    ; count : { com818_code_after_line(n, l4) } = 0, end_line(n, l3), docof(n, d5), line_count(d5, k6), k1 = k6 - l3, k1 >= 1
    ).


// ends_line_trailing_comma_before_assignment_line(n): the JSON util `ends-line`, used where the JSON says `matches: "ends-line"`
.decl com818_ends_line_trailing_comma_before_assignment_line(n: node)
com818_ends_line_trailing_comma_before_assignment_line(n) :- com818_line_ends_after_trailing_comma_before_assignment_line(n).
com818_ends_line_trailing_comma_before_assignment_line(n) :- next_sibling(n, s1),
    kind(s1, "line_continuation"), com818_ends_line_trailing_comma_before_assignment_line(s1).

// code_comment_start(p, o): a comment child of p starts at offset o
.decl com818_code_comment_start(p: node, o: number)
com818_code_comment_start(p, o) :- child(p, c, _), comment(c, _), node(_, c, _, o, _).

// code_after_line(x, l): the line of the code after x (main's token_after, comments passed over), read from the source gap: the tape leaves out the tokens its grammar implies
.decl com818_code_after_line(x: node, l: number)
com818_code_after_line(x, l) :- structural_after(x, g), match("(?s)\\s*\\S.*", g),
    ws = @replace_all(g, "(?s)\\S.*", ""),
    k = strlen(ws) - strlen(@replace_all(ws, "\n", "")), end_line(x, lx), l = lx + k.
com818_code_after_line(x, l) :- structural_after(x, g), match("\\s*", g), child(p, x, _),
    node(_, x, _, _, e), o = e + strlen(g), token(p, _, _, o, _),
    !com818_code_comment_start(p, o), k = strlen(g) - strlen(@replace_all(g, "\n", "")),
    end_line(x, lx), l = lx + k.
com818_code_after_line(x, l) :- structural_after(x, g), match("\\s*", g), child(p, x, _),
    node(_, x, _, _, e), node(_, p, _, _, pe), pe = e + strlen(g),
    com818_code_after_line(p, l).
com818_code_after_line(x, l) :- structural_after(x, g), match("\\s*", g), child(p, x, _),
    node(_, x, _, _, e), o = e + strlen(g), child(p, c, _), node(_, c, _, o, _),
    comment(c, _), com818_code_after_line(c, l).
