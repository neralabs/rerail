.policy "ruff-ruf046-unnecessary-cast-to-int" revision 1
.guests off
.description "Remove int() around a value that is already an integer, such as a length, an integer literal or arithmetic on integers."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/names.rerail"

// tb(n): the JSON util `tb`, used where the JSON says `matches: "tb"`
.decl ruf046_tb(n: node)
ruf046_tb(n) :- (kind(n, "true") ; kind(n, "false") ; kind(n, "not_operator")).
ruf046_tb(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_tb(c1).
ruf046_tb(n) :- kind(n, "named_expression"), field(n, "value", c2), ruf046_tb(c2).
ruf046_tb(n) :- kind(n, "boolean_operator"), field(n, "left", c3), ruf046_tb(c3),
    field(n, "right", c4), ruf046_tb(c4).
ruf046_tb(n) :- kind(n, "conditional_expression"), child(n, c5, _), ruf046_tb(c5),
    ruf046_tok_precedes_1(c5), child(n, c13, _), ruf046_tb(c13), ruf046_tok_follows_2(c13).

// ti(n): the JSON util `ti`, used where the JSON says `matches: "ti"`
.decl ruf046_ti(n: node)
ruf046_ti(n) :- kind(n, "integer"), !glob("**[jJ]", n).
ruf046_ti(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_ti(c1).
ruf046_ti(n) :- kind(n, "named_expression"), field(n, "value", c2), ruf046_ti(c2).
ruf046_ti(n) :- kind(n, "unary_operator"), ruf046_tok_has_3(n), field(n, "argument", c11), ruf046_ib(c11).
ruf046_ti(n) :- kind(n, "binary_operator"), ruf046_tok_has_4(n), field(n, "left", c20), ruf046_ib(c20),
    field(n, "right", c21), ruf046_ib(c21).
ruf046_ti(n) :- kind(n, "boolean_operator"), field(n, "left", c22), ruf046_ib(c22),
    field(n, "right", c23), ruf046_ib(c23), ruf046_alt_1(n).
ruf046_ti(n) :- kind(n, "conditional_expression"), child(n, c26, _), ruf046_ib(c26),
    ruf046_tok_precedes_5(c26), child(n, c34, _), ruf046_ib(c34), ruf046_tok_follows_6(c34), ruf046_alt_2(n).

// ib(n): the JSON util `ib`, used where the JSON says `matches: "ib"`
.decl ruf046_ib(n: node)
ruf046_ib(n) :- ruf046_ti(n).
ruf046_ib(n) :- ruf046_tb(n).

// none_p(n): the JSON util `none-p`, used where the JSON says `matches: "none-p"`
.decl ruf046_none_p(n: node)
ruf046_none_p(n) :- kind(n, "none").
ruf046_none_p(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_none_p(c1).

// int_callee_family(n, key): 3 copies of one rule set (`int-callee`, `int-ref`, `round-callee`), folded into one: row `key` of
// int_callee_family_case gives the strings each copy had.
.decl ruf046_int_callee_family(n: node, key: symbol)
ruf046_int_callee_family(n, q1) :- ruf046_int_callee_family_case(q1, s1, s2),
    (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, s1), sym_of(n, s2).
ruf046_int_callee_family(n, q1) :- ruf046_int_callee_family_case(q1, s1, s2),
    kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_int_callee_family(c1, q1).

// always_int_fn(n): the JSON util `always-int-fn`, used where the JSON says `matches: "always-int-fn"`
.decl ruf046_always_int_fn(n: node)
ruf046_always_int_fn(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, g1), ruf046_set_3(g1), sym_of(n, q2), ruf046_set_4(q2).
ruf046_always_int_fn(n) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    ruf046_always_int_fn(c3).

// rounding_fn(n): the JSON util `rounding-fn`, used where the JSON says `matches: "rounding-fn"`
.decl ruf046_rounding_fn(n: node)
ruf046_rounding_fn(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (sym_of(n, "math.ceil") ; sym_of(n, "math.floor") ; sym_of(n, "math.trunc")).
ruf046_rounding_fn(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ruf046_rounding_fn(c1).

// positional(n): the JSON util `positional`, used where the JSON says `matches: "positional"`
.decl ruf046_positional(n: node)
ruf046_positional(n) :- node(_, n, _, _, _), !ruf046_alt_6(n).

// pos0(n): the JSON util `pos0`, used where the JSON says `matches: "pos0"`
.decl ruf046_pos0(n: node)
ruf046_pos0(n) :- ruf046_positional(n), count : { precedes(s1, n), ruf046_positional(s1) } = 0.

// pos1(n): the JSON util `pos1`, used where the JSON says `matches: "pos1"`
.decl ruf046_pos1(n: node)
ruf046_pos1(n) :- ruf046_positional(n), child(p1, n, _), ruf046_counted_8(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), ruf046_counted_8(s2) }, k3 = 1.

// kw_number(n): the JSON util `kw-number`, used where the JSON says `matches: "kw-number"`
.decl ruf046_kw_number(n: node)
ruf046_kw_number(n) :- kind(n, "keyword_argument"), ruf046_tok_has_11(n).

// kw_ndigits(n): the JSON util `kw-ndigits`, used where the JSON says `matches: "kw-ndigits"`
.decl ruf046_kw_ndigits(n: node)
ruf046_kw_ndigits(n) :- kind(n, "keyword_argument"), ruf046_tok_has_12(n).

// int_ann(n): the JSON util `int-ann`, used where the JSON says `matches: "int-ann"`
.decl ruf046_int_ann(n: node)
ruf046_int_ann(n) :- kind(n, "type"), child(n, c1, _), ruf046_int_ann(c1).
ruf046_int_ann(n) :- ruf046_int_callee_family(n, "int_ref").
ruf046_int_ann(n) :- kind(n, "generic_type"), child(n, c2, _), kind(c2, "identifier"),
    ruf046_int_callee_family(c2, "int_ref").
ruf046_int_ann(n) :- kind(n, "subscript"), field(n, "value", c3),
    ruf046_int_callee_family(c3, "int_ref").
ruf046_int_ann(n) :- kind(n, "parenthesized_expression"), child(n, c4, _), ruf046_int_ann(c4).

// int_init(n): the JSON util `int-init`, used where the JSON says `matches: "int-init"`
.decl ruf046_int_init(n: node)
ruf046_int_init(n) :- ruf046_ti(n).
ruf046_int_init(n) :- kind(n, "call"), field(n, "function", c1),
    ruf046_int_callee_family(c1, "int_callee").

// int_name(n): the JSON util `int-name`, used where the JSON says `matches: "int-name"`
.decl ruf046_int_name(n: node)
ruf046_int_name(n) :- kind(n, "identifier"), ref_site(n, b1), site_only(b1), st2 = b1,
    count : { child(st2, c3, _), (kind(c3, "list_splat_pattern") ; kind(c3, "dictionary_splat_pattern")) } = 0,
    site_annotation(b1, o4), ruf046_int_ann(o4).
ruf046_int_name(n) :- kind(n, "identifier"), ref_site(n, b5), site_only(b5),
    (st6 = b5 ; within(b5, st6)),
    ( kind(st6, "assignment"), count : { field(st6, "type", c1), kind(c1, "type") } = 0
    ; kind(st6, "named_expression")
    ),
    binding_value(b5, x8), ruf046_int_init(x8).
ruf046_int_name(n) :- kind(n, "identifier"), ref_site(n, b9), site_only(b9),
    (st10 = b9 ; within(b9, st10)), kind(st10, "as_pattern"), child(st10, c11, _),
    ruf046_int_init(c11), ruf046_tok_precedes_13(c11), field(st10, "alias", c19),
    kind(c19, "as_pattern_target"), child(c19, c20, _), kind(c20, "identifier").
ruf046_int_name(n) :- kind(n, "identifier"), ref_site(n, b21), site_only(b21),
    (st22 = b21 ; within(b21, st22)), kind(st22, "function_definition"),
    field(st22, "return_type", c23), ruf046_int_ann(c23).
ruf046_int_name(n) :- kind(n, "parenthesized_expression"), child(n, c24, _), ruf046_int_name(c24).

// int_like(n): the JSON util `int-like`, used where the JSON says `matches: "int-like"`
.decl ruf046_int_like(n: node)
ruf046_int_like(n) :- ruf046_ti(n).
ruf046_int_like(n) :- ruf046_int_name(n).

// round_args(n): the JSON util `round-args`, used where the JSON says `matches: "round-args"`
.decl ruf046_round_args(n: node)
ruf046_round_args(n) :- kind(n, "argument_list"),
    count : { child(n, c1, _), (kind(c1, "list_splat") ; kind(c1, "dictionary_splat")) } = 0,
    k3 = count : { child(n, c2, _), !ruf046_arg_trivia(c2) }, k3 <= 2,
    (ruf046_alt_11(n), ruf046_alt_12(n) ; ruf046_alt_13(n), ruf046_alt_14(n)).

// round_call(n): the JSON util `round-call`, used where the JSON says `matches: "round-call"`
.decl ruf046_round_call(n: node)
ruf046_round_call(n) :- kind(n, "call"), field(n, "function", c1),
    ruf046_int_callee_family(c1, "round_callee"),
    ( field(n, "arguments", c2), ruf046_round_args(c2)
    ; field(n, "arguments", c3), kind(c3, "generator_expression")
    ).


// rounding_call(n): the JSON util `rounding-call`, used where the JSON says `matches: "rounding-call"`
.decl ruf046_rounding_call(n: node)
ruf046_rounding_call(n) :- kind(n, "call"),
    (field(n, "function", c1), ruf046_rounding_fn(c1) ; ruf046_round_call(n)).

// int_fn_call(n): the JSON util `int-fn-call`, used where the JSON says `matches: "int-fn-call"`
.decl ruf046_int_fn_call(n: node)
ruf046_int_fn_call(n) :- kind(n, "call"), field(n, "function", c1), ruf046_always_int_fn(c1).

// arg_int(n): the JSON util `arg-int`, used where the JSON says `matches: "arg-int"`
.decl ruf046_arg_int(n: node)
ruf046_arg_int(n) :- ruf046_ti(n).
ruf046_arg_int(n) :- ruf046_int_fn_call(n).
ruf046_arg_int(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_arg_int(c1).

// arg_rounded(n): the JSON util `arg-rounded`, used where the JSON says `matches: "arg-rounded"`
.decl ruf046_arg_rounded(n: node)
ruf046_arg_rounded(n) :- ruf046_rounding_call(n).
ruf046_arg_rounded(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ruf046_arg_rounded(c1).

// arg_trivia(n): the JSON util `arg-trivia`, used where the JSON says `matches: "arg-trivia"`
.decl ruf046_arg_trivia(n: node)
ruf046_arg_trivia(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
ruf046_arg_trivia(n) :- node(_, n, _, _, _), glob("[(),]", n).

// cast_of_int(n): the JSON util `cast-of-int`, used where the JSON says `matches: "cast-of-int"`
.decl ruf046_cast_of_int(n: node)
ruf046_cast_of_int(n) :- kind(n, "call"), field(n, "function", c1),
    ruf046_int_callee_family(c1, "int_callee"), field(n, "arguments", c2),
    kind(c2, "argument_list"), k4 = count : { child(c2, c3, _), !ruf046_arg_trivia(c3) },
    k4 >= 1, k4 <= 1, child(c2, c5, _), ruf046_arg_int(c5).

// cast_of_int_in_type(n): the JSON util `cast-of-int-in-type`, used where the JSON says `matches: "cast-of-int-in-type"`
//   C: metavariable this relation binds for the calling rule
.decl ruf046_cast_of_int_in_type(n: node, c: loc)
ruf046_cast_of_int_in_type(n, C) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ruf046_alt_22(c2, C).

// cast_of_rounded(n): the JSON util `cast-of-rounded`, used where the JSON says `matches: "cast-of-rounded"`
.decl ruf046_cast_of_rounded(n: node)
ruf046_cast_of_rounded(n) :- kind(n, "call"), field(n, "function", c1),
    ruf046_int_callee_family(c1, "int_callee"), field(n, "arguments", c2),
    kind(c2, "argument_list"), k4 = count : { child(c2, c3, _), !ruf046_arg_trivia(c3) },
    k4 >= 1, k4 <= 1, child(c2, c5, _), ruf046_arg_rounded(c5).

// cast_of_rounded_in_type(n): the JSON util `cast-of-rounded-in-type`, used where the JSON says `matches: "cast-of-rounded-in-type"`
//   C: metavariable this relation binds for the calling rule
.decl ruf046_cast_of_rounded_in_type(n: node, c: loc)
ruf046_cast_of_rounded_in_type(n, C) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ruf046_alt_23(c2, C).

// RUF046(n, detail): findings from clauses `int-of-integer`, `int-of-rounding`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// The JSON `constraints` on F, A are added to every rule.
.violation RUF046(at: node, detail: symbol) "Drop the `int(...)` {detail}."
    suppress noqa "RUF046"
RUF046(n, "wrapper and use its argument directly; the argument is already an integer") :- kind(n, "call"),
    n ~ `$F($A)`, ruf046_int_callee_family(F, "int_callee"), ruf046_arg_int(A).
RUF046(n, "wrapper; this call already returns an int. Keep it if the operand's type overrides `__round__`, `__ceil__`, `__floor__` or `__trunc__` to return a non-int") :- kind(n, "call"),
    n ~ `$F($A)`, ruf046_int_callee_family(F, "int_callee"), ruf046_arg_rounded(A).

// RUF046_int_of_integer_in_string_type(n, detail): findings from clauses `int-of-integer-in-string-type`, `int-of-rounding-in-string-type`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF046_int_of_integer_in_string_type(at: loc, c: node, detail: symbol) code "RUF046" "Drop the `int(...)` {detail}."
    suppress noqa "RUF046"
RUF046_int_of_integer_in_string_type(C, n, "wrapper and use its argument directly; the argument is already an integer") :- ruf046_cast_of_int_in_type(n, C).
RUF046_int_of_integer_in_string_type(C, n, "wrapper; this call already returns an int. Keep it if the operand's type overrides `__round__`, `__ceil__`, `__floor__` or `__trunc__` to return a non-int") :- ruf046_cast_of_rounded_in_type(n, C).

// tok_precedes_1(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf046_tok_precedes_1(n: node)
.stored ruf046_tok_precedes_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf046_tok_precedes_1(n) :- precedes(n, s6), glob("if", s6).
ruf046_tok_precedes_1(n) :- child(p9, n, _), node(_, n, _, _, en12),
    token(p9, _, t7, st11, _), st11 >= en12, match("if", t7).
ruf046_tok_precedes_1(n) :- structural_after(n, g8),
    match("(?s)^(?:(?:.*\\W)?(?:if)(?:\\W.*)?)$", g8).
ruf046_tok_precedes_1(n) :- precedes(n, o10), structural_after(o10, g8),
    match("(?s)^(?:(?:.*\\W)?(?:if)(?:\\W.*)?)$", g8).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf046_tok_follows_2(n: node)
.stored ruf046_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf046_tok_follows_2(n) :- precedes(s14, n), glob("else", s14).
ruf046_tok_follows_2(n) :- child(p17, n, _), node(_, n, _, st19, _),
    token(p17, _, t15, _, en20), en20 <= st19, match("else", t15).
ruf046_tok_follows_2(n) :- structural_before(n, g16),
    match("(?s)^(?:(?:.*\\W)?(?:else)(?:\\W.*)?)$", g16).
ruf046_tok_follows_2(n) :- precedes(o18, n), structural_before(o18, g16),
    match("(?s)^(?:(?:.*\\W)?(?:else)(?:\\W.*)?)$", g16).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^[-+~]$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf046_tok_has_3(n: node)
.stored ruf046_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf046_tok_has_3(n) :- field(n, "operator", c3), glob("[-+~]", c3).
ruf046_tok_has_3(n) :- op(n, t4), match("[-+~]", t4).
ruf046_tok_has_3(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:[-+~])(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).
ruf046_tok_has_3(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:[-+~])(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).
ruf046_tok_has_3(n) :- node_text(n, g5), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:[-+~])(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "^(\\+|-|%|\\*|//|\\*\\*|&|\\||\\^|<<|>>)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf046_tok_has_4(n: node)
.stored ruf046_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf046_tok_has_4(n) :- field(n, "operator", c12),
    glob("{+,-,%,\\*,//,\\*\\*,&,|,^,<<,>>}", c12).
ruf046_tok_has_4(n) :- op(n, t13), match("(\\+|-|%|\\*|//|\\*\\*|&|\\||\\^|<<|>>)", t13).
ruf046_tok_has_4(n) :- child(n, c19, _), structural_before(c19, g14),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\+)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:-)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:%)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\*)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?://)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\*\\*)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:&)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\|)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\^)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g14).
ruf046_tok_has_4(n) :- child(n, c19, _), structural_after(c19, g14),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\+)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:-)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:%)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\*)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?://)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\*\\*)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:&)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\|)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\^)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g14).
ruf046_tok_has_4(n) :- node_text(n, g14), !child(n, _, _),
