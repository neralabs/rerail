.policy "ruff-up014-convert-named-tuple-functional-to-class" revision 1
.guests off
.description "Define named tuples with class syntax instead of the functional NamedTuple call; the class form is easier to read."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// plain_text(n): the JSON util `plain-text`, used where the JSON says `matches: "plain-text"`
.decl up014_plain_text(n: node)
up014_plain_text(n) :- kind(n, "string"), !match("[A-Za-z]*[bBfFtT].*", n).
up014_plain_text(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[bBfFtT].*", c1) } = 0.
up014_plain_text(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), up014_plain_text(c2).

// arg_node(n): the JSON util `arg-node`, used where the JSON says `matches: "arg-node"`
.decl up014_arg_node(n: node)
up014_arg_node(n) :- node(_, n, _, _, _), !up014_alt_1(n).

// keyword_arg(n): the JSON util `keyword-arg`, used where the JSON says `matches: "keyword-arg"`
.decl up014_keyword_arg(n: node)
up014_keyword_arg(n) :- (kind(n, "keyword_argument") ; kind(n, "dictionary_splat")).

// positional_arg(n): the JSON util `positional-arg`, used where the JSON says `matches: "positional-arg"`
.decl up014_positional_arg(n: node)
up014_positional_arg(n) :- up014_arg_node(n), !up014_keyword_arg(n).

// one_positional(n): the JSON util `one-positional`, used where the JSON says `matches: "one-positional"`
.decl up014_one_positional(n: node)
up014_one_positional(n) :- kind(n, "argument_list"),
    k2 = count : { child(n, c1, _), up014_positional_arg(c1) }, k2 >= 1, k2 <= 1.

// no_keywords(n): the JSON util `no-keywords`, used where the JSON says `matches: "no-keywords"`
.decl up014_no_keywords(n: node)
up014_no_keywords(n) :- kind(n, "argument_list"),
    count : { child(n, c1, _), up014_keyword_arg(c1) } = 0.

// no_splat_keywords(n): the JSON util `no-splat-keywords`, used where the JSON says `matches: "no-splat-keywords"`
.decl up014_no_splat_keywords(n: node)
up014_no_splat_keywords(n) :- kind(n, "argument_list"),
    count : { child(n, c1, _), kind(c1, "dictionary_splat") } = 0.

// two_positional(n): the JSON util `two-positional`, used where the JSON says `matches: "two-positional"`
.decl up014_two_positional(n: node)
up014_two_positional(n) :- kind(n, "argument_list"),
    k2 = count : { child(n, c1, _), up014_positional_arg(c1) }, k2 >= 2, k2 <= 2.

// second_positional(n): the JSON util `second-positional`, used where the JSON says `matches: "second-positional"`
.decl up014_second_positional(n: node)
up014_second_positional(n) :- up014_positional_arg(n), precedes(s1, n), up014_positional_arg(s1).

// named_tuple_ref(n): the JSON util `named-tuple-ref`, used where the JSON says `matches: "named-tuple-ref"`
//   BASE: metavariable this relation binds for the calling rule
.decl up014_named_tuple_ref(n: node, base: loc)
up014_named_tuple_ref(n, BASE) :- (kind(n, "identifier") ; kind(n, "attribute")),
    node(_, n, _, _, _), BASE = n,
    ( sym_of(n, "typing.NamedTuple")
    ; sym_of(n, "typing_extensions.NamedTuple")
    ; sym_of(n, "_typeshed.NamedTuple")
    ).


// named_tuple_callee(n): the JSON util `named-tuple-callee`, used where the JSON says `matches: "named-tuple-callee"`
//   BASE: metavariable this relation binds for the calling rule
.decl up014_named_tuple_callee(n: node, base: loc)
up014_named_tuple_callee(n, BASE) :- up014_named_tuple_ref(n, BASE).
up014_named_tuple_callee(n, BASE) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    up014_named_tuple_callee(c1, BASE).

// name_target(n): the JSON util `name-target`, used where the JSON says `matches: "name-target"`
//   NAME: metavariable this relation binds for the calling rule
.decl up014_name_target(n: node, name: loc)
up014_name_target(n, NAME) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n.
up014_name_target(n, NAME) :- kind(n, "tuple_pattern"), !up014_tok_has_1(n), child(n, c9, _),
    up014_name_target(c9, NAME).

// named_tuple_value(n): the JSON util `named-tuple-value`, used where the JSON says `matches: "named-tuple-value"`
//   BASE: metavariable this relation binds for the calling rule
.decl up014_named_tuple_value(n: node, base: loc)
up014_named_tuple_value(n, BASE) :- kind(n, "call"), field(n, "function", c1),
    up014_named_tuple_callee(c1, BASE), field(n, "arguments", c2), up014_named_tuple_arguments(c2).
up014_named_tuple_value(n, BASE) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    up014_named_tuple_value(c3, BASE).

// named_tuple_field_name(n): the JSON util `named-tuple-field-name`, used where the JSON says `matches: "named-tuple-field-name"`
.decl up014_named_tuple_field_name(n: node)
up014_named_tuple_field_name(n) :- up014_plain_text(n),
    value(n, v1), match("[\\p{XID_Start}_]\\p{XID_Continue}*", v1), !up014_alt_2(n).

// field_tuple(n): the JSON util `field-tuple`, used where the JSON says `matches: "field-tuple"`
.decl up014_field_tuple(n: node)
up014_field_tuple(n) :- kind(n, "tuple"), child(n, c1, _), up014_named_tuple_field_name(c1),
    count : { precedes(s2, c1), up014_arg_node(s2) } = 0,
    count : { child(n, c3, _), kind(c3, "list_splat") } = 0,
    k5 = count : { child(n, c4, _), up014_arg_node(c4) }, k5 >= 2, k5 <= 2.
up014_field_tuple(n) :- kind(n, "parenthesized_expression"), child(n, c6, _),
    up014_field_tuple(c6).

// field_list(n): the JSON util `field-list`, used where the JSON says `matches: "field-list"`
.decl up014_field_list(n: node)
up014_field_list(n) :- kind(n, "list"),
    count : { child(n, c1, _), up014_arg_node(c1), !up014_field_tuple(c1) } = 0.
up014_field_list(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), up014_field_list(c2).

// named_tuple_arguments(n): the JSON util `named-tuple-arguments`, used where the JSON says `matches: "named-tuple-arguments"`
.decl up014_named_tuple_arguments(n: node)
up014_named_tuple_arguments(n) :- kind(n, "generator_expression").
up014_named_tuple_arguments(n) :- up014_one_positional(n), up014_no_splat_keywords(n).
up014_named_tuple_arguments(n) :- up014_two_positional(n), up014_no_keywords(n), child(n, c1, _),
    up014_second_positional(c1), up014_field_list(c1).

// UP014(n): a finding at node n, from clause `named-tuple-functional`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation UP014(at: node, name: loc, base: loc) "Define `{name}` as `class {name}({base}):` with one `field: type` line per field, in the same order."
    suppress noqa "UP014"
UP014(n, NAME, BASE) :- kind(n, "assignment"),
    count : { child(p1, n, _), kind(p1, "assignment") } = 0, field(n, "left", c2),
    up014_name_target(c2, NAME), count : { field(n, "type", c3), kind(c3, "type") } = 0,
    field(n, "right", c4), up014_named_tuple_value(c4, BASE).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up014_tok_has_1(n: node)
.stored up014_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up014_tok_has_1(n) :- child(n, c1, _), glob("\\,", c1).
up014_tok_has_1(n) :- op(n, t2), match(",", t2).
up014_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
up014_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
up014_tok_has_1(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl up014_alt_1(n: node)
up014_alt_1(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
up014_alt_1(n) :- node(_, n, _, _, _), glob("[()\\[\\],]", n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl up014_alt_2(n: node)
up014_alt_2(n) :- value(n, v1), glob("{False,None,True,and,as,assert,async,await,break,class,continue,def,del,elif,else,except,finally,for,from,global,if,import,in,is,lambda,nonlocal,not,or,pass,raise,return,try,while,with,yield}", v1).
up014_alt_2(n) :- value(n, v2), glob("__{_,**__,}", v2).
