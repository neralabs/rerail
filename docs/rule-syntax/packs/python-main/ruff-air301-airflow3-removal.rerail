.policy "ruff-air301-airflow3-removal" revision 1
.guests off
.description "Replace or remove the APIs, arguments and context keys that Airflow 3 removed, so the code keeps working after the upgrade."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).
// ast(n, {…}) atoms are JSON terms with no .rerail form yet; the engine matches them as it does today.

#include "python/names.rerail"

// op_site(n): the JSON util `op-site`, used where the JSON says `matches: "op-site"`
.decl air301_op_site(n: node)
air301_op_site(n) :- (kind(n, "dotted_name") ; kind(n, "aliased_import")), air301_from_mod(n, "op").
air301_op_site(n) :- kind(n, "aliased_import"), child(p1, n, _), kind(p1, "import_statement"),
    air301_tok_has_1(n).

// op_head_site(n): the JSON util `op-head-site`, used where the JSON says `matches: "op-head-site"`
.decl air301_op_head_site(n: node)
air301_op_head_site(n) :- air301_op_site(n).
air301_op_head_site(n) :- inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), kind(c2, "dotted_name"),
    match("airflow\\.providers(\\.\\w+)*", c2),
    ( kind(n, "dotted_name"), glob("operators", n)
    ; kind(n, "aliased_import"), air301_tok_has_3(n)
    ).

air301_op_head_site(n) :- kind(n, "aliased_import"), child(p11, n, _),
    kind(p11, "import_statement"), air301_tok_has_4(n).

// op_head(n): the JSON util `op-head`, used where the JSON says `matches: "op-head"`
.decl air301_op_head(n: node)
air301_op_head(n) :- kind(n, "identifier"), ref_site(n, b1), st2 = b1, air301_op_head_site(st2).
air301_op_head(n) :- kind(n, "attribute"), field(n, "object", c3), air301_op_head(c3).
air301_op_head(n) :- kind(n, "parenthesized_expression"), child(n, c4, _), air301_op_head(c4).

// op_chain(n): the JSON util `op-chain`, used where the JSON says `matches: "op-chain"`
.decl air301_op_chain(n: node)
air301_op_chain(n) :- kind(n, "attribute"), air301_tok_has_5(n).
air301_op_chain(n) :- kind(n, "attribute"), field(n, "object", c9), air301_op_chain(c9).
air301_op_chain(n) :- kind(n, "parenthesized_expression"), child(n, c10, _), air301_op_chain(c10).

// op_callee(n): the JSON util `op-callee`, used where the JSON says `matches: "op-callee"`
.decl air301_op_callee(n: node)
air301_op_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), match("(airflow\\.operators)(\\.|$).*", q1).
air301_op_callee(n) :- kind(n, "identifier"), ref_site(n, b2), st3 = b2, air301_op_site(st3).
air301_op_callee(n) :- kind(n, "attribute"),
    sym_of(n, q4), match("(airflow\\.providers)(\\.|$).*", q4),
    (field(n, "object", c1), air301_op_chain(c1) ; field(n, "object", c2), air301_op_head(c2)).
air301_op_callee(n) :- kind(n, "parenthesized_expression"), child(n, c7, _), air301_op_callee(c7).

// op_class(n): the JSON util `op-class`, used where the JSON says `matches: "op-class"`
.decl air301_op_class(n: node)
air301_op_class(n) :- air301_op_callee(n), air301_last(n, "op").

// handler_site(n): the JSON util `handler-site`, used where the JSON says `matches: "handler-site"`
.decl air301_handler_site(n: node)
air301_handler_site(n) :- (kind(n, "dotted_name") ; kind(n, "aliased_import")),
    air301_from_mod(n, "handler").
air301_handler_site(n) :- kind(n, "aliased_import"), child(p1, n, _),
    kind(p1, "import_statement"), air301_tok_has_6(n).

// handler_head_site(n): the JSON util `handler-head-site`, used where the JSON says `matches: "handler-head-site"`
.decl air301_handler_head_site(n: node)
air301_handler_head_site(n) :- air301_handler_site(n).
air301_handler_head_site(n) :- inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), kind(c2, "dotted_name"),
    match("airflow\\.providers(\\.\\w+)*", c2),
    (kind(n, "dotted_name"), glob("log", n) ; kind(n, "aliased_import"), air301_tok_has_8(n)).
air301_handler_head_site(n) :- kind(n, "aliased_import"), child(p11, n, _),
    kind(p11, "import_statement"), air301_tok_has_9(n).

// handler_head(n): the JSON util `handler-head`, used where the JSON says `matches: "handler-head"`
.decl air301_handler_head(n: node)
air301_handler_head(n) :- kind(n, "identifier"), ref_site(n, b1), st2 = b1,
    air301_handler_head_site(st2).
air301_handler_head(n) :- kind(n, "attribute"), field(n, "object", c3), air301_handler_head(c3).
air301_handler_head(n) :- kind(n, "parenthesized_expression"), child(n, c4, _),
    air301_handler_head(c4).

// handler_chain(n): the JSON util `handler-chain`, used where the JSON says `matches: "handler-chain"`
.decl air301_handler_chain(n: node)
air301_handler_chain(n) :- kind(n, "attribute"), air301_tok_has_10(n).
air301_handler_chain(n) :- kind(n, "attribute"), field(n, "object", c9), air301_handler_chain(c9).
air301_handler_chain(n) :- kind(n, "parenthesized_expression"), child(n, c10, _),
    air301_handler_chain(c10).

// handler_callee(n): the JSON util `handler-callee`, used where the JSON says `matches: "handler-callee"`
.decl air301_handler_callee(n: node)
air301_handler_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), match("(airflow\\.log)(\\.|$).*", q1).
air301_handler_callee(n) :- kind(n, "identifier"), ref_site(n, b2), st3 = b2,
    air301_handler_site(st3).
air301_handler_callee(n) :- kind(n, "attribute"),
    sym_of(n, q4), match("(airflow\\.providers)(\\.|$).*", q4),
    ( field(n, "object", c1), air301_handler_chain(c1)
    ; field(n, "object", c2), air301_handler_head(c2)
    ).

air301_handler_callee(n) :- kind(n, "parenthesized_expression"), child(n, c7, _),
    air301_handler_callee(c7).

// handler_class(n): the JSON util `handler-class`, used where the JSON says `matches: "handler-class"`
.decl air301_handler_class(n: node)
air301_handler_class(n) :- air301_handler_callee(n), air301_last(n, "handler").

// from_mod(n, key): 5 copies of one rule set (`authmgr-from-mod`, `backend-from-mod`, `handler-from-mod` and 2 more), folded into one: row `key` of
// from_mod_case gives the strings each copy had.
.decl air301_from_mod(n: node, air301_key: symbol)
air301_from_mod(n, q1) :- air301_from_mod_case(q1, s1), inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), kind(c2, "dotted_name"), match(s1, c2).

// authmgr_site(n): the JSON util `authmgr-site`, used where the JSON says `matches: "authmgr-site"`
.decl air301_authmgr_site(n: node)
air301_authmgr_site(n) :- (kind(n, "dotted_name") ; kind(n, "aliased_import")),
    air301_from_mod(n, "authmgr").
air301_authmgr_site(n) :- kind(n, "aliased_import"), child(p1, n, _),
    kind(p1, "import_statement"), air301_tok_has_11(n).

// authmgr_head_site(n): the JSON util `authmgr-head-site`, used where the JSON says `matches: "authmgr-head-site"`
.decl air301_authmgr_head_site(n: node)
air301_authmgr_head_site(n) :- air301_authmgr_site(n).
air301_authmgr_head_site(n) :- inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), kind(c2, "dotted_name"),
    match("airflow\\.providers(\\.\\w+)*", c2),
    ( kind(n, "dotted_name"), glob("auth_manager", n)
    ; kind(n, "aliased_import"), air301_tok_has_13(n)
    ).

air301_authmgr_head_site(n) :- kind(n, "aliased_import"), child(p11, n, _),
    kind(p11, "import_statement"), air301_tok_has_14(n).

// authmgr_head(n): the JSON util `authmgr-head`, used where the JSON says `matches: "authmgr-head"`
.decl air301_authmgr_head(n: node)
air301_authmgr_head(n) :- kind(n, "identifier"), ref_site(n, b1), st2 = b1,
    air301_authmgr_head_site(st2).
air301_authmgr_head(n) :- kind(n, "attribute"), field(n, "object", c3), air301_authmgr_head(c3).
air301_authmgr_head(n) :- kind(n, "parenthesized_expression"), child(n, c4, _),
    air301_authmgr_head(c4).

// authmgr_chain(n): the JSON util `authmgr-chain`, used where the JSON says `matches: "authmgr-chain"`
.decl air301_authmgr_chain(n: node)
air301_authmgr_chain(n) :- kind(n, "attribute"), air301_tok_has_15(n).
air301_authmgr_chain(n) :- kind(n, "attribute"), field(n, "object", c9), air301_authmgr_chain(c9).
air301_authmgr_chain(n) :- kind(n, "parenthesized_expression"), child(n, c10, _),
    air301_authmgr_chain(c10).

// authmgr_callee(n): the JSON util `authmgr-callee`, used where the JSON says `matches: "authmgr-callee"`
.decl air301_authmgr_callee(n: node)
air301_authmgr_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), match("(airflow\\.auth\\.manager)(\\.|$).*", q1).
air301_authmgr_callee(n) :- kind(n, "identifier"), ref_site(n, b2), st3 = b2,
    air301_authmgr_site(st3).
air301_authmgr_callee(n) :- kind(n, "attribute"),
    sym_of(n, q4), match("(airflow\\.providers)(\\.|$).*", q4),
    ( field(n, "object", c1), air301_authmgr_chain(c1)
    ; field(n, "object", c2), air301_authmgr_head(c2)
    ).

air301_authmgr_callee(n) :- kind(n, "parenthesized_expression"), child(n, c7, _),
    air301_authmgr_callee(c7).

// last(n, key): 5 copies of one rule set (`authmgr-last`, `backend-last`, `handler-last` and 2 more), folded into one: row `key` of
// last_case gives the strings each copy had.
.decl air301_last(n: node, air301_key: symbol)
air301_last(n, q1) :- air301_demand_last(n), air301_last_case(q1, s1), kind(n, "attribute"),
    field(n, "attribute", c1), suffix(s1, c1).
air301_last(n, q1) :- air301_demand_last(n), air301_last_case(q1, s1), kind(n, "identifier"),
    ref_site(n, b2), (st3 = b2 ; within(b2, st3)),
    ( kind(st3, "dotted_name"), suffix(s1, st3), child(p1, st3, _), kind(p1, "import_from_statement")
    ; kind(st3, "aliased_import"), field(st3, "name", c1), suffix(s1, c1)
    ).

air301_last(n, q1) :- air301_demand_last(n), air301_last_case(q1, s1), kind(n, "parenthesized_expression"),
    child(n, c6, _), air301_last(c6, q1).

// authmgr_class(n): the JSON util `authmgr-class`, used where the JSON says `matches: "authmgr-class"`
.decl air301_authmgr_class(n: node)
air301_authmgr_class(n) :- air301_authmgr_callee(n), air301_last(n, "authmgr").

// backend_site(n): the JSON util `backend-site`, used where the JSON says `matches: "backend-site"`
.decl air301_backend_site(n: node)
air301_backend_site(n) :- (kind(n, "dotted_name") ; kind(n, "aliased_import")),
    air301_from_mod(n, "backend").
air301_backend_site(n) :- kind(n, "aliased_import"), child(p1, n, _),
    kind(p1, "import_statement"), air301_tok_has_16(n).

// backend_head_site(n): the JSON util `backend-head-site`, used where the JSON says `matches: "backend-head-site"`
.decl air301_backend_head_site(n: node)
air301_backend_head_site(n) :- air301_backend_site(n).
air301_backend_head_site(n) :- inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), kind(c2, "dotted_name"),
    match("airflow\\.providers(\\.\\w+)*", c2),
    ( kind(n, "dotted_name"), glob("secrets", n)
    ; kind(n, "aliased_import"), air301_tok_has_18(n)
    ).

air301_backend_head_site(n) :- kind(n, "aliased_import"), child(p11, n, _),
    kind(p11, "import_statement"), air301_tok_has_19(n).

// backend_head(n): the JSON util `backend-head`, used where the JSON says `matches: "backend-head"`
.decl air301_backend_head(n: node)
air301_backend_head(n) :- kind(n, "identifier"), ref_site(n, b1), st2 = b1,
    air301_backend_head_site(st2).
air301_backend_head(n) :- kind(n, "attribute"), field(n, "object", c3), air301_backend_head(c3).
air301_backend_head(n) :- kind(n, "parenthesized_expression"), child(n, c4, _),
    air301_backend_head(c4).

// backend_chain(n): the JSON util `backend-chain`, used where the JSON says `matches: "backend-chain"`
.decl air301_backend_chain(n: node)
air301_backend_chain(n) :- kind(n, "attribute"), air301_tok_has_20(n).
air301_backend_chain(n) :- kind(n, "attribute"), field(n, "object", c9), air301_backend_chain(c9).
air301_backend_chain(n) :- kind(n, "parenthesized_expression"), child(n, c10, _),
    air301_backend_chain(c10).

// backend_callee(n): the JSON util `backend-callee`, used where the JSON says `matches: "backend-callee"`
.decl air301_backend_callee(n: node)
air301_backend_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), match("(airflow\\.secrets)(\\.|$).*", q1).
air301_backend_callee(n) :- kind(n, "identifier"), ref_site(n, b2), st3 = b2,
    air301_backend_site(st3).
air301_backend_callee(n) :- kind(n, "attribute"),
    sym_of(n, q4), match("(airflow\\.providers)(\\.|$).*", q4),
    ( field(n, "object", c1), air301_backend_chain(c1)
    ; field(n, "object", c2), air301_backend_head(c2)
    ).

air301_backend_callee(n) :- kind(n, "parenthesized_expression"), child(n, c7, _),
    air301_backend_callee(c7).

// backend_class(n): the JSON util `backend-class`, used where the JSON says `matches: "backend-class"`
.decl air301_backend_class(n: node)
air301_backend_class(n) :- air301_backend_callee(n), air301_last(n, "backend").

// hook_site(n): the JSON util `hook-site`, used where the JSON says `matches: "hook-site"`
.decl air301_hook_site(n: node)
air301_hook_site(n) :- (kind(n, "dotted_name") ; kind(n, "aliased_import")),
    air301_from_mod(n, "hook").
air301_hook_site(n) :- kind(n, "aliased_import"), child(p1, n, _),
    kind(p1, "import_statement"), air301_tok_has_21(n).

// hook_head_site(n): the JSON util `hook-head-site`, used where the JSON says `matches: "hook-head-site"`
.decl air301_hook_head_site(n: node)
air301_hook_head_site(n) :- air301_hook_site(n).
air301_hook_head_site(n) :- inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), kind(c2, "dotted_name"),
    match("airflow\\.providers(\\.\\w+)*", c2),
    ( kind(n, "dotted_name"), glob("hooks", n)
    ; kind(n, "aliased_import"), air301_tok_has_23(n)
    ).

air301_hook_head_site(n) :- kind(n, "aliased_import"), child(p11, n, _),
    kind(p11, "import_statement"), air301_tok_has_24(n).

// hook_head(n): the JSON util `hook-head`, used where the JSON says `matches: "hook-head"`
.decl air301_hook_head(n: node)
air301_hook_head(n) :- kind(n, "identifier"), ref_site(n, b1), st2 = b1, air301_hook_head_site(st2).
air301_hook_head(n) :- kind(n, "attribute"), field(n, "object", c3), air301_hook_head(c3).
air301_hook_head(n) :- kind(n, "parenthesized_expression"), child(n, c4, _), air301_hook_head(c4).

// hook_chain(n): the JSON util `hook-chain`, used where the JSON says `matches: "hook-chain"`
.decl air301_hook_chain(n: node)
air301_hook_chain(n) :- kind(n, "attribute"), air301_tok_has_25(n).
air301_hook_chain(n) :- kind(n, "attribute"), field(n, "object", c9), air301_hook_chain(c9).
air301_hook_chain(n) :- kind(n, "parenthesized_expression"), child(n, c10, _),
    air301_hook_chain(c10).

// hook_callee(n): the JSON util `hook-callee`, used where the JSON says `matches: "hook-callee"`
.decl air301_hook_callee(n: node)
air301_hook_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), match("(airflow\\.hooks)(\\.|$).*", q1).
air301_hook_callee(n) :- kind(n, "identifier"), ref_site(n, b2), st3 = b2, air301_hook_site(st3).
air301_hook_callee(n) :- kind(n, "attribute"),
    sym_of(n, q4), match("(airflow\\.providers)(\\.|$).*", q4),
    (field(n, "object", c1), air301_hook_chain(c1) ; field(n, "object", c2), air301_hook_head(c2)).
air301_hook_callee(n) :- kind(n, "parenthesized_expression"), child(n, c7, _),
    air301_hook_callee(c7).

// hook_class(n): the JSON util `hook-class`, used where the JSON says `matches: "hook-class"`
.decl air301_hook_class(n: node)
air301_hook_class(n) :- air301_hook_callee(n), air301_last(n, "hook").

// dag_site(n): the JSON util `dag-site`, used where the JSON says `matches: "dag-site"`
.decl air301_dag_site(n: node)
air301_dag_site(n) :- kind(n, "dotted_name"), glob("{DAG,dag}", n), child(p1, n, _),
    kind(p1, "import_from_statement").
air301_dag_site(n) :- kind(n, "aliased_import"), field(n, "name", c2),
    match(".*(^|\\.)\\s*(DAG|dag)", c2).

// dag_callee(n): the JSON util `dag-callee`, used where the JSON says `matches: "dag-callee"`
.decl air301_dag_callee(n: node)
air301_dag_callee(n) :- kind(n, "attribute"), sym_of(n, q1), match("(airflow)(\\.|$).*", q1),
    air301_tok_has_26(n).
air301_dag_callee(n) :- kind(n, "identifier"),
    sym_of(n, q10), match("(airflow)(\\.|$).*", q10), ref_site(n, b11), st12 = b11,
    air301_dag_site(st12).
air301_dag_callee(n) :- kind(n, "parenthesized_expression"), child(n, c13, _),
    air301_dag_callee(c13).

// task_name(n): the JSON util `task-name`, used where the JSON says `matches: "task-name"`
.decl air301_task_name(n: node)
air301_task_name(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (sym_of(n, "airflow.decorators.task") ; sym_of(n, "airflow.sdk.task")).
air301_task_name(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), air301_task_name(c1).

// sdk_variable(n): the JSON util `sdk-variable`, used where the JSON says `matches: "sdk-variable"`
.decl air301_sdk_variable(n: node)
air301_sdk_variable(n) :- air301_demand_sdk_variable(n), kind(n, "attribute"),
    sym_of(n, q1), match("(airflow\\.sdk)(\\.|$).*", q1), air301_tok_has_27(n).
air301_sdk_variable(n) :- air301_demand_sdk_variable(n), kind(n, "identifier"),
    sym_of(n, q10), match("(airflow\\.sdk)(\\.|$).*", q10), ref_site(n, b11),
    (st12 = b11 ; within(b11, st12)),
    ( kind(st12, "dotted_name"), glob("Variable", st12), child(p1, st12, _), kind(p1, "import_from_statement")
    ; kind(st12, "aliased_import"), field(st12, "name", c1), match(".*(^|\\.)Variable", c1)
    ).

air301_sdk_variable(n) :- air301_demand_sdk_variable(n), kind(n, "parenthesized_expression"),
    child(n, c15, _), air301_sdk_variable(c15).

// variable_get(n): the JSON util `variable-get`, used where the JSON says `matches: "variable-get"`
.decl air301_variable_get(n: node)
air301_variable_get(n) :- kind(n, "attribute"), air301_tok_has_28(n), field(n, "object", c9),
    air301_sdk_variable(c9).
air301_variable_get(n) :- kind(n, "parenthesized_expression"), child(n, c10, _),
    air301_variable_get(c10).

// tail_trigger_dagrun_obj(n): the JSON util `tail-trigger-dagrun-obj`, used where the JSON says `matches: "tail-trigger-dagrun-obj"`
.decl air301_tail_trigger_dagrun_obj(n: node)
air301_tail_trigger_dagrun_obj(n) :- kind(n, "identifier"), glob("trigger_dagrun", n).
air301_tail_trigger_dagrun_obj(n) :- kind(n, "attribute"), air301_tok_has_29(n).
air301_tail_trigger_dagrun_obj(n) :- kind(n, "parenthesized_expression"), child(n, c9, _),
    air301_tail_trigger_dagrun_obj(c9).

// tail_trigger_dagrun(n): the JSON util `tail-trigger-dagrun`, used where the JSON says `matches: "tail-trigger-dagrun"`
.decl air301_tail_trigger_dagrun(n: node)
air301_tail_trigger_dagrun(n) :- air301_demand_tail_trigger_dagrun(n), kind(n, "attribute"),
    air301_tok_has_30(n),
    ( field(n, "object", c1), air301_tail_trigger_dagrun_obj(c1)
    ; field(n, "object", c2), kind(c2, "identifier"), ref_site(c2, b1), (st1 = b1 ; within(b1, st1)), kind(st1, "aliased_import"), field(st1, "name", c3), match(".*(^|\\.)trigger_dagrun", c3)
    ).

air301_tail_trigger_dagrun(n) :- air301_demand_tail_trigger_dagrun(n), kind(n, "identifier"),
    ref_site(n, b14), (st15 = b14 ; within(b14, st15)),
    inside(st15, p16, "import_from_statement"), field(p16, "module_name", c17),
    kind(c17, "dotted_name"), match(".*(^|\\.)trigger_dagrun", c17),
    ( kind(st15, "dotted_name"), glob("TriggerDagRunOperator", st15)
    ; kind(st15, "aliased_import"), air301_tok_has_32(st15)
    ).

air301_tail_trigger_dagrun(n) :- air301_demand_tail_trigger_dagrun(n),
    kind(n, "parenthesized_expression"), child(n, c26, _), air301_tail_trigger_dagrun(c26).

// tail_branch_datetime_obj(n): the JSON util `tail-branch-datetime-obj`, used where the JSON says `matches: "tail-branch-datetime-obj"`
.decl air301_tail_branch_datetime_obj(n: node)
air301_tail_branch_datetime_obj(n) :- kind(n, "identifier"), glob("datetime", n).
air301_tail_branch_datetime_obj(n) :- kind(n, "attribute"), air301_tok_has_33(n).
