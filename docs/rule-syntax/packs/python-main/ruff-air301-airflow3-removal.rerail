// AIR301_context_key_conf(n, detail): findings from clauses `auth-manager-arguments`, `trigger-rule-none-failed-or-skipped-string`, `trigger-rule-none-failed-or-skipped-enum`, `context-key-conf` and 5 more. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
.violation AIR301_context_key_conf(at: node, detail: symbol) code "AIR301" "{detail}."
    suppress noqa "AIR301"
AIR301_context_key_conf(n, "The auth manager constructor takes no parameters in Airflow 3; drop the arguments") :- kind(n, "argument_list"),
    child(n, c1, _), !air301_alt_237(c1), child(p2, n, _), kind(p2, "call"),
    field(p2, "function", c3), air301_authmgr_class(c3).
AIR301_context_key_conf(n, "`none_failed_or_skipped` was removed in Airflow 3; use `\"none_failed_min_one_success\"` instead") :- (kind(n, "string") ; kind(n, "concatenated_string")),
    value(n, v1), value_type_of(n, "str"), glob("none_failed_or_skipped", v1),
    count : { has(n, c2, "string_start"), glob("**[fFtT]**", c2) } = 0,
    within_stop(n, p3, air301_stop_238), field(p3, "value", f4), (f4 = n ; within(n, f4)),
    kind(p3, "keyword_argument"), air301_tok_has_104(p3), child(p13, p3, _),
    kind(p13, "argument_list"), child(p14, p13, _), kind(p14, "call"),
    field(p14, "function", c15), air301_alt_239(c15).
AIR301_context_key_conf(n, "`TriggerRule.NONE_FAILED_OR_SKIPPED` was removed in Airflow 3; use `TriggerRule.NONE_FAILED_MIN_ONE_SUCCESS` instead") :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "airflow.utils.trigger_rule.TriggerRule.NONE_FAILED_OR_SKIPPED"),
    within_stop(n, p1, air301_stop_238), field(p1, "value", f2), (f2 = n ; within(n, f2)),
    kind(p1, "keyword_argument"), air301_tok_has_105(p1), child(p11, p1, _),
    kind(p11, "argument_list"), child(p12, p11, _), kind(p12, "call"),
    field(p12, "function", c13), air301_alt_239(c13).
AIR301_context_key_conf(n, "The context key `conf` was removed in Airflow 3; import `conf` from `airflow.configuration` instead") :- air301_ctx_key_slot(n),
    air301_key(n, "conf"), air301_in_task(n), node(_, n, _, _, _), S = n.
AIR301_context_key_conf(n, "The context key `triggering_dataset_events` was removed in Airflow 3; read `\"triggering_asset_events\"` instead") :- air301_ctx_key_slot(n),
    air301_key(n, "renamed"), air301_in_task(n), node(_, n, _, _, _), S = n.
AIR301_context_key_conf(n, "Index `inlet_events` with an `Asset` object such as `inlet_events[Asset(uri=...)]`; string keys were removed in Airflow 3") :- air301_inlet_key_slot(n),
    air301_plain_string(n), air301_in_task(n).
AIR301_context_key_conf(n, "`external_trigger` was removed from `dag_run` in Airflow 3; check `dag_run.run_type` instead") :- kind(n, "identifier"),
    glob("external_trigger", n), air301_in_task(n), field(p1, "attribute", n),
    kind(p1, "attribute"), field(p1, "object", c2), air301_from_dag_run(c2).
AIR301_context_key_conf(n, "The `conf` parameter was removed from the task context in Airflow 3; import `conf` from `airflow.configuration` instead") :- kind(n, "identifier"),
    glob("conf", n), node(_, n, _, _, _), K = n, air301_alt_270(n).
AIR301_context_key_conf(n, "`apply_defaults` is applied automatically in Airflow 3; delete this decorator") :- kind(n, "decorator"),
    child(n, c1, _), air301_apply_defaults(c1), child(p2, n, _),
    kind(p2, "decorated_definition"), field(p2, "definition", c3),
    kind(c3, "function_definition"),
    count : { child(n, c4, _), kind(c4, "comment") } = 0.

