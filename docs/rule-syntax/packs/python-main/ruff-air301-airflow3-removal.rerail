AIR301_removed_method_get_conn_uri(A, n, "`get_connections` was removed in Airflow 3; call `get_connection`") :- kind(n, "attribute"),
    air301_alt_263(n, A), field(p16, "function", n), kind(p16, "call").
AIR301_removed_method_get_conn_uri(A, n, "`get_conn_uri` was removed in Airflow 3; call `get_conn_value`") :- kind(n, "attribute"),
