    kind(c2, "identifier"), ref_site(c2, b4), st5 = b4, air301_assigned_backend_class(st5),
    field(p6, "function", n), kind(p6, "call"),
    count : { air301_stop_238_within(c7, n), field(n, "object", f8), (f8 = c7 ; within(c7, f8)), kind(c7, "identifier"), ref_site(c7, b9), st10 = b9, air301_assigned_cls_local_backend(st10) } = 0.
AIR301_removed_method_get_conn_uri(A, n, "`create_dagrun` was removed in Airflow 3 with no replacement; trigger runs through the REST API or `airflow dags trigger`") :- kind(n, "attribute"),
    field(n, "attribute", c1), glob("create_dagrun", c1), node(_, c1, _, _, _), A = c1,
    within_stop(c2, n, air301_stop_238), field(n, "object", f3), (f3 = c2 ; within(c2, f3)),
    kind(c2, "identifier"), ref_site(c2, b4), st5 = b4, air301_assigned_cls_dag(st5),
