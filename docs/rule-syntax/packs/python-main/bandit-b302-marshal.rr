.policy "bandit-b302-marshal" revision 1
.guests off
.description "Avoid marshal.load() and marshal.loads(); marshal is not safe against malicious or malformed data, so never use it on untrusted input."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B302(n): a finding at node n, from clause `bandit:B302`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on F are added to every rule.
.violation B302(at: node) "Load this data with json or another data-only format instead of marshal, which is unsafe on untrusted input."
    suppress nosec "B302"
B302(n) :- n ~ `$F($$$ARGS)`, (sym_of(F, "marshal.load") ; sym_of(F, "marshal.loads")).
