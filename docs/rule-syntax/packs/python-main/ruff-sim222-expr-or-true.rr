// set_1: node kinds from a JSON `any`
.decl sim222_set_1(v: symbol)
sim222_set_1("string"). sim222_set_1("concatenated_string"). sim222_set_1("integer"). sim222_set_1("float").
sim222_set_1("true"). sim222_set_1("false"). sim222_set_1("none"). sim222_set_1("ellipsis"). sim222_set_1("list").
sim222_set_1("tuple"). sim222_set_1("set"). sim222_set_1("dictionary"). sim222_set_1("list_comprehension").
sim222_set_1("set_comprehension"). sim222_set_1("dictionary_comprehension").

// set_2: node kinds from a JSON `any`
.decl sim222_set_2(v: symbol)
sim222_set_2("named_expression"). sim222_set_2("await"). sim222_set_2("yield"). sim222_set_2("subscript").
sim222_set_2("list_comprehension"). sim222_set_2("set_comprehension").
sim222_set_2("dictionary_comprehension"). sim222_set_2("generator_expression").

// set_15: node kinds from a JSON `any`
.decl sim222_set_15(v: symbol)
sim222_set_15("lambda"). sim222_set_15("dictionary"). sim222_set_15("set"). sim222_set_15("list_comprehension").
sim222_set_15("set_comprehension"). sim222_set_15("dictionary_comprehension"). sim222_set_15("integer").
sim222_set_15("float"). sim222_set_15("true"). sim222_set_15("false"). sim222_set_15("none"). sim222_set_15("ellipsis").
sim222_set_15("list"). sim222_set_15("tuple").

// set_21: node kinds from a JSON `any`
.decl sim222_set_21(v: symbol)
sim222_set_21("integer"). sim222_set_21("float"). sim222_set_21("true"). sim222_set_21("false"). sim222_set_21("none").
sim222_set_21("ellipsis"). sim222_set_21("lambda"). sim222_set_21("generator_expression").

// set_25: names from the JSON `resolves.global`
.decl sim222_set_25(v: symbol)
sim222_set_25("list"). sim222_set_25("tuple"). sim222_set_25("set"). sim222_set_25("dict"). sim222_set_25("frozenset").

// part_case: one row per relation folded into part: its key, then the strings that differed.
.decl sim222_part_case(key: symbol, s1: symbol)
sim222_part_case("b", "[A-Za-z]*[bB].*"). sim222_part_case("f", "[A-Za-z]*[fF].*").
sim222_part_case("t", "[A-Za-z]*[tT].*").

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_4(n: node)
sim222_alt_4(n) :- sim222_safe_binop_operand(n).
sim222_alt_4(n) :- node(_, n, _, _, _), glob("{+,-,\\*,/,//,%,\\*\\*,<<,>>,&,|,^,@}", n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_6(n: node)
sim222_alt_6(n) :- sim222_t_string(n).
sim222_alt_6(n) :- sim222_f_string(n).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_10(n: node)
sim222_alt_10(n) :- sim222_part_has_text(n).
sim222_alt_10(n) :- sim222_part(n, "f"), child(n, c1, _), kind(c1, "interpolation"),
    sim222_interp_nonempty(c1).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_12(n: node)
sim222_alt_12(n) :- kind(n, "string"), sim222_alt_10(n).
sim222_alt_12(n) :- kind(n, "concatenated_string"), child(n, c2, _), kind(c2, "string"),
    sim222_alt_10(c2).

// alt_16(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_16(n: node)
sim222_alt_16(n) :- kind(n, k1), sim222_set_15(k1).
sim222_alt_16(n) :- sim222_t_string(n).
sim222_alt_16(n) :- sim222_f_nonempty(n).
sim222_alt_16(n) :- sim222_plain_nonempty(n).
sim222_alt_16(n) :- sim222_bytes_string(n).
sim222_alt_16(n) :- kind(n, "conditional_expression"), child(n, c2, _), sim222_fexpr_nonempty(c2),
    sim222_tok_precedes_4(c2), child(n, c10, _), sim222_fexpr_nonempty(c10), sim222_tok_follows_5(c10).
sim222_alt_16(n) :- kind(n, "named_expression"), child(n, c18, _), sim222_tok_follows_6(c18),
    sim222_fexpr_nonempty(c18).

// alt_18(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_18(n: node)
sim222_alt_18(n) :- sim222_alt_18_u7(n).

// alt_19(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_19(n: node)
sim222_alt_19(n) :- (kind(n, "type_conversion") ; kind(n, "format_specifier")).
sim222_alt_19(n) :- node(_, n, _, _, _), glob("=", n).

// alt_20(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_20(n: node)
sim222_alt_20(n) :- sim222_alt_20_u7(n).

// alt_24(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_24(n: node)
sim222_alt_24(n) :- node(_, n, _, _, _), glob("[\\[\\](){},]", n).
sim222_alt_24(n) :- kind(n, "list_splat").

// alt_26(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_26(n: node)
sim222_alt_26(n) :- node(_, n, _, _, _), glob("[\\[\\](){},]", n).
sim222_alt_26(n) :- sim222_opaque_arg(n).

// alt_27(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_27(n: node)
sim222_alt_27(n) :-
    ( kind(n, "true")
    ; kind(n, "lambda")
    ; kind(n, "generator_expression")
    ; kind(n, "ellipsis")
    ).

sim222_alt_27(n) :- sim222_t_string(n).
sim222_alt_27(n) :- sim222_plain_nonempty(n).
sim222_alt_27(n) :- sim222_f_nonempty(n).
sim222_alt_27(n) :- (kind(n, "integer") ; kind(n, "float")), sim222_value(n, v1),
    sim222_truthy_value(n, "true").
sim222_alt_27(n) :- (kind(n, "list") ; kind(n, "set") ; kind(n, "tuple")), child(n, c2, _),
    !sim222_alt_24(c2).
sim222_alt_27(n) :- kind(n, "dictionary"), child(n, c3, _), kind(c3, "pair").
sim222_alt_27(n) :- kind(n, "call"), child(n, c4, _), kind(c4, "identifier"),
    global_ref(c4, g5), sim222_set_25(g5), child(n, c6, _), kind(c6, "argument_list"),
    k8 = count : { child(c6, c7, _), !glob("[\\[\\](){},]", c7) }, k8 >= 1, k8 <= 1,
    count : { child(c6, c9, _), (kind(c9, "keyword_argument") ; kind(c9, "dictionary_splat")) } = 0,
    child(c6, c10, _), !sim222_alt_26(c10), sim222_truthy(c10).

// alt_34(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_34(n: node)
sim222_alt_34(n) :- (kind(n, "false") ; kind(n, "none")).
sim222_alt_34(n) :- sim222_plain_empty(n).
sim222_alt_34(n) :- sim222_f_empty(n).
sim222_alt_34(n) :- (kind(n, "integer") ; kind(n, "float")), sim222_value(n, v1),
    sim222_truthy_value(n, "false").
sim222_alt_34(n) :- (kind(n, "list") ; kind(n, "tuple") ; kind(n, "dictionary")),
    count : { child(n, c2, _), !glob("[\\[\\](){},]", c2) } = 0.
sim222_alt_34(n) :- kind(n, "call"), child(n, c3, _), kind(c3, "identifier"),
    global_ref(c3, g4), sim222_set_25(g4), child(n, c5, _), kind(c5, "argument_list"),
    count : { child(c5, c6, _), !glob("[\\[\\](){},]", c6) } = 0.
sim222_alt_34(n) :- kind(n, "call"), child(n, c7, _), kind(c7, "identifier"),
    global_ref(c7, g8), sim222_set_25(g8), child(n, c9, _), kind(c9, "argument_list"),
    k11 = count : { child(c9, c10, _), !glob("[\\[\\](){},]", c10) }, k11 >= 1,
    k11 <= 1,
    count : { child(c9, c12, _), (kind(c12, "keyword_argument") ; kind(c12, "dictionary_splat")) } = 0,
    child(c9, c13, _), !sim222_alt_26(c13), sim222_falsy(c13).

// alt_38(n): the JSON `any`: n matches if any one of these rules does
.decl sim222_alt_38(n: node)
sim222_alt_38(n) :- sim222_or_op(n).
sim222_alt_38(n) :- node(_, n, _, _, _), glob("or", n).
sim222_alt_38(n) :- kind(n, "comment").

// stop_40(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl sim222_stop_40(n: node)
sim222_stop_40(n) :- sim222_not_or_op(n).

// stop_42(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl sim222_stop_42(n: node)
sim222_stop_42(n) :- sim222_not_or_op(n).
sim222_stop_42(n) :- sim222_or_op(n), child(n, c1, _), sim222_tok_follows_16(c1), sim222_skip(c1).

// stop_43(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl sim222_stop_43(n: node)
sim222_stop_43(n) :- sim222_or_top(n).

// stop_40_within: within_stop over the stop set stop_40, read inside an aggregate
.decl sim222_stop_40_within(n: node, a: node)
sim222_stop_40_within(x, y) :- within_stop(x, y, sim222_stop_40).
