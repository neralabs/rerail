// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\{$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim222_tok_follows_3(n: node)
.stored sim222_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim222_tok_follows_3(n) :- next_sibling(s11, n), glob("\\{", s11).
sim222_tok_follows_3(n) :- structural_before(n, g13), match("\\s*", g13), child(p14, n, _),
    node(_, n, _, st16, _), o15 = st16 - strlen(g13), token(p14, _, t12, _, o15),
    match("\\{", t12).
sim222_tok_follows_3(n) :- structural_before(n, g13), match("(?s)^(?:.*(?:\\{)\\s*)$", g13).

// tok_precedes_4(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
