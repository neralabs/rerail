sim222_alt_18_u2(n) :- kind(n, "concatenated_string"),
    count : { child(n, c2, _), kind(c2, "string"), count : { sim222_part_no_text(c2), count : { child(c2, c3, _), kind(c3, "interpolation"), !sim222_interp_empty_u1(c3) } = 0 } = 0 } = 0.

