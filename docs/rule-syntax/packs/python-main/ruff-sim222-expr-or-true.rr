sim222_interp_empty_u3(n) :- count : { child(n, c1, _), sim222_alt_19(c1) } = 0, child(n, c2, _),
    sim222_tok_follows_7(c2), sim222_fexpr_empty_u2(c2).

.decl sim222_interp_empty_u4(n: node)
sim222_interp_empty_u4(n) :- count : { child(n, c1, _), sim222_alt_19(c1) } = 0, child(n, c2, _),
