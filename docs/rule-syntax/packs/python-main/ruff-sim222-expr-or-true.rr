.policy "ruff-sim222-expr-or-true" revision 1
.guests off
.description "Simplify an or expression holding an always-truthy value such as True or a non-empty literal; the operands after it never run."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// SIM222(n): a finding at node n, from clause `expr-or-true`.
// Each rule below is one way the JSON `rule` can match.
.violation SIM222(at: node) "Drop the operands after the always-truthy value in this `or`; they never run, so the result is that value."
    suppress noqa "SIM222"
SIM222(n) :- sim222_value(n), !sim222_skip(n), (sim222_tok_precedes_11(n) ; sim222_prev_skip(n)),
    ( sim222_tok_precedes_11(n)
    ; next_sibling(s1, n), glob("or", s1), next_sibling(s2, s1), sim222_clean(s2)
    ),
    sim222_run_has_trigger(n).

// or_op(n): the JSON util `or-op`, used where the JSON says `matches: "or-op"`
.decl sim222_or_op(n: node)
sim222_or_op(n) :- kind(n, "boolean_operator"), sim222_tok_has_1(n).

// or_top(n): the JSON util `or-top`, used where the JSON says `matches: "or-top"`
.decl sim222_or_top(n: node)
sim222_or_top(n) :- sim222_or_op(n), count : { child(p1, n, _), sim222_or_op(p1) } = 0.

// not_or_op(n): the JSON util `not-or-op`, used where the JSON says `matches: "not-or-op"`
.decl sim222_not_or_op(n: node)
sim222_not_or_op(n) :- node(_, n, _, _, _), !sim222_or_op(n).

// safe_binop_operand(n): the JSON util `safe-binop-operand`, used where the JSON says `matches: "safe-binop-operand"`
.decl sim222_safe_binop_operand(n: node)
sim222_safe_binop_operand(n) :- kind(n, k1), sim222_set_1(k1).
sim222_safe_binop_operand(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    sim222_safe_binop_operand(c2).

// effect(n): the JSON util `effect`, used where the JSON says `matches: "effect"`
.decl sim222_effect(n: node)
sim222_effect(n) :- kind(n, k1), sim222_set_2(k1).
sim222_effect(n) :- kind(n, "call"),
    count : { child(n, c2, _), kind(c2, "identifier"), global_ref(c2, g3), sim222_set_25(g3), child(n, c4, _), kind(c4, "argument_list"), match("\\(\\s*\\)", c4) } = 0.
sim222_effect(n) :- kind(n, "binary_operator"), child(n, c5, _), !sim222_alt_4(c5).

// part(n, key): 3 copies of one rule set (`part-b`, `part-f`, `part-t`), folded into one: row `key` of
// part_case gives the strings each copy had.
.decl sim222_part(n: node, key: symbol)
sim222_part(n, q1) :- sim222_part_case(q1, s1), child(n, c1, _), kind(c1, "string_start"),
    match(s1, c1).

// part_has_text(n): the JSON util `part-has-text`, used where the JSON says `matches: "part-has-text"`
.decl sim222_part_has_text(n: node)
sim222_part_has_text(n) :- child(n, c1, _), kind(c1, "string_content"),
    !match("(\\\\\\r?\\n)+", c1).

// part_no_text(n): the JSON util `part-no-text`, used where the JSON says `matches: "part-no-text"`
.decl sim222_part_no_text(n: node)
sim222_part_no_text(n) :- node(_, n, _, _, _), !sim222_part_has_text(n).

// t_string(n): the JSON util `t-string`, used where the JSON says `matches: "t-string"`
.decl sim222_t_string(n: node)
sim222_t_string(n) :- kind(n, "string"), sim222_part(n, "t").
sim222_t_string(n) :- kind(n, "concatenated_string"), child(n, c1, _), kind(c1, "string"),
    sim222_part(c1, "t").

// f_string(n): the JSON util `f-string`, used where the JSON says `matches: "f-string"`
.decl sim222_f_string(n: node)
sim222_f_string(n) :- !sim222_t_string(n),
    ( kind(n, "string"), sim222_part(n, "f")
    ; kind(n, "concatenated_string"), child(n, c1, _), kind(c1, "string"), sim222_part(c1, "f")
    ).


// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl sim222_plain_string(n: node)
sim222_plain_string(n) :- (kind(n, "string") ; kind(n, "concatenated_string")), !sim222_alt_6(n).

// bytes_string(n): the JSON util `bytes-string`, used where the JSON says `matches: "bytes-string"`
.decl sim222_bytes_string(n: node)
sim222_bytes_string(n) :- sim222_plain_string(n),
    ( kind(n, "string"), sim222_part(n, "b")
    ; kind(n, "concatenated_string"), child(n, c1, _), kind(c1, "string"), sim222_part(c1, "b")
    ).


// plain_nonempty(n): the JSON util `plain-nonempty`, used where the JSON says `matches: "plain-nonempty"`
.decl sim222_plain_nonempty(n: node)
sim222_plain_nonempty(n) :- sim222_plain_string(n),
    ( kind(n, "string"), sim222_part_has_text(n)
    ; kind(n, "concatenated_string"), child(n, c1, _), kind(c1, "string"), sim222_part_has_text(c1)
    ).


// plain_empty(n): the JSON util `plain-empty`, used where the JSON says `matches: "plain-empty"`
.decl sim222_plain_empty(n: node)
sim222_plain_empty(n) :- sim222_plain_string(n),
    ( kind(n, "string"), sim222_part_no_text(n)
    ; kind(n, "concatenated_string"), count : { child(n, c1, _), kind(c1, "string"), !sim222_part_no_text(c1) } = 0
    ).


// f_nonempty(n): the JSON util `f-nonempty`, used where the JSON says `matches: "f-nonempty"`
.decl sim222_f_nonempty(n: node)
sim222_f_nonempty(n) :- sim222_f_string(n), sim222_alt_12(n).

// interp_nonempty(n): the JSON util `interp-nonempty`, used where the JSON says `matches: "interp-nonempty"`
.decl sim222_interp_nonempty(n: node)
sim222_interp_nonempty(n) :- sim222_tok_has_2(n).
sim222_interp_nonempty(n) :- count : { child(n, c9, _), kind(c9, "format_specifier") } = 0,
    child(n, c10, _), sim222_tok_follows_3(c10), sim222_fexpr_nonempty(c10).

// fexpr_nonempty(n): the JSON util `fexpr-nonempty`, used where the JSON says `matches: "fexpr-nonempty"`
.decl sim222_fexpr_nonempty(n: node)
sim222_fexpr_nonempty(n) :- sim222_alt_16(n).
sim222_fexpr_nonempty(n) :- kind(n, "parenthesized_expression"), child(n, c26, _),
    sim222_fexpr_nonempty(c26).

// f_empty(n): the JSON util `f-empty`, used where the JSON says `matches: "f-empty"`
.decl sim222_f_empty(n: node)
sim222_f_empty(n) :- sim222_f_empty_u7(n).

// interp_empty(n): the JSON util `interp-empty`, used where the JSON says `matches: "interp-empty"`
.decl sim222_interp_empty(n: node)
sim222_interp_empty(n) :- sim222_interp_empty_u7(n).

// fexpr_empty(n): the JSON util `fexpr-empty`, used where the JSON says `matches: "fexpr-empty"`
.decl sim222_fexpr_empty(n: node)
sim222_fexpr_empty(n) :- sim222_fexpr_empty_u7(n).

// opaque_arg(n): the JSON util `opaque-arg`, used where the JSON says `matches: "opaque-arg"`
.decl sim222_opaque_arg(n: node)
sim222_opaque_arg(n) :- (kind(n, k1), sim222_set_21(k1) ; sim222_t_string(n)).
sim222_opaque_arg(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), sim222_opaque_arg(c2).

// truthy(n): the JSON util `truthy`, used where the JSON says `matches: "truthy"`
.decl sim222_truthy(n: node)
sim222_truthy(n) :- sim222_alt_27(n).
sim222_truthy(n) :- kind(n, "parenthesized_expression"), child(n, c11, _), sim222_truthy(c11).

// falsy(n): the JSON util `falsy`, used where the JSON says `matches: "falsy"`
.decl sim222_falsy(n: node)
sim222_falsy(n) :- sim222_alt_34(n).
sim222_falsy(n) :- kind(n, "parenthesized_expression"), child(n, c14, _), sim222_falsy(c14).

// known(n): the JSON util `known`, used where the JSON says `matches: "known"`
.decl sim222_known(n: node)
sim222_known(n) :- sim222_truthy(n).
sim222_known(n) :- sim222_falsy(n).

// boolean_test(n): the JSON util `boolean-test`, used where the JSON says `matches: "boolean-test"`
.decl sim222_boolean_test(n: node)
sim222_boolean_test(n) :- child(p1, n, _), kind(p1, "not_operator").
sim222_boolean_test(n) :- sim222_tok_follows_8(n), child(p9, n, _),
    ( kind(p9, "if_statement")
    ; kind(p9, "elif_clause")
    ; kind(p9, "while_statement")
    ; kind(p9, "conditional_expression")
    ).

sim222_boolean_test(n) :- sim222_tok_follows_9(n).
sim222_boolean_test(n) :- child(p17, n, _), kind(p17, "if_clause").
sim222_boolean_test(n) :- sim222_tok_follows_10(n), child(p25, n, _), kind(p25, "argument_list"),
    child(p26, p25, _), kind(p26, "call"), child(p26, c27, _),
    (kind(c27, "identifier") ; kind(c27, "attribute")), global_ref(c27, "bool"),
    sym_of(c27, "builtins.bool").
sim222_boolean_test(n) :- child(p28, n, _),
    (kind(p28, "parenthesized_expression") ; kind(p28, "boolean_operator")),
    sim222_boolean_test(p28).

// short(n): the JSON util `short`, used where the JSON says `matches: "short"`
.decl sim222_short(n: node)
sim222_short(n) :- sim222_truthy(n).

// value(n): the JSON util `value`, used where the JSON says `matches: "value"`
.decl sim222_value(n: node)
sim222_value(n) :- !sim222_alt_38(n), child(p1, n, _), sim222_or_op(p1).

// has_next(n): the JSON util `has-next`, used where the JSON says `matches: "has-next"`
.decl sim222_has_next(n: node)
sim222_has_next(n) :- sim222_tok_precedes_11(n).
sim222_has_next(n) :- sim222_tok_follows_12(n), child(p15, n, _), sim222_or_op(p15), sim222_tok_precedes_13(p15).

// next_short(n): the JSON util `next-short`, used where the JSON says `matches: "next-short"`
.decl sim222_next_short(n: node)
sim222_next_short(n) :- next_sibling(n, s1), glob("or", s1), next_sibling(s1, s2), sim222_short(s2).
sim222_next_short(n) :- sim222_tok_follows_14(n), child(p10, n, _), sim222_or_op(p10),
    next_sibling(p10, s11), glob("or", s11), next_sibling(s11, s12), sim222_short(s12).

// trigger(n): the JSON util `trigger`, used where the JSON says `matches: "trigger"`
.decl sim222_trigger(n: node)
sim222_trigger(n) :- sim222_value(n), (sim222_short(n), sim222_has_next(n) ; !sim222_skip(n), sim222_next_short(n)).

// clean(n): the JSON util `clean`, used where the JSON says `matches: "clean"`
.decl sim222_clean(n: node)
sim222_clean(n) :- node(_, n, _, _, _), !sim222_trigger(n),
    count : { sim222_stop_40_within(c1, n), sim222_trigger(c1) } = 0.

// prev_skip(n): the JSON util `prev-skip`, used where the JSON says `matches: "prev-skip"`
.decl sim222_prev_skip(n: node)
sim222_prev_skip(n) :- next_sibling(s1, n), glob("or", s1), next_sibling(s2, s1),
    (!sim222_or_op(s2), sim222_skip(s2) ; sim222_or_op(s2), child(s2, c1, _), sim222_tok_follows_16(c1), sim222_skip(c1)).

// run_has_trigger(n): the JSON util `run-has-trigger`, used where the JSON says `matches: "run-has-trigger"`
.decl sim222_run_has_trigger(n: node)
sim222_run_has_trigger(n) :- sim222_trigger(n).
sim222_run_has_trigger(n) :- within_stop(n, p1, sim222_stop_42), sim222_or_op(p1), child(p1, c2, _),
    sim222_tok_follows_14(c2), sim222_trigger(c2).

// in_boolean_test(n): the JSON util `in-boolean-test`, used where the JSON says `matches: "in-boolean-test"`
.decl sim222_in_boolean_test(n: node)
sim222_in_boolean_test(n) :- within_stop(n, p1, sim222_stop_43), sim222_or_top(p1), sim222_boolean_test(p1).

// skip(n): the JSON util `skip`, used where the JSON says `matches: "skip"`
.decl sim222_skip(n: node)
sim222_skip(n) :- node(_, n, _, _, _), !sim222_known(n),
    (!sim222_in_boolean_test(n) ; sim222_effect(n) ; within(c1, n), sim222_effect(c1)).

.decl sim222_alt_18_u0(n: node)
sim222_alt_18_u0(n) :- kind(n, "string"), sim222_part_no_text(n),
    count : { child(n, c1, _), kind(c1, "interpolation") } = 0.
sim222_alt_18_u0(n) :- kind(n, "concatenated_string"),
    count : { child(n, c2, _), kind(c2, "string"), count : { sim222_part_no_text(c2), count : { child(c2, c3, _), kind(c3, "interpolation") } = 0 } = 0 } = 0.

.decl sim222_alt_18_u1(n: node)
sim222_alt_18_u1(n) :- kind(n, "string"), sim222_part_no_text(n),
    count : { child(n, c1, _), kind(c1, "interpolation"), !sim222_interp_empty_u0(c1) } = 0.
sim222_alt_18_u1(n) :- kind(n, "concatenated_string"),
    count : { child(n, c2, _), kind(c2, "string"), count : { sim222_part_no_text(c2), count : { child(c2, c3, _), kind(c3, "interpolation"), !sim222_interp_empty_u0(c3) } = 0 } = 0 } = 0.

