// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^or$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim222_tok_has_1(n: node)
.stored sim222_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim222_tok_has_1(n) :- child(n, c1, _), glob("or", c1).
sim222_tok_has_1(n) :- op(n, t2), match("or", t2).
sim222_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:or)(?:\\W.*)?)$", g3).
sim222_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:or)(?:\\W.*)?)$", g3).
sim222_tok_has_1(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:or)(?:\\W.*)?)$", g3).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim222_tok_has_2(n: node)
.stored sim222_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim222_tok_has_2(n) :- child(n, c1, _), glob("=", c1).
sim222_tok_has_2(n) :- op(n, t2), match("=", t2).
sim222_tok_has_2(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
sim222_tok_has_2(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
sim222_tok_has_2(n) :- node_text(n, g3), !child(n, _, _),
