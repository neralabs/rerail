// truthy_value: b is "true" when n's value is truthy (Python's bool(v)), "false" when it is falsy
.decl sim222_truthy_value(n: node, b: symbol)
sim222_truthy_value(n, "false") :- sim222_value(n, x), value_type(x, "NoneType").
sim222_truthy_value(n, b) :- sim222_value(n, x), value_type(x, "boolean"), b = x.
sim222_truthy_value(n, "false") :- sim222_value(n, x),
    (value_type(x, "int") ; value_type(x, "float")),
    (x = "0" ; x = "0.0" ; x = "-0.0").
sim222_truthy_value(n, "true") :- sim222_value(n, x),
    (value_type(x, "int") ; value_type(x, "float")), x != "0", x != "0.0", x != "-0.0".
sim222_truthy_value(n, "false") :- sim222_value(n, x),
    (value_type(x, "str") ; value_type(x, "bytes")), x = "".
sim222_truthy_value(n, "true") :- sim222_value(n, x),
    (value_type(x, "str") ; value_type(x, "bytes")), x != "".

