.decl pth116_tok_precedes_5(n: node)
.stored pth116_tok_precedes_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth116_tok_precedes_5(n) :- next_sibling(n, s25), glob("if", s25).
pth116_tok_precedes_5(n) :- structural_after(n, g27), match("\\s*", g27), child(p28, n, _),
    node(_, n, _, _, en31), o29 = en31 + strlen(g27), token(p28, _, t26, o29, _),
