.policy "ruff-pth116-os-stat" revision 1
.guests off
.description "Use Path.stat(), Path.owner() or Path.group() instead of os.stat(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PTH116(n): a finding at node n, from clause `os-stat`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on D, S are added to every rule.
.violation PTH116(at: node, f: node, s: loc) "Use `Path({s}).stat()` instead of `os.stat({s})`, keeping any `follow_symlinks` argument, or `.owner()`/`.group()` for owner or group names; leave bytes paths and file descriptors alone."
    suppress noqa "PTH116"
PTH116(F, n, S) :- kind(n, "call"), field(n, "function", c1), pth116_callee(c1, F),
    pth116_arg_path_1(n, a2), S = a2,
    ( kind(n, "call"), pth116_arg_no_dir_fd_2(n), unset(D)
    ; kind(n, "call"), pth116_arg_dir_fd_2(n, a1_2), D = a1_2
    ),
    pth116_none_literal(D), !pth116_file_descriptor(S).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl pth116_target(n: node)
pth116_target(n) :- (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, "os.stat").

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   F: metavariable this relation binds for the calling rule
.decl pth116_callee(n: node, f: loc)
pth116_callee(n, F) :- pth116_target(n), node(_, n, _, _, _), F = n.
pth116_callee(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth116_callee(c1, F).

// none_literal(n): the JSON util `none-literal`, used where the JSON says `matches: "none-literal"`
.decl pth116_none_literal(n: node)
pth116_none_literal(n) :- kind(n, "none").
pth116_none_literal(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pth116_none_literal(c1).

// int_name_ann(n): the JSON util `int-name-ann`, used where the JSON says `matches: "int-name-ann"`
.decl pth116_int_name_ann(n: node)
pth116_int_name_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "int"), sym_of(n, "builtins.int").

// int_annotation(n): the JSON util `int-annotation`, used where the JSON says `matches: "int-annotation"`
.decl pth116_int_annotation(n: node)
pth116_int_annotation(n) :- pth116_int_name_ann(n).
pth116_int_annotation(n) :- kind(n, "type"), child(n, c1, _), pth116_int_annotation(c1).
pth116_int_annotation(n) :- kind(n, "subscript"), field(n, "value", c2), pth116_int_name_ann(c2).
pth116_int_annotation(n) :- kind(n, "generic_type"), child(n, c3, _), kind(c3, "identifier"),
    pth116_int_name_ann(c3).

// int_call(n): the JSON util `int-call`, used where the JSON says `matches: "int-call"`
.decl pth116_int_call(n: node)
pth116_int_call(n) :- kind(n, "call"), field(n, "function", c1),
    (kind(c1, "identifier") ; kind(c1, "attribute")), global_ref(c1, "int"),
    sym_of(c1, "builtins.int").
pth116_int_call(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), pth116_int_call(c2).

// bool_type(n): the JSON util `bool-type`, used where the JSON says `matches: "bool-type"`
.decl pth116_bool_type(n: node)
pth116_bool_type(n) :- (kind(n, "true") ; kind(n, "false") ; kind(n, "not_operator")).
pth116_bool_type(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth116_bool_type(c1).
pth116_bool_type(n) :- kind(n, "named_expression"), field(n, "value", c2), pth116_bool_type(c2).
pth116_bool_type(n) :- kind(n, "conditional_expression"), child(n, c3, _), pth116_bool_type(c3),
    pth116_tok_precedes_1(c3), child(n, c11, _), pth116_bool_type(c11), pth116_tok_follows_2(c11).
pth116_bool_type(n) :- kind(n, "boolean_operator"), field(n, "left", c19), pth116_bool_type(c19),
    field(n, "right", c20), pth116_bool_type(c20).

// number(n): the JSON util `number`, used where the JSON says `matches: "number"`
.decl pth116_number(n: node)
pth116_number(n) :- pth116_int_type(n).
pth116_number(n) :- pth116_bool_type(n).

// int_type(n): the JSON util `int-type`, used where the JSON says `matches: "int-type"`
.decl pth116_int_type(n: node)
pth116_int_type(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int").
pth116_int_type(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), pth116_int_type(c2).
pth116_int_type(n) :- kind(n, "named_expression"), field(n, "value", c3), pth116_int_type(c3).
pth116_int_type(n) :- kind(n, "unary_operator"), field(n, "argument", c4), pth116_number(c4).
pth116_int_type(n) :- kind(n, "binary_operator"), field(n, "operator", c5),
    glob("{[-+%*&|^],//,\\*\\*,<<,>>}", c5), field(n, "left", c6), pth116_number(c6),
    field(n, "right", c7), pth116_number(c7).
pth116_int_type(n) :- kind(n, "conditional_expression"), child(n, c8, _), pth116_number(c8),
    pth116_tok_precedes_3(c8), child(n, c16, _), pth116_number(c16), pth116_tok_follows_4(c16), pth116_alt_1(n).
pth116_int_type(n) :- kind(n, "boolean_operator"), field(n, "left", c40), pth116_number(c40),
    field(n, "right", c41), pth116_number(c41), pth116_alt_2(n).

// int_value(n): the JSON util `int-value`, used where the JSON says `matches: "int-value"`
.decl pth116_int_value(n: node)
pth116_int_value(n) :- pth116_int_type(n).
pth116_int_value(n) :- pth116_int_call(n).

// int_name(n): the JSON util `int-name`, used where the JSON says `matches: "int-name"`
.decl pth116_int_name(n: node)
pth116_int_name(n) :- kind(n, "identifier"), pth116_alt_3(n).

// name_root(n): the JSON util `name-root`, used where the JSON says `matches: "name-root"`
.decl pth116_name_root(n: node)
pth116_name_root(n) :- pth116_int_name(n).
pth116_name_root(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth116_name_root(c1).
pth116_name_root(n) :- kind(n, "call"), field(n, "function", c2), pth116_name_root(c2).

// int_class_member(n): the JSON util `int-class-member`, used where the JSON says `matches: "int-class-member"`
//   A: metavariable of the calling rule, passed in (bound by the caller)
.decl pth116_int_class_member(n: node, a: loc)
pth116_int_class_member(n, A) :- pth116_demand_int_class_member(n, A), kind(n, "identifier"),
    text(n, t_a1), text(A, t_a1), pth116_alt_4(n), @doc(n) = @doc(A).

// class_holding_int(n): the JSON util `class-holding-int`, used where the JSON says `matches: "class-holding-int"`
//   A: metavariable of the calling rule, passed in (bound by the caller)
.decl pth116_class_holding_int(n: node, a: loc)
pth116_class_holding_int(n, A) :- pth116_demand_class_holding_int(n, A), kind(n, "class_definition"),
    field(n, "body", c1), within_stop(c2, c1, "class_definition"),
    pth116_int_class_member(c2, A).

// int_attribute(n): the JSON util `int-attribute`, used where the JSON says `matches: "int-attribute"`
.decl pth116_int_attribute(n: node)
pth116_int_attribute(n) :- kind(n, "attribute"), field(n, "attribute", c1),
    kind(c1, "identifier"), node(_, c1, _, _, _), A = c1, field(n, "object", c2), pth116_alt_5(c2, A).

// file_descriptor(n): the JSON util `file-descriptor`, used where the JSON says `matches: "file-descriptor"`
.decl pth116_file_descriptor(n: node)
pth116_file_descriptor(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int").
pth116_file_descriptor(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    pth116_file_descriptor(c2).
pth116_file_descriptor(n) :- pth116_name_root(n).
pth116_file_descriptor(n) :- pth116_int_attribute(n).

// tok_precedes_1(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth116_tok_precedes_1(n: node)
.stored pth116_tok_precedes_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth116_tok_precedes_1(n) :- next_sibling(n, s4), glob("if", s4).
pth116_tok_precedes_1(n) :- structural_after(n, g6), match("\\s*", g6), child(p7, n, _),
    node(_, n, _, _, en10), o8 = en10 + strlen(g6), token(p7, _, t5, o8, _),
    match("if", t5).
pth116_tok_precedes_1(n) :- structural_after(n, g6),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g6).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth116_tok_follows_2(n: node)
.stored pth116_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth116_tok_follows_2(n) :- next_sibling(s12, n), glob("else", s12).
pth116_tok_follows_2(n) :- structural_before(n, g14), match("\\s*", g14), child(p15, n, _),
    node(_, n, _, st17, _), o16 = st17 - strlen(g14), token(p15, _, t13, _, o16),
    match("else", t13).
pth116_tok_follows_2(n) :- structural_before(n, g14),
    match("(?s)^(?:(?:.*\\W)?(?:else)\\s*)$", g14).

// tok_precedes_3(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth116_tok_precedes_3(n: node)
.stored pth116_tok_precedes_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth116_tok_precedes_3(n) :- next_sibling(n, s9), glob("if", s9).
pth116_tok_precedes_3(n) :- structural_after(n, g11), match("\\s*", g11), child(p12, n, _),
    node(_, n, _, _, en15), o13 = en15 + strlen(g11), token(p12, _, t10, o13, _),
    match("if", t10).
pth116_tok_precedes_3(n) :- structural_after(n, g11),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g11).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth116_tok_follows_4(n: node)
.stored pth116_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth116_tok_follows_4(n) :- next_sibling(s17, n), glob("else", s17).
pth116_tok_follows_4(n) :- structural_before(n, g19), match("\\s*", g19), child(p20, n, _),
    node(_, n, _, st22, _), o21 = st22 - strlen(g19), token(p20, _, t18, _, o21),
    match("else", t18).
pth116_tok_follows_4(n) :- structural_before(n, g19),
    match("(?s)^(?:(?:.*\\W)?(?:else)\\s*)$", g19).

