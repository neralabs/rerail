pth116_tok_precedes_7(n) :- next_sibling(n, s2), glob("if", s2).
pth116_tok_precedes_7(n) :- structural_after(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, _, en8), o6 = en8 + strlen(g4), token(p5, _, t3, o6, _),
    match("if", t3).
pth116_tok_precedes_7(n) :- structural_after(n, g4),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g4).

// tok_follows_8(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth116_tok_follows_8(n: node)
.stored pth116_tok_follows_8 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth116_tok_follows_8(n) :- next_sibling(s10, n), glob("else", s10).
pth116_tok_follows_8(n) :- structural_before(n, g12), match("\\s*", g12), child(p13, n, _),
    node(_, n, _, st15, _), o14 = st15 - strlen(g12), token(p13, _, t11, _, o14),
    match("else", t11).
pth116_tok_follows_8(n) :- structural_before(n, g12),
    match("(?s)^(?:(?:.*\\W)?(?:else)\\s*)$", g12).

// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl pth116_args_plain(l: node, a: node, i: number)
pth116_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl pth116_args_splat(l: node, i: number)
pth116_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl pth116_args_pos(l: node, a: node, j: number)
pth116_args_pos(l, a, j) :- pth116_args_plain(l, a, i), count : { pth116_args_splat(l, k), k < i } = 0,
    j = count : { pth116_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl pth116_args_star(l: node, j: number)
pth116_args_star(l, j) :- pth116_args_splat(l, i), count : { pth116_args_splat(l, k), k < i } = 0,
    j = count : { pth116_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl pth116_args_kwp(l: node, k: symbol, v: node)
pth116_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl pth116_args_lit_dict(s: node, d: node)
pth116_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !pth116_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl pth116_args_str_pair(p: node)
pth116_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl pth116_args_kw(l: node, k: symbol, v: node)
pth116_args_kw(l, k, v) :- pth116_args_kwp(l, k, v).
pth116_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), pth116_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl pth116_args_kw_spread(l: node)
pth116_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !pth116_args_lit_dict(s, _).

// arg_path_1: call n passes v for slot `path` of (path, *, dir_fd), syntactic: Ruff's find_argument
.decl pth116_arg_path_1(n: node, v: node)
pth116_arg_path_1(n, v) :- kind(n, "call"), field(n, "arguments", l), pth116_args_kwp(l, "path", v).
pth116_arg_path_1(n, v) :- kind(n, "call"), field(n, "arguments", l), pth116_args_pos(l, v, 0),
    !pth116_args_kwp(l, "path", _).
pth116_arg_path_1(n, v) :- kind(n, "call"), field(n, "arguments", v),
    kind(v, "generator_expression").

// arg_no_path_1: call n does not pass slot `path` of (path, *, dir_fd), syntactic: Ruff's find_argument
.decl pth116_arg_no_path_1(n: node)
pth116_arg_no_path_1(n) :- kind(n, "call"), field(n, "arguments", l), !pth116_args_kwp(l, "path", _),
    !pth116_args_pos(l, _, 0), !kind(l, "generator_expression").

// arg_dir_fd_2: call n passes v for slot `dir_fd` of (path, *, dir_fd), syntactic: Ruff's find_argument
.decl pth116_arg_dir_fd_2(n: node, v: node)
pth116_arg_dir_fd_2(n, v) :- kind(n, "call"), field(n, "arguments", l),
    pth116_args_kwp(l, "dir_fd", v).

// arg_no_dir_fd_2: call n does not pass slot `dir_fd` of (path, *, dir_fd), syntactic: Ruff's find_argument
.decl pth116_arg_no_dir_fd_2(n: node)
pth116_arg_no_dir_fd_2(n) :- kind(n, "call"), field(n, "arguments", l),
    !pth116_args_kwp(l, "dir_fd", _).

// demand_alt_5: the rows of alt_5 its callers ask for (the metavariable columns they pass in)
.decl pth116_demand_alt_5(n: node, a: loc)
pth116_demand_alt_5(c2, A) :- kind(n, "attribute"), field(n, "attribute", c1),
    kind(c1, "identifier"), node(_, c1, _, _, _), A = c1, field(n, "object", c2).

// demand_class_holding_int: the rows of class_holding_int its callers ask for (the metavariable columns they pass in)
.decl pth116_demand_class_holding_int(n: node, a: loc)
pth116_demand_class_holding_int(st2, A) :- pth116_demand_alt_5(n, A), kind(n, "identifier"),
    ref_site(n, b1), (st2 = b1 ; within(b1, st2)).
pth116_demand_class_holding_int(c8, A) :- pth116_demand_alt_5(n, A), kind(n, "attribute"),
    field(n, "attribute", c3), kind(c3, "identifier"), node(_, c3, _, _, _), B = c3,
    field(n, "object", c4), kind(c4, "identifier"), ref_site(c4, b5),
    (st6 = b5 ; within(b5, st6)), kind(st6, "class_definition"),
    field(st6, "body", c7), within_stop(c8, c7, "class_definition"),
    field(c8, "name", c9), node(_, c9, _, _, _), B = c9, site_scope(c9, "class"), site_latest(c9).

// demand_int_class_member: the rows of int_class_member its callers ask for (the metavariable columns they pass in)
.decl pth116_demand_int_class_member(n: node, a: loc)
pth116_demand_int_class_member(c2, A) :- pth116_demand_class_holding_int(n, A),
    kind(n, "class_definition"), field(n, "body", c1),
    within_stop(c2, c1, "class_definition").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pth116_alt_1(n: node)
pth116_alt_1(n) :- child(n, c1, _), pth116_int_type(c1), pth116_tok_precedes_7(c1).
pth116_alt_1(n) :- child(n, c9, _), pth116_int_type(c9), pth116_tok_follows_8(c9).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pth116_alt_2(n: node)
pth116_alt_2(n) :- field(n, "left", c1), pth116_int_type(c1).
pth116_alt_2(n) :- field(n, "right", c2), pth116_int_type(c2).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pth116_alt_3(n: node)
pth116_alt_3(n) :- ref_site(n, b1), site_only(b1),
    (site_form(b1, "assignment") ; site_form(b1, "named")), binding_value(b1, x2),
    pth116_int_value(x2).
pth116_alt_3(n) :- ref_site(n, b3), site_only(b3), (st4 = b3 ; within(b3, st4)),
    kind(st4, "as_pattern"), child(st4, c5, _), pth116_int_value(c5).
pth116_alt_3(n) :- ref_site(n, b6), site_only(b6),
    ( site_form(b6, "annotated")
    ; site_form(b6, "annotation")
    ; site_form(b6, "parameter")
    ),
    (st7 = b6 ; within(b6, st7)),
    count : { child(st7, c8, _), (kind(c8, "list_splat_pattern") ; kind(c8, "dictionary_splat_pattern")) } = 0,
    site_annotation(b6, o9), pth116_int_annotation(o9).
pth116_alt_3(n) :- ref_site(n, b10), site_only(b10), (st11 = b10 ; within(b10, st11)),
    kind(st11, "function_definition"), field(st11, "return_type", c12),
    pth116_int_annotation(c12).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl pth116_alt_4(n: node)
pth116_alt_4(n) :- site_scope(n, "class"), site_latest(n),
    (site_form(n, "assignment") ; site_form(n, "named")), binding_value(n, x1),
    pth116_int_value(x1).
pth116_alt_4(n) :- site_scope(n, "class"), site_latest(n), (st2 = n ; within(n, st2)),
    kind(st2, "as_pattern"), child(st2, c3, _), pth116_int_value(c3).
pth116_alt_4(n) :- site_scope(n, "class"), site_latest(n),
    ( site_form(n, "annotated")
    ; site_form(n, "annotation")
    ; site_form(n, "parameter")
    ),
    (st4 = n ; within(n, st4)),
    count : { child(st4, c5, _), (kind(c5, "list_splat_pattern") ; kind(c5, "dictionary_splat_pattern")) } = 0,
    site_annotation(n, o6), pth116_int_annotation(o6).
pth116_alt_4(n) :- site_scope(n, "class"), site_latest(n), (st7 = n ; within(n, st7)),
    kind(st7, "function_definition"), field(st7, "return_type", c8),
    pth116_int_annotation(c8).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
//   A: metavariable of the calling rule, passed in (bound by the caller)
.decl pth116_alt_5(n: node, a: loc)
pth116_alt_5(n, A) :- pth116_demand_alt_5(n, A), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), pth116_class_holding_int(st2, A).
pth116_alt_5(n, A) :- pth116_demand_alt_5(n, A), kind(n, "attribute"), field(n, "attribute", c3),
    kind(c3, "identifier"), node(_, c3, _, _, _), B = c3, field(n, "object", c4), kind(c4, "identifier"),
    ref_site(c4, b5), (st6 = b5 ; within(b5, st6)), kind(st6, "class_definition"),
    field(st6, "body", c7), within_stop(c8, c7, "class_definition"),
    pth116_class_holding_int(c8, A), field(c8, "name", c9), node(_, c9, _, _, _), B = c9,
    site_scope(c9, "class"), site_latest(c9).
