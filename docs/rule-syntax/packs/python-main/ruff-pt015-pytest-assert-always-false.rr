.decl pt015_plain_empty(n: node)
pt015_plain_empty(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[fFtT]**", c1) } = 0,
    value(n, v2), pt015_truthy_value(n, "false").

