// truthy_value: b is "true" when n's value is truthy (Python's bool(v)), "false" when it is falsy
.decl pt015_truthy_value(n: node, b: symbol)
pt015_truthy_value(n, "false") :- value(n, x), value_type(x, "NoneType").
pt015_truthy_value(n, b) :- value(n, x), value_type(x, "boolean"), b = x.
pt015_truthy_value(n, "false") :- value(n, x),
    (value_type(x, "int") ; value_type(x, "float")),
    (x = "0" ; x = "0.0" ; x = "-0.0").
pt015_truthy_value(n, "true") :- value(n, x),
    (value_type(x, "int") ; value_type(x, "float")), x != "0", x != "0.0", x != "-0.0".
pt015_truthy_value(n, "false") :- value(n, x),
    (value_type(x, "str") ; value_type(x, "bytes")), x = "".
pt015_truthy_value(n, "true") :- value(n, x),
    (value_type(x, "str") ; value_type(x, "bytes")), x != "".

// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl pt015_alt_1_u0_empty(n: node)

// alt_3_u0_empty: level -1 of an unrolled recursion, empty
.decl pt015_alt_3_u0_empty(n: node)

// alt_4_u0_empty: level -1 of an unrolled recursion, empty
.decl pt015_alt_4_u0_empty(n: node)

// empty_interpolation_u0: level -1 of an unrolled recursion, empty
.decl pt015_empty_interpolation_u0(n: node)

// empty_interpolation_u0_empty: level -1 of an unrolled recursion, empty
.decl pt015_empty_interpolation_u0_empty(n: node)

// empty_str_expr_u0_empty: level -1 of an unrolled recursion, empty
.decl pt015_empty_str_expr_u0_empty(n: node)

// f_empty_u0_empty: level -1 of an unrolled recursion, empty
.decl pt015_f_empty_u0_empty(n: node)

// set_9: names from the JSON `resolves.global`
.decl pt015_set_9(v: symbol)
pt015_set_9("list"). pt015_set_9("tuple"). pt015_set_9("set"). pt015_set_9("dict"). pt015_set_9("frozenset").

// alt_case: one row per relation folded into alt: its key, then the strings that differed.
.decl pt015_alt_case(key: symbol, s1: symbol, s2: symbol, s3: symbol)
pt015_alt_case("2", "type_conversion", "format_specifier", "=").
pt015_alt_case("7", "comment", "line_continuation", "[\\[\\](){}]").
pt015_alt_case("8", "comment", "line_continuation", "[(),]").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pt015_alt_1(n: node)
pt015_alt_1(n) :- pt015_alt_1_u7(n).

// alt(n, key): 3 copies of one rule set (`alt_2`, `alt_7`, `alt_8`), folded into one: row `key` of
// alt_case gives the strings each copy had.
.decl pt015_alt(n: node, key: symbol)
pt015_alt(n, q1) :- pt015_alt_case(q1, s1, s2, s3), (kind(n, s1) ; kind(n, s2)).
pt015_alt(n, q1) :- node(_, n, _, _, _), pt015_alt_case(q1, s1, s2, s3), glob(s3, n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pt015_alt_3(n: node)
pt015_alt_3(n) :- pt015_alt_3_u7(n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl pt015_alt_4(n: node)
pt015_alt_4(n) :- pt015_alt_4_u7(n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl pt015_alt_6(n: node)
pt015_alt_6(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
pt015_alt_6(n) :- pt015_plain_empty(n).
pt015_alt_6(n) :- pt015_f_empty(n).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl pt015_alt_10(n: node)
pt015_alt_10(n) :- field(n, "arguments", c1), kind(c1, "argument_list"),
    count : { child(c1, c2, _), pt015_argument(c2) } = 0.
pt015_alt_10(n) :- field(n, "arguments", c3), kind(c3, "argument_list"),
    k5 = count : { child(c3, c4, _), pt015_argument(c4) }, k5 >= 1, k5 <= 1,
    child(c3, c6, _), pt015_falsey_container_p(c6).

// stop_11(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl pt015_stop_11(n: node)
pt015_stop_11(n) :- node(_, n, _, _, _), !kind(n, "comment"), !kind(n, "line_continuation").
