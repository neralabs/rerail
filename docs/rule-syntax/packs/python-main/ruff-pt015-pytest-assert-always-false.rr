.policy "ruff-pt015-pytest-assert-always-false" revision 1
.guests off
.description "Use pytest.fail instead of an assert on a value that is always false; it states the intent to fail the test more clearly."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PT015(n): a finding at node n, from clause `pytest-assert-always-false`.
// Each rule below is one way the JSON `rule` can match.
.violation PT015(at: node) "Replace this always-failing `assert` with `pytest.fail(...)`, passing any assertion message to it; leave it alone outside pytest tests."
    suppress noqa "PT015"
PT015(n) :- kind(n, "assert_statement"), child(n, c1, _), pt015_test(c1),
    (pt015_scalar_falsey_p(c1) ; pt015_falsey_container_p(c1)).

// scalar_falsey(n): the JSON util `scalar-falsey`, used where the JSON says `matches: "scalar-falsey"`
.decl pt015_scalar_falsey(n: node)
pt015_scalar_falsey(n) :- (kind(n, "false") ; kind(n, "none")).
pt015_scalar_falsey(n) :- (kind(n, "integer") ; kind(n, "float")), value(n, v1),
    pt015_truthy_value(n, "false").

// scalar_falsey_p(n): the JSON util `scalar-falsey-p`, used where the JSON says `matches: "scalar-falsey-p"`
.decl pt015_scalar_falsey_p(n: node)
pt015_scalar_falsey_p(n) :- pt015_scalar_falsey(n).
pt015_scalar_falsey_p(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pt015_scalar_falsey_p(c1).

