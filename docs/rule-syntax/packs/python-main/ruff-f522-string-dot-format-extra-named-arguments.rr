.policy "ruff-f522-string-dot-format-extra-named-arguments" revision 1
.guests off
.description "Remove keyword arguments to str.format() that no named placeholder in the string uses; they are silently ignored."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/format-args.rr"

// F522(n): a finding at node n, from clause `string-dot-format-extra-named-arguments`.
// Each rule below is one way the JSON `rule` can match.
.violation F522(at: node) "Remove the keyword arguments that no named placeholder in this str.format() string uses."
    suppress noqa "F522"
F522(n) :- n ~ `$S.format($$$A)`, fa_brace_tree(n, _, _), fa_brace_unused(n, a1),
    kind(a1, "keyword_argument").
