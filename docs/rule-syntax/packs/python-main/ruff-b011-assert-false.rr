.policy "ruff-b011-assert-false" revision 1
.guests off
.description "Raise AssertionError instead of assert False; assertions are stripped when Python runs with optimizations enabled."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// B011(n): a finding at node n, from clause `assert-false`.
// Each rule below is one way the JSON `rule` can match.
.violation B011(at: node) "Do not `assert False` (`python -O` removes these calls), raise `AssertionError()`"
    suppress noqa "B011"
B011(n) :- kind(n, "false"), b011_assert_test(n).

// assert_test(n): the JSON util `assert-test`, used where the JSON says `matches: "assert-test"`
.decl b011_assert_test(n: node)
b011_assert_test(n) :- b011_tok_follows_1(n), child(p8, n, _), kind(p8, "assert_statement").
b011_assert_test(n) :- child(p9, n, _), kind(p9, "parenthesized_expression"),
    b011_assert_test(p9).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^assert$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b011_tok_follows_1(n: node)
.stored b011_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b011_tok_follows_1(n) :- next_sibling(s1, n), glob("assert", s1).
b011_tok_follows_1(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("assert", t2).
b011_tok_follows_1(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*\\W)?(?:assert)\\s*)$", g3).
