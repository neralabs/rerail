.policy "ruff-f504-percent-format-extra-named-arguments" revision 1
.guests off
.description "Remove dict keys that no %(key) placeholder in the %-format string uses; an unused key usually means a typo or a stale argument."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/format-args.rr"

// F504(n): a finding at node n, from clause `percent-format-extra-named-arguments`.
// Each rule below is one way the JSON `rule` can match.
.violation F504(at: node) "`%`-format string has unused named argument(s)"
    suppress noqa "F504"
F504(n) :- n ~ `$S % $R`, fa_percent_tree(n, _, _), fa_percent_unused(n, a1),
    kind(a1, "pair").
