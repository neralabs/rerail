ruf005_tuple_or_splat(n) :- ruf005_tuple_expr(n).

// concat_core(n): the JSON util `concat-core`, used where the JSON says `matches: "concat-core"`
.decl ruf005_concat_core(n: node)
ruf005_concat_core(n) :- kind(n, "binary_operator"), (ruf005_list_add(n) ; ruf005_tuple_add(n)).

// concat(n): the JSON util `concat`, used where the JSON says `matches: "concat"`
.decl ruf005_concat(n: node)
ruf005_concat(n) :- ruf005_concat_core(n),
    count : { ruf005_stop_4_within(n, p1), kind(p1, "binary_operator"), ruf005_tok_has_11(p1) } = 0.

// plus_op(n): the JSON util `plus-op`, used where the JSON says `matches: "plus-op"`
.decl ruf005_plus_op(n: node)
ruf005_plus_op(n) :- kind(n, "binary_operator"), ruf005_tok_has_2(n).

