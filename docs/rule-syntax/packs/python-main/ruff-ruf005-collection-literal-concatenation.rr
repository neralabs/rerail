.policy "ruff-ruf005-collection-literal-concatenation" revision 1
.guests off
.description "Prefer iterable unpacking over adding a list or tuple literal to another collection with the plus operator; it reads better and accepts any iterable."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// splat_ok(n): the JSON util `splat-ok`, used where the JSON says `matches: "splat-ok"`
.decl ruf005_splat_ok(n: node)
ruf005_splat_ok(n) :- (kind(n, "identifier") ; kind(n, "attribute") ; kind(n, "call")).
ruf005_splat_ok(n) :- kind(n, "subscript"), child(n, c1, _), kind(c1, "slice"), !ruf005_tok_has_1(n).
ruf005_splat_ok(n) :- kind(n, "parenthesized_expression"), child(n, c10, _), ruf005_splat_ok(c10).

// list_expr(n): the JSON util `list-expr`, used where the JSON says `matches: "list-expr"`
.decl ruf005_list_expr(n: node)
ruf005_list_expr(n) :- kind(n, "list").
ruf005_list_expr(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf005_list_expr(c1).
ruf005_list_expr(n) :- ruf005_list_add(n).

// tuple_expr(n): the JSON util `tuple-expr`, used where the JSON says `matches: "tuple-expr"`
.decl ruf005_tuple_expr(n: node)
