//   E: metavariable this relation binds for the calling rule
.decl ruf005_outer_operand(n: node, e: loc)
ruf005_outer_operand(n, E) :- ruf005_concat_core(n), node(_, n, _, _, _), E = n.
ruf005_outer_operand(n, E) :- kind(n, "parenthesized_expression"), child(n, c1, _),
