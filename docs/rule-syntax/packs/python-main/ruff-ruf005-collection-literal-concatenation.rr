.decl ruf005_list_add(n: node)
ruf005_list_add(n) :- kind(n, "binary_operator"), ruf005_tok_has_2(n), ruf005_alt_1(n).

// list_or_splat(n): the JSON util `list-or-splat`, used where the JSON says `matches: "list-or-splat"`
.decl ruf005_list_or_splat(n: node)
ruf005_list_or_splat(n) :- ruf005_splat_ok(n).
ruf005_list_or_splat(n) :- ruf005_list_expr(n).

// tuple_add(n): the JSON util `tuple-add`, used where the JSON says `matches: "tuple-add"`
.decl ruf005_tuple_add(n: node)
ruf005_tuple_add(n) :- kind(n, "binary_operator"), ruf005_tok_has_2(n), ruf005_alt_2(n).

// tuple_or_splat(n): the JSON util `tuple-or-splat`, used where the JSON says `matches: "tuple-or-splat"`
.decl ruf005_tuple_or_splat(n: node)
