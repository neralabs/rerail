// set_1: node kinds from a JSON `any`
.decl f633_set_1(v: symbol)
f633_set_1("pattern_list"). f633_set_1("tuple_pattern"). f633_set_1("list_pattern").
f633_set_1("list_splat_pattern"). f633_set_1("as_pattern_target").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl f633_alt_3(n: node)
f633_alt_3(n) :- child(p1, n, _),
    ( kind(p1, "assignment")
    ; kind(p1, "augmented_assignment")
    ; kind(p1, "named_expression")
    ),
    !f633_tok_follows_1(n).
f633_alt_3(n) :- child(p9, n, _), kind(p9, k10), f633_set_1(k10).
f633_alt_3(n) :- child(p11, n, _),
    (kind(p11, "for_statement") ; kind(p11, "for_in_clause")), f633_tok_precedes_2(n).
f633_alt_3(n) :- child(p19, n, _),
    (kind(p19, "function_definition") ; kind(p19, "class_definition")),
    f633_tok_follows_3(n).
f633_alt_3(n) :- child(p27, n, _),
    ( kind(p27, "parameters")
    ; kind(p27, "lambda_parameters")
    ; kind(p27, "dictionary_splat_pattern")
    ).

f633_alt_3(n) :- child(p28, n, _),
    ( kind(p28, "default_parameter")
    ; kind(p28, "typed_parameter")
    ; kind(p28, "typed_default_parameter")
    ),
    !f633_tok_follows_4(n).
f633_alt_3(n) :- child(p36, n, _), kind(p36, "aliased_import"), f633_tok_follows_5(n).
f633_alt_3(n) :- !f633_tok_follows_6(n), child(p51, n, _), kind(p51, "dotted_name"),
    ( child(p1, p51, _), kind(p1, "import_statement")
    ; child(p2, p51, _), kind(p2, "import_from_statement"), f633_tok_follows_9(p51), !f633_tok_has_10(p51)
    ).

f633_alt_3(n) :- child(p69, n, _),
    (kind(p69, "global_statement") ; kind(p69, "nonlocal_statement")).
