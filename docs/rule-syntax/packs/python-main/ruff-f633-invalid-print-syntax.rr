f633_tok_has_8(n) :- child(n, c68, _), structural_after(c68, g63),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g63).
f633_tok_has_8(n) :- node_text(n, g63), !child(n, _, _),
