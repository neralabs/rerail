.policy "ruff-f633-invalid-print-syntax" revision 1
.guests off
.description "Use print()'s file argument instead of Python 2's >> redirection, which raises TypeError with the print function."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// F633(n): a finding at node n, from clause `invalid-print-syntax`.
// Each rule below is one way the JSON `rule` can match.
.violation F633(at: node) "Replace `>>` with print()'s `file=` argument, as in `print(msg, file=sys.stderr)`."
    suppress noqa "F633"
F633(n) :- glob("print", n), child(p1, n, _), kind(p1, "print_statement"),
    child(p1, c2, _), kind(c2, "chevron"), !f633_tok_follows_13(n),
    count : { inside(n, p10, "module"), within(c11, p10), f633_print_binding(c11) } = 0.
F633(n) :- (kind(n, "identifier") ; kind(n, "attribute")), f633_rshift_left(n),
    global_ref(n, "print"), sym_of(n, "builtins.print").

// print_binding(n): the JSON util `print-binding`, used where the JSON says `matches: "print-binding"`
.decl f633_print_binding(n: node)
f633_print_binding(n) :- kind(n, "identifier"), glob("print", n), f633_alt_3(n).

// rshift_left(n): the JSON util `rshift-left`, used where the JSON says `matches: "rshift-left"`
.decl f633_rshift_left(n: node)
f633_rshift_left(n) :- !f633_tok_follows_11(n), f633_tok_precedes_12(n), child(p15, n, _),
    kind(p15, "binary_operator").
f633_rshift_left(n) :- child(p16, n, _), kind(p16, "parenthesized_expression"),
    f633_rshift_left(p16).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl f633_tok_follows_1(n: node)
.stored f633_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
f633_tok_follows_1(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
f633_tok_follows_1(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
f633_tok_follows_1(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^in$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl f633_tok_precedes_2(n: node)
.stored f633_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
f633_tok_precedes_2(n) :- next_sibling(n, s12), glob("in", s12).
f633_tok_precedes_2(n) :- structural_after(n, g14), match("\\s*", g14), child(p15, n, _),
    node(_, n, _, _, en18), o16 = en18 + strlen(g14), token(p15, _, t13, o16, _),
    match("in", t13).
f633_tok_precedes_2(n) :- structural_after(n, g14),
    match("(?s)^(?:\\s*(?:in)(?:\\W.*)?)$", g14).

// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "^(def|class)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl f633_tok_follows_3(n: node)
