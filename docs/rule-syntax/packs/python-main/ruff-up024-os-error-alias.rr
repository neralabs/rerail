.policy "ruff-up024-os-error-alias" revision 1
.guests off
.description "Use the builtin OSError instead of its legacy aliases such as IOError, EnvironmentError, WindowsError and socket.error; since Python 3.3 they are all the same class."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// handler_type(n): the JSON util `handler-type`, used where the JSON says `matches: "handler-type"`
.decl up024_handler_type(n: node)
up024_handler_type(n) :- field(p1, "value", n), kind(p1, "except_clause").
up024_handler_type(n) :- child(p2, n, _), kind(p2, "as_pattern"), field(p3, "value", p2),
    kind(p3, "except_clause").
up024_handler_type(n) :- child(p4, n, _), kind(p4, "parenthesized_expression"),
    up024_handler_type(p4).

// atom_site(n): the JSON util `atom-site`, used where the JSON says `matches: "atom-site"`
.decl up024_atom_site(n: node)
up024_atom_site(n) :- up024_handler_type(n).
up024_atom_site(n) :- child(p1, n, _), kind(p1, "raise_statement"),
    count : { field(p2, "cause", n), kind(p2, "raise_statement") } = 0.
up024_atom_site(n) :- field(p3, "function", n), kind(p3, "call").
up024_atom_site(n) :- child(p4, n, _), kind(p4, "parenthesized_expression"), up024_atom_site(p4).

// os_error_alias(n): the JSON util `os-error-alias`, used where the JSON says `matches: "os-error-alias"`
.decl up024_os_error_alias(n: node)
up024_os_error_alias(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( global_ref(n, "EnvironmentError")
    ; global_ref(n, "IOError")
    ; global_ref(n, "WindowsError")
    ),
    sym_of(n, q1), up024_set_1(q1).

// element(n): the JSON util `element`, used where the JSON says `matches: "element"`
.decl up024_element(n: node)
up024_element(n) :- child(p1, n, _), kind(p1, "tuple"), up024_handler_type(p1).
up024_element(n) :- child(p2, n, _), kind(p2, "parenthesized_expression"), up024_element(p2).

// alias_site(n): the JSON util `alias-site`, used where the JSON says `matches: "alias-site"`
.decl up024_alias_site(n: node)
up024_alias_site(n) :- up024_os_error_alias(n), up024_atom_site(n).

// alias_in_annotation(n): the JSON util `alias-in-annotation`, used where the JSON says `matches: "alias-in-annotation"`
//   ALIAS: metavariable this relation binds for the calling rule
.decl up024_alias_in_annotation(n: node, alias: loc)
up024_alias_in_annotation(n, ALIAS) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), up024_alt_2(c2, ALIAS).

// UP024(n): a finding at node n, from clause `os-error-alias`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation UP024(at: node, alias: node) "Replace `{alias}` with the builtin `OSError`; since Python 3.3 it is the same class. Leave it only if `OSError` is rebound to something else in this scope."
    suppress noqa "UP024"
UP024(ALIAS, n) :- up024_alias_site(n), node(_, n, _, _, _), ALIAS = n.
UP024(ALIAS, n) :- up024_alias_in_annotation(n, ALIAS).

// UP024_os_error_alias_in_tuple(n): a finding at node n, from clause `os-error-alias-in-tuple`.
// Each rule below is one way the JSON `rule` can match.
.violation UP024_os_error_alias_in_tuple(at: node) code "UP024" "Replace the OSError aliases in this except tuple (IOError, socket.error, ...) with one builtin `OSError`, keeping the other exceptions; don't add it twice if it is already listed."
    suppress noqa "UP024"
UP024_os_error_alias_in_tuple(n) :- kind(n, "tuple"), up024_handler_type(n), within(c1, n),
    up024_os_error_alias(c1), up024_element(c1),
    count : { within_stop(n, p2, "except_clause"), kind(p2, "except_clause"), up024_tok_has_1(p2) } = 0.

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up024_tok_has_1(n: node)
.stored up024_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up024_tok_has_1(n) :- child(n, c3, _), glob("\\,", c3).
up024_tok_has_1(n) :- op(n, t4), match(",", t4).
up024_tok_has_1(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
up024_tok_has_1(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
up024_tok_has_1(n) :- node_text(n, g5), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g5).

// set_1: symbols from the JSON `resolves.import`
.decl up024_set_1(v: symbol)
up024_set_1("builtins.EnvironmentError"). up024_set_1("builtins.IOError").
up024_set_1("builtins.WindowsError"). up024_set_1("mmap.error"). up024_set_1("resource.error").
up024_set_1("select.error"). up024_set_1("socket.error"). up024_set_1("os.error").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   ALIAS: metavariable this relation binds for the calling rule
.decl up024_alt_2(n: node, alias: loc)
up024_alt_2(n, ALIAS) :- up024_alias_site(n), ALIAS = n.
up024_alt_2(n, ALIAS) :- up024_alias_in_annotation(n, ALIAS).
