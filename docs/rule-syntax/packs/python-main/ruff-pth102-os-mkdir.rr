.policy "ruff-pth102-os-mkdir" revision 1
.guests off
.description "Use Path.mkdir() instead of os.mkdir(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PTH102(n): a finding at node n, from clause `os-mkdir`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PTH102(at: node, f: node) "Use `Path(path).mkdir(mode=mode)` instead of `os.mkdir(path, mode)`; leave it where the path is bytes or `dir_fd` comes through `**kwargs`."
    suppress noqa "PTH102"
PTH102(F, n) :- kind(n, "call"), field(n, "function", c1), pth102_callee(c1, F),
    count : { field(n, "arguments", c2), kind(c2, "argument_list"), child(c2, c3, _), kind(c3, "keyword_argument"), field(c3, "name", c4), glob("dir_fd", c4), field(c3, "value", c5), !pth102_none_literal(c5) } = 0.

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl pth102_target(n: node)
pth102_target(n) :- (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, "os.mkdir").

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   F: metavariable this relation binds for the calling rule
.decl pth102_callee(n: node, f: loc)
pth102_callee(n, F) :- pth102_target(n), node(_, n, _, _, _), F = n.
pth102_callee(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth102_callee(c1, F).

// none_literal(n): the JSON util `none-literal`, used where the JSON says `matches: "none-literal"`
.decl pth102_none_literal(n: node)
pth102_none_literal(n) :- kind(n, "none").
pth102_none_literal(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pth102_none_literal(c1).
