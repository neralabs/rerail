// all_expr: x is a module-level `__all__ =`, `+=` or `: T =` value, or a part of one that lists names
//   (Ruff's extract_dunder_all_names: `+` chains, parentheses, walrus values, list(...) and tuple(...))
.decl ann401_all_expr(x: node)
ann401_all_expr(x) :- (kind(st, "assignment") ; kind(st, "augmented_assignment")),
    field(st, "left", l), kind(l, "identifier"), text(l, "__all__"), child(es, st, _),
    kind(es, "expression_statement"), child(m, es, _), kind(m, "module"),
    field(st, "right", x).
ann401_all_expr(y) :- ann401_all_expr(x), kind(x, "assignment"), field(x, "right", y).
ann401_all_expr(y) :- ann401_all_expr(x), kind(x, "binary_operator"),
    (field(x, "left", y) ; field(x, "right", y)).
ann401_all_expr(y) :- ann401_all_expr(x), kind(x, "parenthesized_expression"), child(x, y, _),
    !kind(y, "comment").
ann401_all_expr(y) :- ann401_all_expr(x), kind(x, "named_expression"), field(x, "value", y).
ann401_all_expr(y) :- ann401_all_expr(x), kind(x, "call"), field(x, "function", f),
    kind(f, "identifier"), (text(f, "list") ; text(f, "tuple")),
    field(x, "arguments", a), child(a, y, _).

// all_entry: string e is an entry of a module `__all__` definition, exporting the name x
.decl ann401_all_entry(e: node, x: symbol)
ann401_all_entry(e, x) :- ann401_all_expr(l), (kind(l, "list") ; kind(l, "tuple")), child(l, e, _),
    (kind(e, "string") ; kind(e, "concatenated_string")),
    count : { within(i, e), kind(i, "interpolation") } = 0, str(e, x).

// demand_alt_34: the rows of alt_34 its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_alt_34(n: node, la: loc)
ann401_demand_alt_34(c5, LA) :- kind(n, "identifier"), node(_, n, _, _, _), LA = n, docof(n, d2),
    modnode(d2, m3), inside(n, p4, "module"), within(c5, p4).

// demand_alt_35: the rows of alt_35 its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_alt_35(n: node, la: loc)
ann401_demand_alt_35(c14, LA) :- kind(n, "attribute"), field(n, "attribute", c8),
    glob("Any", c8), field(n, "object", c9), kind(c9, "identifier"), node(_, c9, _, _, _), LA = c9,
    docof(c9, d11), modnode(d11, m12), inside(c9, p13, "module"), within(c14, p13).

// demand_alt_36: the rows of alt_36 its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_alt_36(n: node, lo: loc)
ann401_demand_alt_36(c5, LO) :- kind(n, "identifier"), node(_, n, _, _, _), LO = n, docof(n, d2),
    modnode(d2, m3), inside(n, p4, "module"), within(c5, p4).

// demand_alt_37: the rows of alt_37 its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_alt_37(n: node, lo: loc)
ann401_demand_alt_37(c14, LO) :- kind(n, "attribute"), field(n, "attribute", c8),
    glob("Optional", c8), field(n, "object", c9), kind(c9, "identifier"), node(_, c9, _, _, _), LO = c9,
    docof(c9, d11), modnode(d11, m12), inside(c9, p13, "module"), within(c14, p13).

// demand_alt_38: the rows of alt_38 its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_alt_38(n: node, lu: loc)
ann401_demand_alt_38(c5, LU) :- kind(n, "identifier"), node(_, n, _, _, _), LU = n, docof(n, d2),
    modnode(d2, m3), inside(n, p4, "module"), within(c5, p4).

// demand_alt_39: the rows of alt_39 its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_alt_39(n: node, lu: loc)
ann401_demand_alt_39(c14, LU) :- kind(n, "attribute"), field(n, "attribute", c8),
    glob("Union", c8), field(n, "object", c9), kind(c9, "identifier"), node(_, c9, _, _, _), LU = c9,
    docof(c9, d11), modnode(d11, m12), inside(c9, p13, "module"), within(c14, p13).

// demand_alt_40: the rows of alt_40 its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_alt_40(n: node, lt: loc)
ann401_demand_alt_40(c5, LT) :- kind(n, "identifier"), node(_, n, _, _, _), LT = n, docof(n, d2),
    modnode(d2, m3), inside(n, p4, "module"), within(c5, p4).

// demand_alt_41: the rows of alt_41 its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_alt_41(n: node, lt: loc)
ann401_demand_alt_41(c14, LT) :- kind(n, "attribute"), field(n, "attribute", c8),
    glob("Annotated", c8), field(n, "object", c9), kind(c9, "identifier"), node(_, c9, _, _, _), LT = c9,
    docof(c9, d11), modnode(d11, m12), inside(c9, p13, "module"), within(c14, p13).

// demand_overload_impl: the rows of overload_impl its callers ask for (the metavariable columns they pass in)
.decl ann401_demand_overload_impl(n: node, n_mv: loc)
ann401_demand_overload_impl(n, N) :- kind(n, "function_definition"), field(n, "name", c1),
    node(_, c1, _, _, _), N = c1.

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl ann401_up_1(n: node, p: node)
ann401_up_1(n, p) :- ann401_top_any(n), within_stop(n, p, ann401_stop_43), kind(p, "type").

// stop_32: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl ann401_stop_32(kind: symbol)
ann401_stop_32("function_definition"). ann401_stop_32("class_definition").

// set_42: node kinds from a JSON `any`
.decl ann401_set_42(v: symbol)
ann401_set_42("identifier"). ann401_set_42("attribute"). ann401_set_42("subscript"). ann401_set_42("generic_type").
ann401_set_42("binary_operator"). ann401_set_42("string"). ann401_set_42("concatenated_string").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_2(n: node)
ann401_alt_2(n) :- site_form(n, "annotation").
ann401_alt_2(n) :- site_form(n, "except").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_3(n: node)
ann401_alt_3(n) :- ann401_seen_builtins(n).
ann401_alt_3(n) :- inside(n, p1, "module"), within(c2, p1),
    (kind(c2, "identifier") ; kind(c2, "dotted_name")), glob("staticmethod", c2),
    site_scope(c2, "module"), !ann401_alt_2(c2).

// stop_5(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ann401_stop_5(n: node)
ann401_stop_5(n) :- ann401_has_def(n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_6(n: node)
ann401_alt_6(n) :- field(n, "left", c1), ann401_c_any(c1).
ann401_alt_6(n) :- field(n, "right", c2), ann401_c_any(c2).

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_7(n: node)
ann401_alt_7(n) :- kind(n, "subscript"), field(n, "value", c1), ann401_optional_ref(c1),
    !ann401_tok_has_5(n), child(n, c10, _), ann401_tok_follows_6(c10), ann401_c_any(c10).
ann401_alt_7(n) :- kind(n, "generic_type"), child(n, c18, _), kind(c18, "identifier"),
    ann401_optional_ref(c18), child(n, c19, _), kind(c19, "type_parameter"), !ann401_tok_has_7(c19),
    child(c19, c28, _), ann401_tok_follows_8(c28), ann401_c_any(c28).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_11(n: node)
ann401_alt_11(n) :- ann401_c_any(n).
ann401_alt_11(n) :- ann401_tuple_like(n), child(p1, n, _), !ann401_tok_has_5(p1), within(c10, n),
    ann401_tuple_first_c(c10).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_10(n: node)
ann401_alt_10(n) :- kind(n, "subscript"), field(n, "value", c1), ann401_union_ref(c1),
    child(n, c2, _), ann401_alt_11(c2).
ann401_alt_10(n) :- kind(n, "generic_type"), child(n, c13, _), kind(c13, "identifier"),
    ann401_union_ref(c13), child(n, c14, _), kind(c14, "type_parameter"), child(c14, c15, _),
    ann401_alt_11(c15).

// alt_13(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_13(n: node)
ann401_alt_13(n) :- ann401_tok_follows_15(n).
ann401_alt_13(n) :- kind(n, "comment").

// alt_15(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_15(n: node)
ann401_alt_15(n) :- kind(n, "subscript"), field(n, "value", c1), ann401_annotated_ref(c1),
    child(n, c2, _), ann401_tok_follows_18(c2), !ann401_alt_13(c2), ann401_first_c(c2).
ann401_alt_15(n) :- kind(n, "generic_type"), child(n, c17, _), kind(c17, "identifier"),
    ann401_annotated_ref(c17), child(n, c18, _), kind(c18, "type_parameter"),
    child(c18, c19, _), ann401_tok_follows_20(c19), !ann401_alt_13(c19), ann401_first_c(c19).

// alt_18(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_18(n: node)
ann401_alt_18(n) :- ann401_plain_string(n).
ann401_alt_18(n) :- ann401_c_any(n).

// alt_19(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_19(n: node)
ann401_alt_19(n) :- kind(n, "ERROR").
ann401_alt_19(n) :- kind(n, "expression_statement"), child(n, c1, _), ann401_alt_18(c1).

// alt_21(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_21(n: node)
ann401_alt_21(n) :- node(_, n, _, _, _), glob("[(),]", n).
ann401_alt_21(n) :- kind(n, "comment").

// alt_22(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_22(n: node)
ann401_alt_22(n) :- node(_, n, _, _, _), glob("[(),]", n).
ann401_alt_22(n) :- kind(n, "comment").
ann401_alt_22(n) :- ann401_tok_follows_15(n).

// alt_25(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_25(n: node)
ann401_alt_25(n) :- kind(n, "subscript"), field(n, "value", c1), ann401_annotated_ref(c1),
    child(n, c2, _), ann401_tok_follows_18(c2), !ann401_alt_13(c2), ann401_first_r(c2).
ann401_alt_25(n) :- kind(n, "generic_type"), child(n, c17, _), kind(c17, "identifier"),
    ann401_annotated_ref(c17), child(n, c18, _), kind(c18, "type_parameter"),
    child(c18, c19, _), ann401_tok_follows_20(c19), !ann401_alt_13(c19), ann401_first_r(c19).

// alt_29(n): the JSON `any`: n matches if any one of these rules does
.decl ann401_alt_29(n: node)
ann401_alt_29(n) :- ann401_c_any(n).
ann401_alt_29(n) :- ann401_r_extra(n).

// alt_34(n): the JSON `any`: n matches if any one of these rules does
//   LA: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_alt_34(n: node, la: loc)
ann401_alt_34(n, LA) :- ann401_demand_alt_34(n, LA), kind(n, "dotted_name"),
    text(n, t_la1), text(LA, t_la1),
    ( imported_sym(n, "typing.Any")
    ; imported_sym(n, "typing_extensions.Any")
    ; imported_sym(n, "_typeshed.Any")
    ),
    site_form(n, "import"), site_scope(n, "module"), site_latest(n), @doc(n) = @doc(LA).
ann401_alt_34(n, LA) :- ann401_demand_alt_34(n, LA), kind(n, "aliased_import"),
    field(n, "alias", c1), text(c1, t_la2), text(LA, t_la2), site_form(c1, "import"),
    site_scope(c1, "module"), site_latest(c1), field(n, "name", c2),
    ( imported_sym(c2, "typing.Any")
    ; imported_sym(c2, "typing_extensions.Any")
    ; imported_sym(c2, "_typeshed.Any")
    ), @doc(c1) = @doc(LA).


// alt_35(n): the JSON `any`: n matches if any one of these rules does
//   LA: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_alt_35(n: node, la: loc)
ann401_alt_35(n, LA) :- ann401_demand_alt_35(n, LA), kind(n, "dotted_name"),
    text(n, t_la3), text(LA, t_la3),
    ( imported_sym(n, "typing")
    ; imported_sym(n, "typing_extensions")
    ; imported_sym(n, "_typeshed")
    ),
    site_form(n, "import"), site_scope(n, "module"), site_latest(n), @doc(n) = @doc(LA).
ann401_alt_35(n, LA) :- ann401_demand_alt_35(n, LA), kind(n, "aliased_import"),
    field(n, "alias", c1), text(c1, t_la4), text(LA, t_la4), site_form(c1, "import"),
    site_scope(c1, "module"), site_latest(c1), field(n, "name", c2),
    ( imported_sym(c2, "typing")
    ; imported_sym(c2, "typing_extensions")
    ; imported_sym(c2, "_typeshed")
    ), @doc(c1) = @doc(LA).


// alt_36(n): the JSON `any`: n matches if any one of these rules does
//   LO: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_alt_36(n: node, lo: loc)
ann401_alt_36(n, LO) :- ann401_demand_alt_36(n, LO), kind(n, "dotted_name"),
    text(n, t_lo5), text(LO, t_lo5),
    ( imported_sym(n, "typing.Optional")
    ; imported_sym(n, "typing_extensions.Optional")
    ; imported_sym(n, "_typeshed.Optional")
    ),
    site_form(n, "import"), site_scope(n, "module"), site_latest(n), @doc(n) = @doc(LO).
ann401_alt_36(n, LO) :- ann401_demand_alt_36(n, LO), kind(n, "aliased_import"),
    field(n, "alias", c1), text(c1, t_lo6), text(LO, t_lo6), site_form(c1, "import"),
    site_scope(c1, "module"), site_latest(c1), field(n, "name", c2),
    ( imported_sym(c2, "typing.Optional")
    ; imported_sym(c2, "typing_extensions.Optional")
    ; imported_sym(c2, "_typeshed.Optional")
    ), @doc(c1) = @doc(LO).


// alt_37(n): the JSON `any`: n matches if any one of these rules does
//   LO: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_alt_37(n: node, lo: loc)
ann401_alt_37(n, LO) :- ann401_demand_alt_37(n, LO), kind(n, "dotted_name"),
    text(n, t_lo7), text(LO, t_lo7),
    ( imported_sym(n, "typing")
    ; imported_sym(n, "typing_extensions")
    ; imported_sym(n, "_typeshed")
    ),
    site_form(n, "import"), site_scope(n, "module"), site_latest(n), @doc(n) = @doc(LO).
ann401_alt_37(n, LO) :- ann401_demand_alt_37(n, LO), kind(n, "aliased_import"),
    field(n, "alias", c1), text(c1, t_lo8), text(LO, t_lo8), site_form(c1, "import"),
    site_scope(c1, "module"), site_latest(c1), field(n, "name", c2),
    ( imported_sym(c2, "typing")
    ; imported_sym(c2, "typing_extensions")
    ; imported_sym(c2, "_typeshed")
    ), @doc(c1) = @doc(LO).


// alt_38(n): the JSON `any`: n matches if any one of these rules does
//   LU: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_alt_38(n: node, lu: loc)
ann401_alt_38(n, LU) :- ann401_demand_alt_38(n, LU), kind(n, "dotted_name"),
    text(n, t_lu9), text(LU, t_lu9),
    ( imported_sym(n, "typing.Union")
    ; imported_sym(n, "typing_extensions.Union")
    ; imported_sym(n, "_typeshed.Union")
    ),
    site_form(n, "import"), site_scope(n, "module"), site_latest(n), @doc(n) = @doc(LU).
ann401_alt_38(n, LU) :- ann401_demand_alt_38(n, LU), kind(n, "aliased_import"),
    field(n, "alias", c1), text(c1, t_lu10), text(LU, t_lu10), site_form(c1, "import"),
    site_scope(c1, "module"), site_latest(c1), field(n, "name", c2),
    ( imported_sym(c2, "typing.Union")
    ; imported_sym(c2, "typing_extensions.Union")
    ; imported_sym(c2, "_typeshed.Union")
    ), @doc(c1) = @doc(LU).


// alt_39(n): the JSON `any`: n matches if any one of these rules does
//   LU: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_alt_39(n: node, lu: loc)
ann401_alt_39(n, LU) :- ann401_demand_alt_39(n, LU), kind(n, "dotted_name"),
    text(n, t_lu11), text(LU, t_lu11),
    ( imported_sym(n, "typing")
    ; imported_sym(n, "typing_extensions")
    ; imported_sym(n, "_typeshed")
    ),
    site_form(n, "import"), site_scope(n, "module"), site_latest(n), @doc(n) = @doc(LU).
ann401_alt_39(n, LU) :- ann401_demand_alt_39(n, LU), kind(n, "aliased_import"),
    field(n, "alias", c1), text(c1, t_lu12), text(LU, t_lu12), site_form(c1, "import"),
    site_scope(c1, "module"), site_latest(c1), field(n, "name", c2),
    ( imported_sym(c2, "typing")
    ; imported_sym(c2, "typing_extensions")
    ; imported_sym(c2, "_typeshed")
    ), @doc(c1) = @doc(LU).


// alt_40(n): the JSON `any`: n matches if any one of these rules does
//   LT: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_alt_40(n: node, lt: loc)
ann401_alt_40(n, LT) :- ann401_demand_alt_40(n, LT), kind(n, "dotted_name"),
    text(n, t_lt13), text(LT, t_lt13),
    ( imported_sym(n, "typing.Annotated")
    ; imported_sym(n, "typing_extensions.Annotated")
    ; imported_sym(n, "_typeshed.Annotated")
    ),
    site_form(n, "import"), site_scope(n, "module"), site_latest(n), @doc(n) = @doc(LT).
ann401_alt_40(n, LT) :- ann401_demand_alt_40(n, LT), kind(n, "aliased_import"),
    field(n, "alias", c1), text(c1, t_lt14), text(LT, t_lt14), site_form(c1, "import"),
    site_scope(c1, "module"), site_latest(c1), field(n, "name", c2),
    ( imported_sym(c2, "typing.Annotated")
    ; imported_sym(c2, "typing_extensions.Annotated")
    ; imported_sym(c2, "_typeshed.Annotated")
    ), @doc(c1) = @doc(LT).


// alt_41(n): the JSON `any`: n matches if any one of these rules does
//   LT: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_alt_41(n: node, lt: loc)
ann401_alt_41(n, LT) :- ann401_demand_alt_41(n, LT), kind(n, "dotted_name"),
    text(n, t_lt15), text(LT, t_lt15),
    ( imported_sym(n, "typing")
    ; imported_sym(n, "typing_extensions")
    ; imported_sym(n, "_typeshed")
    ),
    site_form(n, "import"), site_scope(n, "module"), site_latest(n), @doc(n) = @doc(LT).
ann401_alt_41(n, LT) :- ann401_demand_alt_41(n, LT), kind(n, "aliased_import"),
    field(n, "alias", c1), text(c1, t_lt16), text(LT, t_lt16), site_form(c1, "import"),
    site_scope(c1, "module"), site_latest(c1), field(n, "name", c2),
    ( imported_sym(c2, "typing")
    ; imported_sym(c2, "typing_extensions")
    ; imported_sym(c2, "_typeshed")
    ), @doc(c1) = @doc(LT).


// stop_43(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ann401_stop_43(n: node)
ann401_stop_43(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").
