ann401_tok_has_3(n) :- node_text(n, g26), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g26).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\[$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ann401_tok_follows_4(n: node)
.stored ann401_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ann401_tok_follows_4(n) :- precedes(s33, n), glob("\\[", s33).
ann401_tok_follows_4(n) :- child(p36, n, _), node(_, n, _, st38, _),
    token(p36, _, t34, _, en39), en39 <= st38, match("\\[", t34).
ann401_tok_follows_4(n) :- structural_before(n, g35), match("(?s)^(?:.*(?:\\[).*)$", g35).
