// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ann401_tok_has_1(n: node)
.stored ann401_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ann401_tok_has_1(n) :- child(n, c6, _), glob("\\,", c6).
ann401_tok_has_1(n) :- op(n, t7), match(",", t7).
ann401_tok_has_1(n) :- child(n, c13, _), structural_before(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
ann401_tok_has_1(n) :- child(n, c13, _), structural_after(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
ann401_tok_has_1(n) :- node_text(n, g8), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g8).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\[$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ann401_tok_follows_2(n: node)
.stored ann401_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ann401_tok_follows_2(n) :- precedes(s15, n), glob("\\[", s15).
ann401_tok_follows_2(n) :- child(p18, n, _), node(_, n, _, st20, _),
    token(p18, _, t16, _, en21), en21 <= st20, match("\\[", t16).
ann401_tok_follows_2(n) :- structural_before(n, g17), match("(?s)^(?:.*(?:\\[).*)$", g17).
ann401_tok_follows_2(n) :- precedes(o19, n), structural_before(o19, g17),
    match("(?s)^(?:.*(?:\\[).*)$", g17).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ann401_tok_has_3(n: node)
