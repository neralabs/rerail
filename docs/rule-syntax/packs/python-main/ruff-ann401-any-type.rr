.policy "ruff-ann401-any-type" revision 1
.guests off
.description "Use a specific type instead of Any in function signatures; Any switches off type checking for every value that passes through it."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// ANN401(n): a finding at node n, from clause `any-type`.
// Each rule below is one way the JSON `rule` can match.
.violation ANN401(at: node) "This annotation amounts to `Any`; replace it with the type the code actually accepts or returns (a union, a TypeVar or a Protocol), keeping `Any` only where every type is truly allowed."
    suppress noqa "ANN401"
ANN401(n) :- kind(n, k1), ann401_set_42(k1), ann401_up_1(n, p2),
    ( field(p1, "return_type", p2), kind(p1, "function_definition"), ann401_checked_fn(p1)
    ; field(p3, "type", p2), (kind(p3, "typed_parameter") ; kind(p3, "typed_default_parameter")), ann401_checked_param(p3)
    ),
    ann401_top_any(n).

// seen_builtins(n): the JSON util `seen-builtins`, used where the JSON says `matches: "seen-builtins"`
.decl ann401_seen_builtins(n: node)
ann401_seen_builtins(n) :- inside(n, p1, "module"), has(p1, c2, "dotted_name"),
    match("builtins\\b.*", c2),
    ( field(p2, "name", c2), kind(p2, "import_statement")
    ; child(p3, c2, _), kind(p3, "aliased_import"), child(p4, p3, _), kind(p4, "import_statement")
    ; field(p5, "module_name", c2), kind(p5, "import_from_statement")
    ).


// static_ref(n): the JSON util `static-ref`, used where the JSON says `matches: "static-ref"`
.decl ann401_static_ref(n: node)
ann401_static_ref(n) :- kind(n, "identifier"), glob("staticmethod", n), !ann401_alt_3(n).
ann401_static_ref(n) :- ann401_seen_builtins(n), (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "staticmethod"), sym_of(n, "builtins.staticmethod").
ann401_static_ref(n) :- kind(n, "parenthesized_expression"), child(n, c3, _), ann401_static_ref(c3).

// overload_ref(n): the JSON util `overload-ref`, used where the JSON says `matches: "overload-ref"`
.decl ann401_overload_ref(n: node)
ann401_overload_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.overload")
    ; sym_of(n, "typing_extensions.overload")
    ; sym_of(n, "_typeshed.overload")
    ).

ann401_overload_ref(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ann401_overload_ref(c1).

// def_like(n): the JSON util `def-like`, used where the JSON says `matches: "def-like"`
.decl ann401_def_like(n: node)
ann401_def_like(n) :-
    ( kind(n, "function_definition")
    ; kind(n, "class_definition")
    ; kind(n, "decorated_definition")
    ).


// overload_of_name(n): the JSON util `overload-of-name`, used where the JSON says `matches: "overload-of-name"`
//   N: metavariable this relation binds for the calling rule
.decl ann401_overload_of_name(n: node, n_mv: loc)
ann401_overload_of_name(n, N) :- kind(n, "decorated_definition"), child(n, c1, _),
    kind(c1, "decorator"), child(c1, c2, _), ann401_overload_ref(c2), child(n, c3, _),
    kind(c3, "function_definition"), field(c3, "name", c4), node(_, c4, _, _, _), N = c4.

// has_def(n): the JSON util `has-def`, used where the JSON says `matches: "has-def"`
.decl ann401_has_def(n: node)
ann401_has_def(n) :- ann401_def_like(n).
ann401_has_def(n) :- within(c1, n), ann401_def_like(c1).

// ends_with_overload(n): the JSON util `ends-with-overload`, used where the JSON says `matches: "ends-with-overload"`
//   N: metavariable this relation binds for the calling rule
.decl ann401_ends_with_overload(n: node, n_mv: loc)
ann401_ends_with_overload(n, N) :- ann401_overload_of_name(n, N).
ann401_ends_with_overload(n, N) :- !kind(n, "function_definition"), child(n, c1, _),
    ann401_has_def(c1), count : { precedes(c1, s2), ann401_has_def(s2) } = 0,
    ann401_ends_with_overload(c1, N).

// after_overload(n): the JSON util `after-overload`, used where the JSON says `matches: "after-overload"`
//   N: metavariable this relation binds for the calling rule
.decl ann401_after_overload(n: node, n_mv: loc)
ann401_after_overload(n, N) :- precedes_stop(s1, n, ann401_stop_5), ann401_ends_with_overload(s1, N).
ann401_after_overload(n, N) :- count : { precedes(s2, n), ann401_has_def(s2) } = 0, child(p3, n, _),
    !kind(p3, "function_definition"), !kind(p3, "class_definition"),
    !kind(p3, "module"), ann401_after_overload(p3, N).

// overload_impl(n): the JSON util `overload-impl`, used where the JSON says `matches: "overload-impl"`
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl ann401_overload_impl(n: node, n_mv: loc)
ann401_overload_impl(n, N) :- ann401_demand_overload_impl(n, N), kind(n, "function_definition"),
    count : { child(p1, n, _), kind(p1, "decorated_definition"), child(p1, c2, _), kind(c2, "decorator"), child(c2, c3, _), ann401_overload_ref(c3) } = 0,
    ann401_after_overload(n, N).

// override_ref(n): the JSON util `override-ref`, used where the JSON says `matches: "override-ref"`
.decl ann401_override_ref(n: node)
ann401_override_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.override")
    ; sym_of(n, "typing_extensions.override")
    ; sym_of(n, "_typeshed.override")
    ).

ann401_override_ref(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ann401_override_ref(c1).

// any_ref(n): the JSON util `any-ref`, used where the JSON says `matches: "any-ref"`
.decl ann401_any_ref(n: node)
ann401_any_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Any")
    ; sym_of(n, "typing_extensions.Any")
    ; sym_of(n, "_typeshed.Any")
    ).

ann401_any_ref(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type")), child(n, c1, _),
    ann401_any_ref(c1).
ann401_any_ref(n) :- ann401_late_any_ref(n).

// optional_ref(n): the JSON util `optional-ref`, used where the JSON says `matches: "optional-ref"`
.decl ann401_optional_ref(n: node)
ann401_optional_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Optional")
    ; sym_of(n, "typing_extensions.Optional")
    ; sym_of(n, "_typeshed.Optional")
    ).

ann401_optional_ref(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type")),
    child(n, c1, _), ann401_optional_ref(c1).
ann401_optional_ref(n) :- ann401_late_optional_ref(n).

// union_ref(n): the JSON util `union-ref`, used where the JSON says `matches: "union-ref"`
.decl ann401_union_ref(n: node)
ann401_union_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Union")
    ; sym_of(n, "typing_extensions.Union")
    ; sym_of(n, "_typeshed.Union")
    ).

ann401_union_ref(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type")),
    child(n, c1, _), ann401_union_ref(c1).
ann401_union_ref(n) :- ann401_late_union_ref(n).

// annotated_ref(n): the JSON util `annotated-ref`, used where the JSON says `matches: "annotated-ref"`
.decl ann401_annotated_ref(n: node)
ann401_annotated_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Annotated")
    ; sym_of(n, "typing_extensions.Annotated")
    ; sym_of(n, "_typeshed.Annotated")
    ).

ann401_annotated_ref(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type")),
    child(n, c1, _), ann401_annotated_ref(c1).
ann401_annotated_ref(n) :- ann401_late_annotated_ref(n).

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl ann401_plain_string(n: node)
ann401_plain_string(n) :- kind(n, "string"), match("[rRuU]{0,2}['\"].*", n),
    count : { has(n, c1, "interpolation"), node(_, c1, _, _, _) } = 0.
ann401_plain_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c2, _), kind(c2, "string"), !match("[rRuU]{0,2}['\"].*", c2) } = 0.

// tuple_like(n): the JSON util `tuple-like`, used where the JSON says `matches: "tuple-like"`
.decl ann401_tuple_like(n: node)
ann401_tuple_like(n) :- kind(n, "tuple").
ann401_tuple_like(n) :- (kind(n, "type") ; kind(n, "parenthesized_expression")),
    child(n, c1, _), ann401_tuple_like(c1).

// c_any(n): the JSON util `c-any`, used where the JSON says `matches: "c-any"`
.decl ann401_c_any(n: node)
ann401_c_any(n) :- ann401_any_ref(n).
ann401_c_any(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type")), child(n, c1, _),
    ann401_c_any(c1).
ann401_c_any(n) :- kind(n, "binary_operator"), field(n, "operator", c2), glob("|", c2),
    ann401_alt_6(n).
ann401_c_any(n) :- ann401_alt_7(n).
ann401_c_any(n) :- ann401_alt_10(n).
ann401_c_any(n) :- ann401_alt_15(n).
ann401_c_any(n) :- ann401_plain_string(n), parsed(n, "annotation", r98), ann401_alt_19(r98).

// tuple_first_c(n): the JSON util `tuple-first-c`, used where the JSON says `matches: "tuple-first-c"`
.decl ann401_tuple_first_c(n: node)
ann401_tuple_first_c(n) :- kind(n, "tuple"), child(n, c1, _), !ann401_alt_21(c1), ann401_c_any(c1).

// first_c(n): the JSON util `first-c`, used where the JSON says `matches: "first-c"`
.decl ann401_first_c(n: node)
ann401_first_c(n) :- !ann401_tuple_like(n), ann401_c_any(n).
ann401_first_c(n) :- ann401_tuple_like(n), child(p1, n, _), !ann401_tok_has_5(p1), has(n, c10, "tuple"),
    child(c10, c11, _), !ann401_alt_22(c11), ann401_c_any(c11).

// r_extra(n): the JSON util `r-extra`, used where the JSON says `matches: "r-extra"`
.decl ann401_r_extra(n: node)
ann401_r_extra(n) :- ann401_optional_ref(n).
ann401_r_extra(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type")), child(n, c1, _),
    ann401_r_extra(c1).
ann401_r_extra(n) :- ann401_alt_25(n).

// first_r(n): the JSON util `first-r`, used where the JSON says `matches: "first-r"`
.decl ann401_first_r(n: node)
ann401_first_r(n) :- !ann401_tuple_like(n), ann401_r_extra(n).
ann401_first_r(n) :- ann401_tuple_like(n), child(p1, n, _), !ann401_tok_has_5(p1), has(n, c10, "tuple"),
    child(c10, c11, _), !ann401_alt_22(c11), ann401_r_extra(c11).

// top_any(n): the JSON util `top-any`, used where the JSON says `matches: "top-any"`
.decl ann401_top_any(n: node)
ann401_top_any(n) :- !ann401_plain_string(n), ann401_alt_29(n).
ann401_top_any(n) :- ann401_plain_string(n), parsed(n, "annotation", r1),
    kind(r1, "expression_statement"), child(r1, c2, _), ann401_alt_29(c2).
ann401_top_any(n) :- ann401_plain_string(n),
    ( kind(n, "concatenated_string")
    ; kind(n, "string"), match("(?s)[uU]?['\"].*\\\\.*", n)
    ),
    parsed(n, "annotation", r3), kind(r3, "expression_statement"), child(r3, c4, _),
    ann401_plain_string(c4).

// non_variadic(n): the JSON util `non-variadic`, used where the JSON says `matches: "non-variadic"`
.decl ann401_non_variadic(n: node)
ann401_non_variadic(n) :-
    ( kind(n, "identifier")
    ; kind(n, "default_parameter")
    ; kind(n, "typed_default_parameter")
    ).

ann401_non_variadic(n) :- kind(n, "typed_parameter"),
    count : { child(n, c1, _), (kind(c1, "list_splat_pattern") ; kind(c1, "dictionary_splat_pattern")) } = 0.

// method_not_static(n): the JSON util `method-not-static`, used where the JSON says `matches: "method-not-static"`
.decl ann401_method_not_static(n: node)
ann401_method_not_static(n) :- kind(n, "function_definition"), within_stop(n, p1, ann401_stop_32),
    kind(p1, "class_definition"),
    count : { child(p2, n, _), kind(p2, "decorated_definition"), child(p2, c3, _), kind(c3, "decorator"), child(c3, c4, _), ann401_static_ref(c4) } = 0.

// checked_fn(n): the JSON util `checked-fn`, used where the JSON says `matches: "checked-fn"`
.decl ann401_checked_fn(n: node)
ann401_checked_fn(n) :- kind(n, "function_definition"), field(n, "name", c1), node(_, c1, _, _, _), N = c1,
    count : { child(p1_1, n, _), kind(p1_1, "decorated_definition"), child(p1_1, c2_1, _), kind(c2_1, "decorator"), child(c2_1, c3_1, _), ann401_override_ref(c3_1) } = 0, count : { ann401_overload_impl(n, N) } = 0.

// checked_param(n): the JSON util `checked-param`, used where the JSON says `matches: "checked-param"`
.decl ann401_checked_param(n: node)
ann401_checked_param(n) :- child(p1, n, _), kind(p1, "parameters"), child(p2, p1, _),
    kind(p2, "function_definition"), ann401_checked_fn(p2),
    count : { ann401_non_variadic(n), count : { precedes(s3, n), ann401_non_variadic(s3) } = 0, child(p4, n, _), kind(p4, "parameters"), child(p5, p4, _), ann401_method_not_static(p5) } = 0.

// late_any_ref(n): the JSON util `late-any-ref`, used where the JSON says `matches: "late-any-ref"`
.decl ann401_late_any_ref(n: node)
ann401_late_any_ref(n) :- kind(n, "identifier"), node(_, n, _, _, _), LA = n, docof(n, d2), modnode(d2, m3),
    ( kind(n, "identifier"), !bind_only(n), miss(n, x1)
    ; (kind(n, "string") ; kind(n, "concatenated_string")), ann401_all_entry(n, x1), !bound_in(m3, x1)
    ),
    !builtin(x1), !star(m3), inside(n, p4, "module"), within(c5, p4), ann401_alt_34(c5, LA).
ann401_late_any_ref(n) :- kind(n, "attribute"), field(n, "attribute", c8), glob("Any", c8),
    field(n, "object", c9), kind(c9, "identifier"), node(_, c9, _, _, _), LA = c9, docof(c9, d11),
    modnode(d11, m12),
    ( kind(c9, "identifier"), !bind_only(c9), miss(c9, x10)
    ; (kind(c9, "string") ; kind(c9, "concatenated_string")), ann401_all_entry(c9, x10), !bound_in(m12, x10)
    ),
    !builtin(x10), !star(m12), inside(c9, p13, "module"), within(c14, p13),
    ann401_alt_35(c14, LA).

