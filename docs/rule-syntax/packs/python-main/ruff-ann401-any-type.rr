ann401_late_optional_ref(n) :- kind(n, "attribute"), field(n, "attribute", c8),
    glob("Optional", c8), field(n, "object", c9), kind(c9, "identifier"), node(_, c9, _, _, _), LO = c9,
    docof(c9, d11), modnode(d11, m12),
