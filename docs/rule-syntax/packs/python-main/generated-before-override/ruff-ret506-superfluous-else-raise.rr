.policy "ruff-ret506-superfluous-else-raise" revision 1
.guests off
.description "Remove the else or elif after an if branch that raises, and dedent its code; the branch already leaves the function."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// RET506(n): a finding at node n, from clause `superfluous-else-raise`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RET506(at: node, branch: loc) "Unnecessary `{branch}` after `raise` statement"
    suppress noqa "RET506"
RET506(n, BRANCH) :- match("(?<BRANCH>elif|else)", n), child(p1, n, _),
    (kind(p1, "elif_clause") ; kind(p1, "else_clause")),
    count : { precedes(s2, p1), (kind(s2, "elif_clause") ; kind(s2, "else_clause")) } = 0,
    child(p3, p1, _), kind(p3, "if_statement"), child(p3, c4, _), kind(c4, "block"),
    child(c4, c5, _), kind(c5, "raise_statement"),
    count : { precedes(s6, c5), (kind(s6, "return_statement") ; kind(s6, "continue_statement") ; kind(s6, "break_statement")) } = 0,
    within_stop(p3, p7, ret506_stop_1), kind(p7, "function_definition"),
    ret506_analysed_function(p7).

// analysed_function(n): the JSON util `analysed-function`, used where the JSON says `matches: "analysed-function"`
.decl ret506_analysed_function(n: node)
ret506_analysed_function(n) :- kind(n, "function_definition"),
    count : { ret506_stop_1_within(c1, n), kind(c1, "yield") } = 0,
    count : { child(n, c2, _), kind(c2, "block"), child(c2, c3, _), kind(c3, "return_statement"), count : { child(c2, c4, _), !kind(c4, "return_statement"), !kind(c4, "comment") } = 0 } = 0.

// none_literal(n): the JSON util `none-literal`, used where the JSON says `matches: "none-literal"`
.decl ret506_none_literal(n: node)
ret506_none_literal(n) :- kind(n, "none").
ret506_none_literal(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ret506_none_literal(c1).

// value_return(n): the JSON util `value-return`, used where the JSON says `matches: "value-return"`
.decl ret506_value_return(n: node)
ret506_value_return(n) :- kind(n, "return_statement"), child(n, c1, _),
    match("(?s).*..*", c1), !ret506_alt_2(c1).

// own_return(n): the JSON util `own-return`, used where the JSON says `matches: "own-return"`
.decl ret506_own_return(n: node)
ret506_own_return(n) :- kind(n, "return_statement").

// has_result(n): the JSON util `has-result`, used where the JSON says `matches: "has-result"`
.decl ret506_has_result(n: node)
ret506_has_result(n) :- within_stop(c1, n, ret506_stop_1), ret506_value_return(c1).

// stop_1: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl ret506_stop_1(kind: symbol)
ret506_stop_1("function_definition"). ret506_stop_1("class_definition").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl ret506_alt_2(n: node)
ret506_alt_2(n) :- node(_, n, _, _, _), glob("return", n).
ret506_alt_2(n) :- kind(n, "comment").
ret506_alt_2(n) :- ret506_none_literal(n).

// stop_1_within: within_stop over the stop set stop_1, read inside an aggregate
.decl ret506_stop_1_within(n: node, a: node)
ret506_stop_1_within(x, y) :- within_stop(x, y, ret506_stop_1).
