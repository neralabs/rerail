.policy "bandit-b113-request-without-timeout" revision 1
.guests off
.description "Pass a timeout to requests calls, and never set it to None on requests or httpx calls; without one, a slow server can hang the program indefinitely."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B113(n): a finding at node n, from clause `request-without-timeout`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on T are added to every rule.
.violation B113(at: node) "Pass a finite timeout to this HTTP call; without one a slow server can hang the program."
    suppress nosec "B113"
B113(n) :- kind(n, "call"),
    ( child(n, c1_1, _), (kind(c1_1, "identifier") ; kind(c1_1, "attribute")), sym_of(c1_1, q2_1), b113_set_1(q2_1), kind(n, "call"), b113_arg_no_timeout_1(n), unset(T)
    ; child(n, c3_2, _), ((kind(c3_2, "identifier") ; kind(c3_2, "attribute")), sym_of(c3_2, q1_2), b113_set_1(q1_2) ; (kind(c3_2, "identifier") ; kind(c3_2, "attribute")), sym_of(c3_2, q2_2), b113_set_10(q2_2)), kind(n, "call"), b113_arg_timeout_1(n, a6_2), T = a6_2
    ),
    kind(T, "none").

// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl b113_args_plain(l: node, a: node, i: number)
b113_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl b113_args_splat(l: node, i: number)
b113_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl b113_args_pos(l: node, a: node, j: number)
b113_args_pos(l, a, j) :- b113_args_plain(l, a, i), count : { b113_args_splat(l, k), k < i } = 0,
    j = count : { b113_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl b113_args_star(l: node, j: number)
b113_args_star(l, j) :- b113_args_splat(l, i), count : { b113_args_splat(l, k), k < i } = 0,
    j = count : { b113_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl b113_args_kwp(l: node, k: symbol, v: node)
b113_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl b113_args_lit_dict(s: node, d: node)
b113_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !b113_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl b113_args_str_pair(p: node)
b113_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl b113_args_kw(l: node, k: symbol, v: node)
b113_args_kw(l, k, v) :- b113_args_kwp(l, k, v).
b113_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), b113_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl b113_args_kw_spread(l: node)
b113_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !b113_args_lit_dict(s, _).

// arg_timeout_1: call n passes v for slot `timeout` of (*, timeout), as Python binds the call
.decl b113_arg_timeout_1(n: node, v: node)
b113_arg_timeout_1(n, v) :- kind(n, "call"), field(n, "arguments", l),
    b113_args_kw(l, "timeout", v), count : { b113_args_kw(l, "timeout", _) } = 1.

// arg_no_timeout_1: call n does not pass slot `timeout` of (*, timeout), as Python binds the call
.decl b113_arg_no_timeout_1(n: node)
b113_arg_no_timeout_1(n) :- kind(n, "call"), field(n, "arguments", l),
    !b113_args_kw(l, "timeout", _), !b113_args_kw_spread(l).

// set_1: symbols from the JSON `resolves.import`
.decl b113_set_1(v: symbol)
b113_set_1("requests.get"). b113_set_1("requests.options"). b113_set_1("requests.head").
b113_set_1("requests.post"). b113_set_1("requests.put"). b113_set_1("requests.patch").
b113_set_1("requests.delete").

// set_10: symbols from the JSON `resolves.import`
.decl b113_set_10(v: symbol)
b113_set_10("httpx.get"). b113_set_10("httpx.options"). b113_set_10("httpx.head").
b113_set_10("httpx.post"). b113_set_10("httpx.put"). b113_set_10("httpx.patch").
b113_set_10("httpx.delete"). b113_set_10("httpx.request"). b113_set_10("httpx.stream").
b113_set_10("httpx.Client"). b113_set_10("httpx.AsyncClient").
