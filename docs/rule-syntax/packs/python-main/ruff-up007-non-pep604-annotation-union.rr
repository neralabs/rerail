// in_type_checking(n): the JSON util `in-type-checking`, used where the JSON says `matches: "in-type-checking"`
.decl up007_in_type_checking(n: node)
up007_in_type_checking(n) :- inside(n, p1, "block"), field(p2, "consequence", p1),
    kind(p2, "if_statement"), field(p2, "condition", c3), up007_type_checking_test(c3).

