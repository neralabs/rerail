.policy "ruff-up007-non-pep604-annotation-union" revision 1
.guests off
.description "Write union types as X | Y instead of Union[X, Y]; the union operator is shorter and needs no typing import."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// annotation_root(n): the JSON util `annotation-root`, used where the JSON says `matches: "annotation-root"`
.decl up007_annotation_root(n: node)
up007_annotation_root(n) :- kind(n, "type"),
    ( field(p1, "type", n), (kind(p1, "typed_parameter") ; kind(p1, "typed_default_parameter") ; kind(p1, "assignment"))
    ; field(p2, "return_type", n), kind(p2, "function_definition")
    ).


// named_tuple_ref(n): the JSON util `named-tuple-ref`, used where the JSON says `matches: "named-tuple-ref"`
.decl up007_named_tuple_ref(n: node)
up007_named_tuple_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.NamedTuple")
    ; sym_of(n, "typing_extensions.NamedTuple")
    ; sym_of(n, "_typeshed.NamedTuple")
    ).


// named_tuple(n): the JSON util `named-tuple`, used where the JSON says `matches: "named-tuple"`
.decl up007_named_tuple(n: node)
up007_named_tuple(n) :- up007_named_tuple_ref(n).
up007_named_tuple(n) :- (kind(n, "type") ; kind(n, "parenthesized_expression")),
    child(n, c1, _), up007_named_tuple(c1).

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl up007_plain_string(n: node)
up007_plain_string(n) :- kind(n, "string"), !match("[a-zA-Z]*[bBfFtT].*", n).
up007_plain_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[a-zA-Z]*[bBfFtT].*", c1) } = 0.

// quoted_element(n): the JSON util `quoted-element`, used where the JSON says `matches: "quoted-element"`
.decl up007_quoted_element(n: node)
up007_quoted_element(n) :- up007_plain_string(n).
up007_quoted_element(n) :- (kind(n, "type") ; kind(n, "tuple") ; kind(n, "parenthesized_expression")),
    child(n, c1, _), up007_quoted_element(c1).

// starred_element(n): the JSON util `starred-element`, used where the JSON says `matches: "starred-element"`
.decl up007_starred_element(n: node)
up007_starred_element(n) :- (kind(n, "list_splat") ; kind(n, "splat_type")).
up007_starred_element(n) :- (kind(n, "type") ; kind(n, "tuple")), child(n, c1, _),
    up007_starred_element(c1).

// plain_slice(n): the JSON util `plain-slice`, used where the JSON says `matches: "plain-slice"`
.decl up007_plain_slice(n: node)
up007_plain_slice(n) :- node(_, n, _, _, _), !up007_alt_2(n).

// quoted_slice(n): the JSON util `quoted-slice`, used where the JSON says `matches: "quoted-slice"`
.decl up007_quoted_slice(n: node)
up007_quoted_slice(n) :- child(n, c1, _), up007_quoted_element(c1).

// union_subscript(n): the JSON util `union-subscript`, used where the JSON says `matches: "union-subscript"`
.decl up007_union_subscript(n: node)
up007_union_subscript(n) :- kind(n, "subscript"), up007_plain_slice(n), field(n, "value", c1),
    up007_union_head(c1).

// union_generic(n): the JSON util `union-generic`, used where the JSON says `matches: "union-generic"`
.decl up007_union_generic(n: node)
up007_union_generic(n) :- kind(n, "generic_type"), child(n, c1, _), kind(c1, "identifier"),
    up007_union_head(c1), child(n, c2, _), kind(c2, "type_parameter"), up007_plain_slice(c2).

// union_node(n): the JSON util `union-node`, used where the JSON says `matches: "union-node"`
.decl up007_union_node(n: node)
up007_union_node(n) :- up007_union_subscript(n).
up007_union_node(n) :- up007_union_generic(n).

// quoted_union(n): the JSON util `quoted-union`, used where the JSON says `matches: "quoted-union"`
.decl up007_quoted_union(n: node)
up007_quoted_union(n) :- kind(n, "subscript"), up007_quoted_slice(n).
up007_quoted_union(n) :- kind(n, "generic_type"), child(n, c1, _),
    kind(c1, "type_parameter"), up007_quoted_slice(c1).

// type_checking_test(n): the JSON util `type-checking-test`, used where the JSON says `matches: "type-checking-test"`
.decl up007_type_checking_test(n: node)
up007_type_checking_test(n) :- kind(n, "identifier"), glob("TYPE_CHECKING", n).
up007_type_checking_test(n) :- kind(n, "identifier"),
    ( sym_of(n, "typing.TYPE_CHECKING")
    ; sym_of(n, "typing_extensions.TYPE_CHECKING")
    ; sym_of(n, "_typeshed.TYPE_CHECKING")
    ).

up007_type_checking_test(n) :- kind(n, "attribute"), field(n, "attribute", c1),
    glob("TYPE_CHECKING", c1).
up007_type_checking_test(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
