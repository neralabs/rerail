// in_type_param(n): the JSON util `in-type-param`, used where the JSON says `matches: "in-type-param"`
.decl up007_in_type_param(n: node)
up007_in_type_param(n) :- within(n, p1),
    ( kind(p1, "type_parameter"), field(p2, "type_parameters", p1), (kind(p2, "function_definition") ; kind(p2, "class_definition"))
    ; kind(p1, "type"), child(p3, p1, _), kind(p3, "type_alias_statement")
    ).


// typing_context(n): the JSON util `typing-context`, used where the JSON says `matches: "typing-context"`
.decl up007_typing_context(n: node)
up007_typing_context(n) :- up007_in_type_checking(n).
up007_typing_context(n) :- up007_in_local_annotation(n).
up007_typing_context(n) :- up007_in_type_param(n).
up007_typing_context(n) :- up007_future_annotations(n), up007_up_2(n, p1).

// UP007(n): a finding at node n, from clause `union-annotation`.
