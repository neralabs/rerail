.decl up007_in_annotation(n: node)
up007_in_annotation(n) :- up007_demand_in_annotation(n), up007_up_1(n, p1).

// in_local_annotation(n): the JSON util `in-local-annotation`, used where the JSON says `matches: "in-local-annotation"`
.decl up007_in_local_annotation(n: node)
up007_in_local_annotation(n) :- within(n, p1), up007_annotation_root(p1), child(p2, p1, _),
