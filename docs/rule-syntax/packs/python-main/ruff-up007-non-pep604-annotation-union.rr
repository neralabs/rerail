// future_stmt(n): the JSON util `future-stmt`, used where the JSON says `matches: "future-stmt"`
.decl up007_future_stmt(n: node)
up007_future_stmt(n) :- kind(n, "future_import_statement"), has(n, c1, "identifier"),
