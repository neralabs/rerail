.decl up007_tok_has_1(n: node)
.stored up007_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up007_tok_has_1(n) :- child(n, c4, _), glob("\\,", c4).
up007_tok_has_1(n) :- op(n, t5), match(",", t5).
up007_tok_has_1(n) :- child(n, c11, _), structural_before(c11, g6),
