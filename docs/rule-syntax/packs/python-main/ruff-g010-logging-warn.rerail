.policy "ruff-g010-logging-warn" revision 1
.description "Call the warning logging method instead of warn; warn is a deprecated alias of warning."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/names.rerail"

// G010(n): a finding at node n, from clause `logging-warn`.
// Each rule below is one way the JSON `rule` can match.
.violation G010(at: node) "Replace the deprecated `warn` logging call with `warning`, which takes the same arguments; leave it if this object is not a standard logger and has no `warning` method."
    suppress noqa "G010"
G010(n) :- kind(n, "identifier"),
    ( glob("warn", n), field(p1, "attribute", n), kind(p1, "attribute"), field(p1, "object", c1), g010_logger_object(c1), g010_callee(p1)
    ; g010_callee(n), sym_of(n, "logging.warn")
    ).


// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
.decl g010_callee(n: node)
g010_callee(n) :- field(p1, "function", n), kind(p1, "call").
g010_callee(n) :- child(p2, n, _), kind(p2, "parenthesized_expression"), g010_callee(p2).

// name_chain(n): the JSON util `name-chain`, used where the JSON says `matches: "name-chain"`
.decl g010_name_chain(n: node)
g010_name_chain(n) :- kind(n, "identifier").
g010_name_chain(n) :- kind(n, "attribute"), field(n, "object", c1), g010_name_chain(c1).
g010_name_chain(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), g010_name_chain(c2).

// logger_object(n): the JSON util `logger-object`, used where the JSON says `matches: "logger-object"`
.decl g010_logger_object(n: node)
g010_logger_object(n) :- kind(n, "call"), field(n, "function", c1),
    (sym_of(c1, "logging.getLogger") ; sym_of(c1, "logging.Logger")).
g010_logger_object(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    g010_logger_object(c2).
g010_logger_object(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (sym_of(n, "logging") ; sym_of(n, "flask.current_app.logger")).
g010_logger_object(n) :-
    ( kind(n, "identifier"), match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", n)
    ; kind(n, "attribute"), g010_tok_has_2(n), field(n, "object", c1), g010_name_chain(c1)
    ),
    !sym_of(n, _).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^(log|LOG)|(logger|logging|LOGGER|LOGGING)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl g010_tok_has_1(n: node)
.stored g010_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
g010_tok_has_1(n) :- field(n, "attribute", c3),
    match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", c3).
g010_tok_has_1(n) :- op(n, t4),
    match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", t4).
g010_tok_has_1(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g5).
g010_tok_has_1(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g5).
g010_tok_has_1(n) :- node_text(n, g5), !child(n, _, _),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g5).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^(log|LOG)|(logger|logging|LOGGER|LOGGING)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl g010_tok_has_2(n: node)
.stored g010_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
g010_tok_has_2(n) :- field(n, "attribute", c1),
    match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", c1).
g010_tok_has_2(n) :- op(n, t2),
    match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", t2).
g010_tok_has_2(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g3).
g010_tok_has_2(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g3).
g010_tok_has_2(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g3).
