air312_set_7("airflow.providers.standard.triggers.external_task.DagStateTrigger").
air312_set_7("airflow.providers.standard.triggers.external_task.WorkflowTrigger").
air312_set_7("airflow.providers.standard.triggers.file.FileTrigger").
air312_set_7("airflow.providers.standard.triggers.temporal.DateTimeTrigger").
air312_set_7("airflow.providers.standard.triggers.temporal.TimeDeltaTrigger").

// stop_11: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl air312_stop_11(kind: symbol)
air312_stop_11("function_definition"). air312_stop_11("class_definition").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   REAL: metavariable of the calling rule, passed in (bound by the caller)
.decl air312_alt_2(n: node, real: loc)
air312_alt_2(n, REAL) :- air312_demand_alt_2(n, REAL), kind(n, "dotted_name"),
    text(n, t_real1), text(REAL, t_real1), @doc(n) = @doc(REAL).
air312_alt_2(n, REAL) :- air312_demand_alt_2(n, REAL), kind(n, "aliased_import"),
    field(n, "name", c1), child(c1, c2, _), kind(c2, "identifier"),
    text(c2, t_real2), text(REAL, t_real2), !air312_tok_precedes_1(c2), @doc(c2) = @doc(REAL).

// stop_3(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl air312_stop_3(n: node)
air312_stop_3(n) :- kind(n, "except_clause").
air312_stop_3(n) :- kind(n, "block"), child(p1, n, _),
    (kind(p1, "function_definition") ; kind(p1, "class_definition")).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
//   LOCAL: metavariable this relation binds for the calling rule
.decl air312_alt_8(n: node, local: loc)
air312_alt_8(n, LOCAL) :- kind(n, "dotted_name"), air312_guarded_import(n), node(_, n, _, _, _), LOCAL = n,
    site_latest(n), count : { child(p1, n, _), kind(p1, "aliased_import") } = 0.
air312_alt_8(n, LOCAL) :- kind(n, "aliased_import"), air312_guarded_import(n), field(n, "alias", c2),
    node(_, c2, _, _, _), LOCAL = c2, site_latest(c2).

// stop_10(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl air312_stop_10(n: node)
air312_stop_10(n) :- kind(n, "block"), child(p1, n, _),
    (kind(p1, "function_definition") ; kind(p1, "class_definition")).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
//   ATTR: metavariable of the calling rule, passed in (bound by the caller)
.decl air312_alt_12(n: node, attr: loc)
air312_alt_12(n, ATTR) :- air312_demand_alt_12(n, ATTR), inside(n, p1, "block"), child(p2, p1, _),
    kind(p2, "function_definition"), has(p2, c3, "except_clause"), within(c4, c3),
    air312_guarded_local(c4, ATTR), within_stop(c4, p5, air312_stop_11),
    kind(p5, "function_definition").
air312_alt_12(n, ATTR) :- air312_demand_alt_12(n, ATTR), within_stop(n, p6, air312_stop_10),
    kind(p6, "block"), child(p7, p6, _), kind(p7, "class_definition"),
    has(p7, c8, "except_clause"), within(c9, c8), air312_guarded_local(c9, ATTR),
    within_stop(c9, p10, air312_stop_11), kind(p10, "class_definition").

// alt_16(n): the JSON `any`: n matches if any one of these rules does
//   ATTR: metavariable this relation binds for the calling rule
.decl air312_alt_16(n: node, attr: loc)
air312_alt_16(n, ATTR) :- kind(n, "identifier"), ATTR = n, air312_deprecated(n),
    count : { child(p1, n, _), kind(p1, "attribute"), !air312_tok_precedes_3(n) } = 0.
air312_alt_16(n, ATTR) :- air312_string_name(n, ATTR).

// alt_17(n): the JSON `any`: n matches if any one of these rules does
//   ATTR: metavariable this relation binds for the calling rule
.decl air312_alt_17(n: node, attr: loc)
air312_alt_17(n, ATTR) :- kind(n, "identifier"), ATTR = n, child(p1, n, _),
    kind(p1, "attribute"), air312_deprecated(p1), !air312_tok_precedes_3(n).
air312_alt_17(n, ATTR) :- air312_string_attribute(n, ATTR).

// alt_19(n): the JSON `any`: n matches if any one of these rules does
.decl air312_alt_19(n: node)
air312_alt_19(n) :- air312_aug_target(n).
air312_alt_19(n) :- air312_del_target(n).
air312_alt_19(n) :- ref_site(n, b1), (st2 = b1 ; within(b1, st2)), air312_guarded_import(st2).

// alt_20(n): the JSON `any`: n matches if any one of these rules does
//   ATTR: metavariable this relation binds for the calling rule
.decl air312_alt_20(n: node, attr: loc)
air312_alt_20(n, ATTR) :- kind(n, "identifier"), node(_, n, _, _, _), ATTR = n, air312_deprecated(n), !air312_alt_19(n).
air312_alt_20(n, ATTR) :- kind(n, "identifier"), node(_, n, _, _, _), ATTR = n, field(p3, "attribute", n),
    kind(p3, "attribute"), air312_deprecated(p3), !air312_guarded_attribute(p3, ATTR).
air312_alt_20(n, ATTR) :- air312_string_name(n, ATTR), !air312_guarded_forward(n, ATTR).
air312_alt_20(n, ATTR) :- air312_string_attribute(n, ATTR), !air312_guarded_attribute(n, ATTR).
