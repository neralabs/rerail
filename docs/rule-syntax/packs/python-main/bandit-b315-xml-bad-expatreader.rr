.policy "bandit-b315-xml-bad-expatreader" revision 1
.guests off
.description "Use defusedxml instead of creating parsers with xml.sax.expatreader; the standard parser is open to entity-expansion and other XML attacks on untrusted input."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B315(n): a finding at node n, from clause `bandit:B315`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on F are added to every rule.
.violation B315(at: node) "Using xml.sax.expatreader to parse untrusted XML may permit XML attacks; use defusedxml."
    suppress nosec "B315"
B315(n) :- n ~ `$F($$$ARGS)`, sym_of(F, "xml.sax.expatreader.create_parser").
