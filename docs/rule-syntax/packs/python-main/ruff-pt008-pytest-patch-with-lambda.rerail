.stored pt008_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt008_tok_has_2(n) :- field(n, "attribute", c3), glob("patch", c3).
pt008_tok_has_2(n) :- op(n, t4), match("patch", t4).
pt008_tok_has_2(n) :- child(n, c10, _), structural_before(c10, g5),
