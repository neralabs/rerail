.decl pt008_tok_has_10(n: node)
.stored pt008_tok_has_10 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt008_tok_has_10(n) :- field(n, "name", c55), glob("return_value", c55).
pt008_tok_has_10(n) :- op(n, t56), match("return_value", t56).
pt008_tok_has_10(n) :- child(n, c62, _), structural_before(c62, g57),
    match("(?s)^(?:(?:.*\\W)?(?:return_value)(?:\\W.*)?)$", g57).
