.stored pt008_tok_has_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt008_tok_has_5(n) :- field(n, "name", c14), glob("new", c14).
pt008_tok_has_5(n) :- op(n, t15), match("new", t15).
pt008_tok_has_5(n) :- child(n, c21, _), structural_before(c21, g16),
