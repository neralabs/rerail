.decl ruf046_none_p(n: node)
ruf046_none_p(n) :- kind(n, "none").
ruf046_none_p(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_none_p(c1).

// int_callee_family(n, key): 3 copies of one rule set (`int-callee`, `int-ref`, `round-callee`), folded into one: row `key` of
// int_callee_family_case gives the strings each copy had.
.decl ruf046_int_callee_family(n: node, key: symbol)
ruf046_int_callee_family(n, q1) :- ruf046_int_callee_family_case(q1, s1, s2),
    (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, s1), sym_of(n, s2).
ruf046_int_callee_family(n, q1) :- ruf046_int_callee_family_case(q1, s1, s2),
    kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_int_callee_family(c1, q1).

