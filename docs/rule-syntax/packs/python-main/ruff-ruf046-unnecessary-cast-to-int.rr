.decl ruf046_tok_precedes_9(n: node)
.stored ruf046_tok_precedes_9 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf046_tok_precedes_9(n) :- precedes(n, s9), glob("as", s9).
ruf046_tok_precedes_9(n) :- child(p12, n, _), node(_, n, _, _, en15),
    token(p12, _, t10, st14, _), st14 >= en15, match("as", t10).
ruf046_tok_precedes_9(n) :- structural_after(n, g11),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g11).
ruf046_tok_precedes_9(n) :- precedes(n, o13), structural_after(o13, g11),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g11).

// set_3: names from the JSON `resolves.global`
.decl ruf046_set_3(v: symbol)
ruf046_set_3("len"). ruf046_set_3("id"). ruf046_set_3("hash"). ruf046_set_3("ord"). ruf046_set_3("int").

// set_4: symbols from the JSON `resolves.import`
.decl ruf046_set_4(v: symbol)
ruf046_set_4("builtins.len"). ruf046_set_4("builtins.id"). ruf046_set_4("builtins.hash").
ruf046_set_4("builtins.ord"). ruf046_set_4("builtins.int"). ruf046_set_4("math.comb").
ruf046_set_4("math.factorial"). ruf046_set_4("math.gcd"). ruf046_set_4("math.lcm"). ruf046_set_4("math.isqrt").
ruf046_set_4("math.perm").

// int_callee_family_case: one row per relation folded into int_callee_family: its key, then the strings that differed.
.decl ruf046_int_callee_family_case(key: symbol, s1: symbol, s2: symbol)
ruf046_int_callee_family_case("int_callee", "int", "builtins.int").
ruf046_int_callee_family_case("int_ref", "int", "builtins.int").
ruf046_int_callee_family_case("round_callee", "round", "builtins.round").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl ruf046_alt_1(n: node)
ruf046_alt_1(n) :- field(n, "left", c1), ruf046_ti(c1).
ruf046_alt_1(n) :- field(n, "right", c2), ruf046_ti(c2).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl ruf046_alt_2(n: node)
ruf046_alt_2(n) :- child(n, c1, _), ruf046_ti(c1), ruf046_tok_precedes_7(c1).
ruf046_alt_2(n) :- child(n, c9, _), ruf046_ti(c9), ruf046_tok_follows_8(c9).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl ruf046_alt_6(n: node)
ruf046_alt_6(n) :- (kind(n, "keyword_argument") ; kind(n, "dictionary_splat") ; kind(n, "list_splat")).
ruf046_alt_6(n) :- ruf046_arg_trivia(n).

// counted_8(n): the siblings the JSON `nthChild.ofRule` counts
.decl ruf046_counted_8(n: node)
ruf046_counted_8(n) :- ruf046_positional(n).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl ruf046_alt_11(n: node)
ruf046_alt_11(n) :- child(n, c1, _), ruf046_pos0(c1).
ruf046_alt_11(n) :- child(n, c2, _), ruf046_kw_number(c2).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
.decl ruf046_alt_12(n: node)
ruf046_alt_12(n) :- node(_, n, _, _, _), count : { child(n, c1, _), ruf046_pos1(c1) } = 0,
    count : { child(n, c2, _), ruf046_kw_ndigits(c2) } = 0.
ruf046_alt_12(n) :- child(n, c3, _), ruf046_pos1(c3), ruf046_none_p(c3).
ruf046_alt_12(n) :- child(n, c4, _), ruf046_kw_ndigits(c4), field(c4, "value", c5), ruf046_none_p(c5).

// alt_13(n): the JSON `any`: n matches if any one of these rules does
.decl ruf046_alt_13(n: node)
ruf046_alt_13(n) :- child(n, c1, _), ruf046_pos0(c1), ruf046_int_like(c1).
ruf046_alt_13(n) :- child(n, c2, _), ruf046_kw_number(c2), field(c2, "value", c3), ruf046_int_like(c3).

// alt_14(n): the JSON `any`: n matches if any one of these rules does
.decl ruf046_alt_14(n: node)
ruf046_alt_14(n) :- child(n, c1, _), ruf046_pos1(c1), ruf046_ti(c1).
ruf046_alt_14(n) :- child(n, c2, _), ruf046_kw_ndigits(c2), field(c2, "value", c3), ruf046_ti(c3).

// alt_22(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl ruf046_alt_22(n: node, c: loc)
ruf046_alt_22(n, C) :- ruf046_cast_of_int(n), C = n.
ruf046_alt_22(n, C) :- ruf046_cast_of_int_in_type(n, C).

// alt_23(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl ruf046_alt_23(n: node, c: loc)
ruf046_alt_23(n, C) :- ruf046_cast_of_rounded(n), C = n.
ruf046_alt_23(n, C) :- ruf046_cast_of_rounded_in_type(n, C).
