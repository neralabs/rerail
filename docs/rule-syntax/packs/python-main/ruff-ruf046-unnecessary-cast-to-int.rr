.policy "ruff-ruf046-unnecessary-cast-to-int" revision 1
.guests off
.description "Remove int() around a value that is already an integer, such as a length, an integer literal or arithmetic on integers."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// tb(n): the JSON util `tb`, used where the JSON says `matches: "tb"`
.decl ruf046_tb(n: node)
ruf046_tb(n) :- (kind(n, "true") ; kind(n, "false") ; kind(n, "not_operator")).
ruf046_tb(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_tb(c1).
ruf046_tb(n) :- kind(n, "named_expression"), field(n, "value", c2), ruf046_tb(c2).
ruf046_tb(n) :- kind(n, "boolean_operator"), field(n, "left", c3), ruf046_tb(c3),
    field(n, "right", c4), ruf046_tb(c4).
ruf046_tb(n) :- kind(n, "conditional_expression"), child(n, c5, _), ruf046_tb(c5),
    ruf046_tok_precedes_1(c5), child(n, c13, _), ruf046_tb(c13), ruf046_tok_follows_2(c13).

// ti(n): the JSON util `ti`, used where the JSON says `matches: "ti"`
.decl ruf046_ti(n: node)
ruf046_ti(n) :- kind(n, "integer"), !glob("**[jJ]", n).
ruf046_ti(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf046_ti(c1).
ruf046_ti(n) :- kind(n, "named_expression"), field(n, "value", c2), ruf046_ti(c2).
ruf046_ti(n) :- kind(n, "unary_operator"), field(n, "operator", c3), glob("[-+~]", c3),
    field(n, "argument", c4), ruf046_ib(c4).
ruf046_ti(n) :- kind(n, "binary_operator"), field(n, "operator", c5),
    glob("{+,-,%,\\*,//,\\*\\*,&,|,^,<<,>>}", c5), field(n, "left", c6), ruf046_ib(c6),
    field(n, "right", c7), ruf046_ib(c7).
ruf046_ti(n) :- kind(n, "boolean_operator"), field(n, "left", c8), ruf046_ib(c8),
    field(n, "right", c9), ruf046_ib(c9), ruf046_alt_1(n).
ruf046_ti(n) :- kind(n, "conditional_expression"), child(n, c12, _), ruf046_ib(c12),
    ruf046_tok_precedes_3(c12), child(n, c20, _), ruf046_ib(c20), ruf046_tok_follows_4(c20), ruf046_alt_2(n).

// ib(n): the JSON util `ib`, used where the JSON says `matches: "ib"`
.decl ruf046_ib(n: node)
ruf046_ib(n) :- ruf046_ti(n).
ruf046_ib(n) :- ruf046_tb(n).

