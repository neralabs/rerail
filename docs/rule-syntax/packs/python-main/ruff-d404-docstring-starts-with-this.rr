.policy "ruff-d404-docstring-starts-with-this" revision 1
.guests off
.description "Start a docstring with an imperative verb rather than the word This; a summary phrased as a command reads consistently."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// D404(n): a finding at node n, from clause `docstring-starts-with-this`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `transform` computes FIRST, LETTERS, THIS, WORD from other metavariables' text; its literals end each rule.
.violation D404(at: node) "Reword this docstring's summary so it does not open with \"This\": start a function's with an imperative verb (`Return the total.`), a class's or module's with what it is."
    suppress noqa "D404"
D404(n) :- d404_docstring(n), child(n, c3, _), kind(c3, "string_content"), node(_, c3, _, _, _), DOC = c3,
    WORD = THIS, text(DOC, t1),
    FIRST = @replace_all(t1, "^\\s*([^ ]*)[\\s\\S]*$", "$1"),
    LETTERS = @replace_all(FIRST, "[^\\p{Alphabetic}\\p{N}]", ""),
    WORD = @convert(LETTERS, "lowerCase", ""), text(DOC, t2),
    THIS = @replace_all(t2, "^[\\s\\S]*$", "this").

// doc_stmt(n): the JSON util `doc-stmt`, used where the JSON says `matches: "doc-stmt"`
.decl d404_doc_stmt(n: node)
d404_doc_stmt(n) :- kind(n, "expression_statement"), !d404_alt_1(n),
    ( child(p1, n, _), kind(p1, "module")
    ; child(p2, n, _), kind(p2, "block"), child(p3, p2, _), (kind(p3, "function_definition") ; kind(p3, "class_definition"))
    ).


// doc_holder(n): the JSON util `doc-holder`, used where the JSON says `matches: "doc-holder"`
.decl d404_doc_holder(n: node)
d404_doc_holder(n) :- d404_doc_stmt(n).
d404_doc_holder(n) :- kind(n, "parenthesized_expression"), child(p1, n, _), d404_doc_holder(p1).

// docstring(n): the JSON util `docstring`, used where the JSON says `matches: "docstring"`
.decl d404_docstring(n: node)
d404_docstring(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0,
    child(p2, n, _), d404_doc_holder(p2).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d404_tok_has_1(n: node)
.stored d404_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d404_tok_has_1(n) :- child(n, c1, _), glob("\\,", c1).
d404_tok_has_1(n) :- op(n, t2), match(",", t2).
d404_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d404_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d404_tok_has_1(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl d404_alt_1(n: node)
d404_alt_1(n) :- d404_tok_has_1(n).
d404_alt_1(n) :- precedes(s9, n), !kind(s9, "comment").
