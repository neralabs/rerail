.decl up034_only_child_of_parentheses(n: node)
up034_only_child_of_parentheses(n) :- child(p1, n, _), up034_counted_4(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), up034_counted_4(s2) }, k3 = 0,
    child(p4, n, _), up034_counted_5(n),
    k6 = count : { child(p4, s5, _), precedes(n, s5), up034_counted_5(s5) }, k6 = 0,
    child(p7, n, _),
    ( kind(p7, "parenthesized_expression")
    ; kind(p7, "argument_list"), !up034_tok_has_3(p7)
    ; kind(p7, "tuple_pattern"), !up034_tok_has_4(p7)
    ),
    !up034_consumed_outer(p7).

// doubled(n): the JSON util `doubled`, used where the JSON says `matches: "doubled"`
.decl up034_doubled(n: node)
up034_doubled(n) :- up034_group(n),
    ( up034_only_child_of_parentheses(n)
    ; child(p1, n, _), kind(p1, "case_pattern"), up034_only_child_of_parentheses(p1)
    ; child(p2, n, _), kind(p2, "case_pattern"), child(p3, p2, _), kind(p3, "class_pattern"), !up034_alt_7(p3)
    ).


