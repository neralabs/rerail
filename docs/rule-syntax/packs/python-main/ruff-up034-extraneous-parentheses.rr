up034_after_open_parenthesis(n) :- precedes_stop(s1, n, up034_counted_4), glob("(", s1).
up034_after_open_parenthesis(n) :- count : { up034_counted_4_precedes(s2, n), !kind(s2, "comment"), !kind(s2, "line_continuation") } = 0,
