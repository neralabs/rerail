.decl up034_group(n: node)
up034_group(n) :-
    ( kind(n, "generator_expression")
    ; kind(n, "parenthesized_expression")
    ; kind(n, "tuple_pattern")
    ),
    count : { up034_stop_13_within(c1, n), up034_alt_3(c1) } = 0.

