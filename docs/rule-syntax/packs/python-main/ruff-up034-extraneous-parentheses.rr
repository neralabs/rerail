up034_tok_has_2(n) :- op(n, t17), match(",", t17).
up034_tok_has_2(n) :- child(n, c23, _), structural_before(c23, g18),
    match("(?s)^(?:.*(?:,).*)$", g18).
up034_tok_has_2(n) :- child(n, c23, _), structural_after(c23, g18),
