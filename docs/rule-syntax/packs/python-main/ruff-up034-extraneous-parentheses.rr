// set_1: node kinds from a JSON `any`
.decl up034_set_1(v: symbol)
up034_set_1("parenthesized_expression"). up034_set_1("tuple"). up034_set_1("list"). up034_set_1("set").
up034_set_1("dictionary"). up034_set_1("argument_list"). up034_set_1("subscript").
up034_set_1("generator_expression"). up034_set_1("list_comprehension"). up034_set_1("set_comprehension").
up034_set_1("dictionary_comprehension"). up034_set_1("interpolation"). up034_set_1("string").
up034_set_1("concatenated_string"). up034_set_1("tuple_pattern"). up034_set_1("list_pattern").
up034_set_1("dict_pattern"). up034_set_1("class_pattern").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl up034_alt_3(n: node)
up034_alt_3(n) :- node(_, n, _, _, _), glob("\\,", n).
up034_alt_3(n) :- node(_, n, _, _, _), glob("yield", n).

// counted_4(n): the siblings the JSON `nthChild.ofRule` counts
.decl up034_counted_4(n: node)
up034_counted_4(n) :- node(_, n, _, _, _), !kind(n, "comment"),
    !kind(n, "line_continuation").

// counted_5(n): the siblings the JSON `nthChild.ofRule` counts
.decl up034_counted_5(n: node)
up034_counted_5(n) :- node(_, n, _, _, _), !kind(n, "comment"),
    !kind(n, "line_continuation").

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl up034_alt_7(n: node)
up034_alt_7(n) :- up034_tok_has_3(n).
up034_alt_7(n) :- up034_consumed_outer(n).

// stop_13(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl up034_stop_13(n: node)
up034_stop_13(n) :- up034_bracket(n).

// alt_15(n): the JSON `any`: n matches if any one of these rules does
.decl up034_alt_15(n: node)
up034_alt_15(n) :- up034_alt_15_u7(n).

// stop_13_within: within_stop over the stop set stop_13, read inside an aggregate
.decl up034_stop_13_within(n: node, a: node)
up034_stop_13_within(x, y) :- within_stop(x, y, up034_stop_13).

// counted_4_precedes: precedes_stop over the stop set counted_4, read inside an aggregate
.decl up034_counted_4_precedes(a: node, b: node)
up034_counted_4_precedes(x, y) :- precedes_stop(x, y, up034_counted_4).
