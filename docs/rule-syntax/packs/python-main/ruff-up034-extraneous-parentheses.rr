    ; kind(n, "parenthesized_expression"), !up034_group(n)
    ),
    up034_after_open_parenthesis(n), !up034_after_args_open(n),
    count : { within(n, p9), up034_group_start(p9) } = 0, !up034_before_scan_stop_u3(n).

.decl up034_tuple_start_u5(n: node)
up034_tuple_start_u5(n) :-
    ( kind(n, "tuple"), up034_tok_has_6(n)
    ; kind(n, "tuple_pattern"), !up034_group(n)
    ; kind(n, "generator_expression"), !up034_group(n)
    ; kind(n, "parenthesized_expression"), !up034_group(n)
    ),
    up034_after_open_parenthesis(n), !up034_after_args_open(n),
    count : { within(n, p9), up034_group_start(p9) } = 0, !up034_before_scan_stop_u4(n).

.decl up034_tuple_start_u6(n: node)
up034_tuple_start_u6(n) :-
    ( kind(n, "tuple"), up034_tok_has_6(n)
    ; kind(n, "tuple_pattern"), !up034_group(n)
    ; kind(n, "generator_expression"), !up034_group(n)
    ; kind(n, "parenthesized_expression"), !up034_group(n)
    ),
    up034_after_open_parenthesis(n), !up034_after_args_open(n),
    count : { within(n, p9), up034_group_start(p9) } = 0, !up034_before_scan_stop_u5(n).

.decl up034_tuple_start_u7(n: node)
up034_tuple_start_u7(n) :-
    ( kind(n, "tuple"), up034_tok_has_6(n)
    ; kind(n, "tuple_pattern"), !up034_group(n)
    ; kind(n, "generator_expression"), !up034_group(n)
    ; kind(n, "parenthesized_expression"), !up034_group(n)
    ),
    up034_after_open_parenthesis(n), !up034_after_args_open(n),
    count : { within(n, p9), up034_group_start(p9) } = 0, !up034_before_scan_stop_u6(n).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up034_tok_has_1(n: node)
.stored up034_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up034_tok_has_1(n) :- child(n, c8, _), glob("\\,", c8).
up034_tok_has_1(n) :- op(n, t9), match(",", t9).
up034_tok_has_1(n) :- child(n, c15, _), structural_before(c15, g10),
    match("(?s)^(?:.*(?:,).*)$", g10).
up034_tok_has_1(n) :- child(n, c15, _), structural_after(c15, g10),
    match("(?s)^(?:.*(?:,).*)$", g10).
up034_tok_has_1(n) :- node_text(n, g10), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g10).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
