.policy "ruff-up034-extraneous-parentheses" revision 1
.guests off
.description "Remove redundant doubled parentheses around an expression; one pair is enough."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// UP034(n): a finding at node n, from clause `extraneous-parentheses`.
// Each rule below is one way the JSON `rule` can match.
.violation UP034(at: node) "Delete the highlighted inner pair of parentheses; the enclosing parentheses already group this expression, so the meaning is unchanged."
    suppress noqa "UP034"
UP034(n) :- up034_doubled(n).

// bracket(n): the JSON util `bracket`, used where the JSON says `matches: "bracket"`
.decl up034_bracket(n: node)
up034_bracket(n) :- kind(n, k1), up034_set_1(k1).

