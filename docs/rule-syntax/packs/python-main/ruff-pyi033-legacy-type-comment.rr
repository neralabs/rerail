.policy "ruff-pyi033-legacy-type-comment" revision 1
.guests off
.description "Use inline annotations instead of type comments in stub files; type comments are deprecated and never needed in stubs."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// PYI033(n): a finding at node n, from clause `legacy-type-comment`.
// Each rule below is one way the JSON `rule` can match.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI033(at: node) "Replace this type comment with an inline annotation, such as `x: int = 1` or a per-parameter annotation; stubs never need type comments. Leave `type: ignore` comments alone."
    suppress noqa "PYI033"
PYI033_raw(n) :- kind(n, "comment"),
    match("#\\s*type:(?:[^\\si#]|\\s*(?:i(?:$|[^g])|ig(?:$|[^n])|ign(?:$|[^o])|igno(?:$|[^r])|ignor(?:$|[^e]))|\\s+(?:$|[^\\si])).*", n).

// main's file condition {"regex": "\\.pyi$"}
.decl PYI033_raw(at: node)
PYI033(v0) :- PYI033_raw(v0), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).
