.policy "ruff-up031-printf-string-formatting" revision 1
.guests off
.description "Prefer an f-string or str.format() over printf-style percent formatting; it is more readable and avoids tuple-versus-value surprises."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl up031_plain_string(n: node)
up031_plain_string(n) :- kind(n, "string"), !match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", n).
up031_plain_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", c1) } = 0.

// seg_err(n): the JSON util `seg-err`, used where the JSON says `matches: "seg-err"`
.decl up031_seg_err(n: node)
up031_seg_err(n) :- kind(n, "string"), parsed(n, "percentFormat", r1), child(r1, c2, _),
    kind(c2, "error").

// seg_nonconv(n): the JSON util `seg-nonconv`, used where the JSON says `matches: "seg-nonconv"`
.decl up031_seg_nonconv(n: node)
up031_seg_nonconv(n) :- kind(n, "string"), parsed(n, "percentFormat", r1),
    count : { child(r1, c2, _), kind(c2, "error") } = 0, child(r1, c3, _),
    kind(c3, "placeholder"), up031_alt_1(c3).

// seg_nonconv_dict(n): the JSON util `seg-nonconv-dict`, used where the JSON says `matches: "seg-nonconv-dict"`
.decl up031_seg_nonconv_dict(n: node)
up031_seg_nonconv_dict(n) :- up031_seg_nonconv(n).
up031_seg_nonconv_dict(n) :- kind(n, "string"), parsed(n, "percentFormat", r1),
    count : { child(r1, c2, _), kind(c2, "error") } = 0, child(r1, c3, _),
    kind(c3, "placeholder"), count : { child(c3, c4, _), kind(c4, "mapping_key") } = 0.

// seg_bad(n): the JSON util `seg-bad`, used where the JSON says `matches: "seg-bad"`
.decl up031_seg_bad(n: node)
up031_seg_bad(n) :- up031_seg_err(n).
up031_seg_bad(n) :- up031_seg_nonconv(n).

// seg_bad_dict(n): the JSON util `seg-bad-dict`, used where the JSON says `matches: "seg-bad-dict"`
.decl up031_seg_bad_dict(n: node)
up031_seg_bad_dict(n) :- up031_seg_err(n).
up031_seg_bad_dict(n) :- up031_seg_nonconv_dict(n).

// identifier_literal(n): the JSON util `identifier-literal`, used where the JSON says `matches: "identifier-literal"`
.decl up031_identifier_literal(n: node)
up031_identifier_literal(n) :-
    ( kind(n, "string"), match("[rRuU]{0,2}['\"].*", n)
    ; kind(n, "concatenated_string"), count : { child(n, c1, _), kind(c1, "string"), !match("[rRuU]{0,2}['\"].*", c1) } = 0
    ),
    value(n, v2), match("[\\p{XID_Start}_]\\p{XID_Continue}*", v2),
    count : { value(n, v3), glob("{False,None,True,and,as,assert,async,await,break,class,continue,def,del,elif,else,except,finally,for,from,global,if,import,in,is,lambda,nonlocal,not,or,pass,raise,return,try,while,with,yield}", v3) } = 0.
up031_identifier_literal(n) :- kind(n, "parenthesized_expression"), child(n, c4, _),
    up031_identifier_literal(c4).

// clean_dict(n): the JSON util `clean-dict`, used where the JSON says `matches: "clean-dict"`
.decl up031_clean_dict(n: node)
up031_clean_dict(n) :- up031_dict_keys_ok(n),
    ( line(n, l1), end_line(n, l2), k1 = l2 - l1, k1 = 0
    ; child(n, c1, _), kind(c1, "pair"), field(c1, "key", c2), up031_code_before_line(c2, l3), line(c2, l4), k2 = l4 - l3, k2 >= 1
    ).


// r_dict(n): the JSON util `r-dict`, used where the JSON says `matches: "r-dict"`
.decl up031_r_dict(n: node)
up031_r_dict(n) :- kind(n, "dictionary").
up031_r_dict(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), up031_r_dict(c1).

// r_clean_dict(n): the JSON util `r-clean-dict`, used where the JSON says `matches: "r-clean-dict"`
.decl up031_r_clean_dict(n: node)
up031_r_clean_dict(n) :- up031_clean_dict(n).
up031_r_clean_dict(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    up031_r_clean_dict(c1).

// r_simple(n): the JSON util `r-simple`, used where the JSON says `matches: "r-simple"`
.decl up031_r_simple(n: node)
up031_r_simple(n) :-
    ( kind(n, k1), up031_set_4(k1)
    ; kind(n, "string"), !match("[A-Za-z]*[tT][A-Za-z]*['\"].*", n)
    ; kind(n, "concatenated_string"), count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[tT][A-Za-z]*['\"].*", c1) } = 0
    ).

up031_r_simple(n) :- kind(n, "parenthesized_expression"), child(n, c3, _), up031_r_simple(c3).

// first_nonconv(n): the JSON util `first-nonconv`, used where the JSON says `matches: "first-nonconv"`
//   AT: metavariable this relation binds for the calling rule
.decl up031_first_nonconv(n: node, at: loc)
up031_first_nonconv(n, AT) :- up031_plain_string(n),
    ( kind(n, "string"), up031_seg_nonconv(n)
    ; kind(n, "concatenated_string"), child(n, c1, _), kind(c1, "string"), up031_seg_nonconv(c1), count : { precedes(s1, c1), kind(s1, "string"), up031_seg_err(s1) } = 0
    ),
    node(_, n, _, _, _), AT = n.
up031_first_nonconv(n, AT) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    up031_first_nonconv(c3, AT).

// first_nonconv_dict(n): the JSON util `first-nonconv-dict`, used where the JSON says `matches: "first-nonconv-dict"`
//   AT: metavariable this relation binds for the calling rule
.decl up031_first_nonconv_dict(n: node, at: loc)
up031_first_nonconv_dict(n, AT) :- up031_plain_string(n),
    ( kind(n, "string"), up031_seg_nonconv_dict(n)
    ; kind(n, "concatenated_string"), child(n, c1, _), kind(c1, "string"), up031_seg_nonconv_dict(c1), count : { precedes(s1, c1), kind(s1, "string"), up031_seg_err(s1) } = 0
    ),
    node(_, n, _, _, _), AT = n.
up031_first_nonconv_dict(n, AT) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    up031_first_nonconv_dict(c3, AT).

// good(n): the JSON util `good`, used where the JSON says `matches: "good"`
//   AT: metavariable this relation binds for the calling rule
.decl up031_good(n: node, at: loc)
up031_good(n, AT) :- up031_plain_string(n),
    ( kind(n, "string"), !up031_seg_bad(n)
    ; kind(n, "concatenated_string"), count : { child(n, c1, _), kind(c1, "string"), up031_seg_bad(c1) } = 0
    ),
    node(_, n, _, _, _), AT = n.
up031_good(n, AT) :- kind(n, "parenthesized_expression"), child(n, c2, _), up031_good(c2, AT).

// good_dict(n): the JSON util `good-dict`, used where the JSON says `matches: "good-dict"`
//   AT: metavariable this relation binds for the calling rule
.decl up031_good_dict(n: node, at: loc)
up031_good_dict(n, AT) :- up031_plain_string(n),
    ( kind(n, "string"), !up031_seg_bad_dict(n)
    ; kind(n, "concatenated_string"), count : { child(n, c1, _), kind(c1, "string"), up031_seg_bad_dict(c1) } = 0
    ),
    node(_, n, _, _, _), AT = n.
up031_good_dict(n, AT) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    up031_good_dict(c2, AT).

// dict_keys_ok(n): the JSON util `dict-keys-ok`, used where the JSON says `matches: "dict-keys-ok"`
.decl up031_dict_keys_ok(n: node)
up031_dict_keys_ok(n) :- kind(n, "dictionary"), child(n, c1, _),
    (kind(c1, "pair") ; kind(c1, "dictionary_splat")),
    count : { child(n, c2, _), kind(c2, "pair"), count : { child(c2, c3, _), up031_identifier_literal(c3), up031_tok_precedes_1(c3) } = 0 } = 0,
    count : { child(n, c11, _), kind(c11, "pair"), child(c11, c12, _), node(_, c12, _, _, _), K1 = c12, up031_tok_precedes_2(c12), precedes(c11, s20), kind(s20, "pair"), child(s20, c21, _), node(_, c21, _, _, _), K2 = c21, up031_tok_precedes_3(c21), value(K1, t29), value(K2, t29) } = 0.

// a_clean_dict(n): the JSON util `a-clean-dict`, used where the JSON says `matches: "a-clean-dict"`
.decl up031_a_clean_dict(n: node)
up031_a_clean_dict(n) :- up031_dict_keys_ok(n).
up031_a_clean_dict(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
