// UP031(n): a finding at node n, from clause `printf-string-formatting`.
// Each rule below is one way the JSON `rule` can match.
.violation UP031(at: node) "Replace this percent-format with an f-string or `.format()`; if the right side is a name that may hold a tuple, leave it or unpack it explicitly."
    suppress noqa "UP031"
UP031(n) :- n ~ `$S % $R`,
    ( field(n, "right", c1), up031_r_simple(c1), field(n, "left", c2), up031_good(c2, AT)
    ; field(n, "right", c3), up031_r_clean_dict(c3), field(n, "left", c4), up031_good_dict(c4, AT)
    ).


// UP031_printf_string_formatting_manual(n): findings from clauses `printf-string-formatting-manual`, `printf-string-formatting-annotation-manual`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation UP031_printf_string_formatting_manual(at: node, at: loc) code "UP031" "Rewrite this percent-format string as an f-string or `.format()` by hand: `%d`, `%i`, `%u`, `%c`, `*` widths and unusual dict keys need explicit conversion."
    suppress noqa "UP031"
UP031_printf_string_formatting_manual(n, AT) :- n ~ `$S % $R`,
    ( count : { field(n, "right", c1), up031_r_dict(c1) } = 0, field(n, "left", c2), up031_first_nonconv(c2, AT)
    ; field(n, "right", c3), up031_r_dict(c3), field(n, "left", c4), up031_first_nonconv_dict(c4, AT)
    ; field(n, "right", c5), up031_r_dict(c5), count : { field(n, "right", c6), up031_r_clean_dict(c6) } = 0, field(n, "left", c7), up031_good_dict(c7, AT)
    ).

UP031_printf_string_formatting_manual(n, AT) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), has(r1, c2, "binary_operator"), c2 ~ `$S % $R`,
    BIN = c2, up031_alt_14(c2, AT).

// UP031_printf_string_formatting_annotation(n): a finding at node n, from clause `printf-string-formatting-annotation`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation UP031_printf_string_formatting_annotation(at: node, bin: node) code "UP031" "Replace this percent-format with an f-string or `.format()`; if the right side is a name that may hold a tuple, leave it or unpack it explicitly."
    suppress noqa "UP031"
UP031_printf_string_formatting_annotation(BIN, n) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), has(r1, c2, "binary_operator"), c2 ~ `$S % $R`,
    BIN = c2,
    ( child(c2, c1, _), up031_good(c1, AT), up031_tok_precedes_8(c1), child(c2, c3, _), up031_r_simple(c3), up031_tok_follows_9(c3)
    ; child(c2, c4, _), up031_good_dict(c4, AT), up031_tok_precedes_10(c4), child(c2, c5, _), up031_a_clean_dict(c5), up031_tok_follows_11(c5)
    ).


// code_comment_end(p, o): a comment child of p ends at offset o
.decl up031_code_comment_end(p: node, o: number)
up031_code_comment_end(p, o) :- child(p, c, _), comment(c, _), node(_, c, _, _, o).

// code_before_line(x, l): the line of the code before x (main's token_before, comments passed over), read from the source gap: the tape leaves out the tokens its grammar implies
.decl up031_code_before_line(x: node, l: number)
up031_code_before_line(x, l) :- structural_before(x, g), match("(?s).*\\S\\s*", g),
    ws = @replace_all(g, "(?s)^.*\\S", ""),
    k = strlen(ws) - strlen(@replace_all(ws, "\n", "")), line(x, lx), l = lx - k.
up031_code_before_line(x, l) :- structural_before(x, g), match("\\s*", g), child(p, x, _),
    node(_, x, _, s, _), o = s - strlen(g), token(p, _, _, _, o),
    !up031_code_comment_end(p, o), k = strlen(g) - strlen(@replace_all(g, "\n", "")),
    line(x, lx), l = lx - k.
up031_code_before_line(x, l) :- structural_before(x, g), match("\\s*", g), child(p, x, _),
    node(_, x, _, s, _), node(_, p, _, ps, _), ps = s - strlen(g),
    up031_code_before_line(p, l).
up031_code_before_line(x, l) :- structural_before(x, g), match("\\s*", g), child(p, x, _),
    node(_, x, _, s, _), o = s - strlen(g), child(p, c, _), node(_, c, _, _, o),
    comment(c, _), up031_code_before_line(c, l).

