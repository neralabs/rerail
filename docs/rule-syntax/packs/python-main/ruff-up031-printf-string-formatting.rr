// set_4: node kinds from a JSON `any`
.decl up031_set_4(v: symbol)
up031_set_4("integer"). up031_set_4("float"). up031_set_4("true"). up031_set_4("false"). up031_set_4("none").
up031_set_4("ellipsis"). up031_set_4("identifier"). up031_set_4("attribute"). up031_set_4("subscript").
up031_set_4("call"). up031_set_4("tuple").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl up031_alt_1(n: node)
up031_alt_1(n) :- child(n, c1, _), (kind(c1, "width") ; kind(c1, "precision")),
    child(c1, c2, _), kind(c2, "star").
up031_alt_1(n) :- child(n, c3, _), kind(c3, "conversion"), value(c3, v4), glob("[diuc]", v4).
up031_alt_1(n) :- child(n, c5, _), kind(c5, "mapping_key"), value(c5, "").
up031_alt_1(n) :- child(n, c6, _), kind(c6, "conversion"), value(c6, v7), glob("[ar%]", v7),
    child(n, c8, _), (kind(c8, "flags") ; kind(c8, "width") ; kind(c8, "precision")).
up031_alt_1(n) :- child(n, c9, _), kind(c9, "width"), child(n, c10, _),
    kind(c10, "conversion"), value(c10, "s").

// alt_14(n): the JSON `any`: n matches if any one of these rules does
//   AT: metavariable this relation binds for the calling rule
.decl up031_alt_14(n: node, at: loc)
up031_alt_14(n, AT) :- child(n, c1, _), up031_first_nonconv(c1, AT), up031_tok_precedes_8(c1),
    count : { child(n, c9, _), up031_r_dict(c9), up031_tok_follows_9(c9) } = 0.
up031_alt_14(n, AT) :- child(n, c17, _), up031_first_nonconv_dict(c17, AT), up031_tok_precedes_10(c17),
    child(n, c25, _), up031_r_dict(c25), up031_tok_follows_11(c25).
up031_alt_14(n, AT) :- child(n, c33, _), up031_good_dict(c33, AT), up031_tok_precedes_15(c33),
    child(n, c41, _), up031_r_dict(c41), up031_tok_follows_16(c41),
    count : { child(n, c49, _), up031_a_clean_dict(c49), up031_tok_follows_17(c49) } = 0.
