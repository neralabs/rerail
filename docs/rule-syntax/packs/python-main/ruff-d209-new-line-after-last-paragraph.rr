.policy "ruff-d209-new-line-after-last-paragraph" revision 1
.guests off
.description "Put the closing quotes of a multi-line docstring on their own line."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// D209(n): a finding at node n, from clause `new-line-after-last-paragraph`.
// Each rule below is one way the JSON `rule` can match.
.violation D209(at: node) "Move this docstring's closing quotes onto a new line after its last line of text."
    suppress noqa "D209"
D209(n) :- d209_docstring(n), match("[uUrR]*(?:\"{3}|'{3}).*", n),
    match("(?s:.*)(?:\\r\\n|\\r|\\n)[^\\r\\n]*\\S[^\\r\\n]*(?:\"{3}|'{3})", n),
    child(n, c1, _), kind(c1, "string_content"),
    match("(?s:.*)\\S[^\\r\\n]*[\\r\\n]\\s*\\S(?s:.*)", c1).

// doc_stmt(n): the JSON util `doc-stmt`, used where the JSON says `matches: "doc-stmt"`
.decl d209_doc_stmt(n: node)
d209_doc_stmt(n) :- kind(n, "expression_statement"), !d209_alt_1(n),
    ( child(p1, n, _), kind(p1, "module")
    ; child(p2, n, _), kind(p2, "block"), child(p3, p2, _), (kind(p3, "function_definition") ; kind(p3, "class_definition"))
    ).


// doc_holder(n): the JSON util `doc-holder`, used where the JSON says `matches: "doc-holder"`
.decl d209_doc_holder(n: node)
d209_doc_holder(n) :- d209_doc_stmt(n).
d209_doc_holder(n) :- kind(n, "parenthesized_expression"), child(p1, n, _), d209_doc_holder(p1).

// docstring(n): the JSON util `docstring`, used where the JSON says `matches: "docstring"`
.decl d209_docstring(n: node)
d209_docstring(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0,
    child(p2, n, _), d209_doc_holder(p2).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d209_tok_has_1(n: node)
.stored d209_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d209_tok_has_1(n) :- child(n, c1, _), glob("\\,", c1).
d209_tok_has_1(n) :- op(n, t2), match(",", t2).
d209_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d209_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d209_tok_has_1(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl d209_alt_1(n: node)
d209_alt_1(n) :- d209_tok_has_1(n).
d209_alt_1(n) :- precedes(s9, n), !kind(s9, "comment").
