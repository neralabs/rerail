// code_comment_end(p, o): a comment child of p ends at offset o
.decl era001_code_comment_end(p: node, o: number)
era001_code_comment_end(p, o) :- child(p, c, _), comment(c, _), node(_, c, _, _, o).

// code_before_line_c(x, l): the line of the code before x (main's token_before, comments counted as code), read from the source gap: the tape leaves out the tokens its grammar implies
.decl era001_code_before_line_c(x: node, l: number)
era001_code_before_line_c(x, l) :- structural_before(x, g), match("(?s).*\\S\\s*", g),
    ws = @replace_all(g, "(?s)^.*\\S", ""),
    k = strlen(ws) - strlen(@replace_all(ws, "\n", "")), line(x, lx), l = lx - k.
era001_code_before_line_c(x, l) :- structural_before(x, g), match("\\s*", g), child(p, x, _),
    node(_, x, _, s, _), o = s - strlen(g), token(p, _, _, _, o),
    k = strlen(g) - strlen(@replace_all(g, "\n", "")), line(x, lx), l = lx - k.
era001_code_before_line_c(x, l) :- structural_before(x, g), match("\\s*", g), child(p, x, _),
    node(_, x, _, s, _), node(_, p, _, ps, _), ps = s - strlen(g),
    era001_code_before_line_c(p, l).

// stop_3(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl era001_stop_3(n: node)
era001_stop_3(n) :- node(_, n, _, _, _),
    count : { kind(n, "comment"), glob("#{ **,}", n), next_sibling(n, t2), end_line(n, l3), line(t2, l4), k1 = l4 - l3, k1 <= 1 } = 0.

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl era001_alt_4(n: node)
era001_alt_4(n) :- node(_, n, _, _, _), glob("# /// script", n).
era001_alt_4(n) :- precedes_stop(s1, n, era001_stop_3), kind(s1, "comment"),
    glob("# /// script", s1), next_sibling(s1, t3), end_line(s1, l4), line(t3, l5),
    k2 = l5 - l4, k2 <= 1.

// stop_6(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl era001_stop_6(n: node)
era001_stop_6(n) :- node(_, n, _, _, _),
    count : { kind(n, "comment"), glob("#{ **,}", n), next_sibling(t2, n), line(n, l4), end_line(t2, l3), k1 = l4 - l3, k1 <= 1 } = 0.

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl era001_alt_7(n: node)
era001_alt_7(n) :- node(_, n, _, _, _), glob("# ///", n).
era001_alt_7(n) :- precedes_stop(n, s1, era001_stop_6), kind(s1, "comment"), glob("# ///", s1),
    next_sibling(t3, s1), line(s1, l5), end_line(t3, l4), k2 = l5 - l4, k2 <= 1.
