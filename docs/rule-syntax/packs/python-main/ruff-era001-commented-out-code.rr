    ; FIN = Z
    ),

    count : { glob("#{ **,}", n), inside(n, p15, "module"), match("(?m)(?s:.*)^# /// script\\r?$(?s:.*)", p15), era001_alt_4(n), era001_alt_7(n) } = 0,
