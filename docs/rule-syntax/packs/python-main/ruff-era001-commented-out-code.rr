.policy "ruff-era001-commented-out-code" revision 1
.guests off
.description "Remove commented-out code; version control keeps the history, and dead code left in comments goes stale."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// ERA001(n): a finding at node n, from clause `commented-out-code`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `transform` computes A, A0, B, FIN, H, K1, K1A, K1AS, K1B, K1C, K1D, K1E, K2, K3, K3B, K4, K4A, K4B, K4C, K4D, K4X, K5, K5A, K5B, K5C, K6, K7, K8, L, M, M0, M1, MC, MS, MT, N, OP2, OPC, OPS, PAIRF, PW, R1, R2, R3, R4, R5, S, S3, SO, W, Z from other metavariables' text; its literals end each rule.
.violation ERA001(at: node) "Delete this commented-out code; version control keeps the history. Leave it only if the comment is prose or an example that merely looks like code."
    suppress noqa "ERA001"
// Not grounded: no positive atom binds t1_3.
ERA001(n) :- kind(n, "comment"),
    glob("**{[()\\[\\]{}:=%],return,break,continue,import}**", n),
    !match("#[# \\t\\x0C]*(?:TODO|FIXME|XXX)(?:[ :(]|\\s*$).*", n),
    !match("#[# \\t\\x0C]*(?:pyright|pyrefly|ruff\\s*:\\s*(?:disable|enable|ignore|file-ignore)|mypy:|type:\\s*ignore|ty:\\s*ignore|SPDX-License-Identifier:|fmt:\\s*(?:on|off|skip)|region|endregion|(?i:noqa|pylint|nosec|isort:\\s*(?:on|off|skip|skip_file|split|dont-add-imports(?::\\s*\\[.*?\\])?)|(?:en)?coding[:=][ \\t]*[-_.A-Z0-9]+)|language=[-_.a-zA-Z0-9]+).*", n),
    !match("#[# \\t\\x0C]*[^# \\t\\x0C].*#\\d.*", n),
    ( ( era001_code_before_line_c(n, l1), line(n, l2), k1 = l2 - l1, k1 >= 1 ; count : { era001_code_before_line_c(n, l1) } = 0, line(n, l2), k1 = l2 - 1, k1 >= 1 )
    ; count : { era001_code_before_line_c(n, l3), line(n, l4), k2 = l4 - l3, k2 >= 0 } = 0
    ),
