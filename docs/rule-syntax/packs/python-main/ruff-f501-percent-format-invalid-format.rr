.policy "ruff-f501-percent-format-invalid-format" revision 1
.guests off
.description "Fix malformed %-format strings, such as incomplete specifiers or unclosed %(key) names; they raise an error at run time."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// F501(n): a finding at node n, from clause `percent-format-invalid-format`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on S are added to every rule.
.violation F501(at: node) "Fix this malformed %-format string, such as an incomplete specifier or an unclosed %(key) name."
    suppress noqa "F501"
F501(n) :- n ~ `$S % $R`, f501_format_string(S).

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl f501_plain_string(n: node)
f501_plain_string(n) :- kind(n, "string"), !match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", n).
f501_plain_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", c1) } = 0.

// format_string(n): the JSON util `format-string`, used where the JSON says `matches: "format-string"`
.decl f501_format_string(n: node)
f501_format_string(n) :- f501_plain_string(n), parsed(n, "percentFormat", r1), child(r1, c2, _),
    kind(c2, "error"),
    count : { value(c2, v3), prefix("unsupported format character", v3) } = 0.
f501_format_string(n) :- kind(n, "parenthesized_expression"), child(n, c4, _),
    f501_format_string(c4).
