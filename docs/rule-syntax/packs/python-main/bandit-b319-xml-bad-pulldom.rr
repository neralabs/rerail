.policy "bandit-b319-xml-bad-pulldom" revision 1
.guests off
.description "Use defusedxml instead of xml.dom.pulldom to parse XML; the standard parser is open to entity-expansion and other XML attacks on untrusted input."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B319(n): a finding at node n, from clause `B319`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on F are added to every rule.
.violation B319(at: node) "Using xml.dom.pulldom to parse untrusted XML is vulnerable to XML attacks; use the defusedxml equivalent."
    suppress nosec "B319"
B319(n) :- n ~ `$F($$$ARGS)`,
    (sym_of(F, "xml.dom.pulldom.parse") ; sym_of(F, "xml.dom.pulldom.parseString")).
