// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl e711_tok_follows_1(n: node)
.stored e711_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
e711_tok_follows_1(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
e711_tok_follows_1(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
e711_tok_follows_1(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl e711_tok_follows_2(n: node)
.stored e711_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
e711_tok_follows_2(n) :- next_sibling(s1, n), match("(?s).*..*", s1).
e711_tok_follows_2(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("(?s).*..*", t2).
e711_tok_follows_2(n) :- structural_before(n, g3), match("(?s)^.*\\S\\s*$", g3).

// alt_2_u0_empty: level -1 of an unrolled recursion, empty
.decl e711_alt_2_u0_empty(n: node)

// constant_u0_empty: level -1 of an unrolled recursion, empty
.decl e711_constant_u0_empty(n: node)

// alt_5_u0_empty: level -1 of an unrolled recursion, empty
.decl e711_alt_5_u0_empty(n: node)

// constant_none_comparison_not_equal_u0_empty: level -1 of an unrolled recursion, empty
.decl e711_constant_none_comparison_not_equal_u0_empty(n: node)

// set_1: node kinds from a JSON `any`
.decl e711_set_1(v: symbol)
e711_set_1("integer"). e711_set_1("float"). e711_set_1("none"). e711_set_1("true"). e711_set_1("false").
e711_set_1("ellipsis").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl e711_alt_2(n: node)
e711_alt_2(n) :- e711_alt_2_u7(n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl e711_alt_5(n: node)
e711_alt_5(n) :- e711_alt_5_u7(n).
