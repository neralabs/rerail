// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl e711_tok_follows_1(n: node)
.stored e711_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
e711_tok_follows_1(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
e711_tok_follows_1(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
e711_tok_follows_1(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_precedes_2(n, m): m is the named node after n, with one token between them that matches "^==$": a token the tape stores, or one it leaves out, read from the source between the two
.decl e711_tok_precedes_2(n: node, m: node)
.stored e711_tok_precedes_2 "its token read is of a token the tape stores between two named siblings; one the tape leaves out is the source gap, in its own rule"
e711_tok_precedes_2(n, m) :- next_sibling(n, m), structural_after(n, g11),
    match("(?s)^\\s*(?:==)\\s*$", g11).
e711_tok_precedes_2(n, m) :- next_sibling(n, m), structural_after(n, g11),
    match("\\s*", g11), child(p14, n, _), structural_before(m, g12),
    match("\\s*", g12), node(_, n, _, _, en18), o15 = en18 + strlen(g11),
    token(p14, _, t13, o15, e16), node(_, m, _, st17, _), st17 = e16 + strlen(g12),
    match("==", t13).

// tok_follows_3(n, m): m is the named node before n, with one token between them that matches "^==$": a token the tape stores, or one it leaves out, read from the source between the two
.decl e711_tok_follows_3(n: node, m: node)
.stored e711_tok_follows_3 "its token read is of a token the tape stores between two named siblings; one the tape leaves out is the source gap, in its own rule"
e711_tok_follows_3(n, m) :- next_sibling(m, n), structural_before(n, g21),
    match("(?s)^\\s*(?:==)\\s*$", g21).
e711_tok_follows_3(n, m) :- next_sibling(m, n), structural_before(n, g21),
    match("\\s*", g21), child(p24, n, _), structural_after(m, g22), match("\\s*", g22),
    node(_, n, _, st27, _), o25 = st27 - strlen(g21), token(p24, _, t23, e26, o25),
    node(_, m, _, _, en28), en28 = e26 - strlen(g22), match("==", t23).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl e711_tok_follows_4(n: node)
.stored e711_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
e711_tok_follows_4(n) :- next_sibling(s1, n), match("(?s).*..*", s1).
e711_tok_follows_4(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("(?s).*..*", t2).
e711_tok_follows_4(n) :- structural_before(n, g3), match("(?s)^.*\\S\\s*$", g3).

// tok_precedes_5(n, m): m is the named node after n, with one token between them that matches "^==$": a token the tape stores, or one it leaves out, read from the source between the two
.decl e711_tok_precedes_5(n: node, m: node)
.stored e711_tok_precedes_5 "its token read is of a token the tape stores between two named siblings; one the tape leaves out is the source gap, in its own rule"
e711_tok_precedes_5(n, m) :- next_sibling(n, m), structural_after(n, g10),
    match("(?s)^\\s*(?:==)\\s*$", g10).
e711_tok_precedes_5(n, m) :- next_sibling(n, m), structural_after(n, g10),
    match("\\s*", g10), child(p13, n, _), structural_before(m, g11),
    match("\\s*", g11), node(_, n, _, _, en17), o14 = en17 + strlen(g10),
    token(p13, _, t12, o14, e15), node(_, m, _, st16, _), st16 = e15 + strlen(g11),
    match("==", t12).

// tok_follows_6(n, m): m is the named node before n, with one token between them that matches "^==$": a token the tape stores, or one it leaves out, read from the source between the two
.decl e711_tok_follows_6(n: node, m: node)
.stored e711_tok_follows_6 "its token read is of a token the tape stores between two named siblings; one the tape leaves out is the source gap, in its own rule"
e711_tok_follows_6(n, m) :- next_sibling(m, n), structural_before(n, g20),
    match("(?s)^\\s*(?:==)\\s*$", g20).
e711_tok_follows_6(n, m) :- next_sibling(m, n), structural_before(n, g20),
    match("\\s*", g20), child(p23, n, _), structural_after(m, g21), match("\\s*", g21),
    node(_, n, _, st26, _), o24 = st26 - strlen(g20), token(p23, _, t22, e25, o24),
    node(_, m, _, _, en27), en27 = e25 - strlen(g21), match("==", t22).

// tok_precedes_7(n, m): m is the named node after n, with one token between them that matches "^!=$": a token the tape stores, or one it leaves out, read from the source between the two
.decl e711_tok_precedes_7(n: node, m: node)
.stored e711_tok_precedes_7 "its token read is of a token the tape stores between two named siblings; one the tape leaves out is the source gap, in its own rule"
e711_tok_precedes_7(n, m) :- next_sibling(n, m), structural_after(n, g11),
    match("(?s)^\\s*(?:!=)\\s*$", g11).
e711_tok_precedes_7(n, m) :- next_sibling(n, m), structural_after(n, g11),
    match("\\s*", g11), child(p14, n, _), structural_before(m, g12),
    match("\\s*", g12), node(_, n, _, _, en18), o15 = en18 + strlen(g11),
    token(p14, _, t13, o15, e16), node(_, m, _, st17, _), st17 = e16 + strlen(g12),
    match("!=", t13).

// tok_follows_8(n, m): m is the named node before n, with one token between them that matches "^!=$": a token the tape stores, or one it leaves out, read from the source between the two
.decl e711_tok_follows_8(n: node, m: node)
.stored e711_tok_follows_8 "its token read is of a token the tape stores between two named siblings; one the tape leaves out is the source gap, in its own rule"
e711_tok_follows_8(n, m) :- next_sibling(m, n), structural_before(n, g21),
    match("(?s)^\\s*(?:!=)\\s*$", g21).
e711_tok_follows_8(n, m) :- next_sibling(m, n), structural_before(n, g21),
    match("\\s*", g21), child(p24, n, _), structural_after(m, g22), match("\\s*", g22),
    node(_, n, _, st27, _), o25 = st27 - strlen(g21), token(p24, _, t23, e26, o25),
    node(_, m, _, _, en28), en28 = e26 - strlen(g22), match("!=", t23).

// tok_precedes_9(n, m): m is the named node after n, with one token between them that matches "^!=$": a token the tape stores, or one it leaves out, read from the source between the two
.decl e711_tok_precedes_9(n: node, m: node)
.stored e711_tok_precedes_9 "its token read is of a token the tape stores between two named siblings; one the tape leaves out is the source gap, in its own rule"
e711_tok_precedes_9(n, m) :- next_sibling(n, m), structural_after(n, g10),
    match("(?s)^\\s*(?:!=)\\s*$", g10).
e711_tok_precedes_9(n, m) :- next_sibling(n, m), structural_after(n, g10),
    match("\\s*", g10), child(p13, n, _), structural_before(m, g11),
    match("\\s*", g11), node(_, n, _, _, en17), o14 = en17 + strlen(g10),
    token(p13, _, t12, o14, e15), node(_, m, _, st16, _), st16 = e15 + strlen(g11),
    match("!=", t12).

// tok_follows_10(n, m): m is the named node before n, with one token between them that matches "^!=$": a token the tape stores, or one it leaves out, read from the source between the two
.decl e711_tok_follows_10(n: node, m: node)
.stored e711_tok_follows_10 "its token read is of a token the tape stores between two named siblings; one the tape leaves out is the source gap, in its own rule"
e711_tok_follows_10(n, m) :- next_sibling(m, n), structural_before(n, g20),
    match("(?s)^\\s*(?:!=)\\s*$", g20).
e711_tok_follows_10(n, m) :- next_sibling(m, n), structural_before(n, g20),
    match("\\s*", g20), child(p23, n, _), structural_after(m, g21), match("\\s*", g21),
    node(_, n, _, st26, _), o24 = st26 - strlen(g20), token(p23, _, t22, e25, o24),
    node(_, m, _, _, en27), en27 = e25 - strlen(g21), match("!=", t22).

// alt_2_u0_empty: level -1 of an unrolled recursion, empty
.decl e711_alt_2_u0_empty(n: node)

// constant_u0_empty: level -1 of an unrolled recursion, empty
.decl e711_constant_u0_empty(n: node)

// alt_5_u0_empty: level -1 of an unrolled recursion, empty
.decl e711_alt_5_u0_empty(n: node)

// constant_none_comparison_not_equal_u0_empty: level -1 of an unrolled recursion, empty
.decl e711_constant_none_comparison_not_equal_u0_empty(n: node)

// set_1: node kinds from a JSON `any`
.decl e711_set_1(v: symbol)
e711_set_1("integer"). e711_set_1("float"). e711_set_1("none"). e711_set_1("true"). e711_set_1("false").
e711_set_1("ellipsis").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl e711_alt_2(n: node)
e711_alt_2(n) :- e711_alt_2_u7(n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl e711_alt_5(n: node)
e711_alt_5(n) :- e711_alt_5_u7(n).
