.policy "ruff-e711-none-comparison" revision 2
.guests off
.description "Use is None or is not None instead of == or != to compare with None; equality can be overridden and gives surprising results."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// E711(n, detail): findings from clauses `none-comparison-equal`, `none-comparison-not-equal`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
.violation E711(at: node, detail: symbol) "Use `is {detail} None` for this comparison."
    suppress noqa "E711"
E711(n, "None` instead of `==") :- kind(n, "none"), e711_operand(n).
E711(n, "not None` instead of `!=") :- kind(n, "none"),
    e711_operand_none_comparison_not_equal(n).

// constant(n): the JSON util `constant`, used where the JSON says `matches: "constant"`
.decl e711_constant(n: node)
e711_constant(n) :- e711_constant_u7(n).

// constant_non_singleton(n): the JSON util `constant-non-singleton`, used where the JSON says `matches: "constant-non-singleton"`
.decl e711_constant_non_singleton(n: node)
e711_constant_non_singleton(n) :- e711_constant(n), !e711_singleton(n).

// compared_operand(n): the JSON util `compared-operand`, used where the JSON says `matches: "compared-operand"`
.decl e711_compared_operand(n: node)
e711_compared_operand(n) :- child(p1, n, _), kind(p1, "comparison_operator"),
    ( !e711_tok_follows_2(n), next_sibling(n, s1), glob("==", s1), next_sibling(s1, s2), !e711_constant_non_singleton(s2)
    ; next_sibling(s3, n), glob("==", s3), next_sibling(s4, s3), !e711_constant_non_singleton(s4)
    ).


// operand(n): the JSON util `operand`, used where the JSON says `matches: "operand"`
.decl e711_operand(n: node)
e711_operand(n) :- e711_compared_operand(n).
e711_operand(n) :- child(p1, n, _), kind(p1, "parenthesized_expression"), e711_operand(p1).

// singleton(n): the JSON util `singleton`, used where the JSON says `matches: "singleton"`
.decl e711_singleton(n: node)
e711_singleton(n) :- (kind(n, "none") ; kind(n, "true") ; kind(n, "false") ; kind(n, "ellipsis")).
e711_singleton(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), e711_singleton(c1).

// constant_none_comparison_not_equal(n): the JSON util `constant`, used where the JSON says `matches: "constant"`
.decl e711_constant_none_comparison_not_equal(n: node)
e711_constant_none_comparison_not_equal(n) :- e711_constant_none_comparison_not_equal_u7(n).

// constant_non_singleton_none_comparison_not_equal(n): the JSON util `constant-non-singleton`, used where the JSON says `matches: "constant-non-singleton"`
.decl e711_constant_non_singleton_none_comparison_not_equal(n: node)
e711_constant_non_singleton_none_comparison_not_equal(n) :- e711_constant_none_comparison_not_equal(n),
    !e711_singleton_none_comparison_not_equal(n).

// compared_operand_none_comparison_not_equal(n): the JSON util `compared-operand`, used where the JSON says `matches: "compared-operand"`
.decl e711_compared_operand_none_comparison_not_equal(n: node)
e711_compared_operand_none_comparison_not_equal(n) :- child(p1, n, _),
    kind(p1, "comparison_operator"),
    ( !e711_tok_follows_2(n), next_sibling(n, s1), glob("!=", s1), next_sibling(s1, s2), !e711_constant_non_singleton_none_comparison_not_equal(s2)
    ; next_sibling(s3, n), glob("!=", s3), next_sibling(s4, s3), !e711_constant_non_singleton_none_comparison_not_equal(s4)
    ).


// operand_none_comparison_not_equal(n): the JSON util `operand`, used where the JSON says `matches: "operand"`
.decl e711_operand_none_comparison_not_equal(n: node)
e711_operand_none_comparison_not_equal(n) :- e711_compared_operand_none_comparison_not_equal(n).
e711_operand_none_comparison_not_equal(n) :- child(p1, n, _),
    kind(p1, "parenthesized_expression"), e711_operand_none_comparison_not_equal(p1).

// singleton_none_comparison_not_equal(n): the JSON util `singleton`, used where the JSON says `matches: "singleton"`
.decl e711_singleton_none_comparison_not_equal(n: node)
e711_singleton_none_comparison_not_equal(n) :- (kind(n, "none") ; kind(n, "true") ; kind(n, "false") ; kind(n, "ellipsis")).
e711_singleton_none_comparison_not_equal(n) :- kind(n, "parenthesized_expression"),
    child(n, c1, _), e711_singleton_none_comparison_not_equal(c1).

