.policy "ruff-pt008-pytest-patch-with-lambda" revision 1
.guests off
.description "Patch with a fixed return value rather than a lambda that ignores its arguments; it states the intent and keeps call assertions available."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// PT008(n): a finding at node n, from clause `patch-with-lambda`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PT008(at: node, f: node) "Pass the lambda's result to `{f}` as `return_value=` instead of a `lambda` that ignores its arguments; keep the lambda if its body must run on every call."
    suppress noqa "PT008"
PT008(F, n) :- kind(n, "call"),
    ( field(n, "function", c1), pt008_fn_patch(c1, F), field(n, "arguments", c2), kind(c2, "argument_list"), pt008_alt_17(c2)
    ; field(n, "function", c3), pt008_fn_patch_object(c3, F), field(n, "arguments", c4), kind(c4, "argument_list"), pt008_alt_11(c4)
    ),

    count : { field(n, "arguments", c25), child(c25, c26, _), kind(c26, "keyword_argument"), field(c26, "name", c27), glob("return_value", c27) } = 0.

// obj(n): the JSON util `obj`, used where the JSON says `matches: "obj"`
.decl pt008_obj(n: node)
pt008_obj(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pt008_obj(c1).
pt008_obj(n) :- kind(n, "identifier"),
    glob("{mocker,class_mocker,module_mocker,package_mocker,session_mocker,mock}", n).
pt008_obj(n) :- kind(n, "attribute"), field(n, "object", c2), pt008_unittest(c2),
    field(n, "attribute", c3), glob("mock", c3).

// unittest(n): the JSON util `unittest`, used where the JSON says `matches: "unittest"`
.decl pt008_unittest(n: node)
pt008_unittest(n) :- kind(n, "identifier"), glob("unittest", n).
pt008_unittest(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pt008_unittest(c1).

// patch(n): the JSON util `patch`, used where the JSON says `matches: "patch"`
.decl pt008_patch(n: node)
pt008_patch(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pt008_patch(c1).
pt008_patch(n) :- kind(n, "attribute"), field(n, "object", c2), pt008_obj(c2),
    field(n, "attribute", c3), glob("patch", c3).

// fn_patch(n): the JSON util `fn-patch`, used where the JSON says `matches: "fn-patch"`
//   F: metavariable this relation binds for the calling rule
.decl pt008_fn_patch(n: node, f: loc)
pt008_fn_patch(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pt008_fn_patch(c1, F).
pt008_fn_patch(n, F) :- kind(n, "attribute"), pt008_patch(n), node(_, n, _, _, _), F = n.

// fn_patch_object(n): the JSON util `fn-patch-object`, used where the JSON says `matches: "fn-patch-object"`
//   F: metavariable this relation binds for the calling rule
.decl pt008_fn_patch_object(n: node, f: loc)
pt008_fn_patch_object(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pt008_fn_patch_object(c1, F).
pt008_fn_patch_object(n, F) :- kind(n, "attribute"), field(n, "object", c2), pt008_patch(c2),
    field(n, "attribute", c3), glob("object", c3), node(_, n, _, _, _), F = n.

// param_name(n): the JSON util `param-name`, used where the JSON says `matches: "param-name"`
//   P: metavariable this relation binds for the calling rule
.decl pt008_param_name(n: node, p: loc)
pt008_param_name(n, P) :- kind(n, "identifier"), node(_, n, _, _, _), P = n.
pt008_param_name(n, P) :- kind(n, "default_parameter"), field(n, "name", c1), node(_, c1, _, _, _), P = c1.
pt008_param_name(n, P) :- (kind(n, "list_splat_pattern") ; kind(n, "dictionary_splat_pattern")),
    child(n, c2, _), kind(c2, "identifier"), node(_, c2, _, _, _), P = c2.

// name_expr(n): the JSON util `name-expr`, used where the JSON says `matches: "name-expr"`
.decl pt008_name_expr(n: node)
pt008_name_expr(n) :- kind(n, "identifier"), !pt008_alt_1(n).

// reads_p(n): the JSON util `reads-p`, used where the JSON says `matches: "reads-p"`
//   P: metavariable of the calling rule, passed in (bound by the caller)
.decl pt008_reads_p(n: node, p: loc)
pt008_reads_p(n, P) :- pt008_demand_reads_p(n, P), kind(n, "identifier"), pt008_name_expr(n), node(_, n, _, _, _), U = n,
    text(U, t1), text(P, t1), @doc(U) = @doc(P).

// uses_args(n): the JSON util `uses-args`, used where the JSON says `matches: "uses-args"`
.decl pt008_uses_args(n: node)
pt008_uses_args(n) :- field(n, "parameters", c1), child(c1, c2, _), pt008_param_name(c2, P),
    child(p3, c2, _), kind(p3, "lambda_parameters"), precedes(p3, s4),
    (pt008_reads_p(s4, P) ; within(c3, s4), pt008_reads_p(c3, P)).

// new_lambda(n): the JSON util `new-lambda`, used where the JSON says `matches: "new-lambda"`
.decl pt008_new_lambda(n: node)
pt008_new_lambda(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pt008_new_lambda(c1).
pt008_new_lambda(n) :- kind(n, "lambda"), !pt008_uses_args(n).

// positional(n): the JSON util `positional`, used where the JSON says `matches: "positional"`
.decl pt008_positional(n: node)
pt008_positional(n) :- node(_, n, _, _, _), !pt008_alt_3(n).

// demand_reads_p: the rows of reads_p its callers ask for (the metavariable columns they pass in)
.decl pt008_demand_reads_p(n: node, p: loc)
pt008_demand_reads_p(s4, P) :- field(n, "parameters", c1), child(c1, c2, _),
    pt008_param_name(c2, P), child(p3, c2, _), kind(p3, "lambda_parameters"),
    precedes(p3, s4).
pt008_demand_reads_p(c3, P) :- field(n, "parameters", c1), child(c1, c2, _),
    pt008_param_name(c2, P), child(p3, c2, _), kind(p3, "lambda_parameters"),
    precedes(p3, s4), within(c3, s4).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pt008_alt_1(n: node)
pt008_alt_1(n) :- field(p1, "attribute", n), kind(p1, "attribute").
pt008_alt_1(n) :- field(p2, "name", n), kind(p2, "keyword_argument").
pt008_alt_1(n) :- child(p3, n, _), kind(p3, "lambda_parameters").
pt008_alt_1(n) :- field(p4, "name", n), kind(p4, "default_parameter"), child(p5, p4, _),
    kind(p5, "lambda_parameters").
pt008_alt_1(n) :- child(p6, n, _),
    (kind(p6, "list_splat_pattern") ; kind(p6, "dictionary_splat_pattern")),
    child(p7, p6, _), kind(p7, "lambda_parameters").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pt008_alt_3(n: node)
pt008_alt_3(n) :-
    ( kind(n, "keyword_argument")
    ; kind(n, "dictionary_splat")
    ; kind(n, "comment")
    ; kind(n, "line_continuation")
    ).

pt008_alt_3(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl pt008_alt_10(n: node)
pt008_alt_10(n) :- kind(n, "list_splat").
pt008_alt_10(n) :- precedes(s1, n), kind(s1, "list_splat").

// counted(n): 8 identical copies of one rule set (`counted_12`, `counted_15`, `counted_18` and 5 more), folded into one.
.decl pt008_counted(n: node)
pt008_counted(n) :- pt008_positional(n).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl pt008_alt_11(n: node)
pt008_alt_11(n) :- child(n, c1, _), kind(c1, "keyword_argument"), field(c1, "name", c2),
    glob("new", c2), field(c1, "value", c3), pt008_new_lambda(c3).
pt008_alt_11(n) :- count : { child(n, c4, _), kind(c4, "keyword_argument"), field(c4, "name", c5), glob("new", c5) } = 0,
    child(n, c6, _), pt008_positional(c6), child(p7, c6, _), pt008_counted(c6),
    k9 = count : { child(p7, s8, _), precedes(s8, c6), pt008_counted(s8) }, k9 = 2,
    !pt008_alt_10(c6), pt008_new_lambda(c6).

// alt_17(n): the JSON `any`: n matches if any one of these rules does
.decl pt008_alt_17(n: node)
pt008_alt_17(n) :- child(n, c1, _), kind(c1, "keyword_argument"), field(c1, "name", c2),
    glob("new", c2), field(c1, "value", c3), pt008_new_lambda(c3).
pt008_alt_17(n) :- count : { child(n, c4, _), kind(c4, "keyword_argument"), field(c4, "name", c5), glob("new", c5) } = 0,
    child(n, c6, _), pt008_positional(c6), child(p7, c6, _), pt008_counted(c6),
    k9 = count : { child(p7, s8, _), precedes(s8, c6), pt008_counted(s8) }, k9 = 1,
    !pt008_alt_10(c6), pt008_new_lambda(c6).
