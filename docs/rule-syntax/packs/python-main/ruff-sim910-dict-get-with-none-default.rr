.policy "ruff-sim910-dict-get-with-none-default" revision 1
.guests off
.description "Drop the redundant None default from dict.get() calls; get() already returns None for a missing key."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// SIM910(n): a finding at node n, from clause `dict-get-with-none-default`.
// Each rule below is one way the JSON `rule` can match.
.violation SIM910(at: node) "Use `.get(key)` instead of `.get(key, None)`"
    suppress noqa "SIM910"
SIM910(n) :- kind(n, "call"), child(n, c1, _), kind(c1, "attribute"), child(c1, c2, _),
    sim910_receiver(c2), precedes_stop(c2, s3, sim910_stop_5), glob(".", s3), child(c1, c4, _),
    kind(c4, "identifier"), glob("get", c4), sim910_tok_follows_6(c4), child(n, c12, _),
    kind(c12, "argument_list"),
    count : { child(c12, c13, _), (kind(c13, "keyword_argument") ; kind(c13, "dictionary_splat")) } = 0,
    child(c12, c14, _), sim910_none(c14), precedes_stop(s15, c14, sim910_stop_5), glob("\\,", s15),
    precedes_stop(s16, s15, sim910_stop_5), precedes_stop(s17, s16, sim910_stop_5), glob("(", s17).

