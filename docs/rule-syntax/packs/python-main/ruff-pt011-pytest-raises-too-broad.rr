// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl pt011_alt_1_u0_empty(n: node)

// alt_2_u0_empty: level -1 of an unrolled recursion, empty
.decl pt011_alt_2_u0_empty(n: node)

// empty_or_null_u0_empty: level -1 of an unrolled recursion, empty
.decl pt011_empty_or_null_u0_empty(n: node)

// empty_part_u0: level -1 of an unrolled recursion, empty
.decl pt011_empty_part_u0(n: node)

// empty_part_u0_empty: level -1 of an unrolled recursion, empty
.decl pt011_empty_part_u0_empty(n: node)

// set_10: names from the JSON `resolves.global`
.decl pt011_set_10(v: symbol)
pt011_set_10("BaseException"). pt011_set_10("Exception"). pt011_set_10("ValueError"). pt011_set_10("OSError").
pt011_set_10("IOError"). pt011_set_10("EnvironmentError").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pt011_alt_1(n: node)
pt011_alt_1(n) :- pt011_alt_1_u7(n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pt011_alt_2(n: node)
pt011_alt_2(n) :- pt011_alt_2_u7(n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl pt011_alt_4(n: node)
pt011_alt_4(n) :- pt011_pos1(n).
pt011_alt_4(n) :- kind(n, "keyword_argument"), field(n, "name", c1), glob("func", c1).
pt011_alt_4(n) :- kind(n, "keyword_argument"), field(n, "name", c2), glob("match", c2),
    count : { field(n, "value", c3), pt011_empty_or_null(c3) } = 0.
pt011_alt_4(n) :- kind(n, "keyword_argument"), field(n, "name", c4), glob("check", c4),
    count : { field(n, "value", c5), pt011_none_p(c5) } = 0.

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl pt011_alt_5(n: node)
pt011_alt_5(n) :-
    ( kind(n, "keyword_argument")
    ; kind(n, "dictionary_splat")
    ; kind(n, "comment")
    ; kind(n, "line_continuation")
    ).

pt011_alt_5(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl pt011_alt_6(n: node)
pt011_alt_6(n) :- kind(n, "list_splat").
pt011_alt_6(n) :- precedes(s1, n), pt011_positional(s1).

// counted_7(n): the siblings the JSON `nthChild.ofRule` counts
.decl pt011_counted_7(n: node)
pt011_counted_7(n) :- pt011_positional(n).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
.decl pt011_alt_8(n: node)
pt011_alt_8(n) :- kind(n, "list_splat").
pt011_alt_8(n) :- precedes(s1, n), kind(s1, "list_splat").

// alt_9(n): the JSON `any`: n matches if any one of these rules does
.decl pt011_alt_9(n: node)
pt011_alt_9(n) :- pt011_ann_pos1(n).
pt011_alt_9(n) :- kind(n, "keyword_argument"), child(n, c1, _), kind(c1, "identifier"),
    glob("func", c1), pt011_tok_precedes_6(c1).
pt011_alt_9(n) :- kind(n, "keyword_argument"), child(n, c9, _), kind(c9, "identifier"),
    glob("match", c9), pt011_tok_precedes_7(c9),
    count : { child(n, c17, _), pt011_ann_empty_or_null(c17), pt011_tok_follows_8(c17) } = 0.
pt011_alt_9(n) :- kind(n, "keyword_argument"), child(n, c25, _), kind(c25, "identifier"),
    glob("check", c25), pt011_tok_precedes_9(c25),
    count : { child(n, c33, _), pt011_none_p(c33), pt011_tok_follows_10(c33) } = 0.

// alt_11(n): the JSON `any`: n matches if any one of these rules does
//   X: metavariable this relation binds for the calling rule
.decl pt011_alt_11(n: node, x: loc)
pt011_alt_11(n, X) :- pt011_exc(n, X), pt011_ann_slot(n).
pt011_alt_11(n, X) :- pt011_ann_string(n, X).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
//   X: metavariable this relation binds for the calling rule
.decl pt011_alt_12(n: node, x: loc)
pt011_alt_12(n, X) :- pt011_exc_socket_error(n, X), pt011_ann_slot(n).
pt011_alt_12(n, X) :- pt011_ann_string_socket_error(n, X).
