pt011_none_p(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pt011_none_p(c1).

// broad_call(n): the JSON util `broad-call`, used where the JSON says `matches: "broad-call"`
.decl pt011_broad_call(n: node)
pt011_broad_call(n) :- kind(n, "call"), field(n, "function", c1), pt011_raises(c1),
    field(n, "arguments", c2), kind(c2, "argument_list"),
    count : { child(c2, c3, _), pt011_alt_4(c3) } = 0.

// positional(n): the JSON util `positional`, used where the JSON says `matches: "positional"`
.decl pt011_positional(n: node)
pt011_positional(n) :- node(_, n, _, _, _), !pt011_alt_5(n).

// pos0(n): the JSON util `pos0`, used where the JSON says `matches: "pos0"`
.decl pt011_pos0(n: node)
pt011_pos0(n) :- pt011_positional(n), !pt011_alt_6(n).

// pos1(n): the JSON util `pos1`, used where the JSON says `matches: "pos1"`
.decl pt011_pos1(n: node)
pt011_pos1(n) :- pt011_positional(n), child(p1, n, _), pt011_counted_7(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), pt011_counted_7(s2) }, k3 = 1,
    !pt011_alt_8(n).

// exc_slot(n): the JSON util `exc-slot`, used where the JSON says `matches: "exc-slot"`
.decl pt011_exc_slot(n: node)
pt011_exc_slot(n) :- field(p1, "value", n), kind(p1, "keyword_argument"),
    field(p1, "name", c2), glob("expected_exception", c2), child(p3, p1, _),
    kind(p3, "argument_list"), field(p4, "arguments", p3), pt011_broad_call(p4).
pt011_exc_slot(n) :- pt011_pos0(n), child(p5, n, _), kind(p5, "argument_list"),
    count : { child(p5, c6, _), kind(c6, "keyword_argument"), field(c6, "name", c7), glob("expected_exception", c7) } = 0,
    field(p8, "arguments", p5), pt011_broad_call(p8).

