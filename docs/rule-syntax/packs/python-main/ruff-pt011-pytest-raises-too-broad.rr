pt011_ann_slot(n) :- pt011_tok_follows_11(n), child(p18, n, _), kind(p18, "keyword_argument"),
    child(p18, c19, _), kind(c19, "identifier"), glob("expected_exception", c19),
    pt011_tok_precedes_12(c19), child(p27, p18, _), pt011_ann_args_ok(p27).

