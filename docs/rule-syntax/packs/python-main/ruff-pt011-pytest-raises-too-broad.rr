.policy "ruff-pt011-pytest-raises-too-broad" revision 1
.guests off
.description "Constrain pytest.raises for broad exceptions such as ValueError or OSError with a message match or a more specific exception; otherwise unrelated errors also pass."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// raises(n): the JSON util `raises`, used where the JSON says `matches: "raises"`
.decl pt011_raises(n: node)
pt011_raises(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pt011_raises(c1).
pt011_raises(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "pytest.raises").

// empty_part(n): the JSON util `empty-part`, used where the JSON says `matches: "empty-part"`
.decl pt011_empty_part(n: node)
pt011_empty_part(n) :- pt011_empty_part_u7(n).

