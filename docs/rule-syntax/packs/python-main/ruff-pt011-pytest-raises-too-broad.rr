// ann_pos1(n): the JSON util `ann-pos1`, used where the JSON says `matches: "ann-pos1"`
.decl pt011_ann_pos1(n: node)
pt011_ann_pos1(n) :- pt011_positional(n), !kind(n, "list_splat"), precedes(s1, n), pt011_positional(s1),
