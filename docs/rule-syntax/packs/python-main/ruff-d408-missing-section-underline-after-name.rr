.policy "ruff-d408-missing-section-underline-after-name" revision 1
.guests off
.description "Put a section underline on the line directly below the section name, with no blank line between them."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// D408(n): findings from clauses `underline-after-blank-shared`, `underline-after-blank-numpy`, `underline-after-blank-google`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation D408(at: node, name: node) "Move this underline up to the line directly below the section name, removing the blank lines between them."
    suppress noqa "D408"
D408(NAME, n) :- kind(n, "string_content"), child(p1, n, _), d408_docstring_of(p1),
    count : { value(p1, v2), match("(?s:.*)\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[ \\t]*(?:\\n|\\z)(?s:.*)", v2) } = 0,
    d408_alt_4(n, NAME).
D408(NAME, n) :- kind(n, "string_content"), d408_numpy_style(n), child(p1, n, _),
    d408_docstring_of(p1),
    count : { value(p1, v2), match("(?s:.*)\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:extended summary|other parameters|short summary|other params|parameters|receives):?[ \\t]*(?:\\n|\\z)(?s:.*)", v2) } = 0,
    d408_alt_20(n, NAME).
D408(NAME, n) :- kind(n, "string_content"),
    !d408_numpy_style_underline_after_blank_google(n), child(p1, n, _), d408_docstring_of(p1),
    count : { value(p1, v2), match("(?s:.*)\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:keyword arguments|other arguments|keyword args|other args|arguments|attention|important|caution|example|warning|danger|return|error|yield|args|hint|note|todo|tip):?[ \\t]*(?:\\n|\\z)(?s:.*)", v2) } = 0,
    d408_alt_36(n, NAME).

// docstring_of(n): 3 identical copies of one rule set (`docstring`, `docstring`, `docstring`), folded into one.
.decl d408_docstring_of(n: node)
d408_docstring_of(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0,
    within_stop(n, p2, d408_stop_1), kind(p2, "expression_statement"), !d408_alt_2(p2),
    child(p12, p2, _),
    ( kind(p12, "module")
    ; kind(p12, "block"), child(p1, p12, _), (kind(p1, "function_definition") ; kind(p1, "class_definition"))
    ).


// numpy_style(n): the JSON util `numpy-style`, used where the JSON says `matches: "numpy-style"`
.decl d408_numpy_style(n: node)
d408_numpy_style(n) :- kind(n, "string_content"),
    ( d408_args_header_family(n, "params_header")
    ; !d408_args_header_family(n, "args_header"), d408_alt_10(n)
    ).


// args_header_family(n, key): 12 copies of one rule set (`args-header`, `args-header`, `google-only-header` and 9 more), folded into one: row `key` of
// args_header_family_case gives the strings each copy had.
.decl d408_args_header_family(n: node, key: symbol)
d408_args_header_family(n, q1) :- d408_args_header_family_case(q1, s1),
    kind(n, "string_content"), match(s1, n).

// underline_before_colon(n): the JSON util `underline-before-colon`, used where the JSON says `matches: "underline-before-colon"`
.decl d408_underline_before_colon(n: node)
d408_underline_before_colon(n) :- kind(n, "string_content"), d408_alt_19(n).

// numpy_style_underline_after_blank_google(n): the JSON util `numpy-style`, used where the JSON says `matches: "numpy-style"`
.decl d408_numpy_style_underline_after_blank_google(n: node)
d408_numpy_style_underline_after_blank_google(n) :- kind(n, "string_content"),
    ( d408_args_header_family(n, "params_header_underline_after_blank_google")
    ; !d408_args_header_family(n, "args_header_underline_after_blank_google"), d408_alt_26(n)
    ).


// underline_before_colon_underline_after_blank_google(n): the JSON util `underline-before-colon`, used where the JSON says `matches: "underline-before-colon"`
.decl d408_underline_before_colon_underline_after_blank_google(n: node)
d408_underline_before_colon_underline_after_blank_google(n) :- kind(n, "string_content"),
    d408_alt_19(n).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d408_tok_has_1(n: node)
.stored d408_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d408_tok_has_1(n) :- child(n, c3, _), glob("\\,", c3).
d408_tok_has_1(n) :- op(n, t4), match(",", t4).
d408_tok_has_1(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
d408_tok_has_1(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
d408_tok_has_1(n) :- node_text(n, g5), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g5).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d408_tok_has_2(n: node)
.stored d408_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d408_tok_has_2(n) :- child(n, c1, _), glob("\\,", c1).
d408_tok_has_2(n) :- op(n, t2), match(",", t2).
d408_tok_has_2(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d408_tok_has_2(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d408_tok_has_2(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// args_header_family_case: one row per relation folded into args_header_family: its key, then the strings that differed.
.decl d408_args_header_family_case(key: symbol, s1: symbol)
d408_args_header_family_case("args_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:rguments|rgs)|K(?i:eyword arguments|eyword args)|O(?i:ther arguments|ther args)):?[^\\S\\n]*(?m:$))(?s:.*)").
d408_args_header_family_case("args_header_underline_after_blank_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:rguments|rgs)|K(?i:eyword arguments|eyword args)|O(?i:ther arguments|ther args)):?[^\\S\\n]*(?m:$))(?s:.*)").
d408_args_header_family_case("google_only_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)").
d408_args_header_family_case("google_only_header_underline_after_blank_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)").
d408_args_header_family_case("google_only_headers_2", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*)").
d408_args_header_family_case("google_only_headers_2_underline_after_blank_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*)").
d408_args_header_family_case("numpy_only_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)").
d408_args_header_family_case("numpy_only_header_underline_after_blank_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)").
d408_args_header_family_case("numpy_only_headers_2", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)(?s:.*)").
d408_args_header_family_case("numpy_only_headers_2_underline_after_blank_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)(?s:.*)").
d408_args_header_family_case("params_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:O(?i:ther parameters|ther params)|P(?i:arameters)):?[^\\S\\n]*(?m:$))(?s:.*)").
d408_args_header_family_case("params_header_underline_after_blank_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:O(?i:ther parameters|ther params)|P(?i:arameters)):?[^\\S\\n]*(?m:$))(?s:.*)").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl d408_stop_1(n: node)
d408_stop_1(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl d408_alt_2(n: node)
d408_alt_2(n) :- d408_tok_has_2(n).
d408_alt_2(n) :- precedes(s9, n), !kind(s9, "comment").

// alt_4(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl d408_alt_4(n: node, name: loc)
d408_alt_4(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$)(?s:.*)", n).
d408_alt_4(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttributes)|E(?i:xamples)|M(?i:ethods)|N(?i:otes)|R(?i:eferences|eturns|aises)|S(?i:ee also)|W(?i:arnings|arns)|Y(?i:ields)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$)(?s:.*)", n).
d408_alt_4(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:a(?i:ttributes)|e(?i:xamples)|m(?i:ethods)|n(?i:otes)|r(?i:eferences|eturns|aises)|s(?i:ee also)|w(?i:arnings|arns)|y(?i:ields)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$))|\\n[^\\S\\n]*(?i:keyword arguments|extended summary|other parameters|other arguments|short summary|other params|keyword args|attributes|references|parameters|other args|arguments|attention|important|examples|see also|warnings|receives|methods|returns|caution|example|warning|raises|yields|danger|return|notes|warns|error|yield|args|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*))(?s:.*)", n).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
.decl d408_alt_12(n: node)
d408_alt_12(n) :- d408_args_header_family(n, "google_only_header"),
    !d408_args_header_family(n, "numpy_only_header").
d408_alt_12(n) :- d408_args_header_family(n, "google_only_headers_2"),
    !d408_args_header_family(n, "numpy_only_headers_2").

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl d408_alt_10(n: node)
d408_alt_10(n) :-
    ( d408_args_header_family(n, "numpy_only_header"), !d408_args_header_family(n, "google_only_header")
    ; d408_args_header_family(n, "numpy_only_headers_2"), !d408_args_header_family(n, "google_only_headers_2")
    ).

d408_alt_10(n) :- !d408_alt_12(n), d408_underline_before_colon(n).

// alt_19(n): the JSON `any`: n matches if any one of these rules does
.decl d408_alt_19(n: node)
d408_alt_19(n) :- node(_, n, _, _, _),
    !match("(?s:.*)(?:(?m:^)[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):[^\\S\\n]*(?m:$)(?:\\z|\\n[^\\S\\n]*(?m:$)|\\n[^\\S\\n]*(?:[^\\s\\-]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])))(?s:.*)", n).
d408_alt_19(n) :- node(_, n, _, _, _),
    match("(?s)(?s:.*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*-+[^\\S\\n]*(?m:$).*?(?:(?m:^)[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):[^\\S\\n]*(?m:$)(?:\\z|\\n[^\\S\\n]*(?m:$)|\\n[^\\S\\n]*(?:[^\\s\\-]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])))(?s:.*)", n).

// alt_20(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl d408_alt_20(n: node, name: loc)
d408_alt_20(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|other parameters|short summary|other params|parameters|receives):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$)(?s:.*)", n).
d408_alt_20(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|O(?i:ther parameters|ther params)|P(?i:arameters)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$)(?s:.*)", n).
d408_alt_20(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:e(?i:xtended summary)|o(?i:ther parameters|ther params)|p(?i:arameters)|r(?i:eceives)|s(?i:hort summary)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$))|\\n[^\\S\\n]*(?i:keyword arguments|extended summary|other parameters|other arguments|short summary|other params|keyword args|attributes|references|parameters|other args|arguments|attention|important|examples|see also|warnings|receives|methods|returns|caution|example|warning|raises|yields|danger|return|notes|warns|error|yield|args|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*))(?s:.*)", n).

// alt_25(n): the JSON `any`: n matches if any one of these rules does
.decl d408_alt_25(n: node)
d408_alt_25(n) :- d408_args_header_family(n, "google_only_header_underline_after_blank_google"),
    !d408_args_header_family(n, "numpy_only_header_underline_after_blank_google").
d408_alt_25(n) :- d408_args_header_family(n, "google_only_headers_2_underline_after_blank_google"),
    !d408_args_header_family(n, "numpy_only_headers_2_underline_after_blank_google").

// alt_26(n): the JSON `any`: n matches if any one of these rules does
.decl d408_alt_26(n: node)
d408_alt_26(n) :-
    ( d408_args_header_family(n, "numpy_only_header_underline_after_blank_google"), !d408_args_header_family(n, "google_only_header_underline_after_blank_google")
    ; d408_args_header_family(n, "numpy_only_headers_2_underline_after_blank_google"), !d408_args_header_family(n, "google_only_headers_2_underline_after_blank_google")
    ).

d408_alt_26(n) :- !d408_alt_25(n), d408_underline_before_colon_underline_after_blank_google(n).

// alt_36(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl d408_alt_36(n: node, name: loc)
d408_alt_36(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|attention|important|caution|example|warning|danger|return|error|yield|args|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$)(?s:.*)", n).
d408_alt_36(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:rguments|ttention|rgs)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|K(?i:eyword arguments|eyword args)|N(?i:ote)|O(?i:ther arguments|ther args)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$)(?s:.*)", n).
d408_alt_36(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:a(?i:rguments|ttention|rgs)|c(?i:aution)|d(?i:anger)|e(?i:xample|rror)|h(?i:int)|i(?i:mportant)|k(?i:eyword arguments|eyword args)|n(?i:ote)|o(?i:ther arguments|ther args)|r(?i:eturn)|t(?i:odo|ip)|w(?i:arning)|y(?i:ield)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$))|\\n[^\\S\\n]*(?i:keyword arguments|extended summary|other parameters|other arguments|short summary|other params|keyword args|attributes|references|parameters|other args|arguments|attention|important|examples|see also|warnings|receives|methods|returns|caution|example|warning|raises|yields|danger|return|notes|warns|error|yield|args|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*))(?s:.*)", n).
