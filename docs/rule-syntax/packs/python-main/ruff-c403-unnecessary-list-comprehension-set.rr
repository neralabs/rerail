.policy "ruff-c403-unnecessary-list-comprehension-set" revision 1
.guests off
.description "Use a set comprehension instead of passing a list comprehension to set; it skips building a throwaway list."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// C403(n): a finding at node n, from clause `list-comprehension-set`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation C403(at: node, c403_call: node) "Rewrite `set([expr for ...])` as a set comprehension `{{expr for ...}}`; the intermediate list is not needed."
    suppress noqa "C403"
C403(CALL, n) :- c403_call(n, CALL).
C403(CALL, n) :- c403_in_annotation(n, CALL).

// trivia(n): the JSON util `trivia`, used where the JSON says `matches: "trivia"`
.decl c403_trivia(n: node)
c403_trivia(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
c403_trivia(n) :- node(_, n, _, _, _), glob("[(),]", n).

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
.decl c403_callee(n: node)
c403_callee(n) :- kind(n, "identifier"), global_ref(n, "set").
c403_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), c403_callee(c1).

// listcomp(n): the JSON util `listcomp`, used where the JSON says `matches: "listcomp"`
.decl c403_listcomp(n: node)
c403_listcomp(n) :- kind(n, "list_comprehension").
c403_listcomp(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), c403_listcomp(c1).

// call(n): the JSON util `call`, used where the JSON says `matches: "call"`
//   CALL: metavariable this relation binds for the calling rule
.decl c403_call(n: node, c403_call: loc)
c403_call(n, CALL) :- kind(n, "call"), c403_alt_1(n, CALL), field(n, "arguments", c4),
    kind(c4, "argument_list"), k6 = count : { child(c4, c5, _), !c403_trivia(c5) }, k6 >= 1,
    k6 <= 1, child(c4, c7, _), c403_listcomp(c7).

// in_annotation(n): the JSON util `in-annotation`, used where the JSON says `matches: "in-annotation"`
//   CALL: metavariable this relation binds for the calling rule
.decl c403_in_annotation(n: node, c403_call: loc)
c403_in_annotation(n, CALL) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), c403_alt_2(c2, CALL).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
//   CALL: metavariable this relation binds for the calling rule
.decl c403_alt_1(n: node, c403_call: loc)
c403_alt_1(n, CALL) :- field(n, "function", c1), c403_callee(c1), node(_, n, _, _, _), CALL = n.
c403_alt_1(n, CALL) :- field(n, "function", c2), kind(c2, "list_splat"), child(c2, c3, _),
    c403_callee(c3), match("\\*(?:\\s|\\\\\\r?\\n|#[^\\r\\n]*)*(?<CALL>[\\s\\S]+)", n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   CALL: metavariable this relation binds for the calling rule
.decl c403_alt_2(n: node, c403_call: loc)
c403_alt_2(n, CALL) :- c403_call(n, CALL).
c403_alt_2(n, CALL) :- c403_in_annotation(n, CALL).
