.policy "ruff-ruf018-assignment-in-assert" revision 1
.guests off
.description "Avoid assignment expressions in assert statements when the name is used outside asserts; the assignment is lost when assertions are disabled."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// RUF018(n): a finding at node n, from clause `assignment-in-assert`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF018(at: node, w: node, name: loc) "Assign `{name}` in its own statement before the `assert` and assert on `{name}`; under `python -O` asserts are skipped, so code outside the assert would not see this assignment."
    suppress noqa "RUF018"
RUF018(W, n, NAME) :- kind(n, "named_expression"), node(_, n, _, _, _), W = n, ruf018_in_assert(n),
    field(n, "name", c1), node(_, c1, _, _, _), NAME = c1, ruf018_in_sc(n, SC),
    ( inside(n, p1_5, "module"), has(p1_5, c2_5, "identifier"), !ruf018_in_assert(c2_5), (ref_site(c2_5, b1_3_5), (st2_3_5 = b1_3_5 ; within(b1_3_5, st2_3_5)), kind(st2_3_5, "named_expression"), node(_, st2_3_5, _, _, _), S = st2_3_5, text(W, t3_3_5), text(S, t3_3_5), @doc(W) = @doc(S) ; ruf018_earlier_read(c2_5, NAME, SC, W))
    ; ruf018_up_1(n, p7_6), has(p7_6, c8_6, "function_definition"), has(c8_6, c9_6, "nonlocal_statement"), child(c9_6, c10_6, _), kind(c10_6, "identifier"), text(c10_6, t_name6_6), text(NAME, t_name6_6), count : { has(p7_6, c11_6, "identifier"), text(c11_6, t_name7_6), text(NAME, t_name7_6), (bind_only(c11_6) ; aug_target(c11_6)), ruf018_in_sc(c11_6, SC), t13_6 = W, node(_, c11_6, _, s16_6, e17_6), node(_, W, _, s18_6, e19_6), e19_6 <= s16_6, line(c11_6, l15_6), end_line(t13_6, l14_6), k12_6 = l15_6 - l14_6, k12_6 >= 0, @doc(c11_6) = @doc(NAME) } = 0, @doc(c10_6) = @doc(NAME) ; ruf018_up_2(n, p20_7), field(n, "name", c21_7), site_latest(c21_7), site_exported(c21_7)
    ).


// in_assert(n): the JSON util `in-assert`, used where the JSON says `matches: "in-assert"`
.decl ruf018_in_assert(n: node)
ruf018_in_assert(n) :- ruf018_demand_in_assert(n), inside(n, p1, "assert_statement").

// scope_node(n): the JSON util `scope-node`, used where the JSON says `matches: "scope-node"`
.decl ruf018_scope_node(n: node)
ruf018_scope_node(n) :-
    ( kind(n, "function_definition")
    ; kind(n, "lambda")
    ; kind(n, "module")
    ; kind(n, "class_definition")
    ).


// in_sc(n): the JSON util `in-sc`, used where the JSON says `matches: "in-sc"`
//   SC: metavariable this relation binds for the calling rule
.decl ruf018_in_sc(n: node, sc: loc)
ruf018_in_sc(n, SC) :- ruf018_demand_in_sc(n), ruf018_up_3(n, p1), node(_, p1, _, _, _), SC = p1.

// in_sc_past_class(n): the JSON util `in-sc-past-class`, used where the JSON says `matches: "in-sc-past-class"`
//   SC: metavariable of the calling rule, passed in (bound by the caller)
.decl ruf018_in_sc_past_class(n: node, sc: loc)
ruf018_in_sc_past_class(n, SC) :- ruf018_demand_in_sc_past_class(n, SC), within_stop(n, p1, ruf018_stop_2),
    (kind(p1, "function_definition") ; kind(p1, "lambda") ; kind(p1, "module")),
    text(p1, t_sc1), text(SC, t_sc1), @doc(p1) = @doc(SC).

// earlier_read(n): the JSON util `earlier-read`, used where the JSON says `matches: "earlier-read"`
//   NAME, SC, W: metavariables of the calling rule, passed in (bound by the caller)
.decl ruf018_earlier_read(n: node, name: loc, sc: loc, w: loc)
ruf018_earlier_read(n, NAME, SC, W) :- ruf018_demand_earlier_read(n, NAME, SC, W),
    text(n, t_name2), text(NAME, t_name2), node(_, n, _, _, _), R = n, t2 = W, node(_, n, _, s5, e6),
    node(_, W, _, s7, e8), s7 >= e6, end_line(n, l3), line(t2, l4), k1 = l4 - l3,
    k1 >= 0,
    ( ruf018_in_sc(n, SC)
    ; ruf018_in_sc_past_class(n, SC)
    ; within_stop(n, p1, ruf018_stop_1), (kind(p1, "parameters") ; kind(p1, "lambda_parameters")), child(p2, p1, _), ruf018_in_sc(p2, SC)
    ),

    ( ref_site(n, b1_1), site_stop_at_global(b1_1), (site_scope(b1_1, "function") ; site_scope(b1_1, "lambda") ; site_scope(b1_1, "module") ; site_scope(b1_1, "class")), (st2_1 = b1_1 ; within(b1_1, st2_1)), ruf018_in_sc(st2_1, SC), !ruf018_alt_11(st2_1)
    ; inside(n, p4_2, "module"), has(p4_2, c5_2, "assignment"), ruf018_in_sc(c5_2, SC), field(c5_2, "left", c6_2), text(c6_2, t_name5_2), text(NAME, t_name5_2), field(c5_2, "type", c7_2), kind(c7_2, "type"), count : { field(c5_2, "right", c8_2), match(".*[^\\s].*", c8_2) } = 0, t10_2 = R, node(_, c5_2, _, s13_2, e14_2), node(_, R, _, s15_2, e16_2), s15_2 >= e14_2, end_line(c5_2, l11_2), line(t10_2, l12_2), k9_2 = l12_2 - l11_2, k9_2 >= 0, @doc(c6_2) = @doc(NAME) ),

    count : { inside(n, p27, "module"), within(c28, p27), ruf018_alt_4(c28, NAME), ruf018_in_sc(c28, SC), t9_8 = W, node(_, c28, _, s12_8, e13_8), node(_, W, _, s14_8, e15_8), s14_8 >= e13_8, end_line(c28, l10_8), line(t9_8, l11_8), k8_8 = l11_8 - l10_8, k8_8 >= 0, count : { t17_8 = R, node(_, c28, _, s20_8, e21_8), node(_, R, _, s22_8, e23_8), s22_8 >= e21_8, end_line(c28, l18_8), line(t17_8, l19_8), k16_8 = l19_8 - l18_8, k16_8 >= 0 } = 0 } = 0, @doc(n) = @doc(NAME).

// demand_earlier_read: the rows of earlier_read its callers ask for (the metavariable columns they pass in)
.decl ruf018_demand_earlier_read(n: node, name: loc, sc: loc, w: loc)
ruf018_demand_earlier_read(c2_5, NAME, SC, W) :- kind(n, "named_expression"), node(_, n, _, _, _), W = n,
    ruf018_in_assert(n), field(n, "name", c1), node(_, c1, _, _, _), NAME = c1, ruf018_in_sc(n, SC),
    inside(n, p1_5, "module"), has(p1_5, c2_5, "identifier").

// demand_alt_4: the rows of alt_4 its callers ask for (the metavariable columns they pass in)
.decl ruf018_demand_alt_4(n: node, name: loc)
ruf018_demand_alt_4(c28, NAME) :- ruf018_demand_earlier_read(n, NAME, SC, W), text(n, t_name2),
    text(NAME, t_name2), node(_, n, _, _, _), R = n, t2 = W, node(_, n, _, s5, e6),
    node(_, W, _, s7, e8), end_line(n, l3), line(t2, l4), inside(n, p27, "module"),
    within(c28, p27), ruf018_in_sc(c28, SC), t9_8 = W, node(_, c28, _, s12_8, e13_8),
    node(_, W, _, s14_8, e15_8), end_line(c28, l10_8), line(t9_8, l11_8), @doc(n) = @doc(NAME).

// demand_in_sc_past_class: the rows of in_sc_past_class its callers ask for (the metavariable columns they pass in)
.decl ruf018_demand_in_sc_past_class(n: node, sc: loc)
ruf018_demand_in_sc_past_class(n, SC) :- ruf018_demand_earlier_read(n, NAME, SC, W),
    text(n, t_name2), text(NAME, t_name2), node(_, n, _, _, _), R = n, t2 = W, node(_, n, _, s5, e6),
    node(_, W, _, s7, e8), end_line(n, l3), line(t2, l4), @doc(n) = @doc(NAME).

// demand_in_sc: the nodes in_sc is asked at (it looks at every ancestor of every node)
.decl ruf018_demand_in_sc(n: node)
ruf018_demand_in_sc(n) :- kind(n, "named_expression"), node(_, n, _, _, _), W = n, ruf018_in_assert(n),
    field(n, "name", c1), node(_, c1, _, _, _), NAME = c1.
ruf018_demand_in_sc(c11_6) :- kind(n, "named_expression"), node(_, n, _, _, _), W = n, ruf018_in_assert(n),
    field(n, "name", c1), node(_, c1, _, _, _), NAME = c1, ruf018_up_1(n, p7_6),
    has(p7_6, c8_6, "function_definition"), has(c8_6, c9_6, "nonlocal_statement"),
    child(c9_6, c10_6, _), kind(c10_6, "identifier"), text(c10_6, t_name6_6),
    text(NAME, t_name6_6), has(p7_6, c11_6, "identifier"), text(c11_6, t_name7_6),
    text(NAME, t_name7_6), (bind_only(c11_6) ; aug_target(c11_6)), t13_6 = W,
    node(_, c11_6, _, s16_6, e17_6), node(_, W, _, s18_6, e19_6), line(c11_6, l15_6),
    end_line(t13_6, l14_6), @doc(c10_6) = @doc(NAME), @doc(c11_6) = @doc(NAME).
ruf018_demand_in_sc(n) :- ruf018_demand_earlier_read(n, NAME, SC, W), text(n, t_name2),
    text(NAME, t_name2), node(_, n, _, _, _), R = n, t2 = W, node(_, n, _, s5, e6),
    node(_, W, _, s7, e8), end_line(n, l3), line(t2, l4), @doc(n) = @doc(NAME).
ruf018_demand_in_sc(p2) :- ruf018_demand_earlier_read(n, NAME, SC, W), text(n, t_name2),
    text(NAME, t_name2), node(_, n, _, _, _), R = n, t2 = W, node(_, n, _, s5, e6),
    node(_, W, _, s7, e8), end_line(n, l3), line(t2, l4), within_stop(n, p1, ruf018_stop_1),
    (kind(p1, "parameters") ; kind(p1, "lambda_parameters")), child(p2, p1, _), @doc(n) = @doc(NAME).
ruf018_demand_in_sc(st2_1) :- ruf018_demand_earlier_read(n, NAME, SC, W), text(n, t_name2),
    text(NAME, t_name2), node(_, n, _, _, _), R = n, t2 = W, node(_, n, _, s5, e6),
    node(_, W, _, s7, e8), end_line(n, l3), line(t2, l4), ref_site(n, b1_1),
    site_stop_at_global(b1_1),
    ( site_scope(b1_1, "function")
    ; site_scope(b1_1, "lambda")
    ; site_scope(b1_1, "module")
    ; site_scope(b1_1, "class")
    ),
    (st2_1 = b1_1 ; within(b1_1, st2_1)), @doc(n) = @doc(NAME).
ruf018_demand_in_sc(c5_2) :- ruf018_demand_earlier_read(n, NAME, SC, W), text(n, t_name2),
    text(NAME, t_name2), node(_, n, _, _, _), R = n, t2 = W, node(_, n, _, s5, e6),
    node(_, W, _, s7, e8), end_line(n, l3), line(t2, l4), inside(n, p4_2, "module"),
    has(p4_2, c5_2, "assignment"), field(c5_2, "left", c6_2), text(c6_2, t_name5_2),
    text(NAME, t_name5_2), field(c5_2, "type", c7_2), kind(c7_2, "type"), t10_2 = R,
    node(_, c5_2, _, s13_2, e14_2), node(_, R, _, s15_2, e16_2), end_line(c5_2, l11_2),
    line(t10_2, l12_2), @doc(n) = @doc(NAME), @doc(c6_2) = @doc(NAME).
ruf018_demand_in_sc(c28) :- ruf018_demand_earlier_read(n, NAME, SC, W), text(n, t_name2),
    text(NAME, t_name2), node(_, n, _, _, _), R = n, t2 = W, node(_, n, _, s5, e6),
    node(_, W, _, s7, e8), end_line(n, l3), line(t2, l4), inside(n, p27, "module"),
    within(c28, p27), t9_8 = W, node(_, c28, _, s12_8, e13_8),
    node(_, W, _, s14_8, e15_8), end_line(c28, l10_8), line(t9_8, l11_8), @doc(n) = @doc(NAME).

// demand_in_assert: the nodes in_assert is asked at (it looks at every ancestor of every node)
.decl ruf018_demand_in_assert(n: node)
ruf018_demand_in_assert(n) :- kind(n, "named_expression"), node(_, n, _, _, _), W = n, field(n, "name", c1),
    node(_, c1, _, _, _), NAME = c1.
ruf018_demand_in_assert(c2_5) :- kind(n, "named_expression"), node(_, n, _, _, _), W = n, field(n, "name", c1),
    node(_, c1, _, _, _), NAME = c1, inside(n, p1_5, "module"), has(p1_5, c2_5, "identifier").

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl ruf018_up_1(n: node, p: node)
ruf018_up_1(n, p) :- ruf018_in_assert(n), within_stop(n, p, ruf018_stop_1), kind(p, "function_definition").

// up_2(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl ruf018_up_2(n: node, p: node)
ruf018_up_2(n, p) :- ruf018_in_assert(n), within_stop(n, p, ruf018_stop_1), kind(p, "module").

// up_3(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl ruf018_up_3(n: node, p: node)
ruf018_up_3(n, p) :- ruf018_demand_in_sc(n), within_stop(n, p, ruf018_stop_1), ruf018_scope_node(p).

// stop_2: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf018_stop_2(kind: symbol)
ruf018_stop_2("function_definition"). ruf018_stop_2("lambda"). ruf018_stop_2("module").

// set_3: node kinds from a JSON `any`
.decl ruf018_set_3(v: symbol)
ruf018_set_3("if_statement"). ruf018_set_3("while_statement"). ruf018_set_3("match_statement").
ruf018_set_3("except_clause"). ruf018_set_3("else_clause").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf018_stop_1(n: node)
ruf018_stop_1(n) :- ruf018_scope_node(n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable of the calling rule, passed in (bound by the caller)
.decl ruf018_alt_4(n: node, name: loc)
ruf018_alt_4(n, NAME) :- ruf018_demand_alt_4(n, NAME), kind(n, "delete_statement"),
    has(n, c1, "identifier"), text(c1, t_name3), text(NAME, t_name3),
    count : { within(c1, p2), (kind(p2, "attribute") ; kind(p2, "subscript")) } = 0,
    count : { within(n, p3), kind(p3, k4), ruf018_set_3(k4) } = 0, @doc(c1) = @doc(NAME).
ruf018_alt_4(n, NAME) :- ruf018_demand_alt_4(n, NAME), kind(n, "except_clause"),
    field(n, "value", c5), kind(c5, "as_pattern"), field(c5, "alias", c6),
    child(c6, c7, _), kind(c7, "identifier"), text(c7, t_name4), text(NAME, t_name4), @doc(c7) = @doc(NAME).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl ruf018_alt_11(n: node)
ruf018_alt_11(n) :- kind(n, "except_clause").
ruf018_alt_11(n) :- child(p1, n, _), kind(p1, "except_clause").
