.decl f704_tok_follows_4(n: node)
.stored f704_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
f704_tok_follows_4(n) :- next_sibling(s29, n), glob("in", s29).
f704_tok_follows_4(n) :- structural_before(n, g31), match("\\s*", g31), child(p32, n, _),
    node(_, n, _, st34, _), o33 = st34 - strlen(g31), token(p32, _, t30, _, o33),
