// tok_follows_5(n): an earlier sibling of n, a named node or an anonymous token, matches "^:$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl f704_tok_follows_5(n: node)
.stored f704_tok_follows_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
f704_tok_follows_5(n) :- next_sibling(s23, n), glob(":", s23).
f704_tok_follows_5(n) :- structural_before(n, g25), match("\\s*", g25), child(p26, n, _),
    node(_, n, _, st28, _), o27 = st28 - strlen(g25), token(p26, _, t24, _, o27),
    match(":", t24).
f704_tok_follows_5(n) :- structural_before(n, g25),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::)\\s*)$", g25).

// tok_follows_6(n): an earlier sibling of n, a named node or an anonymous token, matches "^in$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl f704_tok_follows_6(n: node)
.stored f704_tok_follows_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
f704_tok_follows_6(n) :- next_sibling(s31, n), glob("in", s31).
f704_tok_follows_6(n) :- structural_before(n, g33), match("\\s*", g33), child(p34, n, _),
    node(_, n, _, st36, _), o35 = st36 - strlen(g33), token(p34, _, t32, _, o35),
    match("in", t32).
f704_tok_follows_6(n) :- structural_before(n, g33),
    match("(?s)^(?:(?:.*\\W)?(?:in)\\s*)$", g33).

// tok_has_7(n): a child of n, a named node or an anonymous token, matches "^yield$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl f704_tok_has_7(n: node)
.stored f704_tok_has_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
f704_tok_has_7(n) :- child(n, c1, _), glob("yield", c1).
f704_tok_has_7(n) :- op(n, t2), match("yield", t2).
f704_tok_has_7(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:yield)(?:\\W.*)?)$", g3).
f704_tok_has_7(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:yield)(?:\\W.*)?)$", g3).
f704_tok_has_7(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:yield)(?:\\W.*)?)$", g3).

// tok_has_8(n): a child of n, a named node or an anonymous token, matches "^await$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl f704_tok_has_8(n: node)
.stored f704_tok_has_8 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
f704_tok_has_8(n) :- child(n, c9, _), glob("await", c9).
f704_tok_has_8(n) :- op(n, t10), match("await", t10).
f704_tok_has_8(n) :- child(n, c16, _), structural_before(c16, g11),
    match("(?s)^(?:(?:.*\\W)?(?:await)(?:\\W.*)?)$", g11).
f704_tok_has_8(n) :- child(n, c16, _), structural_after(c16, g11),
    match("(?s)^(?:(?:.*\\W)?(?:await)(?:\\W.*)?)$", g11).
f704_tok_has_8(n) :- node_text(n, g11), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:await)(?:\\W.*)?)$", g11).

// set_1: node kinds from a JSON `any`
.decl f704_set_1(v: symbol)
f704_set_1("lambda"). f704_set_1("module"). f704_set_1("list_comprehension").
f704_set_1("set_comprehension"). f704_set_1("dictionary_comprehension").
f704_set_1("generator_expression").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl f704_alt_2(n: node)
f704_alt_2(n) :- kind(n, k1), f704_set_1(k1).
f704_alt_2(n) :- kind(n, "block"), child(p2, n, _),
    (kind(p2, "function_definition") ; kind(p2, "class_definition")).
