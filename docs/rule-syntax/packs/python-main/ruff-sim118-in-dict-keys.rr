sim118_tok_follows_5(n) :- next_sibling(s12, n), glob("for", s12).
sim118_tok_follows_5(n) :- structural_before(n, g14), match("\\s*", g14), child(p15, n, _),
    node(_, n, _, st17, _), o16 = st17 - strlen(g14), token(p15, _, t13, _, o16),
