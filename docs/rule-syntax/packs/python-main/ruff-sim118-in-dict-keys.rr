sim118_tok_follows_3(n) :- structural_before(n, g21), match("(?s)^.*\\S\\s*$", g21).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim118_tok_has_4(n: node)
.stored sim118_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim118_tok_has_4(n) :- child(n, c1, _), match("(?s).*..*", c1).
sim118_tok_has_4(n) :- op(n, t2), match("(?s).*..*", t2).
sim118_tok_has_4(n) :- child(n, c8, _), structural_before(c8, g3), match("(?s)^.*\\S.*$", g3).
sim118_tok_has_4(n) :- child(n, c8, _), structural_after(c8, g3), match("(?s)^.*\\S.*$", g3).
sim118_tok_has_4(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^.*\\S.*$", g3).

// tok_follows_5(n): an earlier sibling of n, a named node or an anonymous token, matches "^for$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim118_tok_follows_5(n: node)
