.policy "bandit-b317-xml-bad-sax" revision 1
.guests off
.description "Use defusedxml instead of xml.sax to parse XML; the standard parser is open to entity-expansion and other XML attacks on untrusted input."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B317(n): a finding at node n, from clause `bandit:B317`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on F are added to every rule.
.violation B317(at: node) "Using xml.sax to parse untrusted XML may permit XML attacks; use defusedxml."
    suppress nosec "B317"
B317(n) :- kind(n, "expression_statement"), child(n, c1, _), c1 ~ `$F($$$ARGS)`,
    ( sym_of(F, "xml.sax.parse")
    ; sym_of(F, "xml.sax.parseString")
    ; sym_of(F, "xml.sax.make_parser")
    ).
