.policy "ruff-f503-percent-format-expected-sequence" revision 1
.guests off
.description "Pass a tuple, not a dict, to a %-format string with several positional placeholders; the call fails at run time."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// F503(n): a finding at node n, from clause `percent-format-expected-sequence`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on S, R are added to every rule.
.violation F503(at: node) "`%`-format string expected sequence but got mapping"
    suppress noqa "F503"
F503(n) :- n ~ `$S % $R`, f503_format_string(S), f503_operand(R).

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl f503_plain_string(n: node)
f503_plain_string(n) :- kind(n, "string"), !match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", n).
f503_plain_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", c1) } = 0.

// format_string(n): the JSON util `format-string`, used where the JSON says `matches: "format-string"`
.decl f503_format_string(n: node)
f503_format_string(n) :- f503_demand_format_string(n), f503_plain_string(n),
    parsed(n, "percentFormat", r1),
    count : { child(r1, c2, _), kind(c2, "error") } = 0,
    k5 = count : { within(c3, r1), f503_alt_1(c3) }, k5 >= 2.
f503_format_string(n) :- f503_demand_format_string(n), kind(n, "parenthesized_expression"),
    child(n, c6, _), f503_format_string(c6).

// operand(n): the JSON util `operand`, used where the JSON says `matches: "operand"`
.decl f503_operand(n: node)
f503_operand(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
f503_operand(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), f503_operand(c1).

// demand_format_string: the nodes format_string is asked at (its recursion looks at every descendant)
.decl f503_demand_format_string(n: node)
f503_demand_format_string(S) :- n ~ `$S % $R`, f503_operand(R).
f503_demand_format_string(c6) :- f503_demand_format_string(n),
    kind(n, "parenthesized_expression"), child(n, c6, _).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl f503_alt_1(n: node)
f503_alt_1(n) :- kind(n, "placeholder"),
    count : { child(n, c1, _), kind(c1, "mapping_key") } = 0.
f503_alt_1(n) :- kind(n, "star").
