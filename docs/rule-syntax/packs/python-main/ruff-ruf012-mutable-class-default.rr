// tok_precedes_1(n): a later sibling of n, a named node or an anonymous token, matches "^\\[$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf012_tok_precedes_1(n: node)
.stored ruf012_tok_precedes_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf012_tok_precedes_1(n) :- next_sibling(n, s1), glob("\\[", s1).
ruf012_tok_precedes_1(n) :- structural_after(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, _, en7), o5 = en7 + strlen(g3), token(p4, _, t2, o5, _),
    match("\\[", t2).
ruf012_tok_precedes_1(n) :- structural_after(n, g3), match("(?s)^(?:\\s*(?:\\[).*)$", g3).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\[$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf012_tok_follows_2(n: node)
.stored ruf012_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf012_tok_follows_2(n) :- precedes(s1, n), glob("\\[", s1).
ruf012_tok_follows_2(n) :- child(p4, n, _), node(_, n, _, st6, _), token(p4, _, t2, _, en7),
    en7 <= st6, match("\\[", t2).
ruf012_tok_follows_2(n) :- structural_before(n, g3), match("(?s)^(?:.*(?:\\[).*)$", g3).
ruf012_tok_follows_2(n) :- precedes(o5, n), structural_before(o5, g3),
    match("(?s)^(?:.*(?:\\[).*)$", g3).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^\\|$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf012_tok_has_3(n: node)
.stored ruf012_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf012_tok_has_3(n) :- child(n, c2, _), glob("|", c2).
ruf012_tok_has_3(n) :- op(n, t3), match("\\|", t3).
ruf012_tok_has_3(n) :- child(n, c9, _), structural_before(c9, g4),
