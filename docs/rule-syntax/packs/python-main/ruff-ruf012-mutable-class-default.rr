ruf012_tok_has_25(n) :- child(n, c15, _), structural_before(c15, g10),
    match("(?s)^(?:.*(?:,).*)$", g10).
ruf012_tok_has_25(n) :- child(n, c15, _), structural_after(c15, g10),
    match("(?s)^(?:.*(?:,).*)$", g10).
ruf012_tok_has_25(n) :- node_text(n, g10), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g10).

// demand_plain_default: the nodes plain_default is asked at (its recursion looks at every descendant)
.decl ruf012_demand_plain_default(n: node)
ruf012_demand_plain_default(p9) :- ruf012_demand_plain_default(n), child(p9, n, _),
    kind(p9, "parenthesized_expression").
ruf012_demand_plain_default(n) :- ruf012_mutable_expression(n).

// demand_copy_class: the nodes copy_class is asked at (its recursion looks at every descendant)
.decl ruf012_demand_copy_class(n: node)
ruf012_demand_copy_class(c2) :- ruf012_demand_copy_module_class(n), node(_, n, _, _, _), P = n,
    inside(n, p1, "module"), within_stop(c2, p1, ruf012_stop_28),
    kind(c2, "class_definition"), field(c2, "name", c3), node(_, c3, _, _, _), P = c3.
ruf012_demand_copy_class(p7) :- field(p1, "right", n), kind(p1, "assignment"),
    child(p1, c2, _), kind(c2, "type"), child(p5, p1, _),
    kind(p5, "expression_statement"), child(p6, p5, _), kind(p6, "block"),
    field(p7, "body", p6), kind(p7, "class_definition").
ruf012_demand_copy_class(p8) :- ruf012_demand_plain_default(n), field(p1, "right", n),
    kind(p1, "assignment"), within_stop(p1, p6, "expression_statement"),
    kind(p6, "expression_statement"), child(p7, p6, _), kind(p7, "block"),
    field(p8, "body", p7), kind(p8, "class_definition").

// demand_copy_module_class: the nodes copy_module_class is asked at (its recursion looks at every descendant)
.decl ruf012_demand_copy_module_class(n: node)
ruf012_demand_copy_module_class(n) :- ruf012_demand_copy_ref(n), kind(n, "identifier"), node(_, n, _, _, _), B = n.

// demand_copy_ref: the nodes copy_ref is asked at (its recursion looks at every descendant)
.decl ruf012_demand_copy_ref(n: node)
ruf012_demand_copy_ref(c2) :- ruf012_demand_copy_ref(n), kind(n, "subscript"), field(n, "value", c2).
ruf012_demand_copy_ref(c3) :- ruf012_demand_copy_ref(n), kind(n, "parenthesized_expression"),
    child(n, c3, _).
ruf012_demand_copy_ref(c2) :- ruf012_demand_copy_class(n), kind(n, "class_definition"),
    field(n, "superclasses", c1), child(c1, c2, _).

// demand_ctypes_class: the nodes ctypes_class is asked at (its recursion looks at every descendant)
.decl ruf012_demand_ctypes_class(n: node)
ruf012_demand_ctypes_class(c2) :- ruf012_demand_ctypes_module_class(n), node(_, n, _, _, _), P = n,
    inside(n, p1, "module"), within_stop(c2, p1, ruf012_stop_28),
    kind(c2, "class_definition"), field(c2, "name", c3), node(_, c3, _, _, _), P = c3.
ruf012_demand_ctypes_class(p6) :- kind(n, "expression_statement"), child(n, c1, _),
    kind(c1, "assignment"), field(c1, "left", c3), kind(c3, "identifier"),
    glob("_fields_", c3), field(c1, "right", c4), ruf012_assigned_mutable(c4),
    child(p5, n, _), kind(p5, "block"), field(p6, "body", p5),
    kind(p6, "class_definition").

// demand_ctypes_module_class: the nodes ctypes_module_class is asked at (its recursion looks at every descendant)
.decl ruf012_demand_ctypes_module_class(n: node)
ruf012_demand_ctypes_module_class(n) :- ruf012_demand_ctypes_ref(n), kind(n, "identifier"), node(_, n, _, _, _), B = n.

// demand_ctypes_ref: the nodes ctypes_ref is asked at (its recursion looks at every descendant)
.decl ruf012_demand_ctypes_ref(n: node)
ruf012_demand_ctypes_ref(c2) :- ruf012_demand_ctypes_ref(n), kind(n, "subscript"),
    field(n, "value", c2).
ruf012_demand_ctypes_ref(c3) :- ruf012_demand_ctypes_ref(n), kind(n, "parenthesized_expression"),
    child(n, c3, _).
ruf012_demand_ctypes_ref(c2) :- ruf012_demand_ctypes_class(n), kind(n, "class_definition"),
    field(n, "superclasses", c1), child(c1, c2, _).

// demand_class_var_import_follows: the nodes class_var_import_follows is asked at (it looks at every ancestor of every node)
.decl ruf012_demand_class_var_import_follows(n: node)
ruf012_demand_class_var_import_follows(n) :- kind(n, "identifier"), glob("ClassVar", n),
    docof(n, d3), modnode(d3, m4).

// demand_final_import_follows: the nodes final_import_follows is asked at (it looks at every ancestor of every node)
.decl ruf012_demand_final_import_follows(n: node)
ruf012_demand_final_import_follows(n) :- kind(n, "identifier"), glob("Final", n),
    docof(n, d3), modnode(d3, m4).

