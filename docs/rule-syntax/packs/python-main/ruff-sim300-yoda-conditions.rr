.policy "ruff-sim300-yoda-conditions" revision 2
.guests off
.description "Put the variable first and the constant or literal second in comparisons, avoiding Yoda conditions; it reads the way you would say it."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// SIM300(n): a finding at node n, from clause `yoda-conditions`.
// Each rule below is one way the JSON `rule` can match.
.violation SIM300(at: node) "Put the variable first; reverse `<`/`>` and `<=`/`>=` when swapping operands, and keep equality operators unchanged."
    suppress noqa "SIM300"
SIM300(n) :- sim300_single_op(n),
    ( child(n, c1, _), sim300_left(c1), sim300_definitely(c1), child(n, c2, _), sim300_right(c2), !sim300_definitely(c2)
    ; child(n, c3, _), sim300_left(c3), sim300_probably(c3), child(n, c4, _), sim300_right(c4), !sim300_probably(c4)
    ).


// part_t(n): the JSON util `part-t`, used where the JSON says `matches: "part-t"`
.decl sim300_part_t(n: node)
sim300_part_t(n) :- child(n, c1, _), kind(c1, "string_start"), match("[A-Za-z]*[tT].*", c1).

// part_f(n): the JSON util `part-f`, used where the JSON says `matches: "part-f"`
.decl sim300_part_f(n: node)
sim300_part_f(n) :- child(n, c1, _), kind(c1, "string_start"), match("[A-Za-z]*[fF].*", c1).

// t_string(n): the JSON util `t-string`, used where the JSON says `matches: "t-string"`
.decl sim300_t_string(n: node)
sim300_t_string(n) :- kind(n, "string"), sim300_part_t(n).
sim300_t_string(n) :- kind(n, "concatenated_string"), child(n, c1, _), kind(c1, "string"),
    sim300_part_t(c1).

// f_string(n): the JSON util `f-string`, used where the JSON says `matches: "f-string"`
.decl sim300_f_string(n: node)
sim300_f_string(n) :- !sim300_t_string(n),
    ( kind(n, "string"), sim300_part_f(n)
    ; kind(n, "concatenated_string"), child(n, c1, _), kind(c1, "string"), sim300_part_f(c1)
    ).


// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl sim300_plain_string(n: node)
sim300_plain_string(n) :- (kind(n, "string") ; kind(n, "concatenated_string")), !sim300_alt_2(n).

// literal(n): the JSON util `literal`, used where the JSON says `matches: "literal"`
.decl sim300_literal(n: node)
sim300_literal(n) :- kind(n, k1), sim300_set_3(k1).
sim300_literal(n) :- sim300_plain_string(n).

// definitely(n): the JSON util `definitely`, used where the JSON says `matches: "definitely"`
.decl sim300_definitely(n: node)
sim300_definitely(n) :- sim300_definitely_u7(n).

// probably(n): the JSON util `probably`, used where the JSON says `matches: "probably"`
.decl sim300_probably(n: node)
sim300_probably(n) :- sim300_probably_u7(n).

// single_op(n): the JSON util `single-op`, used where the JSON says `matches: "single-op"`
.decl sim300_single_op(n: node)
sim300_single_op(n) :- kind(n, "comparison_operator"), sim300_tok_has_2(n),
    k17 = count : { sim300_tok_has_3(n) }, k17 <= 1.

// left(n): the JSON util `left`, used where the JSON says `matches: "left"`
.decl sim300_left(n: node)
sim300_left(n) :- node(_, n, _, _, _), !sim300_tok_follows_4(n).

// right(n): the JSON util `right`, used where the JSON says `matches: "right"`
.decl sim300_right(n: node)
sim300_right(n) :- node(_, n, _, _, _), !sim300_tok_precedes_5(n).

