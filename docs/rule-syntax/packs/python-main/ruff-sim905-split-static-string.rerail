sim905_tok_follows_23(n) :- next_sibling(s28, n), glob("(", s28).
sim905_tok_follows_23(n) :- structural_before(n, g30), match("\\s*", g30), child(p31, n, _),
    node(_, n, _, st33, _), o32 = st33 - strlen(g30), token(p31, _, t29, _, o32),
    match("\\(", t29).
sim905_tok_follows_23(n) :- structural_before(n, g30), match("(?s)^(?:.*(?:\\()\\s*)$", g30).

// tok_follows_24(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\($": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim905_tok_follows_24(n: node)
.stored sim905_tok_follows_24 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim905_tok_follows_24(n) :- next_sibling(s36, n), glob("(", s36).
sim905_tok_follows_24(n) :- structural_before(n, g38), match("\\s*", g38), child(p39, n, _),
    node(_, n, _, st41, _), o40 = st41 - strlen(g38), token(p39, _, t37, _, o40),
    match("\\(", t37).
sim905_tok_follows_24(n) :- structural_before(n, g38), match("(?s)^(?:.*(?:\\()\\s*)$", g38).

// part_case: one row per relation folded into part: its key, then the strings that differed.
.decl sim905_part_case(key: symbol, s1: symbol)
sim905_part_case("b", "[A-Za-z]*[bB].*"). sim905_part_case("f", "[A-Za-z]*[fF].*").
sim905_part_case("t", "[A-Za-z]*[tT].*").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl sim905_alt_2(n: node)
sim905_alt_2(n) :- sim905_t_string(n).
sim905_alt_2(n) :- sim905_f_string(n).

// stop_10(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl sim905_stop_10(n: node)
sim905_stop_10(n) :- node(_, n, _, _, _), !kind(n, "comment").

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl sim905_alt_11(n: node)
sim905_alt_11(n) :-
    ( kind(n, "keyword_argument")
    ; kind(n, "list_splat")
    ; kind(n, "dictionary_splat")
    ; kind(n, "comment")
    ).

sim905_alt_11(n) :- node(_, n, _, _, _), glob("[\\[\\](){},]", n).

// alt_16(n): the JSON `any`: n matches if any one of these rules does
.decl sim905_alt_16(n: node)
sim905_alt_16(n) :- child(n, c1, _), !sim905_alt_11(c1), precedes_stop(s2, c1, sim905_stop_10),
    glob("\\,", s2), precedes_stop(s3, s2, sim905_stop_10), !sim905_alt_11(s3), sim905_tok_follows_9(s3),
    sim905_maxsplit(c1).
sim905_alt_16(n) :- node(_, n, _, _, _),
    count : { child(n, c11, _), !sim905_alt_11(c11), sim905_stop_10_precedes(s12, c11), glob("\\,", s12), sim905_stop_10_precedes(s13, s12), !sim905_alt_11(s13), sim905_tok_follows_10(s13) } = 0.

// alt_53(n): the JSON `any`: n matches if any one of these rules does
.decl sim905_alt_53(n: node)
sim905_alt_53(n) :- child(n, c1, _), !sim905_alt_11(c1), sim905_tok_follows_21(c1), sim905_sep(c1).
sim905_alt_53(n) :- node(_, n, _, _, _),
    count : { child(n, c9, _), !sim905_alt_11(c9), sim905_tok_follows_22(c9) } = 0.

// stop_10_precedes: precedes_stop over the stop set stop_10, read inside an aggregate
.decl sim905_stop_10_precedes(a: node, b: node)
sim905_stop_10_precedes(x, y) :- precedes_stop(x, y, sim905_stop_10).
