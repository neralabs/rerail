// tok_follows_21(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\($": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim905_tok_follows_21(n: node)
.stored sim905_tok_follows_21 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim905_tok_follows_21(n) :- next_sibling(s2, n), glob("(", s2).
sim905_tok_follows_21(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("\\(", t3).
sim905_tok_follows_21(n) :- structural_before(n, g4), match("(?s)^(?:.*(?:\\()\\s*)$", g4).

// tok_follows_22(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\($": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim905_tok_follows_22(n: node)
.stored sim905_tok_follows_22 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim905_tok_follows_22(n) :- next_sibling(s10, n), glob("(", s10).
sim905_tok_follows_22(n) :- structural_before(n, g12), match("\\s*", g12), child(p13, n, _),
    node(_, n, _, st15, _), o14 = st15 - strlen(g12), token(p13, _, t11, _, o14),
    match("\\(", t11).
sim905_tok_follows_22(n) :- structural_before(n, g12), match("(?s)^(?:.*(?:\\()\\s*)$", g12).

// tok_follows_23(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\($": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim905_tok_follows_23(n: node)
