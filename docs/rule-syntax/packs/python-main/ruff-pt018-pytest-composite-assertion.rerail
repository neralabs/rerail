.policy "ruff-pt018-pytest-composite-assertion" revision 1
.description "Split an assert that joins conditions with and, or negates conditions joined with or, into one assert per condition; a failure then names the one that failed."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

// PT018(n): a finding at node n, from clause `pytest-composite-assertion`.
// Each rule below is one way the JSON `rule` can match.
.violation PT018(at: node) "Break this assertion into one `assert` per condition so a failure shows which one failed; for `not (a or b)`, write `assert not a` and `assert not b`."
    suppress noqa "PT018"
PT018(n) :- kind(n, "assert_statement"), child(n, c1, _), pt018_test(c1), pt018_composite(c1).

// test(n): the JSON util `test`, used where the JSON says `matches: "test"`
.decl pt018_test(n: node)
pt018_test(n) :- precedes_stop(s1, n, pt018_stop_1), glob("assert", s1).

// bool_op_and(n): the JSON util `bool-op-and`, used where the JSON says `matches: "bool-op-and"`
.decl pt018_bool_op_and(n: node)
pt018_bool_op_and(n) :- kind(n, "boolean_operator"), pt018_tok_has_1(n).
pt018_bool_op_and(n) :- kind(n, "parenthesized_expression"), child(n, c9, _),
    pt018_bool_op_and(c9).

// bool_op_or(n): the JSON util `bool-op-or`, used where the JSON says `matches: "bool-op-or"`
.decl pt018_bool_op_or(n: node)
pt018_bool_op_or(n) :- kind(n, "boolean_operator"), pt018_tok_has_2(n).
pt018_bool_op_or(n) :- kind(n, "parenthesized_expression"), child(n, c9, _), pt018_bool_op_or(c9).

// composite(n): the JSON util `composite`, used where the JSON says `matches: "composite"`
.decl pt018_composite(n: node)
pt018_composite(n) :- pt018_bool_op_and(n).
pt018_composite(n) :- kind(n, "not_operator"), field(n, "argument", c1), pt018_bool_op_or(c1).
pt018_composite(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), pt018_composite(c2).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^and$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pt018_tok_has_1(n: node)
.stored pt018_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt018_tok_has_1(n) :- field(n, "operator", c1), glob("and", c1).
pt018_tok_has_1(n) :- op(n, t2), match("and", t2).
pt018_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:and)(?:\\W.*)?)$", g3).
pt018_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:and)(?:\\W.*)?)$", g3).
pt018_tok_has_1(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:and)(?:\\W.*)?)$", g3).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^or$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pt018_tok_has_2(n: node)
.stored pt018_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt018_tok_has_2(n) :- field(n, "operator", c1), glob("or", c1).
pt018_tok_has_2(n) :- op(n, t2), match("or", t2).
pt018_tok_has_2(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:or)(?:\\W.*)?)$", g3).
pt018_tok_has_2(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:or)(?:\\W.*)?)$", g3).
pt018_tok_has_2(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:or)(?:\\W.*)?)$", g3).

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl pt018_stop_1(n: node)
pt018_stop_1(n) :- node(_, n, _, _, _), !kind(n, "comment"), !kind(n, "line_continuation").
