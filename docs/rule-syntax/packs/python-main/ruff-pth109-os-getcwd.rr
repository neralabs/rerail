// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pth109_alt_1(n: node)
pth109_alt_1(n) :- pth109_tok_follows_1(n).
pth109_alt_1(n) :- pth109_tok_precedes_2(n), child(p15, n, _), kind(p15, "keyword_argument").

