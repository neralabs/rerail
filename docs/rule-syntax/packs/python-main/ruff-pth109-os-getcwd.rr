// arg_name_os_getcwdb(n): the JSON util `arg-name`, used where the JSON says `matches: "arg-name"`
.decl pth109_arg_name_os_getcwdb(n: node)
pth109_arg_name_os_getcwdb(n) :- kind(n, "identifier"), !pth109_alt_1(n).

