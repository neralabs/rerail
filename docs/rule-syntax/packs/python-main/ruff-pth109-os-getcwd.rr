// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pth109_alt_3(n: node)
pth109_alt_3(n) :- kind(n, "concatenated_string").
pth109_alt_3(n) :- kind(n, "string"), has(n, c1, "escape_sequence").

