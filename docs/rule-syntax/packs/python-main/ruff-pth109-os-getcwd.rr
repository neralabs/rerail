.decl pth109_alt_5(n: node, f: loc)
pth109_alt_5(n, F) :- pth109_ann_call(n, F), child(n, c1, _), pth109_callee(c1, F), pth109_alt_10(c1),
    count : { child(n, c10, _), pth109_ann_args(c10), within(c11, c10), pth109_arg_name(c11), count : { node(_, c11, _, _, _), H = c11 } = 0 } = 0.
