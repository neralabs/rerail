.decl pth109_ann_string_os_getcwdb(n: node, f: loc)
pth109_ann_string_os_getcwdb(n, F) :- kind(n, "string"),
    count : { has(n, c1, "escape_sequence"), node(_, c1, _, _, _) } = 0,
    parsed(n, "annotation", r2), within(c3, r2), pth109_alt_8(c3, F).
pth109_ann_string_os_getcwdb(n, F) :- pth109_alt_3(n), parsed(n, "annotation", r5), within(c6, r5),
