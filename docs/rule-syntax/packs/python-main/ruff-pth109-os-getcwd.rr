pth109_tok_precedes_2(n) :- next_sibling(n, s8), glob("=", s8).
pth109_tok_precedes_2(n) :- structural_after(n, g10), match("\\s*", g10), child(p11, n, _),
    node(_, n, _, _, en14), o12 = en14 + strlen(g10), token(p11, _, t9, o12, _),
    match("=", t9).
pth109_tok_precedes_2(n) :- structural_after(n, g10),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g10).

