.policy "ruff-pth109-os-getcwd" revision 1
.guests off
.description "Use Path.cwd() instead of os.getcwd() or os.getcwdb(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PTH109(n, detail): findings from clauses `os-getcwd`, `os-getcwdb`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PTH109(at: node, f: node, detail: symbol) "Use `Path.cwd()` from pathlib instead of {detail} is required."
    suppress noqa "PTH109"
PTH109(F, n, "`os.getcwd()`; it returns a `Path`, so wrap it in `str()` or adjust the code where a string") :- kind(n, "call"),
    field(n, "function", c1), pth109_callee(c1, F).
PTH109(F, n, "`os.getcwd()`; it returns a `Path`, so wrap it in `str()` or adjust the code where a string") :- pth109_ann_string(n, F).
PTH109(F, n, "`os.getcwdb()`; it returns a `Path`, not bytes, so leave it where a bytes value") :- kind(n, "call"),
    field(n, "function", c1), pth109_callee_os_getcwdb(c1, F).
PTH109(F, n, "`os.getcwdb()`; it returns a `Path`, not bytes, so leave it where a bytes value") :- pth109_ann_string_os_getcwdb(n, F).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl pth109_target(n: node)
pth109_target(n) :- (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, "os.getcwd").

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   F: metavariable this relation binds for the calling rule
.decl pth109_callee(n: node, f: loc)
pth109_callee(n, F) :- pth109_target(n), node(_, n, _, _, _), F = n.
pth109_callee(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth109_callee(c1, F).

// ann_args(n): the JSON util `ann-args`, used where the JSON says `matches: "ann-args"`
.decl pth109_ann_args(n: node)
pth109_ann_args(n) :- (kind(n, "argument_list") ; kind(n, "generator_expression")).

// ann_call(n): the JSON util `ann-call`, used where the JSON says `matches: "ann-call"`
//   F: metavariable this relation binds for the calling rule
.decl pth109_ann_call(n: node, f: loc)
pth109_ann_call(n, F) :- kind(n, "call"), child(n, c1, _), pth109_callee(c1, F),
    next_sibling(c1, s2), pth109_ann_args(s2).

// arg_name(n): the JSON util `arg-name`, used where the JSON says `matches: "arg-name"`
.decl pth109_arg_name(n: node)
pth109_arg_name(n) :- kind(n, "identifier"), !pth109_alt_1(n).

// ann_string(n): the JSON util `ann-string`, used where the JSON says `matches: "ann-string"`
//   F: metavariable this relation binds for the calling rule
.decl pth109_ann_string(n: node, f: loc)
pth109_ann_string(n, F) :- kind(n, "string"),
    count : { has(n, c1, "escape_sequence"), node(_, c1, _, _, _) } = 0,
    parsed(n, "annotation", r2), within(c3, r2), pth109_alt_2(c3, F).
pth109_ann_string(n, F) :- pth109_alt_3(n), parsed(n, "annotation", r5), within(c6, r5),
    pth109_alt_5(c6, F).

// target_os_getcwdb(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl pth109_target_os_getcwdb(n: node)
pth109_target_os_getcwdb(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "os.getcwdb").

// callee_os_getcwdb(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   F: metavariable this relation binds for the calling rule
.decl pth109_callee_os_getcwdb(n: node, f: loc)
pth109_callee_os_getcwdb(n, F) :- pth109_target_os_getcwdb(n), node(_, n, _, _, _), F = n.
pth109_callee_os_getcwdb(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pth109_callee_os_getcwdb(c1, F).

// ann_args_os_getcwdb(n): the JSON util `ann-args`, used where the JSON says `matches: "ann-args"`
.decl pth109_ann_args_os_getcwdb(n: node)
pth109_ann_args_os_getcwdb(n) :- (kind(n, "argument_list") ; kind(n, "generator_expression")).

// ann_call_os_getcwdb(n): the JSON util `ann-call`, used where the JSON says `matches: "ann-call"`
//   F: metavariable this relation binds for the calling rule
.decl pth109_ann_call_os_getcwdb(n: node, f: loc)
pth109_ann_call_os_getcwdb(n, F) :- kind(n, "call"), child(n, c1, _),
