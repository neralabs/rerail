.policy "ruff-f702-continue-outside-loop" revision 1
.guests off
.description "Keep continue inside a for or while loop body; outside one (including a loop's else block) it is a Python syntax error."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// F702(n): a finding at node n, from clause `continue-outside-loop`.
// Each rule below is one way the JSON `rule` can match.
.violation F702(at: node) "`continue` not properly in loop"
    suppress noqa "F702"
F702(n) :- kind(n, "continue_statement"),
    count : { f702_stop_1_within(n, p1), kind(p1, "block"), child(p2, p1, _), (kind(p2, "for_statement") ; kind(p2, "while_statement")) } = 0.

// stop_1: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl f702_stop_1(kind: symbol)
f702_stop_1("function_definition"). f702_stop_1("class_definition").

// stop_1_within: within_stop over the stop set stop_1, read inside an aggregate
.decl f702_stop_1_within(n: node, a: node)
f702_stop_1_within(x, y) :- within_stop(x, y, f702_stop_1).
