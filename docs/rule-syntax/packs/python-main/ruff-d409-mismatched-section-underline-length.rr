// alt_25(n): the JSON `any`: n matches if any one of these rules does
.decl d409_alt_25(n: node)
d409_alt_25(n) :- d409_args_header_family(n, "google_only_header_underline_length_google"),
    !d409_args_header_family(n, "numpy_only_header_underline_length_google").
d409_alt_25(n) :- d409_args_header_family(n, "google_only_headers_2_underline_length_google"),
    !d409_args_header_family(n, "numpy_only_headers_2_underline_length_google").

// alt_26(n): the JSON `any`: n matches if any one of these rules does
.decl d409_alt_26(n: node)
d409_alt_26(n) :-
