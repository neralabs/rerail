    ; d409_args_header_family(n, "numpy_only_headers_2_underline_length_google"), !d409_args_header_family(n, "google_only_headers_2_underline_length_google")
    ).

d409_alt_26(n) :- !d409_alt_25(n), d409_underline_before_colon_underline_length_google(n).

