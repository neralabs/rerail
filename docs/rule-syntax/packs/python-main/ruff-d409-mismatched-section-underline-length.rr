.policy "ruff-d409-mismatched-section-underline-length" revision 1
.guests off
.description "Make a section underline exactly as long as the section name above it."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// D409(n): findings from clauses `underline-length-shared`, `underline-length-numpy`, `underline-length-google`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation D409(at: node, name: node) "Make this underline exactly as many dashes as the section name above it has characters."
    suppress noqa "D409"
D409(NAME, n) :- kind(n, "string_content"), child(p1, n, _), d409_docstring_of(p1),
    count : { value(p1, v2), match("(?s:.*)\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[ \\t]*(?:\\n|\\z)(?s:.*)", v2) } = 0,
    d409_alt_4(n, NAME).
D409(NAME, n) :- kind(n, "string_content"), d409_numpy_style(n), child(p1, n, _),
    d409_docstring_of(p1),
    count : { value(p1, v2), match("(?s:.*)\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:extended summary|other parameters|short summary|other params|parameters|receives):?[ \\t]*(?:\\n|\\z)(?s:.*)", v2) } = 0,
    d409_alt_20(n, NAME).
D409(NAME, n) :- kind(n, "string_content"), !d409_numpy_style_underline_length_google(n),
    child(p1, n, _), d409_docstring_of(p1),
    count : { value(p1, v2), match("(?s:.*)\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:keyword arguments|other arguments|keyword args|other args|arguments|attention|important|caution|example|warning|danger|return|error|yield|args|hint|note|todo|tip):?[ \\t]*(?:\\n|\\z)(?s:.*)", v2) } = 0,
    d409_alt_36(n, NAME).

// docstring_of(n): 3 identical copies of one rule set (`docstring`, `docstring`, `docstring`), folded into one.
.decl d409_docstring_of(n: node)
d409_docstring_of(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0,
    within_stop(n, p2, d409_stop_1), kind(p2, "expression_statement"), !d409_alt_2(p2),
    child(p12, p2, _),
    ( kind(p12, "module")
    ; kind(p12, "block"), child(p1, p12, _), (kind(p1, "function_definition") ; kind(p1, "class_definition"))
    ).


// numpy_style(n): the JSON util `numpy-style`, used where the JSON says `matches: "numpy-style"`
.decl d409_numpy_style(n: node)
d409_numpy_style(n) :- kind(n, "string_content"),
    ( d409_args_header_family(n, "params_header")
    ; !d409_args_header_family(n, "args_header"), d409_alt_10(n)
    ).


// args_header_family(n, key): 12 copies of one rule set (`args-header`, `args-header`, `google-only-header` and 9 more), folded into one: row `key` of
// args_header_family_case gives the strings each copy had.
.decl d409_args_header_family(n: node, key: symbol)
d409_args_header_family(n, q1) :- d409_args_header_family_case(q1, s1),
    kind(n, "string_content"), match(s1, n).

// underline_before_colon(n): the JSON util `underline-before-colon`, used where the JSON says `matches: "underline-before-colon"`
.decl d409_underline_before_colon(n: node)
d409_underline_before_colon(n) :- kind(n, "string_content"), d409_alt_19(n).

// numpy_style_underline_length_google(n): the JSON util `numpy-style`, used where the JSON says `matches: "numpy-style"`
.decl d409_numpy_style_underline_length_google(n: node)
d409_numpy_style_underline_length_google(n) :- kind(n, "string_content"),
    ( d409_args_header_family(n, "params_header_underline_length_google")
    ; !d409_args_header_family(n, "args_header_underline_length_google"), d409_alt_26(n)
    ).


// underline_before_colon_underline_length_google(n): the JSON util `underline-before-colon`, used where the JSON says `matches: "underline-before-colon"`
.decl d409_underline_before_colon_underline_length_google(n: node)
d409_underline_before_colon_underline_length_google(n) :- kind(n, "string_content"),
    d409_alt_19(n).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d409_tok_has_1(n: node)
.stored d409_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d409_tok_has_1(n) :- child(n, c3, _), glob("\\,", c3).
d409_tok_has_1(n) :- op(n, t4), match(",", t4).
d409_tok_has_1(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
d409_tok_has_1(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
d409_tok_has_1(n) :- node_text(n, g5), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g5).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d409_tok_has_2(n: node)
.stored d409_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d409_tok_has_2(n) :- child(n, c1, _), glob("\\,", c1).
d409_tok_has_2(n) :- op(n, t2), match(",", t2).
d409_tok_has_2(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d409_tok_has_2(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d409_tok_has_2(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// args_header_family_case: one row per relation folded into args_header_family: its key, then the strings that differed.
.decl d409_args_header_family_case(key: symbol, s1: symbol)
d409_args_header_family_case("args_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:rguments|rgs)|K(?i:eyword arguments|eyword args)|O(?i:ther arguments|ther args)):?[^\\S\\n]*(?m:$))(?s:.*)").
d409_args_header_family_case("args_header_underline_length_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:rguments|rgs)|K(?i:eyword arguments|eyword args)|O(?i:ther arguments|ther args)):?[^\\S\\n]*(?m:$))(?s:.*)").
d409_args_header_family_case("google_only_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)").
d409_args_header_family_case("google_only_header_underline_length_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)").
d409_args_header_family_case("google_only_headers_2", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*)").
d409_args_header_family_case("google_only_headers_2_underline_length_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*)").
d409_args_header_family_case("numpy_only_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)").
d409_args_header_family_case("numpy_only_header_underline_length_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)").
d409_args_header_family_case("numpy_only_headers_2", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)(?s:.*)").
d409_args_header_family_case("numpy_only_headers_2_underline_length_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)(?s:.*)").
d409_args_header_family_case("params_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:O(?i:ther parameters|ther params)|P(?i:arameters)):?[^\\S\\n]*(?m:$))(?s:.*)").
d409_args_header_family_case("params_header_underline_length_google", "(?s:.*)(?:\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:O(?i:ther parameters|ther params)|P(?i:arameters)):?[^\\S\\n]*(?m:$))(?s:.*)").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl d409_stop_1(n: node)
d409_stop_1(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl d409_alt_2(n: node)
d409_alt_2(n) :- d409_tok_has_2(n).
d409_alt_2(n) :- precedes(s9, n), !kind(s9, "comment").

// alt_4(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl d409_alt_4(n: node, name: loc)
d409_alt_4(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:\\n[^\\S\\n]*(?i:notes|warns):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:notes|warns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:N(?i:otes)|W(?i:arns)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,4}|-{6,}))[^\\S\\n]*(?m:$)(?s:.*)", n).
d409_alt_4(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:\\n[^\\S\\n]*(?i:raises|yields):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:raises|yields):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:R(?i:aises)|Y(?i:ields)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,5}|-{7,}))[^\\S\\n]*(?m:$)(?s:.*)", n).
d409_alt_4(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:\\n[^\\S\\n]*(?i:methods|returns):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:methods|returns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:M(?i:ethods)|R(?i:eturns)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,6}|-{8,}))[^\\S\\n]*(?m:$)(?s:.*)", n).
d409_alt_4(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:\\n[^\\S\\n]*(?i:examples|see also|warnings):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:examples|see also|warnings):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xamples)|S(?i:ee also)|W(?i:arnings)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,7}|-{9,}))[^\\S\\n]*(?m:$)(?s:.*)", n).
d409_alt_4(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:\\n[^\\S\\n]*(?i:attributes|references):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:attributes|references):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttributes)|R(?i:eferences)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,9}|-{11,}))[^\\S\\n]*(?m:$)(?s:.*)", n).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
.decl d409_alt_12(n: node)
d409_alt_12(n) :- d409_args_header_family(n, "google_only_header"),
    !d409_args_header_family(n, "numpy_only_header").
d409_alt_12(n) :- d409_args_header_family(n, "google_only_headers_2"),
    !d409_args_header_family(n, "numpy_only_headers_2").

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl d409_alt_10(n: node)
d409_alt_10(n) :-
    ( d409_args_header_family(n, "numpy_only_header"), !d409_args_header_family(n, "google_only_header")
    ; d409_args_header_family(n, "numpy_only_headers_2"), !d409_args_header_family(n, "google_only_headers_2")
    ).

d409_alt_10(n) :- !d409_alt_12(n), d409_underline_before_colon(n).

// alt_19(n): the JSON `any`: n matches if any one of these rules does
.decl d409_alt_19(n: node)
d409_alt_19(n) :- node(_, n, _, _, _),
    !match("(?s:.*)(?:(?m:^)[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):[^\\S\\n]*(?m:$)(?:\\z|\\n[^\\S\\n]*(?m:$)|\\n[^\\S\\n]*(?:[^\\s\\-]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])))(?s:.*)", n).
d409_alt_19(n) :- node(_, n, _, _, _),
    match("(?s)(?s:.*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*-+[^\\S\\n]*(?m:$).*?(?:(?m:^)[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):[^\\S\\n]*(?m:$)(?:\\z|\\n[^\\S\\n]*(?m:$)|\\n[^\\S\\n]*(?:[^\\s\\-]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])))(?s:.*)", n).

// alt_20(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl d409_alt_20(n: node, name: loc)
d409_alt_20(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:\\n[^\\S\\n]*(?i:receives):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:receives):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:R(?i:eceives)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,7}|-{9,}))[^\\S\\n]*(?m:$)(?s:.*)", n).
d409_alt_20(n, NAME) :- node(_, n, _, _, _),
