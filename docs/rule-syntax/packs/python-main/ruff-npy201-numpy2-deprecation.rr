NPY201_chararray(n, NAME) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "numpy.chararray"), node(_, n, _, _, _), NAME = n, !npy201_fallback(n, NEW), text(NAME, t1),
    NEW = @replace_all(t1, "[\\s\\S]+", "chararray").

// NPY201_format_parser(n): a finding at node n, from clause `format-parser`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `transform` computes NEW from other metavariables' text; its literals end each rule.
.violation NPY201_format_parser(at: node, name: loc) code "NPY201" "Use `numpy.rec.format_parser` instead of `{name}`; NumPy 2.0 removes the old name and this one also works on NumPy 1.x."
    suppress noqa "NPY201"
NPY201_format_parser(n, NAME) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "numpy.format_parser"), node(_, n, _, _, _), NAME = n, !npy201_fallback(n, NEW), text(NAME, t1),
    NEW = @replace_all(t1, "[\\s\\S]+", "format_parser").

// NPY201_string_annotation_or_pattern(n): a finding at node n, from clause `string-annotation-or-pattern`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation NPY201_string_annotation_or_pattern(at: node, name: node) code "NPY201" "NumPy 2.0 removes `{name}`; switch to the replacement NumPy's 2.0 migration guide gives for it (e.g. `np.float64` for `float_`, `np.inf` for `Inf`), or drop it if there is none."
    suppress noqa "NPY201"
NPY201_string_annotation_or_pattern(NAME, n) :- npy201_alt_10(n, NAME), !npy201_any_fallback(n).

// reference(n): the JSON util `reference`, used where the JSON says `matches: "reference"`
.decl npy201_reference(n: node)
npy201_reference(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), npy201_set_7(q1).

// in_string(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   NAME: metavariable this relation binds for the calling rule
.decl npy201_in_string(n: node, name: loc)
npy201_in_string(n, NAME) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), npy201_alt_8(c2, NAME).

// pattern_name(n): the JSON util `pattern-name`, used where the JSON says `matches: "pattern-name"`
.decl npy201_pattern_name(n: node)
npy201_pattern_name(n) :- kind(n, "dotted_name"),
    match("\\w+\\s*\\.\\s*(?:add_docstring|add_newdoc|add_newdoc_ufunc|alltrue|asfarray|byte_bounds|cast|cfloat|clongfloat|compat|complex_|cumproduct|DataSource|deprecate|deprecate_with_doc|disp|fastCopyAndTranspose|find_common_type|get_array_wrap|float_|geterrobj|in1d|INF|Inf|Infinity|infty|issctype|issubclass_|issubsctype|mat|maximum_sctype|NaN|NAN|nbytes|NINF|NZERO|longcomplex|longfloat|lookfor|obj2sctype|PINF|product|PZERO|recfromcsv|recfromtxt|round_|safe_eval|sctype2char|sctypes|seterrobj|set_string_function|singlecomplex|string_|sometrue|source|tracemalloc_domain|trapz|unicode_|who|row_stack|AxisError|ComplexWarning|DTypePromotionError|ModuleDeprecationWarning|RankWarning|TooHardError|VisibleDeprecationWarning|compare_chararrays|chararray|format_parser)", n),
    inside(n, p1, "case_pattern"), child(n, c2, _), kind(c2, "identifier"),
    sym_of(c2, "numpy").

// any_fallback(n): the JSON util `any-fallback`, used where the JSON says `matches: "any-fallback"`
.decl npy201_any_fallback(n: node)
npy201_any_fallback(n) :- npy201_in_handler(n), npy201_up_2(n, p1), field(p1, "body", c2),
    has(c2, c3, "attribute"), sym_of(c3, q4), npy201_set_4(q4).

// from_module: the module text of from-import s, read as `relative: "text"` does (dots dropped)
.decl npy201_from_module(s: node, m: symbol)
npy201_from_module(s, m) :- kind(s, "future_import_statement"), m = "__future__".
npy201_from_module(s, m) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "dotted_name"), name(x, m).
npy201_from_module(s, m) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "relative_import"), child(x, y, _), kind(y, "dotted_name"), name(y, m).
npy201_from_module(s, "") :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "relative_import"), count : { child(x, y, _), kind(y, "dotted_name") } = 0.

// statement_name: dotted name n in an import statement imports q (relative modules by their text)
.decl npy201_statement_name(n: node, q: symbol)
npy201_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    kind(s, "import_statement"), name(n, q).
npy201_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    kind(s, "relative_import"), name(n, q).
npy201_statement_name(n, q) :- kind(n, "dotted_name"), field(a, "name", n),
    kind(a, "aliased_import"), child(s, a, _), kind(s, "import_statement"), name(n, q).
npy201_statement_name(n, q) :- kind(n, "dotted_name"), field(a, "name", n),
    kind(a, "aliased_import"), child(s, a, _),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    npy201_from_module(s, m), name(n, x), q = @dot(m, x).
npy201_statement_name(n, m) :- kind(n, "dotted_name"), field(s, "module_name", n),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    npy201_from_module(s, m).
npy201_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    !field(s, "module_name", n), npy201_from_module(s, m), name(n, x), q = @dot(m, x).

// demand_in_handler: the nodes in_handler is asked at (it looks at every ancestor of every node)
.decl npy201_demand_in_handler(n: node)
npy201_demand_in_handler(n) :- node(_, NEW, _, _, _), kind(n, "attribute"),
    within_stop(n, p1, "try_statement"), kind(p1, "try_statement"),
    npy201_catches_attribute_error(p1), field(p1, "body", c2), has(c2, c3, "attribute"),
    sym_of(c3, q4), npy201_set_4(q4), field(c3, "attribute", c5), kind(c5, "identifier"),
    node(_, c5, _, _, _), TID = c5, value(TID, t6), value(NEW, t6).
npy201_demand_in_handler(b8) :- node(_, NEW, _, _, _), kind(n, "identifier"), ref_site(n, b8),
    within_stop(b8, p9, "try_statement"), kind(p9, "try_statement"),
    npy201_catches_import_error(p9), field(p9, "body", c10),
    has(c10, c11, "import_from_statement"), has(c11, c12, "dotted_name"),
    npy201_statement_name(c12, q13), node(_, c12, _, _, _), IID = c12, value(IID, t14), value(NEW, t14).
npy201_demand_in_handler(n) :- within_stop(n, p1, "try_statement"), kind(p1, "try_statement"),
    npy201_catches_attribute_error(p1), field(p1, "body", c2), has(c2, c3, "attribute"),
    sym_of(c3, q4), npy201_set_4(q4).

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl npy201_up_1(n: node, p: node)
npy201_up_1(n, p) :- npy201_demand_in_handler(n), within_stop(n, p, npy201_stop_1),
    kind(p, "except_clause").

// up_2(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl npy201_up_2(n: node, p: node)
npy201_up_2(n, p) :- npy201_in_handler(n), within_stop(n, p, "try_statement"),
    kind(p, "try_statement"), npy201_catches_attribute_error(p).

// set_4: symbols from the JSON `resolves.import`
.decl npy201_set_4(v: symbol)
npy201_set_4("ast.literal_eval"). npy201_set_4("inspect.getsource"). npy201_set_4("numpy.all").
npy201_set_4("numpy.any"). npy201_set_4("numpy.asmatrix"). npy201_set_4("numpy.bytes_").
npy201_set_4("numpy.char.chararray"). npy201_set_4("numpy.char.compare_chararrays").
npy201_set_4("numpy.clongdouble"). npy201_set_4("numpy.complex128"). npy201_set_4("numpy.complex64").
npy201_set_4("numpy.cumprod"). npy201_set_4("numpy.exceptions.AxisError").
npy201_set_4("numpy.exceptions.ComplexWarning"). npy201_set_4("numpy.exceptions.DTypePromotionError").
npy201_set_4("numpy.exceptions.ModuleDeprecationWarning").
npy201_set_4("numpy.exceptions.RankWarning"). npy201_set_4("numpy.exceptions.TooHardError").
npy201_set_4("numpy.exceptions.VisibleDeprecationWarning"). npy201_set_4("numpy.float64").
npy201_set_4("numpy.inf"). npy201_set_4("numpy.issubdtype"). npy201_set_4("numpy.lib.add_docstring").
npy201_set_4("numpy.lib.add_newdoc"). npy201_set_4("numpy.lib.array_utils.byte_bounds").
npy201_set_4("numpy.lib.npyio.DataSource"). npy201_set_4("numpy.lib.tracemalloc_domain").
npy201_set_4("numpy.longdouble"). npy201_set_4("numpy.nan"). npy201_set_4("numpy.prod").
npy201_set_4("numpy.rec.format_parser"). npy201_set_4("numpy.round"). npy201_set_4("numpy.str_").
npy201_set_4("numpy.trapezoid"). npy201_set_4("numpy.vstack").

// set_5: symbols from the JSON `resolves.import`
.decl npy201_set_5(v: symbol)
npy201_set_5("numpy.get_array_wrap"). npy201_set_5("numpy.issctype"). npy201_set_5("numpy.maximum_sctype").
npy201_set_5("numpy.obj2sctype"). npy201_set_5("numpy.sctype2char"). npy201_set_5("numpy.sctypes").

// set_6: symbols from the JSON `resolves.import`
.decl npy201_set_6(v: symbol)
npy201_set_6("numpy.INF"). npy201_set_6("numpy.Inf"). npy201_set_6("numpy.Infinity"). npy201_set_6("numpy.infty").
npy201_set_6("numpy.PINF").

// set_7: symbols from the JSON `resolves.import`
.decl npy201_set_7(v: symbol)
npy201_set_7("numpy.add_docstring"). npy201_set_7("numpy.add_newdoc").
npy201_set_7("numpy.add_newdoc_ufunc"). npy201_set_7("numpy.alltrue"). npy201_set_7("numpy.asfarray").
npy201_set_7("numpy.byte_bounds"). npy201_set_7("numpy.cast"). npy201_set_7("numpy.cfloat").
npy201_set_7("numpy.clongfloat"). npy201_set_7("numpy.compat"). npy201_set_7("numpy.complex_").
npy201_set_7("numpy.cumproduct"). npy201_set_7("numpy.DataSource"). npy201_set_7("numpy.deprecate").
npy201_set_7("numpy.deprecate_with_doc"). npy201_set_7("numpy.disp").
npy201_set_7("numpy.fastCopyAndTranspose"). npy201_set_7("numpy.find_common_type").
npy201_set_7("numpy.get_array_wrap"). npy201_set_7("numpy.float_"). npy201_set_7("numpy.geterrobj").
npy201_set_7("numpy.in1d"). npy201_set_7("numpy.INF"). npy201_set_7("numpy.Inf"). npy201_set_7("numpy.Infinity").
npy201_set_7("numpy.infty"). npy201_set_7("numpy.issctype"). npy201_set_7("numpy.issubclass_").
npy201_set_7("numpy.issubsctype"). npy201_set_7("numpy.mat"). npy201_set_7("numpy.maximum_sctype").
npy201_set_7("numpy.NaN"). npy201_set_7("numpy.NAN"). npy201_set_7("numpy.nbytes"). npy201_set_7("numpy.NINF").
npy201_set_7("numpy.NZERO"). npy201_set_7("numpy.longcomplex"). npy201_set_7("numpy.longfloat").
npy201_set_7("numpy.lookfor"). npy201_set_7("numpy.obj2sctype"). npy201_set_7("numpy.PINF").
npy201_set_7("numpy.product"). npy201_set_7("numpy.PZERO"). npy201_set_7("numpy.recfromcsv").
npy201_set_7("numpy.recfromtxt"). npy201_set_7("numpy.round_"). npy201_set_7("numpy.safe_eval").
npy201_set_7("numpy.sctype2char"). npy201_set_7("numpy.sctypes"). npy201_set_7("numpy.seterrobj").
npy201_set_7("numpy.set_string_function"). npy201_set_7("numpy.singlecomplex").
npy201_set_7("numpy.string_"). npy201_set_7("numpy.sometrue"). npy201_set_7("numpy.source").
npy201_set_7("numpy.tracemalloc_domain"). npy201_set_7("numpy.trapz"). npy201_set_7("numpy.unicode_").
npy201_set_7("numpy.who"). npy201_set_7("numpy.row_stack"). npy201_set_7("numpy.AxisError").
npy201_set_7("numpy.ComplexWarning"). npy201_set_7("numpy.DTypePromotionError").
npy201_set_7("numpy.ModuleDeprecationWarning"). npy201_set_7("numpy.RankWarning").
npy201_set_7("numpy.TooHardError"). npy201_set_7("numpy.VisibleDeprecationWarning").
npy201_set_7("numpy.compare_chararrays"). npy201_set_7("numpy.chararray").
npy201_set_7("numpy.format_parser").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl npy201_stop_1(n: node)
npy201_stop_1(n) :- kind(n, "block"), child(p1, n, _),
    (kind(p1, "function_definition") ; kind(p1, "class_definition")).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl npy201_alt_8(n: node, name: loc)
npy201_alt_8(n, NAME) :- npy201_reference(n), NAME = n.
npy201_alt_8(n, NAME) :- npy201_in_string(n, NAME).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl npy201_alt_10(n: node, name: loc)
npy201_alt_10(n, NAME) :- npy201_pattern_name(n), node(_, n, _, _, _), NAME = n.
npy201_alt_10(n, NAME) :- npy201_in_string(n, NAME).
