.policy "ruff-npy201-numpy2-deprecation" revision 1
.guests off
.description "Replace NumPy members that NumPy 2.0 removes from the main namespace with their supported replacements."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.
// ast(n, {…}) atoms are JSON terms with no .rr form yet; the engine matches them as it does today.

#include "python/names.rr"

// in_handler(n): the JSON util `in-handler`, used where the JSON says `matches: "in-handler"`
.decl npy201_in_handler(n: node)
npy201_in_handler(n) :- npy201_demand_in_handler(n), npy201_up_1(n, p1).

// attribute_error(n): the JSON util `attribute-error`, used where the JSON says `matches: "attribute-error"`
.decl npy201_attribute_error(n: node)
npy201_attribute_error(n) :- npy201_handled_type(n),
    ( kind(n, "identifier"), global_ref(n, "AttributeError")
    ; kind(n, "attribute"), sym_of(n, "builtins.AttributeError")
    ).


// import_error(n): the JSON util `import-error`, used where the JSON says `matches: "import-error"`
.decl npy201_import_error(n: node)
npy201_import_error(n) :- npy201_handled_type(n),
    ( kind(n, "identifier"), (global_ref(n, "ImportError") ; global_ref(n, "ModuleNotFoundError"))
    ; kind(n, "attribute"), (sym_of(n, "builtins.ImportError") ; sym_of(n, "builtins.ModuleNotFoundError"))
    ).


// catches_attribute_error(n): the JSON util `catches-attribute-error`, used where the JSON says `matches: "catches-attribute-error"`
.decl npy201_catches_attribute_error(n: node)
npy201_catches_attribute_error(n) :- child(n, c1, _), kind(c1, "except_clause"),
    within_stop(c2, c1, "block"), npy201_attribute_error(c2).

// fallback(n): the JSON util `fallback`, used where the JSON says `matches: "fallback"`
//   NEW: metavariable of the calling rule, passed in (bound by the caller)
.decl npy201_fallback(n: node, new: symbol)
npy201_fallback(n, NEW) :- node(_, NAME, _, _, _), kind(n, "attribute"), npy201_in_handler(n),
    npy201_up_2(n, p1), field(p1, "body", c2), has(c2, c3, "attribute"),
    sym_of(c3, q4), npy201_set_4(q4), field(c3, "attribute", c5), kind(c5, "identifier"),
    node(_, c5, _, _, _), TID = c5, value(TID, NEW), text(NAME, t1_td),
    NEW = @replace_all(t1_td, "[\\s\\S]+", "format_parser").
npy201_fallback(n, NEW) :- node(_, NAME, _, _, _), kind(n, "identifier"), ref_site(n, b8),
    npy201_in_handler(b8), within_stop(b8, p9, "try_statement"), kind(p9, "try_statement"),
    npy201_catches_import_error(p9), field(p9, "body", c10),
    has(c10, c11, "import_from_statement"), has(c11, c12, "dotted_name"),
    npy201_statement_name(c12, q13),
    ( q13 = "ast.literal_eval"
    ; q13 = "inspect.getsource"
    ; q13 = "numpy.all"
    ; q13 = "numpy.any"
    ; q13 = "numpy.asmatrix"
    ; q13 = "numpy.bytes_"
    ; q13 = "numpy.char.chararray"
    ; q13 = "numpy.char.compare_chararrays"
    ; q13 = "numpy.clongdouble"
    ; q13 = "numpy.complex128"
    ; q13 = "numpy.complex64"
    ; q13 = "numpy.cumprod"
    ; q13 = "numpy.exceptions.AxisError"
    ; q13 = "numpy.exceptions.ComplexWarning"
    ; q13 = "numpy.exceptions.DTypePromotionError"
    ; q13 = "numpy.exceptions.ModuleDeprecationWarning"
    ; q13 = "numpy.exceptions.RankWarning"
    ; q13 = "numpy.exceptions.TooHardError"
    ; q13 = "numpy.exceptions.VisibleDeprecationWarning"
    ; q13 = "numpy.float64"
    ; q13 = "numpy.inf"
    ; q13 = "numpy.issubdtype"
    ; q13 = "numpy.lib.add_docstring"
    ; q13 = "numpy.lib.add_newdoc"
    ; q13 = "numpy.lib.array_utils.byte_bounds"
    ; q13 = "numpy.lib.npyio.DataSource"
    ; q13 = "numpy.lib.tracemalloc_domain"
    ; q13 = "numpy.longdouble"
    ; q13 = "numpy.nan"
    ; q13 = "numpy.prod"
    ; q13 = "numpy.rec.format_parser"
    ; q13 = "numpy.round"
    ; q13 = "numpy.str_"
    ; q13 = "numpy.trapezoid"
    ; q13 = "numpy.vstack"
    ),
    node(_, c12, _, _, _), IID = c12, value(IID, NEW), text(NAME, t1_td),
    NEW = @replace_all(t1_td, "[\\s\\S]+", "format_parser").

// catches_import_error(n): the JSON util `catches-import-error`, used where the JSON says `matches: "catches-import-error"`
.decl npy201_catches_import_error(n: node)
npy201_catches_import_error(n) :- child(n, c1, _), kind(c1, "except_clause"),
    within_stop(c2, c1, "block"), npy201_import_error(c2).

// handled_root(n): the JSON util `handled-root`, used where the JSON says `matches: "handled-root"`
.decl npy201_handled_root(n: node)
npy201_handled_root(n) :- field(p1, "value", n), kind(p1, "except_clause").
npy201_handled_root(n) :- child(p2, n, _), kind(p2, "as_pattern"), child(p3, p2, _),
    kind(p3, "except_clause").
npy201_handled_root(n) :- child(p4, n, _), kind(p4, "parenthesized_expression"),
    npy201_handled_root(p4).

// handled_type(n): the JSON util `handled-type`, used where the JSON says `matches: "handled-type"`
.decl npy201_handled_type(n: node)
npy201_handled_type(n) :- npy201_handled_root(n).
npy201_handled_type(n) :- child(p1, n, _), kind(p1, "tuple"), npy201_handled_root(p1).
npy201_handled_type(n) :- child(p2, n, _), kind(p2, "parenthesized_expression"),
    npy201_handled_type(p2).

// NPY201(n): a finding at node n, from clause `add-docstring`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `transform` computes NEW from other metavariables' text; its literals end each rule.
.violation NPY201(at: node, name: loc) "Use `numpy.lib.add_docstring` instead of `{name}`; NumPy 2.0 removes the old name and this one also works on NumPy 1.x."
    suppress noqa "NPY201"
NPY201(n, NAME) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "numpy.add_docstring"), node(_, n, _, _, _), NAME = n, !npy201_fallback(n, NEW), text(NAME, t1),
    NEW = @replace_all(t1, "[\\s\\S]+", "add_docstring").

