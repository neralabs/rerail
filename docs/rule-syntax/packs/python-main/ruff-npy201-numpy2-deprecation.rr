// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `transform` computes NEW from other metavariables' text; its literals end each rule.
.violation NPY201_format_parser(at: node, name: loc) code "NPY201" "Use `numpy.rec.format_parser` instead of `{name}`; NumPy 2.0 removes the old name and this one also works on NumPy 1.x."
    suppress noqa "NPY201"
NPY201_format_parser(n, NAME) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "numpy.format_parser"), node(_, n, _, _, _), NAME = n,
    count : { kind(n, "attribute"), npy201_in_handler(n), within_stop(n, p1_69, "try_statement"), kind(p1_69, "try_statement"), npy201_catches_attribute_error(p1_69), field(p1_69, "body", c2_69), has(c2_69, c3_69, "attribute"), sym_of(c3_69, q4_69), npy201_set_4(q4_69), field(c3_69, "attribute", c5_69), kind(c5_69, "identifier"), node(_, c5_69, _, _, _), TID = c5_69, value(TID, NEW) } = 0, count : { kind(n, "identifier"), ref_site(n, b8_70), (st9_70 = b8_70 ; within(b8_70, st9_70)), npy201_in_handler(st9_70), within_stop(st9_70, p10_70, "try_statement"), kind(p10_70, "try_statement"), npy201_catches_import_error(p10_70), field(p10_70, "body", c11_70), has(c11_70, c12_70, "import_from_statement"), has(c12_70, c13_70, "dotted_name"), npy201_statement_name(c13_70, q14_70), (q14_70 = "ast.literal_eval" ; q14_70 = "inspect.getsource" ; q14_70 = "numpy.all" ; q14_70 = "numpy.any" ; q14_70 = "numpy.asmatrix" ; q14_70 = "numpy.bytes_" ; q14_70 = "numpy.char.chararray" ; q14_70 = "numpy.char.compare_chararrays" ; q14_70 = "numpy.clongdouble" ; q14_70 = "numpy.complex128" ; q14_70 = "numpy.complex64" ; q14_70 = "numpy.cumprod" ; q14_70 = "numpy.exceptions.AxisError" ; q14_70 = "numpy.exceptions.ComplexWarning" ; q14_70 = "numpy.exceptions.DTypePromotionError" ; q14_70 = "numpy.exceptions.ModuleDeprecationWarning" ; q14_70 = "numpy.exceptions.RankWarning" ; q14_70 = "numpy.exceptions.TooHardError" ; q14_70 = "numpy.exceptions.VisibleDeprecationWarning" ; q14_70 = "numpy.float64" ; q14_70 = "numpy.inf" ; q14_70 = "numpy.issubdtype" ; q14_70 = "numpy.lib.add_docstring" ; q14_70 = "numpy.lib.add_newdoc" ; q14_70 = "numpy.lib.array_utils.byte_bounds" ; q14_70 = "numpy.lib.npyio.DataSource" ; q14_70 = "numpy.lib.tracemalloc_domain" ; q14_70 = "numpy.longdouble" ; q14_70 = "numpy.nan" ; q14_70 = "numpy.prod" ; q14_70 = "numpy.rec.format_parser" ; q14_70 = "numpy.round" ; q14_70 = "numpy.str_" ; q14_70 = "numpy.trapezoid" ; q14_70 = "numpy.vstack"), node(_, c13_70, _, _, _), IID = c13_70, value(IID, NEW) } = 0,
    text(NAME, t1), NEW = @replace_all(t1, "[\\s\\S]+", "format_parser").

// NPY201_string_annotation_or_pattern(n): a finding at node n, from clause `string-annotation-or-pattern`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation NPY201_string_annotation_or_pattern(at: loc, name: node) code "NPY201" "NumPy 2.0 removes `{name}`; switch to the replacement NumPy's 2.0 migration guide gives for it (e.g. `np.float64` for `float_`, `np.inf` for `Inf`), or drop it if there is none."
    suppress noqa "NPY201"
NPY201_string_annotation_or_pattern(NAME, n) :- npy201_alt_10(n, NAME), !npy201_any_fallback(n).

// reference(n): the JSON util `reference`, used where the JSON says `matches: "reference"`
.decl npy201_reference(n: node)
npy201_reference(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), npy201_set_7(q1).

// in_string(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   NAME: metavariable this relation binds for the calling rule
.decl npy201_in_string(n: node, name: loc)
npy201_in_string(n, NAME) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), npy201_alt_8(c2, NAME).

// pattern_name(n): the JSON util `pattern-name`, used where the JSON says `matches: "pattern-name"`
.decl npy201_pattern_name(n: node)
npy201_pattern_name(n) :- kind(n, "dotted_name"),
    match("\\w+\\s*\\.\\s*(?:add_docstring|add_newdoc|add_newdoc_ufunc|alltrue|asfarray|byte_bounds|cast|cfloat|clongfloat|compat|complex_|cumproduct|DataSource|deprecate|deprecate_with_doc|disp|fastCopyAndTranspose|find_common_type|get_array_wrap|float_|geterrobj|in1d|INF|Inf|Infinity|infty|issctype|issubclass_|issubsctype|mat|maximum_sctype|NaN|NAN|nbytes|NINF|NZERO|longcomplex|longfloat|lookfor|obj2sctype|PINF|product|PZERO|recfromcsv|recfromtxt|round_|safe_eval|sctype2char|sctypes|seterrobj|set_string_function|singlecomplex|string_|sometrue|source|tracemalloc_domain|trapz|unicode_|who|row_stack|AxisError|ComplexWarning|DTypePromotionError|ModuleDeprecationWarning|RankWarning|TooHardError|VisibleDeprecationWarning|compare_chararrays|chararray|format_parser)", n),
    inside(n, p1, "case_pattern"), child(n, c2, _), kind(c2, "identifier"),
    sym_of(c2, "numpy").

// any_fallback(n): the JSON util `any-fallback`, used where the JSON says `matches: "any-fallback"`
.decl npy201_any_fallback(n: node)
npy201_any_fallback(n) :- npy201_in_handler(n), npy201_up_2(n, p1), field(p1, "body", c2),
    has(c2, c3, "attribute"), sym_of(c3, q4), npy201_set_4(q4).

// from_module: the module text of from-import s, read as `relative: "text"` does (dots dropped)
.decl npy201_from_module(s: node, m: symbol)
npy201_from_module(s, m) :- kind(s, "future_import_statement"), m = "__future__".
npy201_from_module(s, m) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "dotted_name"), name(x, m).
npy201_from_module(s, m) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "relative_import"), child(x, y, _), kind(y, "dotted_name"), name(y, m).
npy201_from_module(s, "") :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "relative_import"), count : { child(x, y, _), kind(y, "dotted_name") } = 0.

// statement_name: dotted name n in an import statement imports q (relative modules by their text)
.decl npy201_statement_name(n: node, q: symbol)
npy201_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    kind(s, "import_statement"), name(n, q).
npy201_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    kind(s, "relative_import"), name(n, q).
npy201_statement_name(n, q) :- kind(n, "dotted_name"), field(a, "name", n),
    kind(a, "aliased_import"), child(s, a, _), kind(s, "import_statement"), name(n, q).
npy201_statement_name(n, q) :- kind(n, "dotted_name"), field(a, "name", n),
    kind(a, "aliased_import"), child(s, a, _),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    npy201_from_module(s, m), name(n, x), q = @dot(m, x).
npy201_statement_name(n, m) :- kind(n, "dotted_name"), field(s, "module_name", n),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    npy201_from_module(s, m).
npy201_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    !field(s, "module_name", n), npy201_from_module(s, m), name(n, x), q = @dot(m, x).

