// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl npy201_up_1(n: node, p: node)
npy201_up_1(n, p) :- npy201_demand_in_handler(n), within_stop(n, p, npy201_stop_1),
    kind(p, "except_clause").

// up_2(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl npy201_up_2(n: node, p: node)
npy201_up_2(n, p) :- npy201_in_handler(n), within_stop(n, p, "try_statement"),
    kind(p, "try_statement"), npy201_catches_attribute_error(p).

