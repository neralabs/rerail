.policy "ruff-ytt301-sys-version0" revision 1
.guests off
.description "Read the major version from sys.version_info instead of indexing the first character of sys.version; the first digit is wrong for a two-digit major version."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// YTT301(n): a finding at node n, from clause `sys-version0`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation YTT301(at: node, c: node) "Use `sys.version_info.major` (an int, so compare it to ints, not strings) instead of `sys.version[0]`, which is only the first digit of a two-digit major version."
    suppress noqa "YTT301"
YTT301(C, n) :- ytt301_target(n), node(_, n, _, _, _), C = n.
YTT301(C, n) :- ytt301_in_string(n, C).

// zero_literal(n): the JSON util `zero-literal`, used where the JSON says `matches: "zero-literal"`
.decl ytt301_zero_literal(n: node)
ytt301_zero_literal(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int"), v1 = 0.
ytt301_zero_literal(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    ytt301_zero_literal(c2).

// zero_subscript(n): the JSON util `zero-subscript`, used where the JSON says `matches: "zero-subscript"`
.decl ytt301_zero_subscript(n: node)
ytt301_zero_subscript(n) :- kind(n, "subscript"), field(n, "subscript", c1), ytt301_zero_literal(c1),
    !ytt301_tok_has_1(n).

// subscripted(n): the JSON util `subscripted`, used where the JSON says `matches: "subscripted"`
.decl ytt301_subscripted(n: node)
ytt301_subscripted(n) :- child(p1, n, _), ytt301_counted_1(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), ytt301_counted_1(s2) }, k3 = 0,
    child(p4, n, _), ytt301_zero_subscript(p4).
ytt301_subscripted(n) :- child(p5, n, _), kind(p5, "parenthesized_expression"),
    ytt301_subscripted(p5).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl ytt301_target(n: node)
ytt301_target(n) :- (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, "sys.version"),
    ytt301_subscripted(n).

// in_string(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   C: metavariable this relation binds for the calling rule
.decl ytt301_in_string(n: node, c: loc)
ytt301_in_string(n, C) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ytt301_alt_2(c2, C).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ytt301_tok_has_1(n: node)
.stored ytt301_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ytt301_tok_has_1(n) :- child(n, c2, _), glob("\\,", c2).
ytt301_tok_has_1(n) :- op(n, t3), match(",", t3).
ytt301_tok_has_1(n) :- child(n, c9, _), structural_before(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
ytt301_tok_has_1(n) :- child(n, c9, _), structural_after(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
ytt301_tok_has_1(n) :- node_text(n, g4), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g4).

// counted_1(n): the siblings the JSON `nthChild.ofRule` counts
.decl ytt301_counted_1(n: node)
ytt301_counted_1(n) :- node(_, n, _, _, _), !kind(n, "comment"),
    !kind(n, "line_continuation").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl ytt301_alt_2(n: node, c: loc)
ytt301_alt_2(n, C) :- ytt301_target(n), C = n.
ytt301_alt_2(n, C) :- ytt301_in_string(n, C).
