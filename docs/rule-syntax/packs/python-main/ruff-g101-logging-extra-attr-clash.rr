.policy "ruff-g101-logging-extra-attr-clash" revision 1
.description "Avoid extra keys that clash with built-in LogRecord attributes in logging calls; the logging call raises KeyError when they collide."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/names.rr"

// G101(n): a finding at node n, from clause `logging-extra-attr-clash`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation G101(at: node, k: loc) "Rename the `extra` key {k}: it clashes with a built-in LogRecord attribute, so a standard-library logger raises KeyError when it builds the record."
    suppress noqa "G101"
G101(n, K) :-
    ( kind(n, "string"), !g101_interpolated_part(n)
    ; kind(n, "concatenated_string"), count : { child(n, c1, _), g101_interpolated_part(c1) } = 0
    ),

    value(n, v2), glob("{args,asctime,created,exc_info,exc_text,filename,funcName,levelname,levelno,lineno,module,msecs,message,msg,name,pathname,process,processName,relativeCreated,stack_info,thread,threadName}", v2),
    node(_, n, _, _, _), K = n, g101_extra_key(n).
G101(n, K) :- kind(n, "keyword_argument"), field(n, "name", c3),
    glob("{args,asctime,created,exc_info,exc_text,filename,funcName,levelname,levelno,lineno,module,msecs,message,msg,name,pathname,process,processName,relativeCreated,stack_info,thread,threadName}", c3),
    node(_, c3, _, _, _), K = c3, child(p4, n, _), kind(p4, "argument_list"), field(p5, "arguments", p4),
    kind(p5, "call"), field(p5, "function", c6), g101_builtin_dict(c6), g101_extra_value(p5).

// logger_object(n): the JSON util `logger-object`, used where the JSON says `matches: "logger-object"`
.decl g101_logger_object(n: node)
g101_logger_object(n) :- kind(n, "call"), field(n, "function", c1),
    (sym_of(c1, "logging.getLogger") ; sym_of(c1, "logging.Logger")).
g101_logger_object(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    g101_logger_object(c2).
g101_logger_object(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (sym_of(n, "logging") ; sym_of(n, "flask.current_app.logger")).
g101_logger_object(n) :-
    ( kind(n, "identifier"), match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", n)
    ; kind(n, "attribute"), g101_tok_has_2(n), field(n, "object", c1), g101_name_chain(c1)
    ),
    !sym_of(n, _).

// name_chain(n): the JSON util `name-chain`, used where the JSON says `matches: "name-chain"`
.decl g101_name_chain(n: node)
g101_name_chain(n) :- kind(n, "identifier").
g101_name_chain(n) :- kind(n, "attribute"), field(n, "object", c1), g101_name_chain(c1).
g101_name_chain(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), g101_name_chain(c2).

// logging_callee(n): the JSON util `logging-callee`, used where the JSON says `matches: "logging-callee"`
.decl g101_logging_callee(n: node)
g101_logging_callee(n) :- kind(n, "attribute"), g101_tok_has_3(n), field(n, "object", c9),
    g101_logger_object(c9).
g101_logging_callee(n) :- kind(n, "identifier"), sym_of(n, q10), g101_set_2(q10).
g101_logging_callee(n) :- kind(n, "parenthesized_expression"), child(n, c11, _),
    g101_logging_callee(c11).

// extra_value(n): the JSON util `extra-value`, used where the JSON says `matches: "extra-value"`
.decl g101_extra_value(n: node)
g101_extra_value(n) :- field(p1, "value", n), kind(p1, "keyword_argument"), g101_tok_has_4(p1),
    child(p10, p1, _), kind(p10, "argument_list"), field(p11, "arguments", p10),
    kind(p11, "call"), field(p11, "function", c12), g101_logging_callee(c12).
g101_extra_value(n) :- child(p13, n, _), kind(p13, "parenthesized_expression"),
    g101_extra_value(p13).

// extra_key(n): the JSON util `extra-key`, used where the JSON says `matches: "extra-key"`
.decl g101_extra_key(n: node)
g101_extra_key(n) :- field(p1, "key", n), kind(p1, "pair"), child(p2, p1, _),
    kind(p2, "dictionary"), g101_extra_value(p2).
g101_extra_key(n) :- child(p3, n, _), kind(p3, "parenthesized_expression"), g101_extra_key(p3).

// interpolated_part(n): the JSON util `interpolated-part`, used where the JSON says `matches: "interpolated-part"`
.decl g101_interpolated_part(n: node)
g101_interpolated_part(n) :- kind(n, "string"), child(n, c1, _), kind(c1, "string_start"),
    match("[A-Za-z]*[fFtT].*", c1).

// builtin_dict(n): the JSON util `builtin-dict`, used where the JSON says `matches: "builtin-dict"`
.decl g101_builtin_dict(n: node)
g101_builtin_dict(n) :- kind(n, "identifier"), global_ref(n, "dict").
g101_builtin_dict(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "builtins.dict").
g101_builtin_dict(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    g101_builtin_dict(c1).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^(log|LOG)|(logger|logging|LOGGER|LOGGING)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl g101_tok_has_1(n: node)
.stored g101_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
g101_tok_has_1(n) :- field(n, "attribute", c3),
    match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", c3).
g101_tok_has_1(n) :- op(n, t4),
    match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", t4).
g101_tok_has_1(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g5).
g101_tok_has_1(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g5).
g101_tok_has_1(n) :- node_text(n, g5), !child(n, _, _),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g5).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^(log|LOG)|(logger|logging|LOGGER|LOGGING)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl g101_tok_has_2(n: node)
.stored g101_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
g101_tok_has_2(n) :- field(n, "attribute", c1),
    match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", c1).
g101_tok_has_2(n) :- op(n, t2),
    match(".*(?:^(log|LOG)|(logger|logging|LOGGER|LOGGING)$).*", t2).
g101_tok_has_2(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g3).
g101_tok_has_2(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g3).
g101_tok_has_2(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:.*(?:(log|LOG)).*|.*(?:(logger|logging|LOGGER|LOGGING)).*)$", g3).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^(debug|critical|error|exception|info|warn|warning|log)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl g101_tok_has_3(n: node)
.stored g101_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
g101_tok_has_3(n) :- field(n, "attribute", c1),
    glob("{debug,critical,error,exception,info,warn,warning,log}", c1).
g101_tok_has_3(n) :- op(n, t2),
    match("(debug|critical|error|exception|info|warn|warning|log)", t2).
g101_tok_has_3(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:debug)(?:\\W.*)?|(?:.*\\W)?(?:critical)(?:\\W.*)?|(?:.*\\W)?(?:error)(?:\\W.*)?|(?:.*\\W)?(?:exception)(?:\\W.*)?|(?:.*\\W)?(?:info)(?:\\W.*)?|(?:.*\\W)?(?:warn)(?:\\W.*)?|(?:.*\\W)?(?:warning)(?:\\W.*)?|(?:.*\\W)?(?:log)(?:\\W.*)?)$", g3).
g101_tok_has_3(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:debug)(?:\\W.*)?|(?:.*\\W)?(?:critical)(?:\\W.*)?|(?:.*\\W)?(?:error)(?:\\W.*)?|(?:.*\\W)?(?:exception)(?:\\W.*)?|(?:.*\\W)?(?:info)(?:\\W.*)?|(?:.*\\W)?(?:warn)(?:\\W.*)?|(?:.*\\W)?(?:warning)(?:\\W.*)?|(?:.*\\W)?(?:log)(?:\\W.*)?)$", g3).
g101_tok_has_3(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:debug)(?:\\W.*)?|(?:.*\\W)?(?:critical)(?:\\W.*)?|(?:.*\\W)?(?:error)(?:\\W.*)?|(?:.*\\W)?(?:exception)(?:\\W.*)?|(?:.*\\W)?(?:info)(?:\\W.*)?|(?:.*\\W)?(?:warn)(?:\\W.*)?|(?:.*\\W)?(?:warning)(?:\\W.*)?|(?:.*\\W)?(?:log)(?:\\W.*)?)$", g3).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "^extra$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl g101_tok_has_4(n: node)
.stored g101_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
g101_tok_has_4(n) :- field(n, "name", c2), glob("extra", c2).
g101_tok_has_4(n) :- op(n, t3), match("extra", t3).
g101_tok_has_4(n) :- child(n, c9, _), structural_before(c9, g4),
    match("(?s)^(?:(?:.*\\W)?(?:extra)(?:\\W.*)?)$", g4).
g101_tok_has_4(n) :- child(n, c9, _), structural_after(c9, g4),
    match("(?s)^(?:(?:.*\\W)?(?:extra)(?:\\W.*)?)$", g4).
g101_tok_has_4(n) :- node_text(n, g4), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:extra)(?:\\W.*)?)$", g4).

// set_2: symbols from the JSON `resolves.import`
.decl g101_set_2(v: symbol)
g101_set_2("logging.debug"). g101_set_2("logging.critical"). g101_set_2("logging.error").
g101_set_2("logging.exception"). g101_set_2("logging.info"). g101_set_2("logging.warn").
g101_set_2("logging.warning"). g101_set_2("logging.log").
