    k6 = count : { child(p4, s5, _), precedes(s5, p3), pyi036_counted(s5) }, k6 = 2,
    child(p7, p3, _), kind(p7, "parameters"), field(p8, "parameters", p7),
    pyi036_exit_method(p8), field(p8, "name", c9), node(_, c9, _, _, _), M = c9.

// PYI036_third_argument_annotation(n): a finding at node n, from clause `third-argument-annotation`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PYI036_third_argument_annotation(at: node, m: loc) code "PYI036" "Annotate the third argument of `{m}` as `types.TracebackType | None`, or as `object`; the interpreter passes `None` when no exception occurred."
    suppress noqa "PYI036"
PYI036_third_argument_annotation(n, M) :- !pyi036_alt_17(n),
    count : { within(c1, n), pyi036_traceback(c1), pyi036_non_none_element(c1) } = 0,
    within_stop(n, p2, pyi036_stop_18), kind(p2, "type"), field(p3, "type", p2),
    (kind(p3, "typed_parameter") ; kind(p3, "typed_default_parameter")),
    pyi036_positional(p3), child(p4, p3, _), pyi036_counted(p3),
    k6 = count : { child(p4, s5, _), precedes(s5, p3), pyi036_counted(s5) }, k6 = 3,
    child(p7, p3, _), kind(p7, "parameters"), field(p8, "parameters", p7),
    pyi036_exit_method(p8), field(p8, "name", c9), node(_, c9, _, _, _), M = c9.

// PYI036_unrecognized_overload(n): a finding at node n, from clause `unrecognized-overload`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PYI036_unrecognized_overload(at: node, params: node, name: loc) code "PYI036" "Annotate the three arguments after `self` of these `{name}` overloads as either `None, None, None` or `type[BaseException], BaseException, types.TracebackType`."
    suppress noqa "PYI036"
PYI036_unrecognized_overload(PARAMS, n, NAME) :- kind(n, "function_definition"),
    pyi036_exit_kind(n), pyi036_overloaded(n), field(n, "name", c1), node(_, c1, _, _, _), NAME = c1, child(p2, n, _),
    kind(p2, "decorated_definition"), child(p3, p2, _), kind(p3, "block"),
    kind(p3, "block"), k2_1 = count : { child(p3, c1_1, _), pyi036_named_overload(c1_1) }, k2_1 >= 2, k2_1 <= 2, k4_1 = count : { child(p3, c3_1, _), pyi036_usable_overload(c3_1) }, k4_1 >= 2, k4_1 <= 2,
    field(p4, "body", p3), kind(p4, "class_definition"), field(n, "parameters", c5),
    node(_, c5, _, _, _), PARAMS = c5, kind(c5, "parameters"), pyi036_exit_shape(c5), pyi036_alt_33(c5), pyi036_alt_40(c5).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi036_tok_has_1(n: node)
.stored pyi036_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi036_tok_has_1(n) :- child(n, c6, _), glob("\\,", c6).
pyi036_tok_has_1(n) :- op(n, t7), match(",", t7).
pyi036_tok_has_1(n) :- child(n, c13, _), structural_before(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
pyi036_tok_has_1(n) :- child(n, c13, _), structural_after(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
pyi036_tok_has_1(n) :- node_text(n, g8), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g8).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi036_tok_has_2(n: node)
.stored pyi036_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi036_tok_has_2(n) :- child(n, c18, _), glob("\\,", c18).
pyi036_tok_has_2(n) :- op(n, t19), match(",", t19).
pyi036_tok_has_2(n) :- child(n, c25, _), structural_before(c25, g20),
    match("(?s)^(?:.*(?:,).*)$", g20).
pyi036_tok_has_2(n) :- child(n, c25, _), structural_after(c25, g20),
    match("(?s)^(?:.*(?:,).*)$", g20).
pyi036_tok_has_2(n) :- node_text(n, g20), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g20).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^\\|$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi036_tok_has_3(n: node)
.stored pyi036_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi036_tok_has_3(n) :- child(n, c1, _), glob("|", c1).
pyi036_tok_has_3(n) :- op(n, t2), match("\\|", t2).
pyi036_tok_has_3(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\|)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
pyi036_tok_has_3(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\|)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
pyi036_tok_has_3(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\|)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi036_tok_has_4(n: node)
.stored pyi036_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi036_tok_has_4(n) :- child(n, c21, _), glob("\\,", c21).
pyi036_tok_has_4(n) :- op(n, t22), match(",", t22).
pyi036_tok_has_4(n) :- child(n, c28, _), structural_before(c28, g23),
    match("(?s)^(?:.*(?:,).*)$", g23).
pyi036_tok_has_4(n) :- child(n, c28, _), structural_after(c28, g23),
    match("(?s)^(?:.*(?:,).*)$", g23).
pyi036_tok_has_4(n) :- node_text(n, g23), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g23).

// tok_has_5(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi036_tok_has_5(n: node)
.stored pyi036_tok_has_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi036_tok_has_5(n) :- child(n, c31, _), glob("\\,", c31).
pyi036_tok_has_5(n) :- op(n, t32), match(",", t32).
pyi036_tok_has_5(n) :- child(n, c38, _), structural_before(c38, g33),
    match("(?s)^(?:.*(?:,).*)$", g33).
pyi036_tok_has_5(n) :- child(n, c38, _), structural_after(c38, g33),
    match("(?s)^(?:.*(?:,).*)$", g33).
pyi036_tok_has_5(n) :- node_text(n, g33), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g33).

// tok_has_6(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi036_tok_has_6(n: node)
.stored pyi036_tok_has_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi036_tok_has_6(n) :- child(n, c4, _), glob("\\,", c4).
pyi036_tok_has_6(n) :- op(n, t5), match(",", t5).
pyi036_tok_has_6(n) :- child(n, c11, _), structural_before(c11, g6),
    match("(?s)^(?:.*(?:,).*)$", g6).
pyi036_tok_has_6(n) :- child(n, c11, _), structural_after(c11, g6),
    match("(?s)^(?:.*(?:,).*)$", g6).
pyi036_tok_has_6(n) :- node_text(n, g6), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g6).

// tok_has_7(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi036_tok_has_7(n: node)
.stored pyi036_tok_has_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi036_tok_has_7(n) :- child(n, c14, _), glob("\\,", c14).
pyi036_tok_has_7(n) :- op(n, t15), match(",", t15).
pyi036_tok_has_7(n) :- child(n, c21, _), structural_before(c21, g16),
    match("(?s)^(?:.*(?:,).*)$", g16).
pyi036_tok_has_7(n) :- child(n, c21, _), structural_after(c21, g16),
    match("(?s)^(?:.*(?:,).*)$", g16).
pyi036_tok_has_7(n) :- node_text(n, g16), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g16).

// demand_usable_overload: the rows of usable_overload its callers ask for (the metavariable columns they pass in)
.decl pyi036_demand_usable_overload(n: node)
pyi036_demand_usable_overload(c3_1) :- kind(n, "function_definition"), pyi036_exit_kind(n),
    pyi036_overloaded(n), field(n, "name", c1), node(_, c1, _, _, _), NAME = c1, child(p2, n, _),
    kind(p2, "decorated_definition"), child(p3, p2, _), kind(p3, "block"),
    kind(p3, "block"), field(p4, "body", p3), kind(p4, "class_definition"),
    field(n, "parameters", c5), node(_, c5, _, _, _), PARAMS = c5, kind(c5, "parameters"), pyi036_exit_shape(c5),
    pyi036_alt_33(c5), pyi036_alt_40(c5), child(p3, c3_1, _).

// demand_named_overload: the rows of named_overload its callers ask for (the metavariable columns they pass in)
.decl pyi036_demand_named_overload(n: node)
pyi036_demand_named_overload(n) :- pyi036_demand_usable_overload(n), field(n, "definition", c1),
    pyi036_exit_kind(c1), field(c1, "parameters", c2), pyi036_exit_shape(c2).
pyi036_demand_named_overload(c1_1) :- kind(n, "function_definition"), pyi036_exit_kind(n),
    pyi036_overloaded(n), field(n, "name", c1), node(_, c1, _, _, _), NAME = c1, child(p2, n, _),
    kind(p2, "decorated_definition"), child(p3, p2, _), kind(p3, "block"),
    kind(p3, "block"), field(p4, "body", p3), kind(p4, "class_definition"),
    field(n, "parameters", c5), node(_, c5, _, _, _), PARAMS = c5, kind(c5, "parameters"), pyi036_exit_shape(c5),
    pyi036_alt_33(c5), pyi036_alt_40(c5), child(p3, c1_1, _).

// demand_body: the nodes body is asked at (it looks at every ancestor of every node)
.decl pyi036_demand_body(n: node)
pyi036_demand_body(p1) :- field(p1, "left", n), pyi036_or_op(p1).
pyi036_demand_body(p3) :- kind(n, "type"), child(p3, n, _), kind(p3, "union_type").
pyi036_demand_body(p1) :- field(p1, "right", n), pyi036_or_op(p1), field(p1, "left", c2),
    pyi036_none_lit(c2).
pyi036_demand_body(p4) :- kind(n, "type"), precedes(s3, n), kind(s3, "type"), pyi036_none_lit(s3),
    child(p4, n, _), kind(p4, "union_type").
pyi036_demand_body(p4) :- kind(n, "type"), child(p1, n, _), kind(p1, "type_parameter"),
    child(p4, p1, _), kind(p4, "generic_type"), child(p4, c5, _), pyi036_optional_ref(c5).
pyi036_demand_body(p6) :- field(p6, "subscript", n), kind(p6, "subscript"),
    field(p6, "value", c7), pyi036_optional_ref(c7).
pyi036_demand_body(p5) :- kind(n, "type"), child(p1, n, _), kind(p1, "type_parameter"),
    child(p1, c4, _), kind(c4, "type"), pyi036_none_lit(c4), child(p5, p1, _),
    kind(p5, "generic_type"), child(p5, c6, _), pyi036_union_ref(c6).
pyi036_demand_body(p7) :- child(p7, n, _), kind(p7, "subscript"), field(p7, "value", c8),
    pyi036_union_ref(c8), child(p7, c9, _), pyi036_none_lit(c9).
pyi036_demand_body(p17) :- child(p13, n, _), kind(p13, "tuple"), child(p13, c16, _),
    pyi036_none_lit(c16), within_stop(p13, p17, pyi036_stop_7), kind(p17, "subscript"),
    field(p17, "value", c1), pyi036_union_ref(c1).
pyi036_demand_body(p1) :- child(p13, n, _), kind(p13, "tuple"), child(p13, c16, _),
    pyi036_none_lit(c16), within_stop(p13, p17, pyi036_stop_7), kind(p17, "type_parameter"),
    child(p1, p17, _), kind(p1, "generic_type"), child(p1, c4, _), pyi036_union_ref(c4).

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl pyi036_up_1(n: node, p: node)
pyi036_up_1(n, p) :- pyi036_demand_body(n), within_stop(n, p, pyi036_stop_18), kind(p, "type").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pyi036_alt_1(n: node)
pyi036_alt_1(n) :- kind(n, "comment").
pyi036_alt_1(n) :- node(_, n, _, _, _), glob("[\\[\\],]", n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pyi036_alt_3(n: node)
pyi036_alt_3(n) :- kind(n, "union_type").
pyi036_alt_3(n) :- pyi036_or_op(n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl pyi036_alt_6(n: node)
pyi036_alt_6(n) :- kind(n, "comment").
pyi036_alt_6(n) :- node(_, n, _, _, _), glob("[(),]", n).

// stop_7(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi036_stop_7(n: node)
pyi036_stop_7(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression"),
    !kind(n, "type").

// alt_17(n): the JSON `any`: n matches if any one of these rules does
.decl pyi036_alt_17(n: node)
pyi036_alt_17(n) :- (kind(n, "parenthesized_expression") ; kind(n, "comment")).
pyi036_alt_17(n) :- node(_, n, _, _, _), glob("[()]", n).
pyi036_alt_17(n) :- pyi036_object_like(n).

// stop_18(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi036_stop_18(n: node)
pyi036_stop_18(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// counted(n): 16 identical copies of one rule set (`counted_19`, `counted_23`, `counted_26` and 13 more), folded into one.
.decl pyi036_counted(n: node)
pyi036_counted(n) :- pyi036_positional(n).

// alt_33(n): the JSON `any`: n matches if any one of these rules does
.decl pyi036_alt_33(n: node)
pyi036_alt_33(n) :- child(n, c1, _), pyi036_positional(c1), child(p2, c1, _), pyi036_counted(c1),
    k4 = count : { child(p2, s3, _), precedes(s3, c1), pyi036_counted(s3) }, k4 = 1,
    (kind(c1, "typed_parameter") ; kind(c1, "typed_default_parameter")),
    child(c1, c5, _), kind(c5, "type"), !pyi036_loose_none(c5).
pyi036_alt_33(n) :- child(n, c6, _), pyi036_positional(c6), child(p7, c6, _), pyi036_counted(c6),
    k9 = count : { child(p7, s8, _), precedes(s8, c6), pyi036_counted(s8) }, k9 = 2,
    (kind(c6, "typed_parameter") ; kind(c6, "typed_default_parameter")),
    child(c6, c10, _), kind(c10, "type"), !pyi036_loose_none(c10).
pyi036_alt_33(n) :- child(n, c11, _), pyi036_positional(c11), child(p12, c11, _), pyi036_counted(c11),
    k14 = count : { child(p12, s13, _), precedes(s13, c11), pyi036_counted(s13) }, k14 = 3,
    (kind(c11, "typed_parameter") ; kind(c11, "typed_default_parameter")),
    child(c11, c15, _), kind(c15, "type"), !pyi036_loose_none(c15).

// alt_40(n): the JSON `any`: n matches if any one of these rules does
.decl pyi036_alt_40(n: node)
pyi036_alt_40(n) :- child(n, c1, _), pyi036_positional(c1), child(p2, c1, _), pyi036_counted(c1),
    k4 = count : { child(p2, s3, _), precedes(s3, c1), pyi036_counted(s3) }, k4 = 1,
    (kind(c1, "typed_parameter") ; kind(c1, "typed_default_parameter")),
    child(c1, c5, _), kind(c5, "type"), !pyi036_loose_exc_2(c5).
pyi036_alt_40(n) :- child(n, c6, _), pyi036_positional(c6), child(p7, c6, _), pyi036_counted(c6),
    k9 = count : { child(p7, s8, _), precedes(s8, c6), pyi036_counted(s8) }, k9 = 2,
    (kind(c6, "typed_parameter") ; kind(c6, "typed_default_parameter")),
    child(c6, c10, _), kind(c10, "type"), !pyi036_loose_exc_3(c10).
pyi036_alt_40(n) :- child(n, c11, _), pyi036_positional(c11), child(p12, c11, _), pyi036_counted(c11),
    k14 = count : { child(p12, s13, _), precedes(s13, c11), pyi036_counted(s13) }, k14 = 3,
    (kind(c11, "typed_parameter") ; kind(c11, "typed_default_parameter")),
    child(c11, c15, _), kind(c15, "type"), !pyi036_loose_exc_4(c15).
