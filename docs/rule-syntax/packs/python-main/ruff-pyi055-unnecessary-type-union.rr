pyi055_alt_3(n) :- (kind(n, "tuple") ; kind(n, "list_splat")).
pyi055_alt_3(n) :- node(_, n, _, _, _), glob("\\,", n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl pyi055_alt_4(n: node)
pyi055_alt_4(n) :- node(_, n, _, _, _), glob("\\,", n).
pyi055_alt_4(n) :- kind(n, "type"), child(n, c1, _),
