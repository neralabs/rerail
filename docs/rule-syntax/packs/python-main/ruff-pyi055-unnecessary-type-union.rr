.decl pyi055_pipe_types_in(n: node)
pyi055_pipe_types_in(n) :- pyi055_type_member(n).
pyi055_pipe_types_in(n) :- pyi055_pipe_flat(n), child(n, c1, _), pyi055_pipe_types_in(c1).

