.violation PYI055_unnecessary_type_union_in_string(at: node, pyi055_union: node) code "PYI055" "Merge the `type[X]` members of this union into one `type[...]`, e.g. `type[int | str]` instead of `type[int] | type[str]`; the meaning is the same."
    suppress noqa "PYI055"
PYI055_unnecessary_type_union_in_string(UNION, n) :- pyi055_in_string_annotation(n, UNION).
PYI055_unnecessary_type_union_in_string(UNION, n) :- pyi055_in_escaped_or_concatenated_annotation(n, UNION).

