pyi055_in_pipe(n) :- child(p1, n, _), pyi055_pipe_bin(p1).
pyi055_in_pipe(n) :- child(p2, n, _), kind(p2, "parenthesized_expression"), pyi055_in_pipe(p2).

// bad_pipe_union(n): the JSON util `bad-pipe-union`, used where the JSON says `matches: "bad-pipe-union"`
.decl pyi055_bad_pipe_union(n: node)
pyi055_bad_pipe_union(n) :- pyi055_pipe_bin(n), pyi055_pipe_many_types(n), !pyi055_in_pipe(n).

// in_relocated_annotation(n): the JSON util `in-relocated-annotation`, used where the JSON says `matches: "in-relocated-annotation"`
