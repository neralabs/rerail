// main's file condition {"regex": "\\.pyi$"}
.decl PYI055_raw(at: node)
PYI055(v0) :- PYI055_raw(v0), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).

// main's file condition {"notRegex": "\\.pyi$"}
.decl PYI055_unnecessary_type_union_raw(at: node)
PYI055_unnecessary_type_union(v0) :- PYI055_unnecessary_type_union_raw(v0), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).
