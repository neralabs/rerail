// in_escaped_or_concatenated_annotation(n): the JSON util `in-escaped-or-concatenated-annotation`, used where the JSON says `matches: "in-escaped-or-concatenated-annotation"`
//   UNION: metavariable this relation binds for the calling rule
.decl pyi055_in_escaped_or_concatenated_annotation(n: node, pyi055_union: loc)
pyi055_in_escaped_or_concatenated_annotation(n, UNION) :- pyi055_escaped_or_concatenated(n),
