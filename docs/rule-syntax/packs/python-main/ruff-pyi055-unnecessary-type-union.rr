// PYI055(n): a finding at node n, from clause `unnecessary-type-union-in-stub`.
// Each rule below is one way the JSON `rule` can match.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI055(at: node) "Merge the `type[X]` members of this union into one `type[...]`, e.g. `type[int | str]` instead of `type[int] | type[str]`; the meaning is the same."
    suppress noqa "PYI055"
PYI055_raw(n) :- pyi055_bad_union(n),
    (pyi055_in_annotation_slot(n) ; pyi055_in_type_statement(n) ; pyi055_in_tc_block(n)).

// PYI055_unnecessary_type_union(n): a finding at node n, from clause `unnecessary-type-union`.
// Each rule below is one way the JSON `rule` can match.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI055_unnecessary_type_union(at: node) code "PYI055" "Merge the `type[X]` members of this union into one `type[...]`, e.g. `type[int | str]` instead of `type[int] | type[str]`; the meaning is the same."
    suppress noqa "PYI055"
PYI055_unnecessary_type_union_raw(n) :- pyi055_bad_union(n),
    ( pyi055_in_local_annotation(n)
    ; pyi055_future_file(n), pyi055_in_annotation_slot(n)
