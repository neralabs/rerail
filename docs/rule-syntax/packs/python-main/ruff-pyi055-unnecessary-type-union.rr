pyi055_alt_5(n) :- pyi055_demand_alt_5(n), pyi055_many_types(n).
pyi055_alt_5(n) :- pyi055_demand_alt_5(n), pyi055_types_in(n), precedes(n, s1), pyi055_types_in(s1).

