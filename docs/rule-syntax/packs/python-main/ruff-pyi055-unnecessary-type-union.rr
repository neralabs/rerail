.policy "ruff-pyi055-unnecessary-type-union" revision 1
.guests off
.description "Combine several type-of-class members of a union into one type over the union of those classes; the meaning is unchanged and the annotation is shorter."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// union_head(n): the JSON util `union-head`, used where the JSON says `matches: "union-head"`
.decl pyi055_union_head(n: node)
pyi055_union_head(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Union")
    ; sym_of(n, "typing_extensions.Union")
    ; sym_of(n, "_typeshed.Union")
    ).

pyi055_union_head(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pyi055_union_head(c1).

// pipe_bin(n): the JSON util `pipe-bin`, used where the JSON says `matches: "pipe-bin"`
.decl pyi055_pipe_bin(n: node)
pyi055_pipe_bin(n) :- kind(n, "binary_operator"), field(n, "operator", c1), glob("|", c1).

// pipe(n): the JSON util `pipe`, used where the JSON says `matches: "pipe"`
.decl pyi055_pipe(n: node)
pyi055_pipe(n) :- pyi055_pipe_bin(n).
pyi055_pipe(n) :- kind(n, "union_type").

// union_sub(n): the JSON util `union-sub`, used where the JSON says `matches: "union-sub"`
.decl pyi055_union_sub(n: node)
pyi055_union_sub(n) :- kind(n, "subscript"), field(n, "value", c1), pyi055_union_head(c1).
pyi055_union_sub(n) :- kind(n, "generic_type"), child(n, c2, _), pyi055_union_head(c2).

// union(n): the JSON util `union`, used where the JSON says `matches: "union"`
.decl pyi055_union(n: node)
pyi055_union(n) :- pyi055_pipe(n).
pyi055_union(n) :- pyi055_union_sub(n).

// sole_tuple(n): the JSON util `sole-tuple`, used where the JSON says `matches: "sole-tuple"`
.decl pyi055_sole_tuple(n: node)
pyi055_sole_tuple(n) :- kind(n, "tuple"),
    ( child(p1, n, _), kind(p1, "subscript"), pyi055_union_sub(p1), !pyi055_tok_has_1(p1)
    ; child(p2, n, _), kind(p2, "type"), child(p3, p2, _), kind(p3, "type_parameter"), !pyi055_tok_has_2(p3), child(p4, p3, _), pyi055_union_sub(p4)
    ).


// in_union(n): the JSON util `in-union`, used where the JSON says `matches: "in-union"`
.decl pyi055_in_union(n: node)
pyi055_in_union(n) :- child(p1, n, _), pyi055_pipe_bin(p1).
pyi055_in_union(n) :- child(p2, n, _), kind(p2, "subscript"), pyi055_union_sub(p2).
pyi055_in_union(n) :- child(p3, n, _), pyi055_sole_tuple(p3).
pyi055_in_union(n) :- child(p4, n, _), kind(p4, "parenthesized_expression"), pyi055_in_union(p4).
pyi055_in_union(n) :- child(p5, n, _), kind(p5, "type"), child(p6, p5, _),
    ( kind(p6, "union_type")
    ; kind(p6, "type_parameter"), child(p1, p6, _), pyi055_union_sub(p1)
    ).


// type_head(n): the JSON util `type-head`, used where the JSON says `matches: "type-head"`
.decl pyi055_type_head(n: node)
pyi055_type_head(n) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "type"),
    sym_of(n, "builtins.type").
pyi055_type_head(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pyi055_type_head(c1).

// type_sub(n): the JSON util `type-sub`, used where the JSON says `matches: "type-sub"`
.decl pyi055_type_sub(n: node)
pyi055_type_sub(n) :- kind(n, "subscript"), field(n, "value", c1), pyi055_type_head(c1),
    count : { child(n, c2, _), pyi055_alt_3(c2) } = 0.

// type_gen(n): the JSON util `type-gen`, used where the JSON says `matches: "type-gen"`
.decl pyi055_type_gen(n: node)
pyi055_type_gen(n) :- kind(n, "generic_type"), child(n, c1, _), pyi055_type_head(c1),
    child(n, c2, _), kind(c2, "type_parameter"),
    count : { child(c2, c3, _), pyi055_alt_4(c3) } = 0.

// type_member(n): the JSON util `type-member`, used where the JSON says `matches: "type-member"`
.decl pyi055_type_member(n: node)
pyi055_type_member(n) :- pyi055_type_sub(n).
pyi055_type_member(n) :- pyi055_type_gen(n).

// flat(n): the JSON util `flat`, used where the JSON says `matches: "flat"`
.decl pyi055_flat(n: node)
pyi055_flat(n) :- (kind(n, "parenthesized_expression") ; kind(n, "type") ; kind(n, "type_parameter")).
pyi055_flat(n) :- pyi055_pipe(n).
pyi055_flat(n) :- pyi055_union_sub(n).
pyi055_flat(n) :- pyi055_sole_tuple(n).

// types_in(n): the JSON util `types-in`, used where the JSON says `matches: "types-in"`
.decl pyi055_types_in(n: node)
pyi055_types_in(n) :- pyi055_type_member(n).
pyi055_types_in(n) :- pyi055_flat(n), child(n, c1, _), pyi055_types_in(c1).

// many_types(n): the JSON util `many-types`, used where the JSON says `matches: "many-types"`
.decl pyi055_many_types(n: node)
pyi055_many_types(n) :- pyi055_demand_many_types(n), pyi055_flat(n), child(n, c1, _), pyi055_alt_5(c1).

// bad_union(n): the JSON util `bad-union`, used where the JSON says `matches: "bad-union"`
.decl pyi055_bad_union(n: node)
pyi055_bad_union(n) :- pyi055_union(n), pyi055_many_types(n), !pyi055_in_union(n).

// tc_test(n): the JSON util `tc-test`, used where the JSON says `matches: "tc-test"`
.decl pyi055_tc_test(n: node)
pyi055_tc_test(n) :- kind(n, "identifier"), glob("TYPE_CHECKING", n).
pyi055_tc_test(n) :- kind(n, "identifier"),
    ( sym_of(n, "typing.TYPE_CHECKING")
    ; sym_of(n, "typing_extensions.TYPE_CHECKING")
    ; sym_of(n, "_typeshed.TYPE_CHECKING")
    ).

pyi055_tc_test(n) :- kind(n, "attribute"), field(n, "attribute", c1),
    glob("TYPE_CHECKING", c1).
pyi055_tc_test(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), pyi055_tc_test(c2).

// in_tc_block(n): the JSON util `in-tc-block`, used where the JSON says `matches: "in-tc-block"`
.decl pyi055_in_tc_block(n: node)
pyi055_in_tc_block(n) :- inside(n, p1, "if_statement"), field(_, "consequence", n),
    field(p1, "condition", c2), pyi055_tc_test(c2).

// in_type_statement(n): the JSON util `in-type-statement`, used where the JSON says `matches: "in-type-statement"`
.decl pyi055_in_type_statement(n: node)
pyi055_in_type_statement(n) :- inside(n, p1, "type_alias_statement").
pyi055_in_type_statement(n) :- within(n, p2), field(_, "type_parameters", n),
