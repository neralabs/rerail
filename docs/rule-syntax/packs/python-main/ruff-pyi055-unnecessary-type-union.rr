// in_annotation_slot(n): the JSON util `in-annotation-slot`, used where the JSON says `matches: "in-annotation-slot"`
.decl pyi055_in_annotation_slot(n: node)
pyi055_in_annotation_slot(n) :- within(n, p1), field(_, "type", n),
    ( kind(p1, "assignment")
    ; kind(p1, "typed_parameter")
    ; kind(p1, "typed_default_parameter")
    ).

pyi055_in_annotation_slot(n) :- inside(n, p2, "function_definition"),
    field(_, "return_type", n).

// in_local_annotation(n): the JSON util `in-local-annotation`, used where the JSON says `matches: "in-local-annotation"`
.decl pyi055_in_local_annotation(n: node)
pyi055_in_local_annotation(n) :- inside(n, p1, "assignment"), field(_, "type", n),
    within_stop(p1, p2, pyi055_stop_6), kind(p2, "function_definition").

// future_file(n): the JSON util `future-file`, used where the JSON says `matches: "future-file"`
.decl pyi055_future_file(n: node)
pyi055_future_file(n) :- pyi055_demand_future_file(n), inside(n, p1, "module"), child(p1, c2, _),
    kind(c2, "future_import_statement"), child(c2, c3, _),
    ( kind(c3, "dotted_name"), glob("annotations", c3)
    ; kind(c3, "aliased_import"), child(c3, c1, _), kind(c1, "dotted_name"), glob("annotations", c1)
    ).


