    field(c4_5, "left", c5_5), c416_target_tuple_pair(c5_5, TK, TV), text(EK, t6_5),
    text(TK, t6_5), text(EV, t8_5), text(TV, t8_5), node(_, n, _, _, _), COMP = n, @doc(EK) = @doc(TK), @doc(EV) = @doc(TV).

// demand_alt_13: the rows of alt_13 its callers ask for (the metavariable columns they pass in)
.decl c416_demand_alt_13(n: node, f: loc, w: loc)
c416_demand_alt_13(n, F, W) :- c416_demand_shadowed(n, W), within(n, p25),
    field(p25, "body", f26), (f26 = n ; within(n, f26)),
    (kind(p25, "function_definition") ; kind(p25, "lambda")), node(_, p25, _, _, _), F = p25.

// demand_alt_14: the rows of alt_14 its callers ask for (the metavariable columns they pass in)
.decl c416_demand_alt_14(n: node, f: loc, w: loc)
c416_demand_alt_14(n, F, W) :- c416_demand_shadowed(n, W), inside(n, p49, "class_definition"),
    field(p49, "body", f50), (f50 = n ; within(n, f50)), node(_, p49, _, _, _), F = p49.

// demand_comp_binds: the rows of comp_binds its callers ask for (the metavariable columns they pass in)
.decl c416_demand_comp_binds(n: node, w: loc)
c416_demand_comp_binds(p77, W) :- c416_demand_shadowed(n, W), child(p77, n, _).
c416_demand_comp_binds(p79, W) :- c416_demand_shadowed(n, W), within(n, p78),
    c416_not_first_iter(p78), child(p79, p78, _).

// demand_kind_name: the rows of kind_name its callers ask for (the metavariable columns they pass in)
.decl c416_demand_kind_name(n: node, w: loc)
c416_demand_kind_name(c2, W) :- c416_demand_comp_binds(n, W), c416_comp(n), child(n, c1, _),
    kind(c1, "for_in_clause"), within(c2, c1), field(c1, "left", f3),
    (f3 = c2 ; within(c2, f3)).
c416_demand_kind_name(c2, W) :- c416_demand_shadowed(n, W), c416_fn_body(n), inside(n, p1, "module"),
    within(c2, p1), bind_name(c2, b4), site_scope(b4, "module").
c416_demand_kind_name(c1, W) :- c416_demand_shadowed(n, W), precedes(s1, n), within(c1, s1),
    bind_name(c1, b2), site_scope(b2, "module").
c416_demand_kind_name(c2, W) :- c416_demand_shadowed(n, W), within(n, p1), precedes(s2, p1),
    within(c2, s2), bind_name(c2, b4), site_scope(b4, "module").
c416_demand_kind_name(c18, W) :- c416_demand_shadowed(n, W), within(n, p14),
    field(p14, "body", f15), (f15 = n ; within(n, f15)),
    (kind(p14, "function_definition") ; kind(p14, "lambda")), within(p14, p16),
    field(p16, "body", f17), (f17 = p14 ; within(p14, f17)),
    (kind(p16, "function_definition") ; kind(p16, "lambda")), node(_, p16, _, _, _), F = p16,
    within(c18, p16), bind_name(c18, b20),
    (site_scope(b20, "function") ; site_scope(b20, "lambda")), st21 = b20,
    within(st21, p22), (kind(p22, "function_definition") ; kind(p22, "lambda")),
    node(_, p22, _, _, _), G = p22, node(_, G, _, _, _), node(_, F, _, _, _), G = F.
c416_demand_kind_name(c47, W) :- c416_demand_shadowed(n, W), inside(n, p44, "lambda"),
    field(p44, "body", f45), (f45 = n ; within(n, f45)), child(p44, c46, _),
    kind(c46, "lambda_parameters"), within(c47, c46), bind_name(c47, b48),
    site_scope(b48, "lambda").
c416_demand_kind_name(c76, W) :- c416_demand_shadowed(n, W), child(n, c73, _),
    kind(c73, "for_in_clause"), has(c73, c74, "named_expression"),
    field(c73, "right", f75), (f75 = c74 ; within(c74, f75)), field(c74, "name", c76).
c416_demand_kind_name(c84, W) :- c416_demand_shadowed(n, W), within_stop(n, p80, c416_stop_15),
    kind(p80, "block"), child(p81, p80, _), kind(p81, "except_clause"),
    child(p81, c82, _), kind(c82, "as_pattern"), child(c82, c83, _),
    kind(c83, "as_pattern_target"), child(c83, c84, _).
c416_demand_kind_name(c87, W) :- c416_demand_shadowed(n, W), within(n, p85),
    field(p85, "body", f86), (f86 = n ; within(n, f86)),
    (kind(p85, "function_definition") ; kind(p85, "class_definition")),
    within(c87, p85), field(p85, "type_parameters", f88),
    (f88 = c87 ; within(c87, f88)).
c416_demand_kind_name(c91, W) :- c416_demand_shadowed(n, W),
    inside(n, p89, "type_alias_statement"), field(p89, "right", f90),
    (f90 = n ; within(n, f90)), within(c91, p89), field(p89, "left", f92),
    (f92 = c91 ; within(c91, f92)), bind_name(c91, b93),
    main_form(b93, "typeParameter").
c416_demand_kind_name(c2, W) :- c416_demand_alt_13(n, F, W), precedes(s1, n), within(c2, s1),
    bind_name(c2, b4), (site_scope(b4, "function") ; site_scope(b4, "lambda")),
    st5 = b4, within(st5, p6), (kind(p6, "function_definition") ; kind(p6, "lambda")),
    node(_, p6, _, _, _), G = p6, node(_, G, _, _, _), node(_, F, _, _, _), G = F.
c416_demand_kind_name(c11, W) :- c416_demand_alt_13(n, F, W), within(n, p9), precedes(s10, p9),
    within(c11, s10), bind_name(c11, b13),
    (site_scope(b13, "function") ; site_scope(b13, "lambda")), st14 = b13,
    within(st14, p15), (kind(p15, "function_definition") ; kind(p15, "lambda")),
    node(_, p15, _, _, _), G = p15, node(_, G, _, _, _), node(_, F, _, _, _), G = F.
c416_demand_kind_name(c2, W) :- c416_demand_alt_14(n, F, W), precedes(s1, n), within(c2, s1),
    bind_name(c2, b4), site_scope(b4, "class"), st5 = b4,
    inside(st5, p6, "class_definition"), node(_, p6, _, _, _), G = p6, node(_, G, _, _, _),
    node(_, F, _, _, _), G = F.
c416_demand_kind_name(c11, W) :- c416_demand_alt_14(n, F, W), within(n, p9), precedes(s10, p9),
    within(c11, s10), bind_name(c11, b13), site_scope(b13, "class"), st14 = b13,
    inside(st14, p15, "class_definition"), node(_, p15, _, _, _), G = p15, node(_, G, _, _, _),
    node(_, F, _, _, _), G = F.

// demand_fn_body: the nodes fn_body is asked at (it looks at every ancestor of every node)
.decl c416_demand_fn_body(n: node)
c416_demand_fn_body(n) :- c416_demand_shadowed(n, W), inside(n, p1, "module"), within(c2, p1),
    bind_name(c2, b4), site_scope(b4, "module").

// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl c416_alt_1_u0_empty(n: node)

// dict_expr_u0_empty: level -1 of an unrolled recursion, empty
.decl c416_dict_expr_u0_empty(n: node)

// stop_15: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl c416_stop_15(kind: symbol)
c416_stop_15("function_definition"). c416_stop_15("lambda").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_1(n: node)
c416_alt_1(n) :- c416_alt_1_u7(n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_3(n: node)
c416_alt_3(n) :- ref_site(n, b1), (st2 = b1 ; within(b1, st2)),
    ( kind(st2, "dictionary_splat_pattern"), child(p1, st2, _), kind(p1, "parameters")
    ; kind(st2, "typed_parameter"), child(p2, st2, _), kind(p2, "parameters"), child(st2, c1, _), kind(c1, "dictionary_splat_pattern")
    ).

c416_alt_3(n) :- ref_site(n, b6), binding_value(b6, x7), c416_dict_init(x7), st8 = b6,
    count : { child(st8, c9, _), kind(c9, "type") } = 0.
c416_alt_3(n) :- ref_site(n, b10), (st11 = b10 ; within(b10, st11)),
    kind(st11, "as_pattern"), child(p12, st11, _), kind(p12, "with_item"),
    child(st11, c13, _), c416_dict_init(c13), c416_tok_precedes_5(c13), child(st11, c21, _),
    kind(c21, "as_pattern_target"), child(c21, c22, _), c416_plain_target(c22).
c416_alt_3(n) :- ref_site(n, b23), site_annotation(b23, o24), c416_dict_ann(o24), st25 = b23,
    count : { child(st25, c26, _), (kind(c26, "list_splat_pattern") ; kind(c26, "dictionary_splat_pattern")) } = 0.
c416_alt_3(n) :- ref_site(n, b27), (st28 = b27 ; within(b27, st28)),
    kind(st28, "function_definition"), child(st28, c29, _), kind(c29, "type"),
    child(c29, c30, _), c416_dict_ann(c30).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_5(n: node)
c416_alt_5(n) :- node(_, n, _, _, _), glob("[(),\\[\\]]", n).
c416_alt_5(n) :- kind(n, "comment").

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_6(n: node)
c416_alt_6(n) :- c416_any_pname(n).
c416_alt_6(n) :- node(_, n, _, _, _), glob("[(),\\[\\]]", n).
c416_alt_6(n) :- kind(n, "comment").

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_10(n: node)
c416_alt_10(n) :- c416_any_xname(n).
c416_alt_10(n) :- node(_, n, _, _, _), glob("[(),\\[\\]]", n).
c416_alt_10(n) :- kind(n, "comment").

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl c416_alt_11(n: node)
c416_alt_11(n) :- kind(n, "if_clause").
c416_alt_11(n) :- kind(n, "for_in_clause"), match("async\\b.*", n).

// alt_13(n): the JSON `any`: n matches if any one of these rules does
//   F, W: metavariables of the calling rule, passed in (bound by the caller)
//   KN: metavariable this relation binds for the calling rule
.decl c416_alt_13(n: node, f: loc, kn: symbol, w: loc)
c416_alt_13(n, F, KN, W) :- c416_demand_alt_13(n, F, W), precedes(s1, n), within(c2, s1),
    c416_kind_name(c2, KN, W),
    count : { bind_name(c2, b3), (main_form(b3, "except") ; main_form(b3, "annotation")) } = 0,
    bind_name(c2, b4), (site_scope(b4, "function") ; site_scope(b4, "lambda")),
    st5 = b4, within(st5, p6), (kind(p6, "function_definition") ; kind(p6, "lambda")),
    node(_, p6, _, _, _), G = p6, node(_, G, _, _, _), node(_, F, _, _, _), G = F, text(W, t1_td),
    KN = @replace_all(t1_td, "(?s)^.*$", "dict").
c416_alt_13(n, F, KN, W) :- c416_demand_alt_13(n, F, W), within(n, p9), precedes(s10, p9),
    within(c11, s10), c416_kind_name(c11, KN, W),
    count : { bind_name(c11, b12), (main_form(b12, "except") ; main_form(b12, "annotation")) } = 0,
    bind_name(c11, b13), (site_scope(b13, "function") ; site_scope(b13, "lambda")),
    st14 = b13, within(st14, p15),
    (kind(p15, "function_definition") ; kind(p15, "lambda")), node(_, p15, _, _, _), G = p15,
    node(_, G, _, _, _), node(_, F, _, _, _), G = F, text(W, t1_td),
    KN = @replace_all(t1_td, "(?s)^.*$", "dict").

// alt_14(n): the JSON `any`: n matches if any one of these rules does
//   F, W: metavariables of the calling rule, passed in (bound by the caller)
//   KN: metavariable this relation binds for the calling rule
.decl c416_alt_14(n: node, f: loc, kn: symbol, w: loc)
c416_alt_14(n, F, KN, W) :- c416_demand_alt_14(n, F, W), precedes(s1, n), within(c2, s1),
    c416_kind_name(c2, KN, W),
    count : { bind_name(c2, b3), (main_form(b3, "except") ; main_form(b3, "annotation")) } = 0,
    bind_name(c2, b4), site_scope(b4, "class"), st5 = b4,
    inside(st5, p6, "class_definition"), node(_, p6, _, _, _), G = p6,
    node(_, G, _, _, _), node(_, F, _, _, _), G = F, text(W, t1_td),
    KN = @replace_all(t1_td, "(?s)^.*$", "dict").
c416_alt_14(n, F, KN, W) :- c416_demand_alt_14(n, F, W), within(n, p9), precedes(s10, p9),
    within(c11, s10), c416_kind_name(c11, KN, W),
    count : { bind_name(c11, b12), (main_form(b12, "except") ; main_form(b12, "annotation")) } = 0,
    bind_name(c11, b13), site_scope(b13, "class"), st14 = b13,
    inside(st14, p15, "class_definition"), node(_, p15, _, _, _), G = p15,
    node(_, G, _, _, _), node(_, F, _, _, _), G = F, text(W, t1_td),
    KN = @replace_all(t1_td, "(?s)^.*$", "dict").

// alt_17(n): the JSON `any`: n matches if any one of these rules does
//   W: metavariable of the calling rule, passed in (bound by the caller)
//   COMP, IT, KN, TK, TV: metavariables this relation binds for the calling rule
.decl c416_alt_17(n: node, c416_comp: loc, it: loc, kn: symbol, tk: loc, tv: loc, w: loc)
// KN, TK, TV: not bound by this rule, so empty (unset) here, as in ast-grep.
c416_alt_17(n, COMP, IT, KN, TK, TV, W) :- c416_demand_alt_17(n, W),
    kind(n, "list_comprehension"), c416_single_for(n, IT), (field(n, "body", c1_1_6), c416_name_elt(c1_1_6, E), child(n, c2_1_6, _), kind(c2_1_6, "for_in_clause"), field(c2_1_6, "left", c3_1_6), c416_name_tgt(c3_1_6, T), text(E, t4_1_6), text(T, t4_1_6), @doc(E) = @doc(T) ; child(n, c6_2_6, _), kind(c6_2_6, "for_in_clause"), field(c6_2_6, "right", c7_2_6), c416_items_call(c7_2_6), field(c6_2_6, "left", c8_2_6), c416_target_pair(c8_2_6, TK, TV), field(n, "body", c9_2_6), c416_tuple_pair(c9_2_6, EK, EV), text(EK, t10_2_6), text(TK, t10_2_6), text(EV, t12_2_6), text(TV, t12_2_6), @doc(EK) = @doc(TK), @doc(EV) = @doc(TV) ), !c416_shadowed(n, _, W), node(_, n, _, _, _), COMP = n,
    unset(KN), unset(TK), unset(TV).
c416_alt_17(n, COMP, IT, KN, TK, TV, W) :- c416_demand_alt_17(n, W),
    c416_list_comprehension_in_annotation(n, COMP, IT, KN, TK, TV, W), text(W, t1_td),
    KN = @replace_all(t1_td, "(?s)^.*$", "dict").

// alt_19(n): the JSON `any`: n matches if any one of these rules does
//   W: metavariable of the calling rule, passed in (bound by the caller)
//   COMP, IT, KN, TK, TV: metavariables this relation binds for the calling rule
.decl c416_alt_19(n: node, c416_comp: loc, it: loc, kn: symbol, tk: loc, tv: loc, w: loc)
// KN, TK, TV: not bound by this rule, so empty (unset) here, as in ast-grep.
c416_alt_19(n, COMP, IT, KN, TK, TV, W) :- c416_demand_alt_19(n, W),
    kind(n, "set_comprehension"), c416_single_for(n, IT), (field(n, "body", c1_3_7), c416_name_elt(c1_3_7, E), child(n, c2_3_7, _), kind(c2_3_7, "for_in_clause"), field(c2_3_7, "left", c3_3_7), c416_name_tgt(c3_3_7, T), text(E, t4_3_7), text(T, t4_3_7), @doc(E) = @doc(T) ; child(n, c6_4_7, _), kind(c6_4_7, "for_in_clause"), field(c6_4_7, "right", c7_4_7), c416_items_call(c7_4_7), field(c6_4_7, "left", c8_4_7), c416_target_pair(c8_4_7, TK, TV), field(n, "body", c9_4_7), c416_tuple_pair(c9_4_7, EK, EV), text(EK, t10_4_7), text(TK, t10_4_7), text(EV, t12_4_7), text(TV, t12_4_7), @doc(EK) = @doc(TK), @doc(EV) = @doc(TV) ), !c416_shadowed(n, _, W), node(_, n, _, _, _), COMP = n,
    unset(KN), unset(TK), unset(TV).
c416_alt_19(n, COMP, IT, KN, TK, TV, W) :- c416_demand_alt_19(n, W),
    c416_set_comprehension_in_annotation(n, COMP, IT, KN, TK, TV, W), text(W, t1_td),
    KN = @replace_all(t1_td, "(?s)^.*$", "dict").

// alt_20(n): the JSON `any`: n matches if any one of these rules does
//   W: metavariable of the calling rule, passed in (bound by the caller)
//   COMP, EK, EV, IT, KN, TK, TV: metavariables this relation binds for the calling rule
.decl c416_alt_20(n: node, c416_comp: loc, ek: loc, ev: loc, it: loc, kn: symbol, tk: loc, tv: loc, w: loc)
// KN: not bound by this rule, so empty (unset) here, as in ast-grep.
c416_alt_20(n, COMP, EK, EV, IT, KN, TK, TV, W) :- c416_demand_alt_20(n, W),
    kind(n, "dictionary_comprehension"), c416_single_for(n, IT), field(n, "body", c1_5), kind(c1_5, "pair"), field(c1_5, "key", c2_5), c416_name_key(c2_5, EK), field(c1_5, "value", c3_5), c416_name_value(c3_5, EV), child(n, c4_5, _), kind(c4_5, "for_in_clause"), field(c4_5, "left", c5_5), c416_target_tuple_pair(c5_5, TK, TV), text(EK, t6_5), text(TK, t6_5), text(EV, t8_5), text(TV, t8_5), !c416_shadowed(n, _, W), node(_, n, _, _, _), COMP = n,
    unset(KN), @doc(EK) = @doc(TK), @doc(EV) = @doc(TV).
c416_alt_20(n, COMP, EK, EV, IT, KN, TK, TV, W) :- c416_demand_alt_20(n, W),
    c416_dict_comprehension_in_annotation(n, COMP, EK, EV, IT, KN, TK, TV, W),
    text(W, t1_td), KN = @replace_all(t1_td, "(?s)^.*$", "dict").
