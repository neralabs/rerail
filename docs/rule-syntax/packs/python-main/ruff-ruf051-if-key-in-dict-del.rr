// set_15: node kinds from a JSON `any`
.decl ruf051_set_15(v: symbol)
ruf051_set_15("identifier"). ruf051_set_15("none"). ruf051_set_15("ellipsis"). ruf051_set_15("true").
ruf051_set_15("false"). ruf051_set_15("integer"). ruf051_set_15("float").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf051_stop_1(n: node)
ruf051_stop_1(n) :- node(_, n, _, _, _), !ruf051_trivia(n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl ruf051_alt_3(n: node)
ruf051_alt_3(n) :- ruf051_alt_3_u7(n).

// stop_11(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf051_stop_11(n: node)
ruf051_stop_11(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// alt_18(n): the JSON `any`: n matches if any one of these rules does
.decl ruf051_alt_18(n: node)
ruf051_alt_18(n) :- ruf051_trivia(n).
ruf051_alt_18(n) :- node(_, n, _, _, _), glob("\\,", n).

// alt_21(n): the JSON `any`: n matches if any one of these rules does
.decl ruf051_alt_21(n: node)
ruf051_alt_21(n) :- ruf051_trivia(n).
ruf051_alt_21(n) :- node(_, n, _, _, _), glob(";", n).
