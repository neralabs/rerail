.policy "ruff-ruf051-if-key-in-dict-del" revision 1
.guests off
.description "Use dict pop with a None default instead of testing a key with in and then deleting it; it removes the key in one step."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// RUF051(n): a finding at node n, from clause `if-key-in-dict-del`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF051(at: node, del: node, d: loc, k: loc) "Use `{d}.pop({k}, None)` instead of checking `{k} in {d}` and then running `del {d}[{k}]`; keep any comments from the removed lines."
    suppress noqa "RUF051"
RUF051(DEL, n, D, K) :- kind(n, "if_statement"),
    count : { child(n, c1, _), (kind(c1, "elif_clause") ; kind(c1, "else_clause")) } = 0,
    field(n, "condition", c2), ruf051_key_in_dict(c2, D, K), field(n, "consequence", c3),
    kind(c3, "block"), k5 = count : { child(c3, c4, _), !ruf051_alt_21(c4) }, k5 >= 1,
    k5 <= 1, child(c3, c6, _), ruf051_sole_del(c6, E, L), node(_, c6, _, _, _), DEL = c6,
    value(K, t7), value(L, t7), value(D, t9), value(E, t9).

