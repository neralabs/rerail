.policy "ruff-ann002-missing-type-args" revision 1
.guests off
.description "Annotate variadic positional parameters with the type of each extra argument so type checkers can verify calls."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// ANN002(n): a finding at node n, from clause `missing-type-args`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation ANN002(at: node, name: loc) "Add a type annotation to `*{name}` giving the type of each extra positional argument."
    suppress noqa "ANN002"
ANN002(n, NAME) :- kind(n, "list_splat_pattern"), child(n, c1, _),
    kind(c1, "identifier"), node(_, c1, _, _, _), NAME = c1, child(p2, n, _), kind(p2, "parameters"),
    child(p3, p2, _), kind(p3, "function_definition"), child(p3, c4, _),
    kind(c4, "identifier"), node(_, c4, _, _, _), FN = c4, !ann002_overload_implementation(p3, FN).

// overload_expr(n): the JSON util `overload-expr`, used where the JSON says `matches: "overload-expr"`
.decl ann002_overload_expr(n: node)
ann002_overload_expr(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.overload")
    ; sym_of(n, "typing_extensions.overload")
    ; sym_of(n, "_typeshed.overload")
    ).

ann002_overload_expr(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ann002_overload_expr(c1).

// overload_decorated(n): the JSON util `overload-decorated`, used where the JSON says `matches: "overload-decorated"`
.decl ann002_overload_decorated(n: node)
ann002_overload_decorated(n) :- kind(n, "decorated_definition"), child(n, c1, _),
    kind(c1, "decorator"), child(c1, c2, _), ann002_overload_expr(c2).

// definition_statement(n): the JSON util `definition-statement`, used where the JSON says `matches: "definition-statement"`
.decl ann002_definition_statement(n: node)
ann002_definition_statement(n) :-
    ( kind(n, "function_definition")
    ; kind(n, "class_definition")
    ; kind(n, "decorated_definition")
    ).


// holds_definition(n): the JSON util `holds-definition`, used where the JSON says `matches: "holds-definition"`
.decl ann002_holds_definition(n: node)
ann002_holds_definition(n) :- ann002_definition_statement(n).
ann002_holds_definition(n) :- within_stop(c1, n, ann002_stop_1), ann002_definition_statement(c1).

// last_definition_is_overload(n): the JSON util `last-definition-is-overload`, used where the JSON says `matches: "last-definition-is-overload"`
//   FN: metavariable this relation binds for the calling rule
.decl ann002_last_definition_is_overload(n: node, fn: loc)
ann002_last_definition_is_overload(n, FN) :- ann002_overload_decorated(n), child(n, c1, _),
    kind(c1, "function_definition"), child(c1, c2, _), kind(c2, "identifier"),
    node(_, c2, _, _, _), FN = c2.
ann002_last_definition_is_overload(n, FN) :- !ann002_alt_2(n), child(n, c4, _), ann002_holds_definition(c4),
    count : { precedes(c4, s5), ann002_holds_definition(s5) } = 0,
    ann002_last_definition_is_overload(c4, FN).

// previous_overload(n): the JSON util `previous-overload`, used where the JSON says `matches: "previous-overload"`
//   FN: metavariable this relation binds for the calling rule
.decl ann002_previous_overload(n: node, fn: loc)
ann002_previous_overload(n, FN) :- precedes_stop(s1, n, ann002_stop_3),
    ann002_last_definition_is_overload(s1, FN).
ann002_previous_overload(n, FN) :- count : { precedes(s2, n), ann002_holds_definition(s2) } = 0,
    child(p3, n, _), !kind(p3, "function_definition"), !kind(p3, "class_definition"),
    !kind(p3, "module"), ann002_previous_overload(p3, FN).

// overload_implementation(n): the JSON util `overload-implementation`, used where the JSON says `matches: "overload-implementation"`
//   FN: metavariable of the calling rule, passed in (bound by the caller)
.decl ann002_overload_implementation(n: node, fn: loc)
ann002_overload_implementation(n, FN) :- ann002_demand_overload_implementation(n, FN),
    count : { child(p1, n, _), ann002_overload_decorated(p1) } = 0, ann002_previous_overload(n, FN).

// demand_overload_implementation: the rows of overload_implementation its callers ask for (the metavariable columns they pass in)
.decl ann002_demand_overload_implementation(n: node, fn: loc)
ann002_demand_overload_implementation(p3, FN) :- kind(n, "list_splat_pattern"),
    child(n, c1, _), kind(c1, "identifier"), node(_, c1, _, _, _), NAME = c1, child(p2, n, _),
    kind(p2, "parameters"), child(p3, p2, _), kind(p3, "function_definition"),
    child(p3, c4, _), kind(c4, "identifier"), node(_, c4, _, _, _), FN = c4.

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ann002_stop_1(n: node)
ann002_stop_1(n) :- ann002_definition_statement(n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl ann002_alt_2(n: node)
ann002_alt_2(n) :- kind(n, "function_definition").
ann002_alt_2(n) :- kind(n, "decorated_definition"), child(n, c1, _),
    kind(c1, "function_definition").

// stop_3(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ann002_stop_3(n: node)
ann002_stop_3(n) :- ann002_holds_definition(n).
