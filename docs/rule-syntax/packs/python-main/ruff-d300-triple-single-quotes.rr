.policy "ruff-d300-triple-single-quotes" revision 1
.guests off
.description "Use triple double quotes for docstrings, or triple single quotes when the text itself contains triple double quotes."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// docstring(n): the JSON util `docstring`, used where the JSON says `matches: "docstring"`
.decl d300_docstring(n: node)
d300_docstring(n) :- kind(n, "string"), match("[rRuU]{0,2}['\"].*", n), child(n, c1, _),
    kind(c1, "string_content"), match(".*\\S.*", c1), within_stop(n, p2, d300_stop_1),
    kind(p2, "expression_statement"), child(p3, p2, _), d300_counted_2(p2),
    k5 = count : { child(p3, s4, _), precedes(s4, p2), d300_counted_2(s4) }, k5 = 0,
    !d300_tok_has_1(p2),
    ( child(p1, p2, _), kind(p1, "module")
    ; child(p4, p2, _), kind(p4, "block"), child(p5, p4, _), (kind(p5, "function_definition") ; kind(p5, "class_definition"))
    ).


// D300(n, detail): findings from clauses `use-triple-double-quotes`, `use-triple-single-quotes`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
.violation D300(at: node, detail: symbol) "Rewrite this docstring with triple {detail}."
    suppress noqa "D300"
D300(n, "double quotes `\"\"\"`; if its text ends with a double quote, escape that quote or reword it") :- d300_docstring(n),
    count : { child(n, c1, _), kind(c1, "string_start"), suffix("\"\"\"", c1) } = 0,
    count : { child(n, c2, _), kind(c2, "string_content"), contains("\"\"\"", c2) } = 0.
D300(n, "single quotes `'''`, since its text contains `\"\"\"`; if its text ends with a single quote, escape that quote") :- d300_docstring(n),
    count : { child(n, c1, _), kind(c1, "string_start"), suffix("'''", c1) } = 0,
    child(n, c2, _), kind(c2, "string_content"), contains("\"\"\"", c2),
    count : { child(n, c3, _), kind(c3, "string_content"), contains("'''", c3) } = 0.

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d300_tok_has_1(n: node)
.stored d300_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d300_tok_has_1(n) :- child(n, c6, _), glob("\\,", c6).
d300_tok_has_1(n) :- op(n, t7), match(",", t7).
d300_tok_has_1(n) :- child(n, c13, _), structural_before(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
d300_tok_has_1(n) :- child(n, c13, _), structural_after(c13, g8),
    match("(?s)^(?:.*(?:,).*)$", g8).
d300_tok_has_1(n) :- node_text(n, g8), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g8).

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl d300_stop_1(n: node)
d300_stop_1(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// counted_2(n): the siblings the JSON `nthChild.ofRule` counts
.decl d300_counted_2(n: node)
d300_counted_2(n) :- node(_, n, _, _, _), !kind(n, "comment").
