    child(n, c3, _), ruf019_tuple_3(c3, K1, K2, K3), precedes_stop(c3, s4, ruf019_stop_10),
    glob("in", s4).
ruf019_tuple_key_in_dict_3(n, D, K, K1, K2, K3) :- kind(n, "parenthesized_expression"),
