.policy "ruff-ruf019-unnecessary-key-check" revision 1
.guests off
.description "Use dict.get() instead of testing a key with in and then indexing the dictionary in the same condition; get() returns None for a missing key."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// RUF019(n): a finding at node n, from clause `unnecessary-key-check`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF019(at: node, c: node, d: loc, k: loc) "If `{d}` is a dict, use `{d}.get({k})` instead of testing `{k} in {d}` before reading `{d}[{k}]`; leave it if `{d}` is not a mapping."
    suppress noqa "RUF019"
RUF019(C, n, D, K) :- ruf019_unnecessary_key_check(n, D, K), node(_, n, _, _, _), C = n.
RUF019(C, n, D, K) :- ruf019_check_in_string(n, C, D, K).

// safe_binop_operand(n): the JSON util `safe-binop-operand`, used where the JSON says `matches: "safe-binop-operand"`
.decl ruf019_safe_binop_operand(n: node)
ruf019_safe_binop_operand(n) :-
    ( kind(n, k1), ruf019_set_1(k1)
    ; kind(n, "string"), !ruf019_tstring(n)
    ; kind(n, "concatenated_string"), count : { child(n, c1, _), ruf019_tstring(c1) } = 0
    ).

ruf019_safe_binop_operand(n) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    ruf019_safe_binop_operand(c3).

// effect(n): the JSON util `effect`, used where the JSON says `matches: "effect"`
.decl ruf019_effect(n: node)
ruf019_effect(n) :- kind(n, k1), ruf019_set_4(k1).
ruf019_effect(n) :- kind(n, "call"),
    count : { field(n, "function", c2), ruf019_iterable_init(c2), field(n, "arguments", c3), match("\\((?:\\s|#[^\\n]*)*\\)", c3) } = 0.
ruf019_effect(n) :- kind(n, "binary_operator"), child(n, c4, _), !ruf019_alt_5(c4).

// bool_callee(n): the JSON util `bool-callee`, used where the JSON says `matches: "bool-callee"`
.decl ruf019_bool_callee(n: node)
ruf019_bool_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "bool"), sym_of(n, "builtins.bool").
ruf019_bool_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ruf019_bool_callee(c1).

// boolean_test(n): the JSON util `boolean-test`, used where the JSON says `matches: "boolean-test"`
.decl ruf019_boolean_test(n: node)
ruf019_boolean_test(n) :- child(p1, n, _), kind(p1, "not_operator").
ruf019_boolean_test(n) :- ruf019_tok_follows_1(n), child(p9, n, _),
    ( kind(p9, "if_statement")
    ; kind(p9, "elif_clause")
    ; kind(p9, "while_statement")
    ; kind(p9, "conditional_expression")
    ).

ruf019_boolean_test(n) :- ruf019_tok_follows_2(n).
ruf019_boolean_test(n) :- child(p17, n, _), kind(p17, "if_clause").
ruf019_boolean_test(n) :- precedes_stop(s18, n, ruf019_stop_10), glob("(", s18), child(p19, n, _),
    kind(p19, "argument_list"), child(p20, p19, _), kind(p20, "call"),
    field(p20, "function", c21), ruf019_bool_callee(c21).
ruf019_boolean_test(n) :- child(p22, n, _),
    (kind(p22, "parenthesized_expression") ; kind(p22, "boolean_operator")),
    ruf019_boolean_test(p22).

// and_op(n): the JSON util `and-op`, used where the JSON says `matches: "and-op"`
.decl ruf019_and_op(n: node)
ruf019_and_op(n) :- kind(n, "boolean_operator"), ruf019_tok_has_3(n).

// key_in_dict(n): the JSON util `key-in-dict`, used where the JSON says `matches: "key-in-dict"`
//   D, K: metavariables this relation binds for the calling rule
.decl ruf019_key_in_dict(n: node, d: loc, k: loc)
ruf019_key_in_dict(n, D, K) :- kind(n, "comparison_operator"), n ~ `$K in $D`,
    k2 = count : { child(n, c1, _), !kind(c1, "comment") }, k2 <= 3.
ruf019_key_in_dict(n, D, K) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    ruf019_key_in_dict(c3, D, K).

// dict_item(n): the JSON util `dict-item`, used where the JSON says `matches: "dict-item"`
//   E, L: metavariables this relation binds for the calling rule
.decl ruf019_dict_item(n: node, e: loc, l: loc)
ruf019_dict_item(n, E, L) :- kind(n, "subscript"), n ~ `$E[$L]`, !ruf019_tok_has_4(n).
ruf019_dict_item(n, E, L) :- kind(n, "parenthesized_expression"), child(n, c9, _),
    ruf019_dict_item(c9, E, L).

// tuple_key_in_dict_1(n): the JSON util `tuple-key-in-dict-1`, used where the JSON says `matches: "tuple-key-in-dict-1"`
//   D, K, K1: metavariables this relation binds for the calling rule
.decl ruf019_tuple_key_in_dict_1(n: node, d: loc, k: loc, k1: loc)
ruf019_tuple_key_in_dict_1(n, D, K, K1) :- kind(n, "comparison_operator"), n ~ `$K in $D`,
    k2 = count : { child(n, c1, _), !kind(c1, "comment") }, k2 <= 3, child(n, c3, _),
    ruf019_tuple_1(c3, K1), precedes_stop(c3, s4, ruf019_stop_10), glob("in", s4).
ruf019_tuple_key_in_dict_1(n, D, K, K1) :- kind(n, "parenthesized_expression"),
    child(n, c5, _), ruf019_tuple_key_in_dict_1(c5, D, K, K1).

// tuple_dict_item_1(n): the JSON util `tuple-dict-item-1`, used where the JSON says `matches: "tuple-dict-item-1"`
//   E, L1: metavariables this relation binds for the calling rule
.decl ruf019_tuple_dict_item_1(n: node, e: loc, l1: loc)
ruf019_tuple_dict_item_1(n, E, L1) :- kind(n, "subscript"), n ~ `$E[$L1,]`.
ruf019_tuple_dict_item_1(n, E, L1) :- kind(n, "subscript"), n ~ `$E[$L1]`, child(n, c1, _),
    kind(c1, "list_splat").
ruf019_tuple_dict_item_1(n, E, L1) :- kind(n, "parenthesized_expression"), child(n, c2, _),
