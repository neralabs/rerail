// tuple_dict_item_3(n): the JSON util `tuple-dict-item-3`, used where the JSON says `matches: "tuple-dict-item-3"`
//   E, L1, L2, L3: metavariables this relation binds for the calling rule
.decl ruf019_tuple_dict_item_3(n: node, e: loc, l1: loc, l2: loc, l3: loc)
ruf019_tuple_dict_item_3(n, E, L1, L2, L3) :- kind(n, "subscript"), n ~ `$E[$L1, $L2, $L3]`.
ruf019_tuple_dict_item_3(n, E, L1, L2, L3) :- kind(n, "parenthesized_expression"),
