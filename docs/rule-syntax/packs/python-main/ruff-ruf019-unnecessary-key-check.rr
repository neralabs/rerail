.decl ruf019_tuple_dict_item_4(n: node, e: loc, l1: loc, l2: loc, l3: loc, l4: loc)
ruf019_tuple_dict_item_4(n, E, L1, L2, L3, L4) :- kind(n, "subscript"),
    n ~ `$E[$L1, $L2, $L3, $L4]`.
ruf019_tuple_dict_item_4(n, E, L1, L2, L3, L4) :- kind(n, "parenthesized_expression"),
    child(n, c1, _), ruf019_tuple_dict_item_4(c1, E, L1, L2, L3, L4).

// unnecessary_key_check(n): the JSON util `unnecessary-key-check`, used where the JSON says `matches: "unnecessary-key-check"`
//   D, K: metavariables this relation binds for the calling rule
.decl ruf019_unnecessary_key_check(n: node, d: loc, k: loc)
ruf019_unnecessary_key_check(n, D, K) :- ruf019_and_op(n), ruf019_boolean_test(n),
    count : { child(p1, n, _), ruf019_and_op(p1) } = 0, field(n, "left", c2),
    count : { within(c3, c2), ruf019_effect(c3) } = 0, ruf019_alt_11(n, D, K).

// check_in_string(n): the JSON util `check-in-string`, used where the JSON says `matches: "check-in-string"`
//   C, D, K: metavariables this relation binds for the calling rule
.decl ruf019_check_in_string(n: node, c: loc, d: loc, k: loc)
ruf019_check_in_string(n, C, D, K) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ruf019_alt_12(c2, C, D, K).

// tstring(n): the JSON util `tstring`, used where the JSON says `matches: "tstring"`
.decl ruf019_tstring(n: node)
ruf019_tstring(n) :- kind(n, "string"), child(n, c1, _), kind(c1, "string_start"),
    match("[A-Za-z]*[tT].*", c1).

// iterable_init(n): the JSON util `iterable-init`, used where the JSON says `matches: "iterable-init"`
.decl ruf019_iterable_init(n: node)
ruf019_iterable_init(n) :- kind(n, "identifier"), global_ref(n, g1), ruf019_set_13(g1).
ruf019_iterable_init(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    ruf019_iterable_init(c2).

// tuple_1(n): the JSON util `tuple-1`, used where the JSON says `matches: "tuple-1"`
//   K1: metavariable this relation binds for the calling rule
.decl ruf019_tuple_1(n: node, k1: loc)
ruf019_tuple_1(n, K1) :- kind(n, "tuple"), n ~ `($K1,)`.
ruf019_tuple_1(n, K1) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ruf019_tuple_1(c1, K1).

// tuple_2(n): the JSON util `tuple-2`, used where the JSON says `matches: "tuple-2"`
