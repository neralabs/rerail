// tuple_key_in_dict_4(n): the JSON util `tuple-key-in-dict-4`, used where the JSON says `matches: "tuple-key-in-dict-4"`
//   D, K, K1, K2, K3, K4: metavariables this relation binds for the calling rule
.decl ruf019_tuple_key_in_dict_4(n: node, d: loc, k: loc, k1: loc, k2: loc, k3: loc, k4: loc)
ruf019_tuple_key_in_dict_4(n, D, K, K1, K2, K3, K4) :- kind(n, "comparison_operator"),
    n ~ `$K in $D`, k2 = count : { child(n, c1, _), !kind(c1, "comment") }, k2 <= 3,
    child(n, c3, _), ruf019_tuple_4(c3, K1, K2, K3, K4), precedes_stop(c3, s4, ruf019_stop_10),
