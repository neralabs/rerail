// tuple_3(n): the JSON util `tuple-3`, used where the JSON says `matches: "tuple-3"`
//   K1, K2, K3: metavariables this relation binds for the calling rule
.decl ruf019_tuple_3(n: node, k1: loc, k2: loc, k3: loc)
ruf019_tuple_3(n, K1, K2, K3) :- kind(n, "tuple"), n ~ `($K1, $K2, $K3)`.
ruf019_tuple_3(n, K1, K2, K3) :- kind(n, "parenthesized_expression"), child(n, c1, _),
