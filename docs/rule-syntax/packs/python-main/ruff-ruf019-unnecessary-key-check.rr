// tuple_4(n): the JSON util `tuple-4`, used where the JSON says `matches: "tuple-4"`
//   K1, K2, K3, K4: metavariables this relation binds for the calling rule
.decl ruf019_tuple_4(n: node, k1: loc, k2: loc, k3: loc, k4: loc)
ruf019_tuple_4(n, K1, K2, K3, K4) :- kind(n, "tuple"), n ~ `($K1, $K2, $K3, $K4)`.
ruf019_tuple_4(n, K1, K2, K3, K4) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ruf019_tuple_4(c1, K1, K2, K3, K4).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^(if|elif|while)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf019_tok_follows_1(n: node)
.stored ruf019_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf019_tok_follows_1(n) :- next_sibling(s2, n), glob("{if,elif,while}", s2).
ruf019_tok_follows_1(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(if|elif|while)", t3).
ruf019_tok_follows_1(n) :- structural_before(n, g4),
    match("(?s)^(?:(?:.*\\W)?(?:if)\\s*|(?:.*\\W)?(?:elif)\\s*|(?:.*\\W)?(?:while)\\s*)$", g4).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^assert$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf019_tok_follows_2(n: node)
.stored ruf019_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf019_tok_follows_2(n) :- next_sibling(s10, n), glob("assert", s10).
ruf019_tok_follows_2(n) :- structural_before(n, g12), match("\\s*", g12), child(p13, n, _),
    node(_, n, _, st15, _), o14 = st15 - strlen(g12), token(p13, _, t11, _, o14),
    match("assert", t11).
ruf019_tok_follows_2(n) :- structural_before(n, g12),
    match("(?s)^(?:(?:.*\\W)?(?:assert)\\s*)$", g12).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^and$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf019_tok_has_3(n: node)
.stored ruf019_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf019_tok_has_3(n) :- child(n, c1, _), glob("and", c1).
ruf019_tok_has_3(n) :- op(n, t2), match("and", t2).
ruf019_tok_has_3(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:and)(?:\\W.*)?)$", g3).
ruf019_tok_has_3(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:and)(?:\\W.*)?)$", g3).
ruf019_tok_has_3(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:and)(?:\\W.*)?)$", g3).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf019_tok_has_4(n: node)
.stored ruf019_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf019_tok_has_4(n) :- child(n, c1, _), glob("\\,", c1).
ruf019_tok_has_4(n) :- op(n, t2), match(",", t2).
ruf019_tok_has_4(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
ruf019_tok_has_4(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
ruf019_tok_has_4(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// set_1: node kinds from a JSON `any`
.decl ruf019_set_1(v: symbol)
ruf019_set_1("integer"). ruf019_set_1("float"). ruf019_set_1("true"). ruf019_set_1("false"). ruf019_set_1("none").
ruf019_set_1("ellipsis"). ruf019_set_1("list"). ruf019_set_1("tuple"). ruf019_set_1("set"). ruf019_set_1("dictionary").
ruf019_set_1("list_comprehension"). ruf019_set_1("set_comprehension").
ruf019_set_1("dictionary_comprehension").

// set_4: node kinds from a JSON `any`
.decl ruf019_set_4(v: symbol)
ruf019_set_4("named_expression"). ruf019_set_4("await"). ruf019_set_4("yield"). ruf019_set_4("subscript").
ruf019_set_4("list_comprehension"). ruf019_set_4("set_comprehension").
ruf019_set_4("dictionary_comprehension"). ruf019_set_4("generator_expression").

// set_13: names from the JSON `resolves.global`
.decl ruf019_set_13(v: symbol)
ruf019_set_13("list"). ruf019_set_13("tuple"). ruf019_set_13("set"). ruf019_set_13("dict"). ruf019_set_13("frozenset").

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl ruf019_alt_5(n: node)
ruf019_alt_5(n) :- ruf019_safe_binop_operand(n).
ruf019_alt_5(n) :- node(_, n, _, _, _), glob("{+,-,\\*,/,//,%,\\*\\*,<<,>>,&,|,^,@}", n).

// stop_10(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf019_stop_10(n: node)
ruf019_stop_10(n) :- node(_, n, _, _, _), !kind(n, "comment").

// alt_11(n): the JSON `any`: n matches if any one of these rules does
//   D, K: metavariables this relation binds for the calling rule
.decl ruf019_alt_11(n: node, d: loc, k: loc)
ruf019_alt_11(n, D, K) :- field(n, "left", c1), ruf019_key_in_dict(c1, D, K), field(n, "right", c2),
    ruf019_dict_item(c2, E, L), value(K, t3), value(L, t3), value(D, t5), value(E, t5).
ruf019_alt_11(n, D, K) :- field(n, "left", c7), ruf019_tuple_key_in_dict_1(c7, D, K, K1),
    field(n, "right", c8), ruf019_tuple_dict_item_1(c8, E, L1), value(K1, t9), value(L1, t9),
    value(D, t11), value(E, t11).
ruf019_alt_11(n, D, K) :- field(n, "left", c13), ruf019_tuple_key_in_dict_2(c13, D, K, K1, K2),
    field(n, "right", c14), ruf019_tuple_dict_item_2(c14, E, L1, L2),
    value(K1, t15), value(L1, t15), value(K2, t17), value(L2, t17),
    value(D, t19), value(E, t19).
ruf019_alt_11(n, D, K) :- field(n, "left", c21), ruf019_tuple_key_in_dict_3(c21, D, K, K1, K2, K3),
    field(n, "right", c22), ruf019_tuple_dict_item_3(c22, E, L1, L2, L3),
    value(K1, t23), value(L1, t23), value(K2, t25), value(L2, t25),
    value(K3, t27), value(L3, t27), value(D, t29), value(E, t29).
ruf019_alt_11(n, D, K) :- field(n, "left", c31),
    ruf019_tuple_key_in_dict_4(c31, D, K, K1, K2, K3, K4), field(n, "right", c32),
    ruf019_tuple_dict_item_4(c32, E, L1, L2, L3, L4), value(K1, t33), value(L1, t33),
    value(K2, t35), value(L2, t35), value(K3, t37), value(L3, t37),
    value(K4, t39), value(L4, t39), value(D, t41), value(E, t41).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
//   C, D, K: metavariables this relation binds for the calling rule
.decl ruf019_alt_12(n: node, c: loc, d: loc, k: loc)
ruf019_alt_12(n, C, D, K) :- ruf019_unnecessary_key_check(n, D, K), node(_, n, _, _, _), C = n, C = n.
ruf019_alt_12(n, C, D, K) :- ruf019_check_in_string(n, C, D, K).
