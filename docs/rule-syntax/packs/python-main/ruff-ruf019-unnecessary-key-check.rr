// tuple_dict_item_2(n): the JSON util `tuple-dict-item-2`, used where the JSON says `matches: "tuple-dict-item-2"`
//   E, L1, L2: metavariables this relation binds for the calling rule
.decl ruf019_tuple_dict_item_2(n: node, e: loc, l1: loc, l2: loc)
ruf019_tuple_dict_item_2(n, E, L1, L2) :- kind(n, "subscript"), n ~ `$E[$L1, $L2]`.
ruf019_tuple_dict_item_2(n, E, L1, L2) :- kind(n, "parenthesized_expression"),
    child(n, c1, _), ruf019_tuple_dict_item_2(c1, E, L1, L2).

// tuple_key_in_dict_3(n): the JSON util `tuple-key-in-dict-3`, used where the JSON says `matches: "tuple-key-in-dict-3"`
//   D, K, K1, K2, K3: metavariables this relation binds for the calling rule
.decl ruf019_tuple_key_in_dict_3(n: node, d: loc, k: loc, k1: loc, k2: loc, k3: loc)
ruf019_tuple_key_in_dict_3(n, D, K, K1, K2, K3) :- kind(n, "comparison_operator"),
