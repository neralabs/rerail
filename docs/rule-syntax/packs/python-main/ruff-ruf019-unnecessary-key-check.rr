.decl ruf019_tuple_2(n: node, k1: loc, k2: loc)
ruf019_tuple_2(n, K1, K2) :- kind(n, "tuple"), n ~ `($K1, $K2)`.
ruf019_tuple_2(n, K1, K2) :- kind(n, "parenthesized_expression"), child(n, c1, _),
