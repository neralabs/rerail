.decl sim102_tok_follows_3(n: node)
.stored sim102_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim102_tok_follows_3(n) :- next_sibling(s14, n), glob(".", s14).
sim102_tok_follows_3(n) :- structural_before(n, g16), match("\\s*", g16), child(p17, n, _),
    node(_, n, _, st19, _), o18 = st19 - strlen(g16), token(p17, _, t15, _, o18),
    match("\\.", t15).
sim102_tok_follows_3(n) :- structural_before(n, g16),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)\\s*)$", g16).

