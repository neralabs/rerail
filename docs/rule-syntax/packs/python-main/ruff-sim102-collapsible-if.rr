// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl sim102_alt_1(n: node)
sim102_alt_1(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
sim102_alt_1(n) :- node(_, n, _, _, _), glob(";", n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl sim102_alt_5(n: node)
sim102_alt_5(n) :- within(c1, n), sim102_sys_version(c1).
sim102_alt_5(n) :- sim102_sys_version(n).
sim102_alt_5(n) :-
    ( kind(n, "identifier"), glob("TYPE_CHECKING", n)
    ; kind(n, "identifier"), (sym_of(n, "typing.TYPE_CHECKING") ; sym_of(n, "_typeshed.TYPE_CHECKING") ; sym_of(n, "typing_extensions.TYPE_CHECKING"))
    ; kind(n, "attribute"), child(n, c1, _), kind(c1, "identifier"), glob("TYPE_CHECKING", c1), sim102_tok_follows_4(c1)
    ).
