.policy "ruff-f405-undefined-local-with-import-star-usage" revision 1
.guests off
.description "Import names explicitly instead of relying on a star import to define them; names that may only come from a star import can't be checked."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// F405(n): a finding at node n, from clause `undefined-local-with-import-star-usage`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation F405(at: node, name: node) "Import `{name}` explicitly from its module; it may only be defined by a star import."
    suppress noqa "F405"
F405(NAME, n) :- (kind(n, "identifier") ; kind(n, "string")), node(_, n, _, _, _), NAME = n,
    docof(n, d2), modnode(d2, m3),
    ( kind(n, "identifier"), !bind_only(n), miss(n, x1)
    ; (kind(n, "string") ; kind(n, "concatenated_string")), f405_all_entry(n, x1), !bound_in(m3, x1)
    ),
    !builtin(x1), star(m3).
F405(NAME, n) :- f405_star_in_string(n, NAME).

// star_in_string(n): the JSON util `star-in-string`, used where the JSON says `matches: "star-in-string"`
//   NAME: metavariable this relation binds for the calling rule
.decl f405_star_in_string(n: node, name: loc)
f405_star_in_string(n, NAME) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), f405_alt_1(c2, NAME).

// all_expr: x is a module-level `__all__ =`, `+=` or `: T =` value, or a part of one that lists names
//   (Ruff's extract_dunder_all_names: `+` chains, parentheses, walrus values, list(...) and tuple(...))
.decl f405_all_expr(x: node)
f405_all_expr(x) :- (kind(st, "assignment") ; kind(st, "augmented_assignment")),
    field(st, "left", l), kind(l, "identifier"), text(l, "__all__"), child(es, st, _),
    kind(es, "expression_statement"), child(m, es, _), kind(m, "module"),
    field(st, "right", x).
f405_all_expr(y) :- f405_all_expr(x), kind(x, "assignment"), field(x, "right", y).
f405_all_expr(y) :- f405_all_expr(x), kind(x, "binary_operator"),
    (field(x, "left", y) ; field(x, "right", y)).
f405_all_expr(y) :- f405_all_expr(x), kind(x, "parenthesized_expression"), child(x, y, _),
    !kind(y, "comment").
f405_all_expr(y) :- f405_all_expr(x), kind(x, "named_expression"), field(x, "value", y).
f405_all_expr(y) :- f405_all_expr(x), kind(x, "call"), field(x, "function", f),
    kind(f, "identifier"), (text(f, "list") ; text(f, "tuple")),
    field(x, "arguments", a), child(a, y, _).

// all_entry: string e is an entry of a module `__all__` definition, exporting the name x
.decl f405_all_entry(e: node, x: symbol)
f405_all_entry(e, x) :- f405_all_expr(l), (kind(l, "list") ; kind(l, "tuple")), child(l, e, _),
    (kind(e, "string") ; kind(e, "concatenated_string")),
    count : { within(i, e), kind(i, "interpolation") } = 0, str(e, x).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl f405_alt_1(n: node, name: loc)
f405_alt_1(n, NAME) :- kind(n, "identifier"), docof(n, d2), modnode(d2, m3),
    ( kind(n, "identifier"), !bind_only(n), miss(n, x1)
    ; (kind(n, "string") ; kind(n, "concatenated_string")), f405_all_entry(n, x1), !bound_in(m3, x1)
    ),
    !builtin(x1), star(m3), NAME = n.
f405_alt_1(n, NAME) :- f405_star_in_string(n, NAME).
