// demand_attribute_fallback: the nodes attribute_fallback is asked at (it looks at every ancestor of every node)
.decl air311_demand_attribute_fallback(n: node)
air311_demand_attribute_fallback(n) :- air311_demand_alt_6(n, ORIG), kind(n, "attribute"),
    within_stop(n, p7, "try_statement"), kind(p7, "try_statement"),
    field(p7, "body", c8), has(c8, c9, "attribute"), air311_replacement_1(c9),
    field(c9, "attribute", c10), text(c10, t_orig2), text(ORIG, t_orig2), @doc(c10) = @doc(ORIG).
air311_demand_attribute_fallback(n) :- air311_alt_case(q1, s1, s2), kind(n, "attribute"),
    within_stop(n, p7, "try_statement"), kind(p7, "try_statement"),
    field(p7, "body", c8), has(c8, c9, "attribute"), air311_replacement(c9, s1),
    field(c9, "attribute", c10), glob(s2, c10).
air311_demand_attribute_fallback(n) :- air311_demand_alt_11(n, ORIG), kind(n, "attribute"),
    within_stop(n, p7, "try_statement"), kind(p7, "try_statement"),
    field(p7, "body", c8), has(c8, c9, "attribute"), air311_replacement_6(c9),
    field(c9, "attribute", c10), text(c10, t_orig4), text(ORIG, t_orig4), @doc(c10) = @doc(ORIG).
air311_demand_attribute_fallback(n) :- air311_demand_alt_16(n, ORIG), kind(n, "attribute"),
    within_stop(n, p7, "try_statement"), kind(p7, "try_statement"),
    field(p7, "body", c8), has(c8, c9, "attribute"), air311_replacement_11(c9),
    field(c9, "attribute", c10), text(c10, t_orig6), text(ORIG, t_orig6), @doc(c10) = @doc(ORIG).

// demand_import_fallback: the nodes import_fallback is asked at (it looks at every ancestor of every node)
.decl air311_demand_import_fallback(n: node)
air311_demand_import_fallback(st2) :- air311_demand_alt_6(n, ORIG), kind(n, "identifier"),
    ref_site(n, b1), (st2 = b1 ; within(b1, st2)),
    within_stop(st2, p3, "try_statement"), kind(p3, "try_statement"),
    field(p3, "body", c4), has(c4, c5, "dotted_name"), air311_replacement_1(c5),
    air311_import_site(c5), child(c5, c6, _), kind(c6, "identifier"), text(c6, t_orig1),
    text(ORIG, t_orig1), @doc(c6) = @doc(ORIG).
air311_demand_import_fallback(st2) :- air311_alt_case(q1, s1, s2), kind(n, "identifier"),
    ref_site(n, b1), (st2 = b1 ; within(b1, st2)),
    within_stop(st2, p3, "try_statement"), kind(p3, "try_statement"),
    field(p3, "body", c4), has(c4, c5, "dotted_name"), air311_replacement(c5, s1),
    air311_import_site(c5), child(c5, c6, _), kind(c6, "identifier"), glob(s2, c6).
air311_demand_import_fallback(st2) :- air311_demand_alt_11(n, ORIG), kind(n, "identifier"),
    ref_site(n, b1), (st2 = b1 ; within(b1, st2)),
    within_stop(st2, p3, "try_statement"), kind(p3, "try_statement"),
    field(p3, "body", c4), has(c4, c5, "dotted_name"), air311_replacement_6(c5),
    air311_import_site(c5), child(c5, c6, _), kind(c6, "identifier"), text(c6, t_orig3),
    text(ORIG, t_orig3), @doc(c6) = @doc(ORIG).
air311_demand_import_fallback(st2) :- air311_demand_alt_16(n, ORIG), kind(n, "identifier"),
    ref_site(n, b1), (st2 = b1 ; within(b1, st2)),
    within_stop(st2, p3, "try_statement"), kind(p3, "try_statement"),
    field(p3, "body", c4), has(c4, c5, "dotted_name"), air311_replacement_11(c5),
    air311_import_site(c5), child(c5, c6, _), kind(c6, "identifier"), text(c6, t_orig5),
    text(ORIG, t_orig5), @doc(c6) = @doc(ORIG).

// demand_operators_segment: the nodes operators_segment is asked at (its recursion looks at every descendant)
.decl air311_demand_operators_segment(n: node)
air311_demand_operators_segment(n) :- sym_of(n, q1),
    match("(airflow\\.providers)(\\.|$).*", q1), air311_moved_bare(n, _, ORIG).
air311_demand_operators_segment(c2) :- air311_demand_operators_segment(n), kind(n, "attribute"),
    field(n, "object", c2).

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl air311_up_1(n: node, p: node)
air311_up_1(n, p) :- air311_demand_import_fallback(n), within_stop(n, p, "try_statement"),
    kind(p, "try_statement").

// up_2(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl air311_up_2(n: node, p: node)
air311_up_2(n, p) :- air311_demand_attribute_fallback(n), within_stop(n, p, "try_statement"),
    kind(p, "try_statement").

// up_3(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl air311_up_3(n: node, p: node)
air311_up_3(n, p) :- air311_attribute_fallback(n), within_stop(n, p, "try_statement"),
    kind(p, "try_statement").

