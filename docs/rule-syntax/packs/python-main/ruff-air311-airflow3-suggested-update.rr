air311_replacement_case("2", "airflow.sdk.Asset").
air311_replacement_case("3", "airflow.sdk.AssetAlias").
air311_replacement_case("4", "airflow.sdk.AssetAll").
air311_replacement_case("5", "airflow.sdk.AssetAny").
air311_replacement_case("7", "airflow.sdk.io.attach").
air311_replacement_case("8", "airflow.sdk.bases.sensor.poke_mode_only").
air311_replacement_case("9", "airflow.models.asset.expand_alias_to_assets").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   ORIG: metavariable this relation binds for the calling rule
.decl air311_alt_2(n: node, orig: loc)
air311_alt_2(n, ORIG) :- ref_site(n, b1), (st2 = b1 ; within(b1, st2)),
    kind(st2, "aliased_import"), field(st2, "name", c3), child(c3, c4, _),
    kind(c4, "identifier"), node(_, c4, _, _, _), ORIG = c4,
    count : { precedes(c4, s5), kind(s5, "identifier") } = 0.
air311_alt_2(n, ORIG) :- count : { ref_site(n, b6), (st7 = b6, kind(st7, "aliased_import") ; inside(b6, st7, "aliased_import")) } = 0,
    node(_, n, _, _, _), ORIG = n.

// stop_3(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl air311_stop_3(n: node)
air311_stop_3(n) :- node(_, n, _, _, _), !kind(n, "expression_list"), !kind(n, "tuple"),
    !kind(n, "list"), !kind(n, "parenthesized_expression").

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl air311_alt_4(n: node)
air311_alt_4(n) :- field(p1, "left", n), kind(p1, "augmented_assignment").
air311_alt_4(n) :- within_stop(n, p2, air311_stop_3), kind(p2, "delete_statement").

// alt_6(n): the JSON `any`: n matches if any one of these rules does
//   ORIG: metavariable of the calling rule, passed in (bound by the caller)
.decl air311_alt_6(n: node, orig: loc)
air311_alt_6(n, ORIG) :- air311_demand_alt_6(n, ORIG), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), air311_import_fallback(st2),
    within_stop(st2, p3, "try_statement"), kind(p3, "try_statement"),
    field(p3, "body", c4), has(c4, c5, "dotted_name"), air311_replacement_1(c5),
    air311_import_site(c5), child(c5, c6, _), kind(c6, "identifier"),
    text(c6, t_orig1), text(ORIG, t_orig1), @doc(c6) = @doc(ORIG).
air311_alt_6(n, ORIG) :- air311_demand_alt_6(n, ORIG), kind(n, "attribute"), air311_attribute_fallback(n),
    air311_up_3(n, p7), field(p7, "body", c8), has(c8, c9, "attribute"), air311_replacement_1(c9),
    field(c9, "attribute", c10), text(c10, t_orig2), text(ORIG, t_orig2), @doc(c10) = @doc(ORIG).

// alt(n, key): 8 copies of one rule set (`alt_10`, `alt_12`, `alt_13` and 5 more), folded into one: row `key` of
// alt_case gives the strings each copy had.
.decl air311_alt(n: node, key: symbol)
air311_alt(n, q1) :- air311_alt_case(q1, s1, s2), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), air311_import_fallback(st2),
    within_stop(st2, p3, "try_statement"), kind(p3, "try_statement"),
    field(p3, "body", c4), has(c4, c5, "dotted_name"), air311_replacement(c5, s1),
    air311_import_site(c5), child(c5, c6, _), kind(c6, "identifier"), glob(s2, c6).
air311_alt(n, q1) :- air311_alt_case(q1, s1, s2), kind(n, "attribute"), air311_attribute_fallback(n),
    air311_up_3(n, p7), field(p7, "body", c8), has(c8, c9, "attribute"), air311_replacement(c9, s1),
    field(c9, "attribute", c10), glob(s2, c10).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
//   ORIG: metavariable of the calling rule, passed in (bound by the caller)
.decl air311_alt_11(n: node, orig: loc)
air311_alt_11(n, ORIG) :- air311_demand_alt_11(n, ORIG), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), air311_import_fallback(st2),
    within_stop(st2, p3, "try_statement"), kind(p3, "try_statement"),
    field(p3, "body", c4), has(c4, c5, "dotted_name"), air311_replacement_6(c5),
    air311_import_site(c5), child(c5, c6, _), kind(c6, "identifier"),
    text(c6, t_orig3), text(ORIG, t_orig3), @doc(c6) = @doc(ORIG).
air311_alt_11(n, ORIG) :- air311_demand_alt_11(n, ORIG), kind(n, "attribute"), air311_attribute_fallback(n),
    air311_up_3(n, p7), field(p7, "body", c8), has(c8, c9, "attribute"), air311_replacement_6(c9),
    field(c9, "attribute", c10), text(c10, t_orig4), text(ORIG, t_orig4), @doc(c10) = @doc(ORIG).

// alt_16(n): the JSON `any`: n matches if any one of these rules does
//   ORIG: metavariable of the calling rule, passed in (bound by the caller)
.decl air311_alt_16(n: node, orig: loc)
air311_alt_16(n, ORIG) :- air311_demand_alt_16(n, ORIG), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), air311_import_fallback(st2),
    within_stop(st2, p3, "try_statement"), kind(p3, "try_statement"),
    field(p3, "body", c4), has(c4, c5, "dotted_name"), air311_replacement_11(c5),
    air311_import_site(c5), child(c5, c6, _), kind(c6, "identifier"),
    text(c6, t_orig5), text(ORIG, t_orig5), @doc(c6) = @doc(ORIG).
air311_alt_16(n, ORIG) :- air311_demand_alt_16(n, ORIG), kind(n, "attribute"), air311_attribute_fallback(n),
    air311_up_3(n, p7), field(p7, "body", c8), has(c8, c9, "attribute"), air311_replacement_11(c9),
    field(c9, "attribute", c10), text(c10, t_orig6), text(ORIG, t_orig6), @doc(c10) = @doc(ORIG).

// alt_19(n): the JSON `any`: n matches if any one of these rules does
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_alt_19(n: node, n_mv: loc, orig: loc)
air311_alt_19(n, N, ORIG) :- air311_demand_alt_19(n), kind(n, "identifier"), N = n, ORIG = n,
    (air311_old(n) ; air311_after_dot(n), child(p1, n, _), kind(p1, "attribute"), air311_old(p1)).
air311_alt_19(n, N, ORIG) :- air311_demand_alt_19(n), air311_quoted(n, N, ORIG).

