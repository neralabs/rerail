air311_demand_alt_6(n, ORIG) :- air311_moved_bare(n, N, ORIG).

// demand_alt_19: the nodes alt_19 is asked at (its recursion looks at every descendant)
.decl air311_demand_alt_19(n: node)
air311_demand_alt_19(c2) :- air311_demand_quoted(n), air311_string_literal(n), parsed(n, "annotation", r1),
    within(c2, r1).

// demand_quoted: the nodes quoted is asked at (its recursion looks at every descendant)
.decl air311_demand_quoted(n: node)
air311_demand_quoted(n) :- inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2),
    air311_seen_airflow(n).
air311_demand_quoted(n) :- air311_demand_alt_19(n).

