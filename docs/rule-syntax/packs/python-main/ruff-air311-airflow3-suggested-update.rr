.policy "ruff-air311-airflow3-suggested-update" revision 2
.guests off
.description "Replace Airflow APIs that Airflow 3 deprecated but still supports with their newer equivalents, and stop passing the sla arguments; the old ones are expected to be removed."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// airflow_name(n): the JSON util `airflow-name`, used where the JSON says `matches: "airflow-name"`
.decl air311_airflow_name(n: node)
air311_airflow_name(n) :- kind(n, "dotted_name"), match("airflow([^0-9A-Za-z_]|$).*", n).

// imports_airflow(n): the JSON util `imports-airflow`, used where the JSON says `matches: "imports-airflow"`
.decl air311_imports_airflow(n: node)
air311_imports_airflow(n) :- within(c1, n), air311_airflow_name(c1),
    ( child(p1, c1, _), kind(p1, "import_statement")
    ; child(p2, c1, _), kind(p2, "aliased_import"), child(p3, p2, _), kind(p3, "import_statement")
    ; field(p4, "module_name", c1), kind(p4, "import_from_statement")
    ).


// seen_airflow(n): the JSON util `seen-airflow`, used where the JSON says `matches: "seen-airflow"`
.decl air311_seen_airflow(n: node)
air311_seen_airflow(n) :- inside(n, p1, "module"), air311_imports_airflow(p1).

// string_literal(n): the JSON util `string-literal`, used where the JSON says `matches: "string-literal"`
.decl air311_string_literal(n: node)
air311_string_literal(n) :- (kind(n, "string") ; kind(n, "concatenated_string")).

// after_dot(n): the JSON util `after-dot`, used where the JSON says `matches: "after-dot"`
.decl air311_after_dot(n: node)
air311_after_dot(n) :- air311_tok_follows_1(n).

// import_site(n): the JSON util `import-site`, used where the JSON says `matches: "import-site"`
.decl air311_import_site(n: node)
air311_import_site(n) :- child(p1, n, _), kind(p1, "aliased_import").
air311_import_site(n) :- air311_tok_follows_2(n).

// import_error(n): the JSON util `import-error`, used where the JSON says `matches: "import-error"`
.decl air311_import_error(n: node)
air311_import_error(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (global_ref(n, "ImportError") ; global_ref(n, "ModuleNotFoundError")),
    (sym_of(n, "builtins.ImportError") ; sym_of(n, "builtins.ModuleNotFoundError")).
air311_import_error(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air311_import_error(c1).

// import_error_type(n): the JSON util `import-error-type`, used where the JSON says `matches: "import-error-type"`
.decl air311_import_error_type(n: node)
air311_import_error_type(n) :- air311_import_error(n).
air311_import_error_type(n) :- kind(n, "tuple"), child(n, c1, _), air311_import_error(c1).
air311_import_error_type(n) :- (kind(n, "parenthesized_expression") ; kind(n, "as_pattern")),
    child(n, c2, _), air311_import_error_type(c2).

// attribute_error(n): the JSON util `attribute-error`, used where the JSON says `matches: "attribute-error"`
.decl air311_attribute_error(n: node)
air311_attribute_error(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "AttributeError"), sym_of(n, "builtins.AttributeError").
air311_attribute_error(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air311_attribute_error(c1).

// attribute_error_type(n): the JSON util `attribute-error-type`, used where the JSON says `matches: "attribute-error-type"`
.decl air311_attribute_error_type(n: node)
air311_attribute_error_type(n) :- air311_attribute_error(n).
air311_attribute_error_type(n) :- kind(n, "tuple"), child(n, c1, _), air311_attribute_error(c1).
air311_attribute_error_type(n) :- (kind(n, "parenthesized_expression") ; kind(n, "as_pattern")),
    child(n, c2, _), air311_attribute_error_type(c2).

// import_fallback(n): the JSON util `import-fallback`, used where the JSON says `matches: "import-fallback"`
.decl air311_import_fallback(n: node)
air311_import_fallback(n) :- air311_demand_import_fallback(n), inside(n, p1, "except_clause"),
    air311_up_1(n, p2), child(p2, c3, _), kind(c3, "except_clause"), field(c3, "value", c4),
    air311_import_error_type(c4).

// attribute_fallback(n): the JSON util `attribute-fallback`, used where the JSON says `matches: "attribute-fallback"`
.decl air311_attribute_fallback(n: node)
air311_attribute_fallback(n) :- air311_demand_attribute_fallback(n), inside(n, p1, "except_clause"),
    air311_up_2(n, p2), child(p2, c3, _), kind(c3, "except_clause"), field(c3, "value", c4),
    air311_attribute_error_type(c4).

// moved_bare(n): the JSON util `moved-bare`, used where the JSON says `matches: "moved-bare"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_moved_bare(n: node, n_mv: loc, orig: loc)
air311_moved_bare(n, N, ORIG) :- kind(n, "identifier"), node(_, n, _, _, _), N = n, air311_alt_2(n, ORIG), !air311_alt_4(n).
air311_moved_bare(n, N, ORIG) :- kind(n, "attribute"), field(n, "attribute", c10), node(_, c10, _, _, _), N = c10,
    node(_, c10, _, _, _), ORIG = c10.

// replacement_1(n): the JSON util `replacement-1`, used where the JSON says `matches: "replacement-1"`
.decl air311_replacement_1(n: node)
air311_replacement_1(n) :- air311_statement_name(n, q1),
    ( q1 = "airflow.sdk.BaseOperatorLink"
    ; q1 = "airflow.sdk.BaseSensorOperator"
    ; q1 = "airflow.sdk.Connection"
    ; q1 = "airflow.sdk.DAG"
    ; q1 = "airflow.sdk.Metadata"
    ; q1 = "airflow.sdk.ObjectStoragePath"
    ; q1 = "airflow.sdk.PokeReturnValue"
    ; q1 = "airflow.sdk.Variable"
    ; q1 = "airflow.sdk.chain"
    ; q1 = "airflow.sdk.chain_linear"
    ; q1 = "airflow.sdk.cross_downstream"
    ; q1 = "airflow.sdk.dag"
    ; q1 = "airflow.sdk.get_parsing_context"
    ; q1 = "airflow.sdk.setup"
    ; q1 = "airflow.sdk.task"
    ; q1 = "airflow.sdk.task_group"
    ; q1 = "airflow.sdk.teardown"
    ).


// moved_1(n): the JSON util `moved-1`, used where the JSON says `matches: "moved-1"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_moved_1(n: node, n_mv: loc, orig: loc)
air311_moved_1(n, N, ORIG) :- air311_moved_bare(n, N, ORIG), !air311_alt_6(n, ORIG).

// moved_2(n): the JSON util `moved-2`, used where the JSON says `matches: "moved-2"`
//   N: metavariable this relation binds for the calling rule
.decl air311_moved_2(n: node, n_mv: loc)
air311_moved_2(n, N) :- air311_moved_bare(n, N, _), !air311_alt(n, "7").

// moved_3(n): the JSON util `moved-3`, used where the JSON says `matches: "moved-3"`
//   N: metavariable this relation binds for the calling rule
.decl air311_moved_3(n: node, n_mv: loc)
air311_moved_3(n, N) :- air311_moved_bare(n, N, _), !air311_alt(n, "8").

// moved_4(n): the JSON util `moved-4`, used where the JSON says `matches: "moved-4"`
//   N: metavariable this relation binds for the calling rule
.decl air311_moved_4(n: node, n_mv: loc)
air311_moved_4(n, N) :- air311_moved_bare(n, N, _), !air311_alt(n, "9").

// moved_5(n): the JSON util `moved-5`, used where the JSON says `matches: "moved-5"`
//   N: metavariable this relation binds for the calling rule
.decl air311_moved_5(n: node, n_mv: loc)
air311_moved_5(n, N) :- air311_moved_bare(n, N, _), !air311_alt(n, "10").

// replacement_6(n): the JSON util `replacement-6`, used where the JSON says `matches: "replacement-6"`
.decl air311_replacement_6(n: node)
air311_replacement_6(n) :- air311_statement_name(n, q1),
    ( q1 = "airflow.sdk.bases.decorator.DecoratedMappedOperator"
    ; q1 = "airflow.sdk.bases.decorator.DecoratedOperator"
    ; q1 = "airflow.sdk.bases.decorator.TaskDecorator"
    ; q1 = "airflow.sdk.bases.decorator.get_unique_task_id"
    ; q1 = "airflow.sdk.bases.decorator.task_decorator_factory"
    ).


// moved_6(n): the JSON util `moved-6`, used where the JSON says `matches: "moved-6"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_moved_6(n: node, n_mv: loc, orig: loc)
air311_moved_6(n, N, ORIG) :- air311_moved_bare(n, N, ORIG), !air311_alt_11(n, ORIG).

// moved_7(n): the JSON util `moved-7`, used where the JSON says `matches: "moved-7"`
//   N: metavariable this relation binds for the calling rule
.decl air311_moved_7(n: node, n_mv: loc)
air311_moved_7(n, N) :- air311_moved_bare(n, N, _), !air311_alt(n, "12").

// moved_8(n): the JSON util `moved-8`, used where the JSON says `matches: "moved-8"`
//   N: metavariable this relation binds for the calling rule
.decl air311_moved_8(n: node, n_mv: loc)
air311_moved_8(n, N) :- air311_moved_bare(n, N, _), !air311_alt(n, "13").

// moved_9(n): the JSON util `moved-9`, used where the JSON says `matches: "moved-9"`
//   N: metavariable this relation binds for the calling rule
.decl air311_moved_9(n: node, n_mv: loc)
air311_moved_9(n, N) :- air311_moved_bare(n, N, _), !air311_alt(n, "14").

// replacement(n, key): 8 copies of one rule set (`replacement-10`, `replacement-2`, `replacement-3` and 5 more), folded into one: row `key` of
// replacement_case gives the strings each copy had.
.decl air311_replacement(n: node, key: symbol)
air311_replacement(n, q2) :- air311_replacement_case(q2, s1), air311_statement_name(n, q1), q1 = s1.

// moved_10(n): the JSON util `moved-10`, used where the JSON says `matches: "moved-10"`
//   N: metavariable this relation binds for the calling rule
.decl air311_moved_10(n: node, n_mv: loc)
air311_moved_10(n, N) :- air311_moved_bare(n, N, _), !air311_alt(n, "15").

// replacement_11(n): the JSON util `replacement-11`, used where the JSON says `matches: "replacement-11"`
.decl air311_replacement_11(n: node)
air311_replacement_11(n) :- air311_statement_name(n, q1),
    ( q1 = "airflow.sdk.definitions.param.DagParam"
    ; q1 = "airflow.sdk.definitions.param.Param"
    ; q1 = "airflow.sdk.definitions.param.ParamsDict"
    ).


// moved_11(n): the JSON util `moved-11`, used where the JSON says `matches: "moved-11"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_moved_11(n: node, n_mv: loc, orig: loc)
air311_moved_11(n, N, ORIG) :- air311_moved_bare(n, N, ORIG), !air311_alt_16(n, ORIG).

// AIR311(n): a finding at node n, from clause `name-1`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation AIR311(at: node, n: node, orig: loc) "Import `{orig}` from `airflow.sdk` instead (needs apache-airflow-task-sdk>=1.0.0); the old name still works in Airflow 3 but is expected to be removed later."
    suppress noqa "AIR311"
AIR311(N, n, ORIG) :- (air311_old(n), air311_moved_1(n, N, ORIG) ; air311_quoted(n, N, ORIG)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).

// old(n): the JSON util `old`, used where the JSON says `matches: "old"`
.decl air311_old(n: node)
air311_old(n) :- sym_of(n, q1), air311_set_17(q1).

// quoted(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_quoted(n: node, n_mv: loc, orig: loc)
air311_quoted(n, N, ORIG) :- air311_demand_quoted(n), air311_string_literal(n), parsed(n, "annotation", r1),
    within(c2, r1), air311_alt_19(c2, N, ORIG).

// AIR311_name_2(n, detail): findings from clauses `name-2`, `name-3`, `name-4`, `name-5` and 4 more. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation AIR311_name_2(at: node, n: node, detail: symbol) code "AIR311" "{detail}; the old name still works in Airflow 3 but is expected to be removed later."
    suppress noqa "AIR311"
AIR311_name_2(N, n, "Import `Asset` from `airflow.sdk` instead (needs apache-airflow-task-sdk>=1.0.0)") :- (air311_old_name_2(n), air311_moved_2(n, N) ; air311_quoted_name_2(n, N)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).
AIR311_name_2(N, n, "Import `AssetAlias` from `airflow.sdk` instead (needs apache-airflow-task-sdk>=1.0.0)") :- (air311_old_name(n, "3"), air311_moved_3(n, N) ; air311_quoted_name_3(n, N)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).
AIR311_name_2(N, n, "Import `AssetAll` from `airflow.sdk` instead (needs apache-airflow-task-sdk>=1.0.0)") :- (air311_old_name(n, "4"), air311_moved_4(n, N) ; air311_quoted_name_4(n, N)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).
AIR311_name_2(N, n, "Import `AssetAny` from `airflow.sdk` instead (needs apache-airflow-task-sdk>=1.0.0)") :- (air311_old_name(n, "5"), air311_moved_5(n, N) ; air311_quoted_name_5(n, N)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).
AIR311_name_2(N, n, "Import `attach` from `airflow.sdk.io` instead (needs apache-airflow-task-sdk>=1.0.0)") :- (air311_old_name(n, "7"), air311_moved_7(n, N) ; air311_quoted_name_7(n, N)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).
AIR311_name_2(N, n, "Import `poke_mode_only` from `airflow.sdk.bases.sensor` instead (needs apache-airflow-task-sdk>=1.0.0)") :- (air311_old_name(n, "8"), air311_moved_8(n, N) ; air311_quoted_name_8(n, N)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).
AIR311_name_2(N, n, "Use `expand_alias_to_assets` from `airflow.models.asset` instead") :- (air311_old_name(n, "9"), air311_moved_9(n, N) ; air311_quoted_name_9(n, N)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).
AIR311_name_2(N, n, "Use `AssetOrTimeSchedule` from `airflow.timetables.assets` instead") :- (air311_old_name(n, "10"), air311_moved_10(n, N) ; air311_quoted_name_10(n, N)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).

// old_name_2(n): the JSON util `old`, used where the JSON says `matches: "old"`
.decl air311_old_name_2(n: node)
air311_old_name_2(n) :- (sym_of(n, "airflow.Dataset") ; sym_of(n, "airflow.datasets.Dataset")).

// quoted_name_2(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N: metavariable this relation binds for the calling rule
.decl air311_quoted_name_2(n: node, n_mv: loc)
air311_quoted_name_2(n, N) :- air311_demand_quoted_name_2(n), air311_string_literal(n),
    parsed(n, "annotation", r1), within(c2, r1), air311_alt_23(c2, N).

// quoted_name_3(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N: metavariable this relation binds for the calling rule
.decl air311_quoted_name_3(n: node, n_mv: loc)
air311_quoted_name_3(n, N) :- air311_demand_quoted_name_3(n), air311_string_literal(n),
    parsed(n, "annotation", r1), within(c2, r1), air311_alt_27(c2, N).

// quoted_name_4(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N: metavariable this relation binds for the calling rule
.decl air311_quoted_name_4(n: node, n_mv: loc)
air311_quoted_name_4(n, N) :- air311_demand_quoted_name_4(n), air311_string_literal(n),
    parsed(n, "annotation", r1), within(c2, r1), air311_alt_31(c2, N).

// quoted_name_5(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N: metavariable this relation binds for the calling rule
.decl air311_quoted_name_5(n: node, n_mv: loc)
air311_quoted_name_5(n, N) :- air311_demand_quoted_name_5(n), air311_string_literal(n),
    parsed(n, "annotation", r1), within(c2, r1), air311_alt_35(c2, N).

// AIR311_name_6(n): a finding at node n, from clause `name-6`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation AIR311_name_6(at: node, n: node, orig: loc) code "AIR311" "Import `{orig}` from `airflow.sdk.bases.decorator` instead (needs apache-airflow-task-sdk>=1.0.0); the old name still works in Airflow 3 but is expected to be removed later."
    suppress noqa "AIR311"
AIR311_name_6(N, n, ORIG) :- (air311_old_name_6(n), air311_moved_6(n, N, ORIG) ; air311_quoted_name_6(n, N, ORIG)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).

// old_name_6(n): the JSON util `old`, used where the JSON says `matches: "old"`
.decl air311_old_name_6(n: node)
air311_old_name_6(n) :- sym_of(n, q1), air311_set_38(q1).

// quoted_name_6(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_quoted_name_6(n: node, n_mv: loc, orig: loc)
air311_quoted_name_6(n, N, ORIG) :- air311_demand_quoted_name_6(n), air311_string_literal(n),
    parsed(n, "annotation", r1), within(c2, r1), air311_alt_40(c2, N, ORIG).

// quoted_name_7(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N: metavariable this relation binds for the calling rule
.decl air311_quoted_name_7(n: node, n_mv: loc)
air311_quoted_name_7(n, N) :- air311_demand_quoted_name_7(n), air311_string_literal(n),
