// alt_case: one row per relation folded into alt: its key, then the strings that differed.
.decl air311_alt_case(key: symbol, s1: symbol, s2: symbol)
air311_alt_case("10", "5", "AssetAny"). air311_alt_case("12", "7", "attach").
air311_alt_case("13", "8", "poke_mode_only"). air311_alt_case("14", "9", "expand_alias_to_assets").
air311_alt_case("15", "10", "AssetOrTimeSchedule"). air311_alt_case("7", "2", "Asset").
air311_alt_case("8", "3", "AssetAlias"). air311_alt_case("9", "4", "AssetAll").

// old_name_case: one row per relation folded into old_name: its key, then the strings that differed.
.decl air311_old_name_case(key: symbol, s1: symbol)
