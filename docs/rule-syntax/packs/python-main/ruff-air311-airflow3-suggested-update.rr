// alt_67(n): the JSON `any`: n matches if any one of these rules does
.decl air311_alt_67(n: node)
air311_alt_67(n) :- kind(n, "aliased_import"), field(n, "name", c1), child(c1, c2, _),
    kind(c2, "identifier"), glob("operators", c2).
air311_alt_67(n) :- kind(n, "dotted_name"), child(p3, n, _),
    kind(p3, "import_from_statement"), child(n, c4, _), kind(c4, "identifier"),
    glob("operators", c4).
air311_alt_67(n) :- within_stop(n, p5, "import_from_statement"),
    kind(p5, "import_from_statement"), field(p5, "module_name", c6), child(c6, c7, _),
    kind(c7, "identifier"), glob("operators", c7).
