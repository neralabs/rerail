// quoted_name_9(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N: metavariable this relation binds for the calling rule
.decl air311_quoted_name_9(n: node, n_mv: loc)
air311_quoted_name_9(n, N) :- air311_demand_quoted_name_9(n), air311_string_literal(n),
    parsed(n, "annotation", r1), within(c2, r1), air311_alt_52(c2, N).

// old_name(n, key): 8 copies of one rule set (`old`, `old`, `old` and 5 more), folded into one: row `key` of
// old_name_case gives the strings each copy had.
.decl air311_old_name(n: node, key: symbol)
air311_old_name(n, q1) :- air311_old_name_case(q1, s1), sym_of(n, s1).

// quoted_name_10(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N: metavariable this relation binds for the calling rule
.decl air311_quoted_name_10(n: node, n_mv: loc)
air311_quoted_name_10(n, N) :- air311_demand_quoted_name_10(n), air311_string_literal(n),
    parsed(n, "annotation", r1), within(c2, r1), air311_alt_56(c2, N).

// AIR311_name_param(n): a finding at node n, from clause `name-param`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on ORIG are added to every rule.
.violation AIR311_name_param(at: node, n: node, orig: loc) code "AIR311" "Import `{orig}` from `airflow.sdk.definitions.param` instead (needs apache-airflow-task-sdk>=1.0.0); the old name still works in Airflow 3 but is expected to be removed later."
    suppress noqa "AIR311"
AIR311_name_param(N, n, ORIG) :- (air311_old_name_param(n), air311_moved_11(n, N, ORIG) ; air311_quoted_name_param(n, N, ORIG)),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n),
    glob("{Param,ParamsDict,DagParam}", ORIG).

// old_name_param(n): the JSON util `old`, used where the JSON says `matches: "old"`
.decl air311_old_name_param(n: node)
air311_old_name_param(n) :- sym_of(n, q1), match("(airflow\\.models)(\\.|$).*", q1).

// quoted_name_param(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_quoted_name_param(n: node, n_mv: loc, orig: loc)
air311_quoted_name_param(n, N, ORIG) :- air311_string_literal(n), parsed(n, "annotation", r1),
    within(c2, r1), air311_alt_60(c2, N, ORIG).

// AIR311_name_no_replacement(n): a finding at node n, from clause `name-no-replacement`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation AIR311_name_no_replacement(at: node, n: node, orig: loc) code "AIR311" "`{orig}` has no replacement and is expected to be removed in a future Airflow version; stop relying on it where you can."
    suppress noqa "AIR311"
AIR311_name_no_replacement(N, n, ORIG) :-
    ( air311_old_name(n, "no_replacement"), air311_moved_bare(n, N, ORIG)
    ; air311_quoted_name_no_replacement(n, N, ORIG)
    ),
    inside(n, p1, "module"), within(c2, p1), air311_airflow_name(c2), air311_seen_airflow(n).

// quoted_name_no_replacement(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air311_quoted_name_no_replacement(n: node, n_mv: loc, orig: loc)
air311_quoted_name_no_replacement(n, N, ORIG) :- air311_demand_quoted_name_no_replacement(n),
    air311_string_literal(n), parsed(n, "annotation", r1), within(c2, r1),
    air311_alt_64(c2, N, ORIG).

// AIR311_dag_sla_miss_callback(n): a finding at node n, from clause `dag-sla-miss-callback`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on ORIG are added to every rule.
.violation AIR311_dag_sla_miss_callback(at: node, k: node) code "AIR311" "`{k}` has no replacement and is expected to be removed in a future Airflow version; keep it only while the code must still support Airflow 2."
    suppress noqa "AIR311"
AIR311_dag_sla_miss_callback(K, n) :- kind(n, "keyword_argument"),
    field(n, "name", c1), glob("sla_miss_callback", c1), node(_, c1, _, _, _), K = c1,
    count : { precedes(s2, n), kind(s2, "keyword_argument"), field(s2, "name", c3), glob("sla_miss_callback", c3) } = 0,
    child(p4, n, _), kind(p4, "argument_list"), child(p5, p4, _), kind(p5, "call"),
    field(p5, "function", c6), air311_callee(c6, ORIG), inside(n, p7, "module"),
    within(c8, p7), air311_airflow_name(c8), air311_seen_airflow(n), glob("{DAG,dag}", ORIG).

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   ORIG: metavariable this relation binds for the calling rule
.decl air311_callee(n: node, orig: loc)
air311_callee(n, ORIG) :- sym_of(n, q1), match("(airflow)(\\.|$).*", q1),
    air311_moved_bare(n, _, ORIG).
air311_callee(n, ORIG) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    air311_callee(c2, ORIG).

// AIR311_timetable_datasets(n): a finding at node n, from clause `timetable-datasets`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation AIR311_timetable_datasets(at: node, k: node) code "AIR311" "Rename the `{k}` argument to `assets`; the old name still works in Airflow 3 but is expected to be removed later."
    suppress noqa "AIR311"
AIR311_timetable_datasets(K, n) :- kind(n, "keyword_argument"), field(n, "name", c1),
    glob("datasets", c1), node(_, c1, _, _, _), K = c1,
    count : { precedes(s2, n), kind(s2, "keyword_argument"), field(s2, "name", c3), glob("datasets", c3) } = 0,
    child(p4, n, _), kind(p4, "argument_list"), child(p5, p4, _), kind(p5, "call"),
    field(p5, "function", c6), air311_callee_timetable_datasets(c6), inside(n, p7, "module"),
    within(c8, p7), air311_airflow_name(c8), air311_seen_airflow(n).

// callee_timetable_datasets(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
.decl air311_callee_timetable_datasets(n: node)
air311_callee_timetable_datasets(n) :- sym_of(n, "airflow.timetables.datasets.DatasetOrTimeSchedule"),
    air311_moved_bare(n, _, _).
air311_callee_timetable_datasets(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air311_callee_timetable_datasets(c1).

// AIR311_builtin_operator_sla(n): a finding at node n, from clause `builtin-operator-sla`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on ORIG are added to every rule.
.violation AIR311_builtin_operator_sla(at: node, k: node) code "AIR311" "`{k}` has no replacement and is expected to be removed in a future Airflow version; keep it only while the code must still support Airflow 2."
    suppress noqa "AIR311"
AIR311_builtin_operator_sla(K, n) :- kind(n, "keyword_argument"), field(n, "name", c1),
    glob("sla", c1), node(_, c1, _, _, _), K = c1,
    count : { precedes(s2, n), kind(s2, "keyword_argument"), field(s2, "name", c3), glob("sla", c3) } = 0,
    child(p4, n, _), kind(p4, "argument_list"), child(p5, p4, _), kind(p5, "call"),
    field(p5, "function", c6), air311_callee_builtin_operator_sla(c6, ORIG),
    inside(n, p7, "module"), within(c8, p7), air311_airflow_name(c8), air311_seen_airflow(n),
    suffix("Operator", ORIG).

// callee_builtin_operator_sla(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   ORIG: metavariable this relation binds for the calling rule
.decl air311_callee_builtin_operator_sla(n: node, orig: loc)
air311_callee_builtin_operator_sla(n, ORIG) :- sym_of(n, q1), match("(airflow\\.operators)(\\.|$).*", q1),
    air311_moved_bare(n, _, ORIG).
air311_callee_builtin_operator_sla(n, ORIG) :- kind(n, "parenthesized_expression"),
    child(n, c2, _), air311_callee_builtin_operator_sla(c2, ORIG).

// AIR311_provider_operator_sla(n): a finding at node n, from clause `provider-operator-sla`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on ORIG are added to every rule.
.violation AIR311_provider_operator_sla(at: node, k: node) code "AIR311" "`{k}` has no replacement and is expected to be removed in a future Airflow version; keep it only while the code must still support Airflow 2."
    suppress noqa "AIR311"
AIR311_provider_operator_sla(K, n) :- kind(n, "keyword_argument"),
    field(n, "name", c1), glob("sla", c1), node(_, c1, _, _, _), K = c1,
    count : { precedes(s2, n), kind(s2, "keyword_argument"), field(s2, "name", c3), glob("sla", c3) } = 0,
    child(p4, n, _), kind(p4, "argument_list"), child(p5, p4, _), kind(p5, "call"),
    field(p5, "function", c6), air311_callee_provider_operator_sla(c6, ORIG),
    inside(n, p7, "module"), within(c8, p7), air311_airflow_name(c8), air311_seen_airflow(n),
    suffix("Operator", ORIG).

// callee_provider_operator_sla(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   ORIG: metavariable this relation binds for the calling rule
.decl air311_callee_provider_operator_sla(n: node, orig: loc)
air311_callee_provider_operator_sla(n, ORIG) :- sym_of(n, q1), match("(airflow\\.providers)(\\.|$).*", q1),
    air311_moved_bare(n, _, ORIG), air311_operators_segment(n).
air311_callee_provider_operator_sla(n, ORIG) :- kind(n, "parenthesized_expression"),
    child(n, c2, _), air311_callee_provider_operator_sla(c2, ORIG).

// operators_segment(n): the JSON util `operators-segment`, used where the JSON says `matches: "operators-segment"`
.decl air311_operators_segment(n: node)
air311_operators_segment(n) :- air311_demand_operators_segment(n), kind(n, "attribute"),
    field(n, "attribute", c1), kind(c1, "identifier"), glob("operators", c1).
air311_operators_segment(n) :- air311_demand_operators_segment(n), kind(n, "attribute"),
    field(n, "object", c2), air311_operators_segment(c2).
air311_operators_segment(n) :- air311_demand_operators_segment(n), kind(n, "identifier"),
    ref_site(n, b3), (st4 = b3 ; within(b3, st4)), air311_alt_67(st4).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\.$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air311_tok_follows_1(n: node)
.stored air311_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air311_tok_follows_1(n) :- next_sibling(s1, n), glob(".", s1).
air311_tok_follows_1(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("\\.", t2).
air311_tok_follows_1(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)\\s*)$", g3).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^import$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air311_tok_follows_2(n: node)
.stored air311_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air311_tok_follows_2(n) :- precedes(s2, n), glob("import", s2).
air311_tok_follows_2(n) :- child(p5, n, _), node(_, n, _, st7, _), token(p5, _, t3, _, en8),
    en8 <= st7, match("import", t3).
air311_tok_follows_2(n) :- structural_before(n, g4),
    match("(?s)^(?:(?:.*\\W)?(?:import)(?:\\W.*)?)$", g4).
air311_tok_follows_2(n) :- precedes(o6, n), structural_before(o6, g4),
    match("(?s)^(?:(?:.*\\W)?(?:import)(?:\\W.*)?)$", g4).

// from_module: the module text of from-import s, read as `relative: "text"` does (dots dropped)
.decl air311_from_module(s: node, m: symbol)
air311_from_module(s, m) :- kind(s, "future_import_statement"), m = "__future__".
air311_from_module(s, m) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "dotted_name"), name(x, m).
air311_from_module(s, m) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "relative_import"), child(x, y, _), kind(y, "dotted_name"), name(y, m).
air311_from_module(s, "") :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "relative_import"), count : { child(x, y, _), kind(y, "dotted_name") } = 0.

// statement_name: dotted name n in an import statement imports q (relative modules by their text)
.decl air311_statement_name(n: node, q: symbol)
air311_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    kind(s, "import_statement"), name(n, q).
air311_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    kind(s, "relative_import"), name(n, q).
air311_statement_name(n, q) :- kind(n, "dotted_name"), field(a, "name", n),
    kind(a, "aliased_import"), child(s, a, _), kind(s, "import_statement"), name(n, q).
air311_statement_name(n, q) :- kind(n, "dotted_name"), field(a, "name", n),
    kind(a, "aliased_import"), child(s, a, _),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    air311_from_module(s, m), name(n, x), q = @dot(m, x).
air311_statement_name(n, m) :- kind(n, "dotted_name"), field(s, "module_name", n),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    air311_from_module(s, m).
air311_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    !field(s, "module_name", n), air311_from_module(s, m), name(n, x), q = @dot(m, x).

// demand_alt_11: the rows of alt_11 its callers ask for (the metavariable columns they pass in)
.decl air311_demand_alt_11(n: node, orig: loc)
air311_demand_alt_11(n, ORIG) :- air311_moved_bare(n, N, ORIG).

// demand_alt_16: the rows of alt_16 its callers ask for (the metavariable columns they pass in)
