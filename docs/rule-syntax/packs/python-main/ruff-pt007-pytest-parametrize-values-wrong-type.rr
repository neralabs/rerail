.policy "ruff-pt007-pytest-parametrize-values-wrong-type" revision 1
.guests off
.description "Pass pytest.mark.parametrize values as a list, and each row of several parameters as a tuple, not the other way round."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// parametrize(n): the JSON util `parametrize`, used where the JSON says `matches: "parametrize"`
.decl pt007_parametrize(n: node)
pt007_parametrize(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pt007_parametrize(c1).
pt007_parametrize(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "pytest.mark.parametrize").

// positional(n): the JSON util `positional`, used where the JSON says `matches: "positional"`
.decl pt007_positional(n: node)
pt007_positional(n) :- node(_, n, _, _, _), !pt007_alt_1(n).

// pos0(n): the JSON util `pos0`, used where the JSON says `matches: "pos0"`
.decl pt007_pos0(n: node)
pt007_pos0(n) :- pt007_positional(n), !pt007_alt_2(n).

// pos1(n): the JSON util `pos1`, used where the JSON says `matches: "pos1"`
.decl pt007_pos1(n: node)
pt007_pos1(n) :- pt007_positional(n), child(p1, n, _), pt007_counted_3(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), pt007_counted_3(s2) }, k3 = 1,
    !pt007_alt_4(n).

// kw_names(n): the JSON util `kw-names`, used where the JSON says `matches: "kw-names"`
.decl pt007_kw_names(n: node)
pt007_kw_names(n) :- kind(n, "keyword_argument"), field(n, "name", c1), glob("argnames", c1).

// kw_values(n): the JSON util `kw-values`, used where the JSON says `matches: "kw-values"`
.decl pt007_kw_values(n: node)
pt007_kw_values(n) :- kind(n, "keyword_argument"), field(n, "name", c1),
    glob("argvalues", c1).

// param_call(n): the JSON util `param-call`, used where the JSON says `matches: "param-call"`
.decl pt007_param_call(n: node)
pt007_param_call(n) :- kind(n, "call"), field(n, "function", c1), pt007_parametrize(c1),
    field(n, "arguments", c2), kind(c2, "argument_list"), child(c2, c3, _),
    (pt007_kw_names(c3) ; pt007_pos0(c3)), child(c2, c4, _), (pt007_kw_values(c4) ; pt007_pos1(c4)).

// plain_str(n): the JSON util `plain-str`, used where the JSON says `matches: "plain-str"`
.decl pt007_plain_str(n: node)
pt007_plain_str(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0.
pt007_plain_str(n) :- kind(n, "concatenated_string"),
    count : { child(n, c2, _), kind(c2, "string"), child(c2, c3, _), kind(c3, "string_start"), glob("**[bBfFtT]**", c3) } = 0.
pt007_plain_str(n) :- kind(n, "parenthesized_expression"), child(n, c4, _), pt007_plain_str(c4).

// multi_str(n): the JSON util `multi-str`, used where the JSON says `matches: "multi-str"`
.decl pt007_multi_str(n: node)
pt007_multi_str(n) :- pt007_plain_str(n), (kind(n, "string") ; kind(n, "concatenated_string")),
    value(n, v1), match(".*[^ \\t\\f,][^,]*,[ \\t\\f,]*[^ \\t\\f,].*", v1).
pt007_multi_str(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), pt007_multi_str(c2).

// single_named(n): the JSON util `single-named`, used where the JSON says `matches: "single-named"`
.decl pt007_single_named(n: node)
pt007_single_named(n) :- pt007_plain_str(n), !pt007_multi_str(n).

// multi_call(n): the JSON util `multi-call`, used where the JSON says `matches: "multi-call"`
.decl pt007_multi_call(n: node)
pt007_multi_call(n) :- pt007_param_call(n), field(n, "arguments", c1), kind(c1, "argument_list"),
    child(c1, c2, _),
    ( pt007_kw_names(c2), field(c2, "value", c3), !pt007_single_named(c3)
    ; pt007_pos0(c2), !pt007_single_named(c2), child(p1, c2, _), count : { child(p1, c4, _), pt007_kw_names(c4) } = 0
    ).


// values_slot(n): the JSON util `values-slot`, used where the JSON says `matches: "values-slot"`
.decl pt007_values_slot(n: node)
pt007_values_slot(n) :- field(p1, "value", n), pt007_kw_values(p1), child(p2, p1, _),
    kind(p2, "argument_list"), field(p3, "arguments", p2), pt007_param_call(p3).
pt007_values_slot(n) :- pt007_pos1(n), child(p4, n, _), kind(p4, "argument_list"),
    field(p5, "arguments", p4), pt007_param_call(p5),
    count : { child(p4, c6, _), pt007_kw_values(c6) } = 0.

// values_expr(n): the JSON util `values-expr`, used where the JSON says `matches: "values-expr"`
.decl pt007_values_expr(n: node)
pt007_values_expr(n) :- pt007_values_slot(n).
pt007_values_expr(n) :- child(p1, n, _), kind(p1, "parenthesized_expression"),
    pt007_values_expr(p1).

// multi_values_slot(n): the JSON util `multi-values-slot`, used where the JSON says `matches: "multi-values-slot"`
.decl pt007_multi_values_slot(n: node)
pt007_multi_values_slot(n) :- field(p1, "value", n), pt007_kw_values(p1), child(p2, p1, _),
    kind(p2, "argument_list"), field(p3, "arguments", p2), pt007_multi_call(p3).
pt007_multi_values_slot(n) :- pt007_pos1(n), child(p4, n, _), kind(p4, "argument_list"),
    field(p5, "arguments", p4), pt007_multi_call(p5),
    count : { child(p4, c6, _), pt007_kw_values(c6) } = 0.

// multi_values_expr(n): the JSON util `multi-values-expr`, used where the JSON says `matches: "multi-values-expr"`
.decl pt007_multi_values_expr(n: node)
pt007_multi_values_expr(n) :- pt007_multi_values_slot(n).
pt007_multi_values_expr(n) :- child(p1, n, _), kind(p1, "parenthesized_expression"),
    pt007_multi_values_expr(p1).

// row(n): the JSON util `row`, used where the JSON says `matches: "row"`
.decl pt007_row(n: node)
pt007_row(n) :- child(p1, n, _), (kind(p1, "tuple") ; kind(p1, "list")),
    pt007_multi_values_expr(p1).
pt007_row(n) :- child(p2, n, _), kind(p2, "parenthesized_expression"), pt007_row(p2).

// PT007(n, detail): findings from clauses `values-tuple`, `row-list`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
.violation PT007(at: node, detail: symbol) "{detail}."
    suppress noqa "PT007"
PT007(n, "Pass the parametrize values as a list, `[...]`, instead of a tuple") :- kind(n, "tuple"),
    pt007_values_expr(n).
PT007(n, "Write each row of parametrize values as a tuple, `(a, b)`, instead of a list; leave it if the names are one parameter and the list is that parameter's value") :- kind(n, "list"),
    pt007_row(n).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pt007_alt_1(n: node)
pt007_alt_1(n) :-
    ( kind(n, "keyword_argument")
    ; kind(n, "dictionary_splat")
    ; kind(n, "comment")
    ; kind(n, "line_continuation")
    ).

pt007_alt_1(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pt007_alt_2(n: node)
pt007_alt_2(n) :- kind(n, "list_splat").
pt007_alt_2(n) :- precedes(s1, n), pt007_positional(s1).

// counted_3(n): the siblings the JSON `nthChild.ofRule` counts
.decl pt007_counted_3(n: node)
pt007_counted_3(n) :- pt007_positional(n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl pt007_alt_4(n: node)
pt007_alt_4(n) :- kind(n, "list_splat").
pt007_alt_4(n) :- precedes(s1, n), kind(s1, "list_splat").
