.policy "bandit-b318-xml-bad-minidom" revision 1
.guests off
.description "Use defusedxml instead of xml.dom.minidom to parse XML; the standard parser is open to entity-expansion and other XML attacks on untrusted input."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B318(n): a finding at node n, from clause `B318`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on F are added to every rule.
.violation B318(at: node) "Using xml.dom.minidom to parse untrusted XML is vulnerable to XML attacks; use the defusedxml equivalent."
    suppress nosec "B318"
B318(n) :- n ~ `$F($$$ARGS)`,
    (sym_of(F, "xml.dom.minidom.parse") ; sym_of(F, "xml.dom.minidom.parseString")).
