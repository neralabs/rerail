// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl ruf037_args_plain(l: node, a: node, i: number)
ruf037_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl ruf037_args_splat(l: node, i: number)
ruf037_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl ruf037_args_pos(l: node, a: node, j: number)
ruf037_args_pos(l, a, j) :- ruf037_args_plain(l, a, i), count : { ruf037_args_splat(l, k), k < i } = 0,
    j = count : { ruf037_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl ruf037_args_star(l: node, j: number)
ruf037_args_star(l, j) :- ruf037_args_splat(l, i), count : { ruf037_args_splat(l, k), k < i } = 0,
    j = count : { ruf037_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl ruf037_args_kwp(l: node, k: symbol, v: node)
ruf037_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl ruf037_args_lit_dict(s: node, d: node)
ruf037_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !ruf037_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl ruf037_args_str_pair(p: node)
ruf037_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl ruf037_args_kw(l: node, k: symbol, v: node)
ruf037_args_kw(l, k, v) :- ruf037_args_kwp(l, k, v).
ruf037_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), ruf037_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl ruf037_args_kw_spread(l: node)
ruf037_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !ruf037_args_lit_dict(s, _).

// arg_iterable_1: call n passes v for slot `iterable` of (iterable, maxlen), syntactic: Ruff's find_argument
.decl ruf037_arg_iterable_1(n: node, v: node)
ruf037_arg_iterable_1(n, v) :- kind(n, "call"), field(n, "arguments", l),
    ruf037_args_kwp(l, "iterable", v).
ruf037_arg_iterable_1(n, v) :- kind(n, "call"), field(n, "arguments", l), ruf037_args_pos(l, v, 0),
    !ruf037_args_kwp(l, "iterable", _).
ruf037_arg_iterable_1(n, v) :- kind(n, "call"), field(n, "arguments", v),
    kind(v, "generator_expression").

// arg_no_iterable_1: call n does not pass slot `iterable` of (iterable, maxlen), syntactic: Ruff's find_argument
.decl ruf037_arg_no_iterable_1(n: node)
ruf037_arg_no_iterable_1(n) :- kind(n, "call"), field(n, "arguments", l),
    !ruf037_args_kwp(l, "iterable", _), !ruf037_args_pos(l, _, 0), !kind(l, "generator_expression").

// arg_maxlen_2: call n passes v for slot `maxlen` of (iterable, maxlen), syntactic: Ruff's find_argument
.decl ruf037_arg_maxlen_2(n: node, v: node)
ruf037_arg_maxlen_2(n, v) :- kind(n, "call"), field(n, "arguments", l),
    ruf037_args_kwp(l, "maxlen", v).
ruf037_arg_maxlen_2(n, v) :- kind(n, "call"), field(n, "arguments", l), ruf037_args_pos(l, v, 1),
    !ruf037_args_kwp(l, "maxlen", _).

// arg_no_maxlen_2: call n does not pass slot `maxlen` of (iterable, maxlen), syntactic: Ruff's find_argument
.decl ruf037_arg_no_maxlen_2(n: node)
ruf037_arg_no_maxlen_2(n) :- kind(n, "call"), field(n, "arguments", l),
    !ruf037_args_kwp(l, "maxlen", _), !ruf037_args_pos(l, _, 1).

// alt_3_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf037_alt_3_u0_empty(n: node)

// alt_5_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf037_alt_5_u0_empty(n: node)

// empty_inner_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf037_empty_inner_u0_empty(n: node)

// empty_inner_part_u0: level -1 of an unrolled recursion, empty
.decl ruf037_empty_inner_part_u0(n: node)

// empty_inner_part_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf037_empty_inner_part_u0_empty(n: node)

// empty_interpolation_u0: level -1 of an unrolled recursion, empty
.decl ruf037_empty_interpolation_u0(n: node)

// empty_interpolation_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf037_empty_interpolation_u0_empty(n: node)

// empty_part_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf037_empty_part_u0_empty(n: node)

// alt_1_family_case: one row per relation folded into alt_1_family: its key, then the strings that differed.
.decl ruf037_alt_1_family_case(key: symbol, s1: symbol, s2: symbol, s3: symbol)
ruf037_alt_1_family_case("alt_1", "comment", "line_continuation", "[\\[\\]{}(),]").
ruf037_alt_1_family_case("alt_2", "format_specifier", "type_conversion", "=").
ruf037_alt_1_family_case("trivia", "comment", "line_continuation", "[(),]").

// alt_1_family(n, key): 3 copies of one rule set (`alt_1`, `alt_2`, `trivia`), folded into one: row `key` of
// alt_1_family_case gives the strings each copy had.
.decl ruf037_alt_1_family(n: node, key: symbol)
ruf037_alt_1_family(n, q1) :- ruf037_alt_1_family_case(q1, s1, s2, s3), (kind(n, s1) ; kind(n, s2)).
ruf037_alt_1_family(n, q1) :- node(_, n, _, _, _), ruf037_alt_1_family_case(q1, s1, s2, s3),
    glob(s3, n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl ruf037_alt_3(n: node)
ruf037_alt_3(n) :- ruf037_alt_3_u7(n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl ruf037_alt_4(n: node)
ruf037_alt_4(n) :- ruf037_t_prefix(n).
ruf037_alt_4(n) :- ruf037_b_prefix(n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl ruf037_alt_5(n: node)
ruf037_alt_5(n) :- ruf037_alt_5_u7(n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl ruf037_alt_6(n: node)
ruf037_alt_6(n) :- ruf037_alt_1_family(n, "trivia").
ruf037_alt_6(n) :- ruf037_empty_part(n).

// stop_7(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf037_stop_7(n: node)
ruf037_stop_7(n) :- node(_, n, _, _, _), !kind(n, "comment").

// alt_10(n): the JSON `any`: n matches if any one of these rules does
//   CALL: metavariable this relation binds for the calling rule
.decl ruf037_alt_10(n: node, call: loc)
ruf037_alt_10(n, CALL) :- ruf037_target_str(n), CALL = n.
ruf037_alt_10(n, CALL) :- ruf037_in_annotation(n, CALL).
