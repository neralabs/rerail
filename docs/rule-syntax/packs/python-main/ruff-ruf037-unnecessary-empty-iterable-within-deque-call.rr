.policy "ruff-ruf037-unnecessary-empty-iterable-within-deque-call" revision 1
.guests off
.description "Don't pass an empty list, tuple, dict, set or string as the iterable of a deque; a deque starts empty, so drop it and keep maxlen if it is set."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// empty_body(n): the JSON util `empty-body`, used where the JSON says `matches: "empty-body"`
.decl ruf037_empty_body(n: node)
ruf037_empty_body(n) :- node(_, n, _, _, _),
    count : { child(n, c1, _), !ruf037_alt_1_family(c1, "alt_1") } = 0.

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
.decl ruf037_callee(n: node)
ruf037_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "collections.deque").
ruf037_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf037_callee(c1).

// builtin_callee(n): the JSON util `builtin-callee`, used where the JSON says `matches: "builtin-callee"`
.decl ruf037_builtin_callee(n: node)
ruf037_builtin_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( global_ref(n, "set")
    ; global_ref(n, "list")
    ; global_ref(n, "dict")
    ; global_ref(n, "tuple")
    ),

    ( sym_of(n, "builtins.set")
    ; sym_of(n, "builtins.list")
    ; sym_of(n, "builtins.dict")
    ; sym_of(n, "builtins.tuple")
    ).

ruf037_builtin_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    ruf037_builtin_callee(c1).

// empty_builtin_call(n): the JSON util `empty-builtin-call`, used where the JSON says `matches: "empty-builtin-call"`
.decl ruf037_empty_builtin_call(n: node)
ruf037_empty_builtin_call(n) :- kind(n, "call"), field(n, "function", c1), ruf037_builtin_callee(c1),
    field(n, "arguments", c2), kind(c2, "argument_list"),
    count : { child(c2, c3, _), !ruf037_alt_1_family(c3, "trivia") } = 0.

// t_prefix(n): the JSON util `t-prefix`, used where the JSON says `matches: "t-prefix"`
.decl ruf037_t_prefix(n: node)
ruf037_t_prefix(n) :- node(_, n, _, _, _), match("[a-zA-Z]*[tT].*", n).

// b_prefix(n): the JSON util `b-prefix`, used where the JSON says `matches: "b-prefix"`
.decl ruf037_b_prefix(n: node)
ruf037_b_prefix(n) :- node(_, n, _, _, _), match("[a-zA-Z]*[bB].*", n).

// empty_interpolation(n): the JSON util `empty-interpolation`, used where the JSON says `matches: "empty-interpolation"`
.decl ruf037_empty_interpolation(n: node)
ruf037_empty_interpolation(n) :- ruf037_empty_interpolation_u7(n).

// empty_part(n): the JSON util `empty-part`, used where the JSON says `matches: "empty-part"`
.decl ruf037_empty_part(n: node)
ruf037_empty_part(n) :- ruf037_empty_part_u7(n).

// empty_inner_part(n): the JSON util `empty-inner-part`, used where the JSON says `matches: "empty-inner-part"`
.decl ruf037_empty_inner_part(n: node)
ruf037_empty_inner_part(n) :- ruf037_empty_inner_part_u7(n).

// empty_inner(n): the JSON util `empty-inner`, used where the JSON says `matches: "empty-inner"`
.decl ruf037_empty_inner(n: node)
ruf037_empty_inner(n) :- ruf037_empty_inner_u7(n).

// empty_iterable(n): the JSON util `empty-iterable`, used where the JSON says `matches: "empty-iterable"`
.decl ruf037_empty_iterable(n: node)
ruf037_empty_iterable(n) :- kind(n, "dictionary"), ruf037_empty_body(n).
ruf037_empty_iterable(n) :- kind(n, "list"), ruf037_empty_body(n).
ruf037_empty_iterable(n) :- kind(n, "tuple"), ruf037_empty_body(n).
ruf037_empty_iterable(n) :- ruf037_empty_builtin_call(n).
ruf037_empty_iterable(n) :- ruf037_empty_part(n).
ruf037_empty_iterable(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), !ruf037_alt_6(c1) } = 0.
ruf037_empty_iterable(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    ruf037_empty_iterable(c2).

// count_ok(n): the JSON util `count-ok`, used where the JSON says `matches: "count-ok"`
.decl ruf037_count_ok(n: node)
ruf037_count_ok(n) :- field(n, "arguments", c1), kind(c1, "argument_list"),
    k3 = count : { child(c1, c2, _), !ruf037_alt_1_family(c2, "trivia") }, k3 >= 1, k3 <= 2.

// target_str(n): the JSON util `target-str`, used where the JSON says `matches: "target-str"`
.decl ruf037_target_str(n: node)
ruf037_target_str(n) :- kind(n, "call"), field(n, "function", c1), ruf037_callee(c1), ruf037_count_ok(n),
    field(n, "arguments", c2), kind(c2, "argument_list"),
    ( child(c2, c3, _), ruf037_empty_iterable(c3), precedes_stop(s1, c3, ruf037_stop_7), glob("(", s1)
    ; child(c2, c4, _), kind(c4, "keyword_argument"), field(c4, "name", c5), glob("iterable", c5), field(c4, "value", c6), ruf037_empty_iterable(c6)
    ).


// in_annotation(n): the JSON util `in-annotation`, used where the JSON says `matches: "in-annotation"`
//   CALL: metavariable this relation binds for the calling rule
.decl ruf037_in_annotation(n: node, call: loc)
ruf037_in_annotation(n, CALL) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ruf037_alt_10(c2, CALL).

// RUF037(n, detail): findings from clauses `empty-iterable-with-maxlen`, `empty-iterable`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// The JSON `constraints` on IT are added to every rule.
.violation RUF037(at: node, detail: symbol) "{detail} already starts empty."
    suppress noqa "RUF037"
RUF037(n, "Drop the empty iterable and pass the bound by keyword: `deque(maxlen=...)`; a deque") :- kind(n, "call"),
    field(n, "function", c1), ruf037_callee(c1), ruf037_count_ok(n), ruf037_arg_iterable_1(n, a2), IT = a2,
    ruf037_arg_maxlen_2(n, a3), ML = a3, ruf037_empty_iterable(IT).
RUF037(n, "Remove the empty iterable argument; `deque()`") :- kind(n, "call"),
    field(n, "function", c1), ruf037_callee(c1), ruf037_count_ok(n), ruf037_arg_iterable_1(n, a2), IT = a2,
    ruf037_arg_no_maxlen_2(n), ruf037_empty_iterable(IT).

// RUF037_empty_iterable_in_annotation(n): a finding at node n, from clause `empty-iterable-in-annotation`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF037_empty_iterable_in_annotation(at: node, call: node) code "RUF037" "Remove the empty iterable argument; a deque starts empty. Keep any `maxlen` as a keyword: `deque(maxlen=...)`."
    suppress noqa "RUF037"
RUF037_empty_iterable_in_annotation(CALL, n) :- ruf037_in_annotation(n, CALL).

