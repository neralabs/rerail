.policy "ruff-fbt001-boolean-type-hint-positional-argument" revision 1
.guests off
.description "Make Python function parameters annotated as bool keyword-only; a bare True or False passed by position hides what it switches."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// FBT001(n): a finding at node n, from clause `boolean-type-hint-positional-argument`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation FBT001(at: node, name: loc) "Make the boolean parameter `{name}` keyword-only by moving it after `*` and update positional callers; keep it positional only when a parent signature or callback protocol requires it."
    suppress noqa "FBT001"
FBT001_raw(n, NAME) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n, !fbt001_tok_follows_4(n),
    child(p8, n, _),
    (kind(p8, "typed_parameter") ; kind(p8, "typed_default_parameter")),
    field(p8, "type", c9), fbt001_bool_annotation(c9),
    count : { precedes(s10, p8), fbt001_alt_10(s10) } = 0, child(p12, p8, _),
    kind(p12, "parameters"), child(p13, p12, _), fbt001_checked_function(p13).

// override(n): the JSON util `override`, used where the JSON says `matches: "override"`
.decl fbt001_override(n: node)
fbt001_override(n) :-
    ( kind(n, "identifier")
    ; kind(n, "attribute")
    ; kind(n, "parenthesized_expression")
    ),

    ( sym_of(n, "typing.override")
    ; sym_of(n, "typing_extensions.override")
    ; sym_of(n, "_typeshed.override")
    ).


// fn_ref(n): the JSON util `fn-ref`, used where the JSON says `matches: "fn-ref"`
//   FN: metavariable this relation binds for the calling rule
.decl fbt001_fn_ref(n: node, fn: loc)
fbt001_fn_ref(n, FN) :- kind(n, "identifier"), node(_, n, _, _, _), FN = n.
fbt001_fn_ref(n, FN) :- kind(n, "parenthesized_expression"), child(n, c1, _), fbt001_fn_ref(c1, FN).

// setter(n): the JSON util `setter`, used where the JSON says `matches: "setter"`
//   FN: metavariable this relation binds for the calling rule
.decl fbt001_setter(n: node, fn: loc)
fbt001_setter(n, FN) :- kind(n, "attribute"), field(n, "attribute", c1), glob("setter", c1),
    field(n, "object", c2), fbt001_fn_ref(c2, FN).
fbt001_setter(n, FN) :- kind(n, "parenthesized_expression"), child(n, c3, _), fbt001_setter(c3, FN).

// checked_function(n): the JSON util `checked-function`, used where the JSON says `matches: "checked-function"`
.decl fbt001_checked_function(n: node)
fbt001_checked_function(n) :- kind(n, "function_definition"), field(n, "name", c1),
    node(_, c1, _, _, _), FN = c1,
    !glob("{bool,__post_init__,__contains__,__getitem__,__setitem__,__delitem__,__add__,__radd__,__iadd__,__sub__,__rsub__,__isub__,__mul__,__rmul__,__imul__,__truediv__,__rtruediv__,__itruediv__,__floordiv__,__rfloordiv__,__ifloordiv__,__mod__,__rmod__,__imod__,__pow__,__rpow__,__ipow__,__lshift__,__rlshift__,__ilshift__,__rshift__,__rrshift__,__irshift__,__matmul__,__rmatmul__,__imatmul__,__and__,__rand__,__iand__,__or__,__ror__,__ior__,__xor__,__rxor__,__ixor__,__gt__,__lt__,__ge__,__le__,__eq__,__ne__,__pos__,__neg__,__invert__}", c1),
    count : { child(p2, n, _), kind(p2, "decorated_definition"), child(p2, c3, _), kind(c3, "decorator"), child(c3, c4, _), (fbt001_override(c4) ; fbt001_setter(c4, FN)) } = 0.

// typing_union(n): the JSON util `typing-union`, used where the JSON says `matches: "typing-union"`
.decl fbt001_typing_union(n: node)
fbt001_typing_union(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Union")
    ; sym_of(n, "typing_extensions.Union")
    ; sym_of(n, "_typeshed.Union")
    ).


// typing_optional(n): the JSON util `typing-optional`, used where the JSON says `matches: "typing-optional"`
.decl fbt001_typing_optional(n: node)
fbt001_typing_optional(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Optional")
    ; sym_of(n, "typing_extensions.Optional")
    ; sym_of(n, "_typeshed.Optional")
    ).


// generic_head(n): the JSON util `generic-head`, used where the JSON says `matches: "generic-head"`
.decl fbt001_generic_head(n: node)
fbt001_generic_head(n) :- fbt001_tok_precedes_1(n), child(p8, n, _), kind(p8, "subscript").
fbt001_generic_head(n) :- kind(n, "identifier"), child(p9, n, _), kind(p9, "generic_type").

// slice_item(n): the JSON util `slice-item`, used where the JSON says `matches: "slice-item"`
.decl fbt001_slice_item(n: node)
fbt001_slice_item(n) :- !glob("[\\[\\],]", n),
    ( fbt001_tok_follows_2(n), child(p1, n, _), kind(p1, "subscript")
    ; child(p2, n, _), kind(p2, "type_parameter")
    ).


// slice_comma(n): the JSON util `slice-comma`, used where the JSON says `matches: "slice-comma"`
.decl fbt001_slice_comma(n: node)
fbt001_slice_comma(n) :- within_stop(c1, n, fbt001_stop_3), glob("\\,", c1), child(p2, c1, _),
    (kind(p2, "subscript") ; kind(p2, "type_parameter")).

// bool_tuple(n): the JSON util `bool-tuple`, used where the JSON says `matches: "bool-tuple"`
.decl fbt001_bool_tuple(n: node)
fbt001_bool_tuple(n) :- fbt001_demand_bool_tuple(n), kind(n, "tuple"), child(n, c1, _),
    fbt001_bool_annotation(c1).
fbt001_bool_tuple(n) :- fbt001_demand_bool_tuple(n),
    (kind(n, "type") ; kind(n, "parenthesized_expression")), child(n, c2, _),
    fbt001_bool_tuple(c2).

// bool_annotation(n): the JSON util `bool-annotation`, used where the JSON says `matches: "bool-annotation"`
.decl fbt001_bool_annotation(n: node)
fbt001_bool_annotation(n) :- fbt001_demand_bool_annotation(n), kind(n, "identifier"),
    glob("bool", n), global_ref(n, "bool").
fbt001_bool_annotation(n) :- fbt001_demand_bool_annotation(n),
    (kind(n, "string") ; kind(n, "concatenated_string")), value(n, "bool"),
    count : { has(n, c1, "string_start"), glob("**[fFtT]**", c1) } = 0,
    parsed(n, "annotation", r2), has(r2, c3, "identifier"), global_ref(c3, "bool").
fbt001_bool_annotation(n) :- fbt001_demand_bool_annotation(n),
    (kind(n, "type") ; kind(n, "parenthesized_expression")), child(n, c4, _),
    fbt001_bool_annotation(c4).
fbt001_bool_annotation(n) :- fbt001_demand_bool_annotation(n),
    (kind(n, "binary_operator") ; kind(n, "union_type")), fbt001_tok_has_3(n),
    child(n, c13, _), fbt001_bool_annotation(c13).
fbt001_bool_annotation(n) :- fbt001_demand_bool_annotation(n), child(n, c14, _), fbt001_generic_head(c14),
    fbt001_typing_union(c14), fbt001_alt_6(n).
fbt001_bool_annotation(n) :- fbt001_demand_bool_annotation(n), child(n, c17, _), fbt001_generic_head(c17),
    fbt001_typing_optional(c17), !fbt001_slice_comma(n), within_stop(c18, n, fbt001_stop_3),
    fbt001_slice_item(c18), fbt001_bool_annotation(c18).

// tok_precedes_1(n): a later sibling of n, a named node or an anonymous token, matches "^\\[$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl fbt001_tok_precedes_1(n: node)
.stored fbt001_tok_precedes_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
fbt001_tok_precedes_1(n) :- next_sibling(n, s1), glob("\\[", s1).
fbt001_tok_precedes_1(n) :- structural_after(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, _, en7), o5 = en7 + strlen(g3), token(p4, _, t2, o5, _),
    match("\\[", t2).
fbt001_tok_precedes_1(n) :- structural_after(n, g3), match("(?s)^(?:\\s*(?:\\[).*)$", g3).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\[$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl fbt001_tok_follows_2(n: node)
.stored fbt001_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
fbt001_tok_follows_2(n) :- precedes(s1, n), glob("\\[", s1).
fbt001_tok_follows_2(n) :- child(p4, n, _), node(_, n, _, st6, _), token(p4, _, t2, _, en7),
    en7 <= st6, match("\\[", t2).
fbt001_tok_follows_2(n) :- structural_before(n, g3), match("(?s)^(?:.*(?:\\[).*)$", g3).
fbt001_tok_follows_2(n) :- precedes(o5, n), structural_before(o5, g3),
    match("(?s)^(?:.*(?:\\[).*)$", g3).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^\\|$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl fbt001_tok_has_3(n: node)
.stored fbt001_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
fbt001_tok_has_3(n) :- child(n, c5, _), glob("|", c5).
fbt001_tok_has_3(n) :- op(n, t6), match("\\|", t6).
fbt001_tok_has_3(n) :- child(n, c12, _), structural_before(c12, g7),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\|)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g7).
fbt001_tok_has_3(n) :- child(n, c12, _), structural_after(c12, g7),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\|)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g7).
fbt001_tok_has_3(n) :- node_text(n, g7), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\|)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g7).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "^[=:]$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl fbt001_tok_follows_4(n: node)
.stored fbt001_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
fbt001_tok_follows_4(n) :- precedes(s1, n), glob("[=:]", s1).
fbt001_tok_follows_4(n) :- child(p4, n, _), node(_, n, _, st6, _), token(p4, _, t2, _, en7),
    en7 <= st6, match("[=:]", t2).
fbt001_tok_follows_4(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:[=:])(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
fbt001_tok_follows_4(n) :- precedes(o5, n), structural_before(o5, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:[=:])(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).

// demand_alt_6: the nodes alt_6 is asked at (its recursion looks at every descendant)
.decl fbt001_demand_alt_6(n: node)
fbt001_demand_alt_6(n) :- fbt001_demand_bool_annotation(n), child(n, c14, _), fbt001_generic_head(c14),
    fbt001_typing_union(c14).

// demand_bool_annotation: the nodes bool_annotation is asked at (its recursion looks at every descendant)
.decl fbt001_demand_bool_annotation(n: node)
fbt001_demand_bool_annotation(c9) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n, child(p8, n, _),
    (kind(p8, "typed_parameter") ; kind(p8, "typed_default_parameter")),
    field(p8, "type", c9), child(p12, p8, _), kind(p12, "parameters"),
    child(p13, p12, _), fbt001_checked_function(p13).
fbt001_demand_bool_annotation(c1) :- fbt001_demand_bool_tuple(n), kind(n, "tuple"), child(n, c1, _).
fbt001_demand_bool_annotation(c4) :- fbt001_demand_bool_annotation(n),
    (kind(n, "type") ; kind(n, "parenthesized_expression")), child(n, c4, _).
fbt001_demand_bool_annotation(c13) :- fbt001_demand_bool_annotation(n),
    (kind(n, "binary_operator") ; kind(n, "union_type")), fbt001_tok_has_3(n),
    child(n, c13, _).
fbt001_demand_bool_annotation(c18) :- fbt001_demand_bool_annotation(n), child(n, c17, _),
    fbt001_generic_head(c17), fbt001_typing_optional(c17), within_stop(c18, n, fbt001_stop_3),
    fbt001_slice_item(c18).
fbt001_demand_bool_annotation(c1) :- fbt001_demand_alt_6(n), fbt001_slice_comma(n),
    within_stop(c1, n, fbt001_stop_3), fbt001_slice_item(c1).

// demand_bool_tuple: the nodes bool_tuple is asked at (its recursion looks at every descendant)
.decl fbt001_demand_bool_tuple(n: node)
fbt001_demand_bool_tuple(c2) :- fbt001_demand_bool_tuple(n),
    (kind(n, "type") ; kind(n, "parenthesized_expression")), child(n, c2, _).
fbt001_demand_bool_tuple(c2) :- fbt001_demand_alt_6(n), within_stop(c2, n, fbt001_stop_3), fbt001_slice_item(c2).

// stop_3(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl fbt001_stop_3(n: node)
fbt001_stop_3(n) :- node(_, n, _, _, _), !kind(n, "type_parameter").

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl fbt001_alt_6(n: node)
fbt001_alt_6(n) :- fbt001_demand_alt_6(n), fbt001_slice_comma(n), within_stop(c1, n, fbt001_stop_3),
    fbt001_slice_item(c1), fbt001_bool_annotation(c1).
fbt001_alt_6(n) :- fbt001_demand_alt_6(n), !fbt001_slice_comma(n), within_stop(c2, n, fbt001_stop_3),
    fbt001_slice_item(c2), fbt001_bool_tuple(c2).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl fbt001_alt_10(n: node)
fbt001_alt_10(n) :- (kind(n, "keyword_separator") ; kind(n, "list_splat_pattern")).
fbt001_alt_10(n) :- kind(n, "typed_parameter"), child(n, c1, _),
    kind(c1, "list_splat_pattern").

// main's file condition {"notRegex": "\\.pyi$"}
.decl FBT001_raw(at: node, name: loc)
FBT001(v0, v1) :- FBT001_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).
