.policy "ruff-try003-raise-vanilla-args" revision 1
.guests off
.description "Build exception messages inside a custom exception class instead of passing message text at the raise site; the wording then stays consistent wherever it is raised."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// TRY003(n): a finding at node n, from clause `raise-vanilla-args`.
// Each rule below is one way the JSON `rule` can match.
.violation TRY003(at: node) "Define an exception class that builds this message itself (for example in `__init__`) and raise it with only the varying values. Leave it if a dedicated class would not help callers."
    suppress noqa "TRY003"
TRY003(n) :- kind(n, "call"), try003_raised(n),
    count : { field(n, "function", c1), try003_not_implemented(c1) } = 0,
    field(n, "arguments", c2), kind(c2, "argument_list"), child(c2, c3, _),
    try003_message(c3), !try003_tok_follows_1(c3).

// not_implemented(n): the JSON util `not-implemented`, used where the JSON says `matches: "not-implemented"`
.decl try003_not_implemented(n: node)
try003_not_implemented(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "NotImplementedError"), sym_of(n, "builtins.NotImplementedError").
try003_not_implemented(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    try003_not_implemented(c1).

// text_part(n): the JSON util `text-part`, used where the JSON says `matches: "text-part"`
.decl try003_text_part(n: node)
try003_text_part(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBtT]**", c1) } = 0,
    ( value(n, v1), match(".*\\s.*", v1)
    ; child(n, c2, _), kind(c2, "string_content"), try003_alt_1(c2)
    ).


// message(n): the JSON util `message`, used where the JSON says `matches: "message"`
.decl try003_message(n: node)
try003_message(n) :- try003_text_part(n).
try003_message(n) :- kind(n, "concatenated_string"), child(n, c1, _), try003_text_part(c1),
    count : { child(n, c2, _), kind(c2, "string"), child(c2, c3, _), kind(c3, "string_start"), glob("**[tT]**", c3) } = 0.
try003_message(n) :- kind(n, "parenthesized_expression"), child(n, c4, _), try003_message(c4).

// raised(n): the JSON util `raised`, used where the JSON says `matches: "raised"`
.decl try003_raised(n: node)
try003_raised(n) :- child(p1, n, _), kind(p1, "raise_statement"),
    count : { field(p2, "cause", n), kind(p2, "raise_statement") } = 0.
try003_raised(n) :- child(p3, n, _), kind(p3, "parenthesized_expression"), try003_raised(p3).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl try003_tok_follows_1(n: node)
.stored try003_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
try003_tok_follows_1(n) :- precedes(s4, n), glob("\\,", s4).
try003_tok_follows_1(n) :- child(p7, n, _), node(_, n, _, st9, _), token(p7, _, t5, _, en10),
    en10 <= st9, match(",", t5).
try003_tok_follows_1(n) :- structural_before(n, g6), match("(?s)^(?:.*(?:,).*)$", g6).
try003_tok_follows_1(n) :- precedes(o8, n), structural_before(o8, g6),
    match("(?s)^(?:.*(?:,).*)$", g6).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl try003_alt_1(n: node)
try003_alt_1(n) :- match(".*\\s.*", n), child(p1, n, _), kind(p1, "string"), child(p1, c2, _),
    kind(c2, "string_start"), glob("**[rR]**", c2).
try003_alt_1(n) :- match("(?:[^\\\\\\s]|\\\\\\r?\\n|\\\\N\\{[^}]*\\}|\\\\[^\\sN])*(?:\\s|\\\\[^\\S\\r\\n]|\\\\(?:[ntrfv]|x(?i:20|09|0[a-d]|85|[aA]0)|(?:u|U0000)(?i:0020|0009|000[a-d]|0085|00[aA]0|1680|200[0-9a]|202[89f]|205f|3000)|0(?:11|12|13|14|15|40)|(?:11|12|13|14|15|40)(?:[^0-7]|$)|205|240))(?s:.*)", n),
    child(p3, n, _), kind(p3, "string"),
    count : { child(p3, c4, _), kind(c4, "string_start"), glob("**[rR]**", c4) } = 0.
