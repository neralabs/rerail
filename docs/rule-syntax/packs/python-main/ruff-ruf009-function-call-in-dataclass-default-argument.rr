// all_expr: x is a module-level `__all__ =`, `+=` or `: T =` value, or a part of one that lists names
//   (Ruff's extract_dunder_all_names: `+` chains, parentheses, walrus values, list(...) and tuple(...))
.decl ruf009_all_expr(x: node)
ruf009_all_expr(x) :- (kind(st, "assignment") ; kind(st, "augmented_assignment")),
    field(st, "left", l), kind(l, "identifier"), text(l, "__all__"), child(es, st, _),
    kind(es, "expression_statement"), child(m, es, _), kind(m, "module"),
    field(st, "right", x).
ruf009_all_expr(y) :- ruf009_all_expr(x), kind(x, "assignment"), field(x, "right", y).
ruf009_all_expr(y) :- ruf009_all_expr(x), kind(x, "binary_operator"),
    (field(x, "left", y) ; field(x, "right", y)).
ruf009_all_expr(y) :- ruf009_all_expr(x), kind(x, "parenthesized_expression"), child(x, y, _),
    !kind(y, "comment").
ruf009_all_expr(y) :- ruf009_all_expr(x), kind(x, "named_expression"), field(x, "value", y).
ruf009_all_expr(y) :- ruf009_all_expr(x), kind(x, "call"), field(x, "function", f),
    kind(f, "identifier"), (text(f, "list") ; text(f, "tuple")),
    field(x, "arguments", a), child(a, y, _).

// all_entry: string e is an entry of a module `__all__` definition, exporting the name x
.decl ruf009_all_entry(e: node, x: symbol)
ruf009_all_entry(e, x) :- ruf009_all_expr(l), (kind(l, "list") ; kind(l, "tuple")), child(l, e, _),
    (kind(e, "string") ; kind(e, "concatenated_string")),
    count : { within(i, e), kind(i, "interpolation") } = 0, str(e, x).

// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl ruf009_args_plain(l: node, a: node, i: number)
ruf009_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl ruf009_args_splat(l: node, i: number)
ruf009_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl ruf009_args_pos(l: node, a: node, j: number)
ruf009_args_pos(l, a, j) :- ruf009_args_plain(l, a, i), count : { ruf009_args_splat(l, k), k < i } = 0,
    j = count : { ruf009_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl ruf009_args_star(l: node, j: number)
ruf009_args_star(l, j) :- ruf009_args_splat(l, i), count : { ruf009_args_splat(l, k), k < i } = 0,
    j = count : { ruf009_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl ruf009_args_kwp(l: node, k: symbol, v: node)
ruf009_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl ruf009_args_lit_dict(s: node, d: node)
ruf009_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !ruf009_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl ruf009_args_str_pair(p: node)
ruf009_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl ruf009_args_kw(l: node, k: symbol, v: node)
ruf009_args_kw(l, k, v) :- ruf009_args_kwp(l, k, v).
ruf009_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), ruf009_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl ruf009_args_kw_spread(l: node)
ruf009_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !ruf009_args_lit_dict(s, _).

// arg_tp_1: call n passes v for slot `tp` of (name, tp), syntactic: Ruff's find_argument
.decl ruf009_arg_tp_1(n: node, v: node)
ruf009_arg_tp_1(n, v) :- kind(n, "call"), field(n, "arguments", l), ruf009_args_kwp(l, "tp", v).
ruf009_arg_tp_1(n, v) :- kind(n, "call"), field(n, "arguments", l), ruf009_args_pos(l, v, 1),
    !ruf009_args_kwp(l, "tp", _).

// arg_no_tp_1: call n does not pass slot `tp` of (name, tp), syntactic: Ruff's find_argument
.decl ruf009_arg_no_tp_1(n: node)
ruf009_arg_no_tp_1(n) :- kind(n, "call"), field(n, "arguments", l), !ruf009_args_kwp(l, "tp", _),
    !ruf009_args_pos(l, _, 1).

// tok_follows_21(n): an earlier sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf009_tok_follows_21(n: node)
.stored ruf009_tok_follows_21 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf009_tok_follows_21(n) :- next_sibling(s1, n), glob("=", s1).
ruf009_tok_follows_21(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("=", t2).
ruf009_tok_follows_21(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)\\s*)$", g3).

// tok_has_22(n): a child of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf009_tok_has_22(n: node)
.stored ruf009_tok_has_22 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf009_tok_has_22(n) :- child(n, c4, _), glob("=", c4).
ruf009_tok_has_22(n) :- op(n, t5), match("=", t5).
ruf009_tok_has_22(n) :- child(n, c11, _), structural_before(c11, g6),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g6).
ruf009_tok_has_22(n) :- child(n, c11, _), structural_after(c11, g6),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g6).
ruf009_tok_has_22(n) :- node_text(n, g6), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g6).

// tok_has_23(n): a child of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf009_tok_has_23(n: node)
.stored ruf009_tok_has_23 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf009_tok_has_23(n) :- child(n, c1, _), glob("=", c1).
ruf009_tok_has_23(n) :- op(n, t2), match("=", t2).
ruf009_tok_has_23(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ruf009_tok_has_23(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ruf009_tok_has_23(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).

// demand_newtype_call: the nodes newtype_call is asked at (its recursion looks at every descendant)
.decl ruf009_demand_newtype_call(n: node)
ruf009_demand_newtype_call(c9) :- ruf009_demand_newtype_call(n), kind(n, "parenthesized_expression"),
    child(n, c9, _).
ruf009_demand_newtype_call(x2) :- kind(n, "identifier"), ref_site(n, b1), site_only(b1),
    binding_value(b1, x2), kind(b1, "assignment").

// demand_class_var_import_follows: the nodes class_var_import_follows is asked at (it looks at every ancestor of every node)
.decl ruf009_demand_class_var_import_follows(n: node)
ruf009_demand_class_var_import_follows(n) :- kind(n, "identifier"), glob("ClassVar", n),
    docof(n, d3), modnode(d3, m4).

