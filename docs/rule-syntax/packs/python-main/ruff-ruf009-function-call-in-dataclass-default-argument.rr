// literal_truthy(n): the JSON util `literal-truthy`, used where the JSON says `matches: "literal-truthy"`
.decl ruf009_literal_truthy(n: node)
ruf009_literal_truthy(n) :-
    ( kind(n, "true")
    ; kind(n, "ellipsis")
    ; kind(n, "lambda")
    ; kind(n, "generator_expression")
    ).

ruf009_literal_truthy(n) :- (kind(n, "integer") ; kind(n, "float")),
    match("(?:0[xXbBoO][0_]*[1-9a-fA-F]|[0-9_.]*[1-9]).*", n).
ruf009_literal_truthy(n) :- kind(n, "string"),
    ( child(n, c1, _), kind(c1, "string_start"), glob("**[tT]**", c1)
    ; child(n, c2, _), kind(c2, "string_content")
    ; child(n, c3, _), kind(c3, "interpolation"), ruf009_alt_68(c3)
    ).

ruf009_literal_truthy(n) :- kind(n, "concatenated_string"), child(n, c15, _),
    ruf009_literal_truthy(c15).
ruf009_literal_truthy(n) :- (kind(n, "list") ; kind(n, "set") ; kind(n, "tuple")),
    child(n, c16, _), !ruf009_alt_74(c16).
ruf009_literal_truthy(n) :- kind(n, "dictionary"), child(n, c17, _), kind(c17, "pair").
ruf009_literal_truthy(n) :- kind(n, "call"), field(n, "function", c18),
    kind(c18, "identifier"), glob("{list,tuple,set,dict,frozenset}", c18),
    global_ref(c18, g19), ruf009_set_75(g19), field(n, "arguments", c20),
    kind(c20, "argument_list"), k22 = count : { child(c20, c21, _), !ruf009_alt_55(c21) },
    k22 >= 1, k22 <= 1, child(c20, c23, _), ruf009_literal_truthy(c23), !ruf009_alt_78(c23).
ruf009_literal_truthy(n) :- kind(n, "parenthesized_expression"), child(n, c26, _),
    ruf009_literal_truthy(c26).

// RUF009(n, detail): findings from clauses `function-call-in-dataclass-default`, `function-call-in-attrs-default`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
.violation RUF009(at: node, detail: symbol) "Pass the callable as {detail}...)`, using a lambda if it takes arguments, or assign the result to a module-level constant if sharing it is intended; leave immutable results."
    suppress noqa "RUF009"
RUF009(n, "`field(default_factory=") :- kind(n, "call"), ruf009_stdlib_value(n),
    count : { field(n, "function", c1), ruf009_alt_80(c1) } = 0.
RUF009(n, "`attrs.field(factory=") :- kind(n, "call"), ruf009_attrs_value(n),
    count : { field(n, "function", c1), ruf009_alt_81(c1) } = 0.

.decl ruf009_alt_12_u0(n: node)
ruf009_alt_12_u0(n) :- kind(n, "subscript"), child(n, c1, _), ruf009_generic_item(c1).
ruf009_alt_12_u0(n) :- kind(n, "generic_type"), child(n, c2, _), kind(c2, "type_parameter"),
    child(c2, c3, _), ruf009_generic_item(c3).

.decl ruf009_alt_12_u1(n: node)
ruf009_alt_12_u1(n) :- kind(n, "subscript"), child(n, c1, _), ruf009_generic_item(c1),
    !ruf009_immutable_annotation_u0(c1).
ruf009_alt_12_u1(n) :- kind(n, "generic_type"), child(n, c2, _), kind(c2, "type_parameter"),
