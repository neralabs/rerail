// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^[+-]$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf032_tok_has_1(n: node)
.stored ruf032_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf032_tok_has_1(n) :- child(n, c1, _), glob("[+-]", c1).
ruf032_tok_has_1(n) :- op(n, t2), match("[+-]", t2).
ruf032_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:[+-])(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ruf032_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:[+-])(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ruf032_tok_has_1(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:[+-])(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).

// counted_1(n): the siblings the JSON `nthChild.ofRule` counts
.decl ruf032_counted_1(n: node)
ruf032_counted_1(n) :- node(_, n, _, _, _), !kind(n, "comment"),
    !kind(n, "line_continuation").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl ruf032_alt_2(n: node)
ruf032_alt_2(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
ruf032_alt_2(n) :- node(_, n, _, _, _), glob("(", n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
//   ARG: metavariable this relation binds for the calling rule
.decl ruf032_alt_3(n: node, arg: loc)
ruf032_alt_3(n, ARG) :- ruf032_float_expr_decimal_from_float_literal_in_string_annotation(n),
    ruf032_first_arg_decimal_from_float_literal_in_string_annotation(n), ARG = n.
ruf032_alt_3(n, ARG) :- ruf032_in_string(n, ARG).
