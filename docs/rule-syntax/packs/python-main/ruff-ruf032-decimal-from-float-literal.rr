// first_arg_decimal_from_float_literal_in_string_annotation(n): the JSON util `first-arg`, used where the JSON says `matches: "first-arg"`
.decl ruf032_first_arg_decimal_from_float_literal_in_string_annotation(n: node)
ruf032_first_arg_decimal_from_float_literal_in_string_annotation(n) :- child(p1, n, _),
    kind(p1, "argument_list"), child(p2, p1, _), kind(p2, "call"), child(p2, c3, _),
    ruf032_callee_decimal_from_float_literal_in_string_annotation(c3),
    count : { precedes(s4, n), !ruf032_alt_2(s4) } = 0.
ruf032_first_arg_decimal_from_float_literal_in_string_annotation(n) :- child(p5, n, _),
    kind(p5, "parenthesized_expression"),
    ruf032_first_arg_decimal_from_float_literal_in_string_annotation(p5).

// in_string(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   ARG: metavariable this relation binds for the calling rule
.decl ruf032_in_string(n: node, arg: loc)
ruf032_in_string(n, ARG) :- (kind(n, "string") ; kind(n, "concatenated_string")),
