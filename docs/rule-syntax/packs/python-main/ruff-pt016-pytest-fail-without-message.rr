// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl pt016_args_plain(l: node, a: node, i: number)
pt016_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl pt016_args_splat(l: node, i: number)
pt016_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl pt016_args_pos(l: node, a: node, j: number)
pt016_args_pos(l, a, j) :- pt016_args_plain(l, a, i), count : { pt016_args_splat(l, k), k < i } = 0,
    j = count : { pt016_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl pt016_args_star(l: node, j: number)
pt016_args_star(l, j) :- pt016_args_splat(l, i), count : { pt016_args_splat(l, k), k < i } = 0,
    j = count : { pt016_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl pt016_args_kwp(l: node, k: symbol, v: node)
pt016_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl pt016_args_lit_dict(s: node, d: node)
pt016_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !pt016_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl pt016_args_str_pair(p: node)
pt016_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl pt016_args_kw(l: node, k: symbol, v: node)
pt016_args_kw(l, k, v) :- pt016_args_kwp(l, k, v).
pt016_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), pt016_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl pt016_args_kw_spread(l: node)
pt016_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !pt016_args_lit_dict(s, _).

// arg_reason_1: call n passes v for slot `reason` of (reason), syntactic: Ruff's find_argument
.decl pt016_arg_reason_1(n: node, v: node)
pt016_arg_reason_1(n, v) :- kind(n, "call"), field(n, "arguments", l),
    pt016_args_kwp(l, "reason", v).
pt016_arg_reason_1(n, v) :- kind(n, "call"), field(n, "arguments", l), pt016_args_pos(l, v, 0),
    !pt016_args_kwp(l, "reason", _).
pt016_arg_reason_1(n, v) :- kind(n, "call"), field(n, "arguments", v),
    kind(v, "generator_expression").

// arg_no_reason_1: call n does not pass slot `reason` of (reason), syntactic: Ruff's find_argument
.decl pt016_arg_no_reason_1(n: node)
pt016_arg_no_reason_1(n) :- kind(n, "call"), field(n, "arguments", l),
    !pt016_args_kwp(l, "reason", _), !pt016_args_pos(l, _, 0), !kind(l, "generator_expression").

// arg_msg_2: call n passes v for slot `msg` of (*, msg), syntactic: Ruff's find_argument
.decl pt016_arg_msg_2(n: node, v: node)
pt016_arg_msg_2(n, v) :- kind(n, "call"), field(n, "arguments", l), pt016_args_kwp(l, "msg", v).

// arg_no_msg_2: call n does not pass slot `msg` of (*, msg), syntactic: Ruff's find_argument
.decl pt016_arg_no_msg_2(n: node)
pt016_arg_no_msg_2(n) :- kind(n, "call"), field(n, "arguments", l), !pt016_args_kwp(l, "msg", _).

// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl pt016_alt_1_u0_empty(n: node)

// alt_2_u0_empty: level -1 of an unrolled recursion, empty
.decl pt016_alt_2_u0_empty(n: node)

// empty_or_null_u0_empty: level -1 of an unrolled recursion, empty
.decl pt016_empty_or_null_u0_empty(n: node)

// part_empty_u0: level -1 of an unrolled recursion, empty
.decl pt016_part_empty_u0(n: node)

// part_empty_u0_empty: level -1 of an unrolled recursion, empty
.decl pt016_part_empty_u0_empty(n: node)

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pt016_alt_1(n: node)
pt016_alt_1(n) :- pt016_alt_1_u7(n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pt016_alt_2(n: node)
pt016_alt_2(n) :- pt016_alt_2_u7(n).
