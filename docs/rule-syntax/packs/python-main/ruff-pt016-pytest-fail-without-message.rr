.policy "ruff-pt016-pytest-fail-without-message" revision 1
.guests off
.description "Pass a non-empty message to pytest.fail calls; a bare failure gives no hint why the test failed."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// fail_ref(n): the JSON util `fail-ref`, used where the JSON says `matches: "fail-ref"`
.decl pt016_fail_ref(n: node)
pt016_fail_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "pytest.fail").

// fail_callee(n): the JSON util `fail-callee`, used where the JSON says `matches: "fail-callee"`
//   F: metavariable this relation binds for the calling rule
.decl pt016_fail_callee(n: node, f: loc)
pt016_fail_callee(n, F) :- pt016_fail_ref(n), node(_, n, _, _, _), F = n.
pt016_fail_callee(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pt016_fail_callee(c1, F).

// fail_call(n): the JSON util `fail-call`, used where the JSON says `matches: "fail-call"`
//   F: metavariable this relation binds for the calling rule
.decl pt016_fail_call(n: node, f: loc)
pt016_fail_call(n, F) :- kind(n, "call"), field(n, "function", c1), pt016_fail_callee(c1, F).

// part_has_text(n): the JSON util `part-has-text`, used where the JSON says `matches: "part-has-text"`
.decl pt016_part_has_text(n: node)
pt016_part_has_text(n) :- child(n, c1, _), kind(c1, "string_content"),
    !match("(\\\\\\r?\\n)+", c1).

// part_empty(n): the JSON util `part-empty`, used where the JSON says `matches: "part-empty"`
.decl pt016_part_empty(n: node)
pt016_part_empty(n) :- pt016_part_empty_u7(n).

// empty_or_null(n): the JSON util `empty-or-null`, used where the JSON says `matches: "empty-or-null"`
.decl pt016_empty_or_null(n: node)
pt016_empty_or_null(n) :- pt016_empty_or_null_u7(n).

// PT016(n): a finding at node n, from clause `pytest-fail-without-message`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PT016(at: node, f: node) "Add a message to `{f}(...)` that says why the test is failing, so the failure report explains itself."
    suppress noqa "PT016"
PT016(F, n) :- pt016_fail_call(n, F), kind(n, "call"), pt016_arg_no_reason_1(n), pt016_arg_no_msg_2(n).

// PT016_pytest_fail_empty_reason(n): a finding at node n, from clause `pytest-fail-empty-reason`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on R are added to every rule.
.violation PT016_pytest_fail_empty_reason(at: node, f: node) code "PT016" "Give `{f}(...)` a message that is not empty or `None`, saying why the test is failing."
    suppress noqa "PT016"
PT016_pytest_fail_empty_reason(F, n) :- pt016_fail_call(n, F), kind(n, "call"),
    pt016_arg_reason_1(n, a1), R = a1, pt016_empty_or_null(R).

// PT016_pytest_fail_empty_msg(n): a finding at node n, from clause `pytest-fail-empty-msg`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on M are added to every rule.
.violation PT016_pytest_fail_empty_msg(at: node, f: node) code "PT016" "Give `{f}(...)` a `msg=` value that is not empty or `None`, saying why the test is failing."
    suppress noqa "PT016"
PT016_pytest_fail_empty_msg(F, n) :- pt016_fail_call(n, F), kind(n, "call"),
    pt016_arg_no_reason_1(n), pt016_arg_msg_2(n, a1), M = a1, pt016_empty_or_null(M).

