.policy "ruff-async105-trio-sync-call" revision 1
.guests off
.description "Await calls to trio's async functions such as trio.sleep; without await the call only creates a coroutine that never runs."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// ASYNC105(n): a finding at node n, from clause `trio-sync-call`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation ASYNC105(at: node, callee: loc) "Call to `{callee}` is not immediately awaited"
    suppress noqa "ASYNC105"
ASYNC105(n, CALLEE) :- kind(n, "call"), child(n, c1, _), node(_, c1, _, _, _), CALLEE = c1,
    async105_callee_of_target(c1), next_sibling(c1, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")), !async105_awaited(n).

// scope_body(n): the JSON util `scope-body`, used where the JSON says `matches: "scope-body"`
.decl async105_scope_body(n: node)
async105_scope_body(n) :- kind(n, "block"), child(p1, n, _),
    (kind(p1, "function_definition") ; kind(p1, "class_definition")).

// lambda_body(n): the JSON util `lambda-body`, used where the JSON says `matches: "lambda-body"`
.decl async105_lambda_body(n: node)
async105_lambda_body(n) :- child(p1, n, _), kind(p1, "lambda"), async105_tok_follows_1(n).

// callee_position(n): the JSON util `callee-position`, used where the JSON says `matches: "callee-position"`
.decl async105_callee_position(n: node)
async105_callee_position(n) :- child(p1, n, _), kind(p1, "call"), next_sibling(n, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")).
async105_callee_position(n) :- child(p3, n, _), kind(p3, "parenthesized_expression"),
    async105_callee_position(p3).

// async_context(n): the JSON util `async-context`, used where the JSON says `matches: "async-context"`
.decl async105_async_context(n: node)
async105_async_context(n) :- within_stop(n, p1, async105_stop_1), kind(p1, "block"), child(p2, p1, _),
    kind(p2, "function_definition"), async105_tok_has_2(p2).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl async105_target(n: node)
async105_target(n) :- (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, q1), async105_set_2(q1).

// callee_of_target(n): the JSON util `callee-of-target`, used where the JSON says `matches: "callee-of-target"`
.decl async105_callee_of_target(n: node)
async105_callee_of_target(n) :- async105_target(n).
async105_callee_of_target(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    async105_callee_of_target(c1).

// awaited(n): the JSON util `awaited`, used where the JSON says `matches: "awaited"`
.decl async105_awaited(n: node)
async105_awaited(n) :- child(p1, n, _), async105_alt_3(p1).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^:$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl async105_tok_follows_1(n: node)
.stored async105_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
async105_tok_follows_1(n) :- precedes(s2, n), glob(":", s2).
async105_tok_follows_1(n) :- child(p5, n, _), node(_, n, _, st7, _), token(p5, _, t3, _, en8),
    en8 <= st7, match(":", t3).
async105_tok_follows_1(n) :- structural_before(n, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).
async105_tok_follows_1(n) :- precedes(o6, n), structural_before(o6, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^async$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl async105_tok_has_2(n: node)
.stored async105_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
async105_tok_has_2(n) :- child(n, c3, _), glob("async", c3).
async105_tok_has_2(n) :- op(n, t4), match("async", t4).
async105_tok_has_2(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g5).
async105_tok_has_2(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g5).
async105_tok_has_2(n) :- node_text(n, g5), !child(n, _, _),
    match("(?s)^(?:(?:.*\\W)?(?:async)(?:\\W.*)?)$", g5).

// set_2: symbols from the JSON `resolves.import`
.decl async105_set_2(v: symbol)
async105_set_2("trio.aclose_forcefully"). async105_set_2("trio.open_file").
async105_set_2("trio.open_ssl_over_tcp_listeners"). async105_set_2("trio.open_ssl_over_tcp_stream").
async105_set_2("trio.open_tcp_listeners"). async105_set_2("trio.open_tcp_stream").
async105_set_2("trio.open_unix_socket"). async105_set_2("trio.run_process").
async105_set_2("trio.serve_listeners"). async105_set_2("trio.serve_ssl_over_tcp").
async105_set_2("trio.serve_tcp"). async105_set_2("trio.sleep"). async105_set_2("trio.sleep_forever").
async105_set_2("trio.lowlevel.cancel_shielded_checkpoint"). async105_set_2("trio.lowlevel.checkpoint").
async105_set_2("trio.lowlevel.checkpoint_if_cancelled"). async105_set_2("trio.lowlevel.open_process").
async105_set_2("trio.lowlevel.permanently_detach_coroutine_object").
async105_set_2("trio.lowlevel.reattach_detached_coroutine_object").
async105_set_2("trio.lowlevel.temporarily_detach_coroutine_object").
async105_set_2("trio.lowlevel.wait_readable"). async105_set_2("trio.lowlevel.wait_task_rescheduled").
async105_set_2("trio.lowlevel.wait_writable").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl async105_stop_1(n: node)
async105_stop_1(n) :- async105_scope_body(n).
async105_stop_1(n) :- async105_lambda_body(n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl async105_alt_3(n: node)
async105_alt_3(n) :- kind(n, "await").
async105_alt_3(n) :- kind(n, "parenthesized_expression"), async105_awaited(n).
