.decl pyi061_literal(n: node)
pyi061_literal(n) :- pyi061_literal_sub(n).
pyi061_literal(n) :- pyi061_literal_gen(n).

// direct_slot(n): the JSON util `direct-slot`, used where the JSON says `matches: "direct-slot"`
.decl pyi061_direct_slot(n: node)
pyi061_direct_slot(n) :- child(p1, n, _), pyi061_literal_sub(p1), node(_, n, _, _, _), !kind(n, "comment"),
    pyi061_tok_follows_2(n).
pyi061_direct_slot(n) :- kind(n, "type"), child(p9, n, _), kind(p9, "type_parameter"),
    child(p10, p9, _), pyi061_literal_gen(p10).

// tuple_slot(n): the JSON util `tuple-slot`, used where the JSON says `matches: "tuple-slot"`
.decl pyi061_tuple_slot(n: node)
pyi061_tuple_slot(n) :- pyi061_direct_slot(n),
    (kind(n, "tuple") ; kind(n, "type"), child(n, c1, _), kind(c1, "tuple")),
