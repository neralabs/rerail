pyi061_literal_name(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pyi061_literal_name(c1).

// literal_sub(n): the JSON util `literal-sub`, used where the JSON says `matches: "literal-sub"`
.decl pyi061_literal_sub(n: node)
pyi061_literal_sub(n) :- kind(n, "subscript"), child(n, c1, _), pyi061_literal_name(c1),
