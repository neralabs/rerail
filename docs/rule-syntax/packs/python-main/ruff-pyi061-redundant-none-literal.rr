    en8 <= st7, match("\\[", t3).
pyi061_tok_follows_2(n) :- structural_before(n, g4), match("(?s)^(?:.*(?:\\[).*)$", g4).
pyi061_tok_follows_2(n) :- precedes(o6, n), structural_before(o6, g4),
