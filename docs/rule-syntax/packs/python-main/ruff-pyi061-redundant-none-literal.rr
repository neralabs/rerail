// nested_slot(n): the JSON util `nested-slot`, used where the JSON says `matches: "nested-slot"`
.decl pyi061_nested_slot(n: node)
pyi061_nested_slot(n) :- pyi061_slot(n), pyi061_wraps_literal(n).

// container_slot(n): the JSON util `container-slot`, used where the JSON says `matches: "container-slot"`
.decl pyi061_container_slot(n: node)
pyi061_container_slot(n) :- pyi061_slot(n), (pyi061_wraps_container(n) ; pyi061_tuple_slot(n)).

