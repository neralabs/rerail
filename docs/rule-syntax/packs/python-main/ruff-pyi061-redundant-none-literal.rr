// wraps_container(n): the JSON util `wraps-container`, used where the JSON says `matches: "wraps-container"`
.decl pyi061_wraps_container(n: node)
pyi061_wraps_container(n) :- (kind(n, "subscript") ; kind(n, "generic_type")).
pyi061_wraps_container(n) :- (kind(n, "type") ; kind(n, "parenthesized_expression")),
