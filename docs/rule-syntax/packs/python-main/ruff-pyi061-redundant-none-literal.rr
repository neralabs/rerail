.violation PYI061(at: node, none: node, detail: symbol) "{detail}. Leave it if runtime code reads this annotation's arguments."
    suppress noqa "PYI061"
PYI061(NONE, n, "This Literal holds only `None`; write plain `None` instead") :- pyi061_alt_14(n),
    pyi061_none_only(n, NONE).
PYI061(NONE, n, "Move `None` out of this Literal and write `Literal[...] | None` (`Optional[Literal[...]]` before Python 3.10)") :- pyi061_alt_14(n),
    pyi061_none_with_other(n, NONE).

