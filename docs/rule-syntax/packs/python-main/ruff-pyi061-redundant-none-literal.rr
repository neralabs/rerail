.decl pyi061_in_literal_chain(n: node)
pyi061_in_literal_chain(n) :- pyi061_literal(n).
pyi061_in_literal_chain(n) :- kind(n, "type_parameter"), child(p1, n, _), pyi061_literal_gen(p1).
