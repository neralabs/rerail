// slot(n): the JSON util `slot`, used where the JSON says `matches: "slot"`
.decl pyi061_slot(n: node)
pyi061_slot(n) :- pyi061_direct_slot(n).
pyi061_slot(n) :- child(p1, n, _), kind(p1, "tuple"),
    (pyi061_tuple_slot(p1) ; child(p2, p1, _), kind(p2, "type"), pyi061_tuple_slot(p2)), node(_, n, _, _, _),
    !kind(n, "comment").

// wraps_literal(n): the JSON util `wraps-literal`, used where the JSON says `matches: "wraps-literal"`
.decl pyi061_wraps_literal(n: node)
pyi061_wraps_literal(n) :- pyi061_literal(n).
pyi061_wraps_literal(n) :- (kind(n, "type") ; kind(n, "parenthesized_expression")),
