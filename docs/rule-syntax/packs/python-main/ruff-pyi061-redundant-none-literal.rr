.decl pyi061_tok_follows_1(n: node)
.stored pyi061_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi061_tok_follows_1(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
pyi061_tok_follows_1(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
