.policy "bandit-b102-exec-used" revision 2
.guests off
.description "Avoid exec() calls in Python, including through import aliases; running text as code is dangerous unless that text is fully trusted."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B102(n): a finding at node n, from clause `exec-call`.
// Each rule below is one way the JSON `rule` can match.
.violation B102(at: node) "Replace this exec call with code that performs the intended operation directly, unless the executed text is fully trusted."
    suppress nosec "B102"
B102(n) :- kind(n, "call"), field(n, "function", c1), b102_exec_callee(c1).

// exec_callee(n): the JSON util `exec-callee`, used where the JSON says `matches: "exec-callee"`
.decl b102_exec_callee(n: node)
b102_exec_callee(n) :- b102_demand_exec_callee(n), kind(n, "identifier"), glob("exec", n),
    count : { ref_site(n, b1), site_form(b1, "import"), (st2 = b1 ; within(b1, st2)), b102_alias_to_other(st2) } = 0.
b102_exec_callee(n) :- b102_demand_exec_callee(n), kind(n, "identifier"), ref_site(n, b3),
    site_form(b3, "import"), (st4 = b3 ; within(b3, st4)), b102_alias_to_exec(st4).
b102_exec_callee(n) :- b102_demand_exec_callee(n), kind(n, "parenthesized_expression"),
    child(n, c5, _), b102_exec_callee(c5).

// from_with_module(n): the JSON util `from-with-module`, used where the JSON says `matches: "from-with-module"`
.decl b102_from_with_module(n: node)
b102_from_with_module(n) :- kind(n, "import_from_statement"), field(n, "module_name", c1),
    ( kind(c1, "dotted_name")
    ; kind(c1, "relative_import"), child(c1, c2, _), kind(c2, "dotted_name")
    ).


// alias_to_exec(n): the JSON util `alias-to-exec`, used where the JSON says `matches: "alias-to-exec"`
.decl b102_alias_to_exec(n: node)
b102_alias_to_exec(n) :- kind(n, "aliased_import"), field(n, "name", c1), glob("exec", c1),
    count : { child(p2, n, _), b102_from_with_module(p2) } = 0.

// alias_to_other(n): the JSON util `alias-to-other`, used where the JSON says `matches: "alias-to-other"`
.decl b102_alias_to_other(n: node)
b102_alias_to_other(n) :- kind(n, "aliased_import"), !b102_alias_to_exec(n).
b102_alias_to_other(n) :- kind(n, "dotted_name"), child(p1, n, _), b102_from_with_module(p1).

// demand_exec_callee: the nodes exec_callee is asked at (its recursion looks at every descendant)
.decl b102_demand_exec_callee(n: node)
b102_demand_exec_callee(c1) :- kind(n, "call"), field(n, "function", c1).
b102_demand_exec_callee(c5) :- b102_demand_exec_callee(n), kind(n, "parenthesized_expression"),
    child(n, c5, _).
