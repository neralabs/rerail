.policy "ruff-c405-unnecessary-literal-set" revision 1
.guests off
.description "Write a set literal instead of passing a list or tuple literal to set(); the call builds a throwaway sequence first."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// C405(n): a finding at node n, from clause `unnecessary-literal-set`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation C405(at: node, call: node) "Replace `set([...])` or `set((...))` with the set literal `{{...}}`; an empty sequence becomes `set()`."
    suppress noqa "C405"
C405(CALL, n) :- c405_target(n), node(_, n, _, _, _), CALL = n.
C405(CALL, n) :- c405_in_annotation(n, CALL).

// callee_set(n): the JSON util `callee-set`, used where the JSON says `matches: "callee-set"`
.decl c405_callee_set(n: node)
c405_callee_set(n) :- kind(n, "identifier"), glob("set", n), global_ref(n, "set").
c405_callee_set(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), c405_callee_set(c1).

// sequence_literal(n): the JSON util `sequence-literal`, used where the JSON says `matches: "sequence-literal"`
.decl c405_sequence_literal(n: node)
c405_sequence_literal(n) :- (kind(n, "list") ; kind(n, "tuple")).
c405_sequence_literal(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c405_sequence_literal(c1).

// argument(n): the JSON util `argument`, used where the JSON says `matches: "argument"`
.decl c405_argument(n: node)
c405_argument(n) :- node(_, n, _, _, _), !c405_alt_1(n).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl c405_target(n: node)
c405_target(n) :- kind(n, "call"), field(n, "function", c1), c405_callee_set(c1),
    field(n, "arguments", c2), kind(c2, "argument_list"),
    k4 = count : { child(c2, c3, _), c405_argument(c3) }, k4 >= 1, k4 <= 1,
    child(c2, c5, _), c405_sequence_literal(c5).

// in_annotation(n): the JSON util `in-annotation`, used where the JSON says `matches: "in-annotation"`
//   CALL: metavariable this relation binds for the calling rule
.decl c405_in_annotation(n: node, call: loc)
c405_in_annotation(n, CALL) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), c405_alt_2(c2, CALL).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl c405_alt_1(n: node)
c405_alt_1(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
c405_alt_1(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   CALL: metavariable this relation binds for the calling rule
.decl c405_alt_2(n: node, call: loc)
c405_alt_2(n, CALL) :- c405_target(n), CALL = n.
c405_alt_2(n, CALL) :- c405_in_annotation(n, CALL).
