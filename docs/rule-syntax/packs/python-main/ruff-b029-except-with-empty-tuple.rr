.policy "ruff-b029-except-with-empty-tuple" revision 1
.guests off
.description "Don't write an except clause with an empty tuple as its type; it catches nothing, so name the exceptions to handle."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// B029(n): a finding at node n, from clause `except-with-empty-tuple`.
// Each rule below is one way the JSON `rule` can match.
.violation B029(at: node) "Using `except ():` with an empty tuple does not catch anything; add exceptions to handle"
    suppress noqa "B029"
B029(n) :- kind(n, "except_clause"), within_stop(c1, n, "block"), kind(c1, "tuple"),
    b029_type_slot(c1), count : { child(c1, c2, _), !b029_alt_1(c2) } = 0.

// type_slot(n): the JSON util `type-slot`, used where the JSON says `matches: "type-slot"`
.decl b029_type_slot(n: node)
b029_type_slot(n) :- b029_tok_follows_1(n), !b029_tok_precedes_2(n), child(p15, n, _),
    kind(p15, "except_clause").
b029_type_slot(n) :- !b029_tok_follows_3(n), child(p23, n, _), kind(p23, "as_pattern"),
    b029_type_slot(p23).
b029_type_slot(n) :- child(p24, n, _), kind(p24, "parenthesized_expression"),
    b029_type_slot(p24).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^(except|\\*)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b029_tok_follows_1(n: node)
.stored b029_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b029_tok_follows_1(n) :- next_sibling(s1, n), glob("{except,\\*}", s1).
b029_tok_follows_1(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("(except|\\*)", t2).
b029_tok_follows_1(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*\\W)?(?:except)\\s*|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\*)\\s*)$", g3).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b029_tok_precedes_2(n: node)
.stored b029_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b029_tok_precedes_2(n) :- next_sibling(n, s8), glob("\\,", s8).
b029_tok_precedes_2(n) :- structural_after(n, g10), match("\\s*", g10), child(p11, n, _),
    node(_, n, _, _, en14), o12 = en14 + strlen(g10), token(p11, _, t9, o12, _),
    match(",", t9).
b029_tok_precedes_2(n) :- structural_after(n, g10), match("(?s)^(?:\\s*(?:,).*)$", g10).

// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b029_tok_follows_3(n: node)
.stored b029_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b029_tok_follows_3(n) :- next_sibling(s16, n), match("(?s).*..*", s16).
b029_tok_follows_3(n) :- structural_before(n, g18), match("\\s*", g18), child(p19, n, _),
    node(_, n, _, st21, _), o20 = st21 - strlen(g18), token(p19, _, t17, _, o20),
    match("(?s).*..*", t17).
b029_tok_follows_3(n) :- structural_before(n, g18), match("(?s)^.*\\S\\s*$", g18).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl b029_alt_1(n: node)
b029_alt_1(n) :- node(_, n, _, _, _), glob("[(),]", n).
b029_alt_1(n) :- kind(n, "comment").
