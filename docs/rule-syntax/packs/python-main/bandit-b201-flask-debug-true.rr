.policy "bandit-b201-flask-debug-true" revision 1
.guests off
.description "Don't run a Flask app with debug enabled; the interactive debugger lets anyone who can reach it execute arbitrary code."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B201(n): a finding at node n, from clause `b201`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on APP, CTOR, DEBUG are added to every rule.
.violation B201(at: node) "Remove debug=True from this run call; the debugger lets anyone who reaches it run arbitrary code."
    suppress nosec "B201"
B201(n) :- n ~ `$APP.run($$$ARGS)`, kind(n, "call"), b201_arg_debug_1(n, a1), DEBUG = a1,
    ref_site(APP, b2), binding_value(b2, x3), b201_flask_instance(x3, CTOR),
    sym_of(CTOR, "flask.Flask"), value(DEBUG, true).

// flask_instance(n): the JSON util `flask-instance`, used where the JSON says `matches: "flask-instance"`
//   CTOR: metavariable this relation binds for the calling rule
.decl b201_flask_instance(n: node, ctor: loc)
b201_flask_instance(n, CTOR) :- n ~ `$CTOR($$$)`.

// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl b201_args_plain(l: node, a: node, i: number)
b201_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl b201_args_splat(l: node, i: number)
b201_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl b201_args_pos(l: node, a: node, j: number)
b201_args_pos(l, a, j) :- b201_args_plain(l, a, i), count : { b201_args_splat(l, k), k < i } = 0,
    j = count : { b201_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl b201_args_star(l: node, j: number)
b201_args_star(l, j) :- b201_args_splat(l, i), count : { b201_args_splat(l, k), k < i } = 0,
    j = count : { b201_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl b201_args_kwp(l: node, k: symbol, v: node)
b201_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl b201_args_lit_dict(s: node, d: node)
b201_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !b201_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl b201_args_str_pair(p: node)
b201_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl b201_args_kw(l: node, k: symbol, v: node)
b201_args_kw(l, k, v) :- b201_args_kwp(l, k, v).
b201_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), b201_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl b201_args_kw_spread(l: node)
b201_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !b201_args_lit_dict(s, _).

// arg_debug_1: call n passes v for slot `debug` of (host, port, debug, load_dotenv), as Python binds the call
.decl b201_arg_debug_1(n: node, v: node)
b201_arg_debug_1(n, v) :- kind(n, "call"), field(n, "arguments", l), b201_args_pos(l, v, 2),
    !b201_args_kw(l, "debug", _).
b201_arg_debug_1(n, v) :- kind(n, "call"), field(n, "arguments", l), b201_args_kw(l, "debug", v),
    count : { b201_args_kw(l, "debug", _) } = 1, !b201_args_pos(l, _, 2).

// arg_no_debug_1: call n does not pass slot `debug` of (host, port, debug, load_dotenv), as Python binds the call
.decl b201_arg_no_debug_1(n: node)
b201_arg_no_debug_1(n) :- kind(n, "call"), field(n, "arguments", l), !b201_args_pos(l, _, 2),
    count : { b201_args_star(l, j), j <= 2 } = 0, !b201_args_kw(l, "debug", _),
    !b201_args_kw_spread(l).
