.decl pt028_tok_has_5(n: node)
.stored pt028_tok_has_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt028_tok_has_5(n) :- field(n, "name", c6), glob("__init__", c6).
pt028_tok_has_5(n) :- op(n, t7), match("__init__", t7).
pt028_tok_has_5(n) :- child(n, c13, _), structural_before(c13, g8),
