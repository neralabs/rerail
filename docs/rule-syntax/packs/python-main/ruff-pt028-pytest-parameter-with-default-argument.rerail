.decl pt028_tok_has_3(n: node)
.stored pt028_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt028_tok_has_3(n) :- field(n, "name", c1), glob("__init__", c1).
pt028_tok_has_3(n) :- op(n, t2), match("__init__", t2).
pt028_tok_has_3(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*\\W)?(?:__init__).*)$", g3).
pt028_tok_has_3(n) :- child(n, c8, _), structural_after(c8, g3),
