// tok_has_6(n): a child of n, a named node or an anonymous token, matches "^__init__$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pt028_tok_has_6(n: node)
.stored pt028_tok_has_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt028_tok_has_6(n) :- field(n, "name", c15), glob("__init__", c15).
pt028_tok_has_6(n) :- op(n, t16), match("__init__", t16).
pt028_tok_has_6(n) :- child(n, c22, _), structural_before(c22, g17),
    match("(?s)^(?:(?:.*\\W)?(?:__init__).*)$", g17).
pt028_tok_has_6(n) :- child(n, c22, _), structural_after(c22, g17),
    match("(?s)^(?:(?:.*\\W)?(?:__init__).*)$", g17).
pt028_tok_has_6(n) :- node_text(n, g17), !child(n, _, _),
