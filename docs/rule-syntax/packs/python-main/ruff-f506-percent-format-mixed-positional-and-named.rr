.policy "ruff-f506-percent-format-mixed-positional-and-named" revision 1
.guests off
.description "Don't mix %(key) placeholders and positional placeholders in one %-format string; Python cannot format it."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// F506(n): a finding at node n, from clause `percent-format-mixed-positional-and-named`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on S are added to every rule.
.violation F506(at: node) "Use only %(key) placeholders or only positional ones in this format string; Python cannot format a mix."
    suppress noqa "F506"
F506(n) :- n ~ `$S % $R`, f506_format_string(S).

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl f506_plain_string(n: node)
f506_plain_string(n) :- kind(n, "string"), !match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", n).
f506_plain_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", c1) } = 0.

// format_string(n): the JSON util `format-string`, used where the JSON says `matches: "format-string"`
.decl f506_format_string(n: node)
f506_format_string(n) :- f506_demand_format_string(n), f506_plain_string(n),
    parsed(n, "percentFormat", r1),
    count : { child(r1, c2, _), kind(c2, "error") } = 0, has(r1, c3, "placeholder"),
    child(c3, c4, _), kind(c4, "mapping_key"), within(c5, r1),
    ( kind(c5, "placeholder"), count : { child(c5, c1, _), kind(c1, "mapping_key") } = 0
    ; kind(c5, "star")
    ).

f506_format_string(n) :- f506_demand_format_string(n), kind(n, "parenthesized_expression"),
    child(n, c7, _), f506_format_string(c7).

// demand_format_string: the nodes format_string is asked at (its recursion looks at every descendant)
.decl f506_demand_format_string(n: node)
f506_demand_format_string(S) :- n ~ `$S % $R`.
f506_demand_format_string(c7) :- f506_demand_format_string(n),
    kind(n, "parenthesized_expression"), child(n, c7, _).
