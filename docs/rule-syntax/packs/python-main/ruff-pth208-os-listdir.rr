// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl pth208_args_plain(l: node, a: node, i: number)
pth208_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl pth208_args_splat(l: node, i: number)
pth208_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl pth208_args_pos(l: node, a: node, j: number)
pth208_args_pos(l, a, j) :- pth208_args_plain(l, a, i), count : { pth208_args_splat(l, k), k < i } = 0,
    j = count : { pth208_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl pth208_args_star(l: node, j: number)
pth208_args_star(l, j) :- pth208_args_splat(l, i), count : { pth208_args_splat(l, k), k < i } = 0,
    j = count : { pth208_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl pth208_args_kwp(l: node, k: symbol, v: node)
pth208_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl pth208_args_lit_dict(s: node, d: node)
pth208_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !pth208_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl pth208_args_str_pair(p: node)
pth208_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl pth208_args_kw(l: node, k: symbol, v: node)
pth208_args_kw(l, k, v) :- pth208_args_kwp(l, k, v).
pth208_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), pth208_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl pth208_args_kw_spread(l: node)
pth208_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !pth208_args_lit_dict(s, _).

// arg_path_1: call n passes v for slot `path` of (path), syntactic: Ruff's find_argument
.decl pth208_arg_path_1(n: node, v: node)
pth208_arg_path_1(n, v) :- kind(n, "call"), field(n, "arguments", l), pth208_args_kwp(l, "path", v).
pth208_arg_path_1(n, v) :- kind(n, "call"), field(n, "arguments", l), pth208_args_pos(l, v, 0),
    !pth208_args_kwp(l, "path", _).
pth208_arg_path_1(n, v) :- kind(n, "call"), field(n, "arguments", v),
    kind(v, "generator_expression").

// arg_no_path_1: call n does not pass slot `path` of (path), syntactic: Ruff's find_argument
.decl pth208_arg_no_path_1(n: node)
pth208_arg_no_path_1(n) :- kind(n, "call"), field(n, "arguments", l), !pth208_args_kwp(l, "path", _),
    !pth208_args_pos(l, _, 0), !kind(l, "generator_expression").

// demand_alt_6: the rows of alt_6 its callers ask for (the metavariable columns they pass in)
.decl pth208_demand_alt_6(n: node, a: loc)
pth208_demand_alt_6(c4, A) :- kind(n, "attribute"), field(n, "attribute", c1),
    kind(c1, "identifier"), node(_, c1, _, _, _), A = c1, field(n, "object", c2), kind(c2, "identifier"),
    ref_site(c2, b3), kind(b3, "class_definition"), within_stop(c4, b3, pth208_stop_4).

// stop_4: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl pth208_stop_4(kind: symbol)
pth208_stop_4("function_definition"). pth208_stop_4("class_definition").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pth208_alt_1(n: node)
pth208_alt_1(n) :- child(n, c1, _), pth208_tok_precedes_8(c1), pth208_int_typed(c1).
pth208_alt_1(n) :- child(n, c9, _), pth208_tok_follows_9(c9), pth208_int_typed(c9).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pth208_alt_2(n: node)
pth208_alt_2(n) :- field(n, "left", c1), pth208_int_typed(c1).
pth208_alt_2(n) :- field(n, "right", c2), pth208_int_typed(c2).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pth208_alt_3(n: node)
pth208_alt_3(n) :- ref_site(n, b1), site_only(b1),
    count : { kind(b1, "assignment"), field(b1, "type", c2), kind(c2, "type") } = 0,
    binding_value(b1, x3), pth208_int_value(x3).
pth208_alt_3(n) :- ref_site(n, b4), site_only(b4), kind(b4, "as_pattern"), child(b4, c5, _),
    pth208_int_value(c5), child(b4, c6, _), kind(c6, "as_pattern_target"), child(c6, c7, _),
    kind(c7, "identifier").
pth208_alt_3(n) :- ref_site(n, b8), site_only(b8),
    count : { child(b8, c9, _), (kind(c9, "list_splat_pattern") ; kind(c9, "dictionary_splat_pattern")) } = 0,
    site_annotation(b8, o10), pth208_int_annotation(o10).
pth208_alt_3(n) :- ref_site(n, b11), site_only(b11), kind(b11, "function_definition"),
    field(b11, "return_type", c12), pth208_int_annotation(c12).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
//   A: metavariable of the calling rule, passed in (bound by the caller)
.decl pth208_alt_6(n: node, a: loc)
pth208_alt_6(n, A) :- pth208_demand_alt_6(n, A), kind(n, "assignment"), field(n, "left", c1),
    kind(c1, "identifier"), text(c1, t_a1), text(A, t_a1),
    ( field(n, "type", c2), pth208_int_annotation(c2)
    ; count : { field(n, "type", c3), kind(c3, "type") } = 0, field(n, "right", c4), pth208_int_value(c4)
    ), @doc(c1) = @doc(A).

pth208_alt_6(n, A) :- pth208_demand_alt_6(n, A), kind(n, "function_definition"),
    field(n, "name", c5), text(c5, t_a2), text(A, t_a2), field(n, "return_type", c6),
    pth208_int_annotation(c6), @doc(c5) = @doc(A).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
.decl pth208_alt_8(n: node)
pth208_alt_8(n) :- node(_, n, _, _, _), glob("[()]", n).
pth208_alt_8(n) :- kind(n, "comment").

// alt_9(n): the JSON `any`: n matches if any one of these rules does
.decl pth208_alt_9(n: node)
pth208_alt_9(n) :- node(_, n, _, _, _), glob("[(),]", n).
pth208_alt_9(n) :- kind(n, "comment").
