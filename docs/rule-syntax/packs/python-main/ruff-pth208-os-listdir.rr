.policy "ruff-pth208-os-listdir" revision 1
.guests off
.description "Use Path.iterdir() instead of os.listdir(); path objects read better than string-based os calls."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   F: metavariable this relation binds for the calling rule
.decl pth208_callee(n: node, f: loc)
pth208_callee(n, F) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "os.listdir"), node(_, n, _, _, _), F = n.
pth208_callee(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth208_callee(c1, F).

// int_ref(n): the JSON util `int-ref`, used where the JSON says `matches: "int-ref"`
.decl pth208_int_ref(n: node)
pth208_int_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "int"),
    sym_of(n, "builtins.int").
pth208_int_ref(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth208_int_ref(c1).

// int_annotation(n): the JSON util `int-annotation`, used where the JSON says `matches: "int-annotation"`
.decl pth208_int_annotation(n: node)
pth208_int_annotation(n) :- pth208_int_ref(n).
pth208_int_annotation(n) :- kind(n, "type"), child(n, c1, _), pth208_int_annotation(c1).
pth208_int_annotation(n) :- (kind(n, "subscript") ; kind(n, "generic_type")), child(n, c2, _),
    !pth208_tok_follows_1(c2), pth208_int_annotation(c2).

// int_call(n): the JSON util `int-call`, used where the JSON says `matches: "int-call"`
.decl pth208_int_call(n: node)
pth208_int_call(n) :- kind(n, "call"), field(n, "function", c1), pth208_int_ref(c1).

// bool_typed(n): the JSON util `bool-typed`, used where the JSON says `matches: "bool-typed"`
.decl pth208_bool_typed(n: node)
pth208_bool_typed(n) :- (kind(n, "true") ; kind(n, "false") ; kind(n, "not_operator")).
pth208_bool_typed(n) :- kind(n, "named_expression"), field(n, "value", c1), pth208_bool_typed(c1).
pth208_bool_typed(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), pth208_bool_typed(c2).
pth208_bool_typed(n) :- kind(n, "conditional_expression"), child(n, c3, _),
    pth208_tok_precedes_2(c3), pth208_bool_typed(c3), child(n, c11, _), pth208_tok_follows_3(c11),
    pth208_bool_typed(c11).
pth208_bool_typed(n) :- kind(n, "boolean_operator"), field(n, "left", c19), pth208_bool_typed(c19),
    field(n, "right", c20), pth208_bool_typed(c20).

// number(n): the JSON util `number`, used where the JSON says `matches: "number"`
.decl pth208_number(n: node)
pth208_number(n) :- pth208_int_typed(n).
pth208_number(n) :- pth208_bool_typed(n).

// int_typed(n): the JSON util `int-typed`, used where the JSON says `matches: "int-typed"`
.decl pth208_int_typed(n: node)
pth208_int_typed(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int").
pth208_int_typed(n) :- kind(n, "unary_operator"), field(n, "argument", c2), pth208_number(c2).
pth208_int_typed(n) :- kind(n, "binary_operator"),
    count : { field(n, "operator", c3), glob("[/@]", c3) } = 0, field(n, "left", c4),
    pth208_number(c4), field(n, "right", c5), pth208_number(c5).
pth208_int_typed(n) :- kind(n, "named_expression"), field(n, "value", c6), pth208_int_typed(c6).
pth208_int_typed(n) :- kind(n, "parenthesized_expression"), child(n, c7, _), pth208_int_typed(c7).
pth208_int_typed(n) :- kind(n, "conditional_expression"), child(n, c8, _), pth208_tok_precedes_4(c8),
    pth208_number(c8), child(n, c16, _), pth208_tok_follows_5(c16), pth208_number(c16), pth208_alt_1(n).
pth208_int_typed(n) :- kind(n, "boolean_operator"), field(n, "left", c40), pth208_number(c40),
    field(n, "right", c41), pth208_number(c41), pth208_alt_2(n).

// int_value(n): the JSON util `int-value`, used where the JSON says `matches: "int-value"`
.decl pth208_int_value(n: node)
pth208_int_value(n) :- pth208_int_call(n).
pth208_int_value(n) :- pth208_int_typed(n).
pth208_int_value(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth208_int_value(c1).

// int_name(n): the JSON util `int-name`, used where the JSON says `matches: "int-name"`
.decl pth208_int_name(n: node)
pth208_int_name(n) :- kind(n, "identifier"), pth208_alt_3(n).

// name_root(n): the JSON util `name-root`, used where the JSON says `matches: "name-root"`
.decl pth208_name_root(n: node)
pth208_name_root(n) :- pth208_int_name(n).
pth208_name_root(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth208_name_root(c1).
pth208_name_root(n) :- kind(n, "call"), field(n, "function", c2), pth208_name_root(c2).

// int_attribute(n): the JSON util `int-attribute`, used where the JSON says `matches: "int-attribute"`
.decl pth208_int_attribute(n: node)
pth208_int_attribute(n) :- kind(n, "attribute"), field(n, "attribute", c1),
    kind(c1, "identifier"), node(_, c1, _, _, _), A = c1, field(n, "object", c2), kind(c2, "identifier"),
    ref_site(c2, b3), kind(b3, "class_definition"), within_stop(c4, b3, pth208_stop_4),
    pth208_alt_6(c4, A).

// file_descriptor(n): the JSON util `file-descriptor`, used where the JSON says `matches: "file-descriptor"`
.decl pth208_file_descriptor(n: node)
pth208_file_descriptor(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int").
pth208_file_descriptor(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    pth208_file_descriptor(c2).
pth208_file_descriptor(n) :- pth208_name_root(n).
pth208_file_descriptor(n) :- pth208_int_attribute(n).

// PTH208(n): a finding at node n, from clause `os-listdir`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on S are added to every rule.
.violation PTH208(at: node, f: node, s: loc) "Use `Path({s}).iterdir()` instead of `os.listdir({s})`; it lazily yields `Path` objects, so take `.name` for plain names. Leave it for bytes paths and file descriptors."
    suppress noqa "PTH208"
PTH208(F, n, S) :- kind(n, "call"), field(n, "function", c1), pth208_callee(c1, F),
    pth208_arg_path_1(n, a2), S = a2, !pth208_file_descriptor(S).

// PTH208_os_listdir_cwd(n, detail): findings from clauses `os-listdir-cwd`, `os-listdir-unpacked`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PTH208_os_listdir_cwd(at: node, f: node, detail: symbol) code "PTH208" "Use {detail}."
    suppress noqa "PTH208"
PTH208_os_listdir_cwd(F, n, "`Path().iterdir()` instead of `os.listdir()`; it lazily yields `Path` objects, so take `.name` for plain names") :- kind(n, "call"),
    field(n, "function", c1), pth208_callee(c1, F), field(n, "arguments", c2),
    kind(c2, "argument_list"), count : { child(c2, c3, _), !pth208_alt_8(c3) } = 0.
PTH208_os_listdir_cwd(F, n, "`Path(path).iterdir()` instead of `os.listdir(...)` once the path argument is known; it lazily yields `Path` objects. Leave it for bytes paths and file descriptors") :- kind(n, "call"),
    field(n, "function", c1), pth208_callee(c1, F), pth208_arg_no_path_1(n),
    field(n, "arguments", c2), kind(c2, "argument_list"), child(c2, c3, _), !pth208_alt_9(c3).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth208_tok_follows_1(n: node)
.stored pth208_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth208_tok_follows_1(n) :- next_sibling(s3, n), match("(?s).*..*", s3).
pth208_tok_follows_1(n) :- structural_before(n, g5), match("\\s*", g5), child(p6, n, _),
    node(_, n, _, st8, _), o7 = st8 - strlen(g5), token(p6, _, t4, _, o7),
    match("(?s).*..*", t4).
pth208_tok_follows_1(n) :- structural_before(n, g5), match("(?s)^.*\\S\\s*$", g5).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth208_tok_precedes_2(n: node)
.stored pth208_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth208_tok_precedes_2(n) :- next_sibling(n, s4), glob("if", s4).
pth208_tok_precedes_2(n) :- structural_after(n, g6), match("\\s*", g6), child(p7, n, _),
    node(_, n, _, _, en10), o8 = en10 + strlen(g6), token(p7, _, t5, o8, _),
    match("if", t5).
pth208_tok_precedes_2(n) :- structural_after(n, g6),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g6).

// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth208_tok_follows_3(n: node)
.stored pth208_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth208_tok_follows_3(n) :- next_sibling(s12, n), glob("else", s12).
