.decl f632_alt_2(n: node)
f632_alt_2(n) :- f632_alt_2_u7(n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
//   C, O: metavariables this relation binds for the calling rule
.decl f632_alt_5(n: node, c: loc, o: loc)
f632_alt_5(n, C, O) :- kind(n, "comparison_operator"), child(n, c1, _), f632_is_literal_op(c1),
    O = c1, C = n.
f632_alt_5(n, C, O) :- f632_is_literal_in_string(n, C, O).

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl f632_alt_7(n: node)
f632_alt_7(n) :- f632_alt_7_u7(n).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
//   C, O: metavariables this relation binds for the calling rule
.decl f632_alt_10(n: node, c: loc, o: loc)
f632_alt_10(n, C, O) :- kind(n, "comparison_operator"), child(n, c1, _),
    f632_is_literal_op_is_literal_is_not(c1), O = c1, C = n.
f632_alt_10(n, C, O) :- f632_is_literal_in_string_is_literal_is_not(n, C, O).
