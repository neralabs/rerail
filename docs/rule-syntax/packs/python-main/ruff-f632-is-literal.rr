.policy "ruff-f632-is-literal" revision 2
.guests off
.description "Use == or != instead of is or is not to compare literal values; the identity of such values is unreliable."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// F632(n, detail): findings from clauses `is-literal-is`, `is-literal-is-not`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation F632(at: node, o: loc, c: node, detail: symbol) "Use {detail} to compare this literal value."
    suppress noqa "F632"
// O: not bound by this rule, so empty (unset) here, as in ast-grep.
F632(C, O, n, "`==` instead of `is`") :- f632_is_literal_op(n), child(p1, n, _),
    kind(p1, "comparison_operator"), node(_, p1, _, _, _), C = p1, unset(O).
F632(C, O, n, "`==` instead of `is`") :- f632_is_literal_in_string(n, C, O).
// O: not bound by this rule, so empty (unset) here, as in ast-grep.
F632(C, O, n, "`!=` instead of `is not`") :- f632_is_literal_op_is_literal_is_not(n),
    child(p1, n, _), kind(p1, "comparison_operator"), node(_, p1, _, _, _), C = p1, unset(O).
F632(C, O, n, "`!=` instead of `is not`") :- f632_is_literal_in_string_is_literal_is_not(n, C, O).

// constant(n): the JSON util `constant`, used where the JSON says `matches: "constant"`
.decl f632_constant(n: node)
f632_constant(n) :- f632_constant_u7(n).

// singleton(n): the JSON util `singleton`, used where the JSON says `matches: "singleton"`
.decl f632_singleton(n: node)
f632_singleton(n) :- (kind(n, "none") ; kind(n, "true") ; kind(n, "false") ; kind(n, "ellipsis")).
f632_singleton(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), f632_singleton(c1).

// constant_non_singleton(n): the JSON util `constant-non-singleton`, used where the JSON says `matches: "constant-non-singleton"`
.decl f632_constant_non_singleton(n: node)
f632_constant_non_singleton(n) :- f632_constant(n), !f632_singleton(n).

// literal_operand(n): the JSON util `literal-operand`, used where the JSON says `matches: "literal-operand"`
.decl f632_literal_operand(n: node)
f632_literal_operand(n) :- kind(n, k1), f632_set_3(k1).
f632_literal_operand(n) :- f632_constant_non_singleton(n).
f632_literal_operand(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    f632_literal_operand(c2).

// is_literal_op(n): the JSON util `is-literal-op`, used where the JSON says `matches: "is-literal-op"`
.decl f632_is_literal_op(n: node)
f632_is_literal_op(n) :- glob("is", n),
    ( next_sibling(s1, n), f632_literal_operand(s1)
    ; next_sibling(n, s2), f632_literal_operand(s2)
    ).


// is_literal_in_string(n): the JSON util `is-literal-in-string`, used where the JSON says `matches: "is-literal-in-string"`
//   C, O: metavariables this relation binds for the calling rule
.decl f632_is_literal_in_string(n: node, c: loc, o: loc)
f632_is_literal_in_string(n, C, O) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), f632_alt_5(c2, C, O).

// constant_is_literal_is_not(n): the JSON util `constant`, used where the JSON says `matches: "constant"`
.decl f632_constant_is_literal_is_not(n: node)
f632_constant_is_literal_is_not(n) :- f632_constant_is_literal_is_not_u7(n).

// singleton_is_literal_is_not(n): the JSON util `singleton`, used where the JSON says `matches: "singleton"`
.decl f632_singleton_is_literal_is_not(n: node)
f632_singleton_is_literal_is_not(n) :- (kind(n, "none") ; kind(n, "true") ; kind(n, "false") ; kind(n, "ellipsis")).
f632_singleton_is_literal_is_not(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    f632_singleton_is_literal_is_not(c1).

// constant_non_singleton_is_literal_is_not(n): the JSON util `constant-non-singleton`, used where the JSON says `matches: "constant-non-singleton"`
.decl f632_constant_non_singleton_is_literal_is_not(n: node)
f632_constant_non_singleton_is_literal_is_not(n) :- f632_constant_is_literal_is_not(n),
    !f632_singleton_is_literal_is_not(n).

// literal_operand_is_literal_is_not(n): the JSON util `literal-operand`, used where the JSON says `matches: "literal-operand"`
.decl f632_literal_operand_is_literal_is_not(n: node)
f632_literal_operand_is_literal_is_not(n) :- kind(n, k1), f632_set_3(k1).
f632_literal_operand_is_literal_is_not(n) :- f632_constant_non_singleton_is_literal_is_not(n).
f632_literal_operand_is_literal_is_not(n) :- kind(n, "parenthesized_expression"),
    child(n, c2, _), f632_literal_operand_is_literal_is_not(c2).

// is_literal_op_is_literal_is_not(n): the JSON util `is-literal-op`, used where the JSON says `matches: "is-literal-op"`
.decl f632_is_literal_op_is_literal_is_not(n: node)
f632_is_literal_op_is_literal_is_not(n) :- match("is[\\s\\\\]+not", n),
    ( next_sibling(s1, n), f632_literal_operand_is_literal_is_not(s1)
    ; next_sibling(n, s2), f632_literal_operand_is_literal_is_not(s2)
    ).


