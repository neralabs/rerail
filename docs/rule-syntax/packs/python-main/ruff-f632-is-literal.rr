// set_1: node kinds from a JSON `any`
.decl f632_set_1(v: symbol)
f632_set_1("integer"). f632_set_1("float"). f632_set_1("none"). f632_set_1("true"). f632_set_1("false").
f632_set_1("ellipsis").

// set_3: node kinds from a JSON `any`
.decl f632_set_3(v: symbol)
