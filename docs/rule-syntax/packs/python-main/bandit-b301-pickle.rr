.policy "bandit-b301-pickle" revision 1
.guests off
.description "Avoid deserializing with pickle, dill, shelve, jsonpickle, or pandas.read_pickle; loading untrusted data this way can execute arbitrary code."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B301(n): a finding at node n, from clause `unsafe-deserialization`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on F are added to every rule.
.violation B301(at: node) "Load this data with json or another data-only format instead; unpickling untrusted input can run arbitrary code."
    suppress nosec "B301"
B301(n) :- n ~ `$F($$$ARGS)`, sym_of(F, q1), b301_set_1(q1).

// set_1: symbols from the JSON `resolves.import`
.decl b301_set_1(v: symbol)
b301_set_1("pickle.loads"). b301_set_1("pickle.load"). b301_set_1("pickle.Unpickler").
b301_set_1("dill.loads"). b301_set_1("dill.load"). b301_set_1("dill.Unpickler"). b301_set_1("shelve.open").
b301_set_1("shelve.DbfilenameShelf"). b301_set_1("jsonpickle.decode").
b301_set_1("jsonpickle.unpickler.decode"). b301_set_1("jsonpickle.unpickler.Unpickler").
b301_set_1("pandas.read_pickle").
