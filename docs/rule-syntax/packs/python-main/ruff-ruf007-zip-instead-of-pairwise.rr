.policy "ruff-ruf007-zip-instead-of-pairwise" revision 1
.guests off
.description "Use itertools.pairwise to iterate over successive pairs instead of zipping a sequence with a copy of itself shifted by one; it is clearer and avoids slicing."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// RUF007(n): a finding at node n, from clause `zip-instead-of-pairwise`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `transform` computes A1, A2, B2, C1, C2, D1, S1, S2, S3, S4, S5, S6, S7, S8, S9, V1, V2 from other metavariables' text; its literals end each rule.
// `options` carries JSON settings that have no .rr form yet.
.violation RUF007(at: node, id1: loc) "Replace this `zip` with `itertools.pairwise({id1})`, or pairwise over the common slice when both arguments are slices; keep `zip` if the upper bounds differ or `{id1}` is not a plain sequence."
    suppress noqa "RUF007"
RUF007(n, ID1) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "zip"),
    sym_of(n, "builtins.zip"), within_stop(n, p3, ruf007_stop_2), field(_, "function", n),
    kind(p3, "call"), field(p3, "arguments", c4), kind(c4, "argument_list"),
    count : { child(c4, c5, _), kind(c5, "list_splat") } = 0, child(c4, c6, _),
    child(p7, c6, _), ruf007_counted(c6),
    k9 = count : { child(p7, s8, _), precedes(s8, c6), ruf007_counted(s8) }, k9 = 0,
    ruf007_first_arg(c6, ID1, L1), child(c4, c10, _), child(p11, c10, _), ruf007_counted(c10),
    k13 = count : { child(p11, s12, _), precedes(s12, c10), ruf007_counted(s12) }, k13 = 1,
    ruf007_second_arg(c10, ID2, L2),
    count : { child(c4, c14, _), child(p15, c14, _), ruf007_counted(c14), k17 = count : { child(p15, s16, _), precedes(s16, c14), ruf007_counted(s16) }, k17 = 2, !kind(c14, "keyword_argument"), !kind(c14, "dictionary_splat") } = 0,
    text(ID1, t18), text(ID2, t18), A2 = B2, D1 = C2,
    ( unset(L1), V1 = "0"
    ; !unset(L1), value(L1, t1), V1 = @replace_all(t1, "^(.*)$", "$1")
    ),
    value(L2, t2), V2 = @replace_all(t2, "^(.*)$", "$1"),
    A1 = @replace_all(V1, "^(.*?)9*$", "0$1"),
    S1 = @replace_all(A1, "^([0-9]*)8$", "${1}9"),
    S2 = @replace_all(S1, "^([0-9]*)7$", "${1}8"),
    S3 = @replace_all(S2, "^([0-9]*)6$", "${1}7"),
    S4 = @replace_all(S3, "^([0-9]*)5$", "${1}6"),
    S5 = @replace_all(S4, "^([0-9]*)4$", "${1}5"),
    S6 = @replace_all(S5, "^([0-9]*)3$", "${1}4"),
    S7 = @replace_all(S6, "^([0-9]*)2$", "${1}3"),
    S8 = @replace_all(S7, "^([0-9]*)1$", "${1}2"),
    S9 = @replace_all(S8, "^([0-9]*)0$", "${1}1"),
    A2 = @replace_all(S9, "^0(.)", "$1"), B2 = @replace_all(V2, "^(.*?)0*$", "$1"),
    C1 = @replace_all(V1, "^.*?(9*)$", "$1"), D1 = @replace_all(C1, "9", "0"),
    C2 = @replace_all(V2, "^.*?(0*)$", "$1"), @doc(ID1) = @doc(ID2).

// name1(n): the JSON util `name1`, used where the JSON says `matches: "name1"`
//   ID1: metavariable this relation binds for the calling rule
.decl ruf007_name1(n: node, id1: loc)
ruf007_name1(n, ID1) :- kind(n, "identifier"), node(_, n, _, _, _), ID1 = n.
ruf007_name1(n, ID1) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf007_name1(c1, ID1).

// name2(n): the JSON util `name2`, used where the JSON says `matches: "name2"`
//   ID2: metavariable this relation binds for the calling rule
.decl ruf007_name2(n: node, id2: loc)
ruf007_name2(n, ID2) :- kind(n, "identifier"), node(_, n, _, _, _), ID2 = n.
ruf007_name2(n, ID2) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf007_name2(c1, ID2).

// int1(n): the JSON util `int1`, used where the JSON says `matches: "int1"`
//   L1: metavariable this relation binds for the calling rule
.decl ruf007_int1(n: node, l1: loc)
ruf007_int1(n, L1) :- kind(n, "integer"), node(_, n, _, _, _), L1 = n.
ruf007_int1(n, L1) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf007_int1(c1, L1).

// int2(n): the JSON util `int2`, used where the JSON says `matches: "int2"`
//   L2: metavariable this relation binds for the calling rule
.decl ruf007_int2(n: node, l2: loc)
ruf007_int2(n, L2) :- kind(n, "integer"), node(_, n, _, _, _), L2 = n, value(n, v1),
    (value_type(v1, "int") ; value_type(v1, "float")), to_number(v1) <= 2147483647.
ruf007_int2(n, L2) :- kind(n, "parenthesized_expression"), child(n, c2, _), ruf007_int2(c2, L2).

// one(n): the JSON util `one`, used where the JSON says `matches: "one"`
.decl ruf007_one(n: node)
ruf007_one(n) :- kind(n, "integer"), value(n, "1").
ruf007_one(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), ruf007_one(c1).

// lower_node(n): the JSON util `lower-node`, used where the JSON says `matches: "lower-node"`
.decl ruf007_lower_node(n: node)
ruf007_lower_node(n) :- ruf007_code(n), !glob(":", n), !ruf007_tok_follows_1(n).

// step_node(n): the JSON util `step-node`, used where the JSON says `matches: "step-node"`
.decl ruf007_step_node(n: node)
ruf007_step_node(n) :- ruf007_code(n), !glob(":", n), precedes(s1, n), glob(":", s1),
    ruf007_tok_follows_2(s1).

// step_ok(n): the JSON util `step-ok`, used where the JSON says `matches: "step-ok"`
.decl ruf007_step_ok(n: node)
ruf007_step_ok(n) :- node(_, n, _, _, _),
    count : { child(n, c1, _), ruf007_step_node(c1), !ruf007_one(c1) } = 0.

// sliced(n): the JSON util `sliced`, used where the JSON says `matches: "sliced"`
.decl ruf007_sliced(n: node)
ruf007_sliced(n) :- kind(n, "subscript"), !ruf007_tok_has_3(n).

// first_arg(n): the JSON util `first-arg`, used where the JSON says `matches: "first-arg"`
//   ID1, L1: metavariables this relation binds for the calling rule
.decl ruf007_first_arg(n: node, id1: loc, l1: loc)
// L1: not bound by this rule, so empty (unset) here, as in ast-grep.
ruf007_first_arg(n, ID1, L1) :- ruf007_name1(n, ID1), unset(L1).
// L1: not bound by every branch, so empty (unset) where not bound, as in ast-grep.
ruf007_first_arg(n, ID1, L1) :- ruf007_sliced(n), field(n, "value", c1), ruf007_name1(c1, ID1),
    field(n, "subscript", c2), kind(c2, "slice"), ruf007_step_ok(c2),
    ( count : { child(c2, c3, _), ruf007_lower_node(c3) } = 0, unset(L1)
    ; child(c2, c4, _), ruf007_lower_node(c4), ruf007_int1(c4, L1)
    ).

ruf007_first_arg(n, ID1, L1) :- kind(n, "parenthesized_expression"), child(n, c5, _),
    ruf007_first_arg(c5, ID1, L1).

// second_arg(n): the JSON util `second-arg`, used where the JSON says `matches: "second-arg"`
//   ID2, L2: metavariables this relation binds for the calling rule
.decl ruf007_second_arg(n: node, id2: loc, l2: loc)
ruf007_second_arg(n, ID2, L2) :- ruf007_sliced(n), field(n, "value", c1), ruf007_name2(c1, ID2),
    field(n, "subscript", c2), kind(c2, "slice"), ruf007_step_ok(c2), child(c2, c3, _),
    ruf007_lower_node(c3), ruf007_int2(c3, L2).
ruf007_second_arg(n, ID2, L2) :- kind(n, "parenthesized_expression"), child(n, c4, _),
    ruf007_second_arg(c4, ID2, L2).

// ruf007_code(n): the JSON util `code`, used where the JSON says `matches: "code"`
.decl ruf007_code(n: node)
ruf007_code(n) :- node(_, n, _, _, _), !kind(n, "comment"), !kind(n, "line_continuation").

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^:$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf007_tok_follows_1(n: node)
.stored ruf007_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf007_tok_follows_1(n) :- precedes(s1, n), glob(":", s1).
ruf007_tok_follows_1(n) :- child(p4, n, _), node(_, n, _, st6, _), token(p4, _, t2, _, en7),
    en7 <= st6, match(":", t2).
ruf007_tok_follows_1(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
ruf007_tok_follows_1(n) :- precedes(o5, n), structural_before(o5, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^:$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf007_tok_follows_2(n: node)
.stored ruf007_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf007_tok_follows_2(n) :- precedes(s2, n), glob(":", s2).
ruf007_tok_follows_2(n) :- child(p5, n, _), node(_, n, _, st7, _), token(p5, _, t3, _, en8),
    en8 <= st7, match(":", t3).
ruf007_tok_follows_2(n) :- structural_before(n, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).
ruf007_tok_follows_2(n) :- precedes(o6, n), structural_before(o6, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).

// tok_has_3(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf007_tok_has_3(n: node)
.stored ruf007_tok_has_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf007_tok_has_3(n) :- child(n, c1, _), glob("\\,", c1).
ruf007_tok_has_3(n) :- op(n, t2), match(",", t2).
ruf007_tok_has_3(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
ruf007_tok_has_3(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
ruf007_tok_has_3(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// stop_2(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf007_stop_2(n: node)
ruf007_stop_2(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// counted(n): 3 identical copies of one rule set (`counted_3`, `counted_4`, `counted_5`), folded into one.
.decl ruf007_counted(n: node)
ruf007_counted(n) :- ruf007_code(n).
