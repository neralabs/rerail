.decl b007_tok_follows_2(n: node)
.stored b007_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b007_tok_follows_2(n) :- next_sibling(s1, n), glob(".", s1).
b007_tok_follows_2(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("\\.", t2).
b007_tok_follows_2(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)\\s*)$", g3).

