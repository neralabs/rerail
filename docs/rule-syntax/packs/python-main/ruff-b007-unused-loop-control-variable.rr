// demand_uncertain: the nodes uncertain is asked at (it looks at every ancestor of every node)
.decl b007_demand_uncertain(n: node)
b007_demand_uncertain(n) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n, b007_in_target(n).

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl b007_up_1(n: node, p: node)
b007_up_1(n, p) :- b007_demand_uncertain(n), within_stop(n, p, "for_statement"),
    kind(p, "for_statement").

// set_1: node kinds from a JSON `any`
.decl b007_set_1(v: symbol)
b007_set_1("pattern_list"). b007_set_1("tuple_pattern"). b007_set_1("list_pattern").
b007_set_1("list_splat_pattern"). b007_set_1("parenthesized_expression").

// set_2: node kinds from a JSON `any`
.decl b007_set_2(v: symbol)
b007_set_2("import_statement"). b007_set_2("import_from_statement").
b007_set_2("future_import_statement"). b007_set_2("global_statement").
b007_set_2("nonlocal_statement").
