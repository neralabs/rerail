{
  "format": "rerail.policy/v1",
  "id": "ruff-f504-percent-format-extra-named-arguments",
  "revision": 1,
  "mode": "steer",
  "description": "Remove dict keys that no %(key) placeholder in the %-format string uses; an unused key usually means a typo or a stale argument.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "percent-format-extra-named-arguments",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$S % $R",
            "formatArgs": {
              "style": "percent",
              "string": "S",
              "args": "R",
              "unused": {
                "kind": "pair"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F504",
        "message": "`%`-format string has unused named argument(s)",
        "suppress": {
          "noqa": {
            "codes": [
              "F504"
            ]
          }
        }
      }
    }
  ]
}
