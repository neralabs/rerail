{
  "format": "rerail.policy/v1",
  "id": "ruff-b904-raise-without-from-inside-except",
  "revision": 1,
  "mode": "steer",
  "description": "Use raise ... from err (or from None) when raising a new exception inside an except block; it keeps the cause chain clear instead of looking like a bug in the handler.",
  "scope": {
    "include": [
      "**/*.py",
      "**/*.pyi"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "raise-without-from-inside-except",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "in-handler": {
              "inside": {
                "stopBy": "neighbor",
                "kind": "block",
                "any": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "except_clause"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "if_statement"
                        },
                        {
                          "kind": "with_statement"
                        },
                        {
                          "kind": "for_statement"
                        },
                        {
                          "kind": "while_statement"
                        }
                      ],
                      "matches": "in-handler"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "elif_clause"
                        },
                        {
                          "kind": "else_clause"
                        }
                      ],
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "if_statement",
                        "matches": "in-handler"
                      }
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "case_clause",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "block",
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "match_statement",
                          "matches": "in-handler"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "handler-name": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$X"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "handler-name"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "raise_statement",
            "matches": "in-handler",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "regex": "^raise$"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^from$"
                  }
                }
              },
              {
                "not": {
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "^raise$"
                        },
                        "matches": "handler-name"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": {
                          "kind": "except_clause"
                        },
                        "kind": "except_clause",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "as_pattern",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "as_pattern_target",
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "identifier",
                              "pattern": "$X"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B904",
        "message": "Raise this exception with `from err` or `from None` so the cause chain is clear.",
        "suppress": {
          "noqa": {
            "codes": [
              "B904"
            ]
          }
        }
      }
    }
  ]
}
