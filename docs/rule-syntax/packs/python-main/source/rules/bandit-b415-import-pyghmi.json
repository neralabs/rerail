{
  "format": "rerail.policy/v1",
  "id": "bandit-b415-import-pyghmi",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid importing pyghmi; IPMI is an insecure protocol, so prefer an encrypted management protocol.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B415",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import pyghmi"
              },
              {
                "pattern": "import pyghmi as $ALIAS"
              },
              {
                "pattern": "from pyghmi import $$$NAMES"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B415",
        "anchor": "witness.span",
        "message": "Replace this pyghmi import with a client for an encrypted management protocol such as Redfish over HTTPS; IPMI is insecure.",
        "suppress": {
          "nosec": {
            "codes": [
              "B415"
            ]
          }
        }
      }
    }
  ]
}
