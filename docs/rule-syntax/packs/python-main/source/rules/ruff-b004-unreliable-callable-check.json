{
  "format": "rerail.policy/v1",
  "id": "ruff-b004-unreliable-callable-check",
  "revision": 1,
  "mode": "steer",
  "description": "Use callable() instead of checking hasattr() or getattr() for __call__; the attribute check gives wrong answers for some objects.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unreliable-callable-check",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "call-string": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "string",
                      "regex": "^[rRuU]{0,2}['\"]"
                    },
                    {
                      "kind": "concatenated_string",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "string",
                          "not": {
                            "regex": "^[rRuU]{0,2}['\"]"
                          }
                        }
                      }
                    }
                  ],
                  "value": {
                    "eq": "__call__"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "call-string"
                  }
                }
              ]
            },
            "positional": {
              "not": {
                "any": [
                  {
                    "kind": "keyword_argument"
                  },
                  {
                    "kind": "dictionary_splat"
                  }
                ]
              }
            },
            "builtin-callee": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "hasattr",
                      "getattr"
                    ],
                    "import": [
                      "builtins.hasattr",
                      "builtins.getattr"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "builtin-callee"
                  }
                }
              ]
            },
            "getattr-callee": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "getattr"
                    ],
                    "import": [
                      "builtins.getattr"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "getattr-callee"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "any": [
              {
                "pattern": "$FUNC($OBJ, $ATTR)"
              },
              {
                "pattern": "$GETATTR($OBJ, $ATTR, $DEFAULT)"
              }
            ]
          },
          "constraints": {
            "FUNC": {
              "matches": "builtin-callee"
            },
            "GETATTR": {
              "matches": "getattr-callee"
            },
            "OBJ": {
              "matches": "positional"
            },
            "ATTR": {
              "matches": "call-string"
            },
            "DEFAULT": {
              "matches": "positional"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B004",
        "message": "Using `hasattr(x, \"__call__\")` to test if x is callable is unreliable. Use `callable(x)` for consistent results.",
        "suppress": {
          "noqa": {
            "codes": [
              "B004"
            ]
          }
        }
      }
    }
  ]
}
