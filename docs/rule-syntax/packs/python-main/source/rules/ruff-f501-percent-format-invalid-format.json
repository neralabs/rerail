{
  "format": "rerail.policy/v1",
  "id": "ruff-f501-percent-format-invalid-format",
  "revision": 1,
  "mode": "steer",
  "description": "Fix malformed %-format strings, such as incomplete specifiers or unclosed %(key) names; they raise an error at run time.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "percent-format-invalid-format",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "plain-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                    }
                  }
                }
              ]
            },
            "format-string": {
              "any": [
                {
                  "matches": "plain-string",
                  "parse": {
                    "grammar": "percentFormat",
                    "has": {
                      "kind": "error",
                      "not": {
                        "value": {
                          "regex": "^unsupported format character"
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "format-string"
                  }
                }
              ]
            }
          },
          "rule": {
            "pattern": "$S % $R"
          },
          "constraints": {
            "S": {
              "matches": "format-string"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F501",
        "message": "Fix this malformed %-format string, such as an incomplete specifier or an unclosed %(key) name.",
        "suppress": {
          "noqa": {
            "codes": [
              "F501"
            ]
          }
        }
      }
    }
  ]
}
