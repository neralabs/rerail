{
  "format": "rerail.policy/v1",
  "id": "ruff-f506-percent-format-mixed-positional-and-named",
  "revision": 1,
  "mode": "steer",
  "description": "Don't mix %(key) placeholders and positional placeholders in one %-format string; Python cannot format it.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "percent-format-mixed-positional-and-named",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "plain-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                    }
                  }
                }
              ]
            },
            "format-string": {
              "any": [
                {
                  "matches": "plain-string",
                  "parse": {
                    "grammar": "percentFormat",
                    "not": {
                      "has": {
                        "kind": "error"
                      }
                    },
                    "all": [
                      {
                        "has": {
                          "kind": "placeholder",
                          "stopBy": "end",
                          "has": {
                            "kind": "mapping_key"
                          }
                        }
                      },
                      {
                        "has": {
                          "stopBy": "end",
                          "any": [
                            {
                              "kind": "placeholder",
                              "not": {
                                "has": {
                                  "kind": "mapping_key"
                                }
                              }
                            },
                            {
                              "kind": "star"
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "format-string"
                  }
                }
              ]
            }
          },
          "rule": {
            "pattern": "$S % $R"
          },
          "constraints": {
            "S": {
              "matches": "format-string"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F506",
        "message": "Use only %(key) placeholders or only positional ones in this format string; Python cannot format a mix.",
        "suppress": {
          "noqa": {
            "codes": [
              "F506"
            ]
          }
        }
      }
    }
  ]
}
