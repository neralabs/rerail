{
  "format": "rerail.policy/v1",
  "id": "ruff-b028-no-explicit-stacklevel",
  "revision": 1,
  "mode": "steer",
  "description": "Pass an explicit stacklevel to warnings.warn(); without it the warning points at the warn call instead of the caller who triggered it.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "no-explicit-stacklevel",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "warnings-warn": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "warnings.warn"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "warnings-warn"
                  }
                }
              ]
            },
            "warn-args": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "call"
                  },
                  "precedes": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "argument_list",
                        "not": {
                          "any": [
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "kind": "keyword_argument",
                                "all": [
                                  {
                                    "has": {
                                      "stopBy": "neighbor",
                                      "kind": "identifier",
                                      "regex": "^(skip_file_prefixes)$",
                                      "precedes": {
                                        "stopBy": "neighbor",
                                        "regex": "^=$"
                                      }
                                    }
                                  },
                                  {
                                    "has": {
                                      "stopBy": "neighbor",
                                      "follows": {
                                        "stopBy": "neighbor",
                                        "regex": "^=$"
                                      },
                                      "not": {
                                        "kind": "tuple",
                                        "regex": "^\\(\\s*\\)$"
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "any": [
                                  {
                                    "kind": "list_splat"
                                  },
                                  {
                                    "kind": "dictionary_splat"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      {
                        "kind": "generator_expression"
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "warn-args"
                  }
                }
              ]
            }
          },
          "rule": {
            "any": [
              {
                "kind": "attribute"
              },
              {
                "kind": "identifier"
              }
            ],
            "all": [
              {
                "matches": "warnings-warn"
              },
              {
                "matches": "warn-args"
              },
              {
                "inside": {
                  "stopBy": {
                    "kind": "call"
                  },
                  "kind": "call",
                  "arguments": {
                    "signature": [
                      "message",
                      "category",
                      "stacklevel"
                    ],
                    "absent": [
                      "stacklevel"
                    ],
                    "mode": "syntactic"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B028",
        "message": "Pass stacklevel= to this warnings.warn() call, usually 2, so the warning points at the caller.",
        "suppress": {
          "noqa": {
            "codes": [
              "B028"
            ]
          }
        }
      }
    }
  ]
}
