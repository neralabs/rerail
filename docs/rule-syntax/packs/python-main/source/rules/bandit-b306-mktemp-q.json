{
  "format": "rerail.policy/v1",
  "id": "bandit-b306-mktemp-q",
  "revision": 1,
  "mode": "steer",
  "description": "Use tempfile.mkstemp() or NamedTemporaryFile instead of tempfile.mktemp(); mktemp returns a name another process can claim before you create the file.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B306",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "any": [
                {
                  "resolves": {
                    "import": [
                      "tempfile.mktemp"
                    ]
                  }
                },
                {
                  "pattern": "tempfile.mktemp"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "code": "B306",
        "anchor": "witness.span",
        "message": "Replace tempfile.mktemp with mkstemp or NamedTemporaryFile, which create the file atomically.",
        "suppress": {
          "nosec": {
            "codes": [
              "B306"
            ]
          }
        }
      }
    }
  ]
}
