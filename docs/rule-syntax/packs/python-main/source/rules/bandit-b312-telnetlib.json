{
  "format": "rerail.policy/v1",
  "id": "bandit-b312-telnetlib",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid opening telnetlib.Telnet connections; Telnet sends credentials and data unencrypted, so use SSH or another encrypted protocol.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B312",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "telnetlib.Telnet"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B312",
        "anchor": "witness.span",
        "message": "Telnet is insecure; use SSH or another encrypted protocol.",
        "suppress": {
          "nosec": {
            "codes": [
              "B312"
            ]
          }
        }
      }
    }
  ]
}
