{
 "format": "rerail.policy/v1",
 "id": "ruff-async116-long-sleep-not-forever",
 "revision": 1,
 "mode": "steer",
 "description": "Use sleep_forever() instead of trio or anyio sleep calls longer than 24 hours; a sleep that long is almost always meant to never end.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "shared",
   "define": {
    "language": "python",
    "utils": {
     "number": {
      "any": [
       {
        "any": [
         {
          "kind": "integer"
         },
         {
          "kind": "float"
         }
        ],
        "value": {
         "type": [
          "int",
          "float"
         ],
         "gt": 86400
        }
       },
       {
        "kind": "parenthesized_expression",
        "has": {
         "stopBy": "neighbor",
         "matches": "number"
        }
       }
      ]
     }
    }
   }
  },
  {
   "id": "trio-sleep",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "target": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "import": [
         "trio.sleep"
        ]
       }
      },
      "callee-of-target": {
       "any": [
        {
         "matches": "target"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "callee-of-target"
         }
        }
       ]
      }
     },
     "rule": {
      "kind": "call",
      "has": {
       "stopBy": "neighbor",
       "matches": "callee-of-target",
       "precedes": {
        "stopBy": "neighbor",
        "any": [
         {
          "kind": "argument_list"
         },
         {
          "kind": "generator_expression"
         }
        ]
       }
      },
      "arguments": {
       "signature": [
        "seconds"
       ],
       "bind": {
        "S": "seconds"
       },
       "mode": "syntactic"
      },
      "all": [
       {
        "has": {
         "stopBy": "neighbor",
         "kind": "argument_list",
         "count": {
          "has": {
           "stopBy": "neighbor",
           "not": {
            "any": [
             {
              "regex": "^[(),\\[\\]{}]$"
             },
             {
              "kind": "comment"
             }
            ]
           }
          },
          "min": 1,
          "max": 1
         }
        }
       }
      ]
     },
     "constraints": {
      "S": {
       "matches": "number"
      }
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC116",
    "message": "`trio.sleep()` with >24 hour interval should usually be `trio.sleep_forever()`",
    "suppress": {
      "noqa": {
        "codes": [
          "ASYNC116"
        ]
      }
    }
   }
  },
  {
   "id": "anyio-sleep",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "target": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "import": [
         "anyio.sleep"
        ]
       }
      },
      "callee-of-target": {
       "any": [
        {
         "matches": "target"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "callee-of-target"
         }
        }
       ]
      }
     },
     "rule": {
      "kind": "call",
      "has": {
       "stopBy": "neighbor",
       "matches": "callee-of-target",
       "precedes": {
        "stopBy": "neighbor",
        "any": [
         {
          "kind": "argument_list"
         },
         {
          "kind": "generator_expression"
         }
        ]
       }
      },
      "arguments": {
       "signature": [
        "delay"
       ],
       "bind": {
        "S": "delay"
       },
       "mode": "syntactic"
      },
      "all": [
       {
        "has": {
         "stopBy": "neighbor",
         "kind": "argument_list",
         "count": {
          "has": {
           "stopBy": "neighbor",
           "not": {
            "any": [
             {
              "regex": "^[(),\\[\\]{}]$"
             },
             {
              "kind": "comment"
             }
            ]
           }
          },
          "min": 1,
          "max": 1
         }
        }
       }
      ]
     },
     "constraints": {
      "S": {
       "matches": "number"
      }
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC116",
    "message": "`anyio.sleep()` with >24 hour interval should usually be `anyio.sleep_forever()`",
    "suppress": {
      "noqa": {
        "codes": [
          "ASYNC116"
        ]
      }
    }
   }
  }
 ]
}
