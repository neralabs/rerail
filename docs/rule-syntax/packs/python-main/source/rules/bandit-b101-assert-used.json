{
  "format": "rerail.policy/v1",
  "id": "bandit-b101-assert-used",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid assert statements in Python code outside tests; they are stripped when Python runs with optimization, so any check they perform silently disappears.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "**/tests/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/conftest.py"
    ]
  },
  "clauses": [
    {
      "id": "assert-used",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "assert_statement"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B101",
        "message": "Replace this assert with an if check that raises an exception; asserts are stripped when Python runs with -O.",
        "suppress": {
          "nosec": {
            "codes": [
              "B101"
            ]
          }
        }
      }
    }
  ]
}
