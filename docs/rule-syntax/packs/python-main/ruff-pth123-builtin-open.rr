// tok_precedes_9(n): a later sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pth123_tok_precedes_9(n: node)
.stored pth123_tok_precedes_9 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pth123_tok_precedes_9(n) :- next_sibling(n, s5), glob("=", s5).
pth123_tok_precedes_9(n) :- structural_after(n, g7), match("\\s*", g7), child(p8, n, _),
    node(_, n, _, _, en11), o9 = en11 + strlen(g7), token(p8, _, t6, o9, _),
    match("=", t6).
pth123_tok_precedes_9(n) :- structural_after(n, g7),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g7).

