// demand_alt_5: the rows of alt_5 its callers ask for (the metavariable columns they pass in)
.decl pth123_demand_alt_5(n: node, a: loc)
pth123_demand_alt_5(c2, A) :- kind(n, "attribute"), field(n, "attribute", c1),
    kind(c1, "identifier"), node(_, c1, _, _, _), A = c1, field(n, "object", c2).

// demand_class_holding_int: the rows of class_holding_int its callers ask for (the metavariable columns they pass in)
.decl pth123_demand_class_holding_int(n: node, a: loc)
pth123_demand_class_holding_int(st2, A) :- pth123_demand_alt_5(n, A), kind(n, "identifier"),
    ref_site(n, b1), (st2 = b1 ; within(b1, st2)).
pth123_demand_class_holding_int(c8, A) :- pth123_demand_alt_5(n, A), kind(n, "attribute"),
    field(n, "attribute", c3), kind(c3, "identifier"), node(_, c3, _, _, _), B = c3,
    field(n, "object", c4), kind(c4, "identifier"), ref_site(c4, b5),
    (st6 = b5 ; within(b5, st6)), kind(st6, "class_definition"),
    field(st6, "body", c7), within_stop(c8, c7, "class_definition"),
    field(c8, "name", c9), node(_, c9, _, _, _), B = c9, site_scope(c9, "class"), site_latest(c9).

// demand_int_class_member: the rows of int_class_member its callers ask for (the metavariable columns they pass in)
.decl pth123_demand_int_class_member(n: node, a: loc)
pth123_demand_int_class_member(c2, A) :- pth123_demand_class_holding_int(n, A),
    kind(n, "class_definition"), field(n, "body", c1),
    within_stop(c2, c1, "class_definition").

// none_literal_family_case: one row per relation folded into none_literal_family: its key, then the strings that differed.
.decl pth123_none_literal_family_case(key: symbol, s1: symbol)
pth123_none_literal_family_case("none_literal", "none").
pth123_none_literal_family_case("none_literal_builtin_open_in_string_annotation", "none").
pth123_none_literal_family_case("true_literal", "true").
pth123_none_literal_family_case("true_literal_builtin_open_in_string_annotation", "true").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pth123_alt_1(n: node)
pth123_alt_1(n) :- child(n, c1, _), pth123_int_type(c1), pth123_tok_precedes_7(c1).
pth123_alt_1(n) :- child(n, c9, _), pth123_int_type(c9), pth123_tok_follows_8(c9).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pth123_alt_2(n: node)
pth123_alt_2(n) :- field(n, "left", c1), pth123_int_type(c1).
pth123_alt_2(n) :- field(n, "right", c2), pth123_int_type(c2).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pth123_alt_3(n: node)
pth123_alt_3(n) :- ref_site(n, b1), site_only(b1),
    (site_form(b1, "assignment") ; site_form(b1, "named")), binding_value(b1, x2),
    pth123_int_value(x2).
pth123_alt_3(n) :- ref_site(n, b3), site_only(b3), (st4 = b3 ; within(b3, st4)),
    kind(st4, "as_pattern"), child(st4, c5, _), pth123_int_value(c5), child(st4, c6, _),
    kind(c6, "as_pattern_target"), child(c6, c7, _), kind(c7, "identifier").
pth123_alt_3(n) :- ref_site(n, b8), site_only(b8),
    ( site_form(b8, "annotated")
    ; site_form(b8, "annotation")
    ; site_form(b8, "parameter")
    ),
    (st9 = b8 ; within(b8, st9)),
    count : { child(st9, c10, _), (kind(c10, "list_splat_pattern") ; kind(c10, "dictionary_splat_pattern")) } = 0,
    site_annotation(b8, o11), pth123_int_annotation(o11).
pth123_alt_3(n) :- ref_site(n, b12), site_only(b12), (st13 = b12 ; within(b12, st13)),
    kind(st13, "function_definition"), field(st13, "return_type", c14),
    pth123_int_annotation(c14).
pth123_alt_3(n) :- node(_, n, _, _, _), PW = n, ref_site(n, b15), site_only(b15),
    (st16 = b15 ; within(b15, st16)), kind(st16, "assignment"),
    field(st16, "left", c17),
    ( kind(c17, "list_pattern")
    ; kind(c17, "tuple_pattern")
    ; kind(c17, "pattern_list")
    ),
    child(c17, c18, _), kind(c18, "identifier"), node(_, c18, _, _, _), UT = c18,
    value(UT, t19), value(PW, t19), field(st16, "right", c21), kind(c21, "set"),
    child(c21, c22, _), pth123_int_value(c22), node(_, c22, _, _, _), UV = c22, value(UV, t23), value(UT, t23).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl pth123_alt_4(n: node)
pth123_alt_4(n) :- site_scope(n, "class"), site_latest(n),
    (site_form(n, "assignment") ; site_form(n, "named")), binding_value(n, x1),
    pth123_int_value(x1).
pth123_alt_4(n) :- site_scope(n, "class"), site_latest(n), (st2 = n ; within(n, st2)),
    kind(st2, "as_pattern"), child(st2, c3, _), pth123_int_value(c3), child(st2, c4, _),
    kind(c4, "as_pattern_target"), child(c4, c5, _), kind(c5, "identifier").
pth123_alt_4(n) :- site_scope(n, "class"), site_latest(n),
    ( site_form(n, "annotated")
    ; site_form(n, "annotation")
    ; site_form(n, "parameter")
    ),
    (st6 = n ; within(n, st6)),
    count : { child(st6, c7, _), (kind(c7, "list_splat_pattern") ; kind(c7, "dictionary_splat_pattern")) } = 0,
    site_annotation(n, o8), pth123_int_annotation(o8).
pth123_alt_4(n) :- site_scope(n, "class"), site_latest(n), (st9 = n ; within(n, st9)),
    kind(st9, "function_definition"), field(st9, "return_type", c10),
    pth123_int_annotation(c10).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
//   A: metavariable of the calling rule, passed in (bound by the caller)
.decl pth123_alt_5(n: node, a: loc)
pth123_alt_5(n, A) :- pth123_demand_alt_5(n, A), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), pth123_class_holding_int(st2, A).
pth123_alt_5(n, A) :- pth123_demand_alt_5(n, A), kind(n, "attribute"), field(n, "attribute", c3),
    kind(c3, "identifier"), node(_, c3, _, _, _), B = c3, field(n, "object", c4), kind(c4, "identifier"),
    ref_site(c4, b5), (st6 = b5 ; within(b5, st6)), kind(st6, "class_definition"),
    field(st6, "body", c7), within_stop(c8, c7, "class_definition"),
    pth123_class_holding_int(c8, A), field(c8, "name", c9), node(_, c9, _, _, _), B = c9,
    site_scope(c9, "class"), site_latest(c9).

// alt_9(n): the JSON `any`: n matches if any one of these rules does
.decl pth123_alt_9(n: node)
pth123_alt_9(n) :-
    ( kind(n, "keyword_argument")
    ; kind(n, "dictionary_splat")
    ; kind(n, "comment")
    ; kind(n, "line_continuation")
    ).

pth123_alt_9(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl pth123_alt_10(n: node)
pth123_alt_10(n) :- pth123_positional(n), k2 = count : { precedes(s1, n), pth123_positional(s1) }, k2 >= 0,
    k2 <= 0, pth123_unread_file(n).
pth123_alt_10(n) :- kind(n, "keyword_argument"), child(n, c3, _), kind(c3, "identifier"),
    glob("file", c3), pth123_tok_precedes_15(c3), child(n, c11, _), pth123_unread_file(c11),
    pth123_tok_follows_16(c11).
pth123_alt_10(n) :- pth123_positional(n), k20 = count : { precedes(s19, n), pth123_positional(s19) },
    k20 >= 6, k20 <= 6,
    !pth123_none_literal_family(n, "true_literal_builtin_open_in_string_annotation").
pth123_alt_10(n) :- pth123_positional(n), k22 = count : { precedes(s21, n), pth123_positional(s21) },
    k22 >= 7, k22 <= 7,
    !pth123_none_literal_family(n, "none_literal_builtin_open_in_string_annotation").
pth123_alt_10(n) :- kind(n, "keyword_argument"), child(n, c23, _), kind(c23, "identifier"),
    glob("closefd", c23), pth123_tok_precedes_17(c23),
    count : { child(n, c31, _), pth123_none_literal_family(c31, "true_literal_builtin_open_in_string_annotation"), pth123_tok_follows_18(c31) } = 0.
pth123_alt_10(n) :- kind(n, "keyword_argument"), child(n, c39, _), kind(c39, "identifier"),
    glob("opener", c39), pth123_tok_precedes_19(c39),
    count : { child(n, c47, _), pth123_none_literal_family(c47, "none_literal_builtin_open_in_string_annotation"), pth123_tok_follows_20(c47) } = 0.

// alt_11(n): the JSON `any`: n matches if any one of these rules does
//   F: metavariable this relation binds for the calling rule
.decl pth123_alt_11(n: node, f: loc)
pth123_alt_11(n, F) :- pth123_ann_call(n, F).
pth123_alt_11(n, F) :- pth123_ann_string(n, F).
