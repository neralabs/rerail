air301_ctx_key_inlet_events(n) :- kind(n, "call"), field(n, "function", c3),
    kind(c3, "attribute"), field(c3, "attribute", c4), glob("get", c4),
    field(c3, "object", c5), air301_ctx_var(c5), field(n, "arguments", c6),
    kind(c6, "argument_list"), child(c6, c7, _), air301_key(c7, "inlet_events"),
    precedes_stop(s8, c7, air301_stop_59), glob("(", s8).
air301_ctx_key_inlet_events(n) :- kind(n, "parenthesized_expression"), child(n, c9, _),
