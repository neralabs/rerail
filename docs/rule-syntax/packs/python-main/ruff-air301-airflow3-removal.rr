    within_stop(c6, n, air301_stop_238), field(_, "object", c6), kind(c6, "identifier"),
    ref_site(c6, b7), (st8 = b7 ; within(b7, st8)), air301_assigned_cls_lineage_info(st8).

// alt_263(n): the JSON `any`: n matches if any one of these rules does
//   A: metavariable this relation binds for the calling rule
.decl air301_alt_263(n: node, a: loc)
air301_alt_263(n, A) :- field(n, "attribute", c1), glob("get_connections", c1), node(_, c1, _, _, _), A = c1,
    within_stop(c2, n, air301_stop_238), field(_, "object", c2), kind(c2, "identifier"),
    ref_site(c2, b3), (st4 = b3 ; within(b3, st4)), air301_assigned_cls_local_backend(st4).
air301_alt_263(n, A) :- field(n, "attribute", c5), glob("get_connections", c5), node(_, c5, _, _, _), A = c5,
    within_stop(c6, n, air301_stop_238), field(_, "object", c6), kind(c6, "identifier"),
    ref_site(c6, b7), (st8 = b7 ; within(b7, st8)), air301_assigned_backend_class(st8).
air301_alt_263(n, A) :- field(n, "attribute", c9), glob("get_connections", c9), node(_, c9, _, _, _), A = c9,
    within_stop(c10, n, air301_stop_238), field(_, "object", c10), kind(c10, "identifier"),
    ref_site(c10, b11), (st12 = b11 ; within(b11, st12)), air301_assigned_hook_class(st12).

// alt_270(n): the JSON `any`: n matches if any one of these rules does
.decl air301_alt_270(n: node)
air301_alt_270(n) :- child(p1, n, _), kind(p1, "parameters"), child(p2, p1, _),
    kind(p2, "function_definition"), air301_context_function(p2).
air301_alt_270(n) :- field(p3, "name", n),
    (kind(p3, "default_parameter") ; kind(p3, "typed_default_parameter")),
    child(p4, p3, _), kind(p4, "parameters"), child(p5, p4, _),
    kind(p5, "function_definition"), air301_context_function(p5).
air301_alt_270(n) :- child(p6, n, _), kind(p6, "typed_parameter"), child(p7, p6, _),
    kind(p7, "parameters"), child(p8, p7, _), kind(p8, "function_definition"),
    air301_context_function(p8).

// stop_238_within: within_stop over the stop set stop_238, read inside an aggregate
.decl air301_stop_238_within(n: node, a: node)
air301_stop_238_within(x, y) :- within_stop(x, y, air301_stop_238).
