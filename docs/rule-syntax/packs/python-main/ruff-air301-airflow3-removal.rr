// from_inlet_events(n): the JSON util `from-inlet_events`, used where the JSON says `matches: "from-inlet_events"`
.decl air301_from_inlet_events(n: node)
air301_from_inlet_events(n) :- air301_demand_from_inlet_events(n), air301_ctx_key_inlet_events(n).
air301_from_inlet_events(n) :- air301_demand_from_inlet_events(n), kind(n, "identifier"),
    ref_site(n, b1), site_only(b1), binding_value(b1, x2), air301_ctx_key_inlet_events(x2).
air301_from_inlet_events(n) :- air301_demand_from_inlet_events(n), kind(n, "identifier"),
    ref_site(n, b3), site_only(b3), (st4 = b3 ; within(b3, st4)),
    kind(st4, "as_pattern"), child(st4, c5, _), air301_ctx_key_inlet_events(c5).
air301_from_inlet_events(n) :- air301_demand_from_inlet_events(n),
