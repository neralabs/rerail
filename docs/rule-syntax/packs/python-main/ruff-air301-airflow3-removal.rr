// task_ref(n): the JSON util `task-ref`, used where the JSON says `matches: "task-ref"`
.decl air301_task_ref(n: node)
air301_task_ref(n) :- air301_task_name(n).
air301_task_ref(n) :- kind(n, "attribute"), field(n, "object", c1), air301_task_name(c1).
air301_task_ref(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), air301_task_ref(c2).

// task_decorator(n): the JSON util `task-decorator`, used where the JSON says `matches: "task-decorator"`
.decl air301_task_decorator(n: node)
air301_task_decorator(n) :- air301_task_ref(n).
air301_task_decorator(n) :- kind(n, "call"), field(n, "function", c1), air301_task_ref(c1).
air301_task_decorator(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    air301_task_decorator(c2).

// task_function(n): the JSON util `task-function`, used where the JSON says `matches: "task-function"`
.decl air301_task_function(n: node)
air301_task_function(n) :- kind(n, "function_definition"), child(p1, n, _),
    kind(p1, "decorated_definition"), child(p1, c2, _), kind(c2, "decorator"),
    child(c2, c3, _), air301_task_decorator(c3).

// in_task(n): the JSON util `in-task`, used where the JSON says `matches: "in-task"`
.decl air301_in_task(n: node)
air301_in_task(n) :- air301_demand_in_task(n), air301_up_5(n, p1).
air301_in_task(n) :- air301_demand_in_task(n), air301_up_6(n, p2), child(p3, p2, _),
    kind(p3, "decorated_definition"), field(p3, "definition", c4), air301_task_function(c4).

// assigned_get_current_context(n): the JSON util `assigned-get-current-context`, used where the JSON says `matches: "assigned-get-current-context"`
.decl air301_assigned_get_current_context(n: node)
air301_assigned_get_current_context(n) :- air301_demand_assigned_get_current_context(n),
    kind(n, "assignment"), within_stop(c1, n, air301_stop_238), field(_, "right", c1),
    air301_alt_53(c1).

// ctx_var(n): the JSON util `ctx-var`, used where the JSON says `matches: "ctx-var"`
.decl air301_ctx_var(n: node)
air301_ctx_var(n) :- kind(n, "identifier"),
    ( ref_site(n, b1), site_only(b1), (st1 = b1 ; within(b1, st1)), air301_alt_54(st1), inside(st1, p1, "parameters"), node(_, p1, _, _, _)
    ; ref_site(n, b2), (st2 = b2 ; within(b2, st2)), air301_assigned_get_current_context(st2)
    ).


// operator_base(n): the JSON util `operator-base`, used where the JSON says `matches: "operator-base"`
.decl air301_operator_base(n: node)
air301_operator_base(n) :- air301_demand_operator_base(n), kind(n, "attribute"),
    sym_of(n, q1), match("(airflow)(\\.|$).*", q1), field(n, "attribute", c2),
    glob("BaseOperator", c2).
air301_operator_base(n) :- air301_demand_operator_base(n), kind(n, "identifier"),
    sym_of(n, q3), match("(airflow)(\\.|$).*", q3), ref_site(n, b4),
    (st5 = b4 ; within(b4, st5)),
    ( kind(st5, "dotted_name"), glob("BaseOperator", st5), child(p1, st5, _), kind(p1, "import_from_statement")
    ; kind(st5, "aliased_import"), field(st5, "name", c1), match(".*(^|\\.)BaseOperator", c1)
    ).

air301_operator_base(n) :- air301_demand_operator_base(n), kind(n, "identifier"), ref_site(n, b8),
    (st9 = b8 ; within(b8, st9)), kind(st9, "class_definition"), air301_operator_class(st9).
air301_operator_base(n) :- air301_demand_operator_base(n), kind(n, "subscript"),
    field(n, "value", c10), air301_operator_base(c10).
air301_operator_base(n) :- air301_demand_operator_base(n), kind(n, "parenthesized_expression"),
    child(n, c11, _), air301_operator_base(c11).

// operator_class(n): the JSON util `operator-class`, used where the JSON says `matches: "operator-class"`
.decl air301_operator_class(n: node)
air301_operator_class(n) :- air301_demand_operator_class(n), kind(n, "class_definition"),
    field(n, "superclasses", c1), kind(c1, "argument_list"), child(c1, c2, _),
    air301_operator_base(c2).

// execute_method(n): the JSON util `execute-method`, used where the JSON says `matches: "execute-method"`
.decl air301_execute_method(n: node)
air301_execute_method(n) :- kind(n, "function_definition"), field(n, "name", c1),
    glob("execute", c1), within_stop(n, p2, air301_stop_273), kind(p2, "class_definition"),
    air301_operator_class(p2).

// context_function(n): the JSON util `context-function`, used where the JSON says `matches: "context-function"`
.decl air301_context_function(n: node)
air301_context_function(n) :- air301_task_function(n).
air301_context_function(n) :- air301_execute_method(n).

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl air301_plain_string(n: node)
air301_plain_string(n) :- (kind(n, "string") ; kind(n, "concatenated_string")), value(n, v1),
    value_type(v1, "str"),
    count : { has(n, c2, "string_start"), glob("**[fFtT]**", c2) } = 0.

// key(n, key): 5 copies of one rule set (`key-conf`, `key-dag_run`, `key-inlet_events` and 2 more), folded into one: row `key` of
// key_case gives the strings each copy had.
.decl air301_key(n: node, air301_key: symbol)
air301_key(n, q1) :- air301_key_case(q1, s1), (kind(n, "string") ; kind(n, "concatenated_string")),
    value(n, v1), value_type(v1, "str"), glob(s1, v1),
    count : { has(n, c2, "string_start"), glob("**[fFtT]**", c2) } = 0.

// ctx_key_dag_run(n): the JSON util `ctx-key-dag_run`, used where the JSON says `matches: "ctx-key-dag_run"`
.decl air301_ctx_key_dag_run(n: node)
air301_ctx_key_dag_run(n) :- kind(n, "subscript"), field(n, "value", c1), air301_ctx_var(c1),
    field(n, "subscript", c2), air301_key(c2, "dag_run").
air301_ctx_key_dag_run(n) :- kind(n, "call"), field(n, "function", c3), kind(c3, "attribute"),
    field(c3, "attribute", c4), glob("get", c4), field(c3, "object", c5), air301_ctx_var(c5),
    field(n, "arguments", c6), kind(c6, "argument_list"), child(c6, c7, _),
    air301_key(c7, "dag_run"), precedes_stop(s8, c7, air301_stop_59), glob("(", s8).
air301_ctx_key_dag_run(n) :- kind(n, "parenthesized_expression"), child(n, c9, _),
    air301_ctx_key_dag_run(c9).

// from_dag_run(n): the JSON util `from-dag_run`, used where the JSON says `matches: "from-dag_run"`
.decl air301_from_dag_run(n: node)
air301_from_dag_run(n) :- air301_demand_from_dag_run(n), air301_ctx_key_dag_run(n).
air301_from_dag_run(n) :- air301_demand_from_dag_run(n), kind(n, "identifier"), ref_site(n, b1),
    site_only(b1), binding_value(b1, x2), air301_ctx_key_dag_run(x2).
air301_from_dag_run(n) :- air301_demand_from_dag_run(n), kind(n, "identifier"), ref_site(n, b3),
    site_only(b3), (st4 = b3 ; within(b3, st4)), kind(st4, "as_pattern"),
    child(st4, c5, _), air301_ctx_key_dag_run(c5).
air301_from_dag_run(n) :- air301_demand_from_dag_run(n), kind(n, "parenthesized_expression"),
    child(n, c6, _), air301_from_dag_run(c6).

// ctx_key_inlet_events(n): the JSON util `ctx-key-inlet_events`, used where the JSON says `matches: "ctx-key-inlet_events"`
.decl air301_ctx_key_inlet_events(n: node)
air301_ctx_key_inlet_events(n) :- kind(n, "subscript"), field(n, "value", c1), air301_ctx_var(c1),
