// ctx_key_slot(n): the JSON util `ctx-key-slot`, used where the JSON says `matches: "ctx-key-slot"`
.decl air301_ctx_key_slot(n: node)
air301_ctx_key_slot(n) :- within_stop(n, p1, air301_stop_238), field(_, "subscript", n),
    kind(p1, "subscript"), field(p1, "value", c2), air301_ctx_var(c2).
air301_ctx_key_slot(n) :- air301_alt_64(n), air301_up_7(n, p7), field(p8, "arguments", p7),
    kind(p8, "call"), field(p8, "function", c9), kind(c9, "attribute"),
    field(c9, "attribute", c10), glob("get", c10), field(c9, "object", c11),
    air301_ctx_var(c11).

// inlet_key_slot(n): the JSON util `inlet-key-slot`, used where the JSON says `matches: "inlet-key-slot"`
.decl air301_inlet_key_slot(n: node)
air301_inlet_key_slot(n) :- within_stop(n, p1, air301_stop_238), field(_, "subscript", n),
    kind(p1, "subscript"), field(p1, "value", c2), air301_from_inlet_events(c2).
air301_inlet_key_slot(n) :- air301_alt_64(n), air301_up_7(n, p7), field(p8, "arguments", p7),
    kind(p8, "call"), field(p8, "function", c9), kind(c9, "attribute"),
    field(c9, "attribute", c10), glob("get", c10), field(c9, "object", c11),
    air301_from_inlet_events(c11).

// apply_defaults(n): the JSON util `apply-defaults`, used where the JSON says `matches: "apply-defaults"`
.decl air301_apply_defaults(n: node)
air301_apply_defaults(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
