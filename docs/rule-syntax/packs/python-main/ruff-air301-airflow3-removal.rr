AIR301_context_key_conf(n, "`none_failed_or_skipped` was removed in Airflow 3; use `\"none_failed_min_one_success\"` instead") :- (kind(n, "string") ; kind(n, "concatenated_string")),
    value(n, v1), value_type(v1, "str"), glob("none_failed_or_skipped", v1),
    count : { has(n, c2, "string_start"), glob("**[fFtT]**", c2) } = 0,
    within_stop(n, p3, air301_stop_238), field(_, "value", n), kind(p3, "keyword_argument"),
    field(p3, "name", c4), glob("trigger_rule", c4), child(p5, p3, _),
