AIR301_context_key_conf(n, "The auth manager constructor takes no parameters in Airflow 3; drop the arguments") :- kind(n, "argument_list"),
    child(n, c1, _), !air301_alt_237(c1), child(p2, n, _), kind(p2, "call"),
