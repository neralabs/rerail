.violation AIR301(at: node, n: node) "`{n}` was removed in Airflow 3; compare `sys.version_info` instead."
    suppress noqa "AIR301"
AIR301(N, n) :- air301_old_name(n), node(_, n, _, _, _), N = n, !air301_deleted_name(n).
AIR301(N, n) :- air301_quoted(n, N).

// old_name(n): the JSON util `old-name`, used where the JSON says `matches: "old-name"`
.decl air301_old_name(n: node)
air301_old_name(n) :- (kind(n, "identifier") ; kind(n, "attribute") ; kind(n, "dotted_name")),
    sym_of(n, q1), air301_set_75(q1).

// quoted(n): the JSON util `quoted`, used where the JSON says `matches: "quoted"`
//   N: metavariable this relation binds for the calling rule
.decl air301_quoted(n: node, n_mv: loc)
air301_quoted(n, N) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), air301_alt_76(c2, N).

