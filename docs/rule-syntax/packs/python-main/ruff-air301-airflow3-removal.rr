AIR301_context_key_conf(n, "The `conf` parameter was removed from the task context in Airflow 3; import `conf` from `airflow.configuration` instead") :- kind(n, "identifier"),
    glob("conf", n), node(_, n, _, _, _), K = n, air301_alt_270(n).
AIR301_context_key_conf(n, "`apply_defaults` is applied automatically in Airflow 3; delete this decorator") :- kind(n, "decorator"),
