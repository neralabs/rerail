// new_import_of(n, key): 12 copies of one rule set (`new-import`, `new-import`, `new-import` and 9 more), folded into one: row `key` of
// new_import_of_case gives the strings each copy had.
.decl air301_new_import_of(n: node, air301_key: symbol)
air301_new_import_of(n, q1) :- air301_new_import_of_case(q1, s1, s2),
    kind(n, "import_from_statement"), field(n, "module_name", c1),
    ( kind(c1, "dotted_name"), glob(s1, c1)
    ; kind(c1, "relative_import"), child(c1, c2, _), kind(c2, "dotted_name"), glob(s1, c2)
    ),
    child(n, c3, _),
    ( kind(c3, "dotted_name"), glob(s2, c3)
    ; kind(c3, "aliased_import"), field(c3, "name", c4), glob(s2, c4)
