AIR301_context_key_conf(n, "`TriggerRule.NONE_FAILED_OR_SKIPPED` was removed in Airflow 3; use `TriggerRule.NONE_FAILED_MIN_ONE_SUCCESS` instead") :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "airflow.utils.trigger_rule.TriggerRule.NONE_FAILED_OR_SKIPPED"),
    within_stop(n, p1, air301_stop_238), field(_, "value", n), kind(p1, "keyword_argument"),
    field(p1, "name", c2), glob("trigger_rule", c2), child(p3, p1, _),
    kind(p3, "argument_list"), child(p4, p3, _), kind(p4, "call"),
    field(p4, "function", c5), air301_alt_239(c5).
AIR301_context_key_conf(n, "The context key `conf` was removed in Airflow 3; import `conf` from `airflow.configuration` instead") :- air301_ctx_key_slot(n),
    air301_key(n, "conf"), air301_in_task(n), node(_, n, _, _, _), S = n.
AIR301_context_key_conf(n, "The context key `triggering_dataset_events` was removed in Airflow 3; read `\"triggering_asset_events\"` instead") :- air301_ctx_key_slot(n),
    air301_key(n, "renamed"), air301_in_task(n), node(_, n, _, _, _), S = n.
AIR301_context_key_conf(n, "Index `inlet_events` with an `Asset` object such as `inlet_events[Asset(uri=...)]`; string keys were removed in Airflow 3") :- air301_inlet_key_slot(n),
