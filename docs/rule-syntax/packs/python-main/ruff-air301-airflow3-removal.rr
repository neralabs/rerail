.policy "ruff-air301-airflow3-removal" revision 1
.guests off
.description "Replace or remove the APIs, arguments and context keys that Airflow 3 removed, so the code keeps working after the upgrade."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.
// ast(n, {…}) atoms are JSON terms with no .rr form yet; the engine matches them as it does today.

#include "python/names.rr"

// from_mod(n, key): 5 copies of one rule set (`authmgr-from-mod`, `backend-from-mod`, `handler-from-mod` and 2 more), folded into one: row `key` of
// from_mod_case gives the strings each copy had.
.decl air301_from_mod(n: node, air301_key: symbol)
air301_from_mod(n, q1) :- air301_from_mod_case(q1, s1), inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), kind(c2, "dotted_name"), match(s1, c2).

// site(n, key): 5 copies of one rule set (`authmgr-site`, `backend-site`, `handler-site` and 2 more), folded into one: row `key` of
// site_case gives the strings each copy had.
.decl air301_site(n: node, air301_key: symbol)
air301_site(n, q1) :- air301_site_case(q1, s1), (kind(n, "dotted_name") ; kind(n, "aliased_import")),
    air301_from_mod(n, q1).
air301_site(n, q1) :- air301_site_case(q1, s1), kind(n, "aliased_import"), child(p1, n, _),
    kind(p1, "import_statement"), field(n, "name", c2), match(s1, c2).

// head_site(n, key): 5 copies of one rule set (`authmgr-head-site`, `backend-head-site`, `handler-head-site` and 2 more), folded into one: row `key` of
// head_site_case gives the strings each copy had.
.decl air301_head_site(n: node, air301_key: symbol)
air301_head_site(n, q1) :- air301_head_site_case(q1, s1, s2), air301_site(n, q1).
air301_head_site(n, q1) :- air301_head_site_case(q1, s1, s2), inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), kind(c2, "dotted_name"),
    match("airflow\\.providers(\\.\\w+)*", c2),
    ( kind(n, "dotted_name"), glob(s1, n)
    ; kind(n, "aliased_import"), field(n, "name", c1), glob(s1, c1)
    ).

air301_head_site(n, q1) :- air301_head_site_case(q1, s1, s2), kind(n, "aliased_import"),
    child(p4, n, _), kind(p4, "import_statement"), field(n, "name", c5), match(s2, c5).

// head_of_of(n, key): 5 copies of one rule set (`authmgr-head`, `backend-head`, `handler-head` and 2 more), folded into one: row `key` of
// head_of_of_case gives the strings each copy had.
.decl air301_head_of_of(n: node, air301_key: symbol)
air301_head_of_of(n, q1) :- air301_demand_head_of_of(n), air301_class_case(q1), kind(n, "identifier"),
    ref_site(n, b1), (st2 = b1 ; within(b1, st2)), air301_head_site(st2, q1).
air301_head_of_of(n, q1) :- air301_demand_head_of_of(n), air301_class_case(q1), kind(n, "attribute"),
    field(n, "object", c3), air301_head_of_of(c3, q1).
air301_head_of_of(n, q1) :- air301_demand_head_of_of(n), air301_class_case(q1),
    kind(n, "parenthesized_expression"), child(n, c4, _), air301_head_of_of(c4, q1).

// chain(n, key): 5 copies of one rule set (`authmgr-chain`, `backend-chain`, `handler-chain` and 2 more), folded into one: row `key` of
// chain_case gives the strings each copy had.
.decl air301_chain(n: node, air301_key: symbol)
air301_chain(n, q1) :- air301_chain_case(q1, s1), kind(n, "attribute"), field(n, "attribute", c1),
    glob(s1, c1).
air301_chain(n, q1) :- air301_chain_case(q1, s1), kind(n, "attribute"), field(n, "object", c2),
    air301_chain(c2, q1).
air301_chain(n, q1) :- air301_chain_case(q1, s1), kind(n, "parenthesized_expression"),
    child(n, c3, _), air301_chain(c3, q1).

// callee_of(n, key): 5 copies of one rule set (`authmgr-callee`, `backend-callee`, `handler-callee` and 2 more), folded into one: row `key` of
// callee_of_case gives the strings each copy had.
.decl air301_callee_of(n: node, air301_key: symbol)
air301_callee_of(n, q2) :- air301_demand_callee_of(n), air301_callee_of_case(q2, s1),
    (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, q1), match(s1, q1).
air301_callee_of(n, q2) :- air301_demand_callee_of(n), air301_callee_of_case(q2, s1), kind(n, "identifier"),
    ref_site(n, b2), (st3 = b2 ; within(b2, st3)), air301_site(st3, q2).
air301_callee_of(n, q2) :- air301_demand_callee_of(n), air301_callee_of_case(q2, s1), kind(n, "attribute"),
    sym_of(n, q4), match("(airflow\\.providers)(\\.|$).*", q4),
    ( field(n, "object", c1), air301_chain(c1, q2)
    ; field(n, "object", c2), air301_head_of_of(c2, q2)
    ).

air301_callee_of(n, q2) :- air301_demand_callee_of(n), air301_callee_of_case(q2, s1),
    kind(n, "parenthesized_expression"), child(n, c7, _), air301_callee_of(c7, q2).

// last(n, key): 5 copies of one rule set (`authmgr-last`, `backend-last`, `handler-last` and 2 more), folded into one: row `key` of
// last_case gives the strings each copy had.
.decl air301_last(n: node, air301_key: symbol)
air301_last(n, q1) :- air301_last_case(q1, s1), kind(n, "attribute"), field(n, "attribute", c1),
    suffix(s1, c1).
air301_last(n, q1) :- air301_last_case(q1, s1), kind(n, "identifier"), ref_site(n, b2),
    (st3 = b2 ; within(b2, st3)),
    ( kind(st3, "dotted_name"), suffix(s1, st3), child(p1, st3, _), kind(p1, "import_from_statement")
    ; kind(st3, "aliased_import"), field(st3, "name", c1), suffix(s1, c1)
    ).

air301_last(n, q1) :- air301_last_case(q1, s1), kind(n, "parenthesized_expression"), child(n, c6, _),
    air301_last(c6, q1).

// class(n, key): 5 copies of one rule set (`authmgr-class`, `backend-class`, `handler-class` and 2 more), folded into one: row `key` of
// class_case gives the strings each copy had.
.decl air301_class(n: node, air301_key: symbol)
air301_class(n, q1) :- air301_class_case(q1), air301_callee_of(n, q1), air301_last(n, q1).

// dag_site(n): the JSON util `dag-site`, used where the JSON says `matches: "dag-site"`
.decl air301_dag_site(n: node)
air301_dag_site(n) :- kind(n, "dotted_name"), glob("{DAG,dag}", n), child(p1, n, _),
    kind(p1, "import_from_statement").
air301_dag_site(n) :- kind(n, "aliased_import"), field(n, "name", c2),
    match(".*(^|\\.)\\s*(DAG|dag)", c2).

// dag_callee(n): the JSON util `dag-callee`, used where the JSON says `matches: "dag-callee"`
.decl air301_dag_callee(n: node)
air301_dag_callee(n) :- air301_demand_dag_callee(n), kind(n, "attribute"),
    sym_of(n, q1), match("(airflow)(\\.|$).*", q1), field(n, "attribute", c2),
    glob("{DAG,dag}", c2).
air301_dag_callee(n) :- air301_demand_dag_callee(n), kind(n, "identifier"),
    sym_of(n, q3), match("(airflow)(\\.|$).*", q3), ref_site(n, b4),
    (st5 = b4 ; within(b4, st5)), air301_dag_site(st5).
air301_dag_callee(n) :- air301_demand_dag_callee(n), kind(n, "parenthesized_expression"),
    child(n, c6, _), air301_dag_callee(c6).

// task_name(n): the JSON util `task-name`, used where the JSON says `matches: "task-name"`
.decl air301_task_name(n: node)
air301_task_name(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (sym_of(n, "airflow.decorators.task") ; sym_of(n, "airflow.sdk.task")).
air301_task_name(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), air301_task_name(c1).

// task_callee(n): the JSON util `task-callee`, used where the JSON says `matches: "task-callee"`
.decl air301_task_callee(n: node)
air301_task_callee(n) :- air301_task_name(n).

// sdk_variable(n): the JSON util `sdk-variable`, used where the JSON says `matches: "sdk-variable"`
.decl air301_sdk_variable(n: node)
air301_sdk_variable(n) :- air301_demand_sdk_variable(n), kind(n, "attribute"),
    sym_of(n, q1), match("(airflow\\.sdk)(\\.|$).*", q1), field(n, "attribute", c2),
    glob("Variable", c2).
air301_sdk_variable(n) :- air301_demand_sdk_variable(n), kind(n, "identifier"),
    sym_of(n, q3), match("(airflow\\.sdk)(\\.|$).*", q3), ref_site(n, b4),
    (st5 = b4 ; within(b4, st5)),
    ( kind(st5, "dotted_name"), glob("Variable", st5), child(p1, st5, _), kind(p1, "import_from_statement")
    ; kind(st5, "aliased_import"), field(st5, "name", c1), match(".*(^|\\.)Variable", c1)
    ).

air301_sdk_variable(n) :- air301_demand_sdk_variable(n), kind(n, "parenthesized_expression"),
    child(n, c8, _), air301_sdk_variable(c8).

// variable_get(n): the JSON util `variable-get`, used where the JSON says `matches: "variable-get"`
.decl air301_variable_get(n: node)
air301_variable_get(n) :- kind(n, "attribute"), field(n, "attribute", c1), glob("get", c1),
    field(n, "object", c2), air301_sdk_variable(c2).
air301_variable_get(n) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    air301_variable_get(c3).

// tail_obj(n, key): 3 copies of one rule set (`tail-branch-datetime-obj`, `tail-branch-weekday-obj`, `tail-trigger-dagrun-obj`), folded into one: row `key` of
// tail_obj_case gives the strings each copy had.
.decl air301_tail_obj(n: node, air301_key: symbol)
air301_tail_obj(n, q1) :- air301_tail_obj_case(q1, s1), kind(n, "identifier"), glob(s1, n).
air301_tail_obj(n, q1) :- air301_tail_obj_case(q1, s1), kind(n, "attribute"),
    field(n, "attribute", c1), glob(s1, c1).
air301_tail_obj(n, q1) :- air301_tail_obj_case(q1, s1), kind(n, "parenthesized_expression"),
    child(n, c2, _), air301_tail_obj(c2, q1).

// tail(n, key): 3 copies of one rule set (`tail-branch-datetime`, `tail-branch-weekday`, `tail-trigger-dagrun`), folded into one: row `key` of
// tail_case gives the strings each copy had.
.decl air301_tail(n: node, air301_key: symbol)
air301_tail(n, q1) :- air301_demand_tail(n), air301_tail_case(q1, s1, s2), kind(n, "attribute"),
    field(n, "attribute", c1), glob(s1, c1),
    ( field(n, "object", c2), air301_tail_obj(c2, q1)
    ; field(n, "object", c3), kind(c3, "identifier"), ref_site(c3, b1), (st1 = b1 ; within(b1, st1)), kind(st1, "aliased_import"), field(st1, "name", c4), match(s2, c4)
    ).

air301_tail(n, q1) :- air301_demand_tail(n), air301_tail_case(q1, s1, s2), kind(n, "identifier"),
    ref_site(n, b7), (st8 = b7 ; within(b7, st8)),
    inside(st8, p9, "import_from_statement"), field(p9, "module_name", c10),
    kind(c10, "dotted_name"), match(s2, c10),
    ( kind(st8, "dotted_name"), glob(s1, st8)
    ; kind(st8, "aliased_import"), field(st8, "name", c1), glob(s1, c1)
    ).

air301_tail(n, q1) :- air301_demand_tail(n), air301_tail_case(q1, s1, s2),
    kind(n, "parenthesized_expression"), child(n, c12, _), air301_tail(c12, q1).

// import_error(n): the JSON util `import-error`, used where the JSON says `matches: "import-error"`
.decl air301_import_error(n: node)
air301_import_error(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (global_ref(n, "ImportError") ; global_ref(n, "ModuleNotFoundError")),
    (sym_of(n, "builtins.ImportError") ; sym_of(n, "builtins.ModuleNotFoundError")).
air301_import_error(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air301_import_error(c1).

// import_error_type(n): the JSON util `import-error-type`, used where the JSON says `matches: "import-error-type"`
.decl air301_import_error_type(n: node)
air301_import_error_type(n) :- air301_import_error(n).
air301_import_error_type(n) :- (kind(n, "tuple") ; kind(n, "parenthesized_expression") ; kind(n, "as_pattern")),
    child(n, c1, _), air301_import_error_type(c1).

// attribute_error(n): the JSON util `attribute-error`, used where the JSON says `matches: "attribute-error"`
.decl air301_attribute_error(n: node)
air301_attribute_error(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "AttributeError"), sym_of(n, "builtins.AttributeError").
air301_attribute_error(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air301_attribute_error(c1).

// attribute_error_type(n): the JSON util `attribute-error-type`, used where the JSON says `matches: "attribute-error-type"`
.decl air301_attribute_error_type(n: node)
air301_attribute_error_type(n) :- air301_attribute_error(n).
air301_attribute_error_type(n) :- (kind(n, "tuple") ; kind(n, "parenthesized_expression") ; kind(n, "as_pattern")),
    child(n, c1, _), air301_attribute_error_type(c1).

// import_guard_ctx(n): the JSON util `import-guard-ctx`, used where the JSON says `matches: "import-guard-ctx"`
.decl air301_import_guard_ctx(n: node)
air301_import_guard_ctx(n) :- air301_demand_import_guard_ctx(n), air301_up_1(n, p1), air301_up_2(n, p2),
    child(p2, c3, _), kind(c3, "except_clause"), field(c3, "value", c4),
    air301_import_error_type(c4).

// attribute_guard_ctx(n): the JSON util `attribute-guard-ctx`, used where the JSON says `matches: "attribute-guard-ctx"`
.decl air301_attribute_guard_ctx(n: node)
air301_attribute_guard_ctx(n) :- air301_demand_attribute_guard_ctx(n), air301_up_3(n, p1), air301_up_4(n, p2),
    child(p2, c3, _), kind(c3, "except_clause"), field(c3, "value", c4),
    air301_attribute_error_type(c4).

// deleted_name(n): the JSON util `deleted-name`, used where the JSON says `matches: "deleted-name"`
.decl air301_deleted_name(n: node)
air301_deleted_name(n) :- kind(n, "identifier"), within_stop(n, p1, air301_stop_25),
    kind(p1, "delete_statement").

// cls_dataset_manager_family(n, key): 7 copies of one rule set (`cls-dataset-manager`, `cls-lineage-collector`, `cls-lineage-info` and 4 more), folded into one: row `key` of
// cls_dataset_manager_family_case gives the strings each copy had.
.decl air301_cls_dataset_manager_family(n: node, air301_key: symbol)
air301_cls_dataset_manager_family(n, q1) :- air301_cls_dataset_manager_family_case(q1, s1),
    (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, s1).
air301_cls_dataset_manager_family(n, q1) :- air301_cls_dataset_manager_family_case(q1, s1),
    kind(n, "parenthesized_expression"), child(n, c1, _),
    air301_cls_dataset_manager_family(c1, q1).

// cls_dag(n): the JSON util `cls-dag`, used where the JSON says `matches: "cls-dag"`
.decl air301_cls_dag(n: node)
air301_cls_dag(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "airflow.models.dag.DAG")
    ; sym_of(n, "airflow.models.DAG")
    ; sym_of(n, "airflow.DAG")
    ).

air301_cls_dag(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), air301_cls_dag(c1).

// cls_dataset(n): the JSON util `cls-dataset`, used where the JSON says `matches: "cls-dataset"`
.decl air301_cls_dataset(n: node)
air301_cls_dataset(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), match("(airflow\\.datasets)(\\.|$).*", q1),
    !sym_of(n, "airflow.datasets.manager.DatasetManager").
air301_cls_dataset(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "airflow.Dataset").
air301_cls_dataset(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    air301_cls_dataset(c2).

// cls_datasets_any(n): the JSON util `cls-datasets-any`, used where the JSON says `matches: "cls-datasets-any"`
.decl air301_cls_datasets_any(n: node)
air301_cls_datasets_any(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), match("(airflow\\.datasets)(\\.|$).*", q1).
air301_cls_datasets_any(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    air301_cls_datasets_any(c2).

// assigned_cls_datasets_any(n): the JSON util `assigned-cls-datasets-any`, used where the JSON says `matches: "assigned-cls-datasets-any"`
.decl air301_assigned_cls_datasets_any(n: node)
air301_assigned_cls_datasets_any(n) :- air301_demand_assigned_cls_datasets_any(n),
    kind(n, "assignment"), within_stop(c1, n, air301_stop_238), field(_, "right", c1),
    air301_alt_27(c1).

// dataset_tail(n): the JSON util `dataset-tail`, used where the JSON says `matches: "dataset-tail"`
.decl air301_dataset_tail(n: node)
air301_dataset_tail(n) :- air301_demand_dataset_tail(n), kind(n, "attribute"),
    within_stop(c1, n, air301_stop_238), field(_, "object", c1), air301_alt_29(c1).

// assigned_cls_dataset_manager(n): the JSON util `assigned-cls-dataset-manager`, used where the JSON says `matches: "assigned-cls-dataset-manager"`
.decl air301_assigned_cls_dataset_manager(n: node)
air301_assigned_cls_dataset_manager(n) :- air301_demand_assigned_cls_dataset_manager(n),
