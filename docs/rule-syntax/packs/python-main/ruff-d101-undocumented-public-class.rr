.policy "ruff-d101-undocumented-public-class" revision 1
.guests off
.description "Give each public Python class a docstring that explains what it represents and how to use it."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// D101(n): a finding at node n, from clause `undocumented-public-class`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation D101(at: node, n: loc) "Add a docstring as the first statement of class `{n}`, explaining what it represents and how to use it."
    suppress noqa "D101"
D101_raw(n, N) :- kind(n, "identifier"), node(_, n, _, _, _), N = n, match("[^_].*", n),
    field(p1, "name", n), kind(p1, "class_definition"),
    count : { within(p1, p2), (kind(p2, "function_definition") ; kind(p2, "class_definition")) } = 0,
    count : { field(p1, "body", c3), child(c3, c4, _), d101_docstring(c4) } = 0,
    ( count : { inside(n, p1_1, "module"), d101_stop_3_within(c2_1, p1_1), d101_all_stmt(c2_1) } = 0
    ; site_exported(n)
    ; inside(n, p3_3, "module"), within_stop(c4_3, p3_3, d101_stop_3), kind(c4_3, "string"), node(_, c4_3, _, _, _), S = c4_3, value(S, t5_3), value(N, t5_3), d101_all_entry(c4_3)
    ).


// doc_string(n): the JSON util `doc-string`, used where the JSON says `matches: "doc-string"`
.decl d101_doc_string(n: node)
d101_doc_string(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0.
d101_doc_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c2, _), kind(c2, "string"), child(c2, c3, _), kind(c3, "string_start"), glob("**[bBfFtT]**", c3) } = 0.
d101_doc_string(n) :- kind(n, "parenthesized_expression"), child(n, c4, _), d101_doc_string(c4).

// docstring(n): the JSON util `docstring`, used where the JSON says `matches: "docstring"`
.decl d101_docstring(n: node)
d101_docstring(n) :- kind(n, "expression_statement"),
    count : { precedes(s1, n), !kind(s1, "comment") } = 0, child(n, c2, _),
    d101_doc_string(c2), !d101_tok_has_1(n).

// all_stmt(n): the JSON util `all-stmt`, used where the JSON says `matches: "all-stmt"`
.decl d101_all_stmt(n: node)
d101_all_stmt(n) :- (kind(n, "assignment") ; kind(n, "augmented_assignment")),
    child(p1, n, _), kind(p1, "expression_statement"), field(n, "left", c2),
    match("[(\\s]*__all__[\\s)]*", c2).

// all_value(n): the JSON util `all-value`, used where the JSON says `matches: "all-value"`
.decl d101_all_value(n: node)
d101_all_value(n) :- field(p1, "right", n), d101_all_stmt(p1).
d101_all_value(n) :- field(p2, "right", n), kind(p2, "assignment"), d101_all_value(p2).
d101_all_value(n) :- child(p3, n, _), kind(p3, "parenthesized_expression"), d101_all_value(p3).
d101_all_value(n) :- field(p4, "left", n), kind(p4, "binary_operator"), d101_all_value(p4).

// all_list(n): the JSON util `all-list`, used where the JSON says `matches: "all-list"`
.decl d101_all_list(n: node)
d101_all_list(n) :- d101_all_value(n).
d101_all_list(n) :- field(p1, "right", n), kind(p1, "binary_operator"), d101_all_value(p1).
d101_all_list(n) :- child(p2, n, _), kind(p2, "parenthesized_expression"), d101_all_list(p2).
d101_all_list(n) :- field(p3, "value", n), kind(p3, "named_expression"), d101_all_list(p3).

// list_arg(n): the JSON util `list-arg`, used where the JSON says `matches: "list-arg"`
.decl d101_list_arg(n: node)
d101_list_arg(n) :- child(p1, n, _), kind(p1, "parenthesized_expression"), d101_list_arg(p1).
d101_list_arg(n) :- child(p2, n, _), kind(p2, "argument_list"),
    k4 = count : { child(p2, c3, _), !d101_alt_1(c3) }, k4 <= 1, child(p5, p2, _),
    kind(p5, "call"), d101_all_list(p5), field(p5, "function", c6),
    (kind(c6, "subscript"), field(c6, "value", c1), d101_list_func(c1) ; d101_list_func(c6)).

// list_func(n): the JSON util `list-func`, used where the JSON says `matches: "list-func"`
.decl d101_list_func(n: node)
d101_list_func(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (global_ref(n, "list") ; global_ref(n, "tuple")),
    (sym_of(n, "builtins.list") ; sym_of(n, "builtins.tuple")).

// all_entry(n): the JSON util `all-entry`, used where the JSON says `matches: "all-entry"`
.decl d101_all_entry(n: node)
d101_all_entry(n) :- child(p1, n, _), kind(p1, "parenthesized_expression"), d101_all_entry(p1).
d101_all_entry(n) :- child(p2, n, _),
    (kind(p2, "list") ; kind(p2, "tuple") ; kind(p2, "expression_list")), d101_all_list(p2).
d101_all_entry(n) :- child(p3, n, _),
    (kind(p3, "list") ; kind(p3, "tuple") ; kind(p3, "set")), d101_list_arg(p3).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d101_tok_has_1(n: node)
.stored d101_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d101_tok_has_1(n) :- child(n, c3, _), glob("\\,", c3).
d101_tok_has_1(n) :- op(n, t4), match(",", t4).
d101_tok_has_1(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
d101_tok_has_1(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
d101_tok_has_1(n) :- node_text(n, g5), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g5).

// stop_3: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl d101_stop_3(kind: symbol)
d101_stop_3("function_definition"). d101_stop_3("class_definition").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl d101_alt_1(n: node)
d101_alt_1(n) :- node(_, n, _, _, _), glob("[(),]", n).
d101_alt_1(n) :- kind(n, "comment").

// stop_3_within: within_stop over the stop set stop_3, read inside an aggregate
.decl d101_stop_3_within(n: node, a: node)
d101_stop_3_within(x, y) :- within_stop(x, y, d101_stop_3).

// main's file condition {"notRegex": "\\.pyi$"}
.decl D101_raw(at: node, n: loc)
D101(v0, v1) :- D101_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).
