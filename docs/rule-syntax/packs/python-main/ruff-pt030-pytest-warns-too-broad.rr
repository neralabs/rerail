// alt_2_u0_empty: level -1 of an unrolled recursion, empty
.decl pt030_alt_2_u0_empty(n: node)

// alt_3_u0_empty: level -1 of an unrolled recursion, empty
.decl pt030_alt_3_u0_empty(n: node)

// empty_or_null_u0_empty: level -1 of an unrolled recursion, empty
.decl pt030_empty_or_null_u0_empty(n: node)

// part_empty_u0: level -1 of an unrolled recursion, empty
.decl pt030_part_empty_u0(n: node)

// part_empty_u0_empty: level -1 of an unrolled recursion, empty
.decl pt030_part_empty_u0_empty(n: node)

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pt030_alt_2(n: node)
pt030_alt_2(n) :- pt030_alt_2_u7(n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pt030_alt_3(n: node)
pt030_alt_3(n) :- pt030_alt_3_u7(n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl pt030_alt_5(n: node)
pt030_alt_5(n) :-
    ( kind(n, "keyword_argument")
    ; kind(n, "dictionary_splat")
    ; kind(n, "comment")
    ; kind(n, "line_continuation")
    ).

pt030_alt_5(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl pt030_alt_6(n: node)
pt030_alt_6(n) :- kind(n, "list_splat").
pt030_alt_6(n) :- precedes(s1, n), pt030_positional(s1).

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl pt030_alt_7(n: node)
pt030_alt_7(n) :- field(n, "value", c1), pt030_empty_or_null(c1).
pt030_alt_7(n) :- precedes(s2, n), kind(s2, "keyword_argument"), field(s2, "name", c3),
    glob("match", c3).

// alt_9(n): the JSON `any`: n matches if any one of these rules does
.decl pt030_alt_9(n: node)
pt030_alt_9(n) :- child(n, c1, _), pt030_ann_empty_or_null(c1), pt030_tok_follows_6(c1).
pt030_alt_9(n) :- precedes(s9, n), kind(s9, "keyword_argument"), child(s9, c10, _),
    kind(c10, "identifier"), glob("match", c10), pt030_tok_precedes_2(c10).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
//   W: metavariable this relation binds for the calling rule
.decl pt030_alt_11(n: node, w: loc)
pt030_alt_11(n, W) :- pt030_ann_flagged_warning(n, W), !pt030_in_callable_form(n).
pt030_alt_11(n, W) :- pt030_ann_string_context_manager(n, W).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
//   W: metavariable this relation binds for the calling rule
.decl pt030_alt_12(n: node, w: loc)
pt030_alt_12(n, W) :- pt030_ann_flagged_warning(n, W), pt030_in_callable_form(n).
pt030_alt_12(n, W) :- pt030_ann_string_callable(n, W).
