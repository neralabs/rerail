// tok_precedes_1(n): a later sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pt030_tok_precedes_1(n: node)
.stored pt030_tok_precedes_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt030_tok_precedes_1(n) :- next_sibling(n, s2), glob("=", s2).
pt030_tok_precedes_1(n) :- structural_after(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, _, en8), o6 = en8 + strlen(g4), token(p5, _, t3, o6, _),
    match("=", t3).
pt030_tok_precedes_1(n) :- structural_after(n, g4),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pt030_tok_precedes_2(n: node)
.stored pt030_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt030_tok_precedes_2(n) :- next_sibling(n, s11), glob("=", s11).
pt030_tok_precedes_2(n) :- structural_after(n, g13), match("\\s*", g13), child(p14, n, _),
    node(_, n, _, _, en17), o15 = en17 + strlen(g13), token(p14, _, t12, o15, _),
    match("=", t12).
pt030_tok_precedes_2(n) :- structural_after(n, g13),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g13).

// tok_precedes_3(n): a later sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pt030_tok_precedes_3(n: node)
.stored pt030_tok_precedes_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt030_tok_precedes_3(n) :- next_sibling(n, s4), glob("=", s4).
pt030_tok_precedes_3(n) :- structural_after(n, g6), match("\\s*", g6), child(p7, n, _),
    node(_, n, _, _, en10), o8 = en10 + strlen(g6), token(p7, _, t5, o8, _),
    match("=", t5).
pt030_tok_precedes_3(n) :- structural_after(n, g6),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g6).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pt030_tok_follows_4(n: node)
