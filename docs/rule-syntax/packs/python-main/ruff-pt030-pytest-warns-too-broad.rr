// tok_follows_7(n): an earlier sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pt030_tok_follows_7(n: node)
.stored pt030_tok_follows_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pt030_tok_follows_7(n) :- next_sibling(s1, n), glob("=", s1).
pt030_tok_follows_7(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("=", t2).
pt030_tok_follows_7(n) :- structural_before(n, g3),
