.policy "ruff-pt030-pytest-warns-too-broad" revision 1
.guests off
.description "Pass a match pattern to pytest.warns for Warning, UserWarning or DeprecationWarning, or expect a more specific warning; a generic warning also catches unrelated ones."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// warns_ref(n): the JSON util `warns-ref`, used where the JSON says `matches: "warns-ref"`
.decl pt030_warns_ref(n: node)
pt030_warns_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "pytest.warns").

// warns_callee(n): the JSON util `warns-callee`, used where the JSON says `matches: "warns-callee"`
.decl pt030_warns_callee(n: node)
pt030_warns_callee(n) :- pt030_warns_ref(n).
pt030_warns_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pt030_warns_callee(c1).

// broad_warning(n): the JSON util `broad-warning`, used where the JSON says `matches: "broad-warning"`
//   W: metavariable this relation binds for the calling rule
.decl pt030_broad_warning(n: node, w: loc)
pt030_broad_warning(n, W) :- kind(n, "identifier"), node(_, n, _, _, _), W = n,
    ( global_ref(n, "Warning")
    ; global_ref(n, "UserWarning")
    ; global_ref(n, "DeprecationWarning")
    ).

pt030_broad_warning(n, W) :- kind(n, "identifier"), node(_, n, _, _, _), W = n,
    (sym_of(n, "Warning") ; sym_of(n, "UserWarning") ; sym_of(n, "DeprecationWarning")).
pt030_broad_warning(n, W) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pt030_broad_warning(c1, W).

// part_has_text(n): the JSON util `part-has-text`, used where the JSON says `matches: "part-has-text"`
.decl pt030_part_has_text(n: node)
pt030_part_has_text(n) :- child(n, c1, _), kind(c1, "string_content"),
    !match("(\\\\\\r?\\n)+", c1).
pt030_part_has_text(n) :- child(n, c2, _), kind(c2, "string_start"), glob("**[rR]**", c2),
    ( child(n, c1, _), kind(c1, "string_content")
    ; child(n, c3, _), kind(c3, "string_end"), prefix("\\", c3)
    ).


// part_empty(n): the JSON util `part-empty`, used where the JSON says `matches: "part-empty"`
.decl pt030_part_empty(n: node)
pt030_part_empty(n) :- pt030_part_empty_u7(n).

// empty_or_null(n): the JSON util `empty-or-null`, used where the JSON says `matches: "empty-or-null"`
.decl pt030_empty_or_null(n: node)
pt030_empty_or_null(n) :- pt030_empty_or_null_u7(n).

// positional(n): the JSON util `positional`, used where the JSON says `matches: "positional"`
.decl pt030_positional(n: node)
pt030_positional(n) :- node(_, n, _, _, _), !pt030_alt_5(n).

// pos0(n): the JSON util `pos0`, used where the JSON says `matches: "pos0"`
.decl pt030_pos0(n: node)
pt030_pos0(n) :- pt030_positional(n), !pt030_alt_6(n).

// keyword_named(n): the JSON util `keyword-named`, used where the JSON says `matches: "keyword-named"`
.decl pt030_keyword_named(n: node)
pt030_keyword_named(n) :- kind(n, "keyword_argument"), field(n, "name", c1),
    glob("expected_warning", c1),
    count : { precedes(s2, n), kind(s2, "keyword_argument"), field(s2, "name", c3), glob("expected_warning", c3) } = 0.

// unmatched_warns_args(n): the JSON util `unmatched-warns-args`, used where the JSON says `matches: "unmatched-warns-args"`
.decl pt030_unmatched_warns_args(n: node)
pt030_unmatched_warns_args(n) :- kind(n, "argument_list"), field(p1, "arguments", n),
    kind(p1, "call"), field(p1, "function", c2), pt030_warns_callee(c2),
    count : { child(n, c3, _), kind(c3, "keyword_argument"), field(c3, "name", c4), glob("match", c4), !pt030_alt_7(c3) } = 0.

// callable_args(n): the JSON util `callable-args`, used where the JSON says `matches: "callable-args"`
.decl pt030_callable_args(n: node)
pt030_callable_args(n) :- kind(n, "argument_list"), child(n, c1, _), pt030_positional(c1),
    precedes(s2, c1), pt030_positional(s2).

// in_callable_form(n): the JSON util `in-callable-form`, used where the JSON says `matches: "in-callable-form"`
.decl pt030_in_callable_form(n: node)
pt030_in_callable_form(n) :- child(p1, n, _), pt030_callable_args(p1).
pt030_in_callable_form(n) :- child(p2, n, _), kind(p2, "keyword_argument"), child(p3, p2, _),
    pt030_callable_args(p3).

// flagged_warning(n): the JSON util `flagged-warning`, used where the JSON says `matches: "flagged-warning"`
//   W: metavariable this relation binds for the calling rule
.decl pt030_flagged_warning(n: node, w: loc)
pt030_flagged_warning(n, W) :- pt030_broad_warning(n, W),
    ( field(p1, "value", n), pt030_keyword_named(p1), child(p2, p1, _), pt030_unmatched_warns_args(p2)
    ; pt030_pos0(n), child(p3, n, _), pt030_unmatched_warns_args(p3), count : { child(p3, c1, _), pt030_keyword_named(c1) } = 0
    ).


// ann_empty_or_null(n): the JSON util `ann-empty-or-null`, used where the JSON says `matches: "ann-empty-or-null"`
.decl pt030_ann_empty_or_null(n: node)
pt030_ann_empty_or_null(n) :- kind(n, "none").
pt030_ann_empty_or_null(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[tTfFbB]**", c1) } = 0,
    value(n, "").
pt030_ann_empty_or_null(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    pt030_ann_empty_or_null(c2).

// ann_keyword_named(n): the JSON util `ann-keyword-named`, used where the JSON says `matches: "ann-keyword-named"`
.decl pt030_ann_keyword_named(n: node)
pt030_ann_keyword_named(n) :- kind(n, "keyword_argument"), child(n, c1, _),
    kind(c1, "identifier"), glob("expected_warning", c1), pt030_tok_precedes_1(c1),
    count : { precedes(s9, n), kind(s9, "keyword_argument"), child(s9, c10, _), kind(c10, "identifier"), glob("expected_warning", c10), pt030_tok_precedes_2(c10) } = 0.

// ann_unmatched_args(n): the JSON util `ann-unmatched-args`, used where the JSON says `matches: "ann-unmatched-args"`
.decl pt030_ann_unmatched_args(n: node)
pt030_ann_unmatched_args(n) :- kind(n, "argument_list"), next_sibling(s1, n),
    pt030_warns_callee(s1),
    count : { child(n, c2, _), kind(c2, "keyword_argument"), child(c2, c3, _), kind(c3, "identifier"), glob("match", c3), pt030_tok_precedes_3(c3), !pt030_alt_9(c2) } = 0.

// ann_flagged_warning(n): the JSON util `ann-flagged-warning`, used where the JSON says `matches: "ann-flagged-warning"`
//   W: metavariable this relation binds for the calling rule
.decl pt030_ann_flagged_warning(n: node, w: loc)
pt030_ann_flagged_warning(n, W) :- pt030_broad_warning(n, W),
    ( pt030_tok_follows_7(n), child(p1, n, _), pt030_ann_keyword_named(p1), child(p2, p1, _), pt030_ann_unmatched_args(p2)
    ; pt030_pos0(n), child(p3, n, _), pt030_ann_unmatched_args(p3), count : { child(p3, c1, _), pt030_ann_keyword_named(c1) } = 0
    ).


// ann_string_context_manager(n): the JSON util `ann-string-context-manager`, used where the JSON says `matches: "ann-string-context-manager"`
//   W: metavariable this relation binds for the calling rule
.decl pt030_ann_string_context_manager(n: node, w: loc)
pt030_ann_string_context_manager(n, W) :- kind(n, "string"),
    count : { has(n, c1, "escape_sequence"), node(_, c1, _, _, _) } = 0,
    parsed(n, "annotation", r2), within(c3, r2), pt030_alt_11(c3, W).

// ann_string_callable(n): the JSON util `ann-string-callable`, used where the JSON says `matches: "ann-string-callable"`
//   W: metavariable this relation binds for the calling rule
.decl pt030_ann_string_callable(n: node, w: loc)
pt030_ann_string_callable(n, W) :- kind(n, "string"),
    count : { has(n, c1, "escape_sequence"), node(_, c1, _, _, _) } = 0,
    parsed(n, "annotation", r2), within(c3, r2), pt030_alt_12(c3, W).

// PT030(n): a finding at node n, from clause `context-manager-form`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PT030(at: node, w: node) "Give `pytest.warns({w})` a non-empty `match=` regex, or expect a more specific warning, so an unrelated warning cannot satisfy it."
    suppress noqa "PT030"
PT030(W, n) :- pt030_flagged_warning(n, W), !pt030_in_callable_form(n).
PT030(W, n) :- pt030_ann_string_context_manager(n, W).

// PT030_callable_form(n): a finding at node n, from clause `callable-form`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PT030_callable_form(at: node, w: node) code "PT030" "`pytest.warns({w}, func)` ignores `match=`; call the function inside `with pytest.warns({w}, match=...):` instead, or expect a more specific warning class."
    suppress noqa "PT030"
PT030_callable_form(W, n) :- pt030_flagged_warning(n, W), pt030_in_callable_form(n).
PT030_callable_form(W, n) :- pt030_ann_string_callable(n, W).

