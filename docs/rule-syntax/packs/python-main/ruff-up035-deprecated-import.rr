.policy "ruff-up035-deprecated-import" revision 1
.guests off
.description "Import names from the module that now provides them instead of a deprecated location, such as collections.abc rather than collections or typing."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// coll_abc_family(n, key): 8 copies of one rule set (`coll-abc`, `te-typing-311`, `te-typing-312` and 5 more), folded into one: row `key` of
// coll_abc_family_case gives the strings each copy had.
.decl up035_coll_abc_family(n: node, key: symbol)
up035_coll_abc_family(n, q1) :- up035_coll_abc_family_case(q1, s1), child(n, c1, _), up035_alt(c1, s1).

// up_to_te_typing_base(n): the JSON util `up-to-te-typing-base`, used where the JSON says `matches: "up-to-te-typing-base"`
.decl up035_up_to_te_typing_base(n: node)
up035_up_to_te_typing_base(n) :- up035_coll_abc_family(n, "te_typing_base").

