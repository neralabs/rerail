// The JSON `transform` computes LOWER from other metavariables' text; its literals end each rule.
// `options` carries JSON settings that have no .rr form yet.
.violation UP035_typing_builtin_generics(at: node, name: loc, lower: symbol) code "UP035" "`typing.{name}` is deprecated; use the built-in `{lower}` in annotations and drop the `typing` import once nothing else uses it."
    suppress noqa "UP035"
UP035_typing_builtin_generics(n, NAME, LOWER) :- kind(n, "import_from_statement"),
    field(n, "module_name", c2), kind(c2, "dotted_name"), glob("typing", c2),
    child(n, c3, _), up035_alt_of(c3, "23", NAME), text(NAME, t1),
    LOWER = @convert(t1, "lowerCase", "").

