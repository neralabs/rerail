// backports_strenum_family(n, key): 14 copies of one rule set (`backports-strenum`, `mypy-37`, `mypy-38` and 11 more), folded into one: row `key` of
// backports_strenum_family_case gives the strings each copy had.
.decl up035_backports_strenum_family(n: node, key: symbol)
up035_backports_strenum_family(n, q1) :- up035_backports_strenum_family_case(q1, s1),
    child(n, c1, _),
    ( kind(c1, "dotted_name"), glob(s1, c1), !child(_, c1, 0)
    ; kind(c1, "aliased_import"), child(c1, c2, _), kind(c2, "dotted_name"), glob(s1, c2)
    ).


// UP035(n, detail): findings from clauses `collections-to-abc`, `pipes-to-shlex`, `typing-extensions-to-typing`, `mypy-extensions-to-typing` and 1 more. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
.violation UP035(at: node, detail: symbol) "Import {detail}."
    suppress noqa "UP035"
UP035(n, "the abstract base classes from `collections.abc` instead of `collections`; names that live in `collections` (such as `Counter`) stay in the original import") :- kind(n, "import_from_statement"),
    field(n, "module_name", c1), kind(c1, "dotted_name"), glob("collections", c1),
    up035_coll_abc_family(n, "coll_abc").
UP035(n, "`quote` from `shlex` instead of the removed `pipes` module; names `shlex` lacks (such as `Template`) stay imported from `pipes`") :- kind(n, "import_from_statement"),
    field(n, "module_name", c1), kind(c1, "dotted_name"), glob("pipes", c1),
    up035_backports_strenum_family(n, "pipes_shlex").
UP035(n, "these names from `typing`, which provides them on this Python version; keep any names `typing` lacks imported from `typing_extensions`") :- kind(n, "import_from_statement"),
    field(n, "module_name", c1), kind(c1, "dotted_name"),
    glob("typing_extensions", c1), up035_coll_abc_family(n, "te_typing_base").
UP035(n, "these names from `typing` instead of `mypy_extensions`; keep any other names imported from `mypy_extensions`") :- kind(n, "import_from_statement"),
    field(n, "module_name", c1), kind(c1, "dotted_name"), glob("mypy_extensions", c1),
    up035_backports_strenum_family(n, "mypy_37").
UP035(n, "these names from `typing` instead of the `typing.io` namespace; keep any other names imported from `typing.io`") :- kind(n, "import_from_statement"),
    field(n, "module_name", c1), kind(c1, "dotted_name"),
    match("typing\\s*\\.\\s*io", c1), up035_backports_strenum_family(n, "typing_io").

// UP035_typing_extensions_to_types_312(n, detail): findings from clauses `typing-extensions-to-collections-abc`, `typing-extensions-to-types-312`, `typing-extensions-to-typing-312`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
