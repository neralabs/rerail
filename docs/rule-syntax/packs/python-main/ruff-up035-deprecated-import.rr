.decl up035_up_to_te_typing_38(n: node)
up035_up_to_te_typing_38(n) :- up035_coll_abc_family(n, "te_typing_base").
up035_up_to_te_typing_38(n) :- up035_backports_strenum_family(n, "te_typing_38").

