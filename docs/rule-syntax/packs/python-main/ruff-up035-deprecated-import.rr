.decl UP035_typing_extensions_to_warnings_raw(at: node, detail: symbol)

// pythonVersion {"min": "3.11"} excludes Python 3.10, main's default: no findings.
.decl UP035_backports_strenum_to_enum_raw(at: node, detail: symbol)

// pythonVersion {"max": "3.8"} excludes Python 3.10, main's default: no findings.
.decl UP035_typing_re_to_typing_raw(at: node)
