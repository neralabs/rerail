up035_coll_abc_family_case("te_typing_312", "12").
up035_coll_abc_family_case("te_typing_313", "13").
up035_coll_abc_family_case("te_typing_base", "7").
up035_coll_abc_family_case("typing_abc_39", "19"). up035_coll_abc_family_case("typing_re", "17").
up035_coll_abc_family_case("typing_re_39", "17").

// alt(n, key): 7 copies of one rule set (`alt_1`, `alt_11`, `alt_12` and 4 more), folded into one: row `key` of
// alt_case gives the strings each copy had.
.decl up035_alt(n: node, key: symbol)
up035_alt(n, q1) :- up035_alt_case(q1, s1), kind(n, "dotted_name"), glob(s1, n), !child(_, n, 0).
up035_alt(n, q1) :- up035_alt_case(q1, s1), kind(n, "aliased_import"), child(n, c1, _),
    kind(c1, "dotted_name"), glob(s1, c1).

// alt_of(n, key): 6 copies of one rule set (`alt_23`, `alt_24`, `alt_25` and 3 more), folded into one: row `key` of
// alt_of_case gives the strings each copy had.
//   NAME: metavariable this relation binds for the calling rule
.decl up035_alt_of(n: node, key: symbol, name: loc)
up035_alt_of(n, q1, NAME) :- up035_alt_of_case(q1, s1), kind(n, "dotted_name"), glob(s1, n),
    node(_, n, _, _, _), NAME = n, !child(_, n, 0).
up035_alt_of(n, q1, NAME) :- up035_alt_of_case(q1, s1), kind(n, "aliased_import"), child(n, c1, _),
    kind(c1, "dotted_name"), glob(s1, c1), node(_, c1, _, _, _), NAME = c1.

// pythonVersion {"min": "3.12"} excludes Python 3.10, main's default: no findings.
.decl UP035_typing_extensions_to_types_312_raw(at: node, detail: symbol)

