UP035_typing_extensions_to_types_312_raw(n, "`Buffer` from `collections.abc`, which provides it on this Python version; keep any other names") :- kind(n, "import_from_statement"),
    field(n, "module_name", c1), kind(c1, "dotted_name"),
    glob("typing_extensions", c1), up035_backports_strenum_family(n, "te_abc").
UP035_typing_extensions_to_types_312_raw(n, "these names from `types`, which provides them on this Python version; keep any other names") :- kind(n, "import_from_statement"),
    field(n, "module_name", c1), kind(c1, "dotted_name"),
    glob("typing_extensions", c1), up035_backports_strenum_family(n, "te_types_312").
UP035_typing_extensions_to_types_312_raw(n, "these names from `typing`, which provides them on this Python version; keep any names `typing` lacks") :- kind(n, "import_from_statement"),
    field(n, "module_name", c1), kind(c1, "dotted_name"),
    glob("typing_extensions", c1), up035_coll_abc_family(n, "te_typing_312"),
    !up035_up_to_te_typing_311(n).

