.policy "ruff-up029-unnecessary-builtin-import" revision 1
.guests off
.description "Remove imports of Python 3 builtins from compatibility shims such as builtins, six and io; the names are already available without importing."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// UP029(n): a finding at node n, from clause `unnecessary-builtin-import`.
// Each rule below is one way the JSON `rule` can match.
.violation UP029(at: node) "Remove the names Python 3 already provides as builtins from this import, and the whole statement if nothing else remains. Keep it only if the code must still run on Python 2."
    suppress noqa "UP029"
UP029(n) :- kind(n, "import_from_statement"), up029_alt_10(n).

// shadowed(n): the JSON util `shadowed`, used where the JSON says `matches: "shadowed"`
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl up029_shadowed(n: node, n_mv: loc)
up029_shadowed(n, N) :- up029_demand_shadowed(n, N), within_stop(n, p1, up029_stop_1), precedes(s2, p1),
    up029_alt_4(s2, N).
up029_shadowed(n, N) :- up029_demand_shadowed(n, N),
    (precedes(n, s1), up029_alias_binding(s1, N) ; precedes(s2, n), up029_alias_binding(s2, N)).

// alias_binding(n): the JSON util `alias-binding`, used where the JSON says `matches: "alias-binding"`
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl up029_alias_binding(n: node, n_mv: loc)
up029_alias_binding(n, N) :- up029_demand_alias_binding(n, N), up029_tok_follows_4(n), up029_alt_8(n, N).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up029_tok_has_1(n: node)
.stored up029_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up029_tok_has_1(n) :- child(n, c13, _), glob("=", c13).
up029_tok_has_1(n) :- op(n, t14), match("=", t14).
up029_tok_has_1(n) :- child(n, c20, _), structural_before(c20, g15),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g15).
up029_tok_has_1(n) :- child(n, c20, _), structural_after(c20, g15),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g15).
up029_tok_has_1(n) :- node_text(n, g15), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g15).

