up029_tok_follows_7(n) :- precedes(s13, n), glob("import", s13).
up029_tok_follows_7(n) :- child(p16, n, _), node(_, n, _, st18, _),
    token(p16, _, t14, _, en19), en19 <= st18, match("import", t14).
up029_tok_follows_7(n) :- structural_before(n, g15),
