up029_tok_follows_9(n) :- precedes(s31, n), glob("import", s31).
up029_tok_follows_9(n) :- child(p34, n, _), node(_, n, _, st36, _),
    token(p34, _, t32, _, en37), en37 <= st36, match("import", t32).
up029_tok_follows_9(n) :- structural_before(n, g33),
    match("(?s)^(?:(?:.*\\W)?(?:import)(?:\\W.*)?)$", g33).
up029_tok_follows_9(n) :- precedes(o35, n), structural_before(o35, g33),
