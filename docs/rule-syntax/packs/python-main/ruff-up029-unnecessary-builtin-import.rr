// demand_shadowed: the rows of shadowed its callers ask for (the metavariable columns they pass in)
.decl up029_demand_shadowed(n: node, n_mv: loc)
up029_demand_shadowed(c2, N) :- child(n, c2, _), kind(c2, "dotted_name"),
    glob("{ascii,bytes,chr,dict,filter,hex,input,int,isinstance,list,map,max,min,next,object,oct,open,pow,range,round,str,super,zip}", c2),
    node(_, c2, _, _, _), N = c2, up029_tok_follows_6(c2).
up029_demand_shadowed(c12, N) :- field(n, "module_name", c11), kind(c11, "dotted_name"),
    glob("io", c11), child(n, c12, _), kind(c12, "dotted_name"), glob("open", c12),
    node(_, c12, _, _, _), N = c12, up029_tok_follows_7(c12).
up029_demand_shadowed(c21, N) :- field(n, "module_name", c20), kind(c20, "dotted_name"),
    glob("six", c20), child(n, c21, _), kind(c21, "dotted_name"),
    glob("{callable,next}", c21), node(_, c21, _, _, _), N = c21, up029_tok_follows_8(c21).
up029_demand_shadowed(c30, N) :- field(n, "module_name", c29), kind(c29, "dotted_name"),
    match("(six\\s*\\.\\s*moves)", c29), child(n, c30, _), kind(c30, "dotted_name"),
    glob("{filter,input,map,range,zip}", c30), node(_, c30, _, _, _), N = c30, up029_tok_follows_9(c30).

// demand_alias_binding: the rows of alias_binding its callers ask for (the metavariable columns they pass in)
.decl up029_demand_alias_binding(n: node, n_mv: loc)
up029_demand_alias_binding(s1, N) :- up029_demand_shadowed(n, N), precedes(n, s1).
up029_demand_alias_binding(s2, N) :- up029_demand_shadowed(n, N), precedes(s2, n).

// demand_alt_4: the rows of alt_4 its callers ask for (the metavariable columns they pass in)
.decl up029_demand_alt_4(n: node, n_mv: loc)
up029_demand_alt_4(s2, N) :- up029_demand_shadowed(n, N), within_stop(n, p1, up029_stop_1),
    precedes(s2, p1).

// demand_alt_3: the rows of alt_3 its callers ask for (the metavariable columns they pass in)
.decl up029_demand_alt_3(n: node, n_mv: loc)
up029_demand_alt_3(c4, N) :- up029_demand_alt_4(n, N), within_stop(c4, n, up029_stop_2).

// demand_alt_8: the rows of alt_8 its callers ask for (the metavariable columns they pass in)
.decl up029_demand_alt_8(n: node, n_mv: loc)
up029_demand_alt_8(n, N) :- up029_demand_alias_binding(n, N), up029_tok_follows_4(n).

// stop_2: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl up029_stop_2(kind: symbol)
up029_stop_2("function_definition"). up029_stop_2("class_definition"). up029_stop_2("lambda").
up029_stop_2("list_comprehension"). up029_stop_2("set_comprehension").
up029_stop_2("dictionary_comprehension"). up029_stop_2("generator_expression").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl up029_stop_1(n: node)
up029_stop_1(n) :- kind(n, "module").
up029_stop_1(n) :- kind(n, "block"), child(p1, n, _),
    (kind(p1, "function_definition") ; kind(p1, "class_definition")).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl up029_alt_3(n: node, n_mv: loc)
up029_alt_3(n, N) :- up029_demand_alt_3(n, N),
    (kind(n, "function_definition") ; kind(n, "class_definition")),
    field(n, "name", c1), kind(c1, "identifier"), node(_, c1, _, _, _), J = c1, text(J, t2), text(N, t2), @doc(J) = @doc(N).
up029_alt_3(n, N) :- up029_demand_alt_3(n, N), (kind(n, "identifier") ; kind(n, "dotted_name")),
    node(_, n, _, _, _), J = n, (bind_only(n) ; aug_target(n)), text(J, t4), text(N, t4),
    count : { child(p6, n, _), kind(p6, "assignment"), !up029_tok_has_2(p6) } = 0, @doc(J) = @doc(N).
up029_alt_3(n, N) :- up029_demand_alt_3(n, N), kind(n, "identifier"), node(_, n, _, _, _), J = n,
    text(J, t15), text(N, t15), child(p17, n, _),
    (kind(p17, "global_statement") ; kind(p17, "nonlocal_statement")), @doc(J) = @doc(N).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl up029_alt_4(n: node, n_mv: loc)
up029_alt_4(n, N) :- up029_demand_alt_4(n, N),
    (kind(n, "function_definition") ; kind(n, "class_definition")),
    field(n, "name", c1), kind(c1, "identifier"), node(_, c1, _, _, _), J = c1, text(J, t2), text(N, t2), @doc(J) = @doc(N).
up029_alt_4(n, N) :- up029_demand_alt_4(n, N), within_stop(c4, n, up029_stop_2), up029_alt_3(c4, N),
    !kind(n, "type_parameter").

// alt_8(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl up029_alt_8(n: node, n_mv: loc)
up029_alt_8(n, N) :- up029_demand_alt_8(n, N), kind(n, "dotted_name"), node(_, n, _, _, _), J = n,
    text(J, t1), text(N, t1), @doc(J) = @doc(N).
up029_alt_8(n, N) :- up029_demand_alt_8(n, N), kind(n, "aliased_import"), field(n, "alias", c3),
    node(_, c3, _, _, _), J = c3, text(J, t4), text(N, t4), @doc(J) = @doc(N).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl up029_alt_11(n: node)
up029_alt_11(n) :- child(n, c1, _), kind(c1, "wildcard_import").
up029_alt_11(n) :- child(n, c2, _), kind(c2, "dotted_name"),
    glob("{ascii,bytes,chr,dict,filter,hex,input,int,isinstance,list,map,max,min,next,object,oct,open,pow,range,round,str,super,zip}", c2),
    node(_, c2, _, _, _), N = c2, up029_tok_follows_6(c2), !up029_shadowed(c2, N).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl up029_alt_10(n: node)
up029_alt_10(n) :- field(n, "module_name", c1), kind(c1, "dotted_name"),
    match("(builtins|six\\s*\\.\\s*moves\\s*\\.\\s*builtins)", c1), up029_alt_11(n).
up029_alt_10(n) :- field(n, "module_name", c11), kind(c11, "dotted_name"), glob("io", c11),
    child(n, c12, _), kind(c12, "dotted_name"), glob("open", c12), node(_, c12, _, _, _), N = c12,
    up029_tok_follows_7(c12), !up029_shadowed(c12, N).
up029_alt_10(n) :- field(n, "module_name", c20), kind(c20, "dotted_name"), glob("six", c20),
    child(n, c21, _), kind(c21, "dotted_name"), glob("{callable,next}", c21),
    node(_, c21, _, _, _), N = c21, up029_tok_follows_8(c21), !up029_shadowed(c21, N).
up029_alt_10(n) :- field(n, "module_name", c29), kind(c29, "dotted_name"),
    match("(six\\s*\\.\\s*moves)", c29), child(n, c30, _), kind(c30, "dotted_name"),
    glob("{filter,input,map,range,zip}", c30), node(_, c30, _, _, _), N = c30, up029_tok_follows_9(c30),
    !up029_shadowed(c30, N).
