// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "^import$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up029_tok_follows_4(n: node)
.stored up029_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up029_tok_follows_4(n) :- precedes(s1, n), glob("import", s1).
up029_tok_follows_4(n) :- child(p4, n, _), node(_, n, _, st6, _), token(p4, _, t2, _, en7),
    en7 <= st6, match("import", t2).
up029_tok_follows_4(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*\\W)?(?:import)(?:\\W.*)?)$", g3).
up029_tok_follows_4(n) :- precedes(o5, n), structural_before(o5, g3),
    match("(?s)^(?:(?:.*\\W)?(?:import)(?:\\W.*)?)$", g3).

