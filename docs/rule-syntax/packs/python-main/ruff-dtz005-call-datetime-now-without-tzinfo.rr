.policy "ruff-dtz005-call-datetime-now-without-tzinfo" revision 1
.guests off
.description "Pass a real timezone to datetime.now; without one, or with None, it returns a naive local time with no zone information."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
.decl dtz005_callee(n: node)
dtz005_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "datetime.datetime.now").
dtz005_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), dtz005_callee(c1).

// astz_safe(n): the JSON util `astz-safe`, used where the JSON says `matches: "astz-safe"`
.decl dtz005_astz_safe(n: node)
dtz005_astz_safe(n) :- within_stop(n, p1, dtz005_stop_1), kind(p1, "attribute"), dtz005_alt_3(p1).

// none_lit(n): the JSON util `none-lit`, used where the JSON says `matches: "none-lit"`
.decl dtz005_none_lit(n: node)
dtz005_none_lit(n) :- kind(n, "none").
dtz005_none_lit(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), dtz005_none_lit(c1).

// DTZ005(n, detail): findings from clauses `no-tz`, `tz-none`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// The JSON `constraints` on TZ are added to every rule.
.violation DTZ005(at: node, detail: symbol) "{detail} only where a naive local time is required."
    suppress noqa "DTZ005"
DTZ005(n, "Pass `tz=` with the zone you mean, such as `datetime.now(tz=datetime.timezone.utc)`, so the result is aware. Leave `now()` bare") :- kind(n, "call"),
    field(n, "function", c1), dtz005_callee(c1), !dtz005_astz_safe(n), dtz005_arg_no_tz_1(n).
DTZ005(n, "Replace `tz=None` with the zone you mean, such as `tz=datetime.timezone.utc`, so the result is aware. Keep `None`") :- kind(n, "call"),
    field(n, "function", c1), dtz005_callee(c1), !dtz005_astz_safe(n), dtz005_arg_tz_1(n, a2), TZ = a2,
    dtz005_none_lit(TZ).

// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl dtz005_args_plain(l: node, a: node, i: number)
dtz005_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl dtz005_args_splat(l: node, i: number)
dtz005_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl dtz005_args_pos(l: node, a: node, j: number)
dtz005_args_pos(l, a, j) :- dtz005_args_plain(l, a, i), count : { dtz005_args_splat(l, k), k < i } = 0,
    j = count : { dtz005_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl dtz005_args_star(l: node, j: number)
dtz005_args_star(l, j) :- dtz005_args_splat(l, i), count : { dtz005_args_splat(l, k), k < i } = 0,
    j = count : { dtz005_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl dtz005_args_kwp(l: node, k: symbol, v: node)
dtz005_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl dtz005_args_lit_dict(s: node, d: node)
dtz005_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !dtz005_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl dtz005_args_str_pair(p: node)
dtz005_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl dtz005_args_kw(l: node, k: symbol, v: node)
dtz005_args_kw(l, k, v) :- dtz005_args_kwp(l, k, v).
dtz005_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), dtz005_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl dtz005_args_kw_spread(l: node)
dtz005_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !dtz005_args_lit_dict(s, _).

// arg_tz_1: call n passes v for slot `tz` of (tz), syntactic: Ruff's find_argument
.decl dtz005_arg_tz_1(n: node, v: node)
dtz005_arg_tz_1(n, v) :- kind(n, "call"), field(n, "arguments", l), dtz005_args_kwp(l, "tz", v).
dtz005_arg_tz_1(n, v) :- kind(n, "call"), field(n, "arguments", l), dtz005_args_pos(l, v, 0),
    !dtz005_args_kwp(l, "tz", _).
dtz005_arg_tz_1(n, v) :- kind(n, "call"), field(n, "arguments", v),
    kind(v, "generator_expression").

// arg_no_tz_1: call n does not pass slot `tz` of (tz), syntactic: Ruff's find_argument
.decl dtz005_arg_no_tz_1(n: node)
dtz005_arg_no_tz_1(n) :- kind(n, "call"), field(n, "arguments", l), !dtz005_args_kwp(l, "tz", _),
    !dtz005_args_pos(l, _, 0), !kind(l, "generator_expression").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl dtz005_stop_1(n: node)
dtz005_stop_1(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl dtz005_alt_3(n: node)
dtz005_alt_3(n) :- field(n, "attribute", c1), glob("astimezone", c1).
dtz005_alt_3(n) :- field(n, "attribute", c2), glob("replace", c2), within_stop(n, p3, dtz005_stop_1),
    kind(p3, "call"), dtz005_astz_safe(p3).
