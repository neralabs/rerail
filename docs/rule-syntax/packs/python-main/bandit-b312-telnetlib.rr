.policy "bandit-b312-telnetlib" revision 1
.guests off
.description "Avoid opening telnetlib.Telnet connections; Telnet sends credentials and data unencrypted, so use SSH or another encrypted protocol."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// B312(n): a finding at node n, from clause `bandit:B312`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on F are added to every rule.
.violation B312(at: node) "Telnet is insecure; use SSH or another encrypted protocol."
    suppress nosec "B312"
B312(n) :- n ~ `$F($$$ARGS)`, sym_of(F, "telnetlib.Telnet").
