.decl pie810_tuple_init(n: node)
pie810_tuple_init(n) :- pie810_tuple_expr(n).
pie810_tuple_init(n) :- kind(n, "call"), child(n, c1, _), pie810_tuple_callee(c1),
    next_sibling(c1, s2),
