.stored pie810_tok_follows_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pie810_tok_follows_6(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
pie810_tok_follows_6(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
pie810_tok_follows_6(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_precedes_7(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pie810_tok_precedes_7(n: node)
.stored pie810_tok_precedes_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pie810_tok_precedes_7(n) :- precedes(n, s12), glob("as", s12).
pie810_tok_precedes_7(n) :- child(p15, n, _), node(_, n, _, _, en18),
    token(p15, _, t13, st17, _), st17 >= en18, match("as", t13).
pie810_tok_precedes_7(n) :- structural_after(n, g14),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g14).
pie810_tok_precedes_7(n) :- precedes(n, o16), structural_after(o16, g14),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g14).

// tok_precedes_8(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pie810_tok_precedes_8(n: node)
.stored pie810_tok_precedes_8 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pie810_tok_precedes_8(n) :- precedes(n, s11), glob("as", s11).
pie810_tok_precedes_8(n) :- child(p14, n, _), node(_, n, _, _, en17),
    token(p14, _, t12, st16, _), st16 >= en17, match("as", t12).
pie810_tok_precedes_8(n) :- structural_after(n, g13),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g13).
pie810_tok_precedes_8(n) :- precedes(n, o15), structural_after(o15, g13),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g13).

// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl pie810_alt_1_u0_empty(n: node)

// alt_2_u0_empty: level -1 of an unrolled recursion, empty
.decl pie810_alt_2_u0_empty(n: node)

// tuple_expr_u0_empty: level -1 of an unrolled recursion, empty
.decl pie810_tuple_expr_u0_empty(n: node)

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pie810_alt_1(n: node)
pie810_alt_1(n) :- pie810_alt_1_u7(n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pie810_alt_2(n: node)
pie810_alt_2(n) :- pie810_alt_2_u7(n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl pie810_alt_4(n: node)
pie810_alt_4(n) :- ref_site(n, b1), site_stop_at_global(b1),
    ( kind(b1, "list_splat_pattern"), child(p1, b1, _), kind(p1, "parameters")
    ; kind(b1, "typed_parameter"), child(p2, b1, _), kind(p2, "parameters"), child(b1, c1, _), kind(c1, "list_splat_pattern")
    ).

pie810_alt_4(n) :- ref_site(n, b5), site_stop_at_global(b5), binding_value(b5, x6),
    pie810_tuple_init(x6), count : { child(b5, c7, _), kind(c7, "type") } = 0.
pie810_alt_4(n) :- ref_site(n, b8), site_stop_at_global(b8), kind(b8, "as_pattern"),
    child(p9, b8, _), kind(p9, "with_item"), child(b8, c10, _), pie810_tuple_init(c10),
    pie810_tok_precedes_8(c10), child(b8, c18, _), kind(c18, "as_pattern_target"),
    child(c18, c19, _), pie810_plain_target(c19).
pie810_alt_4(n) :- ref_site(n, b20), site_annotation(b20, o21), pie810_tuple_ann(o21),
    count : { child(b20, c22, _), (kind(c22, "list_splat_pattern") ; kind(c22, "dictionary_splat_pattern")) } = 0.
pie810_alt_4(n) :- ref_site(n, b23), kind(b23, "function_definition"), child(b23, c24, _),
    kind(c24, "type"), child(c24, c25, _), pie810_tuple_ann(c25).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl pie810_alt_6(n: node)
pie810_alt_6(n) :- (kind(n, "keyword_argument") ; kind(n, "dictionary_splat")).
pie810_alt_6(n) :- pie810_tuple_bound(n).

// stop_10(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl pie810_stop_10(n: node)
pie810_stop_10(n) :- node(_, n, _, _, _), !pie810_or_op(n).

// stop_10_within: within_stop over the stop set stop_10, read inside an aggregate
.decl pie810_stop_10_within(n: node, a: node)
pie810_stop_10_within(x, y) :- within_stop(x, y, pie810_stop_10).
