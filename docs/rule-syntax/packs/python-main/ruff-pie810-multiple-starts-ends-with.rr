.policy "ruff-pie810-multiple-starts-ends-with" revision 1
.guests off
.description "Pass a tuple to one startswith() or endswith() call instead of or-ing several calls on the same string."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PIE810(n): a finding at node n, from clause `multiple-starts-ends-with`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PIE810(at: node, first: loc, m: loc) "Call `{m}` once with a tuple of all the prefixes or suffixes instead of or-ing several calls."
    suppress noqa "PIE810"
PIE810(n, FIRST, M) :- kind(n, "boolean_operator"), pie810_or_op(n),
    count : { child(p1, n, _), pie810_or_op(p1) } = 0, within_stop(c2, n, pie810_stop_10),
    count : { pie810_or_op(c2) } = 0, count : { precedes(s1_2, c2), (!pie810_or_op(s1_2), pie810_affix_call(s1_2, M, R) ; pie810_or_op(s1_2), pie810_stop_10_within(c1_2, s1_2), !pie810_or_op(c1_2), pie810_affix_call(c1_2, M, R)) } = 0,
    pie810_affix_call(c2, M, R), node(_, c2, _, _, _), FIRST = c2, within_stop(c2, p5, pie810_stop_10), pie810_or_op(p5),
    count : { child(p6, p5, _), pie810_or_op(p6) } = 0, within_stop(c7, p5, pie810_stop_10),
    !pie810_or_op(c7), pie810_affix_call(c7, M, R), node(_, c7, _, _, _), SECOND = c7,
    text(SECOND, t8), text(FIRST, t9), t8 != t9.

