.policy "ruff-d411-no-blank-line-before-section" revision 1
.guests off
.description "Put a blank line before each docstring section header, such as Args or Returns, to separate it from the text above."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// doc_stmt(n): the JSON util `doc-stmt`, used where the JSON says `matches: "doc-stmt"`
.decl d411_doc_stmt(n: node)
d411_doc_stmt(n) :- kind(n, "expression_statement"), !d411_alt_1(n),
    ( child(p1, n, _), kind(p1, "module")
    ; child(p2, n, _), kind(p2, "block"), child(p3, p2, _), (kind(p3, "function_definition") ; kind(p3, "class_definition"))
    ).


// doc_holder(n): the JSON util `doc-holder`, used where the JSON says `matches: "doc-holder"`
.decl d411_doc_holder(n: node)
d411_doc_holder(n) :- d411_doc_stmt(n).
d411_doc_holder(n) :- kind(n, "parenthesized_expression"), child(p1, n, _), d411_doc_holder(p1).

// docstring(n): the JSON util `docstring`, used where the JSON says `matches: "docstring"`
.decl d411_docstring(n: node)
d411_docstring(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0,
    child(p2, n, _), d411_doc_holder(p2).

// numpy_mode(n): the JSON util `numpy-mode`, used where the JSON says `matches: "numpy-mode"`
.decl d411_numpy_mode(n: node)
d411_numpy_mode(n) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:other param(?:eters|s)|parameters)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:other param(?:eters|s)|parameters)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n).
d411_numpy_mode(n) :- !match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:arg(?:s|uments)|keyword arg(?:s|uments)|other arg(?:s|uments))):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:arg(?:s|uments)|keyword arg(?:s|uments)|other arg(?:s|uments))):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n),
    match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n),
    d411_alt_4(n).

// underlined(n): the JSON util `underlined`, used where the JSON says `matches: "underlined"`
.decl d411_underlined(n: node)
d411_underlined(n) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)\\n[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|x(?:amples?|tended summary))|hint|important|keyword arg(?:s|uments)|methods|notes?|other (?:arg(?:s|uments)|param(?:eters|s))|parameters|r(?:aises|e(?:ceives|ferences|turns?))|s(?:ee also|hort summary)|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$\\n[^\\S\\n]*-+[^\\S\\n]*$(?s:.*)", n).

// directive_hides_header(n): the JSON util `directive-hides-header`, used where the JSON says `matches: "directive-hides-header"`
.decl d411_directive_hides_header(n: node)
d411_directive_hides_header(n) :- child(p1, n, _), kind(p1, "string"),
    value(p1, v2), match("(?s:.*)\\n([^\\S\\n]*)\\.\\.[ ][^\\n]*(?:\\n(?:[^\\S\\n]*|\\1[^\\S\\n]+[^\\n]*))*\\n\\1[^\\S\\n]+(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|x(?:amples?|tended summary))|hint|important|keyword arg(?:s|uments)|methods|notes?|other (?:arg(?:s|uments)|param(?:eters|s))|parameters|r(?:aises|e(?:ceives|ferences|turns?))|s(?:ee also|hort summary)|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*(?:\\n|\\z)(?s:.*)", v2).

// D411(n): findings from clauses `no-blank-line-before-section-numpy`, `no-blank-line-before-section-google`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation D411(at: node, n: node) "Add a blank line before the `{n}` section so it is separated from the text above."
    suppress noqa "D411"
D411(N, n) :- kind(n, "string_content"), child(p1, n, _), d411_docstring(p1), d411_alt_6(n, N),
    d411_numpy_mode(n), !d411_directive_hides_header(n).
D411(N, n) :- kind(n, "string_content"), child(p1, n, _), d411_docstring(p1), d411_alt_7(n, N),
    !d411_numpy_mode(n), !d411_directive_hides_header(n).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d411_tok_has_1(n: node)
.stored d411_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d411_tok_has_1(n) :- child(n, c1, _), glob("\\,", c1).
d411_tok_has_1(n) :- op(n, t2), match(",", t2).
d411_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d411_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d411_tok_has_1(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl d411_alt_1(n: node)
d411_alt_1(n) :- d411_tok_has_1(n).
d411_alt_1(n) :- precedes(s9, n), !kind(s9, "comment").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl d411_alt_3(n: node)
d411_alt_3(n) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n).
d411_alt_3(n) :- d411_underlined(n).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl d411_alt_4(n: node)
d411_alt_4(n) :- node(_, n, _, _, _),
    !match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n).
d411_alt_4(n) :- !match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:attention|caution|danger|e(?:rror|xample)|hint|important|note|return|t(?:ip|odo)|warning|yield)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n),
    d411_alt_3(n).
d411_alt_4(n) :- match("(?m)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?s:.*)", n),
    d411_underlined(n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable this relation binds for the calling rule
.decl d411_alt_6(n: node, n_mv: loc)
d411_alt_6(n, N) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?P<N>(?:A(?i:ttributes)|E(?i:x(?:amples|tended summary))|M(?i:ethods)|N(?i:otes)|O(?i:ther param(?:eters|s))|P(?i:arameters)|R(?i:(?:aises|e(?:ceives|ferences|turns)))|S(?i:(?:ee also|hort summary))|W(?i:arn(?:ings|s))|Y(?i:ields))):?[^\\S\\n]*$(?s:.*)", n).
d411_alt_6(n, N) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)\\S[^\\S\\n]*\\n[^\\S\\n]*(?P<N>(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields))):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$(?s:.*)", n).
d411_alt_6(n, N) :- node(_, n, _, _, _),
    match("(?m)(?s:.*?)(?:(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*)(?P<N>(?:a(?i:ttributes)|e(?i:x(?:amples|tended summary))|m(?i:ethods)|n(?i:otes)|o(?i:ther param(?:eters|s))|p(?i:arameters)|r(?i:(?:aises|e(?:ceives|ferences|turns)))|s(?i:(?:ee also|hort summary))|w(?i:arn(?:ings|s))|y(?i:ields))):?[^\\S\\n]*$(?:\\z|\\n[^\\S\\n]*$|\\n[^\\n]*[^\\s\\-=])|(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$|\\n[^\\S\\n]*(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$))(?s:.*)", n).

// alt_7(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable this relation binds for the calling rule
.decl d411_alt_7(n: node, n_mv: loc)
d411_alt_7(n, N) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?P<N>(?:A(?i:(?:rg(?:s|uments)|tt(?:ention|ributes)))|C(?i:aution)|D(?i:anger)|E(?i:(?:rror|xamples?))|H(?i:int)|I(?i:mportant)|K(?i:eyword arg(?:s|uments))|M(?i:ethods)|N(?i:otes?)|O(?i:ther arg(?:s|uments))|R(?i:(?:aises|e(?:ferences|turns?)))|S(?i:ee also)|T(?i:(?:ip|odo))|W(?i:arn(?:ings?|s))|Y(?i:ields?))):?[^\\S\\n]*$(?s:.*)", n).
d411_alt_7(n, N) :- node(_, n, _, _, _),
    match("(?m)(?s:.*)\\S[^\\S\\n]*\\n[^\\S\\n]*(?P<N>(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|xamples?)|hint|important|keyword arg(?:s|uments)|methods|notes?|other arg(?:s|uments)|r(?:aises|e(?:ferences|turns?))|see also|t(?:ip|odo)|warn(?:ings?|s)|yields?))):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$(?s:.*)", n).
d411_alt_7(n, N) :- node(_, n, _, _, _),
    match("(?m)(?s:.*?)(?:(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*)(?P<N>(?:a(?i:(?:rg(?:s|uments)|tt(?:ention|ributes)))|c(?i:aution)|d(?i:anger)|e(?i:(?:rror|xamples?))|h(?i:int)|i(?i:mportant)|k(?i:eyword arg(?:s|uments))|m(?i:ethods)|n(?i:otes?)|o(?i:ther arg(?:s|uments))|r(?i:(?:aises|e(?:ferences|turns?)))|s(?i:ee also)|t(?i:(?:ip|odo))|w(?i:arn(?:ings?|s))|y(?i:ields?))):?[^\\S\\n]*$(?:\\z|\\n[^\\S\\n]*$|\\n[^\\n]*[^\\s\\-=])|(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|xamples?)|hint|important|keyword arg(?:s|uments)|methods|notes?|other arg(?:s|uments)|r(?:aises|e(?:ferences|turns?))|see also|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$|\\n[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|xamples?)|hint|important|keyword arg(?:s|uments)|methods|notes?|other arg(?:s|uments)|r(?:aises|e(?:ferences|turns?))|see also|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$))(?s:.*)", n).
