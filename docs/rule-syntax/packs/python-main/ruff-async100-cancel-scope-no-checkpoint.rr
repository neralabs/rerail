// set_2: symbols from the JSON `resolves.import`
.decl async100_set_2(v: symbol)
async100_set_2("asyncio.timeout"). async100_set_2("asyncio.timeout_at"). async100_set_2("anyio.move_on_after").
async100_set_2("anyio.fail_after"). async100_set_2("anyio.CancelScope"). async100_set_2("trio.move_on_after").
async100_set_2("trio.move_on_at"). async100_set_2("trio.fail_after"). async100_set_2("trio.fail_at").
