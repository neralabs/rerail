// stop_6: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl async100_stop_6(kind: symbol)
async100_stop_6("function_definition"). async100_stop_6("class_definition").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl async100_stop_1(n: node)
async100_stop_1(n) :- async100_scope_body(n).
async100_stop_1(n) :- async100_lambda_body(n).

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl async100_alt_7(n: node)
async100_alt_7(n) :- has(n, c1, "yield"), !async100_tok_has_7(c1).
