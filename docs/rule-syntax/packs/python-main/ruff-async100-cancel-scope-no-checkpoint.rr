async100_tok_follows_1(n) :- precedes(s2, n), glob(":", s2).
async100_tok_follows_1(n) :- child(p5, n, _), node(_, n, _, st7, _), token(p5, _, t3, _, en8),
    en8 <= st7, match(":", t3).
async100_tok_follows_1(n) :- structural_before(n, g4),
