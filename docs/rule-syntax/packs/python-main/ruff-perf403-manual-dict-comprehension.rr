// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf403_tok_follows_4(n: node)
.stored perf403_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf403_tok_follows_4(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
perf403_tok_follows_4(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
perf403_tok_follows_4(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_precedes_5(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf403_tok_precedes_5(n: node)
.stored perf403_tok_precedes_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf403_tok_precedes_5(n) :- next_sibling(n, s17), glob("as", s17).
perf403_tok_precedes_5(n) :- structural_after(n, g19), match("\\s*", g19), child(p20, n, _),
    node(_, n, _, _, en23), o21 = en23 + strlen(g19), token(p20, _, t18, o21, _),
    match("as", t18).
perf403_tok_precedes_5(n) :- structural_after(n, g19),
    match("(?s)^(?:\\s*(?:as)(?:\\W.*)?)$", g19).

// tok_precedes_6(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf403_tok_precedes_6(n: node)
.stored perf403_tok_precedes_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf403_tok_precedes_6(n) :- next_sibling(n, s2), glob("as", s2).
perf403_tok_precedes_6(n) :- structural_after(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, _, en8), o6 = en8 + strlen(g4), token(p5, _, t3, o6, _),
    match("as", t3).
perf403_tok_precedes_6(n) :- structural_after(n, g4),
    match("(?s)^(?:\\s*(?:as)(?:\\W.*)?)$", g4).

// tok_has_7(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf403_tok_has_7(n: node)
.stored perf403_tok_has_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf403_tok_has_7(n) :- child(n, c7, _), glob("\\,", c7).
perf403_tok_has_7(n) :- op(n, t8), match(",", t8).
perf403_tok_has_7(n) :- child(n, c14, _), structural_before(c14, g9),
    match("(?s)^(?:.*(?:,).*)$", g9).
perf403_tok_has_7(n) :- child(n, c14, _), structural_after(c14, g9),
    match("(?s)^(?:.*(?:,).*)$", g9).
perf403_tok_has_7(n) :- node_text(n, g9), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g9).

// tok_has_8(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf403_tok_has_8(n: node)
.stored perf403_tok_has_8 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf403_tok_has_8(n) :- child(n, c20, _), glob("\\,", c20).
perf403_tok_has_8(n) :- op(n, t21), match(",", t21).
perf403_tok_has_8(n) :- child(n, c27, _), structural_before(c27, g22),
    match("(?s)^(?:.*(?:,).*)$", g22).
perf403_tok_has_8(n) :- child(n, c27, _), structural_after(c27, g22),
    match("(?s)^(?:.*(?:,).*)$", g22).
perf403_tok_has_8(n) :- node_text(n, g22), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g22).

// tok_has_9(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf403_tok_has_9(n: node)
.stored perf403_tok_has_9 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf403_tok_has_9(n) :- child(n, c1, _), glob("\\,", c1).
perf403_tok_has_9(n) :- op(n, t2), match(",", t2).
perf403_tok_has_9(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
perf403_tok_has_9(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
perf403_tok_has_9(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// tok_has_10(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl perf403_tok_has_10(n: node)
.stored perf403_tok_has_10 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
perf403_tok_has_10(n) :- child(n, c3, _), glob("\\,", c3).
perf403_tok_has_10(n) :- op(n, t4), match(",", t4).
perf403_tok_has_10(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
perf403_tok_has_10(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
perf403_tok_has_10(n) :- node_text(n, g5), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g5).

// demand_has_nonlocal: the rows of has_nonlocal its callers ask for (the metavariable columns they pass in)
.decl perf403_demand_has_nonlocal(n: node, tn: loc)
perf403_demand_has_nonlocal(s1, TN) :- kind(n, "identifier"), node(_, n, _, _, _), TN = n,
    inside(n, p1, "for_statement"), precedes(p1, s1).
perf403_demand_has_nonlocal(s2, TN) :- kind(n, "identifier"), node(_, n, _, _, _), TN = n,
    inside(n, p1, "for_statement"), within_stop(p1, p2, perf403_stop_17), precedes(p2, s2).

// demand_has_ref: the rows of has_ref its callers ask for (the metavariable columns they pass in)
.decl perf403_demand_has_ref(n: node, l: loc)
perf403_demand_has_ref(c2_4, L) :- kind(n, "assignment"), n ~ `$_[$K] = $V`,
    field(n, "left", c2), kind(c2, "subscript"), field(c2, "value", c3),
    perf403_plain_name(c3, L), child(p4, n, _), kind(p4, "expression_statement"),
    perf403_only_stmt(p4), perf403_dict_bound(L), child(p3, p4, _), kind(p3, "block"),
    child(p5, p3, _), kind(p5, "if_statement"), perf403_only_stmt(p5), child(p6, p5, _),
    kind(p6, "block"), child(p7, p6, _), field(p5, "condition", c2_4).

// demand_alt_15: the rows of alt_15 its callers ask for (the metavariable columns they pass in)
.decl perf403_demand_alt_15(n: node, for: loc)
perf403_demand_alt_15(n, FOR) :- kind(n, "for_statement"), node(_, n, _, _, _), FOR = n, field(n, "left", c1).

// demand_ref: the rows of ref its callers ask for (the metavariable columns they pass in)
.decl perf403_demand_ref(n: node, l: loc)
perf403_demand_ref(n, L) :- perf403_demand_has_ref(n, L).
perf403_demand_ref(c1, L) :- perf403_demand_has_ref(n, L), within(c1, n).

// demand_has_post_ref: the rows of has_post_ref its callers ask for (the metavariable columns they pass in)
.decl perf403_demand_has_post_ref(n: node, for: loc)
perf403_demand_has_post_ref(s1, FOR) :- perf403_demand_alt_15(n, FOR), precedes(n, s1).
perf403_demand_has_post_ref(s3, FOR) :- perf403_demand_alt_15(n, FOR), within(n, p2), precedes(p2, s3).

// demand_post_ref: the rows of post_ref its callers ask for (the metavariable columns they pass in)
.decl perf403_demand_post_ref(n: node, for: loc)
perf403_demand_post_ref(n, FOR) :- perf403_demand_has_post_ref(n, FOR).
perf403_demand_post_ref(c1, FOR) :- perf403_demand_has_post_ref(n, FOR), within(c1, n).

// demand_target: the nodes target is asked at (its recursion looks at every descendant)
.decl perf403_demand_target(n: node)
perf403_demand_target(c9) :- perf403_demand_target(n), kind(n, "tuple_pattern"), child(n, c9, _).
perf403_demand_target(c1) :- kind(n, "for_statement"), node(_, n, _, _, _), FOR = n, field(n, "left", c1).

// alt_1_u0_empty: level -1 of an unrolled recursion, empty
.decl perf403_alt_1_u0_empty(n: node)

// dict_expr_u0_empty: level -1 of an unrolled recursion, empty
.decl perf403_dict_expr_u0_empty(n: node)

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_1(n: node)
perf403_alt_1(n) :- perf403_alt_1_u7(n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_2(n: node)
perf403_alt_2(n) :- kind(n, "dictionary_splat_pattern"), child(p1, n, _),
    kind(p1, "parameters").
perf403_alt_2(n) :- kind(n, "typed_parameter"), child(p2, n, _), kind(p2, "parameters"),
    child(n, c3, _), kind(c3, "dictionary_splat_pattern").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_3(n: node)
perf403_alt_3(n) :- kind(n, "as_pattern"), child(n, c1, _), perf403_tok_precedes_6(c1), perf403_dict_init(c1).
perf403_alt_3(n) :- kind(n, "function_definition"), field(n, "return_type", c9),
    kind(c9, "type"), child(c9, c10, _), perf403_dict_ann(c10).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_4(n: node)
perf403_alt_4(n) :- ref_site(n, b1), site_only(b1), (st2 = b1 ; within(b1, st2)), perf403_alt_2(st2).
perf403_alt_4(n) :- ref_site(n, b6), site_only(b6), binding_value(b6, x7), perf403_dict_init(x7),
    (st8 = b6 ; within(b6, st8)), count : { child(st8, c9, _), kind(c9, "type") } = 0.
perf403_alt_4(n) :- ref_site(n, b10), site_only(b10), site_annotation(b10, o11), perf403_dict_ann(o11),
    (st12 = b10 ; within(b10, st12)),
    count : { child(st12, c13, _), (kind(c13, "list_splat_pattern") ; kind(c13, "dictionary_splat_pattern")) } = 0.
perf403_alt_4(n) :- ref_site(n, b14), site_only(b14), (st15 = b14 ; within(b14, st15)),
    perf403_alt_3(st15).

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_10(n: node)
perf403_alt_10(n) :- kind(n, "comment").
perf403_alt_10(n) :- node(_, n, _, _, _), glob(";", n).

// alt_9(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_9(n: node)
perf403_alt_9(n) :- precedes(s1, n), !perf403_alt_10(s1).
perf403_alt_9(n) :- precedes(n, s2), !perf403_alt_10(s2).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_12(n: node)
perf403_alt_12(n) :- field(p1, "attribute", n), kind(p1, "attribute").
perf403_alt_12(n) :- field(p2, "name", n),
    (kind(p2, "keyword_argument") ; kind(p2, "default_parameter")).
perf403_alt_12(n) :- child(p3, n, _),
    ( kind(p3, "lambda_parameters")
    ; kind(p3, "list_splat_pattern")
    ; kind(p3, "dictionary_splat_pattern")
    ).


// alt_13(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_13(n: node)
perf403_alt_13(n) :- kind(n, "comment").
perf403_alt_13(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_15(n): the JSON `any`: n matches if any one of these rules does
//   FOR: metavariable of the calling rule, passed in (bound by the caller)
.decl perf403_alt_15(n: node, for: loc)
perf403_alt_15(n, FOR) :- perf403_demand_alt_15(n, FOR), precedes(n, s1), perf403_has_post_ref(s1, FOR).
perf403_alt_15(n, FOR) :- perf403_demand_alt_15(n, FOR), within(n, p2), !kind(p2, "module"),
    precedes(p2, s3), perf403_has_post_ref(s3, FOR).

// alt_16(n): the JSON `any`: n matches if any one of these rules does
.decl perf403_alt_16(n: node)
perf403_alt_16(n) :- perf403_nonlocal_target(n).
perf403_alt_16(n) :- within(c1, n), perf403_nonlocal_target(c1).

// stop_17(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl perf403_stop_17(n: node)
perf403_stop_17(n) :- kind(n, "block"), child(p1, n, _), kind(p1, "function_definition").
