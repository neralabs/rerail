.policy "ruff-perf403-manual-dict-comprehension" revision 1
.guests off
.description "Use a dictionary comprehension or update instead of filling a dict key by key inside a for loop."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PERF403(n): a finding at node n, from clause `manual-dict-comprehension`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `constraints` on L, V are added to every rule.
.violation PERF403(at: node, l: loc) "Build the dict with a comprehension (`{{k: v for ...}}`); if `{l}` is not a fresh empty dict assigned just before the loop, pass that comprehension to `{l}.update(...)` instead."
    suppress noqa "PERF403"
PERF403(n, L) :- kind(n, "assignment"), n ~ `$_[$K] = $V`,
    count : { field(n, "type", c1), kind(c1, "type") } = 0, field(n, "left", c2),
    kind(c2, "subscript"), field(c2, "value", c3), perf403_plain_name(c3, L),
    (match(".*,\\s*\\]", c2), node(_, c2, _, _, _), TC = c2 ; !match(".*,\\s*\\]", c2), unset(TC)),
    child(p4, n, _), kind(p4, "expression_statement"), perf403_only_stmt(p4),
    ( child(p1, p4, _), kind(p1, "block"), child(p2, p1, _), perf403_loop(p2, K, TC, V)
    ; child(p3, p4, _), kind(p3, "block"), child(p5, p3, _), kind(p5, "if_statement"), perf403_only_stmt(p5), count : { field(p5, "alternative", c1_3), (kind(c1_3, "elif_clause") ; kind(c1_3, "else_clause")) } = 0, count : { field(p5, "condition", c2_4), perf403_has_ref(c2_4, L) } = 0, child(p6, p5, _), kind(p6, "block"), child(p7, p6, _), perf403_loop(p7, K, TC, V)
    ),
    perf403_dict_bound(L), !kind(V, "assignment").

// dict_expr(n): the JSON util `dict-expr`, used where the JSON says `matches: "dict-expr"`
.decl perf403_dict_expr(n: node)
perf403_dict_expr(n) :- perf403_dict_expr_u7(n).

// dict_callee(n): the JSON util `dict-callee`, used where the JSON says `matches: "dict-callee"`
.decl perf403_dict_callee(n: node)
perf403_dict_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "dict"), sym_of(n, "builtins.dict").
perf403_dict_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    perf403_dict_callee(c1).

// dict_init(n): the JSON util `dict-init`, used where the JSON says `matches: "dict-init"`
.decl perf403_dict_init(n: node)
perf403_dict_init(n) :- perf403_dict_expr(n).
perf403_dict_init(n) :- kind(n, "call"), child(n, c1, _), perf403_dict_callee(c1),
    next_sibling(c1, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")).

// dict_ann(n): the JSON util `dict-ann`, used where the JSON says `matches: "dict-ann"`
.decl perf403_dict_ann(n: node)
perf403_dict_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "dict"),
    sym_of(n, "builtins.dict").
perf403_dict_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Dict")
    ; sym_of(n, "_typeshed.Dict")
    ; sym_of(n, "typing_extensions.Dict")
    ).

perf403_dict_ann(n) :- (kind(n, "subscript") ; kind(n, "generic_type")), child(n, c1, _),
    !perf403_tok_follows_4(c1), perf403_dict_ann(c1).
perf403_dict_ann(n) :- kind(n, "parenthesized_expression"), child(n, c9, _), perf403_dict_ann(c9).

// dict_bound(n): the JSON util `dict-bound`, used where the JSON says `matches: "dict-bound"`
.decl perf403_dict_bound(n: node)
perf403_dict_bound(n) :- kind(n, "identifier"), perf403_alt_4(n).

