    node(_, n, _, _, en17), o15 = en17 + strlen(g13), token(p14, _, t12, o15, _),
    match("if", t12).
perf403_tok_precedes_2(n) :- structural_after(n, g13),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g13).

