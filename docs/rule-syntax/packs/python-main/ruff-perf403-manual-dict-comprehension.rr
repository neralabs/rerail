.decl perf403_plain_name(n: node, l: loc)
perf403_plain_name(n, L) :- kind(n, "identifier"), node(_, n, _, _, _), L = n.
perf403_plain_name(n, L) :- kind(n, "parenthesized_expression"), child(n, c1, _),
