.decl perf403_target(n: node, k: loc, tc: loc, v: loc)
perf403_target(n, K, TC, V) :- perf403_demand_target(n), kind(n, "tuple_pattern"), !perf403_tok_has_9(n),
    child(n, c9, _), perf403_target(c9, K, TC, V).
perf403_target(n, K, TC, V) :- node(_, K, _, _, _), node(_, V, _, _, _), perf403_demand_target(n),
    kind(n, "identifier"), node(_, n, _, _, _), E = n, value(E, t10), value(K, t10),
    value(E, t12), value(V, t12), unset(TC).
perf403_target(n, K, TC, V) :- perf403_demand_target(n),
    (kind(n, "pattern_list") ; kind(n, "tuple_pattern")),
    count : { within(c16, n), (kind(c16, "attribute") ; kind(c16, "subscript")) } = 0,
    child(n, c17, _), perf403_key_element(c17, K, TC), child(n, c18, _), perf403_value_element(c18, V).

// loop(n): the JSON util `loop`, used where the JSON says `matches: "loop"`
//   K, TC, V: metavariables of the calling rule, passed in (bound by the caller)
.decl perf403_loop(n: node, k: loc, tc: loc, v: loc)
perf403_loop(n, K, TC, V) :- kind(n, "for_statement"), node(_, n, _, _, _), FOR = n, field(n, "left", c1),
    perf403_target(c1, K, TC, V), !perf403_alt_15(n, FOR),
