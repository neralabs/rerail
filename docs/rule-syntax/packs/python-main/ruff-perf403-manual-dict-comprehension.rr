perf403_post_ref(n, FOR) :- perf403_demand_post_ref(n, FOR), kind(n, "identifier"), ref_site(n, b1),
    (st2 = b1 ; within(b1, st2)), node(_, st2, _, _, _), SITE = st2, text(SITE, t3), text(FOR, t3), @doc(SITE) = @doc(FOR).

