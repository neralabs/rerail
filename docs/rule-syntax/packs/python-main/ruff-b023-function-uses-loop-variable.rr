.policy "ruff-b023-function-uses-loop-variable" revision 1
.guests off
.description "Pass loop variables into functions and lambdas defined inside a loop as arguments or defaults; otherwise they all see the variable's last value."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// B023(n): a finding at node n, from clause `function-uses-loop-variable`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation B023(at: node, n: loc) "Bind `{n}` as a default argument, such as `{n}={n}`, so the function keeps this iteration's value."
    suppress noqa "B023"
B023(n, N) :- kind(n, "identifier"), node(_, n, _, _, _), N = n, b023_load_name(n),
    (b023_function_body(n, N) ; within(n, p1), b023_function_body(p1, N)).

// loop(n): the JSON util `loop`, used where the JSON says `matches: "loop"`
.decl b023_loop(n: node)
b023_loop(n) :- kind(n, k1), b023_set_1(k1).

// safe_slot(n): the JSON util `safe-slot`, used where the JSON says `matches: "safe-slot"`
.decl b023_safe_slot(n: node)
b023_safe_slot(n) :- child(p1, n, _), kind(p1, "return_statement").
b023_safe_slot(n) :- next_sibling(n, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")), child(p3, n, _),
    kind(p3, "call").
b023_safe_slot(n) :- child(p4, n, _), kind(p4, "argument_list"), next_sibling(s5, p4),
    ( kind(s5, "identifier"), glob("{filter,reduce,map}", s5)
    ; kind(s5, "attribute"), s5 ~ `functools.reduce`
    ).

b023_safe_slot(n) :- b023_tok_follows_1(n), child(p13, n, _), kind(p13, "keyword_argument"),
    child(p13, c14, _), kind(c14, "identifier"), glob("key", c14), b023_tok_precedes_2(c14).
b023_safe_slot(n) :- child(p22, n, _), kind(p22, "parenthesized_expression"),
    b023_safe_slot(p22).

// function(n): the JSON util `function`, used where the JSON says `matches: "function"`
.decl b023_function(n: node)
b023_function(n) :- kind(n, "function_definition").
b023_function(n) :- kind(n, "lambda"), !b023_safe_slot(n).

// target_slot(n): the JSON util `target-slot`, used where the JSON says `matches: "target-slot"`
.decl b023_target_slot(n: node)
b023_target_slot(n) :- !b023_tok_follows_3(n), child(p8, n, _),
    (kind(p8, "assignment") ; kind(p8, "augmented_assignment")).
b023_target_slot(n) :- b023_tok_follows_4(n), child(p16, n, _),
    (kind(p16, "for_statement") ; kind(p16, "for_in_clause")).
b023_target_slot(n) :- child(p17, n, _), kind(p17, k18), b023_set_3(k18), b023_target_slot(p17).

// store_slot(n): the JSON util `store-slot`, used where the JSON says `matches: "store-slot"`
.decl b023_store_slot(n: node)
b023_store_slot(n) :- b023_target_slot(n).
b023_store_slot(n) :- !b023_tok_follows_3(n), child(p8, n, _), kind(p8, "named_expression").
b023_store_slot(n) :- kind(n, "as_pattern_target"), child(p9, n, _), kind(p9, "as_pattern"),
    child(p10, p9, _), kind(p10, "with_item").
b023_store_slot(n) :- child(p11, n, _), kind(p11, k12), b023_set_4(k12), b023_store_slot(p11).

// non_name(n): the JSON util `non-name`, used where the JSON says `matches: "non-name"`
.decl b023_non_name(n: node)
b023_non_name(n) :- b023_tok_follows_5(n), child(p8, n, _), kind(p8, "attribute").
b023_non_name(n) :- b023_tok_precedes_6(n), child(p16, n, _), kind(p16, "keyword_argument").
b023_non_name(n) :- child(p17, n, _),
    ( kind(p17, k1), b023_set_5(k1)
    ; kind(p17, "list_splat_pattern"), child(p1, p17, _), (kind(p1, "parameters") ; kind(p1, "lambda_parameters") ; kind(p1, "typed_parameter"))
    ; kind(p17, "as_pattern_target"), child(p2, p17, _), kind(p2, "as_pattern"), child(p3, p2, _), kind(p3, "except_clause")
    ; kind(p17, "as_pattern"), child(p4, p17, _), kind(p4, "case_pattern")
    ).

b023_non_name(n) :- !b023_tok_follows_7(n), child(p30, n, _),
    ( kind(p30, "default_parameter")
    ; kind(p30, "typed_parameter")
    ; kind(p30, "typed_default_parameter")
    ).


// load_name(n): the JSON util `load-name`, used where the JSON says `matches: "load-name"`
.decl b023_load_name(n: node)
b023_load_name(n) :- kind(n, "identifier"), !b023_alt_8(n).

// param_n(n): the JSON util `param-n`, used where the JSON says `matches: "param-n"`
//   N: metavariable this relation binds for the calling rule
.decl b023_param_n(n: node, n_mv: loc)
b023_param_n(n, N) :- kind(n, "identifier"), node(_, n, _, _, _), N = n.
b023_param_n(n, N) :- (kind(n, "list_splat_pattern") ; kind(n, "dictionary_splat_pattern")),
    child(n, c1, _), kind(c1, "identifier"), node(_, c1, _, _, _), N = c1.
b023_param_n(n, N) :-
    ( kind(n, "default_parameter")
    ; kind(n, "typed_parameter")
    ; kind(n, "typed_default_parameter")
    ),
    child(n, c2, _), !b023_tok_follows_8(c2), b023_param_n(c2, N).

// loop_assigns_n(n): the JSON util `loop-assigns-n`, used where the JSON says `matches: "loop-assigns-n"`
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl b023_loop_assigns_n(n: node, n_mv: loc)
b023_loop_assigns_n(n, N) :- b023_demand_loop_assigns_n(n, N), b023_loop(n),
    within_stop(c1, n, b023_stop_9), kind(c1, "identifier"), text(c1, t_n1), text(N, t_n1),
    b023_target_slot(c1), @doc(c1) = @doc(N).

// unbound_in_function(n): the JSON util `unbound-in-function`, used where the JSON says `matches: "unbound-in-function"`
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl b023_unbound_in_function(n: node, n_mv: loc)
b023_unbound_in_function(n, N) :- b023_demand_unbound_in_function(n, N), b023_function(n),
    !b023_alt_10(n, N), within_stop(n, p4, b023_function), b023_loop_assigns_n(p4, N).

// function_body(n): the JSON util `function-body`, used where the JSON says `matches: "function-body"`
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl b023_function_body(n: node, n_mv: loc)
b023_function_body(n, N) :- b023_demand_function_body(n, N), kind(n, "block"), child(p1, n, _),
    kind(p1, "function_definition"), b023_unbound_in_function(p1, N).
b023_function_body(n, N) :- b023_demand_function_body(n, N), b023_tok_follows_9(n), child(p9, n, _),
    kind(p9, "lambda"), b023_unbound_in_function(p9, N).

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_follows_1(n: node)
.stored b023_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_follows_1(n) :- next_sibling(s6, n), glob("=", s6).
b023_tok_follows_1(n) :- structural_before(n, g8), match("\\s*", g8), child(p9, n, _),
    node(_, n, _, st11, _), o10 = st11 - strlen(g8), token(p9, _, t7, _, o10),
    match("=", t7).
b023_tok_follows_1(n) :- structural_before(n, g8),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)\\s*)$", g8).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_precedes_2(n: node)
.stored b023_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_precedes_2(n) :- next_sibling(n, s15), glob("=", s15).
b023_tok_precedes_2(n) :- structural_after(n, g17), match("\\s*", g17), child(p18, n, _),
    node(_, n, _, _, en21), o19 = en21 + strlen(g17), token(p18, _, t16, o19, _),
    match("=", t16).
b023_tok_precedes_2(n) :- structural_after(n, g17),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g17).

// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_follows_3(n: node)
.stored b023_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_follows_3(n) :- next_sibling(s1, n), match("(?s).*..*", s1).
b023_tok_follows_3(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("(?s).*..*", t2).
b023_tok_follows_3(n) :- structural_before(n, g3), match("(?s)^.*\\S\\s*$", g3).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "^for$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_follows_4(n: node)
.stored b023_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_follows_4(n) :- next_sibling(s9, n), glob("for", s9).
b023_tok_follows_4(n) :- structural_before(n, g11), match("\\s*", g11), child(p12, n, _),
    node(_, n, _, st14, _), o13 = st14 - strlen(g11), token(p12, _, t10, _, o13),
    match("for", t10).
b023_tok_follows_4(n) :- structural_before(n, g11),
    match("(?s)^(?:(?:.*\\W)?(?:for)\\s*)$", g11).

// tok_follows_5(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\.$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_follows_5(n: node)
.stored b023_tok_follows_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_follows_5(n) :- next_sibling(s1, n), glob(".", s1).
b023_tok_follows_5(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("\\.", t2).
b023_tok_follows_5(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)\\s*)$", g3).

// tok_precedes_6(n): a later sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_precedes_6(n: node)
.stored b023_tok_precedes_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_precedes_6(n) :- next_sibling(n, s9), glob("=", s9).
b023_tok_precedes_6(n) :- structural_after(n, g11), match("\\s*", g11), child(p12, n, _),
    node(_, n, _, _, en15), o13 = en15 + strlen(g11), token(p12, _, t10, o13, _),
    match("=", t10).
b023_tok_precedes_6(n) :- structural_after(n, g11),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g11).

// tok_follows_7(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_follows_7(n: node)
.stored b023_tok_follows_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_follows_7(n) :- next_sibling(s23, n), match("(?s).*..*", s23).
b023_tok_follows_7(n) :- structural_before(n, g25), match("\\s*", g25), child(p26, n, _),
    node(_, n, _, st28, _), o27 = st28 - strlen(g25), token(p26, _, t24, _, o27),
    match("(?s).*..*", t24).
b023_tok_follows_7(n) :- structural_before(n, g25), match("(?s)^.*\\S\\s*$", g25).

// tok_follows_8(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_follows_8(n: node)
.stored b023_tok_follows_8 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_follows_8(n) :- next_sibling(s3, n), match("(?s).*..*", s3).
b023_tok_follows_8(n) :- structural_before(n, g5), match("\\s*", g5), child(p6, n, _),
    node(_, n, _, st8, _), o7 = st8 - strlen(g5), token(p6, _, t4, _, o7),
    match("(?s).*..*", t4).
b023_tok_follows_8(n) :- structural_before(n, g5), match("(?s)^.*\\S\\s*$", g5).

// tok_follows_9(n): an earlier sibling of n, a named node or an anonymous token, matches "^:$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b023_tok_follows_9(n: node)
.stored b023_tok_follows_9 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b023_tok_follows_9(n) :- next_sibling(s2, n), glob(":", s2).
b023_tok_follows_9(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match(":", t3).
b023_tok_follows_9(n) :- structural_before(n, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::)\\s*)$", g4).

// demand_function_body: the rows of function_body its callers ask for (the metavariable columns they pass in)
.decl b023_demand_function_body(n: node, n_mv: loc)
b023_demand_function_body(n, N) :- kind(n, "identifier"), node(_, n, _, _, _), N = n, b023_load_name(n).
b023_demand_function_body(p1, N) :- kind(n, "identifier"), node(_, n, _, _, _), N = n, b023_load_name(n),
    within(n, p1).

// demand_unbound_in_function: the rows of unbound_in_function its callers ask for (the metavariable columns they pass in)
.decl b023_demand_unbound_in_function(n: node, n_mv: loc)
b023_demand_unbound_in_function(p1, N) :- b023_demand_function_body(n, N), kind(n, "block"),
    child(p1, n, _), kind(p1, "function_definition").
b023_demand_unbound_in_function(p9, N) :- b023_demand_function_body(n, N), b023_tok_follows_9(n),
    child(p9, n, _), kind(p9, "lambda").

// demand_alt_10: the rows of alt_10 its callers ask for (the metavariable columns they pass in)
.decl b023_demand_alt_10(n: node, n_mv: loc)
b023_demand_alt_10(n, N) :- b023_demand_unbound_in_function(n, N), b023_function(n),
    within_stop(n, p4, b023_function).

// demand_loop_assigns_n: the rows of loop_assigns_n its callers ask for (the metavariable columns they pass in)
.decl b023_demand_loop_assigns_n(n: node, n_mv: loc)
b023_demand_loop_assigns_n(p4, N) :- b023_demand_unbound_in_function(n, N), b023_function(n),
    within_stop(n, p4, b023_function).

// set_1: node kinds from a JSON `any`
.decl b023_set_1(v: symbol)
b023_set_1("for_statement"). b023_set_1("while_statement"). b023_set_1("list_comprehension").
b023_set_1("set_comprehension"). b023_set_1("dictionary_comprehension").
b023_set_1("generator_expression").

// set_3: node kinds from a JSON `any`
.decl b023_set_3(v: symbol)
b023_set_3("pattern_list"). b023_set_3("tuple_pattern"). b023_set_3("list_pattern").
b023_set_3("list_splat_pattern"). b023_set_3("tuple"). b023_set_3("list").
b023_set_3("parenthesized_expression").

// set_4: node kinds from a JSON `any`
.decl b023_set_4(v: symbol)
b023_set_4("as_pattern_target"). b023_set_4("tuple"). b023_set_4("list").
b023_set_4("parenthesized_expression"). b023_set_4("list_splat_pattern").

// set_5: node kinds from a JSON `any`
.decl b023_set_5(v: symbol)
b023_set_5("function_definition"). b023_set_5("class_definition"). b023_set_5("parameters").
b023_set_5("lambda_parameters"). b023_set_5("dictionary_splat_pattern"). b023_set_5("dotted_name").
b023_set_5("aliased_import"). b023_set_5("global_statement"). b023_set_5("nonlocal_statement").
b023_set_5("keyword_pattern"). b023_set_5("splat_pattern"). b023_set_5("type_parameter").

// stop_9: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl b023_stop_9(kind: symbol)
b023_stop_9("function_definition"). b023_stop_9("lambda").

// alt_8(n): the JSON `any`: n matches if any one of these rules does
.decl b023_alt_8(n: node)
b023_alt_8(n) :- b023_non_name(n).
b023_alt_8(n) :- b023_store_slot(n).
b023_alt_8(n) :- child(p1, n, _), kind(p1, "delete_statement").

// alt_10(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl b023_alt_10(n: node, n_mv: loc)
b023_alt_10(n, N) :- b023_demand_alt_10(n, N), child(n, c1, _),
    (kind(c1, "parameters") ; kind(c1, "lambda_parameters")), child(c1, c2, _),
    b023_param_n(c2, N).
b023_alt_10(n, N) :- b023_demand_alt_10(n, N), has(n, c3, "identifier"),
    text(c3, t_n2), text(N, t_n2), b023_store_slot(c3), @doc(c3) = @doc(N).
