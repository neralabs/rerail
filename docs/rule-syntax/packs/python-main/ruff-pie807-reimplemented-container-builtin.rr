.policy "ruff-pie807-reimplemented-container-builtin" revision 1
.guests off
.description "Use list or dict directly instead of a lambda that returns an empty list or dict, such as for a default factory."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// PIE807(n): a finding at node n, from clause `reimplemented-container-builtin`.
// Each rule below is one way the JSON `rule` can match.
.violation PIE807(at: node) "Prefer `list` or `dict` over useless lambda"
    suppress noqa "PIE807"
PIE807(n) :- kind(n, "lambda"),
    count : { child(n, c1, _), kind(c1, "lambda_parameters") } = 0, child(n, c2, _),
    !glob("{lambda,:}", c2), pie807_empty_container(c2).

// empty_container(n): the JSON util `empty-container`, used where the JSON says `matches: "empty-container"`
.decl pie807_empty_container(n: node)
pie807_empty_container(n) :- (kind(n, "list") ; kind(n, "dictionary")),
    count : { child(n, c1, _), !pie807_alt_1(c1) } = 0.
pie807_empty_container(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    pie807_empty_container(c2).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pie807_alt_1(n: node)
pie807_alt_1(n) :- node(_, n, _, _, _), glob("[\\[\\]{}]", n).
pie807_alt_1(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
