.policy "ruff-pth202-os-path-getsize" revision 1
.guests off
.description "Use Path.stat().st_size instead of os.path.getsize(); path objects read better than string-based os.path calls."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// ref(n): the JSON util `ref`, used where the JSON says `matches: "ref"`
.decl pth202_ref(n: node)
pth202_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, "os.path.getsize").

// single_filename_arg(n): the JSON util `single-filename-arg`, used where the JSON says `matches: "single-filename-arg"`
.decl pth202_single_filename_arg(n: node)
pth202_single_filename_arg(n) :- child(n, c1, _), kind(c1, "generator_expression").
pth202_single_filename_arg(n) :- child(n, c2, _), kind(c2, "argument_list"),
    k4 = count : { child(c2, c3, _), !pth202_alt_1(c3) }, k4 >= 1, k4 <= 1, child(c2, c5, _),
    (kind(c5, "keyword_argument"), match("filename\\s*=.*", c5) ; !pth202_alt_3(c5)).

// PTH202(n): a finding at node n, from clause `os-path-getsize`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PTH202(at: node, f: node, s: loc) "Use `Path({s}).stat().st_size` instead of `os.path.getsize({s})` (without the `Path(...)` wrapper if `{s}` is already a path); leave it where the argument is a bytes path or a file descriptor."
    suppress noqa "PTH202"
PTH202(F, n, S) :- kind(n, "call"), field(n, "function", c1), pth202_callee(c1, F),
    pth202_arg_filename_1(n, a2), S = a2,
    ( child(n, c2, _), kind(c2, "argument_list"), k1 = count : { child(c2, c3, _), !pth202_alt_1(c3) }, k1 >= 1, k1 <= 1
    ; field(n, "arguments", c4), kind(c4, "generator_expression")
    ).


// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   F: metavariable this relation binds for the calling rule
.decl pth202_callee(n: node, f: loc)
pth202_callee(n, F) :- pth202_ref(n), node(_, n, _, _, _), F = n.
pth202_callee(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth202_callee(c1, F).

// PTH202_os_path_getsize_in_annotation(n): a finding at node n, from clause `os-path-getsize-in-annotation`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PTH202_os_path_getsize_in_annotation(at: node, f: node) code "PTH202" "Use `Path(...).stat().st_size` instead of `os.path.getsize(...)`; leave it where the argument is a bytes path or a file descriptor."
    suppress noqa "PTH202"
PTH202_os_path_getsize_in_annotation(F, n) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1),
    ( kind(c2, "call"), child(c2, c1, _), pth202_alt_12(c1, F), pth202_single_filename_arg(c2)
    ; (kind(c2, "string") ; kind(c2, "concatenated_string")), parsed(c2, "annotation", r2), within(c3, r2), pth202_alt_15(c3, F)
    ).


// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl pth202_args_plain(l: node, a: node, i: number)
pth202_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl pth202_args_splat(l: node, i: number)
pth202_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl pth202_args_pos(l: node, a: node, j: number)
pth202_args_pos(l, a, j) :- pth202_args_plain(l, a, i), count : { pth202_args_splat(l, k), k < i } = 0,
    j = count : { pth202_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl pth202_args_star(l: node, j: number)
pth202_args_star(l, j) :- pth202_args_splat(l, i), count : { pth202_args_splat(l, k), k < i } = 0,
    j = count : { pth202_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl pth202_args_kwp(l: node, k: symbol, v: node)
pth202_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl pth202_args_lit_dict(s: node, d: node)
pth202_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !pth202_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl pth202_args_str_pair(p: node)
pth202_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl pth202_args_kw(l: node, k: symbol, v: node)
pth202_args_kw(l, k, v) :- pth202_args_kwp(l, k, v).
pth202_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), pth202_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl pth202_args_kw_spread(l: node)
pth202_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !pth202_args_lit_dict(s, _).

// arg_filename_1: call n passes v for slot `filename` of (filename), syntactic: Ruff's find_argument
.decl pth202_arg_filename_1(n: node, v: node)
pth202_arg_filename_1(n, v) :- kind(n, "call"), field(n, "arguments", l),
    pth202_args_kwp(l, "filename", v).
pth202_arg_filename_1(n, v) :- kind(n, "call"), field(n, "arguments", l), pth202_args_pos(l, v, 0),
    !pth202_args_kwp(l, "filename", _).
pth202_arg_filename_1(n, v) :- kind(n, "call"), field(n, "arguments", v),
    kind(v, "generator_expression").

// arg_no_filename_1: call n does not pass slot `filename` of (filename), syntactic: Ruff's find_argument
.decl pth202_arg_no_filename_1(n: node)
pth202_arg_no_filename_1(n) :- kind(n, "call"), field(n, "arguments", l),
    !pth202_args_kwp(l, "filename", _), !pth202_args_pos(l, _, 0), !kind(l, "generator_expression").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pth202_alt_1(n: node)
pth202_alt_1(n) :- node(_, n, _, _, _), glob("[(),\\[\\]{}]", n).
pth202_alt_1(n) :- kind(n, "comment").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pth202_alt_3(n: node)
pth202_alt_3(n) :- (kind(n, "keyword_argument") ; kind(n, "list_splat") ; kind(n, "dictionary_splat")).
pth202_alt_3(n) :- pth202_alt_1(n).

// alt_12(n): the JSON `any`: n matches if any one of these rules does
//   F: metavariable this relation binds for the calling rule
.decl pth202_alt_12(n: node, f: loc)
pth202_alt_12(n, F) :- pth202_ref(n), F = n.
pth202_alt_12(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth202_ref(c1), F = c1.
pth202_alt_12(n, F) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    kind(c2, "parenthesized_expression"), child(c2, c3, _), pth202_ref(c3), F = c3.

// alt_15(n): the JSON `any`: n matches if any one of these rules does
//   F: metavariable this relation binds for the calling rule
.decl pth202_alt_15(n: node, f: loc)
pth202_alt_15(n, F) :- kind(n, "call"), child(n, c1, _), pth202_alt_12(c1, F),
    pth202_single_filename_arg(n).
pth202_alt_15(n, F) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r5), has(r5, c6, "call"), child(c6, c7, _), pth202_alt_12(c7, F),
    pth202_single_filename_arg(c6).
