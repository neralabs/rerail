.policy "ruff-pth121-os-path-samefile" revision 1
.guests off
.description "Use the samefile method of a Path object instead of os.path.samefile; pathlib reads better than string-based os.path functions."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// PTH121(n): a finding at node n, from clause `os-path-samefile`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PTH121(at: node, f: node) "Use `Path(first).samefile(second)` instead of `os.path.samefile(first, second)`; leave it for bytes paths, which `Path` rejects."
    suppress noqa "PTH121"
PTH121(F, n) :- pth121_target(n, F).
PTH121(F, n) :- pth121_in_string(n, F).

// callee(n): the JSON util `callee`, used where the JSON says `matches: "callee"`
//   F: metavariable this relation binds for the calling rule
.decl pth121_callee(n: node, f: loc)
pth121_callee(n, F) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "os.path.samefile"), node(_, n, _, _, _), F = n.
pth121_callee(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _), pth121_callee(c1, F).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
//   F: metavariable this relation binds for the calling rule
.decl pth121_target(n: node, f: loc)
pth121_target(n, F) :- kind(n, "call"), child(n, c1, _), pth121_callee(c1, F), precedes(c1, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")).

// in_string(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   F: metavariable this relation binds for the calling rule
.decl pth121_in_string(n: node, f: loc)
pth121_in_string(n, F) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), pth121_alt_1(c2, F).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
//   F: metavariable this relation binds for the calling rule
.decl pth121_alt_1(n: node, f: loc)
pth121_alt_1(n, F) :- pth121_target(n, F).
pth121_alt_1(n, F) :- pth121_in_string(n, F).
