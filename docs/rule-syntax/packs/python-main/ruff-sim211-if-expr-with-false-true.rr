.policy "ruff-sim211-if-expr-with-false-true" revision 1
.guests off
.description "Use not on the condition instead of a conditional expression that yields False when it holds and True otherwise."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// SIM211(n): a finding at node n, from clause `if-expr-with-false-true`.
// Each rule below is one way the JSON `rule` can match.
.violation SIM211(at: node) "Use `not ...` instead of `False if ... else True`"
    suppress noqa "SIM211"
SIM211(n) :- kind(n, "conditional_expression"), child(n, c1, _), sim211_false(c1),
    sim211_tok_precedes_1(c1), child(n, c9, _), sim211_true(c9), sim211_tok_follows_2(c9).

// true(n): the JSON util `true`, used where the JSON says `matches: "true"`
.decl sim211_true(n: node)
sim211_true(n) :- kind(n, "true").
sim211_true(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), sim211_true(c1).

// false(n): the JSON util `false`, used where the JSON says `matches: "false"`
.decl sim211_false(n: node)
sim211_false(n) :- kind(n, "false").
sim211_false(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), sim211_false(c1).

// tok_precedes_1(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim211_tok_precedes_1(n: node)
.stored sim211_tok_precedes_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim211_tok_precedes_1(n) :- next_sibling(n, s2), glob("if", s2).
sim211_tok_precedes_1(n) :- structural_after(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, _, en8), o6 = en8 + strlen(g4), token(p5, _, t3, o6, _),
    match("if", t3).
sim211_tok_precedes_1(n) :- structural_after(n, g4),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g4).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim211_tok_follows_2(n: node)
.stored sim211_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim211_tok_follows_2(n) :- next_sibling(s10, n), glob("else", s10).
sim211_tok_follows_2(n) :- structural_before(n, g12), match("\\s*", g12), child(p13, n, _),
    node(_, n, _, st15, _), o14 = st15 - strlen(g12), token(p13, _, t11, _, o14),
    match("else", t11).
sim211_tok_follows_2(n) :- structural_before(n, g12),
    match("(?s)^(?:(?:.*\\W)?(?:else)\\s*)$", g12).
