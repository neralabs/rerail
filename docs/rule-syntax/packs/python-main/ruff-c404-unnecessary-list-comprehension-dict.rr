.policy "ruff-c404-unnecessary-list-comprehension-dict" revision 1
.guests off
.description "Write a dict comprehension instead of passing a list comprehension of pairs to dict(); it skips building a throwaway list."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// C404(n): a finding at node n, from clause `unnecessary-list-comprehension-dict`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation C404(at: node, call: node) "Rewrite `dict([(k, v) for ...])` as the dict comprehension `{{k: v for ...}}`; leave it when the pair unpacks with `*`, as in `(k, *v)`."
    suppress noqa "C404"
C404(CALL, n) :- c404_target(n), node(_, n, _, _, _), CALL = n.
C404(CALL, n) :- c404_in_annotation(n, CALL).

// callee_dict(n): the JSON util `callee-dict`, used where the JSON says `matches: "callee-dict"`
.decl c404_callee_dict(n: node)
c404_callee_dict(n) :- kind(n, "identifier"), glob("dict", n), global_ref(n, "dict").
c404_callee_dict(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    c404_callee_dict(c1).

// element(n): the JSON util `element`, used where the JSON says `matches: "element"`
.decl c404_element(n: node)
c404_element(n) :- node(_, n, _, _, _), !c404_alt_1(n).

// pair(n): the JSON util `pair`, used where the JSON says `matches: "pair"`
.decl c404_pair(n: node)
c404_pair(n) :- kind(n, "tuple"), k2 = count : { child(n, c1, _), c404_element(c1) }, k2 >= 2,
    k2 <= 2.
c404_pair(n) :- kind(n, "parenthesized_expression"), child(n, c3, _), c404_pair(c3).

// pair_comprehension(n): the JSON util `pair-comprehension`, used where the JSON says `matches: "pair-comprehension"`
.decl c404_pair_comprehension(n: node)
c404_pair_comprehension(n) :- kind(n, "list_comprehension"), field(n, "body", c1), c404_pair(c1).
c404_pair_comprehension(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    c404_pair_comprehension(c2).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl c404_target(n: node)
c404_target(n) :- kind(n, "call"), field(n, "function", c1), c404_callee_dict(c1),
    field(n, "arguments", c2), kind(c2, "argument_list"),
    k4 = count : { child(c2, c3, _), c404_element(c3) }, k4 >= 1, k4 <= 1, child(c2, c5, _),
    c404_pair_comprehension(c5).

// in_annotation(n): the JSON util `in-annotation`, used where the JSON says `matches: "in-annotation"`
//   CALL: metavariable this relation binds for the calling rule
.decl c404_in_annotation(n: node, call: loc)
c404_in_annotation(n, CALL) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), c404_alt_2(c2, CALL).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl c404_alt_1(n: node)
c404_alt_1(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
c404_alt_1(n) :- node(_, n, _, _, _), glob("[\\[\\](),]", n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   CALL: metavariable this relation binds for the calling rule
.decl c404_alt_2(n: node, call: loc)
c404_alt_2(n, CALL) :- c404_target(n), CALL = n.
c404_alt_2(n, CALL) :- c404_in_annotation(n, CALL).
