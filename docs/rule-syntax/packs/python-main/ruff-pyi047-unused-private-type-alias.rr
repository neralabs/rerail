.policy "ruff-pyi047-unused-private-type-alias" revision 1
.guests off
.description "Use, make public or remove a private type alias that nothing in its file references; an unused private alias is likely a mistake."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/names.rr"

// alias_ref(n): the JSON util `alias-ref`, used where the JSON says `matches: "alias-ref"`
.decl pyi047_alias_ref(n: node)
pyi047_alias_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.TypeAlias")
    ; sym_of(n, "typing_extensions.TypeAlias")
    ; sym_of(n, "_typeshed.TypeAlias")
    ).

pyi047_alias_ref(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), pyi047_alias_ref(c1).

// alias_site(n): the JSON util `alias-site`, used where the JSON says `matches: "alias-site"`
.decl pyi047_alias_site(n: node)
pyi047_alias_site(n) :- kind(n, "type_alias_statement").
pyi047_alias_site(n) :- kind(n, "assignment"), field(n, "type", c1), kind(c1, "type"),
    child(c1, c2, _), pyi047_alias_ref(c2), pyi047_tok_has_1(n).

// name_target(n): the JSON util `name-target`, used where the JSON says `matches: "name-target"`
.decl pyi047_name_target(n: node)
pyi047_name_target(n) :- kind(n, "identifier").
pyi047_name_target(n) :- (kind(n, "parenthesized_expression") ; kind(n, "tuple_pattern"), !pyi047_tok_has_2(n)),
    child(n, c9, _), pyi047_name_target(c9).

// named_alias_site(n): the JSON util `named-alias-site`, used where the JSON says `matches: "named-alias-site"`
.decl pyi047_named_alias_site(n: node)
pyi047_named_alias_site(n) :- kind(n, "type_alias_statement").
pyi047_named_alias_site(n) :- kind(n, "assignment"), pyi047_alias_site(n), field(n, "left", c1),
    pyi047_name_target(c1).

// PYI047(n): a finding at node n, from clause `unused-private-type-alias`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI047(at: node, name: loc) "Nothing in this file uses the private type alias `{name}`. Use it, rename it without the underscore if other modules import it, or remove it once nothing does."
    suppress noqa "PYI047"
PYI047_raw(n, NAME) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n, prefix("_", n),
    bind_name(n, b1), (st2 = b1 ; within(b1, st2)), pyi047_alias_site(st2), site_latest(b1),
    !site_used(b1), (site_scope(b1, "module") ; site_scope(b1, "function")).

// PYI047_unused_private_type_alias_stub(n): a finding at node n, from clause `unused-private-type-alias-stub`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI047_unused_private_type_alias_stub(at: node, name: loc) code "PYI047" "Nothing in this file uses the private type alias `{name}`. Use it, rename it without the underscore if other modules import it, or remove it once nothing does."
    suppress noqa "PYI047"
PYI047_unused_private_type_alias_stub_raw(n, NAME) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n,
    prefix("_", n), bind_name(n, b1), (st2 = b1 ; within(b1, st2)), pyi047_alias_site(st2),
    site_latest(b1), !site_used(b1).

// PYI047_unused_comprehension_variable_in_stub_alias(n): a finding at node n, from clause `unused-comprehension-variable-in-stub-alias`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI047_unused_comprehension_variable_in_stub_alias(at: node, name: loc) code "PYI047" "The comprehension variable `{name}` in this stub type alias is never read. Replace the comprehension with a plain type expression; stubs only declare types."
    suppress noqa "PYI047"
PYI047_unused_comprehension_variable_in_stub_alias_raw(n, NAME) :- kind(n, "identifier"),
    node(_, n, _, _, _), NAME = n, prefix("_", n), bind_name(n, b1), site_scope(b1, "comprehension"),
    site_latest(b1), !site_used(b1), within_stop(n, p2, pyi047_stop_2), pyi047_named_alias_site(p2).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi047_tok_has_1(n: node)
.stored pyi047_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi047_tok_has_1(n) :- child(n, c3, _), glob("=", c3).
pyi047_tok_has_1(n) :- op(n, t4), match("=", t4).
pyi047_tok_has_1(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).
pyi047_tok_has_1(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).
pyi047_tok_has_1(n) :- node_text(n, g5), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi047_tok_has_2(n: node)
.stored pyi047_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi047_tok_has_2(n) :- child(n, c1, _), glob("\\,", c1).
pyi047_tok_has_2(n) :- op(n, t2), match(",", t2).
pyi047_tok_has_2(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
pyi047_tok_has_2(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
pyi047_tok_has_2(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// stop_2: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi047_stop_2(kind: symbol)
pyi047_stop_2("block"). pyi047_stop_2("module").

// main's file condition {"notRegex": "\\.pyi$"}
.decl PYI047_raw(at: node, name: loc)
PYI047(v0, v1) :- PYI047_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).

// main's file condition {"regex": "\\.pyi$"}
.decl PYI047_unused_private_type_alias_stub_raw(at: node, name: loc)
PYI047_unused_private_type_alias_stub(v0, v1) :- PYI047_unused_private_type_alias_stub_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).

// main's file condition {"regex": "\\.pyi$"}
.decl PYI047_unused_comprehension_variable_in_stub_alias_raw(at: node, name: loc)
PYI047_unused_comprehension_variable_in_stub_alias(v0, v1) :- PYI047_unused_comprehension_variable_in_stub_alias_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).
