.policy "ruff-air303-airflow3-incompatible-function-signature" revision 1
.guests off
.description "Update calls and methods whose Airflow 3 signature changed: pass lineage asset arguments and dataset extras by keyword, and give get_link a ti_key parameter."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// AIR303(n): a finding at node n, from clause `create-asset`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation AIR303(at: node, m: node) "Pass the arguments to `{m}` by keyword, e.g. `{m}(uri=...)`; Airflow 3 no longer accepts positional arguments here."
    suppress noqa "AIR303"
AIR303(M, n) :- kind(n, "call"), field(n, "function", c1), air303_collector_method(c1, M),
    field(n, "arguments", c2),
    ( kind(c2, "generator_expression")
    ; kind(c2, "argument_list"), child(c2, c3, _), !air303_alt_2(c3)
    ).


// collector_class(n): the JSON util `collector-class`, used where the JSON says `matches: "collector-class"`
.decl air303_collector_class(n: node)
air303_collector_class(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "airflow.lineage.hook.HookLineageCollector").
air303_collector_class(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air303_collector_class(c1).

// collector_call(n): the JSON util `collector-call`, used where the JSON says `matches: "collector-call"`
.decl air303_collector_call(n: node)
air303_collector_call(n) :- kind(n, "call"), field(n, "function", c1), air303_collector_class(c1).
air303_collector_call(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    air303_collector_call(c2).

// assigned_collector(n): the JSON util `assigned-collector`, used where the JSON says `matches: "assigned-collector"`
.decl air303_assigned_collector(n: node)
air303_assigned_collector(n) :- air303_collector_call(n).
air303_assigned_collector(n) :- kind(n, "assignment"), field(n, "right", c1),
    air303_assigned_collector(c1).

// collector(n): the JSON util `collector`, used where the JSON says `matches: "collector"`
.decl air303_collector(n: node)
air303_collector(n) :- air303_collector_call(n).
air303_collector(n) :- kind(n, "identifier"), ref_site(n, b1), kind(b1, "assignment"),
    field(b1, "right", c2), air303_assigned_collector(c2).
air303_collector(n) :- air303_assigned_chain(n).
air303_collector(n) :- kind(n, "parenthesized_expression"), child(n, c3, _), air303_collector(c3).

// collector_method(n): the JSON util `collector-method`, used where the JSON says `matches: "collector-method"`
//   M: metavariable this relation binds for the calling rule
.decl air303_collector_method(n: node, m: loc)
air303_collector_method(n, M) :- kind(n, "attribute"), field(n, "attribute", c1),
    glob("create_asset", c1), node(_, c1, _, _, _), M = c1, field(n, "object", c2), air303_collector(c2).
air303_collector_method(n, M) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    air303_collector_method(c3, M).

// assigned_callee(n, key): 3 copies of one rule set (`assigned-airflow-callee`, `assigned-hook-callee`, `assigned-lineage-callee`), folded into one: row `key` of
// assigned_callee_case gives the strings each copy had.
.decl air303_assigned_callee(n: node, key: symbol)
air303_assigned_callee(n, q1) :- air303_assigned_callee_case(q1, s1), sym_of(n, s1).
air303_assigned_callee(n, q1) :- air303_assigned_callee_case(q1, s1),
    kind(n, "parenthesized_expression"), child(n, c1, _), air303_assigned_callee(c1, q1).

// assigned_call(n, key): 3 copies of one rule set (`assigned-airflow-call`, `assigned-hook-call`, `assigned-lineage-call`), folded into one: row `key` of
// assigned_call_case gives the strings each copy had.
.decl air303_assigned_call(n: node, key: symbol)
air303_assigned_call(n, q1) :- air303_assigned_call_case(q1), kind(n, "call"),
    field(n, "function", c1), air303_assigned_callee(c1, q1).
air303_assigned_call(n, q1) :- air303_assigned_call_case(q1), kind(n, "parenthesized_expression"),
    child(n, c2, _), air303_assigned_call(c2, q1).
air303_assigned_call(n, q1) :- air303_assigned_call_case(q1), kind(n, "assignment"),
    field(n, "right", c3), air303_assigned_call(c3, q1).

// assigned_chain(n): the JSON util `assigned-chain`, used where the JSON says `matches: "assigned-chain"`
.decl air303_assigned_chain(n: node)
air303_assigned_chain(n) :- kind(n, "attribute"), air303_alt_1(n).

// AIR303_dataset_extra(n): a finding at node n, from clause `dataset-extra`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation AIR303_dataset_extra(at: node, f: node) code "AIR303" "Pass the dict to `{f}` as the `extra=` keyword argument instead of as the second positional argument; that signature changed in Airflow 3."
    suppress noqa "AIR303"
AIR303_dataset_extra(F, n) :- kind(n, "call"), field(n, "function", c1),
    air303_dataset_callee(c1, F), field(n, "arguments", c2), kind(c2, "argument_list"),
    child(c2, c3, _), air303_dict_arg(c3), precedes_stop(s4, c3, air303_stop_10), glob("\\,", s4),
    precedes_stop(s5, s4, air303_stop_10), !kind(s5, "list_splat"),
    !kind(s5, "dictionary_splat"), !kind(s5, "keyword_argument"),
    precedes_stop(s6, s5, air303_stop_10), glob("(", s6).

// dict_expr(n): the JSON util `dict-expr`, used where the JSON says `matches: "dict-expr"`
.decl air303_dict_expr(n: node)
air303_dict_expr(n) :- air303_dict_expr_u7(n).

// dict_callee(n): the JSON util `dict-callee`, used where the JSON says `matches: "dict-callee"`
.decl air303_dict_callee(n: node)
air303_dict_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "dict"), sym_of(n, "builtins.dict").
air303_dict_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air303_dict_callee(c1).

// dict_init(n): the JSON util `dict-init`, used where the JSON says `matches: "dict-init"`
.decl air303_dict_init(n: node)
air303_dict_init(n) :- air303_dict_expr(n).
air303_dict_init(n) :- kind(n, "call"), child(n, c1, _), air303_dict_callee(c1),
    next_sibling(c1, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")).

// dict_ann(n): the JSON util `dict-ann`, used where the JSON says `matches: "dict-ann"`
.decl air303_dict_ann(n: node)
air303_dict_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")), global_ref(n, "dict"),
    sym_of(n, "builtins.dict").
air303_dict_ann(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Dict")
    ; sym_of(n, "_typeshed.Dict")
    ; sym_of(n, "typing_extensions.Dict")
    ).

air303_dict_ann(n) :- (kind(n, "subscript") ; kind(n, "generic_type")), child(n, c1, _),
    !air303_tok_follows_4(c1), air303_dict_ann(c1).
air303_dict_ann(n) :- kind(n, "parenthesized_expression"), child(n, c9, _), air303_dict_ann(c9).

// plain_target(n): the JSON util `plain-target`, used where the JSON says `matches: "plain-target"`
.decl air303_plain_target(n: node)
air303_plain_target(n) :- kind(n, "identifier").
air303_plain_target(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air303_plain_target(c1).

// dict_bound(n): the JSON util `dict-bound`, used where the JSON says `matches: "dict-bound"`
.decl air303_dict_bound(n: node)
air303_dict_bound(n) :- kind(n, "identifier"), air303_alt_7(n).

// dataset_callee(n): the JSON util `dataset-callee`, used where the JSON says `matches: "dataset-callee"`
//   F: metavariable this relation binds for the calling rule
.decl air303_dataset_callee(n: node, f: loc)
air303_dataset_callee(n, F) :- kind(n, "identifier"), node(_, n, _, _, _), F = n,
    ( sym_of(n, "airflow.Dataset")
    ; sym_of(n, "airflow.datasets.Dataset")
    ; sym_of(n, "airflow.sdk.Asset")
    ).

air303_dataset_callee(n, F) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air303_dataset_callee(c1, F).

// dict_arg(n): the JSON util `dict-arg`, used where the JSON says `matches: "dict-arg"`
.decl air303_dict_arg(n: node)
air303_dict_arg(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
air303_dict_arg(n) :- kind(n, "call"), child(n, c1, _), air303_dict_callee(c1), next_sibling(c1, s2),
    (kind(s2, "argument_list") ; kind(s2, "generator_expression")).
air303_dict_arg(n) :- kind(n, "identifier"), air303_dict_bound(n).
air303_dict_arg(n) :- kind(n, "parenthesized_expression"), child(n, c3, _), air303_dict_arg(c3).

// AIR303_get_link(n): a finding at node n, from clause `get-link`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation AIR303_get_link(at: node, name: node) code "AIR303" "Use `def get_link(self, operator, *, ti_key)` or `def get_link(self, operator, ti_key)` as the method signature that Airflow 3 expects."
    suppress noqa "AIR303"
AIR303_get_link(NAME, n) :- kind(n, "function_definition"), field(n, "name", c1),
    glob("get_link", c1), node(_, c1, _, _, _), NAME = c1, within_stop(n, p2, air303_stop_17),
    kind(p2, "class_definition"), field(p2, "superclasses", c3),
    kind(c3, "argument_list"), child(c3, c4, _), air303_link_base(c4),
    field(n, "parameters", c5), kind(c5, "parameters"), !air303_valid_signature(c5).

// link_name(n): the JSON util `link-name`, used where the JSON says `matches: "link-name"`
.decl air303_link_name(n: node)
air303_link_name(n) :- kind(n, "attribute"), field(n, "attribute", c1),
    glob("BaseOperatorLink", c1).
air303_link_name(n) :- kind(n, "identifier"),
    ( ref_site(n, b1), kind(b1, "aliased_import"), field(b1, "name", c1), child(c1, c2, _), kind(c2, "identifier"), glob("BaseOperatorLink", c2), count : { precedes(c2, s1), kind(s1, "identifier") } = 0
    ; glob("BaseOperatorLink", n), count : { ref_site(n, b2), kind(b2, "aliased_import") } = 0
    ).


// link_base(n): the JSON util `link-base`, used where the JSON says `matches: "link-base"`
.decl air303_link_base(n: node)
air303_link_base(n) :- air303_demand_link_base(n), air303_link_ref(n).
air303_link_base(n) :- air303_demand_link_base(n), kind(n, "subscript"), field(n, "value", c1),
    air303_link_ref(c1).
air303_link_base(n) :- air303_demand_link_base(n), kind(n, "parenthesized_expression"),
    child(n, c2, _), air303_link_base(c2).

// pos_param(n): the JSON util `pos-param`, used where the JSON says `matches: "pos-param"`
.decl air303_pos_param(n: node)
air303_pos_param(n) :-
    ( (kind(n, "identifier") ; kind(n, "default_parameter") ; kind(n, "typed_default_parameter"))
    ; kind(n, "typed_parameter"), count : { child(n, c1, _), (kind(c1, "list_splat_pattern") ; kind(c1, "dictionary_splat_pattern")) } = 0
    ),
    count : { precedes(s2, n), air303_alt_14(s2) } = 0.

// ti_key(n): the JSON util `ti-key`, used where the JSON says `matches: "ti-key"`
.decl air303_ti_key(n: node)
air303_ti_key(n) :- kind(n, "identifier"), glob("ti_key", n).
air303_ti_key(n) :- (kind(n, "default_parameter") ; kind(n, "typed_default_parameter")),
    field(n, "name", c1), glob("ti_key", c1).
air303_ti_key(n) :- kind(n, "typed_parameter"), child(n, c2, _), kind(c2, "identifier"),
    glob("ti_key", c2).

// valid_signature(n): the JSON util `valid-signature`, used where the JSON says `matches: "valid-signature"`
.decl air303_valid_signature(n: node)
air303_valid_signature(n) :- k2 = count : { child(n, c1, _), air303_pos_param(c1) }, k2 >= 2,
    k2 <= 2, child(n, c3, _), air303_ti_key(c3), precedes(s4, c3), air303_alt_14(s4).
air303_valid_signature(n) :- k7 = count : { child(n, c6, _), air303_pos_param(c6) }, k7 >= 3,
    k7 <= 3, child(n, c8, _), air303_ti_key(c8), air303_pos_param(c8),
    k10 = count : { precedes(s9, c8), air303_pos_param(s9) }, k10 >= 2, k10 <= 2.

// link_ref(n): the JSON util `link-ref`, used where the JSON says `matches: "link-ref"`
.decl air303_link_ref(n: node)
air303_link_ref(n) :- air303_demand_link_ref(n), (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), match("(airflow\\.models|airflow\\.sdk)(\\.|$).*", q1),
    air303_link_name(n).
air303_link_ref(n) :- air303_demand_link_ref(n), (kind(n, "identifier") ; kind(n, "attribute")),
    ref_site(n, b2), kind(b2, "class_definition"),
    count : { air303_stop_16_within(b2, p3), kind(p3, "class_definition") } = 0,
    field(b2, "superclasses", c4), kind(c4, "argument_list"), child(c4, c5, _),
    air303_link_base(c5).
air303_link_ref(n) :- air303_demand_link_ref(n), kind(n, "parenthesized_expression"),
    child(n, c6, _), air303_link_ref(c6).

.decl air303_alt_5_u0(n: node)
air303_alt_5_u0(n) :- node(_, n, _, _, _), glob("{and,or}", n).
air303_alt_5_u0(n) :- kind(n, "comment").

.decl air303_alt_5_u1(n: node)
air303_alt_5_u1(n) :- node(_, n, _, _, _), glob("{and,or}", n).
air303_alt_5_u1(n) :- kind(n, "comment").
air303_alt_5_u1(n) :- air303_dict_expr_u0(n).

.decl air303_alt_5_u2(n: node)
air303_alt_5_u2(n) :- node(_, n, _, _, _), glob("{and,or}", n).
air303_alt_5_u2(n) :- kind(n, "comment").
air303_alt_5_u2(n) :- air303_dict_expr_u1(n).

.decl air303_alt_5_u3(n: node)
air303_alt_5_u3(n) :- node(_, n, _, _, _), glob("{and,or}", n).
air303_alt_5_u3(n) :- kind(n, "comment").
air303_alt_5_u3(n) :- air303_dict_expr_u2(n).

.decl air303_alt_5_u4(n: node)
air303_alt_5_u4(n) :- node(_, n, _, _, _), glob("{and,or}", n).
air303_alt_5_u4(n) :- kind(n, "comment").
air303_alt_5_u4(n) :- air303_dict_expr_u3(n).

.decl air303_alt_5_u5(n: node)
air303_alt_5_u5(n) :- node(_, n, _, _, _), glob("{and,or}", n).
air303_alt_5_u5(n) :- kind(n, "comment").
air303_alt_5_u5(n) :- air303_dict_expr_u4(n).

.decl air303_alt_5_u6(n: node)
air303_alt_5_u6(n) :- node(_, n, _, _, _), glob("{and,or}", n).
air303_alt_5_u6(n) :- kind(n, "comment").
air303_alt_5_u6(n) :- air303_dict_expr_u5(n).

.decl air303_alt_5_u7(n: node)
air303_alt_5_u7(n) :- node(_, n, _, _, _), glob("{and,or}", n).
air303_alt_5_u7(n) :- kind(n, "comment").
air303_alt_5_u7(n) :- air303_dict_expr_u6(n).

.decl air303_dict_expr_u0(n: node)
air303_dict_expr_u0(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
air303_dict_expr_u0(n) :- kind(n, "boolean_operator"), count : { child(n, c26, _) } = 0.

.decl air303_dict_expr_u1(n: node)
air303_dict_expr_u1(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
air303_dict_expr_u1(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air303_dict_expr_u0(c1).
air303_dict_expr_u1(n) :- kind(n, "named_expression"), child(n, c2, _), air303_tok_follows_1(c2),
    air303_dict_expr_u0(c2).
air303_dict_expr_u1(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    air303_tok_precedes_2(c10), air303_dict_expr_u0(c10), child(n, c18, _), air303_tok_follows_3(c18),
    air303_dict_expr_u0(c18).
air303_dict_expr_u1(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !air303_alt_5_u0(c26) } = 0.

.decl air303_dict_expr_u2(n: node)
air303_dict_expr_u2(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
air303_dict_expr_u2(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
