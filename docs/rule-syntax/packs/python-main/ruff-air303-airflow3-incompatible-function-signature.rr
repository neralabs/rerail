air303_dict_expr_u2(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    air303_tok_precedes_2(c10), air303_dict_expr_u1(c10), child(n, c18, _), air303_tok_follows_3(c18),
    air303_dict_expr_u1(c18).
air303_dict_expr_u2(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !air303_alt_5_u1(c26) } = 0.

.decl air303_dict_expr_u3(n: node)
air303_dict_expr_u3(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
air303_dict_expr_u3(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
