.decl air303_dict_expr_u6(n: node)
air303_dict_expr_u6(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
air303_dict_expr_u6(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air303_dict_expr_u5(c1).
air303_dict_expr_u6(n) :- kind(n, "named_expression"), child(n, c2, _), air303_tok_follows_1(c2),
    air303_dict_expr_u5(c2).
air303_dict_expr_u6(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    air303_tok_precedes_2(c10), air303_dict_expr_u5(c10), child(n, c18, _), air303_tok_follows_3(c18),
    air303_dict_expr_u5(c18).
air303_dict_expr_u6(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !air303_alt_5_u5(c26) } = 0.

.decl air303_dict_expr_u7(n: node)
air303_dict_expr_u7(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
air303_dict_expr_u7(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air303_dict_expr_u6(c1).
air303_dict_expr_u7(n) :- kind(n, "named_expression"), child(n, c2, _), air303_tok_follows_1(c2),
    air303_dict_expr_u6(c2).
air303_dict_expr_u7(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    air303_tok_precedes_2(c10), air303_dict_expr_u6(c10), child(n, c18, _), air303_tok_follows_3(c18),
    air303_dict_expr_u6(c18).
air303_dict_expr_u7(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !air303_alt_5_u6(c26) } = 0.

// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^:=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air303_tok_follows_1(n: node)
.stored air303_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air303_tok_follows_1(n) :- next_sibling(s3, n), glob(":=", s3).
air303_tok_follows_1(n) :- structural_before(n, g5), match("\\s*", g5), child(p6, n, _),
    node(_, n, _, st8, _), o7 = st8 - strlen(g5), token(p6, _, t4, _, o7),
    match(":=", t4).
air303_tok_follows_1(n) :- structural_before(n, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?::=)\\s*)$", g5).

// tok_precedes_2(n): a later sibling of n, a named node or an anonymous token, matches "^if$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air303_tok_precedes_2(n: node)
.stored air303_tok_precedes_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air303_tok_precedes_2(n) :- next_sibling(n, s11), glob("if", s11).
air303_tok_precedes_2(n) :- structural_after(n, g13), match("\\s*", g13), child(p14, n, _),
    node(_, n, _, _, en17), o15 = en17 + strlen(g13), token(p14, _, t12, o15, _),
    match("if", t12).
air303_tok_precedes_2(n) :- structural_after(n, g13),
    match("(?s)^(?:\\s*(?:if)(?:\\W.*)?)$", g13).

// tok_follows_3(n): an earlier sibling of n, a named node or an anonymous token, matches "^else$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air303_tok_follows_3(n: node)
.stored air303_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air303_tok_follows_3(n) :- next_sibling(s19, n), glob("else", s19).
air303_tok_follows_3(n) :- structural_before(n, g21), match("\\s*", g21), child(p22, n, _),
    node(_, n, _, st24, _), o23 = st24 - strlen(g21), token(p22, _, t20, _, o23),
    match("else", t20).
air303_tok_follows_3(n) :- structural_before(n, g21),
    match("(?s)^(?:(?:.*\\W)?(?:else)\\s*)$", g21).

// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "(?s).": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air303_tok_follows_4(n: node)
.stored air303_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air303_tok_follows_4(n) :- next_sibling(s2, n), match("(?s).*..*", s2).
air303_tok_follows_4(n) :- structural_before(n, g4), match("\\s*", g4), child(p5, n, _),
    node(_, n, _, st7, _), o6 = st7 - strlen(g4), token(p5, _, t3, _, o6),
    match("(?s).*..*", t3).
air303_tok_follows_4(n) :- structural_before(n, g4), match("(?s)^.*\\S\\s*$", g4).

// tok_precedes_5(n): a later sibling of n, a named node or an anonymous token, matches "^as$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air303_tok_precedes_5(n: node)
.stored air303_tok_precedes_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air303_tok_precedes_5(n) :- precedes(n, s11), glob("as", s11).
air303_tok_precedes_5(n) :- child(p14, n, _), node(_, n, _, _, en17),
    token(p14, _, t12, st16, _), st16 >= en17, match("as", t12).
air303_tok_precedes_5(n) :- structural_after(n, g13),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g13).
air303_tok_precedes_5(n) :- precedes(n, o15), structural_after(o15, g13),
    match("(?s)^(?:(?:.*\\W)?(?:as)(?:\\W.*)?)$", g13).

// demand_link_base: the nodes link_base is asked at (its recursion looks at every descendant)
.decl air303_demand_link_base(n: node)
air303_demand_link_base(c4) :- kind(n, "function_definition"), field(n, "name", c1),
    glob("get_link", c1), node(_, c1, _, _, _), NAME = c1, within_stop(n, p2, air303_stop_17),
    kind(p2, "class_definition"), field(p2, "superclasses", c3),
    kind(c3, "argument_list"), child(c3, c4, _), field(n, "parameters", c5),
    kind(c5, "parameters").
air303_demand_link_base(c2) :- air303_demand_link_base(n), kind(n, "parenthesized_expression"),
    child(n, c2, _).
air303_demand_link_base(c5) :- air303_demand_link_ref(n),
    (kind(n, "identifier") ; kind(n, "attribute")), ref_site(n, b2),
    kind(b2, "class_definition"), field(b2, "superclasses", c4),
    kind(c4, "argument_list"), child(c4, c5, _).

// demand_link_ref: the nodes link_ref is asked at (its recursion looks at every descendant)
.decl air303_demand_link_ref(n: node)
air303_demand_link_ref(n) :- air303_demand_link_base(n).
air303_demand_link_ref(c1) :- air303_demand_link_base(n), kind(n, "subscript"),
    field(n, "value", c1).
air303_demand_link_ref(c6) :- air303_demand_link_ref(n), kind(n, "parenthesized_expression"),
    child(n, c6, _).

// alt_5_u0_empty: level -1 of an unrolled recursion, empty
.decl air303_alt_5_u0_empty(n: node)

// dict_expr_u0_empty: level -1 of an unrolled recursion, empty
.decl air303_dict_expr_u0_empty(n: node)

// stop_16: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl air303_stop_16(kind: symbol)
air303_stop_16("class_definition"). air303_stop_16("function_definition").

// stop_17: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl air303_stop_17(kind: symbol)
air303_stop_17("class_definition"). air303_stop_17("function_definition"). air303_stop_17("lambda").

// assigned_call_case: one row per relation folded into assigned_call: its key, then the strings that differed.
.decl air303_assigned_call_case(key: symbol)
air303_assigned_call_case("airflow"). air303_assigned_call_case("hook").
air303_assigned_call_case("lineage").

// assigned_callee_case: one row per relation folded into assigned_callee: its key, then the strings that differed.
.decl air303_assigned_callee_case(key: symbol, s1: symbol)
air303_assigned_callee_case("airflow", "airflow").
air303_assigned_callee_case("hook", "airflow.lineage.hook").
air303_assigned_callee_case("lineage", "airflow.lineage").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl air303_alt_1(n: node)
air303_alt_1(n) :- match("\\w+\\s*\\.\\s*HookLineageCollector", n), has(n, c1, "identifier"),
    ref_site(c1, b2), kind(b2, "assignment"), field(b2, "right", c3),
    air303_assigned_call(c3, "hook").
air303_alt_1(n) :- match("\\w+\\s*\\.\\s*hook\\s*\\.\\s*HookLineageCollector", n),
    has(n, c4, "identifier"), ref_site(c4, b5), kind(b5, "assignment"),
    field(b5, "right", c6), air303_assigned_call(c6, "lineage").
air303_alt_1(n) :- match("\\w+\\s*\\.\\s*lineage\\s*\\.\\s*hook\\s*\\.\\s*HookLineageCollector", n),
    has(n, c7, "identifier"), ref_site(c7, b8), kind(b8, "assignment"),
    field(b8, "right", c9), air303_assigned_call(c9, "airflow").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl air303_alt_2(n: node)
air303_alt_2(n) :- (kind(n, "comment") ; kind(n, "keyword_argument") ; kind(n, "dictionary_splat")).
air303_alt_2(n) :- node(_, n, _, _, _), glob("[(),]", n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl air303_alt_5(n: node)
air303_alt_5(n) :- air303_alt_5_u7(n).

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl air303_alt_7(n: node)
air303_alt_7(n) :- ref_site(n, b1),
    ( kind(b1, "dictionary_splat_pattern"), child(p1, b1, _), kind(p1, "parameters")
    ; kind(b1, "typed_parameter"), child(p2, b1, _), kind(p2, "parameters"), child(b1, c1, _), kind(c1, "dictionary_splat_pattern")
    ).

air303_alt_7(n) :- ref_site(n, b5), binding_value(b5, x6), air303_dict_init(x6),
    count : { child(b5, c7, _), kind(c7, "type") } = 0.
air303_alt_7(n) :- ref_site(n, b8), kind(b8, "as_pattern"), child(p9, b8, _),
    kind(p9, "with_item"), child(b8, c10, _), air303_dict_init(c10), air303_tok_precedes_5(c10),
    child(b8, c18, _), kind(c18, "as_pattern_target"), child(c18, c19, _),
    air303_plain_target(c19).
air303_alt_7(n) :- ref_site(n, b20), site_annotation(b20, o21), air303_dict_ann(o21),
    count : { child(b20, c22, _), (kind(c22, "list_splat_pattern") ; kind(c22, "dictionary_splat_pattern")) } = 0.
air303_alt_7(n) :- ref_site(n, b23), kind(b23, "function_definition"), child(b23, c24, _),
    kind(c24, "type"), child(c24, c25, _), air303_dict_ann(c25).

// stop_10(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl air303_stop_10(n: node)
air303_stop_10(n) :- node(_, n, _, _, _), !kind(n, "comment").

// alt_14(n): the JSON `any`: n matches if any one of these rules does
.decl air303_alt_14(n: node)
air303_alt_14(n) :- (kind(n, "keyword_separator") ; kind(n, "list_splat_pattern")).
air303_alt_14(n) :- kind(n, "typed_parameter"), child(n, c1, _),
    kind(c1, "list_splat_pattern").

// stop_16_within: within_stop over the stop set stop_16, read inside an aggregate
.decl air303_stop_16_within(n: node, a: node)
air303_stop_16_within(x, y) :- within_stop(x, y, air303_stop_16).
