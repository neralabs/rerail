air303_dict_expr_u4(n) :- kind(n, "boolean_operator"),
    count : { child(n, c26, _), !air303_alt_5_u3(c26) } = 0.

.decl air303_dict_expr_u5(n: node)
air303_dict_expr_u5(n) :- (kind(n, "dictionary") ; kind(n, "dictionary_comprehension")).
air303_dict_expr_u5(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air303_dict_expr_u4(c1).
air303_dict_expr_u5(n) :- kind(n, "named_expression"), child(n, c2, _), air303_tok_follows_1(c2),
    air303_dict_expr_u4(c2).
air303_dict_expr_u5(n) :- kind(n, "conditional_expression"), child(n, c10, _),
    air303_tok_precedes_2(c10), air303_dict_expr_u4(c10), child(n, c18, _), air303_tok_follows_3(c18),
    air303_dict_expr_u4(c18).
air303_dict_expr_u5(n) :- kind(n, "boolean_operator"),
