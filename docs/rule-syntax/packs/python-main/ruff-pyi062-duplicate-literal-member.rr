pyi062_tok_follows_3(n) :- precedes(s1, n), glob("[\\[(]", s1).
pyi062_tok_follows_3(n) :- child(p4, n, _), node(_, n, _, st6, _), token(p4, _, t2, _, en7),
    en7 <= st6, match("[\\[(]", t2).
pyi062_tok_follows_3(n) :- structural_before(n, g3), match("(?s)^(?:.*(?:[\\[(]).*)$", g3).
pyi062_tok_follows_3(n) :- precedes(o5, n), structural_before(o5, g3),
