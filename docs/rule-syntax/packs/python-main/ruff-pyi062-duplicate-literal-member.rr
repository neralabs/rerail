// demand_alt_5: the rows of alt_5 its callers ask for (the metavariable columns they pass in)
.decl pyi062_demand_alt_5(n: node, dup: loc)
pyi062_demand_alt_5(n, DUP) :- pyi062_demand_slots_have_equal(n, DUP), pyi062_literal(n).

// demand_contains_equal: the rows of contains_equal its callers ask for (the metavariable columns they pass in)
.decl pyi062_demand_contains_equal(n: node, dup: loc)
pyi062_demand_contains_equal(c4, DUP) :- pyi062_demand_slots_have_equal(n, DUP), pyi062_tuple_slot(n),
    kind(n, "tuple"), child(n, c4, _).
pyi062_demand_contains_equal(c6, DUP) :- pyi062_demand_slots_have_equal(n, DUP), pyi062_tuple_slot(n),
    kind(n, "type"), child(n, c5, _), kind(c5, "tuple"), child(c5, c6, _).
pyi062_demand_contains_equal(s1, DUP) :- pyi062_leaf_slot(n), pyi062_member_expr(n, DUP), precedes(s1, n).
pyi062_demand_contains_equal(s2, DUP) :- pyi062_leaf_slot(n), pyi062_member_expr(n, DUP), pyi062_up_1(n, p1),
    precedes(s2, p1).
pyi062_demand_contains_equal(c1, DUP) :- pyi062_demand_alt_5(n, DUP), kind(n, "subscript"),
    child(n, c1, _).
pyi062_demand_contains_equal(c3, DUP) :- pyi062_demand_alt_5(n, DUP), kind(n, "generic_type"),
    child(n, c2, _), kind(c2, "type_parameter"), child(c2, c3, _).

// demand_deep_slots_have_equal: the rows of deep_slots_have_equal its callers ask for (the metavariable columns they pass in)
.decl pyi062_demand_deep_slots_have_equal(n: node, dup: loc)
pyi062_demand_deep_slots_have_equal(c1, DUP) :- pyi062_demand_deep_slots_have_equal(n, DUP),
    (kind(n, "type") ; kind(n, "parenthesized_expression")), child(n, c1, _).
pyi062_demand_deep_slots_have_equal(n, DUP) :- pyi062_demand_contains_equal(n, DUP), node(_, n, _, _, _),
    pyi062_alt_6(n).

// demand_slots_have_equal: the rows of slots_have_equal its callers ask for (the metavariable columns they pass in)
.decl pyi062_demand_slots_have_equal(n: node, dup: loc)
pyi062_demand_slots_have_equal(n, DUP) :- pyi062_demand_deep_slots_have_equal(n, DUP).

// demand_equal_expr: the rows of equal_expr its callers ask for (the metavariable columns they pass in)
.decl pyi062_demand_equal_expr(n: node, dup: loc)
pyi062_demand_equal_expr(n, DUP) :- pyi062_demand_contains_equal(n, DUP), node(_, n, _, _, _), pyi062_alt_6(n).

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl pyi062_up_1(n: node, p: node)
pyi062_up_1(n, p) :- pyi062_leaf_slot(n), within_stop(n, p, pyi062_stop_12), pyi062_nested_slot(p).

// set_10: node kinds from a JSON `any`
.decl pyi062_set_10(v: symbol)
pyi062_set_10("subscript"). pyi062_set_10("generic_type"). pyi062_set_10("tuple"). pyi062_set_10("type").
pyi062_set_10("parenthesized_expression").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl pyi062_alt_2(n: node)
pyi062_alt_2(n) :- precedes(s1, n), pyi062_direct_slot(s1).
pyi062_alt_2(n) :- precedes(n, s2), pyi062_direct_slot(s2).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
//   DUP: metavariable of the calling rule, passed in (bound by the caller)
.decl pyi062_alt_5(n: node, dup: loc)
pyi062_alt_5(n, DUP) :- pyi062_demand_alt_5(n, DUP), kind(n, "subscript"), child(n, c1, _),
    pyi062_contains_equal(c1, DUP).
pyi062_alt_5(n, DUP) :- pyi062_demand_alt_5(n, DUP), kind(n, "generic_type"), child(n, c2, _),
    kind(c2, "type_parameter"), child(c2, c3, _), pyi062_contains_equal(c3, DUP).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl pyi062_alt_6(n: node)
pyi062_alt_6(n) :- kind(n, "type").
pyi062_alt_6(n) :- pyi062_tok_follows_3(n).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
//   D: metavariable this relation binds for the calling rule
.decl pyi062_alt_11(n: node, d: loc)
pyi062_alt_11(n, D) :- pyi062_duplicate_member(n, _), D = n.
pyi062_alt_11(n, D) :- pyi062_string_duplicate_member(n, D).

// stop_12(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl pyi062_stop_12(n: node)
pyi062_stop_12(n) :- node(_, n, _, _, _), !pyi062_in_literal_chain(n).

// alt_15(n): the JSON `any`: n matches if any one of these rules does
.decl pyi062_alt_15(n: node)
pyi062_alt_15(n) :- child(p1, n, _), (kind(p1, "subscript") ; kind(p1, "tuple")), node(_, n, _, _, _).
pyi062_alt_15(n) :- kind(n, "type"), child(p2, n, _), kind(p2, "type_parameter").
