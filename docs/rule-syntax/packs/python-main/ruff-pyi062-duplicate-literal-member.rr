// tok_follows_4(n): an earlier sibling of n, a named node or an anonymous token, matches "^[\\[(]$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi062_tok_follows_4(n: node)
.stored pyi062_tok_follows_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi062_tok_follows_4(n) :- precedes(s8, n), glob("[\\[(]", s8).
pyi062_tok_follows_4(n) :- child(p11, n, _), node(_, n, _, st13, _),
    token(p11, _, t9, _, en14), en14 <= st13, match("[\\[(]", t9).
pyi062_tok_follows_4(n) :- structural_before(n, g10), match("(?s)^(?:.*(?:[\\[(]).*)$", g10).
pyi062_tok_follows_4(n) :- precedes(o12, n), structural_before(o12, g10),
