.policy "ruff-ruf001-ambiguous-unicode-character-string" revision 1
.guests off
.description "Avoid look-alike Unicode characters in string literals; they read like ASCII letters or punctuation but are different characters."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl ruf001_plain_string(n: node)
ruf001_plain_string(n) :- kind(n, "string"), match("[rRuU]{0,2}['\"].*", n).

// string_expression(n): the JSON util `string-expression`, used where the JSON says `matches: "string-expression"`
.decl ruf001_string_expression(n: node)
ruf001_string_expression(n) :- ruf001_plain_string(n).
ruf001_string_expression(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), !ruf001_plain_string(c1) } = 0.
ruf001_string_expression(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    ruf001_string_expression(c2).

// docstring_statement(n): the JSON util `docstring-statement`, used where the JSON says `matches: "docstring-statement"`
.decl ruf001_docstring_statement(n: node)
ruf001_docstring_statement(n) :- kind(n, "expression_statement"), child(n, c1, _),
    ruf001_string_expression(c1), !ruf001_tok_has_1(n), child(p10, n, _), ruf001_counted_1(n),
    k12 = count : { child(p10, s11, _), precedes(s11, n), ruf001_counted_1(s11) }, k12 = 0,
    ( child(p1, n, _), kind(p1, "module")
    ; child(p2, n, _), kind(p2, "block"), child(p3, p2, _), (kind(p3, "function_definition") ; kind(p3, "class_definition"))
    ).


// future_annotations(n): the JSON util `future-annotations`, used where the JSON says `matches: "future-annotations"`
.decl ruf001_future_annotations(n: node)
ruf001_future_annotations(n) :- kind(n, "future_import_statement"), child(n, c1, _),
    ( kind(c1, "dotted_name"), glob("annotations", c1)
    ; kind(c1, "aliased_import"), child(c1, c2, _), kind(c2, "dotted_name"), glob("annotations", c2)
    ).


// future_seen(n): the JSON util `future-seen`, used where the JSON says `matches: "future-seen"`
.decl ruf001_future_seen(n: node)
ruf001_future_seen(n) :- ruf001_demand_future_seen(n), within(n, p1), precedes(s2, p1),
    ruf001_future_annotations(s2).

// string_annotation(n): the JSON util `string-annotation`, used where the JSON says `matches: "string-annotation"`
.decl ruf001_string_annotation(n: node)
ruf001_string_annotation(n) :- kind(n, "type"), child(n, c1, _), ruf001_string_expression(c1),
    ( field(p1, "type", n), (kind(p1, "typed_parameter") ; kind(p1, "typed_default_parameter") ; kind(p1, "assignment"))
    ; field(p2, "return_type", n), kind(p2, "function_definition")
    ).


// in_string_annotation(n): the JSON util `in-string-annotation`, used where the JSON says `matches: "in-string-annotation"`
.decl ruf001_in_string_annotation(n: node)
ruf001_in_string_annotation(n) :- ruf001_demand_in_string_annotation(n), ruf001_up_1(n, p1).

// string_text(n): the JSON util `string-text`, used where the JSON says `matches: "string-text"`
.decl ruf001_string_text(n: node)
ruf001_string_text(n) :- kind(n, "string_content"), child(p1, n, _), kind(p1, "string"),
    match("[rRuUfFtT]{0,2}['\"].*", p1),
    count : { within(n, p2), ruf001_docstring_statement(p2) } = 0.

// symbol(n): the JSON util `symbol`, used where the JSON says `matches: "symbol"`
//   CH: metavariable this relation binds for the calling rule
.decl ruf001_symbol(n: node, ch: loc)
ruf001_symbol(n, CH) :- node(_, n, _, _, _),
    match(".*(?P<CH>[\\x{a0}´¸×˂-˄˗˛˜˴˸;΄՚՝։׀׃׳؍٫٭۔܁-܄᐀᙭᙮\\x{1680}᛬᛭᜵᠃᠉᾽᾿῀`´῾\\x{2000}-\\x{200a}‐-–‘-‛․\\x{2028}\\x{2029}\\x{202f}′‵‹›⁁⁃⁄⁎⁓⁚\\x{205f}℮−∕-∗∣∨∪∶∼⊤⋁⋃⋿⍳⍴⍺⏽╱╳❨❩❮❯❲-❵➕➖⟋⟍⟙⤫⤬⧵⧸⧹⨯⹀⼂⼃〔〕゠㇓㇔꓿꘎꞉﴾﴿︰﹍-﹏﹘﹨！-／：-＠［-｀｛-～￨𐩐𝄔\\x{1d16d}𝈆𝈍𝈏𝈒𝈓𝈖𝈪𝈶𝈷𝈺𝈻🝌🝨]).*", n).

