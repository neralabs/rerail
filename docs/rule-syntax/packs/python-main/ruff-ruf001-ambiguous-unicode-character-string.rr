//   CH: metavariable this relation binds for the calling rule
.decl ruf001_before_ascii(n: node, ch: loc)
ruf001_before_ascii(n, CH) :- node(_, n, _, _, _),
    match(".*(?:^|[^\\p{Alphabetic}\\p{N}])[[\\p{Alphabetic}\\p{N}]--[0-9A-Za-z]]*?(?P<CH>[ıſƄƍƦƧƷƼƽǀǃȜȢȣɁɑɡɣɩɪɯʋʏʔʹʻ-ʾˆˈˊˋːʹͺͿΑΒΕ-ΗΙΚΜΝΟΡΤΥΧαγινορσυϒϜϨϱ-ϳϹϺЅІЈАВЕЗКМ-ОР-УХЬабгеорсухѕіјѡѴѵҮүһҽӀӏӠԁԌԛ-ԝՍՏՕագզհոռսցքօוטיןסاه٠١٥٧ھہە۰۱۵۷߀ߊߴߵߺ\\x{903}०ॽ০৪৭੦੧੪\\x{a83}૦\\x{b03}ଠ୦୨௦\\x{c02}౦\\x{c82}೦\\x{d02}ഠ൦൭\\x{d82}๐໐ဝ၀ყჿሀዐᎠ-ᎢᎥᎩ-ᎬᎮᎳᎷᎻᎽᏀᏂᏃᏎᏏᏒᏔᏕᏙᏚᏞᏟᏢᏦᏧᏮᏳᏴᐯᐳᐸᑊᑌᑭᑯᑲᒍᒪᒿᕁᕼᕽᖇᖯᖴᗅᗞᗪᗰᗷᚲᚷᛁᛌᛕᛖᴄᴏᴑᴜᴠ-ᴢᴦᶃᶌẝỿιℂℊ-ℎℐ-ℓℕℙ-ℝℤℨKℬℭℯ-ℱℳℴℹℽⅅ-ⅉⅠⅤⅩⅬ-ⅰⅴⅹⅼ-ⅾⲅⲎⲒⲔⲘⲚⲞⲟⲢ-ⲦⲨⲬⲺⳆⳊⳌⳐⳒⴸⴹⵏⵑⵔⵕⵝ〇〳ノ丶丿ꓐ-ꓔꓖꓗꓙꓚꓜꓝꓟ-ꓣꓦꓧꓪ-ꓬꓮꓰꓲ-ꓴꓸꓹꓽꙄꙇꛟꛫꛯꜱꝚꝪꝮꝸꞌꞘꞙꞟꞫꞲ-Ꞵꬲꬵꬽꭇꭈꭎꭒꭚꭵꮁꮃꮓꮩꮪꮯﮦ-ﮭﺍﺎﻩ-ﻬ０-９Ａ-Ｚａ-ｚ𐊂𐊆𐊇𐊊𐊐𐊒𐊕-𐊗𐊛𐊠-𐊢𐊥𐊫𐊰-𐊲𐊴𐋏𐋵𐌁𐌂𐌉𐌑𐌕𐌗𐌚𐌟𐌠𐌢𐐄𐐕𐐛𐐠𐐬𐐽𐑈𐒴𐓂𐓎𐓒𐓪𐓶𐔓𐔖𐔘𐔜𐔝𐔥-𐔧𑓐𑜆𑜊𑜎𑜏𑢠𑢢-𑢤𑢦𑢩𑢬𑢮𑢯𑢲𑢵𑢸𑢻𑢼𑣀-𑣄𑣆𑣈𑣊𑣌𑣕-𑣘𑣜𑣠𑣥𑣦𑣩𑣬𑣯𑣲𖼈𖼊𖼖𖼨𖼵𖼺𖼻𖼿𖽀𖽂𖽃\\x{16f51}\\x{16f52}𝐀-𝑔𝑖-𝑙𝑛-𝒍𝒏-𝒜𝒞𝒟𝒢𝒥𝒦𝒩-𝒬𝒮-𝒹𝒻𝒽-𝓁𝓃𝓅-𝓵𝓷-𝔅𝔇-𝔊𝔍-𝔔𝔖-𝔜𝔞-𝔩𝔫-𝔹𝔻-𝔾𝕀-𝕄𝕆𝕊-𝕐𝕒-𝕝𝕟-𝖑𝖓-𝗅𝗇-𝗹𝗻-𝘭𝘯-𝙡𝙣-𝚕𝚗-𝚤𝚨𝚩𝚬-𝚮𝚰𝚱𝚳𝚴𝚶𝚸𝚻𝚼𝚾𝛂𝛄𝛊𝛎𝛐𝛒𝛔𝛖𝛠𝛢𝛣𝛦-𝛨𝛪𝛫𝛭𝛮𝛰𝛲𝛵𝛶𝛸𝛼𝛾𝜄𝜈𝜊𝜌𝜎𝜐𝜚𝜜𝜝𝜠-𝜢𝜤𝜥𝜧𝜨𝜪𝜬𝜯𝜰𝜲𝜶𝜸𝜾𝝂𝝄𝝆𝝈𝝊𝝔𝝖𝝗𝝚-𝝜𝝞𝝟𝝡𝝢𝝤𝝦𝝩𝝪𝝬𝝰𝝲𝝸𝝼𝝾𝞀𝞂𝞄𝞎𝞐𝞑𝞔-𝞖𝞘𝞙𝞛𝞜𝞞𝞠𝞣𝞤𝞦𝞪𝞬𝞲𝞶𝞸𝞺𝞼𝞾𝟈𝟊𝟎-𝟿𞣇𞣋𞸀𞸤𞹤𞺀𞺄🯰-🯹])[\\p{Alphabetic}\\p{N}]*?[0-9A-Za-z].*", n).

// single(n): the JSON util `single`, used where the JSON says `matches: "single"`
//   CH: metavariable this relation binds for the calling rule
.decl ruf001_single(n: node, ch: loc)
ruf001_single(n, CH) :- node(_, n, _, _, _),
    match(".*(?:^|[^\\p{Alphabetic}\\p{N}]|\\b)(?P<CH>[ıſƄƍƦƧƷƼƽǀǃȜȢȣɁɑɡɣɩɪɯʋʏʔʹʻ-ʾˆˈˊˋːʹͺͿΑΒΕ-ΗΙΚΜΝΟΡΤΥΧαγινορσυϒϜϨϱ-ϳϹϺЅІЈАВЕЗКМ-ОР-УХЬабгеорсухѕіјѡѴѵҮүһҽӀӏӠԁԌԛ-ԝՍՏՕագզհոռսցքօוטיןסاه٠١٥٧ھہە۰۱۵۷߀ߊߴߵߺ\\x{903}०ॽ০৪৭੦੧੪\\x{a83}૦\\x{b03}ଠ୦୨௦\\x{c02}౦\\x{c82}೦\\x{d02}ഠ൦൭\\x{d82}๐໐ဝ၀ყჿሀዐᎠ-ᎢᎥᎩ-ᎬᎮᎳᎷᎻᎽᏀᏂᏃᏎᏏᏒᏔᏕᏙᏚᏞᏟᏢᏦᏧᏮᏳᏴᐯᐳᐸᑊᑌᑭᑯᑲᒍᒪᒿᕁᕼᕽᖇᖯᖴᗅᗞᗪᗰᗷᚲᚷᛁᛌᛕᛖᴄᴏᴑᴜᴠ-ᴢᴦᶃᶌẝỿιℂℊ-ℎℐ-ℓℕℙ-ℝℤℨKℬℭℯ-ℱℳℴℹℽⅅ-ⅉⅠⅤⅩⅬ-ⅰⅴⅹⅼ-ⅾⲅⲎⲒⲔⲘⲚⲞⲟⲢ-ⲦⲨⲬⲺⳆⳊⳌⳐⳒⴸⴹⵏⵑⵔⵕⵝ〇〳ノ丶丿ꓐ-ꓔꓖꓗꓙꓚꓜꓝꓟ-ꓣꓦꓧꓪ-ꓬꓮꓰꓲ-ꓴꓸꓹꓽꙄꙇꛟꛫꛯꜱꝚꝪꝮꝸꞌꞘꞙꞟꞫꞲ-Ꞵꬲꬵꬽꭇꭈꭎꭒꭚꭵꮁꮃꮓꮩꮪꮯﮦ-ﮭﺍﺎﻩ-ﻬ０-９Ａ-Ｚａ-ｚ𐊂𐊆𐊇𐊊𐊐𐊒𐊕-𐊗𐊛𐊠-𐊢𐊥𐊫𐊰-𐊲𐊴𐋏𐋵𐌁𐌂𐌉𐌑𐌕𐌗𐌚𐌟𐌠𐌢𐐄𐐕𐐛𐐠𐐬𐐽𐑈𐒴𐓂𐓎𐓒𐓪𐓶𐔓𐔖𐔘𐔜𐔝𐔥-𐔧𑓐𑜆𑜊𑜎𑜏𑢠𑢢-𑢤𑢦𑢩𑢬𑢮𑢯𑢲𑢵𑢸𑢻𑢼𑣀-𑣄𑣆𑣈𑣊𑣌𑣕-𑣘𑣜𑣠𑣥𑣦𑣩𑣬𑣯𑣲𖼈𖼊𖼖𖼨𖼵𖼺𖼻𖼿𖽀𖽂𖽃\\x{16f51}\\x{16f52}𝐀-𝑔𝑖-𝑙𝑛-𝒍𝒏-𝒜𝒞𝒟𝒢𝒥𝒦𝒩-𝒬𝒮-𝒹𝒻𝒽-𝓁𝓃𝓅-𝓵𝓷-𝔅𝔇-𝔊𝔍-𝔔𝔖-𝔜𝔞-𝔩𝔫-𝔹𝔻-𝔾𝕀-𝕄𝕆𝕊-𝕐𝕒-𝕝𝕟-𝖑𝖓-𝗅𝗇-𝗹𝗻-𝘭𝘯-𝙡𝙣-𝚕𝚗-𝚤𝚨𝚩𝚬-𝚮𝚰𝚱𝚳𝚴𝚶𝚸𝚻𝚼𝚾𝛂𝛄𝛊𝛎𝛐𝛒𝛔𝛖𝛠𝛢𝛣𝛦-𝛨𝛪𝛫𝛭𝛮𝛰𝛲𝛵𝛶𝛸𝛼𝛾𝜄𝜈𝜊𝜌𝜎𝜐𝜚𝜜𝜝𝜠-𝜢𝜤𝜥𝜧𝜨𝜪𝜬𝜯𝜰𝜲𝜶𝜸𝜾𝝂𝝄𝝆𝝈𝝊𝝔𝝖𝝗𝝚-𝝜𝝞𝝟𝝡𝝢𝝤𝝦𝝩𝝪𝝬𝝰𝝲𝝸𝝼𝝾𝞀𝞂𝞄𝞎𝞐𝞑𝞔-𝞖𝞘𝞙𝞛𝞜𝞞𝞠𝞣𝞤𝞦𝞪𝞬𝞲𝞶𝞸𝞺𝞼𝞾𝟈𝟊𝟎-𝟿𞣇𞣋𞸀𞸤𞹤𞺀𞺄🯰-🯹])(?:$|[^\\p{Alphabetic}\\p{N}]).*", n).

// unambiguous(n): the JSON util `unambiguous`, used where the JSON says `matches: "unambiguous"`
.decl ruf001_unambiguous(n: node)
ruf001_unambiguous(n) :- node(_, n, _, _, _),
    match(".*[[\\p{Alphabetic}\\p{N}]--[\\x00-\\x7f]--[ıſƄƍƦƧƷƼƽǀǃȜȢȣɁɑɡɣɩɪɯʋʏʔʹʻ-ʾˆˈˊˋːʹͺͿΑΒΕ-ΗΙΚΜΝΟΡΤΥΧαγινορσυϒϜϨϱ-ϳϹϺЅІЈАВЕЗКМ-ОР-УХЬабгеорсухѕіјѡѴѵҮүһҽӀӏӠԁԌԛ-ԝՍՏՕագզհոռսցքօוטיןסاه٠١٥٧ھہە۰۱۵۷߀ߊߴߵߺ\\x{903}०ॽ০৪৭੦੧੪\\x{a83}૦\\x{b03}ଠ୦୨௦\\x{c02}౦\\x{c82}೦\\x{d02}ഠ൦൭\\x{d82}๐໐ဝ၀ყჿሀዐᎠ-ᎢᎥᎩ-ᎬᎮᎳᎷᎻᎽᏀᏂᏃᏎᏏᏒᏔᏕᏙᏚᏞᏟᏢᏦᏧᏮᏳᏴᐯᐳᐸᑊᑌᑭᑯᑲᒍᒪᒿᕁᕼᕽᖇᖯᖴᗅᗞᗪᗰᗷᚲᚷᛁᛌᛕᛖᴄᴏᴑᴜᴠ-ᴢᴦᶃᶌẝỿιℂℊ-ℎℐ-ℓℕℙ-ℝℤℨKℬℭℯ-ℱℳℴℹℽⅅ-ⅉⅠⅤⅩⅬ-ⅰⅴⅹⅼ-ⅾⲅⲎⲒⲔⲘⲚⲞⲟⲢ-ⲦⲨⲬⲺⳆⳊⳌⳐⳒⴸⴹⵏⵑⵔⵕⵝ〇〳ノ丶丿ꓐ-ꓔꓖꓗꓙꓚꓜꓝꓟ-ꓣꓦꓧꓪ-ꓬꓮꓰꓲ-ꓴꓸꓹꓽꙄꙇꛟꛫꛯꜱꝚꝪꝮꝸꞌꞘꞙꞟꞫꞲ-Ꞵꬲꬵꬽꭇꭈꭎꭒꭚꭵꮁꮃꮓꮩꮪꮯﮦ-ﮭﺍﺎﻩ-ﻬ０-９Ａ-Ｚａ-ｚ𐊂𐊆𐊇𐊊𐊐𐊒𐊕-𐊗𐊛𐊠-𐊢𐊥𐊫𐊰-𐊲𐊴𐋏𐋵𐌁𐌂𐌉𐌑𐌕𐌗𐌚𐌟𐌠𐌢𐐄𐐕𐐛𐐠𐐬𐐽𐑈𐒴𐓂𐓎𐓒𐓪𐓶𐔓𐔖𐔘𐔜𐔝𐔥-𐔧𑓐𑜆𑜊𑜎𑜏𑢠𑢢-𑢤𑢦𑢩𑢬𑢮𑢯𑢲𑢵𑢸𑢻𑢼𑣀-𑣄𑣆𑣈𑣊𑣌𑣕-𑣘𑣜𑣠𑣥𑣦𑣩𑣬𑣯𑣲𖼈𖼊𖼖𖼨𖼵𖼺𖼻𖼿𖽀𖽂𖽃\\x{16f51}\\x{16f52}𝐀-𝑔𝑖-𝑙𝑛-𝒍𝒏-𝒜𝒞𝒟𝒢𝒥𝒦𝒩-𝒬𝒮-𝒹𝒻𝒽-𝓁𝓃𝓅-𝓵𝓷-𝔅𝔇-𝔊𝔍-𝔔𝔖-𝔜𝔞-𝔩𝔫-𝔹𝔻-𝔾𝕀-𝕄𝕆𝕊-𝕐𝕒-𝕝𝕟-𝖑𝖓-𝗅𝗇-𝗹𝗻-𝘭𝘯-𝙡𝙣-𝚕𝚗-𝚤𝚨𝚩𝚬-𝚮𝚰𝚱𝚳𝚴𝚶𝚸𝚻𝚼𝚾𝛂𝛄𝛊𝛎𝛐𝛒𝛔𝛖𝛠𝛢𝛣𝛦-𝛨𝛪𝛫𝛭𝛮𝛰𝛲𝛵𝛶𝛸𝛼𝛾𝜄𝜈𝜊𝜌𝜎𝜐𝜚𝜜𝜝𝜠-𝜢𝜤𝜥𝜧𝜨𝜪𝜬𝜯𝜰𝜲𝜶𝜸𝜾𝝂𝝄𝝆𝝈𝝊𝝔𝝖𝝗𝝚-𝝜𝝞𝝟𝝡𝝢𝝤𝝦𝝩𝝪𝝬𝝰𝝲𝝸𝝼𝝾𝞀𝞂𝞄𝞎𝞐𝞑𝞔-𝞖𝞘𝞙𝞛𝞜𝞞𝞠𝞣𝞤𝞦𝞪𝞬𝞲𝞶𝞸𝞺𝞼𝞾𝟈𝟊𝟎-𝟿𞣇𞣋𞸀𞸤𞹤𞺀𞺄🯰-🯹]].*", n).

// with_unambiguous(n): the JSON util `with-unambiguous`, used where the JSON says `matches: "with-unambiguous"`
//   CH: metavariable this relation binds for the calling rule
.decl ruf001_with_unambiguous(n: node, ch: loc)
ruf001_with_unambiguous(n, CH) :- ruf001_unambiguous(n),
    (ruf001_symbol(n, CH) ; ruf001_after_ascii(n, CH) ; ruf001_before_ascii(n, CH) ; ruf001_single(n, CH)).

// without_unambiguous(n): the JSON util `without-unambiguous`, used where the JSON says `matches: "without-unambiguous"`
//   CH: metavariable this relation binds for the calling rule
.decl ruf001_without_unambiguous(n: node, ch: loc)
ruf001_without_unambiguous(n, CH) :- !ruf001_unambiguous(n), (ruf001_symbol(n, CH) ; ruf001_any_letter(n, CH)).

// RUF001(n): findings from clauses `with-unambiguous`, `without-unambiguous`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation RUF001(at: node, ch: node) "Replace the look-alike character `{ch}` in this string with the ASCII character it imitates, unless the text is meant to hold it (for example a word in another language)."
    suppress noqa "RUF001"
RUF001_raw(CH, n) :- ruf001_string_text(n),
    count : { ruf001_in_string_annotation(n), ruf001_future_seen(n) } = 0, ruf001_with_unambiguous(n, CH).
RUF001_raw(CH, n) :- ruf001_string_text(n),
    count : { ruf001_in_string_annotation(n), ruf001_future_seen(n) } = 0,
    ruf001_without_unambiguous(n, CH).

// RUF001_with_unambiguous_stub(n): findings from clauses `with-unambiguous-stub`, `without-unambiguous-stub`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation RUF001_with_unambiguous_stub(at: node, ch: node) code "RUF001" "Replace the look-alike character `{ch}` in this string with the ASCII character it imitates, unless the text is meant to hold it (for example a word in another language)."
    suppress noqa "RUF001"
RUF001_with_unambiguous_stub_raw(CH, n) :- ruf001_string_text(n), !ruf001_in_string_annotation(n),
    ruf001_with_unambiguous(n, CH).
RUF001_with_unambiguous_stub_raw(CH, n) :- ruf001_string_text(n), !ruf001_in_string_annotation(n),
    ruf001_without_unambiguous(n, CH).

// RUF001_with_unambiguous_deferred_annotations(n): findings from clauses `with-unambiguous-deferred-annotations`, `without-unambiguous-deferred-annotations`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation RUF001_with_unambiguous_deferred_annotations(at: node, ch: node) code "RUF001" "Replace the look-alike character `{ch}` in this string with the ASCII character it imitates, unless the text is meant to hold it (for example a word in another language)."
    suppress noqa "RUF001"
RUF001_with_unambiguous_deferred_annotations_raw(CH, n) :- ruf001_string_text(n),
    !ruf001_in_string_annotation(n), ruf001_with_unambiguous(n, CH).
RUF001_with_unambiguous_deferred_annotations_raw(CH, n) :- ruf001_string_text(n),
    !ruf001_in_string_annotation(n), ruf001_without_unambiguous(n, CH).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf001_tok_has_1(n: node)
.stored ruf001_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf001_tok_has_1(n) :- child(n, c2, _), glob("\\,", c2).
ruf001_tok_has_1(n) :- op(n, t3), match(",", t3).
ruf001_tok_has_1(n) :- child(n, c9, _), structural_before(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
ruf001_tok_has_1(n) :- child(n, c9, _), structural_after(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
ruf001_tok_has_1(n) :- node_text(n, g4), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g4).

// demand_in_string_annotation: the nodes in_string_annotation is asked at (it looks at every ancestor of every node)
.decl ruf001_demand_in_string_annotation(n: node)
ruf001_demand_in_string_annotation(n) :- ruf001_string_text(n), ruf001_with_unambiguous(n, CH),
    ruf001_future_seen(n).
ruf001_demand_in_string_annotation(n) :- ruf001_string_text(n), ruf001_without_unambiguous(n, CH),
    ruf001_future_seen(n).
ruf001_demand_in_string_annotation(n) :- ruf001_string_text(n), ruf001_with_unambiguous(n, CH).
ruf001_demand_in_string_annotation(n) :- ruf001_string_text(n), ruf001_without_unambiguous(n, CH).

// demand_future_seen: the nodes future_seen is asked at (it looks at every ancestor of every node)
.decl ruf001_demand_future_seen(n: node)
ruf001_demand_future_seen(n) :- ruf001_string_text(n), ruf001_with_unambiguous(n, CH).
ruf001_demand_future_seen(n) :- ruf001_string_text(n), ruf001_without_unambiguous(n, CH).

// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl ruf001_up_1(n: node, p: node)
ruf001_up_1(n, p) :- ruf001_demand_in_string_annotation(n), within(n, p), ruf001_string_annotation(p).

// counted_1(n): the siblings the JSON `nthChild.ofRule` counts
.decl ruf001_counted_1(n: node)
ruf001_counted_1(n) :- node(_, n, _, _, _), !kind(n, "comment").

// main's file condition {"notRegex": "\\.pyi$"}
.decl RUF001_raw(at: node, ch: node)
RUF001(v0, v1) :- RUF001_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).

// main's file condition {"regex": "\\.pyi$"}
.decl RUF001_with_unambiguous_stub_raw(at: node, ch: node)
RUF001_with_unambiguous_stub(v0, v1) :- RUF001_with_unambiguous_stub_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).

// pythonVersion {"min": "3.14"} excludes Python 3.10, main's default: no findings.
.decl RUF001_with_unambiguous_deferred_annotations_raw(at: node, ch: node)
