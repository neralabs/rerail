.policy "ruff-pgh003-blanket-type-ignore" revision 1
.guests off
.description "Give type-ignore comments specific error codes instead of silencing every type error on the line; a blanket ignore hides new, unrelated problems."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// PGH003(n): findings from clauses `blanket-type-ignore`, `second-blanket-type-ignore`, `third-blanket-type-ignore`, which say the same.
// Each rule is one way a JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation PGH003(at: node, d: node) "Name the error in brackets after `ignore`, as in `# type: ignore[attr-defined]` or `# pyright: ignore[reportAttributeAccessIssue]`, so other errors on this line still surface."
    suppress noqa "PGH003"
PGH003(D, n) :- kind(n, "comment"),
    match(".*(?<D>#\\s*(?:type|pyright):\\s*ignore\\s*(?:#.*)?)", n).
PGH003(D, n) :- kind(n, "comment"),
    match(".*#\\s*(?:type|pyright):\\s*ignore\\s*(?:#.*?)??(?<D>#\\s*(?:type|pyright):\\s*ignore\\s*(?:#.*)?)", n).
PGH003(D, n) :- kind(n, "comment"),
    match(".*#\\s*(?:type|pyright):\\s*ignore\\s*(?:#.*?)??#\\s*(?:type|pyright):\\s*ignore\\s*(?:#.*?)??(?<D>#\\s*(?:type|pyright):\\s*ignore\\s*(?:#.*)?)", n).
