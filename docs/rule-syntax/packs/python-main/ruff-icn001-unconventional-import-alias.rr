.policy "ruff-icn001-unconventional-import-alias" revision 1
.guests off
.description "Import well-known libraries under their community aliases, such as pandas as pd, numpy as np and matplotlib.pyplot as plt, so readers recognize them at a glance."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// ICN001(n): a finding at node n, from clause `import-statement`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `transform` computes E, E0, E1, E10, E11, E12, E13, E14, E2, E3, E4, E5, E6, E7, E8, E9 from other metavariables' text; its literals end each rule.
.violation ICN001(at: node, mod: loc, e: symbol) "Write `import {mod} as {e}` and rename its uses to match; keep the current name only if `{e}` already means something else in this module."
    suppress noqa "ICN001"
ICN001(n, MOD, E) :- icn001_key(n), node(_, n, _, _, _), MOD = n, child(p2, n, _), kind(p2, "import_statement"),
    text(MOD, t1), E0 = @replace_all(t1, "^altair$", "alt"),
    E1 = @replace_all(E0, "^matplotlib$", "mpl"),
    E2 = @replace_all(E1, "^matplotlib[\\s\\\\]*\\.[\\s\\\\]*pyplot$", "plt"),
    E3 = @replace_all(E2, "^networkx$", "nx"), E4 = @replace_all(E3, "^numpy$", "np"),
    E5 = @replace_all(E4, "^numpy[\\s\\\\]*\\.[\\s\\\\]*typing$", "npt"),
    E6 = @replace_all(E5, "^pandas$", "pd"), E7 = @replace_all(E6, "^seaborn$", "sns"),
    E8 = @replace_all(E7, "^tensorflow$", "tf"),
    E9 = @replace_all(E8, "^tkinter$", "tk"),
    E10 = @replace_all(E9, "^holoviews$", "hv"),
    E11 = @replace_all(E10, "^panel$", "pn"),
    E12 = @replace_all(E11, "^plotly[\\s\\\\]*\\.[\\s\\\\]*express$", "px"),
    E13 = @replace_all(E12, "^polars$", "pl"),
    E14 = @replace_all(E13, "^pyarrow$", "pa"),
    E = @replace_all(E14, "^xml[\\s\\\\]*\\.[\\s\\\\]*etree[\\s\\\\]*\\.[\\s\\\\]*ElementTree$", "ET").
ICN001(n, MOD, E) :- kind(n, "identifier"), node(_, n, _, _, _), ALIAS = n, field(p3, "alias", n),
    kind(p3, "aliased_import"), field(p3, "name", c4), icn001_key(c4), node(_, c4, _, _, _), MOD = c4,
    text(ALIAS, t5), t5 != E, text(MOD, t1), E0 = @replace_all(t1, "^altair$", "alt"),
    E1 = @replace_all(E0, "^matplotlib$", "mpl"),
    E2 = @replace_all(E1, "^matplotlib[\\s\\\\]*\\.[\\s\\\\]*pyplot$", "plt"),
    E3 = @replace_all(E2, "^networkx$", "nx"), E4 = @replace_all(E3, "^numpy$", "np"),
    E5 = @replace_all(E4, "^numpy[\\s\\\\]*\\.[\\s\\\\]*typing$", "npt"),
    E6 = @replace_all(E5, "^pandas$", "pd"), E7 = @replace_all(E6, "^seaborn$", "sns"),
    E8 = @replace_all(E7, "^tensorflow$", "tf"),
    E9 = @replace_all(E8, "^tkinter$", "tk"),
    E10 = @replace_all(E9, "^holoviews$", "hv"),
    E11 = @replace_all(E10, "^panel$", "pn"),
    E12 = @replace_all(E11, "^plotly[\\s\\\\]*\\.[\\s\\\\]*express$", "px"),
    E13 = @replace_all(E12, "^polars$", "pl"),
    E14 = @replace_all(E13, "^pyarrow$", "pa"),
    E = @replace_all(E14, "^xml[\\s\\\\]*\\.[\\s\\\\]*etree[\\s\\\\]*\\.[\\s\\\\]*ElementTree$", "ET").

// key(n): the JSON util `key`, used where the JSON says `matches: "key"`
.decl icn001_key(n: node)
icn001_key(n) :- kind(n, "dotted_name"),
    match("(?:altair|matplotlib(?:[\\s\\\\]*\\.[\\s\\\\]*pyplot)?|networkx|numpy(?:[\\s\\\\]*\\.[\\s\\\\]*typing)?|pandas|seaborn|tensorflow|tkinter|holoviews|panel|plotly[\\s\\\\]*\\.[\\s\\\\]*express|polars|pyarrow|xml[\\s\\\\]*\\.[\\s\\\\]*etree[\\s\\\\]*\\.[\\s\\\\]*ElementTree)", n),
    inside(n, p1, "import_statement").

// ICN001_from_import(n): a finding at node n, from clause `from-import`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// The JSON `transform` computes E, E0, E1, E2 from other metavariables' text; its literals end each rule.
.violation ICN001_from_import(at: node, pkg: loc, mod: loc, e: symbol) code "ICN001" "Write `from {pkg} import {mod} as {e}` and rename its uses to match; keep the current name only if `{e}` already means something else in this module."
    suppress noqa "ICN001"
ICN001_from_import(n, PKG, MOD, E) :- node(_, MOD, _, _, _),
    inside(n, p2, "import_from_statement"), field(p2, "module_name", c3), node(_, c3, _, _, _), PKG = c3,
    ( icn001_member(n), node(_, n, _, _, _), MOD = n, child(p1_1, n, _), kind(p1_1, "import_from_statement")
    ; kind(n, "identifier"), node(_, n, _, _, _), ALIAS = n, field(p2_2, "alias", n), kind(p2_2, "aliased_import"), field(p2_2, "name", c3_2), icn001_member(c3_2), node(_, c3_2, _, _, _), MOD = c3_2, text(ALIAS, t4_2), t4_2 != E
    ),
    text(MOD, t1), E0 = @replace_all(t1, "^pyplot$", "plt"),
    E1 = @replace_all(E0, "^typing$", "npt"), E2 = @replace_all(E1, "^express$", "px"),
    E = @replace_all(E2, "^ElementTree$", "ET").

// member(n): the JSON util `member`, used where the JSON says `matches: "member"`
.decl icn001_member(n: node)
icn001_member(n) :- kind(n, "dotted_name"), icn001_alt_1(n).

// ICN001_non_ascii_spelling(n): a finding at node n, from clause `non-ascii-spelling`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation ICN001_non_ascii_spelling(at: node, mod: loc) code "ICN001" "Spell `{mod}` in plain ASCII, import it under its conventional alias (such as `import pandas as pd`) and rename its uses to match."
    suppress noqa "ICN001"
ICN001_non_ascii_spelling(n, MOD) :- icn001_spelled(n), node(_, n, _, _, _), MOD = n, child(p1, n, _),
    kind(p1, "import_statement").
ICN001_non_ascii_spelling(n, MOD) :- icn001_spelled(n), node(_, n, _, _, _), MOD = n, child(p2, n, _),
    kind(p2, "import_from_statement"), precedes(s3, n), kind(s3, "dotted_name").
ICN001_non_ascii_spelling(n, MOD) :- kind(n, "identifier"), node(_, n, _, _, _), ALIAS = n,
    field(p4, "alias", n), kind(p4, "aliased_import"), field(p4, "name", c5),
    icn001_spelled(c5), node(_, c5, _, _, _), MOD = c5,
    !glob("{alt,mpl,plt,nx,np,npt,pd,sns,tf,tk,hv,pn,px,pl,pa,ET}", n).

// spelled(n): the JSON util `spelled`, used where the JSON says `matches: "spelled"`
.decl icn001_spelled(n: node)
icn001_spelled(n) :- kind(n, "dotted_name"), imported_sym(n, q1), icn001_set_3(q1),
    ( match(".*[^\\x00-\\x7f].*", n)
    ; inside(n, p1, "import_from_statement"), field(p1, "module_name", c1), match(".*[^\\x00-\\x7f].*", c1)
    ).


// set_3: symbols from the JSON `resolves.imported`
.decl icn001_set_3(v: symbol)
icn001_set_3("altair"). icn001_set_3("matplotlib"). icn001_set_3("matplotlib.pyplot"). icn001_set_3("networkx").
icn001_set_3("numpy"). icn001_set_3("numpy.typing"). icn001_set_3("pandas"). icn001_set_3("seaborn").
icn001_set_3("tensorflow"). icn001_set_3("tkinter"). icn001_set_3("holoviews"). icn001_set_3("panel").
icn001_set_3("plotly.express"). icn001_set_3("polars"). icn001_set_3("pyarrow").
icn001_set_3("xml.etree.ElementTree").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl icn001_alt_1(n: node)
icn001_alt_1(n) :- glob("pyplot", n), inside(n, p1, "import_from_statement"),
    field(p1, "module_name", c2), glob("matplotlib", c2).
icn001_alt_1(n) :- glob("typing", n), inside(n, p3, "import_from_statement"),
    field(p3, "module_name", c4), glob("numpy", c4).
icn001_alt_1(n) :- glob("express", n), inside(n, p5, "import_from_statement"),
    field(p5, "module_name", c6), glob("plotly", c6).
icn001_alt_1(n) :- glob("ElementTree", n), inside(n, p7, "import_from_statement"),
    field(p7, "module_name", c8), match("xml[\\s\\\\]*\\.[\\s\\\\]*etree", c8).
