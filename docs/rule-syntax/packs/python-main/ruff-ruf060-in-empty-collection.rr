ruf060_alt_7_u0(n) :- ruf060_trivia(n).

.decl ruf060_alt_7_u1(n: node)
ruf060_alt_7_u1(n) :- ruf060_inner_part_u0(n).
ruf060_alt_7_u1(n) :- ruf060_trivia(n).

