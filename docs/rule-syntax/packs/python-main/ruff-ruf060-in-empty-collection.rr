ruf060_inner_part_u3(n) :- ruf060_fstr_empty_u2(n).

.decl ruf060_inner_part_u4(n: node)
ruf060_inner_part_u4(n) :- ruf060_str_plain_empty(n).
ruf060_inner_part_u4(n) :- ruf060_fstr_empty_u3(n).

.decl ruf060_inner_part_u5(n: node)
ruf060_inner_part_u5(n) :- ruf060_str_plain_empty(n).
ruf060_inner_part_u5(n) :- ruf060_fstr_empty_u4(n).

.decl ruf060_inner_part_u6(n: node)
ruf060_inner_part_u6(n) :- ruf060_str_plain_empty(n).
ruf060_inner_part_u6(n) :- ruf060_fstr_empty_u5(n).

.decl ruf060_inner_part_u7(n: node)
ruf060_inner_part_u7(n) :- ruf060_str_plain_empty(n).
ruf060_inner_part_u7(n) :- ruf060_fstr_empty_u6(n).

.decl ruf060_interp_empty_u1(n: node)
ruf060_interp_empty_u1(n) :- kind(n, "interpolation"), child(n, c1, _), ruf060_inner_empty_u0(c1),
    count : { child(n, c2, _), ruf060_alt_6(c2) } = 0.

.decl ruf060_interp_empty_u2(n: node)
ruf060_interp_empty_u2(n) :- kind(n, "interpolation"), child(n, c1, _), ruf060_inner_empty_u1(c1),
    count : { child(n, c2, _), ruf060_alt_6(c2) } = 0.

.decl ruf060_interp_empty_u3(n: node)
ruf060_interp_empty_u3(n) :- kind(n, "interpolation"), child(n, c1, _), ruf060_inner_empty_u2(c1),
    count : { child(n, c2, _), ruf060_alt_6(c2) } = 0.

.decl ruf060_interp_empty_u4(n: node)
ruf060_interp_empty_u4(n) :- kind(n, "interpolation"), child(n, c1, _), ruf060_inner_empty_u3(c1),
    count : { child(n, c2, _), ruf060_alt_6(c2) } = 0.

.decl ruf060_interp_empty_u5(n: node)
ruf060_interp_empty_u5(n) :- kind(n, "interpolation"), child(n, c1, _), ruf060_inner_empty_u4(c1),
    count : { child(n, c2, _), ruf060_alt_6(c2) } = 0.

.decl ruf060_interp_empty_u6(n: node)
ruf060_interp_empty_u6(n) :- kind(n, "interpolation"), child(n, c1, _), ruf060_inner_empty_u5(c1),
    count : { child(n, c2, _), ruf060_alt_6(c2) } = 0.

.decl ruf060_interp_empty_u7(n: node)
ruf060_interp_empty_u7(n) :- kind(n, "interpolation"), child(n, c1, _), ruf060_inner_empty_u6(c1),
    count : { child(n, c2, _), ruf060_alt_6(c2) } = 0.

// seen_import: import statement s imports absolute module h (its first segment), inside k function bodies
.decl ruf060_seen_import(s: node, h: symbol, k: number)
ruf060_seen_import(s, h, k) :- kind(s, "import_statement"), child(s, c, _),
    (kind(c, "dotted_name"), x = c ; kind(c, "aliased_import"), field(c, "name", x)),
    child(x, i, 0), kind(i, "identifier"), text(i, h),
    k = count : { within(s, b), field(f, "body", b), kind(f, "function_definition") }.
ruf060_seen_import(s, h, k) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "dotted_name"), child(x, i, 0), kind(i, "identifier"), text(i, h),
    k = count : { within(s, b), field(f, "body", b), kind(f, "function_definition") }.

// all_expr: x is a module-level `__all__ =`, `+=` or `: T =` value, or a part of one that lists names
//   (Ruff's extract_dunder_all_names: `+` chains, parentheses, walrus values, list(...) and tuple(...))
.decl ruf060_all_expr(x: node)
ruf060_all_expr(x) :- (kind(st, "assignment") ; kind(st, "augmented_assignment")),
    field(st, "left", l), kind(l, "identifier"), text(l, "__all__"), child(es, st, _),
    kind(es, "expression_statement"), child(m, es, _), kind(m, "module"),
    field(st, "right", x).
ruf060_all_expr(y) :- ruf060_all_expr(x), kind(x, "assignment"), field(x, "right", y).
ruf060_all_expr(y) :- ruf060_all_expr(x), kind(x, "binary_operator"),
    (field(x, "left", y) ; field(x, "right", y)).
ruf060_all_expr(y) :- ruf060_all_expr(x), kind(x, "parenthesized_expression"), child(x, y, _),
    !kind(y, "comment").
ruf060_all_expr(y) :- ruf060_all_expr(x), kind(x, "named_expression"), field(x, "value", y).
ruf060_all_expr(y) :- ruf060_all_expr(x), kind(x, "call"), field(x, "function", f),
    kind(f, "identifier"), (text(f, "list") ; text(f, "tuple")),
    field(x, "arguments", a), child(a, y, _).

// all_entry: string e is an entry of a module `__all__` definition, exporting the name x
.decl ruf060_all_entry(e: node, x: symbol)
ruf060_all_entry(e, x) :- ruf060_all_expr(l), (kind(l, "list") ; kind(l, "tuple")), child(l, e, _),
    (kind(e, "string") ; kind(e, "concatenated_string")),
    count : { within(i, e), kind(i, "interpolation") } = 0, str(e, x).

// alt_5_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf060_alt_5_u0_empty(n: node)

// alt_7_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf060_alt_7_u0_empty(n: node)

// fstr_empty_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf060_fstr_empty_u0_empty(n: node)

// inner_empty_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf060_inner_empty_u0_empty(n: node)

// inner_part_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf060_inner_part_u0_empty(n: node)

// interp_empty_u0: level -1 of an unrolled recursion, empty
.decl ruf060_interp_empty_u0(n: node)

// interp_empty_u0_empty: level -1 of an unrolled recursion, empty
.decl ruf060_interp_empty_u0_empty(n: node)

// set_2: names from the JSON `resolves.global`
.decl ruf060_set_2(v: symbol)
ruf060_set_2("list"). ruf060_set_2("tuple"). ruf060_set_2("set"). ruf060_set_2("frozenset"). ruf060_set_2("dict").
ruf060_set_2("bytes"). ruf060_set_2("bytearray"). ruf060_set_2("str").

// set_3: symbols from the JSON `resolves.import`
.decl ruf060_set_3(v: symbol)
ruf060_set_3("builtins.list"). ruf060_set_3("builtins.tuple"). ruf060_set_3("builtins.set").
ruf060_set_3("builtins.frozenset"). ruf060_set_3("builtins.dict"). ruf060_set_3("builtins.bytes").
ruf060_set_3("builtins.bytearray"). ruf060_set_3("builtins.str").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl ruf060_alt_1(n: node)
ruf060_alt_1(n) :- ref_site(n, b1), !kind(b1, "global_statement").
ruf060_alt_1(n) :- docof(n, d3), modnode(d3, m4),
    ( kind(n, "identifier"), !bind_only(n), miss(n, x2)
    ; (kind(n, "string") ; kind(n, "concatenated_string")), ruf060_all_entry(n, x2), !bound_in(m4, x2)
    ),
    !builtin(x2), !star(m4).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl ruf060_alt_4(n: node)
ruf060_alt_4(n) :- ruf060_trivia(n).
ruf060_alt_4(n) :- node(_, n, _, _, _), glob("[\\[\\](){},]", n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl ruf060_alt_5(n: node)
ruf060_alt_5(n) :- ruf060_alt_5_u7(n).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl ruf060_alt_6(n: node)
ruf060_alt_6(n) :- (kind(n, "type_conversion") ; kind(n, "format_specifier")).
ruf060_alt_6(n) :- node(_, n, _, _, _), glob("=", n).

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl ruf060_alt_7(n: node)
ruf060_alt_7(n) :- ruf060_alt_7_u7(n).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
.decl ruf060_alt_8(n: node)
ruf060_alt_8(n) :- ruf060_outer_part(n).
ruf060_alt_8(n) :- ruf060_trivia(n).

// alt_9(n): the JSON `any`: n matches if any one of these rules does
.decl ruf060_alt_9(n: node)
ruf060_alt_9(n) :- field(n, "function", c1), ruf060_callee_collection(c1), field(n, "arguments", c2),
    kind(c2, "argument_list"), count : { child(c2, c3, _), ruf060_elem(c3) } = 0.
ruf060_alt_9(n) :- field(n, "function", c4), ruf060_callee_set(c4), field(n, "arguments", c5),
    kind(c5, "argument_list"), child(c5, c6, _), ruf060_empty(c6),
    count : { precedes(s7, c6), ruf060_elem(s7) } = 0.

// stop_10(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl ruf060_stop_10(n: node)
ruf060_stop_10(n) :- node(_, n, _, _, _), !ruf060_trivia(n).

// alt_11(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl ruf060_alt_11(n: node, c: loc)
ruf060_alt_11(n, C) :- ruf060_in_compare(n), C = n.
ruf060_alt_11(n, C) :- ruf060_in_in_string(n, C).

// alt_13(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl ruf060_alt_13(n: node, c: loc)
ruf060_alt_13(n, C) :- ruf060_not_in_compare(n), C = n.
ruf060_alt_13(n, C) :- ruf060_not_in_in_string(n, C).
