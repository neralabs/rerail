ruf060_inner_empty_u0(n) :- kind(n, "concatenated_string"), count : { child(n, c1, _) } = 0.
ruf060_inner_empty_u0(n) :- kind(n, "concatenated_string"), child(n, c2, _), ruf060_fstr_part(c2),
    count : { child(n, c3, _), ruf060_fstr_part(c3) } = 0.

.decl ruf060_inner_empty_u1(n: node)
ruf060_inner_empty_u1(n) :- ruf060_inner_part_u0(n).
ruf060_inner_empty_u1(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), !ruf060_alt_7_u0(c1) } = 0.
ruf060_inner_empty_u1(n) :- kind(n, "concatenated_string"), child(n, c2, _), ruf060_fstr_part(c2),
