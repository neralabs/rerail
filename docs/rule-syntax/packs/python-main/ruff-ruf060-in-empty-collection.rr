.decl ruf060_alt_5_u7(n: node)
ruf060_alt_5_u7(n) :- kind(n, "string_start").
ruf060_alt_5_u7(n) :- kind(n, "string_end"), glob("{',\",''',\"\"\"}", n).
ruf060_alt_5_u7(n) :- kind(n, "interpolation"), ruf060_interp_empty_u6(n).
ruf060_alt_5_u7(n) :- kind(n, "string_content"), match("(?:\\\\\\r?\\n)+", n),
