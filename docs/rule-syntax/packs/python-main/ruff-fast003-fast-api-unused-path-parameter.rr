.policy "ruff-fast003-fast-api-unused-path-parameter" revision 1
.guests off
.description "Declare each path parameter of a FastAPI route as a function parameter, so the route can read the value its path captures."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

// Guest captures a host rule reads, by text (another document): K

#include "python/names.rr"

// FAST003(n): a finding at node n, from clause `unused-path-parameter`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation FAST003(at: loc, f: node, k: loc, fn: loc) "Declare `{k}` as a non-positional-only parameter of `{fn}` so FastAPI passes the `{{{k}}}` path value. Leave it if the handler reads `request.path_params`; else drop `{{{k}}}` from the path."
    suppress noqa "FAST003"
FAST003(F, n, K, FN) :- fast003_plain_str(n), fast003_route_arg(n, FN), parsed(n, "braceFormat", r1),
    has(r1, c2, "field"),
    match("\\{[a-zA-Z_][a-zA-Z0-9_]*(?::[a-zA-Z_][a-zA-Z0-9_]*)?\\}", c2), F = c2,
    has(c2, c3, "name"), K = c3, docof(c2, d4), guest(d4, _, h5, _),
    count : { within_stop(h5, p1_17, "decorated_definition"), kind(p1_17, "decorated_definition"), child(p1_17, c2_17, _), kind(c2_17, "function_definition"), field(c2_17, "parameters", c3_17), kind(c3_17, "parameters"), child(c3_17, c4_17, _), (fast003_alias_form(c4_17, AL), value(K, t1_3_16_17), value(AL, t1_3_16_17) ; !fast003_alias_form(c4_17, _), fast003_param_eq(c4_17, K) ; (kind(c4_17, "default_parameter") ; kind(c4_17, "typed_default_parameter")), field(c4_17, "value", c3_5_16_17), fast003_depends_call(c3_5_16_17), child(c3_5_16_17, c1_15_16_17, _), kind(c1_15_16_17, "argument_list"), child(c1_15_16_17, c2_15_16_17, _), ((kind(c2_15_16_17, "identifier"), count : { ref_site(c2_15_16_17, b1_10_12_15_16_17), site_only(b1_10_12_15_16_17), (st1_10_12_15_16_17 = b1_10_12_15_16_17 ; within(b1_10_12_15_16_17, st1_10_12_15_16_17)), (kind(st1_10_12_15_16_17, "function_definition"), !fast003_fn_has(st1_10_12_15_16_17, K) ; kind(st1_10_12_15_16_17, "class_definition"), count : { kind(st1_10_12_15_16_17, "class_definition"), fast003_alt_10(st1_10_12_15_16_17, K) } = 0) } = 0 ; kind(c2_15_16_17, "call"), field(c2_15_16_17, "function", c1_10_12_15_16_17), kind(c1_10_12_15_16_17, "identifier"), count : { ref_site(c1_10_12_15_16_17, b2_10_12_15_16_17), site_only(b2_10_12_15_16_17), (st2_10_12_15_16_17 = b2_10_12_15_16_17 ; within(b2_10_12_15_16_17, st2_10_12_15_16_17)), kind(st2_10_12_15_16_17, "class_definition"), count : { kind(st2_10_12_15_16_17, "class_definition"), fast003_alt_13(st2_10_12_15_16_17, K) } = 0 } = 0), count : { precedes(s1_12_15_16_17, c2_15_16_17), !fast003_alt_14(s1_12_15_16_17) } = 0 ; kind(c2_15_16_17, "keyword_argument"), field(c2_15_16_17, "name", c2_13_15_16_17), glob("dependency", c2_13_15_16_17), field(c2_15_16_17, "value", c3_13_15_16_17), (kind(c3_13_15_16_17, "identifier"), count : { ref_site(c3_13_15_16_17, b1_11_13_15_16_17), site_only(b1_11_13_15_16_17), (st1_11_13_15_16_17 = b1_11_13_15_16_17 ; within(b1_11_13_15_16_17, st1_11_13_15_16_17)), (kind(st1_11_13_15_16_17, "function_definition"), !fast003_fn_has(st1_11_13_15_16_17, K) ; kind(st1_11_13_15_16_17, "class_definition"), count : { kind(st1_11_13_15_16_17, "class_definition"), fast003_alt_10(st1_11_13_15_16_17, K) } = 0) } = 0 ; kind(c3_13_15_16_17, "call"), field(c3_13_15_16_17, "function", c1_11_13_15_16_17), kind(c1_11_13_15_16_17, "identifier"), count : { ref_site(c1_11_13_15_16_17, b2_11_13_15_16_17), site_only(b2_11_13_15_16_17), (st2_11_13_15_16_17 = b2_11_13_15_16_17 ; within(b2_11_13_15_16_17, st2_11_13_15_16_17)), kind(st2_11_13_15_16_17, "class_definition"), count : { kind(st2_11_13_15_16_17, "class_definition"), fast003_alt_13(st2_11_13_15_16_17, K) } = 0 } = 0)) ; fast003_typed_param(c4_17), field(c4_17, "type", c4_6_16_17), has(c4_6_16_17, c5_6_16_17, "call"), fast003_elem_meta(c5_6_16_17), fast003_depends_call(c5_6_16_17), child(c5_6_16_17, c1_14_16_17, _), kind(c1_14_16_17, "argument_list"), child(c1_14_16_17, c2_14_16_17, _), ((kind(c2_14_16_17, "identifier"), count : { ref_site(c2_14_16_17, b1_10_12_14_16_17), site_only(b1_10_12_14_16_17), (st1_10_12_14_16_17 = b1_10_12_14_16_17 ; within(b1_10_12_14_16_17, st1_10_12_14_16_17)), (kind(st1_10_12_14_16_17, "function_definition"), !fast003_fn_has(st1_10_12_14_16_17, K) ; kind(st1_10_12_14_16_17, "class_definition"), count : { kind(st1_10_12_14_16_17, "class_definition"), fast003_alt_10(st1_10_12_14_16_17, K) } = 0) } = 0 ; kind(c2_14_16_17, "call"), field(c2_14_16_17, "function", c1_10_12_14_16_17), kind(c1_10_12_14_16_17, "identifier"), count : { ref_site(c1_10_12_14_16_17, b2_10_12_14_16_17), site_only(b2_10_12_14_16_17), (st2_10_12_14_16_17 = b2_10_12_14_16_17 ; within(b2_10_12_14_16_17, st2_10_12_14_16_17)), kind(st2_10_12_14_16_17, "class_definition"), count : { kind(st2_10_12_14_16_17, "class_definition"), fast003_alt_13(st2_10_12_14_16_17, K) } = 0 } = 0), count : { precedes(s1_12_14_16_17, c2_14_16_17), !fast003_alt_14(s1_12_14_16_17) } = 0 ; kind(c2_14_16_17, "keyword_argument"), field(c2_14_16_17, "name", c2_13_14_16_17), glob("dependency", c2_13_14_16_17), field(c2_14_16_17, "value", c3_13_14_16_17), (kind(c3_13_14_16_17, "identifier"), count : { ref_site(c3_13_14_16_17, b1_11_13_14_16_17), site_only(b1_11_13_14_16_17), (st1_11_13_14_16_17 = b1_11_13_14_16_17 ; within(b1_11_13_14_16_17, st1_11_13_14_16_17)), (kind(st1_11_13_14_16_17, "function_definition"), !fast003_fn_has(st1_11_13_14_16_17, K) ; kind(st1_11_13_14_16_17, "class_definition"), count : { kind(st1_11_13_14_16_17, "class_definition"), fast003_alt_10(st1_11_13_14_16_17, K) } = 0) } = 0 ; kind(c3_13_14_16_17, "call"), field(c3_13_14_16_17, "function", c1_11_13_14_16_17), kind(c1_11_13_14_16_17, "identifier"), count : { ref_site(c1_11_13_14_16_17, b2_11_13_14_16_17), site_only(b2_11_13_14_16_17), (st2_11_13_14_16_17 = b2_11_13_14_16_17 ; within(b2_11_13_14_16_17, st2_11_13_14_16_17)), kind(st2_11_13_14_16_17, "class_definition"), count : { kind(st2_11_13_14_16_17, "class_definition"), fast003_alt_13(st2_11_13_14_16_17, K) } = 0 } = 0)), count : { field(c4_17, "value", c6_6_16_17), fast003_dep_arg_some(c6_6_16_17) } = 0 ; fast003_typed_param(c4_17), field(c4_17, "type", c7_7_16_17), has(c7_7_16_17, c8_7_16_17, "identifier"), fast003_elem_1(c8_7_16_17), (kind(c8_7_16_17, "identifier"), count : { ref_site(c8_7_16_17, b1_9_16_17), site_only(b1_9_16_17), (st1_9_16_17 = b1_9_16_17 ; within(b1_9_16_17, st1_9_16_17)), (kind(st1_9_16_17, "function_definition"), !fast003_fn_has(st1_9_16_17, K) ; kind(st1_9_16_17, "class_definition"), count : { kind(st1_9_16_17, "class_definition"), fast003_alt_10(st1_9_16_17, K) } = 0) } = 0 ; kind(c8_7_16_17, "call"), field(c8_7_16_17, "function", c1_9_16_17), kind(c1_9_16_17, "identifier"), count : { ref_site(c1_9_16_17, b2_9_16_17), site_only(b2_9_16_17), (st2_9_16_17 = b2_9_16_17 ; within(b2_9_16_17, st2_9_16_17)), kind(st2_9_16_17, "class_definition"), count : { kind(st2_9_16_17, "class_definition"), fast003_alt_13(st2_9_16_17, K) } = 0 } = 0), field(c4_17, "type", c9_7_16_17), has(c9_7_16_17, c10_7_16_17, "call"), fast003_elem_meta(c10_7_16_17), fast003_depends_call(c10_7_16_17), child(c10_7_16_17, c11_7_16_17, _), kind(c11_7_16_17, "argument_list"), match("\\(\\s*\\)", c11_7_16_17), count : { field(c4_17, "value", c12_7_16_17), fast003_dep_arg_some(c12_7_16_17) } = 0 ; fast003_typed_param(c4_17), field(c4_17, "type", c13_8_16_17), has(c13_8_16_17, c14_8_16_17, "call"), fast003_elem_meta(c14_8_16_17), fast003_dep_call_some(c14_8_16_17), (child(p1_8_16_17, c14_8_16_17, _), kind(p1_8_16_17, "type"), precedes(p1_8_16_17, s1_8_16_17), kind(s1_8_16_17, "type"), child(s1_8_16_17, c1_8_16_17, _), fast003_dep_call_some(c1_8_16_17) ; precedes(c14_8_16_17, s2_8_16_17), fast003_dep_call_some(s2_8_16_17)), count : { field(c4_17, "value", c19_8_16_17), fast003_dep_arg_some(c19_8_16_17) } = 0), count : { precedes(c4_17, s5_17), kind(s5_17, "positional_separator") } = 0 } = 0.

// route_ctor(n): the JSON util `route-ctor`, used where the JSON says `matches: "route-ctor"`
.decl fast003_route_ctor(n: node)
fast003_route_ctor(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (sym_of(n, "fastapi.FastAPI") ; sym_of(n, "fastapi.APIRouter")).
fast003_route_ctor(n) :- kind(n, "parenthesized_expression"), child(n, c1, _), fast003_route_ctor(c1).

// route_ann(n): the JSON util `route-ann`, used where the JSON says `matches: "route-ann"`
.decl fast003_route_ann(n: node)
fast003_route_ann(n) :- fast003_route_ctor(n).
fast003_route_ann(n) :- kind(n, "type"), child(n, c1, _), fast003_route_ann(c1).

// route_init(n): the JSON util `route-init`, used where the JSON says `matches: "route-init"`
.decl fast003_route_init(n: node)
fast003_route_init(n) :- kind(n, "call"), field(n, "function", c1), fast003_route_ctor(c1).
fast003_route_init(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), fast003_route_init(c2).

// plain_target(n): the JSON util `plain-target`, used where the JSON says `matches: "plain-target"`
.decl fast003_plain_target(n: node)
fast003_plain_target(n) :- kind(n, "identifier").
fast003_plain_target(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    fast003_plain_target(c1).

// route_name(n): the JSON util `route-name`, used where the JSON says `matches: "route-name"`
.decl fast003_route_name(n: node)
fast003_route_name(n) :- kind(n, "identifier"), fast003_alt_1(n).

// route_receiver(n): the JSON util `route-receiver`, used where the JSON says `matches: "route-receiver"`
.decl fast003_route_receiver(n: node)
fast003_route_receiver(n) :- fast003_route_name(n).
fast003_route_receiver(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    fast003_route_receiver(c1).

// route_attr(n): the JSON util `route-attr`, used where the JSON says `matches: "route-attr"`
.decl fast003_route_attr(n: node)
fast003_route_attr(n) :- kind(n, "attribute"), field(n, "object", c1), fast003_route_receiver(c1),
    field(n, "attribute", c2),
    glob("{get,post,put,delete,patch,options,head,trace}", c2).
fast003_route_attr(n) :- kind(n, "parenthesized_expression"), child(n, c3, _), fast003_route_attr(c3).

// route_call(n): the JSON util `route-call`, used where the JSON says `matches: "route-call"`
.decl fast003_route_call(n: node)
fast003_route_call(n) :- kind(n, "call"), field(n, "function", c1), fast003_route_attr(c1).

// route_decorator(n): the JSON util `route-decorator`, used where the JSON says `matches: "route-decorator"`
.decl fast003_route_decorator(n: node)
fast003_route_decorator(n) :- kind(n, "decorator"), child(n, c1, _), fast003_route_call_expr(c1).

// route_call_expr(n): the JSON util `route-call-expr`, used where the JSON says `matches: "route-call-expr"`
.decl fast003_route_call_expr(n: node)
fast003_route_call_expr(n) :- fast003_route_call(n).
fast003_route_call_expr(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    fast003_route_call_expr(c1).

// plain_str(n): the JSON util `plain-str`, used where the JSON says `matches: "plain-str"`
.decl fast003_plain_str(n: node)
fast003_plain_str(n) :- kind(n, "string"), !match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", n).
fast003_plain_str(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", c1) } = 0.

// ref_of(n, key): 3 copies of one rule set (`depends-ref`, `path-ref`, `pydantic-ref`), folded into one: row `key` of
// ref_of_case gives the strings each copy had.
.decl fast003_ref_of(n: node, key: symbol)
fast003_ref_of(n, q1) :- fast003_ref_of_case(q1, s1), (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, s1).

// annotated_ref(n): the JSON util `annotated-ref`, used where the JSON says `matches: "annotated-ref"`
.decl fast003_annotated_ref(n: node)
fast003_annotated_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Annotated")
    ; sym_of(n, "typing_extensions.Annotated")
    ; sym_of(n, "_typeshed.Annotated")
    ).


// depends_call(n): the JSON util `depends-call`, used where the JSON says `matches: "depends-call"`
.decl fast003_depends_call(n: node)
fast003_depends_call(n) :- kind(n, "call"), field(n, "function", c1), fast003_ref_of(c1, "depends").

// alias_str(n): the JSON util `alias-str`, used where the JSON says `matches: "alias-str"`
//   AL: metavariable this relation binds for the calling rule
.decl fast003_alias_str(n: node, al: loc)
fast003_alias_str(n, AL) :- fast003_plain_str(n), node(_, n, _, _, _), AL = n.
fast003_alias_str(n, AL) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    fast003_alias_str(c1, AL).

// plain_param(n): the JSON util `plain-param`, used where the JSON says `matches: "plain-param"`
.decl fast003_plain_param(n: node)
fast003_plain_param(n) :-
    ( kind(n, "identifier")
    ; kind(n, "typed_parameter")
    ; kind(n, "default_parameter")
    ; kind(n, "typed_default_parameter")
    ).


// typed_param(n): the JSON util `typed-param`, used where the JSON says `matches: "typed-param"`
.decl fast003_typed_param(n: node)
fast003_typed_param(n) :- kind(n, "typed_parameter"), child(n, c1, _), kind(c1, "identifier").
fast003_typed_param(n) :- kind(n, "typed_default_parameter").

// annotated_g(n): the JSON util `annotated-g`, used where the JSON says `matches: "annotated-g"`
.decl fast003_annotated_g(n: node)
fast003_annotated_g(n) :- kind(n, "generic_type"), child(n, c1, _), kind(c1, "identifier"),
    fast003_annotated_ref(c1), child(p2, n, _), kind(p2, "type"), child(p3, p2, _),
    fast003_typed_param(p3).

// annotated_s(n): the JSON util `annotated-s`, used where the JSON says `matches: "annotated-s"`
.decl fast003_annotated_s(n: node)
fast003_annotated_s(n) :- kind(n, "subscript"), field(n, "value", c1), fast003_annotated_ref(c1),
    child(p2, n, _), kind(p2, "type"), child(p3, p2, _), fast003_typed_param(p3).

// elem_1(n): the JSON util `elem-1`, used where the JSON says `matches: "elem-1"`
.decl fast003_elem_1(n: node)
fast003_elem_1(n) :- child(p1, n, _), kind(p1, "type"), fast003_ann_slot(p1), !fast003_tok_follows_2(p1).
fast003_elem_1(n) :- fast003_ann_slot(n), !fast003_tok_follows_3(n).

// elem_2(n): the JSON util `elem-2`, used where the JSON says `matches: "elem-2"`
.decl fast003_elem_2(n: node)
fast003_elem_2(n) :- child(p1, n, _), kind(p1, "type"), fast003_ann_slot(p1), fast003_tok_follows_2(p1),
    count : { precedes(s9, p1), glob("\\,", s9), fast003_tok_follows_4(s9) } = 0.
fast003_elem_2(n) :- fast003_ann_slot(n), fast003_tok_follows_5(n),
    count : { precedes(s24, n), glob("\\,", s24), fast003_tok_follows_6(s24) } = 0.

// elem_meta(n): the JSON util `elem-meta`, used where the JSON says `matches: "elem-meta"`
.decl fast003_elem_meta(n: node)
fast003_elem_meta(n) :- child(p1, n, _), kind(p1, "type"), fast003_ann_slot(p1), fast003_tok_follows_2(p1).
fast003_elem_meta(n) :- fast003_ann_slot(n), fast003_tok_follows_3(n).

// param_eq(n, …): the JSON util `param-eq`, called with `matches` and arguments K
.decl fast003_param_eq(n: node, k: node)
fast003_param_eq(n, K) :- fast003_alt_2(n, K).

// alias_form(n): the JSON util `alias-form`, used where the JSON says `matches: "alias-form"`
//   AL: metavariable this relation binds for the calling rule
.decl fast003_alias_form(n: node, al: loc)
fast003_alias_form(n, AL) :- fast003_typed_param(n), field(n, "type", c1), has(c1, c2, "call"),
    fast003_elem_2(c2), field(c2, "function", c3), fast003_ref_of(c3, "path"), child(c2, c4, _),
    kind(c4, "argument_list"), child(c4, c5, _), kind(c5, "keyword_argument"),
    field(c5, "name", c6), glob("alias", c6), field(c5, "value", c7),
    fast003_alias_str(c7, AL).

// fn_has(n, …): the JSON util `fn-has`, called with `matches` and arguments K
.decl fast003_fn_has(n: node, k: node)
fast003_fn_has(n, K) :- kind(n, "function_definition"), field(n, "parameters", c1),
    kind(c1, "parameters"), child(c1, c2, _), fast003_param_eq(c2, K),
    count : { precedes(c2, s3), kind(s3, "positional_separator") } = 0.

// pyd_base(n): the JSON util `pyd-base`, used where the JSON says `matches: "pyd-base"`
.decl fast003_pyd_base(n: node)
fast003_pyd_base(n) :- kind(n, "class_definition"), field(n, "superclasses", c1),
    kind(c1, "argument_list"), child(c1, c2, _), fast003_ref_of(c2, "pydantic").

// pyd_field(n, …): the JSON util `pyd-field`, called with `matches` and arguments K
.decl fast003_pyd_field(n: node, k: node)
fast003_pyd_field(n, K) :- node(_, K, _, _, _), fast003_pyd_base(n), field(n, "body", c1),
    kind(c1, "block"), child(c1, c2, _), kind(c2, "expression_statement"),
    child(c2, c3, _), kind(c3, "assignment"), field(c3, "type", c4), kind(c4, "type"),
    field(c3, "left", c5), kind(c5, "identifier"), node(_, c5, _, _, _), N = c5, text(K, t6), text(N, t6).

// init_has(n, …): the JSON util `init-has`, called with `matches` and arguments K
.decl fast003_init_has(n: node, k: node)
fast003_init_has(n, K) :- kind(n, "class_definition"), field(n, "body", c1), kind(c1, "block"),
    within_stop(c2, c1, fast003_stop_3), kind(c2, "function_definition"),
    field(c2, "name", c3), glob("__init__", c3), field(c2, "parameters", c4),
    kind(c4, "parameters"), child(c4, c5, _), fast003_param_eq(c5, K),
    count : { precedes(c5, s6), kind(s6, "positional_separator") } = 0,
    precedes(s7, c5), fast003_plain_param(s7),
    count : { precedes(s7, s8), kind(s8, "positional_separator") } = 0.

// call_has(n, …): the JSON util `call-has`, called with `matches` and arguments K
.decl fast003_call_has(n: node, k: node)
fast003_call_has(n, K) :- kind(n, "class_definition"), field(n, "body", c1), kind(c1, "block"),
    within_stop(c2, c1, fast003_stop_3), kind(c2, "function_definition"),
    field(c2, "name", c3), glob("__call__", c3), field(c2, "parameters", c4),
    kind(c4, "parameters"), child(c4, c5, _), fast003_param_eq(c5, K),
    count : { precedes(c5, s6), kind(s6, "positional_separator") } = 0,
    precedes(s7, c5), fast003_plain_param(s7),
    count : { precedes(s7, s8), kind(s8, "positional_separator") } = 0.

// route_arg(n): the JSON util `route-arg`, used where the JSON says `matches: "route-arg"`
//   FN: metavariable this relation binds for the calling rule
.decl fast003_route_arg(n: node, fn: loc)
fast003_route_arg(n, FN) :- fast003_demand_route_arg(n), count : { precedes(s1, n), !fast003_alt_14(s1) } = 0,
    child(p2, n, _), kind(p2, "argument_list"), child(p3, p2, _), kind(p3, "call"),
    fast003_route_call(p3), within_stop(p3, p4, "decorator"), kind(p4, "decorator"),
    fast003_route_decorator(p4), count : { precedes(s5, p4), fast003_route_decorator(s5) } = 0,
