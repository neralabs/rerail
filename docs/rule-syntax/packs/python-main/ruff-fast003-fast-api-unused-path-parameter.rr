    field(c4_17, "value", c3_5_16_17), fast003_depends_call(c3_5_16_17),
    child(c3_5_16_17, c1_15_16_17, _), kind(c1_15_16_17, "argument_list"),
    child(c1_15_16_17, c2_15_16_17, _), kind(c2_15_16_17, "keyword_argument"),
    field(c2_15_16_17, "name", c2_13_15_16_17), glob("dependency", c2_13_15_16_17),
    field(c2_15_16_17, "value", c3_13_15_16_17), kind(c3_13_15_16_17, "call"),
    field(c3_13_15_16_17, "function", c1_11_13_15_16_17),
    kind(c1_11_13_15_16_17, "identifier"),
    ref_site(c1_11_13_15_16_17, b2_11_13_15_16_17), site_only(b2_11_13_15_16_17),
    ( st2_11_13_15_16_17 = b2_11_13_15_16_17
    ; within(b2_11_13_15_16_17, st2_11_13_15_16_17)
    ),
    kind(st2_11_13_15_16_17, "class_definition"),
    kind(st2_11_13_15_16_17, "class_definition").
fast003_demand_alt_13(st2_10_12_14_16_17, K) :- fast003_plain_str(n), fast003_route_arg(n, FN),
    parsed(n, "braceFormat", r1), has(r1, c2, "field"),
    match("\\{[a-zA-Z_][a-zA-Z0-9_]*(?::[a-zA-Z_][a-zA-Z0-9_]*)?\\}", c2), F = c2,
    has(c2, c3, "name"), K = c3, docof(c2, d4), guest(d4, _, h5, _),
    within_stop(h5, p1_17, "decorated_definition"),
    kind(p1_17, "decorated_definition"), child(p1_17, c2_17, _),
    kind(c2_17, "function_definition"), field(c2_17, "parameters", c3_17),
    kind(c3_17, "parameters"), child(c3_17, c4_17, _), fast003_typed_param(c4_17),
    field(c4_17, "type", c4_6_16_17), has(c4_6_16_17, c5_6_16_17, "call"),
    fast003_elem_meta(c5_6_16_17), fast003_depends_call(c5_6_16_17), child(c5_6_16_17, c1_14_16_17, _),
    kind(c1_14_16_17, "argument_list"), child(c1_14_16_17, c2_14_16_17, _),
    kind(c2_14_16_17, "call"), field(c2_14_16_17, "function", c1_10_12_14_16_17),
    kind(c1_10_12_14_16_17, "identifier"),
    ref_site(c1_10_12_14_16_17, b2_10_12_14_16_17), site_only(b2_10_12_14_16_17),
    ( st2_10_12_14_16_17 = b2_10_12_14_16_17
    ; within(b2_10_12_14_16_17, st2_10_12_14_16_17)
    ),
    kind(st2_10_12_14_16_17, "class_definition"),
    kind(st2_10_12_14_16_17, "class_definition").
fast003_demand_alt_13(st2_11_13_14_16_17, K) :- fast003_plain_str(n), fast003_route_arg(n, FN),
    parsed(n, "braceFormat", r1), has(r1, c2, "field"),
    match("\\{[a-zA-Z_][a-zA-Z0-9_]*(?::[a-zA-Z_][a-zA-Z0-9_]*)?\\}", c2), F = c2,
    has(c2, c3, "name"), K = c3, docof(c2, d4), guest(d4, _, h5, _),
    within_stop(h5, p1_17, "decorated_definition"),
    kind(p1_17, "decorated_definition"), child(p1_17, c2_17, _),
    kind(c2_17, "function_definition"), field(c2_17, "parameters", c3_17),
    kind(c3_17, "parameters"), child(c3_17, c4_17, _), fast003_typed_param(c4_17),
    field(c4_17, "type", c4_6_16_17), has(c4_6_16_17, c5_6_16_17, "call"),
    fast003_elem_meta(c5_6_16_17), fast003_depends_call(c5_6_16_17), child(c5_6_16_17, c1_14_16_17, _),
    kind(c1_14_16_17, "argument_list"), child(c1_14_16_17, c2_14_16_17, _),
    kind(c2_14_16_17, "keyword_argument"), field(c2_14_16_17, "name", c2_13_14_16_17),
    glob("dependency", c2_13_14_16_17), field(c2_14_16_17, "value", c3_13_14_16_17),
    kind(c3_13_14_16_17, "call"), field(c3_13_14_16_17, "function", c1_11_13_14_16_17),
    kind(c1_11_13_14_16_17, "identifier"),
    ref_site(c1_11_13_14_16_17, b2_11_13_14_16_17), site_only(b2_11_13_14_16_17),
    ( st2_11_13_14_16_17 = b2_11_13_14_16_17
    ; within(b2_11_13_14_16_17, st2_11_13_14_16_17)
    ),
    kind(st2_11_13_14_16_17, "class_definition"),
    kind(st2_11_13_14_16_17, "class_definition").
fast003_demand_alt_13(st2_9_16_17, K) :- fast003_plain_str(n), fast003_route_arg(n, FN),
    parsed(n, "braceFormat", r1), has(r1, c2, "field"),
    match("\\{[a-zA-Z_][a-zA-Z0-9_]*(?::[a-zA-Z_][a-zA-Z0-9_]*)?\\}", c2), F = c2,
    has(c2, c3, "name"), K = c3, docof(c2, d4), guest(d4, _, h5, _),
    within_stop(h5, p1_17, "decorated_definition"),
    kind(p1_17, "decorated_definition"), child(p1_17, c2_17, _),
    kind(c2_17, "function_definition"), field(c2_17, "parameters", c3_17),
    kind(c3_17, "parameters"), child(c3_17, c4_17, _), fast003_typed_param(c4_17),
    field(c4_17, "type", c7_7_16_17), has(c7_7_16_17, c8_7_16_17, "identifier"),
    fast003_elem_1(c8_7_16_17), field(c4_17, "type", c9_7_16_17),
    has(c9_7_16_17, c10_7_16_17, "call"), fast003_elem_meta(c10_7_16_17),
    fast003_depends_call(c10_7_16_17), child(c10_7_16_17, c11_7_16_17, _),
    kind(c11_7_16_17, "argument_list"), match("\\(\\s*\\)", c11_7_16_17),
    kind(c8_7_16_17, "call"), field(c8_7_16_17, "function", c1_9_16_17),
    kind(c1_9_16_17, "identifier"), ref_site(c1_9_16_17, b2_9_16_17),
    site_only(b2_9_16_17),
    (st2_9_16_17 = b2_9_16_17 ; within(b2_9_16_17, st2_9_16_17)),
    kind(st2_9_16_17, "class_definition"), kind(st2_9_16_17, "class_definition").

// demand_route_arg: the nodes route_arg is asked at (its recursion looks at every descendant)
.decl fast003_demand_route_arg(n: node)
fast003_demand_route_arg(n) :- fast003_plain_str(n), parsed(n, "braceFormat", r1),
    has(r1, c2, "field"),
    match("\\{[a-zA-Z_][a-zA-Z0-9_]*(?::[a-zA-Z_][a-zA-Z0-9_]*)?\\}", c2), F = c2,
    has(c2, c3, "name"), K = c3, docof(c2, d4), guest(d4, _, h5, _).
fast003_demand_route_arg(p9) :- fast003_demand_route_arg(n), child(p9, n, _),
    kind(p9, "parenthesized_expression").

// ref_of_case: one row per relation folded into ref_of: its key, then the strings that differed.
.decl fast003_ref_of_case(key: symbol, s1: symbol)
fast003_ref_of_case("depends", "fastapi.Depends"). fast003_ref_of_case("path", "fastapi.Path").
fast003_ref_of_case("pydantic", "pydantic.BaseModel").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl fast003_alt_1(n: node)
fast003_alt_1(n) :- ref_site(n, b1), binding_value(b1, x2), fast003_route_init(x2),
    (st3 = b1 ; within(b1, st3)), count : { child(st3, c4, _), kind(c4, "type") } = 0.
fast003_alt_1(n) :- ref_site(n, b5), (st6 = b5 ; within(b5, st6)), kind(st6, "as_pattern"),
    child(p7, st6, _), kind(p7, "with_item"), child(st6, c8, _), fast003_route_init(c8),
    fast003_tok_precedes_1(c8), child(st6, c16, _), kind(c16, "as_pattern_target"),
    child(c16, c17, _), fast003_plain_target(c17).
fast003_alt_1(n) :- ref_site(n, b18), site_annotation(b18, o19), fast003_route_ann(o19),
    (st20 = b18 ; within(b18, st20)),
    count : { child(st20, c21, _), (kind(c21, "list_splat_pattern") ; kind(c21, "dictionary_splat_pattern")) } = 0.
fast003_alt_1(n) :- ref_site(n, b22), (st23 = b22 ; within(b22, st23)),
    kind(st23, "function_definition"), field(st23, "return_type", c24), fast003_route_ann(c24).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   K: metavariable of the calling rule, passed in (bound by the caller)
.decl fast003_alt_2(n: node, k: loc)
fast003_alt_2(n, K) :- node(_, K, _, _, _), kind(n, "identifier"), node(_, n, _, _, _), N = n,
    text(K, t1), text(N, t1).
fast003_alt_2(n, K) :- node(_, K, _, _, _), kind(n, "typed_parameter"), child(n, c3, _),
    kind(c3, "identifier"), node(_, c3, _, _, _), N = c3, text(K, t4), text(N, t4).
fast003_alt_2(n, K) :- node(_, K, _, _, _),
    (kind(n, "default_parameter") ; kind(n, "typed_default_parameter")),
    field(n, "name", c6), node(_, c6, _, _, _), N = c6, text(K, t7), text(N, t7).

// stop_3(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl fast003_stop_3(n: node)
fast003_stop_3(n) :- node(_, n, _, _, _), !kind(n, "decorated_definition").

// alt_10(n): the JSON `any`: n matches if any one of these rules does
//   K: metavariable of the calling rule, passed in (bound by the caller)
.decl fast003_alt_10(n: node, k: loc)
fast003_alt_10(n, K) :- fast003_demand_alt_10(n, K), fast003_pyd_field(n, K).
fast003_alt_10(n, K) :- fast003_demand_alt_10(n, K), !fast003_pyd_base(n), fast003_init_has(n, K).

// alt_13(n): the JSON `any`: n matches if any one of these rules does
//   K: metavariable of the calling rule, passed in (bound by the caller)
.decl fast003_alt_13(n: node, k: loc)
fast003_alt_13(n, K) :- fast003_demand_alt_13(n, K), fast003_pyd_field(n, K).
fast003_alt_13(n, K) :- fast003_demand_alt_13(n, K), !fast003_pyd_base(n), fast003_call_has(n, K).

// alt_14(n): the JSON `any`: n matches if any one of these rules does
.decl fast003_alt_14(n: node)
fast003_alt_14(n) :- kind(n, "comment").
fast003_alt_14(n) :- node(_, n, _, _, _), glob("(", n).

// alt_24(n): the JSON `any`: n matches if any one of these rules does
.decl fast003_alt_24(n: node)
fast003_alt_24(n) :- child(p1, n, _), kind(p1, "type"), precedes(s2, p1), fast003_first_ident_slot(s2).
fast003_alt_24(n) :- precedes(s3, n), fast003_first_ident_slot(s3).
