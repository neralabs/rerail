sim905_tok_follows_4(n) :- next_sibling(s23, n), glob("=", s23).
sim905_tok_follows_4(n) :- structural_before(n, g25), match("\\s*", g25), child(p26, n, _),
    node(_, n, _, st28, _), o27 = st28 - strlen(g25), token(p26, _, t24, _, o27),
