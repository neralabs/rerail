// tok_precedes_11(n): a later sibling of n, a named node or an anonymous token, matches "^=$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl sim905_tok_precedes_11(n: node)
.stored sim905_tok_precedes_11 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
sim905_tok_precedes_11(n) :- next_sibling(n, s66), glob("=", s66).
sim905_tok_precedes_11(n) :- structural_after(n, g68), match("\\s*", g68), child(p69, n, _),
    node(_, n, _, _, en72), o70 = en72 + strlen(g68), token(p69, _, t67, o70, _),
    match("=", t67).
sim905_tok_precedes_11(n) :- structural_after(n, g68),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g68).

// part_case: one row per relation folded into part: its key, then the strings that differed.
.decl sim905_part_case(key: symbol, s1: symbol)
sim905_part_case("b", "[A-Za-z]*[bB].*"). sim905_part_case("f", "[A-Za-z]*[fF].*").
sim905_part_case("t", "[A-Za-z]*[tT].*").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl sim905_alt_2(n: node)
sim905_alt_2(n) :- sim905_t_string(n).
sim905_alt_2(n) :- sim905_f_string(n).

// stop_10(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl sim905_stop_10(n: node)
sim905_stop_10(n) :- node(_, n, _, _, _), !kind(n, "comment").

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl sim905_alt_11(n: node)
sim905_alt_11(n) :-
    ( kind(n, "keyword_argument")
    ; kind(n, "list_splat")
    ; kind(n, "dictionary_splat")
    ; kind(n, "comment")
    ).

sim905_alt_11(n) :- node(_, n, _, _, _), glob("[\\[\\](){},]", n).

// alt_16(n): the JSON `any`: n matches if any one of these rules does
.decl sim905_alt_16(n: node)
sim905_alt_16(n) :- child(n, c1, _), !sim905_alt_11(c1), precedes_stop(s2, c1, sim905_stop_10),
    glob("\\,", s2), precedes_stop(s3, s2, sim905_stop_10), !sim905_alt_11(s3),
    precedes_stop(s4, s3, sim905_stop_10), glob("(", s4), sim905_maxsplit(c1).
sim905_alt_16(n) :- node(_, n, _, _, _),
    count : { child(n, c5, _), !sim905_alt_11(c5), sim905_stop_10_precedes(s6, c5), glob("\\,", s6), sim905_stop_10_precedes(s7, s6), !sim905_alt_11(s7), sim905_stop_10_precedes(s8, s7), glob("(", s8) } = 0.

// alt_53(n): the JSON `any`: n matches if any one of these rules does
.decl sim905_alt_53(n: node)
sim905_alt_53(n) :- child(n, c1, _), !sim905_alt_11(c1), precedes_stop(s2, c1, sim905_stop_10),
    glob("(", s2), sim905_sep(c1).
sim905_alt_53(n) :- node(_, n, _, _, _),
    count : { child(n, c3, _), !sim905_alt_11(c3), sim905_stop_10_precedes(s4, c3), glob("(", s4) } = 0.

// stop_10_precedes: precedes_stop over the stop set stop_10, read inside an aggregate
.decl sim905_stop_10_precedes(a: node, b: node)
sim905_stop_10_precedes(x, y) :- precedes_stop(x, y, sim905_stop_10).
