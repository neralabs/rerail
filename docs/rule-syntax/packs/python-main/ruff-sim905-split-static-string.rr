sim905_tok_follows_7(n) :- next_sibling(s11, n), glob("=", s11).
sim905_tok_follows_7(n) :- structural_before(n, g13), match("\\s*", g13), child(p14, n, _),
    node(_, n, _, st16, _), o15 = st16 - strlen(g13), token(p14, _, t12, _, o15),
