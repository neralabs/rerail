sim905_tok_precedes_6(n) :- next_sibling(n, s3), glob("=", s3).
sim905_tok_precedes_6(n) :- structural_after(n, g5), match("\\s*", g5), child(p6, n, _),
    node(_, n, _, _, en9), o7 = en9 + strlen(g5), token(p6, _, t4, o7, _),
    match("=", t4).
sim905_tok_precedes_6(n) :- structural_after(n, g5),
    match("(?s)^(?:\\s*(?:=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).

