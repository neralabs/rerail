sim905_tok_follows_10(n) :- next_sibling(s57, n), glob("=", s57).
sim905_tok_follows_10(n) :- structural_before(n, g59), match("\\s*", g59), child(p60, n, _),
    node(_, n, _, st62, _), o61 = st62 - strlen(g59), token(p60, _, t58, _, o61),
