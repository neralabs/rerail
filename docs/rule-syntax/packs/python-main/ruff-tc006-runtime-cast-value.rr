.policy "ruff-tc006-runtime-cast-value" revision 1
.guests off
.description "Quote the type expression passed to typing.cast; a quoted type is not evaluated at runtime and every cast call reads the same."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.
// ast(n, {…}) atoms are JSON terms with no .rr form yet; the engine matches them as it does today.

#include "python/names.rr"

// cast_callee(n): the JSON util `cast-callee`, used where the JSON says `matches: "cast-callee"`
.decl tc006_cast_callee(n: node)
tc006_cast_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.cast")
    ; sym_of(n, "typing_extensions.cast")
    ; sym_of(n, "_typeshed.cast")
    ).

tc006_cast_callee(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    tc006_cast_callee(c1).

// cast_call(n): the JSON util `cast-call`, used where the JSON says `matches: "cast-call"`
.decl tc006_cast_call(n: node)
tc006_cast_call(n) :- kind(n, "call"), field(n, "function", c1), tc006_cast_callee(c1).

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl tc006_plain_string(n: node)
tc006_plain_string(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0.
tc006_plain_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c2, _), kind(c2, "string"), child(c2, c3, _), kind(c3, "string_start"), glob("**[bBfFtT]**", c3) } = 0.
tc006_plain_string(n) :- kind(n, "parenthesized_expression"), child(n, c4, _),
    tc006_plain_string(c4).

// type_slot(n): the JSON util `type-slot`, used where the JSON says `matches: "type-slot"`
.decl tc006_type_slot(n: node)
tc006_type_slot(n) :- child(p1, n, _), kind(p1, "argument_list"), field(p2, "arguments", p1),
    tc006_cast_call(p2), !tc006_alt_2(n).
tc006_type_slot(n) :- field(p4, "value", n), kind(p4, "keyword_argument"),
    field(p4, "name", c5), glob("typ", c5), child(p6, p4, _),
    kind(p6, "argument_list"), field(p7, "arguments", p6), tc006_cast_call(p7).
tc006_type_slot(n) :- child(p8, n, _), kind(p8, "parenthesized_expression"), tc006_type_slot(p8).

// unquoted_type(n): the JSON util `unquoted-type`, used where the JSON says `matches: "unquoted-type"`
.decl tc006_unquoted_type(n: node)
tc006_unquoted_type(n) :- tc006_type_slot(n), !tc006_alt_4(n).

// cast_in_string(n): the JSON util `cast-in-string`, used where the JSON says `matches: "cast-in-string"`
//   T: metavariable this relation binds for the calling rule
.decl tc006_cast_in_string(n: node, t: loc)
tc006_cast_in_string(n, T) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), tc006_alt_5(c2, T).

// TC006(n): a finding at node n, from clause `unquoted-cast-type`.
// Each rule below is one way the JSON `rule` can match.
// `options` carries JSON settings that have no .rr form yet.
.violation TC006(at: node) "Quote the type expression passed to this `cast()` call, as in `cast(\"list[int]\", value)`."
    suppress noqa "TC006"
TC006_raw(n) :- tc006_unquoted_type(n).

// TC006_unquoted_cast_type_in_string(n): a finding at node n, from clause `unquoted-cast-type-in-string`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation TC006_unquoted_cast_type_in_string(at: node, t: node) code "TC006" "Quote the type expression passed to this `cast()` call, as in `cast(\"list[int]\", value)`."
    suppress noqa "TC006"
TC006_unquoted_cast_type_in_string_raw(T, n) :- tc006_cast_in_string(n, T).

// TC006_unquoted_cast_type_generator(n): a finding at node n, from clause `unquoted-cast-type-generator`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation TC006_unquoted_cast_type_generator(at: node, type: node) code "TC006" "Quote the type expression passed to this `cast()` call, as in `cast(\"list[int]\", value)`."
    suppress noqa "TC006"
TC006_unquoted_cast_type_generator_raw(TYPE, n) :- kind(n, "generator_expression"),
    match("(?s)\\((?:\\s*#[^\\n]*\\n)*\\s*(?P<TYPE>[^\\s#].*?)(?:\\s*#[^\\n\"']*\\n)*\\s*\\)", n),
    field(p1, "arguments", n), tc006_cast_call(p1).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl tc006_alt_1(n: node)
tc006_alt_1(n) :- kind(n, "comment").
tc006_alt_1(n) :- node(_, n, _, _, _), glob("(", n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl tc006_alt_2(n: node)
tc006_alt_2(n) :- (kind(n, "keyword_argument") ; kind(n, "dictionary_splat")).
tc006_alt_2(n) :- precedes(s1, n), !tc006_alt_1(s1).

// alt_4(n): the JSON `any`: n matches if any one of these rules does
.decl tc006_alt_4(n: node)
tc006_alt_4(n) :- (kind(n, "comment") ; kind(n, "parenthesized_expression")).
tc006_alt_4(n) :- node(_, n, _, _, _), glob("[()]", n).
tc006_alt_4(n) :- tc006_plain_string(n).

// alt_5(n): the JSON `any`: n matches if any one of these rules does
//   T: metavariable this relation binds for the calling rule
.decl tc006_alt_5(n: node, t: loc)
tc006_alt_5(n, T) :- tc006_unquoted_type(n), T = n.
tc006_alt_5(n, T) :- tc006_cast_in_string(n, T).

// main's file condition {"notRegex": "\\.pyi$"}
.decl TC006_raw(at: node)
TC006(v0) :- TC006_raw(v0), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).

// main's file condition {"notRegex": "\\.pyi$"}
.decl TC006_unquoted_cast_type_in_string_raw(at: node, t: node)
TC006_unquoted_cast_type_in_string(v0, v1) :- TC006_unquoted_cast_type_in_string_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).

// main's file condition {"notRegex": "\\.pyi$"}
.decl TC006_unquoted_cast_type_generator_raw(at: node, type: node)
TC006_unquoted_cast_type_generator(v0, v1) :- TC006_unquoted_cast_type_generator_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).
