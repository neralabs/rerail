.policy "ruff-ytt102-sys-version2" revision 1
.guests off
.description "Use sys.version_info.minor instead of indexing the third character of sys.version; the character is only the first digit of a two-digit minor version."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// YTT102(n): a finding at node n, from clause `sys-version2`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation YTT102(at: node, c: node) "Use `sys.version_info.minor` instead of `sys.version[2]`; the character is only the first digit of the minor version once it has two digits (3.10 gives \"1\")."
    suppress noqa "YTT102"
YTT102(C, n) :- ytt102_target(n), node(_, n, _, _, _), C = n.
YTT102(C, n) :- ytt102_splat_target(n),
    match("\\*(?:[\\s\\\\]|#[^\\n]*\\n)*(?<C>[\\s\\S]*)", n).
YTT102(C, n) :- ytt102_in_string(n, C).

// two_literal(n): the JSON util `two-literal`, used where the JSON says `matches: "two-literal"`
.decl ytt102_two_literal(n: node)
ytt102_two_literal(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int"), v1 = 2.
ytt102_two_literal(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    ytt102_two_literal(c2).

// two_subscript(n): the JSON util `two-subscript`, used where the JSON says `matches: "two-subscript"`
.decl ytt102_two_subscript(n: node)
ytt102_two_subscript(n) :- kind(n, "subscript"), field(n, "subscript", c1), ytt102_two_literal(c1),
    !ytt102_tok_has_1(n).

// subscripted(n): the JSON util `subscripted`, used where the JSON says `matches: "subscripted"`
.decl ytt102_subscripted(n: node)
ytt102_subscripted(n) :- child(p1, n, _), ytt102_counted_1(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), ytt102_counted_1(s2) }, k3 = 0,
    child(p4, n, _), ytt102_two_subscript(p4).
ytt102_subscripted(n) :- child(p5, n, _), kind(p5, "parenthesized_expression"),
    ytt102_subscripted(p5).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl ytt102_target(n: node)
ytt102_target(n) :- (kind(n, "identifier") ; kind(n, "attribute")), sym_of(n, "sys.version"),
    ytt102_subscripted(n).

// in_string(n): the JSON util `in-string`, used where the JSON says `matches: "in-string"`
//   C: metavariable this relation binds for the calling rule
.decl ytt102_in_string(n: node, c: loc)
ytt102_in_string(n, C) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), ytt102_alt_2(c2, C).

// splat_target(n): the JSON util `splat-target`, used where the JSON says `matches: "splat-target"`
.decl ytt102_splat_target(n: node)
ytt102_splat_target(n) :-
    ( kind(n, "attribute"), field(n, "object", c1), kind(c1, "list_splat"), child(c1, c2, _), kind(c2, "identifier"), sym_of(c2, "sys"), field(n, "attribute", c3), glob("version", c3)
    ; kind(n, "list_splat"), child(n, c4, _), kind(c4, "identifier"), sym_of(c4, "sys.version")
    ),
    ytt102_subscripted(n).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ytt102_tok_has_1(n: node)
.stored ytt102_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ytt102_tok_has_1(n) :- child(n, c2, _), glob("\\,", c2).
ytt102_tok_has_1(n) :- op(n, t3), match(",", t3).
ytt102_tok_has_1(n) :- child(n, c9, _), structural_before(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
ytt102_tok_has_1(n) :- child(n, c9, _), structural_after(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
ytt102_tok_has_1(n) :- node_text(n, g4), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g4).

// counted_1(n): the siblings the JSON `nthChild.ofRule` counts
.decl ytt102_counted_1(n: node)
ytt102_counted_1(n) :- node(_, n, _, _, _), !kind(n, "comment"),
    !kind(n, "line_continuation").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   C: metavariable this relation binds for the calling rule
.decl ytt102_alt_2(n: node, c: loc)
ytt102_alt_2(n, C) :- ytt102_target(n), C = n.
ytt102_alt_2(n, C) :- ytt102_in_string(n, C).
