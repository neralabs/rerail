.policy "ruff-up036-outdated-version-block" revision 1
.guests off
.description "Remove version checks on sys.version_info that are always true or false for the minimum supported Python version; keep only the branch that runs."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

.options {"python-minor-version": {"type": "integer", "default": 10, "description": "Minor version of the minimum supported Python 3 release (10 for Python 3.10)."}}

// test_value(n): the JSON util `test-value`, used where the JSON says `matches: "test-value"`
.decl up036_test_value(n: node)
up036_test_value(n) :- field(p1, "condition", n), kind(p1, "if_statement").
up036_test_value(n) :- field(p2, "condition", n), kind(p2, "elif_clause").
up036_test_value(n) :- child(p3, n, _), kind(p3, "parenthesized_expression"), up036_test_value(p3).

// comparator(n): the JSON util `comparator`, used where the JSON says `matches: "comparator"`
.decl up036_comparator(n: node)
up036_comparator(n) :- precedes_stop(s1, n, up036_stop_1),
    match("(==|!=|<|<=|>|>=|<>|in|is|not\\s[\\s\\S]*in|is\\s[\\s\\S]*not)", s1).

// version_ref(n): the JSON util `version-ref`, used where the JSON says `matches: "version-ref"`
.decl up036_version_ref(n: node)
up036_version_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, "sys.version_info").
up036_version_ref(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    up036_version_ref(c1).

// version_left(n): the JSON util `version-left`, used where the JSON says `matches: "version-left"`
.decl up036_version_left(n: node)
up036_version_left(n) :- up036_version_ref(n).
up036_version_left(n) :- kind(n, "subscript"), field(n, "value", c1), up036_version_ref(c1).
up036_version_left(n) :- kind(n, "attribute"), sym_of(n, "sys.version_info.major").
up036_version_left(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    up036_version_left(c2).

// version_compare(n): the JSON util `version-compare`, used where the JSON says `matches: "version-compare"`
.decl up036_version_compare(n: node)
up036_version_compare(n) :- kind(n, "comparison_operator"), up036_test_value(n),
    k9 = count : { up036_tok_has_1(n) }, k9 >= 1, k9 <= 1, child(n, c10, _),
    child(_, c10, 0), up036_version_left(c10).

// int_elem(n): the JSON util `int-elem`, used where the JSON says `matches: "int-elem"`
.decl up036_int_elem(n: node)
up036_int_elem(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int").
up036_int_elem(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), up036_int_elem(c2).

// first(n): the JSON util `first`, used where the JSON says `matches: "first"`
.decl up036_first(n: node)
up036_first(n) :- child(p1, n, _), up036_counted(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), up036_counted(s2) }, k3 = 0,
    up036_int_elem(n).

// second(n): the JSON util `second`, used where the JSON says `matches: "second"`
.decl up036_second(n: node)
up036_second(n) :- child(p1, n, _), up036_counted(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), up036_counted(s2) }, k3 = 1,
    up036_int_elem(n).

// third(n): the JSON util `third`, used where the JSON says `matches: "third"`
.decl up036_third(n: node)
up036_third(n) :- child(p1, n, _), up036_counted(n),
    k3 = count : { child(p1, s2, _), precedes(s2, n), up036_counted(s2) }, k3 = 2,
    up036_int_elem(n).

// int_tuple(n): the JSON util `int-tuple`, used where the JSON says `matches: "int-tuple"`
.decl up036_int_tuple(n: node)
up036_int_tuple(n) :- kind(n, "tuple"), count : { child(n, c1, _), !up036_alt_5(c1) } = 0.
up036_int_tuple(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), up036_int_tuple(c2).

// int23(n): the JSON util `int23`, used where the JSON says `matches: "int23"`
.decl up036_int23(n: node)
up036_int23(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int"),
    (value_type(v1, "int") ; value_type(v1, "float")), to_number(v1) >= 2,
    to_number(v1) <= 3.
up036_int23(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), up036_int23(c2).

// int_big(n): the JSON util `int-big`, used where the JSON says `matches: "int-big"`
.decl up036_int_big(n: node)
up036_int_big(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int"),
    (value_type(v1, "int") ; value_type(v1, "float")), to_number(v1) > 255.
up036_int_big(n) :- kind(n, "parenthesized_expression"), child(n, c2, _), up036_int_big(c2).

// tuple_major(n): the JSON util `tuple-major`, used where the JSON says `matches: "tuple-major"`
.decl up036_tuple_major(n: node)
up036_tuple_major(n) :- kind(n, "tuple"), up036_int_tuple(n),
    ( child(n, c1, _), up036_first(c1), value(c1, v1), (value_type(v1, "int") ; value_type(v1, "float")), to_number(v1) < 3
    ; child(n, c2, _), up036_first(c2), value(c2, "3"), count : { child(n, c3, _), up036_second(c3) } = 0
    ).

up036_tuple_major(n) :- kind(n, "parenthesized_expression"), child(n, c5, _),
    up036_tuple_major(c5).

// tuple_invalid(n): the JSON util `tuple-invalid`, used where the JSON says `matches: "tuple-invalid"`
.decl up036_tuple_invalid(n: node)
up036_tuple_invalid(n) :- kind(n, "tuple"), up036_int_tuple(n), up036_alt_7(n).
up036_tuple_invalid(n) :- kind(n, "parenthesized_expression"), child(n, c11, _),
    up036_tuple_invalid(c11).

// tuple_3(n): the JSON util `tuple-3`, used where the JSON says `matches: "tuple-3"`
.decl up036_tuple_3(n: node)
up036_tuple_3(n) :- kind(n, "tuple"), up036_int_tuple(n), child(n, c1, _), up036_first(c1),
    value(c1, "3"), child(n, c2, _), up036_second(c2), value(c2, v3),
    (value_type(v3, "int") ; value_type(v3, "float")), to_number(v3) <= 255,
    count : { child(n, c4, _), up036_third(c4), value(c4, v5), (value_type(v5, "int") ; value_type(v5, "float")), to_number(v5) > 255 } = 0.
up036_tuple_3(n) :- kind(n, "parenthesized_expression"), child(n, c6, _), up036_tuple_3(c6).

// minor_below(n): the JSON util `minor-below`, used where the JSON says `matches: "minor-below"`
.decl up036_minor_below(n: node)
up036_minor_below(n) :- up036_tuple_3(n), child(n, c1, _), up036_second(c1), value(c1, v2),
    option("python-minor-version", o_python_minor_version), v2 < "o_python_minor_version".
up036_minor_below(n) :- kind(n, "parenthesized_expression"), child(n, c3, _),
    up036_minor_below(c3).

// minor_at(n): the JSON util `minor-at`, used where the JSON says `matches: "minor-at"`
.decl up036_minor_at(n: node)
up036_minor_at(n) :- up036_tuple_3(n), child(n, c1, _), up036_second(c1), value(c1, v2),
    option("python-minor-version", o_python_minor_version), v2 <= "o_python_minor_version",
    ( child(n, c2, _), up036_second(c2), value(c2, v1), option("python-minor-version", o_python_minor_version), v1 < "o_python_minor_version"
    ; count : { child(n, c3, _), up036_third(c3), value(c3, v3), (value_type(v3, "int") ; value_type(v3, "float")), to_number(v3) > 0 } = 0
    ).

up036_minor_at(n) :- kind(n, "parenthesized_expression"), child(n, c7, _), up036_minor_at(c7).

// int_other_than_23(n): the JSON util `int-other-than-23`, used where the JSON says `matches: "int-other-than-23"`
.decl up036_int_other_than_23(n: node)
up036_int_other_than_23(n) :- kind(n, "integer"), value(n, v1), value_type(v1, "int"),
    (value_type(v1, "int") ; value_type(v1, "float")), to_number(v1) <= 255, !up036_int23(n).
up036_int_other_than_23(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    up036_int_other_than_23(c2).

// tuple_mixed(n): the JSON util `tuple-mixed`, used where the JSON says `matches: "tuple-mixed"`
.decl up036_tuple_mixed(n: node)
up036_tuple_mixed(n) :- kind(n, "tuple"), !up036_int_tuple(n).
up036_tuple_mixed(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    up036_tuple_mixed(c1).

// stops_chain(n): the JSON util `stops-chain`, used where the JSON says `matches: "stops-chain"`
.decl up036_stops_chain(n: node)
up036_stops_chain(n) :- up036_version_compare(n),
    ( child(n, c1, _), up036_comparator(c1), up036_int_other_than_23(c1)
    ; up036_tok_has_2(n), child(n, c2, _), up036_comparator(c2), up036_int23(c2)
    ; up036_tok_has_3(n), child(n, c3, _), up036_comparator(c3), up036_tuple_mixed(c3)
    ).


// stops_chain_test(n): the JSON util `stops-chain-test`, used where the JSON says `matches: "stops-chain-test"`
.decl up036_stops_chain_test(n: node)
up036_stops_chain_test(n) :- up036_stops_chain(n).
up036_stops_chain_test(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    up036_stops_chain_test(c1).

// after_stop(n): the JSON util `after-stop`, used where the JSON says `matches: "after-stop"`
.decl up036_after_stop(n: node)
up036_after_stop(n) :- up036_demand_after_stop(n), up036_up_1(n, p1),
    ( child(p2, p1, _), kind(p2, "if_statement"), field(p2, "condition", c1), up036_stops_chain_test(c1)
    ; precedes(s1, p1), kind(s1, "elif_clause"), field(s1, "condition", c2), up036_stops_chain_test(c2)
    ).


// UP036(n): a finding at node n, from clause `outdated-version-block`.
// Each rule below is one way the JSON `rule` can match.
.violation UP036(at: node) "Remove this `sys.version_info` check: for the minimum supported Python version it is always true or always false, so keep only the branch that runs and delete the other."
    suppress noqa "UP036"
UP036(n) :- up036_version_compare(n), !up036_after_stop(n),
    ( up036_tok_has_4(n), child(n, c1, _), up036_comparator(c1), up036_int23(c1)
    ; up036_tok_has_5(n), child(n, c2, _), up036_comparator(c2), up036_tuple_major(c2)
    ; up036_tok_has_6(n), child(n, c3, _), up036_comparator(c3), up036_minor_below(c3)
    ; up036_tok_has_7(n), child(n, c4, _), up036_comparator(c4), up036_minor_at(c4)
    ).


// UP036_invalid_version_specifier(n): a finding at node n, from clause `invalid-version-specifier`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation UP036_invalid_version_specifier(at: node, v: node) code "UP036" "Fix this version in the `sys.version_info` comparison: no Python version component exceeds 255, so this specifier is invalid; write the version you meant."
    suppress noqa "UP036"
UP036_invalid_version_specifier(V, n) :- up036_version_compare(n), !up036_after_stop(n),
    ( child(n, c1, _), up036_comparator(c1), up036_int_big(c1), up036_alt_13(c1, V)
    ; up036_tok_has_8(n), child(n, c2, _), up036_comparator(c2), up036_tuple_invalid(c2), up036_alt_14(c2, V)
    ).


