    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:==)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:!=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
up036_tok_has_4(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:==)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:!=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
up036_tok_has_4(n) :- node_text(n, g3), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:==)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:!=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).

// tok_has_5(n): a child of n, a named node or an anonymous token, matches "^(<|<=|>|>=)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up036_tok_has_5(n: node)
.stored up036_tok_has_5 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up036_tok_has_5(n) :- child(n, c10, _), glob("{<,<=,>,>=}", c10).
up036_tok_has_5(n) :- op(n, t11), match("(<|<=|>|>=)", t11).
up036_tok_has_5(n) :- child(n, c17, _), structural_before(c17, g12),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g12).
up036_tok_has_5(n) :- child(n, c17, _), structural_after(c17, g12),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g12).
up036_tok_has_5(n) :- node_text(n, g12), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g12).

// tok_has_6(n): a child of n, a named node or an anonymous token, matches "^(<=|>)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up036_tok_has_6(n: node)
.stored up036_tok_has_6 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up036_tok_has_6(n) :- child(n, c19, _), glob("{<=,>}", c19).
up036_tok_has_6(n) :- op(n, t20), match("(<=|>)", t20).
up036_tok_has_6(n) :- child(n, c26, _), structural_before(c26, g21),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g21).
up036_tok_has_6(n) :- child(n, c26, _), structural_after(c26, g21),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g21).
up036_tok_has_6(n) :- node_text(n, g21), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g21).

// tok_has_7(n): a child of n, a named node or an anonymous token, matches "^(<|>=)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up036_tok_has_7(n: node)
.stored up036_tok_has_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up036_tok_has_7(n) :- child(n, c28, _), glob("{<,>=}", c28).
up036_tok_has_7(n) :- op(n, t29), match("(<|>=)", t29).
up036_tok_has_7(n) :- child(n, c35, _), structural_before(c35, g30),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g30).
up036_tok_has_7(n) :- child(n, c35, _), structural_after(c35, g30),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g30).
up036_tok_has_7(n) :- node_text(n, g30), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g30).

// tok_has_8(n): a child of n, a named node or an anonymous token, matches "^(<|<=|>|>=)$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl up036_tok_has_8(n: node)
.stored up036_tok_has_8 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
up036_tok_has_8(n) :- child(n, c3, _), glob("{<,<=,>,>=}", c3).
up036_tok_has_8(n) :- op(n, t4), match("(<|<=|>|>=)", t4).
up036_tok_has_8(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).
up036_tok_has_8(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).
up036_tok_has_8(n) :- node_text(n, g5), !child(n, _, _),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:<=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?|(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:>=)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g5).

// demand_after_stop: the nodes after_stop is asked at (it looks at every ancestor of every node)
.decl up036_demand_after_stop(n: node)
up036_demand_after_stop(n) :- up036_version_compare(n),
    ( up036_tok_has_4(n), child(n, c1, _), up036_comparator(c1), up036_int23(c1)
    ; up036_tok_has_5(n), child(n, c2, _), up036_comparator(c2), up036_tuple_major(c2)
    ; up036_tok_has_6(n), child(n, c3, _), up036_comparator(c3), up036_minor_below(c3)
    ; up036_tok_has_7(n), child(n, c4, _), up036_comparator(c4), up036_minor_at(c4)
    ).

up036_demand_after_stop(n) :- up036_version_compare(n),
    ( child(n, c1, _), up036_comparator(c1), up036_int_big(c1), up036_alt_13(c1, V)
    ; up036_tok_has_8(n), child(n, c2, _), up036_comparator(c2), up036_tuple_invalid(c2), up036_alt_14(c2, V)
    ).


// up_1(n, p): p is an ancestor of n the `inside` step stops at and matches, from the n the rule allows
.decl up036_up_1(n: node, p: node)
up036_up_1(n, p) :- up036_demand_after_stop(n), within_stop(n, p, up036_stop_10), kind(p, "elif_clause").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl up036_stop_1(n: node)
up036_stop_1(n) :- node(_, n, _, _, _), !kind(n, "comment"), !kind(n, "line_continuation").

// counted(n): 3 identical copies of one rule set (`counted_2`, `counted_3`, `counted_4`), folded into one.
.decl up036_counted(n: node)
up036_counted(n) :- node(_, n, _, _, _), !kind(n, "comment").

// alt_5(n): the JSON `any`: n matches if any one of these rules does
.decl up036_alt_5(n: node)
up036_alt_5(n) :- node(_, n, _, _, _), glob("[(),]", n).
up036_alt_5(n) :- kind(n, "comment").
up036_alt_5(n) :- up036_int_elem(n).

// alt_7(n): the JSON `any`: n matches if any one of these rules does
.decl up036_alt_7(n: node)
up036_alt_7(n) :- child(n, c1, _), up036_first(c1), value(c1, v2),
    (value_type(v2, "int") ; value_type(v2, "float")), to_number(v2) > 255.
up036_alt_7(n) :- child(n, c3, _), up036_first(c3), value(c3, "3"), child(n, c4, _), up036_second(c4),
    value(c4, v5), (value_type(v5, "int") ; value_type(v5, "float")),
    to_number(v5) > 255.
up036_alt_7(n) :- child(n, c6, _), up036_first(c6), value(c6, "3"), child(n, c7, _), up036_second(c7),
    value(c7, v8), (value_type(v8, "int") ; value_type(v8, "float")),
    to_number(v8) <= 255, child(n, c9, _), up036_third(c9), value(c9, v10),
    (value_type(v10, "int") ; value_type(v10, "float")), to_number(v10) > 255.

// stop_10(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl up036_stop_10(n: node)
up036_stop_10(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// alt_13(n): the JSON `any`: n matches if any one of these rules does
//   V: metavariable this relation binds for the calling rule
.decl up036_alt_13(n: node, v: loc)
up036_alt_13(n, V) :- kind(n, "integer"), node(_, n, _, _, _), V = n.
up036_alt_13(n, V) :- has(n, c1, "integer"), node(_, c1, _, _, _), V = c1.

// alt_14(n): the JSON `any`: n matches if any one of these rules does
//   V: metavariable this relation binds for the calling rule
.decl up036_alt_14(n: node, v: loc)
up036_alt_14(n, V) :- kind(n, "tuple"), node(_, n, _, _, _), V = n.
up036_alt_14(n, V) :- has(n, c1, "tuple"), node(_, c1, _, _, _), V = c1.
