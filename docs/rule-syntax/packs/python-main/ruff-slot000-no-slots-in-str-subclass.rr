.policy "ruff-slot000-no-slots-in-str-subclass" revision 1
.guests off
.description "Define __slots__ in subclasses of str (enums excepted); without it every instance carries its own attribute dict and uses more memory."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// SLOT000(n): a finding at node n, from clause `no-slots-in-str-subclass`.
// Each rule below is one way the JSON `rule` can match.
// `options` carries JSON settings that have no .rr form yet.
.violation SLOT000(at: node) "Add `__slots__ = ()` to this `str` subclass so instances skip the per-instance `__dict__`; if it assigns instance attributes, list their names in `__slots__` instead."
    suppress noqa "SLOT000"
SLOT000_raw(n) :- kind(n, "identifier"), field(p1, "name", n),
    kind(p1, "class_definition"), field(p1, "superclasses", c2),
    kind(c2, "argument_list"), child(c2, c3, _), slot000_str_base(c3),
    count : { field(p1, "superclasses", c4), kind(c4, "argument_list"), child(c4, c5, _), slot000_enum_base(c5, TB, _, _, _, _, _, _, _, _, _) } = 0,
    count : { field(p1, "body", c6), child(c6, c7, _), slot000_slots_statement(c7) } = 0.

// slots_target(n): the JSON util `slots-target`, used where the JSON says `matches: "slots-target"`
.decl slot000_slots_target(n: node)
slot000_slots_target(n) :- kind(n, "identifier"), glob("__slots__", n).
slot000_slots_target(n) :- kind(n, "tuple_pattern"), child(n, c1, _), slot000_slots_target(c1),
    !slot000_tok_has_1(n).

// slots_assignment(n): the JSON util `slots-assignment`, used where the JSON says `matches: "slots-assignment"`
.decl slot000_slots_assignment(n: node)
slot000_slots_assignment(n) :- kind(n, "assignment"), slot000_alt_1(n).

// slots_statement(n): the JSON util `slots-statement`, used where the JSON says `matches: "slots-statement"`
.decl slot000_slots_statement(n: node)
slot000_slots_statement(n) :- kind(n, "expression_statement"), child(n, c1, _),
    kind(c1, "assignment"), slot000_slots_assignment(c1).

// str_base(n): the JSON util `str-base`, used where the JSON says `matches: "str-base"`
.decl slot000_str_base(n: node)
slot000_str_base(n) :- slot000_demand_str_base(n), (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "str"), sym_of(n, "builtins.str").
slot000_str_base(n) :- slot000_demand_str_base(n), kind(n, "identifier"), glob("str", n),
    ref_site(n, b1), site_form(b1, "typeParameter"),
    count : { inside(n, p2, "module"), within(c3, p2), slot000_alt_2(c3) } = 0.
slot000_str_base(n) :- slot000_demand_str_base(n), kind(n, "parenthesized_expression"),
    child(n, c4, _), slot000_str_base(c4).

// enum_name(n, …): the JSON util `enum-name`, called with `matches` and arguments E
//   K, N1, N2, N3, N4, SB: metavariables of the calling rule, passed in (bound by the caller)
//   KX, N, OX: metavariables this relation binds for the calling rule
.decl slot000_enum_name(n: node, e: node, k: loc, kx: loc, n_mv: loc, n1: loc, n2: loc, n3: loc, n4: loc, ox: loc, sb: loc)
slot000_enum_name(n, E, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_enum_name(n), node(_, n, _, _, _), E = n,
    slot000_alt_4(n, K, KX, N, N1, N2, N3, N4, OX, SB).

// enum_base(n, …): the JSON util `enum-base`, called with `matches` and arguments E
//   K, N1, N2, N3, N4, SB: metavariables of the calling rule, passed in (bound by the caller)
//   KX, N, OX: metavariables this relation binds for the calling rule
.decl slot000_enum_base(n: node, e: node, k: loc, kx: loc, n_mv: loc, n1: loc, n2: loc, n3: loc, n4: loc, ox: loc, sb: loc)
slot000_enum_base(n, E, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_enum_base(n), node(_, n, _, _, _), E = n,
    slot000_alt_6(n, K, KX, N, N1, N2, N3, N4, OX, SB).

// class_ref(n, …): the JSON util `class-ref`, called with `matches` and arguments K
//   O: metavariable of the calling rule, passed in (bound by the caller)
//   N, OX: metavariables this relation binds for the calling rule
.decl slot000_class_ref(n: node, k: node, n_mv: loc, o: loc, ox: loc)
// K: not bound by this rule, so empty (unset) here, as in ast-grep.
slot000_class_ref(n, K, N, O, OX) :- slot000_demand_class_ref(n), slot000_alt_8(n, N, O, OX), unset(K).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl slot000_tok_has_1(n: node)
.stored slot000_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
slot000_tok_has_1(n) :- child(n, c2, _), glob("\\,", c2).
slot000_tok_has_1(n) :- op(n, t3), match(",", t3).
slot000_tok_has_1(n) :- child(n, c9, _), structural_before(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
slot000_tok_has_1(n) :- child(n, c9, _), structural_after(c9, g4),
    match("(?s)^(?:.*(?:,).*)$", g4).
slot000_tok_has_1(n) :- node_text(n, g4), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g4).

// demand_alt_4: the nodes alt_4 is asked at (its recursion looks at every descendant)
.decl slot000_demand_alt_4(n: node)
slot000_demand_alt_4(n) :- slot000_demand_enum_name(n), node(_, n, _, _, _), E = n.

// demand_alt_6: the nodes alt_6 is asked at (its recursion looks at every descendant)
.decl slot000_demand_alt_6(n: node)
slot000_demand_alt_6(n) :- slot000_demand_enum_base(n), node(_, n, _, _, _), E = n.

// demand_enum_base: the nodes enum_base is asked at (its recursion looks at every descendant)
.decl slot000_demand_enum_base(n: node)
slot000_demand_enum_base(c5) :- kind(n, "identifier"), field(p1, "name", n),
    kind(p1, "class_definition"), field(p1, "superclasses", c2),
    kind(c2, "argument_list"), child(c2, c3, _), slot000_str_base(c3),
    field(p1, "superclasses", c4), kind(c4, "argument_list"), child(c4, c5, _).
slot000_demand_enum_base(c4) :- slot000_demand_alt_4(n), kind(n, "identifier"), ref_site(n, b2),
    kind(b2, "class_definition"), field(b2, "superclasses", c3),
    kind(c3, "argument_list"), child(c3, c4, _).
slot000_demand_enum_base(c11) :- slot000_demand_alt_4(n), kind(n, "attribute"),
    slot000_class_ref(n, K, N, _, OX), inside(n, p5, "module"), within(c6, p5),
    kind(c6, "identifier"), node(_, c6, _, _, _), KX = c6, text(KX, t7), text(K, t7),
    field(p9, "name", c6), kind(p9, "class_definition"),
    field(p9, "superclasses", c10), kind(c10, "argument_list"), child(c10, c11, _), @doc(KX) = @doc(K).
slot000_demand_enum_base(c2) :- slot000_demand_alt_6(n), kind(n, "parenthesized_expression"),
    child(n, c2, _).

// demand_enum_name: the nodes enum_name is asked at (its recursion looks at every descendant)
.decl slot000_demand_enum_name(n: node)
slot000_demand_enum_name(c12) :- slot000_demand_alt_4(n), kind(n, "parenthesized_expression"),
    child(n, c12, _).
slot000_demand_enum_name(n) :- slot000_demand_alt_6(n).
slot000_demand_enum_name(c1) :- slot000_demand_alt_6(n), kind(n, "subscript"), field(n, "value", c1).

// demand_alt_8: the nodes alt_8 is asked at (its recursion looks at every descendant)
.decl slot000_demand_alt_8(n: node)
slot000_demand_alt_8(n) :- slot000_demand_class_ref(n).

// demand_class_ref: the nodes class_ref is asked at (its recursion looks at every descendant)
.decl slot000_demand_class_ref(n: node)
slot000_demand_class_ref(n) :- node(_, K, _, _, _), slot000_demand_alt_4(n), kind(n, "attribute"),
    inside(n, p5, "module"), within(c6, p5), kind(c6, "identifier"), node(_, c6, _, _, _), KX = c6,
    text(KX, t7), text(K, t7), field(p9, "name", c6), kind(p9, "class_definition"),
    field(p9, "superclasses", c10), kind(c10, "argument_list"), child(c10, c11, _), @doc(KX) = @doc(K).
slot000_demand_class_ref(c3) :- slot000_demand_alt_8(n), kind(n, "parenthesized_expression"),
    child(n, c3, _).
slot000_demand_class_ref(c5) :- node(_, K, _, _, _), node(_, O, _, _, _), slot000_demand_alt_8(n),
    kind(n, "attribute"), field(n, "attribute", c4), kind(c4, "identifier"), node(_, c4, _, _, _), N = c4,
    field(n, "object", c5), inside(n, p6, "module"), within(c7, p6),
    kind(c7, "identifier"), node(_, c7, _, _, _), OX = c7, text(OX, t8), text(O, t8),
    field(p10, "name", c7), kind(p10, "class_definition"), field(p10, "body", c11),
    within_stop(c12, c11, slot000_stop_7), kind(c12, "class_definition"),
    field(c12, "name", c13), kind(c13, "identifier"), text(c13, t_k2), text(K, t_k2),
    text(K, t14), text(N, t14), site_latest(c13), @doc(OX) = @doc(O), @doc(c13) = @doc(K), @doc(K) = @doc(N).

// demand_str_base: the nodes str_base is asked at (its recursion looks at every descendant)
.decl slot000_demand_str_base(n: node)
slot000_demand_str_base(c3) :- kind(n, "identifier"), field(p1, "name", n),
    kind(p1, "class_definition"), field(p1, "superclasses", c2),
    kind(c2, "argument_list"), child(c2, c3, _).
slot000_demand_str_base(c4) :- slot000_demand_str_base(n), kind(n, "parenthesized_expression"),
    child(n, c4, _).

// set_3: symbols from the JSON `resolves.import`
.decl slot000_set_3(v: symbol)
slot000_set_3("enum.Enum"). slot000_set_3("enum.Flag"). slot000_set_3("enum.IntEnum"). slot000_set_3("enum.IntFlag").
slot000_set_3("enum.StrEnum"). slot000_set_3("enum.ReprEnum"). slot000_set_3("enum.CheckEnum").

// stop_7: the kinds of the JSON `stopBy` rule: the tree search stops at these nodes
.decl slot000_stop_7(kind: symbol)
slot000_stop_7("class_definition"). slot000_stop_7("function_definition").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl slot000_alt_1(n: node)
slot000_alt_1(n) :- field(n, "left", c1), slot000_slots_target(c1).
slot000_alt_1(n) :- field(n, "right", c2), kind(c2, "assignment"), slot000_slots_assignment(c2).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl slot000_alt_2(n: node)
slot000_alt_2(n) :- kind(n, "dotted_name"), glob("builtins", n).
slot000_alt_2(n) :- kind(n, "identifier"), glob("str", n), (bind_only(n) ; aug_target(n)),
    !site_form(n, "typeParameter").

// alt_4(n): the JSON `any`: n matches if any one of these rules does
//   K, N1, N2, N3, N4, SB: metavariables of the calling rule, passed in (bound by the caller)
//   KX, N, OX: metavariables this relation binds for the calling rule
.decl slot000_alt_4(n: node, k: loc, kx: loc, n_mv: loc, n1: loc, n2: loc, n3: loc, n4: loc, ox: loc, sb: loc)
// KX, N, OX: not bound by this rule, so empty (unset) here, as in ast-grep.
slot000_alt_4(n, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_alt_4(n),(kind(n, "identifier") ; kind(n, "attribute")),sym_of(n, q1),slot000_set_3(q1),unset(KX),unset(N),unset(OX), unset(K), unset(N1), unset(N2), unset(N3), unset(N4), unset(SB).
slot000_alt_4(n, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_alt_4(n), kind(n, "identifier"),
    ref_site(n, b2), kind(b2, "class_definition"), field(b2, "superclasses", c3),
    kind(c3, "argument_list"), child(c3, c4, _),
    slot000_enum_base(c4, SB, K, KX, N, N1, N2, N3, N4, OX, SB).
slot000_alt_4(n, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_alt_4(n), kind(n, "attribute"),
    slot000_class_ref(n, K, N, _, OX), inside(n, p5, "module"), within(c6, p5),
    kind(c6, "identifier"), node(_, c6, _, _, _), KX = c6, text(KX, t7), text(K, t7),
    field(p9, "name", c6), kind(p9, "class_definition"),
    field(p9, "superclasses", c10), kind(c10, "argument_list"), child(c10, c11, _),
    slot000_enum_base(c11, SB, K, KX, N, N1, N2, N3, N4, OX, SB), @doc(KX) = @doc(K).
slot000_alt_4(n, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_alt_4(n),
    kind(n, "parenthesized_expression"), child(n, c12, _),
    slot000_enum_name(c12, N4, K, KX, N, N1, N2, N3, N4, OX, SB).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
//   K, N1, N2, N3, N4, SB: metavariables of the calling rule, passed in (bound by the caller)
//   KX, N, OX: metavariables this relation binds for the calling rule
.decl slot000_alt_6(n: node, k: loc, kx: loc, n_mv: loc, n1: loc, n2: loc, n3: loc, n4: loc, ox: loc, sb: loc)
slot000_alt_6(n, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_alt_6(n),
    slot000_enum_name(n, N1, K, KX, N, N1, N2, N3, N4, OX, SB).
slot000_alt_6(n, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_alt_6(n), kind(n, "subscript"),
    field(n, "value", c1), slot000_enum_name(c1, N2, K, KX, N, N1, N2, N3, N4, OX, SB).
slot000_alt_6(n, K, KX, N, N1, N2, N3, N4, OX, SB) :- slot000_demand_alt_6(n),
    kind(n, "parenthesized_expression"), child(n, c2, _),
    slot000_enum_base(c2, N3, K, KX, N, N1, N2, N3, N4, OX, SB).

// alt_8(n): the JSON `any`: n matches if any one of these rules does
//   O: metavariables of the calling rule, passed in (bound by the caller)
//   N, OX: metavariables this relation binds for the calling rule
.decl slot000_alt_8(n: node, n_mv: loc, o: loc, ox: loc)
// N, OX: not bound by this rule, so empty (unset) here, as in ast-grep.
slot000_alt_8(n, N, O, OX) :- node(_, K, _, _, _),slot000_demand_alt_8(n),kind(n, "identifier"),ref_site(n, b1),kind(b1, "class_definition"),field(b1, "name", c2),text(c2, t_k1),text(K, t_k1),unset(N),unset(OX),@doc(c2) = @doc(K), unset(O).
slot000_alt_8(n, N, O, OX) :- slot000_demand_alt_8(n), kind(n, "parenthesized_expression"),
    child(n, c3, _), slot000_class_ref(c3, K, N, O, OX).
slot000_alt_8(n, N, O, OX) :- node(_, K, _, _, _), slot000_demand_alt_8(n), kind(n, "attribute"),
    field(n, "attribute", c4), kind(c4, "identifier"), node(_, c4, _, _, _), N = c4,
    field(n, "object", c5), slot000_class_ref(c5, O, N, O, OX), inside(n, p6, "module"),
    within(c7, p6), kind(c7, "identifier"), node(_, c7, _, _, _), OX = c7, text(OX, t8), text(O, t8),
    field(p10, "name", c7), kind(p10, "class_definition"), field(p10, "body", c11),
    within_stop(c12, c11, slot000_stop_7), kind(c12, "class_definition"),
    field(c12, "name", c13), kind(c13, "identifier"), text(c13, t_k2), text(K, t_k2),
    text(K, t14), text(N, t14), site_latest(c13), @doc(OX) = @doc(O), @doc(c13) = @doc(K), @doc(K) = @doc(N).

// main's file condition {"notRegex": "\\.pyi$"}
.decl SLOT000_raw(at: node)
SLOT000(v0) :- SLOT000_raw(v0), rr_d = @doc(v0), doc(rr_d, rr_p, _), !match("\\.pyi$", rr_p).
