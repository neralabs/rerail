.decl pie794_tok_precedes_7(n: node)
.stored pie794_tok_precedes_7 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pie794_tok_precedes_7(n) :- next_sibling(n, s9), glob("=", s9).
pie794_tok_precedes_7(n) :- structural_after(n, g11), match("\\s*", g11), child(p12, n, _),
