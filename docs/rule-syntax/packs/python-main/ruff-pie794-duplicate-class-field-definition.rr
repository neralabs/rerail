.decl pie794_tok_precedes_9(n: node)
.stored pie794_tok_precedes_9 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pie794_tok_precedes_9(n) :- next_sibling(n, s10), glob("=", s10).
pie794_tok_precedes_9(n) :- structural_after(n, g12), match("\\s*", g12), child(p13, n, _),
