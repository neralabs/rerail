// demand_alt_2: the rows of alt_2 its callers ask for (the metavariable columns they pass in)
.decl pie794_demand_alt_2(n: node, n_mv: loc)
pie794_demand_alt_2(c11, N) :- kind(n, "expression_statement"), child(n, c1, _),
    kind(c1, "assignment"), child(c1, c2, _), pie794_target_n(c2, N), child(c1, c11, _),
    pie794_tok_follows_3(c11).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pie794_alt_1(n: node)
pie794_alt_1(n) :- pie794_tok_follows_6(n).
pie794_alt_1(n) :- child(p8, n, _), kind(p8, "keyword_argument"), pie794_tok_precedes_7(n).

// alt_2(n): the JSON `any`: n matches if any one of these rules does
//   N: metavariable of the calling rule, passed in (bound by the caller)
.decl pie794_alt_2(n: node, n_mv: loc)
pie794_alt_2(n, N) :- pie794_demand_alt_2(n, N), kind(n, "identifier"), text(n, t_n1), text(N, t_n1), @doc(n) = @doc(N).
pie794_alt_2(n, N) :- pie794_demand_alt_2(n, N), has(n, c1, "identifier"),
    text(c1, t_n2), text(N, t_n2), !pie794_alt_1(c1), @doc(c1) = @doc(N).
