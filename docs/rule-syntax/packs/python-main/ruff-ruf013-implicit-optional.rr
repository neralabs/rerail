// tok_has_10(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf013_tok_has_10(n: node)
.stored ruf013_tok_has_10 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf013_tok_has_10(n) :- child(n, c27, _), glob("\\,", c27).
ruf013_tok_has_10(n) :- op(n, t28), match(",", t28).
ruf013_tok_has_10(n) :- child(n, c34, _), structural_before(c34, g29),
    match("(?s)^(?:.*(?:,).*)$", g29).
ruf013_tok_has_10(n) :- child(n, c34, _), structural_after(c34, g29),
    match("(?s)^(?:.*(?:,).*)$", g29).
ruf013_tok_has_10(n) :- node_text(n, g29), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g29).

// tok_has_11(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf013_tok_has_11(n: node)
.stored ruf013_tok_has_11 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf013_tok_has_11(n) :- child(n, c8, _), glob("\\,", c8).
ruf013_tok_has_11(n) :- op(n, t9), match(",", t9).
ruf013_tok_has_11(n) :- child(n, c15, _), structural_before(c15, g10),
    match("(?s)^(?:.*(?:,).*)$", g10).
ruf013_tok_has_11(n) :- child(n, c15, _), structural_after(c15, g10),
    match("(?s)^(?:.*(?:,).*)$", g10).
ruf013_tok_has_11(n) :- node_text(n, g10), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g10).

// tok_has_12(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl ruf013_tok_has_12(n: node)
.stored ruf013_tok_has_12 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
ruf013_tok_has_12(n) :- child(n, c18, _), glob("\\,", c18).
ruf013_tok_has_12(n) :- op(n, t19), match(",", t19).
ruf013_tok_has_12(n) :- child(n, c25, _), structural_before(c25, g20),
    match("(?s)^(?:.*(?:,).*)$", g20).
ruf013_tok_has_12(n) :- child(n, c25, _), structural_after(c25, g20),
    match("(?s)^(?:.*(?:,).*)$", g20).
ruf013_tok_has_12(n) :- node_text(n, g20), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g20).

// set_4: symbols from the JSON `resolves.import`
.decl ruf013_set_4(v: symbol)
ruf013_set_4("typing.Union"). ruf013_set_4("typing.Literal"). ruf013_set_4("typing.Annotated").
ruf013_set_4("typing.Optional"). ruf013_set_4("typing_extensions.Union").
ruf013_set_4("typing_extensions.Literal"). ruf013_set_4("typing_extensions.Annotated").
ruf013_set_4("typing_extensions.Optional"). ruf013_set_4("_typeshed.Union").
ruf013_set_4("_typeshed.Literal"). ruf013_set_4("_typeshed.Annotated"). ruf013_set_4("_typeshed.Optional").

// set_5: symbols from the JSON `resolves.import`
.decl ruf013_set_5(v: symbol)
ruf013_set_5("collections.abc.Hashable"). ruf013_set_5("typing.Hashable").
ruf013_set_5("typing_extensions.Hashable"). ruf013_set_5("_typeshed.Hashable").
ruf013_set_5("builtins.object").

// set_25: node kinds from a JSON `any`
.decl ruf013_set_25(v: symbol)
ruf013_set_25("none"). ruf013_set_25("identifier"). ruf013_set_25("attribute"). ruf013_set_25("subscript").
ruf013_set_25("generic_type"). ruf013_set_25("string"). ruf013_set_25("concatenated_string").
ruf013_set_25("binary_operator"). ruf013_set_25("type"). ruf013_set_25("parenthesized_expression").
ruf013_set_25("union_type").

// ref_of_case: one row per relation folded into ref_of: its key, then the strings that differed.
.decl ruf013_ref_of_case(key: symbol, s1: symbol, s2: symbol, s3: symbol)
ruf013_ref_of_case("annotated", "typing.Annotated", "typing_extensions.Annotated", "_typeshed.Annotated").
ruf013_ref_of_case("literal", "typing.Literal", "typing_extensions.Literal", "_typeshed.Literal").
ruf013_ref_of_case("optional", "typing.Optional", "typing_extensions.Optional", "_typeshed.Optional").
ruf013_ref_of_case("union", "typing.Union", "typing_extensions.Union", "_typeshed.Union").

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_1(n: node)
ruf013_alt_1(n) :- node(_, n, _, _, _), match("[\\[\\],|]", n).
ruf013_alt_1(n) :- kind(n, "comment").

// alt_10(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_10(n: node)
ruf013_alt_10(n) :- node(_, n, _, _, _), match("[\\[\\](),|:]", n).
ruf013_alt_10(n) :- kind(n, "comment").

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_11(n: node)
ruf013_alt_11(n) :- (kind(n, "type") ; kind(n, "parenthesized_expression")).
ruf013_alt_11(n) :- kind(n, "tuple").

// alt_15(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_15(n: node)
ruf013_alt_15(n) :- kind(n, "subscript"), child(n, c1, _), ruf013_union_element(c1).
ruf013_alt_15(n) :- kind(n, "generic_type"), child(n, c2, _), kind(c2, "type_parameter"),
    child(c2, c3, _), ruf013_union_element(c3).

// alt_16(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_16(n: node)
ruf013_alt_16(n) :- kind(n, "subscript"), child(n, c1, _), ruf013_literal_none(c1).
ruf013_alt_16(n) :- kind(n, "generic_type"), child(n, c2, _), kind(c2, "type_parameter"),
    child(c2, c3, _), ruf013_literal_none(c3).

// alt_17(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_17(n: node)
ruf013_alt_17(n) :- kind(n, "subscript"), child(n, c1, _), ruf013_allows_none(c1),
    count : { precedes(s2, c1), ruf013_generic_item(s2) } = 0.
ruf013_alt_17(n) :- kind(n, "generic_type"), child(n, c3, _), kind(c3, "type_parameter"),
    child(c3, c4, _), ruf013_allows_none(c4),
    count : { precedes(s5, c4), ruf013_generic_item(s5) } = 0.
ruf013_alt_17(n) :- kind(n, "subscript"), !ruf013_tok_has_7(n), field(n, "subscript", c14),
    ruf013_tuple_first_allows_none(c14).
ruf013_alt_17(n) :- kind(n, "generic_type"), child(n, c15, _), kind(c15, "type_parameter"),
    !ruf013_tok_has_8(c15), child(c15, c24, _), ruf013_tuple_first_allows_none(c24).

// alt_18(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_18(n: node)
ruf013_alt_18(n) :- node(_, n, _, _, _),
    count : { child(n, c1, _), ruf013_generic_head(c1), ruf013_known_name(c1) } = 0.
ruf013_alt_18(n) :- child(n, c2, _), ruf013_generic_head(c2), ruf013_ref_of(c2, "optional").
ruf013_alt_18(n) :- child(n, c3, _), ruf013_generic_head(c3), ruf013_ref_of(c3, "union"), ruf013_alt_15(n).
ruf013_alt_18(n) :- child(n, c7, _), ruf013_generic_head(c7), ruf013_ref_of(c7, "literal"), ruf013_alt_16(n).
ruf013_alt_18(n) :- child(n, c11, _), ruf013_generic_head(c11), ruf013_ref_of(c11, "annotated"), ruf013_alt_17(n).

// alt_22(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_22(n: node)
ruf013_alt_22(n) :- (kind(n, "string") ; kind(n, "concatenated_string")).
ruf013_alt_22(n) :- ruf013_allows_none(n).

// alt_23(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_23(n: node)
ruf013_alt_23(n) :- kind(n, "ERROR").
ruf013_alt_23(n) :- child(n, c1, _), ruf013_alt_22(c1).

// alt_27(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_27(n: node)
ruf013_alt_27(n) :- kind(n, k1), ruf013_set_25(k1).
ruf013_alt_27(n) :- ruf013_alt_10(n).

// alt_31(n): the JSON `any`: n matches if any one of these rules does
//   W: metavariable this relation binds for the calling rule
.decl ruf013_alt_31(n: node, w: loc)
ruf013_alt_31(n, W) :- kind(n, "subscript"), child(n, c1, _), ruf013_reported_inner(c1, W),
    count : { precedes(s2, c1), ruf013_generic_item(s2) } = 0.
ruf013_alt_31(n, W) :- kind(n, "generic_type"), child(n, c3, _), kind(c3, "type_parameter"),
    child(c3, c4, _), ruf013_reported_inner(c4, W),
    count : { precedes(s5, c4), ruf013_generic_item(s5) } = 0.
ruf013_alt_31(n, W) :- kind(n, "subscript"), !ruf013_tok_has_7(n), field(n, "subscript", c14),
    ruf013_tuple_first_reported(c14, W).
ruf013_alt_31(n, W) :- kind(n, "generic_type"), child(n, c15, _), kind(c15, "type_parameter"),
    !ruf013_tok_has_8(c15), child(c15, c24, _), ruf013_tuple_first_reported(c24, W).

// alt_32(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_32(n: node)
ruf013_alt_32(n) :- (kind(n, "type") ; kind(n, "parenthesized_expression")).
ruf013_alt_32(n) :- (kind(n, "string") ; kind(n, "concatenated_string")).
ruf013_alt_32(n) :- (kind(n, "subscript") ; kind(n, "generic_type")), child(n, c1, _),
    ruf013_generic_head(c1), ruf013_ref_of(c1, "annotated").
ruf013_alt_32(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Annotated")
    ; sym_of(n, "typing_extensions.Annotated")
    ; sym_of(n, "_typeshed.Annotated")
    ).

ruf013_alt_32(n) :- ruf013_allows_none(n).
ruf013_alt_32(n) :- kind(n, "comment").

// alt_35(n): the JSON `any`: n matches if any one of these rules does
.decl ruf013_alt_35(n: node)
ruf013_alt_35(n) :- (kind(n, "type") ; kind(n, "parenthesized_expression")).
ruf013_alt_35(n) :- (kind(n, "subscript") ; kind(n, "generic_type")), child(n, c1, _),
    ruf013_generic_head(c1), ruf013_ref_of(c1, "annotated").
ruf013_alt_35(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Annotated")
    ; sym_of(n, "typing_extensions.Annotated")
    ; sym_of(n, "_typeshed.Annotated")
    ).

ruf013_alt_35(n) :- ruf013_allows_none(n).
ruf013_alt_35(n) :- kind(n, "comment").
