.policy "ruff-f507-percent-format-positional-count-mismatch" revision 1
.guests off
.description "Match the number of %-format placeholders to the number of values supplied; a mismatch raises TypeError at run time."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/format-args.rr"

// F507(n): a finding at node n, from clause `percent-format-positional-count-mismatch`.
// Each rule below is one way the JSON `rule` can match.
.violation F507(at: node) "Make the number of values match the placeholders in this %-format string; a mismatch raises TypeError."
    suppress noqa "F507"
F507(n) :- n ~ `$S % $R`,
    ( fa_percent_tree(n, _, _), fa_percent_unused(n, a1), !kind(a1, "pair")
    ; fa_percent_tree(n, _, _), fa_percent_missing(n, f1), f507_alt_1(f1)
    ).


// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl f507_alt_1(n: node)
f507_alt_1(n) :- kind(n, "star").
f507_alt_1(n) :- kind(n, "placeholder"),
    count : { child(n, c1, _), kind(c1, "mapping_key") } = 0.
