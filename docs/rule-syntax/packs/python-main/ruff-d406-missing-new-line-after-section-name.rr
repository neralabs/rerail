.policy "ruff-d406-missing-new-line-after-section-name" revision 1
.guests off
.description "End a NumPy-style section name at the end of its line, with no colon or trailing whitespace after it."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// D406(n): a finding at node n, from clause `section-name-suffix`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation D406(at: node, name: node) "Remove the colon or trailing whitespace after the section name `{name}` so the line holds only the name."
    suppress noqa "D406"
D406(NAME, n) :- kind(n, "string_content"), d406_numpy_style(n), child(p1, n, _),
    d406_docstring(p1),
    count : { value(p1, v2), match("(?s:.*)\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:extended summary|other parameters|short summary|other params|attributes|references|parameters|examples|see also|warnings|receives|methods|returns|raises|yields|notes|warns):?[ \\t]*(?:\\n|\\z)(?s:.*)", v2) } = 0,
    d406_alt_16(n, NAME).

// docstring(n): the JSON util `docstring`, used where the JSON says `matches: "docstring"`
.decl d406_docstring(n: node)
d406_docstring(n) :- kind(n, "string"),
    count : { child(n, c1, _), kind(c1, "string_start"), glob("**[bBfFtT]**", c1) } = 0,
    within_stop(n, p2, d406_stop_1), kind(p2, "expression_statement"), !d406_alt_2(p2),
    child(p12, p2, _),
    ( kind(p12, "module")
    ; kind(p12, "block"), child(p1, p12, _), (kind(p1, "function_definition") ; kind(p1, "class_definition"))
    ).


// numpy_style(n): the JSON util `numpy-style`, used where the JSON says `matches: "numpy-style"`
.decl d406_numpy_style(n: node)
d406_numpy_style(n) :- kind(n, "string_content"),
    ( d406_args_header_family(n, "params_header")
    ; !d406_args_header_family(n, "args_header"), d406_alt_12(n)
    ).


// args_header_family(n, key): 6 copies of one rule set (`args-header`, `google-only-header`, `google-only-headers-2` and 3 more), folded into one: row `key` of
// args_header_family_case gives the strings each copy had.
.decl d406_args_header_family(n: node, key: symbol)
d406_args_header_family(n, q1) :- d406_args_header_family_case(q1, s1),
    kind(n, "string_content"), match(s1, n).

// underline_before_colon(n): the JSON util `underline-before-colon`, used where the JSON says `matches: "underline-before-colon"`
.decl d406_underline_before_colon(n: node)
d406_underline_before_colon(n) :- kind(n, "string_content"), d406_alt_15(n).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d406_tok_has_1(n: node)
.stored d406_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d406_tok_has_1(n) :- child(n, c3, _), glob("\\,", c3).
d406_tok_has_1(n) :- op(n, t4), match(",", t4).
d406_tok_has_1(n) :- child(n, c10, _), structural_before(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
d406_tok_has_1(n) :- child(n, c10, _), structural_after(c10, g5),
    match("(?s)^(?:.*(?:,).*)$", g5).
d406_tok_has_1(n) :- node_text(n, g5), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g5).

// tok_has_2(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl d406_tok_has_2(n: node)
.stored d406_tok_has_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
d406_tok_has_2(n) :- child(n, c1, _), glob("\\,", c1).
d406_tok_has_2(n) :- op(n, t2), match(",", t2).
d406_tok_has_2(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d406_tok_has_2(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
d406_tok_has_2(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// args_header_family_case: one row per relation folded into args_header_family: its key, then the strings that differed.
.decl d406_args_header_family_case(key: symbol, s1: symbol)
d406_args_header_family_case("args_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:rguments|rgs)|K(?i:eyword arguments|eyword args)|O(?i:ther arguments|ther args)):?[^\\S\\n]*(?m:$))(?s:.*)").
d406_args_header_family_case("google_only_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)").
d406_args_header_family_case("google_only_headers_2", "(?s:.*)(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*)").
d406_args_header_family_case("numpy_only_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)").
d406_args_header_family_case("numpy_only_headers_2", "(?s:.*)(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))(?s:.*)\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)(?s:.*)").
d406_args_header_family_case("params_header", "(?s:.*)(?:\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:O(?i:ther parameters|ther params)|P(?i:arameters)):?[^\\S\\n]*(?m:$))(?s:.*)").

// stop_1(n): the JSON `stopBy` rule: the tree search stops at these nodes
.decl d406_stop_1(n: node)
d406_stop_1(n) :- node(_, n, _, _, _), !kind(n, "parenthesized_expression").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl d406_alt_2(n: node)
d406_alt_2(n) :- d406_tok_has_2(n).
d406_alt_2(n) :- precedes(s9, n), !kind(s9, "comment").

// alt_11(n): the JSON `any`: n matches if any one of these rules does
.decl d406_alt_11(n: node)
d406_alt_11(n) :- d406_args_header_family(n, "google_only_header"),
    !d406_args_header_family(n, "numpy_only_header").
d406_alt_11(n) :- d406_args_header_family(n, "google_only_headers_2"),
    !d406_args_header_family(n, "numpy_only_headers_2").

// alt_12(n): the JSON `any`: n matches if any one of these rules does
.decl d406_alt_12(n: node)
d406_alt_12(n) :-
    ( d406_args_header_family(n, "numpy_only_header"), !d406_args_header_family(n, "google_only_header")
    ; d406_args_header_family(n, "numpy_only_headers_2"), !d406_args_header_family(n, "google_only_headers_2")
    ).

d406_alt_12(n) :- !d406_alt_11(n), d406_underline_before_colon(n).

// alt_15(n): the JSON `any`: n matches if any one of these rules does
.decl d406_alt_15(n: node)
d406_alt_15(n) :- node(_, n, _, _, _),
    !match("(?s:.*)(?:(?m:^)[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):[^\\S\\n]*(?m:$)(?:\\z|\\n[^\\S\\n]*(?m:$)|\\n[^\\S\\n]*(?:[^\\s\\-]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])))(?s:.*)", n).
d406_alt_15(n) :- node(_, n, _, _, _),
    match("(?s)(?s:.*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*-+[^\\S\\n]*(?m:$).*?(?:(?m:^)[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):[^\\S\\n]*(?m:$)(?:\\z|\\n[^\\S\\n]*(?m:$)|\\n[^\\S\\n]*(?:[^\\s\\-]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])))(?s:.*)", n).

// alt_16(n): the JSON `any`: n matches if any one of these rules does
//   NAME: metavariable this relation binds for the calling rule
.decl d406_alt_16(n: node, name: loc)
d406_alt_16(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)\\n[^\\S\\n]*(?P<NAME>(?i:extended summary|other parameters|short summary|other params|attributes|references|parameters|examples|see also|warnings|receives|methods|returns|raises|yields|notes|warns))(?:[^\\S\\r\\n]+|:[^\\S\\r\\n]*)\\r?(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)(?s:.*)", n).
d406_alt_16(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?P<NAME>(?i:extended summary|other parameters|short summary|other params|attributes|references|parameters|examples|see also|warnings|receives|methods|returns|raises|yields|notes|warns))(?:[^\\S\\r\\n]+|:[^\\S\\r\\n]*)\\r?(?m:$)(?s:.*)", n).
d406_alt_16(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?P<NAME>(?:A(?i:ttributes)|E(?i:xtended summary|xamples)|M(?i:ethods)|N(?i:otes)|O(?i:ther parameters|ther params)|P(?i:arameters)|R(?i:eferences|eceives|eturns|aises)|S(?i:hort summary|ee also)|W(?i:arnings|arns)|Y(?i:ields)))(?:[^\\S\\r\\n]+|:[^\\S\\r\\n]*)\\r?(?m:$)(?s:.*)", n).
d406_alt_16(n, NAME) :- node(_, n, _, _, _),
    match("(?s:.*)(?:(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?P<NAME>(?:a(?i:ttributes)|e(?i:xtended summary|xamples)|m(?i:ethods)|n(?i:otes)|o(?i:ther parameters|ther params)|p(?i:arameters)|r(?i:eferences|eceives|eturns|aises)|s(?i:hort summary|ee also)|w(?i:arnings|arns)|y(?i:ields)))(?:[^\\S\\r\\n]+|:[^\\S\\r\\n]*)\\r?(?m:$))|\\n[^\\S\\n]*(?i:keyword arguments|extended summary|other parameters|other arguments|short summary|other params|keyword args|attributes|references|parameters|other args|arguments|attention|important|examples|see also|warnings|receives|methods|returns|caution|example|warning|raises|yields|danger|return|notes|warns|error|yield|args|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*))(?s:.*)", n).
