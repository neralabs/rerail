.policy "ruff-air302-airflow3-moved-to-provider" revision 2
.guests off
.description "Import Airflow hooks, operators and other names that moved into provider packages in Airflow 3.0 from their provider modules; the old core import paths are gone."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// airflow_name(n): the JSON util `airflow-name`, used where the JSON says `matches: "airflow-name"`
.decl air302_airflow_name(n: node)
air302_airflow_name(n) :- kind(n, "dotted_name"), match("airflow([^0-9A-Za-z_]|$).*", n).

// imports_airflow(n): the JSON util `imports-airflow`, used where the JSON says `matches: "imports-airflow"`
.decl air302_imports_airflow(n: node)
air302_imports_airflow(n) :- within(c1, n), air302_airflow_name(c1),
    ( child(p1, c1, _), kind(p1, "import_statement")
    ; child(p2, c1, _), kind(p2, "aliased_import"), child(p3, p2, _), kind(p3, "import_statement")
    ; field(p4, "module_name", c1), kind(p4, "import_from_statement")
    ).


// seen_airflow(n): the JSON util `seen-airflow`, used where the JSON says `matches: "seen-airflow"`
.decl air302_seen_airflow(n: node)
air302_seen_airflow(n) :- air302_demand_seen_airflow(n), inside(n, p1, "module"),
    air302_imports_airflow(p1).

// string_literal(n): the JSON util `string-literal`, used where the JSON says `matches: "string-literal"`
.decl air302_string_literal(n: node)
air302_string_literal(n) :- (kind(n, "string") ; kind(n, "concatenated_string")).

// after_dot(n): the JSON util `after-dot`, used where the JSON says `matches: "after-dot"`
.decl air302_after_dot(n: node)
air302_after_dot(n) :- air302_tok_follows_1(n).

// import_site(n): the JSON util `import-site`, used where the JSON says `matches: "import-site"`
.decl air302_import_site(n: node)
air302_import_site(n) :- child(p1, n, _), kind(p1, "aliased_import").
air302_import_site(n) :- air302_tok_follows_2(n).

// import_error(n): the JSON util `import-error`, used where the JSON says `matches: "import-error"`
.decl air302_import_error(n: node)
air302_import_error(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    (global_ref(n, "ImportError") ; global_ref(n, "ModuleNotFoundError")),
    (sym_of(n, "builtins.ImportError") ; sym_of(n, "builtins.ModuleNotFoundError")).
air302_import_error(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air302_import_error(c1).

// import_error_type(n): the JSON util `import-error-type`, used where the JSON says `matches: "import-error-type"`
.decl air302_import_error_type(n: node)
air302_import_error_type(n) :- air302_import_error(n).
air302_import_error_type(n) :- kind(n, "tuple"), child(n, c1, _), air302_import_error(c1).
air302_import_error_type(n) :- (kind(n, "parenthesized_expression") ; kind(n, "as_pattern")),
    child(n, c2, _), air302_import_error_type(c2).

// attribute_error(n): the JSON util `attribute-error`, used where the JSON says `matches: "attribute-error"`
.decl air302_attribute_error(n: node)
air302_attribute_error(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    global_ref(n, "AttributeError"), sym_of(n, "builtins.AttributeError").
air302_attribute_error(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    air302_attribute_error(c1).

// attribute_error_type(n): the JSON util `attribute-error-type`, used where the JSON says `matches: "attribute-error-type"`
.decl air302_attribute_error_type(n: node)
air302_attribute_error_type(n) :- air302_attribute_error(n).
air302_attribute_error_type(n) :- kind(n, "tuple"), child(n, c1, _), air302_attribute_error(c1).
air302_attribute_error_type(n) :- (kind(n, "parenthesized_expression") ; kind(n, "as_pattern")),
    child(n, c2, _), air302_attribute_error_type(c2).

// import_fallback(n): the JSON util `import-fallback`, used where the JSON says `matches: "import-fallback"`
.decl air302_import_fallback(n: node)
air302_import_fallback(n) :- air302_demand_import_fallback(n), inside(n, p1, "except_clause"),
    air302_up_1(n, p2), child(p2, c3, _), kind(c3, "except_clause"), field(c3, "value", c4),
    air302_import_error_type(c4).

// attribute_fallback(n): the JSON util `attribute-fallback`, used where the JSON says `matches: "attribute-fallback"`
.decl air302_attribute_fallback(n: node)
air302_attribute_fallback(n) :- air302_demand_attribute_fallback(n), inside(n, p1, "except_clause"),
    air302_up_2(n, p2), child(p2, c3, _), kind(c3, "except_clause"), field(c3, "value", c4),
    air302_attribute_error_type(c4).

// moved_bare(n): the JSON util `moved-bare`, used where the JSON says `matches: "moved-bare"`
//   N, ORIG: metavariables this relation binds for the calling rule
.decl air302_moved_bare(n: node, n_mv: loc, orig: loc)
air302_moved_bare(n, N, ORIG) :- kind(n, "identifier"), node(_, n, _, _, _), N = n, air302_alt_2(n, ORIG), !air302_alt_4(n).
air302_moved_bare(n, N, ORIG) :- kind(n, "attribute"), field(n, "attribute", c8), node(_, c8, _, _, _), N = c8,
    node(_, c8, _, _, _), ORIG = c8.

