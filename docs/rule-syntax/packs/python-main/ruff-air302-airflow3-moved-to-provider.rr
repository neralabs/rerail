// tok_follows_1(n): an earlier sibling of n, a named node or an anonymous token, matches "^\\.$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air302_tok_follows_1(n: node)
.stored air302_tok_follows_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air302_tok_follows_1(n) :- next_sibling(s1, n), glob(".", s1).
air302_tok_follows_1(n) :- structural_before(n, g3), match("\\s*", g3), child(p4, n, _),
    node(_, n, _, st6, _), o5 = st6 - strlen(g3), token(p4, _, t2, _, o5),
    match("\\.", t2).
air302_tok_follows_1(n) :- structural_before(n, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\.)\\s*)$", g3).

// tok_follows_2(n): an earlier sibling of n, a named node or an anonymous token, matches "^import$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl air302_tok_follows_2(n: node)
.stored air302_tok_follows_2 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
air302_tok_follows_2(n) :- precedes(s2, n), glob("import", s2).
air302_tok_follows_2(n) :- child(p5, n, _), node(_, n, _, st7, _), token(p5, _, t3, _, en8),
    en8 <= st7, match("import", t3).
air302_tok_follows_2(n) :- structural_before(n, g4),
    match("(?s)^(?:(?:.*\\W)?(?:import)(?:\\W.*)?)$", g4).
air302_tok_follows_2(n) :- precedes(o6, n), structural_before(o6, g4),
    match("(?s)^(?:(?:.*\\W)?(?:import)(?:\\W.*)?)$", g4).

// from_module: the module text of from-import s, read as `relative: "text"` does (dots dropped)
.decl air302_from_module(s: node, m: symbol)
air302_from_module(s, m) :- kind(s, "future_import_statement"), m = "__future__".
air302_from_module(s, m) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "dotted_name"), name(x, m).
air302_from_module(s, m) :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "relative_import"), child(x, y, _), kind(y, "dotted_name"), name(y, m).
air302_from_module(s, "") :- kind(s, "import_from_statement"), field(s, "module_name", x),
    kind(x, "relative_import"), count : { child(x, y, _), kind(y, "dotted_name") } = 0.

// statement_name: dotted name n in an import statement imports q (relative modules by their text)
.decl air302_statement_name(n: node, q: symbol)
air302_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    kind(s, "import_statement"), name(n, q).
air302_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    kind(s, "relative_import"), name(n, q).
air302_statement_name(n, q) :- kind(n, "dotted_name"), field(a, "name", n),
    kind(a, "aliased_import"), child(s, a, _), kind(s, "import_statement"), name(n, q).
air302_statement_name(n, q) :- kind(n, "dotted_name"), field(a, "name", n),
    kind(a, "aliased_import"), child(s, a, _),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    air302_from_module(s, m), name(n, x), q = @dot(m, x).
air302_statement_name(n, m) :- kind(n, "dotted_name"), field(s, "module_name", n),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    air302_from_module(s, m).
air302_statement_name(n, q) :- kind(n, "dotted_name"), child(s, n, _),
    (kind(s, "import_from_statement") ; kind(s, "future_import_statement")),
    !field(s, "module_name", n), air302_from_module(s, m), name(n, x), q = @dot(m, x).

