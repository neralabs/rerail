// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl b030_alt_1(n: node)
b030_alt_1(n) :- (kind(n, "parenthesized_expression") ; kind(n, "comment") ; kind(n, "as_pattern")).
b030_alt_1(n) :- node(_, n, _, _, _), glob("[(),*+:\\[\\]]", n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl b030_alt_3(n: node)
b030_alt_3(n) :- b030_type_slot(n), !kind(n, "tuple").
b030_alt_3(n) :- b030_elem_of_type_tuple(n).
b030_alt_3(n) :- b030_comma_elem(n).
b030_alt_3(n) :- b030_elem_of_splat_seq(n).
b030_alt_3(n) :- b030_plus(n), b030_value_of_queued_splat(n).
b030_alt_3(n) :- b030_plus(n), b030_side_of_queued_plus(n).
b030_alt_3(n) :- b030_elem_of_side_tuple(n).
