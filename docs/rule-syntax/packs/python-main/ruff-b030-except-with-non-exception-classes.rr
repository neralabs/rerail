.decl b030_tok_follows_3(n: node)
.stored b030_tok_follows_3 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b030_tok_follows_3(n) :- next_sibling(s16, n), match("(?s).*..*", s16).
b030_tok_follows_3(n) :- structural_before(n, g18), match("\\s*", g18), child(p19, n, _),
    node(_, n, _, st21, _), o20 = st21 - strlen(g18), token(p19, _, t17, _, o20),
    match("(?s).*..*", t17).
b030_tok_follows_3(n) :- structural_before(n, g18), match("(?s)^.*\\S\\s*$", g18).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "^\\+$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b030_tok_has_4(n: node)
.stored b030_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b030_tok_has_4(n) :- child(n, c1, _), glob("+", c1).
b030_tok_has_4(n) :- op(n, t2), match("\\+", t2).
b030_tok_has_4(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\+)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
b030_tok_has_4(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:\\+)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g3).
b030_tok_has_4(n) :- node_text(n, g3), !child(n, _, _),
