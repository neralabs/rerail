.policy "ruff-pyi017-complex-assignment-in-stub" revision 1
.guests off
.description "Declare each name in a stub file with its own simple assignment instead of chained, unpacking, attribute or item assignments; a stub only declares names."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// simple_target(n): the JSON util `simple-target`, used where the JSON says `matches: "simple-target"`
.decl pyi017_simple_target(n: node)
pyi017_simple_target(n) :- kind(n, "identifier").
pyi017_simple_target(n) :- kind(n, "tuple_pattern"), !pyi017_tok_has_1(n), child(n, c9, _),
    pyi017_simple_target(c9).

// module_or_class_assignment(n): the JSON util `module-or-class-assignment`, used where the JSON says `matches: "module-or-class-assignment"`
.decl pyi017_module_or_class_assignment(n: node)
pyi017_module_or_class_assignment(n) :- kind(n, "assignment"), !pyi017_alt_1(n), child(p3, n, _),
    kind(p3, "expression_statement").

// PYI017(n, detail): findings from clauses `attribute-target`, `multiple-targets`. Their messages differ only in
// `detail`: each rule's head gives its clause's words. Each rule is one way a JSON `rule` can match.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI017(at: node, detail: symbol) "{detail}."
    suppress noqa "PYI017"
PYI017_raw(n, "Remove this attribute or item assignment from the stub; declare the name where it lives instead, for example `x: int` in the class body or module that defines `x`") :- pyi017_module_or_class_assignment(n),
    field(n, "left", c1), (kind(c1, "attribute") ; kind(c1, "subscript")).
PYI017_raw(n, "Split this into one declaration per name, for example `a: int` and `b: int` on separate lines, instead of chaining or unpacking assignment targets") :- pyi017_module_or_class_assignment(n),
    count : { field(n, "left", c1), (kind(c1, "attribute") ; kind(c1, "subscript")) } = 0,
    ( field(n, "left", c2), !pyi017_simple_target(c2)
    ; field(n, "right", c3), kind(c3, "assignment")
    ).


// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi017_tok_has_1(n: node)
.stored pyi017_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi017_tok_has_1(n) :- child(n, c1, _), glob("\\,", c1).
pyi017_tok_has_1(n) :- op(n, t2), match(",", t2).
pyi017_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
pyi017_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
pyi017_tok_has_1(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// alt_1(n): the JSON `any`: n matches if any one of these rules does
.decl pyi017_alt_1(n: node)
pyi017_alt_1(n) :- field(n, "type", c1), kind(c1, "type").
pyi017_alt_1(n) :- inside(n, p2, "function_definition").

// main's file condition {"regex": "\\.pyi$"}
.decl PYI017_raw(at: node, detail: symbol)
PYI017(v0, v1) :- PYI017_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).
