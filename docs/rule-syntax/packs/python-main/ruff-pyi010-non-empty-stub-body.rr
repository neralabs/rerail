// OVERRIDE (hand-written, not generated). Clause non-empty-stub-body-before-comment: as generated, except
// for the kinds below.
// The reader matches a regex with a capture only over a node whose kind the clause names, so the
// statement's possible kinds (tree-sitter-python's statements) are named as a disjunction.
.policy "ruff-pyi010-non-empty-stub-body" revision 1
.guests off
.description "Use an ellipsis as the whole body of a function in stub files instead of real statements; stubs are never executed, so bodies are redundant."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// filler(n): the JSON util `filler`, used where the JSON says `matches: "filler"`
.decl pyi010_filler(n: node)
pyi010_filler(n) :- (kind(n, "comment") ; kind(n, "line_continuation")).
pyi010_filler(n) :- node(_, n, _, _, _), glob(";", n).

// plain_prefix(n): the JSON util `plain-prefix`, used where the JSON says `matches: "plain-prefix"`
.decl pyi010_plain_prefix(n: node)
pyi010_plain_prefix(n) :- node(_, n, _, _, _), match("[ruRU]{0,2}[\"'].*", n).

// docstring_value(n): the JSON util `docstring-value`, used where the JSON says `matches: "docstring-value"`
.decl pyi010_docstring_value(n: node)
pyi010_docstring_value(n) :- kind(n, "string"), pyi010_plain_prefix(n).
pyi010_docstring_value(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), !pyi010_plain_prefix(c1) } = 0.
pyi010_docstring_value(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    pyi010_docstring_value(c2).

// ellipsis_value(n): the JSON util `ellipsis-value`, used where the JSON says `matches: "ellipsis-value"`
.decl pyi010_ellipsis_value(n: node)
pyi010_ellipsis_value(n) :- kind(n, "ellipsis").
pyi010_ellipsis_value(n) :- kind(n, "parenthesized_expression"), child(n, c1, _),
    pyi010_ellipsis_value(c1).

// allowed_body(n): the JSON util `allowed-body`, used where the JSON says `matches: "allowed-body"`
.decl pyi010_allowed_body(n: node)
pyi010_allowed_body(n) :- kind(n, "pass_statement").
pyi010_allowed_body(n) :- kind(n, "expression_statement"), !pyi010_tok_has_1(n), child(n, c9, _),
    (pyi010_docstring_value(c9) ; pyi010_ellipsis_value(c9)).

// sole_statement(n): the JSON util `sole-statement`, used where the JSON says `matches: "sole-statement"`
.decl pyi010_sole_statement(n: node)
pyi010_sole_statement(n) :- !pyi010_alt_3(n), child(p3, n, _), kind(p3, "block"),
    field(p4, "body", p3), kind(p4, "function_definition").

// block_like(n): the JSON util `block-like`, used where the JSON says `matches: "block-like"`
.decl pyi010_block_like(n: node)
pyi010_block_like(n) :- kind(n, k1), pyi010_set_5(k1).

// ends_in_comment(n): the JSON util `ends-in-comment`, used where the JSON says `matches: "ends-in-comment"`
.decl pyi010_ends_in_comment(n: node)
pyi010_ends_in_comment(n) :- pyi010_block_like(n), child(n, c1, _),
    child(p2, c1, _), k4 = count : { child(p2, s3, _), precedes(c1, s3) }, k4 = 0,
    pyi010_alt_6(c1).

// PYI010(n): a finding at node n, from clause `non-empty-stub-body`.
// Each rule below is one way the JSON `rule` can match.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI010(at: node) "Replace this function body with `...`; stubs are never executed, so a real body is redundant."
    suppress noqa "PYI010"
PYI010_raw(n) :- pyi010_sole_statement(n), !pyi010_ends_in_comment(n).

// PYI010_non_empty_stub_body_before_comment(n): a finding at node n, from clause `non-empty-stub-body-before-comment`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
// `options` carries JSON settings that have no .rr form yet.
.violation PYI010_non_empty_stub_body_before_comment(at: node, body: node) code "PYI010" "Replace this function body with `...`; stubs are never executed, so a real body is redundant."
    suppress noqa "PYI010"
PYI010_non_empty_stub_body_before_comment_raw(BODY, n) :- pyi010_sole_statement(n),
    (kind(n, "expression_statement") ; kind(n, "return_statement") ; kind(n, "delete_statement") ; kind(n, "raise_statement") ; kind(n, "pass_statement") ; kind(n, "break_statement") ; kind(n, "continue_statement") ; kind(n, "global_statement") ; kind(n, "nonlocal_statement") ; kind(n, "exec_statement") ; kind(n, "print_statement") ; kind(n, "assert_statement") ; kind(n, "import_statement") ; kind(n, "import_from_statement") ; kind(n, "future_import_statement") ; kind(n, "type_alias_statement") ; kind(n, "if_statement") ; kind(n, "for_statement") ; kind(n, "while_statement") ; kind(n, "try_statement") ; kind(n, "with_statement") ; kind(n, "function_definition") ; kind(n, "class_definition") ; kind(n, "decorated_definition") ; kind(n, "match_statement")),
    pyi010_ends_in_comment(n),
    match("(?P<BODY>(?s:.*\\n)?(?:(?:[ \\t\\f]|\\\\\\r?\\n)*(?:\"\"\"(?s:.*?)\"\"\"|'''(?s:.*?)'''|(?i:[rt]?[ft][r]?)\"(?:[^\"{\\\\\\n]|\\\\.|\\{[^}\\n]*\\})*\"|(?i:[rt]?[ft][r]?)'(?:[^'{\\\\\\n]|\\\\.|\\{[^}\\n]*\\})*'|\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*'|[^\\s#\"'\\\\]))+)(?:\\s*(?:#[^\\n]*|\\\\\\r?\\n))+", n).

// tok_has_1(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl pyi010_tok_has_1(n: node)
.stored pyi010_tok_has_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
pyi010_tok_has_1(n) :- child(n, c1, _), glob("\\,", c1).
pyi010_tok_has_1(n) :- op(n, t2), match(",", t2).
pyi010_tok_has_1(n) :- child(n, c8, _), structural_before(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
pyi010_tok_has_1(n) :- child(n, c8, _), structural_after(c8, g3),
    match("(?s)^(?:.*(?:,).*)$", g3).
pyi010_tok_has_1(n) :- node_text(n, g3), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g3).

// set_5: node kinds from a JSON `any`
.decl pyi010_set_5(v: symbol)
pyi010_set_5("block"). pyi010_set_5("if_statement"). pyi010_set_5("elif_clause"). pyi010_set_5("else_clause").
pyi010_set_5("for_statement"). pyi010_set_5("while_statement"). pyi010_set_5("try_statement").
pyi010_set_5("except_clause"). pyi010_set_5("finally_clause"). pyi010_set_5("with_statement").
pyi010_set_5("match_statement"). pyi010_set_5("case_clause"). pyi010_set_5("function_definition").
pyi010_set_5("class_definition"). pyi010_set_5("decorated_definition").

// alt_3(n): the JSON `any`: n matches if any one of these rules does
.decl pyi010_alt_3(n: node)
pyi010_alt_3(n) :- pyi010_filler(n).
pyi010_alt_3(n) :- pyi010_allowed_body(n).
pyi010_alt_3(n) :- (precedes(s1, n), !pyi010_filler(s1) ; precedes(n, s2), !pyi010_filler(s2)).

// alt_6(n): the JSON `any`: n matches if any one of these rules does
.decl pyi010_alt_6(n: node)
pyi010_alt_6(n) :- kind(n, "comment").
pyi010_alt_6(n) :- pyi010_ends_in_comment(n).

// main's file condition {"regex": "\\.pyi$"}
.decl PYI010_raw(at: node)
PYI010(v0) :- PYI010_raw(v0), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).

// main's file condition {"regex": "\\.pyi$"}
.decl PYI010_non_empty_stub_body_before_comment_raw(at: node, body: node)
PYI010_non_empty_stub_body_before_comment(v0, v1) :- PYI010_non_empty_stub_body_before_comment_raw(v0, v1), rr_d = @doc(v0), doc(rr_d, rr_p, _), match("\\.pyi$", rr_p).
