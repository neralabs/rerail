b003_tok_has_3(n) :- node_text(n, g12), !child(n, _, _), match("(?s)^(?:.*(?:,).*)$", g12).

// tok_has_4(n): a child of n, a named node or an anonymous token, matches "^,$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl b003_tok_has_4(n: node)
.stored b003_tok_has_4 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
b003_tok_has_4(n) :- child(n, c1, _), glob("\\,", c1).
b003_tok_has_4(n) :- op(n, t2), match(",", t2).
b003_tok_has_4(n) :- child(n, c8, _), structural_before(c8, g3),
