.policy "bandit-b507-ssh-no-host-key-verification" revision 4
.guests off
.description "Don't let Paramiko auto-accept unknown SSH host keys with AutoAddPolicy or WarningPolicy; it opens the door to man-in-the-middle attacks."
.language python
.mode steer
.scope include "**/*.py"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

// B507(n): a finding at node n, from clause `b507`.
// Each rule below is one way the JSON `rule` can match.
// The JSON `constraints` on POLICY are added to every rule.
.violation B507(at: node) "Set paramiko.RejectPolicy and load known host keys instead of auto-accepting unknown ones; that invites man-in-the-middle attacks."
    suppress nosec "B507"
B507(n) :- kind(n, "call"), b507_arg_policy_1(n, a1), POLICY = a1,
    field(n, "arguments", c2), child(c2, c3, _), b507_trusting_policy(c3),
    field(n, "function", c4), b507_target_callee(c4), b507_after_paramiko_import(n),
    b507_trusting_policy(POLICY).

// paramiko_import(n): the JSON util `paramiko-import`, used where the JSON says `matches: "paramiko-import"`
.decl b507_paramiko_import(n: node)
b507_paramiko_import(n) :-
    ( kind(n, "import_statement")
    ; kind(n, "import_from_statement")
    ; kind(n, "future_import_statement")
    ),
    has(n, c1, "dotted_name"), contains("paramiko", c1).

// after_paramiko_import(n): the JSON util `after-paramiko-import`, used where the JSON says `matches: "after-paramiko-import"`
.decl b507_after_paramiko_import(n: node)
b507_after_paramiko_import(n) :- b507_demand_after_paramiko_import(n), within(n, p1),
    precedes(s2, p1), (b507_paramiko_import(s2) ; within(c1, s2), b507_paramiko_import(c1)).

// alias_to_target(n): the JSON util `alias-to-target`, used where the JSON says `matches: "alias-to-target"`
//   ALIAS: metavariable of the calling rule, passed in (bound by the caller)
.decl b507_alias_to_target(n: node, alias: loc)
b507_alias_to_target(n, ALIAS) :- b507_demand_alias_to_target(n, ALIAS),
    kind(n, "aliased_import"), field(n, "alias", c1),
    text(c1, t_alias1), text(ALIAS, t_alias1), field(n, "name", c2),
    match(".*(?:^|\\.)\\s*set_missing_host_key_policy", c2), @doc(c1) = @doc(ALIAS).

// after_alias_to_target(n): the JSON util `after-alias-to-target`, used where the JSON says `matches: "after-alias-to-target"`
//   ALIAS: metavariable of the calling rule, passed in (bound by the caller)
.decl b507_after_alias_to_target(n: node, alias: loc)
b507_after_alias_to_target(n, ALIAS) :- b507_demand_after_alias_to_target(n, ALIAS),
    within(n, p1), precedes(s2, p1), within(c3, s2), b507_alias_to_target(c3, ALIAS).

// target_callee(n): the JSON util `target-callee`, used where the JSON says `matches: "target-callee"`
.decl b507_target_callee(n: node)
b507_target_callee(n) :- kind(n, "attribute"), field(n, "attribute", c1),
    glob("set_missing_host_key_policy", c1).
b507_target_callee(n) :- kind(n, "identifier"), glob("set_missing_host_key_policy", n).
b507_target_callee(n) :- kind(n, "identifier"), node(_, n, _, _, _), ALIAS = n,
    b507_after_alias_to_target(n, ALIAS).
b507_target_callee(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    b507_target_callee(c2).

// policy_name(n): the JSON util `policy-name`, used where the JSON says `matches: "policy-name"`
.decl b507_policy_name(n: node)
b507_policy_name(n) :- kind(n, "attribute"), field(n, "attribute", c1),
    glob("{AutoAddPolicy,WarningPolicy}", c1).
b507_policy_name(n) :- kind(n, "identifier"), glob("{AutoAddPolicy,WarningPolicy}", n).
b507_policy_name(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    b507_policy_name(c2).

// trusting_policy(n): the JSON util `trusting-policy`, used where the JSON says `matches: "trusting-policy"`
.decl b507_trusting_policy(n: node)
b507_trusting_policy(n) :- b507_policy_name(n).
b507_trusting_policy(n) :- kind(n, "call"), field(n, "function", c1), b507_policy_name(c1).
b507_trusting_policy(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    b507_trusting_policy(c2).

// args_plain: a is child i of argument list l and a positional argument (not `k=v`, `*`, `**`, a comment)
.decl b507_args_plain(l: node, a: node, i: number)
b507_args_plain(l, a, i) :- kind(l, "argument_list"), child(l, a, i),
    !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"), !kind(a, "list_splat"),
    !kind(a, "parenthesized_list_splat"), !kind(a, "comment").

// args_splat: child i of argument list l is `*xs`
.decl b507_args_splat(l: node, i: number)
b507_args_splat(l, i) :- kind(l, "argument_list"), child(l, s, i),
    (kind(s, "list_splat") ; kind(s, "parenthesized_list_splat")).

// args_pos: a is the positional argument at position j of argument list l, before any `*xs`
.decl b507_args_pos(l: node, a: node, j: number)
b507_args_pos(l, a, j) :- b507_args_plain(l, a, i), count : { b507_args_splat(l, k), k < i } = 0,
    j = count : { b507_args_plain(l, _, m), m < i }.

// args_star: argument list l has `*xs`, after j positional arguments: positional slots from j on are unknown
.decl b507_args_star(l: node, j: number)
b507_args_star(l, j) :- b507_args_splat(l, i), count : { b507_args_splat(l, k), k < i } = 0,
    j = count : { b507_args_plain(l, _, m), m < i }.

// args_kwp: `k=v` in argument list l
.decl b507_args_kwp(l: node, k: symbol, v: node)
b507_args_kwp(l, k, v) :- kind(l, "argument_list"), child(l, a, _),
    kind(a, "keyword_argument"), field(a, "name", x), text(x, k), field(a, "value", v).

// args_lit_dict: `**{…}` s spreads the dict display d, whose every entry is a pair with a string key: its pairs are keywords
.decl b507_args_lit_dict(s: node, d: node)
b507_args_lit_dict(s, d) :- kind(s, "dictionary_splat"), child(s, d, _),
    kind(d, "dictionary"), count : { child(s, o, _), !kind(o, "comment") } = 1,
    count : { child(d, p, _), !kind(p, "comment"), !b507_args_str_pair(p) } = 0.

// args_str_pair: p is a `"k": v` pair whose key is a string with a constant value
.decl b507_args_str_pair(p: node)
b507_args_str_pair(p) :- kind(p, "pair"), field(p, "key", k),
    (kind(k, "string") ; kind(k, "concatenated_string")), str(k, _),
    field(p, "value", _).

// args_kw: keyword k passed with value v in argument list l, `**{…}` included
.decl b507_args_kw(l: node, k: symbol, v: node)
b507_args_kw(l, k, v) :- b507_args_kwp(l, k, v).
b507_args_kw(l, k, v) :- kind(l, "argument_list"), child(l, s, _), b507_args_lit_dict(s, d),
    child(d, p, _), kind(p, "pair"), field(p, "key", x), str(x, k),
    field(p, "value", v).

// args_kw_spread: argument list l has a `**kw` whose keywords are not known
.decl b507_args_kw_spread(l: node)
b507_args_kw_spread(l) :- kind(l, "argument_list"), child(l, s, _),
    kind(s, "dictionary_splat"), !b507_args_lit_dict(s, _).

// arg_policy_1: call n passes v for slot `policy` of (policy, /), syntactic: Ruff's find_argument
.decl b507_arg_policy_1(n: node, v: node)
b507_arg_policy_1(n, v) :- kind(n, "call"), field(n, "arguments", l), b507_args_pos(l, v, 0).
b507_arg_policy_1(n, v) :- kind(n, "call"), field(n, "arguments", v),
    kind(v, "generator_expression").

// arg_no_policy_1: call n does not pass slot `policy` of (policy, /), syntactic: Ruff's find_argument
.decl b507_arg_no_policy_1(n: node)
b507_arg_no_policy_1(n) :- kind(n, "call"), field(n, "arguments", l), !b507_args_pos(l, _, 0),
    !kind(l, "generator_expression").

// demand_after_alias_to_target: the rows of after_alias_to_target its callers ask for (the metavariable columns they pass in)
.decl b507_demand_after_alias_to_target(n: node, alias: loc)
b507_demand_after_alias_to_target(n, ALIAS) :- kind(n, "identifier"), node(_, n, _, _, _), ALIAS = n.

// demand_alias_to_target: the rows of alias_to_target its callers ask for (the metavariable columns they pass in)
.decl b507_demand_alias_to_target(n: node, alias: loc)
b507_demand_alias_to_target(c3, ALIAS) :- b507_demand_after_alias_to_target(n, ALIAS),
    within(n, p1), precedes(s2, p1), within(c3, s2).

// demand_after_paramiko_import: the nodes after_paramiko_import is asked at (it looks at every ancestor of every node)
.decl b507_demand_after_paramiko_import(n: node)
b507_demand_after_paramiko_import(n) :- kind(n, "call"), b507_arg_policy_1(n, a1), POLICY = a1,
    field(n, "arguments", c2), child(c2, c3, _), b507_trusting_policy(c3),
    field(n, "function", c4), b507_trusting_policy(POLICY).
