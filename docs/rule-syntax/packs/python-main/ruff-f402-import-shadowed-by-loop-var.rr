.policy "ruff-f402-import-shadowed-by-loop-var" revision 1
.guests off
.description "Don't reuse an imported name as a for-loop variable; the loop silently overwrites the import."
.language python
.mode steer
.scope include "**/*"
// Generated from main's JSON rule by the engine's translator (`rerail-engine translate-json`).

#include "python/names.rr"

// F402(n): a finding at node n, from clause `import-shadowed-by-loop-var`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation F402(at: node, name: loc) "Import `{name}` shadowed by loop variable"
    suppress noqa "F402"
F402(n, NAME) :- kind(n, "identifier"), node(_, n, _, _, _), NAME = n, bind_name(n, b1),
    main_form(b1, "for"),
    (st2 = b1, kind(st2, "for_statement") ; inside(b1, st2, "for_statement")),
    binding(sc3, x4, b1, _), binding(sc3, x4, s5, _), main_form(s5, "import"), s5 < b1.
