.policy "ruff-ruf020-never-union" revision 1
.guests off
.description "Remove Never and NoReturn from union types; they have no values, so the union equals its other members."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// never_like(n): the JSON util `never-like`, used where the JSON says `matches: "never-like"`
.decl ruf020_never_like(n: node)
ruf020_never_like(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), ruf020_set_1(q1).

// union_ref(n): the JSON util `union-ref`, used where the JSON says `matches: "union-ref"`
.decl ruf020_union_ref(n: node)
ruf020_union_ref(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    ( sym_of(n, "typing.Union")
    ; sym_of(n, "typing_extensions.Union")
    ; sym_of(n, "_typeshed.Union")
    ).


// pep604_operand(n): the JSON util `pep604-operand`, used where the JSON says `matches: "pep604-operand"`
.decl ruf020_pep604_operand(n: node)
ruf020_pep604_operand(n) :- ruf020_never_like(n), within_stop(n, p1, ruf020_stop_10),
    ( kind(p1, "binary_operator"), ruf020_tok_has_2(p1)
    ; kind(p1, "type"), child(p2, p1, _), kind(p2, "union_type")
    ).


// union_subscript(n): the JSON util `union-subscript`, used where the JSON says `matches: "union-subscript"`
.decl ruf020_union_subscript(n: node)
ruf020_union_subscript(n) :- kind(n, "subscript"), field(n, "value", c1), ruf020_union_ref(c1).

// union_generic(n): the JSON util `union-generic`, used where the JSON says `matches: "union-generic"`
.decl ruf020_union_generic(n: node)
ruf020_union_generic(n) :- kind(n, "generic_type"), child(n, c1, _), ruf020_union_ref(c1).

// union_member(n): the JSON util `union-member`, used where the JSON says `matches: "union-member"`
.decl ruf020_union_member(n: node)
ruf020_union_member(n) :- ruf020_never_like(n), ruf020_alt_13(n).

// pep604_in_string(n): the JSON util `pep604-in-string`, used where the JSON says `matches: "pep604-in-string"`
//   N: metavariable this relation binds for the calling rule
.decl ruf020_pep604_in_string(n: node, n_mv: loc)
ruf020_pep604_in_string(n, N) :- kind(n, "string"),
    count : { has(n, c1, "escape_sequence"), node(_, c1, _, _, _) } = 0,
    parsed(n, "annotation", r2), within(c3, r2), ruf020_alt_23(c3, N).

// union_in_string(n): the JSON util `union-in-string`, used where the JSON says `matches: "union-in-string"`
//   N: metavariable this relation binds for the calling rule
.decl ruf020_union_in_string(n: node, n_mv: loc)
ruf020_union_in_string(n, N) :- kind(n, "string"),
    count : { has(n, c1, "escape_sequence"), node(_, c1, _, _, _) } = 0,
    parsed(n, "annotation", r2), within(c3, r2), ruf020_alt_24(c3, N).

// RUF020(n): a finding at node n, from clause `never-in-pep604-union`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF020(at: node, n: node) "Keep only the other members of this `|` union; `{n}` has no values, so it adds nothing. If that leaves `None | None`, write a single `None`."
    suppress noqa "RUF020"
RUF020(N, n) :- ruf020_pep604_operand(n), node(_, n, _, _, _), N = n.
RUF020(N, n) :- ruf020_pep604_in_string(n, N).

// RUF020_never_in_typing_union(n): a finding at node n, from clause `never-in-typing-union`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation RUF020_never_in_typing_union(at: node, n: node) code "RUF020" "Keep only the other members of this `Union[...]`; `{n}` has no values, so it adds nothing. If one member is left, use it directly without `Union`."
    suppress noqa "RUF020"
RUF020_never_in_typing_union(N, n) :- ruf020_union_member(n), node(_, n, _, _, _), N = n.
RUF020_never_in_typing_union(N, n) :- ruf020_union_in_string(n, N).

