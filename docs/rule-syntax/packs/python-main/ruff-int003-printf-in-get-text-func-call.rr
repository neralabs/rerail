.policy "ruff-int003-printf-in-get-text-func-call" revision 1
.guests off
.description "Pass a constant template to a gettext call and format the translated result; a printf-style formatted string is evaluated before the catalog lookup."
.language python
.mode steer
.scope include "**/*"
// Generated from today's JSON by docs/rule-syntax/site/translate.py. Display only: not compiled or run.

#include "python/names.rr"

// INT003(n): a finding at node n, from clause `printf-in-gettext-call`.
// Each rule below is one way the JSON `rule` can match.
// Columns after `at` are the metavariables the JSON's message, anchor or `each` names: one finding per distinct row.
.violation INT003(at: node, arg: node) "Translate the template, then format the result: `_(\"Hello, %s!\") % name`, not `_(\"Hello, %s!\" % name)`. Leave it if the callee is not a translation function or the text is a computed catalog key."
    suppress noqa "INT003"
INT003(ARG, n) :- int003_target(n), node(_, n, _, _, _), ARG = n.
INT003(ARG, n) :- int003_in_annotation(n, ARG).

// gettext_callee(n): the JSON util `gettext-callee`, used where the JSON says `matches: "gettext-callee"`
.decl int003_gettext_callee(n: node)
int003_gettext_callee(n) :- kind(n, "identifier"), glob("{_,gettext,ngettext}", n).
int003_gettext_callee(n) :- kind(n, "identifier"),
    (global_ref(n, "_") ; global_ref(n, "gettext") ; global_ref(n, "ngettext")).
int003_gettext_callee(n) :- (kind(n, "identifier") ; kind(n, "attribute")),
    sym_of(n, q1), int003_set_1(q1).
int003_gettext_callee(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    int003_gettext_callee(c2).

// first_gettext_arg(n): the JSON util `first-gettext-arg`, used where the JSON says `matches: "first-gettext-arg"`
.decl int003_first_gettext_arg(n: node)
int003_first_gettext_arg(n) :- child(p1, n, _), kind(p1, "argument_list"), child(p2, p1, _),
    kind(p2, "call"), child(p2, c3, _), int003_gettext_callee(c3),
    count : { precedes(s4, n), !int003_alt_2(s4) } = 0.
int003_first_gettext_arg(n) :- child(p5, n, _), kind(p5, "parenthesized_expression"),
    int003_first_gettext_arg(p5).

// plain_string(n): the JSON util `plain-string`, used where the JSON says `matches: "plain-string"`
.decl int003_plain_string(n: node)
int003_plain_string(n) :- kind(n, "string"), !match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", n).
int003_plain_string(n) :- kind(n, "concatenated_string"),
    count : { child(n, c1, _), kind(c1, "string"), match("[A-Za-z]*[fFbBtT][A-Za-z]*['\"].*", c1) } = 0.
int003_plain_string(n) :- kind(n, "parenthesized_expression"), child(n, c2, _),
    int003_plain_string(c2).

// target(n): the JSON util `target`, used where the JSON says `matches: "target"`
.decl int003_target(n: node)
int003_target(n) :- kind(n, "binary_operator"), int003_first_gettext_arg(n), child(n, c1, _),
    int003_plain_string(c1), int003_tok_precedes_1(c1).

// in_annotation(n): the JSON util `in-annotation`, used where the JSON says `matches: "in-annotation"`
//   ARG: metavariable this relation binds for the calling rule
.decl int003_in_annotation(n: node, arg: loc)
int003_in_annotation(n, ARG) :- (kind(n, "string") ; kind(n, "concatenated_string")),
    parsed(n, "annotation", r1), within(c2, r1), int003_alt_3(c2, ARG).

// tok_precedes_1(n): a later sibling of n, a named node or an anonymous token, matches "^%$": a named node, a token the tape stores, or one it leaves out, read from the source between stored children
.decl int003_tok_precedes_1(n: node)
.stored int003_tok_precedes_1 "its token reads are of tokens the tape stores; one the tape leaves out is read from the source gap, in its own rule"
int003_tok_precedes_1(n) :- precedes(n, s2), glob("%", s2).
int003_tok_precedes_1(n) :- child(p5, n, _), node(_, n, _, _, en8), token(p5, _, t3, st7, _),
    st7 >= en8, match("%", t3).
int003_tok_precedes_1(n) :- structural_after(n, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:%)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).
int003_tok_precedes_1(n) :- precedes(n, o6), structural_after(o6, g4),
    match("(?s)^(?:(?:.*[^\\-+*/%@\\&|\\^<>=!:.\\~])?(?:%)(?:[^\\-+*/%@\\&|\\^<>=!:.\\~].*)?)$", g4).

// set_1: symbols from the JSON `resolves.import`
.decl int003_set_1(v: symbol)
int003_set_1("gettext.gettext"). int003_set_1("gettext.ngettext"). int003_set_1("builtins._").
int003_set_1("builtins.gettext"). int003_set_1("builtins.ngettext").

// alt_2(n): the JSON `any`: n matches if any one of these rules does
.decl int003_alt_2(n: node)
int003_alt_2(n) :-
    ( kind(n, "comment")
    ; kind(n, "line_continuation")
    ; kind(n, "keyword_argument")
    ; kind(n, "dictionary_splat")
    ).

int003_alt_2(n) :- node(_, n, _, _, _), glob("[(,]", n).

// alt_3(n): the JSON `any`: n matches if any one of these rules does
//   ARG: metavariable this relation binds for the calling rule
.decl int003_alt_3(n: node, arg: loc)
int003_alt_3(n, ARG) :- int003_target(n), ARG = n.
int003_alt_3(n, ARG) :- int003_in_annotation(n, ARG).
