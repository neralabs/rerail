.policy "next-no-page-custom-font" revision 2
.description "Add Google Fonts stylesheet links only inside the default-exported custom Document in pages/_document; fonts linked elsewhere load for one page and skip font optimization."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
// eslint-plugin-next's no-page-custom-font. A <link> to a Google Fonts stylesheet is allowed only in the custom
// Document (the file name after its last "pages" starts with /_document), inside its default-exported component:
//   pages/index.js:      <link href="https://fonts.googleapis.com/css2?family=Inter" />   one page only
//   pages/_document.js:  class MyDocument extends Document { render() { … <link …/> … } }
//                        export default MyDocument                                     fine
//   pages/_document.js:  a link in some other component of the file                    outside <Head>
// The plugin walks the file once, in source order, and decides at each link from what it has seen before it:
//   - once the default export's statement starts before the link, its ESTree type: `export default class …`
//     (a ClassDeclaration, abstract or anonymous too) allows a link in any class *declaration* extending
//     next/document's default import; `export default function F` allows a link in a function declaration named F
//     (an anonymous one: in itself, unless the token scan below finds a name);
//   - otherwise (no default export before the link, or one of another type) the name of its token scan: the
//     first identifier token right after `export default` in the file (`export default MyDocument`, `export default
//     withX(Doc)`; `async` and `abstract` are identifier tokens, `class` and `function` keywords, which give none).
//     A link inside anything that declares that name (a function, class or variable) is allowed:
//       pages/_document.js:  class Helper extends Document { … <link …/> … }
//                            export default class MyDocument extends Document { … }      outside <Head>
// Only the link's last href counts, as NodeAttributes keeps one per name: <link href="…fonts…" href="/a.css"/> is
// not reported.

#include "tsx/next.rerail"

.violation font(at: node, why: symbol) code "@next/next/no-page-custom-font"
    "{why} This is discouraged. See: https://nextjs.org/docs/messages/no-page-custom-font"
    suppress eslint "@next/next/no-page-custom-font"
    suppress oxlint "no-page-custom-font"
font(o, "Custom fonts not added in `pages/_document.js` will only load for a single page.") :- font_link(o, d),
    !doc_file(d).
font(o, "Using `<link />` outside of `<Head>` will disable automatic font optimization.") :- font_link(o, d),
    doc_file(d), !allowed(o).

// font_link(o, d): a Google Fonts link in d, by its last href. A file name ending in "pages" is skipped altogether.
.decl font_link(o: node, d: number)
font_link(o, d) :- tag_of(o, "link"), last_href(o, a), href_str(a, h), prefix("https://fonts.googleapis.com/css", h),
    docof(o, d), pages_last(d, r), r != "".
.decl doc_file(d: number)
doc_file(d) :- pages_last(d, r), prefix("/_document", r).
.decl last_href(o: node, a: node)
last_href(o, a) :- attr(o, "href", a), !later_href(a).
.decl later_href(a: node)  // another href of the same tag follows a
later_href(a) :- attr(o, "href", a), attr(o, "href", b), node(_, a, _, s, _), node(_, b, _, t, _), s < t.
.decl href_str(a: node, v: symbol)  // attribute a is href="v" or href={"v"} (NodeAttributes' value())
href_str(a, v) :- last_href(_, a), child(a, l, 1), kind(l, "string"), str(l, v).
href_str(a, v) :- last_href(_, a), child(a, c, 1), kind(c, "jsx_expression"), child(c, l, 0), kind(l, "string"),
    str(l, v).

// allowed(o): link o of a Document file sits in what the plugin takes for the default-exported component.
.decl allowed(o: node)
// export default class … (seen): a class declaration around the link extending the Document import.
allowed(o) :- seen(o, v), class_decl(v), within(o, c), class_decl(c), superclass(c, x), docof(o, d),
    default_import(d, "next/document", x).
// export default function F (seen): a function declaration named F around it.
allowed(o) :- seen(o, v), function_decl(v), field(v, "name", n), text(n, x), within(o, f), function_decl(f),
    field(f, "name", m), text(m, x).
// export default function () (seen): the id is null, so the token scan runs; its name, else the null id matches.
allowed(o) :- seen(o, v), function_decl(v), !field(v, "name", _), docof(o, d), scan_name(d, x), within(o, f),
    function_decl(f), field(f, "name", m), text(m, x).
allowed(o) :- seen(o, v), function_decl(v), !field(v, "name", _), docof(o, d), !scan_name(d, _), within(o, f),
    function_decl(f), !field(f, "name", _).
// No class or function default export seen yet: the token scan's name.
allowed(o) :- font_link(o, d), doc_file(d), !seen_decl(o), scan_name(d, x), within(o, c), named_decl(c, x).

.decl default_export(d: number, e: node, v: node)  // statement e is `export default v`
default_export(d, e, v) :- kind(e, "export_statement"), op(e, "default"),
    (field(e, "declaration", v) ; field(e, "value", v)), docof(e, d).
// seen(o, v): the plugin has visited `export default v` when it reaches link o: the statement starts first.
.decl seen(o: node, v: node)
seen(o, v) :- font_link(o, d), doc_file(d), default_export(d, e, v), node(_, e, _, s, _), node(_, o, _, t, _), s < t.
.decl seen_decl(o: node)
seen_decl(o) :- seen(o, v), class_decl(v).
seen_decl(o) :- seen(o, v), function_decl(v).
// ESTree's ClassDeclaration and FunctionDeclaration; a class or function expression is neither, except as the
// default export itself (`export default class extends Document {…}`, `export default function () {…}`).
.decl class_decl(c: node)
class_decl(c) :- kind(c, "class_declaration").
class_decl(c) :- kind(c, "abstract_class_declaration").
class_decl(c) :- default_export(_, _, c), kind(c, "class").
.decl function_decl(f: node)
function_decl(f) :- kind(f, "function_declaration").
function_decl(f) :- kind(f, "generator_function_declaration").
function_decl(f) :- default_export(_, _, f), (kind(f, "function_expression") ; kind(f, "generator_function")).

// scan_name(d, x): the plugin's token scan, `export default` followed by an Identifier token x.
.decl scan_name(d: number, x: symbol)
scan_name(d, x) :- default_export(d, e, _), text(e, t),
    match("(?s).*?\\bexport\\s+default\\s+(?<x>[A-Za-z_$][A-Za-z0-9_$]*)(?:[^A-Za-z0-9_$].*)?", t), !keyword(x).
.decl keyword(x: symbol)  // the words after `export default` that tokenize as Keyword, Null or Boolean
keyword("class"). keyword("function"). keyword("new"). keyword("this"). keyword("typeof"). keyword("void").
keyword("delete"). keyword("null"). keyword("true"). keyword("false"). keyword("super"). keyword("import").
keyword("interface"). keyword("enum").
.decl named_decl(c: node, x: symbol)  // the ESTree nodes with an id named x: functions, classes, declarators
named_decl(c, x) :- kind(c, k), (k = "function_declaration" ; k = "function_expression" ; k = "class_declaration" ;
    k = "abstract_class_declaration" ; k = "class" ; k = "variable_declarator" ;
    k = "generator_function_declaration" ; k = "generator_function"), field(c, "name", n), text(n, x).
