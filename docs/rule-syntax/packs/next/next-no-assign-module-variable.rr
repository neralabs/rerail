.policy "next-no-assign-module-variable" revision 3
.description "Don't declare a variable named module in Next.js code; it shadows the module object Node.js and the bundler rely on."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
// eslint-plugin-next's no-assign-module-variable. A var, let or const declaring the plain name `module`,
// reported at the declaration:
//   let module = {}          reported
//   for (let module of xs)   reported at let: a for-in/of head declares too
//   const { module } = x     fine: a pattern, not a name
//   for (module of xs)       fine: no declaration

.violation module_var(at: loc) code "@next/next/no-assign-module-variable"
    "Do not assign to the variable `module`. See: https://nextjs.org/docs/messages/no-assign-module-variable"
    suppress eslint "@next/next/no-assign-module-variable"
    suppress oxlint "no-assign-module-variable"
module_var(d) :- (kind(d, "lexical_declaration") ; kind(d, "variable_declaration")), child(d, v, _),
    kind(v, "variable_declarator"), field(v, "name", n), kind(n, "identifier"), text(n, "module").
module_var(t) :- kind(f, "for_in_statement"), field(f, "left", n), kind(n, "identifier"), text(n, "module"),
    match("(?s)for\\s*(await\\s*)?\\(\\s*(?<t>let|const|var)\\b.*", f).
