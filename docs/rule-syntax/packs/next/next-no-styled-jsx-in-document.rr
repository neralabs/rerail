.policy "next-no-styled-jsx-in-document" revision 3
.description "Don't use styled-jsx style tags in pages/_document; the custom Document does not support them."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
// eslint-plugin-next's no-styled-jsx-in-document. A <style jsx> in the custom Document (pages/_document…):
//   pages/_document.js:  <style jsx>{`body { margin: 0 }`}</style>    reported
//   pages/index.js:      the same                                     fine

#include "tsx/next.rr"

.violation styled_jsx(at: node) code "@next/next/no-styled-jsx-in-document"
    "`styled-jsx` should not be used in `pages/_document.js`. See: https://nextjs.org/docs/messages/no-styled-jsx-in-document"
    suppress eslint "@next/next/no-styled-jsx-in-document"
    suppress oxlint "no-styled-jsx-in-document"
styled_jsx(o) :- tag_of(o, "style"), attr(o, "jsx", _), docof(o, d), document_file(d).
