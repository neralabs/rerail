// tsx/eslint-a-text: comments and source text, as ESLint's comment rules read them. For capitalized-comments,
// no-inline-comments and no-irregular-whitespace.
//
// What a rule gets from this library:
//   js_comment(c, t, v)      c is a comment of type t, "Line" (`// v`) or "Block" (`/* v */`), with value v
//   end_col(n, c)            c is the column just past n's last character, on n's end line
//   code_before(c)           code precedes comment c on its first line (other comments count as code)
//   code_after(c)            code follows comment c on its last line
//   tool_comment(c)          c is a comment for a tool: eslint…, jshint, jslint, istanbul, global(s),
//                            exported, jscs (ESLint's COMMENTS_IGNORE_PATTERN)
//   eslint_directive(c)      c is an ESLint directive: `// eslint-…`, `/* eslint … */`, `/* global … */`,
//                            `/* exported … */` (astUtils.isDirectiveComment)
//   token_neighbours(c)      a token or comment ends on c's first line before it, and one starts on its last
//                            line after it (capitalized-comments' isInlineComment)
//   follows_comment(c)       the token before c, comments included, is a comment (isConsecutiveComment)
//
// Values. ESLint's comment.value is the text between the markers, unchanged; core's comment(c, v) is the same text,
// perhaps trimmed. Every test below allows leading and trailing whitespace, so either reading gives the same answer.
// Positions are bytes, as col and end_line give them, so columns compare across nodes and lines.
//
// Builds on core: comment, text, line, end_line, col, src_line, token_before, token_after, visit_index.

.decl js_comment(c: node, t: symbol, v: symbol)
js_comment(c, "Line", v) :- kind(c, "comment"), comment(c, v), prefix("//", c).
js_comment(c, "Block", v) :- kind(c, "comment"), comment(c, v), prefix("/*", c).

// end_col(n, c): `/* a */` at column 4 ends at column 11. A node over several lines ends where its last line of
// text does. A text that ends in a line break (a template's raw text can) ends just past that break.
.decl end_col(n: loc, c: number)
end_col(n, x + strlen(s)) :- text(n, s), !contains("\n", s), col(n, x).
end_col(n, strlen(@replace_all(s, "^[\\s\\S]*\\n", ""))) :- text(n, s), contains("\n", s), !suffix("\n", s).
end_col(n, x + strlen(s)) :- text(n, s), suffix("\n", s), !contains("\n", substr(s, 0, strlen(s) - 1)), col(n, x).
end_col(n, 1 + strlen(@replace_all(u, "^[\\s\\S]*\\n", ""))) :- text(n, s), suffix("\n", s),
    u = substr(s, 0, strlen(s) - 1), contains("\n", u).

// code_before(c): `f(); // why` and `/* a */ /* b */`: something other than whitespace is on c's line before
// it. code_after(c): the same after it on its last line. no-inline-comments reads the line text, as ESLint does.
.decl code_before(c: node)
code_before(c) :- kind(c, "comment"), docof(c, d), line(c, l), src_line(d, l, sp), text(sp, s), col(c, x),
    match("[\\s\\S]*\\S[\\s\\S]*", substr(s, 0, x)).
.decl code_after(c: node)
code_after(c) :- kind(c, "comment"), docof(c, d), end_line(c, l), src_line(d, l, sp), text(sp, s), end_col(c, x),
    strlen(s) > x, match("[\\s\\S]*\\S[\\s\\S]*", substr(s, x, strlen(s) - x)).
// pre_text(c, s), post_text(c, s): that text, trimmed, for the `{ /* c */ }` test of no-inline-comments.
.decl pre_text(c: node, s: symbol)
pre_text(c, @replace_all(substr(s, 0, x), "^\\s+|\\s+$", "")) :- code_before(c), docof(c, d), line(c, l),
    src_line(d, l, sp), text(sp, s), col(c, x).
.decl post_text(c: node, s: symbol)
post_text(c, @replace_all(substr(s, x, strlen(s) - x), "^\\s+|\\s+$", "")) :- code_after(c), docof(c, d),
    end_line(c, l), src_line(d, l, sp), text(sp, s), end_col(c, x).

// tool_comment(c): `// eslint-disable-line`, `/* global $ */`, `// istanbul ignore next` are not prose.
.decl tool_comment(c: node)
tool_comment(c) :- js_comment(c, _, v),
    match("\\s*(?:eslint|jshint\\s+|jslint\\s+|istanbul\\s+|globals?\\s+|exported\\s+|jscs)[\\s\\S]*", v).
// eslint_directive(c): `// eslint-disable-next-line no-alert`, `/* eslint semi: 2 */`, `/* globals a */`.
// A line comment must start `eslint-`; a block comment `eslint-` or `eslint `, `global `, `globals `, `exported `.
.decl eslint_directive(c: node)
eslint_directive(c) :- js_comment(c, "Line", v), match("\\s*eslint-[\\s\\S]*", v).
eslint_directive(c) :- js_comment(c, "Block", v), match("\\s*(?:eslint[- ]|(?:globals?|exported) )[\\s\\S]*", v).

// token_neighbours(c): `f(/* a */ b)`: a token (or comment) ends on c's first line before c, and another starts on
// c's last line after it. ESLint asks the token store with includeComments; comments next to c are siblings.
.decl token_neighbours(c: node)
token_neighbours(c) :- kind(c, "comment"), near_before(c), near_after(c).
.decl near_before(c: node)
near_before(c) :- kind(c, "comment"), token_before(c, t), end_line(t, l), line(c, l), !comment_between_before(c, t).
near_before(c) :- kind(c, "comment"), prev_comment(c, p), end_line(p, l), line(c, l).
.decl near_after(c: node)
near_after(c) :- kind(c, "comment"), token_after(c, t), line(t, l), end_line(c, l), !comment_between_after(c, t).
near_after(c) :- kind(c, "comment"), next_comment(c, n), line(n, l), end_line(c, l).
// prev_comment(c, p): p is the comment right before c, with no token between them: of the comments that share
// c's next token (or, at the end of the file, share having none), the latest before c by visit order.
//   a; /* p */ /* c */ b;      a /* p */ ; /* c */ b   (here `;` is between, so p is not c's previous)
// One max per comment over its gap: linear in a run of consecutive comments per comment, never cubic.
.decl prev_comment(c: node, p: node)
prev_comment(c, p) :- kind(c, "comment"), token_after(c, t), visit_index(c, vc),
    i = max v : { kind(q, "comment"), token_after(q, t), visit_index(q, v), v < vc },
    kind(p, "comment"), token_after(p, t), visit_index(p, i).
prev_comment(c, p) :- kind(c, "comment"), !token_after(c, _), docof(c, d), visit_index(c, vc),
    i = max v : { kind(q, "comment"), !token_after(q, _), docof(q, d), visit_index(q, v), v < vc },
    kind(p, "comment"), !token_after(p, _), docof(p, d), visit_index(p, i).
.decl next_comment(c: node, n: node)
next_comment(c, n) :- prev_comment(n, c).
.decl comment_between_before(c: node, t: span)  // a comment lies between token t and comment c
comment_between_before(c, t) :- token_before(c, t), prev_comment(c, _).
.decl comment_between_after(c: node, t: span)
comment_between_after(c, t) :- token_after(c, t), next_comment(c, _).

// follows_comment(c): `// a` then `// b` on the next line: b follows a comment.
.decl follows_comment(c: node)
follows_comment(c) :- prev_comment(c, _).
