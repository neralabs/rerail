// vue/vue-01: vue/component.rerail over the component's view, the one program the engine on main gives a .vue file.
//
// vue/component reads each <script> through `parsed(raw, g, p)`, a guest per block, as rrlab gave them. The engine
// on main makes a guest only where a rule names its grammar (`embed`, or `parsed` with a literal grammar), and a
// block's own guest keeps no tape, so `value` has no row over it. The view (vue/view.rerail, decision 0222) is the
// guest the engine builds for a component: its scripts in source order, then its template's code, one program in the
// scripts' `lang` (TypeScript for `lang="ts"`, else JavaScript), its nodes placed at the file's bytes, its tape kept.
// vue-eslint-parser reads the scripts as one program too, so names resolve across <script> and <script setup> as
// ESLint's do.
//
// The engine names a guest node's kinds in its grammar only where a rule reached it from a guest relation that names
// the grammar (decision 0058 §2, decision 0222 §7); unnamed, `kind(e, "export_statement")` is Vue's kind and holds of
// no view node. So a rule seeds the relation its search starts from with vjs(n) or vts(n), one clause per grammar (a
// disjunction `(vjs(n) ; vts(n))` names neither): the engine copies that relation, and every relation it reads, for
// the grammar's kinds.
//
// `value` is answered on request (decision 0174), and the requests are made from the readers' host literals: no view
// node is asked for, and a copied relation one of whose rules reads `value` of its seeded node has no row at all,
// from any rule (`k(n, x) :- kind(n, "property_identifier"), text(n, x). k(n, x) :- kind(n, "string"), value(n, x).`
// read as vjs(n), k(n, _) gives nothing; with RERAIL_NODE_SOURCES=eager it gives both). vvalued reads `value` of no
// node in particular, which keeps `value` an input made for every node (rr::lower's sources_on_request), the view's
// too; vjs and vts read it so that every rule here reaches it.
//
// This file adds clauses to vue/component's script relations (vin_setup, vin_script, vsetup_doc, vcomp's
// `export default`, vmacro_site), which read the blocks' own guests: over the view they have no rows.
//
// Interface:
//   vjs(n), vts(n)      n is a node of a JavaScript (TypeScript) view
//   vblock(n, se)       view node n is code of script element se: its host node is se's text
//   vtop(e, setup)      e is a top-level statement of a <script> block ("false") or of <script setup> ("true")
//   vview_root(p)       p is a view's program: the module scope vue-eslint-parser gives the scripts
//
// `earlier` has no row over the view (no visit order under run-policies): a rule orders nodes by line and column.
//
//   <script>export default { computed: { a() { return 1 } } }</script>
//     vtop(<export default …>, "false"); vcomp(<{ computed: … }>); a rule's getter(f) :- vcomputed(_, _, f), vjs(f).
#include "vue/view.rerail"
#include "vue/component.rerail"

.decl vjs(n: node)
vjs(n) :- guest(d, _, _, "javascript"), doc_role(d, "program"), docof(n, d), !vvalued("vue-01: no value").
.decl vts(n: node)
vts(n) :- guest(d, _, _, "typescript"), doc_role(d, "program"), docof(n, d), !vvalued("vue-01: no value").
.decl vvalued(x: symbol)
vvalued(x) :- value(_, x), x = "vue-01: no value".
.decl vview_root(p: node)
vview_root(p) :- doc_role(d, "program"), doc_root(d, p).

.decl vblock(n: node, se: node)
vblock(n, se) :- host_node(n, h), kind(h, "raw_text"), child(se, h, _), kind(se, "script_element").
.decl vtop(e: node, setup: symbol)
vtop(e, s) :- vview_root(p), child(p, e, _), vblock(e, se), child(se, t, 0), (vscript_setup(t), s = "true" ;
    !vscript_setup(t), s = "false").

// vue/component's script relations, over the view.
vin_script(n) :- vblock(n, _).
vin_setup(n) :- vblock(n, se), child(se, t, 0), vscript_setup(t).
vsetup_doc(d) :- doc_role(d, "program"), guest(d, h, _, _), kind(se, "script_element"), docof(se, h),
    child(se, t, 0), vscript_setup(t).
vcomp(o) :- vtop(e, "false"), kind(e, "export_statement"), field(e, "value", w), deparen(w, o), kind(o, "object").
vmacro_site(c) :- vtop(st, "true"), (kind(st, "lexical_declaration") ; kind(st, "variable_declaration")),
    child(st, d, _), kind(d, "variable_declarator"), field(d, "value", w), deparen(w, c).
vmacro_site(c) :- vtop(st, "true"), kind(st, "expression_statement"), child(st, w, 0), deparen(w, c).

// A copied relation names its kinds only of the nodes a base atom ties to its seeded column. vue/component's
// vopt_fn(h, v, v) :- kind(h, "pair"), function_node(v) ties h to nothing, so a copy seeded at v (vgroup_value's
// `return {…}` and arrow clauses, read from the returned object) reads `kind(h, "pair")` as Vue's kind and has no
// row. The same clause with h's value tied to v:
vopt_fn(h, v, v) :- kind(h, "pair"), field(h, "value", w), vunwrap(w, v), function_node(v).
// vlater_setter orders by `earlier`, which has no row over the view: the same order by line and column.
vlater_setter(c, p, x) :- vaccessor(c, p, x, "set"), vaccessor(c, q, x, "set"), line(q, lq), line(p, lp),
    (lq < lp ; lq = lp, col(q, cq), col(p, cp), cq < cp).

// A kind read into a variable and compared inside a disjunction, `kind(p, k), (k = "a" ; k = "b")`, is not named in
// the guest's grammar (the comparisons are; a disjunction of them is not), so it holds of no view node. tsx/names'
// destructured names are such: `const { a } = toRefs(p)` and `let [m] = defineModel()` declared nothing. The same
// clauses with the kinds as atoms:
pattern_name(p, x, d) :- kind(d, "variable_declarator"), field(d, "name", pat), (kind(pat, "object_pattern") ;
    kind(pat, "array_pattern")), within(p, pat), bound_name(p, x), nearest(p, f, fn_scope), nearest(d, f, fn_scope).
bound_name(p, x) :- (kind(p, "shorthand_property_identifier_pattern") ; kind(p, "identifier")), text(p, x),
    child(par, p, _), kind(par, k), binding_parent(k), !field(par, "key", p), !field(par, "right", p).
