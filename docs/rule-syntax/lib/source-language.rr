// Source language selection for both inventory and document loading.
.decl source_language_request(path: symbol) extensible
.decl git_inventory_host_registry(version: symbol)
.decl git_inventory_host_suffix(version: symbol, suffix: symbol, language: symbol)
.decl git_inventory_host_name(version: symbol, name: symbol, language: symbol)
.input git_inventory_host_registry, git_inventory_host_suffix, git_inventory_host_name

.decl sl_basename(path: symbol, name: symbol)
sl_basename(p, @ascii_lower(@replace_all(p, "(?s)^.*/", ""))) :- source_language_request(p).

.decl sl_named(path: symbol, name: symbol, grammar: symbol)
sl_named(p, name, g) :- sl_basename(p, name), git_inventory_host_name(_, name, g).

.decl sl_suffix(suffix: symbol, grammar: symbol, order: number, built: number)
sl_suffix(ext, g, order, built) :- !git_inventory_host_registry(_), source_grammar_suffix(g, ext, order, built).
sl_suffix(ext, g, 0, 1) :- git_inventory_host_suffix(_, ext, g).

.decl sl_candidate(path: symbol, suffix: symbol, length: number, order: number, grammar: symbol, built: number)
sl_candidate(p, ext, strlen(ext), order, g, built) :-
    sl_basename(p, name), sl_suffix(ext, g, order, built), !sl_named(p, _, _),
    suffix(ext, name), strlen(ext) < strlen(name).

// Describe the candidates before selecting one. Generate the same key wherever
// the same set of registry entries applies.
.decl sl_evidence(path: symbol, entry: symbol)
sl_evidence(p, cat("name ", @json_str(name), " ", @json_str(g))) :- sl_named(p, name, g).
sl_evidence(p, cat("suffix ", @json_str(ext), " ", @json_str(g), " ", to_string(i), " ", to_string(built))) :-
    sl_candidate(p, ext, _, i, g, built).

.decl source_language_key(path: symbol, inputs: symbol, algorithm: symbol)
source_language_key(p, @sha256(entries), "basename-v4") :-
    source_language_request(p), entries = join e by e sep "\n" : { sl_evidence(p, e) }.

.decl source_language_classification_key(inputs: symbol, algorithm: symbol)
source_language_classification_key(k, "basename-v4") :- source_language_key(_, k, "basename-v4").

.decl sl_names_for_key(inputs: symbol, grammar: symbol)
sl_names_for_key(k, g) :- source_language_key(p, k, _), sl_named(p, _, g).

.decl sl_suffixes_for_key(inputs: symbol, length: number, order: number, grammar: symbol, built: number)
sl_suffixes_for_key(k, n, i, g, built) :- source_language_key(p, k, _), sl_candidate(p, _, n, i, g, built).

.decl sl_longest(inputs: symbol, length: number)
sl_longest(k, n) :-
    sl_suffixes_for_key(k, _, _, _, _), n = max len : { sl_suffixes_for_key(k, len, _, _, _) }.

.decl source_language_classification(inputs: symbol, grammar: symbol)
source_language_classification(k, g) :- source_language_classification_key(k, _), sl_names_for_key(k, g).
source_language_classification(k, g) :-
    source_language_classification_key(k, _), sl_longest(k, n),
    i = max j : { sl_suffixes_for_key(k, n, j, _, _) },
    sl_suffixes_for_key(k, n, i, g, 1).
.cache source_language_classification by source_language_classification_key

.decl source_language_result(path: symbol, inputs: symbol, grammar: symbol)
source_language_result(p, k, g) :- source_language_key(p, k, _), source_language_classification(k, g).

.decl source_language(path: symbol, grammar: symbol)
source_language(p, g) :- source_language_result(p, _, g).
