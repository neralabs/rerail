// C's and C++'s configurations as facts (decision 0327, "Configuration is facts").
//
// A configuration is a name (`cfg`) and its rows: a language and standard, the predefined macros
// and `-D`/`-U` in order, the search path in order, the answers of the `__has_*` tests and the
// fixed `__DATE__`/`__TIME__`. Every row is a rule's, so a rule can add to a configuration, or make
// another (a unit preprocessed under two configurations is two requests). `c_tu(tu, cfg)` names
// a translation unit's configuration; mode (b) preprocesses each (`c/preprocess.rr`).
//
// The rows come from wherever rules read them: the run's settings (`env`), a compiler profile read
// with `file_line`, a `compile_commands.json` (`c/compile-commands.rr`). Each is `extensible`.

// `lang`: `c`, `c++`, `objective-c`, `objective-c++`; `std` as a driver spells it (`c17`, `gnu17`,
// `c++20`, `gnu++2c`).
.decl c_lang(cfg: symbol, lang: symbol, std: symbol) extensible
// `-D` and `-U` (and the compiler's own macros), in `order`, which the two share: a later one wins.
// `name` may carry its parameters (`SQ(x)`).
.decl c_predefine(cfg: symbol, order: number, name: symbol, body: symbol) extensible
.decl c_config_undef(cfg: symbol, order: number, name: symbol) extensible
// The search path, in `order` within its kind: `quote` (`-iquote`), `angle` (`-I`), `system`
// (`-isystem` and the compiler's own), `framework`, `after` (`-idirafter`), searched in that order.
.decl c_include_dir(cfg: symbol, order: number, dir: symbol, kind: symbol) extensible
// What a test answers: `c_feature(cfg, "__has_builtin", "__builtin_expect", 1)`. A test not here
// is 0 (`__is_identifier`: 1).
.decl c_feature(cfg: symbol, test: symbol, name: symbol, value: number) extensible
// `__DATE__`, `__TIME__`, `__TIMESTAMP__`: fixed, so that a run is deterministic (else the Unix
// epoch's).
.decl c_fixed(cfg: symbol, name: symbol, value: symbol) extensible
// A translation unit and the configuration it is preprocessed under.
.decl c_tu(tu: symbol, cfg: symbol) extensible

// The configuration as one text (`spec`), the key of mode (b)'s request: an item a row, in order,
// each a tag and its fields, every field `n:text` (`n` its length in characters). The preprocessor
// reads it back (`language::adapter::c_pp::read_spec`). A changed row is another spec, so another
// request.
.decl c_cfg_item(cfg: symbol, band: number, order: number, item: symbol)
c_cfg_item(c, 0, 0, x) :- c_lang(c, l, s),
    x = cat("L", to_string(strlen(l)), ":", l, to_string(strlen(s)), ":", s).
c_cfg_item(c, 1, o, x) :- c_predefine(c, o, n, b),
    x = cat("D", to_string(strlen(n)), ":", n, to_string(strlen(b)), ":", b).
c_cfg_item(c, 1, o, x) :- c_config_undef(c, o, n), x = cat("U", to_string(strlen(n)), ":", n).
c_cfg_item(c, 2, o, x) :- c_include_dir(c, o, d, k),
    x = cat("I", to_string(strlen(k)), ":", k, to_string(strlen(d)), ":", d).
c_cfg_item(c, 3, 0, x) :- c_feature(c, t, n, v), w = to_string(v),
    x = cat("F", to_string(strlen(t)), ":", t, to_string(strlen(n)), ":", n, to_string(strlen(w)), ":", w).
c_cfg_item(c, 4, 0, x) :- c_fixed(c, n, v),
    x = cat("X", to_string(strlen(n)), ":", n, to_string(strlen(v)), ":", v).
.decl c_cfg_spec(cfg: symbol, spec: symbol)
c_cfg_spec(c, s) :- c_lang(c, _, _), s = join x by (b, o) sep "" : { c_cfg_item(c, b, o, x) }.
