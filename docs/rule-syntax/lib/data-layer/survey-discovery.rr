// Pinned SymbolGraph discovery. World requests contain only path selection;
// ordinal assignment happens after discovery, outside the load request cone.
#include "data-layer/survey-scope.rr"

.decl sgd_enabled()
.decl sgd_workspace(path: symbol)
sgd_workspace(".") :- sgd_enabled().
.decl sgd_top(name: symbol)
sgd_top(name) :- sgd_workspace(path), dir_entry(path, name, 1).
.decl sgd_layer(name: symbol)
sgd_layer(name) :- sgd_top(name), match("l[0-9]{4}_.+(?s:.*)", name).
.decl sgd_modern()
sgd_modern() :- sgd_top("data_layer").
sgd_modern() :- sgd_top("_internal").
sgd_modern() :- sgd_layer(_).
.decl sgd_public_path(path: symbol)
sgd_public_path("impl") :- sgd_top("impl").
sgd_public_path("data_layer") :- sgd_top("data_layer").
sgd_public_path("_internal") :- sgd_top("_internal").
sgd_public_path(path) :- sgd_layer(path).
sgd_public_path("api") :- sgd_top("api"), !sgd_modern().
.decl sgd_default(i: number, path: symbol)
sgd_default(0, "impl") :- sgd_modern(), sgd_top("impl").
sgd_default(1, "data_layer") :- sgd_modern(), sgd_top("data_layer").
sgd_default(2, "_internal") :- sgd_modern(), sgd_top("_internal").
sgd_default(i+3, path) :- sgd_layer(path), i = count : { sgd_layer(other), @str_cmp(other, path) < 0 }.
sgd_default(0, "api") :- !sgd_modern(), sgd_top("api").
sgd_default(1, "impl") :- !sgd_modern(), sgd_top("impl").

.decl sgd_argument(i: number, path: symbol)
.decl sgd_configured()
sgd_configured() :- env(key, _), match_all("\\Adata-layer\\.scan\\.[0-9]+\\z", key).
sgd_argument(to_number(index), path) :- sgd_enabled(), env(key, path), match_all("\\Adata-layer\\.scan\\.(?<index>[0-9]+)\\z", key).
sgd_argument(0, "public") :- sgd_enabled(), !sgd_configured().
// Membership is separate from ordered arguments. Callers can compute argument
// ranks after discovery without placing aggregates in the loading request cone.
.decl sgd_membership(path: symbol)
sgd_membership(path) :- sgd_enabled(), env(key, path), match_all("\\Adata-layer\\.scan\\.[0-9]+\\z", key).
sgd_membership("public") :- sgd_enabled(), !sgd_configured().
.decl sgd_requested_path(path: symbol)
sgd_requested_path(path) :- sgd_membership(path), path != "public".
sgd_requested_path(path) :- sgd_membership("public"), sgd_public_path(path).
.decl sgd_walk_root(path: symbol)
sgd_walk_root(@replace_all(@replace_all(@replace_all(@replace_all(@replace_all(raw, "/+", "/"), "\\A(?:\\./)+", ""), "/(?:\\./)+", "/"), "/\\.\\z", ""), "/+\\z", "")) :- sgd_requested_path(raw).
.decl sgd_has_public()
sgd_has_public() :- sgd_argument(_, "public").
.decl sgd_expanded(i: number, j: number, path: symbol)
sgd_expanded(i, 0, path) :- sgd_argument(i, path), path != "public".
sgd_expanded(i, j, path) :- sgd_argument(i, "public"), sgd_default(j, path).
.decl sgd_earlier_path(i: number, j: number, path: symbol)
sgd_earlier_path(i, j, path) :- sgd_expanded(i, j, path), sgd_expanded(a, b, path), (a < i ; (a = i, b < j)).
.decl sgd_chosen(i: number, j: number, path: symbol)
sgd_chosen(i, j, path) :- sgd_expanded(i, j, path), (!sgd_has_public() ; !sgd_earlier_path(i, j, path)).
.decl sgd_root(i: number, path: symbol)
sgd_root(i, @replace_all(@replace_all(@replace_all(@replace_all(@replace_all(raw, "/+", "/"), "\\A(?:\\./)+", ""), "/(?:\\./)+", "/"), "/\\.\\z", ""), "/+\\z", "")) :- sgd_chosen(a, b, raw), i = count : { sgd_chosen(c, d, _), (c < a ; (c = a, d < b)) }.

.decl sgd_probe(path: symbol, parent: symbol, name: symbol)
sgd_probe(path, ".", path) :- sgd_walk_root(path), path != ".", !contains("/", path).
sgd_probe(path, @replace_all(path, "/[^/]+\\z", ""), @replace_all(path, "(?s)\\A.*/", "")) :- sgd_walk_root(path), contains("/", path).
.decl sgd_probe_parent(path: symbol)
sgd_probe_parent(parent) :- sgd_probe(_, parent, _).
.decl sgd_blocked(path: symbol)
sgd_blocked(path) :- sgd_walk_root(path), match("(?s:.*)(?:\\A|/)(?:__pycache__|\\.pytest_cache|node_modules|\\.git|\\.venv|tmp|browser_build|tests|test|conform)(?:/|\\z)(?s:.*)", path).
.decl sgd_walk(root: symbol, path: symbol)
sgd_walk(".", ".") :- sgd_walk_root(".").
sgd_walk(root, root) :- sgd_probe_parent(parent), sgd_probe(root, parent, name), dir_entry(parent, name, 1), !sgd_blocked(root).
sgd_walk(root, @replace_all(cat(path, "/", name), "\\A\\./", "")) :- sgd_walk(root, path), dir_entry(path, name, 1), dir_metadata(path, name, _, 0, _), !match("(?:__pycache__|\\.pytest_cache|node_modules|\\.git|\\.venv|tmp|browser_build|tests|test|conform)", name).
.decl sgd_file(root: symbol, path: symbol)
// An explicit Python file bypasses directory and test exclusions in the source.
sgd_file(path, path) :- sgd_probe_parent(parent), sgd_probe(path, parent, name), dir_metadata(parent, name, 1, _, _), suffix(".py", name), name != ".py".
sgd_file(root, @replace_all(cat(path, "/", name), "\\A\\./", "")) :- sgd_walk(root, path), dir_entry(path, name, 0), suffix(".py", name), name != ".py".

.decl sgd_key(root: number, key: symbol)
// NUL is not a filesystem component. A NUL separator preserves Python Path's
// component comparison, including a directory a/ before a neighbouring a.py.
sgd_key(i, @replace_all(path, "/", "\u0000")) :- sgd_root(i, root), sgd_file(root, path).
.decl sgd_discovery_path(path: symbol, ordinal: number)
sgd_discovery_path(@replace_all(key, "\u0000", "/"), ordinal) :- ordered_rows(_, key, ordinal, sgd_key).
sgs_graph_path(path) :- sgd_file(_, path).

// Loading depends on unordered membership. Size and worker ordering are shared
// consumers after discovery, outside the filesystem request cone's aggregates.
.decl sgd_size_probe(path: symbol, parent: symbol, name: symbol)
sgd_size_probe(path, ".", path) :- sgs_graph_path(path), !contains("/", path).
sgd_size_probe(path, @replace_all(path, "/[^/]+\\z", ""), @replace_all(path, "(?s)\\A.*/", "")) :- sgs_graph_path(path), contains("/", path).
.decl sgd_size_parent(path: symbol)
sgd_size_parent(parent) :- sgd_size_probe(_, parent, _).
.decl sgd_size(path: symbol, bytes: number)
sgd_size(path, bytes) :- sgd_size_parent(parent), sgd_size_probe(path, parent, name), dir_metadata(parent, name, 1, _, bytes).

// Host demands have no discovery/count dependency. A single execution caches
// requested values; no file's parse result can alter worker count or weights.
.decl sgd_host_key(key: symbol)
sgd_host_key("cpu_count") :- sgd_enabled().
sgd_host_key("env:NERA_LINTER_WORKERS") :- sgd_enabled().
sgd_host_key("env:PYTHONINTMAXSTRDIGITS") :- sgd_enabled().
.decl sgd_host(key: symbol, value: symbol)
sgd_host(key, value) :- sgd_host_key(key), host_info(key, value).
.decl sgd_count(n: number)
sgd_count(n) :- n = count : { sgd_discovery_path(_, _) }.
.decl sgd_digit_override(n: number)
sgd_digit_override(n) :- sgd_host("env:PYTHONINTMAXSTRDIGITS", text), n = @python_int_clamped(text, 0, 9223372036854775807, 0), n >= 0.
.decl sgd_digit_limit(n: number)
sgd_digit_limit(n) :- sgd_digit_override(n).
sgd_digit_limit(4300) :- !sgd_digit_override(_).
.decl sgd_cpu(n: number)
sgd_cpu(n) :- sgd_host("cpu_count", text), n = @python_int_clamped(text, 1, 8, 0), n >= 1.
.decl sgd_default_workers(n: number)
sgd_default_workers(n) :- sgd_cpu(n).
sgd_default_workers(4) :- !sgd_cpu(_).
.decl sgd_worker_override(n: number)
// Clamp to selected occurrences: the source caps allocated bins there too.
sgd_worker_override(n) :- sgd_count(total), total > 50, sgd_digit_limit(limit), sgd_host("env:NERA_LINTER_WORKERS", text), n = @python_int_clamped(text, 1, total, limit), n >= 1.
.decl sgd_workers(n: number)
sgd_workers(n) :- sgd_worker_override(n).
sgd_workers(n) :- sgd_default_workers(n), !sgd_worker_override(_).
.decl sgd_bins(task: number, bins: number)
sgd_bins(0, workers) :- sgd_count(total), total > 50, sgd_workers(workers), workers >= (total + 15) / 16.
sgd_bins(0, (total + 15) / 16) :- sgd_count(total), total > 50, sgd_workers(workers), workers < (total + 15) / 16.
.decl sgd_work(task: number, occurrence: number, key: symbol, bytes: number)
sgd_work(0, i, @replace_all(path, "/", "\u0000"), bytes) :- sgd_count(total), total > 50, sgd_discovery_path(path, i), sgd_size(path, bytes).
// A selected path losing metadata must fail explicitly, never disappear from a
// size-balanced batch. The partition operator rejects negative weights.
sgd_work(0, i, path, -1) :- sgd_count(total), total > 50, sgd_discovery_path(path, i), !sgd_size(path, _).
sgs_scan_path(path, ordinal) :- sgd_count(total), total <= 50, sgd_discovery_path(path, ordinal).
sgs_scan_path(path, ordinal) :- balanced_rows(0, occurrence, _, ordinal, sgd_work, sgd_bins), sgd_discovery_path(path, occurrence).
