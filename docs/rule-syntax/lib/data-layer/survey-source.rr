// Source inventory for the pinned SymbolGraph _ModuleVisitor. This is deliberately
// separate from the modern call resolver: the source flattens nested class names,
// records classes inside functions, omits nested functions, and hoists every import.
// Rows retain occurrences. Graph construction later replaces duplicate symbol IDs.
#include "python/ast.rr"
#include "python/print.rr"

// A parsed resource is not automatically a graph input. Callers must supply
// sgs_scan_file. Native load labels recover logical paths from canonical paths.
.decl sgs_scan_file(d: number)
.decl sgs_path(d: number, path: symbol)
sgs_path(d, path) :- doc(d, path, label), !prefix("survey:", label).
sgs_path(d, @slice(label, 7, strlen(label))) :- doc(d, physical, label), prefix("survey:", label), loaded(physical, label, "python").
.decl sgs_resource_module(d: number, path: symbol, module: symbol)
sgs_resource_module(d, path, @replace_all(@replace_all(path, "(?:/)?__init__\\.py$", ""), "/", ".")) :- sgs_path(d, path), suffix("__init__.py", path), (path = "__init__.py" ; suffix("/__init__.py", path)).
sgs_resource_module(d, path, @replace_all(@slice(path, 0, strlen(path)-3), "/", ".")) :- sgs_path(d, path), suffix(".py", path), path != "__init__.py", !suffix("/__init__.py", path).
.decl sgs_module(d: number, path: symbol, module: symbol)
sgs_module(d, path, module) :- sgs_scan_file(d), sgs_resource_module(d, path, module), !syntax_error(d, _, _).
.decl sgs_definition(n: node, d: number, name: symbol, qual: symbol, k: symbol, owner: symbol)
sgs_definition(n, d, @nfkc(name), @nfkc(name), "class", "") :- kind(n, "class_definition"), def_name(n, name), docof(n, d), sgs_module(d, _, _).
sgs_definition(n, d, @nfkc(name), @nfkc(name), "function", "") :- kind(n, "function_definition"), !nearest(n, _, "function_definition"), !nearest(n, _, "class_definition"), def_name(n, name), docof(n, d), sgs_module(d, _, _).
sgs_definition(n, d, @nfkc(name), cat(@nfkc(owner), ".", @nfkc(name)), "method", @nfkc(owner)) :- kind(n, "function_definition"), !nearest(n, _, "function_definition"), nearest(n, c, "class_definition"), def_name(c, owner), def_name(n, name), docof(n, d), sgs_module(d, _, _).
.decl sgs_async(n: node, flag: number)
sgs_async(n, 1) :- sgs_definition(n, _, _, _, _, _), is_async(n).
sgs_async(n, 0) :- sgs_definition(n, _, _, _, _, _), !is_async(n).
.decl sgs_symbol(n: node, d: number, ordinal: number, sid: symbol, fq: symbol, name: symbol, qual: symbol, k: symbol, owner: symbol, row: number, async_flag: number)
sgs_symbol(n, d, ordinal, cat(module, "::", qual), cat(module, ".", qual), name, qual, k, owner, row, flag) :- sgs_definition(n, d, name, qual, k, owner), sgs_module(d, _, module), line(n, row), sgs_async(n, flag), ordinal = count : { sgs_definition(other, d, _, _, _, _), earlier(other, n) }.
.decl sgs_defined(d: number, name: symbol, sid: symbol, ordinal: number)
sgs_defined(d, name, sid, ordinal) :- sgs_symbol(n, d, _, sid, _, name, _, _, _, _, _), ordinal = count : { sgs_symbol(other, d, _, _, _, name, _, _, _, _, _), earlier(other, n) }.

// Relative imports are clamped at the root by the original visitor, even when
// Python execution would reject them. Keep module and symbol namespaces separate.
.decl sgs_package(d: number, package: symbol)
sgs_package(d, module) :- sgs_resource_module(d, path, module), (path = "__init__.py" ; suffix("/__init__.py", path)).
sgs_package(d, @pkg_up(module, 1)) :- sgs_resource_module(d, path, module), path != "__init__.py", !suffix("/__init__.py", path).
.decl sgs_from(i: node, module: symbol)
sgs_from(i, @nfkc(module)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "dotted_name"), text(mn, module).
sgs_from(i, @pkg_up(package, strlen(dots)-1)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"), child(mn, pre, 0), text(pre, dots), !child(mn, _, 1), docof(i, d), sgs_package(d, package).
sgs_from(i, @dot(@pkg_up(package, strlen(dots)-1), @nfkc(tail))) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"), child(mn, pre, 0), text(pre, dots), child(mn, dn, 1), text(dn, tail), docof(i, d), sgs_package(d, package).
sgs_from(i, "__future__") :- kind(i, "future_import_statement").
.decl sgs_alias(i: node, a: node, local: symbol, imported: symbol)
sgs_alias(i, a, @nfkc(name), @nfkc(name)) :- sgs_from(i, _), field(i, "name", a), kind(a, "dotted_name"), text(a, name).
sgs_alias(i, a, @nfkc(local), @nfkc(name)) :- sgs_from(i, _), field(i, "name", a), kind(a, "aliased_import"), field(a, "name", n), text(n, name), field(a, "alias", al), text(al, local).
.decl sgs_import_candidate(a: node, d: number, k: symbol, name: symbol, target: symbol)
sgs_import_candidate(a, d, "imported", local, cat(module, ".", name)) :- sgs_alias(i, a, local, name), sgs_from(i, module), module != "", docof(i, d).
sgs_import_candidate(a, d, "import_module", @head(@nfkc(module)), @nfkc(module)) :- kind(i, "import_statement"), field(i, "name", a), kind(a, "dotted_name"), text(a, module), docof(i, d).
sgs_import_candidate(a, d, "import_module", @nfkc(local), @nfkc(module)) :- kind(i, "import_statement"), field(i, "name", a), kind(a, "aliased_import"), field(a, "name", n), text(n, module), field(a, "alias", al), text(al, local), docof(i, d).
.decl sgs_import(d: number, k: symbol, name: symbol, target: symbol)
sgs_import(d, k, name, target) :- sgs_import_candidate(a, d, k, name, target), count : { sgs_import_candidate(later, d, k, name, _), earlier(a, later) } = 0.

// The survey keeps only args.args and args.kwonlyargs. Positional-only and
// variadic parameters still bind body locals but are absent from this inventory.
.decl sgs_parameter_site(f: node, p: node, name: symbol, index: number, annotation: loc)
sgs_parameter_site(f, p, @nfkc(name), i, a) :- sgs_definition(f, _, _, _, k, owner), k != "class", sig_param(f, p, nm, i, "pos", a, _), text(nm, name), (owner = "" ; (@nfkc(name) != "self", @nfkc(name) != "cls")).
sgs_parameter_site(f, p, @nfkc(name), i, a) :- sgs_definition(f, _, _, _, k, _), k != "class", sig_param(f, p, nm, i, "kwonly", a, _), text(nm, name).
.decl sgs_parameter(f: node, ordinal: number, name: symbol, has_annotation: number, value: symbol)
sgs_parameter(f, ordinal, name, 0, "") :- sgs_parameter_site(f, _, name, i, a), unset(a), ordinal = count : { sgs_parameter_site(f, _, _, j, _), j < i }.
sgs_parameter(f, ordinal, name, 1, text) :- sgs_parameter_site(f, _, name, i, a), annotation_text(a, text), ordinal = count : { sgs_parameter_site(f, _, _, j, _), j < i }.
.decl sgs_return(f: node, has_annotation: number, value: symbol)
sgs_return(f, 1, text) :- sgs_definition(f, _, _, _, k, _), k != "class", field(f, "return_type", a), annotation_text(a, text).
sgs_return(f, 0, "") :- sgs_definition(f, _, _, _, k, _), k != "class", !field(f, "return_type", _).

// _collect_module_level_names has a special case only for direct class/method
// statements. Names under a conditional definition are collected recursively,
// including its body. Class bases and top-level function decorators are omitted.
.decl sgs_statement(wrapper: node, statement: node)
sgs_statement(s, s) :- body_stmt(_, s, _), !kind(s, "decorated_definition").
sgs_statement(s, f) :- body_stmt(_, s, _), kind(s, "decorated_definition"), field(s, "definition", f).
.decl sgs_module_expression(d: number, e: node)
sgs_module_expression(d, s) :- kind(m, "module"), docof(m, d), body_stmt(m, wrapped, _), sgs_statement(wrapped, s), !kind(s, "class_definition"), !kind(s, "function_definition"), !import_stmt(s), !kind(s, "future_import_statement").
sgs_module_expression(d, s) :- kind(m, "module"), docof(m, d), body_stmt(m, wrapped, _), sgs_statement(wrapped, c), kind(c, "class_definition"), field(c, "body", b), body_stmt(b, member, _), sgs_statement(member, s), !kind(s, "function_definition").
.decl sgs_direct_module_method(d: number, f: node)
sgs_direct_module_method(d, f) :- kind(m, "module"), docof(m, d), body_stmt(m, wrapped, _), sgs_statement(wrapped, c), kind(c, "class_definition"), field(c, "body", b), body_stmt(b, member, _), sgs_statement(member, f), kind(f, "function_definition").
sgs_module_expression(d, e) :- sgs_direct_module_method(d, f), decorator(f, e).
sgs_module_expression(d, e) :- sgs_direct_module_method(d, f), sig_param(f, _, _, _, _, _, e), kind(e, _).
.decl sgs_module_ref(d: number, name: symbol)
sgs_module_ref(d, @nfkc(name)) :- sgs_module_expression(d, e), ast_name(e, name).
sgs_module_ref(d, @nfkc(name)) :- sgs_module_expression(d, e), ast_name(n, name), within(n, e).

.decl sgs_decorator(n: node, ordinal: number, value: symbol)
sgs_decorator(n, ordinal, @replace_all(text, "(?s)\\(.*", "")) :- sgs_definition(n, _, _, _, _, _), decorator(n, e), decorator_text(e, text), ordinal = count : { decorator(n, other), earlier(other, e) }.
.decl sgs_class_decorator(n: node, ordinal: number, value: symbol)
sgs_class_decorator(n, ordinal, text) :- sgs_definition(n, _, _, _, "method", _), nearest(n, c, "class_definition"), sgs_decorator(c, ordinal, text).
.decl sgs_base_site(c: node, e: node, value: symbol)
sgs_base_site(c, e, text) :- sgs_definition(c, _, _, _, "class", _), field(c, "superclasses", args), child(args, e, _), class_base_text(e, text).
.decl sgs_base(c: node, ordinal: number, value: symbol)
sgs_base(c, ordinal, text) :- sgs_base_site(c, e, text), ordinal = count : { sgs_base_site(c, other, _), earlier(other, e) }.
.decl sgs_class_attribute_site(c: node, a: node, name: symbol, value: symbol)
sgs_class_attribute_site(c, a, @nfkc(name), text) :- sgs_definition(c, _, _, _, "class", _), field(c, "body", body), body_stmt(body, stmt, _), asgstmt(a, stmt), assign_ann(a, annotation), field(a, "left", target), kind(target, "identifier"), text(target, name), annotation_text(annotation, text).
.decl sgs_class_attribute(c: node, ordinal: number, name: symbol, value: symbol)
sgs_class_attribute(c, ordinal, name, text) :- sgs_class_attribute_site(c, a, name, text), ordinal = count : { sgs_class_attribute_site(c, other, _, _), earlier(other, a) }.
.decl sgs_is_abstract(n: node)
sgs_is_abstract(n) :- sgs_base(n, _, text), contains("ABC", text).
sgs_is_abstract(n) :- sgs_definition(n, _, _, _, k, _), k != "class", sgs_decorator(n, _, text), suffix("abstractmethod", text).
.decl sgs_abstract(n: node, flag: number)
sgs_abstract(n, 1) :- sgs_is_abstract(n).
sgs_abstract(n, 0) :- sgs_definition(n, _, _, _, _, _), !sgs_is_abstract(n).
