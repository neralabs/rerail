// Discovery, extraction, and reporting share the dispatch event relation.
#include "data-layer/plugin-production.rr"
#include "data-layer/signing.rr"
.decl sdr_config(section: symbol,key: symbol,field_order: number,kind: symbol,value: symbol)
.decl sdr_sequence(section: symbol,key: symbol,ordinal: number,kind: symbol,value: symbol)
.decl sdr_exists(parent: symbol,name: symbol)
.decl sdr_scope_site(parent: symbol,name: symbol)
sdr_scope_site(p,n) :- !env("data-layer.api","true"),sdr_root_scope(_,_,p,n).
sdr_scope_site("impl/common/l2070_server_plan","base_server_plan.py") :- !env("data-layer.api","true").
.decl sdr_scope_parent(path: symbol)
sdr_scope_parent(p) :- sdr_scope_site(p,_).
// The demand key must not depend on the entry name returned by the reader.
sdr_exists(p,n) :- sdr_scope_parent(p),sdr_scope_site(p,n),dir_entry(p,n,1).
sdr_exists(p,n) :- sdr_scope_parent(p),sdr_scope_site(p,n),dir_metadata(p,n,1,_,_).
pp_file(p) :- sd_base(p),sdr_scope_parent(parent),sdr_scope_site(parent,"base_server_plan.py"),dir_metadata(parent,"base_server_plan.py",1,_,_).

.violation DispatchRepositoryConfig(at: span,section: symbol,key: symbol,field_order: number,kind: symbol,value: symbol) code "SDR_CONFIG" "dispatch configuration"
DispatchRepositoryConfig(@place("",0),s,k,o,t,v) :- option("entryPoint","_production_contract"),sdr_config(s,k,o,t,v).
.violation DispatchRepositorySequence(at: span,section: symbol,key: symbol,ordinal: number,kind: symbol,value: symbol) code "SDR_SEQUENCE" "dispatch configuration sequence"
DispatchRepositorySequence(@place("",0),s,k,o,t,v) :- option("entryPoint","_production_contract"),sdr_sequence(s,k,o,t,v).
.violation DispatchRepositoryScope(at: span,part: symbol,ordinal: number,path: symbol) code "SDR_SCOPE" "dispatch scope"
DispatchRepositoryScope(@place("",0),"directories",i,p) :- option("entryPoint","_production_contract"),sdr_root_scope(i,p,parent,name),sdr_exists(parent,name).
DispatchRepositoryScope(@place("",0),"explicit_files",0,p) :- option("entryPoint","_production_contract"),sd_base(p),sdr_exists("impl/common/l2070_server_plan","base_server_plan.py").

.violation DispatchRepositoryFact(at: span,path: symbol,path_order: symbol,line: number,code_value: symbol,scope: symbol,expression: symbol,message: symbol,occurrence: number,visit_order: number,layer: number) code "SDR_FACT" "dispatch fact"
DispatchRepositoryFact(@place(p,l),p,@replace_all(p,"/","\u0000"),l,c,s,e,m,o,i,k) :- option("entryPoint","_production_contract"),
    sd_event(d,p,n,k,c,s,e,_,l,i),sd_occurrence(d,p,n,k,c,o),sd_message(c,m).

.decl sdr_report(path: symbol,line: number,code: symbol,message: symbol,phase: number,expression: symbol,visit_order: number,layer: number)
sdr_report(p,l,c,cat(s,": ",m,": ",e),0,e,i,k) :- pp_run(),sd_event(_,p,_,k,c,s,e,_,l,i),sd_message(c,m).
sdr_report("scripts/allowlists/lint_serverplan_dispatch_architecture.txt",1,"SPD000","signed dispatch allowlist must remain empty",1,"",0,0) :- pp_run(),sdr_inventory_error().
.violation DispatchRepositoryReport(at: span,path: symbol,line: number,code_value: symbol,message: symbol,phase: number,expression: symbol,visit_order: number,layer: number) code "SDR_REPORT" "dispatch reporter result"
DispatchRepositoryReport(@place(p,l),p,l,c,m,phase,e,i,k) :- option("entryPoint","_production_contract"),sdr_report(p,l,c,m,phase,e,i,k).
.violation DispatchProduction(at: span,code_value: symbol,message: symbol) code {code_value} "{message}"
DispatchProduction(@place(p,l),c,message) :- !option("entryPoint",_),sdr_report(p,l,c,message,_,_,_,_).

// Inventory reads are demanded exports, separate from source scanning. Both
// projections share one native read, including strict UTF-8 error details.
.decl sdr_inventory_requested()
sdr_inventory_requested() :- !option("entryPoint",_).
sdr_inventory_requested() :- option("entryPoint","_production_contract").
.decl sdr_inventory_path(path: symbol)
sdr_inventory_path("scripts/allowlists/lint_serverplan_dispatch_architecture.txt") :-
    !env("data-layer.api","true"),!env("data-layer.dispatch.scan-only","true").
.decl sdr_inventory_line(ordinal: number,text: symbol)
sdr_inventory_line(i,t) :- sdr_inventory_path(p),file_line(p,i,t).
.decl sdr_read_error(io_kind: symbol,errno: number,detail: symbol,bytes_hex: symbol,start: number,end: number,reason: symbol)
sdr_read_error(k,n,d,b,s,e,r) :- sdr_inventory_path(p),file_error(p,k,n,d,b,s,e,r).
.decl sdr_inventory_failed()
sdr_inventory_failed() :- sdr_read_error(_,_,_,_,_,_,_).
.decl sdr_inventory_entry(ordinal: number,fragment: number,value: symbol)
sdr_inventory_entry(i,j,e) :- sdr_inventory_requested(),sdr_inventory_line(i,raw),
    match_all("(?<part>[^\\n\\r\\v\\f\\x{1c}-\\x{1e}\\x{85}\\x{2028}\\x{2029}]+)",raw,j,_,_),sd_whitespace(w),
    e=@replace_all(part,cat("^",w,"|",w,"$"),""),e!="",!prefix("#",e).
.violation DispatchRepositoryInventory(at: span,ordinal: number,fragment: number,value: symbol) code "SDR_INVENTORY" "dispatch inventory entry"
DispatchRepositoryInventory(@place("",0),i,j,e) :- option("entryPoint","_production_contract"),sdr_inventory_entry(i,j,e).
.decl sdr_utf8_reason(kind: symbol,reason: symbol)
sdr_utf8_reason("invalid-start","invalid start byte").
sdr_utf8_reason("invalid-continuation","invalid continuation byte").
sdr_utf8_reason("unexpected-end","unexpected end of data").
.violation DispatchInventoryReadError(at: span,io_kind: symbol,errno: number,detail: symbol,bytes_hex: symbol,start: number,end: number,reason: symbol) code "SDR_IO_ERROR" "inventory read failed"
DispatchInventoryReadError(@place("scripts/allowlists/lint_serverplan_dispatch_architecture.txt",1),k,n,@replace_all(d," \\(os error [0-9]+\\)$",""),b,s,e,"") :-
    sdr_inventory_requested(),sdr_read_error(k,n,d,b,s,e,_),k!="InvalidUtf8".
DispatchInventoryReadError(@place("scripts/allowlists/lint_serverplan_dispatch_architecture.txt",1),k,n,d,b,s,e,reason) :-
    sdr_inventory_requested(),sdr_read_error(k,n,d,b,s,e,r),k="InvalidUtf8",sdr_utf8_reason(r,reason).
.decl sdr_signature(value: symbol)
sdr_signature(s) :- option("dispatchSignature",s).
sdr_signature(s) :- !option("dispatchSignature",_),sdr_default_signature(s).
allow_sig("dispatch","serverplan_dispatch_architecture",s) :- sdr_inventory_requested(),!sdr_inventory_entry(_,_,_),!sdr_inventory_failed(),sdr_signature(s).
.decl sdr_inventory_error()
sdr_inventory_error() :- sdr_inventory_entry(_,_,_).
sdr_inventory_error() :- allow_status("dispatch",s),s!="valid".
.decl sdr_stderr(text: symbol)
sdr_stderr(cat("FAIL: WARNING: Allowlist for serverplan_dispatch_architecture is ",label,". Sign with --sign-allowlist.\n")) :-
    allow_status("dispatch","unsigned"),sdr_signature(s),(s="NEEDS_SIGNING",label="needs signing";s!="NEEDS_SIGNING",label="unsigned").
sdr_stderr(cat("FAIL: Allowlist signature verification failed for serverplan_dispatch_architecture: ",detail,"\n")) :-
    allow_status("dispatch","invalid"),allow_message("dispatch",message),sdr_signature(s),nera_key(key),detail=@ed25519_error(key,message,s).
.violation DispatchRepositoryOutput(at: span,channel: symbol,ordinal: number,text: symbol) code "SDR_OUTPUT" "dispatch output"
DispatchRepositoryOutput(@place("",0),"stderr",0,t) :- option("entryPoint","_production_contract"),sdr_stderr(t).
