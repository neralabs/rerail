// PermissionError uses string path ordering, numeric lines, and stable ties.
.decl permission_cli_row(i: number, path: symbol, line: number)
permission_cli_row(i,p,to_number(l)) :- tcli_kind("permission"), tcli_file(i,p,_), option_item("cliLine",i,l).
.decl permission_cli_before(a: number, b: number)
permission_cli_before(a,b) :- permission_cli_row(a,p,l), permission_cli_row(b,q,m),
    (@str_cmp(p,q) < 0 ; (p = q, l < m) ; (p = q, l = m, a < b)).
.decl permission_cli_rank(i: number, ordinal: number)
permission_cli_rank(i,n) :- permission_cli_row(i,_,_), n = count : { permission_cli_before(_,i) }.
.decl permission_cli_path(i: number, path: symbol)
permission_cli_path(i,".") :- permission_cli_row(i,p,_), option("sourceRoot",p).
permission_cli_path(i,@slice(p,strlen(root)+1,strlen(p))) :- permission_cli_row(i,p,_), option("sourceRoot",root), root != "/", prefix(cat(root,"/"),p).
permission_cli_path(i,@slice(p,1,strlen(p))) :- permission_cli_row(i,p,_), option("sourceRoot","/"), prefix("/",p), !prefix("//",p).
permission_cli_path(i,p) :- permission_cli_row(i,p,_), option("sourceRoot","."), !prefix("/",p).
.decl permission_cli_error(rank: number)
permission_cli_error(n) :- permission_cli_rank(i,n), !permission_cli_path(i,_).
.decl permission_cli_blocked(rank: number)
permission_cli_blocked(n) :- permission_cli_rank(_,n), permission_cli_error(e), e < n.
TextCliPathError(@place("",0),n,p) :- permission_cli_error(n), !permission_cli_blocked(n), permission_cli_rank(i,n), permission_cli_row(i,p,_).
TextCliOutput(@place("",0),0,0,0,"No PermissionError violations found.\n","") :- tcli_kind("permission"), tcli_count(0).
TextCliOutput(@place("",0),0,0,0,cat("Found ",to_string(n)," PermissionError violation(s):\n\n"),"") :- tcli_kind("permission"), tcli_count(n), n > 0.
TextCliOutput(@place("",0),1,0,n,cat("  ",p,":",line,": ",message,"\n"),"") :- permission_cli_rank(i,n), permission_cli_path(i,p), !permission_cli_blocked(n), option_item("cliLine",i,line), option_item("cliMessage",i,message).
TextCliOutput(@place("",0),2,0,0,"\nFix: Add 'from l1100_exceptions.exceptions import PermissionError'\n     to each file that raises PermissionError.\n\nSee GitHub Issue #1181 for details.\n","") :- tcli_kind("permission"), tcli_count(n), n > 0, !permission_cli_error(_).
TextCliExit(@place("",0),0) :- tcli_kind("permission"), tcli_count(n), n > 0, !permission_cli_error(_), option("checkMode","0").
TextCliExit(@place("",0),1) :- tcli_kind("permission"), tcli_count(n), n > 0, !permission_cli_error(_), option("checkMode","1").

// Discovery receives the complete I/O batch, with no semantic filtering in Python.
.decl permission_file(i: number, path: symbol, key: symbol)
permission_file(i,p,@replace_all(p,"/","\u0000")) :- option("entryPoint","_permission_files"), option_item("candidateFiles",i,p).
.decl permission_file_excluded(i: number)
permission_file_excluded(i) :- permission_file(i,p,_), option_item("excludeDirs",_,e),
    (p = e ; prefix(cat(e,"/"),p) ; contains(cat("/",e,"/"),p) ; suffix(cat("/",e),p)).
.decl permission_file_selected(i: number, path: symbol, key: symbol)
permission_file_selected(i,p,k) :- permission_file(i,p,k), !permission_file_excluded(i).
.violation PermissionFile(at: span, ordinal: number, value: symbol) code "PERMISSION_FILE" "selected file"
PermissionFile(@place("",0),n,p) :- permission_file_selected(i,p,k), n = count : { permission_file_selected(j,_,other), (@str_cmp(other,k) < 0 ; (other = k, j < i)) }.

// Legacy conversion helpers use the shared typed JSON decoder, including Python
// string and integer projections. Missing fields and failed casts yield None.
.decl permission_fact_root(i: number, root: symbol)
.input permission_fact_root(IO=json,filename="permission-facts.json",path="/rows/*/root")
.decl permission_fact_kind(i: number, kind: symbol)
.input permission_fact_kind(IO=json,filename="permission-facts.json",path="/rows/*/raw",projection="type")
.decl permission_fact_path(i: number, value: symbol)
.input permission_fact_path(IO=json,filename="permission-facts.json",path="/rows/*/raw/path",projection="python-str")
.decl permission_fact_line(i: number, value: symbol, error_type: symbol, detail: symbol)
.input permission_fact_line(IO=json,filename="permission-facts.json",path="/rows/*/raw/line",projection="python-int")
.decl permission_fact_message(i: number, value: symbol)
.input permission_fact_message(IO=json,filename="permission-facts.json",path="/rows/*/raw/message",projection="python-str")
.decl permission_fact_valid(i: number)
permission_fact_valid(i) :- option("entryPoint","_permission_from_fact"), permission_fact_kind(i,"object"), permission_fact_path(i,_), permission_fact_line(i,_,"",_), permission_fact_message(i,_).
// Reuse the shared lexical PosixPath normalization. No filesystem resolution.
sf_path_input(i,0,p) :- permission_fact_valid(i), permission_fact_path(i,p), prefix("/",p).
sf_path_input(i,0,cat(root,"/",p)) :- permission_fact_valid(i), permission_fact_root(i,root), permission_fact_path(i,p), !prefix("/",p).
.violation PermissionFact(at: span, ordinal: number, value_json: symbol) code "PERMISSION_FACT" "converted fact"
PermissionFact(@place("",0),i,cat("{\"file_path\":",@json_str(p),",\"line_number\":",l,",\"message\":",@json_str(m),"}")) :- permission_fact_valid(i), sf_path(i,0,p), permission_fact_line(i,l,"",_), permission_fact_message(i,m).
PermissionFact(@place("",0),i,"null") :- option("entryPoint","_permission_from_fact"), permission_fact_root(i,_), !permission_fact_valid(i).

.decl permission_to_path(i: number, path: symbol)
.input permission_to_path(IO=json,filename="permission-facts.json",path="/rows/*/raw/file_path")
.decl permission_to_line(i: number, value: symbol)
.input permission_to_line(IO=json,filename="permission-facts.json",path="/rows/*/raw/line_number",projection="json")
.decl permission_to_message(i: number, value: symbol)
.input permission_to_message(IO=json,filename="permission-facts.json",path="/rows/*/raw/message",projection="json")
.decl permission_to_relative(i: number, path: symbol)
permission_to_relative(i,".") :- permission_to_path(i,p), permission_fact_root(i,p).
permission_to_relative(i,p) :- permission_to_path(i,p), permission_fact_root(i,"."), !prefix("/",p).
permission_to_relative(i,@slice(p,1,strlen(p))) :- permission_to_path(i,p), permission_fact_root(i,"/"), p != "/", prefix("/",p), !prefix("//",p).
permission_to_relative(i,@slice(p,2,strlen(p))) :- permission_to_path(i,p), permission_fact_root(i,"//"), p != "//", prefix("//",p).
permission_to_relative(i,@slice(p,strlen(root)+1,strlen(p))) :- permission_to_path(i,p), permission_fact_root(i,root), root != ".", root != "/", root != "//", prefix(cat(root,"/"),p).
.decl permission_to_result(i: number, path: symbol)
permission_to_result(i,p) :- permission_to_relative(i,p).
permission_to_result(i,p) :- permission_to_path(i,p), !permission_to_relative(i,_).
PermissionFact(@place("",0),i,cat("{\"path\":",@json_str(p),",\"line\":",l,",\"message\":",m,"}")) :- option("entryPoint","_permission_to_fact"), permission_to_result(i,p), permission_to_line(i,l), permission_to_message(i,m).
