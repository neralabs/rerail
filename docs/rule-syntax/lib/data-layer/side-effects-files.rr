// scan_repo uses Path.rglob, then an explicit FileScopeSpec with tests included.
// Root and source arguments come from the caller; native demand chooses the files.
#include "python/paths.rr"
.decl pse_walk(path:symbol)
pse_walk(".") :- env("pse.api","repository").
pse_walk(cat(p,"/",name)) :- pse_walk(p),dir_entry(p,name,1),dir_metadata(p,name,_,0,_),!pse_constant("SKIP_DIRS",name).
.decl pse_disk_file(path:symbol)
pse_disk_file(@replace_all(cat(p,"/",name),"\\A\\./","")) :- pse_walk(p),dir_entry(p,name,0),dir_metadata(p,name,1,_,_),suffix(".py",name),name!=".py".
// Explicit scopes bypass repository skip directories, as FileScopeSpec does.
// The request cone reads run constants (env), before post-load policy option tables.
.decl pse_requested(i:number,path:symbol)
pse_requested(to_number(index),p) :- env(k,p),match_all("\\Apse\\.file\\.(?<index>[0-9]+)\\z",k).
pyp_join(2*i,root,p) :- env("pse.api","files"),env("pse.physicalRoot",root),pse_requested(i,p).
pyp_join(2*i+1,root,p) :- env("pse.api","files"),env("pse.ownerRoot",root),pse_requested(i,p).
.decl pse_explicit(physical:symbol,logical:symbol)
pse_explicit(p,l) :- env("pse.api","files"),pse_requested(i,_),pyp_path(2*i,p),pyp_path(2*i+1,l).
.decl pse_explicit_parent(path:symbol,parent:symbol,name:symbol)
pse_explicit_parent(p,@dir(p),@replace_all(p,"(?s).*/","")) :- pse_explicit(p,_).
// Request keys must have an anchor independent of the listing's output name.
.decl pse_explicit_dir(parent:symbol)
pse_explicit_dir(parent) :- pse_explicit_parent(_,parent,_).
pse_disk_file(p) :- pse_explicit_dir(parent),dir_metadata(parent,name,1,_,_),pse_explicit_parent(p,parent,name),suffix(".py",name),name!=".py".
.decl pse_relative(path:symbol,relative:symbol)
pse_relative(p,".") :- pse_explicit(_,p),env("pse.ownerRoot",p).
pse_relative(p,@slice(p,strlen(r)+1,strlen(p))) :- pse_explicit(_,p),env("pse.ownerRoot",r),r!="/",r!="//",r!=".",prefix(cat(r,"/"),p).
pse_relative(p,@slice(p,1,strlen(p))) :- pse_explicit(_,p),env("pse.ownerRoot","/"),p!="/",prefix("/",p),!prefix("//",p).
pse_relative(p,@slice(p,2,strlen(p))) :- pse_explicit(_,p),env("pse.ownerRoot","//"),p!="//",prefix("//",p).
pse_relative(p,p) :- pse_explicit(_,p),env("pse.ownerRoot","."),!prefix("/",p).
.decl pse_output(path:symbol,output:symbol)
pse_output(p,p) :- pse_disk_file(p),env("pse.api","repository").
pse_output(p,r) :- pse_disk_file(p),pse_explicit(p,l),pse_relative(l,r).
pse_output(p,l) :- pse_disk_file(p),pse_explicit(p,l),!pse_relative(l,_).
.decl pse_demand(path:symbol)
pse_demand(p) :- pse_disk_file(p),!pse_read_failure(_),file_line(p,_,line_text),pse_constant("PLAN_OPENERS",trigger),contains(trigger,line_text).
load(p,cat("pse:",p),"python") :- pse_demand(p).
.decl pse_disk_doc(d:number,path:symbol)
pse_disk_doc(d,p) :- pse_demand(p),loaded(c,cat("pse:",p),"python"),doc(d,c,_).
.violation SideEffectsDiskFact(at:span,ordinal:number,source_code:symbol,file_path:symbol,line_number:number,source_message:symbol,severity:symbol) code "PSE_FACT" "{source_message}"
SideEffectsDiskFact(@place("",0),i,c,output,l,m,s) :- pse_disk_doc(d,p),pse_output(p,output),!syntax_error(d,_,_),pse_finding(n,c,m,s),docof(n,d),pse_order(n,i),pse_line(n,l).
.violation SideEffectsBlocking(at:span,ordinal:number) code "PSE_BLOCKING" "Blocking violation index"
SideEffectsBlocking(@place("",0),i) :- option("entryPoint","blocking_violations"),option_item("pseSeverities",i,"error").

.decl pse_read_failure(path:symbol)
pse_read_failure(p) :- pse_disk_file(p),file_error(p,_,_,_,_,_,_,_).
.decl pse_error_spelling(path:symbol,logical:symbol)
pse_error_spelling(p,p) :- pse_disk_file(p),env("pse.api","repository").
pse_error_spelling(p,l) :- pse_disk_file(p),pse_explicit(p,l).
.decl pse_error_key(path:symbol,key:symbol)
pse_error_key(p,cat("//","\u0000",@replace_all(@slice(l,2,strlen(l)),"/","\u0000"))) :- pse_error_spelling(p,l),prefix("//",l).
pse_error_key(p,cat("/","\u0000",@replace_all(@slice(l,1,strlen(l)),"/","\u0000"))) :- pse_error_spelling(p,l),prefix("/",l),!prefix("//",l).
pse_error_key(p,@replace_all(l,"/","\u0000")) :- pse_error_spelling(p,l),!prefix("/",l).
.violation SideEffectsReadError(at:span,file_path:symbol,io_kind:symbol,errno:number,detail:symbol,bytes_hex:symbol,start:number,end:number,reason:symbol,order_key:symbol) code "PSE_READ_ERROR" "Native source read error"
SideEffectsReadError(@place("",0),output,k,n,d,b,s,e,r,key) :- pse_disk_file(p),pse_output(p,output),pse_error_key(p,key),file_error(p,k,n,d,b,s,e,r).

// pathlib.rglob emits a directory's matches before walking its real child directories.
// Enumeration positions are independent of the shared, sorted name column.
.decl pse_iter_walk(path:symbol)
pse_iter_walk(".") :- env("pse.api","iter").
.decl pse_entry_order(path:symbol,name:symbol,padded:symbol)
pse_entry_order(p,n,@printf("%020d",i)) :- pse_iter_walk(p),dir_order(p,n,i).
.decl pse_iter_parent(child:symbol,parent:symbol,ordinal:symbol)
pse_iter_parent(cat(p,"/",n),p,i) :- pse_iter_walk(p),dir_entry(p,n,1),dir_metadata(p,n,_,0,_),pse_entry_order(p,n,i),!pse_constant("SKIP_DIRS",n).
pse_iter_walk(child) :- pse_iter_parent(child,_,_).
.decl pse_iter_ancestor(path:symbol,ancestor:symbol)
pse_iter_ancestor(p,p) :- pse_iter_walk(p).
pse_iter_ancestor(p,a) :- pse_iter_ancestor(p,c),pse_iter_parent(c,a,_).
.decl pse_iter_match(path:symbol,parent:symbol,ordinal:symbol)
pse_iter_match(cat(p,"/",n),p,i) :- pse_iter_walk(p),dir_entry(p,n,_),pse_entry_order(p,n,i),suffix(".py",n),!pse_constant("SKIP_DIRS",n).
.decl pse_iter_token(path:symbol,depth:number,text:symbol)
pse_iter_token(f,strlen(c)-strlen(@replace_all(c,"/",""))-1,cat("1",i,"/")) :- pse_iter_match(f,p,_),pse_iter_ancestor(p,c),pse_iter_parent(c,_,i).
pse_iter_token(f,strlen(p)-strlen(@replace_all(p,"/","")),cat("0",i)) :- pse_iter_match(f,p,i).
.violation SideEffectsIter(at:span,path:symbol,order_key:symbol) code "PSE_ITER" "Selected Python path"
SideEffectsIter(@place("",0),@replace_all(f,"\\A\\./",""),key) :- pse_iter_match(f,_,_),key=join token by depth sep "":{pse_iter_token(f,depth,token)}.
