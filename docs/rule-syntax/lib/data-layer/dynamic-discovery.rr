// Discovery membership remains separate from its ordered consumer.
#include "project.rr"
#include "data-layer/python-discovery.rr"
sgd_enabled() :- env("dml.discovery","true").
sgd_configured() :- env("data-layer.scan.configured","true").
.decl dml_disk_allowed(path: symbol)
dml_disk_allowed(p) :- env(key,p),match_all("\\Adml\\.allowed\\.[0-9]+\\z",key).
dml_allowed(p) :- dml_disk_allowed(p).
.decl dml_disk_error(path: symbol)
dml_disk_error(p) :- sgd_file(_,p),!dml_disk_allowed(p),file_error(p,_,_,_,_,_,_,_).
load(p,cat("dml:",p),"python") :- sgd_file(_,p),!dml_disk_allowed(p),!dml_disk_error(p).
.decl dml_disk_doc(path: symbol,d: number)
dml_disk_doc(p,d) :- sgd_file(_,p),loaded(c,cat("dml:",p),"python"),loaded_doc(c,cat("dml:",p),"python",d).
.violation DynamicDiscovered(at: span,ordinal: number,path: symbol) code "DML_DISCOVERED" "discovered source"
DynamicDiscovered(@place("",0),i,p) :- option("entryPoint","_dynamic_repository"),sgd_discovery_path(p,i).
.violation DynamicFound(at: span,file_ordinal: number,path: symbol,ordinal: number,snippet: symbol,label: symbol) code "DML_FOUND" "{label}"
DynamicFound(@place(p,l),i,p,j,clean,label) :- option("entryPoint","_dynamic_repository"),sgd_discovery_path(p,i),!dml_disk_allowed(p),
    dml_disk_doc(p,d),dml_candidate(d,l,j,label),dml_line(d,l,_,clean,_),!prefix("#",clean),dml_state(d,l,""),dml_quotes(d,l,0,0),
    !dml_type_checking(d,l),(j<3 ; j>=3,!dml_primary(d,l)).
