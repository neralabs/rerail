// rust/syntax-patterns: Rust patterns as Clippy's pattern lints read them (rustc's PatKind).
//
// tree-sitter-rust's pattern shapes, where they differ from rustc's:
//   - `_` is an anonymous token, not a node. In `(0, _, ..)` the tuple_pattern's named children are `0` and
//     the remaining_field_pattern `..`; the `_` is the tuple_pattern's own token, placed by its offset.
//   - `ref mut a @ ..` nests as ref_pattern > mut_pattern > captured_pattern (`a @ ..`); rustc has one
//     PatKind::Ident with its binding mode.
//   - `c: _` in a struct pattern is a field_pattern with a name and no pattern: the tape keeps no `_` there.
//
// What a rule gets from this library:
//   bare_pat(p, q)          q is pattern p without `ref` / `mut` wrappers: `ref mut a @ ..` gives `a @ ..`
//   rest_pat(p, r)          r is the `..` of tuple, tuple-struct or slice pattern p
//   wild_before(x, w)       token w is a `_` element right before element or token x: `_, x`
//   wild_after(x, w)        token w is a `_` element right after x: `x, _`
//   wild_field(f)           f is the struct-pattern field `name: _`
//   paren_pat(p, q)         p is `(q)`: a tuple_pattern of one element and no comma (rustc's PatKind::Paren)
//   unparen(p, q)           q is p with its parentheses removed: `((0 | 1))` gives `0 | 1`
//   top_pattern(p)          p is a whole pattern: of a let, `if let` / `while let`, match arm or parameter
//   elem_key(p, i, k, rest) the i-th element of tuple, tuple-struct or slice pattern p, from 0, `_` included;
//                           k is its text without parentheses or whitespace, rest = 1 for `..`
//   elem_count(p, n)        p has n elements
//
// Builds on core (the tape, tokens, offsets, text) and rust/syntax.rr (comment_kind).
#include "rust/syntax.rr"

.decl bare_pat(p: node, q: node)
bare_pat(p, p) :- kind(p, k), k != "ref_pattern", k != "mut_pattern", child(_, p, _).
bare_pat(p, q) :- (kind(p, "ref_pattern") ; kind(p, "mut_pattern")), child(p, c, _), kind(c, k),
    k != "mutable_specifier", bare_pat(c, q).

.decl rest_pat(p: node, r: node)
rest_pat(p, r) :- (kind(p, "tuple_pattern") ; kind(p, "tuple_struct_pattern") ; kind(p, "slice_pattern")),
    child(p, r, _), kind(r, "remaining_field_pattern").

// A `_` element is `_` written as a whole element: `(_,`, `, _,`, `, _)`. `&_`, `x @ _` and `_ | 0` are other
// patterns. Elements are p's named children (comments aside) and its own `_` tokens, in source order (elem_*).
.decl wild_before(x: loc, w: span)
wild_before(x, w) :- elem_loc(p, i, x), elem_wild(p, i - 1, w).
.decl wild_after(x: loc, w: span)
wild_after(x, w) :- elem_loc(p, i, x), elem_wild(p, i + 1, w).

// `c: _` has a name and no pattern node: its `_` is no node, and the tape keeps it nowhere.
.decl wild_field(f: node)
wild_field(f) :- kind(f, "field_pattern"), field(f, "name", n), !kind(n, "shorthand_field_identifier"),
    !field(f, "pattern", _).

.decl paren_pat(p: node, q: node)
// With one named child and no `_`, a `,` can only be the trailing comma `(q,)`, which the tape stores.
.stored paren_pat "a tuple_pattern of one named child and no `_` has a comma only as its trailing comma, which the tape stores"
paren_pat(p, q) :- kind(p, "tuple_pattern"), child(p, q, 0), !child(p, _, 1), !op(p, ","), !op(p, "_").
.decl unparen(p: node, q: node)
unparen(p, p) :- child(_, p, _), !paren_pat(p, _).
unparen(p, q) :- paren_pat(p, r), unparen(r, q).

// Clippy's pattern lints visit these; `for` patterns are not among them.
.decl top_pattern(p: node)
top_pattern(p) :- (kind(s, "let_declaration") ; kind(s, "let_condition") ; kind(s, "parameter")),
    field(s, "pattern", p).
top_pattern(p) :- kind(m, "match_pattern"), child(m, p, 0), !field(m, "condition", p).
top_pattern(p) :- kind(c, "closure_parameters"), child(c, p, _), !kind(p, "parameter").

// Elements, in source order: p's named children (comments and a tuple struct's path aside) and p's own `_`
// tokens, which the tape keeps (a `_` is one of the grammar's pattern choices): `(_, 1)` has two.
.decl seq_pat(p: node, open: span)   // p's elements follow token `open`: `(`, `[`, or `S(`
seq_pat(p, o) :- (kind(p, "tuple_pattern"), !paren_pat(p, _) ; kind(p, "slice_pattern")), first_token(p, o).
seq_pat(p, o) :- kind(p, "tuple_struct_pattern"), field(p, "type", t), token_after(t, o).
.decl elem_child(p: node, c: node)
elem_child(p, c) :- seq_pat(p, _), child(p, c, _), kind(c, k), !comment_kind(k), !field(p, "type", c).
.decl elem_pos(p: node, s: number)   // an element of p starts at offset s
elem_pos(p, s) :- elem_child(p, c), node(_, c, _, s, _).
elem_pos(p, s) :- seq_pat(p, _), (kind(p, "tuple_pattern") ; kind(p, "slice_pattern") ; kind(p, "tuple_struct_pattern")),
    token(p, _, "_", s, _).
.decl elem_index(p: node, s: number, i: number)
elem_index(p, s, i) :- elem_pos(p, s), i = count : { elem_pos(p, t), t < s }.
.decl elem_node(p: node, i: number, c: node)
elem_node(p, i, c) :- elem_child(p, c), node(_, c, _, s, _), elem_index(p, s, i).
.decl elem_is_wild(p: node, i: number)
elem_is_wild(p, i) :- (kind(p, "tuple_pattern") ; kind(p, "slice_pattern") ; kind(p, "tuple_struct_pattern")),
    token(p, _, "_", s, _), elem_index(p, s, i).
// The `_` token itself, a span to report at: the token after the opener, or after the separator that follows
// the element before. The tape keeps the tokens beside a `_` (its separators and brackets) with it.
.decl elem_wild(p: node, i: number, w: span)
elem_wild(p, 0, w) :- elem_is_wild(p, 0), seq_pat(p, o), token_after(o, w).
elem_wild(p, i, w) :- elem_is_wild(p, i), i > 0, elem_loc(p, i - 1, x), token_after(x, k), token_after(k, w).
.decl elem_loc(p: node, i: number, x: loc)
elem_loc(p, i, c) :- elem_node(p, i, c).
elem_loc(p, i, w) :- elem_wild(p, i, w).
.decl elem_key(p: node, i: number, k: symbol, rest: number)
elem_key(p, i, k, r) :- elem_node(p, i, c), unparen(c, q), text(q, s), k = @replace_all(s, "\\s+", ""),
    (kind(q, "remaining_field_pattern"), r = 1 ; !kind(q, "remaining_field_pattern"), r = 0).
elem_key(p, i, "_", 0) :- elem_is_wild(p, i).
.decl elem_count(p: node, n: number)
elem_count(p, n) :- seq_pat(p, _), n = count : { elem_pos(p, _) }.
