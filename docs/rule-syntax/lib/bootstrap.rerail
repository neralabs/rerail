// bootstrap: phase 0, the loading of rule files (t23, t25). The engine starts from its builtin facts, runs this
// program over `.rerail` documents, and ends at a fixed point where every module a program includes is loaded.
//
// A rule file is loaded like any document: by `load(path, name, "rr")`, answered by the engine's loader, so its
// source and tape are stored and memoised as a source's are, and it is checked by `stat` on the next run. Each loaded
// file's `#include`s are facts of its tree (`include` nodes), which ask for further loads, until none is new.
//
// The builtin facts, from the engine:
//   env("rerail.lib", dir)   the library directory (a root the loader may read)
//   p0_text(t)               a program text t ("text:<k>"), which is not a file
//   p0_t_shape(t)            text t is in T's shape (it declares `doc`): it gets no `core.rerail`
//   p0_ask(t, at, name)      text t includes `name` at offset `at`
//   env("rerail.program_dir", dir)   a program file's directory (a root the loader may read)
//   p0_file(path)            a program file the engine was given: it is loaded, and named `core.rerail` first unless it
//                            is in T's shape (`p0_file_t_shape`, known once it is loaded)
//
// The outputs, which the engine reads to assemble each program from its stored modules:
//   p0_include(from, at, name, path)   `from` (a text, or a module's path) includes `name` at `at`: the file `path`
//   p0_missing(from, at, name)          no file is `name` for `from`
//   p0_absent(path)                     a candidate that is not there: a file appearing there changes the graph
//   p0_phase(from, phase, path)         `from` declares a relation of phase program `phase` (`<phase>__<export>`):
//                                       its candidate `path`, loaded as an include is when it is there (`p0_absent`
//                                       names it when not)
//   p0_scope(m, s), p0_module_rank(m, k), p0_module_key(m, key)
//                                       the module plan (decision 0639 §1, below): module `m` is lowered against the
//                                       modules `s`, ranks `k`, and is kept under `key`
//   p0_module_lowered(key, image)       the module of `key` lowered, its image's digest (the engine's answer)
//   p0_tail_key(m, t), p0_module_tailed(t, image)
//                                       module `m`'s tail is kept under `t`; the module of tail key `t` tailed, its
//                                       image's digest (the engine's answer, decision 0639 §6a)
//
// One more builtin fact: env("rerail.build", b), the engine's build, which a module's key names.
//
// A phase program is a rule file of every run that reads its exports, as an include is: the whole-run cutoff names
// them all (O-cutoff-phases, decision 0246). So phase 0 resolves them too, and nothing parses a module again to list
// them. Two more builtin facts:
//   env("rerail.phase_lib", dir)  the engine's phase programs' directory (a root the loader may read)
//   p0_text_phase(t, phase)       text t declares a relation of phase `phase` (its own phase's are not asked)
#include "core.rerail"
.language rr

.decl p0_lib(dir: symbol)
.decl p0_text(t: symbol)
.decl p0_t_shape(t: symbol)
.decl p0_ask(t: symbol, at: number, name: symbol)
.decl p0_file(path: symbol)
p0_lib(l) :- env("rerail.lib", l).
load(f, f, "rr") :- p0_file(f).
// A load returns its canonical path. Its module column preserves the path the include requested.
// Resolve children once per canonical document and report the edges for every spelling used to reach it.
.decl p0_alias(canonical: symbol, requested: symbol)
p0_alias(f, p) :- loaded(f, p, "rr"), !env("rerail.windows_paths", "1"), f != p.
p0_alias(f, p) :- loaded(native, p, "rr"), env("rerail.windows_paths", "1"), f = @replace_all(native, "\\\\", "/"), f != p.
.decl p0_doc(d: number, path: symbol)
p0_doc(d, f) :- doc(d, f, _), !env("rerail.windows_paths", "1").
p0_doc(d, @replace_all(f, "\\\\", "/")) :- doc(d, f, _), env("rerail.windows_paths", "1").
// What each document says, made per document (the request cone reads no base relation): its includes, and whether
// it declares `doc` (T's shape).
// (Each is located by its node: a loaded document's rows reach the requests by their nodes' document.)
.decl p0_names(i: node, f: symbol, at: number, name: symbol)
p0_names(i, f, at, n) :- kind(i, "include"), field(i, "path", p), str(p, n), docof(i, d), p0_doc(d, f), node(d, i, _, at, _).
.decl p0_declares_doc(i: node, f: symbol)
p0_declares_doc(i, f) :- kind(i, "declaration"), field(i, "name", n), text(n, "doc"), docof(i, d), p0_doc(d, f).
// By path, across the loaded documents (decision 0652).
.decl p0_file_t_shape(path: symbol) cross_file
p0_file_t_shape(f) :- p0_file(f), p0_declares_doc(_, f).

// What each text and each loaded module names. A text names `core.rerail` first unless it is in T's shape.
// The engine requests components.rerail as a file seed only when a program consumes its relations.
// Each text or module by its path: includes resolve across files (decision 0652).
.decl p0_from(from: symbol, at: number, name: symbol) cross_file
p0_from(t, at, n) :- p0_ask(t, at, n).
p0_from(t, -1, "core.rerail") :- p0_text(t), !p0_t_shape(t).
p0_from(f, -1, "core.rerail") :- p0_file(f), loaded(_, f, "rr"), !p0_file_t_shape(f).
p0_from(f, at, n) :- p0_names(_, f, at, n).

// The candidates, in order: the library, then (for a module) the file's own directory.
.decl p0_cand(from: symbol, at: number, name: symbol, rank: number, path: symbol)
p0_cand(f, at, n, 1, c) :- p0_from(f, at, n), p0_lib(l), c = cat(l, "/", n).
// A module's path is the engine's, so its directory ends at either separator (Windows names it with `\`).
p0_cand(f, at, n, 2, c) :- p0_from(f, at, n), !p0_text(f), f != "engine", match("(?<dir>.*)[/\\\\][^/\\\\]*", f), c = cat(dir, "/", n).

// Each candidate's directory is listed, asked by the directory alone (`rr::lower`'s world demand).
.decl p0_split(c: symbol, dir: symbol, base: symbol)
p0_split(c, dir, base) :- p0_cand(_, _, _, _, c), match("(?<dir>.*)/(?<base>[^/]*)", c).
.decl p0_listed(dir: symbol)
p0_listed(dir) :- p0_split(_, dir, _), dir_entry(dir, _, _).
.decl p0_exists(c: symbol)
p0_exists(c) :- p0_split(c, dir, base), dir_entry(dir, base, 0).

// The first candidate that exists.
.decl p0_before(from: symbol, at: number, name: symbol, rank: number)
p0_before(f, at, n, r) :- p0_cand(f, at, n, q, c), p0_exists(c), p0_cand(f, at, n, r, _), q < r.
.decl p0_resolved(from: symbol, at: number, name: symbol, path: symbol)
p0_resolved(f, at, n, c) :- p0_cand(f, at, n, r, c), p0_exists(c), !p0_before(f, at, n, r).
.decl p0_found(from: symbol, at: number, name: symbol)
p0_found(f, at, n) :- p0_resolved(f, at, n, _).
load(c, c, "rr") :- p0_resolved(_, _, _, c).

// The phase programs a module's declarations name: `<phase>__<export>`, where `<phase>` has no `__` and is no
// typing program's or the engine's own (`typing_`, `rr_`), found in the phase programs' directory, loaded as an
// include is, so its includes and the phases it names follow.
.decl p0_decl(i: node, f: symbol, name: symbol)
p0_decl(i, f, s) :- kind(i, "declaration"), field(i, "name", n), text(n, s), match(".+__.+", s), docof(i, d), p0_doc(d, f).
.decl p0_text_phase(t: symbol, phase: symbol)
.decl p0_phase_named(from: symbol, phase: symbol) cross_file   // by path, as p0_from (decision 0652)
p0_phase_named(f, p) :- p0_decl(_, f, s), match("(?<p>[^_]+(?:_[^_]+)*)__.+", s), !prefix("typing_", p), !prefix("rr_", p).
p0_phase_named(t, p) :- p0_text_phase(t, p).
.decl p0_phase_lib(dir: symbol)
p0_phase_lib(l) :- env("rerail.phase_lib", l).
.decl p0_phase_cand(from: symbol, phase: symbol, path: symbol)
p0_phase_cand(f, p, c) :- p0_phase_named(f, p), p0_phase_lib(l), c = cat(l, "/", p, ".rerail").
p0_split(c, dir, base) :- p0_phase_cand(_, _, c), match("(?<dir>.*)/(?<base>[^/]*)", c).
load(c, c, "rr") :- p0_phase_cand(_, _, c), p0_exists(c).
.decl p0_phase(from: symbol, phase: symbol, path: symbol)
p0_phase(f, p, c) :- p0_phase_cand(f, p, c).
p0_phase(a, p, c) :- p0_alias(f, a), p0_phase_cand(f, p, c).

// The outputs, once the loads are done.
.decl p0_include(from: symbol, at: number, name: symbol, path: symbol)
p0_include(f, at, n, c) :- p0_resolved(f, at, n, c).
p0_include(a, at, n, c) :- p0_alias(f, a), p0_resolved(f, at, n, c).
.decl p0_missing(from: symbol, at: number, name: symbol)
p0_missing(f, at, n) :- p0_from(f, at, n), !p0_found(f, at, n).
p0_missing(a, at, n) :- p0_alias(f, a), p0_from(f, at, n), !p0_found(f, at, n).
.decl p0_absent(path: symbol)
p0_absent(c) :- p0_split(c, _, _), !p0_exists(c).

// The module plan (decision 0639 §1): which files form each module, its scope, its rank and its key, derived from
// the include edges between loaded files and each file's digest. A module is lowered once against its scope and kept
// as its image under its key; a program is linked from its modules' images in rank order.
//
// A module of a program outside T's shape has `core.rerail` in its scope, though no file names it (a file is read
// with `core.rerail` first). A program in T's shape declares `doc` itself and reads its files without it. So each file
// reached is planned in the variant of the seeds that reach it, `core` or `bare`, and a module's name says which.
.decl p0_canon(requested: symbol, canonical: symbol)
p0_canon(c, f) :- loaded(f, c, "rr"), !env("rerail.windows_paths", "1").
p0_canon(c, f) :- loaded(native, c, "rr"), env("rerail.windows_paths", "1"), f = @replace_all(native, "\\\\", "/").
// A file's includes, between canonical paths.
.decl p0_includes(a: symbol, b: symbol)
p0_includes(a, b) :- p0_resolved(a, _, _, c), p0_canon(c, b), a != b.
.decl p0_seed_variant(s: symbol, w: symbol)
p0_seed_variant(t, "core") :- p0_text(t), !p0_t_shape(t).
p0_seed_variant(t, "bare") :- p0_text(t), p0_t_shape(t).
p0_seed_variant(f, "core") :- p0_file(f), !p0_file_t_shape(f).
p0_seed_variant(f, "bare") :- p0_file(f), p0_file_t_shape(f), !p0_core(f).
// `core.rerail` declares `doc`, but read with itself first is itself: a seed of its own, it is the module the
// programs that read it have in their scope.
p0_seed_variant(f, "core") :- p0_file(f), p0_core(f).
// The files a seed reaches by its includes, and a file seed of the library or the phase programs itself: it is a
// module of the programs that include it (a store's template plans them all). A program file of the run's own is a
// program's text, no module (decision 0639 §2).
.decl p0_seed_reaches(s: symbol, f: symbol)
p0_seed_reaches(f, f) :- p0_file(f), loaded(_, f, "rr"), p0_lib(l), d = cat(l, "/"), prefix(d, f).
p0_seed_reaches(f, f) :- p0_file(f), loaded(_, f, "rr"), p0_phase_lib(l), d = cat(l, "/"), prefix(d, f).
p0_seed_reaches(s, f) :- p0_seed_variant(s, _), p0_resolved(s, _, _, c), p0_canon(c, f).
p0_seed_reaches(s, b) :- p0_seed_reaches(s, a), p0_includes(a, b).
.decl p0_variant(w: symbol, f: symbol)
p0_variant(w, f) :- p0_seed_variant(s, w), p0_seed_reaches(s, f).
.decl p0_digest(f: symbol, d: symbol)
p0_digest(f, d) :- p0_variant(_, f), file_digest(f, d).
.decl p0_core(f: symbol)
p0_core(f) :- p0_lib(l), c = cat(l, "/core.rerail"), p0_canon(c, f).
.decl p0_edge(w: symbol, a: symbol, b: symbol)
p0_edge(w, a, b) :- p0_variant(w, a), p0_includes(a, b), p0_digest(b, _).
p0_edge("core", a, k) :- p0_variant("core", a), p0_core(k), p0_digest(k, _), a != k.
.decl p0_reaches(w: symbol, a: symbol, b: symbol)
p0_reaches(w, a, b) :- p0_edge(w, a, b).
p0_reaches(w, a, c) :- p0_reaches(w, a, b), p0_edge(w, b, c).
// A module: a file with the files that reach it and that it reaches. Its name is its variant and its members'
// digests, in order.
.decl p0_member(w: symbol, p: symbol, q: symbol)
p0_member(w, p, p) :- p0_variant(w, p), p0_digest(p, _).
p0_member(w, p, q) :- p0_reaches(w, p, q), p0_reaches(w, q, p).
.decl p0_module_of(w: symbol, p: symbol, m: symbol)
p0_module_of(w, p, m) :- p0_variant(w, p), p0_digest(p, _), j = join d by d sep "+" : { p0_member(w, p, q), p0_digest(q, d) }, m = cat(w, ":", j).
// Its closure: its own files and every file they reach.
.decl p0_closure(w: symbol, m: symbol, q: symbol)
p0_closure(w, m, q) :- p0_module_of(w, p, m), p0_member(w, p, q).
p0_closure(w, m, q) :- p0_module_of(w, p, m), p0_reaches(w, p, q).
.decl p0_scope(m: symbol, s: symbol)
p0_scope(m, s) :- p0_closure(w, m, q), p0_module_of(w, q, s), s != m.
// Its rank: the files of its closure. A module ranks above every module in its scope.
.decl p0_module_rank(m: symbol, reached: number)
p0_module_rank(m, k) :- p0_module_of(w, _, m), k = count : { p0_closure(w, m, _) }.
// A scope's file by its interface (decision 0639 §4, `core.rerail`'s `file_interface`, the file system's answer): its
// statements less its rules' bodies and its includes, all a module lowered against it reads of it (T9).
// Each file of a module's closure as its key names it: its own files by their bytes, its scope's by their interface,
// so an edit of a rule's body in its scope leaves its key, and its image, as they were.
.decl p0_key_digest(m: symbol, q: symbol, d: symbol)
p0_key_digest(m, q, d) :- p0_closure(w, m, q), p0_module_of(w, q, m), p0_digest(q, d).
p0_key_digest(m, q, d) :- p0_closure(w, m, q), p0_module_of(w, q, s), s != m, file_interface(q, d).
// Its key: the engine's build, its name, and its closure's digests and edges, each in order. A key reads digests, not
// other keys, so no recursion runs through an aggregate.
.decl p0_closure_digests(m: symbol, ds: symbol)
p0_closure_digests(m, ds) :- p0_module_rank(m, _), ds = join d by d sep "," : { p0_key_digest(m, _, d) }.
.decl p0_edge_text(m: symbol, e: symbol)
p0_edge_text(m, e) :- p0_closure(w, m, a), p0_edge(w, a, b), p0_key_digest(m, a, da), p0_key_digest(m, b, db), e = cat(da, ">", db).
.decl p0_closure_edges(m: symbol, es: symbol)
p0_closure_edges(m, es) :- p0_module_rank(m, _), es = join e by e sep "," : { p0_edge_text(m, e) }.
.decl p0_module_key(m: symbol, key: symbol)
p0_module_key(m, @sha256(cat(b, "|", m, "|", ds, "|", es))) :- env("rerail.build", b), p0_closure_digests(m, ds), p0_closure_edges(m, es).

// Each module's lowering, asked of the engine (decision 0639 §3): its key, its rank, its files by path in its name's
// order, its scope's keys and its scope's files. The engine answers a wave's requests in rank order, each against the
// images of its scope, which rank below it: so every module is asked at once, and one pause of the fixpoint answers
// them all. The answer is the digest of the module's image, kept in the image store under the module's key.
.decl p0_module_files(m: symbol, fs: symbol)
p0_module_files(m, fs) :- p0_module_rank(m, _), fs = join f by d sep "\n" : { p0_module_of(_, f, m), p0_digest(f, d) }.
.decl p0_scope_keys(m: symbol, ks: symbol)
p0_scope_keys(m, ks) :- p0_module_rank(m, _), ks = join k by k sep "," : { p0_scope(m, s), p0_module_key(s, k) }.
// The files its scope's modules hold, by path: a file adds no rules or facts to their relations but the `extensible`
// ones (decision 0263), which the engine checks of the module's files against theirs.
.decl p0_scope_file(m: symbol, f: symbol, d: symbol)
p0_scope_file(m, f, d) :- p0_closure(w, m, f), p0_module_of(w, f, s), s != m, p0_digest(f, d).
.decl p0_scope_files(m: symbol, fs: symbol)
p0_scope_files(m, fs) :- p0_module_rank(m, _), fs = join f by d sep "\n" : { p0_scope_file(m, f, d) }.
.decl p0_lower_req(key: symbol, rank: number, files: symbol, scope: symbol, reached: symbol)
p0_lower_req(k, r, fs, ks, rs) :- p0_module_key(m, k), p0_module_rank(m, r), p0_module_files(m, fs), p0_scope_keys(m, ks), p0_scope_files(m, rs).
.decl p0_module_lowered(key: symbol, image: symbol)
.answer p0_lower_req -> p0_module_lowered

// Each module's tail, asked of the engine (decision 0639 §6a): the tail's steps less the downward ones, over its
// scope's tails and its image, kept under a key of its own. The steps read its scope's rules, not only their
// interfaces (a context's instances copy them), so the key names its scope's files by their bytes: an edit of a
// rule's body in its scope tails it again, and lowers nothing again. Its request holds its lowering's, so the engine
// lowers it first where its lowering is not yet answered, its scope's tail keys, and its scope's keys in link order
// (by rank, then name), which its tail links them in as a whole library's tail does. It answers in rank order.
.decl p0_scope_digests(m: symbol, ds: symbol)
p0_scope_digests(m, ds) :- p0_module_rank(m, _), ds = join d by d sep "," : { p0_scope_file(m, _, d) }.
.decl p0_tail_key(m: symbol, t: symbol)
p0_tail_key(m, @sha256(cat("tail|", k, "|", ds))) :- p0_module_key(m, k), p0_scope_digests(m, ds).
.decl p0_scope_tails(m: symbol, ts: symbol)
p0_scope_tails(m, ts) :- p0_module_rank(m, _), ts = join t by t sep "," : { p0_scope(m, s), p0_tail_key(s, t) }.
.decl p0_scope_order(m: symbol, ks: symbol)
p0_scope_order(m, ks) :- p0_module_rank(m, _), ks = join k by (r, s) sep "," : { p0_scope(m, s), p0_module_rank(s, r), p0_module_key(s, k) }.
.decl p0_tail_req(tail: symbol, rank: number, key: symbol, files: symbol, scope: symbol, reached: symbol, scope_tails: symbol, linked: symbol)
p0_tail_req(t, r, k, fs, ks, rs, ts, os) :- p0_tail_key(m, t), p0_module_key(m, k), p0_lower_req(k, r, fs, ks, rs), p0_scope_tails(m, ts), p0_scope_order(m, os).
.decl p0_module_tailed(tail: symbol, image: symbol)
.answer p0_tail_req -> p0_module_tailed

.output p0_include, p0_missing, p0_absent, p0_phase, p0_scope, p0_module_rank, p0_module_key, p0_module_lowered, p0_tail_key, p0_module_tailed
