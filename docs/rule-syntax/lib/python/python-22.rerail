// python/python-22: imported calls inside string type definitions, for Ruff's PTH201-PTH205 checks.
//
// Interface
//   p22_call(c, q, f)                 c calls imported qualified name q; f is the callee without parentheses
//   p22_call_only(c, a)               c has one positional argument a and no keywords
//   p22_single_arg(c, q, x, f, a)     p22_call for q with exactly one argument a, positional or keyword x
//   p22_unparen(e, m)                 m is parsed-tree expression e without parentheses
//   p22_plain_str(e, v)               e is a plain str literal in a parsed tree, with decoded value v
//
// Ruff parses strings used as types and checks their expressions as code. Relations that enumerate a file tree do
// not enumerate these fragment trees, so each relation below stays rooted in typedef_node. For example:
//   a: "List['Path(\".\")']"                    p22_call(<Path(".")>, "pathlib.Path", <Path>)
//   b: "List['os.path.getsize(p)']"             p22_single_arg(..., "filename", ..., <p>)
//   c: "List['os.path.getatime(p)']"            p22_single_arg(...)
//   d: "List['os.path.getmtime(p)']"            p22_single_arg(...)
//   e: "List['os.path.getctime(p)']"            p22_single_arg(...)
#include "python/python-01.rerail"   // typedef_node

// Parentheses in a fragment tree cannot use file-tree unparen rows.
.decl p22_unparen(e: node, m: node)
p22_unparen(e, e) :- typedef_node(e), kind(e, k), k != "parenthesized_expression".
p22_unparen(e, m) :- typedef_node(e), kind(e, "parenthesized_expression"), child(e, i, _),
    !kind(i, "comment"), p22_unparen(i, m).

// Resolve an imported identifier from the scope containing the outermost annotation string, then carry its
// qualified name through an attribute chain. A non-import binding before the string shadows the import, as it does
// for an ordinary expression.
.decl p22_name(n: node, x: symbol)
p22_name(n, x) :- typedef_node(n), kind(n, "identifier"), text(n, x), !field(_, "attribute", n), !field(_, "name", n).
.decl p22_start(n: node, s: node)
p22_start(n, s) :- p22_name(n, _), parsed_in(n, h), nearest(h, s, lscope), kind(s, k), scope(k).
p22_start(n, c) :- p22_name(n, _), parsed_in(n, h), nearest(h, c, lscope), kind(c, k), comp_scope(k).
.decl p22_walk(n: node, x: symbol, s: node)
p22_walk(n, x, s) :- p22_name(n, x), p22_start(n, s).
p22_walk(n, x, p) :- p22_walk(n, x, s), !bound_in(s, x), nearest(s, p, lfscope).
.decl p22_look(n: node, x: symbol, s: node)
p22_look(n, x, s) :- p22_walk(n, x, s), bound_in(s, x).
.decl p22_qn(n: node, q: symbol)
p22_qn(n, q) :- p22_look(n, x, s), ibind(s, x, q).
p22_qn(n, @dot(q, a)) :- typedef_node(n), kind(n, "attribute"), field(n, "object", o),
    field(n, "attribute", at), text(at, a), p22_qn(o, q).
.decl p22_root(n: node, r: node)
p22_root(n, n) :- typedef_node(n), kind(n, "identifier").
p22_root(n, r) :- typedef_node(n), kind(n, "attribute"), field(n, "object", o), p22_root(o, r).
.decl p22_rebound(r: node)
p22_rebound(r) :- p22_look(r, x, s), parsed_in(r, h), binding(s, x, b, form), form != "import", b < h,
    count : { binding(s, x, a, "import"), b < a, a < h } = 0.
.decl p22_qual(e: node, q: symbol)
p22_qual(e, q) :- p22_unparen(e, m), p22_qn(m, q), p22_root(m, r), !p22_rebound(r).

.decl p22_call(c: node, q: symbol, f: node)
p22_call(c, q, f) :- typedef_node(c), kind(c, "call"), field(c, "function", g), p22_unparen(g, f), p22_qual(f, q).

// One written argument. Comments and line continuations do not count. A splat counts toward the length but cannot
// supply the named parameter, matching Ruff's Arguments::find_argument_value.
.decl p22_item(c: node, a: node, j: number)
p22_item(c, a, j) :- typedef_node(c), kind(c, "call"), field(c, "arguments", al), child(al, a, j),
    kind(a, k), k != "comment", k != "line_continuation".
.decl p22_one_pos(c: node, a: node)
p22_one_pos(c, a) :- p22_item(c, a, _), kind(a, k), k != "keyword_argument", k != "list_splat",
    k != "dictionary_splat", count : { p22_item(c, _, _) } = 1.
.decl p22_one_kw(c: node, x: symbol, a: node)
p22_one_kw(c, x, a) :- p22_item(c, k, _), kind(k, "keyword_argument"), field(k, "name", n), text(n, x),
    field(k, "value", a), count : { p22_item(c, _, _) } = 1.
.decl p22_one_gen(c: node, a: node)
p22_one_gen(c, a) :- typedef_node(c), kind(c, "call"), field(c, "arguments", a), kind(a, "generator_expression").
.decl p22_call_only(c: node, a: node)
p22_call_only(c, a) :- p22_one_pos(c, a).
p22_call_only(c, a) :- p22_one_gen(c, a).
.decl p22_single_arg(c: node, q: symbol, x: symbol, f: node, a: node)
p22_single_arg(c, q, x, f, a) :- x = "filename", p22_call(c, q, f), p22_one_pos(c, v), p22_unparen(v, a).
p22_single_arg(c, q, x, f, a) :- p22_call(c, q, f), p22_one_kw(c, x, v), p22_unparen(v, a).
p22_single_arg(c, q, x, f, a) :- x = "filename", p22_call(c, q, f), p22_one_gen(c, a).

.decl p22_str_piece(e: node, v: symbol)
p22_str_piece(e, v) :- typedef_node(e), kind(e, "string"), str(e, v), strprefix(e, p),
    (p = "" ; p = "r" ; p = "u" ; p = "ru" ; p = "ur").
.decl p22_bad_str_part(e: node)
p22_bad_str_part(e) :- typedef_node(e), kind(e, "concatenated_string"), child(e, p, _), !kind(p, "comment"),
    !p22_str_piece(p, _).
.decl p22_plain_str(e: node, v: symbol)
p22_plain_str(e, v) :- p22_str_piece(e, v).
p22_plain_str(e, v) :- typedef_node(e), kind(e, "concatenated_string"), !p22_bad_str_part(e),
    v = join x by i sep "" : { child(e, s, i), p22_str_piece(s, x) }.
