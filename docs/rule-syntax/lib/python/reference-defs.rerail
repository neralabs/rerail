// python/reference-defs: each Python definition's symbol (reference_def, core.rerail), which the reference graph is
// keyed by across files (decision 0677). Both graphs take it: the rules' (python/references.rerail) and W's Rust one
// (python/references_w.rerail), so a program reads the same symbols either way.
//
// The program's `.references` setting reaches the rules as facts the engine gives (python/references.rerail's head
// names them): its scope says which documents are the graph's.
#include "python/names.rerail"

.decl references_given(k: number)
.decl references_include(g: symbol)
.decl references_exclude(g: symbol)
.decl references_sibling(i: number, decorator: symbol, name: symbol, rename: symbol, by: symbol)
.decl references_field(rename: symbol, by: symbol)

// ---- definitions --------------------------------------------------------------------------------------------------
// rf_dc: the kinds that make a definition.
.decl rf_dc(kind: symbol)
rf_dc("function_definition"). rf_dc("class_definition").
// rf_def(f, x): f is a definition named x.
.decl rf_def(f: node, x: symbol)
rf_def(f, x) :- kind(f, k), rf_dc(k), field(f, "name", n), text(n, x).
// rf_module(d, m): the module W names document d by: its package module, from the corpus's `__init__.py` files; for a
// file outside every package, its stem (Ruff's, dots and all), which no relative import resolves from.
.decl rf_module(d: number, m: symbol)
rf_module(d, m) :- rf_pydoc(d, p), !unpackaged(d), doc(d, p, m).
rf_module(d, m) :- rf_pydoc(d, p), unpackaged(d), m = @rx_replace(@rx_replace(p, "^.*/", ""), "[.][^.]*$", ""), m != "".
// rf_pydoc(d, p): document d, at path p, is one of the graph's Python files: every one, or those the setting's scope
// holds.
.decl rf_pydoc(d: number, p: symbol)
rf_pydoc(d, p) :- doc(d, p, _), @rx_matches(p, "[.]pyi?$") = 1, !references_given(1).
rf_pydoc(d, p) :- doc(d, p, _), @rx_matches(p, "[.]pyi?$") = 1, references_given(1), references_include(g), glob(g, p),
    !rf_scope_out(d).
.decl rf_scope_out(d: number)
rf_scope_out(d) :- doc(d, p, _), references_exclude(g), glob(g, p).
// rf_qn(f, q): f's qualified name: the module, then each enclosing class, and `f.<locals>` for each enclosing
// function. `class C: def m` in pkg.mod is pkg.mod.C.m; a function g in function f is pkg.mod.f.<locals>.g.
.decl rf_qn(f: node, q: symbol)
rf_qn(f, q) :- rf_def(f, x), !nearest(f, _, rf_dc), docof(f, d), rf_module(d, m), q = @dot(m, x).
rf_qn(f, q) :- rf_def(f, x), nearest(f, s, rf_dc), kind(s, "class_definition"), rf_qn(s, p), q = @concat(p, ".", x).
rf_qn(f, q) :- rf_def(f, x), nearest(f, s, rf_dc), kind(s, "function_definition"), rf_qn(s, p),
    q = @concat(p, ".<locals>.", x).
// rf_start(n, s): node n starts at byte s.
.decl rf_start(n: node, s: number)
rf_start(n, s) :- node(_, n, _, s, _).
.decl rf_is_class(f: node)
rf_is_class(f) :- rf_def(f, _), kind(f, "class_definition").
.decl rf_is_function(f: node)
rf_is_function(f) :- rf_def(f, _), kind(f, "function_definition").
// rf_sym(f, s): definition f's symbol, which the cross-file part keys it by (decision 0677): its file's path, its
// qualified name, and how many of the file's definitions of that name start before it (`pkg/m.py:pkg.m.f#0`, the
// first). A definition moved within its file keeps it; its node does not.
.decl rf_sym(f: node, s: symbol)
rf_sym(f, s) :- rf_qn(f, q), docof(f, d), doc(d, p, _), rf_start(f, u),
    k = count : { rf_qn(g, q), docof(g, d), rf_start(g, v), v < u }, s = @concat(p, ":", q, "#", to_string(k)).
reference_def(f, s) :- rf_sym(f, s).
