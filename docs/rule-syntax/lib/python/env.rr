// python/env: the Python a run types against (t21 §2.1), from the run's settings (`env`).
//
// Settings, each optional:
//   python.typeshed   a typeshed checkout (its `stdlib/` and `stubs/`); without one, no standard library is read
//   python.version    "3.13": the interpreter's version, which `VERSIONS` and `sys.version_info` tests are decided by
//   python.venv       a virtual environment; without python.version, its `pyvenv.cfg` gives the version
//   python.platform   "linux", "darwin", "win32": what `sys.platform` tests are decided by
//
// It reads only relations both shapes have (`env`, `file_line`), so `calls.rr` (T's shape) and a `core.rr` rule
// include it alike.

// py_version(3, 13): the version, as numbers. Given, else the venv's (`version = 3.13.1`), else 3.13.
.decl py_version_text(v: symbol)
py_version_text(v) :- env("python.version", v).
py_version_text(v) :- !env("python.version", _), env("python.venv", e), f = cat(e, "/pyvenv.cfg"), file_line(f, _, l),
    match("version *= *(?<v>[0-9]+\\.[0-9]+).*", l).
.decl py_version(major: number, minor: number)
py_version(a, b) :- py_version_text(v), match("(?<x>[0-9]+)\\.(?<y>[0-9]+).*", v), a = to_number(x), b = to_number(y).
.decl py_default_version(major: number, minor: number)
py_default_version(3, 13).
py_version(a, b) :- py_default_version(a, b), !py_version_text(_).

.decl py_platform(p: symbol)
py_platform(p) :- env("python.platform", p).

// py_stdlib(dir): typeshed's standard library stubs; py_stubs(dir): its third-party stubs, one directory per
// distribution.
.decl py_stdlib(dir: symbol)
py_stdlib(d) :- env("python.typeshed", t), d = cat(t, "/stdlib").
.decl py_stubs(dir: symbol)
py_stubs(d) :- env("python.typeshed", t), d = cat(t, "/stubs").
