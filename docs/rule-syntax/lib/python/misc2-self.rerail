// python/misc2-self: whether `o` in `o._x` is the class's own instance or the class itself, as Ruff's flake8-self
// (SLF001) decides it: by spelling, by the binding in effect, by annotation and by initializer.
//
// Interface
//   slf_super(o)              o is a `super()` call
//   slf_receiver_name(o)      o is the name `self`, `cls` or `mcs`, whatever it is bound to
//   slf_bind(n, b)            name n reads binding b: in n's own scope the latest one before n (a later one in
//                             the same function does not exist yet), in an outer scope the last one (a function
//                             body runs after the module)
//   slf_own_class(o)          o names a class from inside that class's body or methods
//   slf_same_instance(o, e)   in attribute access e = `o.attr`, o holds an instance of the class around e: a
//                             method's first positional parameter (not a staticmethod's), a parameter annotated
//                             `Self` or with that class (`Foo`, `Foo[int]`, `Annotated[Foo, …]`), or a variable
//                             assigned `self` (a parameter), `cls()`, `mcs()`, `Foo()`, `Foo[T]()` or
//                             `super().__new__(…)`
//
//   class Foo:
//       def f(self, other: Foo):
//           other._x                     slf_same_instance(<other>, <other._x>): annotated with the class
//           Foo._y                       slf_own_class(<Foo>)
//       @staticmethod
//       def s(this): this._x             nothing: a staticmethod has no receiver
//
// Every relation here joins one file's nodes, as Ruff reads one file: names resolve through the file's own imports
// (typing's pyi_sym, not sym_of's re-exports), and a class name is matched as a symbol (slf_class_around), never as a
// pair of an annotation and an access. A relation pairing two nodes no rule ties to one file is evaluated over the
// whole corpus: SLF001 paired every `self` read as a parameter with every attribute access of every file (36 M pairs
// on 50 files of the Python real-code corpus) and ran past a 56 GB cap on its 1,644.
#include "python/ast.rerail"
#include "python/typing.rerail"   // pyi_sym

.decl slf_receiver_name(o: node)
slf_receiver_name(o) :- dotted_expr(o, x), (x = "self" ; x = "cls" ; x = "mcs").

.decl slf_super(o: node)
slf_super(o) :- kind(o, "call"), field(o, "function", f), dotted_expr(f, "super").
// slf_bind(n, b): the binding name n reads, in source order where it is n's own scope (a later assignment in
// the function does not count yet), and the last one where it is an outer scope (its body runs later). The
// `binding(s, x, b, _)` after each aggregate restates that b is one of s's bindings: it keeps b in n's file.
.decl slf_bind(n: node, b: node)
slf_bind(n, b) :- kind(n, "identifier"), look(n, x, s), nearest(n, s, lscope),
    b = max k : { binding(s, x, k, _), k < n, !within(n, k) }, binding(s, x, b, _).
slf_bind(n, b) :- kind(n, "identifier"), look(n, x, s), !nearest(n, s, lscope), b = max k : { binding(s, x, k, _) },
    binding(s, x, b, _).
// A class named in its own body or methods; also before any local binding of the name.
.decl slf_own_class(o: node)
slf_own_class(o) :- slf_bind(o, c), kind(c, "class_definition"), within(o, c).
slf_own_class(o) :- kind(o, "identifier"), text(o, x), !slf_bind(o, _), inside(o, c, "class_definition"),
    def_name(c, x).
.decl slf_same_instance(o: node, e: node)
// A method's first positional parameter (not a staticmethod's).
slf_same_instance(o, e) :- attr_of(e, o, _), slf_bind(o, p), sig_param(f, p, _, i, _, _, _), slf_positional(f, i),
    i = min j : { slf_positional(f, j) }, nearest(f, c, scope), kind(c, "class_definition"), !slf_static(f).
.decl slf_positional(f: node, i: number)
slf_positional(f, i) :- sig_param(f, _, _, i, k, _, _), (k = "posonly" ; k = "pos").
// A parameter annotated `Self`, or with the class around e.
slf_same_instance(o, e) :- attr_of(e, o, _), slf_bind(o, p), slf_param_ann(p, a), slf_self_type(a).
slf_same_instance(o, e) :- attr_of(e, o, _), slf_bind(o, p), slf_param_ann(p, a), slf_named_type(a, x),
    slf_class_around(e, x).
// A variable assigned an instance: of any class around it (slf_instance_value), or of the class named x.
slf_same_instance(o, e) :- attr_of(e, o, _), slf_bind(o, b), binding_value(b, v), unparen(v, m), slf_instance_value(m).
slf_same_instance(o, e) :- attr_of(e, o, _), slf_bind(o, b), binding_value(b, v), unparen(v, m), slf_class_call(m, x),
    slf_class_around(e, x).
.decl slf_static(f: node)
slf_static(f) :- decorator(f, d), pyi_sym(d, "builtins.staticmethod").
// slf_class_around(e, x): x is the name of a class around attribute access e.
.decl slf_class_around(e: node, x: symbol)
slf_class_around(e, x) :- attr_of(e, _, _), inside(e, c, "class_definition"), def_name(c, x).
// slf_param_ann(p, t): parameter p is annotated t (sig_param's annotation, as the parameter's `type` field).
.decl slf_param_ann(p: node, t: node)
slf_param_ann(p, t) :- sig_param(_, p, _, _, _, t, _), field(p, "type", t).
// slf_self_type(t) / slf_named_type(t, x): annotation t is `Self`, or names x: `x`, `x[int]`, `Annotated[x, …]`.
.decl slf_self_type(t: node)
slf_self_type(t) :- slf_ann_head(t, h), slf_self(h).
.decl slf_named_type(t: node, x: symbol)
slf_named_type(t, x) :- slf_ann_head(t, h), kind(h, "identifier"), text(h, x).
.decl slf_ann(t: node)
slf_ann(t) :- slf_param_ann(_, t).
slf_ann(t) :- kind(f, "call"), field(f, "function", t), kind(t, "subscript").
.decl slf_ann_head(t: node, h: node)
slf_ann_head(t, t) :- slf_ann(t).
slf_ann_head(t, h) :- slf_ann_head(t, m), (kind(m, "type") ; kind(m, "parenthesized_expression")), child(m, h, 0).
slf_ann_head(t, h) :- slf_ann_head(t, m), kind(m, "generic_type"), child(m, g, 0), !slf_annotated(g), h = g.
slf_ann_head(t, h) :- slf_ann_head(t, m), kind(m, "generic_type"), child(m, g, 0), slf_annotated(g),
    child(m, l, 1), child(l, h, 0).
slf_ann_head(t, h) :- slf_ann_head(t, m), kind(m, "subscript"), field(m, "value", g), !slf_annotated(g), h = g.
slf_ann_head(t, h) :- slf_ann_head(t, m), kind(m, "subscript"), field(m, "value", g), slf_annotated(g),
    field(m, "subscript", h).
.decl slf_annotated(g: node)
slf_annotated(g) :- (pyi_sym(g, "typing.Annotated") ; pyi_sym(g, "typing_extensions.Annotated")).
.decl slf_self(h: node)
slf_self(h) :- (pyi_sym(h, "typing.Self") ; pyi_sym(h, "typing_extensions.Self")).
// slf_instance_value(m): `self` (a parameter), `cls()`, `mcs()`, `Self()`, `Self[T]()`, `super().__new__(…)`.
.decl slf_instance_value(m: node)
slf_instance_value(m) :- kind(m, "identifier"), text(m, "self"), slf_bind(m, p), binding(_, _, p, "param").
slf_instance_value(m) :- kind(m, "call"), field(m, "function", f), slf_self_type(f).
slf_instance_value(m) :- kind(m, "call"), field(m, "function", f), kind(f, "identifier"),
    (text(f, "cls") ; text(f, "mcs") ; slf_self(f)).
slf_instance_value(m) :- kind(m, "call"), field(m, "function", f), attr_of(f, s, "__new__"), slf_super(s).
// slf_class_call(m, x): `x()` or `x[T]()`.
.decl slf_class_call(m: node, x: symbol)
slf_class_call(m, x) :- kind(m, "call"), field(m, "function", f), slf_named_type(f, x).
slf_class_call(m, x) :- kind(m, "call"), field(m, "function", f), kind(f, "identifier"), text(f, x).
