// pathlib's lexical normalization. '..' stays; exactly two leading slashes stay.
.decl pyp_input(n:number,raw:symbol)
.decl pyp_join(n:number,root:symbol,child:symbol)
pyp_input(n,p) :- pyp_join(n,_,p),prefix("/",p).
pyp_input(n,root) :- pyp_join(n,root,"").
pyp_input(n,cat(root,p)) :- pyp_join(n,root,p),p!="",!prefix("/",p),(root="/";root="//").
pyp_input(n,cat(root,"/",p)) :- pyp_join(n,root,p),p!="",!prefix("/",p),root!="/",root!="//".
.decl pyp_step(n:number,text:symbol)
pyp_step(n,cat("/",@replace_all(p,"/{2,}","/"))) :- pyp_input(n,p),prefix("//",p),!prefix("///",p).
pyp_step(n,@replace_all(p,"/{2,}","/")) :- pyp_input(n,p),!prefix("//",p).
pyp_step(n,@replace_all(p,"/{2,}","/")) :- pyp_input(n,p),prefix("///",p).
.decl pyp_clean(n:number,text:symbol)
pyp_clean(n,@replace_all(@replace_all(s,"(^|/)(?:\\./)+","$1"),"(^|/)\\.$","$1")) :- pyp_step(n,s).
.decl pyp_path(n:number,text:symbol)
pyp_path(n,"/") :- pyp_clean(n,"/").
pyp_path(n,"//") :- pyp_clean(n,"//").
pyp_path(n,@replace_all(s,"/$","")) :- pyp_clean(n,s),s!="",s!="/",s!="//".
pyp_path(n,".") :- pyp_clean(n,"").
