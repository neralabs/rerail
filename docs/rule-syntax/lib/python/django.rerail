// python/django: Django's models, querysets, transactions, views and settings, as the django-practice rules read
// them. Names resolve through imports (python/names' sym_of), so `from django.db import models` and
// `from django.db.models import ForeignKey` both reach "django.db.models.ForeignKey"; class bases resolve across the
// files of the run (class_base), so a model whose abstract base sits in another module is still a model.
//
// Interface
//   Models:        dj_model(c)                 class c is a Django model: it derives from django.db.models.Model or a
//                                              known model base (dj_model_base), through the run's classes, or its
//                                              body declares a model field (other than a query expression's
//                                              `output_field`)
//                  dj_field(c, x, call, t)     model c declares field x as `x = call`, a call of field class t (the
//                                              class's last name: "CharField", "ForeignKey", ...)
//                  dj_fk(c, x)                 field x of model c holds one related object (ForeignKey, OneToOneField,
//                                              ParentalKey), so `obj.x_id` holds its key
//                  dj_fk_class(t)              field class t (a dj_field's t) holds one related object
//                  dj_model_super(c, b)        class b of the run is among model c's bases, directly or not
//                  dj_has_field(c, x, call, t) as dj_field, for a field model c declares or inherits from a class of
//                                              the run among its bases
//                  dj_attname(c, a, call)      a row of model c holds field call's value in attribute a: the field's
//                                              name, and `x_id` for a ForeignKey or OneToOneField x
//                  dj_number_field(t)          field class t holds a number (IntegerField, DecimalField, ...)
//                  dj_model_method(c, f, x)    f is method x defined directly in model c's body
//   Querysets:     dj_manager(e)               e is `<X>.objects` (or `_default_manager`, `_base_manager`)
//                  dj_qs(e)                    e is a queryset written as a chain from a manager: `Book.objects`,
//                                              `Book.objects.filter(a=1).order_by("b")`, through dj_qs_method calls
//                  dj_qs_call(c, m)            call c is `<dj_qs>.m(...)`, any method m
//                  dj_qs_root(q, r)            queryset chain q starts at `r.objects`
//                  dj_qs_model(q, c)           queryset q is a chain from `M.objects`, M model class c of the run
//                  dj_qs_class(q, mq)          the same, by the class's qualified name mq
//                  dj_qs_has(q, m)             queryset chain q calls method m somewhere along it
//                  dj_row_method(m)            QuerySet method m returns one row: get, create, first, last, ...
//   Instances:     dj_fetch_call(c, mq)        call c fetches one row of model class mq: `M.objects….get()`, `aget()`
//                  dj_instance_class(r, h, mq) identifier r in scope h holds an instance of model class mq: `self` in
//                                              its method, or a name bound to `M(...)` or a fetch, awaited or not
//   Transactions:  dj_atomic(e)                e names django.db.transaction.atomic, bare or called
//                  dj_atomic_with(w, b)        with-statement w opens `transaction.atomic(...)`; b is its body
//                  dj_atomic_def(f)            function f is decorated with `@transaction.atomic` or `@atomic(...)`
//                  dj_in_atomic(n, a)          n runs inside atomic region a (a with-body or an atomic def), with no
//                                              nested def or class between them
//                  dj_region_stop(k)           the node kinds whose code runs later: def, lambda, class
//                  dj_atomic_like_with(w, b)   with-statement w calls a wrapper named like atomic; b is its body
//                  dj_in_transaction(n)        n runs in atomic (dj_in_atomic) or in a dj_atomic_like_with body
//                  dj_atomic_requests_value(v) v is the value a settings file gives ATOMIC_REQUESTS
//                  dj_atomic_requests()        some settings file sets ATOMIC_REQUESTS to the literal True
//   Side effects:  dj_side_effect(c, what)     call c enqueues a task or sends mail (`what` names it: ".delay()")
//                  dj_task_waits_for_commit(c) task call c goes through a task class whose delay/apply_async waits
//                                              for transaction.on_commit
//                  dj_dispatch_in_failing_handler(c)
//                                              side effect c is in an except handler that always re-raises
//                  dj_dispatch_result_used(c)  `r = c` and the function reads r afterwards
//   Views:         dj_view_class(c)            class c derives from django.views.View (generic views included) or a
//                                              Django REST framework view, through the run's classes; a class
//                                              deriving from their `…Mixin` classes alone is not one
//   Files:         dj_migration_doc(d)         document d is a migration: it defines `class Migration(...)` with a
//                                              django.db.migrations.Migration base
//                  dj_test_doc(d)              document d is test code: a tests/test/testing/unittests directory,
//                                              test_*.py, *_tests.py, *_test.py, tests.py, test.py or conftest.py
//                  dj_django_doc(d)            document d imports from django or rest_framework (`import django…`,
//                                              `from django… import …`, `from rest_framework… import …`)
//   Settings:      dj_settings(e)              e is django.conf.settings
//   Python tests:  py_truth(e)                 e is read only for its truth: an if/elif/while/assert test, a
//                                              conditional or comprehension `if`, `not e`, `bool(e)`, an and/or
//                                              operand of one of these
//                  py_empty_cmp(c, x)          comparison c holds exactly when the number x is 0, or exactly when it
//                                              is not: `x > 0`, `x == 0`, `1 <= x`, ...
//                  py_empty_test(x)            the number x is only tested for being 0: py_empty_cmp or py_truth
//                  py_no_args(c)               call c passes no argument: `qs.count()`
//                  py_reraising_handler(x)     every path through except clause x ends in `raise`
//
// Django background
//   - A manager attribute (`objects`) is the usual way into a queryset; custom managers and related managers
//     (`author.book_set`) are querysets too, but one file cannot tell them from other attributes, so dj_qs starts
//     only at the three manager names Django gives every model.
//   - transaction.atomic is a decorator and a context manager, bare or called: `@atomic`, `@atomic(using="x")`,
//     `with atomic():`. Code an atomic def calls is in the transaction too, which no relation here follows.
//   - A field's attname is the attribute its column value lives in: the field's name, except for a ForeignKey or
//     OneToOneField `author`, whose key is `author_id` (and `author` loads the related row).
//   e.g.  from django.db import models, transaction
//         class Book(models.Model):                     dj_model
//             author = models.ForeignKey(Author, ...)   dj_field(<Book>, "author", <call>, "ForeignKey"), dj_fk,
//                                                       dj_attname(<Book>, "author_id", <call>)
//         class Novel(Book): ...                        dj_has_field(<Novel>, "author", <call>, "ForeignKey")
//         Book.objects.filter(x=1).exists()             dj_qs(<Book.objects.filter(x=1)>), dj_qs_call(_, "exists"),
//                                                       dj_qs_model(<Book.objects.filter(x=1)>, <Book>)
//         with transaction.atomic():                    dj_atomic_with; its statements are dj_in_atomic
//         if Book.objects.count() > 0:                  py_empty_cmp(<the comparison>, <the count() call>)
#include "python/ast.rerail"
#include "python/calls.rerail"   // call_arg, posarg: its syntax helpers only

// ---- models ------------------------------------------------------------------------------------------------------
// dj_model_base(q): classes outside the run that are models: Django's own and common third-party bases.
.decl dj_model_base(q: symbol)
dj_model_base("django.db.models.Model"). dj_model_base("django.db.models.base.Model").
dj_model_base("django.contrib.auth.models.AbstractUser"). dj_model_base("django.contrib.auth.models.AbstractBaseUser").
dj_model_base("django.contrib.auth.base_user.AbstractBaseUser"). dj_model_base("django.contrib.auth.models.PermissionsMixin").
dj_model_base("django.contrib.auth.models.User"). dj_model_base("django.contrib.auth.models.Group").
dj_model_base("mptt.models.MPTTModel"). dj_model_base("polymorphic.models.PolymorphicModel").
dj_model_base("treebeard.mp_tree.MP_Node"). dj_model_base("treebeard.ns_tree.NS_Node").
dj_model_base("treebeard.al_tree.AL_Node"). dj_model_base("model_utils.models.TimeStampedModel").
dj_model_base("django_extensions.db.models.TimeStampedModel"). dj_model_base("wagtail.models.Page").
// dj_field_module(m): the modules model field classes are imported from (`models.CharField`, `JSONField`, ...).
.decl dj_field_module(m: symbol)
dj_field_module("django.db.models"). dj_field_module("django.db.models.fields").
dj_field_module("django.db.models.fields.related"). dj_field_module("django.db.models.fields.json").
dj_field_module("django.contrib.postgres.fields"). dj_field_module("django.contrib.gis.db.models").
dj_field_module("modelcluster.fields").
// dj_field_call(call, t): call constructs a model field of class t: a `…Field`, or a relation.
.decl dj_field_call(call: node, t: symbol)
dj_field_call(call, t) :- kind(call, "call"), field(call, "function", f), sym_of(f, q), split_dot(q, m, t),
    dj_field_module(m), (suffix("Field", t) ; dj_relation_class(t)).
.decl dj_relation_class(t: symbol)
dj_relation_class("ForeignKey"). dj_relation_class("OneToOneField"). dj_relation_class("ManyToManyField").
dj_relation_class("ParentalKey"). dj_relation_class("ParentalManyToManyField").
// dj_fk_class(t): the relation classes that hold one related object, whose key the row keeps in `<name>_id`.
.decl dj_fk_class(t: symbol)
dj_fk_class("ForeignKey"). dj_fk_class("OneToOneField"). dj_fk_class("ParentalKey").
// dj_class_field(c, x, call, t): class c's body has `x = call` (or `x: T = call`) with call a field of class t.
.decl dj_class_field(c: node, x: symbol, call: node, t: symbol)
dj_class_field(c, x, call, t) :- kind(c, "class_definition"), field(c, "body", b), body_stmt(b, s, _),
    kind(s, "expression_statement"), child(s, a, 0), kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"),
    text(l, x), field(a, "right", call), dj_field_call(call, t).
// dj_model_q(q): q names a model class: a known base, or a class of the run with a model class among its bases. A
// linear closure seeded from the bases: python/names' subclass is a quadratic one over every class of the run,
// which does not finish on a large repository.
.decl dj_model_q(q: symbol)
dj_model_q(q) :- dj_model_base(q).
dj_model_q(q) :- class_def(c, q), class_base(c, b), dj_model_q(b).
// dj_expression(c): class c is a query expression, which declares fields (`output_field = models.TextField()`) but
// is no model: a direct base under django.db.models' expressions, functions, aggregates or lookups modules, or one
// of their classes as django.db.models exports them.
//   class Concat(models.Func): output_field = models.TextField()     dj_expression, not dj_model
.decl dj_expression(c: node)
dj_expression(c) :- class_base(c, b), (prefix("django.db.models.expressions.", b) ;
    prefix("django.db.models.functions.", b) ; prefix("django.db.models.aggregates.", b) ;
    prefix("django.db.models.lookups.", b) ; dj_expression_base(b)).
.decl dj_expression_base(q: symbol)
dj_expression_base("django.db.models.Func"). dj_expression_base("django.db.models.Expression").
dj_expression_base("django.db.models.Aggregate"). dj_expression_base("django.db.models.Transform").
dj_expression_base("django.db.models.Lookup"). dj_expression_base("django.db.models.Subquery").
dj_expression_base("django.db.models.ExpressionWrapper"). dj_expression_base("django.db.models.Value").
dj_expression_base("django.db.models.Window").
// A field declared in the body is model evidence, except a query expression's `output_field`.
.decl dj_model(c: node)
dj_model(c) :- class_def(c, q), dj_model_q(q).
dj_model(c) :- dj_class_field(c, x, _, _), x != "output_field", !dj_expression(c).
.decl dj_field(c: node, x: symbol, call: node, t: symbol)
dj_field(c, x, call, t) :- dj_model(c), dj_class_field(c, x, call, t).
.decl dj_fk(c: node, x: symbol)
dj_fk(c, x) :- dj_field(c, x, _, t), dj_fk_class(t).
// dj_model_super(c, b): class b of the run is among model c's bases, directly or through other classes of the run:
// the classes whose fields c inherits. A linear closure from the models, as dj_model_q.
//   class Novel(Book): ...                          dj_model_super(<Novel>, <Book>)
.decl dj_model_super(c: node, b: node)
dj_model_super(c, b) :- dj_model(c), class_base(c, q), class_def(b, q).
dj_model_super(c, b) :- dj_model_super(c, m), class_base(m, q), class_def(b, q).
// dj_has_field(c, x, call, t): model c has field x, a call of field class t, declared in its body or in a class of
// the run among its bases (dj_field reads c's own body only).
//   class Novel(Book): pages = models.IntegerField()
//                                                   dj_has_field(<Novel>, "pages", _, "IntegerField"),
//                                                   dj_has_field(<Novel>, "author", _, "ForeignKey")
.decl dj_has_field(c: node, x: symbol, call: node, t: symbol)
dj_has_field(c, x, call, t) :- dj_field(c, x, call, t).
dj_has_field(c, x, call, t) :- dj_model_super(c, b), dj_class_field(b, x, call, t).
// dj_attname(c, a, call): a row of model c holds the value of field call (dj_has_field) in attribute a: the field's
// name, and for a ForeignKey, OneToOneField or ParentalKey x also `x_id`, where Django keeps its key.
//   author = models.ForeignKey(Author, ...)         dj_attname(<Book>, "author", <call>), dj_attname(<Book>, "author_id", <call>)
.decl dj_attname(c: node, a: symbol, call: node)
dj_attname(c, x, call) :- dj_has_field(c, x, call, _).
dj_attname(c, cat(x, "_id"), call) :- dj_has_field(c, x, call, t), dj_fk_class(t).
// dj_number_field(t): the field classes whose values are numbers a counter is kept in (DurationField aside).
.decl dj_number_field(t: symbol)
dj_number_field("IntegerField"). dj_number_field("SmallIntegerField"). dj_number_field("BigIntegerField").
dj_number_field("PositiveIntegerField"). dj_number_field("PositiveSmallIntegerField").
dj_number_field("PositiveBigIntegerField"). dj_number_field("DecimalField"). dj_number_field("FloatField").
.decl dj_model_method(c: node, f: node, x: symbol)
dj_model_method(c, f, x) :- dj_model(c), kind(f, "function_definition"), nearest(f, c, scope), field(c, "body", b),
    within(f, b), def_name(f, x).

// ---- querysets ---------------------------------------------------------------------------------------------------
.decl dj_manager_name(x: symbol)
dj_manager_name("objects"). dj_manager_name("_default_manager"). dj_manager_name("_base_manager").
.decl dj_manager(e: node)
dj_manager(e) :- attr_of(e, _, x), dj_manager_name(x).
// dj_qs_method(m): QuerySet methods that return a QuerySet (Django's "Methods that return new QuerySets").
.decl dj_qs_method(m: symbol)
dj_qs_method("all"). dj_qs_method("filter"). dj_qs_method("exclude"). dj_qs_method("annotate").
dj_qs_method("alias"). dj_qs_method("order_by"). dj_qs_method("reverse"). dj_qs_method("distinct").
dj_qs_method("values"). dj_qs_method("values_list"). dj_qs_method("none"). dj_qs_method("union").
dj_qs_method("intersection"). dj_qs_method("difference"). dj_qs_method("select_related").
dj_qs_method("prefetch_related"). dj_qs_method("extra"). dj_qs_method("defer"). dj_qs_method("only").
dj_qs_method("using"). dj_qs_method("select_for_update"). dj_qs_method("raw").
.decl dj_qs(e: node)
dj_qs(e) :- dj_manager(e).
dj_qs(c) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m), dj_qs_method(m), dj_qs(o).
dj_qs(p) :- kind(p, "parenthesized_expression"), unparen(p, e), dj_qs(e).
.decl dj_qs_call(c: node, m: symbol)
dj_qs_call(c, m) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m), dj_qs(o).
// dj_qs_root(q, r): queryset chain q starts at the manager of expression r (through parentheses, as dj_qs).
//   Book.objects.filter(a=1).all()                  dj_qs_root(<the chain>, <Book>)
//   (Book.objects.filter(a=1)).first()             dj_qs_root(<(Book.objects.filter(a=1))>, <Book>)
.decl dj_qs_root(q: node, r: node)
dj_qs_root(q, o) :- dj_manager(q), attr_of(q, o, _).
dj_qs_root(q, r) :- dj_qs(q), kind(q, "call"), field(q, "function", f), attr_of(f, o, _), dj_qs_root(o, r).
dj_qs_root(p, r) :- kind(p, "parenthesized_expression"), unparen(p, e), dj_qs_root(e, r).
// dj_qs_model(q, c): queryset chain q starts at `M.objects` with M model class c of the run, so its rows are c's.
// dj_qs_class(q, mq): the same, by the model class's qualified name.
//   Book.objects.filter(a=1)                        dj_qs_model(<the chain>, <class Book>),
//                                                   dj_qs_class(<the chain>, "shop.models.Book")
.decl dj_qs_model(q: node, c: node)
dj_qs_model(q, c) :- dj_qs_root(q, r), sym_of(r, mq), class_def(c, mq), dj_model(c).
.decl dj_qs_class(q: node, mq: symbol)
dj_qs_class(q, mq) :- dj_qs_model(q, c), class_def(c, mq).
// dj_qs_has(q, m): queryset chain q calls method m somewhere along it (q's own last call included).
//   Book.objects.values("id").filter(a=1)          dj_qs_has(<the chain>, "values"), dj_qs_has(_, "filter")
.decl dj_qs_has(q: node, m: symbol)
dj_qs_has(q, m) :- dj_qs_call(q, m), dj_qs(q).
dj_qs_has(q, m) :- dj_qs(q), kind(q, "call"), field(q, "function", f), attr_of(f, o, _), dj_qs_has(o, m).
// dj_row_method(m): QuerySet methods that return one row (a model instance, unless after values()).
.decl dj_row_method(m: symbol)
dj_row_method("get"). dj_row_method("create"). dj_row_method("first"). dj_row_method("last").
dj_row_method("earliest"). dj_row_method("latest").

// ---- instances ---------------------------------------------------------------------------------------------------
// dj_fetch_call(c, mq): call c returns one row of model class mq from its manager: `M.objects….get()` (or
// create, first, last, earliest, latest, and their async twins aget, acreate, ...).
//   Book.objects.filter(a=1).afirst()               dj_fetch_call(<the call>, "shop.models.Book")
.decl dj_fetch_call(c: node, mq: symbol)
dj_fetch_call(c, mq) :- dj_qs_call(c, m), (dj_row_method(m) ; dj_row_method(b), m = cat("a", b)),
    field(c, "function", fn), attr_of(fn, o, _), dj_qs_class(o, mq).
// dj_instance_class(r, h, mq): identifier r, read in scope h, holds an instance of model class mq: `self` in a method
// of mq, or a name h assigns from `MQ(...)` or from a fetch (dj_fetch_call), awaited or not. The type program
// (python/types) does not know what a manager returns; this is what it misses.
//   def touch(pk): book = Book.objects.get(pk=pk); book.save()   dj_instance_class(<book in book.save>, <touch>, "shop.models.Book")
.decl dj_instance_class(r: node, h: node, mq: symbol)
dj_instance_class(r, h, mq) :- kind(r, "identifier"), text(r, "self"), dj_model_method(k, h, _), look(r, "self", h),
    class_def(k, mq).
dj_instance_class(r, h, mq) :- kind(r, "identifier"), text(r, o), look(r, o, h), asg(h, o, v, _),
    dj_instance_value(v, mq).
// dj_instance_value(v, mq): expression v makes or fetches one instance of model class mq.
.decl dj_instance_value(v: node, mq: symbol)
dj_instance_value(v, mq) :- unparen(v, c), dj_fetch_call(c, mq).
dj_instance_value(v, mq) :- unparen(v, w), kind(w, "await"), child(w, c, 0), dj_fetch_call(c, mq).
dj_instance_value(v, mq) :- unparen(v, c), kind(c, "call"), field(c, "function", fn), sym_of(fn, mq), class_def(k, mq),
    dj_model(k).

// ---- transactions ------------------------------------------------------------------------------------------------
.decl dj_atomic(e: node)
dj_atomic(e) :- sym_of(e, "django.db.transaction.atomic").
dj_atomic(e) :- kind(e, "call"), field(e, "function", f), sym_of(f, "django.db.transaction.atomic").
.decl dj_atomic_with(w: node, b: node)
dj_atomic_with(w, b) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", v), unparen(v, e), dj_atomic(e), field(w, "body", b).
// `with transaction.atomic() as sid:` puts the call under an as_pattern.
dj_atomic_with(w, b) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", ap), kind(ap, "as_pattern"), child(ap, v, 0), unparen(v, e), dj_atomic(e),
    field(w, "body", b).
.decl dj_atomic_def(f: node)
dj_atomic_def(f) :- kind(f, "function_definition"), decorator(f, e), unparen(e, m), dj_atomic(m).
// dj_region_stop: a node of these kinds ends an atomic region: code in a nested def, lambda or class runs later.
// Also the stop set for "the def this code runs in": nearest(n, f, dj_region_stop).
.decl dj_region_stop(k: symbol)
dj_region_stop("function_definition"). dj_region_stop("lambda"). dj_region_stop("class_definition").
.decl dj_in_atomic(n: node, a: node)
dj_in_atomic(n, b) :- dj_atomic_with(_, b), within_stop(n, b, dj_region_stop).
dj_in_atomic(n, f) :- dj_atomic_def(f), field(f, "body", b), within_stop(n, b, dj_region_stop).
// dj_atomic_like_with(w, b): with-statement w's item calls a wrapper named like atomic, not atomic itself (Saleor's
// `traced_atomic_transaction()`, label-studio's `conditional_atomic(...)`), which opens a transaction around b.
.decl dj_atomic_like_with(w: node, b: node)
dj_atomic_like_with(w, b) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", v), unparen(v, e), kind(e, "call"), call_name(e, x),
    contains("atomic", x), !dj_atomic(e), field(w, "body", b).
// dj_in_transaction(n): n runs in a transaction opened in its own function: inside atomic (dj_in_atomic), or in the
// body of a dj_atomic_like_with, with no nested def, lambda or class between.
//   with traced_atomic_transaction(): order.save()   dj_in_transaction(<order.save()>)
.decl dj_in_transaction(n: node)
dj_in_transaction(n) :- dj_in_atomic(n, _).
dj_in_transaction(n) :- dj_atomic_like_with(_, b), within_stop(n, b, dj_region_stop).
// dj_atomic_requests_value(v): outside test code, v is the value a settings file gives a database's ATOMIC_REQUESTS:
// a dict entry (`"ATOMIC_REQUESTS": True`), `DATABASES["default"]["ATOMIC_REQUESTS"] = v`, or `dict(ATOMIC_REQUESTS=v)`.
// A top-level `ATOMIC_REQUESTS = True` is no Django setting.
// dj_atomic_requests(): some such value is the literal True, so Django runs every sync view in a transaction.
.decl dj_atomic_requests_value(v: node)
dj_atomic_requests_value(v) :- kind(p, "pair"), field(p, "key", k), str(k, "ATOMIC_REQUESTS"), field(p, "value", v),
    docof(p, d), !dj_test_doc(d).
dj_atomic_requests_value(v) :- kind(a, "assignment"), field(a, "left", l), kind(l, "subscript"),
    field(l, "subscript", s), str(s, "ATOMIC_REQUESTS"), field(a, "right", v), docof(a, d), !dj_test_doc(d).
dj_atomic_requests_value(v) :- call_arg(_, -1, "ATOMIC_REQUESTS", v), docof(v, d), !dj_test_doc(d).
.decl dj_atomic_requests()
dj_atomic_requests() :- dj_atomic_requests_value(v), kind(v, "true").

// ---- side effects ------------------------------------------------------------------------------------------------
// What a transaction must not run before it commits: enqueuing a task, sending mail. The rules that report them
// (enqueue-on-commit inside atomic, dispatch-in-atomic-request under ATOMIC_REQUESTS) agree through these relations on
// what a dispatch is and which ones stay where they are.
// dj_side_effect(c, what): call c enqueues a task or sends mail; what names it for a message: a Celery `.delay()`,
// `.apply_async()`, `app.send_task()`, a Django 6 task `.enqueue()`/`.aenqueue()` on something that can be a task
// (dj_task_ref), django-q's `async_task()`, django.core.mail's send_mail, send_mass_mail, mail_admins,
// mail_managers, and an EmailMessage's `.send()`.
//   notify_order.delay(order.pk)                    dj_side_effect(<the call>, ".delay()")
//   client.delay(2.0)        (client a parameter)   not dj_side_effect: not known to be a task
.decl dj_task_method(m: symbol)
dj_task_method("delay"). dj_task_method("apply_async"). dj_task_method("send_task").
dj_task_method("enqueue"). dj_task_method("aenqueue").
.decl dj_mail_fn(q: symbol)
dj_mail_fn("django.core.mail.send_mail"). dj_mail_fn("django.core.mail.send_mass_mail").
dj_mail_fn("django.core.mail.mail_admins"). dj_mail_fn("django.core.mail.mail_managers").
dj_mail_fn("django_q.tasks.async_task").
.decl dj_message_class(q: symbol)
dj_message_class("django.core.mail.EmailMessage"). dj_message_class("django.core.mail.EmailMultiAlternatives").
dj_message_class("django.core.mail.message.EmailMessage").
dj_message_class("django.core.mail.message.EmailMultiAlternatives").
.decl dj_side_effect(c: node, what: symbol)
dj_side_effect(c, cat(cat(".", m), "()")) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m),
    dj_task_method(m), unparen(o, t), dj_task_ref(t).
dj_side_effect(c, cat(x, "()")) :- kind(c, "call"), field(c, "function", f), sym_of(f, q), dj_mail_fn(q),
    split_dot(q, _, x).
// `EmailMessage(...).send()`, or `.send()` on a name the same function binds to an EmailMessage.
dj_side_effect(c, "EmailMessage.send()") :- kind(c, "call"), field(c, "function", f), attr_of(f, o, "send"),
    unparen(o, m), dj_message(m).
dj_side_effect(c, "EmailMessage.send()") :- kind(c, "call"), field(c, "function", f), attr_of(f, o, "send"),
    kind(o, "identifier"), text(o, v), def_frame(c, fr), kind(a, "assignment"), field(a, "left", l), text(l, v),
    field(a, "right", r), dj_message(r), def_frame(a, fr).
.decl dj_message(m: node)
dj_message(m) :- kind(m, "call"), field(m, "function", f), sym_of(f, q), dj_message_class(q).
// dj_task_ref(t): t can be a task: a name that resolves through an import or a module attribute (`notify_order`,
// `tasks.notify_order`, `current_app`), other than a plain function of the run with no decorator, or a call on one
// (`notify_order.s(1)`, `task.using(priority=1)`). A parameter or local (`client.delay(2.0)`) is not one.
.decl dj_task_ref(t: node)
dj_task_ref(t) :- sym_of(t, q), !dj_plain_def(q).
// An imported name, or an attribute of one, also when sym_of does not resolve it (a relative import of three dots or
// more, `from .....order.tasks import t`, has no sym_of row).
dj_task_ref(t) :- kind(t, "identifier"), text(t, x), look(t, x, s), binding(s, x, _, "import").
dj_task_ref(t) :- attr_of(t, o, _), unparen(o, u), dj_task_ref(u).
dj_task_ref(t) :- kind(t, "call"), field(t, "function", f), attr_of(f, o, _), unparen(o, u), dj_task_ref(u).
.decl dj_plain_def(q: symbol)
dj_plain_def(q) :- kind(g, "function_definition"), qualname(g, q), !decorator(g, _).
// dj_task_waits_for_commit(c): c is `t.delay(...)`/`t.apply_async(...)` on a task t of the run whose decorator names
// a task class `base=X`, where X's own (or inherited) apply_async or delay calls transaction.on_commit (pretix's
// TransactionAwareTask); or the run's Celery app makes such a class every task's class (addons-server's AMOTask,
// `Celery(..., task_cls=AMOTask)`). Such a call already waits for the commit.
.decl dj_task_waits_for_commit(c: node)
dj_task_waits_for_commit(c) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m),
    (m = "delay" ; m = "apply_async"), sym_of(o, q), kind(g, "function_definition"), qualname(g, gq),
    dj_same_name(q, gq), decorator(g, e), kind(e, "call"), call_arg(e, _, "base", bv), sym_of(bv, bq),
    dj_deferring_task_class(cq), dj_same_name(bq, cq).
dj_task_waits_for_commit(c) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, m),
    (m = "delay" ; m = "apply_async"), dj_app_defers(_).
.decl dj_deferring_task_class(cq: symbol)
dj_deferring_task_class(cq) :- mro_method(cq, m, h), (m = "delay" ; m = "apply_async"), kind(oc, "call"), within(oc, h),
    field(oc, "function", of), sym_of(of, "django.db.transaction.on_commit").
.decl dj_app_defers(k: node)
dj_app_defers(k) :- kind(k, "call"), field(k, "function", f), sym_of(f, "celery.Celery"), call_arg(k, _, "task_cls", v),
    sym_of(v, bq), dj_deferring_task_class(cq), dj_same_name(bq, cq).
// dj_same_name(q, dq): the name q an import resolves to (a task, or a task class) denotes the definition named dq.
// In a src layout the engine names a module by its path (`src.pretix.base.services.tasks`) while imports say
// `pretix.base.services.tasks`, so dq may carry a leading package more.
.decl dj_same_name(q: symbol, dq: symbol)
dj_same_name(q, q) :- dj_task_name(q).
dj_same_name(q, dq) :- dj_task_name(q), dj_def_name(dq), suffix(cat(".", q), dq).
.decl dj_task_name(q: symbol)
dj_task_name(q) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m), (m = "delay" ; m = "apply_async"),
    sym_of(o, q).
dj_task_name(q) :- kind(e, "call"), call_arg(e, _, k, v), (k = "base" ; k = "task_cls"), sym_of(v, q).
.decl dj_def_name(dq: symbol)
dj_def_name(dq) :- kind(g, "function_definition"), qualname(g, dq).
dj_def_name(dq) :- class_def(_, dq).
// dj_dispatch_in_failing_handler(c): side effect c sits in an except handler that always re-raises
// (py_reraising_handler): the transaction rolls back, so an on_commit callback would never run (a failure mail or
// error task belongs there).
.decl dj_dispatch_in_failing_handler(c: node)
dj_dispatch_in_failing_handler(c) :- dj_side_effect(c, _), kind(x, "except_clause"), within(c, x),
    py_reraising_handler(x).
// dj_dispatch_result_used(c): `r = <task>.apply_async(...)` whose result r the same function reads afterwards (the
// task id is stored on a row, or the result awaited): on_commit returns nothing, so the call cannot simply move there.
.decl dj_dispatch_result_used(c: node)
dj_dispatch_result_used(c) :- dj_side_effect(c, _), kind(a, "assignment"), field(a, "right", r), unparen(r, c),
    field(a, "left", l), kind(l, "identifier"), text(l, v), def_frame(c, fr), kind(i, "identifier"), text(i, v),
    def_frame(i, fr), i != l, earlier(l, i), !bind_only(i).

// ---- views -------------------------------------------------------------------------------------------------------
.decl dj_view_base(q: symbol)
dj_view_base(q) :- class_base(_, q), prefix("django.views.", q).
dj_view_base(q) :- class_base(_, q), prefix("django.contrib.auth.views.", q), suffix("View", q).
dj_view_base(q) :- class_base(_, q), (prefix("rest_framework.views.", q) ; prefix("rest_framework.generics.", q) ;
    prefix("rest_framework.viewsets.", q)).
// dj_view_lib(q): a view class Django or DRF defines. Their `…Mixin` classes supply parts of a view and are not
// views themselves.
//   django.views.generic.TemplateView               dj_view_lib
//   django.views.generic.base.ContextMixin          not dj_view_lib
.decl dj_view_lib(q: symbol)
dj_view_lib(q) :- dj_view_base(q), !suffix("Mixin", q).
.decl dj_view_q(q: symbol)
dj_view_q(q) :- dj_view_lib(q).
dj_view_q(q) :- class_def(c, q), class_base(c, b), dj_view_q(b).
.decl dj_view_class(c: node)
dj_view_class(c) :- class_def(c, q), class_base(c, b), dj_view_q(b).

// ---- files and settings ------------------------------------------------------------------------------------------
.decl dj_migration_doc(d: number)
dj_migration_doc(d) :- class_def(c, _), def_name(c, "Migration"), class_base(c, "django.db.migrations.Migration"),
    docof(c, d).
// dj_test_doc(d): DefectDojo keeps its tests in `unittests/`, netbox its test helpers in `utilities/testing/`.
.decl dj_test_doc(d: number)
dj_test_doc(d) :- doc(d, _, _), (path_part(d, "tests") ; path_part(d, "test") ; path_part(d, "testing") ;
    path_part(d, "unittests")).
dj_test_doc(d) :- file_name(d, s), (glob("test_*.py", s) ; glob("*_tests.py", s) ; glob("*_test.py", s) ; s = "tests.py" ;
    s = "test.py" ; s = "conftest.py").
// dj_django_doc(d): document d imports Django or Django REST framework (an `import` or `from … import`, a star import
// included), so names such as `request.user` or `X.objects` in it are likely Django's: a gate for rules whose shapes
// other frameworks share (Starlette's `request.user`, mongoengine's `Document.objects`). A relative import
// (`from .models import Book`) names the project's own module and does not count.
//   from django.db import models                    dj_django_doc
//   import rest_framework.views                     dj_django_doc
//   from starlette.requests import Request          not dj_django_doc (alone)
.decl dj_django_doc(d: number)
dj_django_doc(d) :- dj_import_module(i, m), (m = "django" ; prefix("django.", m) ; m = "rest_framework" ;
    prefix("rest_framework.", m)), docof(i, d).
// dj_import_module(i, m): import statement i names module m (`import m`, `from m import x`, `from m import *`).
.decl dj_import_module(i: node, m: symbol)
dj_import_module(i, m) :- import_alias(i, _, m, _, _).
dj_import_module(i, m) :- kind(i, "import_from_statement"), module_text(i, m).
.decl dj_settings(e: node)
dj_settings(e) :- sym_of(e, "django.conf.settings").

// ---- python tests ------------------------------------------------------------------------------------------------
// Not Django's, but read the same way by several django-practice rules (python/ruff's bool_test, without
// including that library).
// py_truth(e): e is read only for its truth: the test of an if, elif, while, assert, conditional expression or
// comprehension `if`, the operand of `not`, the argument of `bool()`, or an operand of `and`/`or` that is itself one.
//   if not qs and ready: ...                        py_truth(<not qs and ready>), py_truth(<not qs>),
//                                                   py_truth(<qs>), py_truth(<ready>)
.decl py_truth(e: node)
py_truth(m) :- (kind(s, "if_statement") ; kind(s, "elif_clause") ; kind(s, "while_statement")),
    field(s, "condition", c), unparen(c, m).
py_truth(m) :- kind(s, "assert_statement"), child(s, c, 0), unparen(c, m).
py_truth(m) :- kind(s, "conditional_expression"), child(s, c, 1), unparen(c, m).
py_truth(m) :- kind(s, "if_clause"), child(s, c, 0), unparen(c, m).
py_truth(m) :- kind(s, "not_operator"), field(s, "argument", c), unparen(c, m).
py_truth(m) :- kind(s, "call"), field(s, "function", f), sym_of(f, "builtins.bool"), posarg(s, 0, c),
    !posarg(s, 1, _), unparen(c, m).
py_truth(m) :- py_truth(t), kind(t, "boolean_operator"), (field(t, "left", c) ; field(t, "right", c)), unparen(c, m).
// py_empty_cmp(c, x): comparison c (not a chained one) tests the number x against 0 or 1 so that it holds exactly
// when x is 0 or exactly when x is not: `x op k` with py_empty_op(op, k), or `k op x` with py_empty_op_r(op, k).
//   n > 0, n != 0, n >= 1, n == 0, n < 1, n <= 0, 0 < n, 1 > n   py_empty_cmp(_, <n>)
//   n > 5, n == 1, 0 < n < 9                                   not py_empty_cmp
.decl py_empty_cmp(c: node, x: node)
py_empty_cmp(c, x) :- kind(c, "comparison_operator"), !op_at(c, 1, _), cmp_pair(c, 0, o, l, r), unparen(l, x),
    kind(r, "integer"), text(r, k), py_empty_op(o, k).
py_empty_cmp(c, x) :- kind(c, "comparison_operator"), !op_at(c, 1, _), cmp_pair(c, 0, o, l, r), unparen(r, x),
    kind(l, "integer"), text(l, k), py_empty_op_r(o, k).
.decl py_empty_op(op: symbol, k: symbol)
py_empty_op(">", "0"). py_empty_op("!=", "0"). py_empty_op(">=", "1").
py_empty_op("==", "0"). py_empty_op("<", "1"). py_empty_op("<=", "0").
.decl py_empty_op_r(op: symbol, k: symbol)
py_empty_op_r("<", "0"). py_empty_op_r("!=", "0"). py_empty_op_r("<=", "1").
py_empty_op_r("==", "0"). py_empty_op_r(">", "1"). py_empty_op_r(">=", "0").
// py_empty_test(x): the number x is only tested for being 0: py_empty_cmp, or read for its truth.
//   if len(rows): ...                               py_empty_test(<len(rows)>)
.decl py_empty_test(x: node)
py_empty_test(x) :- py_empty_cmp(_, x).
py_empty_test(x) :- py_truth(x).
// py_no_args(c): call c passes no argument (comments aside).
//   qs.count()                                      py_no_args
//   qs.count(  # rows\n)                            py_no_args
//   cache.count("k")                                not py_no_args
.decl py_no_args(c: node)
py_no_args(c) :- kind(c, "call"), field(c, "arguments", al), !py_arg_item(al).
.decl py_arg_item(al: node)
py_arg_item(al) :- child(al, a, _), !kind(a, "comment").
// py_reraising_handler(x): every path through except clause x's handler ends in `raise`, so the exception still
// leaves the try (and rolls back an atomic block around it). A path is followed through the handler's last
// statement: a `raise`, or an if/elif/else (with an else) all of whose branches end so; a raise inside a nested
// try, with or match counts as not raising.
//   except IntegrityError: log(e); raise                          py_reraising_handler
//   except IntegrityError: if retry: raise  (no else)             not py_reraising_handler
.decl py_reraising_handler(x: node)
py_reraising_handler(x) :- kind(x, "except_clause"), child(x, hb, _), kind(hb, "block"), !py_may_end(hb).
// py_raise_block(b): the blocks py_may_end judges: a handler's, and recursively the branches of an if that is the
// last statement of one.
.decl py_raise_block(b: node)
py_raise_block(b) :- kind(x, "except_clause"), child(x, b, _), kind(b, "block").
py_raise_block(b) :- py_raise_block(p), body_len(p, k), j = k - 1, body_stmt(p, s, j), kind(s, "if_statement"),
    py_if_branch(s, b).
// py_if_branch(s, b): b is a branch of if statement s: its consequence, an elif's, or the else body.
.decl py_if_branch(s: node, b: node)
py_if_branch(s, b) :- kind(s, "if_statement"), field(s, "consequence", b).
py_if_branch(s, b) :- kind(s, "if_statement"), field(s, "alternative", e), kind(e, "elif_clause"),
    field(e, "consequence", b).
py_if_branch(s, b) :- kind(s, "if_statement"), field(s, "alternative", e), kind(e, "else_clause"), field(e, "body", b).
.decl py_has_else(s: node)
py_has_else(s) :- kind(s, "if_statement"), field(s, "alternative", e), kind(e, "else_clause").
// py_may_end(b): block b can finish without raising: its last statement is not `raise` (nor an if), or is an if
// that has no else, or one of whose branches can finish.
.decl py_may_end(b: node)
py_may_end(b) :- py_raise_block(b), body_len(b, k), j = k - 1, body_stmt(b, s, j), !kind(s, "raise_statement"),
    !kind(s, "if_statement").
py_may_end(b) :- py_raise_block(b), body_len(b, k), j = k - 1, body_stmt(b, s, j), kind(s, "if_statement"),
    !py_has_else(s).
py_may_end(b) :- py_raise_block(b), body_len(b, k), j = k - 1, body_stmt(b, s, j), py_if_branch(s, cb), py_may_end(cb).
