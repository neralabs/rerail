// python/names: what rules include for Python's names. python/scopes (who binds a name, what a reference reads, file
// by file), and what crosses files, read through the phase py_names (decision 0677): no node crosses into the
// cross-file part.
//
// The phase (native/src/code_rule_dsl/typing/programs/py_names.rerail) runs first, over the same files, and hands on
// symbols alone, read from the modules' definitions and import statements (never a name's use):
//   py_names__reads_at(p, m)    the file at path p can name something of workspace module m
//   py_names__exports(m, x, q)  module m exposes x, which denotes q, re-exports and star imports followed
//   py_names__class(m, c)       module m defines class c
//   py_names__defined(m, q)     module m defines q (a def or class, nested ones too)
//   py_names__public(m, x)      x is part of module m's public interface (python/imports' public_name)
// Each is read by a module the file's own `reads_at` rows name, so a rule reading them stays file-local, and a file's
// memo entry is keyed by those rows alone (decision 0665): an edit misses the files whose modules' rows changed.
#include "python/scopes.rerail"

.decl py_names__reads_at(p: symbol, m: symbol)
.decl py_names__exports(m: symbol, x: symbol, q: symbol)
.decl py_names__class(m: symbol, c: symbol)
.decl py_names__defined(m: symbol, q: symbol)
.decl py_names__public(m: symbol, x: symbol)

// export_at(n, q0, q): in n's file, the qualified name q0 ("m.x") is q: module m's export x, followed through
// re-exports to its definition. With `from pkg import App` where pkg/__init__.py has `from .core import App`,
// "pkg.App" is "pkg.core.App". None where q0's module is no workspace module, or exports no x.
.decl export_at(n: node, q0: symbol, q: symbol)
export_at(n, q0, q) :- qn(n, q0), split_dot(q0, m, x), docof(n, d), doc(d, p, _), py_names__reads_at(p, m),
    py_names__exports(m, x, q).
// sym_of (python/scopes) rule 1: through an import (qn), then re-exports; q0 itself where nothing re-exports it.
sym_of(n, q) :- export_at(n, _, q).
sym_of(n, q0) :- qn(n, q0), !export_at(n, q0, _).
// Rule 3: a def or class of the run read as an attribute of its class, by its qualname. A class's members are
// defined in its own module, which its file reads.
sym_of(n, q) :- attr_of(n, o, a), sym_of(o, c), docof(n, d), doc(d, p, _), py_names__reads_at(p, m),
    py_names__class(m, c), q = @dot(c, a), py_names__defined(m, q).

// site_exported(site): a module-level binding listed in __all__ or not underscore-private. A star import makes a
// module's public names depend on another's, so the phase hands them on.
.decl site_exported(site: node)  // a module-level binding listed in __all__ or not underscore-private
site_exported(site) :- binding(s, x, site, _), kind(s, "module"), docof(s, d), doc(d, p, m), py_names__reads_at(p, m),
    py_names__public(m, x).

// ---- tests ---------------------------------------------------------------------------------------------------------
// sym_of of an attribute of a class: of the same module, of an imported class, and of what is no definition of the run.
.fixtures class_attributes
    .fixture "pkg/__init__.py" ```
        # package
        ```
    .fixture "pkg/m.py" ```
        class Base:
            X = 1

            class Meta:
                abstract = True

            def f(self):
                pass


        a = Base.Meta
        b = Base.f
        c = Base.X
        d = Base


        class Child(Base):
            class Meta(Base.Meta):
                ordering = Base.Meta.abstract


        def g():
            pass


        e = g.attr
        ```
    .fixture "pkg/svc.py" ```
        import logging


        class Service:
            logger = logging.getLogger(__name__)


        Service.logger.info(f"x {1}")
        ```
    .fixture "shop/__init__.py" ```
        # package
        ```
    .fixture "shop/base.py" ```
        class Other:
            class Meta:
                abstract = True
        ```
    .fixture "shop/models.py" ```
        from shop.base import Other

        e = Other.Meta


        class Thing(Other):
            class Meta(Other.Meta):
                pass
        ```
.end

// A def or class of a same-module class, read as its attribute, is its qualified name, as for an imported class.
.test an_attribute_of_a_same_module_class_has_its_qualified_name uses class_attributes
    .decl rhs(p: symbol, l: number, q: symbol)
    rhs(p, l, q) :- kind(a, "assignment"), field(a, "right", r), sym_of(r, q), line(r, l), docof(r, d), doc(d, p, _).
    .expect rhs("pkg/m.py", 11, "pkg.m.Base.Meta")
    .expect rhs("pkg/m.py", 12, "pkg.m.Base.f")
    .expect rhs("pkg/m.py", 14, "pkg.m.Base")
    .expect rhs("shop/models.py", 3, "shop.base.Other.Meta")
.end

// `class Meta(Base.Meta)`, Base of the same module, lists its base as an imported one's does (Django's Meta options).
.test a_meta_based_on_a_same_module_class_meta_has_its_base uses class_attributes
    .decl base_at(p: symbol, l: number, q: symbol)
    base_at(p, l, q) :- class_base(c, q), line(c, l), docof(c, d), doc(d, p, _).
    .expect base_at("pkg/m.py", 17, "pkg.m.Base")
    .expect base_at("pkg/m.py", 18, "pkg.m.Base.Meta")
    .expect base_at("shop/models.py", 7, "shop.base.Other.Meta")
.end

// A value a class assigns (`Base.X`, `Base.Meta.abstract`, `Service.logger`) has no qualified name, as a module's own
// variable has none, and an attribute of a def has none: the step names definitions of the run only, and a rule's
// fallback for what does not resolve (the logging rules' `!sym_of(n, _)` over `Service.logger`) still reads them.
.test an_assigned_attribute_or_one_of_a_function_has_no_qualified_name uses class_attributes
    .decl rhs_at(l: number)
    rhs_at(l) :- kind(a, "assignment"), field(a, "right", r), sym_of(r, _), line(r, l), docof(r, d), doc(d, "pkg/m.py", _).
    .decl logger_resolves(l: number)
    logger_resolves(l) :- kind(n, "attribute"), text(n, "Service.logger"), sym_of(n, _), line(n, l).
    .decl logger_at(l: number)
    logger_at(l) :- kind(n, "attribute"), text(n, "Service.logger"), line(n, l).
    .expect no rhs_at(13)
    .expect no rhs_at(19)
    .expect no rhs_at(26)
    .expect logger_at(8)
    .expect no logger_resolves(8)
.end
