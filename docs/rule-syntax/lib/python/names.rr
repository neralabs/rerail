// python/names: who binds a name, and what a reference reads.
// Adapted from an earlier Datalog prototype of call resolution (LEGB, global/nonlocal, unconditional rebinding); the interface
// relations at the end are what rules use. File-local except `sym_of` through re-exports (python/imports).
//
// How to read this file
//   Every relation is a table of facts derived from the parse tree. Node ids are tree-sitter nodes (from lib/core.rr:
//   kind, field, child, text, nearest, within, ...). A scope is a module, function, class or lambda node.
//
// Layering (bottom to top)
//   1. Raw bindings, per syntactic scope: rdefn, rasg, rotgt, ribind/rifrom (the last two from python/imports).
//      "r" = raw: the scope the statement sits in, before `global`/`nonlocal` move it.
//   2. home: redirects a raw binding to the scope that really owns the name (global/nonlocal).
//   3. Owned bindings: defn, asg, otgt, ifrom, ibind, and their union bound_in.
//   4. Name lookup: walk/look (LEGB), miss/builtin_ref (nothing in the file binds it).
//   5. Unconditional rebinding: live_def, live_asg (which of several bindings of x survive to the end of the body).
//   6. Qualified names: qn, then sym_of (follows re-exports through python/imports' resolve_export).
//   7. Interface (after "==== interface"): what rule files use: scope_node, binding, ref_site, sym_of, annotation,
//      catches, class_def/class_base/subclass/mro_method, the site_* binding filters.
//   From layers 1-6, rules may also use: bound_in(s, x) (scope s binds x), walk(n, x, s) and look(n, x, s) (the
//   scopes lookup visits from n, and the one it lands on), miss(n, x) and builtin_ref(n, x) (nothing in the file
//   binds x), and builtin(x), typing_mod(m), py_keyword(x) (the tables at the end); python/calls also uses
//   live_def, live_asg, qn and attr_of. The rest of layers 1-6 is internal.
//
// Precision: this is approximate, file-local name resolution, not a type checker. Lookup lands on a scope, and every
// binding of the name in that scope is a candidate (may-precise); only straight-line rebinding (layer 5) prunes.
#include "python/imports.rr"

// Kind sets used with `nearest`/`within`. `scope` is every node that opens a Python scope.
.decl scope(kind: symbol)
scope("module"). scope("function_definition"). scope("class_definition").
scope("lambda").
// `fscope` is the scopes a nested reference can see. Python skips class bodies when resolving names from inside a
// method: in `class C: x = 1; def m(self): return x`, the `x` in m does not see C's x.
.decl fscope(kind: symbol)  // class scopes are skipped by lookup
fscope("module"). fscope("function_definition"). fscope("lambda").
.decl fdef(kind: symbol)
fdef("function_definition").
// Comprehension scopes. In Python 3 a list/set/dict comprehension or generator expression is a scope of its own:
// `[x for x in xs]` binds x there, not in the def around it. Two exceptions: the first `for`'s iterable (`xs`)
// runs in the enclosing scope, and a walrus (`(y := ...)`) binds in the nearest real scope. `scope` above keeps
// its four kinds (scope_node, qualname, ... stay as they were); lookup (walk) and untracked targets use these sets.
.decl comp_scope(kind: symbol)
comp_scope("list_comprehension"). comp_scope("set_comprehension"). comp_scope("dictionary_comprehension").
comp_scope("generator_expression").
.decl lscope(kind: symbol)  // scope, plus comprehensions
lscope(k) :- scope(k).
lscope(k) :- comp_scope(k).
.decl lfscope(kind: symbol)  // fscope, plus comprehensions (what lookup steps to; class bodies are still skipped)
lfscope(k) :- fscope(k).
lfscope(k) :- comp_scope(k).
// first_for(c, fc): fc is comprehension c's first `for` clause. Not "child 1": a comment can come before it.
.decl first_for(c: node, fc: node)
first_for(c, fc) :- comp_scope(k), kind(c, k), child(c, fc, i), kind(fc, "for_in_clause"),
    count : { child(c, g, j), kind(g, "for_in_clause"), j < i } = 0.

// modnode(d, m): m is the root "module" node of document d.
.decl modnode(d: number, m: node)
modnode(d, m) :- node(d, m, "module", _, _).
// modname(m, q): module node m has the dotted module name q (e.g. "pkg.sub.mod"), from the document facts.
.decl modname(m: node, q: symbol)
modname(m, q) :- modnode(d, m), doc(d, _, q).

// ---- names read, and the scope that binds them ----------------------------------------------------------------
// nameref(n, x): identifier n names x and is looked up: a read, or the target of a binding (`x = 1`, `except E
// as x`). ref_site keeps only reads (bind_only below). Excludes the attribute part of `a.b` (b is not a name lookup) and
// any `name` field (the name of a def/class or the keyword in `f(k=1)`), which are not reads.
.decl nameref(n: node, x: symbol)
nameref(n, x) :- kind(n, "identifier"), text(n, x), !field(_, "attribute", n), !field(_, "name", n),
    !kwpat_key(n).
// kwpat_key(n): the attribute name `x` in the class pattern `case Point(x=px)`, which is not a name read.
.decl kwpat_key(n: node)
kwpat_key(n) :- kind(k, "keyword_pattern"), child(k, n, 0).
// rdefn(s, x, f): `def x(...)` or `class x:` statement f sits directly in scope s, so it binds x there.
// e.g. in `def outer(): def inner(): ...`, rdefn(outer, "inner", <inner's def>).
.decl rdefn(s: node, x: symbol, f: node)
rdefn(s, x, f) :- kind(f, "function_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, scope).
rdefn(s, x, f) :- kind(f, "class_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, scope).
// rasg(s, x, r, a): plain assignment a, `x = r`, with a single identifier on the left, sits in scope s.
// Only this form has a tracked value r; `a, b = ...` and `x += 1` go to tgt/rotgt below instead.
.decl rasg(s: node, x: symbol, r: node, a: node)
rasg(s, x, r, a) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", r), nearest(a, s, scope).
// param(f, x, i): function f's i-th parameter is named x. First rule: a bare `x`. Second: a wrapped one whose
// first child is the identifier: `x: int`, `x=1`, `x: int = 1`, `*x`, `**x`.
.decl param(f: node, x: symbol, i: number)
param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), kind(p, "identifier"), text(p, x).
param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), child(p, id, 0), kind(id, "identifier"), text(id, x).
// Targets whose value is not tracked: patterns, loop and comprehension variables, `with`/`except` names, walrus,
// augmented assignment, and names a `global`/`nonlocal` declaration hands to another scope.
// patkind(k): node kinds that destructure: `a, b = ...`, `[a, *rest] = ...`, `(a, b) = ...`.
.decl patkind(k: symbol)
patkind("pattern_list"). patkind("tuple_pattern"). patkind("list_pattern"). patkind("list_splat_pattern").
patkind("parenthesized_expression"). patkind("tuple"). patkind("list"). patkind("expression_list").
// tgt(t): t is a binding target whose bound value we do not follow. The first six rules find the top target of
// each statement form; the last two descend into patterns so `a` and `b` in `for a, b in xs` are targets too.
// Note tgt may be an attribute or subscript (`self.x = 1`); rotgt below keeps only identifiers.
.decl tgt(t: node)
tgt(l) :- kind(a, "assignment"), field(a, "left", l), !kind(l, "identifier").   // `a, b = ...`, `o.x = ...`
tgt(l) :- kind(a, "augmented_assignment"), field(a, "left", l).                  // `x += 1`
tgt(l) :- kind(a, "for_statement"), field(a, "left", l).                         // `for x in xs:`
tgt(l) :- kind(a, "for_in_clause"), field(a, "left", l).                         // `[... for x in xs]`
tgt(l) :- kind(a, "named_expression"), field(a, "name", l).                      // `(x := f())`
tgt(l) :- kind(l, "as_pattern_target").                                            // `with f() as x`, `except E as x`
// Match-case captures: `case [x, *rest]`, `case Point(x=px)`, `case {"k": v, **kw}`, `case A() as a`, `case q | r`.
// A capture is a bare name (a dotted_name of one identifier); `case Color.RED` is a value pattern, not a capture.
tgt(t) :- kind(d, "dotted_name"), child(d, t, 0), !child(d, _, 1), child(p, d, _), capture_parent(p).
tgt(t) :- kind(p, "splat_pattern"), child(p, t, _), kind(t, "identifier").
tgt(t) :- kind(p, "as_pattern"), child(c, p, _), kind(c, "case_pattern"), child(p, t, _), kind(t, "identifier").
// PEP 695 `type TA = int` and `type Alias[T] = list[T]` bind the alias name (T: see tp_name below).
tgt(t) :- kind(a, "type_alias_statement"), field(a, "left", l), child(l, t, 0), kind(t, "identifier").
tgt(t) :- kind(a, "type_alias_statement"), field(a, "left", l), child(l, g, 0), kind(g, "generic_type"),
    child(g, t, 0), kind(t, "identifier").
// Recursive descent into destructuring patterns.
tgt(c) :- tgt(t), kind(t, k), patkind(k), child(t, c, _).
tgt(c) :- tgt(t), kind(t, "as_pattern_target"), child(t, c, _).
.decl capture_parent(p: node)
capture_parent(p) :- kind(p, "case_pattern").
capture_parent(p) :- kind(p, "keyword_pattern").
capture_parent(p) :- kind(p, "union_pattern").
// tscope(t, s): target t binds in s: its nearest scope, or the comprehension it is a `for` target of. A walrus
// inside a comprehension binds in the nearest real scope.
.decl tscope(t: node, s: node)
tscope(t, s) :- tgt(t), nearest(t, s, lscope), kind(s, k), scope(k).
tscope(t, c) :- tgt(t), nearest(t, c, lscope), kind(c, k), comp_scope(k), !walrus_tgt(t).
tscope(t, s) :- tgt(t), nearest(t, c, lscope), kind(c, k), comp_scope(k), walrus_tgt(t), nearest(c, s, scope).
.decl walrus_tgt(t: node)
walrus_tgt(t) :- kind(a, "named_expression"), field(a, "name", t).
// rotgt(s, x): an untracked target binds name x in syntactic scope s (a comprehension for its `for` targets).
// python/imports adds rows for relative imports it cannot resolve (the name is bound, to something unknown).
.decl rotgt(s: node, x: symbol)
rotgt(s, x) :- tgt(t), kind(t, "identifier"), text(t, x), tscope(t, s).

// Imports, per scope: `ibind(s, x, q)` binds x to the qualified name q; `ifrom` also keeps the module and name.
// The raw forms ribind/rifrom are parsed in python/imports. star(s): scope s has `from m import *`, which can bind
// any name, so a name we cannot find in s is unknown rather than missing (see builtin_ref).
star(s) :- kind(i, "import_from_statement"), child(i, w, _), kind(w, "wildcard_import"), nearest(i, s, scope).

// `global x` / `nonlocal x`: the scope's bindings of x are the module's / the enclosing function's.
// decl(s, x, t): scope s declares x global (t = the module node) or nonlocal (t = nearest enclosing function or
// module scope, skipping classes). e.g. `def f(): global n; n = 1` assigns the module's n, not a local.
// Simplification: nonlocal takes the nearest enclosing fscope, not the nearest one that actually binds x.
.decl decl(s: node, x: symbol, t: node)
decl(s, x, m) :- kind(g, "global_statement"), child(g, i, _), text(i, x), nearest(g, s, scope), docof(g, d), modnode(d, m).
decl(s, x, p) :- kind(g, "nonlocal_statement"), child(g, i, _), text(i, x), nearest(g, s, scope), nearest(s, p, fscope).
// rbound(s, x): some raw binding of x sits syntactically in s (parameters are excluded: they cannot be global).
.decl rbound(s: node, x: symbol)
rbound(s, x) :- rdefn(s, x, _).
rbound(s, x) :- rasg(s, x, _, _).
rbound(s, x) :- rotgt(s, x).
rbound(s, x) :- ribind(s, x, _).
// home(s, x, t): a binding of x written in s really binds x in scope t. Usually t = s; with `global x` or
// `nonlocal x` in s, t is the declared scope. Every owned relation below is "raw relation, moved by home".
.decl home(s: node, x: symbol, t: node)
home(s, x, s) :- rbound(s, x), !decl(s, x, _).
home(s, x, t) :- rbound(s, x), decl(s, x, t).
// The owned bindings: the same facts as rdefn/rasg/rotgt/rifrom/ribind, keyed by the scope that owns the name.
.decl defn(s: node, x: symbol, f: node)
defn(t, x, f) :- rdefn(s, x, f), home(s, x, t).
.decl asg(s: node, x: symbol, r: node, a: node)
asg(t, x, r, a) :- rasg(s, x, r, a), home(s, x, t).
.decl otgt(s: node, x: symbol)
otgt(t, x) :- rotgt(s, x), home(s, x, t).
// ifrom(s, x, m, y): `from m import y as x` binds x in s (y = x when there is no alias).
.decl ifrom(s: node, x: symbol, m: symbol, y: symbol)
ifrom(t, x, m, y) :- rifrom(s, x, m, y), home(s, x, t).
// ibind(s, x, q): any import binds x in s to qualified name q. `import os.path` gives ibind(s, "os", "os");
// `import numpy as np` gives ibind(s, "np", "numpy"); `from a.b import c` gives ibind(s, "c", "a.b.c").
.decl ibind(s: node, x: symbol, q: symbol)
ibind(t, x, q) :- ribind(s, x, q), home(s, x, t).

// bound_in(s, x): scope s owns some binding of x, of any form. This is what LEGB lookup tests at each scope.
// Parameters bind in their own function and are never moved by global/nonlocal.
.decl bound_in(s: node, x: symbol)
bound_in(s, x) :- defn(s, x, _).
bound_in(s, x) :- asg(s, x, _, _).
bound_in(f, x) :- param(f, x, _).
bound_in(s, x) :- otgt(s, x).
bound_in(s, x) :- ibind(s, x, _).
// A class body defines `__qualname__` and `__module__` before its first statement.
bound_in(c, x) :- kind(c, "class_definition"), (x = "__qualname__" ; x = "__module__").

// LEGB: from the nearest scope outwards, skipping class scopes, to the first that binds the name.
// walk(n, x, s): reference n to x is looked up in scope s. Start at n's own scope (which may be a class: a name in
// a class body does see the class's own bindings, and a comprehension is a scope too); if s does not bind x, step
// to the next enclosing fscope or comprehension.
// Recursive, but only over the scope chain, so it is short. The negation !bound_in is on a lower stratum.
// Python detail modelled: a name bound anywhere in a function is local to the whole function (no "use before
// assignment" check), which is why bound_in ignores statement order.
.decl walk(n: node, x: symbol, s: node)
walk(n, x, s) :- nameref(n, x), wstart(n, s), !tp_ref(n, x).
walk(n, x, p) :- walk(n, x, s), !bound_in(s, x), nearest(s, p, lfscope).
// wstart(n, s): where the lookup of n starts: its nearest scope or comprehension, except that a comprehension's
// first iterable is looked up from the scope around the comprehension. (One level: an iterable nested in another
// comprehension's first iterable starts at the outer comprehension.) A name parsed from a string annotation starts
// where the string sits.
.decl wstart(n: node, s: node)
wstart(n, s) :- nameref(n, _), nearest(n, s, lscope), kind(s, k), scope(k).
wstart(n, c) :- nameref(n, _), nearest(n, c, lscope), kind(c, k), comp_scope(k), !in_first_iter(n, c).
wstart(n, s) :- in_first_iter(n, c), nearest(c, s, lscope).
wstart(n, s) :- nameref(n, _), parsed_in(n, h), nearest(h, s, lscope), kind(s, k), scope(k).
wstart(n, c) :- nameref(n, _), parsed_in(n, h), nearest(h, c, lscope), kind(c, k), comp_scope(k).
.decl in_first_iter(n: node, c: node)
in_first_iter(n, c) :- nameref(n, _), nearest(n, c, lscope), comp_scope(k), kind(c, k), first_for(c, fc),
    field(fc, "right", e), (n = e ; within(n, e)).
// PEP 695 type parameters: `def f[T](x: T)`, `class K[T]`, `type A[T] = list[T]`. They live in an annotation
// scope that sees the whole definition (methods included), so a T read anywhere inside its owner is resolved,
// and is not looked up. tp_name(o, x): definition o declares type parameter x (`T`, `T: int`, `*Ts`, `**P`).
.decl tp_name(o: node, x: symbol)
tp_name(o, x) :- (kind(o, "function_definition") ; kind(o, "class_definition")), field(o, "type_parameters", tp),
    tp_list(tp, x).
tp_name(o, x) :- kind(o, "type_alias_statement"), field(o, "left", l), child(l, g, 0), kind(g, "generic_type"),
    child(g, tp, _), kind(tp, "type_parameter"), tp_list(tp, x).
.decl tp_list(tp: node, x: symbol)
tp_list(tp, x) :- kind(tp, "type_parameter"), child(tp, ty, _), kind(ty, "type"), child(ty, d, 0), tp_decl(d, x).
.decl tp_decl(d: node, x: symbol)
tp_decl(d, x) :- kind(d, "identifier"), text(d, x).
tp_decl(d, x) :- kind(d, "splat_type"), child(d, i, _), kind(i, "identifier"), text(i, x).
tp_decl(d, x) :- kind(d, "constrained_type"), child(d, ty, 0), child(ty, i, 0), kind(i, "identifier"), text(i, x).
// tp_ref(n, x): n names type parameter x inside the definition that declares it.
.decl tp_ref(n: node, x: symbol)
tp_ref(n, x) :- tp_name(o, x), nameref(n, x), within(n, o).
// look(n, x, s): the lookup of reference n stops at scope s, which binds x. At most one s per reference.
.decl look(n: node, x: symbol, s: node)
look(n, x, s) :- walk(n, x, s), bound_in(s, x).
// Bound nowhere: a builtin, or (a star import, `globals()`) unknown.
// miss(n, x): the walk reached the module and the module does not bind x either.
.decl miss(n: node, x: symbol)
miss(n, x) :- walk(n, x, m), kind(m, "module"), !bound_in(m, x).
// builtin_ref(n, x): a miss on a known builtin name, in a module with no star import (which might shadow it).
// e.g. `len(xs)` with no local `len` gives builtin_ref(<len>, "len").
.decl builtin_ref(n: node, x: symbol)
builtin_ref(n, x) :- miss(n, x), builtin(x), docof(n, d), modnode(d, m), !star(m).

// ---- unconditional rebinding --------------------------------------------------------------------------------------
// A statement of a scope's own body (not inside an `if`, loop or `try`) binding x; a later one replaces an earlier one.
// e.g. `def f(): ...` followed later by `f = wrap(f)` at module top level: only the second binding is live.
// A binding nested in an `if` is never shadowed and never shadows: either branch may have run.
// stmt(st, s): st is a direct statement of scope s's body (module children, or the body block of a def/class).
.decl stmt(st: node, s: node)
stmt(st, s) :- kind(s, "module"), child(s, st, _).
stmt(st, s) :- kind(s, "function_definition"), field(s, "body", b), child(b, st, _).
stmt(st, s) :- kind(s, "class_definition"), field(s, "body", b), child(b, st, _).
// defstmt(f, st): the statement that carries definition f: f itself, or the `@decorator` wrapper around it.
.decl defstmt(f: node, st: node)
defstmt(f, f) :- kind(f, "function_definition").
defstmt(f, f) :- kind(f, "class_definition").
defstmt(f, st) :- kind(st, "decorated_definition"), field(st, "definition", f).
// asgstmt(a, st): assignment a is the whole expression statement st (`x = 1` on its own line).
.decl asgstmt(a: node, st: node)
asgstmt(a, st) :- kind(st, "expression_statement"), child(st, a, 0), kind(a, "assignment").
// sbinds(s, x, st): top-level statement st of scope s binds x by a def/class or a plain assignment.
.decl sbinds(s: node, x: symbol, st: node)
sbinds(s, x, st) :- defn(s, x, f), defstmt(f, st), stmt(st, s).
sbinds(s, x, st) :- asg(s, x, _, a), asgstmt(a, st), stmt(st, s).
// shadowed(st): a later top-level statement of the same scope rebinds the same name. Node ids grow in source order,
// so `st2 > st` means "st2 comes after st".
.decl shadowed(st: node)
shadowed(st) :- sbinds(s, x, st), sbinds(s, x, st2), st2 > st.
// live_def / live_asg: the bindings whose values may still be in the name at the end of the scope. A nested
// (conditional) assignment has no asgstmt row in the scope body, so the first live_asg rule keeps it.
.decl live_def(s: node, x: symbol, f: node)
live_def(s, x, f) :- defn(s, x, f), defstmt(f, st), !shadowed(st).
.decl live_asg(s: node, x: symbol, r: node)
live_asg(s, x, r) :- asg(s, x, r, a), !asgstmt(a, _).
live_asg(s, x, r) :- asg(s, x, r, a), asgstmt(a, st), !shadowed(st).


// attr_of(n, o, a): n is the attribute expression `o.a`.
.decl attr_of(n: node, o: node, a: symbol)
attr_of(n, o, a) :- kind(n, "attribute"), field(n, "object", o), field(n, "attribute", at), text(at, a).
// Qualified names: an imported name and attributes of one (`os.path.join`), whether or not the workspace defines it.
// qn(n, q): after `import os`, the `os` in `os.path.join` has qn "os", `os.path` has "os.path", and the whole
// expression "os.path.join". Recursive along the attribute chain. Purely syntactic: no re-export following here.
.decl qn(n: node, q: symbol)
qn(n, q) :- look(n, x, s), ibind(s, x, q).
qn(n, @dot(q, a)) :- attr_of(n, o, a), qn(o, q).

// ---- comparisons ---------------------------------------------------------------------------------------------------
// cmp(c, op, l, r): c is a comparison with exactly one operator. op is the operator's text, two-word operators
// ("not in", "is not") one token. Chained comparisons (a < b < c) have no row; cmp_pair (ast) has their links.
// e.g. `x is None` gives cmp(c, "is", <x>, <None>).
.decl cmp(c: node, op: symbol, l: node, r: node)
cmp(c, o, l, r) :- kind(c, "comparison_operator"), child(c, l, 0), child(c, r, 1), !child(c, _, 2), op_at(c, 0, o).

// ==== interface ===================================================================================================
// scope_node(n, s): s is the innermost scope (module, def, class or lambda) containing n.
.decl scope_node(n: node, s: node)
scope_node(n, s) :- nearest(n, s, scope).
// def_name(f, s): function or class definition f is named s.
.decl def_name(f: node, s: symbol)
def_name(f, s) :- kind(f, k), (k = "function_definition" ; k = "class_definition"), field(f, "name", n), text(n, s).
// qualname(f, q): dotted path of a definition from its module: `class C: def m` in pkg.mod gives "pkg.mod.C.m".
// First rule: defined directly in the module. Second: inside another def/class, append to that one's qualname
// (recursive). Unlike Python's __qualname__, functions nested in functions get no "<locals>" segment.
.decl qualname(f: node, q: symbol)
qualname(f, @dot(m, x)) :- def_name(f, x), nearest(f, s, scope), modname(s, m).
qualname(f, @dot(p, x)) :- def_name(f, x), nearest(f, s, scope), !kind(s, "module"), qualname(s, p).
// scope_name(n, s): the enclosing function's name, prefixed by its class when it has one ("C.m"), for messages.
// Note `nearest(..., {"class_definition"})` finds any enclosing class, not only the immediate parent scope.
.decl scope_name(n: node, s: symbol)  // "Class.method", as linters report it
scope_name(n, x) :- nearest(n, f, fdef), def_name(f, x), !nearest(f, _, "class_definition").
scope_name(n, @dot(c, x)) :- nearest(n, f, fdef), def_name(f, x), nearest(f, k, "class_definition"), def_name(k, c).
// is_async(f): `async def f`.
.decl is_async(f: node)
is_async(f) :- kind(f, "function_definition"), op(f, "async").
// decorator(f, e): e is the expression of one of f's decorators: in `@app.route("/")`, e is the call node.
.decl decorator(f: node, d: node)
decorator(f, e) :- kind(dd, "decorated_definition"), field(dd, "definition", f), child(dd, dc, _),
    kind(dc, "decorator"), child(dc, e, 0).
// params(f, x, i): public alias of param.
.decl params(f: node, x: symbol, i: number)
params(f, x, i) :- param(f, x, i).

// binding(s, x, site, form): scope s binds x at site.
// The site is a node a rule can report on, and form says how: "def", "class", "assign", "param", "import", or a
// target form from target_form ("augassign", "for", "walrus", "with", "except", "match", "type").
// A comprehension's `for` target binds in the comprehension node (site_scope "comprehension" or "generator").
// e.g. in `def f(): x = 1`, binding(<f>, "x", <the assignment>, "assign"). global/nonlocal are honoured via home.
.decl binding(s: node, x: symbol, site: node, form: symbol)
binding(s, x, f, "def")    :- defn(s, x, f), kind(f, "function_definition").
binding(s, x, f, "class")  :- defn(s, x, f), kind(f, "class_definition").
binding(s, x, a, "assign") :- asg(s, x, _, a).
// For a parameter the site is the parameter node itself (`x`, or `x: int = 1`).
binding(f, x, p, "param")  :- param(f, x, i), field(f, "parameters", ps), child(ps, p, i).
// For an import the site is the alias node (`a as b`, or the dotted name), one per imported name.
binding(s, x, i, "import") :- import_site(i, x), nearest(i, s0, scope), home(s0, x, s).
binding(s, x, t, form)    :- tgt(t), kind(t, "identifier"), text(t, x), target_form(t, form),
    tscope(t, s0), home(s0, x, s).
// site_form(site, form): the form of a binding site, without the scope and name.
.decl site_form(site: node, form: symbol)
site_form(site, form) :- binding(_, _, site, form).

// ref_site(r, site): reference r reads binding site `site` (every site of the scope LEGB lands on: may-precise).
// e.g. `x = 1; if c: x = 2; print(x)`: the x in print has two ref_site rows. No flow pruning is done here.
.decl ref_site(r: node, site: node)
ref_site(r, site) :- look(r, x, s), binding(s, x, site, _), !bind_only(r).
// bind_only(n): identifier n binds a name and does not read it, so it is no reference to any site: the targets of
// `x = 1`, `for x in`, `with … as x`, `except E as x`, match captures and `(x := v)`, a parameter's name, and the
// names in import, global and nonlocal statements. `x += 1` reads x as well as binding it, so it is not here.
// e.g. in `except E as e: pass`, e is bind_only, and the handler never reads its exception.
.decl bind_only(n: node)
bind_only(l) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier").
bind_only(t) :- tgt(t), kind(t, "identifier"), !aug_target(t).
bind_only(id) :- field(f, "parameters", ps), child(ps, p, _), (id = p ; child(p, id, 0)), kind(id, "identifier").
bind_only(n) :- (kind(i, "import_statement") ; kind(i, "import_from_statement") ; kind(i, "future_import_statement")),
    within(n, i), kind(n, "identifier").
bind_only(n) :- (kind(g, "global_statement") ; kind(g, "nonlocal_statement")), child(g, n, _), kind(n, "identifier").
.decl aug_target(t: node)
aug_target(l) :- kind(a, "augmented_assignment"), field(a, "left", l).
// binding_value(site, v): the value expression a site stores, for `x = v` and `(x := v)`.
.decl binding_value(site: node, v: node)
binding_value(a, v) :- kind(a, "assignment"), field(a, "right", v).
binding_value(a, v) :- kind(a, "named_expression"), field(a, "value", v).

// sym_of(n, q): n denotes the qualified name q, through imports, aliases, attribute chains and module definitions.
// The main "what is this expression" relation for rules. e.g. with `from django.db import models`, the expression
// `models.Model` has sym_of "django.db.models.Model"; if a workspace package re-exports a name, resolve_export
// (python/imports) follows it to the defining module.
// Rule 1: through an import (qn) then re-exports. Rule 2: a local def/class, by its qualname. Rule 3: a builtin.
.decl sym_of(n: node, q: symbol)
sym_of(n, q) :- qn(n, q0), resolve_export(q0, q).
sym_of(n, q) :- look(n, x, s), defn(s, x, f), qualname(f, q).
sym_of(n, q) :- builtin_ref(n, x), q = @dot("builtins", x).
// global_ref(n, x): n reads builtin x (kept as a separate name for rules that speak of "globals").
.decl global_ref(n: node, x: symbol)
global_ref(n, x) :- builtin_ref(n, x).

// A program that says `.guests off` sees files only: its names are not resolved inside string annotations either
// (no parse is asked for; guest_policy("library", "off"), decision 0055).
// annotation(n): n is (inside) a type annotation: parameter types, return types, `x: T = ...`, and the parsed
// contents of string annotations such as `def f() -> "Foo[int]"`. Rules use it to ignore type-only uses of a name.
.decl annotation(n: node)
annotation(t) :- ann_root(t).
annotation(n) :- ann_root(t), within(n, t).                            // every node below an annotation root
annotation(n) :- parsed_in(n, _).                                      // and the trees parsed from its strings
annotation(r) :- !guest_policy("library", "off"), string_annotation(s), parsed(s, "annotation", r).   // native sub-grammar parse of "Foo[int]"
annotation(n) :- !guest_policy("library", "off"), string_annotation(s), parsed(s, "annotation", r), within(n, r).
// ann_root(t): the root of an annotation: a parameter's, a return's, an annotated assignment's.
//   def f(x: int) -> str: ...      ann_root(<int>), ann_root(<str>)
.decl ann_root(t: node)
ann_root(t) :- kind(p, k), (k = "typed_parameter" ; k = "typed_default_parameter"), field(p, "type", t).
ann_root(t) :- kind(f, "function_definition"), field(f, "return_type", t).
ann_root(t) :- kind(a, "assignment"), field(a, "type", t).
// parsed_in(e, s): e is in the tree parsed from string annotation s, or from a string nested in one; s is the
// outermost string. The tree has no ancestors of its own, so s's place stands for it: lookup (wstart) starts at
// s's scope. A string that is part of an implicit concatenation is parsed as the whole; strings in `Literal[...]`
// are values, not types, and are not parsed.
//   def f(x: "List['int']"): ...      parsed_in(<List>, <"List['int']">), parsed_in(<int>, <"List['int']">)
.decl parsed_in(e: node, s: node)
.decl ann_ctx(s: node)  // s is an annotation root or inside one: where a string annotation can stand
ann_ctx(s) :- ann_root(a), (s = a ; within(s, a)).
parsed_in(e, s) :- !guest_policy("library", "off"), ann_ctx(s), ann_str(s), parsed(s, "annotation", r), (e = r ; within(e, r)).
// s is a string inside a parsed annotation: only those are asked to be parsed again. parsed_in binds s inside a
// parsed tree, so s is in a fragment document already; a test of its document's role (`d = @doc(s), doc_role(d,
// "fragment")`, once frag_str) was planned before the fragments existed and crossed each with every string of the
// chunk (4.2 M rows on 859 posthog files, none kept).
parsed_in(e, s0) :- !guest_policy("library", "off"), parsed_in(s, s0), ann_str(s), parsed(s, "annotation", r), (e = r ; within(e, r)).
.decl str_node(s: node)  // a string or an implicit concatenation: what a parse request may name
str_node(s) :- kind(s, "string").
str_node(s) :- kind(s, "concatenated_string").
.decl ann_str(s: node)
ann_str(s) :- (kind(s, "string") ; kind(s, "concatenated_string")), !concat_part(s), !literal_str(s).
.decl concat_part(s: node)  // s is one of the strings of `"a" "b"`
concat_part(s) :- kind(c, "concatenated_string"), child(c, s, _).
.decl literal_str(s: node)  // s is inside the brackets of `Literal[...]` or `x.Literal[...]`
literal_str(s) :- kind(l, "subscript"), field(l, "value", v), text(v, t), (t = "Literal" ; suffix(".Literal", t)),
    within(s, l), !within(s, v).
literal_str(s) :- kind(l, "generic_type"), child(l, v, 0), text(v, "Literal"), within(s, l).
// type_checking_block(b): b is the body of `if TYPE_CHECKING:` (from typing or typing_extensions). Code there never
// runs, so imports in it do not count as import-time (see python/imports' import_time).
.decl type_checking_block(b: node)
// It reads qn (the import as written), not sym_of: sym_of follows re-exports, which depend on import_time, which
// negates this relation, so using it here would make a negative cycle that Soufflé rejects. A TYPE_CHECKING
// re-exported through another module is therefore not recognised.
type_checking_block(b) :- kind(i, "if_statement"), field(i, "condition", c), qn(c, q),
    (q = "typing.TYPE_CHECKING" ; q = "typing_extensions.TYPE_CHECKING"), field(i, "consequence", b).
// catches(x, q): except clause x catches exception class q. A bare `except:` (no child other than the body block)
// catches everything, modelled as builtins.BaseException.
.decl catches(x: node, q: symbol)
catches(x, "builtins.BaseException") :- kind(x, "except_clause"), count : { child(x, e, _), !kind(e, "block") } = 0.
catches(x, q) :- kind(x, "except_clause"), child(x, e, _), caught(e, q).
// caught(e, q): the exception expression e names q: `except ValueError`, `except (A, B)`, `except A as err`.
// Recursive through tuples and parentheses.
.decl caught(e: node, q: symbol)
caught(e, q) :- sym_of(e, q).
caught(e, q) :- kind(e, k), (k = "tuple" ; k = "parenthesized_expression"), child(e, c, _), caught(c, q).
caught(e, q) :- kind(e, "as_pattern"), child(e, c, 0), caught(c, q).

// Classes: definitions, resolved bases, inheritance.
// These work on qualified names (syms), so they cross files: `class B(a.A)` in one module links to A in another.
// class_def(c, q): class node c has qualified name q.
.decl class_def(c: node, q: symbol)
class_def(c, q) :- kind(c, "class_definition"), qualname(c, q).
// class_base(c, q): c lists base q. Keyword arguments in the base list (`metaclass=M`) are not bases.
.decl class_base(c: node, q: symbol)
class_base(c, q) :- kind(c, "class_definition"), field(c, "superclasses", al), child(al, e, _),
    !kind(e, "keyword_argument"), sym_of(e, q).
// subclass(q, b): q inherits from b, directly or transitively (recursive transitive closure).
.decl subclass(q: symbol, b: symbol)
subclass(q, b) :- class_def(c, q), class_base(c, b).
subclass(q, b) :- subclass(q, m), subclass(m, b).
// method(cq, x, f): class cq defines method x as f, directly in its body.
.decl method(cq: symbol, x: symbol, f: node)
method(cq, x, f) :- class_def(c, cq), kind(f, "function_definition"), nearest(f, c, scope), def_name(f, x).
// mro_method(cq, x, f): what `cq().x` may resolve to: its own method, else one from any ancestor. This is an
// approximation of Python's MRO: with no own method it takes every ancestor's x (may), not the first in C3 order.
.decl mro_method(cq: symbol, x: symbol, f: node)
mro_method(cq, x, f) :- method(cq, x, f).
mro_method(cq, x, f) :- class_def(_, cq), !method(cq, x, _), subclass(cq, b), method(b, x, f).
// assigned_attr(f, obj, attr, rhs): in function f, `obj.attr = rhs` where obj is a plain name (typically
// `self.x = ...` in `__init__`). obj is the name's text, not resolved.
.decl assigned_attr(f: node, obj: symbol, attr: symbol, rhs: node)
assigned_attr(f, o, a, r) :- kind(s, "assignment"), field(s, "left", l), kind(l, "attribute"),
    field(l, "object", on), text(on, o), field(l, "attribute", an), text(an, a), field(s, "right", r),
    nearest(s, f, fdef).

// target_form(t, form): which statement form an untracked target t belongs to, from the nearest enclosing
// statement kind of the list (e.g. `for x in xs` gives "for"). Used by binding for its last rule.
.decl target_form(t: node, form: symbol)
// target_stmt: the statement kinds a target can belong to; the climb stops at the first of them.
.decl target_stmt(kind: symbol)
target_stmt("assignment"). target_stmt("augmented_assignment"). target_stmt("for_statement").
target_stmt("for_in_clause"). target_stmt("named_expression"). target_stmt("with_item").
target_stmt("except_clause"). target_stmt("case_clause"). target_stmt("type_alias_statement").
target_form(t, f) :- nearest(t, a, target_stmt), kind(a, k), form_of_kind(k, f).
// form_of_kind(k, form): node kind to the short form name used in binding.
.decl form_of_kind(k: symbol, form: symbol)
form_of_kind("assignment", "assign"). form_of_kind("augmented_assignment", "augassign").
form_of_kind("for_statement", "for"). form_of_kind("for_in_clause", "for"). form_of_kind("named_expression", "walrus").
form_of_kind("with_item", "with"). form_of_kind("except_clause", "except"). form_of_kind("case_clause", "match").
form_of_kind("type_alias_statement", "type").

// imported_sym(n, q): like sym_of, through an import binding only.
// No re-export following and no local definitions: q is exactly what the import spelled.
.decl imported_sym(n: node, q: symbol)
imported_sym(n, q) :- qn(n, q).

// Binding filters, after Ruff's binding flags (rerail.policy/v1 `binding` / `binds` keys).
// Each is a unary property of a binding site, so a rule can say e.g. "an unused, non-exported import".
// site_scope(site, k): kind of the owning scope: "module", "function", "class", "lambda", "comprehension", "generator".
.decl site_scope(site: node, k: symbol)
site_scope(site, k) :- binding(s, _, site, _), kind(s, sk), scope_kind(sk, k).
.decl scope_kind(k: symbol, name: symbol)
scope_kind("module", "module"). scope_kind("function_definition", "function"). scope_kind("class_definition", "class").
scope_kind("lambda", "lambda"). scope_kind("list_comprehension", "comprehension").
scope_kind("set_comprehension", "comprehension"). scope_kind("dictionary_comprehension", "comprehension").
scope_kind("generator_expression", "generator").
// site_annotation(site, a): the site carries type annotation a (`x: int = 1`, `def f(x: int)`).
.decl site_annotation(site: node, a: node)
site_annotation(a, t) :- kind(a, "assignment"), field(a, "type", t).
site_annotation(p, t) :- kind(p, "typed_parameter"), field(p, "type", t).
.decl site_used(site: node)  // some reference reads it
site_used(site) :- ref_site(_, site).
.decl site_only(site: node)  // no other binding of the name in its scope
site_only(site) :- binding(s, x, site, _), count : { binding(s, x, o, _), o != site } = 0.
// site_latest: no later binding o of the same name lies inside a top-level statement st that binds the name.
.decl site_latest(site: node)  // not rebound later, unconditionally, in its scope
site_latest(site) :- binding(s, x, site, _), count : { binding(s, x, o, _), sbinds(s, x, st), within(o, st), o > site } = 0.
.decl site_exported(site: node)  // a module-level binding listed in __all__ or not underscore-private
site_exported(site) :- binding(s, x, site, _), kind(s, "module"), module_of(s, m), public_name(m, x).
.decl site_outer(site: node)  // bound in an enclosing function's scope, read from a nested one
site_outer(site) :- ref_site(r, site), nearest(r, s, scope), binding(t, _, site, _), t != s.
// site_stop_at_global: the site sits in a scope that declared the name `global`, so it binds the module's name.
.decl site_stop_at_global(site: node)
site_stop_at_global(site) :- binding(s, x, site, _), decl(s, x, m), kind(m, "module").

// typing_mod(m): m is a module of typing members, `typing` or its backport `typing_extensions`.
.decl typing_mod(m: symbol)
typing_mod("typing"). typing_mod("typing_extensions").
// py_keyword(x): x is one of Python 3's hard keywords, never a name.
.decl py_keyword(x: symbol)
py_keyword("False"). py_keyword("None"). py_keyword("True"). py_keyword("and"). py_keyword("as").
py_keyword("assert"). py_keyword("async"). py_keyword("await"). py_keyword("break"). py_keyword("class").
py_keyword("continue"). py_keyword("def"). py_keyword("del"). py_keyword("elif"). py_keyword("else").
py_keyword("except"). py_keyword("finally"). py_keyword("for"). py_keyword("from"). py_keyword("global").
py_keyword("if"). py_keyword("import"). py_keyword("in"). py_keyword("is"). py_keyword("lambda").
py_keyword("nonlocal"). py_keyword("not"). py_keyword("or"). py_keyword("pass"). py_keyword("raise").
py_keyword("return"). py_keyword("try"). py_keyword("while"). py_keyword("with"). py_keyword("yield").
// builtin(x): x is a name in Python's builtins module (functions, constants, exception classes), or a module
// attribute every module has (`__file__`, `__builtins__`): Python 3.13's full list.
.decl builtin(x: symbol)  // shipped with the library as facts (generated from the Python version's builtins)
// The builtin facts: one row per name builtin_ref accepts. Exceptions are included so `except ValueError` resolves
// to "builtins.ValueError" through sym_of.
builtin("abs"). builtin("aiter"). builtin("all"). builtin("anext"). builtin("any"). builtin("ascii"). builtin("bin").
builtin("bool"). builtin("breakpoint"). builtin("bytearray"). builtin("bytes"). builtin("callable"). builtin("chr").
builtin("classmethod"). builtin("compile"). builtin("complex"). builtin("delattr"). builtin("dict"). builtin("dir").
builtin("divmod"). builtin("enumerate"). builtin("eval"). builtin("exec"). builtin("filter"). builtin("float").
builtin("format"). builtin("frozenset"). builtin("getattr"). builtin("globals"). builtin("hasattr"). builtin("hash").
builtin("help"). builtin("hex"). builtin("id"). builtin("input"). builtin("int"). builtin("isinstance").
builtin("issubclass"). builtin("iter"). builtin("len"). builtin("list"). builtin("locals"). builtin("map"). builtin("max").
builtin("memoryview"). builtin("min"). builtin("next"). builtin("object"). builtin("oct"). builtin("open"). builtin("ord").
builtin("pow"). builtin("print"). builtin("property"). builtin("range"). builtin("repr"). builtin("reversed").
builtin("round"). builtin("set"). builtin("setattr"). builtin("slice"). builtin("sorted"). builtin("staticmethod").
builtin("str"). builtin("sum"). builtin("super"). builtin("tuple"). builtin("type"). builtin("vars"). builtin("zip").
builtin("__import__"). builtin("__name__"). builtin("__file__"). builtin("__doc__"). builtin("__spec__"). builtin("__debug__").
builtin("NotImplemented"). builtin("Ellipsis"). builtin("BaseException"). builtin("Exception"). builtin("ValueError").
builtin("TypeError"). builtin("KeyError"). builtin("IndexError"). builtin("AttributeError"). builtin("RuntimeError").
builtin("NotImplementedError"). builtin("OSError"). builtin("ImportError"). builtin("StopIteration"). builtin("LookupError").
builtin("ArithmeticError"). builtin("AssertionError"). builtin("EOFError"). builtin("FileNotFoundError").
builtin("ModuleNotFoundError"). builtin("NameError"). builtin("OverflowError"). builtin("PermissionError").
builtin("RecursionError"). builtin("UnicodeError"). builtin("UnicodeDecodeError"). builtin("UnicodeEncodeError").
builtin("ZeroDivisionError"). builtin("KeyboardInterrupt"). builtin("SystemExit"). builtin("Warning").
builtin("DeprecationWarning"). builtin("UserWarning"). builtin("RuntimeWarning"). builtin("EnvironmentError").
builtin("IOError"). builtin("BufferError"). builtin("ConnectionError"). builtin("TimeoutError"). builtin("GeneratorExit").
// The rest of Python 3.13's builtins module, as Ruff's python_builtins lists it. WindowsError is there on every
// platform (Ruff counts it everywhere); True, False and None are keywords, never an identifier, but are names of the
// module. Then the module attributes every module has (Ruff's MAGIC_GLOBALS and `__builtins__`).
builtin("BaseExceptionGroup"). builtin("BlockingIOError"). builtin("BrokenPipeError"). builtin("BytesWarning").
builtin("ChildProcessError"). builtin("ConnectionAbortedError"). builtin("ConnectionRefusedError").
builtin("ConnectionResetError"). builtin("EncodingWarning"). builtin("ExceptionGroup"). builtin("FileExistsError").
builtin("FloatingPointError"). builtin("FutureWarning"). builtin("ImportWarning"). builtin("IndentationError").
builtin("InterruptedError"). builtin("IsADirectoryError"). builtin("MemoryError"). builtin("NotADirectoryError").
builtin("PendingDeprecationWarning"). builtin("ProcessLookupError"). builtin("PythonFinalizationError").
builtin("ReferenceError"). builtin("ResourceWarning"). builtin("StopAsyncIteration"). builtin("SyntaxError").
builtin("SyntaxWarning"). builtin("SystemError"). builtin("TabError"). builtin("UnboundLocalError").
builtin("UnicodeTranslateError"). builtin("UnicodeWarning"). builtin("WindowsError"). builtin("False").
builtin("None"). builtin("True"). builtin("copyright"). builtin("credits"). builtin("exit"). builtin("license").
builtin("quit"). builtin("__build_class__"). builtin("__loader__"). builtin("__package__").
builtin("__annotations__"). builtin("__builtins__"). builtin("__cached__").
