// python/calls: call targets and call chains (the targets: python/points-to, the analysis phase's typing).
// COPY: Typing-support-final-shape@b193a9209:docs/rule-syntax/lib/python/calls.rerail (the call relations; its type
// relations are python/types here), with this branch's syntax helpers (posarg skips comments; dexpr).
//
// The call targets are python/points-to's: the analysis phase's typing (P3 of decision 0083 §1), the phase
// `points_to`, which the engine runs first (after struct and types), and whose answers each file reads at its own
// nodes. A call's target is its definition's symbol (decision 0677). A rule that reads only the syntax helpers below
// leaves them out of its program (pruned), and no phase runs for it.
//
// Three-valued:
//   call_target(c, f) rows and no call_open(c)  -> c calls exactly those f (definite)
//   call_open(c)                                -> c may call something else too (unknown)
//   neither                                     -> c calls no workspace function (e.g. `len(x)`)
// Rules must not treat a missing call_target as "calls nothing" when call_open holds.
//
// What the program covers: LEGB lookup and imports (relative ones of any depth), later unconditional bindings
// shadowing earlier ones, decorators (transparent ones, workspace decorators through their returns; a def under
// decorators imported from outside the run, such as `@contextmanager` or `@lru_cache`, is a call's target and the call
// is open; a `…property` and others unknown), classes and inheritance (method lookup in C3 order, constructors to
// `__new__` and `__init__`, a metaclass's `__call__`, instances to `__call__`), late-bound self/cls, `super()`, and
// functions flowing through assignments, returns and a returned parameter. Data flow through containers,
// getattr/setattr and attributes set outside classes give call_open, never a wrong target.
//
// Interface: call_target, call_open, calls, calls_open, reach, method_sym, mro_method_sym (over definitions' symbols),
// owner, and the syntax helpers call, callee, call_arg, posarg, dexpr, awaited.
#include "python/names.rerail"
#include "python/imports.rerail"
// fdef (a def node) comes from python/names.

// ---- call targets: python/points-to -------------------------------------------------------------------------------
#include "python/points-to.rerail"
// ---- call chains ----------------------------------------------------------------------------------------------
// owner(c, f): f is the nearest enclosing def of call c (a lambda's or a nested class body's calls are the
// enclosing function's).
.decl owner(c: node, f: node)
owner(c, f) :- kind(c, "call"), nearest(c, f, fdef).
// order_key(n, q, i): node n's place, which an edit elsewhere does not move: its def's qualified name q ("" at
// module level) and its offset i in the def's visit order. Per-file. A rule choosing one of several nodes across
// files orders by it, where a position would make the cross-file part read one (decision 0695).
.decl order_key(n: node, q: symbol, i: number)
order_key(n, q, i) :- nearest(n, h, fdef), qualname(h, q), visit_index(h, a), visit_index(n, b), i = b - a.
order_key(n, "", i) :- kind(n, _), !nearest(n, _, fdef), visit_index(n, i).
// The call graph is over definitions' symbols (decision 0677: no node crosses files): `call_target`'s, and a def's
// own by `pt_tm` (python/points-to-file). A rule reads a def's node in its own file: `pt_def(f, q)`.
// calls(f, g): the call graph edge "f may call g".
.decl calls(f: symbol, g: symbol)
calls(q, g) :- owner(c, f), pt_tm(f, q), call_target(c, g).
// calls_open(f): f makes at least one call whose target is unknown, so its out-edges are incomplete.
.decl calls_open(f: symbol)
calls_open(q) :- owner(c, f), pt_tm(f, q), call_open(c).
// reach(f, g): f may call g, directly or through a chain of calls. Only the known side: a chain through a
// calls_open function may reach more.
.decl reach(f: symbol, g: symbol)
reach(f, g) :- calls(f, g).
reach(f, h) :- reach(f, g), calls(g, h).
// method_sym(cq, x, f): class cq defines method x, whose definition's symbol is f: `method` (python/scopes) by
// symbol, so a rule that walks classes and calls across files holds no node.
.decl method_sym(cq: symbol, x: symbol, f: symbol)
method_sym(cq, x, q) :- method(cq, x, f), pt_tm(f, q).
// mro_method_sym(cq, x, f): `mro_method` by symbol: cq's own method x, else each ancestor's.
.decl mro_method_sym(cq: symbol, x: symbol, f: symbol)
mro_method_sym(cq, x, q) :- method_sym(cq, x, q).
mro_method_sym(cq, x, q) :- class_def(_, cq), !method_sym(cq, x, _), subclass(cq, b), method_sym(b, x, q).

// ---- syntax --------------------------------------------------------------------------------------------------------
// call(c): c is a call expression.
.decl call(c: node)
call(c) :- kind(c, "call").
// call_arg, posarg: python/syntax.
// callee(c, e): e is the function expression of call c (`f` in `f(x)`, `obj.m` in `obj.m()`).
.decl callee(c: node, e: node)
callee(c, e) :- kind(c, "call"), field(c, "function", e).
// dexpr(f, e): e is a decorator expression on definition f (`@cache` gives the name node, `@route("/")` the call).
.decl dexpr(f: node, e: node)
dexpr(f, e) :- kind(dd, "decorated_definition"), field(dd, "definition", f), child(dd, dc, _), kind(dc, "decorator"), child(dc, e, 0).
// awaited(c): call c is the operand of `await` (`await fetch()`), so a coroutine it returns is consumed.
.decl awaited(c: node)
awaited(c) :- kind(c, "call"), child(w, c, 0), kind(w, "await").

// ---- tests ---------------------------------------------------------------------------------------------------------
// A test's answer pairs a call's line with its target def's, in another file: it spans files (`cross_file`, decision
// 0652), as no rule's relation may.
// A call of a def under decorators: by the call's line, the line of each def it targets, and whether it is open.
.fixtures decorated
    .fixture "app/defs.py" ```
        import functools
        from contextlib import contextmanager
        from retrylib import retry, traced


        @contextmanager
        def held():
            yield 1


        @functools.lru_cache(maxsize=None)
        def cached():
            return 1


        def mine(f):
            @functools.wraps(f)
            def w(*args):
                return f(*args)

            return w


        @mine
        def wrapped():
            return 2


        @retry(3)
        @traced
        def stacked():
            return 3


        class Box:
            @staticmethod
            def make():
                return Box()

            @functools.cached_property
            def size(self):
                return 1


        def use():
            with held():
                pass
            cached()
            wrapped()
            stacked()
            Box.make()
            Box().size()
        ```
    .fixture "app/__init__.py" ```
        # package
        ```
    .fixture "app/compat.py" ```
        import functools


        def cache(f):
            @functools.wraps(f)
            def w(*args):
                return f(*args)

            return w
        ```
    .fixture "app/both.py" ```
        try:
            from fastlib import cache
        except ImportError:
            from .compat import cache


        @cache
        def computed():
            return 1


        def use():
            computed()
        ```
    .fixture "app/diamond.py" ```
        import functools


        class A:
            @functools.lru_cache(maxsize=None)
            def who(self):
                return "A"


        class B(A):
            pass


        class C(A):
            def who(self):
                return "C"


        class D(B, C):
            pass


        def use():
            D().who()
        ```
.end

// A decorator imported from outside the run: the call targets the def and is open.
.test an_outside_decorator_keeps_the_def_as_the_target uses decorated
    .decl target_at(l: number, f: number) cross_file
    target_at(l, f) :- call_target(c, d), line(c, l), pt_def(g, d), line(g, f).
    .decl open_at(l: number)
    open_at(l) :- call_open(c), line(c, l).
    .expect target_at(46, 7)
    .expect open_at(46)
    .expect target_at(48, 12)
    .expect open_at(48)
.end

// A decorator of the run: the call targets the wrapper it returns, as before, and is not open.
.test a_decorator_of_the_run_gives_its_wrapper uses decorated
    .decl target_at(l: number, f: number) cross_file
    target_at(l, f) :- call_target(c, d), line(c, l), pt_def(g, d), line(g, f).
    .decl open_at(l: number)
    open_at(l) :- call_open(c), line(c, l).
    .expect target_at(49, 18)
    .expect no target_at(49, 25)
    .expect no open_at(49)
.end

// Two outside decorators stacked: the def is the target, and the call is open.
.test stacked_outside_decorators_keep_the_def_as_the_target uses decorated
    .decl target_at(l: number, f: number) cross_file
    target_at(l, f) :- call_target(c, d), line(c, l), pt_def(g, d), line(g, f).
    .decl open_at(l: number)
    open_at(l) :- call_open(c), line(c, l).
    .expect target_at(50, 31)
    .expect open_at(50)
.end

// A decorator the program already handles is unchanged: `@staticmethod` is transparent, so the call is definite. An
// outside `…property` replaces the def by a value its call does not run: open, no target.
.test a_handled_decorator_and_a_property_are_unchanged uses decorated
    .decl target_at(l: number, f: number) cross_file
    target_at(l, f) :- call_target(c, d), line(c, l), pt_def(g, d), line(g, f).
    .decl open_at(l: number)
    open_at(l) :- call_open(c), line(c, l).
    .decl targeted(l: number)
    targeted(l) :- target_at(l, _).
    .expect target_at(51, 37)
    .expect no open_at(51)
    .expect no targeted(52)
    .expect open_at(52)
.end

// A decorator imported from outside the run and from a module of the run (`except ImportError: from .compat import
// cache`) may be the run's: the call targets its wrapper (`w`, app/compat.py:6), not the def.
.test a_decorator_the_run_also_defines_gives_its_wrapper uses decorated
    .decl both_target(l: number, f: number) cross_file
    both_target(l, f) :- call_target(c, d), docof(c, k), doc(k, "app/both.py", _), line(c, l), pt_def(g, d), line(g, f).
    .expect both_target(13, 6)
    .expect no both_target(13, 8)
.end

// A method under an outside decorator is resolved in C3 order: in the diamond D(B, C) over A, `D().who()` runs
// C.who (line 15), never A's `@lru_cache` who (line 6), which C overrides.
.test an_outside_decorated_method_follows_the_method_order uses decorated
    .decl diamond_target(l: number, f: number) cross_file
    diamond_target(l, f) :- call_target(c, d), docof(c, k), doc(k, "app/diamond.py", _), line(c, l), pt_def(g, d), line(g, f).
    .expect diamond_target(24, 15)
    .expect no diamond_target(24, 6)
.end
