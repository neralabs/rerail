// python/points-to: Python's call targets and value types, as a rule reads them (P3 of decision 0083 §1; decision 0677,
// note t55). The analysis is the phase `points_to` (typing/programs/points_to.rerail, over python/points-to-solve):
// its fixpoint across files runs first, over symbols and node paths, and hands on its answers by each file's path and
// each node's path (decision 0722). A rule reads them here, at its own nodes, each answer's path decoded in its own
// file (`@path_node`): each relation below is per file, and no node's path is made but the answers'.
//
// Interface (python/calls reads the calls, python/types the types):
//   call_target(c, f)    call c may run definition f, f its symbol (`m.C.run`; `m.f#1`, a name's second definition
//                        in its scope). The definition's node is in its own file: `pt_def(g, f)` there.
//   call_open(c)         c may run something else too (unknown). Rules must not read a missing call_target as "calls
//                        nothing" when call_open holds.
//   type_of(n, t)        value position n may hold an instance of class t: a workspace class's qualified name, or a
//                        builtin's name (`int`, `str`, `None`, ...)
//   type_open(n)         n may also hold a value of a class not listed
//   proven_type(n, t)    `isinstance(n, t)` is true: every class n may hold is t or a subclass of it, none unlisted
//   possible_type(n, t)  `isinstance(n, t)` may be true
//   possible_open(n)     possible_type is incomplete
// A rule's `possible: t` is `possible_type(n, t)` or `possible_open(n)`; `not proven: t` is `!proven_type(n, t)`.
#include "python/points-to-file.rerail"
// A rule reads the terms of its own nodes alone: of the calls and value positions it asks about, not every node's.
// The phase's solve asks nearly every node's term (it hands each node fact on by term), so there demand made more
// rows than it spared, and its pragma is here, where only the readers include it (decision 0145).
.pragma "magic-transform" "pt_tm"

.decl points_to__call_target_at(p: symbol, t: node_path, f: symbol)
.decl points_to__call_open_at(p: symbol, t: node_path)
.decl points_to__type_of_at(p: symbol, t: node_path, u: symbol)
.decl points_to__type_open_at(p: symbol, t: node_path)
.decl points_to__proven_type_at(p: symbol, t: node_path, u: symbol)
.decl points_to__possible_type_at(p: symbol, t: node_path, u: symbol)
.decl points_to__possible_open_at(p: symbol, t: node_path)

.decl call_target(c: node, f: symbol)
call_target(c, f) :- points_to__call_target_at(p, t, f), c = @path_node(t), docof(c, d), doc(d, p, _).
.decl call_open(c: node)
call_open(c) :- points_to__call_open_at(p, t), c = @path_node(t), docof(c, d), doc(d, p, _).
.decl type_of(n: node, u: symbol)
type_of(n, u) :- points_to__type_of_at(p, t, u), n = @path_node(t), docof(n, d), doc(d, p, _).
.decl type_open(n: node)
type_open(n) :- points_to__type_open_at(p, t), n = @path_node(t), docof(n, d), doc(d, p, _).
.decl proven_type(n: node, u: symbol)
proven_type(n, u) :- points_to__proven_type_at(p, t, u), n = @path_node(t), docof(n, d), doc(d, p, _).
.decl possible_type(n: node, u: symbol)
possible_type(n, u) :- points_to__possible_type_at(p, t, u), n = @path_node(t), docof(n, d), doc(d, p, _).
.decl possible_open(n: node)
possible_open(n) :- points_to__possible_open_at(p, t), n = @path_node(t), docof(n, d), doc(d, p, _).
