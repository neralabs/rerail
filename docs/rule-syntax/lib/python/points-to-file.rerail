// python/points-to-file: each file's part of Python's points-to (P3 of decision 0083 §1, note t28), and the term each
// of its nodes is known by across files (decision 0677, note t55).
//
// Points-to answers what an expression may evaluate to (a function, a class, an instance of one, a module, `super()`)
// and, from that, a call's targets and a value's types. Its rules are in three files:
// - this one: what one file's syntax says (scopes and bindings, imports, decorators, annotations, the positions
//   whose values are read), over its own nodes, and each node's term (`pt_tm`, at the end);
// - python/points-to-solve: the rules that join files, over terms and symbols alone: no node crosses (0677);
// - python/points-to: the interface a rule reads (`call_target`, `call_open`, `type_of`, ...), read back at the
//   rule's own nodes from what the phase `points_to` (typing/programs/points_to.rerail) hands on.
// Every relation here is per file. Its own names start `pt_`.
//
// Guests (decision 0055): parsed(s, "annotation", r) asks for string s's code, rooted at r; host_node(n, h): h is
// the innermost host node over guest node n. A quoted annotation's code is the annotation context's (decision 0597,
// python/annotation): its instance of these rules reads its trees, and the host reads what it exports (below
// pt_aopen).
// The run's settings (the Python version and platform a branch is decided by, python/conditions.rerail). No library
// is loaded: the imports are resolved, and the libraries loaded, by phase 1 (sources.rerail).
#include "core.rerail"
#include "python/conditions.rerail"
#include "python/annotation.rerail"
.decl pt_scope(kind: symbol)
pt_scope("module"). pt_scope("function_definition"). pt_scope("class_definition"). pt_scope("lambda").
// What a name in a scope sees when its own scope does not bind it: class scopes are skipped.
.decl pt_fscope(kind: symbol)
pt_fscope("module"). pt_fscope("function_definition"). pt_fscope("lambda").
.decl pt_fdef(kind: symbol)
pt_fdef("function_definition").

.decl pt_modnode(d: number, m: node)
pt_modnode(d, m) :- node(d, m, "module", _, _).
.decl pt_modname(m: node, q: symbol)
pt_modname(m, q) :- pt_modnode(d, m), doc(d, _, q).

// ---- names read, and the scope that binds them ----------------------------------------------------------------
.decl pt_nameref(n: node, x: symbol)
pt_nameref(n, x) :- kind(n, "identifier"), text(n, x), !field(_, "attribute", n), !field(_, "name", n).
.decl pt_rdefn(s: node, x: symbol, f: node)
pt_rdefn(s, x, f) :- kind(f, "function_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, pt_scope), !py_dead_at(f).
pt_rdefn(s, x, f) :- kind(f, "class_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, pt_scope), !py_dead_at(f).
.decl pt_rasg(s: node, x: symbol, r: node, a: node)
pt_rasg(s, x, r, a) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", r), nearest(a, s, pt_scope), !py_dead_at(a).
// `for x in it`: x is bound to the loop target's value, `it.__iter__().__next__()` (implicit calls, `icall`); `with e
// as x`: to the alias's, `e.__enter__()`. Their `async` forms await `it.__aiter__().__anext__()` and `e.__aenter__()`
// (`iawait`).
pt_rasg(s, x, l, a) :- kind(a, "for_statement"), field(a, "left", l), kind(l, "identifier"), text(l, x), nearest(a, s, pt_scope),
    !py_dead_at(a).
pt_rasg(s, x, t, a) :- kind(a, "with_statement"), child(a, wc, _), child(wc, w, _), kind(w, "with_item"), field(w, "value", p),
    kind(p, "as_pattern"), field(p, "alias", t), child(t, i, 0), kind(i, "identifier"), text(i, x), nearest(a, s, pt_scope), !py_dead_at(a).
.decl pt_param(f: node, x: symbol, i: number)
pt_param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), kind(p, "identifier"), text(p, x).
pt_param(f, x, i) :- field(f, "parameters", ps), child(ps, p, i), child(p, id, 0), kind(id, "identifier"), text(id, x).
// Targets whose value is not tracked: patterns, loop and comprehension variables, `with`/`except` names, walrus,
// augmented assignment, and names a `global`/`nonlocal` declaration hands to another scope.
.decl pt_patkind(k: symbol)
pt_patkind("pattern_list"). pt_patkind("tuple_pattern"). pt_patkind("list_pattern"). pt_patkind("list_splat_pattern").
pt_patkind("parenthesized_expression"). pt_patkind("tuple"). pt_patkind("list"). pt_patkind("expression_list").
.decl pt_tgt(t: node)
pt_tgt(l) :- kind(a, "assignment"), field(a, "left", l), !kind(l, "identifier").
pt_tgt(l) :- kind(a, "augmented_assignment"), field(a, "left", l).
pt_tgt(l) :- kind(a, "for_statement"), field(a, "left", l), !kind(l, "identifier").
pt_tgt(l) :- kind(a, "for_in_clause"), field(a, "left", l).
pt_tgt(l) :- kind(a, "named_expression"), field(a, "name", l).
pt_tgt(l) :- kind(l, "as_pattern_target").
pt_tgt(c) :- pt_tgt(t), kind(t, k), pt_patkind(k), child(t, c, _).
pt_tgt(c) :- pt_tgt(t), kind(t, "as_pattern_target"), child(t, c, _), !pt_wtgt(t).
// A `with` alias bound by `rasg`.
.decl pt_wtgt(t: node)
pt_wtgt(t) :- pt_rasg(_, _, t, a), kind(a, "with_statement").
.decl pt_rotgt(s: node, x: symbol)
pt_rotgt(s, x) :- pt_tgt(t), kind(t, "identifier"), text(t, x), nearest(t, s, pt_scope).

// Imports, per scope: `pt_ibind(s, x, q)` binds x to the qualified name q; `ifrom` also keeps the module and name.
.decl pt_impmod(i: node, m: symbol)
pt_impmod(i, m) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "dotted_name"), text(mn, m), !py_dead_at(i).
pt_impmod(i, p) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"),
    child(mn, pre, 0), text(pre, "."), !child(mn, _, 1), docof(i, d), pkg(d, p), p != "", !py_dead_at(i).
pt_impmod(i, @dot(p, m)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"),
    child(mn, pre, 0), text(pre, "."), child(mn, dn, 1), text(dn, m), docof(i, d), pkg(d, p), p != "", !py_dead_at(i).
.decl pt_rifrom(s: node, x: symbol, m: symbol, y: symbol)
pt_rifrom(s, y, m, y) :- pt_impmod(i, m), field(i, "name", n), kind(n, "dotted_name"), text(n, y), nearest(i, s, pt_scope).
pt_rifrom(s, a, m, y) :- pt_impmod(i, m), field(i, "name", x), kind(x, "aliased_import"), field(x, "name", n), text(n, y),
    field(x, "alias", al), text(al, a), nearest(i, s, pt_scope).
.decl pt_ribind(s: node, x: symbol, q: symbol)
pt_ribind(s, x, @dot(m, y)) :- pt_rifrom(s, x, m, y).
pt_ribind(s, t, t) :- kind(i, "import_statement"), field(i, "name", n), kind(n, "dotted_name"), child(n, c, 0), text(c, t), nearest(i, s, pt_scope), !py_dead_at(i).
pt_ribind(s, a, m) :- kind(i, "import_statement"), field(i, "name", x), kind(x, "aliased_import"), field(x, "name", n), text(n, m),
    field(x, "alias", al), text(al, a), nearest(i, s, pt_scope), !py_dead_at(i).
// Two dots or more: `..` is the package's parent (`from .. import x` in `pkg.sub.deep` is `pkg`), one level up per dot.
.decl pt_updots(t: symbol, k: number)
pt_updots("..", 1). pt_updots("...", 2). pt_updots("....", 3).
pt_impmod(i, q) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"),
    child(mn, pre, 0), text(pre, t), pt_updots(t, k), !child(mn, _, 1), docof(i, d), pkg(d, p), q = @pkg_up(p, k), q != "", !py_dead_at(i).
pt_impmod(i, @dot(q, m)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"),
    child(mn, pre, 0), text(pre, t), pt_updots(t, k), child(mn, dn, 1), text(dn, m), docof(i, d), pkg(d, p),
    q = @pkg_up(p, k), q != "", !py_dead_at(i).
// A relative import the facts cannot place (more dots than packages, or outside a package): what it binds is unknown.
.decl pt_irel_open(i: node)
pt_irel_open(i) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"), !pt_impmod(i, _).
pt_rotgt(s, y) :- pt_irel_open(i), field(i, "name", n), kind(n, "dotted_name"), text(n, y), nearest(i, s, pt_scope).
pt_rotgt(s, a) :- pt_irel_open(i), field(i, "name", x), kind(x, "aliased_import"), field(x, "alias", al), text(al, a), nearest(i, s, pt_scope).
.decl pt_star(s: node)
pt_star(s) :- kind(i, "import_from_statement"), child(i, w, _), kind(w, "wildcard_import"), nearest(i, s, pt_scope).

// `global x` / `nonlocal x`: the scope's bindings of x are the module's / the enclosing function's.
.decl pt_decl(s: node, x: symbol, t: node)
pt_decl(s, x, m) :- kind(g, "global_statement"), child(g, i, _), text(i, x), nearest(g, s, pt_scope), docof(g, d), pt_modnode(d, m).
pt_decl(s, x, p) :- kind(g, "nonlocal_statement"), child(g, i, _), text(i, x), nearest(g, s, pt_scope), nearest(s, p, pt_fscope).
.decl pt_rbound(s: node, x: symbol)
pt_rbound(s, x) :- pt_rdefn(s, x, _).
pt_rbound(s, x) :- pt_rasg(s, x, _, _).
pt_rbound(s, x) :- pt_rotgt(s, x).
pt_rbound(s, x) :- pt_ribind(s, x, _).
.decl pt_home(s: node, x: symbol, t: node)
pt_home(s, x, s) :- pt_rbound(s, x), !pt_decl(s, x, _).
pt_home(s, x, t) :- pt_rbound(s, x), pt_decl(s, x, t).
.decl pt_defn(s: node, x: symbol, f: node)
pt_defn(t, x, f) :- pt_rdefn(s, x, f), pt_home(s, x, t).
.decl pt_asg(s: node, x: symbol, r: node, a: node)
pt_asg(t, x, r, a) :- pt_rasg(s, x, r, a), pt_home(s, x, t).
.decl pt_otgt(s: node, x: symbol)
pt_otgt(t, x) :- pt_rotgt(s, x), pt_home(s, x, t).
.decl pt_ifrom(s: node, x: symbol, m: symbol, y: symbol)
pt_ifrom(t, x, m, y) :- pt_rifrom(s, x, m, y), pt_home(s, x, t).
.decl pt_ibind(s: node, x: symbol, q: symbol)
pt_ibind(t, x, q) :- pt_ribind(s, x, q), pt_home(s, x, t).

.decl pt_bound_in(s: node, x: symbol)
pt_bound_in(s, x) :- pt_defn(s, x, _).
pt_bound_in(s, x) :- pt_asg(s, x, _, _).
pt_bound_in(f, x) :- pt_param(f, x, _).
pt_bound_in(s, x) :- pt_otgt(s, x).
pt_bound_in(s, x) :- pt_ibind(s, x, _).

// LEGB: from the nearest scope outwards, skipping class scopes, to the first that binds the name.
.decl pt_walk(n: node, x: symbol, s: node)
pt_walk(n, x, s) :- pt_nameref(n, x), nearest(n, s, pt_scope), !host_node(n, _).
// A name in a guest (a quoted annotation's code) is looked up from the string that holds it (pt_hstart), and steps
// through the host's scopes (pt_up: a module has no step), which the annotation context reads finished.
pt_walk(n, x, s) :- pt_nameref(n, x), host_node(n, h), pt_hstart(h, s).
pt_walk(n, x, p) :- pt_walk(n, x, s), !pt_bound_in(s, x), pt_up(s, p).
.decl pt_hstart(h: node, s: node)
pt_hstart(h, s) :- ann_host(h, t), nearest(t, s, pt_scope).   // h: a tree's host node (python/annotation)
.decl pt_up(s: node, p: node)
pt_up(s, p) :- kind(s, k), pt_scope(k), nearest(s, p, pt_fscope).
.decl pt_look(n: node, x: symbol, s: node)
pt_look(n, x, s) :- pt_walk(n, x, s), pt_bound_in(s, x).
// Bound nowhere: a builtin, or (a star import, `globals()`) unknown.
.decl pt_miss(n: node, x: symbol)
pt_miss(n, x) :- pt_walk(n, x, m), !pt_up(m, _), !pt_bound_in(m, x).
.decl pt_builtin_ref(n: node, x: symbol)
pt_builtin_ref(n, x) :- pt_miss(n, x), pt_builtin(x), docof(n, d), pt_modnode(d, m), !pt_star(m).

// ---- unconditional rebinding --------------------------------------------------------------------------------------
// A statement of a scope's own body (not inside an `if`, loop or `try`) binding x; a later one replaces an earlier one.
.decl pt_stmt(st: node, s: node)
pt_stmt(st, s) :- kind(s, "module"), child(s, st, _).
pt_stmt(st, s) :- kind(s, "function_definition"), field(s, "body", b), child(b, st, _).
pt_stmt(st, s) :- kind(s, "class_definition"), field(s, "body", b), child(b, st, _).
.decl pt_defstmt(f: node, st: node)
pt_defstmt(f, f) :- kind(f, "function_definition").
pt_defstmt(f, f) :- kind(f, "class_definition").
pt_defstmt(f, st) :- kind(st, "decorated_definition"), field(st, "definition", f).
.decl pt_asgstmt(a: node, st: node)
pt_asgstmt(a, st) :- kind(st, "expression_statement"), child(st, a, 0), kind(a, "assignment").
.decl pt_sbinds(s: node, x: symbol, st: node)
pt_sbinds(s, x, st) :- pt_defn(s, x, f), pt_defstmt(f, st), pt_stmt(st, s).
pt_sbinds(s, x, st) :- pt_asg(s, x, _, a), pt_asgstmt(a, st), pt_stmt(st, s).
// An `@overload` def does not replace an earlier one: a stub's overloads are all the name's (their union is its
// type), and a later def that is not an overload (the implementation) replaces them all. Read from the decorator's
// own name, not its import: what a name is depends on what is live, which depends on this.
.decl pt_ovlstmt(st: node)
pt_ovlstmt(st) :- kind(st, "decorated_definition"), child(st, dc, _), kind(dc, "decorator"), child(dc, e, 0), text(e, "overload").
pt_ovlstmt(st) :- kind(st, "decorated_definition"), child(st, dc, _), kind(dc, "decorator"), child(dc, e, 0), kind(e, "attribute"),
    field(e, "attribute", a), text(a, "overload").
.decl pt_shadowed(st: node)
pt_shadowed(st) :- pt_sbinds(s, x, st), pt_sbinds(s, x, st2), st2 > st, !pt_ovlstmt(st2).
pt_shadowed(st) :- pt_sbinds(s, x, st), pt_sbinds(s, x, st2), st2 > st, !pt_ovlstmt(st).
.decl pt_live_def(s: node, x: symbol, f: node)
pt_live_def(s, x, f) :- pt_defn(s, x, f), pt_defstmt(f, st), !pt_shadowed(st).
.decl pt_live_asg(s: node, x: symbol, r: node)
pt_live_asg(s, x, r) :- pt_asg(s, x, r, a), !pt_asgstmt(a, _).
pt_live_asg(s, x, r) :- pt_asg(s, x, r, a), pt_asgstmt(a, st), !pt_shadowed(st).

// ---- decorators ---------------------------------------------------------------------------------------------------
.decl pt_dexpr(f: node, e: node)
pt_dexpr(f, e) :- kind(dd, "decorated_definition"), field(dd, "definition", f), child(dd, dc, _), kind(dc, "decorator"), child(dc, e, 0).
.decl pt_transparent_q(q: symbol)
pt_transparent_q("abc.abstractmethod"). pt_transparent_q("typing.final"). pt_transparent_q("typing.override").
pt_transparent_q("typing.no_type_check"). pt_transparent_q("typing_extensions.final"). pt_transparent_q("typing_extensions.override").
pt_transparent_q("functools.wraps"). pt_transparent_q("functools.total_ordering"). pt_transparent_q("dataclasses.dataclass").
// The decorators stubs use (t21 §2.4): each gives back what it decorates, as a type checker reads it.
pt_transparent_q("typing.overload"). pt_transparent_q("typing_extensions.overload"). pt_transparent_q("typing.type_check_only").
pt_transparent_q("typing_extensions.deprecated"). pt_transparent_q("warnings.deprecated"). pt_transparent_q("typing.runtime_checkable").
pt_transparent_q("typing_extensions.runtime_checkable"). pt_transparent_q("typing_extensions.type_check_only").
pt_transparent_q("typing_extensions.disjoint_base"). pt_transparent_q("typing.disjoint_base").
.decl pt_transparent(e: node)
pt_transparent(e) :- pt_qn(e, q), pt_transparent_q(q).
pt_transparent(e) :- kind(e, "call"), field(e, "function", g), pt_qn(g, q), pt_transparent_q(q).
// One defined in the module that uses it (typing.pyi's own `@overload`), by its qualified name: syntactic, as what
// a name is depends on the decorators.
// pt_ownq(e, q): identifier e, as a name of its own module (`typing.overload` in typing.pyi).
.decl pt_ownq(e: node, q: symbol)
pt_ownq(e, q) :- kind(e, "identifier"), text(e, x), docof(e, d), doc(d, _, m), q = @dot(m, x).
pt_transparent(e) :- pt_ownq(e, q), pt_transparent_q(q).
pt_transparent(e) :- pt_builtin_ref(e, "staticmethod").
pt_transparent(e) :- pt_builtin_ref(e, "classmethod").
.decl pt_opaque_dec(f: node, e: node)
pt_opaque_dec(f, e) :- pt_dexpr(f, e), !pt_transparent(e).
.decl pt_isstatic(f: node)
pt_isstatic(f) :- pt_dexpr(f, e), pt_builtin_ref(e, "staticmethod").
.decl pt_classmeth(f: node)
pt_classmeth(f) :- pt_dexpr(f, e), pt_builtin_ref(e, "classmethod").
.decl pt_nopaque(f: node, k: number)
pt_nopaque(f, k) :- pt_opaque_dec(f, _), k = count : { pt_opaque_dec(f, _) }.
// The one decorator that replaces the definition, when there is exactly one.
.decl pt_dec1(f: node, e: node)
pt_dec1(f, e) :- pt_nopaque(f, 1), pt_opaque_dec(f, e).
// A def whose every decorator not transparent is imported from outside the run, and is not one a library declares
// (`@retry(3)` of a library without stubs; a declared one, `contextmanager`, is `pt_ldec_known`'s), is still the code
// a call of its name runs, as far as the program can tell: such a decorator wraps the def and calls it, or gives it
// back. Its name holds `dfn` f: a call of it targets f, and is open (`pt_bopen`), for the wrapper is code the program
// does not read. A decorator that replaces the def by a value whose call does not run it (a `…property`,
// `functools.cached_property`) keeps the name unknown, with no target. (main's #875, on calls.rerail's program.)
// pt_dpart(e, p): p is decorator expression e or a part of its head (`functools.lru_cache` and `functools` of
// `functools.lru_cache(maxsize=None)`).
.decl pt_dpart(e: node, p: node)
pt_dpart(e, e) :- pt_dexpr(_, e).
pt_dpart(e, o) :- pt_dpart(e, p), kind(p, "attribute"), field(p, "object", o).
pt_dpart(e, g) :- pt_dpart(e, p), kind(p, "call"), field(p, "function", g).
// pt_dleaf(e, x): the last name of decorator e, or of the function a decorator call calls (`lru_cache`, `setter`).
.decl pt_dleaf(e: node, x: symbol)
pt_dleaf(e, x) :- pt_dexpr(_, e), kind(e, "identifier"), text(e, x).
pt_dleaf(e, x) :- pt_dexpr(_, e), pt_attr_of(e, _, x).
pt_dleaf(e, x) :- pt_dexpr(_, e), kind(e, "call"), field(e, "function", g), kind(g, "identifier"), text(g, x).
pt_dleaf(e, x) :- pt_dexpr(_, e), kind(e, "call"), field(e, "function", g), pt_attr_of(g, _, x).
.decl pt_replacing_dec(e: node)
pt_replacing_dec(e) :- pt_dleaf(e, x), suffix("property", x).

// ---- functions: returns, returned parameters ----------------------------------------------------------------------
.decl pt_isasync(f: node)
pt_isasync(f) :- op(f, "async").
.decl pt_isgen(f: node)
pt_isgen(f) :- kind(y, "yield"), nearest(y, f, pt_fscope), kind(f, "function_definition").
.decl pt_retval(f: node, r: node)
pt_retval(f, r) :- kind(rs, "return_statement"), nearest(rs, f, pt_fscope), kind(f, "function_definition"), child(rs, r, 0).
// A return of the function's own parameter i (`return func`): the call's value is its i-th argument's.
.decl pt_retparam(f: node, i: number, r: node)
pt_retparam(f, i, r) :- pt_retval(f, r), pt_look(r, x, f), pt_param(f, x, i).
.decl pt_posarg(c: node, i: number, a: node)
pt_posarg(c, i, a) :- kind(c, "call"), field(c, "arguments", as), kind(as, "argument_list"), child(as, a, i), !kind(a, "keyword_argument"),
    !kind(a, "list_splat"), !kind(a, "dictionary_splat").
.decl pt_method(f: node, c: node)
pt_method(f, c) :- kind(f, "function_definition"), nearest(f, c, pt_scope), kind(c, "class_definition").

// ---- classes ------------------------------------------------------------------------------------------------------
.decl pt_basex(c: node, e: node)
pt_basex(c, e) :- kind(c, "class_definition"), field(c, "superclasses", al), child(al, e, _), !kind(e, "keyword_argument").

// ---- declared types (annotations) ---------------------------------------------------------------------------------
// A parameter's, a return's and a class attribute's annotation declare the values they hold. They are trusted, as a
// type checker trusts them: an annotation naming a workspace class C holds an instance of C or of any workspace
// subclass (the closed world `self` already assumes), a builtin class's name a value of it, `None` None. Unions
// (`A | B`, `Optional[A]`, `Union[A, B]`) are their members; a generic (`LazyResult[T]`, `list[int]`) is its class,
// without arguments; `type[C]` is C's class objects; `Self` is the method's class. Any other member (a type
// variable, `Any`, a `Protocol`, an external class) leaves the declaration open: its known members are a lower
// bound. A quoted annotation (`x: "Node"`, `list["Node"]`) is its code, parsed as an annotation (decision 0055).
.decl pt_ann(t: node, e: node)
pt_ann(t, e) :- kind(t, "type"), child(t, e, 0).
// pt_qann(s, e): string s is an annotation's whole expression, and e is its code's expression: the fragment
// "annotation" is rooted at a `type`, as tree-sitter writes an annotation (decision 0466), whose child is the
// expression (T's shape rooted it at a module of one statement, `(…)`; before 0466 the root was the expression).
// pt_qstr(s): string s is an annotation's whole expression, quoted, with a tree (python/annotation's ann_parse).
.decl pt_qstr(s: node)
pt_qstr(s) :- kind(t, "type"), child(t, s, 0), kind(s, "string"), ann_parse(s, _).
.decl pt_qann(s: node, e: node)
pt_qann(s, e) :- pt_qstr(s), ann_parse(s, r),
    (kind(r, "type"), child(r, e, 0) ; !kind(r, "type"), e = r).
.decl pt_union_q(q: symbol)
pt_union_q("typing.Optional"). pt_union_q("typing.Union"). pt_union_q("typing_extensions.Optional"). pt_union_q("typing_extensions.Union").
.decl pt_uhead(e: node)
pt_uhead(e) :- kind(e, "generic_type"), child(e, h, 0), pt_qn(h, q), pt_union_q(q).
pt_uhead(e) :- kind(e, "subscript"), field(e, "value", h), pt_qn(h, q), pt_union_q(q).
// pt_amem(t, e): e is a member of annotation t's union, or an expression that has members.
.decl pt_amem(t: node, e: node)
pt_amem(t, e) :- pt_ann(t, e).
pt_amem(t, m) :- pt_amem(t, e), kind(e, "binary_operator"), op(e, "|"), field(e, "left", m).
pt_amem(t, m) :- pt_amem(t, e), kind(e, "binary_operator"), op(e, "|"), field(e, "right", m).
pt_amem(t, m) :- pt_amem(t, e), kind(e, "parenthesized_expression"), child(e, m, 0).
pt_amem(t, r) :- pt_amem(t, s), host_node(s, _), pt_qann(s, r).   // a string nested in a quoted annotation's code
pt_amem(t, m) :- pt_amem(t, e), kind(e, "union_type"), child(e, u, _), child(u, m, 0).
pt_amem(t, m) :- pt_amem(t, e), pt_uhead(e), kind(e, "generic_type"), child(e, p, 1), child(p, u, _), child(u, m, 0).
pt_amem(t, m) :- pt_amem(t, e), pt_uhead(e), kind(e, "subscript"), field(e, "subscript", m).
.decl pt_asplit(e: node)
pt_asplit(e) :- kind(e, "binary_operator"), op(e, "|").
pt_asplit(e) :- kind(e, "parenthesized_expression").
pt_asplit(s) :- pt_qstr(s).
pt_asplit(e) :- kind(e, "union_type").
pt_asplit(e) :- pt_uhead(e).
// A member that is not split further, and the name it is headed by (`LazyResult` in `LazyResult[T]`).
.decl pt_aleaf(t: node, m: node)
pt_aleaf(t, m) :- pt_amem(t, m), !pt_asplit(m).
pt_aleaf(t, m) :- pt_amem(t, m), kind(m, "binary_operator"), !op(m, "|").
.decl pt_ahead(m: node, h: node)
pt_ahead(m, h) :- pt_aleaf(_, m), kind(m, "generic_type"), child(m, h, 0).
pt_ahead(m, h) :- pt_aleaf(_, m), kind(m, "subscript"), field(m, "value", h).
pt_ahead(m, m) :- pt_aleaf(_, m), !kind(m, "generic_type"), !kind(m, "subscript").
// The argument of a one-argument generic (`C` in `type[C]`).
.decl pt_aarg(m: node, a: node)
pt_aarg(m, a) :- kind(m, "generic_type"), child(m, p, 1), child(p, u, 0), !child(p, _, 1), child(u, a, 0).
pt_aarg(m, a) :- kind(m, "subscript"), field(m, "subscript", a), !kind(a, "expression_list"), !kind(a, "tuple").
// pt_aself(m): `Self`.
.decl pt_aself(m: node)
pt_aself(m) :- pt_aleaf(_, m), pt_ahead(m, h), pt_qn(h, "typing.Self").
pt_aself(m) :- pt_aleaf(_, m), pt_ahead(m, h), pt_qn(h, "typing_extensions.Self").
// pt_dtype(m, t): member m declares a value of builtin class t, or None.
.decl pt_dtype(m: node, t: symbol)
pt_dtype(m, "None") :- pt_aleaf(_, m), kind(m, "none").
pt_dtype(m, x) :- pt_aleaf(_, m), pt_ahead(m, h), pt_builtin_ref(h, x), pt_bclass(x), x != "object".
// A class whose instances need not derive from it: a `Protocol`.
.decl pt_proto_q(q: symbol)
pt_proto_q("typing.Protocol"). pt_proto_q("typing_extensions.Protocol").
.decl pt_aproto(c: node)
// A protocol lists `Protocol` among its own bases (PEP 544): a class deriving from a protocol is an ordinary class
// (`pathlib.Path` from `os.PathLike[str]`).
pt_aproto(c) :- pt_basex(c, e), pt_qn(e, q), pt_proto_q(q).
pt_aproto(c) :- pt_basex(c, e), kind(e, "generic_type"), child(e, h, 0), pt_qn(h, q), pt_proto_q(q).
pt_aproto(c) :- pt_basex(c, e), kind(e, "subscript"), field(e, "value", h), pt_qn(h, q), pt_proto_q(q).
// A quoted annotation (`x: "Node"`) is its code's members: the annotation context's leaves of the string's tree, and
// what the context finds of each: its head, a `type[C]`'s argument, a builtin's or None's type, `Self`, and its names'
// lookups and qualified names, which the host's bindings give values (rule 5 of decision 0597).
pt_aleaf(t, m) :- pt_amem(t, s), pt_qstr(s), ann_parse(s, r), pt_q_aleaf(r, m).
pt_ahead(m, h) :- pt_q_ahead(m, h).
pt_aarg(m, a) :- pt_q_aarg(m, a).
pt_dtype(m, x) :- pt_q_dtype(m, x).
pt_aself(m) :- pt_q_aself(m).
pt_look(n, x, s) :- pt_q_look(n, x, s).
pt_qn(n, q) :- pt_q_qn(n, q).
pt_builtin_ref(n, x) :- pt_q_builtin_ref(n, x).
.context annotation of python roots ann_tree exports pt_aleaf, pt_ahead, pt_aarg, pt_dtype, pt_aself, pt_look, pt_qn, pt_builtin_ref, pt_gtm
.from python pt_hstart, pt_up, pt_bound_in, pt_ibind, pt_modnode, pt_star for annotation
.from annotation pt_aleaf as pt_q_aleaf, pt_ahead as pt_q_ahead, pt_aarg as pt_q_aarg, pt_dtype as pt_q_dtype, pt_aself as pt_q_aself, pt_look as pt_q_look, pt_qn as pt_q_qn, pt_builtin_ref as pt_q_builtin_ref, pt_gtm as pt_q_gtm
// Parameters: `x: T` and `x: T = v` (the default's own value is added as an assignment's is).
.decl pt_pann(f: node, x: symbol, t: node)
pt_pann(f, x, t) :- field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_parameter"), child(p, id, 0), kind(id, "identifier"),
    text(id, x), field(p, "type", t).
pt_pann(f, x, t) :- field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_default_parameter"), field(p, "name", id), text(id, x),
    field(p, "type", t).
.decl pt_pdefault(f: node, x: symbol, v: node)
pt_pdefault(f, x, v) :- field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_default_parameter"), field(p, "name", id), text(id, x),
    field(p, "value", v).
// A parameter's declared classes, with their subclasses, only where the parameter is read: a function scope's
// values are read through `look` alone, and a stub's parameters are never read.
.decl pt_pread(f: node, x: symbol)
pt_pread(f, x) :- pt_pann(f, x, _), pt_look(_, x, f).
// uinst: ainst cut to the annotations these rules read (a library's stubs annotate `str` thousands of times; a new
// subclass of it looks up only these).
.decl pt_uann(t: node)
pt_uann(t) :- pt_pann(f, x, t), pt_pread(f, x).
pt_uann(t) :- pt_cann(c, x, t), pt_cread(c, x).
// Returns: `def f(...) -> T`. A call of f holds T's values (beside what its returns are seen to hold); when T is
// closed, the call is known whatever its returns are.
.decl pt_rann(f: node, t: node)
pt_rann(f, t) :- kind(f, "function_definition"), field(f, "return_type", t).

// ---- generics (t21 §5.1, first version) --------------------------------------------------------------------------
// A class's type parameters, by position: `Generic[K, V]` (or `Protocol[T]`) among its bases, else the type variables
// its first generic base is given (`class list(MutableSequence[_T])`). A type variable: a module's `x = TypeVar(...)`.
.decl pt_tvarq(m: node, x: symbol)
pt_tvarq(m, x) :- pt_rasg(m, x, r, _), kind(m, "module"), kind(r, "call"), field(r, "function", e), text(e, "TypeVar").
pt_tvarq(m, x) :- pt_rasg(m, x, r, _), kind(m, "module"), kind(r, "call"), field(r, "function", e), field(e, "attribute", a), text(a, "TypeVar").
// pt_sarg(e, j, a): a is the j-th argument of the generic e (`dict[str, int]` as a subscript or an annotation's type).
// pt_pred(i, j): j = i - 1, for the positions a generic's arguments and a method's parameters take.
.decl pt_pred(i: number, j: number)
pt_pred(1, 0). pt_pred(2, 1). pt_pred(3, 2). pt_pred(4, 3). pt_pred(5, 4). pt_pred(6, 5). pt_pred(7, 6). pt_pred(8, 7).
.decl pt_sarg(e: node, j: number, a: node)
pt_sarg(e, j, a) :- kind(e, "subscript"), child(e, a, i), pt_pred(i, j).
pt_sarg(e, j, a) :- kind(e, "generic_type"), child(e, p, 1), kind(p, "type_parameter"), child(p, u, j), child(u, a, 0).
// Read from the bases as written, not their values (which read these): `Generic[...]` and `Protocol[...]` by name.
.decl pt_pform(e: node)
pt_pform(e) :- kind(e, "subscript"), field(e, "value", h), kind(h, "identifier"), text(h, x), pt_pform_name(x).
pt_pform(e) :- kind(e, "subscript"), field(e, "value", h), field(h, "attribute", a), text(a, x), pt_pform_name(x).
.decl pt_pform_name(x: symbol)
pt_pform_name("Generic"). pt_pform_name("Protocol").
.decl pt_explicit_params(c: node)
pt_explicit_params(c) :- pt_basex(c, e), pt_pform(e).
.decl pt_gbase_at(c: node, e: node, j: number)
pt_gbase_at(c, e, j) :- field(c, "superclasses", al), child(al, e, j), kind(e, "subscript"), !pt_pform(e), pt_sarg(e, _, a),
    kind(a, "identifier"), text(a, y), nearest(c, m, pt_scope), pt_tvarq(m, y).
.decl pt_gbase_later(c: node, j: number)
pt_gbase_later(c, j) :- pt_gbase_at(c, _, j), pt_gbase_at(c, _, i), i < j.
.decl pt_cparam(c: node, i: number, y: symbol)
pt_cparam(c, i, y) :- pt_basex(c, e), pt_pform(e), pt_sarg(e, i, a), kind(a, "identifier"), text(a, y).
// Else the type variables of its first base with one as an argument (`_GeneratorContextManager`'s first base takes
// `Generator[_T_co, ...]`, not a type variable).
pt_cparam(c, i, y) :- pt_gbase_at(c, e, j), !pt_gbase_later(c, j), !pt_explicit_params(c), pt_sarg(e, i, a), kind(a, "identifier"), text(a, y),
    nearest(c, m, pt_scope), pt_tvarq(m, y).
.decl pt_tparg(k: node, x: node)
pt_tparg(k, x) :- pt_basex(k, b), pt_sarg(b, _, x), kind(x, "identifier"), text(x, z), pt_cparam(k, _, z).
// pt_rtvar(f, a, y): method f of class a is declared to return a's parameter y; pt_rpvar(f, i, y): function f returns its
// own type variable y, which its parameter i is declared to be (`def get(self, key, default: _T) -> _VT | _T`).
.decl pt_rtvar(f: node, a: node, y: symbol)
pt_rtvar(f, a, y) :- pt_rann(f, t), !pt_isasync(f), pt_aleaf(t, r), kind(r, "identifier"), text(r, y), pt_method(f, a), pt_cparam(a, _, y).
.decl pt_rpvar(f: node, i: number, y: symbol)
pt_rpvar(f, i, y) :- pt_rann(f, t), !pt_isasync(f), pt_aleaf(t, r), kind(r, "identifier"), text(r, y), pt_pann(f, x, pt), pt_aleaf(pt, pr),
    kind(pr, "identifier"), text(pr, y), pt_param(f, x, i), !pt_rtvar(f, _, y).
// pt_rgen(f, r): f is declared to return the generic r (`-> Iterator[_T]`, `-> dict[str, V]`), a class's subscript, not a
// special form's (`Optional[...]`, `type[...]`, `Callable[...]`). Read as written, so the recursion can tell its
// calls apart.
.decl pt_rgen(f: node, r: node)
pt_rgen(f, r) :- pt_rann(f, t), pt_ann(t, r), !pt_isasync(f), kind(r, "generic_type"), child(r, h, 0), pt_gname(h, x), !pt_gform_name(x).
pt_rgen(f, r) :- pt_rann(f, t), pt_ann(t, r), !pt_isasync(f), kind(r, "subscript"), field(r, "value", h), pt_gname(h, x), !pt_gform_name(x).
.decl pt_gname(h: node, x: symbol)
pt_gname(h, x) :- kind(h, "identifier"), text(h, x).
pt_gname(h, x) :- kind(h, "attribute"), field(h, "attribute", a), text(a, x).
.decl pt_gform_name(x: symbol)
pt_gform_name("Optional"). pt_gform_name("Union"). pt_gform_name("type"). pt_gform_name("Type"). pt_gform_name("Callable"). pt_gform_name("Literal").
pt_gform_name("Annotated"). pt_gform_name("ClassVar"). pt_gform_name("Final"). pt_gform_name("TypeGuard"). pt_gform_name("TypeIs").
pt_gform_name("Concatenate"). pt_gform_name("Unpack"). pt_gform_name("Required"). pt_gform_name("NotRequired"). pt_gform_name("ReadOnly").
// pt_tvar_of(f, z): argument z of f's declared generic is a parameter of f's class.
.decl pt_tvar_of(f: node, z: node)
pt_tvar_of(f, z) :- pt_rgen(f, r), pt_method(f, a), pt_sarg(r, _, z), kind(z, "identifier"), text(z, y), pt_cparam(a, _, y).
// pt_gfn(c, f): call c (a call, an implicit call) runs f, declared to return its class's parameter or a generic;
// pt_gcall(c, o, f): on o's value.
.decl pt_gret(f: node)
pt_gret(f) :- pt_rtvar(f, _, _).
pt_gret(f) :- pt_rgen(f, _).
.decl pt_ghead(x: node, h: node)
pt_ghead(x, h) :- pt_sarg(_, _, x), kind(x, "subscript"), field(x, "value", h).
pt_ghead(x, h) :- pt_sarg(_, _, x), kind(x, "generic_type"), child(x, h, 0).
pt_ghead(x, x) :- pt_sarg(_, _, x), !kind(x, "subscript"), !kind(x, "generic_type").
// Or from the generic its parameter is declared (`sorted(iterable: Iterable[_T]) -> list[_T]`): pt_ownvar(f, y), f's
// return reads its own type variable y; pt_fgp(f, i, ka, w, y), f's parameter i is declared a generic of class ka whose
// parameter w is y; pt_fbind(c, f, y, x), at call c the argument's generic value, or its class's bases, give w the
// annotation x.
.decl pt_ownvar(f: node, y: symbol)
pt_ownvar(f, y) :- pt_rann(f, t), !pt_isasync(f), pt_aleaf(t, r), kind(r, "identifier"), text(r, y), !pt_method(f, _).
pt_ownvar(f, y) :- pt_rann(f, t), !pt_isasync(f), pt_aleaf(t, r), kind(r, "identifier"), text(r, y), pt_method(f, a), !pt_cparam(a, _, y).
pt_ownvar(f, y) :- pt_rgen(f, r), pt_sarg(r, _, z), kind(z, "identifier"), text(z, y), !pt_method(f, _).
pt_ownvar(f, y) :- pt_rgen(f, r), pt_sarg(r, _, z), kind(z, "identifier"), text(z, y), !pt_tvar_of(f, z), pt_method(f, _).
// A protocol's parameter, which one of its methods is declared to return (`next(i: SupportsNext[_T]) -> _T`): f
// returns what the argument's method of that name returns, as an implicit call (`i.__next__()`) does. Not an `icall`,
// which is read before values (its receiver is a value root): pt_pfn(c, o, f), call c runs o's method f.
.decl pt_pmeth(ka: node, w: symbol, m: symbol)
pt_pmeth(ka, w, m) :- pt_rtvar(mm, ka, w), pt_aproto(ka), field(mm, "name", n), text(n, m).

// ---- implicit calls -------------------------------------------------------------------------------------------
// pt_icall(c, o, a): c's value is what o's method a returns, a call with no node for the method: a subscript `o[i]` is
// `o.__getitem__(i)`. A class's subscript (`list[int]`, a generic alias) is no call of it.
.decl pt_icall(c: node, o: node, a: symbol)
pt_icall(c, o, "__getitem__") :- pt_vpos(c), kind(c, "subscript"), field(c, "value", o).
// A loop's statement holds its iterator, its target the iterator's next value; a `with` alias the value entered.
pt_icall(a, it, "__iter__") :- pt_rasg(_, _, l, a), kind(a, "for_statement"), !op(a, "async"), field(a, "right", it).
pt_icall(l, a, "__next__") :- pt_rasg(_, _, l, a), kind(a, "for_statement"), !op(a, "async").
pt_icall(t, e, "__enter__") :- pt_rasg(_, _, t, a), kind(a, "with_statement"), !op(a, "async"), kind(t, "as_pattern_target"), field(p, "alias", t),
    child(p, e, 0).
// `async for`: the statement holds `it.__aiter__()`, a plain call; its target the awaited `__anext__()` of that.
pt_icall(a, it, "__aiter__") :- pt_rasg(_, _, l, a), kind(a, "for_statement"), op(a, "async"), field(a, "right", it).
// pt_iawait(c, o, a): c's value is the result of awaiting o's method a, an implicit call: an `async for` target's
// `__anext__()`, an `async with` alias's `__aenter__()`.
.decl pt_iawait(c: node, o: node, a: symbol)
pt_iawait(l, a, "__anext__") :- pt_rasg(_, _, l, a), kind(a, "for_statement"), op(a, "async").
pt_iawait(t, e, "__aenter__") :- pt_rasg(_, _, t, a), kind(a, "with_statement"), op(a, "async"), kind(t, "as_pattern_target"), field(p, "alias", t),
    child(p, e, 0).
pt_vroot(o) :- pt_iawait(_, o, _).
pt_vroot(o) :- pt_icall(_, o, _).
// Class attributes: `x: T` or `x: T = v` in a class body binds x there; T's values are what instances may read.
.decl pt_cann(c: node, x: symbol, t: node)
pt_cann(c, x, t) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "type", t), nearest(a, c, pt_scope),
    kind(c, "class_definition"), !py_dead_at(a).
// `self.x: T` or `self.x: T = v` in a method declares the attribute on its class, as `x: T` in the body does (`self`:
// the method's first parameter; not `selfparam`, whose static test reads the decorators' values, which read this).
pt_cann(c, x, t) :- kind(a, "assignment"), field(a, "left", l), kind(l, "attribute"), field(l, "object", o), kind(o, "identifier"),
    text(o, sn), field(l, "attribute", at), text(at, x), field(a, "type", t), nearest(a, f, pt_fdef), pt_method(f, c), pt_param(f, sn, 0),
    !py_dead_at(a).
pt_bound_in(c, x) :- pt_cann(c, x, _).
// A class attribute's, only where it is read: through `found` (a name a lookup reads), or by name in the class
// body (`look`).
.decl pt_cread(c: node, x: symbol)
pt_cread(c, x) :- pt_cann(c, x, _).
pt_cread(c, x) :- pt_cann(c, x, _), pt_look(_, x, c).
// A decorator declared to return its argument's own type (`def d(fn: F) -> F`, F a type variable: a type
// parameter of d, or a module's `TypeVar`): the decorated name keeps the function, as a type checker reads it.
.decl pt_tvar(g: node, x: symbol)
pt_tvar(g, x) :- field(g, "type_parameters", tp), child(tp, p, _), child(p, e, 0), pt_ann(p, e), kind(e, "identifier"), text(e, x).
pt_tvar(g, x) :- field(g, "type_parameters", tp), child(tp, p, _), child(p, e, 0), pt_ann(p, e), kind(e, "constrained_type"), child(e, u, 0),
    child(u, i, 0), kind(i, "identifier"), text(i, x).
// pt_mtvar(d, x): x is a module-level `TypeVar` of document d, in scope in each of its functions.
.decl pt_mtvar(m: node, x: symbol)
pt_mtvar(m, x) :- pt_modnode(_, m), pt_rasg(m, x, r, _), pt_callee(r, h), pt_qn(h, "typing.TypeVar").
.decl pt_ident_dec(g: node)
pt_ident_dec(g) :- pt_param(g, x, 0), pt_pann(g, x, t), pt_ann(t, e), kind(e, "identifier"), text(e, v), pt_rann(g, r), pt_ann(r, e2), kind(e2, "identifier"),
    text(e2, v), pt_tvar(g, v).
pt_ident_dec(g) :- pt_param(g, x, 0), pt_pann(g, x, t), pt_ann(t, e), kind(e, "identifier"), text(e, v), pt_rann(g, r), pt_ann(r, e2), kind(e2, "identifier"),
    text(e2, v), docof(g, d), pt_modnode(d, mm), pt_mtvar(mm, v).
// A class decorator's form, `(cls: type[T]) -> type[T]`.
pt_ident_dec(g) :- pt_param(g, x, 0), pt_pann(g, x, t), pt_ann(t, e), pt_typeof_var(e, v), pt_rann(g, r), pt_ann(r, e2), pt_typeof_var(e2, v), pt_tvar(g, v).
pt_ident_dec(g) :- pt_param(g, x, 0), pt_pann(g, x, t), pt_ann(t, e), pt_typeof_var(e, v), pt_rann(g, r), pt_ann(r, e2), pt_typeof_var(e2, v), docof(g, d), pt_modnode(d, mm), pt_mtvar(mm, v).
// pt_typeof_var(e, v): e is `type[v]` (or `Type[v]`), v a name.
.decl pt_typeof_var(e: node, v: symbol)
pt_typeof_var(e, v) :- kind(e, "generic_type"), child(e, h, 0), text(h, n), pt_type_form(n), pt_aarg(e, a), kind(a, "identifier"), text(a, v).
pt_typeof_var(e, v) :- kind(e, "subscript"), field(e, "value", h), text(h, n), pt_type_form(n), pt_aarg(e, a), kind(a, "identifier"), text(a, v).
.decl pt_type_form(n: symbol)
pt_type_form("type"). pt_type_form("Type").

// ---- values ---------------------------------------------------------------------------------------------------
.decl pt_attr_of(n: node, o: node, a: symbol)
pt_attr_of(n, o, a) :- kind(n, "attribute"), field(n, "object", o), field(n, "attribute", at), text(at, a).
.decl pt_callee(c: node, e: node)
// A call in a guest (a quoted annotation's code) is not evaluated: only its names are read.
pt_callee(c, e) :- kind(c, "call"), field(c, "function", e), !host_node(c, _).
// Qualified names: an imported name and attributes of one (`os.path.join`), whether or not the workspace defines it.
.decl pt_qn(n: node, q: symbol)
pt_qn(n, q) :- pt_look(n, x, s), pt_ibind(s, x, q).
pt_qn(n, @dot(q, a)) :- pt_attr_of(n, o, a), pt_qn(o, q).
// `from n import *` at a module's top level: the module binds each name P2 binds it to that it does not bind itself
// (n's `__all__`, or its public names: `types__binds`), each to the symbol P2 resolves it to.
.decl pt_star_from(m: node, n: symbol)
pt_star_from(m, n) :- kind(i, "import_from_statement"), child(i, w, _), kind(w, "wildcard_import"), nearest(i, m, pt_scope),
    pt_modname(m, _), pt_impmod(i, n).
// A decorator that returns its argument keeps the definition, a function or a class.
.decl pt_defk(f: node, k: symbol)
pt_defk(f, "fn") :- kind(f, "function_definition").
pt_defk(f, "cls") :- kind(f, "class_definition").
// A decorator declared `(f: Callable[P, A]) -> Callable[P, B]` (`contextlib.contextmanager`) gives back a wrapper of
// f's parameters: its value is `wfn` f, whose call runs f and holds a B (`wcall`).
.decl pt_wrap(g: node, a: node, b: node)
pt_wrap(g, a, b) :- pt_param(g, x, 0), pt_pann(g, x, t), pt_ann(t, ca), pt_callable_ann(ca, p, a), pt_rann(g, r), pt_ann(r, cb), pt_callable_ann(cb, p, b).
.decl pt_callable_ann(e: node, p: symbol, r: node)
pt_callable_ann(e, p, r) :- pt_gann_head(e, h), pt_gname(h, "Callable"), pt_sarg(e, 0, pe), kind(pe, "identifier"), text(pe, p), pt_sarg(e, 1, r).
// pt_gann_head(e, h): the generic annotation e is headed by h (`Iterator` in `Iterator[_T]`), read as written.
.decl pt_gann_head(e: node, h: node)
pt_gann_head(e, h) :- kind(e, "generic_type"), child(e, h, 0).
pt_gann_head(e, h) :- kind(e, "subscript"), field(e, "value", h).
// pt_pass(n, c): n's value is c's (a parenthesized value, either branch of a conditional, either operand of `and`/`or`,
// an assignment's right side, a walrus's value).
.decl pt_pass(n: node, c: node)
pt_pass(n, c) :- kind(n, "parenthesized_expression"), child(n, c, 0).
pt_pass(n, c) :- kind(n, "conditional_expression"), child(n, c, 0).
pt_pass(n, c) :- kind(n, "conditional_expression"), child(n, c, 2).
pt_pass(n, c) :- kind(n, "boolean_operator"), field(n, "left", c).
pt_pass(n, c) :- kind(n, "boolean_operator"), field(n, "right", c).
pt_pass(n, c) :- kind(n, "assignment"), field(n, "right", c).
pt_pass(n, c) :- kind(n, "named_expression"), field(n, "value", c).
.decl pt_ovlfn(f: node)
pt_ovlfn(f) :- pt_ovlstmt(st), field(st, "definition", f).
.decl pt_cwild(c: node)
pt_cwild(c) :- pt_posarg(c, 8, _).
pt_cwild(c) :- kind(c, "call"), field(c, "arguments", as), child(as, a, _), kind(a, "list_splat").
pt_cwild(c) :- kind(c, "call"), field(c, "arguments", as), child(as, a, _), kind(a, "dictionary_splat").
pt_cwild(c) :- kind(c, "call"), field(c, "arguments", g), kind(g, "generator_expression").
.decl pt_ckw(c: node)
pt_ckw(c) :- kind(c, "call"), field(c, "arguments", as), child(as, a, _), kind(a, "keyword_argument").
// pt_cpos(c, n): c has n positional arguments.
.decl pt_cpos(c: node, n: number)
pt_cpos(c, 0) :- kind(c, "call"), field(c, "arguments", as), kind(as, "argument_list"), !pt_posarg(c, _, _), !pt_cwild(c).
pt_cpos(c, n) :- pt_posarg(c, j, _), !pt_posarg(c, n, _), pt_pred(n, j), !pt_cwild(c).
// pt_cposk(c, n, w): c has n positional arguments, and keywords (w = 1) or none (w = 0).
.decl pt_cposk(c: node, n: number, w: number)
pt_cposk(c, n, 1) :- pt_cpos(c, n), pt_ckw(c).
pt_cposk(c, n, 0) :- pt_cpos(c, n), !pt_ckw(c).
// pt_ffit(f, n, w): n positional arguments, with keywords (w = 1) or without, fit overload f: at least its required ones
// and none of its keyword-only ones
// required (unless keywords may give them), at most its positional ones (unless it takes `*args`). Per overload, not
// per call: a call's fit is a lookup.
.decl pt_ffit(f: node, n: number, w: number)
pt_ffit(f, n, 0) :- pt_ovlfn(f), pt_slot(n), pt_fneed(f, r), r <= n, pt_fcap(f, p), n <= p, !pt_fkwreq(f).
pt_ffit(f, n, 1) :- pt_ovlfn(f), pt_slot(n), pt_fcap(f, p), n <= p.
.decl pt_slot(n: number)
pt_slot(0). pt_slot(1). pt_slot(2). pt_slot(3). pt_slot(4). pt_slot(5). pt_slot(6). pt_slot(7). pt_slot(8). pt_slot(9).
// An overload's parameters by position (`self` counted, `/` not), before any `*`, `*args` or `**kw`.
.decl pt_pstar(f: node, k: number)
pt_pstar(f, k) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "keyword_separator").
pt_pstar(f, k) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "list_splat_pattern").
pt_pstar(f, k) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "dictionary_splat_pattern").
pt_pstar(f, k) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "typed_parameter"), child(p, s, 0), kind(s, "list_splat_pattern").
pt_pstar(f, k) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), kind(p, "typed_parameter"), child(p, s, 0), kind(s, "dictionary_splat_pattern").
.decl pt_pstar_before(f: node, k: number)
pt_pstar_before(f, k) :- pt_pstar(f, s), pt_ovlfn(f), field(f, "parameters", ps), child(ps, _, k), s <= k.
.decl pt_psep_before(f: node, k: number)
pt_psep_before(f, k) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, q, s), kind(q, "positional_separator"), child(ps, _, k), s < k.
.decl pt_ppos(f: node, i: number, p: node)
pt_ppos(f, k, p) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), !kind(p, "positional_separator"), !pt_pstar_before(f, k),
    !pt_psep_before(f, k).
pt_ppos(f, i, p) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), !kind(p, "positional_separator"), !pt_pstar_before(f, k),
    pt_psep_before(f, k), pt_pred(k, i).
.decl pt_preq(f: node, i: number)
pt_preq(f, i) :- pt_ppos(f, i, p), kind(p, "identifier").
pt_preq(f, i) :- pt_ppos(f, i, p), kind(p, "typed_parameter").
.decl pt_fneed(f: node, n: number)
pt_fneed(f, 0) :- pt_ovlfn(f), !pt_preq(f, _).
pt_fneed(f, n) :- pt_preq(f, i), pt_pred(n, i), !pt_preq(f, n).
.decl pt_fkwreq(f: node)
pt_fkwreq(f) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), pt_pstar_before(f, k), !pt_pstar(f, k), kind(p, "identifier").
pt_fkwreq(f) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, k), pt_pstar_before(f, k), !pt_pstar(f, k), kind(p, "typed_parameter").
.decl pt_fstar(f: node)
pt_fstar(f) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, _), kind(p, "list_splat_pattern").
pt_fstar(f) :- pt_ovlfn(f), field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_parameter"), child(p, s, 0), kind(s, "list_splat_pattern").
.decl pt_fcap(f: node, n: number)
pt_fcap(f, 9) :- pt_fstar(f).
pt_fcap(f, 0) :- pt_ovlfn(f), !pt_fstar(f), !pt_ppos(f, _, _).
pt_fcap(f, n) :- pt_ppos(f, i, _), pt_pred(n, i), !pt_ppos(f, n, _), !pt_fstar(f).
// The standard library's `builtins`, where a run loads it (t21): a builtin name is that module's binding of the name
// (`super` keeps its own value above), and a literal is an instance of its builtins class. Not `object`: every class
// is one, so a value declared `object` is any instance at all, which is no knowledge (and every class's rows).
// Each with its qualified name made first (`bq`, `litq`), so the join with `qv` is on that name.
.decl pt_bq(n: node, q: symbol)
pt_bq(n, q) :- pt_builtin_ref(n, x), x != "super", x != "object", q = @dot("builtins", x).
.decl pt_lit_cls(kind: symbol, q: symbol)
pt_lit_cls("integer", "builtins.int"). pt_lit_cls("float", "builtins.float"). pt_lit_cls("string", "builtins.str").
pt_lit_cls("concatenated_string", "builtins.str"). pt_lit_cls("true", "builtins.bool"). pt_lit_cls("false", "builtins.bool").
pt_lit_cls("list", "builtins.list"). pt_lit_cls("list_comprehension", "builtins.list"). pt_lit_cls("dictionary", "builtins.dict").
pt_lit_cls("dictionary_comprehension", "builtins.dict"). pt_lit_cls("set", "builtins.set"). pt_lit_cls("set_comprehension", "builtins.set").
pt_lit_cls("tuple", "builtins.tuple").
.decl pt_litq(n: node, q: symbol)
pt_litq(n, q) :- pt_vpos(n), kind(n, k), pt_lit_cls(k, q), !pt_bytes_lit(n).
pt_litq(n, "builtins.bytes") :- pt_bytes_lit(n).

// ---- library values, by symbol (P2's exports) --------------------------------------------------------------------
// pt_wsmod(q): a module of this phase's documents, the workspace's. A symbol whose module is another is a library's.
.decl pt_wsmod(q: symbol)
pt_wsmod(q) :- pt_modname(_, q).
// pt_lres(q, d): the qualified name q (an import, a dotted name read from one, a builtin) is symbol d: a module, else a
// module's name (through its imports and re-exports, `types__binds`), else a class's (through its bases).
.decl pt_lwant(q: symbol)
pt_lwant(q) :- pt_qn(_, q).
pt_lwant(q) :- pt_ibind(_, _, q).
pt_lwant(q) :- pt_bq(_, q).
pt_lwant(q) :- pt_litq(_, q).
pt_lwant(q) :- pt_star_from(_, q).
pt_lwant(p) :- pt_lwant(q), split_dot(q, p, _).
.decl pt_ckwname(c: node, k: symbol)
pt_ckwname(c, k) :- kind(c, "call"), field(c, "arguments", as), child(as, a, _), kind(a, "keyword_argument"), field(a, "name", n), text(n, k).
.decl pt_litcls(a: node, k: symbol)
pt_litcls(a, "builtins.str") :- kind(a, "string"), !pt_litbytes(a).
pt_litcls(a, "builtins.bytes") :- pt_litbytes(a).
.decl pt_litbytes(a: node)
pt_litbytes(a) :- kind(a, "string"), text(a, t), match("^[bB].*", t).
pt_litcls(a, "builtins.int") :- kind(a, "integer").
pt_litcls(a, "builtins.float") :- kind(a, "float").
pt_litcls(a, "builtins.bool") :- kind(a, "true").
pt_litcls(a, "builtins.bool") :- kind(a, "false").
pt_litcls(a, "builtins.list") :- kind(a, "list").
pt_litcls(a, "builtins.dict") :- kind(a, "dictionary").
pt_litcls(a, "builtins.set") :- kind(a, "set").
pt_litcls(a, "builtins.tuple") :- kind(a, "tuple").
.decl pt_litk(k: symbol)
pt_litk("builtins.str"). pt_litk("builtins.bytes"). pt_litk("builtins.int"). pt_litk("builtins.float"). pt_litk("builtins.bool").
pt_litk("builtins.list"). pt_litk("builtins.dict"). pt_litk("builtins.set"). pt_litk("builtins.tuple").
.decl pt_cnamed(c: node, x: symbol)
pt_cnamed(c, x) :- kind(c, "call"), field(c, "function", e), kind(e, "identifier"), text(e, x).
pt_cnamed(c, x) :- kind(c, "call"), field(c, "function", e), kind(e, "attribute"), field(e, "attribute", n), text(n, x).
.decl pt_lnotnone(a: node)
pt_lnotnone(a) :- kind(a, k), pt_lit_kind(k).
.decl pt_lit_kind(k: symbol)
pt_lit_kind("list"). pt_lit_kind("dictionary"). pt_lit_kind("set"). pt_lit_kind("tuple"). pt_lit_kind("string"). pt_lit_kind("concatenated_string").
pt_lit_kind("integer"). pt_lit_kind("float"). pt_lit_kind("true"). pt_lit_kind("false"). pt_lit_kind("list_comprehension").
pt_lit_kind("dictionary_comprehension"). pt_lit_kind("set_comprehension"). pt_lit_kind("lambda").
// A workspace module's or function's annotated name (`_ctx: ContextVar[B | None] = ContextVar(...)`,
// `grouped: dict[str, list[V]] = {}`): its declared library generic, beside the value assigned.
.decl pt_wmann(m: node, x: symbol, t: node)
pt_wmann(m, x, t) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "type", t), nearest(a, m, pt_scope),
    kind(m, "module"), !py_dead_at(a).
pt_wmann(m, x, t) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "type", t), nearest(a, m, pt_scope),
    kind(m, "function_definition"), !py_dead_at(a).
pt_uann(t) :- pt_wmann(_, _, t).
// A union argument (`ContextVar[B | None]`): each member, the workspace's classes with their subclasses (as `gcls`).
.decl pt_umem(e: node, m: node)
pt_umem(e, m) :- kind(e, "binary_operator"), op(e, "|"), field(e, "left", m).
pt_umem(e, m) :- kind(e, "binary_operator"), op(e, "|"), field(e, "right", m).
pt_umem(e, m) :- kind(e, "parenthesized_expression"), child(e, m, 0).

// ---- unknown values -------------------------------------------------------------------------------------------
// Positions whose value is read: what `vopen` is asked about.
.decl pt_vpos(n: node)
// pt_vroot(e): where a value is read. A guest's (a quoted annotation's code) are not: only its names are read.
.decl pt_vroot(e: node)
pt_vroot(e) :- pt_callee(_, e).
pt_vroot(o) :- pt_attr_of(_, o, _).
pt_vroot(r) :- pt_asg(_, _, r, _).
pt_vroot(r) :- pt_retval(_, r).
pt_vroot(e) :- pt_dexpr(_, e).
pt_vroot(e) :- pt_basex(_, e).
pt_vroot(a) :- pt_posarg(_, _, a).
pt_vroot(v) :- pt_pdefault(_, _, v).
pt_vpos(e) :- pt_vroot(e), !host_node(e, _).
pt_vpos(c) :- pt_vpos(n), kind(n, "parenthesized_expression"), child(n, c, 0).
pt_vpos(c) :- pt_vpos(n), kind(n, "conditional_expression"), child(n, c, 0).
pt_vpos(c) :- pt_vpos(n), kind(n, "conditional_expression"), child(n, c, 2).
pt_vpos(c) :- pt_vpos(n), kind(n, "boolean_operator"), child(n, c, _).
pt_vpos(c) :- pt_vpos(n), kind(n, "assignment"), field(n, "right", c).
pt_vpos(c) :- pt_vpos(n), kind(n, "named_expression"), field(n, "value", c).
.decl pt_tracked(k: symbol)
pt_tracked("identifier"). pt_tracked("attribute"). pt_tracked("call"). pt_tracked("parenthesized_expression"). pt_tracked("conditional_expression").
pt_tracked("boolean_operator"). pt_tracked("assignment"). pt_tracked("named_expression").
// Values that are no workspace callable and whose methods are no workspace definition: literals and operators on them.
pt_tracked("integer"). pt_tracked("float"). pt_tracked("string"). pt_tracked("concatenated_string"). pt_tracked("true"). pt_tracked("false").
pt_tracked("none"). pt_tracked("subscript"). pt_tracked("for_statement"). pt_tracked("as_pattern_target"). pt_tracked("list"). pt_tracked("dictionary"). pt_tracked("set"). pt_tracked("tuple"). pt_tracked("list_comprehension").
pt_tracked("await"). pt_tracked("dictionary_comprehension"). pt_tracked("set_comprehension"). pt_tracked("comparison_operator"). pt_tracked("not_operator").
// A typing special form as a base (`Generic[T]`, `Protocol`, `TypedDict`): no class to read, and none needed, as the
// members are the class's own. In typeshed these are values (`Generic: type[_Generic]`), so they are named here.
.decl pt_special_base_q(q: symbol)
pt_special_base_q("typing.Generic"). pt_special_base_q("typing.Protocol"). pt_special_base_q("typing.TypedDict").
pt_special_base_q("typing_extensions.Generic"). pt_special_base_q("typing_extensions.Protocol").
pt_special_base_q("typing_extensions.TypedDict").
.decl pt_special_base(e: node)
pt_special_base(e) :- pt_basex(_, e), pt_qn(e, q), pt_special_base_q(q).
pt_special_base(e) :- pt_basex(_, e), kind(e, "subscript"), field(e, "value", g), pt_qn(g, q), pt_special_base_q(q).
pt_special_base(e) :- pt_basex(_, e), pt_ownq(e, q), pt_special_base_q(q).
pt_special_base(e) :- pt_basex(_, e), kind(e, "subscript"), field(e, "value", g), pt_ownq(g, q), pt_special_base_q(q).
.decl pt_selfparam(f: node, i: number)
pt_selfparam(f, 0) :- pt_method(f, _), !pt_isstatic(f).
// ---- call targets ---------------------------------------------------------------------------------------------
// pt_method_kind(k): a binding of kind k is a function a method lookup may find, its own or one under outside decorators.
.decl pt_method_kind(k: symbol)
pt_method_kind("fn"). pt_method_kind("dfn").

// ---- call chains ----------------------------------------------------------------------------------------------
// The function whose body holds a call (a lambda's or a nested class body's calls are the enclosing function's).
.decl pt_owner(c: node, f: node)
pt_owner(c, f) :- kind(c, "call"), nearest(c, f, pt_fdef).
// W5 `ASYNC_BLOCKING`: an async function's call, outside `await`, of a sync function that reaches a blocking call
// through sync functions only (the native `calls` term with `through: sync`).
.decl pt_blocking(q: symbol)
pt_blocking("time.sleep"). pt_blocking("requests.get"). pt_blocking("subprocess.run").
.decl pt_dq(f: node, q: symbol)
pt_dq(f, @dot(m, x)) :- pt_modname(s, m), pt_live_def(s, x, f).
.decl pt_in_await(c: node)
pt_in_await(c) :- kind(c, "call"), child(w, c, 0), kind(w, "await").

.decl pt_builtin(x: symbol)
pt_builtin("abs"). pt_builtin("aiter"). pt_builtin("all"). pt_builtin("anext"). pt_builtin("any"). pt_builtin("ascii"). pt_builtin("bin").
pt_builtin("bool"). pt_builtin("breakpoint"). pt_builtin("bytearray"). pt_builtin("bytes"). pt_builtin("callable"). pt_builtin("chr").
pt_builtin("classmethod"). pt_builtin("compile"). pt_builtin("complex"). pt_builtin("delattr"). pt_builtin("dict"). pt_builtin("dir").
pt_builtin("divmod"). pt_builtin("enumerate"). pt_builtin("eval"). pt_builtin("exec"). pt_builtin("filter"). pt_builtin("float").
pt_builtin("format"). pt_builtin("frozenset"). pt_builtin("getattr"). pt_builtin("globals"). pt_builtin("hasattr"). pt_builtin("hash").
pt_builtin("help"). pt_builtin("hex"). pt_builtin("id"). pt_builtin("input"). pt_builtin("int"). pt_builtin("isinstance").
pt_builtin("issubclass"). pt_builtin("iter"). pt_builtin("len"). pt_builtin("list"). pt_builtin("locals"). pt_builtin("map"). pt_builtin("max").
pt_builtin("memoryview"). pt_builtin("min"). pt_builtin("next"). pt_builtin("object"). pt_builtin("oct"). pt_builtin("open"). pt_builtin("ord").
pt_builtin("pow"). pt_builtin("print"). pt_builtin("property"). pt_builtin("range"). pt_builtin("repr"). pt_builtin("reversed").
pt_builtin("round"). pt_builtin("set"). pt_builtin("setattr"). pt_builtin("slice"). pt_builtin("sorted"). pt_builtin("staticmethod").
pt_builtin("str"). pt_builtin("sum"). pt_builtin("super"). pt_builtin("tuple"). pt_builtin("type"). pt_builtin("vars"). pt_builtin("zip").
pt_builtin("__import__"). pt_builtin("__name__"). pt_builtin("__file__"). pt_builtin("__doc__"). pt_builtin("__spec__"). pt_builtin("__debug__").
pt_builtin("NotImplemented"). pt_builtin("Ellipsis"). pt_builtin("BaseException"). pt_builtin("Exception"). pt_builtin("ValueError").
pt_builtin("TypeError"). pt_builtin("KeyError"). pt_builtin("IndexError"). pt_builtin("AttributeError"). pt_builtin("RuntimeError").
pt_builtin("NotImplementedError"). pt_builtin("OSError"). pt_builtin("ImportError"). pt_builtin("StopIteration"). pt_builtin("LookupError").
pt_builtin("ArithmeticError"). pt_builtin("AssertionError"). pt_builtin("EOFError"). pt_builtin("FileNotFoundError").
pt_builtin("ModuleNotFoundError"). pt_builtin("NameError"). pt_builtin("OverflowError"). pt_builtin("PermissionError").
pt_builtin("RecursionError"). pt_builtin("UnicodeError"). pt_builtin("UnicodeDecodeError"). pt_builtin("UnicodeEncodeError").
pt_builtin("ZeroDivisionError"). pt_builtin("KeyboardInterrupt"). pt_builtin("SystemExit"). pt_builtin("Warning").
pt_builtin("DeprecationWarning"). pt_builtin("UserWarning"). pt_builtin("RuntimeWarning"). pt_builtin("EnvironmentError").
pt_builtin("IOError"). pt_builtin("BufferError"). pt_builtin("ConnectionError"). pt_builtin("TimeoutError"). pt_builtin("GeneratorExit").

// ---- types (decision 0047, point 3) ---------------------------------------------------------------------------
// What a rule reads of a value's type, at the positions whose value the program models (`vpos`: callees and
// receivers, assigned, returned and decorating values, arguments and bases). Three-valued, as calls are:
//   type_of(n, t)        n may hold a value whose class is t: a workspace class's qualified name, or a builtin's
//                        name (`int`, `str`, `None`, ...)
//   type_open(n)         n may also hold a value of a class not listed
//   proven_type(n, t)    `isinstance(n, t)` is true: every class n may hold is t or a subclass of it, and none is
//                        unlisted
//   possible_type(n, t)  `isinstance(n, t)` may be true: some listed class is t or a subclass of it
//   possible_open(n)     possible_type is incomplete: n may hold an unlisted class, or a listed class whose bases
//                        are not all known
// A rule's `possible: t` is `possible_type(n, t)` or `possible_open(n)`; `not proven: t` is `!proven_type(n, t)`.
// A workspace subclass is a closed world: an instance of a class code outside the workspace derives from a
// workspace class reaches the program only through an unknown value (a parameter, an external call).
.decl pt_lit_type(k: symbol, t: symbol)
pt_lit_type("integer", "int"). pt_lit_type("float", "float"). pt_lit_type("string", "str"). pt_lit_type("concatenated_string", "str").
pt_lit_type("true", "bool"). pt_lit_type("false", "bool"). pt_lit_type("none", "None").
pt_lit_type("list", "list"). pt_lit_type("list_comprehension", "list"). pt_lit_type("dictionary", "dict").
pt_lit_type("dictionary_comprehension", "dict"). pt_lit_type("set", "set"). pt_lit_type("set_comprehension", "set").
pt_lit_type("tuple", "tuple"). pt_lit_type("not_operator", "bool").
// A bytes literal: its prefix (`strprefix`, lowercased) has a `b` (`b"..."`, `rb"..."`); a concatenation's
// parts share their kind.
.decl pt_bprefix(p: symbol)
pt_bprefix("b"). pt_bprefix("rb"). pt_bprefix("br").
.decl pt_bytes_lit(n: node)
pt_bytes_lit(n) :- pt_vpos(n), kind(n, "string"), strprefix(n, p), pt_bprefix(p).
pt_bytes_lit(n) :- pt_vpos(n), kind(n, "concatenated_string"), child(n, c, 0), strprefix(c, p), pt_bprefix(p).
// A builtin class whose call makes a value of that class.
.decl pt_bclass(x: symbol)
pt_bclass("int"). pt_bclass("float"). pt_bclass("complex"). pt_bclass("str"). pt_bclass("bytes"). pt_bclass("bytearray"). pt_bclass("bool").
pt_bclass("list"). pt_bclass("dict"). pt_bclass("set"). pt_bclass("frozenset"). pt_bclass("tuple"). pt_bclass("object").
.decl pt_bcall(c: node, x: symbol)
pt_bcall(c, x) :- pt_callee(c, e), pt_builtin_ref(e, x), pt_bclass(x).
// A workspace class's qualified name: a module's class, or a class's class. Classes in a function have none.
.decl pt_cls_q(c: node, q: symbol)
pt_cls_q(c, @dot(m, x)) :- pt_modname(s, m), pt_rdefn(s, x, c), kind(c, "class_definition").
pt_cls_q(c, @dot(q, x)) :- pt_cls_q(o, q), pt_rdefn(o, x, c), kind(c, "class_definition").



// ---- terms (decision 0677, note t55) ------------------------------------------------------------------------------
// pt_tm(n, t): node n's term, the symbol python/points-to-solve knows it by. An edit renumbers nodes; a node's term
// changes only with its own definition's code.
// - A module: its name (its path, where it has none).
// - A definition: its symbol, as P1 names it (struct.rerail's `sym`): `m.C.run`, and `m.f#1` for the second live
//   definition of a name in its scope. A definition in a function is named so too (`m.f.inner`), as P1 does not.
// - Any other node: its place in its nearest definition or module, relative to that one's start, with its length,
//   and how many of its ancestors have both (`pt_tm_same`): `m.C.run@14+5^0`.
// - A guest's node (a quoted annotation's code): its place in the guest's own document, which every string of that
//   text shares: `~1825239168@0+4^1`.
.decl pt_tm(n: node, t: symbol)
.pragma "magic-transform" "pt_tm"
// pt_scope_tm(s, q): a module's or a definition's term, made down from the module one scope at a time (`nearest`
// up, so the recursion is bounded: the cycles rule 3). A definition a branch never taken holds (`py_dead_at`) is no
// binding, so P1 numbers it not: it is named by its place, as any other node.
.decl pt_scope_tm(s: node, q: symbol)
pt_scope_tm(m, q) :- pt_modname(m, q), q != "".
pt_scope_tm(m, p) :- pt_modnode(d, m), doc(d, p, "").
.decl pt_tm_ord(f: node, k: number)
pt_tm_ord(f, k) :- pt_rdefn(s, x, f), node(_, f, _, b, _), k = count : { pt_rdefn(s, x, g), node(_, g, _, c, _), c < b }.
.decl pt_tm_def(k: symbol)
pt_tm_def("function_definition"). pt_tm_def("class_definition").
pt_scope_tm(f, @dot(q, x)) :- kind(f, k), pt_tm_def(k), field(f, "name", nm), text(nm, x), nearest(f, s, pt_scope),
    pt_scope_tm(s, q), pt_tm_ord(f, 0).
pt_scope_tm(f, cat(@dot(q, x), "#", to_string(i))) :- kind(f, k), pt_tm_def(k), field(f, "name", nm), text(nm, x),
    nearest(f, s, pt_scope), pt_scope_tm(s, q), pt_tm_ord(f, i), i > 0.
pt_scope_tm(f, cat(q, "@", to_string(b - sb), "+", to_string(e - b), "^", to_string(c))) :- kind(f, k), pt_tm_def(k),
    py_dead_at(f), nearest(f, s, pt_tm_scope), pt_scope_tm(s, q), node(_, f, _, b, e), node(_, s, _, sb, _), pt_tm_same(f, c).
.decl pt_tm_scope(kind: symbol)
pt_tm_scope("module"). pt_tm_scope("function_definition"). pt_tm_scope("class_definition").
pt_tm(s, q) :- pt_scope_tm(s, q).
pt_tm(n, cat(q, "@", to_string(b - sb), "+", to_string(e - b), "^", to_string(c))) :- node(_, n, k, b, e), !pt_tm_def(k),
    k != "module", !host_node(n, _), nearest(n, s, pt_tm_scope), node(_, s, _, sb, _), pt_scope_tm(s, q), pt_tm_same(n, c).
// A guest's node is the guest's own (its document a tape that equal texts share, decision 0431), whatever string
// holds it: named by that document and its place there. Only the annotation context reads a guest's nodes (decision
// 0597): `pt_gtm` is its, and the host reads it as `pt_q_gtm`.
pt_tm(n, t) :- pt_q_gtm(n, t).
.decl pt_gtm(n: node, t: symbol)
pt_gtm(n, cat("~", to_string(d), "@", to_string(b), "+", to_string(e - b), "^", to_string(c))) :- node(d, n, _, b, e),
    pt_tm_same(n, c).
// pt_tm_same(n, c): c of n's ancestors span what n does (a `type` over its expression, an expression statement over
// its call), counted up the parents: what tells n from them, as a place and a length do not. A node's kind is no
// name, so not that.
.decl pt_tm_same(n: node, c: number)
.pragma "magic-transform" "pt_tm_same"
pt_tm_same(n, 0) :- node(_, n, _, _, _), !child(_, n, _).
pt_tm_same(n, 0) :- child(p, n, _), node(_, p, _, pb, _), node(_, n, _, b, _), pb != b.
pt_tm_same(n, 0) :- child(p, n, _), node(_, p, _, _, pe), node(_, n, _, _, e), pe != e.
pt_tm_same(n, c + 1) :- child(p, n, _), node(_, p, _, b, e), node(_, n, _, b, e), pt_tm_same(p, c).

// pt_def(f, q): definition f is symbol q, pt_tm's rows for live definitions alone. A rule reads a definition by its
// symbol through it (`call_target(c, q), pt_def(g, q)`), never through pt_tm, which would make every node's term.
.decl pt_def(f: node, q: symbol)
pt_def(f, q) :- pt_rdefn(_, _, f), pt_scope_tm(f, q).
