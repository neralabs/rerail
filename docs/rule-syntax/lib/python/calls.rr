// python/calls: call targets, call chains and expression types, from the Python typing program.
//
// The engine resolves Python calls and types once, in one program: native/src/code_rule_dsl/typing/programs/calls.rr
// (decision 0047). It runs that program over the repository, file by file and then in bounded cross-file rounds,
// and gives this library its answers as facts keyed by file and span (`typing_calls__*`, one row per answer; each
// node is its path, kind, start byte and end byte). The rules below join those spans back to this program's nodes.
// The program is run only when a rule reaching an output reads one of these relations.
//
// Three-valued, as the program answers:
//   call_target(c, f) rows and no call_open(c)  -> c calls exactly those f (definite)
//   call_open(c)                                -> c may call something else too (unknown)
//   neither                                     -> c calls no workspace function (e.g. `len(x)`)
// Rules must not treat a missing call_target as "calls nothing" when call_open holds.
//
// Types, at the positions whose value the program models (callees and receivers, assigned, returned and
// decorating values, arguments and bases):
//   type_of(n, t)        n may hold a value whose class is t: a workspace class's qualified name ("pkg.models.Base"),
//                        or a builtin's name ("str", "None", "module", "type")
//   type_open(n)         n may also hold a value of a class not listed
//   proven_type(n, t)    `isinstance(n, t)` is true
//   possible_type(n, t)  `isinstance(n, t)` may be true, for a listed class
//   possible_open(n)     possible_type is incomplete
// `possible: t` is possible_type(n, t) or possible_open(n).
//
// Interface: call_target, call_open, calls, calls_open, reach, the type relations above, and the syntax helpers
// call, callee, call_arg, posarg, owner, awaited.
#include "python/names.rr"
// fdef (a def node) comes from python/names.

// ---- the program's answers ----------------------------------------------------------------------------------------
.decl typing_calls__call_target(c_path: symbol, c_kind: symbol, c_start: number, c_end: number,
    f_path: symbol, f_kind: symbol, f_start: number, f_end: number)
.decl typing_calls__call_open(c_path: symbol, c_kind: symbol, c_start: number, c_end: number)
.decl typing_calls__type_of(n_path: symbol, n_kind: symbol, n_start: number, n_end: number, t: symbol)
.decl typing_calls__type_open(n_path: symbol, n_kind: symbol, n_start: number, n_end: number)
.decl typing_calls__proven_type(n_path: symbol, n_kind: symbol, n_start: number, n_end: number, t: symbol)
.decl typing_calls__possible_type(n_path: symbol, n_kind: symbol, n_start: number, n_end: number, t: symbol)
.decl typing_calls__possible_open(n_path: symbol, n_kind: symbol, n_start: number, n_end: number)

.decl call_target(c: node, f: node)
call_target(c, f) :- typing_calls__call_target(p, k, s, e, q, j, t, u), doc(d, p, _), node(d, c, k, s, e), doc(g, q, _),
    node(g, f, j, t, u).
.decl call_open(c: node)
call_open(c) :- typing_calls__call_open(p, k, s, e), doc(d, p, _), node(d, c, k, s, e).
.decl type_of(n: node, t: symbol)
type_of(n, t) :- typing_calls__type_of(p, k, s, e, t), doc(d, p, _), node(d, n, k, s, e).
.decl type_open(n: node)
type_open(n) :- typing_calls__type_open(p, k, s, e), doc(d, p, _), node(d, n, k, s, e).
.decl proven_type(n: node, t: symbol)
proven_type(n, t) :- typing_calls__proven_type(p, k, s, e, t), doc(d, p, _), node(d, n, k, s, e).
.decl possible_type(n: node, t: symbol)
possible_type(n, t) :- typing_calls__possible_type(p, k, s, e, t), doc(d, p, _), node(d, n, k, s, e).
.decl possible_open(n: node)
possible_open(n) :- typing_calls__possible_open(p, k, s, e), doc(d, p, _), node(d, n, k, s, e).

// ---- call chains ----------------------------------------------------------------------------------------------
// owner(c, f): f is the nearest enclosing def of call c (a lambda's or a nested class body's calls are the
// enclosing function's).
.decl owner(c: node, f: node)
owner(c, f) :- kind(c, "call"), nearest(c, f, fdef).
// calls(f, g): the call graph edge "f may call g".
.decl calls(f: node, g: node)
calls(f, g) :- owner(c, f), call_target(c, g).
// calls_open(f): f makes at least one call whose target is unknown, so its out-edges are incomplete.
.decl calls_open(f: node)
calls_open(f) :- owner(c, f), call_open(c).
// reach(f, g): f may call g, directly or through a chain of calls. Only the known side: a chain through a
// calls_open function may reach more.
.decl reach(f: node, g: node)
reach(f, g) :- calls(f, g).
reach(f, h) :- reach(f, g), calls(g, h).

// ---- syntax --------------------------------------------------------------------------------------------------------
// call(c): c is a call expression.
.decl call(c: node)
call(c) :- kind(c, "call").
// callee(c, e): e is the function expression of call c (`f` in `f(x)`, `obj.m` in `obj.m()`).
.decl callee(c: node, e: node)
callee(c, e) :- kind(c, "call"), field(c, "function", e).
// posarg(c, i, a): a is the argument at child index i of call c, when it is positional (not `k=v`, `*xs`, `**kw`).
// The index counts all argument children, so it matches a parameter's index only while no keyword or splat comes first.
.decl posarg(c: node, i: number, a: node)
posarg(c, i, a) :- kind(c, "call"), field(c, "arguments", al), kind(al, "argument_list"), child(al, a, i), !kind(a, "keyword_argument"),
    !kind(a, "list_splat"), !kind(a, "dictionary_splat").
// call_arg(c, i, keyword, v): an argument of call c. Positional: i is its index and keyword is "".
// Keyword `k=v`: i is -1 and keyword is "k". Splats (`*xs`, `**kw`) have no row.
// e.g. `open(p, mode="w")` gives (c, 0, "", <p>) and (c, -1, "mode", <"w">).
.decl call_arg(c: node, i: number, keyword: symbol, v: node)
call_arg(c, i, "", a) :- posarg(c, i, a).
call_arg(c, -1, k, v) :- kind(c, "call"), field(c, "arguments", al), child(al, ka, _),
    kind(ka, "keyword_argument"), field(ka, "name", n), text(n, k), field(ka, "value", v).
// awaited(c): call c is the operand of `await` (`await fetch()`), so a coroutine it returns is consumed.
.decl awaited(c: node)
awaited(c) :- kind(c, "call"), child(w, c, 0), kind(w, "await").
