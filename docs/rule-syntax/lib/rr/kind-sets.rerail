// Kind sets taken out (decision 0639 §6a, E10; decision 0662 §2): a kind set the image holds as a relation, which no
// rule reads but its own and those of sets taken out, is no relation of the program. It stays a kind set (the
// transducer reads it from a node's kind); its declaration and its facts go. These are rules over the image's view,
// so a program's union keeps what they derive by delta as its own module changes.

#include "rr/view.rerail"

// What the take-out asks of the view is about kind sets alone, so it reads the view by them: each kind set's
// literals found by its name (`img_lit`'s relation column), each one's rule's head by the rule's id, and whether the
// image holds it by its name. A run's work is the kind sets' reads, not the program's every literal.
.decl img_reads_set(h: symbol, s: symbol)
img_reads_set(h, s) :- img_kindset(s), img_lit(r, _, _, s, _), img_rule(r, h).
.decl img_held_set(s: symbol)
img_held_set(s) :- img_kindset(s), img_decl(s, _).
img_held_set(s) :- img_kindset(s), img_facts(s).
img_held_set(s) :- img_kindset(s), img_rule(_, s).

// A kind set stays a relation: one the image does not hold as a relation, or one a rule reads whose head is no kind
// set, or one a kept kind set reads.
.decl img_kindset_live(s: symbol)
img_kindset_live(s) :- img_kindset(s), !img_held_set(s).
img_kindset_live(s) :- img_reads_set(h, s), h != s, !img_kindset(h).
img_kindset_live(s) :- img_reads_set(h, s), h != s, img_kindset_live(h).

.decl img_kindset_out(s: symbol)
img_kindset_out(s) :- img_kindset(s), !img_kindset_live(s).

// The edits (decision 0662 §2).
.decl img_undeclare(rel: symbol)
img_undeclare(s) :- img_kindset_out(s), img_decl(s, _).
.decl img_drop_facts(rel: symbol)
img_drop_facts(s) :- img_kindset_out(s), img_facts(s).

.output img_kindset_out, img_undeclare, img_drop_facts
