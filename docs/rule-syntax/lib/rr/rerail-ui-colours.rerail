// rr/rerail-ui-colours: raw colours and Nera's own tokens in the dashboard's sources (ui/), read as text.
// The rerail pack's rerail-ui-color-tokens is one policy per grammar (CSS, JavaScript, HTML), and each reads the
// file's text with the same seven searches, so they live here once. Each is a regex over the whole file, the
// JSON rule's own, copied exactly; a finding sits on its named group (the colour, or the token).
//
// What a policy gets from this library (at: the captured span):
//   raw_hex(at)             a #rgb, #rgba, #rrggbb or #rrggbbaa colour in code, not in a comment:
//                           `--steered: #D4700A;`
//   data_uri_hex(at)        a %23-escaped hex colour, as a data: image writes one: `fill='%23D4700A'`
//   colour_function(at)     rgb()/hsl()/oklch()/color(…) as a property's or a page token's value (effect tokens
//                           aside): `--steered-subtle: rgba(212,112,10,.08);`
//   named_colour(at)        a CSS colour keyword as a colour property's value: `color: red`, `{ borderColor: "red" }`
//   effect_colour(at)       an effect token (--card-shadow, --scrim, …) holding a colour other than black or white:
//                           `--card-shadow: 0 1px 2px rgba(212,112,10,.2);`
//   nera_token_defined(at)  one of Nera's token names defined: `--primary: #fff;`, `{ "--primary": x }`
//   nera_token_set(at)      one of Nera's token names set from script: `style.setProperty("--primary", x)`
//
// Builds on core only: source and match_group.

.decl raw_hex(at: span)
raw_hex(g) :- source(_, sp), match_group("(?m)^[ \\t]*(?:(?:(?:[^\\s/*<]|\\*[^\\s/\\n]|\\*[ \\t]+\\{|<[^!\\n]|/\\*(?:[^*\\n]|\\*[^/\\n])*\\*/)(?:[^\\n/<]|/[^/*\\n]|://|<[^!\\n]|/\\*(?:[^*\\n]|\\*[^/\\n])*\\*/)*?)?[^&0-9A-Za-z_\\n-])?(?P<colour>#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4}))(?:[^0-9A-Za-z_-]|$)", sp, _, "colour", g).

.decl data_uri_hex(at: span)
data_uri_hex(g) :- source(_, sp), match_group("(?P<colour>%23(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?:[^0-9A-Za-z_-]|$))", sp, _, "colour", g).

.decl colour_function(at: span)
colour_function(g) :- source(_, sp), match_group("(?m)(?:^|[{;])[ \\t]*(?:(?:(?:--(?:(?:[0-9A-Z_ad-kmnqrt-z]|-)[0-9A-Za-z_-]*|b(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-qs-z]|-)[0-9A-Za-z_-]*|r(?:|[0-9A-Z_a-z][0-9A-Za-z_-]*|-(?:|(?:[0-9A-Z_a-rt-z]|-)[0-9A-Za-z_-]*|s(?:|(?:[0-9A-Z_a-gi-z]|-)[0-9A-Za-z_-]*|h(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|(?:[0-9A-Z_a-np-z]|-)[0-9A-Za-z_-]*|o(?:|(?:[0-9A-Z_a-vx-z]|-)[0-9A-Za-z_-]*|w(?:[0-9A-Za-z_-]+))))))))))|c(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-qs-z]|-)[0-9A-Za-z_-]*|r(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|[0-9A-Z_a-z][0-9A-Za-z_-]*|-(?:|(?:[0-9A-Z_a-rt-z]|-)[0-9A-Za-z_-]*|s(?:|(?:[0-9A-Z_a-gi-z]|-)[0-9A-Za-z_-]*|h(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|(?:[0-9A-Z_a-np-z]|-)[0-9A-Za-z_-]*|o(?:|(?:[0-9A-Z_a-vx-z]|-)[0-9A-Za-z_-]*|w(?:[0-9A-Za-z_-]+)))))))))))|l(?:|(?:[0-9A-Z_a-hj-z]|-)[0-9A-Za-z_-]*|i(?:|(?:[0-9A-Z_a-eg-z]|-)[0-9A-Za-z_-]*|f(?:|(?:[0-9A-Z_a-su-z]|-)[0-9A-Za-z_-]*|t(?:[0-9A-Za-z_-]+))))|o(?:|(?:[0-9A-Z_a-uw-z]|-)[0-9A-Za-z_-]*|v(?:|(?:[0-9A-Z_a-df-z]|-)[0-9A-Za-z_-]*|e(?:|(?:[0-9A-Z_a-qs-z]|-)[0-9A-Za-z_-]*|r(?:|(?:[0-9A-Z_a-km-z]|-)[0-9A-Za-z_-]*|l(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-xz]|-)[0-9A-Za-z_-]*|y(?:|[0-9A-Z_a-z][0-9A-Za-z_-]*|-(?:|(?:[0-9A-Z_a-rt-z]|-)[0-9A-Za-z_-]*|s(?:|(?:[0-9A-Z_a-gi-z]|-)[0-9A-Za-z_-]*|h(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|(?:[0-9A-Z_a-np-z]|-)[0-9A-Za-z_-]*|o(?:|(?:[0-9A-Z_a-vx-z]|-)[0-9A-Za-z_-]*|w(?:[0-9A-Za-z_-]+))))))))))))))|p(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-mo-z]|-)[0-9A-Za-z_-]*|n(?:|(?:[0-9A-Z_a-df-z]|-)[0-9A-Za-z_-]*|e(?:|(?:[0-9A-Z_a-km-z]|-)[0-9A-Za-z_-]*|l(?:|[0-9A-Z_a-z][0-9A-Za-z_-]*|-(?:|(?:[0-9A-Z_a-rt-z]|-)[0-9A-Za-z_-]*|s(?:|(?:[0-9A-Z_a-gi-z]|-)[0-9A-Za-z_-]*|h(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|(?:[0-9A-Z_a