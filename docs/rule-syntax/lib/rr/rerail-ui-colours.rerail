named_colour(g) :- source(_, sp), match_group("(?m)(?:(?:^|[{;,'\\\"`])[ \\t]*(?:color|background(?:-color|-image)?|border(?:-[a-z]+){0,3}|outline(?:-color)?|fill|stroke|stop-color|flood-color|lighting-color|caret-color|accent-color|text-decoration(?:-color)?|column-rule(?:-color)?|box-shadow|text-shadow|scrollbar-color|-webkit-text-fill-color|backgroundColor|backgroundImage|borderColor|border(?:Top|Right|Bottom|Left|Block|Inline)[A-Za-z]*Color|outlineColor|caretColor|accentColor|textDecorationColor|stopColor|floodColor|boxShadow|textShadow|--(?:(?:[0-9A-Z_ad-kmnqrt-z]|-)[0-9A-Za-z_-]*|b(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-qs-z]|-)[0-9A-Za-z_-]*|r(?:|[0-9A-Z_a-z][0-9A-Za-z_-]*|-(?:|(?:[0-9A-Z_a-rt-z]|-)[0-9A-Za-z_-]*|s(?:|(?:[0-9A-Z_a-gi-z]|-)[0-9A-Za-z_-]*|h(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|(?:[0-9A-Z_a-np-z]|-)[0-9A-Za-z_-]*|o(?:|(?:[0-9A-Z_a-vx-z]|-)[0-9A-Za-z_-]*|w(?:[0-9A-Za-z_-]+))))))))))|c(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-qs-z]|-)[0-9A-Za-z_-]*|r(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|[0-9A-Z_a-z][0-9A-Za-z_-]*|-(?:|(?:[0-9A-Z_a-rt-z]|-)[0-9A-Za-z_-]*|s(?:|(?:[0-9A-Z_a-gi-z]|-)[0-9A-Za-z_-]*|h(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|(?:[0-9A-Z_a-np-z]|-)[0-9A-Za-z_-]*|o(?:|(?:[0-9A-Z_a-vx-z]|-)[0-9A-Za-z_-]*|w(?:[0-9A-Za-z_-]+)))))))))))|l(?:|(?:[0-9A-Z_a-hj-z]|-)[0-9A-Za-z_-]*|i(?:|(?:[0-9A-Z_a-eg-z]|-)[0-9A-Za-z_-]*|f(?:|(?:[0-9A-Z_a-su-z]|-)[0-9A-Za-z_-]*|t(?:[0-9A-Za-z_-]+))))|o(?:|(?:[0-9A-Z_a-uw-z]|-)[0-9A-Za-z_-]*|v(?:|(?:[0-9A-Z_a-df-z]|-)[0-9A-Za-z_-]*|e(?:|(?:[0-9A-Z_a-qs-z]|-)[0-9A-Za-z_-]*|r(?:|(?:[0-9A-Z_a-km-z]|-)[0-9A-Za-z_-]*|l(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-xz]|-)[0-9A-Za-z_-]*|y(?:|[0-9A-Z_a-z][0-9A-Za-z_-]*|-(?:|(?:[0-9A-Z_a-rt-z]|-)[0-9A-Za-z_-]*|s(?:|(?:[0-9A-Z_a-gi-z]|-)[0-9A-Za-z_-]*|h(?:|(?:[0-9A-Z_b-z]|-)[0-9A-Za-z_-]*|a(?:|(?:[0-9A-Z_a-ce-z]|-)[0-9A-Za-z_-]*|d(?:|(?:[0-9A-Z_a-n