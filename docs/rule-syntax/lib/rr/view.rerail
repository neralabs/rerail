// The view of a program image (decision 0662 §1): its rules, their literals and its fields as relations, which an
// analysis pass's rules read. The engine states the rows from the image; what is derived from them is here.
//
//   img_rule(r, head)              each rule, by its id, and its head's relation
//   img_lit(r, i, what, rel, neg)  each body literal `i` of rule `r` that names a relation: an atom ("atom") or an
//                                  aggregate's atom ("agg"), negated (1) or not (0)
//   img_decl(rel, cols)            each declared relation and its columns
//   img_facts(rel)                 each relation the image states facts of
//   img_kindset(set)               each kind set of the header, whatever its kinds
//
// The names are `img_`, not `rr_`: `rr_` is the lowering's own, for the helpers it makes.

.decl img_rule(r: symbol, head: symbol)
.decl img_lit(r: symbol, i: number, what: symbol, rel: symbol, neg: number)
.decl img_decl(rel: symbol, cols: symbol)
.decl img_facts(rel: symbol)
.decl img_kindset(set: symbol)

// A rule of `h` reads `b`, positively or not, in an atom or an aggregate.
.decl img_reads(h: symbol, b: symbol)
img_reads(h, b) :- img_rule(r, h), img_lit(r, _, "atom", b, _).
img_reads(h, b) :- img_rule(r, h), img_lit(r, _, "agg", b, _).

// The image holds `rel` as a relation: declared, stated by facts, or the head of a rule.
.decl img_held(rel: symbol)
img_held(rel) :- img_decl(rel, _).
img_held(rel) :- img_facts(rel).
img_held(rel) :- img_rule(_, rel).
