+def test_flags_every_function_on_a_call_cycle_whatever_the_name_order() -> None:
+    # a calls b, then eager; b calls only a. With one memo shared by all roots, searching a first
+    # skips a inside b (a is still open), records b as reaching nothing, and b goes unreported.
+    source = """
+def a(server_plan):
+    b(server_plan)
+    return eager(server_plan)
+
+def b(server_plan):
+    return a(server_plan)
+
+def eager(server_plan):
+    return server_plan.execute_lazy().resolve()
+"""
+    violations = scan_file_content("l9750_graphql/executor.py", source)
+    reported = {violation.message.split(" ", 1)[0] for violation in violations if violation.code == "LEG-083"}
+    assert reported == {"a", "b", "eager"}
