+_PATH_CLASSES = frozenset({"Path", "PurePath", "PosixPath", "WindowsPath", "PurePosixPath", "PureWindowsPath"})
+_PATH_METHODS = frozenset(
+    {"absolute", "cwd", "expanduser", "home", "joinpath", "readlink", "relative_to", "resolve", "with_name", "with_stem", "with_suffix"},
+)
+_PATH_ATTRS = frozenset({"parent", "parents"})
+
+
+def _scope_nodes(body: list[ast.stmt]) -> list[ast.AST]:
+    """Nodes under `body` that belong to its scope: not inside a nested def, class or lambda."""
+    out: list[ast.AST] = []
+    stack: list[ast.AST] = list(reversed(body))
+    while stack:
+        node = stack.pop()
+        out.append(node)
+        stack.extend(
+            child
+            for child in reversed(list(ast.iter_child_nodes(node)))
+            if not isinstance(child, ast.FunctionDef | ast.AsyncFunctionDef | ast.ClassDef | ast.Lambda)
+        )
+    return out
+
+
+@dataclass
+class _PathScope:
+    """Names that hold a pathlib path in one scope: approximate and flow-insensitive.
+
+    A name is a path if some binding of it in the scope is a parameter or annotated assignment whose
+    annotation mentions a path class, or an assignment from a path expression. Enclosing function
+    scopes and the module are consulted as Python's name lookup would.
+    """
+
+    outer: _PathScope | None
+    classes: frozenset[str]
+    modules: frozenset[str]
+    names: set[str]
+
+    @classmethod
+    def build(
+        cls: type[_PathScope],
+        node: ast.Module | ast.FunctionDef | ast.AsyncFunctionDef,
+        outer: _PathScope | None,
+    ) -> _PathScope:
+        if outer is None:
+            classes: set[str] = set()
+            modules: set[str] = set()
+            for item in ast.walk(node):
+                if isinstance(item, ast.ImportFrom) and item.module == "pathlib":
+                    classes.update(alias.asname or alias.name for alias in item.names if alias.name in _PATH_CLASSES)
+                elif isinstance(item, ast.Import):
+                    modules.update(alias.asname or "pathlib" for alias in item.names if alias.name == "pathlib")
+            scope = cls(None, frozenset(classes), frozenset(modules), set())
+        else:
+            scope = cls(outer, outer.classes, outer.modules, set())
+        if isinstance(node, ast.FunctionDef | ast.AsyncFunctionDef):
+            arguments = node.args
+            for arg in [*arguments.posonlyargs, *arguments.args, *arguments.kwonlyargs, arguments.vararg, arguments.kwarg]:
+                if arg is not None and arg.annotation is not None and scope._mentions_path(arg.annotation):
+                    scope.names.add(arg.arg)
+        bindings: list[tuple[str, ast.expr | None, ast.expr | None]] = []
+        for item in _scope_nodes(node.body):
+            if isinstance(item, ast.Assign):
+                bindings.extend((target.id, item.value, None) for target in item.targets if isinstance(target, ast.Name))
+            elif isinstance(item, ast.AnnAssign) and isinstance(item.target, ast.Name):
+                bindings.append((item.target.id, item.value, item.annotation))
+            elif isinstance(item, ast.NamedExpr):
+                bindings.append((item.target.id, item.value, None))
+        changed = True
+        while changed:
+            changed = False
+            for name, value, annotation in bindings:
+                if name in scope.names:
+                    continue
+                if (annotation is not None and scope._mentions_path(annotation)) or (value is not None and scope.is_path(value)):
+                    scope.names.add(name)
+                    changed = True
+        return scope
+
+    def _is_class(self: _PathScope, node: ast.expr) -> bool:
+        if isinstance(node, ast.Name):
+            return node.id in self.classes
+        return isinstance(node, ast.Attribute) and node.attr in _PATH_CLASSES and isinstance(node.value, ast.Name) and node.value.id in self.modules
+
+    def _mentions_path(self: _PathScope, annotation: ast.expr) -> bool:
+        if isinstance(annotation, ast.Constant) and isinstance(annotation.value, str):
+            try:
+                annotation = ast.parse(annotation.value, mode="eval").body
+            except SyntaxError:
+                return False
+        return any(isinstance(item, ast.expr) and self._is_class(item) for item in ast.walk(annotation))
+
+    def _has(self: _PathScope, name: str) -> bool:
+        scope: _PathScope | None = self
+        while scope is not None:
+            if name in scope.names:
+                return True
+            scope = scope.outer
+        return False
+
+    def is_path(self: _PathScope, node: ast.expr) -> bool:
+        if isinstance(node, ast.Name):
+            return self._has(node.id)
+        if isinstance(node, ast.Call):
+            func = node.func
+            if self._is_class(func):
+                return True
+            return isinstance(func, ast.Attribute) and func.attr in _PATH_METHODS and (self.is_path(func.value) or self._is_class(func.value))
+        if isinstance(node, ast.Attribute):
+            return node.attr in _PATH_ATTRS and self.is_path(node.value)
+        if isinstance(node, ast.Subscript):
+            return isinstance(node.value, ast.Attribute) and node.value.attr == "parents" and self.is_path(node.value.value)
+        if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
+            return self.is_path(node.left)
+        if isinstance(node, ast.IfExp):
+            return self.is_path(node.body) or self.is_path(node.orelse)
+        return False
+
+
+def _is_lazy_terminal_call(node: ast.Call, scope: _PathScope | None) -> bool:
+    """LazyResult/LazySeq `resolve(self)` and `resolve_async(self)` take no arguments; a pathlib path's
+    `resolve()` is not a lazy terminal."""
+    if node.args or node.keywords:
+        return False
+    func = node.func
+    return not (isinstance(func, ast.Attribute) and scope is not None and scope.is_path(func.value))
