+def test_allows_pathlib_resolve_on_annotated_parameter() -> None:
+    source = """
+from pathlib import Path
+
+def load(path: Path) -> Path:
+    return path.resolve()
+
+def run(path: Path) -> Path:
+    return load(path)
+"""
+    violations = scan_file_content("l1100_exceptions/files.py", source)
+    assert not any(violation.code == "LEG-083" for violation in violations)
+
+
+def test_allows_pathlib_resolve_on_constructed_and_module_paths() -> None:
+    source = """
+from pathlib import Path
+
+ROOT = Path(__file__).with_name("data")
+
+def root() -> Path:
+    return ROOT.resolve()
+
+def child(name: str) -> str:
