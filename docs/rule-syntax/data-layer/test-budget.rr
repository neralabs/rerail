.policy "data-layer:test-budget" revision 1
.description "The conformance test count may not exceed its signed ceiling, nor drop by more than 10% at once."
.language python
.mode block
.scope dirs "conform"
.scope tests true
// Python check: scripts/check_test_budget.py. pytest collects the tests under conform/; their number may not
// exceed total_tests in .test-budget-baseline.json, whose counts are signed. A drop of more than 10% fails too:
// it is more likely a broken collection than deleted tests. The script reports one finding, at the baseline.
//
// How to read this file
//   1. static_tests: a lower bound from the source. If it already exceeds the ceiling, the check fails without
//      collecting, as the script does.
//   2. collected_total: pytest's own count, from the test_collection artifact a CI step writes (RUN-FACTS.md).
//   3. The baseline: the ceiling, its signature checked in Datalog. A bad baseline is a gate.
//   4. budget_exceeded: over the ceiling, by the bound or by the count; or dropped by more than 10%.
//
// Shows: a run artifact, a static rule that works without it, a gate, and a metric ratchet written as rules.
// Without the artifact, the first budget_exceeded rule still reports; the other two are Unknown at the baseline
// file (FINDINGS-LAYER.md, section 2).

#include "python/ast.rr"
#include "data-layer/signing.rr"
//   nera_key (provided there): the repository's public key

// ---- 1. the static lower bound -----------------------------------------------------------------------------------
// The script's _static_test_function_lower_bound, per conform/**/test_*.py file: top-level test* functions, plus
// the test* method names of each top-level Test* class that defines neither __init__ nor __new__ (pytest does not
// collect those). Method names are a set in the script, so a name defined twice counts once.
.decl conform_test(d: number)
conform_test(d) :- doc(d, p, _), match("conform/(?:.+/)?test_[^/]*\\.py", p).
// stmt_def(b, f): f is a def or class statement of body b, decorated or not, async or not.
.decl stmt_def(b: node, f: node)
stmt_def(b, f) :- body_stmt(b, f, _), (kind(f, "function_definition") ; kind(f, "class_definition")).
stmt_def(b, f) :- body_stmt(b, s, _), kind(s, "decorated_definition"), field(s, "definition", f).
.decl test_module(m: node)
test_module(m) :- conform_test(d), kind(m, "module"), docof(m, d).
.decl lb_function(f: node)
lb_function(f) :- test_module(m), stmt_def(m, f), kind(f, "function_definition"), def_name(f, x), prefix("test", x).
.decl test_class(c: node, b: node)
test_class(c, b) :- test_module(m), stmt_def(m, c), kind(c, "class_definition"), def_name(c, x), prefix("Test", x),
    field(c, "body", b),
    count : { stmt_def(b, g), kind(g, "function_definition"), def_name(g, y), (y = "__init__" ; y = "__new__") } = 0.
.decl lb_method(c: node, x: symbol)
lb_method(c, x) :- test_class(c, b), stmt_def(b, f), kind(f, "function_definition"), def_name(f, x),
    prefix("test", x).
.decl static_tests(n: number)
.output static_tests
static_tests(n) :- n = count : { lb_function(_) } + count : { lb_method(_, _) }.

// ---- 2. pytest's count: the test_collection artifact -------------------------------------------------------------
// What collect_test_counts returns: {"total_tests", "total_skipped", "by_directory"}. Collection imports the tests
// and whatever they import, so every Python file is an input; so are pytest's configuration and the backend
// config the script passes. The producer fails when pytest fails or reports fewer than 1000 tests.
.artifact "test_collection" inputs "**/*.py", "pyproject.toml", "uv.lock", "conform/backends.sqlite.yaml"
.decl collected_total(n: number)
.input collected_total(IO=json, artifact="test_collection", path="/total_tests")

// ---- 3. the baseline ---------------------------------------------------------------------------------------------
// {"total_tests": 15000, "total_skipped": 0, "by_directory": {…}, "_metadata": {"signature": "…", …}}.
// The signature covers total_tests and total_skipped only: json.dumps({…}, sort_keys=True), with json.dumps'
// default separators ", " and ": ". Checked against the real signature at the pinned revision.
.decl base_total(n: number)
.input base_total(IO=json, filename=".test-budget-baseline.json", path="/total_tests")
.decl base_skipped(n: number)
.input base_skipped(IO=json, filename=".test-budget-baseline.json", path="/total_skipped")
.decl base_dir(k: symbol, n: number)
.input base_dir(IO=json, filename=".test-budget-baseline.json", path="/by_directory")
.decl base_sig(s: symbol)
.input base_sig(IO=json, filename=".test-budget-baseline.json", path="/_metadata/signature")

// counts.get(key, 0): an absent count is 0, in the message and in the comparison.
.decl total(n: number)
total(n) :- base_total(n).
total(0) :- file(".test-budget-baseline.json"), !base_total(_).
.decl skipped(n: number)
skipped(n) :- base_skipped(n).
skipped(0) :- file(".test-budget-baseline.json"), !base_skipped(_).
.decl signed_ok()
signed_ok() :- base_sig(s), s != "", total(t), skipped(k),
    m = cat("{\"total_skipped\": ", to_string(k), ", \"total_tests\": ", to_string(t), "}"),
    count : { nera_key(key), @ed25519_ok(key, m, s) = 1 } > 0.

// The script's three early returns, in its order; each is the whole report. A malformed file reads as missing
// (load_baseline returns None).
.violation missing_baseline(at: loc) "test budget baseline file not found"
missing_baseline(@place(".test-budget-baseline.json", 1)) :- !file(".test-budget-baseline.json").
missing_baseline(@place(".test-budget-baseline.json", 1)) :- input_error(".test-budget-baseline.json", k, _),
    k != "missing".
.violation unsigned_baseline(at: loc) "test budget baseline has no signature"
unsigned_baseline(@place(".test-budget-baseline.json", 1)) :- file(".test-budget-baseline.json"),
    !input_error(".test-budget-baseline.json", _, _), count : { base_sig(s), s != "" } = 0.
.violation invalid_signature(at: loc) "test budget baseline signature is invalid"
invalid_signature(@place(".test-budget-baseline.json", 1)) :- base_sig(s), s != "", !signed_ok().
.gate missing_baseline, unsigned_baseline, invalid_signature

// The ceiling, from a verified baseline only. The drop is measured against the observed total, the sum of
// by_directory when it is a non-empty object of numbers, since the signed ceiling may be set higher on purpose.
.decl ceiling(n: number)
ceiling(n) :- signed_ok(), total(n).
.decl observed(n: number)
observed(n) :- ceiling(_), count : { base_dir(_, _) } > 0, n = sum c : { base_dir(_, c) }.
observed(n) :- ceiling(n), count : { base_dir(_, _) } = 0.

// ---- 4. the findings ---------------------------------------------------------------------------------------------
// One code, budget_exceeded, at the baseline's first line; the message says which case.
.violation budget_exceeded(at: loc, why: symbol) "{why}"
// The static bound is over: the script reports this without running pytest. This rule does not read the
// artifact, so it reports on a laptop too.
budget_exceeded(@place(".test-budget-baseline.json", 1), why) :- static_tests(n), ceiling(c), n > c,
    why = cat("static lower bound of ", to_string(n), " tests exceeds the signed budget of ", to_string(c)).
// pytest's count is over the ceiling.
budget_exceeded(@place(".test-budget-baseline.json", 1), why) :- collected_total(n), ceiling(c), n > c,
    why = cat("total test count exceeded the budget by ", to_string(n - c), " (", to_string(c), " -> ",
        to_string(n), ")").
// Within the ceiling, but down more than 10% of the observed total: (o - n) / o > 0.10.
budget_exceeded(@place(".test-budget-baseline.json", 1), why) :- collected_total(n), ceiling(c), n <= c,
    observed(o), n < o, (o - n) * 10 > o,
    why = cat("test count dropped by ", to_string(o - n), " of an observed ", to_string(o),
        "; likely a collection failure, or re-sign the baseline").

// A failed collection fails the check, as the script exits 1. Not when the static bound is already over:
// the script would not have collected.
.violation collection_failed(at: loc, why: symbol) "pytest collection failed: {why}"
collection_failed(@place(".test-budget-baseline.json", 1), why) :-
    input_error("artifact:test_collection", "failed", why), ceiling(c), static_tests(n), n <= c.

// Differences from the script, all at the edges:
//   the script's plugin counts only files that parse; a conform file that does not parse is withheld here too,
//   which makes static_tests (an aggregate) Unknown, and with it the first budget_exceeded rule;
//   a by_directory value that is not a number makes the script use the ceiling as the observed total; here the
//   JSON reader rejects the file as malformed, and the gate reports it as missing_baseline.
