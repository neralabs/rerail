.policy "data-layer:plan-scope-side-effects" revision 1
.description "Plan scopes hold declarative planning only: no eager resolution, raw SQL, legacy callbacks or Python side effects."
.language python
.mode block
.mode log PSE_AUDIT_010          // severity "audit": the CLI prints it, the suite plugin drops it, it never blocks
.possible log                    // side-effect calls whose receiver does not resolve
.scope dirs "impl", "data_layer", "_internal", "l[0-9][0-9][0-9][0-9]_*"   // data_layer_production_dirs
.scope tests false
// Python linter: scripts/lint_plan_scope_side_effects.py (codes PSE-010 … PSE-AUDIT-010, given by each `code`). A plan scope is a
// `with` (or `async with`) an item of which calls open_*_plan; the innermost one governs every node below it.
//   PSE_010 `.resolved_value`   PSE_020 resolve() / resolve_async()   PSE_030 raw SQL execution calls
//   PSE_040 `.read()` / `.write()` legacy callbacks   PSE_050 open(), or open/sleep/run/get/… on asyncio, os, requests, …
//   PSE_AUDIT_010 in a write plan, an `if`/`elif` whose test is a typed eager read or reads a name bound to one
// Improves on the Python linter:
//   side-effect calls match on resolved names: `from time import sleep; sleep(1)` and `import requests as r` are caught;
//   a call on a receiver that does not resolve but whose text names one of the modules is reported `possible`;
//   PSE_AUDIT_010 follows each name in the test to its binding (ref_site), not to any earlier same-named assignment.
//
// How to read this file
//   1. cname / method_call name each call by its last identifier, as the Python linter's _call_name does.
//   2. item_call / plan / write_plan find the plan scopes: with-statements that open a plan.
//   3. PSE_010 … PSE_050 are each "a forbidden node, inside some plan scope": nearest(n, _, plan).
//   4. fx is three-valued (must, may): resolved side-effect calls are definite, unresolved look-alikes are possible.
//   5. PSE_AUDIT_010 pairs eager reads bound inside a write plan (eager_site) with `if` tests in the same plan.
// The Python linter keeps a stack of open plan scopes while walking the tree; here "inside a plan" is a tree query instead.

#include "python/names.rr"
#include "python/calls.rr"
#include "python/ast.rr"      // unparen

// Calls that open a plan scope (the Python linter's PLAN_OPENERS), and the subset that opens a write plan.
.decl opener(v: symbol)
opener("open_read_plan"). opener("open_write_plan"). opener("open_provider_read_plan").
opener("open_provider_write_plan"). opener("open_provider_versioned_read_plan").
opener("open_provider_versioned_write_plan").
.decl write_opener(v: symbol)
write_opener("open_write_plan"). write_opener("open_provider_write_plan").
write_opener("open_provider_versioned_write_plan").
// Forbidden names, one set per code: PSE_020 eager resolution, PSE_030 raw SQL, PSE_040 legacy callbacks.
.decl eager_call(v: symbol)
eager_call("resolve"). eager_call("resolve_async").
.decl raw_call(v: symbol)
raw_call("execute_raw"). raw_call("fetchone_raw"). raw_call("fetchall_raw").
raw_call("nonportably_execute_sql").
.decl legacy_cb(v: symbol)
legacy_cb("read"). legacy_cb("write"). legacy_cb("read_async").
legacy_cb("write_async").
// Typed eager query terminals (TYPED_EAGER_QUERY_TERMINALS): their result is a Python value, read for PSE_AUDIT_010.
.decl eager_read(v: symbol)
eager_read("count"). eager_read("count_async"). eager_read("execute").
eager_read("execute_async"). eager_read("execute_one").
eager_read("execute_one_async"). eager_read("first"). eager_read("first_async").
eager_read("select_one"). eager_read("select_one_async").
// Side-effect call names (SIDE_EFFECT_CALLS) and the modules they count on (SIDE_EFFECT_RECEIVERS).
.decl fx_name(v: symbol)
fx_name("open"). fx_name("sleep"). fx_name("run"). fx_name("Popen").
fx_name("request"). fx_name("get"). fx_name("post"). fx_name("put"). fx_name("patch").
fx_name("delete").
.decl fx_module(v: symbol)
fx_module("asyncio"). fx_module("subprocess"). fx_module("requests").
fx_module("httpx"). fx_module("socket"). fx_module("shutil"). fx_module("os").
fx_module("time").
// Binding forms that carry a value: `x = …` and `x: T = …`.
.decl assign_form(v: symbol)
assign_form("assign"). assign_form("annassign").
// `elif` is its own node in this grammar; the Python linter sees it as a nested ast.If, so both kinds are tested.
.decl branch(v: symbol)
branch("if_statement"). branch("elif_clause").

// cname(c, x): the name call c is made by, `f(…)` or `….f(…)`; method_call(c) for the second form.
.decl cname(c: node, x: symbol)
// `f(…)`: the function's own name.
cname(c, x) :- callee(c, n), kind(n, "identifier"), text(n, x).
// `obj.f(…)`: the attribute name, whatever the receiver is.
cname(c, x) :- callee(c, n), kind(n, "attribute"), field(n, "attribute", a), text(a, x).
.decl method_call(c: node)
method_call(c) :- callee(c, n), kind(n, "attribute").

// item_call(w, c): c is the call in one of with-statement w's items (`with c as p` or `with c`).
.decl item_call(w: node, c: node)
// item_value(w, v): the expression of one item of `with` statement w. `async with` parses to the same node kind.
.decl item_value(w: node, v: node)
item_value(w, v) :- kind(w, "with_statement"), child(w, cl, _), kind(cl, "with_clause"), child(cl, it, _),
    field(it, "value", v).
// `with open_write_plan(…):` — the item is the call itself.
item_call(w, c) :- item_value(w, c), call(c).
// `with open_write_plan(…) as p:` — the call is the first child of the `as` pattern.
item_call(w, c) :- item_value(w, v), kind(v, "as_pattern"), child(v, c, 0), call(c).
// plan(w): w is a plan scope. Used as a set in nearest(n, w, plan): "n is inside plan scope w", w the innermost.
// Nodes in the with-items count as inside too, as in the Python linter, which opens the scope before visiting the items.
.decl plan(w: node)
plan(w) :- item_call(w, c), cname(c, x), opener(x).
// write_plan(w): some item opens a write plan (the Python linter's any(_is_write_plan_scope_item …)).
.decl write_plan(w: node)
write_plan(w) :- item_call(w, c), cname(c, x), write_opener(x).

// PSE_010: any `….resolved_value` attribute inside a plan scope (EAGER_VALUE_ATTRS has only this name).
.violation PSE_010(at: node) code "PSE-010" "resolved_value is forbidden inside plan-scope construction."
PSE_010(a) :- kind(a, "attribute"), field(a, "attribute", t), text(t, "resolved_value"), nearest(a, _, plan).

// PSE_020: resolve() or resolve_async() called, plain or as a method, inside a plan scope.
.violation PSE_020(at: node, name: symbol) code "PSE-020" "{name}() is eager resolution inside plan-scope construction."
PSE_020(c, x) :- cname(c, x), eager_call(x), nearest(c, _, plan).

// PSE_030: a raw SQL call inside a plan scope.
.violation PSE_030(at: node, name: symbol) code "PSE-030" "{name}() is raw database execution inside plan-scope construction."
PSE_030(c, x) :- cname(c, x), raw_call(x), nearest(c, _, plan).

// PSE_040: read/write callbacks only as method calls (`txn.read(…)`): a bare read() is some other function.
// The four name sets are disjoint, so separate rules give the same result as the Python linter's if/elif chain.
.violation PSE_040(at: node, name: symbol) code "PSE-040" "Nested legacy callback API {name}() is forbidden inside plan scopes."
PSE_040(c, x) :- method_call(c), cname(c, x), legacy_cb(x), nearest(c, _, plan).

// must: proven by name resolution. may: only a textual hint. A PSE_050 resting only on a may row is "possible".
// fx(c, x): call c is a Python side effect named x.
.decl fx(c: node, x: symbol)  must, may
// The builtin open(). global_ref means no local binding shadows it; the Python linter matches any name `open`.
must fx(c, "open") :- callee(c, n), global_ref(n, "open").
// The callee resolves to q, e.g. "time.sleep" or "requests.get" (aliases and from-imports included). The first dotted
// segment of q must be a side-effect module and the last segment a side-effect name.
must fx(c, x) :- callee(c, n), sym_of(n, q), match("(?<m>[^.]+)\\..*", q), fx_module(m),
    match("(?:.*\\.)?(?<x>[^.]+)", q), fx_name(x).
// `recv.get(…)` where recv does not resolve: the Python linter's receiver-token test, as a word match on the receiver's text
// (case-insensitive). The text includes call arguments inside the receiver, which the Python linter's tokens do not.
may  fx(c, x) :- method_call(c), cname(c, x), fx_name(x), callee(c, n), !sym_of(n, _),
    field(n, "object", o), text(o, t), match("(?i).*\\b(asyncio|subprocess|requests|httpx|socket|shutil|os|time)\\b.*", t).

// PSE_050: a side-effect call inside a plan scope.
.violation PSE_050(at: node, name: symbol) code "PSE-050" "Python side-effect call {name}() is forbidden inside plan scopes."
PSE_050(c, x) :- fx(c, x), nearest(c, _, plan).

// The Python linter collects names assigned from eager reads per scope (on_Assign / on_AnnAssign); this keeps the binding
// site itself, so a later rebinding of the same name to something else is not confused with it.
// eager_site(s, w): binding site s, whose innermost plan scope is write plan w, takes a typed eager read (`n = q.count()`).
.decl eager_site(s: node, w: node)
eager_site(s, w) :- binding(_, _, s, k), assign_form(k), binding_value(s, v), cname(v, x), eager_read(x),
    nearest(s, w, plan), write_plan(w).
// if_test(i, w, t): an if/elif i with condition t, whose innermost plan scope w is a write plan.
.decl if_test(i: node, w: node, t: node)
if_test(i, w, t) :- kind(i, k), branch(k), field(i, "condition", t), nearest(i, w, plan), write_plan(w).

// PSE_AUDIT_010 has three cases: the test is itself an eager read call (`if q.count():`); the test is a name
// bound to an eager read in the same plan (`if n:`); or a name anywhere inside the test is (`if n > 0 and ok:`).
// Its mode is log (see .mode log PSE_AUDIT_010 above): reported, never blocking.
.violation PSE_AUDIT_010(at: node) code "PSE-AUDIT-010"
    "Read-then-Python-branch write orchestration inside a write plan. Prefer SQL-visible ConditionalStep, GuardedInsert, or upsert forms."
PSE_AUDIT_010(i) :- if_test(i, _, t0), unparen(t0, t), cname(t, x), eager_read(x).   // `if (q.count()):` too
PSE_AUDIT_010(i) :- if_test(i, w, t), ref_site(t, s), eager_site(s, w).
PSE_AUDIT_010(i) :- if_test(i, w, t), within(r, t), ref_site(r, s), eager_site(s, w).
