.policy "data-layer:graph-lazy-sql-plan" revision 1
.description "Graph lazy SQL intent-plan contract: graph entrypoints are lazy or legacy delegates, interim graph surfaces stay deleted."
.language python
.mode block
.scope include "l7200_versioned_transactions/versioned_lazy_mixin.py", "l7200_versioned_transactions/versioned_transactions.py", "l7200_versioned_transactions/graph_lazy_sql.py", "impl/common/l2070_server_plan/steps/intent_graph.py"
// Python linter: scripts/lint_graph_lazy_sql_plan.py. A contract over four fixed files; the codes mean different
// things in different files.
//   versioned_lazy_mixin.py   GLSP-001 a banned symbol is defined at top level; GLSP-002 no
//       VersionedReadTransactionLazyMixin (and then nothing else is reported); GLSP-003 graph_lazy missing (at the
//       class), or a removed graph shortcut present (at it); GLSP-004 graph_lazy not @pure_lazy
//   graph_lazy_sql.py         GLSP-006 a required class missing; GLSP-007 GraphLazyStepRegistrar lacks
//       `__pure_lazy_surface__ = …`; GLSP-008 a SqlPlanGraphQueryBuilder terminal missing; GLSP-009 not @pure_lazy
//   versioned_transactions.py GLSP-006 no LazyVersionedReadTransaction (alone); GLSP-007 graph / graph_async
//       missing, or a removed shortcut present; GLSP-010 lacks @legacy_sync / @legacy_async; GLSP-011 names no
//       legacy delegate body
//   intent_graph.py           GLSP-010 a banned interim symbol is bound at top level; GLSP-012 a required step
//       or function missing; GLSP-013 ExecuteGraphBindingsStep lacks cte_column_type_hints; GLSP-014 that method
//       does not mention one of six symbols
// The linter's summary, kept exactly:
//   top level is outside every def and class (under a module-level if/try counts); each name's last top-level
//     binding wins, and its kind with it: a banned def later rebound by `X = …` is no longer a def;
//   a class is the top-level classes of its name together: the first one's line, all their direct methods, the
//     last def of each method name; a direct method is a def whose innermost def or class is the class;
//   a decorator is named by its last name (`@x.pure_lazy` counts), called or not;
//   a method mentions every Name and attribute name inside it, decorators, defaults and nested defs included.
// Missing classes and symbols are reported at line 1.

#include "python/ast.rr"      // ast_name, assign_target, assign_ann, unparen
#include "data-layer/boot-python.rr" // deco_word, def_walk

// ---- the summary ----------------------------------------------------------------------------------------------
.decl glsp_scope(k: symbol)
glsp_scope("function_definition"). glsp_scope("class_definition").
// glsp_file(d, role): which of the four files d is.
.decl glsp_file(d: number, role: symbol)
glsp_file(d, "mixin") :- doc(d, "l7200_versioned_transactions/versioned_lazy_mixin.py", _).
glsp_file(d, "txn") :- doc(d, "l7200_versioned_transactions/versioned_transactions.py", _).
glsp_file(d, "sql") :- doc(d, "l7200_versioned_transactions/graph_lazy_sql.py", _).
glsp_file(d, "intent") :- doc(d, "impl/common/l2070_server_plan/steps/intent_graph.py", _).
// glsp_binding(d, x, k, n): node n binds x at top level, as a "class", "function", "assign" or "typealias".
.decl glsp_binding(d: number, x: symbol, k: symbol, n: node)
glsp_binding(d, x, "class", n) :- kind(n, "class_definition"), def_name(n, x), !nearest(n, _, glsp_scope), docof(n, d).
glsp_binding(d, x, "function", n) :- kind(n, "function_definition"), def_name(n, x), !nearest(n, _, glsp_scope),
    docof(n, d).
glsp_binding(d, x, "assign", t) :- assign_target(a, t), !assign_ann(a, _), kind(t, "identifier"), text(t, x),
    !nearest(a, _, glsp_scope), docof(a, d).
glsp_binding(d, x, "typealias", n) :- kind(n, "type_alias_statement"), field(n, "left", l), child(l, t, 0),
    kind(t, "identifier"), text(t, x), !nearest(n, _, glsp_scope), docof(n, d).
// `type X[T] = …`: the tree has no node for X inside the generic_type, so X is read off its text.
glsp_binding(d, x, "typealias", n) :- kind(n, "type_alias_statement"), field(n, "left", l), child(l, t, 0),
    kind(t, "generic_type"), text(t, s), match("(?<x>[^\\[\\s]+)\\s*\\[(?s:.*)", s), !nearest(n, _, glsp_scope),
    docof(n, d).
// glsp_top(d, x, k, l): x's last top-level binding is of kind k, at line l.
.decl glsp_top(d: number, x: symbol, k: symbol, l: number)
glsp_top(d, x, k, l) :- glsp_binding(d, x, k, n), count : { glsp_binding(d, x, _, n2), n2 > n } = 0, line(n, l).

// glsp_class(d, cx, l): the top-level classes named cx; l is the first one's line.
.decl glsp_class(d: number, cx: symbol, l: number)
glsp_class(d, cx, l) :- glsp_binding(d, cx, "class", _), l = min k : { glsp_binding(d, cx, "class", c), line(c, k) }.
// glsp_method(d, cx, m, f): f is the last def named m directly in a top-level class named cx.
.decl glsp_direct(d: number, cx: symbol, m: symbol, f: node)
glsp_direct(d, cx, m, f) :- kind(f, "function_definition"), def_name(f, m), nearest(f, c, glsp_scope),
    glsp_binding(d, cx, "class", c).
.decl glsp_method(d: number, cx: symbol, m: symbol, f: node)
glsp_method(d, cx, m, f) :- glsp_direct(d, cx, m, f), count : { glsp_direct(d, cx, m, f2), f2 > f } = 0.
// glsp_mentions(f, x): a Name x, or an attribute `….x`, is inside method f (its decorators included).
.decl glsp_mentions(f: node, x: symbol)
glsp_mentions(f, x) :- glsp_method(_, _, _, f), def_walk(n, f), ast_name(n, x).
glsp_mentions(f, x) :- glsp_method(_, _, _, f), def_walk(n, f), attr_of(n, _, x).
// glsp_class_assigns(d, cx, x): `x = …` in the body of a top-level class cx, outside its defs and nested classes.
.decl glsp_class_assigns(d: number, cx: symbol, x: symbol)
glsp_class_assigns(d, cx, x) :- assign_target(a, t), !assign_ann(a, _), kind(t, "identifier"), text(t, x),
    nearest(a, c, glsp_scope), glsp_binding(d, cx, "class", c).

.violation GLSP(at: loc, c: symbol, what: symbol) code {c} "{what}"

// ---- versioned_lazy_mixin.py ----------------------------------------------------------------------------------
.decl glsp_banned_lazy(x: symbol)
glsp_banned_lazy("_get_or_create_plan_flush_context"). glsp_banned_lazy("_lazy_result_for_plan_ref").
glsp_banned_lazy("_add_plan_intent"). glsp_banned_lazy("_MappedLazyContext"). glsp_banned_lazy("_map_lazy").
glsp_banned_lazy("_make_graph_query_builder"). glsp_banned_lazy("_TxnBoundGraphQueryBuilder").
glsp_banned_lazy("_PlanBackedGraphTraversal"). glsp_banned_lazy("_PlanBackedGraphQuery").
.decl glsp_mixin(d: number, l: number)  // the mixin file has the class, at line l
glsp_mixin(d, l) :- glsp_file(d, "mixin"), glsp_class(d, "VersionedReadTransactionLazyMixin", l).
GLSP(@place(p, l), "GLSP-001", cat(x, " is a banned graph lazy symbol and must remain deleted")) :- glsp_mixin(d, _),
    glsp_top(d, x, k, l), (k = "function" ; k = "class"), glsp_banned_lazy(x), doc(d, p, _).
GLSP(@place(p, 1), "GLSP-002", "VersionedReadTransactionLazyMixin class not found") :- glsp_file(d, "mixin"),
    !glsp_mixin(d, _), doc(d, p, _).
GLSP(@place(p, l), "GLSP-003", "graph_lazy must exist as a pure lazy graph entrypoint") :- glsp_mixin(d, l),
    !glsp_method(d, "VersionedReadTransactionLazyMixin", "graph_lazy", _), doc(d, p, _).
GLSP(f, "GLSP-004", "graph_lazy must be decorated with @pure_lazy") :- glsp_mixin(d, _),
    glsp_method(d, "VersionedReadTransactionLazyMixin", "graph_lazy", f), !deco_word(f, "pure_lazy").
GLSP(f, "GLSP-003", cat("removed graph shortcut must remain absent: ", m)) :- glsp_mixin(d, _),
    glsp_method(d, "VersionedReadTransactionLazyMixin", m, f), (m = "graph_query_builder_lazy" ; m = "graph_traverse_lazy").

// ---- graph_lazy_sql.py ----------------------------------------------------------------------------------------
.decl glsp_sql_class(cx: symbol)
glsp_sql_class("GraphLazyStepRegistrar"). glsp_sql_class("SqlGraphExecutionCtx"). glsp_sql_class("SqlPlanGraphQuery").
glsp_sql_class("SqlPlanGraphQueryBuilder"). glsp_sql_class("SqlPlanGraphTraversal").
.decl glsp_terminal(m: symbol)
glsp_terminal("execute_lazy"). glsp_terminal("execute_one_lazy"). glsp_terminal("count_lazy").
glsp_terminal("exists_lazy"). glsp_terminal("execute_bindings_lazy"). glsp_terminal("execute_aggregate_lazy").
glsp_terminal("execute_paths_lazy").
GLSP(@place(p, 1), "GLSP-006", cat("required graph lazy SQL class is missing: ", cx)) :- glsp_file(d, "sql"),
    glsp_sql_class(cx), !glsp_class(d, cx, _), doc(d, p, _).
GLSP(@place(p, l), "GLSP-007", "GraphLazyStepRegistrar must declare __pure_lazy_surface__") :- glsp_file(d, "sql"),
    glsp_class(d, "GraphLazyStepRegistrar", l), !glsp_class_assigns(d, "GraphLazyStepRegistrar", "__pure_lazy_surface__"),
    doc(d, p, _).
GLSP(@place(p, 1), "GLSP-007", "GraphLazyStepRegistrar must declare __pure_lazy_surface__") :- glsp_file(d, "sql"),
    !glsp_class(d, "GraphLazyStepRegistrar", _), doc(d, p, _).
GLSP(@place(p, l), "GLSP-008", cat("SqlPlanGraphQueryBuilder terminal is missing: ", m)) :- glsp_file(d, "sql"),
    glsp_class(d, "SqlPlanGraphQueryBuilder", l), glsp_terminal(m), !glsp_method(d, "SqlPlanGraphQueryBuilder", m, _),
    doc(d, p, _).
GLSP(f, "GLSP-009", cat(m, " must be decorated with @pure_lazy")) :- glsp_file(d, "sql"), glsp_terminal(m),
    glsp_method(d, "SqlPlanGraphQueryBuilder", m, f), !deco_word(f, "pure_lazy").

// ---- versioned_transactions.py --------------------------------------------------------------------------------
.decl glsp_surface(m: symbol, k: symbol)  // the public delegate surfaces and their decorators
glsp_surface("graph", "legacy_sync"). glsp_surface("graph_async", "legacy_async").
.decl glsp_txn(d: number, l: number)
glsp_txn(d, l) :- glsp_file(d, "txn"), glsp_class(d, "LazyVersionedReadTransaction", l).
GLSP(@place(p, 1), "GLSP-006", "LazyVersionedReadTransaction class not found") :- glsp_file(d, "txn"), !glsp_txn(d, _),
    doc(d, p, _).
GLSP(@place(p, l), "GLSP-007", cat(m, " must exist as a public delegate surface")) :- glsp_txn(d, l), glsp_surface(m, _),
    !glsp_method(d, "LazyVersionedReadTransaction", m, _), doc(d, p, _).
GLSP(f, "GLSP-010", cat(m, cat(" must be decorated with @", k))) :- glsp_txn(d, _), glsp_surface(m, k),
    glsp_method(d, "LazyVersionedReadTransaction", m, f), !deco_word(f, k).
GLSP(f, "GLSP-011", cat(m, " must remain a legacy delegate shell")) :- glsp_txn(d, _), glsp_surface(m, _),
    glsp_method(d, "LazyVersionedReadTransaction", m, f),
    !glsp_mentions(f, "_legacy_delegate_stub"), !glsp_mentions(f, "_txn_legacy_delegate_body"),
    !glsp_mentions(f, "_versioned_legacy_delegate_body").
GLSP(f, "GLSP-007", cat("removed graph shortcut must remain absent: ", m)) :- glsp_txn(d, _),
    glsp_method(d, "LazyVersionedReadTransaction", m, f), glob("graph_{query_builder,traverse}{,_async}", m).

// ---- intent_graph.py ------------------------------------------------------------------------------------------
.decl glsp_banned_intent(x: symbol)
glsp_banned_intent("_GraphQueryTerminalMode"). glsp_banned_intent("_clone_graph_pattern").
glsp_banned_intent("GraphQueryTerminalIntent"). glsp_banned_intent("GraphQueryTerminalStep").
.decl glsp_required_intent(x: symbol)
glsp_required_intent("ExecuteGraphNodesStep"). glsp_required_intent("ExecuteGraphOneStep").
glsp_required_intent("ExecuteGraphCountStep"). glsp_required_intent("ExecuteGraphExistsStep").
glsp_required_intent("ExecuteGraphBindingsStep"). glsp_required_intent("ExecuteGraphAggregateStep").
glsp_required_intent("ExecuteGraphPathsStep"). glsp_required_intent("_build_graph_execution_ctx").
.decl glsp_hint(x: symbol)  // what cte_column_type_hints must mention
glsp_hint("SqlColumnTypeHints"). glsp_hint("_binding_node_sys_id_alias"). glsp_hint("_binding_edge_alias").
glsp_hint("uuid_columns"). glsp_hint("text_columns"). glsp_hint("integer_columns").
GLSP(@place(p, l), "GLSP-010", cat(x, " is a banned interim graph terminal symbol and must remain deleted")) :-
    glsp_file(d, "intent"), glsp_top(d, x, _, l), glsp_banned_intent(x), doc(d, p, _).
GLSP(@place(p, 1), "GLSP-012", cat("required graph intent symbol is missing: ", x)) :- glsp_file(d, "intent"),
    glsp_required_intent(x), !glsp_top(d, x, "class", _), !glsp_top(d, x, "function", _), doc(d, p, _).
GLSP(@place(p, l), "GLSP-013", "ExecuteGraphBindingsStep must declare cte_column_type_hints()") :-
    glsp_file(d, "intent"), glsp_class(d, "ExecuteGraphBindingsStep", l),
    !glsp_method(d, "ExecuteGraphBindingsStep", "cte_column_type_hints", _), doc(d, p, _).
GLSP(f, "GLSP-014", cat("cte_column_type_hints() must mention ", x)) :- glsp_file(d, "intent"),
    glsp_method(d, "ExecuteGraphBindingsStep", "cte_column_type_hints", f), glsp_hint(x), !glsp_mentions(f, x).
