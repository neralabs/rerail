.policy "data-layer:pure-lazy-runtime-purity" revision 1
.description "Pure-lazy functions and the helpers they reach do not touch runtime handles, ambient state or global caches."
.language python
.mode block
.scope tests false
// Python linter: scripts/lint_pure_lazy_runtime_purity.py. Two entry points, chosen by the `entryPoint` option:
//   scan_source  one file at a time: each def decorated @pure_lazy (by its last name), and every def inside one
//   scan_paths   (the default, and the plugin's) the project: the defs decorated @pure_lazy / @lazy, closed over the
//                calls they make (cross-file, through imports and base classes), stopping at @legacy_* defs. A def
//                reached only by the closure is "strict": any receiver of a protected attribute counts. A second
//                closure starts at *_lazy defs with an owner parameter (txn, conn, …) that call a plan-helper
//                terminal (grammar_rows_lazy, …); its defs report only PLP-001…005.
// In each analysed def the linter walks the body in `ast` order, nested defs included:
//   PLP-001  `x._conn` (a protected attribute) on a parameter, or on a local tainted by runtime state
//   PLP-002  `getattr(x, "_conn", …)` on the same receivers
//   PLP-003  a return whose value holds such an access, or (under a runtime-handle return annotation) returns a
//            ContextVar `.get()` or a runtime-handle helper's result
//   PLP-004  the same inside `LazyResult.of(…)` / `LazySeq.…`
//   PLP-005  a return that mentions a tainted local
//   PLP-006  the def's return annotation names BatchContext, ReadTransaction, … (a runtime-handle type)
//   PLP-007  (scan_paths) a public *_lazy function exported by a data_layer/*.py module lacks @pure_lazy
//   PLP-008  a return of module-level runtime state (by Name, not a call or subscript), the same passed as a
//            runtime-sink keyword (txn=, conn=, …), or a call on a module-level ContextVar
//   PLP-009  a read, `[]` or `.method` on a module-level mutable global or runtime object (managed caches may
//            .get/.set; three schema-registry accesses are exempt)
//   PLP-010  a LazyOperation whose payload carries a handle field, returned directly or through queue_single
// Each visit stops at the first finding in that node, so nothing under a reported node is reported again.
//
// Not modelled (see NOTES-purity.md): the plugin's signed grandfathered allowlist (6-field strict inventory with
// content ids) and its burn-down ceiling, so in a full-repository run every grandfathered finding is reported;
// the shared-facts narrowing of scan_paths is approximated (a file joins when its text has "_lazy" or a closure
// def reaches it through an import, not through a base class).

#include "data-layer/purity-ast.rr"
#include "../data-layer/pure-lazy-runtime-purity.tables.rr"

// ==== 1. spelling: chains, arguments, keywords ====================================================================
// _call_chain(e): `a.b.c` gives (a, b, c); through calls, `a.b()` gives (a, b). short_name is its last name.
// plp_head(e, x): its first name. plp_long(e): two names or more.
.decl plp_chained(e: node)
plp_chained(e) :- kind(e, "identifier").
plp_chained(e) :- attr_of(e, _, _).
plp_chained(e) :- kind(e, "call"), field(e, "function", g), plp_chained(g).
.decl plp_head(e: node, x: symbol)
plp_head(e, x) :- kind(e, "identifier"), text(e, x).
plp_head(e, x) :- attr_of(e, o, _), plp_head(o, x).
plp_head(e, a) :- attr_of(e, o, a), !plp_chained(o).
plp_head(e, x) :- kind(e, "call"), field(e, "function", g), plp_head(g, x).
.decl plp_long(e: node)
plp_long(e) :- attr_of(e, o, _), plp_chained(o).
plp_long(e) :- kind(e, "call"), field(e, "function", g), plp_long(g).
// plp_root(e, x): _expr_root_name: `a.b.c` gives a; a call or subscript in the chain gives none.
.decl plp_root(e: node, x: symbol)
plp_root(e, x) :- kind(e, "identifier"), text(e, x).
plp_root(e, x) :- attr_of(e, o, _), plp_root(o, x).

// plp_pos(c, i, a): a is c's i-th positional argument (`*xs` counts, as ast.Call.args holds it).
.decl plp_posk(a: node)
plp_posk(a) :- kind(al, "argument_list"), child(al, a, _), !kind(a, "keyword_argument"), !kind(a, "dictionary_splat"),
    !kind(a, "comment").
.decl plp_pos(c: node, i: number, a: node)
plp_pos(c, i, a) :- kind(c, "call"), field(c, "arguments", al), child(al, a, _), plp_posk(a),
    i = count : { child(al, b, _), plp_posk(b), b < a }.
.decl plp_npos(c: node, k: number)
plp_npos(c, k) :- kind(c, "call"), field(c, "arguments", al), kind(al, "argument_list"),
    k = count : { child(al, b, _), plp_posk(b) }.
// plp_kw(c, k, v): c passes k=v.
.decl plp_kw(c: node, k: symbol, v: node)
plp_kw(c, k, v) :- kind(c, "call"), field(c, "arguments", al), child(al, ka, _), kind(ka, "keyword_argument"),
    field(ka, "name", nm), text(nm, k), field(ka, "value", v).

// plp_cast(c, x): `cast(T, x)`; the linter looks through it (_unwrap_passthrough_expr).
.decl plp_cast(c: node, x: node)
plp_cast(c, x) :- kind(c, "call"), field(c, "function", g), kind(g, "identifier"), text(g, "cast"), plp_npos(c, 2),
    plp_pos(c, 1, x).
// plp_getattr(c, o): `getattr(o, "_conn", …)` with a protected attribute name.
.decl plp_getattr(c: node, o: node)
plp_getattr(c, o) :- kind(c, "call"), field(c, "function", g), kind(g, "identifier"), text(g, "getattr"),
    plp_pos(c, 0, o), plp_pos(c, 1, s), str_const(s, x), plp_name("PROTECTED_RUNTIME_ATTRS", x).
// plp_bound(t, x): _extract_bound_names: a Name target, or the Names of a tuple / list target.
.decl plp_bound(t: node, x: symbol)
plp_bound(t, x) :- kind(t, "identifier"), text(t, x).
plp_bound(t, x) :- (kind(t, "pattern_list") ; kind(t, "tuple_pattern") ; kind(t, "list_pattern") ; kind(t, "tuple") ;
    kind(t, "list") ; kind(t, "parenthesized_expression")), child(t, e, _), plp_bound(e, x).
// plp_container(v): a dict, list or set display, or a comprehension or generator: always mutable state.
.decl plp_container(v: node)
plp_container(v) :- kind(v, k), (k = "dictionary" ; k = "list" ; k = "set" ; k = "dictionary_comprehension" ;
    k = "list_comprehension" ; k = "set_comprehension" ; k = "generator_expression").
// plp_ret_val(r, v): `return v`, parentheses off.
.decl plp_ret_val(r: node, v: node)
plp_ret_val(r, v) :- kind(r, "return_statement"), child(r, v0, 0), !kind(v0, "comment"), unparen(v0, v).

// ==== 2. module state, per file ===================================================================================
// plp_gasg(d, a, x, v): a top-level `x = v` (or `x: T = v`); plp_gbind(d, x): any top-level binding of x.
.decl plp_gasg(d: number, a: node, x: symbol, v: node)
plp_gasg(d, a, x, v) :- modnode(d, m), child(m, st, _), asgstmt(a, st), assign_target(a, t), plp_bound(t, x),
    assign_value(a, v0), unparen(v0, v).
.decl plp_gbind(d: number, x: symbol)
plp_gbind(d, x) :- modnode(d, m), child(m, st, _), asgstmt(a, st), assign_target(a, t), plp_bound(t, x).
// plp_gmutated(d, x): anywhere in the file, `x[k] = …`, `x.a = …`, `x[k] += …` or `x.append(…)` (a mutating method).
.decl plp_gmutated(d: number, x: symbol)
plp_gmutated(d, x) :- assign_target(a, t), plp_gmut_target(t, x), docof(a, d), plp_gbind(d, x).
plp_gmutated(d, x) :- kind(a, "augmented_assignment"), field(a, "left", t), plp_gmut_target(t, x), docof(a, d),
    plp_gbind(d, x).
plp_gmutated(d, x) :- kind(c, "call"), field(c, "function", e), attr_of(e, o, mm), plp_name("MUTATING_METHOD_NAMES", mm),
    kind(o, "identifier"), text(o, x), docof(c, d), plp_gbind(d, x).
.decl plp_gmut_target(t: node, x: symbol)
plp_gmut_target(t, x) :- kind(t, "subscript"), field(t, "value", o), kind(o, "identifier"), text(o, x).
plp_gmut_target(t, x) :- attr_of(t, o, _), kind(o, "identifier"), text(o, x).

// _is_immutable_global_expr: constants, and tuples, unary and binary operations and frozenset / tuple /
// MappingProxyType calls of them. plp_imm_reach walks the parts that must be immutable; plp_imm(e) holds when
// every part reached is of an allowed form.
.decl plp_imm_q(e: node)
plp_imm_q(v) :- plp_gasg(_, _, _, v).
plp_imm_q(k) :- plp_gasg(_, _, _, v), kind(v, "dictionary"), child(v, p, _), kind(p, "pair"),
    (field(p, "key", k) ; field(p, "value", k)).
plp_imm_q(k) :- plp_gasg(_, _, _, v), (kind(v, "list") ; kind(v, "set")), child(v, k, _), !kind(k, "comment").
.decl plp_imm_step(n: node, k: node)
plp_imm_step(n, k) :- kind(n, "tuple"), child(n, k, _), !kind(k, "comment").
plp_imm_step(n, k) :- kind(n, "parenthesized_expression"), unparen(n, k), k != n.
plp_imm_step(n, k) :- (kind(n, "unary_operator") ; kind(n, "not_operator")), field(n, "argument", k).
plp_imm_step(n, k) :- kind(n, "binary_operator"), (field(n, "left", k) ; field(n, "right", k)).
plp_imm_step(n, k) :- kind(n, "call"), short_name(n, x), plp_name("IMMUTABLE_GLOBAL_CALLS", x), x != "frozenset",
    x != "tuple", plp_pos(n, _, k).
.decl plp_imm_reach(e: node, n: node)
plp_imm_reach(e, e) :- plp_imm_q(e).
plp_imm_reach(e, k) :- plp_imm_reach(e, n), plp_imm_step(n, k).
.decl plp_imm_ok(n: node)
plp_imm_ok(n) :- ast_constant(n).
plp_imm_ok(n) :- kind(n, k), (k = "tuple" ; k = "parenthesized_expression" ; k = "unary_operator" ; k = "not_operator" ;
    k = "binary_operator").
plp_imm_ok(n) :- kind(n, "call"), short_name(n, x), plp_name("IMMUTABLE_GLOBAL_CALLS", x).
.decl plp_imm(e: node)
plp_imm(e) :- plp_imm_q(e), count : { plp_imm_reach(e, n), !plp_imm_ok(n) } = 0.
// _expr_is_static_mutable_lookup: a non-empty dict / list / set display of immutable keys and values.
.decl plp_imm_part(q: node)
plp_imm_part(p) :- kind(p, "pair"), field(p, "key", k), plp_imm(k), field(p, "value", v), plp_imm(v).
plp_imm_part(k) :- plp_imm(k).
.decl plp_static_lookup(v: node)
plp_static_lookup(v) :- plp_gasg(_, _, _, v), plp_container(v), !kind(v, "generator_expression"), child(v, k, _),
    !kind(k, "comment"), count : { child(v, q, _), !kind(q, "comment"), !plp_imm_part(q) } = 0,
    (kind(v, "dictionary") ; kind(v, "list") ; kind(v, "set")).

// _call_creates_static_artifact: TypeVar & co., re.compile, load_python_module, logging.getLogger, and a frozen
// dataclass of this file built without a mutable display argument.
.decl plp_frozen(d: number, x: symbol)
plp_frozen(d, x) :- modnode(d, m), body_member(m, c), kind(c, "class_definition"), def_name(c, x), decorator(c, e),
    kind(e, "call"), short_name(e, "dataclass"), plp_kw(e, "frozen", v), kind(v, "true").
.decl plp_frozen_bad(v: node)
plp_frozen_bad(v) :- plp_pos(v, _, a), plp_container(a).
plp_frozen_bad(v) :- plp_kw(v, _, a), plp_container(a).
plp_frozen_bad(v) :- kind(v, "call"), field(v, "arguments", al), child(al, s, _), kind(s, "dictionary_splat").
.decl plp_static(v: node)
plp_static(v) :- kind(v, "call"), short_name(v, x), plp_name("TYPE_ONLY_GLOBAL_CALLS", x).
plp_static(v) :- kind(v, "call"), field(v, "function", e), attr_of(e, o, "compile"), short_name(o, r), (r = "re" ; r = "_re").
plp_static(v) :- kind(v, "call"), short_name(v, "load_python_module").
plp_static(v) :- kind(v, "call"), field(v, "function", e), attr_of(e, o, "getLogger"), plp_chained(o).
plp_static(v) :- kind(v, "call"), short_name(v, x), docof(v, d), plp_frozen(d, x), !plp_frozen_bad(v).
// _call_is_managed_memoization_cache: ObjectCache(name=…, max_entries=…), LocalMetadataCache with a non-MANUAL
// invalidation policy or max_entries, IdentityTokenCache(…BOUNDED_IDENTITY_TOKENS, max_strong_entries=…).
.decl plp_kw_set(v: node, k: symbol)  // k=… is passed and is not None
plp_kw_set(v, k) :- plp_kw(v, k, x), !kind(x, "none").
.decl plp_managed(v: node)
plp_managed(v) :- plp_managed_by(v, k), short_name(v, k), plp_kw(v, "name", _), !plp_no_register(v).
.decl plp_no_register(v: node)
plp_no_register(v) :- plp_kw(v, "register_with_manager", x), kind(x, "false").
.decl plp_managed_by(v: node, k: symbol)
plp_managed_by(v, "ObjectCache") :- plp_kw_set(v, "max_entries").
plp_managed_by(v, k) :- plp_kw(v, "invalidation_policy", x), short_name(x, l), l != "MANUAL",
    (k = "LocalMetadataCache" ; k = "WeakLocalMetadataCache").
plp_managed_by(v, k) :- plp_kw_set(v, "max_entries"), (k = "LocalMetadataCache" ; k = "WeakLocalMetadataCache").
plp_managed_by(v, "IdentityTokenCache") :- plp_kw(v, "invalidation_policy", x), short_name(x, "BOUNDED_IDENTITY_TOKENS"),
    plp_kw_set(v, "max_strong_entries").

// plp_gmut(d, x): a mutable global; plp_grt(d, x): a runtime object (a call that is neither immutable nor static);
// plp_gcat(d, x, c): its category, as the PLP-009 message names it.
.decl plp_gmut(d: number, x: symbol)
plp_gmut(d, x) :- plp_gasg(d, _, x, v), plp_container(v).
plp_gmut(d, x) :- plp_gmutated(d, x).
.decl plp_grt0(d: number, x: symbol, v: node)
plp_grt0(d, x, v) :- plp_gasg(d, _, x, v), kind(v, "call"), !plp_imm(v), !plp_static(v).
.decl plp_grt(d: number, x: symbol)
plp_grt(d, x) :- plp_grt0(d, x, _), !plp_gmut(d, x).
.decl plp_gcat(d: number, x: symbol, c: symbol)
plp_gcat(d, x, "mutated-cache-or-registry") :- plp_gasg(d, _, x, v), plp_container(v), plp_gmutated(d, x).
plp_gcat(d, x, "mutable-static-table") :- plp_gasg(d, _, x, v), plp_static_lookup(v), !plp_gmutated(d, x).
plp_gcat(d, x, "mutable-cache-or-registry") :- plp_gasg(d, _, x, v), plp_container(v), !plp_static_lookup(v),
    !plp_gmutated(d, x).
plp_gcat(d, x, "managed-memoization-cache") :- plp_grt0(d, x, v), plp_managed(v).
plp_gcat(d, x, "runtime-object") :- plp_grt0(d, x, v), !plp_managed(v).
plp_gcat(d, x, "mutated-cache-or-registry") :- plp_gmutated(d, x), !plp_gasg(d, _, x, _).
// plp_cv(d, x): `x = ContextVar(…)` at top level.
.decl plp_cv(d: number, x: symbol)
plp_cv(d, x) :- plp_gasg(d, a, x, v), assign_target(a, t), kind(t, "identifier"), kind(v, "call"),
    short_name(v, "ContextVar").

// Runtime-handle annotations: `-> BatchContext | None`, `Optional[ReadTransaction]`, … (not `type[…]`).
.decl plp_typeish(v: node)
plp_typeish(v) :- short_name(v, x), (x = "type" ; x = "Type").
.decl plp_ann_reach(f: node, n: node)
plp_ann_reach(f, t) :- kind(f, "function_definition"), field(f, "return_type", t).
plp_ann_reach(f, k) :- plp_ann_reach(f, n), plp_ann_step(n, k).
.decl plp_ann_step(n: node, k: node)
plp_ann_step(n, k) :- kind(n, "type"), child(n, k, _).
plp_ann_step(n, k) :- kind(n, "parenthesized_expression"), unparen(n, k), k != n.
plp_ann_step(n, v) :- kind(n, "subscript"), field(n, "value", v), !plp_typeish(v).
plp_ann_step(n, k) :- kind(n, "subscript"), field(n, "value", v), !plp_typeish(v), field(n, "subscript", k).
plp_ann_step(n, h) :- kind(n, "generic_type"), child(n, h, 0), !plp_typeish(h).
plp_ann_step(n, k) :- kind(n, "generic_type"), child(n, h, 0), !plp_typeish(h), child(n, tp, 1), child(tp, k, _).
plp_ann_step(n, k) :- (kind(n, "binary_operator") ; kind(n, "union_type")), op(n, "|"), child(n, k, _).
plp_ann_step(n, k) :- (kind(n, "tuple") ; kind(n, "list")), child(n, k, _).
.decl plp_ann_hit(f: node)
plp_ann_hit(f) :- plp_ann_reach(f, n), leaf_name(n, x), !kind(n, "subscript"), plp_name("RUNTIME_HANDLE_TYPE_NAMES", x).

// The values the linter looks through casts of: plp_unwrap(v, u).
.decl plp_uq(v: node)
plp_uq(v) :- plp_ret_val(_, v).
plp_uq(v) :- plp_in(_, v).
.decl plp_unwrap(v: node, u: node)
plp_unwrap(v, u) :- plp_uq(v), plp_cast(v, u).
plp_unwrap(v, v) :- plp_uq(v), !plp_cast(v, _).
// plp_cvget(d, u): `ctx.get()` on a module ContextVar ctx. plp_hcall(d, u): `h(…)` or `self.h(…)` on a runtime-
// handle helper h. plp_src_call(d, v): v, cast off, is either.
.decl plp_cvget(d: number, u: node)
plp_cvget(d, u) :- kind(u, "call"), field(u, "function", e), attr_of(e, o, "get"), plp_chained(o), plp_head(e, x),
    docof(u, d), plp_cv(d, x).
.decl plp_hcall(d: number, u: node)
plp_hcall(d, u) :- kind(u, "call"), field(u, "function", e), kind(e, "identifier"), text(e, x), docof(u, d),
    plp_helper(d, x).
plp_hcall(d, u) :- kind(u, "call"), field(u, "function", e), attr_of(e, o, x), kind(o, "identifier"), text(o, s),
    (s = "self" ; s = "cls"), docof(u, d), plp_helper(d, x).
.decl plp_src_call(d: number, v: node)
plp_src_call(d, v) :- plp_unwrap(v, u), plp_cvget(d, u).
plp_src_call(d, v) :- plp_unwrap(v, u), plp_hcall(d, u).
// plp_helper(d, x): a def named x in the file is a runtime-handle helper: annotated so, or one of its own returns
// is a ContextVar get or a helper call (a fixpoint).
.decl plp_helper(d: number, x: symbol)
plp_helper(d, x) :- plp_ann_hit(f), def_name(f, x), docof(f, d).
plp_helper(d, x) :- kind(f, "function_definition"), def_name(f, x), field(f, "body", b), within_stop(r, b, plp_fnk),
    plp_ret_val(r, v), docof(f, d), plp_src_call(d, v).

// ==== 3. records, calls and the two closures (scan_paths) =========================================================
.decl plp_src_mode()
plp_src_mode() :- option("entryPoint", "scan_source").
.decl plp_fnk(k: symbol)
plp_fnk("function_definition"). plp_fnk("lambda").
.decl plp_scope(k: symbol)
plp_scope("function_definition"). plp_scope("class_definition").
// plp_qn(n, q): the record's qualname: enclosing class and def names joined by dots (no "<locals>").
.decl plp_qn(n: node, q: symbol)
plp_qn(n, x) :- plp_scope(k), kind(n, k), def_name(n, x), !plp_owned(n).
plp_qn(n, @dot(p, x)) :- plp_scope(k), kind(n, k), def_name(n, x), nearest(n, s, plp_scope), plp_qn(s, p).
.decl plp_owned(n: node)
plp_owned(n) :- nearest(n, _, plp_scope).
// A def that is a statement of a def's own body is not a record, nor is anything inside it.
.decl plp_skipped(f: node)
plp_skipped(f) :- kind(g, "function_definition"), field(g, "body", b), body_member(b, f), kind(f, "function_definition").
.decl plp_rec0(f: node, d: number, q: symbol)
plp_rec0(f, d, q) :- kind(f, "function_definition"), !plp_skipped(f), !plp_under_skipped(f), plp_qn(f, q), docof(f, d).
.decl plp_under_skipped(f: node)
plp_under_skipped(f) :- kind(f, "function_definition"), plp_skipped(g), within(f, g).
// plp_sym(d, q, f): the record for qualname q of file d: the last def of that name (records is a dict).
.decl plp_sym(d: number, q: symbol, f: node)
plp_sym(d, q, f) :- plp_rec0(f, d, q), count : { plp_rec0(g, d, q), earlier(f, g) } = 0.
.decl plp_rec(f: node)
plp_rec(f) :- plp_sym(_, _, f).
.decl plp_fq0(s: symbol, f: node)  // "module.qualname"
plp_fq0(cat(m, ".", q), f) :- plp_sym(d, q, f), doc(d, _, m), m != "".
.decl plp_param(f: node, x: symbol)
plp_param(f, x) :- sig_param(f, _, nm, _, _, _, _), text(nm, x).
// plp_local(f, x): _collect_function_local_bindings: assigned, loop or with-bound in f itself, less global names.
.decl plp_bind_target(a: node, t: node)
plp_bind_target(a, t) :- assign_target(a, t).
plp_bind_target(a, t) :- kind(a, "augmented_assignment"), field(a, "left", t).
plp_bind_target(a, t) :- kind(a, "for_statement"), field(a, "left", t).
plp_bind_target(a, t) :- kind(w, "with_item"), field(w, "value", a), kind(a, "as_pattern"), field(a, "alias", at),
    child(at, t, _).
.decl plp_local(f: node, x: symbol)
plp_local(f, x) :- kind(f, "function_definition"), field(f, "body", b), within_stop(a, b, plp_fnk), plp_bind_target(a, t),
    plp_bound(t, x), !plp_declg(f, x).
.decl plp_declg(f: node, x: symbol)
plp_declg(f, x) :- kind(f, "function_definition"), field(f, "body", b), within_stop(g, b, plp_fnk),
    (kind(g, "global_statement") ; kind(g, "nonlocal_statement")), child(g, i, _), text(i, x).

// Imports: plp_isym(s, x, q) `from m import y as x` (q = "m.y"), plp_imod(s, x, q) `import a.b` (x = "a",
// q = "a.b"). s is the module node, or a def whose own body holds a from-import (the linter's local imports).
.decl plp_imp_at(i: node, s: node)
plp_imp_at(i, m) :- modnode(_, m), child(m, i, _), import_stmt(i).
plp_imp_at(i, f) :- kind(f, "function_definition"), field(f, "body", b), child(b, i, _), import_stmt(i).
.decl plp_imp(s: node, x: symbol, q: symbol, k: symbol)
plp_imp(s, l, @dot(mm, x), "sym") :- import_alias(i, _, mm, x, l), x != "", x != "*", mm != "", plp_imp_at(i, s),
    kind(i, "import_from_statement").
plp_imp(s, l, mm, "mod") :- import_alias(i, _, mm, "", l), kind(i, "import_statement"), plp_imp_at(i, s), modnode(_, s).
// plp_isym(f, x, q): in record f, x is a from-imported name: f's own import first, else the module's.
.decl plp_isym(f: node, x: symbol, q: symbol)
plp_isym(f, x, q) :- plp_rec(f), plp_imp(f, x, q, "sym").
plp_isym(f, x, q) :- plp_rec(f), docof(f, d), modnode(d, m), plp_imp(m, x, q, "sym"), !plp_imp(f, x, _, "sym").
.decl plp_imod(f: node, x: symbol, q: symbol)
plp_imod(f, x, q) :- plp_rec(f), docof(f, d), modnode(d, m), plp_imp(m, x, q, "mod").

// plp_ref(f, c): call c in record f's own body (not in nested defs or lambdas) whose root is not a local or a
// parameter (self and cls excepted).
.decl plp_ref(f: node, c: node, e: node)
plp_ref(f, c, e) :- plp_rec(f), field(f, "body", b), within_stop(c, b, plp_fnk), kind(c, "call"), field(c, "function", e),
    !plp_shadowed(f, e).
.decl plp_shadowed(f: node, e: node)
plp_shadowed(f, e) :- plp_rec(f), plp_root(e, x), (plp_local(f, x) ; plp_param(f, x)), x != "self", x != "cls".

// Resolution by longest dotted prefix: plp_res(s, g), g's "module.qualname" is the longest prefix of s.
.decl plp_want(s: symbol)
.decl plp_pre(s: symbol, p: symbol)
plp_pre(s, s) :- plp_want(s).
plp_pre(s, p) :- plp_pre(s, q), split_dot(q, p, qx).
.decl plp_res(s: symbol, g: node)
.decl plp_fqlen(s: symbol, p: symbol, n: number)  // prefix p of s names a record; n is its length
plp_fqlen(s, p, n) :- plp_pre(s, p), plp_fq0(p, _), n = strlen(p).
plp_res(s, g) :- plp_fqlen(s, p, n), n = max k : { plp_fqlen(s, _, k) }, plp_fq0(p, g).
// Methods: plp_mq(m, cq, x) asks for method x of class cq of module m; plp_mans answers it, through the bases
// (via = 1) when the class has no def of that name.
.decl plp_method(m: symbol, cq: symbol, x: symbol, g: node)
plp_method(m, cq, x, g) :- plp_sym(d, q, g), doc(d, _, m), split_dot(q, cq, x).
.decl plp_cls(f: node, m: symbol, cq: symbol)  // record f's class qualname (its qualname less the last name)
plp_cls(f, m, cq) :- plp_sym(d, q, f), doc(d, _, m), split_dot(q, cq, qx).
.decl plp_base(m: symbol, cq: symbol, bm: symbol, bq: symbol)
plp_base(m, cq, bm, bq) :- plp_cbase(_, m, cq, s), split_dot(s, bm, bq).
.decl plp_cbase(c: node, m: symbol, cq: symbol, s: symbol)
plp_cbase(c, m, cq, q) :- plp_cbase_e(c, m, cq, d, e), kind(e, "identifier"), text(e, x), modnode(d, mn), plp_imp(mn, x, q, "sym").
plp_cbase(c, m, cq, cat(m, ".", x)) :- plp_cbase_e(c, m, cq, d, e), kind(e, "identifier"), text(e, x), modnode(d, mn),
    !plp_imp(mn, x, _, "sym").
plp_cbase(c, m, cq, cat(q, ".", a)) :- plp_cbase_e(c, m, cq, d, e), attr_of(e, o, a), kind(o, "identifier"), text(o, x),
    modnode(d, mn), plp_imp(mn, x, q, "mod").
plp_cbase(c, m, cq, s) :- plp_cbase_e(c, m, cq, d, e), attr_of(e, o, _), modnode(d, mn), text(e, s),
    !plp_modattr(mn, o).
.decl plp_modattr(mn: node, o: node)
plp_modattr(mn, o) :- kind(o, "identifier"), text(o, x), plp_imp(mn, x, _, "mod").
.decl plp_cbase_e(c: node, m: symbol, cq: symbol, d: number, e: node)
plp_cbase_e(c, m, cq, d, e) :- kind(c, "class_definition"), plp_qn(c, cq), docof(c, d), doc(d, _, m),
    field(c, "superclasses", al), child(al, e, _), !kind(e, "keyword_argument"), !kind(e, "comment").
.decl plp_mq(m: symbol, cq: symbol, x: symbol)
plp_mq(bm, bq, x) :- plp_mq(m, cq, x), !plp_method(m, cq, x, _), plp_base(m, cq, bm, bq).
.decl plp_mans(m: symbol, cq: symbol, x: symbol, g: node, via: number)
plp_mans(m, cq, x, g, 0) :- plp_mq(m, cq, x), plp_method(m, cq, x, g).
plp_mans(m, cq, x, g, 1) :- plp_mq(m, cq, x), !plp_method(m, cq, x, _), plp_base(m, cq, bm, bq), plp_mans(bm, bq, x, g, _).

// plp_tgt(f, g, via): _resolve_call_target for each call of record f.
.decl plp_tgt(f: node, g: node, via: number)
// `x(…)`: a top-level def x of the file; else an imported x; else a method x of f's class.
plp_tgt(f, g, 0) :- plp_ref(f, _, e), kind(e, "identifier"), text(e, x), docof(f, d), plp_sym(d, x, g).
plp_want(q) :- plp_ref(f, _, e), kind(e, "identifier"), text(e, x), docof(f, d), !plp_sym(d, x, _), plp_isym(f, x, q).
plp_tgt(f, g, 0) :- plp_ref(f, _, e), kind(e, "identifier"), text(e, x), docof(f, d), !plp_sym(d, x, _),
    plp_isym(f, x, q), plp_res(q, g).
plp_mq(m, cq, x) :- plp_ref(f, _, e), kind(e, "identifier"), text(e, x), docof(f, d), !plp_sym(d, x, _),
    !plp_isym(f, x, _), plp_cls(f, m, cq).
plp_tgt(f, g, v) :- plp_ref(f, _, e), kind(e, "identifier"), text(e, x), docof(f, d), !plp_sym(d, x, _),
    !plp_isym(f, x, _), plp_cls(f, m, cq), plp_mans(m, cq, x, g, v).
// `self.x(…)` / `cls.x(…)`: a method of f's class.
plp_mq(m, cq, x) :- plp_ref(f, _, e), attr_of(e, o, x), kind(o, "identifier"), text(o, s), (s = "self" ; s = "cls"),
    plp_cls(f, m, cq).
plp_tgt(f, g, v) :- plp_ref(f, _, e), attr_of(e, o, x), kind(o, "identifier"), text(o, s), (s = "self" ; s = "cls"),
    plp_cls(f, m, cq), plp_mans(m, cq, x, g, v).
// `mod.x(…)` through `import mod`, or `name.x(…)` through `from m import name`.
plp_want(cat(q, ".", x)) :- plp_ref(f, _, e), attr_of(e, o, x), kind(o, "identifier"), text(o, y), y != "self", y != "cls",
    plp_imod(f, y, q).
plp_tgt(f, g, 0) :- plp_ref(f, _, e), attr_of(e, o, x), kind(o, "identifier"), text(o, y), y != "self", y != "cls",
    plp_imod(f, y, q), plp_res(cat(q, ".", x), g).
plp_want(cat(q, ".", x)) :- plp_ref(f, _, e), attr_of(e, o, x), kind(o, "identifier"), text(o, y), y != "self", y != "cls",
    !plp_imod(f, y, _), plp_isym(f, y, q).
plp_tgt(f, g, 0) :- plp_ref(f, _, e), attr_of(e, o, x), kind(o, "identifier"), text(o, y), y != "self", y != "cls",
    !plp_imod(f, y, _), plp_isym(f, y, q), plp_res(cat(q, ".", x), g).
.decl plp_edge(f: node, g: node, via: number)
plp_edge(f, g, v) :- plp_tgt(f, g, v), f != g.

// Seeds. plp_explicit(f): decorated pure_lazy or lazy (by the last dotted name); plp_legacy(f): @legacy_*.
.decl plp_explicit(f: node)
plp_explicit(f) :- decorator(f, e), short_name(e, x), (x = "pure_lazy" ; x = "lazy").
.decl plp_legacy(f: node)
plp_legacy(f) :- decorator(f, e), short_name(e, x), plp_name("LEGACY_DECORATOR_NAMES", x).
.decl plp_terminal(f: node)  // f targets or calls a plan-helper terminal
plp_terminal(f) :- plp_edge(f, g, _), plp_sym(_, q, g), plp_name("PLAN_HELPER_TERMINAL_NAMES", q).
plp_terminal(f) :- plp_rec(f), ast_walk(f, c), kind(c, "call"), short_name(c, x), plp_name("PLAN_HELPER_TERMINAL_NAMES", x).
.decl plp_owner_seed(f: node)
plp_owner_seed(f) :- plp_rec(f), def_name(f, x), suffix("_lazy", x), plp_param(f, p), p != "self", p != "cls",
    plp_name("RUNTIME_OWNER_PARAM_NAMES", p), plp_terminal(f).
// The files scan_paths reads: those whose text has a pure-lazy trigger, those defining a global-state factory, and
// those a seed reaches through imports. When there is none, every file.
.decl plp_shared(f: node)
plp_shared(f) :- plp_rec(f), plp_explicit(f).
plp_shared(f) :- plp_owner_seed(f).
plp_shared(g) :- plp_shared(f), plp_edge(f, g, 0).
.decl plp_cand(d: number)
plp_cand(d) :- source(d, sp), text(sp, t), (contains("_lazy", t) ; contains("__pure_lazy_surface__", t)).
plp_cand(d) :- plp_rec(f), def_name(f, x), docof(f, d), (x = "create_embedding_ref_class" ;
    x = "create_embedding_vector_class" ; x = "register_permissions" ; x = "register_table").
plp_cand(d) :- plp_shared(f), docof(f, d).
.decl plp_anycand()
plp_anycand() :- plp_cand(_).
.decl plp_docin(d: number)
plp_docin(d) :- plp_cand(d).
plp_docin(d) :- doc(d, _, _), !plp_anycand().
.decl plp_in_rec(f: node)
plp_in_rec(f) :- plp_rec(f), docof(f, d), plp_docin(d).
// The closures.
.decl plp_colored(f: node)
plp_colored(f) :- plp_in_rec(f), plp_explicit(f).
plp_colored(g) :- plp_colored(f), plp_edge(f, g, _), plp_in_rec(g), !plp_legacy(g).
.decl plp_owner(f: node)
plp_owner(f) :- plp_in_rec(f), plp_owner_seed(f).
plp_owner(g) :- plp_owner(f), plp_edge(f, g, _), plp_in_rec(g), !plp_legacy(g).

// ==== 4. the defs analysed ========================================================================================
// plp_an(f, strict, owner): f is analysed; strict: any receiver of a protected attribute counts; owner: only
// PLP-001…005 are kept.
.decl plp_an(f: node, strict: number, owner: number)
plp_an(f, 0, 0) :- !plp_src_mode(), plp_colored(f), plp_explicit(f).
plp_an(f, 1, 0) :- !plp_src_mode(), plp_colored(f), !plp_explicit(f).
plp_an(f, 1, 1) :- !plp_src_mode(), plp_owner(f), !plp_colored(f).
// scan_source: a def decorated @pure_lazy, and any def inside one, in a file whose text names a trigger.
.decl plp_src_doc(d: number)
plp_src_doc(d) :- source(d, sp), text(sp, t), (contains("pure_lazy", t) ; contains("@lazy", t) ;
    contains("__pure_lazy_surface__", t)).
.decl plp_pure_dec(f: node)
plp_pure_dec(f) :- kind(f, "function_definition"), decorator(f, e), short_name(e, "pure_lazy").
plp_an(f, 0, 0) :- plp_src_mode(), plp_pure_dec(f), docof(f, d), plp_src_doc(d).
plp_an(g, 0, 0) :- plp_src_mode(), plp_pure_dec(f), within(g, f), kind(g, "function_definition"), docof(f, d),
    plp_src_doc(d).
// plp_in(f, n): n is in f's body, nested defs included: the analyser's visit.
.decl plp_in(f: node, n: node)
plp_in(f, n) :- plp_an(f, _, _), field(f, "body", b), within(n, b).
// plp_surface(f): f's nearest class sets `__pure_lazy_surface__ = True`: `self` and `self._txn` / `self._plan` …
// are then pure carriers.
.decl plp_classk(k: symbol)
plp_classk("class_definition").
.decl plp_surface(f: node)
plp_surface(f) :- plp_an(f, _, _), nearest(f, c, plp_classk), field(c, "body", b), child(b, st, _), asgstmt(a, st),
    assign_target(a, t), kind(t, "identifier"), text(t, "__pure_lazy_surface__"), assign_value(a, v), kind(v, "true").
.decl plp_carrier(f: node, o: node, a: symbol)
plp_carrier(f, o, a) :- plp_surface(f), plp_in(f, o), kind(o, "identifier"), text(o, "self"),
    plp_name("PURE_SURFACE_CARRIER_ATTRS", a).
// plp_gstate(f, x): module state x is visible in f (not shadowed by a parameter or local); plp_gmutf: mutable.
.decl plp_gstate(f: node, x: symbol)
plp_gstate(f, x) :- plp_an(f, _, _), docof(f, d), (plp_gmut(d, x) ; plp_grt(d, x)), !plp_param(f, x), !plp_local(f, x).
.decl plp_gmutf(f: node, x: symbol)
plp_gmutf(f, x) :- plp_gstate(f, x), docof(f, d), plp_gmut(d, x).

// ---- taint, along the visit order ----
// plp_asg(f, a, t, v): assignment a in f's visit, target t, value v.
.decl plp_asg(f: node, a: node, t: node, v: node)
plp_asg(f, a, t, v) :- plp_in(f, a), asgstmt(a, _), assign_target(a, t), assign_value(a, v0), unparen(v0, v).
// plp_taint(f, x, a): assignment a makes local x runtime-bound: its value is an opaque LazyOperation, a ContextVar
// get or helper call, or holds a protected access or a tainted local at that point of the walk.
.decl plp_taint(f: node, x: symbol, a: node)
plp_taint(f, x, a) :- plp_asg(f, a, t, v), plp_tsrc(f, v), plp_bound(t, x).
.decl plp_tsrc(f: node, v: node)
plp_tsrc(f, v) :- plp_asg(f, _, _, v), plp_unwrap(v, u), plp_opq(f, u).
plp_tsrc(f, v) :- plp_asg(f, _, _, v), docof(f, d), plp_src_call(d, v).
plp_tsrc(f, v) :- plp_asg(f, _, _, v), plp_probe_prot(f, v).
plp_tsrc(f, v) :- plp_asg(f, _, _, v), plp_probe_tnt(f, v).
// plp_tnt_at(f, n): Name n reads a local some earlier assignment tainted.
.decl plp_tnt_at(f: node, n: node)
plp_tnt_at(f, n) :- plp_in(f, n), ast_name(n, x), plp_taint(f, x, a), earlier(a, n).
// plp_trecv(f, e): _tainted_receiver: a parameter or tainted local, through attributes, subscripts and calls.
.decl plp_trecv(f: node, e: node)
plp_trecv(f, e) :- plp_in(f, e), kind(e, "identifier"), text(e, x), plp_param(f, x), !plp_self_carrier(f, x).
plp_trecv(f, e) :- plp_tnt_at(f, e), text(e, x), !plp_self_carrier(f, x).
plp_trecv(f, e) :- attr_of(e, o, a), plp_trecv(f, o), !plp_carrier(f, o, a).
plp_trecv(f, e) :- kind(e, "subscript"), field(e, "value", o), plp_trecv(f, o).
plp_trecv(f, e) :- kind(e, "call"), field(e, "function", o), plp_trecv(f, o).
plp_trecv(f, e) :- kind(e, "parenthesized_expression"), unparen(e, o), o != e, plp_trecv(f, o).
.decl plp_self_carrier(f: node, x: symbol)
plp_self_carrier(f, "self") :- plp_surface(f).
// plp_rb(f, e): _receiver_is_runtime_bound: the same without calls; anything, in a strict def.
.decl plp_rb(f: node, e: node)
plp_rb(f, e) :- plp_an(f, 1, _), plp_in(f, e).
plp_rb(f, e) :- plp_in(f, e), kind(e, "identifier"), text(e, x), plp_param(f, x), !plp_self_carrier(f, x).
plp_rb(f, e) :- plp_tnt_at(f, e), text(e, x), !plp_self_carrier(f, x).
plp_rb(f, e) :- attr_of(e, o, a), plp_rb(f, o), !plp_carrier(f, o, a).
plp_rb(f, e) :- kind(e, "subscript"), field(e, "value", o), plp_rb(f, o).
plp_rb(f, e) :- kind(e, "parenthesized_expression"), unparen(e, o), o != e, plp_rb(f, o).
// The probe of a value: a protected access on a tainted receiver (plp_probe_prot), a tainted Name (plp_probe_tnt).
.decl plp_pq(f: node, v: node)
plp_pq(f, v) :- plp_asg(f, _, _, v).
plp_pq(f, v) :- plp_ret(f, _, v).
.decl plp_prot_node(f: node, n: node)
plp_prot_node(f, n) :- attr_of(n, o, a), plp_name("PROTECTED_RUNTIME_ATTRS", a), plp_trecv(f, o).
plp_prot_node(f, n) :- plp_getattr(n, o), plp_trecv(f, o).
.decl plp_probe_prot(f: node, v: node)
plp_probe_prot(f, v) :- plp_pq(f, v), plp_prot_node(f, v).
plp_probe_prot(f, v) :- plp_pq(f, v), within(n, v), plp_prot_node(f, n).
.decl plp_probe_tnt(f: node, v: node)
plp_probe_tnt(f, v) :- plp_pq(f, v), plp_tnt_at(f, v).
plp_probe_tnt(f, v) :- plp_pq(f, v), within(n, v), plp_tnt_at(f, n).
// plp_opq(f, e): _opaque_lazy_operation_payload_field: a local holding one, _queue_handle_entry_lazy(…),
// queue_single(op) of such a local, or LazyOperation(payload=P(handle=…)).
.decl plp_opq(f: node, e: node)
plp_opq(f, e) :- plp_in(f, e), ast_name(e, x), plp_opq_local(f, x, a), earlier(a, e).
plp_opq(f, e) :- plp_in(f, e), kind(e, "call"), short_name(e, k), plp_name("OPAQUE_PURE_LAZY_HELPER_CALLS", k).
plp_opq(f, e) :- plp_in(f, e), kind(e, "call"), short_name(e, k), (k = "queue_single" ; k = "queue_sequence"),
    plp_pos(e, 0, a0), plp_unwrap(a0, u), ast_name(u, x), plp_opq_local(f, x, a), earlier(a, e).
plp_opq(f, e) :- plp_in(f, e), kind(e, "call"), short_name(e, "LazyOperation"), plp_kw(e, "payload", p), kind(p, "call"),
    plp_kw(p, k, _), plp_name("OPAQUE_LAZY_OPERATION_PAYLOAD_FIELDS", k).
.decl plp_opq_local(f: node, x: symbol, a: node)
plp_opq_local(f, x, a) :- plp_asg(f, a, t, v), plp_unwrap(v, u), plp_opq(f, u), plp_bound(t, x).

// plp_gname(f, v): some Name loaded in v (v included) is visible module state.
.decl plp_gq(f: node, v: node)
plp_gq(f, v) :- plp_ret(f, _, v).
plp_gq(f, v) :- plp_in(f, c), plp_kw(c, k, v), plp_name("RUNTIME_SINK_KEYWORDS", k).
.decl plp_gname_node(f: node, n: node)
plp_gname_node(f, n) :- plp_in(f, n), ast_name(n, x), expr_ctx(n, "load"), plp_gstate(f, x).
.decl plp_gname(f: node, v: node)
plp_gname(f, v) :- plp_gq(f, v), plp_gname_node(f, v).
plp_gname(f, v) :- plp_gq(f, v), within(n, v), plp_gname_node(f, n).
// plp_grecv(f, e, g): _global_receiver_name: e is module state g, through attributes and subscripts.
.decl plp_grecv(f: node, e: node, g: symbol)
plp_grecv(f, e, g) :- plp_in(f, e), kind(e, "identifier"), text(e, g), plp_gstate(f, g).
plp_grecv(f, e, g) :- attr_of(e, o, _), plp_grecv(f, o, g).
plp_grecv(f, e, g) :- kind(e, "subscript"), field(e, "value", o), plp_grecv(f, o, g).
// LazyResult.of(…) and friends; plp_wsrc(d, v): a ContextVar get or helper call anywhere in v.
.decl plp_wrapper(v: node)
plp_wrapper(v) :- kind(v, "call"), field(v, "function", g), plp_long(g), plp_head(g, h), (h = "LazyResult" ; h = "LazySeq"),
    short_name(g, l), (l = "of" ; l = "from_value" ; l = "resolved").
.decl plp_wsrc(d: number, v: node)
plp_wsrc(d, v) :- plp_ret(f, _, v), plp_wrapper(v), docof(f, d), plp_src_call(d, v).
plp_wsrc(d, v) :- plp_ret(f, _, v), plp_wrapper(v), docof(f, d), within(n, v), plp_src_call(d, n).

// ---- returns: the first test that matches decides, and the visit stops there ----
.decl plp_ret(f: node, r: node, v: node)
plp_ret(f, r, v) :- plp_in(f, r), plp_ret_val(r, v).
.decl plp_r1(f: node, r: node)  // a pure-surface helper call: allowed
plp_r1(f, r) :- plp_ret(f, r, v), plp_unwrap(v, u), kind(u, "call"), field(u, "function", g), kind(g, "identifier"),
    text(g, x), plp_name("PURE_SURFACE_HELPER_CALLS", x).
.decl plp_r2(f: node, r: node)  // PLP-010
plp_r2(f, r) :- plp_ret(f, r, v), !plp_r1(f, r), plp_unwrap(v, u), plp_opq(f, u).
.decl plp_r3(f: node, r: node)  // PLP-003, under a runtime-handle annotation
plp_r3(f, r) :- plp_ret(f, r, v), !plp_r1(f, r), !plp_r2(f, r), plp_ann_hit(f), docof(f, d), plp_src_call(d, v).
.decl plp_r4(f: node, r: node)  // PLP-002
plp_r4(f, r) :- plp_ret(f, r, v), !plp_r1(f, r), !plp_r2(f, r), !plp_r3(f, r), plp_getattr(v, o), plp_rb(f, o).
.decl plp_r5(f: node, r: node, c: symbol)  // PLP-004 / PLP-003
plp_r5(f, r, c) :- plp_ret(f, r, v), !plp_r1(f, r), !plp_r2(f, r), !plp_r3(f, r), !plp_r4(f, r), plp_r5_hit(f, v),
    ( plp_wrapper(v), c = "PLP-004" ; !plp_wrapper(v), c = "PLP-003" ).
.decl plp_r5_hit(f: node, v: node)
plp_r5_hit(f, v) :- plp_probe_prot(f, v), plp_ret(f, _, v).
plp_r5_hit(f, v) :- plp_ret(f, _, v), docof(f, d), plp_wsrc(d, v).
.decl plp_r6(f: node, r: node)  // PLP-005
plp_r6(f, r) :- plp_ret(f, r, v), !plp_r1(f, r), !plp_r2(f, r), !plp_r3(f, r), !plp_r4(f, r), !plp_r5(f, r, _),
    plp_probe_tnt(f, v).
.decl plp_r7(f: node, r: node)  // PLP-008
plp_r7(f, r) :- plp_ret(f, r, v), !plp_r1(f, r), !plp_r2(f, r), !plp_r3(f, r), !plp_r4(f, r), !plp_r5(f, r, _),
    !plp_r6(f, r), !kind(v, "call"), !kind(v, "subscript"), plp_gname(f, v).

// ---- expressions: each visit that stops ----
.decl plp_c_allowed(f: node, c: node)
plp_c_allowed(f, c) :- plp_in(f, c), kind(c, "call"), plp_unwrap(c, u), kind(u, "call"), field(u, "function", g),
    kind(g, "identifier"), text(g, x), plp_name("PURE_SURFACE_HELPER_CALLS", x).
.decl plp_c_getattr(f: node, c: node)  // PLP-002
plp_c_getattr(f, c) :- plp_in(f, c), plp_getattr(c, o), plp_rb(f, o).
.decl plp_c_sink(f: node, c: node)  // PLP-008: module state into a runtime sink
plp_c_sink(f, c) :- plp_in(f, c), plp_kw(c, k, v), plp_name("RUNTIME_SINK_KEYWORDS", k), plp_gname(f, v),
    !plp_c_allowed(f, c), !plp_cast(c, _).
.decl plp_c_recv(f: node, c: node, g: symbol, access: symbol)  // `g….m(…)` on module state
plp_c_recv(f, c, g, cat(".", m)) :- plp_in(f, c), kind(c, "call"), field(c, "function", e), attr_of(e, o, m),
    plp_grecv(f, o, g), !plp_c_allowed(f, c), !plp_c_sink(f, c).
.decl plp_s_sub(f: node, s: node, g: symbol)  // `g[…]` on module state
plp_s_sub(f, s, g) :- plp_in(f, s), kind(s, "subscript"), field(s, "value", o), plp_grecv(f, o, g).
.decl plp_a_prot(f: node, a: node)  // PLP-001
plp_a_prot(f, a) :- plp_in(f, a), attr_of(a, o, x), !plp_carrier(f, o, x), plp_name("PROTECTED_RUNTIME_ATTRS", x),
    plp_rb(f, o).
.decl plp_stop(f: node, p: node)
plp_stop(f, r) :- plp_r1(f, r).
plp_stop(f, r) :- plp_r2(f, r).
plp_stop(f, r) :- plp_r3(f, r).
plp_stop(f, r) :- plp_r4(f, r).
plp_stop(f, r) :- plp_r5(f, r, _).
plp_stop(f, r) :- plp_r6(f, r).
plp_stop(f, r) :- plp_r7(f, r).
plp_stop(f, c) :- plp_c_allowed(f, c).
plp_stop(f, c) :- plp_c_getattr(f, c).
plp_stop(f, c) :- plp_c_sink(f, c).
plp_stop(f, c) :- plp_c_recv(f, c, _, _).
plp_stop(f, s) :- plp_s_sub(f, s, _).
plp_stop(f, a) :- plp_a_prot(f, a).
plp_stop(f, a) :- plp_in(f, a), attr_of(a, o, x), plp_carrier(f, o, x).
// plp_hidden(f, n): the visit never reaches n: below a stop, or the type argument of `cast(T, x)`.
.decl plp_hidden(f: node, n: node)
plp_hidden(f, n) :- plp_stop(f, p), within(n, p).
plp_hidden(f, a0) :- plp_in(f, c), plp_cast(c, _), plp_pos(c, 0, a0).
plp_hidden(f, n) :- plp_in(f, c), plp_cast(c, _), plp_pos(c, 0, a0), within(n, a0).
// plp_seen(f, n): a stop the visit reaches.
.decl plp_seen(f: node, n: node)
plp_seen(f, n) :- plp_stop(f, n), !plp_hidden(f, n).
// plp_access(f, n, g, access): a reached access to module state, unless exempt.
.decl plp_access(f: node, n: node, g: symbol, access: symbol)
plp_access(f, c, g, a) :- plp_c_recv(f, c, g, a), plp_seen(f, c), docof(f, d), !plp_cv(d, g).
plp_access(f, s, g, "[]") :- plp_s_sub(f, s, g), plp_seen(f, s).
plp_access(f, n, x, "read") :- plp_in(f, n), ast_name(n, x), expr_ctx(n, "load"), plp_gmutf(f, x), !plp_hidden(f, n).
.decl plp_exempt(f: node, g: symbol, a: symbol)
plp_exempt(f, g, a) :- plp_access(f, _, g, a), docof(f, d), doc(d, p, _), plp_registry_access(p, g, a).
plp_exempt(f, g, a) :- plp_access(f, _, g, a), docof(f, d), plp_gcat(d, g, "managed-memoization-cache"),
    plp_name("MANAGED_MEMOIZATION_CACHE_ACCESSES", a).

// ==== 5. findings =================================================================================================
.violation PLP001(at: node) code "PLP-001" "pure-lazy functions must not access runtime attributes"
PLP001(a) :- plp_a_prot(f, a), plp_seen(f, a).

.violation PLP002(at: node) code "PLP-002" "pure-lazy functions must not dynamically access runtime attributes"
PLP002(r) :- plp_r4(_, r).
PLP002(c) :- plp_c_getattr(f, c), plp_seen(f, c).

.violation PLP003(at: node) code "PLP-003" "pure-lazy functions must not return runtime-bound handles or containers"
PLP003(r) :- plp_r3(f, r), plp_an(f, _, _).
PLP003(r) :- plp_r5(_, r, "PLP-003").

.violation PLP004(at: node) code "PLP-004" "pure-lazy functions must not return resolved lazy wrappers containing runtime-bound state"
PLP004(r) :- plp_r5(_, r, "PLP-004").

.violation PLP005(at: node) code "PLP-005" "pure-lazy functions must not return locals derived from runtime-bound state"
PLP005(r) :- plp_r6(_, r).

.violation PLP006(at: node) code "PLP-006" "pure-lazy functions must not declare runtime-handle return types"
PLP006(f) :- plp_an(f, _, 0), plp_ann_hit(f).

.violation PLP007(at: node) code "PLP-007" "exported public *_lazy functions must be decorated with @pure_lazy"
PLP007(g) :- !plp_src_mode(), plp_xres(_, g), plp_sym(_, q, g), !contains(".", q), suffix("_lazy", q), !prefix("_", q),
    !plp_explicit(g).

.violation PLP008(at: node, why: symbol) code "PLP-008" "pure-lazy functions must not {why}"
PLP008(r, "return module-level runtime state") :- plp_r7(f, r), plp_an(f, _, 0).
PLP008(c, "pass module-level runtime state into a runtime sink") :- plp_c_sink(f, c), plp_seen(f, c), plp_an(f, _, 0).
PLP008(c, "read ambient module-level runtime state") :- plp_c_recv(f, c, g, _), plp_seen(f, c), docof(f, d), plp_cv(d, g),
    plp_an(f, _, 0).

.violation PLP009(at: node, g: symbol, c: symbol, access: symbol) code "PLP-009" "pure-lazy global cache/state access requires signed allowlist for '{g}' ({c}) via '{access}'"
PLP009(n, g, c, a) :- plp_access(f, n, g, a), !plp_exempt(f, g, a), plp_an(f, _, 0), docof(f, d), plp_gcat(d, g, c).

.violation PLP010(at: node) code "PLP-010" "pure-lazy functions must not construct LazyOperation payloads with runtime handle fields"
PLP010(r) :- plp_r2(f, r), plp_an(f, _, 0).

// ---- PLP-007: what data_layer/*.py exports ----
// The names: `__all__` when the module assigns one, else its public from-imports and top-level defs.
.decl plp_export(d: number, x: symbol)
plp_export(d, x) :- doc(d, p, m), glob("data_layer/*.py", p), plp_docin(d), dunder_all(m, x), !prefix("_", x).
plp_export(d, x) :- doc(d, p, m), glob("data_layer/*.py", p), plp_docin(d), !has_all(m), modnode(d, mn),
    plp_imp(mn, x, _, "sym"), !prefix("_", x).
plp_export(d, x) :- doc(d, p, m), glob("data_layer/*.py", p), plp_docin(d), !has_all(m), plp_sym(d, x, _),
    !contains(".", x), !prefix("_", x).
// plp_xq(s) asks where "module.name" s is defined, following re-exports; plp_xres answers.
.decl plp_fq(s: symbol, f: node)
plp_fq(s, f) :- plp_fq0(s, f), plp_in_rec(f).
.decl plp_xq(s: symbol)
plp_xq(q) :- plp_export(d, x), modnode(d, mn), plp_imp(mn, x, q, "sym").
plp_xq(cat(m, ".", x)) :- plp_export(d, x), modnode(d, mn), !plp_imp(mn, x, _, "sym"), doc(d, _, m).
plp_xq(q2) :- plp_xq(s), !plp_fq(s, _), split_dot(s, pm, nm), doc(d, _, pm), plp_docin(d), modnode(d, mn),
    plp_imp(mn, nm, q2, "sym").
.decl plp_xres(s: symbol, g: node)
plp_xres(s, g) :- plp_xq(s), plp_fq(s, g).
plp_xres(s, g) :- plp_xq(s), !plp_fq(s, _), split_dot(s, pm, nm), doc(d, _, pm), plp_docin(d), modnode(d, mn),
    plp_imp(mn, nm, q2, "sym"), plp_xres(q2, g).
