{
  "format": "rerail.policy/v1",
  "id": "eslint-no-useless-catch",
  "revision": 3,
  "mode": "steer",
  "description": "Remove catch clauses that only rethrow the caught error; they add nothing but nesting.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-catch",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "try_statement"
              },
              {
                "not": {
                  "has": {
                    "kind": "finally_clause"
                  }
                }
              },
              {
                "has": {
                  "matches": "useless-catch"
                }
              }
            ]
          },
          "utils": {
            "useless-catch": {
              "all": [
                {
                  "kind": "catch_clause"
                },
                {
                  "has": {
                    "kind": "identifier",
                    "pattern": "$P"
                  }
                },
                {
                  "has": {
                    "kind": "statement_block",
                    "has": {
                      "all": [
                        {
                          "kind": "throw_statement"
                        },
                        {
                          "not": {
                            "follows": {
                              "all": [
                                {
                                  "not": {
                                    "kind": "comment"
                                  }
                                },
                                {
                                  "not": {
                                    "regex": "^\\{$"
                                  }
                                }
                              ],
                              "stopBy": "end"
                            }
                          }
                        },
                        {
                          "has": {
                            "matches": "param-ref"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "param-ref": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$P"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "param-ref"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-useless-catch",
        "message": "Unnecessary try/catch wrapper.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-useless-catch"
            ]
          },
          "oxlint": {
            "rules": [
              "no-useless-catch"
            ]
          },
          "biome": {
            "rules": [
              "lint/complexity/noUselessCatch"
            ]
          }
        }
      }
    },
    {
      "id": "unnecessary-catch-clause",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "matches": "useless-catch"
              },
              {
                "inside": {
                  "kind": "try_statement",
                  "has": {
                    "kind": "finally_clause"
                  }
                }
              }
            ]
          },
          "utils": {
            "useless-catch": {
              "all": [
                {
                  "kind": "catch_clause"
                },
                {
                  "has": {
                    "kind": "identifier",
                    "pattern": "$P"
                  }
                },
                {
                  "has": {
                    "kind": "statement_block",
                    "has": {
                      "all": [
                        {
                          "kind": "throw_statement"
                        },
                        {
                          "not": {
                            "follows": {
                              "all": [
                                {
                                  "not": {
                                    "kind": "comment"
                                  }
                                },
                                {
                                  "not": {
                                    "regex": "^\\{$"
                                  }
                                }
                              ],
                              "stopBy": "end"
                            }
                          }
                        },
                        {
                          "has": {
                            "matches": "param-ref"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "param-ref": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$P"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "param-ref"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-useless-catch",
        "message": "Unnecessary catch clause.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-useless-catch"
            ]
          },
          "oxlint": {
            "rules": [
              "no-useless-catch"
            ]
          },
          "biome": {
            "rules": [
              "lint/complexity/noUselessCatch"
            ]
          }
        }
      }
    }
  ]
}