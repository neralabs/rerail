                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "method_definition"
                  },
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Move this throw out of the finally block; it replaces the result or exception of the try and catch blocks.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-unsafe-finally"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unsafe-finally"
            ]
          },
          "biome": {
            "rules": [
              "lint/correctness/noUnsafeFinally"
            ]
          }
        }
      }
    },
    {
      "id": "break",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "break_statement",
            "not": {
              "has": {
                "kind": "statement_identifier",
                "stopBy": "neighbor"
              }
