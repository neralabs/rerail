                  },
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  },
                  {
                    "kind": "for_statement"
                  },
                  {
                    "kind": "for_in_statement"
                  },
                  {
                    "kind": "while_statement"
                  },
                  {
                    "kind": "do_statement"
                  },
                  {
                    "kind": "switch_statement"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Move this break out of the finally block; it discards the result or exception of the try and catch blocks.",
        "suppress": {
