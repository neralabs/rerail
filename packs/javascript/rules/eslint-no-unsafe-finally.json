{
  "format": "rerail.policy/v1",
  "id": "eslint-no-unsafe-finally",
  "revision": 3,
  "mode": "steer",
  "description": "Don't return, throw, break or continue out of a finally block; it silently overrides the result or exception of the try and catch blocks.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "return",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "return_statement",
            "inside": {
              "kind": "finally_clause",
              "stopBy": {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "method_definition"
                  },
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Move this return out of the finally block; it overrides the result or exception of the try and catch blocks.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-unsafe-finally"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unsafe-finally"
            ]
          },
          "biome": {
            "rules": [
              "lint/correctness/noUnsafeFinally"
            ]
          }
        }
      }
    },
    {
      "id": "throw",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "throw_statement",
            "inside": {
              "kind": "finally_clause",
