{
  "format": "rerail.policy/v1",
  "id": "eslint-no-nested-ternary",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid nesting ternary expressions inside each other; use if-else or intermediate variables for readability.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "nested-ternary",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "ternary_expression",
            "has": {
              "all": [
                {
                  "follows": {
                    "regex": "^\\?$",
                    "stopBy": "end"
                  }
                },
                {
                  "any": [
                    {
                      "kind": "ternary_expression"
                    },
                    {
                      "kind": "parenthesized_expression",
                      "has": {
                        "kind": "ternary_expression",
                        "stopBy": {
                          "not": {
                            "kind": "parenthesized_expression"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-nested-ternary",
        "message": "Replace this nested ternary with if-else statements or intermediate variables.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-nested-ternary"
            ]
          },
          "oxlint": {
            "rules": [
              "no-nested-ternary"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/noNestedTernary"
            ]
          }
        }
      }
    }
  ]
}
