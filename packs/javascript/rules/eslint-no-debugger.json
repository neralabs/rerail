{
  "format": "rerail.policy/v1",
  "id": "eslint-no-debugger",
  "revision": 3,
  "mode": "steer",
  "description": "Remove debugger statements; they pause execution whenever developer tools are open.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "debugger-statement",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "debugger_statement"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-debugger",
        "message": "Remove this debugger statement.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-debugger"
            ]
          },
          "oxlint": {
            "rules": [
              "no-debugger"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noDebugger"
            ]
          }
        }
      }
    }
  ]
}
