{
  "format": "rerail.policy/v1",
  "id": "eslint-no-template-curly-in-string",
  "revision": 4,
  "mode": "steer",
  "description": "Don't put template placeholders inside ordinary quoted strings; they are not interpolated, so use a template literal instead.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "template-curly-in-string",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "string",
            "value": {
              "regex": "\\$\\{[^}]+\\}"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-template-curly-in-string",
        "message": "Change these quotes to backticks so the ${...} is interpolated, or escape the $ if the text is meant literally.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-template-curly-in-string"
            ]
          },
          "oxlint": {
            "rules": [
              "no-template-curly-in-string"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noTemplateCurlyInString"
            ]
          }
        }
      }
    }
  ]
}
