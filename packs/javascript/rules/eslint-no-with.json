{
  "format": "rerail.policy/v1",
  "id": "eslint-no-with",
  "revision": 4,
  "mode": "steer",
  "description": "Don't use with statements in JavaScript; they make variable lookup ambiguous and are forbidden in strict mode.",
  "scope": {
    "include": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "with-statement",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "^with$",
            "inside": {
              "kind": "with_statement"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-with",
        "message": "Remove this with statement and reference the object's properties explicitly through a variable.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-with"
            ]
          },
          "oxlint": {
            "rules": [
              "no-with"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noWith"
            ]
          }
        }
      }
    }
  ]
}
