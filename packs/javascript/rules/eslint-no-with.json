{
  "format": "rerail.policy/v1",
  "id": "eslint-no-with",
  "revision": 3,
  "mode": "steer",
  "description": "Port of ESLint's `no-with` rule (https://eslint.org/docs/latest/rules/no-with). Reports every `with` statement, at its `with` keyword.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "with-statement",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "^with$",
            "inside": {
              "kind": "with_statement"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-with",
        "message": "Unexpected use of 'with' statement.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-with"
            ]
          },
          "oxlint": {
            "rules": [
              "no-with"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noWith"
            ]
          }
        }
      }
    }
  ]
}
