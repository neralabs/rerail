{
  "format": "rerail.policy/v1",
  "id": "eslint-no-ternary",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid the ternary conditional operator entirely; write an if statement instead.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "ternary",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "ternary_expression"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-ternary",
        "message": "Rewrite this ternary as an if statement.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-ternary"
            ]
          },
          "oxlint": {
            "rules": [
              "no-ternary"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/noTernary"
            ]
          }
        }
      }
    }
  ]
}
