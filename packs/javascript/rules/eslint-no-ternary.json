{
  "format": "rerail.policy/v1",
  "id": "eslint-no-ternary",
  "revision": 1,
  "mode": "steer",
  "description": "Port of ESLint's `no-ternary` rule (https://eslint.org/docs/latest/rules/no-ternary). Reports every conditional expression.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "ternary",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "ternary_expression"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-ternary",
        "message": "Ternary operator used."
      }
    }
  ]
}
