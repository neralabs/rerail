{
  "format": "rerail.policy/v1",
  "id": "eslint-no-nonoctal-decimal-escape",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid the \\8 and \\9 escape sequences in strings; they are not valid escapes and just produce the digit, which misleads readers.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "decimal-escape",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "escape_sequence",
            "regex": "^\\\\[89]$",
            "inside": {
              "kind": "string",
              "stopBy": "neighbor"
            },
            "pattern": "$ESC"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-nonoctal-decimal-escape",
        "message": "Don't use '$ESC' escape sequence.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-nonoctal-decimal-escape"
            ]
          },
          "oxlint": {
            "rules": [
              "no-nonoctal-decimal-escape"
            ]
          },
          "biome": {
            "rules": [
              "lint/correctness/noNonoctalDecimalEscape"
            ]
          }
        }
      }
    }
  ]
}
