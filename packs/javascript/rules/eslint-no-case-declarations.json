{
 "format": "rerail.policy/v1",
 "id": "eslint-no-case-declarations",
 "revision": 3,
 "mode": "steer",
 "description": "Wrap let, const, function and class declarations inside a switch case in braces; otherwise they leak into the whole switch.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "case-declaration",
   "forbid": {
    "ast": {
     "language": "typescript",
     "rule": {
      "any": [
       {
        "kind": "lexical_declaration"
       },
       {
        "kind": "function_declaration"
       },
       {
        "kind": "generator_function_declaration"
       },
       {
        "kind": "class_declaration"
       },
       {
        "kind": "abstract_class_declaration"
       },
       {
        "kind": "expression_statement",
        "has": {
         "stopBy": "neighbor",
         "any": [
          {
           "kind": "assignment_expression",
           "has": {
            "stopBy": "neighbor",
            "regex": "^using$"
           }
          },
          {
           "kind": "await_expression",
           "has": {
            "stopBy": "neighbor",
            "kind": "assignment_expression",
            "has": {
             "stopBy": "neighbor",
             "regex": "^using$"
            }
           }
          }
         ]
        }
       }
      ],
      "inside": {
       "any": [
        {
         "kind": "switch_case"
        },
        {
         "kind": "switch_default"
        }
       ],
       "stopBy": "neighbor"
      }
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "no-case-declarations",
    "message": "Wrap this case's body in braces so the declaration stays scoped to it.",
    "suppress": {
     "eslint": {
      "rules": [
       "no-case-declarations"
      ]
     },
     "oxlint": {
      "rules": [
       "no-case-declarations"
      ]
     },
     "biome": {
      "rules": [
       "lint/correctness/noSwitchDeclarations"
      ]
     }
    }
   }
  }
 ]
}
