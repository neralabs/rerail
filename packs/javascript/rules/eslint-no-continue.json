{
  "format": "rerail.policy/v1",
  "id": "eslint-no-continue",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid continue statements in loops; restructure the loop with a condition instead.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "continue-statement",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "continue_statement"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-continue",
        "message": "Unexpected use of continue statement.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-continue"
            ]
          },
          "oxlint": {
            "rules": [
              "no-continue"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/noContinue"
            ]
          }
        }
      }
    }
  ]
}
