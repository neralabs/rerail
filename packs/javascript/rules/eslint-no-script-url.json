{
  "format": "rerail.policy/v1",
  "id": "eslint-no-script-url",
  "revision": 4,
  "mode": "steer",
  "description": "Avoid javascript: URLs in strings and template literals; running code from a URL is a form of eval.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "script-url",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "string"
              },
              {
                "kind": "template_string",
                "not": {
                  "any": [
                    {
                      "has": {
                        "kind": "template_substitution",
                        "stopBy": "neighbor"
                      }
                    },
                    {
                      "inside": {
                        "kind": "call_expression",
                        "stopBy": "neighbor"
                      }
                    }
                  ]
                }
              }
            ],
            "value": {
              "regex": "^(?i:javascript:)"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-script-url",
        "message": "Script URL is a form of eval.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-script-url"
            ]
          },
          "oxlint": {
            "rules": [
              "no-script-url"
            ]
          },
          "biome": {
            "rules": [
              "lint/security/noScriptUrl"
            ]
          }
        }
      }
    }
  ]
}
