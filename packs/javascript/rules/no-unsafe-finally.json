{
  "format": "rerail.policy/v1",
  "id": "eslint:no-unsafe-finally",
  "revision": 1,
  "mode": "steer",
  "description": "Port of ESLint's `no-unsafe-finally` rule (https://eslint.org/docs/latest/rules/no-unsafe-finally). Flags return/throw/break/continue inside a finally block that would transfer control out of it: the nearest finally before a function/class boundary (and, for unlabeled break/continue, before an enclosing loop or switch; for a labeled jump, before the labeled statement it targets).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "return",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "return_statement",
            "inside": {
              "kind": "finally_clause",
              "stopBy": {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "method_definition"
                  },
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Unsafe usage of ReturnStatement."
      }
    },
    {
      "id": "throw",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "throw_statement",
            "inside": {
              "kind": "finally_clause",
              "stopBy": {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "method_definition"
                  },
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Unsafe usage of ThrowStatement."
      }
    },
    {
      "id": "break",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "break_statement",
            "not": {
              "has": {
                "kind": "statement_identifier",
                "stopBy": "neighbor"
              }
            },
            "inside": {
              "kind": "finally_clause",
              "stopBy": {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "method_definition"
                  },
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  },
                  {
                    "kind": "for_statement"
                  },
                  {
                    "kind": "for_in_statement"
                  },
                  {
                    "kind": "while_statement"
                  },
                  {
                    "kind": "do_statement"
                  },
                  {
                    "kind": "switch_statement"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Unsafe usage of BreakStatement."
      }
    },
    {
      "id": "continue",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "continue_statement",
            "not": {
              "has": {
                "kind": "statement_identifier",
                "stopBy": "neighbor"
              }
            },
            "inside": {
              "kind": "finally_clause",
              "stopBy": {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "method_definition"
                  },
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  },
                  {
                    "kind": "for_statement"
                  },
                  {
                    "kind": "for_in_statement"
                  },
                  {
                    "kind": "while_statement"
                  },
                  {
                    "kind": "do_statement"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Unsafe usage of ContinueStatement."
      }
    },
    {
      "id": "labeled-break",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "break_statement",
                "has": {
                  "kind": "statement_identifier",
                  "pattern": "$L",
                  "stopBy": "neighbor"
                }
              },
              {
                "inside": {
                  "kind": "finally_clause",
                  "stopBy": {
                    "any": [
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "generator_function_declaration"
                      },
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "method_definition"
                      },
                      {
                        "kind": "class_declaration"
                      },
                      {
                        "kind": "class"
                      },
                      {
                        "kind": "abstract_class_declaration"
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "kind": "labeled_statement",
                    "has": {
                      "kind": "statement_identifier",
                      "pattern": "$L",
                      "stopBy": "neighbor"
                    },
                    "stopBy": {
                      "any": [
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "function_expression"
                        },
                        {
                          "kind": "generator_function"
                        },
                        {
                          "kind": "generator_function_declaration"
                        },
                        {
                          "kind": "arrow_function"
                        },
                        {
                          "kind": "method_definition"
                        },
                        {
                          "kind": "class_declaration"
                        },
                        {
                          "kind": "class"
                        },
                        {
                          "kind": "abstract_class_declaration"
                        },
                        {
                          "kind": "finally_clause"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Unsafe usage of BreakStatement."
      }
    },
    {
      "id": "labeled-continue",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "continue_statement",
                "has": {
                  "kind": "statement_identifier",
                  "pattern": "$L",
                  "stopBy": "neighbor"
                }
              },
              {
                "inside": {
                  "kind": "finally_clause",
                  "stopBy": {
                    "any": [
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "generator_function_declaration"
                      },
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "method_definition"
                      },
                      {
                        "kind": "class_declaration"
                      },
                      {
                        "kind": "class"
                      },
                      {
                        "kind": "abstract_class_declaration"
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "kind": "labeled_statement",
                    "has": {
                      "kind": "statement_identifier",
                      "pattern": "$L",
                      "stopBy": "neighbor"
                    },
                    "stopBy": {
                      "any": [
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "function_expression"
                        },
                        {
                          "kind": "generator_function"
                        },
                        {
                          "kind": "generator_function_declaration"
                        },
                        {
                          "kind": "arrow_function"
                        },
                        {
                          "kind": "method_definition"
                        },
                        {
                          "kind": "class_declaration"
                        },
                        {
                          "kind": "class"
                        },
                        {
                          "kind": "abstract_class_declaration"
                        },
                        {
                          "kind": "finally_clause"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "Unsafe usage of ContinueStatement."
      }
    }
  ]
}
