{
  "format": "rerail.policy/v1",
  "id": "unicorn-prefer-node-protocol",
  "revision": 2,
  "mode": "steer",
  "description": "Import Node.js built-in modules with the node: prefix; it makes clear they are built-ins, not npm packages.",
  "scope": {
    "include": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.config.js",
      "**/*.config.mjs",
      "**/*.config.cjs",
      "**/.*rc.js",
      "**/.*rc.cjs"
    ]
  },
  "clauses": [
    {
      "id": "import",
      "forbid": {
        "ast": {
          "language": "javascript",
          "rule": {
            "kind": "string",
            "value": {
              "regex": "^(?:diagnostics_channel|inspector\\/promises|readline\\/promises|stream\\/consumers|stream\\/promises|timers\\/promises|string_decoder|worker_threads|assert\\/strict|child_process|dns\\/promises|trace_events|async_hooks|fs\\/promises|querystring|stream\\/iter|path\\/posix|path\\/win32|perf_hooks|stream\\/web|util\\/types|constants|inspector|zlib\\/iter|readline|cluster|console|process|assert|buffer|crypto|domain|events|module|stream|timers|dgram|http2|https|http|path|repl|util|wasi|zlib|dns|net|tls|tty|url|fs|os|v8|vm)$"
            },
            "any": [
              {
                "inside": {
                  "any": [
                    {
                      "kind": "import_statement"
                    },
                    {
                      "kind": "export_statement"
                    }
                  ],
                  "field": "source",
                  "stopBy": "neighbor"
                }
              },
              {
                "nthChild": {
                  "ofRule": {
                    "not": {
                      "kind": "comment"
                    }
                  },
                  "position": 1
                },
                "inside": {
                  "kind": "arguments",
                  "stopBy": "neighbor",
                  "inside": {
                    "kind": "call_expression",
                    "stopBy": "neighbor",
                    "has": {
                      "field": "function",
                      "kind": "import"
                    }
                  }
                }
              },
              {
                "all": [
                  {
                    "nthChild": {
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      },
                      "position": 1
                    }
                  },
                  {
                    "inside": {
                      "kind": "arguments",
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "has": {
                              "nthChild": {
                                "ofRule": {
                                  "not": {
                                    "kind": "comment"
                                  }
                                },
                                "position": 2
                              }
                            }
                          },
                          {
                            "has": {
                              "kind": "spread_element"
                            }
                          }
                        ]
                      },
                      "inside": {
                        "kind": "call_expression",
                        "stopBy": "neighbor",
                        "has": {
                          "field": "function",
                          "regex": "^(?:\\(\\s*)*(?:require|process\\.getBuiltinModule)(?:\\s*\\))*$"
                        },
                        "not": {
                          "has": {
                            "kind": "optional_chain",
                            "stopBy": "neighbor"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "unicorn/prefer-node-protocol",
        "message": "Prefer `node:` when importing a Node.js built-in module.",
        "suppress": {
          "eslint": {
            "rules": [
              "unicorn/prefer-node-protocol"
            ]
          },
          "oxlint": {
            "rules": [
              "prefer-node-protocol"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/useNodejsImportProtocol"
            ]
          }
        }
      }
    }
  ]
}
