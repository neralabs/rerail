{
  "format": "rerail.policy/v1",
  "id": "eslint-no-eq-null",
  "revision": 3,
  "mode": "steer",
  "description": "Use strict equality when comparing with null; loose equality also matches undefined.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "loose-null-comparison",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "binary_expression",
            "all": [
              {
                "has": {
                  "regex": "^(==|!=)$"
                }
              },
              {
                "has": {
                  "kind": "null",
                  "stopBy": {
                    "not": {
                      "kind": "parenthesized_expression"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-eq-null",
        "message": "Use '===' to compare with null.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-eq-null"
            ]
          },
          "oxlint": {
            "rules": [
              "no-eq-null"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noEqualsToNull"
            ]
          }
        }
      }
    }
  ]
}
