{
  "format": "rerail.policy/v1",
  "id": "eslint-no-caller",
  "revision": 2,
  "mode": "steer",
  "description": "Don't use arguments.callee or arguments.caller; they are deprecated and throw in strict mode.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "arguments-callee-caller",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "member_expression",
            "all": [
              {
                "has": {
                  "kind": "identifier",
                  "regex": "^arguments$",
                  "stopBy": {
                    "not": {
                      "kind": "parenthesized_expression"
                    }
                  }
                }
              },
              {
                "has": {
                  "kind": "property_identifier",
                  "regex": "^calle[er]$",
                  "pattern": "$PROP"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-caller",
        "message": "Replace arguments.$PROP with a reference to the function by name or an explicit parameter.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-caller"
            ]
          },
          "oxlint": {
            "rules": [
              "no-caller"
            ]
          }
        }
      }
    }
  ]
}
