{
  "format": "rerail.policy/v1",
  "id": "eslint-no-empty-static-block",
  "revision": 3,
  "mode": "steer",
  "description": "Remove empty class static blocks, or add a comment explaining why one is empty.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "empty-static-block",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "statement_block",
            "inside": {
              "kind": "class_static_block",
              "stopBy": "neighbor"
            },
            "not": {
              "has": {
                "stopBy": "neighbor",
                "not": {
                  "regex": "^[{}]$"
                },
                "precedes": {
                  "regex": "^}$",
                  "stopBy": "end"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-empty-static-block",
        "message": "Unexpected empty static block.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-empty-static-block"
            ]
          },
          "oxlint": {
            "rules": [
              "no-empty-static-block"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noEmptyBlockStatements"
            ]
          }
        }
      }
    }
  ]
}
