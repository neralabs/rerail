{
  "format": "rerail.policy/v1",
  "id": "eslint-default-case-last",
  "revision": 3,
  "mode": "steer",
  "description": "Put the default clause last in a switch statement; a default in the middle is easy to misread.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "not-last",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "switch_default",
            "precedes": {
              "kind": "switch_case",
              "stopBy": "end"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "default-case-last",
        "message": "Move this default clause to the end of the switch.",
        "suppress": {
          "eslint": {
            "rules": [
              "default-case-last"
            ]
          },
          "oxlint": {
            "rules": [
              "default-case-last"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/useDefaultSwitchClauseLast"
            ]
          }
        }
      }
    }
  ]
}
