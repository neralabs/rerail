{
  "format": "rerail.policy/v1",
  "id": "eslint-no-delete-var",
  "revision": 2,
  "mode": "steer",
  "description": "Don't use delete on a plain variable; delete only removes object properties and is a syntax error on variables in strict mode.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "delete-identifier",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "unary_expression",
            "all": [
              {
                "has": {
                  "regex": "^delete$",
                  "not": {
                    "kind": "identifier"
                  }
                }
              },
              {
                "has": {
                  "kind": "identifier",
                  "stopBy": {
                    "not": {
                      "kind": "parenthesized_expression"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-delete-var",
        "message": "Remove this delete; to clear the variable, assign undefined to it instead.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-delete-var"
            ]
          },
          "oxlint": {
            "rules": [
              "no-delete-var"
            ]
          }
        }
      }
    }
  ]
}
