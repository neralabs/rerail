{"format":"rerail.policy/v1","id":"eslint-no-octal-escape","revision":4,"mode":"steer","description":"Use Unicode or hex escapes instead of legacy octal escapes in string literals; octal escapes are deprecated and forbidden in strict mode.","scope":{"include":["**/*"],"exclude":[]},"clauses":[{"id":"octal-escape","forbid":{"ast":{"language":"typescript","rule":{"kind":"string","regex":"(?s)^(?:[^\\\\]|\\\\.)*?(?:(?<SEQ>\\\\(?:[0-3][0-7]{1,2}|[4-7][0-7]))|(?<SEQZ>\\\\0)[89]|(?<SEQD>\\\\[1-7]))"}}},"violation":{"anchor":"witness.span","code":"no-octal-escape","message":"Don't use octal: '$SEQ$SEQZ$SEQD'. Use '\\u....' instead.","suppress":{"eslint":{"rules":["no-octal-escape"]}, "biome":{"rules":["lint/suspicious/noOctalEscape"]}}}}]}
