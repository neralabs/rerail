{"format":"rerail.policy/v1","id":"eslint-no-useless-concat","revision":3,"mode":"steer","description":"Port of ESLint's `no-useless-concat` rule (https://eslint.org/docs/latest/rules/no-useless-concat). Flags a `+` whose nearest operands (through nested `+` chains and parentheses) are both string or template literals, the right one starting on the line where the left one ends (a `layout` gap to the left literal).","scope":{"include":["**/*"],"exclude":[]},"clauses":[{"id":"literal-concat","forbid":{"ast":{"language":"typescript","rule":{"regex":"^\\+$","inside":{"kind":"binary_expression","stopBy":"neighbor"},"follows":{"matches":"right-most-literal","stopBy":{"not":{"kind":"comment"}}},"precedes":{"matches":"left-most-literal","stopBy":{"not":{"kind":"comment"}}}},"utils":{"right-most-literal":{"any":[{"any":[{"kind":"string"},{"kind":"template_string"}],"pattern":"$L"},{"kind":"parenthesized_expression","has":{"matches":"right-most-literal","stopBy":"neighbor"}},{"kind":"binary_expression","all":[{"has":{"regex":"^\\+$","stopBy":"neighbor"}},{"has":{"matches":"right-most-literal","stopBy":"neighbor","not":{"precedes":{"regex":"[\\s\\S]","stopBy":"neighbor"}}}}]}]},"left-most-literal":{"any":[{"any":[{"kind":"string"},{"kind":"template_string"}],"layout":{"before":{"to":"capture.L","breaks":{"eq":0}}}},{"kind":"parenthesized_expression","has":{"matches":"left-most-literal","stopBy":"neighbor"}},{"kind":"binary_expression","all":[{"has":{"regex":"^\\+$","stopBy":"neighbor"}},{"has":{"matches":"left-most-literal","stopBy":"neighbor","not":{"follows":{"regex":"[\\s\\S]","stopBy":"neighbor"}}}}]}]}}}},"violation":{"anchor":"witness.span","code":"no-useless-concat","message":"Unexpected string concatenation of literals.","suppress":{"eslint":{"rules":["no-useless-concat"]},"oxlint":{"rules":["no-useless-concat"]}}}}]}
