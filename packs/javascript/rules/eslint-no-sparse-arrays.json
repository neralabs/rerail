{
  "format": "rerail.policy/v1",
  "id": "eslint-no-sparse-arrays",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid holes in array literals from consecutive commas; they create sparse arrays and usually come from a typo.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "hole-comma",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "^,$",
            "inside": {
              "kind": "array"
            },
            "follows": {
              "regex": "^[\\[,]$",
              "stopBy": {
                "not": {
                  "kind": "comment"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-sparse-arrays",
        "message": "Remove the extra comma, or write undefined explicitly if this hole is intended.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-sparse-arrays"
            ]
          },
          "oxlint": {
            "rules": [
              "no-sparse-arrays"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noSparseArray"
            ]
          }
        }
      }
    }
  ]
}
