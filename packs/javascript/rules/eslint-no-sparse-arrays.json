{
  "format": "rerail.policy/v1",
  "id": "eslint-no-sparse-arrays",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid holes in array literals from consecutive commas; they create sparse arrays and usually come from a typo.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "hole-comma",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "array",
            "tokens": {
              "has": "^,$",
              "as": "TOKEN",
              "where": {
                "follows": {
                  "regex": "^[\\[,]$",
                  "stopBy": {
                    "not": {
                      "kind": "comment"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.TOKEN",
        "code": "no-sparse-arrays",
        "message": "Unexpected comma in middle of array.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-sparse-arrays"
            ]
          },
          "oxlint": {
            "rules": [
              "no-sparse-arrays"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noSparseArray"
            ]
          }
        }
      }
    }
  ]
}
