{
  "format": "rerail.policy/v1",
  "id": "eslint-no-negated-condition",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid negated conditions in an if with an else or in a ternary; swap the branches and drop the negation.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "negated-condition",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "if_statement",
                "all": [
                  {
                    "has": {
                      "kind": "parenthesized_expression",
                      "stopBy": "neighbor",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "negated"
                      }
                    }
                  },
                  {
                    "has": {
                      "kind": "else_clause",
                      "stopBy": "neighbor",
                      "not": {
                        "has": {
                          "kind": "if_statement",
                          "stopBy": "neighbor"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "kind": "ternary_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "negated",
                  "precedes": {
                    "regex": "^\\?$",
                    "stopBy": "neighbor"
                  }
                }
              }
            ]
          },
          "utils": {
            "negated": {
              "any": [
                {
                  "kind": "unary_expression",
                  "has": {
                    "regex": "^!$",
                    "stopBy": "neighbor"
                  }
                },
                {
                  "kind": "binary_expression",
                  "has": {
                    "regex": "^!==?$",
                    "stopBy": "neighbor"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "negated"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-negated-condition",
        "message": "Remove the negation from this condition and swap the two branches.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-negated-condition"
            ]
          },
          "oxlint": {
            "rules": [
              "no-negated-condition"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/noNegationElse"
            ]
          }
        }
      }
    }
  ]
}
