{
  "format": "rerail.policy/v1",
  "id": "eslint:no-sparse-arrays",
  "revision": 1,
  "mode": "steer",
  "description": "Port of ESLint's `no-sparse-arrays` rule (https://eslint.org/docs/latest/rules/no-sparse-arrays). Reports, at the comma, every hole in an array literal: a comma whose previous non-comment sibling is `[` or another comma.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "hole-comma",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "^,$",
            "inside": {
              "kind": "array"
            },
            "follows": {
              "regex": "^[\\[,]$",
              "stopBy": {
                "not": {
                  "kind": "comment"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-sparse-arrays",
        "message": "Unexpected comma in middle of array."
      }
    }
  ]
}
