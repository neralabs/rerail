{
  "format": "rerail.policy/v1",
  "id": "eslint-no-multi-str",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid multiline strings built with backslash line continuations; use a template literal or concatenation instead.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "multiline-string",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "string",
            "regex": "[\\r\\n\\u2028\\u2029]",
            "not": {
              "inside": {
                "any": [
                  {
                    "kind": "jsx_attribute"
                  },
                  {
                    "kind": "jsx_expression"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-multi-str",
        "message": "Multiline support is limited to browsers supporting ES5 only.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-multi-str"
            ]
          },
          "oxlint": {
            "rules": [
              "no-multi-str"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/noMultilineString"
            ]
          }
        }
      }
    }
  ]
}
