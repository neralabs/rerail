{
  "format": "rerail.policy/v1",
  "id": "eslint-no-var",
  "revision": 2,
  "mode": "steer",
  "description": "Use let or const instead of var in JavaScript; they are block-scoped and avoid hoisting surprises.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.config.js",
      "**/*.config.mjs",
      "**/*.config.cjs",
      "**/.*rc.js",
      "**/.*rc.cjs"
    ]
  },
  "clauses": [
    {
      "id": "var",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "variable_declaration",
                "not": {
                  "any": [
                    {
                      "inside": {
                        "regex": "^declare\\s",
                        "stopBy": "neighbor",
                        "not": {
                          "kind": "program"
                        }
                      }
                    },
                    {
                      "inside": {
                        "kind": "statement_block",
                        "stopBy": "neighbor",
                        "inside": {
                          "regex": "^(?:declare\\s+)?global\\s*\\{",
                          "stopBy": "neighbor"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "regex": "^declare\\s+var\\b",
                "has": {
                  "kind": "variable_declaration",
                  "stopBy": "neighbor"
                },
                "not": {
                  "kind": "program"
                }
              },
              {
                "regex": "^var$",
                "inside": {
                  "kind": "for_in_statement",
                  "stopBy": "neighbor"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-var",
        "message": "Unexpected var, use let or const instead.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-var"
            ]
          },
          "oxlint": {
            "rules": [
              "no-var"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noVar"
            ]
          }
        }
      }
    }
  ]
}
