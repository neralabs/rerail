{
  "format": "rerail.policy/v1",
  "id": "eslint-default-param-last",
  "revision": 2,
  "mode": "steer",
  "description": "Put JavaScript parameters with default values after the required ones; a default before a required parameter can only be used by passing undefined.",
  "scope": { "include": ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"], "exclude": [] },
  "clauses": [
    {
      "id": "default-param-not-last",
      "forbid": {
        "ast": {
          "language": "javascript",
          "rule": {
            "kind": "assignment_pattern",
            "inside": { "kind": "formal_parameters", "stopBy": "neighbor" },
            "precedes": {
              "stopBy": "end",
              "any": [
                { "kind": "identifier" },
                { "kind": "undefined" },
                { "kind": "object_pattern" },
                { "kind": "array_pattern" }
              ]
            }
          }
        }
      },
      "violation": { "anchor": "witness.span", "code": "default-param-last", "message": "Move this defaulted parameter after the required ones, or give the parameters after it defaults too.", "suppress": { "eslint": { "rules": ["default-param-last"] }, "oxlint": { "rules": ["default-param-last"] }, "biome": { "rules": ["lint/style/useDefaultParameterLast"] } } }
    }
  ]
}
