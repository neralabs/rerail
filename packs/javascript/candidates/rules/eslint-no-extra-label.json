{
  "format": "rerail.policy/v1",
  "id": "eslint-no-extra-label",
  "revision": 1,
  "mode": "steer",
  "description": "Remove labels from break and continue when they target the nearest enclosing loop or switch anyway.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "loop": {
            "any": [
              {
                "kind": "while_statement"
              },
              {
                "kind": "do_statement"
              },
              {
                "kind": "for_statement"
              },
              {
                "kind": "for_in_statement"
              },
              {
                "kind": "switch_statement"
              }
            ]
          },
          "redundant-label": {
            "all": [
              {
                "has": {
                  "kind": "statement_identifier",
                  "pattern": "$L"
                }
              },
              {
                "inside": {
                  "matches": "loop",
                  "inside": {
                    "kind": "labeled_statement",
                    "has": {
                      "kind": "statement_identifier",
                      "pattern": "$M",
                      "compare": {
                        "left": "M",
                        "op": "eq",
                        "right": "L"
                      }
                    }
                  },
                  "stopBy": {
                    "matches": "loop"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "kind": "labeled_statement",
                    "has": {
                      "kind": "statement_identifier",
                      "pattern": "$L"
                    },
                    "not": {
                      "has": {
                        "matches": "loop"
                      }
                    },
                    "stopBy": {
                      "matches": "loop"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "extra-label-break",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "break_statement"
                  }
                ]
              },
              {
                "not": {
                  "has": {
                    "kind": "comment"
                  }
                }
              },
              {
                "has": {
                  "regex": "^;$"
                }
              },
              {
                "matches": "redundant-label"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.L",
        "code": "no-extra-label",
        "message": "This label '$L' is unnecessary.",
        "fix": "break;",
        "suppress": {
          "eslint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "oxlint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "biome": {
            "rules": [
              "lint/complexity/noUselessLabel"
            ]
          }
        }
      }
    },
    {
      "id": "extra-label-break-asi",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "break_statement"
                  }
                ]
              },
              {
                "not": {
                  "has": {
                    "kind": "comment"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "regex": "^;$"
                  }
                }
              },
              {
                "matches": "redundant-label"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.L",
        "code": "no-extra-label",
        "message": "This label '$L' is unnecessary.",
        "fix": "break",
        "suppress": {
          "eslint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "oxlint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "biome": {
            "rules": [
              "lint/complexity/noUselessLabel"
            ]
          }
        }
      }
    },
    {
      "id": "extra-label-continue",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "continue_statement"
                  }
                ]
              },
              {
                "not": {
                  "has": {
                    "kind": "comment"
                  }
                }
              },
              {
                "has": {
                  "regex": "^;$"
                }
              },
              {
                "matches": "redundant-label"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.L",
        "code": "no-extra-label",
        "message": "This label '$L' is unnecessary.",
        "fix": "continue;",
        "suppress": {
          "eslint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "oxlint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "biome": {
            "rules": [
              "lint/complexity/noUselessLabel"
            ]
          }
        }
      }
    },
    {
      "id": "extra-label-continue-asi",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "continue_statement"
                  }
                ]
              },
              {
                "not": {
                  "has": {
                    "kind": "comment"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "regex": "^;$"
                  }
                }
              },
              {
                "matches": "redundant-label"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.L",
        "code": "no-extra-label",
        "message": "This label '$L' is unnecessary.",
        "fix": "continue",
        "suppress": {
          "eslint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "oxlint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "biome": {
            "rules": [
              "lint/complexity/noUselessLabel"
            ]
          }
        }
      }
    },
    {
      "id": "extra-label-with-comment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "break_statement"
                  },
                  {
                    "kind": "continue_statement"
                  }
                ]
              },
              {
                "has": {
                  "kind": "comment"
                }
              },
              {
                "matches": "redundant-label"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.L",
        "code": "no-extra-label",
        "message": "This label '$L' is unnecessary.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "oxlint": {
            "rules": [
              "no-extra-label"
            ]
          },
          "biome": {
            "rules": [
              "lint/complexity/noUselessLabel"
            ]
          }
        }
      }
    }
  ]
}