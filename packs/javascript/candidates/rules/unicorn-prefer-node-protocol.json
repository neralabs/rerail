{
  "format": "rerail.policy/v1",
  "id": "unicorn-prefer-node-protocol",
  "revision": 1,
  "mode": "steer",
  "description": "Import Node.js built-in modules with the node: prefix; it makes clear they are built-ins, not npm packages.",
  "scope": {
    "include": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.config.js",
      "**/*.config.mjs",
      "**/*.config.cjs",
      "**/.*rc.js",
      "**/.*rc.cjs"
    ]
  },
  "clauses": [
    {
      "id": "import",
      "forbid": {
        "ast": {
          "language": "javascript",
          "rule": {
            "kind": "string",
            "regex": "^[\"'](?:diagnostics_channel|inspector\\/promises|readline\\/promises|stream\\/consumers|stream\\/promises|timers\\/promises|string_decoder|worker_threads|assert\\/strict|child_process|dns\\/promises|trace_events|async_hooks|fs\\/promises|querystring|path\\/posix|path\\/win32|perf_hooks|stream\\/web|util\\/types|constants|inspector|punycode|readline|cluster|console|process|assert|buffer|crypto|domain|events|module|stream|timers|dgram|http2|https|http|path|repl|util|wasi|zlib|dns|net|sys|tls|tty|url|fs|os|v8|vm)[\"']$",
            "any": [
              {
                "inside": {
                  "kind": "import_statement",
                  "stopBy": "neighbor"
                }
              },
              {
                "inside": {
                  "kind": "export_statement",
                  "stopBy": "neighbor"
                }
              },
              {
                "inside": {
                  "kind": "arguments",
                  "stopBy": "neighbor",
                  "inside": {
                    "kind": "call_expression",
                    "stopBy": "neighbor",
                    "has": {
                      "field": "function",
                      "regex": "^(?:require|import)$"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "unicorn/prefer-node-protocol",
        "message": "Prefer `node:` when importing a Node.js built-in module.",
        "suppress": {
          "eslint": {
            "rules": [
              "unicorn/prefer-node-protocol"
            ]
          },
          "oxlint": {
            "rules": [
              "prefer-node-protocol"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/useNodejsImportProtocol"
            ]
          }
        }
      }
    }
  ]
}
