    {
      "id": "var-in-for-in-head",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "^var$",
            "inside": {
              "kind": "for_in_statement",
              "stopBy": "neighbor"
            }
          }
        }
      },
      "violation": {
