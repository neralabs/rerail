{
  "format": "rerail.policy/v1",
  "id": "eslint-vars-on-top",
  "revision": 1,
  "mode": "steer",
  "description": "Declare var variables at the top of their function, script or static block; it matches how var is hoisted.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "var-not-on-top",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "matches": "var"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "program"
                    },
                    {
                      "matches": "function-body"
                    }
                  ]
                }
              },
              {
                "follows": {
                  "stopBy": "end",
                  "all": [
                    {
                      "matches": "statement"
                    },
                    {
                      "not": {
                        "matches": "declaration"
                      }
                    },
                    {
                      "any": [
                        {
                          "not": {
                            "matches": "prologue"
                          }
                        },
                        {
                          "follows": {
                            "stopBy": "end",
                            "all": [
                              {
                                "matches": "statement"
                              },
                              {
                                "not": {
                                  "matches": "prologue"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "utils": {
            "declaration": {
              "any": [
                {
                  "kind": "variable_declaration"
                },
                {
                  "kind": "lexical_declaration"
                },
                {
                  "kind": "export_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "variable_declaration"
                      },
                      {
                        "kind": "lexical_declaration"
                      }
                    ]
                  }
                }
              ]
            },
            "prologue": {
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "expression_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "not": {
                      "follows": {
                        "regex": "[\\s\\S]",
                        "stopBy": "neighbor"
                      }
                    }
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "sequence_expression"
                    }
                  }
                }
              ]
            },
            "statement": {
              "not": {
                "any": [
                  {
                    "kind": "comment"
                  },
                  {
                    "regex": "^[{}]$"
                  }
                ]
              }
            },
            "var": {
              "any": [
                {
                  "kind": "variable_declaration",
                  "not": {
                    "inside": {
                      "kind": "export_statement",
                      "stopBy": "neighbor"
                    }
                  }
                },
                {
                  "kind": "export_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "variable_declaration"
                  }
                }
              ]
            },
            "function-body": {
              "kind": "statement_block",
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "method_definition"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "vars-on-top",
        "message": "All 'var' declarations must be at the top of the function scope.",
        "suppress": {
          "eslint": {
            "rules": [
              "vars-on-top"
            ]
          },
          "oxlint": {
            "rules": [
              "vars-on-top"
            ]
          },
          "biome": {
            "rules": [
              "lint/nursery/useVarsOnTop"
            ]
          }
        }
      }
    },
    {
      "id": "var-not-on-top-static-block",
