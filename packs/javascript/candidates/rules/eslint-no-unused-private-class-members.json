{
  "format": "rerail.policy/v1",
  "id": "eslint-no-unused-private-class-members",
  "revision": 2,
  "mode": "steer",
  "description": "ESLint 10.11.0 no-unused-private-class-members, default options. Port of ESLint's `no-unused-private-class-members` rule (https://eslint.org/docs/latest/rules/no-unused-private-class-members). A private field, method or accessor that no reference in its class body uses (`binds.used: false` on the private name: writes only count for fields and methods, any reference for accessors), reported at its last declaration.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unused-private-member",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "private_property_identifier",
            "pattern": "$N",
            "binds": {
              "used": false
            },
            "not": {
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "public_field_definition"
                  },
                  {
                    "kind": "method_definition"
                  }
                ],
                "precedes": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "public_field_definition"
                    },
                    {
                      "kind": "method_definition"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "private_property_identifier",
                    "pattern": "$N"
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.N",
        "code": "no-unused-private-class-members",
        "message": "'$N' is defined but never used.",
        "suppress": {
          "eslint": {
            "rules": [
              "no-unused-private-class-members"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unused-private-class-members"
            ]
          }
        }
      }
    }
  ]
}
