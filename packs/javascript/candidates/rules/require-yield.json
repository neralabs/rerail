{
  "format": "rerail.policy/v1",
  "id": "eslint:require-yield",
  "revision": 1,
  "mode": "steer",
  "description": "Port of ESLint's `require-yield` (https://eslint.org/docs/latest/rules/require-yield). Flags generator functions with a non-empty body and no `yield` outside nested functions.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "missing-yield",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  },
                  {
                    "kind": "method_definition",
                    "has": {
                      "regex": "^\\*$",
                      "stopBy": "neighbor"
                    }
                  }
                ]
              },
              {
                "has": {
                  "kind": "statement_block",
                  "stopBy": "neighbor",
                  "has": {
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "regex": "."
                      },
                      {
                        "not": {
                          "kind": "comment"
                        }
                      },
                      {
                        "not": {
                          "regex": "^[{}]$"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "statement_block",
                    "has": {
                      "kind": "yield_expression",
                      "stopBy": {
                        "matches": "fn-boundary"
                      }
                    }
                  }
                }
              }
            ]
          },
          "utils": {
            "fn-boundary": {
              "any": [
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "class_static_block"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "REQUIRE_YIELD",
        "message": "This generator function does not have 'yield'."
      }
    }
  ]
}
