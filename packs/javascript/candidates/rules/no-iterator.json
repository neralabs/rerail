{"format":"rerail.policy/v1","id":"eslint:no-iterator","revision":2,"mode":"steer","description":"Port of ESLint's `no-iterator` (https://eslint.org/docs/latest/rules/no-iterator). Flags member accesses whose static property name (getStaticPropertyName) is `__iterator__`: a non-computed name (identifier escapes decoded), or a string or substitution-free template index by its cooked value.","scope":{"include":["**/*"],"exclude":[]},"clauses":[{"id":"iterator-member","forbid":{"ast":{"language":"typescript","utils":{"static-str":{"any":[{"kind":"string"},{"kind":"template_string","not":{"has":{"kind":"template_substitution","stopBy":"neighbor"}}},{"kind":"parenthesized_expression","has":{"stopBy":"neighbor","matches":"static-str"}}]}},"rule":{"any":[{"kind":"member_expression","has":{"kind":"property_identifier","stopBy":"neighbor","regex":"^(?:[_]|\\\\u005[fF]|\\\\u\\{0*5[fF]\\})(?:[_]|\\\\u005[fF]|\\\\u\\{0*5[fF]\\})(?:[i]|\\\\u0069|\\\\u\\{0*69\\})(?:[t]|\\\\u0074|\\\\u\\{0*74\\})(?:[e]|\\\\u0065|\\\\u\\{0*65\\})(?:[r]|\\\\u0072|\\\\u\\{0*72\\})(?:[a]|\\\\u0061|\\\\u\\{0*61\\})(?:[t]|\\\\u0074|\\\\u\\{0*74\\})(?:[o]|\\\\u006[fF]|\\\\u\\{0*6[fF]\\})(?:[r]|\\\\u0072|\\\\u\\{0*72\\})(?:[_]|\\\\u005[fF]|\\\\u\\{0*5[fF]\\})(?:[_]|\\\\u005[fF]|\\\\u\\{0*5[fF]\\})$"}},{"kind":"subscript_expression","has":{"stopBy":"neighbor","precedes":{"regex":"^\\]$","stopBy":"neighbor"},"matches":"static-str","value":{"eq":"__iterator__"}}}]}}},"violation":{"anchor":"witness.span","code":"NO_ITERATOR","message":"Reserved name '__iterator__'."}}]}
