{
 "format": "rerail.policy/v1",
 "id": "eslint-no-extra-bind",
 "revision": 1,
 "mode": "steer",
 "description": "Remove bind() calls that do nothing because the function is an arrow function or never uses this.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "bind-call",
   "forbid": {
    "ast": {
     "language": "typescript",
     "utils": {
      "own-this-boundary": {
       "any": [
        {
         "kind": "function_declaration"
        },
        {
         "kind": "function_expression"
        },
        {
         "kind": "generator_function_declaration"
        },
        {
         "kind": "generator_function"
        },
        {
         "kind": "method_definition"
        },
        {
         "kind": "class_static_block"
        },
        {
         "inside": {
          "kind": "public_field_definition",
          "stopBy": "neighbor"
         },
         "follows": {
          "regex": "^=$",
          "stopBy": "end"
         }
        }
       ]
      },
      "bound-function": {
       "any": [
        {
         "kind": "parenthesized_expression",
         "has": {
          "matches": "bound-function",
          "stopBy": "neighbor"
         }
        },
        {
         "kind": "arrow_function"
        },
        {
         "any": [
          {
           "kind": "function_expression"
          },
          {
           "kind": "generator_function"
          }
         ],
         "not": {
          "has": {
           "kind": "this",
           "stopBy": {
            "matches": "own-this-boundary"
           }
          }
         }
        }
       ]
      },
      "bind-member": {
       "any": [
        {
         "kind": "member_expression",
         "all": [
          {
           "has": {
            "matches": "bound-function",
            "pattern": "$OBJ",
            "stopBy": "neighbor"
           }
          },
          {
           "has": {
            "kind": "property_identifier",
            "regex": "^bind$",
            "pattern": "$PROP",
            "stopBy": "neighbor"
           }
          }
         ]
        },
        {
         "kind": "subscript_expression",
         "all": [
          {
           "has": {
            "matches": "bound-function",
            "pattern": "$OBJ",
            "stopBy": "neighbor"
           }
          },
          {
           "has": {
            "any": [
             {
              "kind": "string"
             },
             {
              "kind": "template_string",
              "not": {
               "has": {
                "kind": "template_substitution",
                "stopBy": "neighbor"
               }
              }
             }
            ],
            "pattern": "$PROP",
            "has": {
             "kind": "string_fragment",
             "regex": "^bind$",
             "stopBy": "neighbor"
            },
            "stopBy": "neighbor"
           }
          }
         ]
        }
       ]
      },
      "single-argument": {
       "kind": "arguments",
       "all": [
        {
         "has": {
          "not": {
           "any": [
            {
             "kind": "comment"
            },
            {
             "regex": "^[(),]$"
            }
           ]
          },
          "pattern": "$ARG",
          "stopBy": "neighbor"
         }
        },
        {
         "count": {
          "has": {
           "not": {
            "any": [
             {
              "kind": "comment"
             },
             {
              "regex": "^[(),]$"
             }
            ]
           },
           "stopBy": "neighbor"
          },
          "max": 1
         }
        },
        {
         "not": {
          "has": {
           "kind": "spread_element",
           "stopBy": "neighbor"
          }
         }
        }
       ]
      },
      "side-effect-free": {
       "any": [
        {
         "kind": "number"
        },
        {
         "kind": "string"
        },
        {
         "kind": "true"
        },
        {
         "kind": "false"
        },
        {
         "kind": "null"
        },
        {
         "kind": "regex"
        },
        {
         "kind": "identifier"
        },
        {
         "kind": "undefined"
        },
        {
         "kind": "this"
        },
        {
         "kind": "function_expression"
        }
       ]
      },
      "commented": {
       "has": {
        "kind": "comment",
        "stopBy": "end"
       }
      }
     },
     "rule": {
      "kind": "call_expression",
      "all": [
       {
        "has": {
         "matches": "bind-member",
         "stopBy": "neighbor"
        }
       },
       {
        "has": {
         "matches": "single-argument",
         "stopBy": "neighbor"
        }
       },
       {
        "has": {
         "kind": "arguments",
         "has": {
          "not": {
           "any": [
            {
             "kind": "comment"
            },
            {
             "regex": "^[(),]$"
            }
           ]
          },
          "matches": "side-effect-free",
          "stopBy": "neighbor"
         },
         "stopBy": "neighbor"
        }
       },
       {
        "not": {
         "matches": "commented"
        }
       }
      ]
     }
    }
   },
   "violation": {
    "anchor": "capture.PROP",
    "code": "no-extra-bind",
    "message": "Remove this .bind() call; the function is an arrow or never uses this, so binding changes nothing.",
    "fix": "$OBJ",
    "suppress": {
     "eslint": {
      "rules": [
       "no-extra-bind"
      ]
     },
     "oxlint": {
      "rules": [
       "no-extra-bind"
      ]
     }
    }
   }
  },
