  "match": {
    "any": [
      {
        "files": [
          "**/*.js",
          "**/*.jsx",
          "**/*.mjs",
          "**/*.cjs"
        ],
        "exclude": [
          "**/test/**",
          "**/tests/**",
          "**/__tests__/**",
          "**/__mocks__/**",
          "**/spec/**",
          "**/e2e/**",
          "**/*.test.*",
          "**/*.spec.*",
          "**/scripts/**",
          "**/*.config.*",
          "**/.*rc.*",
          "**/gulpfile.*",
          "**/Gulpfile.*",
          "**/Gruntfile.*",
          "**/*.min.js"
        ],
        "label": "JavaScript source files"
      },
      {
        "files": [
          "**/*.ts",
          "**/*.tsx",
          "**/*.mts",
          "**/*.cts"
        ],
        "exclude": [
          "**/*.d.ts",
          "**/test/**",
          "**/tests/**",
          "**/__tests__/**",
          "**/__mocks__/**",
          "**/spec/**",
          "**/e2e/**",
