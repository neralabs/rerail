{
  "format": "rerail.rule-pack/v1",
  "id": "javascript",
  "name": "JavaScript and TypeScript (ESLint core)",
  "category": "language",
  "covers": "ESLint's core rules for sound, consistent JavaScript and TypeScript.",
  "reason": "matches JavaScript or TypeScript source",
  "match": {
    "any": [
      {
        "files": [
          "**/*.js",
          "**/*.jsx",
          "**/*.mjs",
          "**/*.cjs"
        ],
        "exclude": [
          "**/test/**",
          "**/tests/**",
          "**/__tests__/**",
          "**/__mocks__/**",
          "**/spec/**",
          "**/e2e/**",
          "**/*.test.*",
          "**/*.spec.*",
          "**/scripts/**",
          "**/*.config.*",
          "**/.*rc.*",
          "**/gulpfile.*",
          "**/Gulpfile.*",
          "**/Gruntfile.*",
          "**/*.min.js"
        ],
        "label": "JavaScript source files"
      },
      {
        "files": [
          "**/*.ts",
          "**/*.tsx",
          "**/*.mts",
          "**/*.cts"
        ],
        "exclude": [
          "**/*.d.ts",
          "**/test/**",
          "**/tests/**",
          "**/__tests__/**",
          "**/__mocks__/**",
          "**/spec/**",
          "**/e2e/**",
          "**/*.test.*",
          "**/*.spec.*",
          "**/scripts/**",
          "**/*.config.*",
          "**/.*rc.*",
          "**/gulpfile.*",
          "**/Gulpfile.*",
          "**/Gruntfile.*"
        ],
        "label": "TypeScript source files"
      }
    ]
  },
  "rules": [
    {
      "id": "eslint-arrow-body-style",
      "document": "rules/eslint-arrow-body-style.json",
      "title": "ESLint arrow-body-style: Require braces around arrow function bodies",
      "group": "ESLint",
      "on": false
    },
    {
      "id": "eslint-capitalized-comments",
      "document": "rules/eslint-capitalized-comments.json",
      "title": "ESLint capitalized-comments: Enforce or disallow capitalization of the first letter of a comment",
      "group": "ESLint",
      "on": false
    },
    {
      "id": "eslint-curly",
      "document": "rules/eslint-curly.json",
      "title": "ESLint curly: Enforce consistent brace style for all control statements",
      "group": "ESLint",
      "on": false
    },
    {
