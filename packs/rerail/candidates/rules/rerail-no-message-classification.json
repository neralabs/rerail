{
  "format": "rerail.policy/v1",
  "id": "rerail-no-message-classification",
  "revision": 1,
  "mode": "log",
  "description": "Classify a failure by its code or a shared constant, not by another Rerail component's message wording, in TypeScript and Rust; build steer notices from structured rule data.",
  "scope": {
    "include": [
      "src/**/*.ts",
      "native/src/**/*.rs"
    ],
    "exclude": [
      "**/*.test.ts",
      "src/**/*.generated.ts",
      "native/src/**/tests/**",
      "native/src/**/*tests.rs",
      "native/src/**/test_support.rs",
      "src/runtime/npm.ts",
      "src/setup/rule-pack-store.ts"
    ]
  },
  "clauses": [
    {
      "id": "message-text-test",
      "forbid": {
        "ast": {
          "language": "typescript",
          "utils": {
            "message-text": {
              "any": [
                {
                  "kind": "member_expression",
                  "regex": "\\??\\.message$"
                },
                {
                  "kind": "identifier",
                  "regex": "^(?:message|errorMessage|msg)$"
                },
                {
                  "kind": "call_expression",
                  "regex": "^(?:errorText|errorMessage|messageOf)\\("
                },
                {
                  "kind": "call_expression",
                  "regex": "^String\\((?:error|err|e|cause|reason)\\)$"
                },
                {
                  "kind": "call_expression",
                  "regex": "^(?:error|err|e|cause)\\??\\.toString\\(\\)$"
                },
                {
                  "kind": "call_expression",
                  "regex": "(?:\\.message|^message|^msg)\\??\\.(?:toLowerCase|toUpperCase|toLocaleLowerCase|trim|trimStart|trimEnd)\\(\\)$"
                }
              ]
            },
            "wording": {
              "any": [
                {
                  "kind": "string",
                  "regex": "^.[^\\n]*[A-Za-z]{3}[^\\n]*.$"
                },
                {
                  "kind": "template_string",
                  "regex": "[A-Za-z]{3}",
                  "not": {
                    "regex": "^`\\$\\{"
                  }
                },
                {
                  "kind": "regex",
                  "regex": "[A-Za-z]{3}"
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "value": {
                        "any": [
                          {
                            "kind": "string",
                            "regex": "^.[^\\n]*[A-Za-z]{3}[^\\n]*.$"
                          },
                          {
                            "kind": "template_string",
                            "regex": "[A-Za-z]{3}",
                            "not": {
                              "regex": "^`\\$\\{"
                            }
                          },
                          {
                            "kind": "regex",
                            "regex": "[A-Za-z]{3}"
                          }
                        ]
                      },
                      "exported": false
                    }
                  },
                  "not": {
                    "resolves": {
                      "binding": {
                        "occurrence": {
                          "inside": {
                            "stopBy": "end",
                            "any": [
                              {
                                "kind": "new_expression"
                              },
                              {
                                "kind": "throw_statement"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "any": [
              {
                "pattern": "$M.$F($A)"
              },
              {
                "pattern": "$M?.$F($A)"
              }
            ]
          },
          "constraints": {
            "M": {
              "matches": "message-text"
            },
            "F": {
              "regex": "^(?:startsWith|endsWith|includes|indexOf|lastIndexOf|match|matchAll|search)$"
            },
            "A": {
              "matches": "wording"
            }
          }
        }
      },
      "violation": {
        "code": "MESSAGE_TEXT_TEST",
        "anchor": "witness.span",
        "message": "Branch on the failure's code, adding one where the failure is written, not on this wording; a constant counts only when the writer uses it too. A person's or another program's text may be matched."
      }
    },
    {
