{
  "format": "rerail.policy/v1",
  "id": "rerail-message-shouting",
  "revision": 1,
  "mode": "steer",
  "description": "Write NEVER, MUST and ALWAYS in lower case in rule pack messages; SQL keywords and quoted code may stay in capitals.",
  "scope": {
    "include": [
      "packs/*/rules/*.json",
      "packs/*/candidates/rules/*.json"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shouting",
      "forbid": {
        "regex": {
          "source": "file.content",
          "pattern": "\"violation\"\\s*:\\s*(?:\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\\})*\\})*\\})*\\})*\\})*\\})*?)+?\"message\"\\s*:\\s*(?:(?:\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\\})*\\})*\\})*\\})*\\})*\\})*?)*?\\{(?:(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\{(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\")*\\})*\\})*\\})*\\})*\\})*\\})*\\})*?,)?\\s*\"(?:(?:[^$\"\\\\]|\\\\.)(?:[^\"\\\\]|\\\\.)*)?\"\\s*:\\s*)?\"(?:'(?:[^'\"\\\\]|\\\\.)*'[^\"\\\\`'\\w$])*(?:\\w+(?:'\\w+)*|[^\"\\\\`'\\w$](?:'(?:[^'\"\\\\]|\\\\.)*'[^\"\\\\`'\\w$])*|\\$+(?:\\w+|\\{[^{}\"\\\\]*\\}|[^\"\\\\`'\\w${])|\\\\.|`(?:[^`\"\\\\]|\\\\.)+`)*?\\b(?P<HIT>NEVER|MUST|ALWAYS)(?:\\s+NOT)?\\s+[a-z`]"
        }
      },
      "violation": {
        "code": "MESSAGE_SHOUTS",
        "anchor": "capture.HIT",
        "message": "Write `$HIT` in lower case and state the instruction plainly."
      }
    }
  ]
}
