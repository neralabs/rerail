{
  "format": "rerail.policy/v1",
  "id": "rerail-ui-color-tokens",
  "revision": 1,
  "mode": "steer",
  "description": "Use Nera's design tokens for dashboard colours instead of raw colour values, and don't redefine a Nera token outside its generated sheet.",
  "scope": {
    "include": [
      "ui/**/*.css",
      "ui/**/*.js",
      "ui/**/*.mjs",
      "ui/**/*.html"
    ],
    "exclude": [
      "ui/tokens.generated.css"
    ]
  },
  "clauses": [
    {
      "id": "raw-hex",
      "forbid": {
        "regex": {
          "pattern": "(?m)^[ \\t]*(?:(?:(?:[^\\s/*<]|\\*[^\\s/\\n]|\\*[ \\t]+\\{|<[^!\\n]|/\\*(?:[^*\\n]|\\*[^/\\n])*\\*/)(?:[^\\n/<]|/[^/*\\n]|://|<[^!\\n]|/\\*(?:[^*\\n]|\\*[^/\\n])*\\*/)*?)?[^&0-9A-Za-z_\\n-])?(?P<colour>#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4}))(?:[^0-9A-Za-z_-]|$)",
          "source": "file.content"
        }
      },
      "violation": {
        "code": "UI_RAW_HEX_COLOUR",
        "anchor": "capture.colour",
        "message": "Use a Nera token or a base.css page-local token built from Nera tokens (var(), color-mix(); getComputedStyle in a canvas) for $colour. Leave it if it is an id, fragment or private field."
      }
    },
    {
      "id": "raw-hex-in-data-uri",
      "forbid": {
        "regex": {
          "pattern": "(?P<colour>%23(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?:[^0-9A-Za-z_-]|$))",
          "source": "file.content"
        }
      },
      "violation": {
        "code": "UI_RAW_COLOUR_IN_DATA_URI",
        "anchor": "capture.colour",
        "message": "A data: image can't read the page's tokens: draw this icon as inline SVG with currentColor, or as a mask-image over a background from a Nera token."
      }
    },
