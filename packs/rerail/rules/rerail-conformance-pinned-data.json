{
  "format": "rerail.policy/v1",
  "id": "rerail-conformance-pinned-data",
  "revision": 1,
  "mode": "log",
  "description": "Read only pinned test data and samples in conformance; avoid network calls and programs that download or install.",
  "scope": {
    "include": [
      "conformance/**/*.ts",
      "conformance/**/*.mts",
      "conformance/**/*.cts",
      "conformance/**/*.tsx",
      "conformance/**/*.js",
      "conformance/**/*.mjs",
      "conformance/**/*.cjs",
      "conformance/**/*.jsx"
    ],
    "exclude": [
      "conformance/process.ts",
      "conformance/**/*.generated.ts"
    ]
  },
  "clauses": [
    {
      "id": "network-call",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "call_expression",
                "regex": "^(?:[\\w$]+\\.)?fetch\\s*\\("
              },
              {
                "kind": "call_expression",
                "regex": "^(?:https?|http2)\\s*\\.\\s*(?:get|request)\\s*\\("
              }
            ]
          }
        }
      },
      "violation": {
        "code": "NETWORK_IN_CONFORMANCE",
        "anchor": "witness.span",
        "message": "Conformance reads only pinned data, through scripts/s3/pack-fixtures.mjs. Code that must reach the network (release checks, recording, installs) belongs in scripts/upstream/ or scripts/pack-data/."
      }
    },
    {
      "id": "network-module",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "kind": "string",
                  "regex": "^[\\\"'](?:(?:node:)?(?:https?|http2|net|tls|dgram)|undici|node-fetch|axios|got|cross-fetch|@octokit/[^\\\"'`]+)[\\\"']$",
                  "stopBy": "end"
                }
              },
              {
                "kind": "export_statement",
                "has": {
                  "kind": "string",
                  "regex": "^[\\\"'](?:(?:node:)?(?:https?|http2|net|tls|dgram)|undici|node-fetch|axios|got|cross-fetch|@octokit/[^\\\"'`]+)[\\\"']$",
                  "field": "source"
                }
              },
              {
                "kind": "call_expression",
                "regex": "^(?:require|import|module\\.require|process\\.getBuiltinModule)\\s*\\(",
                "has": {
                  "kind": "arguments",
                  "has": {
                    "any": [
                      {
                        "kind": "string",
                        "regex": "^[\\\"'](?:(?:node:)?(?:https?|http2|net|tls|dgram)|undici|node-fetch|axios|got|cross-fetch|@octokit/[^\\\"'`]+)[\\\"']$"
                      },
                      {
                        "kind": "template_string",
                        "regex": "^`(?:(?:node:)?(?:https?|http2|net|tls|dgram)|undici|node-fetch|axios|got|cross-fetch|@octokit/[^\\\"'`]+)`$"
                      }
                    ]
                  }
                }
              }
            ],
            "not": {
              "any": [
                {
                  "regex": "^(?:import|export)\\s+type\\b"
                },
                {
                  "inside": {
                    "kind": "type_query",
                    "stopBy": "end"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "code": "NETWORK_MODULE_IN_CONFORMANCE",
        "anchor": "witness.span",
        "message": "Conformance reads only pinned data, through scripts/s3/pack-fixtures.mjs. Code that must reach the network (release checks, recording, installs) belongs in scripts/upstream/ or scripts/pack-data/."
      }
    },
    {
      "id": "download-program",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "array",
                "regex": "^\\[\\s*[\\\"'`](?:aws|curl|wget|gh|gsutil|az)[\\\"'`]\\s*,\\s*(?:[\\\"'`]|\\.\\.\\.)",
                "not": {
                  "regex": "^\\[\\s*(?:[\\\"'`](?:aws|curl|wget|gh|gsutil|az)[\\\"'`]\\s*,?\\s*)+\\]$"
                }
              },
              {
                "kind": "array",
                "regex": "^\\[\\s*[\\\"'`]git[\\\"'`]\\s*,(?:[^\\]]*,)?\\s*[\\\"'`](?:clone|ls-remote)[\\\"'`]"
              },
              {
                "kind": "array",
                "regex": "^\\[\\s*[\\\"'`](?:npm|pnpm|yarn|uv|pip|pip3|composer|cargo)[\\\"'`]\\s*,\\s*[\\\"'`](?:install|ci|add|sync|update|require|download|fetch)[\\\"'`]"
              },
              {
                "kind": "arguments",
                "regex": "^\\(\\s*[\\\"'`]remote[\\\"'`]\\s*,\\s*[\\\"'`]add[\\\"'`]"
              },
              {
                "kind": "arguments",
                "regex": "^\\(\\s*[\\\"'`](?:aws|curl|wget|gh|gsutil|az)\\b",
                "inside": {
                  "kind": "call_expression",
                  "regex": "^(?:[\\w$]+\\.)*(?:execFile|execFileSync|spawn|spawnSync|exec|execSync)\\s*\\("
                }
              }
            ]
          }
        }
      },
      "violation": {
        "code": "DOWNLOAD_PROGRAM_IN_CONFORMANCE",
        "anchor": "witness.span",
        "message": "Conformance reads only pinned data, through scripts/s3/pack-fixtures.mjs. Code that must reach the network (release checks, recording, installs) belongs in scripts/upstream/ or scripts/pack-data/."
      }
    }
  ]
}
