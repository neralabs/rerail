      "violation": {
        "code": "MESSAGE_NAMES_RERAIL",
        "anchor": "capture.HIT",
        "message": "Write \"this rule\" for `$HIT` where the message says what was checked, and otherwise leave it out: the block around the message names it. It may stay inside quoted code, such as `rerail-ignore`."
