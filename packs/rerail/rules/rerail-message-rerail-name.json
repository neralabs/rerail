{
  "format": "rerail.policy/v1",
  "id": "rerail-message-rerail-name",
  "revision": 1,
  "mode": "steer",
  "description": "Leave the name Rerail out of rule pack messages, since the block around each one already shows it; quoted code may hold it.",
