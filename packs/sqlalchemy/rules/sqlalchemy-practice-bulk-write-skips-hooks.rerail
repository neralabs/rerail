.policy "sqlalchemy-practice-bulk-write-skips-hooks" revision 1
.description "Avoid bulk UPDATE, DELETE or INSERT statements on a model whose mapper events, attribute events or validators they skip; run that work or change the objects through the session."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. SQLAlchemy's ORM-enabled `update(M)`/`delete(M)`/`insert(M)` statements run through
// `session.execute(...)`, the same on the model's own table (`update(M.__table__)`), the legacy
// `Query.update()`/`Query.delete()`, `bulk_insert_mappings`, `bulk_update_mappings` and `bulk_save_objects` write
// rows past the unit of work: no mapper event (before_/after_ insert, update, delete) fires, and neither do attribute
// `set` events nor `@validates` methods. The model is resolved, not guessed from a name: the class through imports,
// `M.__table__`, or `self.model` where the method's class or a subclass binds `model = M`; the statement inline, in
// a name, or returned by a function of the run (`session.execute(build_update(new))`). A write is reported when its
// model has such a hook for the operation, in any non-test file of the run:
//   - a mapper event for that operation, `@event.listens_for(M, "after_update")` or `event.listen(M, ...)`, on M, on a
//     base class of M in the run with `propagate=True`, or `event.listen(cls, ...)` in a base's or M's own
//     `__declare_last__`/`__declare_first__` (which runs once per mapped subclass);
//   - for an update or insert, a `set` event on `M.<col>` or a `@validates("<col>")` method of M or its bases, for a
//     column the write sets: `.values(col=...)`, `.values({"col": ...})`, `.values({M.col: ...})`, the
//     `Query.update({...})` dict; any column when the values cannot be read (`insert(M), rows`, `.values(**d)`,
//     `bulk_*_mappings(M, rows)`). `bulk_save_objects([M(...) ...])` builds the objects first, so their validators and
//     set events ran: only its insert mapper events count.
// The message names each skipped hook and where it is registered.
//   session.execute(update(Item).values(label=x))    reported when Item has an after_update listener
//   session.execute(update(Tag).values(name=x))      reported when Tag has @validates("name")
//   session.execute(update(Tag).values(color=x))     not reported: the validator is for name only
//   session.execute(delete(Tag))                     not reported: a validator is not a delete hook
//   session.execute(update(Item).values(label=x, updated_at=now()))
//                                                    not reported when Item's only hook sets target.updated_at
// Left alone: a hook the write makes up for, read from the listener's code: a listener whose only effect is
// assigning columns of its target (`target.updated_at = now()`, under ifs too) when the write sets every one of them;
// a mapper listener that never reads its target (a cache clear) when the same function later changes, adds or
// deletes an instance of the model through the session for an operation the listener is registered for, so the flush
// runs it anyway. A write inside one of the model's own hooks (the listener, a method the listener names such as
// `event.listen(M, "before_update", M.before_update)`, a validator); a model whose events a session-level
// `do_orm_execute` listener handles: one that reads `is_update`/`is_delete`/`is_insert` and names the model, or names
// no model at all; tests, and Alembic revisions (they run once, on purpose).
// Gaps: a model held in an instance attribute set at run time (`self.model = model`, mealie's generic repository);
// a hook whose work the data makes moot (a write on rows the listener would leave alone); a listener on a base
// without `propagate=True` is treated as not applying to subclasses; `event.listen(Mapper, ...)` for every mapper; a
// do_orm_execute listener that delegates to helpers; hooks registered on a variable target.
// The write, its model and its hooks sit in different files (the model in models/, its listeners in events/, a
// builder that returns the statement elsewhere), so the rule joins them by symbol (decisions 0652, 0677): each file
// states its writes by their terms (python/points-to's pt_tm: `wk`), its registrations and listener defs by their
// terms and symbols (`ak`, `fq`), its DML chains by theirs (`dk`), its models by qualified name, and the symbol
// relations below join them. The output finds the write's node by its term.

#include "lib/sqlalchemy.rerail"

.violation BulkWriteSkipsHooks(at: node, what: symbol, model: symbol, hooks: symbol) "`{what}` skips {model}'s {hooks}. Do that work here too, or change the rows through the session; leave it when skipping them is deliberate."

BulkWriteSkipsHooks(c, w, mn, hs) :- bw_call(c, wk), bw_write_q(wk, k, mq, w), sa_mapped_q(mq), split_dot(mq, _, mn),
    !bw_in_hook_q(wk, mq), !bw_rerun_q(k, mq), docof(c, d), !sa_test_doc(d), !sa_migration_doc(d),
    hs = join h by h sep "; " : { bw_skipped_q(wk, h) }, hs != "".

// ---- the writes ----------------------------------------------------------------------------------------------------
// bw_call(c, wk): call c may write in bulk (`….execute(...)`, `….update(...)`/`.delete()`, `bulk_*_mappings(...)`,
// `bulk_save_objects(...)`); wk is its term.
.decl bw_call(c: node, wk: symbol)
bw_call(c, wk) :- sa_exec_q(c, wk).
bw_call(c, wk) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, m), bw_write_method(m), pt_tm(c, wk).
.decl bw_write_method(m: symbol)
bw_write_method("update"). bw_write_method("delete"). bw_write_method("bulk_insert_mappings").
bw_write_method("bulk_update_mappings"). bw_write_method("bulk_save_objects").
// bw_write_q(wk, k, mq, w): call wk writes rows of model mq past the unit of work, operation k ("insert", "update",
// "delete"); w names the write in the message. The statement an execute runs, and the model a generic repository's
// `self.model` names, are lib's, across files (sa_exec_stmt_q, sa_model_of).
.decl bw_write_q(wk: symbol, k: symbol, mq: symbol, w: symbol)
bw_write_q(wk, k, mq, w) :- sa_exec_stmt_q(wk, dk), sa_dml_q(dk, k, mr), (k = "insert" ; k = "update" ; k = "delete"),
    sa_model_of(mr, mq), split_dot(mq, _, n), w = cat(k, "(", n, ")").
bw_write_q(wk, k, mq, w) :- sa_bulk_local_q(wk, k, mr), (k = "update" ; k = "delete"), sa_model_of(mr, mq),
    w = cat("Query.", k, "()").
bw_write_q(wk, "insert", mq, "bulk_insert_mappings()") :- sa_bulk_local_q(wk, "bulk_insert_mappings", mr),
    sa_model_of(mr, mq).
bw_write_q(wk, "update", mq, "bulk_update_mappings()") :- sa_bulk_local_q(wk, "bulk_update_mappings", mr),
    sa_model_of(mr, mq).
bw_write_q(wk, "insert", mq, "bulk_save_objects()") :- bw_objects_q(wk, mq), sa_model_q(mq).

// bw_objects(c, mq): `session.bulk_save_objects(objs)` where objs are new instances of mq: a list comprehension or a
// list of `M(...)` calls, or a name the same scope binds to one.
.decl bw_objects(c: node, mq: symbol)
bw_objects(c, mq) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, "bulk_save_objects"), posarg(c, 0, a),
    bw_new_objects(a, mq).
.decl bw_new_objects(a: node, mq: symbol)
bw_new_objects(a, mq) :- unparen(a, e), kind(e, "list_comprehension"), field(e, "body", b), unparen(b, k),
    kind(k, "call"), field(k, "function", kf), sym_of(kf, mq).
bw_new_objects(a, mq) :- unparen(a, e), kind(e, "list"), child(e, b, _), unparen(b, k), kind(k, "call"),
    field(k, "function", kf), sym_of(kf, mq).
bw_new_objects(a, mq) :- unparen(a, e), kind(e, "identifier"), text(e, x), look(e, x, sc), asg(sc, x, v, _),
    bw_new_objects(v, mq).
.decl bw_objects_q(wk: symbol, mq: symbol)
bw_objects_q(wk, mq) :- bw_objects(c, mq), pt_tm(c, wk).
.decl bw_objects_any_q(wk: symbol)
bw_objects_any_q(wk) :- bw_objects_q(wk, mq), sa_model_q(mq).

// ---- the columns a write sets --------------------------------------------------------------------------------------
// Of a DML chain (its file states them by the chain's term dk): bw_dml_sets_q(dk, x), a `.values(...)` call on it sets
// column x; bw_dml_unknown_q(dk), its columns cannot all be read; bw_dml_values_q(dk), it has a `.values(...)` call.
// bw_chain(s, k): k is a call along DML chain s (s itself included).
.decl bw_chain(s: node, k: node)
bw_chain(s, k) :- sa_dml(s, _, _), unparen(s, k), kind(k, "call").
bw_chain(s, k) :- bw_chain(s, e), field(e, "function", f), attr_of(f, o, _), unparen(o, k), kind(k, "call").
// bw_values_call(s, k): k is a `.values(...)` call along s.
.decl bw_values_call(s: node, k: node)
bw_values_call(s, k) :- bw_chain(s, k), field(k, "function", f), attr_of(f, _, "values").
.decl bw_dml_sets_q(dk: symbol, x: symbol)
bw_dml_sets_q(dk, x) :- bw_values_call(s, k), field(k, "arguments", al), child(al, a, _), kind(a, "keyword_argument"),
    field(a, "name", n), text(n, x), pt_tm(s, dk).
bw_dml_sets_q(dk, x) :- bw_values_call(s, k), call_arg(k, _, "", a), bw_dict_sets(a, x), pt_tm(s, dk).
.decl bw_dml_unknown_q(dk: symbol)
// a positional values argument that is not a dict whose keys all read (a name, a splat in the dict), or a
// `*rows`/`**d` argument
bw_dml_unknown_q(dk) :- bw_values_call(s, k), call_arg(k, _, "", a), !kind(a, "comment"), !bw_plain_dict(a),
    pt_tm(s, dk).
bw_dml_unknown_q(dk) :- bw_values_call(s, k), field(k, "arguments", al), child(al, a, _),
    (kind(a, "dictionary_splat") ; kind(a, "list_splat")), pt_tm(s, dk).
// an upsert's update part, or a SELECT feeding the insert
bw_dml_unknown_q(dk) :- bw_chain(s, k), field(k, "function", f), attr_of(f, _, m),
    (m = "on_conflict_do_update" ; m = "on_duplicate_key_update" ; m = "from_select"), pt_tm(s, dk).
.decl bw_dml_values_q(dk: symbol)
bw_dml_values_q(dk) :- bw_values_call(s, _), pt_tm(s, dk).
// Of a write call (its own file): bw_qupdate(c), it is `Query.update(...)`; bw_call_sets_q(wk, x), its values dict
// sets x; bw_call_unknown_q(wk), its values cannot be read (`Query.update(...)` with no dict of plain keys, or no
// values argument; `session.execute(stmt, rows)`).
.decl bw_qupdate(c: node)
bw_qupdate(c) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, "update"), sa_query_of(o, _).
.decl bw_call_sets_q(wk: symbol, x: symbol)
bw_call_sets_q(wk, x) :- bw_qupdate(c), posarg(c, 0, a), bw_dict_sets(a, x), pt_tm(c, wk).
.decl bw_call_unknown_q(wk: symbol)
bw_call_unknown_q(wk) :- bw_qupdate(c), posarg(c, 0, a), !kind(a, "comment"), !bw_plain_dict(a), pt_tm(c, wk).
bw_call_unknown_q(wk) :- bw_qupdate(c), !posarg(c, 0, _), pt_tm(c, wk).
bw_call_unknown_q(wk) :- sa_exec_q(c, wk), posarg(c, 1, _).
// bw_dict_sets(a, x): a is a dict literal with key x (a string, or `M.x`).
.decl bw_dict_sets(a: node, x: symbol)
bw_dict_sets(a, x) :- unparen(a, dd), kind(dd, "dictionary"), child(dd, p, _), kind(p, "pair"), field(p, "key", kk),
    bw_key(kk, x).
.decl bw_key(kk: node, x: symbol)
bw_key(kk, x) :- str(kk, x).
bw_key(kk, x) :- unparen(kk, e), attr_of(e, _, x).
// bw_plain_dict(a): a dict literal whose every entry is a pair with a string or attribute key.
.decl bw_plain_dict(a: node)
bw_plain_dict(a) :- unparen(a, dd), kind(dd, "dictionary"), !bw_odd_entry(dd).
.decl bw_odd_entry(dd: node)
bw_odd_entry(dd) :- kind(dd, "dictionary"), child(dd, p, _), !kind(p, "pair"), !kind(p, "comment"),
    !kind(p, "{"), !kind(p, "}"), !kind(p, ",").
bw_odd_entry(dd) :- kind(dd, "dictionary"), child(dd, p, _), kind(p, "pair"), field(p, "key", kk), !bw_key(kk, _).
// bw_sets_q(wk, x): write wk sets column x, read from its values.
.decl bw_sets_q(wk: symbol, x: symbol)
bw_sets_q(wk, x) :- bw_call_sets_q(wk, x).
bw_sets_q(wk, x) :- sa_exec_stmt_q(wk, dk), bw_dml_sets_q(dk, x).
// bw_cols_unknown_q(wk): the columns wk sets cannot all be read, so every column counts.
.decl bw_cols_unknown_q(wk: symbol)
bw_cols_unknown_q(wk) :- bw_call_unknown_q(wk).
bw_cols_unknown_q(wk) :- sa_exec_stmt_q(wk, dk), bw_dml_unknown_q(dk).
// mappings
bw_cols_unknown_q(wk) :- bw_write_q(wk, _, _, w), (w = "bulk_insert_mappings()" ; w = "bulk_update_mappings()").
// an execute write with no `.values(...)` (an insert or update whose rows come from elsewhere)
bw_cols_unknown_q(wk) :- bw_write_q(wk, k, _, _), k != "delete", sa_exec_stmt_q(wk, _), !bw_has_values_q(wk).
.decl bw_has_values_q(wk: symbol)
bw_has_values_q(wk) :- sa_exec_stmt_q(wk, dk), bw_dml_values_q(dk).

// ---- the hooks -----------------------------------------------------------------------------------------------------
// bw_skipped_q(wk, h): h describes a hook write wk skips, and that the write does not make up for.
.decl bw_skipped_q(wk: symbol, h: symbol)
bw_skipped_q(wk, h) :- bw_write_q(wk, k, mq, _), bw_hook_q(mq, k, "", ak, h), !bw_done_q(wk, ak), !bw_redone_q(wk, ak).
bw_skipped_q(wk, h) :- bw_write_q(wk, k, mq, _), (k = "insert" ; k = "update"), !bw_objects_any_q(wk),
    bw_hook_q(mq, k, x, ak, h), x != "", (bw_cols_unknown_q(wk) ; bw_sets_q(wk, x)), !bw_done_q(wk, ak).

// ---- writes that do a hook's work themselves ------------------------------------------------------------------------
// bw_done_q(wk, ak): the listener registered at ak only assigns columns of its target (`target.updated_at = now()`,
// maybe under an if), and write wk sets every one of them: the write does the listener's work.
.decl bw_done_q(wk: symbol, ak: symbol)
bw_done_q(wk, ak) :- bw_write_q(wk, k, mq, _), bw_hook_at_q(mq, k, _, ak, _), bw_listener_q(ak, fq), bw_reg_q(ak, ev),
    bw_ev_param(ev, i), bw_assigns_only_q(fq, i), !bw_cols_unknown_q(wk),
    count : { bw_assigned_q(fq, i, x), !bw_sets_q(wk, x) } = 0.
// bw_ev_param(ev, i): a listener for event ev receives the instance as its parameter i: a mapper event's third
// (mapper, connection, target), an attribute event's first (target, value, oldvalue, initiator).
.decl bw_ev_param(ev: symbol, i: number)
bw_ev_param(ev, 2) :- bw_mapper_ev(ev, _).
bw_ev_param("set", 0).
// What a def f does with its parameter t at position i (0 or 2, where an event hands it the instance), stated in f's
// file by its symbol: bw_assigned_q(f, i, x), f assigns `t.x = ...` (or `t.x += ...`); bw_assigns_only_q(f, i), that
// is all it does; bw_reads_q(f, i), its body mentions t; bw_lparam_q(f, i), it has such a parameter.
.decl bw_lparam(f: node, i: number, t: symbol)
bw_lparam(f, i, t) :- kind(f, "function_definition"), sig_param(f, _, nm, i, _, _, _), (i = 0 ; i = 2), text(nm, t).
.decl bw_lparam_q(fq: symbol, i: number)
bw_lparam_q(fq, i) :- bw_lparam(f, i, _), pt_def(f, fq).
.decl bw_assigned(f: node, t: symbol, x: symbol)
bw_assigned(f, t, x) :- bw_lparam(f, _, t), (kind(a, "assignment") ; kind(a, "augmented_assignment")),
    within_stop(a, f, sa_region_stop), field(a, "left", l), attr_of(l, o, x), kind(o, "identifier"), text(o, t).
.decl bw_assigned_q(fq: symbol, i: number, x: symbol)
bw_assigned_q(fq, i, x) :- bw_lparam(f, i, t), bw_assigned(f, t, x), pt_def(f, fq).
// bw_assigns_only(f, t): f assigns columns of t, and its other statements are local assignments, docstrings,
// control flow and returns: no call made for its effect, no raise, no write to anything else.
.decl bw_assigns_only(f: node, t: symbol)
bw_assigns_only(f, t) :- bw_assigned(f, t, _), !bw_other_effect(f, t).
.decl bw_assigns_only_q(fq: symbol, i: number)
bw_assigns_only_q(fq, i) :- bw_lparam(f, i, t), bw_assigns_only(f, t), pt_def(f, fq).
.decl bw_other_effect(f: node, t: symbol)
bw_other_effect(f, t) :- bw_listener_stmt(f, t, e), !kind(e, "string"), !bw_benign(e, t).
bw_other_effect(f, t) :- bw_assigned(f, t, _), within_stop(s, f, sa_region_stop),
    (kind(s, "raise_statement") ; kind(s, "with_statement") ; kind(s, "delete_statement") ;
     kind(s, "global_statement") ; kind(s, "nonlocal_statement")).
// bw_listener_stmt(f, t, e): e is the expression of an expression statement of listener f.
.decl bw_listener_stmt(f: node, t: symbol, e: node)
bw_listener_stmt(f, t, e) :- bw_assigned(f, t, _), kind(s, "expression_statement"), within_stop(s, f, sa_region_stop),
    child(s, e, 0).
// bw_benign(e, t): e assigns a local name or a column of t.
.decl bw_benign(e: node, t: symbol)
bw_benign(e, t) :- bw_listener_stmt(_, t, e), (kind(e, "assignment") ; kind(e, "augmented_assignment")),
    field(e, "left", l), kind(l, "identifier").
bw_benign(e, t) :- bw_listener_stmt(_, t, e), (kind(e, "assignment") ; kind(e, "augmented_assignment")),
    field(e, "left", l), attr_of(l, o, _), kind(o, "identifier"), text(o, t).
// bw_reads(f, t): f's body mentions its parameter t.
.decl bw_reads(f: node, t: symbol)
bw_reads(f, t) :- bw_lparam(f, _, t), kind(i, "identifier"), text(i, t), within(i, f), !sig_param(f, _, i, _, _, _, _).
.decl bw_reads_q(fq: symbol, i: number)
bw_reads_q(fq, i) :- bw_lparam(f, i, t), bw_reads(f, t), pt_def(f, fq).

// ---- hooks a later flush in the same function runs anyway ----------------------------------------------------------
// bw_redone_q(wk, ak): the mapper listener registered at ak never reads its target (it clears a cache, bumps a
// version), and the function of write wk later changes, adds or deletes an instance of the same model through the
// session, an operation the same listener is registered for: the flush runs it once, which is all it does.
.decl bw_redone_q(wk: symbol, ak: symbol)
bw_redone_q(wk, ak) :- bw_write_q(wk, k, mq, _), bw_hook_at_q(mq, k, "", ak, _), bw_listener_q(ak, fq),
    bw_reg_q(ak, ev), bw_ev_param(ev, i), bw_lparam_q(fq, i), !bw_reads_q(fq, i), bw_later_q(wk, mq, k2),
    bw_listener_q(ak2, fq), bw_reg_q(ak2, ev2), bw_mapper_ev(ev2, k2), bw_covers_q(ak2, mq).
// bw_later_q(wk, mq, k): after write call wk, in the same function, an instance of class mq is changed (`obj.col =
// v`: "update"), added (`session.add(M(...))`: "insert"; `session.add(obj)`/`merge(obj)` of a loaded one: "update")
// or deleted (`session.delete(obj)`: "delete"). Stated in the write's file.
.decl bw_later_q(wk: symbol, mq: symbol, k: symbol)
bw_later_q(wk, mq, "update") :- bw_call(c, wk), nearest(c, g, fdef), kind(a, "assignment"), nearest(a, g, fdef),
    field(a, "left", l), attr_of(l, o, _), sa_instance(o, mq), bw_after(a, c).
bw_later_q(wk, mq, k) :- bw_call(c, wk), nearest(c, g, fdef), kind(u, "call"), nearest(u, g, fdef),
    field(u, "function", uf), attr_of(uf, _, m), (m = "add" ; m = "merge"), posarg(u, 0, e), sa_instance(e, mq),
    bw_add_kind(e, mq, k), bw_after(u, c).
bw_later_q(wk, mq, "delete") :- bw_call(c, wk), nearest(c, g, fdef), kind(u, "call"), nearest(u, g, fdef),
    field(u, "function", uf), attr_of(uf, _, "delete"), posarg(u, 0, e), sa_instance(e, mq), bw_after(u, c).
.decl bw_add_kind(e: node, mq: symbol, k: symbol)
bw_add_kind(e, mq, "insert") :- sa_instance(e, mq), bw_new_instance(e, mq).
bw_add_kind(e, mq, "update") :- sa_instance(e, mq), !bw_new_instance(e, mq).
// bw_new_instance(e, mq): e is `M(...)`, or a name its scope binds to one.
.decl bw_new_instance(e: node, mq: symbol)
bw_new_instance(e, mq) :- unparen(e, k), kind(k, "call"), field(k, "function", f), sym_of(f, mq).
bw_new_instance(e, mq) :- unparen(e, n), kind(n, "identifier"), text(n, x), look(n, x, sc), asg(sc, x, v, _),
    bw_new_instance(v, mq).
.decl bw_after(a: node, c: node)
bw_after(a, c) :- node(d, a, _, as, _), node(d, c, _, cs, _), as > cs.

// ---- registrations -------------------------------------------------------------------------------------------------
// bw_reg(at, t, ev, a): at registers a listener for event ev on target t: `event.listen(t, "ev", a)` (a the
// listener argument) or `@event.listens_for(t, "ev")` (a the decorated def).
.decl bw_reg(at: node, t: node, ev: symbol, a: node)
bw_reg(at, t, ev, f) :- sa_event_call(at, t, ev), decorator(f, at).
bw_reg(at, t, ev, a) :- sa_event_call(at, t, ev), posarg(at, 2, a).
// bw_declare_cls(at, t, b): t, at's target, is `cls` and at sits in class b's `__declare_last__`/`__declare_first__`.
.decl bw_declare_cls(at: node, t: node, b: node)
bw_declare_cls(at, t, b) :- sa_event_call(at, t, _), unparen(t, i), kind(i, "identifier"), text(i, "cls"),
    within(at, f), kind(f, "function_definition"), def_name(f, fn), (fn = "__declare_last__" ; fn = "__declare_first__"),
    nearest(f, b, scope), kind(b, "class_definition").
// bw_listener_name(at, name): the listener a registration names, for the message.
.decl bw_listener_name(at: node, name: symbol)
bw_listener_name(at, n) :- bw_reg(at, _, _, f), kind(f, "function_definition"), def_name(f, n).
bw_listener_name(at, n) :- bw_reg(at, t, _, a), !kind(a, "function_definition"), !bw_declare_cls(at, t, _), text(a, n).
bw_listener_name(at, n) :- bw_reg(at, t, _, a), bw_declare_cls(at, t, b), def_name(b, bn), attr_of(a, o, m),
    text(o, "cls"), n = cat(bn, ".", m).
.decl bw_propagates(at: node)
bw_propagates(at) :- call_arg(at, -1, "propagate", v), unparen(v, t), kind(t, "true").
.decl bw_place(n: node, p: symbol)
bw_place(n, p) :- docof(n, d), doc(d, path, _), line(n, l), p = cat(path, ":", to_string(l)).
// What each file states about its registrations, by the registration's term ak: bw_reg_q(ak, ev), its event;
// bw_listener_q(ak, f), its listener def's symbol (the decorated def, or the name or `M.method` the call names,
// resolved by symbol, or `cls.method` in a `__declare_last__`); bw_lname_q(ak, n), bw_place_q(ak, p), its listener's
// name and its place for the message; bw_reg_target_q(ak, q), its target names q; bw_propagates_q(ak), it says
// `propagate=True`; bw_declare_q(ak, bq), its target is `cls` in class bq's `__declare_last__`; bw_reg_attr_q(ak, oq,
// x), its target is `O.x`, O naming oq; bw_live_q(ak), bw_nontest_q(ak), it is in no test or migration file, in no
// test file.
.decl bw_reg_q(ak: symbol, ev: symbol)
bw_reg_q(ak, ev) :- bw_reg(at, _, ev, _), pt_tm(at, ak).
.decl bw_listener_q(ak: symbol, f: symbol)
bw_listener_q(ak, fq) :- bw_reg(at, _, _, f), kind(f, "function_definition"), pt_def(f, fq), pt_tm(at, ak).
bw_listener_q(ak, q) :- bw_reg(at, _, _, a), !kind(a, "function_definition"), sym_of(a, q), pt_tm(at, ak).
bw_listener_q(ak, @dot(cq, m)) :- bw_reg(at, _, _, a), unparen(a, e), attr_of(e, o, m), sym_of(o, cq), pt_tm(at, ak).
bw_listener_q(ak, @dot(bq, m)) :- bw_reg(at, t, _, a), bw_declare_cls(at, t, b), unparen(a, e), attr_of(e, o, m),
    text(o, "cls"), class_def(b, bq), pt_tm(at, ak).
.decl bw_lname_q(ak: symbol, n: symbol)
bw_lname_q(ak, n) :- bw_listener_name(at, n), pt_tm(at, ak).
.decl bw_place_q(ak: symbol, p: symbol)
bw_place_q(ak, p) :- bw_reg(at, _, _, _), bw_place(at, p), pt_tm(at, ak).
.decl bw_reg_target_q(ak: symbol, q: symbol)
bw_reg_target_q(ak, q) :- bw_reg(at, t, _, _), sym_of(t, q), pt_tm(at, ak).
.decl bw_propagates_q(ak: symbol)
bw_propagates_q(ak) :- bw_reg(at, _, _, _), bw_propagates(at), pt_tm(at, ak).
.decl bw_declare_q(ak: symbol, bq: symbol)
bw_declare_q(ak, bq) :- bw_reg(at, t, _, _), bw_declare_cls(at, t, b), class_def(b, bq), pt_tm(at, ak).
.decl bw_reg_attr_q(ak: symbol, oq: symbol, x: symbol)
bw_reg_attr_q(ak, oq, x) :- bw_reg(at, t, "set", _), unparen(t, tt), attr_of(tt, o, x), sym_of(o, oq), pt_tm(at, ak).
.decl bw_live_q(ak: symbol)
bw_live_q(ak) :- bw_reg(at, _, _, _), docof(at, d), !sa_test_doc(d), !sa_migration_doc(d), pt_tm(at, ak).
bw_live_q(fq) :- bw_validator(_, f, _), docof(f, d), !sa_test_doc(d), !sa_migration_doc(d), pt_def(f, fq).
.decl bw_nontest_q(ak: symbol)
bw_nontest_q(ak) :- bw_reg(at, _, _, _), docof(at, d), !sa_test_doc(d), pt_tm(at, ak).
// bw_validator(b, f, x): method f of class b is `@validates("x", ...)` (sqlalchemy.orm.validates; b a model or a
// mixin). bw_validator_q(bq, f, x, h): by class bq and def symbol f, h its description.
.decl bw_validator(b: node, f: node, x: symbol)
bw_validator(b, f, x) :- decorator(f, e), kind(e, "call"), field(e, "function", vf), sym_of(vf, vq),
    (vq = "sqlalchemy.orm.validates" ; vq = "sqlalchemy.orm.mapper.validates"), call_arg(e, _, "", a), str(a, x),
    nearest(f, b, scope), kind(b, "class_definition").
.decl bw_validator_q(bq: symbol, f: symbol, x: symbol, h: symbol)
bw_validator_q(bq, fq, x, h) :- bw_validator(b, f, x), class_def(b, bq), def_name(b, bn), def_name(f, fn),
    bw_place(f, p), pt_def(f, fq), h = cat("validator `", bn, ".", fn, "` for ", x, " (", p, ")").

// ---- the hooks of a model, across files ----------------------------------------------------------------------------
// bw_mapper_ev(ev, k): mapper event ev runs for operation k.
.decl bw_mapper_ev(ev: symbol, k: symbol)
bw_mapper_ev(cat(p, "_", k), k) :- (p = "before" ; p = "after"), (k = "insert" ; k = "update" ; k = "delete").
// bw_covers_q(ak, mq): registration ak's target covers model mq: it names mq; or names a base of mq in the run and
// propagates; or is `cls` inside `__declare_last__`/`__declare_first__` of mq or a base of mq.
.decl bw_covers_q(ak: symbol, mq: symbol)
bw_covers_q(ak, mq) :- bw_reg_target_q(ak, mq), sa_mapped_q(mq).
bw_covers_q(ak, mq) :- bw_reg_target_q(ak, bq), bw_propagates_q(ak), sa_model_super_q(mq, bq).
bw_covers_q(ak, mq) :- bw_declare_q(ak, mq), sa_mapped_q(mq).
bw_covers_q(ak, mq) :- bw_declare_q(ak, bq), sa_model_super_q(mq, bq).
// bw_set_covers_q(ak, x, mq): attribute event ak on `O.x` covers model mq: through O, as bw_covers_q.
.decl bw_set_covers_q(ak: symbol, x: symbol, mq: symbol)
bw_set_covers_q(ak, x, mq) :- bw_reg_attr_q(ak, mq, x), sa_mapped_q(mq).
bw_set_covers_q(ak, x, mq) :- bw_reg_attr_q(ak, bq, x), bw_propagates_q(ak), sa_model_super_q(mq, bq).
// bw_hook_at_q(mq, k, x, ak, h): a hook of model mq that write operation k skips, registered at ak (a validator: its
// def's symbol); x is the column it watches ("" for a mapper event); h describes it.
.decl bw_hook_at_q(mq: symbol, k: symbol, x: symbol, ak: symbol, h: symbol)
bw_hook_at_q(mq, k, "", ak, h) :- bw_reg_q(ak, ev), bw_mapper_ev(ev, k), bw_covers_q(ak, mq), bw_lname_q(ak, n),
    bw_place_q(ak, p), h = cat(ev, " listener `", n, "` (", p, ")").
bw_hook_at_q(mq, k, x, ak, h) :- bw_reg_q(ak, "set"), (k = "insert" ; k = "update"), bw_set_covers_q(ak, x, mq),
    bw_lname_q(ak, n), bw_place_q(ak, p), h = cat("set listener `", n, "` on ", x, " (", p, ")").
bw_hook_at_q(mq, k, x, fq, h) :- bw_validator_q(bq, fq, x, h), (k = "insert" ; k = "update"),
    (mq = bq, sa_mapped_q(bq) ; sa_model_super_q(mq, bq)).
.decl bw_hook_q(mq: symbol, k: symbol, x: symbol, ak: symbol, h: symbol)
bw_hook_q(mq, k, x, ak, h) :- bw_hook_at_q(mq, k, x, ak, h), bw_live_q(ak).

// bw_in_hook_q(wk, mq): write wk runs inside one of mq's own hooks: a listener def (decorated, named by the
// registration, or a method the registration names) or a validator. bw_within_q(wk, f): wk is inside def f.
.decl bw_in_hook_q(wk: symbol, mq: symbol)
bw_in_hook_q(wk, mq) :- bw_write_q(wk, _, mq, _), bw_hook_at_q(mq, _, _, ak, _), bw_listener_q(ak, fq),
    bw_within_q(wk, fq).
bw_in_hook_q(wk, mq) :- bw_write_q(wk, _, mq, _), bw_hook_at_q(mq, _, _, fq, _), bw_within_q(wk, fq).
.decl bw_within_q(wk: symbol, f: symbol)
bw_within_q(wk, fq) :- bw_call(c, wk), within(c, f), kind(f, "function_definition"), pt_def(f, fq).

// bw_rerun_q(k, mq): a session-level `do_orm_execute` listener reads `is_<k>` and names mq, or names no model: it may
// run mq's hooks for bulk statements itself. Stated in the listener's file: bw_checks_q(f, x), def f reads
// `….is_insert`/`is_update`/`is_delete` (x); bw_names_q(f, q), such a def names q.
.decl bw_checker(f: node)
bw_checker(f) :- kind(f, "function_definition"), within(n, f), attr_of(n, _, x),
    (x = "is_insert" ; x = "is_update" ; x = "is_delete").
.decl bw_checks_q(f: symbol, x: symbol)
bw_checks_q(fq, x) :- bw_checker(f), within(n, f), attr_of(n, _, x), (x = "is_insert" ; x = "is_update" ; x = "is_delete"),
    pt_def(f, fq).
.decl bw_names_q(f: symbol, q: symbol)
bw_names_q(fq, q) :- bw_checker(f), within(n, f), sym_of(n, q), pt_def(f, fq).
.decl bw_exec_listener_q(f: symbol)
bw_exec_listener_q(fq) :- bw_reg_q(ak, "do_orm_execute"), bw_listener_q(ak, fq), bw_nontest_q(ak).
.decl bw_exec_names_q(f: symbol, mq: symbol)
bw_exec_names_q(fq, mq) :- bw_exec_listener_q(fq), bw_names_q(fq, mq), sa_model_q(mq).
.decl bw_exec_names_any_q(f: symbol)
bw_exec_names_any_q(fq) :- bw_exec_names_q(fq, _).
.decl bw_rerun_q(k: symbol, mq: symbol)
bw_rerun_q(k, mq) :- bw_write_q(_, k, mq, _), bw_exec_listener_q(fq), bw_checks_q(fq, cat("is_", k)),
    (bw_exec_names_q(fq, mq) ; !bw_exec_names_any_q(fq)).

// The cases, `upstream/sqlalchemy-practice/authored/sqlalchemy-practice-bulk-write-skips-hooks/`, read as one
// repository: each line ending in `# caught` is reported, and no other line. `generic` is a second repository whose
// do_orm_execute listener names no model.
.test cases exactly
    .fixture "app/__init__.py" from "../upstream/sqlalchemy-practice/authored/sqlalchemy-practice-bulk-write-skips-hooks/app/__init__.py"
