// lib/sqlalchemy: SQLAlchemy 2.0's models, relationships, sessions, statements and events, with SQLModel and
// Flask-SQLAlchemy, as the sqlalchemy-practice rules read them. Names resolve through imports (python/names'
// sym_of), so `from sqlalchemy.orm import Session`, `import sqlalchemy.orm as orm; orm.Session` and `from sqlmodel
// import Session` all reach a session class; a model whose declarative base sits in another module is still a model,
// and a relationship declared on a model in models/ is known where a loop in services/ reads it.
//
// Two layers, so that no node crosses files (decisions 0652, 0677). Each file states its own syntax by node:
// statements, rows, instances, sessions, writes. A class a node names is the qualified name the file resolves it to
// (mq), unchecked: whether it is a model is a fact of the run. What spans files is stated by symbol alone: which classes
// of the run are models, their relationships, foreign keys and tables, which module attributes hold a session factory
// or a Flask-SQLAlchemy extension, which parameters callers fill with a session, what a function of the run returns.
// Each file states its own part of those facts by symbol, and the symbol relations join them across files. A rule's
// output joins the two: by the symbol a node names (`sa_model_q(mq)`), by a condition key (`sa_session_key(k)`), or by
// a node's term (python/points-to's `pt_tm`, the symbol a node is known by) for a fact about that node that other
// files decide. A per-file relation never reads a symbol relation that spans files: it would follow it into the
// cross-file part with its nodes.
//
// Interface (by symbol: spans files; by node: per file)
//   Models:        sa_root_q(q)                q names a mapped base: DeclarativeBase (and its NoMeta and AsyncAttrs
//                                              combinations), a module-level `Base = declarative_base()` or
//                                              `registry().generate_base()`, Flask-SQLAlchemy's `db.Model` for
//                                              `db = SQLAlchemy(...)`, flask_appbuilder's Model
//                  sa_model_q(q)               q is a class of the run deriving from a mapped base (SQLModel only
//                                              with `table=True`), through the run's classes
//                  sa_mapped_q(q)              q is a mapped model (sa_model_q, not `__abstract__ = True`)
//                  sa_model_super_q(cq, bq)    class bq of the run is among mapped model cq's bases, directly or not
//                  sa_model_of(mr, mq)         model reference mr (sa_model_expr) denotes model mq
//   Relationships: sa_rel_ok_q(cq, x)          class cq's body declares relationship x as `x = relationship(...)`
//                                              (or `x: Mapped[...] = relationship(...)`, SQLModel's
//                                              `Relationship(...)`, Flask-SQLAlchemy's `db.relationship(...)`)
//                  sa_has_rel_q(mq, x, l)      model mq has relationship x with loading strategy l (the `lazy=`
//                                              literal, SQLModel's `sa_relationship_kwargs={"lazy": ...}`, "select"
//                                              when none is given, "?" when it is not a literal), declared in its body,
//                                              in a base of the run, or as a `backref="x"` (or `backref=backref("x")`)
//                                              on another model's relationship that targets mq
//                  sa_lazy_rel_q(mq, x)        sa_has_rel_q with a strategy that emits a SELECT when the attribute is
//                                              first read: "select" (the default, and `lazy=True`)
//                  sa_rel_target_q(cq, x, mq)  relationship x of class cq targets model mq: `relationship(B)`,
//                                              `relationship("B")`, `Mapped[list["B"]]`, `Mapped["B"]`
//                  sa_rel_dir_q(mq, x, d)      reading x on an instance of mq gives a collection (d "many") or one
//                                              object (d "one"): from `secondary=`, the annotation, `uselist=`, or
//                                              the side the foreign key sits on; a backref takes the opposite
//                  sa_rel_fk_arg_q(cq, x)      relationship x of cq says `foreign_keys=`; sa_rel_fk_col_q(cq, x, col):
//                                              col is a column one of its elements names
//                  sa_fk_on_q(cq, col, mq)     column col of class cq (or a base) has a ForeignKey to model mq's table
//                  sa_table_named(mq, tb)      model mq maps table tb (`__tablename__`, else its snake-case name)
//   Statements:    sa_select_fn(q)             q is select(): sqlalchemy.select, sqlmodel.select, ...
//                  sa_select_of(s, mq)         s is `select(M)` (M first) or a chain from one, M resolving to mq
//                  sa_query_of(q, mq)          q is a legacy query over class mq: `session.query(M)`, `M.query`,
//                                              chains of them
//                  sa_stmt_of(s, mq)           sa_select_of or sa_query_of
//                  sa_stmt_has(s, m)           statement chain s calls method m somewhere along it
//                  sa_stmt_loads(s, x)         chain s's `.options(...)` names a loader option for attribute x
//                                              (`selectinload(M.x)`, `joinedload("x")`, `selectinload(M.a).joinedload(A.x)`,
//                                              `defaultload(...)`)
//                  sa_stmt_loads_all(s)        chain s's options hold a wildcard loader (`selectinload("*")`,
//                                              `raiseload("*")`), which sets every relationship's strategy
//                  sa_rows(e, s, mq)           e yields instances of mq from statement s: `session.scalars(s)`,
//                                              `….all()`/`.unique().all()`/`.fetchall()` on it,
//                                              `session.execute(s).scalars()…`, a legacy query s itself or `s.all()`;
//                                              awaited or not, or a name the same scope binds to such rows
//                  sa_instance(e, mq)          e holds one instance of mq: `M(...)`, `session.get(M, pk)`,
//                                              `session.scalar(select(M)…)`, `….scalar_one()`, `query(M)….first()`,
//                                              awaited or not, or a name the same scope binds to one, a parameter
//                                              annotated M, or `self.<a>` its class annotates or assigns as one
//   Sessions:      sa_session_class(q)         q is a session class: Session, AsyncSession, scoped_session, SQLModel's
//                  sa_async_class(q)           q is an asyncio session class: AsyncSession, async_scoped_session
//                  sa_session_cls(e, q, a)     e names session class q (a "sync"/"async"): a library one, or a class of
//                                              the run deriving from one (its ancestors through the phase py_names)
//                  sa_factory_q(q, a)          module attribute q holds a session factory: `q = sessionmaker(...)`
//                                              (a "sync"), `async_sessionmaker(...)` (a "async"), `scoped_session(...)`
//                  sa_session_new(c, k)        call c makes a new session under condition k: `Session(...)`,
//                                              `AsyncSession(...)`, `sessionmaker(...)()` (k ""), `<factory>()` (k
//                                              "factory <q>": the callee q is a session factory, sa_factory_q)
//                  sa_session_ann(x, a)        annotation x names a session class (a "sync"/"async"), maybe in an
//                                              Optional/Union/Annotated
//                  sa_session(e, k)            e is a session under condition k: a name bound (`=`, `with … as`) to
//                                              sa_session_new, a parameter or variable annotated as one, `<db>.session`
//                                              (k "flask <db>": db holds a Flask-SQLAlchemy extension), a module-level
//                                              scoped_session (k "scoped <q>")
//                  sa_session_like(e, k)       sa_session, or a name or attribute spelled like one (`session`,
//                                              `db_session`, `self.session`, `*_session`) in a file importing
//                                              SQLAlchemy, SQLModel or Flask-SQLAlchemy (k ""), or a parameter of any
//                                              name (k "param <g> <x>": a caller of the run fills parameter x of def g
//                                              with an sa_session)
//                  sa_session_call(c, s, m, k) call c is `s.m(...)` on sa_session_like s, under condition k
//                  sa_session_key(k)           condition k holds (by symbol, across files; "" always holds)
//                  sa_tx_with(w, b)            with-statement w opens a transaction around body b: `with s.begin():`,
//                                              `with engine.begin() as conn:`, `with Session.begin() as s:`
//   Writes:        sa_dml_fn(q)                q is insert(), update() or delete() (sqlalchemy, sqlmodel, dialects)
//                  sa_model_expr(e, mr)        e names a model as a statement's target: the class or `M.__table__`
//                                              (mr the class's symbol), or `self.model` (mr "self <k> <x>": the model a
//                                              class attribute x of the method's class k, or of a subclass, binds;
//                                              sa_model_of resolves it)
//                  sa_dml(s, op, mr)           s is a DML statement on sa_model_expr mr, or a chain from one: op
//                                              "insert"/"update"/"delete"; sa_dml_q(dk, op, mr) the same by s's term
//                  sa_exec_stmt_q(wk, dk)      `session.execute(s)` call wk (its term) runs DML chain dk: inline,
//                                              through a name, or returned by a function of the run, across files
//                  sa_bulk_local_q(wk, op, mr) call wk writes rows of mr in bulk, by its own syntax:
//                                              `session.query(M)….update(...)`/`.delete()`,
//                                              `session.bulk_insert_mappings(M, ...)`, `bulk_update_mappings(M, ...)`
//   Calls:         sa_callee_q(c, g)           call c runs def g of the run, by symbol (by resolved name or the call
//                                              graph's call_target)
//                  sa_returns(g, v)            def g returns v
//                  sa_param_q(g, i, x)         def g (its symbol) has parameter x at position i
//                  sa_param_for(g, i, b, x)    positional argument i of a call of g fills parameter x: one further for
//                                              a bound method (b "attr", `obj.m(...)`, whose first parameter is self or
//                                              cls); sa_call_form(c, b) says which form call c is
//   Events:        sa_event_call(c, tgt, ev)   c is `event.listen(tgt, "ev", fn)` or `@event.listens_for(tgt, "ev")`
//   Text SQL:      sa_text_call(c)             call c is SQLAlchemy's `text(...)`
//   Files:         sa_doc(d)                   document d imports sqlalchemy, sqlmodel or flask_sqlalchemy
//                  sa_test_doc(d)              document d is test code: a tests/test/testing directory, test_*.py,
//                                              *_test.py, *_tests.py, tests.py, conftest.py
//                  sa_migration_doc(d)         document d is an Alembic revision or env.py (`from alembic import op`
//                                              or `context`, or under migrations/versions); a CLI importing
//                                              `alembic.command` is not one
//                  sa_async_def(f)             def f is `async def`
//                  sa_region_stop(k)           node kinds whose code runs later: def, lambda, class
//
// SQLAlchemy background
//   - A relationship's default loader is "select": the first read of the attribute on each instance emits one
//     SELECT (N+1 across a loop), and under asyncio that implicit IO raises MissingGreenlet. "selectin", "joined",
//     "subquery", "immediate" load with the parent; "raise", "raise_on_sql", "noload", "write_only" and "dynamic"
//     never load implicitly on read ("dynamic" returns a query instead).
//   - A loader option on the statement (`.options(selectinload(M.x))`) overrides the declared strategy for that
//     query only.
//   - ORM-enabled `update(M)`/`delete(M)` statements, `Query.update()/delete()` and the `bulk_*` methods run SQL
//     directly: no mapper events (before_/after_update...), no `@validates`, no attribute events, no in-Python
//     cascades.
//   e.g.  class Base(DeclarativeBase): ...                    sa_root_q("app.db.Base") (a library base's subclass)
//         class Order(Base):                                  sa_mapped_q("app.models.Order")
//             lines: Mapped[list["Line"]] = relationship(back_populates="order")
//                                                             sa_has_rel_q("app.models.Order", "lines", "select"),
//                                                             sa_lazy_rel_q("app.models.Order", "lines")
//         stmt = select(Order).options(selectinload(Order.lines))
//                                                             sa_select_of(<select…>, "app.models.Order"),
//                                                             sa_stmt_loads(<select…>, "lines")
//         for o in session.scalars(select(Order)): ...        sa_rows(<session.scalars(…)>, <select(Order)>, "app.models.Order")
//         session.execute(update(Order).where(...).values(...))   sa_exec_stmt_q(<execute's term>, <update's term>),
//                                                             sa_dml_q(<update's term>, "update", "app.models.Order")
#include "python/ast.rerail"
#include "python/calls.rerail"   // call_arg, posarg, call_target; pt_tm and pt_def (python/points-to)

// ---- module variables --------------------------------------------------------------------------------------------
// sa_module_var(q, v): a module-level `x = v` (or `x: T = v`) binds module attribute q to value v. Per file: a rule
// reads another module's variables by the symbol facts each file states about its own (sa_factory_q, sa_root_q, ...).
.decl sa_module_var(q: symbol, v: node)
sa_module_var(@dot(mq, x), v) :- modnode(_, m), modname(m, mq), asg(m, x, v, _).
// sa_call_of(v, fq): v (through parentheses) is a call whose callee resolves to fq.
.decl sa_call_of(v: node, fq: symbol)
sa_call_of(v, fq) :- unparen(v, k), kind(k, "call"), field(k, "function", f), sym_of(f, fq).

// ---- models ------------------------------------------------------------------------------------------------------
// sa_base_lib(q): library classes a project's declarative base derives from: `class Base(DeclarativeBase)` is the
// base (a root), its subclasses are the models.
.decl sa_base_lib(q: symbol)
sa_base_lib("sqlalchemy.orm.DeclarativeBase"). sa_base_lib("sqlalchemy.orm.DeclarativeBaseNoMeta").
sa_base_lib("sqlalchemy.orm.decl_api.DeclarativeBase"). sa_base_lib("sqlalchemy.orm.decl_api.DeclarativeBaseNoMeta").
// sa_mapped_lib(q): library classes that are a declarative base themselves: their subclasses are models.
.decl sa_mapped_lib(q: symbol)
sa_mapped_lib("flask_appbuilder.Model"). sa_mapped_lib("flask_appbuilder.models.sqla.Model").
// sa_declarative_fn(q): functions that return a mapped base: `Base = declarative_base()`.
.decl sa_declarative_fn(q: symbol)
sa_declarative_fn("sqlalchemy.orm.declarative_base"). sa_declarative_fn("sqlalchemy.ext.declarative.declarative_base").
sa_declarative_fn("sqlalchemy.orm.decl_api.declarative_base").
.decl sa_flask_db_class(q: symbol)
sa_flask_db_class("flask_sqlalchemy.SQLAlchemy"). sa_flask_db_class("flask_sqlalchemy.extension.SQLAlchemy").
// sa_flask_db_q(q): module attribute q holds a Flask-SQLAlchemy extension: `db = SQLAlchemy(...)`. Stated in q's file.
.decl sa_flask_db_q(q: symbol)
sa_flask_db_q(q) :- sa_module_var(q, v), sa_call_of(v, fq), sa_flask_db_class(fq).
// sa_root_q(q): q names a mapped base. Each row is stated in q's own file (a library's by its name).
.decl sa_root_q(q: symbol)
sa_root_q(q) :- sa_mapped_lib(q).
sa_root_q(q) :- class_def(c, q), class_base(c, b), sa_base_lib(b).
sa_root_q(q) :- sa_module_var(q, v), sa_call_of(v, fq), sa_declarative_fn(fq).
sa_root_q(q) :- sa_module_var(q, v), unparen(v, k), kind(k, "call"), field(k, "function", f),
    attr_of(f, _, "generate_base").
sa_root_q(@dot(q, "Model")) :- sa_flask_db_q(q).
// sa_class_base_q(q, b): class q of the run lists base b (python/scopes' class_base), stated in q's file.
// sa_run_class_q(q): q is a class of the run.
.decl sa_class_base_q(q: symbol, b: symbol)
sa_class_base_q(q, b) :- class_def(c, q), class_base(c, b).
.decl sa_run_class_q(q: symbol)
sa_run_class_q(q) :- class_def(_, q).
// sa_model_q(q): a class of the run with a mapped base among its bases, through the run's classes (a linear
// closure, as lib/django's dj_model_q). SQLModel counts only with `table=True`. It spans files on purpose (a model's
// base, and the module variable that makes it, sit in other modules), keyed by qualified names alone.
.decl sa_model_q(q: symbol) cross_file
sa_model_q(q) :- sa_class_base_q(q, b), sa_root_q(b).
sa_model_q(q) :- sa_class_base_q(q, b), sa_model_q(b).
sa_model_q(q) :- sa_class_base_q(q, b), (b = "sqlmodel.SQLModel" ; b = "sqlmodel.main.SQLModel" ; sa_sqlmodel_q(b)),
    sa_table_kw_q(q).
// sa_sqlmodel_q(q): a class of the run deriving from SQLModel (a table or not), across files as sa_model_q.
.decl sa_sqlmodel_q(q: symbol) cross_file
sa_sqlmodel_q(q) :- sa_class_base_q(q, b), (b = "sqlmodel.SQLModel" ; b = "sqlmodel.main.SQLModel").
sa_sqlmodel_q(q) :- sa_class_base_q(q, b), sa_sqlmodel_q(b).
.decl sa_table_kw(c: node)
sa_table_kw(c) :- kind(c, "class_definition"), field(c, "superclasses", al), child(al, ka, _),
    kind(ka, "keyword_argument"), field(ka, "name", n), text(n, "table"), field(ka, "value", v), kind(v, "true").
.decl sa_table_kw_q(q: symbol)
sa_table_kw_q(q) :- class_def(c, q), sa_table_kw(c).
// `__abstract__ = True` in the body: a base that maps no table.
.decl sa_abstract(c: node)
sa_abstract(c) :- kind(c, "class_definition"), field(c, "body", b), body_stmt(b, s, _), kind(s, "expression_statement"),
    child(s, a, 0), kind(a, "assignment"), field(a, "left", l), text(l, "__abstract__"), field(a, "right", v),
    kind(v, "true").
.decl sa_abstract_q(q: symbol)
sa_abstract_q(q) :- class_def(c, q), sa_abstract(c).
.decl sa_mapped_q(q: symbol)
sa_mapped_q(q) :- sa_model_q(q), !sa_abstract_q(q).
// sa_model_super_q(cq, bq): class bq of the run is among mapped model cq's bases, directly or through other classes
// of the run.
.decl sa_model_super_q(cq: symbol, bq: symbol)
sa_model_super_q(cq, bq) :- sa_mapped_q(cq), sa_class_base_q(cq, bq), sa_run_class_q(bq).
sa_model_super_q(cq, bq) :- sa_model_super_q(cq, mq), sa_class_base_q(mq, bq), sa_run_class_q(bq).
// sa_model_named(n, mq): n is the class name (last dotted part) of model mq, or mq itself.
.decl sa_model_named(n: symbol, mq: symbol)
sa_model_named(n, mq) :- sa_model_q(mq), split_dot(mq, _, n).
sa_model_named(mq, mq) :- sa_model_q(mq).
// sa_model_of(mr, mq): model reference mr (sa_model_expr) denotes model mq: mr is mq; or mr is "self <kq> <x>" and
// class kq, or a class of the run deriving from it, binds class attribute x to mq (a generic repository's
// `model = Item`).
.decl sa_model_of(mr: symbol, mq: symbol)
sa_model_of(mq, mq) :- sa_model_q(mq).
sa_model_of(mr, mq) :- sa_self_ref_q(mr, kq, x), sa_subclass_q(kq, sq), sa_class_ref_q(sq, x, mq), sa_model_q(mq).
// sa_subclass_q(kq, sq): class sq is kq, or a class of the run deriving from kq, directly or not (from the classes
// sa_self_ref_q names only).
.decl sa_subclass_q(kq: symbol, sq: symbol)
sa_subclass_q(kq, kq) :- sa_self_ref_q(_, kq, _).
sa_subclass_q(kq, sq) :- sa_subclass_q(kq, mq), sa_class_base_q(sq, mq).
// sa_class_ref_q(sq, x, q): class sq's body has `x = <name>`, the name resolving to q.
.decl sa_class_ref_q(sq: symbol, x: symbol, q: symbol)
sa_class_ref_q(sq, x, q) :- class_def(s, sq), sa_class_attr(s, x, v, _), sym_of(v, q).

// ---- relationships -----------------------------------------------------------------------------------------------
.decl sa_relationship_fn(q: symbol)
sa_relationship_fn("sqlalchemy.orm.relationship"). sa_relationship_fn("sqlalchemy.orm.relationships.relationship").
sa_relationship_fn("sqlalchemy.orm._orm_constructors.relationship"). sa_relationship_fn("sqlalchemy.orm.relation").
sa_relationship_fn("sqlmodel.Relationship"). sa_relationship_fn("sqlmodel.main.Relationship").
// sa_relationship_call(call, via): call builds a relationship: one of the functions above (via ""), or
// `<o>.relationship(...)`, o resolving to via, a relationship when via holds a Flask-SQLAlchemy extension (sa_rel_ok_q
// asks sa_flask_db_q, across files).
.decl sa_relationship_call(call: node, via: symbol)
sa_relationship_call(call, "") :- sa_call_of(call, fq), sa_relationship_fn(fq).
sa_relationship_call(call, q) :- kind(call, "call"), field(call, "function", f), attr_of(f, o, "relationship"),
    sym_of(o, q).
// sa_class_attr(c, x, v, ann): class c's body has `x = v` or `x: T = v` (ann the annotation node, or c itself
// when there is none).
.decl sa_class_attr(c: node, x: symbol, v: node, ann: node)
sa_class_attr(c, x, v, c) :- kind(c, "class_definition"), field(c, "body", b), body_stmt(b, s, _),
    kind(s, "expression_statement"), child(s, a, 0), kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"),
    text(l, x), field(a, "right", v), !field(a, "type", _).
sa_class_attr(c, x, v, t) :- kind(c, "class_definition"), field(c, "body", b), body_stmt(b, s, _),
    kind(s, "expression_statement"), child(s, a, 0), kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"),
    text(l, x), field(a, "right", v), field(a, "type", t).
// sa_relationship(c, x, call): class c's body declares x as relationship call.
.decl sa_relationship(c: node, x: symbol, call: node)
sa_relationship(c, x, call) :- sa_class_attr(c, x, v, _), unparen(v, call), sa_relationship_call(call, _).
// sa_rel_at(cq, x, call): the same by the class's qualified name: each relationship's facts below are stated, by
// (cq, x), in the file that declares it.
.decl sa_rel_at(cq: symbol, x: symbol, call: node)
sa_rel_at(cq, x, call) :- sa_relationship(c, x, call), class_def(c, cq).
// sa_rel_lazy(call, l): the loading strategy of relationship call.
.decl sa_rel_lazy(call: node, l: symbol)
sa_rel_lazy(call, l) :- sa_relationship_call(call, _), call_arg(call, -1, "lazy", v), sa_lazy_value(v, l).
sa_rel_lazy(call, l) :- sa_relationship_call(call, _), call_arg(call, -1, "sa_relationship_kwargs", d), unparen(d, dd),
    kind(dd, "dictionary"), child(dd, p, _), kind(p, "pair"), field(p, "key", k), str(k, "lazy"), field(p, "value", v),
    sa_lazy_value(v, l).
sa_rel_lazy(call, "select") :- sa_relationship_call(call, _), !call_arg(call, -1, "lazy", _), !sa_kw_lazy(call).
.decl sa_kw_lazy(call: node)
sa_kw_lazy(call) :- call_arg(call, -1, "sa_relationship_kwargs", d), unparen(d, dd), kind(dd, "dictionary"),
    child(dd, p, _), kind(p, "pair"), field(p, "key", k), str(k, "lazy").
.decl sa_lazy_value(v: node, l: symbol)
sa_lazy_value(v, l) :- unparen(v, s), str(s, l).
sa_lazy_value(v, "select") :- unparen(v, s), kind(s, "true").
sa_lazy_value(v, "noload") :- unparen(v, s), kind(s, "none").
sa_lazy_value(v, "joined") :- unparen(v, s), kind(s, "false").
sa_lazy_value(v, "?") :- unparen(v, s), !str(s, _), !kind(s, "true"), !kind(s, "none"), !kind(s, "false").
// sa_ann_name(t, n): annotation t mentions class name n: as a name, as a string literal, or as the element of a
// `list[...]`-like string.
.decl sa_ann_name(t: node, n: symbol)
sa_ann_name(t, n) :- sa_class_attr(_, _, _, t), within(i, t), kind(i, "identifier"), text(i, n).
sa_ann_name(t, n) :- sa_class_attr(_, _, _, t), within(s, t), kind(s, "string"), str(s, n).
sa_ann_name(t, n) :- sa_class_attr(_, _, _, t), within(s, t), kind(s, "string"), str(s, n0),
    match("\\s*(?:list|List|set|Set|Sequence)\\[\\s*\\w+\\s*\\]\\s*", n0),
    n = @replace_all(n0, "^\\s*\\w+\\[\\s*|\\s*\\]\\s*$", "").
// sa_ann_coll(t): annotation t declares a collection: list, set, Sequence, dict... (as names or inside a string).
.decl sa_ann_coll(t: node)
sa_ann_coll(t) :- kind(t, "type"), within(i, t), kind(i, "identifier"), text(i, n), sa_coll_name(n).
sa_ann_coll(t) :- kind(t, "type"), within(s, t), kind(s, "string"), str(s, n),
    match("(?s)\\s*(?:\\w+\\.)*(?:list|List|set|Set|Sequence|MutableSequence|Collection|Iterable|AbstractSet|MutableSet|dict|Dict|Mapping|MutableMapping|DynamicMapped|WriteOnlyMapped)\\[.*", n).
.decl sa_coll_name(n: symbol)
sa_coll_name("list"). sa_coll_name("List"). sa_coll_name("set"). sa_coll_name("Set"). sa_coll_name("Sequence").
sa_coll_name("MutableSequence"). sa_coll_name("Collection"). sa_coll_name("Iterable"). sa_coll_name("AbstractSet").
sa_coll_name("MutableSet"). sa_coll_name("dict"). sa_coll_name("Dict"). sa_coll_name("Mapping").
sa_coll_name("MutableMapping"). sa_coll_name("DynamicMapped"). sa_coll_name("WriteOnlyMapped").
// sa_rel_fk_elem(call, e): e is the `foreign_keys=` value of call, or an element of its list or tuple.
.decl sa_rel_fk_elem(call: node, e: node)
sa_rel_fk_elem(call, e) :- sa_relationship_call(call, _), call_arg(call, -1, "foreign_keys", v), unparen(v, e),
    !kind(e, "list"), !kind(e, "tuple").
sa_rel_fk_elem(call, e) :- sa_relationship_call(call, _), call_arg(call, -1, "foreign_keys", v), unparen(v, l),
    (kind(l, "list") ; kind(l, "tuple")), child(l, e, _), !kind(e, ","), !kind(e, "["), !kind(e, "]"), !kind(e, "("),
    !kind(e, ")"), !kind(e, "comment").
// sa_backref_lazy(bc, l): the strategy `backref("x", lazy=...)` gives the other side.
.decl sa_backref_lazy(bc: node, l: symbol)
sa_backref_lazy(bc, l) :- call_arg(bc, -1, "lazy", v), sa_lazy_value(v, l).
sa_backref_lazy(bc, "select") :- kind(bc, "call"), !call_arg(bc, -1, "lazy", _).

// What each file states about the relationships its classes declare, by (cq, x): relationship x of class cq.
// sa_rel_q(cq, x, via): declared (via as sa_relationship_call's). sa_rel_lazy_q(cq, x, l): its strategy.
.decl sa_rel_q(cq: symbol, x: symbol, via: symbol)
sa_rel_q(cq, x, via) :- sa_rel_at(cq, x, call), sa_relationship_call(call, via).
.decl sa_rel_lazy_q(cq: symbol, x: symbol, l: symbol)
sa_rel_lazy_q(cq, x, l) :- sa_rel_at(cq, x, call), sa_rel_lazy(call, l).
// sa_rel_arg_q(cq, x, q): its first argument resolves to q (`relationship(B)`). sa_rel_name_q(cq, x, n): it is a
// string naming a class n (`relationship("B")`). sa_rel_ann_q(cq, x, n): its annotation mentions class name n.
.decl sa_rel_arg_q(cq: symbol, x: symbol, q: symbol)
sa_rel_arg_q(cq, x, q) :- sa_rel_at(cq, x, call), posarg(call, 0, a), sym_of(a, q).
.decl sa_rel_name_q(cq: symbol, x: symbol, n: symbol)
sa_rel_name_q(cq, x, n) :- sa_rel_at(cq, x, call), posarg(call, 0, a), str(a, n).
.decl sa_rel_ann_q(cq: symbol, x: symbol, n: symbol)
sa_rel_ann_q(cq, x, n) :- class_def(c, cq), sa_class_attr(c, x, v, t), unparen(v, call), sa_relationship_call(call, _),
    kind(t, "type"), sa_ann_name(t, n).
// sa_rel_secondary_q: `secondary=`, SQLModel's `link_model=`, or a second positional argument (many-to-many).
.decl sa_rel_secondary_q(cq: symbol, x: symbol)
sa_rel_secondary_q(cq, x) :- sa_rel_at(cq, x, call), (call_arg(call, -1, "secondary", _) ;
    call_arg(call, -1, "link_model", _) ; posarg(call, 1, _)).
// sa_rel_coll_q: a declared collection: `uselist=True`, `collection_class=`, a collection annotation.
.decl sa_rel_coll_q(cq: symbol, x: symbol)
sa_rel_coll_q(cq, x) :- sa_rel_at(cq, x, call), call_arg(call, -1, "uselist", v), unparen(v, t), kind(t, "true").
sa_rel_coll_q(cq, x) :- sa_rel_at(cq, x, call), call_arg(call, -1, "collection_class", _).
sa_rel_coll_q(cq, x) :- class_def(c, cq), sa_class_attr(c, x, v, t), unparen(v, call), sa_relationship_call(call, _),
    kind(t, "type"), sa_ann_coll(t).
// sa_rel_nouselist_q: `uselist=False`. sa_rel_ann_one_q: annotated, not as a collection (one object, when the
// annotation names a model and nothing else declares a collection: sa_rel_single_q).
.decl sa_rel_nouselist_q(cq: symbol, x: symbol)
sa_rel_nouselist_q(cq, x) :- sa_rel_at(cq, x, call), call_arg(call, -1, "uselist", v), unparen(v, t), kind(t, "false").
.decl sa_rel_ann_one_q(cq: symbol, x: symbol)
sa_rel_ann_one_q(cq, x) :- class_def(c, cq), sa_class_attr(c, x, v, t), unparen(v, call), sa_relationship_call(call, _),
    kind(t, "type"), !sa_ann_coll(t).
// sa_rel_fk_arg_q: `foreign_keys=` is given. sa_rel_remote_q: `remote_side=` is given.
.decl sa_rel_fk_arg_q(cq: symbol, x: symbol)
sa_rel_fk_arg_q(cq, x) :- sa_rel_at(cq, x, call), call_arg(call, -1, "foreign_keys", _).
.decl sa_rel_remote_q(cq: symbol, x: symbol)
sa_rel_remote_q(cq, x) :- sa_rel_at(cq, x, call), call_arg(call, -1, "remote_side", _).
// The elements of `foreign_keys=`: sa_rel_fk_local_q, one names a column of the declaring class (a bare name in its
// body, "col"); sa_rel_fk_obj_q(cq, x, oq), one is `O.col`, O resolving to oq; sa_rel_fk_objname_q(cq, x, on), one is
// the string "O.col"; sa_rel_fk_col_q(cq, x, col), one names column col.
.decl sa_rel_fk_local_q(cq: symbol, x: symbol)
sa_rel_fk_local_q(cq, x) :- sa_rel_at(cq, x, call), sa_rel_fk_elem(call, e), unparen(e, i), kind(i, "identifier").
sa_rel_fk_local_q(cq, x) :- sa_rel_at(cq, x, call), sa_rel_fk_elem(call, e), str(e, s),
    match("\\s*\\[?\\s*\\w+\\s*\\]?\\s*", s).
.decl sa_rel_fk_obj_q(cq: symbol, x: symbol, oq: symbol)
sa_rel_fk_obj_q(cq, x, oq) :- sa_rel_at(cq, x, call), sa_rel_fk_elem(call, e), unparen(e, a), attr_of(a, o, _),
    sym_of(o, oq).
.decl sa_rel_fk_objname_q(cq: symbol, x: symbol, on: symbol)
sa_rel_fk_objname_q(cq, x, on) :- sa_rel_at(cq, x, call), sa_rel_fk_elem(call, e), str(e, s),
    match("\\s*\\[?\\s*\\w+\\.\\w+.*", s), on = @replace_all(s, "^\\s*\\[?\\s*(\\w+)\\..*$", "$1").
.decl sa_rel_fk_col_q(cq: symbol, x: symbol, col: symbol)
sa_rel_fk_col_q(cq, x, col) :- sa_rel_at(cq, x, call), sa_rel_fk_elem(call, e), unparen(e, i), kind(i, "identifier"),
    text(i, col).
sa_rel_fk_col_q(cq, x, col) :- sa_rel_at(cq, x, call), sa_rel_fk_elem(call, e), unparen(e, a), attr_of(a, _, col).
sa_rel_fk_col_q(cq, x, col) :- sa_rel_at(cq, x, call), sa_rel_fk_elem(call, e), str(e, s),
    col = @replace_all(s, "^\\s*\\[?\\s*(?:\\w+\\.)?(\\w+)\\s*\\]?\\s*$", "${1}").
// sa_rel_backref_q(cq, x, y, l, u): relationship x of cq gives its target a backref y (`backref="y"`, or
// `backref=backref("y", ...)`) with strategy l; u is "true" or "false" when backref() says `uselist=`, else "".
.decl sa_rel_backref_q(cq: symbol, x: symbol, y: symbol, l: symbol, u: symbol)
sa_rel_backref_q(cq, x, y, "select", "") :- sa_rel_at(cq, x, call), call_arg(call, -1, "backref", v), str(v, y).
sa_rel_backref_q(cq, x, y, l, u) :- sa_rel_at(cq, x, call), call_arg(call, -1, "backref", v), unparen(v, bc),
    kind(bc, "call"), field(bc, "function", bf), sym_of(bf, bq), suffix(".backref", bq), posarg(bc, 0, n), str(n, y),
    sa_backref_lazy(bc, l), sa_backref_uselist(bc, u).
.decl sa_backref_uselist(bc: node, u: symbol)
sa_backref_uselist(bc, "true") :- call_arg(bc, -1, "uselist", v), unparen(v, t), kind(t, "true").
sa_backref_uselist(bc, "false") :- call_arg(bc, -1, "uselist", v), unparen(v, t), kind(t, "false").
sa_backref_uselist(bc, "") :- kind(bc, "call"), !call_arg(bc, -1, "uselist", _).

// Across files, by symbol: relationships join the models of the run (their targets, bases and foreign keys sit in
// other modules).
// sa_rel_ok_q(cq, x): relationship x of cq is one: a SQLAlchemy or SQLModel function, or `db.relationship` on a
// Flask-SQLAlchemy extension.
.decl sa_rel_ok_q(cq: symbol, x: symbol)
sa_rel_ok_q(cq, x) :- sa_rel_q(cq, x, "").
sa_rel_ok_q(cq, x) :- sa_rel_q(cq, x, q), sa_flask_db_q(q).
// sa_rel_target_q(cq, x, mq): the model class relationship x of cq targets: its first argument (a class or a string
// naming one, matched by class name among the run's models), or the class inside the `Mapped[...]` annotation.
.decl sa_rel_target_q(cq: symbol, x: symbol, mq: symbol)
sa_rel_target_q(cq, x, mq) :- sa_rel_ok_q(cq, x), sa_rel_arg_q(cq, x, mq), sa_model_q(mq).
sa_rel_target_q(cq, x, mq) :- sa_rel_ok_q(cq, x), sa_rel_name_q(cq, x, n), sa_model_named(n, mq).
sa_rel_target_q(cq, x, mq) :- sa_rel_ok_q(cq, x), sa_rel_ann_q(cq, x, n), sa_model_named(n, mq).
// sa_has_rel_q(mq, x, l): model mq has relationship x with strategy l: declared in its body or a base of the run,
// or given by another model's `backref=` (a backref's loader is "select" unless backref("x", lazy=...) says).
.decl sa_has_rel_q(mq: symbol, x: symbol, l: symbol)
sa_has_rel_q(mq, x, l) :- sa_mapped_q(mq), sa_rel_ok_q(mq, x), sa_rel_lazy_q(mq, x, l).
sa_has_rel_q(mq, x, l) :- sa_model_super_q(mq, bq), sa_rel_ok_q(bq, x), sa_rel_lazy_q(bq, x, l).
sa_has_rel_q(mq, y, l) :- sa_rel_backref_q(cq, x, y, l, _), sa_rel_target_q(cq, x, mq), sa_mapped_q(mq).
// sa_lazy_rel_q(mq, x): reading x on an instance of mq that was loaded without it emits a SELECT.
.decl sa_lazy_rel_q(mq: symbol, x: symbol)
sa_lazy_rel_q(mq, x) :- sa_has_rel_q(mq, x, "select").

// ---- relationship direction --------------------------------------------------------------------------------------
// sa_rel_dir_q(mq, x, d): reading relationship x on an instance of model mq gives a collection (d "many": one-to-many
// or many-to-many) or a single object (d "one": many-to-one or one-to-one). Read as SQLAlchemy decides it:
// `secondary=` (SQLModel's `link_model=`) is many-to-many; a declared collection (`Mapped[list[...]]`, `uselist=True`,
// `collection_class=`) is one-to-many; a declared single object (`Mapped["B"]`, `Optional[...]`, `uselist=False`)
// or, with nothing declared, the side the foreign key sits on: on the declaring model (`b_id = Column(ForeignKey(
// "b.id"))`, `foreign_keys=[b_id]`, `remote_side=`) many-to-one, on the target (`foreign_keys=[B.a_id]`, B's column
// to this table) one-to-many. A `backref=` takes the other side's opposite. Undecidable relationships have no row.
.decl sa_rel_dir_q(mq: symbol, x: symbol, d: symbol)
sa_rel_dir_q(mq, x, d) :- sa_mapped_q(mq), sa_rel_ok_q(mq, x), sa_rel_card_q(mq, x, d).
sa_rel_dir_q(mq, x, d) :- sa_model_super_q(mq, bq), sa_rel_ok_q(bq, x), sa_rel_card_q(bq, x, d).
sa_rel_dir_q(mq, y, d) :- sa_rel_backref_q(cq, x, y, _, u), sa_backref_card_q(cq, x, u, d), sa_rel_target_q(cq, x, mq),
    sa_mapped_q(mq).
// sa_rel_card_q(cq, x, d): the cardinality relationship x of cq declares or implies.
.decl sa_rel_card_q(cq: symbol, x: symbol, d: symbol)
sa_rel_card_q(cq, x, "many") :- sa_rel_kind_q(cq, x, k), (k = "m2m" ; k = "o2m").
sa_rel_card_q(cq, x, "one") :- sa_rel_kind_q(cq, x, k), (k = "m2o" ; k = "o2o").
sa_rel_card_q(cq, x, "one") :- sa_rel_single_q(cq, x), !sa_rel_secondary_q(cq, x), !sa_rel_kind_q(cq, x, _).
// sa_backref_card_q(cq, x, u, d): the backref of relationship x of cq: `backref("y", uselist=...)` says, else the
// opposite of x (many-to-one gives a collection; one-to-many and one-to-one a single object; many-to-many a
// collection).
.decl sa_backref_card_q(cq: symbol, x: symbol, u: symbol, d: symbol)
sa_backref_card_q(cq, x, "true", "many") :- sa_rel_backref_q(cq, x, _, _, "true").
sa_backref_card_q(cq, x, "false", "one") :- sa_rel_backref_q(cq, x, _, _, "false").
sa_backref_card_q(cq, x, "", d) :- sa_rel_backref_q(cq, x, _, _, ""), sa_rel_kind_q(cq, x, k), sa_opposite(k, d).
.decl sa_opposite(k: symbol, d: symbol)
sa_opposite("m2o", "many"). sa_opposite("o2m", "one"). sa_opposite("o2o", "one"). sa_opposite("m2m", "many").
// sa_rel_kind_q(cq, x, k): "m2m", "o2m", "m2o" or "o2o".
.decl sa_rel_kind_q(cq: symbol, x: symbol, k: symbol)
sa_rel_kind_q(cq, x, "m2m") :- sa_rel_ok_q(cq, x), sa_rel_secondary_q(cq, x).
sa_rel_kind_q(cq, x, "o2m") :- sa_rel_ok_q(cq, x), sa_rel_coll_q(cq, x), !sa_rel_secondary_q(cq, x).
sa_rel_kind_q(cq, x, "m2o") :- sa_rel_fk_side_q(cq, x, "local"), !sa_rel_coll_q(cq, x), !sa_rel_secondary_q(cq, x).
sa_rel_kind_q(cq, x, "o2o") :- sa_rel_fk_side_q(cq, x, "remote"), sa_rel_single_q(cq, x), !sa_rel_secondary_q(cq, x).
sa_rel_kind_q(cq, x, "o2m") :- sa_rel_fk_side_q(cq, x, "remote"), !sa_rel_single_q(cq, x), !sa_rel_coll_q(cq, x),
    !sa_rel_secondary_q(cq, x).
// sa_rel_single_q(cq, x): declared as one object: `uselist=False`, or an annotation naming a model, not a collection.
.decl sa_rel_single_q(cq: symbol, x: symbol)
sa_rel_single_q(cq, x) :- sa_rel_ok_q(cq, x), sa_rel_nouselist_q(cq, x).
sa_rel_single_q(cq, x) :- sa_rel_ann_one_q(cq, x), !sa_rel_coll_q(cq, x), sa_rel_ann_q(cq, x, n), sa_model_named(n, _).
// sa_rel_fk_side_q(cq, x, side): the foreign key of relationship x of cq sits on the declaring model ("local") or on
// the target ("remote"). `foreign_keys=` decides when given; else the models' ForeignKey columns, when only one side
// has one; `remote_side=` marks the many-to-one side of a self-referential relationship, which without it is
// one-to-many.
.decl sa_rel_fk_side_q(cq: symbol, x: symbol, side: symbol)
sa_rel_fk_side_q(cq, x, "local") :- sa_rel_fk_given_q(cq, x, "local"), !sa_rel_fk_given_q(cq, x, "remote").
sa_rel_fk_side_q(cq, x, "remote") :- sa_rel_fk_given_q(cq, x, "remote"), !sa_rel_fk_given_q(cq, x, "local").
sa_rel_fk_side_q(cq, x, "local") :- sa_rel_target_q(cq, x, cq), !sa_rel_fk_arg_q(cq, x), sa_rel_remote_q(cq, x).
sa_rel_fk_side_q(cq, x, "remote") :- sa_rel_target_q(cq, x, cq), !sa_rel_fk_arg_q(cq, x), !sa_rel_remote_q(cq, x).
sa_rel_fk_side_q(cq, x, "local") :- sa_rel_target_q(cq, x, mq), cq != mq, !sa_rel_fk_arg_q(cq, x),
    sa_fk_on_q(cq, _, mq), sa_run_class_q(mq), !sa_fk_on_q(mq, _, cq).
sa_rel_fk_side_q(cq, x, "remote") :- sa_rel_target_q(cq, x, mq), cq != mq, !sa_rel_fk_arg_q(cq, x),
    sa_run_class_q(mq), sa_fk_on_q(mq, _, cq), !sa_fk_on_q(cq, _, mq).
// sa_rel_fk_given_q(cq, x, side): an element of `foreign_keys=` names a column of the declaring class (a bare name in
// its body, `Own.col`, "col", "Own.col") or of the target (`B.col`, "B.col").
.decl sa_rel_fk_given_q(cq: symbol, x: symbol, side: symbol)
sa_rel_fk_given_q(cq, x, "local") :- sa_rel_ok_q(cq, x), sa_rel_fk_local_q(cq, x).
sa_rel_fk_given_q(cq, x, side) :- sa_rel_fk_obj_q(cq, x, oq), sa_rel_target_q(cq, x, mq), cq != mq,
    (oq = cq, side = "local" ; oq = mq, side = "remote").
sa_rel_fk_given_q(cq, x, side) :- sa_rel_fk_objname_q(cq, x, on), sa_rel_target_q(cq, x, mq), cq != mq,
    sa_model_named(on, oq), (oq = cq, side = "local" ; oq = mq, side = "remote").
// sa_fk_on_q(cq, col, mq): column col of class cq, or of a class of the run among its bases, has a ForeignKey to
// model mq's table: `ForeignKey("tbl.id")` (in `Column`, `mapped_column`, `db.Column`), SQLModel's `Field(foreign_key=
// "tbl.id")`, or `ForeignKey(M.id)`.
.decl sa_fk_on_q(cq: symbol, col: symbol, mq: symbol)
sa_fk_on_q(cq, col, mq) :- sa_fk_col_q(cq, col, mq).
sa_fk_on_q(cq, col, mq) :- sa_model_super_q(cq, bq), sa_fk_col_q(bq, col, mq).
.decl sa_fk_col_q(cq: symbol, col: symbol, mq: symbol)
sa_fk_col_q(cq, col, mq) :- sa_fk_tbl_q(cq, col, tb), sa_table_named(mq, tb).
sa_fk_col_q(cq, col, mq) :- sa_fk_ref_q(cq, col, mq), sa_model_q(mq).
// Stated in the class's file: sa_fk_tbl_q(cq, col, tb), column col's ForeignKey names table tb; sa_fk_ref_q(cq, col,
// oq), it is `ForeignKey(O.id)`, O resolving to oq.
.decl sa_fk_tbl_q(cq: symbol, col: symbol, tb: symbol)
sa_fk_tbl_q(cq, col, tb) :- class_def(c, cq), sa_class_attr(c, col, v, _), sa_fk_table(v, tb).
.decl sa_fk_ref_q(cq: symbol, col: symbol, oq: symbol)
sa_fk_ref_q(cq, col, oq) :- class_def(c, cq), sa_class_attr(c, col, v, _), (k = v ; within(k, v)), kind(k, "call"),
    call_name(k, "ForeignKey"), posarg(k, 0, a), unparen(a, aa), attr_of(aa, o, _), sym_of(o, oq).
.decl sa_fk_table(v: node, tb: symbol)
sa_fk_table(v, tb) :- sa_class_attr(_, _, v, _), (k = v ; within(k, v)), kind(k, "call"), call_name(k, "ForeignKey"),
    posarg(k, 0, a), str(a, s), tb = @replace_all(s, "^(?:.*\\.)?([^.]+)\\.[^.]+$", "$1").
sa_fk_table(v, tb) :- sa_class_attr(_, _, v, _), (k = v ; within(k, v)), kind(k, "call"), call_arg(k, -1, "foreign_key", a),
    str(a, s), tb = @replace_all(s, "^(?:.*\\.)?([^.]+)\\.[^.]+$", "$1").
// sa_table_named(mq, tb): model mq maps table tb: its `__tablename__` literal, or, without one, its class name in
// lower or snake case (Flask-SQLAlchemy's default, and declared_attr bases that derive it).
.decl sa_table_named(mq: symbol, tb: symbol)
sa_table_named(mq, tb) :- sa_mapped_q(mq), sa_tablename_q(mq, tb).
sa_table_named(mq, tb) :- sa_mapped_q(mq), !sa_has_tablename_q(mq), split_dot(mq, _, n),
    (tb = @lower(n) ; tb = @lower(@replace_all(n, "([a-z0-9])([A-Z])", "${1}_${2}"))).
.decl sa_tablename_q(cq: symbol, tb: symbol)
sa_tablename_q(cq, tb) :- class_def(c, cq), sa_class_attr(c, "__tablename__", v, _), str(v, tb).
.decl sa_has_tablename_q(cq: symbol)
sa_has_tablename_q(cq) :- class_def(c, cq), sa_class_attr(c, "__tablename__", _, _).

// ---- statements --------------------------------------------------------------------------------------------------
// A statement's class mq is the symbol its argument resolves to; a rule's output asks sa_model_q whether it is a
// model.
.decl sa_select_fn(q: symbol)
sa_select_fn("sqlalchemy.select"). sa_select_fn("sqlalchemy.sql.select"). sa_select_fn("sqlalchemy.sql.expression.select").
sa_select_fn("sqlalchemy.future.select"). sa_select_fn("sqlmodel.select"). sa_select_fn("sqlmodel.sql.expression.select").
// sa_chain_method(m): methods of Select and Query that return the same kind of statement.
.decl sa_chain_method(m: symbol)
sa_chain_method("where"). sa_chain_method("filter"). sa_chain_method("filter_by"). sa_chain_method("order_by").
sa_chain_method("options"). sa_chain_method("join"). sa_chain_method("outerjoin"). sa_chain_method("limit").
sa_chain_method("offset"). sa_chain_method("with_for_update"). sa_chain_method("distinct").
sa_chain_method("group_by"). sa_chain_method("having"). sa_chain_method("execution_options").
sa_chain_method("select_from"). sa_chain_method("join_from"). sa_chain_method("params").
sa_chain_method("populate_existing"). sa_chain_method("enable_eagerloads"). sa_chain_method("slice").
sa_chain_method("correlate"). sa_chain_method("add_columns"). sa_chain_method("with_only_columns").
sa_chain_method("union"). sa_chain_method("prefix_with"). sa_chain_method("suffix_with").
sa_chain_method("yield_per"). sa_chain_method("autoflush"). sa_chain_method("with_entities").
sa_chain_method("reset_joinpoint"). sa_chain_method("execution_options").
.decl sa_select_of(s: node, mq: symbol)
sa_select_of(s, mq) :- unparen(s, e), kind(e, "call"), field(e, "function", f), sym_of(f, fq), sa_select_fn(fq),
    posarg(e, 0, r), sym_of(r, mq).
sa_select_of(s, mq) :- unparen(s, e), kind(e, "call"), field(e, "function", f), attr_of(f, o, m), sa_chain_method(m),
    sa_select_of(o, mq).
.decl sa_query_of(q: node, mq: symbol)
sa_query_of(q, mq) :- unparen(q, e), attr_of(e, o, "query"), sym_of(o, mq).
sa_query_of(q, mq) :- unparen(q, e), kind(e, "call"), field(e, "function", f), attr_of(f, _, "query"), posarg(e, 0, r),
    sym_of(r, mq).
sa_query_of(q, mq) :- unparen(q, e), kind(e, "call"), field(e, "function", f), attr_of(f, o, m), sa_chain_method(m),
    sa_query_of(o, mq).
.decl sa_stmt_of(s: node, mq: symbol)
sa_stmt_of(s, mq) :- sa_select_of(s, mq).
sa_stmt_of(s, mq) :- sa_query_of(s, mq).
// sa_stmt_has(s, m): statement chain s calls method m somewhere along it (its own last call included).
.decl sa_stmt_has(s: node, m: symbol)
sa_stmt_has(s, m) :- sa_stmt_of(s, _), unparen(s, e), kind(e, "call"), field(e, "function", f), attr_of(f, _, m).
sa_stmt_has(s, m) :- sa_stmt_of(s, _), unparen(s, e), kind(e, "call"), field(e, "function", f), attr_of(f, o, _),
    sa_stmt_has(o, m).
// sa_loader_fn(x): loader option functions, by last name (`orm.selectinload`, `selectinload`, `sa.orm.joinedload`).
.decl sa_loader_fn(x: symbol)
sa_loader_fn("selectinload"). sa_loader_fn("joinedload"). sa_loader_fn("subqueryload"). sa_loader_fn("immediateload").
sa_loader_fn("contains_eager"). sa_loader_fn("defaultload"). sa_loader_fn("lazyload"). sa_loader_fn("raiseload").
sa_loader_fn("noload"). sa_loader_fn("load_only"). sa_loader_fn("joinedload_all"). sa_loader_fn("selectin_polymorphic").
// sa_options_arg(s, a): a is an argument of an `.options(...)` call along chain s.
.decl sa_options_arg(s: node, a: node)
sa_options_arg(s, a) :- sa_stmt_of(s, _), unparen(s, e), kind(e, "call"), field(e, "function", f),
    attr_of(f, _, "options"), call_arg(e, _, _, a).
sa_options_arg(s, a) :- sa_stmt_of(s, _), unparen(s, e), kind(e, "call"), field(e, "function", f), attr_of(f, o, _),
    sa_options_arg(o, a).
// sa_stmt_loads_all(s): chain s's options hold a wildcard loader (`selectinload("*")`, `raiseload("*")`), which
// sets every relationship's strategy for the query.
.decl sa_stmt_loads_all(s: node)
sa_stmt_loads_all(s) :- sa_options_arg(s, a), sa_loader_names(a, "*").
// sa_loader_names(o, x): loader option expression o (and the loader calls chained in or nested under it) names
// attribute x: `selectinload(M.x)`, `joinedload("x")`, `selectinload(M.a).selectinload(A.x)`, `Load(M).selectinload(M.x)`.
.decl sa_loader_names(o: node, x: symbol)
sa_loader_names(o, x) :- within(c, o), kind(c, "call"), call_name(c, fn), sa_loader_fn(fn), call_arg(c, _, _, a),
    unparen(a, aa), attr_of(aa, _, x).
sa_loader_names(o, x) :- within(c, o), kind(c, "call"), call_name(c, fn), sa_loader_fn(fn), call_arg(c, _, _, a),
    str(a, x).
.decl sa_stmt_loads(s: node, x: symbol)
sa_stmt_loads(s, x) :- sa_options_arg(s, a), sa_loader_names(a, x).
// sa_rows(e, s, mq): expression e yields instances of mq, from statement s.
.decl sa_rows(e: node, s: node, mq: symbol)
// `session.scalars(s)` / `await session.scalars(s)`
sa_rows(e, s, mq) :- unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, _, "scalars"), posarg(c, 0, s),
    sa_select_of(s, mq).
// `session.execute(s).scalars()`
sa_rows(e, s, mq) :- unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, "scalars"), py_no_call_args(c),
    unparen(o, x), sa_awaited_or(x, xc), kind(xc, "call"), field(xc, "function", xf), attr_of(xf, _, "execute"),
    posarg(xc, 0, s), sa_select_of(s, mq).
// `….all()`, `.unique()`, `.fetchall()`, `.partitions()` aside: the same rows
sa_rows(e, s, mq) :- unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, m), sa_rows_method(m),
    unparen(o, x), sa_awaited_or(x, y), sa_rows(y, s, mq).
// `await <rows>`
sa_rows(e, s, mq) :- unparen(e, w), kind(w, "await"), child(w, c, 0), sa_rows(c, s, mq).
// a legacy query iterated, or `.all()` on it (covered above once the query is rows)
sa_rows(e, s, mq) :- unparen(e, s), sa_query_of(s, mq).
// a name the same scope binds to rows: `res = await session.scalars(s)`, `orders = q.all()`
sa_rows(e, s, mq) :- unparen(e, n), kind(n, "identifier"), text(n, x), look(n, x, sc), asg(sc, x, v, _),
    sa_rows(v, s, mq).
.decl sa_rows_method(m: symbol)
sa_rows_method("all"). sa_rows_method("unique"). sa_rows_method("fetchall"). sa_rows_method("yield_per").
sa_rows_method("scalars").
// sa_awaited_or(x, y): y is x, or what x awaits.
.decl sa_awaited_or(x: node, y: node)
sa_awaited_or(x, x) :- kind(x, k), k != "await".
sa_awaited_or(x, y) :- kind(x, "await"), child(x, c, 0), unparen(c, y).
sa_awaited_or(x, y) :- kind(x, "parenthesized_expression"), unparen(x, w), kind(w, "await"), child(w, c, 0), unparen(c, y).
.decl py_no_call_args(c: node)
py_no_call_args(c) :- kind(c, "call"), field(c, "arguments", al), count : { child(al, a, _), !kind(a, "comment") } = 0.
// sa_instance(e, mq): e holds one instance of class mq.
.decl sa_instance(e: node, mq: symbol)
sa_instance(a, mq) :- unparen(a, e), sa_instance_value(e, mq).
sa_instance(a, mq) :- unparen(a, e), kind(e, "identifier"), text(e, x), look(e, x, f), asg(f, x, v, _), unparen(v, w),
    sa_instance_value(w, mq).
sa_instance(a, mq) :- unparen(a, e), kind(e, "identifier"), text(e, x), look(e, x, f), sig_param(f, _, nm, _, _, t, _),
    text(nm, x), sa_ann_names(t, mq).
// `self.<a>` in a class whose methods assign `self.<a>` with a model annotation (`self._theme: Optional[Theme] =
// None`) or one instance of the model (`self._theme = session.get(Theme, pk)`)
sa_instance(a, mq) :- unparen(a, e), attr_of(e, o, x), kind(o, "identifier"), text(o, "self"),
    nearest(e, k, sa_class_node), sa_self_slot(k, x, mq).
.decl sa_self_slot(k: node, x: symbol, mq: symbol)
sa_self_slot(k, x, mq) :- kind(asn, "assignment"), field(asn, "left", l), attr_of(l, lo, x), kind(lo, "identifier"),
    text(lo, "self"), nearest(asn, k, sa_class_node), field(asn, "type", t), within(i, t), sym_of(i, mq).
sa_self_slot(k, x, mq) :- kind(asn, "assignment"), field(asn, "left", l), attr_of(l, lo, x), kind(lo, "identifier"),
    text(lo, "self"), nearest(asn, k, sa_class_node), field(asn, "right", v), unparen(v, w), sa_instance_value(w, mq).
.decl sa_ann_names(t: node, q: symbol)
sa_ann_names(t, q) :- sym_of(t, q).
sa_ann_names(t, q) :- kind(t, "type"), child(t, m, 0), sym_of(m, q).
.decl sa_instance_value(v: node, mq: symbol)
sa_instance_value(v, mq) :- kind(v, "call"), field(v, "function", f), sym_of(f, mq).
sa_instance_value(v, mq) :- kind(v, "await"), child(v, c, 0), unparen(c, w), sa_instance_value(w, mq).
// `session.get(M, pk)`, `session.get_one(M, pk)`, `db.get_or_404(M, pk)`
sa_instance_value(v, mq) :- kind(v, "call"), field(v, "function", f), attr_of(f, _, m),
    (m = "get" ; m = "get_one" ; m = "get_or_404"), posarg(v, 0, r), sym_of(r, mq).
// `session.query(M)….first()`, `M.query.get(1)`
sa_instance_value(v, mq) :- kind(v, "call"), field(v, "function", f), attr_of(f, o, m), sa_row_method(m),
    sa_query_of(o, mq).
// `session.scalar(select(M)…)`
sa_instance_value(v, mq) :- kind(v, "call"), field(v, "function", f), attr_of(f, _, "scalar"), posarg(v, 0, s),
    sa_select_of(s, mq).
// `session.execute(select(M)).scalar_one()`, `session.scalars(select(M)).first()`
sa_instance_value(v, mq) :- kind(v, "call"), field(v, "function", f), attr_of(f, o, m), sa_scalar_row_method(m),
    unparen(o, x0), sa_awaited_or(x0, x), kind(x, "call"), field(x, "function", xf), attr_of(xf, _, xm),
    (xm = "execute" ; xm = "scalars"), posarg(x, 0, s), sa_select_of(s, mq).
.decl sa_row_method(m: symbol)
sa_row_method("get"). sa_row_method("first"). sa_row_method("one"). sa_row_method("one_or_none").
sa_row_method("get_or_404"). sa_row_method("first_or_404"). sa_row_method("one_or_404").
.decl sa_scalar_row_method(m: symbol)
sa_scalar_row_method("scalar_one"). sa_scalar_row_method("scalar_one_or_none"). sa_scalar_row_method("first").
sa_scalar_row_method("one"). sa_scalar_row_method("one_or_none"). sa_scalar_row_method("scalar").

// ---- calls -------------------------------------------------------------------------------------------------------
// sa_callee_q(c, g): call c runs def g of the run, by symbol: the name its function resolves to, or the call graph's
// target (python/calls' call_target). A rule joins g with the facts g's own file states about it.
.decl sa_callee_q(c: node, g: symbol)
sa_callee_q(c, g) :- kind(c, "call"), field(c, "function", f), sym_of(f, g).
sa_callee_q(c, g) :- call_target(c, g).
// sa_returns(g, v): def g returns v.
.decl sa_returns(g: node, v: node)
sa_returns(g, v) :- kind(ret, "return_statement"), nearest(ret, g, fdef), child(ret, v, _), !kind(v, "comment").
// sa_param_q(g, i, x): def g (its symbol, pt_def) has parameter x at position i. Stated in g's file.
.decl sa_param_q(g: symbol, i: number, x: symbol)
sa_param_q(gq, i, x) :- kind(g, "function_definition"), pt_def(g, gq), sig_param(g, _, nm, i, _, _, _), text(nm, x).
// sa_param_for(g, i, b, x): positional argument i of a call of g fills g's parameter x: one further when the call is
// `obj.m(...)` (b "attr") and g's first parameter is self or cls (a bound method).
.decl sa_param_for(g: symbol, i: number, b: symbol, x: symbol)
sa_param_for(gq, i, "", x) :- sa_param_q(gq, i, x).
sa_param_for(gq, i, "attr", x) :- sa_param_q(gq, 0, s), (s = "self" ; s = "cls"), sa_param_q(gq, i1, x), i = i1 - 1,
    i >= 0.
sa_param_for(gq, i, "attr", x) :- sa_param_q(gq, 0, s), s != "self", s != "cls", sa_param_q(gq, i, x).
// sa_call_form(c, b): call c's function is an attribute (`obj.m(...)`, b "attr") or not (b "").
.decl sa_call_form(c: node, b: symbol)
sa_call_form(c, "attr") :- kind(c, "call"), field(c, "function", f), kind(f, "attribute").
sa_call_form(c, "") :- kind(c, "call"), field(c, "function", f), !kind(f, "attribute").

// ---- sessions ----------------------------------------------------------------------------------------------------
.decl sa_session_class(q: symbol)
sa_session_class("sqlalchemy.orm.Session"). sa_session_class("sqlalchemy.orm.session.Session").
sa_session_class("sqlalchemy.ext.asyncio.AsyncSession"). sa_session_class("sqlalchemy.ext.asyncio.session.AsyncSession").
sa_session_class("sqlalchemy.orm.scoped_session"). sa_session_class("sqlalchemy.orm.scoping.scoped_session").
sa_session_class("sqlmodel.Session"). sa_session_class("sqlmodel.orm.session.Session").
sa_session_class("sqlmodel.ext.asyncio.session.AsyncSession"). sa_session_class("sqlalchemy.ext.asyncio.async_scoped_session").
.decl sa_async_class(q: symbol)
sa_async_class("sqlalchemy.ext.asyncio.AsyncSession"). sa_async_class("sqlalchemy.ext.asyncio.session.AsyncSession").
sa_async_class("sqlmodel.ext.asyncio.session.AsyncSession"). sa_async_class("sqlalchemy.ext.asyncio.async_scoped_session").
.decl sa_class_kind(q: symbol, a: symbol)
sa_class_kind(q, "async") :- sa_async_class(q).
sa_class_kind(q, "sync") :- sa_session_class(q), !sa_async_class(q).
// sa_session_cls(e, q, a): e names session class q: SQLAlchemy's, or a class of the run deriving from one, its
// ancestors read through the phase py_names (by a module e's file reads, so the class may sit in another module).
.decl sa_session_cls(e: node, q: symbol, a: symbol)
sa_session_cls(e, q, a) :- sym_of(e, q), sa_class_kind(q, a).
sa_session_cls(e, q, a) :- sym_of(e, q), docof(e, d), doc(d, p, _), py_names__reads_at(p, m),
    py_names__ancestor(m, q, b), sa_class_kind(b, a).
.decl sa_factory_fn(q: symbol, a: symbol)
sa_factory_fn("sqlalchemy.orm.sessionmaker", "sync"). sa_factory_fn("sqlalchemy.orm.session.sessionmaker", "sync").
sa_factory_fn("sqlalchemy.orm.scoped_session", "sync"). sa_factory_fn("sqlalchemy.orm.scoping.scoped_session", "sync").
sa_factory_fn("sqlalchemy.ext.asyncio.async_sessionmaker", "async").
sa_factory_fn("sqlalchemy.ext.asyncio.session.async_sessionmaker", "async").
sa_factory_fn("sqlalchemy.ext.asyncio.async_scoped_session", "async").
// sa_factory_call(v, a): v makes a session factory: `sessionmaker(...)`, `async_sessionmaker(...)`, `scoped_session(...)`,
// or `sessionmaker(..., class_=AsyncSession)` (an async one).
.decl sa_factory_call(v: node, a: symbol)
sa_factory_call(v, a) :- sa_call_of(v, fq), sa_factory_fn(fq, a), !sa_class_kw_async(v).
sa_factory_call(v, "async") :- sa_call_of(v, fq), sa_factory_fn(fq, _), sa_class_kw_async(v).
.decl sa_class_kw_async(v: node)
sa_class_kw_async(v) :- unparen(v, k), call_arg(k, -1, "class_", c), sa_session_cls(c, _, "async").
// sa_factory_q(q, a): module attribute q holds a session factory. Stated in q's file.
.decl sa_factory_q(q: symbol, a: symbol)
sa_factory_q(q, a) :- sa_module_var(q, v), sa_factory_call(v, a).
// sa_scoped_var_q(q): module attribute q holds a scoped_session (`Session = scoped_session(...)`), used as a session
// itself (`Session.add(...)`). Stated in q's file.
.decl sa_scoped_var_q(q: symbol)
sa_scoped_var_q(q) :- sa_module_var(q, v), unparen(v, k), sa_call_of(k, fq), sa_scoped_q(fq), sa_factory_call(k, _).
// sa_session_new(c, k): call c makes a new session under condition k: a session class of the run or SQLAlchemy's, an
// inline factory, or a name the same scope binds to a factory (`maker = sessionmaker(...); s = maker()`), k ""; a
// call of a name resolving to q, no def of the run (python/calls finds no target), k "factory q": a session when q
// holds a session factory, which q's own file states (sa_factory_q).
.decl sa_session_new(c: node, k: symbol)
sa_session_new(c, "") :- kind(c, "call"), field(c, "function", f), sa_session_cls(f, q, _), !sa_scoped_q(q).
sa_session_new(c, cat("factory ", q)) :- kind(c, "call"), field(c, "function", f), sym_of(f, q), !call_target(c, _),
    !sa_session_cls(f, _, _).
sa_session_new(c, "") :- kind(c, "call"), field(c, "function", f), unparen(f, k), sa_factory_call(k, _).
sa_session_new(c, "") :- kind(c, "call"), field(c, "function", f), kind(f, "identifier"), text(f, x), look(f, x, s),
    asg(s, x, v, _), sa_factory_call(v, _).
.decl sa_scoped_q(q: symbol)
sa_scoped_q("sqlalchemy.orm.scoped_session"). sa_scoped_q("sqlalchemy.orm.scoping.scoped_session").
sa_scoped_q("sqlalchemy.ext.asyncio.async_scoped_session").
// sa_session_ann(t, a): annotation t names a session class, maybe inside Optional[...], `X | None`, Annotated[...].
.decl sa_session_ann(t: node, a: symbol)
sa_session_ann(t, a) :- within(e, t), sa_session_cls(e, q, a), !sa_scoped_q(q).
// sa_session(e, k): e holds a session, under condition k.
.decl sa_session(e: node, k: symbol)
// a name bound to a new session: `s = Session(engine)`, `s = SessionLocal()`, `s = await maker()` aside
sa_session(e, k) :- kind(e, "identifier"), text(e, x), look(e, x, s), asg(s, x, v, _), unparen(v, c), sa_session_new(c, k).
// `with Session(engine) as s:`, `async with maker() as s:`, `with maker.begin() as s:`
sa_session(e, k) :- kind(e, "identifier"), text(e, x), look(e, x, s), sa_with_bound(s, x, k).
// a parameter annotated as a session
sa_session(e, "") :- kind(e, "identifier"), text(e, x), look(e, x, f), sig_param(f, _, nm, _, _, t, _), text(nm, x),
    sa_session_ann(t, _).
// a variable annotated as a session: `s: Session = ...`
sa_session(e, "") :- kind(e, "identifier"), text(e, x), look(e, x, s), kind(asn, "assignment"), field(asn, "left", l),
    text(l, x), field(asn, "type", t), nearest(asn, s, scope), sa_session_ann(t, _).
// Flask-SQLAlchemy's `db.session`, a scoped session, when db holds the extension
sa_session(e, cat("flask ", q)) :- attr_of(e, o, "session"), sym_of(o, q).
// a module-level scoped_session: `Session = scoped_session(...)` used as `Session.add(...)`
sa_session(e, cat("scoped ", q)) :- sym_of(e, q), (kind(e, "identifier") ; kind(e, "attribute")).
// sa_with_bound(s, x, k): a with-statement in scope s binds x to a session, under condition k: `with <new session>
// as x`, or `with <factory or Session>.begin() as x` (a session in a transaction).
.decl sa_with_bound(s: node, x: symbol, k: symbol)
sa_with_bound(s, x, k) :- kind(wi, "with_item"), field(wi, "value", ap), kind(ap, "as_pattern"), child(ap, v, 0),
    unparen(v, c), sa_session_new(c, k), sa_as_name(ap, x), nearest(wi, s, scope).
sa_with_bound(s, x, "") :- kind(wi, "with_item"), field(wi, "value", ap), kind(ap, "as_pattern"), child(ap, v, 0),
    unparen(v, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, "begin"), sa_session_cls(o, _, _),
    sa_as_name(ap, x), nearest(wi, s, scope).
sa_with_bound(s, x, cat("factory ", q)) :- kind(wi, "with_item"), field(wi, "value", ap), kind(ap, "as_pattern"),
    child(ap, v, 0), unparen(v, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, "begin"), sym_of(o, q),
    !sa_session_cls(o, _, _), sa_as_name(ap, x), nearest(wi, s, scope).
.decl sa_as_name(ap: node, x: symbol)
sa_as_name(ap, x) :- kind(ap, "as_pattern"), field(ap, "alias", t), within(i, t), kind(i, "identifier"), text(i, x).
// sa_session_like(e, k): sa_session, or spelled like one in a file importing SQLAlchemy: `session`, `db_session`,
// `*_session`, `self.session`, `self._session`, `self.db_session` (k ""); or a parameter of any name that a caller in
// the run fills with a session (FastAPI's unannotated `db`, called as `import_tags(db, names)` from a route whose `db:
// Session = Depends(get_db)`): k "param <g> <x>", e reading parameter x of def g (by its symbol).
.decl sa_session_like(e: node, k: symbol)
sa_session_like(e, k) :- sa_session(e, k).
sa_session_like(e, "") :- kind(e, "identifier"), text(e, x), sa_session_name(x), docof(e, d), sa_doc(d).
sa_session_like(e, "") :- attr_of(e, _, x), sa_session_name(x), docof(e, d), sa_doc(d).
sa_session_like(e, cat("param ", gq, " ", x)) :- sa_param_recv(e, g, x), pt_def(g, gq).
// sa_param_recv(e, g, x): e, the receiver of a method call in a file importing SQLAlchemy, reads parameter x of def g.
.decl sa_param_recv(e: node, g: node, x: symbol)
sa_param_recv(e, g, x) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, _), unparen(o, e), kind(e, "identifier"),
    text(e, x), x != "self", x != "cls", look(e, x, g), kind(g, "function_definition"), param(g, x, _), docof(e, d),
    sa_doc(d).
// What each file's calls pass for a parameter, by the callee's symbol: sa_pass_kw_q(g, x, k), a call of g passes a
// session (under condition k) for its parameter x by keyword; sa_pass_pos_q(g, i, b, k), as its positional argument i,
// in call form b (sa_call_form).
.decl sa_pass_kw_q(g: symbol, x: symbol, k: symbol)
sa_pass_kw_q(gq, x, k) :- kind(c, "call"), sa_callee_q(c, gq), call_arg(c, -1, x, a), sa_session(a, k).
.decl sa_pass_pos_q(g: symbol, i: number, b: symbol, k: symbol)
sa_pass_pos_q(gq, i, b, k) :- kind(c, "call"), sa_callee_q(c, gq), posarg(c, i, a), sa_session(a, k), sa_call_form(c, b).
// sa_session_key(k): condition k holds: "" always; "factory q", module attribute q holds a session factory; "flask
// q", it holds a Flask-SQLAlchemy extension; "scoped q", a scoped_session; "param g x", a call of def g in the run
// passes a session for its parameter x (by keyword or position; a session under a condition that holds). It spans
// files on purpose (a factory, an extension and a caller sit in other modules than the session's use), keyed by
// symbols alone.
.decl sa_session_key(k: symbol) cross_file
sa_session_key("").
sa_session_key(cat("factory ", q)) :- sa_factory_q(q, _).
sa_session_key(cat("flask ", q)) :- sa_flask_db_q(q).
sa_session_key(cat("scoped ", q)) :- sa_scoped_var_q(q).
sa_session_key(cat("param ", gq, " ", x)) :- sa_pass_kw_q(gq, x, k), sa_session_key(k).
sa_session_key(cat("param ", gq, " ", x)) :- sa_pass_pos_q(gq, i, b, k), sa_param_for(gq, i, b, x), sa_session_key(k).
.decl sa_session_name(x: symbol)
sa_session_name(x) :- match("_?(?:db_|async_|sync_|orm_|read_|write_)?session", x).
.decl sa_session_call(c: node, s: node, m: symbol, k: symbol)
sa_session_call(c, s, m, k) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m), unparen(o, s),
    sa_session_like(s, k).
// sa_tx_with(w, b): `with x.begin():`/`with x.begin() as s:` (x a session, sessionmaker or engine) and
// `with x.begin_nested():`; b is its body.
.decl sa_tx_with(w: node, b: node)
sa_tx_with(w, b) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", v), sa_begin_value(v), field(w, "body", b).
.decl sa_begin_value(v: node)
sa_begin_value(v) :- unparen(v, k), kind(k, "call"), field(k, "function", f), attr_of(f, _, m),
    (m = "begin" ; m = "begin_nested").
sa_begin_value(v) :- kind(v, "as_pattern"), child(v, e, 0), sa_begin_value(e).

// ---- writes ------------------------------------------------------------------------------------------------------
.decl sa_dml_fn(q: symbol, op: symbol)
sa_dml_fn("sqlalchemy.insert", "insert"). sa_dml_fn("sqlalchemy.update", "update"). sa_dml_fn("sqlalchemy.delete", "delete").
sa_dml_fn("sqlalchemy.sql.insert", "insert"). sa_dml_fn("sqlalchemy.sql.update", "update").
sa_dml_fn("sqlalchemy.sql.delete", "delete"). sa_dml_fn("sqlalchemy.sql.expression.insert", "insert").
sa_dml_fn("sqlalchemy.sql.expression.update", "update"). sa_dml_fn("sqlalchemy.sql.expression.delete", "delete").
sa_dml_fn("sqlalchemy.dialects.postgresql.insert", "insert"). sa_dml_fn("sqlalchemy.dialects.mysql.insert", "insert").
sa_dml_fn("sqlalchemy.dialects.sqlite.insert", "insert"). sa_dml_fn("sqlmodel.insert", "insert").
sa_dml_fn("sqlmodel.update", "update"). sa_dml_fn("sqlmodel.delete", "delete").
// sa_model_expr(e, mr): expression e names a model as the target of a statement: the class itself (mr its symbol);
// its `__table__`, whose Core writes skip the model's hooks the same way; or `self.<a>`/`cls.<a>` in a method of
// class k (mr "self <k> <a>"), the model k or a class of the run deriving from it binds class attribute a to (a
// generic repository's `model = Item`; sa_model_of resolves it, across files).
.decl sa_model_expr(e: node, mr: symbol)
sa_model_expr(e, mq) :- sym_of(e, mq).
sa_model_expr(e, mq) :- unparen(e, a), attr_of(a, o, "__table__"), sym_of(o, mq).
sa_model_expr(e, cat("self ", kq, " ", x)) :- sa_self_attr_need(e, k, x), class_def(k, kq).
// sa_self_attr_need(e, k, x): e, the first argument of a DML call, is `self.x`/`cls.x` in a method of class k.
.decl sa_self_attr_need(e: node, k: node, x: symbol)
sa_self_attr_need(e, k, x) :- kind(c, "call"), field(c, "function", f), sym_of(f, fq), sa_dml_fn(fq, _),
    posarg(c, 0, e), unparen(e, a), attr_of(a, o, x), kind(o, "identifier"), (text(o, "self") ; text(o, "cls")),
    nearest(a, k, sa_class_node).
.decl sa_class_node(k: symbol)
sa_class_node("class_definition").
// sa_self_ref_q(mr, kq, x): model reference mr is "self <kq> <x>" (sa_model_expr). Stated in kq's file.
.decl sa_self_ref_q(mr: symbol, kq: symbol, x: symbol)
sa_self_ref_q(cat("self ", kq, " ", x), kq, x) :- sa_self_attr_need(_, k, x), class_def(k, kq).
// sa_dml(s, op, mr): s is an insert/update/delete statement on model reference mr (sa_model_expr), or a chain from one.
.decl sa_dml(s: node, op: symbol, mr: symbol)
sa_dml(s, op, mr) :- unparen(s, k), kind(k, "call"), field(k, "function", f), sym_of(f, fq), sa_dml_fn(fq, op),
    posarg(k, 0, r), sa_model_expr(r, mr).
sa_dml(s, op, mr) :- unparen(s, k), kind(k, "call"), field(k, "function", f), attr_of(f, o, _), sa_dml(o, op, mr).
// sa_dml_q(dk, op, mr): the same by the chain's term dk (pt_tm), stated in its file.
.decl sa_dml_q(dk: symbol, op: symbol, mr: symbol)
sa_dml_q(dk, op, mr) :- sa_dml(d, op, mr), pt_tm(d, dk).
// sa_stmt_need(e): e is the statement argument of an `.execute(...)` call, a value a def returns, or a value either
// is built from: what a name it reads is bound to.
.decl sa_stmt_need(e: node)
sa_stmt_need(s) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, "execute"), posarg(c, 0, s).
sa_stmt_need(v) :- sa_returns(_, v).
sa_stmt_need(v) :- sa_stmt_need(s), unparen(s, n), kind(n, "identifier"), text(n, x), look(n, x, sc), asg(sc, x, v, _).
// sa_dml_leaf(s, d): needed value s is DML chain d, itself or through a name the scope binds to it (`stmt =
// update(M)…; session.execute(stmt)`). sa_call_leaf(s, g): it is a call of def g, so what g returns (`session.execute(
// build_update(new))`), itself or through a name.
.decl sa_dml_leaf(s: node, d: node)
sa_dml_leaf(s, d) :- sa_stmt_need(s), unparen(s, d), sa_dml(d, _, _).
sa_dml_leaf(s, d) :- sa_stmt_need(s), unparen(s, n), kind(n, "identifier"), text(n, x), look(n, x, sc),
    asg(sc, x, v, _), sa_dml_leaf(v, d).
.decl sa_call_leaf(s: node, g: symbol)
sa_call_leaf(s, gq) :- sa_stmt_need(s), unparen(s, k), kind(k, "call"), sa_callee_q(k, gq).
sa_call_leaf(s, gq) :- sa_stmt_need(s), unparen(s, n), kind(n, "identifier"), text(n, x), look(n, x, sc),
    asg(sc, x, v, _), sa_call_leaf(v, gq).
// What a def returns, stated in its file by its symbol: sa_fn_dml_leaf_q(g, dk), DML chain dk; sa_fn_call_leaf_q(g,
// h), what def h returns.
.decl sa_fn_dml_leaf_q(g: symbol, dk: symbol)
sa_fn_dml_leaf_q(gq, dk) :- sa_returns(g, v), sa_dml_leaf(v, d), pt_def(g, gq), pt_tm(d, dk).
.decl sa_fn_call_leaf_q(g: symbol, h: symbol)
sa_fn_call_leaf_q(gq, hq) :- sa_returns(g, v), sa_call_leaf(v, hq), pt_def(g, gq).
// sa_fn_dml_q(g, dk): def g returns DML chain dk, through further calls, across files.
.decl sa_fn_dml_q(g: symbol, dk: symbol)
sa_fn_dml_q(gq, dk) :- sa_fn_dml_leaf_q(gq, dk).
sa_fn_dml_q(gq, dk) :- sa_fn_call_leaf_q(gq, hq), sa_fn_dml_q(hq, dk).
// sa_exec_q(c, wk): call c is `….execute(...)`, wk its term. sa_exec_dml_q(wk, dk), sa_exec_call_q(wk, g): its
// statement is DML chain dk, or what def g returns. sa_exec_stmt_q(wk, dk): the chain it runs, across files.
.decl sa_exec_q(c: node, wk: symbol)
sa_exec_q(c, wk) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, "execute"), pt_tm(c, wk).
.decl sa_exec_dml_q(wk: symbol, dk: symbol)
sa_exec_dml_q(wk, dk) :- sa_exec_q(c, wk), posarg(c, 0, s), sa_dml_leaf(s, d), pt_tm(d, dk).
.decl sa_exec_call_q(wk: symbol, g: symbol)
sa_exec_call_q(wk, gq) :- sa_exec_q(c, wk), posarg(c, 0, s), sa_call_leaf(s, gq).
.decl sa_exec_stmt_q(wk: symbol, dk: symbol)
sa_exec_stmt_q(wk, dk) :- sa_exec_dml_q(wk, dk).
sa_exec_stmt_q(wk, dk) :- sa_exec_call_q(wk, gq), sa_fn_dml_q(gq, dk).
// sa_bulk_local_q(wk, op, mr): call wk writes rows of mr in bulk by its own syntax: `session.query(M)….update({...})`,
// `.delete()`, `M.query.filter(...).delete()` (op the method); `session.bulk_insert_mappings(M, rows)`,
// `bulk_update_mappings(M, rows)` (op the method's name).
.decl sa_bulk_local_q(wk: symbol, op: symbol, mr: symbol)
sa_bulk_local_q(wk, op, mq) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, op), (op = "update" ; op = "delete"),
    sa_query_of(o, mq), pt_tm(c, wk).
sa_bulk_local_q(wk, m, mr) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, m),
    (m = "bulk_insert_mappings" ; m = "bulk_update_mappings"), posarg(c, 0, r), sa_model_expr(r, mr), pt_tm(c, wk).

// ---- events ------------------------------------------------------------------------------------------------------
.decl sa_event_fn(q: symbol, how: symbol)
sa_event_fn("sqlalchemy.event.listen", "listen"). sa_event_fn("sqlalchemy.event.api.listen", "listen").
sa_event_fn("sqlalchemy.event.listens_for", "listens_for"). sa_event_fn("sqlalchemy.event.api.listens_for", "listens_for").
// sa_event_call(c, tgt, ev): c is `event.listen(tgt, "ev", fn)` or `@event.listens_for(tgt, "ev")`.
.decl sa_event_call(c: node, tgt: node, ev: symbol)
sa_event_call(c, t, ev) :- kind(c, "call"), field(c, "function", f), sym_of(f, fq), sa_event_fn(fq, _), posarg(c, 0, t),
    posarg(c, 1, e), str(e, ev).

// ---- text SQL ----------------------------------------------------------------------------------------------------
.decl sa_text_fn(q: symbol)
sa_text_fn("sqlalchemy.text"). sa_text_fn("sqlalchemy.sql.text"). sa_text_fn("sqlalchemy.sql.expression.text").
sa_text_fn("sqlmodel.text"). sa_text_fn("sqlalchemy.sql.elements.TextClause").
.decl sa_text_call(c: node)
sa_text_call(c) :- kind(c, "call"), field(c, "function", f), sym_of(f, q), sa_text_fn(q).

// ---- files -------------------------------------------------------------------------------------------------------
// sa_import_module(i, m): import statement i names module m.
.decl sa_import_module(i: node, m: symbol)
sa_import_module(i, m) :- import_alias(i, _, m, _, _).
sa_import_module(i, m) :- kind(i, "import_from_statement"), module_text(i, m).
.decl sa_doc(d: number)
sa_doc(d) :- sa_import_module(i, m), (m = "sqlalchemy" ; prefix("sqlalchemy.", m) ; m = "sqlmodel" ;
    prefix("sqlmodel.", m) ; m = "flask_sqlalchemy" ; prefix("flask_sqlalchemy.", m)), docof(i, d).
.decl sa_test_doc(d: number)
sa_test_doc(d) :- doc(d, _, _), (path_part(d, "tests") ; path_part(d, "test") ; path_part(d, "testing") ;
    path_part(d, "unittests")).
sa_test_doc(d) :- file_name(d, s), (glob("test_*.py", s) ; glob("*_tests.py", s) ; glob("*_test.py", s) ;
    s = "tests.py" ; s = "test.py" ; s = "conftest.py").
// sa_migration_doc(d): an Alembic revision or env.py (`from alembic import op` / `context`), or a file under
// migrations/versions. A module that imports `alembic.command` to run upgrades (a CLI) is no migration.
.decl sa_migration_doc(d: number)
sa_migration_doc(d) :- ifrom(s, _, "alembic", y), (y = "op" ; y = "context"), docof(s, d).
sa_migration_doc(d) :- doc(d, _, _), path_part(d, "versions"), (path_part(d, "migrations") ; path_part(d, "alembic") ;
    path_part(d, "revisions")).
.decl sa_async_def(f: node)
sa_async_def(f) :- kind(f, "function_definition"), is_async(f).
.decl sa_region_stop(k: symbol)
sa_region_stop("function_definition"). sa_region_stop("lambda"). sa_region_stop("class_definition").
