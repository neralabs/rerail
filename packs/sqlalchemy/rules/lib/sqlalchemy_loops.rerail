// lib/sqlalchemy_loops: loops over ORM rows and the relationships they read on each row, for the lazy-load rules.
// Include it after lib/sqlalchemy.rerail.
//
// Interface
//   sl_hit(u, x, rel, mq, s, src, how)  u reads relationship rel, which loads lazily on model mq, once per row of a
//                                       loop over the rows of statement s; x is the loop's name; src names the
//                                       statement in a message; how is "loop" (the loop iterates the statement) or
//                                       "callee" (a function of the run returns the rows); s loads no option for rel,
//                                       is not streamed, and the read is in no test or migration
//   sl_first(u, rel)                    u is the first such read of rel in its loop (one finding per loop and
//                                       relationship)
//
// A loop is a for statement or a comprehension. The name it binds per row is the plain target (`for o in rows`), the
// second name of `for i, o in enumerate(rows)`, or the n-th name of `for o, l in session.execute(select(Order,
// Line))`, the n-th entity of a statement that selects several. A read is `x.rel` evaluated in the loop's own per-row
// code (outside nested defs, lambdas and classes, and outside the comprehension's first iterable), or a call there that
// passes x to a function of the run which reads `p.rel` on that parameter; `x.rel = v` stores are no reads.
//   for o in session.scalars(select(Order)): o.lines                        sl_hit(<o.lines>, "o", "lines", ...)
//   [describe(o) for o in session.scalars(select(Order))]                   sl_hit(<describe(o)>, ...) when
//                                                                            describe reads o.lines
// The rows come from a statement in the same function (`session.scalars(select(M)…)`, `….all()`, a legacy query,
// a statement or rows held in a name), or from a function of the run the loop calls, one hop, that returns them.
// A statement loads rel when a loader option names it (or a wildcard) on its chain or on an `.options(...)` call in
// the function that builds it, including options splatted from a name (`.options(*OPTS)`, `OPTS =
// [selectinload(M.x)]`); an option list it cannot read (`.options(*opts)`, opts a parameter) counts as loading
// everything. `yield_per` streams are left alone.

// sl_loop(x, b, r, bs, j): a loop binds name x, in scope bs, per item of iterable r; b is the per-item code (a for
// body, or the comprehension, whose first iterable r is excluded where reads are taken); j is -1 when x is the whole
// item and the item's position in a row tuple otherwise.
.decl sl_loop(x: symbol, b: node, r: node, bs: node, j: number)
sl_loop(x, b, r, bs, -1) :- (kind(st, "for_statement") ; kind(st, "async_for_statement")), field(st, "left", l),
    kind(l, "identifier"), text(l, x), field(st, "right", r), field(st, "body", b), nearest(st, bs, lfscope).
sl_loop(x, c, r, c, -1) :- kind(fc, "for_in_clause"), field(fc, "left", l), kind(l, "identifier"), text(l, x),
    field(fc, "right", r), child(c, fc, _), sl_comp(c).
sl_loop(x, b, r, bs, j) :- (kind(st, "for_statement") ; kind(st, "async_for_statement")), field(st, "left", l),
    sl_tuple_target(l, x, j0, n), field(st, "right", r0), sl_unpack(r0, j0, n, r, j), field(st, "body", b),
    nearest(st, bs, lfscope).
sl_loop(x, c, r, c, j) :- kind(fc, "for_in_clause"), field(fc, "left", l), sl_tuple_target(l, x, j0, n),
    field(fc, "right", r0), sl_unpack(r0, j0, n, r, j), child(c, fc, _), sl_comp(c).
.decl sl_comp(c: node)
sl_comp(c) :- kind(c, "list_comprehension") ; kind(c, "set_comprehension") ; kind(c, "dictionary_comprehension") ;
    kind(c, "generator_expression").
// sl_tuple_target(l, x, j, n): loop target l unpacks n plain names, x the j-th (`for i, o in ...`).
.decl sl_tuple_target(l: node, x: symbol, j: number, n: number)
sl_tuple_target(l, x, j, n) :- (kind(l, "pattern_list") ; kind(l, "tuple_pattern")), child(l, y, k), kind(y, "identifier"),
    text(y, x), j = count : { child(l, y2, k2), kind(y2, "identifier"), k2 < k },
    n = count : { child(l, y3, _), !kind(y3, ",") , !kind(y3, "("), !kind(y3, ")") }.
// sl_unpack(r0, j0, n, r, j): `enumerate(r)` with two names gives r's items to the second; any other iterable gives
// its rows' j-th entity to the j-th name.
.decl sl_unpack(r0: node, j0: number, n: number, r: node, j: number)
sl_unpack(r0, 1, 2, r, -1) :- sl_tuple_iter(r0, _), unparen(r0, k), kind(k, "call"), call_name(k, "enumerate"),
    posarg(k, 0, r).
sl_unpack(r0, j, n, r0, j) :- sl_tuple_iter(r0, l), sl_tuple_target(l, _, j, n), !sl_enumerate(r0).
.decl sl_tuple_iter(r0: node, l: node)
sl_tuple_iter(r0, l) :- (kind(st, "for_statement") ; kind(st, "async_for_statement") ; kind(st, "for_in_clause")),
    field(st, "left", l), (kind(l, "pattern_list") ; kind(l, "tuple_pattern")), field(st, "right", r0).
.decl sl_enumerate(r0: node)
sl_enumerate(r0) :- unparen(r0, k), kind(k, "call"), call_name(k, "enumerate").

// sl_read(b, r, j, x, u, rel): u reads `x.rel` once per item of the loop, in its own code; or u is a call there that
// hands x to a function of the run reading `p.rel` on the parameter.
.decl sl_read(b: node, r: node, j: number, x: symbol, u: node, rel: symbol)
sl_read(b, r, j, x, u, rel) :- sl_loop(x, b, r, bs, j), attr_of(u, o, rel), kind(o, "identifier"), text(o, x),
    within_stop(u, b, sa_region_stop), !within(u, r), look(o, x, bs), !sl_stored(u).
sl_read(b, r, j, x, k, rel) :- sl_loop(x, b, r, bs, j), kind(k, "call"), within_stop(k, b, sa_region_stop), !within(k, r),
    sl_passes(k, x, bs, g, p), sl_param_read(g, p, rel).
.decl sl_stored(u: node)
sl_stored(u) :- kind(a, "assignment"), field(a, "left", u).
sl_stored(u) :- kind(a, "assignment"), field(a, "left", l), (kind(l, "pattern_list") ; kind(l, "tuple_pattern")),
    child(l, u, _).
// sl_passes(k, x, bs, g, p): call k passes the loop's name x (bound in bs) as parameter p of def g of the run.
.decl sl_passes(k: node, x: symbol, bs: node, g: node, p: symbol)
sl_passes(k, x, bs, g, p) :- sl_loop(x, b, _, bs, _), kind(k, "call"), within_stop(k, b, sa_region_stop), posarg(k, i, a),
    unparen(a, n), kind(n, "identifier"), text(n, x), look(n, x, bs), sa_callee(k, g), sl_param_at(k, g, i, p).
sl_passes(k, x, bs, g, p) :- sl_loop(x, b, _, bs, _), kind(k, "call"), within_stop(k, b, sa_region_stop),
    call_arg(k, -1, p, a), unparen(a, n), kind(n, "identifier"), text(n, x), look(n, x, bs), sa_callee(k, g),
    sig_param(g, _, nm, _, _, _, _), text(nm, p).
// sl_param_at(k, g, i, p): positional argument i of call k fills g's parameter p (one further for a bound method).
.decl sl_param_at(k: node, g: node, i: number, p: symbol)
sl_param_at(k, g, i, p) :- posarg(k, i, _), sa_callee(k, g), sl_bound(k, g), sig_param(g, _, nm, i1, _, _, _),
    i1 = i + 1, text(nm, p).
sl_param_at(k, g, i, p) :- posarg(k, i, _), sa_callee(k, g), !sl_bound(k, g), sig_param(g, _, nm, i, _, _, _), text(nm, p).
.decl sl_bound(k: node, g: node)
sl_bound(k, g) :- sa_callee(k, g), field(k, "function", f), kind(f, "attribute"), sig_param(g, _, nm, 0, _, _, _),
    (text(nm, "self") ; text(nm, "cls")).
// sl_param_read(g, p, rel): def g reads `p.rel` in its own code, and never rebinds p (`instance = update(instance)`
// makes later reads another object's).
.decl sl_param_read(g: node, p: symbol, rel: symbol)
sl_param_read(g, p, rel) :- sl_passes(_, _, _, g, p), !sl_rebound(g, p), attr_of(u, o, rel), kind(o, "identifier"),
    text(o, p), within_stop(u, g, sa_region_stop), look(o, p, g), !sl_stored(u).
.decl sl_rebound(g: node, p: symbol)
sl_rebound(g, p) :- sl_passes(_, _, _, g, p), asg(g, p, _, _).

// ---- where the rows come from ------------------------------------------------------------------------------------
// sl_src(r, j, e, s, mq, src, how): the loop's iterable r yields instances of mq (at row position j) from statement
// s; e is the rows expression (r itself, or what the callee returns).
.decl sl_src(r: node, j: number, e: node, s: node, mq: symbol, src: symbol, how: symbol)
sl_src(r, -1, r, s, mq, "the statement the loop iterates", "loop") :- sl_iterable(r, -1), sl_rows(r, s, mq).
sl_src(r, -1, v, s, mq, @replace_all("the statement F() returns", "F", fname), "callee") :- sl_iterable(r, -1),
    sl_iter_call(r, c), sa_callee(c, g), sl_returns(g, v, s, mq), def_name(g, fname).
sl_src(r, j, r, s, mq, "the statement the loop iterates", "loop") :- sl_iterable(r, j), j >= 0, sl_tuple_rows(r, s, j, mq).
.decl sl_iterable(r: node, j: number)
sl_iterable(r, j) :- sl_loop(_, _, r, _, j).
// sl_rows(e, s, mq): lib's sa_rows, the same shapes over a statement held in a name, and a model's classmethod
// querying `cls`.
.decl sl_rows(e: node, s: node, mq: symbol)
sl_rows(e, s, mq) :- sa_rows(e, s, mq).
sl_rows(e, s, mq) :- unparen(e, s), sl_query_of(s, mq), !sa_query_of(s, _).
sl_rows(e, s, mq) :- unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, _, "scalars"), posarg(c, 0, n),
    sl_stmt_name(n, s, mq).
sl_rows(e, s, mq) :- unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, "scalars"),
    py_no_call_args(c), unparen(o, x), sa_awaited_or(x, xc), kind(xc, "call"), field(xc, "function", xf),
    attr_of(xf, _, "execute"), posarg(xc, 0, n), sl_stmt_name(n, s, mq).
sl_rows(e, s, mq) :- unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, m), sa_rows_method(m),
    unparen(o, x), sa_awaited_or(x, y), sl_rows(y, s, mq).
sl_rows(e, s, mq) :- unparen(e, w), kind(w, "await"), child(w, c, 0), sl_rows(c, s, mq).
sl_rows(e, s, mq) :- unparen(e, n), kind(n, "identifier"), text(n, x), look(n, x, sc), asg(sc, x, v, _), sl_rows(v, s, mq).
// sl_tuple_rows(e, s, j, mq): e yields row tuples whose j-th entity is an instance of mq: `session.execute(s)`,
// awaited, `….all()` on it, a legacy `session.query(A, B)`, or a name bound to one; s selects several entities.
.decl sl_tuple_rows(e: node, s: node, j: number, mq: symbol)
sl_tuple_rows(e, s, j, mq) :- unparen(e, c0), sa_awaited_or(c0, c), kind(c, "call"), field(c, "function", f),
    attr_of(f, _, "execute"), posarg(c, 0, s0), sl_stmt_or_name(s0, s), sl_entity(s, j, mq).
sl_tuple_rows(e, s, j, mq) :- unparen(e, s), sl_entity(s, j, mq), sl_is_query(s).
sl_tuple_rows(e, s, j, mq) :- unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, m), sa_rows_method(m),
    unparen(o, x), sa_awaited_or(x, y), sl_tuple_rows(y, s, j, mq).
sl_tuple_rows(e, s, j, mq) :- unparen(e, n), kind(n, "identifier"), text(n, x), look(n, x, sc), asg(sc, x, v, _),
    sl_tuple_rows(v, s, j, mq).
.decl sl_stmt_or_name(s0: node, s: node)
sl_stmt_or_name(s0, s) :- unparen(s0, s), kind(s, "call").
sl_stmt_or_name(s0, s) :- unparen(s0, n), kind(n, "identifier"), text(n, x), look(n, x, sc), asg(sc, x, s, _).
// sl_entity(s, j, mq): statement chain s selects several entities, model class mq at position j: `select(A, B)`,
// `session.query(A, B)`, chains from them.
.decl sl_entity(s: node, j: number, mq: symbol)
sl_entity(s, j, mq) :- unparen(s, e), kind(e, "call"), field(e, "function", f), sym_of(f, fq), sa_select_fn(fq),
    posarg(e, 1, _), posarg(e, j, r), sym_of(r, mq), sa_model_q(mq).
sl_entity(s, j, mq) :- unparen(s, e), kind(e, "call"), field(e, "function", f), attr_of(f, _, "query"), posarg(e, 1, _),
    posarg(e, j, r), sym_of(r, mq), sa_model_q(mq).
sl_entity(s, j, mq) :- unparen(s, e), kind(e, "call"), field(e, "function", f), attr_of(f, o, m), sa_chain_method(m),
    sl_entity(o, j, mq).
.decl sl_is_query(s: node)
sl_is_query(s) :- unparen(s, e), kind(e, "call"), field(e, "function", f), attr_of(f, _, "query").
sl_is_query(s) :- unparen(s, e), kind(e, "call"), field(e, "function", f), attr_of(f, o, m), sa_chain_method(m), sl_is_query(o).
// sl_stmt_name(n, s, mq): n is a name the same scope binds to statement s, `select(M)` or a chain from it.
.decl sl_stmt_name(n: node, s: node, mq: symbol)
sl_stmt_name(n, s, mq) :- unparen(n, i), kind(i, "identifier"), text(i, x), look(i, x, sc), asg(sc, x, s, _),
    sa_select_of(s, mq).
// sl_query_of(q, mq): lib's sa_query_of, and a legacy query over `cls` in a classmethod of model mq.
.decl sl_query_of(q: node, mq: symbol)
sl_query_of(q, mq) :- sa_query_of(q, mq).
sl_query_of(q, mq) :- unparen(q, e), attr_of(e, o, "query"), sl_cls_model(o, mq).
sl_query_of(q, mq) :- unparen(q, e), kind(e, "call"), field(e, "function", f), attr_of(f, _, "query"),
    posarg(e, 0, r), sl_cls_model(r, mq).
sl_query_of(q, mq) :- unparen(q, e), kind(e, "call"), field(e, "function", f), attr_of(f, o, m), sa_chain_method(m),
    sl_query_of(o, mq).
.decl sl_cls_model(e: node, mq: symbol)
sl_cls_model(e, mq) :- unparen(e, i), kind(i, "identifier"), text(i, "cls"), look(i, "cls", f), param(f, "cls", 0),
    nearest(f, c, scope), kind(c, "class_definition"), class_def(c, mq), sa_model_q(mq).
// sl_iter_call(r, c): loop iterable r is call c (maybe awaited), or a name the same scope binds to one.
.decl sl_iter_call(r: node, c: node)
sl_iter_call(r, c) :- sl_iterable(r, -1), unparen(r, e), sa_awaited_or(e, c), kind(c, "call").
sl_iter_call(r, c) :- sl_iterable(r, -1), unparen(r, n), kind(n, "identifier"), text(n, x), look(n, x, sc),
    asg(sc, x, v, _), unparen(v, e), sa_awaited_or(e, c), kind(c, "call").
// sl_returns(g, v, s, mq): def g returns v, rows of mq from statement s (a legacy query counts as its rows).
.decl sl_returns(g: node, v: node, s: node, mq: symbol)
sl_returns(g, v, s, mq) :- sa_returns(g, v), sl_rows(v, s, mq).

// ---- loaded with the rows -------------------------------------------------------------------------------------------
// sl_loaded(s, rel): the statement loads rel with the rows: a loader option naming it (or a wildcard) on its chain,
// or on an `.options(...)` call in the same function (a query built over several assignments).
.decl sl_loaded(s: node, rel: symbol)
sl_loaded(s, rel) :- sl_sought(s, rel), sl_chain_call(s, oc), sl_opt_arg(oc, a),
    (sl_loader_names(a, rel) ; sl_loader_names(a, "*")).
sl_loaded(s, rel) :- sl_sought(s, rel), nearest(s, f, scope), sl_opt_arg(oc, a), nearest(oc, f, scope),
    (sl_loader_names(a, rel) ; sl_loader_names(a, "*")).
// sl_chain_call(s, k): k is a call along statement chain s, s itself included.
.decl sl_chain_call(s: node, k: node)
sl_chain_call(s, k) :- sl_sought(s, _), unparen(s, k), kind(k, "call").
sl_chain_call(s, k) :- sl_chain_call(s, e), field(e, "function", f), attr_of(f, o, _), unparen(o, k), kind(k, "call").
// sl_opt_arg(oc, a): a is an argument of `.options(...)` call oc, a `*splat` included.
.decl sl_opt_arg(oc: node, a: node)
sl_opt_arg(oc, a) :- kind(oc, "call"), field(oc, "function", of), attr_of(of, _, "options"), call_arg(oc, _, _, a).
sl_opt_arg(oc, a) :- kind(oc, "call"), field(oc, "function", of), attr_of(of, _, "options"), field(oc, "arguments", al),
    child(al, a, _), kind(a, "list_splat").
// sl_loader_names(o, x): lib's sa_loader_names with the option o itself counted; options splatted from a name read
// through the name (in the same scope, the module, or imported); a splat the rule cannot read names "*".
.decl sl_loader_names(o: node, x: symbol)
sl_loader_names(o, x) :- sa_loader_names(o, x).
sl_loader_names(o, x) :- unparen(o, c), kind(c, "call"), call_name(c, fn), sa_loader_fn(fn), call_arg(c, _, _, a),
    unparen(a, aa), attr_of(aa, _, x).
sl_loader_names(o, x) :- unparen(o, c), kind(c, "call"), call_name(c, fn), sa_loader_fn(fn), call_arg(c, _, _, a),
    str(a, x).
sl_loader_names(o, x) :- sl_splat_value(o, v), sa_loader_names(v, x).
sl_loader_names(o, "*") :- sl_splat(o, _), !sl_splat_value(o, _).
.decl sl_splat(o: node, n: node)
sl_splat(o, n) :- sl_opt_arg(_, o), kind(o, "list_splat"), child(o, n0, _), !kind(n0, "*"), unparen(n0, n).
// sl_splat_value(o, v): the splatted name is bound to v, a literal list or tuple.
.decl sl_splat_value(o: node, v: node)
sl_splat_value(o, v) :- sl_splat(o, n), kind(n, "identifier"), text(n, x), look(n, x, sc), asg(sc, x, v, _),
    (kind(v, "list") ; kind(v, "tuple")).
sl_splat_value(o, v) :- sl_splat(o, n), sym_of(n, q), sa_module_var(q, v), (kind(v, "list") ; kind(v, "tuple")).
.decl sl_sought(s: node, rel: symbol)
sl_sought(s, rel) :- sl_read(_, r, j, _, _, rel), sl_src(r, j, _, s, _, _, _).
// sl_streamed(e): expression e asks for yield_per batches, or is a name bound to one.
.decl sl_streamed(e: node)
sl_streamed(e) :- sl_yield_node(e).
sl_streamed(e) :- within(n, e), sl_yield_node(n).
sl_streamed(e) :- unparen(e, n), kind(n, "identifier"), text(n, x), look(n, x, sc), asg(sc, x, v, _), sl_streamed(v).
// sl_streamed_fn(s): the function that builds statement s asks for yield_per somewhere.
.decl sl_streamed_fn(s: node)
sl_streamed_fn(s) :- sl_sought(s, _), nearest(s, f, scope), sl_yield_node(n), nearest(n, f, scope).
.decl sl_yield_node(n: node)
sl_yield_node(n) :- kind(n, "identifier"), text(n, "yield_per").
sl_yield_node(n) :- str(n, "yield_per").

// ---- the hits ------------------------------------------------------------------------------------------------------
.decl sl_hit(u: node, x: symbol, rel: symbol, mq: symbol, s: node, src: symbol, how: symbol)
sl_hit(u, x, rel, mq, s, src, how) :- sl_read(b, r, j, x, u, rel), sl_src(r, j, e, s, mq, src, how), class_def(c, mq),
    sa_lazy_rel(c, rel), !sl_loaded(s, rel), !sl_streamed(r), !sl_streamed(e), !sl_streamed_fn(s), docof(u, d),
    !sa_test_doc(d), !sa_migration_doc(d).
.decl sl_first(u: node, rel: symbol)
sl_first(u, rel) :- sl_hit(u, _, rel, _, _, _, _), sl_read(b, _, _, _, u, rel),
    count : { sl_hit(u2, _, rel, _, _, _, _), sl_read(b, _, _, _, u2, rel), u2 < u } = 0.
