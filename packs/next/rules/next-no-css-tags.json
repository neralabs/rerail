{
  "format": "rerail.policy/v1",
  "id": "next-no-css-tags",
  "revision": 2,
  "mode": "steer",
  "description": "Import local stylesheets instead of adding them with link tags, so Next.js can bundle and optimize the CSS; links to external stylesheet URLs are allowed.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "jsx_opening_element"
                  },
                  {
                    "kind": "jsx_self_closing_element"
                  }
                ]
              },
              {
                "has": {
                  "field": "name",
                  "kind": "identifier",
                  "regex": "^link$"
                }
              },
              {
                "has": {
                  "kind": "jsx_attribute",
                  "all": [
                    {
                      "has": {
                        "kind": "property_identifier",
                        "regex": "^rel$"
                      }
                    },
                    {
                      "has": {
                        "kind": "string",
                        "value": {
                          "eq": "stylesheet"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "kind": "jsx_attribute",
                  "all": [
                    {
                      "has": {
                        "kind": "property_identifier",
                        "regex": "^href$"
                      }
                    },
                    {
                      "has": {
                        "kind": "string",
                        "not": {
                          "value": {
                            "startsWith": "http"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-css-tags",
        "message": "Import this local stylesheet from the component (import './styles.css') instead of adding it with a link tag.",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-css-tags"
            ]
          },
          "oxlint": {
            "rules": [
              "no-css-tags"
            ]
          }
        }
      }
    }
  ]
}
