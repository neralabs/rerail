{
  "format": "rerail.policy/v1",
  "id": "next-no-head-import-in-document",
  "revision": 3,
  "mode": "steer",
  "description": "Use Head from next/document, not next/head, in pages/_document; next/head is meant for individual pages.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "path": {
              "regex": "^(?:[^p]|p(?:p|ap|agp|agep)*(?:[^pa]|a[^gp]|ag[^ep]|age[^sp]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?pages(?:(?:(?:[^p]|p(?:p|ap|agp|agep)*(?:[^pa]|a[^gp]|ag[^ep]|age[^sp]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?/)?_document(?:[^p/]|p(?:p|ap|agp|agep)*(?:[^pa/]|a[^gp/]|ag[^ep/]|age[^sp/]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?/*|/_document/index(?:\\.[^./]*)?/*)(?:pages.*)?$"
            }
          },
          "rule": {
            "kind": "import_statement",
            "all": [
              {
                "has": {
                  "field": "source",
                  "kind": "string",
                  "value": {
                    "eq": "next/head"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-head-import-in-document",
        "message": "Import Head from next/document instead of next/head in this custom Document.",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-head-import-in-document"
            ]
          },
          "oxlint": {
            "rules": [
              "no-head-import-in-document"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noHeadImportInDocument"
            ]
          }
        }
      }
    }
  ]
}
