{
  "format": "rerail.policy/v1",
  "id": "next-no-styled-jsx-in-document",
  "revision": 2,
  "mode": "steer",
  "description": "Don't use styled-jsx style tags in pages/_document; the custom Document does not support them.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "path": {
              "regex": "^(?:[^p]|p(?:p|ap|agp|agep)*(?:[^pa]|a[^gp]|ag[^ep]|age[^sp]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?pages(?:(?:(?:[^p]|p(?:p|ap|agp|agep)*(?:[^pa]|a[^gp]|ag[^ep]|age[^sp]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?/)?_document(?:[^p/]|p(?:p|ap|agp|agep)*(?:[^pa/]|a[^gp/]|ag[^ep/]|age[^sp/]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?/*|/_document/index(?:\\.[^./]*)?/*)(?:pages.*)?$"
            }
          },
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "jsx_opening_element"
                  },
                  {
                    "kind": "jsx_self_closing_element"
                  }
                ]
              },
              {
                "has": {
                  "field": "name",
                  "kind": "identifier",
                  "regex": "^style$"
                }
              },
              {
                "has": {
                  "kind": "jsx_attribute",
                  "all": [
                    {
                      "has": {
                        "kind": "property_identifier",
                        "regex": "^jsx$"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-styled-jsx-in-document",
        "message": "Move these styled-jsx styles out of pages/_document into a global stylesheet imported in pages/_app.",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-styled-jsx-in-document"
            ]
          },
          "oxlint": {
            "rules": [
              "no-styled-jsx-in-document"
            ]
          }
        }
      }
    }
  ]
}
