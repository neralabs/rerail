{
  "format": "rerail.policy/v1",
  "id": "next-no-assign-module-variable",
  "revision": 3,
  "mode": "steer",
  "description": "Don't declare a variable named module in Next.js code; it shadows the module object Node.js and the bundler rely on.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "any": [
                  {
                    "kind": "lexical_declaration"
                  },
                  {
                    "kind": "variable_declaration"
                  }
                ],
                "has": {
                  "kind": "variable_declarator",
                  "has": {
                    "field": "name",
                    "kind": "identifier",
                    "regex": "^module$"
                  }
                }
              },
              {
                "regex": "^(?:const|let|var)$",
                "inside": {
                  "kind": "for_in_statement",
                  "field": "kind",
                  "has": {
                    "field": "left",
                    "kind": "identifier",
                    "regex": "^module$"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-assign-module-variable",
        "message": "Do not assign to the variable `module`. See: https://nextjs.org/docs/messages/no-assign-module-variable",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-assign-module-variable"
            ]
          },
          "oxlint": {
            "rules": [
              "no-assign-module-variable"
            ]
          }
        }
      }
    }
  ]
}
