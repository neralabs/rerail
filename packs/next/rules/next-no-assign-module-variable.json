{
  "format": "rerail.policy/v1",
  "id": "next-no-assign-module-variable",
  "revision": 2,
  "mode": "steer",
  "description": "Don't declare a variable named module in Next.js code; it shadows the module object Node.js and the bundler rely on.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "lexical_declaration"
              },
              {
                "kind": "variable_declaration"
              }
            ],
            "has": {
              "kind": "variable_declarator",
              "has": {
                "field": "name",
                "kind": "identifier",
                "regex": "^module$"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-assign-module-variable",
        "message": "Rename this module variable, for example to mod; declaring module shadows the object Node.js and the bundler rely on.",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-assign-module-variable"
            ]
          },
          "oxlint": {
            "rules": [
              "no-assign-module-variable"
            ]
          }
        }
      }
    }
  ]
}
