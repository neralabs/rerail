{
  "format": "rerail.policy/v1",
  "id": "next-no-document-import-in-page",
  "revision": 3,
  "mode": "steer",
  "description": "Import next/document only in pages/_document; the custom Document API does not work in regular pages or components.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "path": {
              "notRegex": "pages(?:/_document(?:[^p]|p(?:p|ap|agp|agep)*(?:[^pa]|a[^gp]|ag[^ep]|age[^sp]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?)?$"
            }
          },
          "rule": {
            "kind": "import_statement",
            "all": [
              {
                "has": {
                  "field": "source",
                  "kind": "string",
                  "value": {
                    "eq": "next/document"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-document-import-in-page",
        "message": "Move this next/document import into pages/_document; the custom Document API does not work in pages or components.",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-document-import-in-page"
            ]
          },
          "oxlint": {
            "rules": [
              "no-document-import-in-page"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noDocumentImportInPage"
            ]
          }
        }
      }
    }
  ]
}
