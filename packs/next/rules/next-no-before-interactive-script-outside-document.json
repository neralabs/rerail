{
  "format": "rerail.policy/v1",
  "id": "next-no-before-interactive-script-outside-document",
  "revision": 3,
  "mode": "steer",
  "description": "Use the beforeInteractive strategy of next/script only in pages/_document or the app directory; elsewhere it cannot run before hydration.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "path": {
              "notRegex": "(?:^|/)app/|^(?:[^p]|p(?:p|ap|agp|agep)*(?:[^pa]|a[^gp]|ag[^ep]|age[^sp]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?pages(?:(?:[^p]|p(?:p|ap|agp|agep)*(?:[^pa]|a[^gp]|ag[^ep]|age[^sp]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?/)?_document(?:[^p/]|p(?:p|ap|agp|agep)*(?:[^pa/]|a[^gp/]|ag[^ep/]|age[^sp/]))*(?:p(?:p|ap|agp|agep)*(?:a|ag|age)?)?/*(?:pages.*)?$"
            }
          },
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "jsx_opening_element"
                  },
                  {
                    "kind": "jsx_self_closing_element"
                  }
                ]
              },
              {
                "has": {
                  "field": "name",
                  "kind": "identifier",
                  "pattern": "$N"
                }
              },
              {
                "has": {
                  "kind": "jsx_attribute",
                  "all": [
                    {
                      "has": {
                        "kind": "property_identifier",
                        "regex": "^strategy$"
                      }
                    },
                    {
                      "has": {
                        "kind": "string",
                        "value": {
                          "eq": "beforeInteractive"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "inside": {
                  "kind": "program",
                  "stopBy": "end",
                  "has": {
                    "kind": "import_statement",
                    "all": [
                      {
                        "has": {
                          "field": "source",
                          "kind": "string",
                          "value": {
                            "eq": "next/script"
                          }
                        }
                      },
                      {
                        "has": {
                          "kind": "import_clause",
                          "has": {
                            "kind": "identifier",
                            "pattern": "$N"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-before-interactive-script-outside-document",
        "message": "Move this beforeInteractive Script into pages/_document or the app directory, or switch it to afterInteractive.",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-before-interactive-script-outside-document"
            ]
          },
          "oxlint": {
            "rules": [
              "no-before-interactive-script-outside-document"
            ]
          },
          "biome": {
            "rules": [
              "lint/correctness/noBeforeInteractiveScriptOutsideDocument"
            ]
          }
        }
      }
    }
  ]
}
