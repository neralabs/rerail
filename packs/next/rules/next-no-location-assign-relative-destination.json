{
  "format": "rerail.policy/v1",
  "id": "next-no-location-assign-relative-destination",
  "revision": 1,
  "mode": "steer",
  "description": "@next/eslint-plugin-next 16.3.8 @next/next/no-location-assign-relative-destination: an assignment to location.href (or window/globalThis/document/self.location.href) or a call of its assign(), whose value's static string prefix is a relative URL.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "href",
      "forbid": {
        "ast": {
          "language": "typescript",
          "languageOptions": {
            "globals": {
              "location": "readonly",
              "window": "readonly",
              "document": "readonly",
              "self": "readonly"
            }
          },
          "utils": {
            "location-root": {
              "any": [
                {
                  "kind": "identifier",
                  "resolves": {
                    "global": [
                      "location"
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "member_expression",
                          "has": {
                            "field": "property",
                            "kind": "property_identifier",
                            "regex": "^location$"
                          }
                        },
                        {
                          "kind": "subscript_expression",
                          "has": {
                            "field": "index",
                            "kind": "string",
                            "value": {
                              "eq": "location"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "has": {
                        "field": "object",
                        "kind": "identifier",
                        "resolves": {
                          "global": [
                            "window",
                            "globalThis",
                            "document",
                            "self"
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "relative-prefix": {
              "any": [
                {
                  "value": {
                    "type": "string",
                    "follow": true
                  },
                  "not": {
                    "value": {
                      "regex": "^(?:[A-Za-z][0-9+.A-Za-z-]*:|//)",
                      "follow": true
                    }
                  }
                },
                {
                  "kind": "template_string",
                  "has": {
                    "kind": "template_substitution"
                  },
                  "not": {
                    "regex": "^`(?:[A-Za-z][0-9+.A-Za-z-]*:|//)"
                  }
                },
                {
                  "kind": "binary_expression",
                  "has": {
                    "field": "operator",
                    "regex": "^\\+$"
                  },
                  "all": [
                    {
                      "has": {
                        "field": "left",
                        "matches": "relative-prefix"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "relative-prefix"
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "value": {
                        "matches": "relative-prefix"
                      }
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "occurrence": {
                        "kind": "identifier",
                        "inside": {
                          "kind": "assignment_expression",
                          "field": "left",
                          "has": {
                            "field": "right",
                            "matches": "relative-prefix"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "assignment_expression",
            "all": [
              {
                "has": {
                  "field": "left",
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "member_expression",
                          "has": {
                            "field": "property",
                            "kind": "property_identifier",
                            "regex": "^href$"
                          }
                        },
                        {
                          "kind": "subscript_expression",
                          "has": {
                            "field": "index",
                            "kind": "string",
                            "value": {
                              "eq": "href"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "has": {
                        "field": "object",
                        "matches": "location-root"
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "right",
                  "matches": "relative-prefix"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-location-assign-relative-destination",
        "message": "Do not use `location` to navigate to internal Next.js pages. Use `redirect()` in the render phase, or `useRouter().push()` in Client Components' event handlers instead. See: https://nextjs.org/docs/messages/no-location-assign-relative-destination",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-location-assign-relative-destination"
            ]
          }
        }
      }
    },
    {
      "id": "assign",
      "forbid": {
        "ast": {
          "language": "typescript",
          "languageOptions": {
            "globals": {
              "location": "readonly",
              "window": "readonly",
              "document": "readonly",
              "self": "readonly"
            }
          },
          "utils": {
            "location-root": {
              "any": [
                {
                  "kind": "identifier",
                  "resolves": {
                    "global": [
                      "location"
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "member_expression",
                          "has": {
                            "field": "property",
                            "kind": "property_identifier",
                            "regex": "^location$"
                          }
                        },
                        {
                          "kind": "subscript_expression",
                          "has": {
                            "field": "index",
                            "kind": "string",
                            "value": {
                              "eq": "location"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "has": {
                        "field": "object",
                        "kind": "identifier",
                        "resolves": {
                          "global": [
                            "window",
                            "globalThis",
                            "document",
                            "self"
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "relative-prefix": {
              "any": [
                {
                  "value": {
                    "type": "string",
                    "follow": true
                  },
                  "not": {
                    "value": {
                      "regex": "^(?:[A-Za-z][0-9+.A-Za-z-]*:|//)",
                      "follow": true
                    }
                  }
                },
                {
                  "kind": "template_string",
                  "has": {
                    "kind": "template_substitution"
                  },
                  "not": {
                    "regex": "^`(?:[A-Za-z][0-9+.A-Za-z-]*:|//)"
                  }
                },
                {
                  "kind": "binary_expression",
                  "has": {
                    "field": "operator",
                    "regex": "^\\+$"
                  },
                  "all": [
                    {
                      "has": {
                        "field": "left",
                        "matches": "relative-prefix"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "relative-prefix"
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "value": {
                        "matches": "relative-prefix"
                      }
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "occurrence": {
                        "kind": "identifier",
                        "inside": {
                          "kind": "assignment_expression",
                          "field": "left",
                          "has": {
                            "field": "right",
                            "matches": "relative-prefix"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "member_expression",
                          "has": {
                            "field": "property",
                            "kind": "property_identifier",
                            "regex": "^assign$"
                          }
                        },
                        {
                          "kind": "subscript_expression",
                          "has": {
                            "field": "index",
                            "kind": "string",
                            "value": {
                              "eq": "assign"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "has": {
                        "field": "object",
                        "matches": "location-root"
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": 1,
                    "not": {
                      "kind": "spread_element"
                    },
                    "matches": "relative-prefix"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-location-assign-relative-destination",
        "message": "Do not use `location` to navigate to internal Next.js pages. Use `redirect()` in the render phase, or `useRouter().push()` in Client Components' event handlers instead. See: https://nextjs.org/docs/messages/no-location-assign-relative-destination",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-location-assign-relative-destination"
            ]
          }
        }
      }
    }
  ]
}
