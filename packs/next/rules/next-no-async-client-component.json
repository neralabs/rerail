{
  "format": "rerail.policy/v1",
  "id": "next-no-async-client-component",
  "revision": 3,
  "mode": "steer",
  "description": "Don't make the default-exported component of a \"use client\" file an async function; Client Components cannot be async.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "export-default-function",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "export_statement",
            "all": [
              {
                "inside": {
                  "kind": "program"
                }
              },
              {
                "regex": "^export\\s+default\\s"
              },
              {
                "has": {
                  "kind": "function_declaration",
                  "regex": "^async\\s",
                  "has": {
                    "field": "name",
                    "regex": "^[A-Z]"
                  }
                }
              },
              {
                "follows": {
                  "stopBy": "end",
                  "kind": "expression_statement",
                  "has": {
                    "kind": "string",
                    "value": {
                      "eq": "use client"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-async-client-component",
        "message": "Remove async from this Client Component and load its data in a parent Server Component or an effect instead.",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-async-client-component"
            ]
          },
          "oxlint": {
            "rules": [
              "no-async-client-component"
            ]
          },
          "biome": {
            "rules": [
              "lint/correctness/noNextAsyncClientComponent"
            ]
          }
        }
      }
    },
    {
      "id": "exported-declaration",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "inside": {
                  "kind": "program"
                }
              },
              {
                "any": [
                  {
                    "kind": "function_declaration",
                    "regex": "^async\\s",
                    "has": {
                      "field": "name",
                      "regex": "^[A-Z]",
                      "pattern": "$N"
                    }
                  },
                  {
                    "any": [
                      {
                        "kind": "lexical_declaration"
                      },
                      {
                        "kind": "variable_declaration"
                      }
                    ],
                    "has": {
                      "kind": "variable_declarator",
                      "all": [
                        {
                          "has": {
                            "field": "name",
                            "kind": "identifier",
                            "regex": "^[A-Z]",
                            "pattern": "$N"
                          }
                        },
                        {
                          "has": {
                            "field": "value",
                            "kind": "arrow_function",
                            "regex": "^async\\b"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "not": {
                  "follows": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_declaration",
                        "has": {
                          "field": "name",
                          "pattern": "$N"
                        }
                      },
                      {
                        "any": [
                          {
                            "kind": "lexical_declaration"
                          },
                          {
                            "kind": "variable_declaration"
                          }
                        ],
                        "has": {
                          "kind": "variable_declarator",
                          "has": {
                            "field": "name",
                            "kind": "identifier",
                            "pattern": "$N"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "inside": {
                  "kind": "program",
                  "stopBy": "end",
                  "has": {
                    "kind": "export_statement",
                    "all": [
                      {
                        "has": {
                          "kind": "identifier",
                          "pattern": "$N"
                        }
                      },
                      {
                        "follows": {
                          "stopBy": "end",
                          "kind": "expression_statement",
                          "has": {
                            "kind": "string",
                            "value": {
                              "eq": "use client"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/no-async-client-component",
        "message": "Remove async from this Client Component and load its data in a parent Server Component or an effect instead.",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/no-async-client-component"
            ]
          },
          "oxlint": {
            "rules": [
              "no-async-client-component"
            ]
          },
          "biome": {
            "rules": [
              "lint/correctness/noNextAsyncClientComponent"
            ]
          }
        }
      }
    }
  ]
}
