.policy "next-practice-public-env-secret" revision 1
.description "Never give a secret a NEXT_PUBLIC_ name or put it in next.config's env: Next.js inlines those values into every bundle that reads them, the browser's included."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/.env", "**/.env.*", "**/*.env", "**/Dockerfile", "**/Dockerfile.*", "**/*.Dockerfile", "**/*.dockerfile", "**/*.yml", "**/*.yaml", "**/turbo.json"
.scope text "**/*.env", "**/Dockerfile", "**/Dockerfile.*", "**/*.Dockerfile", "**/*.dockerfile", "**/*.yml", "**/*.yaml", "**/turbo.json"
.scope exclude "**/*.test.*", "**/*.spec.*", "**/*.cy.*", "**/__tests__/**", "**/test/**", "**/tests/**", "**/e2e/**", "**/__mocks__/**", "**/*.stories.*", "**/*.story.*", "**/__stories__/**", "**/__fixtures__/**", "**/fixtures/**", "**/node_modules/**", "**/dist/**", "**/build/**", "**/out/**", "**/.next/**", "**/coverage/**", "**/vendor/**", "**/.venv/**", "**/.yarn/**", "**/generated/**", "**/__generated__/**", "**/*.generated.*", "**/*.gen.*", "**/*.min.js", "**/*.d.ts", "**/pnpm-lock.yaml"
// Rerail's own rule, not a port. Next.js replaces `process.env.NEXT_PUBLIC_X` with the value of X at build time, in
// every bundle, the browser's included, and does the same for each key of next.config's `env`. A secret under such a
// name is published to every visitor: a Supabase service-role key bypasses row level security, a database URL carries
// its password, a signing or API secret lets anyone forge or spend. Agents add the prefix to make an `undefined` in a
// client component go away. A name reads as a secret when it ends in SECRET (CLIENT_SECRET, SECRET_KEY,
// SECRET_ACCESS_KEY, SECRET_TOKEN), PRIVATE_KEY/PRIVATE_TOKEN, PASSWORD/PASSWD/PASS/PASSPHRASE, SERVICE_ROLE(_KEY),
// SERVICE_KEY, DATABASE_URL/DB_URL/DIRECT_URL/POSTGRES_URL/MONGODB_URI/CONNECTION_STRING, SIGNING_KEY/SIGNING_SECRET,
// ADMIN_KEY/ADMIN_TOKEN, ENCRYPTION_KEY, MASTER_KEY, a server-only provider's API key (OPENAI_API_KEY,
// ANTHROPIC_API_KEY, RESEND_API_KEY, SENDGRID_API_KEY, …), AUTH_TOKEN (TWILIO_AUTH_TOKEN, SENTRY_AUTH_TOKEN),
// REST_TOKEN (Upstash's read-write token) or a provider's ACCESS_TOKEN (GITHUB_ACCESS_TOKEN, VERCEL_ACCESS_TOKEN, …;
// not MAPBOX_ACCESS_TOKEN, which is public), optionally followed by _BASE64/_B64.
// It reports:
//   process.env.NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY!          reported (a member read)
//   process.env["NEXT_PUBLIC_OPENAI_API_KEY"]                   reported (a string key)
//   const { NEXT_PUBLIC_UPLOAD_SIGNING_KEY } = process.env      reported (a destructured name)
//   client: { NEXT_PUBLIC_STRIPE_SECRET_KEY: z.string() }       reported (an env schema's key, t3-env and the like)
//   NEXT_PUBLIC_DATABASE_URL=postgresql://…                     reported in the .env files at the root and beside each
//                                                               next.config (`.env`, `.env.example`, `.env.local`, …),
//                                                               and in Dockerfiles, YAML (CI, compose), turbo.json
//   next.config.ts  env: { JWT_SECRET: process.env.JWT_SECRET } reported (next.config's env inlines any name)
// It leaves alone:
//   NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_SENTRY_DSN,
//   NEXT_PUBLIC_RECAPTCHA_SITE_KEY, NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN, NEXT_PUBLIC_UPSTASH_REDIS_REST_READ_ONLY_TOKEN
//                                                               public by design: KEY, TOKEN or DSN alone is no secret
//   NEXT_PUBLIC_SECRET_SHARING_ENABLED                          the secret word is not the name's end
//   NEXT_PUBLIC_ENABLE_PASSWORD, NEXT_PUBLIC_DEMO_PASSWORD      a flag (ENABLE, DISABLE, ALLOW, SHOW, HIDE, USE, IS,
//                                                               HAS, …) or a demo/example/placeholder value
//   STRIPE_SECRET_KEY, process.env.JWT_SECRET                   no NEXT_PUBLIC_ prefix, outside next.config's env
//   env: { APP_VERSION: pkg.version }                           next.config env key that is no secret
//   // never call it NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY       a comment in code
//   src/__tests__/env.test.ts                                   tests, stories, fixtures
// Gaps: .env files are read only at the repository root and beside a next.config; a secret under a name that does not
// say so (NEXT_PUBLIC_STRIPE_KEY holding sk_live_…) is not seen, nor a secret value inlined by webpack's DefinePlugin; a
// name built at run time (`process.env[`NEXT_PUBLIC_${x}`]`) is not read, and Next.js does not inline those either.

.violation PublicEnvSecret(at: loc, name: symbol) "`{name}` looks like a secret, but Next.js inlines a NEXT_PUBLIC_ variable's value into every bundle that reads it, so once any client module reads it (now or later) anyone can read the value in the JavaScript sent to browsers. Drop the NEXT_PUBLIC_ prefix here and wherever the variable is set, read it only in server code (route handlers, Server Actions, server-only modules), and if a client component needs what it does, move that work to the server instead of reading the secret in the browser. Tell the user to rotate the value if a client bundle ever read it in a deployed build. Keep the name only if the value is meant to be public (a publishable, anon or site key)."
PublicEnvSecret(n, s) :- pes_name_node(n, s), prefix("NEXT_PUBLIC_", s), pes_secret(s), docof(n, d), !pes_test_doc(d).
PublicEnvSecret(m, s) :- pes_text_doc(d), source(d, sp), match_all("\\bNEXT_PUBLIC_[A-Z0-9_]+\\b", sp, m), text(m, s),
    pes_secret(s), !pes_test_doc(d).
PublicEnvSecret(@place(f, i), s) :- pes_env_line(f, i, s), pes_secret(s).

.violation NextConfigEnvSecret(at: node, name: symbol) "next.config's `env` inlines `{name}` into every bundle that reads it, as it does a NEXT_PUBLIC_ variable, so once any client module reads it anyone can read the value in the JavaScript sent to browsers. Remove `{name}` from `env` and read `process.env.{name}` only in server code, with the variable set in the server's environment when it runs. Keep it only if the value is meant to be public."
NextConfigEnvSecret(k, s) :- kind(p, "pair"), field(p, "key", e), text(e, "env"), docof(p, d), file_name(d, f),
    glob("next.config.*", f), field(p, "value", o), kind(o, "object"), child(o, q, _), kind(q, "pair"),
    field(q, "key", k), pes_key_name(k, s), !prefix("NEXT_PUBLIC_", s), pes_secret(s).

// pes_secret(s): name s reads as a secret: it ends in a secret word, and is no flag or demo value.
.decl pes_secret(s: symbol)
pes_secret(s) :- pes_candidate(s),
    match("(?:[A-Z0-9_]*_)?(?:[A-Z0-9]*SECRET(?:_ACCESS)?(?:_KEY|_TOKEN)?|PRIVATE(?:_API)?_(?:KEY|TOKEN)|PASSWORD|PASSWD|PASS|PASSPHRASE|SERVICE_ROLE(?:_KEY|_SECRET)?|SERVICE_KEY|DATABASE_URL|DB_URL|DIRECT_URL|(?:POSTGRES|POSTGRESQL|PG|MYSQL|MONGO|MONGODB)_(?:PRISMA_)?(?:URL|URI)|CONNECTION_STRING|SIGNING_(?:KEY|SECRET)|ADMIN_(?:API_)?(?:KEY|TOKEN)|ENCRYPTION_KEY|MASTER_KEY|(?:OPENAI|ANTHROPIC|RESEND|SENDGRID|POSTMARK|MAILGUN|REPLICATE|GROQ|MISTRAL|COHERE|DEEPSEEK|ELEVENLABS|PERPLEXITY|TOGETHER|XAI)_API_KEY|AUTH_TOKEN|REST_TOKEN|(?:GITHUB|GITLAB|VERCEL|NETLIFY|CLOUDFLARE|SHOPIFY_ADMIN|NOTION|SLACK|HUBSPOT|DIGITALOCEAN|FIGMA|LINEAR|AIRTABLE|DROPBOX|PERSONAL)_ACCESS_TOKEN)(?:_BASE64|_B64)?", s),
    !match("(?:[A-Z0-9_]*_)?(?:ENABLE|ENABLED|DISABLE|DISABLED|ALLOW|SHOW|HIDE|FORGOT|RESET|USE|HAS|IS|REQUIRE|REQUIRED|NO|SKIP|WITH|WITHOUT|SUPPORT|SUPPORTS|MIN|MAX|FEATURE|FF|FLAG|DEMO|EXAMPLE|PLACEHOLDER|MOCK|DUMMY|FAKE|SAMPLE)_[A-Z0-9_]*", s).
.decl pes_candidate(s: symbol)
pes_candidate(s) :- pes_name_node(_, s).
pes_candidate(s) :- pes_text_doc(d), source(d, sp), match_all("\\bNEXT_PUBLIC_[A-Z0-9_]+\\b", sp, m), text(m, s).
pes_candidate(s) :- pes_env_line(_, _, s).
pes_candidate(s) :- kind(k, "property_identifier"), text(k, s).
pes_candidate(s) :- kind(k, "string"), str(k, s).
// pes_name_node(n, s): n is a name in code with text s: a member's property, an object key, a destructured name, or a
// whole string's contents. Comments are not names, and neither is a local variable (its declaration is reported).
.decl pes_name_node(n: node, s: symbol)
pes_name_node(n, s) :- (kind(n, "property_identifier") ; kind(n, "shorthand_property_identifier") ;
    kind(n, "shorthand_property_identifier_pattern") ; kind(n, "string_fragment")), text(n, s),
    prefix("NEXT_PUBLIC_", s).
// pes_key_name(k, s): object key k names s: `JWT_SECRET:` or `"JWT_SECRET":`.
.decl pes_key_name(k: node, s: symbol)
pes_key_name(k, s) :- kind(k, "property_identifier"), text(k, s).
pes_key_name(k, s) :- kind(k, "string"), str(k, s).
// pes_text_doc(d): d is read as text: a Dockerfile, YAML (CI workflows, compose, charts), turbo.json, or a `*.env` file.
.decl pes_text_doc(d: number)
pes_text_doc(d) :- file_name(d, f), (glob("*.env", f) ; f = "Dockerfile" ; glob("Dockerfile.*", f) ;
    glob("*.Dockerfile", f) ; glob("*.dockerfile", f) ; glob("*.yml", f) ; glob("*.yaml", f) ; f = "turbo.json").
// A hidden file (`.env`, `.env.example`) is never a document, so the .env files are read as files: those in the
// repository's root and in each folder one or two levels down (`web/`, `apps/web/`) that holds a next.config, where
// Next.js loads them from. (Deriving the folders from the next.config documents' paths fails in the engine: see notes.)
// pes_dir1(a), pes_dir2(a): a folder one or two levels down, not hidden and not node_modules.
.decl pes_dir1(dir: symbol)
pes_dir1(a) :- dir_entry(".", a, 1), !prefix(".", a), a != "node_modules".
.decl pes_dir2(dir: symbol)
pes_dir2(cat(a, "/", b)) :- pes_dir1(a), dir_entry(a, b, 1), !prefix(".", b), b != "node_modules".
.decl pes_dir(dir: symbol)
pes_dir(a) :- pes_dir1(a).
pes_dir(a) :- pes_dir2(a).
// pes_env_dir(dir): such a folder that holds a next.config.
.decl pes_env_dir(dir: symbol)
pes_env_dir(a) :- pes_dir(a), dir_entry(a, f, 0), glob("next.config.*", f).
// pes_env_file(f): f is the path of a .env file there or in the root: `.env`, `.env.local`, `.env.example`, …
.decl pes_env_file(f: symbol)
pes_env_file(n) :- dir_entry(".", n, 0), (n = ".env" ; glob(".env.*", n)).
pes_env_file(cat(dir, "/", n)) :- pes_env_dir(dir), dir_entry(dir, n, 0), (n = ".env" ; glob(".env.*", n)).
// pes_env_line(f, i, s): line i of .env file f sets NEXT_PUBLIC_ variable s, or does so commented out:
// `NEXT_PUBLIC_X=…`, `export NEXT_PUBLIC_X=…`, `# NEXT_PUBLIC_X=`.
.decl pes_env_line(f: symbol, i: number, s: symbol)
pes_env_line(f, i, name) :- pes_env_file(f), file_line(f, i, t),
    match("\\s*(?:#\\s*)?(?:export\\s+)?(?<name>NEXT_PUBLIC_[A-Z0-9_]+)\\s*=.*", t).
// pes_test_doc(d): d is test code, a story or a fixture.
.decl pes_test_doc(d: number)
pes_test_doc(d) :- path_part(d, p), (p = "__tests__" ; p = "__mocks__" ; p = "test" ; p = "tests" ; p = "e2e" ;
    p = "fixtures" ; p = "__fixtures__" ; p = "__stories__").
pes_test_doc(d) :- file_name(d, f), (glob("*.test.*", f) ; glob("*.spec.*", f) ; glob("*.cy.*", f) ;
    glob("*.stories.*", f) ; glob("*.story.*", f)).

// The cases, `cases/next-practice-public-env-secret/`, read as one repository: each line ending in `// caught`
// (`# caught` in env, Dockerfile and YAML files) is reported, and no other line.
.test cases exactly
    .fixture "package.json" from "../cases/next-practice-public-env-secret/package.json"
    .fixture ".env.example" from "../cases/next-practice-public-env-secret/.env.example"
    .fixture "Dockerfile" from "../cases/next-practice-public-env-secret/Dockerfile"
    .fixture ".github/workflows/deploy.yml" from "../cases/next-practice-public-env-secret/.github/workflows/deploy.yml"
    .fixture "next.config.ts" from "../cases/next-practice-public-env-secret/next.config.ts"
    .fixture "src/env.ts" from "../cases/next-practice-public-env-secret/src/env.ts"
    .fixture "src/lib/supabase/admin.ts" from "../cases/next-practice-public-env-secret/src/lib/supabase/admin.ts"
    .fixture "src/lib/upload.ts" from "../cases/next-practice-public-env-secret/src/lib/upload.ts"
    .fixture "src/lib/stripe.ts" from "../cases/next-practice-public-env-secret/src/lib/stripe.ts"
    .fixture "src/app/api/chat/route.ts" from "../cases/next-practice-public-env-secret/src/app/api/chat/route.ts"
    .fixture "src/lib/redis.ts" from "../cases/next-practice-public-env-secret/src/lib/redis.ts"
    .fixture "src/app/checkout/page.tsx" from "../cases/next-practice-public-env-secret/src/app/checkout/page.tsx"
    .fixture "src/__tests__/env.test.ts" from "../cases/next-practice-public-env-secret/src/__tests__/env.test.ts"
    .fixture "apps/admin/next.config.mjs" from "../cases/next-practice-public-env-secret/apps/admin/next.config.mjs"
    .fixture "apps/admin/.env.production" from "../cases/next-practice-public-env-secret/apps/admin/.env.production"
    .fixture "apps/admin/src/app/page.tsx" from "../cases/next-practice-public-env-secret/apps/admin/src/app/page.tsx"
    .expect _ at ".env.example":4
    .expect _ at ".env.example":13
    .expect _ at "Dockerfile":4
    .expect _ at ".github/workflows/deploy.yml":13
    .expect _ at "next.config.ts":8
    .expect _ at "next.config.ts":9
    .expect _ at "next.config.ts":10
    .expect _ at "src/env.ts":11
    .expect _ at "src/lib/supabase/admin.ts":8
    .expect _ at "src/lib/upload.ts":3
    .expect _ at "src/app/api/chat/route.ts":3
    .expect _ at "src/lib/redis.ts":5
    .expect _ at "src/lib/redis.ts":8
    .expect _ at "apps/admin/.env.production":2
    .expect _ at "apps/admin/.env.production":3
.end
