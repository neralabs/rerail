{
  "format": "rerail.policy/v1",
  "id": "next-google-font-display",
  "revision": 1,
  "mode": "steer",
  "description": "@next/eslint-plugin-next 16.3.8 @next/next/google-font-display: a <link> whose literal href is a Google Fonts CSS URL whose query has no display parameter, or display=auto|block|fallback.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "jsx_opening_element"
                  },
                  {
                    "kind": "jsx_self_closing_element"
                  }
                ]
              },
              {
                "has": {
                  "field": "name",
                  "kind": "identifier",
                  "regex": "^link$"
                }
              },
              {
                "has": {
                  "kind": "jsx_attribute",
                  "all": [
                    {
                      "has": {
                        "kind": "property_identifier",
                        "regex": "^href$"
                      }
                    },
                    {
                      "has": {
                        "any": [
                          {
                            "kind": "string",
                            "value": {
                              "startsWith": "https://fonts.googleapis.com/css"
                            },
                            "any": [
                              {
                                "not": {
                                  "value": {
                                    "regex": "^[^?]*\\?(?:[^&?]*&)*display(?:=|&|\\?|$)"
                                  }
                                }
                              },
                              {
                                "value": {
                                  "regex": "^[^?]*\\?(?:[^&?]*&)*display=(?:auto|block|fallback)(?:&|\\?|$)"
                                }
                              }
                            ]
                          },
                          {
                            "kind": "jsx_expression",
                            "has": {
                              "kind": "string",
                              "value": {
                                "startsWith": "https://fonts.googleapis.com/css"
                              },
                              "any": [
                                {
                                  "not": {
                                    "value": {
                                      "regex": "^[^?]*\\?(?:[^&?]*&)*display(?:=|&|\\?|$)"
                                    }
                                  }
                                },
                                {
                                  "value": {
                                    "regex": "^[^?]*\\?(?:[^&?]*&)*display=(?:auto|block|fallback)(?:&|\\?|$)"
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@next/next/google-font-display",
        "message": "A font-display parameter is missing or not recommended. See: https://nextjs.org/docs/messages/google-font-display",
        "suppress": {
          "eslint": {
            "rules": [
              "@next/next/google-font-display"
            ]
          },
          "oxlint": {
            "rules": [
              "google-font-display"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/useGoogleFontDisplay"
            ]
          }
        }
      }
    }
  ]
}
