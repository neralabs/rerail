{
  "format": "rerail.policy/v1",
  "id": "next-probe-pages-special-file",
  "revision": 1,
  "mode": "log",
  "description": "Next pack probe. File role: a pages-router special file (_app, _document, _error, 404, 500) or an API route under pages/api/, in a package that depends on next.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "probe",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "dependsOn": [
                "next"
              ],
              "path": {
                "regex": "^(?:src/)?pages/(?:(?:_app|_document|_error|404|500)\\.(?:js|jsx|ts|tsx)$|api/)"
              }
            }
          },
          "rule": {
            "kind": "program"
          }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "next/pages-special-file",
        "message": "File role: a pages-router special file (_app, _document, _error, 404, 500) or an API route under pages/api/, in a package that depends on next."
      }
    }
  ]
}
