{
  "format": "rerail.policy/v1",
  "id": "next-probe-middleware-file",
  "revision": 1,
  "mode": "log",
  "description": "Next pack probe. File role: the middleware (Next 16 also reads proxy.ts) beside app/ or pages/ of a package that depends on next.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "probe",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "dependsOn": [
                "next"
              ],
              "path": {
                "regex": "^(?:src/)?(?:middleware|proxy)\\.(?:js|ts)$"
              }
            }
          },
          "rule": {
            "kind": "program"
          }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "next/middleware-file",
        "message": "File role: the middleware (Next 16 also reads proxy.ts) beside app/ or pages/ of a package that depends on next."
      }
    }
  ]
}
