{
  "pack": "next-candidates",
  "family": "ecma",
  "capabilities": [
    "syntax",
    "scope",
    "value",
    "suppression"
  ],
  "corpora": [
    {
      "name": "shadcn-ui",
      "repository": "https://github.com/shadcn-ui/ui",
      "commit": "0e3abd65a97707f4a9cc3ed07bf5006e1cb67b13",
      "paths": [
        "apps/v4"
      ],
      "exclude": []
    },
    {
      "name": "next-examples",
      "repository": "https://github.com/vercel/next.js",
      "commit": "6194d642b6fd743437da21dac3c720a587e6b9b2",
      "paths": [
        "examples"
      ],
      "exclude": []
    },
    {
      "name": "commerce",
      "repository": "https://github.com/vercel/commerce",
      "commit": "3761e52e60df9c6a316e067dbfd7032e494d3634",
      "paths": [
        "app",
        "components",
        "lib",
        "next.config.ts",
        "postcss.config.mjs"
      ],
      "exclude": []
    }
  ],
  "tools": [
    {
      "name": "eslint-plugin-next",
      "version": "16.3.8"
    }
  ],
  "rules": [
    {
      "id": "next-no-head-element",
      "upstream": {
        "tool": "eslint-plugin-next",
        "rule": "@next/next/no-head-element"
      },
      "policy": "rules/next-no-head-element.json",
      "capabilities": [
        "syntax",
        "suppression"
      ],
      "match": "line+column"
    },
    {
      "id": "next-google-font-display",
      "upstream": {
        "tool": "eslint-plugin-next",
        "rule": "@next/next/google-font-display"
      },
      "policy": "rules/next-google-font-display.json",
      "capabilities": [
        "syntax",
        "value",
        "suppression"
      ],
      "match": "line+column"
    },
    {
      "id": "next-no-page-custom-font",
      "upstream": {
        "tool": "eslint-plugin-next",
        "rule": "@next/next/no-page-custom-font"
      },
      "policy": "rules/next-no-page-custom-font.json",
      "capabilities": [
        "syntax",
        "value",
        "suppression"
      ],
      "match": "line+column"
    },
    {
      "id": "next-no-location-assign-relative-destination",
      "upstream": {
        "tool": "eslint-plugin-next",
        "rule": "@next/next/no-location-assign-relative-destination"
      },
      "policy": "rules/next-no-location-assign-relative-destination.json",
      "capabilities": [
        "syntax",
        "scope",
        "value",
        "suppression"
      ],
      "match": "line+column"
    }
  ],
  "oracles": "../upstream"
}
