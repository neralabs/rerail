{
  "format": "rerail.rule-pack/v1",
  "id": "next",
  "name": "Next.js",
  "category": "framework",
  "covers": "21 @next/eslint-plugin-next rules ported to Rerail, each scored against the plugin's own findings on its rule tests.",
  "reason": "matches Next.js",
  "match": {
    "any": [
      {
        "dependencies": {
          "ecosystem": "npm",
          "names": [
            "next"
          ]
        }
      }
    ]
  },
  "rules": [
    {
      "id": "next-no-img-element",
      "document": "rules/next-no-img-element.json",
      "title": "No img element",
      "mode": "log",
      "group": "Next.js",
      "examples": {
        "caught": {
          "path": "app/page.tsx",
          "text": "export default function Page() {\n  return <img src=\"/hero.png\" alt=\"Hero\" />;\n}\n"
        },
        "passes": {
          "path": "app/opengraph-image.tsx",
          "text": "import { ImageResponse } from \"next/og\";\n\nexport default function OpengraphImage() {\n  return new ImageResponse(<img src=\"https://example.com/hero.png\" alt=\"Hero\" />);\n}\n"
        }
      }
    },
    {
      "id": "next-no-head-element",
      "document": "rules/next-no-head-element.json",
      "title": "No head element",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-no-sync-scripts",
      "document": "rules/next-no-sync-scripts.json",
      "title": "No sync scripts",
      "mode": "log",
      "group": "Next.js",
      "examples": {
        "caught": {
          "path": "pages/index.tsx",
          "text": "export default function Home() {\n  return <script src=\"https://example.com/widget.js\" />;\n}\n"
        },
        "passes": {
          "path": "pages/index.tsx",
          "text": "export default function Home() {\n  return <script src=\"https://example.com/widget.js\" async />;\n}\n"
        }
      }
    },
    {
      "id": "next-no-css-tags",
      "document": "rules/next-no-css-tags.json",
      "title": "No css tags",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-google-font-display",
      "document": "rules/next-google-font-display.json",
      "title": "Google font display",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-google-font-preconnect",
      "document": "rules/next-google-font-preconnect.json",
      "title": "Google font preconnect",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-next-script-for-ga",
      "document": "rules/next-next-script-for-ga.json",
      "title": "Next script for ga",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-no-unwanted-polyfillio",
      "document": "rules/next-no-unwanted-polyfillio.json",
      "title": "No unwanted polyfillio",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-no-assign-module-variable",
      "document": "rules/next-no-assign-module-variable.json",
      "title": "No assign module variable",
      "group": "Next.js",
      "examples": {
        "caught": {
          "path": "pages/index.tsx",
          "text": "let module = { title: \"Home\" };\n\nexport default function Home() {\n  return <h1>{module.title}</h1>;\n}\n"
        },
        "passes": {
          "path": "pages/index.tsx",
          "text": "const page = { title: \"Home\" };\n\nexport default function Home() {\n  return <h1>{page.title}</h1>;\n}\n"
        }
      }
    },
    {
      "id": "next-no-document-import-in-page",
      "document": "rules/next-no-document-import-in-page.json",
      "title": "No document import in page",
      "group": "Next.js"
    },
    {
      "id": "next-no-head-import-in-document",
      "document": "rules/next-no-head-import-in-document.json",
      "title": "No head import in document",
      "group": "Next.js"
    },
    {
      "id": "next-no-styled-jsx-in-document",
      "document": "rules/next-no-styled-jsx-in-document.json",
      "title": "No styled jsx in document",
      "mode": "log",
      "group": "Next.js",
      "examples": {
        "caught": {
          "path": "pages/_document.tsx",
          "text": "import { Html, Head, Main, NextScript } from \"next/document\";\n\nexport default function Document() {\n  return (\n    <Html>\n      <Head />\n      <body>\n        <style jsx>{\"body { margin: 0; }\"}</style>\n        <Main />\n        <NextScript />\n      </body>\n    </Html>\n  );\n}\n"
        },
        "passes": {
          "path": "pages/_document.tsx",
          "text": "import { Html, Head, Main, NextScript } from \"next/document\";\n\nexport default function Document() {\n  return (\n    <Html>\n      <Head />\n      <body>\n        <style>{\"body { margin: 0; }\"}</style>\n        <Main />\n        <NextScript />\n      </body>\n    </Html>\n  );\n}\n"
        }
      }
    },
    {
      "id": "next-no-title-in-document-head",
      "document": "rules/next-no-title-in-document-head.json",
      "title": "No title in document head",
      "mode": "log",
      "group": "Next.js",
      "examples": {
        "caught": {
          "path": "pages/_document.tsx",
          "text": "import { Html, Head, Main, NextScript } from \"next/document\";\n\nexport default function Document() {\n  return (\n    <Html>\n      <Head>\n        <title>My site</title>\n      </Head>\n      <body>\n        <Main />\n        <NextScript />\n      </body>\n    </Html>\n  );\n}\n"
        },
        "passes": {
          "path": "pages/index.tsx",
          "text": "import Head from \"next/head\";\n\nexport default function Home() {\n  return (\n    <Head>\n      <title>My site</title>\n    </Head>\n  );\n}\n"
        }
      }
    },
    {
      "id": "next-no-script-component-in-head",
      "document": "rules/next-no-script-component-in-head.json",
      "title": "No script component in head",
      "group": "Next.js",
      "examples": {
        "caught": {
          "path": "pages/index.tsx",
          "text": "import Head from \"next/head\";\nimport Script from \"next/script\";\n\nexport default function Home() {\n  return (\n    <Head>\n      <Script src=\"https://example.com/analytics.js\" />\n    </Head>\n  );\n}\n"
        },
        "passes": {
          "path": "pages/index.tsx",
          "text": "import Head from \"next/head\";\nimport Script from \"next/script\";\n\nexport default function Home() {\n  return (\n    <>\n      <Head>\n        <title>Home</title>\n      </Head>\n      <Script src=\"https://example.com/analytics.js\" />\n    </>\n  );\n}\n"
        }
      }
    },
    {
      "id": "next-inline-script-id",
      "document": "rules/next-inline-script-id.json",
      "title": "Inline script id",
      "group": "Next.js"
    },
    {
      "id": "next-no-async-client-component",
      "document": "rules/next-no-async-client-component.json",
      "title": "No async client component",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-no-before-interactive-script-outside-document",
      "document": "rules/next-no-before-interactive-script-outside-document.json",
      "title": "No before interactive script outside document",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-no-duplicate-head",
      "document": "rules/next-no-duplicate-head.json",
      "title": "No duplicate head",
      "group": "Next.js"
    },
    {
      "id": "next-no-typos",
      "document": "rules/next-no-typos.json",
      "title": "No typos",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-no-page-custom-font",
      "document": "rules/next-no-page-custom-font.json",
      "title": "No page custom font",
      "mode": "log",
      "group": "Next.js"
    },
    {
      "id": "next-no-location-assign-relative-destination",
      "document": "rules/next-no-location-assign-relative-destination.json",
      "title": "No location assign relative destination",
      "mode": "log",
      "group": "Next.js"
    }
  ]
}
