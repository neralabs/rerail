generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  drafts        Draft[]
  sessions      Session[]
  notifications Notification[]
}

model Draft {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  body   String
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}

model Notification {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  read   Boolean @default(false)
  kind   String
}
