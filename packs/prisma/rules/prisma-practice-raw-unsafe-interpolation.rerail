    .fixture "src/server/reports.ts" from "../cases/prisma-practice-raw-unsafe-interpolation/src/server/reports.ts"
    .fixture "src/server/tenancy.ts" from "../cases/prisma-practice-raw-unsafe-interpolation/src/server/tenancy.ts"
    .fixture "src/server/sorting.ts" from "../cases/prisma-practice-raw-unsafe-interpolation/src/server/sorting.ts"
    .fixture "src/server/__tests__/reports.test.ts" from "../cases/prisma-practice-raw-unsafe-interpolation/src/server/__tests__/reports.test.ts"
    .expect _ at "src/app/api/search/route.ts":8
