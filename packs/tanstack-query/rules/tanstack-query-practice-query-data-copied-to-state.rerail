    .fixture "src/features/projects/use-projects.ts" from "../cases/tanstack-query-practice-query-data-copied-to-state/src/features/projects/use-projects.ts"
    .fixture "src/components/project-list.tsx" from "../cases/tanstack-query-practice-query-data-copied-to-state/src/components/project-list.tsx"
    .fixture "src/features/todos/hooks.tsx" from "../cases/tanstack-query-practice-query-data-copied-to-state/src/features/todos/hooks.tsx"
    .fixture "src/features/todos/index.tsx" from "../cases/tanstack-query-practice-query-data-copied-to-state/src/features/todos/index.tsx"
    .fixture "src/features/todos/todo-detail.tsx" from "../cases/tanstack-query-practice-query-data-copied-to-state/src/features/todos/todo-detail.tsx"
    .fixture "src/features/todos/todo-list.test.tsx" from "../cases/tanstack-query-practice-query-data-copied-to-state/src/features/todos/todo-list.test.tsx"
    .fixture "src/features/todos/todo-list.tsx" from "../cases/tanstack-query-practice-query-data-copied-to-state/src/features/todos/todo-list.tsx"
    .fixture "src/lib/rtk.ts" from "../cases/tanstack-query-practice-query-data-copied-to-state/src/lib/rtk.ts"
