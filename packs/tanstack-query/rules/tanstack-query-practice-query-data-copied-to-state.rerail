.policy "tanstack-query-practice-query-data-copied-to-state" revision 1
.description "Read a query's data where it is used instead of copying it into useState, whose copy does not follow refetches and cache updates."
.language typescript
.mode steer
.scope include "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"
.scope exclude "**/*.test.*", "**/*.spec.*", "**/*.cy.*", "**/__tests__/**", "**/test/**", "**/tests/**", "**/e2e/**"
.scope exclude "**/__mocks__/**", "**/*.stories.*", "**/*.story.*", "**/__stories__/**", "**/__fixtures__/**"
.scope exclude "**/fixtures/**", "**/node_modules/**", "**/dist/**", "**/build/**", "**/out/**", "**/.next/**"
.scope exclude "**/coverage/**", "**/vendor/**", "**/.venv/**", "**/.yarn/**", "**/generated/**", "**/__generated__/**"
.scope exclude "**/*.generated.*", "**/*.gen.*", "**/*.min.js", "**/*.d.ts"
// Rerail's own rule, not a port. TanStack Query keeps server data in its cache and re-renders the component when a
// refetch or a cache update (setQueryData, invalidation) changes it. A useState copy of that data is a second
// source of truth: `useState(data)` takes the value of the first render only (undefined while the query loads) and
// never follows it, and an effect that copies data into state renders one frame behind the cache and costs an extra
// render per change. The query is useQuery, useSuspenseQuery, useInfiniteQuery or useSuspenseInfiniteQuery of
// @tanstack/react-query (or react-query 3), tRPC's `api.a.b.useQuery()` family, or a custom hook (in this file or
// another, imported through a path alias or barrel) that returns such a query, or its data.
// The data is the `data` of the result: `const { data } = …`, `{ data: todos }`, `{ data = [] }`, `q.data`, the
// value of a hook that returns data, and a member, `??`/`||` fallback or type cast of it, also through a const.
//   const { data } = useTodos(); const [todos] = useState(data ?? [])     reported at the argument: a frozen copy
//   const [todos] = useState(() => query.data?.items ?? [])              reported: the same, lazily
//   const [todos, setTodos] = useState<Todo[]>([])
//   useEffect(() => { if (data) setTodos(data) }, [data])                reported at the setter call
//   const count = data?.length ?? 0                                      not reported: derived during render
//   const [name, setName] = useState(data?.name) with an onChange that calls setName
//                                                                        not reported: an edited draft seeded once
//   useEffect(() => { if (data) setRows(data) }, [data]) where a handler also calls setRows
//                                                                        not reported: the state is edited too
//   useEffect(() => { identify(data.id).then(() => setReady(data.id)) }, [data])
//                                                                        not reported: the setter runs in a callback
//                                                                        (here after a side effect), not in the
//                                                                        effect's own code
//   function EditForm({ initial }) { const [draft] = useState(initial) }  not reported: a prop, the advised split
//   setRows((prev) => [...prev, ...data])                                not reported: an accumulation, not a copy
//   reset(data), useForm({ defaultValues: data })                       not reported: a form library's own state
//   useQuery from another library (@apollo/client, convex, urql)        not reported
// A state that an effect copies query data into is reported at those effect calls, not at its useState. Only a
// setter called in the effect callback's own code counts: one inside a `.then`, a timer or a nested function records
// something that happened later (an external call finished, a delay passed), not a copy of the cache.
// A Hook of another file is known by its module and name: each file states what its own Hooks return, and what it
// imports and re-exports, by paths and symbols alone (decision 0677); the cross-file part follows them through
// imports and barrels, and a finding that rests on another file's Hook joins what holds for its file (qdc_true). So
// do the copies that keep a useState from being reported at its argument and the effects whose setter calls are not
// "elsewhere": an effect that fills the state from an imported Hook copies only where that Hook returns a query or
// its data; one that fills it from any other Hook (`setRows(saved)`, `saved = useSavedFilter()`) sets it elsewhere.
// Gaps: a value computed by a call (`data.pages.flatMap(…)`, `data.map(…)`) is not followed; nor is a hook that
// returns the data inside an object (`return { todos: data }`), a query result passed in as a prop, a setter of a
// store (Jotai, Zustand) rather than useState, or an alias other than `@/`, `~/` and `#/`. The engine evaluates .ts and
// .tsx files apart, so a component in a .tsx file does not see a custom hook declared in a .ts file (the most
// common layout, `use-todos.ts`) until it joins them.

#include "tsx/react-compiler.rerail"

.violation QueryDataCopiedToState(at: node, msg: symbol) "{msg}"
QueryDataCopiedToState(a, m) :- qdc_initial(a, s, cs, cx, cn), !qdc_set_elsewhere(s), !qdc_copied_sure(s),
    qdc_copy_req(s, g), qdc_need(s, n), qdc_says("initial", m), docof(a, d), qdc_tq_pkg(d), doc(d, p, _),
    qdc_true(p, cs, cx, cn), !qdc_group_true(p, g), !qdc_unmet(p, n).
QueryDataCopiedToState(k, m) :- qdc_effect_copy(k, s, cs, cx, cn), !qdc_set_elsewhere(s), qdc_need(s, n),
    qdc_says("effect", m), docof(k, d), qdc_tq_pkg(d), doc(d, p, _), qdc_true(p, cs, cx, cn), !qdc_unmet(p, n).
// qdc_tq_pkg(d): document d uses TanStack Query: it imports it itself, or its package (its nearest package.json; the
// workspace root's for a file under no other) depends on TanStack Query (`@tanstack/react-query`, v3's
// `react-query`) or tRPC's React Query integration, so an `x.y.useQuery()` there is tRPC's TanStack hook and not
// another SDK's.
.decl qdc_tq_pkg(d: number)
qdc_tq_pkg(d) :- doc(d, f, _), package_for(f, dir), qdc_tq_dep(dir).
qdc_tq_pkg(d) :- import_binding(sp, _, src, _), qdc_pkg(src), docof(sp, d).
.decl qdc_tq_dep(dir: symbol)
qdc_tq_dep(dir) :- package_field(dir, k, _),
    match("(dependencies|devDependencies|peerDependencies)/(@tanstack~1react-query|react-query|@trpc~1(react-query|tanstack-react-query|next))", k).

.decl qdc_says(id: symbol, m: symbol)
qdc_says("initial", "This useState copies query data once, on the first render: the copy is undefined if the query had no data yet, and it never follows a refetch, an invalidation or setQueryData. Read the query's `data` where you use it, deriving values during render or with the query's `select`. If the state must keep the first value on purpose (a snapshot to compare against, a draft seeded once), move it into a child component that takes the value as a prop (`<Editor initial={data} key={data.id} />`) and render the child once the data is there; that form is not reported.").
qdc_says("effect", "This effect copies query data into state that nothing else sets: the copy renders one frame behind the cache and adds a render on every refetch. Use the query's `data` in place of this state (derive values during render or with the query's `select`) and drop the effect; if the copy is there to keep the last value while a new key loads, use `placeholderData: keepPreviousData` on the query instead.").

// ---- query calls ----------------------------------------------------------------------------------------------
// qdc_direct(h): call h is a query hook's: it returns a query result ({ data, isLoading, … }).
.decl qdc_direct(h: node)
// useQuery(…) imported from TanStack Query (renamed or not), or RQ.useQuery(…) off `import * as RQ`.
qdc_direct(h) :- kind(h, "call_expression"), field(h, "function", f), kind(f, "identifier"), ref_site(f, sp),
    import_binding(sp, _, src, x), qdc_pkg(src), qdc_hook(x).
qdc_direct(h) :- kind(h, "call_expression"), field(h, "function", f), kind(f, "member_expression"),
    field(f, "object", o), kind(o, "identifier"), ref_site(o, sp), import_binding(sp, _, src, "*"), qdc_pkg(src),
    field(f, "property", p), qdc_hook(x), text(p, x).
// tRPC's React Query hooks: `api.post.list.useQuery(…)`, a member of a member; RTK Query's
// `api.endpoints.x.useQuery()` is another cache and is left out.
qdc_direct(h) :- kind(h, "call_expression"), field(h, "function", f), kind(f, "member_expression"),
    field(f, "property", p), qdc_hook(x), text(p, x), field(f, "object", o), kind(o, "member_expression"),
    !qdc_rtk(o).
.decl qdc_rtk(o: node)
qdc_rtk(o) :- kind(o, "member_expression"), within(n, o), kind(n, "property_identifier"), text(n, "endpoints").

.decl qdc_hook(x: symbol)
qdc_hook("useQuery"). qdc_hook("useSuspenseQuery"). qdc_hook("useInfiniteQuery"). qdc_hook("useSuspenseInfiniteQuery").
.decl qdc_pkg(p: symbol)
qdc_pkg("@tanstack/react-query"). qdc_pkg("react-query").

// qdc_is(h, m, cs, cx, cn): call h returns a query result (m = "query") or a query's data (m = "data"), where the
// Hook imported as cx from specifier cs returns cn (cs, cx and cn "": always). A query hook's call is a query result;
// a custom Hook's call is what its function returns: a function of this file (qdc_gives), or an imported Hook, which
// is either as its own file says (qdc_true, read by the finding).
.decl qdc_is(h: node, m: symbol, cs: symbol, cx: symbol, cn: symbol)
qdc_is(h, "query", "", "", "") :- qdc_direct(h).
qdc_is(h, m, cs, cx, cn) :- qdc_local_call(h, g), qdc_gives(g, m, cs, cx, cn).
qdc_is(h, m, s, x, m) :- qdc_import_call(h, s, x), qdc_mode(m).
.decl qdc_mode(m: symbol)
qdc_mode("query"). qdc_mode("data").

// ---- custom hooks ---------------------------------------------------------------------------------------------
// qdc_local_call(h, g): Hook call h calls g, a function of this file. qdc_import_call(h, s, x): h calls the Hook
// imported as x from specifier s.
.decl qdc_local_call(h: node, g: node)
qdc_local_call(h, g) :- hook_call(h, n), ref_site(n, s), rc_fn_at(s, g).
.decl qdc_import_call(h: node, s: symbol, x: symbol)
qdc_import_call(h, s, x) :- hook_call(h, n), ref_site(n, sp), import_binding(sp, _, s, x), x != "*".

// qdc_gives(g, m, cs, cx, cn): function g returns a query result (m = "query": `() => useQuery(…)`,
// `return useQuery(…)`, `const q = useQuery(…); return q`) or a query's data (m = "data":
// `const { data } = useQuery(…); return data`), where the Hook imported as cx from cs returns cn (qdc_is).
.decl qdc_gives(g: node, m: symbol, cs: symbol, cx: symbol, cn: symbol)
qdc_gives(g, "query", cs, cx, cn) :- qdc_returned(g, e), deparen(e, h), qdc_is(h, "query", cs, cx, cn).
qdc_gives(g, "query", cs, cx, cn) :- qdc_returned(g, e), kind(e, "identifier"), ref_site(e, d), qdc_holds(d, h),
    field(d, "name", n), kind(n, "identifier"), qdc_is(h, "query", cs, cx, cn).
qdc_gives(g, "data", cs, cx, cn) :- qdc_returned(g, e), qdc_val(e, cs, cx, cn).
// qdc_returned(g, e): function g, a Hook this file calls or exports (qdc_fn), returns expression e: an arrow's
// expression body, or a return in g's own code.
.decl qdc_fn(g: node)
qdc_fn(g) :- qdc_local_call(_, g).
qdc_fn(g) :- qdc_own_hook(_, g).
.decl qdc_returned(g: node, e: node)
qdc_returned(g, e) :- qdc_fn(g), kind(g, "arrow_function"), field(g, "body", e), !kind(e, "statement_block").
qdc_returned(g, e) :- qdc_fn(g), kind(r, "return_statement"), rc_own(r, g), child(r, e, _).

// qdc_holds(d, h): declarator d is initialised with call h, which returns a query result (qdc_is): `const … =
// useQuery(…)`.
.decl qdc_holds(d: node, h: node)
qdc_holds(d, h) :- kind(d, "variable_declarator"), field(d, "value", v), deparen(v, h), qdc_is(h, "query", _, _, _).

// ---- query data -----------------------------------------------------------------------------------------------
// qdc_data_site(s, h): binding s holds the data of query h.
//   const { data } = h   const { data = [] } = h   const { data: todos } = h   const { data: todos = [] } = h
//   const [data] = api.a.useSuspenseQuery()  (tRPC's suspense hooks return [data, query])
.decl qdc_data_site(s: node, h: node)
qdc_data_site(s, h) :- qdc_pattern(h, pat), child(pat, s, _), kind(s, "shorthand_property_identifier_pattern"),
    text(s, "data").
qdc_data_site(s, h) :- qdc_pattern(h, pat), child(pat, a, _), kind(a, "object_assignment_pattern"),
    field(a, "left", s), text(s, "data").
qdc_data_site(s, h) :- qdc_pattern(h, pat), child(pat, pp, _), kind(pp, "pair_pattern"), field(pp, "key", k),
    text(k, "data"), field(pp, "value", v), (s = v, kind(v, "identifier") ;
    kind(v, "assignment_pattern"), field(v, "left", s), kind(s, "identifier")).
qdc_data_site(s, h) :- qdc_holds(d, h), field(d, "name", pat), kind(pat, "array_pattern"), child(pat, s, 0),
    kind(s, "identifier"), field(h, "function", f), field(f, "property", p), glob("useSuspense*", p).
.decl qdc_pattern(h: node, pat: node)
qdc_pattern(h, pat) :- qdc_holds(d, h), field(d, "name", pat), kind(pat, "object_pattern").

// qdc_val(e, cs, cx, cn): expression e's value is the data of a query, or part of it, where the Hook imported as cx
// from cs returns cn (qdc_is).
.decl qdc_val(e: node, cs: symbol, cx: symbol, cn: symbol)
qdc_val(e, cs, cx, cn) :- kind(e, "identifier"), ref_site(e, s), qdc_data_site(s, h), qdc_is(h, "query", cs, cx, cn).
// q.data, q?.data where `const q = h`; h.data written in place.
qdc_val(e, cs, cx, cn) :- kind(e, "member_expression"), field(e, "property", p), text(p, "data"),
    field(e, "object", o), kind(o, "identifier"), ref_site(o, d), qdc_holds(d, h), field(d, "name", n),
    kind(n, "identifier"), qdc_is(h, "query", cs, cx, cn).
qdc_val(e, cs, cx, cn) :- kind(e, "member_expression"), field(e, "property", p), text(p, "data"),
    field(e, "object", o), deparen(o, h), qdc_is(h, "query", cs, cx, cn).
// A custom hook that returns query data: `const user = useCurrentUser()`.
qdc_val(e, cs, cx, cn) :- qdc_is(e, "data", cs, cx, cn).
// data.items, data?.items, data ?? [], data || [], (data as Todo[]), data!, and a const holding any of them.
qdc_val(e, cs, cx, cn) :- kind(e, "member_expression"), field(e, "property", p), kind(p, "property_identifier"),
    field(e, "object", o), deparen(o, x), qdc_val(x, cs, cx, cn).
qdc_val(e, cs, cx, cn) :- kind(e, "binary_expression"), (op(e, "??") ; op(e, "||")), field(e, "left", l),
    deparen(l, x), qdc_val(x, cs, cx, cn).
qdc_val(e, cs, cx, cn) :- (kind(e, "as_expression") ; kind(e, "non_null_expression") ;
    kind(e, "satisfies_expression")), child(e, l, 0), deparen(l, x), qdc_val(x, cs, cx, cn).
qdc_val(e, cs, cx, cn) :- kind(e, "identifier"), ref_site(e, d), kind(d, "variable_declarator"), field(d, "name", n),
    kind(n, "identifier"), field(d, "value", v), deparen(v, x), qdc_val(x, cs, cx, cn).

// ---- copies into state ----------------------------------------------------------------------------------------
// qdc_initial(a, s, cs, cx, cn): a, the initial value of the useState whose setter binding is s (or the declarator,
// when the pattern names no setter), is query data (qdc_val): `useState(data)`, `useState(() => data)`.
.decl qdc_initial(a: node, s: node, cs: symbol, cx: symbol, cn: symbol)
qdc_initial(a, s, cs, cx, cn) :- rc_react_call(u, "useState"), call_arg(u, a, 0), qdc_init_val(a, cs, cx, cn),
    qdc_state(u, s).
.decl qdc_init_val(a: node, cs: symbol, cx: symbol, cn: symbol)
qdc_init_val(a, cs, cx, cn) :- deparen(a, x), qdc_val(x, cs, cx, cn).
qdc_init_val(a, cs, cx, cn) :- deparen(a, f), kind(f, "arrow_function"), field(f, "body", b), deparen(b, x),
    qdc_val(x, cs, cx, cn).
.decl qdc_state(u: node, s: node)  // useState call u's setter binding, else its declarator
qdc_state(u, s) :- kind(d, "variable_declarator"), field(d, "value", u), field(d, "name", p), kind(p, "array_pattern"),
    child(p, s, 1), kind(s, "identifier").
qdc_state(u, d) :- kind(d, "variable_declarator"), field(d, "value", u), field(d, "name", p), kind(p, "array_pattern"),
    !qdc_has_setter(p).
.decl qdc_has_setter(p: node)
qdc_has_setter(p) :- child(p, s, 1), kind(s, "identifier").

// qdc_effect_copy(k, s, cs, cx, cn): k, a call of setter s in the own code of a useEffect or useLayoutEffect
// callback (not in a function nested in it), passes query data (qdc_val).
.decl qdc_effect_copy(k: node, s: node, cs: symbol, cx: symbol, cn: symbol)
qdc_effect_copy(k, s, cs, cx, cn) :- qdc_effect_cb(cb), rc_set_state(k), rc_own(k, cb), call_arg(k, a, 0),
    deparen(a, x), qdc_val(x, cs, cx, cn), field(k, "function", n), ref_site(n, s).
.decl qdc_effect_cb(cb: node)
qdc_effect_cb(cb) :- deps_hook(c, x, _, _), effect_hook(x), deps_cb(c, cb).
// What keeps a state from being reported rests on other files' Hooks too. A copy that rests on an imported Hook
// (cs != "") counts only where that Hook returns what the copy needs (qdc_true): each file names the conditions a
// state's finding asks as groups of values (qdc_member, qdc_need_group), which the cross-file part answers per group
// (qdc_group_true, qdc_unmet).
// qdc_ask(s): a state a finding may report.
.decl qdc_ask(s: node)
qdc_ask(s) :- qdc_initial(_, s, _, _, _).
qdc_ask(s) :- qdc_effect_copy(_, s, _, _, _).
// qdc_copied_sure(s): an effect copies query data into s, whatever other files hold.
.decl qdc_copied_sure(s: node)
qdc_copied_sure(s) :- qdc_effect_copy(_, s, "", "", "").
// qdc_copy_alt(s, k, cs, cx, cn): s has no sure copy, and an effect copies into it a value that is query data where
// the Hook imported as cx from cs returns cn; k is that condition as one value. qdc_copy_req(s, g): g names them all
// ("" none); s is copied when one of them holds.
.decl qdc_copy_alt(s: node, k: symbol, cs: symbol, cx: symbol, cn: symbol)
qdc_copy_alt(s, cat(cs, " ", cx, " ", cn), cs, cx, cn) :- qdc_effect_copy(_, s, cs, cx, cn), cs != "",
    !qdc_copied_sure(s).
.decl qdc_copy_req(s: node, g: symbol)
qdc_copy_req(s, g) :- qdc_copy_alt(s, _, _, _, _), g = join k by k sep " | " : { qdc_copy_alt(s, k, _, _, _) }.
qdc_copy_req(s, "") :- qdc_ask(s), !qdc_copy_alt(s, _, _, _, _).

// qdc_set_elsewhere(s): setter s is read outside every effect that may copy query data into it (qdc_cover, whatever
// other files hold): an event handler, a child's prop, a custom hook's argument. The state is then a draft the user
// edits. A read in an effect whose copy rests on other files is elsewhere unless that copy holds (qdc_need).
.decl qdc_set_elsewhere(s: node)
qdc_set_elsewhere(s) :- ref_site(r, s), !qdc_in_copying_effect(r, s).
// qdc_cover(r, s, cs, cx, cn): reference r of setter s sits in an effect that copies query data into s, where the
// Hook imported as cx from cs returns cn.
.decl qdc_cover(r: node, s: node, cs: symbol, cx: symbol, cn: symbol)
qdc_cover(r, s, cs, cx, cn) :- qdc_effect_copy(k, s, cs, cx, cn), qdc_effect_cb(cb), within(k, cb), within(r, cb),
    ref_site(r, s).
.decl qdc_in_copying_effect(r: node, s: node)
qdc_in_copying_effect(r, s) :- qdc_cover(r, s, _, _, _).
// qdc_ref_alt(r, s, k, cs, cx, cn): r sits in no effect that copies query data into s whatever other files hold, and
// in one whose copy rests on condition k: r sets s elsewhere unless one of its conditions holds. qdc_ref_group(r, s,
// g): g names them all. qdc_need(s, n): n names the groups of s's references ("" none); each must hold.
.decl qdc_sure_ref(r: node, s: node)
qdc_sure_ref(r, s) :- qdc_cover(r, s, "", "", "").
.decl qdc_ref_alt(r: node, s: node, k: symbol, cs: symbol, cx: symbol, cn: symbol)
qdc_ref_alt(r, s, cat(cs, " ", cx, " ", cn), cs, cx, cn) :- qdc_cover(r, s, cs, cx, cn), cs != "",
    !qdc_sure_ref(r, s).
.decl qdc_ref_group(r: node, s: node, g: symbol)
qdc_ref_group(r, s, g) :- qdc_ref_alt(r, s, _, _, _, _), g = join k by k sep " | " : { qdc_ref_alt(r, s, k, _, _, _) }.
.decl qdc_need(s: node, n: symbol)
qdc_need(s, n) :- qdc_ref_group(_, s, _), n = join g by g sep " || " : { qdc_ref_group(_, s, g) }.
qdc_need(s, "") :- qdc_ask(s), !qdc_ref_group(_, s, _).
// qdc_member(p, g, cs, cx, cn): in the file at path p, group g holds the condition (cs, cx, cn).
// qdc_need_group(p, n, g): in the file at path p, need n names group g.
.decl qdc_member(p: symbol, g: symbol, cs: symbol, cx: symbol, cn: symbol)
qdc_member(p, g, cs, cx, cn) :- qdc_copy_req(s, g), qdc_copy_alt(s, _, cs, cx, cn), docof(s, d), doc(d, p, _).
qdc_member(p, g, cs, cx, cn) :- qdc_ref_group(r, s, g), qdc_ref_alt(r, s, _, cs, cx, cn), docof(r, d), doc(d, p, _).
.decl qdc_need_group(p: symbol, n: symbol, g: symbol)
qdc_need_group(p, n, g) :- qdc_need(s, n), qdc_ref_group(_, s, g), docof(s, d), doc(d, p, _).

// ---- across files: other modules' Hooks -----------------------------------------------------------------------
// Each file states, by its path, its module (ts_module) and symbols alone, what its own Hooks return (qdc_def), what
// it re-exports (qdc_reexport, qdc_star) and which imported Hooks it calls (qdc_import). A specifier names a
// workspace module by (the rule's own resolution, tsconfig `paths` not read):
//   "./hooks", "../x"   the importing file's folder joined with it, then .ts/.tsx/.js/… and index files
//   "@/x", "~/x", "#/x" x, or src/x, under the importing file's folder or any folder above it (where tsconfig
//                       `paths` most often points: "@/*": ["./src/*"] or ["./*"])
// Other aliases and workspace packages are not followed. The engine evaluates .ts and .tsx files apart, so a
// module only resolves to a file of the same kind.
// qdc_own_hook(x, g): this file's Hook function g is its top-level `use…` function x, or its `export default`.
.decl qdc_own_hook(x: symbol, g: node)
qdc_own_hook(x, g) :- top_level(s, x), prefix("use", x), rc_fn_at(s, g).
qdc_own_hook("default", g) :- kind(e, "export_statement"), field(e, "declaration", g), rc_fn(g), child(e, k, _),
    text(k, "default").
qdc_own_hook("default", g) :- kind(e, "export_statement"), field(e, "value", v), kind(v, "identifier"),
    ref_site(v, s), rc_fn_at(s, g).
// qdc_def(p, t, x, m, cs, cx, cn): Hook x of module t, the file at path p, returns m (qdc_gives), where the Hook it
// imports as cx from cs returns cn.
.decl qdc_def(p: symbol, t: symbol, x: symbol, m: symbol, cs: symbol, cx: symbol, cn: symbol)
qdc_def(p, t, x, m, cs, cx, cn) :- qdc_own_hook(x, g), qdc_gives(g, m, cs, cx, cn), docof(g, d), doc(d, p, _),
    ts_module(d, t).
// qdc_reexport(p, t, x, s, y): module t, the file at path p, exports s's name y as x (`export { y as x } from s`);
// qdc_star(p, t, s): it exports every name of s but its default (`export * from s`).
.decl qdc_reexport(p: symbol, t: symbol, x: symbol, s: symbol, y: symbol)
qdc_reexport(p, t, x, s, y) :- kind(e, "export_statement"), export_from(e, s, y, x), docof(e, d), doc(d, p, _),
    ts_module(d, t).
.decl qdc_star(p: symbol, t: symbol, s: symbol)
qdc_star(p, t, s) :- kind(e, "export_statement"), star_export(e, s), docof(e, d), doc(d, p, _), ts_module(d, t).
// qdc_import(p, s, x): the file at path p calls the Hook it imports as x from s.
.decl qdc_import(p: symbol, s: symbol, x: symbol)
qdc_import(p, s, x) :- qdc_import_call(h, s, x), docof(h, d), doc(d, p, _).
// qdc_spec(p, s): the file at path p names specifier s, to resolve.
.decl qdc_spec(p: symbol, s: symbol)
qdc_spec(p, s) :- qdc_import(p, s, _).
qdc_spec(p, s) :- qdc_def(p, _, _, _, s, _, _), s != "".
qdc_spec(p, s) :- qdc_reexport(p, _, _, s, _).
qdc_spec(p, s) :- qdc_star(p, _, s).
// qdc_module(b, t): module t is a file whose path is b with one of the endings TypeScript tries (none, .ts, .tsx, …,
// /index.ts, …): an import of b names t.
.decl qdc_module(b: symbol, t: symbol)
qdc_module(b, t) :- doc(d, f, _), ts_module(d, t), qdc_ext(e), k = strlen(f) - strlen(e), k >= 0, b = substr(f, 0, k),
    f = cat(b, e).
.decl qdc_ext(e: symbol)
qdc_ext(""). qdc_ext(".ts"). qdc_ext(".tsx"). qdc_ext(".js"). qdc_ext(".jsx"). qdc_ext(".mts").
qdc_ext("/index.ts"). qdc_ext("/index.tsx"). qdc_ext("/index.js").
// qdc_target(p, s, t): specifier s, named by the file at path p, names workspace module t. It pairs two files, by
// their paths and modules alone.
.decl qdc_target(p: symbol, s: symbol, t: symbol) cross_file
qdc_target(p, s, t) :- qdc_spec(p, s), prefix(".", s), qdc_module(@join(@dir(p), s), t).
qdc_target(p, s, t) :- qdc_alias(p, s, rest), qdc_root(p, a), qdc_module(@join(a, rest), t).
qdc_target(p, s, t) :- qdc_alias(p, s, rest), qdc_root(p, a), qdc_module(@join(@join(a, "src"), rest), t).
.decl qdc_alias(p: symbol, s: symbol, rest: symbol)
qdc_alias(p, s, substr(s, 2, strlen(s) - 2)) :- qdc_spec(p, s), (prefix("@/", s) ; prefix("~/", s) ; prefix("#/", s)).
// qdc_root(p, a): a is the folder of the file at path p, which imports an alias, or a folder above it.
.decl qdc_root(p: symbol, a: symbol)
qdc_root(p, @dir(p)) :- qdc_alias(p, _, _).
qdc_root(p, @dir(a)) :- qdc_root(p, a), a != "", a != ".", a != "/".
// qdc_hook_of(t, x, m): module t's name x is a Hook that returns m: declared there, `export default`, or re-exported
// through `export { x } from` and `export *` barrels.
.decl qdc_hook_of(t: symbol, x: symbol, m: symbol)
qdc_hook_of(t, x, m) :- qdc_def(_, t, x, m, "", "", "").
qdc_hook_of(t, x, m) :- qdc_def(p, t, x, m, cs, cx, cn), qdc_target(p, cs, t2), qdc_hook_of(t2, cx, cn).
qdc_hook_of(t, x, m) :- qdc_reexport(p, t, x, s, y), qdc_target(p, s, t2), qdc_hook_of(t2, y, m).
qdc_hook_of(t, x, m) :- qdc_star(p, t, s), qdc_target(p, s, t2), qdc_hook_of(t2, x, m), x != "default".
// qdc_true(p, cs, cx, cn): in the file at path p, the Hook imported as cx from cs returns cn; and, with all three "",
// what holds always. A finding reads it at its own file's path.
.decl qdc_true(p: symbol, cs: symbol, cx: symbol, cn: symbol)
qdc_true(p, "", "", "") :- doc(_, p, _).
qdc_true(p, s, x, m) :- qdc_import(p, s, x), qdc_target(p, s, t), qdc_hook_of(t, x, m).
// qdc_group_true(p, g): one of group g's conditions holds for the file at path p. qdc_unmet(p, n): a group need n
// names holds none: a reference sets the state elsewhere.
.decl qdc_group_true(p: symbol, g: symbol)
qdc_group_true(p, g) :- qdc_member(p, g, cs, cx, cn), qdc_true(p, cs, cx, cn).
.decl qdc_unmet(p: symbol, n: symbol)
qdc_unmet(p, n) :- qdc_need_group(p, n, g), !qdc_group_true(p, g).

