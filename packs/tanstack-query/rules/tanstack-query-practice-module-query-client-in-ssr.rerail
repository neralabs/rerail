    .fixture "apps/web/vitest.setup.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/vitest.setup.ts"
    .fixture "package.json" from "../cases/tanstack-query-practice-module-query-client-in-ssr/package.json"
    .fixture "packages/graphql/package.json" from "../cases/tanstack-query-practice-module-query-client-in-ssr/packages/graphql/package.json"
    .fixture "packages/graphql/src/index.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/packages/graphql/src/index.ts"
