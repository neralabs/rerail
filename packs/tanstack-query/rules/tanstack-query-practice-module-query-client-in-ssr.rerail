    .fixture "apps/web/src/lib/const-guard-getter.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/const-guard-getter.ts"
    .fixture "apps/web/src/lib/get-query-client.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/get-query-client.ts"
    .fixture "apps/web/src/lib/legacy-client.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/legacy-client.ts"
    .fixture "apps/web/src/lib/make-query-client.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/make-query-client.ts"
    .fixture "apps/web/src/lib/namespace-client.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/namespace-client.ts"
    .fixture "apps/web/src/lib/query-client.test.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/query-client.test.ts"
    .fixture "apps/web/src/lib/query-client.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/query-client.ts"
    .fixture "apps/web/src/lib/query-store.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/query-store.ts"
    .fixture "apps/web/src/lib/search-client.ts" from "../cases/tanstack-query-practice-module-query-client-in-ssr/apps/web/src/lib/search-client.ts"
