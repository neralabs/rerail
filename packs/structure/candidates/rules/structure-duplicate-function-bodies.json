          ]
        }
      }
    },
    {
      "id": "duplicate-function-body-rs",
      "violation": {
        "code": "DUPLICATE_FUNCTION_BODY",
        "anchor": "witness.span",
        "message": "Keep one copy of each function. This body is repeated verbatim in another file: import the existing function, or move it to a shared module. Leave copies across a deliberate boundary."
      },
      "budget": {
        "query": {
          "evidence": {
            "as": "fn",
            "paths": {
              "include": [
                "**/*.rs"
              ]
            },
            "query": {
              "ast": {
                "language": "rust",
                "rule": {
                  "pattern": "$BODY",
                  "kind": "block",
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "kind": "mod_item",
                      "regex": "(?s)^\\s*mod\\s+tests\\b"
                    }
                  },
                  "inside": {
                    "kind": "function_item"
                  },
                  "layout": {
                    "span": {
                      "min": 10
                    }
                  }
                }
              }
            },
            "project": {
              "body": "capture.BODY",
