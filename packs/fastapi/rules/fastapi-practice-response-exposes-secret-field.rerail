.policy "fastapi-practice-response-exposes-secret-field" revision 1
.description "Declare a FastAPI route's response model without the password hash or the stored keys and secrets of a database row, so clients never receive them."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. FastAPI's response model is its output filter: what a route returns is validated
// into the model and serialized with the model's fields only. A route whose response model declares a password hash,
// an API key or a secret, or a route with no response model that returns the ORM row itself, sends that value to every
// client that can call it (FastAPI's Response Model docs: "could be sending our user's passwords to every client";
// OWASP API3, Broken Object Property Level Authorization).
//
// Reported, at the response model or at the `return`:
//   1. a route's response model (`response_model=X`, else its return annotation) names a class that declares a secret
//      field, also inside `List[X]`, `list[X]`, `Page[X]`, `Optional[X]`, `X | None` and module aliases of them;
//   2. a route with no response model (no `response_model=` and no return annotation, `-> Any`, or
//      `response_model=None`) returns a model instance whose class declares one: `db.get(User, id)` (awaited too),
//      `db.query(User)....first()/one()/all()/...`, `session.exec(select(User)).first()`, `session.scalars(...)` and
//      a result name assigned from `session.execute(select(User))`, `User(...)`, a parameter its dependency fills
//      (`current_user: CurrentUser`), a call of a function annotated to return an ORM model, or a local name whose
//      last assignment before the `return` is one of those.
// A class declares a field when its body or a base class's in the run assigns or annotates the name: SQLAlchemy
// `Column(...)`/`mapped_column(...)`/`Mapped[...]`, SQLModel and pydantic fields. The names, whole:
//   - password, hashed_password, password_hash, passwd: in any model, never for a client;
//   - secret, client_secret, api_key, secret_key, private_key, otp_secret, totp_secret, mfa_secret, access_token,
//     refresh_token: only on an ORM model (a table: `__tablename__`, `table=True`, a `Column`/`mapped_column`/
//     `Mapped` field, a SQLAlchemy declarative base), the stored row sent as it is. A pydantic schema written to
//     carry one is a design choice: a login route's Token, a new API key shown once, a TOTP enrolment secret,
//     Stripe's client_secret that the browser needs (polar's 31 such routes).
//   @router.get("/me", response_model=UserInDB)   # UserInDB declares hashed_password     reported
//   def me(current_user: CurrentUser): return current_user   # no response model           reported
//   @router.get("/me", response_model=UserPublic)  # without the field                     not reported
//   @router.post("/login", response_model=Token)    # access_token on a token schema        not reported
// Left alone: fields typed SecretStr/SecretBytes or ClassVar, fields with `Field(exclude=True)`, a route whose
// `response_model_exclude` names the field or whose `response_model_include` leaves it out (either one written as a
// variable counts as filtering), names that only contain a secret word (`password_changed_at`, `has_password`,
// `secret_name`), request bodies, hand-built `Response`/`JSONResponse` objects, `select(User.email)` and multi-entity
// rows, and test files.
// Gaps: secret fields of nested models (`owner: User` inside the response model); dicts and lists built around a row
// (`{"user": user}`); generic CRUD helpers whose return type is a TypeVar; a field renamed by `Column("password")`;
// pydantic v1 `Config.fields` exclusions.

#include "lib/fastapi.rerail"

.violation ResponseModelExposesSecret(at: node, model: symbol, name: symbol) "The response model `{model}` declares `{name}`, so FastAPI serializes it to every client that calls this route. Declare a response model without it (`response_model={model}Public`, or a return annotation with such a model): a password hash or a stored key is never for clients."
ResponseModelExposesSecret(r, m, x) :- rse_rm_class(f, dc, r, q), rse_exposed(q, x), !rse_filtered(dc, x),
    docof(f, d), !fa_test_doc(d), split_dot(q, _, m).

.violation RouteReturnsSecret(at: node, model: symbol, name: symbol) "This route has no response model and returns a `{model}`, so FastAPI serializes its `{name}` field to every client that calls it. Declare a response model without the field (`response_model={model}Public`, or a return annotation with such a model): a password hash or a stored key is never for clients."
RouteReturnsSecret(r, m, x) :- rse_ret(f, r, e), rse_inst(e, q), rse_exposed(q, x), docof(f, d), !fa_test_doc(d),
    split_dot(q, _, m).

// ---- secret fields -----------------------------------------------------------------------------------------------
// rse_hash_name(x): a password or its hash: never for any client, in any model.
.decl rse_hash_name(x: symbol)
rse_hash_name("password"). rse_hash_name("hashed_password"). rse_hash_name("password_hash"). rse_hash_name("passwd").
// rse_key_name(x): a key, secret or token the server stores. A response schema written to show one (a new API key
// shown once, a TOTP enrolment secret, Stripe's client_secret meant for the browser) is a design choice, so these
// count only on an ORM model: the stored row sent as it is.
.decl rse_key_name(x: symbol)
rse_key_name("secret"). rse_key_name("client_secret"). rse_key_name("api_key"). rse_key_name("secret_key").
rse_key_name("private_key"). rse_key_name("otp_secret"). rse_key_name("totp_secret"). rse_key_name("mfa_secret").
rse_key_name("access_token"). rse_key_name("refresh_token").
.decl rse_any_name(x: symbol)
rse_any_name(x) :- rse_hash_name(x).
rse_any_name(x) :- rse_key_name(x).
// rse_class_stmt(c, a): assignment or bare annotation a sits directly in class c's body.
.decl rse_class_stmt(c: node, a: node)
rse_class_stmt(c, a) :- kind(a, "assignment"), scope_node(a, c), kind(c, "class_definition").
// rse_field(c, x, a): class c's body declares field x at a (`x = v`, `x: T = v`, `x: T`).
.decl rse_field(c: node, x: symbol, a: node)
rse_field(c, x, a) :- rse_class_stmt(c, a), field(a, "left", l), kind(l, "identifier"), text(l, x), rse_any_name(x).
// rse_hidden(a): the field is never serialized as is: SecretStr/SecretBytes (masked), ClassVar (no field),
// `Field(exclude=True)` as its value or in its Annotated metadata.
.decl rse_hidden(a: node)
rse_hidden(a) :- rse_field(_, _, a), field(a, "type", t), (n = t ; within(n, t)), (leaf_name(n, "SecretStr") ;
    leaf_name(n, "SecretBytes") ; leaf_name(n, "ClassVar")).
rse_hidden(a) :- rse_field(_, _, a), kind(k, "call"), within(k, a), call_name(k, "Field"),
    call_arg(k, -1, "exclude", v), kind(v, "true").
// rse_anc(q, b): b is q or one of its bases, in the run or not.
.decl rse_anc(q: symbol, b: symbol)
rse_anc(q, q) :- class_def(_, q).
rse_anc(q, b) :- subclass(q, b).
// rse_exposed(q, x): class q, or a base of it in the run, declares secret field x, and none of them hides it; a key
// name counts only when q is an ORM model.
.decl rse_declares(q: symbol, x: symbol)
rse_declares(q, x) :- rse_anc(q, b), class_def(c, b), rse_field(c, x, a), !rse_hidden(a).
.decl rse_hides(q: symbol, x: symbol)
rse_hides(q, x) :- rse_anc(q, b), class_def(c, b), rse_field(c, x, a), rse_hidden(a).
.decl rse_exposed(q: symbol, x: symbol)
rse_exposed(q, x) :- rse_declares(q, x), !rse_hides(q, x), rse_hash_name(x).
rse_exposed(q, x) :- rse_declares(q, x), !rse_hides(q, x), rse_key_name(x), rse_orm(q).

// ---- ORM models --------------------------------------------------------------------------------------------------
// rse_orm_own(c): class c's own definition makes it a table: `table=True` (SQLModel), `__tablename__`, a
// `Column(...)`/`mapped_column(...)` value or a `Mapped[...]` annotation.
.decl rse_orm_own(c: node)
rse_orm_own(c) :- kind(c, "class_definition"), field(c, "superclasses", al), child(al, k, _),
    kind(k, "keyword_argument"), field(k, "name", n), text(n, "table"), field(k, "value", v), kind(v, "true").
rse_orm_own(c) :- rse_class_stmt(c, a), field(a, "left", l), text(l, "__tablename__").
rse_orm_own(c) :- rse_class_stmt(c, a), field(a, "right", v), kind(v, "call"),
    (call_name(v, "Column") ; call_name(v, "mapped_column")).
rse_orm_own(c) :- rse_class_stmt(c, a), field(a, "type", t), (n = t ; within(n, t)), leaf_name(n, "Mapped").
.decl rse_orm_base(q: symbol)
rse_orm_base("sqlalchemy.orm.DeclarativeBase"). rse_orm_base("sqlalchemy.orm.DeclarativeBaseNoMeta").
rse_orm_base("sqlalchemy.orm.decl_api.DeclarativeBase").
.decl rse_orm(q: symbol)
rse_orm(q) :- rse_anc(q, b), class_def(c, b), rse_orm_own(c).
rse_orm(q) :- subclass(q, b), rse_orm_base(b).
// `Base = declarative_base()` in any module of the run.
rse_orm(q) :- subclass(q, b), fa_module_var(b, v), kind(v, "call"), call_name(v, "declarative_base").

// ---- response models ---------------------------------------------------------------------------------------------
// rse_rm(f, dc, r): route f's response model is type expression r: `response_model=` of its decorator dc, else its
// return annotation.
.decl rse_rm(f: node, dc: node, r: node)
rse_rm(f, dc, r) :- fa_route(f, dc, _, _), fa_route_kw(dc, "response_model", r), !kind(r, "none").
rse_rm(f, dc, r) :- fa_route(f, dc, _, _), !fa_route_kw(dc, "response_model", _), field(f, "return_type", t0),
    fa_strip(t0, r).
// rse_troot(r): a type expression whose classes the rule reads: response models, and the return annotations of
// functions a raw route calls.
.decl rse_troot(r: node)
rse_troot(r) :- rse_rm(_, _, r).
rse_troot(r) :- rse_called(g), field(g, "return_type", t0), fa_strip(t0, r).
// rse_tx(r, e): e is r, or a type argument inside it: `List[X]`, `Page[X]`, `Optional[X]`, `X | None`, the type of
// `Annotated[X, ...]`, the value of a module alias (`UserList = list[UserInDB]`).
.decl rse_tx(r: node, e: node)
rse_tx(r, r) :- rse_troot(r).
rse_tx(r, a) :- rse_tx(r, m), rse_targ(m, a).
rse_tx(r, v) :- rse_tx(r, m), (kind(m, "identifier") ; kind(m, "attribute")), fa_value(m, v0), fa_strip(v0, v),
    (kind(v, "subscript") ; kind(v, "generic_type") ; kind(v, "binary_operator")).
.decl rse_targ(m: node, a: node)
rse_targ(m, a) :- kind(m, "subscript"), !fa_annotated(m, _, _), field(m, "subscript", e), fa_strip(e, a).
rse_targ(m, a) :- kind(m, "generic_type"), !fa_annotated(m, _, _), child(m, p, 1), kind(p, "type_parameter"),
    child(p, t, _), fa_strip(t, a).
rse_targ(m, a) :- fa_annotated(m, a, _).
rse_targ(m, a) :- (kind(m, "binary_operator") ; kind(m, "union_type")), child(m, e, _), fa_strip(e, a).
// rse_rm_class(f, dc, r, q): route f's response model r names class q of the run.
.decl rse_rm_class(f: node, dc: node, r: node, q: symbol)
rse_rm_class(f, dc, r, q) :- rse_rm(f, dc, r), rse_tx(r, e), (kind(e, "identifier") ; kind(e, "attribute")),
    sym_of(e, q), class_def(_, q).
// rse_filtered(dc, x): route call dc filters field x out itself: `response_model_exclude` names it, or
// `response_model_include` does not; either one given as a variable counts as filtering.
.decl rse_mentions(v: node, x: symbol)
rse_mentions(v, x) :- fa_route_kw(_, _, v), (s = v ; within(s, v)), str(s, x), rse_any_name(x).
.decl rse_literal(v: node)
rse_literal(v) :- kind(v, "set") ; kind(v, "dictionary") ; kind(v, "list") ; kind(v, "tuple").
.decl rse_filtered(dc: node, x: symbol)
rse_filtered(dc, x) :- fa_route_kw(dc, "response_model_exclude", v), rse_mentions(v, x).
rse_filtered(dc, x) :- fa_route_kw(dc, "response_model_exclude", v), !rse_literal(v), rse_any_name(x).
rse_filtered(dc, x) :- fa_route_kw(dc, "response_model_include", v), rse_any_name(x), !rse_mentions(v, x).

// ---- raw returns -------------------------------------------------------------------------------------------------
// rse_raw(f): route f has no response model: no `response_model=` and no return annotation (or `-> Any`), or
// `response_model=None`.
.decl rse_raw(f: node)
rse_raw(f) :- fa_route(f, dc, _, _), !fa_route_kw(dc, "response_model", _), !field(f, "return_type", _).
rse_raw(f) :- fa_route(f, dc, _, _), !fa_route_kw(dc, "response_model", _), field(f, "return_type", t0),
    fa_strip(t0, t), (text(t, "Any") ; text(t, "typing.Any")).
rse_raw(f) :- fa_route(f, dc, _, _), fa_route_kw(dc, "response_model", v), kind(v, "none").
// rse_val(e, v): e with parentheses and `await` off.
.decl rse_val(e: node, v: node)
rse_val(e, v) :- unparen(e, v), !kind(v, "await").
rse_val(e, v) :- unparen(e, a), kind(a, "await"), child(a, b, 0), rse_val(b, v).
// rse_ret(f, r, e): return statement r of raw route f returns expression e.
.decl rse_ret(f: node, r: node, e: node)
rse_ret(f, r, e) :- rse_raw(f), kind(r, "return_statement"), def_frame(r, f), child(r, e0, _), !kind(e0, "comment"),
    rse_val(e0, e).
// rse_need(e): an expression whose instance class the rule asks for: what a raw route returns, and the value a
// returned name was last assigned.
.decl rse_need(e: node)
rse_need(e) :- rse_ret(_, _, e).
rse_need(w) :- rse_need(e), kind(e, "identifier"), text(e, x), latest_assign(e, x, a), rasg(_, x, v, a),
    rse_val(v, w).
// rse_called(g): a function some needed call calls.
.decl rse_called(g: node)
rse_called(g) :- rse_need(e), kind(e, "call"), field(e, "function", fn), sym_of(fn, fq), qualname(g, fq),
    kind(g, "function_definition").
.decl rse_row_method(m: symbol)
rse_row_method("first"). rse_row_method("one"). rse_row_method("one_or_none"). rse_row_method("scalar_one").
rse_row_method("scalar_one_or_none"). rse_row_method("scalar"). rse_row_method("all"). rse_row_method("get").
// rse_entity_call(s, q): call s selects whole rows of class q: `select(User)`, `query(User)`, one entity only.
.decl rse_entity_call(s: node, q: symbol)
rse_entity_call(s, q) :- kind(s, "call"), (call_name(s, "select") ; call_name(s, "query")), call_arg(s, 0, "", a),
    !call_arg(s, 1, "", _), unparen(a, ae), sym_of(ae, q), class_def(_, q).
// rse_entity_in(o, q): the receiver chain o selects rows of q: the call is in o, or o's root name was last assigned
// a value that makes it (`result = await session.execute(select(User))`).
.decl rse_entity_in(o: node, q: symbol)
rse_entity_in(o, q) :- rse_row_call(_, o), (s = o ; within(s, o)), rse_entity_call(s, q).
rse_entity_in(o, q) :- rse_row_call(_, o), (n = o ; within(n, o)), kind(n, "identifier"), text(n, x),
    latest_assign(n, x, a), within(s, a), rse_entity_call(s, q).
// rse_row_call(e, o): needed call e is `o.<row method>(...)`.
.decl rse_row_call(e: node, o: node)
rse_row_call(e, o) :- rse_need(e), kind(e, "call"), field(e, "function", fn), attr_of(fn, o, m), rse_row_method(m).
// rse_inst(e, q): needed expression e holds an instance (or a list of instances) of class q.
.decl rse_inst(e: node, q: symbol)
rse_inst(e, q) :- rse_need(e), kind(e, "call"), field(e, "function", fn), sym_of(fn, q), class_def(_, q).
rse_inst(e, q) :- rse_need(e), kind(e, "call"), field(e, "function", fn), attr_of(fn, _, "get"),
    call_arg(e, 0, "", a), unparen(a, ae), sym_of(ae, q), class_def(_, q).
rse_inst(e, q) :- rse_row_call(e, o), rse_entity_in(o, q).
rse_inst(e, q) :- rse_need(e), kind(e, "identifier"), text(e, x), latest_assign(e, x, a), rasg(_, x, v, a),
    rse_val(v, w), rse_inst(w, q).
// A parameter its dependency fills, never reassigned before the return.
rse_inst(e, q) :- rse_need(e), kind(e, "identifier"), text(e, x), !latest_assign(e, x, _), look(e, x, f),
    fa_param_dep(f, _, x, _), fa_param_type(f, _, x, t), sym_of(t, q), class_def(_, q).
// A call of a function of the run annotated to return an ORM model (`-> Optional[User]`, `-> list[User]`).
rse_inst(e, q) :- rse_need(e), kind(e, "call"), field(e, "function", fn), sym_of(fn, fq), qualname(g, fq),
    rse_called(g), field(g, "return_type", t0), fa_strip(t0, r), rse_tx(r, t),
    (kind(t, "identifier") ; kind(t, "attribute")), sym_of(t, q), class_def(_, q), rse_orm(q).

// The cases, `cases/fastapi-practice-response-exposes-secret-field/`, read as one repository: each line ending in
// `# caught` is reported, and no other line.
.test cases exactly
    .fixture "app/api/routes/raw.py" from "../cases/fastapi-practice-response-exposes-secret-field/app/api/routes/raw.py"
    .fixture "app/api/routes/users.py" from "../cases/fastapi-practice-response-exposes-secret-field/app/api/routes/users.py"
    .fixture "app/crud.py" from "../cases/fastapi-practice-response-exposes-secret-field/app/crud.py"
    .fixture "app/db/base.py" from "../cases/fastapi-practice-response-exposes-secret-field/app/db/base.py"
    .fixture "app/deps.py" from "../cases/fastapi-practice-response-exposes-secret-field/app/deps.py"
    .fixture "app/models.py" from "../cases/fastapi-practice-response-exposes-secret-field/app/models.py"
    .fixture "app/schemas.py" from "../cases/fastapi-practice-response-exposes-secret-field/app/schemas.py"
    .fixture "tests/test_routes.py" from "../cases/fastapi-practice-response-exposes-secret-field/tests/test_routes.py"
    .expect _ at "app/api/routes/raw.py":16
    .expect _ at "app/api/routes/raw.py":21
    .expect _ at "app/api/routes/raw.py":29
    .expect _ at "app/api/routes/raw.py":35
    .expect _ at "app/api/routes/raw.py":40
    .expect _ at "app/api/routes/raw.py":46
    .expect _ at "app/api/routes/raw.py":51
    .expect _ at "app/api/routes/raw.py":57
    .expect _ at "app/api/routes/raw.py":62
    .expect _ at "app/api/routes/raw.py":69
    .expect _ at "app/api/routes/raw.py":74
    .expect _ at "app/api/routes/users.py":13
    .expect _ at "app/api/routes/users.py":18
    .expect _ at "app/api/routes/users.py":23
    .expect _ at "app/api/routes/users.py":28
    .expect _ at "app/api/routes/users.py":33
    .expect _ at "app/api/routes/users.py":38
    .expect _ at "app/api/routes/users.py":44
    .expect _ at "app/api/routes/users.py":49
    .expect _ at "app/api/routes/users.py":53
    .expect _ at "app/api/routes/users.py":68
.end
