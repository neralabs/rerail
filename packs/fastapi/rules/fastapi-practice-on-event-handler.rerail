.policy "fastapi-practice-on-event-handler" revision 1
.description "Don't register startup or shutdown event handlers on a FastAPI app built with a lifespan; they never run, so move their code into the lifespan."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule. FastAPI's docs: "If you provide a `lifespan` parameter, `startup` and `shutdown` event handlers
// will no longer be called. It's all `lifespan` or all events, not both." FastAPI 0.165 (fastapi/routing.py) uses the
// given lifespan as the router's lifespan context and its `_DefaultLifespan`, which runs on_startup/on_shutdown, only
// when no lifespan is given. So a handler registered on an app built with `lifespan=` is dead code that looks alive.
// Reported (lib/fastapi_events): a registration (oe_site_at: `o.on_event(E)`, `o.add_event_handler(E, fn)`, decorator
// or by hand) whose receiver is an app built with `lifespan=` (oe_dead_at: the constructor itself, an import of it, or
// a parameter of a def some call of the run passes such an app; the receiver and the calls are read by symbol, so
// they may sit in other modules), and `on_startup=`/`on_shutdown=` on a constructor that also passes `lifespan=`.
//   app = FastAPI(lifespan=lifespan)
//   @app.on_event("startup")                       reported: never runs
//   def setup(app):
//       @app.on_event("shutdown")                  reported when a call of the run passes `app` above
// Left alone: registrations on an app without a lifespan (fastapi-practice-lifecycle-event-handler reports those), on
// a router (include_router merges the router's own default lifespan into the app's, so they run), a helper nobody
// calls or one called with an app without lifespan, another library's emitter (`pyee.EventEmitter().on_event(...)`),
// an event bus the run defines, Slack bolt's `app.event(...)`, socketio's `sio.on(...)`, and test files.
// Gaps: an app reached through a parameter passed down a second call (`setup(app)` calling `install(app)`), a
// parameter filled after `/` or after a comment in the signature, `app.router.on_startup.append(fn)`, and a sub-app
// mounted with `app.mount(...)` (Starlette runs no lifespan of a mounted app at all).

#include "lib/fastapi.rerail"
#include "lib/fastapi_events.rerail"

.violation OnEventNeverRuns(at: node, form: symbol) "This `{form}` handler never runs: its app is built with `lifespan=`, so FastAPI runs only the lifespan. Move the code into the lifespan (startup before `yield`, shutdown after) or delete it."
OnEventNeverRuns(c, m) :- oe_at(c, p, t), oe_site_at(p, t, m), oe_dead_at(p, t).
OnEventNeverRuns(v, k) :- oe_kw(r, k, v), oe_lifespan_app(r).

// The cases, `upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/`, read as one repository: each line
// ending in `# caught` is reported, and no other line.
.test cases exactly
    .fixture "app/__init__.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/__init__.py"
    .fixture "app/lifespan.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/lifespan.py"
    .fixture "app/main.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/main.py"
    .fixture "app/plugins.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/plugins.py"
    .fixture "app/routers/__init__.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/routers/__init__.py"
    .fixture "app/routers/items.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/routers/items.py"
    .fixture "app/startup.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/startup.py"
    .fixture "app/tests/__init__.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/tests/__init__.py"
    .fixture "app/tests/test_app.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/app/tests/test_app.py"
    .fixture "events/__init__.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/events/__init__.py"
    .fixture "events/bus.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/events/bus.py"
    .fixture "svc/__init__.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/svc/__init__.py"
    .fixture "svc/custom.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/svc/custom.py"
    .fixture "svc/legacy.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/svc/legacy.py"
    .fixture "svc/modern.py" from "../upstream/fastapi-practice/authored/fastapi-practice-on-event-handler/svc/modern.py"
    .expect _ at "app/main.py":14
    .expect _ at "app/main.py":21
    .expect _ at "app/main.py":22
    .expect _ at "app/main.py":23
    .expect _ at "app/main.py":24
    .expect _ at "app/main.py":32
    .expect _ at "app/plugins.py":6
    .expect _ at "app/plugins.py":9
    .expect _ at "app/plugins.py":14
    .expect _ at "app/startup.py":5
    .expect _ at "svc/custom.py":17
.end
