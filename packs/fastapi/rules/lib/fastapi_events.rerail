// lib/fastapi_events: FastAPI and Starlette startup/shutdown handler registrations, as the two fastapi-practice
// event rules read them (on-event-handler: a handler that never runs; lifecycle-event-handler: every other one).
//
// Interface
//   oe_site(c, form)        call c registers a handler: `o.on_event(E)` (a decorator, or applied by hand:
//                           `app.on_event("startup")(fn)`) or `o.add_event_handler(E, fn)` (also `event_type=`), form
//                           the method's name, outside test code, where o is an app or router (lib/fastapi's
//                           fa_router_ref, or `app.router` of an app), or, when E is the literal "startup" or
//                           "shutdown", any other receiver (letta registers on an unannotated parameter `app`) unless
//                           it is foreign (oe_foreign: built by a class or a function outside the run,
//                           `pyee.EventEmitter()`; a parameter annotated with another class) or the call reaches an
//                           on_event/add_event_handler method the run defines itself (an event bus)
//   oe_kw(r, k, v)          app or router constructor r passes `on_startup=v` or `on_shutdown=v` (k), v neither None
//                           nor an empty list, outside test code
//   oe_dead(c)              registration c is on an app (FastAPI/Starlette, not a router) built with `lifespan=`: the
//                           receiver refers to that constructor, or it is a parameter of a def that some call of the run
//                           (python/calls) passes such an app, positionally or by keyword
//   oe_lifespan_app(r)      constructor r builds an app (not a router) with `lifespan=` (not None)
// FastAPI background: an app built with `lifespan=` runs only the lifespan (fastapi/routing.py uses `_DefaultLifespan`,
// which runs on_startup/on_shutdown, only when no lifespan is given). A router's handlers are not dead under an
// including app's lifespan: include_router merges the router's own default lifespan into the app's
// (`_merge_lifespan_context`). Only `on_event` is marked deprecated in FastAPI; `add_event_handler` and
// `on_startup=`/`on_shutdown=` are FastAPI's own and work, until the app gets a lifespan.
#include "fastapi.rerail"

// ---- registrations -----------------------------------------------------------------------------------------------
.decl oe_event(s: symbol)
oe_event("startup"). oe_event("shutdown").
// oe_reg(c, o, form): call c is `o.on_event(...)` or `o.add_event_handler(...)`.
.decl oe_reg(c: node, o: node, form: symbol)
oe_reg(c, o, m) :- kind(c, "call"), field(c, "function", fn), attr_of(fn, o0, m),
    (m = "on_event" ; m = "add_event_handler"), unparen(o0, o).
// oe_literal(c): its event is the literal "startup" or "shutdown".
.decl oe_literal(c: node)
oe_literal(c) :- oe_reg(c, _, _), (call_arg(c, 0, "", e0) ; call_arg(c, -1, "event_type", e0)), unparen(e0, e),
    str(e, s), oe_event(s).
// oe_own(c): c calls an on_event/add_event_handler method the run defines (an event bus of its own).
.decl oe_own(c: node)
oe_own(c) :- oe_reg(c, _, m), call_target(c, g), def_name(g, m).
// oe_recv(o, r): receiver o stands for app or router r (a constructor, or an annotated parameter): directly, or as
// `x.router` of an app x.
.decl oe_recv(o: node, r: node)
oe_recv(o, r) :- oe_reg(_, o, _), fa_router_ref(o, r).
oe_recv(o, r) :- oe_reg(_, o, _), attr_of(o, x0, "router"), unparen(x0, x), fa_router_ref(x, r), fa_ctor(r, "app").
.decl oe_site(c: node, form: symbol)
oe_site(c, m) :- oe_reg(c, o, m), oe_recv(o, _), docof(c, d), !fa_test_doc(d).
oe_site(c, m) :- oe_reg(c, o, m), !oe_recv(o, _), oe_literal(c), !oe_own(c), !oe_foreign(o), docof(c, d),
    !fa_test_doc(d).
// oe_foreign(o): receiver o is another object than an app: a name bound to a call that builds no app or router and
// resolves to a class (`emitter = pyee.EventEmitter()`, `sio = socketio.AsyncServer()`, a class of the run) or to
// anything else outside the run's functions, or a parameter annotated with a class other than an app or router
// (`def wire(bus: EventBus)`). A name bound to a call of a function of the run (`app = create_app()`) is not foreign.
.decl oe_foreign(o: node)
oe_foreign(o) :- oe_reg(_, o, _), fa_value(o, v), kind(v, "call"), field(v, "function", f), sym_of(f, q),
    !fa_ctor(v, _), !oe_run_fn(q).
.decl oe_run_fn(q: symbol)
oe_run_fn(q) :- qualname(g, q), kind(g, "function_definition").
oe_foreign(o) :- oe_reg(_, o, _), kind(o, "identifier"), text(o, x), look(o, x, f), sig_param(f, p, nm, _, _, a, _),
    text(nm, x), !unset(a), !fa_router_param(p, _).

// ---- the app's lifespan ------------------------------------------------------------------------------------------
// oe_lifespan_app(r): constructor r builds an app (not a router) with a lifespan.
.decl oe_lifespan_app(r: node)
oe_lifespan_app(r) :- fa_ctor(r, "app"), fa_router_kw(r, "lifespan", v), !kind(v, "none").
// oe_param_site(c, f, x): registration c's receiver is parameter x of def f.
.decl oe_param_site(c: node, f: node, x: symbol)
oe_param_site(c, f, x) :- oe_site(c, _), oe_reg(c, o, _), kind(o, "identifier"), text(o, x), look(o, x, f),
    kind(f, "function_definition"), param_named(f, x, _).
.decl oe_param_def(f: node)
oe_param_def(f) :- oe_param_site(_, f, _).
// oe_passed(k, h, x, a): call k, whose target is h, passes argument a to h's parameter x.
.decl oe_passed(k: node, h: node, x: symbol, a: node)
oe_passed(k, h, x, a) :- oe_param_def(h), call_target(k, h), call_arg(k, j, "", a0), unparen(a0, a), oe_offset(h, n),
    i = j + n, sig_param(h, _, nm, i, kd, _, _), (kd = "pos" ; kd = "posonly"), text(nm, x).
oe_passed(k, h, x, a) :- oe_param_def(h), call_target(k, h), call_arg(k, -1, x, a0), unparen(a0, a),
    param_named(h, x, _).
// oe_offset(h, n): a call's first positional argument fills h's parameter n: 1 for a method's self or cls.
.decl oe_offset(h: node, n: number)
oe_offset(h, 1) :- oe_param_def(h), nearest(h, k, scope), kind(k, "class_definition"), !oe_static(h).
oe_offset(h, 0) :- oe_param_def(h), nearest(h, k, scope), kind(k, "class_definition"), oe_static(h).
oe_offset(h, 0) :- oe_param_def(h), nearest(h, k, scope), !kind(k, "class_definition").
.decl oe_static(h: node)
oe_static(h) :- decorator(h, e), unparen(e, m), sym_of(m, "staticmethod").
oe_static(h) :- decorator(h, e), unparen(e, m), kind(m, "identifier"), text(m, "staticmethod").
// oe_dead(c): registration c is on an app built with `lifespan=`.
.decl oe_dead(c: node)
oe_dead(c) :- oe_site(c, _), oe_reg(c, o, _), oe_recv(o, r), oe_lifespan_app(r).
oe_dead(c) :- oe_param_site(c, f, x), oe_passed(_, f, x, a), fa_router_ref(a, r), oe_lifespan_app(r).

// ---- constructor keywords ----------------------------------------------------------------------------------------
// oe_kw(r, k, v): constructor r passes `on_startup=v` or `on_shutdown=v`, v neither None nor an empty list.
.decl oe_kw(r: node, k: symbol, v: node)
oe_kw(r, k, v) :- fa_ctor(r, _), (k = "on_startup" ; k = "on_shutdown"), fa_router_kw(r, k, v), !kind(v, "none"),
    !oe_empty(v), docof(r, d), !fa_test_doc(d).
.decl oe_empty(v: node)
oe_empty(v) :- (kind(v, "list") ; kind(v, "tuple")), count : { fa_list_item(v, _) } = 0.
