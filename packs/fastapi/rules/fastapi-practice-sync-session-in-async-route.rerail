.policy "fastapi-practice-sync-session-in-async-route" revision 1
.description "An async FastAPI route, dependency or middleware must not run sync SQLAlchemy session work, itself or through helpers; use def, an AsyncSession or run_in_threadpool."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. FastAPI runs a `def` route or dependency in its threadpool and an `async def` one on
// the event loop, so a blocking query on a sync SQLAlchemy/SQLModel session written in, or reached from, an
// `async def` that FastAPI calls per request (a route, a dependency, HTTP middleware) stalls every concurrent request
// for its duration. It reports, outside test code, in such an async def's own frame (not a nested def or lambda) and
// not awaited:
//   - SessionCallInAsync: a blocking session method (ss_blocking: query, execute, scalars, scalar, get, commit,
//     flush, refresh, rollback, delete, merge, exec, close, remove) called on a sync session: a parameter holding
//     the request's session (lib/fastapi's fa_session_param: annotated `Session`, through Annotated or an alias such
//     as `SessionDep`, or filled by a dependency that yields a sync session), a session the function opens
//     (`with SessionLocal() as s`, `s = SessionLocal()`, `s = open_session()` where `open_session` is a sync def
//     annotated `-> Session` or returning one, `with session_scope() as s` for a @contextmanager yielding one),
//     `request.state.<x>` when the run assigns a sync session to `<anything>.state.<x>`, or a class attribute
//     holding one (`Trade.session`, `self.session`). In a chain (`db.query(User).filter(...).all()`) only the root
//     call on the session is reported.
//   - SessionReached: a call whose target (python/calls, across files) is surely a sync def that runs such work on a
//     sync session it receives (a parameter annotated as one, or one a caller passes a session to, positionally or by
//     keyword), opens itself, or reads from an attribute holding one, directly or through further sync defs. It
//     names the first session call it reaches.
//   routes.py:  async def r(db=Depends(get_db)): db.query(User).all()          reported at db.query
//   crud.py:    def get_users(db: Session): return db.query(User).all()
//   routes.py:  async def r(db=Depends(get_db)): return get_users(db)        reported at get_users(db)
//   main.py:    @app.middleware("http") ... request.state.db.commit()        reported, when request.state.db = SessionLocal()
// Left alone: a `def` route or dependency (the threadpool); an AsyncSession and awaited calls; work handed to
// `run_in_threadpool`, `asyncio.to_thread`, `anyio.to_thread.run_sync` or `loop.run_in_executor` (the helper is an
// argument, not a call) or written in a nested def or lambda; `db.add()`, `add_all()`, `expunge()`, which do no IO;
// an async helper (calling one only makes a coroutine); a call whose target is unknown (call_open); a `Session`
// from another library (`requests.Session`), told apart by its import; test files.
//   routes.py:  async def r(db=Depends(get_db)): return await run_in_threadpool(get_users, db)    not reported
//   routes.py:  def r(db=Depends(get_db)): return get_users(db)                                  not reported
// Gaps: a session reached through a value the call program or this rule cannot follow (a property or
// cached_property returning a repository built on the session, a session held in a container); an `async def`
// helper that is awaited and does sync session work inside (it is not a start: only per-request functions are);
// blocking calls that are not session methods (`inspect(engine)`, `engine.connect()`, sleep, HTTP), which
// python-practice-blocking-call-reached-from-async owns for the framework-free ones.

#include "lib/fastapi.rerail"
#include "python/calls.rerail"
#include "python/types.rerail"

.violation SessionCallInAsync(at: node, what: symbol, fx: symbol)
    "`{what}` runs blocking IO on a sync SQLAlchemy session inside `async def {fx}`, stalling the event loop and every concurrent request. If `{fx}` awaits nothing and sets no ContextVar the request reads, declare it with plain `def` (FastAPI runs it in a threadpool); otherwise move to an `AsyncSession`, or put the session work in a sync helper called through `await run_in_threadpool(...)`."
SessionCallInAsync(o, what, fx) :- ss_work(o, f, what), ss_async_start(f), def_name(f, fx).
.violation SessionReached(at: node, x: symbol, fx: symbol, what: symbol, p: symbol, o: node)
    "`{x}()` runs blocking IO on a sync SQLAlchemy session (`{what}` at {p}:{o.line}) inside `async def {fx}`, stalling the event loop and every concurrent request. If `{fx}` awaits nothing and sets no ContextVar the request reads, declare it with plain `def` (FastAPI runs it in a threadpool); otherwise call the helper through `await run_in_threadpool({x}, ...)`, or move to an `AsyncSession`."
SessionReached(c, x, fx, what, p, o) :- ss_start(f, c, g), def_name(f, fx), field(c, "function", fn), text(fn, x),
    o = min y : { ss_reach(g, h), ss_work(y, h, _) }, ss_work(o, _, what), docof(o, d), doc(d, p, _).

// ss_stop: code in a nested def, lambda or class runs later, not in the frame that writes it.
.decl ss_stop(k: symbol)
ss_stop("function_definition"). ss_stop("lambda"). ss_stop("class_definition").

// ss_async_start(f): async def f, outside test code, that FastAPI calls per request: lib/fastapi's fa_per_request, or
// a route registered by calling the decorator (`app.get("/x")(f)`), which lib/fastapi's fa_route does not read.
.decl ss_async_start(f: node)
ss_async_start(f) :- ss_per_request(f), is_async(f), docof(f, d), !fa_test_doc(d).
.decl ss_per_request(f: node)
ss_per_request(f) :- fa_per_request(f).
ss_per_request(f) :- kind(c, "call"), field(c, "function", dc), kind(dc, "call"), field(dc, "function", fn),
    attr_of(fn, o, m), fa_route_verb(m), fa_router_ref(o, _), call_arg(c, 0, "", e0), unparen(e0, e), sym_of(e, q),
    qualname(f, q), kind(f, "function_definition").

// ss_start(f, c, g): call c, in async start f's own frame and not awaited, surely calls the sync def g: the call
// program's only answers (no unknown target), or, where it has none, a method reached through a property
// (ss_prop_call).
.decl ss_start(f: node, c: node, g: node)
ss_start(f, c, g) :- ss_async_start(f), kind(c, "call"), nearest(c, f, ss_stop), !awaited(c), ss_target(c, g),
    ss_sync(g).
.decl ss_target(c: node, g: node)
ss_target(c, g) :- kind(c, "call"), !call_open(c), call_target(c, g).
ss_target(c, g) :- ss_prop_call(c, g), !call_target(c, _).
.decl ss_sync(g: node)
ss_sync(g) :- kind(g, "function_definition"), !is_async(g).
// ss_reach(g, h): from start g, the sync def h runs in the same thread: g, or a call in a reached def's own frame.
.decl ss_reach(g: node, h: node)
ss_reach(g, g) :- ss_start(_, _, g).
ss_reach(g, h) :- ss_reach(g, x), call_target(c, h), nearest(c, x, ss_stop), ss_sync(h).
ss_reach(g, h) :- ss_reach(g, x), ss_prop_call(c, h), !call_target(c, _), nearest(c, x, ss_stop), ss_sync(h).

// ss_prop_call(c, g): c is `r.p.m(...)` where the type program proves r an instance of class k, p is a property or
// cached_property of k whose return annotation names a class q of the run, and q's method m is g
// (`repos.users.get_one(...)` with `@cached_property def users(self) -> RepositoryUsers`). The call program leaves
// such calls open.
.decl ss_prop_call(c: node, g: node)
ss_prop_call(c, g) :- kind(c, "call"), field(c, "function", fn), attr_of(fn, pe, m), attr_of(pe, r, p),
    proven_type(r, kq), ss_method(kq, p, pd), ss_property(pd), field(pd, "return_type", rt0), fa_strip(rt0, rt),
    ss_class_of(rt, q), ss_method(q, m, g).
.decl ss_property(pd: node)
ss_property(pd) :- decorator(pd, e), unparen(e, d), (sym_of(d, "property") ; sym_of(d, "builtins.property") ;
    sym_of(d, "functools.cached_property")).
// ss_class_of(t, q): type expression t names class q of the run, or a parametrized one (`Repo[User]`).
.decl ss_class_of(t: node, q: symbol)
ss_class_of(t, q) :- sym_of(t, q), class_def(_, q).
ss_class_of(t, q) :- fa_sub(t, q), class_def(_, q).
// ss_super(q, b): class q inherits from b, also through a parametrized base (`class R(Repo[User])`), which
// python/names' class_base does not read. ss_method(q, m, g): q's method m is g, its own or, if none, an ancestor's
// (python/names' mro_method, over ss_super).
.decl ss_base(q: symbol, b: symbol)
ss_base(q, b) :- class_def(c, q), class_base(c, b).
ss_base(q, b) :- class_def(c, q), field(c, "superclasses", al), child(al, e, _), fa_sub(e, b).
.decl ss_super(q: symbol, b: symbol)
ss_super(q, b) :- ss_base(q, b).
ss_super(q, b) :- ss_super(q, m), ss_base(m, b).
.decl ss_method(q: symbol, m: symbol, g: node)
ss_method(q, m, g) :- method(q, m, g).
ss_method(q, m, g) :- class_def(_, q), !method(q, m, _), ss_super(q, b), method(b, m, g).

// ---- session work ------------------------------------------------------------------------------------------------
// ss_blocking(m): Session methods that do IO (a query, a flush, a connection's commit, rollback or release).
// `remove` is scoped_session's: it closes the current session.
.decl ss_blocking(m: symbol)
ss_blocking("query"). ss_blocking("execute"). ss_blocking("scalars"). ss_blocking("scalar"). ss_blocking("get").
ss_blocking("commit"). ss_blocking("flush"). ss_blocking("refresh"). ss_blocking("rollback"). ss_blocking("delete").
ss_blocking("merge"). ss_blocking("exec"). ss_blocking("close"). ss_blocking("remove").
// ss_work(o, h, what): call o, in def h's own frame and not awaited, is a blocking method on a sync session.
.decl ss_work(o: node, h: node, what: symbol)
ss_work(o, h, cat(rt, ".", m, "()")) :- kind(o, "call"), field(o, "function", fn), attr_of(fn, r0, m), ss_blocking(m),
    unparen(r0, r), ss_expr(r), nearest(o, h, ss_stop), kind(h, "function_definition"), !awaited(o), text(r, rt).

// ss_expr(e): expression e holds a sync session: a name its scope binds to one (ss_name), `self.a`/`cls.a` or `K.a`
// for a class attribute a holding one (ss_attr), or `<x>.state.a` when the run assigns a session to `.state.a`.
.decl ss_expr(e: node)
ss_expr(e) :- kind(e, "identifier"), text(e, x), look(e, x, s), ss_name(s, x).
ss_expr(e) :- attr_of(e, o, a), kind(o, "identifier"), (text(o, "self") ; text(o, "cls")), text(o, y), look(o, y, m),
    nearest(m, k, scope), class_def(k, kq), ss_class_attr(kq, a).
ss_expr(e) :- attr_of(e, o, a), sym_of(o, q), class_def(_, q), ss_class_attr(q, a).
ss_expr(e) :- attr_of(e, s, a), attr_of(s, _, "state"), ss_state(a).
// ss_class_attr(q, a): class q, or one of its bases, has attribute a holding a sync session.
.decl ss_class_attr(q: symbol, a: symbol)
ss_class_attr(q, a) :- ss_attr(q, a).
ss_class_attr(q, a) :- ss_super(q, b), ss_attr(b, a).

// ss_name(h, x): in def h, the name x holds a sync session.
.decl ss_name(h: node, x: symbol)
// The request's session, from the parameter's type or its dependency.
ss_name(h, x) :- fa_session_param(h, _, x, "sync").
// A parameter annotated as a sync session, in any def.
ss_name(h, x) :- fa_param_type(h, _, x, t), ss_type(t).
// A session h opens: `x = SessionLocal()`, `with Session(engine) as x`, `x = open_session()`; or a local alias of a
// session.
ss_name(h, x) :- fa_bind(h, x, v), kind(h, "function_definition"), ss_maker(v).
ss_name(h, x) :- fa_bind(h, x, v), kind(h, "function_definition"), ss_expr(v).
ss_name(h, x) :- ss_with(w, x), nearest(w, h, ss_stop), kind(h, "function_definition").
// A parameter some caller passes a session to.
ss_name(h, x) :- ss_passed(c, h, x).
// ss_with(w, x): with-statement w binds x to the session its item makes (`with SessionLocal() as x`, `with
// session_scope() as x`).
.decl ss_with(w: node, x: symbol)
ss_with(w, x) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", ap), kind(ap, "as_pattern"), child(ap, v0, 0), unparen(v0, v),
    ss_maker(v), field(ap, "alias", t), child(t, n, 0), kind(n, "identifier"), text(n, x).
ss_with(w, x) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", ap), kind(ap, "as_pattern"), child(ap, v0, 0), unparen(v0, v),
    ss_maker(v), field(ap, "alias", t), kind(t, "identifier"), text(t, x).

// ss_passed(c, h, x): call c, whose target is h, passes a sync session to h's parameter x.
.decl ss_passed(c: node, h: node, x: symbol)
ss_passed(c, h, x) :- call_target(c, h), call_arg(c, j, "", a0), unparen(a0, a), ss_expr(a), ss_offset(h, n),
    i = j + n, sig_param(h, _, nm, i, k, _, _), (k = "pos" ; k = "posonly"), text(nm, x).
ss_passed(c, h, x) :- call_target(c, h), call_arg(c, -1, x, a0), unparen(a0, a), ss_expr(a), param_named(h, x, _).
// ss_offset(h, n): a call's first positional argument fills h's parameter n: 1 for a method's self or cls.
.decl ss_offset(h: node, n: number)
ss_offset(h, 1) :- kind(h, "function_definition"), nearest(h, k, scope), kind(k, "class_definition"), !ss_static(h).
ss_offset(h, 0) :- kind(h, "function_definition"), nearest(h, k, scope), kind(k, "class_definition"), ss_static(h).
ss_offset(h, 0) :- kind(h, "function_definition"), nearest(h, k, scope), !kind(k, "class_definition").
.decl ss_static(h: node)
ss_static(h) :- decorator(h, e), unparen(e, m), sym_of(m, "staticmethod").
ss_static(h) :- decorator(h, e), unparen(e, m), kind(m, "identifier"), text(m, "staticmethod").

// ss_type(t): type expression t names a sync session class: directly (lib/fastapi), as a parametrized class
// (`scoped_session[Session]`), through ClassVar, or through a module alias of either.
.decl ss_type(t: node)
ss_type(t) :- fa_session_type(t, "sync").
ss_type(t) :- fa_sub(t, q), fa_session_class(q, "sync").
ss_type(t) :- fa_sub(t, q), (q = "typing.ClassVar" ; q = "typing_extensions.ClassVar"), fa_sub_arg(t, 0, a), ss_type(a).
ss_type(t) :- fa_value(t, v), fa_sub(v, _), ss_type(v).
ss_type(t) :- fa_strip(t, m), m != t, ss_type(m).

// ss_maker(v): call v makes a sync session (lib/fastapi's fa_session_maker), calls a maker built inline
// (`sessionmaker(bind=e)()`), or surely calls a sync def that gives one (ss_returns).
.decl ss_maker(v: node)
ss_maker(v) :- fa_session_maker(v, "sync").
ss_maker(v) :- kind(v, "call"), field(v, "function", f0), unparen(f0, f), fa_maker_value(f, "sync").
ss_maker(v) :- kind(v, "call"), !call_open(v), call_target(v, g), ss_sync(g), ss_returns(g).
// A @contextmanager def is the call's target, with the call open (the decorator is outside the run).
ss_maker(v) :- kind(v, "call"), call_target(v, g), ss_sync(g), ss_returns(g), decorator(g, e), unparen(e, m),
    sym_of(m, "contextlib.contextmanager").
// ss_returns(g): def g returns or yields a sync session: its return annotation names one (`-> Session`,
// `-> Iterator[Session]` on a @contextmanager), or it returns or yields a session it makes or holds.
.decl ss_returns(g: node)
ss_returns(g) :- kind(g, "function_definition"), field(g, "return_type", rt0), fa_strip(rt0, rt), ss_type(rt).
ss_returns(g) :- fa_gives(g, e), ss_maker(e).
ss_returns(g) :- fa_gives(g, e), kind(e, "identifier"), text(e, x), ss_name(g, x).

// ss_attr(q, a): class q declares attribute a as a sync session (`session: ClassVar[SessionType]`, `session:
// Session`), or one of its methods assigns `self.a` a sync session (`self.session = session` with `session: Session`).
.decl ss_attr(q: symbol, a: symbol)
ss_attr(q, a) :- class_def(c, q), field(c, "body", b), child(b, s, _), kind(s, "expression_statement"),
    child(s, n, 0), kind(n, "assignment"), field(n, "left", l), kind(l, "identifier"), text(l, a), field(n, "type", t0),
    fa_strip(t0, t), ss_type(t).
ss_attr(q, a) :- assigned_attr(m, "self", a, r0), unparen(r0, r), (ss_expr(r) ; ss_maker(r)), nearest(m, c, scope),
    class_def(c, q).

// ss_state(a): the run assigns a sync session to `<x>.state.a` (`request.state.db = SessionLocal()`).
.decl ss_state(a: symbol)
ss_state(a) :- kind(n, "assignment"), field(n, "left", l), attr_of(l, s, a), attr_of(s, _, "state"),
    field(n, "right", r0), fa_unwrap(r0, r), (ss_maker(r) ; ss_expr(r)).

// The cases, `cases/fastapi-practice-sync-session-in-async-route/`, read as one repository: each line ending in
// `# caught` is reported, and no other line.
.test cases exactly
    .fixture "app/__init__.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/__init__.py"
    .fixture "app/crud.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/crud.py"
    .fixture "app/db.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/db.py"
    .fixture "app/deps.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/deps.py"
    .fixture "app/main.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/main.py"
    .fixture "app/models.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/models.py"
    .fixture "app/routes.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/routes.py"
    .fixture "app/tests/__init__.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/tests/__init__.py"
    .fixture "app/tests/test_routes.py" from "../cases/fastapi-practice-sync-session-in-async-route/app/tests/test_routes.py"
    .expect _ at "app/main.py":17
    .expect _ at "app/main.py":18
    .expect _ at "app/main.py":29
    .expect _ at "app/main.py":37
    .expect _ at "app/routes.py":21
    .expect _ at "app/routes.py":27
    .expect _ at "app/routes.py":28
    .expect _ at "app/routes.py":36
    .expect _ at "app/routes.py":41
    .expect _ at "app/routes.py":42
    .expect _ at "app/routes.py":43
    .expect _ at "app/routes.py":44
    .expect _ at "app/routes.py":45
    .expect _ at "app/routes.py":53
    .expect _ at "app/routes.py":59
    .expect _ at "app/routes.py":63
    .expect _ at "app/routes.py":67
    .expect _ at "app/routes.py":68
    .expect _ at "app/routes.py":131
    .expect _ at "app/routes.py":132
    .expect _ at "app/routes.py":141
    .expect _ at "app/routes.py":147
.end
