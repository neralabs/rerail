.policy "fastapi-practice-cors-wildcard-with-credentials" revision 1
.description "Don't let a FastAPI or Starlette CORS middleware allow every origin while it allows credentials; list the allowed origins or drop the credentials."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule. Given `allow_origins=["*"]` (or an origin regex that matches everything) and
// `allow_credentials=True`, Starlette's CORSMiddleware answers a request from any Origin by echoing that Origin back
// with `Access-Control-Allow-Credentials: true` (starlette/middleware/cors.py: `send` calls allow_explicit_origin when
// `self.allow_all_origins and self.allow_credentials`, and preflights echo the Origin when credentials are on, as they
// do for every origin a regex fullmatches), so any website a logged-in user visits can
// send cookie-authenticated requests and read the responses. semgrep's wildcard-cors flags the literal only and ignores
// the credentials; Bandit and Ruff have nothing.
// The middleware is Starlette's CORSMiddleware (starlette.middleware.cors, fastapi.middleware.cors) or a subclass of
// the run, configured by `x.add_middleware(M, ...)`, `Middleware(M, ...)` (in `FastAPI(middleware=[...])`,
// `Starlette(middleware=[...])`) or `M(app, ...)`. Its origins allow everyone when `allow_origins`:
//   - is a list or tuple literal containing "*", or the string "*";
//   - is a name or attribute whose value, in this module or another one of the run, is such a value, or a `+` of
//     lists one of which is;
//   - is `os.getenv("X", "*")` / `os.environ.get("X", "*")`, or `x or "*"` (`x or ["*"]`), maybe followed by
//     `.split(...)` (an environment default);
//   - is `<settings>.F` where <settings> is an instance of a class of the run (`settings = Settings()`, or the
//     `Settings()` a function such as `get_settings()` returns) built without F, whose field F defaults to such a value
//     (`F: list[str] = ["*"]`, `F = Field(default=["*"])`, in the class or a base it inherits F from);
// or when `allow_origin_regex` is a regex that matches every origin (".*", "^.*$", ".+", "https?://.*", ...).
// `allow_credentials` must be `True`, or a name whose value is `True`. The options are read from the call's keywords
// and from a `**kw` whose value is a dict literal or a `dict(...)` call (`cors_kwargs = dict(allow_origins=["*"], ...)`).
//   app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_credentials=True)              reported
//   app.add_middleware(CORSMiddleware, allow_origins=CORS_ALLOW_ORIGIN, allow_credentials=True)  reported when
//       CORS_ALLOW_ORIGIN = os.getenv("CORS_ALLOW_ORIGIN", "*").split(";")                       (an env default)
//   app.add_middleware(CORSMiddleware, allow_origins=[settings.FRONTEND_HOST], allow_credentials=True)  not reported
//   app.add_middleware(CORSMiddleware, allow_origins=["*"])                                       not reported: no
//                                                                                                 credentials
// Also left alone: values the rule cannot settle (a dict lookup, a call, a comprehension, a parameter, `self.x`), a
// settings instance built with the field or of a subclass that overrides it, a project's own regex (also a broad one
// such as "https?://.*\\..*": only the listed match-everything patterns count), a class that only shares the name
// CORSMiddleware, and test files. A wildcard under a dev-only `if` is reported: the branch's condition is not read.
// Gaps: a project's own CORS config objects (zenml's `CORSConfig(allow_origins=["*"], allow_credentials=True)`) that a
// framework later turns into the middleware; settings reached through a parameter or `self`; a settings validator that
// fills in "*" (zenml's server config); `allow_credentials` from a setting; positional middleware options; a value
// imported from a module of a namespace package (no __init__.py), whose module name the run takes from its path (the
// middleware subclass itself is matched there, below).

#include "lib/fastapi.rerail"

.violation CorsWildcardWithCredentials(at: node, arg: symbol) "`{arg}` allows every origin with `allow_credentials=True`, so any site can make cookie-authenticated reads. List the allowed origins; drop the credentials only if this public API needs no cookies."
.violation CorsWildcardDefaultWithCredentials(at: node, arg: symbol, src: symbol) "`{arg}` falls back to every origin (`{src}`) with `allow_credentials=True`, so any site can make cookie-authenticated reads. Default to an empty list, or drop the credentials for a public API."

// ---- the middleware ----------------------------------------------------------------------------------------------
// cors_q(q): q is Starlette's CORSMiddleware, under either import path, or a class of the run deriving from it.
.decl cors_q(q: symbol)
cors_q("starlette.middleware.cors.CORSMiddleware"). cors_q("fastapi.middleware.cors.CORSMiddleware").
cors_q(q) :- class_def(c, q), class_base(c, b), cors_q(b).
.decl cors_class_expr(e: node)
cors_class_expr(e) :- unparen(e, m), sym_of(m, q), cors_q(q).
// A subclass in a namespace package (a directory without __init__.py, as open-webui's `open_webui/utils/`) gets its
// module name from its path (`backend.open_webui.utils.asgi_middleware`), while the import names it from the package
// root (`open_webui.utils.asgi_middleware`): the import's name is a dotted suffix of the class's.
cors_class_expr(e) :- unparen(e, m), sym_of(m, q), !cors_q(q), cors_q(q2), class_def(_, q2), suffix(cat(".", q), q2).
// cors_call(c): call c configures CORS middleware with its keyword arguments.
.decl cors_call(c: node)
cors_call(c) :- kind(c, "call"), field(c, "function", fn), attr_of(fn, _, "add_middleware"), call_arg(c, 0, "", m),
    cors_class_expr(m).
cors_call(c) :- kind(c, "call"), field(c, "function", fn), sym_of(fn, q),
    (q = "starlette.middleware.Middleware" ; q = "fastapi.middleware.Middleware"), call_arg(c, 0, "", m),
    cors_class_expr(m).
cors_call(c) :- kind(c, "call"), field(c, "function", fn), cors_class_expr(fn).
// cors_kw(c, k, ka, v): cors_call c passes keyword k as the keyword_argument node ka, with value v.
.decl cors_kw(c: node, k: symbol, ka: node, v: node)
cors_kw(c, k, ka, v) :- cors_call(c), field(c, "arguments", al), child(al, ka, _), kind(ka, "keyword_argument"),
    field(ka, "name", n), text(n, k), field(ka, "value", v0), unparen(v0, v).
cors_kw(c, k, ka, v) :- cors_splat(c, d), kind(d, "dictionary"), child(d, ka, _), kind(ka, "pair"), field(ka, "key", kn),
    str(kn, k), field(ka, "value", v0), unparen(v0, v).
cors_kw(c, k, ka, v) :- cors_splat(c, d), kind(d, "call"), field(d, "arguments", al), child(al, ka, _),
    kind(ka, "keyword_argument"), field(ka, "name", n), text(n, k), field(ka, "value", v0), unparen(v0, v).
// cors_splat(c, d): cors_call c passes `**e`, e being (or naming) a dict literal or a `dict(...)` call d.
.decl cors_splat(c: node, d: node)
cors_splat(c, d) :- cors_call(c), field(c, "arguments", al), child(al, s, _), kind(s, "dictionary_splat"),
    child(s, e0, _), unparen(e0, e), cors_dict(e, d).
.decl cors_dict(e: node, d: node)
cors_dict(e, e) :- kind(e, "dictionary").
cors_dict(e, e) :- kind(e, "call"), call_name(e, "dict").
cors_dict(e, d) :- kind(e, "identifier"), fa_value(e, v), cors_dict(v, d).

// ---- values ------------------------------------------------------------------------------------------------------
.decl cors_true(e: node)
cors_true(e) :- kind(e, "true").
cors_true(e) :- fa_value(e, v), kind(v, "true").
// cors_env_star(e): e is `os.getenv(X, "*")` or `os.environ.get(X, "*")`.
.decl cors_env_star(e: node)
cors_env_star(e) :- kind(e, "call"), field(e, "function", f), sym_of(f, q), (q = "os.getenv" ; q = "os.environ.get"),
    (call_arg(e, 1, "", d) ; call_arg(e, -1, "default", d)), str(d, "*").
// cors_wild(e, how, w): e evaluates to origins that allow everyone. how is "literal" for the value itself, "default"
// for an environment variable's or a settings field's default; w is the node that holds the wildcard.
.decl cors_wild(e: node, how: symbol, w: node)
cors_wild(e, "literal", e) :- fa_list_item(e, i), str(i, "*").
cors_wild(e, "literal", e) :- str(e, "*").
cors_wild(e, "default", e) :- cors_env_star(e).
// `x or "*"`, `x or ["*"]`: the wildcard as the fallback.
cors_wild(e, "default", r) :- kind(e, "boolean_operator"), op(e, "or"), field(e, "right", r0), unparen(r0, r),
    cors_wild(r, "literal", _).
// `<origins>.split(",")`: what is split decides.
cors_wild(e, how, w) :- kind(e, "call"), field(e, "function", f), attr_of(f, o0, "split"), unparen(o0, o),
    cors_wild(o, how, w).
cors_wild(e, how, w) :- fa_value(e, v), cors_wild(v, how, w).
cors_wild(e, how, w) :- kind(e, "binary_operator"), op(e, "+"), (field(e, "left", s0) ; field(e, "right", s0)),
    unparen(s0, s), cors_wild(s, how, w).
cors_wild(e, "default", w) :- attr_of(e, o, a), cors_instance(o, k, v), !call_arg(v, -1, a, _), cors_field(k, a, d),
    cors_wild(d, _, w).
// cors_instance(o, k, v): expression o holds the instance of class k (of the run) that call v builds: a name bound to
// `K(...)`, the call itself, or a call of a function of the run that returns `K(...)` (`get_settings()`).
.decl cors_instance_call(o: node, v: node)
cors_instance_call(o, o) :- kind(o, "call").
cors_instance_call(o, v) :- fa_value(o, v), kind(v, "call").
cors_instance_call(o, r) :- cors_instance_call(o, v), field(v, "function", f), sym_of(f, q), qualname(g, q),
    kind(g, "function_definition"), fa_gives(g, r), kind(r, "call").
.decl cors_instance(o: node, k: node, v: node)
cors_instance(o, k, v) :- attr_of(_, o, _), cors_instance_call(o, v), field(v, "function", f), sym_of(f, q),
    class_def(k, q).
// cors_field(k, a, d): class k's field a defaults to d (`a: T = d`, `a = d`, `a = Field(d)`, `Field(default=d)`),
// set in k or inherited from a base of the run that k does not override.
.decl cors_field(k: node, a: symbol, d: node)
cors_field(k, a, d) :- kind(k, "class_definition"), fa_bind(k, a, d), !cors_field_call(d).
cors_field(k, a, d) :- kind(k, "class_definition"), fa_bind(k, a, c), cors_field_call(c),
    (call_arg(c, 0, "", d0) ; call_arg(c, -1, "default", d0)), unparen(d0, d).
cors_field(k, a, d) :- class_def(k, _), class_base(k, b), class_def(kb, b), cors_field(kb, a, d), !fa_bind(k, a, _).
.decl cors_field_call(c: node)
cors_field_call(c) :- kind(c, "call"), field(c, "function", f), sym_of(f, q),
    (q = "pydantic.Field" ; q = "pydantic.fields.Field" ; q = "sqlmodel.Field").
// cors_any_regex(s): an origin regex that matches every origin (Starlette fullmatches it against the Origin).
.decl cors_any_regex(s: symbol)
cors_any_regex(".*"). cors_any_regex("^.*$"). cors_any_regex("^.*"). cors_any_regex(".*$"). cors_any_regex("(.*)").
cors_any_regex(".+"). cors_any_regex("^.+$"). cors_any_regex("^.+"). cors_any_regex(".+$").
cors_any_regex("https?://.*"). cors_any_regex("^https?://.*$"). cors_any_regex("https?://.+").
cors_any_regex("^https?://.+$"). cors_any_regex("https://.*"). cors_any_regex("^https://.*$").
cors_any_regex("https://.+"). cors_any_regex("http://.*"). cors_any_regex("https?://.*$").
.decl cors_wild_regex(e: node)
cors_wild_regex(e) :- str(e, s), cors_any_regex(s).
cors_wild_regex(e) :- fa_value(e, v), cors_wild_regex(v).

// ---- the rule ----------------------------------------------------------------------------------------------------
.decl cors_credentialed(c: node)
cors_credentialed(c) :- cors_kw(c, "allow_credentials", _, v), cors_true(v), docof(c, d), !fa_test_doc(d).
.decl cors_literal_origins(c: node, arg: symbol)
cors_literal_origins(c, t) :- cors_credentialed(c), cors_kw(c, "allow_origins", ka, v), cors_wild(v, "literal", _),
    text(ka, t).
.decl cors_literal(c: node, arg: symbol)
cors_literal(c, t) :- cors_literal_origins(c, t).
cors_literal(c, t) :- cors_credentialed(c), !cors_literal_origins(c, _), cors_kw(c, "allow_origin_regex", ka, v),
    cors_wild_regex(v), text(ka, t).

CorsWildcardWithCredentials(c, t) :- cors_literal(c, t).
CorsWildcardDefaultWithCredentials(c, t, s) :- cors_credentialed(c), !cors_literal(c, _),
    cors_kw(c, "allow_origins", ka, v), cors_wild(v, "default", w), text(ka, t), text(w, s).

// The cases, `cases/fastapi-practice-cors-wildcard-with-credentials/`, read as one repository: each line ending in
// `# caught` is reported, and no other line.
.test cases exactly
    .fixture "app/__init__.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/app/__init__.py"
    .fixture "app/core/__init__.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/app/core/__init__.py"
    .fixture "app/core/config.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/app/core/config.py"
    .fixture "app/main.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/app/main.py"
    .fixture "app/middleware.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/app/middleware.py"
    .fixture "app/tests/__init__.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/app/tests/__init__.py"
    .fixture "app/tests/test_cors.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/app/tests/test_cors.py"
    .fixture "backend/webui/__init__.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/backend/webui/__init__.py"
    .fixture "backend/webui/config.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/backend/webui/config.py"
    .fixture "backend/webui/main.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/backend/webui/main.py"
    .fixture "backend/webui/utils/asgi.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/backend/webui/utils/asgi.py"
    .fixture "svc/__init__.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/svc/__init__.py"
    .fixture "svc/asgi.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/svc/asgi.py"
    .fixture "svc/own.py" from "../cases/fastapi-practice-cors-wildcard-with-credentials/svc/own.py"
    .expect _ at "app/main.py":24
    .expect _ at "app/main.py":31
    .expect _ at "app/main.py":32
    .expect _ at "app/main.py":33
    .expect _ at "app/main.py":35
    .expect _ at "app/main.py":37
    .expect _ at "app/main.py":38
    .expect _ at "app/main.py":43
    .expect _ at "app/main.py":44
    .expect _ at "app/main.py":45
    .expect _ at "app/main.py":52
    .expect _ at "app/main.py":53
    .expect _ at "app/main.py":54
    .expect _ at "app/main.py":57
    .expect _ at "app/main.py":58
    .expect _ at "app/main.py":61
    .expect _ at "app/main.py":63
    .expect _ at "app/main.py":64
    .expect _ at "app/main.py":66
    .expect _ at "app/main.py":67
    .expect _ at "app/main.py":69
    .expect _ at "backend/webui/main.py":7
    .expect _ at "svc/asgi.py":7
    .expect _ at "svc/asgi.py":12
    .expect _ at "svc/asgi.py":15
.end
