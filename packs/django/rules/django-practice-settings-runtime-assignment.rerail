.policy "django-practice-settings-runtime-assignment" revision 1
.description "Do not change django.conf.settings at runtime; set values in the settings file, and use override_settings in tests."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. Django's settings are read once and cached by the code that uses them; changing one
// at runtime does not send the setting_changed signal, so caches built from it go stale, and the change leaks into
// every later request (or test). It matches a write to an upper-case attribute of django.conf.settings outside test
// code: an assignment, an augmented assignment or a `del`, of the attribute or of an item inside it, and
// setattr/delattr on settings with a string name.
//   from django.conf import settings
//   settings.DEBUG = True                           reported
//   settings.CACHES["default"] = {...}              reported: mutates the setting's value
//   setattr(settings, "DEBUG", True)                reported
//   x = settings.DEBUG                              not reported: a read
//   def plugin_settings(settings): settings.X = 1   not reported: a parameter, not django.conf.settings
//   tests/test_views.py: settings.DEBUG = True      not reported: test code (pytest-django's fixture is fine there)

#include "lib/django.rerail"

.violation SettingsRuntimeAssignment(at: node, name: symbol) "This changes `settings.{name}` at runtime: code that already read it keeps the old value and no setting_changed signal is sent. Set it in the settings file instead; in tests use `override_settings` (or pytest-django's `settings` fixture). Leave it only where the project deliberately replaces django.conf.settings with a writable, database-backed settings object."
SettingsRuntimeAssignment(t, x) :- sra_setting(a, x), sra_write(t, a), docof(t, d), !dj_test_doc(d).
SettingsRuntimeAssignment(c, x) :- kind(c, "call"), field(c, "function", f),
    (sym_of(f, "builtins.setattr") ; sym_of(f, "builtins.delattr")), posarg(c, 0, s), dj_settings(s),
    posarg(c, 1, k), str(k, x), match("[A-Z][A-Z0-9_]*", x), docof(c, d), !dj_test_doc(d).

// sra_setting(a, x): a is `settings.X`, X upper-case, settings being django.conf.settings.
.decl sra_setting(a: node, x: symbol)
sra_setting(a, x) :- attr_of(a, o, x), match("[A-Z][A-Z0-9_]*", x), dj_settings(o).
// sra_item(t, a): t is a, or a subscript of it at any depth: `settings.CACHES["default"]["LOCATION"]`.
.decl sra_item(t: node, a: node)
sra_item(a, a) :- sra_setting(a, _).
sra_item(t, a) :- kind(t, "subscript"), field(t, "value", v), sra_item(v, a).
// sra_write(t, a): target t, written or deleted, is a or an item of it.
.decl sra_write(t: node, a: node)
sra_write(t, a) :- sra_item(t, a), (expr_ctx(t, "store") ; expr_ctx(t, "del")).

// The cases, `cases/django-practice-settings-runtime-assignment/`, read as one repository: each line ending in `#
// caught` is reported, and no other line.
.test cases exactly
    .fixture "conftest.py" from "../cases/django-practice-settings-runtime-assignment/conftest.py"
    .fixture "shop/alias.py" from "../cases/django-practice-settings-runtime-assignment/shop/alias.py"
    .fixture "shop/plugin.py" from "../cases/django-practice-settings-runtime-assignment/shop/plugin.py"
    .fixture "shop/tests/test_views.py" from "../cases/django-practice-settings-runtime-assignment/shop/tests/test_views.py"
    .fixture "shop/views.py" from "../cases/django-practice-settings-runtime-assignment/shop/views.py"
    .expect _ at "shop/alias.py":6
    .expect _ at "shop/alias.py":7
    .expect _ at "shop/views.py":6
    .expect _ at "shop/views.py":11
    .expect _ at "shop/views.py":15
    .expect _ at "shop/views.py":16
    .expect _ at "shop/views.py":20
    .expect _ at "shop/views.py":21
    .expect _ at "shop/views.py":25
    .expect _ at "shop/views.py":26
    .expect _ at "shop/views.py":47
.end
