.policy "django-practice-get-or-create-needs-unique" revision 1
.description "Give get_or_create() and update_or_create() a lookup the database keeps unique, or concurrent calls insert duplicate rows."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. get_or_create() and update_or_create() run a SELECT, then an INSERT when it found
// nothing; only a unique index stops two concurrent calls from both inserting. The rule reports a call on a model of
// the run, `M.objects.get_or_create(...)` (or through all(), using(), select_for_update(), or `cls.objects` in a
// classmethod of a concrete model), whose lookup (every keyword but `defaults` and `create_defaults`) holds no field
// the database keeps unique for M: no lookup is `pk` or `id`, or a field declared with unique=True or
// primary_key=True or as a OneToOneField, and no unique_together group or UniqueConstraint(fields=[...]) in M's Meta
// lies within the lookup (one with condition= is unknown: the row may meet it). Fields, Meta and bases resolve across
// the run's files (`x_id` is field x). M's Meta options are its own Meta's, a concrete base's (its table's constraints
// hold for M's rows too), and an abstract base's only when M declares no Meta or its Meta subclasses the base's
// (`class Meta(Base.Meta)`), as Django inherits them. A lookup it cannot read is unknown and not reported: `__` in a
// keyword, `**kwargs`, a positional Q, a field the run does not declare, a Meta with an expression UniqueConstraint
// or an option it cannot read, an unmanaged model (`managed = False`: its table and indexes are made outside
// Django), a manager of the model whose class, queryset class (`as_manager()`, `from_queryset()`) or the class its
// get_queryset() returns overrides the method in the run (it may look up a unique hash instead).
//   Author.objects.get_or_create(name=n)                     reported: name is not unique
//   Author.objects.get_or_create(email=e, defaults={...})    not reported: email = EmailField(unique=True)
//   Book.objects.get_or_create(author=a, title=t)            not reported: UniqueConstraint(fields=["author", "title"])
//   a.book_set.get_or_create(title=t)                        not reported: related managers are not followed

#include "lib/django.rerail"

.violation GetOrCreateNeedsUnique(at: node, m: symbol, model: symbol, keys: symbol) "{m}() on {model} looks up ({keys}), which no unique field or unique constraint covers, so concurrent calls can each insert a row and leave duplicates. Add a UniqueConstraint(fields=[{keys}]) (or unique=True) to {model}, or look up a field that is unique."
GetOrCreateNeedsUnique(c, m, x, ks) :- goc_call(c, m, r), !goc_unknown(c), !goc_unique(c, r), dj_model_named(r, mq),
    split_dot(mq, _, x), ks = join q by k sep ", " : { goc_key(c, k, _), q = cat("\"", k, "\"") }, ks != "",
    docof(c, d), !dj_test_doc(d).

// goc_call(c, m, r): c is `M.objects...m(...)`, m get_or_create or update_or_create, M a model class of the run that r,
// a node of c's file, names (python/django's dj_model_named: M's name, or M's class itself for `cls`). The model's
// fields, Meta and managers are read at r, by its symbol (0677 fix 3c).
.decl goc_method(m: symbol)
goc_method("get_or_create"). goc_method("update_or_create").
.decl goc_chain(m: symbol)
goc_chain("all"). goc_chain("using"). goc_chain("select_for_update").
.decl goc_root(q: node, r: node)
goc_root(q, o) :- dj_manager(q), attr_of(q, o, _).
goc_root(q, r) :- kind(q, "call"), field(q, "function", f), attr_of(f, o, m), goc_chain(m), goc_root(o, r).
.decl goc_call(c: node, m: symbol, r: node)
goc_call(c, m, r) :- goc_method(m), kind(c, "call"), field(c, "function", f), attr_of(f, o, m), goc_root(o, r),
    dj_model_named(r, _).
goc_call(c, m, mc) :- goc_method(m), kind(c, "call"), field(c, "function", f), attr_of(f, o, m), goc_root(o, r),
    kind(r, "identifier"), text(r, "cls"), dj_model_method(mc, fd, _), nearest(c, fd, fdef), !dj_model_abstract(mc).
// goc_mgr(q, mn): the queryset chain q starts at manager attribute mn (`objects`).
.decl goc_mgr(q: node, mn: symbol)
goc_mgr(q, mn) :- dj_manager(q), attr_of(q, _, mn).
goc_mgr(q, mn) :- kind(q, "call"), field(q, "function", f), attr_of(f, o, m), goc_chain(m), goc_mgr(o, mn).

// goc_key(c, k, f): lookup keyword k of call c names field f of its model (`x_id` names ForeignKey x).
.decl goc_kw(c: node, k: symbol)
goc_kw(c, k) :- goc_call(c, _, _), call_arg(c, -1, k, _), k != "defaults", k != "create_defaults".
.decl goc_key(c: node, k: symbol, f: symbol)
goc_key(c, k, k) :- goc_kw(c, k), goc_call(c, _, r), dj_model_field(r, k, _).
goc_key(c, k, x) :- goc_kw(c, k), goc_call(c, _, r), dj_model_field(r, x, t),
    (t = "ForeignKey" ; t = "OneToOneField"), k = cat(x, "_id").
// goc_unknown(c): the lookup holds something the rule cannot read.
.decl goc_unknown(c: node)
goc_unknown(c) :- goc_kw(c, k), !goc_key(c, k, _), k != "pk", k != "id".
goc_unknown(c) :- goc_call(c, _, _), posarg(c, _, _).
goc_unknown(c) :- goc_call(c, _, _), field(c, "arguments", al), child(al, s, _), kind(s, "dictionary_splat").
goc_unknown(c) :- goc_call(c, _, r), dj_model_opaque(r).
// A conditional UniqueConstraint within the lookup may hold for the row (`condition=~Q(engine="")` with `engine=x`).
goc_unknown(c) :- goc_call(c, _, r), dj_model_cond_group(r, g, _), !goc_missing(c, g).
// The manager is the model's own and its class (or queryset class, or the queryset class its get_queryset() builds)
// in the run defines the method: it may add a key.
goc_unknown(c) :- goc_call(c, m, r), field(c, "function", f), attr_of(f, o, m), goc_mgr(o, mn),
    dj_model_manager_method(r, mn, m).
// An unmanaged model's table (Meta.managed = False) is made outside Django, with indexes the model does not show.
goc_unknown(c) :- goc_call(c, _, r), dj_model_unmanaged(r).

// goc_unique(c, r): the database keeps some subset of c's lookup unique.
.decl goc_unique(c: node, r: node)
goc_unique(c, r) :- goc_call(c, _, r), (goc_kw(c, "pk") ; goc_kw(c, "id")).
goc_unique(c, r) :- goc_call(c, _, r), goc_key(c, _, x), dj_model_field(r, x, "OneToOneField").
goc_unique(c, r) :- goc_call(c, _, r), goc_key(c, _, x), dj_model_field_kw(r, x, o, v), (o = "unique" ; o = "primary_key"),
    v != "False".
goc_unique(c, r) :- goc_call(c, _, r), dj_model_group(r, g, _), !goc_missing(c, g).
// goc_missing(c, g): group g (python/django's dj_model_group, dj_model_cond_group: unique_together, a
// UniqueConstraint's fields=) of c's model names a field c does not look up.
.decl goc_missing(c: node, g: symbol)
goc_missing(c, g) :- goc_call(c, _, r), (dj_model_group(r, g, x) ; dj_model_cond_group(r, g, x)), !goc_covers(c, x).
// goc_covers(c, x): c looks up field x, named in Meta as itself or, for a relation, as its column `x_id`.
.decl goc_covers(c: node, x: symbol)
goc_covers(c, x) :- goc_key(c, _, x).
goc_covers(c, y) :- goc_key(c, _, x), y = cat(x, "_id").

// The cases, `cases/django-practice-get-or-create-needs-unique/`, read as one repository: each line ending in `#
// caught` is reported, and no other line.
.test cases exactly
    .fixture "shop/base.py" from "../cases/django-practice-get-or-create-needs-unique/shop/base.py"
    .fixture "shop/models.py" from "../cases/django-practice-get-or-create-needs-unique/shop/models.py"
    .fixture "shop/tests/test_views.py" from "../cases/django-practice-get-or-create-needs-unique/shop/tests/test_views.py"
    .fixture "shop/views.py" from "../cases/django-practice-get-or-create-needs-unique/shop/views.py"
    .expect _ at "shop/models.py":94
    .expect _ at "shop/models.py":137
    .expect _ at "shop/views.py":9
    .expect _ at "shop/views.py":10
    .expect _ at "shop/views.py":11
    .expect _ at "shop/views.py":12
    .expect _ at "shop/views.py":13
    .expect _ at "shop/views.py":14
    .expect _ at "shop/views.py":15
    .expect _ at "shop/views.py":19
    .expect _ at "shop/views.py":20
    .expect _ at "shop/views.py":48
    .expect _ at "shop/views.py":51
    .expect _ at "shop/views.py":53
    .expect _ at "shop/views.py":54
.end
