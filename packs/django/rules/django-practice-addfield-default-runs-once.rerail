    .expect _ at "shop/migrations/0009_coupons.py":16
    .expect _ at "shop/migrations/0011_order_sql_backfill.py":20
    .expect _ at "shop/migrations/0012_more_generators.py":17
    .expect _ at "shop/migrations/0012_more_generators.py":23
    .expect _ at "shop/migrations/0012_more_generators.py":28
    .expect _ at "shop/migrations/0013_generator_variants.py":20
    .expect _ at "shop/migrations/0013_generator_variants.py":25
    .expect _ at "shop/migrations/0013_generator_variants.py":30
    .expect _ at "shop/migrations/0013_generator_variants.py":63
    .expect _ at "billing/migrations/0002_invoice_secret.py":13
    .expect _ at "shop/migrations/0015_per_site_settings.py":21
.end
