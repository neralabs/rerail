.policy "django-practice-task-arg-model-instance" revision 1
.description "Pass a model's primary key to a Celery task and re-fetch the row in the task, never the model instance itself."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. A model instance passed to a task is serialized into the message: the JSON
// serializer (Celery's default) cannot encode it and the call raises EncodeError; pickle ships a snapshot that is
// stale by the time a worker runs, and saving it there overwrites newer changes. The task is a def decorated
// `@shared_task`, `@app.task`, `@celery_app.task(...)` or any decorator named `task`, found through imports in
// another file; the call is `t.delay(x)`, `t.apply_async((x,))`, `t.apply_async(args=[x], kwargs={"k": x})`,
// `t.s(x)` or `t.si(x)`. x is a model instance when it is `self` in a model's method, `request.user`, a model
// constructor `M(...)`, `M.objects.get/create/first/...(...)` (not after values()/values_list()),
// `get_object_or_404(M, ...)`, a parameter annotated with a model class, or a name the same function assigns from one
// of those or loops over a queryset with, or a value the type program proves is a model instance (python/types'
// proven_type: `x = make_order()` where make_order returns `Order(...)`).
//   order = Order.objects.get(pk=pk); ship_order.delay(order)           reported
//   ship_order.delay(request.user)                                      reported
//   ship_order.delay(order.pk)                                          not reported
//   send_report.delay(order)   # send_report is a plain function        not reported

#include "lib/django.rerail"
#include "python/types.rerail"

.violation TaskArgModelInstance(at: node, task: symbol, arg: symbol) "`{arg}` is a model instance passed to the Celery task `{task}`: the JSON serializer cannot encode it (EncodeError), and with pickle the worker gets a snapshot that may be stale by the time it runs, so saving it overwrites newer changes. Pass `{arg}.pk` and re-fetch the row in the task."
TaskArgModelInstance(a, t, x) :- tam_task_call(c, t), tam_arg(c, a), tam_instance(a), text(a, x), docof(c, d),
    !dj_test_doc(d).

// tam_task_call(c, t): call c sends task t: `t.delay(...)`, `t.apply_async(...)`, `t.s(...)`, `t.si(...)`.
.decl tam_send(m: symbol)
tam_send("delay"). tam_send("apply_async"). tam_send("s"). tam_send("si").
.decl tam_task_call(c: node, t: symbol)
tam_task_call(c, x) :- kind(c, "call"), field(c, "function", fn), attr_of(fn, o, m), tam_send(m), sym_of(o, q),
    qualname(f, q), tam_task_def(f), def_name(f, x).
// tam_task_def(f): def f is decorated as a task: `@shared_task`, `@app.task(...)`, `@task`.
.decl tam_task_def(f: node)
tam_task_def(f) :- kind(f, "function_definition"), decorator(f, e), unparen(e, m), tam_task_decorator(m).
.decl tam_task_decorator(e: node)
tam_task_decorator(e) :- attr_of(e, _, "task").
tam_task_decorator(e) :- sym_of(e, q), (split_dot(q, _, "task") ; split_dot(q, _, "shared_task")).
tam_task_decorator(e) :- kind(e, "call"), field(e, "function", f), tam_task_decorator(f).

// tam_arg(c, a): a is an argument the task receives: delay's and s's arguments, apply_async's args/kwargs items.
.decl tam_arg(c: node, a: node)
tam_arg(c, a) :- field(c, "function", fn), attr_of(fn, _, m), m != "apply_async", call_arg(c, _, _, a).
tam_arg(c, a) :- field(c, "function", fn), attr_of(fn, _, "apply_async"), (posarg(c, 0, l) ; call_arg(c, -1, "args", l)),
    unparen(l, s), (kind(s, "list") ; kind(s, "tuple")), child(s, a, _).
tam_arg(c, a) :- field(c, "function", fn), attr_of(fn, _, "apply_async"), (posarg(c, 1, m) ; call_arg(c, -1, "kwargs", m)),
    kind(m, "dictionary"), child(m, p, _), kind(p, "pair"), field(p, "value", a).

// tam_instance(a): expression a holds a model instance.
.decl tam_instance(a: node)
tam_instance(a) :- unparen(a, e), tam_instance_value(e).
tam_instance(a) :- unparen(a, e), kind(e, "identifier"), text(e, "self"), look(e, "self", f), dj_model_method(_, f, _),
    param(f, "self", 0).
tam_instance(a) :- unparen(a, e), kind(e, "identifier"), text(e, x), look(e, x, f), asg(f, x, v, _), unparen(v, w),
    tam_instance_value(w).
// A value the type program proves is a model instance: `made = make_order()`, `make_order()` itself.
tam_instance(a) :- unparen(a, e), proven_type(e, t), class_def(k, t), dj_model(k).
// A parameter annotated with a model class: `def notify(order: Order)`.
tam_instance(a) :- unparen(a, e), kind(e, "identifier"), text(e, x), look(e, x, f), sig_param(f, _, nm, _, _, t, _),
    text(nm, x), (m = t ; child(t, m, 0)), sym_of(m, q), class_def(k, q), dj_model(k).
tam_instance(a) :- unparen(a, e), kind(e, "identifier"), text(e, x), look(e, x, s), kind(l, "for_statement"),
    nearest(l, s, scope), field(l, "left", t), kind(t, "identifier"), text(t, x), field(l, "right", r), unparen(r, q),
    dj_qs(q), !tam_rows(q), field(l, "body", b), within(e, b).
// tam_instance_value(v): v makes or fetches one model instance (lib/django's dj_row_method).
.decl tam_instance_value(v: node)
tam_instance_value(v) :- dj_qs_call(v, m), dj_row_method(m), field(v, "function", f), attr_of(f, o, _), !tam_rows(o).
// tam_rows(q): queryset q went through values()/values_list(), so its get() returns a dict or a tuple, not a model.
.decl tam_rows(q: node)
tam_rows(q) :- dj_qs_has(q, m), (m = "values" ; m = "values_list").
tam_instance_value(v) :- kind(v, "call"), field(v, "function", f), sym_of(f, q), class_def(k, q), dj_model(k).
tam_instance_value(v) :- kind(v, "call"), field(v, "function", f), sym_of(f, "django.shortcuts.get_object_or_404").
tam_instance_value(v) :- attr_of(v, o, "user"), unparen(o, r), (text(r, "request") ; attr_of(r, _, "request")).

// The cases, `cases/django-practice-task-arg-model-instance/`, read as one repository: each line ending in `# caught`
// is reported, and no other line.
.test cases exactly
    .fixture "proj/celery.py" from "../cases/django-practice-task-arg-model-instance/proj/celery.py"
    .fixture "shop/models.py" from "../cases/django-practice-task-arg-model-instance/shop/models.py"
    .fixture "shop/services.py" from "../cases/django-practice-task-arg-model-instance/shop/services.py"
    .fixture "shop/tasks.py" from "../cases/django-practice-task-arg-model-instance/shop/tasks.py"
    .fixture "shop/tests/test_tasks.py" from "../cases/django-practice-task-arg-model-instance/shop/tests/test_tasks.py"
    .fixture "shop/views.py" from "../cases/django-practice-task-arg-model-instance/shop/views.py"
    .expect _ at "shop/models.py":11
    .expect _ at "shop/services.py":19
    .expect _ at "shop/services.py":20
    .expect _ at "shop/services.py":21
    .expect _ at "shop/services.py":26
    .expect _ at "shop/views.py":11
    .expect _ at "shop/views.py":13
    .expect _ at "shop/views.py":14
    .expect _ at "shop/views.py":15
    .expect _ at "shop/views.py":16
    .expect _ at "shop/views.py":18
    .expect _ at "shop/views.py":19
    .expect _ at "shop/views.py":20
    .expect _ at "shop/views.py":24
    .expect _ at "shop/views.py":25
    .expect _ at "shop/views.py":27
    .expect _ at "shop/views.py":31
    .expect _ at "shop/views.py":49
.end
