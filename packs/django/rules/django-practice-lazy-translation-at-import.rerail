.policy "django-practice-lazy-translation-at-import" revision 1
.description "Use gettext_lazy, not gettext, for text translated when the module is imported: class bodies, field options, module constants and default arguments."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. It matches a call of Django's non-lazy gettext, ngettext, pgettext, npgettext or
// their old u-names (django.utils.translation, through imports and aliases such as `gettext as _`) that runs when
// the module is imported: in a module or class body (field verbose_name/help_text/choices, Meta, form labels,
// class attributes), in a decorator, or in a default argument of a def that is itself defined at import. Such a call
// translates once, into the language active then, and every later request sees that one translation. A module-level
// alias (`_ = gettext`) is followed within its file.
// Where the result is turned into a str right away (`%`, `+`, `.format()` or another method call on it, an f-string,
// `str()`, `json.dumps()`, a dict key), a lazy string would be forced there too, so the message says to build the
// text where it is used, or with `format_lazy()`, instead of naming the lazy form.
// It leaves alone calls inside a def or lambda body (they run per request), a call that is a statement of its own
// (`_("Scrum")`: its result is discarded, a marker for makemessages), the lazy forms, gettext_noop, and test and
// migration files.
//   from django.utils.translation import gettext as _
//   class Book(models.Model):
//       title = models.CharField(_("title"), max_length=80)    reported
//   STATUS = [("draft", _("Draft"))]                             reported
//   def label(self): return _("Book")                           not reported: runs per call
//   title = models.CharField(gettext_lazy("title"))             not reported: lazy
//   HEADING = _("Hello %s") % name                              reported: build it per use, or format_lazy()

#include "lib/django.rerail"

.violation TranslatedAtImport(at: node, fn: symbol, advice: symbol) "`{fn}()` runs here when the module is imported, so it translates once into the language active then and every user sees that text, whatever their language. {advice}"
TranslatedAtImport(c, x, a) :- lti_eager_call(c, x), lti_at_import(c), !lti_discarded(c), docof(c, d), !dj_test_doc(d),
    !dj_migration_doc(d), lti_advice(c, a).
// lti_eager_call(c, x): c calls Django's non-lazy x, through imports or a module-level alias in its file.
.decl lti_eager_call(c: node, x: symbol)
lti_eager_call(c, x) :- kind(c, "call"), field(c, "function", e), sym_of(e, q), split_dot(q, "django.utils.translation", x),
    lti_eager(x).
lti_eager_call(c, x) :- kind(c, "call"), field(c, "function", e), kind(e, "identifier"), text(e, y), docof(c, d),
    lti_alias(d, y, x).
// lti_alias(d, y, x): document d's module body assigns `y = <x>`, x one of the non-lazy functions.
.decl lti_alias(d: number, y: symbol, x: symbol)
lti_alias(d, y, x) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, y), field(a, "right", r),
    sym_of(r, q), split_dot(q, "django.utils.translation", x), lti_eager(x), nearest(a, m, scope), kind(m, "module"),
    docof(a, d).
.decl lti_advice(c: node, a: symbol)
lti_advice(c, "A lazy string would be turned into text right here too (by this formatting, method call, f-string, str(), json.dumps() or dict key), so build this text inside the function that uses it, or format it with `django.utils.text.format_lazy()`.") :-
    lti_forced(c).
lti_advice(c, "Use the lazy form (`gettext_lazy`, `ngettext_lazy`, `pgettext_lazy`) for text in class bodies, field options, module constants and default arguments; keep `gettext` for code that runs per request.") :-
    lti_eager_call(c, _), !lti_forced(c).
// lti_forced(c): the result of call c (parentheses aside) becomes a str at once: an operand of `%` or `+`, the object
// of a method call, an f-string interpolation, a dict key, or inside the arguments of str() or json.dumps().
.decl lti_forced(c: node)
lti_forced(c) :- lti_eager_call(c, _), lti_up(c, p), kind(b, "binary_operator"), (field(b, "left", p) ; field(b, "right", p)),
    (op(b, "%") ; op(b, "+")).
lti_forced(c) :- lti_eager_call(c, _), lti_up(c, p), attr_of(e, p, _), kind(k, "call"), field(k, "function", e).
lti_forced(c) :- lti_eager_call(c, _), lti_up(c, p), kind(i, "interpolation"), child(i, p, _).
lti_forced(c) :- lti_eager_call(c, _), lti_up(c, p), kind(pr, "pair"), field(pr, "key", p).
lti_forced(c) :- lti_eager_call(c, _), kind(k, "call"), field(k, "function", e), sym_of(e, q), lti_coerce(q),
    field(k, "arguments", al), within(c, al).
.decl lti_coerce(q: symbol)
lti_coerce("builtins.str"). lti_coerce("json.dumps"). lti_coerce("json.dump").
// lti_up(c, p): p is call c, or a parenthesized expression around it.
.decl lti_up(c: node, p: node)
lti_up(c, c) :- lti_eager_call(c, _).
lti_up(c, p) :- lti_up(c, i), kind(p, "parenthesized_expression"), child(p, i, _).

// lti_discarded(c): call c is an expression statement, so nothing reads its translation.
.decl lti_discarded(c: node)
lti_discarded(c) :- kind(s, "expression_statement"), child(s, c, 0), kind(c, "call").

.decl lti_eager(x: symbol)
lti_eager("gettext"). lti_eager("ngettext"). lti_eager("pgettext"). lti_eager("npgettext"). lti_eager("ugettext").
lti_eager("ungettext").
// lti_frame: code under a def or lambda runs when it is called, except a def's parameter defaults (lti_at_import).
.decl lti_frame(k: symbol)
lti_frame("function_definition"). lti_frame("lambda").
.decl lti_framed(n: node)
lti_framed(n) :- nearest(n, _, lti_frame).
// lti_at_import(n): n runs at import: no def or lambda holds it, or it is a default of a def that runs at import.
.decl lti_at_import(n: node)
lti_at_import(n) :- kind(n, "call"), !lti_framed(n).
lti_at_import(n) :- kind(n, "call"), nearest(n, f, lti_frame), kind(f, "function_definition"), field(f, "parameters", ps),
    within(n, ps), !lti_framed(f).

// The cases, `cases/django-practice-lazy-translation-at-import/`, read as one repository: each line ending in `#
// caught` is reported, and no other line.
.test cases exactly
    .fixture "library/apps.py" from "../cases/django-practice-lazy-translation-at-import/library/apps.py"
    .fixture "library/constants.py" from "../cases/django-practice-lazy-translation-at-import/library/constants.py"
    .fixture "library/forms.py" from "../cases/django-practice-lazy-translation-at-import/library/forms.py"
    .fixture "library/migrations/0001_initial.py" from "../cases/django-practice-lazy-translation-at-import/library/migrations/0001_initial.py"
    .fixture "library/models.py" from "../cases/django-practice-lazy-translation-at-import/library/models.py"
    .fixture "library/tests/test_models.py" from "../cases/django-practice-lazy-translation-at-import/library/tests/test_models.py"
    .expect _ at "library/apps.py":7
    .expect _ at "library/constants.py":8
    .expect _ at "library/constants.py":9
    .expect _ at "library/constants.py":10
    .expect _ at "library/constants.py":11
    .expect _ at "library/constants.py":12
    .expect _ at "library/constants.py":13
    .expect _ at "library/constants.py":14
    .expect _ at "library/constants.py":15
    .expect _ at "library/constants.py":16
    .expect _ at "library/constants.py":23
    .expect _ at "library/forms.py":8
    .expect _ at "library/forms.py":13
    .expect _ at "library/models.py":9
    .expect _ at "library/models.py":13
    .expect _ at "library/models.py":17
    .expect _ at "library/models.py":18
    .expect _ at "library/models.py":22
    .expect _ at "library/models.py":33
    .expect _ at "library/models.py":36
    .expect _ at "library/models.py":41
.end
