.policy "django-practice-enqueue-on-commit" revision 1
.description "Enqueue background tasks and send mail from transaction.on_commit, not inside transaction.atomic, so they run only after the data they depend on is committed."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. A task enqueued inside a transaction can start on a worker before the transaction
// commits, and then reads rows that are not there yet (or that roll back); a mail sent inside it goes out even when
// the transaction rolls back. The call sits in a `with transaction.atomic():` body (or a with-block of an
// `…atomic…()` wrapper) or an `@transaction.atomic` function: a Celery `.delay()`, `.apply_async()`,
// `app.send_task()`, a Django 6 task `.enqueue()`/`.aenqueue()`, django-q `async_task()`, or django.core.mail's
// `send_mail`, `send_mass_mail`, `mail_admins`, `mail_managers` and an EmailMessage's `.send()`.
//   with transaction.atomic():
//       order.save()
//       notify_order.delay(order.pk)                                  reported
//       transaction.on_commit(notify_order.delay(order.pk))           reported: delay() runs now, its result is passed
//       transaction.on_commit(partial(notify_order.delay, order.pk))  not reported
//       transaction.on_commit(lambda: notify_order.delay(order.pk))   not reported: a lambda runs later
//       notify_order.delay_on_commit(order.pk)                        not reported
//   notify_order.delay(order.pk)                                      not reported: outside the atomic block
// A task whose `@app.task(base=X)` class X (or a base of X) overrides apply_async or delay with a transaction.on_commit
// call already waits for the commit (pretix's TransactionAwareTask), and so does every task of a run whose Celery app
// is built with `Celery(..., task_cls=X)` for such an X (addons-server's AMOTask): their calls are left alone.
// Also left alone: calls in an except handler that always re-raises (the block rolls back, so on_commit would drop
// them), `r = task.apply_async(...)` whose result the function reads afterwards, and `.delay()` on a parameter or local
// (`client.delay(2.0)`), which is not known to be a task.
// Gaps: ATOMIC_REQUESTS and a caller's atomic; signal receivers run by save(); tasks enqueued in helpers; a task kept
// in a local before `.delay()`; `task_cls` given as a string.

#include "lib/django.rerail"

.violation EnqueueInAtomic(at: node, what: symbol) "`{what}` runs inside transaction.atomic: a worker can pick the task up (or the mail goes out) before the transaction commits, so it may read rows that are not committed yet or act on changes that roll back. Run it after commit: `transaction.on_commit(partial(...))`, or Celery's `.delay_on_commit()`."
// What a dispatch is, and which ones stay (a task class that waits for the commit, a call in a handler that always
// re-raises, a result the function reads), is lib/django's side-effect vocabulary, shared with
// django-practice-dispatch-in-atomic-request; the region is dj_in_transaction (atomic, or an `…atomic…()` wrapper),
// which leaves out code in a lambda or def, such as an on_commit callback.
EnqueueInAtomic(c, w) :- dj_side_effect(c, w), dj_in_transaction(c), !dj_task_waits_for_commit(c),
    !dj_dispatch_in_failing_handler(c), !dj_dispatch_result_used(c), docof(c, d), !dj_test_doc(d).

// The cases, `cases/django-practice-enqueue-on-commit/`, read as one repository: each line ending in `# caught` is
// reported, and no other line.
.test cases exactly
    .fixture "shop/__init__.py" from "../cases/django-practice-enqueue-on-commit/shop/__init__.py"
    .fixture "shop/base.py" from "../cases/django-practice-enqueue-on-commit/shop/base.py"
    .fixture "shop/graphql/__init__.py" from "../cases/django-practice-enqueue-on-commit/shop/graphql/__init__.py"
    .fixture "shop/graphql/order/__init__.py" from "../cases/django-practice-enqueue-on-commit/shop/graphql/order/__init__.py"
    .fixture "shop/graphql/order/mutations/__init__.py" from "../cases/django-practice-enqueue-on-commit/shop/graphql/order/mutations/__init__.py"
    .fixture "shop/graphql/order/mutations/delete.py" from "../cases/django-practice-enqueue-on-commit/shop/graphql/order/mutations/delete.py"
    .fixture "shop/orders.py" from "../cases/django-practice-enqueue-on-commit/shop/orders.py"
    .fixture "shop/tasks.py" from "../cases/django-practice-enqueue-on-commit/shop/tasks.py"
    .fixture "shop/tests/test_orders.py" from "../cases/django-practice-enqueue-on-commit/shop/tests/test_orders.py"
    .fixture "src/billing/__init__.py" from "../cases/django-practice-enqueue-on-commit/src/billing/__init__.py"
    .fixture "src/billing/base.py" from "../cases/django-practice-enqueue-on-commit/src/billing/base.py"
    .fixture "src/billing/tasks.py" from "../cases/django-practice-enqueue-on-commit/src/billing/tasks.py"
    .fixture "src/billing/views.py" from "../cases/django-practice-enqueue-on-commit/src/billing/views.py"
    .expect _ at "shop/graphql/order/mutations/delete.py":11
    .expect _ at "shop/graphql/order/mutations/delete.py":12
    .expect _ at "shop/orders.py":18
    .expect _ at "shop/orders.py":19
    .expect _ at "shop/orders.py":20
    .expect _ at "shop/orders.py":21
    .expect _ at "shop/orders.py":22
    .expect _ at "shop/orders.py":23
    .expect _ at "shop/orders.py":24
    .expect _ at "shop/orders.py":25
    .expect _ at "shop/orders.py":27
    .expect _ at "shop/orders.py":34
    .expect _ at "shop/orders.py":39
    .expect _ at "shop/orders.py":45
    .expect _ at "shop/orders.py":92
    .expect _ at "shop/orders.py":110
    .expect _ at "shop/orders.py":119
    .expect _ at "shop/orders.py":133
    .expect _ at "src/billing/views.py":11
.end
