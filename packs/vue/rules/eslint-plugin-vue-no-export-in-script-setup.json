{
  "format": "rerail.policy/v1",
  "id": "eslint-plugin-vue-no-export-in-script-setup",
  "revision": 1,
  "mode": "steer",
  "description": "Don't export values from a Vue script setup block (type exports are fine); put shared exports in a separate regular script block.",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "vue",
        "utils": {
          "forbidden-export": {
            "all": [
              {
                "kind": "export_statement"
              },
              {
                "follows": {
                  "stopBy": {
                    "kind": "empty_statement",
                    "host": {
                      "kind": "start_tag",
                      "regex": "^<script\\b"
                    }
                  },
                  "kind": "empty_statement",
                  "host": {
                    "kind": "start_tag",
                    "regex": "^<script(?:\\s+[^\\s\"'<>/=]+(?:\\s*=\\s*(?:\"[^\"]*\"|'[^']*'|[^\\s\"'<>=`]+))?)*\\s+setup(?:[\\s/>=]|$)"
                  }
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "has": {
                        "regex": "^type$",
                        "not": {
                          "any": [
                            {
                              "kind": "identifier"
                            },
                            {
                              "kind": "string"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "declaration",
                        "any": [
                          {
                            "kind": "type_alias_declaration"
                          },
                          {
                            "kind": "interface_declaration"
                          },
                          {
                            "kind": "ambient_declaration",
                            "has": {
                              "any": [
                                {
                                  "kind": "type_alias_declaration"
                                },
                                {
                                  "kind": "interface_declaration"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "has": {
                        "kind": "export_clause",
                        "all": [
                          {
                            "has": {
                              "kind": "export_specifier"
                            }
                          },
                          {
                            "not": {
                              "has": {
                                "kind": "export_specifier",
                                "not": {
                                  "has": {
                                    "regex": "^type$",
                                    "not": {
                                      "any": [
                                        {
                                          "kind": "identifier"
                                        },
                                        {
                                          "kind": "string"
                                        }
                                      ]
                                    }
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          },
          "declaration-export": {
            "has": {
              "field": "declaration",
              "regex": "\\S"
            },
            "not": {
              "has": {
                "regex": "^default$",
                "not": {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "string"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "export-declaration-in-script-setup",
      "forbid": {
        "ast": {
          "language": "vue",
          "embedded": "script-block",
          "rule": {
            "regex": "^(?P<KW>export)",
            "all": [
              {
                "matches": "forbidden-export"
              },
              {
                "matches": "declaration-export"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "vue/no-export-in-script-setup",
        "anchor": "capture.KW",
        "message": "Move this export into a separate regular `<script>` block; `<script setup>` cannot export values.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-export-in-script-setup"
            ]
          }
        }
      }
    },
    {
      "id": "export-in-script-setup",
      "forbid": {
        "ast": {
          "language": "vue",
          "embedded": "script-block",
          "rule": {
            "all": [
              {
                "matches": "forbidden-export"
              },
              {
                "not": {
                  "matches": "declaration-export"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "code": "vue/no-export-in-script-setup",
        "anchor": "witness.span",
        "message": "Move this export into a separate regular `<script>` block; `<script setup>` cannot export values.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-export-in-script-setup"
            ]
          }
        }
      }
    }
  ]
}
