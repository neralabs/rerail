{
  "format": "rerail.policy/v1",
  "id": "eslint-plugin-vue:no-ref-as-operand",
  "revision": 1,
  "mode": "steer",
  "description": "Ports eslint-plugin-vue 10.11.1 `vue/no-ref-as-operand` (default options): an identifier that holds a value wrapped by `ref`/`computed`/`toRef`/`customRef`/`shallowRef`/`toRefs` imported from `vue`, `@vue/composition-api`, `@nuxtjs/composition-api` or `#imports` (or by the `defineModel` macro, or an alias or `toRefs` destructuring of one), used as an operand: `if`/`switch` test, unary, update, binary, assignment (not the right of `=`), conditional test, template literal (untagged), left of a `const` logical operator, or member object (not `.value`/`.effect`), plus ref arguments of an emit call (`defineEmits` result, `setup(props, { emit })`, `ctx.emit`) whose first argument is a string. Reads the script program only (template expressions are not visited by upstream), import resolution and variable bindings. Reported at the identifier.",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "vue",
        "utils": {
          "in-script-setup": {
            "inside": {
              "stopBy": "end",
              "follows": {
                "stopBy": {
                  "kind": "empty_statement",
                  "regex": "^<script\\b"
                },
                "kind": "empty_statement",
                "regex": "^<script\\b[^>]*\\bsetup\\b"
              }
            }
          },
          "component-callee": {
            "any": [
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "regex": "^(?:component|mixin)$"
                    }
                  }
                ]
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "regex": "^Vue$"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "regex": "^extend$"
                    }
                  }
                ]
              },
              {
                "kind": "identifier",
                "regex": "^defineNuxtComponent$"
              },
              {
                "kind": "identifier",
                "regex": "^(?:component|createApp|defineComponent)$",
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "import_specifier",
                      "inside": {
                        "stopBy": "end",
                        "kind": "import_statement",
                        "has": {
                          "field": "source",
                          "kind": "string",
                          "value": {
                            "regex": "^(?:vue|@vue/composition-api|@nuxtjs/composition-api|#imports)$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "vue-object": {
            "kind": "object",
            "any": [
              {
                "all": [
                  {
                    "inside": {
                      "field": "value",
                      "stopBy": {
                        "not": {
                          "any": [
                            {
                              "kind": "parenthesized_expression"
                            },
                            {
                              "kind": "as_expression"
                            },
                            {
                              "kind": "satisfies_expression"
                            }
                          ]
                        }
                      },
                      "kind": "export_statement"
                    }
                  },
                  {
                    "not": {
                      "matches": "in-script-setup"
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "nthChild": {
                      "position": 1,
                      "reverse": true
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "arguments",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "matches": "component-callee"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "nthChild": 1
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "arguments",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "new_expression",
                        "has": {
                          "field": "constructor",
                          "kind": "identifier",
                          "regex": "^Vue$"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "setup-fn": {
            "any": [
              {
                "kind": "method_definition",
                "has": {
                  "field": "name",
                  "regex": "^(?:setup|'setup'|\"setup\")$"
                },
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "object",
                  "matches": "vue-object"
                }
              },
              {
                "any": [
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "arrow_function"
                  }
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "field": "value",
                  "kind": "pair",
                  "has": {
                    "field": "key",
                    "regex": "^(?:setup|'setup'|\"setup\")$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "object",
                    "matches": "vue-object"
                  }
                }
              }
            ]
          },
          "ref-callee": {
            "any": [
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "import_specifier",
                      "has": {
                        "field": "name",
                        "regex": "^(?:ref|computed|toRef|customRef|shallowRef|toRefs)$",
                        "pattern": "$M"
                      },
                      "inside": {
                        "stopBy": "end",
                        "kind": "import_statement",
                        "has": {
                          "field": "source",
                          "kind": "string",
                          "value": {
                            "regex": "^(?:vue|@vue/composition-api|@nuxtjs/composition-api|#imports)$"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "property",
                      "regex": "^(?:ref|computed|toRef|customRef|shallowRef|toRefs)$",
                      "pattern": "$M"
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "resolves": {
                        "binding": {
                          "site": {
                            "kind": "namespace_import",
                            "inside": {
                              "stopBy": "end",
                              "kind": "import_statement",
                              "has": {
                                "field": "source",
                                "kind": "string",
                                "value": {
                                  "regex": "^(?:vue|@vue/composition-api|@nuxtjs/composition-api|#imports)$"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "torefs-callee": {
            "any": [
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "import_specifier",
                      "has": {
                        "field": "name",
                        "regex": "^toRefs$",
                        "pattern": "$M"
                      },
                      "inside": {
                        "stopBy": "end",
                        "kind": "import_statement",
                        "has": {
                          "field": "source",
                          "kind": "string",
                          "value": {
                            "regex": "^(?:vue|@vue/composition-api|@nuxtjs/composition-api|#imports)$"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "property",
                      "regex": "^toRefs$",
                      "pattern": "$M"
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "resolves": {
                        "binding": {
                          "site": {
                            "kind": "namespace_import",
                            "inside": {
                              "stopBy": "end",
                              "kind": "import_statement",
                              "has": {
                                "field": "source",
                                "kind": "string",
                                "value": {
                                  "regex": "^(?:vue|@vue/composition-api|@nuxtjs/composition-api|#imports)$"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "model-callee": {
            "kind": "identifier",
            "regex": "^defineModel$",
            "pattern": "$M",
            "resolves": {
              "unresolved": true
            }
          },
          "ref-value": {
            "any": [
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "ref-callee"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "model-callee"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "ref-value"
                }
              },
              {
                "kind": "identifier",
                "pattern": "$A",
                "matches": {
                  "ref-var": {
                    "X": "$A",
                    "M": "$M"
                  }
                }
              }
            ]
          },
          "ref-var": {
            "params": [
              "X",
              "M"
            ],
            "rule": {
              "kind": "identifier",
              "pattern": "$X",
              "any": [
                {
                  "matches": {
                    "ref-declared": {
                      "X": "$X",
                      "M": "$M"
                    }
                  }
                },
                {
                  "resolves": {
                    "binding": {
                      "occurrence": {
                        "kind": "identifier",
                        "inside": {
                          "stopBy": "neighbor",
                          "field": "left",
                          "kind": "assignment_expression",
                          "has": {
                            "field": "right",
                            "matches": "ref-value"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "ref-declared": {
            "params": [
              "X",
              "M"
            ],
            "rule": {
              "kind": "identifier",
              "pattern": "$X",
              "resolves": {
                "binding": {
                  "site": {
                    "kind": "variable_declarator",
                    "any": [
                      {
                        "all": [
                          {
                            "has": {
                              "field": "name",
                              "kind": "identifier"
                            }
                          },
                          {
                            "has": {
                              "field": "value",
                              "matches": "ref-value"
                            }
                          }
                        ]
                      },
                      {
                        "all": [
                          {
                            "has": {
                              "field": "name",
                              "kind": "array_pattern",
                              "has": {
                                "kind": "identifier",
                                "pattern": "$E",
                                "compare": {
                                  "left": "E",
                                  "op": "eq",
                                  "right": "X"
                                },
                                "follows": {
                                  "stopBy": "neighbor",
                                  "regex": "^\\[$"
                                }
                              }
                            }
                          },
                          {
                            "has": {
                              "field": "value",
                              "kind": "call_expression",
                              "has": {
                                "field": "function",
                                "matches": "model-callee"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "all": [
                          {
                            "has": {
                              "field": "name",
                              "kind": "object_pattern",
                              "has": {
                                "any": [
                                  {
                                    "kind": "shorthand_property_identifier_pattern",
                                    "pattern": "$E",
                                    "compare": {
                                      "left": "E",
                                      "op": "eq",
                                      "right": "X"
                                    }
                                  },
                                  {
                                    "kind": "pair_pattern",
                                    "has": {
                                      "field": "value",
                                      "kind": "identifier",
                                      "pattern": "$E",
                                      "compare": {
                                        "left": "E",
                                        "op": "eq",
                                        "right": "X"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          },
                          {
                            "has": {
                              "field": "value",
                              "kind": "call_expression",
                              "has": {
                                "field": "function",
                                "matches": "torefs-callee"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "setup-param2": {
            "any": [
              {
                "nthChild": 2,
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "formal_parameters",
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "setup-fn"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": {
                    "kind": "formal_parameters"
                  },
                  "nthChild": 2,
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "formal_parameters",
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "setup-fn"
                    }
                  }
                }
              }
            ]
          },
          "emits-fn": {
            "kind": "identifier",
            "pattern": "$C",
            "resolves": {
              "binding": {
                "site": {
                  "kind": "variable_declarator",
                  "all": [
                    {
                      "has": {
                        "field": "name",
                        "kind": "identifier"
                      }
                    },
                    {
                      "has": {
                        "field": "value",
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "kind": "identifier",
                          "regex": "^defineEmits$"
                        }
                      }
                    },
                    {
                      "matches": "in-script-setup"
                    }
                  ]
                }
              }
            }
          },
          "emit-param": {
            "kind": "identifier",
            "pattern": "$C",
            "resolves": {
              "binding": {
                "site": {
                  "matches": "setup-param2",
                  "any": [
                    {
                      "kind": "object_pattern",
                      "has": {
                        "any": [
                          {
                            "kind": "shorthand_property_identifier_pattern",
                            "regex": "^emit$",
                            "pattern": "$E",
                            "compare": {
                              "left": "E",
                              "op": "eq",
                              "right": "C"
                            }
                          },
                          {
                            "kind": "pair_pattern",
                            "all": [
                              {
                                "has": {
                                  "field": "key",
                                  "regex": "^(?:emit|'emit'|\"emit\")$"
                                }
                              },
                              {
                                "has": {
                                  "field": "value",
                                  "kind": "identifier",
                                  "pattern": "$E",
                                  "compare": {
                                    "left": "E",
                                    "op": "eq",
                                    "right": "C"
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "has": {
                        "stopBy": "end",
                        "kind": "object_pattern",
                        "has": {
                          "any": [
                            {
                              "kind": "shorthand_property_identifier_pattern",
                              "regex": "^emit$",
                              "pattern": "$E",
                              "compare": {
                                "left": "E",
                                "op": "eq",
                                "right": "C"
                              }
                            },
                            {
                              "kind": "pair_pattern",
                              "all": [
                                {
                                  "has": {
                                    "field": "key",
                                    "regex": "^(?:emit|'emit'|\"emit\")$"
                                  }
                                },
                                {
                                  "has": {
                                    "field": "value",
                                    "kind": "identifier",
                                    "pattern": "$E",
                                    "compare": {
                                      "left": "E",
                                      "op": "eq",
                                      "right": "C"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    },
                    {
                      "kind": "shorthand_property_identifier_pattern",
                      "regex": "^emit$",
                      "pattern": "$E",
                      "compare": {
                        "left": "E",
                        "op": "eq",
                        "right": "C"
                      }
                    },
                    {
                      "kind": "identifier",
                      "pattern": "$E",
                      "compare": {
                        "left": "E",
                        "op": "eq",
                        "right": "C"
                      },
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "pair_pattern",
                        "has": {
                          "field": "key",
                          "regex": "^(?:emit|'emit'|\"emit\")$"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "emit-member": {
            "any": [
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "property",
                      "regex": "^emit$"
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "resolves": {
                        "binding": {
                          "site": {
                            "matches": "setup-param2"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "kind": "subscript_expression",
                "all": [
                  {
                    "has": {
                      "field": "index",
                      "kind": "string",
                      "value": {
                        "eq": "emit"
                      }
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "resolves": {
                        "binding": {
                          "site": {
                            "matches": "setup-param2"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "operand",
      "forbid": {
        "ast": {
          "language": "vue",
          "rule": {
            "all": [
              {
                "kind": "identifier"
              },
              {
                "pattern": "$R"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "kind": "statement_block",
                    "regex": "^<template\\b"
                  }
                }
              },
              {
                "matches": {
                  "ref-declared": {
                    "X": "$R",
                    "M": "$M"
                  }
                }
              },
              {
                "any": [
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "field": "condition",
                      "kind": "if_statement"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "field": "value",
                      "kind": "switch_statement"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "kind": "unary_expression"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "kind": "update_expression"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "kind": "binary_expression",
                      "not": {
                        "has": {
                          "field": "operator",
                          "regex": "^(?:&&|\\|\\||\\?\\?)$"
                        }
                      }
                    }
                  },
                  {
                    "all": [
                      {
                        "inside": {
                          "stopBy": {
                            "not": {
                              "kind": "parenthesized_expression"
                            }
                          },
                          "field": "left",
                          "kind": "binary_expression",
                          "has": {
                            "field": "operator",
                            "regex": "^(?:&&|\\|\\||\\?\\?)$"
                          }
                        }
                      },
                      {
                        "resolves": {
                          "binding": {
                            "site": {
                              "kind": "variable_declarator",
                              "inside": {
                                "stopBy": "neighbor",
                                "kind": "lexical_declaration",
                                "has": {
                                  "field": "kind",
                                  "regex": "^const$"
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "field": "left",
                      "kind": "assignment_expression"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "kind": "augmented_assignment_expression"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "field": "condition",
                      "kind": "ternary_expression"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "kind": "template_substitution",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "template_string",
                        "not": {
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "call_expression"
                          }
                        }
                      }
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "field": "object",
                      "kind": "member_expression",
                      "not": {
                        "has": {
                          "field": "property",
                          "regex": "^(?:value|effect)$"
                        }
                      }
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "field": "object",
                      "kind": "subscript_expression",
                      "has": {
                        "field": "index",
                        "any": [
                          {
                            "kind": "number"
                          },
                          {
                            "kind": "string",
                            "not": {
                              "value": {
                                "regex": "^(?:value|effect)$"
                              }
                            }
                          },
                          {
                            "kind": "template_string",
                            "all": [
                              {
                                "not": {
                                  "has": {
                                    "kind": "template_substitution"
                                  }
                                }
                              },
                              {
                                "not": {
                                  "value": {
                                    "regex": "^(?:value|effect)$"
                                  }
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "vue/no-ref-as-operand",
        "message": "Must use `.value` to read or write the value wrapped by `$M()`.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-ref-as-operand"
            ]
          }
        }
      }
    },
    {
      "id": "emit-argument",
      "forbid": {
        "ast": {
          "language": "vue",
          "rule": {
            "all": [
              {
                "kind": "identifier"
              },
              {
                "pattern": "$R"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "kind": "statement_block",
                    "regex": "^<template\\b"
                  }
                }
              },
              {
                "matches": {
                  "ref-declared": {
                    "X": "$R",
                    "M": "$M"
                  }
                }
              },
