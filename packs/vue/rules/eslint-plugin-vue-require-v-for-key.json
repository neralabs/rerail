{
  "format": "rerail.policy/v1",
  "id": "eslint-plugin-vue:require-v-for-key",
  "revision": 1,
  "mode": "steer",
  "description": "Ports eslint-plugin-vue 10.11.1 `vue/require-v-for-key` (no options): an element that a `v-for` governs and that has no `v-bind:key`/`:key`/`.key` directive, reported at its start tag. An element is governed by its own `v-for`, or, when it is a child of a `<template>` or `<slot>` without a key, by that element's governors (checkKey recurses through keyless `<template>`/`<slot>` children), each governing `v-for` reporting once (`each` over the `v-for` directive, as ESLint reports once per visited `v-for`). `<template>` and `<slot>` elements themselves are never reported, nor is a component (utils.isCustomComponent: a static `is`, `:is`/`v-bind:is`/`.is` or `v-is`, or a raw tag name that is not a well-known name of its namespace, the `custom-tag` family shared with `no-v-text-v-html-on-component`). The `v-for` on the SFC's root `<template>` is never visited by ESLint and governs nothing. Reads the Vue tree only.",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "vue",
          "utils": {
            "tag-node": {
              "any": [
                {
                  "kind": "start_tag"
                },
                {
                  "kind": "self_closing_tag"
                }
              ]
            },
            "el": {
              "any": [
                {
                  "kind": "element"
                },
                {
                  "kind": "template_element"
                }
              ]
            },
            "vfor": {
              "kind": "directive_attribute",
              "regex": "^v-for(?:[.:=\\s]|$)"
            },
            "vkey": {
              "kind": "directive_attribute",
              "regex": "^(?:v-bind:|[:.])key(?:[.=\\s]|$)"
            },
            "ts-keyless": {
              "all": [
                {
                  "matches": "el"
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tag-node",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "tag_name",
                      "regex": "^(?i:template|slot)$"
                    }
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "tag-node",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "vkey"
                      }
                    }
                  }
                }
              ]
            },
            "governed": {
              "any": [
                {
                  "all": [
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "matches": "el"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "tag-node",
                        "has": {
                          "stopBy": "neighbor",
                          "matches": "vfor",
                          "pattern": "$G"
                        }
                      }
                    }
                  ]
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "matches": "ts-keyless"
                      },
                      {
                        "matches": "governed"
                      }
                    ]
                  }
                }
              ]
            },
            "tag-svg-ctx": {
              "any": [
                {
                  "kind": "self_closing_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "start_tag",
                      "matches": "svg-children"
                    }
                  }
                },
                {
                  "kind": "start_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "element"
                        },
                        {
                          "kind": "template_element"
                        }
                      ],
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "start_tag",
                        "matches": "svg-children"
                      }
                    }
                  }
                }
              ]
            },
            "tag-math-ctx": {
              "any": [
                {
                  "kind": "self_closing_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "start_tag",
                      "matches": "math-children"
                    }
                  }
                },
                {
                  "kind": "start_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "element"
                        },
                        {
                          "kind": "template_element"
                        }
                      ],
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "start_tag",
                        "matches": "math-children"
                      }
                    }
                  }
                }
              ]
            },
            "parent-annotation-xml": {
              "any": [
                {
                  "kind": "self_closing_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "start_tag",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "tag_name",
                        "regex": "^annotation-xml$"
                      }
                    }
                  }
                },
                {
                  "kind": "start_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "element"
                        },
                        {
                          "kind": "template_element"
                        }
                      ],
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "start_tag",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "tag_name",
                          "regex": "^annotation-xml$"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "parent-text-integration": {
              "any": [
                {
                  "kind": "self_closing_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "start_tag",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "tag_name",
                        "regex": "^(?:mi|mo|mn|ms|mtext)$"
                      }
                    }
                  }
                },
                {
                  "kind": "start_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "element"
                        },
                        {
                          "kind": "template_element"
                        }
                      ],
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "start_tag",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "tag_name",
                          "regex": "^(?:mi|mo|mn|ms|mtext)$"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "parent-math-ns": {
              "any": [
                {
                  "kind": "self_closing_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "start_tag",
                      "matches": "ns-math"
                    }
                  }
                },
                {
                  "kind": "start_tag",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "element"
                      },
                      {
                        "kind": "template_element"
                      }
                    ],
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "element"
                        },
                        {
                          "kind": "template_element"
                        }
                      ],
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "start_tag",
                        "matches": "ns-math"
                      }
                    }
                  }
                }
              ]
            },
            "svg-children": {
              "all": [
                {
                  "matches": "ns-svg"
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "tag_name",
                      "regex": "^(?:foreignObject|desc|title)$"
                    }
                  }
                }
              ]
            },
            "math-children": {
              "all": [
                {
                  "matches": "ns-math"
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "tag_name",
                      "regex": "^(?:mi|mo|mn|ms|mtext)$"
                    }
                  }
                },
                {
                  "not": {
                    "matches": "annotation-html"
                  }
                }
              ]
            },
            "annotation-html": {
              "all": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "tag_name",
                    "regex": "^annotation-xml$"
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "attribute",
                    "all": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "attribute_name",
                          "regex": "(?i)^encoding$"
                        }
                      },
                      {
                        "has": {
                          "stopBy": "end",
                          "kind": "attribute_value",
                          "regex": "^(?:text/html|application/xhtml\\+xml)$"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "ns-svg": {
              "any": [
                {
                  "matches": "tag-svg-ctx"
                },
                {
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "tag_name",
                        "regex": "^svg$"
                      }
                    },
                    {
                      "any": [
                        {
                          "not": {
                            "matches": "tag-math-ctx"
                          }
                        },
                        {
                          "matches": "parent-annotation-xml"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "ns-math": {
              "any": [
                {
                  "matches": "tag-math-ctx"
                },
                {
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "tag_name",
                        "regex": "^math$"
                      }
                    },
                    {
                      "not": {
                        "matches": "tag-svg-ctx"
                      }
                    },
                    {
                      "not": {
                        "matches": "tag-math-ctx"
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "tag_name",
                        "regex": "^(?:mglyph|malignmark)$"
                      }
                    },
                    {
                      "matches": "parent-text-integration"
                    },
                    {
                      "matches": "parent-math-ns"
                    }
                  ]
                }
              ]
            },
            "custom-tag": {
              "any": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "attribute",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "attribute_name",
                          "regex": "(?i)^is$"
                        }
                      },
                      {
                        "kind": "directive_attribute",
                        "regex": "(?i)^(?:(?:v-bind:|[:.])is(?:[.=\\s]|$)|v-is(?:[:.=\\s]|$))"
                      }
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "not": {
                        "matches": "ns-svg"
                      }
                    },
                    {
                      "not": {
                        "matches": "ns-math"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "tag_name",
                        "not": {
                          "regex": "^(?:a|abbr|address|area|article|aside|audio|b|base|bdi|bdo|blockquote|body|br|button|camera|canvas|caption|cite|code|col|colgroup|data|datalist|dd|del|details|dfn|dialog|div|dl|dt|em|embed|fieldset|figcaption|figure|footer|form|geolocation|h1|h2|h3|h4|h5|h6|head|header|hgroup|hr|html|i|iframe|img|input|ins|install|kbd|label|legend|li|link|main|map|mark|menu|meta|meter|microphone|model|nav|noscript|object|ol|optgroup|option|output|p|picture|pre|progress|q|rp|rt|ruby|s|samp|script|search|section|select|selectedcontent|slot|small|source|span|strong|style|sub|summary|sup|table|tbody|td|template|textarea|tfoot|th|thead|time|title|tr|track|u|ul|usermedia|var|video|wbr)$"
                        }
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "matches": "ns-svg"
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "tag_name",
                        "not": {
                          "regex": "^(?:a|animate|animateMotion|animateTransform|circle|clipPath|defs|desc|ellipse|feBlend|feColorMatrix|feComponentTransfer|feComposite|feConvolveMatrix|feDiffuseLighting|feDisplacementMap|feDistantLight|feDropShadow|feFlood|feFuncA|feFuncB|feFuncG|feFuncR|feGaussianBlur|feImage|feMerge|feMergeNode|feMorphology|feOffset|fePointLight|feSpecularLighting|feSpotLight|feTile|feTurbulence|filter|foreignObject|g|image|line|linearGradient|marker|mask|metadata|mpath|path|pattern|polygon|polyline|radialGradient|rect|script|set|stop|style|svg|switch|symbol|text|textPath|title|tspan|use|view)$"
                        }
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "matches": "ns-math"
                    },
                    {
                      "not": {
                        "matches": "ns-svg"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "tag_name",
                        "not": {
                          "regex": "^(?:math|maction|annotation|annotation-xml|menclose|merror|mfenced|mfrac|mi|mmultiscripts|mn|mo|mover|mpadded|mphantom|mprescripts|mroot|mrow|ms|semantics|mspace|msqrt|mstyle|msub|msup|msubsup|mtable|mtd|mtext|mtr|munder|munderover)$"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "all": [
              {
                "matches": "tag-node"
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "vkey"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "tag_name",
                    "regex": "^(?i:template|slot)$"
                  }
                }
              },
              {
                "not": {
                  "matches": "custom-tag"
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "template_element"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "matches": "el"
                    },
                    {
                      "matches": "governed"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "vue/require-v-for-key",
        "message": "Elements in iteration expect to have 'v-bind:key' directives.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/require-v-for-key"
            ]
          }
        },
        "each": "G"
      }
    }
  ]
}
