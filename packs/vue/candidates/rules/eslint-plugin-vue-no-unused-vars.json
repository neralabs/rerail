{
  "format": "rerail.policy/v1",
  "id": "eslint-plugin-vue-no-unused-vars",
  "revision": 1,
  "mode": "steer",
  "description": "Ports eslint-plugin-vue 10.11.1 `vue/no-unused-vars` with default options (no ignorePattern): a template variable that nothing reads: a v-for alias or a slot parameter (`v-slot`, `#name`, Vue 2 `slot-scope`/`scope`). Reads the view program: the parameters of the arrow that stands for a v-for (`expression_statement > sequence_expression > arrow_function`) or a slot (`expression_statement > arrow_function`) inside the template block, resolved by the engine's per-binding occurrences (a reference that is neither the definition nor the bare `Tag;` read the view writes for a component tag, which vue-eslint-parser does not make a reference). A variable that is unreferenced is still exempt when a descendant element's raw tag name is the variable's (upstream's isUsedAsComponentTag: the view's read of a descendant component tag, never the `v-for` element's own, which is its arrow's first statement, read at the arrow's own tag name). Parameters before a referenced one in the same arrow are exempt (after-used) unless destructured (an object-pattern property or an array-pattern element; a rest element of an object pattern is not). A v-for alias that a v-if/v-else-if condition of the same element reads is used (upstream resolves that condition in the element's scope; Vue 3 compiles it outside the v-for). Reported at the parameter identifier.",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "vue",
          "utils": {
            "view-arrow": {
              "kind": "arrow_function",
              "any": [
                {
                  "inside": {
                    "kind": "expression_statement"
                  }
                },
                {
                  "inside": {
                    "kind": "sequence_expression",
                    "inside": {
                      "kind": "expression_statement"
                    }
                  }
                }
              ],
              "inside": {
                "stopBy": "end",
                "kind": "statement_block",
                "regex": "^<template"
              }
            },
            "view-param": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "shorthand_property_identifier_pattern"
                    }
                  ]
                },
                {
                  "binds": {
                    "form": "parameter"
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "formal_parameters",
                    "inside": {
                      "matches": "view-arrow"
                    }
                  }
                }
              ]
            },
            "param-destructured": {
              "any": [
                {
                  "kind": "shorthand_property_identifier_pattern"
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "pair_pattern"
                      },
                      {
                        "kind": "array_pattern"
                      }
                    ]
                  }
                }
              ]
            },
            "cond-used-q": {
              "inside": {
                "stopBy": "end",
                "kind": "formal_parameters",
                "inside": {
                  "kind": "arrow_function",
                  "inside": {
                    "kind": "sequence_expression",
                    "inside": {
                      "kind": "expression_statement",
                      "pattern": "$QS",
                      "inside": {
                        "kind": "statement_block",
                        "pattern": "$QB",
                        "compare": {
                          "left": "QS",
                          "op": "eq",
                          "right": "QB"
                        },
                        "inside": {
                          "kind": "if_statement",
                          "has": {
                            "field": "condition",
                            "has": {
                              "stopBy": "end",
                              "any": [
                                {
                                  "kind": "identifier"
                                },
                                {
                                  "kind": "shorthand_property_identifier"
                                }
                              ],
                              "pattern": "$QR",
                              "compare": {
                                "left": "Q",
                                "op": "eq",
                                "right": "QR"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "cond-used-name": {
              "inside": {
                "stopBy": "end",
                "kind": "formal_parameters",
                "inside": {
                  "kind": "arrow_function",
                  "inside": {
                    "kind": "sequence_expression",
                    "inside": {
                      "kind": "expression_statement",
                      "pattern": "$NAMES",
                      "inside": {
                        "kind": "statement_block",
                        "pattern": "$NAMEB",
                        "compare": {
                          "left": "NAMES",
                          "op": "eq",
                          "right": "NAMEB"
                        },
                        "inside": {
                          "kind": "if_statement",
                          "has": {
                            "field": "condition",
                            "has": {
                              "stopBy": "end",
                              "any": [
                                {
                                  "kind": "identifier"
                                },
                                {
                                  "kind": "shorthand_property_identifier"
                                }
                              ],
                              "pattern": "$NAMER",
                              "compare": {
                                "left": "NAME",
                                "op": "eq",
                                "right": "NAMER"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "param-used": {
              "pattern": "$Q",
              "all": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "shorthand_property_identifier_pattern"
                    }
                  ]
                },
                {
                  "binds": {
                    "form": "parameter"
                  }
                },
                {
                  "any": [
                    {
                      "binds": {
                        "occurrence": {
                          "matches": "real-ref"
                        }
                      }
                    },
                    {
                      "matches": "cond-used-q"
                    }
                  ]
                }
              ]
            },
            "after-used": {
              "any": [
                {
                  "precedes": {
                    "stopBy": "end",
                    "any": [
                      {
                        "matches": "param-used"
                      },
                      {
                        "has": {
                          "stopBy": "end",
                          "matches": "param-used"
                        }
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "kind": "formal_parameters"
                    },
                    "not": {
                      "kind": "formal_parameters"
                    },
                    "precedes": {
                      "stopBy": "end",
                      "any": [
                        {
                          "matches": "param-used"
                        },
                        {
                          "has": {
                            "stopBy": "end",
                            "matches": "param-used"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "tag-read": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "expression_statement"
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "not": {
                        "kind": "member_expression"
                      }
                    },
                    "kind": "expression_statement"
                  }
                }
              ]
            },
            "real-ref": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "shorthand_property_identifier"
                    }
                  ]
                },
                {
                  "not": {
                    "binds": {
                      "form": "parameter"
                    }
                  }
                },
                {
                  "not": {
                    "matches": "tag-read"
                  }
                }
              ]
            },
            "tag-used-name": {
              "inside": {
                "stopBy": "end",
                "kind": "formal_parameters",
                "inside": {
                  "kind": "arrow_function",
                  "has": {
                    "stopBy": "end",
                    "kind": "identifier",
                    "pattern": "$TAGT",
                    "compare": {
                      "left": "NAME",
                      "op": "eq",
                      "right": "TAGT"
                    },
                    "any": [
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "expression_statement",
                          "not": {
                            "nthChild": 1
                          }
                        }
                      },
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "expression_statement",
                          "nthChild": 1,
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "statement_block",
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "arrow_function",
                              "not": {
                                "matches": "declares-name"
                              }
                            }
                          }
                        }
                      },
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "expression_statement",
                          "nthChild": 1,
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "statement_block",
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "arrow_function",
                              "matches": "declares-name",
                              "not": {
                                "inside": {
                                  "stopBy": "neighbor",
                                  "kind": "sequence_expression"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "expression_statement",
                          "nthChild": 1,
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "statement_block",
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "arrow_function",
                              "matches": "declares-name",
                              "pattern": "$OWNER",
                              "compare": {
                                "left": "OWN",
                                "op": "ne",
                                "right": "TAGT"
                              },
                              "inside": {
                                "stopBy": "neighbor",
                                "kind": "sequence_expression"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "declares-name": {
              "has": {
                "stopBy": "neighbor",
                "kind": "formal_parameters",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "shorthand_property_identifier_pattern"
                    }
                  ],
                  "pattern": "$ZP",
                  "compare": {
                    "left": "NAME",
                    "op": "eq",
                    "right": "ZP",
                    "text": "node"
                  }
                }
              }
            }
          },
          "rule": {
            "pattern": "$NAME",
            "all": [
              {
                "matches": "view-param"
              },
              {
                "binds": {
                  "form": "parameter"
                }
              },
              {
                "not": {
                  "binds": {
                    "occurrence": {
                      "matches": "real-ref"
                    }
                  }
                }
              },
              {
                "not": {
                  "matches": "cond-used-name"
                }
              },
              {
                "not": {
                  "matches": "tag-used-name"
                }
              },
              {
                "not": {
                  "all": [
                    {
                      "not": {
                        "matches": "param-destructured"
                      }
                    },
                    {
                      "matches": "after-used"
                    }
                  ]
                }
              }
            ]
          },
          "transform": {
            "OWN": {
              "replace": {
                "source": "$OWNER",
                "replace": "^<([^\\s/>]+)[\\s\\S]*$",
                "by": "$1"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "vue/no-unused-vars",
        "message": "'$NAME' is defined but never used.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-unused-vars"
            ]
          }
        }
      }
    }
  ]
}
