{
  "format": "rerail.policy/v1",
  "id": "eslint-plugin-vue-no-v-html",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid the v-html directive; rendering raw HTML can expose users to XSS attacks.",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "vue",
          "rule": {
            "kind": "directive_attribute",
            "has": {
              "stopBy": "neighbor",
              "kind": "directive_name",
              "regex": "^v-html$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "vue/no-v-html",
        "message": "'v-html' directive can lead to XSS attack.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-v-html"
            ]
          }
        }
      }
    }
  ]
}
