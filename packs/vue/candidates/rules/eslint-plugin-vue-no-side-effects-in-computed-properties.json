{
  "format": "rerail.policy/v1",
  "id": "eslint-plugin-vue-no-side-effects-in-computed-properties",
  "revision": 1,
  "mode": "steer",
  "description": "Ports eslint-plugin-vue 10.11.1 `vue/no-side-effects-in-computed-properties` (default options). In an Options API getter (files without `<script setup>`) reports `this`/`const vm = this` member assignments, updates, deletes, calls of push/pop/shift/unshift/reverse/splice/sort/copyWithin/fill on a member of `this`, `Object.assign(this.x, ...)`, and `this.$set`/`Vue.set` (at the property). In a composition getter reports the same on a binding declared once, outside the getter, in `<script setup>` or the body of a Vue object's `setup` function, not imported (aliases are not followed, as upstream).",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "vue",
        "utils": {
          "fn-like": {
            "any": [
              {
                "kind": "function_declaration"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "arrow_function"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "generator_function_declaration"
              },
              {
                "kind": "method_definition"
              }
            ]
          },
          "fn-expr": {
            "any": [
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              }
            ]
          },
          "paren-as": {
            "any": [
              {
                "kind": "parenthesized_expression"
              },
              {
                "kind": "as_expression"
              }
            ]
          },
          "setup-marker": {
            "kind": "empty_statement",
            "host": {
              "kind": "start_tag",
              "regex": "^<script(?:\\s+[^\\s\"'<>/=]+(?:\\s*=\\s*(?:\"[^\"]*\"|'[^']*'|[^\\s\"'<>=`]+))?)*\\s+setup(?:[\\s/>=]|$)"
            }
          },
          "any-marker": {
            "kind": "empty_statement",
            "host": {
              "kind": "start_tag",
              "regex": "^<script\\b"
            }
          },
          "top-in-setup": {
            "all": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "program"
                }
              },
              {
                "follows": {
                  "stopBy": {
                    "matches": "any-marker"
                  },
                  "matches": "setup-marker"
                }
              }
            ]
          },
          "in-setup": {
            "any": [
              {
                "matches": "top-in-setup"
              },
              {
                "inside": {
                  "stopBy": "end",
                  "matches": "top-in-setup"
                }
              }
            ]
          },
          "file-setup": {
            "inside": {
              "stopBy": "end",
              "kind": "program",
              "has": {
                "stopBy": "neighbor",
                "matches": "setup-marker"
              }
            }
          },
          "file-plain": {
            "not": {
              "matches": "file-setup"
            }
          },
          "key-computed": {
            "any": [
              {
                "regex": "^(?:computed|'computed'|\"computed\")$",
                "not": {
                  "kind": "computed_property_name"
                }
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string",
                  "regex": "^(?:'computed'|\"computed\")$"
                }
              }
            ]
          },
          "key-get": {
            "any": [
              {
                "regex": "^(?:get|'get'|\"get\")$",
                "not": {
                  "kind": "computed_property_name"
                }
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string",
                  "regex": "^(?:'get'|\"get\")$"
                }
              }
            ]
          },
          "key-setup": {
            "any": [
              {
                "regex": "^(?:setup|'setup'|\"setup\")$",
                "not": {
                  "kind": "computed_property_name"
                }
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string",
                  "regex": "^(?:'setup'|\"setup\")$"
                }
              }
            ]
          },
          "last-arg": {
            "any": [
              {
                "all": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "arguments"
                    }
                  },
                  {
                    "nthChild": {
                      "position": 1,
                      "reverse": true,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "matches": "paren-as"
                    },
                    {
                      "matches": "last-arg"
                    }
                  ]
                }
              }
            ]
          },
          "first-arg": {
            "any": [
              {
                "all": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "arguments"
                    }
                  },
                  {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "matches": "paren-as"
                    },
                    {
                      "matches": "first-arg"
                    }
                  ]
                }
              }
            ]
          },
          "define-callee": {
            "any": [
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "regex": "^(?:component|mixin)$"
                    }
                  }
                ]
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "regex": "^Vue$"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "regex": "^extend$"
                    }
                  }
                ]
              },
              {
                "kind": "identifier",
                "regex": "^defineNuxtComponent$"
              },
              {
                "kind": "identifier",
                "regex": "^(?:component|createApp|defineComponent)$",
                "not": {
                  "resolves": {
                    "binding": {
                      "site": {
                        "any": [
                          {
                            "kind": "import_specifier",
                            "not": {
                              "inside": {
                                "stopBy": "end",
                                "kind": "import_statement",
                                "has": {
                                  "field": "source",
                                  "kind": "string",
                                  "value": {
                                    "regex": "^(?:vue|@vue/composition-api|@nuxtjs/composition-api|#imports)$"
                                  }
                                }
                              }
                            }
                          },
                          {
                            "kind": "function_declaration"
                          },
                          {
                            "kind": "generator_function_declaration"
                          },
                          {
                            "kind": "class_declaration"
                          },
                          {
                            "kind": "catch_clause"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "vue-object": {
            "kind": "object",
            "any": [
              {
                "inside": {
                  "stopBy": {
                    "not": {
                      "kind": "parenthesized_expression"
                    }
                  },
                  "kind": "export_statement",
                  "not": {
                    "matches": "top-in-setup"
                  }
                }
              },
              {
                "all": [
                  {
                    "matches": "last-arg"
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "matches": "paren-as"
                        }
                      },
                      "kind": "arguments",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "matches": "define-callee"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "matches": "first-arg"
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "matches": "paren-as"
                        }
                      },
                      "kind": "arguments",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "new_expression",
                        "has": {
                          "field": "constructor",
                          "kind": "identifier",
                          "regex": "^Vue$"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "not": {
                  "not": {
                    "all": [
                      {
                        "pattern": "$VUEOBJ"
                      },
                      {
                        "inside": {
                          "stopBy": "end",
                          "kind": "program",
                          "has": {
                            "stopBy": "end",
                            "kind": "comment",
                            "regex": "@vue/component",
                            "layout": {
                              "after": {
                                "to": "capture.VUEOBJ",
                                "breaks": {
                                  "eq": 1
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "computed-object": {
            "kind": "object",
            "inside": {
              "field": "value",
              "stopBy": "neighbor",
              "kind": "pair",
              "all": [
                {
                  "has": {
                    "field": "key",
                    "matches": "key-computed"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "vue-object"
                  }
                }
              ]
            }
          },
          "opt-getter": {
            "any": [
              {
                "kind": "method_definition",
                "all": [
                  {
                    "has": {
                      "field": "name",
                      "pattern": "$K"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "computed-object"
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "matches": "fn-expr"
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "matches": "paren-as"
                        }
                      },
                      "kind": "pair",
                      "all": [
                        {
                          "has": {
                            "field": "key",
                            "pattern": "$K"
                          }
                        },
                        {
                          "inside": {
                            "stopBy": "neighbor",
                            "matches": "computed-object"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "kind": "method_definition",
                "all": [
                  {
                    "has": {
                      "field": "name",
                      "matches": "key-get"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "object",
                      "inside": {
                        "stopBy": {
                          "not": {
                            "matches": "paren-as"
                          }
                        },
                        "kind": "pair",
                        "all": [
                          {
                            "has": {
                              "field": "key",
                              "pattern": "$K"
                            }
                          },
                          {
                            "inside": {
                              "stopBy": "neighbor",
                              "matches": "computed-object"
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "matches": "fn-expr"
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "kind": "pair",
                      "all": [
                        {
                          "has": {
                            "field": "key",
                            "matches": "key-get"
                          }
                        },
                        {
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "object",
                            "inside": {
                              "stopBy": {
                                "not": {
                                  "matches": "paren-as"
                                }
                              },
                              "kind": "pair",
                              "all": [
                                {
                                  "has": {
                                    "field": "key",
                                    "pattern": "$K"
                                  }
                                },
                                {
                                  "inside": {
                                    "stopBy": "neighbor",
                                    "matches": "computed-object"
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "computed-callee": {
            "any": [
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "import_specifier",
                      "all": [
                        {
                          "has": {
                            "field": "name",
                            "regex": "^computed$"
                          }
                        },
                        {
                          "inside": {
                            "stopBy": "end",
                            "kind": "import_statement",
                            "has": {
                              "field": "source",
                              "kind": "string",
                              "value": {
                                "regex": "^(?:vue|@vue/composition-api|@nuxtjs/composition-api|#imports)$"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "property",
                      "regex": "^computed$"
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "resolves": {
                        "binding": {
                          "site": {
                            "kind": "namespace_import",
                            "inside": {
                              "stopBy": "end",
                              "kind": "import_statement",
                              "has": {
                                "field": "source",
                                "kind": "string",
                                "value": {
                                  "regex": "^(?:vue|@vue/composition-api|@nuxtjs/composition-api|#imports)$"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "computed-arg": {
            "any": [
              {
                "all": [
                  {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "arguments",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "matches": "computed-callee"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "matches": "computed-arg"
                    }
                  ]
                }
              }
            ]
          },
          "fn-or-arrow": {
            "any": [
              {
                "matches": "fn-expr"
              },
              {
                "kind": "arrow_function"
              }
            ]
          },
          "comp-getter": {
            "any": [
              {
                "all": [
                  {
                    "matches": "fn-or-arrow"
                  },
                  {
                    "matches": "computed-arg"
                  }
                ]
              },
              {
                "kind": "method_definition",
                "all": [
                  {
                    "has": {
                      "field": "name",
                      "matches": "key-get"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "object",
                      "matches": "computed-arg"
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "matches": "fn-or-arrow"
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "kind": "parenthesized_expression"
                        }
                      },
                      "kind": "pair",
                      "all": [
                        {
                          "has": {
                            "field": "key",
                            "matches": "key-get"
                          }
                        },
                        {
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "object",
                            "matches": "computed-arg"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "in-vue-object": {
            "inside": {
              "stopBy": "end",
              "matches": "vue-object"
            }
          },
          "comp-ctx": {
            "any": [
              {
                "all": [
                  {
                    "matches": "file-setup"
                  },
                  {
                    "matches": "in-setup"
                  }
                ]
              },
              {
                "all": [
                  {
                    "matches": "file-plain"
                  },
                  {
                    "matches": "in-vue-object"
                  }
                ]
              }
            ]
          },
          "this-ish": {
            "any": [
              {
                "kind": "this"
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "only": true,
                    "site": {
                      "kind": "variable_declarator",
                      "all": [
                        {
                          "has": {
                            "field": "name",
                            "kind": "identifier"
                          }
                        },
                        {
                          "has": {
                            "field": "value",
                            "kind": "this"
                          }
                        },
                        {
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "lexical_declaration",
                            "has": {
                              "stopBy": "neighbor",
                              "regex": "^const$"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "root-opt": {
            "all": [
              {
                "matches": "this-ish"
              },
              {
                "matches": "file-plain"
              },
              {
                "inside": {
                  "stopBy": {
                    "matches": "fn-like"
                  },
                  "matches": "opt-getter"
                }
              }
            ]
          },
          "base-opt": {
            "any": [
              {
                "matches": "root-opt"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "base-opt"
                }
              },
              {
                "all": [
                  {
                    "any": [
                      {
                        "kind": "member_expression"
                      },
                      {
                        "kind": "subscript_expression"
                      }
                    ]
                  },
                  {
                    "has": {
                      "field": "object",
                      "matches": "base-opt"
                    }
                  }
                ]
              }
            ]
          },
          "chain-opt": {
            "any": [
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "chain-opt"
                }
              },
              {
                "all": [
                  {
                    "any": [
                      {
                        "kind": "member_expression"
                      },
                      {
                        "kind": "subscript_expression"
                      }
                    ]
                  },
                  {
                    "has": {
                      "field": "object",
                      "matches": "base-opt"
                    }
                  }
                ]
              }
            ]
          },
          "callee-mut-opt": {
            "any": [
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "callee-mut-opt"
                }
              },
              {
                "any": [
                  {
                    "kind": "member_expression",
                    "all": [
                      {
                        "has": {
                          "field": "object",
                          "matches": "chain-opt"
                        }
                      },
                      {
                        "has": {
                          "field": "property",
                          "regex": "^(?:push|pop|shift|unshift|reverse|splice|sort|copyWithin|fill)$"
                        }
                      }
                    ]
                  },
                  {
                    "kind": "subscript_expression",
                    "all": [
                      {
                        "has": {
                          "field": "object",
                          "matches": "chain-opt"
                        }
                      },
                      {
                        "has": {
                          "field": "index",
                          "kind": "string",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "string_fragment",
                            "regex": "^(?:push|pop|shift|unshift|reverse|splice|sort|copyWithin|fill)$"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "mutation-opt": {
            "any": [
              {
                "kind": "assignment_expression",
                "has": {
                  "field": "left",
                  "matches": "chain-opt"
                }
              },
              {
                "kind": "augmented_assignment_expression",
                "has": {
                  "field": "left",
                  "matches": "chain-opt"
                }
              },
              {
                "kind": "update_expression",
                "has": {
                  "field": "argument",
                  "matches": "chain-opt"
                }
              },
              {
                "kind": "unary_expression",
                "all": [
                  {
                    "has": {
                      "field": "operator",
                      "regex": "^delete$"
                    }
                  },
                  {
                    "has": {
                      "field": "argument",
                      "matches": "chain-opt"
                    }
                  }
                ]
              },
              {
                "kind": "call_expression",
                "any": [
                  {
                    "has": {
                      "field": "function",
                      "matches": "callee-mut-opt"
                    }
                  },
                  {
                    "all": [
                      {
                        "has": {
                          "field": "function",
                          "kind": "member_expression",
                          "all": [
                            {
                              "has": {
                                "field": "object",
                                "kind": "identifier",
                                "regex": "^Object$"
                              }
                            },
                            {
                              "has": {
                                "field": "property",
                                "regex": "^assign$"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "arguments": {
                          "signature": [
                            "target"
                          ],
                          "bind": {
                            "T": "target"
                          },
                          "mode": "estree"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "setup-fn": {
            "any": [
              {
                "kind": "method_definition",
                "all": [
                  {
                    "has": {
                      "field": "name",
                      "matches": "key-setup"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "vue-object"
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "matches": "fn-or-arrow"
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "pair",
                      "all": [
                        {
                          "has": {
                            "field": "key",
                            "matches": "key-setup"
                          }
                        },
                        {
                          "inside": {
                            "stopBy": "neighbor",
                            "matches": "vue-object"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "root-comp": {
            "kind": "identifier",
            "all": [
              {
                "matches": "comp-ctx"
              },
              {
                "inside": {
                  "stopBy": {
                    "matches": "fn-like"
                  },
                  "matches": "comp-getter",
                  "pattern": "$F"
                }
              },
              {
                "resolves": {
                  "binding": {
                    "only": true,
                    "site": {
                      "all": [
                        {
                          "not": {
                            "kind": "import_specifier"
                          }
                        },
                        {
                          "not": {
                            "kind": "import_clause"
                          }
                        },
                        {
                          "not": {
                            "kind": "namespace_import"
                          }
                        },
                        {
                          "any": [
                            {
                              "all": [
                                {
                                  "matches": "file-setup"
                                },
                                {
                                  "matches": "in-setup"
                                }
                              ]
                            },
                            {
                              "all": [
                                {
                                  "matches": "file-plain"
                                },
                                {
                                  "inside": {
                                    "stopBy": "end",
                                    "kind": "statement_block",
                                    "inside": {
                                      "field": "body",
                                      "stopBy": "neighbor",
                                      "matches": "setup-fn"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "not": {
                            "inside": {
                              "stopBy": "end",
                              "pattern": "$F"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "base-comp": {
            "any": [
              {
                "matches": "root-comp"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "base-comp"
                }
              },
              {
                "all": [
                  {
                    "any": [
                      {
                        "kind": "member_expression"
                      },
                      {
                        "kind": "subscript_expression"
                      }
                    ]
                  },
                  {
                    "has": {
                      "field": "object",
                      "matches": "base-comp"
                    }
                  }
                ]
              }
            ]
          },
          "chain-comp": {
            "any": [
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "chain-comp"
                }
              },
              {
                "all": [
                  {
                    "any": [
                      {
                        "kind": "member_expression"
                      },
                      {
                        "kind": "subscript_expression"
                      }
                    ]
                  },
                  {
                    "has": {
                      "field": "object",
                      "matches": "base-comp"
                    }
                  }
                ]
              }
            ]
          },
          "callee-mut-comp": {
            "any": [
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "callee-mut-comp"
                }
              },
              {
                "any": [
                  {
                    "kind": "member_expression",
                    "all": [
                      {
                        "has": {
                          "field": "object",
                          "matches": "base-comp"
                        }
                      },
                      {
                        "has": {
                          "field": "property",
                          "regex": "^(?:push|pop|shift|unshift|reverse|splice|sort|copyWithin|fill)$"
                        }
                      }
                    ]
                  },
                  {
                    "kind": "subscript_expression",
                    "all": [
                      {
                        "has": {
                          "field": "object",
                          "matches": "base-comp"
                        }
                      },
                      {
                        "has": {
                          "field": "index",
                          "kind": "string",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "string_fragment",
                            "regex": "^(?:push|pop|shift|unshift|reverse|splice|sort|copyWithin|fill)$"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "mutation-comp": {
            "any": [
              {
                "kind": "assignment_expression",
                "has": {
                  "field": "left",
                  "matches": "chain-comp"
                }
              },
              {
                "kind": "augmented_assignment_expression",
                "has": {
                  "field": "left",
                  "matches": "chain-comp"
                }
              },
              {
                "kind": "update_expression",
                "has": {
                  "field": "argument",
                  "matches": "chain-comp"
                }
              },
              {
                "kind": "unary_expression",
                "all": [
                  {
                    "has": {
                      "field": "operator",
                      "regex": "^delete$"
                    }
                  },
                  {
                    "has": {
                      "field": "argument",
                      "matches": "chain-comp"
                    }
                  }
                ]
              },
              {
                "kind": "call_expression",
                "any": [
                  {
                    "has": {
                      "field": "function",
                      "matches": "callee-mut-comp"
                    }
                  },
                  {
                    "all": [
                      {
                        "has": {
                          "field": "function",
                          "kind": "member_expression",
                          "all": [
                            {
                              "has": {
                                "field": "object",
                                "kind": "identifier",
                                "regex": "^Object$"
                              }
                            },
                            {
                              "has": {
                                "field": "property",
                                "regex": "^assign$"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "arguments": {
                          "signature": [
                            "target"
                          ],
                          "bind": {
                            "T": "target"
                          },
                          "mode": "estree"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "set-in-options-getter",
      "forbid": {
        "ast": {
          "language": "vue",
          "embedded": "script-block",
          "rule": {
            "all": [
              {
                "kind": "property_identifier",
                "regex": "^(?:\\$set|set)$"
              },
              {
                "inside": {
                  "field": "property",
                  "stopBy": "neighbor",
                  "kind": "member_expression",
                  "all": [
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "kind": "call_expression"
                          },
                          {
                            "kind": "arguments",
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "call_expression"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "any": [
                        {
                          "all": [
                            {
                              "has": {
                                "field": "property",
                                "regex": "^\\$set$"
                              }
                            },
                            {
                              "has": {
                                "field": "object",
                                "matches": "root-opt"
                              }
                            }
                          ]
                        },
                        {
                          "all": [
                            {
                              "has": {
                                "field": "property",
                                "regex": "^set$"
                              }
                            },
                            {
                              "has": {
                                "field": "object",
                                "all": [
                                  {
                                    "kind": "identifier",
                                    "regex": "^Vue$"
                                  },
                                  {
                                    "matches": "file-plain"
                                  },
                                  {
                                    "inside": {
                                      "stopBy": {
                                        "matches": "fn-like"
                                      },
                                      "matches": "opt-getter"
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "transform": {
            "N1": {
              "replace": {
                "source": "$K",
                "replace": "^(?:\\[\\s*(?:'([^']*)'|\"([^\"]*)\")\\s*\\]|'([^']*)'|\"([^\"]*)\")$",
                "by": "${1}${2}${3}${4}"
              }
            },
            "NAME": {
              "replace": {
                "source": "$N1",
                "replace": "^\\[.*\\]$",
                "by": "Unknown"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "vue/no-side-effects-in-computed-properties",
        "message": "Unexpected side effect in \"$NAME\" computed property.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-side-effects-in-computed-properties"
            ]
          }
        }
      }
    },
    {
      "id": "mutation-in-options-getter",
      "forbid": {
        "ast": {
          "language": "vue",
          "embedded": "script-block",
          "rule": {
            "matches": "mutation-opt"
          },
          "constraints": {
            "T": {
              "matches": "chain-opt"
            }
          },
          "transform": {
            "N1": {
              "replace": {
                "source": "$K",
                "replace": "^(?:\\[\\s*(?:'([^']*)'|\"([^\"]*)\")\\s*\\]|'([^']*)'|\"([^\"]*)\")$",
                "by": "${1}${2}${3}${4}"
              }
            },
            "NAME": {
              "replace": {
                "source": "$N1",
                "replace": "^\\[.*\\]$",
                "by": "Unknown"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "vue/no-side-effects-in-computed-properties",
        "message": "Unexpected side effect in \"$NAME\" computed property.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-side-effects-in-computed-properties"
            ]
          }
        }
      }
    },
    {
      "id": "mutation-in-composition-getter",
      "forbid": {
