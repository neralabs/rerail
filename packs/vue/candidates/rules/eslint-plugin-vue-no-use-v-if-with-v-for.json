                }
              },
              {
                "matches": "uses"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "vue/no-use-v-if-with-v-for",
        "message": "The '$SRC' variable inside 'v-for' directive should be replaced with a computed property that returns filtered array instead. You should not mix 'v-for' with 'v-if'.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-use-v-if-with-v-for"
            ]
          }
        }
      }
    },
