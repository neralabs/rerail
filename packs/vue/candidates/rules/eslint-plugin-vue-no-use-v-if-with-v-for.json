                      "has": {
                        "stopBy": "neighbor",
                        "matches": "vfor",
                        "embedded": {
                          "all": [
                            {
                              "pattern": "$SRC"
                            },
                            {
                              "kind": "identifier"
                            },
                            {
                              "not": {
                                "kind": "comment"
                              }
                            },
                            {
                              "inside": {
                                "stopBy": "neighbor",
                                "kind": "parenthesized_expression",
                                "inside": {
                                  "stopBy": "neighbor",
                                  "kind": "sequence_expression"
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "el"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "template_element"
                }
              },
              {
                "matches": "uses"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "vue/no-use-v-if-with-v-for",
        "message": "Replace '$SRC' in this v-for with a computed property that returns the filtered list, and drop the v-if.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-use-v-if-with-v-for"
            ]
          }
        }
      }
    },
