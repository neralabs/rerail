{
  "format": "rerail.policy/v1",
  "id": "eslint-plugin-vue-no-use-v-if-with-v-for",
  "revision": 1,
  "mode": "steer",
  "description": "Ports eslint-plugin-vue 10.11.1 `vue/no-use-v-if-with-v-for` with default options (allowUsingIterationVar: false): a `v-if` directive on an element that also has `v-for`, reported at the `v-if` attribute. If the condition reads a name the element's `v-for` declares (a reference whose text equals a parameter name of the v-for arrow, as upstream compares names of `references` and `variables`) the message names the iterated source (`<source>` variable when it is an identifier, else expression); otherwise it asks to move the `v-if` to a wrapper. A clause over the file's own tree that reaches the script-block program through `embedded`: the `v-if` of an element with a `v-for` is `if (C) { (SRC), (ALIAS) => { <element> } }`, so a read of C reached from the `v-if` directive is compared with the parameters of the arrow its consequence holds, and the source expression is reached from the `v-for` directive.",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "moved-to-wrapper",
      "forbid": {
        "ast": {
          "language": "vue",
          "utils": {
            "tag-node": {
              "any": [
                {
                  "kind": "start_tag"
                },
                {
                  "kind": "self_closing_tag"
                }
              ]
            },
            "el": {
              "any": [
                {
                  "kind": "element"
                },
                {
                  "kind": "template_element"
                }
              ]
            },
            "vfor": {
              "kind": "directive_attribute",
              "regex": "^v-for(?:[.:=\\s]|$)"
            },
            "binder": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "shorthand_property_identifier_pattern"
                }
              ]
            },
            "ref": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "shorthand_property_identifier"
                }
              ]
            },
            "uses": {
              "embedded": {
                "all": [
                  {
                    "matches": "ref"
                  },
                  {
                    "pattern": "$REF"
                  },
                  {
                    "inside": {
                      "stopBy": "end",
                      "kind": "parenthesized_expression",
                      "inside": {
                        "stopBy": "neighbor",
                        "field": "condition",
                        "kind": "if_statement",
                        "has": {
                          "stopBy": "neighbor",
                          "field": "consequence",
                          "kind": "statement_block",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "expression_statement",
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "sequence_expression",
                              "has": {
                                "stopBy": "neighbor",
                                "kind": "arrow_function",
                                "has": {
                                  "stopBy": "neighbor",
                                  "kind": "formal_parameters",
                                  "has": {
                                    "stopBy": "end",
                                    "all": [
                                      {
                                        "matches": "binder"
                                      },
                                      {
                                        "pattern": "$AL"
                                      },
                                      {
                                        "compare": {
                                          "left": "REF",
                                          "op": "eq",
                                          "right": "AL",
                                          "text": "source"
                                        }
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "rule": {
            "all": [
              {
                "kind": "directive_attribute",
                "regex": "^v-if(?:[.:=\\s]|$)"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "matches": "tag-node"
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "vfor"
                      }
                    }
                  ],
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "el"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "template_element"
                }
              },
              {
                "not": {
                  "matches": "uses"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "vue/no-use-v-if-with-v-for",
        "message": "This 'v-if' should be moved to the wrapper element.",
        "suppress": {
          "eslint": {
            "rules": [
              "vue/no-use-v-if-with-v-for"
            ]
          }
        }
      }
    },
