{
  "format": "rerail.policy/v1",
  "id": "eslint-plugin-vue-attribute-hyphenation",
  "revision": 1,
  "mode": "steer",
  "description": "Use hyphenated (kebab-case) attribute and prop names, not camelCase, on Vue components and slots in templates.",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "static",
      "forbid": {
        "ast": {
          "language": "vue",
          "utils": {
            "tag-svg-ctx": {
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "element"
                  },
                  {
                    "kind": "template_element"
                  }
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "element"
                    },
                    {
                      "kind": "template_element"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "start_tag",
                    "matches": "svg-children"
                  }
                }
              }
            },
            "tag-math-ctx": {
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "element"
                  },
                  {
                    "kind": "template_element"
                  }
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "element"
                    },
                    {
