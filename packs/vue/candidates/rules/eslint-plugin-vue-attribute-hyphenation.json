                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "start_tag",
                    "matches": "math-children"
                  }
                }
              }
            },
            "parent-annotation-xml": {
              "inside": {
                "stopBy": "neighbor",
