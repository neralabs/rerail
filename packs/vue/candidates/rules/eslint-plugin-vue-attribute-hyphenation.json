                  {
                    "kind": "element"
                  },
                  {
                    "kind": "template_element"
                  }
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "element"
                    },
                    {
                      "kind": "template_element"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "start_tag",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "tag_name",
                      "regex": "^annotation-xml$"
                    }
                  }
                }
              }
            },
            "parent-text-integration": {
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "element"
                  },
                  {
                    "kind": "template_element"
                  }
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "element"
                    },
                    {
                      "kind": "template_element"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "start_tag",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "tag_name",
                      "regex": "^(?:mi|mo|mn|ms|mtext)$"
                    }
                  }
                }
              }
            },
            "parent-math-ns": {
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "element"
                  },
                  {
                    "kind": "template_element"
                  }
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "element"
                    },
