{
  "format": "rerail.policy/v1",
  "id": "complexity-cyclomatic-vue",
  "revision": 1,
  "mode": "steer",
  "description": "Keep the functions of a Vue component's scripts at cyclomatic complexity 6 or below, counting each if, loop, catch, switch, ternary and && or ||; branch-heavy functions are hard to follow and test.",
  "scope": {
    "include": [
      "**/*.vue"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.nuxt/**",
      "**/.output/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**"
    ]
  },
  "clauses": [
    {
      "id": "complexity",
      "define": {
        "language": "vue",
        "utils": {
          "tpl-block": {
            "kind": "statement_block",
            "host": {
              "kind": "template_element"
            }
          },
          "boundary": {
            "all": [
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "arrow_function"
                  },
                  {
                    "kind": "method_definition"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "generator_function_declaration"
                  }
                ]
              },
              {
                "not": {
                  "inside": {
                    "matches": "tpl-block",
                    "stopBy": "end"
                  }
                }
              }
            ]
          },
          "decision": {
            "any": [
              {
                "kind": "if_statement"
              },
              {
                "kind": "for_statement"
              },
              {
                "kind": "for_in_statement"
              },
              {
                "kind": "while_statement"
              },
              {
                "kind": "do_statement"
              },
              {
                "kind": "catch_clause"
              },
              {
                "kind": "switch_statement",
                "has": {
                  "kind": "switch_body",
                  "has": {
                    "kind": "switch_case"
                  }
                }
              },
              {
                "kind": "ternary_expression"
              },
              {
                "kind": "binary_expression",
                "has": {
                  "regex": "^(?:&&|\\|\\|)$"
                }
              },
              {
                "kind": "augmented_assignment_expression",
                "has": {
                  "regex": "^(?:&&=|\\|\\|=)$"
                }
              }
            ]
          },
          "too-complex": {
            "matches": "boundary",
            "count": {
              "has": {
                "matches": "decision",
                "stopBy": {
                  "matches": "boundary"
                }
              },
              "min": 6,
              "as": "CCN",
              "offset": 1
            }
          },
          "named": {
            "any": [
              {
                "has": {
                  "field": "name",
                  "pattern": "$NAME"
                }
              },
              {
                "inside": {
                  "any": [
                    {
                      "kind": "variable_declarator"
                    },
                    {
                      "kind": "public_field_definition"
                    }
                  ],
                  "stopBy": "neighbor",
                  "has": {
                    "field": "name",
                    "pattern": "$NAME"
                  }
                }
              },
              {
                "inside": {
                  "kind": "pair",
                  "stopBy": "neighbor",
                  "has": {
                    "field": "key",
                    "pattern": "$NAME"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "too-complex",
      "forbid": {
        "ast": {
          "language": "vue",
          "embedded": "script-block",
          "rule": {
            "all": [
              {
                "matches": "too-complex"
              },
              {
                "matches": "named"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "CYCLOMATIC_COMPLEXITY",
        "message": "`$NAME` has cyclomatic complexity $CCN, over the ceiling of 6. Decompose it into smaller functions."
      }
    },
    {
      "id": "too-complex-anonymous",
      "forbid": {
        "ast": {
          "language": "vue",
          "embedded": "script-block",
          "rule": {
            "all": [
              {
                "matches": "too-complex"
              },
              {
                "not": {
                  "matches": "named"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "CYCLOMATIC_COMPLEXITY",
        "message": "This function has cyclomatic complexity $CCN, over the ceiling of 6. Decompose it into smaller functions."
      }
    }
  ]
}
