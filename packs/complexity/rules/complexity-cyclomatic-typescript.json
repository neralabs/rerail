{
  "format": "rerail.policy/v1",
  "id": "complexity-cyclomatic-typescript",
  "revision": 1,
  "mode": "steer",
  "description": "Keep TypeScript functions at cyclomatic complexity 6 or below, counting each if, loop, catch, case, ternary and && or ||; branch-heavy functions are hard to follow and test.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts",
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**"
    ]
  },
  "clauses": [
    {
      "id": "too-complex",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "matches": "boundary",
            "count": {
              "has": {
                "matches": "decision",
                "stopBy": {
                  "matches": "boundary"
                }
              },
              "min": 6,
              "as": "CCN",
              "offset": 1
            }
          },
          "utils": {
            "boundary": {
              "any": [
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "generator_function_declaration"
                }
              ]
            },
            "decision": {
              "any": [
                {
                  "kind": "if_statement"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "do_statement"
                },
                {
                  "kind": "catch_clause"
                },
                {
                  "kind": "switch_case"
                },
                {
                  "kind": "ternary_expression"
                },
                {
                  "kind": "binary_expression",
                  "has": {
                    "regex": "^(?:&&|\\|\\|)$"
                  }
                },
                {
                  "kind": "augmented_assignment_expression",
                  "has": {
                    "regex": "^(?:&&=|\\|\\|=)$"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "CYCLOMATIC_COMPLEXITY",
        "message": "Split this function into smaller ones or simplify its branching; its cyclomatic complexity is $CCN (limit 6)."
      }
    }
  ]
}
