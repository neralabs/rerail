{
  "format": "rerail.policy/v1",
  "id": "complexity-cyclomatic-javascript",
  "revision": 2,
  "mode": "steer",
  "description": "Keep JavaScript functions at cyclomatic complexity 6 or below, counting each if, loop, catch, switch, ternary and && or ||; branch-heavy functions are hard to follow and test.",
  "scope": {
    "include": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.js",
      "**/*.generated.jsx",
      "**/*.gen.js",
      "**/*.min.js",
      "**/*.test.*",
      "**/*.spec.*",
      "**/__tests__/**"
    ]
  },
  "clauses": [
    {
      "id": "complexity",
      "define": {
        "language": "javascript",
        "utils": {
          "boundary": {
            "any": [
              {
                "kind": "function_declaration"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "arrow_function"
              },
              {
                "kind": "method_definition"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "generator_function_declaration"
              }
            ]
          },
          "decision": {
            "any": [
              {
                "kind": "if_statement"
              },
              {
                "kind": "for_statement"
              },
              {
                "kind": "for_in_statement"
              },
              {
                "kind": "while_statement"
              },
              {
                "kind": "do_statement"
              },
              {
                "kind": "catch_clause"
              },
              {
                "kind": "switch_statement",
                "has": {
                  "kind": "switch_body",
                  "has": {
                    "kind": "switch_case"
                  }
                }
              },
              {
                "kind": "ternary_expression"
              },
              {
                "kind": "binary_expression",
                "has": {
                  "regex": "^(?:&&|\\|\\|)$"
                }
              },
              {
                "kind": "augmented_assignment_expression",
                "has": {
                  "regex": "^(?:&&=|\\|\\|=)$"
                }
              }
            ]
          },
          "too-complex": {
            "matches": "boundary",
            "count": {
              "has": {
                "matches": "decision",
                "stopBy": {
                  "matches": "boundary"
                }
              },
              "min": 6,
              "as": "CCN",
              "offset": 1
            }
          },
          "named": {
            "any": [
              {
                "has": {
                  "field": "name",
                  "pattern": "$NAME"
                }
              },
              {
                "inside": {
                  "kind": "variable_declarator",
                  "stopBy": "neighbor",
                  "has": {
                    "field": "name",
                    "pattern": "$NAME"
                  }
                }
              },
              {
                "inside": {
                  "kind": "field_definition",
                  "stopBy": "neighbor",
                  "has": {
                    "field": "property",
                    "pattern": "$NAME"
                  }
                }
              },
              {
                "inside": {
                  "kind": "pair",
                  "stopBy": "neighbor",
                  "has": {
                    "field": "key",
                    "pattern": "$NAME"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "too-complex",
      "forbid": {
        "ast": {
          "language": "javascript",
          "rule": {
            "all": [
              {
                "matches": "too-complex"
              },
              {
                "matches": "named"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "CYCLOMATIC_COMPLEXITY",
        "message": "`$NAME` has cyclomatic complexity $CCN, over the ceiling of 6. Decompose it into smaller functions."
      }
    },
    {
      "id": "too-complex-anonymous",
      "forbid": {
        "ast": {
          "language": "javascript",
          "rule": {
            "all": [
              {
                "matches": "too-complex"
              },
              {
                "not": {
                  "matches": "named"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "CYCLOMATIC_COMPLEXITY",
        "message": "This function has cyclomatic complexity $CCN, over the ceiling of 6. Decompose it into smaller functions."
      }
    }
  ]
}
