{
  "format": "rerail.policy/v1",
  "id": "complexity-cyclomatic-python",
  "revision": 2,
  "mode": "steer",
  "description": "Keep Python functions at cyclomatic complexity 6 or below, counting each if, elif, loop, except, case, and/or and comprehension clause; branch-heavy functions are hard to follow and test.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/.venv/**",
      "**/venv/**",
      "**/site-packages/**",
      "**/dist/**",
      "**/build/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/tests/**",
      "**/conftest.py"
    ]
  },
  "clauses": [
    {
      "id": "too-complex",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "all": [
              {
                "matches": "boundary",
                "count": {
                  "has": {
                    "matches": "decision",
                    "stopBy": {
                      "matches": "boundary"
                    }
                  },
                  "min": 6,
                  "as": "CCN",
                  "offset": 1
                }
              },
              {
                "has": {
                  "field": "name",
                  "pattern": "$NAME"
                }
              }
            ]
          },
          "utils": {
            "boundary": {
              "kind": "function_definition"
            },
            "decision": {
              "any": [
                {
                  "kind": "if_statement"
                },
                {
                  "kind": "elif_clause"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "except_clause"
                },
                {
                  "kind": "finally_clause"
                },
                {
                  "kind": "boolean_operator"
                },
                {
                  "kind": "conditional_expression"
                },
                {
                  "kind": "for_in_clause"
                },
                {
                  "kind": "if_clause"
                },
                {
                  "kind": "match_statement"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "CYCLOMATIC_COMPLEXITY",
        "message": "`$NAME` has cyclomatic complexity $CCN, over the ceiling of 6. Decompose it into smaller functions. If the branching is inherent, put `# rerail-ignore complexity-cyclomatic-python -- <reason>` on the line above it."
      }
    }
  ]
}
