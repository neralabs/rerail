{
  "format": "rerail.policy/v1",
  "id": "complexity-cyclomatic-python",
  "revision": 1,
  "mode": "steer",
  "description": "Keep Python functions at cyclomatic complexity 6 or below, counting each if, elif, loop, except, case, and/or and comprehension clause; branch-heavy functions are hard to follow and test.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/.venv/**",
      "**/venv/**",
      "**/site-packages/**",
      "**/dist/**",
      "**/build/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/test_*.py",
      "**/*_test.py",
      "**/tests/**",
      "**/conftest.py"
    ]
  },
  "clauses": [
    {
      "id": "too-complex",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "boundary",
            "count": {
              "has": {
                "matches": "decision",
                "stopBy": {
                  "matches": "boundary"
                }
              },
              "min": 6,
              "as": "CCN",
              "offset": 1
            }
          },
          "utils": {
            "boundary": {
              "kind": "function_definition"
            },
            "decision": {
              "any": [
                {
                  "kind": "if_statement"
                },
                {
                  "kind": "elif_clause"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "except_clause"
                },
                {
                  "kind": "finally_clause"
                },
                {
                  "kind": "boolean_operator"
                },
                {
                  "kind": "conditional_expression"
                },
                {
                  "kind": "for_in_clause"
                },
                {
                  "kind": "if_clause"
                },
                {
                  "kind": "case_clause"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "CYCLOMATIC_COMPLEXITY",
        "message": "Cyclomatic complexity $CCN (limit 6). Split this function into smaller ones or simplify its branching."
      }
    }
  ]
}
