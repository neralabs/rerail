    {"id": "complexity-cyclomatic-java", "upstream": {"tool": "lizard", "rule": "CYCLOMATIC_COMPLEXITY"}, "policy": "candidates/rules/complexity-cyclomatic-java.json", "capabilities": ["syntax"], "match": "line", "fixtures": ["java/**"], "lints": [".java"], "examples": {"caught": {"path": "src/main/java/com/example/Grade.java", "text": "class Grade {\n    String grade(int score, boolean late, boolean extra) {\n        if (score > 90 && !late) {\n            return \"A\";\n        }\n        if (score > 80 || extra) {\n            return \"B\";\n        }\n        if (score > 70) {\n            return \"C\";\n        }\n        for (int bonus : new int[] {1, 2}) {\n            if (bonus > score) {\n                return \"D\";\n            }\n        }\n        return \"F\";\n    }\n}\n"}, "passes": {"path": "src/main/java/com/example/Grade.java", "text": "class Grade {\n    String grade(int score, boolean late) {\n        if (late) {\n            return \"F\";\n        }\n        return score > 90 ? \"A\" : \"B\";\n    }\n}\n"}}}
