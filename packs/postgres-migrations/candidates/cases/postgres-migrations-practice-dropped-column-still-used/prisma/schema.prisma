generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  legacyRole String?
  nickname   String?
  posts      Post[]
  sessions   Session[]
}

model Post {
  id         String @id @default(cuid())
  title      String
  authorName String @map("author_name")
  authorId   String
  author     User   @relation(fields: [authorId], references: [id])

  @@map("posts")
}

model Session {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Account {
  id       String @id
  provider String
}

model Team {
  id   String @id
  tier String
}

/// @view
/// Per-user counts: a view since its table was dropped

model ModelStats {
  id    String @id
  count Int
}
