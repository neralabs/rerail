generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id
  email    String
  name     String?
  age      Int?
  bio      String?
  legacy   String?
}

model Post {
  id       String @id
  authorId String
}
