    .expect _ at "migrations/20261113160840_flag/migration.sql":1
.end

// Runtime code that sets a timeout for its own transaction and names no migrations folder (`cases/…/runner-runtime/`)
// does not run the migrations: reported.
.test runtime_timeout exactly uses repo
    .fixture "package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner-runtime/package.json"
    .fixture "migrations/20261113160840_flag/migration.sql" from "../cases/postgres-migrations-practice-lock-timeout/runner-runtime/migrations/20261113160840_flag/migration.sql"
    .fixture "src/jobs/archive.ts" from "../cases/postgres-migrations-practice-lock-timeout/runner-runtime/src/jobs/archive.ts"
    .expect _ at "migrations/20261113160840_flag/migration.sql":1
.end

// Another database's migrations (`cases/_other-databases/`), with statements every rule of the pack reports on a
// PostgreSQL table: Prisma folders whose schema declares `provider = "sqlite"` and `"mysql"` (no migration_lock.toml,
// no database named in the path, no backquoted names) and a Drizzle folder whose drizzle.config.ts declares
// `dialect: "sqlite"`. The ORM's declaration makes them another database's: nothing is reported.
.test other_databases exactly uses repo
    .given pgm_applied
    .fixture "apps/mobile/package.json" from "../cases/_other-databases/mobile/package.json"
