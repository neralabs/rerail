// A monorepo whose store package's runner (`cases/…/runner-other-package/packages/store/scripts/migrate.mjs`) sends
// `SET LOCAL lock_timeout = '${LOCK_TIMEOUT}'` and applies, besides its own `drizzle/`, the web app's
// `apps/web/drizzle`, named by a path that resolves to it (`join(HERE, "..", "..", "..", "apps", "web", "drizzle")`):
// both are left alone. The admin app's `drizzle/` shares only its last segment with them, from another package:
// reported.
.test runner_other_package exactly uses repo
    .fixture "package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner-other-package/package.json"
    .fixture "apps/web/package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner-other-package/apps/web/package.json"
    .fixture "apps/web/drizzle/0002_public_links.sql" from "../cases/postgres-migrations-practice-lock-timeout/runner-other-package/apps/web/drizzle/0002_public_links.sql"
    .fixture "apps/admin/package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner-other-package/apps/admin/package.json"
    .fixture "apps/admin/drizzle/0003_audit_note.sql" from "../cases/postgres-migrations-practice-lock-timeout/runner-other-package/apps/admin/drizzle/0003_audit_note.sql"
    .fixture "packages/store/package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner-other-package/packages/store/package.json"
    .fixture "packages/store/scripts/migrate.mjs" from "../cases/postgres-migrations-practice-lock-timeout/runner-other-package/packages/store/scripts/migrate.mjs"
    .fixture "packages/store/drizzle/0007_document_url.sql" from "../cases/postgres-migrations-practice-lock-timeout/runner-other-package/packages/store/drizzle/0007_document_url.sql"
    .expect _ at "apps/admin/drizzle/0003_audit_note.sql":2
.end

// A SQLite Prisma folder beside a PostgreSQL one (`cases/…/mixed-db/`): `prisma/schema.prisma` declares SQLite for
// `prisma/migrations`, and `prisma/postgresql/schema.prisma` PostgreSQL for `prisma/postgresql/migrations` only. The
// SQLite migration is left alone; the PostgreSQL one is reported.
.test mixed_databases exactly uses repo
    .fixture "prisma/schema.prisma" from "../cases/postgres-migrations-practice-lock-timeout/mixed-db/prisma/schema.prisma"
    .fixture "prisma/migrations/202608240003_payment_intent/migration.sql" from "../cases/postgres-migrations-practice-lock-timeout/mixed-db/prisma/migrations/202608240003_payment_intent/migration.sql"
    .fixture "prisma/postgresql/schema.prisma" from "../cases/postgres-migrations-practice-lock-timeout/mixed-db/prisma/postgresql/schema.prisma"
    .fixture "prisma/postgresql/migrations/202608240003_payment_intent/migration.sql" from "../cases/postgres-migrations-practice-lock-timeout/mixed-db/prisma/postgresql/migrations/202608240003_payment_intent/migration.sql"
    .expect _ at "prisma/postgresql/migrations/202608240003_payment_intent/migration.sql":1
.end

// The migration role gets its timeout from an earlier migration: nothing is reported.
.test role_timeout exactly uses repo
    .fixture "prisma/migrations/20260101000000_roles/migration.sql" ```
        ALTER ROLE app_migrator SET lock_timeout = '5s';
        ```
    .fixture "prisma/migrations/20261120093000_add_flag/migration.sql" ```
        -- AlterTable
        ALTER TABLE "User" ADD COLUMN "flag" BOOLEAN;
        ```
.end

// The connection URL sets it (`options=-c lock_timeout=…`): nothing is reported.
.test env_timeout exactly uses repo
    .fixture ".env.example" ```
        DATABASE_URL="postgresql://app:app@localhost:5432/app?options=-c%20lock_timeout%3D5s"
        ```
    .fixture "prisma/migrations/20261120093000_add_flag/migration.sql" ```
        -- AlterTable
        ALTER TABLE "User" ADD COLUMN "flag" BOOLEAN;
        ```
.end

// The same migration with neither: reported.
.test no_timeout exactly uses repo
    .fixture ".env.example" ```
        DATABASE_URL="postgresql://app:app@localhost:5432/app"
        ```
    .fixture "prisma/migrations/20261120093000_add_flag/migration.sql" ```
        -- AlterTable
        ALTER TABLE "User" ADD COLUMN "flag" BOOLEAN;
        ```
    .expect _ at "prisma/migrations/20261120093000_add_flag/migration.sql":2
.end

// `lock_timeout` set to 0 in the connection URL turns the timeout off: reported (`cases/…/config-zero/`).
.test zero_env_timeout exactly uses repo
    .fixture ".env.example" from "../cases/postgres-migrations-practice-lock-timeout/config-zero/.env.example"
    .fixture "prisma/migrations/20261120093000_add_flag/migration.sql" from "../cases/postgres-migrations-practice-lock-timeout/config-zero/prisma/migrations/20261120093000_add_flag/migration.sql"
    .expect _ at "prisma/migrations/20261120093000_add_flag/migration.sql":2
.end

// A monorepo (`cases/…/config-other-package/`): the web app's connection URL sets a timeout for the web app only, so
// the db package's migration is reported; the billing package sets PGOPTIONS for its own migrations, which are not.
.test other_package_timeout exactly uses repo
    .fixture "apps/web/package.json" from "../cases/postgres-migrations-practice-lock-timeout/config-other-package/apps/web/package.json"
    .fixture "apps/web/.env.example" from "../cases/postgres-migrations-practice-lock-timeout/config-other-package/apps/web/.env.example"
    .fixture "packages/db/package.json" from "../cases/postgres-migrations-practice-lock-timeout/config-other-package/packages/db/package.json"
    .fixture "packages/db/migrations/0002_flag.sql" from "../cases/postgres-migrations-practice-lock-timeout/config-other-package/packages/db/migrations/0002_flag.sql"
    .fixture "packages/billing/package.json" from "../cases/postgres-migrations-practice-lock-timeout/config-other-package/packages/billing/package.json"
    .fixture "packages/billing/.env.example" from "../cases/postgres-migrations-practice-lock-timeout/config-other-package/packages/billing/.env.example"
    .fixture "packages/billing/migrations/0002_due.sql" from "../cases/postgres-migrations-practice-lock-timeout/config-other-package/packages/billing/migrations/0002_due.sql"
    .expect _ at "packages/db/migrations/0002_flag.sql":1
.end

// A hosting platform's deploy file sets PGOPTIONS for the deploy (`cases/…/config-platform/render.yaml`): nothing is
// reported.
.test platform_timeout exactly uses repo
    .fixture "render.yaml" from "../cases/postgres-migrations-practice-lock-timeout/config-platform/render.yaml"
    .fixture "prisma/migrations/20261120093000_add_flag/migration.sql" from "../cases/postgres-migrations-practice-lock-timeout/config-platform/prisma/migrations/20261120093000_add_flag/migration.sql"
.end

// The app's own migration runner (`cases/…/runner/`): startup code in `apps/server` sends `SET lock_timeout = '5s'`
// before it migrates the root package's `migrations` folder, which it names, so the root migration is left alone. The
// billing package keeps its own migrations, which that runner does not run: reported.
.test runner_timeout exactly uses repo
    .fixture "package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner/package.json"
    .fixture "migrations/20261113160840_flag/migration.sql" from "../cases/postgres-migrations-practice-lock-timeout/runner/migrations/20261113160840_flag/migration.sql"
    .fixture "apps/server/package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner/apps/server/package.json"
    .fixture "apps/server/src/startup/database.ts" from "../cases/postgres-migrations-practice-lock-timeout/runner/apps/server/src/startup/database.ts"
    .fixture "packages/billing/package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner/packages/billing/package.json"
    .fixture "packages/billing/migrations/0002_due/migration.sql" from "../cases/postgres-migrations-practice-lock-timeout/runner/packages/billing/migrations/0002_due/migration.sql"
    .expect _ at "packages/billing/migrations/0002_due/migration.sql":1
.end

// The same runner sending `SET lock_timeout = '0'` (`cases/…/runner-zero/`) turns the timeout off: reported.
.test runner_zero_timeout exactly uses repo
    .fixture "package.json" from "../cases/postgres-migrations-practice-lock-timeout/runner-zero/package.json"
    .fixture "migrations/20261113160840_flag/migration.sql" from "../cases/postgres-migrations-practice-lock-timeout/runner-zero/migrations/20261113160840_flag/migration.sql"
