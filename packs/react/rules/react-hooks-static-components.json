{
  "format": "rerail.policy/v1",
  "id": "react-hooks-static-components",
  "revision": 1,
  "mode": "steer",
  "description": "Declare components at module level instead of creating them while a component or hook renders; a component created during render remounts and loses its state every render.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          },
          "utils": {
            "fn": {
              "any": [
                { "kind": "function_declaration" },
                { "kind": "generator_function_declaration" },
                { "kind": "function_expression" },
                { "kind": "generator_function" },
                { "kind": "arrow_function" },
                { "kind": "method_definition" }
              ]
            },
            "class-like": {
              "any": [
                { "kind": "class" },
                { "kind": "class_declaration" },
                { "kind": "abstract_class_declaration" }
              ]
            },
            "boundary": {
              "any": [
                { "matches": "fn" },
                { "matches": "class-like" }
              ]
            },
            "loop": {
              "any": [
                { "kind": "for_statement" },
                { "kind": "for_in_statement" },
                { "kind": "while_statement" },
                { "kind": "do_statement" }
              ]
            },
            "first-argument": {
              "nthChild": { "position": 1, "ofRule": { "not": { "kind": "comment" } } }
            },
            "gate-name": {
              "regex": "^(?:[A-Z]|use[A-Z0-9])"
            },
            "gate-fn-value": {
              "any": [
                { "kind": "arrow_function" },
                { "kind": "function_expression" },
                { "kind": "generator_function" },
                {
                  "kind": "parenthesized_expression",
                  "has": { "stopBy": "neighbor", "matches": "gate-fn-value" }
                }
              ]
            },
            "gate-declaration": {
              "any": [
                {
                  "any": [
                    { "kind": "function_declaration" },
                    { "kind": "generator_function_declaration" }
                  ],
                  "has": { "field": "name", "matches": "gate-name" }
                },
                {
                  "any": [
                    { "kind": "lexical_declaration" },
                    { "kind": "variable_declaration" }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "variable_declarator",
                    "all": [
                      { "has": { "field": "name", "kind": "identifier", "matches": "gate-name" } },
                      { "has": { "field": "value", "matches": "gate-fn-value" } }
                    ]
                  }
                }
              ]
            },
            "gated-file": {
              "inside": {
                "stopBy": "end",
                "kind": "program",
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    { "matches": "gate-declaration" },
                    {
                      "kind": "export_statement",
                      "any": [
                        { "has": { "field": "declaration", "matches": "gate-declaration" } },
                        { "has": { "field": "value", "matches": "gate-fn-value" } }
                      ]
                    }
                  ]
                }
              }
            },
            "hook-call": {
              "kind": "call_expression",
              "has": {
                "field": "function",
                "any": [
                  { "kind": "identifier", "regex": "^use[A-Z0-9]" },
                  {
                    "kind": "member_expression",
                    "all": [
                      { "has": { "field": "object", "kind": "identifier", "regex": "^[A-Z]" } },
                      { "has": { "field": "property", "kind": "property_identifier", "regex": "^use[A-Z0-9]" } }
                    ]
                  }
                ]
              }
            },
            "own-jsx-or-hook": {
              "has": {
                "stopBy": { "any": [{ "kind": "function_declaration" }, { "kind": "generator_function_declaration" }, { "kind": "function_expression" }, { "kind": "generator_function" }, { "kind": "arrow_function" }, { "kind": "method_definition" }, { "kind": "class" }, { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
                "any": [
                  { "kind": "jsx_element" },
                  { "kind": "jsx_self_closing_element" },
                  { "matches": "hook-call" }
                ]
              }
            },
            "component-declarator": {
              "kind": "variable_declarator",
              "has": { "field": "name", "kind": "identifier", "regex": "^[A-Z]" }
            },
            "hook-declarator": {
              "kind": "variable_declarator",
              "has": { "field": "name", "kind": "identifier", "regex": "^use[A-Z0-9]" }
            },
            "in-component-declarator": {
              "any": [
                { "inside": { "field": "value", "matches": "component-declarator" } },
                { "inside": { "kind": "parenthesized_expression", "matches": "in-component-declarator" } }
              ]
            },
            "in-hook-declarator": {
              "any": [
                { "inside": { "field": "value", "matches": "hook-declarator" } },
                { "inside": { "kind": "parenthesized_expression", "matches": "in-hook-declarator" } }
              ]
            },
            "component-named": {
              "any": [
                { "kind": "function_declaration", "has": { "field": "name", "regex": "^[A-Z]" } },
                {
                  "any": [
                    { "kind": "function_expression" },
                    { "kind": "arrow_function" }
                  ],
                  "matches": "in-component-declarator"
                }
              ]
            },
            "hook-named": {
              "any": [
                { "kind": "function_declaration", "has": { "field": "name", "regex": "^use[A-Z0-9]" } },
                {
                  "any": [
                    { "kind": "function_expression" },
                    { "kind": "arrow_function" }
                  ],
                  "matches": "in-hook-declarator"
                }
              ]
            },
            "memo-callback": {
              "any": [
                { "kind": "function_expression" },
                { "kind": "arrow_function" }
              ],
              "inside": {
                "kind": "arguments",
                "inside": {
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "any": [
                      { "kind": "identifier", "regex": "^(?:memo|forwardRef)$" },
                      {
                        "kind": "member_expression",
                        "all": [
                          { "has": { "field": "object", "kind": "identifier", "regex": "^React$" } },
                          { "has": { "field": "property", "regex": "^(?:memo|forwardRef)$" } }
                        ]
                      }
                    ]
                  }
                }
              }
            },
            "unset-default": {
              "not": { "has": { "field": "value", "regex": "[\\s\\S]" } }
            },
            "non-props-annotation": {
              "any": [
                { "kind": "required_parameter" },
                { "kind": "optional_parameter" }
              ],
              "matches": "unset-default",
              "has": {
                "field": "type",
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    { "kind": "array_type" },
                    { "kind": "tuple_type" },
                    { "kind": "function_type" },
                    { "kind": "constructor_type" },
                    { "kind": "literal_type", "not": { "regex": "^(?:null|undefined)$" } },
                    { "kind": "predefined_type", "regex": "^(?:bigint|boolean|number|string|symbol|never)$" }
                  ]
                }
              }
            },
            "rest-parameter": {
              "any": [
                { "kind": "rest_pattern" },
                { "kind": "required_parameter", "has": { "field": "pattern", "kind": "rest_pattern" } }
              ]
            },
            "ref-parameter": {
              "any": [
                { "kind": "identifier", "regex": "ref|Ref" },
                {
                  "any": [
                    { "kind": "required_parameter" },
                    { "kind": "optional_parameter" }
                  ],
                  "matches": "unset-default",
                  "has": { "field": "pattern", "kind": "identifier", "regex": "ref|Ref" }
                }
              ]
            },
            "component-parameters": {
              "any": [
                { "kind": "arrow_function", "has": { "field": "parameter", "kind": "identifier" } },
                {
                  "has": {
                    "field": "parameters",
                    "all": [
                      {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "nthChild": { "position": 3, "ofRule": { "not": { "kind": "comment" } } }
                          }
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "matches": "first-argument",
                            "any": [
                              { "matches": "rest-parameter" },
                              { "matches": "non-props-annotation" }
                            ]
                          }
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "nthChild": { "position": 2, "ofRule": { "not": { "kind": "comment" } } },
                            "not": { "matches": "ref-parameter" }
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "non-node": {
              "any": [
                { "kind": "object" },
                { "kind": "arrow_function" },
                { "kind": "function_expression" },
                { "kind": "generator_function" },
                { "kind": "class" },
                { "kind": "new_expression" },
                { "kind": "number", "regex": "n$" },
                {
                  "kind": "parenthesized_expression",
                  "has": { "stopBy": "neighbor", "matches": "non-node" }
                }
              ]
            },
            "holds-own-return": {
              "any": [
                { "kind": "return_statement" },
                {
                  "not": { "matches": "boundary" },
                  "has": {
                    "stopBy": { "any": [{ "kind": "function_declaration" }, { "kind": "generator_function_declaration" }, { "kind": "function_expression" }, { "kind": "generator_function" }, { "kind": "arrow_function" }, { "kind": "method_definition" }, { "kind": "class" }, { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
                    "kind": "return_statement"
                  }
                }
              ]
            },
            "last-own-return": {
              "kind": "return_statement",
              "not": {
                "any": [
                  { "precedes": { "stopBy": "end", "matches": "holds-own-return" } },
                  {
                    "inside": {
                      "stopBy": { "matches": "boundary" },
                      "not": { "matches": "boundary" },
                      "precedes": { "stopBy": "end", "matches": "holds-own-return" }
                    }
                  }
                ]
              }
            },
            "returns-non-node": {
              "any": [
                { "kind": "arrow_function", "has": { "field": "body", "matches": "non-node" } },
                {
                  "has": {
                    "stopBy": { "any": [{ "kind": "function_declaration" }, { "kind": "generator_function_declaration" }, { "kind": "function_expression" }, { "kind": "generator_function" }, { "kind": "arrow_function" }, { "kind": "method_definition" }, { "kind": "class" }, { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
                    "kind": "return_statement",
                    "all": [
                      {
                        "any": [
                          { "regex": "^return\\s*;?$" },
                          { "has": { "stopBy": "neighbor", "matches": "non-node" } }
                        ]
                      },
                      { "matches": "last-own-return" }
                    ]
                  }
                }
              ]
            },
            "component-like": {
              "any": [
                {
                  "all": [
                    { "matches": "component-named" },
                    { "matches": "own-jsx-or-hook" },
                    { "matches": "component-parameters" },
                    { "not": { "matches": "returns-non-node" } }
                  ]
                },
                { "all": [{ "matches": "hook-named" }, { "matches": "own-jsx-or-hook" }] },
                { "all": [{ "matches": "memo-callback" }, { "matches": "own-jsx-or-hook" }] }
              ]
            },
            "compiled-fn": {
              "all": [
                { "matches": "component-like" },
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "any": [
                        { "matches": "class-like" },
                        { "matches": "component-like" }
                      ]
                    }
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "catch_clause",
                      "has": {
                        "field": "parameter",
                        "any": [
                          { "kind": "object_pattern" },
                          { "kind": "array_pattern" }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "memo-call-in-render": {
              "kind": "call_expression",
              "has": {
                "field": "function",
                "any": [
                  { "kind": "identifier", "regex": "^useMemo$" },
                  {
                    "kind": "member_expression",
                    "all": [
                      { "has": { "field": "object", "kind": "identifier", "regex": "^React$" } },
                      { "has": { "field": "property", "regex": "^useMemo$" } }
                    ]
                  }
                ]
              },
              "inside": { "stopBy": { "matches": "boundary" }, "matches": "compiled-fn" }
            },
            "listed-statement": {
              "inside": {
                "any": [
                  { "kind": "statement_block" },
                  { "kind": "switch_case" },
                  { "kind": "switch_default" },
                  { "kind": "program" }
                ]
              }
            },
            "logical-operator": {
              "has": { "field": "operator", "regex": "^(?:&&|\\|\\||\\?\\?)=?$" }
            },
            "control-flow": {
              "any": [
                { "kind": "if_statement" },
                { "kind": "switch_statement" },
                { "kind": "for_statement" },
                { "kind": "for_in_statement" },
                { "kind": "while_statement" },
                { "kind": "do_statement" },
                { "kind": "try_statement" },
                { "kind": "labeled_statement" },
                { "kind": "ternary_expression" },
                { "kind": "sequence_expression" },
                { "kind": "optional_chain" },
                { "kind": "object_assignment_pattern" },
                { "kind": "assignment_pattern" },
                { "kind": "binary_expression", "matches": "logical-operator" },
                { "kind": "augmented_assignment_expression", "matches": "logical-operator" }
              ]
            },
            "holds-control-flow": {
              "any": [
                { "matches": "control-flow" },
                {
                  "not": { "matches": "boundary" },
                  "has": {
                    "stopBy": { "any": [{ "kind": "function_declaration" }, { "kind": "generator_function_declaration" }, { "kind": "function_expression" }, { "kind": "generator_function" }, { "kind": "arrow_function" }, { "kind": "method_definition" }, { "kind": "class" }, { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
                    "matches": "control-flow"
                  }
                }
              ]
            },
            "in-value-block": {
              "inside": {
                "stopBy": { "any": [{ "matches": "boundary" }, { "matches": "listed-statement" }] },
                "any": [
                  { "kind": "ternary_expression" },
                  { "kind": "sequence_expression" },
                  { "kind": "binary_expression", "matches": "logical-operator" }
                ]
              }
            },
            "no-arguments": {
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "nthChild": { "position": 1, "ofRule": { "not": { "kind": "comment" } } }
                }
              }
            },
            "inlined-iife": {
              "kind": "call_expression",
              "has": {
                "field": "function",
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    { "kind": "arrow_function" },
                    { "kind": "function_expression" }
                  ],
                  "not": { "regex": "^async" },
                  "has": { "field": "parameters", "matches": "no-arguments" }
                }
              },
              "all": [
                { "has": { "field": "arguments", "kind": "arguments", "matches": "no-arguments" } },
                { "inside": { "stopBy": { "matches": "boundary" }, "matches": "compiled-fn" } },
                { "not": { "matches": "in-value-block" } }
              ]
            },
            "memo-candidate": {
              "matches": "memo-call-in-render",
              "has": {
                "field": "arguments",
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "first-argument",
                      "any": [
                        { "kind": "arrow_function" },
                        { "kind": "function_expression" }
                      ]
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "nthChild": { "position": 2, "ofRule": { "not": { "kind": "comment" } } },
                        "not": { "kind": "array" }
                      }
                    }
                  }
                ]
              }
            },
            "inlinable-call": {
              "any": [
                { "matches": "memo-candidate" },
                { "matches": "inlined-iife" }
              ]
            },
            "inlined-call": {
              "any": [
                { "matches": "inlined-memo-call" },
                { "matches": "inlined-iife" }
              ]
            },
            "ends-with-inlined-call": {
              "not": {
                "any": [
                  { "matches": "boundary" },
                  { "matches": "control-flow" }
                ]
              },
              "has": {
                "stopBy": { "any": [{ "kind": "function_declaration" }, { "kind": "generator_function_declaration" }, { "kind": "function_expression" }, { "kind": "generator_function" }, { "kind": "arrow_function" }, { "kind": "method_definition" }, { "kind": "class" }, { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
                "matches": "inlined-call"
              },
              "all": [
                {
                  "not": {
                    "has": {
                      "stopBy": { "any": [{ "kind": "function_declaration" }, { "kind": "generator_function_declaration" }, { "kind": "function_expression" }, { "kind": "generator_function" }, { "kind": "arrow_function" }, { "kind": "method_definition" }, { "kind": "class" }, { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
                      "matches": "control-flow",
                      "not": { "inside": { "stopBy": { "matches": "boundary" }, "matches": "inlinable-call" } }
                    }
                  }
                }
              ]
            },
            "relevant-statement": {
              "not": { "matches": "boundary" },
              "any": [
                { "matches": "holds-control-flow" },
                {
                  "has": {
                    "stopBy": { "any": [{ "kind": "function_declaration" }, { "kind": "generator_function_declaration" }, { "kind": "function_expression" }, { "kind": "generator_function" }, { "kind": "arrow_function" }, { "kind": "method_definition" }, { "kind": "class" }, { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
                    "matches": "inlinable-call"
                  }
                }
              ]
            },
            "memo-blocked": {
              "all": [
                {
                  "has": {
                    "field": "arguments",
                    "has": {
                      "stopBy": "neighbor",
                      "nthChild": { "position": 2, "ofRule": { "not": { "kind": "comment" } } },
                      "matches": "holds-control-flow"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": { "any": [{ "matches": "boundary" }, { "matches": "listed-statement" }] },
                    "matches": "listed-statement",
                    "follows": { "stopBy": { "matches": "relevant-statement" }, "matches": "ends-with-inlined-call" }
                  }
                }
              ]
            },
            "inlined-memo-call": {
              "matches": "memo-candidate",
              "not": { "matches": "memo-blocked" }
            },
            "inlined-memo-callback": {
              "any": [
                { "kind": "arrow_function" },
                { "kind": "function_expression" }
              ],
              "matches": "first-argument",
              "inside": {
                "kind": "arguments",
                "inside": { "matches": "inlined-memo-call" }
              }
            },
            "discarded": {
              "any": [
                { "inside": { "kind": "expression_statement" } },
                {
                  "inside": {
                    "field": "value",
                    "kind": "variable_declarator",
                    "has": { "field": "name", "kind": "identifier", "binds": { "used": false } }
                  }
                },
                {
                  "inside": {
                    "any": [
                      { "kind": "parenthesized_expression" },
                      { "kind": "jsx_element" },
                      { "kind": "jsx_opening_element" },
                      { "kind": "jsx_self_closing_element" },
                      { "kind": "jsx_expression" },
                      { "kind": "jsx_attribute" },
                      { "kind": "array" },
                      { "kind": "object" },
                      { "kind": "pair" },
                      { "kind": "spread_element" },
                      { "kind": "as_expression" },
                      { "kind": "satisfies_expression" },
                      { "kind": "non_null_expression" }
                    ],
                    "matches": "discarded"
                  }
                }
              ]
            },
            "render-owned": {
              "inside": {
                "stopBy": { "matches": "boundary" },
                "any": [
                  { "matches": "compiled-fn" },
                  { "matches": "inlined-memo-callback" }
                ]
              }
            },
            "returns-dynamic": {
              "params": ["T"],
              "rule": {
                "any": [
                  {
                    "has": {
                      "field": "body",
                      "not": { "kind": "statement_block" },
                      "matches": { "dynamic": { "T": "$T" } }
                    }
                  },
                  {
                    "has": {
                      "field": "body",
                      "kind": "statement_block",
                      "has": {
                        "stopBy": { "any": [{ "kind": "function_declaration" }, { "kind": "generator_function_declaration" }, { "kind": "function_expression" }, { "kind": "generator_function" }, { "kind": "arrow_function" }, { "kind": "method_definition" }, { "kind": "class" }, { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" }] },
                        "kind": "return_statement",
                        "has": { "stopBy": "neighbor", "matches": { "dynamic": { "T": "$T" } } }
                      }
                    }
                  }
                ]
              }
            },
            "dynamic": {
              "params": ["T"],
              "rule": {
                "any": [
                  {
                    "kind": "call_expression",
                    "not": {
                      "any": [
                        { "has": { "field": "arguments", "kind": "template_string" } },
                        { "matches": "inlined-memo-call" },
                        { "matches": "inlined-iife" }
                      ]
                    }
                  },
                  {
                    "matches": "inlined-memo-call",
                    "has": {
                      "field": "arguments",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "first-argument",
                        "all": [{ "matches": { "returns-dynamic": { "T": "$T" } } }]
                      }
                    }
                  },
                  {
                    "matches": "inlined-iife",
                    "has": {
                      "field": "function",
                      "has": { "stopBy": "neighbor", "matches": { "returns-dynamic": { "T": "$T" } } }
                    }
                  },
                  { "kind": "new_expression" },
                  { "kind": "arrow_function" },
                  { "kind": "function_expression" },
                  {
                    "any": [
                      { "kind": "parenthesized_expression" },
                      { "kind": "non_null_expression" }
                    ],
                    "has": { "stopBy": "neighbor", "matches": { "dynamic": { "T": "$T" } } }
                  },
                  {
                    "kind": "sequence_expression",
                    "has": {
                      "stopBy": "neighbor",
                      "nthChild": { "position": 1, "reverse": true, "ofRule": { "not": { "kind": "comment" } } },
                      "matches": { "dynamic": { "T": "$T" } }
                    }
                  },
                  {
                    "kind": "ternary_expression",
                    "any": [
                      { "has": { "field": "consequence", "matches": { "dynamic": { "T": "$T" } } } },
