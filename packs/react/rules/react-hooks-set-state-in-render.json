{
  "format": "rerail.policy/v1",
  "id": "react-hooks-set-state-in-render",
  "revision": 1,
  "mode": "steer",
  "description": "Don't call a state setter unconditionally while a component or hook renders, or inside a useMemo callback; each call can start an infinite render loop.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "fn-like": {
            "any": [
              {
                "kind": "function_declaration"
              },
              {
                "kind": "generator_function_declaration"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "arrow_function"
              },
              {
                "kind": "method_definition"
              }
            ]
          },
          "fn-stop": {
            "any": [
              {
                "matches": "fn-like"
              },
              {
                "kind": "class_body"
              }
            ]
          },
          "react-name": {
            "kind": "identifier",
            "regex": "^(?:[A-Z]|use[A-Z0-9])"
          },
          "component-name": {
            "kind": "identifier",
            "regex": "^[A-Z]"
          },
          "hook-name": {
            "kind": "identifier",
            "regex": "^use[A-Z0-9]"
          },
          "fn-value": {
            "any": [
              {
                "kind": "arrow_function"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              }
            ]
          },
          "react-declarator": {
            "kind": "variable_declarator",
            "all": [
              {
                "has": {
                  "field": "name",
                  "matches": "react-name"
                }
              },
              {
                "has": {
                  "field": "value",
                  "matches": "fn-value"
                }
              }
            ]
          },
          "react-top-level": {
            "any": [
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "generator_function_declaration"
                  }
                ],
                "has": {
                  "field": "name",
                  "matches": "react-name"
                }
              },
              {
                "any": [
                  {
                    "kind": "lexical_declaration"
                  },
                  {
                    "kind": "variable_declaration"
                  }
                ],
                "has": {
                  "matches": "react-declarator"
                }
              }
            ]
          },
          "react-file": {
            "kind": "program",
            "has": {
              "any": [
                {
                  "matches": "react-top-level"
                },
                {
                  "kind": "export_statement",
                  "has": {
                    "field": "declaration",
                    "matches": "react-top-level"
                  }
                },
                {
                  "kind": "export_statement",
                  "has": {
                    "field": "value",
                    "matches": "fn-value"
                  }
                }
              ]
            }
          },
          "named-component": {
            "any": [
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "generator_function_declaration"
                  }
                ],
                "has": {
                  "field": "name",
                  "matches": "component-name"
                }
              },
              {
                "matches": "fn-value",
                "inside": {
                  "kind": "variable_declarator",
                  "field": "value",
                  "has": {
                    "field": "name",
                    "matches": "component-name"
                  }
                }
              }
            ]
          },
          "named-hook": {
            "any": [
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "generator_function_declaration"
                  }
                ],
                "has": {
                  "field": "name",
                  "matches": "hook-name"
                }
              },
              {
                "matches": "fn-value",
                "inside": {
                  "kind": "variable_declarator",
                  "field": "value",
                  "has": {
                    "field": "name",
                    "matches": "hook-name"
                  }
                }
              }
            ]
          },
          "memo-callee": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^(?:memo|forwardRef)$"
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "regex": "^React$"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "kind": "property_identifier",
                      "regex": "^(?:memo|forwardRef)$"
                    }
                  }
                ]
              }
            ]
          },
          "memo-component": {
            "any": [
              {
                "kind": "arrow_function"
              },
              {
                "kind": "function_expression"
              }
            ],
            "inside": {
              "kind": "arguments",
              "inside": {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "memo-callee"
                }
              }
            }
          },
          "outer-compiled": {
            "all": [
              {
                "any": [
                  {
                    "matches": "named-component"
                  },
                  {
                    "matches": "named-hook"
                  },
                  {
                    "matches": "memo-component"
                  }
                ]
              },
              {
                "has": {
                  "stopBy": {
                    "any": [
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "generator_function_declaration"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "arrow_function"
                      }
                    ]
                  },
                  "any": [
                    {
                      "kind": "jsx_element"
                    },
                    {
                      "kind": "jsx_self_closing_element"
                    },
                    {
                      "kind": "call_expression",
                      "has": {
                        "field": "function",
                        "any": [
                          {
                            "matches": "hook-name"
                          },
                          {
                            "kind": "member_expression",
                            "all": [
                              {
                                "has": {
                                  "field": "object",
                                  "kind": "identifier",
                                  "regex": "^[A-Z]"
                                }
                              },
                              {
                                "has": {
                                  "field": "property",
                                  "kind": "property_identifier",
                                  "regex": "^use[A-Z0-9]"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          },
          "param": {
            "any": [
              {
                "kind": "required_parameter"
              },
              {
                "kind": "optional_parameter"
              },
              {
                "kind": "identifier"
              },
              {
                "kind": "object_pattern"
              },
              {
                "kind": "array_pattern"
              },
              {
                "kind": "assignment_pattern"
              },
              {
                "kind": "rest_pattern"
              }
            ]
          },
          "rest-param": {
            "any": [
              {
                "kind": "rest_pattern"
              },
              {
                "kind": "required_parameter",
                "has": {
                  "kind": "rest_pattern"
                }
              }
            ]
          },
          "ref-param": {
            "any": [
              {
                "kind": "identifier",
                "regex": "ref|Ref"
              },
              {
                "any": [
                  {
                    "kind": "required_parameter"
                  },
                  {
                    "kind": "optional_parameter"
                  }
                ],
                "all": [
                  {
                    "has": {
                      "field": "pattern",
                      "kind": "identifier",
                      "regex": "ref|Ref"
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "field": "value",
                        "regex": "[\\s\\S]"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "primitive-props": {
            "not": {
              "has": {
                "field": "value",
                "regex": "[\\s\\S]"
              }
            },
            "has": {
              "field": "type",
              "kind": "type_annotation",
              "has": {
                "any": [
                  {
                    "kind": "array_type"
                  },
                  {
                    "kind": "tuple_type"
                  },
                  {
                    "kind": "function_type"
                  },
                  {
                    "kind": "constructor_type"
                  },
                  {
                    "kind": "literal_type"
                  },
                  {
                    "kind": "predefined_type",
                    "regex": "^(?:number|string|boolean|symbol|bigint|never)$"
                  }
                ]
              }
            }
          },
          "first-param-ok": {
            "not": {
              "has": {
                "nthChild": {
                  "position": 1,
                  "ofRule": {
                    "matches": "param"
                  }
                },
                "matches": "primitive-props"
              }
            }
          },
          "component-params": {
            "any": [
              {
                "has": {
                  "field": "parameter",
                  "kind": "identifier"
                }
              },
              {
                "not": {
                  "has": {
                    "field": "parameters",
                    "has": {
                      "matches": "param"
                    }
                  }
                }
              },
              {
                "has": {
                  "field": "parameters",
                  "all": [
                    {
                      "count": {
                        "has": {
                          "matches": "param"
                        },
                        "min": 1,
                        "max": 1
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "matches": "rest-param"
                        }
                      }
                    },
                    {
                      "matches": "first-param-ok"
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "parameters",
                  "all": [
                    {
                      "count": {
                        "has": {
                          "matches": "param"
                        },
                        "min": 2,
                        "max": 2
                      }
                    },
                    {
                      "has": {
                        "nthChild": {
                          "position": 2,
                          "ofRule": {
                            "matches": "param"
                          }
                        },
                        "matches": "ref-param"
                      }
                    },
                    {
                      "matches": "first-param-ok"
                    }
                  ]
                }
              }
            ]
          },
          "non-node": {
            "any": [
              {
                "kind": "object"
              },
              {
                "kind": "arrow_function"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "class"
              },
              {
                "kind": "new_expression"
              },
              {
                "kind": "number",
                "regex": "n$"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "non-node"
                }
              }
            ]
          },
          "returns-non-node": {
            "any": [
              {
                "kind": "arrow_function",
                "has": {
                  "field": "body",
                  "matches": "non-node"
                }
              },
              {
                "has": {
                  "stopBy": {
                    "matches": "fn-stop"
                  },
                  "kind": "return_statement",
                  "any": [
                    {
                      "regex": "^return\\s*;?$"
                    },
                    {
                      "has": {
                        "matches": "non-node"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "compiled-fn": {
            "all": [
              {
                "any": [
                  {
                    "matches": "named-hook"
                  },
                  {
                    "matches": "memo-component"
                  },
                  {
                    "all": [
                      {
                        "matches": "named-component"
                      },
                      {
                        "matches": "component-params"
                      },
                      {
                        "not": {
                          "matches": "returns-non-node"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "class_body"
                      },
                      {
                        "matches": "outer-compiled"
                      }
                    ]
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "matches": "react-file"
                }
              }
            ]
          },
          "react-module": {
            "kind": "import_specifier",
            "inside": {
              "stopBy": "end",
              "kind": "import_statement",
              "has": {
                "field": "source",
                "kind": "string",
                "value": {
                  "eq": "react"
                }
              }
            }
          },
          "use-state-callee": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^useState$",
                "resolves": {
                  "unresolved": true
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "site": {
                      "matches": "react-module",
                      "has": {
                        "field": "name",
                        "regex": "^useState$"
                      }
                    }
                  }
                }
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "regex": "^React$"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "kind": "property_identifier",
                      "regex": "^useState$"
                    }
                  }
                ]
              }
            ]
          },
          "use-memo-callee": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^useMemo$",
                "resolves": {
                  "unresolved": true
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "site": {
                      "matches": "react-module",
                      "has": {
                        "field": "name",
                        "regex": "^useMemo$"
                      }
                    }
                  }
                }
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "regex": "^React$"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "kind": "property_identifier",
                      "regex": "^useMemo$"
                    }
                  }
                ]
              }
            ]
          },
          "state-call": {
            "any": [
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "use-state-callee"
                }
              },
              {
                "any": [
                  {
                    "kind": "as_expression"
                  },
                  {
                    "kind": "satisfies_expression"
                  },
                  {
                    "kind": "non_null_expression"
                  },
                  {
                    "kind": "parenthesized_expression"
                  }
                ],
                "has": {
                  "nthChild": 1,
                  "matches": "state-call"
                }
              }
            ]
          },
          "reassigned": {
            "resolves": {
              "binding": {
                "occurrence": {
                  "inside": {
                    "field": "left",
                    "any": [
                      {
                        "kind": "assignment_expression"
                      },
                      {
                        "kind": "augmented_assignment_expression"
                      }
                    ]
                  }
                }
              }
            }
          },
          "state-setter": {
            "kind": "identifier",
            "pattern": "$SETR",
            "all": [
              {
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "variable_declarator",
                      "all": [
                        {
                          "has": {
                            "field": "name",
                            "kind": "array_pattern",
                            "has": {
                              "kind": "identifier",
                              "pattern": "$SETN",
                              "compare": {
                                "left": "SETN",
                                "op": "eq",
                                "right": "SETR",
                                "text": "source"
                              },
                              "follows": {
                                "stopBy": "neighbor",
                                "regex": "^,$",
                                "not": {
                                  "follows": {
                                    "stopBy": "end",
                                    "regex": "^,$"
                                  }
                                }
                              }
                            }
                          }
                        },
                        {
                          "has": {
                            "field": "value",
                            "matches": "state-call"
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "not": {
                  "matches": "reassigned"
                }
              }
            ]
          },
          "logical-operand": {
            "any": [
              {
                "inside": {
                  "field": "right",
                  "kind": "binary_expression",
                  "has": {
                    "field": "operator",
                    "regex": "^(?:&&|\\|\\||\\?\\?)$"
                  }
                }
              },
              {
                "inside": {
                  "field": "right",
                  "kind": "augmented_assignment_expression",
                  "has": {
                    "field": "operator",
                    "regex": "^(?:&&=|\\|\\|=|\\?\\?=)$"
                  }
                }
              },
              {
                "inside": {
                  "field": "right",
                  "any": [
                    {
                      "kind": "assignment_pattern"
                    },
                    {
                      "kind": "object_assignment_pattern"
                    }
                  ]
                }
              }
            ]
          },
          "optional-link": {
            "any": [
              {
                "kind": "call_expression"
              },
              {
                "kind": "member_expression"
              },
              {
                "kind": "subscript_expression"
              }
            ],
            "all": [
              {
                "any": [
                  {
                    "has": {
                      "kind": "optional_chain"
                    }
                  },
                  {
                    "has": {
                      "regex": "^\\?\\.$"
                    }
                  },
                  {
                    "has": {
                      "field": "function",
                      "has": {
                        "stopBy": "end",
                        "kind": "optional_chain"
                      }
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "has": {
                        "stopBy": "end",
                        "kind": "optional_chain"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "conditional-position": {
            "not": {
              "matches": "fn-like"
            },
            "any": [
              {
                "matches": "logical-operand"
              },
              {
                "matches": "optional-link"
              }
            ]
          },
          "conditional-construct": {
            "any": [
              {
                "kind": "if_statement"
              },
              {
                "kind": "for_statement"
              },
              {
                "kind": "for_in_statement"
              },
              {
                "kind": "while_statement"
              },
              {
                "kind": "do_statement"
              },
              {
                "kind": "try_statement"
              },
              {
                "kind": "switch_statement"
              },
              {
                "kind": "with_statement"
              },
              {
                "kind": "ternary_expression"
              },
              {
                "kind": "statement_block",
                "not": {
                  "inside": {
                    "matches": "fn-like"
                  }
                }
              }
            ]
          },
          "contains-return": {
            "any": [
              {
                "kind": "return_statement"
              },
              {
                "all": [
                  {
                    "not": {
                      "matches": "fn-stop"
                    }
                  },
                  {
                    "has": {
                      "stopBy": {
                        "matches": "fn-stop"
                      },
                      "kind": "return_statement"
                    }
                  }
                ]
              }
            ]
          },
          "body-statement": {
            "all": [
              {
                "not": {
                  "matches": "fn-stop"
                }
              },
              {
                "inside": {
                  "kind": "statement_block",
                  "inside": {
                    "matches": "fn-like"
                  }
                }
              },
              {
                "not": {
                  "follows": {
                    "stopBy": "end",
                    "matches": "contains-return"
                  }
                }
              }
            ]
          },
          "unconditional": {
            "all": [
              {
                "not": {
                  "matches": "conditional-position"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": {
                      "matches": "fn-stop"
                    },
                    "any": [
                      {
                        "matches": "conditional-construct"
                      },
                      {
                        "matches": "conditional-position"
                      }
                    ]
                  }
                }
              },
              {
                "any": [
                  {
                    "inside": {
                      "stopBy": {
                        "matches": "fn-stop"
                      },
                      "matches": "body-statement"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "matches": "fn-stop"
                      },
                      "kind": "arrow_function",
                      "has": {
                        "field": "body",
                        "not": {
                          "kind": "statement_block"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "setter-call": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "matches": "state-setter"
            }
          },
          "calls-setter-unconditionally": {
            "has": {
              "stopBy": {
                "matches": "fn-stop"
              },
              "matches": "setter-call",
              "all": [
                {
                  "matches": "unconditional"
                }
              ]
            }
          },
          "setter-function": {
            "kind": "identifier",
            "all": [
              {
                "resolves": {
                  "binding": {
                    "site": {
                      "any": [
                        {
                          "kind": "function_declaration",
                          "matches": "calls-setter-unconditionally"
                        },
                        {
                          "kind": "variable_declarator",
                          "has": {
                            "field": "value",
                            "any": [
                              {
                                "kind": "arrow_function"
                              },
                              {
                                "kind": "function_expression"
                              }
                            ],
                            "matches": "calls-setter-unconditionally"
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "not": {
                  "matches": "reassigned"
                }
              }
            ]
          },
          "setter-like-call": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "any": [
                {
                  "matches": "state-setter"
                },
                {
                  "matches": "setter-function"
                }
              ]
            }
          },
          "memo-callback": {
            "any": [
              {
                "kind": "arrow_function"
              },
              {
                "kind": "function_expression"
              }
            ],
            "nthChild": {
              "position": 1,
              "ofRule": {
                "not": {
                  "kind": "comment"
                }
              }
            },
            "inside": {
              "kind": "arguments",
              "inside": {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "use-memo-callee"
                },
                "inside": {
                  "stopBy": {
                    "matches": "fn-stop"
                  },
                  "matches": "compiled-fn"
                }
              }
            }
          },
          "async-fn": {
            "has": {
              "regex": "^async$",
              "not": {
                "kind": "identifier"
              }
            }
          }
        }
      }
    },
    {
      "id": "render",
      "forbid": {
        "ast": {
          "language": "typescript",
