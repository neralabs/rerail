{
  "format": "rerail.policy/v1",
  "id": "react-practice-request-beside-data-library",
  "revision": 1,
  "mode": "log",
  "description": "Fetch server data with a query hook in files that already use a data-fetching library, not with a request in useEffect saved to useState; the library handles caching and races.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": [
      "**/*.test.*",
      "**/*.spec.*",
      "**/*.cy.*",
      "**/__tests__/**",
      "**/test/**",
      "**/tests/**",
      "**/e2e/**",
      "**/__mocks__/**",
      "**/*.stories.*",
      "**/*.story.*",
      "**/__stories__/**",
      "**/__fixtures__/**",
      "**/fixtures/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.d.ts"
    ]
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "rbl-fn": {
            "any": [
              {
                "kind": "function_declaration"
              },
              {
                "kind": "generator_function_declaration"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "arrow_function"
              },
              {
                "kind": "method_definition"
              }
            ]
          },
          "rbl-react-source": {
            "kind": "string",
            "has": {
              "kind": "string_fragment",
              "regex": "^(?i:react|react-dom)$"
            }
          },
          "rbl-react-object": {
            "kind": "identifier",
            "any": [
              {
                "regex": "^React$",
                "resolves": {
                  "global": [
                    "React"
                  ]
                }
              },
              {
                "resolves": {
                  "binding": {
                    "site": {
                      "any": [
                        {
                          "kind": "import_clause"
                        },
                        {
                          "kind": "namespace_import"
                        }
                      ],
                      "inside": {
                        "stopBy": "end",
                        "kind": "import_statement",
                        "has": {
                          "field": "source",
                          "matches": "rbl-react-source"
                        }
                      }
                    }
                  }
                }
              },
              {
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "variable_declarator",
                      "all": [
                        {
                          "has": {
                            "field": "name",
                            "kind": "identifier"
                          }
                        },
                        {
                          "has": {
                            "field": "value",
                            "matches": "rbl-react-require"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "rbl-react-require": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "identifier",
                  "regex": "^require$",
                  "resolves": {
                    "global": [
                      "require"
                    ]
                  }
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "rbl-react-source"
                  }
                }
              }
            ]
          },
          "rbl-effect-callee": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^(?:useEffect|useLayoutEffect)$",
                "resolves": {
                  "global": [
                    "useEffect",
                    "useLayoutEffect"
                  ]
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "import_specifier",
                      "has": {
                        "field": "name",
                        "regex": "^(?:useEffect|useLayoutEffect)$"
                      },
                      "inside": {
                        "stopBy": "end",
                        "kind": "import_statement",
                        "has": {
                          "field": "source",
                          "matches": "rbl-react-source"
                        }
                      }
                    }
                  }
                }
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "matches": "rbl-react-object"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "kind": "property_identifier",
                      "regex": "^(?:useEffect|useLayoutEffect)$"
                    }
                  }
                ]
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "occurrence": {
                      "any": [
                        {
                          "kind": "shorthand_property_identifier_pattern",
                          "regex": "^(?:useEffect|useLayoutEffect)$"
                        },
                        {
                          "inside": {
                            "kind": "pair_pattern",
                            "has": {
                              "field": "key",
                              "regex": "^(?:useEffect|useLayoutEffect)$"
                            }
                          }
                        }
                      ]
                    },
                    "site": {
                      "kind": "variable_declarator",
                      "has": {
                        "field": "value",
                        "any": [
                          {
                            "matches": "rbl-react-object"
                          },
                          {
                            "matches": "rbl-react-require"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "rbl-state-callee": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^(?:useState)$",
                "resolves": {
                  "global": [
                    "useState"
                  ]
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "import_specifier",
                      "has": {
                        "field": "name",
                        "regex": "^(?:useState)$"
                      },
                      "inside": {
                        "stopBy": "end",
                        "kind": "import_statement",
                        "has": {
                          "field": "source",
                          "matches": "rbl-react-source"
                        }
                      }
                    }
                  }
                }
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "matches": "rbl-react-object"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "kind": "property_identifier",
                      "regex": "^(?:useState)$"
                    }
                  }
                ]
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "occurrence": {
                      "any": [
                        {
                          "kind": "shorthand_property_identifier_pattern",
                          "regex": "^(?:useState)$"
                        },
                        {
                          "inside": {
                            "kind": "pair_pattern",
                            "has": {
                              "field": "key",
                              "regex": "^(?:useState)$"
                            }
                          }
                        }
                      ]
                    },
                    "site": {
                      "kind": "variable_declarator",
                      "has": {
                        "field": "value",
                        "any": [
                          {
                            "matches": "rbl-react-object"
                          },
                          {
                            "matches": "rbl-react-require"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "rbl-effect-call": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "matches": "rbl-effect-callee"
            }
          },
          "rbl-effect-cb": {
            "any": [
              {
                "kind": "arrow_function"
              },
              {
                "kind": "function_expression"
              }
            ],
            "inside": {
              "kind": "arguments",
              "inside": {
                "matches": "rbl-effect-call"
              }
            },
            "nthChild": {
              "position": 1,
              "ofRule": {
                "not": {
                  "kind": "comment"
                }
              }
            }
          },
          "rbl-state-call": {
            "any": [
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "rbl-state-callee"
                }
              },
              {
                "any": [
                  {
                    "kind": "parenthesized_expression"
                  },
                  {
                    "kind": "as_expression"
                  },
                  {
                    "kind": "satisfies_expression"
                  },
                  {
                    "kind": "non_null_expression"
                  }
                ],
                "has": {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  },
                  "matches": "rbl-state-call"
                }
              }
            ]
          },
          "rbl-setter-name": {
            "kind": "identifier",
            "inside": {
              "kind": "array_pattern",
              "inside": {
                "field": "name",
                "kind": "variable_declarator",
                "has": {
                  "field": "value",
                  "matches": "rbl-state-call"
                }
              }
            },
            "follows": {
              "stopBy": "neighbor",
              "regex": "^,$",
              "not": {
                "follows": {
                  "stopBy": "end",
                  "regex": "^,$"
                }
              }
            }
          },
          "rbl-setter": {
            "kind": "identifier",
            "resolves": {
              "binding": {
                "occurrence": {
                  "matches": "rbl-setter-name"
                }
              }
            }
          },
          "rbl-request": {
            "kind": "call_expression",
            "any": [
              {
                "pattern": "$REQ($$$)"
              },
              {
                "pattern": "$REQ<$$$T>($$$)"
              }
            ],
            "not": {
              "any": [
                {
                  "regex": "^(?:await\\s+)?(?:Promise\\b|import\\b|require\\b|new\\b|super\\b|createImageBitmap\\b|(?:[\\w$]+\\s*\\??\\.\\s*)*(?:refetch\\w*|mutate\\w*|prefetchQuery|fetchInfiniteQuery|ensureQueryData|invalidateQueries|(?:get|refresh)\\w*(?:Token|Session))\\s*[(<]|(?:[\\w$]+\\s*\\??\\.\\s*)+fetchQuery\\s*[(<]|(?:[\\w$]+\\s*\\??\\.\\s*)*(?:sleep|delay|wait|pause)\\s*[(<]|(?:[\\w$]+\\s*\\??\\.\\s*)*(?:save|update|create|delete|remove|post|put|patch|submit|send|upload|write)(?:[A-Z_$]\\w*)?\\s*[(<]|(?:[\\w$]+\\s*\\??\\.\\s*)*(?:\\w*[qQ]ueryClient|utils|trpc|\\w*[aA]uth|(?:local|session)Storage|AsyncStorage|localforage)\\s*\\??\\.|(?:[\\w$]+\\s*\\??\\.\\s*)*[sS]torage\\s*\\.\\s*(?:get|set|remove)Item\\b|(?:window\\s*\\??\\.\\s*)?(?:navigator|crypto|document|caches|Notification|indexedDB)\\s*\\??\\.)"
                },
                {
                  "all": [
                    {
                      "has": {
                        "field": "function",
                        "kind": "member_expression",
                        "has": {
                          "field": "property",
                          "regex": "^(?:json|text|blob|arrayBuffer|formData|bytes)$"
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "regex": "^\\(\\s*\\)$"
                      }
                    }
                  ]
                },
                {
                  "has": {
                    "field": "function",
                    "matches": "rbl-native-root"
                  }
                }
              ]
            }
          },
          "rbl-native-root": {
            "any": [
              {
                "matches": "rbl-native-id"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "rbl-native-root"
                }
              }
            ]
          },
          "rbl-native-id": {
            "kind": "identifier",
            "resolves": {
              "binding": {
                "site": {
                  "inside": {
                    "stopBy": "end",
                    "kind": "import_statement",
                    "has": {
                      "field": "source",
                      "has": {
                        "kind": "string_fragment",
                        "regex": "^(?:expo(?:-[\\w-]+)?|react-native(?:-[\\w-]+)?|@react-native[\\w./-]*|@expo/[\\w./-]+)$"
                      }
                    }
                  }
                }
              }
            }
          },
          "rbl-chain-member": {
            "kind": "member_expression",
            "has": {
              "field": "property",
              "regex": "^(?:then|catch|finally|toPromise)$"
            }
          },
          "rbl-setter-call": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "matches": "rbl-setter"
            }
          },
          "rbl-then-sets-state": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "has": {
                "field": "property",
                "regex": "^then$"
              }
            },
            "all": [
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "any": [
                      {
                        "matches": "rbl-setter"
                      },
                      {
                        "matches": "rbl-fn",
                        "has": {
                          "stopBy": {
                            "matches": "rbl-fn"
                          },
                          "matches": "rbl-setter-gets-result"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "rbl-result-cb": {
            "matches": "rbl-fn",
            "any": [
              {
                "inside": {
                  "kind": "arguments",
                  "inside": {
                    "kind": "call_expression",
                    "has": {
                      "field": "function",
                      "kind": "member_expression",
                      "has": {
                        "field": "property",
                        "regex": "^then$"
                      }
                    }
                  }
                }
              },
              {
                "inside": {
                  "field": "value",
                  "kind": "pair",
                  "has": {
                    "field": "key",
                    "regex": "^next$"
                  }
                }
              },
              {
                "kind": "method_definition",
                "has": {
                  "field": "name",
                  "regex": "^next$"
                }
              }
            ]
          },
          "rbl-result-ref": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "shorthand_property_identifier"
              }
            ],
            "resolves": {
              "binding": {
                "site": {
                  "inside": {
                    "stopBy": {
                      "matches": "rbl-fn"
                    },
                    "matches": "rbl-result-cb"
                  }
                }
              }
            }
          },
          "rbl-setter-gets-result": {
            "matches": "rbl-setter-call",
            "has": {
              "field": "arguments",
              "has": {
                "stopBy": "end",
                "matches": "rbl-result-ref"
              }
            }
          },
          "rbl-chain-sets-state": {
            "inside": {
              "field": "object",
              "kind": "member_expression",
              "inside": {
                "field": "function",
                "kind": "call_expression",
                "any": [
                  {
                    "matches": "rbl-then-sets-state"
                  },
                  {
                    "has": {
                      "field": "function",
                      "matches": "rbl-chain-member"
                    },
                    "matches": "rbl-chain-sets-state"
                  }
                ]
              }
            }
          },
          "rbl-fn-body-edge": {
            "any": [
              {
                "matches": "rbl-fn"
              },
              {
                "kind": "statement_block",
                "inside": {
                  "field": "body",
                  "matches": "rbl-fn"
                }
              }
            ]
          },
          "rbl-awaited-ref": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "shorthand_property_identifier"
              }
            ],
            "resolves": {
              "binding": {
                "site": {
                  "kind": "variable_declarator",
                  "has": {
                    "field": "value",
                    "any": [
                      {
                        "kind": "await_expression"
                      },
                      {
                        "has": {
                          "stopBy": {
                            "matches": "rbl-fn"
                          },
                          "any": [
                            {
                              "kind": "await_expression"
                            },
                            {
                              "matches": "rbl-awaited-ref"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "rbl-setter-gets-awaited": {
            "matches": "rbl-setter-call",
            "has": {
              "field": "arguments",
              "has": {
                "stopBy": "end",
                "matches": "rbl-awaited-ref"
              }
            }
          },
          "rbl-await-sets-state": {
            "all": [
              {
                "inside": {
                  "kind": "await_expression"
                }
              },
              {
                "inside": {
                  "stopBy": {
                    "matches": "rbl-fn"
                  },
                  "matches": "rbl-fn",
                  "regex": "^async\\b"
                }
              },
              {
                "any": [
                  {
                    "inside": {
                      "stopBy": {
                        "matches": "rbl-fn"
                      },
                      "matches": "rbl-setter-call"
                    }
                  },
                  {
                    "all": [
                      {
                        "inside": {
                          "stopBy": {
                            "any": [
                              {
                                "matches": "rbl-fn"
                              },
                              {
                                "kind": "expression_statement"
                              }
                            ]
                          },
                          "field": "value",
                          "kind": "variable_declarator"
                        }
                      },
                      {
                        "inside": {
                          "stopBy": {
                            "matches": "rbl-fn-body-edge"
                          },
                          "precedes": {
                            "stopBy": "end",
                            "any": [
                              {
                                "matches": "rbl-setter-gets-awaited"
                              },
                              {
                                "has": {
                                  "stopBy": {
                                    "matches": "rbl-fn"
                                  },
                                  "matches": "rbl-setter-gets-awaited"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "rbl-in-effect": {
            "inside": {
              "stopBy": "end",
              "matches": "rbl-effect-cb"
            }
          },
          "rbl-next-sets-state": {
            "any": [
              {
                "kind": "pair",
                "has": {
                  "field": "key",
                  "regex": "^next$"
                },
                "all": [
                  {
                    "has": {
                      "field": "value",
                      "any": [
                        {
                          "matches": "rbl-setter"
                        },
                        {
                          "matches": "rbl-fn",
                          "has": {
                            "stopBy": {
                              "matches": "rbl-fn"
                            },
                            "matches": "rbl-setter-gets-result"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "kind": "method_definition",
                "has": {
                  "field": "name",
                  "regex": "^next$"
                },
                "all": [
                  {
                    "has": {
                      "stopBy": {
                        "matches": "rbl-fn"
                      },
                      "matches": "rbl-setter-gets-result"
                    }
                  }
                ]
              }
            ]
          },
          "rbl-subscribe-sets-state": {
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "identifier",
                  "regex": "^fetchQuery$"
                }
              },
              {
                "inside": {
                  "field": "object",
                  "kind": "member_expression",
                  "has": {
                    "field": "property",
                    "regex": "^subscribe$"
                  },
                  "inside": {
                    "field": "function",
                    "kind": "call_expression",
                    "has": {
                      "field": "arguments",
                      "has": {
                        "kind": "object",
                        "has": {
                          "matches": "rbl-next-sets-state"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "rbl-import-gate": {
            "inside": {
              "stopBy": "end",
              "kind": "program",
              "has": {
                "kind": "import_statement",
                "not": {
                  "regex": "^import\\s+type\\b"
                },
                "has": {
                  "field": "source",
                  "has": {
                    "kind": "string_fragment",
                    "regex": "^(?:@tanstack/react-query|react-query|swr(?:/[\\w./-]+)?|@apollo/client(?:/[\\w./-]+)?|react-relay(?:/[\\w./-]+)?|@trpc/(?:react-query|next|tanstack-react-query)(?:/[\\w./-]+)?|@reduxjs/toolkit/query(?:/react)?)$",
                    "pattern": "$LIB"
                  }
                },
                "all": [
                  {
                    "has": {
                      "stopBy": "end",
                      "any": [
                        {
                          "kind": "namespace_import"
                        },
                        {
                          "kind": "identifier",
                          "inside": {
                            "kind": "import_clause"
                          }
                        },
                        {
                          "kind": "import_specifier",
                          "not": {
                            "any": [
                              {
                                "regex": "^type\\s"
                              },
                              {
                                "has": {
                                  "field": "name",
                                  "regex": "^(?:QueryClient|QueryClientProvider|QueryCache|MutationCache|ApolloProvider|ApolloClient|InMemoryCache|HttpLink|ApolloLink|SWRConfig|RelayEnvironmentProvider|Environment|Network|RecordSource|Store)$"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          "rbl-library-require": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "identifier",
                  "regex": "^require$",
                  "resolves": {
                    "global": [
                      "require"
                    ]
                  }
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "kind": "string",
                    "has": {
                      "kind": "string_fragment",
                      "regex": "^(?:@tanstack/react-query|react-query|swr(?:/[\\w./-]+)?|@apollo/client(?:/[\\w./-]+)?|react-relay(?:/[\\w./-]+)?|@trpc/(?:react-query|next|tanstack-react-query)(?:/[\\w./-]+)?|@reduxjs/toolkit/query(?:/react)?)$",
                      "pattern": "$LIB"
                    }
                  }
                }
              }
            ]
          },
          "rbl-require-gate": {
            "inside": {
              "stopBy": "end",
              "kind": "program",
              "has": {
                "any": [
                  {
                    "kind": "lexical_declaration"
                  },
                  {
                    "kind": "variable_declaration"
                  }
                ],
                "has": {
                  "kind": "variable_declarator",
                  "not": {
                    "has": {
                      "field": "name",
                      "kind": "object_pattern",
                      "not": {
                        "has": {
                          "any": [
                            {
