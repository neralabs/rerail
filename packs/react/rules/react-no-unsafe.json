                    }
                  }
                }
              }
            ]
          },
          "after-jsdoc-component": {
            "follows": {
              "stopBy": "neighbor",
              "matches": "jsdoc-component"
            }
          },
          "es6-component": {
            "any": [
              {
                "any": [
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  }
                ],
                "has": {
                  "kind": "class_heritage",
                  "any": [
                    {
                      "has": {
                        "matches": "component-superclass"
                      }
                    }
                  ]
                }
              },
              {
                "any": [
                  {
                    "kind": "class_declaration"
                  }
                ],
                "matches": "after-jsdoc-component"
              },
              {
                "any": [
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "class"
                  }
                ],
                "inside": {
                  "kind": "export_statement",
                  "matches": "after-jsdoc-component"
                }
              },
              {
                "kind": "class",
                "inside": {
                  "kind": "variable_declarator",
                  "field": "value",
                  "inside": {
                    "any": [
                      {
                        "kind": "lexical_declaration"
                      },
                      {
                        "kind": "variable_declaration"
                      }
                    ],
                    "matches": "after-jsdoc-component"
                  }
                }
              }
            ]
          },
          "in-es6-component": {
            "inside": {
              "kind": "class_body",
              "inside": {
                "matches": "es6-component"
              }
            }
          },
          "will-mount-key": {
            "any": [
              {
                "kind": "property_identifier",
                "regex": "^UNSAFE_componentWillMount$"
              },
              {
                "kind": "private_property_identifier",
                "regex": "^#UNSAFE_componentWillMount$"
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "kind": "identifier",
                  "regex": "^UNSAFE_componentWillMount$"
                }
              }
            ]
          },
          "will-receive-props-key": {
            "any": [
              {
                "kind": "property_identifier",
                "regex": "^UNSAFE_componentWillReceiveProps$"
              },
              {
                "kind": "private_property_identifier",
                "regex": "^#UNSAFE_componentWillReceiveProps$"
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "kind": "identifier",
                  "regex": "^UNSAFE_componentWillReceiveProps$"
                }
              }
            ]
          },
          "will-update-key": {
            "any": [
              {
                "kind": "property_identifier",
                "regex": "^UNSAFE_componentWillUpdate$"
              },
              {
                "kind": "private_property_identifier",
                "regex": "^#UNSAFE_componentWillUpdate$"
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "kind": "identifier",
                  "regex": "^UNSAFE_componentWillUpdate$"
                }
              }
            ]
          },
          "will-mount-field": {
            "kind": "field_definition",
            "has": {
              "field": "property",
              "matches": "will-mount-key"
            },
            "matches": "in-es6-component"
          },
          "will-receive-props-field": {
            "kind": "field_definition",
            "has": {
              "field": "property",
              "matches": "will-receive-props-key"
            },
            "matches": "in-es6-component"
          },
          "will-update-field": {
            "kind": "field_definition",
            "has": {
              "field": "property",
              "matches": "will-update-key"
            },
            "matches": "in-es6-component"
          }
        }
      }
    },
    {
      "id": "will-mount",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "matches": "will-mount",
            "all": [
              {
                "matches": "undecorated"
              }
            ]
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react/no-unsafe",
        "message": "Move the work in UNSAFE_componentWillMount to componentDidMount (side effects, subscriptions) or the constructor (initial state); it is unsafe with async rendering.",
        "suppress": {
          "eslint": {
            "rules": [
              "react/no-unsafe"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unsafe"
            ]
          }
        }
      }
    },
