{
  "format": "rerail.policy/v1",
  "id": "react-no-unsafe",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid the UNSAFE_componentWillMount, UNSAFE_componentWillReceiveProps and UNSAFE_componentWillUpdate lifecycle methods in class components; they break under async rendering.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared-typescript",
      "define": {
        "language": "typescript",
        "utils": {
          "component-superclass": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^(?:Pure)?Component$"
              },
              {
                "kind": "member_expression",
                "regex": "^React\\s*\\.\\s*(?:Pure)?Component$",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "regex": "^React$"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "regex": "^(?:Pure)?Component$"
                    }
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "component-superclass"
                }
              }
            ]
          },
          "jsdoc-component": {
            "kind": "comment",
            "regex": "(?m)^(?:/\\*\\*|[ \\t]*\\*?)[ \\t]*@(?:extends|augments)[ \\t]+React\\.(?:Pure)?Component(?:\\s|\\*/)",
            "all": [
              {
                "regex": "^/\\*\\*[^*]"
              },
              {
                "layout": {
                  "after": {
                    "to": "token",
                    "breaks": {
                      "max": 1
                    }
                  }
                }
              }
            ]
          },
          "after-jsdoc-component": {
            "follows": {
              "stopBy": "neighbor",
              "matches": "jsdoc-component"
            }
          },
          "es6-component": {
            "any": [
              {
                "any": [
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  },
                  {
                    "kind": "class"
                  }
                ],
                "has": {
                  "kind": "class_heritage",
                  "any": [
                    {
                      "has": {
                        "matches": "component-superclass"
                      }
                    },
                    {
                      "has": {
                        "kind": "extends_clause",
                        "has": {
                          "field": "value",
                          "matches": "component-superclass"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "any": [
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  }
                ],
                "matches": "after-jsdoc-component"
              },
              {
                "any": [
                  {
                    "kind": "class_declaration"
                  },
                  {
                    "kind": "abstract_class_declaration"
                  },
                  {
                    "kind": "class"
                  }
                ],
                "inside": {
                  "kind": "export_statement",
                  "matches": "after-jsdoc-component"
                }
              },
              {
                "kind": "class",
                "inside": {
                  "kind": "variable_declarator",
                  "field": "value",
                  "inside": {
                    "any": [
                      {
                        "kind": "lexical_declaration"
                      },
                      {
                        "kind": "variable_declaration"
                      }
                    ],
                    "matches": "after-jsdoc-component"
                  }
                }
              }
            ]
          },
          "in-es6-component": {
            "inside": {
              "kind": "class_body",
              "inside": {
                "matches": "es6-component"
              }
            }
          },
          "will-mount-key": {
            "any": [
              {
                "kind": "property_identifier",
                "regex": "^UNSAFE_componentWillMount$"
              },
              {
                "kind": "private_property_identifier",
                "regex": "^#UNSAFE_componentWillMount$"
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "kind": "identifier",
                  "regex": "^UNSAFE_componentWillMount$"
                }
              }
            ]
          },
          "will-receive-props-key": {
            "any": [
              {
                "kind": "property_identifier",
                "regex": "^UNSAFE_componentWillReceiveProps$"
              },
              {
                "kind": "private_property_identifier",
                "regex": "^#UNSAFE_componentWillReceiveProps$"
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "kind": "identifier",
                  "regex": "^UNSAFE_componentWillReceiveProps$"
                }
              }
            ]
          },
          "will-update-key": {
            "any": [
              {
                "kind": "property_identifier",
                "regex": "^UNSAFE_componentWillUpdate$"
              },
              {
                "kind": "private_property_identifier",
                "regex": "^#UNSAFE_componentWillUpdate$"
              },
              {
                "kind": "computed_property_name",
                "has": {
                  "kind": "identifier",
                  "regex": "^UNSAFE_componentWillUpdate$"
                }
              }
            ]
          },
          "create-class-callee": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^createReactClass$"
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "regex": "^React$"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "regex": "^createReactClass$"
                    }
                  }
                ]
              }
            ]
          },
          "es5-component": {
            "kind": "object",
            "inside": {
              "kind": "arguments",
              "inside": {
                "any": [
                  {
                    "kind": "call_expression",
                    "has": {
                      "field": "function",
                      "matches": "create-class-callee"
                    }
                  },
                  {
                    "kind": "new_expression",
                    "has": {
                      "field": "constructor",
                      "matches": "create-class-callee"
                    }
                  }
                ]
              }
            }
          },
          "undecorated": {
            "any": [
              {
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "^(?:[^@/]|$)"
                }
              },
              {
                "follows": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "method_definition"
                    },
                    {
                      "kind": "public_field_definition"
                    },
                    {
                      "has": {
                        "field": "property",
                        "regex": "^"
                      }
                    }
                  ]
                }
              },
              {
                "follows": {
                  "stopBy": "neighbor",
                  "kind": "comment",
                  "matches": "undecorated"
                }
              }
            ]
          },
          "will-mount": {
            "any": [
              {
                "any": [
                  {
                    "kind": "method_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-mount-key"
                    }
                  },
                  {
                    "kind": "method_signature",
                    "has": {
                      "field": "name",
                      "matches": "will-mount-key"
                    }
                  },
                  {
                    "kind": "abstract_method_signature",
                    "has": {
                      "field": "name",
                      "matches": "will-mount-key"
                    }
                  },
                  {
                    "kind": "public_field_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-mount-key"
                    }
                  }
                ],
                "matches": "in-es6-component"
              },
              {
                "any": [
                  {
                    "kind": "method_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-mount-key"
                    }
                  },
                  {
                    "kind": "pair",
                    "has": {
                      "field": "key",
                      "matches": "will-mount-key"
                    }
                  },
                  {
                    "kind": "shorthand_property_identifier",
                    "regex": "^UNSAFE_componentWillMount$"
                  }
                ],
                "inside": {
                  "matches": "es5-component"
                }
              }
            ]
          },
          "decorates-will-mount": {
            "any": [
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "matches": "will-mount"
                }
              },
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^[@/]",
                  "matches": "decorates-will-mount"
                }
              }
            ]
          },
          "will-receive-props": {
            "any": [
              {
                "any": [
                  {
                    "kind": "method_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-receive-props-key"
                    }
                  },
                  {
                    "kind": "method_signature",
                    "has": {
                      "field": "name",
                      "matches": "will-receive-props-key"
                    }
                  },
                  {
                    "kind": "abstract_method_signature",
                    "has": {
                      "field": "name",
                      "matches": "will-receive-props-key"
                    }
                  },
                  {
                    "kind": "public_field_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-receive-props-key"
                    }
                  }
                ],
                "matches": "in-es6-component"
              },
              {
                "any": [
                  {
                    "kind": "method_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-receive-props-key"
                    }
                  },
                  {
                    "kind": "pair",
                    "has": {
                      "field": "key",
                      "matches": "will-receive-props-key"
                    }
                  },
                  {
                    "kind": "shorthand_property_identifier",
                    "regex": "^UNSAFE_componentWillReceiveProps$"
                  }
                ],
                "inside": {
                  "matches": "es5-component"
                }
              }
            ]
          },
          "decorates-will-receive-props": {
            "any": [
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "matches": "will-receive-props"
                }
              },
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^[@/]",
                  "matches": "decorates-will-receive-props"
                }
              }
            ]
          },
          "will-update": {
            "any": [
              {
                "any": [
                  {
                    "kind": "method_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-update-key"
                    }
                  },
                  {
                    "kind": "method_signature",
                    "has": {
                      "field": "name",
                      "matches": "will-update-key"
                    }
                  },
                  {
                    "kind": "abstract_method_signature",
                    "has": {
                      "field": "name",
                      "matches": "will-update-key"
                    }
                  },
                  {
                    "kind": "public_field_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-update-key"
                    }
                  }
                ],
                "matches": "in-es6-component"
              },
              {
                "any": [
                  {
                    "kind": "method_definition",
                    "has": {
                      "field": "name",
                      "matches": "will-update-key"
                    }
                  },
                  {
                    "kind": "pair",
                    "has": {
                      "field": "key",
                      "matches": "will-update-key"
                    }
                  },
                  {
                    "kind": "shorthand_property_identifier",
                    "regex": "^UNSAFE_componentWillUpdate$"
                  }
                ],
                "inside": {
                  "matches": "es5-component"
                }
              }
            ]
          },
          "decorates-will-update": {
            "any": [
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "matches": "will-update"
                }
              },
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^[@/]",
                  "matches": "decorates-will-update"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "shared-javascript",
