{
  "format": "rerail.policy/v1",
  "id": "react-hooks-globals",
  "revision": 1,
  "mode": "steer",
  "description": "Don't reassign variables declared outside a component or hook while it renders; React may render it any number of times, in any order.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "shorthand_property_identifier_pattern"
              }
            ],
            "pattern": "$NAME",
            "all": [
              {
                "matches": "assign-target"
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "program",
                  "has": {
                    "matches": "top-level-react"
                  }
                }
              },
              {
                "not": {
                  "resolves": {
                    "binding": {
                      "site": {
                        "inside": {
                          "stopBy": "end",
                          "matches": "compiled-fn"
                        }
                      }
                    }
                  }
                }
              },
              {
                "matches": "in-render"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": {
                      "matches": "boundary"
                    },
                    "follows": {
                      "stopBy": "end",
                      "any": [
                        {
                          "kind": "return_statement"
                        },
                        {
                          "kind": "throw_statement"
                        },
                        {
                          "kind": "break_statement"
                        },
                        {
                          "kind": "continue_statement"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "utils": {
            "babel-fn": {
              "any": [
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "arrow_function"
                }
              ]
            },
            "boundary": {
              "any": [
                {
                  "matches": "babel-fn"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "class_declaration"
                },
                {
                  "kind": "abstract_class_declaration"
                },
                {
                  "kind": "class"
                }
              ]
            },
            "class-node": {
              "any": [
                {
                  "kind": "class_declaration"
                },
                {
                  "kind": "abstract_class_declaration"
                },
                {
                  "kind": "class"
                }
              ]
            },
            "hook-call": {
              "kind": "call_expression",
              "not": {
                "any": [
                  {
                    "regex": "^[\\w$.\\s]+\\?\\.\\s*\\("
                  },
                  {
                    "has": {
                      "field": "function",
                      "has": {
                        "kind": "optional_chain"
                      }
                    }
                  }
                ]
              },
              "has": {
                "field": "function",
                "any": [
                  {
                    "kind": "identifier",
                    "regex": "^use[A-Z0-9]"
                  },
                  {
                    "kind": "member_expression",
                    "all": [
                      {
                        "has": {
                          "field": "object",
                          "kind": "identifier",
                          "regex": "^[A-Z]"
                        }
                      },
                      {
                        "has": {
                          "field": "property",
                          "kind": "property_identifier",
                          "regex": "^use[A-Z0-9]"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            "calls-hooks-or-jsx": {
              "has": {
                "stopBy": {
                  "matches": "babel-fn"
                },
                "any": [
                  {
                    "kind": "jsx_element"
                  },
                  {
                    "kind": "jsx_self_closing_element"
                  },
                  {
                    "matches": "hook-call"
                  }
                ]
              }
            },
            "non-node": {
              "any": [
                {
                  "kind": "object"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "class"
                },
                {
                  "kind": "new_expression"
                },
                {
                  "kind": "number",
                  "regex": "n$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "non-node"
                  }
                }
              ]
            },
            "non-node-return": {
              "kind": "return_statement",
              "any": [
                {
                  "regex": "^return\\s*;?$"
                },
                {
                  "has": {
                    "matches": "non-node"
                  }
                }
              ]
            },
            "returns-node": {
              "all": [
                {
                  "not": {
                    "has": {
                      "field": "body",
                      "matches": "non-node"
                    }
                  }
                },
                {
                  "any": [
                    {
                      "not": {
                        "has": {
                          "stopBy": {
                            "matches": "boundary"
                          },
                          "matches": "non-node-return"
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "body",
                        "kind": "statement_block",
                        "has": {
                          "kind": "return_statement",
                          "nthChild": {
                            "position": 1,
                            "reverse": true,
                            "ofRule": {
                              "not": {
                                "kind": "comment"
                              }
                            }
                          },
                          "not": {
                            "matches": "non-node-return"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "bad-props-type": {
              "kind": "type_annotation",
              "has": {
                "any": [
                  {
                    "kind": "predefined_type",
                    "regex": "^(number|boolean|string|symbol|bigint|never)$"
                  },
                  {
                    "kind": "array_type"
                  },
                  {
                    "kind": "tuple_type"
                  },
                  {
                    "kind": "function_type"
                  },
                  {
                    "kind": "constructor_type"
                  },
                  {
                    "kind": "template_literal_type"
                  },
                  {
                    "kind": "literal_type",
                    "not": {
                      "has": {
                        "any": [
                          {
                            "kind": "null"
                          },
                          {
                            "kind": "undefined"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "rest-param": {
              "any": [
                {
                  "kind": "rest_pattern"
                },
                {
                  "kind": "required_parameter",
                  "has": {
                    "field": "pattern",
                    "kind": "rest_pattern"
                  }
                }
              ]
            },
            "param": {
              "any": [
                {
                  "kind": "required_parameter"
                },
                {
                  "kind": "optional_parameter"
                },
                {
                  "kind": "identifier"
                },
                {
                  "kind": "object_pattern"
                },
                {
                  "kind": "array_pattern"
                },
                {
                  "kind": "assignment_pattern"
                },
                {
                  "kind": "rest_pattern"
                }
              ]
            },
            "props-param": {
              "matches": "param",
              "not": {
                "any": [
                  {
                    "matches": "rest-param"
                  },
                  {
                    "all": [
                      {
                        "any": [
                          {
                            "kind": "required_parameter"
                          },
                          {
                            "kind": "optional_parameter"
                          }
                        ]
                      },
                      {
                        "not": {
                          "has": {
                            "field": "value",
                            "not": {
                              "kind": "comment"
                            }
                          }
                        }
                      },
                      {
                        "has": {
                          "field": "type",
                          "matches": "bad-props-type"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            "ref-param": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "ref|Ref"
                },
                {
                  "any": [
                    {
                      "kind": "required_parameter"
                    },
                    {
                      "kind": "optional_parameter"
                    }
                  ],
                  "not": {
                    "has": {
                      "field": "value",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  },
                  "has": {
                    "field": "pattern",
                    "kind": "identifier",
                    "regex": "ref|Ref"
                  }
                }
              ]
            },
            "component-params": {
              "any": [
                {
                  "has": {
                    "field": "parameter",
                    "kind": "identifier"
                  }
                },
                {
                  "has": {
                    "field": "parameters",
                    "kind": "formal_parameters",
                    "any": [
                      {
                        "not": {
                          "has": {
                            "matches": "param"
                          }
                        }
                      },
                      {
                        "all": [
                          {
                            "count": {
                              "has": {
                                "matches": "param"
                              },
                              "max": 1
                            }
                          },
                          {
                            "has": {
                              "matches": "param",
                              "nthChild": {
                                "position": 1,
                                "ofRule": {
                                  "matches": "param"
                                }
                              },
                              "all": [
                                {
                                  "matches": "props-param"
                                }
                              ]
                            }
                          }
                        ]
                      },
                      {
                        "all": [
                          {
                            "count": {
                              "has": {
                                "matches": "param"
                              },
                              "min": 2,
                              "max": 2
                            }
                          },
                          {
                            "has": {
                              "matches": "param",
                              "nthChild": {
                                "position": 1,
                                "ofRule": {
                                  "matches": "param"
                                }
                              },
                              "all": [
                                {
                                  "matches": "props-param"
                                }
                              ]
                            }
                          },
                          {
                            "has": {
                              "matches": "param",
                              "nthChild": {
                                "position": 2,
                                "ofRule": {
                                  "matches": "param"
                                }
                              },
                              "all": [
                                {
                                  "matches": "ref-param"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "component-named": {
              "any": [
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "generator_function_declaration"
                        }
                      ]
                    },
                    {
                      "has": {
                        "field": "name",
                        "kind": "identifier",
                        "regex": "^[A-Z]"
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_expression"
                        },
                        {
                          "kind": "generator_function"
                        },
                        {
                          "kind": "arrow_function"
                        }
                      ]
                    },
                    {
                      "any": [
                        {
                          "inside": {
                            "kind": "variable_declarator",
                            "field": "value",
                            "has": {
                              "field": "name",
                              "kind": "identifier",
                              "regex": "^[A-Z]"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "hook-named": {
              "any": [
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "generator_function_declaration"
                        }
                      ]
                    },
                    {
                      "has": {
                        "field": "name",
                        "kind": "identifier",
                        "regex": "^use[A-Z0-9]"
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_expression"
                        },
                        {
                          "kind": "generator_function"
                        },
                        {
                          "kind": "arrow_function"
                        }
                      ]
                    },
                    {
                      "any": [
                        {
                          "inside": {
                            "kind": "variable_declarator",
                            "field": "value",
                            "has": {
                              "field": "name",
                              "kind": "identifier",
                              "regex": "^use[A-Z0-9]"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "memo-callback": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "generator_function"
                    },
                    {
                      "kind": "arrow_function"
                    }
                  ]
                },
                {
                  "inside": {
                    "matches": "argument-list",
                    "inside": {
                      "kind": "call_expression",
                      "has": {
                        "field": "function",
                        "any": [
                          {
                            "kind": "identifier",
                            "regex": "^(memo|forwardRef)$"
                          },
                          {
                            "kind": "member_expression",
                            "all": [
                              {
                                "has": {
                                  "field": "object",
                                  "kind": "identifier",
                                  "regex": "^React$"
                                }
                              },
                              {
                                "has": {
                                  "field": "property",
                                  "regex": "^(memo|forwardRef)$"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "react-fn": {
              "all": [
                {
                  "matches": "babel-fn"
                },
                {
                  "not": {
                    "has": {
                      "field": "parameters",
                      "has": {
                        "kind": "required_parameter",
                        "has": {
                          "field": "pattern",
                          "kind": "this"
                        }
                      }
                    }
                  }
                },
                {
                  "matches": "calls-hooks-or-jsx"
                },
                {
                  "any": [
                    {
                      "all": [
                        {
                          "matches": "component-named"
                        },
                        {
                          "matches": "component-params"
                        },
                        {
                          "matches": "returns-node"
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "not": {
                            "matches": "component-named"
                          }
                        },
                        {
                          "matches": "hook-named"
                        }
                      ]
                    },
                    {
                      "matches": "memo-callback"
                    }
                  ]
                }
              ]
            },
            "compiled-fn": {
              "all": [
                {
                  "matches": "react-fn"
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "matches": "class-node"
                    }
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "matches": "react-fn"
                    }
                  }
                }
              ]
            },
            "uncalled-callee": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^use[A-Z0-9]"
                },
                {
                  "kind": "identifier",
                  "regex": "^(Boolean|Number|String|parseInt|parseFloat|isNaN|isFinite|encodeURI|encodeURIComponent|decodeURI|decodeURIComponent)$"
                },
                {
                  "kind": "member_expression",
                  "any": [
                    {
                      "has": {
                        "field": "object",
                        "kind": "identifier",
                        "regex": "^(console|Math)$"
                      }
                    },
                    {
                      "regex": "^Object\\s*\\.\\s*(keys|values|entries|fromEntries)$"
                    },
                    {
                      "regex": "^Array\\s*\\.\\s*(isArray|of)$"
                    },
                    {
                      "regex": "^(Date|performance)\\s*\\.\\s*now$"
                    }
                  ]
                },
                {
                  "kind": "member_expression",
                  "has": {
                    "field": "property",
                    "kind": "property_identifier",
                    "regex": "^use[A-Z0-9]"
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "site": {
                        "kind": "variable_declarator",
                        "all": [
                          {
                            "has": {
                              "field": "name",
                              "kind": "array_pattern"
                            }
                          },
                          {
                            "has": {
                              "field": "value",
                              "kind": "call_expression",
                              "has": {
                                "field": "function",
                                "regex": "(^|\\.)use(State|Reducer|ActionState|Optimistic)$"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "render-body": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "generator_function"
                    },
                    {
                      "kind": "arrow_function"
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "inside": {
                        "kind": "call_expression",
                        "field": "function",
                        "matches": "in-render-body"
                      }
                    },
                    {
                      "inside": {
                        "kind": "parenthesized_expression",
                        "inside": {
                          "kind": "call_expression",
                          "field": "function",
                          "matches": "in-render-body"
                        }
                      }
                    },
                    {
                      "nthChild": {
                        "position": 1,
                        "ofRule": {
                          "not": {
                            "kind": "comment"
                          }
                        }
                      },
                      "inside": {
                        "matches": "argument-list",
                        "inside": {
                          "kind": "call_expression",
                          "inside": {
                            "stopBy": {
                              "matches": "boundary"
                            },
                            "matches": "boundary",
                            "all": [
                              {
                                "matches": "compiled-fn"
                              }
                            ]
                          },
                          "has": {
                            "field": "function",
                            "any": [
                              {
                                "kind": "identifier",
                                "regex": "^useMemo$"
                              },
                              {
                                "kind": "member_expression",
                                "all": [
                                  {
                                    "has": {
                                      "field": "object",
                                      "kind": "identifier",
                                      "regex": "^React$"
                                    }
                                  },
                                  {
                                    "has": {
                                      "field": "property",
                                      "regex": "^useMemo$"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "in-render-body": {
              "inside": {
                "stopBy": {
                  "matches": "boundary"
                },
                "matches": "boundary",
                "any": [
                  {
                    "matches": "compiled-fn"
                  },
                  {
                    "matches": "render-body"
                  }
                ]
              }
            },
            "argument-list": {
              "kind": "arguments"
            },
            "arg-of-render-call": {
              "matches": "argument-list",
              "inside": {
                "all": [
                  {
                    "any": [
                      {
                        "kind": "call_expression",
                        "not": {
                          "has": {
                            "field": "function",
                            "matches": "uncalled-callee"
                          }
                        }
                      },
                      {
                        "kind": "new_expression",
                        "not": {
                          "has": {
                            "field": "constructor",
                            "kind": "identifier",
                            "regex": "^(Map|Set|WeakSet)$"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "matches": "in-render-body"
                  }
                ]
              }
            },
            "called-callback": {
              "all": [
                {
                  "any": [
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "generator_function"
                    },
                    {
                      "kind": "arrow_function"
                    }
                  ]
                },
                {
                  "not": {
                    "matches": "render-body"
                  }
                },
                {
                  "any": [
                    {
                      "inside": {
                        "matches": "arg-of-render-call"
                      }
                    },
                    {
                      "inside": {
                        "kind": "array",
                        "inside": {
                          "matches": "arg-of-render-call"
                        }
                      }
                    },
                    {
                      "inside": {
                        "kind": "array",
                        "inside": {
                          "kind": "spread_element",
                          "inside": {
                            "matches": "arg-of-render-call"
                          }
                        }
                      }
                    },
                    {
                      "inside": {
                        "kind": "pair",
                        "field": "value",
                        "inside": {
                          "matches": "object-arg"
                        }
                      }
                    },
                    {
                      "inside": {
                        "kind": "ternary_expression",
                        "inside": {
                          "matches": "arg-of-render-call"
                        }
                      }
                    },
                    {
                      "inside": {
                        "kind": "jsx_expression",
                        "inside": {
                          "matches": "rendered-element"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "called-method": {
              "kind": "method_definition",
              "inside": {
                "kind": "object",
                "matches": "object-arg"
              }
            },
            "object-arg": {
              "kind": "object",
              "any": [
                {
                  "inside": {
                    "matches": "arg-of-render-call"
                  }
                },
                {
                  "inside": {
                    "kind": "pair",
                    "field": "value",
                    "inside": {
                      "matches": "object-arg"
                    }
                  }
                }
              ]
            },
            "rendered-element": {
              "kind": "jsx_element",
              "has": {
                "kind": "jsx_opening_element",
                "has": {
                  "field": "name",
                  "not": {
                    "kind": "comment"
                  }
                }
              },
              "matches": "in-render-body",
              "inside": {
                "stopBy": {
                  "matches": "boundary"
                },
                "any": [
                  {
                    "kind": "return_statement"
                  },
                  {
                    "kind": "arrow_function",
                    "not": {
                      "has": {
                        "field": "body",
                        "kind": "statement_block"
                      }
                    }
                  }
                ]
              }
            },
            "local-call": {
              "kind": "call_expression",
              "has": {
                "field": "function",
                "kind": "identifier",
                "pattern": "$LOCAL"
              },
              "matches": "in-render-body"
            },
            "local-declaration": {
              "matches": "in-render-body",
              "inside": {
                "kind": "statement_block",
                "inside": {
                  "matches": "boundary"
                }
              },
              "not": {
                "follows": {
                  "stopBy": "end",
                  "any": [
                    {
                      "pattern": "$LOCAL"
                    },
                    {
                      "has": {
                        "stopBy": "end",
                        "kind": "identifier",
                        "pattern": "$LOCAL"
                      }
                    }
                  ]
                }
              },
              "precedes": {
                "stopBy": "end",
                "has": {
                  "stopBy": "end",
                  "matches": "local-call"
                }
              }
            },
            "called-local": {
              "any": [
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_expression"
                        },
                        {
                          "kind": "generator_function"
                        },
                        {
                          "kind": "arrow_function"
