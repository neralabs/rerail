{
  "format": "rerail.policy/v1",
  "id": "react-react-in-jsx-scope",
  "revision": 1,
  "mode": "steer",
  "description": "Import React in every file that uses JSX; the classic JSX transform compiles tags to React.createElement calls.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "jsx_opening_element"
              },
              {
                "kind": "jsx_self_closing_element"
              }
            ],
            "not": {
              "any": [
                {
                  "matches": "react-visible"
                },
                {
                  "matches": "other-pragma-file"
                }
              ]
            }
          },
          "utils": {
            "declares-react": {
              "any": [
                {
                  "kind": "import_statement",
                  "has": {
                    "stopBy": "end",
                    "kind": "identifier",
                    "regex": "^React$"
                  }
                },
                {
                  "any": [
                    {
                      "kind": "lexical_declaration"
                    },
                    {
                      "kind": "variable_declaration"
                    }
                  ],
                  "has": {
                    "kind": "variable_declarator",
                    "has": {
                      "field": "name",
                      "any": [
                        {
                          "kind": "identifier",
                          "regex": "^React$"
                        },
                        {
                          "has": {
                            "stopBy": "end",
                            "any": [
                              {
                                "kind": "identifier"
                              },
                              {
                                "kind": "shorthand_property_identifier_pattern"
                              }
                            ],
                            "regex": "^React$"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "any": [
                    {
                      "kind": "function_declaration"
                    },
                    {
                      "kind": "class_declaration"
                    }
                  ],
                  "has": {
                    "field": "name",
                    "regex": "^React$"
                  }
                },
                {
                  "kind": "export_statement",
                  "has": {
                    "field": "declaration",
                    "matches": "declares-react"
                  }
                }
              ]
            },
            "react-visible": {
              "any": [
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "program",
                    "has": {
                      "matches": "declares-react"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "statement_block",
                    "has": {
                      "matches": "declares-react"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "method_definition"
                      }
                    ],
                    "matches": "react-parameter"
                  }
                }
              ]
            },
            "react-parameter": {
              "any": [
                {
                  "has": {
                    "field": "parameters",
                    "has": {
                      "stopBy": "end",
                      "kind": "identifier",
                      "regex": "^React$",
                      "binds": {
                        "form": "parameter"
                      }
                    }
                  }
                },
                {
                  "has": {
                    "field": "parameter",
                    "kind": "identifier",
                    "regex": "^React$"
                  }
                }
              ]
            },
            "other-pragma-file": {
              "inside": {
                "stopBy": "end",
                "kind": "program",
                "has": {
                  "kind": "comment",
                  "regex": "@jsx\\s+[_$a-zA-Z][_$a-zA-Z0-9]*(?:[.\\s]|\\*/$|$)",
                  "not": {
                    "regex": "@jsx\\s+React(?:[.\\s]|\\*/$|$)"
                  }
                }
              }
            }
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react/react-in-jsx-scope",
        "message": "'React' must be in scope when using JSX",
        "suppress": {
          "eslint": {
            "rules": [
              "react/react-in-jsx-scope"
            ]
          },
          "oxlint": {
            "rules": [
              "react-in-jsx-scope"
            ]
          }
        }
      }
    },
    {
      "id": "pragma",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "kind": "jsx_opening_element"
              },
              {
                "kind": "jsx_self_closing_element"
              }
            ],
            "inside": {
              "stopBy": "end",
              "kind": "program",
              "has": {
                "kind": "comment",
                "regex": "@jsx\\s+[_$a-zA-Z][_$a-zA-Z0-9]*(?:[.\\s]|\\*/$|$)",
                "not": {
                  "regex": "@jsx\\s+React(?:[.\\s]|\\*/$|$)"
                },
                "pattern": "$CM"
              }
            },
            "not": {
              "matches": "pragma-visible"
            }
          },
          "utils": {
            "declares-pragma": {
              "any": [
                {
                  "kind": "import_statement",
                  "has": {
                    "stopBy": "end",
                    "kind": "identifier",
                    "all": [
                      {
                        "pattern": "$DN"
                      },
                      {
                        "compare": {
                          "left": "DN",
                          "op": "eq",
                          "right": "PRAGMA"
                        }
                      }
                    ]
                  }
                },
                {
                  "any": [
                    {
                      "kind": "lexical_declaration"
                    },
                    {
                      "kind": "variable_declaration"
                    }
                  ],
                  "has": {
                    "kind": "variable_declarator",
                    "has": {
                      "field": "name",
                      "any": [
                        {
                          "kind": "identifier",
                          "all": [
                            {
                              "pattern": "$DN"
                            },
                            {
                              "compare": {
                                "left": "DN",
                                "op": "eq",
                                "right": "PRAGMA"
                              }
                            }
                          ]
                        },
                        {
                          "has": {
                            "stopBy": "end",
                            "any": [
                              {
                                "kind": "identifier"
                              },
                              {
                                "kind": "shorthand_property_identifier_pattern"
                              }
                            ],
                            "all": [
                              {
                                "pattern": "$DN"
                              },
                              {
                                "compare": {
                                  "left": "DN",
                                  "op": "eq",
                                  "right": "PRAGMA"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "any": [
                    {
                      "kind": "function_declaration"
                    },
                    {
                      "kind": "class_declaration"
                    }
                  ],
                  "has": {
                    "field": "name",
                    "all": [
                      {
                        "pattern": "$DN"
                      },
                      {
                        "compare": {
                          "left": "DN",
                          "op": "eq",
                          "right": "PRAGMA"
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "export_statement",
                  "has": {
                    "field": "declaration",
                    "matches": "declares-pragma"
                  }
                }
              ]
            },
            "pragma-visible": {
              "any": [
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "program",
                    "has": {
                      "matches": "declares-pragma"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "statement_block",
                    "has": {
                      "matches": "declares-pragma"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "method_definition"
                      }
                    ],
                    "matches": "pragma-parameter"
                  }
                }
              ]
            },
            "pragma-parameter": {
              "any": [
                {
                  "has": {
                    "field": "parameters",
                    "has": {
                      "stopBy": "end",
                      "kind": "identifier",
                      "all": [
                        {
                          "pattern": "$DN"
                        },
                        {
                          "compare": {
                            "left": "DN",
                            "op": "eq",
                            "right": "PRAGMA"
                          }
                        }
                      ],
                      "binds": {
                        "form": "parameter"
                      }
                    }
                  }
                },
                {
                  "has": {
                    "field": "parameter",
                    "kind": "identifier",
                    "all": [
                      {
                        "pattern": "$DN"
                      },
                      {
                        "compare": {
                          "left": "DN",
                          "op": "eq",
                          "right": "PRAGMA"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          "transform": {
            "PRAGMA": {
              "replace": {
                "source": "$CM",
                "replace": "(?s)^.*?@jsx\\s+([_$a-zA-Z][_$a-zA-Z0-9]*)[\\s\\S]*$",
                "by": "${1}"
              }
            }
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react/react-in-jsx-scope",
        "message": "'$PRAGMA' must be in scope when using JSX",
        "suppress": {
          "eslint": {
            "rules": [
              "react/react-in-jsx-scope"
            ]
          },
          "oxlint": {
            "rules": [
              "react-in-jsx-scope"
            ]
          }
        }
      }
    }
  ]
}
