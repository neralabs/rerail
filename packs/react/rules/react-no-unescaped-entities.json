{
  "format": "rerail.policy/v1",
  "id": "react-no-unescaped-entities",
  "revision": 1,
  "mode": "steer",
  "description": "Escape \" and ' in JSX text as HTML entities or string expressions; a stray quote there is often a leftover from a string or attribute.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "double-quote",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "jsx_text",
            "regex": "(?<ENTITY>\")"
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.ENTITY",
        "code": "react/no-unescaped-entities",
        "message": "Write this \" in JSX text as &quot; or wrap it in a {'\"'} string expression.",
        "each": "ENTITY",
        "suppress": {
          "eslint": {
            "rules": [
              "react/no-unescaped-entities"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unescaped-entities"
            ]
          }
        }
      }
    },
    {
      "id": "single-quote",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "jsx_text",
            "regex": "(?<ENTITY>')"
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.ENTITY",
        "code": "react/no-unescaped-entities",
        "message": "Write this ' in JSX text as &apos; or wrap it in a {\"'\"} string expression.",
        "each": "ENTITY",
        "suppress": {
          "eslint": {
            "rules": [
              "react/no-unescaped-entities"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unescaped-entities"
            ]
          }
        }
      }
    }
  ]
}
