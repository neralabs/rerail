{
  "format": "rerail.policy/v1",
  "id": "react-no-find-dom-node",
  "revision": 1,
  "mode": "steer",
  "description": "Use refs instead of findDOMNode(); it is deprecated, fails in StrictMode and doesn't work with function components.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^findDOMNode$"
                },
                {
                  "kind": "member_expression",
                  "has": {
                    "field": "property",
                    "regex": "^findDOMNode$"
                  }
                }
              ]
            }
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react/no-find-dom-node",
        "message": "Replace findDOMNode() with a ref on the element you need; findDOMNode is deprecated and fails in StrictMode.",
        "suppress": {
          "eslint": {
            "rules": [
              "react/no-find-dom-node"
            ]
          },
          "oxlint": {
            "rules": [
              "no-find-dom-node"
            ]
          }
        }
      }
    }
  ]
}
