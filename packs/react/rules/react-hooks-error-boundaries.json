{
  "format": "rerail.policy/v1",
  "id": "react-hooks-error-boundaries",
  "revision": 1,
  "mode": "steer",
  "description": "Build JSX outside try blocks in React components and hooks, and catch rendering errors with an error boundary instead; a try/catch never sees them.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "fn": {
            "any": [
              {
                "kind": "function_declaration"
              },
              {
                "kind": "generator_function_declaration"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "arrow_function"
              },
              {
                "kind": "method_definition"
              }
            ]
          },
          "babel-fn": {
            "any": [
              {
                "kind": "function_declaration"
              },
              {
                "kind": "generator_function_declaration"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "arrow_function"
              }
            ]
          },
          "fn-expression": {
            "any": [
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "arrow_function"
              }
            ]
          },
          "class": {
            "any": [
              {
                "kind": "class_declaration"
              },
              {
                "kind": "abstract_class_declaration"
              },
              {
                "kind": "class"
              }
            ]
          },
          "jsx": {
            "any": [
              {
                "kind": "jsx_element"
              },
              {
                "kind": "jsx_self_closing_element"
              }
            ]
          },
          "hook-call": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^use[A-Z0-9]"
                },
                {
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "kind": "identifier",
                        "regex": "^[A-Z]"
                      }
                    },
                    {
                      "has": {
                        "field": "property",
                        "kind": "property_identifier",
                        "regex": "^use[A-Z0-9]"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "calls-hooks-or-creates-jsx": {
            "has": {
              "stopBy": {
                "matches": "babel-fn"
              },
              "any": [
                {
                  "matches": "jsx"
                },
                {
                  "matches": "hook-call"
                }
              ]
            }
          },
          "named-component": {
            "any": [
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "generator_function_declaration"
                  }
                ],
                "has": {
                  "field": "name",
                  "regex": "^[A-Z]"
                }
              },
              {
                "matches": "fn-expression",
                "any": [
                  {
                    "inside": {
                      "field": "value",
                      "kind": "variable_declarator",
                      "has": {
                        "field": "name",
                        "kind": "identifier",
                        "regex": "^[A-Z]"
                      }
                    }
                  },
                  {
                    "inside": {
                      "kind": "parenthesized_expression",
                      "inside": {
                        "field": "value",
                        "kind": "variable_declarator",
                        "has": {
                          "field": "name",
                          "kind": "identifier",
                          "regex": "^[A-Z]"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "named-hook": {
            "any": [
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "generator_function_declaration"
                  }
                ],
                "has": {
                  "field": "name",
                  "regex": "^use[A-Z0-9]"
                }
              },
              {
                "matches": "fn-expression",
                "any": [
                  {
                    "inside": {
                      "field": "value",
                      "kind": "variable_declarator",
                      "has": {
                        "field": "name",
                        "kind": "identifier",
                        "regex": "^use[A-Z0-9]"
                      }
                    }
                  },
                  {
                    "inside": {
                      "kind": "parenthesized_expression",
                      "inside": {
                        "field": "value",
                        "kind": "variable_declarator",
                        "has": {
                          "field": "name",
                          "kind": "identifier",
                          "regex": "^use[A-Z0-9]"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "memo-callback": {
            "matches": "fn-expression",
            "inside": {
              "kind": "arguments",
              "inside": {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "any": [
                    {
                      "kind": "identifier",
                      "regex": "^(?:memo|forwardRef)$"
                    },
                    {
                      "kind": "member_expression",
                      "all": [
                        {
                          "has": {
                            "field": "object",
                            "kind": "identifier",
                            "regex": "^React$"
                          }
                        },
                        {
                          "has": {
                            "field": "property",
                            "regex": "^(?:memo|forwardRef)$"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "parameter": {
            "any": [
              {
                "kind": "required_parameter"
              },
              {
                "kind": "optional_parameter"
              },
              {
                "kind": "identifier"
              },
              {
                "kind": "object_pattern"
              },
              {
                "kind": "array_pattern"
              },
              {
                "kind": "assignment_pattern"
              },
              {
                "kind": "rest_pattern"
              }
            ]
          },
          "non-props-type": {
            "any": [
              {
                "kind": "predefined_type",
                "regex": "^(?:bigint|boolean|number|string|symbol|never)$"
              },
              {
                "kind": "literal_type",
                "not": {
                  "regex": "^(?:null|undefined)$"
                }
              },
              {
                "kind": "template_literal_type"
              },
              {
                "kind": "array_type"
              },
              {
                "kind": "tuple_type"
              },
              {
                "kind": "function_type"
              },
              {
                "kind": "constructor_type"
              }
            ]
          },
          "invalid-component-params": {
            "has": {
              "field": "parameters",
              "kind": "formal_parameters",
              "any": [
                {
                  "count": {
                    "has": {
                      "matches": "parameter"
                    },
                    "min": 3
                  }
                },
                {
                  "has": {
                    "matches": "parameter",
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "matches": "parameter"
                      }
                    },
                    "has": {
                      "field": "type",
                      "kind": "type_annotation",
                      "has": {
                        "matches": "non-props-type"
                      }
                    }
                  }
                },
                {
                  "count": {
                    "has": {
                      "matches": "parameter"
                    },
                    "max": 1
                  },
                  "has": {
                    "matches": "parameter",
                    "any": [
                      {
                        "kind": "rest_pattern"
                      },
                      {
                        "has": {
                          "field": "pattern",
                          "kind": "rest_pattern"
                        }
                      }
                    ]
                  }
                },
                {
                  "count": {
                    "has": {
                      "matches": "parameter"
                    },
                    "min": 2,
                    "max": 2
                  },
                  "has": {
                    "matches": "parameter",
                    "nthChild": {
                      "position": 2,
                      "ofRule": {
                        "matches": "parameter"
                      }
                    },
                    "not": {
                      "any": [
                        {
                          "kind": "identifier",
                          "regex": "[rR]ef"
                        },
                        {
                          "all": [
                            {
                              "has": {
                                "field": "pattern",
                                "kind": "identifier",
                                "regex": "[rR]ef"
                              }
                            },
                            {
                              "not": {
                                "has": {
                                  "field": "value",
                                  "regex": "[\\s\\S]"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "non-node-value": {
            "any": [
              {
                "kind": "object"
              },
              {
                "kind": "arrow_function"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              },
              {
                "kind": "class"
              },
              {
                "kind": "new_expression"
              },
              {
                "kind": "number",
                "regex": "n$"
              }
            ]
          },
          "non-node": {
            "any": [
              {
                "matches": "non-node-value"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "non-node-value"
                }
              }
            ]
          },
          "holds-return": {
            "any": [
              {
                "kind": "return_statement"
              },
              {
                "not": {
                  "matches": "fn"
                },
                "has": {
                  "stopBy": {
                    "matches": "fn"
                  },
                  "kind": "return_statement"
                }
              }
            ]
          },
          "later-return": {
            "any": [
              {
                "precedes": {
                  "stopBy": "end",
                  "matches": "holds-return"
                }
              },
              {
                "inside": {
                  "stopBy": {
                    "matches": "fn"
                  },
                  "not": {
                    "matches": "fn"
                  },
                  "precedes": {
                    "stopBy": "end",
                    "matches": "holds-return"
                  }
                }
              }
            ]
          },
          "returns-non-node": {
            "any": [
              {
                "kind": "arrow_function",
                "has": {
                  "field": "body",
                  "matches": "non-node"
                }
              },
              {
                "has": {
                  "stopBy": {
                    "matches": "fn"
                  },
                  "kind": "return_statement",
                  "any": [
                    {
                      "regex": "^return\\s*;?$"
                    },
                    {
                      "has": {
                        "matches": "non-node"
                      }
                    }
                  ],
                  "not": {
                    "matches": "later-return"
                  }
                }
              }
            ]
          },
          "component-or-hook": {
            "any": [
              {
                "all": [
                  {
                    "matches": "named-component"
                  },
                  {
                    "matches": "calls-hooks-or-creates-jsx"
                  },
                  {
                    "not": {
                      "matches": "invalid-component-params"
                    }
                  },
                  {
                    "not": {
                      "matches": "returns-non-node"
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "matches": "named-hook"
                  },
                  {
                    "matches": "calls-hooks-or-creates-jsx"
                  }
                ]
              },
              {
                "all": [
                  {
                    "matches": "memo-callback"
                  },
                  {
                    "matches": "calls-hooks-or-creates-jsx"
                  }
                ]
              }
            ]
          },
          "declares-component-or-hook": {
            "any": [
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "generator_function_declaration"
                  }
                ],
                "has": {
                  "field": "name",
                  "regex": "^(?:[A-Z]|use[A-Z0-9])"
                }
              },
              {
                "any": [
                  {
                    "kind": "lexical_declaration"
                  },
                  {
                    "kind": "variable_declaration"
                  }
                ],
                "has": {
                  "kind": "variable_declarator",
                  "all": [
                    {
                      "has": {
                        "field": "name",
                        "kind": "identifier",
                        "regex": "^(?:[A-Z]|use[A-Z0-9])"
                      }
                    },
                    {
                      "has": {
                        "field": "value",
                        "any": [
                          {
                            "matches": "fn-expression"
                          },
                          {
                            "kind": "parenthesized_expression",
                            "has": {
                              "matches": "fn-expression"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          },
          "may-contain-react": {
            "any": [
              {
                "matches": "declares-component-or-hook"
              },
              {
                "kind": "export_statement",
                "has": {
                  "field": "declaration",
                  "matches": "declares-component-or-hook"
                }
              },
              {
                "kind": "export_statement",
                "has": {
                  "field": "value",
                  "any": [
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "parenthesized_expression",
                      "has": {
                        "matches": "fn-expression"
                      }
                    },
                    {
                      "all": [
                        {
                          "any": [
                            {
                              "kind": "function_expression"
                            },
                            {
                              "kind": "generator_function"
                            }
                          ]
                        },
                        {
                          "any": [
                            {
                              "not": {
                                "has": {
                                  "field": "name",
                                  "regex": "[\\s\\S]"
                                }
                              }
                            },
                            {
                              "has": {
                                "field": "name",
                                "regex": "^(?:[A-Z]|use[A-Z0-9])"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "compiled": {
            "all": [
              {
                "matches": "babel-fn"
              },
              {
                "matches": "component-or-hook"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "matches": "class"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "all": [
                      {
                        "matches": "babel-fn"
                      },
                      {
                        "matches": "component-or-hook"
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "end",
                    "kind": "catch_clause",
                    "has": {
                      "field": "parameter",
                      "any": [
                        {
                          "kind": "object_pattern"
                        },
                        {
                          "kind": "array_pattern"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "end",
                    "kind": "class_declaration",
                    "has": {
                      "field": "name",
                      "binds": {
                        "used": true
                      }
                    }
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "program",
                  "has": {
                    "matches": "may-contain-react"
                  }
                }
              }
            ]
          },
          "value-carrier": {
            "any": [
              {
                "kind": "jsx_element"
              },
              {
                "kind": "jsx_self_closing_element"
              },
              {
                "kind": "jsx_opening_element"
              },
              {
                "kind": "jsx_attribute"
              },
              {
                "kind": "jsx_expression"
              },
              {
                "kind": "parenthesized_expression"
              },
              {
                "kind": "ternary_expression"
              },
              {
                "kind": "binary_expression"
              }
            ]
          },
          "discarded-root": {
            "any": [
              {
                "inside": {
                  "kind": "expression_statement"
                }
              },
              {
                "inside": {
                  "kind": "unary_expression",
                  "regex": "^void\\b"
                }
              }
            ]
          },
          "stored-root": {
            "any": [
              {
                "inside": {
                  "field": "value",
                  "kind": "variable_declarator"
                }
              },
              {
                "inside": {
                  "field": "right",
                  "kind": "assignment_expression",
                  "inside": {
                    "kind": "expression_statement"
                  },
                  "has": {
                    "field": "left",
                    "kind": "identifier"
                  }
                }
              }
            ]
          },
          "read-outside-yield": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "shorthand_property_identifier"
              }
            ],
            "not": {
              "any": [
                {
                  "inside": {
                    "field": "name",
                    "kind": "variable_declarator"
                  }
                },
                {
                  "inside": {
                    "field": "left",
                    "kind": "assignment_expression"
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "matches": "fn"
                    },
                    "kind": "yield_expression"
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "matches": "fn-expression",
                    "inside": {
                      "field": "value",
                      "kind": "variable_declarator",
                      "has": {
                        "field": "name",
                        "kind": "identifier",
                        "binds": {
                          "used": false
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "stored-and-read-root": {
            "any": [
              {
                "inside": {
                  "field": "value",
                  "kind": "variable_declarator",
                  "has": {
                    "field": "name",
                    "kind": "identifier",
                    "binds": {
                      "used": true,
                      "occurrence": {
                        "matches": "read-outside-yield"
                      }
                    }
                  }
                }
              },
              {
                "inside": {
                  "field": "right",
                  "kind": "assignment_expression",
                  "inside": {
                    "kind": "expression_statement"
                  },
                  "has": {
                    "field": "left",
                    "kind": "identifier",
                    "resolves": {
                      "binding": {
                        "used": true,
                        "occurrence": {
                          "matches": "read-outside-yield"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "discarded": {
            "any": [
              {
                "matches": "discarded-root"
              },
              {
                "inside": {
                  "stopBy": {
                    "not": {
                      "matches": "value-carrier"
                    }
                  },
                  "matches": "value-carrier",
                  "all": [
                    {
                      "matches": "discarded-root"
                    }
                  ]
                }
              }
            ]
          },
          "stored": {
            "any": [
              {
                "matches": "stored-root"
              },
              {
                "inside": {
                  "stopBy": {
                    "not": {
                      "matches": "value-carrier"
                    }
                  },
                  "matches": "value-carrier",
                  "all": [
                    {
                      "matches": "stored-root"
                    }
                  ]
                }
              }
            ]
          },
          "stored-and-read": {
            "any": [
              {
                "matches": "stored-and-read-root"
              },
              {
                "inside": {
                  "stopBy": {
                    "not": {
                      "matches": "value-carrier"
                    }
                  },
                  "matches": "value-carrier",
                  "all": [
                    {
                      "matches": "stored-and-read-root"
                    }
                  ]
                }
              }
            ]
          },
          "built-in-try": {
            "all": [
              {
                "inside": {
                  "stopBy": {
                    "matches": "fn"
                  },
                  "kind": "statement_block",
                  "inside": {
                    "kind": "try_statement",
                    "has": {
                      "field": "handler",
                      "kind": "catch_clause"
                    }
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": {
                      "matches": "fn"
                    },
                    "any": [
                      {
                        "kind": "finally_clause"
                      },
                      {
                        "kind": "yield_expression"
                      },
                      {
                        "kind": "try_statement",
                        "not": {
                          "has": {
                            "field": "handler",
                            "kind": "catch_clause"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "inside": {
                  "stopBy": {
                    "matches": "fn"
                  },
                  "matches": "compiled"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "jsx-in-try",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "matches": "jsx",
            "all": [
              {
                "matches": "built-in-try"
              },
              {
                "not": {
                  "matches": "discarded"
                }
              },
              {
                "not": {
                  "matches": "stored"
                }
              }
            ]
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react-hooks/error-boundaries",
        "message": "Build this JSX outside the try block: React renders it later, so the catch never sees its errors. Wrap the component in an error boundary to handle rendering errors.",
        "suppress": {
          "eslint": {
            "rules": [
              "react-hooks/error-boundaries"
            ]
          },
          "oxlint": {
            "rules": [
              "error-boundaries"
            ]
          }
        }
      }
    },
    {
      "id": "stored-jsx-in-try",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "matches": "jsx",
            "all": [
              {
                "matches": "built-in-try"
              },
              {
                "matches": "stored-and-read"
              }
            ]
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react-hooks/error-boundaries",
        "message": "Build this JSX outside the try block: React renders it later, so the catch never sees its errors. Wrap the component in an error boundary to handle rendering errors.",
        "suppress": {
          "eslint": {
            "rules": [
              "react-hooks/error-boundaries"
            ]
          },
          "oxlint": {
            "rules": [
              "error-boundaries"
            ]
          }
        }
      }
    }
  ]
}
