    {
      "id": "react-no-danger-with-children",
      "document": "rules/react-no-danger-with-children.json",
      "title": "react/no-danger-with-children: No danger with children",
      "group": "eslint-plugin-react"
    },
    {
      "id": "react-button-has-type",
      "document": "rules/react-button-has-type.json",
      "title": "react/button-has-type: Button has type",
      "group": "eslint-plugin-react"
    },
    {
      "id": "react-jsx-key",
      "document": "rules/react-jsx-key.json",
      "title": "react/jsx-key: JSX key",
      "group": "eslint-plugin-react",
      "examples": {
        "caught": {
          "path": "src/List.tsx",
          "text": "export const List = ({ items }) => <ul>{items.map(item => <li>{item.name}</li>)}</ul>;\n"
        },
        "passes": {
          "path": "src/List.tsx",
          "text": "export const List = ({ items }) => <ul>{items.map(item => <li key={item.id}>{item.name}</li>)}</ul>;\n"
        }
      }
    },
    {
      "id": "react-jsx-no-undef",
      "document": "rules/react-jsx-no-undef.json",
      "title": "react/jsx-no-undef: JSX no undef",
