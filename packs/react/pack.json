{
  "format": "rerail.rule-pack/v1",
  "id": "react",
  "name": "React",
  "category": "framework",
  "covers": "18 eslint-plugin-react and eslint-plugin-react-hooks rules ported to Rerail, each scored against the plugin's own recorded findings on its test cases.",
  "reason": "matches React",
  "match": {
    "any": [
      {
        "npmDependencies": [
          "react"
        ]
      },
      {
        "files": [
          "**/*.jsx"
        ],
        "label": "*.jsx files"
      }
    ]
  },
  "rules": [
    {
      "id": "react-no-danger",
      "document": "rules/react-no-danger.json",
      "title": "react/no-danger: No danger",
      "group": "eslint-plugin-react",
      "examples": {
        "caught": {
          "path": "src/Note.jsx",
          "text": "export const Note = ({ html }) => <div dangerouslySetInnerHTML={{ __html: html }} />;\n"
        },
        "passes": {
          "path": "src/Note.jsx",
          "text": "export const Note = ({ text }) => <div>{text}</div>;\n"
        }
      }
    },
    {
      "id": "react-no-find-dom-node",
      "document": "rules/react-no-find-dom-node.json",
      "title": "react/no-find-dom-node: No find DOM node",
      "group": "eslint-plugin-react"
    },
    {
      "id": "react-no-is-mounted",
      "document": "rules/react-no-is-mounted.json",
      "title": "react/no-is-mounted: No is mounted",
      "group": "eslint-plugin-react"
    },
    {
      "id": "react-no-render-return-value",
      "document": "rules/react-no-render-return-value.json",
      "title": "react/no-render-return-value: No render return value",
      "group": "eslint-plugin-react"
    },
    {
      "id": "react-jsx-no-duplicate-props",
      "document": "rules/react-jsx-no-duplicate-props.json",
      "title": "react/jsx-no-duplicate-props: JSX no duplicate props",
      "group": "eslint-plugin-react"
    },
    {
      "id": "react-no-children-prop",
      "document": "rules/react-no-children-prop.json",
      "title": "react/no-children-prop: No children prop",
      "group": "eslint-plugin-react"
    },
    {
      "id": "react-jsx-no-comment-textnodes",
      "document": "rules/react-jsx-no-comment-textnodes.json",
      "title": "react/jsx-no-comment-textnodes: JSX no comment textnodes",
      "group": "eslint-plugin-react"
    },
    {
      "id": "react-void-dom-elements-no-children",
      "document": "rules/react-void-dom-elements-no-children.json",
      "title": "react/void-dom-elements-no-children: Void DOM elements no children",
