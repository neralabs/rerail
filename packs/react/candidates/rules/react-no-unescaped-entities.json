{
  "format": "rerail.policy/v1",
  "id": "react-no-unescaped-entities",
  "revision": 1,
  "mode": "steer",
  "description": "Escape >, \", ' and } in JSX text as HTML entities or expressions; unescaped they are usually typos for a closing tag or brace.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "entity-1",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "jsx_text",
            "regex": "\\A(?:[^\\n>\"'}]*[>\"'}]){1}"
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react/no-unescaped-entities",
        "message": "HTML entity must be escaped.",
        "suppress": {
          "eslint": {
            "rules": [
              "react/no-unescaped-entities"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unescaped-entities"
            ]
          }
        }
      }
    },
    {
