{
  "format": "rerail.policy/v1",
  "id": "react-jsx-no-duplicate-props",
  "revision": 1,
  "mode": "steer",
  "description": "Don't give a JSX element the same prop twice; only the last value takes effect.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "jsx_attribute",
            "has": {
              "kind": "property_identifier",
              "pattern": "$NAME"
            },
            "follows": {
              "stopBy": "end",
              "kind": "jsx_attribute",
              "has": {
                "kind": "property_identifier",
                "pattern": "$EARLIER"
              },
              "compare": {
                "left": "EARLIER",
                "op": "eq",
                "right": "NAME"
              }
            }
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react/jsx-no-duplicate-props",
        "message": "Remove one of the two `$NAME` props on this element; only the last one takes effect.",
        "suppress": {
          "eslint": {
            "rules": [
              "react/jsx-no-duplicate-props"
            ]
          },
          "oxlint": {
            "rules": [
              "jsx-no-duplicate-props"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noDuplicateJsxProps"
            ]
          }
        }
      }
    }
  ]
}
