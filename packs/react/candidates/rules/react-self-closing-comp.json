{
  "format": "rerail.policy/v1",
  "id": "react-self-closing-comp",
  "revision": 1,
  "mode": "steer",
  "description": "Write elements without children as self-closing tags instead of an empty opening and closing pair.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "jsx_opening_element",
            "any": [
              {
                "has": {
                  "field": "name",
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "member_expression"
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "name",
                  "kind": "jsx_namespace_name",
                  "regex": "^[a-z]"
                }
              }
            ],
            "inside": {
              "stopBy": "neighbor",
              "kind": "jsx_element",
              "not": {
                "has": {
                  "not": {
                    "any": [
                      {
                        "kind": "jsx_opening_element"
                      },
                      {
                        "kind": "jsx_closing_element"
                      },
                      {
                        "kind": "jsx_text",
                        "regex": "^[\\s&&[^\\xA0]]*\\n[\\s&&[^\\xA0]]*$"
                      }
                    ]
                  }
                }
              }
            }
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react/self-closing-comp",
        "message": "Replace this empty opening and closing tag pair with a self-closing tag.",
        "suppress": {
          "eslint": {
            "rules": [
              "react/self-closing-comp"
            ]
          },
          "oxlint": {
            "rules": [
              "self-closing-comp"
            ]
          }
        }
      }
    }
  ]
}
