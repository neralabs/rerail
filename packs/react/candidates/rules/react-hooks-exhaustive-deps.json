                        }
                      },
                      {
                        "resolves": {
                          "binding": {
                            "site": {
                              "all": [
                                {
                                  "inside": {
                                    "stopBy": "end",
                                    "matches": "fn",
                                    "pattern": "$SC",
                                    "compare": {
                                      "left": "SC",
                                      "op": "eq",
                                      "right": "C",
                                      "text": "node"
                                    }
                                  }
                                },
                                {
                                  "not": {
                                    "inside": {
                                      "stopBy": "end",
                                      "pattern": "$SCB",
                                      "compare": {
                                        "left": "SCB",
                                        "op": "eq",
                                        "right": "CB",
                                        "text": "node"
                                      }
                                    }
                                  }
                                },
                                {
                                  "not": {
                                    "matches": "stable-site"
                                  }
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "not": {
                          "inside": {
                            "stopBy": "end",
                            "kind": "array",
                            "pattern": "$D2",
                            "compare": {
                              "left": "D2",
                              "op": "eq",
                              "right": "DEPS",
                              "text": "node"
                            }
