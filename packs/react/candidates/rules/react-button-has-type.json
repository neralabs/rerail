              }
            }
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "react/button-has-type",
        "message": "Add type=\"button\" to this button, or type=\"submit\" if it should submit its form.",
        "suppress": {
