{
  "format": "rerail.policy/v1",
  "id": "react-no-array-index-key",
  "revision": 1,
  "mode": "steer",
  "description": "Use a stable id from the item, not the array index, as a list key; index keys mix up state and rendering when items are reordered, inserted or removed.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.d.ts"
    ]
  },
  "clauses": [
    {
      "id": "index-key",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "jsx_attribute",
            "all": [
              {
                "has": {
                  "kind": "property_identifier",
                  "regex": "^key$"
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "regex": "\\.(?:map|forEach|filter|some|every|find|findIndex|flatMap|reduce|reduceRight)$"
                  },
                  "pattern": "$ARRAY.$METHOD(($ITEM, $INDEX) => $$$BODY)"
                }
              },
              {
                "has": {
                  "kind": "jsx_expression",
                  "has": {
                    "stopBy": "end",
                    "kind": "identifier",
                    "pattern": "$INDEX"
                  }
                }
              }
            ]
          },
          "file": {
            "jsxRuntime": [
              "react",
              "unknown"
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "react/no-array-index-key",
        "message": "Do not use the array index as a key; use a stable id from the item.",
        "suppress": {
          "eslint": {
            "rules": [
              "react/no-array-index-key"
            ]
          },
          "oxlint": {
            "rules": [
              "no-array-index-key"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noArrayIndexKey"
            ]
          }
        }
      }
    }
  ]
}
