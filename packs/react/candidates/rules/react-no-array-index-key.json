{
  "format": "rerail.policy/v1",
  "id": "react:no-array-index-key",
  "revision": 1,
  "mode": "steer",
  "description": "A `key` built from the index parameter of an array method's callback.",
  "scope": {
    "include": [
      "**/*.jsx",
      "**/*.tsx"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.d.ts"
    ]
  },
  "clauses": [
    {
      "id": "index-key",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "jsx_attribute",
            "all": [
              {
                "has": {
                  "kind": "property_identifier",
                  "regex": "^key$"
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "call_expression",
                  "has": {
                    "field": "function",
                    "regex": "\\.(?:map|forEach|filter|some|every|find|findIndex|flatMap|reduce|reduceRight)$"
                  },
                  "pattern": "$ARRAY.$METHOD(($ITEM, $INDEX) => $$$BODY)"
                }
              },
              {
                "has": {
                  "kind": "jsx_expression",
                  "has": {
                    "stopBy": "end",
                    "kind": "identifier",
                    "pattern": "$INDEX"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_ARRAY_INDEX_KEY",
        "message": "Do not use the array index as a key; use a stable id from the item.",
        "suppress": {
          "eslint": {
            "rules": [
              "react/no-array-index-key"
            ]
          }
        }
      }
    }
  ]
}
