{
  "pack": "react-probes",
  "family": "ecma",
  "capabilities": [
    "syntax",
    "scope"
  ],
  "tools": [
    {
      "name": "labels",
      "version": "1"
    }
  ],
  "oracles": ".",
  "rules": [
    {
      "id": "react-component-function",
      "upstream": {
        "tool": "labels",
        "rule": "react-probe/component-function"
      },
      "policy": "rules/react-component-function.json",
      "capabilities": [
        "syntax"
      ],
      "match": "line+column"
    },
    {
      "id": "react-component-class",
      "upstream": {
        "tool": "labels",
        "rule": "react-probe/component-class"
      },
      "policy": "rules/react-component-class.json",
      "capabilities": [
        "syntax"
      ],
      "match": "line+column"
    },
    {
      "id": "react-component-wrapped",
      "upstream": {
        "tool": "labels",
        "rule": "react-probe/component-wrapped"
      },
      "policy": "rules/react-component-wrapped.json",
      "capabilities": [
        "syntax"
      ],
      "match": "line+column"
    },
    {
      "id": "react-hook-call",
      "upstream": {
        "tool": "labels",
        "rule": "react-probe/hook-call"
      },
      "policy": "rules/react-hook-call.json",
      "capabilities": [
        "syntax"
      ],
      "match": "line+column"
    },
    {
      "id": "react-custom-hook",
      "upstream": {
        "tool": "labels",
