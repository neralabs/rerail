    {
      "id": "react-runtime-classic-unused-react",
      "upstream": {
        "tool": "labels",
        "rule": "react-probe/runtime-classic-unused-react"
      },
      "policy": "rules/react-runtime-classic-unused-react.json",
      "capabilities": [
        "scope"
      ],
      "match": "line+column"
    },
    {
      "id": "react-runtime-automatic-unused-react",
      "upstream": {
        "tool": "labels",
        "rule": "react-probe/runtime-automatic-unused-react"
      },
      "policy": "rules/react-runtime-automatic-unused-react.json",
      "capabilities": [
