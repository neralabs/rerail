{
  "format": "rerail.policy/v1",
  "id": "tslint:no-void-expression/ignore-arrow-function-shorthand",
  "revision": 1,
  "mode": "steer",
  "description": "no-void-expression with ignore-arrow-function-shorthand (syntactic approximation, console.* only).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "void-expression",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "call_expression"
              },
              {
                "pattern": "console.$M($$$A)"
              },
              {
                "not": {
                  "any": [
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "kind": "expression_statement"
                          },
                          {
                            "kind": "ternary_expression"
                          },
                          {
                            "kind": "arrow_function"
                          }
                        ]
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "binary_expression",
                        "any": [
                          {
                            "inside": {
                              "stopBy": "neighbor",
                              "any": [
                                {
                                  "kind": "expression_statement"
                                },
                                {
                                  "kind": "ternary_expression"
                                },
                                {
                                  "kind": "arrow_function"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "binary_expression",
                        "any": [
                          {
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "binary_expression",
                              "any": [
                                {
                                  "inside": {
                                    "stopBy": "neighbor",
                                    "any": [
                                      {
                                        "kind": "expression_statement"
                                      },
                                      {
                                        "kind": "ternary_expression"
                                      },
                                      {
                                        "kind": "arrow_function"
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-void-expression",
        "message": "Expression has type `void`. Put it on its own line as a statement."
      }
    }
  ]
}
