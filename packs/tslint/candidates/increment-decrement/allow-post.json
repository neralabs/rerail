{
  "format": "rerail.policy/v1",
  "id": "tslint:increment-decrement",
  "revision": 1,
  "mode": "steer",
  "description": "Bans ++ and -- (option allow-post: prefix only).",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "increment-decrement",
      "forbid": { "ast": { "language": "typescript", "rule": {"all":[{"kind":"update_expression"},{"regex":"^(\\+\\+|--)"}]} } },
      "violation": { "anchor": "witness.span", "code": "INCREMENT_DECREMENT", "message": "Use an explicit += 1 or -= 1 operator." }
    }
  ]
}
