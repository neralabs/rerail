{
  "format": "rerail.policy/v1",
  "id": "tslint:import-blacklist",
  "revision": 1,
  "mode": "steer",
  "description": "Disallows importing blacklisted modules/exports. TSLint's default blacklist is empty (an empty doc does not compile), so this doc ports the fixture's options: rxjs, lodash[pullAll,pull], dummy[default], /.*\\.temp$/, /.*\\.tmp$/.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "whole-module-rxjs",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string_fragment"
              },
              {
                "regex": "^rxjs$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "string",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "any": [
                          {
                            "kind": "import_statement"
                          },
                          {
                            "kind": "export_statement"
                          },
                          {
                            "kind": "import_require_clause"
                          }
                        ]
                      },
                      {
                        "all": [
                          {
                            "kind": "arguments"
                          },
                          {
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "call_expression",
                              "regex": "^(require|import)\\s*\\("
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "import-blacklist",
        "message": "Importing this module is blacklisted. Try importing a submodule instead."
      }
    },
    {
      "id": "implicit-named-lodash",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "all": [
                  {
                    "kind": "string_fragment"
                  },
                  {
                    "regex": "^lodash$"
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "inside": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "any": [
                              {
                                "kind": "import_statement"
                              },
                              {
                                "kind": "export_statement"
                              },
                              {
                                "kind": "import_require_clause"
                              }
                            ]
                          },
                          {
                            "all": [
                              {
                                "kind": "arguments"
                              },
                              {
                                "inside": {
                                  "stopBy": "neighbor",
                                  "kind": "call_expression",
                                  "regex": "^(require|import)\\s*\\("
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "all": [
                            {
                              "kind": "import_statement"
                            },
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "all": [
                                  {
                                    "kind": "import_clause"
                                  },
                                  {
                                    "any": [
                                      {
                                        "regex": "^[A-Za-z_$]"
                                      },
                                      {
                                        "has": {
                                          "stopBy": "neighbor",
                                          "kind": "named_imports"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "all": [
                            {
                              "kind": "export_statement"
                            },
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "kind": "export_clause"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "import-blacklist",
        "message": "Some named exports from this module are blacklisted for importing (or re-exporting). Import/re-export only the specific values you want, instead of the whole module."
      }
    },
    {
      "id": "named-lodash",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "all": [
                  {
                    "kind": "import_clause"
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "import_statement",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string",
                        "regex": "^['\"]lodash['\"]$"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "end",
                      "all": [
                        {
                          "any": [
                            {
                              "kind": "import_specifier"
                            },
                            {
                              "kind": "export_specifier"
                            }
                          ]
                        },
                        {
                          "regex": "^(pullAll|pull)\\b"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "kind": "export_clause"
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "export_statement",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string",
                        "regex": "^['\"]lodash['\"]$"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "end",
                      "all": [
                        {
                          "any": [
                            {
                              "kind": "import_specifier"
                            },
                            {
                              "kind": "export_specifier"
                            }
                          ]
                        },
                        {
                          "regex": "^(pullAll|pull)\\b"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "import-blacklist",
        "message": "The export \"pull\"/\"pullAll\" is blacklisted."
      }
    },
    {
      "id": "default-dummy",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "all": [
                  {
                    "kind": "import_clause"
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "import_statement",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string",
                        "regex": "^['\"]dummy['\"]$"
                      }
                    }
                  },
                  {
                    "any": [
                      {
                        "regex": "^[A-Za-z_$]"
                      },
                      {
                        "has": {
                          "stopBy": "end",
                          "all": [
                            {
                              "any": [
                                {
                                  "kind": "import_specifier"
                                },
                                {
                                  "kind": "export_specifier"
                                }
                              ]
                            },
                            {
                              "regex": "^(default)\\b"
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "all": [
                  {
                    "kind": "export_clause"
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "export_statement",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string",
                        "regex": "^['\"]dummy['\"]$"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "end",
                      "all": [
                        {
                          "any": [
                            {
                              "kind": "import_specifier"
                            },
                            {
                              "kind": "export_specifier"
                            }
                          ]
                        },
                        {
                          "regex": "^(default)\\b"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "import-blacklist",
        "message": "Importing (or re-exporting) the default export is blacklisted."
      }
    },
    {
      "id": "pattern-temp",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string_fragment"
              },
              {
                "regex": "\\.temp$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "string",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "any": [
                          {
                            "kind": "import_statement"
                          },
                          {
                            "kind": "export_statement"
                          },
                          {
                            "kind": "import_require_clause"
                          }
                        ]
                      },
                      {
                        "all": [
                          {
                            "kind": "arguments"
                          },
                          {
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "call_expression",
                              "regex": "^(require|import)\\s*\\("
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "import-blacklist",
        "message": "This import is blacklisted by /.*\\.temp$/"
      }
    },
    {
      "id": "pattern-tmp",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string_fragment"
              },
              {
                "regex": "\\.tmp$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "string",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "any": [
                          {
                            "kind": "import_statement"
                          },
                          {
                            "kind": "export_statement"
                          },
                          {
                            "kind": "import_require_clause"
                          }
                        ]
                      },
                      {
                        "all": [
                          {
                            "kind": "arguments"
                          },
                          {
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "call_expression",
                              "regex": "^(require|import)\\s*\\("
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "import-blacklist",
        "message": "This import is blacklisted by /.*\\.tmp$/"
      }
    }
  ]
}
