{
  "format": "rerail.policy/v1",
  "id": "tslint:no-namespace/allow-declarations",
  "revision": 1,
  "mode": "steer",
  "description": "Option allow-declarations: also allows `declare namespace` and any namespace in .d.ts files.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": [
      "**/*.d.ts"
    ]
  },
  "clauses": [
    {
      "id": "namespace",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "program"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "expression_statement",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "program"
                      }
                    }
                  }
                ]
              },
              {
                "any": [
                  {
                    "any": [
                      {
                        "kind": "internal_module"
                      },
                      {
                        "all": [
                          {
                            "kind": "module"
                          },
                          {
                            "not": {
                              "has": {
                                "stopBy": "neighbor",
                                "kind": "string"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "kind": "export_statement"
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "any": [
                            {
                              "kind": "internal_module"
                            },
                            {
                              "all": [
                                {
                                  "kind": "module"
                                },
                                {
                                  "not": {
                                    "has": {
                                      "stopBy": "neighbor",
                                      "kind": "string"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-namespace",
        "message": "'namespace' and 'module' are disallowed"
      }
    }
  ]
}
