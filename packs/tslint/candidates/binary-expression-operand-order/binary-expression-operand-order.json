{
  "format": "rerail.policy/v1",
  "id": "tslint:binary-expression-operand-order",
  "revision": 1,
  "mode": "steer",
  "description": "A literal should be on the right-hand side of a binary expression (text-regex approximation of the left/right operand split).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "literal-left",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "binary_expression"
              },
              {
                "regex": "^(?:(?:\\(\\s*)*(?:(?:\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*')|(?:-?\\s*(?:\\d[\\w.]*|\\.\\d[\\w.]*)|(?:true|false|null|undefined)\\b))(?:\\s*\\))*\\s*(?:===|!==|==|!=|<=|>=|<|>|&&|\\|\\||\\?\\?|&|\\||\\^|\\*|instanceof\\b)|(?:(?:\\(\\s*)*(?:-?\\s*(?:\\d[\\w.]*|\\.\\d[\\w.]*)|(?:true|false|null|undefined)\\b)(?:\\s*\\))*|(?:\\(\\s*)+(?:\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*')(?:\\s*\\))+)\\s*\\+)\\s*[^<>=&|*?\\s]"
              },
              {
                "not": {
                  "regex": "^(?:\\(\\s*)*(?:(?:\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*')|(?:-?\\s*(?:\\d[\\w.]*|\\.\\d[\\w.]*)|(?:true|false|null|undefined)\\b))(?:\\s*\\))*\\s*\\S+\\s*(?:\\(\\s*)*(?:(?:\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*')|(?:-?\\s*(?:\\d[\\w.]*|\\.\\d[\\w.]*)|(?:true|false|null|undefined)\\b))(?:\\s*\\))*$"
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "kind": "binary_expression"
                      },
                      {
                        "regex": "^(?:\\(\\s*)*(?:(?:\"(?:[^\"\\\\\\n]|\\\\.)*\"|'(?:[^'\\\\\\n]|\\\\.)*')|(?:-?\\s*(?:\\d[\\w.]*|\\.\\d[\\w.]*)|(?:true|false|null|undefined)\\b))(?:\\s*\\))*"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "binary-expression-operand-order",
        "message": "Literal expression should be on the right-hand side of a binary expression."
      }
    }
  ]
}