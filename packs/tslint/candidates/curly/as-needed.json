{
  "format": "rerail.policy/v1",
  "id": "tslint:curly/as-needed",
  "revision": 1,
  "mode": "steer",
  "description": "Flags blocks with a single statement under if/else/loops (as-needed).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-block",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "statement_block"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "not": {
                        "kind": "comment"
                      }
                    },
                    {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "^\\{$"
                      }
                    },
                    {
                      "precedes": {
                        "stopBy": "neighbor",
                        "regex": "^\\}$"
                      }
                    }
                  ]
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "for_statement"
                    },
                    {
                      "kind": "for_in_statement"
                    },
                    {
                      "kind": "while_statement"
                    },
                    {
                      "kind": "do_statement"
                    },
                    {
                      "kind": "if_statement"
                    },
                    {
                      "kind": "else_clause"
                    }
                  ]
                }
              },
              {
                "not": {
                  "all": [
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "if_statement",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "else_clause"
                        }
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "if_statement",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "else_clause"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "curly",
        "message": "Block contains only one statement; remove the curly braces."
      }
    }
  ]
}
