{
  "format": "rerail.policy/v1",
  "id": "tslint:no-use-before-declare",
  "revision": 1,
  "mode": "steer",
  "description": "Syntactic fragment only: flags an initializer that is a bare identifier declared later in the same declaration list (or by itself). General use-before-declare needs binding resolution.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "same-declaration",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "identifier"
              },
              {
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "^=$"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "variable_declarator",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "pattern": "var $A = $B, $B"
                      },
                      {
                        "pattern": "let $A = $B, $B"
                      },
                      {
                        "pattern": "const $A = $B, $B = $C"
                      },
                      {
                        "pattern": "var $B = $B"
                      },
                      {
                        "pattern": "let $B = $B"
                      },
                      {
                        "pattern": "const $B = $B"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-use-before-declare",
        "message": "variable used before declaration"
      }
    }
  ]
}
