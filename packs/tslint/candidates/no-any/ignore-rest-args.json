{
  "format": "rerail.policy/v1",
  "id": "tslint:no-any/ignore-rest-args",
  "revision": 1,
  "mode": "steer",
  "description": "Disallows `any` type declarations, except `...rest: any[]` (option ignore-rest-args).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "any-type",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "predefined_type"
              },
              {
                "regex": "^any$"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "array_type",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "type_annotation",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "required_parameter",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "rest_pattern"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-any",
        "message": "Type declaration of 'any' loses type-safety. Consider replacing it with a more precise type."
      }
    }
  ]
}