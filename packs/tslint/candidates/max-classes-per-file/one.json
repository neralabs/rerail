{
  "format": "rerail.policy/v1",
  "id": "tslint:max-classes-per-file/one",
  "revision": 1,
  "mode": "steer",
  "description": "A file may not contain more than 1 class (class expressions excluded): flags a class with 1 or more classes before it in document order (ancestors, and classes at or inside earlier siblings of the class or any ancestor); utility after-K holds when a class with K-1 classes before it precedes the node.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "too-many-classes",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {"all": [{"matches": "counted"}, {"matches": "after-1"}]},
          "utils": {
            "class": {"any": [{"kind": "class_declaration"}, {"kind": "abstract_class_declaration"}]},
            "counted": {
              "any": [
                {"matches": "class", "not": {"inside": {"kind": "export_statement"}}},
                {"kind": "export_statement", "has": {"matches": "class"}}
              ]
            },
            "at-or-around-1": {"any": [{"matches": "class"}, {"has": {"stopBy": "end", "matches": "class"}}]},
            "after-1": {
              "any": [
                {"inside": {"stopBy": "end", "matches": "class"}},
                {"follows": {"stopBy": "end", "matches": "at-or-around-1"}},
                {"inside": {"stopBy": "end", "follows": {"stopBy": "end", "matches": "at-or-around-1"}}}
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "max-classes-per-file",
        "message": "A maximum of 1 class per file is allowed."
      }
    }
  ]
}
