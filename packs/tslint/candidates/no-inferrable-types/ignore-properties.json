{
  "format": "rerail.policy/v1",
  "id": "tslint:no-inferrable-types/ignore-properties",
  "revision": 1,
  "mode": "steer",
  "description": "Option ignore-properties (also skips parameter properties).",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "inferrable-type",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "predefined_type",
            "regex": "^(?<T>number|boolean|string)$",
            "inside": {
              "stopBy": "neighbor",
              "kind": "type_annotation",
              "inside": { "stopBy": "neighbor", "matches": "declaration" }
            },
            "any": [
              {
                "regex": "^number$",
                "inside": { "stopBy": "neighbor", "precedes": { "stopBy": "end", "matches": "numeric" } }
              },
              {
                "regex": "^boolean$",
                "inside": {
                  "stopBy": "neighbor",
                  "precedes": { "stopBy": "end", "any": [{ "kind": "true" }, { "kind": "false" }] }
                }
              },
              {
                "regex": "^string$",
                "inside": {
                  "stopBy": "neighbor",
                  "precedes": { "stopBy": "end", "any": [{ "kind": "string" }, { "kind": "template_string" }] }
                }
              }
            ]
          },
          "utils": {
            "declaration": {
              "any": [
                { "kind": "variable_declarator" },
                {
                  "any": [{ "kind": "required_parameter" }, { "kind": "optional_parameter" }],
                  "not": {
                    "any": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "regex": "^readonly$",
                          "not": { "any": [{ "kind": "identifier" }, { "kind": "property_identifier" }] }
                        }
                      },
                      { "has": { "stopBy": "neighbor", "kind": "accessibility_modifier" } },
                      { "has": { "stopBy": "neighbor", "kind": "override_modifier" } }
                    ]
                  }
                }
              ]
            },
            "numeric": {
              "any": [
                { "kind": "number" },
                { "kind": "identifier", "regex": "^(?:Infinity|NaN)$" },
                { "kind": "unary_expression", "regex": "^[-+]", "has": { "stopBy": "neighbor", "matches": "numeric" } }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-inferrable-types",
        "message": "Type $T trivially inferred from a $T literal, remove type annotation"
      }
    }
  ]
}
