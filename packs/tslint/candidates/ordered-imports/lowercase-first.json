{
  "format": "rerail.policy/v1",
  "id": "tslint:ordered-imports/lowercase-first",
  "revision": 1,
  "mode": "steer",
  "description": "Options [{\"import-sources-order\":\"lowercase-first\",\"named-imports-order\":\"lowercase-first\"}]. Sources: an import (or import-equals require) fails when its module path sorts before the path of the import directly before it (through comments; any other statement ends the block), after TSLint's transform (lowercase-first), with relative paths (./ or /) sorting after library paths, as compare() does. Named imports: the first specifier whose next specifier sorts before it, as findUnsortedPair (lowercase-first). Not modelled: blank lines ending a block (trivia), grouped-imports/groups, module-source-path basename.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "sources",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "import_statement",
            "inside": {"any": [{"kind": "program"}, {"kind": "statement_block"}]},
            "all": [
              {"has": {"stopBy": "end", "matches": "source", "pattern": "$SRC"}},
              {"follows": {"matches": "previous-import"}},
              {
                "any": [
                  {
                    "all": [
                      {"has": {"stopBy": "end", "matches": "source", "all": [{"regex": "^['\"][^./]"}]}},
                      {
                        "follows": {
                          "matches": "previous-import",
                          "has": {"stopBy": "end", "matches": "source", "all": [{"regex": "^['\"][./]"}]}
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "any": [
                          {"has": {"stopBy": "end", "matches": "source", "all": [{"regex": "^['\"][./]"}]}},
                          {
                            "follows": {
                              "matches": "previous-import",
                              "has": {"stopBy": "end", "matches": "source", "all": [{"regex": "^['\"][^./]"}]}
                            }
                          }
                        ]
                      },
                      {
                        "compare": {
                          "left": "PREV",
                          "op": "gt",
                          "right": "SRC",
                          "collation": "lowercase-first",
                          "text": "unquoted"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "utils": {
            "source": {
              "kind": "string",
              "inside": {"any": [{"kind": "import_statement"}, {"kind": "import_require_clause"}]}
            },
            "previous-import": {
              "any": [
                {"kind": "import_statement", "has": {"stopBy": "end", "matches": "source", "pattern": "$PREV"}},
                {"kind": "comment", "follows": {"matches": "previous-import"}}
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "ordered-imports",
        "message": "Import sources within a group must be alphabetized ($SRC after $PREV)."
      }
    },
    {
      "id": "named-imports",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "import_specifier",
            "all": [
              {"matches": "unsorted"},
              {"not": {"follows": {"stopBy": "end", "kind": "import_specifier", "matches": "unsorted-before"}}}
            ]
          },
          "utils": {
            "unsorted": {
              "pattern": "$A",
              "precedes": {"stopBy": "end", "kind": "import_specifier", "pattern": "$B"},
              "compare": {"left": "B", "op": "lt", "right": "A", "collation": "lowercase-first"}
            },
            "unsorted-before": {
              "pattern": "$C",
              "precedes": {"stopBy": "end", "kind": "import_specifier", "pattern": "$D"},
              "compare": {"left": "D", "op": "lt", "right": "C", "collation": "lowercase-first"}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "ordered-imports",
        "message": "Named imports must be alphabetized ($B before $A)."
      }
    }
  ]
}
