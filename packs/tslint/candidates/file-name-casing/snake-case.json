{
  "format": "rerail.policy/v1",
  "id": "tslint:file-name-casing/snake-case",
  "revision": 1,
  "mode": "steer",
  "description": "File base name (without extension) must be snake-case (a casing option is required; this doc ports snake-case). Findings anchor at file start: the path regex match begins at offset 0.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "snake-case",
      "forbid": {
        "regex": {
          "source": "file.path",
          "pattern": "\\A(?:.*/)?(?:[^/]*[A-Z-][^/]*\\.[^./]*|[^./]*[A-Z-][^./]*)$"
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "file-name-casing",
        "message": "File name must be snake_case"
      }
    }
  ]
}