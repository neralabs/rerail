{
  "format": "rerail.policy/v1",
  "id": "tslint:file-name-casing/pascal-case",
  "revision": 1,
  "mode": "steer",
  "description": "File base name (without extension) must be pascal-case (a casing option is required; this doc ports pascal-case). Findings anchor at file start: the path regex match begins at offset 0.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "pascal-case",
      "forbid": {
        "regex": {
          "source": "file.path",
          "pattern": "\\A(?:.*/)?(?:[a-z][^/]*$|(?:[^/]*[_-][^/]*\\.[^./]*|[^./]*[_-][^./]*)$)"
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "file-name-casing",
        "message": "File name must be PascalCase"
      }
    }
  ]
}