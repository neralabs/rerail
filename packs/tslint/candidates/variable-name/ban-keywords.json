{
  "format": "rerail.policy/v1",
  "id": "tslint:variable-name/ban-keywords",
  "revision": 1,
  "mode": "steer",
  "description": "Checks variable/parameter/property names for lowerCamelCase or UPPER_CASE; alias exemption via same-metavar patterns. Options: ['ban-keywords'].",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "keyword",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "^(any|Number|number|String|string|Boolean|boolean|Undefined|undefined)$",
            "any": [
              {
                "kind": "identifier",
                "inside": {"stopBy": "neighbor", "kind": "variable_declarator"},
                "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}}
              },
              {
                "kind": "identifier",
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {"kind": "required_parameter"},
                    {"kind": "optional_parameter"},
                    {"kind": "array_pattern"},
                    {"kind": "rest_pattern"},
                    {"kind": "assignment_pattern"}
                  ]
                },
                "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}}
              },
              {
                "kind": "identifier",
                "inside": {"stopBy": "neighbor", "kind": "pair_pattern"},
                "follows": {"stopBy": "neighbor", "regex": "^:$"}
              },
              {"kind": "shorthand_property_identifier_pattern"}
            ],
            "not": {"inside": {"stopBy": "end", "matches": "declare-statement"}}
          },
          "utils": {
            "declare-statement": {
              "any": [{"kind": "lexical_declaration"}, {"kind": "variable_declaration"}],
              "inside": {"stopBy": "neighbor", "kind": "ambient_declaration"}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "variable-name",
        "message": "variable name clashes with keyword/type"
      }
    }
  ]
}
