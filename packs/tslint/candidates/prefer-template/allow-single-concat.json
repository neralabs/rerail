{
  "format": "rerail.policy/v1",
  "id": "tslint:prefer-template",
  "revision": 1,
  "mode": "steer",
  "description": "Prefer template literals over string concatenation (outermost offending `+` expression). TSLint's recursive containsAnyStringLiterals/containsOnlyStringLiterals are recursive utils. Options: allow-single-concat",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "concat",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "matches": "error",
            "not": {
              "inside": {
                "stopBy": "end",
                "kind": "binary_expression",
                "matches": "error"
              }
            }
          },
          "utils": {
            "plus-token": {
              "regex": "^\\+$"
            },
            "plus": {
              "kind": "binary_expression",
              "has": {
                "matches": "plus-token"
              }
            },
            "string-like": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "template_string"
                }
              ]
            },
            "left-string": {
              "has": {
                "precedes": {
                  "matches": "plus-token"
                },
                "matches": "string-like"
              }
            },
            "right-string": {
              "has": {
                "follows": {
                  "matches": "plus-token"
                },
                "matches": "string-like"
              }
            },
            "any-strings": {
              "kind": "binary_expression",
              "all": [
                {
                  "matches": "plus"
                },
                {
                  "any": [
                    {
                      "matches": "right-string"
                    },
                    {
                      "matches": "left-string"
                    },
                    {
                      "has": {
                        "precedes": {
                          "matches": "plus-token"
                        },
                        "matches": "any-strings"
                      }
                    }
                  ]
                }
              ]
            },
            "only-strings": {
              "kind": "binary_expression",
              "all": [
                {
                  "matches": "plus"
                },
                {
                  "matches": "right-string"
                },
                {
                  "any": [
                    {
                      "matches": "left-string"
                    },
                    {
                      "has": {
                        "precedes": {
                          "matches": "plus-token"
                        },
                        "matches": "any-strings"
                      }
                    }
                  ]
                }
              ]
            },
            "error": {
              "kind": "binary_expression",
              "all": [
                {
                  "matches": "plus"
                }
              ],
              "any": [
                {
                  "matches": "left-string",
                  "all": [
                    {
                      "matches": "right-string"
                    }
                  ],
                  "has": {
                    "matches": "string-like",
                    "regex": "\\\\n|\\n"
                  }
                },
                {
                  "not": {
                    "matches": "left-string"
                  },
                  "all": [
                    {
                      "not": {
                        "matches": "right-string"
                      }
                    }
                  ],
                  "has": {
                    "precedes": {
                      "matches": "plus-token"
                    },
                    "matches": "any-strings"
                  }
                },
                {
                  "matches": "right-string",
                  "not": {
                    "matches": "left-string"
                  },
                  "all": [
                    {
                      "not": {
                        "has": {
                          "precedes": {
                            "matches": "plus-token"
                          },
                          "matches": "only-strings"
                        }
                      }
                    },
                    {
                      "has": {
                        "precedes": {
                          "matches": "plus-token"
                        },
                        "matches": "plus"
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PREFER_TEMPLATE",
        "message": "Use a template literal instead of concatenating with a string literal."
      }
    }
  ]
}
