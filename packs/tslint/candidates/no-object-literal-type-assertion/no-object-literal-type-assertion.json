{
  "format": "rerail.policy/v1",
  "id": "tslint:no-object-literal-type-assertion",
  "revision": 1,
  "mode": "steer",
  "description": "Forbids type assertions on object literals, except to any, unknown or const.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "object-literal-assertion",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "as_expression"
                  },
                  {
                    "kind": "type_assertion"
                  }
                ]
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "object"
                    },
                    {
                      "all": [
                        {
                          "kind": "parenthesized_expression"
                        },
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "object"
                          }
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "regex": "\\bas\\s+(any|unknown|const)$"
                    },
                    {
                      "regex": "^<\\s*(any|unknown|const)\\s*>"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-object-literal-type-assertion",
        "message": "Type assertion on object literals is forbidden, use a type annotation instead."
      }
    }
  ]
}