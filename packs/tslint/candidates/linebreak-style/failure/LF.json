{
  "format": "rerail.policy/v1",
  "id": "tslint:linebreak-style/failure/LF",
  "revision": 1,
  "mode": "steer",
  "description": "Enforces CRLF line endings.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "lf-line",
      "forbid": {
        "regex": {
          "source": "file.content",
          "pattern": "(?m)^[^\\r\\n]*\\n"
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "linebreak-style",
        "message": "Expected linebreak to be 'CRLF'"
      }
    }
  ]
}
