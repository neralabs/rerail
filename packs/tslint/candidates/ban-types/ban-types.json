{
  "format": "rerail.policy/v1",
  "id": "tslint:ban-types",
  "revision": 1,
  "mode": "steer",
  "description": "Bans specific types (config of the TSLint fixture: String -> string, Object, Fo*).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "ban-string",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "type_identifier"
              },
              {
                "regex": "^String$"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "class_declaration"
                      },
                      {
                        "kind": "abstract_class_declaration"
                      },
                      {
                        "kind": "class"
                      },
                      {
                        "kind": "interface_declaration"
                      },
                      {
                        "kind": "type_alias_declaration"
                      },
                      {
                        "kind": "type_parameter"
                      },
                      {
                        "kind": "extends_type_clause"
                      },
                      {
                        "kind": "implements_clause"
                      },
                      {
                        "kind": "generic_type"
                      },
                      {
                        "kind": "nested_type_identifier"
                      },
                      {
                        "kind": "import_specifier"
                      },
                      {
                        "kind": "export_specifier"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "BAN_TYPES",
        "message": "Don't use 'String' as a type. Use 'string' instead."
      }
    },
    {
      "id": "ban-other",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "type_identifier"
              },
              {
                "regex": "^(?:Object|Fo*)$"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "class_declaration"
                      },
                      {
                        "kind": "abstract_class_declaration"
                      },
                      {
                        "kind": "class"
                      },
                      {
                        "kind": "interface_declaration"
                      },
                      {
                        "kind": "type_alias_declaration"
                      },
                      {
                        "kind": "type_parameter"
                      },
                      {
                        "kind": "extends_type_clause"
                      },
                      {
                        "kind": "implements_clause"
                      },
                      {
                        "kind": "generic_type"
                      },
                      {
                        "kind": "nested_type_identifier"
                      },
                      {
                        "kind": "import_specifier"
                      },
                      {
                        "kind": "export_specifier"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "BAN_TYPES",
        "message": "Don't use this type."
      }
    }
  ]
}
