{
  "format": "rerail.policy/v1",
  "id": "tslint:arrow-parens",
  "revision": 1,
  "mode": "steer",
  "description": "Requires parentheses around the parameters of arrow function definitions.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "missing-parens",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "identifier"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "arrow_function"
                }
              },
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "pattern": "=>"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "arrow-parens",
        "message": "Parentheses are required around the parameters of an arrow function definition"
      }
    }
  ]
}
