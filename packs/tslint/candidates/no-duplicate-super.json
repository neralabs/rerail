{
  "format": "rerail.policy/v1",
  "id": "tslint:no-duplicate-super",
  "revision": 1,
  "mode": "steer",
  "description": "Warns if super() can run twice in a constructor: a later sibling (at the super's level or any enclosing level, sibling-scoped) calls super before a return/throw, or before a break that is not absorbed by a loop/switch; then/else and ternary branches exclude each other, a switch passes on only its last clause's super, and super() in a loop body not followed by break/return is flagged. Nested classes are skipped.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "duplicate-super",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {"matches": "super-token"},
              {"matches": "in-constructor"},
              {"any": [{"matches": "sequenced-super"}, {"inside": {"stopBy": "end", "matches": "sequenced-super"}}]},
              {
                "not": {
                  "inside": {"stopBy": "end", "inside": {"stopBy": "end", "pattern": "$X"}, "matches": "escapes-X"}
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "inside": {"stopBy": "end", "pattern": "$X"},
                    "any": [
                      {"kind": "switch_case", "precedes": {"stopBy": "end", "matches": "calls-super"}},
                      {"kind": "switch_body", "has": {"kind": "switch_case", "has": {"matches": "returns"}}}
                    ]
                  }
                }
              }
            ]
          },
          "utils": {
            "super-token": {"kind": "super", "inside": {"kind": "call_expression"}, "precedes": {"kind": "arguments"}},
            "in-constructor": {
              "all": [
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "method_definition",
                    "has": {"kind": "property_identifier", "regex": "^constructor$"},
                    "pattern": "$CTOR"
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "matches": "nested-class",
                      "inside": {"stopBy": "end", "pattern": "$CTOR"}
                    }
                  }
                }
              ]
            },
            "nested-class": {"any": [{"kind": "class"}, {"kind": "class_declaration"}]},
            "super-call": {"kind": "call_expression", "has": {"kind": "super"}},
            "calls-super": {"any": [{"matches": "super-call"}, {"has": {"stopBy": "end", "matches": "super-call"}}]},
            "returns": {
              "any": [
                {"kind": "return_statement"},
                {"kind": "throw_statement"},
                {"has": {"stopBy": "end", "any": [{"kind": "return_statement"}, {"kind": "throw_statement"}]}}
              ]
            },
            "breaks": {"any": [{"kind": "break_statement"}, {"has": {"stopBy": "end", "kind": "break_statement"}}]},
            "loop": {
              "any": [
                {"kind": "for_statement"},
                {"kind": "for_in_statement"},
                {"kind": "while_statement"},
                {"kind": "do_statement"}
              ]
            },
            "breakable": {"any": [{"matches": "loop"}, {"kind": "switch_statement"}]},
            "escapes-Y": {
              "any": [
                {"precedes": {"stopBy": "end", "not": {"kind": "else_clause"}, "matches": "returns"}},
                {
                  "all": [
                    {"precedes": {"stopBy": "end", "not": {"kind": "else_clause"}, "matches": "breaks"}},
                    {
                      "not": {
                        "inside": {
                          "stopBy": "end",
                          "matches": "breakable",
                          "inside": {"stopBy": "end", "pattern": "$Y"}
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "escapes-X": {
              "any": [
                {"precedes": {"stopBy": "end", "not": {"kind": "else_clause"}, "matches": "returns"}},
                {
                  "all": [
                    {"precedes": {"stopBy": "end", "not": {"kind": "else_clause"}, "matches": "breaks"}},
                    {
                      "not": {
                        "inside": {
                          "stopBy": "end",
                          "matches": "breakable",
                          "any": [{"pattern": "$X"}, {"inside": {"stopBy": "end", "pattern": "$X"}}]
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "sequenced-super": {
              "all": [
                {"pattern": "$X"},
                {"inside": {"stopBy": "end", "pattern": "$CTOR"}},
                {"not": {"follows": {"regex": "^\\?$"}}},
                {"not": {"all": [{"inside": {"kind": "if_statement"}}, {"precedes": {"kind": "else_clause"}}]}},
                {
                  "precedes": {
                    "stopBy": "end",
                    "any": [{"matches": "calls-super"}, {"matches": "returns"}, {"matches": "breaks"}],
                    "pattern": "$Y"
                  }
                },
                {
                  "precedes": {
                    "stopBy": "end",
                    "pattern": "$Y",
                    "not": {"kind": "else_clause"},
                    "any": [
                      {"matches": "super-call"},
                      {
                        "has": {
                          "stopBy": "end",
                          "all": [
                            {"matches": "super-call"},
                            {
                              "not": {
                                "any": [
                                  {
                                    "inside": {
                                      "stopBy": "end",
                                      "matches": "nested-class",
                                      "any": [{"pattern": "$Y"}, {"inside": {"stopBy": "end", "pattern": "$Y"}}]
                                    }
                                  },
                                  {
                                    "inside": {
                                      "stopBy": "end",
                                      "inside": {"stopBy": "end", "pattern": "$Y"},
                                      "matches": "escapes-Y"
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_DUPLICATE_SUPER",
        "message": "Multiple calls to 'super()' found. It must be called only once."
      }
    },
    {
      "id": "super-in-loop",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {"matches": "super-token"},
              {"matches": "in-constructor"},
              {
                "inside": {
                  "stopBy": "end",
                  "matches": "loop",
                  "pattern": "$L",
                  "inside": {"stopBy": "end", "pattern": "$CTOR"}
                }
              },
              {
                "not": {
                  "inside": {"stopBy": "end", "inside": {"stopBy": "end", "pattern": "$L"}, "matches": "escapes-L"}
                }
              }
            ]
          },
          "utils": {
            "super-token": {"kind": "super", "inside": {"kind": "call_expression"}, "precedes": {"kind": "arguments"}},
            "in-constructor": {
              "all": [
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "method_definition",
                    "has": {"kind": "property_identifier", "regex": "^constructor$"},
                    "pattern": "$CTOR"
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "matches": "nested-class",
                      "inside": {"stopBy": "end", "pattern": "$CTOR"}
                    }
                  }
                }
              ]
            },
            "nested-class": {"any": [{"kind": "class"}, {"kind": "class_declaration"}]},
            "returns": {
              "any": [
                {"kind": "return_statement"},
                {"kind": "throw_statement"},
                {"has": {"stopBy": "end", "any": [{"kind": "return_statement"}, {"kind": "throw_statement"}]}}
              ]
            },
            "breaks": {"any": [{"kind": "break_statement"}, {"has": {"stopBy": "end", "kind": "break_statement"}}]},
            "loop": {
              "any": [
                {"kind": "for_statement"},
                {"kind": "for_in_statement"},
                {"kind": "while_statement"},
                {"kind": "do_statement"}
              ]
            },
            "breakable": {"any": [{"matches": "loop"}, {"kind": "switch_statement"}]},
            "escapes-L": {
              "any": [
                {"precedes": {"stopBy": "end", "not": {"kind": "else_clause"}, "matches": "returns"}},
                {
                  "all": [
                    {"precedes": {"stopBy": "end", "not": {"kind": "else_clause"}, "matches": "breaks"}},
                    {
                      "not": {
                        "inside": {
                          "stopBy": "end",
                          "matches": "breakable",
                          "inside": {"stopBy": "end", "pattern": "$L"}
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_DUPLICATE_SUPER_LOOP",
        "message": "'super()' called in a loop. It must be called only once."
      }
    }
  ]
}
