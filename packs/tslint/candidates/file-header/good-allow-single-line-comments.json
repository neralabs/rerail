{
  "format": "rerail.policy/v1",
  "id": "tslint:file-header/good-allow-single-line-comments",
  "revision": 1,
  "mode": "steer",
  "description": "Header /Good header/ matched against the leading run of comments (allow-single-line-comments).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "missing-header",
      "forbid": {
        "select_when": {
          "select": {
            "regex": {
              "source": "file.content",
              "pattern": "\\A(?:#![^\\n]*\\n)?(?<AFTER>)"
            }
          },
          "exists": {
            "ast": {
              "language": "typescript",
              "rule": {
                "kind": "program",
                "not": {
                  "has": {
                    "kind": "comment",
                    "regex": "Good header",
                    "not": {
                      "follows": {
                        "stopBy": "end",
                        "not": {
                          "any": [
                            {
                              "kind": "hash_bang_line"
                            },
                            {
                              "kind": "comment"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.AFTER",
        "code": "file-header",
        "message": "missing file header"
      }
    }
  ]
}
