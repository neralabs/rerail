{
  "format": "rerail.policy/v1",
  "id": "tslint:no-null-undefined-union",
  "revision": 1,
  "mode": "steer",
  "description": "Explicit union types that include both null and undefined, with nested and parenthesized unions flattened to any depth, as the checker flattens them. Unions reached through type aliases or inferred return types need the type checker.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "explicit-union",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "union_type",
            "not": { "inside": { "stopBy": "neighbor", "kind": "union_type" } },
            "all": [
              { "has": { "stopBy": "neighbor", "matches": "null-member" } },
              { "has": { "stopBy": "neighbor", "matches": "undefined-member" } }
            ]
          },
          "utils": {
            "null-member": {
              "any": [
                { "kind": "literal_type", "has": { "stopBy": "neighbor", "kind": "null" } },
                {
                  "any": [{ "kind": "union_type" }, { "kind": "parenthesized_type" }],
                  "has": { "stopBy": "neighbor", "matches": "null-member" }
                }
              ]
            },
            "undefined-member": {
              "any": [
                { "kind": "literal_type", "has": { "stopBy": "neighbor", "kind": "undefined" } },
                {
                  "any": [{ "kind": "union_type" }, { "kind": "parenthesized_type" }],
                  "has": { "stopBy": "neighbor", "matches": "undefined-member" }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-null-undefined-union",
        "message": "Union type cannot include both 'null' and 'undefined'."
      }
    }
  ]
}
