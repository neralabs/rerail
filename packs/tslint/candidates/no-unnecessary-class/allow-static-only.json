{
  "format": "rerail.policy/v1",
  "id": "tslint:no-unnecessary-class/allow-static-only",
  "revision": 1,
  "mode": "steer",
  "description": "no-unnecessary-class with allow-static-only.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "empty",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "matches": "plain-class",
            "has": {
              "stopBy": "neighbor",
              "kind": "class_body",
              "not": {"has": {"stopBy": "neighbor", "matches": "member"}}
            }
          },
          "utils": {
            "plain-class": {
              "any": [{"kind": "class_declaration"}, {"kind": "abstract_class_declaration"}],
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "class_heritage",
                  "has": {"stopBy": "neighbor", "kind": "extends_clause"}
                }
              },
              "has": {"stopBy": "neighbor", "regex": "^class$", "pattern": "$$KW"}
            },
            "member": {
              "any": [
                {"kind": "method_definition"},
                {"kind": "public_field_definition"},
                {"kind": "method_signature"},
                {"kind": "abstract_method_signature"},
                {"kind": "index_signature"},
                {"kind": "class_static_block"}
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.KW",
        "code": "no-unnecessary-class",
        "message": "This class has no members."
      }
    },
    {
      "id": "constructor-only",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "matches": "plain-class",
            "has": {
              "stopBy": "neighbor",
              "kind": "class_body",
              "all": [
                {"has": {"stopBy": "neighbor", "matches": "constructor"}},
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "any": [{"matches": "other-member"}, {"matches": "shorthand-constructor"}]
                    }
                  }
                }
              ]
            }
          },
          "utils": {
            "plain-class": {
              "any": [{"kind": "class_declaration"}, {"kind": "abstract_class_declaration"}],
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "class_heritage",
                  "has": {"stopBy": "neighbor", "kind": "extends_clause"}
                }
              },
              "has": {"stopBy": "neighbor", "regex": "^class$", "pattern": "$$KW"}
            },
            "member": {
              "any": [
                {"kind": "method_definition"},
                {"kind": "public_field_definition"},
                {"kind": "method_signature"},
                {"kind": "abstract_method_signature"},
                {"kind": "index_signature"},
                {"kind": "class_static_block"}
              ]
            },
            "constructor": {
              "kind": "method_definition",
              "has": {"stopBy": "neighbor", "kind": "property_identifier", "regex": "^constructor$"}
            },
            "other-member": {"matches": "member", "not": {"matches": "constructor"}},
            "shorthand-constructor": {
              "matches": "constructor",
              "has": {
                "stopBy": "neighbor",
                "kind": "formal_parameters",
                "has": {
                  "stopBy": "neighbor",
                  "has": {
                    "stopBy": "neighbor",
                    "any": [{"kind": "accessibility_modifier"}, {"kind": "override_modifier"}, {"regex": "^readonly$"}]
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.KW",
        "code": "no-unnecessary-class",
        "message": "Every member of this class is a constructor. Use functions instead."
      }
    }
  ]
}
