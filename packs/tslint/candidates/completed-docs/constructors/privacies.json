{
  "format": "rerail.policy/v1",
  "id": "tslint:completed-docs/constructors/privacies",
  "revision": 1,
  "mode": "steer",
  "description": "public and private constructors.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "constructors",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "all": [{ "matches": "ctor" }, { "inside": { "kind": "class_body" } }] },
              {
                "not": {
                  "any": [
                    { "matches": "documented" },
                    {
                      "inside": { "kind": "class_body", "has": { "all": [{ "matches": "ctor" }, { "matches": "documented" }] } }
                    }
                  ]
                }
              },
              {
                "any": [
                  { "has": { "kind": "accessibility_modifier", "regex": "^private$" } },
                  { "not": { "has": { "kind": "accessibility_modifier", "regex": "^(?:private|protected)$" } } }
                ]
              }
            ]
          },
          "utils": {
            "documented": { "follows": { "kind": "comment", "regex": "^/\\*\\*[\\s*]*[^\\s*@/]" } },
            "ctor": {
              "all": [
                { "any": [{ "kind": "method_definition" }, { "kind": "method_signature" }] },
                { "has": { "kind": "property_identifier", "regex": "^constructor$" } }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "completed-docs",
        "message": "Documentation must exist for constructors."
      }
    }
  ]
}
