{
  "format": "rerail.policy/v1",
  "id": "tslint:object-literal-key-quotes",
  "revision": 1,
  "mode": "steer",
  "description": "Property names should only be quoted when needed (as-needed).",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "as-needed",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "string",
            "regex": "^['\"]([A-Za-z_$][A-Za-z0-9_$]*|0|[1-9][0-9]*|[1-9][0-9]*\\.[0-9]*[1-9]|0\\.[0-9]*[1-9])['\"]$",
            "matches": "key"
          },
          "utils": {
            "key": {
              "any": [
                {
                  "inside": { "stopBy": "neighbor", "kind": "pair" },
                  "not": { "follows": { "stopBy": "neighbor", "regex": "^:$" } }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "method_definition",
                    "inside": { "stopBy": "neighbor", "kind": "object" }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "OBJECT_LITERAL_KEY_QUOTES",
        "message": "Unnecessarily quoted property found."
      }
    }
  ]
}
