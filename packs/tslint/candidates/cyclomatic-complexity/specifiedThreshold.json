{
  "format": "rerail.policy/v1",
  "id": "tslint:cyclomatic-complexity/specifiedThreshold",
  "revision": 1,
  "mode": "steer",
  "description": "Cyclomatic complexity threshold 3: a function scope boundary (tsutils isFunctionScopeBoundary: functions, methods, accessors, constructors, classes, namespaces, enums, interfaces, signatures and function types) fails when 1 + its decision points exceeds the threshold. Decision points are TSLint's increasesComplexity nodes (non-empty case, catch, conditional, do, for, for-in/of, if, while, && and ||), counted over the boundary's own subtree without entering nested boundaries: a count along a has walk whose stopBy is the boundary rule.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "too-complex",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "matches": "boundary",
            "count": {
              "has": {
                "matches": "decision",
                "stopBy": {
                  "matches": "boundary"
                }
              },
              "min": 3
            }
          },
          "utils": {
            "boundary": {
              "any": [
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "internal_module"
                },
                {
                  "kind": "module"
                },
                {
                  "kind": "class_declaration"
                },
                {
                  "kind": "class"
                },
                {
                  "kind": "abstract_class_declaration"
                },
                {
                  "kind": "enum_declaration"
                },
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "function_signature"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "interface_declaration"
                },
                {
                  "kind": "method_signature"
                },
                {
                  "kind": "abstract_method_signature"
                },
                {
                  "kind": "call_signature"
                },
                {
                  "kind": "construct_signature"
                },
                {
                  "kind": "constructor_type"
                },
                {
                  "kind": "function_type"
                }
              ]
            },
            "decision": {
              "any": [
                {
                  "kind": "switch_case",
                  "not": {
                    "regex": ":\\s*(?:(?://[^\\n]*|/\\*(?s:.)*?\\*/)\\s*)*\\z"
                  }
                },
                {
                  "kind": "catch_clause"
                },
                {
                  "kind": "ternary_expression"
                },
                {
                  "kind": "do_statement"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "for_in_statement"
                },
                {
                  "kind": "if_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "binary_expression",
                  "has": {
                    "regex": "^(?:&&|\\|\\|)$"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "cyclomatic-complexity",
        "message": "The function has a cyclomatic complexity higher than the threshold of 3"
      }
    }
  ]
}
