{
  "format": "rerail.policy/v1",
  "id": "tslint:typedef/variable-declaration",
  "revision": 1,
  "mode": "steer",
  "description": "Requires type definitions for: variable-declaration.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "variable-declaration",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "identifier",
            "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}},
            "inside": {
              "stopBy": "neighbor",
              "kind": "variable_declarator",
              "not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected variable-declaration to have a typedef"
      }
    }
  ]
}
