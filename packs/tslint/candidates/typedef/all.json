{
  "format": "rerail.policy/v1",
  "id": "tslint:typedef/all",
  "revision": 1,
  "mode": "steer",
  "description": "Requires type definitions for: call-signature, arrow-call-signature, parameter, arrow-parameter, variable-declaration, property-declaration, member-variable-declaration, object-destructuring, array-destructuring.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "call-signature",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "any": [
                  {"kind": "identifier"},
                  {"kind": "property_identifier"},
                  {"kind": "private_property_identifier"},
                  {"kind": "string"},
                  {"kind": "number"},
                  {"kind": "computed_property_name"},
                  {"kind": "type_identifier"}
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {"kind": "function_declaration"},
                    {"kind": "function_expression"},
                    {"kind": "generator_function_declaration"},
                    {"kind": "generator_function"},
                    {"kind": "function_signature"},
                    {"kind": "method_definition"},
                    {"kind": "method_signature"},
                    {"kind": "abstract_method_signature"}
                  ],
                  "matches": "untyped"
                },
                "not": {
                  "any": [{"regex": "^constructor$"}, {"follows": {"stopBy": "neighbor", "regex": "^(?:set|=)$"}}]
                }
              },
              {
                "kind": "formal_parameters",
                "inside": {
                  "stopBy": "neighbor",
                  "any": [{"kind": "function_expression"}, {"kind": "generator_function"}],
                  "matches": "untyped",
                  "not": {"has": {"stopBy": "neighbor", "kind": "identifier"}}
                }
              }
            ]
          },
          "utils": {"untyped": {"not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}}}
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected call-signature to have a typedef"
      }
    },
    {
      "id": "arrow-call-signature",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "regex": "(?<AT>\\([\\s\\S]*|[\\s\\S])$",
            "any": [
              {"kind": "formal_parameters", "inside": {"stopBy": "neighbor", "matches": "checked-arrow"}},
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "matches": "bare-arrow",
                  "not": {"has": {"stopBy": "neighbor", "matches": "async-modifier"}}
                }
              },
              {"matches": "async-modifier", "inside": {"stopBy": "neighbor", "matches": "bare-arrow"}}
            ]
          },
          "utils": {
            "untyped": {"not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}},
            "checked-arrow": {
              "kind": "arrow_function",
              "matches": "untyped",
              "not": {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "public_field_definition",
                  "has": {"stopBy": "neighbor", "kind": "type_annotation"}
                }
              }
            },
            "bare-arrow": {
              "matches": "checked-arrow",
              "not": {"has": {"stopBy": "neighbor", "kind": "formal_parameters"}}
            },
            "async-modifier": {"regex": "^async$", "precedes": {"stopBy": "neighbor", "kind": "identifier"}}
          }
        }
      },
      "violation": {
        "anchor": "capture.AT",
        "code": "typedef",
        "message": "expected arrow-call-signature to have a typedef"
      }
    },
    {
      "id": "parameter",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {"matches": "param-name"},
          "utils": {
            "untyped": {"not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}},
            "param-name": {
              "any": [
                {
                  "any": [
                    {"kind": "identifier"},
                    {"kind": "object_pattern"},
                    {"kind": "array_pattern"},
                    {"kind": "this"}
                  ],
                  "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}},
                  "inside": {"stopBy": "neighbor", "matches": "untyped-param"}
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "rest_pattern",
                    "inside": {"stopBy": "neighbor", "matches": "untyped-param"}
                  }
                },
                {
                  "kind": "identifier",
                  "inside": {"stopBy": "neighbor", "matches": "param-owner"},
                  "precedes": {"stopBy": "neighbor", "regex": "^=>$"}
                }
              ]
            },
            "untyped-param": {
              "any": [{"kind": "required_parameter"}, {"kind": "optional_parameter"}],
              "matches": "untyped",
              "inside": {
                "stopBy": "neighbor",
                "kind": "formal_parameters",
                "inside": {"stopBy": "neighbor", "matches": "param-owner"}
              }
            },
            "param-owner": {"not": {"kind": "arrow_function"}}
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected parameter to have a typedef"
      }
    },
    {
      "id": "arrow-parameter",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {"matches": "param-name"},
          "utils": {
            "untyped": {"not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}},
            "param-name": {
              "any": [
                {
                  "any": [
                    {"kind": "identifier"},
                    {"kind": "object_pattern"},
                    {"kind": "array_pattern"},
                    {"kind": "this"}
                  ],
                  "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}},
                  "inside": {"stopBy": "neighbor", "matches": "untyped-param"}
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "rest_pattern",
                    "inside": {"stopBy": "neighbor", "matches": "untyped-param"}
                  }
                },
                {
                  "kind": "identifier",
                  "inside": {"stopBy": "neighbor", "matches": "param-owner"},
                  "precedes": {"stopBy": "neighbor", "regex": "^=>$"}
                }
              ]
            },
            "untyped-param": {
              "any": [{"kind": "required_parameter"}, {"kind": "optional_parameter"}],
              "matches": "untyped",
              "inside": {
                "stopBy": "neighbor",
                "kind": "formal_parameters",
                "inside": {"stopBy": "neighbor", "matches": "param-owner"}
              }
            },
            "param-owner": {
              "kind": "arrow_function",
              "not": {"inside": {"stopBy": "neighbor", "kind": "public_field_definition"}}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected arrow-parameter to have a typedef"
      }
    },
    {
      "id": "member-variable-declaration",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "any": [
                  {"kind": "identifier"},
                  {"kind": "property_identifier"},
                  {"kind": "private_property_identifier"},
                  {"kind": "string"},
                  {"kind": "number"},
                  {"kind": "computed_property_name"},
                  {"kind": "type_identifier"}
                ],
                "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}},
                "inside": {
                  "stopBy": "neighbor",
                  "matches": "untyped-field",
                  "not": {"has": {"stopBy": "neighbor", "any": [{"kind": "arrow_function"}]}}
                }
              },
              {"matches": "param-name"}
            ]
          },
          "utils": {
            "untyped": {"not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}},
            "param-name": {
              "any": [
                {
                  "any": [
                    {"kind": "identifier"},
                    {"kind": "object_pattern"},
                    {"kind": "array_pattern"},
                    {"kind": "this"}
                  ],
                  "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}},
                  "inside": {"stopBy": "neighbor", "matches": "untyped-param"}
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "rest_pattern",
                    "inside": {"stopBy": "neighbor", "matches": "untyped-param"}
                  }
                },
                {
                  "kind": "identifier",
                  "inside": {"stopBy": "neighbor", "matches": "param-owner"},
                  "precedes": {"stopBy": "neighbor", "regex": "^=>$"}
                }
              ]
            },
            "untyped-param": {
              "any": [{"kind": "required_parameter"}, {"kind": "optional_parameter"}],
              "matches": "untyped",
              "inside": {
                "stopBy": "neighbor",
                "kind": "formal_parameters",
                "inside": {"stopBy": "neighbor", "matches": "param-owner"}
              }
            },
            "param-owner": {"kind": "arrow_function", "inside": {"stopBy": "neighbor", "matches": "untyped-field"}},
            "untyped-field": {"kind": "public_field_definition", "matches": "untyped"}
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected member-variable-declaration to have a typedef"
      }
    },
    {
      "id": "property-declaration",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {"kind": "identifier"},
              {"kind": "property_identifier"},
              {"kind": "private_property_identifier"},
              {"kind": "string"},
              {"kind": "number"},
              {"kind": "computed_property_name"},
              {"kind": "type_identifier"}
            ],
            "inside": {
              "stopBy": "neighbor",
              "kind": "property_signature",
              "not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected property-declaration to have a typedef"
      }
    },
    {
      "id": "variable-declaration",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "identifier",
            "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}},
            "inside": {
              "stopBy": "neighbor",
              "kind": "variable_declarator",
              "not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected variable-declaration to have a typedef"
      }
    },
    {
      "id": "object-destructuring",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "object_pattern",
            "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}},
            "inside": {
              "stopBy": "neighbor",
              "kind": "variable_declarator",
              "not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected object-destructuring to have a typedef"
      }
    },
    {
      "id": "array-destructuring",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "array_pattern",
            "not": {"follows": {"stopBy": "neighbor", "regex": "^=$"}},
            "inside": {
              "stopBy": "neighbor",
              "kind": "variable_declarator",
              "not": {"has": {"stopBy": "neighbor", "kind": "type_annotation"}}
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "typedef",
        "message": "expected array-destructuring to have a typedef"
      }
    }
  ]
}
