{
  "format": "rerail.policy/v1",
  "id": "tslint:no-unnecessary-type-assertion",
  "revision": 1,
  "mode": "steer",
  "description": "Type-free subset: non-null assertions on expressions that are syntactically never null/undefined (literals, arithmetic/concatenation, new, functions).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "non-null-on-non-nullable",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "non_null_expression"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "string"
                    },
                    {
                      "kind": "number"
                    },
                    {
                      "kind": "template_string"
                    },
                    {
                      "kind": "array"
                    },
                    {
                      "kind": "object"
                    },
                    {
                      "kind": "true"
                    },
                    {
                      "kind": "false"
                    },
                    {
                      "kind": "regex"
                    },
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "class"
                    },
                    {
                      "kind": "new_expression"
                    },
                    {
                      "all": [
                        {
                          "kind": "parenthesized_expression"
                        },
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "all": [
                              {
                                "kind": "binary_expression"
                              },
                              {
                                "not": {
                                  "regex": "(?:&&|\\|\\||\\?\\?)"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unnecessary-type-assertion",
        "message": "This assertion is unnecessary since it does not change the type of the expression."
      }
    }
  ]
}
