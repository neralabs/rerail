{
  "format": "rerail.policy/v1",
  "id": "tslint:array-type/array-simple",
  "revision": 1,
  "mode": "steer",
  "description": "Array types, option array-simple: T[] for simple element types, Array<T> otherwise (isSimpleType recursion through parens and nested Array<T> to any depth).",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "generic-array",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {"kind": "generic_type", "matches": "simple-array-generic"},
          "utils": {
            "simple-type": {
              "any": [
                {"kind": "predefined_type"},
                {"kind": "literal_type", "regex": "^(null|undefined)$"},
                {"kind": "array_type"},
                {"kind": "this_type"},
                {"kind": "type_identifier"},
                {"kind": "nested_type_identifier"},
                {"kind": "parenthesized_type", "has": {"stopBy": "neighbor", "matches": "simple-type"}},
                {"matches": "simple-array-generic"}
              ]
            },
            "simple-array-generic": {
              "pattern": {"context": "let x: Array<$_>", "selector": "generic_type"},
              "has": {
                "stopBy": "neighbor",
                "kind": "type_arguments",
                "has": {"stopBy": "neighbor", "matches": "simple-type"}
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "array-type",
        "message": "Array type using 'Array<T>' is forbidden for simple types. Use 'T[]' instead."
      }
    },
    {
      "id": "bare-array",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {"kind": "type_identifier"},
              {"regex": "^Array$"},
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {"kind": "generic_type"},
                      {"kind": "nested_type_identifier"},
                      {"kind": "interface_declaration"},
                      {"kind": "class_declaration"},
                      {"kind": "type_alias_declaration"},
                      {"kind": "type_parameter"}
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "array-type",
        "message": "Array type using 'Array<T>' is forbidden for simple types. Use 'T[]' instead."
      }
    },
    {
      "id": "non-simple-suffix",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {"kind": "array_type", "not": {"has": {"stopBy": "neighbor", "matches": "simple-type"}}},
          "utils": {
            "simple-type": {
              "any": [
                {"kind": "predefined_type"},
                {"kind": "literal_type", "regex": "^(null|undefined)$"},
                {"kind": "array_type"},
                {"kind": "this_type"},
                {"kind": "type_identifier"},
                {"kind": "nested_type_identifier"},
                {"kind": "parenthesized_type", "has": {"stopBy": "neighbor", "matches": "simple-type"}},
                {"matches": "simple-array-generic"}
              ]
            },
            "simple-array-generic": {
              "pattern": {"context": "let x: Array<$_>", "selector": "generic_type"},
              "has": {
                "stopBy": "neighbor",
                "kind": "type_arguments",
                "has": {"stopBy": "neighbor", "matches": "simple-type"}
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "array-type",
        "message": "Array type using 'T[]' is forbidden for non-simple types. Use 'Array<T>' instead."
      }
    }
  ]
}
