{
  "format": "rerail.policy/v1",
  "id": "tslint:comment-format",
  "revision": 1,
  "mode": "steer",
  "description": "Line comments: check-space + check-uppercase + allow-trailing-lowercase (adjacency approximated by previous sibling comment).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "line-comment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "comment"
              },
              {
                "regex": "^//+(?<TEXT>.*)$"
              },
              {
                "not": {
                  "regex": "^//+(?:#?(?:end)?region|noinspection\\s)"
                }
              },
              {
                "not": {
                  "regex": "^///\\s*<reference\\b"
                }
              },
              {
                "any": [
                  {
                    "regex": "^//+[^\\s/]"
                  },
                  {
                    "all": [
                      {
                        "regex": "^//+\\s*\\p{Ll}"
                      },
                      {
                        "not": {
                          "regex": "^//+\\s*tslint:(?:enable|disable)(?:-(?:line|next-line))?(?::|\\s|$)"
                        }
                      },
                      {
                        "not": {
                          "follows": {
                            "stopBy": "neighbor",
                            "all": [
                              {
                                "kind": "comment"
                              },
                              {
                                "regex": "^//+\\s*\\S"
                              },
                              {
                                "not": {
                                  "regex": "^//+(?:#?(?:end)?region|noinspection\\s)"
                                }
                              },
                              {
                                "not": {
                                  "regex": "^//+\\s*tslint:(?:enable|disable)(?:-(?:line|next-line))?(?::|\\s|$)"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.TEXT",
        "code": "COMMENT_FORMAT",
        "message": "comment must start with a space and uppercase letter"
      }
    }
  ]
}
