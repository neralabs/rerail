{
  "format": "rerail.policy/v1",
  "id": "tslint:no-invalid-template-strings",
  "revision": 1,
  "mode": "steer",
  "description": "Warns on ${...} interpolation syntax inside ordinary (non-template) string literals.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "interpolation-in-string",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "string_fragment"
              },
              {
                "regex": "(?<INTERPOLATION>\\$\\{.+?\\})"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "string"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.INTERPOLATION",
        "code": "no-invalid-template-strings",
        "message": "Interpolation will only work for template strings: $INTERPOLATION"
      }
    }
  ]
}
