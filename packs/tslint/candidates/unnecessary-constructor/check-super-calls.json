{
  "format": "rerail.policy/v1",
  "id": "tslint:unnecessary-constructor/check-super-calls",
  "revision": 1,
  "mode": "steer",
  "description": "Prevents blank constructors and constructors that only forward to super (check-super-calls). Argument/parameter counts are enumerated by regex up to 6 parameters.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "empty-constructor",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "method_definition"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "property_identifier",
                  "regex": "^constructor$"
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "accessibility_modifier",
                    "regex": "^(private|protected)$"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "formal_parameters",
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "required_parameter"
                        },
                        {
                          "kind": "optional_parameter"
                        }
                      ],
                      "has": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "kind": "accessibility_modifier"
                          },
                          {
                            "kind": "decorator"
                          },
                          {
                            "regex": "^(readonly|override)$"
                          }
                        ]
                      }
                    }
                  }
                }
              },
              {
                "any": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "statement_block",
                      "regex": "^\\{\\s*\\}$"
                    }
                  },
                  {
                    "regex": "^(?:public\\s+)?constructor\\s*(?:\\(\\s*,?\\)\\s*\\{\\s*super\\((?:\\s*)\\)\\s*;?\\s*\\}|\\([^,()]+,?\\)\\s*\\{\\s*super\\((?:\\s*|(?:\\s*[A-Za-z_$][\\w$]*\\s*))\\)\\s*;?\\s*\\}|\\([^,()]+,[^,()]+,?\\)\\s*\\{\\s*super\\((?:\\s*|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*))\\)\\s*;?\\s*\\}|\\([^,()]+,[^,()]+,[^,()]+,?\\)\\s*\\{\\s*super\\((?:\\s*|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*))\\)\\s*;?\\s*\\}|\\([^,()]+,[^,()]+,[^,()]+,[^,()]+,?\\)\\s*\\{\\s*super\\((?:\\s*|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*))\\)\\s*;?\\s*\\}|\\([^,()]+,[^,()]+,[^,()]+,[^,()]+,[^,()]+,?\\)\\s*\\{\\s*super\\((?:\\s*|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*))\\)\\s*;?\\s*\\}|\\([^,()]+,[^,()]+,[^,()]+,[^,()]+,[^,()]+,[^,()]+,?\\)\\s*\\{\\s*super\\((?:\\s*|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*,[^,()]*(?:\\([^()]*\\)[^,()]*)*)|(?:\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*,\\s*[A-Za-z_$][\\w$]*\\s*))\\)\\s*;?\\s*\\})$"
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "unnecessary-constructor",
        "message": "Remove unnecessary empty constructor."
      }
    }
  ]
}