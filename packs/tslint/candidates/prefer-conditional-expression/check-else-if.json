{
  "format": "rerail.policy/v1",
  "id": "tslint:prefer-conditional-expression/check-else-if",
  "revision": 1,
  "mode": "steer",
  "description": "prefer-conditional-expression, check-else-if: an if/else or else-if chain of any length (recursive utils) whose every branch, through single-statement blocks, is one `$X = <one-line value>` to the same $X; an if in the else chain of a flagged if is not flagged again.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "conditional-assignment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "if_statement",
                "regex": "^(?<IF>if)",
                "matches": "assigning-if"
              },
              {
                "not": {
                  "matches": "chain-link"
                }
              }
            ]
          },
          "utils": {
            "only-statement": {
              "follows": {
                "matches": "block-open"
              },
              "precedes": {
                "matches": "block-close"
              }
            },
            "block-open": {
              "any": [
                {
                  "regex": "^\\{$"
                },
                {
                  "kind": "comment",
                  "follows": {
                    "matches": "block-open"
                  }
                }
              ]
            },
            "block-close": {
              "any": [
                {
                  "regex": "^\\}$"
                },
                {
                  "kind": "comment",
                  "precedes": {
                    "matches": "block-close"
                  }
                }
              ]
            },
            "assign": {
              "kind": "expression_statement",
              "has": {
                "kind": "assignment_expression",
                "pattern": "$X = $_",
                "not": {
                  "has": {
                    "follows": {
                      "regex": "^=$"
                    },
                    "regex": "\\n"
                  }
                }
              }
            },
            "then-value": {
              "any": [
                {
                  "matches": "assign"
                },
                {
                  "kind": "statement_block",
                  "has": {
                    "matches": "only-statement",
                    "all": [
                      {
                        "matches": "then-value"
                      }
                    ]
                  }
                }
              ]
            },
            "else-value": {
              "any": [
                {
                  "matches": "assign"
                },
                {
                  "kind": "statement_block",
                  "has": {
                    "matches": "only-statement",
                    "all": [
                      {
                        "matches": "else-value"
                      }
                    ]
                  }
                },
                {
                  "matches": "assigning-if"
                }
              ]
            },
            "assigning-if": {
              "kind": "if_statement",
              "has": {
                "follows": {
                  "kind": "parenthesized_expression"
                },
                "matches": "then-value"
              },
              "all": [
                {
                  "has": {
                    "kind": "else_clause",
                    "has": {
                      "matches": "else-value"
                    }
                  }
                }
              ]
            },
            "chain-link": {
              "any": [
                {
                  "inside": {
                    "kind": "else_clause",
                    "inside": {
                      "kind": "if_statement",
                      "has": {
                        "follows": {
                          "kind": "parenthesized_expression"
                        },
                        "matches": "then-value"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "kind": "statement_block",
                    "matches": "chain-link"
                  },
                  "matches": "only-statement"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.IF",
        "code": "prefer-conditional-expression",
        "message": "Use a conditional expression instead of assigning to '$X' in multiple places."
      }
    }
  ]
}
