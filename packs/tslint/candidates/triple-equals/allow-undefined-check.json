{
  "format": "rerail.policy/v1",
  "id": "tslint:triple-equals/allow-undefined-check",
  "revision": 1,
  "mode": "steer",
  "description": "Requires === and !==; allows == / != against undefined (allow-undefined-check).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "loose-eq",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^==$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "binary_expression"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "binary_expression",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "undefined"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "triple-equals",
        "message": "== should be ==="
      }
    },
    {
      "id": "loose-neq",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^!=$"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "binary_expression"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "binary_expression",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "undefined"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "triple-equals",
        "message": "!= should be !=="
      }
    }
  ]
}