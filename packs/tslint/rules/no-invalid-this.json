{
  "format": "rerail.policy/v1",
  "id": "tslint:no-invalid-this",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-invalid-this` rule with its default options (https://palantir.github.io/tslint/rules/no-invalid-this/). TSLint tracks the nearest enclosing class or function-like (method, accessor, constructor, property, function declaration or expression; arrow functions are transparent). `this` is allowed when that scope is a class method (a function-like whose own nearest enclosing scope is a class) or a function with a `this` parameter, found by an inside walk that stops at the nearest scope. Without check-function-in-method, a `this` inside any class is not reported.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "invalid-this",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "this"
              },
              {
                "not": {
                  "inside": {
                    "any": [
                      {
                        "kind": "required_parameter"
                      },
                      {
                        "kind": "optional_parameter"
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "matches": "class-like"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": {
                      "matches": "scope"
                    },
                    "matches": "bound-function"
                  }
                }
              }
            ]
          },
          "utils": {
            "class-like": {
              "any": [
                {
                  "kind": "class_declaration"
                },
                {
                  "kind": "class"
                },
                {
                  "kind": "abstract_class_declaration"
                }
              ]
            },
            "function-like": {
              "any": [
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "public_field_definition"
                },
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "generator_function"
                }
              ]
            },
            "scope": {
              "any": [
                {
                  "matches": "class-like"
                },
                {
                  "matches": "function-like"
                }
              ]
            },
            "bound-function": {
              "matches": "function-like",
              "has": {
                "kind": "formal_parameters",
                "has": {
                  "any": [
                    {
                      "kind": "required_parameter"
                    },
                    {
                      "kind": "optional_parameter"
                    }
                  ],
                  "has": {
                    "kind": "this"
                  }
                }
              }
            },
            "class-method": {
              "matches": "function-like",
              "inside": {
                "stopBy": {
                  "matches": "scope"
                },
                "matches": "class-like"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_INVALID_THIS",
        "message": "the \"this\" keyword is disallowed outside of a class body"
      }
    }
  ]
}
