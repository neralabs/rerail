{
  "format": "rerail.policy/v1",
  "id": "tslint:no-console",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-console` rule with its default options (https://palantir.github.io/tslint/rules/no-console/). Bans all console methods (TSLint default: no method list).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "console-access",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "pattern": "console.$M"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-console",
        "message": "Calls to 'console.<method>' are not allowed."
      }
    }
  ]
}
