{
  "format": "rerail.policy/v1",
  "id": "tslint:no-unsafe-finally",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-unsafe-finally` rule with its default options (https://palantir.github.io/tslint/rules/no-unsafe-finally/). Disallows return, throw, break and continue that escape a finally block: no function, loop/switch (unlabeled break/continue) or statement with the jump's own label lies between the jump and the finally block.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "return-or-throw",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "return_statement"
                  },
                  {
                    "kind": "throw_statement"
                  }
                ]
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "finally_clause"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "method_definition"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "generator_function_declaration"
                      }
                    ],
                    "inside": {
                      "stopBy": "end",
                      "kind": "finally_clause"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "'return' statements in finally blocks are forbidden."
      }
    },
    {
      "id": "break",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "break_statement",
                "not": {
                  "has": {
                    "kind": "statement_identifier"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "finally_clause"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "method_definition"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "generator_function_declaration"
                      },
                      {
                        "kind": "for_statement"
                      },
                      {
                        "kind": "for_in_statement"
                      },
                      {
                        "kind": "while_statement"
                      },
                      {
                        "kind": "do_statement"
                      },
                      {
                        "kind": "switch_statement"
                      }
                    ],
                    "inside": {
                      "stopBy": "end",
                      "kind": "finally_clause"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "'return' statements in finally blocks are forbidden."
      }
    },
    {
      "id": "continue",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "continue_statement",
                "not": {
                  "has": {
                    "kind": "statement_identifier"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "finally_clause"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "method_definition"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "generator_function_declaration"
                      },
                      {
                        "kind": "for_statement"
                      },
                      {
                        "kind": "for_in_statement"
                      },
                      {
                        "kind": "while_statement"
                      },
                      {
                        "kind": "do_statement"
                      }
                    ],
                    "inside": {
                      "stopBy": "end",
                      "kind": "finally_clause"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "'return' statements in finally blocks are forbidden."
      }
    },
    {
      "id": "labeled-jump",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "break_statement"
                  },
                  {
                    "kind": "continue_statement"
                  }
                ],
                "has": {
                  "kind": "statement_identifier",
                  "pattern": "$L"
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "finally_clause"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_declaration"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "method_definition"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "generator_function_declaration"
                      },
                      {
                        "kind": "labeled_statement",
                        "has": {
                          "kind": "statement_identifier",
                          "pattern": "$L"
                        }
                      }
                    ],
                    "inside": {
                      "stopBy": "end",
                      "kind": "finally_clause"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-unsafe-finally",
        "message": "'return' statements in finally blocks are forbidden."
      }
    }
  ]
}
