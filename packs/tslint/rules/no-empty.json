{
  "format": "rerail.policy/v1",
  "id": "tslint:no-empty",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-empty` rule with its default options (https://palantir.github.io/tslint/rules/no-empty/). Disallows empty blocks (a comment makes a block non-empty); private/protected constructors and constructors with parameter properties are exempt.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "empty-block",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "statement_block"
              },
              {
                "regex": "^\\{\\s*\\}$"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "kind": "method_definition"
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "property_identifier",
                          "regex": "^constructor$"
                        }
                      },
                      {
                        "any": [
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "accessibility_modifier",
                              "regex": "^(private|protected)$"
                            }
                          },
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "formal_parameters",
                              "has": {
                                "stopBy": "neighbor",
                                "any": [
                                  {
                                    "kind": "required_parameter"
                                  },
                                  {
                                    "kind": "optional_parameter"
                                  }
                                ],
                                "regex": "^(public|private|protected|readonly)\\b"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-empty",
        "message": "block is empty"
      }
    }
  ]
}
