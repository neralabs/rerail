{
  "format": "rerail.policy/v1",
  "id": "tslint:adjacent-overload-signatures",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `adjacent-overload-signatures` rule with its default options (https://palantir.github.io/tslint/rules/adjacent-overload-signatures/). Overloads (same name and static-ness; call and construct signatures by kind) must be adjacent: flags a member or top-level/namespace function whose key appears on an earlier sibling while the previous member (skipping any run of `;`, `,` and comments between members, and comments between statements) has a different key.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "misplaced-member-overload",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "inside": {
                  "any": [
                    {
                      "kind": "class_body"
                    },
                    {
                      "kind": "interface_body"
                    },
                    {
                      "kind": "object_type"
                    }
                  ]
                }
              },
              {
                "any": [
                  {
                    "all": [
                      {
                        "matches": "static-overload"
                      },
                      {
                        "follows": {
                          "stopBy": "end",
                          "matches": "static-overload"
                        }
                      },
                      {
                        "not": {
                          "matches": "after-static-overload"
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "matches": "instance-overload"
                      },
                      {
                        "follows": {
                          "stopBy": "end",
                          "matches": "instance-overload"
                        }
                      },
                      {
                        "not": {
                          "matches": "after-instance-overload"
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "matches": "call-overload"
                      },
                      {
                        "follows": {
                          "stopBy": "end",
                          "matches": "call-overload"
                        }
                      },
                      {
                        "not": {
                          "matches": "after-call-overload"
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "matches": "construct-overload"
                      },
                      {
                        "follows": {
                          "stopBy": "end",
                          "matches": "construct-overload"
                        }
                      },
                      {
                        "not": {
                          "matches": "after-construct-overload"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "utils": {
            "name": {
              "has": {
                "any": [
                  {
                    "kind": "property_identifier",
                    "pattern": "$K"
                  },
                  {
                    "kind": "string",
                    "has": {
                      "kind": "string_fragment",
                      "pattern": "$K"
                    }
                  },
                  {
                    "kind": "number",
                    "pattern": "$K"
                  },
                  {
                    "kind": "computed_property_name",
                    "any": [
                      {
                        "has": {
                          "any": [
                            {
                              "kind": "string",
                              "has": {
                                "kind": "string_fragment",
                                "pattern": "$K"
                              }
                            },
                            {
                              "kind": "number",
                              "pattern": "$K"
                            }
                          ]
                        }
                      },
                      {
                        "pattern": "$K",
                        "not": {
                          "has": {
                            "any": [
                              {
                                "kind": "string"
                              },
                              {
                                "kind": "number"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            },
            "signature": {
              "any": [
                {
                  "kind": "method_signature"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "abstract_method_signature"
                }
              ]
            },
            "skipped": {
              "any": [
                {
                  "regex": "^[;,]$"
                },
                {
                  "kind": "comment"
                }
              ]
            },
            "static-overload": {
              "all": [
                {
                  "matches": "signature"
                },
                {
                  "has": {
                    "regex": "^static$",
                    "not": {
                      "kind": "property_identifier"
                    }
                  }
                },
                {
                  "matches": "name"
                }
              ]
            },
            "instance-overload": {
              "all": [
                {
                  "matches": "signature"
                },
                {
                  "not": {
                    "has": {
                      "regex": "^static$",
                      "not": {
                        "kind": "property_identifier"
                      }
                    }
                  }
                },
                {
                  "matches": "name"
                }
              ]
            },
            "call-overload": {
              "kind": "call_signature"
            },
            "construct-overload": {
              "kind": "construct_signature"
            },
            "after-static-overload": {
              "follows": {
                "any": [
                  {
                    "matches": "static-overload"
                  },
                  {
                    "all": [
                      {
                        "matches": "skipped"
                      },
                      {
                        "matches": "after-static-overload"
                      }
                    ]
                  }
                ]
              }
            },
            "after-instance-overload": {
              "follows": {
                "any": [
                  {
                    "matches": "instance-overload"
                  },
                  {
                    "all": [
                      {
                        "matches": "skipped"
                      },
                      {
                        "matches": "after-instance-overload"
                      }
                    ]
                  }
                ]
              }
            },
            "after-call-overload": {
              "follows": {
                "any": [
                  {
                    "matches": "call-overload"
                  },
                  {
                    "all": [
                      {
                        "matches": "skipped"
                      },
                      {
                        "matches": "after-call-overload"
                      }
                    ]
                  }
                ]
              }
            },
            "after-construct-overload": {
              "follows": {
                "any": [
                  {
                    "matches": "construct-overload"
                  },
                  {
                    "all": [
                      {
                        "matches": "skipped"
                      },
                      {
                        "matches": "after-construct-overload"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "adjacent-overload-signatures",
        "message": "All overload signatures of a name should be adjacent"
      }
    },
    {
      "id": "misplaced-function-overload",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "matches": "function"
              },
              {
                "inside": {
                  "any": [
                    {
                      "kind": "program"
                    },
                    {
                      "kind": "statement_block",
                      "inside": {
                        "any": [
                          {
                            "kind": "internal_module"
                          },
                          {
                            "kind": "module"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "follows": {
                  "stopBy": "end",
                  "matches": "function"
                }
              },
              {
                "not": {
                  "matches": "after-function"
                }
              }
            ]
          },
          "utils": {
            "function": {
              "any": [
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "function_signature"
                        },
                        {
                          "kind": "generator_function_declaration"
                        }
                      ]
                    },
                    {
                      "has": {
                        "kind": "identifier",
                        "pattern": "$K"
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "export_statement"
                        },
                        {
                          "kind": "ambient_declaration"
                        }
                      ]
                    },
                    {
                      "has": {
                        "matches": "function"
                      }
                    }
                  ]
                }
              ]
            },
            "after-function": {
              "follows": {
                "any": [
                  {
                    "matches": "function"
                  },
                  {
                    "all": [
                      {
                        "kind": "comment"
                      },
                      {
                        "matches": "after-function"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "adjacent-overload-signatures",
        "message": "All overload signatures of a name should be adjacent"
      }
    }
  ]
}
