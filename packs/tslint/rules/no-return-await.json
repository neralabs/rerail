{
  "format": "rerail.policy/v1",
  "id": "tslint:no-return-await",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-return-await` rule with its default options (https://palantir.github.io/tslint/rules/no-return-await/). Disallows unnecessary `return await` (outside try blocks, or catch blocks that have a finally, within the same function), including awaits in arrow expression bodies and in tail positions of parens, ||, &&, comma and ?: to any depth. tree-sitter parses `await x as T` as `await (x as T)`; TypeScript binds the assertion outside the await, so such awaits are exempt.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "return-await",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "await_expression",
            "pattern": "await $E",
            "regex": "^(?<AWAIT>await)",
            "not": {
              "has": {
                "any": [
                  {
                    "kind": "as_expression"
                  },
                  {
                    "kind": "satisfies_expression"
                  }
                ]
              }
            },
            "matches": "tail-position"
          },
          "utils": {
            "tail-position": {
              "any": [
                {
                  "inside": {
                    "kind": "arrow_function"
                  }
                },
                {
                  "inside": {
                    "kind": "return_statement",
                    "not": {
                      "matches": "error-handled"
                    }
                  }
                },
                {
                  "inside": {
                    "kind": "parenthesized_expression",
                    "matches": "tail-position"
                  }
                },
                {
                  "follows": {
                    "regex": "^[?:]$"
                  },
                  "inside": {
                    "kind": "ternary_expression",
                    "matches": "tail-position"
                  }
                },
                {
                  "follows": {
                    "regex": "^(&&|\\|\\||,)$"
                  },
                  "inside": {
                    "any": [
                      {
                        "kind": "binary_expression"
                      },
                      {
                        "kind": "sequence_expression"
                      }
                    ],
                    "matches": "tail-position"
                  }
                }
              ]
            },
            "error-handled": {
              "inside": {
                "any": [
                  {
                    "matches": "guarded-block"
                  },
                  {
                    "not": {
                      "matches": "function-boundary"
                    },
                    "matches": "error-handled"
                  }
                ]
              }
            },
            "guarded-block": {
              "any": [
                {
                  "kind": "statement_block",
                  "inside": {
                    "kind": "try_statement"
                  }
                },
                {
                  "kind": "catch_clause",
                  "precedes": {
                    "kind": "finally_clause"
                  }
                }
              ]
            },
            "function-boundary": {
              "any": [
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "generator_function_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "generator_function"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "method_definition"
                },
                {
                  "kind": "class_body"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.AWAIT",
        "code": "no-return-await",
        "message": "Unnecessary 'await'.",
        "fix": "$E"
      }
    }
  ]
}
