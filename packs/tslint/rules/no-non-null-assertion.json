{
  "format": "rerail.policy/v1",
  "id": "tslint:no-non-null-assertion",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-non-null-assertion` rule with its default options (https://palantir.github.io/tslint/rules/no-non-null-assertion/). Disallows non-null assertions using the `!` postfix operator.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "non-null",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "non_null_expression"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-non-null-assertion",
        "message": "Forbidden non null assertion"
      }
    }
  ]
}
