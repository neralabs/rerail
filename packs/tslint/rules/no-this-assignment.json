{
  "format": "rerail.policy/v1",
  "id": "tslint:no-this-assignment",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-this-assignment` rule with its default options (https://palantir.github.io/tslint/rules/no-this-assignment/). Disallows assigning `this` (or destructuring it) into a local variable.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "this-assignment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "variable_declarator"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "this"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_THIS_ASSIGNMENT",
        "message": "Assigning `this` reference to local variable not allowed."
      }
    }
  ]
}
