{
  "format": "rerail.policy/v1",
  "id": "tslint:prefer-conditional-expression",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `prefer-conditional-expression` rule with its default options (https://palantir.github.io/tslint/rules/prefer-conditional-expression/). Flags an if/else whose two branches, through single-statement blocks, are each one `$X = <one-line value>` to the same $X. An if that continues an else chain (directly or through single-statement blocks) is not checked, as TSLint skips else-if chains by default.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "conditional-assignment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "if_statement",
                "regex": "^(?<IF>if)",
                "matches": "assigning-if"
              },
              {
                "not": {
                  "matches": "chain-link"
                }
              }
            ]
          },
          "utils": {
            "only-statement": {
              "follows": {
                "matches": "block-open"
              },
              "precedes": {
                "matches": "block-close"
              }
            },
            "block-open": {
              "any": [
                {
                  "regex": "^\\{$"
                },
                {
                  "kind": "comment",
                  "follows": {
                    "matches": "block-open"
                  }
                }
              ]
            },
            "block-close": {
              "any": [
                {
                  "regex": "^\\}$"
                },
                {
                  "kind": "comment",
                  "precedes": {
                    "matches": "block-close"
                  }
                }
              ]
            },
            "assign": {
              "kind": "expression_statement",
              "has": {
                "kind": "assignment_expression",
                "pattern": "$X = $_",
                "not": {
                  "has": {
                    "follows": {
                      "regex": "^=$"
                    },
                    "regex": "\\n"
                  }
                }
              }
            },
            "then-value": {
              "any": [
                {
                  "matches": "assign"
                },
                {
                  "kind": "statement_block",
                  "has": {
                    "matches": "only-statement",
                    "all": [
                      {
                        "matches": "then-value"
                      }
                    ]
                  }
                }
              ]
            },
            "else-value": {
              "any": [
                {
                  "matches": "assign"
                },
                {
                  "kind": "statement_block",
                  "has": {
                    "matches": "only-statement",
                    "all": [
                      {
                        "matches": "else-value"
                      }
                    ]
                  }
                }
              ]
            },
            "assigning-if": {
              "kind": "if_statement",
              "has": {
                "follows": {
                  "kind": "parenthesized_expression"
                },
                "matches": "then-value"
              },
              "all": [
                {
                  "has": {
                    "kind": "else_clause",
                    "has": {
                      "matches": "else-value"
                    }
                  }
                }
              ]
            },
            "chain-link": {
              "any": [
                {
                  "inside": {
                    "kind": "else_clause",
                    "inside": {
                      "kind": "if_statement"
                    }
                  }
                },
                {
                  "inside": {
                    "kind": "statement_block",
                    "matches": "chain-link"
                  },
                  "matches": "only-statement"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.IF",
        "code": "PREFER_CONDITIONAL_EXPRESSION",
        "message": "Use a conditional expression instead of assigning to '$X' in multiple places."
      }
    }
  ]
}
