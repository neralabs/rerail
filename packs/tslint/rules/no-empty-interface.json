{
  "format": "rerail.policy/v1",
  "id": "tslint:no-empty-interface",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-empty-interface` rule with its default options (https://palantir.github.io/tslint/rules/no-empty-interface/). Forbids empty interfaces.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "empty-interface",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "type_identifier"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "interface_declaration",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "all": [
                          {
                            "kind": "interface_body"
                          },
                          {
                            "regex": "^\\{\\s*\\}$"
                          }
                        ]
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "extends_type_clause"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-empty-interface",
        "message": "An empty interface is equivalent to `{}`."
      }
    },
    {
      "id": "empty-interface-extends",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "type_identifier"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "interface_declaration",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "all": [
                          {
                            "kind": "interface_body"
                          },
                          {
                            "regex": "^\\{\\s*\\}$"
                          }
                        ]
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "all": [
                          {
                            "kind": "extends_type_clause"
                          },
                          {
                            "not": {
                              "regex": "[,<]"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-empty-interface",
        "message": "An interface declaring no members is equivalent to its supertype."
      }
    }
  ]
}
