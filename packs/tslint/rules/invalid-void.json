{
  "format": "rerail.policy/v1",
  "id": "tslint:invalid-void",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `invalid-void` rule with its default options (https://palantir.github.io/tslint/rules/invalid-void/). Disallows void outside of return types and generic type arguments (TSLint default: allow-generics true).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "invalid-void",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "predefined_type"
              },
              {
                "regex": "^void$"
              },
              {
                "any": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "type_annotation",
                      "inside": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "any": [
                              {
                                "kind": "property_signature"
                              },
                              {
                                "kind": "public_field_definition"
                              },
                              {
                                "kind": "variable_declarator"
                              },
                              {
                                "kind": "required_parameter"
                              },
                              {
                                "kind": "optional_parameter"
                              }
                            ]
                          },
                          {
                            "all": [
                              {
                                "kind": "index_signature"
                              },
                              {
                                "has": {
                                  "stopBy": "neighbor",
                                  "kind": "mapped_type_clause"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "type_alias_declaration"
                        },
                        {
                          "kind": "union_type"
                        },
                        {
                          "kind": "intersection_type"
                        },
                        {
                          "kind": "constraint"
                        },
                        {
                          "kind": "default_type"
                        },
                        {
                          "kind": "as_expression"
                        },
                        {
                          "kind": "index_type_query"
                        },
                        {
                          "kind": "readonly_type"
                        },
                        {
                          "kind": "array_type"
                        },
                        {
                          "kind": "conditional_type"
                        },
                        {
                          "kind": "type_query"
                        }
                      ]
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "type_arguments",
                      "inside": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "kind": "call_expression"
                          },
                          {
                            "kind": "type_assertion"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "INVALID_VOID",
        "message": "void is only valid as a return type or generic type variable"
      }
    }
  ]
}
