{
  "format": "rerail.policy/v1",
  "id": "tslint:no-construct",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-construct` rule with its default options (https://palantir.github.io/tslint/rules/no-construct/). Disallows access to the constructors of String, Number, and Boolean.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "primitive-wrapper-constructor",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "any": [
              {
                "pattern": "new String($$$A)"
              },
              {
                "pattern": "new Number($$$A)"
              },
              {
                "pattern": "new Boolean($$$A)"
              },
              {
                "pattern": "new String"
              },
              {
                "pattern": "new Number"
              },
              {
                "pattern": "new Boolean"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-construct",
        "message": "Forbidden constructor, use a literal or simple function call instead"
      }
    }
  ]
}
