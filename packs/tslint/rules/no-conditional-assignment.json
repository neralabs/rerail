{
  "format": "rerail.policy/v1",
  "id": "tslint:no-conditional-assignment",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-conditional-assignment` rule with its default options (https://palantir.github.io/tslint/rules/no-conditional-assignment/). Disallows assignments in if/while/do/for conditions and ternary conditions.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "conditional-assignment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "assignment_expression"
                  },
                  {
                    "kind": "augmented_assignment_expression"
                  }
                ]
              },
              {
                "any": [
                  {
                    "all": [
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "for_statement"
                        }
                      },
                      {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": ";$"
                        }
                      },
                      {
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^;$"
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "ternary_expression"
                        }
                      },
                      {
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^\\?$"
                        }
                      }
                    ]
                  },
                  {
                    "inside": {
                      "stopBy": "end",
                      "any": [
                        {
                          "all": [
                            {
                              "kind": "parenthesized_expression"
                            },
                            {
                              "inside": {
                                "stopBy": "neighbor",
                                "any": [
                                  {
                                    "kind": "if_statement"
                                  },
                                  {
                                    "kind": "while_statement"
                                  },
                                  {
                                    "kind": "do_statement"
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "all": [
                            {
                              "inside": {
                                "stopBy": "neighbor",
                                "kind": "ternary_expression"
                              }
                            },
                            {
                              "precedes": {
                                "stopBy": "neighbor",
                                "regex": "^\\?$"
                              }
                            }
                          ]
                        },
                        {
                          "all": [
                            {
                              "inside": {
                                "stopBy": "neighbor",
                                "kind": "for_statement"
                              }
                            },
                            {
                              "follows": {
                                "stopBy": "neighbor",
                                "regex": ";$"
                              }
                            },
                            {
                              "precedes": {
                                "stopBy": "neighbor",
                                "regex": "^;$"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "all": [
                      {
                        "not": {
                          "any": [
                            {
                              "kind": "binary_expression"
                            },
                            {
                              "kind": "assignment_expression"
                            },
                            {
                              "kind": "augmented_assignment_expression"
                            },
                            {
                              "kind": "parenthesized_expression"
                            },
                            {
                              "kind": "non_null_expression"
                            },
                            {
                              "kind": "as_expression"
                            },
                            {
                              "kind": "type_assertion"
                            },
                            {
                              "kind": "unary_expression"
                            },
                            {
                              "kind": "ternary_expression"
                            },
                            {
                              "kind": "sequence_expression"
                            }
                          ]
                        }
                      },
                      {
                        "any": [
                          {
                            "all": [
                              {
                                "inside": {
                                  "stopBy": "neighbor",
                                  "kind": "for_statement"
                                }
                              },
                              {
                                "follows": {
                                  "stopBy": "neighbor",
                                  "regex": ";$"
                                }
                              },
                              {
                                "precedes": {
                                  "stopBy": "neighbor",
                                  "regex": "^;$"
                                }
                              }
                            ]
                          },
                          {
                            "all": [
                              {
                                "inside": {
                                  "stopBy": "neighbor",
                                  "kind": "ternary_expression"
                                }
                              },
                              {
                                "precedes": {
                                  "stopBy": "neighbor",
                                  "regex": "^\\?$"
                                }
                              }
                            ]
                          },
                          {
                            "inside": {
                              "stopBy": "end",
                              "any": [
                                {
                                  "all": [
                                    {
                                      "kind": "parenthesized_expression"
                                    },
                                    {
                                      "inside": {
                                        "stopBy": "neighbor",
                                        "any": [
                                          {
                                            "kind": "if_statement"
                                          },
                                          {
                                            "kind": "while_statement"
                                          },
                                          {
                                            "kind": "do_statement"
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                },
                                {
                                  "all": [
                                    {
                                      "inside": {
                                        "stopBy": "neighbor",
                                        "kind": "ternary_expression"
                                      }
                                    },
                                    {
                                      "precedes": {
                                        "stopBy": "neighbor",
                                        "regex": "^\\?$"
                                      }
                                    }
                                  ]
                                },
                                {
                                  "all": [
                                    {
                                      "inside": {
                                        "stopBy": "neighbor",
                                        "kind": "for_statement"
                                      }
                                    },
                                    {
                                      "follows": {
                                        "stopBy": "neighbor",
                                        "regex": ";$"
                                      }
                                    },
                                    {
                                      "precedes": {
                                        "stopBy": "neighbor",
                                        "regex": "^;$"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "no-conditional-assignment",
        "message": "Assignments in conditional expressions are forbidden"
      }
    }
  ]
}
