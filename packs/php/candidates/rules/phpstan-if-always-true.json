{
  "format": "rerail.policy/v1",
  "id": "phpstan-if-always-true",
  "revision": 1,
  "mode": "steer",
  "description": "Remove PHP if conditions that are always true; the check is redundant and often hides a logic mistake.",
  "scope": {
    "include": [
      "**/*.php"
    ],
    "exclude": [
      "**/*.blade.php"
    ]
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "all": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "parenthesized_expression",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "if_statement",
                    "field": "condition",
                    "not": {
                      "follows": {
                        "stopBy": "neighbor",
                        "kind": "comment",
                        "parse": {
                          "grammar": "phpDoc",
                          "has": {
                            "stopBy": "end",
                            "kind": "var_tag_value"
                          }
                        }
                      }
                    }
                  }
                },
                "value": {
                  "truthy": true,
                  "follow": true
                },
                "not": {
                  "any": [
                    {
                      "kind": "binary_expression",
                      "has": {
                        "field": "operator",
                        "regex": "^(==|!=|<>|===|!==|\\&\\&|\\|\\||<|>|<=|>=|instanceof)$"
                      }
                    },
                    {
                      "kind": "unary_op_expression",
                      "regex": "^!"
                    },
                    {
                      "kind": "conditional_expression"
                    },
                    {
                      "kind": "function_call_expression",
                      "has": {
                        "field": "function",
                        "regex": "^(?i:isset|empty)$"
                      }
                    }
                  ]
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "kind": "trait_declaration"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "if.alwaysTrue",
        "message": "Fix this always-true condition so it tests something real, or remove the if and keep its body.",
        "suppress": {
          "phpstan": {
            "identifiers": [
              "if.alwaysTrue"
            ]
          }
        }
      }
    }
  ]
}
