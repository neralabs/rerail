{
  "format": "rerail.policy/v1",
  "id": "psalm-unused-variable",
  "revision": 1,
  "mode": "steer",
  "description": "Remove PHP variables whose value is never read, including unused closure use and global imports; names starting with $_ are exempt.",
  "scope": {
    "include": [
      "**/*.php"
    ],
    "exclude": [
      "**/*.blade.php"
    ]
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "kind": "variable_name",
            "not": {
              "any": [
                {
                  "regex": "^\\$_"
                },
                {
                  "binds": {
                    "occurrence": {
                      "inside": {
                        "kind": "unset_statement",
                        "stopBy": "end"
                      }
                    }
                  }
                }
              ]
            },
            "any": [
              {
                "binds": {
                  "form": "assignment",
                  "used": false,
                  "site": {
                    "kind": "assignment_expression",
                    "inside": {
                      "kind": "expression_statement",
                      "stopBy": "neighbor"
                    }
                  }
                }
              },
              {
                "binds": {
                  "form": "assignment",
                  "used": false,
                  "site": {
                    "kind": "subscript_expression",
                    "inside": {
                      "kind": "assignment_expression",
                      "stopBy": {
                        "not": {
                          "kind": "subscript_expression"
                        }
                      },
                      "inside": {
                        "kind": "expression_statement",
                        "stopBy": "neighbor"
                      }
                    }
                  }
                },
                "not": {
                  "binds": {
                    "redefines": {}
                  }
                }
              },
              {
                "binds": {
                  "form": "augmented",
                  "used": false,
                  "site": {
                    "inside": {
                      "any": [
                        {
                          "kind": "expression_statement"
                        },
                        {
                          "kind": "arrow_function"
                        }
                      ],
                      "stopBy": "neighbor"
                    }
                  }
                }
              },
              {
                "binds": {
                  "form": "global",
                  "used": false
                }
              },
              {
                "binds": {
                  "form": "parameter",
                  "used": false,
                  "site": {
                    "kind": "anonymous_function_use_clause"
                  }
                }
              },
              {
                "binds": {
                  "form": "for",
                  "used": false
                },
                "not": {
                  "any": [
                    {
                      "inside": {
                        "kind": "foreach_statement",
                        "stopBy": "neighbor"
                      }
                    },
                    {
                      "inside": {
                        "kind": "pair",
                        "stopBy": "neighbor",
                        "inside": {
                          "kind": "foreach_statement",
                          "stopBy": "neighbor"
                        }
                      },
                      "nthChild": 2
                    },
                    {
                      "inside": {
                        "kind": "by_ref",
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "inside": {
                              "kind": "foreach_statement",
                              "stopBy": "neighbor"
                            }
                          },
                          {
                            "inside": {
                              "kind": "pair",
                              "stopBy": "neighbor",
                              "inside": {
                                "kind": "foreach_statement",
                                "stopBy": "neighbor"
                              }
                            },
                            "nthChild": 2
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "UnusedVariable",
        "message": "The variable is never referenced or the value is not used",
        "suppress": {
          "psalm": {
            "issues": [
              "UnusedVariable"
            ]
          }
        }
      }
    }
  ]
}
