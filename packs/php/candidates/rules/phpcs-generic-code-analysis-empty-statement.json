{
  "format": "rerail.policy/v1",
  "id": "phpcs-generic-code-analysis-empty-statement",
  "revision": 1,
  "mode": "steer",
  "description": "Remove empty PHP control structure bodies, such as an if, loop, switch, try, catch or match block holding only comments; they hide unfinished or swallowed logic.",
  "scope": {
    "include": [
      "**/*.php"
    ],
    "exclude": [
      "**/*.blade.php"
    ]
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "any": [
              {
                "kind": "if_statement"
              },
              {
                "kind": "else_if_clause"
              },
              {
                "kind": "else_clause"
              },
              {
                "kind": "for_statement"
              },
              {
                "kind": "foreach_statement"
              },
              {
                "kind": "while_statement"
              },
              {
                "kind": "do_statement"
              },
              {
                "kind": "switch_statement"
              },
              {
                "kind": "try_statement"
              },
              {
                "kind": "catch_clause"
              },
              {
                "kind": "finally_clause"
              },
              {
                "kind": "match_expression"
              }
            ],
            "has": {
              "field": "body",
              "any": [
                {
                  "kind": "compound_statement"
                },
                {
                  "kind": "switch_block",
                  "regex": "^\\{"
                },
                {
                  "kind": "match_block"
                }
              ],
              "not": {
                "has": {
                  "not": {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "regex": "^[{}]$"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "Generic.CodeAnalysis.EmptyStatement",
        "message": "Empty statement detected",
        "suppress": {
          "phpcs": {
            "sniffs": [
              "Generic.CodeAnalysis.EmptyStatement"
            ]
          }
        }
      }
    }
  ]
}
