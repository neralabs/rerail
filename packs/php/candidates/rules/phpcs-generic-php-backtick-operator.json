{
  "format": "rerail.policy/v1",
  "id": "phpcs-generic-php-backtick-operator",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid the backtick shell operator in PHP; it runs shell commands implicitly and invites command injection.",
  "scope": {
    "include": [
      "**/*.php"
    ],
    "exclude": [
      "**/*.blade.php"
    ]
  },
  "clauses": [
    {
      "id": "opening",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "kind": "shell_command_expression"
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "Generic.PHP.BacktickOperator",
        "message": "Replace this backtick shell command with proc_open() given the command as an array, so no shell parses the arguments.",
        "suppress": {
          "phpcs": {
            "sniffs": [
              "Generic.PHP.BacktickOperator.Found"
            ]
          }
        }
      }
    },
    {
      "id": "closing",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "kind": "shell_command_expression"
          }
        }
      },
      "violation": {
        "anchor": "witness.end",
        "code": "Generic.PHP.BacktickOperator",
        "message": "Replace this backtick shell command with proc_open() given the command as an array, so no shell parses the arguments.",
        "suppress": {
          "phpcs": {
            "sniffs": [
              "Generic.PHP.BacktickOperator.Found"
            ]
          }
        }
      }
    }
  ]
}
