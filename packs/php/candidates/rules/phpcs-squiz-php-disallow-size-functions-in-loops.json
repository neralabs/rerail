{
  "format": "rerail.policy/v1",
  "id": "phpcs-squiz-php-disallow-size-functions-in-loops",
  "revision": 1,
  "mode": "steer",
  "description": "PHP_CodeSniffer 4.0.4 Squiz.PHP.DisallowSizeFunctionsInLoops: count(), sizeof() and strlen() called in a for, while or do-while condition.",
  "scope": {
    "include": [
      "**/*.php"
    ],
    "exclude": [
      "**/*.blade.php"
    ]
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "kind": "function_call_expression",
            "has": {
              "field": "function",
              "regex": "^\\\\?(count|sizeof|strlen)$"
            },
            "inside": {
              "stopBy": "end",
              "field": "condition",
              "any": [
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "do_statement"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "Squiz.PHP.DisallowSizeFunctionsInLoops",
        "message": "The use of count(), sizeof() or strlen() inside a loop condition is not allowed; assign the return value to a variable and use the variable in the loop condition instead",
        "suppress": {
          "phpcs": {
            "sniffs": [
              "Squiz.PHP.DisallowSizeFunctionsInLoops.Found"
            ]
          }
        }
      }
    }
  ]
}
