{
  "format": "rerail.policy/v1",
  "id": "phpcs-squiz-php-disallow-size-functions-in-loops",
  "revision": 2,
  "mode": "steer",
  "description": "PHP_CodeSniffer 4.0.4 Squiz.PHP.DisallowSizeFunctionsInLoops: count(), sizeof() and strlen() called in a for, while or do-while condition. Divergence: not reported when the loop changes the value it measures, because then its size must be read on every pass and hoisting it changes what the loop does. The loop changes it when it assigns or appends to it (=, []=, +=, .=), unsets one of its elements, passes it to array_push, array_unshift, array_pop, array_shift or array_splice, or, for a $this property, calls a method on $this (NER-1812).",
  "scope": {
    "include": [
      "**/*.php"
    ],
    "exclude": [
      "**/*.blade.php"
    ]
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "kind": "function_call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "regex": "^\\\\?(count|sizeof|strlen)$"
                }
              },
              {
                "matches": "first-argument-is-V"
              }
            ],
            "inside": {
              "stopBy": "end",
              "field": "condition",
              "any": [
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "do_statement"
                }
              ]
            },
            "not": {
              "any": [
                {
                  "inside": {
                    "stopBy": "end",
                    "field": "condition",
                    "all": [
                      {
                        "any": [
                          {
                            "kind": "for_statement"
                          },
                          {
                            "kind": "while_statement"
                          },
                          {
                            "kind": "do_statement"
                          }
                        ]
                      },
                      {
                        "matches": "loop-writes-V"
                      }
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "has": {
                        "field": "arguments",
                        "has": {
                          "kind": "argument",
                          "nthChild": {
                            "position": 1,
                            "ofRule": {
                              "kind": "argument"
                            }
                          },
                          "has": {
                            "nthChild": {
                              "position": 1,
                              "reverse": true,
                              "ofRule": {
                                "not": {
                                  "kind": "comment"
                                }
                              }
                            },
                            "kind": "member_access_expression",
                            "has": {
                              "field": "object",
                              "regex": "^\\$this$"
                            }
                          }
                        }
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "end",
                        "field": "condition",
                        "all": [
                          {
                            "any": [
                              {
                                "kind": "for_statement"
                              },
                              {
                                "kind": "while_statement"
                              },
                              {
                                "kind": "do_statement"
                              }
                            ]
                          },
                          {
                            "matches": "loop-calls-method-on-this"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          },
          "utils": {
            "first-argument-is-V": {
              "has": {
                "field": "arguments",
                "has": {
                  "kind": "argument",
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "kind": "argument"
                    }
                  },
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "reverse": true,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "pattern": "$V"
                  }
                }
              }
            },
            "function-boundary": {
              "any": [
                {
                  "kind": "anonymous_function"
                },
                {
                  "kind": "arrow_function"
                },
                {
                  "kind": "function_definition"
                },
                {
                  "kind": "method_declaration"
                }
              ]
            },
            "V-or-its-element": {
              "any": [
                {
                  "pattern": "$V"
                },
                {
                  "kind": "subscript_expression",
                  "has": {
                    "nthChild": 1,
                    "pattern": "$V"
                  }
                }
              ]
            },
            "writes-V": {
              "any": [
                {
                  "kind": "assignment_expression",
                  "has": {
                    "field": "left",
                    "matches": "V-or-its-element"
                  }
                },
                {
                  "kind": "augmented_assignment_expression",
                  "has": {
                    "field": "left",
                    "matches": "V-or-its-element"
                  }
                },
                {
                  "kind": "function_call_expression",
                  "all": [
                    {
                      "has": {
                        "field": "function",
                        "regex": "^\\\\?(array_push|array_unshift|array_pop|array_shift|array_splice)$"
                      }
                    },
                    {
                      "matches": "first-argument-is-V"
                    }
                  ]
                },
                {
                  "kind": "unset_statement",
                  "has": {
                    "stopBy": "end",
                    "kind": "subscript_expression",
                    "has": {
                      "nthChild": 1,
                      "pattern": "$V"
                    }
                  }
                }
              ]
            },
            "calls-method-on-this": {
              "kind": "member_call_expression",
              "has": {
                "field": "object",
                "regex": "^\\$this$"
              }
            },
            "loop-writes-V": {
              "any": [
                {
                  "any": [
                    {
                      "has": {
                        "field": "condition",
                        "matches": "writes-V"
                      }
                    },
                    {
                      "has": {
                        "field": "condition",
                        "has": {
                          "stopBy": {
                            "matches": "function-boundary"
                          },
                          "matches": "writes-V"
                        }
                      }
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "has": {
                        "field": "update",
                        "matches": "writes-V"
                      }
                    },
                    {
                      "has": {
                        "field": "update",
                        "has": {
                          "stopBy": {
                            "matches": "function-boundary"
                          },
                          "matches": "writes-V"
                        }
                      }
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "has": {
                        "field": "body",
                        "matches": "writes-V"
                      }
                    },
                    {
                      "has": {
                        "field": "body",
                        "has": {
                          "stopBy": {
                            "matches": "function-boundary"
                          },
                          "matches": "writes-V"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "loop-calls-method-on-this": {
              "any": [
                {
                  "any": [
                    {
                      "has": {
                        "field": "condition",
                        "matches": "calls-method-on-this"
                      }
                    },
                    {
                      "has": {
                        "field": "condition",
                        "has": {
                          "stopBy": {
                            "matches": "function-boundary"
                          },
                          "matches": "calls-method-on-this"
                        }
                      }
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "has": {
                        "field": "update",
                        "matches": "calls-method-on-this"
                      }
                    },
                    {
                      "has": {
                        "field": "update",
                        "has": {
                          "stopBy": {
                            "matches": "function-boundary"
                          },
                          "matches": "calls-method-on-this"
                        }
                      }
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "has": {
                        "field": "body",
                        "matches": "calls-method-on-this"
                      }
                    },
                    {
                      "has": {
                        "field": "body",
                        "has": {
                          "stopBy": {
                            "matches": "function-boundary"
                          },
                          "matches": "calls-method-on-this"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "Squiz.PHP.DisallowSizeFunctionsInLoops",
        "message": "The loop condition re-reads the size of $V on every pass, and this rule found no change to $V inside the loop. If nothing changes it, assign the size to a variable before the loop and use the variable in the condition.",
        "suppress": {
          "phpcs": {
            "sniffs": [
              "Squiz.PHP.DisallowSizeFunctionsInLoops.Found"
            ]
          }
        }
      }
    }
  ]
}
