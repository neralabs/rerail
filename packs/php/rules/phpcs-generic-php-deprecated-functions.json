{
  "format": "rerail.policy/v1",
  "id": "phpcs-generic-php-deprecated-functions",
  "revision": 1,
  "mode": "steer",
  "description": "Replace calls to deprecated built-in PHP functions, such as strftime(), utf8_encode() and curl_close(); they raise deprecation notices and will be removed.",
  "scope": {
    "include": [
      "**/*.php"
    ],
    "exclude": [
      "**/*.blade.php"
    ]
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "kind": "function_call_expression",
            "has": {
              "field": "function",
              "resolves": {
                "import": [
                  "strftime",
                  "gmstrftime",
                  "date_sunrise",
                  "date_sunset",
                  "libxml_disable_entity_loader",
                  "openssl_x509_free",
                  "openssl_pkey_free",
                  "openssl_free_key",
                  "curl_close",
                  "curl_share_close",
                  "finfo_close",
                  "imagedestroy",
                  "mhash_get_block_size",
                  "mhash_get_hash_name",
                  "mhash_keygen_s2k",
                  "mhash_count",
                  "mhash",
                  "intlcal_set",
                  "intlgregcal_create_instance",
                  "strptime",
                  "assert_options",
                  "utf8_encode",
                  "utf8_decode",
                  "socket_set_timeout",
                  "mysqli_execute",
                  "mysqli_kill",
                  "mysqli_ping",
                  "mysqli_refresh",
                  "odbc_result_all",
                  "pg_errormessage",
                  "pg_numrows",
                  "pg_numfields",
                  "pg_cmdtuples",
                  "pg_fieldname",
                  "pg_fieldsize",
                  "pg_fieldtype",
                  "pg_fieldnum",
                  "pg_result",
                  "pg_fieldprtlen",
                  "pg_fieldisnull",
                  "pg_freeresult",
                  "pg_getlastoid",
                  "pg_locreate",
                  "pg_lounlink",
                  "pg_loopen",
                  "pg_loclose",
                  "pg_loread",
                  "pg_lowrite",
                  "pg_loreadall",
                  "pg_loimport",
                  "pg_loexport",
                  "pg_setclientencoding",
                  "pg_clientencoding",
                  "lcg_value",
                  "shmop_close",
                  "xml_set_object",
                  "xml_parser_free",
                  "zip_open",
                  "zip_close",
                  "zip_read",
                  "zip_entry_open",
                  "zip_entry_close",
                  "zip_entry_read",
                  "zip_entry_name",
                  "zip_entry_compressedsize",
                  "zip_entry_filesize",
                  "zip_entry_compressionmethod"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "Generic.PHP.DeprecatedFunctions",
        "message": "Replace this deprecated function with its current equivalent, or delete the call if it is now a no-op like curl_close().",
        "suppress": {
          "phpcs": {
            "sniffs": [
              "Generic.PHP.DeprecatedFunctions.Deprecated"
            ]
          }
        }
      }
    }
  ]
}
