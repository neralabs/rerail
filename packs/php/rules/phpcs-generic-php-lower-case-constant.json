{
  "format": "rerail.policy/v1",
  "id": "phpcs-generic-php-lower-case-constant",
  "revision": 1,
  "mode": "steer",
  "description": "Write true, false and null in lowercase in PHP, including their fully qualified forms.",
  "scope": {
    "include": [
      "**/*.php"
    ],
    "exclude": [
      "**/*.blade.php"
    ]
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "php",
          "rule": {
            "any": [
              {
                "kind": "boolean"
              },
              {
                "kind": "null"
              },
              {
                "kind": "qualified_name",
                "regex": "^\\\\(?i:true|false|null)$"
              }
            ],
            "regex": "[A-Z]"
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "Generic.PHP.LowerCaseConstant",
        "message": "TRUE, FALSE and NULL must be lowercase",
        "suppress": {
          "phpcs": {
            "sniffs": [
              "Generic.PHP.LowerCaseConstant.Found"
            ]
          }
        }
      }
    }
  ]
}
