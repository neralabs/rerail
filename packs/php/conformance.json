{
  "pack": "php",
  "family": "php",
  "capabilities": ["syntax", "value", "compare", "arguments", "scope", "calls", "formatArgs", "phpDoc", "suppression"],
  "corpora": [
    {
      "name": "laravel",
      "repository": "https://github.com/laravel/framework",
      "commit": "e5f3d6265f4b9d3d9efc466de83f79c54e14dd5d",
      "paths": ["src", "tests"],
      "exclude": ["**/*.blade.php"]
    },
    {
      "name": "symfony",
      "repository": "https://github.com/symfony/symfony",
      "commit": "2c4011aa7edf6000d3d3ff98b2749c3dbf5e52b9",
      "paths": ["src"],
      "exclude": ["**/*.blade.php"]
    }
  ],
  "tools": [
    { "name": "phpstan", "version": "2.2.16" },
    { "name": "psalm", "version": "6.19.1" },
    { "name": "phpcs", "version": "4.0.4" }
  ],
  "exemptCapabilities": [
    {
      "capability": "calls",
      "reason": "No pinned reference linter has a rule that reads callees transitively, which is what Rerail's calls capability answers.",
      "evidence": "Checked PHPStan 2.2.16, Psalm 6.19.1 and PHP_CodeSniffer 4.0.4: every rule that looks at a call (PHPStan's CallToFunctionParametersRule and impossible-check rules, Psalm's ForbiddenCode and argument checks, PHP_CodeSniffer's ForbiddenFunctions and DeprecatedFunctions) reads only the direct callee's declaration or name. Psalm's taint analysis follows data flow into sinks, not the call graph, so none answers whether a function reaches a call of X through any chain of calls.",
      "coveredBy": [
        "T2: fixtures/php/calls/php (calls::php_tests::php_calls_agree_with_phpstan_and_the_runtime)",
        "T3: benchmark_php_calls_corpus (124,611 PHPStan-resolved calls over laravel and symfony, 0 disagreements)"
      ]
    }
  ],
  "rules": [
    {"id": "phpcs-generic-code-analysis-empty-statement", "upstream": {"tool": "phpcs", "rule": "Generic.CodeAnalysis.EmptyStatement"}, "policy": "rules/phpcs-generic-code-analysis-empty-statement.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
    {"id": "phpcs-generic-php-backtick-operator", "upstream": {"tool": "phpcs", "rule": "Generic.PHP.BacktickOperator"}, "policy": "rules/phpcs-generic-php-backtick-operator.json", "capabilities": ["syntax", "suppression"], "match": "line"},
    {"id": "phpcs-generic-php-deprecated-functions", "upstream": {"tool": "phpcs", "rule": "Generic.PHP.DeprecatedFunctions"}, "policy": "candidates/rules/phpcs-generic-php-deprecated-functions.json", "capabilities": ["scope", "suppression"], "match": "line+column"},
    {"id": "phpcs-generic-php-forbidden-functions", "upstream": {"tool": "phpcs", "rule": "Generic.PHP.ForbiddenFunctions"}, "policy": "candidates/rules/phpcs-generic-php-forbidden-functions.json", "capabilities": ["scope", "suppression"], "match": "line+column"},
    {"id": "phpcs-generic-php-lower-case-constant", "upstream": {"tool": "phpcs", "rule": "Generic.PHP.LowerCaseConstant"}, "policy": "rules/phpcs-generic-php-lower-case-constant.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
    {"id": "phpcs-generic-php-no-silenced-errors", "upstream": {"tool": "phpcs", "rule": "Generic.PHP.NoSilencedErrors"}, "policy": "candidates/rules/phpcs-generic-php-no-silenced-errors.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
    {"id": "phpcs-squiz-php-disallow-size-functions-in-loops", "upstream": {"tool": "phpcs", "rule": "Squiz.PHP.DisallowSizeFunctionsInLoops"}, "policy": "candidates/rules/phpcs-squiz-php-disallow-size-functions-in-loops.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
    {"id": "phpcs-squiz-php-eval", "upstream": {"tool": "phpcs", "rule": "Squiz.PHP.Eval"}, "policy": "rules/phpcs-squiz-php-eval.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
    {"id": "phpstan-variable-undefined", "upstream": {"tool": "phpstan", "rule": "variable.undefined"}, "policy": "candidates/rules/phpstan-variable-undefined.json", "capabilities": ["scope", "suppression"], "match": "line"},
    {"id": "phpstan-argument-sprintf", "upstream": {"tool": "phpstan", "rule": "argument.sprintf"}, "policy": "candidates/rules/phpstan-argument-sprintf.json", "capabilities": ["formatArgs", "scope", "syntax", "suppression"], "match": "line"},
    {"id": "phpstan-argument-sscanf", "upstream": {"tool": "phpstan", "rule": "argument.sscanf"}, "policy": "rules/phpstan-argument-sscanf.json", "capabilities": ["formatArgs", "scope", "syntax", "suppression"], "match": "line"},
    {"id": "phpstan-array-duplicate-key", "upstream": {"tool": "phpstan", "rule": "array.duplicateKey"}, "policy": "candidates/rules/phpstan-array-duplicate-key.json", "capabilities": ["compare", "syntax", "suppression"], "match": "line"},
    {"id": "phpstan-random-int-parameters", "upstream": {"tool": "phpstan", "rule": "argument.type"}, "policy": "candidates/rules/phpstan-random-int-parameters.json", "capabilities": ["arguments", "compare", "value", "scope", "suppression"], "match": "line"},
    {"id": "phpstan-missing-function-return-type", "upstream": {"tool": "phpstan", "rule": "missingType.return"}, "policy": "rules/phpstan-missing-function-return-type.json", "capabilities": ["phpDoc", "syntax", "suppression"], "match": "line"},
    {"id": "phpstan-if-always-true", "upstream": {"tool": "phpstan", "rule": "if.alwaysTrue"}, "policy": "candidates/rules/phpstan-if-always-true.json", "capabilities": ["value", "phpDoc", "suppression"], "match": "line"},
    {"id": "phpstan-if-always-false", "upstream": {"tool": "phpstan", "rule": "if.alwaysFalse"}, "policy": "candidates/rules/phpstan-if-always-false.json", "capabilities": ["value", "phpDoc", "suppression"], "match": "line"},
    {"id": "psalm-unused-variable", "upstream": {"tool": "psalm", "rule": "UnusedVariable"}, "policy": "candidates/rules/psalm-unused-variable.json", "capabilities": ["scope", "suppression"], "match": "line+column"},
    {"id": "psalm-forbidden-code", "upstream": {"tool": "psalm", "rule": "ForbiddenCode"}, "policy": "rules/psalm-forbidden-code.json", "capabilities": ["scope", "syntax", "suppression"], "match": "line+column"}
  ]
}
