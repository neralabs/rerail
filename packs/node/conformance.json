{
  "pack": "node",
  "family": "ecma",
  "capabilities": [
    "syntax",
    "scope",
    "value",
    "suppression"
  ],
  "corpora": [
    {
      "name": "fastify",
      "repository": "https://github.com/fastify/fastify",
      "commit": "0d945819bebc08f4ca666d8283c03a26ed9706a0",
      "paths": [
        "fastify.js",
        "fastify.d.ts",
        "lib",
        "test",
        "examples",
        "build",
        "integration",
        "scripts",
        "types"
      ],
      "exclude": []
    },
    {
      "name": "prettier",
      "repository": "https://github.com/prettier/prettier",
      "commit": "5927216227411bc2cdaf30d50559e0a475ab4832",
      "paths": [
        "src",
        "scripts"
      ],
      "exclude": []
    }
  ],
  "tools": [
    {
      "name": "eslint-plugin-n",
      "version": "18.4.1"
    }
  ],
  "rules": [
    {
      "id": "n-no-process-exit",
      "upstream": {
        "tool": "eslint-plugin-n",
        "rule": "n/no-process-exit"
      },
      "policy": "rules/n-no-process-exit.json",
      "capabilities": [
        "syntax",
        "suppression"
      ],
      "match": "line+column"
    },
    {
      "id": "n-no-new-require",
      "upstream": {
        "tool": "eslint-plugin-n",
