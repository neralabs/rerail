{
  "format": "rerail.policy/v1",
  "id": "n-no-exports-assign",
  "revision": 3,
  "mode": "steer",
  "description": "eslint-plugin-n 18.4.1 n/no-exports-assign: an assignment to the global `exports` (CommonJS scope), except `module.exports = exports = \u2026` and `exports = module.exports = \u2026`. No sourceType is pinned, so each file keeps its own module system (.cjs/.cts CommonJS; .mjs/.mts/.tsx an ES module; .js/.jsx/.ts by the nearest package.json's type, Node's syntax detection where that package.json sets no valid type, and an ES module where there is no package.json). As eslint-plugin-n's own configs (flat/mixed-esm-and-cjs picks per file), a CommonJS file has require, module, exports, __dirname and __filename (flat/recommended-script) and an ES module none of them (flat/recommended-module turns them off). So only a CommonJS file has the global `exports`; an ES module's assignments are not reported.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "languageOptions": {},
          "rule": {
            "any": [
              {
                "kind": "assignment_expression"
              },
              {
                "kind": "augmented_assignment_expression"
              }
            ],
            "has": {
              "kind": "identifier",
              "regex": "^exports$",
              "resolves": {
                "global": [
                  "exports"
                ]
              },
              "field": "left"
            },
            "not": {
              "any": [
                {
                  "inside": {
                    "kind": "assignment_expression",
                    "all": [
                      {
                        "has": {
                          "field": "left",
                          "kind": "member_expression",
                          "all": [
                            {
                              "has": {
                                "kind": "identifier",
                                "regex": "^module$",
                                "resolves": {
                                  "global": [
                                    "module"
                                  ]
                                },
                                "field": "object"
                              }
                            },
                            {
                              "has": {
                                "field": "property",
                                "kind": "property_identifier",
                                "regex": "^exports$"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "nthChild": {
                    "position": 1,
                    "reverse": true
                  }
                },
                {
                  "has": {
                    "field": "right",
                    "kind": "assignment_expression",
                    "has": {
                      "field": "left",
                      "kind": "member_expression",
                      "all": [
                        {
                          "has": {
                            "kind": "identifier",
                            "regex": "^module$",
                            "resolves": {
                              "global": [
                                "module"
                              ]
                            },
                            "field": "object"
                          }
                        },
                        {
                          "has": {
                            "field": "property",
                            "kind": "property_identifier",
                            "regex": "^exports$"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/no-exports-assign",
        "message": "Unexpected assignment to 'exports' variable. Use 'module.exports' instead.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/no-exports-assign"
            ]
          },
          "oxlint": {
            "rules": [
              "no-exports-assign"
            ]
          }
        }
      }
    }
  ]
}
