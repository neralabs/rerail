{
  "format": "rerail.policy/v1",
  "id": "n-prefer-promises-fs",
  "revision": 7,
  "mode": "steer",
  "description": "Use the promise-based fs API instead of callback-style fs functions such as readFile and writeFile, for cleaner async code.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "c1": {
            "any": [
              {
                "kind": "string"
              },
              {
                "kind": "template_string",
                "not": {
                  "has": {
                    "kind": "template_substitution"
                  }
                }
              }
            ],
            "value": {
              "regex": "^(?:access|copyFile|open|rename|truncate|rmdir|mkdir|readdir|readlink|symlink|lstat|stat|link|unlink|chmod|lchmod|lchown|chown|utimes|realpath|mkdtemp|writeFile|appendFile|readFile|cp|glob|lutimes|opendir|rm|statfs)$"
            }
          },
          "c2": {
            "not": {
              "resolves": {
                "binding": {
                  "site": {
                    "has": {
                      "field": "name",
                      "kind": "identifier"
                    },
                    "inside": {
                      "kind": "lexical_declaration",
                      "regex": "^const\\b"
                    },
                    "kind": "variable_declarator"
                  }
                }
              }
            }
          },
          "c3": {
            "kind": "template_string",
            "not": {
              "has": {
                "kind": "template_substitution"
              }
            }
          }
        }
      }
    },
    {
      "id": "call",
      "forbid": {
        "ast": {
          "language": "typescript",
          "languageOptions": {
            "moduleSystem": "package-type",
            "globals": {
              "process": "readonly"
            }
          },
          "utils": {
            "file-names-module": {
              "kind": "program",
              "has": {
                "stopBy": "end",
                "any": [
                  {
                    "kind": "string"
                  },
                  {
                    "matches": "c3"
                  }
                ],
                "regex": "fs|\\\\",
                "value": {
                  "regex": "^(?:node:)?fs$"
                }
              }
            },
            "require-callee": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^require$",
                  "resolves": {
                    "global": [
                      "require"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "require-callee"
                  }
                }
              ]
            },
            "builtin-callee": {
              "any": [
                {
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "kind": "identifier",
                        "regex": "^process$",
                        "resolves": {
                          "global": [
                            "process"
                          ]
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "property",
                        "kind": "property_identifier",
                        "regex": "^getBuiltinModule$"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "builtin-callee"
                  }
                }
              ]
            },
            "module-call": {
              "kind": "call_expression",
              "not": {
                "has": {
                  "field": "arguments",
                  "kind": "template_string"
                }
              },
              "all": [
                {
                  "has": {
                    "field": "arguments",
                    "kind": "arguments",
                    "has": {
                      "nthChild": {
                        "position": 1,
                        "ofRule": {
                          "not": {
                            "kind": "comment"
                          }
                        }
                      },
                      "any": [
                        {
                          "kind": "string"
                        },
                        {
                          "matches": "c3"
                        }
                      ],
                      "value": {
                        "regex": "^(?:node:)?fs$"
                      }
                    }
                  }
                },
                {
                  "has": {
                    "field": "function",
                    "any": [
                      {
                        "matches": "require-callee"
                      },
                      {
                        "matches": "builtin-callee"
                      }
                    ]
                  }
                }
              ]
            },
            "module-value": {
              "any": [
                {
                  "matches": "module-call"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "module-value"
                  }
                },
                {
                  "kind": "assignment_expression",
                  "has": {
                    "field": "right",
                    "matches": "module-value"
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "destructuredValue": false,
                      "value": {
                        "matches": "module-value"
                      }
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "all": [
                    {
                      "not": {
                        "resolves": {
                          "binding": {
                            "form": "import"
                          }
                        }
                      }
                    },
                    {
                      "matches": "c2"
                    }
                  ],
                  "resolves": {
                    "binding": {
                      "occurrence": {
                        "inside": {
                          "kind": "assignment_expression",
                          "field": "left",
                          "has": {
                            "field": "right",
                            "matches": "module-value"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "matches": "esm-ref"
                },
                {
                  "kind": "member_expression",
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "matches": "esm-ref"
                      }
                    },
                    {
                      "has": {
                        "field": "property",
                        "kind": "property_identifier",
                        "regex": "^default$"
                      }
                    }
                  ]
                }
              ]
            },
            "esm-source": {
              "kind": "string",
              "has": {
                "kind": "string_fragment",
                "regex": "^(?:node:)?fs$"
              }
            },
            "esm-whole-module": {
              "any": [
                {
                  "kind": "namespace_import"
                },
                {
                  "kind": "import_clause"
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "kind": "import_clause"
                  }
                }
              ],
              "inside": {
                "stopBy": "end",
                "kind": "import_statement",
                "has": {
                  "field": "source",
                  "matches": "esm-source"
                }
              }
            },
            "esm-ref": {
              "kind": "identifier",
              "resolves": {
                "binding": {
                  "site": {
                    "matches": "esm-whole-module"
                  }
                }
              }
            },
            "fn-value": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "member_expression",
                      "all": [
                        {
                          "has": {
                            "field": "object",
                            "matches": "module-value"
                          }
                        },
                        {
                          "has": {
                            "field": "property",
                            "kind": "property_identifier",
                            "regex": "^(?:access|copyFile|open|rename|truncate|rmdir|mkdir|readdir|readlink|symlink|lstat|stat|link|unlink|chmod|lchmod|lchown|chown|utimes|realpath|mkdtemp|writeFile|appendFile|readFile|cp|glob|lutimes|opendir|rm|statfs)$"
                          }
                        }
                      ]
                    },
                    {
                      "kind": "subscript_expression",
                      "all": [
                        {
                          "has": {
                            "field": "object",
                            "matches": "module-value"
                          }
                        },
                        {
                          "has": {
                            "field": "index",
                            "any": [
                              {
                                "kind": "string"
                              },
                              {
                                "matches": "c3"
                              }
                            ],
                            "value": {
                              "regex": "^(?:access|copyFile|open|rename|truncate|rmdir|mkdir|readdir|readlink|symlink|lstat|stat|link|unlink|chmod|lchmod|lchown|chown|utimes|realpath|mkdtemp|writeFile|appendFile|readFile|cp|glob|lutimes|opendir|rm|statfs)$"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "fn-value"
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "destructuredValue": false,
                      "value": {
                        "matches": "fn-value"
                      }
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "all": [
                    {
                      "not": {
                        "resolves": {
                          "binding": {
                            "form": "import"
                          }
                        }
                      }
                    },
                    {
                      "matches": "c2"
                    }
                  ],
                  "resolves": {
                    "binding": {
                      "occurrence": {
                        "any": [
                          {
                            "kind": "shorthand_property_identifier_pattern",
                            "regex": "^(?:access|copyFile|open|rename|truncate|rmdir|mkdir|readdir|readlink|symlink|lstat|stat|link|unlink|chmod|lchmod|lchown|chown|utimes|realpath|mkdtemp|writeFile|appendFile|readFile|cp|glob|lutimes|opendir|rm|statfs)$",
                            "inside": {
                              "kind": "object_pattern",
                              "any": [
                                {
                                  "inside": {
                                    "kind": "variable_declarator",
                                    "field": "name",
                                    "has": {
                                      "field": "value",
                                      "matches": "module-value"
                                    }
                                  }
                                },
                                {
                                  "inside": {
                                    "kind": "assignment_expression",
                                    "field": "left",
                                    "has": {
                                      "field": "right",
                                      "matches": "module-value"
                                    }
                                  }
                                },
                                {
                                  "inside": {
                                    "kind": "assignment_pattern",
                                    "field": "left",
                                    "has": {
                                      "field": "right",
                                      "matches": "module-value"
                                    }
                                  }
                                }
                              ]
                            }
                          },
                          {
                            "kind": "identifier",
                            "inside": {
                              "kind": "pair_pattern",
                              "field": "value",
                              "has": {
                                "field": "key",
                                "any": [
                                  {
                                    "kind": "property_identifier",
                                    "regex": "^(?:access|copyFile|open|rename|truncate|rmdir|mkdir|readdir|readlink|symlink|lstat|stat|link|unlink|chmod|lchmod|lchown|chown|utimes|realpath|mkdtemp|writeFile|appendFile|readFile|cp|glob|lutimes|opendir|rm|statfs)$"
                                  },
                                  {
                                    "matches": "c1"
                                  },
                                  {
                                    "kind": "computed_property_name",
                                    "has": {
                                      "matches": "c1"
                                    }
                                  }
                                ]
                              },
                              "inside": {
                                "kind": "object_pattern",
                                "any": [
                                  {
                                    "inside": {
                                      "kind": "variable_declarator",
                                      "field": "name",
                                      "has": {
                                        "field": "value",
                                        "matches": "module-value"
                                      }
                                    }
                                  },
                                  {
                                    "inside": {
                                      "kind": "assignment_expression",
                                      "field": "left",
                                      "has": {
                                        "field": "right",
                                        "matches": "module-value"
                                      }
                                    }
                                  },
                                  {
                                    "inside": {
                                      "kind": "assignment_pattern",
                                      "field": "left",
                                      "has": {
                                        "field": "right",
                                        "matches": "module-value"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          },
                          {
                            "kind": "identifier",
                            "inside": {
                              "kind": "object_assignment_pattern",
                              "has": {
                                "field": "left",
                                "kind": "shorthand_property_identifier_pattern",
                                "regex": "^(?:access|copyFile|open|rename|truncate|rmdir|mkdir|readdir|readlink|symlink|lstat|stat|link|unlink|chmod|lchmod|lchown|chown|utimes|realpath|mkdtemp|writeFile|appendFile|readFile|cp|glob|lutimes|opendir|rm|statfs)$"
                              },
                              "inside": {
                                "kind": "object_pattern",
                                "any": [
                                  {
                                    "inside": {
                                      "kind": "variable_declarator",
                                      "field": "name",
                                      "has": {
                                        "field": "value",
                                        "matches": "module-value"
                                      }
                                    }
                                  },
                                  {
                                    "inside": {
                                      "kind": "assignment_expression",
                                      "field": "left",
                                      "has": {
                                        "field": "right",
                                        "matches": "module-value"
                                      }
                                    }
                                  },
                                  {
                                    "inside": {
                                      "kind": "assignment_pattern",
                                      "field": "left",
                                      "has": {
                                        "field": "right",
                                        "matches": "module-value"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "site": {
                        "kind": "import_specifier",
                        "has": {
                          "field": "name",
                          "regex": "^(?:access|copyFile|open|rename|truncate|rmdir|mkdir|readdir|readlink|symlink|lstat|stat|link|unlink|chmod|lchmod|lchown|chown|utimes|realpath|mkdtemp|writeFile|appendFile|readFile|cp|glob|lutimes|opendir|rm|statfs)$"
                        },
                        "inside": {
                          "stopBy": "end",
                          "kind": "import_statement",
                          "has": {
                            "field": "source",
                            "matches": "esm-source"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call_expression",
            "inside": {
              "stopBy": "end",
              "matches": "file-names-module"
            },
            "not": {
              "has": {
                "field": "arguments",
                "kind": "template_string"
              }
            },
            "has": {
              "field": "function",
              "matches": "fn-value"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/prefer-promises/fs",
        "message": "Use the fs.promises version of this function and await it instead of passing a callback.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/prefer-promises/fs"
            ]
          }
        }
      }
    }
  ]
}
