                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    },
                    "position": 2
                  }
                }
              }
            }
          },
          "c2": {
            "inside": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "program"
                    },
                    {
                      "kind": "statement_block"
                    },
                    {
                      "kind": "class_body"
                    }
                  ],
                  "has": {
                    "any": [
                      {
                        "any": [
                          {
                            "kind": "lexical_declaration"
                          },
                          {
                            "kind": "variable_declaration"
                          }
