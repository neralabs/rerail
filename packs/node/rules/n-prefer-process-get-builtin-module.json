                        "kind": "identifier",
                        "regex": "^process$"
                      },
                      {
                        "matches": "c4"
                      }
                    ],
                    "field": "parameter"
                  },
                  "kind": "catch_clause"
                },
                {
                  "any": [
                    {
                      "kind": "function_declaration"
                    },
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "method_definition"
                    },
                    {
                      "kind": "generator_function"
                    },
                    {
                      "kind": "generator_function_declaration"
                    }
                  ],
                  "has": {
                    "field": "parameters",
                    "has": {
                      "kind": "identifier",
                      "not": {
                        "inside": {
                          "field": "right",
                          "kind": "assignment_pattern",
                          "stopBy": "end"
                        }
                      },
                      "regex": "^process$",
                      "stopBy": "end"
                    }
                  }
                },
                {
                  "has": {
                    "field": "parameter",
                    "regex": "^process$"
                  },
                  "kind": "arrow_function"
                }
              ],
              "stopBy": "end"
            }
          },
          "c3": {
            "any": [
              {
                "has": {
                  "any": [
                    {
                      "kind": "identifier",
                      "regex": "^process$"
                    },
                    {
                      "matches": "c4"
                    }
                  ],
                  "field": "name"
                },
                "kind": "variable_declarator"
              },
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "class_declaration"
                  }
                ],
                "has": {
                  "field": "name",
                  "regex": "^process$"
                }
              },
              {
                "has": {
                  "has": {
                    "kind": "identifier",
                    "not": {
                      "inside": {
                        "field": "name",
                        "has": {
                          "field": "alias",
                          "kind": "identifier"
                        },
                        "kind": "import_specifier"
                      }
                    },
                    "regex": "^process$",
                    "stopBy": "end"
                  },
                  "kind": "import_clause"
                },
                "kind": "import_statement"
              }
            ]
          },
          "c4": {
            "has": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "shorthand_property_identifier_pattern"
                }
              ],
              "regex": "^process$",
              "stopBy": "end"
            }
          }
        }
      }
    },
    {
      "id": "require",
      "forbid": {
        "ast": {
          "language": "typescript",
          "languageOptions": {
            "moduleSystem": "package-type"
          },
          "file": {
            "package": {
              "nodeVersion": {
                "subsetOf": "^20.16.0 || >=22.3.0"
              }
            }
          },
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "identifier",
              "regex": "^require$",
              "any": [
                {
                  "resolves": {
                    "global": [
                      "require"
                    ],
                    "declared": false
                  }
                },
                {
                  "resolves": {
                    "binding": {
                      "site": {
                        "kind": "variable_declarator",
                        "has": {
                          "field": "name",
                          "kind": "identifier"
                        },
                        "inside": {
                          "kind": "lexical_declaration",
                          "has": {
                            "field": "kind",
                            "regex": "^const$"
                          }
                        },
                        "all": [
                          {
                            "has": {
                              "field": "value",
                              "kind": "call_expression",
                              "has": {
                                "field": "function",
                                "kind": "identifier",
                                "resolves": {
                                  "binding": {
                                    "site": {
                                      "kind": "import_specifier",
                                      "has": {
                                        "field": "name",
                                        "kind": "identifier",
                                        "regex": "^createRequire$"
                                      },
                                      "inside": {
                                        "stopBy": "end",
                                        "kind": "import_statement",
                                        "has": {
                                          "field": "source",
                                          "kind": "string",
                                          "value": {
                                            "regex": "^(?:node:)?module$"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "all": [
              {
                "matches": "c1"
              },
              {
                "not": {
                  "has": {
                    "kind": "optional_chain"
                  }
                }
              },
              {
                "not": {
                  "matches": "c2"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/prefer-process-get-builtin-module",
        "message": "Load this built-in module with process.getBuiltinModule() instead of require().",
        "suppress": {
          "eslint": {
            "rules": [
              "n/prefer-process-get-builtin-module"
            ]
          }
        }
      }
    },
    {
      "id": "import",
      "forbid": {
        "ast": {
          "language": "typescript",
          "languageOptions": {
            "moduleSystem": "package-type"
          },
          "file": {
            "package": {
              "nodeVersion": {
                "subsetOf": "^20.16.0 || >=22.3.0"
              }
            }
          },
          "rule": {
            "kind": "await_expression",
            "has": {
              "kind": "call_expression",
              "has": {
                "field": "function",
                "kind": "import"
              },
              "all": [
                {
                  "matches": "c1"
                }
              ]
            },
            "not": {
              "matches": "c2"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/prefer-process-get-builtin-module",
        "message": "Load this built-in module with process.getBuiltinModule() instead of await import().",
        "suppress": {
          "eslint": {
            "rules": [
              "n/prefer-process-get-builtin-module"
            ]
          }
        }
      }
    }
