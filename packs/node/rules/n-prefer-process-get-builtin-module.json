{
  "format": "rerail.policy/v1",
  "id": "n-prefer-process-get-builtin-module",
  "revision": 2,
  "mode": "steer",
  "description": "Load Node.js built-in modules with process.getBuiltinModule() instead of require() or await import(), when the project's Node versions support it.",
  "scope": {
