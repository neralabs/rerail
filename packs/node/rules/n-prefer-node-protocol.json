{
  "format": "rerail.policy/v1",
  "id": "n-prefer-node-protocol",
  "revision": 1,
  "mode": "steer",
  "description": "eslint-plugin-n 18.4.1 n/prefer-node-protocol (default options): a string literal whose value names a module of the plugin's NodeBuiltinModules table (lib/unsupported-features/node-builtins.js) that the table also lists as `node:<name>`, as the only argument of a non-optional `require(\u2026)`, the first of `process.getBuiltinModule(\u2026)`/`globalThis.process.getBuiltinModule(\u2026)`, the source of an import/export declaration or of `import(\u2026)`. Upstream reads names only, no scope. As upstream, the file's configured Node range (the nearest package.json's `engines.node`, else its `devEngines.runtime` entry named node, else >=16.0.0) must be a subset of ^12.20.0 || >=14.13.1 for imports and of ^14.18.0 || >=16.0.0 for require (that range lies inside the first); process.getBuiltinModule is checked whatever the range. Not ported: the `version` option and the `n`/`node` settings that override the range.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "require",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "nodeVersion": {
                "subsetOf": "^14.18.0 || >=16.0.0"
              }
            }
          },
          "rule": {
            "kind": "string",
            "value": {
              "regex": "^(?:assert|assert/strict|async_hooks|buffer|child_process|cluster|console|crypto|dgram|diagnostics_channel|dns|dns/promises|events|fs|fs/promises|http2|http|https|inspector|inspector/promises|module|net|os|path|path/posix|path/win32|perf_hooks|process|querystring|readline|readline/promises|repl|stream|stream/promises|stream/web|stream/consumers|string_decoder|timers|timers/promises|tls|trace_events|tty|url|util|util/types|v8|vm|wasi|worker_threads|zlib)$"
            },
            "nthChild": {
              "position": 1,
              "ofRule": {
                "not": {
                  "kind": "comment"
                }
              }
            },
            "inside": {
              "kind": "arguments",
              "not": {
                "has": {
                  "nthChild": {
                    "position": 2,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              "inside": {
                "field": "arguments",
                "kind": "call_expression",
                "not": {
                  "has": {
                    "kind": "optional_chain"
                  }
                },
                "has": {
                  "field": "function",
                  "kind": "identifier",
                  "regex": "^require$"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/prefer-node-protocol",
        "message": "Prefer `node:<module>` over `<module>`.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/prefer-node-protocol"
            ]
          }
        }
      }
    },
    {
      "id": "get-builtin-module",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "string",
            "value": {
              "regex": "^(?:assert|assert/strict|async_hooks|buffer|child_process|cluster|console|crypto|dgram|diagnostics_channel|dns|dns/promises|events|fs|fs/promises|http2|http|https|inspector|inspector/promises|module|net|os|path|path/posix|path/win32|perf_hooks|process|querystring|readline|readline/promises|repl|stream|stream/promises|stream/web|stream/consumers|string_decoder|timers|timers/promises|tls|trace_events|tty|url|util|util/types|v8|vm|wasi|worker_threads|zlib)$"
            },
            "nthChild": {
              "position": 1,
              "ofRule": {
                "not": {
                  "kind": "comment"
                }
              }
            },
            "inside": {
              "kind": "arguments",
              "inside": {
                "field": "arguments",
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "any": [
                    {
                      "kind": "member_expression",
                      "all": [
                        {
                          "has": {
                            "field": "property",
                            "kind": "property_identifier",
                            "regex": "^getBuiltinModule$"
                          }
                        },
                        {
                          "has": {
                            "field": "object",
                            "any": [
                              {
                                "kind": "identifier",
                                "regex": "^process$"
                              },
                              {
                                "kind": "member_expression",
                                "all": [
                                  {
                                    "has": {
                                      "field": "object",
                                      "kind": "identifier",
                                      "regex": "^globalThis$"
                                    }
                                  },
                                  {
                                    "has": {
                                      "field": "property",
                                      "kind": "property_identifier",
                                      "regex": "^process$"
                                    }
                                  }
                                ]
                              },
                              {
                                "kind": "subscript_expression",
                                "all": [
                                  {
                                    "has": {
                                      "field": "object",
                                      "kind": "identifier",
                                      "regex": "^globalThis$"
                                    }
                                  },
                                  {
                                    "has": {
                                      "field": "index",
                                      "any": [
                                        {
                                          "kind": "string",
                                          "has": {
                                            "kind": "string_fragment",
                                            "regex": "^process$"
                                          }
                                        },
                                        {
                                          "kind": "template_string",
                                          "not": {
                                            "has": {
                                              "kind": "template_substitution"
                                            }
                                          },
                                          "has": {
                                            "kind": "string_fragment",
                                            "regex": "^process$"
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "kind": "subscript_expression",
                      "all": [
                        {
                          "has": {
                            "field": "index",
                            "any": [
                              {
                                "kind": "string",
                                "has": {
                                  "kind": "string_fragment",
                                  "regex": "^getBuiltinModule$"
                                }
                              },
                              {
                                "kind": "template_string",
                                "not": {
                                  "has": {
                                    "kind": "template_substitution"
                                  }
                                },
                                "has": {
                                  "kind": "string_fragment",
                                  "regex": "^getBuiltinModule$"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "has": {
                            "field": "object",
                            "kind": "identifier",
                            "regex": "^process$"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/prefer-node-protocol",
        "message": "Prefer `node:<module>` over `<module>`.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/prefer-node-protocol"
            ]
          }
        }
      }
    },
    {
      "id": "import-export-source",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "nodeVersion": {
                "subsetOf": "^12.20.0 || >=14.13.1"
              }
            }
          },
          "rule": {
            "kind": "string",
            "value": {
              "regex": "^(?:assert|assert/strict|async_hooks|buffer|child_process|cluster|console|crypto|dgram|diagnostics_channel|dns|dns/promises|events|fs|fs/promises|http2|http|https|inspector|inspector/promises|module|net|os|path|path/posix|path/win32|perf_hooks|process|querystring|readline|readline/promises|repl|stream|stream/promises|stream/web|stream/consumers|string_decoder|timers|timers/promises|tls|trace_events|tty|url|util|util/types|v8|vm|wasi|worker_threads|zlib)$"
            },
            "inside": {
              "field": "source",
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "export_statement"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/prefer-node-protocol",
        "message": "Prefer `node:<module>` over `<module>`.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/prefer-node-protocol"
            ]
          }
        }
      }
    },
    {
      "id": "import-expression",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "nodeVersion": {
                "subsetOf": "^12.20.0 || >=14.13.1"
              }
            }
          },
          "rule": {
            "kind": "string",
            "value": {
              "regex": "^(?:assert|assert/strict|async_hooks|buffer|child_process|cluster|console|crypto|dgram|diagnostics_channel|dns|dns/promises|events|fs|fs/promises|http2|http|https|inspector|inspector/promises|module|net|os|path|path/posix|path/win32|perf_hooks|process|querystring|readline|readline/promises|repl|stream|stream/promises|stream/web|stream/consumers|string_decoder|timers|timers/promises|tls|trace_events|tty|url|util|util/types|v8|vm|wasi|worker_threads|zlib)$"
            },
            "nthChild": {
              "position": 1,
              "ofRule": {
                "not": {
                  "kind": "comment"
                }
              }
            },
            "inside": {
              "kind": "arguments",
              "inside": {
                "field": "arguments",
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "kind": "import"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/prefer-node-protocol",
        "message": "Prefer `node:<module>` over `<module>`.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/prefer-node-protocol"
            ]
          }
        }
      }
    }
  ]
