{
  "format": "rerail.policy/v1",
  "id": "n-callback-return",
  "revision": 1,
  "mode": "steer",
  "description": "eslint-plugin-n 18.4.1 n/callback-return (default callbacks callback, cb, next): a call of one of those names inside a function, unless its nearest block/return/arrow ancestor is a return or an arrow function, it is the last statement of a function body (or the right side of a binary/logical expression statement there), or the statement just before a block's final return.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "call_expression",
            "not": {
              "has": {
                "field": "arguments",
                "kind": "template_string"
              }
            },
            "all": [
              {
                "has": {
                  "field": "function",
                  "kind": "identifier",
                  "regex": "^(?:callback|cb|next)$"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": {
                      "any": [
                        {
                          "kind": "statement_block"
                        },
                        {
                          "kind": "return_statement"
                        },
                        {
                          "kind": "arrow_function"
                        }
                      ]
                    },
                    "any": [
                      {
                        "kind": "return_statement"
                      },
                      {
                        "kind": "arrow_function"
                      }
                    ]
                  }
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "inside": {
                        "kind": "expression_statement",
                        "nthChild": {
                          "position": 1,
                          "reverse": true,
                          "ofRule": {
                            "not": {
                              "kind": "comment"
                            }
                          }
                        },
                        "inside": {
                          "kind": "statement_block",
                          "inside": {
                            "any": [
                              {
                                "kind": "function_declaration"
                              },
                              {
                                "kind": "function_expression"
                              },
                              {
                                "kind": "generator_function_declaration"
                              },
                              {
                                "kind": "generator_function"
                              },
                              {
                                "kind": "arrow_function"
                              },
                              {
                                "kind": "method_definition"
                              }
                            ],
                            "field": "body"
                          }
                        }
                      }
                    },
                    {
                      "inside": {
                        "kind": "binary_expression",
                        "field": "right",
                        "inside": {
                          "kind": "expression_statement",
                          "nthChild": {
                            "position": 1,
                            "reverse": true,
                            "ofRule": {
                              "not": {
                                "kind": "comment"
                              }
                            }
                          },
                          "inside": {
                            "kind": "statement_block",
                            "inside": {
                              "any": [
                                {
                                  "kind": "function_declaration"
                                },
                                {
                                  "kind": "function_expression"
                                },
                                {
                                  "kind": "generator_function_declaration"
                                },
                                {
                                  "kind": "generator_function"
                                },
                                {
                                  "kind": "arrow_function"
                                },
                                {
                                  "kind": "method_definition"
                                }
                              ],
                              "field": "body"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "inside": {
                        "kind": "expression_statement",
                        "nthChild": {
                          "position": 2,
                          "reverse": true,
                          "ofRule": {
                            "not": {
                              "kind": "comment"
                            }
                          }
                        },
                        "inside": {
                          "kind": "statement_block",
                          "has": {
                            "kind": "return_statement",
                            "nthChild": {
                              "position": 1,
                              "reverse": true,
                              "ofRule": {
                                "not": {
                                  "kind": "comment"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "inside": {
                        "kind": "binary_expression",
                        "field": "right",
                        "inside": {
                          "kind": "expression_statement",
                          "nthChild": {
                            "position": 2,
                            "reverse": true,
                            "ofRule": {
                              "not": {
                                "kind": "comment"
                              }
                            }
                          },
                          "inside": {
                            "kind": "statement_block",
                            "has": {
                              "kind": "return_statement",
                              "nthChild": {
                                "position": 1,
                                "reverse": true,
                                "ofRule": {
                                  "not": {
                                    "kind": "comment"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "function_declaration"
                    },
                    {
                      "kind": "function_expression"
                    },
                    {
                      "kind": "generator_function_declaration"
                    },
                    {
                      "kind": "generator_function"
                    },
                    {
                      "kind": "arrow_function"
                    },
                    {
                      "kind": "method_definition"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/callback-return",
        "message": "Expected return with your callback function.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/callback-return"
            ]
          }
        }
      }
    }
  ]
}
