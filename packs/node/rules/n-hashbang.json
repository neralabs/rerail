{
  "format": "rerail.policy/v1",
  "id": "n-hashbang",
  "revision": 1,
  "mode": "steer",
  "description": "Start the files that package.json lists as bin executables with a node shebang line, and leave the shebang off every other file.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "needs-no-shebang",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "bin": false
            }
          },
          "rule": {
            "kind": "hash_bang_line",
            "inside": {
              "kind": "program",
              "regex": "\\A#![^\\r\\n\\x{2028}\\x{2029}]+\\r?\\n"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/hashbang",
        "message": "Remove the shebang line; package.json does not list this file as a bin executable.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/hashbang"
            ]
          }
        }
      }
    },
    {
      "id": "needs-shebang",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "bin": true
            }
          },
          "rule": {
            "kind": "program",
            "not": {
              "regex": "\\A#!/usr/bin/env(?:[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*(?:[A-Za-z0-9_]+=\"(?:[^\"\\\\\\r\\n\\x{2028}\\x{2029}]|\\\\[^\\r\\n\\x{2028}\\x{2029}])*\"|(?:[A-Za-z0-9_]+=[A-Za-z0-9_]+)?(?:--(?:[^A-Za-z0-9_\\r\\n\\x{2028}\\x{2029}]|[A-Za-z0-9_]+[^A-Za-z0-9_\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\r\\n\\x{2028}\\x{2029}])*[A-Za-z0-9_]+|-[ivS]+|-[Pu](?:[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]+|=)[^\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\r\\n\\x{2028}\\x{2029}]+)[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]|[A-Za-z0-9_]+=[A-Za-z0-9_]+[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]))*[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*node(?: [^\\r\\n\\x{2028}\\x{2029}]*|[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*)\\r?\\n"
            }
          }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "n/hashbang",
        "message": "Add #!/usr/bin/env node as the first line; package.json lists this file as a bin executable.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/hashbang"
            ]
          }
        }
      }
    },
    {
      "id": "byte-order-mark",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "bin": true
            },
            "byteOrderMark": true
          },
          "rule": {
            "kind": "program",
            "regex": "\\A#!/usr/bin/env(?:[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*(?:[A-Za-z0-9_]+=\"(?:[^\"\\\\\\r\\n\\x{2028}\\x{2029}]|\\\\[^\\r\\n\\x{2028}\\x{2029}])*\"|(?:[A-Za-z0-9_]+=[A-Za-z0-9_]+)?(?:--(?:[^A-Za-z0-9_\\r\\n\\x{2028}\\x{2029}]|[A-Za-z0-9_]+[^A-Za-z0-9_\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\r\\n\\x{2028}\\x{2029}])*[A-Za-z0-9_]+|-[ivS]+|-[Pu](?:[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]+|=)[^\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\r\\n\\x{2028}\\x{2029}]+)[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]|[A-Za-z0-9_]+=[A-Za-z0-9_]+[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]))*[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*node(?: [^\\r\\n\\x{2028}\\x{2029}]*|[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*)\\r?\\n"
          }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "n/hashbang",
        "message": "Remove the byte order mark before the shebang; a bin executable's first bytes must be #!, or the system cannot run it.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/hashbang"
            ]
          }
        }
      }
    },
    {
      "id": "crlf",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "bin": true
            }
          },
          "rule": {
            "kind": "program",
            "regex": "\\A#!/usr/bin/env(?:[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*(?:[A-Za-z0-9_]+=\"(?:[^\"\\\\\\r\\n\\x{2028}\\x{2029}]|\\\\[^\\r\\n\\x{2028}\\x{2029}])*\"|(?:[A-Za-z0-9_]+=[A-Za-z0-9_]+)?(?:--(?:[^A-Za-z0-9_\\r\\n\\x{2028}\\x{2029}]|[A-Za-z0-9_]+[^A-Za-z0-9_\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\r\\n\\x{2028}\\x{2029}])*[A-Za-z0-9_]+|-[ivS]+|-[Pu](?:[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]+|=)[^\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\r\\n\\x{2028}\\x{2029}]+)[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]|[A-Za-z0-9_]+=[A-Za-z0-9_]+[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]))*[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*node(?: [^\\r\\n\\x{2028}\\x{2029}]*|[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*)\\r\\n"
          }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "n/hashbang",
        "message": "End the shebang line with LF, not CRLF; the system reads the carriage return as part of the interpreter's name and cannot run the file.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/hashbang"
            ]
          }
        }
      }
    }
  ]
}
