{
  "format": "rerail.rule-pack/v1",
  "id": "node",
  "name": "Node.js",
  "category": "framework",
  "covers": "No rules yet: its 24 eslint-plugin-n ports are candidates until they pass the port readiness gates.",
  "reason": "matches Node.js",
  "match": {
    "any": [
      {
        "dependencies": {
          "ecosystem": "npm",
          "names": [
            "@types/node"
          ]
        }
      },
      {
        "files": [
          "**/*.mjs",
          "**/*.cjs"
        ],
        "label": "*.mjs and *.cjs files"
      }
    ]
  },
  "rules": []
}
