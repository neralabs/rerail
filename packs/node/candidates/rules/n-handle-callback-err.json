{
  "format": "rerail.policy/v1",
  "id": "n-handle-callback-err",
  "revision": 2,
  "mode": "steer",
  "description": "Handle the err parameter of error-first callbacks instead of leaving it unused; ignoring it silently swallows failures.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "function",
      "forbid": {
        "ast": {
          "language": "typescript",
          "utils": {
            "first-err": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^err$",
                  "binds": {
                    "form": "parameter",
                    "referenced": false
                  }
                },
                {
                  "any": [
                    {
                      "kind": "required_parameter"
                    },
                    {
                      "kind": "optional_parameter"
                    }
                  ],
                  "has": {
                    "field": "pattern",
                    "any": [
                      {
                        "kind": "identifier",
                        "regex": "^err$",
                        "binds": {
                          "form": "parameter",
                          "referenced": false
                        }
                      },
                      {
                        "kind": "rest_pattern",
                        "has": {
                          "kind": "identifier",
                          "regex": "^err$",
                          "binds": {
                            "form": "parameter",
                            "referenced": false
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "assignment_pattern",
                  "has": {
                    "field": "left",
                    "kind": "identifier",
                    "regex": "^err$",
                    "binds": {
                      "form": "parameter",
                      "referenced": false
                    }
                  }
                },
                {
                  "kind": "rest_pattern",
                  "has": {
                    "kind": "identifier",
                    "regex": "^err$",
                    "binds": {
                      "form": "parameter",
                      "referenced": false
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "any": [
              {
                "any": [
                  {
                    "kind": "function_declaration"
                  },
                  {
                    "kind": "function_expression"
                  },
                  {
                    "kind": "generator_function_declaration"
                  },
                  {
                    "kind": "generator_function"
                  },
                  {
                    "kind": "arrow_function"
                  }
                ],
                "has": {
                  "field": "parameters",
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "matches": "first-err"
                  }
                }
              },
              {
                "kind": "arrow_function",
                "has": {
                  "field": "parameter",
                  "kind": "identifier",
                  "regex": "^err$",
                  "binds": {
                    "form": "parameter",
                    "referenced": false
                  }
                }
              },
              {
                "kind": "formal_parameters",
                "inside": {
                  "kind": "method_definition",
                  "field": "parameters"
                },
                "has": {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  },
                  "matches": "first-err"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/handle-callback-err",
        "message": "Expected error to be handled.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/handle-callback-err"
            ]
          },
          "oxlint": {
            "rules": [
              "handle-callback-err"
            ]
          }
        }
      }
    }
  ]
}
