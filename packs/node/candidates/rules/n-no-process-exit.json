{
  "format": "rerail.policy/v1",
  "id": "n-no-process-exit",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid calling process.exit(); throw an error instead so pending work can finish and callers can handle the failure.",
  "scope": {
    "include": ["**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "all": [
                { "has": { "field": "object", "kind": "identifier", "regex": "^process$" } },
                { "has": { "field": "property", "kind": "property_identifier", "regex": "^exit$" } }
              ]
            },
            "not": { "has": { "field": "arguments", "kind": "template_string" } }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/no-process-exit",
        "message": "Throw an error instead of calling process.exit(), so pending work can finish and callers can handle it.",
        "suppress": { "eslint": { "rules": ["n/no-process-exit"] } }
      }
    }
  ]
}
