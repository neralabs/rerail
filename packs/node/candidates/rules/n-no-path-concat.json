{
  "format": "rerail.policy/v1",
  "id": "n-no-path-concat",
  "revision": 3,
  "mode": "steer",
  "description": "Use path.join() or path.resolve() instead of concatenating __dirname, __filename or import.meta paths with strings; hand-built paths break across platforms.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "require-callee": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^require$",
                "resolves": {
                  "global": [
                    "require"
                  ]
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "require-callee"
                }
              }
            ]
          },
          "builtin-callee": {
            "any": [
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "identifier",
                      "regex": "^process$",
                      "resolves": {
                        "global": [
                          "process"
                        ]
                      }
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "kind": "property_identifier",
                      "regex": "^getBuiltinModule$"
                    }
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "builtin-callee"
                }
              }
            ]
          },
          "module-call": {
            "kind": "call_expression",
            "not": {
              "has": {
                "field": "arguments",
                "kind": "template_string"
              }
            },
            "all": [
              {
                "has": {
                  "field": "arguments",
                  "kind": "arguments",
                  "has": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "not": {
                          "kind": "comment"
                        }
                      }
                    },
                    "any": [
                      {
                        "kind": "string"
                      },
                      {
                        "kind": "template_string",
                        "not": {
                          "has": {
                            "kind": "template_substitution"
                          }
                        }
                      }
                    ],
                    "value": {
                      "regex": "^(?:node:)?path$"
                    }
                  }
                }
              },
              {
                "has": {
                  "field": "function",
                  "any": [
                    {
                      "matches": "require-callee"
                    },
                    {
                      "matches": "builtin-callee"
                    }
                  ]
                }
              }
            ]
          },
          "module-value": {
            "any": [
              {
                "matches": "module-call"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "module-value"
                }
              },
              {
                "kind": "assignment_expression",
                "has": {
                  "field": "right",
                  "matches": "module-value"
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "destructuredValue": false,
                    "value": {
                      "matches": "module-value"
                    }
                  }
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "occurrence": {
                      "inside": {
                        "kind": "assignment_expression",
                        "field": "left",
                        "has": {
                          "field": "right",
                          "matches": "module-value"
                        }
                      }
                    }
                  }
                }
              },
              {
                "matches": "esm-ref"
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "matches": "esm-ref"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "kind": "property_identifier",
                      "regex": "^default$"
                    }
                  }
                ]
              }
            ]
          },
          "esm-source": {
            "kind": "string",
            "has": {
              "kind": "string_fragment",
              "regex": "^(?:node:)?path$"
            }
          },
          "esm-whole-module": {
            "any": [
              {
                "kind": "namespace_import"
              },
              {
                "kind": "import_clause"
              },
              {
                "kind": "identifier",
                "inside": {
                  "kind": "import_clause"
                }
              }
            ],
            "inside": {
              "stopBy": "end",
              "kind": "import_statement",
              "has": {
                "field": "source",
                "matches": "esm-source"
              }
            }
          },
          "esm-ref": {
            "kind": "identifier",
            "resolves": {
              "binding": {
                "site": {
                  "matches": "esm-whole-module"
                }
              }
            }
          },
          "fn-value": {
            "any": [
              {
                "any": [
                  {
                    "kind": "member_expression",
                    "all": [
                      {
                        "has": {
                          "field": "object",
                          "matches": "module-value"
                        }
                      },
                      {
                        "has": {
                          "field": "property",
                          "kind": "property_identifier",
                          "regex": "^sep$"
                        }
                      }
                    ]
                  },
                  {
                    "kind": "subscript_expression",
                    "all": [
                      {
                        "has": {
                          "field": "object",
                          "matches": "module-value"
                        }
                      },
                      {
                        "has": {
                          "field": "index",
                          "any": [
                            {
                              "kind": "string"
                            },
                            {
                              "kind": "template_string",
                              "not": {
                                "has": {
                                  "kind": "template_substitution"
                                }
                              }
                            }
                          ],
                          "value": {
                            "regex": "^sep$"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "fn-value"
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "destructuredValue": false,
                    "value": {
                      "matches": "fn-value"
                    }
                  }
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "occurrence": {
                      "any": [
                        {
                          "kind": "shorthand_property_identifier_pattern",
                          "regex": "^sep$",
                          "inside": {
                            "kind": "object_pattern",
                            "any": [
                              {
                                "inside": {
                                  "kind": "variable_declarator",
                                  "field": "name",
                                  "has": {
                                    "field": "value",
                                    "matches": "module-value"
                                  }
                                }
                              },
                              {
                                "inside": {
                                  "kind": "assignment_expression",
                                  "field": "left",
                                  "has": {
                                    "field": "right",
                                    "matches": "module-value"
                                  }
                                }
                              },
                              {
                                "inside": {
                                  "kind": "assignment_pattern",
                                  "field": "left",
                                  "has": {
                                    "field": "right",
                                    "matches": "module-value"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        {
                          "kind": "identifier",
                          "inside": {
                            "kind": "pair_pattern",
                            "field": "value",
                            "has": {
                              "field": "key",
                              "any": [
                                {
                                  "kind": "property_identifier",
                                  "regex": "^sep$"
                                },
                                {
                                  "any": [
                                    {
                                      "kind": "string"
                                    },
                                    {
                                      "kind": "template_string",
                                      "not": {
                                        "has": {
                                          "kind": "template_substitution"
                                        }
                                      }
                                    }
                                  ],
                                  "value": {
                                    "regex": "^sep$"
                                  }
                                },
                                {
                                  "kind": "computed_property_name",
                                  "has": {
                                    "any": [
                                      {
                                        "kind": "string"
                                      },
                                      {
                                        "kind": "template_string",
                                        "not": {
                                          "has": {
                                            "kind": "template_substitution"
                                          }
                                        }
                                      }
                                    ],
                                    "value": {
                                      "regex": "^sep$"
                                    }
                                  }
                                }
                              ]
                            },
                            "inside": {
                              "kind": "object_pattern",
                              "any": [
                                {
                                  "inside": {
                                    "kind": "variable_declarator",
                                    "field": "name",
                                    "has": {
                                      "field": "value",
                                      "matches": "module-value"
                                    }
                                  }
                                },
                                {
                                  "inside": {
                                    "kind": "assignment_expression",
                                    "field": "left",
                                    "has": {
                                      "field": "right",
                                      "matches": "module-value"
                                    }
                                  }
                                },
                                {
                                  "inside": {
                                    "kind": "assignment_pattern",
                                    "field": "left",
                                    "has": {
                                      "field": "right",
                                      "matches": "module-value"
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        },
                        {
                          "kind": "identifier",
                          "inside": {
                            "kind": "object_assignment_pattern",
                            "has": {
                              "field": "left",
                              "kind": "shorthand_property_identifier_pattern",
                              "regex": "^sep$"
                            },
                            "inside": {
                              "kind": "object_pattern",
                              "any": [
                                {
                                  "inside": {
                                    "kind": "variable_declarator",
                                    "field": "name",
                                    "has": {
                                      "field": "value",
                                      "matches": "module-value"
                                    }
                                  }
                                },
                                {
                                  "inside": {
                                    "kind": "assignment_expression",
                                    "field": "left",
                                    "has": {
                                      "field": "right",
                                      "matches": "module-value"
                                    }
                                  }
                                },
                                {
                                  "inside": {
                                    "kind": "assignment_pattern",
                                    "field": "left",
                                    "has": {
                                      "field": "right",
                                      "matches": "module-value"
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "site": {
                      "kind": "import_specifier",
                      "has": {
                        "field": "name",
                        "regex": "^sep$"
                      },
                      "inside": {
                        "stopBy": "end",
                        "kind": "import_statement",
                        "has": {
                          "field": "source",
                          "matches": "esm-source"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "path-source": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^(?:__dirname|__filename)$",
                "resolves": {
                  "global": [
                    "__dirname",
                    "__filename"
                  ]
                }
              },
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "meta_property"
                    }
                  },
                  {
                    "has": {
                      "field": "property",
                      "kind": "property_identifier",
                      "regex": "^(?:dirname|filename|url)$"
                    }
                  }
                ]
              },
              {
                "kind": "subscript_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "kind": "meta_property"
                    }
                  },
                  {
                    "has": {
                      "field": "index",
                      "any": [
                        {
                          "kind": "string"
                        },
                        {
                          "kind": "template_string",
                          "not": {
                            "has": {
                              "kind": "template_substitution"
                            }
                          }
                        }
                      ],
                      "value": {
                        "regex": "^(?:dirname|filename|url)$"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "first-slash": {
            "any": [
              {
                "any": [
                  {
                    "kind": "string"
                  },
                  {
                    "kind": "template_string",
                    "not": {
                      "has": {
                        "kind": "template_substitution"
                      }
                    }
                  }
                ],
                "value": {
                  "startsWith": "/"
                }
              },
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "member_expression"
                  }
                ],
                "value": {
                  "startsWith": "/",
                  "follow": true
                }
              },
              {
                "matches": "fn-value"
              },
              {
                "kind": "assignment_expression",
                "has": {
                  "field": "right",
                  "matches": "first-slash"
                }
              },
              {
                "kind": "binary_expression",
                "has": {
                  "field": "left",
                  "matches": "first-slash"
                }
              },
              {
                "kind": "binary_expression",
                "all": [
                  {
                    "has": {
                      "field": "operator",
                      "regex": "^(?:\\|\\||&&|\\?\\?)$"
                    }
                  },
                  {
                    "has": {
                      "field": "right",
                      "matches": "first-slash"
                    }
                  }
                ]
              },
              {
                "kind": "ternary_expression",
                "any": [
                  {
                    "has": {
                      "field": "consequence",
                      "matches": "first-slash"
                    }
                  },
                  {
                    "has": {
                      "field": "alternative",
                      "matches": "first-slash"
                    }
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "first-slash"
                }
              },
              {
                "kind": "template_string",
                "has": {
                  "nthChild": 1,
                  "any": [
                    {
                      "any": [
                        {
                          "kind": "string_fragment",
                          "regex": "^/"
                        },
                        {
                          "kind": "escape_sequence",
                          "regex": "^\\\\/$"
                        }
                      ]
                    },
                    {
                      "kind": "template_substitution",
                      "has": {
                        "matches": "first-slash"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "binary",
      "forbid": {
        "ast": {
          "language": "typescript",
          "when": {
            "sourceType": [
              "script",
              "module"
            ]
          },
          "languageOptions": {
            "globals": {
              "process": "readonly"
            }
          },
          "rule": {
            "kind": "binary_expression",
            "all": [
              {
                "has": {
                  "field": "operator",
                  "regex": "^\\+$"
                }
              },
              {
                "has": {
                  "field": "left",
                  "matches": "path-source"
                }
              },
              {
                "has": {
                  "field": "right",
                  "matches": "first-slash"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/no-path-concat",
        "message": "Build this path with path.join() or path.resolve() instead of concatenating strings.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/no-path-concat"
            ]
          },
          "oxlint": {
            "rules": [
              "no-path-concat"
            ]
          }
        }
      }
    },
    {
      "id": "template",
      "forbid": {
        "ast": {
          "language": "typescript",
          "when": {
            "sourceType": [
              "script",
              "module"
            ]
          },
          "languageOptions": {
            "globals": {
              "process": "readonly"
            }
          },
          "rule": {
            "kind": "template_string",
            "has": {
              "kind": "template_substitution",
              "has": {
                "matches": "path-source"
              },
              "precedes": {
                "any": [
                  {
                    "any": [
                      {
                        "kind": "string_fragment",
                        "regex": "^/"
                      },
                      {
                        "kind": "escape_sequence",
                        "regex": "^\\\\/$"
                      }
                    ]
                  },
                  {
                    "kind": "template_substitution",
                    "has": {
                      "matches": "first-slash"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/no-path-concat",
        "message": "Build this path with path.join() or path.resolve() instead of a template string.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/no-path-concat"
            ]
          },
          "oxlint": {
            "rules": [
              "no-path-concat"
            ]
          }
        }
      }
    },
    {
      "id": "binary-commonjs",
      "forbid": {
        "ast": {
          "language": "typescript",
          "when": {
            "sourceType": "commonjs"
          },
          "languageOptions": {
            "globals": {
              "process": "readonly",
              "__dirname": "readonly",
              "__filename": "readonly"
            }
          },
          "rule": {
            "kind": "binary_expression",
            "all": [
              {
                "has": {
                  "field": "operator",
                  "regex": "^\\+$"
                }
              },
              {
                "has": {
                  "field": "left",
                  "matches": "path-source"
                }
              },
              {
                "has": {
                  "field": "right",
                  "matches": "first-slash"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/no-path-concat",
        "message": "Build this path with path.join() or path.resolve() instead of concatenating strings.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/no-path-concat"
            ]
          },
          "oxlint": {
            "rules": [
              "no-path-concat"
            ]
          }
        }
      }
    },
    {
      "id": "template-commonjs",
      "forbid": {
        "ast": {
          "language": "typescript",
          "when": {
            "sourceType": "commonjs"
          },
          "languageOptions": {
            "globals": {
              "process": "readonly",
              "__dirname": "readonly",
              "__filename": "readonly"
            }
          },
          "rule": {
            "kind": "template_string",
            "has": {
              "kind": "template_substitution",
              "has": {
                "matches": "path-source"
              },
              "precedes": {
                "any": [
                  {
                    "any": [
                      {
                        "kind": "string_fragment",
                        "regex": "^/"
                      },
                      {
                        "kind": "escape_sequence",
                        "regex": "^\\\\/$"
                      }
                    ]
                  },
                  {
                    "kind": "template_substitution",
                    "has": {
                      "matches": "first-slash"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/no-path-concat",
        "message": "Build this path with path.join() or path.resolve() instead of a template string.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/no-path-concat"
            ]
          },
          "oxlint": {
            "rules": [
              "no-path-concat"
            ]
          }
        }
      }
    }
  ]
}
