{
  "format": "rerail.policy/v1",
  "id": "n-no-sync",
  "revision": 2,
  "mode": "steer",
  "description": "eslint-plugin-n 18.4.1 n/no-sync (default options): upstream's selectors `CallExpression > MemberExpression.callee Identifier[name=/Sync$/]` and `CallExpression > Identifier[name=/Sync$/]`, reported at the identifier's ESTree parent: a call with a /Sync$/ identifier as callee or argument, or a node inside (or being) a call's member callee with a /Sync$/ identifier child (tree-sitter's arguments node is no ESTree parent: its identifiers belong to the call).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "call-child",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "call_expression",
            "not": {
              "has": {
                "field": "arguments",
                "kind": "template_string"
              }
            },
            "any": [
              {
                "has": {
                  "field": "function",
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "property_identifier"
                    }
                  ],
                  "regex": "Sync$"
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "kind": "arguments",
                  "has": {
                    "any": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "kind": "property_identifier"
                      }
                    ],
                    "regex": "Sync$"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/no-sync",
        "message": "Unexpected sync method.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/no-sync"
            ]
          },
          "oxlint": {
            "rules": [
              "no-sync"
            ]
          }
        }
      }
    },
    {
      "id": "callee-member-descendant",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "has": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "property_identifier"
                }
              ],
              "regex": "Sync$"
            },
            "any": [
              {
                "kind": "member_expression",
                "inside": {
                  "kind": "call_expression",
                  "field": "function",
                  "not": {
                    "has": {
                      "field": "arguments",
                      "kind": "template_string"
                    }
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "member_expression",
                  "inside": {
                    "kind": "call_expression",
                    "field": "function",
                    "not": {
                      "has": {
                        "field": "arguments",
                        "kind": "template_string"
                      }
                    }
                  }
                }
              }
            ],
            "not": {
              "any": [
                {
                  "kind": "arguments"
                },
                {
                  "kind": "call_expression",
                  "not": {
                    "has": {
                      "field": "arguments",
                      "kind": "template_string"
                    }
                  },
                  "any": [
                    {
                      "has": {
                        "field": "function",
                        "any": [
                          {
                            "kind": "identifier"
                          },
                          {
                            "kind": "property_identifier"
                          }
                        ],
                        "regex": "Sync$"
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "kind": "arguments",
                        "has": {
                          "any": [
                            {
                              "kind": "identifier"
                            },
                            {
                              "kind": "property_identifier"
                            }
                          ],
                          "regex": "Sync$"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/no-sync",
        "message": "Unexpected sync method.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/no-sync"
            ]
          },
          "oxlint": {
            "rules": [
              "no-sync"
            ]
          }
        }
      }
    }
  ]
}
