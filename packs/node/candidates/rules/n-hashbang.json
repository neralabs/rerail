{
  "format": "rerail.policy/v1",
  "id": "n-hashbang",
  "revision": 1,
  "mode": "steer",
  "description": "Candidate for eslint-plugin-n 18.4.1 n/hashbang (default options): whether a file needs a shebang is read from the nearest package.json's `bin` (a path, or an object of paths, relative to the manifest's folder, `.js` and `/index` optional); without a package.json nothing is checked, as upstream. A file `bin` does not name reports a shebang (`#!` and at least one character opening the text, ended by a line break): \"This file needs no shebang.\". A file it names reports a first line that is no node shebang (`#!/usr/bin/env`, env flags and variables as upstream's isNodeShebang strips them, then `node`): 'This file needs shebang \"#!/usr/bin/env node\".'. Not ported: the convertPath option and settings, ignoreUnpublished (.npmignore), additionalExecutables and executableMap (the expected executable is always node), and the BOM and CRLF reports on a bin file whose shebang is right (\"This file must not have Unicode BOM.\", \"This file must have Unix linebreaks (LF).\").",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "needs-no-shebang",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "bin": false
            }
          },
          "rule": {
            "kind": "hash_bang_line",
            "inside": {
              "kind": "program",
              "regex": "\\A#![^\\r\\n\\x{2028}\\x{2029}]+\\r?\\n"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "n/hashbang",
        "message": "This file needs no shebang.",
        "suppress": {
          "eslint": {
            "rules": [
              "n/hashbang"
            ]
          }
        }
      }
    },
    {
      "id": "needs-shebang",
      "forbid": {
        "ast": {
          "language": "typescript",
          "file": {
            "package": {
              "bin": true
            }
          },
          "rule": {
            "kind": "program",
            "not": {
              "regex": "\\A#!/usr/bin/env(?:[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*(?:[A-Za-z0-9_]+=\"(?:[^\"\\\\\\r\\n\\x{2028}\\x{2029}]|\\\\[^\\r\\n\\x{2028}\\x{2029}])*\"|(?:[A-Za-z0-9_]+=[A-Za-z0-9_]+)?(?:--(?:[^A-Za-z0-9_\\r\\n\\x{2028}\\x{2029}]|[A-Za-z0-9_]+[^A-Za-z0-9_\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\r\\n\\x{2028}\\x{2029}])*[A-Za-z0-9_]+|-[ivS]+|-[Pu](?:[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]+|=)[^\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\r\\n\\x{2028}\\x{2029}]+)[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]|[A-Za-z0-9_]+=[A-Za-z0-9_]+[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]))*[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*node(?: [^\\r\\n\\x{2028}\\x{2029}]*|[\\t\\x0B\\x0C \\x{A0}\\x{1680}\\x{2000}-\\x{200A}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]*)\\r?\\n"
            }
          }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "n/hashbang",
        "message": "This file needs shebang \"#!/usr/bin/env node\".",
        "suppress": {
          "eslint": {
            "rules": [
              "n/hashbang"
            ]
          }
        }
      }
    }
  ]
}
