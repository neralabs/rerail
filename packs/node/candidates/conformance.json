{
  "pack": "node-candidates",
  "family": "ecma",
  "capabilities": [
    "syntax",
    "scope",
    "value",
    "suppression"
  ],
  "tools": [
    {
      "name": "eslint-plugin-n",
      "version": "18.4.1"
    }
  ],
  "oracles": "../upstream",
  "rules": [
    {
      "id": "n-no-deprecated-api",
      "upstream": {
        "tool": "eslint-plugin-n",
        "rule": "n/no-deprecated-api"
      },
      "policy": "rules/n-no-deprecated-api.json",
      "capabilities": [
        "syntax",
        "scope",
        "value",
        "suppression"
      ],
      "match": "line+column"
    },
    {
      "id": "n-hashbang",
      "upstream": {
        "tool": "eslint-plugin-n",
        "rule": "n/hashbang"
      },
      "policy": "rules/n-hashbang.json",
      "capabilities": [
        "syntax",
        "suppression"
      ],
      "match": "line+column"
    }
  ]
}
