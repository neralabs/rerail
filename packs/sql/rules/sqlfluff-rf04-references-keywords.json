{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-rf04-references-keywords",
  "revision": 1,
  "mode": "steer",
  "description": "Port of SQLFluff 4.4.0 RF04 (references.keywords) with its defaults (unquoted_identifiers_policy = aliases, quoted_identifiers_policy = none): report a naked identifier of more than one character that names a table or column alias or a CREATE TABLE column definition and is a keyword. SQLFluff reads the file's dialect's unreserved keywords; the engine has no dialect setting, so the regex holds SQLFluff's ANSI unreserved keywords that its postgres and mysql dialects also list as unreserved or reserved (a reserved word cannot be a naked alias there). ALTER TABLE ... ADD COLUMN names are skipped, as SQLFluff's postgres dialect reads them as column references.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "keyword-identifier",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "identifier",
            "regex": "(?i)^(?:ABORT|ABSOLUTE|ACCESS|ACCOUNT|ACCOUNTS|ACTION|ADD|ADMIN|AFTER|AGGREGATE|ALIAS|ALL|ALSO|ALTER|ALWAYS|ANALYSE|ANALYZE|AND|ANY|APPLY|ARRAY|AS|ASC|ASSERTION|ASSIGNMENT|ASYMMETRIC|AT|ATOMIC|ATTRIBUTE|AUDIT|AUTHORIZATION|AUTO_INCREMENT|AVG_ROW_LENGTH|BACKUP|BACKWARD|BEFORE|BEGIN|BERNOULLI|BETWEEN|BIGINT|BINARY|BINDING|BIT|BITVAR|BOOL|BOOLEAN|BOTH|BREADTH|BREAK|BROWSE|BULK|BY|CACHE|CALL|CALLED|CASCADE|CASCADED|CAST|CATALOG|CHAIN|CHANGE|CHAR|CHARACTER|CHARACTERISTICS|CHECK|CHECKED|CHECKPOINT|CHECKSUM|CLASS|CLOSE|CLUSTER|CLUSTERED|COALESCE|COLLATE|COLLATION|COLUMN|COLUMNS|COMMENT|COMMIT|COMMITTED|COMPLETION|COMPRESS|COMPUTE|CONNECT|CONNECTION|CONSTRAINT|CONSTRAINTS|CONTAINSTABLE|CONTINUE|CONVERSION|COPY|CREATE|CREATEDB|CREATEROLE|CREATEUSER|CSV|CUBE|CURRENT|CURRENT_DATE|CURRENT_ROLE|CURRENT_TIME|CURRENT_TIMESTAMP|CURRENT_USER|CURSOR|CYCLE|DATA|DATABASE|DATABASES|DATE|DATETIME|DAY|DAYOFMONTH|DAYOFWEEK|DAYOFYEAR|DAYS|DAY_HOUR|DAY_MICROSECOND|DAY_MINUTE|DAY_SECOND|DBCC|DEALLOCATE|DEC|DECIMAL|DECLARE|DEFAULT|DEFAULTS|DEFERRABLE|DEFERRED|DEFINER|DELAYED|DELAY_KEY_WRITE|DELETE|DELIMITER|DELIMITERS|DENY|DEPTH|DESC|DESCRIBE|DESTROY|DESTRUCTOR|DETERMINISTIC|DICTIONARY|DISABLE|DISK|DISTINCT|DISTINCTROW|DISTRIBUTED|DIV|DO|DOMAIN|DOUBLE|DROP|DUMMY|DUMP|EACH|ELSE|ELSEIF|ENABLE|ENCLOSED|ENCODING|ENCRYPTED|END|ENUM|ERRLVL|ESCAPE|ESCAPED|EXCEPT|EXCLUDE|EXCLUDING|EXCLUSIVE|EXECUTE|EXISTING|EXISTS|EXIT|EXPLAIN|EXTENSION|EXTERNAL|EXTRACT|FALSE|FETCH|FIELDS|FILE|FILLFACTOR|FILTER|FIRST|FLOAT|FLOAT4|FLOAT8|FLUSH|FOLLOWING|FOR|FORCE|FOREIGN|FORMAT|FORWARD|FREETEXT|FREETEXTTABLE|FREEZE|FROM|FULLTEXT|FUNCTION|FUNCTIONS|FUTURE|GENERATED|GLOBAL|GRANT|GRANTED|GRANTS|GREATEST|GROUP|GROUPING|HANDLER|HAVING|HEADER|HEAP|HIGH_PRIORITY|HOLD|HOLDLOCK|HOST|HOSTS|HOUR|HOUR_MICROSECOND|HOUR_MINUTE|HOUR_SECOND|IDENTIFIED|IDENTITY|IDENTITYCOL|IDENTITY_INSERT|IF|ILIKE|IMMEDIATE|IMMUTABLE|IMPLICIT|IMPORTED|IN|INCLUDE|INCLUDING|INCREMENT|INDEX|INFILE|INFIX|INHERIT|INHERITS|INITIALIZE|INITIALLY|INOUT|INPUT|INSENSITIVE|INSERT|INSERT_ID|INSTEAD|INT|INT1|INT2|INT3|INT4|INT8|INTEGER|INTEGRATION|INTEGRATIONS|INTERSECT|INTO|INVOKER|IS|ISAM|ISNULL|ISOLATION|ITERATE|JSON|KEY|KEYS|KILL|LANCOMPILER|LANGUAGE|LARGE|LAST|LAST_INSERT_ID|LATERAL|LEADING|LEAST|LEAVE|LESS|LEVEL|LIKE|LIMIT|LINENO|LINES|LISTEN|LOAD|LOCAL|LOCALTIME|LOCALTIMESTAMP|LOCATION|LOCK|LOCKS|LOGIN|LOGS|LONG|LONGBLOB|LONGTEXT|LOOP|LOW_PRIORITY|MANAGE|MASKING|MATCH|MATCHED|MATERIALIZED|MAXEXTENTS|MAXVALUE|MAX_ROWS|MEDIUMBLOB|MEDIUMINT|MEDIUMTEXT|MERGE|METHOD|MIDDLEINT|MILLISECOND|MINUS|MINUTE|MINUTE_MICROSECOND|MINUTE_SECOND|MINVALUE|MIN_ROWS|ML|MLSLABEL|MODE|MODEL|MODIFY|MONITOR|MONTH|MONTHNAME|MOVE|MYISAM|NAME|NAMES|NAN|NATIONAL|NCHAR|NEW|NEXT|NO|NOAUDIT|NOCACHE|NOCHECK|NOCOMPRESS|NOCREATEDB|NOCREATEROLE|NOCREATEUSER|NOCYCLE|NOINHERIT|NOLOGIN|NONCLUSTERED|NONE|NOORDER|NORMALIZE|NORMALIZED|NOSUPERUSER|NOTHING|NOTIFY|NOTNULL|NOWAIT|NO_WRITE_TO_BINLOG|NULLIF|NULLS|NUMERIC|OBJECT|OBJECTS|OF|OFF|OFFLINE|OFFSET|OFFSETS|OIDS|OLD|ONLINE|ONLY|OPENDATASOURCE|OPENQUERY|OPENROWSET|OPENXML|OPERATE|OPERATION|OPERATOR|OPTIMIZE|OPTION|OPTIONALLY|OPTIONS|OR|ORDINALITY|OTHERS|OUT|OUTFILE|OVER|OVERLAPS|OVERLAY|OVERRIDING|OVERWRITE|OWNER|OWNERSHIP|PACK_KEYS|PARAMETERS|PARTIAL|PASSWORD|PATH|PCTFREE|PIPE|PLACING|POLICY|POSITION|POSTFIX|PRECEDING|PRECISION|PREFIX|PREORDER|PREPARE|PREPARED|PRESERVE|PRIMARY|PRINT|PRIOR|PRIVILEGES|PROC|PROCEDURAL|PROCEDURE|PROCEDURES|PROCESS|PROCESSLIST|PUBLIC|PURGE|QUALIFY|QUARTER|QUOTE|RAID0|RAISERROR|RANGE|RAW|READ|READTEXT|REAL|RECHECK|RECONFIGURE|RECURSIVE|REF|REFERENCES|REFERENCE_USAGE|REFERENCING|REGEXP|REINDEX|RELATIVE|RELEASE|RELOAD|RENAME|REPEAT|REPEATABLE|REPLACE|REPLICATION|REQUIRE|RESET|RESIGNAL|RESOURCE|RESTART|RESTRICT|RETURN|RETURNS|REVOKE|RLIKE|ROLE|ROLES|ROLLBACK|ROLLUP|ROUTINE|ROUTINES|ROW|ROWCOUNT|ROWGUIDCOL|ROWID|ROWNUM|RULE|SAVE|SAVEPOINT|SCHEMA|SCHEMAS|SCROLL|SEARCH|SECOND|SECOND_MICROSECOND|SECURITY|SEPARATOR|SEQUENCE|SEQUENCES|SERIALIZABLE|SERVER|SESSION|SESSION_USER|SETOF|SETS|SETUSER|SHARE|SHARES|SHOW|SHUTDOWN|SIGNAL|SIMILAR|SIMPLE|SMALLINT|SOME|SONAME|SOURCE|SPATIAL|SQL|SQLCA|SQL_BIG_RESULT|SQL_BIG_SELECTS|SQL_BIG_TABLES|SQL_CALC_FOUND_ROWS|SQL_LOG_OFF|SQL_LOG_UPDATE|SQL_LOW_PRIORITY_UPDATES|SQL_SELECT_LIMIT|SQL_SMALL_RESULT|SQL_WARNINGS|SSL|STABLE|STAGE|STAGES|START|STARTING|STARTS|STATEMENT|STATISTICS|STDIN|STDOUT|STORAGE|STRAIGHT_JOIN|STREAM|STREAMS|STRICT|SUBLIST|SUBSTRING|SUCCESSFUL|SUPERUSER|SYMMETRIC|SYNONYM|SYSDATE|SYSID|SYSTEM|TABLE|TABLES|TABLESAMPLE|TABLESPACE|TASK|TASKS|TEMP|TEMPLATE|TEMPORARY|TERMINATE|TERMINATED|TEXT|TEXTSIZE|THAN|THEN|TIES|TIME|TIMESTAMP|TINYBLOB|TINYINT|TINYTEXT|TO|TOAST|TOP|TRAILING|TRAN|TRANSACTION|TRANSACTIONS|TRANSFORM|TRANSIENT|TREAT|TRIGGER|TRIM|TRUE|TRUNCATE|TRUSTED|TSEQUAL|TYPE|UESCAPE|UID|UNBOUNDED|UNCOMMITTED|UNDO|UNENCRYPTED|UNIQUE|UNKNOWN|UNLISTEN|UNLOCK|UNSIGNED|UNTIL|UPDATE|UPDATETEXT|USAGE|USE|USER|USERS|USE_ANY_ROLE|UTC_DATE|UTC_TIME|UTC_TIMESTAMP|VACUUM|VALID|VALIDATE|VALIDATOR|VALUE|VALUES|VARCHAR|VARCHAR2|VARCHARACTER|VARIABLE|VARIABLES|VARYING|VERBOSE|VERSION|VIEW|VIEWS|VOLATILE|WAITFOR|WAREHOUSE|WAREHOUSES|WEEK|WEEKDAY|WHEN|WHERE|WHILE|WINDOW|WITH|WITHIN|WITHOUT|WORK|WRAPPER|WRITE|WRITETEXT|X509|XML|XOR|YAML|YEAR|YEAR_MONTH|ZEROFILL|ZONE)$",
            "any": [
              {
                "inside": {
                  "field": "alias",
                  "any": [
                    {
                      "kind": "term"
                    },
                    {
                      "kind": "relation"
                    },
                    {
                      "kind": "from"
                    },
                    {
                      "kind": "statement"
                    },
                    {
                      "kind": "insert"
                    },
                    {
                      "kind": "cross_join"
                    },
                    {
                      "kind": "lateral_cross_join"
                    },
                    {
                      "kind": "lateral_join"
                    }
                  ]
                }
              },
              {
                "inside": {
                  "field": "name",
                  "kind": "column_definition",
                  "not": {
                    "inside": {
                      "kind": "add_column",
                      "stopBy": "neighbor"
                    }
                  }
                }
              }
            ],
            "not": {
              "any": [
                {
                  "precedes": {
                    "kind": "ERROR"
                  }
                },
                {
                  "inside": {
                    "kind": "ERROR",
                    "stopBy": "end"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RF04",
        "message": "Keywords should not be used as identifiers.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "RF04",
              "L029",
              "all",
              "references",
              "references.keywords"
            ]
          }
        }
      }
    }
  ]
}
