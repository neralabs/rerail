{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-rf04-references-keywords",
  "revision": 2,
  "mode": "steer",
  "description": "Don't use SQL keywords as unquoted table aliases, column aliases or column names; rename them so they can't be misread.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "keyword-identifier",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "identifier",
            "regex": "(?i)^(?:ABORT|ABSOLUTE|ACCESS|ACCOUNT|ACCOUNTS|ACTION|ADD|ADMIN|AFTER|AGGREGATE|ALIAS|ALL|ALLOW_CONNECTIONS|ALSO|ALTER|ALWAYS|ANALYSE|ANALYZE|AND|ANY|APPLY|ARRAY|AS|ASC|ASSERTION|ASSIGNMENT|ASYMMETRIC|AT|ATOMIC|ATTACH|ATTRIBUTE|AUDIT|AUTHORIZATION|AUTO_INCREMENT|AVG_ROW_LENGTH|BACKUP|BACKWARD|BEFORE|BEGIN|BERNOULLI|BETWEEN|BIGINT|BIGSERIAL|BINARY|BINDING|BIT|BITVAR|BOOL|BOOLEAN|BOTH|BOX|BPCHAR|BREADTH|BREAK|BROWSE|BUFFERS|BULK|BY|BYPASSRLS|BYTEA|CACHE|CALL|CALLED|CASCADE|CASCADED|CAST|CATALOG|CHAIN|CHANGE|CHAR|CHARACTER|CHARACTERISTICS|CHECK|CHECKED|CHECKPOINT|CHECKSUM|CIDR|CIRCLE|CIRCULARSTRING|CLASS|CLOSE|CLUSTER|CLUSTERED|COALESCE|COLLATE|COLLATION|COLUMN|COLUMNS|COMMENT|COMMENTS|COMMIT|COMMITTED|COMPLETION|COMPOUNDCURVE|COMPRESS|COMPRESSION|COMPUTE|CONFIGURATION|CONFLICT|CONNECT|CONNECTION|CONSTRAINT|CONSTRAINTS|CONTAINSTABLE|CONTENT|CONTINUE|CONVERSION|COPY|CORRELATION|COST|COSTS|CREATE|CREATEDB|CREATEROLE|CREATEUSER|CSV|CUBE|CURRENT|CURRENT_DATE|CURRENT_ROLE|CURRENT_TIME|CURRENT_TIMESTAMP|CURRENT_USER|CURSOR|CURVEPOLYGON|CYCLE|DATA|DATABASE|DATABASES|DATE|DATERANGE|DATETIME|DAY|DAYOFMONTH|DAYOFWEEK|DAYOFYEAR|DAYS|DAY_HOUR|DAY_MICROSECOND|DAY_MINUTE|DAY_SECOND|DBCC|DEALLOCATE|DEC|DECIMAL|DECLARE|DEFAULT|DEFAULTS|DEFERRABLE|DEFERRED|DEFINER|DELAYED|DELAY_KEY_WRITE|DELETE|DELIMITER|DELIMITERS|DENY|DEPENDENCIES|DEPENDS|DEPTH|DESC|DESCRIBE|DESTROY|DESTRUCTOR|DETACH|DETERMINISTIC|DICTIONARY|DISABLE|DISABLE_PAGE_SKIPPING|DISCARD|DISK|DISTINCT|DISTINCTROW|DISTRIBUTED|DIV|DO|DOCUMENT|DOMAIN|DOUBLE|DROP|DUMMY|DUMP|EACH|ELSE|ELSEIF|EMPTY|ENABLE|ENCLOSED|ENCODING|ENCRYPTED|END|ENUM|ERRLVL|ESCAPE|ESCAPED|EVENT|EXCEPT|EXCLUDE|EXCLUDING|EXCLUSIVE|EXECUTE|EXISTING|EXISTS|EXIT|EXPLAIN|EXPRESSION|EXTENDED|EXTENSION|EXTERNAL|EXTRACT|FALSE|FAMILY|FETCH|FIELDS|FILE|FILLFACTOR|FILTER|FINALIZE|FIRST|FLOAT|FLOAT4|FLOAT8|FLUSH|FOLLOWING|FOR|FORCE|FORCE_NOT_NULL|FORCE_NULL|FORCE_QUOTE|FOREIGN|FORMAT|FORWARD|FREETEXT|FREETEXTTABLE|FREEZE|FROM|FULLTEXT|FUNCTION|FUNCTIONS|FUTURE|GENERATED|GEOGRAPHY|GEOMETRY|GEOMETRYCOLLECTION|GEOMETRYCOLLECTIONM|GEOMETRYCOLLECTIONZ|GEOMETRYCOLLECTIONZM|GLOBAL|GRANT|GRANTED|GRANTS|GREATEST|GROUP|GROUPING|GROUPS|HANDLER|HASH|HAVING|HEADER|HEAP|HIGH_PRIORITY|HOLD|HOLDLOCK|HOST|HOSTS|HOUR|HOUR_MICROSECOND|HOUR_MINUTE|HOUR_SECOND|ICU|IDENTIFIED|IDENTITY|IDENTITYCOL|IDENTITY_INSERT|IF|IGNORE|ILIKE|IMMEDIATE|IMMUTABLE|IMPLICIT|IMPORT|IMPORTED|IN|INCLUDE|INCLUDING|INCREMENT|INDEX|INDEXES|INDEX_CLEANUP|INET|INFILE|INFIX|INHERIT|INHERITS|INITIALIZE|INITIALLY|INLINE|INOUT|INPUT|INSENSITIVE|INSERT|INSERT_ID|INSTEAD|INT|INT1|INT2|INT3|INT4|INT4RANGE|INT8|INT8RANGE|INTEGER|INTEGRATION|INTEGRATIONS|INTERSECT|INTERVAL|INTO|INVOKER|IS|ISAM|ISNULL|ISOLATION|IS_SUPERUSER|IS_TEMPLATE|ITERATE|JSON|JSONB|KEY|KEYS|KILL|LABEL|LANCOMPILER|LANGUAGE|LARGE|LAST|LAST_INSERT_ID|LATERAL|LC_COLLATE|LC_CTYPE|LEADING|LEAKPROOF|LEAST|LEAVE|LEFTARG|LESS|LEVEL|LIBC|LIKE|LIMIT|LINE|LINENO|LINES|LINESTRING|LINESTRINGM|LINESTRINGZ|LINESTRINGZM|LIST|LISTEN|LOAD|LOCAL|LOCALE|LOCALTIME|LOCALTIMESTAMP|LOCATION|LOCK|LOCKED|LOCKS|LOGGED|LOGIN|LOGS|LOG_VERBOSITY|LONG|LONGBLOB|LONGTEXT|LOOP|LOW_PRIORITY|LSEG|MACADDR|MACADDR8|MAIN|MANAGE|MAPPING|MASKING|MATCH|MATCHED|MATERIALIZED|MAXEXTENTS|MAXVALUE|MAX_ROWS|MCV|MEDIUMBLOB|MEDIUMINT|MEDIUMTEXT|MERGE|METHOD|MIDDLEINT|MILLISECOND|MINUS|MINUTE|MINUTE_MICROSECOND|MINUTE_SECOND|MINVALUE|MIN_ROWS|ML|MLSLABEL|MODE|MODEL|MODIFY|MODULUS|MONEY|MONITOR|MONTH|MONTHNAME|MOVE|MULTICURVE|MULTILINESTRING|MULTILINESTRINGM|MULTILINESTRINGZ|MULTILINESTRINGZM|MULTIPOINT|MULTIPOINTM|MULTIPOINTZ|MULTIPOINTZM|MULTIPOLYGON|MULTIPOLYGONM|MULTIPOLYGONZ|MULTIPOLYGONZM|MULTISURFACE|MYISAM|NAME|NAMES|NAN|NATIONAL|NCHAR|NDISTINCT|NEW|NEXT|NFC|NFD|NFKC|NFKD|NO|NOAUDIT|NOBYPASSRLS|NOCACHE|NOCHECK|NOCOMPRESS|NOCREATEDB|NOCREATEROLE|NOCREATEUSER|NOCYCLE|NOINHERIT|NOLOGIN|NONCLUSTERED|NONE|NOORDER|NOREPLICATION|NORMALIZE|NORMALIZED|NOSUPERUSER|NOTHING|NOTIFY|NOTNULL|NOWAIT|NO_WRITE_TO_BINLOG|NULLIF|NULLS|NUMERIC|NUMRANGE|OBJECT|OBJECTS|OF|OFF|OFFLINE|OFFSET|OFFSETS|OIDS|OLD|ONLINE|ONLY|ON_ERROR|OPENDATASOURCE|OPENQUERY|OPENROWSET|OPENXML|OPERATE|OPERATION|OPERATOR|OPTIMIZE|OPTION|OPTIONALLY|OPTIONS|OR|ORDINALITY|OTHERS|OUT|OUTFILE|OVER|OVERLAPS|OVERLAY|OVERRIDING|OVERWRITE|OWNED|OWNER|OWNERSHIP|PACK_KEYS|PARALLEL|PARAMETERS|PARSER|PARTIAL|PARTITION|PASSING|PASSWORD|PATH|PCTFREE|PERMISSIVE|PG_LSN|PIPE|PLACING|PLAIN|PLANS|POINT|POINTM|POINTZ|POINTZM|POLICY|POLYGON|POLYGONM|POLYGONZ|POLYGONZM|POLYHEDRALSURFACE|POSITION|POSTFIX|PRECEDING|PRECISION|PREFIX|PREORDER|PREPARE|PREPARED|PRESERVE|PRIMARY|PRINT|PRIOR|PRIVILEGES|PROC|PROCEDURAL|PROCEDURE|PROCEDURES|PROCESS|PROCESSLIST|PROCESS_TOAST|PROGRAM|PROVIDER|PUBLIC|PUBLICATION|PURGE|QUALIFY|QUARTER|QUOTE|RAID0|RAISERROR|RANGE|RAW|READ|READTEXT|REAL|REASSIGN|RECHECK|RECONFIGURE|RECURSIVE|REF|REFERENCES|REFERENCE_USAGE|REFERENCING|REFRESH|REGEXP|REINDEX|REJECT_LIMIT|RELATIVE|RELEASE|RELOAD|REMAINDER|RENAME|REPEAT|REPEATABLE|REPLACE|REPLICA|REPLICATION|REQUIRE|RESET|RESIGNAL|RESOURCE|RESPECT|RESTART|RESTRICT|RESTRICTED|RESTRICTIVE|RETRIEVE|RETURN|RETURNS|REVOKE|RLIKE|ROLE|ROLES|ROLLBACK|ROLLUP|ROUTINE|ROUTINES|ROW|ROWCOUNT|ROWGUIDCOL|ROWID|ROWNUM|ROWS|RULE|SAFE|SAVE|SAVEPOINT|SCALAR|SCHEMA|SCHEMAS|SCROLL|SEARCH|SECOND|SECOND_MICROSECOND|SECURITY|SEPARATOR|SEQUENCE|SEQUENCES|SERIAL|SERIAL2|SERIAL4|SERIAL8|SERIALIZABLE|SERVER|SERVER_ENCODING|SERVER_VERSION|SESSION|SESSION_USER|SET|SETOF|SETS|SETTINGS|SETUSER|SHARE|SHARES|SHOW|SHUTDOWN|SIGNAL|SILENT|SIMILAR|SIMPLE|SKIP|SKIP_LOCKED|SMALLINT|SMALLSERIAL|SNAPSHOT|SOME|SONAME|SOURCE|SPATIAL|SQL|SQLCA|SQL_BIG_RESULT|SQL_BIG_SELECTS|SQL_BIG_TABLES|SQL_CALC_FOUND_ROWS|SQL_LOG_OFF|SQL_LOG_UPDATE|SQL_LOW_PRIORITY_UPDATES|SQL_SELECT_LIMIT|SQL_SMALL_RESULT|SQL_WARNINGS|SSL|STABLE|STAGE|STAGES|STANDALONE|START|STARTING|STARTS|STATEMENT|STATISTICS|STDIN|STDOUT|STOP|STORAGE|STORED|STRAIGHT_JOIN|STREAM|STREAMS|STRICT|STRIP|SUBLIST|SUBSCRIPTION|SUBSTRING|SUCCESSFUL|SUMMARY|SUPERUSER|SUPPORT|SYMMETRIC|SYNONYM|SYSDATE|SYSID|SYSTEM|TABLE|TABLES|TABLESAMPLE|TABLESPACE|TARGET|TASK|TASKS|TEMP|TEMPLATE|TEMPORARY|TERMINATE|TERMINATED|TEXT|TEXTSIZE|THAN|THEN|TIES|TIME|TIMESTAMP|TIMESTAMPTZ|TIMETZ|TIMING|TIN|TINYBLOB|TINYINT|TINYTEXT|TO|TOAST|TOP|TRAILING|TRAN|TRANSACTION|TRANSACTIONS|TRANSFORM|TRANSIENT|TREAT|TRIANGLE|TRIGGER|TRIM|TRUE|TRUNCATE|TRUSTED|TSEQUAL|TSQUERY|TSRANGE|TSTZRANGE|TSVECTOR|TYPE|TYPES|UESCAPE|UID|UNBOUNDED|UNCOMMITTED|UNDO|UNENCRYPTED|UNIQUE|UNKNOWN|UNLISTEN|UNLOCK|UNLOGGED|UNSAFE|UNSIGNED|UNTIL|UPDATE|UPDATETEXT|USAGE|USE|USER|USERS|USE_ANY_ROLE|UTC_DATE|UTC_TIME|UTC_TIMESTAMP|UUID|VACUUM|VALID|VALIDATE|VALIDATOR|VALUE|VALUES|VARCHAR|VARCHAR2|VARCHARACTER|VARIABLE|VARIABLES|VARYING|VECTOR|VERBOSE|VERSION|VIEW|VIEWS|VIRTUAL|VOLATILE|WAITFOR|WAL|WAREHOUSE|WAREHOUSES|WEEK|WEEKDAY|WHEN|WHERE|WHILE|WHITESPACE|WINDOW|WITH|WITHIN|WITHOUT|WORK|WRAPPER|WRITE|WRITETEXT|X509|XML|XMLATTRIBUTES|XMLCONCAT|XMLELEMENT|XMLEXISTS|XMLFOREST|XMLNAMESPACES|XMLPARSE|XMLPI|XMLROOT|XMLSERIALIZE|XMLTABLE|XOR|YAML|YEAR|YEAR_MONTH|YES|ZEROFILL|ZONE)$",
            "any": [
              {
                "inside": {
                  "field": "alias",
                  "any": [
                    {
                      "kind": "term"
                    },
                    {
                      "kind": "relation"
                    },
                    {
                      "kind": "from"
                    },
                    {
                      "kind": "statement"
                    },
                    {
                      "kind": "insert"
                    },
                    {
                      "kind": "cross_join"
                    },
                    {
                      "kind": "lateral_cross_join"
                    },
                    {
                      "kind": "lateral_join"
                    }
                  ]
                }
              },
              {
                "inside": {
                  "field": "name",
                  "kind": "column_definition",
                  "any": [
                    {
                      "has": {
                        "field": "type",
                        "regex": "(?s)."
                      }
                    },
                    {
                      "has": {
                        "field": "custom_type",
                        "regex": "(?s)."
                      }
                    }
                  ],
                  "inside": {
                    "kind": "column_definitions",
                    "stopBy": "neighbor",
                    "inside": {
                      "kind": "create_table",
                      "stopBy": "neighbor"
                    }
                  }
                }
              }
            ],
            "not": {
              "any": [
                {
                  "precedes": {
                    "kind": "ERROR"
                  }
                },
                {
                  "inside": {
                    "kind": "ERROR",
                    "stopBy": "end"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RF04",
        "message": "Keywords should not be used as identifiers.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "RF04",
              "L029",
              "all",
              "references",
              "references.keywords"
            ]
          }
        }
      }
    }
  ]
}
