{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-st10-structure-constant-expression",
  "revision": 1,
  "mode": "steer",
  "description": "Remove SQL comparisons that are always true or false, such as an expression compared to itself or two literals; 1 = 1 and 1 = 0 are allowed.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "identical-nonliteral-operands",
      "forbid": {
        "ast": {
          "language": "sql",
          "utils": {
            "constant": {
              "any": [
                {
                  "kind": "literal",
                  "not": {
                    "has": {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "timestamp"
                        },
                        {
                          "kind": "time"
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "parameter",
                  "regex": "^\\$[0-9]+$"
                }
              ]
            },
            "typed-string": {
              "kind": "literal",
              "has": {
                "kind": "identifier",
                "not": {
                  "regex": "(?i)^(?:date|timetz|timestamptz)$"
                }
              }
            },
            "adjacent": {
              "not": {
                "any": [
                  {
                    "kind": "binary_expression"
                  },
                  {
                    "kind": "collate_expression"
                  }
                ]
              }
            }
          },
          "rule": {
            "kind": "binary_expression",
            "all": [
              {
                "has": {
                  "field": "operator",
                  "regex": "^(?:=|!=|<>)$",
                  "pattern": "$$OP"
                }
              },
              {
                "has": {
                  "field": "left",
                  "pattern": "$L",
                  "all": [
                    {
                      "matches": "adjacent"
                    },
                    {
                      "not": {
                        "any": [
                          {
                            "matches": "constant"
                          },
                          {
                            "matches": "typed-string"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "right",
                  "any": [
                    {
                      "all": [
                        {
                          "matches": "adjacent"
                        },
                        {
                          "pattern": "$R",
                          "not": {
                            "any": [
                              {
                                "matches": "constant"
                              },
                              {
                                "matches": "typed-string"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "kind": "collate_expression",
                      "has": {
                        "field": "expression",
                        "all": [
                          {
                            "matches": "adjacent"
                          },
                          {
                            "pattern": "$R",
                            "not": {
                              "any": [
                                {
                                  "matches": "constant"
                                },
                                {
                                  "matches": "typed-string"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "compare": {
                  "left": "L",
                  "op": "eq",
                  "right": "R",
                  "text": "source"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.OP",
        "code": "ST10",
        "message": "Remove or correct this comparison of $L with itself; it is always true or always false.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "ST10",
              "all",
              "structure",
              "structure.constant_expression"
            ]
          }
        }
      }
    },
    {
      "id": "disallowed-literal-comparison",
      "forbid": {
        "ast": {
          "language": "sql",
          "utils": {
            "constant": {
              "any": [
                {
                  "kind": "literal",
                  "not": {
                    "has": {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "timestamp"
                        },
                        {
                          "kind": "time"
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "parameter",
                  "regex": "^\\$[0-9]+$"
                }
              ]
            },
            "typed-string": {
              "kind": "literal",
              "has": {
                "kind": "identifier",
                "not": {
                  "regex": "(?i)^(?:date|timetz|timestamptz)$"
                }
              }
            },
            "adjacent": {
              "not": {
                "any": [
                  {
                    "kind": "binary_expression"
                  },
                  {
                    "kind": "collate_expression"
                  }
                ]
              }
            }
          },
          "rule": {
            "kind": "binary_expression",
            "all": [
              {
                "has": {
                  "field": "operator",
                  "regex": "^(?:=|!=|<>)$",
                  "pattern": "$$OP"
                }
              },
              {
                "has": {
                  "field": "left",
                  "all": [
                    {
                      "matches": "adjacent"
                    },
                    {
                      "any": [
                        {
                          "matches": "constant"
                        },
                        {
                          "matches": "typed-string"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "right",
                  "any": [
                    {
                      "all": [
                        {
                          "matches": "adjacent"
                        },
                        {
                          "matches": "constant"
                        }
                      ]
                    },
                    {
                      "kind": "collate_expression",
                      "has": {
                        "field": "expression",
                        "all": [
                          {
                            "matches": "adjacent"
                          },
                          {
                            "matches": "constant"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "not": {
                  "all": [
                    {
                      "has": {
                        "field": "left",
                        "regex": "(?:^1|(?:^|\\s)'1')$"
                      }
                    },
                    {
                      "has": {
                        "field": "operator",
                        "regex": "^=$"
                      }
                    },
                    {
                      "has": {
                        "field": "right",
                        "any": [
                          {
                            "all": [
                              {
                                "matches": "adjacent"
                              },
                              {
                                "regex": "^(?:[01]|'[01]')$"
                              }
                            ]
                          },
                          {
                            "kind": "collate_expression",
                            "has": {
                              "field": "expression",
                              "all": [
                                {
                                  "matches": "adjacent"
                                },
                                {
                                  "regex": "^(?:[01]|'[01]')$"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.OP",
        "code": "ST10",
        "message": "Remove this comparison of two literals; it always has the same result (1 = 1 and 1 = 0 are allowed).",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "ST10",
              "all",
              "structure",
              "structure.constant_expression"
            ]
          }
        }
      }
    }
  ]
}
