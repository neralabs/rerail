{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-al05-aliasing-unused",
  "revision": 1,
  "mode": "steer",
  "description": "Port of SQLFluff 4.4.0's AL05 (aliasing.unused) with default settings: flag a table alias that is never used in its SELECT statement, except where the alias is required (a derived table or VALUES list) or the same table is referenced more than once.",
  "scope": { "include": ["**/*.sql"], "exclude": [] },
  "clauses": [
    {
      "id": "unused-table-alias",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "identifier",
            "pattern": "$ALIAS",
            "inside": {
              "kind": "relation",
              "stopBy": "neighbor",
              "has": { "field": "alias", "pattern": "$ALIAS" },
              "not": {
                "any": [
                  { "has": { "kind": "subquery", "stopBy": "neighbor" } },
                  { "has": { "kind": "values", "stopBy": "neighbor" } },
                  {
                    "has": { "kind": "object_reference", "stopBy": "neighbor", "has": { "field": "name", "pattern": "$TABLE" } },
                    "any": [
                      {
                        "follows": {
                          "kind": "relation",
                          "stopBy": "end",
                          "has": { "kind": "object_reference", "stopBy": "neighbor", "has": { "field": "name", "pattern": "$OTHER" } },
                          "compare": { "left": "TABLE", "op": "eq", "right": "OTHER", "text": "name" }
                        }
                      },
                      {
                        "precedes": {
                          "kind": "relation",
                          "stopBy": "end",
                          "has": { "kind": "object_reference", "stopBy": "neighbor", "has": { "field": "name", "pattern": "$OTHER" } },
                          "compare": { "left": "TABLE", "op": "eq", "right": "OTHER", "text": "name" }
                        }
                      }
                    ]
                  }
                ]
              }
            },
            "binds": { "used": false }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "AL05",
        "message": "Alias '$ALIAS' is never used in SELECT statement."
      }
    }
  ]
}
