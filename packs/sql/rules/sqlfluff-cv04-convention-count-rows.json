{"format":"rerail.policy/v1","id":"sqlfluff-cv04-convention-count-rows","revision":1,"mode":"steer","description":"Port of SQLFluff 4.4.0's CV04 (convention.count_rows) with default settings: COUNT(*) is required for row counts; COUNT(0) and COUNT(1) are violations, while COUNT(column) and other expressions are ignored.","scope":{"include":["**/*.sql"],"exclude":[]},"clauses":[{"id":"count-zero","forbid":{"ast":{"language":"sql","rule":{"kind":"invocation","has":{"kind":"object_reference","has":{"kind":"identifier","regex":"(?i)^count$"}},"has":{"kind":"parameter","has":{"kind":"term","has":{"kind":"literal","regex":"^0$"}}}}}},"violation":{"anchor":"witness.start","code":"CV04","message":"Use COUNT(*) to count rows."}},{"id":"count-one","forbid":{"ast":{"language":"sql","rule":{"kind":"invocation","has":{"kind":"object_reference","has":{"kind":"identifier","regex":"(?i)^count$"}},"has":{"kind":"parameter","has":{"kind":"term","has":{"kind":"literal","regex":"^1$"}}}}}},"violation":{"anchor":"witness.start","code":"CV04","message":"Use COUNT(*) to count rows."}}]}