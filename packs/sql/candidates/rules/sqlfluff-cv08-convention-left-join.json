{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-cv08-convention-left-join",
  "revision": 1,
  "mode": "steer",
  "description": "Port of SQLFluff 4.4.0's CV08 (convention.left_join): reject RIGHT JOIN and RIGHT OUTER JOIN; report the beginning of the join clause.",
  "scope": {"include": ["**/*.sql"], "exclude": []},
  "clauses": [
    {
      "id": "right-join",
      "forbid": {"ast": {"language": "sql", "rule": {
        "kind": "join",
        "has": {"stopBy": "neighbor", "kind": "keyword_right"}
      }}},
      "violation": {"anchor": "witness.start", "code": "CV08", "message": "Use LEFT JOIN instead of RIGHT JOIN.", "suppress": { "sqlfluff": { "rules": ["CV08", "L055", "all", "convention", "convention.left_join"] } }}
    }
  ]
}
