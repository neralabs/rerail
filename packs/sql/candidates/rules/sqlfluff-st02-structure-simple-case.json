{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-st02-structure-simple-case",
  "revision": 1,
  "mode": "steer",
  "description": "Replace a single-branch SQL CASE that only returns TRUE/FALSE or fills in a NULL with the condition itself or COALESCE.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "boolean-case",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "case",
            "all": [
              {
                "has": {
                  "kind": "keyword_when",
                  "follows": {
                    "kind": "keyword_case",
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "kind": "keyword_when",
                    "precedes": {
                      "stopBy": "end",
                      "kind": "keyword_when"
                    }
                  }
                }
              },
              {
                "has": {
                  "kind": "keyword_when",
                  "precedes": {
                    "pattern": "$C",
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "has": {
                  "kind": "keyword_then",
                  "precedes": {
                    "kind": "literal",
                    "regex": "^(?i:true|false)$",
                    "pattern": "$T",
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "has": {
                  "kind": "keyword_else",
                  "precedes": {
                    "kind": "literal",
                    "regex": "^(?i:true|false)$",
                    "pattern": "$E",
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "compare": {
                  "left": "T",
                  "op": "ne",
                  "right": "E",
                  "collation": "fold-upper"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "ST02",
        "message": "Replace this CASE with COALESCE($C, FALSE), prefixed with NOT if its THEN value is FALSE.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "ST02",
              "L043",
              "all",
              "structure",
              "structure.simple_case"
            ]
          }
        }
      }
    },
    {
      "id": "is-null-else-operand",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "case",
            "all": [
              {
                "has": {
                  "kind": "keyword_when",
                  "follows": {
                    "kind": "keyword_case",
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "kind": "keyword_when",
                    "precedes": {
                      "stopBy": "end",
                      "kind": "keyword_when"
                    }
                  }
                }
              },
              {
                "has": {
                  "kind": "keyword_when",
                  "precedes": {
                    "kind": "binary_expression",
                    "pattern": "$C",
                    "all": [
                      {
                        "has": {
                          "field": "operator",
                          "kind": "keyword_is"
                        }
                      },
                      {
                        "has": {
                          "field": "right",
                          "kind": "literal",
                          "regex": "^(?i:null)$"
                        }
                      },
                      {
                        "has": {
                          "field": "left",
                          "pattern": "$X",
                          "any": [
                            {
                              "kind": "field"
                            },
                            {
                              "kind": "subscript",
                              "has": {
                                "field": "expression",
                                "kind": "field"
                              },
                              "not": {
                                "has": {
                                  "field": "subscript",
                                  "not": {
                                    "kind": "literal"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "has": {
                  "kind": "keyword_else",
                  "precedes": {
                    "pattern": "$E",
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "compare": {
                  "left": "XQ",
                  "op": "eq",
                  "right": "EQ",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "XU",
                  "op": "eq",
                  "right": "EU",
                  "text": "source",
                  "collation": "fold-upper"
                }
              }
            ]
          },
          "transform": {
            "XQ": { "replace": { "source": "$X", "replace": "(\"[^\"]*\")|[^\"]", "by": "$1" } },
            "XU": { "replace": { "source": "$X", "replace": "\"[^\"]*\"", "by": "\"\"" } },
            "EQ": { "replace": { "source": "$E", "replace": "(\"[^\"]*\")|[^\"]", "by": "$1" } },
            "EU": { "replace": { "source": "$E", "replace": "\"[^\"]*\"", "by": "\"\"" } }
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "ST02",
        "message": "Replace this CASE with COALESCE($X, <its THEN value>), or just $X if the THEN value is NULL.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "ST02",
              "L043",
              "all",
              "structure",
              "structure.simple_case"
            ]
          }
        }
      }
    },
    {
      "id": "is-not-null-then-operand",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "case",
            "all": [
              {
                "has": {
                  "kind": "keyword_when",
                  "follows": {
                    "kind": "keyword_case",
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "kind": "keyword_when",
                    "precedes": {
                      "stopBy": "end",
                      "kind": "keyword_when"
                    }
                  }
                }
              },
              {
                "has": {
                  "kind": "keyword_when",
                  "precedes": {
                    "kind": "binary_expression",
                    "pattern": "$C",
                    "all": [
                      {
                        "has": {
                          "field": "operator",
                          "kind": "is_not"
                        }
                      },
                      {
                        "has": {
                          "field": "right",
                          "kind": "literal",
                          "regex": "^(?i:null)$"
                        }
                      },
                      {
                        "has": {
                          "field": "left",
                          "pattern": "$X",
                          "any": [
                            {
                              "kind": "field"
                            },
                            {
                              "kind": "subscript",
                              "has": {
                                "field": "expression",
                                "kind": "field"
                              },
                              "not": {
                                "has": {
                                  "field": "subscript",
                                  "not": {
                                    "kind": "literal"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    ],
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "has": {
                  "kind": "keyword_then",
                  "precedes": {
                    "pattern": "$T",
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                }
              },
              {
                "compare": {
                  "left": "XQ",
                  "op": "eq",
                  "right": "TQ",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "XU",
                  "op": "eq",
                  "right": "TU",
                  "text": "source",
                  "collation": "fold-upper"
                }
              }
            ]
          },
          "transform": {
            "XQ": { "replace": { "source": "$X", "replace": "(\"[^\"]*\")|[^\"]", "by": "$1" } },
            "XU": { "replace": { "source": "$X", "replace": "\"[^\"]*\"", "by": "\"\"" } },
            "TQ": { "replace": { "source": "$T", "replace": "(\"[^\"]*\")|[^\"]", "by": "$1" } },
            "TU": { "replace": { "source": "$T", "replace": "\"[^\"]*\"", "by": "\"\"" } }
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "ST02",
        "message": "Replace this CASE with COALESCE($X, <its ELSE value>), or just $X if it has no ELSE.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "ST02",
              "L043",
              "all",
              "structure",
              "structure.simple_case"
            ]
          }
        }
      }
    }
  ]
}
