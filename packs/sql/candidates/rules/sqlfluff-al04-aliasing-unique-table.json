{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-al04-aliasing-unique-table",
  "revision": 1,
  "mode": "steer",
  "description": "Give every table in a SQL FROM clause a unique alias; a repeated alias makes column references ambiguous.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "duplicate-explicit-alias",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "relation",
            "pattern": "$R",
            "all": [
              {
                "any": [
                  {
                    "has": {
                      "field": "alias",
                      "kind": "identifier",
                      "pattern": "$A"
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "field": "alias",
                        "regex": "."
                      }
                    },
                    "has": {
                      "kind": "object_reference",
                      "stopBy": "neighbor",
                      "has": {
                        "field": "name",
                        "kind": "identifier",
                        "pattern": "$A"
                      }
                    }
                  }
                ]
              },
              {
                "any": [
                  {
                    "any": [
                      {
                        "inside": {
                          "kind": "from",
                          "stopBy": "neighbor"
                        },
                        "follows": {
                          "stopBy": "end",
                          "compare": {
                            "left": "A",
                            "op": "eq",
                            "right": "B",
                            "text": "source"
                          },
                          "any": [
                            {
                              "kind": "relation",
                              "any": [
                                {
                                  "has": {
                                    "field": "alias",
                                    "kind": "identifier",
                                    "pattern": "$B"
                                  }
                                },
                                {
                                  "not": {
                                    "has": {
                                      "field": "alias",
                                      "regex": "."
                                    }
                                  },
                                  "has": {
                                    "kind": "object_reference",
                                    "stopBy": "neighbor",
                                    "has": {
                                      "field": "name",
                                      "kind": "identifier",
                                      "pattern": "$B"
                                    }
                                  }
                                }
                              ]
                            },
                            {
                              "kind": "join",
                              "has": {
                                "kind": "relation",
                                "stopBy": "neighbor",
                                "any": [
                                  {
                                    "has": {
                                      "field": "alias",
                                      "kind": "identifier",
                                      "pattern": "$B"
                                    }
                                  },
                                  {
                                    "not": {
                                      "has": {
                                        "field": "alias",
                                        "regex": "."
                                      }
                                    },
                                    "has": {
                                      "kind": "object_reference",
                                      "stopBy": "neighbor",
                                      "has": {
                                        "field": "name",
                                        "kind": "identifier",
                                        "pattern": "$B"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      {
                        "inside": {
                          "kind": "join",
                          "stopBy": "neighbor",
                          "inside": {
                            "kind": "from",
                            "stopBy": "neighbor"
                          },
                          "follows": {
                            "stopBy": "end",
                            "compare": {
                              "left": "A",
                              "op": "eq",
                              "right": "B",
                              "text": "source"
                            },
                            "any": [
                              {
                                "kind": "relation",
                                "any": [
                                  {
                                    "has": {
                                      "field": "alias",
                                      "kind": "identifier",
                                      "pattern": "$B"
                                    }
                                  },
                                  {
                                    "not": {
                                      "has": {
                                        "field": "alias",
                                        "regex": "."
                                      }
                                    },
                                    "has": {
                                      "kind": "object_reference",
                                      "stopBy": "neighbor",
                                      "has": {
                                        "field": "name",
                                        "kind": "identifier",
                                        "pattern": "$B"
                                      }
                                    }
                                  }
                                ]
                              },
                              {
                                "kind": "join",
                                "has": {
                                  "kind": "relation",
                                  "stopBy": "neighbor",
                                  "any": [
                                    {
                                      "has": {
                                        "field": "alias",
                                        "kind": "identifier",
                                        "pattern": "$B"
                                      }
                                    },
                                    {
                                      "not": {
                                        "has": {
                                          "field": "alias",
                                          "regex": "."
                                        }
                                      },
                                      "has": {
                                        "kind": "object_reference",
                                        "stopBy": "neighbor",
                                        "has": {
                                          "field": "name",
                                          "kind": "identifier",
                                          "pattern": "$B"
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  },
                  {
                    "any": [
                      {
                        "inside": {
                          "kind": "from",
                          "stopBy": "neighbor",
                          "inside": {
                            "any": [
                              {
                                "kind": "statement"
                              },
                              {
                                "kind": "subquery"
                              }
                            ],
                            "stopBy": "neighbor",
                            "has": {
                              "kind": "subquery",
                              "stopBy": {
                                "kind": "subquery"
                              },
                              "not": {
                                "inside": {
                                  "kind": "relation",
                                  "stopBy": "neighbor",
                                  "pattern": "$R2",
                                  "compare": {
                                    "left": "R",
                                    "op": "eq",
                                    "right": "R2",
                                    "text": "node"
                                  }
                                }
                              },
                              "has": {
                                "kind": "from",
                                "stopBy": "neighbor",
                                "has": {
                                  "stopBy": "neighbor",
                                  "compare": {
                                    "left": "A",
                                    "op": "eq",
                                    "right": "B",
                                    "text": "source"
                                  },
                                  "any": [
                                    {
                                      "kind": "relation",
                                      "any": [
                                        {
                                          "has": {
                                            "field": "alias",
                                            "kind": "identifier",
                                            "pattern": "$B"
                                          }
                                        },
                                        {
                                          "not": {
                                            "has": {
                                              "field": "alias",
                                              "regex": "."
                                            }
                                          },
                                          "has": {
                                            "kind": "object_reference",
                                            "stopBy": "neighbor",
                                            "has": {
                                              "field": "name",
                                              "kind": "identifier",
                                              "pattern": "$B"
                                            }
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "kind": "join",
                                      "has": {
                                        "kind": "relation",
                                        "stopBy": "neighbor",
                                        "any": [
                                          {
                                            "has": {
                                              "field": "alias",
                                              "kind": "identifier",
                                              "pattern": "$B"
                                            }
                                          },
                                          {
                                            "not": {
                                              "has": {
                                                "field": "alias",
                                                "regex": "."
                                              }
                                            },
                                            "has": {
                                              "kind": "object_reference",
                                              "stopBy": "neighbor",
                                              "has": {
                                                "field": "name",
                                                "kind": "identifier",
                                                "pattern": "$B"
                                              }
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "inside": {
                          "kind": "join",
                          "stopBy": "neighbor",
                          "inside": {
                            "kind": "from",
                            "stopBy": "neighbor",
                            "inside": {
                              "any": [
                                {
                                  "kind": "statement"
                                },
                                {
                                  "kind": "subquery"
                                }
                              ],
                              "stopBy": "neighbor",
                              "has": {
                                "kind": "subquery",
                                "stopBy": {
                                  "kind": "subquery"
                                },
                                "not": {
                                  "inside": {
                                    "kind": "relation",
                                    "stopBy": "neighbor",
                                    "pattern": "$R2",
                                    "compare": {
                                      "left": "R",
                                      "op": "eq",
                                      "right": "R2",
                                      "text": "node"
                                    }
                                  }
                                },
                                "has": {
                                  "kind": "from",
                                  "stopBy": "neighbor",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "compare": {
                                      "left": "A",
                                      "op": "eq",
                                      "right": "B",
                                      "text": "source"
                                    },
                                    "any": [
                                      {
                                        "kind": "relation",
                                        "any": [
                                          {
                                            "has": {
                                              "field": "alias",
                                              "kind": "identifier",
                                              "pattern": "$B"
                                            }
                                          },
                                          {
                                            "not": {
                                              "has": {
                                                "field": "alias",
                                                "regex": "."
                                              }
                                            },
                                            "has": {
                                              "kind": "object_reference",
                                              "stopBy": "neighbor",
                                              "has": {
                                                "field": "name",
                                                "kind": "identifier",
                                                "pattern": "$B"
                                              }
                                            }
                                          }
                                        ]
                                      },
                                      {
                                        "kind": "join",
                                        "has": {
                                          "kind": "relation",
                                          "stopBy": "neighbor",
                                          "any": [
                                            {
                                              "has": {
                                                "field": "alias",
                                                "kind": "identifier",
                                                "pattern": "$B"
                                              }
                                            },
                                            {
                                              "not": {
                                                "has": {
                                                  "field": "alias",
                                                  "regex": "."
                                                }
                                              },
                                              "has": {
                                                "kind": "object_reference",
                                                "stopBy": "neighbor",
                                                "has": {
                                                  "field": "name",
                                                  "kind": "identifier",
                                                  "pattern": "$B"
                                                }
                                              }
                                            }
                                          ]
                                        }
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.A",
        "code": "AL04",
        "message": "Give this table a different alias; '$A' already names another table in this query.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "AL04",
              "L020",
              "aliasing",
              "aliasing.unique",
              "aliasing.unique.table",
              "all",
              "core"
            ]
          }
        }
      }
    }
  ]
}
