{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-st10-structure-constant-expression",
  "revision": 1,
  "mode": "steer",
  "description": "Remove SQL comparisons that are always true or false, such as an expression compared to itself or two literals; 1 = 1 and 1 = 0 are allowed.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "identical-nonliteral-operands",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "binary_expression",
            "all": [
              {
                "has": {
                  "field": "operator",
                  "regex": "^(?:=|!=|<>)$",
                  "pattern": "$$OP"
                }
              },
              {
                "has": {
                  "field": "left",
                  "pattern": "$L",
                  "not": {
                    "kind": "literal"
                  }
                }
              },
              {
                "has": {
                  "field": "right",
                  "pattern": "$R",
                  "not": {
                    "kind": "literal"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "field": "left",
                    "kind": "binary_expression"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "field": "right",
                    "kind": "binary_expression"
                  }
                }
              },
              {
                "compare": {
                  "left": "L",
                  "op": "eq",
                  "right": "R",
                  "text": "source"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.OP",
        "code": "ST10",
        "message": "Remove or correct this comparison of $L with itself; it is always true or always false.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "ST10",
              "all",
              "structure",
              "structure.constant_expression"
            ]
          }
        }
      }
    },
    {
      "id": "disallowed-literal-comparison",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "binary_expression",
            "all": [
              {
                "has": {
                  "field": "operator",
                  "regex": "^(?:=|!=|<>)$",
                  "pattern": "$$OP"
                }
              },
              {
                "has": {
                  "field": "left",
                  "kind": "literal",
                  "not": {
                    "has": {
                      "kind": "identifier"
                    }
                  }
                }
              },
              {
                "has": {
                  "field": "right",
                  "kind": "literal",
                  "not": {
                    "has": {
                      "kind": "identifier"
                    }
                  }
                }
              },
              {
                "not": {
                  "all": [
                    {
                      "has": {
                        "field": "left",
                        "regex": "^1$"
                      }
                    },
                    {
                      "has": {
                        "field": "operator",
                        "regex": "^=$"
                      }
                    },
                    {
                      "has": {
                        "field": "right",
                        "regex": "^[01]$"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.OP",
        "code": "ST10",
        "message": "Remove this comparison of two literals; it always has the same result (1 = 1 and 1 = 0 are allowed).",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "ST10",
              "all",
              "structure",
              "structure.constant_expression"
            ]
          }
        }
      }
    }
  ]
}
