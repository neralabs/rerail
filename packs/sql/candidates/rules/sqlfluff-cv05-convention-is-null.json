{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-cv05-convention-is-null",
  "revision": 1,
  "mode": "steer",
  "description": "Port of SQLFluff 4.4.0's CV05 (convention.is_null): report =, != and <> whose right operand is the NULL literal itself (not parenthesised), anchored at the operator. A SET clause's assignment and an exclusion constraint's operator are not comparisons in the grammar, as SQLFluff skips them.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "relational-null-comparison",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "binary_expression",
            "all": [
              {
                "has": {
                  "field": "operator",
                  "regex": "^(?:=|!=|<>)$",
                  "pattern": "$$OP"
                }
              },
              {
                "has": {
                  "field": "right",
                  "kind": "literal",
                  "has": {
                    "kind": "keyword_null"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.OP",
        "code": "CV05",
        "message": "Comparisons with NULL should use IS or IS NOT.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "CV05",
              "L049",
              "all",
              "convention",
              "convention.is_null",
              "core"
            ]
          }
        }
      }
    }
  ]
}
