{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-am02-ambiguous-union",
  "revision": 1,
  "mode": "steer",
  "description": "Write UNION ALL or UNION DISTINCT instead of a bare UNION in MySQL or ANSI SQL; it makes the duplicate handling explicit.",
  "scope": { "include": ["**/*.sql"], "exclude": [] },
  "clauses": [
    {
      "id": "bare-union",
      "forbid": { "ast": { "language": "sql", "rule": {
        "kind": "keyword_union",
        "inside": { "kind": "set_operation" },
        "not": { "precedes": { "stopBy": "neighbor", "any": [ { "kind": "keyword_all" }, { "kind": "keyword_distinct" } ] } }
      } } },
      "violation": { "anchor": "witness.start", "code": "AM02", "message": "UNION should be followed by DISTINCT or ALL.", "suppress": { "sqlfluff": { "rules": ["AM02", "L033", "all", "ambiguous", "ambiguous.union", "core"] } } }
    }
  ]
}