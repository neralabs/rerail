{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-pg01-postgres-excessive-locks",
  "revision": 1,
  "mode": "steer",
  "description": "Use CONCURRENTLY on non-unique CREATE INDEX, DROP INDEX, REINDEX and REFRESH MATERIALIZED VIEW in PostgreSQL; otherwise the table is locked while it runs.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "create-index-without-concurrently",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "create_index",
            "all": [
              {
                "not": {
                  "has": {
                    "kind": "keyword_concurrently"
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "kind": "keyword_unique"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_body"
                      },
                      {
                        "kind": "block"
                      },
                      {
                        "kind": "ERROR"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "PG01",
        "message": "Add CONCURRENTLY to this CREATE INDEX so the table isn't locked while the index builds.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "PG01",
              "all",
              "postgres",
              "postgres.excessive_locks"
            ]
          }
        }
      }
    },
    {
      "id": "drop-index-without-concurrently",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "drop_index",
            "all": [
              {
                "not": {
                  "has": {
                    "kind": "keyword_concurrently"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_body"
                      },
                      {
                        "kind": "block"
                      },
                      {
                        "kind": "ERROR"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "PG01",
        "message": "Add CONCURRENTLY to this DROP INDEX so the table isn't locked while it runs.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "PG01",
              "all",
              "postgres",
              "postgres.excessive_locks"
            ]
          }
        }
      }
    },
    {
      "id": "reindex-without-concurrently",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "reindex_statement",
            "all": [
              {
                "not": {
                  "has": {
                    "kind": "keyword_concurrently"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_body"
                      },
                      {
                        "kind": "block"
                      },
                      {
                        "kind": "ERROR"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "PG01",
        "message": "Add CONCURRENTLY to this REINDEX so the table isn't locked while it runs.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "PG01",
              "all",
              "postgres",
              "postgres.excessive_locks"
            ]
          }
        }
      }
    },
    {
      "id": "refresh-without-concurrently",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "refresh_statement",
            "all": [
              {
                "not": {
                  "has": {
                    "kind": "keyword_concurrently"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_body"
                      },
                      {
                        "kind": "block"
                      },
                      {
                        "kind": "ERROR"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "PG01",
        "message": "Add CONCURRENTLY to this REFRESH MATERIALIZED VIEW so the view stays readable while it runs.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "PG01",
              "all",
              "postgres",
              "postgres.excessive_locks"
            ]
          }
        }
      }
    }
  ]
}
