{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-rf01-references-from",
  "revision": 1,
  "mode": "steer",
  "description": "Qualify SQL columns only with a table or alias named in the FROM clause of the query or an enclosing query.",
  "scope": { "include": ["**/*.sql"], "exclude": [] },
  "clauses": [
    {
      "id": "qualifier-not-in-from",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "identifier",
            "inside": {
              "kind": "object_reference",
              "stopBy": "neighbor",
              "inside": { "kind": "field", "stopBy": "neighbor" }
            },
            "not": {
              "any": [
                { "precedes": { "kind": "identifier", "stopBy": "end" } },
                {
                  "inside": {
                    "kind": "select_expression",
                    "stopBy": "end",
                    "follows": { "kind": "keyword_into", "stopBy": "neighbor" }
                  }
                }
              ]
            },
            "resolves": { "unresolved": true }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "RF01",
        "message": "Qualify this column with a table or alias named in the FROM clause of this query or an enclosing one.", "suppress": { "sqlfluff": { "rules": ["RF01", "L026", "all", "core", "references", "references.from"] } }
      }
    }
  ]
}
