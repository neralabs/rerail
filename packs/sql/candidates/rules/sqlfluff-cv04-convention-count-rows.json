{
  "format": "rerail.policy/v1",
  "id": "sqlfluff-cv04-convention-count-rows",
  "revision": 1,
  "mode": "steer",
  "description": "Port of SQLFluff 4.4.0's CV04 (convention.count_rows) with default settings (prefer_count_1 and prefer_count_0 false): COUNT(*) is required for row counts; an unqualified COUNT whose only argument is the literal 0 or 1 is reported at the function's start, while COUNT(column), COUNT(DISTINCT ...) and other expressions are not.",
  "scope": {
    "include": [
      "**/*.sql"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "count-literal",
      "forbid": {
        "ast": {
          "language": "sql",
          "rule": {
            "kind": "invocation",
            "regex": "^(?i:count)\\s*\\(\\s*[01]\\s*\\)$",
            "has": {
              "field": "parameter",
              "kind": "term",
              "has": {
                "field": "value",
                "kind": "literal"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "CV04",
        "message": "Use COUNT(*) to count rows.",
        "suppress": {
          "sqlfluff": {
            "rules": [
              "CV04",
              "L047",
              "all",
              "convention",
              "convention.count_rows",
              "core"
            ]
          }
        }
      }
    }
  ]
}
