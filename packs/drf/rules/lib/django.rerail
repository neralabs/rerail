// COPY: packs/django/rules/lib/django.rerail, unchanged below this line. A pack's rules can include only core's library
// and files beside them, so lib/drf.rerail includes this copy; keep it identical to the django pack's.
// lib/django: Django's models, querysets, transactions, views and settings, as the django-practice rules read
// them. Names resolve through imports (python/names' sym_of), so `from django.db import models` and
// `from django.db.models import ForeignKey` both reach "django.db.models.ForeignKey"; class bases resolve across the
// files of the run (class_base), so a model whose abstract base sits in another module is still a model.
//
// Interface
//   Models:        dj_model(c)                 class c is a Django model: it derives from django.db.models.Model or a
//                                              known model base (dj_model_base), through the run's classes, or its
//                                              body declares a model field (other than a query expression's
//                                              `output_field`)
//                  dj_field(c, x, call, t)     model c declares field x as `x = call`, a call of field class t (the
//                                              class's last name: "CharField", "ForeignKey", ...)
//                  dj_fk(c, x)                 field x of model c holds one related object (ForeignKey, OneToOneField,
//                                              ParentalKey), so `obj.x_id` holds its key
//                  dj_fk_class(t)              field class t (a dj_field's t) holds one related object
//                  dj_has_field(c, x, t)       model c has field x of field class t: declared in its body or in a
//                                              class of the run among its ancestors (by symbol, 0677 fix 3b)
//                  dj_field_kw(c, x, k, v)     a declaration of model c's field x passes keyword argument k, of text v
//                  dj_attname(c, a, x)         a row of model c holds field x's value in attribute a: the field's
//                                              name, and `x_id` for a ForeignKey or OneToOneField x
//                  dj_number_field(t)          field class t holds a number (IntegerField, DecimalField, ...)
//                  dj_model_method(c, f, x)    f is method x defined directly in model c's body
//   Querysets:     dj_manager(e)               e is `<X>.objects` (or `_default_manager`, `_base_manager`)
//                  dj_qs(e)                    e is a queryset written as a chain from a manager: `Book.objects`,
//                                              `Book.objects.filter(a=1).order_by("b")`, through dj_qs_method calls
//                  dj_qs_call(c, m)            call c is `<dj_qs>.m(...)`, any method m
//                  dj_qs_root(q, r)            queryset chain q starts at `r.objects`
//                  dj_qs_model(q, c)           queryset q is a chain from `M.objects`, M model class c of the run
//                  dj_qs_class(q, mq)          the same, by the class's qualified name mq
//                  dj_qs_has(q, m)             queryset chain q calls method m somewhere along it
//                  dj_row_method(m)            QuerySet method m returns one row: get, create, first, last, ...
//   Instances:     dj_fetch_call(c, mq)        call c fetches one row of model class mq: `M.objects….get()`, `aget()`
//                  dj_instance_class(r, h, mq) identifier r in scope h holds an instance of model class mq: `self` in
//                                              its method, or a name bound to `M(...)` or a fetch, awaited or not
//   Transactions:  dj_atomic(e)                e names django.db.transaction.atomic, bare or called
//                  dj_atomic_with(w, b)        with-statement w opens `transaction.atomic(...)`; b is its body
//                  dj_atomic_def(f)            function f is decorated with `@transaction.atomic` or `@atomic(...)`
//                  dj_in_atomic(n, a)          n runs inside atomic region a (a with-body or an atomic def), with no
//                                              nested def or class between them
//                  dj_region_stop(k)           the node kinds whose code runs later: def, lambda, class
//                  dj_atomic_like_with(w, b)   with-statement w calls a wrapper named like atomic; b is its body
//                  dj_in_transaction(n)        n runs in atomic (dj_in_atomic) or in a dj_atomic_like_with body
//                  dj_atomic_requests_value(v) v is the value a settings file gives ATOMIC_REQUESTS
//                  dj_atomic_requests()        some settings file sets ATOMIC_REQUESTS to the literal True
//   Side effects:  dj_side_effect(c, what)     call c enqueues a task or sends mail (`what` names it: ".delay()")
//                  dj_task_waits_for_commit(c) task call c goes through a task class whose delay/apply_async waits
//                                              for transaction.on_commit
//                  dj_dispatch_in_failing_handler(c)
//                                              side effect c is in an except handler that always re-raises
//                  dj_dispatch_result_used(c)  `r = c` and the function reads r afterwards
//   Views:         dj_view_class(c)            class c derives from django.views.View (generic views included) or a
//                                              Django REST framework view, through the run's classes; a class
//                                              deriving from their `…Mixin` classes alone is not one
//   Files:         dj_migration_doc(d)         document d is a migration: it defines `class Migration(...)` with a
//                                              django.db.migrations.Migration base
//                  dj_test_doc(d)              document d is test code: a tests/test/testing/unittests directory,
//                                              test_*.py, *_tests.py, *_test.py, tests.py, test.py or conftest.py
//                  dj_django_doc(d)            document d imports from django or rest_framework (`import django…`,
//                                              `from django… import …`, `from rest_framework… import …`)
//   Settings:      dj_settings(e)              e is django.conf.settings
//   Migrations:    dj_mig_class(c, d)          class c is migration document d's `Migration` class
//                  dj_mig_key(d, q)            migration d's key across files: its package and file name without
//                                              `.py` ("shop.migrations.0003_book_isbn"), as a dependency names it
//                  dj_mig_attr(d, x, v)        d's Migration class body assigns `x = v` (operations, dependencies, ...)
//                  dj_mig_nonatomic(d)         d sets `atomic = False`
//                  dj_mig_op_call(o, k)        call o constructs migration operation class k ("AddField", ...)
//                  dj_mig_op(o, k, d, i)       operation o of class k is item i of d's `operations`
//                  dj_mig_db_op(o, k, d, i)    as dj_mig_op, for the operations that change the database: not a
//                                              SeparateDatabaseAndState itself, but its database_operations (at
//                                              its position i); its state_operations are not
//                  dj_mig_arg(o, x, v)         operation o gets v for parameter x, by keyword or by position
//                  dj_mig_model(o, m)          operation o acts on model m, lowercased ("orderposition")
//                  dj_mig_field(o, x, f, t)    operation o defines field x as field call f of class t (AddField,
//                                              AlterField, or a CreateModel `fields` item)
//                  dj_mig_field_class(f, t)    call f constructs a field of class t, by its callee's last name
//                  dj_mig_creates(d, m)        migration d creates model m (its table is new in d)
//                  dj_runpython(o, d, i, q)    RunPython o, item i of d, runs the function named q (same file or
//                                              imported), read by that name in its own file
//                  dj_calls(g, h)              def g calls def h of the run, by name, both qualified names
//                  dj_mig_dep(a, b)            migration a lists b of its own package in `dependencies`, or a
//                                              migration that squashed migration b replaces (by key; cross_file)
//                  dj_mig_ran_before(b, a)     b is applied before a (dj_mig_dep, transitively; by key)
//                  dj_field_def(p, d, i, m, x) operation p, item i of d, defines field x of model m (CreateModel,
//                                              AddField, AlterField, RenameField's new name; state_operations too)
//                  dj_field_src(d, i, m, x, e, j, y)
//                                              field x of model m at item i of migration d (an AlterField, a
//                                              RenameField's old name, a relation call's target key) is the field
//                                              call item j of migration e gives field y: the nearest earlier
//                                              definition, followed back through a RenameField (all by key)
//                  dj_pk_def(e, j, m, x)       item j of migration e defines model m's key x, `primary_key=True`
//                  dj_pk_name(m, x)            field x is model m's primary key in some migration of the run
//                  dj_fk_target(f, m)          ForeignKey/OneToOneField call f points at model m (lowercased)
//                  dj_custom_field(e, t)       e names a field class of the run derived from Django's field class
//                                              t, with no db_type override on the way (by symbol, py_names)
//                  dj_custom_field_init(e)     a class on the way from e's class to Django's defines `__init__`,
//                                              so its call arguments may not be its column's parameters
//                  dj_mysql_only()             the run configures MySQL and names no PostgreSQL database
//                                              (cross_file: read it in an output)
//                  dj_live_doc(d)              d is application code: not a migration, no `test` in its path
//                  dj_one_row(m)               live code reads model m (lowercased) as its one row: `M.objects.get()`
//                                              with no arguments, a no-argument `first()` beside a `create()` of M
//                                              (the lazy singleton), `M.get_solo()`, the current site's row through
//                                              a OneToOneField's related name (a settings table; cross_file: read
//                                              it in an output)
//                  dj_one_row_qs(q, r)         q is `r.objects` or `r.objects.all()`
//   Python tests:  py_truth(e)                 e is read only for its truth: an if/elif/while/assert test, a
//                                              conditional or comprehension `if`, `not e`, `bool(e)`, an and/or
//                                              operand of one of these
//                  py_empty_cmp(c, x)          comparison c holds exactly when the number x is 0, or exactly when it
//                                              is not: `x > 0`, `x == 0`, `1 <= x`, ...
//                  py_empty_test(x)            the number x is only tested for being 0: py_empty_cmp or py_truth
//                  py_no_args(c)               call c passes no argument: `qs.count()`
//                  py_reraising_handler(x)     every path through except clause x ends in `raise`
//
// Django background
//   - A manager attribute (`objects`) is the usual way into a queryset; custom managers and related managers
//     (`author.book_set`) are querysets too, but one file cannot tell them from other attributes, so dj_qs starts
//     only at the three manager names Django gives every model.
//   - transaction.atomic is a decorator and a context manager, bare or called: `@atomic`, `@atomic(using="x")`,
//     `with atomic():`. Code an atomic def calls is in the transaction too, which no relation here follows.
//   - A field's attname is the attribute its column value lives in: the field's name, except for a ForeignKey or
//     OneToOneField `author`, whose key is `author_id` (and `author` loads the related row).
//   e.g.  from django.db import models, transaction
//         class Book(models.Model):                     dj_model
//             author = models.ForeignKey(Author, ...)   dj_field(<Book>, "author", <call>, "ForeignKey"), dj_fk,
//                                                       dj_attname(<Book>, "author_id", <call>)
//         class Novel(Book): ...                        dj_has_field(<Novel>, "author", <call>, "ForeignKey")
//         Book.objects.filter(x=1).exists()             dj_qs(<Book.objects.filter(x=1)>), dj_qs_call(_, "exists"),
//                                                       dj_qs_model(<Book.objects.filter(x=1)>, <Book>)
//         with transaction.atomic():                    dj_atomic_with; its statements are dj_in_atomic
//         if Book.objects.count() > 0:                  py_empty_cmp(<the comparison>, <the count() call>)
#include "python/ast.rerail"
#include "python/calls.rerail"   // call_arg, posarg: its syntax helpers only
#include "python/django-shared.rerail"  // dj_model_base, dj_test_doc: the phase py_names reads them too

// ---- models ------------------------------------------------------------------------------------------------------
// dj_field_module(m): the modules model field classes are imported from (`models.CharField`, `JSONField`, ...).
.decl dj_field_module(m: symbol)
dj_field_module("django.db.models"). dj_field_module("django.db.models.fields").
dj_field_module("django.db.models.fields.related"). dj_field_module("django.db.models.fields.json").
dj_field_module("django.contrib.postgres.fields"). dj_field_module("django.contrib.gis.db.models").
dj_field_module("modelcluster.fields").
// dj_field_call(call, t): call constructs a model field of class t: a `…Field`, or a relation.
.decl dj_field_call(call: node, t: symbol)
dj_field_call(call, t) :- kind(call, "call"), field(call, "function", f), sym_of(f, q), split_dot(q, m, t),
    dj_field_module(m), (suffix("Field", t) ; dj_relation_class(t)).
.decl dj_relation_class(t: symbol)
dj_relation_class("ForeignKey"). dj_relation_class("OneToOneField"). dj_relation_class("ManyToManyField").
dj_relation_class("ParentalKey"). dj_relation_class("ParentalManyToManyField").
// dj_custom_field(e, t): e names a field class of the run (dj_model_ref: sym_of, of a module e's file reads) derived from
// Django's field class t (`class MoneyField(models.DecimalField)`), with no class of the run on the way defining
// `db_type` or `rel_db_type`, so its column is t's. Its ancestry and its and its ancestors' methods are the phase
// py_names' (0677 fixes 3a, 3b), read by symbol: no class node of another file is read.
.decl dj_custom_field(e: node, t: symbol)
dj_custom_field(e, t) :- dj_model_ref(e, q, m), py_names__ancestor(m, q, b), split_dot(b, fm, t), dj_field_module(fm),
    (suffix("Field", t) ; dj_relation_class(t)), !dj_class_method_at(e, "db_type"), !dj_class_method_at(e, "rel_db_type").
// dj_class_method_at(e, x): the class of the run e names, or one of its ancestors of the run, defines method x.
.decl dj_class_method_at(e: node, x: symbol)
dj_class_method_at(e, x) :- dj_model_ref(e, q, m), (py_names__member_method(m, q, x) ; py_names__anc_method(m, q, x)).
// dj_custom_field_init(e): a class on the way from the field class e names to Django's defines `__init__`, which may
// rewrite the arguments (InvenTree's InvenTreeURLField forces max_length=2000), so its call arguments do not give its
// column's parameters.
.decl dj_custom_field_init(e: node)
dj_custom_field_init(e) :- dj_custom_field(e, _), dj_class_method_at(e, "__init__").
// dj_fk_class(t): the relation classes that hold one related object, whose key the row keeps in `<name>_id`.
.decl dj_fk_class(t: symbol)
dj_fk_class("ForeignKey"). dj_fk_class("OneToOneField"). dj_fk_class("ParentalKey").
// dj_class_field(c, x, call, t): class c's body has `x = call` (or `x: T = call`) with call a field of class t.
.decl dj_class_field(c: node, x: symbol, call: node, t: symbol)
dj_class_field(c, x, call, t) :- kind(c, "class_definition"), field(c, "body", b), body_stmt(b, s, _),
    kind(s, "expression_statement"), child(s, a, 0), kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"),
    text(l, x), field(a, "right", call), dj_field_call(call, t).
// dj_expression(c): class c is a query expression, which declares fields (`output_field = models.TextField()`) but
// is no model: a direct base under django.db.models' expressions, functions, aggregates or lookups modules, or one
// of their classes as django.db.models exports them.
//   class Concat(models.Func): output_field = models.TextField()     dj_expression, not dj_model
.decl dj_expression(c: node)
dj_expression(c) :- class_base(c, b), (prefix("django.db.models.expressions.", b) ;
    prefix("django.db.models.functions.", b) ; prefix("django.db.models.aggregates.", b) ;
    prefix("django.db.models.lookups.", b) ; dj_expression_base(b)).
.decl dj_expression_base(q: symbol)
dj_expression_base("django.db.models.Func"). dj_expression_base("django.db.models.Expression").
dj_expression_base("django.db.models.Aggregate"). dj_expression_base("django.db.models.Transform").
dj_expression_base("django.db.models.Lookup"). dj_expression_base("django.db.models.Subquery").
dj_expression_base("django.db.models.ExpressionWrapper"). dj_expression_base("django.db.models.Value").
dj_expression_base("django.db.models.Window").
// A field declared in the body is model evidence, except a query expression's `output_field`.
.decl dj_model(c: node)
// A model class: a known base itself, or a class with one among its ancestors (python/names' class_anc, the phase
// py_names' linear closure keyed by the class's module, 0677 fix 3a; a closure over every file's classes here did not
// finish on a large repository as python/scopes' subclass, and took c into the cross-file part).
dj_model(c) :- class_def(c, q), dj_model_base(q).
dj_model(c) :- class_anc(c, b), dj_model_base(b).
dj_model(c) :- dj_class_field(c, x, _, _), x != "output_field", !dj_expression(c).
.decl dj_field(c: node, x: symbol, call: node, t: symbol)
dj_field(c, x, call, t) :- dj_model(c), dj_class_field(c, x, call, t).
.decl dj_fk(c: node, x: symbol)
dj_fk(c, x) :- dj_field(c, x, _, t), dj_fk_class(t).
// ---- a model, by symbol, from any file (decision 0677 fix 3b) ------------------------------------------------------
// A model class in another file is read by its symbol, in the rows the phase py_names hands on for the modules a file
// reads (python/names): its ancestry and the members of its body and its ancestors'. Each is read at a node of the
// reading file, so none pairs it with the class's node in its own file. The tests are dj_model's.
// dj_model_ref(e, mq, m): node e names class mq of the run (sym_of), or is that class, of module m, a module e's file
// reads.
.decl dj_model_ref(e: node, mq: symbol, m: symbol)
dj_model_ref(e, mq, m) :- sym_of(e, mq), docof(e, d), doc(d, p, _), py_names__reads_at(p, m), py_names__class(m, mq).
dj_model_ref(c, mq, m) :- class_def(c, mq), docof(c, d), doc(d, p, _), py_names__reads_at(p, m), py_names__class(m, mq).
// dj_model_named(e, mq): that class is a model: a known base itself or among its ancestors, or one whose own body
// declares a field, a query expression's `output_field` aside (dj_model_class_is, by symbol alone).
//   from shop.models import Book; Book.objects.all()    dj_model_named(<Book>, "shop.models.Book")
.decl dj_model_named(e: node, mq: symbol)
dj_model_named(e, mq) :- dj_model_ref(e, mq, _), docof(e, d), dj_model_at(d, mq).
// dj_model_at(d, mq): class mq of a module document d reads is a model, by the same tests: what a rule asks of a class
// it knows by name alone (a proven type, a view's `model =`).
.decl dj_model_at(d: number, mq: symbol)
dj_model_at(d, mq) :- dj_class_at(d, _, mq), dj_model_base(mq).
dj_model_at(d, mq) :- dj_class_at(d, m, mq), py_names__ancestor(m, mq, b), dj_model_base(b).
dj_model_at(d, mq) :- dj_class_at(d, m, mq), py_names__member_call(m, mq, x, f), x != "output_field",
    split_dot(f, fm, t), dj_field_module(fm), (suffix("Field", t) ; dj_relation_class(t)), !dj_expression_at(d, mq).
.decl dj_class_at(d: number, m: symbol, mq: symbol)
dj_class_at(d, m, mq) :- doc(d, p, _), py_names__reads_at(p, m), py_names__class(m, mq).
.decl dj_expression_at(d: number, mq: symbol)
dj_expression_at(d, mq) :- dj_class_at(d, m, mq), py_names__ancestor(m, mq, b),
    (prefix("django.db.models.expressions.", b) ; prefix("django.db.models.functions.", b) ;
    prefix("django.db.models.aggregates.", b) ; prefix("django.db.models.lookups.", b) ; dj_expression_base(b)).
// dj_model_field(e, x, t): the model e names has field x of field class t, declared in its body or an ancestor's of
// the run. dj_model_field_kw(e, x, k, v): a declaration of it passes keyword argument k, of text v.
// dj_model_has_method(e, x): its body, or an ancestor's of the run, defines method x.
.decl dj_model_field(e: node, x: symbol, t: symbol)
dj_model_field(e, x, t) :- dj_model_named(e, mq), dj_model_ref(e, mq, m), py_names__member_call(m, mq, x, f),
    split_dot(f, fm, t), dj_field_module(fm), (suffix("Field", t) ; dj_relation_class(t)).
dj_model_field(e, x, t) :- dj_model_named(e, mq), dj_model_ref(e, mq, m), py_names__anc_call(m, mq, x, f),
    split_dot(f, fm, t), dj_field_module(fm), (suffix("Field", t) ; dj_relation_class(t)).
.decl dj_model_field_kw(e: node, x: symbol, k: symbol, v: symbol)
dj_model_field_kw(e, x, k, v) :- dj_model_field(e, x, _), dj_model_named(e, mq), dj_model_ref(e, mq, m),
    (py_names__member_kw(m, mq, x, k, v) ; py_names__anc_kw(m, mq, x, k, v)).
.decl dj_model_has_method(e: node, x: symbol)
dj_model_has_method(e, x) :- dj_model_named(e, mq), dj_model_ref(e, mq, m),
    (py_names__member_method(m, mq, x) ; py_names__anc_method(m, mq, x)).
// A model's Meta options and managers, by symbol (0677 fix 3c): the phase py_names' Django section reads each model's
// Meta, its abstract and concrete bases' as Django inherits them, and the manager classes its attributes name, and
// hands them on under the model's module. Read at a node e of the reading file that names the model (dj_model_ref).
//   dj_model_group(e, g, x)       field x is in group g, kept unique together (unique_together, a UniqueConstraint's
//                                 fields= without a condition)
//   dj_model_cond_group(e, g, x)  the same of a UniqueConstraint with a condition
//   dj_model_opaque(e)            a uniqueness option of its Meta is not read (not a literal, an expression constraint)
//   dj_model_unmanaged(e)         its Meta options set `managed` to anything but True
//   dj_model_abstract(e)          its own Meta says `abstract = True`
//   dj_model_manager_method(e, a, x)  its manager attribute a's class (or its get_queryset()'s class) of the run
//                                 defines or inherits x, get_or_create or update_or_create
.decl py_names__dj_group(m: symbol, q: symbol, g: symbol, x: symbol)
.decl py_names__dj_cond_group(m: symbol, q: symbol, g: symbol, x: symbol)
.decl py_names__dj_opaque(m: symbol, q: symbol)
.decl py_names__dj_unmanaged(m: symbol, q: symbol)
.decl py_names__dj_abstract(m: symbol, q: symbol)
.decl py_names__dj_manager_method(m: symbol, q: symbol, a: symbol, x: symbol)
.decl dj_model_group(e: node, g: symbol, x: symbol)
dj_model_group(e, g, x) :- dj_model_named(e, mq), dj_model_ref(e, mq, m), py_names__dj_group(m, mq, g, x).
.decl dj_model_cond_group(e: node, g: symbol, x: symbol)
dj_model_cond_group(e, g, x) :- dj_model_named(e, mq), dj_model_ref(e, mq, m), py_names__dj_cond_group(m, mq, g, x).
.decl dj_model_opaque(e: node)
dj_model_opaque(e) :- dj_model_named(e, mq), dj_model_ref(e, mq, m), py_names__dj_opaque(m, mq).
.decl dj_model_unmanaged(e: node)
dj_model_unmanaged(e) :- dj_model_named(e, mq), dj_model_ref(e, mq, m), py_names__dj_unmanaged(m, mq).
.decl dj_model_abstract(e: node)
dj_model_abstract(e) :- dj_model_named(e, mq), dj_model_ref(e, mq, m), py_names__dj_abstract(m, mq).
// A model's hooks, by symbol (0677 fix 3d), from the phase's Django section:
//   dj_model_hook(e, k, h)        a hook of kind k ("save" or "delete") that a bulk write on the model e names skips,
//                                 h its description: its save()/delete(), or an ancestor's of the run, doing more than
//                                 call the base class's; a pre_save/post_save receiver for it in any file
//   dj_receiver_def(f, mq)        def f of the reading file is connected, in any file, as a pre_save/post_save receiver
//                                 for sender mq
.decl py_names__dj_hook(m: symbol, q: symbol, k: symbol, h: symbol)
.decl py_names__dj_receiver_fn(m: symbol, f: symbol, q: symbol)
.decl dj_model_hook(e: node, k: symbol, h: symbol)
dj_model_hook(e, k, h) :- dj_model_named(e, mq), dj_model_ref(e, mq, m), py_names__dj_hook(m, mq, k, h).
.decl dj_receiver_def(f: node, mq: symbol)
dj_receiver_def(f, mq) :- kind(f, "function_definition"), qualname(f, fq), docof(f, d), doc(d, p, _),
    py_names__reads_at(p, m), py_names__dj_receiver_fn(m, fq, mq).
.decl dj_model_manager_method(e: node, a: symbol, x: symbol)
dj_model_manager_method(e, a, x) :- dj_model_named(e, mq), dj_model_ref(e, mq, m),
    py_names__dj_manager_method(m, mq, a, x).
// dj_has_field(c, x, t): model c has field x of field class t, declared in its body (dj_field) or in a class of the
// run among its ancestors: python/names' class_anc_call, the phase py_names' join of each ancestor's body to the class
// by symbol (0677 fix 3b). Pairing c with the ancestor's class node in its own file took both into the cross-file part.
//   class Novel(Book): pages = models.IntegerField()
//                                                   dj_has_field(<Novel>, "pages", "IntegerField"),
//                                                   dj_has_field(<Novel>, "author", "ForeignKey")
.decl dj_has_field(c: node, x: symbol, t: symbol)
dj_has_field(c, x, t) :- dj_field(c, x, _, t).
dj_has_field(c, x, t) :- dj_model(c), class_anc_call(c, x, f), split_dot(f, m, t), dj_field_module(m),
    (suffix("Field", t) ; dj_relation_class(t)).
// dj_field_kw(c, x, k, v): a declaration of model c's field x passes keyword argument k, whose value's text is v.
//   author = models.ForeignKey(Author, to_field="code")   dj_field_kw(<Book>, "author", "to_field", "\"code\"")
.decl dj_field_kw(c: node, x: symbol, k: symbol, v: symbol)
dj_field_kw(c, x, k, v) :- dj_field(c, x, call, _), call_arg(call, -1, k, w), node_text(w, v).
dj_field_kw(c, x, k, v) :- dj_has_field(c, x, _), class_anc_kw(c, x, k, v).
// dj_attname(c, a, x): a row of model c holds the value of field x (dj_has_field) in attribute a: the field's name,
// and for a ForeignKey, OneToOneField or ParentalKey x also `x_id`, where Django keeps its key.
//   author = models.ForeignKey(Author, ...)         dj_attname(<Book>, "author", "author"), dj_attname(<Book>, "author_id", "author")
.decl dj_attname(c: node, a: symbol, x: symbol)
dj_attname(c, x, x) :- dj_has_field(c, x, _).
dj_attname(c, cat(x, "_id"), x) :- dj_has_field(c, x, t), dj_fk_class(t).
// dj_number_field(t): the field classes whose values are numbers a counter is kept in (DurationField aside).
.decl dj_number_field(t: symbol)
dj_number_field("IntegerField"). dj_number_field("SmallIntegerField"). dj_number_field("BigIntegerField").
dj_number_field("PositiveIntegerField"). dj_number_field("PositiveSmallIntegerField").
dj_number_field("PositiveBigIntegerField"). dj_number_field("DecimalField"). dj_number_field("FloatField").
.decl dj_model_method(c: node, f: node, x: symbol)
dj_model_method(c, f, x) :- dj_model(c), kind(f, "function_definition"), nearest(f, c, scope), field(c, "body", b),
    within(f, b), def_name(f, x).

// ---- querysets ---------------------------------------------------------------------------------------------------
// dj_manager, dj_qs, dj_qs_root: python/django-shared (the phase py_names reads a view's queryset too).
.decl dj_qs_call(c: node, m: symbol)
dj_qs_call(c, m) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m), dj_qs(o).
// dj_qs_model(q, r): queryset chain q starts at `M.objects` with r, in q's own file, naming M, a model class of the
// run (dj_model_named), so its rows are M's: what a user reads of M it reads through r (dj_model_field, …).
// dj_qs_class(q, mq): the same, by the model class's qualified name.
//   Book.objects.filter(a=1)                        dj_qs_model(<the chain>, <Book>),
//                                                   dj_qs_class(<the chain>, "shop.models.Book")
.decl dj_qs_model(q: node, r: node)
dj_qs_model(q, r) :- dj_qs_root(q, r), dj_model_named(r, _).
.decl dj_qs_class(q: node, mq: symbol)
dj_qs_class(q, mq) :- dj_qs_root(q, r), dj_model_named(r, mq).
// dj_qs_has(q, m): queryset chain q calls method m somewhere along it (q's own last call included).
//   Book.objects.values("id").filter(a=1)          dj_qs_has(<the chain>, "values"), dj_qs_has(_, "filter")
.decl dj_qs_has(q: node, m: symbol)
dj_qs_has(q, m) :- dj_qs_call(q, m), dj_qs(q).
dj_qs_has(q, m) :- dj_qs(q), kind(q, "call"), field(q, "function", f), attr_of(f, o, _), dj_qs_has(o, m).
// dj_row_method(m): QuerySet methods that return one row (a model instance, unless after values()).
.decl dj_row_method(m: symbol)
dj_row_method("get"). dj_row_method("create"). dj_row_method("first"). dj_row_method("last").
dj_row_method("earliest"). dj_row_method("latest").

// ---- instances ---------------------------------------------------------------------------------------------------
// dj_fetch_call(c, mq): call c returns one row of model class mq from its manager: `M.objects….get()` (or
// create, first, last, earliest, latest, and their async twins aget, acreate, ...).
//   Book.objects.filter(a=1).afirst()               dj_fetch_call(<the call>, "shop.models.Book")
.decl dj_fetch_call(c: node, mq: symbol)
dj_fetch_call(c, mq) :- dj_qs_call(c, m), (dj_row_method(m) ; dj_row_method(b), m = cat("a", b)),
    field(c, "function", fn), attr_of(fn, o, _), dj_qs_class(o, mq).
// dj_instance_class(r, h, mq): identifier r, read in scope h, holds an instance of model class mq: `self` in a method
// of mq, or a name h assigns from `MQ(...)` or from a fetch (dj_fetch_call), awaited or not. The type program
// (python/types) does not know what a manager returns; this is what it misses.
//   def touch(pk): book = Book.objects.get(pk=pk); book.save()   dj_instance_class(<book in book.save>, <touch>, "shop.models.Book")
.decl dj_instance_class(r: node, h: node, mq: symbol)
dj_instance_class(r, h, mq) :- kind(r, "identifier"), text(r, "self"), dj_model_method(k, h, _), look(r, "self", h),
    class_def(k, mq).
dj_instance_class(r, h, mq) :- kind(r, "identifier"), text(r, o), look(r, o, h), asg(h, o, v, _),
    dj_instance_value(v, mq).
// dj_instance_value(v, mq): expression v makes or fetches one instance of model class mq.
.decl dj_instance_value(v: node, mq: symbol)
dj_instance_value(v, mq) :- unparen(v, c), dj_fetch_call(c, mq).
dj_instance_value(v, mq) :- unparen(v, w), kind(w, "await"), child(w, c, 0), dj_fetch_call(c, mq).
dj_instance_value(v, mq) :- unparen(v, c), kind(c, "call"), field(c, "function", fn), sym_of(fn, mq), class_def(k, mq),
    dj_model(k).

// ---- transactions ------------------------------------------------------------------------------------------------
.decl dj_atomic(e: node)
dj_atomic(e) :- sym_of(e, "django.db.transaction.atomic").
dj_atomic(e) :- kind(e, "call"), field(e, "function", f), sym_of(f, "django.db.transaction.atomic").
.decl dj_atomic_with(w: node, b: node)
dj_atomic_with(w, b) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", v), unparen(v, e), dj_atomic(e), field(w, "body", b).
// `with transaction.atomic() as sid:` puts the call under an as_pattern.
dj_atomic_with(w, b) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", ap), kind(ap, "as_pattern"), child(ap, v, 0), unparen(v, e), dj_atomic(e),
    field(w, "body", b).
.decl dj_atomic_def(f: node)
dj_atomic_def(f) :- kind(f, "function_definition"), decorator(f, e), unparen(e, m), dj_atomic(m).
// dj_region_stop: a node of these kinds ends an atomic region: code in a nested def, lambda or class runs later.
// Also the stop set for "the def this code runs in": nearest(n, f, dj_region_stop).
.decl dj_region_stop(k: symbol)
dj_region_stop("function_definition"). dj_region_stop("lambda"). dj_region_stop("class_definition").
.decl dj_in_atomic(n: node, a: node)
dj_in_atomic(n, b) :- dj_atomic_with(_, b), within_stop(n, b, dj_region_stop).
dj_in_atomic(n, f) :- dj_atomic_def(f), field(f, "body", b), within_stop(n, b, dj_region_stop).
// dj_atomic_like_with(w, b): with-statement w's item calls a wrapper named like atomic, not atomic itself (Saleor's
// `traced_atomic_transaction()`, label-studio's `conditional_atomic(...)`), which opens a transaction around b.
.decl dj_atomic_like_with(w: node, b: node)
dj_atomic_like_with(w, b) :- kind(w, "with_statement"), child(w, wc, _), kind(wc, "with_clause"), child(wc, wi, _),
    kind(wi, "with_item"), field(wi, "value", v), unparen(v, e), kind(e, "call"), call_name(e, x),
    contains("atomic", x), !dj_atomic(e), field(w, "body", b).
// dj_in_transaction(n): n runs in a transaction opened in its own function: inside atomic (dj_in_atomic), or in the
// body of a dj_atomic_like_with, with no nested def, lambda or class between.
//   with traced_atomic_transaction(): order.save()   dj_in_transaction(<order.save()>)
.decl dj_in_transaction(n: node)
dj_in_transaction(n) :- dj_in_atomic(n, _).
dj_in_transaction(n) :- dj_atomic_like_with(_, b), within_stop(n, b, dj_region_stop).
// dj_atomic_requests_value(v): outside test code, v is the value a settings file gives a database's ATOMIC_REQUESTS:
// a dict entry (`"ATOMIC_REQUESTS": True`), `DATABASES["default"]["ATOMIC_REQUESTS"] = v`, or `dict(ATOMIC_REQUESTS=v)`.
// A top-level `ATOMIC_REQUESTS = True` is no Django setting.
// dj_atomic_requests(): some such value is the literal True, so Django runs every sync view in a transaction.
.decl dj_atomic_requests_value(v: node)
dj_atomic_requests_value(v) :- kind(p, "pair"), field(p, "key", k), str(k, "ATOMIC_REQUESTS"), field(p, "value", v),
    docof(p, d), !dj_test_doc(d).
dj_atomic_requests_value(v) :- kind(a, "assignment"), field(a, "left", l), kind(l, "subscript"),
    field(l, "subscript", s), str(s, "ATOMIC_REQUESTS"), field(a, "right", v), docof(a, d), !dj_test_doc(d).
dj_atomic_requests_value(v) :- call_arg(_, -1, "ATOMIC_REQUESTS", v), docof(v, d), !dj_test_doc(d).
.decl dj_atomic_requests()
dj_atomic_requests() :- dj_atomic_requests_value(v), kind(v, "true").

// ---- side effects ------------------------------------------------------------------------------------------------
// What a transaction must not run before it commits: enqueuing a task, sending mail. The rules that report them
// (enqueue-on-commit inside atomic, dispatch-in-atomic-request under ATOMIC_REQUESTS) agree through these relations on
// what a dispatch is and which ones stay where they are.
// dj_side_effect(c, what): call c enqueues a task or sends mail; what names it for a message: a Celery `.delay()`,
// `.apply_async()`, `app.send_task()`, a Django 6 task `.enqueue()`/`.aenqueue()` on something that can be a task
// (dj_task_ref), django-q's `async_task()`, django.core.mail's send_mail, send_mass_mail, mail_admins,
// mail_managers, and an EmailMessage's `.send()`.
//   notify_order.delay(order.pk)                    dj_side_effect(<the call>, ".delay()")
//   client.delay(2.0)        (client a parameter)   not dj_side_effect: not known to be a task
.decl dj_task_method(m: symbol)
dj_task_method("delay"). dj_task_method("apply_async"). dj_task_method("send_task").
dj_task_method("enqueue"). dj_task_method("aenqueue").
.decl dj_mail_fn(q: symbol)
dj_mail_fn("django.core.mail.send_mail"). dj_mail_fn("django.core.mail.send_mass_mail").
dj_mail_fn("django.core.mail.mail_admins"). dj_mail_fn("django.core.mail.mail_managers").
dj_mail_fn("django_q.tasks.async_task").
.decl dj_message_class(q: symbol)
dj_message_class("django.core.mail.EmailMessage"). dj_message_class("django.core.mail.EmailMultiAlternatives").
dj_message_class("django.core.mail.message.EmailMessage").
dj_message_class("django.core.mail.message.EmailMultiAlternatives").
.decl dj_side_effect(c: node, what: symbol)
dj_side_effect(c, cat(cat(".", m), "()")) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m),
    dj_task_method(m), unparen(o, t), dj_task_ref(t).
dj_side_effect(c, cat(x, "()")) :- kind(c, "call"), field(c, "function", f), sym_of(f, q), dj_mail_fn(q),
    split_dot(q, _, x).
// `EmailMessage(...).send()`, or `.send()` on a name the same function binds to an EmailMessage.
dj_side_effect(c, "EmailMessage.send()") :- kind(c, "call"), field(c, "function", f), attr_of(f, o, "send"),
    unparen(o, m), dj_message(m).
dj_side_effect(c, "EmailMessage.send()") :- kind(c, "call"), field(c, "function", f), attr_of(f, o, "send"),
    kind(o, "identifier"), text(o, v), def_frame(c, fr), kind(a, "assignment"), field(a, "left", l), text(l, v),
    field(a, "right", r), dj_message(r), def_frame(a, fr).
.decl dj_message(m: node)
dj_message(m) :- kind(m, "call"), field(m, "function", f), sym_of(f, q), dj_message_class(q).
// dj_task_ref(t): t can be a task: a name that resolves through an import or a module attribute (`notify_order`,
// `tasks.notify_order`, `current_app`), other than a plain function of the run with no decorator, or a call on one
// (`notify_order.s(1)`, `task.using(priority=1)`). A parameter or local (`client.delay(2.0)`) is not one.
.decl dj_task_ref(t: node)
dj_task_ref(t) :- sym_of(t, q), docof(t, d), !dj_plain_at(d, q).
dj_task_ref(t) :- attr_of(t, o, _), unparen(o, u), dj_task_ref(u).
dj_task_ref(t) :- kind(t, "call"), field(t, "function", f), attr_of(f, o, _), unparen(o, u), dj_task_ref(u).
// dj_plain_at(d, q): q is a def with no decorator, of a module document d reads (the phase py_names' plain_def).
.decl dj_plain_at(d: number, q: symbol)
dj_plain_at(d, q) :- doc(d, p, _), py_names__reads_at(p, m), py_names__plain_def(m, q).
// dj_task_waits_for_commit(c): c is `t.delay(...)`/`t.apply_async(...)` on a task t of the run whose decorator names
// a task class `base=X`, where X's own (or inherited) apply_async or delay calls transaction.on_commit (pretix's
// TransactionAwareTask); or the run's Celery app makes such a class every task's class (addons-server's AMOTask,
// `Celery(..., task_cls=AMOTask)`). Such a call already waits for the commit. The task, its class and the app are in
// any file: the phase py_names joins them by symbol (dj_deferred_task, dj_app_defers), read through the modules the
// call's file reads (decision 0677).
.decl py_names__dj_deferred_task(m: symbol, f: symbol)
.decl py_names__dj_app_defers(m: symbol)
// py_names__dj_view_model(m, q, s): class q of module m, or an ancestor of the run, says `model = S` or
// `queryset = S.objects…` in its body (get-handler-writes' view over S).
.decl py_names__dj_view_model(m: symbol, q: symbol, s: symbol)
// py_names__dj_task_def(m, f): function f of module m is decorated as a Celery task (`@shared_task`, `@app.task(...)`,
// `@task`).
.decl py_names__dj_task_def(m: symbol, f: symbol)
// py_names__dj_anc_clean_call(m, q, x): a class of the run among class q's ancestors calls `self.x()`, x a clean_…
// method (django-practice-clean-field-returns-value).
.decl py_names__dj_anc_clean_call(m: symbol, q: symbol, x: symbol)
.decl dj_task_waits_for_commit(c: node)
dj_task_waits_for_commit(c) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m),
    (m = "delay" ; m = "apply_async"), sym_of(o, q), docof(c, d), doc(d, p, _), py_names__reads_at(p, mq),
    py_names__dj_deferred_task(mq, q).
dj_task_waits_for_commit(c) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, m),
    (m = "delay" ; m = "apply_async"), docof(c, d), dj_app_defers(d).
.decl dj_app_defers(d: number)
dj_app_defers(d) :- doc(d, p, _), py_names__reads_at(p, m), py_names__dj_app_defers(m).
// dj_dispatch_in_failing_handler(c): side effect c sits in an except handler that always re-raises
// (py_reraising_handler): the transaction rolls back, so an on_commit callback would never run (a failure mail or
// error task belongs there).
.decl dj_dispatch_in_failing_handler(c: node)
dj_dispatch_in_failing_handler(c) :- dj_side_effect(c, _), kind(x, "except_clause"), within(c, x),
    py_reraising_handler(x).
// dj_dispatch_result_used(c): `r = <task>.apply_async(...)` whose result r the same function reads afterwards (the
// task id is stored on a row, or the result awaited): on_commit returns nothing, so the call cannot simply move there.
.decl dj_dispatch_result_used(c: node)
dj_dispatch_result_used(c) :- dj_side_effect(c, _), kind(a, "assignment"), field(a, "right", r), unparen(r, c),
    field(a, "left", l), kind(l, "identifier"), text(l, v), def_frame(c, fr), kind(i, "identifier"), text(i, v),
    def_frame(i, fr), i != l, earlier(l, i), !bind_only(i).

// ---- views -------------------------------------------------------------------------------------------------------
// dj_view_class(c): class c is a view: among its ancestors (python/names' class_lib_anc, through the run's classes in
// any file) is a view class Django or DRF defines (dj_lib_view). Their `…Mixin` classes supply parts of a view and
// are not views themselves.
//   django.views.generic.TemplateView               a view
//   django.views.generic.base.ContextMixin          not a view
// dj_drf_view_class(c): the same of a DRF view class.
.decl dj_view_class(c: node)
dj_view_class(c) :- dj_lib_view(c, _).
.decl dj_drf_view_class(c: node)
dj_drf_view_class(c) :- dj_lib_view(c, b), prefix("rest_framework.", b).
.decl dj_lib_view(c: node, b: symbol)
dj_lib_view(c, b) :- class_lib_anc(c, b), !suffix("Mixin", b), (prefix("django.views.", b) ;
    prefix("django.contrib.auth.views.", b), suffix("View", b) ; prefix("rest_framework.views.", b) ;
    prefix("rest_framework.generics.", b) ; prefix("rest_framework.viewsets.", b)).

// ---- files and settings ------------------------------------------------------------------------------------------
.decl dj_migration_doc(d: number)
dj_migration_doc(d) :- class_def(c, _), def_name(c, "Migration"), class_base(c, "django.db.migrations.Migration"),
    docof(c, d).
// dj_django_doc(d): document d imports Django or Django REST framework (an `import` or `from … import`, a star import
// included), so names such as `request.user` or `X.objects` in it are likely Django's: a gate for rules whose shapes
// other frameworks share (Starlette's `request.user`, mongoengine's `Document.objects`). A relative import
// (`from .models import Book`) names the project's own module and does not count.
//   from django.db import models                    dj_django_doc
//   import rest_framework.views                     dj_django_doc
//   from starlette.requests import Request          not dj_django_doc (alone)
.decl dj_django_doc(d: number)
dj_django_doc(d) :- dj_import_module(i, m), (m = "django" ; prefix("django.", m) ; m = "rest_framework" ;
    prefix("rest_framework.", m)), docof(i, d).
// dj_import_module(i, m): import statement i names module m (`import m`, `from m import x`, `from m import *`).
.decl dj_import_module(i: node, m: symbol)
dj_import_module(i, m) :- import_alias(i, _, m, _, _).
dj_import_module(i, m) :- kind(i, "import_from_statement"), module_text(i, m).
.decl dj_settings(e: node)
dj_settings(e) :- sym_of(e, "django.conf.settings").

// ---- migrations --------------------------------------------------------------------------------------------------
// A migration file's `Migration` class, its operations in order, the arguments of each by name, the model and field
// each one touches, the RunPython functions it runs, and the order of the migrations of one app. Operation classes
// resolve through imports: `migrations.AddField`, `from django.db.migrations import AddField`,
// `django.contrib.postgres.operations.AddIndexConcurrently`. A project's own operation classes are not operations
// here.
// What joins migration files is keyed by values, never by a node or a document (decision 0691): a migration by its
// key (dj_mig_key), its package and its file name as a dependency names it; a definition of a field by that key, its
// item and the model's and field's names. The migration graph (dj_mig_dep) and a field's history (dj_field_src) are
// computed over these keys; each file reads the answers back at its own operations by its own key.
// dj_mig_class(c, d): class c is the `Migration` class (with a django.db.migrations.Migration base) of document d.
.decl dj_mig_class(c: node, d: number)
dj_mig_class(c, d) :- class_def(c, _), def_name(c, "Migration"), class_base(c, "django.db.migrations.Migration"),
    docof(c, d).
// dj_mig_key(d, q): migration d's key: its package and its file name without `.py`, as a dependency names it
// (`shop/migrations/0003_book_isbn.py` is "shop.migrations.0003_book_isbn").
.decl dj_mig_key(d: number, q: symbol)
dj_mig_key(d, cat(k, ".", s)) :- dj_mig_class(_, d), pkg(d, k), file_name(d, f), match("(?<s>.+)\\.py", f).
// dj_key_of(n, q): node n is in migration q (by key: dj_mig_key's, for n an operation's node). A relation a file
// states by key reads its operation's key through it, which places the row in the operation's document: the key is
// made from `pkg` and `file_name` here, not read from dj_mig_key, because the lowering puts a reader's own document
// number in place of n's, and only a document relation then names the document to the split (else the relation is
// moved to the cross-file part, unlocated).
.decl dj_key_of(n: node, q: symbol)
dj_key_of(n, cat(k, ".", s)) :- docof(n, d), pkg(d, k), file_name(d, f), match("(?<s>.+)\\.py", f).
// dj_mig_attr(d, x, v): migration d's class body assigns `x = v` (`operations`, `dependencies`, `atomic`, ...).
.decl dj_mig_attr(d: number, x: symbol, v: node)
dj_mig_attr(d, x, v) :- dj_mig_class(c, d), field(c, "body", b), body_stmt(b, s, _), kind(s, "expression_statement"),
    child(s, a, 0), kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", v).
// dj_mig_nonatomic(d): migration d sets `atomic = False`, so its operations do not share one transaction.
.decl dj_mig_nonatomic(d: number)
dj_mig_nonatomic(d) :- dj_mig_attr(d, "atomic", v), kind(v, "false").
.decl dj_mig_op_module(m: symbol)
dj_mig_op_module("django.db.migrations"). dj_mig_op_module("django.db.migrations.operations").
dj_mig_op_module("django.db.migrations.operations.fields"). dj_mig_op_module("django.db.migrations.operations.models").
dj_mig_op_module("django.db.migrations.operations.special"). dj_mig_op_module("django.contrib.postgres.operations").
// dj_mig_op_call(o, k): call o constructs migration operation class k (its last name: "AddField", "RunPython").
.decl dj_mig_op_call(o: node, k: symbol)
dj_mig_op_call(o, k) :- kind(o, "call"), field(o, "function", f), sym_of(f, q), split_dot(q, m, k), dj_mig_op_module(m).
// dj_mig_op(o, k, d, i): operation o, of class k, is item i of migration d's `operations` list (or tuple).
.decl dj_mig_op(o: node, k: symbol, d: number, i: number)
dj_mig_op(o, k, d, i) :- dj_mig_attr(d, "operations", l), (kind(l, "list") ; kind(l, "tuple")), child(l, o, i),
    dj_mig_op_call(o, k).
// dj_mig_db_op(o, k, d, i): operation o changes the database: an item of the list other than
// SeparateDatabaseAndState, or one of a SeparateDatabaseAndState's database_operations (i is the
// SeparateDatabaseAndState's position). A state_operations item changes only Django's model state.
.decl dj_mig_db_op(o: node, k: symbol, d: number, i: number)
dj_mig_db_op(o, k, d, i) :- dj_mig_op(o, k, d, i), k != "SeparateDatabaseAndState".
dj_mig_db_op(o, k, d, i) :- dj_mig_op(s, "SeparateDatabaseAndState", d, i),
    (call_arg(s, -1, "database_operations", l) ; call_arg(s, 0, "", l)), (kind(l, "list") ; kind(l, "tuple")),
    child(l, o, _), dj_mig_op_call(o, k).
// dj_mig_param(k, i, x): positional parameter i of operation class k is named x (Django's signatures), so
// dj_mig_arg reads `AddField("book", "title", field)` and `AddField(model_name="book", ...)` alike.
.decl dj_mig_param(k: symbol, i: number, x: symbol)
dj_mig_param("AddField", 0, "model_name"). dj_mig_param("AddField", 1, "name"). dj_mig_param("AddField", 2, "field").
dj_mig_param("AddField", 3, "preserve_default").
dj_mig_param("AlterField", 0, "model_name"). dj_mig_param("AlterField", 1, "name"). dj_mig_param("AlterField", 2, "field").
dj_mig_param("AlterField", 3, "preserve_default").
dj_mig_param("RemoveField", 0, "model_name"). dj_mig_param("RemoveField", 1, "name").
dj_mig_param("RenameField", 0, "model_name"). dj_mig_param("RenameField", 1, "old_name").
dj_mig_param("RenameField", 2, "new_name").
dj_mig_param("CreateModel", 0, "name"). dj_mig_param("CreateModel", 1, "fields"). dj_mig_param("CreateModel", 2, "options").
dj_mig_param("CreateModel", 3, "bases"). dj_mig_param("CreateModel", 4, "managers").
dj_mig_param("DeleteModel", 0, "name").
dj_mig_param("RenameModel", 0, "old_name"). dj_mig_param("RenameModel", 1, "new_name").
dj_mig_param("AlterModelTable", 0, "name"). dj_mig_param("AlterModelTable", 1, "table").
dj_mig_param("AlterModelOptions", 0, "name"). dj_mig_param("AlterModelOptions", 1, "options").
dj_mig_param("AlterUniqueTogether", 0, "name"). dj_mig_param("AlterUniqueTogether", 1, "unique_together").
dj_mig_param("AlterIndexTogether", 0, "name"). dj_mig_param("AlterIndexTogether", 1, "index_together").
dj_mig_param("AddIndex", 0, "model_name"). dj_mig_param("AddIndex", 1, "index").
dj_mig_param("AddIndexConcurrently", 0, "model_name"). dj_mig_param("AddIndexConcurrently", 1, "index").
dj_mig_param("RemoveIndex", 0, "model_name"). dj_mig_param("RemoveIndex", 1, "name").
dj_mig_param("RenameIndex", 0, "model_name"). dj_mig_param("RenameIndex", 1, "new_name").
dj_mig_param("AddConstraint", 0, "model_name"). dj_mig_param("AddConstraint", 1, "constraint").
dj_mig_param("RemoveConstraint", 0, "model_name"). dj_mig_param("RemoveConstraint", 1, "name").
dj_mig_param("RunPython", 0, "code"). dj_mig_param("RunPython", 1, "reverse_code"). dj_mig_param("RunPython", 2, "atomic").
dj_mig_param("RunPython", 3, "hints"). dj_mig_param("RunPython", 4, "elidable").
dj_mig_param("RunSQL", 0, "sql"). dj_mig_param("RunSQL", 1, "reverse_sql"). dj_mig_param("RunSQL", 2, "state_operations").
// dj_mig_arg(o, x, v): operation o is given v for its parameter x, by keyword or by position.
.decl dj_mig_arg(o: node, x: symbol, v: node)
dj_mig_arg(o, x, v) :- dj_mig_op_call(o, _), call_arg(o, -1, x, v).
dj_mig_arg(o, x, v) :- dj_mig_op_call(o, k), dj_mig_param(k, i, x), posarg(o, i, v).
// dj_mig_model_op(k): operation classes whose `name` (not `model_name`) names the model.
.decl dj_mig_model_op(k: symbol)
dj_mig_model_op("CreateModel"). dj_mig_model_op("DeleteModel"). dj_mig_model_op("AlterModelTable").
dj_mig_model_op("AlterModelOptions"). dj_mig_model_op("AlterUniqueTogether"). dj_mig_model_op("AlterIndexTogether").
// dj_mig_model(o, m): operation o acts on the model named m, lowercased as Django keys model state
// ("orderposition" for both `CreateModel(name="OrderPosition")` and `AddField(model_name="orderposition")`); for
// RenameModel, the old name.
.decl dj_mig_model(o: node, m: symbol)
dj_mig_model(o, @lower(s)) :- dj_mig_arg(o, "model_name", v), str(v, s).
dj_mig_model(o, @lower(s)) :- dj_mig_op_call(o, k), dj_mig_model_op(k), dj_mig_arg(o, "name", v), str(v, s).
dj_mig_model(o, @lower(s)) :- dj_mig_op_call(o, "RenameModel"), dj_mig_arg(o, "old_name", v), str(v, s).
// dj_mig_field(o, x, f, t): operation o defines field x as the field call f of class t (its last name): an
// AddField or AlterField's `field`, or an item `("x", f)` of a CreateModel's `fields`.
//   migrations.AddField(model_name="book", name="isbn", field=models.CharField(max_length=13))
//                                                   dj_mig_field(<op>, "isbn", <the CharField call>, "CharField")
.decl dj_mig_field(o: node, x: symbol, f: node, t: symbol)
dj_mig_field(o, x, f, t) :- (dj_mig_op_call(o, "AddField") ; dj_mig_op_call(o, "AlterField")), dj_mig_arg(o, "name", n),
    str(n, x), dj_mig_arg(o, "field", f), dj_mig_field_class(f, t).
dj_mig_field(o, x, f, t) :- dj_mig_op_call(o, "CreateModel"), dj_mig_arg(o, "fields", l), child(l, p, _),
    kind(p, "tuple"), child(p, n, 0), str(n, x), child(p, f, 1), dj_mig_field_class(f, t).
// dj_mig_field_class(f, t): call f constructs a field of class t, by the last name of its callee (migrations
// write `models.CharField(...)` and a project's own field classes by their module path).
.decl dj_mig_field_class(f: node, t: symbol)
dj_mig_field_class(f, t) :- kind(f, "call"), field(f, "function", e), sym_of(e, q), split_dot(q, _, t).
// dj_mig_creates(d, m): migration d creates model m (lowercased), so its table is new and empty in d.
.decl dj_mig_creates(d: number, m: symbol)
dj_mig_creates(d, m) :- dj_mig_db_op(o, "CreateModel", d, _), dj_mig_model(o, m).
// dj_runpython(o, d, i, q): operation o, item i of migration d, is a RunPython whose forward code is named q (sym_of): a
// def in the migration, or imported from another module. A rule reads that def by q in the def's own file (qualname),
// so no RunPython is paired with a def node of another file.
//   migrations.RunPython(fill_slugs, migrations.RunPython.noop)   dj_runpython(<op>, d, i, "shop.migrations.0004_x.fill_slugs")
.decl dj_runpython(o: node, d: number, i: number, q: symbol)
dj_runpython(o, d, i, q) :- dj_mig_db_op(o, "RunPython", d, i), dj_mig_arg(o, "code", e), sym_of(e, q).
// dj_calls(g, h): the def of qualified name g calls h by name (sym_of), a def of the run that g's file can name (the
// phase py_names' `defined`), anywhere in g's body (nested defs and lambdas included). Stated in g's file by symbols,
// so a rule joins h's own facts, stated in h's file under its qualname, without a node of either crossing.
.decl dj_calls(g: symbol, h: symbol)
dj_calls(gq, hq) :- kind(g, "function_definition"), qualname(g, gq), kind(c, "call"), within(c, g),
    field(c, "function", e), sym_of(e, hq), docof(c, d), doc(d, p, _), py_names__reads_at(p, m),
    py_names__defined(m, hq).
// ---- the migration graph, by key ----
// dj_mig_dep_name(d, x): migration d lists `(<app>, x)` among its dependencies.
.decl dj_mig_dep_name(d: number, x: symbol)
dj_mig_dep_name(d, x) :- dj_mig_attr(d, "dependencies", l), child(l, p, _), kind(p, "tuple"), child(p, n, 1), str(n, x).
// dj_mig_replaces(s, x): squashed migration s lists `(<app>, x)` in its `replaces`.
.decl dj_mig_replaces(s: number, x: symbol)
dj_mig_replaces(s, x) :- dj_mig_attr(s, "replaces", l), child(l, p, _), kind(p, "tuple"), child(p, n, 1), str(n, x).
// dj_mig_squashes(s, a): squashed migration s (by key) replaces migration a of its package (by key).
.decl dj_mig_squashes(s: symbol, a: symbol)
dj_mig_squashes(s, cat(k, ".", x)) :- dj_mig_replaces(e, x), dj_mig_key(e, s), pkg(e, k).
// dj_mig_dep(a, b): migration a runs after migration b of its own package (both by key): a lists b, a migration of the
// run, among its dependencies (`("shop", "0003_book_isbn")` names `shop/migrations/0003_book_isbn.py`, by file name
// within a's package); or a lists a migration that squashed migration b replaces, unless b replaces a itself (Django
// reads the dependency as the squash when it uses the squash; the replaced file may be gone).
// Declared cross_file: the migration graph of an app joins its migration files, which name each other by package and
// file name. It holds keys alone, so an edit of a migration changes it only when its dependencies or replaces change.
.decl dj_mig_dep(a: symbol, b: symbol) cross_file
dj_mig_dep(a, b) :- dj_mig_dep_name(d, x), dj_mig_key(d, a), pkg(d, k), b = cat(k, ".", x), dj_mig_key(_, b).
dj_mig_dep(a, s) :- dj_mig_dep_name(d, x), dj_mig_key(d, a), pkg(d, k), dj_mig_squashes(s, cat(k, ".", x)),
    !dj_mig_squashes(s, a).
// dj_mig_ran_before(b, a): migration b is applied before a (by key): dj_mig_dep, transitively. pretix depends on
// `0050_orderposition_positionid`, which `0050_…_squashed_0061_event_location` replaces. A migration the squash itself
// replaces never comes after it: pretix's `0120_…` sits inside `0108_…_squashed_0141_…`, whose operations hold 0120's
// own and later changes.
.decl dj_mig_ran_before(b: symbol, a: symbol)
dj_mig_ran_before(b, a) :- dj_mig_dep(a, b).
dj_mig_ran_before(b, a) :- dj_mig_dep(a, m), dj_mig_ran_before(b, m).
// ---- a field's history: the nearest earlier definition of a field, by key ----
// dj_field_op(o, k, d, i): the operations that define a field: dj_mig_db_op, and a SeparateDatabaseAndState's
// state_operations (Django's model state, which the database usually matches through a RunSQL beside it); test
// migrations left out.
.decl dj_field_op(o: node, k: symbol, d: number, i: number)
dj_field_op(o, k, d, i) :- dj_mig_db_op(o, k, d, i), !dj_test_doc(d).
dj_field_op(o, k, d, i) :- dj_mig_op(s, "SeparateDatabaseAndState", d, i), !dj_test_doc(d),
    (call_arg(s, -1, "state_operations", l) ; call_arg(s, 1, "", l)), (kind(l, "list") ; kind(l, "tuple")),
    child(l, o, _), dj_mig_op_call(o, k).
// dj_field_def(p, d, i, m, x): operation p, item i of migration d, defines field x of model m: an AddField, an
// AlterField, a CreateModel `fields` item, or a RenameField onto x (whose field is the old name's, followed back).
.decl dj_field_def(p: node, d: number, i: number, m: symbol, x: symbol)
dj_field_def(p, d, i, m, x) :- dj_field_op(p, k, d, i), (k = "AddField" ; k = "AlterField"), dj_mig_model(p, m),
    dj_mig_arg(p, "name", n), str(n, x).
dj_field_def(p, d, i, m, x) :- dj_field_op(p, "CreateModel", d, i), dj_mig_model(p, m), dj_mig_arg(p, "fields", l),
    child(l, t, _), kind(t, "tuple"), child(t, n, 0), str(n, x).
dj_field_def(p, d, i, m, x) :- dj_field_op(p, "RenameField", d, i), dj_mig_model(p, m), dj_mig_arg(p, "new_name", n),
    str(n, x).
// dj_alterfield(o, d, i, m, x): AlterField o, item i of migration d (not test code), changes field x of model m.
.decl dj_alterfield(o: node, d: number, i: number, m: symbol, x: symbol)
dj_alterfield(o, d, i, m, x) :- dj_mig_db_op(o, "AlterField", d, i), !dj_test_doc(d), dj_mig_model(o, m),
    dj_mig_arg(o, "name", n), str(n, x).
// The same, by key, for the history: dj_field_def_at(e, j, m, x), item j of migration e defines field x of model m;
// dj_field_called(e, j, m, x), with a field call (not a RenameField); dj_field_renamed(e, j, m, x, y), by a RenameField
// of m's field y onto x.
.decl dj_field_def_at(e: symbol, j: number, m: symbol, x: symbol)
dj_field_def_at(e, j, m, x) :- dj_field_def(p, _, j, m, x), dj_key_of(p, e).
.decl dj_field_called(e: symbol, j: number, m: symbol, x: symbol)
dj_field_called(e, j, m, x) :- dj_field_def(p, _, j, m, x), dj_mig_field(p, x, _, _), dj_key_of(p, e).
.decl dj_field_renamed(e: symbol, j: number, m: symbol, x: symbol, y: symbol)
dj_field_renamed(e, j, m, x, y) :- dj_field_op(p, "RenameField", _, j), dj_mig_model(p, m), dj_mig_arg(p, "new_name", n),
    str(n, x), dj_mig_arg(p, "old_name", o), str(o, y), dj_key_of(p, e).
// dj_pk_def(e, j, m, x): item j of migration e defines field x of model m (lowercased) with `primary_key=True`: m's key
// there. dj_pk_name(m, x): field x is model m's primary key in some migration of the run.
.decl dj_pk_def(e: symbol, j: number, m: symbol, x: symbol)
dj_pk_def(e, j, m, x) :- dj_field_def(p, _, j, m, x), dj_mig_field(p, x, f, _), call_arg(f, -1, "primary_key", v),
    kind(v, "true"), dj_key_of(p, e).
.decl dj_pk_name(m: symbol, x: symbol)
dj_pk_name(m, x) :- dj_pk_def(_, _, m, x).
// dj_field_rel(e, j, t): a definition at item j of migration e is a ForeignKey or OneToOneField call to model t.
.decl dj_field_rel(e: symbol, j: number, t: symbol)
dj_field_rel(e, j, t) :- dj_field_def(p, _, j, _, y), dj_mig_field(p, y, f, _), dj_fk_target(f, t), dj_key_of(p, e).
// dj_field_point(d, i, m, x): the points of migration d whose field history is read: an AlterField at item i (its
// field x of model m); a RenameField at item i (its old name x, whose definition the new name carries on); and a
// relation call defined at item i, for its target model m's primary key x (the key's type at that point is the
// relation column's).
// Declared cross_file: a relation's point names its target's key, which any migration of the run may define
// (dj_pk_name); it holds keys, item numbers and names alone.
.decl dj_field_point(d: symbol, i: number, m: symbol, x: symbol) cross_file
dj_field_point(d, i, m, x) :- dj_alterfield(o, _, i, m, x), dj_key_of(o, d).
dj_field_point(d, i, m, y) :- dj_field_renamed(d, i, m, _, y).
dj_field_point(d, i, t, x) :- dj_field_rel(d, i, t), dj_pk_name(t, x).
// dj_field_prev(d, i, m, x, e, j): definition item j of migration e comes before point (d, i) of model m's field x: in a
// migration applied before d (dj_mig_ran_before), or earlier in d.
// Declared cross_file: a field's history joins the definitions of every migration of its app, by key and name; it
// holds keys, item numbers and names alone.
.decl dj_field_prev(d: symbol, i: number, m: symbol, x: symbol, e: symbol, j: number) cross_file
dj_field_prev(d, i, m, x, e, j) :- dj_field_point(d, i, m, x), dj_field_def_at(e, j, m, x), dj_mig_ran_before(e, d).
dj_field_prev(d, i, m, x, d, j) :- dj_field_point(d, i, m, x), dj_field_def_at(d, j, m, x), j < i.
// dj_field_shadowed(d, i, m, x, e, j): another earlier definition comes after (e, j), so (e, j) is not the field's
// definition at point (d, i).
.decl dj_field_shadowed(d: symbol, i: number, m: symbol, x: symbol, e: symbol, j: number)
dj_field_shadowed(d, i, m, x, e, j) :- dj_field_prev(d, i, m, x, e, j), dj_field_prev(d, i, m, x, e2, _),
    dj_mig_ran_before(e, e2).
dj_field_shadowed(d, i, m, x, e, j) :- dj_field_prev(d, i, m, x, e, j), dj_field_prev(d, i, m, x, e, j2), j2 > j.
// dj_field_src(d, i, m, x, e, j, y): model m's field x at point (d, i) is the field call that item j of migration e
// gives m's field y: its nearest earlier definition, followed back through a RenameField onto the name (y the name
// before the rename). A rule reads that call's class and arguments as values its own descriptions of e's definitions
// state, by this key.
//   CreateModel("order", [("id", models.AutoField(...))]) … AlterField("order", "id", models.BigAutoField(...))
//                                                   dj_field_src(<the AlterField's key>, i, "order", "id", "shop.migrations.0001_initial", 0, "id")
.decl dj_field_src(d: symbol, i: number, m: symbol, x: symbol, e: symbol, j: number, y: symbol)
dj_field_src(d, i, m, x, e, j, x) :- dj_field_prev(d, i, m, x, e, j), !dj_field_shadowed(d, i, m, x, e, j),
    dj_field_called(e, j, m, x).
dj_field_src(d, i, m, x, e2, j2, y2) :- dj_field_prev(d, i, m, x, e, j), !dj_field_shadowed(d, i, m, x, e, j),
    dj_field_renamed(e, j, m, x, y), dj_field_src(e, j, m, y, e2, j2, y2).
// dj_fk_target(f, m): relation field call f (ForeignKey, OneToOneField) points at model m (lowercased): `to="app.M"`,
// `to="M"`, or the first positional argument as a string.
.decl dj_fk_target(f: node, m: symbol)
dj_fk_target(f, @lower(n)) :- dj_mig_field_class(f, t), dj_fk_class(t), (call_arg(f, -1, "to", v) ; posarg(f, 0, v)),
    str(v, s), split_dot(s, _, n).
dj_fk_target(f, @lower(s)) :- dj_mig_field_class(f, t), dj_fk_class(t), (call_arg(f, -1, "to", v) ; posarg(f, 0, v)),
    str(v, s), !contains(".", s).
// ---- the database the run configures, and one-row tables: facts about the whole repository ----
// dj_db_string(n, b): string n names database backend b: "mysql" (an ENGINE "django.db.backends.mysql" or a
// "mysql://" URL) or "postgresql" (a PostgreSQL or PostGIS ENGINE or URL).
.decl dj_db_string(n: node, b: symbol)
dj_db_string(n, "mysql") :- kind(n, "string"), str(n, s), (s = "django.db.backends.mysql" ; prefix("mysql://", s)).
dj_db_string(n, "postgresql") :- kind(n, "string"), str(n, s), (prefix("django.db.backends.postgresql", s) ;
    prefix("django.contrib.gis.db.backends.postgis", s) ; prefix("postgres://", s) ; prefix("postgresql://", s) ;
    prefix("postgis://", s)).
// dj_pg_named(): some file of the run names a PostgreSQL database. dj_mysql_only(): the run configures MySQL and names
// no PostgreSQL database. MySQL commits each DDL statement at once and has its own rules for which ALTERs copy a
// table, so the PostgreSQL lock and transaction hazards do not apply as stated.
// Declared cross_file: each is a fact about every file of the repository (an existence and its negation), and holds
// nothing; a rule tests it in its output, at its own node.
.decl dj_pg_named() cross_file
dj_pg_named() :- dj_db_string(_, "postgresql").
.decl dj_mysql_only() cross_file
dj_mysql_only() :- dj_db_string(_, "mysql"), !dj_pg_named().
// dj_live_doc(d): document d is application code: not a migration, and no part of its path names tests
// (`tests_e2e/`, `e2e_test_form.py` included, which dj_test_doc does not cover).
.decl dj_live_doc(d: number)
dj_live_doc(d) :- doc(d, p, _), !dj_test_doc(d), !dj_migration_doc(d), !contains("test", p).
// dj_one_row(m): application code reads model M (lowercased m) as its single row (dj_one_row_at), or the current
// site's row through the related name of a OneToOneField model M declares (dj_site_row_rel, dj_o2o_related). M's table
// is a settings table of one row, so a value shared by its rows or a lock held over them costs nothing.
// Declared cross_file: the reads are in any file of the application, and the OneToOneField of the per-site row in
// its models' file; it holds lowercased model names alone, which a rule tests in its output.
//   if System_Settings.objects.get().enable_jira:      dj_one_row("system_settings")
.decl dj_one_row(m: symbol) cross_file
dj_one_row(m) :- dj_one_row_at(_, m).
dj_one_row(@lower(n)) :- dj_site_row_rel(_, rel), dj_o2o_related(_, rel, n).
// dj_one_row_at(c, m): call c, in application code, reads model M (lowercased m) as its one row: `M.objects.get()` or
// `M.objects.all().get()` with no arguments (two rows would raise MultipleObjectsReturned); the lazy singleton,
// `M.objects.first()` (or `.all().first()`) with no arguments in a function that also creates an M when there is none
// (paperless's `ApplicationConfiguration`: `first()`, then `create()`); or django-solo's `M.get_solo()`. A bare
// `first()` is no such sign: it reads one row of many (saleor's `Product.objects.first()` in an example file).
.decl dj_one_row_at(c: node, m: symbol)
dj_one_row_at(c, @lower(n)) :- kind(c, "call"), field(c, "function", fe), attr_of(fe, q, "get"), py_no_args(c),
    dj_one_row_qs(q, r), kind(r, "identifier"), text(r, n), docof(c, d), dj_live_doc(d).
dj_one_row_at(c, @lower(n)) :- kind(c, "call"), field(c, "function", fe), attr_of(fe, q, "first"), py_no_args(c),
    dj_one_row_qs(q, r), kind(r, "identifier"), text(r, n), docof(c, d), dj_live_doc(d), nearest(c, h, fdef),
    kind(k, "call"), nearest(k, h, fdef), field(k, "function", ke), (attr_of(ke, km, "create") ;
    attr_of(ke, km, "get_or_create")), dj_manager(km), attr_of(km, kr, _), kind(kr, "identifier"), text(kr, n).
dj_one_row_at(c, @lower(n)) :- kind(c, "call"), field(c, "function", fe), attr_of(fe, r, "get_solo"),
    kind(r, "identifier"), text(r, n), docof(c, d), dj_live_doc(d).
// dj_site_row_rel(a, rel): application code reads the current site's row through related name rel:
// `Site.objects.get_current().<rel>` (saleor's `SiteSettings`). dj_o2o_related(c, rel, n): model c, named n, declares a
// OneToOneField with `related_name=rel`.
.decl dj_site_row_rel(a: node, rel: symbol)
dj_site_row_rel(a, rel) :- kind(a, "attribute"), attr_of(a, g, rel), kind(g, "call"), field(g, "function", fe),
    attr_of(fe, q, "get_current"), dj_manager(q), docof(a, d), dj_live_doc(d).
.decl dj_o2o_related(c: node, rel: symbol, n: symbol)
dj_o2o_related(c, rel, n) :- dj_field(c, _, call, "OneToOneField"), call_arg(call, -1, "related_name", rv), str(rv, rel),
    field(c, "name", cn), text(cn, n).
// dj_one_row_qs(q, r): q is `r.objects` or `r.objects.all()`.
.decl dj_one_row_qs(q: node, r: node)
dj_one_row_qs(q, r) :- dj_manager(q), attr_of(q, r, _).
dj_one_row_qs(q, r) :- kind(q, "call"), py_no_args(q), field(q, "function", f), attr_of(f, m, "all"), dj_manager(m),
    attr_of(m, r, _).

// ---- python tests ------------------------------------------------------------------------------------------------
// Not Django's, but read the same way by several django-practice rules (python/ruff's bool_test, without
// including that library).
// py_truth(e): e is read only for its truth: the test of an if, elif, while, assert, conditional expression or
// comprehension `if`, the operand of `not`, the argument of `bool()`, or an operand of `and`/`or` that is itself one.
//   if not qs and ready: ...                        py_truth(<not qs and ready>), py_truth(<not qs>),
//                                                   py_truth(<qs>), py_truth(<ready>)
.decl py_truth(e: node)
py_truth(m) :- (kind(s, "if_statement") ; kind(s, "elif_clause") ; kind(s, "while_statement")),
    field(s, "condition", c), unparen(c, m).
py_truth(m) :- kind(s, "assert_statement"), child(s, c, 0), unparen(c, m).
py_truth(m) :- kind(s, "conditional_expression"), child(s, c, 1), unparen(c, m).
py_truth(m) :- kind(s, "if_clause"), child(s, c, 0), unparen(c, m).
py_truth(m) :- kind(s, "not_operator"), field(s, "argument", c), unparen(c, m).
py_truth(m) :- kind(s, "call"), field(s, "function", f), sym_of(f, "builtins.bool"), posarg(s, 0, c),
    !posarg(s, 1, _), unparen(c, m).
py_truth(m) :- py_truth(t), kind(t, "boolean_operator"), (field(t, "left", c) ; field(t, "right", c)), unparen(c, m).
// py_empty_cmp(c, x): comparison c (not a chained one) tests the number x against 0 or 1 so that it holds exactly
// when x is 0 or exactly when x is not: `x op k` with py_empty_op(op, k), or `k op x` with py_empty_op_r(op, k).
//   n > 0, n != 0, n >= 1, n == 0, n < 1, n <= 0, 0 < n, 1 > n   py_empty_cmp(_, <n>)
//   n > 5, n == 1, 0 < n < 9                                   not py_empty_cmp
.decl py_empty_cmp(c: node, x: node)
py_empty_cmp(c, x) :- kind(c, "comparison_operator"), !op_at(c, 1, _), cmp_pair(c, 0, o, l, r), unparen(l, x),
    kind(r, "integer"), text(r, k), py_empty_op(o, k).
py_empty_cmp(c, x) :- kind(c, "comparison_operator"), !op_at(c, 1, _), cmp_pair(c, 0, o, l, r), unparen(r, x),
    kind(l, "integer"), text(l, k), py_empty_op_r(o, k).
.decl py_empty_op(op: symbol, k: symbol)
py_empty_op(">", "0"). py_empty_op("!=", "0"). py_empty_op(">=", "1").
py_empty_op("==", "0"). py_empty_op("<", "1"). py_empty_op("<=", "0").
.decl py_empty_op_r(op: symbol, k: symbol)
py_empty_op_r("<", "0"). py_empty_op_r("!=", "0"). py_empty_op_r("<=", "1").
py_empty_op_r("==", "0"). py_empty_op_r(">", "1"). py_empty_op_r(">=", "0").
// py_empty_test(x): the number x is only tested for being 0: py_empty_cmp, or read for its truth.
//   if len(rows): ...                               py_empty_test(<len(rows)>)
.decl py_empty_test(x: node)
py_empty_test(x) :- py_empty_cmp(_, x).
py_empty_test(x) :- py_truth(x).
// py_no_args(c): call c passes no argument (comments aside).
//   qs.count()                                      py_no_args
//   qs.count(  # rows\n)                            py_no_args
//   cache.count("k")                                not py_no_args
.decl py_no_args(c: node)
py_no_args(c) :- kind(c, "call"), field(c, "arguments", al), !py_arg_item(al).
.decl py_arg_item(al: node)
py_arg_item(al) :- child(al, a, _), !kind(a, "comment").
// py_reraising_handler(x): every path through except clause x's handler ends in `raise`, so the exception still
// leaves the try (and rolls back an atomic block around it). A path is followed through the handler's last
// statement: a `raise`, or an if/elif/else (with an else) all of whose branches end so; a raise inside a nested
// try, with or match counts as not raising.
//   except IntegrityError: log(e); raise                          py_reraising_handler
//   except IntegrityError: if retry: raise  (no else)             not py_reraising_handler
.decl py_reraising_handler(x: node)
py_reraising_handler(x) :- kind(x, "except_clause"), child(x, hb, _), kind(hb, "block"), !py_may_end(hb).
// py_raise_block(b): the blocks py_may_end judges: a handler's, and recursively the branches of an if that is the
// last statement of one.
.decl py_raise_block(b: node)
py_raise_block(b) :- kind(x, "except_clause"), child(x, b, _), kind(b, "block").
py_raise_block(b) :- py_raise_block(p), body_len(p, k), j = k - 1, body_stmt(p, s, j), kind(s, "if_statement"),
    py_if_branch(s, b).
// py_if_branch(s, b): b is a branch of if statement s: its consequence, an elif's, or the else body.
.decl py_if_branch(s: node, b: node)
py_if_branch(s, b) :- kind(s, "if_statement"), field(s, "consequence", b).
py_if_branch(s, b) :- kind(s, "if_statement"), field(s, "alternative", e), kind(e, "elif_clause"),
    field(e, "consequence", b).
py_if_branch(s, b) :- kind(s, "if_statement"), field(s, "alternative", e), kind(e, "else_clause"), field(e, "body", b).
.decl py_has_else(s: node)
py_has_else(s) :- kind(s, "if_statement"), field(s, "alternative", e), kind(e, "else_clause").
// py_may_end(b): block b can finish without raising: its last statement is not `raise` (nor an if), or is an if
// that has no else, or one of whose branches can finish.
.decl py_may_end(b: node)
py_may_end(b) :- py_raise_block(b), body_len(b, k), j = k - 1, body_stmt(b, s, j), !kind(s, "raise_statement"),
    !kind(s, "if_statement").
py_may_end(b) :- py_raise_block(b), body_len(b, k), j = k - 1, body_stmt(b, s, j), kind(s, "if_statement"),
    !py_has_else(s).
py_may_end(b) :- py_raise_block(b), body_len(b, k), j = k - 1, body_stmt(b, s, j), py_if_branch(s, cb), py_may_end(cb).
