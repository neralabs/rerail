{
  "format": "rerail.policy/v1",
  "id": "clippy-double-parens",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's double_parens lint: reports redundant nested parentheses around an expression (only whitespace between the two opening or closing parentheses, as Clippy's source check requires; a call's sole argument in parentheses); macro expansion and tuple/unit argument semantics are not modelled.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "nested-parentheses",
      "forbid": { "ast": { "language": "rust", "rule": {"kind": "parenthesized_expression", "has": {"kind": "parenthesized_expression"}, "not": {"has": {"any": [{"kind": "line_comment"}, {"kind": "block_comment"}]}}} } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::double_parens", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "witness.span", "code": "double_parens", "message": "Clippy double_parens: unnecessary double parentheses" }
    },
    {
      "id": "nested-tuple",
      "forbid": { "ast": { "language": "rust", "rule": {"kind": "parenthesized_expression", "has": {"kind": "tuple_expression"}, "not": {"has": {"any": [{"kind": "line_comment"}, {"kind": "block_comment"}]}}} } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::double_parens", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "witness.span", "code": "double_parens", "message": "Clippy double_parens: unnecessary double parentheses" }
    },
    {
      "id": "nested-unit",
      "forbid": { "ast": { "language": "rust", "rule": {"kind": "parenthesized_expression", "has": {"kind": "unit_expression"}, "not": {"has": {"any": [{"kind": "line_comment"}, {"kind": "block_comment"}]}}} } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::double_parens", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "witness.span", "code": "double_parens", "message": "Clippy double_parens: unnecessary double parentheses" }
    },
    {
      "id": "parenthesized-call-argument",
      "forbid": { "ast": { "language": "rust", "rule": {"kind": "parenthesized_expression", "inside": {"stopBy": "neighbor", "kind": "arguments"}, "follows": {"stopBy": "neighbor", "regex": "^\\($"}, "precedes": {"stopBy": "neighbor", "regex": "^\\)$"}} } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::double_parens", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "witness.span", "code": "double_parens", "message": "Clippy double_parens: unnecessary double parentheses" }
    }
  ]
}