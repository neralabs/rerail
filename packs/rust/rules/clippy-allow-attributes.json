{
  "format": "rerail.policy/v1",
  "id": "clippy-allow-attributes",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's allow_attributes: reports the path of every outer #[allow(..)] attribute, one a #[cfg_attr(..)] expands to included. The lint needs Rust 1.81 (lint reasons, `suppress.clippy.msrv`). Inner #![allow] is not reported. What a macro invocation's or macro_rules! body's token tree holds, and whether a #[cfg] or #[cfg_attr] predicate holds in a build, are not read: a #[cfg_attr] is read as active.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "allow-attribute",
      "forbid": { "ast": { "language": "rust", "rule": { "kind": "attribute_item", "regex": "^#\\[\\s*(?P<A>allow)\\s*\\(" } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes", "clippy::restriction", "warnings"], "msrv": "1.81" } }, "anchor": "capture.A", "code": "allow_attributes", "message": "Clippy allow_attributes: #[allow] attribute found" }
    },
    {
      "id": "cfg-attr-allow",
      "forbid": { "ast": { "language": "rust", "rule": { "kind": "attribute_item", "regex": "(?s)^#\\[\\s*cfg_attr\\s*\\(.*[(,]\\s*(?P<A>allow)\\s*\\(" } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes", "clippy::restriction", "warnings"], "msrv": "1.81" } }, "anchor": "capture.A", "code": "allow_attributes", "message": "Clippy allow_attributes: #[allow] attribute found" }
    }
  ]
}
