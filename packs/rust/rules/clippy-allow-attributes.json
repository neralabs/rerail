{
  "format": "rerail.policy/v1",
  "id": "rust-conformance:clippy-allow-attributes",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's allow_attributes: reports the path of every outer #[allow(..)] attribute, one a #[cfg_attr(..)] expands to included, unless #[clippy::msrv] sets a version below 1.81 (lint reasons) around it. Inner #![allow] is not reported. What a macro invocation's or macro_rules! body's token tree holds, and whether a #[cfg] or #[cfg_attr] predicate holds in a build, are not read: a #[cfg_attr] is read as active.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "allow-attribute",
      "forbid": { "ast": { "language": "rust",
        "utils": {
          "skipped": { "any": [{ "kind": "attribute_item" }, { "kind": "line_comment" }, { "kind": "block_comment" }] },
          "old-msrv": { "kind": "attribute_item", "regex": "^#\\[\\s*clippy\\s*::\\s*msrv\\s*=\\s*\"1\\.([0-9]|[1-7][0-9]|80)(\\.[0-9]+)?\"\\s*\\]$" },
          "old-inner-msrv": { "kind": "inner_attribute_item", "regex": "^#!\\[\\s*clippy\\s*::\\s*msrv\\s*=\\s*\"1\\.([0-9]|[1-7][0-9]|80)(\\.[0-9]+)?\"\\s*\\]$" },
          "below-msrv": { "any": [
            { "follows": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } },
            { "precedes": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } },
            { "inside": { "stopBy": "end", "follows": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } } },
            { "inside": { "stopBy": "end", "has": { "matches": "old-inner-msrv" } } }
          ] }
        },
        "rule": { "all": [
          { "kind": "attribute_item", "regex": "^#\\[\\s*(?P<A>allow)\\s*\\(" },
          { "not": { "matches": "below-msrv" } }
        ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes", "clippy::restriction", "warnings"] } }, "anchor": "capture.A", "code": "allow_attributes", "message": "Clippy allow_attributes: #[allow] attribute found" }
    },
    {
      "id": "cfg-attr-allow",
      "forbid": { "ast": { "language": "rust",
        "utils": {
          "skipped": { "any": [{ "kind": "attribute_item" }, { "kind": "line_comment" }, { "kind": "block_comment" }] },
          "old-msrv": { "kind": "attribute_item", "regex": "^#\\[\\s*clippy\\s*::\\s*msrv\\s*=\\s*\"1\\.([0-9]|[1-7][0-9]|80)(\\.[0-9]+)?\"\\s*\\]$" },
          "old-inner-msrv": { "kind": "inner_attribute_item", "regex": "^#!\\[\\s*clippy\\s*::\\s*msrv\\s*=\\s*\"1\\.([0-9]|[1-7][0-9]|80)(\\.[0-9]+)?\"\\s*\\]$" },
          "below-msrv": { "any": [
            { "follows": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } },
            { "precedes": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } },
            { "inside": { "stopBy": "end", "follows": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } } },
            { "inside": { "stopBy": "end", "has": { "matches": "old-inner-msrv" } } }
          ] }
        },
        "rule": { "all": [
          { "kind": "attribute_item", "regex": "(?s)^#\\[\\s*cfg_attr\\s*\\(.*[(,]\\s*(?P<A>allow)\\s*\\(" },
          { "not": { "matches": "below-msrv" } }
        ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes", "clippy::restriction", "warnings"] } }, "anchor": "capture.A", "code": "allow_attributes", "message": "Clippy allow_attributes: #[allow] attribute found" }
    }
  ]
}
