{
  "format": "rerail.policy/v1",
  "id": "rust-conformance:clippy-allow-attributes",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's allow_attributes: reports ordinary #[allow] attributes, while leaving lint-control attributes, inner attributes, and macro-generated attributes alone.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    { "id": "allow-attribute", "forbid": { "ast": { "language": "rust", "rule": { "all": [ { "kind": "attribute_item", "regex": "(?s)^#\\[\\s*(?P<A>allow)\\b[^]]*\\]" }, { "not": { "regex": "clippy::" } }, { "not": { "precedes": { "stopBy": "neighbor", "kind": "attribute_item", "regex": "(?s)^#\\[\\s*expect\\b[^]]*clippy::allow_attributes" } } }, { "not": { "precedes": { "stopBy": "neighbor", "kind": "attribute_item", "regex": "(?s)^#\\[\\s*clippy::msrv\\s*=\\s*\"1\\.80\"" } } } ] } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes", "clippy::restriction", "warnings"] } }, "anchor": "capture.A", "code": "allow_attributes", "message": "Clippy allow_attributes: prefer a more specific lint attribute" } },
    { "id": "cfg-attr-allow", "forbid": { "ast": { "language": "rust", "rule": { "all": [ { "kind": "attribute_item", "regex": "(?s)^#\\[\\s*cfg_attr\\b.*(?P<A>allow\\s*\\()" }, { "not": { "precedes": { "stopBy": "neighbor", "kind": "attribute_item", "regex": "(?s)^#\\[\\s*clippy::msrv\\s*=\\s*\"1\\.80\"" } } } ] } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes", "clippy::restriction", "warnings"] } }, "anchor": "capture.A", "code": "allow_attributes", "message": "Clippy allow_attributes: prefer a more specific lint attribute" } }
  ]
}
