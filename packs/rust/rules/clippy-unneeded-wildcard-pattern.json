{
  "format": "rerail.policy/v1",
  "id": "rust-conformance:clippy-unneeded-wildcard-pattern",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's unneeded_wildcard_pattern: reports a wildcard binding made redundant by a rest pattern; macro-expanded code is not modelled.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    { "id": "tuple-wildcard-before-rest", "forbid": { "ast": { "language": "rust", "rule": { "kind": "tuple_pattern", "regex": "(?s)(?P<W>_)(?:\\s*,\\s*_)*\\s*,\\s*\\.\\." } } }, "violation": { "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Clippy unneeded_wildcard_pattern: wildcard pattern is redundant" } },
    { "id": "tuple-rest-before-wildcard", "forbid": { "ast": { "language": "rust", "rule": { "kind": "tuple_pattern", "regex": "(?s)\\.\\.(?P<W>,)\\s*_\\b" } } }, "violation": { "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Clippy unneeded_wildcard_pattern: wildcard pattern is redundant" } },
    { "id": "tuple-struct-wildcard-before-rest", "forbid": { "ast": { "language": "rust", "rule": { "kind": "tuple_struct_pattern", "regex": "(?s)(?P<W>_)(?:\\s*,\\s*_)*\\s*,\\s*\\.\\." } } }, "violation": { "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Clippy unneeded_wildcard_pattern: wildcard pattern is redundant" } },
    { "id": "tuple-struct-rest-before-wildcard", "forbid": { "ast": { "language": "rust", "rule": { "kind": "tuple_struct_pattern", "regex": "(?s)\\.\\.(?P<W>,)\\s*_\\b" } } }, "violation": { "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Clippy unneeded_wildcard_pattern: wildcard pattern is redundant" } },
    { "id": "struct-wildcard-before-rest", "forbid": { "ast": { "language": "rust", "rule": { "kind": "struct_pattern", "regex": "(?s)(?P<W>[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*_)(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*_)*\\s*,\\s*\\.\\." } } }, "violation": { "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Clippy unneeded_wildcard_pattern: wildcard pattern is redundant" } }
  ]
}
