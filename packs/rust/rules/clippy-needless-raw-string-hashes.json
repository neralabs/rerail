{
  "format":"rerail.policy/v1",
  "id":"rust-conformance:clippy-needless-raw-string-hashes",
  "revision":1,"mode":"steer",
  "description":"Port of Clippy 0.1.99's needless_raw_string_hashes: reports raw literals whose delimiter contains more hashes than their contents require; configurable allowed-hash threshold is not modelled.",
  "scope":{"include":["**/*"],"exclude":[]},
  "clauses":[
