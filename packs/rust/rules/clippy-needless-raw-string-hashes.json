    {"id": "hashes-7", "forbid": {"ast": {"language": "rust", "rule": {"all": [{"kind": "raw_string_literal"}, {"regex": "^(?:b|c)?r#######\"(?s:.*)\"#######$"}, {"regex": "^(?:b|c)?r#######\"(?s:.*)[\\\\\"](?s:.*)\"#######$"}, {"not": {"regex": "^(?:b|c)?r#######\"(?:[^\"]|\"#*(?:\"|[^\"#]))*\"######(?s:.*)\"#######$"}}]}}}, "violation": {"suppress": {"clippy": {"lints": ["clippy::needless_raw_string_hashes", "clippy::pedantic", "warnings"]}}, "anchor": "witness.span", "code": "needless_raw_string_hashes", "message": "Clippy needless_raw_string_hashes: unnecessary hashes around raw string literal"}},
