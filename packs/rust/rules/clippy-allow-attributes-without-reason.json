{
  "format": "rerail.policy/v1",
  "id": "rust-conformance:clippy-allow-attributes-without-reason",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's allow_attributes_without_reason: reports allow and expect attributes that do not specify reason =; macro-generated attributes are not modelled.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    { "id": "allow-without-reason", "forbid": { "ast": { "language": "rust", "rule": { "all": [ { "kind": "attribute_item", "regex": "(?s)^#\\[\\s*(?:allow|expect)\\b[^]]*\\]" }, { "not": { "regex": "reason\\s*=" } }, { "not": { "precedes": { "stopBy": "neighbor", "kind": "attribute_item", "regex": "(?s)^#\\[\\s*clippy::msrv\\s*=\\s*\"1\\.80\"" } } } ] } } }, "violation": { "anchor": "witness.span", "code": "allow_attributes_without_reason", "message": "Clippy allow_attributes_without_reason: allow attributes should have a reason" } },
    { "id": "inner-allow-without-reason", "forbid": { "ast": { "language": "rust", "rule": { "all": [ { "kind": "inner_attribute_item", "regex": "(?s)^#!\\[\\s*(?:allow|expect)\\b[^]]*\\]" }, { "not": { "regex": "reason\\s*=" } } ] } } }, "violation": { "anchor": "witness.span", "code": "allow_attributes_without_reason", "message": "Clippy allow_attributes_without_reason: allow attributes should have a reason" } }
  ]
}
