{
  "format": "rerail.policy/v1",
  "id": "rust-conformance:clippy-allow-attributes-without-reason",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's allow_attributes_without_reason: reports every #[allow(..)] and #[expect(..)] attribute, inner or outer, one a #[cfg_attr(..)] expands to included (at the expanded attribute), whose last item is not `reason = \"..\"`, unless #[clippy::msrv] sets a version below 1.81 (lint reasons) around it. What a macro invocation's or macro_rules! body's token tree holds, and whether a #[cfg] or #[cfg_attr] predicate holds in a build, are not read: a #[cfg_attr] is read as active.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "allow-without-reason",
      "forbid": { "ast": { "language": "rust",
        "utils": {
          "skipped": { "any": [{ "kind": "attribute_item" }, { "kind": "line_comment" }, { "kind": "block_comment" }] },
          "old-msrv": { "kind": "attribute_item", "regex": "^#\\[\\s*clippy\\s*::\\s*msrv\\s*=\\s*\"1\\.([0-9]|[1-7][0-9]|80)(\\.[0-9]+)?\"\\s*\\]$" },
          "old-inner-msrv": { "kind": "inner_attribute_item", "regex": "^#!\\[\\s*clippy\\s*::\\s*msrv\\s*=\\s*\"1\\.([0-9]|[1-7][0-9]|80)(\\.[0-9]+)?\"\\s*\\]$" },
          "below-msrv": { "any": [
            { "follows": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } },
            { "precedes": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } },
            { "inside": { "stopBy": "end", "follows": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } } },
            { "inside": { "stopBy": "end", "has": { "matches": "old-inner-msrv" } } }
          ] }
        },
        "rule": { "all": [
          { "any": [{ "kind": "attribute_item" }, { "kind": "inner_attribute_item" }] },
          { "regex": "^#!?\\[\\s*(?:allow|expect)\\s*\\(" },
          { "not": { "regex": "(?s)[(,]\\s*reason\\s*=\\s*(?:b?r#*\"|b?\").*\\)\\s*\\]$" } },
          { "not": { "matches": "below-msrv" } }
        ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes_without_reason", "clippy::restriction", "warnings"] } }, "anchor": "witness.span", "code": "allow_attributes_without_reason", "message": "Clippy allow_attributes_without_reason: attribute without specifying a reason" }
    },
    {
      "id": "cfg-attr-without-reason",
      "forbid": { "ast": { "language": "rust",
        "utils": {
          "skipped": { "any": [{ "kind": "attribute_item" }, { "kind": "line_comment" }, { "kind": "block_comment" }] },
          "old-msrv": { "kind": "attribute_item", "regex": "^#\\[\\s*clippy\\s*::\\s*msrv\\s*=\\s*\"1\\.([0-9]|[1-7][0-9]|80)(\\.[0-9]+)?\"\\s*\\]$" },
          "old-inner-msrv": { "kind": "inner_attribute_item", "regex": "^#!\\[\\s*clippy\\s*::\\s*msrv\\s*=\\s*\"1\\.([0-9]|[1-7][0-9]|80)(\\.[0-9]+)?\"\\s*\\]$" },
          "below-msrv": { "any": [
            { "follows": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } },
            { "precedes": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } },
            { "inside": { "stopBy": "end", "follows": { "stopBy": { "not": { "matches": "skipped" } }, "matches": "old-msrv" } } },
            { "inside": { "stopBy": "end", "has": { "matches": "old-inner-msrv" } } }
          ] }
        },
        "rule": { "all": [
          { "any": [{ "kind": "attribute_item" }, { "kind": "inner_attribute_item" }] },
          { "regex": "(?s)^#!?\\[\\s*cfg_attr\\s*\\(.*[(,]\\s*(?P<A>(?:allow|expect)\\s*\\((?:[^()\"]|\"[^\"]*\"|\\([^()]*\\))*\\))" },
          { "not": { "regex": "(?s)^#!?\\[\\s*cfg_attr\\s*\\(.*[(,]\\s*(?:allow|expect)\\s*\\((?:[^()\"]|\"[^\"]*\"|\\([^()]*\\))*[(,]\\s*reason\\s*=\\s*(?:b?r#*\"|b?\")[^\"]*\"#*\\s*,?\\s*\\)" } },
          { "not": { "matches": "below-msrv" } }
        ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes_without_reason", "clippy::restriction", "warnings"] } }, "anchor": "capture.A", "code": "allow_attributes_without_reason", "message": "Clippy allow_attributes_without_reason: attribute without specifying a reason" }
    }
  ]
}
