{
  "format": "rerail.policy/v1",
  "id": "clippy-allow-attributes-without-reason",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's allow_attributes_without_reason: reports every #[allow(..)] and #[expect(..)] attribute, inner or outer, one a #[cfg_attr(..)] expands to included (at the expanded attribute), whose last item is not `reason = \"..\"`. The lint needs Rust 1.81 (lint reasons, `suppress.clippy.msrv`). What a macro invocation's or macro_rules! body's token tree holds, and whether a #[cfg] or #[cfg_attr] predicate holds in a build, are not read: a #[cfg_attr] is read as active.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "allow-without-reason",
      "forbid": { "ast": { "language": "rust", "rule": { "all": [
        { "any": [{ "kind": "attribute_item" }, { "kind": "inner_attribute_item" }] },
        { "regex": "^#!?\\[\\s*(?:allow|expect)\\s*\\(" },
        { "not": { "regex": "(?s)[(,]\\s*reason\\s*=\\s*(?:b?r#*\"|b?\").*\\)\\s*\\]$" } }
      ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes_without_reason", "clippy::restriction", "warnings"], "msrv": "1.81" } }, "anchor": "witness.span", "code": "allow_attributes_without_reason", "message": "Clippy allow_attributes_without_reason: attribute without specifying a reason" }
    },
    {
      "id": "cfg-attr-without-reason",
      "forbid": { "ast": { "language": "rust", "rule": { "all": [
        { "any": [{ "kind": "attribute_item" }, { "kind": "inner_attribute_item" }] },
        { "regex": "(?s)^#!?\\[\\s*cfg_attr\\s*\\(.*[(,]\\s*(?P<A>(?:allow|expect)\\s*\\((?:[^()\"]|\"[^\"]*\"|\\([^()]*\\))*\\))" },
        { "not": { "regex": "(?s)^#!?\\[\\s*cfg_attr\\s*\\(.*[(,]\\s*(?:allow|expect)\\s*\\((?:[^()\"]|\"[^\"]*\"|\\([^()]*\\))*[(,]\\s*reason\\s*=\\s*(?:b?r#*\"|b?\")[^\"]*\"#*\\s*,?\\s*\\)" } }
      ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::allow_attributes_without_reason", "clippy::restriction", "warnings"], "msrv": "1.81" } }, "anchor": "capture.A", "code": "allow_attributes_without_reason", "message": "Clippy allow_attributes_without_reason: attribute without specifying a reason" }
    }
  ]
}
