{
  "format": "rerail.policy/v1",
  "id": "clippy-precedence-bits",
  "revision": 4,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's precedence_bits lint: reports, at any nesting depth, every bitwise (& | ^) operation with an unparenthesized shift operand and no unparenthesized arithmetic operand (that mix is the precedence lint's), each at its own span, so every operation of a left-nested chain like `a ^ b ^ c >> 1 ^ d >> 2` that has a shift operand is reported; macro expansion and semantic type checks are not modelled.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bitwise-with-shift",
      "forbid": {
        "ast": {
          "language": "rust",
          "rule": {
            "matches": "lint"
          },
          "utils": {
            "lint": {
              "all": [
                {
                  "kind": "binary_expression"
                },
                {
                  "has": {
                    "field": "operator",
                    "regex": "^[&^|]$"
                  }
                },
                {
                  "any": [
                    {
                      "has": {
                        "field": "left",
                        "kind": "binary_expression",
                        "has": {
                          "field": "operator",
                          "regex": "^(?:<<|>>)$"
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "right",
                        "kind": "binary_expression",
                        "has": {
                          "field": "operator",
                          "regex": "^(?:<<|>>)$"
                        }
                      }
                    }
                  ]
                },
                {
                  "not": {
                    "any": [
                      {
                        "has": {
                          "field": "left",
                          "kind": "binary_expression",
                          "has": {
                            "field": "operator",
                            "regex": "^[-+*/%]$"
                          }
                        }
                      },
                      {
                        "has": {
                          "field": "right",
                          "kind": "binary_expression",
                          "has": {
                            "field": "operator",
                            "regex": "^[-+*/%]$"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "suppress": {
          "clippy": {
            "lints": [
              "clippy::precedence_bits",
              "clippy::restriction",
              "warnings"
            ]
          }
        },
        "anchor": "witness.span",
        "code": "precedence_bits",
        "message": "Add parentheses around the shift in this bitwise expression, e.g. (a << 4) | b."
      }
    }
  ]
}
