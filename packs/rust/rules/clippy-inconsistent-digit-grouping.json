{
  "format":"rerail.policy/v1","id":"rust-conformance:clippy-inconsistent-digit-grouping","revision":1,"mode":"steer","description":"Port of Clippy 0.1.99's inconsistent_digit_grouping: reports decimal literals whose underscore groups are inconsistent; exact grouping semantics are structural here.","scope":{"include":["**/*"],"exclude":[]},"clauses":[{"id":"inconsistent-digit-grouping","forbid":{"ast":{"language":"rust","rule":{"any":[{"kind":"integer_literal","regex":"^[0-9]+_[0-9]{1,3}(?:_[0-9]{1,3})+(?:_[iu](?:8|16|32|64|128|size))?$"},{"kind":"float_literal","regex":"^[0-9]+_[0-9]{1,3}(?:_[0-9]{1,3})+\\.?[0-9]*(?:_[0-9]+)?(?:[eE][+-]?[0-9_]+)?(?:f32|f64)?$"}]}}},"violation":{"suppress":{"clippy":{"lints":["clippy::inconsistent_digit_grouping","clippy::all","clippy::style","warnings"]}},"anchor":"witness.span","code":"inconsistent_digit_grouping","message":"Clippy inconsistent_digit_grouping: digits are grouped inconsistently"}}]}
