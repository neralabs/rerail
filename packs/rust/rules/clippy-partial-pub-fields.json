{
  "format": "rerail.policy/v1",
  "id": "rust-conformance:clippy-partial-pub-fields",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's partial_pub_fields: in a struct whose first field is `pub` (exactly: `pub(crate)` and other restricted visibilities are not), reports the first field that is not, and in one whose first field is not `pub`, the first field that is, at the field's visibility (its start when it has none).",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "pub-after-private",
      "forbid": { "ast": { "language": "rust",
        "utils": { "pub-field": { "has": { "kind": "visibility_modifier", "regex": "^pub$" } } },
        "rule": { "all": [
          { "kind": "field_declaration", "inside": { "kind": "field_declaration_list", "inside": { "kind": "struct_item" } } },
          { "matches": "pub-field" },
          { "follows": { "stopBy": "end", "kind": "field_declaration" } },
          { "not": { "follows": { "stopBy": "end", "kind": "field_declaration", "matches": "pub-field" } } }
        ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::partial_pub_fields", "clippy::restriction", "warnings"] } }, "anchor": "witness.span", "code": "partial_pub_fields", "message": "Clippy partial_pub_fields: mixed usage of pub and non-pub fields" }
    },
    {
      "id": "private-after-pub",
      "forbid": { "ast": { "language": "rust",
        "utils": { "pub-field": { "has": { "kind": "visibility_modifier", "regex": "^pub$" } } },
        "rule": { "all": [
          { "kind": "field_declaration", "inside": { "kind": "field_declaration_list", "inside": { "kind": "struct_item" } } },
          { "not": { "matches": "pub-field" } },
          { "follows": { "stopBy": "end", "kind": "field_declaration" } },
          { "not": { "follows": { "stopBy": "end", "kind": "field_declaration", "not": { "matches": "pub-field" } } } }
        ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::partial_pub_fields", "clippy::restriction", "warnings"] } }, "anchor": "witness.span", "code": "partial_pub_fields", "message": "Clippy partial_pub_fields: mixed usage of pub and non-pub fields" }
    },
    {
      "id": "tuple-pub-after-private",
      "forbid": { "ast": { "language": "rust", "rule": { "all": [
        { "kind": "visibility_modifier", "regex": "^pub$", "inside": { "kind": "ordered_field_declaration_list", "inside": { "kind": "struct_item" } } },
        { "follows": { "stopBy": "end", "regex": "^,$" } },
        { "not": { "follows": { "stopBy": "end", "kind": "visibility_modifier", "regex": "^pub$" } } }
      ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::partial_pub_fields", "clippy::restriction", "warnings"] } }, "anchor": "witness.span", "code": "partial_pub_fields", "message": "Clippy partial_pub_fields: mixed usage of pub and non-pub fields" }
    },
    {
      "id": "tuple-private-after-pub",
      "forbid": { "ast": { "language": "rust",
        "utils": {
          "skipped": { "any": [{ "kind": "attribute_item" }, { "kind": "line_comment" }, { "kind": "block_comment" }] },
          "tuple-field": {
            "inside": { "kind": "ordered_field_declaration_list", "inside": { "kind": "struct_item" } },
            "follows": { "stopBy": { "not": { "any": [{ "matches": "skipped" }, { "kind": "visibility_modifier" }] } }, "regex": "^[(,]$" },
            "not": { "any": [{ "matches": "skipped" }, { "kind": "visibility_modifier" }, { "regex": "^[(),]$" }] }
          },
          "tuple-pub": { "follows": { "stopBy": { "not": { "matches": "skipped" } }, "kind": "visibility_modifier", "regex": "^pub$" } }
        },
        "rule": { "all": [
          { "matches": "tuple-field" },
          { "not": { "matches": "tuple-pub" } },
          { "follows": { "stopBy": "end", "regex": "^,$" } },
          { "not": { "follows": { "stopBy": "end", "matches": "tuple-field", "not": { "matches": "tuple-pub" } } } }
        ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::partial_pub_fields", "clippy::restriction", "warnings"] } }, "anchor": "witness.span", "code": "partial_pub_fields", "message": "Clippy partial_pub_fields: mixed usage of pub and non-pub fields" }
    }
  ]
}
