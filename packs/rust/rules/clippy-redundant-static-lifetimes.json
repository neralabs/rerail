{
  "format": "rerail.policy/v1",
  "id": "clippy-redundant-static-lifetimes",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's redundant_static_lifetimes: reports redundant 'static lifetimes in free const and static declarations; associated items are not modelled. The lint needs Rust 1.17 (`suppress.clippy.msrv`).",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [{ "id": "redundant-static", "forbid": { "ast": { "language": "rust", "rule": { "kind": "lifetime", "regex": "^'static$", "all": [{ "inside": { "kind": "reference_type", "stopBy": "end" } }, { "any": [{ "inside": { "kind": "const_item", "stopBy": "end" } }, { "inside": { "kind": "static_item", "stopBy": "end" } }] }, { "not": { "inside": { "any": [{ "kind": "impl_item" }, { "kind": "trait_item" }], "stopBy": { "kind": "function_item" } } } }, { "not": { "inside": { "kind": "generic_type", "stopBy": "end" } } }] } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::redundant_static_lifetimes", "clippy::all", "clippy::style", "warnings"], "msrv": "1.17" } }, "anchor": "witness.span", "code": "redundant_static_lifetimes", "message": "Clippy redundant_static_lifetimes: consider removing 'static" } }]
}
