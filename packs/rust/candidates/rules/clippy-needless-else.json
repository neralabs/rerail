{
  "format": "rerail.policy/v1",
  "id": "clippy-needless-else",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's needless_else lint: reports an empty else block after an if statement when it has no meaningful comment or code; macro and cfg expansion are not modelled.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "empty-else-block",
      "forbid": { "ast": { "language": "rust", "rule": { "kind": "else_clause", "has": { "kind": "block", "regex": "^\\{\\s*\\}$" }, "not": { "regex": "(?s)/\\*|//" } } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::needless_else", "clippy::all", "clippy::style", "warnings"] } }, "anchor": "witness.span", "code": "needless_else", "message": "Clippy needless_else: unnecessary `else`" }
    }
  ]
}