{
  "format": "rerail.policy/v1",
  "id": "clippy-int-plus-one",
  "revision": 1,
  "mode": "steer",
  "description": "Use a strict comparison in Rust instead of a non-strict one that adds or subtracts one; it states the bound directly.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "ge-adjusted",
      "forbid": { "ast": { "language": "rust", "rule": { "all": [
        { "kind": "binary_expression" }, { "has": { "field": "operator", "regex": "^>=$" } },
        { "any": [
          { "has": { "field": "right", "kind": "binary_expression", "all": [ { "has": { "field": "operator", "regex": "^\\+$" } }, { "has": { "field": "right", "regex": "^1(?:[iu](?:8|16|32|64|128|size))?$" } } ] } },
          { "has": { "field": "right", "kind": "binary_expression", "all": [ { "has": { "field": "operator", "regex": "^\\+$" } }, { "has": { "field": "left", "regex": "^1(?:[iu](?:8|16|32|64|128|size))?$" } } ] } },
          { "has": { "field": "left", "kind": "binary_expression", "all": [ { "has": { "field": "operator", "regex": "^-$" } }, { "has": { "field": "right", "regex": "^1(?:[iu](?:8|16|32|64|128|size))?$" } } ] } },
          { "has": { "field": "left", "kind": "binary_expression", "all": [ { "has": { "field": "operator", "regex": "^\\+$" } }, { "has": { "field": "left", "regex": "^-1(?:[iu](?:8|16|32|64|128|size))?$" } } ] } }
        ] }
      ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::int_plus_one", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "witness.span", "code": "int_plus_one", "message": "Use > and drop the one here, e.g. x > y instead of x >= y + 1 or x - 1 >= y." }
    },
    {
      "id": "le-adjusted",
      "forbid": { "ast": { "language": "rust", "rule": { "all": [
        { "kind": "binary_expression" }, { "has": { "field": "operator", "regex": "^<=$" } },
        { "any": [
          { "has": { "field": "left", "kind": "binary_expression", "all": [ { "has": { "field": "operator", "regex": "^\\+$" } }, { "has": { "field": "right", "regex": "^1(?:[iu](?:8|16|32|64|128|size))?$" } } ] } },
          { "has": { "field": "left", "kind": "binary_expression", "all": [ { "has": { "field": "operator", "regex": "^\\+$" } }, { "has": { "field": "left", "regex": "^1(?:[iu](?:8|16|32|64|128|size))?$" } } ] } },
          { "has": { "field": "right", "kind": "binary_expression", "all": [ { "has": { "field": "operator", "regex": "^-$" } }, { "has": { "field": "right", "regex": "^1(?:[iu](?:8|16|32|64|128|size))?$" } } ] } },
          { "has": { "field": "right", "kind": "binary_expression", "all": [ { "has": { "field": "operator", "regex": "^\\+$" } }, { "has": { "field": "left", "regex": "^-1(?:[iu](?:8|16|32|64|128|size))?$" } } ] } }
        ] }
      ] } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::int_plus_one", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "witness.span", "code": "int_plus_one", "message": "Use < and drop the one here, e.g. x < y instead of x + 1 <= y or x <= y - 1." }
    }
  ]
}