{
  "format": "rerail.policy/v1",
  "id": "clippy-single-char-lifetime-names",
  "revision": 1,
  "mode": "steer",
  "description": "Give Rust lifetime parameters descriptive names instead of single letters; the name says what the borrow is tied to.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [{ "id": "single-char-lifetime", "forbid": { "ast": { "language": "rust", "rule": { "kind": "lifetime", "regex": "^'[A-Za-z]$", "any": [{ "inside": { "kind": "lifetime_parameter", "field": "name" } }, { "inside": { "kind": "for_lifetimes" } }] } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::single_char_lifetime_names", "clippy::restriction", "warnings"] } }, "anchor": "witness.span", "code": "single_char_lifetime_names", "message": "Clippy single_char_lifetime_names: single-character lifetime name" } }]
}
