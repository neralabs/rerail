{"format":"rerail.policy/v1","id":"clippy-mixed-case-hex-literals","revision":1,"mode":"steer","description":"Use one letter case for the digits of a Rust hexadecimal literal, all upper or all lower.","scope":{"include":["**/*"],"exclude":[]},"clauses":[{"id":"mixed-case-hex-literals","forbid":{"ast":{"language":"rust","rule":{"all":[{"kind":"integer_literal"},{"regex":"^0x[0-9A-Fa-f_]+(?:[iu](?:8|16|32|64|128|size))?$"},{"regex":"^0x[0-9A-Fa-f_]*[a-f]"},{"regex":"^0x[0-9A-Fa-f_]*[A-F]"}]}}},"violation":{"suppress":{"clippy":{"lints":["clippy::mixed_case_hex_literals","clippy::all","clippy::style","warnings"]}},"anchor":"witness.span","code":"mixed_case_hex_literals","message":"Use one letter case for this hex literal's digits, e.g. 0xABCD or 0xabcd, not 0xAbCd."}}]}
