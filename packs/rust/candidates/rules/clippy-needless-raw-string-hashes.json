{
  "format": "rerail.policy/v1",
  "id": "clippy-needless-raw-string-hashes",
  "revision": 1,
  "mode": "steer",
  "description": "Use no more hashes on a Rust raw string literal than its contents need to close it.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {"id": "hashes-1", "forbid": {"ast": {"language": "rust", "rule": {"all": [{"kind": "raw_string_literal"}, {"regex": "^(?:b|c)?r#\"(?s:.*)\"#$"}, {"regex": "^(?:b|c)?r#\"(?s:.*)[\\\\\"](?s:.*)\"#$"}, {"not": {"regex": "^(?:b|c)?r#\"(?s:.*)\"(?s:.*)\"#$"}}]}}}, "violation": {"suppress": {"clippy": {"lints": ["clippy::needless_raw_string_hashes", "clippy::pedantic", "warnings"]}}, "anchor": "witness.span", "code": "needless_raw_string_hashes", "message": "Remove the extra # marks from this raw string, keeping only as many as its contents need to close it."}},
    {"id": "hashes-2", "forbid": {"ast": {"language": "rust", "rule": {"all": [{"kind": "raw_string_literal"}, {"regex": "^(?:b|c)?r##\"(?s:.*)\"##$"}, {"regex": "^(?:b|c)?r##\"(?s:.*)[\\\\\"](?s:.*)\"##$"}, {"not": {"regex": "^(?:b|c)?r##\"(?:[^\"]|\"#*(?:\"|[^\"#]))*\"#(?s:.*)\"##$"}}]}}}, "violation": {"suppress": {"clippy": {"lints": ["clippy::needless_raw_string_hashes", "clippy::pedantic", "warnings"]}}, "anchor": "witness.span", "code": "needless_raw_string_hashes", "message": "Remove the extra # marks from this raw string, keeping only as many as its contents need to close it."}},
