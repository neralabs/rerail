{
  "format":"rerail.policy/v1",
  "id":"clippy-precedence-bits",
  "revision":2,
  "mode":"steer",
  "description":"Port of Clippy 0.1.99's precedence_bits lint: reports every bitwise (& | ^) operation, at any nesting depth, with an unparenthesized shift operand and no unparenthesized arithmetic operand (that mix is the precedence lint's); macro expansion and semantic type checks are not modelled.",
  "scope":{"include":["**/*"],"exclude":[]},
  "clauses":[
    {
      "id":"bitwise-with-shift",
      "forbid":{"ast":{"language":"rust","rule":{"all":[
        {"kind":"binary_expression"},{"has":{"field":"operator","regex":"^[&^|]$"}},
        {"any":[{"has":{"field":"left","kind":"binary_expression","has":{"field":"operator","regex":"^(?:<<|>>)$"}}},{"has":{"field":"right","kind":"binary_expression","has":{"field":"operator","regex":"^(?:<<|>>)$"}}}]},
        {"not":{"any":[{"has":{"field":"left","kind":"binary_expression","has":{"field":"operator","regex":"^[-+*/%]$"}}},{"has":{"field":"right","kind":"binary_expression","has":{"field":"operator","regex":"^[-+*/%]$"}}}]}}
      ]}}},
      "violation":{"suppress":{"clippy":{"lints":["clippy::precedence_bits","clippy::restriction","warnings"]}},"anchor":"witness.span","code":"precedence_bits","message":"Clippy precedence_bits: mixed bitwise operations may be confusing"}
    }
  ]
}
