{
  "format": "rerail.policy/v1",
  "id": "clippy-option-env-unwrap",
  "revision": 1,
  "mode": "steer",
  "description": "Use env! instead of unwrapping option_env! in Rust; env! fails at compile time when the variable is missing, not at runtime.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    { "id": "option-env-unwrapping", "forbid": { "ast": { "language": "rust", "rule": { "kind": "call_expression", "regex": "(?s)(?P<O>option_env!\\s*\\([^)]*\\))\\s*\\.\\s*(?:unwrap|expect)\\s*\\(" } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::option_env_unwrap", "clippy::all", "clippy::correctness", "warnings"] } }, "anchor": "capture.O", "code": "option_env_unwrap", "message": "Clippy option_env_unwrap: option_env! should not be unwrapped" } },
    { "id": "option-env-inline-macro", "forbid": { "ast": { "language": "rust", "rule": { "kind": "macro_invocation", "regex": "(?s)^inline!\\s*\\(\\s*(?P<O>option_env!.*?\\.\\s*(?:unwrap|expect)\\s*\\()" } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::option_env_unwrap", "clippy::all", "clippy::correctness", "warnings"] } }, "anchor": "capture.O", "code": "option_env_unwrap", "message": "Clippy option_env_unwrap: option_env! should not be unwrapped" } },
    { "id": "option-env-in-macro", "forbid": { "ast": { "language": "rust", "rule": { "kind": "macro_invocation", "regex": "(?s)^external!\\s*\\(\\s*option_env!.*?\\.\\s*(?:unwrap|expect)\\s*\\(" } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::option_env_unwrap", "clippy::all", "clippy::correctness", "warnings"] } }, "anchor": "witness.span", "code": "option_env_unwrap", "message": "Clippy option_env_unwrap: option_env! should not be unwrapped" } }
  ]
}
