{
  "format": "rerail.policy/v1",
  "id": "clippy-option-env-unwrap",
  "revision": 2,
  "mode": "steer",
  "description": "Use env! instead of unwrapping option_env! in Rust; env! fails at compile time when the variable is missing, not at runtime.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    { "id": "option-env-unwrapping", "forbid": { "ast": { "language": "rust", "rule": { "kind": "call_expression", "has": { "field": "function", "kind": "field_expression", "all": [{ "has": { "field": "field", "regex": "^(?:unwrap|expect)$" } }, { "has": { "field": "value", "kind": "macro_invocation", "has": { "field": "macro", "regex": "^option_env$" } } }] } } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::option_env_unwrap", "clippy::all", "clippy::correctness", "warnings"] } }, "anchor": "witness.span", "code": "option_env_unwrap", "message": "Replace this unwrapped option_env! with env! so a missing variable fails the build, not the run." } },
    { "id": "option-env-unwrapping-in-macro-input", "forbid": { "ast": { "language": "rust", "rule": { "kind": "token_tree", "has": { "kind": "identifier", "regex": "^option_env$" }, "regex": "(?s)(?:^|[^\\w$])(?P<O>option_env\\s*!\\s*\\((?:[^()]|\\([^()]*\\))*\\)\\s*\\.\\s*(?:unwrap|expect)\\s*\\((?:[^()\"]|\"(?:[^\"\\\\]|\\\\.)*\"|\\((?:[^()\"]|\"(?:[^\"\\\\]|\\\\.)*\")*\\))*\\))" } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::option_env_unwrap", "clippy::all", "clippy::correctness", "warnings"] } }, "anchor": "capture.O", "code": "option_env_unwrap", "message": "Replace this unwrapped option_env! with env! so a missing variable fails the build, not the run." } }
  ]
}
