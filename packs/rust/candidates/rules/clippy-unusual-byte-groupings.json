{
  "format": "rerail.policy/v1",
  "id": "clippy-unusual-byte-groupings",
  "revision": 1,
  "mode": "steer",
  "description": "Split Rust binary, octal and hexadecimal literals into equal-size digit groups; uneven groups hide the bit layout.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "unusual",
      "forbid": { "ast": { "language": "rust", "rule": { "all": [
        {"any": [{"kind": "integer_literal"}, {"kind": "float_literal"}]},
        { "all": [
          {"not": {"inside": {"stopBy": "end", "kind": "macro_definition"}}},
          {"not": {"regex": "^[0-9][0-9_]*_(?:8|16|32|64)$"}},
          {"not": {"regex": "^0[xbo][0-9A-Fa-f_]*_(?:8|16|32|64)$"}},
          {"not": {"regex": "^[0-9_.]*[eE][+-]?[0-9_]*_(?:32|64)$"}},
          {"not": {"regex": "^0x[0-9A-Fa-f]{8}_[0-9A-Fa-f]{4}_[0-9A-Fa-f]{4}_[0-9A-Fa-f]{4}_[0-9A-Fa-f]{12}(?:_?(?:[iu](?:8|16|32|64|128|size)))?$"}},
          { "any": [
            {"all": [{"regex": "^0[xbo].*$"}, {"not": {"regex": "^0[xbo][0-9A-Fa-f]+(?:_?(?:[iu](?:8|16|32|64|128|size)))?$"}}, {"not": {"regex": "^0[xbo](?:[0-9A-Fa-f]{0,1}(?:_[0-9A-Fa-f]{1})+|[0-9A-Fa-f]{0,2}(?:_[0-9A-Fa-f]{2})+|[0-9A-Fa-f]{0,3}(?:_[0-9A-Fa-f]{3})+|[0-9A-Fa-f]{0,4}(?:_[0-9A-Fa-f]{4})+|[0-9A-Fa-f]{0,5}(?:_[0-9A-Fa-f]{5})+|[0-9A-Fa-f]{0,6}(?:_[0-9A-Fa-f]{6})+|[0-9A-Fa-f]{0,7}(?:_[0-9A-Fa-f]{7})+|[0-9A-Fa-f]{0,8}(?:_[0-9A-Fa-f]{8})+|[0-9A-Fa-f]{0,9}(?:_[0-9A-Fa-f]{9})+|[0-9A-Fa-f]{0,10}(?:_[0-9A-Fa-f]{10})+|[0-9A-Fa-f]{0,11}(?:_[0-9A-Fa-f]{11})+|[0-9A-Fa-f]{0,12}(?:_[0-9A-Fa-f]{12})+|[0-9A-Fa-f]{0,13}(?:_[0-9A-Fa-f]{13})+|[0-9A-Fa-f]{0,14}(?:_[0-9A-Fa-f]{14})+|[0-9A-Fa-f]{0,15}(?:_[0-9A-Fa-f]{15})+|[0-9A-Fa-f]{0,16}(?:_[0-9A-Fa-f]{16})+|[0-9A-Fa-f]{0,17}(?:_[0-9A-Fa-f]{17})+|[0-9A-Fa-f]{0,18}(?:_[0-9A-Fa-f]{18})+|[0-9A-Fa-f]{0,19}(?:_[0-9A-Fa-f]{19})+|[0-9A-Fa-f]{0,20}(?:_[0-9A-Fa-f]{20})+|[0-9A-Fa-f]{0,21}(?:_[0-9A-Fa-f]{21})+|[0-9A-Fa-f]{0,22}(?:_[0-9A-Fa-f]{22})+|[0-9A-Fa-f]{0,23}(?:_[0-9A-Fa-f]{23})+|[0-9A-Fa-f]{0,24}(?:_[0-9A-Fa-f]{24})+|[0-9A-Fa-f]{0,25}(?:_[0-9A-Fa-f]{25})+|[0-9A-Fa-f]{0,26}(?:_[0-9A-Fa-f]{26})+|[0-9A-Fa-f]{0,27}(?:_[0-9A-Fa-f]{27})+|[0-9A-Fa-f]{0,28}(?:_[0-9A-Fa-f]{28})+|[0-9A-Fa-f]{0,29}(?:_[0-9A-Fa-f]{29})+|[0-9A-Fa-f]{0,30}(?:_[0-9A-Fa-f]{30})+|[0-9A-Fa-f]{0,31}(?:_[0-9A-Fa-f]{31})+|[0-9A-Fa-f]{0,32}(?:_[0-9A-Fa-f]{32})+|[0-9A-Fa-f]{0,33}(?:_[0-9A-Fa-f]{33})+|[0-9A-Fa-f]{0,34}(?:_[0-9A-Fa-f]{34})+|[0-9A-Fa-f]{0,35}(?:_[0-9A-Fa-f]{35})+|[0-9A-Fa-f]{0,36}(?:_[0-9A-Fa-f]{36})+|[0-9A-Fa-f]{0,37}(?:_[0-9A-Fa-f]{37})+|[0-9A-Fa-f]{0,38}(?:_[0-9A-Fa-f]{38})+|[0-9A-Fa-f]{0,39}(?:_[0-9A-Fa-f]{39})+|[0-9A-Fa-f]{0,40}(?:_[0-9A-Fa-f]{40})+)(?:_?(?:[iu](?:8|16|32|64|128|size)))?$"}}]}
          ] }
        ] }
      ] } } },
      "violation": {"suppress": {"clippy": {"lints": ["clippy::unusual_byte_groupings", "clippy::all", "clippy::style", "warnings"]}}, "anchor": "witness.span", "code": "unusual_byte_groupings", "message": "Clippy unusual_byte_groupings: digits of hex, binary or octal literal not in groups of equal size"}
    }
  ]
}
