{
  "format": "rerail.policy/v1",
  "id": "clippy-unneeded-wildcard-pattern",
  "revision": 1,
  "mode": "steer",
  "description": "Remove wildcard patterns next to a rest pattern in Rust; the rest pattern already ignores those elements.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    { "id": "tuple-wildcard-before-rest", "forbid": { "ast": { "language": "rust", "rule": { "kind": "tuple_pattern", "regex": "(?s)(?P<W>_)(?:\\s*,\\s*_)*\\s*,\\s*\\.\\." } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::unneeded_wildcard_pattern", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Remove the _ wildcards before this ..; the rest pattern already skips them." } },
    { "id": "tuple-rest-before-wildcard", "forbid": { "ast": { "language": "rust", "rule": { "kind": "tuple_pattern", "regex": "(?s)\\.\\.(?P<W>,)\\s*_\\b" } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::unneeded_wildcard_pattern", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Remove the _ wildcards after this ..; the rest pattern already skips them." } },
    { "id": "tuple-struct-wildcard-before-rest", "forbid": { "ast": { "language": "rust", "rule": { "kind": "tuple_struct_pattern", "regex": "(?s)(?P<W>_)(?:\\s*,\\s*_)*\\s*,\\s*\\.\\." } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::unneeded_wildcard_pattern", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Remove the _ wildcards before this ..; the rest pattern already skips them." } },
    { "id": "tuple-struct-rest-before-wildcard", "forbid": { "ast": { "language": "rust", "rule": { "kind": "tuple_struct_pattern", "regex": "(?s)\\.\\.(?P<W>,)\\s*_\\b" } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::unneeded_wildcard_pattern", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Remove the _ wildcards after this ..; the rest pattern already skips them." } },
    { "id": "struct-wildcard-before-rest", "forbid": { "ast": { "language": "rust", "rule": { "kind": "struct_pattern", "regex": "(?s)(?P<W>[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*_)(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*_)*\\s*,\\s*\\.\\." } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::unneeded_wildcard_pattern", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "capture.W", "code": "unneeded_wildcard_pattern", "message": "Remove the field: _ entries before this ..; the rest pattern already skips those fields." } }
  ]
}
