{
  "format": "rerail.policy/v1",
  "id": "clippy-single-component-path-imports",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's single_component_path_imports (Rust 2018 and later): reports a module's (the file's or a `mod`'s) non-`pub` `use name;` without a rename, and each `name` of a `use {a, b};` without a prefix, unless a `macro_rules!` of that name comes before it in the module, a non-`pub` `use self::name..` of the module (or `use self::{name..}`) names it, or a path `self::name::..` outside `use` declarations does anywhere in the module. Clippy reads the module after macro expansion; macro arguments and macro_rules! bodies are token trees no syntax-level reader expands.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "single-component-import",
      "forbid": { "ast": { "language": "rust",
        "utils": {
          "module-item": {"inside": {"any": [{"kind": "source_file"}, {"kind": "declaration_list", "inside": {"kind": "mod_item"}}]}},
          "not-pub": {"not": {"has": {"kind": "visibility_modifier", "regex": "^pub$"}}},
          "starts-with-n": {"any": [{"kind": "identifier", "pattern": "$N"}, {"has": {"field": "path", "matches": "starts-with-n"}}, {"kind": "use_wildcard", "has": {"matches": "starts-with-n"}}]},
          "self-n": {"kind": "scoped_identifier", "has": {"field": "path", "kind": "self"}, "all": [{"has": {"field": "name", "pattern": "$N"}}]},
          "reused-with-self": {"any": [{"follows": {"stopBy": "end", "kind": "use_declaration", "matches": "not-pub", "has": {"stopBy": "end", "any": [{"matches": "self-n"}, {"kind": "scoped_use_list", "has": {"field": "path", "kind": "self"}, "all": [{"has": {"field": "list", "has": {"matches": "starts-with-n"}}}]}]}}}, {"precedes": {"stopBy": "end", "kind": "use_declaration", "matches": "not-pub", "has": {"stopBy": "end", "any": [{"matches": "self-n"}, {"kind": "scoped_use_list", "has": {"field": "path", "kind": "self"}, "all": [{"has": {"field": "list", "has": {"matches": "starts-with-n"}}}]}]}}}, {"inside": {"any": [{"kind": "source_file"}, {"kind": "declaration_list"}], "has": {"stopBy": "end", "matches": "self-n", "not": {"inside": {"stopBy": "end", "kind": "use_declaration"}}}}}, {"follows": {"stopBy": "end", "kind": "macro_definition", "has": {"field": "name", "pattern": "$N"}}}]}
        },
        "rule": {"all": [{"kind": "use_declaration"}, {"has": {"field": "argument", "kind": "identifier", "pattern": "$N"}}, {"matches": "module-item"}, {"matches": "not-pub"}, {"not": {"matches": "reused-with-self"}}]} } },
      "violation": {"suppress": {"clippy": {"lints": ["clippy::single_component_path_imports", "clippy::all", "clippy::style", "warnings"]}}, "anchor": "witness.span", "code": "single_component_path_imports", "message": "Clippy single_component_path_imports: this import is redundant"}
    },
    {
      "id": "nested-single-component-import",
      "forbid": { "ast": { "language": "rust",
        "utils": {
          "module-item": {"inside": {"any": [{"kind": "source_file"}, {"kind": "declaration_list", "inside": {"kind": "mod_item"}}]}},
          "not-pub": {"not": {"has": {"kind": "visibility_modifier", "regex": "^pub$"}}},
          "starts-with-n": {"any": [{"kind": "identifier", "pattern": "$N"}, {"has": {"field": "path", "matches": "starts-with-n"}}, {"kind": "use_wildcard", "has": {"matches": "starts-with-n"}}]},
          "self-n": {"kind": "scoped_identifier", "has": {"field": "path", "kind": "self"}, "all": [{"has": {"field": "name", "pattern": "$N"}}]},
          "reused-with-self": {"any": [{"follows": {"stopBy": "end", "kind": "use_declaration", "matches": "not-pub", "has": {"stopBy": "end", "any": [{"matches": "self-n"}, {"kind": "scoped_use_list", "has": {"field": "path", "kind": "self"}, "all": [{"has": {"field": "list", "has": {"matches": "starts-with-n"}}}]}]}}}, {"precedes": {"stopBy": "end", "kind": "use_declaration", "matches": "not-pub", "has": {"stopBy": "end", "any": [{"matches": "self-n"}, {"kind": "scoped_use_list", "has": {"field": "path", "kind": "self"}, "all": [{"has": {"field": "list", "has": {"matches": "starts-with-n"}}}]}]}}}, {"inside": {"any": [{"kind": "source_file"}, {"kind": "declaration_list"}], "has": {"stopBy": "end", "matches": "self-n", "not": {"inside": {"stopBy": "end", "kind": "use_declaration"}}}}}, {"follows": {"stopBy": "end", "kind": "macro_definition", "has": {"field": "name", "pattern": "$N"}}}]}
        },
        "rule": {"all": [{"kind": "identifier", "pattern": "$N"}, {"inside": {"kind": "use_list", "inside": {"field": "argument", "kind": "use_declaration", "matches": "module-item", "all": [{"matches": "not-pub"}, {"not": {"matches": "reused-with-self"}}]}}}]} } },
      "violation": {"suppress": {"clippy": {"lints": ["clippy::single_component_path_imports", "clippy::all", "clippy::style", "warnings"]}}, "anchor": "witness.span", "code": "single_component_path_imports", "message": "Clippy single_component_path_imports: this import is redundant"}
    }
  ]
}
