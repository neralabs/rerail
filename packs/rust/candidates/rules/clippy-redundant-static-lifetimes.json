{
  "format": "rerail.policy/v1",
  "id": "clippy-redundant-static-lifetimes",
  "revision": 1,
  "mode": "steer",
  "description": "Drop explicit 'static lifetimes from the types of Rust const and static items; they are already implied there.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [{ "id": "redundant-static", "forbid": { "ast": { "language": "rust", "rule": {"kind": "lifetime", "regex": "^'static$", "all": [{"inside": {"stopBy": "neighbor", "kind": "reference_type", "not": {"has": {"field": "type", "any": [{"kind": "reference_type"}, {"kind": "pointer_type"}, {"kind": "function_type"}, {"kind": "dynamic_type"}, {"kind": "bounded_type"}, {"kind": "abstract_type"}, {"kind": "never_type"}, {"kind": "macro_invocation"}]}}}}, {"inside": {"any": [{"kind": "const_item"}, {"kind": "static_item"}], "stopBy": {"not": {"any": [{"kind": "reference_type"}, {"kind": "array_type"}, {"kind": "tuple_type"}]}}}}, {"not": {"inside": {"any": [{"kind": "impl_item"}, {"kind": "trait_item"}], "stopBy": {"kind": "function_item"}}}}]} } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::redundant_static_lifetimes", "clippy::all", "clippy::style", "warnings"], "msrv": "1.17" } }, "anchor": "witness.span", "code": "redundant_static_lifetimes", "message": "Remove this 'static; it is already implied in a const or static type." } }]
}
