{
  "format": "rerail.policy/v1",
  "id": "clippy-else-if-without-else",
  "revision": 2,
  "mode": "steer",
  "description": "End every Rust if / else if chain with a final else branch; it makes the remaining case explicit.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "else-if-final-branch",
      "forbid": { "ast": { "language": "rust", "rule": { "kind": "if_expression", "inside": { "stopBy": "neighbor", "kind": "else_clause" }, "not": { "has": { "field": "alternative", "kind": "else_clause" } } } } },
      "violation": { "suppress": { "clippy": { "lints": ["clippy::else_if_without_else", "clippy::restriction", "warnings"] } }, "anchor": "witness.span", "code": "else_if_without_else", "message": "Add a final else branch to this if / else if chain to handle the remaining case." }
    }
  ]
}
