{
  "format": "rerail.policy/v1",
  "id": "clippy-redundant-at-rest-pattern",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Clippy 0.1.99's redundant_at_rest_pattern: reports a binding of a slice rest pattern when the binding is unnecessary.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    { "id": "redundant-slice-rest-binding", "forbid": { "ast": { "language": "rust", "rule": { "kind": "slice_pattern", "regex": "(?s)^\\[\\s*(?:(?:ref\\s+mut|ref|mut)\\s+)?[A-Za-z_][A-Za-z0-9_]*\\s*@\\s*\\.\\.\\s*\\]$" } } }, "violation": { "suppress": { "clippy": { "lints": ["clippy::redundant_at_rest_pattern", "clippy::all", "clippy::complexity", "warnings"] } }, "anchor": "witness.span", "code": "redundant_at_rest_pattern", "message": "Clippy redundant_at_rest_pattern: using a rest pattern to bind an entire slice to a local" } }
  ]
}
