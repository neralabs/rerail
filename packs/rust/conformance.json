    {"id": "clippy-redundant-static-lifetimes", "upstream": {"tool": "clippy", "rule": "redundant_static_lifetimes"}, "policy": "candidates/rules/clippy-redundant-static-lifetimes.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
    {"id": "clippy-needless-arbitrary-self-type", "upstream": {"tool": "clippy", "rule": "needless_arbitrary_self_type"}, "policy": "rules/clippy-needless-arbitrary-self-type.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
