    {"id": "clippy-builtin-type-shadow", "upstream": {"tool": "clippy", "rule": "builtin_type_shadow"}, "policy": "candidates/rules/clippy-builtin-type-shadow.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
    {"id": "clippy-redundant-field-names", "upstream": {"tool": "clippy", "rule": "redundant_field_names"}, "policy": "candidates/rules/clippy-redundant-field-names.json", "capabilities": ["syntax", "suppression"], "match": "line+column"},
