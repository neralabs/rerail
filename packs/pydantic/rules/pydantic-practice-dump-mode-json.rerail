.policy "pydantic-practice-dump-mode-json" revision 1
.description "Dump a model in JSON mode before handing it to json.dumps or an HTTP client's json argument, when the model has a field json cannot encode."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. `model_dump()` defaults to mode="python": a `datetime`, `UUID`, `Decimal`, `set`,
// plain `Enum`, `HttpUrl` or `SecretStr` field stays that Python object in the dict, and the standard library's json
// encoder raises `TypeError: Object of type datetime is not JSON serializable` on it, so the code path fails every
// time it runs with such a model (an outage of that path, or a 500). `model_dump(mode="json")` gives a JSON-safe dict.
//   class Event(BaseModel):            (app/schemas.py)
//       starts_at: datetime
//   def event_json(event: Event):      (app/services.py)
//       return json.dumps(event.model_dump())                          reported: starts_at: datetime
//       requests.post(url, json=event.model_dump())                    reported: requests encodes with json
//       return json.dumps(event.model_dump(mode="json"))               not reported
// The sinks are the standard library's encoder: `json.dumps`/`json.dump` (resolved through imports, so a project's
// own `json` module, such as superset's `from superset.utils import json`, is not one) with no `default=`, `cls=` or
// `**kwargs`; the `json=` keyword of `requests.<verb>()`, a `requests.Session()`'s methods, `httpx.<verb>()` and an
// `httpx.Client()`/`httpx.AsyncClient()`'s methods (a client built in the same function, by assignment or `with ...
// as`). The dump reaches it as the argument itself, a value or `**` splat of a dict literal, an item of a list or tuple
// literal or the body of a list comprehension in it, or a name the function last assigned from one of these.
// The dump is `o.model_dump(...)` or v2's deprecated `o.dict(...)`, in Python mode (no `mode=`, or mode="python"),
// where o is known to hold model M (lib/pydantic's pd_instance: a constructor call, a name bound to one, `self` in a
// method of M, a parameter annotated M; or the loop variable of a comprehension over a parameter annotated
// `list[M]`), and M (its own fields, the fields it inherits from the run's classes, its computed fields, and the
// fields of the models its fields hold, nested to any depth, in lists or dicts too) has a field of a type the json
// module cannot encode: datetime, date, time, timedelta, UUID (and pydantic's UUID1..UUID5), Decimal, bytes,
// bytearray, set, frozenset, pathlib paths, ipaddress types, SecretStr/SecretBytes, pydantic's URL and DSN types,
// pydantic's constrained and past/future date types, or a run Enum that is not also a str, int or float.
// Only a field proven to hold such a type is reported, read where the model is defined: a model whose fields are all
// JSON-native (str, int, float, bool, None, Literal, str or int enums, lists and dicts of those, nested models of
// those) encodes today, and `mode="json"` would change nothing there, so reporting it would be noise.
// Left alone, as they encode or cannot be followed:
//   - `model_dump(mode="json")`, `model_dump_json()`, `json.dumps(..., default=str)` or `cls=`, orjson, FastAPI's
//     `jsonable_encoder(...)`, Flask's `jsonify(...)`, a project json module, a client the function did not build
//     (a TestClient fixture, `self.client`);
//   - a dump with `include=` or `exclude=` (not followed: either may drop the offending fields), or with `**kwargs`;
//   - a model that defines its own `model_dump`/`dict`, has a `@model_serializer`, or sets `json_encoders` in its
//     config (Pydantic 2 applies json_encoders in JSON mode only, so such a model can still fail; it is left alone as
//     a sign the author handles encoding); a field with `Field(exclude=True)`, a `@field_serializer` for it (unless
//     `when_used="json"` or "json-unless-none", which do not run in Python mode), or a PlainSerializer/
//     WrapSerializer in its `Annotated[...]`; an enum field of a model with `use_enum_values=True`;
//   - a field the model's code can replace after validation with a type the rule does not follow: a method of the
//     model or a run base assigns `self.x = ...` (an after model validator's `self.host = str(self.host)`), or an
//     after, plain or wrap field validator for it returns a value (a before validator's result is still validated
//     into the declared type, so it is reported);
//   - pydantic.v1 models (pd_model leaves them out), and a URL field in a project pinned to Pydantic 1 (v1's URLs
//     are str);
//   - a name the function changes after the dump (`payload["at"] = ...`, `payload.update(...)`);
//   - test code: a test that dumps such a model fails the first time it runs, so it cannot pass unnoticed.
// Gaps: a receiver whose model is not known (a function's return value, an attribute, an untyped parameter, `Any`);
// a type alias (`UTCDatetime = Annotated[datetime, ...]`) or a type from another library (pydantic_extra_types)
// is not followed; a model from outside the run; a field typed `Any`/`dict[str, Any]` that holds a datetime;
// `requests` falls back to simplejson when it is installed, which encodes Decimal (not datetime or UUID); a dump
// passed through a helper function before it reaches the encoder; an inherited field overridden two levels down.

#include "lib/pydantic.rerail"

.violation DumpNotJson(at: node, model: symbol, field: symbol, sink: symbol) "`{model}.model_dump()` reaches {sink} in Python mode, where field `{field}` stays a Python object the json module cannot encode: it raises TypeError whenever that field holds a value. Dump in JSON mode, `.model_dump(mode=\"json\")`, which gives the same dict for JSON-native fields; leave it when the encoder has a `default=` that handles the type."

// ---- types the json module cannot encode -------------------------------------------------------------------------
// dmj_bad_q(q, label): a qualified type name whose instances json.dumps rejects, by the label the message shows.
.decl dmj_bad_q(q: symbol, label: symbol)
dmj_bad_q("datetime.datetime", "datetime"). dmj_bad_q("datetime.date", "date"). dmj_bad_q("datetime.time", "time").
dmj_bad_q("datetime.timedelta", "timedelta").
dmj_bad_q("uuid.UUID", "UUID"). dmj_bad_q("decimal.Decimal", "Decimal").
dmj_bad_q("builtins.bytes", "bytes"). dmj_bad_q("builtins.bytearray", "bytearray").
dmj_bad_q("builtins.set", "set"). dmj_bad_q("builtins.frozenset", "frozenset").
dmj_bad_q("typing.Set", "set"). dmj_bad_q("typing.FrozenSet", "frozenset"). dmj_bad_q("typing.AbstractSet", "set").
dmj_bad_q("typing.MutableSet", "set"). dmj_bad_q("collections.abc.Set", "set").
dmj_bad_q("collections.abc.MutableSet", "set").
dmj_bad_q("pathlib.Path", "Path"). dmj_bad_q("pathlib.PurePath", "PurePath"). dmj_bad_q("pathlib.PosixPath", "Path").
dmj_bad_q("pathlib.WindowsPath", "Path").
dmj_bad_q("ipaddress.IPv4Address", "IPv4Address"). dmj_bad_q("ipaddress.IPv6Address", "IPv6Address").
dmj_bad_q("ipaddress.IPv4Network", "IPv4Network"). dmj_bad_q("ipaddress.IPv6Network", "IPv6Network").
dmj_bad_q("ipaddress.IPv4Interface", "IPv4Interface"). dmj_bad_q("ipaddress.IPv6Interface", "IPv6Interface").
// pydantic's own types, by their names in `pydantic` and in the modules that define them.
.decl dmj_pd_type(x: symbol, label: symbol)
dmj_pd_type("UUID1", "UUID1"). dmj_pd_type("UUID3", "UUID3"). dmj_pd_type("UUID4", "UUID4").
dmj_pd_type("UUID5", "UUID5"). dmj_pd_type("UUID6", "UUID6"). dmj_pd_type("UUID7", "UUID7").
dmj_pd_type("UUID8", "UUID8").
dmj_pd_type("SecretStr", "SecretStr"). dmj_pd_type("SecretBytes", "SecretBytes").
dmj_pd_type("FilePath", "FilePath"). dmj_pd_type("DirectoryPath", "DirectoryPath"). dmj_pd_type("NewPath", "NewPath").
dmj_pd_type("SocketPath", "SocketPath").
dmj_pd_type("PastDate", "PastDate"). dmj_pd_type("FutureDate", "FutureDate").
dmj_pd_type("PastDatetime", "PastDatetime"). dmj_pd_type("FutureDatetime", "FutureDatetime").
dmj_pd_type("AwareDatetime", "AwareDatetime"). dmj_pd_type("NaiveDatetime", "NaiveDatetime").
dmj_pd_type("IPvAnyAddress", "IPvAnyAddress"). dmj_pd_type("IPvAnyInterface", "IPvAnyInterface").
dmj_pd_type("IPvAnyNetwork", "IPvAnyNetwork").
dmj_pd_type("condecimal", "condecimal"). dmj_pd_type("condate", "condate"). dmj_pd_type("conset", "conset").
dmj_pd_type("confrozenset", "confrozenset"). dmj_pd_type("conbytes", "conbytes").
dmj_pd_type("Base64Bytes", "Base64Bytes"). dmj_pd_type("StrictBytes", "StrictBytes").
// Pydantic 2's URL and DSN types are pydantic_core Url objects in Python mode (v1's were str).
.decl dmj_pd_url(x: symbol)
dmj_pd_url("AnyUrl"). dmj_pd_url("AnyHttpUrl"). dmj_pd_url("HttpUrl"). dmj_pd_url("AnyWebsocketUrl").
dmj_pd_url("WebsocketUrl"). dmj_pd_url("FileUrl"). dmj_pd_url("FtpUrl"). dmj_pd_url("PostgresDsn").
dmj_pd_url("CockroachDsn"). dmj_pd_url("AmqpDsn"). dmj_pd_url("RedisDsn"). dmj_pd_url("MongoDsn").
dmj_pd_url("KafkaDsn"). dmj_pd_url("NatsDsn"). dmj_pd_url("MySQLDsn"). dmj_pd_url("MariaDBDsn").
dmj_pd_url("ClickHouseDsn"). dmj_pd_url("SnowflakeDsn").
.decl dmj_pd_mod(m: symbol)
dmj_pd_mod("pydantic"). dmj_pd_mod("pydantic.types"). dmj_pd_mod("pydantic.networks").
// dmj_named_bad(n, label, u): name n in an annotation resolves to such a type, of kind u: 1 a pydantic URL type,
// 2 a plain enum of the run, 0 any other.
.decl dmj_named_bad(n: node, label: symbol, u: number)
dmj_named_bad(n, l, 0) :- sym_of(n, q), dmj_bad_q(q, l).
dmj_named_bad(n, l, 0) :- sym_of(n, q), dmj_pd_mod(m), dmj_pd_type(x, l), q = cat(m, ".", x).
dmj_named_bad(n, x, 1) :- sym_of(n, q), dmj_pd_mod(m), dmj_pd_url(x), q = cat(m, ".", x).
dmj_named_bad(n, x, 2) :- sym_of(n, q), class_def(e, q), dmj_plain_enum(e), def_name(e, x).

// ---- enums: a run class deriving from enum.Enum (or Flag) that is not also a str, int or float ---------------------
.decl dmj_enum_q(q: symbol)
dmj_enum_q("enum.Enum"). dmj_enum_q("enum.Flag").
dmj_enum_q(q) :- class_def(c, q), class_base(c, b), dmj_enum_q(b).
.decl dmj_json_enum_q(q: symbol)
dmj_json_enum_q("builtins.str"). dmj_json_enum_q("builtins.int"). dmj_json_enum_q("builtins.float").
dmj_json_enum_q("enum.IntEnum"). dmj_json_enum_q("enum.StrEnum"). dmj_json_enum_q("enum.IntFlag").
dmj_json_enum_q(q) :- class_def(c, q), class_base(c, b), dmj_json_enum_q(b).
.decl dmj_plain_enum(e: node)
dmj_plain_enum(e) :- class_def(e, q), dmj_enum_q(q), !dmj_json_enum_q(q), !dmj_enum_base_open(e).
// a base that does not resolve (a mixin from outside the run) may be str: not proven plain
.decl dmj_enum_base_open(e: node)
dmj_enum_base_open(e) :- kind(e, "class_definition"), field(e, "superclasses", al), child(al, b, _),
    !kind(b, "keyword_argument"), !sym_of(b, _).

// ---- annotations -------------------------------------------------------------------------------------------------
// dmj_ann_ref(t, n): name n (a whole Name/Attribute chain) is a type in annotation t, not a Literal value and not in
// the metadata calls of Annotated[...] (Field(...), PlainSerializer(...)); the callee of a type call such as
// `condecimal(...)` is a type.
.decl dmj_ann_ref(t: node, n: node)
dmj_ann_ref(t, n) :- ann_node(t, n), (kind(n, "identifier") ; kind(n, "attribute")), !field(_, "object", n),
    !dmj_in_literal(n), !dmj_in_meta_call(n).
.decl dmj_in_literal(n: node)
dmj_in_literal(n) :- ann_node(_, n), within(n, l), kind(l, "subscript"), field(l, "value", v), leaf_name(v, "Literal").
dmj_in_literal(n) :- ann_node(_, n), within(n, l), kind(l, "generic_type"), child(l, v, 0), leaf_name(v, "Literal").
.decl dmj_in_meta_call(n: node)
dmj_in_meta_call(n) :- ann_node(_, n), within(n, k), kind(k, "call"), !field(k, "function", n).
// dmj_ann_serialized(t): annotation t carries a serializer that runs in Python mode.
.decl dmj_serializer_fn(x: symbol)
dmj_serializer_fn("PlainSerializer"). dmj_serializer_fn("WrapSerializer").
.decl dmj_ann_serialized(t: node)
dmj_ann_serialized(t) :- ann_node(t, k), kind(k, "call"), field(k, "function", f), leaf_name(f, x),
    dmj_serializer_fn(x), !dmj_json_only(k).
// dmj_json_only(k): serializer call k (or field_serializer decorator) runs only when dumping to JSON.
.decl dmj_json_only(k: node)
dmj_json_only(k) :- call_arg(k, -1, "when_used", v), str(v, w), (w = "json" ; w = "json-unless-none").
// dmj_excluded(a): field a is left out of every dump: `Field(exclude=True)`, as its value or in Annotated.
.decl dmj_excluded(a: node)
dmj_excluded(a) :- pd_field(_, _, a, _), field(a, "right", v), unparen(v, k), pd_field_call(k),
    call_arg(k, -1, "exclude", e), kind(e, "true").
dmj_excluded(a) :- pd_field(_, _, a, t), ann_node(t, k), pd_field_call(k), call_arg(k, -1, "exclude", e), kind(e, "true").

// ---- models: which fields the dict keeps as Python objects -------------------------------------------------------
// dmj_open_model(c): a model whose dump the rule cannot follow: it (or a run base) defines model_dump or dict, has a
// @model_serializer, or sets json_encoders.
.decl dmj_open_model(c: node)
dmj_open_model(c) :- pd_model(c), dmj_own_open(c).
dmj_open_model(c) :- pd_model_super(c, b), dmj_own_open(b).
dmj_open_model(c) :- pd_config_of(c, "json_encoders", _).
.decl dmj_own_open(c: node)
dmj_own_open(c) :- kind(f, "function_definition"), nearest(f, c, scope), kind(c, "class_definition"), def_name(f, x),
    (x = "model_dump" ; x = "dict").
dmj_own_open(c) :- kind(f, "function_definition"), nearest(f, c, scope), kind(c, "class_definition"), decorator(f, e0),
    unparen(e0, e), (field(e, "function", d) ; d = e), leaf_name(d, "model_serializer").
// dmj_field(c, x, a, t): model c's effective field x: its own, or a base's that c does not redeclare.
.decl dmj_field(c: node, x: symbol, a: node, t: node)
dmj_field(c, x, a, t) :- pd_field(c, x, a, t).
dmj_field(c, x, a, t) :- pd_model_super(c, b), pd_field(b, x, a, t), !pd_field(c, x, _, _).
// dmj_field_serialized(c, x): a @field_serializer of c or of a run base names field x (or "*"), outside JSON-only use.
.decl dmj_field_serialized(c: node, x: symbol)
dmj_field_serialized(c, x) :- pd_model(c), dmj_own_field_ser(c, x).
dmj_field_serialized(c, x) :- pd_model_super(c, b), dmj_own_field_ser(b, x).
.decl dmj_own_field_ser(c: node, x: symbol)
dmj_own_field_ser(c, x) :- kind(f, "function_definition"), nearest(f, c, scope), kind(c, "class_definition"),
    decorator(f, e0), unparen(e0, e), kind(e, "call"), field(e, "function", d), leaf_name(d, "field_serializer"),
    !dmj_json_only(e), posarg(e, _, s), str(s, x).
// dmj_rewritten(c, x): code of c or of a run base can replace field x's value after validation, with a type the rule
// does not follow: a method assigns `self.x = ...` (an after model validator's `self.host = str(self.host)`), or an
// after, plain or wrap field validator for x returns its own value.
.decl dmj_rewritten(c: node, x: symbol)
dmj_rewritten(c, x) :- pd_model(c), dmj_own_rewrite(c, x).
dmj_rewritten(c, x) :- pd_model_super(c, b), dmj_own_rewrite(b, x).
.decl dmj_own_rewrite(b: node, x: symbol)
dmj_own_rewrite(b, x) :- kind(b, "class_definition"), kind(f, "function_definition"), nearest(f, b, scope),
    within(a, f), kind(a, "assignment"), field(a, "left", l), attr_of(l, o, x), text(o, "self").
dmj_own_rewrite(b, x) :- pd_validator(f, b, api, m), (api = "field_validator" ; api = "validator"), m != "before",
    pd_validator_deco(f, api, e), kind(e, "call"), posarg(e, _, s), str(s, x).
// dmj_live_field(c, x, t): a field of c that the dump keeps, with annotation t (a computed field's return type too).
.decl dmj_live_field(c: node, x: symbol, t: node)
dmj_live_field(c, x, t) :- dmj_field(c, x, a, t), !dmj_excluded(a), !dmj_field_serialized(c, x),
    !dmj_field_serialized(c, "*"), !dmj_ann_serialized(t), !dmj_rewritten(c, x), !dmj_rewritten(c, "*").
dmj_live_field(c, x, t) :- pd_model(c), (b = c ; pd_model_super(c, b)), kind(f, "function_definition"),
    nearest(f, b, scope), decorator(f, e0), unparen(e0, e), (field(e, "function", d) ; d = e),
    leaf_name(d, "computed_field"), def_name(f, x), field(f, "return_type", t), !dmj_field_serialized(c, x),
    !dmj_ann_serialized(t).
// dmj_direct(c, n, desc): model c's live field holds, at name n of its annotation, a type json rejects.
.decl dmj_direct(c: node, n: node, desc: symbol)
dmj_direct(c, n, desc) :- dmj_live_field(c, x, t), !dmj_open_model(c), dmj_ann_ref(t, n), dmj_named_bad(n, l, u),
    dmj_kind_applies(c, u), desc = cat(x, ": ", l).
// dmj_kind_applies(c, u): types of kind u (0 always, 1 a URL, 2 a plain enum) stay Python objects in c's dump: a
// plain enum is its value with use_enum_values=True, and a URL type is a str under Pydantic 1.
.decl dmj_kind_applies(c: node, u: number)
dmj_kind_applies(c, 0) :- pd_model(c).
dmj_kind_applies(c, 1) :- pd_model(c), docof(c, d), !pd_v1_doc(d).
dmj_kind_applies(c, 2) :- pd_model(c), !dmj_enum_values(c).
.decl dmj_enum_values(c: node)
dmj_enum_values(c) :- pd_config_of(c, "use_enum_values", v), kind(v, "true").
// dmj_nested(c, n, c2): model c's live field holds model c2 at name n (alone, optional, or in a list or dict).
.decl dmj_nested(c: node, n: node, c2: node)
dmj_nested(c, n, c2) :- dmj_live_field(c, _, t), !dmj_open_model(c), dmj_ann_ref(t, n), pd_class_ref(n, c2), c2 != c.
// dmj_bad(c): model c's dump holds a value json rejects, in its own fields or a nested model's.
.decl dmj_bad(c: node)
dmj_bad(c) :- dmj_direct(c, _, _).
dmj_bad(c) :- dmj_nested(c, _, c2), dmj_bad(c2).
// dmj_witness(c, desc): one field to name, the first in the source: a direct one, else a nested model's (by the
// nested model's own first direct field when it has one).
.decl dmj_witness(c: node, desc: symbol)
dmj_witness(c, desc) :- dmj_direct_witness(c, desc).
dmj_witness(c, desc) :- dmj_bad(c), !dmj_direct(c, _, _), k = min n : { dmj_nested(c, n, c2), dmj_bad(c2) },
    dmj_nested(c, k, c2), dmj_bad(c2), dmj_nested_desc(c, k, c2, desc).
.decl dmj_direct_witness(c: node, desc: symbol)
dmj_direct_witness(c, desc) :- dmj_direct(c, _, _), k = min n : { dmj_direct(c, n, _) }, dmj_direct(c, k, desc).
.decl dmj_nested_desc(c: node, n: node, c2: node, desc: symbol)
dmj_nested_desc(c, n, c2, desc) :- dmj_nested(c, n, c2), dmj_live_field(c, x, t), ann_node(t, n), def_name(c2, y),
    dmj_direct_witness(c2, w), desc = cat(x, " (", y, ") -> ", w).
dmj_nested_desc(c, n, c2, desc) :- dmj_nested(c, n, c2), dmj_live_field(c, x, t), ann_node(t, n), def_name(c2, y),
    !dmj_direct(c2, _, _), desc = cat(x, " (", y, ", through its nested models)").

// ---- the dump ----------------------------------------------------------------------------------------------------
// dmj_receiver(o, c): o holds an instance of model c.
.decl dmj_receiver(o: node, c: node)
dmj_receiver(o, c) :- pd_instance(o, c).
// the loop variable of a comprehension or a for loop over a parameter annotated as a collection of c:
// `[e.model_dump() for e in events]` or `for e in events: ...` with `events: list[Event]`
dmj_receiver(o, c) :- kind(o, "identifier"), text(o, x), look(o, x, u), kind(u, "list_comprehension"),
    child(u, fc, _), kind(fc, "for_in_clause"), field(fc, "left", l), text(l, x), field(fc, "right", r),
    dmj_iter_model(r, c).
dmj_receiver(o, c) :- kind(o, "identifier"), text(o, x), look(o, x, f), kind(fs, "for_statement"),
    field(fs, "left", l), text(l, x), field(fs, "right", r), dmj_iter_model(r, c), field(fs, "body", b), within(o, b),
    !asg(f, x, _, _), !dmj_other_loop(f, x, fs).
// dmj_iter_model(r, c): r names a parameter, never reassigned, whose annotation holds model c (`list[Event]`).
.decl dmj_iter_model(r: node, c: node)
dmj_iter_model(r0, c) :- unparen(r0, r), kind(r, "identifier"), text(r, y), look(r, y, f), sig_param(f, _, nm, _, _, t, _),
    text(nm, y), !asg(f, y, _, _), ann_node(t, n), pd_class_ref(n, c), !dmj_in_literal(n).
// dmj_other_loop(f, x, fs): another for loop of f binds x too.
.decl dmj_other_loop(f: node, x: symbol, fs: node)
dmj_other_loop(f, x, fs) :- kind(fs, "for_statement"), field(fs, "left", l), text(l, x), kind(g, "for_statement"),
    g != fs, field(g, "left", l2), text(l2, x), def_frame(fs, f), def_frame(g, f).
// dmj_dump(k, c): call k dumps model c in Python mode, with every field.
.decl dmj_dump(k: node, c: node)
dmj_dump(k, c) :- kind(k, "call"), field(k, "function", f), attr_of(f, o0, m), (m = "model_dump" ; m = "dict"),
    unparen(o0, o), dmj_receiver(o, c), pd_model(c), dmj_python_mode(k), !call_arg(k, -1, "include", _),
    !call_arg(k, -1, "exclude", _), !dmj_splat(k).
.decl dmj_python_mode(k: node)
dmj_python_mode(k) :- kind(k, "call"), !call_arg(k, -1, "mode", _).
dmj_python_mode(k) :- call_arg(k, -1, "mode", v), str(v, "python").
// dmj_splat(k): call k has `*args` or `**kwargs`, which may carry mode, default or cls.
.decl dmj_splat(k: node)
dmj_splat(k) :- kind(k, "call"), field(k, "arguments", al), child(al, s, _),
    (kind(s, "dictionary_splat") ; kind(s, "list_splat")).

// dmj_carries(e, k): expression e holds the dict of dump k: e is the dump, a dict literal with it as a value or a
// `**` splat, a list or tuple literal with it as an item, a list comprehension whose body it is, or a name the scope
// last assigned to one of these and does not change in place.
.decl dmj_carries(e: node, k: node)
dmj_carries(e, k) :- unparen(e, k), dmj_dump(k, _).
dmj_carries(e, k) :- unparen(e, u), kind(u, "dictionary"), child(u, p, _), kind(p, "pair"), field(p, "value", v),
    dmj_carries(v, k).
dmj_carries(e, k) :- unparen(e, u), kind(u, "dictionary"), child(u, s, _), kind(s, "dictionary_splat"), child(s, v, _),
    dmj_carries(v, k).
dmj_carries(e, k) :- unparen(e, u), (kind(u, "list") ; kind(u, "tuple")), child(u, v, _), dmj_carries(v, k).
dmj_carries(e, k) :- unparen(e, u), kind(u, "list_comprehension"), field(u, "body", v), dmj_carries(v, k).
dmj_carries(e, k) :- unparen(e, u), kind(u, "identifier"), latest_assign(u, x, a), rasg(s, x, v, a),
    !dmj_mutated(s, x), dmj_carries(v, k).
// dmj_mutated(s, x): scope s changes the dict named x in place: `x[...] = ...`, `del x[...]`, `x.update(...)`, ...
.decl dmj_mutated(s: node, x: symbol)
dmj_mutated(s, x) :- kind(g, "subscript"), field(g, "value", v), kind(v, "identifier"), text(v, x), look(v, x, s),
    (expr_ctx(g, "store") ; expr_ctx(g, "del")).
dmj_mutated(s, x) :- kind(k, "call"), field(k, "function", f), attr_of(f, v, m), kind(v, "identifier"), text(v, x),
    look(v, x, s), dmj_mutator(m).
.decl dmj_mutator(m: symbol)
dmj_mutator("update"). dmj_mutator("pop"). dmj_mutator("setdefault"). dmj_mutator("__setitem__").
dmj_mutator("popitem"). dmj_mutator("clear").

// ---- the sinks ---------------------------------------------------------------------------------------------------
// dmj_sink(s, e, what): call s encodes argument e with the standard library's json.
.decl dmj_sink(s: node, e: node, what: symbol)
dmj_sink(s, e, what) :- kind(s, "call"), field(s, "function", f), sym_of(f, q), (q = "json.dumps" ; q = "json.dump"),
    !dmj_run_json(), (posarg(s, 0, e) ; call_arg(s, -1, "obj", e)), !call_arg(s, -1, "default", _),
    !call_arg(s, -1, "cls", _), !dmj_splat(s), what = cat(q, "()").
dmj_sink(s, e, what) :- kind(s, "call"), field(s, "function", f), sym_of(f, q), dmj_http_fn(q),
    call_arg(s, -1, "json", e), what = cat(q, "(json=...)").
dmj_sink(s, e, what) :- kind(s, "call"), field(s, "function", f), attr_of(f, o0, m), dmj_verb(m), unparen(o0, o),
    dmj_client(o, lib), call_arg(s, -1, "json", e), what = cat("the ", lib, " client's ", m, "(json=...)").
// a module of the run named `json` would shadow the standard library's
.decl dmj_run_json()
dmj_run_json() :- modname(_, "json").
.decl dmj_verb(m: symbol)
dmj_verb("get"). dmj_verb("post"). dmj_verb("put"). dmj_verb("patch"). dmj_verb("delete"). dmj_verb("head").
dmj_verb("options"). dmj_verb("request"). dmj_verb("stream").
.decl dmj_http_fn(q: symbol)
dmj_http_fn(q) :- dmj_verb(m), (q = cat("requests.", m) ; q = cat("requests.api.", m) ; q = cat("httpx.", m)).
.decl dmj_client_ctor(q: symbol, lib: symbol)
dmj_client_ctor("requests.Session", "requests"). dmj_client_ctor("requests.sessions.Session", "requests").
dmj_client_ctor("requests.session", "requests"). dmj_client_ctor("httpx.Client", "httpx").
dmj_client_ctor("httpx.AsyncClient", "httpx").
.decl dmj_client_new(v: node, lib: symbol)
dmj_client_new(v, lib) :- unparen(v, k), kind(k, "call"), field(k, "function", f), sym_of(f, q), dmj_client_ctor(q, lib).
// dmj_client(o, lib): o is a client built in place, a name assigned one, or a `with ... as` name bound to one.
.decl dmj_client(o: node, lib: symbol)
dmj_client(o, lib) :- dmj_client_new(o, lib).
dmj_client(o, lib) :- kind(o, "identifier"), text(o, x), look(o, x, s), asg(s, x, v, _), dmj_client_new(v, lib).
dmj_client(o, lib) :- kind(o, "identifier"), text(o, x), look(o, x, s), kind(w, "with_item"), nearest(w, s, scope),
    within(k, w), dmj_client_new(k, lib), within(nm, w), kind(nm, "identifier"), text(nm, x), !within(nm, k).

DumpNotJson(k, mn, desc, what) :- dmj_sink(_, e, what), dmj_carries(e, k), dmj_dump(k, c), dmj_bad(c),
    dmj_witness(c, desc), def_name(c, mn), docof(k, d), !pd_test_doc(d).

