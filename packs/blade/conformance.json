{
  "pack": "blade",
  "family": "blade",
  "capabilities": ["syntax", "value", "compare", "arguments", "scope", "calls", "formatArgs", "phpDoc"],
  "tools": [
    { "name": "bladestan", "version": "0.11.7" },
    { "name": "blade-parser", "version": "2.1.0" },
    { "name": "tlint", "version": "9.7.0" }
  ],
  "exemptCapabilities": [
    {
      "capability": "calls",
      "reason": "No pinned reference linter has a rule that reads a template's callees transitively, which is what Rerail's calls capability answers.",
      "evidence": "Checked Bladestan 0.11.7, tlint 9.7.0 and stillat/blade-parser 2.1.0. Bladestan runs PHPStan 2.2.16's rules over the compiled template, and every PHPStan rule that looks at a call (CallToFunctionParametersRule, the impossible-check rules, RandomIntParametersRule) reads only the direct callee's declaration or name, as for the PHP pack. tlint's Blade lints match directive names and echo spacing line by line. blade-parser's only rule over what a template reaches, RecursiveIncludeValidator, compares an `@include`'s literal view name with the template's own file name: one direct edge, never a chain. None answers whether a template reaches a call of X through any chain of calls.",
      "coveredBy": [
        "T2: native/src/code_rule_dsl/blade/tests.rs (blade_calls_are_the_php_blade_compiles, blade_calls_reach_workspace_definitions) and the PHP calls oracle the view's calls go through (fixtures/php/calls/php, calls::php_tests::php_calls_agree_with_phpstan_and_the_runtime)",
        "T3: benchmark_blade_region_parity (the view program a template's calls are summarized from: every byte Blade copies from laravel's 128 templates and from BookStack's, Filament's and Bagisto's 1,076 agrees, and the only bytes the view reads that Blade does not copy are Bagisto's strings holding `@{{ }}`) and benchmark_php_calls_corpus (the PHP calls code a template's calls go through)"
      ]
    }
  ],
  "rules": [
    {"id": "bladestan-variable-undefined", "upstream": {"tool": "bladestan", "rule": "variable.undefined"}, "policy": "candidates/rules/bladestan-variable-undefined.json", "capabilities": ["scope"], "match": "line", "examples": {"caught": {"path": "resources/views/orders/index.blade.php", "text": "@php\n    $money = function ($cents) {\n        return $currency . ' ' . number_format($cents / 100, 2);\n    };\n@endphp\n<p>{{ $money($order->total) }}</p>\n"}, "passes": {"path": "resources/views/orders/index.blade.php", "text": "@php\n    $money = function ($cents) use ($currency) {\n        return $currency . ' ' . number_format($cents / 100, 2);\n    };\n@endphp\n<p>{{ $money($order->total) }}</p>\n"}}},
    {"id": "bladestan-argument-sprintf", "upstream": {"tool": "bladestan", "rule": "argument.sprintf"}, "policy": "candidates/rules/bladestan-argument-sprintf.json", "capabilities": ["formatArgs", "scope", "syntax"], "match": "line", "examples": {"caught": {"path": "resources/views/posts/pager.blade.php", "text": "<p>{{ sprintf('Page %d of %d', $page) }}</p>\n"}, "passes": {"path": "resources/views/posts/pager.blade.php", "text": "<p>{{ sprintf('Page %d of %d', $page, $pages) }}</p>\n"}}},
    {"id": "bladestan-array-duplicate-key", "upstream": {"tool": "bladestan", "rule": "array.duplicateKey"}, "policy": "candidates/rules/bladestan-array-duplicate-key.json", "capabilities": ["compare", "syntax"], "match": "line", "examples": {"caught": {"path": "resources/views/posts/status.blade.php", "text": "@php\n    $labels = ['draft' => 'Draft', 'published' => 'Published', 'draft' => 'Pending review'];\n@endphp\n<span>{{ $labels[$post->status] }}</span>\n"}, "passes": {"path": "resources/views/posts/status.blade.php", "text": "@php\n    $labels = ['draft' => 'Draft', 'published' => 'Published', 'pending' => 'Pending review'];\n@endphp\n<span>{{ $labels[$post->status] }}</span>\n"}}},
    {"id": "bladestan-random-int-parameters", "upstream": {"tool": "bladestan", "rule": "argument.type"}, "policy": "candidates/rules/bladestan-random-int-parameters.json", "capabilities": ["arguments", "compare", "value", "scope"], "match": "line", "examples": {"caught": {"path": "resources/views/auth/captcha.blade.php", "text": "<input type=\"hidden\" name=\"nonce\" value=\"{{ random_int(999999, 100000) }}\">\n"}, "passes": {"path": "resources/views/auth/captcha.blade.php", "text": "<input type=\"hidden\" name=\"nonce\" value=\"{{ random_int(100000, 999999) }}\">\n"}}},
    {"id": "bladestan-if-always-true", "upstream": {"tool": "bladestan", "rule": "if.alwaysTrue"}, "policy": "rules/bladestan-if-always-true.json", "capabilities": ["value", "phpDoc"], "match": "line"},
    {"id": "bladestan-if-always-false", "upstream": {"tool": "bladestan", "rule": "if.alwaysFalse"}, "policy": "candidates/rules/bladestan-if-always-false.json", "capabilities": ["value", "phpDoc"], "match": "line", "examples": {"caught": {"path": "resources/views/layouts/banner.blade.php", "text": "@php\n    $showBanner = false;\n@endphp\n@if ($showBanner)\n    <div class=\"banner\">{{ $message }}</div>\n@endif\n"}, "passes": {"path": "resources/views/layouts/banner.blade.php", "text": "@if ($showBanner)\n    <div class=\"banner\">{{ $message }}</div>\n@endif\n"}}},
    {"id": "bladestan-identical-always-true", "upstream": {"tool": "bladestan", "rule": "identical.alwaysTrue"}, "policy": "rules/bladestan-identical-always-true.json", "capabilities": ["value", "syntax"], "match": "line"},
    {"id": "bladestan-missing-function-return-type", "upstream": {"tool": "bladestan", "rule": "missingType.return"}, "policy": "candidates/rules/bladestan-missing-function-return-type.json", "capabilities": ["phpDoc", "syntax"], "match": "line", "examples": {"caught": {"path": "resources/views/users/card.blade.php", "text": "@php\n    function initials($name)\n    {\n        return strtoupper(substr($name, 0, 1));\n    }\n@endphp\n<span>{{ initials($user->name) }}</span>\n"}, "passes": {"path": "resources/views/users/card.blade.php", "text": "@php\n    function initials(string $name): string\n    {\n        return strtoupper(substr($name, 0, 1));\n    }\n@endphp\n<span>{{ initials($user->name) }}</span>\n"}}},
    {"id": "tlint-no-json-directive", "upstream": {"tool": "tlint", "rule": "NoJsonDirective"}, "policy": "candidates/rules/tlint-no-json-directive.json", "capabilities": ["syntax"], "match": "line", "examples": {"caught": {"path": "resources/views/profile.blade.php", "text": "<script>\n    const user = @json($user);\n</script>\n"}, "passes": {"path": "resources/views/profile.blade.php", "text": "<script>\n    const user = {{ Js::from($user) }};\n</script>\n"}}},
    {"id": "tlint-no-dump-directives", "upstream": {"tool": "tlint", "rule": "NoDumpDirectives"}, "policy": "rules/tlint-no-dump-directives.json", "capabilities": ["syntax"], "match": "line"},
    {"id": "tlint-no-ray-directive", "upstream": {"tool": "tlint", "rule": "NoRayDirective"}, "policy": "rules/tlint-no-ray-directive.json", "capabilities": ["syntax"], "match": "line"},
    {"id": "tlint-space-after-blade-directives", "upstream": {"tool": "tlint", "rule": "SpaceAfterBladeDirectives"}, "policy": "rules/tlint-space-after-blade-directives.json", "capabilities": ["syntax"], "match": "line"},
    {"id": "tlint-spaces-around-blade-render-content", "upstream": {"tool": "tlint", "rule": "SpacesAroundBladeRenderContent"}, "policy": "rules/tlint-spaces-around-blade-render-content.json", "capabilities": ["syntax"], "match": "line"},
    {"id": "blade-parser-debug-directive", "upstream": {"tool": "blade-parser", "rule": "DebugDirectiveValidator"}, "policy": "rules/blade-parser-debug-directive.json", "capabilities": ["syntax"], "match": "line"},
    {"id": "blade-parser-duplicate-condition-expressions", "upstream": {"tool": "blade-parser", "rule": "DuplicateConditionExpressionsValidator"}, "policy": "rules/blade-parser-duplicate-condition-expressions.json", "capabilities": ["compare", "syntax"], "match": "line"},
    {"id": "blade-parser-for-else-structure", "upstream": {"tool": "blade-parser", "rule": "ForElseStructureValidator"}, "policy": "rules/blade-parser-for-else-structure.json", "capabilities": ["syntax"], "match": "line"},
    {"id": "blade-parser-component-shorthand-variable-parameter", "upstream": {"tool": "blade-parser", "rule": "ComponentShorthandVariableParameterValidator"}, "policy": "rules/blade-parser-component-shorthand-variable-parameter.json", "capabilities": ["syntax"], "match": "line"}
  ]
}
