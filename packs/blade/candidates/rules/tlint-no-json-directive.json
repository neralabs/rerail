{
  "format": "rerail.policy/v1",
  "id": "tlint-no-json-directive",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid the @json Blade directive; use escaped echo output or an explicit json_encode() call instead.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "embedded": "compiled-view",
          "rule": {
            "kind": "function_call_expression",
            "host": {
              "regex": "^@(json)\\b"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "NoJsonDirective",
        "message": "Replace this @json directive with escaped {{ }} output or an explicit json_encode() call."
      }
    }
  ]
}
