{
  "format": "rerail.policy/v1",
  "id": "tlint-space-after-blade-directives",
  "revision": 1,
  "mode": "steer",
  "description": "tlint 9.7.0 SpaceAfterBladeDirectives: a control structure directive (@if, @elseif, @unless, @for, @foreach, @forelse, @while) whose name the next character does not separate with a space or tab; read from the view, whose control flow spans the directive it compiles.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "any": [
              {
                "kind": "if_statement"
              },
              {
                "kind": "else_if_clause"
              },
              {
                "kind": "for_statement"
              },
              {
                "kind": "foreach_statement"
              },
              {
                "kind": "while_statement"
              }
            ],
            "regex": "^@(if|elseif|unless|for|foreach|forelse|while)($|[^ \\t\\w])"
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "SpaceAfterBladeDirectives",
        "message": "Put a space between blade control structure names and the opening paren: `@if(` -> `@if (`"
      }
    }
  ]
}
