{
  "format": "rerail.policy/v1",
  "id": "tlint-no-dump-directives",
  "revision": 2,
  "mode": "steer",
  "description": "tlint 9.7.0 NoDumpDirectives: a @dd or @dump directive.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "kind": "directive_name",
            "regex": "^@(dd|dump)$"
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "NoDumpDirectives",
        "message": "Do not use the @dump or @dd directives."
      }
    }
  ]
}
