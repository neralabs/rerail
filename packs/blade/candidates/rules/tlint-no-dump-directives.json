{
  "format": "rerail.policy/v1",
  "id": "tlint-no-dump-directives",
  "revision": 2,
  "mode": "steer",
  "description": "Remove @dd and @dump directives from Blade templates before shipping; they dump debug output into the page.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "kind": "directive_name",
            "regex": "^@(dd|dump)$"
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "NoDumpDirectives",
        "message": "Remove this @dd or @dump directive before shipping."
      }
    }
  ]
}
