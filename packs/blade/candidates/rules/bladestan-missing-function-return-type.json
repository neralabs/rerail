{
  "format": "rerail.policy/v1",
  "id": "bladestan-missing-function-return-type",
  "revision": 1,
  "mode": "steer",
  "description": "Bladestan 0.11.7 (PHPStan 2.2.16 over the compiled template) missingType.return as MissingFunctionReturnTypehintRule reports it: a function declaration (not a method or closure) with neither a native return type nor a PHPDoc @return, @phpstan-return or @psalm-return type in its doc comment.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "embedded": "compiled-view",
          "rule": {
            "kind": "function_definition",
            "not": {
              "has": {
                "field": "return_type",
                "regex": "."
              }
            },
            "all": [
              {
                "not": {
                  "follows": {
                    "stopBy": {
                      "not": {
                        "kind": "comment"
                      }
                    },
                    "kind": "comment",
                    "parse": {
                      "grammar": "phpDoc",
                      "has": {
                        "stopBy": "end",
                        "kind": "return_tag_value"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "missingType.return",
        "message": "Function has no return type specified."
      }
    }
  ]
}
