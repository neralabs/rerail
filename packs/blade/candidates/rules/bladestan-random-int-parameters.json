{
  "format": "rerail.policy/v1",
  "id": "bladestan-random-int-parameters",
  "revision": 1,
  "mode": "steer",
  "description": "Pass random_int() in Blade templates a minimum no greater than its maximum; reversed bounds throw an error at render time.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "embedded": "compiled-view",
          "rule": {
            "kind": "function_call_expression",
            "has": {
              "field": "function",
              "resolves": {
                "import": [
                  "random_int"
                ]
              }
            },
            "arguments": {
              "signature": [
                "min",
                "max"
              ],
              "bind": {
                "MIN": "min",
                "MAX": "max"
              }
            },
            "compare": {
              "left": "MIN",
              "op": "gt",
              "right": "MAX",
              "text": "value"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "argument.type",
        "message": "Parameter #1 $min of function random_int expects lower number than parameter #2 $max."
      }
    }
  ]
}
