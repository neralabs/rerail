{
  "format": "rerail.policy/v1",
  "id": "tlint-no-ray-directive",
  "revision": 2,
  "mode": "steer",
  "description": "tlint 9.7.0 NoRayDirective: a @ray directive (spatie/laravel-ray's, which core Blade does not compile: read from the template's tree, where every `@name` is a directive, not its view).",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "kind": "directive_name",
            "regex": "^@(ray)$"
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "NoRayDirective",
        "message": "Do not use the @ray directive."
      }
    }
  ]
}
