{
  "format": "rerail.rule-pack/v1",
  "id": "blade",
  "name": "Blade",
  "category": "language",
  "covers": "17 Bladestan, tlint and stillat/blade-parser rules ported to Rerail, each scored against the tool's own recorded findings on its test fixtures.",
  "reason": "matches Blade templates",
  "match": {
    "any": [
      {
        "files": [
          "**/*.blade.php"
        ],
        "label": "*.blade.php files"
      }
    ]
  },
  "rules": [
    {
      "id": "bladestan-variable-undefined",
      "document": "rules/bladestan-variable-undefined.json",
      "title": "Bladestan variable.undefined: Undefined variable",
      "group": "Bladestan",
      "examples": {
        "caught": {
          "path": "resources/views/orders/index.blade.php",
          "text": "@php\n    $money = function ($cents) {\n        return $currency . ' ' . number_format($cents / 100, 2);\n    };\n@endphp\n<p>{{ $money($order->total) }}</p>\n"
        },
        "passes": {
          "path": "resources/views/orders/index.blade.php",
          "text": "@php\n    $money = function ($cents) use ($currency) {\n        return $currency . ' ' . number_format($cents / 100, 2);\n    };\n@endphp\n<p>{{ $money($order->total) }}</p>\n"
        }
      }
    },
    {
      "id": "bladestan-argument-sprintf",
      "document": "rules/bladestan-argument-sprintf.json",
      "title": "Bladestan argument.sprintf: sprintf() arguments and format disagree",
      "group": "Bladestan",
      "examples": {
        "caught": {
          "path": "resources/views/posts/pager.blade.php",
          "text": "<p>{{ sprintf('Page %d of %d', $page) }}</p>\n"
        },
        "passes": {
          "path": "resources/views/posts/pager.blade.php",
          "text": "<p>{{ sprintf('Page %d of %d', $page, $pages) }}</p>\n"
        }
      }
    },
    {
      "id": "bladestan-array-duplicate-key",
      "document": "rules/bladestan-array-duplicate-key.json",
      "title": "Bladestan array.duplicateKey: Duplicate array key",
      "group": "Bladestan",
      "examples": {
        "caught": {
          "path": "resources/views/posts/status.blade.php",
          "text": "@php\n    $labels = ['draft' => 'Draft', 'published' => 'Published', 'draft' => 'Pending review'];\n@endphp\n<span>{{ $labels[$post->status] }}</span>\n"
        },
        "passes": {
          "path": "resources/views/posts/status.blade.php",
          "text": "@php\n    $labels = ['draft' => 'Draft', 'published' => 'Published', 'pending' => 'Pending review'];\n@endphp\n<span>{{ $labels[$post->status] }}</span>\n"
        }
      }
    },
    {
      "id": "bladestan-random-int-parameters",
      "document": "rules/bladestan-random-int-parameters.json",
      "title": "Bladestan argument.type: random_int() minimum above maximum",
      "group": "Bladestan",
      "examples": {
        "caught": {
          "path": "resources/views/auth/captcha.blade.php",
          "text": "<input type=\"hidden\" name=\"nonce\" value=\"{{ random_int(999999, 100000) }}\">\n"
        },
        "passes": {
          "path": "resources/views/auth/captcha.blade.php",
          "text": "<input type=\"hidden\" name=\"nonce\" value=\"{{ random_int(100000, 999999) }}\">\n"
        }
      }
    },
    {
      "id": "bladestan-if-always-true",
      "document": "rules/bladestan-if-always-true.json",
      "title": "Bladestan if.alwaysTrue: If condition always true",
      "group": "Bladestan"
    },
    {
      "id": "bladestan-if-always-false",
      "document": "rules/bladestan-if-always-false.json",
      "title": "Bladestan if.alwaysFalse: If condition always false",
      "group": "Bladestan",
      "examples": {
        "caught": {
          "path": "resources/views/layouts/banner.blade.php",
          "text": "@php\n    $showBanner = false;\n@endphp\n@if ($showBanner)\n    <div class=\"banner\">{{ $message }}</div>\n@endif\n"
        },
        "passes": {
          "path": "resources/views/layouts/banner.blade.php",
          "text": "@if ($showBanner)\n    <div class=\"banner\">{{ $message }}</div>\n@endif\n"
        }
      }
    },
    {
      "id": "bladestan-identical-always-true",
      "document": "rules/bladestan-identical-always-true.json",
      "title": "Bladestan identical.alwaysTrue: Strict comparison always true",
      "group": "Bladestan"
    },
    {
      "id": "bladestan-missing-function-return-type",
      "document": "rules/bladestan-missing-function-return-type.json",
      "title": "Bladestan missingType.return: Function without a return type",
      "group": "Bladestan",
      "examples": {
        "caught": {
          "path": "resources/views/users/card.blade.php",
          "text": "@php\n    function initials($name)\n    {\n        return strtoupper(substr($name, 0, 1));\n    }\n@endphp\n<span>{{ initials($user->name) }}</span>\n"
        },
        "passes": {
          "path": "resources/views/users/card.blade.php",
          "text": "@php\n    function initials(string $name): string\n    {\n        return strtoupper(substr($name, 0, 1));\n    }\n@endphp\n<span>{{ initials($user->name) }}</span>\n"
        }
      }
    },
    {
      "id": "tlint-no-json-directive",
      "document": "rules/tlint-no-json-directive.json",
      "title": "tlint NoJsonDirective: No @json directive",
      "group": "tlint",
      "examples": {
        "caught": {
          "path": "resources/views/profile.blade.php",
          "text": "<script>\n    const user = @json($user);\n</script>\n"
        },
        "passes": {
          "path": "resources/views/profile.blade.php",
          "text": "<script>\n    const user = {{ Js::from($user) }};\n</script>\n"
        }
      }
    },
    {
      "id": "tlint-no-dump-directives",
      "document": "rules/tlint-no-dump-directives.json",
      "title": "tlint NoDumpDirectives: No @dd or @dump directive",
      "group": "tlint"
    },
    {
      "id": "tlint-no-ray-directive",
      "document": "rules/tlint-no-ray-directive.json",
      "title": "tlint NoRayDirective: No @ray directive",
      "group": "tlint"
    },
    {
      "id": "tlint-space-after-blade-directives",
      "document": "rules/tlint-space-after-blade-directives.json",
      "title": "tlint SpaceAfterBladeDirectives: Space after control structure directives",
      "group": "tlint",
      "examples": {
        "caught": {
          "path": "resources/views/profile.blade.php",
          "text": "@if($user)\n    <p>{{ $user->name }}</p>\n@endif\n"
        },
        "passes": {
          "path": "resources/views/profile.blade.php",
          "text": "@if ($user)\n    <p>{{ $user->name }}</p>\n@endif\n"
        }
      }
    },
    {
      "id": "tlint-spaces-around-blade-render-content",
      "document": "rules/tlint-spaces-around-blade-render-content.json",
      "title": "tlint SpacesAroundBladeRenderContent: One space inside echo delimiters",
      "group": "tlint"
    },
    {
      "id": "blade-parser-debug-directive",
      "document": "rules/blade-parser-debug-directive.json",
      "title": "blade-parser DebugDirectiveValidator: No debug directive",
      "group": "blade-parser"
    },
    {
      "id": "blade-parser-duplicate-condition-expressions",
      "document": "rules/blade-parser-duplicate-condition-expressions.json",
      "title": "blade-parser DuplicateConditionExpressionsValidator: Duplicate @elseif condition",
      "group": "blade-parser"
    },
    {
      "id": "blade-parser-for-else-structure",
      "document": "rules/blade-parser-for-else-structure.json",
      "title": "blade-parser ForElseStructureValidator: @forelse with one @empty",
      "group": "blade-parser"
    },
    {
      "id": "blade-parser-component-shorthand-variable-parameter",
      "document": "rules/blade-parser-component-shorthand-variable-parameter.json",
      "title": "blade-parser ComponentShorthandVariableParameterValidator: Malformed component shorthand attribute",
      "group": "blade-parser"
    }
  ]
}
