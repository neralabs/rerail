{
  "format": "rerail.rule-pack/v1",
  "id": "blade",
  "name": "Blade",
  "category": "language",
  "covers": "7 Bladestan, tlint and stillat/blade-parser rules ported to Rerail, 5 of them on and 2 off until turned on, each scored against the tool's own recorded findings on its test fixtures.",
  "reason": "matches Blade templates",
  "match": {
    "any": [
      {
        "files": [
          "**/*.blade.php"
        ],
        "label": "*.blade.php files"
      }
    ]
  },
  "rules": [
    {
      "id": "bladestan-if-always-true",
      "document": "rules/bladestan-if-always-true.json",
      "title": "Bladestan if.alwaysTrue: If condition always true",
      "group": "Bladestan",
      "on": false
    },
    {
      "id": "bladestan-identical-always-true",
      "document": "rules/bladestan-identical-always-true.json",
      "title": "Bladestan identical.alwaysTrue: Strict comparison always true",
      "group": "Bladestan",
      "on": false
    },
    {
      "id": "tlint-no-dump-directives",
      "document": "rules/tlint-no-dump-directives.json",
      "title": "tlint NoDumpDirectives: No @dd or @dump directive",
      "group": "tlint"
    },
    {
      "id": "tlint-no-ray-directive",
      "document": "rules/tlint-no-ray-directive.json",
      "title": "tlint NoRayDirective: No @ray directive",
      "group": "tlint"
    },
    {
      "id": "blade-parser-debug-directive",
      "document": "rules/blade-parser-debug-directive.json",
      "title": "blade-parser DebugDirectiveValidator: No debug directive",
      "group": "blade-parser"
    },
    {
      "id": "blade-parser-for-else-structure",
      "document": "rules/blade-parser-for-else-structure.json",
      "title": "blade-parser ForElseStructureValidator: @forelse with one @empty",
      "group": "blade-parser"
    },
    {
      "id": "blade-parser-component-shorthand-variable-parameter",
      "document": "rules/blade-parser-component-shorthand-variable-parameter.json",
      "title": "blade-parser ComponentShorthandVariableParameterValidator: Malformed component shorthand attribute",
      "group": "blade-parser"
    }
  ]
}
