{
  "format": "rerail.policy/v1",
  "id": "blade-parser-debug-directive",
  "revision": 2,
  "mode": "steer",
  "description": "stillat/blade-parser 2.1.0 DebugDirectiveValidator: a @dd or @dump directive (CoreDirectiveRetriever::getDebugDirectiveNames).",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "kind": "directive_name",
            "regex": "^@(dd|dump)$"
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "DebugDirectiveValidator",
        "message": "Debug directive detected"
      }
    }
  ]
}
