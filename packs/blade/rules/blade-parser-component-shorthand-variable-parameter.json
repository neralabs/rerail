{
  "format": "rerail.policy/v1",
  "id": "blade-parser-component-shorthand-variable-parameter",
  "revision": 1,
  "mode": "steer",
  "description": "stillat/blade-parser 2.1.0 ComponentShorthandVariableParameterValidator: on an `<x-...>` component, an attribute named `$:...` (a typo for `:$...`) or a shorthand `:$var` given a value.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "kind": "attribute",
            "inside": {
              "stopBy": "neighbor",
              "any": [
                {
                  "kind": "start_tag"
                },
                {
                  "kind": "self_closing_tag"
                }
              ],
              "has": {
                "stopBy": "neighbor",
                "kind": "tag_name",
                "regex": "^x-"
              }
            },
            "any": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "attribute_name",
                  "regex": "^\\$:"
                }
              },
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "attribute_name",
                      "regex": "^:\\$"
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "quoted_attribute_value"
                        },
                        {
                          "kind": "attribute_value"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "ComponentShorthandVariableParameterValidator",
        "message": "Shorthand parameter variable issue"
      }
    }
  ]
}
