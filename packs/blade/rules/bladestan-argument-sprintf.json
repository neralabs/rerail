{
  "format": "rerail.policy/v1",
  "id": "bladestan-argument-sprintf",
  "revision": 1,
  "mode": "steer",
  "description": "Bladestan 0.11.7 argument.sprintf (PHPStan 2.2.16 PrintfParametersRule over the compiled template): a sprintf() call whose known format asks for more or fewer values than it passes, or that PHP refuses.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "missing",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "any": [
              {
                "pattern": "$FN($F)",
                "kind": "function_call_expression",
                "has": {
                  "field": "function",
                  "resolves": {
                    "import": [
                      "sprintf"
                    ]
                  }
                }
              },
              {
                "pattern": "$FN($F, $$$A)",
                "kind": "function_call_expression",
                "has": {
                  "field": "function",
                  "resolves": {
                    "import": [
                      "sprintf"
                    ]
                  }
                }
              }
            ],
            "formatArgs": {
              "style": "printf",
              "string": "F",
              "args": "A",
              "missing": {
                "any": [
                  {
                    "kind": "placeholder"
                  },
                  {
                    "kind": "star"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "argument.sprintf",
        "anchor": "witness.start",
        "message": "Call to sprintf contains more placeholders than values given."
      }
    },
    {
      "id": "unused",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "any": [
              {
                "pattern": "$FN($F)",
                "kind": "function_call_expression",
                "has": {
                  "field": "function",
                  "resolves": {
                    "import": [
                      "sprintf"
                    ]
                  }
                }
              },
              {
                "pattern": "$FN($F, $$$A)",
                "kind": "function_call_expression",
                "has": {
                  "field": "function",
                  "resolves": {
                    "import": [
                      "sprintf"
                    ]
                  }
                }
              }
            ],
            "formatArgs": {
              "style": "printf",
              "string": "F",
              "args": "A",
              "unused": {
                "kind": "argument"
              }
            }
          }
        }
      },
      "violation": {
        "code": "argument.sprintf",
        "anchor": "witness.start",
        "message": "Call to sprintf contains fewer placeholders than values given."
      }
    },
    {
      "id": "invalid",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "any": [
              {
                "pattern": "$FN($F)",
                "kind": "function_call_expression",
                "has": {
                  "field": "function",
                  "resolves": {
                    "import": [
                      "sprintf"
                    ]
                  }
                }
              },
              {
                "pattern": "$FN($F, $$$A)",
                "kind": "function_call_expression",
                "has": {
                  "field": "function",
                  "resolves": {
                    "import": [
                      "sprintf"
                    ]
                  }
                }
              }
            ]
          },
          "constraints": {
            "F": {
              "has": {
                "parse": {
                  "grammar": "printfFormat",
                  "has": {
                    "kind": "error"
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "code": "argument.sprintf",
        "anchor": "witness.start",
        "message": "Call to sprintf contains an invalid placeholder."
      }
    }
  ]
}
