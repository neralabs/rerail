{
  "format": "rerail.policy/v1",
  "id": "blade-parser-for-else-structure",
  "revision": 2,
  "mode": "steer",
  "description": "stillat/blade-parser 2.1.0 ForElseStructureValidator: a @forelse loop with no @empty directive of its own, or more than one.",
  "scope": {
    "include": [
      "**/*.blade.php"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "upstream",
      "forbid": {
        "ast": {
          "language": "blade",
          "rule": {
            "kind": "directive_block",
            "has": {
              "stopBy": "neighbor",
              "field": "start",
              "has": {
                "stopBy": "neighbor",
                "kind": "directive_name",
                "regex": "^@forelse$"
              }
            },
            "not": {
              "count": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "directive",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "directive_name",
                    "regex": "^@empty$"
                  }
                },
                "min": 1,
                "max": 1
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.start",
        "code": "ForElseStructureValidator",
        "message": "Missing or too many [@empty] directives inside [@forelse]"
      }
    }
  ]
}
