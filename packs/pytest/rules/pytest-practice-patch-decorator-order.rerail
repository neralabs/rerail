.policy "pytest-practice-patch-decorator-order" revision 1
.description "Name the mock parameters of stacked patch decorators bottom-up; the decorator nearest the def passes the first mock."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. Stacked `@mock.patch(...)` / `@patch.object(...)` decorators pass their mocks
// bottom-up: the decorator nearest the def gives the first argument (unittest.mock docs, "Nesting patch decorators").
// A test whose mock parameters are named after the targets in top-down order gives each parameter another target's
// mock, so its set-ups and asserts go to the wrong mock and the test checks nothing.
//   @patch("shop.mail.send")
//   @patch("shop.mail.render")
//   def test_notify(mock_send, mock_render):      reported at mock_send: it holds the mock of shop.mail.render
//   def test_notify(mock_render, mock_send):      not reported: bottom-up
//   def test_notify(m1, m2):                      not reported: the names say nothing
// Only decorators that pass a mock count (patch and patch.object without `new`), in their order; marks, patch.dict,
// patch.multiple and patches with a replacement between them are skipped. A target's name is the last dotted part of
// the patch string, or patch.object's attribute; a parameter matches a target when its name contains it, both
// lower-cased with underscores removed (`mock_assert_true` matches `assertTrue`, `mock_email_client` matches
// `EmailClient`). The first N positional parameters after self/cls (N mocks) are read, and the rule reports when every
// one contains its top-down target and one does not contain its bottom-up target.
// Left alone: two targets with the same name; a parameter that contains both of its candidate targets
// (`mock_user` / `mock_user_email` over `user` and `user_email`); fewer positional parameters than mocks; a target
// given as a variable; defs that are not tests (pt_test: test documents only).
// Gaps: patches on a test class (their mocks follow the method's own); patch.multiple with DEFAULT; mocks requested
// through pytest-mock's `mocker`, which are returned, not passed; a swap hidden by a name that matches both targets.

#include "lib/pytest.rerail"

.violation PatchDecoratorOrder(at: node, x: symbol, real: symbol, claimed: symbol, y: symbol) "`{x}` receives the mock of `{real}`, not `{claimed}`: stacked patches pass mocks bottom-up. Reorder the mock parameters bottom-up and rerun the test."

// pdo_inj(f, c, i): test f's i-th decorator from the top is a patch that passes a mock; pdo_rank(f, c, r): it is the
// r-th of those (0 the top one); pdo_n(f, n): f has n of them.
.decl pdo_inj(f: node, c: node, i: number)
pdo_inj(f, c, i) :- pt_test(f), pt_patch_deco(f, c, i), pt_injects(c).
.decl pdo_rank(f: node, c: node, r: number)
pdo_rank(f, c, r) :- pdo_inj(f, c, i), r = count : { pdo_inj(f, c2, i2), i2 < i }.
.decl pdo_n(f: node, n: number)
pdo_n(f, n) :- pdo_inj(f, _, _), n = count : { pdo_inj(f, c2, i2) }.

// pdo_name(c, t, full): patch c replaces `full`, whose name t is matched against parameter names.
.decl pdo_name(c: node, t: symbol, full: symbol)
pdo_name(c, t, full) :- pdo_rank(_, c, _), pt_patch_name(c, full, _),
    t = @replace_all(@replace_all(@lower(full), "^.*\\.", ""), "_", "").
pdo_name(c, t, full) :- pdo_rank(_, c, _), pt_patch_attr(c, o, x), text(o, ot), full = @dot(ot, x),
    t = @replace_all(@lower(x), "_", "").
.decl pdo_tgt(f: node, r: number, t: symbol, full: symbol)
pdo_tgt(f, r, t, full) :- pdo_rank(f, c, r), pdo_name(c, t, full), t != "".
.decl pdo_untargeted(f: node)
pdo_untargeted(f) :- pdo_rank(f, _, r), !pdo_tgt(f, r, _, _).
.decl pdo_dup(f: node)
pdo_dup(f) :- pdo_tgt(f, r1, t, _), pdo_tgt(f, r2, t, _), r1 != r2.

// pdo_param(f, j, p, x): p, named x, is f's j-th positional parameter after self/cls.
.decl pdo_pos(f: node, p: node, i: number, x: symbol)
pdo_pos(f, p, i, x) :- pdo_n(f, _), sig_param(f, p, nm, i, k, _, _), (k = "pos" ; k = "posonly"), text(nm, x),
    x != "self", x != "cls".
.decl pdo_param(f: node, j: number, p: node, x: symbol)
pdo_param(f, j, p, x) :- pdo_pos(f, p, i, x), j = count : { pdo_pos(f, p2, i2, x2), i2 < i }.
.decl pdo_short(f: node)
pdo_short(f) :- pdo_n(f, n), m = count : { pdo_param(f, j, p, x), j < n }, m < n.

// pdo_slot(f, k, p, lx, t, b): the k-th mock parameter p (lower-cased name lx) is named in top-down order when it
// contains t, the k-th target from the top, and in the right order when it contains b, the k-th from the bottom.
.decl pdo_slot(f: node, k: number, p: node, lx: symbol, t: symbol, b: symbol)
pdo_slot(f, k, p, lx, t, b) :- pdo_n(f, n), n >= 2, pdo_param(f, k, p, x), k < n, lx = @replace_all(@lower(x), "_", ""),
    pdo_tgt(f, k, t, _), bk = n - 1 - k, pdo_tgt(f, bk, b, _).
.decl pdo_not_top(f: node)
pdo_not_top(f) :- pdo_slot(f, _, _, lx, t, _), !contains(t, lx).
.decl pdo_both(f: node)
pdo_both(f) :- pdo_slot(f, _, _, lx, t, b), t != b, contains(t, lx), contains(b, lx).
.decl pdo_wrong(f: node, k: number)
pdo_wrong(f, k) :- pdo_slot(f, k, _, lx, _, b), !contains(b, lx).

PatchDecoratorOrder(p, x, real, claimed, y) :- pdo_n(f, n), n >= 2, !pdo_untargeted(f), !pdo_dup(f), !pdo_short(f),
    !pdo_not_top(f), !pdo_both(f), k = min k2 : { pdo_wrong(f, k2) }, pdo_param(f, k, p, x), bk = n - 1 - k,
    pdo_param(f, bk, _, y), pdo_tgt(f, bk, _, real), pdo_tgt(f, k, _, claimed).

// The cases, `upstream/pytest-practice/authored/pytest-practice-patch-decorator-order/` (pack test data in S3, not in
// git: `npm run fixtures:pull -- --pack pytest`), read as one repository: each line ending in `# caught` is reported,
// and no other line.
.test cases exactly
    .fixture "shop/__init__.py" from "../upstream/pytest-practice/authored/pytest-practice-patch-decorator-order/shop/__init__.py"
    .fixture "shop/checks.py" from "../upstream/pytest-practice/authored/pytest-practice-patch-decorator-order/shop/checks.py"
    .fixture "shop/fakes.py" from "../upstream/pytest-practice/authored/pytest-practice-patch-decorator-order/shop/fakes.py"
    .fixture "shop/tests/test_legacy.py" from "../upstream/pytest-practice/authored/pytest-practice-patch-decorator-order/shop/tests/test_legacy.py"
    .fixture "shop/tests/test_mail.py" from "../upstream/pytest-practice/authored/pytest-practice-patch-decorator-order/shop/tests/test_mail.py"
    .fixture "shop/tests/test_tasks.py" from "../upstream/pytest-practice/authored/pytest-practice-patch-decorator-order/shop/tests/test_tasks.py"
    .expect _ at "shop/tests/test_legacy.py":9
    .expect _ at "shop/tests/test_mail.py":13
    .expect _ at "shop/tests/test_mail.py":32
    .expect _ at "shop/tests/test_mail.py":43
    .expect _ at "shop/tests/test_mail.py":51
    .expect _ at "shop/tests/test_mail.py":66
    .expect _ at "shop/tests/test_mail.py":80
    .expect _ at "shop/tests/test_mail.py":127
    .expect _ at "shop/tests/test_mail.py":135
    .expect _ at "shop/tests/test_mail.py":145
    .expect _ at "shop/tests/test_tasks.py":11
    .expect _ at "shop/tests/test_tasks.py":25
    .expect _ at "shop/tests/test_tasks.py":31
.end
