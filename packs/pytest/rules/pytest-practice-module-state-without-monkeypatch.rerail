.policy "pytest-practice-module-state-without-monkeypatch" revision 1
.description "Do not change a module global or class attribute of your code directly in a test; use monkeypatch.setattr/setitem or mock.patch.object, which put it back."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. A module is imported once per test session and a class is defined once, so a value a
// test writes on a module global, on a class attribute or into a module-level dict or list stays there for every test
// that runs after it: results then depend on test order (pytest docs, "Flaky tests"; asottile/detect-test-pollution
// finds such pairs by bisection). pytest's `monkeypatch.setattr`/`setitem`/`delattr` and unittest.mock's
// `patch.object`/`patch.dict` undo their changes when the test ends (pytest docs, "How to monkeypatch/mock modules
// and environments").
//
// It matches, in a test, fixture or set-up hook (pt_test_code; lambdas inside count, nested defs do not), a write to
// state of the run's own code that outlives the test, the written object resolved through imports (python/names'
// sym_of):
//   - an attribute of a module of the run: `registry.TIMEOUT = 1`, `+=`, `del`, `setattr(registry, "TIMEOUT", 1)`;
//   - an attribute of a class of the run: `Locks.timeframe = "5m"`, `registry.Locks.acquire = fake`;
//   - an attribute of a module-level object of the run: `config.debug = True` (`config = Config()` in shop/conf.py);
//   - an item of a module-level object, or of a module's or class's attribute: `registry.HANDLERS["x"] = f`,
//     `app.config["TESTING"] = True`;
//   - a list/dict/set mutator called on a module-level container or a class-level container (a literal, a
//     comprehension, or dict/list/set/defaultdict/OrderedDict/Counter/deque): `PLUGINS.append(x)`,
//     `registry.HANDLERS.clear()`, `Locks.seen.append(x)`.
// One function reports each target once, at its first write: a restore by hand at the end of the test is not
// reported again (the first write is: a failing assert skips that restore).
// Left alone:
//   def test_x(monkeypatch): monkeypatch.setattr(registry, "TIMEOUT", 1)
//                                                     the fix (also monkeypatch.setitem/delattr, patch.object,
//                                                     patch.dict, patch("a.b.X"), patch.multiple)
//   with mock.patch.object(registry, "TIMEOUT", 1): registry.TIMEOUT = 3
//                                                     a patch of the same target in the same def, as a decorator of
//                                                     the def or its class, or started in its class's set-up hook,
//                                                     puts the original back
//   old = registry.X; registry.X = 1; try: ... finally: registry.X = old
//                                                     restored for the same target: in a finally, after a fixture's
//                                                     yield, in a teardown hook of the class or module, or by an
//                                                     addCleanup / addfinalizer callback (`addCleanup(setattr,
//                                                     registry, "X", old)`, `addCleanup(registry.HANDLERS.clear)`)
//   mail.outbox = []; g.user = None                   objects of other libraries (Django resets mail.outbox per test;
//                                                     flask's g is per request); os.environ and django.conf.settings
//                                                     have rules of their own
//   order = Order(); order.status = "paid"            instances, fixture values, `self.x = ...`, `cls.x = ...`
//   Order.objects.update(status="x")                  a method call on a class attribute that is not a container
//   class Spy: calls = [] ... Spy.calls = []          a class of the test module itself that no other module names,
//                                                     and a class defined inside a def
//   def pytest_configure(): registry.X = 1            session-wide set-up: pytest hooks, an autouse session-scoped
//                                                     fixture, module-level code (it runs once, at import)
//   shop/registry.py: HANDLERS.clear()                not test code
// Gaps: a write in a helper the test calls is not read; a restore in a base class's tearDown, in a fixture the test
// requests, or in a helper is not seen; an alias (`h = registry.HANDLERS; h["x"] = f`) is not followed; a restore by
// hand without finally is reported.

#include "lib/pytest.rerail"

.violation ModuleStateWithoutMonkeypatch(at: node, name: symbol) "This test code changes `{name}`, state of a module or class that lives for the whole test session, and nothing puts it back after the test: every later test sees the changed value. Use `monkeypatch.setattr`/`monkeypatch.setitem` or `mock.patch.object`/`mock.patch.dict`, which undo it when the test ends. Leave it only if a finally, teardown or helper this rule cannot see restores it."
ModuleStateWithoutMonkeypatch(n, x) :- ms_hit(n, k, u), !ms_later(n, k, u), ms_label(n, x).

// ---- what is shared state -------------------------------------------------------------------------------------------
// ms_var(q, r): module-level variable q ("pkg.mod.X") of the run, assigned value r.
.decl ms_var(q: symbol, r: node)
ms_var(@dot(mq, x), r) :- asg(m, x, r, _), kind(m, "module"), modname(m, mq).
// ms_class_attr(q, r): class-level attribute q ("pkg.mod.C.x") of a class of the run, assigned value r.
.decl ms_class_attr(q: symbol, r: node)
ms_class_attr(@dot(cq, x), r) :- asg(c, x, r, _), class_def(c, cq).
// ms_container(q): q is a module-level variable or class attribute whose value is a mutable container.
.decl ms_container(q: symbol)
ms_container(q) :- (ms_var(q, r0) ; ms_class_attr(q, r0)), unparen(r0, r), ms_container_value(r).
.decl ms_container_value(r: node)
ms_container_value(r) :- kind(r, k), (k = "dictionary" ; k = "list" ; k = "set" ; k = "dictionary_comprehension" ;
    k = "list_comprehension" ; k = "set_comprehension").
ms_container_value(r) :- kind(r, "call"), field(r, "function", f), sym_of(f, q),
    (q = "builtins.dict" ; q = "builtins.list" ; q = "builtins.set" ; q = "collections.defaultdict" ;
    q = "collections.OrderedDict" ; q = "collections.Counter" ; q = "collections.deque").

// ms_root(o, q, k): expression o names shared object q of the run: k "module" (a module), "class" (a class: not one
// defined inside a def, nor one of a test document that only its own document names), "var" (a module-level
// variable, read through an import).
.decl ms_root(o: node, q: symbol, k: symbol)
ms_root(o, q, "module") :- sym_of(o, q), modname(_, q).
ms_root(o, q, "class") :- sym_of(o, q), class_def(c, q), !pt_in_def_class(c), !ms_private_class(c, o).
ms_root(o, q, "var") :- sym_of(o, q), ms_var(q, _).
// ms_private_class(c, o): class c is defined in the test document o is in, and no other document names it.
.decl ms_private_class(c: node, o: node)
ms_private_class(c, o) :- class_def(c, q), sym_of(o, q), docof(c, d), docof(o, d), pt_test_doc(d),
    !ms_named_elsewhere(q, d).
.decl ms_named_elsewhere(q: symbol, d: number)
ms_named_elsewhere(q, d) :- class_def(c, q), docof(c, d), sym_of(n, q), docof(n, d2), d2 != d.
// ms_key(e, k): expression e is shared object k: a module-level variable (`HANDLERS`, `registry.HANDLERS`), or an
// attribute of a shared object (`Locks.seen`, `app.config`).
.decl ms_key(e: node, k: symbol)
ms_key(e, q) :- ms_root(e, q, "var").
ms_key(e, @dot(q, a)) :- attr_of(e, o, a), ms_root(o, q, _).

// ---- writes -------------------------------------------------------------------------------------------------------
// ms_write(n, k): n changes shared object k: an assignment, augmented assignment or `del` of an attribute of a shared
// object or of an item of one, a container mutator called on a shared container, setattr/delattr with a literal name.
.decl ms_write(n: node, k: symbol)
ms_write(t, @dot(q, a)) :- pt_store(t), attr_of(t, o, a), ms_root(o, q, _).
ms_write(t, k) :- pt_store(t), kind(t, "subscript"), field(t, "value", v), ms_key(v, k).
ms_write(c, k) :- kind(c, "call"), field(c, "function", f), attr_of(f, r, m), pt_mutator(m), ms_key(r, k),
    ms_container(k).
ms_write(c, @dot(q, a)) :- kind(c, "call"), field(c, "function", f), ms_setattr_fn(f), posarg(c, 0, o),
    ms_root(o, q, _), posarg(c, 1, s), str(s, a).
.decl ms_setattr_fn(f: node)
ms_setattr_fn(f) :- sym_of(f, "builtins.setattr").
ms_setattr_fn(f) :- sym_of(f, "builtins.delattr").
// ms_label(n, x): what the message names: the target, or the called method.
.decl ms_label(n: node, x: symbol)
ms_label(n, x) :- ms_write(n, _), !kind(n, "call"), text(n, x).
ms_label(n, x) :- ms_write(n, _), kind(n, "call"), field(n, "function", f), !ms_setattr_fn(f), text(f, x).
ms_label(n, x) :- ms_write(n, k), kind(n, "call"), field(n, "function", f), ms_setattr_fn(f), x = k.

// ms_unit(n, u): the def n runs in (lambdas transparent).
.decl ms_unit(n: node, u: node)
ms_unit(n, u) :- ms_write(n, _), def_frame(n, u).

// ms_cand(n, k, u): a write of k in test code u, outside session-wide set-up (pt_session_code: a pytest hook, an
// autouse session-scoped fixture, conftest.py module-level code; and a session-scoped fixture an autouse fixture
// requests, which runs before the first test as well).
.decl ms_cand(n: node, k: symbol, u: node)
ms_cand(n, k, u) :- ms_write(n, k), ms_unit(n, u), pt_test_code(u, _), !pt_session_code(n), !ms_session_fixture(u).
pt_session_ask(n) :- ms_write(n, _).
.decl ms_session_fixture(g: node)
ms_session_fixture(g) :- pt_fixture_scope(g, "session"), pt_resolves(a, _, g), pt_autouse(a).

// ---- undoing ------------------------------------------------------------------------------------------------------
// Writes are asked about pt_undo: after a fixture's yield, in a finally, in a teardown hook of the class or module, or
// in an addCleanup / addfinalizer callback.
pt_undo_ask(n) :- ms_write(n, _).

// ms_patch_key(c, k): patch call c replaces shared object k and puts it back when it ends.
.decl ms_patch_key(c: node, k: symbol)
ms_patch_key(c, @dot(q, x)) :- pt_patch_attr(c, o, x), ms_root(o, q, _).
ms_patch_key(c, s) :- pt_patch_name(c, s, _).
ms_patch_key(c, k) :- pt_patch(c, "dict"), posarg(c, 0, a), ms_key(a, k).
ms_patch_key(c, k) :- pt_patch(c, "dict"), posarg(c, 0, a), str(a, k).
ms_patch_key(c, @dot(q, x)) :- pt_patch(c, "multiple"), posarg(c, 0, o), ms_root(o, q, _), call_arg(c, -1, x, _).
ms_patch_key(c, k) :- pt_mp_call(c, m), (m = "setitem" ; m = "delitem"), posarg(c, 0, o), ms_key(o, k).
// ms_patched(u, c): patch call c is active while u runs: in u's own body, as a decorator of u or its class, or in a
// set-up hook of u's class.
.decl ms_patched(u: node, c: node)
ms_patched(u, c) :- ms_patch_key(c, _), def_frame(c, u).
ms_patched(u, c) :- ms_patch_key(c, _), decorator(u, e), unparen(e, c), kind(u, "function_definition").
ms_patched(u, c) :- ms_patch_key(c, _), decorator(cl, e), unparen(e, c), kind(cl, "class_definition"),
    pt_class_of(u, cl).
ms_patched(u, c) :- ms_patch_key(c, _), def_frame(c, h), pt_setup_hook(h), pt_class_of(h, cl), pt_class_of(u, cl),
    u != h.

// ms_restores(u, k): u's undo code writes k, u registers a cleanup that does (`addCleanup(setattr, registry, "X",
// old)`, `addCleanup(registry.HANDLERS.clear)`), or a patch of k is active while u runs.
.decl ms_restores(u: node, k: symbol)
ms_restores(u, k) :- ms_write(m, k), pt_undo(m, u).
ms_restores(u, @dot(q, a)) :- pt_cleanup_call(c, u), posarg(c, 0, f), ms_setattr_fn(f), posarg(c, 1, o),
    ms_root(o, q, _), posarg(c, 2, s), str(s, a).
ms_restores(u, k) :- pt_cleanup_call(c, u), posarg(c, 0, f), attr_of(f, r, m), pt_mutator(m), ms_key(r, k).
ms_restores(u, k) :- ms_patched(u, c), ms_patch_key(c, k).

// ms_hit(n, k, u): a write of k in u that is not itself undo code and that nothing restores; ms_later(n, k, u):
// another one of k comes before it.
.decl ms_hit(n: node, k: symbol, u: node)
ms_hit(n, k, u) :- ms_cand(n, k, u), !pt_undo(n, _), !ms_restores(u, k).
.decl ms_later(n: node, k: symbol, u: node)
ms_later(n, k, u) :- ms_hit(n, k, u), ms_hit(m, k, u), earlier(m, n).

// The cases, `cases/pytest-practice-module-state-without-monkeypatch/`, read as one repository: each line ending in
// `# caught` is reported, and no other line.
.test cases exactly
    .fixture "conftest.py" from "../cases/pytest-practice-module-state-without-monkeypatch/conftest.py"
    .fixture "shop/__init__.py" from "../cases/pytest-practice-module-state-without-monkeypatch/shop/__init__.py"
    .fixture "shop/models.py" from "../cases/pytest-practice-module-state-without-monkeypatch/shop/models.py"
    .fixture "shop/registry.py" from "../cases/pytest-practice-module-state-without-monkeypatch/shop/registry.py"
    .fixture "tests/__init__.py" from "../cases/pytest-practice-module-state-without-monkeypatch/tests/__init__.py"
    .fixture "tests/helpers.py" from "../cases/pytest-practice-module-state-without-monkeypatch/tests/helpers.py"
    .fixture "tests/test_other.py" from "../cases/pytest-practice-module-state-without-monkeypatch/tests/test_other.py"
    .fixture "tests/test_state.py" from "../cases/pytest-practice-module-state-without-monkeypatch/tests/test_state.py"
    .fixture "tests/unit/__init__.py" from "../cases/pytest-practice-module-state-without-monkeypatch/tests/unit/__init__.py"
    .fixture "tests/unit/test_case.py" from "../cases/pytest-practice-module-state-without-monkeypatch/tests/unit/test_case.py"
    .expect _ at "conftest.py":22
    .expect _ at "conftest.py":28
    .expect _ at "conftest.py":72
    .expect _ at "tests/test_state.py":20
    .expect _ at "tests/test_state.py":24
    .expect _ at "tests/test_state.py":28
    .expect _ at "tests/test_state.py":32
    .expect _ at "tests/test_state.py":36
    .expect _ at "tests/test_state.py":40
    .expect _ at "tests/test_state.py":44
    .expect _ at "tests/test_state.py":48
    .expect _ at "tests/test_state.py":52
    .expect _ at "tests/test_state.py":56
    .expect _ at "tests/test_state.py":60
    .expect _ at "tests/test_state.py":64
    .expect _ at "tests/test_state.py":68
    .expect _ at "tests/test_state.py":72
    .expect _ at "tests/test_state.py":76
    .expect _ at "tests/test_state.py":84
    .expect _ at "tests/test_state.py":90
    .expect _ at "tests/test_state.py":97
    .expect _ at "tests/unit/test_case.py":22
    .expect _ at "tests/unit/test_case.py":28
.end
