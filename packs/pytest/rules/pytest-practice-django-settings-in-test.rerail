.policy "pytest-practice-django-settings-in-test" revision 1
.description "Do not change django.conf.settings directly in test code; use pytest-django's settings fixture or override_settings."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. Django does not put back a value a test writes on django.conf.settings, and sends no
// setting_changed signal for it: the value leaks into the tests after it, and caches built from the setting go stale
// (Django docs, "Overriding settings": "Don't manipulate django.conf.settings directly as Django won't restore the
// original values"). pytest-django's `settings` fixture, `override_settings`, `modify_settings` and a TestCase's
// `self.settings()` revert their changes after the test.
//
// It matches, in test code (pt_test_doc: tests, fixtures, set-up hooks, helpers and module-level code of test modules
// and conftest.py), a write to an upper-case attribute of django.conf.settings (pt_settings, through imports): an
// assignment, augmented assignment or `del` of the setting or of an item or attribute inside it, a list/dict/set
// mutator called on it (pt_mutator), and setattr/delattr on settings with a literal name. One function reports each
// setting once, at its first write: a restore by hand at the end of the test is not reported again.
//   from django.conf import settings
//   def test_x(): settings.DEBUG = True               reported
//   def test_x(): settings.CACHES["default"] = {}     reported: changes the shared value in place
//   def test_x(): settings.MIDDLEWARE.append("m")     reported
//   @pytest.fixture def sentry(): settings.SENTRY_DSN = "x"
//                                                     reported
//   old = settings.X; settings.X = 1; ...; settings.X = old
//                                                     reported at the first write: a failing assert skips the restore
// Left alone:
//   def test_x(settings): settings.DEBUG = True       pytest-django's fixture: a parameter, not django.conf.settings
//   with override_settings(DEBUG=True): ...           the fix (also @override_settings, modify_settings,
//                                                     self.settings(), on the def or its class)
//   with override_settings(A=1): settings.B = 2       a plain write inside an override lands on the override's copy,
//                                                     which is dropped with it (an item write is not, unless the
//                                                     override replaces that setting)
//   settings.X = 1; try: ... finally: settings.X = old
//                                                     restored for the same setting: in a finally, after a fixture's
//                                                     yield, in a tearDown/tearDownClass of the same class, in
//                                                     teardown_module/teardown_function, or by an addCleanup /
//                                                     addfinalizer callback (`self.addCleanup(setattr, settings, "X",
//                                                     old)` included)
//   def pytest_configure(): settings.X = 1            session-wide set-up: a pytest hook or a helper only hooks call,
//                                                     an autouse session fixture, pytest-django's django_db_setup,
//                                                     module-level code of a conftest.py: every test sees one value
//   settings._wrapped = None; settings.configure()    lower-case attributes and calls are not settings
//   shop/views.py: settings.DEBUG = True              not test code: django-practice-settings-runtime-assignment
//   from shop.conf import settings (Dynaconf)         another library's `settings`
// Gaps: a restore in a base class's tearDown or in a helper the test calls is not seen; an alias
// (`apps = settings.INSTALLED_APPS; apps.append(x)`) is not followed; a restore by hand without finally is still
// reported, as is a write in a test runner's own set-up under a test directory.

#include "lib/pytest.rerail"

.violation DjangoSettingsInTest(at: node, name: symbol) "This test code changes `settings.{name}` on django.conf.settings directly: Django does not restore it after the test and sends no setting_changed signal, so the value leaks into later tests. Use pytest-django's `settings` fixture, or `override_settings`/`self.settings()` in a TestCase. Leave it only if the old value is put back in a finally or tearDown this rule cannot see (a base class's, a helper's)."
DjangoSettingsInTest(n, x) :- dst_hit(n, x, u), !dst_later(n, x, u).

// dst_setting(a, x): a is `settings.X`, X upper-case, settings being django.conf.settings.
.decl dst_setting(a: node, x: symbol)
dst_setting(a, x) :- attr_of(a, o, x), match("[A-Z][A-Z0-9_]*", x), pt_settings(o).

// dst_write(n, x, how): n writes setting x: "attr" replaces or deletes the setting itself (a store, `del`,
// setattr/delattr), "item" changes its value in place (an item or attribute store inside it, a mutator call).
.decl dst_write(n: node, x: symbol, how: symbol)
dst_write(n, x, "attr") :- dst_setting(n, x), pt_store(n).
dst_write(n, x, "item") :- dst_setting(a, x), pt_mutates(n, a).
dst_write(c, x, "attr") :- kind(c, "call"), field(c, "function", f), dst_setattr_fn(f), posarg(c, 0, s), pt_settings(s),
    posarg(c, 1, k), str(k, x), match("[A-Z][A-Z0-9_]*", x).
.decl dst_setattr_fn(f: node)
dst_setattr_fn(f) :- sym_of(f, "builtins.setattr").
dst_setattr_fn(f) :- sym_of(f, "builtins.delattr").

// dst_session(n): n is session-wide set-up: in a pytest hook (`pytest_configure`, `pytest_sessionstart`, ...), in a
// helper that only pytest hooks call (python/calls), in an autouse session-scoped fixture or pytest-django's database
// set-up fixtures (`django_db_setup`, `django_db_modify_db_settings*`), or module-level code of a conftest.py.
.decl dst_session(n: node)
pt_session_ask(n) :- dst_write(n, _, _).
dst_session(n) :- dst_write(n, _, _), pt_session_code(n).
dst_session(n) :- dst_write(n, _, _), def_frame(n, g), !pt_test_code(g, _), calls(h, g), pt_hook(h),
    !dst_other_caller(g).
dst_session(n) :- dst_write(n, _, _), def_frame(n, g), pt_fixture_name(g, x),
    (x = "django_db_setup" ; prefix("django_db_modify_db_settings", x)).
// dst_other_caller(g): a def other than a pytest hook calls g, the def of a write.
.decl dst_other_caller(g: node)
dst_other_caller(g) :- dst_write(n, _, _), def_frame(n, g), calls(h, g), !pt_hook(h).

// dst_unit(n, u): the def n runs in (lambdas transparent), or its module for module-level code.
.decl dst_unit(n: node, u: node)
dst_unit(n, f) :- dst_write(n, _, _), def_frame(n, f).
dst_unit(n, m) :- dst_write(n, _, _), !def_frame(n, _), docof(n, d), modnode(d, m).

// dst_cand(n, x, u): a write of setting x in test code, outside session set-up and override blocks.
.decl dst_cand(n: node, x: symbol, u: node)
dst_cand(n, x, u) :- dst_write(n, x, how), docof(n, d), pt_test_doc(d), !dst_session(n), !dst_overridden(n, x, how),
    dst_unit(n, u).

// dst_override(e): call e is override_settings / modify_settings, or a TestCase's self.settings / self.modify_settings.
.decl dst_override_q(q: symbol)
dst_override_q("django.test.override_settings"). dst_override_q("django.test.utils.override_settings").
dst_override_q("django.test.modify_settings"). dst_override_q("django.test.utils.modify_settings").
.decl dst_override(e: node)
dst_override(e) :- kind(e, "call"), field(e, "function", f), sym_of(f, q), dst_override_q(q).
dst_override(e) :- kind(e, "call"), field(e, "function", f), attr_of(f, o, m), text(o, "self"),
    (m = "settings" ; m = "modify_settings").
// dst_override_around(n, e): override e is active where n runs: a with-item of a with around n, or a decorator of a
// def or class around n.
.decl dst_override_around(n: node, e: node)
dst_override_around(n, e) :- dst_write(n, _, _), kind(wi, "with_item"), field(wi, "value", v),
    (unparen(v, e) ; kind(v, "as_pattern"), child(v, v0, 0), unparen(v0, e)), dst_override(e),
    nearest(wi, ws, "with_statement"), field(ws, "body", b), within(n, b).
dst_override_around(n, e) :- dst_write(n, _, _), within(n, g), (kind(g, "function_definition") ;
    kind(g, "class_definition")), decorator(g, e0), unparen(e0, e), dst_override(e).
// dst_overridden(n, x, how): a plain write inside an override lands on the override's copy and is dropped with it;
// an item write changes the shared value unless the override replaces that setting.
.decl dst_overridden(n: node, x: symbol, how: symbol)
dst_overridden(n, x, "attr") :- dst_write(n, x, "attr"), dst_override_around(n, _).
dst_overridden(n, x, how) :- dst_write(n, x, how), dst_override_around(n, e), call_arg(e, -1, x, _).

// dst_undo(m, u): write m runs after u to undo it (the library's pt_undo, asked for the writes only).
pt_undo_ask(m) :- dst_write(m, _, _).
.decl dst_undo(m: node, u: node)
dst_undo(m, u) :- pt_undo(m, u).
// dst_restores(u, x): u's undo code writes setting x, or u registers `addCleanup(setattr, settings, "X", old)`.
.decl dst_restores(u: node, x: symbol)
dst_restores(u, x) :- dst_write(m, x, _), dst_undo(m, u).
dst_restores(u, x) :- pt_cleanup_call(c, u), posarg(c, 0, a), dst_setattr_fn(a), posarg(c, 1, s), pt_settings(s),
    posarg(c, 2, k), str(k, x).

// dst_hit(n, x, u): a write of x in u that is not itself undo code and that nothing restores; dst_later(n, x, u):
// another one comes before it.
.decl dst_hit(n: node, x: symbol, u: node)
dst_hit(n, x, u) :- dst_cand(n, x, u), !dst_undo(n, _), !dst_restores(u, x).
.decl dst_later(n: node, x: symbol, u: node)
dst_later(n, x, u) :- dst_hit(n, x, u), dst_hit(m, x, u), earlier(m, n).

// The cases, `cases/pytest-practice-django-settings-in-test/`, read as one repository: each line ending in
// `# caught` is reported, and no other line.
.test cases exactly
    .fixture "conftest.py" from "../cases/pytest-practice-django-settings-in-test/conftest.py"
    .fixture "shop/__init__.py" from "../cases/pytest-practice-django-settings-in-test/shop/__init__.py"
    .fixture "shop/conf.py" from "../cases/pytest-practice-django-settings-in-test/shop/conf.py"
    .fixture "shop/views.py" from "../cases/pytest-practice-django-settings-in-test/shop/views.py"
    .fixture "tests/__init__.py" from "../cases/pytest-practice-django-settings-in-test/tests/__init__.py"
    .fixture "tests/test_views.py" from "../cases/pytest-practice-django-settings-in-test/tests/test_views.py"
    .fixture "tests/helpers.py" from "../cases/pytest-practice-django-settings-in-test/tests/helpers.py"
    .fixture "tests/unit/__init__.py" from "../cases/pytest-practice-django-settings-in-test/tests/unit/__init__.py"
    .fixture "tests/unit/test_case.py" from "../cases/pytest-practice-django-settings-in-test/tests/unit/test_case.py"
    .expect _ at "conftest.py":14
    .expect _ at "conftest.py":15
    .expect _ at "conftest.py":38
    .expect _ at "conftest.py":73
    .expect _ at "tests/test_views.py":9
    .expect _ at "tests/test_views.py":13
    .expect _ at "tests/test_views.py":17
    .expect _ at "tests/test_views.py":21
    .expect _ at "tests/test_views.py":25
    .expect _ at "tests/test_views.py":29
    .expect _ at "tests/test_views.py":33
    .expect _ at "tests/test_views.py":37
    .expect _ at "tests/test_views.py":41
    .expect _ at "tests/test_views.py":42
    .expect _ at "tests/test_views.py":48
    .expect _ at "tests/test_views.py":66
    .expect _ at "tests/test_views.py":109
    .expect _ at "tests/test_views.py":125
    .expect _ at "tests/test_views.py":130
    .expect _ at "tests/unit/test_case.py":23
    .expect _ at "tests/unit/test_case.py":29
    .expect _ at "tests/helpers.py":12
.end
