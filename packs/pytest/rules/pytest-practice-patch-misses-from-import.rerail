.policy "pytest-practice-patch-misses-from-import" revision 1
.description "Patch a function, class or value where the code under test looks it up, not in the module that defines it when the callers imported it by name."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. `from shop.mail import send_email` copies the object into the importing module: a
// later `mock.patch("shop.mail.send_email")` replaces the name in shop.mail, which the importer never reads again, so
// its code still sends real e-mail and `send.assert_not_called()` passes vacuously (unittest.mock, "Where to patch").
// It reads every file of the run: a patch target resolved to a workspace module that binds the name, the non-test
// modules that copied the name with a top-level from-import (following re-exports: `shop/notify/__init__.py` doing
// `from .sms import send_sms` passes its copy on), every live read of the original, and the patching file's imports:
// it reports only when that file imports a module holding a copy (the code the test runs), and names that module.
//   @mock.patch("shop.mail.send_email")              reported when the test file imports shop.orders, which has
//   mocker.patch("shop.mail.send_email")             `from shop.mail import send_email` and calls it, and nothing
//   patch.object(mail, "send_email")                 reads `mail.send_email` or calls it inside shop/mail.py
//   monkeypatch.setattr("shop.mail.send_email", f)
//   monkeypatch.setattr(mail, "send_email", f)
//   patch("shop.orders.send_email")                  not reported: the name the code under test reads
//   patch("shop.http.post")                          not reported: shop/billing.py calls `http.post(...)`
//   patch("shop.mail.render_body")                   not reported: shop/mail.py calls it itself
//   patch("shop.mail.archive")                       not reported: a function imports it at call time, after the patch
//   patch("shop.http.Client.get")                    not reported: a class attribute reaches every holder of the class
//   patch("requests.get")                            not reported: the run cannot see the library's importers
//   patch("shop.mail.audit") + patch("shop.inventory.audit") on one test: not reported, the copy is patched too
//   a test file that imports no module holding a copy: not reported (a dead patch, or one guarding shop.mail's own
//                                                    code: `mail.confirm()` then `send.assert_not_called()`)
//   a name a Django management command imports: not reported (call_command imports it inside the patch)
//   an importer imported in the patching test's body, or a file that reloads modules with importlib: not reported
//   a copy read only in type annotations does not count; patch(..., create=True), raising=False, patch.dict,
//   monkeypatch.delattr: not reported
// Gaps: tests that reach the importer only through a test client or a fixture (no import of it in the test file)
// are not reported; a test module that imports the name itself and calls it misses the patch the same way, but tests
// are not read as importers; when any module reads `mod.name`, the rule is silent even if the test runs another
// module's copy; `from m import *` copies and names read through `sys.modules` or a dotted string are not seen; a
// module first imported while the patch is active does get the mock, which a static check cannot always tell.

#include "lib/pytest.rerail"

.violation PatchMissesFromImport(at: node, target: symbol, importer: symbol, fix: symbol) "`{importer}` holds its own copy of this name from a from-import, so patching `{target}` leaves its code on the real object. Patch `{fix}` instead, and each other module that imports it."
PatchMissesFromImport(at, t, qi, @dot(qi, l)) :- pmi_site(at, q, x, t), pmi_pick(at, q, x, mi), pmi_open(at, q, x, mi, l),
    modname(mi, qi).

// pmi_site(at, q, x, t): a patch reported at `at` replaces name x of workspace module q (t = "q.x"): a target string
// whose module part is a workspace module, or patch.object / monkeypatch.setattr on an expression naming one.
.decl pmi_site(at: node, q: symbol, x: symbol, t: symbol)
pmi_site(a, q, x, t) :- pt_patch_name(c, t, a), !pt_mp_call(c, "delattr"), pmi_keeps(c), q = @pkg_up(t, 1), q != "",
    x = @replace_all(t, "^.*\\.", ""), workspace_module(q), !workspace_module(t).
pmi_site(c, q, x, @dot(q, x)) :- pt_patch_attr(c, o, x), !pt_mp_call(c, "delattr"), pmi_keeps(c), pmi_modref(o, q).
// pmi_keeps(c): the patch does not create a missing attribute (`create=True`, `raising=False`).
.decl pmi_keeps(c: node)
pmi_keeps(c) :- kind(c, "call"), !pmi_creates(c).
.decl pmi_creates(c: node)
pmi_creates(c) :- call_arg(c, -1, "create", v), !text(v, "False").
pmi_creates(c) :- call_arg(c, -1, "raising", v), !text(v, "True").
// pmi_modref(o, q): expression o names workspace module q (`mail` after `from shop import mail`, `shop.http`).
.decl pmi_modref(o: node, q: symbol)
pmi_modref(o, q) :- qn(o, q), workspace_module(q).
pmi_modref(o, q) :- sym_of(o, q), workspace_module(q).
// pmi_target(q, x): some patch replaces x in q, and q's module binds x at its top level.
.decl pmi_target(q: symbol, x: symbol)
pmi_target(q, x) :- pmi_site(_, q, x, _), modname(m, q), bound_in(m, x).

// pmi_copy(q, x, mi, l): non-test module mi holds q's x under the local name l, copied by a from-import that runs
// when mi is imported, directly or through modules that re-export it.
.decl pmi_copy(q: symbol, x: symbol, mi: node, l: symbol)
pmi_copy(q, x, mi, l) :- pmi_target(q, x), import_alias(i, _, q, x, l), pmi_top_import(i, mi).
pmi_copy(q, x, mj, l2) :- pmi_copy(q, x, mi, l1), modname(mi, qi), import_alias(j, _, qi, l1, l2), pmi_top_import(j, mj).
.decl pmi_top_import(i: node, m: node)
pmi_top_import(i, m) :- import_time(i), nearest(i, m, scope), kind(m, "module"), docof(i, d), !pt_test_doc(d).
// pmi_user(q, x, mi, l): mi reads its copy l when it runs (a type annotation is no such read).
.decl pmi_user(q: symbol, x: symbol, mi: node, l: symbol)
pmi_user(q, x, mi, l) :- pmi_copy(q, x, mi, l), nameref(n, l), look(n, l, mi), !bind_only(n), !annotation(n).

// pmi_live(q, x): some code reads q's x itself when it runs, so the patch reaches it: `mail.send_email(...)` or
// `getattr(mail, "send_email")` anywhere, a from-import inside a function, a read inside q, or a from-import in a
// Django management command, whose module `call_command` imports when it runs, inside the test's patch.
.decl pmi_live(q: symbol, x: symbol)
pmi_live(q, x) :- pmi_target(q, x), attr_of(n, o, x), pmi_modref(o, q).
pmi_live(q, x) :- pmi_target(q, x), kind(c, "call"), field(c, "function", f), text(f, "getattr"), posarg(c, 0, o),
    posarg(c, 1, s), str(s, x), pmi_modref(o, q).
pmi_live(q, x) :- pmi_target(q, x), import_alias(i, _, q, x, _), nearest(i, f, scope),
    (kind(f, "function_definition") ; kind(f, "lambda")).
pmi_live(q, x) :- pmi_target(q, x), modname(m, q), nameref(n, x), look(n, x, m), !bind_only(n).
pmi_live(q, x) :- pmi_target(q, x), import_alias(i, _, q, x, _), docof(i, d), doc(d, p, _),
    contains("management/commands/", p).

// pmi_imports(d, m): document d imports module m (`import a.m`, `from a import m`, `from a.m import y`).
.decl pmi_imports(d: number, m: symbol)
pmi_imports(d, m) :- import_alias(i, _, m, _, _), docof(i, d).
pmi_imports(d, @dot(m, y)) :- import_alias(i, _, m, y, _), y != "", docof(i, d).
// pmi_owner(n, f): n is part of a patch of def f: in one of f's decorators, or in its body.
.decl pmi_owner(n: node, f: node)
pmi_owner(n, f) :- pt_patch_deco(f, c, _), (n = c ; within(n, c)).
pmi_owner(n, f) :- pt_patch(c, _), (n = c ; within(n, c)), !pt_patch_deco(_, c, _), nearest(c, f, fdef).
// pmi_patched(f, t): def f also patches the dotted name t.
.decl pmi_patched(f: node, t: symbol)
pmi_patched(f, t) :- pt_patch_name(c, t, _), pmi_owner(c, f).
pmi_patched(f, @dot(m, y)) :- pt_patch_attr(c, o, y), pmi_modref(o, m), pmi_owner(c, f).
// pmi_open(at, q, x, mi, l): importer mi's copy l still holds the real object under the patch at `at`: nothing
// reaches q's x itself, the same test or fixture does not patch `mi.l` as well or import an importer in its body
// (`with patch("pkg.create_app"): from pkg.worker import task` loads it under the patch), and the patching file does
// not (re)load modules with importlib.
.decl pmi_open(at: node, q: symbol, x: symbol, mi: node, l: symbol)
pmi_open(at, q, x, mi, l) :- pmi_site(at, q, x, _), pmi_user(q, x, mi, l), !pmi_live(q, x), modname(mi, qi),
    !pmi_covered(at, @dot(qi, l)), !pmi_lazy(at, q, x).
.decl pmi_lazy(at: node, q: symbol, x: symbol)
pmi_lazy(at, q, x) :- pmi_site(at, q, x, _), pmi_user(q, x, mi, _), modname(mi, qi), pmi_owner(at, f),
    import_alias(i, _, m, y, _), (m = qi ; y != "", @dot(m, y) = qi), nearest(i, f, fdef).
pmi_lazy(at, q, x) :- pmi_site(at, q, x, _), docof(at, d), kind(c, "call"), docof(c, d), field(c, "function", f),
    (sym_of(f, "importlib.import_module") ; sym_of(f, "importlib.reload")).
.decl pmi_covered(at: node, t: symbol)
pmi_covered(at, t) :- pmi_site(at, _, _, _), pmi_owner(at, f), pmi_patched(f, t).
// pmi_near(at, q, x, mi): the patching file imports importer mi (at its top or in a function), so the test runs mi's
// code. A patch whose file imports no importer is not reported: on the corpus such patches were mostly dead (the test
// never reaches an importer) or guarded q's own code (`mod.run()` then `helper.assert_not_called()`), and the
// message could not name the module to patch.
.decl pmi_near(at: node, q: symbol, x: symbol, mi: node)
pmi_near(at, q, x, mi) :- pmi_open(at, q, x, mi, _), modname(mi, qi), docof(at, d), pmi_imports(d, qi).
// pmi_pick(at, q, x, mi): the importer the message names: the first one whose other names the same test or fixture
// patches (`patch("pkg.dns.resolver")` beside `patch("pkg.extensions.metrics")` names pkg.dns), else the first one
// the patching file imports.
.decl pmi_pref(at: node, q: symbol, x: symbol, mi: node)
pmi_pref(at, q, x, mi) :- pmi_near(at, q, x, mi), modname(mi, qi), pmi_owner(at, f), pmi_patched(f, t),
    @pkg_up(t, 1) = qi.
.decl pmi_pick(at: node, q: symbol, x: symbol, mi: node)
pmi_pick(at, q, x, mi) :- pmi_pref(at, q, x, _), mi = min m2 : { pmi_pref(at, q, x, m2) }.
pmi_pick(at, q, x, mi) :- pmi_near(at, q, x, _), !pmi_pref(at, q, x, _), mi = min m2 : { pmi_near(at, q, x, m2) }.

// The cases, `cases/pytest-practice-patch-misses-from-import/`, read as one repository: each line ending in `# caught`
// is reported, and no other line.
.test cases exactly
    .fixture "shop/__init__.py" from "../cases/pytest-practice-patch-misses-from-import/shop/__init__.py"
    .fixture "shop/alerts.py" from "../cases/pytest-practice-patch-misses-from-import/shop/alerts.py"
    .fixture "shop/billing.py" from "../cases/pytest-practice-patch-misses-from-import/shop/billing.py"
    .fixture "shop/factory.py" from "../cases/pytest-practice-patch-misses-from-import/shop/factory.py"
    .fixture "shop/http.py" from "../cases/pytest-practice-patch-misses-from-import/shop/http.py"
    .fixture "shop/inventory.py" from "../cases/pytest-practice-patch-misses-from-import/shop/inventory.py"
    .fixture "shop/mail.py" from "../cases/pytest-practice-patch-misses-from-import/shop/mail.py"
    .fixture "shop/management/__init__.py" from "../cases/pytest-practice-patch-misses-from-import/shop/management/__init__.py"
    .fixture "shop/management/commands/__init__.py" from "../cases/pytest-practice-patch-misses-from-import/shop/management/commands/__init__.py"
    .fixture "shop/management/commands/sync_stock.py" from "../cases/pytest-practice-patch-misses-from-import/shop/management/commands/sync_stock.py"
    .fixture "shop/notify/__init__.py" from "../cases/pytest-practice-patch-misses-from-import/shop/notify/__init__.py"
    .fixture "shop/notify/sms.py" from "../cases/pytest-practice-patch-misses-from-import/shop/notify/sms.py"
    .fixture "shop/orders.py" from "../cases/pytest-practice-patch-misses-from-import/shop/orders.py"
    .fixture "shop/receipts.py" from "../cases/pytest-practice-patch-misses-from-import/shop/receipts.py"
    .fixture "shop/reports.py" from "../cases/pytest-practice-patch-misses-from-import/shop/reports.py"
    .fixture "shop/stock.py" from "../cases/pytest-practice-patch-misses-from-import/shop/stock.py"
    .fixture "shop/views.py" from "../cases/pytest-practice-patch-misses-from-import/shop/views.py"
    .fixture "shop/worker.py" from "../cases/pytest-practice-patch-misses-from-import/shop/worker.py"
    .fixture "tests/__init__.py" from "../cases/pytest-practice-patch-misses-from-import/tests/__init__.py"
    .fixture "tests/test_alerts.py" from "../cases/pytest-practice-patch-misses-from-import/tests/test_alerts.py"
    .fixture "tests/test_inventory.py" from "../cases/pytest-practice-patch-misses-from-import/tests/test_inventory.py"
    .fixture "tests/test_mail.py" from "../cases/pytest-practice-patch-misses-from-import/tests/test_mail.py"
    .fixture "tests/test_orders.py" from "../cases/pytest-practice-patch-misses-from-import/tests/test_orders.py"
    .fixture "tests/test_views.py" from "../cases/pytest-practice-patch-misses-from-import/tests/test_views.py"
    .fixture "tests/test_worker.py" from "../cases/pytest-practice-patch-misses-from-import/tests/test_worker.py"
    .expect _ at "tests/test_alerts.py":7
    .expect _ at "tests/test_alerts.py":8
    .expect _ at "tests/test_inventory.py":13
    .expect _ at "tests/test_orders.py":12
    .expect _ at "tests/test_orders.py":19
    .expect _ at "tests/test_orders.py":24
    .expect _ at "tests/test_orders.py":31
    .expect _ at "tests/test_orders.py":36
    .expect _ at "tests/test_orders.py":41
    .expect _ at "tests/test_orders.py":47
    .expect _ at "tests/test_orders.py":52
    .expect _ at "tests/test_worker.py":18
.end
