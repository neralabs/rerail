.policy "pytest-practice-scoped-fixture-mutated" revision 1
.description "Keep tests from changing a class-, module-, package- or session-scoped fixture's value; use monkeypatch or a function-scoped copy."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. pytest makes a fixture with scope="class", "module", "package" or "session" once and
// hands the same object to every test of that scope (pytest docs, "Scope: sharing fixtures across classes, modules,
// packages or session"). A test that writes into that object leaks the change into the tests after it, so results
// depend on order (pytest docs, "Flaky tests"; flakytest.dev, "Keep tests independent of each other").
//
// It matches, in a test or a function-scoped fixture, a change (the library's pt_loc: an attribute or item store or
// `del`, an augmented assignment, setattr/delattr, a list/dict/set mutator call) to the value or to a chain over it,
// read through a parameter whose fixture resolves (by name, through the test's class, module and conftest.py chain:
// pt_resolves) to a fixture of a broader scope, or through a name bound to `request.getfixturevalue("app")`. One
// test reports each target once, at its first change: a restore by hand at the end is not reported again (the first
// change is: a failing assert skips that restore).
//   # conftest.py: @pytest.fixture(scope="module") def app(): return create_app()
//   def test_x(app): app.config["RETRY"] = 4          reported
//   def test_x(app): app.appbuilder = MagicMock()      reported
//   def test_x(items): items.append(1)                 reported (items session-scoped)
//   @pytest.fixture def flag(app): app.debug = True    reported: a function-scoped fixture runs once per test
//   old = app.x; app.x = 1; assert ...; app.x = old    reported at the first store: a failing assert skips the restore
// Left alone:
//   monkeypatch.setitem(app.config, "RETRY", 4)       the fix: undone after the test
//   app.config["X"] = 1 ... finally: app.config.pop("X", None)
//                                                      undone (the library's pt_undo and pt_covers): in a finally,
//                                                      after a fixture's yield, in an addCleanup / addfinalizer
//                                                      callback, a def undo code calls, or the teardown of a
//                                                      function-scoped fixture the test requests, by any write of the
//                                                      target or of a chain it runs through (`pop(k, default)`, `del`,
//                                                      `clear()`, `update(saved)`, setattr/delattr included); the undo
//                                                      itself is never reported
//   monkeypatch.setitem(app.ext, "k", None); del app.ext["k"]
//                                                      the target is patched where the change runs (pt_guarded:
//                                                      monkeypatch.setitem/delitem/setattr, patch.object, patch.dict
//                                                      over the container): the patch's teardown restores it
//   app.config.pop("DEV_USER", None)                   a defensive removal (pop with a default) outside undo code
//   api_client.delete("/items/1")                      not a mutator method (HTTP clients, ORM sessions' save/delete)
//   app.db.add(row); db_session.add(row)               a mutator on a database session (db, session, *_db, *session):
//                                                      rows, not the fixture's object; also `x.update(key, obj)`
//                                                      (two positional arguments), `x.add(name=n)` (a keyword
//                                                      argument), `a = x.update(...)` (the result used: a list, dict
//                                                      or set method returns None), and any method call through a
//                                                      fixture named client/*client/api/*_api/sdk (an API client:
//                                                      `client.agents.update(agent_id=a)` writes to a server). These
//                                                      are name and shape lists: the fixture's value has no type the
//                                                      run can resolve (a factory's return, a plugin's object)
//   cfg = dict(app.config); cfg["X"] = 1               a local copy
//   def test_x(fresh): fresh["a"] = 1                  fresh is function-scoped (also: a nearer conftest.py overrides
//                                                      a broad fixture with a function-scoped one)
//   def test_x(plugin_fixture): ...                    no fixture def of the run: a plugin's, scope unknown
//   def test_x(make_user): make_user("a")              a session-scoped factory: calling it builds a fresh object; a
//                                                      fixture that returns a def or lambda of its own is skipped
//   @pytest.fixture(scope="module") def seeded(rows): rows.append(1)
//                                                      a broader-scoped fixture changing its dependency: set-up, run
//                                                      once for its scope
//   @pytest.fixture(scope="module") def refs(): r = []; yield r; assert all(...r...)
//                                                      a collector: the fixture asserts on what tests added to it
//   @pytest.fixture(autouse=True) def defaults(app): app.x = 1
//                                                      an autouse fixture changing a class- or module-scoped value:
//                                                      every test sharing the value runs it, the same change for all
//   def test_x(app): app = create_app(); app.x = 1     the parameter is rebound before the write
//   @pytest.mark.parametrize("items", ...)             parametrize hides the fixture of that name (not indirect=)
// A plain function of a test document that the test calls with the value (`_enable(app)`) holds the same object: its
// changes are reported in it, and its writes in undo code (`finally: _reset(app)`) restore.
// Gaps: an alias (`cfg = app.config; cfg["X"] = 1`) is not followed, nor a method or a function outside test
// documents the value is passed to; mutating methods outside pt_mutator's list (a model's own setters) are not seen;
// a scope given by a callable ("dynamic") is skipped.

#include "lib/pytest.rerail"

.violation ScopedFixtureMutated(at: node, name: symbol, scope: symbol) "`{name}` is a {scope}-scoped fixture shared with later tests. Change it with monkeypatch.setitem/setattr or copy it in a function-scoped fixture; keep it if it collects state on purpose."
ScopedFixtureMutated(n, x, s) :- sfm_hit(n, k, t, x, g), !sfm_later(n, k, t), pt_fixture_scope(g, s).

.decl sfm_broad(s: symbol)
sfm_broad("class"). sfm_broad("module"). sfm_broad("package"). sfm_broad("session").

// sfm_runner(t): t runs once per test: a test, or a function-scoped fixture.
.decl sfm_runner(t: node)
sfm_runner(t) :- pt_test(t).
sfm_runner(t) :- pt_fixture(t), pt_fixture_scope(t, "function").

// sfm_value(e, t, x, g): identifier e, in runner t, reads the value of fixture x, which resolves to g: the parameter
// x (not rebound before e), or a name t binds to `request.getfixturevalue("x")`.
.decl sfm_value(e: node, t: node, x: symbol, g: node)
sfm_value(e, t, x, g) :- sfm_runner(t), pt_resolves(t, x, g), sig_param(t, _, nm, _, _, _, _), text(nm, x),
    kind(e, "identifier"), text(e, x), look(e, x, t), !bind_only(e), !latest_assign(e, x, _).
sfm_value(e, t, x, g) :- sfm_runner(t), pt_resolves(t, x, g), pt_getfixturevalue(c, x), def_frame(c, t),
    kind(a, "assignment"), field(a, "right", c), field(a, "left", v), kind(v, "identifier"), text(v, y),
    kind(e, "identifier"), text(e, y), look(e, y, t), !bind_only(e), latest_assign(e, y, a).
// A plain function of a test document that code holding the value calls with it: its parameter holds the same
// object (`_enable(app)`, `finally: _reset(app)`).
sfm_value(e, h, x, g) :- sfm_pass(h, j, x, g), sfm_hparam(h, j, y), kind(e, "identifier"), text(e, y), look(e, y, h),
    !bind_only(e), !latest_assign(e, y, _).
.decl sfm_pass(h: node, j: number, x: symbol, g: node)
sfm_pass(h, j, x, g) :- sfm_value(a, t, x, g), posarg(c, j, a), field(c, "function", f), kind(f, "identifier"),
    call_target(c, h), def_frame(c, t), docof(h, d), pt_test_doc(d).
.decl sfm_hpos(h: node, i: number, y: symbol)
sfm_hpos(h, i, y) :- kind(h, "function_definition"), docof(h, d), pt_test_doc(d), sig_param(h, _, nm, i, k, _, _),
    (k = "pos" ; k = "posonly"), text(nm, y).
.decl sfm_hparam(h: node, j: number, y: symbol)
sfm_hparam(h, j, y) :- sfm_hpos(h, i, y), j = count : { sfm_hpos(h, i2, _), i2 < i }.

// sfm_change(n, t, x, g, e, p): n, in t, changes path p below e, the value of fixture x resolving to broad g.
.decl sfm_change(n: node, t: node, x: symbol, g: node, e: node, p: symbol)
sfm_change(n, t, x, g, e, p) :- sfm_value(e, t, x, g), pt_fixture_scope(g, s), sfm_broad(s), pt_loc(n, e, p, how),
    how != "restore", p != "", pt_change(n), !sfm_factory(g), !sfm_collector(g), !sfm_parametrized(t, x),
    !sfm_uniform(t, g), !sfm_not_collection(n), !sfm_client_call(n, x), !sfm_defensive(n).

// sfm_collector(g): yield fixture g asserts on the value it yielded after the yield: a collector the tests fill on
// purpose and its teardown checks (`refs = []; yield refs; assert all(r() is None for r in refs)`). A teardown that
// only closes the value (`yield app; app.stop()`) does not make it one.
.decl sfm_collector(g: node)
sfm_collector(g) :- pt_yield(g, y), child(y, v0, 0), unparen(v0, v), kind(v, "identifier"), text(v, xv),
    kind(r, "identifier"), text(r, xv), pt_own(r, g), earlier(y, r), kind(a, "assert_statement"), within(r, a).

// sfm_not_collection(n): mutator call n is not a list/dict/set method by its shape: a database session's method
// (`app.db.add(row)`, `db.session.remove()`: rows, which the database fixtures reset), an `update` with two
// positional arguments (`user.repos.recipes.update(slug, recipe)`), a keyword argument to a method other than
// update/sort (`client.tools.add(func=f)`), or a result that is used where the collection method returns None
// (`agent = client.agents.update(...)`).
.decl sfm_not_collection(n: node)
sfm_not_collection(n) :- pt_mcall(n, r, _), sfm_last_name(r, y),
    z = @lower(y), (z = "db" ; z = "session" ; z = "dbsession" ; suffix("_db", z) ; suffix("session", z)).
sfm_not_collection(n) :- pt_mcall(n, _, "update"), posarg(n, 1, _).
sfm_not_collection(n) :- pt_mcall(n, _, m), m != "update", m != "sort", call_arg(n, -1, k, _), k != "".
sfm_not_collection(n) :- pt_mcall(n, _, m), m != "pop", m != "popitem", m != "setdefault", child(p, n, _),
    !kind(p, "expression_statement"), !kind(p, "lambda").
// sfm_defensive(n): `cfg.pop("X", None)` outside undo code: a defensive removal that makes sure a key some other test
// may have set is gone. In undo code the same call is the undo of the test's own change.
.decl sfm_defensive(n: node)
sfm_defensive(n) :- pt_mcall(n, _, "pop"), posarg(n, 1, _).
.decl sfm_last_name(r: node, y: symbol)
sfm_last_name(r, y) :- attr_of(r, _, y).
sfm_last_name(r, y) :- kind(r, "identifier"), text(r, y).
// sfm_client_call(n, x): a method call through a fixture named as an API or HTTP client (`client`, `api_client`,
// `sdk`): `client.agents.update(agent_id=a, tags=[])` writes to a server, not to the client object.
.decl sfm_client_call(n: node, x: symbol)
sfm_client_call(n, x) :- sfm_client_name(x), pt_mcall(n, _, _).
.decl sfm_client_name(x: symbol)
sfm_client_name(x) :- pt_requests(_, x, _), z = @lower(x),
    (z = "client" ; suffix("_client", z) ; suffix("client", z) ; z = "api" ; suffix("_api", z) ; z = "sdk").

// sfm_uniform(t, g): t is an autouse fixture and g is class- or module-scoped: every test sharing g's value runs t,
// so the change is the same for all of them (module-wide set-up).
.decl sfm_uniform(t: node, g: node)
sfm_uniform(t, g) :- pt_autouse(t), pt_fixture(g), (pt_fixture_scope(g, "module") ; pt_fixture_scope(g, "class")).

// sfm_factory(g): fixture g returns (or yields) a def or lambda of its own body: each call makes a fresh object.
.decl sfm_factory(g: node)
sfm_factory(g) :- pt_fixture(g), (kind(r, "return_statement") ; kind(r, "yield")), pt_own(r, g), child(r, v0, 0),
    unparen(v0, v), sfm_fn_value(v, g).
.decl sfm_fn_value(v: node, g: node)
sfm_fn_value(v, g) :- kind(v, "lambda"), pt_fixture(g).
sfm_fn_value(v, g) :- kind(v, "identifier"), text(v, x), defn(g, x, f), kind(f, "function_definition").

// sfm_parametrized(t, x): a parametrize mark on t or its class supplies x directly, hiding the fixture. With
// `indirect=` the value goes through the fixture (request.param), which stays shared by its scope.
.decl sfm_parametrized(t: node, x: symbol)
sfm_parametrized(t, x) :- sfm_runner(t), (decorator(t, e0) ; pt_class_of(t, c), decorator(c, e0)), unparen(e0, e),
    kind(e, "call"), field(e, "function", f), attr_of(f, _, "parametrize"), call_arg(e, 0, "", a),
    str(a, s), match_all("\\s*(?<x>[^,\\s]+)\\s*", s), !sfm_indirect(e).
.decl sfm_indirect(e: node)
sfm_indirect(e) :- kind(e, "call"), call_arg(e, -1, "indirect", v), !kind(v, "false").

// sfm_restored(n): an undo or patch the library sees puts n's change back: a restore below a value of the same
// fixture (in t, a lambda or local def of t, or a fixture t requests) that covers n's path (pt_covers).
.decl sfm_restored(n: node)
sfm_restored(n) :- sfm_change(n, _, _, g, e, p), pt_restore(n, e2, a), sfm_value(e2, _, _, g), pt_covers(n, e, p, a).

// sfm_hit(n, k, t, x, g): a change of k (the fixture's def and the path) in t that is not undo code and that nothing
// puts back; sfm_later(n, k, t): another one of k comes before it in t.
.decl sfm_hit(n: node, k: symbol, t: node, x: symbol, g: node)
sfm_hit(n, cat(x, p), t, x, g) :- sfm_change(n, t, x, g, _, p), !pt_undo(n, _), !sfm_restored(n).
.decl sfm_later(n: node, k: symbol, t: node)
sfm_later(n, k, t) :- sfm_hit(n, k, t, _, _), sfm_hit(m, k, t, _, _), earlier(m, n).

// The cases, `cases/pytest-practice-scoped-fixture-mutated/`, read as one repository: each line ending in `# caught`
// is reported, and no other line.
.test cases exactly
    .fixture "conftest.py" from "../cases/pytest-practice-scoped-fixture-mutated/conftest.py"
    .fixture "shop/__init__.py" from "../cases/pytest-practice-scoped-fixture-mutated/shop/__init__.py"
    .fixture "shop/app.py" from "../cases/pytest-practice-scoped-fixture-mutated/shop/app.py"
    .fixture "tests/sub/conftest.py" from "../cases/pytest-practice-scoped-fixture-mutated/tests/sub/conftest.py"
    .fixture "tests/sub/test_override.py" from "../cases/pytest-practice-scoped-fixture-mutated/tests/sub/test_override.py"
    .fixture "tests/test_app.py" from "../cases/pytest-practice-scoped-fixture-mutated/tests/test_app.py"
    .fixture "tests/test_autouse.py" from "../cases/pytest-practice-scoped-fixture-mutated/tests/test_autouse.py"
    .fixture "tests/test_class_scope.py" from "../cases/pytest-practice-scoped-fixture-mutated/tests/test_class_scope.py"
    .expect _ at "conftest.py":47
    .expect _ at "conftest.py":61
    .expect _ at "tests/sub/test_override.py":7
    .expect _ at "tests/test_app.py":9
    .expect _ at "tests/test_app.py":14
    .expect _ at "tests/test_app.py":18
    .expect _ at "tests/test_app.py":22
    .expect _ at "tests/test_app.py":26
    .expect _ at "tests/test_app.py":30
    .expect _ at "tests/test_app.py":34
    .expect _ at "tests/test_app.py":38
    .expect _ at "tests/test_app.py":43
    .expect _ at "tests/test_app.py":50
    .expect _ at "tests/test_app.py":55
    .expect _ at "tests/test_app.py":143
    .expect _ at "tests/test_app.py":150
    .expect _ at "tests/test_app.py":183
    .expect _ at "tests/test_app.py":209
    .expect _ at "tests/test_app.py":232
    .expect _ at "tests/test_app.py":237
    .expect _ at "tests/test_app.py":246
    .expect _ at "tests/test_autouse.py":11
    .expect _ at "tests/test_class_scope.py":21
    .expect _ at "tests/test_class_scope.py":24
.end
