in_scope(d) :- doc(d, p, _), glob("l9700_graph_query/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9710_graph_algorithms/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9720_sparql/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9750_graphql/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9800_rippling/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9850_workflow/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9875_mcp/**/*.py", p).
in_scope(d) :- doc(d, p, _), glob("l9900_auto_api/**/*.py", p).
out_scope(d) :- doc(d, p, _), glob("**/.git/**", p).
out_scope(d) :- doc(d, p, _), glob("**/.venv/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tmp/**", p).
out_scope(d) :- doc(d, p, _), glob("**/__pycache__/**", p).
out_scope(d) :- doc(d, p, _), glob("**/tests/**", p).
tape_syntax_error(d) :- syntax_error(d).
kind(n, k) :- node(_, n, k, _, _).
ann_root(t) :- kind(p, k), (k = "typed_parameter" ; k = "typed_default_parameter"), field(p, "type", t).
ann_root(t) :- kind(f, "function_definition"), field(f, "return_type", t).
ann_root(t) :- kind(a, "assignment"), field(a, "type", t).
ann_ctx(s) :- ann_root(a), s = a.
ann_ctx(s) :- ann_root(a), within(s, a).
ann_str(s) :- kind(s, "string"), !concat_part(s), !literal_str(s).
ann_str(s) :- kind(s, "concatenated_string"), !concat_part(s), !literal_str(s).
concat_part(s) :- kind(c, "concatenated_string"), child(c, s, _).
literal_str(s) :- kind(l, "subscript"), field(l, "value", v), kind(v, "identifier"), text(v, t), t = "Literal", within(s, l), !within(s, v).
literal_str(s) :- kind(l, "subscript"), field(l, "value", v), kind(v, "identifier"), text(v, t), suffix(".Literal", t), within(s, l), !within(s, v).
literal_str(s) :- kind(l, "subscript"), field(l, "value", v), kind(v, "attribute"), text(v, t), t = "Literal", within(s, l), !within(s, v).
literal_str(s) :- kind(l, "subscript"), field(l, "value", v), kind(v, "attribute"), text(v, t), suffix(".Literal", t), within(s, l), !within(s, v).
literal_str(s) :- kind(l, "generic_type"), child(l, v, 0), text(v, "Literal"), within(s, l).
ann_parse(s, r) :- ann_ctx(s), ann_str(s), parsed(s, "annotation", r).
ann_parse(s, r) :- string_annotation(s), host_node(s, h), ann_host(h, _), parsed(s, "annotation", r).
ann_host(h, s) :- ann_ctx(s), ann_parse(s, r), host_node(r, h), h = s.
ann_host(h, s) :- ann_ctx(s), ann_parse(s, r), host_node(r, h), within(h, s).
ann_host(h, t) :- ann_parse(s, r), host_node(s, h0), ann_host(h0, t), host_node(r, h), h != h0.
impmod(i, m) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "dotted_name"), text(mn, m).
impmod(i, p) :- rel_base(i, p), p != "", field(i, "module_name", mn), !child(mn, _, 1).
impmod(i, @dot(p, m)) :- rel_base(i, p), p != "", field(i, "module_name", mn), child(mn, dn, 1), text(dn, m).
rifrom(s, y, m, y) :- impmod(i, m), field(i, "name", n), kind(n, "dotted_name"), text(n, y), nearest(i, s, scope).
rifrom(s, a, m, y) :- impmod(i, m), field(i, "name", x), kind(x, "aliased_import"), field(x, "name", n), text(n, y), field(x, "alias", al), text(al, a), nearest(i, s, scope).
ribind(s, x, @dot(m, y)) :- rifrom(s, x, m, y).
ribind(s, t, t) :- kind(i, "import_statement"), field(i, "name", n), kind(n, "dotted_name"), child(n, c, 0), text(c, t), nearest(i, s, scope).
ribind(s, a, m) :- kind(i, "import_statement"), field(i, "name", x), kind(x, "aliased_import"), field(x, "name", n), text(n, m), field(x, "alias", al), text(al, a), nearest(i, s, scope).
irel_open(i) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"), !impmod(i, _).
rotgt(s, y) :- irel_open(i), field(i, "name", n), kind(n, "dotted_name"), text(n, y), nearest(i, s, scope).
rotgt(s, a) :- irel_open(i), field(i, "name", x), kind(x, "aliased_import"), field(x, "alias", al), text(al, a), nearest(i, s, scope).
rel_base(i, @pkg_up(p, k)) :- kind(i, "import_from_statement"), field(i, "module_name", mn), kind(mn, "relative_import"), child(mn, pre, 0), text(pre, dots), k = @sub(@strlen(dots), 1), docof(i, d), pkg(d, p).
module_text(i, m) :- impmod(i, m).
module_text(i, m) :- rel_base(i, p), field(i, "module_name", mn), !child(mn, _, 1), m = p.
module_text(i, @dot(p, s)) :- rel_base(i, p), field(i, "module_name", mn), child(mn, dn, 1), text(dn, s).
module_text(i, m) :- kind(i, "import_statement"), field(i, "name", n), dotted(n, m).
import_alias(i, n, m, "", @head(m)) :- kind(i, "import_statement"), field(i, "name", n), kind(n, "dotted_name"), text(n, m).
import_alias(i, n, m, "", l) :- kind(i, "import_statement"), field(i, "name", n), kind(n, "aliased_import"), field(n, "name", d), text(d, m), field(n, "alias", al), text(al, l).
import_alias(i, n, m, x, x) :- kind(i, "import_from_statement"), module_text(i, m), field(i, "name", n), kind(n, "dotted_name"), text(n, x).
import_alias(i, n, m, x, l) :- kind(i, "import_from_statement"), module_text(i, m), field(i, "name", n), kind(n, "aliased_import"), field(n, "name", d), text(d, x), field(n, "alias", al), text(al, l).
dotted(n, s) :- kind(n, "dotted_name"), text(n, s).
dotted(n, s) :- kind(n, "aliased_import"), field(n, "name", d), text(d, s).
import_site(a, l) :- import_alias(_, a, _, _, l).
lscope(k) :- scope(k).
lscope(k) :- comp_scope(k).
rr_ctx14(c, i) :- comp_scope(k), kind(c, k), child(c, fc, i), kind(fc, "for_in_clause").
rr_agg13(c, g, i, j) :- rr_demand_agg_rr_agg13(c, i), rr_ctx14(c, i), child(c, g, j), kind(g, "for_in_clause"), j < i.
first_for(c, fc) :- comp_scope(k), kind(c, k), child(c, fc, i), kind(fc, "for_in_clause"), !rr_agg13(c, _, i, _).
modnode(d, m) :- node(d, m, "module", _, _).
nameref(n, x) :- kind(n, "identifier"), text(n, x), !field(_, "attribute", n), !field(_, "name", n), !kwpat_key(n), !pat_tail(n).
kwpat_key(n) :- kind(k, "keyword_pattern"), child(k, n, 0).
pat_tail(n) :- kind(d, "dotted_name"), child(d, n, i), i > 0, child(p, d, _), kind(p, "case_pattern").
pat_tail(n) :- kind(d, "dotted_name"), child(d, n, i), i > 0, child(p, d, _), kind(p, "class_pattern").
pat_tail(n) :- kind(d, "dotted_name"), child(d, n, i), i > 0, child(p, d, _), kind(p, "dict_pattern").
pat_tail(n) :- kind(d, "dotted_name"), child(d, n, i), i > 0, child(p, d, _), kind(p, "keyword_pattern").
pat_tail(n) :- kind(d, "dotted_name"), child(d, n, i), i > 0, child(p, d, _), kind(p, "union_pattern").
rdefn(s, x, f) :- kind(f, "function_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, scope).
rdefn(s, x, f) :- kind(f, "class_definition"), field(f, "name", nm), text(nm, x), nearest(f, s, scope).
rasg(s, x, r, a) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier"), text(l, x), field(a, "right", r), nearest(a, s, scope).
param(f, x, i) :- param_list(f, ps), child(ps, p, i), kind(p, "identifier"), text(p, x).
param(f, x, i) :- param_list(f, ps), child(ps, p, i), child(p, id, 0), kind(id, "identifier"), text(id, x).
param(f, x, i) :- param_list(f, ps), child(ps, p, i), kind(p, "typed_parameter"), child(p, sp, 0), child(sp, id, 0), kind(id, "identifier"), text(id, x).
param_list(f, ps) :- kind(f, "function_definition"), field(f, "parameters", ps).
param_list(f, ps) :- kind(f, "lambda"), field(f, "parameters", ps).
tgt(l) :- kind(a, "assignment"), field(a, "left", l), !kind(l, "identifier").
tgt(l) :- kind(a, "augmented_assignment"), field(a, "left", l).
tgt(l) :- kind(a, "for_statement"), field(a, "left", l).
tgt(l) :- kind(a, "for_in_clause"), field(a, "left", l).
tgt(l) :- kind(a, "named_expression"), field(a, "name", l).
tgt(l) :- kind(l, "as_pattern_target").
tgt(t) :- kind(d, "dotted_name"), child(d, t, 0), !child(d, _, 1), child(p, d, _), capture_parent(p).
tgt(t) :- kind(p, "splat_pattern"), child(p, t, _), kind(t, "identifier").
tgt(t) :- kind(p, "as_pattern"), child(c, p, _), kind(c, "case_pattern"), child(p, t, _), kind(t, "identifier").
tgt(t) :- kind(a, "type_alias_statement"), field(a, "left", l), child(l, t, 0), kind(t, "identifier").
tgt(t) :- kind(a, "type_alias_statement"), field(a, "left", l), child(l, g, 0), kind(g, "generic_type"), child(g, t, 0), kind(t, "identifier").
tgt(c) :- tgt(t), kind(t, k), patkind(k), child(t, c, _).
tgt(c) :- tgt(t), kind(t, "as_pattern_target"), child(t, c, _).
capture_parent(p) :- kind(p, "case_pattern").
capture_parent(p) :- kind(p, "keyword_pattern").
capture_parent(p) :- kind(p, "union_pattern").
tscope(t, s) :- tgt(t), nearest(t, s, lscope), kind(s, k), scope(k).
tscope(t, c) :- tgt(t), nearest(t, c, lscope), kind(c, k), comp_scope(k), !walrus_tgt(t).
tscope(t, s) :- tgt(t), nearest(t, c, lscope), kind(c, k), comp_scope(k), walrus_tgt(t), nearest(c, s, scope).
walrus_tgt(t) :- kind(a, "named_expression"), field(a, "name", t).
rotgt(s, x) :- tgt(t), kind(t, "identifier"), text(t, x), tscope(t, s).
decl(s, x, m) :- kind(g, "global_statement"), child(g, i, _), text(i, x), nearest(g, s, scope), docof(g, d), modnode(d, m).
decl(s, x, t) :- nl_try(s, x, t), nl_owns(t, x).
rnl(s, x) :- kind(g, "nonlocal_statement"), child(g, i, _), text(i, x), nearest(g, s, scope).
nl_try(s, x, p) :- rnl(s, x), nearest(s, p, fscope), !kind(p, "module").
nl_try(s, x, q) :- nl_try(s, x, p), !nl_owns(p, x), nearest(p, q, fscope), !kind(q, "module").
nl_owns(p, x) :- rbound(p, x), !rnl(p, x).
nl_owns(p, x) :- param(p, x, _), !rnl(p, x).
rbound(s, x) :- rdefn(s, x, _).
rbound(s, x) :- rasg(s, x, _, _).
rbound(s, x) :- rotgt(s, x).
rbound(s, x) :- ribind(s, x, _).
home(s, x, s) :- rbound(s, x), !decl(s, x, _).
home(s, x, t) :- rbound(s, x), decl(s, x, t).
defn(t, x, f) :- rdefn(s, x, f), home(s, x, t).
asg(t, x, r, a) :- rasg(s, x, r, a), home(s, x, t).
otgt(t, x) :- rotgt(s, x), home(s, x, t).
ibind(t, x, q) :- ribind(s, x, q), home(s, x, t).
bound_in(s, x) :- defn(s, x, _).
bound_in(s, x) :- asg(s, x, _, _).
bound_in(f, x) :- param(f, x, _).
bound_in(s, x) :- otgt(s, x).
bound_in(s, x) :- ibind(s, x, _).
bound_in(c, x) :- kind(c, "class_definition"), x = "__qualname__".
bound_in(c, x) :- kind(c, "class_definition"), x = "__module__".
walk(n, x, s) :- nameref(n, x), wstart(n, s), !tp_ref(n, x).
walk(n, x, p) :- walk(n, x, s), !bound_in(s, x), !gbefore(n, x, s), scope_up(s, p).
walk(n, x, p) :- walk(n, x, s), cls_late(n, x, s), scope_up(s, p).
gbefore(n, x, s) :- gbind(s, x, b), nameref(n, x), node_order(b, rr_ord0), node_order(n, rr_ord1), rr_ord0 < rr_ord1, !within(n, b).
gbind(s, x, b) :- decl(s, x, m), kind(m, "module"), rasg(s, x, _, b).
gbind(s, x, b) :- decl(s, x, m), kind(m, "module"), rdefn(s, x, b).
gbind(s, x, t) :- decl(s, x, m), kind(m, "module"), tgt(t), kind(t, "identifier"), text(t, x), tscope(t, s).
cls_late(n, x, s) :- wstart(n, s), kind(s, "class_definition"), nameref(n, x), bound_in(s, x), !cls_early(n, x, s), !otgt(s, x), !ibind(s, x, _), x != "__qualname__", x != "__module__".
cls_early(n, x, s) :- wstart(n, s), kind(s, "class_definition"), nameref(n, x), defn(s, x, f), node_order(f, rr_ord2), node_order(n, rr_ord3), rr_ord2 < rr_ord3.
cls_early(n, x, s) :- wstart(n, s), kind(s, "class_definition"), nameref(n, x), asg(s, x, _, a), node_order(a, rr_ord4), node_order(n, rr_ord5), rr_ord4 < rr_ord5, !within(n, a).
wstart(n, s) :- nameref(n, _), nearest(n, s, lscope), kind(s, k), scope(k), !def_outside(n, _).
wstart(n, c) :- nameref(n, _), nearest(n, c, lscope), kind(c, k), comp_scope(k), !in_first_iter(n, c).
wstart(n, s) :- def_outside(n, f), nearest(f, s, lscope).
wstart(n, s) :- in_first_iter(n, c), nearest(c, s, lscope).
wstart(n, s) :- nameref(n, _), host_node(n, h), ann_start(h, s).
def_outside(n, f) :- nameref(n, _), !bind_only(n), nearest(n, f, lscope), kind(f, "function_definition"), field(f, "parameters", p), within(n, p).
def_outside(n, f) :- nameref(n, _), !bind_only(n), nearest(n, f, lscope), kind(f, "function_definition"), field(f, "return_type", p), within(n, p).
def_outside(n, f) :- nameref(n, _), !bind_only(n), nearest(n, f, lscope), kind(f, "lambda"), field(f, "parameters", p), within(n, p).
def_outside(n, f) :- nameref(n, _), !bind_only(n), nearest(n, f, lscope), kind(f, "lambda"), field(f, "return_type", p), within(n, p).
in_first_iter(n, c) :- nameref(n, _), nearest(n, c, lscope), comp_scope(k), kind(c, k), first_for(c, fc), field(fc, "right", e), n = e.
in_first_iter(n, c) :- nameref(n, _), nearest(n, c, lscope), comp_scope(k), kind(c, k), first_for(c, fc), field(fc, "right", e), within(n, e).
tp_name(o, x) :- kind(o, "function_definition"), field(o, "type_parameters", tp), tp_list(tp, x).
tp_name(o, x) :- kind(o, "class_definition"), field(o, "type_parameters", tp), tp_list(tp, x).
tp_name(o, x) :- kind(o, "type_alias_statement"), field(o, "left", l), child(l, g, 0), kind(g, "generic_type"), child(g, tp, _), kind(tp, "type_parameter"), tp_list(tp, x).
tp_list(tp, x) :- kind(tp, "type_parameter"), child(tp, ty, _), kind(ty, "type"), child(ty, d, 0), tp_decl(d, x).
tp_list(tp, x) :- kind(tp, "type_parameter"), child(tp, td, _), kind(td, "type_default"), field(td, "name", ty), child(ty, d, 0), tp_decl(d, x).
tp_decl(d, x) :- kind(d, "identifier"), text(d, x).
tp_decl(d, x) :- kind(d, "splat_type"), child(d, i, _), kind(i, "identifier"), text(i, x).
tp_decl(d, x) :- kind(d, "constrained_type"), child(d, ty, 0), child(ty, i, 0), kind(i, "identifier"), text(i, x).
tp_ref(n, x) :- tp_doc(d), docof(n, d), nameref(n, x), tp_name(o, x), docof(o, d), within(n, o).
tp_doc(d) :- tp_name(o, _), docof(o, d).
look(n, x, s) :- walk(n, x, s), bound_in(s, x), !cls_late(n, x, s).
look(n, x, s) :- walk(n, x, s), !bound_in(s, x), gbefore(n, x, s).
ann_start(h, s) :- ann_host(h, t), nearest(t, s, lscope).
scope_up(s, p) :- kind(s, k), lscope(k), nearest(s, p, lfscope).
binding(s, x, f, "def") :- defn(s, x, f), kind(f, "function_definition").
binding(s, x, f, "class") :- defn(s, x, f), kind(f, "class_definition").
binding(s, x, a, "assign") :- asg(s, x, _, a).
binding(f, x, p, "param") :- param(f, x, i), field(f, "parameters", ps), child(ps, p, i).
binding(s, x, i, "import") :- import_site(i, x), nearest(i, s0, scope), home(s0, x, s).
binding(s, x, t, form) :- tgt(t), kind(t, "identifier"), text(t, x), target_form(t, form), tscope(t, s0), home(s0, x, s).
tp_site(o, d) :- kind(o, "function_definition"), field(o, "type_parameters", tp), tp_ident(tp, d).
tp_site(o, d) :- kind(o, "class_definition"), field(o, "type_parameters", tp), tp_ident(tp, d).
tp_site(o, d) :- kind(o, "type_alias_statement"), field(o, "left", l), child(l, g, 0), kind(g, "generic_type"), child(g, tp, _), kind(tp, "type_parameter"), tp_ident(tp, d).
tp_ident(tp, i) :- kind(tp, "type_parameter"), child(tp, ty, _), kind(ty, "type"), child(ty, d, 0), tp_decl_id(d, i).
tp_ident(tp, i) :- kind(tp, "type_parameter"), child(tp, td, _), kind(td, "type_default"), field(td, "name", ty), child(ty, d, 0), tp_decl_id(d, i).
tp_decl_id(d, d) :- kind(d, "identifier").
tp_decl_id(d, i) :- kind(d, "splat_type"), child(d, i, _), kind(i, "identifier").
tp_decl_id(d, i) :- kind(d, "constrained_type"), child(d, ty, 0), child(ty, i, 0), kind(i, "identifier").
del_site(s, n, st) :- kind(st, "delete_statement"), del_unbinds(st, n), !del_conditional(st), nearest(st, s, scope).
del_unbinds(st, n) :- kind(st, "delete_statement"), child(st, n, _), kind(n, "identifier").
del_unbinds(st, n) :- kind(st, "delete_statement"), child(st, l, _), kind(l, "expression_list"), child(l, n, _), kind(n, "identifier").
del_unbinds(st, n) :- kind(st, "delete_statement"), child(st, l, _), kind(l, "parenthesized_expression"), child(l, n, _), kind(n, "identifier").
del_unbinds(st, n) :- kind(st, "delete_statement"), child(st, l, _), kind(l, "tuple"), child(l, n, _), kind(n, "identifier").
del_unbinds(st, n) :- kind(st, "delete_statement"), child(st, l, _), kind(l, "list"), child(l, n, _), kind(n, "identifier").
del_conditional(st) :- kind(st, "delete_statement"), within(st, a), kind(a, "if_statement").
del_conditional(st) :- kind(st, "delete_statement"), within(st, a), kind(a, "while_statement").
del_conditional(st) :- kind(st, "delete_statement"), within(st, a), kind(a, "match_statement").
del_conditional(st) :- kind(st, "delete_statement"), within(st, a), kind(a, "else_clause"), child(p, a, _), kind(p, "for_statement").
del_conditional(st) :- kind(st, "delete_statement"), within(st, a), kind(a, "else_clause"), child(p, a, _), kind(p, "while_statement").
del_conditional(st) :- kind(st, "delete_statement"), within(st, a), kind(a, "else_clause"), child(p, a, _), kind(p, "try_statement").
rr_ctx17(a, st) :- kind(st, "delete_statement"), within(st, a), kind(a, "except_clause").
rr_ctx17(a, st) :- kind(st, "delete_statement"), within(st, a), kind(a, "except_group_clause").
rr_agg16(a, f, st) :- rr_demand_agg_rr_agg16(a, st), rr_ctx17(a, st), within(st, f), within(f, a), kind(f, "function_definition").
rr_agg16(a, f, st) :- rr_demand_agg_rr_agg16(a, st), rr_ctx17(a, st), within(st, f), within(f, a), kind(f, "class_definition").
del_conditional(st) :- kind(st, "delete_statement"), within(st, a), kind(a, "except_clause"), !rr_agg16(a, _, st).
del_conditional(st) :- kind(st, "delete_statement"), within(st, a), kind(a, "except_group_clause"), !rr_agg16(a, _, st).
bind_only(l) :- kind(a, "assignment"), field(a, "left", l), kind(l, "identifier").
bind_only(t) :- tgt(t), kind(t, "identifier"), !aug_target(t).
bind_only(id) :- field(f, "parameters", ps), child(ps, p, _), id = p, kind(id, "identifier").
bind_only(id) :- field(f, "parameters", ps), child(ps, p, _), child(p, id, 0), kind(id, "identifier").
bind_only(id) :- field(f, "parameters", ps), child(ps, p, _), kind(p, "typed_parameter"), child(p, sp, 0), child(sp, id, 0), kind(id, "identifier").
bind_only(i) :- tp_site(_, i).
bind_only(i) :- kind(t, "type_alias_statement"), field(t, "left", l), within(i, l), kind(i, "identifier"), !tp_alias_read(i).
tp_alias_read(i) :- kind(t, "type_alias_statement"), field(t, "left", l), child(l, g, 0), kind(g, "generic_type"), child(g, tp, _), kind(tp, "type_parameter"), within(i, tp), kind(i, "identifier"), !tp_site(t, i).
bind_only(n) :- kind(i, "import_statement"), within(n, i), kind(n, "identifier").
bind_only(n) :- kind(i, "import_from_statement"), within(n, i), kind(n, "identifier").
bind_only(n) :- kind(i, "future_import_statement"), within(n, i), kind(n, "identifier").
bind_only(n) :- kind(g, "global_statement"), child(g, n, _), kind(n, "identifier").
bind_only(n) :- kind(g, "nonlocal_statement"), child(g, n, _), kind(n, "identifier").
aug_target(l) :- kind(a, "augmented_assignment"), field(a, "left", l).
target_form(t, f) :- nearest(t, a, target_stmt), kind(a, k), form_of_kind(k, f).
rf_def(f, x) :- kind(f, k), rf_dc(k), field(f, "name", n), text(n, x).
rf_module(d, m) :- rf_pydoc(d, p), !unpackaged(d), doc(d, p, m).
rf_module(d, m) :- rf_pydoc(d, p), unpackaged(d), m = @rx_replace(@rx_replace(p, "^.*/", ""), "[.][^.]*$", ""), m != "".
rf_pydoc(d, p) :- doc(d, p, _), @rx_matches(p, "[.]pyi?$") = 1, !references_given(1).
rf_pydoc(d, p) :- doc(d, p, _), @rx_matches(p, "[.]pyi?$") = 1, references_given(1), references_include(g), glob(g, p), !rf_scope_out(d).
rf_scope_out(d) :- doc(d, p, _), references_exclude(g), glob(g, p).
rf_doc_name(d, m) :- rf_module(d, m).
rf_doc_name(d, a) :- rf_path_module(d, a).
rf_qn(f, q) :- rf_def(f, x), !inside(f, _, rf_dc), docof(f, d), rf_module(d, m), q = @dot(m, x).
rf_qn(f, q) :- rf_def(f, x), nearest(f, s, rf_dc), kind(s, "class_definition"), rf_qn(s, p), q = @concat(@concat(p, "."), x).
rf_qn(f, q) :- rf_def(f, x), nearest(f, s, rf_dc), kind(s, "function_definition"), rf_qn(s, p), q = @concat(@concat(p, ".<locals>."), x).
rf_start(n, s) :- node(_, n, _, s, _).
rf_is_class(f) :- rf_def(f, _), kind(f, "class_definition").
rf_is_function(f) :- rf_def(f, _), kind(f, "function_definition").
rf_body(g, b) :- kind(g, "function_definition"), field(g, "body", b).
rf_in(n, g) :- rf_site(n), nearest(n, g, fdef), rf_body(g, b), within(n, b).
rf_in(n, h) :- rf_site(n), nearest(n, g, fdef), rf_body(g, b), !within(n, b), rf_fn_in(g, h).
rf_fn_in(g, h) :- rf_is_function(g), nearest(g, h0, fdef), rf_body(h0, b), within(g, b), h = h0.
rf_fn_in(g, h) :- rf_is_function(g), nearest(g, h0, fdef), rf_body(h0, b), !within(g, b), rf_fn_in(h0, h).
rf_top(g, g) :- rf_is_function(g), !rf_fn_in(g, _).
rf_top(g, t) :- rf_fn_in(g, h), rf_top(h, t).
rf_owner(n, t) :- rf_in(n, g), rf_top(g, t).
rf_owner_class(t, c, q) :- rf_top(t, t), nearest(t, c, rf_dc), kind(c, "class_definition"), rf_qn(c, q).
rf_site(c) :- kind(c, "call").
rf_site(a) :- kind(a, "attribute"), field(a, "object", o), kind(o, "identifier"), !field(_, "function", a).
rf_site(i) :- kind(i, "identifier"), !field(_, "function", i), rf_read(i), !rf_object(i).
rf_object(i) :- kind(a, "attribute"), field(a, "object", i).
rf_read(i) :- nameref(i, _), !bind_only(i), !rf_deleted(i), !guest_of(i, _).
rf_deleted(n) :- del_unbinds(_, n).
rf_expr(c, e, t) :- kind(c, "call"), rf_owner(c, t), field(c, "function", e).
rf_expr(n, n, t) :- rf_site(n), !kind(n, "call"), rf_owner(n, t).
rf_bind(i, x, s) :- rf_head(i), look(i, x, s), !rf_forward(i, _, _).
rf_bind(i, x, m) :- rf_forward(i, x, m).
rf_forward(i, x, m) :- rf_annot_head(i, x, d), kind(m, "module"), docof(m, d), rf_mlatest(m, x, _, form), form != "del".
rf_annot_head(i, x, d) :- rf_in_annot(i), rf_head(i), docof(i, d), rf_future(d), text(i, x).
rf_in_annot(a) :- rf_annot(a).
rf_in_annot(c) :- rf_in_annot(p), child(p, c, _).
rf_annot(a) :- kind(p, "typed_parameter"), field(p, "type", a).
rf_annot(a) :- kind(p, "typed_default_parameter"), field(p, "type", a).
rf_annot(a) :- kind(p, "assignment"), field(p, "type", a).
rf_annot(a) :- kind(f, "function_definition"), field(f, "return_type", a).
rf_future(d) :- kind(i, "future_import_statement"), within(n, i), kind(n, "dotted_name"), text(n, "annotations"), docof(i, d).
rf_future(d) :- doc(d, p, _), @rx_matches(p, "[.]pyi$") = 1.
rf_head(i) :- rf_expr(_, i, _), kind(i, "identifier").
rf_head(o) :- rf_expr(_, a, _), kind(a, "attribute"), field(a, "object", o), kind(o, "identifier").
rf_param_of(i, f) :- rf_bind(i, x, f), param(f, x, _).
rf_local(i, t) :- rf_expr(i, i, t), rf_bind(i, x, s), !kind(s, "module"), !defn(s, x, _), !param(s, x, _).
rf_local(i, t) :- rf_expr(i, i, t), rf_param_of(i, t).
rf_local(i, t) :- rf_expr(i, i, t), rf_bind(i, x, s), !kind(s, "module"), param(s, x, _), asg(s, x, _, a), node_order(a, rr_ord6), node_order(i, rr_ord7), rr_ord6 < rr_ord7, !within(i, a).
rf_local(i, t) :- rf_expr(i, i, t), rf_bind(i, x, s), kind(s, "lambda"), param(s, x, _), nearest(s, t, fdef).
rf_local(i, t) :- rf_expr(i, i, t), tp_ref(i, _), !rf_forward(i, _, _).
rf_mbind(m, x, site, form) :- rf_bscope(m), binding(m, x, site, form), !rf_from_function(m, site).
rf_mbind(m, x, st, "del") :- rf_bscope(m), del_site(m, n, st), text(n, x), !rf_from_function(m, st).
rf_from_function(m, site) :- rf_bscope(m), binding(m, _, site, _), nearest(site, f, rf_fnl), within(f, m).
rf_from_function(m, st) :- rf_bscope(m), del_site(m, _, st), nearest(st, f, rf_fnl), within(f, m).
rf_bscope(s) :- kind(s, "module").
rf_bscope(s) :- kind(s, "class_definition").
rf_member_scope(m, md) :- kind(m, "module"), docof(m, d), rf_doc_name(d, md), md != "".
rf_member_scope(c, q) :- kind(c, "class_definition"), rf_qn(c, q).
rf_member_scope(c, a) :- kind(c, "class_definition"), rf_qn(c, q), docof(c, d), rf_spelled(d, q, a).
rf_cond(site) :- rf_mbind(_, _, site, _), nearest(site, a, rf_condstop), kind(a, k), rf_condk(k).
rf_muncond(m, x, s) :- rf_mbind(m, x, site, _), !rf_cond(site), rf_start(site, s).
rf_mreset(m, x, s) :- rf_muncond(m, x, _), s = max t : { rf_muncond(m, x, t) }.
rf_mlast(m, x, site) :- rf_mbind(m, x, site, _), rf_start(site, s), rf_mreset(m, x, r), s >= r.
rf_mlast(m, x, site) :- rf_mbind(m, x, site, _), !rf_mreset(m, x, _).
rf_mlive(m, x, site, form) :- rf_mlast(m, x, site), rf_mbind(m, x, site, form), form != "del".
rf_mlive_n(m, x, k) :- rf_mlive(m, x, _, _), k = count : { rf_mlive(m, x, _, _) }.
rf_mlive_other(m, x) :- rf_mlive(m, x, _, f), f != "def", f != "class".
rr_agg18(m, t, x) :- rr_demand_agg_rr_agg18(m, x), rf_mbind(m, x, b, _), rf_start(b, t).
rf_mlatest_at(m, x, s) :- rf_mbind(m, x, _, _), s = max t : { rr_agg18(m, t, x) }.
rf_mlatest(m, x, site, form) :- rf_mlatest_at(m, x, s), rf_mbind(m, x, site, form), rf_start(site, s).
rf_names(i, q) :- rf_bind(i, x, m), kind(m, "module"), rf_mlive_n(m, x, 1), rf_mlatest(m, x, site, "import"), rf_import_target(site, q).
rf_names(i, q) :- rf_bind(i, x, m), kind(m, "module"), rf_mlive_n(m, x, k), k >= 1, rf_mlatest(m, x, f, form), (form = "def" ; form = "class"), !rf_mlive_other(m, x), rf_qn(f, q).
rf_names(i, q) :- rf_bind(i, x, m), kind(m, "module"), rf_mlive_n(m, x, k), k > 1, rf_mlive_other(m, x), rf_mlatest(m, x, _, form), form != "assign", docof(m, d), rf_module(d, md), md != "", q = @dot(md, x).
rf_names(i, q) :- rf_fn_seen(i, s, x, f), defn(s, x, f), !rf_rebound(s, x, f), rf_qn(f, q).
rf_rebound(s, x, f) :- defn(s, x, f), !kind(s, "module"), rf_start(f, a), binding(s, x, b, _), rf_start(b, u), u > a.
rf_rebound(s, x, f) :- defn(s, x, f), !kind(s, "module"), rf_start(f, a), del_site(s, n, st), text(n, x), rf_start(st, u), u > a.
rf_names(i, q) :- rf_fn_seen(i, s, x, site), binding(s, x, site, "import"), rf_fn_follows(i, s, x, site), rf_import_target(site, q).
rf_fn_at(s, x, site, u) :- binding(s, x, site, _), !kind(s, "module"), rf_start(site, u).
rf_fn_at(s, x, st, u) :- del_site(s, n, st), !kind(s, "module"), text(n, x), rf_start(st, u).
rf_fn_read(i, s, x, r) :- rf_bind(i, x, s), !kind(s, "module"), rf_start(i, r).
rf_crossing(i, s) :- rf_fn_read(i, s, _, _), nearest(i, f, rf_fnl), f != s, within(f, s).
rf_fn_seen_at(i, u) :- rf_fn_read(i, s, x, r), !rf_crossing(i, s), u = max t : { rf_fn_at(s, x, _, t), t < r }.
rf_fn_seen_at(i, u) :- rf_fn_read(i, s, x, _), rf_crossing(i, s), u = max t : { rf_fn_at(s, x, _, t) }.
rf_fn_seen(i, s, x, site) :- rf_fn_read(i, s, x, _), rf_fn_seen_at(i, u), rf_fn_at(s, x, site, u).
rf_fn_n(s, x, k) :- rf_fn_at(s, x, _, _), k = count : { rf_fn_at(s, x, _, _) }.
rf_fn_follows(i, s, x, site) :- rf_fn_seen(i, s, x, site), rf_fn_n(s, x, 1).
rf_fn_follows(i, s, x, site) :- rf_fn_seen(i, s, x, site), rf_fn_n(s, x, k), k > 1, !rf_fcond(site), !rf_crossing(i, s), !rf_in_loop(i).
rf_fn_follows(i, s, x, site) :- rf_fn_seen(i, s, x, site), rf_fn_n(s, x, k), k > 1, !rf_fcond(site), rf_crossing(i, s).
rf_fn_follows(i, s, x, site) :- rf_fn_seen(i, s, x, site), rf_fn_n(s, x, k), k > 1, !rf_fcond(site), !rf_crossing(i, s), rf_fn_last(s, x, site).
rf_fn_last_at(s, x, u) :- rf_fn_n(s, x, k), k > 1, u = max t : { rf_fn_at(s, x, _, t) }.
rf_fn_last(s, x, site) :- rf_fn_last_at(s, x, u), rf_fn_at(s, x, site, u).
rf_fcond(site) :- rf_fn_at(_, _, site, _), nearest(site, a, rf_condstop), kind(a, k), rf_condk(k).
rf_in_loop(i) :- rf_fn_read(i, _, _, _), nearest(i, a, rf_loopstop), kind(a, "for_statement").
rf_in_loop(i) :- rf_fn_read(i, _, _, _), nearest(i, a, rf_loopstop), kind(a, "while_statement").
rf_dead_import(i) :- kind(i, "import_from_statement"), field(i, "module_name", r), kind(r, "relative_import"), docof(i, d), unpackaged(d).
rf_import_target(a, q) :- import_alias(i, a, m, y, _), kind(i, "import_from_statement"), !rf_dead_import(i), q = @dot(m, y).
rf_import_target(a, q) :- import_alias(i, a, _, "", l), kind(i, "import_statement"), kind(a, "dotted_name"), q = l.
rf_import_target(a, q) :- import_alias(i, a, m, "", _), kind(i, "import_statement"), kind(a, "aliased_import"), q = m.
rf_named(e, t) :- rf_expr(n, e, t), kind(e, "identifier"), kind(n, "call").
rf_named(e, t) :- rf_expr(e, e, t), kind(e, "identifier"), !rf_local(e, t), text(e, x), !rf_builtin(e, x).
rf_builtin(e, x) :- rf_expr(e, e, _), kind(e, "identifier"), text(e, x), builtin(x), !rf_after_310(x).
rf_resolved(e, q) :- rf_named(e, _), rf_names(e, q).
rf_has_resolved(e) :- rf_resolved(e, _).
rf_ref(t, "bare", m, x, q) :- rf_named(e, t), text(e, x), docof(e, d), rf_module(d, m), m != "", rf_resolved(e, q), !rf_owner_class(t, _, _).
rf_ref(t, "bare", m, x, "") :- rf_named(e, t), text(e, x), docof(e, d), rf_module(d, m), m != "", !rf_has_resolved(e), !rf_owner_class(t, _, _).
rf_ref(t, "unq", c, x, q) :- rf_named(e, t), text(e, x), rf_owner_class(t, _, c), rf_resolved(e, q).
rf_ref(t, "unq", c, x, "") :- rf_named(e, t), text(e, x), rf_owner_class(t, _, c), !rf_has_resolved(e).
rf_ref(t, "name", q, "", "") :- rf_named(e, t), docof(e, d), rf_module(d, ""), !rf_owner_class(t, _, _), rf_resolved(e, q).
rf_unq_bare(t, c, x, m) :- rf_named(e, t), text(e, x), rf_owner_class(t, _, c), docof(e, d), rf_module(d, m).
rf_attr(e, t, o, f) :- rf_expr(_, e, t), kind(e, "attribute"), field(e, "object", o), field(e, "attribute", fa), text(fa, f).
rf_selfish(o) :- kind(o, "identifier"), text(o, x), (x = "self" ; x = "cls").
rf_ref(t, "self", c, f, "") :- rf_attr(_, t, o, f), rf_selfish(o), rf_owner_class(t, _, c).
rf_ref(t, "field", c, x, f) :- rf_attr(_, t, o, f), kind(o, "attribute"), field(o, "object", s), rf_selfish(s), field(o, "attribute", xa), text(xa, x), rf_owner_class(t, _, c).
rf_ref(t, "super", c, f, "") :- rf_attr(_, t, o, f), kind(o, "call"), field(o, "function", s), kind(s, "identifier"), text(s, "super"), rf_owner_class(t, _, c).
rf_plain_attr(e, t, o, f) :- rf_attr(e, t, o, f), kind(o, "identifier"), !rf_selfish(o).
rf_param_site(o, p) :- rf_plain_attr(_, _, o, _), rf_bind(o, x, s), param(s, x, i), field(s, "parameters", ps), child(ps, p, i).
rf_ref(t, "type", m, ty, f) :- rf_plain_attr(_, t, o, f), rf_param_site(o, p), nearest(p, t, fdef), kind(p, k), (k = "typed_parameter" ; k = "typed_default_parameter"), field(p, "type", an), text(an, at), ty = @sql_trim(@rx_replace(at, "(?s)\\s*[\\[|].*$", "")), @sql_instr(ty, ".") = 0, docof(o, d), rf_module(d, m), m != "", !rf_param_splat(p).
rf_param_splat(p) :- child(p, c, _), kind(c, "list_splat_pattern").
rf_param_splat(p) :- child(p, c, _), kind(c, "dictionary_splat_pattern").
rf_param_splat(p) :- field(f, "parameters", ps), child(ps, p, i), child(ps, s, j), j > i, kind(s, "positional_separator").
rf_is_param_head(o) :- rf_param_site(o, _).
rf_ref(t, "name", q, "", "") :- rf_plain_attr(_, t, o, f), !rf_is_param_head(o), rf_names(o, qo), q = @concat(@concat(qo, "."), f).
rf_decl_def(d, x, f, s, 1) :- rf_qn(f, q), @sql_instr(q, ".<locals>.") = 0, rf_is_function(f), rf_def(f, x), docof(f, d), rf_start(f, s).
rf_decl_def(d, x, f, s, 0) :- rf_qn(f, q), @sql_instr(q, ".<locals>.") = 0, rf_is_class(f), rf_def(f, x), docof(f, d), rf_start(f, s).
rf_decl_fn(d, x, s) :- rf_decl_def(d, x, _, _, 1), s = min u : { rf_decl_def(d, x, _, u, 1) }.
rf_decl_cls(d, x, s) :- rf_decl_def(d, x, _, _, 0), !rf_decl_def(d, x, _, _, 1), s = min u : { rf_decl_def(d, x, _, u, 0) }.
rf_declared(m, x, q) :- rf_decl_fn(d, x, s), rf_decl_def(d, x, f, s, 1), rf_qn(f, q), rf_module(d, m), m != "".
rf_declared(m, x, q) :- rf_decl_cls(d, x, s), rf_decl_def(d, x, f, s, 0), rf_qn(f, q), rf_module(d, m), m != "".
rf_cls_at(d, x, s) :- rf_is_class(f), rf_def(f, x), docof(f, d), rf_start(f, s).
rf_class_named(m, x, q) :- rf_cls_at(d, x, _), s = min u : { rf_cls_at(d, x, u) }, rf_cls_at(d, x, s), rf_is_class(f), rf_def(f, x), docof(f, d), rf_start(f, s), rf_qn(f, q), rf_module(d, m), m != "".
rf_from_at(d, x, s, q) :- import_alias(i, a, m, y, x), kind(i, "import_from_statement"), !rf_dead_import(i), y != "", docof(a, d), rf_start(a, s), q = @dot(m, y).
rf_imported(m, x, q) :- rf_from_at(d, x, _, _), s = max u : { rf_from_at(d, x, u, _) }, rf_from_at(d, x, s, q), rf_doc_name(d, m), m != "".
rf_member_import(k, q) :- rf_mlast(m, x, site), rf_mbind(m, x, site, "import"), rf_import_target(site, q), rf_member_scope(m, md), k = @dot(md, x).
rf_field_decl(c, x, ty) :- kind(a, "assignment"), field(a, "type", an), field(a, "left", l), kind(l, "identifier"), text(l, x), child(st, a, 0), kind(st, "expression_statement"), child(b, st, _), kind(b, "block"), field(k, "body", b), kind(k, "class_definition"), rf_qn(k, c), text(an, at), ty = @sql_trim(@rx_replace(at, "(?s)\\s*[\\[|].*$", "")).
rf_base(c, i, short, m) :- kind(k, "class_definition"), field(k, "superclasses", al), child(al, e, i), !kind(e, "keyword_argument"), !kind(e, "list_splat"), !kind(e, "dictionary_splat"), !kind(e, "comment"), rf_qn(k, c), text(e, et), short = @sql_trim(@rx_replace(@rx_replace(et, "(?s)\\[.*$", ""), "^.*\\.", "")), docof(k, d), rf_module(d, m).
rf_named_def(q, f) :- rf_qn(f, q), !rf_shadowed(f).
rf_named_def(a, f) :- rf_qn(f, q), !rf_shadowed(f), docof(f, d), rf_spelled(d, q, a).
rf_path_module(d, a) :- rf_pydoc(d, p), rf_module(d, m), s = @rx_replace(@rx_replace(p, "[.]pyi?$", ""), "/__init__$", ""), a = @replace_all(@rx_extract(s, "(?:^|/)((?:[A-Za-z_][A-Za-z0-9_]*/)*[A-Za-z_][A-Za-z0-9_]*)$", 1), "/", "."), a != m.
rf_spelled(d, m, a) :- rf_path_module(d, a), rf_module(d, m), m != "".
rf_spelled(d, q, @concat(a, @substr(q, @strlen(m), @strlen(q)))) :- rf_path_module(d, a), rf_module(d, m), m != "", rf_qn(f, q), docof(f, d), @substr(q, 0, @add(@strlen(m), 1)) = @concat(m, ".").
rf_shadowed(f) :- rf_redefines(g, f).
rf_same_qn(f, g) :- rf_qn(f, q), rf_qn(g, q), node_order(g, rr_ord8), node_order(f, rr_ord9), rr_ord8 > rr_ord9, docof(f, d), docof(g, d).
rf_redefines(g, f) :- rf_same_qn(f, g), nearest(f, s, scope), nearest(g, s, scope), !rf_dcond(g).
rf_dcond(g) :- rf_def(g, _), nearest(g, a, rf_condstop), kind(a, k), rf_condk(k).
rf_class_name(q) :- rf_named_def(q, f), rf_is_class(f).
rf_nonclass_name(q) :- rf_named_def(q, f), rf_is_function(f).
rf_module_name(m) :- rf_module(_, m), m != "".
rf_module_name(a) :- rf_path_module(_, a).
rf_by_import(m, x, b) :- rf_imported(m, x, b), rf_class_name(b), !rf_nonclass_name(b).
rf_by_class(m, x, b) :- rf_class_named(m, x, b), rf_class_name(b), !rf_nonclass_name(b).
rf_global_class(x, b) :- rf_named_class(f, x), rf_qn(f, b), k = count : { rf_named_class(_, x) }, k = 1.
rf_named_class(f, x) :- rf_def(f, x), rf_is_class(f), rf_qn(f, _).
rf_base_spelled(c, i, b) :- rf_base(c, i, x, m), rf_by_import(m, x, b).
rf_base_spelled(c, i, b) :- rf_base(c, i, x, m), !rf_by_import(m, x, _), rf_by_class(m, x, b).
rf_base_spelled(c, i, b) :- rf_base(c, i, x, m), !rf_by_import(m, x, _), !rf_by_class(m, x, _), rf_global_class(x, b).
rf_base_class(c, i, q) :- rf_base_spelled(c, i, b), rf_named_def(b, f), rf_is_class(f), rf_qn(f, q).
rf_order(c, c, "") :- rf_class_name(c).
rf_order(c, b, r) :- rf_order(c, x, r0), rf_base_class(x, i, b), r = @concat(r0, @concat(@zero_pad(i, 6), ".")).
rf_method_at(c, f, r) :- rf_order(c, b, r), rf_member_fn(b, f).
rf_member_fn(b, f) :- rf_named_def(q, d), rf_is_function(d), q = @dot(b, f), !contains(".", f), rf_class_name(b).
rf_method_first(c, f, r) :- rf_method_at(c, f, r), !rf_method_later(c, f, r).
rf_method_later(c, f, r) :- rf_method_at(c, f, r), rf_method_at(c, f, s), @strlen(s) < @strlen(r).
rf_method_later(c, f, r) :- rf_method_at(c, f, r), rf_method_at(c, f, s), @strlen(s) = @strlen(r), s < r.
rf_method(c, f, d) :- rf_method_first(c, f, r), rf_order(c, b, r), rf_named_def(q, d), rf_is_function(d), q = @concat(@concat(b, "."), f).
rf_super_at(c, f, r) :- rf_method_at(c, f, r), r != "".
rf_super_first(c, f, r) :- rf_super_at(c, f, r), !rf_super_later(c, f, r).
rf_super_later(c, f, r) :- rf_super_at(c, f, r), rf_super_at(c, f, s), @strlen(s) < @strlen(r).
rf_super_later(c, f, r) :- rf_super_at(c, f, r), rf_super_at(c, f, s), @strlen(s) = @strlen(r), s < r.
rf_super_method(c, f, d) :- rf_super_first(c, f, r), rf_order(c, b, r), rf_named_def(q, d), rf_is_function(d), q = @concat(@concat(b, "."), f).
rf_want(q, 0) :- rf_ref(_, "name", q, _, _).
rf_want(q, 0) :- rf_ref(_, "bare", _, _, q), q != "".
rf_want(q, 0) :- rf_ref(_, "unq", _, _, q), q != "".
rf_want(q, 0) :- rf_sibling(_, q).
rf_want(t, @add(h, 1)) :- rf_link_via(q, t, h), h < 16.
rf_link(q, d) :- rf_want(q, _), rf_named_def(q, d).
rf_any_named(q) :- rf_named_def(q, _).
rf_via_import(q, t, h) :- rf_want(q, h), !rf_any_named(q), q = @dot(m, x), !contains(".", x), rf_imported(m, x, t).
rf_bare_imported(m, x) :- rf_imported(m, x, _).
rf_member_key(q) :- rf_member_import(q, _).
rf_via_member(q, t, h) :- rf_want(q, h), !rf_any_named(q), q = @dot(m, x), !contains(".", x), !rf_bare_imported(m, x), rf_member_import(q, t).
rf_walk(q, p, h) :- rf_want(q, h), !rf_any_named(q), q = @dot(m, x), !contains(".", x), !rf_bare_imported(m, x), !rf_member_key(q), !rf_opaque(q), q = @dot(p, rr_part19), !contains(".", rr_part19).
rf_walk(q, p2, h) :- rf_walk(q, p, h), !rf_binder(p), p = @dot(p2, rr_part20), !contains(".", rr_part20).
rf_hit(q, p, r, h) :- rf_walk(q, p, h), rf_binder(p), r = @substr(q, @add(@strlen(p), 1), @sub(@sub(@strlen(q), @strlen(p)), 1)).
rf_alias_target(p, t) :- rf_member_import(p, t), t != p, !rf_module_alias(t).
rf_module_alias(t) :- rf_member_import(_, t), rf_module_name(t), !rf_any_named(t).
rf_aliased(p) :- rf_alias_target(p, _).
rf_aliased(p) :- rf_field_key(p).
rf_binder(p) :- rf_aliased(p).
rf_binder(p) :- rf_any_named(p).
rf_binder(p) :- rf_opaque(p).
rf_binder(p) :- rf_module_name(p).
rf_field_key(k) :- rf_field_decl(c, x, _), k = @concat(@concat(c, "."), x).
rf_renamed(q, @dot(t, r), h) :- rf_hit(q, p, r, h), rf_alias_target(p, t).
rf_only_classes(c) :- rf_class_name(c), !rf_nonclass_name(c).
rf_link(q, d) :- rf_hit(q, c, f, _), !rf_aliased(c), rf_only_classes(c), @sql_instr(f, ".") = 0, rf_class_own(c, k), rf_method(k, f, d).
rf_class_own(c, k) :- rf_named_def(c, f), rf_is_class(f), rf_qn(f, k).
rf_class_field(q, k, x, f) :- rf_hit(q, c, r, _), !rf_aliased(c), rf_only_classes(c), r = @dot(x, f), !contains(".", f), @sql_instr(x, ".") = 0, rf_class_own(c, k).
rf_link(q, d) :- rf_class_field(q, c, x, f), rf_field_type(c, x, ty, m), rf_type_class(m, ty, k), rf_method(k, f, d).
rf_link_via(q, t, h) :- rf_via_import(q, t, h).
rf_link_via(q, t, h) :- rf_via_member(q, t, h).
rf_link_via(q, t, h) :- rf_renamed(q, t, h).
rf_link(q, d) :- rf_link_via(q, t, _), rf_link(t, d).
rf_target(t, d, "name") :- rf_ref(t, "name", q, _, _), rf_link(q, d).
rf_target(t, d, "sibling") :- rf_sibling(t, q), rf_link(q, d).
rf_bare_declared(m, x) :- rf_declared(m, x, _).
rf_want(q, 1) :- rf_declared(m, x, q), rf_ref(_, "bare", m, x, _).
rf_want(q, 1) :- rf_imported(m, x, q), rf_ref(_, "bare", m, x, _), !rf_bare_declared(m, x).
rf_target(t, d, "bare") :- rf_ref(t, "bare", m, x, _), rf_declared(m, x, q), rf_link(q, d).
rf_target(t, d, "bare") :- rf_ref(t, "bare", m, x, _), !rf_bare_declared(m, x), rf_imported(m, x, q), rf_link(q, d).
rf_target(t, d, "bare") :- rf_ref(t, "bare", m, x, q), q != "", !rf_bare_declared(m, x), !rf_bare_imported(m, x), rf_link(q, d).
rf_own_fn(c, x) :- rf_ref(_, "unq", c, x, _), rf_named_def(q, d), rf_is_function(d), q = @concat(@concat(c, "."), x).
rf_target(t, d, "unqualified") :- rf_ref(t, "unq", c, x, _), rf_own_fn(c, x), rf_named_def(q, d), q = @concat(@concat(c, "."), x).
rf_target(t, d, "unqualified") :- rf_ref(t, "unq", c, x, _), !rf_own_fn(c, x), rf_unq_bare(t, c, x, m), rf_declared(m, x, q), rf_link(q, d).
rf_target(t, d, "unqualified") :- rf_ref(t, "unq", c, x, _), !rf_own_fn(c, x), rf_unq_bare(t, c, x, m), !rf_bare_declared(m, x), rf_imported(m, x, q), rf_link(q, d).
rf_target(t, d, "unqualified") :- rf_ref(t, "unq", c, x, q), q != "", !rf_own_fn(c, x), rf_unq_bare(t, c, x, m), !rf_bare_declared(m, x), !rf_bare_imported(m, x), rf_link(q, d).
rf_want(q, 1) :- rf_ref(t, "unq", c, x, _), rf_unq_bare(t, c, x, m), rf_declared(m, x, q).
rf_want(q, 1) :- rf_ref(t, "unq", c, x, _), rf_unq_bare(t, c, x, m), rf_imported(m, x, q).
rf_target(t, d, "self") :- rf_ref(t, "self", c, f, _), rf_method(c, f, d).
rf_has_method(c, f) :- rf_method(c, f, _).
rf_compose_at(c, f, key, b) :- rf_ref(_, "self", c, f, _), !rf_has_method(c, f), rf_base_class(k, _, c), rf_base_class(k, i, b), b != c, rf_has_method(b, f), key = @concat(@concat(k, "\t"), @zero_pad(i, 6)).
rf_compose(c, f, key) :- rf_compose_at(c, f, key, _), !rf_compose_later(c, f, key).
rf_compose_later(c, f, key) :- rf_compose_at(c, f, key, _), rf_compose_at(c, f, s, _), s < key.
rf_target(t, d, "self") :- rf_ref(t, "self", c, f, _), rf_compose(c, f, key), rf_compose_at(c, f, key, b), rf_method(b, f, d).
rf_target(t, d, "super") :- rf_ref(t, "super", c, f, _), rf_super_method(c, f, d).
rf_field_cand(c, x, @concat(r, "c"), ty) :- rf_order(c, b, r), rf_field_decl(b, x, ty).
rf_field_cand(c, x, @concat(r, "a"), ty) :- rf_field_want(c, x), references_field(_, _), rf_order(c, b, r), rf_init_param(b, x, ty), ty != "<unannotated>".
rf_field_cand(c, x, @concat(r, "b"), ty) :- rf_field_want(c, x), references_field(re, by_), x1 = @rx_replace(x, re, by_), x1 != x, rf_order(c, b, r), !rf_init_named(b, x), rf_init_param(b, x1, ty), ty != "<unannotated>".
rf_field_want(c, x) :- rf_ref(_, "field", c, x, _).
rf_field_want(c, x) :- rf_class_field(_, c, x, _).
rf_field_first(c, x, k) :- rf_field_cand(c, x, k, _), !rf_field_later(c, x, k).
rf_field_later(c, x, k) :- rf_field_cand(c, x, k, _), rf_field_cand(c, x, s, _), @strlen(s) < @strlen(k).
rf_field_later(c, x, k) :- rf_field_cand(c, x, k, _), rf_field_cand(c, x, s, _), @strlen(s) = @strlen(k), s < k.
rf_field_type(c, x, ty, m) :- rf_field_first(c, x, k), rf_field_cand(c, x, k, ty), m = @rx_replace(c, "\\.?[^.]*$", ""), @sql_instr(ty, ".") = 0.
rf_init_param(c, x, ty) :- rf_init(f, c), rf_init_arg(f, p, x, ty), !rf_positional_only(f, p), !rf_receiver_name(f, p, x).
rf_init_named(c, x) :- rf_init_param(c, x, _).
rf_init(f, c) :- rf_init_def(f, c), !rf_init_later(f).
rf_init_def(f, c) :- references_field(_, _), rf_def(f, "__init__"), rf_is_function(f), nearest(f, k, rf_dc), kind(k, "class_definition"), rf_qn(k, c).
rf_init_later(f) :- rf_init_def(f, c), rf_init_def(g, c), docof(f, d), docof(g, d), node_order(g, rr_ord10), node_order(f, rr_ord11), rr_ord10 > rr_ord11.
rf_init_arg(f, p, x, "<unannotated>") :- rf_init(f, _), param_list(f, ps), child(ps, p, _), kind(p, "identifier"), text(p, x).
rf_init_arg(f, p, x, "<unannotated>") :- rf_init(f, _), param_list(f, ps), child(ps, p, _), kind(p, "default_parameter"), field(p, "name", n), kind(n, "identifier"), text(n, x).
rf_init_arg(f, p, x, ty) :- rf_init(f, _), param_list(f, ps), child(ps, p, _), kind(p, "typed_parameter"), child(p, n, 0), kind(n, "identifier"), text(n, x), field(p, "type", a), text(a, at), ty = @sql_trim(@rx_replace(at, "(?s)\\s*[\\[|].*$", "")).
rf_init_arg(f, p, x, ty) :- rf_init(f, _), param_list(f, ps), child(ps, p, _), kind(p, "typed_default_parameter"), field(p, "name", n), kind(n, "identifier"), text(n, x), field(p, "type", a), text(a, at), ty = @sql_trim(@rx_replace(at, "(?s)\\s*[\\[|].*$", "")).
rf_positional_only(f, p) :- rf_init_arg(f, p, _, _), field(f, "parameters", ps), child(ps, sep_, _), kind(sep_, "positional_separator"), node_order(sep_, rr_ord12), node_order(p, rr_ord13), rr_ord12 > rr_ord13.
rf_receiver_name(f, p, x) :- rf_init_arg(f, p, x, _), rf_receiver_word(x), !rf_keyword_only(f, p).
rf_keyword_only(f, p) :- rf_init_arg(f, p, _, _), field(f, "parameters", ps), child(ps, sep_, _), node_order(sep_, rr_ord14), node_order(p, rr_ord15), rr_ord14 < rr_ord15, rf_star_kind(k), kind(sep_, k).
rf_keyword_only(f, p) :- rf_init_arg(f, p, _, _), field(f, "parameters", ps), child(ps, sep_, _), node_order(sep_, rr_ord16), node_order(p, rr_ord17), rr_ord16 < rr_ord17, kind(sep_, "typed_parameter"), child(sep_, sp, 0), rf_star_kind(k), kind(sp, k).
rf_sibling(f, q) :- rf_sib_match(f, i, owner, nm), !rf_sib_earlier(f, i), references_sibling(i, _, _, re, by_), n2 = @rx_replace(nm, re, by_), n2 != "", q = @concat(@concat(owner, "."), n2).
rf_sib_match(f, i, owner, nm) :- references_sibling(i, dre, nre, _, _), rf_dec_name(f, dx), @rx(dx, dre) = 1, rf_qn(f, qf), qf = @dot(owner, nm), !contains(".", nm), @rx(nm, nre) = 1.
rf_sib_earlier(f, i) :- rf_sib_match(f, i, _, _), rf_sib_match(f, j, _, _), j < i.
rf_dec_name(f, x) :- references_given(1), rf_is_function(f), nearest(f, k, rf_dc), kind(k, "class_definition"), child(dd, f, _), kind(dd, "decorated_definition"), child(dd, dec, _), kind(dec, "decorator"), rf_dec_code(dec, e), rf_unparen(e, u), rf_dec_callee(u, c), rf_dec_last(c, x).
rf_dec_code(dec, e) :- rf_dec_child(dec, e, i), i = min j : { rf_dec_child(dec, _, j) }.
rf_dec_child(dec, e, j) :- kind(dec, "decorator"), child(dec, e, j), !kind(e, "comment").
rf_unparen(e, e) :- rf_dec_code(_, e), !kind(e, "parenthesized_expression").
rf_unparen(e, u) :- rf_dec_code(_, e), kind(e, "parenthesized_expression"), rf_unparen_in(e, u).
rf_unparen(e, u) :- rf_dec_fn(_, e), !kind(e, "parenthesized_expression"), u = e.
rf_unparen(e, u) :- rf_dec_fn(_, e), kind(e, "parenthesized_expression"), rf_unparen_in(e, u).
rf_unparen_in(e, u) :- kind(e, "parenthesized_expression"), child(e, i, 0), !kind(i, "parenthesized_expression"), u = i.
rf_unparen_in(e, u) :- kind(e, "parenthesized_expression"), child(e, i, 0), kind(i, "parenthesized_expression"), rf_unparen_in(i, u).
rf_dec_fn(c, fn) :- rf_unparen(e, c), rf_dec_code(_, e), kind(c, "call"), field(c, "function", fn).
rf_dec_callee(u, u) :- rf_unparen(e, u), rf_dec_code(_, e), !kind(u, "call").
rf_dec_callee(u, c) :- rf_dec_fn(u, fn), rf_unparen(fn, c).
rf_dec_last(c, x) :- kind(c, "identifier"), text(c, x), rf_dec_callee(_, c).
rf_dec_last(c, x) :- kind(c, "attribute"), field(c, "attribute", a), kind(a, "identifier"), text(a, x), rf_dec_callee(_, c).
rf_target(t, d, "field") :- rf_ref(t, "field", c, x, f), rf_field_type(c, x, ty, m), rf_type_class(m, ty, k), rf_method(k, f, d).
rf_target(t, d, "param_type") :- rf_ref(t, "type", m, ty, f), rf_type_class(m, ty, k), rf_method(k, f, d).
rf_type_want(m, ty) :- rf_ref(_, "type", m, ty, _).
rf_type_want(m, ty) :- rf_field_type(_, _, ty, m).
rf_type_by_import(m, ty, k) :- rf_type_want(m, ty), rf_imported(m, ty, q), rf_fq_class(q, k).
rf_has_type_import(m, ty) :- rf_type_by_import(m, ty, _).
rf_type_class(m, ty, k) :- rf_type_by_import(m, ty, k).
rf_type_class(m, ty, k) :- rf_type_want(m, ty), !rf_has_type_import(m, ty), rf_class_named(m, ty, q), rf_fq_class(q, k).
rf_fq_want(q) :- rf_type_want(m, ty), rf_imported(m, ty, q).
rf_fq_want(q) :- rf_type_want(m, ty), rf_class_named(m, ty, q).
rf_fq_want(t) :- rf_fq_want(q), !rf_any_named(q), q = @dot(m, x), !contains(".", x), rf_imported(m, x, t).
rf_fq_class(q, k) :- rf_fq_want(q), rf_only_classes(q), rf_named_def(q, f), rf_is_class(f), rf_qn(f, k).
rf_fq_class(q, k) :- rf_fq_want(q), !rf_any_named(q), q = @dot(m, x), !contains(".", x), rf_imported(m, x, t), rf_fq_class(t, k).
rf_edge(t, d, v) :- rf_target(t, d, v), rf_in_graph(t).
rf_in_graph(t) :- rf_def(t, _), docof(t, d), rf_pydoc(d, _).
reference_edge(t, d, v) :- rf_edge(t, d, v).
rf_head_open(h) :- rf_value_last(_, h), !kind(h, "identifier"), kind(h, k), !rf_literal(k).
rf_head_open(h) :- rf_value_last(_, h), kind(h, "identifier"), text(h, x), !rf_bound_at(h), !builtin(x).
rf_bound_at(h) :- look(h, _, _).
rf_head_open(h) :- rf_seen_bind(h, _, "param").
rf_head_open(h) :- rf_seen_bind(h, b, "assign"), asg(_, _, r, b), rf_value_last(r, g), rf_head_open(g).
rf_head_open(h) :- rf_seen_bind(h, _, f), f != "def", f != "class", f != "import", f != "assign", f != "param", f != "del".
rr_agg21(s, t, x) :- rr_demand_agg_rr_agg21(s, x), binding(s, x, b, _), rf_start(b, t).
rf_seen_at(h, u) :- rf_value_last(_, h), kind(h, "identifier"), look(h, x, s), rf_start(h, r), u = max t : { rr_agg21(s, t, x), t < r }.
rf_seen_bind(h, b, form) :- rf_seen_at(h, u), look(h, x, s), binding(s, x, b, form), rf_start(b, u).
rf_value_head(r, r) :- asg(_, _, r, _).
rf_value_head(r, h) :- rf_value_head(r, a), kind(a, "attribute"), field(a, "object", h).
rf_value_head(r, h) :- rf_value_head(r, a), kind(a, "parenthesized_expression"), child(a, h, _), !kind(h, "("), !kind(h, ")").
rf_value_last(r, h) :- rf_value_head(r, h), !kind(h, "attribute"), !kind(h, "parenthesized_expression").
rf_opaque_site(m, x, site) :- rf_mlive(m, x, site, form), form != "def", form != "class", form != "import", form != "assign", form != "param".
rf_opaque_site(m, x, a) :- rf_mlive(m, x, a, "assign"), asg(m, x, r, a), rf_value_last(r, h), rf_head_open(h).
rf_opaque_site(m, x, a) :- rf_mlive(m, x, a, "import"), import_alias(i, a, _, _, _), rf_dead_import(i).
rf_opaque(q) :- rf_opaque_site(m, x, _), rf_member_scope(m, md), q = @dot(md, x).
unreachable_doc(d, p, m) :- doc(d, p, _), in_scope(d), !out_scope(d), !tape_syntax_error(d), m = @rx_replace(@rx_replace(p, "/__init__\\.py$|\\.py$", ""), "/", ".").
unreachable_fn(f, d, x) :- node(d, f, "function_definition", _, _), unreachable_doc(d, _, _), !inside(f, _, unreachable_fdef), field(f, "name", n), text(n, x).
unreachable_fn_class(f, c, cx) :- unreachable_fn(f, _, _), nearest(f, c, unreachable_cdef), field(c, "name", n), text(n, cx).
unreachable_cls(c, d, x) :- node(d, c, "class_definition", _, _), unreachable_doc(d, _, _), field(c, "name", n), text(n, x).
unreachable_deco(o, x) :- unreachable_deco_at(o, d, l, c), src_line(d, l, sp), match_group("@\\s*(?P<n>[^\\s(]+)", sp, m, "n", g), col(m, c), text(g, x).
unreachable_deco_at(o, d, l, c) :- node(d, dd, "decorated_definition", _, _), field(dd, "definition", o), child(dd, dc, _), node(_, dc, "decorator", _, _), line(dc, l), col(dc, c).
unreachable_inv(id, f, d, x, "function", m, fq) :- unreachable_fn(f, d, x), !unreachable_fn_class(f, _, _), unreachable_doc(d, _, m), id = @concat(m, @concat("::", x)), fq = @concat(m, @concat(".", x)).
unreachable_inv(id, f, d, x, "method", m, fq) :- unreachable_fn(f, d, x), unreachable_fn_class(f, _, cx), unreachable_doc(d, _, m), id = @concat(m, @concat("::", @concat(cx, @concat(".", x)))), fq = @concat(m, @concat(".", @concat(cx, @concat(".", x)))).
unreachable_inv(id, c, d, x, "class", m, fq) :- unreachable_cls(c, d, x), unreachable_doc(d, _, m), id = @concat(m, @concat("::", x)), fq = @concat(m, @concat(".", x)).
unreachable_inv_start(id, s) :- unreachable_inv(id, x, _, _, _, _, _), node(_, x, _, s, _).
unreachable_last(id, s) :- unreachable_inv_start(id, _), s = max t : { unreachable_inv_start(id, t) }.
unreachable_decl(id, x, d, n, k, m, fq) :- unreachable_inv(id, x, d, n, k, m, fq), node(_, x, _, s, _), unreachable_last(id, s).
unreachable_decl_class(id, cx) :- unreachable_decl(id, x, _, _, "method", _, _), unreachable_fn_class(x, _, cx).
unreachable_decl_node(x, id) :- unreachable_decl(id, x, _, _, _, _, _).
unreachable_fq(fq, id) :- unreachable_decl(id, _, _, _, _, _, fq).
unreachable_method(m, cx, n, id) :- unreachable_decl(id, _, _, n, "method", m, _), unreachable_decl_class(id, cx).
unreachable_param(p, f, p) :- unreachable_fn(f, _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "identifier", _, _).
unreachable_param(p, f, n) :- unreachable_fn(f, _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_parameter", _, _), child(p, n, _), node(_, n, "identifier", _, _).
unreachable_param(p, f, n) :- unreachable_fn(f, _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "default_parameter", _, _), field(p, "name", n).
unreachable_param(p, f, n) :- unreachable_fn(f, _, _), field(f, "parameters", ps), child(ps, p, _), node(_, p, "typed_default_parameter", _, _), field(p, "name", n).
unreachable_param_ok(p, f, x) :- unreachable_param(p, f, n), text(n, x), !unreachable_positional(p).
unreachable_positional(p) :- unreachable_param(p, _, _), child(ps, p, i), child(ps, s, j), node(_, s, "positional_separator", _, _), j > i.
unreachable_parameter(p, id) :- unreachable_param_ok(p, f, _), unreachable_decl(id, f, _, _, "function", _, _).
unreachable_parameter(p, id) :- unreachable_param_ok(p, f, x), unreachable_decl(id, f, _, _, "method", _, _), x != "self", x != "cls".
unreachable_ann(id, x) :- unreachable_decl(id, f, _, _, k, _, _), k != "class", field(f, "return_type", t), node(_, i, "identifier", _, _), inside(i, t, unreachable_ann_k), text(i, x).
unreachable_ann(id, x) :- unreachable_decl(id, f, _, _, k, _, _), k != "class", field(f, "return_type", t), node(_, t, "identifier", _, _), text(t, x).
unreachable_ann(id, x) :- unreachable_parameter(p, id), field(p, "type", t), node(_, i, "identifier", _, _), inside(i, t, unreachable_ann_k), text(i, x).
unreachable_ann(id, x) :- unreachable_parameter(p, id), field(p, "type", t), node(_, t, "identifier", _, _), text(t, x).
unreachable_item(i, d, o, x) :- unreachable_import_stmt(i, d), field(i, "name", x), node(_, x, "dotted_name", _, _), name(x, o).
unreachable_item(i, d, o, x) :- unreachable_import_stmt(i, d), field(i, "name", x), node(_, x, "aliased_import", _, _), field(x, "name", dn), name(dn, o).
unreachable_import_stmt(i, d) :- node(d, i, "import_statement", _, _), unreachable_doc(d, _, _).
unreachable_import_stmt(i, d) :- node(d, i, "import_from_statement", _, _), unreachable_doc(d, _, _).
unreachable_alias(x, a) :- unreachable_item(_, _, _, x), node(_, x, "aliased_import", _, _), field(x, "alias", n), text(n, a).
unreachable_abs_base(i, b) :- node(_, i, "import_from_statement", _, _), field(i, "module_name", m), node(_, m, "dotted_name", _, _), name(m, b).
unreachable_rel_base(i, k, rest) :- unreachable_dots(i, dots), k = @strlen(dots), field(i, "module_name", r), unreachable_rel_rest(r, rest).
unreachable_dots(i, dots) :- node(_, i, "import_from_statement", _, _), field(i, "module_name", r), node(_, r, "relative_import", _, _), child(r, ip, _), node(_, ip, "import_prefix", _, _), node_text(ip, dots).
unreachable_rel_rest(r, rest) :- node(_, r, "relative_import", _, _), child(r, m, _), node(_, m, "dotted_name", _, _), name(m, rest).
unreachable_rel_rest(r, "") :- node(_, r, "relative_import", _, _), !unreachable_rel_dotted(r).
unreachable_rel_dotted(r) :- node(_, r, "relative_import", _, _), child(r, m, _), node(_, m, "dotted_name", _, _).
unreachable_init(p) :- unreachable_doc(_, p, _), match("(?s).*/..[iI][nN][iI][tT]..\\.[pP][yY]", p).
unreachable_pkg0(i, m) :- unreachable_rel_base(i, _, _), node(d, i, _, _, _), unreachable_doc(d, p, m), unreachable_init(p).
unreachable_pkg0(i, q) :- unreachable_rel_base(i, _, _), node(d, i, _, _, _), unreachable_doc(d, p, m), !unreachable_init(p), q = @rx_replace(m, "\\.?[^.]+$", "").
unreachable_up(i, left, p) :- unreachable_pkg0(i, p), unreachable_dots(i, dots), left = @substr(dots, 1, @sub(@strlen(dots), 1)).
unreachable_up(i, left2, q) :- unreachable_up(i, left, p), left != "", left2 = @substr(left, 1, @sub(@strlen(left), 1)), q = @substr(p, 0, @strlen(@rx_replace(p, "\\.?[^.]+$", ""))).
unreachable_prefix(i, p) :- unreachable_up(i, "", p).
unreachable_imp_c(i, d, m, a, o, "module") :- node(_, i, "import_statement", _, _), unreachable_item(i, d, o, x), unreachable_doc(d, _, m), unreachable_alias(x, a).
unreachable_imp_c(i, d, m, n, o, "module") :- node(_, i, "import_statement", _, _), unreachable_item(i, d, o, x), unreachable_doc(d, _, m), !unreachable_alias(x, _), unreachable_first(o, n).
unreachable_imp_c(i, d, m, n, t, "symbol") :- unreachable_abs_base(i, b), unreachable_item(i, d, o, x), unreachable_doc(d, _, m), t = @concat(b, @concat(".", o)), unreachable_item_name(x, o, n).
unreachable_imp_c(i, d, m, n, t, "symbol") :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, d, o, x), unreachable_doc(d, _, m), unreachable_join(p, rest, o, t), unreachable_item_name(x, o, n).
unreachable_item_name(x, o, a) :- unreachable_item(_, _, o, x), unreachable_alias(x, a).
unreachable_item_name(x, o, o) :- unreachable_item(_, _, o, x), !unreachable_alias(x, _).
unreachable_join(p, rest, o, t) :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, _, o, _), p != "", rest != "", t = @concat(p, @concat(".", @concat(rest, @concat(".", o)))).
unreachable_join(p, rest, o, t) :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, _, o, _), p = "", rest != "", t = @concat(rest, @concat(".", o)).
unreachable_join(p, rest, o, t) :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, _, o, _), p != "", rest = "", t = @concat(p, @concat(".", o)).
unreachable_join(p, rest, o, o) :- unreachable_rel_base(i, _, rest), unreachable_prefix(i, p), unreachable_item(i, _, o, _), p = "", rest = "".
unreachable_first(o, o) :- unreachable_item(_, _, o, _), !contains(".", o).
unreachable_first(o, n) :- unreachable_item(_, _, o, _), o = @dot(n, r), !contains(".", r), !contains(".", n).
unreachable_imp_s(m, n, k, s) :- unreachable_imp_c(i, _, m, n, _, k), node(_, i, _, s, _).
unreachable_imp_last(m, n, k, s) :- unreachable_imp_s(m, n, k, _), s = max t : { unreachable_imp_s(m, n, k, t) }.
unreachable_import(i, d, m, n, t, k) :- unreachable_imp_c(i, d, m, n, t, k), node(_, i, _, s, _), unreachable_imp_last(m, n, k, s).
unreachable_imported_fq(t) :- unreachable_import(_, _, _, _, t, "symbol").
unreachable_resolved(fq, id) :- unreachable_fq(fq, id).
unreachable_resolved(fq, id) :- unreachable_resolved(t, id), unreachable_import(_, _, m, n, t, "symbol"), fq = @concat(m, @concat(".", n)), !unreachable_fq(fq, _).
unreachable_raw_base(c, b) :- unreachable_cls(c, _, _), field(c, "superclasses", al), child(al, b, _), node(_, b, k, _, _), unreachable_base_k(k).
unreachable_base_text(c, s) :- unreachable_raw_base(c, b), node_text(b, s).
unreachable_base_name_of(b, x) :- unreachable_raw_base(_, b), node_text(b, s), x = @rx_replace(@rx_replace(@rx_replace(s, "(?s)\\[.*$", ""), "^.*\\.", ""), "^ +| +$", "").
unreachable_bname(id, m, bn, s) :- unreachable_raw_base(c, b), unreachable_decl(id, c, _, _, "class", m, _), unreachable_base_name_of(b, bn), node(_, b, _, s, _).
unreachable_class_named(n, id) :- unreachable_decl(id, _, _, n, "class", _, _).
unreachable_unique_class(n, id) :- unreachable_class_named(n, id), k = count : { unreachable_class_named(n, _) }, k = 1.
unreachable_has_bi(id, bn) :- unreachable_bname(id, m, bn, _), unreachable_import(_, _, m, bn, t, "symbol"), unreachable_decl(_, _, _, _, "class", _, t).
unreachable_has_bm(id, bn) :- unreachable_bname(id, m, bn, _), unreachable_decl(_, _, _, bn, "class", m, _).
unreachable_base_edge(id, b, s) :- unreachable_bname(id, m, bn, s), unreachable_import(_, _, m, bn, t, "symbol"), unreachable_decl(b, _, _, _, "class", _, t).
unreachable_base_edge(id, b, s) :- unreachable_bname(id, m, bn, s), !unreachable_has_bi(id, bn), unreachable_decl(b, _, _, bn, "class", m, _).
unreachable_base_edge(id, b, s) :- unreachable_bname(id, _, bn, s), !unreachable_has_bi(id, bn), !unreachable_has_bm(id, bn), unreachable_unique_class(bn, b).
unreachable_reach(id, id) :- unreachable_decl(id, _, _, _, "class", _, _).
unreachable_reach(o, b) :- unreachable_reach(o, x), unreachable_base_edge(x, b, _).
rr_ctx23(o, x) :- unreachable_reach(o, b), unreachable_decl_node(x, b).
rr_agg22(c, o, x, y) :- rr_demand_agg_rr_agg22(o, x), rr_ctx23(o, x), unreachable_reach(o, c), unreachable_decl_node(y, c), node_order(y, rr_ord18), node_order(x, rr_ord19), rr_ord18 <= rr_ord19.
unreachable_hops(o, k) :- unreachable_reach(o, b), unreachable_decl_node(x, b), k = count : { rr_agg22(_, o, x, _) }.
unreachable_hier_l(id, id, 0) :- unreachable_decl(id, _, _, _, "class", _, _).
unreachable_hier_l(o, b, j) :- unreachable_hier_l(o, x, i), unreachable_base_edge(x, b, _), unreachable_hops(o, j), j = @add(i, 1).
unreachable_hier_d(o, b, k) :- unreachable_hier_l(o, b, _), k = min j : { unreachable_hier_l(o, b, j) }.
unreachable_property(x) :- unreachable_deco(x, n), (suffix("property", n) ; suffix(".setter", n) ; suffix(".deleter", n)).
unreachable_pub(c, n, id) :- unreachable_decl(c, _, _, cn, _, cm, _), unreachable_decl(id, x, _, n, "method", cm, _), unreachable_decl_class(id, cn), !prefix("_", n), !unreachable_excluded(n), !unreachable_property(x).
rr_agg24(j, n, o) :- rr_demand_agg_rr_agg24(n, o), unreachable_hier_d(o, c2, j), unreachable_pub(c2, n, _).
unreachable_pdist(o, n, k) :- unreachable_hier_d(o, c, _), unreachable_pub(c, n, _), k = min j : { rr_agg24(j, n, o) }.
unreachable_next_c(x, n, k, y, ord) :- unreachable_pdist(x, n, k), k > 0, unreachable_base_edge(x, y, ord), rr_t25 = @sub(k, 1), unreachable_pdist(y, n, rr_t25).
unreachable_next_min(x, n, k, m) :- unreachable_next_c(x, n, k, _, _), m = min q : { unreachable_next_c(x, n, k, _, q) }.
unreachable_next(x, n, k, y) :- unreachable_next_min(x, n, k, m), unreachable_next_c(x, n, k, y, m).
unreachable_walk(o, n, o) :- unreachable_pdist(o, n, _).
unreachable_walk(o, n, y) :- unreachable_walk(o, n, x), unreachable_pdist(x, n, k), unreachable_next(x, n, k, y).
unreachable_public(o, n, id) :- unreachable_walk(o, n, c), unreachable_pdist(c, n, 0), unreachable_pub(c, n, id).
unreachable_all(a, d) :- node(d, a, "assignment", _, _), unreachable_doc(d, p, _), match("data_layer/[^/]+\\.py", p), field(a, "left", l), node(_, l, "identifier", _, _), text(l, "__all__"), child(e, a, _), node(_, e, "expression_statement", _, _), !inside(a, _, unreachable_nest_k).
unreachable_all_start(d, s) :- unreachable_all(a, d), node(_, a, _, s, _).
unreachable_first_all(d, a) :- unreachable_all(a, d), node(_, a, _, s, _), s = min t : { unreachable_all_start(d, t) }.
unreachable_all_array(a, r) :- unreachable_all(a, _), field(a, "right", r), node(_, r, "list", _, _).
unreachable_all_array(a, r) :- unreachable_all(a, _), field(a, "right", r), node(_, r, "tuple", _, _).
unreachable_all_name(a, n) :- unreachable_all_array(a, r), child(r, v, _), node(_, v, "string", _, _), value(v, n).
unreachable_all_name(a, n) :- unreachable_all_array(a, r), child(r, v, _), node(_, v, "concatenated_string", _, _), value(v, n).
unreachable_export(d, n, t) :- unreachable_import(i, d, _, n, t, "symbol"), child(mo, i, _), node(_, mo, "module", _, _), unreachable_doc(d, p, _), match("data_layer/[^/]+\\.py", p).
unreachable_export(d, n, fq) :- unreachable_decl(_, _, d, n, k, _, fq), k != "method", unreachable_doc(d, p, _), match("data_layer/[^/]+\\.py", p).
unreachable_has_all(d) :- unreachable_first_all(d, _).
unreachable_exported(id) :- unreachable_export(d, n, t), unreachable_resolved(t, id), !prefix("_", n), !unreachable_has_all(d).
unreachable_exported(id) :- unreachable_export(d, n, t), unreachable_resolved(t, id), !prefix("_", n), unreachable_first_all(d, a), unreachable_all_name(a, n).
unreachable_base_name(id, b) :- unreachable_decl(id, _, _, n, _, _, _), suffix("_async", n), b = @substr(n, 0, @sub(@strlen(n), 6)).
unreachable_base_name(id, b) :- unreachable_decl(id, _, _, n, _, _, _), suffix("_lazy", n), b = @substr(n, 0, @sub(@strlen(n), 5)).
unreachable_base_name(id, n) :- unreachable_decl(id, _, _, n, _, _, _), !suffix("_async", n), !suffix("_lazy", n).
unreachable_class_id(id, cid) :- unreachable_decl_class(id, cx), unreachable_decl(id, _, _, _, _, m, _), cid = @concat(m, @concat("::", cx)).
unreachable_abstract(id) :- unreachable_decl(id, x, _, _, "class", _, _), unreachable_base_text(x, s), contains("ABC", s).
unreachable_abstract(id) :- unreachable_decl(id, x, _, _, k, _, _), k != "class", unreachable_deco(x, n), suffix("abstractmethod", n).
unreachable_is_property(id) :- unreachable_decl(id, x, _, _, _, _, _), unreachable_property(x).
unreachable_implicit(id) :- unreachable_decl(id, _, _, n, _, _, _), match("__.*__", n).
unreachable_implicit(id) :- unreachable_decl(id, _, _, n, _, _, _), (n = "main" ; n = "pytest_configure" ; n = "pytest_collection_modifyitems").
unreachable_implicit(id) :- unreachable_decl(id, x, _, _, _, _, _), unreachable_deco(x, n), (suffix("validator", n) ; suffix("overload", n)).
unreachable_structural(id) :- unreachable_decl(id, x, _, _, _, _, _), unreachable_base_text(x, s), contains("Protocol", s).
unreachable_protocol(id) :- unreachable_structural(id).
unreachable_protocol(id) :- unreachable_decl(id, _, _, n, _, _, _), suffix("Protocol", n).
unreachable_annotated(m, n) :- unreachable_ann(id, n), unreachable_decl(id, _, _, _, _, m, _).
unreachable_cn_import(m, n, c) :- unreachable_annotated(m, n), unreachable_import(_, _, m, n, t, "symbol"), unreachable_resolved(t, c), unreachable_decl(c, _, _, _, "class", _, _).
unreachable_has_cn_import(m, n) :- unreachable_cn_import(m, n, _).
unreachable_class_names(m, n, c) :- unreachable_cn_import(m, n, c).
unreachable_class_names(m, n, c) :- unreachable_annotated(m, n), !unreachable_has_cn_import(m, n), unreachable_decl(c, _, _, n, "class", m, _).
unreachable_params(ps) :- node(_, ps, "parameters", _, _).
unreachable_params(ps) :- node(_, ps, "lambda_parameters", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, n, _), node(_, n, "identifier", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, n, _), node(_, n, "identifier", _, _), node(_, p, "typed_parameter", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, n, _), node(_, n, "identifier", _, _), node(_, p, "list_splat_pattern", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, n, _), node(_, n, "identifier", _, _), node(_, p, "dictionary_splat_pattern", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, s, _), node(_, s, "list_splat_pattern", _, _), child(s, n, _), node(_, n, "identifier", _, _).
unreachable_param_name(n) :- unreachable_params(ps), child(ps, p, _), child(p, s, _), node(_, s, "dictionary_splat_pattern", _, _), child(s, n, _), node(_, n, "identifier", _, _).
unreachable_param_name(n) :- node(_, p, "default_parameter", _, _), field(p, "name", n).
unreachable_param_name(n) :- node(_, p, "typed_default_parameter", _, _), field(p, "name", n).
unreachable_not_word(w) :- node(_, w, "identifier", _, _), inside(w, _, unreachable_imports_k).
unreachable_not_word(w) :- node(_, a, "attribute", _, _), field(a, "attribute", w).
unreachable_not_word(w) :- node(_, a, "keyword_argument", _, _), field(a, "name", w).
unreachable_not_word(w) :- node(_, a, "function_definition", _, _), field(a, "name", w).
unreachable_not_word(w) :- node(_, a, "class_definition", _, _), field(a, "name", w).
unreachable_not_word(w) :- unreachable_param_name(w).
unreachable_in_fbody(w) :- node(_, w, "identifier", _, _), inside(w, b, unreachable_body_k), field(f, "body", b), node(_, f, "function_definition", _, _).
unreachable_nested(c) :- node(_, c, "class_definition", _, _), inside(c, _, unreachable_cdef), !inside(c, _, unreachable_fdef).
unreachable_control(s) :- node(_, mo, "module", _, _), child(mo, s, _), !unreachable_def_node(s).
unreachable_def_node(s) :- node(_, s, "class_definition", _, _).
unreachable_def_node(s) :- node(_, s, "function_definition", _, _).
unreachable_def_node(s) :- node(_, s, "decorated_definition", _, _).
unreachable_word(w, d, x) :- node(d, w, "identifier", _, _), unreachable_doc(d, _, _), !unreachable_not_word(w), text(w, x).
unreachable_word_ok(w) :- unreachable_word(w, _, _), !unreachable_in_fbody(w).
unreachable_word_ok(w) :- unreachable_word(w, _, _), unreachable_nested(c), inside(w, c, unreachable_cdef).
unreachable_word_ok(w) :- unreachable_word(w, _, _), unreachable_control(s), inside(w, s, unreachable_any_k).
unreachable_dec(w, dd, x, k) :- unreachable_word(w, _, _), inside(w, dd, unreachable_dd_k), field(dd, "definition", x), node(_, x, k, _, _).
unreachable_dec_start(w, k, s) :- unreachable_dec(w, dd, _, k), node(_, dd, _, s, _).
unreachable_dec_near(w, x, k) :- unreachable_dec(w, dd, x, k), node(_, dd, _, s, _), s = max t : { unreachable_dec_start(w, k, t) }.
unreachable_w_fn(w, f) :- unreachable_word(w, _, _), nearest(w, f, unreachable_fdef).
unreachable_w_cls(w) :- unreachable_word(w, _, _), inside(w, _, unreachable_cdef).
unreachable_w_cbody(w) :- unreachable_word(w, _, _), inside(w, b, unreachable_body_k), field(c, "body", b), node(_, c, "class_definition", _, _).
unreachable_w_default(w) :- unreachable_word(w, _, _), inside(w, p, unreachable_default_k), field(p, "value", v), node(d, w, _, ws, we), node(d, v, _, vs, ve), vs <= ws, we <= ve.
unreachable_w_nested(w) :- unreachable_word(w, _, _), unreachable_nested(c), inside(w, c, unreachable_cdef).
unreachable_w_control(w) :- unreachable_word(w, _, _), unreachable_control(s), inside(w, s, unreachable_any_k).
unreachable_header_method(f) :- unreachable_fn_class(f, _, _).
unreachable_w_keep(w) :- unreachable_w_control(w).
unreachable_w_keep(w) :- unreachable_w_nested(w).
unreachable_w_keep(w) :- unreachable_w_dfn_ok(w), unreachable_w_dcls_ok(w), unreachable_w_cls_ok(w), unreachable_w_fn_ok(w).
unreachable_w_dfn_ok(w) :- unreachable_word(w, _, _), !unreachable_dec_near(w, _, "function_definition").
unreachable_w_dfn_ok(w) :- unreachable_dec_near(w, f, "function_definition"), unreachable_header_method(f).
unreachable_w_dcls_ok(w) :- unreachable_word(w, _, _), !unreachable_dec_near(w, _, "class_definition").
unreachable_w_dcls_ok(w) :- unreachable_word(w, _, _), unreachable_w_cbody(w).
unreachable_w_cls_ok(w) :- unreachable_word(w, _, _), !unreachable_w_cls(w).
unreachable_w_cls_ok(w) :- unreachable_w_cbody(w).
unreachable_w_fn_ok(w) :- unreachable_word(w, _, _), !unreachable_w_fn(w, _).
unreachable_w_fn_ok(w) :- unreachable_w_fn(w, f), unreachable_w_default(w), unreachable_header_method(f).
unreachable_module_names(m, x) :- unreachable_word_ok(w), unreachable_w_keep(w), unreachable_word(w, d, x), unreachable_doc(d, _, m).
unreachable_imported_module(t) :- unreachable_import(_, _, _, _, t, "module").
unreachable_imported_module(p) :- unreachable_import(_, _, _, _, t, "symbol"), t = @dot(p, x), !contains(".", x), !contains(".", x).
unreachable_imported_modules(m) :- unreachable_imported_module(m), m != "".
unreachable_imported_modules(q) :- unreachable_imported_module(m), m = @dot(q, rest), !contains(".", rest), rest != "", q != "".
unreachable_root(s) :- unreachable_exported(s).
unreachable_root(s) :- unreachable_public(o, _, s), unreachable_exported(o).
unreachable_root(s) :- unreachable_imported_modules(m), s = @concat("@module:", m).
unreachable_dyn(d, fq) :- unreachable_dyn_at(d, fq, lm, _), unreachable_dyn_module(d, l0, _), lm > l0.
unreachable_dyn(d, fq) :- unreachable_dyn_at(d, fq, l0, cm), unreachable_dyn_module(d, l0, c0), cm >= c0.
unreachable_dyn_module(d, l, c) :- !option_on("oracleAnalyzer"), unreachable_doc(d, _, _), node(d, mo, "module", _, _), line(mo, l), col(mo, c).
unreachable_dyn_at(d, fq, l, c) :- unreachable_dyn_module(d, _, _), source(d, sp), match_group("(?:\\bimport_module|\\bload_python_module|\\bimportlib\\.import_module)\\(\\s*['\"](?P<module>[^'\"]+)['\"]\\s*\\)\\.(?P<attr>[A-Za-z_][A-Za-z0-9_]*)", sp, m, "module", gm), match_group("(?:\\bimport_module|\\bload_python_module|\\bimportlib\\.import_module)\\(\\s*['\"](?P<module>[^'\"]+)['\"]\\s*\\)\\.(?P<attr>[A-Za-z_][A-Za-z0-9_]*)", sp, m, "attr", ga), line(m, l), col(m, c), text(gm, mn), text(ga, an), fq = @concat(mn, @concat(".", an)).
unreachable_root(s) :- unreachable_dyn(_, fq), unreachable_resolved(fq, s).
unreachable_sibling(b, b) :- unreachable_base_name(_, b).
unreachable_sibling(b, n) :- unreachable_base_name(_, b), n = @concat(b, "_async").
unreachable_sibling(b, n) :- unreachable_base_name(_, b), n = @concat(b, "_lazy").
unreachable_local(m, n) :- unreachable_decl(_, _, _, n, _, m, _).
unreachable_edge(s, t) :- reference_edge(sn, tn, _), unreachable_decl_node(sn, s), unreachable_decl_node(tn, t).
unreachable_edge(o, s) :- unreachable_public(o, _, s).
unreachable_edge(o, mid) :- unreachable_hier_d(o, c, _), unreachable_decl(c, _, _, cn, _, cm, _), unreachable_method(cm, cn, n, mid), unreachable_hook(n).
unreachable_edge(o, b) :- unreachable_base_edge(o, b, _).
unreachable_edge(b, o) :- unreachable_base_edge(o, b, _).
unreachable_edge(id, s) :- unreachable_decl(id, _, _, _, "function", m, _), unreachable_base_name(id, b), unreachable_sibling(b, sn), unreachable_decl(s, _, _, sn, _, m, _), s != id.
unreachable_edge(id, s) :- unreachable_decl(id, _, _, _, "method", _, _), unreachable_base_name(id, b), unreachable_class_id(id, cid), unreachable_sibling(b, sn), s = @concat(cid, @concat(".", sn)), unreachable_decl(s, _, _, _, _, _, _), s != id.
unreachable_edge(id, c) :- unreachable_ann(id, n), unreachable_decl(id, _, _, _, _, m, _), unreachable_class_names(m, n, c).
unreachable_edge(id, s) :- unreachable_decl(id, _, _, _, _, m, _), s = @concat("@module:", m).
unreachable_edge(s, id) :- unreachable_module_names(m, n), unreachable_decl(id, _, _, n, _, m, _), s = @concat("@module:", m).
unreachable_edge(s, id) :- unreachable_module_names(m, n), unreachable_import(_, _, m, n, t, "symbol"), unreachable_decl(id, _, _, _, _, _, t), !unreachable_local(m, n), s = @concat("@module:", m).
unreachable_edge(mid, oid) :- unreachable_class_id(mid, c), unreachable_structural(c), unreachable_decl(mid, _, _, n, _, _, _), unreachable_decl(oid, _, _, n, "method", _, _), unreachable_class_id(oid, oc), oc != c.
unreachable_flow0(s) :- unreachable_root(s).
unreachable_flow0(t) :- unreachable_flow0(n), unreachable_edge(n, t).
unreachable_flowd(o, n) :- unreachable_flow0(n), unreachable_decl(n, _, _, _, "method", _, _), unreachable_class_id(n, cid), unreachable_base_edge(o, cid, _).
unreachable_flowd(o, p) :- unreachable_flowd(n, p), unreachable_base_edge(o, n, _).
unreachable_flowd(b, p) :- unreachable_flowd(n, p), unreachable_base_edge(n, b, _), unreachable_class_id(p, pc), b != pc.
unreachable_flow0(mid) :- unreachable_flowd(n, p), unreachable_decl(n, _, _, cn, _, cm, _), unreachable_decl(p, _, _, pn, _, _, _), unreachable_method(cm, cn, pn, mid).
unreachable_ann_reach(s) :- unreachable_flow0(s).
unreachable_ann_reach(c) :- unreachable_ann_reach(s), unreachable_ann(s, n), unreachable_unique_class(n, c).
unreachable_overrides_abstract(id) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_class_id(id, cid), unreachable_hier_d(cid, b, k), k > 0, unreachable_decl(b, _, _, bn, _, bm, _), unreachable_method(bm, bn, n, mid), unreachable_abstract(mid).
unreachable_owner(id, id) :- unreachable_decl(id, _, _, _, "class", _, _).
unreachable_owner(id, c) :- unreachable_decl(id, _, _, _, k, _, _), k != "class", unreachable_class_id(id, c).
unreachable_abstract_base(id) :- unreachable_owner(id, o), unreachable_hier_d(o, b, k), k > 0, unreachable_ann_reach(b), unreachable_abstract(b).
unreachable_abstract_base(id) :- unreachable_owner(id, o), unreachable_hier_d(o, b, k), k > 0, unreachable_ann_reach(b), unreachable_decl(b, _, _, bn, _, _, _), contains("ABC", bn), unreachable_base_edge(o, b, _).
unreachable_class_protocol(id) :- unreachable_class_id(id, c), unreachable_protocol(c).
unreachable_kept(id) :- unreachable_ann_reach(id).
unreachable_kept(id) :- unreachable_decl(id, _, _, _, _, m, _), match("(?:api|data_layer)\\..*", m).
unreachable_kept(id) :- unreachable_implicit(id).
unreachable_kept(id) :- unreachable_decl(id, _, _, _, _, _, fq), unreachable_imported_fq(fq).
unreachable_kept(id) :- unreachable_decl(id, _, _, _, "class", _, _), unreachable_protocol(id).
unreachable_kept(id) :- unreachable_decl(id, _, _, n, k, _, _), k != "class", unreachable_kept_member(id, n).
unreachable_kept(id) :- unreachable_abstract_base(id).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_abstract(id).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_is_property(id).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), prefix("_lower_", n).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), icontains("register", n).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), match("_create_.*_(?:connection|validator|factory)", n).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_class_protocol(id).
unreachable_kept_member(id, n) :- unreachable_decl(id, _, _, n, _, _, _), unreachable_overrides_abstract(id).
unreachable_high(id, x, d, n, k) :- unreachable_decl(id, x, d, n, k, _, _), !unreachable_kept(id).
unreachable_intent(id) :- unreachable_high(id, _, _, n, "class"), suffix("Intent", n).
unreachable_intent(id) :- unreachable_high(id, x, _, _, "class"), unreachable_base_text(x, s), contains("ServerPlanStep", s).
unreachable_grammar(id) :- unreachable_high(id, _, d, _, "class"), !unreachable_protocol(id), unreachable_doc(d, p, _), contains("/l2100_sql_grammar/", p).
unreachable_grammar(id) :- unreachable_high(id, _, _, n, "class"), !unreachable_protocol(id), suffix("Grammar", n).
unreachable_grammar(id) :- unreachable_high(id, _, _, n, "class"), !unreachable_protocol(id), prefix("Sql", n).
unreachable_grammar(id) :- unreachable_high(id, x, _, _, "class"), !unreachable_protocol(id), unreachable_base_text(x, s), (contains("Sql", s) ; contains("Grammar", s)).
unreachable_category(id, x, d, "high_confidence_functions") :- unreachable_high(id, x, d, _, k), k != "class".
unreachable_category(id, x, d, "high_confidence_intents") :- unreachable_high(id, x, d, _, "class"), unreachable_intent(id).
unreachable_category(id, x, d, "high_confidence_grammar_classes") :- unreachable_high(id, x, d, _, "class"), unreachable_grammar(id).
unreachable_category(id, x, d, "high_confidence_other_classes") :- unreachable_high(id, x, d, _, "class"), !unreachable_intent(id), !unreachable_grammar(id).
unreachable_shown(d) :- unreachable_doc(d, _, _), option_on("oracleAnalyzer").
unreachable_shown(d) :- unreachable_doc(d, p, _), !option_on("oracleAnalyzer"), !prefix("impl/browser/", p).
violation("data-layer-internal-dead-code", "unreachable-internal-symbols", c, p, l) :- unreachable_category(_, x, d, c), unreachable_shown(d), doc(d, p, _), line(x, l).
rr_demand_agg_rr_agg13(c, i) :- comp_scope(k), kind(c, k), child(c, fc, i), kind(fc, "for_in_clause").
rr_demand_agg_rr_agg16(a, st) :- kind(st, "delete_statement"), within(st, a), kind(a, "except_clause").
rr_demand_agg_rr_agg16(a, st) :- kind(st, "delete_statement"), within(st, a), kind(a, "except_group_clause").
rr_demand_agg_rr_agg18(m, x) :- rf_mbind(m, x, _, _).
rr_demand_agg_rr_agg21(s, x) :- rf_value_last(_, h), kind(h, "identifier"), look(h, x, s), rf_start(h, r).
rr_demand_agg_rr_agg22(o, x) :- unreachable_reach(o, b), unreachable_decl_node(x, b).
rr_demand_agg_rr_agg24(n, o) :- unreachable_hier_d(o, c, _), unreachable_pub(c, n, _).
