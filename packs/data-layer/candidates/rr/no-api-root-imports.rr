nari_regex_0(t, i, a, b) :- nari_piece(_, _, t, _, _, _), match_all("(^|\\n)[ \\t]*from api import [^\\n]+", t, i, a, b).
.decl nari_regex_1(t: symbol, ordinal: number, start: number, end: number)
nari_regex_1(t, i, a, b) :- nari_piece(_, _, t, _, _, _), match_all("(^|\\n)[ \\t]*import api[\\x{9}-\\x{d}\\x{1c}-\\x{20}\\x{85}\\x{a0}\\x{1680}\\x{2000}-\\x{200a}\\x{2028}-\\x{2029}\\x{202f}\\x{205f}\\x{3000}]*(\\n|(?:\\z|\\n\\z))", t, i, a, b).

.decl nari_hidden(d: number)
nari_hidden(d) :- path_part(d, p), (p = "tests" ; p = "test").
nari_hidden(d) :- doc(d, _, _), option_item("pathParts", _, p), (p = "tests" ; p = "test").
.decl nari_framework_hidden(d: number)
