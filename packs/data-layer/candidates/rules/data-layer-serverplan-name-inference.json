  "mode": "block",
  "description": "Port of nera-data-layer serverplan_name_inference at 2b1504adc4291daaf080b2e932962b134da1a69a.",
  "scope": {
    "include": [
      "l2060_query_builder/**/*.py",
      "l2070_batching/**/*.py",
      "impl/common/l2070_server_plan/**/*.py"
    ],
    "exclude": [
      "**/.git/**",
      "**/.venv/**",
