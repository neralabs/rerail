{
  "format": "rerail.rule-pack/v1",
  "id": "typescript",
  "name": "TypeScript",
  "category": "language",
  "covers": "22 typescript-eslint rules ported to Rerail, 11 of them on and 11 off until turned on, each scored against the tool's own recorded findings on its test fixtures.",
  "reason": "matches TypeScript",
  "match": {
    "any": [
      {
        "npmDependencies": [
          "typescript"
        ]
      },
      {
        "files": [
          "**/*.ts",
          "**/*.mts",
          "**/*.cts"
        ],
        "exclude": [
          "**/*.d.ts"
        ],
        "label": "*.ts files"
      },
      {
        "files": [
          "**/*.tsx"
        ],
        "label": "*.tsx files"
      }
    ]
  },
  "rules": [
    {
      "id": "typescript-eslint-ban-tslint-comment",
      "document": "rules/typescript-eslint-ban-tslint-comment.json",
      "title": "typescript-eslint ban-tslint-comment: Disallow `// tslint:<rule-flag>` comments",
      "group": "typescript-eslint",
      "on": false
    },
    {
      "id": "typescript-eslint-consistent-type-definitions",
      "document": "rules/typescript-eslint-consistent-type-definitions.json",
      "title": "typescript-eslint consistent-type-definitions: Enforce type definitions to consistently use either `interface` or `type`",
      "group": "typescript-eslint",
      "on": false
    },
    {
      "id": "typescript-eslint-no-array-constructor",
      "document": "rules/typescript-eslint-no-array-constructor.json",
      "title": "typescript-eslint no-array-constructor: Disallow generic `Array` constructors",
      "group": "typescript-eslint"
    },
    {
      "id": "typescript-eslint-no-extra-non-null-assertion",
      "document": "rules/typescript-eslint-no-extra-non-null-assertion.json",
      "title": "typescript-eslint no-extra-non-null-assertion: Disallow extra non-null assertions",
      "group": "typescript-eslint"
    },
    {
      "id": "typescript-eslint-no-import-type-side-effects",
      "document": "rules/typescript-eslint-no-import-type-side-effects.json",
      "title": "typescript-eslint no-import-type-side-effects: Enforce the use of top-level import type qualifier when an import only has specifiers with inline type qualifiers",
      "group": "typescript-eslint",
      "on": false
    },
    {
      "id": "typescript-eslint-no-unnecessary-type-constraint",
      "document": "rules/typescript-eslint-no-unnecessary-type-constraint.json",
      "title": "typescript-eslint no-unnecessary-type-constraint: Disallow unnecessary constraints on generic types",
      "group": "typescript-eslint"
    },
    {
      "id": "typescript-eslint-prefer-as-const",
      "document": "rules/typescript-eslint-prefer-as-const.json",
      "title": "typescript-eslint prefer-as-const: Enforce the use of as const over literal type",
      "group": "typescript-eslint"
    },
    {
      "id": "typescript-eslint-prefer-enum-initializers",
      "document": "rules/typescript-eslint-prefer-enum-initializers.json",
      "title": "typescript-eslint prefer-enum-initializers: Require each enum member value to be explicitly initialized",
      "group": "typescript-eslint",
      "on": false
    },
    {
      "id": "typescript-eslint-prefer-literal-enum-member",
      "document": "rules/typescript-eslint-prefer-literal-enum-member.json",
      "title": "typescript-eslint prefer-literal-enum-member: Require all enum members to be literal values",
      "group": "typescript-eslint",
      "on": false
    }
  ]
}
