{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-no-unnecessary-type-constraint",
  "revision": 4,
  "mode": "steer",
  "description": "Remove extends any and extends unknown constraints from TypeScript type parameters; they constrain nothing.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-constraint",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "type_parameter",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "kind": "type_identifier"
                    },
                    {
                      "pattern": "$NAME"
                    }
                  ]
                }
              },
              {
                "has": {
                  "kind": "constraint",
                  "stopBy": "neighbor",
                  "has": {
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "kind": "predefined_type"
                      },
                      {
                        "regex": "^(any|unknown)$"
                      },
                      {
                        "pattern": "$CONSTRAINT"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-unnecessary-type-constraint",
        "message": "Remove `extends $CONSTRAINT` from the type parameter `$NAME`; it constrains nothing.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-unnecessary-type-constraint"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unnecessary-type-constraint"
            ]
          },
          "biome": {
            "rules": [
              "lint/complexity/noUselessTypeConstraint"
            ]
          }
        }
      }
    }
  ]
}
