{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-ban-tslint-comment",
  "revision": 3,
  "mode": "steer",
  "description": "Remove TSLint enable and disable comments; TSLint is deprecated and they no longer do anything.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "tslint-comment",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "comment",
            "regex": "^(?P<TEXT>(//|/\\*)\\s*tslint:(enable|disable)(-(line|next-line))?(:|\\s|$|\\*/).*)$"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/ban-tslint-comment",
        "message": "tslint comment detected: \"$TEXT\"",
        "fix": "",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/ban-tslint-comment"
            ]
          },
          "oxlint": {
            "rules": [
              "ban-tslint-comment"
            ]
          }
        }
      }
    }
  ]
}
