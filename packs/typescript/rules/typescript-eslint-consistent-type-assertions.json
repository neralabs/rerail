{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-consistent-type-assertions",
  "revision": 1,
  "mode": "steer",
  "description": "Write TypeScript type assertions with as instead of angle brackets; the angle-bracket form can't be used in TSX files.",
  "scope": {
    "include": ["**/*"],
    "exclude": []
  },
  "clauses": [
    {
      "id": "angle-bracket-assertion",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "type_assertion"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/consistent-type-assertions",
        "message": "Use `value as T` instead of the angle-bracket assertion `<T>value`.",
        "suppress": {
          "eslint": {
            "rules": ["@typescript-eslint/consistent-type-assertions"]
          }
        }
      }
    }
  ]
}
