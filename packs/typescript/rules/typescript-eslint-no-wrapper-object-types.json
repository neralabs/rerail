{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-no-wrapper-object-types",
  "revision": 3,
  "mode": "steer",
  "description": "Use the primitive types string, number, boolean, bigint, symbol and object in TypeScript instead of their capitalized wrapper object types.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "type-bigint",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "type_identifier",
            "resolves": {
              "global": [
                "BigInt"
              ]
            },
            "not": {
              "matches": "heritage"
            }
          },
          "utils": {
            "heritage": {
              "inside": {
                "any": [
                  {
                    "kind": "implements_clause"
                  },
                  {
                    "kind": "extends_type_clause"
                  }
                ],
                "stopBy": "neighbor"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-wrapper-object-types",
        "message": "Prefer using the primitive `bigint` as a type name, rather than the upper-cased `BigInt`.",
        "fix": "bigint",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-wrapper-object-types"
            ]
          },
          "oxlint": {
            "rules": [
              "no-wrapper-object-types"
            ]
          }
        }
      }
    },
