{
 "format": "rerail.policy/v1",
 "id": "typescript-eslint-no-array-constructor",
 "revision": 4,
 "mode": "steer",
 "description": "Use an array literal instead of Array() or new Array() in TypeScript; the constructor treats a single number argument as a length.",
 "scope": {
  "include": [
   "**/*.ts",
   "**/*.tsx",
   "**/*.mts",
   "**/*.cts"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "array-constructor-fix",
   "forbid": {
    "ast": {
     "language": "typescript",
     "rule": {
      "all": [
       {
        "all": [
         {
          "any": [
           {
            "kind": "call_expression"
           },
           {
            "kind": "new_expression"
           }
          ]
         },
         {
          "has": {
           "matches": "array-callee"
          }
         },
         {
          "not": {
           "has": {
            "kind": "type_arguments"
           }
          }
         },
         {
          "not": {
           "has": {
            "kind": "template_string"
           }
          }
         },
         {
          "not": {
           "has": {
            "kind": "arguments",
            "count": {
             "has": {
              "matches": "arg"
             },
             "min": 1,
             "max": 1
            }
           }
          }
         }
        ]
       },
       {
        "any": [
         {
          "has": {
           "kind": "arguments",
           "pattern": {
            "context": "f($$$A)",
            "selector": "arguments"
           }
          }
         },
         {
          "not": {
           "has": {
            "kind": "arguments"
           }
          }
         }
        ]
       },
       {
        "not": {
         "has": {
          "kind": "arguments",
          "has": {
           "kind": "comment"
          }
         }
        }
       }
      ]
     },
     "utils": {
      "array-callee": {
       "any": [
        {
         "kind": "identifier",
         "regex": "^Array$"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "matches": "array-callee"
         }
        }
       ]
      },
      "arg": {
       "not": {
        "any": [
         {
          "regex": "^[(),]$"
         },
         {
          "kind": "comment"
         }
        ]
       }
      }
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "@typescript-eslint/no-array-constructor",
    "message": "The array literal notation [] is preferable.",
    "fix": "[$$$A]",
    "suppress": {
     "eslint": {
      "rules": [
       "@typescript-eslint/no-array-constructor"
      ]
     },
     "oxlint": {
      "rules": [
       "no-array-constructor"
      ]
     },
     "biome": {
      "rules": [
       "lint/style/useArrayLiterals"
      ]
     }
    }
   }
  },
  {
   "id": "array-constructor",
   "forbid": {
    "ast": {
