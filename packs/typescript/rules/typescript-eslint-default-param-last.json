{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-default-param-last",
  "revision": 4,
  "mode": "steer",
  "description": "Put defaulted and optional parameters after required ones in TypeScript functions; callers otherwise can't omit them.",
  "scope": { "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"], "exclude": [] },
  "clauses": [
    {
      "id": "default-param-not-last",
      "forbid": {
        "ast": {
          "language": "typescript",
          "utils": {
            "defaulted": {
              "any": [
                { "kind": "optional_parameter" },
                { "kind": "required_parameter", "has": { "regex": "^=$", "stopBy": "neighbor" } }
              ]
            },
            "plain": {
              "kind": "required_parameter",
              "not": {
                "any": [
                  { "has": { "regex": "^=$", "stopBy": "neighbor" } },
                  { "has": { "kind": "rest_pattern", "stopBy": "neighbor" } }
                ]
              }
            }
          },
          "rule": {
            "matches": "defaulted",
            "precedes": { "matches": "plain", "stopBy": "end" },
            "inside": {
              "kind": "formal_parameters",
              "stopBy": "neighbor",
              "inside": {
                "any": [
                  { "kind": "function_declaration" },
                  { "kind": "function_expression" },
                  { "kind": "generator_function_declaration" },
                  { "kind": "generator_function" },
                  { "kind": "arrow_function" },
                  { "kind": "method_definition" }
                ],
                "stopBy": "neighbor"
              }
            }
          }
        }
      },
      "violation": { "anchor": "witness.span", "code": "@typescript-eslint/default-param-last", "message": "Move this default or optional parameter after the required parameters.", "suppress": { "eslint": { "rules": ["@typescript-eslint/default-param-last"] }, "oxlint": { "rules": ["default-param-last"] }, "biome": { "rules": ["lint/style/useDefaultParameterLast"] } } }
    }
  ]
}
