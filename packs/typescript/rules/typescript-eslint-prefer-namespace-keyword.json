{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-prefer-namespace-keyword",
  "revision": 4,
  "mode": "steer",
  "description": "Use the namespace keyword instead of module to declare custom TypeScript namespaces; module is reserved for external module declarations.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "declared-module-keyword",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^module$",
                "precedes": {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "nested_identifier"
                    }
                  ]
                }
              },
              {
                "inside": {
                  "kind": "module",
                  "pattern": "$M",
                  "inside": {
                    "kind": "ambient_declaration",
                    "pattern": "$D"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.D",
        "code": "@typescript-eslint/prefer-namespace-keyword",
        "message": "Use 'namespace' instead of 'module' to declare custom TypeScript modules.",
        "fix": "namespace",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/prefer-namespace-keyword"
            ]
          },
          "oxlint": {
            "rules": [
              "prefer-namespace-keyword"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/useNamespaceKeyword"
            ]
          }
        }
      }
    },
    {
      "id": "module-keyword",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^module$",
                "precedes": {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "nested_identifier"
                    }
                  ]
                }
              },
              {
                "inside": {
                  "kind": "module",
                  "pattern": "$M",
                  "not": {
                    "inside": {
                      "kind": "ambient_declaration"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.M",
        "code": "@typescript-eslint/prefer-namespace-keyword",
        "message": "Use 'namespace' instead of 'module' to declare custom TypeScript modules.",
        "fix": "namespace",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/prefer-namespace-keyword"
            ]
          },
          "oxlint": {
            "rules": [
              "prefer-namespace-keyword"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/useNamespaceKeyword"
            ]
          }
        }
      }
    }
  ]
}