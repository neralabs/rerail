{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-no-namespace",
  "revision": 7,
  "mode": "steer",
  "description": "Use ES module imports and exports instead of TypeScript namespaces and custom modules; global augmentations, named module declarations and .d.ts files are exempt.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "options",
      "define": {
        "options": {
          "allowDeclarations": {
            "type": "boolean",
            "nullable": true,
            "default": null
          }
        }
      }
    },
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "r1": {
            "any": [
              {
                "kind": "internal_module",
                "has": {
                  "regex": "^namespace$",
                  "stopBy": "neighbor"
                }
              },
              {
                "kind": "module",
                "not": {
                  "has": {
                    "kind": "string",
                    "stopBy": "neighbor"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "namespace",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "matches": "r1"
              },
              {
                "not": {
                  "inside": {
                    "kind": "ambient_declaration",
                    "stopBy": "neighbor"
                  }
                }
              },
              {
                "$option": "allowDeclarations",
                "cases": {
                  "true": [
                    {
                      "not": {
                        "inside": {
                          "kind": "ambient_declaration",
                          "stopBy": "end"
                        }
                      }
                    }
                  ]
                },
                "default": [],
                "spread": true
              }
            ]
          },
          "file": {
            "path": {
              "notRegex": "\\.d\\.(ts|cts|mts|.*\\.ts)$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-namespace",
        "message": "ES2015 module syntax is preferred over namespaces.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-namespace"
            ]
          },
          "oxlint": {
            "rules": [
              "no-namespace"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/noNamespace"
            ]
          }
        }
      }
    },
    {
      "id": "declared-namespace",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "ambient_declaration",
            "has": {
              "stopBy": "neighbor",
              "matches": "r1"
            }
          },
          "when": {
            "option": {
              "allowDeclarations": {
                "in": [
                  null,
                  false
                ]
              }
            }
          },
          "file": {
            "path": {
              "notRegex": "\\.d\\.(ts|cts|mts|.*\\.ts)$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-namespace",
        "message": "ES2015 module syntax is preferred over namespaces.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-namespace"
            ]
          },
          "oxlint": {
            "rules": [
              "no-namespace"
            ]
          },
          "biome": {
            "rules": [
              "lint/style/noNamespace"
            ]
          }
        }
      }
    }
  ]
}
