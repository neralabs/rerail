{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-prefer-enum-initializers",
  "revision": 4,
  "mode": "steer",
  "description": "Give every TypeScript enum member an explicit value; implicit numbering shifts when members are added or reordered.",
  "scope": { "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"], "exclude": [] },
  "clauses": [
    {
      "id": "enum-member-without-initializer",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "any": [{ "kind": "property_identifier" }, { "kind": "string" }, { "kind": "computed_property_name" }] },
              { "pattern": "$NAME" }
            ],
            "inside": { "kind": "enum_body", "stopBy": "neighbor" }
          }
        }
      },
      "violation": { "anchor": "witness.span", "code": "@typescript-eslint/prefer-enum-initializers", "message": "The value of the member '$NAME' should be explicitly defined.", "suppress": { "eslint": { "rules": ["@typescript-eslint/prefer-enum-initializers"] }, "oxlint": { "rules": ["prefer-enum-initializers"] }, "biome": { "rules": ["lint/style/useEnumInitializers"] } } }
    }
  ]
}
