{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-no-unsafe-function-type",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid the global Function type in TypeScript; spell out the parameter and return types, since Function accepts any callable.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "function-type",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "type_identifier",
            "resolves": {
              "global": [
                "Function"
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-unsafe-function-type",
        "message": "The `Function` type accepts any function-like value.\nPrefer explicitly defining any function parameters and return type.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-unsafe-function-type"
            ]
          },
          "oxlint": {
            "rules": [
              "no-unsafe-function-type"
            ]
          }
        }
      }
    }
  ]
}
