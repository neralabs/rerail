{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-no-misused-new",
  "revision": 1,
  "mode": "steer",
  "description": "Don't declare a new method on a class or a constructor or construct signature on an interface; define a real class constructor instead.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "class-method-new",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "method_signature",
            "all": [
              {
                "has": {
                  "kind": "property_identifier",
                  "regex": "^new$",
                  "stopBy": "neighbor"
                }
              },
              {
                "inside": {
                  "kind": "class_body",
                  "inside": {
                    "any": [
                      {
                        "kind": "class_declaration"
                      },
                      {
                        "kind": "abstract_class_declaration"
                      },
                      {
                        "kind": "class"
                      }
                    ],
                    "has": {
                      "kind": "type_identifier",
                      "pattern": "$NAME",
                      "stopBy": "neighbor"
                    },
                    "stopBy": "neighbor"
                  },
                  "stopBy": "neighbor"
                }
              },
              {
                "has": {
                  "kind": "type_annotation",
                  "has": {
                    "any": [
                      {
                        "kind": "type_identifier",
                        "pattern": "$NAME"
                      },
                      {
                        "kind": "generic_type",
                        "has": {
                          "kind": "type_identifier",
                          "pattern": "$NAME",
                          "stopBy": "neighbor"
                        }
                      }
                    ],
                    "stopBy": "neighbor"
                  },
                  "stopBy": "neighbor"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-misused-new",
        "message": "Replace this method named `new` with a constructor; `new` on the class never calls it.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-misused-new"
            ]
          },
          "oxlint": {
            "rules": [
              "no-misused-new"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noMisleadingInstantiator"
            ]
          }
        }
      }
    },
    {
      "id": "interface-construct-signature",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "construct_signature",
            "all": [
              {
                "inside": {
                  "kind": "interface_body",
                  "inside": {
                    "kind": "interface_declaration",
                    "has": {
                      "kind": "type_identifier",
                      "pattern": "$NAME",
                      "stopBy": "neighbor"
                    },
                    "stopBy": "neighbor"
                  },
                  "stopBy": "neighbor"
                }
              },
              {
                "has": {
                  "kind": "type_annotation",
                  "has": {
                    "any": [
                      {
                        "kind": "type_identifier",
                        "pattern": "$NAME"
                      },
                      {
                        "kind": "generic_type",
                        "has": {
                          "kind": "type_identifier",
                          "pattern": "$NAME",
                          "stopBy": "neighbor"
                        }
                      }
                    ],
                    "stopBy": "neighbor"
                  },
                  "stopBy": "neighbor"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-misused-new",
        "message": "Declare $NAME as a class with a constructor instead of giving the interface a construct signature that returns itself.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-misused-new"
            ]
          },
          "oxlint": {
            "rules": [
              "no-misused-new"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noMisleadingInstantiator"
            ]
          }
        }
      }
    },
    {
      "id": "interface-constructor",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "method_signature",
            "all": [
              {
                "has": {
                  "kind": "property_identifier",
                  "regex": "^constructor$",
                  "stopBy": "neighbor"
                }
              },
              {
                "inside": {
                  "any": [
                    {
                      "kind": "interface_body"
                    },
                    {
                      "kind": "object_type"
                    }
                  ],
                  "stopBy": "neighbor"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-misused-new",
        "message": "Remove this constructor method from the interface; declare a class with a real constructor if you need one.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-misused-new"
            ]
          },
          "oxlint": {
            "rules": [
              "no-misused-new"
            ]
          },
          "biome": {
            "rules": [
              "lint/suspicious/noMisleadingInstantiator"
            ]
          }
        }
      }
    }
  ]
}
