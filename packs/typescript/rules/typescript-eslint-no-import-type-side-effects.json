{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-no-import-type-side-effects",
  "revision": 3,
  "mode": "steer",
  "description": "Use a top-level import type when every imported name is an inline type import; otherwise a side-effect import stays at runtime.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "inline-type-only-import-multi",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "import_statement",
                "not": {
                  "has": {
                    "regex": "^type$",
                    "stopBy": "neighbor"
                  }
                },
                "has": {
                  "kind": "import_clause",
                  "stopBy": "neighbor",
                  "not": {
                    "has": {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "namespace_import"
                        }
                      ],
                      "stopBy": "neighbor"
                    }
                  },
                  "has": {
                    "kind": "named_imports",
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "has": {
                          "kind": "import_specifier",
                          "stopBy": "neighbor"
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "kind": "import_specifier",
                            "stopBy": "neighbor",
                            "not": {
                              "has": {
                                "regex": "^type$",
                                "stopBy": "neighbor"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "any": [
                  {
                    "has": {
                      "kind": "import_clause",
                      "stopBy": "neighbor",
                      "has": {
                        "kind": "named_imports",
                        "stopBy": "neighbor",
                        "count": {
                          "has": {
                            "kind": "import_specifier",
                            "stopBy": "neighbor"
                          },
                          "min": 2
                        }
                      }
                    }
                  },
                  {
                    "not": {
                      "regex": ";$"
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-import-type-side-effects",
        "message": "TypeScript will only remove the inline type specifiers which will leave behind a side effect import at runtime. Convert this to a top-level type qualifier to properly remove the entire import.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-import-type-side-effects"
            ]
          },
          "oxlint": {
            "rules": [
              "no-import-type-side-effects"
            ]
          }
        }
      }
    },
    {
      "id": "inline-type-only-import-single",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "import_statement",
                "not": {
                  "has": {
                    "regex": "^type$",
                    "stopBy": "neighbor"
                  }
                },
                "has": {
                  "kind": "import_clause",
                  "stopBy": "neighbor",
                  "not": {
                    "has": {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "namespace_import"
                        }
                      ],
                      "stopBy": "neighbor"
                    }
                  },
                  "has": {
                    "kind": "named_imports",
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "has": {
                          "kind": "import_specifier",
                          "stopBy": "neighbor"
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "kind": "import_specifier",
                            "stopBy": "neighbor",
                            "not": {
                              "has": {
                                "regex": "^type$",
                                "stopBy": "neighbor"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "regex": ";$"
              },
              {
                "has": {
                  "kind": "import_clause",
                  "stopBy": "neighbor",
                  "has": {
                    "kind": "named_imports",
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "count": {
                          "has": {
                            "kind": "import_specifier",
                            "stopBy": "neighbor"
                          },
                          "max": 1
                        }
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "pattern": {
                            "context": "import { type $A } from 'x';",
                            "selector": "import_specifier"
                          },
                          "not": {
                            "has": {
                              "regex": "^as$",
                              "stopBy": "neighbor"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "has": {
                  "kind": "string",
                  "stopBy": "neighbor",
                  "pattern": "$S"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-import-type-side-effects",
        "message": "TypeScript will only remove the inline type specifiers which will leave behind a side effect import at runtime. Convert this to a top-level type qualifier to properly remove the entire import.",
        "fix": "import type { $A } from $S;",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-import-type-side-effects"
            ]
          },
          "oxlint": {
            "rules": [
              "no-import-type-side-effects"
            ]
          }
        }
      }
    },
    {
      "id": "inline-type-only-import-alias",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "import_statement",
                "not": {
                  "has": {
                    "regex": "^type$",
                    "stopBy": "neighbor"
                  }
                },
                "has": {
                  "kind": "import_clause",
                  "stopBy": "neighbor",
                  "not": {
                    "has": {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "namespace_import"
                        }
                      ],
                      "stopBy": "neighbor"
                    }
                  },
                  "has": {
                    "kind": "named_imports",
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "has": {
                          "kind": "import_specifier",
                          "stopBy": "neighbor"
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "kind": "import_specifier",
                            "stopBy": "neighbor",
                            "not": {
                              "has": {
                                "regex": "^type$",
                                "stopBy": "neighbor"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "regex": ";$"
              },
              {
                "has": {
                  "kind": "import_clause",
                  "stopBy": "neighbor",
                  "has": {
                    "kind": "named_imports",
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "count": {
                          "has": {
                            "kind": "import_specifier",
                            "stopBy": "neighbor"
                          },
                          "max": 1
                        }
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "pattern": {
                            "context": "import { type $A as $B } from 'x';",
                            "selector": "import_specifier"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "has": {
                  "kind": "string",
                  "stopBy": "neighbor",
                  "pattern": "$S"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-import-type-side-effects",
        "message": "TypeScript will only remove the inline type specifiers which will leave behind a side effect import at runtime. Convert this to a top-level type qualifier to properly remove the entire import.",
        "fix": "import type { $A as $B } from $S;",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-import-type-side-effects"
            ]
          },
          "oxlint": {
            "rules": [
              "no-import-type-side-effects"
            ]
          }
        }
      }
    }
  ]
}
