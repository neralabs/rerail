{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-init-declarations",
  "revision": 1,
  "mode": "steer",
  "description": "Port of typescript-eslint's `init-declarations` rule (https://typescript-eslint.io/rules/init-declarations) in `always` mode, the default the rule declares. typescript-eslint 8.70.1 does not hand that default on to ESLint's core rule, so configured without options it reports nothing; this document is the rule as `[\"error\", \"always\"]` runs it. It reports each variable declared by a plain name without an initial value, at the name. The head of a `for` loop counts as initialized; a declaration that is itself the body of a `for`, `for...in` or `for...of` loop counts as uninitialized even with a value, and is then reported over the whole declarator. Declarations marked `declare`, and everything inside a `declare namespace`, `declare module` or `declare global` block, are skipped. The ancestor walk (`outside-declared-module`) recognizes a declared module by its leading `declare` keyword using positive tests only, so the document is still evaluated in files with syntax errors. As in TypeScript, comments after `declare` are skipped, and a line break after it (bare or inside a block comment) makes `declare` an ordinary name rather than a modifier, so what follows is checked as a plain statement.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "no-leading-declare-modifier": {
            "regex": "^(?:[^d]|d[^e]|de[^c]|dec[^l]|decl[^a]|decla[^r]|declar[^e]|declare(?:[\\w$]|(?:\\s|/\\*[^*]*\\*+(?:[^/*][^*]*\\*+)*/)*(?:[^\\s\\w$/]|/[^*]|[\\n\\r\\x{2028}\\x{2029}]|/\\*(?:[^*]|\\*+[^*/])*\\**[\\n\\r\\x{2028}\\x{2029}])|(?:\\s|/\\*[^*]*\\*+(?:[^/*][^*]*\\*+)*/)+(?:as|in|instanceof|satisfies)(?:[^\\w$]|$)))"
          },
          "outside-declared-module": {
            "any": [
              { "kind": "program" },
              {
                "any": [
                  { "matches": "no-leading-declare-modifier" },
                  {
                    "kind": "ambient_declaration",
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        { "kind": "function_declaration" }, { "kind": "generator_function_declaration" },
                        { "kind": "class_declaration" }, { "kind": "abstract_class_declaration" },
                        { "kind": "lexical_declaration" }, { "kind": "variable_declaration" },
                        { "kind": "function_signature" }, { "kind": "type_alias_declaration" },
                        { "kind": "enum_declaration" }, { "kind": "interface_declaration" },
                        { "kind": "import_alias" }, { "kind": "ambient_declaration" }
                      ]
                    }
                  },
                  { "kind": "public_field_definition" }
                ],
                "inside": { "stopBy": "neighbor", "matches": "outside-declared-module" }
              }
            ]
          },
          "declaration-in-statement-list": {
            "any": [{ "kind": "lexical_declaration" }, { "kind": "variable_declaration" }],
            "inside": {
              "stopBy": "neighbor",
              "any": [
                { "kind": "program" }, { "kind": "statement_block" }, { "kind": "switch_case" },
                { "kind": "switch_default" }, { "kind": "labeled_statement" }, { "kind": "if_statement" },
                { "kind": "else_clause" }, { "kind": "while_statement" }, { "kind": "do_statement" },
                { "kind": "with_statement" }, { "kind": "export_statement" },
                { "kind": "ambient_declaration", "matches": "no-leading-declare-modifier" }
              ],
              "matches": "outside-declared-module"
            }
          },
          "declaration-as-loop-body": {
            "any": [{ "kind": "lexical_declaration" }, { "kind": "variable_declaration" }],
            "inside": {
              "stopBy": "neighbor",
              "field": "body",
              "any": [{ "kind": "for_statement" }, { "kind": "for_in_statement" }],
              "matches": "outside-declared-module"
            }
          }
        }
      }
    },
    {
      "id": "declared-without-initializer",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "variable_declarator",
            "has": { "field": "name", "kind": "identifier", "pattern": "$NAME" },
            "not": { "has": { "field": "value", "pattern": "$INIT" } },
            "inside": {
              "stopBy": "neighbor",
              "any": [{ "matches": "declaration-in-statement-list" }, { "matches": "declaration-as-loop-body" }]
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.NAME",
        "code": "@typescript-eslint/init-declarations",
        "message": "Variable '$NAME' is declared without an initial value; give it one in its declaration.",
        "suppress": { "eslint": { "rules": ["@typescript-eslint/init-declarations"] } }
      }
    },
    {
      "id": "loop-body-declaration",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "variable_declarator",
            "all": [
              { "has": { "field": "name", "kind": "identifier", "pattern": "$NAME" } },
              { "has": { "field": "value", "pattern": "$INIT" } }
            ],
            "inside": { "stopBy": "neighbor", "matches": "declaration-as-loop-body" }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/init-declarations",
        "message": "Variable '$NAME' is declared as the whole body of a loop, where its value does not count as an initializer.",
        "suppress": { "eslint": { "rules": ["@typescript-eslint/init-declarations"] } }
      }
    }
  ]
}
