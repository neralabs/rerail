{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-consistent-type-imports",
  "revision": 1,
  "mode": "steer",
  "description": "An import whose binding is only ever used as a type, without `import type`.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.d.ts"
    ]
  },
  "clauses": [
    {
      "id": "type-only",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "identifier",
            "inside": {
              "kind": "import_statement",
              "stopBy": "end",
              "not": {
                "regex": "^import\\s+type\\b"
              }
            },
            "not": {
              "any": [
                {
                  "inside": {
                    "kind": "import_specifier",
                    "stopBy": "neighbor",
                    "regex": "^type\\s"
                  }
                },
                {
                  "regex": "^React$",
                  "inside": {
                    "kind": "program",
                    "stopBy": "end",
                    "has": {
                      "stopBy": "end",
                      "any": [
                        {
                          "kind": "jsx_element"
                        },
                        {
                          "kind": "jsx_self_closing_element"
                        }
                      ]
                    }
                  }
                },
                {
                  "inside": {
                    "kind": "program",
                    "stopBy": "end",
                    "has": {
                      "stopBy": "end",
                      "kind": "decorator"
                    }
                  }
                }
              ]
            },
            "binds": {
              "used": true
            },
            "all": [
              {
                "not": {
                  "binds": {
                    "occurrence": {
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "shorthand_property_identifier"
                        }
                      ],
                      "not": {
                        "any": [
                          {
                            "inside": {
                              "kind": "import_statement",
                              "stopBy": "end"
                            }
                          },
                          {
                            "inside": {
                              "kind": "nested_type_identifier",
                              "stopBy": "neighbor"
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/consistent-type-imports",
        "message": "This import is only used as a type. Use import type.",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/consistent-type-imports"
            ]
          }
        }
      }
    }
  ]
}
