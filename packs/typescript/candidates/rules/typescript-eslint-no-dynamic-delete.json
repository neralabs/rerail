{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-no-dynamic-delete",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid delete with a computed key in TypeScript; use a Map or Set for dynamic keys instead.",
  "scope": { "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"], "exclude": [] },
  "clauses": [
    {
      "id": "dynamic-delete",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              { "follows": { "regex": "^\\[$", "stopBy": "neighbor" } },
              { "inside": { "kind": "subscript_expression", "stopBy": "neighbor", "matches": "delete-operand" } },
              {
                "not": {
                  "any": [
                    { "kind": "string" },
                    { "kind": "number" },
                    { "kind": "unary_expression", "has": { "regex": "^-$", "stopBy": "neighbor" }, "all": [{ "has": { "kind": "number", "stopBy": "neighbor" } }] }
                  ]
                }
              }
            ]
          },
          "utils": {
            "delete-operand": {
              "any": [
                { "inside": { "kind": "unary_expression", "stopBy": "neighbor", "has": { "regex": "^delete$", "stopBy": "neighbor" } } },
                { "inside": { "kind": "parenthesized_expression", "stopBy": "neighbor", "matches": "delete-operand" } }
              ]
            }
          }
        }
      },
      "violation": { "anchor": "witness.span", "code": "@typescript-eslint/no-dynamic-delete", "message": "Do not delete dynamically computed property keys.", "suppress": { "eslint": { "rules": ["@typescript-eslint/no-dynamic-delete"] }, "oxlint": { "rules": ["no-dynamic-delete"] } } }
    }
  ]
}
