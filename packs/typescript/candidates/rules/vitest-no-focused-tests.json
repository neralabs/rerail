{
  "format": "rerail.policy/v1",
  "id": "vitest-no-focused-tests",
  "revision": 2,
  "mode": "steer",
  "description": "A focused test (`.only`), which makes Vitest skip every other test in the file.",
  "scope": {
    "include": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.test.mts",
      "**/*.spec.mts",
      "**/__tests__/**/*.ts",
      "**/__tests__/**/*.tsx"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "vitest-functions",
      "define": {
        "language": "typescript",
        "utils": {
          "vitest-focusable-test-extended": {
            "resolves": {
              "binding": {
                "site": {
                  "kind": "variable_declarator",
                  "has": {
                    "field": "name",
                    "kind": "identifier"
                  },
                  "all": [
                    {
                      "has": {
                        "field": "value",
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "kind": "member_expression",
                          "all": [
                            {
                              "has": {
                                "field": "property",
                                "regex": "^extend$"
                              }
                            },
                            {
                              "has": {
                                "field": "object",
                                "matches": "vitest-focusable-test-root"
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "vitest-focusable-test-root": {
            "any": [
              {
                "matches": "vitest-focusable-test-bound"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-focusable-test-root"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-focusable-test-root"
                }
              }
            ]
          },
          "vitest-focusable-test-bound": {
            "kind": "identifier",
            "any": [
              {
                "any": [
                  {
                    "resolves": {
                      "binding": {
                        "site": {
                          "kind": "import_specifier",
                          "has": {
                            "field": "name",
                            "regex": "^(?:it|test)$"
                          },
                          "inside": {
                            "kind": "import_statement",
                            "stopBy": "end",
                            "not": {
                              "regex": "^import\\s+type\\b"
                            },
                            "has": {
                              "field": "source",
                              "regex": "^[\"']vitest[\"']$"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "resolves": {
                      "binding": {
                        "occurrence": {
                          "any": [
                            {
                              "kind": "shorthand_property_identifier_pattern",
                              "regex": "^(?:it|test)$",
                              "inside": {
                                "kind": "object_pattern",
                                "inside": {
                                  "kind": "variable_declarator",
                                  "stopBy": "end",
                                  "has": {
                                    "field": "value",
                                    "any": [
                                      {
                                        "kind": "call_expression",
                                        "regex": "^require\\s*\\(\\s*[\"'`]vitest[\"'`]\\s*\\)$"
                                      },
                                      {
                                        "kind": "await_expression",
                                        "has": {
                                          "kind": "call_expression",
                                          "regex": "^import\\s*\\(\\s*[\"'`]vitest[\"'`]\\s*\\)$"
                                        }
                                      }
                                    ]
                                  }
                                }
                              }
                            },
                            {
                              "kind": "identifier",
                              "inside": {
                                "kind": "pair_pattern",
                                "field": "value",
                                "has": {
                                  "field": "key",
                                  "regex": "^[\"']?(?:it|test)[\"']?$"
                                },
                                "inside": {
                                  "kind": "object_pattern",
                                  "inside": {
                                    "kind": "variable_declarator",
                                    "stopBy": "end",
                                    "has": {
                                      "field": "value",
                                      "any": [
                                        {
                                          "kind": "call_expression",
                                          "regex": "^require\\s*\\(\\s*[\"'`]vitest[\"'`]\\s*\\)$"
                                        },
                                        {
                                          "kind": "await_expression",
                                          "has": {
                                            "kind": "call_expression",
                                            "regex": "^import\\s*\\(\\s*[\"'`]vitest[\"'`]\\s*\\)$"
                                          }
                                        }
                                      ]
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              {
                "matches": "vitest-focusable-test-extended"
              }
            ]
          },
          "vitest-focusable-head": {
            "kind": "identifier",
            "any": [
              {
                "resolves": {
                  "global": [
                    "describe",
                    "it",
                    "test"
                  ]
                }
              },
              {
                "any": [
                  {
                    "resolves": {
                      "binding": {
                        "site": {
                          "kind": "import_specifier",
                          "has": {
                            "field": "name",
                            "regex": "^(?:describe|it|test)$"
                          },
                          "inside": {
                            "kind": "import_statement",
                            "stopBy": "end",
                            "not": {
                              "regex": "^import\\s+type\\b"
                            },
                            "has": {
                              "field": "source",
                              "regex": "^[\"']vitest[\"']$"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "resolves": {
                      "binding": {
                        "occurrence": {
                          "any": [
                            {
                              "kind": "shorthand_property_identifier_pattern",
                              "regex": "^(?:describe|it|test)$",
                              "inside": {
                                "kind": "object_pattern",
                                "inside": {
                                  "kind": "variable_declarator",
                                  "stopBy": "end",
                                  "has": {
                                    "field": "value",
                                    "any": [
                                      {
                                        "kind": "call_expression",
                                        "regex": "^require\\s*\\(\\s*[\"'`]vitest[\"'`]\\s*\\)$"
                                      },
                                      {
                                        "kind": "await_expression",
                                        "has": {
                                          "kind": "call_expression",
                                          "regex": "^import\\s*\\(\\s*[\"'`]vitest[\"'`]\\s*\\)$"
                                        }
                                      }
                                    ]
                                  }
                                }
                              }
                            },
                            {
                              "kind": "identifier",
                              "inside": {
                                "kind": "pair_pattern",
                                "field": "value",
                                "has": {
                                  "field": "key",
                                  "regex": "^[\"']?(?:describe|it|test)[\"']?$"
                                },
                                "inside": {
                                  "kind": "object_pattern",
                                  "inside": {
                                    "kind": "variable_declarator",
                                    "stopBy": "end",
                                    "has": {
                                      "field": "value",
                                      "any": [
                                        {
                                          "kind": "call_expression",
                                          "regex": "^require\\s*\\(\\s*[\"'`]vitest[\"'`]\\s*\\)$"
                                        },
                                        {
                                          "kind": "await_expression",
                                          "has": {
                                            "kind": "call_expression",
                                            "regex": "^import\\s*\\(\\s*[\"'`]vitest[\"'`]\\s*\\)$"
                                          }
                                        }
                                      ]
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              {
                "matches": "vitest-focusable-test-extended"
              },
              {
                "regex": "^(?:describe|it|test)$",
                "matches": "vitest-test-context"
              }
            ]
          },
          "vitest-focusable-chain": {
            "any": [
              {
                "matches": "vitest-focusable-head"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-focusable-chain"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-focusable-chain"
                }
              }
            ]
          },
          "vitest-test-callback": {
            "any": [
              {
                "kind": "arrow_function"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              }
            ],
            "all": [
              {
                "any": [
                  {
                    "has": {
                      "field": "parameter",
                      "kind": "identifier"
                    }
                  },
                  {
                    "has": {
                      "field": "parameters",
                      "has": {
                        "any": [
                          {
                            "kind": "required_parameter"
                          },
                          {
                            "kind": "optional_parameter"
                          }
                        ],
                        "has": {
                          "field": "pattern",
                          "kind": "identifier"
                        },
                        "not": {
                          "has": {
                            "field": "value",
                            "regex": "[\\s\\S]"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "inside": {
                  "kind": "arguments",
                  "inside": {
                    "kind": "call_expression",
                    "has": {
                      "field": "function",
                      "kind": "identifier",
                      "regex": "^(?:fit|it|test|xit|xtest|bench)$"
                    }
                  }
                }
              }
            ]
          },
          "vitest-test-context": {
            "any": [
              {
                "resolves": {
                  "binding": {
                    "form": "parameter",
                    "site": {
                      "any": [
                        {
                          "inside": {
                            "kind": "formal_parameters",
                            "inside": {
                              "matches": "vitest-test-callback"
                            }
                          }
                        },
                        {
                          "kind": "identifier",
                          "inside": {
                            "field": "parameter",
                            "matches": "vitest-test-callback"
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "resolves": {
                  "binding": {
                    "form": "parameter",
                    "occurrence": {
                      "kind": "shorthand_property_identifier_pattern",
                      "any": [
                        {
                          "nthChild": {
                            "position": 1,
                            "ofRule": {
                              "any": [
                                {
                                  "kind": "pair_pattern"
                                },
                                {
                                  "kind": "shorthand_property_identifier_pattern"
                                },
                                {
                                  "kind": "object_assignment_pattern"
                                }
                              ]
                            }
                          },
                          "inside": {
                            "kind": "object_pattern",
                            "inside": {
                              "any": [
                                {
                                  "kind": "required_parameter"
                                },
                                {
                                  "kind": "optional_parameter"
                                }
                              ],
                              "nthChild": {
                                "position": 1,
                                "ofRule": {
                                  "any": [
                                    {
                                      "kind": "required_parameter"
                                    },
                                    {
                                      "kind": "optional_parameter"
                                    }
                                  ],
                                  "has": {
                                    "field": "pattern",
                                    "kind": "object_pattern"
                                  }
                                }
                              },
                              "inside": {
                                "kind": "formal_parameters",
                                "inside": {
                                  "any": [
                                    {
                                      "kind": "arrow_function"
                                    },
                                    {
                                      "kind": "function_expression"
                                    },
                                    {
                                      "kind": "generator_function"
                                    },
                                    {
                                      "kind": "method_definition"
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        },
                        {
                          "inside": {
                            "kind": "object_assignment_pattern",
                            "field": "left",
                            "nthChild": {
                              "position": 1,
                              "ofRule": {
                                "any": [
                                  {
                                    "kind": "pair_pattern"
                                  },
                                  {
                                    "kind": "shorthand_property_identifier_pattern"
                                  },
                                  {
                                    "kind": "object_assignment_pattern"
                                  }
                                ]
                              }
                            },
                            "inside": {
                              "kind": "object_pattern",
                              "inside": {
                                "any": [
                                  {
                                    "kind": "required_parameter"
                                  },
                                  {
                                    "kind": "optional_parameter"
                                  }
                                ],
                                "nthChild": {
                                  "position": 1,
                                  "ofRule": {
                                    "any": [
                                      {
                                        "kind": "required_parameter"
                                      },
                                      {
                                        "kind": "optional_parameter"
                                      }
                                    ],
                                    "has": {
                                      "field": "pattern",
                                      "kind": "object_pattern"
                                    }
                                  }
                                },
                                "inside": {
                                  "kind": "formal_parameters",
                                  "inside": {
                                    "any": [
                                      {
                                        "kind": "arrow_function"
                                      },
                                      {
                                        "kind": "function_expression"
                                      },
                                      {
                                        "kind": "generator_function"
                                      },
                                      {
                                        "kind": "method_definition"
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "only",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "call_expression",
            "has": {
              "field": "function",
              "kind": "member_expression",
              "regex": "^(?:describe|it|test|suite|bench)(?:\\.\\w+)*\\.only\\b",
              "has": {
                "field": "object",
                "matches": "vitest-focusable-chain"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "vitest/no-focused-tests",
        "message": "Remove .only: a focused test makes Vitest skip every other test.",
        "suppress": {
          "eslint": {
            "rules": [
              "vitest/no-focused-tests"
            ]
          }
        }
      }
    }
  ]
}
