{
  "format": "rerail.policy/v1",
  "id": "typescript-eslint-prefer-for-of",
  "revision": 1,
  "mode": "steer",
  "description": "Port of typescript-eslint's `prefer-for-of` rule (https://typescript-eslint.io/rules/prefer-for-of). Flags a `for` loop that declares one non-const index starting at 0, runs while the index is below an array's `length`, steps it by one, and uses the index in its body only to read elements of that same array.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "index-only-reads-the-array",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "for_statement",
            "all": [
              {
                "has": {
                  "field": "initializer",
                  "any": [{"kind": "lexical_declaration"}, {"kind": "variable_declaration"}],
                  "not": { "regex": "^const\\b" },
                  "count": { "has": {"kind": "variable_declarator"}, "max": 1 },
                  "has": {
                    "kind": "variable_declarator",
                    "all": [
                      { "has": {"field": "name", "kind": "identifier", "pattern": "$I"} },
                      { "has": {"field": "value", "matches": "zero"} }
                    ],
                    "pattern": "$DECL"
                  }
                }
              },
              { "has": {"field": "condition", "matches": "below-length"} },
              { "has": {"field": "increment", "matches": "step"} },
              { "not": {"has": {"field": "body", "stopBy": "end", "matches": "other-use"}} }
            ]
          },
          "utils": {
            "optional-chain": {
              "any": [
                { "has": {"field": "optional_chain", "kind": "optional_chain"} },
                { "has": {"field": "object", "matches": "optional-chain"} },
                { "has": {"field": "function", "matches": "optional-chain"} },
                { "kind": "non_null_expression", "has": {"matches": "optional-chain"} }
              ]
            },
            "element-read": {
              "any": [
                {
                  "inside": {
                    "field": "index",
                    "kind": "subscript_expression",
                    "has": { "field": "object", "matches": "element-object" },
                    "not": { "matches": "assignee" }
                  }
                },
                { "inside": {"kind": "parenthesized_expression", "matches": "element-read"} }
              ]
            },
            "assignee": {
              "any": [
                {
                  "inside": { "field": "left", "any": [{"kind": "assignment_expression"}, {"kind": "augmented_assignment_expression"}] }
                },
                { "inside": {"any": [{"kind": "update_expression"}, {"kind": "array_pattern"}, {"kind": "rest_pattern"}]} },
                { "inside": {"kind": "unary_expression", "regex": "^delete\\b"} },
                { "inside": {"field": "value", "kind": "pair", "inside": {"kind": "object", "matches": "assignee"}} },
                {
                  "inside": {
                    "any": [
                      { "kind": "parenthesized_expression" },
                      { "kind": "non_null_expression" },
                      { "kind": "as_expression" },
                      { "kind": "type_assertion" },
                      { "kind": "satisfies_expression" }
                    ],
                    "matches": "assignee"
                  }
                }
              ]
            },
            "zero": { "any": [{"kind": "number", "value": {"eq": 0}}, {"kind": "parenthesized_expression", "has": {"matches": "zero"}}] },
            "one": { "any": [{"kind": "number", "value": {"eq": 1}}, {"kind": "parenthesized_expression", "has": {"matches": "one"}}] },
            "index": { "any": [{"pattern": "$I"}, {"kind": "parenthesized_expression", "has": {"matches": "index"}}] },
            "below-length": {
              "any": [
                {
                  "kind": "binary_expression",
                  "all": [
                    { "has": {"field": "operator", "regex": "^<$"} },
                    { "has": {"field": "left", "matches": "index"} },
                    { "has": {"field": "right", "matches": "length"} }
                  ]
                },
                { "kind": "parenthesized_expression", "has": {"matches": "below-length"} }
              ]
            },
            "length": {
              "any": [
                {
                  "any": [
                    { "kind": "member_expression", "has": {"field": "property", "regex": "^length$"} },
                    { "kind": "subscript_expression", "has": {"field": "index", "kind": "identifier", "regex": "^length$"} }
                  ],
                  "all": [{"not": {"matches": "optional-chain"}}, {"has": {"field": "object", "matches": "array"}}]
                },
                { "kind": "parenthesized_expression", "has": {"matches": "length"} }
              ]
            },
            "array": {
              "any": [
                { "not": {"any": [{"kind": "parenthesized_expression"}, {"kind": "comment"}]}, "pattern": "$ARR" },
                { "kind": "parenthesized_expression", "has": {"matches": "array"} }
              ]
            },
            "step": {
              "any": [
                {
                  "kind": "update_expression",
                  "all": [{"has": {"field": "operator", "regex": "^\\+\\+$"}}, {"has": {"field": "argument", "matches": "index"}}]
                },
                {
                  "kind": "augmented_assignment_expression",
                  "all": [
                    { "has": {"field": "operator", "regex": "^\\+=$"} },
                    { "has": {"field": "left", "matches": "index"} },
                    { "has": {"field": "right", "matches": "one"} }
                  ]
                },
                {
                  "kind": "assignment_expression",
                  "all": [{"has": {"field": "left", "matches": "index"}}, {"has": {"field": "right", "matches": "index-plus-one"}}]
                },
                { "kind": "parenthesized_expression", "has": {"matches": "step"} }
              ]
            },
            "index-plus-one": {
              "any": [
                {
                  "kind": "binary_expression",
                  "all": [
                    { "has": {"field": "operator", "regex": "^\\+$"} },
                    {
                      "any": [
                        { "all": [{"has": {"field": "left", "matches": "index"}}, {"has": {"field": "right", "matches": "one"}}] },
                        { "all": [{"has": {"field": "left", "matches": "one"}}, {"has": {"field": "right", "matches": "index"}}] }
                      ]
                    }
                  ]
                },
                { "kind": "parenthesized_expression", "has": {"matches": "index-plus-one"} }
              ]
            },
            "index-name": {
              "any": [
                { "kind": "identifier" },
                { "kind": "shorthand_property_identifier" },
                { "kind": "shorthand_property_identifier_pattern" }
              ],
              "pattern": "$I"
            },
            "other-use": {
              "any": [
                {
                  "matches": "index-name",
                  "resolves": { "binding": {"occurrence": {"matches": "loop-index-name"}} },
                  "all": [
                    { "not": {"matches": "element-read"} },
                    { "not": {"inside": {"kind": "nested_type_identifier", "stopBy": "end"}} }
                  ]
                },
                {
                  "matches": "index-name",
                  "binds": { "occurrence": {"matches": "loop-index-name"} },
                  "inside": {
                    "stopBy": {
                      "not": {
                        "any": [
                          { "kind": "array_pattern" },
                          { "kind": "object_pattern" },
                          { "kind": "pair_pattern" },
                          { "kind": "assignment_pattern" },
                          { "kind": "object_assignment_pattern" },
                          { "kind": "rest_pattern" }
                        ]
                      }
                    },
                    "any": [
                      { "kind": "variable_declarator", "has": {"field": "value", "pattern": "$VALUE"} },
                      { "kind": "for_in_statement" }
                    ]
                  }
                }
              ]
            },
            "element-object": {
              "any": [
                {
                  "not": { "any": [{"kind": "parenthesized_expression"}, {"kind": "this"}] },
                  "pattern": "$OBJ",
                  "compare": { "left": "OBJ", "op": "eq", "right": "ARR" }
                },
                { "kind": "parenthesized_expression", "has": {"matches": "element-object"} }
              ]
            },
            "loop-index-name": {
              "inside": {
                "field": "name",
                "kind": "variable_declarator",
                "pattern": "$SAME",
                "compare": { "left": "SAME", "op": "eq", "right": "DECL", "text": "node" }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/prefer-for-of",
        "message": "Expected a `for-of` loop instead of a `for` loop with this simple iteration.",
        "suppress": { "eslint": {"rules": ["@typescript-eslint/prefer-for-of"]} }
      }
    }
  ]
}
