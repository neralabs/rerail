{
  "format": "rerail.policy/v1",
  "id": "vitest-expect-expect",
  "revision": 2,
  "mode": "steer",
  "description": "A test whose function never calls `expect` or `assert`.",
  "scope": {
    "include": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.test.mts",
      "**/*.spec.mts",
      "**/__tests__/**/*.ts",
      "**/__tests__/**/*.tsx"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "vitest-functions",
      "define": {
        "language": "typescript",
        "utils": {
          "vitest-it-test-extended": {
            "resolves": {
              "binding": {
                "site": {
                  "kind": "variable_declarator",
                  "all": [
                    {
                      "has": {
                        "field": "name",
                        "kind": "identifier"
                      }
                    },
                    {
                      "has": {
                        "field": "value",
                        "matches": "vitest-it-test-extend-call"
                      }
                    }
                  ]
                }
              }
            }
          },
          "vitest-it-test-extend-call": {
            "any": [
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-it-test-extend-member"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-it-test-extend-call"
                }
              }
            ]
          },
          "vitest-it-test-extend-member": {
            "any": [
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "property",
                      "regex": "^extend$"
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "matches": "vitest-it-test-root"
                    }
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-it-test-extend-member"
                }
              }
            ]
          },
          "vitest-it-test-root": {
            "any": [
              {
                "matches": "vitest-it-test-bound"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-it-test-root"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-it-test-root"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-it-test-root"
                }
              }
            ]
          },
          "vitest-it-test-bound": {
            "kind": "identifier",
            "any": [
              {
                "resolves": {
                  "import": [
                    "vitest.it",
                    "vitest.test"
                  ]
                }
              },
              {
                "matches": "vitest-it-test-extended"
              }
            ]
          },
          "vitest-it-test-named": {
            "kind": "identifier",
            "any": [
              {
                "resolves": {
                  "global": [
                    "it",
                    "test"
                  ],
                  "import": [
                    "vitest.it",
                    "vitest.test"
                  ]
                }
              },
              {
                "matches": "vitest-it-test-extended"
              }
            ]
          },
          "vitest-it-test-callee": {
            "any": [
              {
                "matches": "vitest-it-test-named"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-it-test-callee"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-it-test-callee"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-it-test-callee"
                }
              }
            ]
          },
          "vitest-bench-extended": {
            "resolves": {
              "binding": {
                "site": {
                  "kind": "variable_declarator",
                  "all": [
                    {
                      "has": {
                        "field": "name",
                        "kind": "identifier"
                      }
                    },
                    {
                      "has": {
                        "field": "value",
                        "matches": "vitest-bench-extend-call"
                      }
                    }
                  ]
                }
              }
            }
          },
          "vitest-bench-extend-call": {
            "any": [
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-bench-extend-member"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-bench-extend-call"
                }
              }
            ]
          },
          "vitest-bench-extend-member": {
            "any": [
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "property",
                      "regex": "^extend$"
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "matches": "vitest-bench-root"
                    }
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-bench-extend-member"
                }
              }
            ]
          },
          "vitest-bench-root": {
            "any": [
              {
                "matches": "vitest-bench-bound"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-bench-root"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-bench-root"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-bench-root"
                }
              }
            ]
          },
          "vitest-bench-bound": {
            "kind": "identifier",
            "any": [
              {
                "resolves": {
                  "import": [
                    "vitest.bench"
                  ]
                }
              },
              {
                "matches": "vitest-bench-extended"
              }
            ]
          },
          "vitest-bench-named": {
            "kind": "identifier",
            "any": [
              {
                "resolves": {
                  "global": [
                    "bench"
                  ],
                  "import": [
                    "vitest.bench"
                  ]
                }
              },
              {
                "matches": "vitest-bench-extended"
              }
            ]
          },
          "vitest-bench-callee": {
            "any": [
              {
                "matches": "vitest-bench-named"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-bench-callee"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-bench-callee"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-bench-callee"
                }
              }
            ]
          },
          "vitest-xit-xtest-extended": {
            "resolves": {
              "binding": {
                "site": {
                  "kind": "variable_declarator",
                  "all": [
                    {
                      "has": {
