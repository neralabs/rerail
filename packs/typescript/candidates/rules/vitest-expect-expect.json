                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-xit-xtest-extend-call"
                }
              }
            ]
          },
          "vitest-xit-xtest-extend-member": {
            "any": [
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
