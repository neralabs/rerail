                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-xit-xtest-extend-member"
                }
              }
            ]
          },
          "vitest-xit-xtest-root": {
            "any": [
              {
                "matches": "vitest-xit-xtest-bound"
