                }
              }
            ]
          },
          "vitest-assertion-name": {
            "kind": "identifier",
            "regex": "(?i)^(?:expect|assert)$"
          },
          "vitest-assertion-callee": {
            "any": [
              {
                "matches": "vitest-assertion-name"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-assertion-callee"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-assertion-callee"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-assertion-callee"
                }
              },
              {
                "kind": "subscript_expression",
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "matches": "vitest-assertion-callee"
                    }
                  },
                  {
                    "has": {
                      "field": "index",
                      "any": [
                        {
                          "kind": "string"
                        },
                        {
                          "kind": "template_string"
                        },
                        {
                          "kind": "identifier"
                        }
                      ]
                    }
                  }
                ]
