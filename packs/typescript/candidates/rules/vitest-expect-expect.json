            ]
          },
          "vitest-fit-callee": {
            "any": [
              {
                "matches": "vitest-fit-named"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-fit-callee"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-fit-callee"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-fit-callee"
                }
              }
            ]
          },
          "vitest-bench-fit-it-test-xit-xtest-context": {
            "kind": "identifier",
            "regex": "^(?:fit|it|test|xit|xtest|bench)$",
            "matches": "vitest-test-context"
          },
          "vitest-bench-fit-it-test-xit-xtest-context-callee": {
            "any": [
              {
                "matches": "vitest-bench-fit-it-test-xit-xtest-context"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-bench-fit-it-test-xit-xtest-context-callee"
                }
              },
