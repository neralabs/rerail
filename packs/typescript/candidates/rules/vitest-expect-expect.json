{
  "format": "rerail.policy/v1",
  "id": "vitest-expect-expect",
  "revision": 2,
  "mode": "steer",
  "description": "A test whose function never calls `expect` or `assert`.",
  "scope": {
    "include": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.test.mts",
      "**/*.spec.mts",
      "**/__tests__/**/*.ts",
      "**/__tests__/**/*.tsx"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "vitest-functions",
      "define": {
        "language": "typescript",
        "utils": {
          "vitest-test-extended": {
            "resolves": {
              "binding": {
                "site": {
                  "kind": "variable_declarator",
                  "all": [
                    {
                      "has": {
                        "field": "name",
                        "kind": "identifier"
                      }
                    },
                    {
                      "has": {
                        "field": "value",
                        "matches": "vitest-test-extend-call"
                      }
                    }
                  ]
                }
              }
            }
          },
          "vitest-test-extend-call": {
            "any": [
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-test-extend-member"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-test-extend-call"
                }
              }
            ]
          },
          "vitest-test-extend-member": {
            "any": [
              {
                "kind": "member_expression",
                "all": [
                  {
                    "has": {
                      "field": "property",
                      "regex": "^extend$"
                    }
                  },
                  {
                    "has": {
                      "field": "object",
                      "matches": "vitest-test-root"
                    }
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-test-extend-member"
                }
              }
            ]
          },
          "vitest-test-root": {
            "any": [
              {
                "matches": "vitest-test-bound"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-test-root"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-test-root"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-test-root"
                }
              }
            ]
          },
          "vitest-test-bound": {
            "kind": "identifier",
            "any": [
              {
                "any": [
                  {
                    "resolves": {
                      "binding": {
                        "site": {
                          "kind": "import_specifier",
                          "has": {
                            "field": "name",
                            "regex": "^(?:fit|it|test|xit|xtest|bench)$"
                          },
                          "inside": {
                            "kind": "import_statement",
                            "stopBy": "end",
                            "not": {
                              "regex": "^import\\s+type\\b"
                            },
                            "has": {
                              "field": "source",
                              "matches": "vitest-source"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "resolves": {
                      "binding": {
                        "occurrence": {
                          "any": [
                            {
                              "kind": "shorthand_property_identifier_pattern",
                              "regex": "^(?:fit|it|test|xit|xtest|bench)$",
                              "inside": {
                                "kind": "object_pattern",
                                "inside": {
                                  "kind": "variable_declarator",
                                  "stopBy": "end",
                                  "has": {
                                    "field": "value",
                                    "matches": "vitest-module"
                                  }
                                }
                              }
                            },
                            {
                              "kind": "identifier",
                              "inside": {
                                "kind": "pair_pattern",
                                "field": "value",
                                "has": {
                                  "field": "key",
                                  "regex": "^[\"']?(?:fit|it|test|xit|xtest|bench)[\"']?$"
                                },
                                "inside": {
                                  "kind": "object_pattern",
                                  "inside": {
                                    "kind": "variable_declarator",
                                    "stopBy": "end",
                                    "has": {
                                      "field": "value",
                                      "matches": "vitest-module"
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              {
                "matches": "vitest-test-extended"
              }
            ]
          },
          "vitest-test-head": {
            "kind": "identifier",
            "any": [
              {
                "resolves": {
                  "global": [
                    "fit",
                    "it",
                    "test",
                    "xit",
                    "xtest",
                    "bench"
                  ]
                }
              },
              {
                "any": [
                  {
                    "resolves": {
                      "binding": {
                        "site": {
                          "kind": "import_specifier",
                          "has": {
                            "field": "name",
                            "regex": "^(?:fit|it|test|xit|xtest|bench)$"
                          },
                          "inside": {
                            "kind": "import_statement",
                            "stopBy": "end",
                            "not": {
                              "regex": "^import\\s+type\\b"
                            },
                            "has": {
                              "field": "source",
                              "matches": "vitest-source"
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "resolves": {
                      "binding": {
                        "occurrence": {
                          "any": [
                            {
                              "kind": "shorthand_property_identifier_pattern",
                              "regex": "^(?:fit|it|test|xit|xtest|bench)$",
                              "inside": {
                                "kind": "object_pattern",
                                "inside": {
                                  "kind": "variable_declarator",
                                  "stopBy": "end",
                                  "has": {
                                    "field": "value",
                                    "matches": "vitest-module"
                                  }
                                }
                              }
                            },
                            {
                              "kind": "identifier",
                              "inside": {
                                "kind": "pair_pattern",
                                "field": "value",
                                "has": {
                                  "field": "key",
                                  "regex": "^[\"']?(?:fit|it|test|xit|xtest|bench)[\"']?$"
                                },
                                "inside": {
                                  "kind": "object_pattern",
                                  "inside": {
                                    "kind": "variable_declarator",
                                    "stopBy": "end",
                                    "has": {
                                      "field": "value",
                                      "matches": "vitest-module"
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              {
                "matches": "vitest-test-extended"
              },
              {
                "regex": "^(?:fit|it|test|xit|xtest|bench)$",
                "matches": "vitest-test-context"
              }
            ]
          },
          "vitest-test-chain": {
            "any": [
              {
                "matches": "vitest-test-head"
              },
              {
                "kind": "member_expression",
                "has": {
                  "field": "object",
                  "matches": "vitest-test-chain"
                }
              },
              {
                "kind": "call_expression",
                "has": {
                  "field": "function",
                  "matches": "vitest-test-chain"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-test-chain"
                }
              }
            ]
          },
          "vitest-context-pair": {
            "kind": "pair_pattern",
            "nthChild": {
              "position": 1,
              "ofRule": {
                "any": [
                  {
                    "kind": "pair_pattern"
                  },
                  {
                    "kind": "shorthand_property_identifier_pattern"
                  },
                  {
                    "kind": "object_assignment_pattern"
                  }
                ]
              }
            },
            "inside": {
              "kind": "object_pattern",
              "inside": {
                "any": [
                  {
                    "kind": "required_parameter"
                  },
                  {
                    "kind": "optional_parameter"
                  }
                ],
                "nthChild": {
                  "position": 1,
                  "ofRule": {
                    "any": [
                      {
                        "kind": "required_parameter"
                      },
                      {
                        "kind": "optional_parameter"
                      }
                    ],
                    "has": {
                      "field": "pattern",
                      "kind": "object_pattern"
                    }
                  }
                },
                "inside": {
                  "kind": "formal_parameters",
                  "inside": {
                    "any": [
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "function_expression"
                      },
                      {
                        "kind": "generator_function"
                      },
                      {
                        "kind": "method_definition"
                      }
                    ]
                  }
                }
              }
            },
            "has": {
              "field": "key",
              "kind": "property_identifier",
              "pattern": "$CONTEXT_NAME"
            }
          },
          "vitest-test-callback": {
            "any": [
              {
                "kind": "arrow_function"
              },
              {
                "kind": "function_expression"
              },
              {
                "kind": "generator_function"
              }
            ],
            "all": [
              {
                "any": [
                  {
                    "has": {
                      "field": "parameter",
                      "kind": "identifier"
                    }
                  },
                  {
                    "has": {
                      "field": "parameters",
                      "has": {
                        "any": [
                          {
                            "kind": "required_parameter"
                          },
                          {
                            "kind": "optional_parameter"
                          }
                        ],
                        "has": {
                          "field": "pattern",
                          "kind": "identifier"
                        },
                        "not": {
                          "has": {
                            "field": "value",
                            "regex": "[\\s\\S]"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "inside": {
                  "kind": "arguments",
                  "inside": {
                    "kind": "call_expression",
                    "has": {
                      "field": "function",
                      "kind": "identifier",
                      "regex": "^(?:fit|it|test|xit|xtest|bench)$"
                    }
                  }
                }
              }
            ]
          },
          "vitest-test-context": {
            "any": [
              {
                "resolves": {
                  "binding": {
                    "form": "parameter",
                    "site": {
                      "any": [
                        {
                          "inside": {
                            "kind": "formal_parameters",
                            "inside": {
                              "matches": "vitest-test-callback"
                            }
                          }
                        },
                        {
                          "kind": "identifier",
                          "inside": {
                            "field": "parameter",
                            "matches": "vitest-test-callback"
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "resolves": {
                  "binding": {
                    "form": "parameter",
                    "occurrence": {
                      "any": [
                        {
                          "kind": "shorthand_property_identifier_pattern",
                          "any": [
                            {
                              "nthChild": {
                                "position": 1,
                                "ofRule": {
                                  "any": [
                                    {
                                      "kind": "pair_pattern"
                                    },
                                    {
                                      "kind": "shorthand_property_identifier_pattern"
                                    },
                                    {
                                      "kind": "object_assignment_pattern"
                                    }
                                  ]
                                }
                              },
                              "inside": {
                                "kind": "object_pattern",
                                "inside": {
                                  "any": [
                                    {
                                      "kind": "required_parameter"
                                    },
                                    {
                                      "kind": "optional_parameter"
                                    }
                                  ],
                                  "nthChild": {
                                    "position": 1,
                                    "ofRule": {
                                      "any": [
                                        {
                                          "kind": "required_parameter"
                                        },
                                        {
                                          "kind": "optional_parameter"
                                        }
                                      ],
                                      "has": {
                                        "field": "pattern",
                                        "kind": "object_pattern"
                                      }
                                    }
                                  },
                                  "inside": {
                                    "kind": "formal_parameters",
                                    "inside": {
                                      "any": [
                                        {
                                          "kind": "arrow_function"
                                        },
                                        {
                                          "kind": "function_expression"
                                        },
                                        {
                                          "kind": "generator_function"
                                        },
                                        {
                                          "kind": "method_definition"
                                        }
                                      ]
                                    }
                                  }
                                }
                              }
                            },
                            {
                              "inside": {
                                "kind": "object_assignment_pattern",
                                "field": "left",
                                "nthChild": {
                                  "position": 1,
                                  "ofRule": {
                                    "any": [
                                      {
                                        "kind": "pair_pattern"
                                      },
                                      {
                                        "kind": "shorthand_property_identifier_pattern"
                                      },
                                      {
                                        "kind": "object_assignment_pattern"
                                      }
                                    ]
                                  }
                                },
                                "inside": {
                                  "kind": "object_pattern",
                                  "inside": {
                                    "any": [
                                      {
                                        "kind": "required_parameter"
                                      },
                                      {
                                        "kind": "optional_parameter"
                                      }
                                    ],
                                    "nthChild": {
                                      "position": 1,
                                      "ofRule": {
                                        "any": [
                                          {
                                            "kind": "required_parameter"
                                          },
                                          {
                                            "kind": "optional_parameter"
                                          }
                                        ],
                                        "has": {
                                          "field": "pattern",
                                          "kind": "object_pattern"
                                        }
                                      }
                                    },
                                    "inside": {
                                      "kind": "formal_parameters",
                                      "inside": {
                                        "any": [
                                          {
                                            "kind": "arrow_function"
                                          },
                                          {
                                            "kind": "function_expression"
                                          },
                                          {
                                            "kind": "generator_function"
                                          },
                                          {
                                            "kind": "method_definition"
                                          }
                                        ]
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "kind": "identifier",
                          "pattern": "$CONTEXT_NAME",
                          "any": [
                            {
                              "inside": {
                                "field": "value",
                                "matches": "vitest-context-pair"
                              }
                            },
                            {
                              "inside": {
                                "kind": "assignment_pattern",
                                "field": "left",
                                "inside": {
                                  "field": "value",
                                  "matches": "vitest-context-pair"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "vitest-source": {
            "any": [
              {
                "kind": "string"
              },
              {
                "kind": "template_string"
              }
            ],
            "value": {
              "eq": "vitest"
            }
          },
          "vitest-module-argument": {
            "kind": "arguments",
            "has": {
              "nthChild": {
                "position": 1,
                "ofRule": {
                  "not": {
                    "kind": "comment"
                  }
                }
              },
              "matches": "vitest-source"
            }
          },
          "vitest-module": {
            "any": [
              {
                "kind": "call_expression",
                "all": [
                  {
                    "has": {
                      "field": "function",
                      "kind": "identifier",
                      "regex": "^require$"
                    }
                  },
                  {
                    "has": {
                      "field": "arguments",
                      "matches": "vitest-module-argument"
                    }
                  }
                ]
              },
              {
                "kind": "await_expression",
                "has": {
                  "matches": "vitest-dynamic-import"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-module"
                }
              }
            ]
          },
          "vitest-dynamic-import": {
            "any": [
              {
                "kind": "call_expression",
                "all": [
                  {
                    "has": {
                      "field": "function",
                      "kind": "import"
                    }
                  },
                  {
                    "has": {
                      "field": "arguments",
                      "matches": "vitest-module-argument"
                    }
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "matches": "vitest-dynamic-import"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "no-assertion",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "call_expression",
            "all": [
              {
                "has": {
                  "field": "function",
                  "regex": "^(?:it|test)(?:\\.(?:only|concurrent|sequential|fails|each\\([^)]*\\)))*$",
                  "any": [
                    {
                      "matches": "vitest-test-head"
                    },
                    {
                      "has": {
                        "field": "object",
                        "matches": "vitest-test-chain"
                      }
                    },
                    {
                      "has": {
                        "field": "function",
                        "matches": "vitest-test-chain"
                      }
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "any": [
                      {
                        "kind": "arrow_function"
                      },
                      {
                        "kind": "function_expression"
                      }
                    ],
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "call_expression",
                        "has": {
                          "field": "function",
                          "regex": "^(?:expect|assert)\\b"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "vitest/expect-expect",
        "message": "This test asserts nothing, so it passes whatever the code does. Add an expect.",
        "suppress": {
          "eslint": {
            "rules": [
              "vitest/expect-expect"
            ]
          }
        }
      }
    }
  ]
}
