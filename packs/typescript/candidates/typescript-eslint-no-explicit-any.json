{
  "format": "tempo.policy/v1",
  "id": "typescript-eslint:no-explicit-any",
  "revision": 2,
  "description": "Port of typescript-eslint's `no-explicit-any` rule (https://typescript-eslint.io/rules/no-explicit-any). Flags every `any` type (default options: no fix; the rule only suggests). Options are declared in the `options` define (the rule's defaults); a variant is a config patch.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.d.ts"
    ]
  },
  "checks": [
    {
      "id": "options",
      "define": {
        "options": {
          "ignoreRestArgs": {
            "type": "boolean",
            "nullable": true,
            "default": null
          },
          "fixToUnknown": {
            "type": "boolean",
            "nullable": true,
            "default": null
          }
        }
      }
    },
    {
      "id": "shared",
      "define": {
        "language": "typescript",
        "utils": {
          "r1": {
            "not": {
              "inside": {
                "any": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "r2"
                    }
                  },
                  {
                    "inside": {
                      "any": [
                        {
                          "kind": "readonly_type"
                        },
                        {
                          "has": {
                            "kind": "type_identifier",
                            "regex": "^(Array|ReadonlyArray)$",
                            "stopBy": "neighbor"
                          },
                          "kind": "generic_type"
                        }
                      ],
                      "inside": {
                        "stopBy": "neighbor",
                        "matches": "r2"
                      },
                      "stopBy": "neighbor"
                    }
                  }
                ],
                "stopBy": "neighbor"
              }
            }
          },
          "r2": {
            "inside": {
              "any": [
                {
                  "kind": "required_parameter"
                },
                {
                  "kind": "optional_parameter"
                }
              ],
              "has": {
                "kind": "rest_pattern",
                "stopBy": "neighbor"
              },
              "stopBy": "neighbor"
            },
            "kind": "type_annotation"
          },
          "r3": {
            "has": {
              "regex": "^keyof$",
              "stopBy": "neighbor"
            },
            "kind": "index_type_query"
          }
        }
      }
    },
    {
      "id": "keyof-any",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "matches": "r3"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "pattern": "$A",
                  "all": [
                    {
                      "kind": "predefined_type",
                      "regex": "^any$"
                    },
                    {
                      "$option": "ignoreRestArgs",
                      "cases": {
                        "true": [
                          {
                            "matches": "r1"
                          }
                        ]
                      },
                      "default": [],
                      "spread": true
                    }
                  ]
                }
              }
            ]
          },
          "when": {
            "option": {
              "fixToUnknown": true
            }
          }
        }
      },
      "finding": {
        "anchor": "capture.A",
        "code": "@typescript-eslint/no-explicit-any",
        "severity": "error",
        "message": "Unexpected any. Specify a different type.",
        "fix": "PropertyKey",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-explicit-any"
            ]
          }
        }
      }
    },
    {
      "id": "rest-any",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "predefined_type",
                "regex": "^any$"
              },
              {
                "$option": "ignoreRestArgs",
                "cases": {
                  "true": [
                    {
                      "matches": "r1"
                    }
                  ]
                },
                "default": [],
                "spread": true
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "matches": "r2"
                }
              }
            ]
          },
          "when": {
            "option": {
              "fixToUnknown": true
            }
          }
        }
      },
      "finding": {
        "anchor": "witness.span",
        "code": "@typescript-eslint/no-explicit-any",
        "severity": "error",
        "message": "Unexpected any. Specify a different type.",
        "fix": "unknown[]",
        "suppress": {
          "eslint": {
            "rules": [
              "@typescript-eslint/no-explicit-any"
            ]
          }
        }
      }
    },
    {
      "id": "explicit-any",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "predefined_type",
                "regex": "^any$"
              },
              {
                "$option": "ignoreRestArgs",
                "cases": {
                  "true": [
                    {
                      "matches": "r1"
                    }
                  ]
                },
                "default": [],
                "spread": true
              },
              {
                "$option": "fixToUnknown",
                "cases": {
                  "true": [
                    {
                      "not": {
                        "inside": {
                          "stopBy": "neighbor",
                          "matches": "r2"
                        }
                      }
                    }
                  ]
                },
                "default": [],
                "spread": true
              },
              {
                "$option": "fixToUnknown",
                "cases": {
                  "true": [
                    {
                      "not": {
                        "inside": {
                          "stopBy": "neighbor",
                          "matches": "r3"
                        }
                      }
                    }
                  ]
                },
                "default": [],
                "spread": true
              }
            ]
          }
        }
      },
      "finding": {
        "$option": "fixToUnknown",
        "cases": {
          "true": {
            "anchor": "witness.span",
            "code": "@typescript-eslint/no-explicit-any",
            "severity": "error",
            "message": "Unexpected any. Specify a different type.",
            "fix": "unknown",
            "suppress": {
              "eslint": {
                "rules": [
                  "@typescript-eslint/no-explicit-any"
                ]
              }
            }
          }
        },
        "default": {
          "anchor": "witness.span",
          "code": "@typescript-eslint/no-explicit-any",
          "severity": "error",
          "message": "Unexpected any. Specify a different type.",
          "suppress": {
            "eslint": {
              "rules": [
                "@typescript-eslint/no-explicit-any"
              ]
            }
          }
        }
      }
    }
  ]
}
