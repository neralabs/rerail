{
  "pack": "typescript",
  "family": "ecma",
  "capabilities": [
    "syntax",
    "value",
    "compare",
    "scope",
    "suppression"
  ],
  "corpora": [
    {
      "name": "vscode",
      "repository": "https://github.com/microsoft/vscode",
      "commit": "729f257fa411ea4b1cbdb7f404aa79941182209b",
      "paths": [
        "src"
      ],
      "exclude": []
    }
  ],
  "tools": [
    {
      "name": "typescript-eslint",
      "version": "8.70.1"
    }
  ],
  "rules": [
    {
      "id": "typescript-eslint-ban-tslint-comment",
      "upstream": {
        "tool": "typescript-eslint",
        "rule": "@typescript-eslint/ban-tslint-comment"
      },
      "policy": "rules/typescript-eslint-ban-tslint-comment.json",
      "capabilities": [
        "syntax"
      ],
      "match": "line+column"
    },
    {
      "id": "typescript-eslint-consistent-type-definitions",
      "upstream": {
        "tool": "typescript-eslint",
        "rule": "@typescript-eslint/consistent-type-definitions"
