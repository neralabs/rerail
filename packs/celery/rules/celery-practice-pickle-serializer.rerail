.policy "celery-practice-pickle-serializer" revision 1
.description "Keep Celery off pickle for task messages and results; a worker that accepts pickle runs code from any message on the broker."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. A worker that accepts pickle unpickles whatever a message on the broker holds, so
// anyone who can write to the broker (a shared Redis, a leaked URL) runs code in every worker that takes the message.
// Celery 4.0 made JSON the default for that reason, and its security guide says to keep pickle out of
// accept_content (https://docs.celeryq.dev/en/stable/userguide/security.html#serializers).
// Reported, at the value that names pickle ("pickle" or its MIME type "application/x-python-serialize", a list, tuple
// or set holding one, or a module constant of the same file holding either):
//   - the settings task_serializer, result_serializer, event_serializer set to it, and accept_content or
//     result_accept_content holding it, in every spelling lib/celery's cel_setting reads: `app.conf.x = v`,
//     `app.conf["x"] = v`, `app.conf.update(x=v)` or `({"x": v})`, `Celery(..., x=v)`, Django's `CELERY_X = v`, and
//     bare keys in a class or module named for Celery (`class CeleryConfig:`, celeryconfig.py);
//   - a task's own `serializer=` option (`@app.task(serializer="pickle")`, `@shared_task(...)`), and
//     `serializer = "pickle"` in the body of a class deriving from celery's Task;
//   - a send's `serializer=` option: `t.apply_async(..., serializer="pickle")`, `app.send_task(..., serializer=...)`.
//   app.conf.accept_content = ["json", "pickle"]          reported, at "pickle"
//   CELERY_TASK_SERIALIZER = PICKLE   (PICKLE = "pickle")  reported, at PICKLE
//   app.conf.task_serializer = "json"                     not reported
// Left alone: other serializer names, among them a custom signed one (`"signed-pickle"`,
// `"application/x-signed-pickle"`, paperless-ngx's HMAC-signed serializer); json, msgpack and yaml; every run that
// calls `app.setup_security(...)` outside tests (message signing: only signed messages are accepted); test code and
// test settings files (cel_test_doc, and settings files named `test*.py` or `*_test*.py`); a bare `task_serializer =`
// outside a class or module named for Celery; `serializer="pickle"` on calls other than a Celery task's apply_async
// and send_task (cache clients, a multiprocessing pool's apply_async, other libraries).
// Gaps: values read from the environment or another module's constant; a serializer registered under another name
// that wraps pickle (kombu's register()); `options={"serializer": ...}`, `.set(serializer=...)` on a signature, a
// config dict passed to config_from_object, and `app.conf.update(**{...})`.

#include "lib/celery.rerail"

.violation PickleSerializer(at: node, k: symbol) "`{k}` enables pickle, so anyone who can write to the broker runs code in the worker. Use json; if pickle must stay, sign messages with `app.setup_security()`."
// Each finding is stated in its own file (ps_found), with what its task or app needs of other files (lib/celery's
// needs); message signing is a fact of the whole run (ps_signed: cross_file).
PickleSerializer(at, k) :- ps_found(at, k, nq, nk), cel_is(nq, nk), !ps_signed().
.decl ps_found(at: node, k: symbol, nq: symbol, nk: symbol)
// Settings that name one serializer.
ps_found(at, k, "", "") :- cel_setting(k, v, s), ps_one_key(k), ps_pickle(v, at), ps_live(s).
// Settings that list accepted content types.
ps_found(at, k, "", "") :- cel_setting(k, v, s), ps_many_key(k), ps_pickle_list(v, at), ps_live(s).
// A task's own option.
ps_found(at, "serializer", nq, nk) :- cel_task_option(f, "serializer", v, nq, nk), ps_pickle(v, at), ps_live(f).
// A Task subclass's class attribute.
ps_found(at, "serializer", "", "") :- ps_task_class(c), field(c, "body", b), body_stmt(b, st, _),
    kind(st, "expression_statement"), child(st, a, 0), kind(a, "assignment"), field(a, "left", l), text(l, "serializer"),
    field(a, "right", v), ps_pickle(v, at), ps_live(a).
// A send's execution option: `apply_async` on a Celery task (lib/celery's cel_send) or any `send_task`.
ps_found(at, "serializer", nq, nk) :- cel_send(c, _, nq, nk), call_arg(c, -1, "serializer", v), ps_pickle(v, at),
    ps_live(c).

.decl ps_one_key(k: symbol)
ps_one_key("task_serializer"). ps_one_key("result_serializer"). ps_one_key("event_serializer").
.decl ps_many_key(k: symbol)
ps_many_key("accept_content"). ps_many_key("result_accept_content").
// ps_pickle_name(s): the names kombu registers pickle under.
.decl ps_pickle_name(s: symbol)
ps_pickle_name("pickle"). ps_pickle_name("application/x-python-serialize").
// ps_pickle(e, at): e names pickle, a literal or a file-local constant; at is e.
.decl ps_pickle(e: node, at: node)
ps_pickle(e, e) :- unparen(e, u), str(u, s), ps_pickle_name(s).
ps_pickle(e, e) :- unparen(e, u), kind(u, "identifier"), static_value(u, s), ps_pickle_name(s).
// ps_pickle_list(e, at): e is a list, tuple or set holding pickle (at is that element), or a module constant of the
// same file bound to one (at is e).
.decl ps_pickle_list(e: node, at: node)
ps_pickle_list(e, at) :- unparen(e, u), (kind(u, "list") ; kind(u, "tuple") ; kind(u, "set")), child(u, x, _),
    ps_pickle(x, at).
ps_pickle_list(e, e) :- unparen(e, u), kind(u, "identifier"), text(u, x), look(u, x, m), kind(m, "module"),
    asg(m, x, v, _), ps_pickle_list(v, _).
// ps_task_class(c): c derives from celery's Task, through the run's classes (py_names' ancestors, python/names'
// class_anc).
.decl ps_task_class_q(q: symbol)
ps_task_class_q("celery.Task"). ps_task_class_q("celery.app.task.Task").
.decl ps_task_class(c: node)
ps_task_class(c) :- kind(c, "class_definition"), class_base(c, b), ps_task_class_q(b).
ps_task_class(c) :- kind(c, "class_definition"), class_anc(c, b), ps_task_class_q(b).
// ps_live(n): n is in code the rule reads: no test file, no test settings file.
.decl ps_live(n: node)
ps_live(n) :- docof(n, d), !cel_test_doc(d), !ps_test_settings(d).
.decl ps_test_settings(d: number)
ps_test_settings(d) :- file_name(d, s), (glob("test*.py", s) ; glob("*_test*.py", s)).
// ps_signed(): the run calls `<app>.setup_security(...)` outside tests: Celery then sends and accepts only signed
// ("auth") messages. A fact of the whole run, from each document's own calls (ps_signs): cross_file, with no column.
.decl ps_signed() cross_file
ps_signed() :- ps_signs(_).
.decl ps_signs(d: number)
ps_signs(d) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, "setup_security"), docof(c, d), !cel_test_doc(d).

// The cases, `cases/celery-practice-pickle-serializer/`: `proj/` is one repository, in which each line ending in
// `# caught` is reported and no other line; `signing/` is a second one that calls app.setup_security() and is silent.
.test cases exactly
    .fixture "proj/__init__.py" from "../cases/celery-practice-pickle-serializer/proj/__init__.py"
    .fixture "proj/celery.py" from "../cases/celery-practice-pickle-serializer/proj/celery.py"
    .fixture "proj/celeryconfig.py" from "../cases/celery-practice-pickle-serializer/proj/celeryconfig.py"
    .fixture "proj/other.py" from "../cases/celery-practice-pickle-serializer/proj/other.py"
    .fixture "proj/settings.py" from "../cases/celery-practice-pickle-serializer/proj/settings.py"
    .fixture "proj/settings_test.py" from "../cases/celery-practice-pickle-serializer/proj/settings_test.py"
    .fixture "proj/signed.py" from "../cases/celery-practice-pickle-serializer/proj/signed.py"
    .fixture "proj/tasks.py" from "../cases/celery-practice-pickle-serializer/proj/tasks.py"
    .fixture "proj/tests/__init__.py" from "../cases/celery-practice-pickle-serializer/proj/tests/__init__.py"
    .fixture "proj/tests/test_tasks.py" from "../cases/celery-practice-pickle-serializer/proj/tests/test_tasks.py"
    .expect _ at "proj/celery.py":8
    .expect _ at "proj/celery.py":9
    .expect _ at "proj/celery.py":10
    .expect _ at "proj/celery.py":12
    .expect _ at "proj/celery.py":13
    .expect _ at "proj/celery.py":15
    .expect _ at "proj/celery.py":16
    .expect _ at "proj/celeryconfig.py":2
    .expect _ at "proj/celeryconfig.py":3
    .expect _ at "proj/settings.py":4
    .expect _ at "proj/settings.py":5
    .expect _ at "proj/settings.py":16
    .expect _ at "proj/settings.py":17
    .expect _ at "proj/settings.py":18
    .expect _ at "proj/tasks.py":8
    .expect _ at "proj/tasks.py":13
    .expect _ at "proj/tasks.py":24
    .expect _ at "proj/tasks.py":32
    .expect _ at "proj/tasks.py":34
.end

.test signing exactly
    .fixture "proj/__init__.py" from "../cases/celery-practice-pickle-serializer/signing/proj/__init__.py"
    .fixture "proj/celery.py" from "../cases/celery-practice-pickle-serializer/signing/proj/celery.py"
.end
