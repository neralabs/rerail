.policy "alembic-practice-index-not-concurrent" revision 1
.description "Build indexes, unique constraints and primary keys on existing tables concurrently in Alembic migrations; a plain index build blocks every write to the table until it ends."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. A plain CREATE INDEX "locks out writes (but not reads) on the table until it's done"
// (PostgreSQL, CREATE INDEX), and ADD CONSTRAINT ... UNIQUE / PRIMARY KEY builds the same index under the same or a
// stronger lock: on a live table, every INSERT, UPDATE and DELETE waits for the whole build. Squawk
// (require-concurrent-index-creation, disallowed-unique-constraint) and strong_migrations flag the same thing in SQL
// and Rails. This rule reads Alembic's Python in the edit window, with no offline render, including revisions that
// cannot render offline (inspector calls, data migrations).
//
// Reported, in a revision's `upgrade()` (or a module-level helper it calls), on a table that `upgrade()` does not
// create, once per table and kind (the first such operation; the message counts them):
//   op.create_index("ix_users_email", "users", ["email"])                     reported
//   op.create_index(op.f("ix_x"), table_name="users", columns=["x"], unique=True)  reported (a constant table too)
//   op.create_index("ix", "users", ["x"], postgresql_concurrently=False)       reported
//   with op.batch_alter_table("users") as batch_op:
//       batch_op.create_index("ix", ["x"])                                     reported
//   create_index("orders", "ix_orders_ref", ["ref"])  # a helper of the run whose op.create_index takes the table
//                                                       from a parameter (superset's shared utils)   reported, at the call
//   op.create_unique_constraint("uq_users_email", "users", ["email"])         reported, with the unique index fix
//   op.add_column("users", sa.Column("code", sa.String(8), unique=True))       reported: Alembic emits ADD UNIQUE
//   op.add_column("users", sa.Column("ref", sa.String(8), index=True))         reported: Alembic emits CREATE INDEX
//   op.create_primary_key("pk_users", "users", ["id"])                         reported, with the USING INDEX fix
// Left alone:
//   op.create_table("tags", ...); op.create_index("ix_tags_name", "tags", ["name"])  a table this upgrade() creates,
//                                                                                   also in a dialect branch, or
//                                                                                   through a project's own
//                                                                                   `create_table("tags", ...)`
//                                                                                   wrapper (superset's)
//   op.create_index("ix", "users", ["x"], postgresql_concurrently=True)        whether it sits in autocommit_block()
//                                                                              is alembic-practice-concurrent-index-
//                                                                              outside-autocommit's concern
//   postgresql_concurrently=<any expression but False>                         not known to be off
//   else: op.create_index(...)  after `if _is_pg(conn):`, `if dialect.name == "sqlite":`   another database's branch
//   else: ...  after `if not isinstance(bind.dialect, SQLiteDialect):`        SQLite's branch (superset's)
//   if not _is_mysql(): return                                                 the rest of the function runs only
//   op.create_index(...)                                                       on MySQL (dify's)
//   downgrade(), revisions under tests/, files without `revision`/`down_revision`, an `op` that is not alembic.op.
// Gaps: downgrade() (rollbacks re-create indexes on the rare path); a table name the rule cannot resolve (an f-string,
// a helper two calls deep); a table created by an earlier revision of the same release counts as existing (one this
// upgrade() creates by `op.execute("CREATE TABLE ...")`, or empties first, does not); raw `op.execute("CREATE INDEX
// ...")` and `sa.Index(...).create(bind)` are not read; a project that runs only on SQLite is not told apart (its
// alembic.ini is not read); a plain DROP INDEX is not reported; a table known to stay
// small cannot be told apart, nor a project that migrates with the app stopped (jupyterhub, mealie), so the message
// says when to leave it.
// Corpus (8 Alembic repositories): see the README's rule details.

#include "lib/alembic.rerail"

.violation IndexNotConcurrent(at: node, table: symbol, count: number) "This upgrade builds {count} plain index(es) on existing `{table}`, each blocking its writes until done. Pass `postgresql_concurrently=True` inside an autocommit block for each. Fine for a small table."
.violation UniqueNotConcurrent(at: node, table: symbol, count: number) "ADD UNIQUE on existing `{table}` ({count} here) blocks its writes while its index builds. Build a unique index concurrently in an autocommit block, then add it USING INDEX. Fine for a small table."
.violation ColumnUniqueNotConcurrent(at: node, table: symbol) "`unique=True` on this added column builds a unique index on existing `{table}` under a write lock. Drop it; build the index with `unique=True, postgresql_concurrently=True`. Fine for a small table."
.violation ColumnIndexNotConcurrent(at: node, table: symbol) "`index=True` on this added column builds an index on existing `{table}` under a write lock. Drop it; build the index with `postgresql_concurrently=True` in an autocommit block. Fine for a small table."
.violation PrimaryKeyNotConcurrent(at: node, table: symbol) "ADD PRIMARY KEY on existing `{table}` builds its index under an exclusive lock. Build a unique index concurrently first, then add the key with `PRIMARY KEY USING INDEX`. Fine for a small table."

// inc_concurrent(c): operation c passes postgresql_concurrently= something not known to be False (a literal, or a
// constant of this module or an imported one: lib/alembic's al_kw_on).
.decl inc_concurrent(c: node)
inc_concurrent(c) :- al_kw_on(c, "postgresql_concurrently").
// inc_live(c): c sits in a migration that is not test code, outside a branch for another database.
.decl inc_live(c: node)
inc_live(c) :- kind(c, "call"), !al_non_pg(c), docof(c, d), al_migration_doc(d), !al_test_doc(d).
// inc_hit(c, k, t, f): in upgrade step f, c builds an index of kind k on existing table t without CONCURRENTLY.
.decl inc_hit(c: node, k: symbol, t: symbol, f: node)
inc_hit(c, "index", t, f) :- al_on_existing(c, "create_index", t, f), !inc_concurrent(c), inc_live(c).
inc_hit(c, "unique", t, f) :- al_on_existing(c, "create_unique_constraint", t, f), inc_live(c).
inc_hit(c, "index", t, f) :- al_forwarded(c, "create_index", t, ci, f), !inc_concurrent(ci), !al_non_pg(ci), inc_live(c).
inc_hit(c, "unique", t, f) :- al_forwarded(c, "create_unique_constraint", t, ci, f), !al_non_pg(ci), inc_live(c).
inc_hit(c, "col_unique", t, f) :- al_added_ddl(c, t, "unique", f), inc_live(c).
inc_hit(c, "col_index", t, f) :- al_added_ddl(c, t, "index", f), inc_live(c).
inc_hit(c, "pk", t, f) :- al_on_existing(c, "create_primary_key", t, f), inc_live(c).
// inc_first(c, k, t, n): c is the first of the n index builds of kind k on table t in its upgrade step.
.decl inc_first(c: node, k: symbol, t: symbol, n: number)
inc_first(c, k, t, n) :- inc_hit(c, k, t, f), docof(c, d), node(d, c, _, s, _),
    s = min x : { inc_hit(b, k, t, f), node(d, b, _, x, _) }, n = count : { inc_hit(_, k, t, f) }.

IndexNotConcurrent(c, t, n) :- inc_first(c, "index", t, n).
UniqueNotConcurrent(c, t, n) :- inc_first(c, "unique", t, n).
ColumnUniqueNotConcurrent(c, t) :- inc_hit(c, "col_unique", t, _).
ColumnIndexNotConcurrent(c, t) :- inc_hit(c, "col_index", t, _).
PrimaryKeyNotConcurrent(c, t) :- inc_hit(c, "pk", t, _).

// The cases, `cases/alembic-practice-index-not-concurrent/`, read as one repository: each line ending in `# caught`
// is reported, and no other line.
.test cases exactly
    .fixture "app/search.py" from "../cases/alembic-practice-index-not-concurrent/app/search.py"
    .fixture "migrations/scripts/backfill.py" from "../cases/alembic-practice-index-not-concurrent/migrations/scripts/backfill.py"
    .fixture "migrations/shared/dialects.py" from "../cases/alembic-practice-index-not-concurrent/migrations/shared/dialects.py"
    .fixture "migrations/shared/flags.py" from "../cases/alembic-practice-index-not-concurrent/migrations/shared/flags.py"
    .fixture "migrations/shared/utils.py" from "../cases/alembic-practice-index-not-concurrent/migrations/shared/utils.py"
    .fixture "migrations/versions/c1_user_indexes.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c1_user_indexes.py"
    .fixture "migrations/versions/c2_batch_and_dialects.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c2_batch_and_dialects.py"
    .fixture "migrations/versions/c3_unique.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c3_unique.py"
    .fixture "migrations/versions/c4_search_index.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c4_search_index.py"
    .fixture "migrations/versions/c5_reports_wrapper.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c5_reports_wrapper.py"
    .fixture "migrations/versions/c6_guards.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c6_guards.py"
    .fixture "migrations/versions/c7_columns_keys_helpers.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c7_columns_keys_helpers.py"
    .fixture "migrations/versions/c8_class_variants.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c8_class_variants.py"
    .fixture "migrations/versions/c9_dialect_variants.py" from "../cases/alembic-practice-index-not-concurrent/migrations/versions/c9_dialect_variants.py"
    .fixture "tests/migrations/versions/t1_fixture.py" from "../cases/alembic-practice-index-not-concurrent/tests/migrations/versions/t1_fixture.py"
    .expect IndexNotConcurrent at "migrations/versions/c1_user_indexes.py":14
    .expect IndexNotConcurrent at "migrations/versions/c1_user_indexes.py":17
    .expect IndexNotConcurrent at "migrations/versions/c1_user_indexes.py":18
    .expect IndexNotConcurrent at "migrations/versions/c1_user_indexes.py":19
    .expect IndexNotConcurrent at "migrations/versions/c1_user_indexes.py":25
    .expect IndexNotConcurrent at "migrations/versions/c1_user_indexes.py":44
    .expect IndexNotConcurrent at "migrations/versions/c2_batch_and_dialects.py":19
    .expect IndexNotConcurrent at "migrations/versions/c2_batch_and_dialects.py":22
    .expect UniqueNotConcurrent at "migrations/versions/c2_batch_and_dialects.py":46
    .expect UniqueNotConcurrent at "migrations/versions/c3_unique.py":11
    .expect UniqueNotConcurrent at "migrations/versions/c3_unique.py":12
    .expect UniqueNotConcurrent at "migrations/versions/c3_unique.py":14
    .expect IndexNotConcurrent at "migrations/versions/c5_reports_wrapper.py":20
    .expect IndexNotConcurrent at "migrations/versions/c6_guards.py":31
    .expect ColumnUniqueNotConcurrent at "migrations/versions/c7_columns_keys_helpers.py":14
    .expect ColumnIndexNotConcurrent at "migrations/versions/c7_columns_keys_helpers.py":15
    .expect ColumnUniqueNotConcurrent at "migrations/versions/c7_columns_keys_helpers.py":17
    .expect PrimaryKeyNotConcurrent at "migrations/versions/c7_columns_keys_helpers.py":20
    .expect IndexNotConcurrent at "migrations/versions/c7_columns_keys_helpers.py":22
    .expect IndexNotConcurrent at "migrations/versions/c7_columns_keys_helpers.py":23
    .expect IndexNotConcurrent at "migrations/versions/c7_columns_keys_helpers.py":24
    .expect IndexNotConcurrent at "migrations/versions/c8_class_variants.py":19
    .expect IndexNotConcurrent at "migrations/versions/c8_class_variants.py":20
    .expect ColumnUniqueNotConcurrent at "migrations/versions/c8_class_variants.py":21
    .expect ColumnIndexNotConcurrent at "migrations/versions/c8_class_variants.py":22
    .expect IndexNotConcurrent at "migrations/versions/c8_class_variants.py":24
    .expect IndexNotConcurrent at "migrations/versions/c9_dialect_variants.py":37
    .expect IndexNotConcurrent at "migrations/versions/c9_dialect_variants.py":39
    .expect IndexNotConcurrent at "migrations/versions/c9_dialect_variants.py":42
    .expect IndexNotConcurrent at "migrations/versions/c9_dialect_variants.py":46
    .expect IndexNotConcurrent at "migrations/versions/c9_dialect_variants.py":50
.end
