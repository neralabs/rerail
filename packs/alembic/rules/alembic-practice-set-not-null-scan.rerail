.policy "alembic-practice-set-not-null-scan" revision 1
.description "Make an existing column NOT NULL in Alembic migrations behind a CHECK constraint validated beforehand; a plain SET NOT NULL scans the table under an exclusive lock."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. `ALTER TABLE t ALTER COLUMN c SET NOT NULL` checks every row ("by scanning the entire
// table") while ALTER TABLE holds ACCESS EXCLUSIVE on t, which blocks reads and writes for the whole scan; since
// PostgreSQL 12 the scan is skipped when a valid CHECK constraint already proves the column holds no NULL
// (PostgreSQL, ALTER TABLE). The safe sequence: add `CHECK (c IS NOT NULL) NOT VALID` (no scan), VALIDATE CONSTRAINT
// (scans under SHARE UPDATE EXCLUSIVE, which lets reads and writes through), then SET NOT NULL (no scan) and drop the
// check. Squawk (adding-not-nullable-field) and strong_migrations flag the same thing in SQL and Rails.
// Reported, in a revision's `upgrade()` (or a module-level helper it calls), on a table `upgrade()` does not create:
//   op.alter_column("users", "email", nullable=False)                                reported
//   op.alter_column(table_name="orders", column_name="total", nullable=False, ...)  reported (keywords, op.f,
//                                                                                    module constants, other kwargs)
//   with op.batch_alter_table("projects") as batch_op:
//       batch_op.alter_column("slug", nullable=False)                                reported
//   op.add_column("users", sa.Column("tier", ..., nullable=True)); op.execute("UPDATE ...")
//   op.alter_column("users", "tier", nullable=False)                                 reported, second message: a
//                                                                                    constant backfill can be a
//                                                                                    server_default instead (also
//                                                                                    after a project's own
//                                                                                    add_columns("t", Column(...)))
// The column added earlier in the same upgrade() is a match too: the SET NOT NULL still scans the whole table under
// ACCESS EXCLUSIVE. It gets its own message because it has a cheaper fix when every row gets one value (mealie's
// `on_hand = FALSE`, dispatch's `scope = 'multiple'`): `server_default=` with nullable=False in one add_column.
// Left alone:
//   op.execute("ALTER TABLE t VALIDATE CONSTRAINT ck_t_c_not_null"); op.alter_column("t", "c", nullable=False)
//                                    a VALIDATE CONSTRAINT in the same upgrade() whose SQL names the column, or any
//                                    VALIDATE when the file spells `c IS NOT NULL` (polar's
//                                    `CHECK (c IS NOT NULL) NOT VALID` + `VALIDATE CONSTRAINT {NOT_NULL_CHECK}`)
//   op.create_check_constraint("ck", "t", "c IS NOT NULL"); op.alter_column("t", "c", nullable=False)
//                                    a CHECK added validated in the same file (its own scan is
//                                    alembic-practice-constraint-without-not-valid's concern)
//   op.alter_column(..., existing_nullable=False, nullable=False)    already NOT NULL: PostgreSQL does nothing
//   nullable=True, no nullable=; a table the same upgrade() creates; the branch of a dialect test that runs only on
//   another database (lib/alembic al_non_pg); downgrade(); revisions under tests/; files without
//   `revision`/`down_revision`; an `op` that is not alembic.op.
// A VALIDATE exempts the column only when the constraint it names is shown to be a NOT NULL check of that column:
// added by SQL (`ADD CONSTRAINT {NOT_NULL_CHECK} CHECK (x IS NOT NULL) NOT VALID`) or by create_check_constraint whose
// condition spells `x IS NOT NULL`, in this revision or an earlier one of the run. A VALIDATE of another constraint
// whose name merely contains the column's (`fk_users_email_domain` for `email`) exempts nothing. Flags are read by
// value (lib/alembic's al_flag_t).
// Gaps: `op.execute("ALTER TABLE ... SET NOT NULL")` is not read; a table created by an earlier revision of the same
// release counts as existing; a column name the rule cannot resolve is reported as `<column>`; a NOT NULL check added
// outside the run (another repository, a manual step) is not seen, so its column is reported; a column already NOT
// NULL without `existing_nullable=False` (a no-op) is reported; a table the same transaction already rewrites (raw
// `ADD COLUMN id SERIAL`) is reported though the fix does not shorten the lock; a table that stays small cannot be
// told apart, so the message says when to leave it.
// Corpus (8 Alembic repositories): see the README's rule details.

#include "lib/alembic.rerail"

.violation SetNotNullScan(at: node, table: symbol, col: symbol) "SET NOT NULL on `{table}`.`{col}` scans every row under ACCESS EXCLUSIVE. Add a NOT VALID `{col} IS NOT NULL` check, validate it after a commit, then set NOT NULL. Fine for a small table."
.violation SetNotNullAfterAdd(at: node, table: symbol, col: symbol) "`{col}` was just added to `{table}`, and SET NOT NULL scans every row under ACCESS EXCLUSIVE. Add it with `server_default=` and nullable=False in one step instead. Fine for a small table."

// Flags are read by value (lib/alembic's al_flag_t: a literal, or a module constant of the file or imported). What
// crosses files is read by term and value (decision 0677): the alter_column by its term (al_term), a check constraint
// or SQL string of another revision by its table, condition and name.

// snn_col(c, x): alter_column c's column, as its name or a placeholder when the rule cannot read it.
.decl snn_known_col(c: node, x: symbol)
snn_known_col(c, x) :- al_role(c, "column_name", e), al_name_value(e, x).
.decl snn_col_named(c: node)
snn_col_named(c) :- snn_known_col(c, _).
.decl snn_col(c: node, x: symbol)
snn_col(c, x) :- snn_known_col(c, x).
snn_col(c, "<column>") :- al_call(c, "alter_column", _), !snn_col_named(c).

// snn_cand(c, t, x, f, d, ct, ft): alter_column c (term ct) in upgrade step f (term ft) of revision d passes
// `nullable=` for column x of existing table t, outside test code and outside another database's branch of its own
// file. snn_set(d, ct, t, x, ft): it sets the column NOT NULL: `nullable=False`, not `existing_nullable=False` (already
// NOT NULL: a no-op), and no test function of another module rules PostgreSQL out (al_np_ext).
.decl snn_cand(c: node, t: symbol, x: symbol, f: node, d: number, ct: symbol, ft: symbol)
snn_cand(c, t, x, f, d, ct, ft) :- al_on_existing(c, "alter_column", t, f), al_kw(c, "nullable", _), !al_non_pg(c),
    docof(c, d), al_migration_doc(d), !al_test_doc(d), snn_col(c, x), al_term(c, d, ct), al_term(f, d, ft).
.decl snn_cand_at(d: number, ct: symbol, t: symbol, x: symbol, ft: symbol)
snn_cand_at(d, ct, t, x, ft) :- snn_cand(_, t, x, _, d, ct, ft).
.decl snn_set(d: number, ct: symbol, t: symbol, x: symbol, ft: symbol)
snn_set(d, ct, t, x, ft) :- snn_cand_at(d, ct, t, x, ft), al_flag_t(d, ct, "nullable", "false"),
    !al_flag_t(d, ct, "existing_nullable", "false"), !al_np_ext(d, ct).

// snn_sql(n, s): a string literal's source text, lowercased, read whole: an implicit concatenation as one (an
// f-string's placeholders stay as written, so `{NOT_NULL_CHECK}` reads `{not_null_check}`). snn_sql_at(d, s): such a
// string of document d that spells a NOT NULL check (` is not null`).
.decl snn_in_concat(n: node)
snn_in_concat(n) :- kind(n, "string"), child(p, n, _), kind(p, "concatenated_string").
.decl snn_sql(n: node, s: symbol)
snn_sql(n, y) :- kind(n, "concatenated_string"), text(n, s), y = @lower(s).
snn_sql(n, y) :- kind(n, "string"), !snn_in_concat(n), text(n, s), y = @lower(s).
.decl snn_sql_at(d: number, s: symbol)
snn_sql_at(d, s) :- snn_sql(n, s), contains(" is not null", s), docof(n, d).
// snn_validates_at(d, ft, nm): upgrade step ft of document d runs `VALIDATE CONSTRAINT nm` (nm lowercased, as written).
.decl snn_validates_at(d: number, ft: symbol, nm: symbol)
snn_validates_at(d, ft, nm) :- snn_cand(_, _, _, f, d, _, ft), snn_sql(n, s), al_in_step(n, f),
    match("(?s).*validate constraint\\s+(?<nm>[^\\s\"';]+).*", s).
// snn_validated(d, ft, x): upgrade step ft of revision d validates a constraint that is a NOT NULL check of column x
// (a string that spells `x IS NOT NULL`, bare or double-quoted), added by SQL (`ADD CONSTRAINT {NOT_NULL_CHECK} CHECK
// (x IS NOT NULL) NOT VALID`, a string that names the constraint and spells the check) or by create_check_constraint
// whose condition spells it, anywhere in the run. It joins a revision to the strings and checks of the others, so it
// spans files on purpose (cross_file), keyed by documents, terms and values: no node.
.decl snn_validated(d: number, ft: symbol, x: symbol) cross_file
snn_validated(d, ft, x) :- snn_set(d, _, _, x, ft), snn_validates_at(d, ft, nm), snn_sql_at(_, s), contains(nm, s),
    lx = @lower(x), (contains(cat(lx, " is not null"), s) ; contains(cat(cat("\"", lx), "\" is not null"), s)).
snn_validated(d, ft, x) :- snn_set(d, _, t, x, ft), snn_validates_at(d, ft, nm), snn_check_at(e, kt, t, s),
    lx = @lower(x), (contains(cat(lx, " is not null"), s) ; contains(cat(cat("\"", lx), "\" is not null"), s)),
    snn_check_name_at(e, kt, en, how), ((how = "value", nm = en) ; (how = "ident", contains(en, nm))).
// snn_check_at(d, kt, t, s): create_check_constraint of term kt in document d, on table t, has the condition s
// (lowercased) that spells a NOT NULL check. snn_check_name_at(d, kt, en, how): its name, lowercased: a name value
// (how "value") or an identifier's text (how "ident", which a VALIDATE's placeholder may spell in part).
.decl snn_check_at(d: number, kt: symbol, t: symbol, s: symbol)
snn_check_at(d, kt, t, s) :- al_call(k, "create_check_constraint", fm), al_table(k, t), snn_condition(k, fm, s),
    contains(" is not null", s), al_term(k, d, kt).
.decl snn_check_name_at(d: number, kt: symbol, en: symbol, how: symbol)
snn_check_name_at(d, kt, y, "value") :- al_call(k, "create_check_constraint", _), al_role(k, "name", e), unparen(e, u),
    al_name_value(u, en), y = @lower(en), al_term(k, d, kt).
snn_check_name_at(d, kt, y, "ident") :- al_call(k, "create_check_constraint", _), al_role(k, "name", e), unparen(e, u),
    kind(u, "identifier"), text(u, en), y = @lower(en), al_term(k, d, kt).
// snn_check_added(d, t, x): revision d itself adds that check validated: no postgresql_not_valid, or False.
.decl snn_check_added(d: number, t: symbol, x: symbol)
snn_check_added(d, t, x) :- snn_set(d, _, t, x, _), snn_check_at(d, kt, t, s), lx = @lower(x),
    (contains(cat(lx, " is not null"), s) ; contains(cat(cat("\"", lx), "\" is not null"), s)), !snn_not_valid(d, kt).
.decl snn_not_valid(d: number, kt: symbol)
snn_not_valid(d, kt) :- al_kw_at(d, kt, "postgresql_not_valid"), !al_flag_t(d, kt, "postgresql_not_valid", "false").
// snn_condition(k, fm, s): create_check_constraint k's condition, lowercased: its text, or a module constant's value.
.decl snn_condition_arg(k: node, fm: symbol, e: node)
snn_condition_arg(k, "op", e) :- al_call(k, "create_check_constraint", "op"), call_arg(k, 2, "", e).
snn_condition_arg(k, "batch", e) :- al_call(k, "create_check_constraint", "batch"), call_arg(k, 1, "", e).
snn_condition_arg(k, fm, e) :- al_call(k, "create_check_constraint", fm), call_arg(k, -1, "condition", e).
.decl snn_condition(k: node, fm: symbol, s: symbol)
snn_condition(k, fm, y) :- snn_condition_arg(k, fm, e), text(e, s), y = @lower(s).
snn_condition(k, fm, y) :- snn_condition_arg(k, fm, e), unparen(e, u), kind(u, "identifier"), static_value(u, s),
    y = @lower(s).

// snn_safe(d, ct): the column alter_column ct sets is validated as NOT NULL first, or checked in the same revision.
.decl snn_safe(d: number, ct: symbol)
snn_safe(d, ct) :- snn_set(d, ct, _, x, ft), snn_validated(d, ft, x).
snn_safe(d, ct) :- snn_set(d, ct, t, x, _), snn_check_added(d, t, x).

// snn_added_before(c): the same upgrade step adds column x to t before alter_column c: an Alembic add_column, or a
// project's own `add_columns("t", sa.Column("x", ...), ...)` / `add_column("t", sa.Column(...))` wrapper (superset's
// migrations.shared.utils.add_columns).
.decl snn_added_before(c: node)
snn_added_before(c) :- snn_cand(c, t, x, f, d, _, _), al_on_existing(a, "add_column", t, f), al_added_column(a, col),
    al_column_name(col, x), node(d, a, _, sa, _), node(d, c, _, sc, _), sa < sc.
snn_added_before(c) :- snn_cand(c, t, x, f, d, _, _), snn_add_wrapper(a), al_in_step(a, f), call_arg(a, 0, "", e),
    al_name_value(e, t), call_arg(a, i, "", col), i > 0, unparen(col, u), al_column_name(u, x), node(d, a, _, sa, _),
    node(d, c, _, sc, _), sa < sc.
.decl snn_add_wrapper(a: node)
snn_add_wrapper(a) :- kind(a, "call"), field(a, "function", fn), (kind(fn, "identifier"), text(fn, m) ;
    attr_of(fn, _, m)), (m = "add_columns" ; m = "add_column"), !al_call(a, _, _).

SetNotNullScan(c, t, x) :- snn_cand(c, t, x, _, d, ct, ft), snn_set(d, ct, t, x, ft), !snn_safe(d, ct),
    !snn_added_before(c).
SetNotNullAfterAdd(c, t, x) :- snn_cand(c, t, x, _, d, ct, ft), snn_set(d, ct, t, x, ft), !snn_safe(d, ct),
    snn_added_before(c).

// The cases, `upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/`, read as one repository: each
// line ending in `# caught` is reported, and no other line.
.test cases exactly
    .fixture "app/schema.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/app/schema.py"
    .fixture "migrations/versions/s1_set_not_null.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/migrations/versions/s1_set_not_null.py"
    .fixture "migrations/versions/s2_new_tables_and_dialects.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/migrations/versions/s2_new_tables_and_dialects.py"
    .fixture "migrations/versions/s3_added_then_tightened.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/migrations/versions/s3_added_then_tightened.py"
    .fixture "migrations/versions/s4_checked_first.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/migrations/versions/s4_checked_first.py"
    .fixture "migrations/versions/s5_validate_later.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/migrations/versions/s5_validate_later.py"
    .fixture "migrations/versions/s6_other_op.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/migrations/versions/s6_other_op.py"
    .fixture "migrations/versions/s7_refunds_checks.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/migrations/versions/s7_refunds_checks.py"
    .fixture "tests/migrations/versions/t1_fixture.py" from "../upstream/alembic-practice/authored/alembic-practice-set-not-null-scan/tests/migrations/versions/t1_fixture.py"
    .expect _ at "migrations/versions/s1_set_not_null.py":14
    .expect _ at "migrations/versions/s1_set_not_null.py":15
    .expect _ at "migrations/versions/s1_set_not_null.py":16
    .expect _ at "migrations/versions/s1_set_not_null.py":17
    .expect _ at "migrations/versions/s1_set_not_null.py":18
    .expect _ at "migrations/versions/s1_set_not_null.py":26
    .expect _ at "migrations/versions/s1_set_not_null.py":27
    .expect _ at "migrations/versions/s1_set_not_null.py":39
    .expect _ at "migrations/versions/s2_new_tables_and_dialects.py":20
    .expect _ at "migrations/versions/s3_added_then_tightened.py":16
    .expect _ at "migrations/versions/s3_added_then_tightened.py":22
    .expect _ at "migrations/versions/s3_added_then_tightened.py":27
    .expect _ at "migrations/versions/s4_checked_first.py":31
    .expect _ at "migrations/versions/s5_validate_later.py":21
    .expect _ at "migrations/versions/s5_validate_later.py":24
.end
