.policy "alembic-practice-set-not-null-scan" revision 1
.description "Make a column of an existing table NOT NULL behind a validated CHECK (c IS NOT NULL) NOT VALID constraint, so SET NOT NULL does not scan the table under an exclusive lock."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. `ALTER TABLE t ALTER COLUMN c SET NOT NULL` checks every row ("by scanning the entire
// table") while ALTER TABLE holds ACCESS EXCLUSIVE on t, which blocks reads and writes for the whole scan; since
// PostgreSQL 12 the scan is skipped when a valid CHECK constraint already proves the column holds no NULL
// (PostgreSQL, ALTER TABLE). The safe sequence: add `CHECK (c IS NOT NULL) NOT VALID` (no scan), VALIDATE CONSTRAINT
// (scans under SHARE UPDATE EXCLUSIVE, which lets reads and writes through), then SET NOT NULL (no scan) and drop the
// check. Squawk (adding-not-nullable-field) and strong_migrations flag the same thing in SQL and Rails.
// Reported, in a revision's `upgrade()` (or a module-level helper it calls), on a table `upgrade()` does not create:
//   op.alter_column("users", "email", nullable=False)                                reported
//   op.alter_column(table_name="orders", column_name="total", nullable=False, ...)  reported (keywords, op.f,
//                                                                                    module constants, other kwargs)
//   with op.batch_alter_table("projects") as batch_op:
//       batch_op.alter_column("slug", nullable=False)                                reported
//   op.add_column("users", sa.Column("tier", ..., nullable=True)); op.execute("UPDATE ...")
//   op.alter_column("users", "tier", nullable=False)                                 reported, second message: a
//                                                                                    constant backfill can be a
//                                                                                    server_default instead (also
//                                                                                    after a project's own
//                                                                                    add_columns("t", Column(...)))
// The column added earlier in the same upgrade() is a match too: the SET NOT NULL still scans the whole table under
// ACCESS EXCLUSIVE. It gets its own message because it has a cheaper fix when every row gets one value (mealie's
// `on_hand = FALSE`, dispatch's `scope = 'multiple'`): `server_default=` with nullable=False in one add_column.
// Left alone:
//   op.execute("ALTER TABLE t VALIDATE CONSTRAINT ck_t_c_not_null"); op.alter_column("t", "c", nullable=False)
//                                    a VALIDATE CONSTRAINT in the same upgrade() whose SQL names the column, or any
//                                    VALIDATE when the file spells `c IS NOT NULL` (polar's
//                                    `CHECK (c IS NOT NULL) NOT VALID` + `VALIDATE CONSTRAINT {NOT_NULL_CHECK}`)
//   op.create_check_constraint("ck", "t", "c IS NOT NULL"); op.alter_column("t", "c", nullable=False)
//                                    a CHECK added validated in the same file (its own scan is
//                                    alembic-practice-constraint-without-not-valid's concern)
//   op.alter_column(..., existing_nullable=False, nullable=False)    already NOT NULL: PostgreSQL does nothing
//   nullable=True, no nullable=; a table the same upgrade() creates; the branch of a dialect test that runs only on
//   another database (lib/alembic al_non_pg); downgrade(); revisions under tests/; files without
//   `revision`/`down_revision`; an `op` that is not alembic.op.
// Gaps: `op.execute("ALTER TABLE ... SET NOT NULL")` is not read; a table created by an earlier revision of the same
// release counts as existing; a column name the rule cannot resolve is reported as `<column>`; a VALIDATE of another
// constraint whose SQL happens to name the column exempts it; a column already NOT NULL without
// `existing_nullable=False` (a no-op) is reported; a table the same transaction already rewrites (raw
// `ADD COLUMN id SERIAL`) is reported though the fix does not shorten the lock; a table that stays small cannot be
// told apart, so the message says when to leave it.
// Corpus (8 Alembic repositories): 77 matches, 74 real; see the README's rule details.

#include "lib/alembic.rerail"

.violation SetNotNullScan(at: node, table: symbol, col: symbol) "SET NOT NULL on `{table}`.`{col}` scans every row while ALTER TABLE holds ACCESS EXCLUSIVE, blocking reads and writes. On PostgreSQL 12+ add `op.create_check_constraint(\"ck_{table}_{col}_not_null\", \"{table}\", \"{col} IS NOT NULL\", postgresql_not_valid=True)`, run `VALIDATE CONSTRAINT` once that has committed (a later revision, or an autocommit_block), then set nullable=False (no scan) and drop the check. Fine for a table that stays small."
.violation SetNotNullAfterAdd(at: node, table: symbol, col: symbol) "`{col}` is added to existing `{table}` earlier in this upgrade, and SET NOT NULL then scans every row under ACCESS EXCLUSIVE, blocking reads and writes. If every existing row gets the same value, add the column with `server_default=` and nullable=False in one step instead (no rewrite or scan on PostgreSQL 11+); otherwise add `CHECK ({col} IS NOT NULL) NOT VALID`, VALIDATE it, then set nullable=False (PostgreSQL 12+). Fine for a table that stays small."

// snn_false(e): e is a literal False.
.decl snn_false(e: node)
snn_false(e) :- unparen(e, u), kind(u, "false").

// snn_col(c, x): alter_column c's column, as its name or a placeholder when the rule cannot read it.
.decl snn_known_col(c: node, x: symbol)
snn_known_col(c, x) :- al_role(c, "column_name", e), al_name_value(e, x).
.decl snn_col_named(c: node)
snn_col_named(c) :- snn_known_col(c, _).
.decl snn_col(c: node, x: symbol)
snn_col(c, x) :- snn_known_col(c, x).
snn_col(c, "<column>") :- al_call(c, "alter_column", _), !snn_col_named(c).

// snn_set(c, t, x, f, d): alter_column c in upgrade step f of revision d sets column x of existing table t NOT NULL,
// outside another database's branch and outside test code. `existing_nullable=False` says it already is: a no-op.
.decl snn_set(c: node, t: symbol, x: symbol, f: node, d: number)
snn_set(c, t, x, f, d) :- al_on_existing(c, "alter_column", t, f), al_kw(c, "nullable", v), snn_false(v),
    !snn_already_not_null(c), !al_non_pg(c), docof(c, d), al_migration_doc(d), !al_test_doc(d), snn_col(c, x).
.decl snn_already_not_null(c: node)
snn_already_not_null(c) :- al_kw(c, "existing_nullable", v), snn_false(v).

// snn_sql(n, s): a string literal's source text, lowercased, read whole: an implicit concatenation as one (an
// f-string's placeholders stay as written, so `{NOT_NULL_CHECK}` reads `{not_null_check}`).
.decl snn_in_concat(n: node)
snn_in_concat(n) :- kind(n, "string"), child(p, n, _), kind(p, "concatenated_string").
.decl snn_sql(n: node, s: symbol)
snn_sql(n, y) :- kind(n, "concatenated_string"), text(n, s), y = @lower(s).
snn_sql(n, y) :- kind(n, "string"), !snn_in_concat(n), text(n, s), y = @lower(s).
// snn_validates(f, nm): upgrade step f runs `VALIDATE CONSTRAINT nm` (nm lowercased, as written).
.decl snn_validates(f: node, nm: symbol)
snn_validates(f, nm) :- snn_set(_, _, _, f, _), snn_sql(n, s), al_in_step(n, f),
    match("(?s).*validate constraint\\s+(?<nm>[^\\s\"';]+).*", s).
// snn_validated(f, x): upgrade step f validates a constraint that is a NOT NULL check of column x: its name holds the
// column's (`ck_refunds_reason_not_null`), or the same file adds it with SQL (`ADD CONSTRAINT {NOT_NULL_CHECK} CHECK
// (x IS NOT NULL) NOT VALID`) or with create_check_constraint whose condition spells `x IS NOT NULL`.
.decl snn_validated(f: node, x: symbol)
snn_validated(f, x) :- snn_set(_, _, x, f, _), snn_validates(f, nm), contains(@lower(x), nm).
snn_validated(f, x) :- snn_set(_, _, x, f, d), snn_validates(f, nm), snn_sql(n, s), docof(n, d), contains(nm, s),
    lx = @lower(x), (contains(cat(lx, " is not null"), s) ; contains(cat(cat("\"", lx), "\" is not null"), s)).
snn_validated(f, x) :- snn_set(_, t, x, f, d), snn_validates(f, nm), snn_check_says(k, t, x, d), al_role(k, "name", e),
    unparen(e, u), (al_name_value(u, en), nm = @lower(en) ; kind(u, "identifier"), text(u, en), contains(@lower(en), nm)).
// snn_check_says(k, t, x, d): create_check_constraint k in document d, on table t, has a condition that spells
// `x IS NOT NULL` (bare or double-quoted name).
.decl snn_check_says(k: node, t: symbol, x: symbol, d: number)
snn_check_says(k, t, x, d) :- snn_set(_, t, x, _, d), al_call(k, "create_check_constraint", fm), al_table(k, t),
    docof(k, d), snn_condition(k, fm, s), lx = @lower(x), (contains(cat(lx, " is not null"), s) ;
    contains(cat(cat("\"", lx), "\" is not null"), s)).
// snn_check_added(d, t, x): ... and adds it validated: no postgresql_not_valid, or a literal False.
.decl snn_check_added(d: number, t: symbol, x: symbol)
snn_check_added(d, t, x) :- snn_check_says(k, t, x, d), !snn_not_valid(k).
.decl snn_not_valid(k: node)
snn_not_valid(k) :- al_kw(k, "postgresql_not_valid", v), !snn_false(v).
// snn_condition(k, fm, s): create_check_constraint k's condition, lowercased: its text, or a module constant's value.
.decl snn_condition_arg(k: node, fm: symbol, e: node)
snn_condition_arg(k, "op", e) :- al_call(k, "create_check_constraint", "op"), call_arg(k, 2, "", e).
snn_condition_arg(k, "batch", e) :- al_call(k, "create_check_constraint", "batch"), call_arg(k, 1, "", e).
snn_condition_arg(k, fm, e) :- al_call(k, "create_check_constraint", fm), call_arg(k, -1, "condition", e).
.decl snn_condition(k: node, fm: symbol, s: symbol)
snn_condition(k, fm, y) :- snn_condition_arg(k, fm, e), text(e, s), y = @lower(s).
snn_condition(k, fm, y) :- snn_condition_arg(k, fm, e), unparen(e, u), kind(u, "identifier"), static_value(u, s),
    y = @lower(s).

.decl snn_safe(c: node)
snn_safe(c) :- snn_set(c, _, x, f, _), snn_validated(f, x).
snn_safe(c) :- snn_set(c, t, x, _, d), snn_check_added(d, t, x).

// snn_added_before(c): the same upgrade step adds column x to t before alter_column c: an Alembic add_column, or a
// project's own `add_columns("t", sa.Column("x", ...), ...)` / `add_column("t", sa.Column(...))` wrapper (superset's
// migrations.shared.utils.add_columns).
.decl snn_added_before(c: node)
snn_added_before(c) :- snn_set(c, t, x, f, d), al_on_existing(a, "add_column", t, f), al_added_column(a, col),
    al_column_name(col, x), node(d, a, _, sa, _), node(d, c, _, sc, _), sa < sc.
snn_added_before(c) :- snn_set(c, t, x, f, d), snn_add_wrapper(a), al_in_step(a, f), call_arg(a, 0, "", e),
    al_name_value(e, t), call_arg(a, i, "", col), i > 0, unparen(col, u), al_column_name(u, x), node(d, a, _, sa, _),
    node(d, c, _, sc, _), sa < sc.
.decl snn_add_wrapper(a: node)
snn_add_wrapper(a) :- kind(a, "call"), field(a, "function", fn), (kind(fn, "identifier"), text(fn, m) ;
    attr_of(fn, _, m)), (m = "add_columns" ; m = "add_column"), !al_call(a, _, _).

SetNotNullScan(c, t, x) :- snn_set(c, t, x, _, _), !snn_safe(c), !snn_added_before(c).
SetNotNullAfterAdd(c, t, x) :- snn_set(c, t, x, _, _), !snn_safe(c), snn_added_before(c).

// The cases, `cases/alembic-practice-set-not-null-scan/`, read as one repository: each line ending in `# caught` is
// reported, and no other line.
.test cases exactly
    .fixture "app/schema.py" from "../cases/alembic-practice-set-not-null-scan/app/schema.py"
    .fixture "migrations/versions/s1_set_not_null.py" from "../cases/alembic-practice-set-not-null-scan/migrations/versions/s1_set_not_null.py"
    .fixture "migrations/versions/s2_new_tables_and_dialects.py" from "../cases/alembic-practice-set-not-null-scan/migrations/versions/s2_new_tables_and_dialects.py"
    .fixture "migrations/versions/s3_added_then_tightened.py" from "../cases/alembic-practice-set-not-null-scan/migrations/versions/s3_added_then_tightened.py"
    .fixture "migrations/versions/s4_checked_first.py" from "../cases/alembic-practice-set-not-null-scan/migrations/versions/s4_checked_first.py"
    .fixture "migrations/versions/s5_validate_later.py" from "../cases/alembic-practice-set-not-null-scan/migrations/versions/s5_validate_later.py"
    .fixture "migrations/versions/s6_other_op.py" from "../cases/alembic-practice-set-not-null-scan/migrations/versions/s6_other_op.py"
    .fixture "tests/migrations/versions/t1_fixture.py" from "../cases/alembic-practice-set-not-null-scan/tests/migrations/versions/t1_fixture.py"
    .expect _ at "migrations/versions/s1_set_not_null.py":14
    .expect _ at "migrations/versions/s1_set_not_null.py":15
    .expect _ at "migrations/versions/s1_set_not_null.py":16
    .expect _ at "migrations/versions/s1_set_not_null.py":17
    .expect _ at "migrations/versions/s1_set_not_null.py":18
    .expect _ at "migrations/versions/s1_set_not_null.py":26
    .expect _ at "migrations/versions/s1_set_not_null.py":27
    .expect _ at "migrations/versions/s1_set_not_null.py":39
    .expect _ at "migrations/versions/s2_new_tables_and_dialects.py":20
    .expect _ at "migrations/versions/s3_added_then_tightened.py":16
    .expect _ at "migrations/versions/s3_added_then_tightened.py":22
    .expect _ at "migrations/versions/s3_added_then_tightened.py":27
    .expect _ at "migrations/versions/s4_checked_first.py":31
    .expect _ at "migrations/versions/s5_validate_later.py":18
.end
