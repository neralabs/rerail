.policy "alembic-practice-not-null-without-server-default" revision 1
.description "Give a NOT NULL column added to an existing table in an Alembic migration a server default; without one the migration fails on any table that holds rows."
.language python
.mode steer
.scope include "**/*.py"
// Rerail's own rule, not a port. `ALTER TABLE t ADD COLUMN c ... NOT NULL` with no DEFAULT fails on PostgreSQL as soon
// as t holds one row: every existing row would get NULL. The migration passes on an empty development database and
// fails in production. SQLAlchemy's `default=` is applied by SQLAlchemy when it inserts a row; it never reaches the
// database, so it does not fill the existing rows (only `server_default=` does).
// Reported: in `upgrade()` (or a module-level helper it calls), `op.add_column(t, sa.Column(...))` or
// `batch_op.add_column(sa.Column(...))` on a table that upgrade() does not create, where the Column says
// `nullable=False` or `primary_key=True` and passes no `server_default` (or `server_default=None`). A Column that
// passes `default=` gets the second message.
//   op.add_column("users", sa.Column("nick", sa.String(40), nullable=False))                reported
//   op.add_column("users", sa.Column("tier", sa.String(20), default="free", nullable=False)) reported (default= message)
//   op.add_column("users", sa.Column("code", sa.String(8), primary_key=True))                 reported
//   op.add_column("users", sa.Column("tier", sa.String(20), server_default="free", nullable=False))  not reported
//   op.add_column("users", sa.Column("nick", sa.String(40)))                                  not reported: nullable
// Left alone: a table the same upgrade() creates or empties first (`DELETE FROM t` without WHERE, TRUNCATE); the
// branch of a dialect test that runs only on another database (`else:` of `if _is_pg(conn):`; MySQL fills NOT NULL
// columns with an implicit default); generated columns (`sa.Computed(...)`, `sa.Identity(...)`); an integer
// `primary_key=True` column without `autoincrement=False`, which SQLAlchemy renders as SERIAL/BIGSERIAL on PostgreSQL
// and so numbers the existing rows; downgrade(); tests; files that are no Alembic revision.
// Flags are read by value, not spelling (lib/alembic's al_flag_t: a literal or a module constant, also imported), and
// the type by the class it resolves to (al_pg_type_t: `BigInt = sa.BigInteger`, `from sqlalchemy import Integer as
// Int`, a project TypeDecorator, also imported), so a SERIAL primary key is told apart however its type is spelled. A
// Column bound to a name before add_column (`col = sa.Column(...); op.add_column("users", col)`) is read too
// (al_added_column). An imported constant, type or dialect test is another file's: the Column's flags and type are
// read by its term (al_term), and the finding joins them at the Column.
// Gaps: `nullable=` given as an expression the rule cannot evaluate. A table created by an earlier revision that no
// database has run yet (the same unreleased batch) is still empty, and is reported: the message says when the column
// is safe as written.
// Corpus (8 Alembic repositories): 13 matches, all read, all real; see the README's rule details.

#include "lib/alembic.rerail"

.violation NotNullNoDefault(at: node, col: symbol, table: symbol) "NOT NULL column `{col}` added to existing `{table}` without server_default fails once it has rows. Pass `server_default=`, or add it nullable and set NOT NULL in a later revision. Fine if empty."
.violation NotNullPythonDefault(at: node, col: symbol, table: symbol) "`default=` on NOT NULL column `{col}` never reaches the database, so adding it to existing `{table}` fails once it has rows. Use `server_default=` instead. Fine for a table that is always empty."

// nn_added(col, x, t, d, ct, colt): upgrade adds Column col (named x, of term colt) to existing table t in revision d
// (outside test code), by the add_column call of term ct, outside a non-PostgreSQL branch of its own file, and is no
// generated column.
.decl nn_added(col: node, x: symbol, t: symbol, d: number, ct: symbol, colt: symbol)
nn_added(col, x, t, d, ct, colt) :- al_on_existing(c, "add_column", t, _), al_added_column(c, col),
    al_column_name(col, x), !al_non_pg(c), docof(c, d), al_migration_doc(d), !al_test_doc(d), !nn_generated(col),
    al_term(c, d, ct), al_term(col, d, colt).

// nn_not_null(d, colt): the Column is NOT NULL: `nullable=False`, or a primary key not rendered as SERIAL.
.decl nn_not_null(d: number, colt: symbol)
nn_not_null(d, colt) :- al_flag_t(d, colt, "nullable", "false").
nn_not_null(d, colt) :- al_flag_t(d, colt, "primary_key", "true"), !nn_serial(d, colt),
    !al_flag_t(d, colt, "nullable", "true").

// nn_serial(d, colt): an integer primary key SQLAlchemy renders as SERIAL/BIGSERIAL/SMALLSERIAL on PostgreSQL (its
// type resolves to an integer class, lib/alembic's al_pg_type_t, and autoincrement is not False).
.decl nn_serial(d: number, colt: symbol)
nn_serial(d, colt) :- nn_type_at(d, colt, et), al_pg_type_t(d, et, k), (k = "integer" ; k = "bigint" ; k = "smallint"),
    !al_flag_t(d, colt, "autoincrement", "false").
// nn_type_at(d, colt, et): the Column of term colt has the type expression of term et.
.decl nn_type_at(d: number, colt: symbol, et: symbol)
nn_type_at(d, colt, et) :- al_column_call(col), (call_arg(col, 1, "", a) ; call_arg(col, -1, "type_", a)), unparen(a, e),
    al_term(col, d, colt), al_term(e, d, et).

// nn_default(d, colt, k): `server_default=` (or `default=`) with a value other than None.
.decl nn_default(d: number, colt: symbol, k: symbol)
nn_default(d, colt, k) :- al_kw_at(d, colt, k), (k = "server_default" ; k = "default"),
    !al_flag_t(d, colt, k, "none").

// nn_generated(col): a Computed or Identity column: the database computes its value.
.decl nn_generated(col: node)
nn_generated(col) :- al_column_call(col), call_arg(col, _, "", a), unparen(a, g), kind(g, "call"),
    field(g, "function", f), sym_of(f, q), prefix("sqlalchemy.", q), (suffix(".Computed", q) ; suffix(".Identity", q)).

// A finding joins the Column's own facts to the answers by term: a dialect test of another module (al_np_ext), its
// flags and type (nn_not_null, nn_default).
NotNullNoDefault(col, x, t) :- nn_added(col, x, t, d, ct, colt), !al_np_ext(d, ct), nn_not_null(d, colt),
    !nn_default(d, colt, "server_default"), !nn_default(d, colt, "default").
NotNullPythonDefault(col, x, t) :- nn_added(col, x, t, d, ct, colt), !al_np_ext(d, ct), nn_not_null(d, colt),
    !nn_default(d, colt, "server_default"), nn_default(d, colt, "default").

// The cases, `cases/alembic-practice-not-null-without-server-default/`, read as one repository: each line ending in
// `# caught` is reported, and no other line.
.test cases exactly
    .fixture "app/other_op.py" from "../cases/alembic-practice-not-null-without-server-default/app/other_op.py"
    .fixture "app/schema.py" from "../cases/alembic-practice-not-null-without-server-default/app/schema.py"
    .fixture "migrations/versions/a1_user_columns.py" from "../cases/alembic-practice-not-null-without-server-default/migrations/versions/a1_user_columns.py"
    .fixture "migrations/versions/a2_teams.py" from "../cases/alembic-practice-not-null-without-server-default/migrations/versions/a2_teams.py"
    .fixture "migrations/versions/a3_class_variants.py" from "../cases/alembic-practice-not-null-without-server-default/migrations/versions/a3_class_variants.py"
    .fixture "tests/test_migration_shapes.py" from "../cases/alembic-practice-not-null-without-server-default/tests/test_migration_shapes.py"
    .expect _ at "migrations/versions/a1_user_columns.py":16
    .expect _ at "migrations/versions/a1_user_columns.py":17
    .expect _ at "migrations/versions/a1_user_columns.py":18
    .expect _ at "migrations/versions/a1_user_columns.py":19
    .expect _ at "migrations/versions/a1_user_columns.py":22
    .expect _ at "migrations/versions/a1_user_columns.py":28
    .expect _ at "migrations/versions/a1_user_columns.py":29
    .expect _ at "migrations/versions/a1_user_columns.py":30
    .expect _ at "migrations/versions/a1_user_columns.py":32
    .expect _ at "migrations/versions/a1_user_columns.py":33
    .expect _ at "migrations/versions/a2_teams.py":22
    .expect _ at "migrations/versions/a2_teams.py":43
    .expect _ at "migrations/versions/a3_class_variants.py":21
    .expect _ at "migrations/versions/a3_class_variants.py":23
    .expect _ at "migrations/versions/a3_class_variants.py":24
    .expect _ at "migrations/versions/a3_class_variants.py":33
.end
