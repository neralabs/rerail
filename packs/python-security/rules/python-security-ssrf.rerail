.policy "python-security-ssrf" revision 1
.description "Don't let request data choose the scheme or host of an outgoing HTTP request; allow-list the host or block private addresses at connection time."
.language python
.mode log
.scope include "**/*.py"
// Rerail's own rule, not a port. Client request data (lib/security's sources: Django/DRF `request.GET`/`.POST`/
// `.data`/…, Flask `request.args`/`.get_json()`/…, Starlette `request.query_params`/`.json()`/…, FastAPI and Flask
// route parameters, a pydantic body's fields, Django URL kwargs captured as text) that decides where the server sends
// an HTTP request, in the same function or through the project's own functions across files (a `fetch(url)` wrapper
// around `requests.get(url)` is followed into its parameter), reported at the call that sends the request. The sinks,
// by their URL argument (the first positional, or the second after the method, or `url=`):
//   - `requests.get/post/put/patch/delete/head/options/request`; `httpx.get/…/request/stream`; `urllib3.request`,
//     `aiohttp.request`; `urllib.request.urlopen`, `urlretrieve` and `Request`;
//   - the same methods (and `ws_connect`, `stream`, `urlopen`) on a client: `requests.Session()`,
//     `httpx.Client()`/`AsyncClient()`, `aiohttp.ClientSession()`, `urllib3.PoolManager()`, bound to a name (`s =
//     …`, `with … as s`, `async with`), returned by a function of the run (`get_client().get(url)`), held in
//     `self.<attr>` by the class, or a parameter annotated with the class.
// The value must control the scheme and host: the whole URL is client text (through `str()`, `urljoin`, unquote,
// `.strip()`, `x or DEFAULT`, subscripts and attributes of it), or client text is spliced in where the host is
// still open: lib/security's sec_text_before gives the literal text before the splice (constants of the file
// resolved), and the host is open when that text is empty or has `://` with no `/`, `?` or `#` after it. Only the
// part of a URL that decides where it goes counts: `f"https://{settings.API_HOST}/items/{item_id}"` is left alone.
//   requests.get(request.GET["url"])                                  reported
//   requests.get(f"https://{request.GET['host']}/status")             reported
//   requests.get(API + request.GET["path"])                           reported: API = "https://api.example.com"
//                                                                     has no `/` after its host, so `@evil.com` moves it
//   requests.get(urljoin(API_BASE, target))                           reported: an absolute target replaces the host
//   requests.get(f"{settings.API}/items/{item_id}")                   not reported: the host is fixed
//   requests.post(TOKEN_URL, data={"code": request.GET["code"]})      not reported: an OAuth code exchange
// Left alone, besides the above: a client with a connection-time guard (an httpx `transport=` or aiohttp
// `connector=` built from a class of the run, or a requests session that mounts an adapter class of the run: the
// private-address block a URL-fetching product needs); data sent by staff (lib/security's sec_admin_source: an
// admin-only Django view, ModelAdmin, DRF `IsAdminUser` view or FastAPI route depending on an admin dependency); a
// name its function checks (sec_checked: a check call such as `is_allowed_host(urlparse(url).hostname)`, or an
// allow-list `in` test), also through a chain of names assigned from it (`parsed = urlparse(path); host =
// parsed.netloc; if host not in HOSTS`); a function named like a validator, whose return carries nothing; every
// library call lib/security stops at (`int()`, `urlparse()`…); client data only in `data=`, `json=`, `params=`,
// `headers=`; URLs from settings or the database; test files. Not checks: Django's `URLValidator`,
// `validators.url()`, pydantic `HttpUrl`/`TypeAdapter`, which check the format only (changedetection.io's and
// langflow's advisories), and a block list (`if url in BLOCKED: raise`).
// Overlap: Ruff S310 / Bandit B310 audit only `urlopen`'s scheme, from any source; nothing covers requests, httpx,
// aiohttp or urllib3. Semgrep's Django/Flask `ssrf-requests` rules are single-function `requests.*` searches.
// Gaps: lib/security's (values stored on objects or in the database are not followed; calls the call graph cannot
// resolve). Checks are flow-insensitive and trusted even though resolve-then-check helpers are bypassable by
// redirects and DNS rebinding (Label Studio's and Open WebUI's advisories). A check in a caller clears the value it
// passes on, not a helper that re-reads the request. `BASE + client_text` with BASE a parameter or a setting is left
// alone. A guard adapter or transport is trusted by being the run's own class, not by what it does. Admin
// dependencies are recognised by name.

#include "lib/security.rerail"

.violation Ssrf(at: node, what: symbol, p: symbol, l: number) "Client data from {what} ({p}:{l}) sets this request's host. Allow-list the host, or block private and link-local addresses at connection time with redirects re-checked."
// The functions that send a request are this rule's sinks: a validator-named one is no check.
sec_sink_fn(g) :- ss_sink(c, _), nearest(c, g, fdef).

// ---- where the host ends -----------------------------------------------------------------------------------------
// ss_host_open(pre): literal text pre, before a spliced value, leaves the URL's scheme and host open: it is empty,
// or it holds `://` with no `/`, `?` or `#` after it.
.decl ss_host_open(pre: symbol)
ss_host_open("").
ss_host_open(pre) :- sec_text_before(_, _, pre), contains("://", pre), r = @rx_replace(pre, "(?s)^.*?://", ""),
    !match("(?s).*[/?#].*", r).
// ss_slot(s, a): built string s splices a where it decides the scheme or host.
.decl ss_slot(s: node, a: node)
ss_slot(s, a) :- sec_text_before(s, a, pre), ss_host_open(pre).

// ---- checks ------------------------------------------------------------------------------------------------------
// ss_checked(h, x): scope h checks name x (sec_checked), or checks a name derived, directly or through a chain of
// assignments, from x's own text (`parsed = urlparse(url)`, `host = parsed.netloc`, `host in HOSTS`). A value merely
// computed with x (`response = client.get(url)`, then a check of the response's format) clears nothing.
.decl ss_checked(h: node, x: symbol)
ss_checked(h, x) :- sec_checked(h, x).
ss_checked(h, x) :- ss_checked(h, y), asg(h, y, v, _), ss_derives(v, x), x != y, x != "self", x != "cls",
    x != "request".
// ss_derives(e, x): e's value is name x or a part of it: x itself, an attribute or subscript of it, a method called
// on it (`.strip()`, `.hostname.lower()`), or a URL parse of it (`urlparse(x)`, `urlsplit`, `yarl.URL`, `httpx.URL`,
// a pass-through library call), through parentheses and `await`.
.decl ss_derives(e: node, x: symbol)
ss_derives(e, x) :- ss_dv(e), unparen(e, i), kind(i, "identifier"), text(i, x).
ss_derives(e, x) :- ss_dv(e), unparen(e, a), kind(a, "attribute"), field(a, "object", o), ss_derives(o, x).
ss_derives(e, x) :- ss_dv(e), unparen(e, a), kind(a, "subscript"), field(a, "value", o), ss_derives(o, x).
ss_derives(e, x) :- ss_dv(e), unparen(e, w), kind(w, "await"), child(w, a, 0), ss_derives(a, x).
ss_derives(e, x) :- ss_dv(e), unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, _),
    !ss_parse_call(c), ss_derives(o, x).
ss_derives(e, x) :- ss_dv(e), unparen(e, c), ss_parse_call(c), sec_arg(c, 0, _, a), ss_derives(a, x).
.decl ss_parse_call(c: node)
ss_parse_call(c) :- sec_call_q(c, q), (q = "urllib.parse.urlparse" ; q = "urllib.parse.urlsplit" ;
    q = "yarl.URL" ; q = "httpx.URL" ; q = "furl.furl").
ss_parse_call(c) :- sec_pass_call(c).
// ss_dv(e): the expressions ss_derives reads: assigned values and their parts.
.decl ss_dv(e: node)
ss_dv(v) :- asg(_, _, v, _).
ss_dv(o) :- ss_dv(e), unparen(e, a), (kind(a, "attribute"), field(a, "object", o) ; kind(a, "subscript"),
    field(a, "value", o) ; kind(a, "await"), child(a, o, 0)).
ss_dv(o) :- ss_dv(e), unparen(e, c), kind(c, "call"), field(c, "function", f), attr_of(f, o, _).
ss_dv(a) :- ss_dv(e), unparen(e, c), ss_parse_call(c), sec_arg(c, 0, _, a).

// ---- client text that sets the host ------------------------------------------------------------------------------
// ss_step(e, a): e's whole value holds a's: lib/security's steps that keep the text's start (parentheses, await,
// subscripts, attributes and method calls on it, pass-through library calls such as str() and urljoin(),
// conditionals, and/or, containers), not those that splice it into a larger string.
.decl ss_step(e: node, a: node)
ss_step(p, a) :- sec_step(p, a), (kind(p, "parenthesized_expression") ; kind(p, "await") ; kind(p, "subscript") ;
    kind(p, "attribute") ; kind(p, "conditional_expression") ; kind(p, "boolean_operator") ; sec_container(p) ;
    kind(p, "dictionary") ; kind(p, "list_comprehension") ; kind(p, "generator_expression") ;
    kind(p, "set_comprehension")).
ss_step(c, f) :- kind(c, "call"), field(c, "function", f), attr_of(f, _, _), !sec_typed(c).
ss_step(c, a) :- sec_pass_call(c), call_arg(c, _, _, a).
.decl ss_val(e: node, s: node)
ss_val(e, e) :- sec_source(e, _), !sec_admin_source(e).
ss_val(e, s) :- ss_step(e, a), ss_val(a, s).
ss_val(s, x) :- ss_slot(s, a), ss_val(a, x).
// The left of `+` or `%` starts the URL: `("http://" + host) + "/health"`, a client format string `tpl % x`.
ss_val(b, s) :- kind(b, "binary_operator"), (op(b, "+") ; op(b, "%")), field(b, "left", a), ss_val(a, s).
ss_val(r, s) :- kind(r, "identifier"), text(r, x), look(r, x, h), !ss_checked(h, x), sec_bind(h, x, v), ss_val(v, s),
    r != v.
ss_val(r, s) :- kind(r, "identifier"), text(r, x), look(r, x, g), !ss_checked(g, x), ss_param(g, x, s).
ss_val(e, s) :- attr_of(e, o, a), sec_validated_attr(a), kind(o, "identifier"), text(o, x), look(o, x, h),
    sec_holder_call(h, x, c), call_arg(c, _, _, v), ss_val(v, s).
ss_val(c, s) :- call_target(c, g), ss_returns(g, s), !sec_validator_def(g), call_arg(c, _, _, a), ss_val(a, s).
ss_val(c, s) :- call_target(c, g), ss_returns(g, s), !sec_validator_def(g), ss_own_source(g, s).
.decl ss_param(g: node, x: symbol, s: node)
ss_param(g, x, p) :- sec_route_param(g, x, p), !sec_admin_source(p).
ss_param(g, x, s) :- sec_param_at(_, g, a, x), ss_val(a, s), !sec_checked_expr(a).
.decl ss_returns(g: node, s: node)
ss_returns(g, s) :- kind(r, "return_statement"), child(r, v, 0), nearest(r, g, fdef), ss_val(v, s),
    !sec_checked_expr(v).
.decl ss_own_source(g: node, s: node)
ss_own_source(g, s) :- ss_returns(g, s), within(s, g).
ss_own_source(g, s) :- ss_returns(g, s), ss_reach(g, h), within(s, h).
.decl ss_reach(g: node, h: node)
ss_reach(g, h) :- ss_returns(g, _), calls(g, h).
ss_reach(g, k) :- ss_reach(g, h), calls(h, k).

// ---- HTTP clients ------------------------------------------------------------------------------------------------
// ss_q0(q) / ss_q1(q): module functions whose URL is the first argument / the second (after the method), or `url=`.
.decl ss_q0(q: symbol)
ss_q0(cat("requests.", m)) :- ss_m0(m), m != "ws_connect".
ss_q0(cat("requests.api.", m)) :- ss_m0(m), m != "ws_connect".
ss_q0(cat("httpx.", m)) :- ss_m0(m), m != "ws_connect".
ss_q0("urllib.request.urlopen"). ss_q0("urllib.request.urlretrieve"). ss_q0("urllib.request.Request").
.decl ss_q1(q: symbol)
ss_q1("requests.request"). ss_q1("requests.api.request"). ss_q1("httpx.request"). ss_q1("httpx.stream").
ss_q1("urllib3.request"). ss_q1("aiohttp.request").
// ss_m0(m) / ss_m1(m): client methods whose URL is the first argument / the second.
.decl ss_m0(m: symbol)
ss_m0("get"). ss_m0("post"). ss_m0("put"). ss_m0("patch"). ss_m0("delete"). ss_m0("head"). ss_m0("options").
ss_m0("ws_connect").
.decl ss_m1(m: symbol)
ss_m1("request"). ss_m1("stream"). ss_m1("urlopen").
// ss_client_q(q): HTTP client classes (and requests' `session()` factory).
.decl ss_client_q(q: symbol)
ss_client_q("requests.Session"). ss_client_q("requests.session"). ss_client_q("requests.sessions.Session").
ss_client_q("requests.sessions.session"). ss_client_q("httpx.Client"). ss_client_q("httpx.AsyncClient").
ss_client_q("aiohttp.ClientSession"). ss_client_q("aiohttp.client.ClientSession"). ss_client_q("urllib3.PoolManager").
ss_client_q("urllib3.ProxyManager"). ss_client_q("urllib3.poolmanager.PoolManager").
// ss_client(e): e is an HTTP client: a constructor call, a name bound to one (`s = …`, `with … as s`), a call of a
// function of the run that returns one, a parameter annotated with the class, or `self.<attr>` that its class
// assigns one.
.decl ss_client(e: node)
ss_client(c) :- sec_call_q(c, q), ss_client_q(q).
ss_client(r) :- kind(r, "identifier"), text(r, x), look(r, x, h), sec_bind(h, x, v), unparen(v, v2), ss_client(v2).
ss_client(c) :- call_target(c, g), kind(rs, "return_statement"), child(rs, v, 0), nearest(rs, g, fdef),
    unparen(v, v2), ss_client(v2).
ss_client(r) :- kind(r, "identifier"), text(r, x), look(r, x, g), sig_param(g, _, nm, _, _, a, _), text(nm, x),
    sec_ann(a, t), sym_of(t, q), ss_client_q(q).
ss_client(e) :- attr_of(e, o, at), kind(o, "identifier"), text(o, "self"), nearest(e, f, fdef), nearest(f, k, scope),
    kind(k, "class_definition"), ss_self_client(k, at).
.decl ss_self_client(k: node, at: symbol)
ss_self_client(k, at) :- kind(a, "assignment"), field(a, "left", l), attr_of(l, o, at), kind(o, "identifier"),
    text(o, "self"), field(a, "right", v), unparen(v, v2), ss_client(v2), nearest(a, f, fdef), nearest(f, k, scope),
    kind(k, "class_definition").

// ss_guarded(e): HTTP client e checks where it connects: built with `transport=` (httpx) or `connector=` (aiohttp)
// set to an instance of a class of the run, a name bound to one, a call of a function of the run that returns one,
// or a client its function or class mounts an adapter class of the run on (`s.mount("http://", GuardedAdapter())`).
// Library transports and adapters (`httpx.HTTPTransport(retries=3)`, `HTTPAdapter(max_retries=3)`) guard nothing.
.decl ss_guarded(e: node)
ss_guarded(c) :- ss_client(c), kind(c, "call"), (sec_arg(c, -1, "transport", t) ; sec_arg(c, -1, "connector", t)),
    ss_run_instance(t).
ss_guarded(r) :- kind(r, "identifier"), text(r, x), look(r, x, h), sec_bind(h, x, v), unparen(v, v2), ss_guarded(v2).
ss_guarded(r) :- kind(r, "identifier"), text(r, x), look(r, x, h), ss_client(r), ss_mounts(h, x).
ss_guarded(c) :- call_target(c, g), kind(rs, "return_statement"), child(rs, v, 0), nearest(rs, g, fdef),
    unparen(v, v2), ss_guarded(v2).
ss_guarded(e) :- attr_of(e, o, at), kind(o, "identifier"), text(o, "self"), nearest(e, f, fdef), nearest(f, k, scope),
    kind(k, "class_definition"), ss_self_mounts(k, at).
// ss_mounts(h, x): scope h mounts an adapter class of the run on the client named x.
.decl ss_mounts(h: node, x: symbol)
ss_mounts(h, x) :- kind(m, "call"), field(m, "function", f), attr_of(f, o, "mount"), kind(o, "identifier"), text(o, x),
    (sec_arg(m, 1, _, ad) ; sec_arg(m, -1, "adapter", ad)), ss_run_instance(ad), nearest(m, h, scope).
.decl ss_self_mounts(k: node, at: symbol)
ss_self_mounts(k, at) :- kind(m, "call"), field(m, "function", f), attr_of(f, o, "mount"), attr_of(o, s, at),
    kind(s, "identifier"), text(s, "self"), (sec_arg(m, 1, _, ad) ; sec_arg(m, -1, "adapter", ad)),
    ss_run_instance(ad), nearest(m, g, fdef), nearest(g, k, scope), kind(k, "class_definition").
ss_self_mounts(k, at) :- kind(a, "assignment"), field(a, "left", l), attr_of(l, o, at), kind(o, "identifier"),
    text(o, "self"), field(a, "right", v), unparen(v, v2), ss_guarded(v2), nearest(a, f, fdef), nearest(f, k, scope),
    kind(k, "class_definition").
// ss_run_instance(t): t is an instance of a class of the run: built here, or a name bound to one.
.decl ss_run_instance(t: node)
ss_run_instance(t) :- unparen(t, c), kind(c, "call"), field(c, "function", f), sym_of(f, q), class_def(_, q).
ss_run_instance(r) :- kind(r, "identifier"), text(r, x), look(r, x, h), asg(h, x, v, _), ss_run_instance(v).
// A call of a function of the run that returns one (`transport = _build_transport(…)` returning
// `AsyncSafeTransport(**kwargs)`).
ss_run_instance(t) :- unparen(t, c), kind(c, "call"), call_target(c, g), kind(rs, "return_statement"), child(rs, v, 0),
    nearest(rs, g, fdef), ss_run_instance(v).

// ss_sink(c, e): call c sends an HTTP request to URL e, through no guarded client.
.decl ss_sink(c: node, e: node)
ss_sink(c, e) :- sec_call_q(c, q), ss_q0(q), (sec_arg(c, 0, _, e) ; sec_arg(c, -1, "url", e)).
ss_sink(c, e) :- sec_call_q(c, q), ss_q1(q), (sec_arg(c, 1, _, e) ; sec_arg(c, -1, "url", e)).
ss_sink(c, e) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m), ss_m0(m), unparen(o, o2), ss_client(o2),
    !ss_guarded(o2), (sec_arg(c, 0, _, e) ; sec_arg(c, -1, "url", e)).
ss_sink(c, e) :- kind(c, "call"), field(c, "function", f), attr_of(f, o, m), ss_m1(m), unparen(o, o2), ss_client(o2),
    !ss_guarded(o2), (sec_arg(c, 1, _, e) ; sec_arg(c, -1, "url", e)).
.decl ss_hit(c: node, s: node)
ss_hit(c, s) :- ss_sink(c, e), ss_val(e, s), !sec_checked_expr(e).
.decl ss_live(c: node)
ss_live(c) :- ss_hit(c, _), docof(c, d), !sec_test_doc(d).

Ssrf(c, what, p, l) :- ss_live(c), s = min s2 : { ss_hit(c, s2) }, sec_origin(s, what, p, l).

// The cases, `cases/python-security-ssrf/`, read as one repository: each line ending in `# caught` is reported, and
// no other line.
.test cases exactly
    .fixture "api/__init__.py" from "../cases/python-security-ssrf/api/__init__.py"
    .fixture "api/clients.py" from "../cases/python-security-ssrf/api/clients.py"
    .fixture "api/routes.py" from "../cases/python-security-ssrf/api/routes.py"
    .fixture "bookmarks/__init__.py" from "../cases/python-security-ssrf/bookmarks/__init__.py"
    .fixture "bookmarks/http_client.py" from "../cases/python-security-ssrf/bookmarks/http_client.py"
    .fixture "bookmarks/oauth.py" from "../cases/python-security-ssrf/bookmarks/oauth.py"
    .fixture "bookmarks/security.py" from "../cases/python-security-ssrf/bookmarks/security.py"
    .fixture "bookmarks/services.py" from "../cases/python-security-ssrf/bookmarks/services.py"
    .fixture "bookmarks/tests/__init__.py" from "../cases/python-security-ssrf/bookmarks/tests/__init__.py"
    .fixture "bookmarks/tests/test_views.py" from "../cases/python-security-ssrf/bookmarks/tests/test_views.py"
    .fixture "bookmarks/views.py" from "../cases/python-security-ssrf/bookmarks/views.py"
    .fixture "webapp/__init__.py" from "../cases/python-security-ssrf/webapp/__init__.py"
    .fixture "webapp/app.py" from "../cases/python-security-ssrf/webapp/app.py"
    .fixture "hosts/__init__.py" from "../cases/python-security-ssrf/hosts/__init__.py"
    .fixture "hosts/admin.py" from "../cases/python-security-ssrf/hosts/admin.py"
    .fixture "hosts/aggregates.py" from "../cases/python-security-ssrf/hosts/aggregates.py"
    .fixture "hosts/checks.py" from "../cases/python-security-ssrf/hosts/checks.py"
    .fixture "hosts/guarded.py" from "../cases/python-security-ssrf/hosts/guarded.py"
    .fixture "hosts/http.py" from "../cases/python-security-ssrf/hosts/http.py"
    .expect _ at "api/clients.py":14
    .expect _ at "api/routes.py":25
    .expect _ at "api/routes.py":32
    .expect _ at "api/routes.py":39
    .expect _ at "api/routes.py":45
    .expect _ at "api/routes.py":50
    .expect _ at "api/routes.py":62
    .expect _ at "bookmarks/http_client.py":8
    .expect _ at "bookmarks/http_client.py":12
    .expect _ at "bookmarks/services.py":19
    .expect _ at "bookmarks/views.py":23
    .expect _ at "bookmarks/views.py":28
    .expect _ at "bookmarks/views.py":34
    .expect _ at "bookmarks/views.py":51
    .expect _ at "bookmarks/views.py":56
    .expect _ at "bookmarks/views.py":60
    .expect _ at "bookmarks/views.py":65
    .expect _ at "bookmarks/views.py":71
    .expect _ at "bookmarks/views.py":76
    .expect _ at "bookmarks/views.py":83
    .expect _ at "bookmarks/views.py":90
    .expect _ at "bookmarks/views.py":97
    .expect _ at "bookmarks/views.py":105
    .expect _ at "bookmarks/views.py":116
    .expect _ at "webapp/app.py":16
    .expect _ at "webapp/app.py":23
    .expect _ at "webapp/app.py":29
    .expect _ at "webapp/app.py":34
    .expect _ at "hosts/admin.py":35
    .expect _ at "hosts/admin.py":56
    .expect _ at "hosts/admin.py":75
    .expect _ at "hosts/aggregates.py":25
    .expect _ at "hosts/aggregates.py":33
    .expect _ at "hosts/aggregates.py":47
    .expect _ at "hosts/checks.py":18
    .expect _ at "hosts/checks.py":24
    .expect _ at "hosts/checks.py":30
    .expect _ at "hosts/checks.py":37
    .expect _ at "hosts/checks.py":41
    .expect _ at "hosts/checks.py":66
    .expect _ at "hosts/checks.py":73
    .expect _ at "hosts/checks.py":79
    .expect _ at "hosts/guarded.py":26
    .expect _ at "hosts/guarded.py":36
    .expect _ at "hosts/guarded.py":53
.end
