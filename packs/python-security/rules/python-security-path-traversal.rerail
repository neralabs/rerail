    .expect _ at "api/routes.py":95
    .expect _ at "api/seeding.py":11
    .expect _ at "api/segments.py":39
    .expect _ at "api/segments.py":44
    .expect _ at "api/segments.py":49
    .expect _ at "api/segments.py":54
    .expect _ at "api/segments.py":59
    .expect _ at "api/segments.py":64
