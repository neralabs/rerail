    .fixture "docs/tests/__init__.py" from "../cases/python-security-path-traversal/docs/tests/__init__.py"
    .fixture "docs/tests/test_views.py" from "../cases/python-security-path-traversal/docs/tests/test_views.py"
    .fixture "docs/urls.py" from "../cases/python-security-path-traversal/docs/urls.py"
    .fixture "docs/views.py" from "../cases/python-security-path-traversal/docs/views.py"
