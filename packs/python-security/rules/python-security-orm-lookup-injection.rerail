    .expect _ at "catalog/api.py":33
    .expect _ at "catalog/api.py":40
    .expect _ at "catalog/browse.py":19
    .expect _ at "catalog/browse.py":25
    .expect _ at "catalog/browse.py":26
    .expect _ at "catalog/browse.py":27
    .expect _ at "catalog/browse.py":28
