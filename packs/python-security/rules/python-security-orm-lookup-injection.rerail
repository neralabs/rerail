    .expect _ at "catalog/keys.py":62
    .expect _ at "catalog/queries.py":5
    .expect _ at "catalog/queries.py":9
    .expect _ at "catalog/queries.py":13
    .expect _ at "catalog/routed.py":8
    .expect _ at "catalog/routed.py":18
    .expect _ at "catalog/validated.py":27
    .expect _ at "catalog/validated.py":28
    .expect _ at "catalog/validated.py":29
    .expect _ at "catalog/validated.py":40
    .expect _ at "catalog/views.py":22
    .expect _ at "catalog/views.py":23
    .expect _ at "catalog/views.py":29
    .expect _ at "catalog/views.py":30
    .expect _ at "catalog/views.py":37
    .expect _ at "catalog/views.py":40
    .expect _ at "catalog/views.py":43
    .expect _ at "catalog/views.py":49
    .expect _ at "catalog/views.py":50
    .expect _ at "catalog/views.py":51
    .expect _ at "catalog/views.py":52
    .expect _ at "catalog/views.py":53
    .expect _ at "catalog/views.py":54
    .expect _ at "catalog/views.py":55
    .expect _ at "catalog/views.py":64
