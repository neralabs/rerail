{
  "format": "rerail.policy/v1",
  "id": "ruff-pyi024-collections-named-tuple",
  "revision": 1,
  "mode": "steer",
  "description": "Use typing.NamedTuple instead of collections.namedtuple; it lets each field carry a type annotation that type checkers can analyze.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "collections-named-tuple",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "nt-ref": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "collections.namedtuple"
                    ]
                  },
                  "not": {
                    "inside": {
                      "stopBy": {
                        "not": {
                          "any": [
                            {
                              "kind": "expression_list"
                            },
                            {
                              "kind": "tuple"
                            },
                            {
                              "kind": "list"
                            },
                            {
                              "kind": "parenthesized_expression"
                            }
                          ]
                        }
                      },
                      "kind": "delete_statement"
                    }
                  }
                },
                {
                  "kind": "dotted_name",
                  "regex": "^\\w+\\s*\\.\\s*namedtuple$",
                  "inside": {
                    "stopBy": "end",
                    "kind": "case_pattern"
                  },
                  "has": {
                    "kind": "identifier",
                    "nthChild": 1,
                    "resolves": {
                      "import": [
                        "collections"
                      ]
                    }
                  }
                }
              ]
            },
            "in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "nt-ref",
                      "capture": "NT"
                    },
                    {
                      "matches": "in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "nt-ref",
                "pattern": "$NT"
              },
              {
                "matches": "in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.NT",
        "code": "PYI024",
        "message": "Use `typing.NamedTuple` instead of `collections.namedtuple`: define a class inheriting `typing.NamedTuple` with an annotated field per attribute, or annotate with that class.",
        "each": "NT",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI024"
            ]
          }
        }
      }
    }
  ]
}
