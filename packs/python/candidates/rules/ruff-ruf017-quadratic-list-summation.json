{
  "format": "rerail.policy/v1",
  "id": "ruff-ruf017-quadratic-list-summation",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid flattening lists by summing them onto an empty list; it is quadratic, so chain them with itertools instead.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "quadratic-list-summation",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "callee-sum": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "sum"
                    ],
                    "import": [
                      "builtins.sum"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee-sum"
                  }
                }
              ]
            },
            "callee-list": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "list"
                    ],
                    "import": [
                      "builtins.list"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee-list"
                  }
                }
              ]
            },
            "trivia": {
              "any": [
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                }
              ]
            },
            "not-positional": {
              "any": [
                {
                  "kind": "keyword_argument"
                },
                {
                  "kind": "dictionary_splat"
                },
                {
                  "matches": "trivia"
                },
                {
                  "regex": "^[(),]$"
                }
              ]
            },
            "empty-list": {
              "any": [
                {
                  "kind": "list",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "regex": "^[\\[\\]]$"
                          },
                          {
                            "matches": "trivia"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "call",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "callee-list"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "argument_list",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "not": {
                              "any": [
                                {
                                  "regex": "^[()]$"
                                },
                                {
                                  "matches": "trivia"
                                }
                              ]
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "empty-list"
                  }
                }
              ]
            },
            "list-start": {
              "kind": "argument_list",
              "any": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "keyword_argument",
                    "regex": "^start\\b",
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "empty-list"
                    }
                  },
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "matches": "not-positional"
                        }
                      }
                    }
                  ]
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "keyword_argument",
                      "regex": "^start\\b"
                    }
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "empty-list",
                    "all": [
                      {
                        "follows": {
                          "stopBy": "end",
                          "not": {
                            "matches": "not-positional"
                          }
                        }
                      },
                      {
                        "not": {
                          "follows": {
                            "stopBy": "end",
                            "follows": {
                              "stopBy": "end",
                              "not": {
                                "matches": "not-positional"
                              }
                            },
                            "not": {
                              "matches": "not-positional"
                            }
                          }
                        }
                      },
                      {
                        "not": {
                          "follows": {
                            "stopBy": "end",
                            "kind": "list_splat"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "summation": {
              "kind": "call",
              "all": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee-sum"
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "list-start"
                  }
                }
              ]
            },
            "in-annotation": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "summation",
                      "capture": "C"
                    },
                    {
                      "matches": "in-annotation"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "summation",
                "pattern": "$C"
              },
              {
                "matches": "in-annotation"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "RUF017",
        "message": "Replace `sum(lists, [])` with `list(itertools.chain.from_iterable(lists))`; summing onto a list copies it at every step (quadratic). Leave it when the input is only a few short lists.",
        "each": "C",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF017"
            ]
          }
        }
      }
    }
  ]
}
