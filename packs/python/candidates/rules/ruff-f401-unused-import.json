{
  "format": "rerail.policy/v1",
  "id": "ruff-f401-unused-import",
  "revision": 1,
  "mode": "steer",
  "description": "Remove Python imports that are never used, or re-export them explicitly with an as-alias or __all__; unused imports add clutter and load time.",
  "scope": {
    "include": [
      "**/*.py",
      "**/*.pyi"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "options",
      "define": {
        "options": {
          "pyflakes.allowed-unused-imports": {
            "type": "array",
            "items": "string",
            "default": [],
            "description": "Modules whose imports may be unused, with their submodules and members."
          }
        }
      }
    },
    {
      "id": "unused-import",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "dotted_name"
              },
              {
                "kind": "identifier"
              }
            ],
            "pattern": "$NAME",
            "binds": {
              "form": "import",
              "scope": [
                "module",
                "function"
              ],
              "latest": true,
              "used": false,
              "exported": false,
              "outer": false
            },
            "not": {
              "any": [
                {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "future_import_statement"
                      },
                      {
                        "kind": "import_from_statement",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "relative_import",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "dotted_name",
                            "regex": "^__future__$"
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "$option": "pyflakes.allowed-unused-imports",
                  "cases": {
                    "[]": []
                  },
                  "default": [
                    {
                      "kind": "dotted_name",
                      "resolves": {
                        "imported": {
                          "$option": "pyflakes.allowed-unused-imports"
                        },
                        "prefix": true
                      }
                    },
                    {
                      "kind": "identifier",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "aliased_import",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "dotted_name",
                          "resolves": {
                            "imported": {
                              "$option": "pyflakes.allowed-unused-imports"
                            },
                            "prefix": true
                          }
                        }
                      }
                    }
                  ],
                  "spread": true
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F401",
        "message": "Remove the unused import `$NAME`, or list it in __all__ if it is meant to be re-exported.",
        "suppress": {
          "noqa": {
            "codes": [
              "F401"
            ],
            "parent": "statement"
          }
        }
      }
    }
  ]
}
