{
  "format": "rerail.policy/v1",
  "id": "ruff-pt027-pytest-unittest-raises-assertion",
  "revision": 1,
  "mode": "steer",
  "description": "Use pytest.raises instead of assertRaises-style methods such as assertRaises and assertRaisesRegex; it is the exception-testing style pytest recommends.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "pytest-unittest-raises-assertion",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "callee-position": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "call",
                    "pattern": "$CALL"
                  },
                  "precedes": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "argument_list"
                      },
                      {
                        "kind": "generator_expression"
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "callee-position"
                  }
                }
              ]
            },
            "context-with-target": {
              "inside": {
                "stopBy": {
                  "not": {
                    "kind": "parenthesized_expression"
                  }
                },
                "kind": "as_pattern",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "with_item"
                },
                "has": {
                  "stopBy": "neighbor",
                  "kind": "as_pattern_target",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "plain-name"
                    }
                  }
                }
              }
            },
            "plain-name": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "plain-name"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "attribute",
            "has": {
              "field": "attribute",
              "pattern": "$ASSERTION",
              "regex": "^(assertRaises|failUnlessRaises|assertRaisesRegex|assertRaisesRegexp)$"
            },
            "matches": "callee-position"
          },
          "constraints": {
            "CALL": {
              "not": {
                "matches": "context-with-target"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PT027",
        "message": "Use `pytest.raises` instead of `$ASSERTION`: a regex goes in `match=` and an `as` target's `.exception` becomes `.value`. Leave it in tests that don't run under pytest.",
        "suppress": {
          "noqa": {
            "codes": [
              "PT027"
            ]
          }
        }
      }
    }
  ]
}
