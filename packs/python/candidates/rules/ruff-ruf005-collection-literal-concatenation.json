{
  "format": "rerail.policy/v1",
  "id": "ruff-ruf005-collection-literal-concatenation",
  "revision": 1,
  "mode": "steer",
  "description": "Prefer iterable unpacking over adding a list or tuple literal to another collection with the plus operator; it reads better and accepts any iterable.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "collection-literal-concatenation",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "splat-ok": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                },
                {
                  "kind": "call"
                },
                {
                  "kind": "subscript",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "subscript",
                    "kind": "slice"
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "splat-ok"
                  }
                }
              ]
            },
            "list-expr": {
              "any": [
                {
                  "kind": "list"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "list-expr"
                  }
                },
                {
                  "matches": "list-add"
                }
              ]
            },
            "tuple-expr": {
              "any": [
                {
                  "kind": "tuple"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-expr"
                  }
                },
                {
                  "matches": "tuple-add"
                }
              ]
            },
            "list-add": {
              "kind": "binary_operator",
              "has": {
                "field": "operator",
                "regex": "^\\+$"
              },
              "any": [
                {
                  "all": [
                    {
                      "has": {
                        "field": "left",
                        "matches": "list-expr"
                      }
                    },
                    {
                      "has": {
                        "field": "right",
                        "any": [
                          {
                            "matches": "splat-ok"
                          },
                          {
                            "matches": "list-expr"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "has": {
                        "field": "left",
                        "matches": "splat-ok"
                      }
                    },
                    {
                      "has": {
                        "field": "right",
                        "matches": "list-expr"
                      }
                    }
                  ]
                }
              ]
            },
            "tuple-add": {
              "kind": "binary_operator",
              "has": {
                "field": "operator",
                "regex": "^\\+$"
              },
              "any": [
                {
                  "all": [
                    {
                      "has": {
                        "field": "left",
                        "matches": "tuple-expr"
                      }
                    },
                    {
                      "has": {
                        "field": "right",
                        "any": [
                          {
                            "matches": "splat-ok"
                          },
                          {
                            "matches": "tuple-expr"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "has": {
                        "field": "left",
                        "matches": "splat-ok"
                      }
                    },
                    {
                      "has": {
                        "field": "right",
                        "matches": "tuple-expr"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "kind": "binary_operator",
            "has": {
              "field": "operator",
              "regex": "^\\+$"
            },
            "any": [
              {
                "matches": "list-add"
              },
              {
                "matches": "tuple-add"
              }
            ],
            "not": {
              "inside": {
                "stopBy": {
                  "not": {
                    "kind": "parenthesized_expression"
                  }
                },
                "kind": "binary_operator",
                "has": {
                  "field": "operator",
                  "regex": "^\\+$"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RUF005",
        "message": "Write one literal with unpacking, such as `[*a, 1, *b]` or `(*a, 1)`, instead of adding collections with `+`. Keep `+` if an operand defines its own `__add__`.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF005"
            ]
          }
        }
      }
    }
  ]
}
