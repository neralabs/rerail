{
  "format": "rerail.policy/v1",
  "id": "bandit-b613-trojansource",
  "revision": 1,
  "mode": "steer",
  "description": "Closest AST-only approximation of Bandit B613; detects bidirectional-control characters in parsed Python string literals.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bidi-control-in-string-literal",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "all": [
              {
                "kind": "string"
              },
              {
                "regex": "[‏‪‫‬‭‮⁦⁧⁨⁩]"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B613",
        "anchor": "witness.span",
        "message": "Python string literal contains a bidirectional-control character.",
        "suppress": {
          "nosec": {
            "codes": [
              "B613"
            ]
          }
        }
      }
    }
  ]
}
