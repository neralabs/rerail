{
  "id": "bandit:b501",
  "format": "rerail.policy/v1",
  "revision": 4,
  "mode": "steer",
  "description": "Detect requests HTTP-verb calls and httpx request/stream/client calls whose verify keyword is the literal False (or the string 'False'), reading the callee's root as Bandit's call qualname does: through the head's import alias, with relative imports named by their module text and the dots ignored, and otherwise by the head's own text.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B501",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "requests-name": {
              "kind": "identifier",
              "regex": "^(get|options|head|post|put|patch|delete)$"
            },
            "httpx-name": {
              "kind": "identifier",
              "regex": "^(get|options|head|post|put|patch|delete|request|stream|Client|AsyncClient)$"
            },
            "requests-import-site": {
              "any": [
                {
                  "kind": "dotted_name",
                  "resolves": {
                    "imported": [
                      "requests"
                    ],
                    "prefix": true,
                    "relative": "text"
                  }
                },
                {
                  "kind": "aliased_import",
                  "has": {
                    "field": "name",
                    "stopBy": "neighbor",
                    "kind": "dotted_name",
                    "resolves": {
                      "imported": [
                        "requests"
                      ],
                      "prefix": true,
                      "relative": "text"
                    }
                  }
                }
              ]
            },
            "httpx-import-site": {
              "any": [
                {
                  "kind": "dotted_name",
                  "resolves": {
                    "imported": [
                      "httpx"
                    ],
                    "prefix": true,
                    "relative": "text"
                  }
                },
                {
                  "kind": "aliased_import",
                  "has": {
                    "field": "name",
                    "stopBy": "neighbor",
                    "kind": "dotted_name",
                    "resolves": {
                      "imported": [
                        "httpx"
                      ],
                      "prefix": true,
                      "relative": "text"
                    }
                  }
                }
              ]
            },
            "requests-root": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^requests$",
                  "not": {
                    "resolves": {
                      "binding": {
                        "form": "import"
                      }
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "form": "import",
                      "site": {
                        "matches": "requests-import-site"
                      }
                    }
                  }
                },
                {
                  "kind": "attribute",
                  "has": {
                    "field": "object",
                    "stopBy": "neighbor",
                    "matches": "requests-root"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "requests-root"
                  }
                }
              ]
            },
            "httpx-root": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^httpx$",
                  "not": {
                    "resolves": {
                      "binding": {
                        "form": "import"
                      }
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "form": "import",
                      "site": {
                        "matches": "httpx-import-site"
                      }
                    }
                  }
                },
                {
                  "kind": "attribute",
                  "has": {
                    "field": "object",
                    "stopBy": "neighbor",
                    "matches": "httpx-root"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "httpx-root"
                  }
                }
              ]
            },
            "requests-import-item": {
              "any": [
                {
                  "kind": "dotted_name",
                  "regex": "^(get|options|head|post|put|patch|delete)$"
                },
                {
                  "kind": "aliased_import",
                  "has": {
                    "field": "name",
                    "stopBy": "neighbor",
                    "kind": "dotted_name",
                    "regex": "(^|\\.)\\s*(get|options|head|post|put|patch|delete)$"
                  }
                }
              ]
            },
            "httpx-import-item": {
              "any": [
                {
                  "kind": "dotted_name",
                  "regex": "^(get|options|head|post|put|patch|delete|request|stream|Client|AsyncClient)$"
                },
                {
                  "kind": "aliased_import",
                  "has": {
                    "field": "name",
                    "stopBy": "neighbor",
                    "kind": "dotted_name",
                    "regex": "(^|\\.)\\s*(get|options|head|post|put|patch|delete|request|stream|Client|AsyncClient)$"
                  }
                }
              ]
            },
            "requests-callee": {
              "any": [
                {
                  "kind": "attribute",
                  "all": [
                    {
                      "has": {
                        "field": "attribute",
                        "stopBy": "neighbor",
                        "matches": "requests-name"
                      }
                    },
                    {
                      "has": {
                        "field": "object",
                        "stopBy": "neighbor",
                        "matches": "requests-root"
                      }
                    }
                  ]
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "form": "import",
                      "site": {
                        "all": [
                          {
                            "matches": "requests-import-item"
                          },
                          {
                            "matches": "requests-import-site"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "requests-callee"
                  }
                }
              ]
            },
            "httpx-callee": {
              "any": [
                {
                  "kind": "attribute",
                  "all": [
                    {
                      "has": {
                        "field": "attribute",
                        "stopBy": "neighbor",
                        "matches": "httpx-name"
                      }
                    },
                    {
                      "has": {
                        "field": "object",
                        "stopBy": "neighbor",
                        "matches": "httpx-root"
                      }
                    }
                  ]
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "form": "import",
                      "site": {
                        "all": [
                          {
                            "matches": "httpx-import-item"
                          },
                          {
                            "matches": "httpx-import-site"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "httpx-callee"
                  }
                }
              ]
            },
            "false-literal": {
              "any": [
                {
                  "kind": "false"
                },
                {
                  "any": [
                    {
                      "kind": "string"
                    },
                    {
                      "kind": "concatenated_string"
                    }
                  ],
                  "value": {
                    "type": "str",
                    "eq": "False"
                  },
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "string_start",
                      "regex": "[fFtT]"
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "false-literal"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "all": [
              {
                "has": {
                  "field": "function",
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "matches": "requests-callee"
                    },
                    {
                      "matches": "httpx-callee"
                    }
                  ]
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "stopBy": "neighbor",
                  "kind": "argument_list",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "keyword_argument",
                    "all": [
                      {
                        "has": {
                          "field": "name",
                          "stopBy": "neighbor",
                          "regex": "^verify$"
                        }
                      },
                      {
                        "has": {
                          "field": "value",
                          "stopBy": "neighbor",
                          "matches": "false-literal",
                          "pattern": "$VERIFY"
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "message": "Certificate verification is explicitly disabled",
        "anchor": "capture.VERIFY",
        "code": "B501"
      }
    }
  ]
}
