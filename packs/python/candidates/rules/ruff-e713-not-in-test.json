{
  "format": "rerail.policy/v1",
  "id": "ruff-e713-not-in-test",
  "revision": 1,
  "mode": "steer",
  "description": "Use x not in y instead of not x in y for membership tests; it reads clearly and avoids precedence confusion.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "not-in-test",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "negated": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "not_operator"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "negated"
                  }
                }
              ]
            },
            "test": {
              "kind": "comparison_operator",
              "all": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^in$"
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^(?:<|<=|==|!=|>=|>|<>|not[\\s\\\\]+in|is|is[\\s\\\\]+not)$"
                    }
                  }
                },
                {
                  "not": {
                    "count": {
                      "has": {
                        "stopBy": "neighbor",
                        "regex": "^in$"
                      },
                      "min": 2
                    }
                  }
                },
                {
                  "matches": "negated"
                }
              ]
            },
            "test-in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "test",
                      "capture": "C"
                    },
                    {
                      "matches": "test-in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "test",
                "pattern": "$C"
              },
              {
                "matches": "test-in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "E713",
        "message": "Rewrite this as `x not in y` instead of `not x in y`.",
        "each": "C",
        "suppress": {
          "noqa": {
            "codes": [
              "E713"
            ]
          }
        }
      }
    }
  ]
}
