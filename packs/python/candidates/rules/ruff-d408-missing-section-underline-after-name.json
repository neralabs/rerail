{
 "format": "rerail.policy/v1",
 "id": "ruff-d408-missing-section-underline-after-name",
 "revision": 1,
 "mode": "steer",
 "description": "Put a section underline on the line directly below the section name, with no blank line between them.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "underline-after-blank-shared",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "docstring": {
       "kind": "string",
       "not": {
        "has": {
         "stopBy": "neighbor",
         "kind": "string_start",
         "regex": "[bBfFtT]"
        }
       },
       "inside": {
        "stopBy": {
         "not": {
          "kind": "parenthesized_expression"
         }
        },
        "kind": "expression_statement",
        "not": {
         "any": [
          {
           "has": {
            "stopBy": "neighbor",
            "regex": "^,$"
           }
          },
          {
           "follows": {
            "stopBy": "end",
            "not": {
             "kind": "comment"
            }
           }
          }
         ]
        },
        "inside": {
         "stopBy": "neighbor",
         "any": [
          {
           "kind": "module"
          },
          {
           "kind": "block",
           "inside": {
            "stopBy": "neighbor",
            "any": [
             {
              "kind": "function_definition"
             },
             {
              "kind": "class_definition"
             }
            ]
           }
          }
         ]
        }
       }
      }
     },
     "rule": {
      "kind": "string_content",
      "all": [
       {
        "inside": {
         "stopBy": "neighbor",
         "matches": "docstring",
         "not": {
          "value": {
           "regex": "\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[ \\t]*(?:\\n|\\z)"
          }
         }
        }
       },
       {
        "any": [
         {
          "regex": "(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttributes)|E(?i:xamples)|M(?i:ethods)|N(?i:otes)|R(?i:eferences|eturns|aises)|S(?i:ee also)|W(?i:arnings|arns)|Y(?i:ields)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "(?:[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:a(?i:ttributes)|e(?i:xamples)|m(?i:ethods)|n(?i:otes)|r(?i:eferences|eturns|aises)|s(?i:ee also)|w(?i:arnings|arns)|y(?i:ields)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+\\n[^\\S\\n]*(?P<NAME>-+)[^\\S\\n]*(?m:$))|\\n[^\\S\\n]*(?i:keyword arguments|extended summary|other parameters|other arguments|short summary|other params|keyword args|attributes|references|parameters|other args|arguments|attention|important|examples|see also|warnings|receives|methods|returns|caution|example|warning|raises|yields|danger|return|notes|warns|error|yield|args|hint|note|todo|tip):?[^\\S\\n]*(?m:$)(?s:.*)"
         }
        ]
       }
      ]
     }
    }
   },
