{
  "format": "rerail.policy/v1",
  "id": "ruff-sim108-if-else-block-instead-of-if-exp",
  "revision": 1,
  "mode": "steer",
  "description": "Use a conditional expression instead of an if/else whose two branches only assign to the same variable.",
  "scope": {
    "include": [
      "**/*.py",
      "**/*.pyi"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "if-else-block-instead-of-if-exp",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "name-assign": {
              "kind": "expression_statement",
              "has": {
                "stopBy": "neighbor",
                "kind": "assignment",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^:$"
                  }
                },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "identifier",
                      "precedes": {
                        "stopBy": "neighbor",
                        "regex": "^=$"
                      },
                      "pattern": "$N"
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "^=$"
                      },
                      "not": {
                        "any": [
                          {
                            "any": [
                              {
                                "kind": "assignment"
                              },
                              {
                                "kind": "yield"
                              },
                              {
                                "kind": "await"
                              }
                            ]
                          },
                          {
                            "kind": "parenthesized_expression",
                            "has": {
                              "stopBy": "neighbor",
                              "any": [
                                {
                                  "kind": "yield"
                                },
                                {
                                  "kind": "await"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "sys-version": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "sys.version_info",
                  "sys.platform"
                ]
              }
            }
          },
          "rule": {
            "kind": "if_statement",
            "not": {
              "has": {
                "stopBy": "neighbor",
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "^if$"
                },
                "any": [
                  {
                    "has": {
                      "stopBy": "end",
                      "matches": "sys-version"
                    }
                  },
                  {
                    "matches": "sys-version"
                  },
                  {
                    "any": [
                      {
                        "kind": "identifier",
                        "regex": "^TYPE_CHECKING$"
                      },
                      {
                        "kind": "identifier",
                        "resolves": {
                          "import": [
                            "typing.TYPE_CHECKING",
                            "_typeshed.TYPE_CHECKING",
                            "typing_extensions.TYPE_CHECKING"
                          ]
                        }
                      },
                      {
                        "kind": "attribute",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "identifier",
                          "regex": "^TYPE_CHECKING$",
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "^\\.$"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            },
            "count": {
              "has": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "elif_clause"
                  },
                  {
                    "kind": "else_clause"
                  }
                ]
              },
              "min": 1,
              "max": 1
            },
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "block",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "kind": "comment"
                          },
                          {
                            "kind": "line_continuation"
                          },
                          {
                            "regex": "^;$"
                          }
                        ]
                      }
                    },
                    "min": 1,
                    "max": 1
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "all": [
                      {
                        "not": {
                          "any": [
                            {
                              "kind": "comment"
                            },
                            {
                              "kind": "line_continuation"
                            },
                            {
                              "regex": "^;$"
                            }
                          ]
                        }
                      },
                      {
                        "matches": "name-assign"
                      }
                    ]
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "else_clause",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "block",
                    "count": {
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "any": [
                            {
                              "kind": "comment"
                            },
                            {
                              "kind": "line_continuation"
                            },
                            {
                              "regex": "^;$"
                            }
                          ]
                        }
                      },
                      "min": 1,
                      "max": 1
                    },
                    "has": {
                      "stopBy": "neighbor",
                      "all": [
                        {
                          "not": {
                            "any": [
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "line_continuation"
                              },
                              {
                                "regex": "^;$"
                              }
                            ]
                          }
                        },
                        {
                          "matches": "name-assign"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM108",
        "message": "Replace this `if`/`else` with one assignment, `$N = a if condition else b`.",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM108"
            ]
          }
        }
      }
    }
  ]
}
