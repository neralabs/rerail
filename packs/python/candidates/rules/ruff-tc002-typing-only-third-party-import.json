{
  "format": "rerail.policy/v1",
  "id": "ruff-tc002-typing-only-third-party-import",
  "revision": 1,
  "mode": "steer",
  "description": "Move third-party imports that only annotate types into an if TYPE_CHECKING block; this avoids importing them at runtime.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "typing-only-import",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "path": {
              "notRegex": "\\.pyi$"
            }
          },
          "utils": {
            "type-checking-test": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^TYPE_CHECKING$"
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "import": [
                      "typing.TYPE_CHECKING",
                      "typing_extensions.TYPE_CHECKING"
                    ]
                  }
                },
                {
                  "kind": "attribute",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "attribute",
                    "regex": "^TYPE_CHECKING$"
                  }
                }
              ]
            },
            "in-type-checking-block": {
              "inside": {
                "stopBy": "end",
                "field": "consequence",
                "kind": "if_statement",
                "has": {
                  "stopBy": "neighbor",
                  "field": "condition",
                  "matches": "type-checking-test"
                }
              }
            },
            "future-annotations": {
              "inside": {
                "stopBy": "end",
                "kind": "module",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "future_import_statement"
                }
              }
            },
            "singledispatch-impl": {
              "kind": "function_definition",
              "inside": {
                "stopBy": "neighbor",
                "kind": "decorated_definition",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "decorator",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "attribute",
                    "all": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "field": "attribute",
                          "regex": "^register$"
                        }
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "field": "object",
                          "kind": "identifier",
                          "resolves": {
                            "binding": {
                              "form": "definition",
                              "site": {
                                "kind": "function_definition",
                                "inside": {
                                  "stopBy": "neighbor",
                                  "kind": "decorated_definition",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "kind": "decorator",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "resolves": {
                                        "import": [
                                          "functools.singledispatch",
                                          "functools.singledispatchmethod"
                                        ]
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "dispatch-annotation": {
              "any": [
                {
                  "inside": {
                    "stopBy": "end",
                    "field": "type",
                    "any": [
                      {
                        "kind": "typed_parameter",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "list_splat_pattern"
                              },
                              {
                                "kind": "dictionary_splat_pattern"
                              }
                            ]
                          }
                        }
                      },
                      {
                        "kind": "typed_default_parameter"
                      }
                    ],
                    "inside": {
                      "stopBy": "end",
                      "field": "parameters",
                      "kind": "function_definition",
                      "matches": "singledispatch-impl"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "field": "return_type",
                    "kind": "function_definition",
                    "matches": "singledispatch-impl"
                  }
                }
              ]
            },
            "typing-only-annotation": {
              "any": [
                {
                  "inside": {
                    "stopBy": "end",
                    "field": "type",
                    "kind": "assignment",
                    "inside": {
                      "stopBy": {
                        "any": [
                          {
                            "kind": "function_definition"
                          },
                          {
                            "kind": "class_definition"
                          }
                        ]
                      },
                      "kind": "function_definition"
                    }
                  }
                },
                {
                  "matches": "future-annotations",
                  "not": {
                    "matches": "dispatch-annotation"
                  },
                  "any": [
                    {
                      "inside": {
                        "stopBy": "end",
                        "field": "type",
                        "any": [
                          {
                            "kind": "assignment"
                          },
                          {
                            "kind": "typed_parameter"
                          },
                          {
                            "kind": "typed_default_parameter"
                          }
                        ]
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "end",
                        "field": "return_type",
                        "kind": "function_definition"
                      }
                    }
                  ]
                }
              ]
            },
            "runtime-ref": {
              "params": [
                "S"
              ],
              "rule": {
                "kind": "identifier",
                "resolves": {
                  "binding": {
                    "form": "import",
                    "site": {
                      "pattern": "$RS"
                    }
                  }
                },
                "compare": {
                  "left": "S",
                  "op": "eq",
                  "right": "RS",
                  "text": "node"
                },
                "not": {
                  "any": [
                    {
                      "matches": "in-type-checking-block"
                    },
                    {
                      "matches": "typing-only-annotation"
                    }
                  ]
                }
              }
            },
            "import-key": {
              "params": [
                "K"
              ],
              "rule": {
                "any": [
                  {
                    "kind": "dotted_name",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "import_statement"
                    },
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "identifier",
                      "nthChild": 1,
                      "pattern": "$K"
                    }
                  },
                  {
                    "kind": "identifier",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "aliased_import",
                      "has": {
                        "stopBy": "neighbor",
                        "field": "name",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "identifier",
                          "nthChild": 1,
                          "pattern": "$K"
                        }
                      },
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "import_statement"
                      }
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "end",
                      "kind": "import_from_statement",
                      "has": {
                        "stopBy": "neighbor",
                        "field": "module_name",
                        "pattern": "$K"
                      }
                    }
                  }
                ]
              }
            },
            "runtime-import": {
              "params": [
                "S",
                "KB"
              ],
              "rule": {
                "any": [
                  {
                    "kind": "dotted_name"
                  },
                  {
                    "kind": "identifier"
                  }
                ],
                "binds": {
                  "form": "import",
                  "scope": [
                    "module",
                    "function"
                  ],
                  "latest": true,
                  "site": {
                    "pattern": "$RSITE"
                  }
                },
                "matches": {
                  "import-key": {
                    "K": "$KR"
                  }
                },
                "all": [
                  {
                    "compare": {
                      "left": "KB",
                      "op": "eq",
                      "right": "KR"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": {
                        "any": [
                          {
                            "kind": "function_definition"
                          },
                          {
                            "kind": "module"
                          }
                        ]
                      },
                      "any": [
                        {
                          "kind": "function_definition"
                        },
                        {
                          "kind": "module"
                        }
                      ],
                      "pattern": "$RS"
                    }
                  },
                  {
                    "compare": {
                      "left": "S",
                      "op": "eq",
                      "right": "RS",
                      "text": "node"
                    }
                  },
                  {
                    "not": {
                      "matches": "in-type-checking-block"
                    }
                  },
                  {
                    "any": [
                      {
                        "binds": {
                          "exported": true
                        }
                      },
                      {
                        "inside": {
                          "stopBy": "end",
                          "kind": "module",
                          "has": {
                            "stopBy": "end",
                            "matches": {
                              "runtime-ref": {
                                "S": "$RSITE"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          },
          "rule": {
            "any": [
              {
                "kind": "dotted_name"
              },
              {
                "kind": "identifier"
              }
            ],
            "pattern": "$NAME",
            "binds": {
              "form": "import",
              "scope": [
                "module",
                "function"
              ],
              "latest": true,
              "used": true,
              "exported": false,
              "site": {
                "pattern": "$SITE"
              }
            },
            "matches": {
              "import-key": {
                "K": "$KB"
              }
            },
            "not": {
              "any": [
                {
                  "matches": "in-type-checking-block"
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "future_import_statement"
                  }
                },
                {
                  "any": [
                    {
                      "kind": "dotted_name",
                      "regex": "^(?:typing|typing_extensions)(?:\\.|$)",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "import_statement"
                      }
                    },
                    {
                      "kind": "identifier",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "aliased_import",
                        "has": {
                          "stopBy": "neighbor",
                          "field": "name",
                          "regex": "^(?:typing|typing_extensions)(?:\\.|$)"
                        },
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "import_statement"
                        }
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "end",
                        "kind": "import_from_statement",
                        "has": {
                          "stopBy": "neighbor",
                          "field": "module_name",
                          "regex": "^(?:typing|typing_extensions)(?:\\.|$)"
                        }
                      }
                    }
                  ]
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "module"
                      }
                    ],
                    "pattern": "$S",
                    "has": {
                      "stopBy": "end",
                      "matches": {
                        "runtime-import": {
                          "S": "$S",
                          "KB": "$KB"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "inside": {
              "stopBy": "end",
              "kind": "module",
              "not": {
                "has": {
                  "stopBy": "end",
                  "matches": {
                    "runtime-ref": {
                      "S": "$SITE"
                    }
                  }
                }
              }
            },
            "all": [
              {
                "not": {
                  "any": [
