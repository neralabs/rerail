                        "has": {
                          "stopBy": "neighbor",
                          "kind": "argument_list",
                          "regex": "^\\(\\s*\\)$"
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "any": [
                        {
                          "matches": "safe-binop-operand"
                        },
                        {
                          "regex": "^(\\+|-|\\*|/|//|%|\\*\\*|<<|>>|&|\\||\\^|@)$"
