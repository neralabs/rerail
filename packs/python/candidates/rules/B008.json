{
  "format": "rerail.policy/v1",
  "id": "ruff:B008",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's B008 (function-call-in-default-argument): every call inside a parameter default (of a `def` or a `lambda`), not looking inside lambdas, unless the parameter's annotation is immutable (Ruff's `is_immutable_annotation`, as in B006) or the callee is a known mutable constructor (`dict`/`list`/`set`, `collections.Counter`/`OrderedDict`/`defaultdict`/`deque`) or immutable-returning callable (`datetime` types, `decimal.Decimal`, `fractions.Fraction`, `operator` getters, `pathlib.Path`, `types.MappingProxyType`, `re.compile`, immutable builtins; a subscripted callee judged by its value). Names resolve with `resolves` (imports, their scope and order, and unshadowed builtins, as Ruff's semantic model sees them); `builtins.X` counts only where Ruff's table lists it. A bare-name callee whose binding (`resolves.binding`) is `X = NewType(name, <immutable annotation>)` (Ruff's `is_immutable_newtype_call`: a plain assignment, the type as `tp=` or the second positional argument) is exempt where that binding shadows no earlier binding of the name in its scope (Ruff's only_binding: `resolves.binding` with `only`) and is not an unpacking. Reported on each call. Ruff's option `flake8-bugbear.extend-immutable-calls` adds immutable calls and annotations.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "options",
      "define": {
        "options": {
          "flake8-bugbear.extend-immutable-calls": {
            "type": "array",
            "items": "string",
            "default": [],
            "description": "Qualified names of further calls that return immutable values."
          }
        }
      }
    },
    {
      "id": "function-call-in-default-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "immutable-name": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "global": [
                  "bool",
                  "bytes",
                  "complex",
                  "float",
                  "int",
                  "object",
                  "range",
                  "str",
                  "frozenset",
                  "tuple",
                  "frozendict"
                ],
                "import": [
                  "collections.abc.Sized",
                  "typing.LiteralString",
                  "typing.Sized",
                  "builtins.frozenset",
                  "builtins.tuple",
                  "builtins.frozendict",
                  "collections.abc.ByteString",
                  "collections.abc.Collection",
                  "collections.abc.Container",
                  "collections.abc.Iterable",
                  "collections.abc.Mapping",
                  "collections.abc.Reversible",
                  "collections.abc.Sequence",
                  "collections.abc.Set",
                  "typing.AbstractSet",
                  "typing.ByteString",
                  "typing.Callable",
                  "typing.Collection",
                  "typing.Container",
                  "typing.FrozenSet",
                  "typing.Iterable",
                  "typing.Literal",
                  "typing.Mapping",
                  "typing.Never",
                  "typing.NoReturn",
                  "typing.Reversible",
                  "typing.Sequence",
                  "typing.Tuple",
                  {
                    "$option": "flake8-bugbear.extend-immutable-calls",
                    "spread": true
                  }
                ]
              }
            },
            "immutable-generic": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "global": [
                  "frozenset",
                  "tuple",
                  "frozendict"
                ],
                "import": [
                  "builtins.frozenset",
                  "builtins.tuple",
                  "builtins.frozendict",
                  "collections.abc.ByteString",
                  "collections.abc.Collection",
                  "collections.abc.Container",
                  "collections.abc.Iterable",
                  "collections.abc.Mapping",
                  "collections.abc.Reversible",
                  "collections.abc.Sequence",
                  "collections.abc.Set",
                  "typing.AbstractSet",
                  "typing.ByteString",
                  "typing.Callable",
                  "typing.Collection",
                  "typing.Container",
                  "typing.FrozenSet",
                  "typing.Iterable",
                  "typing.Literal",
                  "typing.Mapping",
                  "typing.Never",
                  "typing.NoReturn",
                  "typing.Reversible",
                  "typing.Sequence",
                  "typing.Tuple"
                ]
              }
            },
            "ref-typing-union": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "typing.Union"
                ]
              }
            },
            "ref-typing-optional": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "typing.Optional"
                ]
              }
            },
            "ref-annotated": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "typing.Annotated",
                  "typing_extensions.Annotated"
                ]
              }
            },
            "generic-head": {
              "any": [
                {
                  "precedes": {
                    "stopBy": "neighbor",
                    "regex": "^\\[$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "subscript"
                  }
                },
                {
                  "kind": "identifier",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "generic_type"
                  }
                }
              ]
            },
            "generic-item": {
              "not": {
                "any": [
                  {
                    "regex": "^[\\[\\],|]$"
                  },
                  {
                    "kind": "comment"
                  }
                ]
              },
              "any": [
                {
                  "follows": {
                    "stopBy": "end",
                    "regex": "^\\[$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "subscript"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "type_parameter"
                  }
                }
              ]
            },
            "immutable-annotation": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "type"
                    },
                    {
                      "kind": "parenthesized_expression"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "any": [
                        {
                          "regex": "^[\\[\\],|]$"
                        },
                        {
                          "kind": "comment"
                        }
                      ]
                    },
                    "matches": "immutable-annotation"
                  }
                },
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "matches": "immutable-name"
                },
                {
                  "kind": "none"
                },
                {
                  "any": [
                    {
                      "kind": "union_type"
                    },
                    {
                      "kind": "binary_operator",
                      "has": {
                        "stopBy": "neighbor",
                        "regex": "^\\|$"
                      }
                    }
                  ],
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "any": [
                              {
                                "regex": "^[\\[\\],|]$"
                              },
                              {
                                "kind": "comment"
                              }
                            ]
                          },
                          {
                            "regex": "^\\|$"
                          },
                          {
                            "matches": "immutable-annotation"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "any": [
                    {
                      "kind": "subscript"
                    },
                    {
                      "kind": "generic_type"
                    }
                  ],
                  "all": [
                    {
                      "any": [
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "matches": "generic-head",
                            "all": [
                              {
                                "matches": "immutable-generic"
                              }
                            ]
                          }
                        },
                        {
                          "all": [
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "matches": "generic-head",
                                "all": [
                                  {
                                    "matches": "ref-typing-union"
                                  }
                                ]
                              }
                            },
                            {
                              "any": [
                                {
                                  "kind": "subscript",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "regex": "^,$"
                                  }
                                },
                                {
                                  "kind": "generic_type",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "kind": "type_parameter",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "regex": "^,$"
                                    }
                                  }
                                }
                              ]
                            },
                            {
                              "not": {
                                "any": [
                                  {
                                    "kind": "subscript",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "matches": "generic-item",
                                      "not": {
                                        "matches": "immutable-annotation"
                                      }
                                    }
                                  },
                                  {
                                    "kind": "generic_type",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "kind": "type_parameter",
                                      "has": {
                                        "stopBy": "neighbor",
                                        "matches": "generic-item",
                                        "not": {
                                          "matches": "immutable-annotation"
                                        }
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        },
                        {
                          "all": [
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "matches": "generic-head",
                                "all": [
                                  {
                                    "matches": "ref-typing-optional"
                                  }
                                ]
                              }
                            },
                            {
                              "not": {
                                "any": [
                                  {
                                    "kind": "subscript",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "regex": "^,$"
                                    }
                                  },
                                  {
                                    "kind": "generic_type",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "kind": "type_parameter",
                                      "has": {
                                        "stopBy": "neighbor",
                                        "regex": "^,$"
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "any": [
                                {
                                  "kind": "subscript",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "matches": "generic-item",
                                    "all": [
                                      {
                                        "matches": "immutable-annotation"
                                      }
                                    ]
                                  }
                                },
                                {
                                  "kind": "generic_type",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "kind": "type_parameter",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "matches": "generic-item",
                                      "all": [
                                        {
                                          "matches": "immutable-annotation"
                                        }
                                      ]
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "all": [
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "matches": "generic-head",
                                "all": [
                                  {
                                    "matches": "ref-annotated"
                                  }
                                ]
                              }
                            },
                            {
                              "any": [
                                {
                                  "kind": "subscript",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "regex": "^,$"
                                  }
                                },
                                {
                                  "kind": "generic_type",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "kind": "type_parameter",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "regex": "^,$"
                                    }
                                  }
                                }
                              ]
                            },
                            {
                              "any": [
                                {
                                  "kind": "subscript",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "matches": "generic-item",
                                    "all": [
                                      {
                                        "matches": "immutable-annotation"
                                      }
                                    ],
                                    "not": {
                                      "follows": {
                                        "stopBy": "end",
                                        "matches": "generic-item"
                                      }
                                    }
                                  }
                                },
                                {
                                  "kind": "generic_type",
                                  "has": {
                                    "stopBy": "neighbor",
                                    "kind": "type_parameter",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "matches": "generic-item",
                                      "all": [
                                        {
                                          "matches": "immutable-annotation"
                                        }
                                      ],
                                      "not": {
                                        "follows": {
                                          "stopBy": "end",
                                          "matches": "generic-item"
                                        }
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "checked-default": {
              "follows": {
                "stopBy": "neighbor",
                "regex": "^=$"
              },
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "default_parameter"
                  },
                  {
                    "kind": "typed_default_parameter"
                  }
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "parameters"
                    },
                    {
                      "kind": "lambda_parameters"
                    }
                  ]
                },
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "type",
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "immutable-annotation"
                    }
                  }
                }
              }
            },
            "mutable-callee": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "global": [
                  "dict",
                  "list",
                  "set"
                ],
                "import": [
                  "builtins.dict",
                  "builtins.list",
                  "builtins.set",
                  "collections.Counter",
                  "collections.OrderedDict",
                  "collections.defaultdict",
                  "collections.deque"
                ]
              }
            },
            "immutable-callee-name": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "global": [
                  "bool",
                  "bytes",
                  "complex",
                  "float",
                  "frozenset",
                  "int",
                  "range",
                  "str",
                  "tuple",
                  "slice",
                  "frozendict"
                ],
                "import": [
                  "datetime.date",
                  "datetime.datetime",
                  "datetime.time",
                  "datetime.timedelta",
                  "datetime.timezone",
                  "datetime.tzinfo",
                  "decimal.Decimal",
                  "fractions.Fraction",
                  "operator.attrgetter",
                  "operator.itemgetter",
                  "operator.methodcaller",
                  "pathlib.Path",
                  "types.MappingProxyType",
                  "re.compile",
                  {
                    "$option": "flake8-bugbear.extend-immutable-calls",
                    "spread": true
                  }
                ]
              }
            },
            "immutable-callee": {
              "any": [
                {
                  "matches": "immutable-callee-name"
                },
                {
                  "kind": "subscript",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "generic-head",
                    "all": [
                      {
                        "matches": "immutable-callee-name"
                      }
                    ]
                  }
                }
              ]
            },
            "ref-newtype": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "typing.NewType",
                  "_typeshed.NewType",
                  "typing_extensions.NewType"
                ]
              }
            },
            "newtype-call": {
              "any": [
                {
                  "kind": "call",
                  "arguments": {
                    "signature": [
                      "name",
                      "tp"
                    ],
                    "bind": {
                      "TP": "tp"
                    },
                    "mode": "syntactic"
                  },
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "ref-newtype"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "argument_list",
                        "all": [
                          {
                            "count": {
                              "has": {
                                "stopBy": "neighbor",
                                "not": {
                                  "any": [
                                    {
                                      "regex": "^[(),]$"
                                    },
                                    {
                                      "kind": "comment"
                                    }
                                  ]
                                }
                              },
                              "min": 2,
                              "max": 2
                            }
                          },
                          {
                            "has": {
                              "stopBy": "end",
                              "pattern": "$TP_ARG",
                              "compare": {
                                "left": "TP",
                                "op": "eq",
                                "right": "TP_ARG",
                                "text": "node"
                              },
                              "matches": "immutable-annotation"
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "newtype-call"
                  }
                }
              ]
            },
            "exempt-callee": {
              "any": [
                {
                  "matches": "mutable-callee"
                },
                {
                  "matches": "immutable-callee"
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "only": true,
                      "value": {
                        "matches": "newtype-call"
                      },
                      "site": {
                        "kind": "assignment",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "type"
                              },
                              {
                                "kind": "pattern_list"
                              },
                              {
                                "kind": "tuple_pattern"
                              },
                              {
                                "kind": "list_pattern"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "not": {
              "has": {
                "stopBy": "neighbor",
                "matches": "exempt-callee",
                "precedes": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "argument_list"
                    },
                    {
                      "kind": "generator_expression"
                    }
                  ]
                }
              }
            },
            "any": [
              {
                "matches": "checked-default"
              },
              {
                "inside": {
                  "stopBy": {
                    "any": [
                      {
                        "kind": "lambda"
                      },
                      {
                        "matches": "checked-default"
                      }
                    ]
                  },
                  "matches": "checked-default",
                  "not": {
                    "kind": "lambda"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B008",
        "message": "Do not perform function call in argument defaults; instead, perform the call within the function, or read the default from a module-level singleton variable",
        "suppress": {
          "noqa": {
            "codes": [
              "B008"
            ]
          }
        }
      }
    }
  ]
}