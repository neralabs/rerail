{
  "format": "rerail.policy/v1",
  "id": "ruff-perf402-manual-list-copy",
  "revision": 1,
  "mode": "steer",
  "description": "Use list or extend to copy an iterable into a list instead of appending items one by one in a for loop.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "manual-list-copy",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "list-expr": {
              "any": [
                {
                  "kind": "list"
                },
                {
                  "kind": "list_comprehension"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "list-expr"
                  }
                },
                {
                  "kind": "named_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "^:=$"
                    },
                    "matches": "list-expr"
                  }
                },
                {
                  "kind": "conditional_expression",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^if$"
                        },
                        "matches": "list-expr"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "^else$"
                        },
                        "matches": "list-expr"
                      }
                    }
                  ]
                },
                {
                  "kind": "boolean_operator",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "regex": "^(and|or)$"
                          },
                          {
                            "kind": "comment"
                          },
                          {
                            "matches": "list-expr"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^\\+$"
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "regex": "^\\+$"
                          },
                          {
                            "kind": "comment"
                          },
                          {
                            "matches": "list-expr"
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "list-callee": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "list"
                    ],
                    "import": [
                      "builtins.list"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "list-callee"
                  }
                }
              ]
            },
            "list-init": {
              "any": [
                {
                  "matches": "list-expr"
                },
                {
                  "kind": "call",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "list-callee",
                    "precedes": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "argument_list"
                        },
                        {
                          "kind": "generator_expression"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "list-ann": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "list"
                    ],
                    "import": [
                      "builtins.list"
                    ]
                  }
                },
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "typing.List",
                      "_typeshed.List",
                      "typing_extensions.List"
                    ]
                  }
                },
                {
                  "any": [
                    {
                      "kind": "subscript"
                    },
                    {
                      "kind": "generic_type"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "(?s)."
                      }
                    },
                    "matches": "list-ann"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "list-ann"
                  }
                }
              ]
            },
            "list-bound": {
              "kind": "identifier",
              "any": [
                {
                  "resolves": {
                    "binding": {
                      "only": true,
                      "value": {
                        "matches": "list-init"
                      },
                      "site": {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "type"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "resolves": {
                    "binding": {
                      "only": true,
                      "annotation": {
                        "matches": "list-ann"
                      },
                      "site": {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "list_splat_pattern"
                              },
                              {
                                "kind": "dictionary_splat_pattern"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "plain-name": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$L"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "plain-name"
                  }
                }
              ]
            },
            "call": {
              "kind": "call",
              "all": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "field": "function",
                    "kind": "attribute",
                    "all": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "field": "object",
                          "matches": "plain-name"
                        }
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "field": "attribute",
                          "kind": "identifier",
                          "regex": "^(append|insert)$"
                        }
                      }
                    ]
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "field": "arguments",
                    "any": [
                      {
                        "kind": "generator_expression",
                        "pattern": "$A"
                      },
                      {
                        "kind": "argument_list",
                        "count": {
                          "has": {
                            "stopBy": "neighbor",
                            "not": {
                              "any": [
                                {
                                  "kind": "comment"
                                },
                                {
                                  "regex": "^[(),]$"
                                }
                              ]
                            }
                          },
                          "min": 1,
                          "max": 1
                        },
                        "has": {
                          "stopBy": "neighbor",
                          "pattern": "$A",
                          "not": {
                            "any": [
                              {
                                "kind": "comment"
                              },
                              {
                                "regex": "^[(),]$"
                              },
                              {
                                "kind": "keyword_argument"
                              },
                              {
                                "kind": "dictionary_splat"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "only-stmt": {
              "not": {
                "any": [
                  {
                    "follows": {
                      "stopBy": "end",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  },
                  {
                    "precedes": {
                      "stopBy": "end",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                ]
              }
            },
            "loop-target": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$T"
                },
                {
                  "kind": "tuple_pattern",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "identifier",
                    "pattern": "$T"
                  }
                }
              ]
            },
            "loop": {
              "kind": "for_statement",
              "all": [
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^async$"
                    }
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "field": "left",
                    "matches": "loop-target"
                  }
                },
                {
                  "compare": {
                    "left": "A",
                    "right": "T",
                    "op": "eq",
                    "text": "structure"
                  }
                }
              ]
            }
          },
          "rule": {
            "all": [
              {
                "matches": "call"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "expression_statement",
                  "matches": "only-stmt",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "block",
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "loop"
                    }
                  }
                }
              }
            ]
          },
          "constraints": {
            "L": {
              "matches": "list-bound"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PERF402",
        "message": "Copy the iterable in one step: `$L.extend(<iterable>)`, or `$L = list(<iterable>)` when `$L` starts empty and nothing reads it before the loop.",
        "suppress": {
          "noqa": {
            "codes": [
              "PERF402"
            ]
          }
        }
      }
    }
  ]
}
