{
  "format": "rerail.policy/v1",
  "id": "bandit-b605-start-process-with-a-shell",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid shell-spawning APIs such as os.system, os.popen and the commands module; use subprocess with an argument list to prevent shell injection.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit-b605",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "os.system",
                  "os.popen",
                  "os.popen2",
                  "os.popen3",
                  "os.popen4",
                  "popen2.popen2",
                  "popen2.popen3",
                  "popen2.popen4",
                  "popen2.Popen3",
                  "popen2.Popen4",
                  "commands.getoutput",
                  "commands.getstatusoutput"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B605",
        "anchor": "witness.span",
        "message": "Replace this shell-spawning call with subprocess.run and an argument list; running the command through a shell allows injection.",
        "suppress": {
          "nosec": {
            "codes": [
              "B605"
            ]
          }
        }
      }
    }
  ]
}
