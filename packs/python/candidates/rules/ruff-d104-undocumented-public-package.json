{
  "format": "rerail.policy/v1",
  "id": "ruff-d104-undocumented-public-package",
  "revision": 1,
  "mode": "steer",
  "description": "Give each public Python package a docstring at the top of its init module that describes what the package provides.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "undocumented-public-package",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "module": {
              "notRegex": "(?:^|\\.)(?:_|_[^_.][^.]*|__[^.]*[^_.]_?)(?:\\.|$)"
            },
            "path": {
              "regex": "(?:^|/)__init__\\.py$"
            }
          },
          "utils": {
            "doc-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string_start",
                      "regex": "[bBfFtT]"
                    }
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string_start",
                        "regex": "[bBfFtT]"
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "doc-string"
                  }
                }
              ]
            },
            "docstring": {
              "kind": "expression_statement",
              "all": [
                {
                  "not": {
                    "follows": {
                      "stopBy": "end",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "doc-string"
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "module",
            "not": {
              "has": {
                "stopBy": "neighbor",
                "matches": "docstring"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "D104",
        "message": "Add a docstring as the first statement of this package's `__init__.py`, summarizing what the package provides.",
        "suppress": {
          "noqa": {
            "codes": [
              "D104"
            ]
          }
        }
      }
    }
  ]
}
