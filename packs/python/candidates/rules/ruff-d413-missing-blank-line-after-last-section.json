{
  "format": "rerail.policy/v1",
  "id": "ruff-d413-missing-blank-line-after-last-section",
  "revision": 1,
  "mode": "steer",
  "description": "End a docstring's last section with a blank line before the closing quotes, so the sections stay consistently spaced.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "doc-stmt": {
            "kind": "expression_statement",
            "not": {
              "any": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^,$"
                  }
                },
                {
                  "follows": {
                    "stopBy": "end",
                    "not": {
                      "kind": "comment"
                    }
                  }
                }
              ]
            },
            "any": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "module"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "block",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "doc-holder": {
            "any": [
              {
                "matches": "doc-stmt"
              },
              {
                "kind": "parenthesized_expression",
                "inside": {
                  "stopBy": "neighbor",
                  "matches": "doc-holder"
                }
              }
            ]
          },
          "docstring": {
            "kind": "string",
            "not": {
              "has": {
                "stopBy": "neighbor",
                "kind": "string_start",
                "regex": "[bBfFtT]"
              }
            },
            "inside": {
              "stopBy": "neighbor",
              "matches": "doc-holder"
            }
          },
          "numpy-mode": {
            "any": [
              {
                "regex": "(?m)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:other param(?:eters|s)|parameters)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:other param(?:eters|s)|parameters)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)"
              },
              {
                "all": [
                  {
                    "not": {
                      "regex": "(?m)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:arg(?:s|uments)|keyword arg(?:s|uments)|other arg(?:s|uments))):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:arg(?:s|uments)|keyword arg(?:s|uments)|other arg(?:s|uments))):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)"
                    }
                  },
                  {
                    "regex": "(?m)(?:(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$|\\S[^\\S\\n]*\\n[^\\S\\n]*(?i:(?:extended summary|receives|short summary)):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)"
                  }
                ]
              }
            ]
          },
          "directive-hides-header": {
            "regex": "(?m)(?:^[ ]{0}\\.\\.[ ][^\\n]*(?:\\n(?:[^\\S\\n]*|[ ]{1}[^\\n]*))*\\n[ ]{1}[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|x(?:amples?|tended summary))|hint|important|keyword arg(?:s|uments)|methods|notes?|other (?:arg(?:s|uments)|param(?:eters|s))|parameters|r(?:aises|e(?:ceives|ferences|turns?))|s(?:ee also|hort summary)|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$|^[ ]{4}\\.\\.[ ][^\\n]*(?:\\n(?:[^\\S\\n]*|[ ]{5}[^\\n]*))*\\n[ ]{5}[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|x(?:amples?|tended summary))|hint|important|keyword arg(?:s|uments)|methods|notes?|other (?:arg(?:s|uments)|param(?:eters|s))|parameters|r(?:aises|e(?:ceives|ferences|turns?))|s(?:ee also|hort summary)|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$|^[ ]{8}\\.\\.[ ][^\\n]*(?:\\n(?:[^\\S\\n]*|[ ]{9}[^\\n]*))*\\n[ ]{9}[^\\S\\n]*(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|x(?:amples?|tended summary))|hint|important|keyword arg(?:s|uments)|methods|notes?|other (?:arg(?:s|uments)|param(?:eters|s))|parameters|r(?:aises|e(?:ceives|ferences|turns?))|s(?:ee also|hort summary)|t(?:ip|odo)|warn(?:ings?|s)|yields?)):?[^\\S\\n]*$)"
          },
          "last-section-numpy": {
            "regex": "(?m)\\A(?s:.*)(?:^[^\\S\\n]*\\n[ ]{0,4}(?P<N1>(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields))):?[^\\S\\n]*$|(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?P<N3>(?:A(?i:ttributes)|E(?i:x(?:amples|tended summary))|M(?i:ethods)|N(?i:otes)|O(?i:ther param(?:eters|s))|P(?i:arameters)|R(?i:(?:aises|e(?:ceives|ferences|turns)))|S(?i:(?:ee also|hort summary))|W(?i:arn(?:ings|s))|Y(?i:ields))):?[^\\S\\n]*$|\\n[^\\S\\n]*(?P<N2>(?i:(?:attributes|ex(?:amples|tended summary)|methods|notes|other param(?:eters|s)|parameters|r(?:aises|e(?:ceives|ferences|turns))|s(?:ee also|hort summary)|warn(?:ings|s)|yields))):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?:(?:\\n[^\\S\\n]*)?\\z|\\n(?s:.*?)\\S[^\\S\\n]*(?:\\n[^\\S\\n]*)?\\z)"
          },
          "last-section-numpy-all": {
            "kind": "string_content",
            "inside": {
              "stopBy": "neighbor",
              "matches": "docstring"
            },
            "matches": "last-section-numpy",
            "all": [
              {
                "matches": "numpy-mode"
              },
              {
                "not": {
                  "matches": "directive-hides-header"
                }
              }
            ]
          },
          "last-section-google": {
            "regex": "(?m)\\A(?s:.*)(?:^[^\\S\\n]*\\n[ ]{0,4}(?P<N1>(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|xamples?)|hint|important|keyword arg(?:s|uments)|methods|notes?|other arg(?:s|uments)|r(?:aises|e(?:ferences|turns?))|see also|t(?:ip|odo)|warn(?:ings?|s)|yields?))):?[^\\S\\n]*$|(?:^[^\\S\\n]*|[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?P<N3>(?:A(?i:(?:rg(?:s|uments)|tt(?:ention|ributes)))|C(?i:aution)|D(?i:anger)|E(?i:(?:rror|xamples?))|H(?i:int)|I(?i:mportant)|K(?i:eyword arg(?:s|uments))|M(?i:ethods)|N(?i:otes?)|O(?i:ther arg(?:s|uments))|R(?i:(?:aises|e(?:ferences|turns?)))|S(?i:ee also)|T(?i:(?:ip|odo))|W(?i:arn(?:ings?|s))|Y(?i:ields?))):?[^\\S\\n]*$|\\n[^\\S\\n]*(?P<N2>(?i:(?:a(?:rg(?:s|uments)|tt(?:ention|ributes))|caution|danger|e(?:rror|xamples?)|hint|important|keyword arg(?:s|uments)|methods|notes?|other arg(?:s|uments)|r(?:aises|e(?:ferences|turns?))|see also|t(?:ip|odo)|warn(?:ings?|s)|yields?))):?[^\\S\\n]*$\\n[^\\S\\n]*[-=]+[^\\S\\n]*$)(?:(?:\\n[^\\S\\n]*)?\\z|\\n(?s:.*?)\\S[^\\S\\n]*(?:\\n[^\\S\\n]*)?\\z)"
          },
          "last-section-google-all": {
            "kind": "string_content",
            "inside": {
              "stopBy": "neighbor",
              "matches": "docstring"
            },
            "matches": "last-section-google",
            "all": [
              {
                "not": {
                  "matches": "numpy-mode"
                }
              },
              {
                "not": {
                  "matches": "directive-hides-header"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "missing-blank-line-after-last-section-numpy-after-blank",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "last-section-numpy-all"
          }
        }
      },
      "violation": {
        "code": "D413",
        "anchor": "capture.N1",
        "each": "N1",
        "message": "Add a blank line after the last section (`$N1`), before the closing quotes.",
        "suppress": {
          "noqa": {
            "codes": [
              "D413"
            ]
          }
        }
      }
    },
    {
      "id": "missing-blank-line-after-last-section-numpy-after-text",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "last-section-numpy-all"
          }
        }
      },
      "violation": {
        "code": "D413",
        "anchor": "capture.N3",
        "each": "N3",
        "message": "Add a blank line after the last section (`$N3`), before the closing quotes.",
        "suppress": {
          "noqa": {
