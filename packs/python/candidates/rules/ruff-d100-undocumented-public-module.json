{
  "format": "rerail.policy/v1",
  "id": "ruff-d100-undocumented-public-module",
  "revision": 1,
  "mode": "steer",
  "description": "Open each public Python module with a docstring that says what it is for and what it exports.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "undocumented-public-module",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "module": { "notRegex": "(?:^|\\.)(?:_|_[^_.][^.]*|__[^.]*[^_.]_?)(?:\\.|$)" },
            "path": { "notRegex": "(?:^|/)__init__\\.py$|\\.pyi$" }
          },
          "utils": {
            "doc-string": {
              "any": [
                { "kind": "string", "not": { "has": { "stopBy": "neighbor", "kind": "string_start", "regex": "[bBfFtT]" } } },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "has": { "stopBy": "neighbor", "kind": "string_start", "regex": "[bBfFtT]" }
                    }
                  }
                },
                { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "doc-string" } }
              ]
            },
            "docstring": {
              "kind": "expression_statement",
              "all": [
                { "not": { "follows": { "stopBy": "end", "not": { "kind": "comment" } } } },
                { "has": { "stopBy": "neighbor", "matches": "doc-string" } },
                { "not": { "has": { "stopBy": "neighbor", "regex": "^,$" } } }
              ]
            }
          },
          "rule": { "kind": "module", "not": { "has": { "stopBy": "neighbor", "matches": "docstring" } } }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "D100",
        "message": "Add a docstring as this module's first statement, summarizing what the module is for and what it exports.",
        "suppress": { "noqa": { "codes": ["D100"] } }
      }
    }
  ]
}
