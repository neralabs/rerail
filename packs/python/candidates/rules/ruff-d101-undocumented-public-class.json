{
  "format": "rerail.policy/v1",
  "id": "ruff-d101-undocumented-public-class",
  "revision": 1,
  "mode": "steer",
  "description": "Give each public Python class a docstring that explains what it represents and how to use it.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "undocumented-public-class",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "module": {
              "notRegex": "(?:^|\\.)(?:_|_[^_.][^.]*|__[^.]*[^_.]_?)(?:\\.|$)"
            },
            "path": {
              "notRegex": "\\.pyi$"
            }
          },
          "utils": {
            "doc-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string_start",
                      "regex": "[bBfFtT]"
                    }
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string_start",
                        "regex": "[bBfFtT]"
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "doc-string"
                  }
                }
              ]
            },
            "docstring": {
              "kind": "expression_statement",
              "all": [
                {
                  "not": {
                    "follows": {
                      "stopBy": "end",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "doc-string"
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                }
              ]
            },
            "dunder-all": {
              "any": [
                {
                  "kind": "assignment"
                },
                {
                  "kind": "augmented_assignment"
                }
              ],
              "inside": {
                "stopBy": "neighbor",
                "kind": "expression_statement"
              },
              "has": {
                "stopBy": "neighbor",
                "field": "left",
                "kind": "identifier",
                "regex": "^__all__$"
              }
            },
            "paren-string": {
              "any": [
                {
                  "kind": "string",
                  "pattern": "$S",
                  "compare": {
                    "left": "S",
                    "op": "eq",
                    "right": "N",
                    "text": "unquoted"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "paren-string"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "identifier",
            "pattern": "$N",
            "regex": "^[^_]",
            "inside": {
              "stopBy": "neighbor",
              "field": "name",
              "kind": "class_definition",
              "not": {
                "inside": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                }
              },
              "all": [
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "body",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "docstring"
                      }
                    }
                  }
                }
              ]
            },
            "all": [
              {
                "any": [
                  {
                    "not": {
                      "inside": {
                        "stopBy": "end",
                        "kind": "module",
                        "has": {
                          "stopBy": {
                            "any": [
                              {
                                "kind": "function_definition"
                              },
                              {
                                "kind": "class_definition"
                              }
                            ]
                          },
                          "matches": "dunder-all"
                        }
                      }
                    }
                  },
                  {
                    "binds": {
                      "exported": true
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "end",
                      "kind": "module",
                      "has": {
                        "stopBy": {
                          "any": [
                            {
                              "kind": "function_definition"
                            },
                            {
                              "kind": "class_definition"
                            }
                          ]
                        },
                        "matches": "dunder-all",
                        "has": {
                          "stopBy": "end",
                          "kind": "parenthesized_expression",
                          "inside": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "list"
                              },
                              {
                                "kind": "tuple"
                              }
                            ]
                          },
                          "matches": "paren-string"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "D101",
        "message": "Add a docstring as the first statement of class `$N`, explaining what it represents and how to use it.",
        "suppress": {
          "noqa": {
            "codes": [
              "D101"
            ]
          }
        }
      }
    }
  ]
}
