{
  "format": "rerail.policy/v1",
  "id": "ruff-n815-mixed-case-variable-in-class-scope",
  "revision": 1,
  "mode": "steer",
  "description": "Name class-level variables in snake_case instead of mixedCase, as PEP 8 recommends for variable names.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "mixed-case-variable-in-class-scope",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "mixed-case": {
              "all": [
                {
                  "regex": "^_?\\p{Lowercase}"
                },
                {
                  "not": {
                    "regex": "^_?[\\x{1D2C}-\\x{1D2E}\\x{1D30}-\\x{1D3A}\\x{1D3C}-\\x{1D42}\\x{2C7D}\\x{A7F1}-\\x{A7F4}\\x{A7F8}]"
                  }
                },
                {
                  "regex": "[\\p{Uppercase}\\x{1C5}\\x{1C8}\\x{1CB}\\x{1F2}\\x{1D2C}-\\x{1D2E}\\x{1D30}-\\x{1D3A}\\x{1D3C}-\\x{1D42}\\x{2C7D}\\x{A7F1}-\\x{A7F4}\\x{A7F8}]"
                },
                {
                  "not": {
                    "regex": "^(?:tearDownClass|setUpModule|asyncSetUp|asyncTearDown|setUpTestData|failureException|longMessage|maxDiff)$"
                  }
                }
              ]
            },
            "container": {
              "any": [
                {
                  "kind": "pattern_list"
                },
                {
                  "kind": "tuple_pattern"
                },
                {
                  "kind": "list_pattern"
                },
                {
                  "kind": "list_splat_pattern"
                }
              ]
            },
            "store-target": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "left",
                    "any": [
                      {
                        "kind": "assignment"
                      },
                      {
                        "kind": "augmented_assignment"
                      },
                      {
                        "kind": "for_statement"
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "container",
                    "inside": {
                      "stopBy": {
                        "not": {
                          "matches": "container"
                        }
                      },
                      "any": [
                        {
                          "kind": "assignment"
                        },
                        {
                          "kind": "augmented_assignment"
                        },
                        {
                          "kind": "for_statement"
                        }
                      ]
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "name",
                    "kind": "named_expression"
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "not": {
                        "any": [
                          {
                            "kind": "tuple"
                          },
                          {
                            "kind": "list"
                          }
                        ]
                      }
                    },
                    "kind": "as_pattern_target",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "as_pattern",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "with_item"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "dotted_name",
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "regex": "^\\.$"
                      }
                    },
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "case_pattern"
                        },
                        {
                          "kind": "keyword_pattern"
                        }
                      ]
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "as_pattern",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "case_pattern"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "type",
                    "inside": {
                      "stopBy": "neighbor",
                      "field": "left",
                      "kind": "type_alias_statement"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "generic_type",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "type",
                      "inside": {
                        "stopBy": "neighbor",
                        "field": "left",
                        "kind": "type_alias_statement"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "splat_pattern",
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "case_pattern"
                        },
                        {
                          "kind": "dict_pattern"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "scope-edge": {
              "any": [
                {
                  "kind": "block",
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "body",
                    "any": [
                      {
                        "kind": "class_definition"
                      },
                      {
                        "kind": "function_definition"
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "body",
                    "kind": "lambda"
                  }
                },
                {
                  "kind": "argument_list",
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "superclasses",
                    "kind": "class_definition"
                  }
                },
                {
                  "kind": "list_comprehension"
                },
                {
                  "kind": "set_comprehension"
                },
                {
                  "kind": "dictionary_comprehension"
                },
                {
                  "kind": "generator_expression"
                }
              ]
            },
            "plain-class-body": {
              "kind": "block",
              "inside": {
                "stopBy": "neighbor",
                "field": "body",
                "kind": "class_definition",
                "not": {
                  "matches": "typed-dict-class"
                }
              }
            },
            "class-body": {
              "kind": "block",
              "inside": {
                "stopBy": "neighbor",
                "field": "body",
                "kind": "class_definition"
              }
            },
            "typed-dict-class": {
              "kind": "class_definition",
              "has": {
                "stopBy": "neighbor",
                "field": "superclasses",
                "kind": "argument_list",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "typed-dict-base"
                }
              }
            },
            "typed-dict-base": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "typing.TypedDict",
                      "typing_extensions.TypedDict",
                      "_typeshed.TypedDict"
                    ]
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "site": {
                        "matches": "typed-dict-class",
                        "not": {
                          "inside": {
                            "stopBy": {
                              "matches": "scope-edge"
                            },
                            "matches": "class-body"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "typed-dict-base"
                  }
                },
                {
                  "kind": "subscript",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "value",
                    "matches": "typed-dict-base"
                  }
                }
              ]
            },
            "named-tuple-call": {
              "any": [
                {
                  "kind": "call",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "function",
                    "resolves": {
                      "import": [
                        "collections.namedtuple",
                        "typing.NamedTuple",
                        "typing_extensions.NamedTuple",
                        "_typeshed.NamedTuple"
                      ]
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "named-tuple-call"
                  }
                }
              ]
            },
            "named-tuple-statement": {
              "kind": "expression_statement",
              "has": {
                "stopBy": "end",
                "kind": "assignment",
                "all": [
                  {
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "type",
                        "kind": "type"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "right",
                      "matches": "named-tuple-call"
                    }
                  }
                ]
              }
            }
          },
          "rule": {
            "kind": "identifier",
            "pattern": "$NAME",
            "all": [
              {
                "matches": "mixed-case"
              },
              {
                "matches": "store-target"
              },
              {
                "inside": {
                  "stopBy": {
                    "matches": "scope-edge"
                  },
                  "matches": "plain-class-body"
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "end",
                    "matches": "named-tuple-statement"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "N815",
        "message": "Rename the class variable `$NAME` to snake_case and update its uses; keep the name if outside code depends on it or it mirrors an external schema.",
        "suppress": {
          "noqa": {
            "codes": [
              "N815"
            ]
          }
        }
      }
    }
  ]
}
