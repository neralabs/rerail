{
  "format": "rerail.policy/v1",
  "id": "ruff-ytt302-sys-version-cmp-str10",
  "revision": 1,
  "mode": "steer",
  "description": "Compare sys.version_info to a tuple instead of comparing sys.version to a one-character string; string order misjudges a two-digit major version.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "sys-version-cmp-str10",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "one-byte-string": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "string"
                    },
                    {
                      "kind": "concatenated_string"
                    }
                  ],
                  "value": {
                    "type": "str",
                    "regex": "^[\\x00-\\x7f]$"
                  },
                  "all": [
                    {
                      "not": {
                        "has": {
                          "stopBy": "end",
                          "kind": "string_start",
                          "regex": "[fFtT]"
                        }
                      }
                    },
                    {
                      "not": {
                        "any": [
                          {
                            "kind": "string",
                            "regex": "(?:^|[^\\\\])(?:\\\\\\\\)*\\r\\n"
                          },
                          {
                            "has": {
                              "stopBy": "end",
                              "kind": "string",
                              "regex": "(?:^|[^\\\\])(?:\\\\\\\\)*\\r\\n"
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "one-byte-string"
                  }
                }
              ]
            },
            "sys-version": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "sys.version"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "sys-version"
                  }
                }
              ]
            },
            "ordered-string-compare": {
              "kind": "comparison_operator",
              "all": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^(?:<|<=|>|>=)$"
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "nthChild": {
                      "position": 2,
                      "ofRule": {
                        "not": {
                          "any": [
                            {
                              "kind": "comment"
                            },
                            {
                              "kind": "line_continuation"
                            }
                          ]
                        }
                      }
                    },
                    "matches": "one-byte-string"
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "nthChild": {
                        "position": 3,
                        "ofRule": {
                          "not": {
                            "any": [
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "line_continuation"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "left-operand": {
              "any": [
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "any": [
                          {
                            "kind": "comment"
                          },
                          {
                            "kind": "line_continuation"
                          }
                        ]
                      }
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "ordered-string-compare"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "left-operand"
                  }
                }
              ]
            },
            "target": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "all": [
                {
                  "resolves": {
                    "import": [
                      "sys.version"
                    ]
                  }
                },
                {
                  "matches": "left-operand"
                }
              ]
            },
            "in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "target",
                      "capture": "C"
                    },
                    {
                      "matches": "in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "target",
                "pattern": "$C"
              },
              {
                "matches": "in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "YTT302",
        "message": "Compare `sys.version_info` to a tuple such as `sys.version_info >= (3,)` instead of comparing `sys.version` to a one-character string; string order misjudges a two-digit major version.",
        "suppress": {
          "noqa": {
            "codes": [
              "YTT302"
            ]
          }
        }
      }
    }
  ]
}
