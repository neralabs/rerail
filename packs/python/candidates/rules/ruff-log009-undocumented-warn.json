{
 "format": "rerail.policy/v1",
 "id": "ruff-log009-undocumented-warn",
 "revision": 1,
 "mode": "steer",
 "description": "Port of Ruff's LOG009 (undocumented-warn): a name or attribute expression resolving to `logging.WARN` through the file's imports (Ruff's `resolve_qualified_name`; e.g. `logging.WARN`, or `WARN` after `from logging import WARN`), reported on it.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "undocumented-warn",
   "forbid": {
    "ast": {
     "language": "python",
     "rule": {
      "any": [
       {
        "kind": "identifier"
       },
       {
        "kind": "attribute"
       }
      ],
      "resolves": {
       "import": [
        "logging.WARN"
       ]
      }
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "LOG009",
    "message": "Use of undocumented `logging.WARN` constant",
    "suppress": {
     "noqa": {
      "codes": [
       "LOG009"
      ]
     }
    }
   }
  }
 ]
}
