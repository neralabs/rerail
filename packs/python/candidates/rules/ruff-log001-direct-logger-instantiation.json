{
 "format": "rerail.policy/v1",
 "id": "ruff-log001-direct-logger-instantiation",
 "revision": 1,
 "mode": "steer",
 "description": "Port of Ruff's LOG001 (direct-logger-instantiation): the callee of a call (parentheses transparent) that is a name or attribute resolving to `logging.Logger` through the file's imports (Ruff's `resolve_qualified_name`), reported on the callee expression itself (`call.func`, inside any parentheses).",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "direct-logger-instantiation",
   "forbid": {
    "ast": {
     "language": "python",
     "rule": {
      "any": [
       {
        "kind": "identifier"
       },
       {
        "kind": "attribute"
       }
      ],
      "resolves": {
       "import": [
        "logging.Logger"
       ]
      },
      "inside": {
       "stopBy": {
        "not": {
         "kind": "parenthesized_expression"
        }
       },
       "kind": "call"
      }
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "LOG001",
    "message": "Use `logging.getLogger()` to instantiate loggers",
    "suppress": {
     "noqa": {
      "codes": [
       "LOG001"
      ]
     }
    }
   }
  }
 ]
}
