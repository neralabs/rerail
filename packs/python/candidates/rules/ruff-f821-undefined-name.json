{
  "format": "rerail.policy/v1",
  "id": "ruff-f821-undefined-name",
  "revision": 1,
  "mode": "steer",
  "description": "Define or import every name before using it, including names in string type annotations; an undefined name raises NameError.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "options",
      "define": {
        "options": {
          "builtins": {
            "type": "array",
            "items": "string",
            "default": [],
            "description": "Further builtin names."
          }
        }
      }
    },
    {
      "id": "undefined-name",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "name-error": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "global": [
                  "NameError"
                ],
                "import": [
                  "builtins.NameError"
                ]
              }
            },
            "handled-type": {
              "any": [
                {
                  "matches": "name-error"
                },
                {
                  "any": [
                    {
                      "kind": "tuple"
                    },
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "as_pattern"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "kind": "as_pattern_target"
                    },
                    "matches": "handled-type"
                  }
                }
              ]
            },
            "name-error-handled": {
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "block",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "function_definition"
                      }
                    },
                    {
                      "kind": "lambda"
                    }
                  ]
                },
                "kind": "block",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "try_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "except_clause",
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "handled-type"
                    }
                  }
                }
              }
            },
            "undefined-in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "identifier",
                      "resolves": {
                        "unresolved": true
                      },
                      "capture": "N",
                      "not": {
                        "regex": {
                          "$option": "builtins",
                          "cases": {
                            "[]": "[^\\s\\S]"
                          },
                          "default": {
                            "$option": "builtins",
                            "escape": "regex",
                            "join": "|",
                            "template": "^(?:{})$"
                          }
                        }
                      }
                    },
                    {
                      "matches": "undefined-in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "kind": "identifier",
                "resolves": {
                  "unresolved": true
                },
                "not": {
                  "regex": {
                    "$option": "builtins",
                    "cases": {
                      "[]": "[^\\s\\S]"
                    },
                    "default": {
                      "$option": "builtins",
                      "escape": "regex",
                      "join": "|",
                      "template": "^(?:{})$"
                    }
                  }
                },
                "pattern": "$N",
                "all": [
                  {
                    "not": {
                      "matches": "name-error-handled"
                    }
                  }
                ]
              },
              {
                "matches": "undefined-in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.N",
        "code": "F821",
        "message": "Undefined name `$N`",
        "each": "N",
        "suppress": {
          "noqa": {
            "codes": [
              "F821"
            ]
          }
        }
      }
    }
  ]
}
