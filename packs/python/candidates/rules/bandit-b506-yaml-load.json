{
  "format": "rerail.policy/v1",
  "id": "bandit-b506-yaml-load",
  "revision": 1,
  "mode": "steer",
  "description": "Use yaml.safe_load or a SafeLoader instead of yaml.load with a full loader; the full loader can run arbitrary code from YAML input.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "yaml-load",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "call",
            "has": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "yaml.load"
                ]
              }
            },
            "any": [
              {
                "arguments": {
                  "signature": [
                    "stream",
                    "Loader"
                  ],
                  "absent": [
                    "Loader"
                  ]
                }
              },
              {
                "arguments": {
                  "signature": [
                    "stream",
                    "Loader"
                  ],
                  "bind": {
                    "L": "Loader"
                  }
                }
              }
            ]
          },
          "constraints": {
            "L": {
              "not": {
                "any": [
                  {
                    "kind": "identifier",
                    "regex": "^C?SafeLoader$"
                  },
                  {
                    "kind": "attribute",
                    "regex": "\\.C?SafeLoader$"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B506",
        "message": "Use yaml.safe_load, or pass Loader=yaml.SafeLoader, instead of this yaml.load; the full loader can run arbitrary code from input.",
        "suppress": {
          "nosec": {
            "codes": [
              "B506"
            ]
          }
        }
      }
    }
  ]
}
