{
  "format": "rerail.policy/v1",
  "id": "bandit-b404-import-subprocess",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid importing subprocess unless you need it; running external commands risks command injection when arguments come from untrusted input.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B404",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "any": [
                    {
                      "kind": "dotted_name"
                    },
                    {
                      "kind": "aliased_import"
                    }
                  ],
                  "regex": "^subprocess"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "field": "module_name",
                  "regex": "^[.\\s]*subprocess"
                }
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]+$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^subprocess",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B404",
        "anchor": "witness.span",
        "message": "Consider possible security implications associated with the subprocess module.",
        "suppress": {
          "nosec": {
            "codes": [
              "B404"
            ]
          }
        }
      }
    }
  ]
}
