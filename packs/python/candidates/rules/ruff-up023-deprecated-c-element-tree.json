{
  "format": "rerail.policy/v1",
  "id": "ruff-up023-deprecated-c-element-tree",
  "revision": 1,
  "mode": "steer",
  "description": "Import the ElementTree module instead of the deprecated cElementTree one; the C accelerator is used automatically.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "deprecated-c-element-tree",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "c-module": {
              "kind": "dotted_name",
              "regex": "^xml[\\s\\\\]*\\.[\\s\\\\]*etree[\\s\\\\]*\\.[\\s\\\\]*cElementTree$"
            },
            "etree-package": {
              "kind": "dotted_name",
              "regex": "^xml[\\s\\\\]*\\.[\\s\\\\]*etree$"
            }
          },
          "rule": {
            "any": [
              {
                "kind": "aliased_import",
                "has": {
                  "stopBy": "neighbor",
                  "field": "name",
                  "matches": "c-module"
                },
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "import_statement"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "stopBy": "neighbor",
                  "field": "module_name",
                  "matches": "c-module"
                }
              },
              {
                "kind": "aliased_import",
                "has": {
                  "stopBy": "neighbor",
                  "field": "name",
                  "kind": "dotted_name",
                  "regex": "^cElementTree$"
                },
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "import_from_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "module_name",
                    "matches": "etree-package"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP023",
        "message": "`cElementTree` is deprecated and was removed in Python 3.9; import `xml.etree.ElementTree` instead, which uses the C accelerator automatically. Keep it only for Python 2 code.",
        "suppress": {
          "noqa": {
            "codes": [
              "UP023"
            ]
          }
        }
      }
    }
  ]
}
