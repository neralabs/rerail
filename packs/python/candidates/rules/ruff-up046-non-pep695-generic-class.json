{
  "format": "rerail.policy/v1",
  "id": "ruff-up046-non-pep695-generic-class",
  "revision": 1,
  "mode": "steer",
  "description": "Declare a generic class's type variables with type parameter syntax instead of a Generic base; the variables are then scoped to the class.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "plain-string": {
            "any": [
              {
                "kind": "string",
                "not": {
                  "regex": "^[a-zA-Z]*[bBfFtT]"
                }
              },
              {
                "kind": "concatenated_string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "regex": "^[a-zA-Z]*[bBfFtT]"
                  }
                }
              }
            ]
          },
          "positional": {
            "not": {
              "any": [
                {
                  "kind": "keyword_argument"
                },
                {
                  "kind": "dictionary_splat"
                },
                {
                  "kind": "comment"
                },
                {
                  "regex": "^[(),]$"
                }
              ]
            }
          },
          "tv-func": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "typing.TypeVar",
                "typing_extensions.TypeVar",
                "_typeshed.TypeVar",
                "typing.TypeVarTuple",
                "typing_extensions.TypeVarTuple",
                "_typeshed.TypeVarTuple",
                "typing.ParamSpec",
                "typing_extensions.ParamSpec",
                "_typeshed.ParamSpec"
              ]
            }
          },
          "restricted-func": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "typing.TypeVarTuple",
                "typing_extensions.TypeVarTuple",
                "_typeshed.TypeVarTuple",
                "typing.ParamSpec",
                "typing_extensions.ParamSpec",
                "_typeshed.ParamSpec"
              ]
            }
          },
          "tv-call": {
            "kind": "call",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "function",
                  "matches": "tv-func"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "arguments",
                  "kind": "argument_list",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "plain-string",
                    "not": {
                      "follows": {
                        "stopBy": "end",
                        "matches": "positional"
                      }
                    }
                  }
                }
              }
            ]
          },
          "tv-sub": {
            "kind": "subscript",
            "has": {
              "stopBy": "neighbor",
              "field": "value",
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "typing.TypeVar",
                  "typing_extensions.TypeVar",
                  "_typeshed.TypeVar"
                ]
              }
            }
          },
          "keyword-default": {
            "has": {
              "stopBy": "neighbor",
              "field": "arguments",
              "kind": "argument_list",
              "has": {
                "stopBy": "neighbor",
                "kind": "keyword_argument",
                "has": {
                  "stopBy": "neighbor",
                  "field": "name",
                  "regex": "^default$"
                }
              }
            }
          },
          "keyword-bound": {
            "has": {
              "stopBy": "neighbor",
              "field": "arguments",
              "kind": "argument_list",
              "has": {
                "stopBy": "neighbor",
                "kind": "keyword_argument",
                "has": {
                  "stopBy": "neighbor",
                  "field": "name",
                  "regex": "^bound$"
                }
              }
            }
          },
          "two-positional": {
            "has": {
              "stopBy": "neighbor",
              "field": "arguments",
              "kind": "argument_list",
              "has": {
                "stopBy": "neighbor",
                "matches": "positional",
                "follows": {
                  "stopBy": "end",
                  "matches": "positional"
                }
              }
            }
          },
          "bad-call": {
            "matches": "tv-call",
            "any": [
              {
                "matches": "keyword-default"
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "function",
                  "matches": "restricted-func"
                },
                "any": [
                  {
                    "matches": "keyword-bound"
                  },
                  {
                    "matches": "two-positional"
                  }
                ]
              }
            ]
          },
          "tv-value": {
            "any": [
              {
                "matches": "tv-call"
              },
              {
                "matches": "tv-sub"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "tv-value"
                }
              }
            ]
          },
          "bad-value": {
            "any": [
              {
                "matches": "bad-call"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "bad-value"
                }
              }
            ]
          },
          "tv-site": {
            "kind": "assignment",
            "has": {
              "stopBy": "neighbor",
              "field": "left",
              "kind": "identifier"
            },
            "not": {
              "has": {
                "stopBy": "neighbor",
                "field": "type",
                "kind": "type"
              }
            },
            "inside": {
              "stopBy": "end",
              "kind": "expression_statement"
            }
          },
          "tv-ref": {
            "kind": "identifier",
            "resolves": {
              "binding": {
                "site": {
                  "matches": "tv-site"
                },
                "value": {
                  "matches": "tv-value"
                }
              }
            }
          },
          "bad-ref": {
            "kind": "identifier",
            "resolves": {
              "binding": {
                "site": {
                  "matches": "tv-site"
                },
                "value": {
                  "matches": "bad-value"
                }
              }
            }
          },
          "anystr": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "typing.AnyStr",
                "typing_extensions.AnyStr",
                "_typeshed.AnyStr"
              ]
            }
          },
          "generic-ref": {
            "any": [
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "attribute"
                  }
                ],
                "resolves": {
                  "import": [
                    "typing.Generic",
                    "typing_extensions.Generic",
                    "_typeshed.Generic"
                  ]
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "generic-ref"
                }
              }
            ]
          },
          "generic-sub": {
            "kind": "subscript",
            "has": {
              "stopBy": "neighbor",
              "field": "value",
              "matches": "generic-ref"
            }
          },
          "generic-base": {
            "any": [
              {
                "matches": "generic-sub"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "generic-base"
                }
              }
            ]
          },
          "first-slot": {
            "matches": "generic-base",
            "not": {
              "follows": {
                "stopBy": "end",
                "matches": "generic-base"
              }
            },
            "inside": {
              "stopBy": "neighbor",
              "kind": "argument_list",
              "inside": {
                "stopBy": "neighbor",
                "field": "superclasses",
                "kind": "class_definition",
                "not": {
                  "any": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "type_parameters",
                        "kind": "type_parameter"
                      }
                    },
                    {
                      "inside": {
                        "stopBy": "end",
                        "any": [
                          {
                            "kind": "class_definition"
                          },
                          {
                            "kind": "function_definition"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          },
          "in-first-slot": {
            "any": [
              {
                "matches": "first-slot"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "matches": "in-first-slot",
                  "kind": "parenthesized_expression"
                }
              }
            ]
          },
          "last-positional": {
            "any": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "argument_list"
                },
                "not": {
                  "precedes": {
                    "stopBy": "end",
                    "matches": "positional"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "parenthesized_expression",
                  "matches": "last-positional"
                }
              }
            ]
          },
          "name-ref": {
            "kind": "identifier",
            "not": {
              "any": [
                {
                  "matches": "tv-ref"
                },
                {
                  "matches": "special"
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "attribute",
                    "kind": "attribute"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "name",
                    "kind": "keyword_argument"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "attribute",
                    "matches": "special"
                  }
                }
              ]
            }
          },
          "special": {
            "any": [
              {
                "matches": "type-anystr"
              },
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "attribute"
                  }
                ],
                "resolves": {
                  "import": [
                    "typing.Generic",
                    "typing_extensions.Generic",
                    "_typeshed.Generic"
                  ]
                }
              }
            ]
          },
          "good-var": {
            "any": [
              {
                "matches": "tv-ref",
                "not": {
                  "matches": "bad-ref"
                }
              },
              {
                "matches": "type-anystr"
              }
            ]
          },
          "repeated-var": {
            "kind": "identifier",
            "matches": "good-var",
            "pattern": "$A",
            "inside": {
              "stopBy": "end",
              "kind": "subscript",
              "has": {
                "stopBy": "end",
                "kind": "identifier",
                "matches": "good-var",
                "pattern": "$B",
                "all": [
                  {
                    "compare": {
                      "left": "A",
                      "op": "eq",
                      "right": "B"
                    }
                  },
                  {
                    "compare": {
                      "left": "A",
                      "op": "ne",
                      "right": "B",
                      "text": "node"
                    }
                  }
                ]
              }
            }
          },
          "str-shadowed": {
            "inside": {
              "stopBy": "end",
              "follows": {
                "stopBy": "end",
                "has": {
                  "stopBy": "end",
                  "kind": "identifier",
                  "regex": "^(?:str|bytes)$",
                  "binds": {
                    "scope": [
                      "module"
                    ]
                  }
                }
              }
            }
          },
          "type-anystr": {
            "matches": "anystr",
            "not": {
              "matches": "str-shadowed"
            }
          },
          "repeated-anystr": {
            "matches": "type-anystr",
            "follows": {
              "stopBy": "end",
              "matches": "type-anystr"
            }
          }
        }
      }
    },
    {
      "id": "generic-base-class",
      "forbid": {
        "ast": {
          "language": "python",
          "when": {
            "pythonVersion": {
              "min": "3.12"
            }
          },
          "rule": {
            "matches": "generic-sub",
            "all": [
              {
                "matches": "in-first-slot"
              },
              {
                "any": [
                  {
                    "not": {
                      "matches": "last-positional"
                    }
                  },
                  {
                    "has": {
                      "stopBy": "end",
                      "matches": "name-ref"
                    }
                  },
                  {
                    "all": [
                      {
                        "has": {
                          "stopBy": "end",
                          "matches": "good-var"
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "end",
                            "matches": "bad-ref"
                          }
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "end",
                            "matches": "repeated-var"
                          }
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "end",
                            "matches": "repeated-anystr"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP046",
        "message": "Move the type variables from `Generic[...]` into brackets after the class name (`class Name[T: Bound, *Ts, **P]:`), keeping each bound and constraint; keep `Generic` if declared variance matters.",
        "suppress": {
          "noqa": {
            "codes": [
              "UP046"
            ]
          }
        }
      }
    }
  ]
}
