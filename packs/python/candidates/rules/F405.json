{
  "format": "rerail.policy/v1",
  "id": "ruff:F405",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's F405 (undefined-local-with-import-star-usage) on the engine's name resolution (M10a `resolves.unresolved: \"star\"`): a reference, or a string entry of a module `__all__`, that no binding in scope and no builtin resolves and that a visible star import may bind, reported on the name or the string; and such a name inside a string Ruff parses as a type definition (M11a `parse` with `annotation`, nested strings included), reported on each such name inside the string.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "undefined-local-with-import-star-usage",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "star-in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "identifier",
                      "resolves": {
                        "unresolved": "star"
                      },
                      "capture": "NAME"
                    },
                    {
                      "matches": "star-in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "string"
                  }
                ],
                "pattern": "$NAME",
                "resolves": {
                  "unresolved": "star"
                }
              },
              {
                "matches": "star-in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.NAME",
        "code": "F405",
        "message": "`$NAME` may be undefined, or defined from star imports",
        "each": "NAME"
      }
    }
  ]
}
