{
  "format": "rerail.policy/v1",
  "id": "ruff-n814-camelcase-imported-as-constant",
  "revision": 1,
  "mode": "steer",
  "description": "Keep the alias of an imported CamelCase name in CamelCase; an UPPER_CASE alias makes readers mistake a class for a constant.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "camelcase-imported-as-constant",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "has-upper": {
              "regex": "[\\p{Uppercase}\\x{1C5}\\x{1C8}\\x{1CB}\\x{1F2}\\x{1D2C}-\\x{1D2E}\\x{1D30}-\\x{1D3A}\\x{1D3C}-\\x{1D42}\\x{2C7D}\\x{A7F1}-\\x{A7F4}\\x{A7F8}]"
            },
            "cased-lower": {
              "all": [
                {
                  "regex": "\\p{Lowercase}"
                },
                {
                  "not": {
                    "matches": "has-upper"
                  }
                }
              ]
            },
            "cased-upper": {
              "all": [
                {
                  "matches": "has-upper"
                },
                {
                  "regex": "^[\\P{Lowercase}\\x{1D2C}-\\x{1D2E}\\x{1D30}-\\x{1D3A}\\x{1D3C}-\\x{1D42}\\x{2C7D}\\x{A7F1}-\\x{A7F4}\\x{A7F8}]*$"
                },
                {
                  "not": {
                    "regex": "[\\x{1C5}\\x{1C8}\\x{1CB}\\x{1F2}]"
                  }
                }
              ]
            },
            "camelcase": {
              "all": [
                {
                  "not": {
                    "regex": "_"
                  }
                },
                {
                  "not": {
                    "matches": "cased-lower"
                  }
                },
                {
                  "not": {
                    "matches": "cased-upper"
                  }
                },
                {
                  "not": {
                    "regex": "^(?:setUp|tearDown|setUpClass|tearDownClass|setUpModule|tearDownModule|asyncSetUp|asyncTearDown|setUpTestData|failureException|longMessage|maxDiff)$"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "aliased_import",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "name",
                  "kind": "dotted_name",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "identifier",
                    "nthChild": {
                      "position": 1,
                      "reverse": true,
                      "ofRule": {
                        "kind": "identifier"
                      }
                    },
                    "pattern": "$NAME",
                    "matches": "camelcase"
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "alias",
                  "kind": "identifier",
                  "pattern": "$ASNAME",
                  "regex": "^..",
                  "matches": "cased-upper"
                }
              }
            ],
            "compare": {
              "left": "ACRONYM",
              "op": "ne",
              "right": "ASNAME"
            }
          },
          "transform": {
            "ACRONYM": {
              "replace": {
                "source": "$NAME",
                "replace": "\\P{Uppercase}",
                "by": ""
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "N814",
        "message": "Import `$NAME` without `as $ASNAME`, or use a CamelCase alias, and update its uses; keep the alias if `$NAME` is really a constant.",
        "suppress": {
          "noqa": {
            "codes": [
              "N814"
            ]
          }
        }
      }
    }
  ]
}
