{
  "format": "rerail.policy/v1",
  "id": "ruff-ret504-unnecessary-assign",
  "revision": 1,
  "mode": "steer",
  "description": "Return a value directly instead of assigning it to a local variable just to return that variable on the next line.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-assign",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "analysed-function": {
              "kind": "function_definition",
              "all": [
                {
                  "not": {
                    "has": {
                      "stopBy": {
                        "any": [
                          {
                            "kind": "function_definition"
                          },
                          {
                            "kind": "class_definition"
                          }
                        ]
                      },
                      "kind": "yield"
                    }
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "return_statement"
                      },
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "kind": "return_statement"
                              },
                              {
                                "kind": "comment"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "none-literal": {
              "any": [
                {
                  "kind": "none"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "none-literal"
                  }
                }
              ]
            },
            "value-return": {
              "kind": "return_statement",
              "has": {
                "stopBy": "neighbor",
                "regex": "(?s).",
                "not": {
                  "any": [
                    {
                      "regex": "^return$"
                    },
                    {
                      "kind": "comment"
                    },
                    {
                      "matches": "none-literal"
                    }
                  ]
                }
              }
            },
            "own-return": {
              "kind": "return_statement"
            },
            "has-result": {
              "has": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "matches": "value-return"
              }
            },
            "name-target": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$N"
                },
                {
                  "kind": "tuple_pattern",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "name-target"
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "name-target"
                  }
                }
              ]
            },
            "simple-assignment": {
              "kind": "expression_statement",
              "has": {
                "stopBy": "neighbor",
                "kind": "assignment",
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "(?s)."
                        }
                      },
                      "matches": "name-target"
                    }
                  },
                  {
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "kind": "type"
                          },
                          {
                            "kind": "assignment"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "suppress-callee": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "contextlib.suppress"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "suppress-callee"
                  }
                }
              ]
            },
            "suppress-call": {
              "kind": "call",
              "has": {
                "stopBy": "neighbor",
                "not": {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "(?s)."
                  }
                },
                "matches": "suppress-callee"
              }
            },
            "with-ending-in-assignment": {
              "kind": "with_statement",
              "all": [
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "with_clause",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "with_item",
                        "has": {
                          "stopBy": "neighbor",
                          "any": [
                            {
                              "matches": "suppress-call"
                            },
                            {
                              "kind": "as_pattern",
                              "has": {
                                "stopBy": "neighbor",
                                "not": {
                                  "follows": {
                                    "stopBy": "neighbor",
                                    "regex": "(?s)."
                                  }
                                },
                                "matches": "suppress-call"
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "block",
                    "has": {
                      "stopBy": "neighbor",
                      "all": [
                        {
                          "matches": "last-statement"
                        },
                        {
                          "matches": "simple-assignment"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "own-binding": {
              "inside": {
                "stopBy": {
                  "kind": "function_definition"
                },
                "kind": "function_definition",
                "pattern": "$G",
                "compare": {
                  "left": "G",
                  "op": "eq",
                  "right": "F",
                  "text": "node"
                }
              }
            },
            "nested-use": {
              "any": [
                {
                  "has": {
                    "stopBy": "end",
                    "kind": "identifier",
                    "pattern": "$N",
                    "binds": {
                      "scope": "function",
                      "latest": true,
                      "nestedUse": true,
                      "site": {
                        "matches": "own-binding"
                      }
                    }
                  }
                },
                {
                  "all": [
                    {
                      "has": {
                        "stopBy": "end",
                        "kind": "identifier",
                        "pattern": "$N",
                        "binds": {
                          "latest": true,
                          "outer": true
                        }
                      }
                    },
                    {
                      "has": {
                        "stopBy": "end",
                        "kind": "identifier",
                        "pattern": "$N",
                        "binds": {
                          "scope": "function",
                          "outer": false,
                          "nestedUse": true,
                          "site": {
                            "matches": "own-binding"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            "declared-elsewhere": {
              "has": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "any": [
                  {
                    "any": [
                      {
                        "kind": "global_statement"
                      },
                      {
                        "kind": "nonlocal_statement"
                      }
                    ],
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "identifier",
                      "pattern": "$N"
                    }
                  },
                  {
                    "kind": "expression_statement",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "assignment",
                      "all": [
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "not": {
                              "follows": {
                                "stopBy": "neighbor",
                                "regex": "(?s)."
                              }
                            },
                            "kind": "identifier",
                            "pattern": "$N"
                          }
                        },
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "type"
                          }
                        },
                        {
                          "not": {
                            "has": {
                              "stopBy": "neighbor",
                              "regex": "^=$"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "read-in-enclosing-finally": {
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "any": [
                  {
                    "kind": "block"
                  },
                  {
                    "kind": "except_clause"
                  },
                  {
                    "kind": "else_clause"
                  }
                ],
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "try_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "finally_clause",
                    "has": {
                      "stopBy": "end",
                      "kind": "identifier",
                      "pattern": "$N",
                      "matches": "name-read",
                      "resolves": {
                        "binding": {
                          "scope": "function",
                          "site": {
                            "matches": "own-binding"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "name-read": {
              "not": {
                "any": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "attribute"
                    },
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "^\\.$"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "keyword_argument"
                    },
                    "not": {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "(?s)."
                      }
                    }
                  }
                ]
              }
            },
            "last-statement": {
              "not": {
                "any": [
                  {
                    "kind": "comment"
                  },
                  {
                    "precedes": {
                      "stopBy": "end",
                      "regex": "(?s).",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                ]
              }
            },
            "returned-value": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "return_statement"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "returned-value"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "identifier",
            "pattern": "$N",
            "all": [
              {
                "matches": "returned-value"
              },
              {
                "inside": {
                  "stopBy": {
                    "kind": "return_statement"
                  },
                  "kind": "return_statement",
                  "follows": {
                    "stopBy": {
                      "regex": "(?s).",
                      "not": {
                        "any": [
                          {
                            "kind": "comment"
                          },
                          {
                            "regex": "^;$"
                          }
                        ]
                      }
                    },
                    "any": [
                      {
                        "matches": "simple-assignment"
                      },
                      {
                        "matches": "with-ending-in-assignment"
                      }
                    ]
                  }
                }
              },
              {
                "inside": {
                  "stopBy": {
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  },
                  "kind": "function_definition",
                  "pattern": "$F",
                  "all": [
                    {
                      "matches": "analysed-function"
                    },
                    {
                      "not": {
                        "any": [
                          {
                            "matches": "nested-use"
                          },
                          {
                            "matches": "declared-elsewhere"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "not": {
                  "matches": "read-in-enclosing-finally"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RET504",
        "message": "Return the expression directly instead of assigning it to `$N` and then returning `$N`.",
        "suppress": {
          "noqa": {
            "codes": [
              "RET504"
            ]
          }
        }
      }
    }
  ]
}
