{
  "format": "rerail.policy/v1",
  "id": "bandit-b202-tarfile-unsafe-members",
  "revision": 2,
  "mode": "steer",
  "description": "Validate members before calling extractall() on an archive from tarfile.open; crafted entries can write files outside the target directory.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "b202",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "call",
            "has": {
              "field": "function",
              "any": [
                {
                  "kind": "identifier",
                  "regex": "extractall"
                },
                {
                  "kind": "attribute",
                  "has": {
                    "field": "attribute",
                    "regex": "extractall"
                  }
                }
              ]
            },
            "not": {
              "has": {
                "field": "arguments",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "keyword_argument",
                  "all": [
                    {
                      "has": {
                        "field": "name",
                        "regex": "^filter$"
                      }
                    },
                    {
                      "has": {
                        "field": "value",
                        "matches": "data-literal"
                      }
                    }
                  ]
                }
              }
            },
            "matches": "after-tarfile-import"
          },
          "utils": {
            "data-literal": {
              "any": [
                {
                  "kind": "string",
                  "value": {
                    "eq": "data"
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string_start",
                      "regex": "(?i)^[rubft]*[ft]"
                    }
                  }
                },
                {
                  "kind": "concatenated_string",
                  "value": {
                    "eq": "data"
                  },
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "string_start",
                      "regex": "(?i)^[rubft]*[ft]"
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "data-literal"
                  }
                }
              ]
            },
            "tarfile-import": {
              "kind": "import_statement",
              "has": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "dotted_name",
                    "regex": "^tarfile$"
                  },
                  {
                    "kind": "aliased_import",
                    "has": {
                      "field": "name",
                      "regex": "^tarfile$"
                    }
                  }
                ]
              }
            },
            "after-tarfile-import": {
              "inside": {
                "stopBy": "end",
                "follows": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "tarfile-import"
                    },
                    {
                      "has": {
                        "stopBy": "end",
                        "matches": "tarfile-import"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "violation": {
        "code": "B202",
        "anchor": "witness.span",
        "message": "Pass filter=\"data\" to this extractall call, or validate each member's path, so entries can't escape the target directory.",
        "suppress": {
          "nosec": {
            "codes": [
              "B202"
            ]
          }
        }
      }
    }
  ]
}
