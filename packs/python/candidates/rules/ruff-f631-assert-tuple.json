{
  "format": "rerail.policy/v1",
  "id": "ruff-f631-assert-tuple",
  "revision": 1,
  "mode": "steer",
  "description": "Don't use a tuple as an assert's condition; a non-empty tuple is always true, so the assert never fails.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "assert-tuple",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "non-empty-tuple": {
              "any": [
                {
                  "kind": "tuple",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "any": [
                        {
                          "regex": "^[(),]$"
                        },
                        {
                          "kind": "comment"
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "non-empty-tuple"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "assert_statement",
            "has": {
              "stopBy": "neighbor",
              "matches": "non-empty-tuple",
              "follows": {
                "stopBy": "neighbor",
                "regex": "^assert$"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F631",
        "message": "Drop the parentheses around this assert's condition and message so it reads `assert condition, message`.",
        "suppress": {
          "noqa": {
            "codes": [
              "F631"
            ]
          }
        }
      }
    }
  ]
}
