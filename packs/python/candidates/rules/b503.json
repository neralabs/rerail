{
  "format": "rerail.policy/v1",
  "id": "bandit:b503",
  "revision": 1,
  "mode": "steer",
  "description": "Flag function-parameter defaults that resolve through Python imports to configured insecure SSL/TLS protocol constants",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B503",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "default_parameter"
                  },
                  {
                    "kind": "typed_default_parameter"
                  }
                ]
              },
              {
                "inside": {
                  "kind": "parameters"
                }
              },
              {
                "has": {
                  "field": "value",
                  "pattern": "$V"
                }
              }
            ]
          },
          "constraints": {
            "V": {
              "resolves": {
                "import": [
                  "ssl.PROTOCOL_SSLv2",
                  "ssl.PROTOCOL_SSLv3",
                  "ssl.PROTOCOL_TLSv1",
                  "ssl.PROTOCOL_TLSv1_1",
                  "pyOpenSSL.SSL.SSLv2_METHOD",
                  "pyOpenSSL.SSL.SSLv23_METHOD",
                  "pyOpenSSL.SSL.SSLv3_METHOD",
                  "pyOpenSSL.SSL.TLSv1_METHOD",
                  "pyOpenSSL.SSL.TLSv1_1_METHOD"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B503",
        "anchor": "witness.span",
        "message": "Function default uses an insecure SSL/TLS protocol"
      }
    }
  ]
}
