{
  "format": "rerail.policy/v1",
  "id": "ruff-up018-native-literals",
  "revision": 1,
  "mode": "steer",
  "description": "Write the literal directly instead of calling str, bytes, int, float, bool or complex on a literal or with no arguments.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "not-argument": { "any": [{ "regex": "^[(),]$" }, { "kind": "comment" }, { "kind": "line_continuation" }] },
          "plain-string": {
            "any": [
              { "kind": "string", "not": { "regex": "^[A-Za-z]*[fFtT]" } },
              { "kind": "concatenated_string", "not": { "has": { "stopBy": "neighbor", "kind": "string", "regex": "^[A-Za-z]*[fFtT]" } } }
            ]
          },
          "nested-fstring": {
            "inside": {
              "stopBy": "end",
              "kind": "string",
              "regex": "^[A-Za-z]*[fF]",
              "inside": { "stopBy": "end", "kind": "string", "regex": "^[A-Za-z]*[fF]" }
            }
          },
          "callee-str": {
            "any": [
              { "any": [{ "kind": "identifier" }, { "kind": "attribute" }], "resolves": { "global": ["str"], "import": ["builtins.str"] } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "callee-str" } }
            ]
          },
          "literal-str": {
            "any": [
              { "matches": "plain-string", "value": { "type": "str" } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "literal-str" } }
            ]
          },
          "callee-bytes": {
            "any": [
              { "any": [{ "kind": "identifier" }, { "kind": "attribute" }], "resolves": { "global": ["bytes"], "import": ["builtins.bytes"] } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "callee-bytes" } }
            ]
          },
          "literal-bytes": {
            "any": [
              { "matches": "plain-string", "value": { "type": "bytes" } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "literal-bytes" } }
            ]
          },
          "callee-int": {
            "any": [
              { "any": [{ "kind": "identifier" }, { "kind": "attribute" }], "resolves": { "global": ["int"], "import": ["builtins.int"] } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "callee-int" } }
            ]
          },
          "literal-int": {
            "any": [
              { "any": [{ "kind": "integer" }, { "kind": "float" }], "value": { "type": "int" } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "literal-int" } }
            ]
          },
          "signed-int": {
            "any": [
              { "matches": "literal-int" },
              {
                "kind": "unary_operator",
                "has": { "stopBy": "neighbor", "field": "operator", "regex": "^[+-]$" },
                "all": [{ "has": { "stopBy": "neighbor", "field": "argument", "matches": "literal-int" } }]
              }
            ]
          },
          "callee-float": {
            "any": [
              { "any": [{ "kind": "identifier" }, { "kind": "attribute" }], "resolves": { "global": ["float"], "import": ["builtins.float"] } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "callee-float" } }
            ]
          },
          "literal-float": {
            "any": [
              { "any": [{ "kind": "integer" }, { "kind": "float" }], "value": { "type": "float" } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "literal-float" } }
            ]
          },
          "signed-float": {
            "any": [
              { "matches": "literal-float" },
              {
                "kind": "unary_operator",
                "has": { "stopBy": "neighbor", "field": "operator", "regex": "^[+-]$" },
                "all": [{ "has": { "stopBy": "neighbor", "field": "argument", "matches": "literal-float" } }]
              }
            ]
          },
          "callee-bool": {
            "any": [
              { "any": [{ "kind": "identifier" }, { "kind": "attribute" }], "resolves": { "global": ["bool"], "import": ["builtins.bool"] } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "callee-bool" } }
            ]
          },
          "literal-bool": {
            "any": [
              { "kind": "true" },
              { "kind": "false" },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "literal-bool" } }
            ]
          },
          "callee-complex": {
            "any": [
              { "any": [{ "kind": "identifier" }, { "kind": "attribute" }], "resolves": { "global": ["complex"], "import": ["builtins.complex"] } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "callee-complex" } }
            ]
          },
          "literal-complex": {
            "any": [
              { "any": [{ "kind": "integer" }, { "kind": "float" }], "value": { "type": "complex" } },
              { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "literal-complex" } }
            ]
          },
          "signed-complex": {
            "any": [
              { "matches": "literal-complex" },
              {
                "kind": "unary_operator",
                "has": { "stopBy": "neighbor", "field": "operator", "regex": "^[+-]$" },
                "all": [{ "has": { "stopBy": "neighbor", "field": "argument", "matches": "literal-complex" } }]
              }
            ]
          },
          "unnested-call": { "kind": "call", "not": { "matches": "nested-fstring" } },
          "empty-arguments": { "kind": "argument_list", "not": { "has": { "stopBy": "neighbor", "not": { "matches": "not-argument" } } } },
          "single-argument": { "kind": "argument_list", "count": { "has": { "stopBy": "neighbor", "not": { "matches": "not-argument" } }, "min": 1, "max": 1 } }
        }
      }
    },
    {
      "id": "str-without-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "unnested-call",
            "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-str" },
            "all": [{ "has": { "stopBy": "neighbor", "field": "arguments", "matches": "empty-arguments" } }]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP018",
        "message": "Replace this `str()` call with the literal `\"\"`.",
        "suppress": { "noqa": { "codes": ["UP018"] } }
      }
    },
    {
      "id": "bytes-without-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "unnested-call",
            "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-bytes" },
            "all": [{ "has": { "stopBy": "neighbor", "field": "arguments", "matches": "empty-arguments" } }]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP018",
        "message": "Replace this `bytes()` call with the literal `b\"\"`.",
        "suppress": { "noqa": { "codes": ["UP018"] } }
      }
    },
    {
      "id": "int-without-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "unnested-call",
            "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-int" },
            "all": [{ "has": { "stopBy": "neighbor", "field": "arguments", "matches": "empty-arguments" } }]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP018",
        "message": "Replace this `int()` call with the literal `0`.",
        "suppress": { "noqa": { "codes": ["UP018"] } }
      }
    },
    {
      "id": "float-without-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "unnested-call",
            "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-float" },
            "all": [{ "has": { "stopBy": "neighbor", "field": "arguments", "matches": "empty-arguments" } }]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP018",
        "message": "Replace this `float()` call with the literal `0.0`.",
        "suppress": { "noqa": { "codes": ["UP018"] } }
      }
    },
    {
      "id": "bool-without-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "unnested-call",
            "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-bool" },
            "all": [{ "has": { "stopBy": "neighbor", "field": "arguments", "matches": "empty-arguments" } }]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP018",
        "message": "Replace this `bool()` call with the literal `False`.",
        "suppress": { "noqa": { "codes": ["UP018"] } }
      }
    },
    {
      "id": "complex-without-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "unnested-call",
            "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-complex" },
            "all": [{ "has": { "stopBy": "neighbor", "field": "arguments", "matches": "empty-arguments" } }]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP018",
        "message": "Replace this `complex()` call with the literal `0j`.",
        "suppress": { "noqa": { "codes": ["UP018"] } }
      }
    },
    {
      "id": "call-on-literal",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "matches": "unnested-call",
                "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-str" },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "single-argument",
                      "has": { "stopBy": "neighbor", "matches": "literal-str" }
                    }
                  }
                ]
              },
              {
                "matches": "unnested-call",
                "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-str" },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "single-argument",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "keyword_argument",
                        "all": [
                          { "has": { "stopBy": "neighbor", "field": "name", "regex": "^object$" } },
                          { "has": { "stopBy": "neighbor", "field": "value", "matches": "literal-str" } }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "matches": "unnested-call",
                "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-bytes" },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "single-argument",
                      "has": { "stopBy": "neighbor", "matches": "literal-bytes" }
                    }
                  }
                ]
              },
              {
                "matches": "unnested-call",
                "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-int" },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "single-argument",
                      "has": { "stopBy": "neighbor", "matches": "signed-int" }
                    }
                  }
                ]
              },
              {
                "matches": "unnested-call",
                "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-float" },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "single-argument",
                      "has": { "stopBy": "neighbor", "matches": "signed-float" }
                    }
                  }
                ]
              },
              {
                "matches": "unnested-call",
                "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-bool" },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "single-argument",
                      "has": { "stopBy": "neighbor", "matches": "literal-bool" }
                    }
                  }
                ]
              },
              {
                "matches": "unnested-call",
                "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-complex" },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "single-argument",
                      "has": { "stopBy": "neighbor", "matches": "signed-complex" }
                    }
                  }
                ]
              },
              {
                "matches": "unnested-call",
                "has": { "stopBy": "neighbor", "field": "function", "matches": "callee-complex" },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "single-argument",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "keyword_argument",
                        "all": [
                          { "has": { "stopBy": "neighbor", "field": "name", "regex": "^real$" } },
                          { "has": { "stopBy": "neighbor", "field": "value", "matches": "signed-complex" } }
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP018",
        "message": "Replace this call with the literal inside it; wrapping a literal of the same type in its own type changes nothing.",
        "suppress": { "noqa": { "codes": ["UP018"] } }
      }
    }
  ]
}
