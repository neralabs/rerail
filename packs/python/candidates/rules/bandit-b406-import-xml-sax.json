{
  "format": "rerail.policy/v1",
  "id": "bandit-b406-import-xml-sax",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid parsing XML with xml.sax (importing only its saxutils helpers is fine); it is open to XML attacks, so use defusedxml.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B406",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import xml.sax"
              },
              {
                "pattern": "import xml.sax as $ALIAS"
              },
              {
                "pattern": "from xml.sax import $$$NAMES"
              },
              {
                "pattern": "from xml import sax"
              },
              {
                "pattern": "from xml import sax as $ALIAS"
              }
            ],
            "not": {
              "any": [
                {
                  "pattern": "from xml.sax.saxutils import $$$NAMES"
                },
                {
                  "pattern": "from xml.sax import saxutils"
                },
                {
                  "pattern": "from xml.sax import saxutils as $ALIAS"
                },
                {
                  "pattern": "from xml.sax import (saxutils)"
                },
                {
                  "pattern": "from xml.sax import (saxutils as $ALIAS)"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "code": "B406",
        "anchor": "witness.span",
        "message": "Parse this XML with defusedxml.sax instead of xml.sax; the standard parser is open to XML entity attacks.",
        "suppress": {
          "nosec": {
            "codes": [
              "B406"
            ]
          }
        }
      }
    }
  ]
}
