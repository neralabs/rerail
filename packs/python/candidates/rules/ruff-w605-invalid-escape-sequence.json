{
  "format": "rerail.policy/v1",
  "id": "ruff-w605-invalid-escape-sequence",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid invalid backslash escape sequences in Python strings; use a raw string or a doubled backslash instead.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "invalid-escape-sequence",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "regex": "^\\\\$",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "string_content",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string_start",
                        "regex": "[rR]"
                      }
                    }
                  }
                }
              },
              {
                "kind": "escape_sequence",
                "regex": "^\\\\[^\\n\\r\\\\'\"abfnrtv0-7xNuU]",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "string_content",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string_start",
                        "regex": "[rR]"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "W605",
        "message": "Invalid escape sequence",
        "suppress": {
          "noqa": {
            "codes": [
              "W605"
            ]
          }
        }
      }
    },
    {
      "id": "invalid-escape-sequence-format-spec",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "format_specifier",
            "regex": "\\\\[\\n\\r\\\\'\"abfnrtv0-7xNuU]|(?<BS>\\\\(?:[^\\n\\r\\\\'\"abfnrtv0-7xNuU]|$))",
            "inside": {
              "stopBy": "neighbor",
              "kind": "interpolation",
              "inside": {
                "stopBy": "neighbor",
                "kind": "string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string_start",
                    "regex": "[rR]"
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.BS",
        "code": "W605",
        "message": "Double this backslash in the format spec, or make the string raw with an `rf` prefix.",
        "each": "BS",
        "suppress": {
          "noqa": {
            "codes": [
              "W605"
            ]
          }
        }
      }
    }
  ]
}
