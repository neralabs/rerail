{
  "format": "rerail.policy/v1",
  "id": "ruff-w605-invalid-escape-sequence",
  "revision": 2,
  "mode": "steer",
  "description": "Port of Ruff's W605 (invalid-escape-sequence): a backslash in a non-raw string, bytes, f-string or t-string literal part that does not start a valid escape (newline, backslash, quotes, `a b f n r t v`, octal digits `0`-`7`, `x`, `N`, `u`, `U`; Ruff accepts `N`, `u` and `U` in bytes too), one finding per backslash, spanning the backslash and the character after it as Ruff does. Backslashes pair left to right (`\\\\` is one valid escape). In an f-string or t-string Ruff reads each literal element and the top-level literal text of each replacement field's format specifier, not the specifiers of nested fields (whose expressions are strings of their own); a literal element that ends in an unpaired backslash is completed by the next source character, the `{` that opens the next replacement field or the `}` that closes the specifier's field.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "invalid-escape-sequence",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "cooked": {
              "kind": "string",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string_start",
                  "regex": "[rR]"
                }
              }
            }
          },
          "rule": {
            "kind": "string_content",
            "regex": "\\\\[\\n\\r\\\\'\"abfnrtv0-7xNuU]|(?<BS>\\\\[^\\n\\r\\\\'\"abfnrtv0-7xNuU])",
            "inside": {
              "stopBy": "neighbor",
              "matches": "cooked"
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.BS",
        "code": "W605",
        "message": "Invalid escape sequence: `$BS`",
        "each": "BS",
        "suppress": {
          "noqa": {
            "codes": [
              "W605"
            ]
          }
        }
      }
    },
    {
      "id": "invalid-escape-sequence-before-field",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "string",
            "regex": "\\\\\\\\|(?<BS>\\\\\\{)[^{]",
            "not": {
              "any": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string_start",
                    "regex": "[rR]"
                  }
                },
                {
                  "has": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "string"
                      },
                      {
                        "kind": "format_specifier"
                      }
                    ],
                    "regex": "\\\\\\{"
                  }
                }
              ]
            },
            "has": {
              "stopBy": "neighbor",
              "kind": "string_content",
              "regex": "(?:^|[^\\\\])(?:\\\\\\\\)*\\\\$",
              "precedes": {
                "stopBy": "neighbor",
                "kind": "interpolation"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.BS",
        "code": "W605",
        "message": "Invalid escape sequence: `$BS`",
        "each": "BS",
        "suppress": {
          "noqa": {
            "codes": [
              "W605"
            ]
          }
        }
      }
    },
    {
      "id": "invalid-escape-sequence-format-spec",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "cooked-field": {
              "kind": "interpolation",
              "inside": {
                "stopBy": "neighbor",
                "kind": "string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string_start",
                    "regex": "[rR]"
                  }
                }
              }
            }
          },
          "rule": {
            "kind": "format_specifier",
            "regex": "\\{(?:[^{}]|\\{[^{}]*\\})*\\}|\\\\[\\n\\r\\\\'\"abfnrtv0-7xNuU]|(?<BS>\\\\[^\\n\\r\\\\'\"abfnrtv0-7xNuU])",
            "inside": {
              "stopBy": "neighbor",
              "matches": "cooked-field"
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.BS",
        "code": "W605",
        "message": "Invalid escape sequence: `$BS`",
        "each": "BS",
        "suppress": {
          "noqa": {
            "codes": [
              "W605"
            ]
          }
        }
      }
    },
    {
      "id": "invalid-escape-sequence-end-of-format-spec",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "interpolation",
            "regex": "(?<BS>\\\\\\})$",
            "has": {
              "stopBy": "neighbor",
              "kind": "format_specifier",
              "regex": "(?:^|[^\\\\])(?:\\\\\\\\)*\\\\$"
            },
            "inside": {
              "stopBy": "neighbor",
              "kind": "string",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string_start",
                  "regex": "[rR]"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.BS",
        "code": "W605",
        "message": "Invalid escape sequence: `$BS`",
        "suppress": {
          "noqa": {
            "codes": [
              "W605"
            ]
          }
        }
      }
    }
  ]
}
