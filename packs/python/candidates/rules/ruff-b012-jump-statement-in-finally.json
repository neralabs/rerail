{
  "format": "rerail.policy/v1",
  "id": "ruff-b012-jump-statement-in-finally",
  "revision": 1,
  "mode": "steer",
  "description": "Don't return, break or continue inside a finally block; it silently discards any exception being raised.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "in-finally-outside-loop": {
            "inside": {
              "stopBy": "neighbor",
              "kind": "block",
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "finally_clause"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "if_statement"
                      },
                      {
                        "kind": "try_statement"
                      },
                      {
                        "kind": "with_statement"
                      }
                    ],
                    "matches": "in-finally-outside-loop"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "case_clause",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "match_statement",
                        "matches": "in-finally-outside-loop"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "return-in-finally",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "in-finally": {
              "inside": {
                "stopBy": "neighbor",
                "kind": "block",
                "any": [
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "finally_clause"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "if_statement"
                        },
                        {
                          "kind": "try_statement"
                        },
                        {
                          "kind": "with_statement"
                        },
                        {
                          "kind": "while_statement"
                        },
                        {
                          "kind": "for_statement"
                        }
                      ],
                      "matches": "in-finally"
                    }
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "case_clause",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "block",
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "match_statement",
                          "matches": "in-finally"
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "rule": {
            "any": [
              {
                "kind": "return_statement"
              }
            ],
            "matches": "in-finally"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B012",
        "message": "`return` inside `finally` blocks cause exceptions to be silenced",
        "suppress": {
          "noqa": {
            "codes": [
              "B012"
            ]
          }
        }
      }
    },
    {
      "id": "break-in-finally",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "break_statement"
              }
            ],
            "matches": "in-finally-outside-loop"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B012",
        "message": "`break` inside `finally` blocks cause exceptions to be silenced",
        "suppress": {
          "noqa": {
            "codes": [
              "B012"
            ]
          }
        }
      }
    },
    {
      "id": "continue-in-finally",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "continue_statement"
              }
            ],
            "matches": "in-finally-outside-loop"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B012",
        "message": "`continue` inside `finally` blocks cause exceptions to be silenced",
        "suppress": {
          "noqa": {
            "codes": [
              "B012"
            ]
          }
        }
      }
    }
  ]
}