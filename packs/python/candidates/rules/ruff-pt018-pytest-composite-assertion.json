{
  "format": "rerail.policy/v1",
  "id": "ruff-pt018-pytest-composite-assertion",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's PT018 (pytest-composite-assertion), `composite_condition` in flake8_pytest_style/rules/assertion.rs: an `assert` statement whose test (the expression after `assert`, comments, line continuations and parentheses transparent) is an `and` operation (`a and b`, whatever its operands), or a `not` whose operand (parentheses transparent) is an `or` operation (`not (a or b)`, mixed `and` operands included). An `assert` with a message is reported too. Reported on the `assert` statement.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "pytest-composite-assertion",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "test": {
              "follows": {
                "stopBy": {
                  "not": {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "kind": "line_continuation"
                      }
                    ]
                  }
                },
                "regex": "^assert$"
              }
            },
            "bool-op-and": {
              "any": [
                {
                  "kind": "boolean_operator",
                  "has": {
                    "field": "operator",
                    "regex": "^and$"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "bool-op-and"
                  }
                }
              ]
            },
            "bool-op-or": {
              "any": [
                {
                  "kind": "boolean_operator",
                  "has": {
                    "field": "operator",
                    "regex": "^or$"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "bool-op-or"
                  }
                }
              ]
            },
            "composite": {
              "any": [
                {
                  "matches": "bool-op-and"
                },
                {
                  "kind": "not_operator",
                  "has": {
                    "field": "argument",
                    "matches": "bool-op-or"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "composite"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "assert_statement",
            "has": {
              "stopBy": "neighbor",
              "all": [
                {
                  "matches": "test"
                },
                {
                  "matches": "composite"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PT018",
        "message": "Assertion should be broken down into multiple parts",
        "suppress": {
          "noqa": {
            "codes": [
              "PT018"
            ]
          }
        }
      }
    }
  ]
}
