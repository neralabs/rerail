{
  "format": "rerail.policy/v1",
  "id": "ruff-pyi054-numeric-literal-too-long",
  "revision": 1,
  "mode": "steer",
  "description": "Replace long numeric literals in stub files with an ellipsis; a value that long is an implementation detail or varies by system.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "numeric-literal-too-long",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "path": {
              "regex": "\\.pyi$"
            }
          },
          "rule": {
            "any": [
              {
                "kind": "integer"
              },
              {
                "kind": "float"
              }
            ],
            "regex": "^[\\s\\S]{11,}$"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PYI054",
        "message": "Replace this long numeric literal with `...` in the stub; the exact value is an implementation detail that stubs should not pin.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI054"
            ]
          }
        }
      }
    },
    {
      "id": "numeric-literal-too-long-in-string-annotation",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "path": {
              "regex": "\\.pyi$"
            }
          },
          "utils": {
            "in-annotation": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "any": [
                        {
                          "kind": "integer"
                        },
                        {
                          "kind": "float"
                        }
                      ],
                      "regex": "^[\\s\\S]{11,}$",
                      "capture": "LONG"
                    },
                    {
                      "matches": "in-annotation"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "matches": "in-annotation"
          }
        }
      },
      "violation": {
        "anchor": "capture.LONG",
        "code": "PYI054",
        "message": "Replace this long numeric literal with `...` in the stub; the exact value is an implementation detail that stubs should not pin.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI054"
            ]
          }
        },
        "each": "LONG"
      }
    }
  ]
}
