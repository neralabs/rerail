{
  "format": "rerail.policy/v1",
  "id": "ruff-d102-undocumented-public-method",
  "revision": 1,
  "mode": "steer",
  "description": "Document each public Python method with a docstring describing its behavior, arguments and return value.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "undocumented-public-method",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "module": {
              "notRegex": "(?:^|\\.)(?:_|_[^_.][^.]*|__[^.]*[^_.]_?)(?:\\.|$)"
            },
            "path": {
              "notRegex": "\\.pyi$"
            }
          },
          "utils": {
            "doc-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string_start",
                      "regex": "[bBfFtT]"
                    }
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string_start",
                        "regex": "[bBfFtT]"
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "doc-string"
                  }
                }
              ]
            },
            "docstring": {
              "kind": "expression_statement",
              "all": [
                {
                  "not": {
                    "follows": {
                      "stopBy": "end",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "doc-string"
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                }
              ]
            },
            "dunder-all": {
              "any": [
                {
                  "kind": "assignment"
                },
                {
                  "kind": "augmented_assignment"
                }
              ],
              "inside": {
                "stopBy": "neighbor",
                "kind": "expression_statement"
              },
              "has": {
                "stopBy": "neighbor",
                "field": "left",
                "kind": "identifier",
                "regex": "^__all__$"
              }
            },
            "paren-string": {
              "any": [
                {
                  "kind": "string",
                  "pattern": "$S",
                  "compare": {
                    "left": "S",
                    "op": "eq",
                    "right": "C",
                    "text": "unquoted"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "paren-string"
                  }
                }
              ]
            },
            "overload-ref": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "typing.overload",
                      "typing_extensions.overload",
                      "_typeshed.overload"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "overload-ref"
                  }
                }
              ]
            },
            "override-ref": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "typing.override",
                      "typing_extensions.override",
                      "_typeshed.override"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "override-ref"
                  }
                }
              ]
            },
            "accessor-ref": {
              "any": [
                {
                  "pattern": "$N.setter"
                },
                {
                  "pattern": "$N.deleter"
                },
                {
                  "pattern": "($N).setter"
                },
                {
                  "pattern": "($N).deleter"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "accessor-ref"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "identifier",
            "pattern": "$N",
            "regex": "^(?:[^_]|__(?:new|call)__$)",
            "inside": {
              "stopBy": "neighbor",
              "field": "name",
              "kind": "function_definition",
              "all": [
                {
                  "inside": {
                    "stopBy": {
                      "any": [
                        {
                          "kind": "function_definition"
                        },
                        {
                          "kind": "class_definition"
                        }
                      ]
                    },
                    "kind": "class_definition"
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "kind": "function_definition"
                    }
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "kind": "class_definition",
                      "has": {
                        "stopBy": "neighbor",
                        "field": "name",
                        "regex": "^_"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "class_definition",
                    "not": {
                      "inside": {
                        "stopBy": "end",
                        "kind": "class_definition"
                      }
                    },
                    "has": {
                      "stopBy": "neighbor",
                      "field": "name",
                      "pattern": "$C",
                      "any": [
                        {
                          "not": {
                            "inside": {
                              "stopBy": "end",
                              "kind": "module",
                              "has": {
                                "stopBy": {
                                  "any": [
                                    {
                                      "kind": "function_definition"
                                    },
                                    {
                                      "kind": "class_definition"
                                    }
                                  ]
                                },
                                "matches": "dunder-all"
                              }
                            }
                          }
                        },
                        {
                          "binds": {
                            "exported": true
                          }
                        },
                        {
                          "inside": {
                            "stopBy": "end",
                            "kind": "module",
                            "has": {
                              "stopBy": {
                                "any": [
                                  {
                                    "kind": "function_definition"
                                  },
                                  {
                                    "kind": "class_definition"
                                  }
                                ]
                              },
                              "matches": "dunder-all",
                              "has": {
                                "stopBy": "end",
                                "kind": "parenthesized_expression",
                                "inside": {
                                  "stopBy": "neighbor",
                                  "any": [
                                    {
                                      "kind": "list"
                                    },
                                    {
                                      "kind": "tuple"
                                    }
                                  ]
                                },
                                "matches": "paren-string"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "field": "body",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "docstring"
                      }
                    }
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "decorated_definition",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "decorator",
                        "has": {
                          "stopBy": "neighbor",
                          "matches": "overload-ref"
                        }
                      }
                    }
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "decorated_definition",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "decorator",
                        "has": {
                          "stopBy": "neighbor",
                          "matches": "override-ref"
                        }
                      }
                    }
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "decorated_definition",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "decorator",
                        "has": {
                          "stopBy": "neighbor",
                          "matches": "accessor-ref"
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "D102",
        "message": "Add a docstring as the first statement of method `$N`, describing what it does, its arguments and its return value.",
        "suppress": {
          "noqa": {
            "codes": [
              "D102"
            ]
          }
        }
      }
    }
  ]
}
