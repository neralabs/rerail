{
  "format": "rerail.policy/v1",
  "id": "bandit-b601-paramiko-calls",
  "revision": 1,
  "mode": "steer",
  "description": "Sanitize input passed to Paramiko SSHClient.exec_command; the command runs through a shell on the remote host.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "b601",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$CLIENT.exec_command($$$)"
          },
          "constraints": {
            "CLIENT": {
              "resolves": {
                "binding": {
                  "value": {
                    "matches": "paramiko-client"
                  }
                }
              }
            },
            "CTOR": {
              "resolves": {
                "import": [
                  "paramiko.SSHClient",
                  "paramiko.client.SSHClient"
                ]
              }
            }
          },
          "utils": {
            "paramiko-client": {
              "pattern": "$CTOR($$$)"
            }
          }
        }
      },
      "violation": {
        "code": "B601",
        "anchor": "witness.span",
        "message": "Quote any untrusted values with shlex.quote before passing them to exec_command; the command runs through a shell on the remote host.",
        "suppress": {
          "nosec": {
            "codes": [
              "B601"
            ]
          }
        }
      }
    }
  ]
}
