{
  "format": "rerail.policy/v1",
  "id": "bandit-b608-hardcoded-sql-expressions",
  "revision": 1,
  "mode": "steer",
  "description": "SQL text built with %-formatting, `.format()`, an f-string or `+`.",
  "scope": {
    "include": [
      "**/*.py",
      "**/*.pyi"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "fstring",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "string",
            "regex": "(?is)\\b(?:select\\s.*\\sfrom\\s|delete\\s+from\\s|insert\\s+into\\s.*\\svalues\\b|update\\s.*\\sset\\s)",
            "has": {
              "kind": "interpolation"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B608",
        "message": "Possible SQL injection: this query is built from values. Pass them as query parameters.",
        "suppress": {
          "nosec": {
            "codes": [
              "B608"
            ]
          }
        }
      }
    },
    {
      "id": "operator",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "string",
            "regex": "(?is)\\b(?:select\\s.*\\sfrom\\s|delete\\s+from\\s|insert\\s+into\\s.*\\svalues\\b|update\\s.*\\sset\\s)",
            "inside": {
              "kind": "binary_operator",
              "stopBy": "neighbor",
              "has": {
                "regex": "^[%+]$"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B608",
        "message": "Possible SQL injection: this query is built from values. Pass them as query parameters.",
        "suppress": {
          "nosec": {
            "codes": [
              "B608"
            ]
          }
        }
      }
    },
    {
      "id": "format",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "string",
            "regex": "(?is)\\b(?:select\\s.*\\sfrom\\s|delete\\s+from\\s|insert\\s+into\\s.*\\svalues\\b|update\\s.*\\sset\\s)",
            "inside": {
              "kind": "attribute",
              "stopBy": "neighbor",
              "has": {
                "field": "attribute",
                "regex": "^format$"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B608",
        "message": "Possible SQL injection: this query is built from values. Pass them as query parameters.",
        "suppress": {
          "nosec": {
            "codes": [
              "B608"
            ]
          }
        }
      }
    }
  ]
}
