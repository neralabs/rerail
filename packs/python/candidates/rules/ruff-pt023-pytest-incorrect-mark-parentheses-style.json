{
  "format": "rerail.policy/v1",
  "id": "ruff-pt023-pytest-incorrect-mark-parentheses-style",
  "revision": 1,
  "mode": "steer",
  "description": "Write pytest markers that take no arguments without empty parentheses, so every marker decorator follows one consistent style.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "mark-with-empty-parentheses",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "mark-ns": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "pytest.mark"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "mark-ns"
                  }
                }
              ]
            },
            "mark-ref": {
              "any": [
                {
                  "kind": "attribute",
                  "has": {
                    "field": "object",
                    "matches": "mark-ns"
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "import": [
                      "pytest.mark"
                    ],
                    "prefix": true
                  },
                  "not": {
                    "resolves": {
                      "import": [
                        "pytest.mark"
                      ]
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "mark-ref"
                  }
                }
              ]
            },
            "empty-mark-call": {
              "any": [
                {
                  "kind": "call",
                  "has": {
                    "field": "function",
                    "matches": "mark-ref"
                  },
                  "all": [
                    {
                      "has": {
                        "field": "arguments",
                        "kind": "argument_list",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "not": {
                              "any": [
                                {
                                  "kind": "comment"
                                },
                                {
                                  "kind": "line_continuation"
                                },
                                {
                                  "regex": "^[()]$"
                                }
                              ]
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "empty-mark-call"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "decorator",
            "has": {
              "stopBy": "neighbor",
              "matches": "empty-mark-call"
            },
            "regex": "^(?P<span>(?:\"(?:[^\"\\\\]|\\\\[\\s\\S])*\"|'(?:[^'\\\\]|\\\\[\\s\\S])*'|#[^\\n]*\\n|[^#'\"])*?)(?:[ \\t]*#[^\\n]*)?$"
          }
        }
      },
      "violation": {
        "anchor": "capture.span",
        "code": "PT023",
        "message": "Remove the empty parentheses after this `pytest.mark` decorator; a marker that takes no arguments is written without them.",
        "suppress": {
          "noqa": {
            "codes": [
              "PT023"
            ]
          }
        }
      }
    }
  ]
}
