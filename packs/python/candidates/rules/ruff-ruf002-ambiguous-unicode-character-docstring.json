          }
        }
      },
      "violation": {
        "anchor": "capture.CH",
        "each": "CH",
        "code": "RUF002",
        "message": "Replace the look-alike character `$CH` in this docstring with the ASCII punctuation or space it imitates, unless the text really needs it.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF002"
            ]
          }
        }
      }
    },
