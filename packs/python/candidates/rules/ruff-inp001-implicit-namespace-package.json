{
  "format": "rerail.policy/v1",
  "id": "ruff-inp001-implicit-namespace-package",
  "revision": 1,
  "mode": "steer",
  "description": "Add an __init__.py to folders of Python modules below the project root or src; without one the folder is an implicit namespace package, which tools and test runners can miss.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": [
      "*",
      "src/*"
    ]
  },
  "clauses": [
    {
      "id": "implicit-namespace-package",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "inPackage": false
          },
          "rule": {
            "kind": "module",
            "not": {
              "any": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "comment",
                    "layout": {
                      "start": {
                        "eq": 0
                      }
                    },
                    "regex": "^#!"
                  }
                },
                {
                  "regex": "(?m)^# /// script(\\r\\n|\\r|\\n)(#( [^\\r\\n]*)?(\\r\\n|\\r|\\n))*# ///(\\r?$|\\r)"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "file.start",
        "code": "INP001",
        "message": "File is part of an implicit namespace package. Add an `__init__.py`.",
        "suppress": {
          "noqa": {
            "codes": [
              "INP001"
            ]
          }
        }
      }
    }
  ]
}
