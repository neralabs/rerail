{
  "format": "rerail.policy/v1",
  "id": "bandit-b105-hardcoded-password-string",
  "revision": 2,
  "mode": "steer",
  "description": "Don't assign or compare a string literal to a variable, attribute, or key named like a password, token, or secret; read credentials from the environment or a secret store.",
  "scope": {
    "include": [
      "**/*.py",
      "**/*.pyi"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "str-constant": {
            "any": [
              {
                "kind": "string",
                "not": {
                  "any": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "interpolation"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string_start",
                        "regex": "(?i)^[rubft]*[bft]"
                      }
                    }
                  ]
                }
              },
              {
                "kind": "concatenated_string",
                "not": {
                  "has": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "interpolation"
                      },
                      {
                        "kind": "string_start",
                        "regex": "(?i)^[rubft]*[bft]"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "constant": {
            "any": [
              {
                "any": [
                  {
                    "kind": "string",
                    "not": {
                      "any": [
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "interpolation"
                          }
                        },
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "string_start",
                            "regex": "(?i)^[rubft]*[ft]"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "kind": "concatenated_string",
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "any": [
                          {
                            "kind": "interpolation"
                          },
                          {
                            "kind": "string_start",
                            "regex": "(?i)^[rubft]*[ft]"
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "kind": "integer"
              },
              {
                "kind": "float"
              },
              {
                "kind": "true"
              },
              {
                "kind": "false"
              },
              {
                "kind": "none"
              },
              {
                "kind": "ellipsis"
              }
            ]
          },
          "candidate-target": {
            "any": [
              {
                "kind": "identifier",
                "regex": "(?i)(?:^|_)(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:$|_)"
              },
              {
                "kind": "attribute",
                "has": {
                  "field": "attribute",
                  "regex": "(?i)(?:^|_)(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:$|_)"
                }
              }
            ]
          },
          "candidate-key": {
            "kind": "string",
            "regex": "(?i)^[ru]*[\"'](?:[^\"']*_)?(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:_[^\"']*)?[\"']$",
            "not": {
              "has": {
                "stopBy": "neighbor",
                "kind": "interpolation"
              }
            }
          },
          "assigns-candidate": {
            "kind": "assignment",
            "not": {
              "has": {
                "field": "type",
                "kind": "type"
              }
            },
            "any": [
              {
                "has": {
                  "field": "left",
                  "matches": "candidate-target"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "field": "right",
                  "matches": "assigns-candidate"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "assigned",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "str-constant",
            "inside": {
              "stopBy": "neighbor",
              "field": "right",
              "matches": "assigns-candidate"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B105",
        "message": "Possible hard-coded password. Read it from the environment or a secret store.",
        "suppress": {
          "nosec": {
            "codes": [
              "B105"
            ]
          }
        }
      }
    },
    {
      "id": "subscript-assigned",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "candidate-key",
            "inside": {
              "stopBy": "neighbor",
              "kind": "subscript",
              "field": "subscript",
              "inside": {
                "kind": "assignment",
                "not": {
                  "has": {
                    "field": "type",
                    "kind": "type"
                  }
                },
                "stopBy": "neighbor",
                "field": "left",
                "has": {
                  "field": "right",
                  "matches": "str-constant"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B105",
        "message": "Possible hard-coded password. Read it from the environment or a secret store.",
        "suppress": {
          "nosec": {
            "codes": [
              "B105"
            ]
          }
        }
      }
    },
    {
      "id": "dict-value",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "candidate-key",
            "inside": {
              "stopBy": "neighbor",
              "kind": "pair",
              "field": "key",
              "has": {
                "field": "value",
                "matches": "constant"
              },
              "inside": {
                "stopBy": "neighbor",
                "kind": "dictionary"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B105",
        "message": "Possible hard-coded password. Read it from the environment or a secret store.",
        "suppress": {
          "nosec": {
            "codes": [
              "B105"
            ]
          }
        }
      }
    },
    {
      "id": "compared",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "str-constant",
            "inside": {
              "stopBy": "neighbor",
              "kind": "comparison_operator",
              "all": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "nthChild": 1,
                    "matches": "candidate-target"
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "nthChild": 2,
                    "matches": "str-constant"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B105",
        "message": "Compare against a credential read from the environment or a secret store instead of a string literal.",
        "suppress": {
          "nosec": {
            "codes": [
              "B105"
            ]
          }
        }
      }
    }
  ]
}
