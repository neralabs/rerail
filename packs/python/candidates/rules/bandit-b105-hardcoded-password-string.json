{
  "format": "rerail.policy/v1",
  "id": "bandit-b105-hardcoded-password-string",
  "revision": 1,
  "mode": "steer",
  "description": "Don't assign or compare a string literal to a variable, attribute, or key named like a password, token, or secret; read credentials from the environment or a secret store.",
  "scope": {
    "include": [
      "**/*.py",
      "**/*.pyi"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "assigned",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "string",
            "not": {
              "has": {
                "kind": "interpolation"
              }
            },
            "inside": {
              "kind": "assignment",
              "stopBy": "neighbor",
              "has": {
                "field": "left",
                "any": [
                  {
                    "kind": "identifier",
                    "regex": "(?i)(?:^|_)(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:$|_)"
                  },
                  {
                    "kind": "attribute",
                    "has": {
                      "field": "attribute",
                      "regex": "(?i)(?:^|_)(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:$|_)"
                    }
                  },
                  {
                    "kind": "subscript",
                    "has": {
                      "field": "subscript",
                      "kind": "string",
                      "regex": "(?i)^[rbuf]*[\\\"'](?:[^\\\"']*_)?(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:_[^\\\"']*)?[\\\"']$"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B105",
        "message": "Possible hard-coded password. Read it from the environment or a secret store.",
        "suppress": {
          "nosec": {
            "codes": [
              "B105"
            ]
          }
        }
      }
    },
    {
      "id": "compared",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "string",
            "not": {
              "has": {
                "kind": "interpolation"
              }
            },
            "inside": {
              "kind": "comparison_operator",
              "stopBy": "neighbor",
              "has": {
                "any": [
                  {
                    "kind": "identifier",
                    "regex": "(?i)(?:^|_)(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:$|_)"
                  },
                  {
                    "kind": "attribute",
                    "has": {
                      "field": "attribute",
                      "regex": "(?i)(?:^|_)(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:$|_)"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B105",
        "message": "Possible hard-coded password. Read it from the environment or a secret store.",
        "suppress": {
          "nosec": {
            "codes": [
              "B105"
            ]
          }
        }
      }
    }
  ]
}
