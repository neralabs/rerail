  "id": "ruff-d410-no-blank-line-after-section",
  "revision": 1,
  "mode": "steer",
  "description": "Separate each docstring section from the next one with a blank line, so every section header starts a clearly separate block.",
  "scope": {
    "include": [
      "**/*"
