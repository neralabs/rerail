{
  "format": "rerail.policy/v1",
  "id": "bandit-b104-hardcoded-bind-all-interfaces",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid hardcoding 0.0.0.0 in Python; binding to it exposes a service on every network interface, so bind to a specific, configurable address.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B104",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "string",
            "value": {
              "eq": "0.0.0.0"
            }
          }
        }
      },
      "violation": {
        "code": "B104",
        "anchor": "witness.span",
        "message": "Bind to a specific address read from configuration, such as 127.0.0.1, instead of hardcoding 0.0.0.0.",
        "suppress": {
          "nosec": {
            "codes": [
              "B104"
            ]
          }
        }
      }
    }
  ]
}
