{
  "format": "rerail.policy/v1",
  "id": "ruff-ytt301-sys-version0",
  "revision": 1,
  "mode": "steer",
  "description": "Read the major version from sys.version_info instead of indexing the first character of sys.version; the first digit is wrong for a two-digit major version.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "sys-version0",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "zero-literal": {
              "any": [
                {
                  "kind": "integer",
                  "value": {
                    "type": "int",
                    "eq": 0
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "zero-literal"
                  }
                }
              ]
            },
            "zero-subscript": {
              "kind": "subscript",
              "all": [
                {
                  "has": {
                    "field": "subscript",
                    "matches": "zero-literal"
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                }
              ]
            },
            "subscripted": {
              "any": [
                {
                  "nthChild": {
                    "position": 1,
                    "ofRule": {
                      "not": {
                        "any": [
                          {
                            "kind": "comment"
                          },
                          {
                            "kind": "line_continuation"
                          }
                        ]
                      }
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "zero-subscript"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "subscripted"
                  }
                }
              ]
            },
            "target": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "all": [
                {
                  "resolves": {
                    "import": [
                      "sys.version"
                    ]
                  }
                },
                {
                  "matches": "subscripted"
                }
              ]
            },
            "in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "target",
                      "capture": "C"
                    },
                    {
                      "matches": "in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "target",
                "pattern": "$C"
              },
              {
                "matches": "in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "YTT301",
        "message": "Use `sys.version_info.major` instead of `sys.version[0]`; the first character is only the first digit of the major version once it has two digits.",
        "suppress": {
          "noqa": {
            "codes": [
              "YTT301"
            ]
          }
        }
      }
    }
  ]
}
