{
  "format": "rerail.policy/v1",
  "id": "ruff-pt016-pytest-fail-without-message",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's PT016 (pytest-fail-without-message), `fail_call` in flake8_pytest_style/rules/fail.rs: a call whose callee (parentheses transparent) resolves to `pytest.fail` (through any import form or alias, with `resolves`), whose message, read as Ruff's `find_argument_value(\"reason\", 0)` or else `find_argument_value(\"msg\", 0)` (the `reason=` keyword, else the first positional argument before any starred one, else the `msg=` keyword), is missing or is an empty or null string as `is_empty_or_null_string` reads it: `None`, an empty str literal (implicit concatenations joined; not bytes, not a t-string), or an f-string whose literal parts are empty and whose interpolations each hold (parentheses transparent) such an empty or null string, whatever their conversion, format spec or `=`. Reported on the callee.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "fail-ref": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "pytest.fail"
              ]
            }
          },
          "fail-callee": {
            "any": [
              {
                "matches": "fail-ref",
                "pattern": "$F"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "fail-callee"
                }
              }
            ]
          },
          "fail-call": {
            "kind": "call",
            "has": {
              "field": "function",
              "matches": "fail-callee"
            }
          },
          "part-has-text": {
            "has": {
              "stopBy": "neighbor",
              "kind": "string_content",
              "not": {
                "regex": "^(\\\\\\r?\\n)+$"
              }
            }
          },
          "part-empty": {
            "kind": "string",
            "not": {
              "has": {
                "stopBy": "neighbor",
                "kind": "string_start",
                "regex": "[tTbB]"
              }
            },
            "any": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string_start",
                  "regex": "[fF]"
                },
                "not": {
                  "any": [
                    {
                      "matches": "part-has-text"
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "interpolation",
                        "not": {
                          "has": {
                            "field": "expression",
                            "matches": "empty-or-null"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string_start",
                    "regex": "[fF]"
                  }
                },
                "value": {
                  "eq": ""
                }
              }
            ]
          },
          "empty-or-null": {
            "any": [
              {
                "kind": "none"
              },
              {
                "matches": "part-empty"
              },
              {
                "kind": "concatenated_string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "not": {
                      "matches": "part-empty"
                    }
                  }
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "empty-or-null"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "pytest-fail-without-message",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "fail-call",
            "all": [
              {
                "arguments": {
                  "signature": [
                    "reason"
                  ],
                  "mode": "syntactic",
                  "absent": [
                    "reason"
                  ]
                }
              },
              {
                "arguments": {
                  "signature": [
                    "*",
                    "msg"
                  ],
                  "mode": "syntactic",
                  "absent": [
                    "msg"
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.F",
        "code": "PT016",
        "message": "No message passed to `pytest.fail()`",
        "suppress": {
          "noqa": {
            "codes": [
              "PT016"
            ]
          }
        }
      }
    },
    {
      "id": "pytest-fail-empty-reason",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "fail-call",
            "arguments": {
              "signature": [
                "reason"
              ],
              "mode": "syntactic",
              "bind": {
                "R": "reason"
              }
            }
          },
          "constraints": {
            "R": {
              "matches": "empty-or-null"
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.F",
        "code": "PT016",
        "message": "No message passed to `pytest.fail()`",
        "suppress": {
          "noqa": {
            "codes": [
              "PT016"
            ]
          }
        }
      }
    },
    {
      "id": "pytest-fail-empty-msg",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "fail-call",
            "arguments": {
              "signature": [
                "reason"
              ],
              "mode": "syntactic",
              "absent": [
                "reason"
              ]
            },
            "all": [
              {
                "arguments": {
                  "signature": [
                    "*",
                    "msg"
                  ],
                  "mode": "syntactic",
                  "bind": {
                    "M": "msg"
                  }
                }
              }
            ]
          },
          "constraints": {
            "M": {
              "matches": "empty-or-null"
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.F",
        "code": "PT016",
        "message": "No message passed to `pytest.fail()`",
        "suppress": {
          "noqa": {
            "codes": [
              "PT016"
            ]
          }
        }
      }
    }
  ]
}
