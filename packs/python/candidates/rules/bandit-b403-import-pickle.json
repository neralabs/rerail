{
  "format": "rerail.policy/v1",
  "id": "bandit-b403-import-pickle",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid importing pickle, cPickle, dill, or shelve; deserializing untrusted data with them can execute arbitrary code.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B403",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "any": [
                    {
                      "kind": "dotted_name"
                    },
                    {
                      "kind": "aliased_import"
                    }
                  ],
                  "regex": "^(?:pickle|cPickle|dill|shelve)"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "field": "module_name",
                  "regex": "^[.\\s]*(?:pickle|cPickle|dill|shelve)"
                }
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]+$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^(?:pickle|cPickle|dill|shelve)",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B403",
        "anchor": "witness.span",
        "message": "Replace this import with json or another data-only format if the data it loads could be untrusted.",
        "suppress": {
          "nosec": {
            "codes": [
              "B403"
            ]
          }
        }
      }
    }
  ]
}
