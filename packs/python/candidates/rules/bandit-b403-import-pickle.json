{
  "format": "rerail.policy/v1",
  "id": "bandit-b403-import-pickle",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid importing pickle, cPickle, dill, or shelve; deserializing untrusted data with them can execute arbitrary code.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B403",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import pickle"
              },
              {
                "pattern": "import pickle as $ALIAS"
              },
              {
                "pattern": "from pickle import $$$NAMES"
              },
              {
                "pattern": "import cPickle"
              },
              {
                "pattern": "import cPickle as $ALIAS"
              },
              {
                "pattern": "from cPickle import $$$NAMES"
              },
              {
                "pattern": "import dill"
              },
              {
                "pattern": "import dill as $ALIAS"
              },
              {
                "pattern": "from dill import $$$NAMES"
              },
              {
                "pattern": "import shelve"
              },
              {
                "pattern": "import shelve as $ALIAS"
              },
              {
                "pattern": "from shelve import $$$NAMES"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B403",
        "anchor": "witness.span",
        "message": "Replace this import with json or another data-only format if the data it loads could be untrusted.",
        "suppress": {
          "nosec": {
            "codes": [
              "B403"
            ]
          }
        }
      }
    }
  ]
}
