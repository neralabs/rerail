{
  "format": "rerail.policy/v1",
  "id": "ruff-pyi047-unused-private-type-alias",
  "revision": 1,
  "mode": "steer",
  "description": "Use, make public or remove a private type alias that nothing in its file references; an unused private alias is likely a mistake.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "alias-ref": {
            "any": [
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "attribute"
                  }
                ],
                "resolves": {
                  "import": [
                    "typing.TypeAlias",
                    "typing_extensions.TypeAlias",
                    "_typeshed.TypeAlias"
                  ]
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "alias-ref"
                }
              }
            ]
          },
          "alias-site": {
            "any": [
              {
                "kind": "type_alias_statement"
              },
              {
                "kind": "assignment",
                "has": {
                  "stopBy": "neighbor",
                  "field": "type",
                  "kind": "type",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "alias-ref"
                  }
                },
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^=$"
                    }
                  }
                ]
              }
            ]
          },
          "name-target": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "any": [
                  {
                    "kind": "parenthesized_expression"
                  },
                  {
                    "kind": "tuple_pattern",
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "regex": "^,$"
                      }
                    }
                  }
                ],
                "has": {
                  "stopBy": "neighbor",
                  "matches": "name-target"
                }
              }
            ]
          },
          "named-alias-site": {
            "any": [
              {
                "kind": "type_alias_statement"
              },
              {
                "kind": "assignment",
                "matches": "alias-site",
                "has": {
                  "stopBy": "neighbor",
                  "field": "left",
                  "matches": "name-target"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "unused-private-type-alias",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "pattern": "$NAME",
            "regex": "^_",
            "binds": {
              "site": {
                "matches": "alias-site"
              },
              "latest": true,
              "used": false,
              "scope": [
                "module",
                "function"
              ]
            }
          },
          "file": {
            "path": {
              "notRegex": "\\.pyi$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PYI047",
        "message": "Nothing in this file uses the private type alias `$NAME`. Use it, rename it without the underscore if other modules import it, or remove it once nothing does.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI047"
            ]
          }
        }
      }
    },
    {
      "id": "unused-private-type-alias-stub",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "pattern": "$NAME",
            "regex": "^_",
            "binds": {
              "site": {
                "matches": "alias-site"
              },
              "latest": true,
              "used": false
            }
          },
          "file": {
            "path": {
              "regex": "\\.pyi$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PYI047",
        "message": "Nothing in this file uses the private type alias `$NAME`. Use it, rename it without the underscore if other modules import it, or remove it once nothing does.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI047"
            ]
          }
        }
      }
    },
    {
      "id": "unused-comprehension-variable-in-stub-alias",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "pattern": "$NAME",
            "regex": "^_",
            "binds": {
              "scope": "comprehension",
              "latest": true,
              "used": false
            },
            "inside": {
              "stopBy": {
                "any": [
                  {
                    "kind": "block"
                  },
                  {
                    "kind": "module"
                  }
                ]
              },
              "matches": "named-alias-site"
            }
          },
          "file": {
            "path": {
              "regex": "\\.pyi$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PYI047",
        "message": "The comprehension variable `$NAME` in this stub type alias is never read. Replace the comprehension with a plain type expression; stubs only declare types.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI047"
            ]
          }
        }
      }
    }
  ]
}
