{
  "format": "rerail.policy/v1",
  "id": "bandit-b503-ssl-with-bad-defaults",
  "revision": 1,
  "mode": "steer",
  "description": "Don't default a function parameter to an SSLv2, SSLv3, TLS 1.0 or TLS 1.1 protocol constant; callers silently inherit a broken protocol.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B503",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "default_parameter"
                  },
                  {
                    "kind": "typed_default_parameter"
                  }
                ]
              },
              {
                "inside": {
                  "kind": "parameters"
                }
              },
              {
                "has": {
                  "field": "value",
                  "pattern": "$V"
                }
              }
            ]
          },
          "constraints": {
            "V": {
              "resolves": {
                "import": [
                  "ssl.PROTOCOL_SSLv2",
                  "ssl.PROTOCOL_SSLv3",
                  "ssl.PROTOCOL_TLSv1",
                  "ssl.PROTOCOL_TLSv1_1",
                  "pyOpenSSL.SSL.SSLv2_METHOD",
                  "pyOpenSSL.SSL.SSLv23_METHOD",
                  "pyOpenSSL.SSL.SSLv3_METHOD",
                  "pyOpenSSL.SSL.TLSv1_METHOD",
                  "pyOpenSSL.SSL.TLSv1_1_METHOD"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B503",
        "anchor": "witness.span",
        "message": "Change this parameter default to TLS 1.2 or newer (e.g. ssl.PROTOCOL_TLS_CLIENT); callers silently inherit a broken protocol.",
        "suppress": {
          "nosec": {
            "codes": [
              "B503"
            ]
          }
        }
      }
    }
  ]
}
