{
  "format": "rerail.policy/v1",
  "id": "ruff-ruf019-unnecessary-key-check",
  "revision": 1,
  "mode": "steer",
  "description": "Use dict.get() instead of testing a key with in and then indexing the dictionary in the same condition; get() returns None for a missing key.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-key-check",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "safe-binop-operand": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "string"
                    },
                    {
                      "kind": "concatenated_string"
                    },
                    {
                      "kind": "integer"
                    },
                    {
                      "kind": "float"
                    },
                    {
                      "kind": "true"
                    },
                    {
                      "kind": "false"
                    },
                    {
                      "kind": "none"
                    },
                    {
                      "kind": "ellipsis"
                    },
                    {
                      "kind": "list"
                    },
                    {
                      "kind": "tuple"
                    },
                    {
                      "kind": "set"
                    },
                    {
                      "kind": "dictionary"
                    },
                    {
                      "kind": "list_comprehension"
                    },
                    {
                      "kind": "set_comprehension"
                    },
                    {
                      "kind": "dictionary_comprehension"
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "safe-binop-operand"
                  }
                }
              ]
            },
            "effect": {
              "any": [
                {
                  "kind": "call",
                  "not": {
                    "all": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "identifier",
                          "resolves": {
                            "global": [
                              "list",
                              "tuple",
                              "set",
                              "dict",
                              "frozenset"
                            ]
                          }
                        }
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "argument_list",
                          "regex": "^\\(\\s*\\)$"
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "any": [
                        {
                          "matches": "safe-binop-operand"
                        },
                        {
                          "regex": "^(\\+|-|\\*|/|//|%|\\*\\*|<<|>>|&|\\||\\^|@)$"
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "named_expression"
                },
                {
                  "kind": "await"
                },
                {
                  "kind": "yield"
                },
                {
                  "kind": "subscript"
                },
                {
                  "kind": "list_comprehension"
                },
                {
                  "kind": "set_comprehension"
                },
                {
                  "kind": "dictionary_comprehension"
                },
                {
                  "kind": "generator_expression"
                }
              ]
            },
            "bool-callee": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "bool"
                    ],
                    "import": [
                      "builtins.bool"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "bool-callee"
                  }
                }
              ]
            },
            "boolean-test": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "not_operator"
                  }
                },
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^(if|elif|while)$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "if_statement"
                      },
                      {
                        "kind": "elif_clause"
                      },
                      {
                        "kind": "while_statement"
                      },
                      {
                        "kind": "conditional_expression"
                      }
                    ]
                  }
                },
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^assert$"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "if_clause"
                  }
                },
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^\\($"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "argument_list",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "call",
                      "has": {
                        "field": "function",
                        "matches": "bool-callee"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "parenthesized_expression"
                      },
                      {
                        "kind": "boolean_operator"
                      }
                    ],
                    "matches": "boolean-test"
                  }
                }
              ]
            },
            "and-op": {
              "kind": "boolean_operator",
              "has": {
                "stopBy": "neighbor",
                "regex": "^and$"
              }
            },
            "key-in-dict": {
              "any": [
                {
                  "kind": "comparison_operator",
                  "pattern": "$K in $D",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "kind": "comment"
                      }
                    },
                    "max": 3
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "key-in-dict"
                  }
                }
              ]
            },
            "dict-item": {
              "any": [
                {
                  "kind": "subscript",
                  "pattern": "$E[$L]",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "dict-item"
                  }
                }
              ]
            },
            "tuple-key-in-dict-1": {
              "any": [
                {
                  "kind": "comparison_operator",
                  "pattern": "($K1,) in $D",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "kind": "comment"
                      }
                    },
                    "max": 3
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "tuple",
                    "pattern": "$K"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-key-in-dict-1"
                  }
                }
              ]
            },
            "tuple-dict-item-1": {
              "any": [
                {
                  "kind": "subscript",
                  "pattern": "$E[$L1,]"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-dict-item-1"
                  }
                }
              ]
            },
            "tuple-key-in-dict-2": {
              "any": [
                {
                  "kind": "comparison_operator",
                  "pattern": "($K1, $K2) in $D",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "kind": "comment"
                      }
                    },
                    "max": 3
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "tuple",
                    "pattern": "$K"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-key-in-dict-2"
                  }
                }
              ]
            },
            "tuple-dict-item-2": {
              "any": [
                {
                  "kind": "subscript",
                  "pattern": "$E[$L1, $L2]"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-dict-item-2"
                  }
                }
              ]
            },
            "tuple-key-in-dict-3": {
              "any": [
                {
                  "kind": "comparison_operator",
                  "pattern": "($K1, $K2, $K3) in $D",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "kind": "comment"
                      }
                    },
                    "max": 3
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "tuple",
                    "pattern": "$K"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-key-in-dict-3"
                  }
                }
              ]
            },
            "tuple-dict-item-3": {
              "any": [
                {
                  "kind": "subscript",
                  "pattern": "$E[$L1, $L2, $L3]"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-dict-item-3"
                  }
                }
              ]
            },
            "tuple-key-in-dict-4": {
              "any": [
                {
                  "kind": "comparison_operator",
                  "pattern": "($K1, $K2, $K3, $K4) in $D",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "kind": "comment"
                      }
                    },
                    "max": 3
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "tuple",
                    "pattern": "$K"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-key-in-dict-4"
                  }
                }
              ]
            },
            "tuple-dict-item-4": {
              "any": [
                {
                  "kind": "subscript",
                  "pattern": "$E[$L1, $L2, $L3, $L4]"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-dict-item-4"
                  }
                }
              ]
            },
            "unnecessary-key-check": {
              "matches": "and-op",
              "all": [
                {
                  "matches": "boolean-test"
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "and-op"
                    }
                  }
                },
                {
                  "has": {
                    "field": "left",
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "matches": "effect"
                      }
                    }
                  }
                },
                {
                  "any": [
                    {
                      "all": [
                        {
                          "has": {
                            "field": "left",
                            "matches": "key-in-dict"
                          }
                        },
                        {
                          "has": {
                            "field": "right",
                            "matches": "dict-item"
                          }
                        },
                        {
                          "compare": {
                            "left": "K",
                            "op": "eq",
                            "right": "L",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "D",
                            "op": "eq",
                            "right": "E",
                            "text": "structure"
                          }
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "has": {
                            "field": "left",
                            "matches": "tuple-key-in-dict-1"
                          }
                        },
                        {
                          "has": {
                            "field": "right",
                            "matches": "tuple-dict-item-1"
                          }
                        },
                        {
                          "compare": {
                            "left": "K1",
                            "op": "eq",
                            "right": "L1",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "D",
                            "op": "eq",
                            "right": "E",
                            "text": "structure"
                          }
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "has": {
                            "field": "left",
                            "matches": "tuple-key-in-dict-2"
                          }
                        },
                        {
                          "has": {
                            "field": "right",
                            "matches": "tuple-dict-item-2"
                          }
                        },
                        {
                          "compare": {
                            "left": "K1",
                            "op": "eq",
                            "right": "L1",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "K2",
                            "op": "eq",
                            "right": "L2",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "D",
                            "op": "eq",
                            "right": "E",
                            "text": "structure"
                          }
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "has": {
                            "field": "left",
                            "matches": "tuple-key-in-dict-3"
                          }
                        },
                        {
                          "has": {
                            "field": "right",
                            "matches": "tuple-dict-item-3"
                          }
                        },
                        {
                          "compare": {
                            "left": "K1",
                            "op": "eq",
                            "right": "L1",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "K2",
                            "op": "eq",
                            "right": "L2",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "K3",
                            "op": "eq",
                            "right": "L3",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "D",
                            "op": "eq",
                            "right": "E",
                            "text": "structure"
                          }
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "has": {
                            "field": "left",
                            "matches": "tuple-key-in-dict-4"
                          }
                        },
                        {
                          "has": {
                            "field": "right",
                            "matches": "tuple-dict-item-4"
                          }
                        },
                        {
                          "compare": {
                            "left": "K1",
                            "op": "eq",
                            "right": "L1",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "K2",
                            "op": "eq",
                            "right": "L2",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "K3",
                            "op": "eq",
                            "right": "L3",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "K4",
                            "op": "eq",
                            "right": "L4",
                            "text": "structure"
                          }
                        },
                        {
                          "compare": {
                            "left": "D",
                            "op": "eq",
                            "right": "E",
                            "text": "structure"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "check-in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "unnecessary-key-check",
                      "pattern": "$C",
                      "capture": "C"
                    },
                    {
                      "matches": "check-in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "unnecessary-key-check",
                "pattern": "$C"
              },
              {
                "matches": "check-in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "RUF019",
        "each": "C",
        "message": "If `$D` is a dict, use `$D.get($K)` instead of testing `$K in $D` before reading `$D[$K]`; leave it if `$D` is not a mapping.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF019"
            ]
          }
        }
      }
    }
  ]
}
