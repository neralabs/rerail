{
 "format": "rerail.policy/v1",
 "id": "ruff-d407-missing-dashed-underline-after-section",
 "revision": 1,
 "mode": "steer",
 "description": "Underline a NumPy-style section name with a line of dashes directly below it.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "missing-dashed-underline",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "docstring": {
       "kind": "string",
       "not": {
        "has": {
         "stopBy": "neighbor",
         "kind": "string_start",
         "regex": "[bBfFtT]"
        }
       },
       "inside": {
        "stopBy": {
         "not": {
          "kind": "parenthesized_expression"
         }
        },
        "kind": "expression_statement",
        "not": {
         "any": [
          {
           "has": {
            "stopBy": "neighbor",
            "regex": "^,$"
           }
          },
          {
           "follows": {
            "stopBy": "end",
            "not": {
             "kind": "comment"
            }
           }
          }
         ]
        },
        "inside": {
         "stopBy": "neighbor",
         "any": [
          {
           "kind": "module"
          },
          {
           "kind": "block",
           "inside": {
            "stopBy": "neighbor",
            "any": [
             {
              "kind": "function_definition"
             },
             {
              "kind": "class_definition"
             }
            ]
           }
          }
         ]
        }
       }
      }
     },
     "rule": {
      "kind": "string_content",
      "inside": {
       "stopBy": "neighbor",
       "matches": "docstring",
       "not": {
        "value": {
         "regex": "\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:extended summary|other parameters|short summary|other params|attributes|references|parameters|examples|see also|warnings|receives|methods|returns|raises|yields|notes|warns):?[ \\t]*(?:\\n|\\z)"
        }
       }
      },
      "all": [
       {
        "any": [
         {
          "regex": "(?:\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:other parameters|other params|parameters):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:O(?i:ther parameters|ther params)|P(?i:arameters)):?[^\\S\\n]*(?m:$))"
         },
         {
          "all": [
           {
            "not": {
             "regex": "(?:\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:keyword arguments|other arguments|keyword args|other args|arguments|args):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:rguments|rgs)|K(?i:eyword arguments|eyword args)|O(?i:ther arguments|ther args)):?[^\\S\\n]*(?m:$))"
            }
           },
           {
            "any": [
             {
              "regex": "(?:\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|short summary|receives):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:E(?i:xtended summary)|R(?i:eceives)|S(?i:hort summary)):?[^\\S\\n]*(?m:$))"
             },
             {
              "all": [
               {
                "not": {
                 "regex": "(?:\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?m:$)|(?:\\A|\\n)[^\\S\\n]*\\n[^\\S\\n]*(?i:attention|important|caution|example|warning|danger|return|error|yield|hint|note|todo|tip):?[^\\S\\n]*(?m:$)|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttention)|C(?i:aution)|D(?i:anger)|E(?i:xample|rror)|H(?i:int)|I(?i:mportant)|N(?i:ote)|R(?i:eturn)|T(?i:odo|ip)|W(?i:arning)|Y(?i:ield)):?[^\\S\\n]*(?m:$))"
                }
               },
               {
                "any": [
                 {
                  "not": {
                   "regex": "\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):[^\\S\\n]*(?m:$)(?:\\z|\\n[^\\S\\n]*(?m:$)|\\n[^\\S\\n]*(?:[^\\s\\-]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])))"
                  }
                 },
                 {
                  "regex": "(?s)\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*-+[^\\S\\n]*(?m:$).*?\\n[^\\S\\n]*(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):[^\\S\\n]*(?m:$)(?:\\z|\\n[^\\S\\n]*(?m:$)|\\n[^\\S\\n]*(?:[^\\s\\-]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])))"
                 }
                ]
               }
              ]
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "any": [
         {
          "regex": "\\n[^\\S\\n]*(?P<NAME>(?i:extended summary|other parameters|short summary|other params|attributes|references|parameters|examples|see also|warnings|receives|methods|returns|raises|yields|notes|warns)):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*(?:-+=|=+-)[-=]*[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?P<NAME>(?i:extended summary|other parameters|short summary|other params|attributes|references|parameters|examples|see also|warnings|receives|methods|returns|raises|yields|notes|warns)):?[^\\S\\n]*(?m:$)(?:\\z|(?:\\n[^\\S\\n]*)*(?:\\z|\\n[^\\S\\n]*(?:[^\\s\\-=]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])|=+(?:[^\\S\\n]+\\S|[^\\s=]))))"
         },
         {
          "regex": "[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?P<NAME>(?:A(?i:ttributes)|E(?i:xtended summary|xamples)|M(?i:ethods)|N(?i:otes)|O(?i:ther parameters|ther params)|P(?i:arameters)|R(?i:eferences|eceives|eturns|aises)|S(?i:hort summary|ee also)|W(?i:arnings|arns)|Y(?i:ields))):?[^\\S\\n]*(?m:$)(?:\\z|(?:\\n[^\\S\\n]*)*(?:\\z|\\n[^\\S\\n]*(?:[^\\s\\-=]|-+(?:[^\\S\\n]+\\S|[^\\s\\-])|=+(?:[^\\S\\n]+\\S|[^\\s=]))))"
         },
         {
          "regex": "\\n[^\\S\\n]*(?i:extended summary|other parameters|short summary|other params|attributes|references|parameters|examples|see also|warnings|receives|methods|returns|raises|yields|notes|warns):?[^\\S\\n]*(?m:$)\\n[^\\S\\n]*(?P<NAME>=+)[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:extended summary|other parameters|short summary|other params|attributes|references|parameters|examples|see also|warnings|receives|methods|returns|raises|yields|notes|warns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*(?P<NAME>=+)[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttributes)|E(?i:xtended summary|xamples)|M(?i:ethods)|N(?i:otes)|O(?i:ther parameters|ther params)|P(?i:arameters)|R(?i:eferences|eceives|eturns|aises)|S(?i:hort summary|ee also)|W(?i:arnings|arns)|Y(?i:ields)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*(?P<NAME>=+)[^\\S\\n]*(?m:$)"
         }
        ]
       }
      ]
     }
    }
   },
   "violation": {
    "code": "D407",
    "anchor": "capture.NAME",
    "each": "NAME",
    "message": "Add a line of dashes as long as the section name directly below it, replacing any equals signs.",
    "suppress": {
     "noqa": {
      "codes": [
       "D407"
      ]
     }
    }
   }
  }
 ]
}
