{
  "format": "rerail.policy/v1",
  "id": "ruff-pie808-unnecessary-range-start",
  "revision": 1,
  "mode": "steer",
  "description": "Drop the redundant 0 start argument from range(); it counts from 0 by default.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-range-start",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "range-func": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "builtins.range"
                    ],
                    "global": [
                      "range"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "range-func"
                  }
                }
              ]
            },
            "start-slot": {
              "any": [
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^\\($"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "argument_list",
                    "count": {
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "regex": "^[(),]$"
                        }
                      },
                      "min": 2,
                      "max": 2
                    },
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "kind": "keyword_argument"
                          },
                          {
                            "kind": "dictionary_splat"
                          }
                        ]
                      }
                    },
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "call",
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "(?s)."
                          }
                        },
                        "matches": "range-func"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "start-slot"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "integer",
            "value": {
              "type": "int",
              "eq": 0
            },
            "matches": "start-slot"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PIE808",
        "message": "Unnecessary `start` argument in `range`",
        "suppress": {
          "noqa": {
            "codes": [
              "PIE808"
            ]
          }
        }
      }
    }
  ]
}
