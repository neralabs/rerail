{
  "format": "rerail.policy/v1",
  "id": "bandit-b603-subprocess-without-shell-equals-true",
  "revision": 2,
  "mode": "steer",
  "description": "Validate untrusted input passed to subprocess.Popen, call, check_call, check_output and run even without a shell; the program still runs with whatever arguments it gets.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit-b603-shell-absent",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)",
            "arguments": {
              "signature": [
                "*",
                "shell"
              ],
              "absent": [
                "shell"
              ],
              "mode": "syntactic"
            }
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "subprocess.Popen",
                  "subprocess.call",
                  "subprocess.check_call",
                  "subprocess.check_output",
                  "subprocess.run"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B603",
        "anchor": "capture.F",
        "message": "Review input passed to a shell-free subprocess invocation",
        "suppress": {
          "nosec": {
            "codes": [
              "B603"
            ]
          }
        }
      }
    },
    {
      "id": "bandit-b603-shell-false",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)",
            "arguments": {
              "signature": [
                "*",
                "shell"
              ],
              "bind": {
                "SHELL": "shell"
              },
              "mode": "syntactic"
            }
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "subprocess.Popen",
                  "subprocess.call",
                  "subprocess.check_call",
                  "subprocess.check_output",
                  "subprocess.run"
                ]
              }
            },
            "SHELL": {
              "value": {
                "truthy": false
              }
            }
          }
        }
      },
      "violation": {
        "code": "B603",
        "anchor": "capture.F",
        "message": "Review input passed to a shell-free subprocess invocation",
        "suppress": {
          "nosec": {
            "codes": [
              "B603"
            ]
          }
        }
      }
    }
  ]
}
