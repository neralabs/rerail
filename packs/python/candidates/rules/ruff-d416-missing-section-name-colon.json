{
  "format": "rerail.policy/v1",
  "id": "ruff-d416-missing-section-name-colon",
  "revision": 1,
  "mode": "steer",
  "description": "End the section names in Google-style docstrings with a colon so documentation tools recognize the sections.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "doc-stmt": {
            "kind": "expression_statement",
            "not": {
              "any": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^,$"
                  }
                },
                {
                  "follows": {
                    "stopBy": "end",
                    "not": {
                      "kind": "comment"
                    }
                  }
                }
              ]
            },
            "any": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "module"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "block",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "doc-holder": {
            "any": [
              {
                "matches": "doc-stmt"
              },
              {
                "kind": "parenthesized_expression",
                "inside": {
                  "stopBy": "neighbor",
                  "matches": "doc-holder"
                }
              }
            ]
          },
          "docstring": {
            "kind": "string",
            "not": {
              "has": {
                "stopBy": "neighbor",
                "kind": "string_start",
                "regex": "[bBfFtT]"
              }
            },
            "inside": {
              "stopBy": "neighbor",
              "matches": "doc-holder"
            }
          },
          "google-style": {
            "all": [
              {
                "not": {
                  "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:parameters|other params|other parameters):?[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)|\\n[^\\S\\n]*(?i:parameters|other params|other parameters):?[^\\S\\n]*\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)"
                }
              },
              {
                "any": [
                  {
                    "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:args|arguments|keyword args|keyword arguments|other args|other arguments):?[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)|\\n[^\\S\\n]*(?i:args|arguments|keyword args|keyword arguments|other args|other arguments):?[^\\S\\n]*\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)"
                  },
                  {
                    "all": [
                      {
                        "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:args|arguments|attention|caution|danger|error|example|hint|important|keyword args|keyword arguments|note|other args|other arguments|return|tip|todo|warning|yield):?[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)|\\n[^\\S\\n]*(?i:args|arguments|attention|caution|danger|error|example|hint|important|keyword args|keyword arguments|note|other args|other arguments|return|tip|todo|warning|yield):?[^\\S\\n]*\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)"
                      },
                      {
                        "not": {
                          "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:extended summary|receives|short summary):?[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)|\\n[^\\S\\n]*(?i:extended summary|receives|short summary):?[^\\S\\n]*\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)"
                        }
                      }
                    ]
                  },
                  {
                    "all": [
                      {
                        "not": {
                          "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:args|arguments|attention|caution|danger|error|example|hint|important|keyword args|keyword arguments|note|other args|other arguments|return|tip|todo|warning|yield):?[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)|\\n[^\\S\\n]*(?i:args|arguments|attention|caution|danger|error|example|hint|important|keyword args|keyword arguments|note|other args|other arguments|return|tip|todo|warning|yield):?[^\\S\\n]*\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)"
                        }
                      },
                      {
                        "not": {
                          "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:extended summary|receives|short summary):?[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)|\\n[^\\S\\n]*(?i:extended summary|receives|short summary):?[^\\S\\n]*\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)"
                        }
                      },
                      {
                        "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?i:attributes|examples|methods|notes|raises|references|returns|see also|warnings|warns|yields):[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)"
                      },
                      {
                        "not": {
                          "regex": "\\n[^\\S\\n]*(?i:attributes|examples|methods|notes|raises|references|returns|see also|warnings|warns|yields):?[^\\S\\n]*\\n[^\\S\\n]*-+[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "missing-colon",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "docstring",
            "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?<N>A(?i:rgs|rguments|ttention|ttributes)|C(?i:aution)|D(?i:anger)|E(?i:rror|xamples?)|H(?i:int)|I(?i:mportant)|K(?i:eyword arg(?:ument)?s)|M(?i:ethods)|N(?i:otes?)|O(?i:ther arg(?:ument)?s)|R(?i:aises|eferences|eturns?)|S(?i:[eE][eE] (?i:also))|T(?i:ip|odo)|W(?i:arnings?|arns)|Y(?i:ields?))(?:[^\\S\\n]*|:[^\\S\\r\\n]+\\r?)(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)",
            "all": [
              {
                "matches": "google-style"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "D416",
        "anchor": "capture.N",
        "each": "N",
        "message": "Add a colon right after the section name `$N`.",
        "suppress": {
          "noqa": {
            "codes": [
              "D416"
            ]
          }
        }
      }
    },
    {
      "id": "missing-colon-lowercase",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "docstring",
            "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)(?:[^\\S\\n]*|[^\\n]*[,;.\\-\\\\/\\]})][^\\S\\n]*)\\n[^\\S\\n]*(?<N>a(?i:rgs|rguments|ttention|ttributes)|c(?i:aution)|d(?i:anger)|e(?i:rror|xamples?)|h(?i:int)|i(?i:mportant)|k(?i:eyword arg(?:ument)?s)|m(?i:ethods)|n(?i:otes?)|o(?i:ther arg(?:ument)?s)|r(?i:aises|eferences|eturns?)|s(?i:[eE][eE] (?i:also))|t(?i:ip|odo)|w(?i:arnings?|arns)|y(?i:ields?))(?:[^\\S\\n]*|:[^\\S\\r\\n]+\\r?)(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)",
            "all": [
              {
                "matches": "google-style"
              }
            ],
            "not": {
              "value": {
                "regex": "(?m)\\n([ \\t]*)(?i:args|arguments|attention|caution|danger|error|examples?|hint|important|keyword arg(?:ument)?s|notes?|other arg(?:ument)?s|returns?|tip|todo|warnings?|yields?|attributes|methods|raises|references|see also|warns)[ \\t\\r]*:?[ \\t\\r]*$(?s:.)*?\\n(?:[^\\n]*[,;.\\-\\\\/\\]})][ \\t\\r]*\\n[ \\t]*|[ \\t\\r]*\\n\\1[ \\t]+)(?:a(?i:rgs|rguments|ttention|ttributes)|c(?i:aution)|d(?i:anger)|e(?i:rror|xamples?)|h(?i:int)|i(?i:mportant)|k(?i:eyword arg(?:ument)?s)|m(?i:ethods)|n(?i:otes?)|o(?i:ther arg(?:ument)?s)|r(?i:aises|eferences|eturns?)|s(?i:[eE][eE] (?i:also))|t(?i:ip|odo)|w(?i:arnings?|arns)|y(?i:ields?))[ \\t\\r]*:?[ \\t\\r]*$"
              }
            }
          }
        }
      },
      "violation": {
        "code": "D416",
        "anchor": "capture.N",
        "each": "N",
        "message": "Add a colon right after the section name `$N`.",
        "suppress": {
          "noqa": {
            "codes": [
              "D416"
            ]
          }
        }
      }
    },
    {
      "id": "missing-colon-underlined",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "docstring",
            "regex": "(?:\\A[A-Za-z]*(?:\"\"\"|'''|\"|')|\\n)[^\\n]*[^\\s,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?<N>(?i:args|arguments|attention|caution|danger|error|example|hint|important|keyword args|keyword arguments|note|other args|other arguments|return|tip|todo|warning|yield|attributes|examples|methods|notes|raises|references|returns|see also|warnings|warns|yields))(?:[^\\S\\n]*|:[^\\S\\r\\n]+\\r?)\\n[^\\S\\n]*[-=]+[^\\S\\n]*(?:(?m:$)|(?:\"\"\"|'''|\"|')\\z)",
            "all": [
              {
                "matches": "google-style"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "D416",
        "anchor": "capture.N",
        "each": "N",
        "message": "Add a colon right after `$N`; this docstring reads as Google style, where section names take a colon instead of an underline, so drop the underline unless you convert the docstring to NumPy style.",
        "suppress": {
          "noqa": {
            "codes": [
              "D416"
            ]
          }
        }
      }
    }
  ]
}
