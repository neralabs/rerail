{
  "format": "rerail.policy/v1",
  "id": "bandit-b412-import-httpoxy",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid importing the CGI handlers from wsgiref and twisted.web; CGI handlers are exposed to the httpoxy proxy-header attack.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B412",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "any": [
                    {
                      "kind": "dotted_name"
                    },
                    {
                      "kind": "aliased_import"
                    }
                  ],
                  "regex": "^(?:wsgiref\\s*\\.\\s*handlers\\s*\\.\\s*CGIHandler|twisted\\s*\\.\\s*web\\s*\\.\\s*twcgi\\s*\\.\\s*CGIScript|twisted\\s*\\.\\s*web\\s*\\.\\s*twcgi\\s*\\.\\s*CGIDirectory)"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "field": "module_name",
                  "regex": "^[.\\s]*(?:wsgiref\\s*\\.\\s*handlers\\s*\\.\\s*CGIHandler|twisted\\s*\\.\\s*web\\s*\\.\\s*twcgi\\s*\\.\\s*CGIScript|twisted\\s*\\.\\s*web\\s*\\.\\s*twcgi\\s*\\.\\s*CGIDirectory)"
                }
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]*wsgiref\\s*\\.\\s*handlers$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^CGIHandler",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]*twisted\\s*\\.\\s*web\\s*\\.\\s*twcgi$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^(?:CGIScript|CGIDirectory)",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B412",
        "anchor": "witness.span",
        "message": "Serve the app through a WSGI server instead of this CGI handler; CGI handlers are open to the httpoxy proxy-header attack.",
        "suppress": {
          "nosec": {
            "codes": [
              "B412"
            ]
          }
        }
      }
    }
  ]
}
