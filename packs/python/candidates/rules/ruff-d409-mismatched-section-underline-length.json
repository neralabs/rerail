       },
       {
        "any": [
         {
          "regex": "(?:\\n[^\\S\\n]*(?i:notes|warns):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:notes|warns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:N(?i:otes)|W(?i:arns)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,4}|-{6,}))[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "(?:\\n[^\\S\\n]*(?i:raises|yields):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:raises|yields):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:R(?i:aises)|Y(?i:ields)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,5}|-{7,}))[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "(?:\\n[^\\S\\n]*(?i:methods|returns):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:methods|returns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:M(?i:ethods)|R(?i:eturns)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,6}|-{8,}))[^\\S\\n]*(?m:$)"
