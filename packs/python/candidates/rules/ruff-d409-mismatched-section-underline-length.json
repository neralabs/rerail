{
 "format": "rerail.policy/v1",
 "id": "ruff-d409-mismatched-section-underline-length",
 "revision": 1,
 "mode": "steer",
 "description": "Make a section underline exactly as long as the section name above it.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "underline-length-shared",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "docstring": {
       "kind": "string",
       "not": {
        "has": {
         "stopBy": "neighbor",
         "kind": "string_start",
         "regex": "[bBfFtT]"
        }
       },
       "inside": {
        "stopBy": {
         "not": {
          "kind": "parenthesized_expression"
         }
        },
        "kind": "expression_statement",
        "not": {
         "any": [
          {
           "has": {
            "stopBy": "neighbor",
            "regex": "^,$"
           }
          },
          {
           "follows": {
            "stopBy": "end",
            "not": {
             "kind": "comment"
            }
           }
          }
         ]
        },
        "inside": {
         "stopBy": "neighbor",
         "any": [
          {
           "kind": "module"
          },
          {
           "kind": "block",
           "inside": {
            "stopBy": "neighbor",
            "any": [
             {
              "kind": "function_definition"
             },
             {
              "kind": "class_definition"
             }
            ]
           }
          }
         ]
        }
       }
      }
     },
     "rule": {
      "kind": "string_content",
      "inside": {
       "stopBy": "neighbor",
       "matches": "docstring",
       "not": {
        "value": {
         "regex": "\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:attributes|references|examples|see also|warnings|methods|returns|raises|yields|notes|warns):?[ \\t]*(?:\\n|\\z)"
        }
       }
      },
      "all": [
       {
        "any": [
         {
          "regex": "\\n[^\\S\\n]*(?i:notes|warns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*(?P<NAME>(?:-{1,4}|-{6,}))[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "\\n[^\\S\\n]*(?i:raises|yields):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*(?P<NAME>(?:-{1,5}|-{7,}))[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "\\n[^\\S\\n]*(?i:methods|returns):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*(?P<NAME>(?:-{1,6}|-{8,}))[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "\\n[^\\S\\n]*(?i:examples|see also|warnings):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*(?P<NAME>(?:-{1,7}|-{9,}))[^\\S\\n]*(?m:$)"
         },
         {
          "regex": "\\n[^\\S\\n]*(?i:attributes|references):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*(?P<NAME>(?:-{1,9}|-{11,}))[^\\S\\n]*(?m:$)"
         }
        ]
       }
      ]
     }
    }
   },
   "violation": {
    "code": "D409",
    "anchor": "capture.NAME",
    "each": "NAME",
    "message": "Make this underline exactly as many dashes as the section name above it has characters.",
    "suppress": {
     "noqa": {
      "codes": [
       "D409"
      ]
     }
    }
   }
  },
