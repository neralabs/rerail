         },
         {
          "regex": "(?:\\n[^\\S\\n]*(?i:attributes|references):?[^\\S\\n]*(?m:$)|(?m:^)[^\\S\\n]*\\n[^\\S\\n]*(?i:attributes|references):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+|[,;.\\-\\\\/\\]})][^\\S\\n]*\\n[^\\S\\n]*(?:A(?i:ttributes)|R(?i:eferences)):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)+)\\n[^\\S\\n]*(?P<NAME>(?:-{1,9}|-{11,}))[^\\S\\n]*(?m:$)"
         }
        ]
       }
      ]
     }
    }
   },
