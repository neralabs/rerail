         },
         {
          "regex": "\\n[^\\S\\n]*(?i:extended summary|other parameters):?[^\\S\\n]*(?m:$)(?:\\n[^\\S\\n]*)*\\n[^\\S\\n]*(?P<NAME>(?:-{1,15}|-{17,}))[^\\S\\n]*(?m:$)"
         }
        ]
       }
      ]
     }
    }
