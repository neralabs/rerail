{
  "format": "rerail.policy/v1",
  "id": "ruff-sim117-multiple-with-statements",
  "revision": 1,
  "mode": "steer",
  "description": "Merge directly nested with statements into one with holding several context managers, except around asyncio, anyio or trio timeout scopes.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "multiple-with-statements",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "timeout-func": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "asyncio.timeout",
                  "asyncio.timeout_at",
                  "anyio.CancelScope",
                  "anyio.fail_after",
                  "anyio.move_on_after",
                  "trio.fail_after",
                  "trio.fail_at",
                  "trio.move_on_after",
                  "trio.move_on_at"
                ]
              }
            },
            "explicit-items": {
              "kind": "with_statement",
              "has": {
                "stopBy": "neighbor",
                "kind": "with_clause",
                "count": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "with_item"
                  },
                  "max": 1
                },
                "has": {
                  "stopBy": "neighbor",
                  "kind": "with_item",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "call",
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "(?s)."
                        }
                      },
                      "matches": "timeout-func"
                    }
                  }
                }
              }
            },
            "async-with": {
              "kind": "with_statement",
              "has": {
                "stopBy": "neighbor",
                "regex": "^async$"
              }
            },
            "mergeable": {
              "kind": "with_statement",
              "not": {
                "matches": "explicit-items"
              },
              "has": {
                "stopBy": "neighbor",
                "kind": "block",
                "count": {
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "any": [
                        {
                          "kind": "comment"
                        },
                        {
                          "kind": "line_continuation"
                        },
                        {
                          "regex": "^;$"
                        }
                      ]
                    }
                  },
                  "min": 1,
                  "max": 1
                },
                "has": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "not": {
                        "any": [
                          {
                            "kind": "comment"
                          },
                          {
                            "kind": "line_continuation"
                          },
                          {
                            "regex": "^;$"
                          }
                        ]
                      }
                    },
                    {
                      "kind": "with_statement",
                      "not": {
                        "matches": "explicit-items"
                      },
                      "any": [
                        {
                          "matches": "async-with",
                          "inside": {
                            "stopBy": "neighbor",
                            "inside": {
                              "stopBy": "neighbor",
                              "matches": "async-with"
                            }
                          }
                        },
                        {
                          "not": {
                            "matches": "async-with"
                          },
                          "inside": {
                            "stopBy": "neighbor",
                            "inside": {
                              "stopBy": "neighbor",
                              "not": {
                                "matches": "async-with"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "kind": "with_statement",
            "matches": "mergeable",
            "not": {
              "inside": {
                "stopBy": "neighbor",
                "kind": "block",
                "inside": {
                  "stopBy": "neighbor",
                  "matches": "mergeable"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM117",
        "message": "Use a single `with` statement with multiple contexts instead of nested `with` statements",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM117"
            ]
          }
        }
      }
    }
  ]
}
