{
  "format": "rerail.policy/v1",
  "id": "ruff-sim116-if-else-block-instead-of-dict-lookup",
  "revision": 1,
  "mode": "steer",
  "description": "Use a dictionary lookup instead of an if/elif chain that compares one variable to three or more literals and just returns a value for each.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "if-else-block-instead-of-dict-lookup",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "safe-binop-operand": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "string"
                    },
                    {
                      "kind": "concatenated_string"
                    },
                    {
                      "kind": "integer"
                    },
                    {
                      "kind": "float"
                    },
                    {
                      "kind": "true"
                    },
                    {
                      "kind": "false"
                    },
                    {
                      "kind": "none"
                    },
                    {
                      "kind": "ellipsis"
                    },
                    {
                      "kind": "list"
                    },
                    {
                      "kind": "tuple"
                    },
                    {
                      "kind": "set"
                    },
                    {
                      "kind": "dictionary"
                    },
                    {
                      "kind": "list_comprehension"
                    },
                    {
                      "kind": "set_comprehension"
                    },
                    {
                      "kind": "dictionary_comprehension"
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "regex": "^[()]$"
                    },
                    "matches": "safe-binop-operand"
                  }
                }
              ]
            },
            "effect-node": {
              "any": [
                {
                  "kind": "call",
                  "not": {
                    "all": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "argument_list",
                          "regex": "^\\(\\s*\\)$"
                        }
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "identifier",
                          "resolves": {
                            "global": [
                              "list",
                              "tuple",
                              "set",
                              "dict",
                              "frozenset"
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "any": [
                        {
                          "matches": "safe-binop-operand"
                        },
                        {
                          "regex": "^(\\+|-|\\*|/|//|%|\\*\\*|@|<<|>>|&|\\||\\^)$"
                        }
                      ]
                    }
                  }
                },
                {
                  "any": [
                    {
                      "kind": "named_expression"
                    },
                    {
                      "kind": "await"
                    },
                    {
                      "kind": "yield"
                    },
                    {
                      "kind": "subscript"
                    },
                    {
                      "kind": "list_comprehension"
                    },
                    {
                      "kind": "set_comprehension"
                    },
                    {
                      "kind": "dictionary_comprehension"
                    },
                    {
                      "kind": "generator_expression"
                    }
                  ]
                }
              ]
            },
            "contains-effect": {
              "any": [
                {
                  "matches": "effect-node"
                },
                {
                  "has": {
                    "stopBy": "end",
                    "matches": "effect-node"
                  }
                }
              ]
            },
            "literal": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "string",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "string_start",
                          "regex": "[fFtT]"
                        }
                      }
                    },
                    {
                      "kind": "concatenated_string",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "string",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "string_start",
                            "regex": "[fFtT]"
                          }
                        }
                      }
                    },
                    {
                      "any": [
                        {
                          "kind": "integer"
                        },
                        {
                          "kind": "float"
                        },
                        {
                          "kind": "true"
                        },
                        {
                          "kind": "false"
                        },
                        {
                          "kind": "none"
                        },
                        {
                          "kind": "ellipsis"
                        }
                      ]
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "literal"
                  }
                }
              ]
            },
            "eq-test": {
              "any": [
                {
                  "kind": "comparison_operator",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    },
                    "max": 3
                  },
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "identifier",
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^==$"
                        },
                        "pattern": "$N"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "^==$"
                        },
                        "matches": "literal"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "eq-test"
                  }
                }
              ]
            },
            "test-slot": {
              "any": [
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^(if|elif)$"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "test-slot"
                  }
                }
              ]
            },
            "test-literal": {
              "matches": "literal",
              "follows": {
                "stopBy": "neighbor",
                "regex": "^==$"
              },
              "inside": {
                "stopBy": "neighbor",
                "kind": "comparison_operator",
                "matches": "test-slot"
              }
            },
            "pure-return-block": {
              "kind": "block",
              "count": {
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "kind": "line_continuation"
                      },
                      {
                        "regex": "^;$"
                      }
                    ]
                  }
                },
                "min": 1,
                "max": 1
              },
              "has": {
                "stopBy": "neighbor",
                "all": [
                  {
                    "not": {
                      "any": [
                        {
                          "kind": "comment"
                        },
                        {
                          "kind": "line_continuation"
                        },
                        {
                          "regex": "^;$"
                        }
                      ]
                    }
                  },
                  {
                    "kind": "return_statement",
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "contains-effect"
                      }
                    }
                  }
                ]
              }
            }
          },
          "rule": {
            "kind": "if_statement",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^if$"
                  },
                  "matches": "eq-test"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "matches": "pure-return-block"
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "elif_clause",
                    "not": {
                      "all": [
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "follows": {
                              "stopBy": "neighbor",
                              "regex": "^elif$"
                            },
                            "matches": "eq-test"
                          }
                        },
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "matches": "pure-return-block"
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "else_clause",
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "pure-return-block"
                      }
                    }
                  }
                }
              },
              {
                "count": {
                  "has": {
                    "stopBy": "end",
                    "matches": "test-literal",
                    "pattern": "$L",
                    "not": {
                      "inside": {
                        "stopBy": {
                          "kind": "if_statement"
                        },
                        "kind": "elif_clause",
                        "any": [
                          {
                            "follows": {
                              "stopBy": "end",
                              "kind": "elif_clause",
                              "has": {
                                "stopBy": "end",
                                "pattern": "$M",
                                "matches": "test-literal",
                                "compare": {
                                  "left": "M",
                                  "op": "eq",
                                  "right": "L",
                                  "text": "structure-parts"
                                }
                              }
                            }
                          },
                          {
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "if_statement",
                              "has": {
                                "stopBy": "neighbor",
                                "follows": {
                                  "stopBy": "neighbor",
                                  "regex": "^if$"
                                },
                                "has": {
                                  "stopBy": "end",
                                  "pattern": "$M",
                                  "matches": "test-literal",
                                  "compare": {
                                    "left": "M",
                                    "op": "eq",
                                    "right": "L",
                                    "text": "structure-parts"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  "min": 3
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "^if$"
                    },
                    "has": {
                      "stopBy": "end",
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "attribute"
                        }
                      ],
                      "resolves": {
                        "import": [
                          "sys.version_info",
                          "sys.platform"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM116",
        "message": "Replace this `if`/`elif` chain of literal comparisons with a dictionary lookup that maps each literal to its value.",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM116"
            ]
          }
        }
      }
    }
  ]
}
