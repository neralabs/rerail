{
  "format": "rerail.policy/v1",
  "id": "bandit-b609-linux-commands-wildcard-injection",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid wildcards in shell commands that run chown, chmod, tar or rsync; crafted file names can inject extra options.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit-b609-shell-functions",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$CALL_ARGS)",
            "arguments": {
              "signature": [
                "command",
                "arg2",
                "arg3",
                "arg4"
              ],
              "bind": {
                "CMD": "command"
              }
            }
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "os.system",
                  "os.popen",
                  "os.popen2",
                  "os.popen3",
                  "os.popen4",
                  "popen2.popen2",
                  "popen2.popen3",
                  "popen2.popen4",
                  "popen2.Popen3",
                  "popen2.Popen4",
                  "commands.getoutput",
                  "commands.getstatusoutput"
                ]
              }
            },
            "CMD": {
              "all": [
                {
                  "value": {
                    "constant": true
                  }
                },
                {
                  "value": {
                    "regex": "(?s).*(\\*|\\?|\\[).*"
                  }
                },
                {
                  "value": {
                    "regex": "(?s).*(chown|chmod|tar|rsync).*"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "code": "B609",
        "anchor": "capture.F",
        "message": "Shell command combines a wildcard with a sensitive utility",
        "suppress": {
          "nosec": {
            "codes": [
              "B609"
            ]
          }
        }
      }
    },
    {
      "id": "bandit-b609-subprocess",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$CALL_ARGS)",
            "arguments": {
              "signature": [
                "args",
                "bufsize",
                "executable",
                "stdin",
                "stdout",
                "stderr",
                "preexec_fn",
                "close_fds",
                "shell"
              ],
              "bind": {
                "CMD": "args",
                "SHELL": "shell"
              }
            }
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "subprocess.Popen",
                  "subprocess.call"
                ]
              }
            },
            "CMD": {
              "all": [
                {
                  "value": {
                    "constant": true
                  }
                },
                {
                  "value": {
                    "regex": "(?s).*(\\*|\\?|\\[).*"
                  }
                },
                {
                  "value": {
                    "regex": "(?s).*(chown|chmod|tar|rsync).*"
                  }
                }
              ]
            },
            "SHELL": {
              "value": {
                "truthy": true
              }
            }
          }
        }
      },
      "violation": {
        "code": "B609",
        "anchor": "capture.F",
        "message": "Shell command combines a wildcard with a sensitive utility",
        "suppress": {
          "nosec": {
            "codes": [
              "B609"
            ]
          }
        }
      }
    }
  ]
}
