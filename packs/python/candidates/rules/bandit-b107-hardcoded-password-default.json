{
  "format": "rerail.policy/v1",
  "id": "bandit-b107-hardcoded-password-default",
  "revision": 1,
  "mode": "steer",
  "description": "Don't give a parameter named like a password, token, or secret a string literal default; default to None and load the value from a secure source.",
  "scope": {
    "include": ["**/*.py"],
    "exclude": []
  },
  "clauses": [
    {
      "id": "hardcoded-password-default",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "pattern": {
                      "context": "def f($NAME=$VALUE):\n  pass",
                      "selector": "default_parameter"
                    }
                  },
                  {
                    "pattern": {
                      "context": "def f($NAME: $TYPE = $VALUE):\n  pass",
                      "selector": "typed_default_parameter"
                    }
                  }
                ]
              },
              {
                "not": {
                  "any": [
                    {
                      "precedes": {
                        "stopBy": "end",
                        "regex": "^/$"
                      }
                    },
                    {
                      "follows": {
                        "stopBy": "end",
                        "regex": "^\\*"
                      }
                    }
                  ]
                }
              }
            ]
          },
          "constraints": {
            "NAME": {
              "kind": "identifier",
              "regex": "(?i)(?:^|_)(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:_|$)"
            },
            "VALUE": {
              "matches": "plain-string-constant"
            }
          },
          "utils": {
            "plain-string-constant": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "any": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "interpolation"
                        }
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "string_start",
                          "regex": "(?i)^[rubft]*[bft]"
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "any": [
                        { "kind": "interpolation" },
                        {
                          "kind": "string_start",
                          "regex": "(?i)^[rubft]*[bft]"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "code": "B107",
        "anchor": "witness.span",
        "message": "Default this credential parameter to None and load the value from the environment or a secret store.",
        "suppress": {
          "nosec": {
            "codes": [
              "B107"
            ]
          }
        }
      }
    }
  ]
}
