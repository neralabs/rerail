        }
       ],
       "parse": {
        "grammar": "annotation",
        "has": {
         "stopBy": "end",
         "any": [
          {
           "matches": "target"
          },
          {
           "matches": "in-string"
          }
         ]
        }
       }
      }
     }
    }
   },
   "violation": {
    "anchor": "capture.F",
    "code": "PTH118",
    "message": "Use `Path(*parts)` instead of `os.sep.join(parts)`; a `Path` is not a `str`, so wrap it in `str()` where a string is needed.",
    "each": "F",
    "suppress": {
     "noqa": {
