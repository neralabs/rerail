{
 "format": "rerail.policy/v1",
 "id": "ruff-async212-blocking-http-call-httpx-in-async-function",
 "revision": 1,
 "mode": "steer",
 "description": "Use httpx.AsyncClient instead of a synchronous httpx.Client inside async functions; its blocking requests stall the event loop.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "blocking-httpx",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "scope-body": {
       "kind": "block",
       "inside": {
        "stopBy": "neighbor",
        "any": [
         {
          "kind": "function_definition"
         },
         {
          "kind": "class_definition"
         }
        ]
       }
      },
      "lambda-body": {
       "inside": {
        "stopBy": "neighbor",
        "kind": "lambda"
       },
       "follows": {
        "stopBy": "end",
        "regex": "^:$"
       }
      },
      "callee-position": {
       "any": [
        {
         "inside": {
          "stopBy": "neighbor",
          "kind": "call"
         },
         "precedes": {
          "stopBy": "neighbor",
          "any": [
           {
            "kind": "argument_list"
           },
           {
            "kind": "generator_expression"
           }
          ]
         }
        },
        {
         "inside": {
          "stopBy": "neighbor",
          "kind": "parenthesized_expression",
          "matches": "callee-position"
         }
        }
       ]
      },
      "async-context": {
       "inside": {
        "stopBy": {
         "any": [
          {
           "matches": "scope-body"
          },
          {
           "matches": "lambda-body"
          }
         ]
        },
        "kind": "block",
        "inside": {
         "stopBy": "neighbor",
         "kind": "function_definition",
         "has": {
          "stopBy": "neighbor",
          "regex": "^async$"
         }
        }
       }
      },
      "ann-class": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "import": [
         "httpx.Client"
        ]
       }
      },
      "union-name": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "import": [
         "typing.Optional",
         "_typeshed.Optional",
         "typing_extensions.Optional",
         "typing.Union",
         "_typeshed.Union",
         "typing_extensions.Union"
        ]
       }
      },
      "ann": {
       "any": [
        {
         "matches": "ann-class"
        },
        {
         "kind": "type",
         "has": {
          "stopBy": "neighbor",
          "matches": "ann"
         }
        },
        {
         "kind": "binary_operator",
         "has": {
          "stopBy": "neighbor",
          "regex": "^\\|$"
         },
         "all": [
          {
           "has": {
            "stopBy": "neighbor",
            "matches": "ann"
           }
          }
         ]
        },
        {
         "kind": "generic_type",
         "has": {
          "stopBy": "neighbor",
          "matches": "union-name",
          "precedes": {
           "stopBy": "neighbor",
           "kind": "type_parameter"
          }
         },
         "all": [
          {
           "has": {
            "stopBy": "neighbor",
            "kind": "type_parameter",
            "has": {
             "stopBy": "neighbor",
             "matches": "ann"
            }
           }
          }
         ]
        },
        {
         "kind": "subscript",
         "has": {
          "stopBy": "neighbor",
          "matches": "union-name",
          "precedes": {
           "stopBy": "neighbor",
           "regex": "^\\[$"
          }
         },
         "all": [
          {
           "has": {
            "stopBy": "neighbor",
            "follows": {
             "stopBy": "end",
             "regex": "^\\[$"
            },
            "any": [
             {
              "matches": "ann"
             },
             {
              "kind": "tuple",
              "has": {
               "stopBy": "neighbor",
               "matches": "ann"
              }
             }
            ]
           }
          }
         ]
        }
       ]
      },
      "init": {
       "any": [
        {
         "kind": "call",
         "has": {
          "stopBy": "neighbor",
          "any": [
           {
            "kind": "identifier"
           },
           {
            "kind": "attribute"
           }
          ],
          "resolves": {
           "import": [
            "httpx.Client"
           ]
          },
          "precedes": {
           "stopBy": "neighbor",
           "kind": "argument_list"
          }
         }
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "init"
         }
        }
       ]
      },
      "plain-target": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "plain-target"
         }
        }
       ]
      },
      "typed-name": {
       "kind": "identifier",
       "any": [
        {
         "resolves": {
          "binding": {
           "only": true,
           "value": {
            "matches": "init"
           },
           "site": {
            "not": {
             "has": {
              "stopBy": "neighbor",
              "kind": "type"
             }
            }
           }
          }
         }
        },
        {
         "resolves": {
          "binding": {
           "only": true,
           "site": {
            "kind": "as_pattern",
            "inside": {
             "stopBy": "neighbor",
             "kind": "with_item"
            },
            "all": [
             {
              "has": {
               "stopBy": "neighbor",
               "matches": "init",
               "precedes": {
                "stopBy": "end",
                "regex": "^as$"
               }
              }
             },
             {
              "has": {
               "stopBy": "neighbor",
               "kind": "as_pattern_target",
               "has": {
                "stopBy": "neighbor",
                "matches": "plain-target"
               }
              }
             }
            ]
           }
          }
         }
        },
        {
         "resolves": {
          "binding": {
           "only": true,
           "annotation": {
            "matches": "ann"
           },
           "site": {
            "not": {
             "has": {
              "stopBy": "neighbor",
              "any": [
               {
                "kind": "list_splat_pattern"
               },
               {
                "kind": "dictionary_splat_pattern"
               }
              ]
             }
            }
           }
          }
         }
        }
       ]
      },
      "target": {
       "kind": "attribute",
       "pattern": "$OBJ.$METH",
       "has": {
        "stopBy": "neighbor",
        "pattern": "$OBJ",
        "precedes": {
         "stopBy": "end",
         "regex": "^\\.$"
        },
        "kind": "identifier",
        "matches": "typed-name"
       },
       "inside": {
        "stopBy": "end",
        "kind": "module",
        "regex": "\\b(httpx)\\b"
       },
       "all": [
        {
         "has": {
          "stopBy": "neighbor",
          "kind": "identifier",
          "pattern": "$METH",
          "regex": "^(close|delete|get|head|options|patch|post|put|request|send|stream)$",
          "follows": {
           "stopBy": "end",
           "regex": "^\\.$"
          }
         }
        }
       ]
      }
     },
     "rule": {
      "all": [
       {
        "matches": "callee-position"
       },
       {
        "matches": "async-context"
       },
       {
        "matches": "target"
       }
      ]
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC212",
    "message": "Replace the blocking `$OBJ.$METH()` with an awaited call on an `httpx.AsyncClient`.",
    "suppress": {
      "noqa": {
        "codes": [
          "ASYNC212"
        ]
      }
    }
   }
  }
 ]
}
