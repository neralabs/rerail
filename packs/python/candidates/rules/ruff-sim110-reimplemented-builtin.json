{
  "format": "rerail.policy/v1",
  "id": "ruff-sim110-reimplemented-builtin",
  "revision": 1,
  "mode": "steer",
  "description": "Partial port of Ruff's SIM110 (reimplemented-builtin): in a function scope, a `for` loop whose body is one `if` (no `elif`/`else`) returning a boolean literal, followed by a `return` of the opposite literal in the loop's `else` or as the next statement; the loop target and the `if` test contain no `await`/`yield`. Missing: Ruff reports only when the generated `return any(...)`/`all(...)` fits the line length.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "reimplemented-builtin",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "true-lit": {
              "any": [
                {
                  "kind": "true"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "true-lit"
                  }
                }
              ]
            },
            "false-lit": {
              "any": [
                {
                  "kind": "false"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "false-lit"
                  }
                }
              ]
            },
            "return-true": {
              "kind": "return_statement",
              "has": {
                "stopBy": "neighbor",
                "matches": "true-lit"
              }
            },
            "return-false": {
              "kind": "return_statement",
              "has": {
                "stopBy": "neighbor",
                "matches": "false-lit"
              }
            },
            "loop-if": {
              "kind": "if_statement",
              "not": {
                "any": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "elif_clause"
                        },
                        {
                          "kind": "else_clause"
                        }
                      ]
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "^if$"
                      },
                      "any": [
                        {
                          "any": [
                            {
                              "kind": "await"
                            },
                            {
                              "kind": "yield"
                            }
                          ]
                        },
                        {
                          "has": {
                            "stopBy": "end",
                            "any": [
                              {
                                "kind": "await"
                              },
                              {
                                "kind": "yield"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "clean-loop": {
              "kind": "for_statement",
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "any": [
                        {
                          "kind": "function_definition"
                        },
                        {
                          "kind": "class_definition"
                        }
                      ]
                    }
                  ]
                },
                "kind": "function_definition"
              },
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^for$"
                  },
                  "any": [
                    {
                      "any": [
                        {
                          "kind": "await"
                        },
                        {
                          "kind": "yield"
                        }
                      ]
                    },
                    {
                      "has": {
                        "stopBy": "end",
                        "any": [
                          {
                            "kind": "await"
                          },
                          {
                            "kind": "yield"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "matches": "clean-loop",
            "kind": "for_statement",
            "any": [
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "count": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "line_continuation"
                              },
                              {
                                "regex": "^;$"
                              }
                            ]
                          }
                        },
                        "min": 1,
                        "max": 1
                      },
                      "has": {
                        "stopBy": "neighbor",
                        "all": [
                          {
                            "not": {
                              "any": [
                                {
                                  "kind": "comment"
                                },
                                {
                                  "kind": "line_continuation"
                                },
                                {
                                  "regex": "^;$"
                                }
                              ]
                            }
                          },
                          {
                            "matches": "loop-if",
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "block",
                              "count": {
                                "has": {
                                  "stopBy": "neighbor",
                                  "not": {
                                    "any": [
                                      {
                                        "kind": "comment"
                                      },
                                      {
                                        "kind": "line_continuation"
                                      },
                                      {
                                        "regex": "^;$"
                                      }
                                    ]
                                  }
                                },
                                "min": 1,
                                "max": 1
                              },
                              "has": {
                                "stopBy": "neighbor",
                                "all": [
                                  {
                                    "not": {
                                      "any": [
                                        {
                                          "kind": "comment"
                                        },
                                        {
                                          "kind": "line_continuation"
                                        },
                                        {
                                          "regex": "^;$"
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "matches": "return-true"
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  {
                    "any": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "else_clause",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "block",
                            "count": {
                              "has": {
                                "stopBy": "neighbor",
                                "not": {
                                  "any": [
                                    {
                                      "kind": "comment"
                                    },
                                    {
                                      "kind": "line_continuation"
                                    },
                                    {
                                      "regex": "^;$"
                                    }
                                  ]
                                }
                              },
                              "min": 1,
                              "max": 1
                            },
                            "has": {
                              "stopBy": "neighbor",
                              "all": [
                                {
                                  "not": {
                                    "any": [
                                      {
                                        "kind": "comment"
                                      },
                                      {
                                        "kind": "line_continuation"
                                      },
                                      {
                                        "regex": "^;$"
                                      }
                                    ]
                                  }
                                },
                                {
                                  "matches": "return-false"
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "else_clause"
                          }
                        },
                        "precedes": {
                          "stopBy": {
                            "not": {
                              "any": [
                                {
                                  "kind": "comment"
                                },
                                {
                                  "kind": "line_continuation"
                                }
                              ]
                            }
                          },
                          "matches": "return-false"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "count": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "line_continuation"
                              },
                              {
                                "regex": "^;$"
                              }
                            ]
                          }
                        },
                        "min": 1,
                        "max": 1
                      },
                      "has": {
                        "stopBy": "neighbor",
                        "all": [
                          {
                            "not": {
                              "any": [
                                {
                                  "kind": "comment"
                                },
                                {
                                  "kind": "line_continuation"
                                },
                                {
                                  "regex": "^;$"
                                }
                              ]
                            }
                          },
                          {
                            "matches": "loop-if",
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "block",
                              "count": {
                                "has": {
                                  "stopBy": "neighbor",
                                  "not": {
                                    "any": [
                                      {
                                        "kind": "comment"
                                      },
                                      {
                                        "kind": "line_continuation"
                                      },
                                      {
                                        "regex": "^;$"
                                      }
                                    ]
                                  }
                                },
                                "min": 1,
                                "max": 1
                              },
                              "has": {
                                "stopBy": "neighbor",
                                "all": [
                                  {
                                    "not": {
                                      "any": [
                                        {
                                          "kind": "comment"
                                        },
                                        {
                                          "kind": "line_continuation"
                                        },
                                        {
                                          "regex": "^;$"
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "matches": "return-false"
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  {
                    "any": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "else_clause",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "block",
                            "count": {
                              "has": {
                                "stopBy": "neighbor",
                                "not": {
                                  "any": [
                                    {
                                      "kind": "comment"
                                    },
                                    {
                                      "kind": "line_continuation"
                                    },
                                    {
                                      "regex": "^;$"
                                    }
                                  ]
                                }
                              },
                              "min": 1,
                              "max": 1
                            },
                            "has": {
                              "stopBy": "neighbor",
                              "all": [
                                {
                                  "not": {
                                    "any": [
                                      {
                                        "kind": "comment"
                                      },
                                      {
                                        "kind": "line_continuation"
                                      },
                                      {
                                        "regex": "^;$"
                                      }
                                    ]
                                  }
                                },
                                {
                                  "matches": "return-true"
                                }
                              ]
                            }
                          }
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "else_clause"
                          }
                        },
                        "precedes": {
                          "stopBy": {
                            "not": {
                              "any": [
                                {
                                  "kind": "comment"
                                },
                                {
                                  "kind": "line_continuation"
                                }
                              ]
                            }
                          },
                          "matches": "return-true"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM110",
        "message": "Use `return any(...)` or `return all(...)` instead of `for` loop",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM110"
            ]
          }
        }
      }
    }
  ]
}
