{
  "format": "rerail.policy/v1",
  "id": "ruff-npy003-numpy-deprecated-function",
  "revision": 1,
  "mode": "steer",
  "description": "Replace deprecated NumPy functions with their current equivalents.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "numpy-round",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "numpy.round_"
              ]
            },
            "pattern": "$NAME"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NPY003",
        "message": "`$NAME` is deprecated; use `numpy.round` instead, which does the same.",
        "suppress": {
          "noqa": {
            "codes": [
              "NPY003"
            ]
          }
        }
      }
    },
    {
      "id": "numpy-product",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "numpy.product"
              ]
            },
            "pattern": "$NAME"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NPY003",
        "message": "`$NAME` is deprecated; use `numpy.prod` instead, which does the same.",
        "suppress": {
          "noqa": {
            "codes": [
              "NPY003"
            ]
          }
        }
      }
    },
    {
      "id": "numpy-cumproduct",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "numpy.cumproduct"
              ]
            },
            "pattern": "$NAME"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NPY003",
        "message": "`$NAME` is deprecated; use `numpy.cumprod` instead, which does the same.",
        "suppress": {
          "noqa": {
            "codes": [
              "NPY003"
            ]
          }
        }
      }
    },
    {
      "id": "numpy-sometrue",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "numpy.sometrue"
              ]
            },
            "pattern": "$NAME"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NPY003",
        "message": "`$NAME` is deprecated; use `numpy.any` instead, which does the same.",
        "suppress": {
          "noqa": {
            "codes": [
              "NPY003"
            ]
          }
        }
      }
    },
    {
      "id": "numpy-alltrue",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "numpy.alltrue"
              ]
            },
            "pattern": "$NAME"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NPY003",
        "message": "`$NAME` is deprecated; use `numpy.all` instead, which does the same.",
        "suppress": {
          "noqa": {
            "codes": [
              "NPY003"
            ]
          }
        }
      }
    },
    {
      "id": "string-annotation-or-pattern",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "reference": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "numpy.round_",
                  "numpy.product",
                  "numpy.cumproduct",
                  "numpy.sometrue",
                  "numpy.alltrue"
                ]
              }
            },
            "in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "reference",
                      "capture": "NAME"
                    },
                    {
                      "matches": "in-string"
                    }
                  ]
                }
              }
            },
            "pattern-name": {
              "kind": "dotted_name",
              "regex": "^\\w+\\s*\\.\\s*(?:round_|product|cumproduct|sometrue|alltrue)$",
              "inside": {
                "stopBy": "end",
                "kind": "case_pattern"
              },
              "has": {
                "kind": "identifier",
                "resolves": {
                  "import": [
                    "numpy"
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "pattern-name",
                "pattern": "$NAME"
              },
              {
                "matches": "in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.NAME",
        "code": "NPY003",
        "message": "`$NAME` is deprecated; use its current NumPy equivalent (`round`, `prod`, `cumprod`, `any` or `all`) instead.",
        "each": "NAME",
        "suppress": {
          "noqa": {
            "codes": [
              "NPY003"
            ]
          }
        }
      }
    }
  ]
}
