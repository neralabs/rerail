{
  "format": "rerail.policy/v1",
  "id": "bandit-b509-snmp-weak-cryptography",
  "revision": 1,
  "mode": "steer",
  "description": "Flag resolved pysnmp.hlapi.UsmUserData calls with fewer than three supplied positional arguments",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B509",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "$F()"
              },
              {
                "pattern": "$F($A)"
              },
              {
                "pattern": "$F($A, $B)"
              }
            ]
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "pysnmp.hlapi.UsmUserData"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B509",
        "anchor": "capture.F",
        "message": "pysnmp.hlapi.UsmUserData should be called with at least three positional arguments",
        "suppress": {
          "nosec": {
            "codes": [
              "B509"
            ]
          }
        }
      }
    }
  ]
}
