{
  "format": "rerail.policy/v1",
  "id": "ruff-n817-camelcase-imported-as-acronym",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid aliasing a CamelCase import to an acronym of its capital letters; the alias reads like a constant and hides what the name is.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "camelcase-imported-as-acronym",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "aliased_import",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "name",
                  "kind": "dotted_name",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "identifier",
                    "nthChild": {
                      "position": 1,
                      "reverse": true,
                      "ofRule": {
                        "kind": "identifier"
                      }
                    },
                    "pattern": "$NAME",
                    "all": [
                      {
                        "regex": "\\p{Lowercase}"
                      },
                      {
                        "regex": "\\p{Uppercase}"
                      },
                      {
                        "not": {
                          "regex": "_"
                        }
                      },
                      {
                        "not": {
                          "regex": "^(?:setUp|tearDown|setUpClass|tearDownClass|setUpModule|tearDownModule|asyncSetUp|asyncTearDown|setUpTestData|failureException|longMessage|maxDiff)$"
                        }
                      }
                    ]
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "alias",
                  "kind": "identifier",
                  "pattern": "$ASNAME"
                }
              },
              {
                "compare": {
                  "left": "ACRONYM",
                  "op": "eq",
                  "right": "ASNAME"
                }
              }
            ],
            "not": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "import_statement"
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "field": "name",
                    "kind": "dotted_name",
                    "regex": "^xml[\\s\\\\]*\\.[\\s\\\\]*etree[\\s\\\\]*\\.[\\s\\\\]*ElementTree$"
                  },
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "alias",
                        "regex": "^ET$"
                      }
                    }
                  ]
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "import_from_statement",
                    "has": {
                      "stopBy": "neighbor",
                      "field": "module_name",
                      "kind": "dotted_name",
                      "regex": "^xml[\\s\\\\]*\\.[\\s\\\\]*etree$"
                    }
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "field": "name",
                    "kind": "dotted_name",
                    "regex": "^ElementTree$"
                  },
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "alias",
                        "regex": "^ET$"
                      }
                    }
                  ]
                }
              ]
            }
          },
          "transform": {
            "ACRONYM": {
              "replace": {
                "source": "$NAME",
                "replace": "\\P{Uppercase}",
                "by": ""
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "N817",
        "message": "Import `$NAME` under its own name, or a descriptive CamelCase alias, instead of the acronym `$ASNAME`, and update its uses; keep the alias if your project's convention requires it.",
        "suppress": {
          "noqa": {
            "codes": [
              "N817"
            ],
            "parent": "statement"
          }
        }
      }
    }
  ]
}
