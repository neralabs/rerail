{
  "format": "rerail.policy/v1",
  "id": "bandit:b604",
  "revision": 1,
  "mode": "steer",
  "description": "Detect calls outside the configured subprocess set when the shell argument evaluates truthy",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit-b604",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "call",
            "pattern": "$F($$$ARGS)",
            "arguments": {
              "signature": [
                "command",
                "shell"
              ],
              "bind": {
                "SHELL": "shell"
              }
            }
          },
          "constraints": {
            "F": {
              "not": {
                "resolves": {
                  "import": [
                    "subprocess.Popen",
                    "subprocess.call",
                    "subprocess.check_call",
                    "subprocess.check_output",
                    "subprocess.run"
                  ]
                }
              }
            },
            "SHELL": {
              "value": {
                "truthy": true
              }
            }
          }
        }
      },
      "violation": {
        "code": "B604",
        "anchor": "capture.F",
        "message": "Non-subprocess call uses a truthy shell keyword"
      }
    }
  ]
}
