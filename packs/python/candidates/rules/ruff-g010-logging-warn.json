{
  "format": "rerail.policy/v1",
  "id": "ruff-g010-logging-warn",
  "revision": 1,
  "mode": "steer",
  "description": "Call the warning logging method instead of warn; warn is a deprecated alias of warning.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "logging-warn",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "callee": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "function",
                    "kind": "call"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "callee"
                  }
                }
              ]
            },
            "name-chain": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "object",
                    "matches": "name-chain"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "name-chain"
                  }
                }
              ]
            },
            "logger-object": {
              "any": [
                {
                  "kind": "call",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "function",
                    "resolves": {
                      "import": [
                        "logging.getLogger",
                        "logging.Logger"
                      ]
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "logger-object"
                  }
                },
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "logging",
                      "flask.current_app.logger"
                    ]
                  }
                },
                {
                  "any": [
                    {
                      "kind": "identifier",
                      "regex": "^(log|LOG)|(logger|logging|LOGGER|LOGGING)$"
                    },
                    {
                      "kind": "attribute",
                      "all": [
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "field": "attribute",
                            "regex": "^(log|LOG)|(logger|logging|LOGGER|LOGGING)$"
                          }
                        },
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "field": "object",
                            "matches": "name-chain"
                          }
                        }
                      ]
                    }
                  ],
                  "not": {
                    "resolves": {
                      "import": true
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "identifier",
            "any": [
              {
                "regex": "^warn$",
                "inside": {
                  "stopBy": "neighbor",
                  "field": "attribute",
                  "kind": "attribute",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "object",
                        "matches": "logger-object"
                      }
                    },
                    {
                      "matches": "callee"
                    }
                  ]
                }
              },
              {
                "matches": "callee",
                "resolves": {
                  "import": [
                    "logging.warn"
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "G010",
        "message": "Replace the deprecated `warn` logging call with `warning`, which takes the same arguments; leave it if this object is not a standard logger and has no `warning` method.",
        "suppress": {
          "noqa": {
            "codes": [
              "G010"
            ]
          }
        }
      }
    }
  ]
}
