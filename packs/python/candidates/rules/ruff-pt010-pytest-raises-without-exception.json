{
  "format": "rerail.policy/v1",
  "id": "ruff-pt010-pytest-raises-without-exception",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's PT010 (pytest-raises-without-exception): a call whose callee (parentheses transparent) resolves to `pytest.raises` (any import form or alias, through `resolves`), passing no `expected_exception` (neither the keyword nor a first positional argument that is not `*args`), no `match=` keyword and no `check=` keyword, in any context. Arguments are read from the argument list as Ruff's find_argument does, skipping comments and line continuations. Reported on the callee expression.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "raises-without-exception",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "raises": {
              "any": [
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "raises"
                  }
                },
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "pattern": "$F",
                  "resolves": {
                    "import": [
                      "pytest.raises"
                    ]
                  }
                }
              ]
            },
            "positional": {
              "not": {
                "any": [
                  {
                    "kind": "keyword_argument"
                  },
                  {
                    "kind": "dictionary_splat"
                  },
                  {
                    "kind": "comment"
                  },
                  {
                    "kind": "line_continuation"
                  },
                  {
                    "regex": "^[(),]$"
                  }
                ]
              }
            }
          },
          "rule": {
            "kind": "call",
            "has": {
              "field": "function",
              "matches": "raises"
            },
            "all": [
              {
                "has": {
                  "field": "arguments",
                  "kind": "argument_list",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "matches": "positional",
                          "not": {
                            "any": [
                              {
                                "kind": "list_splat"
                              },
                              {
                                "follows": {
                                  "stopBy": "end",
                                  "matches": "positional"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "kind": "keyword_argument",
                          "has": {
                            "field": "name",
                            "regex": "^(?:expected_exception|match|check)$"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.F",
        "code": "PT010",
        "message": "Set the expected exception in `pytest.raises()`",
        "suppress": {
          "noqa": {
            "codes": [
              "PT010"
            ]
          }
        }
      }
    }
  ]
}
