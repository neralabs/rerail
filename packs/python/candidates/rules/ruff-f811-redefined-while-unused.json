{
  "format": "rerail.policy/v1",
  "id": "ruff-f811-redefined-while-unused",
  "revision": 1,
  "mode": "steer",
  "description": "Remove or rename an import or definition that is redefined before it is ever used; the first one is dead and often a mistake.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "redefined-while-unused",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "submodule-import": {
              "kind": "dotted_name",
              "regex": "\\.",
              "inside": {
                "stopBy": "neighbor",
                "kind": "import_statement"
              }
            },
            "module-or-member-import": {
              "not": {
                "any": [
                  {
                    "matches": "submodule-import"
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "future_import_statement"
                    }
                  }
                ]
              }
            },
            "typing-overload": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "typing.overload",
                      "_typeshed.overload",
                      "typing_extensions.overload"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "typing-overload"
                  }
                }
              ]
            },
            "overloaded": {
              "kind": "function_definition",
              "inside": {
                "stopBy": "neighbor",
                "kind": "decorated_definition",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "decorator",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "typing-overload"
                  }
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "dotted_name"
              }
            ],
            "pattern": "$N",
            "all": [
              {
                "any": [
                  {
                    "binds": {
                      "form": [
                        "import"
                      ],
                      "site": {
                        "matches": "module-or-member-import"
                      },
                      "redefines": {
                        "form": "import",
                        "used": false,
                        "sameScope": true,
                        "sameImport": true,
                        "site": {
                          "matches": "submodule-import"
                        }
                      }
                    }
                  },
                  {
                    "binds": {
                      "form": [
                        "import"
                      ],
                      "site": {
                        "matches": "module-or-member-import"
                      },
                      "scope": [
                        "module",
                        "function",
                        "lambda",
                        "comprehension",
                        "typeParameters"
                      ],
                      "redefines": {
                        "form": "import",
                        "used": false,
                        "sameScope": false,
                        "sameImport": true,
                        "exported": false,
                        "site": {
                          "matches": "submodule-import"
                        }
                      }
                    }
                  },
                  {
                    "binds": {
                      "form": [
                        "import"
                      ],
                      "site": {
                        "matches": "module-or-member-import"
                      },
                      "redefines": {
                        "form": "import",
                        "used": false,
                        "sameScope": true,
                        "site": {
                          "matches": "module-or-member-import"
                        }
                      }
                    }
                  },
                  {
                    "binds": {
                      "form": [
                        "import"
                      ],
                      "site": {
                        "matches": "module-or-member-import"
                      },
                      "scope": [
                        "module",
                        "function",
                        "lambda",
                        "comprehension",
                        "typeParameters"
                      ],
                      "redefines": {
                        "form": "import",
                        "used": false,
                        "sameScope": false,
                        "exported": false,
                        "site": {
                          "matches": "module-or-member-import"
                        }
                      }
                    }
                  },
                  {
                    "binds": {
                      "form": [
                        "import"
                      ],
                      "site": {
                        "matches": "module-or-member-import"
                      },
                      "redefines": {
                        "form": "definition",
                        "used": false,
                        "sameScope": true,
                        "site": {
                          "not": {
                            "matches": "overloaded"
                          }
                        }
                      }
                    },
                    "not": {
                      "regex": "^(?:_+|_+[a-zA-Z0-9_]*[a-zA-Z0-9])$"
                    }
                  },
                  {
                    "binds": {
                      "form": [
                        "import"
                      ],
                      "site": {
                        "matches": "module-or-member-import"
                      },
                      "redefines": {
                        "form": [
                          "assignment",
                          "annotated",
                          "augmented",
