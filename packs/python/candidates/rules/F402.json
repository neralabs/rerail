{
  "format": "rerail.policy/v1",
  "id": "ruff:F402",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's F402 (import-shadowed-by-loop-var) on the engine's shadowed-binding pairs (M10a `binds.redefines`): a `for` statement's loop variable (any nesting of its target) whose shadowed binding, in its own scope or the enclosing function or module scope, is an import (used or not), on the same fork (Ruff's same_branch). Reported on the loop variable.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "import-shadowed-by-loop-var",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "pattern": "$NAME",
            "binds": {
              "form": "for",
              "site": {
                "kind": "for_statement"
              },
              "redefines": {
                "form": "import"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F402",
        "message": "Import `$NAME` shadowed by loop variable",
        "suppress": {
          "noqa": {
            "codes": [
              "F402"
            ]
          }
        }
      }
    }
  ]
}
