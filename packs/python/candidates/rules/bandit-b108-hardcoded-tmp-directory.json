{
  "format": "rerail.policy/v1",
  "id": "bandit-b108-hardcoded-tmp-directory",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid hardcoded paths under /tmp, /var/tmp, or /dev/shm in Python; shared temp directories invite symlink and race attacks, so use the tempfile module.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B108",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "string",
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "concatenated_string"
                  }
                }
              },
              {
                "kind": "concatenated_string"
              }
            ],
            "not": {
              "inside": {
                "stopBy": "neighbor",
                "kind": "expression_statement"
              }
            },
            "value": {
              "regex": "^(?:/tmp|/var/tmp|/dev/shm)"
            }
          }
        }
      },
      "violation": {
        "code": "B108",
        "anchor": "witness.span",
        "message": "Probable insecure use of a temporary-file path.",
        "suppress": {
          "nosec": {
            "codes": [
              "B108"
            ]
          }
        }
      }
    }
  ]
}
