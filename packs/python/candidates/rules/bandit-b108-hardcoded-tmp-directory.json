{
  "format": "rerail.policy/v1",
  "id": "bandit-b108-hardcoded-tmp-directory",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid hardcoded paths under /tmp, /var/tmp, or /dev/shm in Python; shared temp directories invite symlink and race attacks, so use the tempfile module.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B108",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "any": [
                  {
                    "kind": "string",
                    "not": {
                      "any": [
                        {
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "concatenated_string"
                          }
                        },
                        {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "string_start",
                            "regex": "(?i)^[rubft]*f"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "kind": "concatenated_string"
                  }
                ],
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "expression_statement"
                  }
                },
                "value": {
                  "regex": "^(?:/tmp|/var/tmp|/dev/shm)"
                }
              },
              {
                "kind": "string_content",
                "regex": "^(?:/tmp|/var/tmp|/dev/shm)",
                "any": [
                  {
                    "follows": {
                      "stopBy": "neighbor",
                      "kind": "interpolation"
                    },
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "f-string"
                    }
                  },
                  {
                    "follows": {
                      "stopBy": "neighbor",
                      "kind": "string_start"
                    },
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "f-string",
                      "any": [
                        {
                          "not": {
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "concatenated_string"
                            }
                          }
                        },
                        {
                          "matches": "run-start-piece"
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "matches": "run-start-piece",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string_start",
                    "regex": "(?i)^[rubft]*f"
                  }
                },
                "value": {
                  "regex": "^(?:/tmp|/var/tmp|/dev/shm)"
                }
              }
            ]
          },
          "utils": {
            "f-string": {
              "kind": "string",
              "has": {
                "stopBy": "neighbor",
                "kind": "string_start",
                "regex": "(?i)^[rubft]*f"
              }
            },
            "run-start-piece": {
              "kind": "string",
              "inside": {
                "stopBy": "neighbor",
                "kind": "concatenated_string",
                "has": {
                  "stopBy": "end",
                  "kind": "interpolation"
                }
              },
              "not": {
                "follows": {
                  "stopBy": "neighbor",
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string_end",
                      "follows": {
                        "stopBy": "neighbor",
                        "kind": "interpolation"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "code": "B108",
        "anchor": "witness.span",
        "message": "Create this temporary path with the tempfile module instead of hardcoding a shared temp directory.",
        "suppress": {
          "nosec": {
            "codes": [
              "B108"
            ]
          }
        }
      }
    }
  ]
}
