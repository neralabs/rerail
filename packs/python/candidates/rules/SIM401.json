{
  "format": "rerail.policy/v1",
  "id": "ruff:SIM401",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's SIM401 (if-else-block-instead-of-dict-get): `if K in D: V = D[K] else: V = DEFAULT` (or the `not in` form with the arms swapped), and the conditional-expression form, where the default has no side effect (`contains_effect`). Operands are compared by source text, where Ruff compares expressions (`ComparableExpr`). The statement form needs `D` to be a name whose binding is a dict (`is_dict` through `resolves.binding` with `only`: Ruff's is_known_to_be_of_type_dict, whose only_binding asks that the binding shadows no earlier one). Partial: Ruff also asks that the suggested `V = D.get(K, DEFAULT)` fits the line length.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "default-no-effect": {
            "not": {
              "any": [
                {
                  "matches": "effect"
                },
                {
                  "has": {
                    "stopBy": "end",
                    "matches": "effect"
                  }
                }
              ]
            }
          },
          "effect": {
            "any": [
              {
                "kind": "call",
                "not": {
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "identifier",
                        "resolves": {
                          "global": [
                            "list",
                            "tuple",
                            "set",
                            "dict",
                            "frozenset"
                          ]
                        }
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "argument_list",
                        "regex": "^\\(\\s*\\)$"
                      }
                    }
                  ]
                }
              },
              {
                "kind": "binary_operator",
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "any": [
                      {
                        "matches": "safe-binop-operand"
                      },
                      {
                        "regex": "^(\\+|-|\\*|/|//|%|\\*\\*|<<|>>|&|\\||\\^|@)$"
                      }
                    ]
                  }
                }
              },
              {
                "kind": "named_expression"
              },
              {
                "kind": "await"
              },
              {
                "kind": "yield"
              },
              {
                "kind": "subscript"
              },
              {
                "kind": "list_comprehension"
              },
              {
                "kind": "set_comprehension"
              },
              {
                "kind": "dictionary_comprehension"
              },
              {
                "kind": "generator_expression"
              }
            ]
          },
          "safe-binop-operand": {
            "any": [
              {
                "any": [
                  {
                    "kind": "string"
                  },
                  {
                    "kind": "concatenated_string"
                  },
                  {
                    "kind": "integer"
                  },
                  {
                    "kind": "float"
                  },
                  {
                    "kind": "true"
                  },
                  {
                    "kind": "false"
                  },
                  {
                    "kind": "none"
                  },
                  {
                    "kind": "ellipsis"
                  },
                  {
                    "kind": "list"
                  },
                  {
                    "kind": "tuple"
                  },
                  {
                    "kind": "set"
                  },
                  {
                    "kind": "dictionary"
                  },
                  {
                    "kind": "list_comprehension"
                  },
                  {
                    "kind": "set_comprehension"
                  },
                  {
                    "kind": "dictionary_comprehension"
                  }
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "safe-binop-operand"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "if-else-block-instead-of-dict-get",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "dict-expr": {
              "any": [
                {
                  "kind": "dictionary"
                },
                {
                  "kind": "dictionary_comprehension"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "dict-expr"
                  }
                },
                {
                  "kind": "named_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "^:=$"
                    },
                    "matches": "dict-expr"
                  }
                },
                {
                  "kind": "conditional_expression",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^if$"
                        },
                        "matches": "dict-expr"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "^else$"
                        },
                        "matches": "dict-expr"
                      }
                    }
                  ]
                },
                {
                  "kind": "boolean_operator",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "regex": "^(and|or)$"
                          },
                          {
                            "kind": "comment"
                          },
                          {
                            "matches": "dict-expr"
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "dict-callee": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "dict"
                    ],
                    "import": [
                      "builtins.dict"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "dict-callee"
                  }
                }
              ]
            },
            "dict-init": {
              "any": [
                {
                  "matches": "dict-expr"
                },
                {
                  "kind": "call",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "dict-callee",
                    "precedes": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "argument_list"
                        },
                        {
                          "kind": "generator_expression"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "dict-ann": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "dict"
                    ],
                    "import": [
                      "builtins.dict"
                    ]
                  }
                },
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "typing.Dict",
                      "_typeshed.Dict",
                      "typing_extensions.Dict"
                    ]
                  }
                },
                {
                  "any": [
                    {
                      "kind": "subscript"
                    },
                    {
                      "kind": "generic_type"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "(?s)."
                      }
                    },
                    "matches": "dict-ann"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "dict-ann"
                  }
                }
              ]
            },
            "plain-target": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "plain-target"
                  }
                }
              ]
            },
            "dict-bound": {
              "kind": "identifier",
              "any": [
                {
                  "resolves": {
                    "binding": {
                      "only": true,
                      "site": {
                        "any": [
                          {
                            "kind": "dictionary_splat_pattern",
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "parameters"
                            }
                          },
                          {
                            "kind": "typed_parameter",
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "parameters"
                            },
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "dictionary_splat_pattern"
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "resolves": {
                    "binding": {
                      "only": true,
                      "value": {
                        "matches": "dict-init"
                      },
                      "site": {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "type"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "resolves": {
                    "binding": {
                      "only": true,
                      "site": {
                        "kind": "as_pattern",
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "with_item"
                        },
                        "all": [
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "matches": "dict-init",
                              "precedes": {
                                "stopBy": "end",
                                "regex": "^as$"
                              }
                            }
                          },
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "as_pattern_target",
                              "has": {
                                "stopBy": "neighbor",
                                "matches": "plain-target"
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "resolves": {
                    "binding": {
                      "only": true,
                      "annotation": {
                        "matches": "dict-ann"
                      },
                      "site": {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "list_splat_pattern"
                              },
                              {
                                "kind": "dictionary_splat_pattern"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "resolves": {
                    "binding": {
                      "only": true,
                      "site": {
                        "kind": "function_definition",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "type",
                          "has": {
                            "stopBy": "neighbor",
                            "matches": "dict-ann"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "single-statement-block": {
              "kind": "block",
              "count": {
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "kind": "comment"
                  }
                },
                "max": 1
              }
            }
          },
          "rule": {
            "kind": "if_statement",
            "any": [
              {
                "pattern": "if $K in $D:\n    $V = $D[$K]\nelse:\n    $V = $DEF"
              },
              {
                "pattern": "if $K not in $D:\n    $V = $DEF\nelse:\n    $V = $D[$K]"
              }
            ],
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "matches": "single-statement-block"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "else_clause",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "single-statement-block"
                  }
                }
              }
            ]
          },
          "constraints": {
            "DEF": {
              "matches": "default-no-effect"
            },
            "D": {
              "matches": "dict-bound"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM401",
        "message": "Use `$D.get($K, ...)` instead of an `if` block"
      }
    },
    {
      "id": "if-exp-instead-of-dict-get",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "conditional_expression",
            "any": [
              {
                "pattern": "$D[$K] if $K in $D else $DEF"
              },
              {
                "pattern": "$DEF if $K not in $D else $D[$K]"
              }
            ]
          },
          "constraints": {
            "DEF": {
              "matches": "default-no-effect"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM401",
        "message": "Use `$D.get($K, ...)` instead of an `if` block"
      }
    }
  ]
}
