{
  "format": "rerail.policy/v1",
  "id": "bandit-b604-any-other-function-with-shell-equals-true",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid passing a truthy shell argument to functions outside subprocess; such wrappers likely run the command through a shell, risking injection.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit-b604",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "call",
            "pattern": "$F($$$ARGS)",
            "arguments": {
              "signature": [
                "*",
                "shell"
              ],
              "bind": {
                "SHELL": "shell"
              },
              "mode": "syntactic"
            }
          },
          "constraints": {
            "F": {
              "not": {
                "resolves": {
                  "import": [
                    "subprocess.Popen",
                    "subprocess.call",
                    "subprocess.check_call",
                    "subprocess.check_output",
                    "subprocess.run"
                  ]
                }
              }
            },
            "SHELL": {
              "not": {
                "any": [
                  {
                    "kind": "false"
                  },
                  {
                    "kind": "none"
                  },
                  {
                    "kind": "integer",
                    "value": {
                      "truthy": false
                    }
                  },
                  {
                    "kind": "float",
                    "value": {
                      "truthy": false
                    }
                  },
                  {
                    "kind": "string",
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "kind": "interpolation"
                      }
                    },
                    "value": {
                      "truthy": false
                    }
                  },
                  {
                    "kind": "list",
                    "regex": "^\\[\\s*\\]$"
                  },
                  {
                    "kind": "dictionary",
                    "regex": "^\\{\\s*\\}$"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B604",
        "anchor": "capture.F",
        "message": "Drop the truthy shell argument and pass the command as an argument list; this wrapper likely runs it through a shell.",
        "suppress": {
          "nosec": {
            "codes": [
              "B604"
            ]
          }
        }
      }
    }
  ]
}
