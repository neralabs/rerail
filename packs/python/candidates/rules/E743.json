{
  "format": "rerail.policy/v1",
  "id": "ruff:E743",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's E743 (ambiguous-function-name): a function named `l`, `I` or `O`, reported on the name. Includes `async def` and methods.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "ambiguous-function-name",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "regex": "^(?<NAME>[lIO])$",
            "inside": {
              "stopBy": "neighbor",
              "kind": "function_definition"
            },
            "follows": {
              "stopBy": "neighbor",
              "regex": "^(?:class|def)$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "E743",
        "message": "Ambiguous function name: `$NAME`"
      }
    }
  ]
}
