{
  "format": "rerail.policy/v1",
  "id": "ruff-d400-missing-trailing-period",
  "revision": 1,
  "mode": "steer",
  "description": "End the summary of every docstring with a period; a summary spanning several lines ends on its last line.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "missing-trailing-period",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "doc-stmt": {
              "kind": "expression_statement",
              "not": {
                "any": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  },
                  {
                    "follows": {
                      "stopBy": "end",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                ]
              },
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "module"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "block",
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "function_definition"
                        },
                        {
                          "kind": "class_definition"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "doc-holder": {
              "any": [
                {
                  "matches": "doc-stmt"
                },
                {
                  "kind": "parenthesized_expression",
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "doc-holder"
                  }
                }
              ]
            },
            "docstring": {
              "kind": "string",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string_start",
                  "regex": "[bBfFtT]"
                }
              },
              "inside": {
                "stopBy": "neighbor",
                "matches": "doc-holder"
              }
            }
          },
          "rule": {
            "matches": "docstring",
            "has": {
              "stopBy": "neighbor",
              "kind": "string_content",
              "not": {
                "any": [
                  {
                    "regex": "\\A\\s*:(?:param|type|raises|return|rtype)"
                  },
                  {
                    "regex": "\\A\\s*:?(?:Arg(?:ument)?s|Attention|Attributes|Caution|Danger|Error|Examples?|Extended Summary|Hint|Important|Keyword Arg(?:ument)?s|Methods|Notes?|Other (?:Arg(?:ument)?s|Param(?:eter)?s)|Parameters|Raises|Receives|References|Returns?|See Also|Short Summary|Tip|Todo|Warnings?|Warns|Yields?)[^\\S\\n\\r]*(?:[\\n\\r]|\\z)"
                  }
                ]
              },
              "pattern": "$DOC"
            },
            "compare": {
              "left": "FLAG",
              "op": "eq",
              "right": "MARK",
              "text": "source"
            }
          },
          "transform": {
            "LF": {
              "replace": {
                "source": "$DOC",
                "replace": "\\r\\n?",
                "by": "\n"
              }
            },
            "FLAG": {
              "replace": {
                "source": "$LF",
                "replace": "\\A(?:[^\\S\\n]*(?:[-~=#]+[^\\S\\n]*)?\\n)*(?:[^\\S\\n]*(?:[^\\s\\-~=#]|[-~=#]+(?:[^\\S\\n]+\\S|[^\\s\\-~=#]))[^\\n]*\\n)*(?:[^\\n]*[^\\s.\\\\\\-~=#]|[^\\n]*[^\\s\\-~=#][^\\n]*[-~=#]|[^\\S\\n]*[-~=#]+(?:[^\\S\\n]+[-~=#]+)+)[^\\S\\n]*(?:\\n[^\\S\\n]*(?:[-~=#]+[^\\S\\n]*)?(?:\\n[\\s\\S]*)?)?\\z",
                "by": "!"
              }
            },
            "MARK": {
              "replace": {
                "source": "$DOC",
                "replace": "^[\\s\\S]*$",
                "by": "!"
              }
            }
          }
        }
      },
      "violation": {
        "code": "D400",
        "anchor": "witness.span",
        "message": "End the docstring's summary (its first paragraph) with a period. Leave it as is only if it ends with `?` or `!` on purpose.",
        "suppress": {
          "noqa": {
            "codes": [
              "D400"
            ]
          }
        }
      }
    }
  ]
}
