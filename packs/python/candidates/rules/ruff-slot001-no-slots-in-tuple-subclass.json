{
  "format": "rerail.policy/v1",
  "id": "ruff-slot001-no-slots-in-tuple-subclass",
  "revision": 1,
  "mode": "steer",
  "description": "Define __slots__ in subclasses of tuple; without it every instance carries its own attribute dict and uses more memory.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "no-slots-in-tuple-subclass",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "path": {
              "notRegex": "\\.pyi$"
            }
          },
          "utils": {
            "slots-target": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^__slots__$"
                },
                {
                  "kind": "tuple_pattern",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "slots-target"
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                }
              ]
            },
            "slots-assignment": {
              "kind": "assignment",
              "any": [
                {
                  "has": {
                    "field": "left",
                    "matches": "slots-target"
                  }
                },
                {
                  "has": {
                    "field": "right",
                    "kind": "assignment",
                    "matches": "slots-assignment"
                  }
                }
              ]
            },
            "slots-statement": {
              "kind": "expression_statement",
              "has": {
                "stopBy": "neighbor",
                "kind": "assignment",
                "matches": "slots-assignment"
              }
            },
            "tuple-name": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "tuple"
                    ],
                    "import": [
                      "builtins.tuple",
                      "typing.Tuple",
                      "typing_extensions.Tuple",
                      "_typeshed.Tuple"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-name"
                  }
                }
              ]
            },
            "tuple-base": {
              "any": [
                {
                  "matches": "tuple-name"
                },
                {
                  "kind": "subscript",
                  "has": {
                    "field": "value",
                    "matches": "tuple-name"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "tuple-base"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "identifier",
            "inside": {
              "stopBy": "neighbor",
              "kind": "class_definition",
              "field": "name",
              "all": [
                {
                  "has": {
                    "field": "superclasses",
                    "kind": "argument_list",
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "tuple-base"
                    }
                  }
                },
                {
                  "not": {
                    "has": {
                      "field": "body",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "slots-statement"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SLOT001",
        "message": "Add `__slots__ = ()` to this `tuple` subclass so instances skip the per-instance `__dict__`; leave it if the class assigns instance attributes, which an empty `__slots__` forbids.",
        "suppress": {
          "noqa": {
            "codes": [
              "SLOT001"
            ]
          }
        }
      }
    }
  ]
}
