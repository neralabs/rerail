{
  "format": "rerail.policy/v1",
  "id": "ruff-e712-true-false-comparison",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's E712 (true-false-comparison) with default settings: `True` or `False` compared with `==` or `!=`, reported on the whole comparison. Operands are checked as for E711; `True == True` (same literal on both sides of `==`) is not reported.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "true-false-comparison",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "constant": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "interpolation"
                    }
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "interpolation"
                    }
                  }
                },
                {
                  "kind": "integer"
                },
                {
                  "kind": "float"
                },
                {
                  "kind": "none"
                },
                {
                  "kind": "true"
                },
                {
                  "kind": "false"
                },
                {
                  "kind": "ellipsis"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "constant"
                  }
                },
                {
                  "kind": "tuple",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "matches": "constant"
                          },
                          {
                            "regex": "^[(),]$"
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "singleton": {
              "any": [
                {
                  "kind": "none"
                },
                {
                  "kind": "true"
                },
                {
                  "kind": "false"
                },
                {
                  "kind": "ellipsis"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "singleton"
                  }
                }
              ]
            },
            "constant-non-singleton": {
              "all": [
                {
                  "matches": "constant"
                },
                {
                  "not": {
                    "matches": "singleton"
                  }
                }
              ]
            },
            "is-true": {
              "any": [
                {
                  "kind": "true"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "is-true"
                  }
                }
              ]
            },
            "is-false": {
              "any": [
                {
                  "kind": "false"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "is-false"
                  }
                }
              ]
            },
            "flagged-bool-operand": {
              "all": [
                {
                  "any": [
                    {
                      "matches": "is-true"
                    },
                    {
                      "matches": "is-false"
                    }
                  ]
                },
                {
                  "any": [
                    {
                      "all": [
                        {
                          "not": {
                            "follows": {
                              "stopBy": "neighbor",
                              "regex": "(?s)."
                            }
                          }
                        },
                        {
                          "precedes": {
                            "stopBy": "neighbor",
                            "regex": "^(==|!=)$",
                            "precedes": {
                              "stopBy": "neighbor",
                              "not": {
                                "matches": "constant-non-singleton"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "^(==|!=)$",
                            "follows": {
                              "stopBy": "neighbor",
                              "not": {
                                "matches": "constant-non-singleton"
                              }
                            }
                          }
                        },
                        {
                          "not": {
                            "any": [
                              {
                                "all": [
                                  {
                                    "matches": "is-true"
                                  },
                                  {
                                    "follows": {
                                      "stopBy": "neighbor",
                                      "regex": "^==$",
                                      "follows": {
                                        "stopBy": "neighbor",
                                        "matches": "is-true"
                                      }
                                    }
                                  }
                                ]
                              },
                              {
                                "all": [
                                  {
                                    "matches": "is-false"
                                  },
                                  {
                                    "follows": {
                                      "stopBy": "neighbor",
                                      "regex": "^==$",
                                      "follows": {
                                        "stopBy": "neighbor",
                                        "matches": "is-false"
                                      }
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "kind": "comparison_operator",
            "has": {
              "stopBy": "neighbor",
              "matches": "flagged-bool-operand",
              "pattern": "$OP"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "E712",
        "message": "Avoid equality comparisons to `True` or `False`",
        "each": "OP",
        "suppress": {
          "noqa": {
            "codes": [
              "E712"
            ]
          }
        }
      }
    }
  ]
}
