{
  "format": "rerail.policy/v1",
  "id": "ruff-npy001-numpy-deprecated-type-alias",
  "revision": 1,
  "mode": "steer",
  "description": "Use the builtin int, float, complex, object or str instead of NumPy's removed aliases for them.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "numpy-unicode-alias",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "alias": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "numpy.unicode"
                    ]
                  }
                },
                {
                  "kind": "dotted_name",
                  "regex": "^\\w+\\s*\\.\\s*(?:unicode)$",
                  "inside": {
                    "stopBy": "end",
                    "kind": "case_pattern"
                  },
                  "has": {
                    "kind": "identifier",
                    "resolves": {
                      "import": [
                        "numpy"
                      ]
                    }
                  }
                }
              ]
            },
            "in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "alias",
                      "capture": "NAME"
                    },
                    {
                      "matches": "in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "alias",
                "pattern": "$NAME"
              },
              {
                "matches": "in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.NAME",
        "code": "NPY001",
        "message": "Replace `$NAME`, NumPy's removed alias `numpy.unicode`, with the builtin `str` and drop its NumPy import.",
        "each": "NAME",
        "suppress": {
          "noqa": {
            "codes": [
              "NPY001"
            ]
          }
        }
      }
    },
    {
      "id": "numpy-builtin-alias",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "alias": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "numpy.int",
                      "numpy.float",
                      "numpy.complex",
                      "numpy.object",
                      "numpy.str"
                    ]
                  }
                },
                {
                  "kind": "dotted_name",
                  "regex": "^\\w+\\s*\\.\\s*(?:int|float|complex|object|str)$",
                  "inside": {
                    "stopBy": "end",
                    "kind": "case_pattern"
                  },
                  "has": {
                    "kind": "identifier",
                    "resolves": {
                      "import": [
                        "numpy"
                      ]
                    }
                  }
                }
              ]
            },
            "in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "alias",
                      "capture": "NAME"
                    },
                    {
                      "matches": "in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "alias",
                "pattern": "$NAME"
              },
              {
                "matches": "in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.NAME",
        "code": "NPY001",
        "message": "Replace `$NAME`, a removed NumPy alias of a builtin, with that builtin (`numpy.int` is `int`; likewise `float`, `complex`, `object`, `str`) and drop its NumPy import.",
        "each": "NAME",
        "suppress": {
          "noqa": {
            "codes": [
              "NPY001"
            ]
          }
        }
      }
    }
  ]
}
