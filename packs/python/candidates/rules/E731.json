{
  "format": "rerail.policy/v1",
  "id": "ruff:E731",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's E731 (lambda-assignment): a plain or annotated assignment statement with a single name target whose value is a `lambda` (parentheses are transparent), reported on the statement. Chained assignments are skipped, as are annotated assignments whose enclosing scope is a class body.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "lambda-assignment",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "lambda-value": {
              "any": [
                {
                  "kind": "lambda"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "lambda-value"
                  }
                }
              ]
            },
            "class-scope": {
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "kind": "class_definition"
              }
            },
            "name-target": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "tuple_pattern",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "name-target"
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "assignment",
            "all": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "expression_statement"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "matches": "name-target",
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "matches": "lambda-value"
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "assignment"
                  }
                }
              },
              {
                "not": {
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "type"
                      }
                    },
                    {
                      "matches": "class-scope"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "E731",
        "message": "Do not assign a `lambda` expression, use a `def`",
        "suppress": {
          "noqa": {
            "codes": [
              "E731"
            ]
          }
        }
      }
    }
  ]
}
