{
  "format": "rerail.policy/v1",
  "id": "ruff-n999-invalid-module-name",
  "revision": 1,
  "mode": "steer",
  "description": "Name Python modules and packages in lowercase snake_case that isn't a keyword; other names can't be imported normally.",
  "scope": {
    "include": [
      "**/*.py",
      "**/*.pyi"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "options",
      "define": {
        "options": {
          "pep8-naming.ignore-names": {
            "type": "array",
            "items": "string",
            "default": [
              "setUp",
              "tearDown",
              "setUpClass",
              "tearDownClass",
              "setUpModule",
              "tearDownModule",
              "asyncSetUp",
              "asyncTearDown",
              "setUpTestData",
              "failureException",
              "longMessage",
              "maxDiff"
            ],
            "description": "Names exempt from the check, each a regex over the whole name (a Ruff glob: `*` is `.*`, `?` is `.`)."
          }
        }
      }
    },
    {
      "id": "invalid-module-name",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "inPackage": true,
            "moduleName": {
              "regex": "^$|^[0-9]|[^a-z0-9_]|^(?:and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)$",
              "notRegex": {
                "$option": "pep8-naming.ignore-names",
                "cases": {
                  "[]": "^__init__$"
                },
                "default": {
                  "$option": "pep8-naming.ignore-names",
                  "join": "|",
                  "template": "^(?:{})$|^__init__$"
                }
              }
            },
            "module": {
              "notRegex": "(?:^|\\.)(?:versions|migrations)\\.[^.]*$"
            }
          },
          "rule": {
            "kind": "module"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "N999",
        "message": "Rename this module to lowercase snake_case that is not a Python keyword.",
        "suppress": {
          "noqa": {
            "codes": [
              "N999"
            ]
          }
        }
      }
    },
    {
      "id": "invalid-module-name-migration",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "inPackage": true,
            "moduleName": {
              "regex": "[^a-z0-9_]|^(?:and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)$",
              "notRegex": {
                "$option": "pep8-naming.ignore-names",
                "cases": {
                  "[]": "^__init__$"
                },
                "default": {
                  "$option": "pep8-naming.ignore-names",
                  "join": "|",
                  "template": "^(?:{})$|^__init__$"
                }
              }
            },
            "module": {
              "regex": "(?:^|\\.)(?:versions|migrations)\\.[^.]*$"
            }
          },
          "rule": {
            "kind": "module"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "N999",
        "message": "Rename this module to lowercase letters, digits and underscores, avoiding Python keywords.",
        "suppress": {
          "noqa": {
            "codes": [
              "N999"
            ]
          }
        }
      }
    },
    {
      "id": "invalid-package-name",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "inPackage": true,
            "moduleName": {
              "regex": "^__init__$"
            },
            "package": {
              "regex": "^$|^[0-9]|[^a-z0-9_]|^(?:and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)$",
              "notRegex": {
                "$option": "pep8-naming.ignore-names",
                "cases": {
                  "[]": "[^\\s\\S]"
                },
                "default": {
                  "$option": "pep8-naming.ignore-names",
                  "join": "|",
                  "template": "^(?:{})$"
                }
              }
            },
            "module": {
              "notRegex": "(?:^|\\.)(?:versions|migrations)\\.[^.]*$"
            }
          },
          "rule": {
            "kind": "module"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "N999",
        "message": "Rename this package's folder to lowercase snake_case that is not a Python keyword.",
        "suppress": {
          "noqa": {
            "codes": [
              "N999"
            ]
          }
        }
      }
    },
    {
      "id": "invalid-package-name-migration",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "inPackage": true,
            "moduleName": {
              "regex": "^__init__$"
            },
            "package": {
              "regex": "[^a-z0-9_]|^(?:and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)$",
              "notRegex": {
                "$option": "pep8-naming.ignore-names",
                "cases": {
                  "[]": "[^\\s\\S]"
                },
                "default": {
                  "$option": "pep8-naming.ignore-names",
                  "join": "|",
                  "template": "^(?:{})$"
                }
              }
            },
            "module": {
              "regex": "(?:^|\\.)(?:versions|migrations)\\.[^.]*$"
            }
          },
          "rule": {
            "kind": "module"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "N999",
        "message": "Rename this package's folder to lowercase letters, digits and underscores, avoiding Python keywords.",
        "suppress": {
          "noqa": {
            "codes": [
              "N999"
            ]
          }
        }
      }
    }
  ]
}
