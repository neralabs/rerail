{
  "format": "rerail.policy/v1",
  "id": "ruff:B018",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's B018 (useless-expression): an expression statement (parentheses transparent; a bare tuple counts) that is not a comparison, a string or f-string literal, or `...`, and has no effect in Ruff's `contains_effect` sense: no call other than an argument-less `set()`/`list()`/`tuple()`/`dict()`/`frozenset()`, no `await`, `yield`, walrus, comprehension, generator or subscript, and no binary operation with an operand that is not a literal or display, anywhere inside (lambda bodies included). An attribute access with an effect is reported as a useless attribute access. The builtin names must resolve to the unshadowed builtins (`resolves`, Ruff's `has_builtin_binding`). Reported on the expression.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "effect-node": {
            "any": [
              {
                "kind": "call",
                "not": {
                  "matches": "empty-initializer"
                }
              },
              {
                "kind": "await"
              },
              {
                "kind": "list_comprehension"
              },
              {
                "kind": "set_comprehension"
              },
              {
                "kind": "dictionary_comprehension"
              },
              {
                "kind": "generator_expression"
              },
              {
                "kind": "subscript"
              },
              {
                "kind": "yield"
              },
              {
                "kind": "named_expression"
              },
              {
                "kind": "binary_operator",
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "any": [
                      {
                        "matches": "literalish"
                      },
                      {
                        "regex": "^(\\+|-|\\*|/|//|%|\\*\\*|@|<<|>>|&|\\||\\^)$"
                      },
                      {
                        "kind": "comment"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "empty-initializer": {
            "kind": "call",
            "has": {
              "stopBy": "neighbor",
              "kind": "identifier",
              "resolves": {
                "global": [
                  "set",
                  "list",
                  "tuple",
                  "dict",
                  "frozenset"
                ]
              },
              "precedes": {
                "stopBy": "neighbor",
                "kind": "argument_list",
                "regex": "^\\(\\s*\\)$"
              }
            }
          },
          "exempt": {
            "any": [
              {
                "kind": "comparison_operator"
              },
              {
                "kind": "string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string_start",
                    "regex": "[tTbB]"
                  }
                }
              },
              {
                "kind": "concatenated_string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string_start",
                      "regex": "[tTbB]"
                    }
                  }
                }
              },
              {
                "kind": "ellipsis"
              },
              {
                "kind": "assignment"
              },
              {
                "kind": "augmented_assignment"
              },
              {
                "kind": "parenthesized_expression"
              }
            ]
          },
          "has-effect": {
            "any": [
              {
                "matches": "effect-node"
              },
              {
                "has": {
                  "stopBy": "end",
                  "matches": "effect-node"
                }
              }
            ]
          },
          "literalish": {
            "any": [
              {
                "kind": "string"
              },
              {
                "kind": "concatenated_string"
              },
              {
                "kind": "integer"
              },
              {
                "kind": "float"
              },
              {
                "kind": "true"
              },
              {
                "kind": "false"
              },
              {
                "kind": "none"
              },
              {
                "kind": "ellipsis"
              },
              {
                "kind": "list"
              },
              {
                "kind": "tuple"
              },
              {
                "kind": "set"
              },
              {
                "kind": "dictionary"
              },
              {
                "kind": "list_comprehension"
              },
              {
                "kind": "set_comprehension"
              },
              {
                "kind": "dictionary_comprehension"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "literalish"
                }
              }
            ]
          },
          "statement-value": {
            "inside": {
              "stopBy": "neighbor",
              "any": [
                {
                  "kind": "expression_statement",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "matches": "statement-value"
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "useless-expression",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "matches": "statement-value"
                  },
                  {
                    "kind": "expression_statement",
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                ]
              },
              {
                "not": {
                  "matches": "exempt"
                }
              },
              {
                "not": {
                  "matches": "has-effect"
                }
              },
              {
                "not": {
                  "any": [
                    {
                      "kind": "comment"
                    },
                    {
                      "regex": "^[()]$"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B018",
        "message": "Found useless expression. Either assign it to a variable or remove it.",
        "suppress": {
          "noqa": {
            "codes": [
              "B018"
            ]
          }
        }
      }
    },
    {
      "id": "useless-attribute-access",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "attribute",
            "all": [
              {
                "any": [
                  {
                    "matches": "statement-value"
                  },
                  {
                    "kind": "expression_statement",
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  }
                ]
              },
              {
                "matches": "has-effect"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B018",
        "message": "Found useless attribute access. Either assign it to a variable or remove it.",
        "suppress": {
          "noqa": {
            "codes": [
              "B018"
            ]
          }
        }
      }
    }
  ]
}