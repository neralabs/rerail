{
  "format": "rerail.policy/v1",
  "id": "ruff-d414-empty-docstring-section",
  "revision": 1,
  "mode": "steer",
  "description": "Add content to every docstring section or remove the empty header, since an empty section usually means the docstring is unfinished.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
