{
  "format": "rerail.policy/v1",
  "id": "ruff-ruf028-invalid-formatter-suppression-comment",
  "revision": 1,
  "mode": "steer",
  "description": "Place formatter off, on and skip comments where the formatter honours them: not inside an expression or after a decorator, skip at the end of a line, off and on on their own line.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "in-non-statement",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "off": {
              "kind": "comment",
              "regex": "^#\\s*(?:fmt:\\s*off|yapf:\\s*disable)\\s*$"
            },
            "on": {
              "kind": "comment",
              "regex": "^#\\s*(?:fmt:\\s*on|yapf:\\s*enable)\\s*$"
            },
            "skip": {
              "kind": "comment",
              "regex": "#\\s*fmt:\\s*skip\\s*(?:#|$)"
            },
            "statement-level": {
              "any": [
                {
                  "kind": "module"
                },
                {
                  "kind": "block"
                },
                {
                  "kind": "decorated_definition"
                },
                {
                  "kind": "decorator"
                },
                {
                  "kind": "function_definition"
                },
                {
                  "kind": "class_definition"
                },
                {
                  "kind": "if_statement"
                },
                {
                  "kind": "elif_clause"
                },
                {
                  "kind": "else_clause"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "try_statement"
                },
                {
                  "kind": "except_clause"
                },
                {
                  "kind": "finally_clause"
                },
                {
                  "kind": "with_statement"
                },
                {
                  "kind": "with_clause"
                },
                {
                  "kind": "match_statement"
                },
                {
                  "kind": "case_clause"
                },
                {
                  "kind": "import_from_statement"
                }
              ]
            },
            "paren-parent": {
              "any": [
                {
                  "kind": "assignment"
                },
                {
                  "kind": "augmented_assignment"
                },
                {
                  "kind": "return_statement"
                },
                {
                  "kind": "assert_statement"
                },
                {
                  "kind": "raise_statement"
                },
                {
                  "kind": "expression_statement"
                },
                {
                  "kind": "if_statement"
                },
                {
                  "kind": "elif_clause"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "for_statement"
                }
              ]
            },
            "trailing-in-paren": {
              "follows": {
                "stopBy": "end",
                "not": {
                  "any": [
                    {
                      "kind": "comment"
                    },
                    {
                      "regex": "^\\($"
                    }
                  ]
                }
              }
            },
            "end-of-line": {
              "layout": {
                "before": {
                  "to": "token",
                  "breaks": {
                    "eq": 0
                  }
                }
              }
            },
            "non-statement": {
              "kind": "comment",
              "any": [
                {
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "matches": "statement-level"
                        },
                        {
                          "kind": "parenthesized_expression"
                        }
                      ]
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression"
                  },
                  "any": [
                    {
                      "all": [
                        {
                          "matches": "trailing-in-paren"
                        },
                        {
                          "matches": "end-of-line"
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "not": {
                            "matches": "trailing-in-paren"
                          }
                        },
                        {
                          "not": {
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "parenthesized_expression",
                              "inside": {
                                "stopBy": "neighbor",
                                "matches": "paren-parent"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "kind": "comment",
            "all": [
              {
                "any": [
                  {
                    "matches": "off"
                  },
                  {
                    "matches": "on"
                  },
                  {
                    "matches": "skip"
                  }
                ]
              },
              {
                "matches": "non-statement"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RUF028",
        "message": "Move this formatter comment out of the brackets or expression to a line between statements; the formatter ignores it where it stands.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF028"
            ]
          }
        }
      }
    },
    {
      "id": "skip-or-on-misplaced",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "on": {
              "kind": "comment",
              "regex": "^#\\s*(?:fmt:\\s*on|yapf:\\s*enable)\\s*$"
            },
            "skip": {
              "kind": "comment",
              "regex": "#\\s*fmt:\\s*skip\\s*(?:#|$)"
            },
            "statement-level": {
              "any": [
                {
                  "kind": "module"
                },
                {
                  "kind": "block"
                },
                {
                  "kind": "decorated_definition"
                },
                {
                  "kind": "decorator"
                },
                {
                  "kind": "function_definition"
                },
                {
                  "kind": "class_definition"
                },
                {
                  "kind": "if_statement"
                },
                {
                  "kind": "elif_clause"
                },
                {
                  "kind": "else_clause"
                },
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "try_statement"
                },
                {
                  "kind": "except_clause"
                },
                {
                  "kind": "finally_clause"
                },
                {
                  "kind": "with_statement"
                },
                {
                  "kind": "with_clause"
                },
                {
                  "kind": "match_statement"
                },
                {
                  "kind": "case_clause"
                },
                {
                  "kind": "import_from_statement"
                }
              ]
            },
            "paren-parent": {
              "any": [
                {
                  "kind": "assignment"
                },
                {
                  "kind": "augmented_assignment"
                },
                {
                  "kind": "return_statement"
                },
                {
                  "kind": "assert_statement"
                },
                {
                  "kind": "raise_statement"
                },
                {
                  "kind": "expression_statement"
                },
                {
                  "kind": "if_statement"
                },
                {
                  "kind": "elif_clause"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "for_statement"
                }
              ]
            },
            "trailing-in-paren": {
              "follows": {
                "stopBy": "end",
                "not": {
                  "any": [
                    {
                      "kind": "comment"
                    },
                    {
                      "regex": "^\\($"
                    }
                  ]
                }
              }
            },
            "end-of-line": {
              "layout": {
                "before": {
                  "to": "token",
                  "breaks": {
                    "eq": 0
                  }
                }
              }
            },
            "non-statement": {
              "kind": "comment",
              "any": [
                {
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "matches": "statement-level"
                        },
                        {
                          "kind": "parenthesized_expression"
                        }
                      ]
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression"
                  },
                  "any": [
                    {
                      "all": [
                        {
                          "matches": "trailing-in-paren"
                        },
                        {
                          "matches": "end-of-line"
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "not": {
                            "matches": "trailing-in-paren"
                          }
                        },
                        {
                          "not": {
                            "inside": {
                              "stopBy": "neighbor",
                              "kind": "parenthesized_expression",
                              "inside": {
                                "stopBy": "neighbor",
                                "matches": "paren-parent"
                              }
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "rule": {
            "kind": "comment",
            "all": [
              {
                "not": {
                  "matches": "non-statement"
                }
              },
              {
                "any": [
                  {
                    "matches": "skip",
                    "not": {
                      "matches": "end-of-line"
                    }
                  },
                  {
                    "matches": "on",
                    "all": [
                      {
                        "matches": "end-of-line"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RUF028",
        "message": "Put a skip comment at the end of the line it applies to and an on comment on a line of its own; the other way round the formatter ignores them.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF028"
            ]
          }
        }
      }
    },
    {
      "id": "off-or-on-after-decorator",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "off": {
              "kind": "comment",
              "regex": "^#\\s*(?:fmt:\\s*off|yapf:\\s*disable)\\s*$"
            },
            "on": {
              "kind": "comment",
              "regex": "^#\\s*(?:fmt:\\s*on|yapf:\\s*enable)\\s*$"
            },
            "end-of-line": {
              "layout": {
                "before": {
                  "to": "token",
                  "breaks": {
                    "eq": 0
                  }
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "off"
              },
              {
                "matches": "on"
              }
            ],
            "all": [
              {
                "not": {
                  "matches": "end-of-line"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "decorated_definition"
                }
              },
              {
                "follows": {
                  "stopBy": "end",
                  "kind": "decorator"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RUF028",
        "message": "Move this comment above the first decorator; after a decorator the formatter ignores it.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF028"
            ]
          }
        }
      }
    },
    {
      "id": "off-above-alternate-body",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "off": {
              "kind": "comment",
              "regex": "^#\\s*(?:fmt:\\s*off|yapf:\\s*disable)\\s*$"
            },
            "end-of-line": {
              "layout": {
                "before": {
                  "to": "token",
                  "breaks": {
                    "eq": 0
                  }
                }
              }
            },
            "next-clause": {
              "any": [
                {
                  "kind": "else_clause",
                  "not": {
                    "follows": {
                      "stopBy": "end",
                      "kind": "elif_clause"
                    }
                  }
                },
                {
                  "kind": "finally_clause"
                },
                {
                  "kind": "elif_clause",
                  "not": {
                    "follows": {
                      "stopBy": "end",
                      "kind": "elif_clause"
                    }
                  }
                },
                {
                  "kind": "except_clause",
                  "not": {
                    "follows": {
                      "stopBy": "end",
                      "kind": "except_clause"
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "matches": "off",
            "all": [
              {
                "not": {
                  "matches": "end-of-line"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "if_statement"
                    },
                    {
                      "kind": "for_statement"
                    },
                    {
                      "kind": "while_statement"
                    },
                    {
                      "kind": "try_statement"
                    }
                  ]
                }
              },
              {
                "precedes": {
                  "stopBy": {
                    "not": {
                      "kind": "comment"
                    }
                  },
                  "matches": "next-clause"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RUF028",
        "message": "Indent this off comment to match the block above, or move it before the whole statement; directly above else, elif, except or finally the formatter ignores it.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF028"
            ]
          }
        }
      }
    }
  ]
}
