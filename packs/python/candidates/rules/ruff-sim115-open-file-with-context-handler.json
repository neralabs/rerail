{
  "format": "rerail.policy/v1",
  "id": "ruff-sim115-open-file-with-context-handler",
  "revision": 1,
  "mode": "steer",
  "description": "Open files and archives in a with statement rather than calling open() or similar functions bare; the with block guarantees they get closed.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "open-file-with-context-handler",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "open-func": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "builtins.open",
                  "bz2.open",
                  "codecs.open",
                  "dbm.open",
                  "gzip.open",
                  "tarfile.open",
                  "shelve.open",
                  "tokenize.open",
                  "wave.open",
                  "dbm.gnu.open",
                  "dbm.ndbm.open",
                  "dbm.dumb.open",
                  "dbm.sqlite3.open",
                  "io.open",
                  "lzma.open",
                  "fileinput.FileInput",
                  "fileinput.input",
                  "io.open_code",
                  "lzma.LZMAFile",
                  "tarfile.TarFile.taropen",
                  "tempfile.TemporaryFile",
                  "tempfile.NamedTemporaryFile",
                  "tempfile.SpooledTemporaryFile"
                ],
                "global": [
                  "open"
                ]
              }
            },
            "path-like": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "pathlib.Path",
                  "zipfile.ZipFile",
                  "lzma.LZMAFile"
                ]
              }
            },
            "tarfile-class": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "tarfile.TarFile"
                ]
              }
            },
            "exit-stack": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "contextlib.ExitStack"
                ]
              }
            },
            "async-exit-stack": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "contextlib.AsyncExitStack"
                ]
              }
            },
            "open-callee": {
              "any": [
                {
                  "matches": "open-func"
                },
                {
                  "kind": "attribute",
                  "regex": "\\.\\s*open$",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "(?s)."
                      }
                    },
                    "kind": "call",
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "(?s)."
                        }
                      },
                      "matches": "path-like"
                    }
                  }
                },
                {
                  "kind": "attribute",
                  "regex": "\\.\\s*(open|taropen|gzopen|bz2open|xzopen)$",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "(?s)."
                      }
                    },
                    "kind": "call",
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "(?s)."
                        }
                      },
                      "matches": "tarfile-class"
                    }
                  }
                }
              ]
            },
            "direct-arg-of": {
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "argument_list"
                  },
                  {
                    "kind": "keyword_argument",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "argument_list"
                    }
                  }
                ]
              }
            },
            "in-with-stack": {
              "inside": {
                "stopBy": "end",
                "kind": "with_statement",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "with_clause",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "with_item",
                    "has": {
                      "stopBy": {
                        "not": {
                          "any": [
                            {
                              "kind": "with_item"
                            },
                            {
                              "kind": "as_pattern"
                            }
                          ]
                        }
                      },
                      "kind": "call",
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "(?s)."
                          }
                        },
                        "matches": "exit-stack"
                      }
                    }
                  }
                }
              }
            },
            "in-with-async-stack": {
              "inside": {
                "stopBy": "end",
                "kind": "with_statement",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "with_clause",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "with_item",
                    "has": {
                      "stopBy": {
                        "not": {
                          "any": [
                            {
                              "kind": "with_item"
                            },
                            {
                              "kind": "as_pattern"
                            }
                          ]
                        }
                      },
                      "kind": "call",
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "(?s)."
                          }
                        },
                        "matches": "async-exit-stack"
                      }
                    }
                  }
                }
              }
            }
          },
          "rule": {
            "kind": "call",
            "has": {
              "stopBy": "neighbor",
              "not": {
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "(?s)."
                }
              },
              "matches": "open-callee",
              "pattern": "$FUNC"
            },
            "not": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "attribute",
                    "regex": "\\.\\s*close$",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "call",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "argument_list",
                        "regex": "^\\(\\s*\\)$"
                      }
                    }
                  },
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "any": [
                        {
                          "any": [
                            {
                              "kind": "expression_statement"
                            },
                            {
                              "kind": "return_statement"
                            },
                            {
                              "kind": "with_statement"
                            },
                            {
                              "kind": "if_statement"
                            },
                            {
                              "kind": "for_statement"
                            },
                            {
                              "kind": "while_statement"
                            },
                            {
                              "kind": "try_statement"
                            },
                            {
                              "kind": "function_definition"
                            },
                            {
                              "kind": "class_definition"
                            },
                            {
                              "kind": "decorated_definition"
                            },
                            {
                              "kind": "assert_statement"
                            },
                            {
                              "kind": "raise_statement"
                            },
                            {
                              "kind": "delete_statement"
                            },
                            {
                              "kind": "pass_statement"
                            },
                            {
                              "kind": "break_statement"
                            },
                            {
                              "kind": "continue_statement"
                            },
                            {
                              "kind": "global_statement"
                            },
                            {
                              "kind": "nonlocal_statement"
                            },
                            {
                              "kind": "import_statement"
                            },
                            {
                              "kind": "import_from_statement"
                            },
                            {
                              "kind": "future_import_statement"
                            },
                            {
                              "kind": "print_statement"
                            },
                            {
                              "kind": "exec_statement"
                            },
                            {
                              "kind": "type_alias_statement"
                            },
                            {
                              "kind": "match_statement"
                            }
                          ]
                        }
                      ]
                    },
                    "any": [
                      {
                        "any": [
                          {
                            "kind": "with_statement"
                          },
                          {
                            "kind": "return_statement"
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "matches": "direct-arg-of",
                  "inside": {
                    "stopBy": {
                      "kind": "call"
                    },
                    "kind": "call",
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "(?s)."
                        }
                      },
                      "kind": "attribute",
                      "regex": "\\.\\s*enter_context$"
                    }
                  },
                  "all": [
                    {
                      "matches": "in-with-stack"
                    }
                  ]
                },
                {
                  "matches": "direct-arg-of",
                  "inside": {
                    "stopBy": {
                      "kind": "call"
                    },
                    "kind": "call",
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "(?s)."
                        }
                      },
                      "kind": "attribute",
                      "regex": "\\.\\s*enter_async_context$"
                    },
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "await"
                    }
                  },
                  "all": [
                    {
                      "matches": "in-with-async-stack"
                    }
                  ]
                },
                {
                  "matches": "direct-arg-of",
                  "inside": {
                    "stopBy": {
                      "kind": "call"
                    },
                    "kind": "call",
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "(?s)."
                        }
                      },
                      "kind": "attribute",
                      "regex": "^(cls\\s*\\.\\s*enterClassContext|self\\s*\\.\\s*(enterContext|enterAsyncContext))$"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": {
                      "any": [
                        {
                          "any": [
                            {
                              "kind": "function_definition"
                            },
                            {
                              "kind": "class_definition"
                            },
                            {
                              "kind": "lambda"
                            },
                            {
                              "kind": "list_comprehension"
                            },
                            {
                              "kind": "set_comprehension"
                            },
                            {
                              "kind": "dictionary_comprehension"
                            },
                            {
                              "kind": "generator_expression"
                            }
                          ]
                        }
                      ]
                    },
                    "kind": "function_definition",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "identifier",
                      "regex": "^__enter__$"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.FUNC",
        "code": "SIM115",
        "message": "Open this file in a `with` statement so it is closed even if an error occurs.",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM115"
            ]
          }
        }
      }
    }
  ]
}
