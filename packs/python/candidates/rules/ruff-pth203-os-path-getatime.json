{
  "format": "rerail.policy/v1",
  "id": "ruff-pth203-os-path-getatime",
  "revision": 1,
  "mode": "steer",
  "description": "Use Path.stat().st_atime instead of os.path.getatime(); path objects read better than string-based os.path calls.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "ref": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              }
            ],
            "resolves": {
              "import": [
                "os.path.getatime"
              ]
            }
          }
        }
      }
    },
    {
      "id": "os-path-getatime",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "callee": {
              "any": [
                {
                  "matches": "ref",
                  "pattern": "$F"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "has": {
              "field": "function",
              "matches": "callee"
            },
            "arguments": {
              "signature": [
                "filename"
              ],
              "bind": {
                "S": "filename"
              },
              "mode": "syntactic"
            },
            "any": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "argument_list",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "regex": "^[(),\\[\\]{}]$"
                          },
                          {
                            "kind": "comment"
                          }
                        ]
                      }
                    },
                    "min": 1,
                    "max": 1
                  }
                }
              },
              {
                "has": {
                  "field": "arguments",
                  "kind": "generator_expression"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.F",
        "code": "PTH203",
        "message": "Use `Path($S).stat().st_atime` instead of `os.path.getatime($S)` (without the `Path(...)` wrapper if `$S` is already a path); leave it where the argument is a bytes path or a file descriptor.",
        "suppress": {
          "noqa": {
            "codes": [
              "PTH203"
            ]
          }
        }
      }
    },
    {
      "id": "os-path-getatime-in-annotation",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "string"
              },
              {
                "kind": "concatenated_string"
              }
            ],
            "parse": {
              "grammar": "annotation",
              "has": {
                "stopBy": "end",
                "kind": "call",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "ref",
                  "capture": "F"
                },
                "any": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "generator_expression"
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "argument_list",
                      "count": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "regex": "^[(),\\[\\]{}]$"
                              },
                              {
                                "kind": "comment"
                              }
                            ]
                          }
                        },
                        "min": 1,
                        "max": 1
                      },
                      "has": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "kind": "keyword_argument",
                            "regex": "^filename\\s*="
                          },
                          {
                            "not": {
                              "any": [
                                {
                                  "kind": "keyword_argument"
                                },
                                {
                                  "kind": "list_splat"
                                },
                                {
                                  "kind": "dictionary_splat"
                                },
                                {
                                  "any": [
                                    {
                                      "regex": "^[(),\\[\\]{}]$"
                                    },
                                    {
                                      "kind": "comment"
                                    }
                                  ]
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.F",
        "each": "F",
        "code": "PTH203",
        "message": "Use `Path(...).stat().st_atime` instead of `os.path.getatime(...)`; leave it where the argument is a bytes path or a file descriptor.",
        "suppress": {
          "noqa": {
            "codes": [
              "PTH203"
            ]
          }
        }
      }
    }
  ]
}
