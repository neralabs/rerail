{
  "format": "rerail.policy/v1",
  "id": "bandit:b106",
  "revision": 1,
  "mode": "steer",
  "description": "Detect a string literal passed to a keyword argument whose name looks like a password, secret, or token. Remove the hardcoded credential and load it from a secure source.",
  "scope": {
    "include": ["**/*.py"],
    "exclude": []
  },
  "clauses": [
    {
      "id": "hardcoded-password-function-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": {
              "context": "f($NAME=$VALUE)",
              "selector": "keyword_argument"
            }
          },
          "constraints": {
            "NAME": {
              "kind": "identifier",
              "regex": "(?i)(?:^|_)(?:pas+wo?r?d|pass(?:phrase)?|pwd|token|secrete?)(?:_|$)"
            },
            "VALUE": {
              "matches": "plain-string-constant"
            }
          },
          "utils": {
            "plain-string-constant": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "any": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "interpolation"
                        }
                      },
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "string_start",
                          "regex": "(?i)^[rubft]*[bft]"
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "any": [
                        { "kind": "interpolation" },
                        {
                          "kind": "string_start",
                          "regex": "(?i)^[rubft]*[bft]"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "code": "B106",
        "anchor": "witness.span",
        "message": "This call passes a hardcoded string to a credential-like keyword argument. Remove the hardcoded credential and load it from a secure source."
      }
    }
  ]
}
