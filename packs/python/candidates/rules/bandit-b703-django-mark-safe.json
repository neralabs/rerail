{
  "format": "rerail.policy/v1",
  "id": "bandit-b703-django-mark-safe",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid Django mark_safe and the SafeString family on dynamic content; marking unescaped values as safe opens the page to XSS.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "django-mark-safe-dynamic-value",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "django.utils.safestring.mark_safe",
                  "django.utils.safestring.SafeText",
                  "django.utils.safestring.SafeUnicode",
                  "django.utils.safestring.SafeString",
                  "django.utils.safestring.SafeBytes"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B703",
        "anchor": "witness.span",
        "message": "Potentially dynamic content is passed to a Django safestring API.",
        "suppress": {
          "nosec": {
            "codes": [
              "B703"
            ]
          }
        }
      }
    }
  ]
}
