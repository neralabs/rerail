{
 "format": "rerail.policy/v1",
 "id": "ruff-async109-async-function-with-timeout",
 "revision": 1,
 "mode": "steer",
 "description": "Avoid timeout parameters on async functions; let callers wrap the call in an asyncio, anyio or trio timeout context instead.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "shared",
   "define": {
    "language": "python",
    "utils": {
     "override": {
      "any": [
       {
        "kind": "identifier"
       },
       {
        "kind": "attribute"
       }
      ],
      "resolves": {
       "import": [
        "typing.override",
        "_typeshed.override",
        "typing_extensions.override"
       ]
      }
     }
    }
   }
  },
  {
   "id": "async-function-with-timeout",
   "forbid": {
    "ast": {
     "language": "python",
     "when": {
      "pythonVersion": {
       "min": "3.11"
      }
     },
     "rule": {
      "any": [
       {
        "kind": "identifier",
        "regex": "^timeout$",
        "inside": {
         "stopBy": "neighbor",
         "kind": "parameters"
        }
       },
       {
        "any": [
         {
          "kind": "default_parameter"
         },
         {
          "kind": "typed_parameter"
         },
         {
          "kind": "typed_default_parameter"
         }
        ],
        "inside": {
         "stopBy": "neighbor",
         "kind": "parameters"
        },
        "has": {
         "stopBy": "neighbor",
         "kind": "identifier",
         "regex": "^timeout$",
         "not": {
          "follows": {
           "stopBy": "end",
           "regex": "^[=:]$"
          }
         }
        }
       }
      ],
      "inside": {
       "stopBy": "neighbor",
       "kind": "parameters",
       "inside": {
        "stopBy": "neighbor",
        "kind": "function_definition",
        "has": {
         "stopBy": "neighbor",
         "regex": "^async$"
        },
        "not": {
         "inside": {
          "stopBy": "neighbor",
          "kind": "decorated_definition",
          "has": {
           "stopBy": "neighbor",
           "kind": "decorator",
           "has": {
            "stopBy": "neighbor",
            "matches": "override"
           }
          }
         }
        }
       }
      }
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC109",
    "message": "Async function definition with a `timeout` parameter",
    "suppress": {
      "noqa": {
        "codes": [
          "ASYNC109"
        ]
      }
    }
   }
  },
  {
   "id": "async-function-with-timeout-trio-anyio",
   "forbid": {
    "ast": {
     "language": "python",
     "when": {
      "pythonVersion": {
       "max": "3.10"
      }
     },
     "rule": {
      "all": [
       {
        "any": [
         {
          "kind": "identifier",
          "regex": "^timeout$",
          "inside": {
           "stopBy": "neighbor",
           "kind": "parameters"
          }
         },
         {
          "any": [
           {
            "kind": "default_parameter"
           },
           {
            "kind": "typed_parameter"
           },
           {
            "kind": "typed_default_parameter"
           }
          ],
          "inside": {
           "stopBy": "neighbor",
           "kind": "parameters"
          },
          "has": {
           "stopBy": "neighbor",
           "kind": "identifier",
           "regex": "^timeout$",
           "not": {
            "follows": {
             "stopBy": "end",
             "regex": "^[=:]$"
            }
           }
          }
         }
        ],
        "inside": {
         "stopBy": "neighbor",
         "kind": "parameters",
         "inside": {
          "stopBy": "neighbor",
          "kind": "function_definition",
          "has": {
           "stopBy": "neighbor",
           "regex": "^async$"
          },
          "not": {
           "inside": {
            "stopBy": "neighbor",
            "kind": "decorated_definition",
            "has": {
             "stopBy": "neighbor",
             "kind": "decorator",
             "has": {
              "stopBy": "neighbor",
              "matches": "override"
             }
            }
           }
          }
         }
        }
       },
       {
        "resolves": {
         "imported": [
          "trio",
          "anyio"
         ],
         "seenBefore": true
        }
       }
      ]
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC109",
    "message": "Async function definition with a `timeout` parameter",
    "suppress": {
      "noqa": {
        "codes": [
          "ASYNC109"
        ]
      }
    }
   }
  }
 ]
}
