{
 "format": "rerail.policy/v1",
 "id": "ruff-async110-async-busy-wait",
 "revision": 1,
 "mode": "steer",
 "description": "Use an Event instead of a while loop that only awaits sleep in trio, anyio or asyncio code; polling with sleep wastes wakeups and adds latency.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "async-busy-wait-trio",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "target": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "import": [
         "trio.sleep",
         "trio.sleep_until"
        ]
       }
      },
      "callee-of-target": {
       "any": [
        {
         "matches": "target"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "callee-of-target"
         }
        }
       ]
      },
      "awaited-sleep": {
       "any": [
        {
         "kind": "call",
         "has": {
          "stopBy": "neighbor",
          "matches": "callee-of-target",
          "precedes": {
           "stopBy": "neighbor",
           "any": [
            {
             "kind": "argument_list"
            },
            {
             "kind": "generator_expression"
            }
           ]
          }
         }
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "awaited-sleep"
         }
        }
       ]
      }
     },
     "rule": {
      "kind": "while_statement",
      "has": {
       "stopBy": "neighbor",
       "kind": "block",
       "count": {
        "has": {
         "stopBy": "neighbor",
         "not": {
          "kind": "comment"
         }
        },
        "min": 1,
        "max": 1
       },
       "all": [
        {
         "has": {
          "stopBy": "neighbor",
          "kind": "expression_statement",
          "has": {
           "stopBy": "neighbor",
           "kind": "await",
           "has": {
            "stopBy": "neighbor",
            "matches": "awaited-sleep"
           }
          }
         }
        }
       ]
      }
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC110",
    "message": "Use `trio.Event` instead of awaiting `trio.sleep` in a `while` loop",
    "suppress": {
      "noqa": {
        "codes": [
          "ASYNC110"
        ]
      }
    }
   }
  },
