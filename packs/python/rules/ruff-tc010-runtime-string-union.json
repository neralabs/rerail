{
  "format": "rerail.policy/v1",
  "id": "ruff-tc010-runtime-string-union",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid quoted members in X | Y union types that Python evaluates at runtime; quote the whole union or remove the quotes, since a string cannot be an operand of the | operator.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "future-seen": {
            "inside": {
              "stopBy": "end",
              "follows": {
                "stopBy": "end",
                "kind": "future_import_statement",
                "has": {
                  "stopBy": "end",
                  "regex": "^annotations$"
                }
              }
            }
          },
          "type-checking-name": {
            "any": [
              {
                "kind": "identifier",
                "regex": "^TYPE_CHECKING$"
              },
              {
                "kind": "identifier",
                "resolves": {
                  "import": [
                    "typing.TYPE_CHECKING",
                    "typing_extensions.TYPE_CHECKING",
                    "_typeshed.TYPE_CHECKING"
                  ]
                }
              },
              {
                "kind": "attribute",
                "has": {
                  "field": "attribute",
                  "regex": "^TYPE_CHECKING$"
                }
              }
            ]
          },
          "type-checking-test": {
            "any": [
              {
                "matches": "type-checking-name"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": {
                    "not": {
                      "kind": "parenthesized_expression"
                    }
                  },
                  "matches": "type-checking-name"
                }
              }
            ]
          },
          "in-type-checking-block": {
            "inside": {
              "stopBy": "end",
              "kind": "block",
              "inside": {
                "stopBy": "neighbor",
                "field": "consequence",
                "kind": "if_statement",
                "has": {
                  "field": "condition",
                  "matches": "type-checking-test"
                }
              }
            }
          },
          "plain-string": {
            "any": [
              {
                "kind": "string",
                "not": {
                  "regex": "^[a-zA-Z]*[fFtT]"
                }
              },
              {
                "kind": "concatenated_string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "regex": "^[a-zA-Z]*[fFtT]"
                  }
                }
              }
            ]
          },
          "annotation-root": {
            "kind": "type",
            "any": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "field": "type",
                  "any": [
                    {
                      "kind": "typed_parameter"
                    },
                    {
                      "kind": "typed_default_parameter"
                    },
                    {
                      "kind": "assignment"
                    }
                  ]
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "field": "return_type",
                  "kind": "function_definition"
                }
              }
            ]
          },
          "local-annotation": {
            "inside": {
              "stopBy": "end",
              "matches": "annotation-root",
              "inside": {
                "stopBy": "neighbor",
                "kind": "assignment",
                "inside": {
                  "stopBy": {
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  },
                  "kind": "function_definition"
                }
              }
            }
          },
          "union-owner": {
            "any": [
              {
                "kind": "subscript",
                "has": {
                  "field": "value",
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "typing.Union",
                      "typing_extensions.Union",
                      "_typeshed.Union"
                    ]
                  }
                }
              },
              {
                "kind": "type_parameter",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "generic_type",
                  "has": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "kind": "attribute"
                      }
                    ],
                    "resolves": {
                      "import": [
                        "typing.Union",
                        "typing_extensions.Union",
                        "_typeshed.Union"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "literal-owner": {
            "any": [
              {
                "kind": "subscript",
                "has": {
                  "field": "value",
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "typing.Literal",
                      "typing_extensions.Literal"
                    ]
                  }
                }
              },
              {
                "kind": "type_parameter",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "generic_type",
                  "has": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "kind": "attribute"
                      }
                    ],
                    "resolves": {
                      "import": [
                        "typing.Literal",
                        "typing_extensions.Literal"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "union-member": {
            "all": [
              {
                "matches": "plain-string"
              },
              {
                "parse": {
                  "grammar": "annotation",
                  "any": [
                    {
                      "kind": "expression_statement"
                    },
                    {
                      "kind": "ERROR"
                    }
                  ]
                }
              },
              {
                "matches": "union-position"
              }
            ]
          },
          "union-position": {
            "inside": {
              "stopBy": {
                "not": {
                  "any": [
                    {
                      "kind": "parenthesized_expression"
                    },
                    {
                      "kind": "type"
                    }
                  ]
                }
              },
              "any": [
                {
                  "kind": "union_type"
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "field": "operator",
                    "regex": "^\\|$"
                  }
                }
              ]
            },
            "not": {
              "any": [
                {
                  "matches": "in-type-checking-block"
                },
                {
                  "inside": {
                    "stopBy": {
                      "not": {
                        "any": [
                          {
                            "kind": "parenthesized_expression"
                          },
                          {
                            "kind": "type"
                          },
                          {
                            "kind": "binary_operator",
                            "has": {
                              "field": "operator",
                              "regex": "^\\|$"
                            }
                          },
                          {
                            "kind": "union_type"
                          }
                        ]
                      }
                    },
                    "any": [
                      {
                        "matches": "union-owner"
                      },
                      {
                        "kind": "tuple",
                        "inside": {
                          "stopBy": {
                            "not": {
                              "any": [
                                {
                                  "kind": "parenthesized_expression"
                                },
                                {
                                  "kind": "type"
                                }
                              ]
                            }
                          },
                          "matches": "union-owner"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          "unparsed-member": {
            "all": [
              {
                "any": [
                  {
                    "kind": "string",
                    "regex": "^[a-zA-Z]*[bB]"
                  },
                  {
                    "kind": "concatenated_string",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "regex": "^[a-zA-Z]*[bB]"
                    }
                  },
                  {
                    "matches": "plain-string",
                    "inside": {
                      "stopBy": {
                        "not": {
                          "any": [
                            {
                              "kind": "parenthesized_expression"
                            },
                            {
                              "kind": "type"
                            },
                            {
                              "kind": "binary_operator",
                              "has": {
                                "field": "operator",
                                "regex": "^\\|$"
                              }
                            },
                            {
                              "kind": "union_type"
                            }
                          ]
                        }
                      },
                      "any": [
                        {
                          "matches": "literal-owner"
                        },
                        {
                          "kind": "tuple",
                          "inside": {
                            "stopBy": {
                              "not": {
                                "any": [
                                  {
                                    "kind": "parenthesized_expression"
                                  },
                                  {
                                    "kind": "type"
                                  }
                                ]
                              }
                            },
                            "matches": "literal-owner"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "matches": "union-position"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": {
                      "matches": "annotation-root"
                    },
                    "any": [
                      {
                        "kind": "argument_list"
                      },
                      {
                        "matches": "annotated-metadata"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "annotated-metadata": {
            "any": [
              {
                "not": {
                  "any": [
                    {
                      "nthChild": 1
                    },
                    {
                      "nthChild": 2
                    }
                  ]
                },
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "subscript",
                  "has": {
                    "field": "value",
                    "any": [
                      {
                        "kind": "identifier"
                      },
                      {
                        "kind": "attribute"
                      }
                    ],
                    "resolves": {
                      "import": [
                        "typing.Annotated",
                        "typing_extensions.Annotated"
                      ]
                    }
                  }
                }
              },
              {
                "not": {
                  "nthChild": 1
                },
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "tuple",
                  "inside": {
                    "stopBy": {
                      "not": {
                        "kind": "type"
                      }
                    },
                    "any": [
                      {
                        "kind": "subscript",
                        "has": {
                          "field": "value",
                          "any": [
                            {
                              "kind": "identifier"
                            },
                            {
                              "kind": "attribute"
                            }
                          ],
                          "resolves": {
                            "import": [
                              "typing.Annotated",
                              "typing_extensions.Annotated"
                            ]
                          }
                        }
                      },
                      {
                        "kind": "type_parameter",
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "generic_type",
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "identifier"
                              },
                              {
                                "kind": "attribute"
                              }
                            ],
                            "resolves": {
                              "import": [
                                "typing.Annotated",
                                "typing_extensions.Annotated"
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "kind": "type",
                "not": {
                  "nthChild": 1
                },
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "type_parameter",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "generic_type",
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "identifier"
                        },
                        {
                          "kind": "attribute"
                        }
                      ],
                      "resolves": {
                        "import": [
                          "typing.Annotated",
                          "typing_extensions.Annotated"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "typed-dict-call": {
            "kind": "call",
            "has": {
              "field": "function",
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "typing.TypedDict",
                  "typing_extensions.TypedDict",
                  "_typeshed.TypedDict"
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "runtime-string-union-in-annotation",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "path": {
              "notRegex": "\\.pyi$"
            }
          },
          "when": {
            "pythonVersion": {
              "max": "3.13"
            }
          },
          "rule": {
            "inside": {
              "stopBy": "end",
              "matches": "annotation-root"
            },
            "not": {
              "any": [
                {
                  "matches": "future-seen"
                },
                {
                  "matches": "local-annotation"
                }
              ]
            },
            "any": [
              {
                "matches": "union-member"
              },
              {
                "matches": "unparsed-member"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "TC010",
        "message": "Quote the whole union instead of this member (`\"A | None\"`), or drop the quotes if the name already exists at runtime; a string cannot be an operand of `|`.",
        "suppress": {
          "noqa": {
            "codes": [
              "TC010"
            ]
          }
        }
      }
    },
    {
      "id": "runtime-string-union-in-expression",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "union-member",
            "not": {
              "inside": {
                "stopBy": "end",
                "kind": "type"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "TC010",
        "message": "Quote the whole union instead of this member (`\"A | None\"`), or drop the quotes if the name already exists at runtime; a string cannot be an operand of `|`.",
        "suppress": {
          "noqa": {
            "codes": [
              "TC010"
            ]
          }
        }
      }
    },
    {
      "id": "runtime-string-union-in-legacy-typed-dict-field",
      "forbid": {
        "ast": {
          "language": "python",
          "when": {
            "pythonVersion": {
              "max": "3.12"
            }
          },
          "rule": {
            "all": [
              {
                "matches": "plain-string"
              },
              {
                "matches": "union-position"
              },
              {
                "not": {
                  "matches": "union-member"
                }
              },
              {
                "inside": {
                  "stopBy": {
                    "kind": "argument_list"
                  },
                  "kind": "keyword_argument",
                  "not": {
                    "has": {
                      "field": "name",
                      "regex": "^(total|extra_items)$"
                    }
                  }
                }
              },
              {
                "inside": {
                  "stopBy": {
                    "kind": "argument_list"
                  },
                  "kind": "argument_list",
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "typed-dict-call"
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "kind": "keyword_argument"
                          },
                          {
                            "kind": "dictionary_splat"
                          },
                          {
                            "kind": "comment"
                          },
                          {
                            "regex": "^[(),]$"
                          }
                        ]
                      },
                      "any": [
                        {
                          "not": {
                            "any": [
                              {
                                "nthChild": 1
                              },
                              {
                                "nthChild": 2
                              }
                            ]
                          }
                        },
                        {
                          "nthChild": 2,
                          "not": {
                            "kind": "none"
                          }
                        }
                      ]
                    }
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "nthChild": 1,
                    "not": {
                      "any": [
                        {
                          "kind": "keyword_argument"
                        },
                        {
                          "kind": "dictionary_splat"
                        },
                        {
                          "kind": "comment"
                        },
                        {
                          "regex": "^[(),]$"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": {
                      "kind": "argument_list"
                    },
                    "matches": "annotated-metadata"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "TC010",
        "message": "Quote the whole union instead of this member (`\"A | None\"`), or drop the quotes if the name already exists at runtime; a string cannot be an operand of `|`.",
        "suppress": {
          "noqa": {
            "codes": [
              "TC010"
            ]
          }
        }
      }
    }
  ]
}
