{
  "format": "rerail.policy/v1",
  "id": "ruff-b021-f-string-docstring",
  "revision": 1,
  "mode": "steer",
  "description": "Use a plain string literal, not an f-string, for docstrings; Python doesn't treat an f-string as a docstring.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "f-string-docstring",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "f-string": {
              "any": [
                { "kind": "string", "has": { "stopBy": "neighbor", "kind": "string_start", "regex": "[fF]" } },
                { "kind": "concatenated_string", "has": { "stopBy": "neighbor", "matches": "f-string" } },
                { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "f-string" } }
              ]
            }
          },
          "rule": {
            "kind": "expression_statement",
            "all": [
              { "has": { "stopBy": "neighbor", "matches": "f-string" } },
              { "not": { "has": { "stopBy": "neighbor", "regex": "^,$" } } },
              { "not": { "follows": { "stopBy": "end", "not": { "kind": "comment" } } } },
              {
                "any": [
                  { "inside": { "stopBy": "neighbor", "kind": "module" } },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "inside": { "stopBy": "neighbor", "any": [ { "kind": "function_definition" }, { "kind": "class_definition" } ] }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": { "anchor": "witness.span", "code": "B021", "message": "Replace this f-string with a plain string literal so Python keeps it as the docstring.", "suppress": { "noqa": { "codes": ["B021"] } } }
    }
  ]
}
