{
  "format": "rerail.policy/v1",
  "id": "ruff-c411-unnecessary-list-call",
  "revision": 1,
  "mode": "steer",
  "description": "Remove the list call around a list comprehension; the comprehension already builds a new list.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-list-call",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "callee": {
              "any": [
                {
                  "kind": "identifier",
                  "resolves": {
                    "global": [
                      "list"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee"
                  }
                }
              ]
            },
            "literal": {
              "any": [
                {
                  "kind": "list_comprehension"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "literal"
                  }
                }
              ]
            },
            "trivia": {
              "any": [
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                },
                {
                  "regex": "^[(),]$"
                }
              ]
            },
            "target": {
              "kind": "call",
              "all": [
                {
                  "has": {
                    "field": "function",
                    "matches": "callee"
                  }
                },
                {
                  "has": {
                    "field": "arguments",
                    "kind": "argument_list",
                    "count": {
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "matches": "trivia"
                        }
                      },
                      "min": 1,
                      "max": 1
                    },
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "literal"
                    }
                  }
                }
              ]
            },
            "in-annotation": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "target",
                      "capture": "CALL"
                    },
                    {
                      "matches": "in-annotation"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "target",
                "pattern": "$CALL"
              },
              {
                "matches": "in-annotation"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.CALL",
        "code": "C411",
        "message": "Remove the outer `list()` call and keep the list comprehension; it already builds a new list.",
        "each": "CALL",
        "suppress": {
          "noqa": {
            "codes": [
              "C411"
            ]
          }
        }
      }
    }
  ]
}
