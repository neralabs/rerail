                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C18",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C19",
