                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C10",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C11",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C12",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C13",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C14",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C15",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C16",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
