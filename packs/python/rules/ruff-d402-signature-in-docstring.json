{
  "format": "rerail.policy/v1",
  "id": "ruff-d402-signature-in-docstring",
  "revision": 1,
  "mode": "steer",
  "description": "Describe what a function does in its docstring's first line instead of repeating its signature.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "signature-in-docstring",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "doc-stmt": {
              "kind": "expression_statement",
              "not": {
                "any": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  },
                  {
                    "follows": {
                      "stopBy": "end",
                      "not": {
                        "kind": "comment"
                      }
                    }
                  }
                ]
              },
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "block",
                    "inside": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "function_definition"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "doc-holder": {
              "any": [
                {
                  "matches": "doc-stmt"
                },
                {
                  "kind": "parenthesized_expression",
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "doc-holder"
                  }
                }
              ]
            },
            "docstring": {
              "kind": "string",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string_start",
                  "regex": "[bBfFtT]"
                }
              },
              "inside": {
                "stopBy": "neighbor",
                "matches": "doc-holder"
              }
            }
          },
          "rule": {
            "matches": "docstring",
            "has": {
              "stopBy": "neighbor",
              "kind": "string_content",
              "pattern": "$DOC"
            },
            "inside": {
              "stopBy": "end",
              "kind": "function_definition",
              "has": {
                "field": "name",
                "kind": "identifier",
                "pattern": "$NAME"
              }
            },
            "any": [
              {
                "compare": {
                  "left": "C1",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C2",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C3",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C4",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C5",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C6",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C7",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
