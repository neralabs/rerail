                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C22",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C23",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              },
              {
                "compare": {
                  "left": "C24",
                  "op": "eq",
                  "right": "NAME",
                  "text": "source"
                }
              }
            ]
          },
          "transform": {
            "LINE": {
              "replace": {
                "source": "$DOC",
                "replace": "^\\s*([^\\n\\r]*)[\\s\\S]*$",
                "by": "$1"
              }
            },
            "CALLS": {
              "replace": {
                "source": "$LINE",
                "replace": "(?:^|[ \\t;,])(\\w+)\\(|[\\s\\S]",
                "by": " $1"
              }
            },
            "C1": {
              "replace": {
                "source": "$CALLS",
                "replace": "^\\s*(\\S+)[\\s\\S]*$|^[\\s\\S]*$",
                "by": "$1"
              }
            },
            "C2": {
              "replace": {
                "source": "$CALLS",
                "replace": "^\\s*(?:\\S+\\s+){1}(\\S+)[\\s\\S]*$|^[\\s\\S]*$",
                "by": "$1"
              }
            },
            "C3": {
              "replace": {
                "source": "$CALLS",
                "replace": "^\\s*(?:\\S+\\s+){2}(\\S+)[\\s\\S]*$|^[\\s\\S]*$",
