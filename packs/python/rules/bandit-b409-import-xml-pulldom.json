{
  "format": "rerail.policy/v1",
  "id": "bandit-b409-import-xml-pulldom",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid importing xml.dom.pulldom to parse XML; it is open to XML attacks, so use defusedxml.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B409",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import xml.dom.pulldom"
              },
              {
                "pattern": "import xml.dom.pulldom as $ALIAS"
              },
              {
                "pattern": "from xml.dom.pulldom import $$$NAMES"
              },
              {
                "pattern": "from xml.dom import pulldom"
              },
              {
                "pattern": "from xml.dom import pulldom as $ALIAS"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B409",
        "anchor": "witness.span",
        "message": "Parse this XML with defusedxml.pulldom instead of xml.dom.pulldom; the standard parser is open to XML entity attacks.",
        "suppress": {
          "nosec": {
            "codes": [
              "B409"
            ]
          }
        }
      }
    }
  ]
}
