{
  "format": "rerail.policy/v1",
  "id": "ruff:F701",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's F701 (break-outside-loop, a semantic syntax error) with default settings: `break` with no enclosing `for`/`while` body between it and the nearest function or class definition. A loop's `else` block does not count as inside that loop.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "break-outside-loop",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "break_statement",
            "not": {
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "kind": "block",
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "for_statement"
                    },
                    {
                      "kind": "while_statement"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F701",
        "message": "`break` outside loop"
      }
    }
  ]
}
