{
  "format": "rerail.policy/v1",
  "id": "ruff-f523-string-dot-format-extra-positional-arguments",
  "revision": 1,
  "mode": "steer",
  "description": "Remove positional arguments to str.format() that no placeholder in the string uses; they are silently ignored.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "string-dot-format-extra-positional-arguments",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$S.format($$$A)",
            "formatArgs": {
              "style": "brace",
              "string": "S",
              "args": "A",
              "unused": {
                "not": {
                  "kind": "keyword_argument"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F523",
        "message": "Remove the positional arguments that no placeholder in this str.format() string uses.",
        "suppress": {
          "noqa": {
            "codes": [
              "F523"
            ]
          }
        }
      }
    }
  ]
}
