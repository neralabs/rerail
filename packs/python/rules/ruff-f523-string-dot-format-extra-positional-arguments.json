{
  "format": "rerail.policy/v1",
  "id": "ruff-f523-string-dot-format-extra-positional-arguments",
  "revision": 1,
  "mode": "steer",
  "description": "Remove positional arguments to str.format() that no placeholder in the string uses; they are silently ignored.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "string-dot-format-extra-positional-arguments",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "$S.format($$$A)",
                "formatArgs": {
                  "style": "brace",
                  "string": "S",
                  "args": "A",
                  "unused": {
                    "not": {
                      "kind": "keyword_argument"
                    }
                  }
                }
              },
              {
                "kind": "call",
                "has": {
                  "field": "arguments",
                  "kind": "generator_expression"
                },
                "all": [
                  {
                    "has": {
                      "field": "function",
                      "kind": "attribute",
                      "has": {
                        "field": "attribute",
                        "regex": "^format$"
                      }
                    }
                  },
                  {
                    "has": {
                      "field": "function",
                      "has": {
                        "field": "object",
                        "matches": "never-reads-first"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "utils": {
            "plain-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                    }
                  }
                }
              ]
            },
            "never-reads-first": {
              "any": [
                {
                  "matches": "plain-string",
                  "parse": {
                    "grammar": "braceFormat",
                    "not": {
                      "has": {
                        "stopBy": "end",
                        "any": [
                          {
                            "kind": "error"
                          },
                          {
                            "kind": "field_name",
                            "value": {
                              "eq": 0
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "never-reads-first"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F523",
        "message": "`.format` call has unused arguments",
        "suppress": {
          "noqa": {
            "codes": [
              "F523"
            ]
          }
        }
      }
    }
  ]
}
