{
  "format": "rerail.policy/v1",
  "id": "ruff-f706-return-outside-function",
  "revision": 1,
  "mode": "steer",
  "description": "Keep return inside a function; at module level or directly in a class body it is a Python syntax error.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "return-outside-function",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "return_statement",
            "not": {
              "inside": {
                "stopBy": {
                  "kind": "block",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  }
                },
                "kind": "block",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "function_definition"
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F706",
        "message": "`return` statement outside of a function/method",
        "suppress": {
          "noqa": {
            "codes": [
              "F706"
            ]
          }
        }
      }
    }
  ]
}
