{
  "format": "rerail.policy/v1",
  "id": "ruff-b026-star-arg-unpacking-after-keyword-arg",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's B026 (star-arg-unpacking-after-keyword-arg): a `*` unpacking argument of a call that comes after the call's first keyword argument (`name=value` or `**mapping`). Reported on the starred argument.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "star-arg-unpacking-after-keyword-arg",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "list_splat",
            "inside": {
              "stopBy": "neighbor",
              "kind": "argument_list",
              "inside": {
                "stopBy": "neighbor",
                "kind": "call"
              }
            },
            "follows": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "keyword_argument"
                },
                {
                  "kind": "dictionary_splat"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B026",
        "message": "Star-arg unpacking after a keyword argument is strongly discouraged",
        "suppress": {
          "noqa": {
            "codes": [
              "B026"
            ]
          }
        }
      }
    }
  ]
}
