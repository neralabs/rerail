{
  "format": "rerail.policy/v1",
  "id": "ruff-pt012-pytest-raises-with-multiple-statements",
  "revision": 1,
  "mode": "steer",
  "description": "Keep a pytest.raises block to a single simple statement; extra statements can raise the expected exception before the code under test runs, so the test passes for the wrong reason.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "raises": {
            "any": [
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "raises"
                }
              },
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "attribute"
                  }
                ],
                "resolves": {
                  "import": [
                    "pytest.raises"
                  ]
                }
              }
            ]
          },
          "raises-call": {
            "any": [
              {
                "kind": "call",
                "has": {
                  "field": "function",
                  "matches": "raises"
                }
              },
              {
                "any": [
                  {
                    "kind": "parenthesized_expression"
                  },
                  {
                    "kind": "as_pattern"
                  }
                ],
                "has": {
                  "stopBy": "neighbor",
                  "matches": "raises-call"
                }
              }
            ]
          },
          "raises-with": {
            "kind": "with_statement",
            "has": {
              "kind": "with_clause",
              "has": {
                "kind": "with_item",
                "has": {
                  "field": "value",
                  "any": [
                    {
                      "matches": "raises-call"
                    },
                    {
                      "kind": "tuple",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "raises-call"
                      }
                    }
                  ]
                }
              }
            },
            "regex": "^(?P<S>(?:[^\"'#]|#[^\\n]*|\"\"\"(?:[^\"\\\\]|\\\\[\\s\\S]|\"\"?(?:[^\"\\\\]|\\\\[\\s\\S]))*\"\"\"|'''(?:[^'\\\\]|\\\\[\\s\\S]|''?(?:[^'\\\\]|\\\\[\\s\\S]))*'''|\"(?:[^\\n\"\\\\]|\\\\[\\s\\S])*\"|'(?:[^\\n'\\\\]|\\\\[\\s\\S])*')*?(?:[^\\s\"'#]|\"\"\"(?:[^\"\\\\]|\\\\[\\s\\S]|\"\"?(?:[^\"\\\\]|\\\\[\\s\\S]))*\"\"\"|'''(?:[^'\\\\]|\\\\[\\s\\S]|''?(?:[^'\\\\]|\\\\[\\s\\S]))*'''|\"(?:[^\\n\"\\\\]|\\\\[\\s\\S])*\"|'(?:[^\\n'\\\\]|\\\\[\\s\\S])*'))(?:\\s|#[^\\n]*)*$"
          },
          "stmt": {
            "not": {
              "any": [
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                },
                {
                  "regex": "^;$"
                }
              ]
            }
          },
          "ellipsis-expr": {
            "any": [
              {
                "kind": "ellipsis"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "ellipsis-expr"
                }
              }
            ]
          },
          "compound": {
            "any": [
              {
                "kind": "if_statement"
              },
              {
                "kind": "while_statement"
              },
              {
                "kind": "for_statement"
              },
              {
                "kind": "match_statement"
              },
              {
                "kind": "with_statement"
              },
              {
                "kind": "try_statement"
              },
              {
                "kind": "function_definition"
              },
              {
                "kind": "class_definition"
              },
              {
                "kind": "decorated_definition"
              }
            ]
          },
          "many-stmts": {
            "kind": "block",
            "has": {
              "stopBy": "neighbor",
              "matches": "stmt",
              "follows": {
                "stopBy": "end",
                "matches": "stmt"
              }
            }
          },
          "nontrivial-for": {
            "kind": "for_statement",
            "has": {
              "field": "body",
              "kind": "block",
              "any": [
                {
                  "matches": "many-stmts"
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "stmt",
                    "not": {
                      "any": [
                        {
                          "kind": "pass_statement"
                        },
                        {
                          "matches": "ellipsis-stmt"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "nontrivial-with": {
            "kind": "with_statement",
            "has": {
              "field": "body",
              "kind": "block",
              "any": [
                {
                  "matches": "many-stmts"
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "compound"
                  }
                }
              ]
            }
          },
          "single-compound": {
            "any": [
              {
                "kind": "if_statement"
              },
              {
                "kind": "while_statement"
              },
              {
                "kind": "match_statement"
              },
              {
                "kind": "try_statement"
              },
              {
                "matches": "nontrivial-with"
              },
              {
                "matches": "nontrivial-for"
              }
            ]
          },
          "ellipsis-stmt": {
            "kind": "expression_statement",
            "has": {
              "stopBy": "neighbor",
              "matches": "ellipsis-expr"
            },
            "not": {
              "has": {
                "stopBy": "neighbor",
                "regex": "^,$"
              }
            }
          }
        }
      }
    },
    {
      "id": "raises-with-multiple-statements",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "raises-with",
            "all": [
              {
                "has": {
                  "field": "body",
                  "kind": "block",
                  "matches": "many-stmts"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.S",
        "code": "PT012",
        "message": "Keep only the statement that should raise inside `pytest.raises`; move setup and follow-up statements before or after the `with` block, unless each one is needed to trigger the error.",
        "suppress": {
          "noqa": {
            "codes": [
              "PT012"
            ]
          }
        }
      }
    },
    {
      "id": "raises-with-compound-statement",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "raises-with",
            "all": [
              {
                "has": {
                  "field": "body",
                  "kind": "block",
                  "not": {
                    "matches": "many-stmts"
                  },
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "single-compound"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.S",
        "code": "PT012",
        "message": "Put only the call that should raise inside `pytest.raises`; move the surrounding `if`, loop, `try` or nested `with` logic out of the block, unless it is needed to trigger the error.",
        "suppress": {
          "noqa": {
            "codes": [
              "PT012"
            ]
          }
        }
      }
    }
  ]
}
