{
  "format": "rerail.policy/v1",
  "id": "ruff:SIM101",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's SIM101 (duplicate-isinstance-call): two adjacent operands of one `or` chain that are calls of the builtin `isinstance(T, C)` (exactly two positional arguments, no keywords) with equal targets (Ruff's ComparableExpr, `text: \"structure\"`; names without NFKC normalization), reported on the whole `or` chain once per run of adjacent such calls with equal targets. A parenthesized `or` is its own chain, as in Ruff's AST. `isinstance` must resolve to the builtin (`match_builtin_expr`: the unshadowed name, or `builtins.isinstance` through an import).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "duplicate-isinstance-call",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "or-op": {
              "kind": "boolean_operator",
              "has": {
                "field": "operator",
                "regex": "^or$"
              }
            },
            "isinstance-a": {
              "any": [
                {
                  "kind": "call",
                  "pattern": "$_F($_, $_)",
                  "all": [
                    {
                      "has": {
                        "field": "arguments",
                        "kind": "argument_list",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "keyword_argument"
                              },
                              {
                                "kind": "dictionary_splat"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "function",
                        "matches": "isinstance-ref"
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "kind": "argument_list",
                        "has": {
                          "stopBy": "neighbor",
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "^\\($"
                          },
                          "matches": "target-a"
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "isinstance-a"
                  }
                }
              ]
            },
            "target-a": {
              "pattern": "$A"
            },
            "isinstance-t": {
              "any": [
                {
                  "kind": "call",
                  "pattern": "$_F($_, $_)",
                  "all": [
                    {
                      "has": {
                        "field": "arguments",
                        "kind": "argument_list",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "keyword_argument"
                              },
                              {
                                "kind": "dictionary_splat"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "function",
                        "matches": "isinstance-ref"
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "kind": "argument_list",
                        "has": {
                          "stopBy": "neighbor",
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "^\\($"
                          },
                          "matches": "target-t"
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "isinstance-t"
                  }
                }
              ]
            },
            "target-t": {
              "any": [
                {
                  "not": {
                    "kind": "parenthesized_expression"
                  },
                  "pattern": "$T"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "regex": "^[()]$"
                    },
                    "matches": "target-t"
                  }
                }
              ]
            },
            "isinstance-b": {
              "any": [
                {
                  "kind": "call",
                  "pattern": "$_F($_, $_)",
                  "all": [
                    {
                      "has": {
                        "field": "arguments",
                        "kind": "argument_list",
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {
                                "kind": "keyword_argument"
                              },
                              {
                                "kind": "dictionary_splat"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "has": {
                        "field": "function",
                        "matches": "isinstance-ref"
                      }
                    },
                    {
                      "has": {
                        "field": "arguments",
                        "kind": "argument_list",
                        "has": {
                          "stopBy": "neighbor",
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "^\\($"
                          },
                          "matches": "target-b"
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "isinstance-b"
                  }
                }
              ]
            },
            "target-b": {
              "any": [
                {
                  "not": {
                    "kind": "parenthesized_expression"
                  },
                  "pattern": "$B"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "regex": "^[()]$"
                    },
                    "matches": "target-b"
                  }
                }
              ]
            },
            "adjacent-pair": {
              "matches": "or-op",
              "all": [
                {
                  "has": {
                    "field": "left",
                    "any": [
                      {
                        "not": {
                          "matches": "or-op"
                        },
                        "matches": "isinstance-t"
                      },
                      {
                        "matches": "or-op",
                        "has": {
                          "field": "right",
                          "matches": "isinstance-t"
                        }
                      }
                    ]
                  }
                },
                {
                  "has": {
                    "field": "right",
                    "matches": "isinstance-a"
                  }
                }
              ],
              "compare": {
                "left": "T",
                "op": "eq",
                "right": "A",
                "text": "structure"
              }
            },
            "isinstance-ref": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "builtins.isinstance"
                    ],
                    "global": [
                      "isinstance"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "isinstance-ref"
                  }
                }
              ]
            },
            "last-is-b": {
              "any": [
                {
                  "not": {
                    "matches": "or-op"
                  },
                  "matches": "isinstance-b"
                },
                {
                  "matches": "or-op",
                  "has": {
                    "field": "right",
                    "matches": "isinstance-b"
                  }
                }
              ]
            },
            "run-start": {
              "matches": "adjacent-pair",
              "pattern": "$P",
              "not": {
                "has": {
                  "field": "left",
                  "matches": "or-op",
                  "has": {
                    "field": "left",
                    "matches": "last-is-b",
                    "compare": {
                      "left": "B",
                      "op": "eq",
                      "right": "T",
                      "text": "structure"
                    }
                  }
                }
              }
            }
          },
          "rule": {
            "kind": "boolean_operator",
            "matches": "or-op",
            "not": {
              "inside": {
                "stopBy": "neighbor",
                "matches": "or-op"
              }
            },
            "any": [
              {
                "matches": "run-start"
              },
              {
                "has": {
                  "stopBy": {
                    "not": {
                      "matches": "or-op"
                    }
                  },
                  "matches": "run-start"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM101",
        "message": "Multiple `isinstance` calls for `$T`, merge into a single call",
        "each": "P",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM101"
            ]
          }
        }
      }
    }
  ]
}
