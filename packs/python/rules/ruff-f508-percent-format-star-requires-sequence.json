{
  "format": "rerail.policy/v1",
  "id": "ruff-f508-percent-format-star-requires-sequence",
  "revision": 1,
  "mode": "steer",
  "description": "Pass a tuple, not a dict, to a %-format string that uses a * width or precision; the call fails at run time.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "percent-format-star-requires-sequence",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "plain-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                    }
                  }
                }
              ]
            },
            "format-string": {
              "any": [
                {
                  "matches": "plain-string",
                  "parse": {
                    "grammar": "percentFormat",
                    "not": {
                      "has": {
                        "kind": "error"
                      }
                    },
                    "has": {
                      "kind": "star",
                      "stopBy": "end"
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "format-string"
                  }
                }
              ]
            },
            "operand": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "dictionary"
                    },
                    {
                      "kind": "dictionary_comprehension"
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "operand"
                  }
                }
              ]
            }
          },
          "rule": {
            "pattern": "$S % $R"
          },
          "constraints": {
            "S": {
              "matches": "format-string"
            },
            "R": {
              "matches": "operand"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F508",
        "message": "Pass a tuple instead of a dict to this %-format string; its `*` width or precision takes positional values.",
        "suppress": {
          "noqa": {
            "codes": [
              "F508"
            ]
          }
        }
      }
    }
  ]
}
