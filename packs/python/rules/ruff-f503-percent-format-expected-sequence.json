{
  "format": "rerail.policy/v1",
  "id": "ruff-f503-percent-format-expected-sequence",
  "revision": 1,
  "mode": "steer",
  "description": "Pass a tuple, not a dict, to a %-format string with several positional placeholders; the call fails at run time.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "percent-format-expected-sequence",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "plain-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                    }
                  }
                }
              ]
            },
            "format-string": {
              "any": [
                {
                  "matches": "plain-string",
                  "parse": {
                    "grammar": "percentFormat",
                    "not": {
                      "has": {
                        "kind": "error"
                      }
                    },
                    "count": {
                      "has": {
                        "stopBy": "end",
                        "any": [
                          {
                            "kind": "placeholder",
                            "not": {
                              "has": {
                                "kind": "mapping_key"
                              }
                            }
                          },
                          {
                            "kind": "star"
                          }
                        ]
                      },
                      "min": 2
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "format-string"
                  }
                }
              ]
            },
            "operand": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "dictionary"
                    },
                    {
                      "kind": "dictionary_comprehension"
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "operand"
                  }
                }
              ]
            }
          },
          "rule": {
            "pattern": "$S % $R"
          },
          "constraints": {
            "S": {
              "matches": "format-string"
            },
            "R": {
              "matches": "operand"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F503",
        "message": "Pass a tuple to this %-format string; its positional placeholders need a sequence, not a dict.",
        "suppress": {
          "noqa": {
            "codes": [
              "F503"
            ]
          }
        }
      }
    }
  ]
}
