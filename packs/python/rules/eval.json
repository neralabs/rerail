{
  "format": "rerail.policy/v1",
  "id": "bandit:b307",
  "revision": 2,
  "mode": "steer",
  "description": "Detect calls to Python's eval function, which evaluates supplied text as code and may be unsafe. Use ast.literal_eval when only Python literals need to be parsed.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "eval-call",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "call",
            "has": {
              "field": "function",
              "matches": "eval-callee"
            }
          },
          "utils": {
            "eval-callee": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^eval$",
                  "not": {
                    "resolves": {
                      "binding": {
                        "form": "import",
                        "site": {
                          "matches": "alias-to-other"
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "binding": {
                      "form": "import",
                      "site": {
                        "matches": "alias-to-eval"
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "eval-callee"
                  }
                }
              ]
            },
            "from-with-module": {
              "kind": "import_from_statement",
              "has": {
                "field": "module_name",
                "any": [
                  {
                    "kind": "dotted_name"
                  },
                  {
                    "kind": "relative_import",
                    "has": {
                      "kind": "dotted_name"
                    }
                  }
                ]
              }
            },
            "alias-to-eval": {
              "kind": "aliased_import",
              "has": {
                "field": "name",
                "regex": "^eval$"
              },
              "not": {
                "inside": {
                  "matches": "from-with-module"
                }
              }
            },
            "alias-to-other": {
              "any": [
                {
                  "kind": "aliased_import",
                  "not": {
                    "matches": "alias-to-eval"
                  }
                },
                {
                  "kind": "dotted_name",
                  "inside": {
                    "matches": "from-with-module"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "code": "B307",
        "anchor": "witness.span",
        "message": "This eval call executes supplied text as Python code and may be unsafe. Use ast.literal_eval when only Python literals need to be parsed.",
        "suppress": {
          "nosec": {
            "codes": [
              "B307"
            ]
          }
        }
      }
    }
  ]
}
