{
  "format": "rerail.policy/v1",
  "id": "ruff-f525-string-dot-format-mixing-automatic",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's F525 (string-dot-format-mixing-automatic): a `.format` call on a valid format string with both an automatically numbered field (`{}`) and a manually numbered one (`{0}`), nested fields in specs included. The format string is a str literal (no f/t/b prefix; implicit concatenations joined, escapes decoded, parentheses transparent) receiving `.format`, read with the `braceFormat` grammar (a port of ruff_python_literal's format parser as pyflakes' FormatSummary reads it).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "string-dot-format-mixing-automatic",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "plain-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                    }
                  }
                }
              ]
            },
            "format-string": {
              "any": [
                {
                  "matches": "plain-string",
                  "parse": {
                    "grammar": "braceFormat",
                    "not": {
                      "has": {
                        "kind": "error"
                      }
                    },
                    "all": [
                      {
                        "has": {
                          "kind": "auto",
                          "stopBy": "end"
                        }
                      },
                      {
                        "has": {
                          "kind": "index",
                          "stopBy": "end"
                        }
                      }
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "format-string"
                  }
                }
              ]
            }
          },
          "rule": {
            "pattern": "$S.format($$$A)"
          },
          "constraints": {
            "S": {
              "matches": "format-string"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F525",
        "message": "`.format` string mixes automatic and manual numbering",
        "suppress": {
          "noqa": {
            "codes": [
              "F525"
            ]
          }
        }
      }
    }
  ]
}
