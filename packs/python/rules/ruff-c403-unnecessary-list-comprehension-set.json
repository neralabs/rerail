{
  "format": "rerail.policy/v1",
  "id": "ruff-c403-unnecessary-list-comprehension-set",
  "revision": 1,
  "mode": "steer",
  "description": "Use a set comprehension instead of passing a list comprehension to set; it skips building a throwaway list.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "list-comprehension-set",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "trivia": {
              "any": [
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                },
                {
                  "regex": "^[(),]$"
                }
              ]
            },
            "callee": {
              "any": [
                {
                  "kind": "identifier",
                  "resolves": {
                    "global": [
                      "set"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee"
                  }
                }
              ]
            },
            "listcomp": {
              "any": [
                {
                  "kind": "list_comprehension"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "listcomp"
                  }
                }
              ]
            },
            "call": {
              "kind": "call",
              "any": [
                {
                  "has": {
                    "field": "function",
                    "matches": "callee"
                  },
                  "pattern": "$CALL"
                },
                {
                  "has": {
                    "field": "function",
                    "kind": "list_splat",
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "callee"
                    }
                  },
                  "regex": "^\\*(?:\\s|\\\\\\r?\\n|#[^\\r\\n]*)*(?<CALL>[\\s\\S]+)$"
                }
              ],
              "has": {
                "field": "arguments",
                "kind": "argument_list",
                "count": {
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "matches": "trivia"
                    }
                  },
                  "min": 1,
                  "max": 1
                },
                "has": {
                  "stopBy": "neighbor",
                  "matches": "listcomp"
                }
              }
            },
            "in-annotation": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "call"
                    },
                    {
                      "matches": "in-annotation"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "call"
              },
              {
                "matches": "in-annotation"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.CALL",
        "code": "C403",
        "message": "Rewrite `set([expr for ...])` as a set comprehension `{expr for ...}`; the intermediate list is not needed.",
        "each": "CALL",
        "suppress": {
          "noqa": {
            "codes": [
              "C403"
            ]
          }
        }
      }
    }
  ]
}
