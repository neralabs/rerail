{
  "format": "rerail.policy/v1",
  "id": "ruff-b029-except-with-empty-tuple",
  "revision": 1,
  "mode": "steer",
  "description": "Don't write an except clause with an empty tuple as its type; it catches nothing, so name the exceptions to handle.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "except-with-empty-tuple",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "type-slot": {
              "any": [
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^(except|\\*)$"
                  },
                  "not": {
                    "precedes": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "except_clause"
                  }
                },
                {
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "as_pattern",
                    "matches": "type-slot"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "type-slot"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "except_clause",
            "has": {
              "stopBy": {
                "kind": "block"
              },
              "kind": "tuple",
              "matches": "type-slot",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "any": [
                      {
                        "regex": "^[(),]$"
                      },
                      {
                        "kind": "comment"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B029",
        "message": "Name the exceptions to catch in this except clause; an empty tuple catches nothing.",
        "suppress": {
          "noqa": {
            "codes": [
              "B029"
            ]
          }
        }
      }
    }
  ]
}
