{
  "format": "rerail.policy/v1",
  "id": "ruff-d105-undocumented-magic-method",
  "revision": 1,
  "mode": "steer",
  "description": "Add a docstring to each magic method of a public class, describing what the operation does and returns.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "doc-expr": {
            "any": [
              {"kind": "string", "regex": "^[rRuU]{0,2}['\"]"},
              {
                "kind": "concatenated_string",
                "not": {"has": {"stopBy": "neighbor", "kind": "string", "not": {"regex": "^[rRuU]{0,2}['\"]"}}}
              },
              {"kind": "parenthesized_expression", "has": {"stopBy": "neighbor", "matches": "doc-expr"}}
            ]
          },
          "documented": {
            "kind": "block",
            "has": {
              "stopBy": "neighbor",
              "kind": "expression_statement",
              "nthChild": {"position": 1, "ofRule": {"not": {"kind": "comment"}}},
              "has": {"stopBy": "neighbor", "matches": "doc-expr"},
              "not": {"has": {"stopBy": "neighbor", "regex": "^,$"}}
            }
          },
          "dunder-all": {
            "any": [{"kind": "assignment"}, {"kind": "augmented_assignment"}],
            "has": {"field": "left", "kind": "identifier", "regex": "^__all__$"},
            "inside": {"stopBy": "neighbor", "kind": "expression_statement"}
          },
          "public-class": {
            "kind": "class_definition",
            "not": {"has": {"field": "name", "regex": "^_"}},
            "any": [
              {
                "inside": {
                  "stopBy": {"any": [{"kind": "function_definition"}, {"kind": "class_definition"}]},
                  "kind": "class_definition",
                  "matches": "public-class"
                }
              },
              {
                "all": [
                  {
                    "not": {
                      "inside": {"stopBy": "end", "any": [{"kind": "function_definition"}, {"kind": "class_definition"}]}
                    }
                  },
                  {
                    "has": {
                      "field": "name",
                      "any": [
                        {
                          "not": {
                            "inside": {
                              "stopBy": "end",
                              "kind": "module",
                              "has": {
                                "stopBy": {"any": [{"kind": "function_definition"}, {"kind": "class_definition"}]},
                                "matches": "dunder-all"
                              }
                            }
                          }
                        },
                        {"binds": {"exported": true}}
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "exempt-decorator": {
            "any": [
              {
                "any": [{"kind": "identifier"}, {"kind": "attribute"}],
                "resolves": {
                  "import": [
                    "typing.overload",
                    "typing_extensions.overload",
                    "_typeshed.overload",
                    "typing.override",
                    "typing_extensions.override",
                    "_typeshed.override"
                  ]
                }
              },
              {
                "kind": "attribute",
                "has": {"field": "attribute", "regex": "^(?:setter|deleter)$"},
                "all": [
                  {
                    "has": {
                      "field": "object",
                      "any": [
                        {"kind": "identifier", "pattern": "$NAME"},
                        {
                          "kind": "parenthesized_expression",
                          "has": {
                            "stopBy": "neighbor",
                            "any": [
                              {"kind": "identifier", "pattern": "$NAME"},
                              {
                                "kind": "parenthesized_expression",
                                "has": {"stopBy": "neighbor", "kind": "identifier", "pattern": "$NAME"}
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              {"kind": "parenthesized_expression", "has": {"stopBy": "neighbor", "matches": "exempt-decorator"}}
            ]
          },
          "undocumented-method": {
            "kind": "function_definition",
            "not": {"has": {"field": "body", "matches": "documented"}},
            "inside": {
              "stopBy": {"any": [{"kind": "function_definition"}, {"kind": "class_definition"}]},
              "kind": "class_definition",
              "matches": "public-class"
            },
            "all": [
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "decorated_definition",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "decorator",
                      "has": {"stopBy": "neighbor", "matches": "exempt-decorator"}
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "undocumented-magic-method",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "inPackage": false,
            "path": {"notRegex": "\\.pyi$|(?:^|[\\\\/])(?:_|_[^_\\\\/][^\\\\/]*|__[^\\\\/]*[^_\\\\/]_?)\\.[^.\\\\/]+$"}
          },
          "rule": {
            "kind": "identifier",
            "regex": "^__(?:_|.*__)?$",
            "pattern": "$NAME",
            "not": {"regex": "^__(?:init|new|call)__$"},
            "inside": {"field": "name", "stopBy": "neighbor", "matches": "undocumented-method"}
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "D105",
        "message": "Add a docstring to magic method `$NAME` describing its behavior, arguments and return value.",
        "suppress": {"noqa": {"codes": ["D105"]}}
      }
    },
    {
      "id": "undocumented-magic-method-in-package",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "inPackage": true,
            "path": {"notRegex": "\\.pyi$"},
            "module": {"notRegex": "(?:^|\\.)(?:_|_[^._][^.]*|__[^.]*[^._]_?)(?:\\.|$)"}
          },
          "rule": {
            "kind": "identifier",
            "regex": "^__(?:_|.*__)?$",
            "pattern": "$NAME",
            "not": {"regex": "^__(?:init|new|call)__$"},
            "inside": {"field": "name", "stopBy": "neighbor", "matches": "undocumented-method"}
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "D105",
        "message": "Add a docstring to magic method `$NAME` describing its behavior, arguments and return value.",
        "suppress": {"noqa": {"codes": ["D105"]}}
      }
    }
  ]
}
