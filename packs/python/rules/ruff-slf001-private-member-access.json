{
  "format": "rerail.policy/v1",
  "id": "ruff-slf001-private-member-access",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid accessing underscore-prefixed members of other objects; use the class's public interface, since private members can change without notice.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "options",
      "define": {
        "options": {
          "flake8-self.ignore-names": {
            "type": "array",
            "items": "string",
            "default": [
              "_make",
              "_asdict",
              "_replace",
              "_fields",
              "_field_defaults",
              "_name_",
              "_value_"
            ],
            "description": "Attribute names that may be accessed even though they start with an underscore."
          }
        }
      }
    },
    {
      "id": "private-member-access",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "private-name": {
              "kind": "identifier",
              "regex": "^_",
              "all": [
                {
                  "not": {
                    "regex": "^__(?:_|.*__)?$"
                  }
                },
                {
                  "not": {
                    "regex": "^(?:_|_[^_](?:.*[^_])?_)$"
                  }
                },
                {
                  "$option": "flake8-self.ignore-names",
                  "cases": {
                    "[]": {
                      "kind": "identifier"
                    }
                  },
                  "default": {
                    "not": {
                      "regex": {
                        "$option": "flake8-self.ignore-names",
                        "escape": "regex",
                        "join": "|",
                        "template": "^(?:{})$"
                      }
                    }
                  }
                }
              ]
            },
            "in-annotation": {
              "inside": {
                "stopBy": "end",
                "kind": "type",
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "typed_parameter"
                    },
                    {
                      "kind": "typed_default_parameter"
                    },
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "assignment"
                    }
                  ]
                }
              }
            },
            "dunder-operator-function": {
              "kind": "function_definition",
              "has": {
                "stopBy": "neighbor",
                "field": "name",
                "regex": "^(?:__lt__|__le__|__eq__|__ne__|__gt__|__ge__|__add__|__sub__|__mul__|__matmul__|__truediv__|__floordiv__|__mod__|__divmod__|__pow__|__lshift__|__rshift__|__and__|__xor__|__or__|__radd__|__rsub__|__rmul__|__rmatmul__|__rtruediv__|__rfloordiv__|__rmod__|__rdivmod__|__rpow__|__rlshift__|__rrshift__|__rand__|__rxor__|__ror__|__iadd__|__isub__|__imul__|__imatmul__|__itruediv__|__ifloordiv__|__imod__|__ipow__|__ilshift__|__irshift__|__iand__|__ixor__|__ior__)$"
              }
            },
            "scope-start": {
              "any": [
                {
                  "kind": "block",
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "body",
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "body",
                    "any": [
                      {
                        "kind": "lambda"
                      },
                      {
                        "kind": "list_comprehension"
                      },
                      {
                        "kind": "set_comprehension"
                      },
                      {
                        "kind": "dictionary_comprehension"
                      },
                      {
                        "kind": "generator_expression"
                      }
                    ]
                  }
                },
                {
                  "kind": "argument_list",
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "superclasses",
                    "kind": "class_definition"
                  }
                },
                {
                  "kind": "if_clause"
                },
                {
                  "kind": "for_in_clause",
                  "not": {
                    "nthChild": {
                      "position": 1,
                      "ofRule": {
                        "kind": "for_in_clause"
                      }
                    }
                  }
                }
              ]
            },
            "in-dunder-operator": {
              "not": {
                "matches": "scope-start"
              },
              "inside": {
                "stopBy": {
                  "matches": "scope-start"
                },
                "kind": "block",
                "inside": {
                  "stopBy": "neighbor",
                  "field": "body",
                  "matches": "dunder-operator-function"
                }
              }
            },
            "receiver-name": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^(?:self|cls|mcs)$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "receiver-name"
                  }
                }
              ]
            },
            "super-name": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^super$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "super-name"
                  }
                }
              ]
            },
            "super-call": {
              "any": [
                {
                  "kind": "call",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "function",
                    "matches": "super-name"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "super-call"
                  }
                }
              ]
            },
            "static-decorator": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "builtins.staticmethod",
                      "abc.abstractstaticmethod"
                    ],
                    "global": [
                      "staticmethod"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "static-decorator"
                  }
                }
              ]
            },
            "decorated-static": {
              "inside": {
                "stopBy": "neighbor",
                "kind": "decorated_definition",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "decorator",
                  "has": {
                    "stopBy": {
                      "not": {
                        "kind": "parenthesized_expression"
                      }
                    },
                    "any": [
                      {
                        "matches": "static-decorator"
                      },
                      {
                        "kind": "call",
                        "has": {
                          "stopBy": {
                            "not": {
                              "kind": "parenthesized_expression"
                            }
                          },
                          "field": "function",
                          "matches": "static-decorator"
                        }
                      }
                    ]
                  }
                }
              }
            },
            "instance-or-class-method": {
              "kind": "function_definition",
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "class_definition"
                    },
                    {
                      "kind": "function_definition"
                    }
                  ]
                },
                "kind": "class_definition"
              },
              "not": {
                "matches": "decorated-static"
              }
            },
            "receiver-parameter": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "default_parameter"
                },
                {
                  "kind": "typed_parameter",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "identifier"
                  }
                },
                {
                  "kind": "typed_default_parameter"
                }
              ],
              "nthChild": {
                "position": 1,
                "ofRule": {
                  "not": {
                    "kind": "comment"
                  }
                }
              },
              "inside": {
                "stopBy": "neighbor",
                "kind": "parameters",
                "inside": {
                  "stopBy": "neighbor",
                  "field": "parameters",
                  "matches": "instance-or-class-method"
                }
              }
            },
            "self-type": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "typing.Self",
                  "typing_extensions.Self",
                  "_typeshed.Self"
                ]
              }
            },
            "annotated-head": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "typing.Annotated",
                  "typing_extensions.Annotated",
                  "_typeshed.Annotated"
                ]
              }
            },
            "free": {
              "all": [
                {
                  "pattern": "$CLS"
                },
                {
                  "pattern": "$SELFTAG"
                }
              ]
            },
            "type-head": {
              "any": [
                {
                  "matches": "self-type",
                  "all": [
                    {
                      "matches": "free"
                    }
                  ]
                },
                {
                  "kind": "identifier",
                  "pattern": "$CLS"
                }
              ]
            },
            "same-class-type": {
              "any": [
                {
                  "matches": "type-head"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "same-class-type"
                  }
                },
                {
                  "kind": "type",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "same-class-type"
                  }
                },
                {
                  "kind": "generic_type",
                  "has": {
                    "stopBy": "neighbor",
                    "nthChild": 1,
                    "not": {
                      "matches": "annotated-head"
                    },
                    "matches": "same-class-type"
                  }
                },
                {
                  "kind": "generic_type",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "nthChild": 1,
                        "matches": "annotated-head"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "type_parameter",
                        "all": [
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "regex": "^,$"
                            }
                          },
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "type",
                              "nthChild": {
                                "position": 1,
                                "ofRule": {
                                  "kind": "type"
                                }
                              },
                              "matches": "same-class-type"
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "kind": "subscript",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "value",
                    "not": {
                      "matches": "annotated-head"
                    },
                    "matches": "same-class-type"
                  }
                },
                {
                  "kind": "subscript",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "value",
                        "matches": "annotated-head"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "regex": "^,$"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "subscript",
                        "follows": {
                          "stopBy": {
                            "not": {
                              "kind": "comment"
                            }
                          },
                          "regex": "^\\[$"
                        },
                        "matches": "same-class-type"
                      }
                    }
                  ]
                }
              ]
            },
            "same-class-callee": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^(?:cls|mcs)$",
                  "all": [
                    {
                      "matches": "free"
                    }
                  ]
                },
                {
                  "kind": "identifier",
                  "pattern": "$CLS"
                },
                {
                  "kind": "subscript",
                  "matches": "same-class-type"
                },
                {
                  "kind": "attribute",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "object",
                        "kind": "call",
                        "has": {
                          "stopBy": "neighbor",
                          "field": "function",
                          "matches": "super-name"
                        }
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "attribute",
                        "regex": "^__new__$"
                      }
                    },
                    {
                      "matches": "free"
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "same-class-callee"
                  }
                }
              ]
            },
            "same-class-value": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^self$",
                  "resolves": {
                    "binding": {
                      "form": "parameter"
                    }
                  },
                  "all": [
                    {
                      "matches": "free"
                    }
                  ]
                },
                {
                  "kind": "call",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "function",
                    "matches": "same-class-callee"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "same-class-value"
                  }
                }
              ]
            },
            "with-same-class-value": {
              "kind": "as_pattern",
              "all": [
                {
                  "has": {
                    "stopBy": "neighbor",
                    "field": "alias",
                    "kind": "as_pattern_target",
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "plain-name"
                    }
                  }
                },
                {
                  "has": {
                    "stopBy": "neighbor",
                    "nthChild": 1,
                    "matches": "same-class-value"
                  }
                }
              ]
            },
            "plain-name": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "plain-name"
                  }
                }
              ]
            },
            "class-itself": {
              "kind": "identifier",
              "all": [
                {
                  "resolves": {
                    "binding": {
                      "form": "definition",
                      "site": {
                        "kind": "class_definition",
                        "pattern": "$DEF"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "class_definition",
                    "field": "body",
                    "pattern": "$DEF"
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": {
                        "matches": "scope-node"
                      },
                      "any": [
                        {
                          "kind": "list_comprehension"
                        },
                        {
                          "kind": "set_comprehension"
                        },
                        {
                          "kind": "dictionary_comprehension"
                        },
                        {
                          "kind": "generator_expression"
                        }
                      ],
                      "not": {
                        "inside": {
                          "stopBy": {
                            "matches": "scope-node"
                          },
                          "any": [
                            {
                              "kind": "function_definition"
                            },
                            {
                              "kind": "lambda"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            },
            "scope-node": {
              "any": [
                {
                  "kind": "function_definition"
                },
                {
                  "kind": "lambda"
                },
                {
                  "kind": "class_definition"
                }
              ]
            },
            "current-class": {
              "any": [
                {
                  "compare": {
                    "left": "SELFTAG",
                    "op": "eq",
                    "right": "CLS"
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "class_definition",
                    "field": "body",
                    "has": {
                      "stopBy": "neighbor",
                      "field": "name",
                      "pattern": "$CLS"
                    }
                  }
                }
              ]
            },
            "same-class-instance": {
              "kind": "identifier",
              "any": [
                {
                  "resolves": {
                    "binding": {
                      "form": "parameter",
                      "site": {
                        "matches": "receiver-parameter"
                      }
                    }
                  }
                },
                {
                  "all": [
                    {
                      "any": [
                        {
                          "resolves": {
                            "binding": {
                              "form": [
                                "assignment",
                                "named"
                              ],
                              "value": {
                                "matches": "same-class-value"
                              }
                            }
                          }
                        },
                        {
                          "resolves": {
                            "binding": {
                              "form": "with",
                              "site": {
                                "any": [
                                  {
                                    "matches": "with-same-class-value"
                                  },
                                  {
                                    "inside": {
                                      "stopBy": "end",
                                      "matches": "with-same-class-value"
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        },
                        {
                          "resolves": {
                            "binding": {
                              "form": [
                                "annotated"
                              ],
                              "annotation": {
                                "matches": "same-class-type"
                              }
                            }
                          }
                        },
                        {
                          "resolves": {
                            "binding": {
                              "form": "parameter",
                              "site": {
                                "any": [
                                  {
                                    "kind": "typed_default_parameter"
                                  },
                                  {
                                    "kind": "typed_parameter",
                                    "has": {
                                      "stopBy": "neighbor",
                                      "kind": "identifier"
                                    }
                                  }
                                ],
                                "has": {
                                  "stopBy": "neighbor",
                                  "field": "type",
                                  "matches": "same-class-type"
                                }
                              }
                            }
                          }
                        },
                        {
                          "resolves": {
                            "binding": {
                              "form": "definition",
                              "site": {
                                "kind": "function_definition",
                                "has": {
                                  "stopBy": "neighbor",
                                  "field": "return_type",
                                  "matches": "same-class-type"
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "matches": "current-class"
                    }
                  ]
                }
              ]
            },
            "exempt-object": {
              "any": [
                {
                  "matches": "receiver-name"
                },
                {
                  "matches": "super-call"
                },
                {
                  "matches": "class-itself"
                },
                {
                  "matches": "same-class-instance"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "exempt-object"
                  }
                }
              ]
            }
          },
          "rule": {
            "regex": "^(?P<P>[\\w\\s]*(?:\\.[\\w\\s]*)*?\\.\\s*_\\w*|[\\s\\S]*)(?:\\s*\\.(?:[\\w\\s]*\\.)*\\s*[^\\W_]\\w*\\s*)?$",
            "all": [
              {
                "not": {
                  "matches": "in-annotation"
                }
              },
              {
                "not": {
                  "matches": "in-dunder-operator"
                }
              },
              {
                "not": {
                  "resolves": {
                    "import": [
                      "os._exit"
                    ]
                  }
                }
              },
              {
                "any": [
                  {
                    "kind": "attribute",
                    "all": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "field": "attribute",
                          "matches": "private-name"
                        }
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "field": "object",
                            "matches": "exempt-object"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "kind": "dotted_name",
                    "inside": {
                      "stopBy": "end",
                      "kind": "case_pattern"
                    },
                    "any": [
                      {
                        "all": [
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "nthChild": {
                                "position": 1,
                                "reverse": true
                              },
                              "matches": "private-name"
                            }
                          },
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "nthChild": 2
                            }
                          },
                          {
                            "not": {
                              "all": [
                                {
                                  "not": {
                                    "has": {
                                      "stopBy": "neighbor",
                                      "nthChild": 3
                                    }
                                  }
                                },
                                {
                                  "has": {
                                    "stopBy": "neighbor",
                                    "nthChild": 1,
                                    "matches": "exempt-object"
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      },
                      {
                        "not": {
                          "has": {
                            "stopBy": "neighbor",
                            "nthChild": {
                              "position": 1,
                              "reverse": true
                            },
                            "matches": "private-name"
                          }
                        },
                        "any": [
                          {
                            "all": [
                              {
                                "has": {
                                  "stopBy": "neighbor",
                                  "nthChild": 2,
                                  "matches": "private-name"
                                }
                              },
                              {
                                "has": {
                                  "stopBy": "neighbor",
                                  "nthChild": 3
                                }
                              },
                              {
                                "not": {
                                  "has": {
                                    "stopBy": "neighbor",
                                    "nthChild": 1,
                                    "matches": "exempt-object"
                                  }
                                }
                              }
                            ]
                          },
                          {
                            "all": [
                              {
                                "has": {
                                  "stopBy": "neighbor",
                                  "nthChild": 2,
                                  "regex": "^[^_]"
                                }
                              },
                              {
                                "has": {
                                  "stopBy": "neighbor",
                                  "nthChild": "n+3",
                                  "not": {
                                    "nthChild": {
                                      "position": 1,
                                      "reverse": true
                                    }
                                  },
                                  "matches": "private-name"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.P",
        "code": "SLF001",
        "message": "Use the class's public interface instead of this private member; keep it only where the class is yours to change or the access is deliberate.",
        "suppress": {
          "noqa": {
            "codes": [
              "SLF001"
            ]
          }
        }
      }
    }
  ]
}
