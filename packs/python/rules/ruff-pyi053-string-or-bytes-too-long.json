{
  "format": "rerail.policy/v1",
  "id": "ruff-pyi053-string-or-bytes-too-long",
  "revision": 1,
  "mode": "steer",
  "description": "Replace string and bytes literals longer than 50 characters in stub files with an ellipsis; type checkers ignore default values, so a literal that long is an implementation detail.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "string-or-bytes-too-long",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "plain-str": {
              "any": [
                {
                  "kind": "string",
                  "regex": "^[rRuU]{0,2}['\\\"]",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "interpolation"
                    }
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "not": {
                        "regex": "^[rRuU]{0,2}['\\\"]"
                      }
                    }
                  }
                }
              ]
            },
            "long-part": {
              "kind": "string",
              "any": [
                {
                  "regex": "^(?:[bB]\"(?:\\\\\\r?\\n)*(?:(?:[^\\\\\"]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))(?:\\\\\\r?\\n)*){51,}\"|(?:[bB][rR]|[rR][bB])\"(?:[^\\\\\"]|\\\\\"?){51,}\"|[bB]\"\"\"(?:\\\\\\r?\\n)*(?:(?:[^\\\\]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))(?:\\\\\\r?\\n)*){51,}\"\"\"|(?:[bB][rR]|[rR][bB])\"\"\"(?:[^\\\\]|\\\\\"?){51,}\"\"\"|[bB]'(?:\\\\\\r?\\n)*(?:(?:[^\\\\']|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))(?:\\\\\\r?\\n)*){51,}'|(?:[bB][rR]|[rR][bB])'(?:[^\\\\']|\\\\'?){51,}'|[bB]'''(?:\\\\\\r?\\n)*(?:(?:[^\\\\]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|[^xabfnrtv'\\\"\\\\0-7\\r\\n]))(?:\\\\\\r?\\n)*){51,}'''|(?:[bB][rR]|[rR][bB])'''(?:[^\\\\]|\\\\'?){51,}''')$"
                },
                {
                  "regex": "^(?:[fF]\"(?:\\\\\\r?\\n)*(?:(?:[^\\\\\"]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))(?:\\\\\\r?\\n)*){51,}\"|(?:[fF][rR]|[rR][fF])\"(?:[^\\\\\"]|\\\\\"?){51,}\"|[fF]\"\"\"(?:\\\\\\r?\\n)*(?:(?:[^\\\\]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))(?:\\\\\\r?\\n)*){51,}\"\"\"|(?:[fF][rR]|[rR][fF])\"\"\"(?:[^\\\\]|\\\\\"?){51,}\"\"\"|[fF]'(?:\\\\\\r?\\n)*(?:(?:[^\\\\']|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))(?:\\\\\\r?\\n)*){51,}'|(?:[fF][rR]|[rR][fF])'(?:[^\\\\']|\\\\'?){51,}'|[fF]'''(?:\\\\\\r?\\n)*(?:(?:[^\\\\]|\\\\(?:x[0-9a-fA-F]{2}|[0-7]{1,3}|[abfnrtv'\\\"\\\\]|N\\{[^}\\r\\n]*\\}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|[^xabfnrtv'\\\"\\\\0-7NuU\\r\\n]))(?:\\\\\\r?\\n)*){51,}'''|(?:[fF][rR]|[rR][fF])'''(?:[^\\\\]|\\\\'?){51,}''')$",
                  "has": {
                    "stopBy": "end",
                    "kind": "interpolation"
                  }
                },
                {
                  "value": {
                    "regex": "^[\\s\\S]{51}"
                  },
                  "not": {
                    "regex": "^[a-zA-Z]*[tT][a-zA-Z]*['\"]"
                  }
                }
              ]
            },
            "long-literal": {
