{
  "format": "rerail.policy/v1",
  "id": "ruff-sim109-compare-with-tuple",
  "revision": 1,
  "mode": "steer",
  "description": "Use a membership test against a tuple instead of several or-chained equality checks of the same variable.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "compare-with-tuple",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "or-op": {
              "kind": "boolean_operator",
              "has": {
                "stopBy": "neighbor",
                "regex": "^or$"
              }
            },
            "eq-target": {
              "any": [
                {
                  "kind": "comparison_operator",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    },
                    "max": 3
                  },
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "identifier",
                        "precedes": {
                          "stopBy": "neighbor",
                          "regex": "^==$"
                        },
                        "pattern": "$N"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "identifier",
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "^==$"
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "eq-target"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "boolean_operator",
            "matches": "or-op",
            "not": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "or-op"
                  }
                },
                {
                  "has": {
                    "stopBy": "end",
                    "kind": "comment"
                  }
                },
                {
                  "layout": {
                    "after": {
                      "to": "token",
                      "comments": true,
                      "breaks": {
                        "eq": 0
                      }
                    }
                  },
                  "not": {
                    "layout": {
                      "after": {
                        "to": "token",
                        "breaks": {
                          "eq": 0
                        }
                      }
                    }
                  }
                }
              ]
            },
            "has": {
              "stopBy": {
                "not": {
                  "matches": "or-op"
                }
              },
              "not": {
                "any": [
                  {
                    "matches": "or-op"
                  },
                  {
                    "follows": {
                      "stopBy": "end",
                      "any": [
                        {
                          "not": {
                            "matches": "or-op"
                          },
                          "matches": "eq-target"
                        },
                        {
                          "matches": "or-op",
                          "has": {
                            "stopBy": {
                              "not": {
                                "matches": "or-op"
                              }
                            },
                            "not": {
                              "matches": "or-op"
                            },
                            "matches": "eq-target"
                          }
                        }
                      ]
                    }
                  }
                ]
              },
              "matches": "eq-target",
              "pattern": "$FIRST",
              "inside": {
                "stopBy": {
                  "not": {
                    "matches": "or-op"
                  }
                },
                "matches": "or-op",
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "or-op"
                  }
                },
                "has": {
                  "stopBy": {
                    "not": {
                      "matches": "or-op"
                    }
                  },
                  "not": {
                    "matches": "or-op"
                  },
                  "matches": "eq-target",
                  "pattern": "$SECOND",
                  "compare": {
                    "left": "SECOND",
                    "op": "ne",
                    "right": "FIRST",
                    "text": "node"
                  }
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM109",
        "message": "Replace the chained `==` comparisons of `$N` with one membership test, `$N in (...)`.",
        "each": "FIRST",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM109"
            ]
          }
        }
      }
    }
  ]
}
