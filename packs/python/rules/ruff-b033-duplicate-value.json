{
  "format": "rerail.policy/v1",
  "id": "ruff-b033-duplicate-value",
  "revision": 1,
  "mode": "steer",
  "description": "Remove duplicate literal values from Python set literals; the repeat is dropped silently and usually hides a typo, and values like True, 1 and 1.0 count as the same.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "duplicate-value",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "literal": {
              "any": [
                {
                  "kind": "string",
                  "regex": "^[rRuUbB]{0,2}['\"]"
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "not": {
                        "regex": "^[rRuUbB]{0,2}['\"]"
                      }
                    }
                  }
                },
                {
                  "kind": "integer"
                },
                {
                  "kind": "float"
                },
                {
                  "kind": "true"
                },
                {
                  "kind": "false"
                },
                {
                  "kind": "none"
                },
                {
                  "kind": "ellipsis"
                }
              ]
            },
            "literal-p": {
              "any": [
                {
                  "matches": "literal"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "literal-p"
                  }
                }
              ]
            },
            "dup-slot": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "set"
                  },
                  "count": {
                    "follows": {
                      "stopBy": "end",
                      "matches": "literal-p",
                      "pattern": "$F",
                      "compare": {
                        "left": "F",
                        "op": "eq",
                        "right": "V",
                        "text": "structure-hash"
                      }
                    },
                    "min": 1
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "dup-slot"
                  }
                }
              ]
            }
          },
          "rule": {
            "matches": "literal",
            "pattern": "$V",
            "all": [
              {
                "matches": "dup-slot"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B033",
        "message": "Remove the duplicate `$V` from this set literal.",
        "suppress": {
          "noqa": {
            "codes": [
              "B033"
            ]
          }
        }
      }
    }
  ]
}
