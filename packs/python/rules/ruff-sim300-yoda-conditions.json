{
  "format": "rerail.policy/v1",
  "id": "ruff-sim300-yoda-conditions",
  "revision": 2,
  "mode": "steer",
  "description": "Put the variable first and the constant or literal second in comparisons, avoiding Yoda conditions; it reads the way you would say it.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "yoda-conditions",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "part-t": {
              "has": {
                "stopBy": "neighbor",
                "kind": "string_start",
                "regex": "^[A-Za-z]*[tT]"
              }
            },
            "part-f": {
              "has": {
                "stopBy": "neighbor",
                "kind": "string_start",
                "regex": "^[A-Za-z]*[fF]"
              }
            },
            "t-string": {
              "any": [
                {
                  "kind": "string",
                  "matches": "part-t"
                },
                {
                  "kind": "concatenated_string",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "matches": "part-t"
                  }
                }
              ]
            },
            "f-string": {
              "not": {
                "matches": "t-string"
              },
              "any": [
                {
                  "kind": "string",
                  "matches": "part-f"
                },
                {
                  "kind": "concatenated_string",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "matches": "part-f"
                  }
                }
              ]
            },
            "plain-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "not": {
                "any": [
                  {
                    "matches": "t-string"
                  },
                  {
                    "matches": "f-string"
                  }
                ]
              }
            },
            "literal": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "integer"
                    },
                    {
                      "kind": "float"
                    },
                    {
                      "kind": "true"
                    },
                    {
                      "kind": "false"
                    },
                    {
                      "kind": "none"
                    },
                    {
                      "kind": "ellipsis"
                    }
                  ]
                },
                {
                  "matches": "plain-string"
                }
              ]
            },
            "definitely": {
              "any": [
                {
                  "any": [
                    {
                      "matches": "literal"
                    },
                    {
                      "matches": "literal"
                    },
                    {
                      "any": [
                        {
                          "kind": "tuple"
                        },
                        {
                          "kind": "list"
                        }
                      ],
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "regex": "^[\\[\\](){},]$"
                              },
                              {
                                "regex": "^:$"
                              },
                              {
                                "kind": "comment"
                              },
                              {
                                "matches": "definitely"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "dictionary",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "regex": "^[\\[\\](){},]$"
                              },
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "pair",
                                "not": {
                                  "has": {
                                    "stopBy": "neighbor",
                                    "not": {
                                      "any": [
                                        {
                                          "regex": "^[\\[\\](){},]$"
                                        },
                                        {
                                          "regex": "^:$"
                                        },
                                        {
                                          "kind": "comment"
                                        },
                                        {
                                          "matches": "definitely"
                                        }
                                      ]
                                    }
                                  }
                                }
                              },
                              {
                                "kind": "dictionary_splat",
                                "has": {
                                  "stopBy": "neighbor",
                                  "matches": "definitely"
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "binary_operator",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "regex": "^(\\+|-|\\*|/|//|%|\\*\\*|<<|>>|&|\\||\\^|@)$"
                              },
                              {
                                "matches": "definitely"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "unary_operator",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "definitely"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "definitely"
                  }
                }
              ]
            },
            "probably": {
              "any": [
                {
                  "any": [
                    {
                      "matches": "literal"
                    },
                    {
                      "any": [
                        {
                          "kind": "identifier",
                          "regex": "^\\P{Lowercase}*\\p{Uppercase}\\P{Lowercase}*$"
                        },
                        {
                          "kind": "attribute",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "identifier",
                            "regex": "^\\P{Lowercase}*\\p{Uppercase}\\P{Lowercase}*$",
                            "follows": {
                              "stopBy": "neighbor",
                              "regex": "^\\.$"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "any": [
                        {
                          "kind": "tuple"
                        },
                        {
                          "kind": "list"
                        }
                      ],
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "regex": "^[\\[\\](){},]$"
                              },
                              {
                                "regex": "^:$"
                              },
                              {
                                "kind": "comment"
                              },
                              {
                                "matches": "probably"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "dictionary",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "regex": "^[\\[\\](){},]$"
                              },
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "pair",
                                "not": {
                                  "has": {
                                    "stopBy": "neighbor",
                                    "not": {
                                      "any": [
                                        {
                                          "regex": "^[\\[\\](){},]$"
                                        },
                                        {
                                          "regex": "^:$"
                                        },
                                        {
                                          "kind": "comment"
                                        },
                                        {
                                          "matches": "probably"
                                        }
                                      ]
                                    }
                                  }
                                }
                              },
                              {
                                "kind": "dictionary_splat",
                                "has": {
                                  "stopBy": "neighbor",
                                  "matches": "probably"
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "binary_operator",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "regex": "^(\\+|-|\\*|/|//|%|\\*\\*|<<|>>|&|\\||\\^|@)$"
                              },
                              {
                                "matches": "probably"
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "unary_operator",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "probably"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "probably"
                  }
                }
              ]
            },
            "single-op": {
              "kind": "comparison_operator",
              "has": {
                "stopBy": "neighbor",
                "regex": "^(==|!=|<|<=|>|>=)$"
              },
              "count": {
                "has": {
                  "stopBy": "neighbor",
                  "regex": "^(==|!=|<|<=|>|>=|<>|in|not in|is|is not)$"
                },
                "max": 1
              }
            },
            "left": {
              "not": {
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "(?s)."
                }
              }
            },
            "right": {
              "not": {
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "(?s)."
                }
              }
            }
          },
          "rule": {
            "matches": "single-op",
            "any": [
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "left",
                      "all": [
                        {
                          "matches": "definitely"
                        }
                      ]
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "right",
                      "not": {
                        "matches": "definitely"
                      }
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "left",
                      "all": [
                        {
                          "matches": "probably"
                        }
                      ]
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "right",
                      "not": {
                        "matches": "probably"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM300",
        "message": "Put the variable first; reverse `<`/`>` and `<=`/`>=` when swapping operands, and keep equality operators unchanged.",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM300"
            ]
          }
        }
      }
    }
  ]
}
