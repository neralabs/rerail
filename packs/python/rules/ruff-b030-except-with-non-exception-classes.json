{
  "format": "rerail.policy/v1",
  "id": "ruff-b030-except-with-non-exception-classes",
  "revision": 2,
  "mode": "steer",
  "description": "Use only exception classes, or tuples of them, in except clauses; other values such as literals or expressions are not valid exception types.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "except-with-non-exception-classes",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "type-slot": {
              "any": [
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^(except|\\*)$"
                  },
                  "not": {
                    "precedes": {
                      "stopBy": "neighbor",
                      "regex": "^,$"
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "except_clause"
                  }
                },
                {
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "as_pattern",
                    "matches": "type-slot"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "type-slot"
                  }
                }
              ]
            },
            "plus": {
              "kind": "binary_operator",
              "has": {
                "stopBy": "neighbor",
                "regex": "^\\+$"
              }
            },
            "core": {
              "not": {
                "any": [
                  {
                    "kind": "parenthesized_expression"
                  },
                  {
                    "kind": "comment"
                  },
                  {
                    "regex": "^[(),*+:\\[\\]]$"
                  },
                  {
                    "kind": "as_pattern"
                  }
                ]
              }
            },
            "comma-elem": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "except_clause"
                  },
                  "any": [
                    {
                      "precedes": {
                        "stopBy": "neighbor",
                        "regex": "^,$"
                      }
                    },
                    {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "^,$"
                      }
                    }
                  ]
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "comma-elem"
                  }
                }
              ]
            },
            "queued-splat": {
              "kind": "list_splat",
              "matches": "queued"
            },
            "queued-plus": {
              "matches": "plus",
              "all": [
                {
                  "matches": "queued"
                }
              ]
            },
            "elem-of-type-tuple": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "tuple",
                    "matches": "type-slot"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "elem-of-type-tuple"
                  }
                }
              ]
            },
            "elem-of-splat-seq": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "tuple"
                      },
                      {
                        "kind": "list"
                      }
                    ],
                    "inside": {
                      "stopBy": "neighbor",
                      "matches": "queued-splat"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "elem-of-splat-seq"
                  }
                }
              ]
            },
            "value-of-queued-splat": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "queued-splat"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "value-of-queued-splat"
                  }
                }
              ]
            },
            "side-of-queued-plus": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "matches": "queued-plus"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "side-of-queued-plus"
                  }
                }
              ]
            },
            "elem-of-side-tuple": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "tuple",
                    "matches": "side-of-queued-plus"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "elem-of-side-tuple"
                  }
                }
              ]
            },
            "value-of-side-splat": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "list_splat",
                    "matches": "side-of-queued-plus"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "value-of-side-splat"
                  }
                }
              ]
            },
            "queued": {
              "matches": "core",
              "any": [
                {
                  "matches": "type-slot",
                  "not": {
                    "kind": "tuple"
                  }
                },
                {
                  "matches": "elem-of-type-tuple"
                },
                {
                  "matches": "comma-elem"
                },
                {
                  "matches": "elem-of-splat-seq"
                },
                {
                  "matches": "plus",
                  "all": [
                    {
                      "matches": "value-of-queued-splat"
                    }
                  ]
                },
                {
                  "matches": "plus",
                  "all": [
                    {
                      "matches": "side-of-queued-plus"
                    }
                  ]
                },
                {
                  "matches": "elem-of-side-tuple"
                },
                {
                  "matches": "plus",
                  "all": [
                    {
                      "matches": "value-of-side-splat"
                    }
                  ]
                }
              ]
            },
            "flat": {
              "matches": "core",
              "any": [
                {
                  "matches": "queued",
                  "not": {
                    "any": [
                      {
                        "kind": "list_splat"
                      },
                      {
                        "matches": "plus"
                      }
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "matches": "value-of-queued-splat"
                    }
                  ],
                  "not": {
                    "any": [
                      {
                        "kind": "tuple"
                      },
                      {
                        "kind": "list"
                      },
                      {
                        "matches": "plus"
                      }
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "matches": "side-of-queued-plus"
                    }
                  ],
                  "not": {
                    "any": [
                      {
                        "kind": "tuple"
                      },
                      {
                        "kind": "list_splat"
                      },
                      {
                        "matches": "plus"
                      }
                    ]
                  }
                },
                {
                  "all": [
                    {
                      "matches": "value-of-side-splat"
                    }
                  ],
                  "not": {
                    "any": [
                      {
                        "kind": "list_splat"
                      },
                      {
                        "matches": "plus"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "rule": {
            "matches": "flat",
            "not": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                },
                {
                  "kind": "subscript"
                },
                {
                  "kind": "call"
                }
              ]
            },
            "inside": {
              "stopBy": "end",
              "kind": "except_clause"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B030",
        "message": "Replace this except type with an exception class or a tuple of exception classes.",
        "suppress": {
          "noqa": {
            "codes": [
              "B030"
            ]
          }
        }
      }
    }
  ]
}
