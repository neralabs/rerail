{
  "format": "rerail.policy/v1",
  "id": "ruff-ruf005-collection-literal-concatenation",
  "revision": 1,
  "mode": "steer",
  "description": "Prefer iterable unpacking over adding a list or tuple literal to another collection with the plus operator; it reads better and accepts any iterable.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "splat-ok": {
            "any": [
              {
                "kind": "identifier"
              },
              {
                "kind": "attribute"
              },
              {
                "kind": "call"
              },
              {
                "kind": "subscript",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "slice"
                },
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^,$"
                  }
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "splat-ok"
                }
              }
            ]
          },
          "list-expr": {
            "any": [
              {
                "kind": "list"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "list-expr"
                }
              },
              {
                "matches": "list-add"
              }
            ]
          },
          "tuple-expr": {
            "any": [
              {
                "kind": "tuple"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "tuple-expr"
                }
              },
              {
                "matches": "tuple-add"
              }
            ]
          },
          "list-add": {
            "kind": "binary_operator",
            "has": {
              "stopBy": "neighbor",
              "regex": "^\\+$"
            },
            "any": [
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "list-expr",
                      "precedes": {
                        "stopBy": "end",
                        "regex": "^\\+$"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "list-or-splat",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^\\+$"
                      }
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "splat-ok",
                      "precedes": {
                        "stopBy": "end",
                        "regex": "^\\+$"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "list-expr",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^\\+$"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "list-or-splat": {
            "any": [
              {
                "matches": "splat-ok"
              },
              {
                "matches": "list-expr"
              }
            ]
          },
          "tuple-add": {
            "kind": "binary_operator",
            "has": {
              "stopBy": "neighbor",
              "regex": "^\\+$"
            },
            "any": [
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "tuple-expr",
                      "precedes": {
                        "stopBy": "end",
                        "regex": "^\\+$"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "tuple-or-splat",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^\\+$"
                      }
                    }
                  }
                ]
              },
              {
                "all": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "splat-ok",
                      "precedes": {
                        "stopBy": "end",
                        "regex": "^\\+$"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "tuple-expr",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^\\+$"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "tuple-or-splat": {
            "any": [
              {
                "matches": "splat-ok"
              },
              {
                "matches": "tuple-expr"
              }
            ]
          },
          "concat-core": {
            "kind": "binary_operator",
            "any": [
              {
                "matches": "list-add"
              },
              {
                "matches": "tuple-add"
              }
            ]
          },
          "concat": {
            "matches": "concat-core",
            "not": {
              "inside": {
                "stopBy": {
                  "not": {
                    "kind": "parenthesized_expression"
                  }
                },
                "kind": "binary_operator",
                "has": {
                  "stopBy": "neighbor",
                  "regex": "^\\+$"
                }
              }
            }
          },
          "plus-op": {
            "kind": "binary_operator",
            "has": {
              "stopBy": "neighbor",
              "regex": "^\\+$"
            }
          },
          "outer-operand": {
            "any": [
              {
                "matches": "concat-core",
                "pattern": "$E"
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "outer-operand"
                }
              }
            ]
          },
          "type-string": {
            "any": [
              {
                "kind": "string"
              },
              {
                "kind": "concatenated_string"
              }
            ],
            "parse": {
              "grammar": "annotation",
              "has": {
                "stopBy": "end",
                "any": [
                  {
                    "matches": "concat",
                    "capture": "E"
                  },
                  {
                    "matches": "type-string"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "id": "collection-literal-concatenation",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "not": {
              "any": [
                {
                  "matches": "plus-op"
                },
                {
                  "kind": "parenthesized_expression"
                }
              ]
            },
            "has": {
              "stopBy": "neighbor",
              "matches": "outer-operand"
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.E",
        "code": "RUF005",
        "message": "Write one literal with unpacking, such as `[*a, 1, *b]` or `(*a, 1)`, instead of adding collections with `+`. Keep `+` if an operand defines its own `__add__`.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF005"
            ]
          }
        },
        "each": "E"
      }
    },
    {
      "id": "collection-literal-concatenation-in-string-type",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "type-string"
          }
        }
      },
      "violation": {
        "anchor": "capture.E",
        "code": "RUF005",
        "message": "Write one literal with unpacking, such as `[*a, 1, *b]` or `(*a, 1)`, instead of adding collections with `+`. Keep `+` if an operand defines its own `__add__`.",
        "suppress": {
          "noqa": {
            "codes": [
              "RUF005"
            ]
          }
        },
        "each": "E"
      }
    }
  ]
}
