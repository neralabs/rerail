{
  "format": "rerail.policy/v1",
  "id": "bandit:b110",
  "revision": 1,
  "mode": "steer",
  "description": "Detect exception handlers whose only action is pass, silently discarding errors that can hide failures or attempted disruption. Handle or log the exception, or catch a specific expected exception when suppression is intentional.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "try-except-pass",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "except_clause",
            "all": [
              {
                "any": [
                  {
                    "pattern": {
                      "context": "try:\n    work()\nexcept:\n    pass",
                      "selector": "except_clause"
                    }
                  },
                  {
                    "has": {
                      "matches": "exception-type",
                      "stopBy": "neighbor"
                    }
                  },
                  {
                    "has": {
                      "matches": "exception-alias",
                      "stopBy": "neighbor"
                    }
                  }
                ]
              },
              {
                "has": {
                  "kind": "block",
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "has": {
                        "kind": "pass_statement",
                        "stopBy": "neighbor"
                      }
                    },
                    {
                      "count": {
                        "has": {
                          "pattern": "$_",
                          "stopBy": "neighbor"
                        },
                        "min": 1,
                        "max": 1
                      }
                    }
                  ]
                }
              }
            ]
          },
          "utils": {
            "exception-type": {
              "any": [
                {
                  "pattern": "Exception"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "exception-type",
                    "stopBy": "neighbor"
                  }
                }
              ]
            },
            "exception-alias": {
              "kind": "as_pattern",
              "has": {
                "matches": "exception-type",
                "stopBy": "neighbor"
              }
            }
          }
        }
      },
      "violation": {
        "code": "B110",
        "anchor": "witness.span",
        "message": "This exception is silently discarded with pass. Handle or log it, or catch a specific expected exception when suppression is intentional.",
        "suppress": {
          "nosec": {
            "codes": [
              "B110"
            ]
          }
        }
      }
    }
  ]
}
