{
  "format": "rerail.policy/v1",
  "id": "ruff-d102-undocumented-public-method",
  "revision": 1,
  "mode": "steer",
  "description": "Document each public Python method with a docstring describing its behavior, arguments and return value.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "undocumented-public-method",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {
            "module": { "notRegex": "(?:^|\\.)(?:_|_[^_.][^.]*|__[^.]*[^_.]_?)(?:\\.|$)" },
            "path": { "notRegex": "\\.pyi$" }
          },
          "utils": {
            "doc-string": {
              "any": [
                { "kind": "string", "not": { "has": { "stopBy": "neighbor", "kind": "string_start", "regex": "[bBfFtT]" } } },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "has": { "stopBy": "neighbor", "kind": "string_start", "regex": "[bBfFtT]" }
                    }
                  }
                },
                { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "doc-string" } }
              ]
            },
            "docstring": {
              "kind": "expression_statement",
              "all": [
                { "not": { "follows": { "stopBy": "end", "not": { "kind": "comment" } } } },
                { "has": { "stopBy": "neighbor", "matches": "doc-string" } },
                { "not": { "has": { "stopBy": "neighbor", "regex": "^,$" } } }
              ]
            },
            "all-stmt": {
              "any": [{ "kind": "assignment" }, { "kind": "augmented_assignment" }],
              "inside": { "stopBy": "neighbor", "kind": "expression_statement" },
              "has": { "stopBy": "neighbor", "field": "left", "regex": "^[(\\s]*__all__[\\s)]*$" }
            },
            "all-value": {
              "any": [
                { "inside": { "stopBy": "neighbor", "field": "right", "matches": "all-stmt" } },
                { "inside": { "stopBy": "neighbor", "field": "right", "kind": "assignment", "matches": "all-value" } },
                { "inside": { "stopBy": "neighbor", "kind": "parenthesized_expression", "matches": "all-value" } },
                { "inside": { "stopBy": "neighbor", "field": "left", "kind": "binary_operator", "matches": "all-value" } }
              ]
            },
            "all-list": {
              "any": [
                { "matches": "all-value" },
                { "inside": { "stopBy": "neighbor", "field": "right", "kind": "binary_operator", "matches": "all-value" } },
                { "inside": { "stopBy": "neighbor", "kind": "parenthesized_expression", "matches": "all-list" } },
                { "inside": { "stopBy": "neighbor", "field": "value", "kind": "named_expression", "matches": "all-list" } }
              ]
            },
            "list-arg": {
              "any": [
                { "inside": { "stopBy": "neighbor", "kind": "parenthesized_expression", "matches": "list-arg" } },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "argument_list",
                    "count": {
                      "has": { "stopBy": "neighbor", "not": { "any": [{ "regex": "^[(),]$" }, { "kind": "comment" }] } },
                      "max": 1
                    },
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "call",
                      "matches": "all-list",
                      "has": {
                        "stopBy": "neighbor",
                        "field": "function",
                        "any": [
                          { "kind": "subscript", "has": { "stopBy": "neighbor", "field": "value", "matches": "list-func" } },
                          { "matches": "list-func" }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "list-func": {
              "any": [{ "kind": "identifier" }, { "kind": "attribute" }],
              "resolves": { "global": ["list", "tuple"], "import": ["builtins.list", "builtins.tuple"] }
            },
            "all-entry": {
              "any": [
                { "inside": { "stopBy": "neighbor", "kind": "parenthesized_expression", "matches": "all-entry" } },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [{ "kind": "list" }, { "kind": "tuple" }, { "kind": "expression_list" }],
                    "matches": "all-list"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [{ "kind": "list" }, { "kind": "tuple" }, { "kind": "set" }],
                    "matches": "list-arg"
                  }
                }
              ]
            },
            "listed": {
              "any": [
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "kind": "module",
                      "has": {
                        "stopBy": { "any": [{ "kind": "function_definition" }, { "kind": "class_definition" }] },
                        "matches": "all-stmt"
                      }
                    }
                  }
                },
                { "binds": { "exported": true } },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "module",
                    "has": {
                      "stopBy": { "any": [{ "kind": "function_definition" }, { "kind": "class_definition" }] },
                      "kind": "string",
                      "pattern": "$S",
                      "compare": { "left": "S", "op": "eq", "right": "C", "text": "unquoted" },
                      "matches": "all-entry"
                    }
                  }
                }
              ]
            },
            "exempt-decorator": {
              "any": [
                {
                  "any": [{ "kind": "identifier" }, { "kind": "attribute" }],
                  "resolves": {
                    "import": [
                      "typing.overload",
                      "typing.override",
                      "typing_extensions.overload",
                      "typing_extensions.override",
                      "_typeshed.overload",
                      "_typeshed.override"
                    ]
                  }
                },
                {
                  "kind": "attribute",
                  "has": { "stopBy": "neighbor", "field": "attribute", "regex": "^(?:setter|deleter)$" },
                  "all": [{ "has": { "stopBy": "neighbor", "field": "object", "matches": "own-name" } }]
                },
                { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "exempt-decorator" } }
              ]
            },
            "own-name": {
              "any": [
                { "kind": "identifier", "pattern": "$N" },
                { "kind": "parenthesized_expression", "has": { "stopBy": "neighbor", "matches": "own-name" } }
              ]
            }
          },
          "rule": {
            "kind": "identifier",
            "pattern": "$N",
            "regex": "^(?:[^_]|__(?:new|call)__$)",
            "inside": {
              "stopBy": "neighbor",
              "field": "name",
              "kind": "function_definition",
              "all": [
                {
                  "inside": {
                    "stopBy": { "any": [{ "kind": "function_definition" }, { "kind": "class_definition" }] },
                    "kind": "class_definition"
                  }
                },
                { "not": { "inside": { "stopBy": "end", "kind": "function_definition" } } },
                {
                  "not": {
                    "inside": {
                      "stopBy": "end",
                      "kind": "class_definition",
                      "has": { "stopBy": "neighbor", "field": "name", "regex": "^_" }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "end",
                    "kind": "class_definition",
                    "not": { "inside": { "stopBy": "end", "kind": "class_definition" } },
                    "has": { "stopBy": "neighbor", "field": "name", "pattern": "$C", "matches": "listed" }
                  }
                },
                {
                  "not": {
                    "has": { "stopBy": "neighbor", "field": "body", "has": { "stopBy": "neighbor", "matches": "docstring" } }
                  }
                },
                {
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "decorated_definition",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "decorator",
                        "has": { "stopBy": "neighbor", "matches": "exempt-decorator" }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "D102",
        "message": "Add a docstring as the first statement of method `$N` describing what it does, its arguments and return value; if it overrides a documented base method, decorate it with `@override` instead.",
        "suppress": { "noqa": { "codes": ["D102"] } }
      }
    }
  ]
}
