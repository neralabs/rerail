{
  "format": "rerail.policy/v1",
  "id": "bandit:b507",
  "revision": 4,
  "mode": "steer",
  "description": "Once an import whose name contains paramiko has been walked (Bandit's substring test, in Bandit's source-order walk), flag a call whose function name is set_missing_host_key_policy (the attribute name, a bare name, or a name aliased by an earlier import to one ending in set_missing_host_key_policy) and whose first positional argument is a name, attribute, or call naming AutoAddPolicy or WarningPolicy.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "b507",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "paramiko-import": {
              "any": [
                {
                  "kind": "import_statement"
                },
                {
                  "kind": "import_from_statement"
                },
                {
                  "kind": "future_import_statement"
                }
              ],
              "has": {
                "stopBy": "end",
                "kind": "dotted_name",
                "regex": "paramiko"
              }
            },
            "after-paramiko-import": {
              "inside": {
                "stopBy": "end",
                "follows": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "paramiko-import"
                    },
                    {
                      "has": {
                        "stopBy": "end",
                        "matches": "paramiko-import"
                      }
                    }
                  ]
                }
              }
            },
            "alias-to-target": {
              "kind": "aliased_import",
              "all": [
                {
                  "has": {
                    "field": "alias",
                    "pattern": "$ALIAS"
                  }
                },
                {
                  "has": {
                    "field": "name",
                    "regex": "(?:^|\\.)\\s*set_missing_host_key_policy$"
                  }
                }
              ]
            },
            "after-alias-to-target": {
              "inside": {
                "stopBy": "end",
                "follows": {
                  "stopBy": "end",
                  "has": {
                    "stopBy": "end",
                    "matches": "alias-to-target"
                  }
                }
              }
            },
            "target-callee": {
              "any": [
                {
                  "kind": "attribute",
                  "has": {
                    "field": "attribute",
                    "regex": "^set_missing_host_key_policy$"
                  }
                },
                {
                  "kind": "identifier",
                  "regex": "^set_missing_host_key_policy$"
                },
                {
                  "kind": "identifier",
                  "pattern": "$ALIAS",
                  "matches": "after-alias-to-target"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "target-callee"
                  }
                }
              ]
            },
            "policy-name": {
              "any": [
                {
                  "kind": "attribute",
                  "has": {
                    "field": "attribute",
                    "regex": "^(?:AutoAddPolicy|WarningPolicy)$"
                  }
                },
                {
                  "kind": "identifier",
                  "regex": "^(?:AutoAddPolicy|WarningPolicy)$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "policy-name"
                  }
                }
              ]
            },
            "trusting-policy": {
              "any": [
                {
                  "matches": "policy-name"
                },
                {
                  "kind": "call",
                  "has": {
                    "field": "function",
                    "matches": "policy-name"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "trusting-policy"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "arguments": {
              "signature": [
                "policy",
                "/"
              ],
              "bind": {
                "POLICY": "policy"
              },
              "mode": "syntactic"
            },
            "all": [
              {
                "has": {
                  "field": "arguments",
                  "has": {
                    "matches": "trusting-policy"
                  }
                }
              },
              {
                "has": {
                  "field": "function",
                  "matches": "target-callee"
                }
              },
              {
                "matches": "after-paramiko-import"
              }
            ]
          },
          "constraints": {
            "POLICY": {
              "matches": "trusting-policy"
            }
          }
        }
      },
      "violation": {
        "code": "B507",
        "anchor": "witness.span",
        "message": "Paramiko call with policy set to automatically trust the unknown host key."
      }
    }
  ]
}
