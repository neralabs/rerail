{
  "format": "rerail.policy/v1",
  "id": "ruff-f602-multi-value-repeated-key-variable",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid repeating the same variable as a key in a Python dict literal; the later value silently overwrites the earlier one.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "multi-value-repeated-key-variable",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "dict-key": {
              "any": [
                {
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "pair"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "dict-key"
                  }
                }
              ]
            },
            "earlier-same": {
              "any": [
                {
                  "not": {
                    "kind": "parenthesized_expression"
                  },
                  "pattern": "$EARLIER",
                  "kind": "identifier",
                  "compare": {
                    "left": "EARLIER",
                    "op": "eq",
                    "right": "KEY"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "earlier-same"
                  }
                }
              ]
            }
          },
          "rule": {
            "all": [
              {
                "pattern": "$KEY"
              },
              {
                "not": {
                  "kind": "parenthesized_expression"
                }
              },
              {
                "kind": "identifier"
              },
              {
                "matches": "dict-key"
              },
              {
                "inside": {
                  "stopBy": {
                    "kind": "pair"
                  },
                  "kind": "pair",
                  "follows": {
                    "stopBy": "end",
                    "kind": "pair",
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "follows": {
                          "stopBy": "neighbor",
                          "regex": "(?s)."
                        }
                      },
                      "matches": "earlier-same"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F602",
        "message": "Dictionary key `$KEY` repeated",
        "suppress": {
          "noqa": {
            "codes": [
              "F602"
            ]
          }
        }
      }
    }
  ]
}
