{
  "format": "rerail.policy/v1",
  "id": "ruff-f701-break-outside-loop",
  "revision": 1,
  "mode": "steer",
  "description": "Keep break inside a for or while loop body; outside one (including a loop's else block) it is a Python syntax error.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "break-outside-loop",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "break_statement",
            "not": {
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "kind": "block",
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "for_statement"
                    },
                    {
                      "kind": "while_statement"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F701",
        "message": "`break` outside loop",
        "suppress": {
          "noqa": {
            "codes": [
              "F701"
            ]
          }
        }
      }
    }
  ]
}
