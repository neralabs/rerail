{
  "format": "rerail.policy/v1",
  "id": "ruff-up039-unnecessary-class-parentheses",
  "revision": 1,
  "mode": "steer",
  "description": "Remove empty parentheses after a class name; they are unnecessary when the class has no base classes or keywords.",
  "scope": {
    "include": ["**/*"],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-class-parentheses",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "argument_list",
            "inside": {
              "stopBy": "neighbor",
              "kind": "class_definition",
              "field": "superclasses"
            },
            "not": {
              "has": {
                "stopBy": "neighbor",
                "regex": "(?s).",
                "not": {
                  "any": [
                    { "regex": "^[()]$" },
                    { "kind": "comment" },
                    { "kind": "line_continuation" }
                  ]
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "UP039",
        "message": "Write the class header without the empty parentheses (`class Name:` instead of `class Name():`); if a comment sits inside them, keep it on its own line.",
        "suppress": { "noqa": { "codes": ["UP039"] } }
      }
    }
  ]
}
