{
  "format": "rerail.policy/v1",
  "id": "ruff-b007-unused-loop-control-variable",
  "revision": 1,
  "mode": "steer",
  "description": "Rename for-loop variables the loop body never uses to start with an underscore; it shows the value is deliberately ignored.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "in-target": {
            "any": [
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^in$"
                },
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "for_statement",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "has": {
                        "stopBy": "end",
                        "kind": "identifier",
                        "pattern": "$NAME",
                        "not": {
                          "matches": "not-a-name"
                        }
                      }
                    }
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "pattern_list"
                    },
                    {
                      "kind": "tuple_pattern"
                    },
                    {
                      "kind": "list_pattern"
                    },
                    {
                      "kind": "list_splat_pattern"
                    },
                    {
                      "kind": "parenthesized_expression"
                    }
                  ],
                  "matches": "in-target"
                }
              }
            ]
          },
          "magic": {
            "kind": "call",
            "has": {
              "stopBy": "neighbor",
              "kind": "identifier",
              "regex": "^(locals|globals|vars|exec|eval)$",
              "precedes": {
                "stopBy": "neighbor",
                "kind": "argument_list"
              }
            }
          },
          "not-a-name": {
            "any": [
              {
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "^\\.$"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "keyword_argument"
                },
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^=$"
                }
              },
              {
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "^(def|class)$"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "parameters"
                    },
                    {
                      "kind": "lambda_parameters"
                    }
                  ]
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "default_parameter"
                    },
                    {
                      "kind": "typed_parameter"
                    },
                    {
                      "kind": "typed_default_parameter"
                    }
                  ],
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "parameters"
                      },
                      {
                        "kind": "lambda_parameters"
                      }
                    ]
                  }
                },
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^[=:]$"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "list_splat_pattern"
                    },
                    {
                      "kind": "dictionary_splat_pattern"
                    }
                  ],
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "parameters"
                      },
                      {
                        "kind": "lambda_parameters"
                      },
                      {
                        "kind": "typed_parameter"
                      }
                    ]
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "dotted_name",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^\\.$"
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "case_pattern"
                      },
                      {
                        "kind": "keyword_pattern"
                      }
                    ]
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "keyword_pattern"
                },
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^=$"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "splat_pattern"
                }
              },
              {
                "follows": {
                  "stopBy": "neighbor",
                  "regex": "^as$"
                },
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "as_pattern",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "case_pattern"
                  }
                }
              },
              {
                "inside": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "import_statement"
                    },
                    {
                      "kind": "import_from_statement"
                    },
                    {
                      "kind": "future_import_statement"
                    },
                    {
                      "kind": "global_statement"
                    },
                    {
                      "kind": "nonlocal_statement"
                    }
                  ]
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "as_pattern_target",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "as_pattern",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "except_clause"
                    }
                  }
                }
              }
            ]
          },
          "uncertain": {
            "inside": {
              "stopBy": {
                "kind": "for_statement"
              },
              "kind": "for_statement",
              "has": {
                "stopBy": "neighbor",
                "kind": "block",
                "has": {
                  "stopBy": "end",
                  "matches": "magic"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "unused-loop-control-variable",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "all": [
              {
                "pattern": "$NAME"
              },
              {
                "not": {
                  "regex": "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$"
                }
              },
              {
                "matches": "in-target"
              },
              {
                "not": {
                  "matches": "uncertain"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B007",
        "message": "Rename `$NAME` to `_$NAME`; the loop body never uses it.",
        "suppress": {
          "noqa": {
            "codes": [
              "B007"
            ]
          }
        }
      }
    },
    {
      "id": "unused-loop-control-variable-uncertain",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "all": [
              {
                "pattern": "$NAME"
              },
              {
                "not": {
                  "regex": "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$"
                }
              },
              {
                "matches": "in-target"
              },
              {
                "matches": "uncertain"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B007",
        "message": "Rename `$NAME` to `_$NAME` unless the loop body reads it through `locals()`, `eval` or similar.",
        "suppress": {
          "noqa": {
            "codes": [
              "B007"
            ]
          }
        }
      }
    }
  ]
}