{
  "format": "rerail.policy/v1",
  "id": "ruff-f524-string-dot-format-missing-arguments",
  "revision": 1,
  "mode": "steer",
  "description": "Pass an argument for every placeholder in a str.format() string; a missing one raises IndexError or KeyError at runtime.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "string-dot-format-missing-arguments",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$S.format($$$A)",
            "formatArgs": {
              "style": "brace",
              "string": "S",
              "args": "A",
              "missing": {
                "kind": "field"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F524",
        "message": "`.format` call is missing argument(s) for placeholder(s)",
        "suppress": {
          "noqa": {
            "codes": [
              "F524"
            ]
          }
        }
      }
    }
  ]
}
