{
  "format": "rerail.policy/v1",
  "id": "ruff-f524-string-dot-format-missing-arguments",
  "revision": 1,
  "mode": "steer",
  "description": "Pass an argument for every placeholder in a str.format() string; a missing one raises IndexError or KeyError at runtime.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "string-dot-format-missing-arguments",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "$S.format($$$A)",
                "formatArgs": {
                  "style": "brace",
                  "string": "S",
                  "args": "A",
                  "missing": {
                    "kind": "field"
                  }
                }
              },
              {
                "kind": "call",
                "has": {
                  "field": "arguments",
                  "kind": "generator_expression"
                },
                "all": [
                  {
                    "has": {
                      "field": "function",
                      "kind": "attribute",
                      "has": {
                        "field": "attribute",
                        "regex": "^format$"
                      }
                    }
                  },
                  {
                    "has": {
                      "field": "function",
                      "has": {
                        "field": "object",
                        "matches": "reads-past-one"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "utils": {
            "plain-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                    }
                  }
                }
              ]
            },
            "reads-past-one": {
              "any": [
                {
                  "matches": "plain-string",
                  "parse": {
                    "grammar": "braceFormat",
                    "not": {
                      "has": {
                        "kind": "error"
                      }
                    },
                    "has": {
                      "stopBy": "end",
                      "kind": "field_name",
                      "not": {
                        "value": {
                          "eq": 0
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "reads-past-one"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F524",
        "message": "`.format` call is missing argument(s) for placeholder(s)",
        "suppress": {
          "noqa": {
            "codes": [
              "F524"
            ]
          }
        }
      }
    }
  ]
}
