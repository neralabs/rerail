{
  "format": "rerail.policy/v1",
  "id": "ruff-n807-dunder-function-name",
  "revision": 1,
  "mode": "steer",
  "description": "Don't name a function with leading and trailing double underscores; that naming is reserved for Python's special methods.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "dunder-function-name",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "in-function-scope": {
              "kind": "function_definition",
              "not": {
                "inside": {
                  "stopBy": {
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  },
                  "kind": "class_definition"
                }
              }
            },
            "at-module-scope": {
              "kind": "function_definition",
              "not": {
                "inside": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "kind": "identifier",
            "pattern": "$NAME",
            "all": [
              {
                "regex": "^_[_\\x{FE33}\\x{FE34}\\x{FE4D}-\\x{FE4F}\\x{FF3F}]"
              },
              {
                "regex": "[_\\x{FE33}\\x{FE34}\\x{FE4D}-\\x{FE4F}\\x{FF3F}]{2}$"
              }
            ],
            "inside": {
              "stopBy": "neighbor",
              "field": "name",
              "kind": "function_definition",
              "matches": "in-function-scope"
            },
            "not": {
              "all": [
                {
                  "regex": "^_[_\\x{FE33}\\x{FE34}\\x{FE4D}\\x{FE4E}\\x{FE4F}\\x{FF3F}](?:[g\\x{1D4D}\\x{210A}\\x{FF47}\\x{1D420}\\x{1D454}\\x{1D488}\\x{1D4F0}\\x{1D524}\\x{1D558}\\x{1D58C}\\x{1D5C0}\\x{1D5F4}\\x{1D628}\\x{1D65C}\\x{1D690}][e\\x{1D49}\\x{2091}\\x{212F}\\x{2147}\\x{FF45}\\x{1D41E}\\x{1D452}\\x{1D486}\\x{1D4EE}\\x{1D522}\\x{1D556}\\x{1D58A}\\x{1D5BE}\\x{1D5F2}\\x{1D626}\\x{1D65A}\\x{1D68E}][t\\x{1D57}\\x{209C}\\x{FF54}\\x{1D42D}\\x{1D461}\\x{1D495}\\x{1D4C9}\\x{1D4FD}\\x{1D531}\\x{1D565}\\x{1D599}\\x{1D5CD}\\x{1D601}\\x{1D635}\\x{1D669}\\x{1D69D}][a\\x{AA}\\x{1D43}\\x{2090}\\x{FF41}\\x{1D41A}\\x{1D44E}\\x{1D482}\\x{1D4B6}\\x{1D4EA}\\x{1D51E}\\x{1D552}\\x{1D586}\\x{1D5BA}\\x{1D5EE}\\x{1D622}\\x{1D656}\\x{1D68A}][t\\x{1D57}\\x{209C}\\x{FF54}\\x{1D42D}\\x{1D461}\\x{1D495}\\x{1D4C9}\\x{1D4FD}\\x{1D531}\\x{1D565}\\x{1D599}\\x{1D5CD}\\x{1D601}\\x{1D635}\\x{1D669}\\x{1D69D}][t\\x{1D57}\\x{209C}\\x{FF54}\\x{1D42D}\\x{1D461}\\x{1D495}\\x{1D4C9}\\x{1D4FD}\\x{1D531}\\x{1D565}\\x{1D599}\\x{1D5CD}\\x{1D601}\\x{1D635}\\x{1D669}\\x{1D69D}][r\\x{2B3}\\x{1D63}\\x{FF52}\\x{1D42B}\\x{1D45F}\\x{1D493}\\x{1D4C7}\\x{1D4FB}\\x{1D52F}\\x{1D563}\\x{1D597}\\x{1D5CB}\\x{1D5FF}\\x{1D633}\\x{1D667}\\x{1D69B}]|[d\\x{1D48}\\x{2146}\\x{217E}\\x{FF44}\\x{1D41D}\\x{1D451}\\x{1D485}\\x{1D4B9}\\x{1D4ED}\\x{1D521}\\x{1D555}\\x{1D589}\\x{1D5BD}\\x{1D5F1}\\x{1D625}\\x{1D659}\\x{1D68D}][i\\x{1D62}\\x{2071}\\x{2139}\\x{2148}\\x{2170}\\x{FF49}\\x{1D422}\\x{1D456}\\x{1D48A}\\x{1D4BE}\\x{1D4F2}\\x{1D526}\\x{1D55A}\\x{1D58E}\\x{1D5C2}\\x{1D5F6}\\x{1D62A}\\x{1D65E}\\x{1D692}][r\\x{2B3}\\x{1D63}\\x{FF52}\\x{1D42B}\\x{1D45F}\\x{1D493}\\x{1D4C7}\\x{1D4FB}\\x{1D52F}\\x{1D563}\\x{1D597}\\x{1D5CB}\\x{1D5FF}\\x{1D633}\\x{1D667}\\x{1D69B}])[_\\x{FE33}\\x{FE34}\\x{FE4D}\\x{FE4E}\\x{FE4F}\\x{FF3F}][_\\x{FE33}\\x{FE34}\\x{FE4D}\\x{FE4E}\\x{FE4F}\\x{FF3F}]$"
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "name",
                    "matches": "at-module-scope"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "N807",
        "message": "Rename `$NAME` without the leading and trailing double underscores and update its callers; only a method of a class should use such a name.",
        "suppress": {
          "noqa": {
            "codes": [
              "N807"
            ]
          }
        }
      }
    }
  ]
}
