{
  "format": "rerail.policy/v1",
  "id": "ruff-pyi012-pass-in-class-body",
  "revision": 1,
  "mode": "steer",
  "description": "Remove pass statements from class bodies in stub files that already contain other statements; they do nothing there.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "pass-in-class-body",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "filler": {
              "any": [
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                },
                {
                  "regex": "^;$"
                }
              ]
            }
          },
          "rule": {
            "kind": "pass_statement",
            "inside": {
              "stopBy": "neighbor",
              "kind": "block",
              "inside": {
                "stopBy": "neighbor",
                "field": "body",
                "kind": "class_definition"
              }
            },
            "all": [
              {
                "any": [
                  {
                    "follows": {
                      "stopBy": "end",
                      "not": {
                        "matches": "filler"
                      }
                    }
                  },
                  {
                    "precedes": {
                      "stopBy": "end",
                      "not": {
                        "matches": "filler"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "file": {
            "path": {
              "regex": "\\.pyi$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PYI012",
        "message": "Delete this `pass`; the class body already has other statements, so it is redundant in a stub.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI012"
            ]
          }
        }
      }
    }
  ]
}
