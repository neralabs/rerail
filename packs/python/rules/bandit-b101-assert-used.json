{
  "format": "rerail.policy/v1",
  "id": "bandit-b101-assert-used",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid assert statements in Python code; they are stripped when Python runs with optimization, so any check they perform silently disappears.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "assert-used",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "assert_statement"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B101",
        "message": "Bandit B101 (assert-used)",
        "suppress": {
          "nosec": {
            "codes": [
              "B101"
            ]
          }
        }
      }
    }
  ]
}
