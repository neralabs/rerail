{
  "format": "rerail.policy/v1",
  "id": "bandit-b303-md5",
  "revision": 1,
  "mode": "steer",
  "description": "An MD2, MD4, MD5 or SHA1 hash from PyCrypto, PyCryptodome or cryptography. `hashlib` is Bandit's B324, which this pack does not include.",
  "scope": {
    "include": [
      "**/*.py",
      "**/*.pyi"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/.yarn/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js"
    ]
  },
  "clauses": [
    {
      "id": "weak-hash",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "call",
            "has": {
              "field": "function",
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "Crypto.Hash.MD2.new",
                  "Crypto.Hash.MD4.new",
                  "Crypto.Hash.MD5.new",
                  "Crypto.Hash.SHA.new",
                  "Cryptodome.Hash.MD2.new",
                  "Cryptodome.Hash.MD4.new",
                  "Cryptodome.Hash.MD5.new",
                  "Cryptodome.Hash.SHA.new",
                  "cryptography.hazmat.primitives.hashes.MD5",
                  "cryptography.hazmat.primitives.hashes.SHA1"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B303",
        "message": "MD5 and SHA1 are broken for security use. Use SHA-256, or a password hash for passwords.",
        "suppress": {
          "nosec": {
            "codes": [
              "B303"
            ]
          }
        }
      }
    }
  ]
}
