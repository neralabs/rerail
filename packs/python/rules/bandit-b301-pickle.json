{
  "format": "rerail.policy/v1",
  "id": "bandit-b301-pickle",
  "revision": 1,
  "mode": "steer",
  "description": "Detect calls to pickle and related unsafe deserialization APIs.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unsafe-deserialization",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "pickle.loads",
                  "pickle.load",
                  "pickle.Unpickler",
                  "dill.loads",
                  "dill.load",
                  "dill.Unpickler",
                  "shelve.open",
                  "shelve.DbfilenameShelf",
                  "jsonpickle.decode",
                  "jsonpickle.unpickler.decode",
                  "jsonpickle.unpickler.Unpickler",
                  "pandas.read_pickle"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B301",
        "anchor": "witness.span",
        "message": "Pickle or a related deserialization API can be unsafe when used with untrusted data.",
        "suppress": {
          "nosec": {
            "codes": [
              "B301"
            ]
          }
        }
      }
    }
  ]
}
