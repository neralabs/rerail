{
 "format": "rerail.policy/v1",
 "id": "ruff-async115-async-zero-sleep",
 "revision": 1,
 "mode": "steer",
 "description": "Use lowlevel.checkpoint() instead of sleep(0) in trio and anyio code; it states the intent of yielding to the scheduler.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
