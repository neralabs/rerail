         {
          "kind": "integer"
         },
         {
          "kind": "float"
         }
        ],
        "value": {
         "type": "int",
         "eq": 0
        }
       },
       {
        "kind": "parenthesized_expression",
        "has": {
         "stopBy": "neighbor",
         "matches": "number"
        }
       }
      ]
     }
    }
   }
  },
