{
  "format": "rerail.policy/v1",
  "id": "ruff-ret508-superfluous-else-break",
  "revision": 1,
  "mode": "steer",
  "description": "Remove the else or elif after an if branch that breaks out of the loop, and dedent its code; the branch already exits the loop.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "superfluous-else-break-elif",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "analysed-function": {
              "kind": "function_definition",
              "all": [
                {
                  "not": {
                    "has": {
                      "stopBy": {
                        "any": [
                          {
                            "kind": "function_definition"
                          },
                          {
                            "kind": "class_definition"
                          }
                        ]
                      },
                      "kind": "yield"
                    }
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "return_statement"
                      },
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "kind": "return_statement"
                              },
                              {
                                "kind": "comment"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "none-literal": {
              "any": [
                {
                  "kind": "none"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "none-literal"
                  }
                }
              ]
            },
            "value-return": {
              "kind": "return_statement",
              "has": {
                "stopBy": "neighbor",
                "regex": "(?s).",
                "not": {
                  "any": [
                    {
                      "regex": "^return$"
                    },
                    {
                      "kind": "comment"
                    },
                    {
                      "matches": "none-literal"
                    }
                  ]
                }
              }
            },
            "own-return": {
              "kind": "return_statement"
            },
            "has-result": {
              "has": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "matches": "value-return"
              }
            }
          },
          "rule": {
            "kind": "elif_clause",
            "not": {
              "follows": {
                "stopBy": "end",
                "any": [
                  {
                    "kind": "elif_clause"
                  },
                  {
                    "kind": "else_clause"
                  }
                ]
              }
            },
            "inside": {
              "stopBy": "neighbor",
              "kind": "if_statement",
              "has": {
                "stopBy": "neighbor",
                "kind": "block",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "break_statement",
                  "not": {
                    "follows": {
                      "stopBy": "end",
                      "any": [
                        {
                          "kind": "return_statement"
                        },
                        {
                          "kind": "raise_statement"
                        },
                        {
                          "kind": "continue_statement"
                        }
                      ]
                    }
                  }
                }
              },
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "kind": "function_definition",
                "all": [
                  {
                    "matches": "analysed-function"
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RET508",
        "message": "Unnecessary `elif` after `break` statement",
        "suppress": {
          "noqa": {
            "codes": [
              "RET508"
            ]
          }
        }
      }
    },
