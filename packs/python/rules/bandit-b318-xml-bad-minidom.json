{
  "format": "rerail.policy/v1",
  "id": "bandit-b318-xml-bad-minidom",
  "revision": 1,
  "mode": "steer",
  "description": "Use defusedxml instead of xml.dom.minidom to parse XML; the standard parser is open to entity-expansion and other XML attacks on untrusted input.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B318",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "xml.dom.minidom.parse",
                  "xml.dom.minidom.parseString"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B318",
        "anchor": "witness.span",
        "message": "Using xml.dom.minidom to parse untrusted XML is vulnerable to XML attacks; use the defusedxml equivalent.",
        "suppress": {
          "nosec": {
            "codes": [
              "B318"
            ]
          }
        }
      }
    }
  ]
}
