{
  "format": "rerail.policy/v1",
  "id": "ruff-sim210-if-expr-with-true-false",
  "revision": 1,
  "mode": "steer",
  "description": "Use bool() on the condition instead of a conditional expression that yields True when it holds and False otherwise.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "if-expr-with-true-false",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "true": {
              "any": [
                {
                  "kind": "true"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "true"
                  }
                }
              ]
            },
            "false": {
              "any": [
                {
                  "kind": "false"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "false"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "conditional_expression",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "matches": "true",
                  "precedes": {
                    "stopBy": "neighbor",
                    "regex": "^if$"
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "matches": "false",
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^else$"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM210",
        "message": "Replace `True if cond else False` with `bool(cond)`.",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM210"
            ]
          }
        }
      }
    }
  ]
}
