          "doc-holder": {"any": [{"matches": "doc-stmt"}, {"kind": "parenthesized_expression", "inside": {"stopBy": "neighbor", "matches": "doc-holder"}}]},
          "docstring": {"kind": "string", "not": {"has": {"stopBy": "neighbor", "kind": "string_start", "regex": "[bBfFtT]"}}, "inside": {"stopBy": "neighbor", "matches": "doc-holder"}},
          "directive-hidden": {"value": {"regex": "\\n([ \\t]*)\\.\\. [^\\n]*(?:\\n(?:[ \\t]*\\n)*\\1[ \\t]+[^\\s][^\\n]*)*?\\n(?:[ \\t]*\\n)*\\1[ \\t]+(?i:args|arguments|attention|attributes|caution|danger|error|examples?|extended summary|hint|important|keyword (?:args|arguments)|methods|notes?|other (?:args|arguments|params|parameters)|parameters|raises|receives|references|returns?|see also|short summary|tip|todo|warnings?|warns|yields?):?[ \\t]*(?:\\n|\\z)"}},
          "owner": {"any": [{"kind": "module"}, {"kind": "function_definition"}, {"kind": "class_definition"}]},
          "checked": {"matches": "docstring", "not": {"matches": "directive-hidden"}, "inside": {"stopBy": "end", "kind": "expression_statement", "any": [{"inside": {"stopBy": "neighbor", "kind": "module"}}, {"layout": {"before": {"to": "token", "breaks": {"min": 1}}}}]}}
        }
      }
    },
    {
      "id": "indent-0",
      "forbid": {"ast": {"language": "python", "rule": {"matches": "checked", "inside": {"stopBy": {"matches": "owner"}, "matches": "owner", "regex": "\\A(?:[ \\t\\f(]*(?:[^ \\t\\f(uUrR\\\"'\\n][^\\n]*|[uUrR]+(?:[^uUrR\\\"'\\n][^\\n]*)?)?\\n)*[ \\t\\f(]{0}[uUrR]*[\\\"']"}, "regex": "(?m)^[ \\t]*(?i:args|arguments|attention|attributes|caution|danger|error|examples?|extended summary|hint|important|keyword (?:args|arguments)|methods|notes?|other (?:args|arguments|params|parameters)|parameters|raises|receives|references|returns?|see also|short summary|tip|todo|warnings?|warns|yields?):?[ \\t]*\\r?\\n(?:[ \\t]*\\r?\\n)*[ \\t]{1,}(?P<NAME>-+)[ \\t]*(?:\\r?\\n|[\\\"']{3}\\z)"}}},
      "violation": {"code": "D215", "anchor": "capture.NAME", "each": "NAME", "message": "Dedent this section underline to the indentation of the docstring's opening quotes, directly under the section name.", "suppress": {"noqa": {"codes": ["D215"]}}}
    },
