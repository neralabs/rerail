{
  "format": "rerail.policy/v1",
  "id": "ruff-d215-overindented-section-underline",
  "revision": 1,
  "mode": "steer",
  "description": "Align a docstring section's dashed underline with the docstring's own indentation, not deeper than it.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
