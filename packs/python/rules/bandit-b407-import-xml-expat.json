{
  "format": "rerail.policy/v1",
  "id": "bandit-b407-import-xml-expat",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid importing xml.dom.expatbuilder to parse XML; it is open to XML attacks, so use defusedxml.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B407",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "any": [
                    {
                      "kind": "dotted_name"
                    },
                    {
                      "kind": "aliased_import"
                    }
                  ],
                  "regex": "^xml\\s*\\.\\s*dom\\s*\\.\\s*expatbuilder"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "field": "module_name",
                  "regex": "^[.\\s]*xml\\s*\\.\\s*dom\\s*\\.\\s*expatbuilder"
                }
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]*xml\\s*\\.\\s*dom$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^expatbuilder",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B407",
        "anchor": "witness.span",
        "message": "xml.dom.expatbuilder parsing may be vulnerable to XML attacks; use defusedxml or defuse the standard library.",
        "suppress": {
          "nosec": {
            "codes": [
              "B407"
            ]
          }
        }
      }
    }
  ]
}
