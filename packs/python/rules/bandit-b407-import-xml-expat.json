{
  "format": "rerail.policy/v1",
  "id": "bandit-b407-import-xml-expat",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid importing xml.dom.expatbuilder to parse XML; it is open to XML attacks, so use defusedxml.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B407",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import xml.dom.expatbuilder"
              },
              {
                "pattern": "import xml.dom.expatbuilder as $ALIAS"
              },
              {
                "pattern": "from xml.dom.expatbuilder import $$$NAMES"
              },
              {
                "pattern": "from xml.dom import expatbuilder"
              },
              {
                "pattern": "from xml.dom import expatbuilder as $ALIAS"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B407",
        "anchor": "witness.span",
        "message": "Parse this XML with defusedxml.expatbuilder instead of xml.dom.expatbuilder; the standard parser is open to XML entity attacks.",
        "suppress": {
          "nosec": {
            "codes": [
              "B407"
            ]
          }
        }
      }
    }
  ]
}
