{
  "format": "rerail.policy/v1",
  "id": "bandit-b302-marshal",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid marshal.load() and marshal.loads(); marshal is not safe against malicious or malformed data, so never use it on untrusted input.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B302",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "marshal.load",
                  "marshal.loads"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B302",
        "anchor": "witness.span",
        "message": "Load this data with json or another data-only format instead of marshal, which is unsafe on untrusted input.",
        "suppress": {
          "nosec": {
            "codes": [
              "B302"
            ]
          }
        }
      }
    }
  ]
}
