{
 "format": "rerail.policy/v1",
 "id": "ruff-async250-blocking-input-in-async-function",
 "revision": 1,
 "mode": "steer",
 "description": "Don't call input() inside async functions; it blocks the event loop while waiting for the user.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "blocking-input",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "scope-body": {
       "kind": "block",
       "inside": {
        "stopBy": "neighbor",
        "any": [
         {
          "kind": "function_definition"
         },
         {
          "kind": "class_definition"
         }
        ]
       }
      },
      "lambda-body": {
       "inside": {
        "stopBy": "neighbor",
        "kind": "lambda"
       },
       "follows": {
        "stopBy": "end",
        "regex": "^:$"
       }
      },
      "callee-position": {
       "any": [
        {
         "inside": {
          "stopBy": "neighbor",
          "kind": "call"
         },
         "precedes": {
          "stopBy": "neighbor",
          "any": [
           {
            "kind": "argument_list"
           },
           {
            "kind": "generator_expression"
           }
          ]
         }
        },
        {
         "inside": {
          "stopBy": "neighbor",
          "kind": "parenthesized_expression",
          "matches": "callee-position"
         }
        }
       ]
      },
      "async-context": {
       "inside": {
        "stopBy": {
         "any": [
          {
           "matches": "scope-body"
          },
          {
           "matches": "lambda-body"
          }
         ]
        },
        "kind": "block",
        "inside": {
         "stopBy": "neighbor",
         "kind": "function_definition",
         "has": {
          "stopBy": "neighbor",
          "regex": "^async$"
         }
        }
       }
      },
      "target": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "global": [
         "input"
        ],
        "import": [
         "builtins.input"
        ]
       }
      }
     },
     "rule": {
      "all": [
       {
        "matches": "callee-position"
       },
       {
        "matches": "async-context"
       },
       {
        "matches": "target"
       }
      ]
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC250",
    "message": "Read input in a worker thread, such as `await asyncio.to_thread(input)`, instead of calling `input()` directly.",
    "suppress": {
      "noqa": {
        "codes": [
          "ASYNC250"
        ]
      }
    }
   }
  }
 ]
}
