{
  "format": "rerail.policy/v1",
  "id": "ruff-c402-unnecessary-generator-dict",
  "revision": 1,
  "mode": "steer",
  "description": "Use a dict comprehension instead of passing a generator of key-value pairs to dict; it reads more directly and skips building a tuple per item.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "generator-dict",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "trivia": {
              "any": [
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                },
                {
                  "regex": "^[(),]$"
                }
              ]
            },
            "callee": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^dict$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee"
                  }
                }
              ]
            },
            "pair": {
              "any": [
                {
                  "kind": "tuple",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "matches": "trivia"
                      }
                    },
                    "min": 2,
                    "max": 2
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "list_splat"
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "pair"
                  }
                }
              ]
            },
            "pairs": {
              "any": [
                {
                  "kind": "generator_expression",
                  "has": {
                    "field": "body",
                    "matches": "pair"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "pairs"
                  }
                }
              ]
            },
            "call": {
              "kind": "call",
              "any": [
                {
                  "has": {
                    "field": "function",
                    "matches": "callee"
                  },
                  "pattern": "$CALL"
                },
                {
                  "has": {
                    "field": "function",
                    "kind": "list_splat",
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "callee"
                    }
                  },
                  "regex": "^\\*(?:\\s|\\\\\\r?\\n|#[^\\r\\n]*)*(?<CALL>[\\s\\S]+)$"
                }
              ],
              "has": {
                "field": "arguments",
                "any": [
                  {
                    "matches": "pairs"
                  },
                  {
                    "kind": "argument_list",
                    "count": {
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "matches": "trivia"
                        }
                      },
                      "min": 1,
                      "max": 1
                    },
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "pairs"
                    }
                  }
                ]
              }
            },
            "in-annotation": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "matches": "call"
                    },
                    {
                      "matches": "in-annotation"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "call"
              },
              {
                "matches": "in-annotation"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.CALL",
        "code": "C402",
        "message": "Rewrite `dict((k, v) for ...)` as a dict comprehension `{k: v for ...}`; leave it if `dict` here is not the builtin.",
        "each": "CALL",
        "suppress": {
          "noqa": {
            "codes": [
              "C402"
            ]
          }
        }
      }
    }
  ]
}
