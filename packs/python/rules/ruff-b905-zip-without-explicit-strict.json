{
  "format": "rerail.policy/v1",
  "id": "ruff-b905-zip-without-explicit-strict",
  "revision": 2,
  "mode": "steer",
  "description": "Port of Ruff's B905 (zip-without-explicit-strict), from target version 3.10 (`when`; `expression.rs:792`): a call to builtin `zip` (bare `zip`, or `zip` from `builtins`) with no `strict=` keyword (find_keyword, through `arguments` in syntactic mode), at least two positional arguments or a `*` argument, and no infinite iterator argument (`itertools.cycle`/`count`, `repeat` without a finite `times`). `zip` and the itertools names resolve with `resolves`, so a shadowed `zip` is not reported. Reported on the call; tree-sitter reads `[*zip(x, y)]` (a starred call first in a list display) as a call of `*zip`, so there the finding starts at `zip` and ends after `zip` rather than after the call. Ported from the Ruff conformance suite (rerail/conformance/ruff/rules/B905.json at 3f102adcb), with Ruff's `# noqa` honoured as the Ruff CLI honours it.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "zip-without-explicit-strict",
      "forbid": {
        "ast": {
          "language": "python",
          "when": {
            "pythonVersion": {
              "min": "3.10"
            }
          },
          "utils": {
            "it-cycle-count": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "itertools.cycle",
                      "itertools.count"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "it-cycle-count"
                  }
                }
              ]
            },
            "it-repeat": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "itertools.repeat"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "it-repeat"
                  }
                }
              ]
            },
            "none-literal": {
              "any": [
                {
                  "kind": "none"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "none-literal"
                  }
                }
              ]
            },
            "infinite-call": {
              "kind": "call",
              "any": [
                {
                  "has": {
                    "field": "function",
                    "matches": "it-cycle-count"
                  }
                },
                {
                  "has": {
                    "field": "function",
                    "matches": "it-repeat"
                  },
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "argument_list",
                        "any": [
                          {
                            "count": {
                              "has": {
                                "stopBy": "neighbor",
                                "not": {
                                  "matches": "not-positional"
                                }
                              },
                              "min": 1,
                              "max": 1
                            },
                            "not": {
                              "has": {
                                "stopBy": "neighbor",
                                "any": [
                                  {
                                    "kind": "keyword_argument"
                                  },
                                  {
                                    "kind": "dictionary_splat"
                                  }
                                ]
                              }
                            }
                          },
                          {
                            "count": {
                              "has": {
                                "stopBy": "neighbor",
                                "not": {
                                  "matches": "not-positional"
                                }
                              },
                              "min": 2,
                              "max": 2
                            },
                            "has": {
                              "stopBy": "neighbor",
                              "not": {
                                "matches": "not-positional"
                              },
                              "matches": "none-literal",
                              "follows": {
                                "stopBy": "end",
                                "not": {
                                  "matches": "not-positional"
                                }
                              }
                            }
                          },
                          {
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "keyword_argument",
                              "all": [
                                {
                                  "has": {
                                    "field": "name",
                                    "regex": "^(times)$"
                                  }
                                },
                                {
                                  "has": {
                                    "field": "value",
                                    "matches": "none-literal"
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "has": {
                    "field": "function",
                    "matches": "it-repeat"
                  },
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "generator_expression"
                      }
                    }
                  ]
                }
              ]
            },
            "infinite": {
              "any": [
                {
                  "matches": "infinite-call"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "infinite"
                  }
                }
              ]
            },
            "callee-zip": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "global": [
                      "zip"
                    ],
                    "import": [
                      "builtins.zip"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee-zip"
                  }
                }
              ]
            },
            "trivia": {
              "any": [
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                }
              ]
            },
            "not-positional": {
              "any": [
                {
                  "kind": "keyword_argument"
                },
                {
                  "kind": "dictionary_splat"
                },
                {
                  "matches": "trivia"
                },
                {
                  "regex": "^[(),]$"
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "arguments": {
              "signature": [
                "*",
                "strict"
              ],
              "absent": [
                "strict"
              ],
              "mode": "syntactic"
            },
            "all": [
              {
                "any": [
                  {
                    "pattern": "$CALL",
                    "has": {
                      "field": "function",
                      "matches": "callee-zip"
                    }
                  },
                  {
                    "has": {
                      "field": "function",
                      "kind": "list_splat",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "callee-zip",
                        "pattern": "$CALL"
                      }
                    }
                  }
                ]
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "argument_list",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "matches": "not-positional"
                      },
                      "matches": "infinite"
                    }
                  },
                  "any": [
                    {
                      "count": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "matches": "not-positional"
                          }
                        },
                        "min": 2
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "list_splat"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.CALL",
        "code": "B905",
        "message": "`zip()` without an explicit `strict=` parameter",
        "suppress": {
          "noqa": {
            "codes": [
              "B905"
            ]
          }
        }
      }
    }
  ]
}
