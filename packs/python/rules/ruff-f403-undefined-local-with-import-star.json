{
  "format": "rerail.policy/v1",
  "id": "ruff-f403-undefined-local-with-import-star",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid from module import * star imports; they hide where names come from and stop undefined names from being detected.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "undefined-local-with-import-star",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "import_from_statement",
            "has": {
              "stopBy": "neighbor",
              "kind": "wildcard_import",
              "follows": {
                "stopBy": "end",
                "any": [
                  {
                    "kind": "dotted_name"
                  },
                  {
                    "kind": "relative_import"
                  }
                ],
                "pattern": "$MODULE"
              }
            },
            "not": {
              "has": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "dotted_name",
                    "regex": "^__future__$"
                  },
                  {
                    "kind": "relative_import",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "dotted_name",
                      "regex": "^__future__$"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F403",
        "message": "`from $MODULE import *` used; unable to detect undefined names",
        "suppress": {
          "noqa": {
            "codes": [
              "F403"
            ]
          }
        }
      }
    }
  ]
}