{
  "format": "rerail.policy/v1",
  "id": "ruff:F509",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's F509 (percent-format-unsupported-format-character): a `%`-format string the parser refuses at an unsupported conversion character. The format string is a str literal (no f/t/b prefix; implicit concatenations joined, escapes decoded, parentheses transparent) left of `%`, read with the `percentFormat` grammar (a port of ruff_python_literal's cformat parser).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "percent-format-unsupported-format-character",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "plain-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "kind": "string",
                      "regex": "^[A-Za-z]*[fFbBtT][A-Za-z]*['\"]"
                    }
                  }
                }
              ]
            },
            "format-string": {
              "any": [
                {
                  "matches": "plain-string",
                  "parse": {
                    "grammar": "percentFormat",
                    "has": {
                      "kind": "error",
                      "value": {
                        "regex": "^unsupported format character"
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "matches": "format-string"
                  }
                }
              ]
            }
          },
          "rule": {
            "pattern": "$S % $R"
          },
          "constraints": {
            "S": {
              "matches": "format-string"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F509",
        "message": "`%`-format string has unsupported format character"
      }
    }
  ]
}
