{
  "format": "rerail.policy/v1",
  "id": "bandit-b317-xml-bad-sax",
  "revision": 1,
  "mode": "steer",
  "description": "Use defusedxml instead of xml.sax to parse XML; the standard parser is open to entity-expansion and other XML attacks on untrusted input.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B317",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "all": [
              {
                "kind": "expression_statement"
              },
              {
                "has": {
                  "pattern": "$F($$$ARGS)"
                }
              }
            ]
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "xml.sax.parse",
                  "xml.sax.parseString",
                  "xml.sax.make_parser"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B317",
        "anchor": "witness.span",
        "message": "Parse this XML with defusedxml.sax instead of xml.sax.",
        "suppress": {
          "nosec": {
            "codes": [
              "B317"
            ]
          }
        }
      }
    }
  ]
}
