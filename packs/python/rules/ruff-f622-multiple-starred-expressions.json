{
  "format": "rerail.policy/v1",
  "id": "ruff-f622-multiple-starred-expressions",
  "revision": 1,
  "mode": "steer",
  "description": "Use at most one starred element in each Python unpacking target; two in the same target is a syntax error.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "multiple-starred-expressions",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "with-target": {
              "any": [
                { "inside": { "stopBy": "neighbor", "kind": "as_pattern_target" } },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [{ "kind": "tuple" }, { "kind": "list" }, { "kind": "parenthesized_expression" }],
                    "matches": "with-target"
                  }
                }
              ]
            }
          },
          "rule": {
            "any": [
              {
                "any": [{ "kind": "pattern_list" }, { "kind": "tuple_pattern" }, { "kind": "list_pattern" }],
                "count": { "has": { "stopBy": "neighbor", "kind": "list_splat_pattern" }, "min": 2 }
              },
              {
                "any": [{ "kind": "tuple" }, { "kind": "list" }],
                "matches": "with-target",
                "count": { "has": { "stopBy": "neighbor", "kind": "list_splat" }, "min": 2 }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F622",
        "message": "Keep only one starred name in this unpacking target.",
        "suppress": {
          "noqa": {
            "codes": [
              "F622"
            ]
          }
        }
      }
    }
  ]
}
