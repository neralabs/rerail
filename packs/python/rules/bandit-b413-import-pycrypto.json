{
  "format": "rerail.policy/v1",
  "id": "bandit-b413-import-pycrypto",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid importing the pyCrypto package; it is unmaintained and has known vulnerabilities, so use the cryptography package instead.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B413",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "any": [
                    {
                      "kind": "dotted_name"
                    },
                    {
                      "kind": "aliased_import"
                    }
                  ],
                  "regex": "^(?:Crypto\\s*\\.\\s*Cipher|Crypto\\s*\\.\\s*Hash|Crypto\\s*\\.\\s*IO|Crypto\\s*\\.\\s*Protocol|Crypto\\s*\\.\\s*PublicKey|Crypto\\s*\\.\\s*Random|Crypto\\s*\\.\\s*Signature|Crypto\\s*\\.\\s*Util)"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "field": "module_name",
                  "regex": "^[.\\s]*(?:Crypto\\s*\\.\\s*Cipher|Crypto\\s*\\.\\s*Hash|Crypto\\s*\\.\\s*IO|Crypto\\s*\\.\\s*Protocol|Crypto\\s*\\.\\s*PublicKey|Crypto\\s*\\.\\s*Random|Crypto\\s*\\.\\s*Signature|Crypto\\s*\\.\\s*Util)"
                }
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]*Crypto$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^(?:Cipher|Hash|IO|Protocol|PublicKey|Random|Signature|Util)",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B413",
        "anchor": "witness.span",
        "message": "The pyCrypto library is deprecated and unmaintained; consider using pyca/cryptography.",
        "suppress": {
          "nosec": {
            "codes": [
              "B413"
            ]
          }
        }
      }
    }
  ]
}
