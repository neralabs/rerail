{
  "format": "rerail.policy/v1",
  "id": "ruff-ruf002-ambiguous-unicode-character-docstring",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid look-alike Unicode characters in docstrings; they read like ASCII letters or punctuation but are different characters.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "plain-string": {
            "kind": "string",
            "regex": "^[rRuU]{0,2}['\"]"
          },
          "string-expression": {
            "any": [
              {
                "matches": "plain-string"
              },
              {
                "kind": "concatenated_string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "not": {
                      "matches": "plain-string"
                    }
                  }
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "string-expression"
                }
              }
            ]
          },
          "docstring-statement": {
            "kind": "expression_statement",
            "has": {
              "stopBy": "neighbor",
              "matches": "string-expression"
            },
            "not": {
              "has": {
                "stopBy": "neighbor",
                "regex": "^,$"
              }
            },
            "nthChild": {
              "position": 1,
              "ofRule": {
                "not": {
                  "kind": "comment"
                }
              }
            },
            "any": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "module"
                }
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "block",
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "docstring-text": {
            "kind": "string_content",
            "inside": {
              "stopBy": "end",
              "matches": "docstring-statement"
            }
          },
          "symbol": {
            "regex": "(?P<CH>[\\x{a0}´¸×˂-˄˗˛˜˴˸;΄՚՝։׀׃׳؍٫٭۔܁-܄᐀᙭᙮\\x{1680}᛬᛭᜵᠃᠉᾽᾿῀`´῾\\x{2000}-\\x{200a}‐-–‘-‛․\\x{2028}\\x{2029}\\x{202f}′‵‹›⁁⁃⁄⁎⁓⁚\\x{205f}℮−∕-∗∣∨∪∶∼⊤⋁⋃⋿⍳⍴⍺⏽╱╳❨❩❮❯❲-❵➕➖⟋⟍⟙⤫⤬⧵⧸⧹⨯⹀⼂⼃〔〕゠㇓㇔꓿꘎꞉﴾﴿︰﹍-﹏﹘﹨！-／：-＠［-｀｛-～￨𐩐𝄔\\x{1d16d}𝈆𝈍𝈏𝈒𝈓𝈖𝈪𝈶𝈷𝈺𝈻🝌🝨])"
          },
