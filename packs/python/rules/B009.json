{
  "format": "rerail.policy/v1",
  "id": "ruff:B009",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's B009 (getattr-with-constant): `getattr(obj, \"name\")` with exactly two positional arguments and no keyword arguments, `obj` not starred, the second a str literal (not bytes, an f- or t-string; escapes decoded, implicit concatenations joined) whose value is a Python identifier (Unicode XID, not a keyword) and not a mangled private name (`__x` without a trailing `__`). The callee (parentheses transparent) resolves to the builtin `getattr` (Ruff's `match_builtin_expr`): the unshadowed name, or `getattr` of the `builtins` module through the file's imports. Reported on the call.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "getattr-with-constant",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "ref-getattr": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "global": [
                  "getattr"
                ],
                "import": [
                  "builtins.getattr"
                ]
              }
            },
            "callee": {
              "any": [
                {
                  "matches": "ref-getattr"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee"
                  }
                }
              ]
            },
            "identifier-literal": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "string",
                      "regex": "^[rRuU]{0,2}['\"]"
                    },
                    {
                      "kind": "concatenated_string",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "string",
                          "not": {
                            "regex": "^[rRuU]{0,2}['\"]"
                          }
                        }
                      }
                    }
                  ],
                  "value": {
                    "regex": "^[\\p{XID_Start}_]\\p{XID_Continue}*$"
                  },
                  "not": {
                    "any": [
                      {
                        "value": {
                          "regex": "^(False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)$"
                        }
                      },
                      {
                        "all": [
                          {
                            "value": {
                              "regex": "^__"
                            }
                          },
                          {
                            "not": {
                              "value": {
                                "regex": "__$"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "identifier-literal"
                  }
                }
              ]
            },
            "positional": {
              "not": {
                "any": [
                  {
                    "kind": "keyword_argument"
                  },
                  {
                    "kind": "dictionary_splat"
                  },
                  {
                    "kind": "list_splat"
                  }
                ]
              }
            },
            "argument": {
              "not": {
                "any": [
                  {
                    "kind": "keyword_argument"
                  },
                  {
                    "kind": "dictionary_splat"
                  }
                ]
              }
            },
            "no-keywords": {
              "kind": "argument_list",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "keyword_argument"
                    },
                    {
                      "kind": "dictionary_splat"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "kind": "call",
            "pattern": "$FUNC($OBJ, $NAME)",
            "has": {
              "stopBy": "neighbor",
              "matches": "no-keywords"
            }
          },
          "constraints": {
            "FUNC": {
              "matches": "callee"
            },
            "OBJ": {
              "matches": "positional"
            },
            "NAME": {
              "matches": "identifier-literal"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B009",
        "message": "Do not call `getattr` with a constant attribute value. It is not any safer than normal property access."
      }
    }
  ]
}