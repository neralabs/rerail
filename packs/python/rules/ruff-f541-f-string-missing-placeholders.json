{
  "format": "rerail.policy/v1",
  "id": "ruff-f541-f-string-missing-placeholders",
  "revision": 2,
  "mode": "steer",
  "description": "Remove the f prefix from Python f-strings that have no placeholders; it suggests interpolation that never happens.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "f-string-missing-placeholders",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "has-placeholder": {
              "kind": "string",
              "has": { "stopBy": "neighbor", "kind": "interpolation" }
            }
          },
          "rule": {
            "kind": "string",
            "has": { "stopBy": "neighbor", "kind": "string_start", "regex": "^[A-Za-z]*[fF]" },
            "not": {
              "any": [
                { "matches": "has-placeholder" },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "concatenated_string",
                    "has": { "stopBy": "neighbor", "matches": "has-placeholder" }
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F541",
        "message": "Remove the `f` prefix and unescape doubled braces to keep this string's runtime value unchanged.",
        "suppress": {
          "noqa": {
            "codes": [
              "F541"
            ]
          }
        }
      }
    }
  ]
}
