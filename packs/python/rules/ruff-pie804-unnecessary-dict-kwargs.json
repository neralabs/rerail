{
  "format": "rerail.policy/v1",
  "id": "ruff-pie804-unnecessary-dict-kwargs",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's PIE804 (unnecessary-dict-kwargs): a call argument `**{...}` whose dict display is a single `**x` spread, empty, or has only keys that are str literals (not bytes, f- or t-strings; escapes decoded, implicit concatenations joined) whose value is a Python identifier (not a keyword). Reported on the `**` argument.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-dict-kwargs",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "kwarg-string": {
              "any": [
                {
                  "kind": "string",
                  "regex": "^[uUrR]{0,2}['\"]"
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "not": {
                        "regex": "^[uUrR]{0,2}['\"]"
                      }
                    }
                  }
                }
              ],
              "value": {
                "regex": "^[\\p{XID_Start}_]\\p{XID_Continue}*$"
              },
              "not": {
                "value": {
                  "regex": "^(False|None|True|and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield)$"
                }
              }
            },
            "kwarg-key": {
              "any": [
                {
                  "matches": "kwarg-string"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "kwarg-key"
                  }
                }
              ]
            },
            "spread-dict": {
              "any": [
                {
                  "kind": "dictionary",
                  "any": [
                    {
                      "count": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "regex": "^[{},]$"
                              },
                              {
                                "any": [
                                  {
                                    "kind": "comment"
                                  },
                                  {
                                    "kind": "line_continuation"
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        "min": 1,
                        "max": 1
                      },
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "dictionary_splat"
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "all": [
                            {
                              "not": {
                                "any": [
                                  {
                                    "regex": "^[{},]$"
                                  },
                                  {
                                    "any": [
                                      {
                                        "kind": "comment"
                                      },
                                      {
                                        "kind": "line_continuation"
                                      }
                                    ]
                                  }
                                ]
                              }
                            },
                            {
                              "not": {
                                "kind": "pair",
                                "has": {
                                  "stopBy": "neighbor",
                                  "not": {
                                    "follows": {
                                      "stopBy": "neighbor",
                                      "regex": "(?s)."
                                    }
                                  },
                                  "matches": "kwarg-key"
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "spread-dict"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "dictionary_splat",
            "inside": {
              "stopBy": "neighbor",
              "kind": "argument_list"
            },
            "has": {
              "stopBy": "neighbor",
              "matches": "spread-dict"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PIE804",
        "message": "Unnecessary `dict` kwargs",
        "suppress": {
          "noqa": {
            "codes": [
              "PIE804"
            ]
          }
        }
      }
    }
  ]
}
