{
  "format": "rerail.policy/v1",
  "id": "ruff-f632-is-literal",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's F632 (is-literal) with default settings: `is` or `is not` with an operand that is a non-singleton constant (string, bytes or number literal, tuple of constants) or a list, set or dict display or comprehension, one finding per offending operator reported on the whole comparison, as in Ruff; also a comparison inside a string Ruff parses as a type definition (a string annotation, `cast`/`TypeVar` arguments, `List[\"...\"]`), reported on the comparison inside the string, once per offending operator; strings nested in one (`List['1 is x']` inside a string annotation) are read too. Ported from the Ruff conformance suite (rerail/conformance/ruff/rules/F632.json at 3f102adcb), with Ruff's `# noqa` honoured as the Ruff CLI honours it.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "is-literal",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "constant": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "interpolation"
                    }
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "interpolation"
                    }
                  }
                },
                {
                  "kind": "integer"
                },
                {
                  "kind": "float"
                },
                {
                  "kind": "none"
                },
                {
                  "kind": "true"
                },
                {
                  "kind": "false"
                },
                {
                  "kind": "ellipsis"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "constant"
                  }
                },
                {
                  "kind": "tuple",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "matches": "constant"
                          },
                          {
                            "regex": "^[(),]$"
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "singleton": {
              "any": [
                {
                  "kind": "none"
                },
                {
                  "kind": "true"
                },
                {
                  "kind": "false"
                },
                {
                  "kind": "ellipsis"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "singleton"
                  }
                }
              ]
            },
            "constant-non-singleton": {
              "all": [
                {
                  "matches": "constant"
                },
                {
                  "not": {
                    "matches": "singleton"
                  }
                }
              ]
            },
            "literal-operand": {
              "any": [
                {
                  "matches": "constant-non-singleton"
                },
                {
                  "kind": "set"
                },
                {
                  "kind": "set_comprehension"
                },
                {
                  "kind": "list"
                },
                {
                  "kind": "list_comprehension"
                },
                {
                  "kind": "dictionary"
                },
                {
                  "kind": "dictionary_comprehension"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "literal-operand"
                  }
                }
              ]
            },
            "is-literal-op": {
              "regex": "^is(?:[\\s\\\\]+not)?$",
              "any": [
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "matches": "literal-operand"
                  }
                },
                {
                  "precedes": {
                    "stopBy": "neighbor",
                    "matches": "literal-operand"
                  }
                }
              ]
            },
            "is-literal-in-string": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "comparison_operator",
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "is-literal-op",
                        "capture": "O"
                      },
                      "capture": "C"
                    },
                    {
                      "matches": "is-literal-in-string"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "any": [
              {
                "matches": "is-literal-op",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "comparison_operator",
                  "pattern": "$C"
                }
              },
              {
                "matches": "is-literal-in-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.C",
        "code": "F632",
        "message": "Use `==` to compare constant literals",
        "each": "O",
        "suppress": {
          "noqa": {
            "codes": [
              "F632"
            ]
          }
        }
      }
    }
  ]
}
