{
  "format": "rerail.policy/v1",
  "id": "ruff:RET502",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's RET502 (implicit-return-value): a bare `return` in a function that also has a `return` with a value other than `None` (nested functions and classes are separate; generators and functions whose body is a lone `return` are skipped), reported on the `return`.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "implicit-return-value",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "analysed-function": {
              "kind": "function_definition",
              "all": [
                {
                  "not": {
                    "has": {
                      "stopBy": {
                        "any": [
                          {
                            "kind": "function_definition"
                          },
                          {
                            "kind": "class_definition"
                          }
                        ]
                      },
                      "kind": "yield"
                    }
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "return_statement"
                      },
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "kind": "return_statement"
                              },
                              {
                                "kind": "comment"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "none-literal": {
              "any": [
                {
                  "kind": "none"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "none-literal"
                  }
                }
              ]
            },
            "value-return": {
              "kind": "return_statement",
              "has": {
                "stopBy": "neighbor",
                "regex": "(?s).",
                "not": {
                  "any": [
                    {
                      "regex": "^return$"
                    },
                    {
                      "kind": "comment"
                    },
                    {
                      "matches": "none-literal"
                    }
                  ]
                }
              }
            },
            "own-return": {
              "kind": "return_statement"
            },
            "has-result": {
              "has": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "matches": "value-return"
              }
            }
          },
          "rule": {
            "kind": "return_statement",
            "regex": "^return$",
            "inside": {
              "stopBy": {
                "any": [
                  {
                    "kind": "function_definition"
                  },
                  {
                    "kind": "class_definition"
                  }
                ]
              },
              "kind": "function_definition",
              "all": [
                {
                  "matches": "analysed-function"
                },
                {
                  "matches": "has-result"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RET502",
        "message": "Do not implicitly `return None` in function able to return non-`None` value",
        "suppress": {
          "noqa": {
            "codes": [
              "RET502"
            ]
          }
        }
      }
    }
  ]
}
