{
  "format": "rerail.policy/v1",
  "id": "bandit:b321",
  "revision": 1,
  "mode": "steer",
  "description": "Detect insecure ftplib.FTP construction",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B321",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "ftplib.FTP"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B321",
        "anchor": "witness.span",
        "message": "FTP is unencrypted and insecure; use SSH, SFTP, SCP, or another encrypted protocol.",
        "suppress": {
          "nosec": {
            "codes": [
              "B321"
            ]
          }
        }
      }
    }
  ]
}
