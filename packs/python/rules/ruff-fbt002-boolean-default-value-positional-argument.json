{
  "format": "rerail.policy/v1",
  "id": "ruff-fbt002-boolean-default-value-positional-argument",
  "revision": 1,
  "mode": "steer",
  "description": "Make Python function parameters that default to True or False keyword-only; a positional boolean flag makes calls hard to read.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "boolean-default-value-positional-argument",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "bool-literal": {
              "any": [
                {
                  "kind": "true"
                },
                {
                  "kind": "false"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "bool-literal"
                  }
                }
              ]
            },
            "override": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                },
                {
                  "kind": "parenthesized_expression"
                }
              ],
              "resolves": {
                "import": [
                  "typing.override",
                  "typing_extensions.override",
                  "_typeshed.override"
                ]
              }
            },
            "fn-ref": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$FN"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "fn-ref"
                  }
                }
              ]
            },
            "setter": {
              "any": [
                {
                  "kind": "attribute",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "attribute",
                        "regex": "^setter$"
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "field": "object",
                        "matches": "fn-ref"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "setter"
                  }
                }
              ]
            },
            "checked-function": {
              "kind": "function_definition",
              "has": {
                "stopBy": "neighbor",
                "field": "name",
                "pattern": "$FN",
                "not": {
                  "regex": "^(__post_init__|__contains__|__getitem__|__setitem__|__delitem__|__add__|__radd__|__iadd__|__sub__|__rsub__|__isub__|__mul__|__rmul__|__imul__|__truediv__|__rtruediv__|__itruediv__|__floordiv__|__rfloordiv__|__ifloordiv__|__mod__|__rmod__|__imod__|__pow__|__rpow__|__ipow__|__lshift__|__rlshift__|__ilshift__|__rshift__|__rrshift__|__irshift__|__matmul__|__rmatmul__|__imatmul__|__and__|__rand__|__iand__|__or__|__ror__|__ior__|__xor__|__rxor__|__ixor__|__gt__|__lt__|__ge__|__le__|__eq__|__ne__|__pos__|__neg__|__invert__)$"
                }
              },
              "not": {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "decorated_definition",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "decorator",
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "matches": "override"
                        },
                        {
                          "matches": "setter"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "rule": {
            "kind": "identifier",
            "pattern": "$NAME",
            "not": {
              "follows": {
                "stopBy": "end",
                "regex": "^[=:]$"
              }
            },
            "inside": {
              "stopBy": "neighbor",
              "any": [
                {
                  "kind": "default_parameter"
                },
                {
                  "kind": "typed_default_parameter"
                }
              ],
              "has": {
                "stopBy": "neighbor",
                "field": "value",
                "matches": "bool-literal"
              },
              "not": {
                "follows": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "keyword_separator"
                    },
                    {
                      "kind": "list_splat_pattern"
                    },
                    {
                      "kind": "typed_parameter",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "list_splat_pattern"
                      }
                    }
                  ]
                }
              },
              "inside": {
                "stopBy": "neighbor",
                "kind": "parameters",
                "inside": {
                  "stopBy": "neighbor",
                  "matches": "checked-function"
                }
              }
            }
          },
          "file": {
            "path": {
              "notRegex": "\\.pyi$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "FBT002",
        "message": "Make `$NAME` keyword-only by moving it after `*` and update positional callers; keep it positional only when a parent signature or callback protocol requires it.",
        "suppress": {
          "noqa": {
            "codes": [
              "FBT002"
            ]
          }
        }
      }
    }
  ]
}
