{
 "format": "rerail.policy/v1",
 "id": "ruff-pth121-os-path-samefile",
 "revision": 1,
 "mode": "steer",
 "description": "Use the samefile method of a Path object instead of os.path.samefile; pathlib reads better than string-based os.path functions.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "os-path-samefile",
   "forbid": {
    "ast": {
     "language": "python",
     "rule": {
      "any": [
       {
        "matches": "target"
       },
       {
        "matches": "in-string"
       }
      ]
     },
     "utils": {
      "callee": {
       "any": [
        {
         "any": [
          {
           "kind": "identifier"
          },
          {
           "kind": "attribute"
          }
         ],
         "resolves": {
          "import": [
           "os.path.samefile"
          ]
         },
         "pattern": "$F"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "callee"
         }
        }
       ]
      },
      "target": {
       "kind": "call",
       "all": [
        {
         "has": {
          "stopBy": "neighbor",
          "matches": "callee",
          "precedes": {
           "stopBy": "end",
           "any": [
            {
             "kind": "argument_list"
            },
            {
             "kind": "generator_expression"
            }
           ]
          }
         }
        }
       ]
      },
      "in-string": {
       "any": [
        {
         "kind": "string"
        },
        {
         "kind": "concatenated_string"
        }
       ],
       "parse": {
        "grammar": "annotation",
        "has": {
         "stopBy": "end",
         "any": [
          {
           "matches": "target"
          },
          {
           "matches": "in-string"
          }
         ]
        }
       }
      }
     }
    }
   },
   "violation": {
    "anchor": "capture.F",
    "code": "PTH121",
    "message": "Use `Path(first).samefile(second)` instead of `os.path.samefile(first, second)`; leave it for bytes paths, which `Path` rejects.",
    "each": "F",
    "suppress": {
     "noqa": {
      "codes": [
       "PTH121"
      ]
     }
    }
   }
  }
 ]
}
