{
  "format": "rerail.policy/v1",
  "id": "ruff:B034",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's B034 (re-sub-positional-args): a call to `re.sub` or `re.subn` with more than three positional arguments, or to `re.split` with more than two (starred arguments count). The callee resolves with `resolves` (imports and shadowing as Ruff's semantic model sees them). Reported on the call.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "re-sub-positional-args",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "re-sub": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "re.sub",
                      "re.subn"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "re-sub"
                  }
                }
              ]
            },
            "re-split": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "re.split"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "re-split"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "any": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "argument_list",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "kind": "keyword_argument"
                          },
                          {
                            "kind": "dictionary_splat"
                          },
                          {
                            "kind": "comment"
                          },
                          {
                            "regex": "^[(),]$"
                          }
                        ]
                      }
                    },
                    "min": 4
                  },
                  "follows": {
                    "stopBy": "neighbor",
                    "matches": "re-sub"
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "argument_list",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "kind": "keyword_argument"
                          },
                          {
                            "kind": "dictionary_splat"
                          },
                          {
                            "kind": "comment"
                          },
                          {
                            "regex": "^[(),]$"
                          }
                        ]
                      }
                    },
                    "min": 3
                  },
                  "follows": {
                    "stopBy": "neighbor",
                    "matches": "re-split"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B034",
        "message": "`re.sub` should pass `count` and `flags` as keyword arguments to avoid confusion due to unintuitive argument positions",
        "suppress": {
          "noqa": {
            "codes": [
              "B034"
            ]
          }
        }
      }
    }
  ]
}
