{
  "format": "rerail.policy/v1",
  "id": "bandit-b315-xml-bad-expatreader",
  "revision": 1,
  "mode": "steer",
  "description": "Detect vulnerable xml.sax.expatreader parser creation",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B315",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "xml.sax.expatreader.create_parser"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B315",
        "anchor": "witness.span",
        "message": "Using xml.sax.expatreader to parse untrusted XML may permit XML attacks; use defusedxml.",
        "suppress": {
          "nosec": {
            "codes": [
              "B315"
            ]
          }
        }
      }
    }
  ]
}
