{
  "format": "rerail.policy/v1",
  "id": "ruff:E742",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's E742 (ambiguous-class-name): a class named `l`, `I` or `O`, reported on the name.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "ambiguous-class-name",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "regex": "^(?<NAME>[lIO])$",
            "inside": {
              "stopBy": "neighbor",
              "kind": "class_definition"
            },
            "follows": {
              "stopBy": "neighbor",
              "regex": "^(?:class|def)$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "E742",
        "message": "Ambiguous class name: `$NAME`",
        "suppress": {
          "noqa": {
            "codes": [
              "E742"
            ]
          }
        }
      }
    }
  ]
}
