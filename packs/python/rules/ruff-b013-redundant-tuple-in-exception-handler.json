{
  "format": "rerail.policy/v1",
  "id": "ruff-b013-redundant-tuple-in-exception-handler",
  "revision": 1,
  "mode": "steer",
  "description": "Remove the one-element tuple around a single exception type in an except clause; the parentheses and comma are redundant.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "redundant-tuple-in-exception-handler",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "handler-type": {
              "inside": {
                "stopBy": "neighbor",
                "any": [
                  {
                    "kind": "except_clause"
                  },
                  {
                    "kind": "as_pattern",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "except_clause"
                    }
                  },
                  {
                    "kind": "parenthesized_expression",
                    "matches": "handler-type"
                  }
                ]
              }
            },
            "element": {
              "not": {
                "any": [
                  {
                    "kind": "comment"
                  },
                  {
                    "regex": "^[(),]$"
                  }
                ]
              }
            }
          },
          "rule": {
            "kind": "tuple",
            "matches": "handler-type",
            "all": [
              {
                "count": {
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "element"
                  },
                  "min": 1,
                  "max": 1
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "list_splat"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B013",
        "message": "A length-one tuple literal is redundant in exception handlers",
        "suppress": {
          "noqa": {
            "codes": [
              "B013"
            ]
          }
        }
      }
    }
  ]
}