{
 "format": "rerail.policy/v1",
 "id": "ruff:ASYNC240",
 "revision": 1,
 "mode": "steer",
 "description": "Port of Ruff's ASYNC240 (blocking-path-method-in-async-function): a call to an `os.path` function, or a method on a `pathlib` path (a `Path(...)`-family call, or a name whose binding holds such a call or is annotated with a path class, directly or in `|`/`Optional`/`Union`: Ruff's check_type through `resolves.binding`), except Ruff's list of pure methods, inside an `async def` body whose function is the nearest enclosing function, lambda body or class, reported on the callee. Names resolve as in Ruff's resolve_qualified_name, through the engine's `resolves` (M7). A bare name imported from `os.path` resolves through `prefix`. The binding is Ruff's only_binding (`resolves.binding` with `only`: it shadows no earlier binding of the name in its scope).",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "shared",
   "define": {
    "language": "python",
    "utils": {
     "async-context": {
      "inside": {
       "stopBy": {
        "any": [
         {
          "matches": "scope-body"
         },
         {
          "matches": "lambda-body"
         }
        ]
       },
       "kind": "block",
       "inside": {
        "stopBy": "neighbor",
        "kind": "function_definition",
        "has": {
         "stopBy": "neighbor",
         "regex": "^async$"
        }
       }
      }
     },
     "callee-position": {
      "any": [
       {
        "inside": {
         "stopBy": "neighbor",
         "kind": "call"
        },
        "precedes": {
         "stopBy": "neighbor",
         "any": [
          {
           "kind": "argument_list"
          },
          {
           "kind": "generator_expression"
          }
         ]
        }
       },
       {
        "inside": {
         "stopBy": "neighbor",
         "kind": "parenthesized_expression",
         "matches": "callee-position"
        }
       }
      ]
     },
     "lambda-body": {
      "inside": {
       "stopBy": "neighbor",
       "kind": "lambda"
      },
      "follows": {
       "stopBy": "end",
       "regex": "^:$"
      }
     },
     "scope-body": {
      "kind": "block",
      "inside": {
       "stopBy": "neighbor",
       "any": [
        {
         "kind": "function_definition"
        },
        {
         "kind": "class_definition"
        }
       ]
      }
     }
    }
   }
  },
  {
   "id": "blocking-os-path",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "target": {
       "any": [
        {
         "kind": "attribute",
         "pattern": "$OBJ.$METH",
         "has": {
          "stopBy": "neighbor",
          "pattern": "$OBJ",
          "precedes": {
           "stopBy": "end",
           "regex": "^\\.$"
          },
          "any": [
           {
            "kind": "identifier"
           },
           {
            "kind": "attribute"
           }
          ],
          "resolves": {
           "import": [
            "os.path"
           ]
          }
         },
         "all": [
          {
           "has": {
            "stopBy": "neighbor",
            "kind": "identifier",
            "pattern": "$METH",
            "not": {
             "regex": "^(ALLOW_MISSING|altsep|anchor|as_posix|as_uri|basename|commonpath|commonprefix|curdir|defpath|devnull|dirname|drive|expandvars|extsep|genericpath|is_absolute|is_relative_to|is_reserved|isabs|join|joinpath|match|name|normcase|os|open|pardir|parent|parents|parts|pathsep|relative_to|root|samestat|sep|split|splitdrive|splitext|splitroot|stem|suffix|suffixes|supports_unicode_filenames|sys|with_name|with_segments|with_stem|with_suffix)$"
            },
            "follows": {
             "stopBy": "end",
             "regex": "^\\.$"
            }
           }
          }
         ]
        },
        {
         "kind": "identifier",
         "resolves": {
          "import": [
           "os.path"
          ],
          "prefix": true
         },
         "not": {
          "any": [
           {
            "any": [
             {
              "kind": "identifier"
             },
             {
              "kind": "attribute"
             }
            ],
            "resolves": {
             "import": [
              "os.path"
             ]
            }
           },
           {
            "any": [
             {
              "kind": "identifier"
             },
             {
              "kind": "attribute"
             }
            ],
            "resolves": {
             "import": [
              "os.path.ALLOW_MISSING",
              "os.path.altsep",
              "os.path.anchor",
              "os.path.as_posix",
              "os.path.as_uri",
              "os.path.basename",
              "os.path.commonpath",
              "os.path.commonprefix",
              "os.path.curdir",
              "os.path.defpath",
              "os.path.devnull",
              "os.path.dirname",
              "os.path.drive",
              "os.path.expandvars",
              "os.path.extsep",
              "os.path.genericpath",
              "os.path.is_absolute",
              "os.path.is_relative_to",
              "os.path.is_reserved",
              "os.path.isabs",
              "os.path.join",
              "os.path.joinpath",
              "os.path.match",
              "os.path.name",
              "os.path.normcase",
              "os.path.os",
              "os.path.open",
              "os.path.pardir",
              "os.path.parent",
              "os.path.parents",
              "os.path.parts",
              "os.path.pathsep",
              "os.path.relative_to",
              "os.path.root",
              "os.path.samestat",
              "os.path.sep",
              "os.path.split",
              "os.path.splitdrive",
              "os.path.splitext",
              "os.path.splitroot",
              "os.path.stem",
              "os.path.suffix",
              "os.path.suffixes",
              "os.path.supports_unicode_filenames",
              "os.path.sys",
              "os.path.with_name",
              "os.path.with_segments",
              "os.path.with_stem",
              "os.path.with_suffix"
             ]
            }
           }
          ]
         }
        }
       ]
      }
     },
     "rule": {
      "all": [
       {
        "matches": "callee-position"
       },
       {
        "matches": "async-context"
       },
       {
        "matches": "target"
       }
      ]
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC240",
    "message": "Async functions should not perform blocking os.path operations"
   }
  },
  {
   "id": "blocking-pathlib",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "ann-class": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "import": [
         "pathlib.Path",
         "pathlib.PosixPath",
         "pathlib.PurePath",
         "pathlib.PurePosixPath",
         "pathlib.PureWindowsPath",
         "pathlib.WindowsPath"
        ]
       }
      },
      "union-name": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "import": [
         "typing.Optional",
         "_typeshed.Optional",
         "typing_extensions.Optional",
         "typing.Union",
         "_typeshed.Union",
         "typing_extensions.Union"
        ]
       }
      },
      "ann": {
       "any": [
        {
         "matches": "ann-class"
        },
        {
         "kind": "type",
         "has": {
          "stopBy": "neighbor",
          "matches": "ann"
         }
        },
        {
         "kind": "binary_operator",
         "has": {
          "stopBy": "neighbor",
          "regex": "^\\|$"
         },
         "all": [
          {
           "has": {
            "stopBy": "neighbor",
            "matches": "ann"
           }
          }
         ]
        },
        {
         "kind": "generic_type",
         "has": {
          "stopBy": "neighbor",
          "matches": "union-name",
          "precedes": {
           "stopBy": "neighbor",
           "kind": "type_parameter"
          }
         },
         "all": [
          {
           "has": {
            "stopBy": "neighbor",
            "kind": "type_parameter",
            "has": {
             "stopBy": "neighbor",
             "matches": "ann"
            }
           }
          }
         ]
        },
        {
         "kind": "subscript",
         "has": {
          "stopBy": "neighbor",
          "matches": "union-name",
          "precedes": {
           "stopBy": "neighbor",
           "regex": "^\\[$"
          }
         },
         "all": [
          {
           "has": {
            "stopBy": "neighbor",
            "follows": {
             "stopBy": "end",
             "regex": "^\\[$"
            },
            "any": [
             {
              "matches": "ann"
             },
             {
              "kind": "tuple",
              "has": {
               "stopBy": "neighbor",
               "matches": "ann"
              }
             }
            ]
           }
          }
         ]
        }
       ]
      },
      "init": {
       "any": [
        {
         "kind": "call",
         "has": {
          "stopBy": "neighbor",
          "any": [
           {
            "kind": "identifier"
           },
           {
            "kind": "attribute"
           }
          ],
          "resolves": {
           "import": [
            "pathlib.Path",
            "pathlib.PosixPath",
            "pathlib.PurePath",
            "pathlib.PurePosixPath",
            "pathlib.PureWindowsPath",
            "pathlib.WindowsPath"
           ]
          },
          "precedes": {
           "stopBy": "neighbor",
           "kind": "argument_list"
          }
         }
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "init"
         }
        }
       ]
      },
      "plain-target": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "plain-target"
         }
        }
       ]
      },
      "typed-name": {
       "kind": "identifier",
       "any": [
        {
         "resolves": {
          "binding": {
           "only": true,
           "value": {
            "matches": "init"
           },
           "site": {
            "not": {
             "has": {
              "stopBy": "neighbor",
              "kind": "type"
             }
            }
           }
          }
         }
        },
        {
         "resolves": {
          "binding": {
           "only": true,
           "site": {
            "kind": "as_pattern",
            "inside": {
             "stopBy": "neighbor",
             "kind": "with_item"
            },
            "all": [
             {
              "has": {
               "stopBy": "neighbor",
               "matches": "init",
               "precedes": {
                "stopBy": "end",
                "regex": "^as$"
               }
              }
             },
             {
              "has": {
               "stopBy": "neighbor",
               "kind": "as_pattern_target",
               "has": {
                "stopBy": "neighbor",
                "matches": "plain-target"
               }
              }
             }
            ]
           }
          }
         }
        },
        {
         "resolves": {
          "binding": {
           "only": true,
           "annotation": {
            "matches": "ann"
           },
           "site": {
            "not": {
             "has": {
              "stopBy": "neighbor",
              "any": [
               {
                "kind": "list_splat_pattern"
               },
               {
                "kind": "dictionary_splat_pattern"
               }
              ]
             }
            }
           }
          }
         }
        }
       ]
      },
      "target": {
       "kind": "attribute",
       "pattern": "$OBJ.$METH",
       "has": {
        "stopBy": "neighbor",
        "pattern": "$OBJ",
        "precedes": {
         "stopBy": "end",
         "regex": "^\\.$"
        },
        "any": [
         {
          "matches": "init"
         },
         {
          "kind": "identifier",
          "matches": "typed-name"
         }
        ]
       },
       "inside": {
        "stopBy": "end",
        "kind": "module",
        "regex": "\\b(pathlib)\\b"
       },
       "all": [
        {
         "has": {
          "stopBy": "neighbor",
          "kind": "identifier",
          "pattern": "$METH",
          "not": {
           "regex": "^(ALLOW_MISSING|altsep|anchor|as_posix|as_uri|basename|commonpath|commonprefix|curdir|defpath|devnull|dirname|drive|expandvars|extsep|genericpath|is_absolute|is_relative_to|is_reserved|isabs|join|joinpath|match|name|normcase|os|open|pardir|parent|parents|parts|pathsep|relative_to|root|samestat|sep|split|splitdrive|splitext|splitroot|stem|suffix|suffixes|supports_unicode_filenames|sys|with_name|with_segments|with_stem|with_suffix)$"
          },
          "follows": {
           "stopBy": "end",
           "regex": "^\\.$"
          }
         }
        }
       ]
      }
     },
     "rule": {
      "all": [
       {
        "matches": "callee-position"
       },
       {
        "matches": "async-context"
       },
       {
        "matches": "target"
       }
      ]
     }
    }
   },
   "violation": {
    "anchor": "witness.span",
    "code": "ASYNC240",
    "message": "Async functions should not perform blocking pathlib.Path operations"
   }
  }
 ]
