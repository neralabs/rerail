{
  "format": "rerail.policy/v1",
  "id": "bandit:b415",
  "revision": 1,
  "mode": "steer",
  "description": "Detect direct imports of the insecure pyghmi package.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B415",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import pyghmi"
              },
              {
                "pattern": "import pyghmi as $ALIAS"
              },
              {
                "pattern": "from pyghmi import $$$NAMES"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B415",
        "anchor": "witness.span",
        "message": "An IPMI-related module is being imported. IPMI is insecure; use an encrypted protocol."
      }
    }
  ]
}
