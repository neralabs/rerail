{
  "format": "rerail.policy/v1",
  "id": "ruff-pd101-pandas-nunique-constant-series-check",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid comparing nunique() with 1 to check whether a pandas Series is constant; compare its values with the first one instead, which stops at the first difference.",
  "scope": {"include": ["**/*"], "exclude": []},
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "literal-receiver": {
            "any": [
              {"kind": "integer"},
              {"kind": "float"},
              {"kind": "true"},
              {"kind": "false"},
              {"kind": "none"},
              {"kind": "ellipsis"},
              {"kind": "tuple"},
              {"kind": "list"},
              {"kind": "set"},
              {"kind": "dictionary"},
              {"kind": "list_comprehension"},
              {"kind": "set_comprehension"},
              {"kind": "dictionary_comprehension"},
              {"kind": "generator_expression"},
              {"kind": "string", "regex": "^[uUbBrR]{0,2}['\"]"},
              {
                "kind": "concatenated_string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "not": {"regex": "^[uUbBrR]{0,2}['\"]"}
                  }
                }
              }
            ]
          },
          "relevant-name": {
            "kind": "identifier",
            "all": [
              {
                "any": [
                  {
                    "resolves": {
                      "binding": {
                        "form": [
                          "assignment",
                          "annotated",
                          "annotation",
                          "augmented",
                          "named",
                          "for",
                          "global",
                          "match",
                          "typeAlias"
                        ]
                      }
                    }
                  },
                  {"resolves": {"binding": {"form": "parameter"}}, "not": {"regex": "^(self|cls)$"}}
                ]
              },
              {
                "not": {
                  "resolves": {
                    "binding": {
                      "scope": "module",
                      "site": {"inside": {"stopBy": "end", "matches": "dunder-all-statement"}}
                    }
                  }
                }
              },
              {
                "not": {
                  "resolves": {
                    "binding": {
                      "scope": "comprehension",
                      "site": {"inside": {"stopBy": "end", "kind": "with_clause"}}
                    }
                  }
                }
              }
            ]
          },
          "series-receiver": {
            "any": [
              {"matches": "relevant-name"},
              {
                "kind": "parenthesized_expression",
                "has": {"stopBy": "neighbor", "matches": "series-receiver"}
              },
              {
                "not": {
                  "any": [
                    {"kind": "identifier"},
                    {"kind": "parenthesized_expression"},
                    {"matches": "literal-receiver"},
                    {"kind": "comment"},
                    {"regex": "^[()]$"}
                  ]
                }
              }
            ]
          },
          "nunique-func": {
            "any": [
              {
                "kind": "attribute",
                "all": [
                  {"has": {"stopBy": "neighbor", "field": "attribute", "regex": "^nunique$"}},
                  {"has": {"stopBy": "neighbor", "field": "object", "matches": "series-receiver"}}
                ]
              },
              {
                "kind": "parenthesized_expression",
                "has": {"stopBy": "neighbor", "matches": "nunique-func"}
              }
            ]
          },
          "nunique-call": {
            "any": [
              {
                "kind": "call",
                "has": {"stopBy": "neighbor", "field": "function", "matches": "nunique-func"}
              },
              {
                "kind": "parenthesized_expression",
                "has": {"stopBy": "neighbor", "matches": "nunique-call"}
              }
            ]
          },
          "int-one": {
            "any": [
              {"kind": "integer", "value": {"eq": 1}},
              {
                "kind": "parenthesized_expression",
                "has": {"stopBy": "neighbor", "matches": "int-one"}
              }
            ]
          },
          "dunder-all-statement": {
            "kind": "expression_statement",
            "has": {
              "stopBy": "neighbor",
              "any": [{"kind": "assignment"}, {"kind": "augmented_assignment"}],
              "has": {"stopBy": "neighbor", "field": "left", "regex": "^__all__$"}
            }
          },
          "pandas-import-file": {
            "kind": "module",
            "has": {
              "stopBy": "end",
              "any": [
                {
                  "kind": "import_statement",
                  "has": {"stopBy": "end", "kind": "dotted_name", "regex": "^pandas(\\s*\\.|$)"}
                },
                {
                  "kind": "import_from_statement",
                  "has": {
                    "stopBy": "neighbor",
                    "field": "module_name",
                    "kind": "dotted_name",
                    "regex": "^pandas(\\s*\\.|$)"
                  }
                }
              ]
            }
          },
          "annotation-type": {
            "kind": "type",
            "inside": {
              "stopBy": "neighbor",
              "any": [
                {"kind": "typed_parameter"},
                {"kind": "typed_default_parameter"},
                {"kind": "function_definition"},
                {"kind": "assignment"}
              ]
            }
          },
          "deferred-annotation": {
            "inside": {"stopBy": "end", "matches": "annotation-type"},
            "all": [
              {
                "inside": {
                  "stopBy": "end",
                  "kind": "module",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "future_import_statement",
                    "has": {
                      "stopBy": "end",
                      "kind": "dotted_name",
                      "resolves": {"imported": ["__future__.annotations"]}
                    }
                  }
                }
              },
              {"inside": {"stopBy": "end", "matches": "pandas-import-file"}}
            ]
          },
          "comparison": {
            "kind": "comparison_operator",
            "all": [
              {
                "count": {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^(<|<=|==|!=|>|>=|<>|in|is|not\\s+in|is\\s+not)$"
                  },
                  "min": 1,
                  "max": 1
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "matches": "nunique-call",
                  "precedes": {"stopBy": "end", "regex": "^(<=|==|!=|>)$"}
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "matches": "int-one",
                  "follows": {"stopBy": "end", "regex": "^(<=|==|!=|>)$"}
                }
              }
            ]
          },
          "pandas-gate": {
            "any": [
              {"resolves": {"imported": ["pandas"], "seenBefore": true}},
              {"matches": "deferred-annotation"}
            ]
          },
          "hit-core": {"matches": "comparison", "all": [{"matches": "pandas-gate"}]}
        }
      }
    },
    {
      "id": "nunique-le-1",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "hit": {"matches": "hit-core", "has": {"stopBy": "neighbor", "regex": "^<=$"}},
            "in-string": {
              "any": [{"kind": "string"}, {"kind": "concatenated_string"}],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [{"matches": "hit", "capture": "CMP"}, {"matches": "in-string"}]
                }
              }
            }
          },
          "rule": {"any": [{"matches": "hit", "pattern": "$CMP"}, {"matches": "in-string"}]}
        }
      },
      "violation": {
        "anchor": "capture.CMP",
        "code": "PD101",
        "each": "CMP",
        "message": "Check a NumPy array, not `nunique()`, which scans every value: `a = s.to_numpy()`, then `a.shape[0] == 0 or (a[0] == a).all()`. Keep nunique if NaN handling matters or `s` isn't a pandas Series.",
        "suppress": {"noqa": {"codes": ["PD101"]}}
      }
    },
    {
      "id": "nunique-eq-1",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "hit": {"matches": "hit-core", "has": {"stopBy": "neighbor", "regex": "^==$"}},
            "in-string": {
              "any": [{"kind": "string"}, {"kind": "concatenated_string"}],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [{"matches": "hit", "capture": "CMP"}, {"matches": "in-string"}]
                }
              }
            }
          },
          "rule": {"any": [{"matches": "hit", "pattern": "$CMP"}, {"matches": "in-string"}]}
        }
      },
      "violation": {
        "anchor": "capture.CMP",
        "code": "PD101",
        "each": "CMP",
        "message": "Check a NumPy array, not `nunique()`, which scans every value: `a = s.to_numpy()`, then `a.shape[0] > 0 and (a[0] == a).all()`. Keep nunique if NaN handling matters or `s` isn't a pandas Series.",
        "suppress": {"noqa": {"codes": ["PD101"]}}
      }
    },
    {
      "id": "nunique-ne-1",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "hit": {"matches": "hit-core", "has": {"stopBy": "neighbor", "regex": "^!=$"}},
            "in-string": {
              "any": [{"kind": "string"}, {"kind": "concatenated_string"}],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [{"matches": "hit", "capture": "CMP"}, {"matches": "in-string"}]
                }
              }
            }
          },
          "rule": {"any": [{"matches": "hit", "pattern": "$CMP"}, {"matches": "in-string"}]}
        }
      },
      "violation": {
        "anchor": "capture.CMP",
        "code": "PD101",
        "each": "CMP",
        "message": "Check a NumPy array, not `nunique()`, which scans every value: `a = s.to_numpy()`, then `a.shape[0] == 0 or not (a[0] == a).all()`. Keep nunique if NaN handling matters or `s` isn't a pandas Series.",
        "suppress": {"noqa": {"codes": ["PD101"]}}
      }
    },
    {
      "id": "nunique-gt-1",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "hit": {"matches": "hit-core", "has": {"stopBy": "neighbor", "regex": "^>$"}},
            "in-string": {
              "any": [{"kind": "string"}, {"kind": "concatenated_string"}],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [{"matches": "hit", "capture": "CMP"}, {"matches": "in-string"}]
                }
              }
            }
          },
          "rule": {"any": [{"matches": "hit", "pattern": "$CMP"}, {"matches": "in-string"}]}
        }
      },
      "violation": {
        "anchor": "capture.CMP",
        "code": "PD101",
        "each": "CMP",
        "message": "Check a NumPy array, not `nunique()`, which scans every value: `a = s.to_numpy()`, then `a.shape[0] > 0 and not (a[0] == a).all()`. Keep nunique if NaN handling matters or `s` isn't a pandas Series.",
        "suppress": {"noqa": {"codes": ["PD101"]}}
      }
    },
    {
      "id": "stub-annotation",
      "forbid": {
        "ast": {
          "language": "python",
          "file": {"path": {"regex": "\\.pyi$"}},
          "rule": {
            "matches": "comparison",
            "pattern": "$CMP",
            "all": [
              {"inside": {"stopBy": "end", "matches": "annotation-type"}},
              {"inside": {"stopBy": "end", "matches": "pandas-import-file"}},
              {"not": {"matches": "pandas-gate"}}
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.CMP",
        "code": "PD101",
        "each": "CMP",
        "message": "Check a NumPy array, not `nunique()`, which scans every value: with `a = s.to_numpy()`, `a.shape[0] == 0` tests empty and `(a[0] == a).all()` tests constant. Keep nunique if NaN handling matters.",
        "suppress": {"noqa": {"codes": ["PD101"]}}
      }
    }
  ]
}
