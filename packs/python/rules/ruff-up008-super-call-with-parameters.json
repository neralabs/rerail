{
 "format": "rerail.policy/v1",
 "id": "ruff-up008-super-call-with-parameters",
 "revision": 1,
 "mode": "steer",
 "description": "Call super() without arguments inside methods; passing the class and instance explicitly is redundant on Python 3.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "super-with-class-and-instance",
   "forbid": {
    "ast": {
     "language": "python",
     "utils": {
      "scope-boundary": {
       "any": [
        {
         "kind": "function_definition"
        },
        {
         "kind": "lambda"
        },
        {
         "kind": "class_definition"
        },
        {
         "kind": "list_comprehension"
        },
        {
         "kind": "set_comprehension"
        },
        {
         "kind": "dictionary_comprehension"
        },
        {
         "kind": "generator_expression"
        }
       ]
      },
      "callable": {
       "any": [
        {
         "kind": "function_definition"
        },
        {
         "kind": "lambda"
        }
       ]
      },
      "bare-super": {
       "kind": "identifier",
       "resolves": {
        "global": [
         "super"
        ]
       }
      },
      "builtins-super": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "attribute"
        }
       ],
       "resolves": {
        "import": [
         "builtins.super"
        ]
       }
      },
      "param-unit": {
       "any": [
        {
         "kind": "identifier",
         "inside": {
          "stopBy": "neighbor",
          "any": [
           {
            "kind": "parameters"
           },
           {
            "kind": "lambda_parameters"
           }
          ]
         }
        },
        {
         "kind": "typed_parameter"
        },
        {
         "kind": "default_parameter"
        },
        {
         "kind": "typed_default_parameter"
        }
       ]
      },
      "positional-param": {
       "matches": "param-unit",
       "not": {
        "any": [
         {
          "precedes": {
           "stopBy": "end",
           "kind": "positional_separator"
          }
         },
         {
          "follows": {
           "stopBy": "end",
           "any": [
            {
             "kind": "list_splat_pattern"
            },
            {
             "kind": "keyword_separator"
            }
           ]
          }
         }
        ]
       }
      },
      "first-param": {
       "matches": "positional-param",
       "nthChild": {
        "position": 1,
        "ofRule": {
         "matches": "positional-param"
        }
       },
       "any": [
        {
         "kind": "identifier",
         "pattern": "$P"
        },
        {
         "has": {
          "stopBy": "neighbor",
          "kind": "identifier",
          "nthChild": 1,
          "pattern": "$P"
         }
        }
       ]
      },
      "own-class-binding": {
       "has": {
        "stopBy": {
         "matches": "scope-boundary"
        },
        "kind": "identifier",
        "regex": "^__class__$",
        "binds": {
         "bindings": {
          "min": 1
         }
        }
       }
      },
      "class-cell-reference": {
       "any": [
        {
         "kind": "function_definition",
         "has": {
          "stopBy": {
           "any": [
            {
             "kind": "class_definition"
            },
            {
             "kind": "decorated_definition",
             "has": {
              "stopBy": "neighbor",
              "field": "definition",
              "kind": "class_definition"
             }
            }
           ]
          },
          "matches": "cell-name"
         }
        },
        {
         "kind": "function_definition",
         "inside": {
          "stopBy": "neighbor",
          "kind": "decorated_definition",
          "has": {
           "stopBy": "neighbor",
           "kind": "decorator",
           "has": {
            "stopBy": {
             "any": [
              {
               "kind": "class_definition"
              },
              {
               "kind": "decorated_definition",
               "has": {
                "stopBy": "neighbor",
                "field": "definition",
                "kind": "class_definition"
               }
              }
             ]
            },
            "matches": "cell-name"
           }
          }
         }
        },
        {
         "kind": "lambda",
         "has": {
          "stopBy": "neighbor",
          "field": "body",
          "any": [
           {
            "matches": "cell-name"
           },
           {
            "has": {
             "stopBy": {
              "any": [
               {
                "kind": "class_definition"
               },
               {
                "kind": "decorated_definition",
                "has": {
                 "stopBy": "neighbor",
                 "field": "definition",
                 "kind": "class_definition"
                }
               }
              ]
             },
             "matches": "cell-name"
            }
           }
          ]
         }
        }
       ]
      },
      "slots-dataclass": {
       "kind": "class_definition",
       "inside": {
        "stopBy": "neighbor",
        "kind": "decorated_definition",
        "has": {
         "stopBy": "neighbor",
         "kind": "decorator",
         "has": {
          "stopBy": "neighbor",
          "kind": "call",
          "all": [
           {
            "has": {
             "stopBy": "neighbor",
             "field": "function",
             "any": [
              {
               "kind": "identifier"
              },
              {
               "kind": "attribute"
              }
             ],
             "resolves": {
              "import": [
               "dataclasses.dataclass"
              ]
             }
            }
           },
           {
            "has": {
             "stopBy": "neighbor",
             "field": "arguments",
             "has": {
              "stopBy": "neighbor",
              "kind": "keyword_argument",
