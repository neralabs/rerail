   },
   "violation": {
    "anchor": "capture.ARGS",
    "code": "UP008",
    "message": "Drop the arguments and call `super()`; inside a method it already uses the enclosing class and the method's first parameter.",
    "suppress": {
     "noqa": {
      "codes": [
       "UP008"
      ]
