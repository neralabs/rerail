          "matches": "bare-super-p"
         }
        },
        {
         "kind": "list_splat",
         "has": {
          "stopBy": "neighbor",
          "matches": "bare-super-p"
         }
        }
       ]
      },
      "any-super-p": {
       "any": [
        {
         "matches": "bare-super"
        },
        {
         "matches": "builtins-super"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "any-super-p"
         }
        },
        {
         "kind": "list_splat",
         "has": {
          "stopBy": "neighbor",
          "matches": "any-super-p"
         }
        }
       ]
      },
      "ident-p": {
       "any": [
        {
         "kind": "identifier"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "ident-p"
         }
        }
       ]
      },
      "true-p": {
       "any": [
        {
         "kind": "true"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "true-p"
         }
        }
       ]
      },
      "cell-name": {
       "kind": "identifier",
       "regex": "^(?:super|__class__)$",
       "not": {
        "any": [
         {
          "binds": {
           "bindings": {
            "min": 1
           }
          }
         },
         {
          "inside": {
           "stopBy": "neighbor",
           "field": "attribute",
           "kind": "attribute"
          }
         },
         {
          "inside": {
           "stopBy": "neighbor",
           "field": "name",
           "kind": "keyword_argument"
          }
         }
        ]
       }
      },
      "chain": {
       "params": [
        "C"
       ],
       "rule": {
        "any": [
         {
          "kind": "parenthesized_expression",
          "has": {
           "stopBy": "neighbor",
           "not": {
            "kind": "comment"
           },
           "matches": {
            "chain": {
             "C": "$C"
            }
           }
          }
         },
         {
          "all": [
           {
            "any": [
             {
              "kind": "identifier",
              "pattern": "$SEG"
             },
             {
              "kind": "attribute",
              "has": {
               "stopBy": "neighbor",
               "field": "attribute",
               "pattern": "$SEG"
              }
             }
            ]
           },
           {
            "inside": {
             "stopBy": "end",
             "kind": "class_definition",
             "pattern": "$K",
             "compare": {
              "left": "K",
              "op": "eq",
              "right": "C",
              "text": "node"
             },
             "has": {
              "stopBy": "neighbor",
              "field": "name",
              "pattern": "$KN"
             }
            }
           },
           {
            "compare": {
             "left": "KN",
             "op": "eq",
             "right": "SEG"
            }
           },
           {
            "any": [
             {
              "kind": "identifier",
              "inside": {
               "stopBy": "end",
               "kind": "class_definition",
               "pattern": "$K2",
               "compare": {
                "left": "K2",
                "op": "eq",
                "right": "C",
                "text": "node"
               },
               "not": {
                "inside": {
                 "stopBy": "end",
                 "kind": "class_definition"
                }
               }
              }
             },
             {
              "kind": "attribute",
              "inside": {
               "stopBy": "end",
               "kind": "class_definition",
               "pattern": "$PC",
               "has": {
                "stopBy": {
                 "kind": "class_definition"
                },
                "kind": "class_definition",
                "pattern": "$CC",
                "compare": {
                 "left": "CC",
                 "op": "eq",
                 "right": "C",
                 "text": "node"
                }
               }
              },
              "has": {
               "stopBy": "neighbor",
               "field": "object",
               "matches": {
                "chain": {
                 "C": "$PC"
                }
               }
              }
             }
            ]
           }
          ]
         }
        ]
       }
      }
     },
     "rule": {
      "kind": "call",
      "all": [
       {
        "has": {
         "stopBy": "neighbor",
         "field": "function",
         "matches": "any-super-p"
        }
       },
       {
        "arguments": {
         "signature": [
          "cls_slot",
          "obj_slot",
          "over_slot",
          "/"
         ],
         "bind": {
          "A": "cls_slot",
          "B": "obj_slot"
         },
         "absent": [
          "over_slot"
         ]
        }
       },
       {
        "has": {
         "stopBy": "neighbor",
         "field": "arguments",
         "pattern": "$ARGS"
        }
       },
       {
        "any": [
         {
          "has": {
           "stopBy": "neighbor",
           "field": "function",
           "matches": "bare-super-p"
          }
         },
         {
          "inside": {
           "stopBy": {
            "matches": "scope-boundary"
           },
           "matches": "class-cell-reference",
           "not": {
            "matches": "own-class-binding"
           }
          }
         }
        ]
       },
       {
        "not": {
         "inside": {
          "stopBy": {
           "matches": "scope-boundary"
          },
          "any": [
           {
            "kind": "parameters"
           },
           {
            "kind": "lambda_parameters"
           },
           {
            "kind": "type",
            "inside": {
             "stopBy": "neighbor",
             "field": "return_type",
             "kind": "function_definition"
            }
           }
          ]
         }
        }
       },
       {
        "inside": {
         "stopBy": {
          "matches": "scope-boundary"
         },
         "matches": "callable",
         "has": {
          "stopBy": "neighbor",
          "field": "parameters",
          "has": {
           "stopBy": "neighbor",
           "matches": "first-param"
          }
         }
        }
       },
       {
        "has": {
         "stopBy": "neighbor",
         "field": "arguments",
         "has": {
          "stopBy": "neighbor",
          "nthChild": {
           "position": 2,
           "ofRule": {
            "not": {
             "kind": "comment"
            }
           }
          },
          "matches": "ident-p",
          "any": [
           {
            "kind": "identifier",
            "pattern": "$B2"
           },
           {
            "has": {
             "stopBy": "end",
             "kind": "identifier",
             "pattern": "$B2"
            }
           }
          ]
         }
        }
       },
       {
        "compare": {
         "left": "B2",
         "op": "eq",
         "right": "P"
        }
       },
       {
        "not": {
         "inside": {
          "stopBy": {
           "kind": "class_definition"
          },
          "kind": "class_definition",
          "matches": "slots-dataclass"
         }
        }
       },
       {
        "any": [
         {
          "all": [
           {
            "has": {
             "stopBy": "neighbor",
             "field": "arguments",
             "has": {
              "stopBy": "neighbor",
              "nthChild": {
               "position": 1,
               "ofRule": {
                "not": {
                 "kind": "comment"
                }
               }
              },
              "matches": "ident-p",
              "any": [
               {
                "regex": "^__class__$"
               },
               {
                "has": {
                 "stopBy": "end",
                 "kind": "identifier",
                 "regex": "^__class__$"
                }
               }
              ]
             }
            }
           },
           {
            "inside": {
             "stopBy": {
              "matches": "scope-boundary"
             },
             "matches": "callable",
             "not": {
              "matches": "own-class-binding"
             }
            }
           },
           {
            "inside": {
             "stopBy": "end",
             "kind": "class_definition"
            }
           }
          ]
         },
         {
          "all": [
           {
            "inside": {
             "stopBy": {
              "kind": "class_definition"
             },
             "kind": "class_definition",
             "pattern": "$C0"
            }
           },
           {
            "has": {
             "stopBy": "neighbor",
             "field": "arguments",
             "has": {
              "stopBy": "neighbor",
              "nthChild": {
               "position": 1,
               "ofRule": {
                "not": {
                 "kind": "comment"
                }
               }
              },
              "matches": {
               "chain": {
                "C": "$C0"
               }
              }
             }
            }
           },
           {
            "not": {
             "has": {
              "stopBy": "neighbor",
              "field": "arguments",
              "all": [
               {
                "has": {
                 "stopBy": "neighbor",
                 "nthChild": {
                  "position": 1,
                  "ofRule": {
                   "not": {
                    "kind": "comment"
                   }
                  }
                 },
                 "matches": "ident-p",
                 "any": [
                  {
                   "kind": "identifier",
                   "pattern": "$T0"
                  },
                  {
                   "has": {
                    "stopBy": "end",
                    "kind": "identifier",
                    "pattern": "$T0"
                   }
                  }
                 ]
                }
               },
               {
                "inside": {
                 "stopBy": "neighbor",
                 "kind": "call",
                 "inside": {
                  "stopBy": {
                   "matches": "scope-boundary"
                  },
                  "matches": "callable",
                  "any": [
                   {
                    "has": {
                     "stopBy": {
                      "matches": "scope-boundary"
                     },
                     "compare": {
                      "left": "SH",
                      "op": "eq",
                      "right": "T0"
                     },
                     "any": [
                      {
                       "any": [
                        {
                         "kind": "identifier"
                        },
                        {
                         "kind": "dotted_name"
                        }
                       ],
                       "pattern": "$SH",
                       "binds": {
                        "bindings": {
                         "min": 1
                        }
                       }
                      },
                      {
                       "any": [
                        {
                         "kind": "function_definition"
                        },
                        {
                         "kind": "class_definition"
                        }
                       ],
                       "has": {
                        "stopBy": "neighbor",
                        "field": "name",
                        "pattern": "$SH"
                       }
                      },
                      {
                       "kind": "identifier",
                       "pattern": "$SH",
                       "inside": {
                        "stopBy": "neighbor",
                        "kind": "nonlocal_statement"
                       }
                      }
                     ]
                    }
                   },
                   {
                    "has": {
                     "stopBy": {
                      "any": [
                       {
                        "kind": "function_definition"
                       },
                       {
                        "kind": "lambda"
                       },
                       {
                        "kind": "class_definition"
                       }
                      ]
