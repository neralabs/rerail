               },
               {
                "has": {
                 "stopBy": "neighbor",
                 "field": "value",
                 "matches": "true-p"
                }
               }
              ]
             }
            }
           }
          ]
         }
        }
       }
      },
      "bare-super-p": {
       "any": [
        {
         "matches": "bare-super"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
