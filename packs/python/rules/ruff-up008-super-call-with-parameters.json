                     "kind": "named_expression",
                     "has": {
                      "stopBy": "neighbor",
                      "field": "name",
                      "pattern": "$SW"
                     },
                     "compare": {
                      "left": "SW",
                      "op": "eq",
                      "right": "T0"
                     }
                    }
