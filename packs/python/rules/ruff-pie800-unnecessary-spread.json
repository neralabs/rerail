{
  "format": "rerail.policy/v1",
  "id": "ruff-pie800-unnecessary-spread",
  "revision": 1,
  "mode": "steer",
  "description": "Write the entries directly instead of spreading a dict literal into another Python dict literal.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unnecessary-spread",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "spread-slot": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "dictionary_splat",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "dictionary"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "spread-slot"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "dictionary",
            "matches": "spread-slot"
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PIE800",
        "message": "Write the entries of this spread dict directly into the outer dict literal instead of using `**`.",
        "suppress": {
          "noqa": {
            "codes": [
              "PIE800"
            ]
          }
        }
      }
    }
  ]
}
