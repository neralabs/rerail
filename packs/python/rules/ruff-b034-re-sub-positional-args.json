{
  "format": "rerail.policy/v1",
  "id": "ruff-b034-re-sub-positional-args",
  "revision": 1,
  "mode": "steer",
  "description": "Pass count, maxsplit and flags as keyword arguments to re.sub(), re.subn() and re.split(); their positional order is easy to get wrong.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "re-sub-positional-args",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "re-sub": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "re.sub",
                      "re.subn"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "re-sub"
                  }
                }
              ]
            },
            "re-split": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "re.split"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "re-split"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "any": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "argument_list",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "kind": "keyword_argument"
                          },
                          {
                            "kind": "dictionary_splat"
                          },
                          {
                            "kind": "comment"
                          },
                          {
                            "regex": "^[(),]$"
                          }
                        ]
                      }
                    },
                    "min": 4
                  },
                  "follows": {
                    "stopBy": "neighbor",
                    "matches": "re-sub"
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "argument_list",
                  "count": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "kind": "keyword_argument"
                          },
                          {
                            "kind": "dictionary_splat"
                          },
                          {
                            "kind": "comment"
                          },
                          {
                            "regex": "^[(),]$"
                          }
                        ]
                      }
                    },
                    "min": 3
                  },
                  "follows": {
                    "stopBy": "neighbor",
                    "matches": "re-split"
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B034",
        "message": "Pass count, maxsplit and flags to this re call as keywords; their positional order is easy to get wrong.",
        "suppress": {
          "noqa": {
            "codes": [
              "B034"
            ]
          }
        }
      }
    }
  ]
}
