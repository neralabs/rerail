{
  "format": "rerail.policy/v1",
  "id": "bandit-b401-import-telnetlib",
  "revision": 1,
  "mode": "steer",
  "description": "Detect direct imports of the insecure telnetlib module.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B401",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import telnetlib"
              },
              {
                "pattern": "import telnetlib as $ALIAS"
              },
              {
                "pattern": "from telnetlib import $$$NAMES"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B401",
        "anchor": "witness.span",
        "message": "A telnet-related module is being imported. Telnet is insecure; use SSH or another encrypted protocol.",
        "suppress": {
          "nosec": {
            "codes": [
              "B401"
            ]
          }
        }
      }
    }
  ]
}
