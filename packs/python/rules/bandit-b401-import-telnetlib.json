{
  "format": "rerail.policy/v1",
  "id": "bandit-b401-import-telnetlib",
  "revision": 2,
  "mode": "steer",
  "description": "Remove imports of telnetlib; Telnet sends credentials and data unencrypted, so use SSH or another encrypted protocol.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B401",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "any": [
                    {
                      "kind": "dotted_name"
                    },
                    {
                      "kind": "aliased_import"
                    }
                  ],
                  "regex": "^telnetlib"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "field": "module_name",
                  "regex": "^[.\\s]*telnetlib"
                }
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]+$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^telnetlib",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B401",
        "anchor": "witness.span",
        "message": "Remove this telnetlib import and use SSH or another encrypted protocol instead.",
        "suppress": {
          "nosec": {
            "codes": [
              "B401"
            ]
          }
        }
      }
    }
  ]
}
