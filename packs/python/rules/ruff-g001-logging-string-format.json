{
  "format": "rerail.policy/v1",
  "id": "ruff-g001-logging-string-format",
  "revision": 1,
  "mode": "steer",
  "description": "Pass values to a logging call as arguments instead of formatting its message with str.format; the logger then formats only records it emits.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "logging-string-format",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "logging-ref": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "logging",
                      "flask.current_app.logger"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "logging-ref"
                  }
                }
              ]
            },
            "factory": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "logging.getLogger",
                      "logging.Logger"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "factory"
                  }
                }
              ]
            },
            "name-chain": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute",
                  "has": {
                    "field": "object",
                    "matches": "name-chain"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "name-chain"
                  }
                }
              ]
            },
            "log-tail": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^(?:log|LOG)|(?:logger|logging|LOGGER|LOGGING)$"
                },
                {
                  "kind": "attribute",
                  "has": {
                    "field": "attribute",
                    "regex": "^(?:log|LOG)|(?:logger|logging|LOGGER|LOGGING)$"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "log-tail"
                  }
                }
              ]
            },
            "logger": {
              "any": [
                {
                  "matches": "logging-ref"
                },
                {
                  "kind": "call",
                  "has": {
                    "field": "function",
                    "matches": "factory"
                  }
                },
                {
                  "matches": "name-chain",
                  "all": [
                    {
                      "matches": "log-tail"
                    }
                  ],
                  "not": {
                    "resolves": {
                      "import": true
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "logger"
                  }
                }
              ]
            },
            "level-callee": {
              "any": [
                {
                  "kind": "attribute",
                  "has": {
                    "field": "attribute",
                    "regex": "^(?:debug|critical|error|exception|info|warn|warning)$"
                  },
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "matches": "logger"
                      }
                    }
                  ]
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "import": [
                      "logging.debug",
                      "logging.critical",
                      "logging.error",
                      "logging.exception",
                      "logging.info",
                      "logging.warn",
                      "logging.warning"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "level-callee"
                  }
                }
              ]
            },
            "log-callee": {
              "any": [
                {
                  "kind": "attribute",
                  "has": {
                    "field": "attribute",
                    "regex": "^log$"
                  },
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "matches": "logger"
                      }
                    }
                  ]
                },
                {
                  "kind": "identifier",
                  "resolves": {
                    "import": [
                      "logging.log"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "log-callee"
                  }
                }
              ]
            },
            "msg": {
              "any": [
                {
                  "kind": "call",
                  "has": {
                    "field": "function",
                    "matches": "format-attr"
                  },
                  "pattern": "$X"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "msg"
                  }
                }
              ]
            },
            "format-attr": {
              "any": [
                {
                  "kind": "attribute",
                  "has": {
                    "field": "attribute",
                    "regex": "^format$"
                  },
                  "all": [
                    {
                      "has": {
                        "field": "object",
                        "matches": "literal"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "format-attr"
                  }
                }
              ]
            },
            "literal": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string_start",
                      "regex": "[fFtT]"
                    }
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "string_start",
                        "regex": "[fFtT]"
                      }
                    }
                  }
                },
                {
                  "kind": "integer"
                },
                {
                  "kind": "float"
                },
                {
                  "kind": "true"
                },
                {
                  "kind": "false"
                },
                {
                  "kind": "none"
                },
                {
                  "kind": "ellipsis"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "literal"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "any": [
              {
                "has": {
                  "field": "function",
                  "matches": "level-callee"
                },
                "arguments": {
                  "signature": [
                    "msg"
                  ],
                  "bind": {
                    "M": "msg"
                  },
                  "mode": "syntactic"
                }
              },
              {
                "has": {
                  "field": "function",
                  "matches": "log-callee"
                },
                "arguments": {
                  "signature": [
                    "level",
                    "msg"
                  ],
                  "bind": {
                    "M": "msg"
                  },
                  "mode": "syntactic"
                }
              }
            ]
          },
          "constraints": {
            "M": {
              "matches": "msg"
            }
          }
        }
      },
      "violation": {
        "anchor": "capture.X",
        "code": "G001",
        "message": "Pass the values as logger arguments with `%s` placeholders, e.g. `logger.info(\"x=%s\", x)`, instead of `.format()`, doubling any literal `%`; leave it if the logger is not from `logging`.",
        "suppress": {
          "noqa": {
            "codes": [
              "G001"
            ]
          }
        }
      }
    }
  ]
}
