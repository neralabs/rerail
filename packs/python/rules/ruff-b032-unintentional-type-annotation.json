{
  "format": "rerail.policy/v1",
  "id": "ruff-b032-unintentional-type-annotation",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's B032 (unintentional-type-annotation): an annotated statement without a value whose target is a subscript of a name (`d[k]: v`) or an attribute of a name other than `self` (`o.a: v`), inside any parentheses (tree-sitter reads a parenthesized target as a one-element `tuple_pattern`). Reported on the statement.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "unintentional-type-annotation",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "name": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "name"
                  }
                }
              ]
            },
            "non-self-name": {
              "any": [
                {
                  "kind": "identifier",
                  "not": {
                    "regex": "^self$"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "non-self-name"
                  }
                }
              ]
            },
            "target": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "subscript",
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "(?s)."
                          }
                        },
                        "matches": "name"
                      }
                    },
                    {
                      "kind": "attribute",
                      "has": {
                        "stopBy": "neighbor",
                        "not": {
                          "follows": {
                            "stopBy": "neighbor",
                            "regex": "(?s)."
                          }
                        },
                        "matches": "non-self-name"
                      }
                    },
                    {
                      "kind": "tuple_pattern",
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "regex": "^,$"
                        }
                      },
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "target"
                      }
                    }
                  ]
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "target"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "assignment",
            "inside": {
              "stopBy": "neighbor",
              "kind": "expression_statement"
            },
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "type"
                }
              },
              {
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^=$"
                  }
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  },
                  "matches": "target"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B032",
        "message": "Possible unintentional type annotation (using `:`). Did you mean to assign (using `=`)?",
        "suppress": {
          "noqa": {
            "codes": [
              "B032"
            ]
          }
        }
      }
    }
  ]
}
