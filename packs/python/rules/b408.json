{
  "format": "rerail.policy/v1",
  "id": "bandit:b408",
  "revision": 1,
  "mode": "steer",
  "description": "Detect direct imports of xml.dom.minidom.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B408",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import xml.dom.minidom"
              },
              {
                "pattern": "import xml.dom.minidom as $ALIAS"
              },
              {
                "pattern": "from xml.dom.minidom import $$$NAMES"
              },
              {
                "pattern": "from xml.dom import minidom"
              },
              {
                "pattern": "from xml.dom import minidom as $ALIAS"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B408",
        "anchor": "witness.span",
        "message": "xml.dom.minidom parsing may be vulnerable to XML attacks; use defusedxml or defuse the standard library."
      }
    }
  ]
}
