{
  "format": "rerail.policy/v1",
  "id": "bandit-b311-random",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid the random module's generators for anything security-related; their output is predictable, so use the secrets module for tokens, passwords, and keys.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "bandit:B311",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "pattern": "$F($$$ARGS)"
          },
          "constraints": {
            "F": {
              "resolves": {
                "import": [
                  "random.Random",
                  "random.random",
                  "random.randrange",
                  "random.randint",
                  "random.choice",
                  "random.choices",
                  "random.uniform",
                  "random.triangular",
                  "random.randbytes",
                  "random.sample",
                  "random.getrandbits"
                ]
              }
            }
          }
        }
      },
      "violation": {
        "code": "B311",
        "anchor": "witness.span",
        "message": "Use the secrets module instead of random if this value is a token, password, key, or other secret.",
        "suppress": {
          "nosec": {
            "codes": [
              "B311"
            ]
          }
        }
      }
    }
  ]
}
