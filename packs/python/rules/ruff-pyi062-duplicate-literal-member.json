{
  "format": "rerail.policy/v1",
  "id": "ruff-pyi062-duplicate-literal-member",
  "revision": 1,
  "mode": "steer",
  "description": "Remove duplicate members from a Literal type; repeating a value adds nothing.",
  "scope": { "include": ["**/*"], "exclude": [] },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "literal-name": {
            "any": [
              {
                "any": [{"kind": "identifier"}, {"kind": "attribute"}],
                "resolves": { "import": ["typing.Literal", "typing_extensions.Literal", "_typeshed.Literal"] }
              },
              {
                "kind": "parenthesized_expression",
                "has": { "stopBy": "neighbor", "matches": "literal-name" }
              }
            ]
          },
          "literal-sub": {
            "kind": "subscript",
            "has": {
              "stopBy": "neighbor",
              "matches": "literal-name",
              "not": { "follows": {"stopBy": "neighbor", "regex": "(?s)."} }
            }
          },
          "literal-gen": {
            "kind": "generic_type",
            "has": { "stopBy": "neighbor", "kind": "identifier", "matches": "literal-name" }
          },
          "literal": { "any": [{"matches": "literal-sub"}, {"matches": "literal-gen"}] },
          "direct-slot": {
            "any": [
              {
                "inside": { "stopBy": "neighbor", "matches": "literal-sub" },
                "pattern": "$_",
                "not": { "kind": "comment" },
                "follows": { "stopBy": "end", "regex": "^\\[$" }
              },
              {
                "kind": "type",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "type_parameter",
                  "inside": { "stopBy": "neighbor", "matches": "literal-gen" }
                }
              }
            ]
          },
          "tuple-slot": {
            "matches": "direct-slot",
            "any": [{"kind": "tuple"}, {"kind": "type", "has": {"stopBy": "neighbor", "kind": "tuple"}}],
            "not": {
              "any": [
                { "follows": {"stopBy": "end", "matches": "direct-slot"} },
                { "precedes": {"stopBy": "end", "matches": "direct-slot"} }
              ]
            }
          },
          "slot": {
            "any": [
              { "matches": "direct-slot" },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "tuple",
                  "any": [
                    { "matches": "tuple-slot" },
                    { "inside": {"stopBy": "neighbor", "kind": "type", "matches": "tuple-slot"} }
                  ]
                },
                "pattern": "$_",
                "not": { "kind": "comment" }
              }
            ]
          },
          "wraps-literal": {
            "any": [
              { "matches": "literal" },
              {
                "any": [{"kind": "type"}, {"kind": "parenthesized_expression"}],
                "has": { "stopBy": "neighbor", "matches": "wraps-literal" }
              }
            ]
          },
          "wraps-container": {
            "any": [
              { "kind": "subscript" },
              { "kind": "generic_type" },
              {
                "any": [{"kind": "type"}, {"kind": "parenthesized_expression"}],
                "has": { "stopBy": "neighbor", "matches": "wraps-container" }
              }
            ]
          },
          "nested-slot": { "matches": "slot", "all": [{"matches": "wraps-literal"}] },
          "container-slot": { "matches": "slot", "any": [{"matches": "wraps-container"}, {"matches": "tuple-slot"}] },
          "leaf-slot": { "matches": "slot", "not": {"matches": "container-slot"} },
          "in-literal-chain": {
            "any": [
              { "matches": "literal" },
              {
                "kind": "type_parameter",
                "inside": { "stopBy": "neighbor", "matches": "literal-gen" }
              },
              { "matches": "slot" },
              {
                "kind": "tuple",
                "inside": { "stopBy": "neighbor", "kind": "type", "matches": "tuple-slot" }
              },
              { "kind": "parenthesized_expression" }
            ]
          },
          "member-expr": {
            "any": [
              {
                "not": { "any": [{"kind": "type"}, {"kind": "parenthesized_expression"}] },
                "pattern": "$DUP"
              },
              {
                "any": [{"kind": "type"}, {"kind": "parenthesized_expression"}],
                "has": { "stopBy": "neighbor", "matches": "member-expr" }
              }
            ]
          },
          "equal-expr": {
            "any": [
              {
                "not": { "kind": "type" },
                "pattern": "$F",
                "compare": { "left": "F", "op": "eq", "right": "DUP", "text": "structure" }
              },
              {
                "kind": "type",
                "has": {
                  "stopBy": "neighbor",
                  "pattern": "$F",
                  "compare": { "left": "F", "op": "eq", "right": "DUP", "text": "structure" }
                }
              }
            ]
          },
          "deep-slots-have-equal": {
            "any": [
              { "matches": "slots-have-equal" },
              {
                "any": [{"kind": "type"}, {"kind": "parenthesized_expression"}],
                "has": { "stopBy": "neighbor", "matches": "deep-slots-have-equal" }
              }
            ]
          },
          "slots-have-equal": {
            "any": [
              {
                "matches": "literal",
                "any": [
                  {
                    "kind": "subscript",
                    "has": { "stopBy": "neighbor", "matches": "contains-equal" }
                  },
                  {
                    "kind": "generic_type",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "type_parameter",
                      "has": { "stopBy": "neighbor", "matches": "contains-equal" }
                    }
                  }
                ]
              },
              {
                "matches": "tuple-slot",
                "kind": "tuple",
                "has": { "stopBy": "neighbor", "matches": "contains-equal" }
              },
              {
                "matches": "tuple-slot",
                "kind": "type",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "tuple",
                  "has": { "stopBy": "neighbor", "matches": "contains-equal" }
                }
              }
            ]
          },
          "contains-equal": {
            "any": [
              {
                "all": [
                  {
                    "pattern": "$_",
                    "not": { "kind": "comment" },
                    "any": [{"kind": "type"}, {"follows": {"stopBy": "end", "regex": "^[\\[(]$"}}]
                  },
                  { "matches": "equal-expr" },
                  { "not": {"matches": "wraps-container"} },
                  { "not": {"matches": "tuple-slot"} }
                ]
              },
              {
                "all": [
                  {
                    "pattern": "$_",
                    "not": { "kind": "comment" },
                    "any": [{"kind": "type"}, {"follows": {"stopBy": "end", "regex": "^[\\[(]$"}}]
                  },
                  {
                    "any": [
                      { "kind": "subscript" },
                      { "kind": "generic_type" },
                      { "kind": "tuple" },
                      {
                        "any": [{"kind": "type"}, {"kind": "parenthesized_expression"}],
                        "has": {
                          "stopBy": "neighbor",
                          "any": [
                            { "kind": "subscript" },
                            { "kind": "generic_type" },
                            { "kind": "tuple" },
                            { "kind": "type" },
                            { "kind": "parenthesized_expression" }
                          ]
                        }
                      }
                    ]
                  },
                  { "matches": "deep-slots-have-equal" }
                ]
              }
            ]
          },
          "string-duplicate-member": {
            "any": [{"kind": "string"}, {"kind": "concatenated_string"}],
            "parse": {
              "grammar": "annotation",
              "has": {
                "stopBy": "end",
                "any": [{ "matches": "duplicate-member", "capture": "D" }, { "matches": "string-duplicate-member" }]
              }
            }
          },
          "duplicate-member": {
            "matches": "leaf-slot",
            "all": [{"matches": "member-expr"}],
            "any": [
              { "follows": {"stopBy": "end", "matches": "contains-equal"} },
              {
                "inside": {
                  "stopBy": { "not": {"matches": "in-literal-chain"} },
                  "matches": "nested-slot",
                  "follows": { "stopBy": "end", "matches": "contains-equal" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "duplicate-literal-member",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "inside": { "stopBy": "neighbor", "any": [{"kind": "subscript"}, {"kind": "tuple"}] },
                    "pattern": "$_"
                  },
                  { "kind": "type", "inside": {"stopBy": "neighbor", "kind": "type_parameter"} }
                ]
              },
              { "matches": "duplicate-member" }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.DUP",
        "code": "PYI062",
        "message": "Remove the repeated member `$DUP` from this Literal; an earlier member already covers it.",
        "suppress": { "noqa": {"codes": ["PYI062"]} }
      }
    },
    {
      "id": "duplicate-literal-member-in-string",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "string-duplicate-member"
          }
        }
      },
      "violation": {
        "anchor": "capture.D",
        "each": "D",
        "code": "PYI062",
        "message": "Remove the repeated member `$D` from this Literal; an earlier member already covers it.",
        "suppress": { "noqa": {"codes": ["PYI062"]} }
      }
    }
  ]
}
