{
  "format": "rerail.policy/v1",
  "id": "ruff-ret506-superfluous-else-raise",
  "revision": 1,
  "mode": "steer",
  "description": "Remove the else or elif after an if branch that raises, and dedent its code; the branch already leaves the function.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "superfluous-else-raise",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "analysed-function": {
              "kind": "function_definition",
              "all": [
                {
                  "not": {
                    "has": {
                      "stopBy": {
                        "any": [
                          {
                            "kind": "function_definition"
                          },
                          {
                            "kind": "class_definition"
                          }
                        ]
                      },
                      "kind": "yield"
                    }
                  }
                },
                {
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "block",
                      "has": {
                        "stopBy": "neighbor",
                        "kind": "return_statement"
                      },
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "not": {
                            "any": [
                              {
                                "kind": "return_statement"
                              },
                              {
                                "kind": "comment"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "none-literal": {
              "any": [
                {
                  "kind": "none"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "none-literal"
                  }
                }
              ]
            },
            "value-return": {
              "kind": "return_statement",
              "has": {
                "stopBy": "neighbor",
                "regex": "(?s).",
                "not": {
                  "any": [
                    {
                      "regex": "^return$"
                    },
                    {
                      "kind": "comment"
                    },
                    {
                      "matches": "none-literal"
                    }
                  ]
                }
              }
            },
            "own-return": {
              "kind": "return_statement"
            },
            "has-result": {
              "has": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "class_definition"
                    }
                  ]
                },
                "matches": "value-return"
              }
            }
          },
          "rule": {
            "regex": "^(?<BRANCH>elif|else)$",
            "inside": {
              "stopBy": "neighbor",
              "any": [
                {
                  "kind": "elif_clause"
                },
                {
                  "kind": "else_clause"
                }
              ],
              "not": {
                "follows": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "elif_clause"
                    },
                    {
                      "kind": "else_clause"
                    }
                  ]
                }
              },
              "inside": {
                "stopBy": "neighbor",
                "kind": "if_statement",
                "has": {
                  "stopBy": "neighbor",
                  "kind": "block",
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "raise_statement",
                    "not": {
                      "follows": {
                        "stopBy": "end",
                        "any": [
                          {
                            "kind": "return_statement"
                          },
                          {
                            "kind": "continue_statement"
                          },
                          {
                            "kind": "break_statement"
                          }
                        ]
                      }
                    }
                  }
                },
                "inside": {
                  "stopBy": {
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      }
                    ]
                  },
                  "kind": "function_definition",
                  "all": [
                    {
                      "matches": "analysed-function"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "RET506",
        "message": "Remove this `$BRANCH` and dedent its body, since the branch above already raises; turn an `elif` into a plain `if`.",
        "suppress": {
          "noqa": {
            "codes": [
              "RET506"
            ]
          }
        }
      }
    }
  ]
}
