  "mode": "steer",
  "description": "Port of Ruff's B022 (useless-contextlib-suppress): a call to `contextlib.suppress` with no positional arguments, reported on the call. The callee (parentheses transparent) resolves to `contextlib.suppress` with `resolves` (imports and shadowing as Ruff's semantic model sees them).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "useless-contextlib-suppress",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "suppress": {
              "any": [
                {
                  "any": [
                    {
                      "kind": "identifier"
                    },
                    {
                      "kind": "attribute"
                    }
                  ],
                  "resolves": {
                    "import": [
                      "contextlib.suppress"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "suppress"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "call",
            "has": {
              "stopBy": "neighbor",
              "kind": "argument_list",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "not": {
                    "any": [
                      {
                        "kind": "keyword_argument"
                      },
                      {
                        "kind": "dictionary_splat"
                      },
                      {
                        "kind": "comment"
                      },
                      {
                        "regex": "^[(),]$"
                      }
                    ]
                  }
                }
              },
              "follows": {
                "stopBy": "neighbor",
                "matches": "suppress"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B022",
        "message": "No arguments passed to `contextlib.suppress`. No exceptions will be suppressed and therefore this context manager is redundant",
        "suppress": {
          "noqa": {
            "codes": [
              "B022"
            ]
          }
        }
      }
    }
  ]
