{
  "format": "rerail.policy/v1",
  "id": "ruff:F634",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's F634 (if-tuple) with default settings: the test of an `if` or `elif` branch (not a conditional expression, not `while`) that is a non-empty tuple, reported on the tuple (inside any extra parentheses).",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "if-tuple",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "non-empty-tuple": {
              "any": [
                {
                  "kind": "tuple",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "any": [
                        {
                          "regex": "^[(),]$"
                        },
                        {
                          "kind": "comment"
                        }
                      ]
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "non-empty-tuple"
                  }
                }
              ]
            },
            "branch-test": {
              "any": [
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^(if|elif)$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "if_statement"
                      },
                      {
                        "kind": "elif_clause"
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "branch-test"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "tuple",
            "all": [
              {
                "matches": "non-empty-tuple"
              },
              {
                "matches": "branch-test"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F634",
        "message": "If test is a tuple, which is always `True`",
        "suppress": {
          "noqa": {
            "codes": [
              "F634"
            ]
          }
        }
      }
    }
  ]
}
