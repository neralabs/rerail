{
  "format": "rerail.policy/v1",
  "id": "bandit-b405-import-xml-etree",
  "revision": 2,
  "mode": "steer",
  "description": "Avoid importing xml.etree.ElementTree or cElementTree; use defusedxml instead, since the standard parsers are open to XML attacks on untrusted input.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B405",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "any": [
                    {
                      "kind": "dotted_name"
                    },
                    {
                      "kind": "aliased_import"
                    }
                  ],
                  "regex": "^(?:xml\\s*\\.\\s*etree\\s*\\.\\s*cElementTree|xml\\s*\\.\\s*etree\\s*\\.\\s*ElementTree)"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "field": "module_name",
                  "regex": "^[.\\s]*(?:xml\\s*\\.\\s*etree\\s*\\.\\s*cElementTree|xml\\s*\\.\\s*etree\\s*\\.\\s*ElementTree)"
                }
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]*xml\\s*\\.\\s*etree$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^(?:cElementTree|ElementTree)",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B405",
        "anchor": "witness.span",
        "message": "ElementTree XML parsing may be vulnerable to XML attacks; use defusedxml or defuse the standard library.",
        "suppress": {
          "nosec": {
            "codes": [
              "B405"
            ]
          }
        }
      }
    }
  ]
}
