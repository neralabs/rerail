{
  "format": "rerail.policy/v1",
  "id": "ruff-pt006-pytest-parametrize-names-wrong-type",
  "revision": 1,
  "mode": "steer",
  "description": "Pass pytest.mark.parametrize names as a tuple of strings, or a plain string for a single name, not a comma-separated string or a list.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "shared",
      "define": {
        "language": "python",
        "utils": {
          "parametrize": {
            "any": [
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "parametrize"
                }
              },
              {
                "any": [
                  {
                    "kind": "identifier"
                  },
                  {
                    "kind": "attribute"
                  }
                ],
                "resolves": {
                  "import": [
                    "pytest.mark.parametrize"
                  ]
                }
              }
            ]
          },
          "positional": {
            "not": {
              "any": [
                {
                  "kind": "keyword_argument"
                },
                {
                  "kind": "dictionary_splat"
                },
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                },
                {
                  "regex": "^[(),]$"
                }
              ]
            }
          },
          "pos0": {
            "matches": "positional",
            "not": {
              "any": [
                {
                  "kind": "list_splat"
                },
                {
                  "follows": {
                    "stopBy": "end",
                    "matches": "positional"
                  }
                }
              ]
            }
          },
          "pos1": {
            "matches": "positional",
            "nthChild": {
              "position": 2,
              "ofRule": {
                "matches": "positional"
              }
            },
            "not": {
              "any": [
                {
                  "kind": "list_splat"
                },
                {
                  "follows": {
                    "stopBy": "end",
                    "kind": "list_splat"
                  }
                }
              ]
            }
          },
          "kw-names": {
            "kind": "keyword_argument",
            "has": {
              "field": "name",
              "regex": "^argnames$"
            }
          },
          "kw-values": {
            "kind": "keyword_argument",
            "has": {
              "field": "name",
              "regex": "^argvalues$"
            }
          },
          "param-call": {
            "kind": "call",
            "has": {
              "field": "function",
              "matches": "parametrize"
            },
            "all": [
              {
                "has": {
                  "field": "arguments",
                  "kind": "argument_list",
                  "all": [
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "matches": "kw-names"
                          },
                          {
                            "matches": "pos0"
                          }
                        ]
                      }
                    },
                    {
                      "has": {
                        "stopBy": "neighbor",
                        "any": [
                          {
                            "matches": "kw-values"
                          },
                          {
                            "matches": "pos1"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          },
          "plain-str": {
            "any": [
              {
                "kind": "string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string_start",
                    "regex": "[bBfFtT]"
                  }
                }
              },
              {
                "kind": "concatenated_string",
                "not": {
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "string",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string_start",
                      "regex": "[bBfFtT]"
                    }
                  }
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "plain-str"
                }
              }
            ]
          },
          "multi-str": {
            "any": [
              {
                "matches": "plain-str",
                "any": [
                  {
                    "kind": "string"
                  },
                  {
                    "kind": "concatenated_string"
                  }
                ],
                "value": {
                  "regex": "[^ \\t\\f,][^,]*,[ \\t\\f,]*[^ \\t\\f,]"
                }
              },
              {
                "kind": "parenthesized_expression",
                "has": {
                  "stopBy": "neighbor",
                  "matches": "multi-str"
                }
              }
            ]
          },
          "elem": {
            "not": {
              "any": [
                {
                  "kind": "comment"
                },
                {
                  "kind": "line_continuation"
                },
                {
                  "regex": "^[\\[\\](),]$"
                }
              ]
            }
          },
          "single-seq": {
            "any": [
              {
                "kind": "tuple"
              },
              {
                "kind": "list"
              }
            ],
            "has": {
              "stopBy": "neighbor",
              "matches": "elem"
            },
            "not": {
              "has": {
                "stopBy": "neighbor",
                "matches": "elem",
                "follows": {
                  "stopBy": "end",
                  "matches": "elem"
                }
              }
            }
          },
          "names-slot": {
            "any": [
              {
                "inside": {
                  "stopBy": "neighbor",
                  "field": "value",
                  "matches": "kw-names",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "argument_list",
                    "inside": {
                      "stopBy": "neighbor",
                      "field": "arguments",
                      "matches": "param-call"
                    }
                  }
                }
              },
              {
                "matches": "pos0",
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "argument_list",
                  "inside": {
                    "stopBy": "neighbor",
                    "field": "arguments",
                    "matches": "param-call"
                  },
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "matches": "kw-names"
                    }
                  }
                }
              }
            ]
          },
          "names-expr": {
            "any": [
              {
                "matches": "names-slot"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "kind": "parenthesized_expression",
                  "matches": "names-expr"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "csv-names",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "string"
              },
              {
                "kind": "concatenated_string"
              },
              {
                "kind": "parenthesized_expression"
              }
            ],
            "matches": "multi-str",
            "all": [
              {
                "matches": "names-slot"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PT006",
        "message": "Pass several parametrize names as a tuple of strings, `(\"a\", \"b\")`, instead of one comma-separated string.",
        "suppress": {
          "noqa": {
            "codes": [
              "PT006"
            ]
          }
        }
      }
    },
    {
      "id": "single-name-sequence",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "matches": "single-seq",
            "all": [
              {
                "matches": "names-expr"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PT006",
        "message": "Pass a single parametrize name as a plain string and unpack each one-item row of values the same way; leave it if the rows are not literal one-item sequences.",
        "suppress": {
          "noqa": {
            "codes": [
              "PT006"
            ]
          }
        }
      }
    },
    {
      "id": "list-names",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "list",
            "not": {
              "matches": "single-seq"
            },
            "all": [
              {
                "matches": "names-expr"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PT006",
        "message": "Pass the parametrize names as a tuple, `(\"a\", \"b\")`, instead of a list.",
        "suppress": {
          "noqa": {
            "codes": [
              "PT006"
            ]
          }
        }
      }
    }
  ]
}
