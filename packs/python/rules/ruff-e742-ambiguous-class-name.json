{
  "format": "rerail.policy/v1",
  "id": "ruff-e742-ambiguous-class-name",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid naming classes l, I or O; in many fonts they are hard to tell apart from 1 and 0.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "ambiguous-class-name",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "kind": "identifier",
            "regex": "^(?<NAME>[lIO])$",
            "inside": {
              "stopBy": "neighbor",
              "kind": "class_definition"
            },
            "follows": {
              "stopBy": "neighbor",
              "regex": "^(?:class|def)$"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "E742",
        "message": "Rename class `$NAME` to a descriptive name; in many fonts it is easy to confuse with 1 or 0.",
        "suppress": {
          "noqa": {
            "codes": [
              "E742"
            ]
          }
        }
      }
    }
  ]
}
