{
  "format": "rerail.policy/v1",
  "id": "bandit-b406-import-xml-sax",
  "revision": 3,
  "mode": "steer",
  "description": "Avoid parsing XML with xml.sax (importing only its saxutils helpers is fine); it is open to XML attacks, so use defusedxml.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B406",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "kind": "import_statement",
                "has": {
                  "any": [
                    {
                      "kind": "dotted_name"
                    },
                    {
                      "kind": "aliased_import"
                    }
                  ],
                  "regex": "^xml\\s*\\.\\s*sax"
                }
              },
              {
                "kind": "import_from_statement",
                "has": {
                  "field": "module_name",
                  "regex": "^[.\\s]*xml\\s*\\.\\s*sax"
                }
              },
              {
                "kind": "import_from_statement",
                "all": [
                  {
                    "has": {
                      "field": "module_name",
                      "regex": "^[.\\s]*xml$"
                    }
                  },
                  {
                    "has": {
                      "any": [
                        {
                          "kind": "dotted_name"
                        },
                        {
                          "kind": "aliased_import"
                        }
                      ],
                      "regex": "^sax",
                      "follows": {
                        "stopBy": "end",
                        "regex": "^import$"
                      }
                    }
                  }
                ]
              }
            ],
            "not": {
              "any": [
                {
                  "pattern": "from xml.sax.saxutils import $$$NAMES"
                },
                {
                  "kind": "import_from_statement",
                  "all": [
                    {
                      "has": {
                        "field": "module_name",
                        "regex": "^xml\\s*\\.\\s*sax$"
                      }
                    },
                    {
                      "has": {
                        "any": [
                          {
                            "kind": "dotted_name"
                          },
                          {
                            "kind": "aliased_import"
                          }
                        ],
                        "follows": {
                          "stopBy": "end",
                          "regex": "^import$"
                        }
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "any": [
                            {
                              "kind": "dotted_name"
                            },
                            {
                              "kind": "aliased_import"
                            }
                          ],
                          "follows": {
                            "stopBy": "end",
                            "regex": "^import$"
                          },
                          "not": {
                            "regex": "^saxutils(?:\\s|$)"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      },
      "violation": {
        "code": "B406",
        "anchor": "witness.span",
        "message": "xml.sax parsing may be vulnerable to XML attacks; use defusedxml or defuse the standard library.",
        "suppress": {
          "nosec": {
            "codes": [
              "B406"
            ]
          }
        }
      }
    }
  ]
}
