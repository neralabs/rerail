{
  "format": "rerail.policy/v1",
  "id": "ruff:B023",
  "revision": 1,
  "mode": "steer",
  "description": "Port of Ruff's B023 (function-uses-loop-variable): a name loaded in the body of a function or lambda defined inside a loop (for, while, or comprehension), when the function neither takes it as a parameter nor stores it anywhere in its body, and the loop assigns it (assignment, augmented or annotated assignment, for or comprehension target; not inside nested functions or lambdas). The function is the first def or unsafe lambda on the way down from the loop; a lambda is safe when it is returned directly, called immediately, a positional argument of `filter`/`reduce`/`map`/`functools.reduce`, or the value of a `key=` keyword. Reported on the name.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "function-uses-loop-variable",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "loop": {
              "any": [
                {
                  "kind": "for_statement"
                },
                {
                  "kind": "while_statement"
                },
                {
                  "kind": "list_comprehension"
                },
                {
                  "kind": "set_comprehension"
                },
                {
                  "kind": "dictionary_comprehension"
                },
                {
                  "kind": "generator_expression"
                }
              ]
            },
            "safe-slot": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "return_statement"
                  }
                },
                {
                  "precedes": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "argument_list"
                      },
                      {
                        "kind": "generator_expression"
                      }
                    ]
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "call"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "argument_list",
                    "follows": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "identifier",
                          "regex": "^(filter|reduce|map)$"
                        },
                        {
                          "kind": "attribute",
                          "pattern": "functools.reduce"
                        }
                      ]
                    }
                  }
                },
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^=$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "keyword_argument",
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "identifier",
                      "regex": "^key$",
                      "precedes": {
                        "stopBy": "neighbor",
                        "regex": "^=$"
                      }
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "safe-slot"
                  }
                }
              ]
            },
            "function": {
              "any": [
                {
                  "kind": "function_definition"
                },
                {
                  "kind": "lambda",
                  "not": {
                    "matches": "safe-slot"
                  }
                }
              ]
            },
            "target-slot": {
              "any": [
                {
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "assignment"
                      },
                      {
                        "kind": "augmented_assignment"
                      }
                    ]
                  }
                },
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^for$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "for_statement"
                      },
                      {
                        "kind": "for_in_clause"
                      }
                    ]
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "pattern_list"
                      },
                      {
                        "kind": "tuple_pattern"
                      },
                      {
                        "kind": "list_pattern"
                      },
                      {
                        "kind": "list_splat_pattern"
                      },
                      {
                        "kind": "tuple"
                      },
                      {
                        "kind": "list"
                      },
                      {
                        "kind": "parenthesized_expression"
                      }
                    ],
                    "matches": "target-slot"
                  }
                }
              ]
            },
            "store-slot": {
              "any": [
                {
                  "matches": "target-slot"
                },
                {
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "named_expression"
                  }
                },
                {
                  "kind": "as_pattern_target",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "as_pattern",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "with_item"
                    }
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "as_pattern_target"
                      },
                      {
                        "kind": "tuple"
                      },
                      {
                        "kind": "list"
                      },
                      {
                        "kind": "parenthesized_expression"
                      },
                      {
                        "kind": "list_splat_pattern"
                      }
                    ],
                    "matches": "store-slot"
                  }
                }
              ]
            },
            "non-name": {
              "any": [
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^\\.$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "attribute"
                  }
                },
                {
                  "precedes": {
                    "stopBy": "neighbor",
                    "regex": "^=$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "keyword_argument"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "function_definition"
                      },
                      {
                        "kind": "class_definition"
                      },
                      {
                        "kind": "parameters"
                      },
                      {
                        "kind": "lambda_parameters"
                      },
                      {
                        "kind": "list_splat_pattern",
                        "inside": {
                          "stopBy": "neighbor",
                          "any": [
                            {
                              "kind": "parameters"
                            },
                            {
                              "kind": "lambda_parameters"
                            },
                            {
                              "kind": "typed_parameter"
                            }
                          ]
                        }
                      },
                      {
                        "kind": "dictionary_splat_pattern"
                      },
                      {
                        "kind": "dotted_name"
                      },
                      {
                        "kind": "aliased_import"
                      },
                      {
                        "kind": "global_statement"
                      },
                      {
                        "kind": "nonlocal_statement"
                      },
                      {
                        "kind": "keyword_pattern"
                      },
                      {
                        "kind": "splat_pattern"
                      },
                      {
                        "kind": "type_parameter"
                      },
                      {
                        "kind": "as_pattern_target",
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "as_pattern",
                          "inside": {
                            "stopBy": "neighbor",
                            "kind": "except_clause"
                          }
                        }
                      },
                      {
                        "kind": "as_pattern",
                        "inside": {
                          "stopBy": "neighbor",
                          "kind": "case_pattern"
                        }
                      }
                    ]
                  }
                },
                {
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "kind": "default_parameter"
                      },
                      {
                        "kind": "typed_parameter"
                      },
                      {
                        "kind": "typed_default_parameter"
                      }
                    ]
                  }
                }
              ]
            },
            "load-name": {
              "kind": "identifier",
              "not": {
                "any": [
                  {
                    "matches": "non-name"
                  },
                  {
                    "matches": "store-slot"
                  },
                  {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "delete_statement"
                    }
                  }
                ]
              }
            },
            "param-n": {
              "any": [
                {
                  "kind": "identifier",
                  "pattern": "$N"
                },
                {
                  "any": [
                    {
                      "kind": "list_splat_pattern"
                    },
                    {
                      "kind": "dictionary_splat_pattern"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "kind": "identifier",
                    "pattern": "$N"
                  }
                },
                {
                  "any": [
                    {
                      "kind": "default_parameter"
                    },
                    {
                      "kind": "typed_parameter"
                    },
                    {
                      "kind": "typed_default_parameter"
                    }
                  ],
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "(?s)."
                      }
                    },
                    "matches": "param-n"
                  }
                }
              ]
            },
            "loop-assigns-n": {
              "matches": "loop",
              "has": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "lambda"
                    }
                  ]
                },
                "kind": "identifier",
                "pattern": "$N",
                "matches": "target-slot"
              }
            },
            "unbound-in-function": {
              "matches": "function",
              "not": {
                "any": [
                  {
                    "has": {
                      "stopBy": "neighbor",
                      "any": [
                        {
                          "kind": "parameters"
                        },
                        {
                          "kind": "lambda_parameters"
                        }
                      ],
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "param-n"
                      }
                    }
                  },
                  {
                    "has": {
                      "stopBy": "end",
                      "kind": "identifier",
                      "pattern": "$N",
                      "matches": "store-slot"
                    }
                  }
                ]
              },
              "inside": {
                "stopBy": {
                  "any": [
                    {
                      "kind": "function_definition"
                    },
                    {
                      "kind": "lambda",
                      "not": {
                        "matches": "safe-slot"
                      }
                    }
                  ]
                },
                "matches": "loop-assigns-n"
              }
            },
            "function-body": {
              "any": [
                {
                  "kind": "block",
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "function_definition",
                    "matches": "unbound-in-function"
                  }
                },
                {
                  "follows": {
                    "stopBy": "neighbor",
                    "regex": "^:$"
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "lambda",
                    "matches": "unbound-in-function"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "identifier",
            "pattern": "$N",
            "matches": "load-name",
            "any": [
              {
                "matches": "function-body"
              },
              {
                "inside": {
                  "stopBy": "end",
                  "matches": "function-body"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "B023",
        "message": "Function definition does not bind loop variable `$N`"
      }
    }
  ]
}