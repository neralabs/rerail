                }
              ],
              "resolves": {
                "import": [
                  "os.getcwdb"
                ]
              }
            },
            "callee": {
              "any": [
                {
                  "matches": "target",
                  "pattern": "$F"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee"
                  }
                }
              ]
            },
            "ann-args": {
              "any": [
                {
                  "kind": "argument_list"
                },
                {
                  "kind": "generator_expression"
                }
              ]
            },
            "ann-call": {
              "kind": "call",
              "has": {
                "stopBy": "neighbor",
                "matches": "callee",
                "precedes": {
                  "stopBy": "neighbor",
                  "matches": "ann-args"
                }
              }
            },
            "arg-name": {
              "kind": "identifier",
              "not": {
                "any": [
                  {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "^\\.$"
                    }
                  },
                  {
                    "precedes": {
                      "stopBy": "neighbor",
                      "regex": "^=$"
                    },
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "keyword_argument"
                    }
                  }
                ]
              }
            },
            "ann-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "escape_sequence"
                    }
                  },
                  "parse": {
                    "grammar": "annotation",
                    "has": {
                      "stopBy": "end",
                      "any": [
                        {
                          "matches": "ann-call"
