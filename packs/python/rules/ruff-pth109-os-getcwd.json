                                  },
                                  {
                                    "has": {
                                      "stopBy": "end",
                                      "kind": "identifier",
                                      "not": {
                                        "follows": {
                                          "stopBy": "neighbor",
                                          "regex": "^\\.$"
                                        }
                                      },
                                      "pattern": "$H"
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "not": {
                                "has": {
                                  "stopBy": "neighbor",
                                  "matches": "ann-args",
                                  "has": {
                                    "stopBy": "end",
                                    "matches": "arg-name",
                                    "not": {
                                      "pattern": "$H"
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "matches": "ann-string"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "any": [
              {
                "kind": "call",
                "has": {
                  "field": "function",
                  "matches": "callee"
                }
              },
              {
                "matches": "ann-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.F",
        "code": "PTH109",
        "message": "Use `Path.cwd()` from pathlib instead of `os.getcwdb()`; it returns a `Path`, not bytes, so leave it where a bytes value is required.",
        "suppress": {
          "noqa": {
            "codes": [
              "PTH109"
            ]
          }
        },
        "each": "F"
      }
    }
  ]
}
