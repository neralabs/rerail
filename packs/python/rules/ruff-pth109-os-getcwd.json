{
  "format": "rerail.policy/v1",
  "id": "ruff-pth109-os-getcwd",
  "revision": 1,
  "mode": "steer",
  "description": "Use Path.cwd() instead of os.getcwd() or os.getcwdb(); path objects read better than string-based os calls.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "os-getcwd",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "target": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
                  "kind": "attribute"
                }
              ],
              "resolves": {
                "import": [
                  "os.getcwd"
                ]
              }
            },
            "callee": {
              "any": [
                {
                  "matches": "target",
                  "pattern": "$F"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "callee"
                  }
                }
              ]
            },
            "ann-args": {
              "any": [
                {
                  "kind": "argument_list"
                },
                {
                  "kind": "generator_expression"
                }
              ]
            },
            "ann-call": {
              "kind": "call",
              "has": {
                "stopBy": "neighbor",
                "matches": "callee",
                "precedes": {
                  "stopBy": "neighbor",
                  "matches": "ann-args"
                }
              }
            },
            "arg-name": {
              "kind": "identifier",
              "not": {
                "any": [
                  {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "^\\.$"
                    }
                  },
                  {
                    "precedes": {
                      "stopBy": "neighbor",
                      "regex": "^=$"
                    },
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "keyword_argument"
                    }
                  }
                ]
              }
            },
            "ann-string": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "has": {
                      "stopBy": "end",
                      "kind": "escape_sequence"
                    }
                  },
                  "parse": {
                    "grammar": "annotation",
                    "has": {
                      "stopBy": "end",
                      "any": [
                        {
                          "matches": "ann-call"
                        },
                        {
                          "matches": "ann-string"
                        }
                      ]
                    }
                  }
                },
                {
                  "any": [
                    {
                      "kind": "concatenated_string"
                    },
                    {
                      "kind": "string",
                      "has": {
                        "stopBy": "end",
                        "kind": "escape_sequence"
                      }
                    }
                  ],
                  "parse": {
                    "grammar": "annotation",
                    "has": {
                      "stopBy": "end",
                      "any": [
                        {
                          "matches": "ann-call",
                          "all": [
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "matches": "callee",
                                "any": [
                                  {
                                    "kind": "identifier",
                                    "pattern": "$H"
                                  },
                                  {
                                    "has": {
                                      "stopBy": "end",
                                      "kind": "identifier",
                                      "not": {
                                        "follows": {
                                          "stopBy": "neighbor",
                                          "regex": "^\\.$"
                                        }
                                      },
                                      "pattern": "$H"
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "not": {
                                "has": {
                                  "stopBy": "neighbor",
                                  "matches": "ann-args",
                                  "has": {
                                    "stopBy": "end",
                                    "matches": "arg-name",
                                    "not": {
                                      "pattern": "$H"
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "matches": "ann-string"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "rule": {
            "any": [
              {
                "kind": "call",
                "has": {
                  "field": "function",
                  "matches": "callee"
                }
              },
              {
                "matches": "ann-string"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.F",
        "code": "PTH109",
        "message": "Use `Path.cwd()` from pathlib instead of `os.getcwd()`; it returns a `Path`, so wrap it in `str()` or adjust the code where a string is required.",
        "suppress": {
          "noqa": {
            "codes": [
              "PTH109"
            ]
          }
        },
        "each": "F"
      }
    },
    {
      "id": "os-getcwdb",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "target": {
              "any": [
                {
                  "kind": "identifier"
                },
                {
