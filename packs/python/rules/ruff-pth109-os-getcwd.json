                  }
                },
                {
                  "any": [
                    {
                      "kind": "concatenated_string"
                    },
                    {
                      "kind": "string",
                      "has": {
                        "stopBy": "end",
                        "kind": "escape_sequence"
                      }
                    }
                  ],
                  "parse": {
                    "grammar": "annotation",
                    "has": {
                      "stopBy": "end",
                      "any": [
                        {
                          "matches": "ann-call",
                          "all": [
                            {
                              "has": {
                                "stopBy": "neighbor",
                                "matches": "callee",
                                "any": [
