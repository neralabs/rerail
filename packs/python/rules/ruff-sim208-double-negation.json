{
  "format": "rerail.policy/v1",
  "id": "ruff-sim208-double-negation",
  "revision": 1,
  "mode": "steer",
  "description": "Remove double negation with not not; use the value itself, or bool() if you need a real boolean.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "double-negation",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "negation": {
              "any": [
                {
                  "kind": "not_operator"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "negation"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "not_operator",
            "has": {
              "stopBy": "neighbor",
              "matches": "negation"
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "SIM208",
        "message": "Remove the double `not` and use the operand itself, or `bool(...)` if you need a real boolean.",
        "suppress": {
          "noqa": {
            "codes": [
              "SIM208"
            ]
          }
        }
      }
    }
  ]
}
