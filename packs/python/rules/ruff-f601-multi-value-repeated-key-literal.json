{
  "format": "rerail.policy/v1",
  "id": "ruff-f601-multi-value-repeated-key-literal",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid repeating a literal key (or an equal one, like 1 and 1.0) in a Python dict literal; the later value silently overwrites the earlier one.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "multi-value-repeated-key-literal",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "complex": {
              "any": [
                {
                  "kind": "integer"
                },
                {
                  "kind": "float"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "complex"
                  }
                }
              ],
              "regex": "[jJ]\\)*$"
            },
            "literal-key": {
              "any": [
                {
                  "kind": "string",
                  "not": {
                    "regex": "^[A-Za-z]*[tT]"
                  }
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "kind": "string",
                      "regex": "^[A-Za-z]*[tT]"
                    }
                  }
                },
                {
                  "kind": "integer"
                },
                {
                  "kind": "float"
                },
                {
                  "kind": "true"
                },
                {
                  "kind": "false"
                },
                {
                  "kind": "none"
                },
                {
                  "kind": "ellipsis"
                },
                {
                  "kind": "tuple"
                },
                {
                  "kind": "unary_operator",
                  "regex": "^[-+]",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "signed-literal"
                  }
                },
                {
                  "kind": "binary_operator",
                  "has": {
                    "stopBy": "neighbor",
                    "regex": "^[-+]$",
                    "follows": {
                      "stopBy": "neighbor",
                      "matches": "signed-literal",
                      "not": {
                        "regex": "[jJ]\\)*$"
                      }
                    },
                    "precedes": {
                      "stopBy": "neighbor",
                      "matches": "complex"
                    }
                  }
                }
              ]
            },
            "signed-literal": {
              "any": [
                {
                  "kind": "integer"
                },
                {
                  "kind": "float"
                },
                {
                  "kind": "unary_operator",
                  "regex": "^[-+]",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "signed-literal"
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "signed-literal"
                  }
                }
              ]
            },
            "key-slot": {
              "any": [
                {
                  "not": {
                    "follows": {
                      "stopBy": "neighbor",
                      "regex": "(?s)."
                    }
                  },
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "pair"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "key-slot"
                  }
                }
              ]
            }
          },
          "rule": {
            "pattern": "$KEY",
            "not": {
              "kind": "parenthesized_expression"
            },
            "all": [
              {
                "matches": "literal-key"
              },
              {
                "matches": "key-slot"
              }
            ],
            "inside": {
              "stopBy": {
                "not": {
                  "kind": "parenthesized_expression"
                }
              },
              "kind": "pair",
              "count": {
                "follows": {
                  "stopBy": "end",
                  "kind": "pair",
                  "has": {
                    "stopBy": "neighbor",
                    "not": {
                      "follows": {
                        "stopBy": "neighbor",
                        "regex": "(?s)."
                      }
                    },
                    "pattern": "$J"
                  },
                  "compare": {
                    "left": "J",
                    "op": "eq",
                    "right": "KEY",
                    "text": "structure-hash"
                  }
                },
                "min": 1
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "F601",
        "message": "Remove or merge the repeated key `$KEY` in this dict; the later value silently overwrites the earlier one.",
        "suppress": {
          "noqa": {
            "codes": [
              "F601"
            ]
          }
        }
      }
    }
  ]
}
