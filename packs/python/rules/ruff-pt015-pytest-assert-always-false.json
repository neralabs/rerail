{
  "format": "rerail.policy/v1",
  "id": "ruff-pt015-pytest-assert-always-false",
  "revision": 1,
  "mode": "steer",
  "description": "Use pytest.fail instead of an assert on a value that is always false; it states the intent to fail the test more clearly.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "pytest-assert-always-false",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "scalar-falsey": {
              "any": [
                {
                  "kind": "false"
                },
                {
                  "kind": "none"
                },
                {
                  "any": [
                    {
                      "kind": "integer"
                    },
                    {
                      "kind": "float"
                    }
                  ],
                  "value": {
                    "truthy": false
                  }
                }
              ]
            },
            "scalar-falsey-p": {
              "any": [
                {
                  "matches": "scalar-falsey"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "scalar-falsey-p"
                  }
                }
              ]
            },
            "plain-empty": {
              "kind": "string",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string_start",
                  "regex": "[fFtT]"
                }
              },
              "value": {
                "truthy": false
              }
            },
            "plain-empty-str": {
              "kind": "string",
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "kind": "string_start",
                  "regex": "[bBfFtT]"
                }
              },
              "value": {
                "truthy": false
              }
            },
            "f-empty": {
              "kind": "string",
              "has": {
                "stopBy": "neighbor",
                "kind": "string_start",
                "regex": "[fF]"
              },
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "kind": "string_content",
                      "not": {
                        "regex": "^(\\\\\\r?\\n)+$"
                      }
                    },
                    {
                      "kind": "string_content",
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "string",
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "string_start",
                          "regex": "[rR]"
                        }
                      }
                    },
                    {
                      "kind": "escape_interpolation"
                    },
                    {
                      "kind": "string_end",
                      "regex": "^[^'\"]"
                    },
                    {
                      "kind": "interpolation",
                      "not": {
                        "matches": "empty-interpolation"
                      }
                    }
                  ]
                }
              }
            },
            "empty-interpolation": {
              "kind": "interpolation",
              "has": {
                "field": "expression",
                "matches": "empty-str-expr"
              },
              "not": {
                "has": {
                  "stopBy": "neighbor",
                  "any": [
                    {
                      "regex": "^=$"
                    },
                    {
                      "kind": "type_conversion"
                    },
                    {
                      "kind": "format_specifier"
                    }
                  ]
                }
              }
            },
            "empty-str-expr": {
              "any": [
                {
                  "any": [
                    {
                      "matches": "plain-empty-str"
                    },
                    {
                      "matches": "f-empty"
                    }
                  ]
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "any": [
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "line_continuation"
                              }
                            ]
                          },
                          {
                            "matches": "plain-empty-str"
                          },
                          {
                            "matches": "f-empty"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "empty-str-expr"
                  }
                }
              ]
            },
            "empty-literal": {
              "any": [
                {
                  "any": [
                    {
                      "matches": "plain-empty"
                    },
                    {
                      "matches": "f-empty"
                    }
                  ]
                },
                {
                  "kind": "concatenated_string",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "any": [
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "line_continuation"
                              }
                            ]
                          },
                          {
                            "matches": "plain-empty"
                          },
                          {
                            "matches": "f-empty"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "any": [
                    {
                      "kind": "list"
                    },
                    {
                      "kind": "tuple"
                    },
                    {
                      "kind": "dictionary"
                    }
                  ],
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "not": {
                        "any": [
                          {
                            "any": [
                              {
                                "kind": "comment"
                              },
                              {
                                "kind": "line_continuation"
                              }
                            ]
                          },
                          {
                            "regex": "^[\\[\\](){}]$"
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "argument": {
              "not": {
                "any": [
                  {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "kind": "line_continuation"
                      }
                    ]
                  },
                  {
                    "regex": "^[(),]$"
                  }
                ]
              }
            },
            "builtin-name": {
              "any": [
                {
                  "kind": "identifier",
                  "resolves": {
                    "global": [
                      "list",
                      "tuple",
                      "set",
                      "dict",
                      "frozenset"
                    ]
                  }
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "builtin-name"
                  }
                }
              ]
            },
            "empty-call": {
              "kind": "call",
              "has": {
                "field": "function",
                "matches": "builtin-name"
              },
              "any": [
                {
                  "has": {
                    "field": "arguments",
                    "kind": "argument_list",
                    "not": {
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "argument"
                      }
                    }
                  }
                },
                {
                  "has": {
                    "field": "arguments",
                    "kind": "argument_list",
                    "count": {
                      "has": {
                        "stopBy": "neighbor",
                        "matches": "argument"
                      },
                      "min": 1,
                      "max": 1
                    },
                    "all": [
                      {
                        "has": {
                          "stopBy": "neighbor",
                          "matches": "falsey-container-p"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "falsey-container": {
              "any": [
                {
                  "matches": "empty-literal"
                },
                {
                  "matches": "empty-call"
                }
              ]
            },
            "falsey-container-p": {
              "any": [
                {
                  "matches": "falsey-container"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "falsey-container-p"
                  }
                }
              ]
            },
            "test": {
              "follows": {
                "stopBy": {
                  "not": {
                    "any": [
                      {
                        "kind": "comment"
                      },
                      {
                        "kind": "line_continuation"
                      }
                    ]
                  }
                },
                "regex": "^assert$"
              }
            }
          },
          "rule": {
            "kind": "assert_statement",
            "has": {
              "stopBy": "neighbor",
              "matches": "test",
              "any": [
                {
                  "matches": "scalar-falsey-p"
                },
                {
                  "matches": "falsey-container-p"
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "PT015",
        "message": "Replace this always-failing `assert` with `pytest.fail(...)`, passing any assertion message to it; leave it alone outside pytest tests.",
        "suppress": {
          "noqa": {
            "codes": [
              "PT015"
            ]
          }
        }
      }
    }
  ]
}
