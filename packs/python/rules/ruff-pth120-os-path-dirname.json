{
 "format": "rerail.policy/v1",
 "id": "ruff-pth120-os-path-dirname",
 "revision": 1,
 "mode": "steer",
 "description": "Use the parent property of a Path object instead of os.path.dirname; pathlib reads better than string-based os.path functions.",
 "scope": {
  "include": [
   "**/*"
  ],
  "exclude": []
 },
 "clauses": [
  {
   "id": "os-path-dirname",
   "forbid": {
    "ast": {
     "language": "python",
     "rule": {
      "any": [
       {
        "matches": "target"
       },
       {
        "matches": "in-string"
       }
      ]
     },
     "utils": {
      "callee": {
       "any": [
        {
         "any": [
          {
           "kind": "identifier"
          },
          {
           "kind": "attribute"
          }
         ],
         "resolves": {
          "import": [
           "os.path.dirname"
          ]
         },
         "pattern": "$F"
        },
        {
         "kind": "parenthesized_expression",
         "has": {
          "stopBy": "neighbor",
          "matches": "callee"
         }
        }
       ]
      },
      "target": {
       "kind": "call",
       "all": [
        {
         "has": {
          "stopBy": "neighbor",
          "matches": "callee",
          "precedes": {
           "stopBy": "end",
           "any": [
            {
             "kind": "argument_list"
            },
            {
             "kind": "generator_expression"
            }
           ]
          }
         }
        },
        {
         "has": {
          "stopBy": "neighbor",
          "any": [
           {
            "kind": "generator_expression"
           },
           {
            "kind": "argument_list",
            "count": {
             "has": {
              "stopBy": "neighbor",
              "not": {
               "matches": "trivia"
              }
             },
             "min": 1,
             "max": 1
            },
            "has": {
             "stopBy": "neighbor",
             "any": [
              {
               "kind": "keyword_argument",
               "has": {
                "stopBy": "neighbor",
                "kind": "identifier",
                "regex": "^p$",
                "precedes": {
                 "stopBy": "end",
                 "regex": "^=$"
                }
               }
              },
              {
               "not": {
                "any": [
                 {
                  "kind": "keyword_argument"
                 },
                 {
                  "kind": "list_splat"
                 },
                 {
                  "kind": "dictionary_splat"
                 },
                 {
                  "matches": "trivia"
                 }
                ]
               }
              }
             ]
            }
           }
          ]
         }
        }
       ]
      },
      "in-string": {
       "any": [
        {
         "kind": "string"
        },
        {
         "kind": "concatenated_string"
        }
       ],
       "parse": {
        "grammar": "annotation",
        "has": {
         "stopBy": "end",
         "any": [
          {
           "matches": "target"
          },
          {
           "matches": "in-string"
          }
         ]
        }
       }
      },
      "trivia": {
       "any": [
        {
         "kind": "comment"
        },
        {
         "kind": "line_continuation"
        },
        {
         "regex": "^[(),]$"
        }
       ]
      }
     }
    }
   },
   "violation": {
    "anchor": "capture.F",
    "code": "PTH120",
    "message": "Use `Path(...).parent` instead of `os.path.dirname(...)`. It returns a `Path`, not a `str`, and normalizes the path; keep `dirname` where the exact string matters or the path is bytes.",
    "each": "F",
    "suppress": {
     "noqa": {
      "codes": [
       "PTH120"
      ]
     }
    }
   }
  }
 ]
}
