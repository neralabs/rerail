{
  "format": "rerail.policy/v1",
  "id": "bandit-b411-import-xmlrpclib",
  "revision": 1,
  "mode": "steer",
  "description": "Avoid importing xmlrpc unprotected; its XML parsing is open to XML attacks unless patched with defusedxml.",
  "scope": {
    "include": [
      "**/*.py"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "B411",
      "forbid": {
        "ast": {
          "language": "python",
          "rule": {
            "any": [
              {
                "pattern": "import xmlrpc"
              },
              {
                "pattern": "import xmlrpc as $ALIAS"
              },
              {
                "pattern": "from xmlrpc import $$$NAMES"
              }
            ]
          }
        }
      },
      "violation": {
        "code": "B411",
        "anchor": "witness.span",
        "message": "Call defusedxml.xmlrpc.monkey_patch() before using xmlrpc; otherwise its XML parsing is open to XML attacks.",
        "suppress": {
          "nosec": {
            "codes": [
              "B411"
            ]
          }
        }
      }
    }
  ]
}
