{
  "format": "rerail.policy/v1",
  "id": "ruff-pyi056-unsupported-method-call-on-all",
  "revision": 1,
  "mode": "steer",
  "description": "Use += to add names to the module's export list instead of calling append, extend or remove on it; type checkers do not all support those method calls.",
  "scope": {
    "include": [
      "**/*"
    ],
    "exclude": []
  },
  "clauses": [
    {
      "id": "add-to-all",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "callee": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "call",
                    "field": "function"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "callee"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "list_splat",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "call",
                      "field": "function"
                    }
                  }
                }
              ]
            },
            "all-ref": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^__all__$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "all-ref"
                  }
                },
                {
                  "kind": "list_splat",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "all-ref"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "attribute",
            "matches": "callee",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "object",
                  "matches": "all-ref"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "attribute",
                  "regex": "^(append|extend)$"
                }
              }
            ],
            "regex": "^(?:\\*(?:\\s|#[^\\n]*)*)?(?P<ATTR>[^*][\\s\\S]*)$"
          }
        }
      },
      "violation": {
        "anchor": "capture.ATTR",
        "code": "PYI056",
        "message": "Add names with `__all__ += [...]` instead of calling `.append()` or `.extend()` on `__all__`; type checkers support `+=` reliably but not every method call.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI056"
            ]
          }
        }
      }
    },
    {
      "id": "remove-from-all",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "callee": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "call",
                    "field": "function"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "callee"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "list_splat",
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "call",
                      "field": "function"
                    }
                  }
                }
              ]
            },
            "all-ref": {
              "any": [
                {
                  "kind": "identifier",
                  "regex": "^__all__$"
                },
                {
                  "kind": "parenthesized_expression",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "all-ref"
                  }
                },
                {
                  "kind": "list_splat",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "all-ref"
                  }
                }
              ]
            }
          },
          "rule": {
            "kind": "attribute",
            "matches": "callee",
            "all": [
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "object",
                  "matches": "all-ref"
                }
              },
              {
                "has": {
                  "stopBy": "neighbor",
                  "field": "attribute",
                  "regex": "^(remove)$"
                }
              }
            ],
            "regex": "^(?:\\*(?:\\s|#[^\\n]*)*)?(?P<ATTR>[^*][\\s\\S]*)$"
          }
        }
      },
      "violation": {
        "anchor": "capture.ATTR",
        "code": "PYI056",
        "message": "Build `__all__` without that name instead of calling `.remove()`; if it depends on a condition, add the name back with `__all__ += [...]` under the opposite condition.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI056"
            ]
          }
        }
      }
    },
    {
      "id": "method-call-on-all-in-string-annotation",
      "forbid": {
        "ast": {
          "language": "python",
          "utils": {
            "callee": {
              "any": [
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "call"
                  }
                },
                {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "parenthesized_expression",
                    "matches": "callee"
                  }
                }
              ]
            },
            "in-annotation": {
              "any": [
                {
                  "kind": "string"
                },
                {
                  "kind": "concatenated_string"
                }
              ],
              "parse": {
                "grammar": "annotation",
                "has": {
                  "stopBy": "end",
                  "any": [
                    {
                      "kind": "attribute",
                      "matches": "callee",
                      "regex": "^[(\\s]*__all__[)\\s]*\\.\\s*(append|extend|remove)$",
                      "capture": "ATTR"
                    },
                    {
                      "matches": "in-annotation"
                    }
                  ]
                }
              }
            }
          },
          "rule": {
            "matches": "in-annotation"
          }
        }
      },
      "violation": {
        "anchor": "capture.ATTR",
        "code": "PYI056",
        "message": "Change `__all__` with `+=` (or build it without the name) instead of calling `.append()`, `.extend()` or `.remove()` on it; type checkers do not all support those calls.",
        "suppress": {
          "noqa": {
            "codes": [
              "PYI056"
            ]
          }
        },
        "each": "ATTR"
      }
    }
  ]
}
