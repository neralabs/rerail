import sys
import typing

if typing.TYPE_CHECKING and sys.version_info < (3, 9):
    def a(): ...
else:
    def a(x): ...

if not typing.TYPE_CHECKING and sys.version_info < (3, 9):
    def b(): ...
else:
    def b(x): ...

if sys.version_info < (3, 9) and not typing.TYPE_CHECKING:
    def c(): ...
else:
    def c(x): ...

if (sys.version_info < (3, 9) and typing.TYPE_CHECKING) and sys.platform == "x":
    def d(): ...
else:
    def d(x): ...

if sys.platform == "x" and sys.platform == "y" and sys.version_info < (3, 9) or sys.platform == "z":
    def e(): ...
else:
    def e(x): ...

if (sys.version_info < (3, 9) or sys.platform == "x") and sys.platform == "y":
    def f(): ...
else:
    def f(x): ...

if sys.platform == "x" and sys.version_info < (3, 9) and sys.platform == "y" and sys.version_info < (3, 8):
    def g(): ...
else:
    def g(x): ...
