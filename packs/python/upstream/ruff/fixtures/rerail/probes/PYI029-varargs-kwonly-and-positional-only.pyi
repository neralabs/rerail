class A:
    def __str__(self, *args) -> str: ...
    def __repr__(self, **kw) -> str: ...
class B:
    def __str__() -> str: ...
    def __repr__(*args: int, **kw: str) -> str: ...
class C:
    def __str__(self, *, k) -> str: ...
    def __repr__(self, /) -> str: ...
    def __str__(self, /, x) -> str: ...
    def __repr__(self, *args, k) -> str: ...
