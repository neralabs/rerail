{
  "format": "rerail.policy/v1",
  "id": "tslint:ban-comma-operator",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `ban-comma-operator` rule with its default options (https://palantir.github.io/tslint/rules/ban-comma-operator/). Disallows the comma operator, except as a for-loop incrementor.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "comma-operator",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "sequence_expression"
              },
              {
                "not": {
                  "all": [
                    {
                      "inside": {
                        "stopBy": "neighbor",
                        "kind": "for_statement"
                      }
                    },
                    {
                      "precedes": {
                        "stopBy": "neighbor",
                        "regex": "^\\)$"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "BAN_COMMA_OPERATOR",
        "message": "Do not use comma operator here because it can be easily misunderstood or lead to unintended bugs."
      }
    }
  ]
}
