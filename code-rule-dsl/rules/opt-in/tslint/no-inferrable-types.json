{
  "format": "rerail.policy/v1",
  "id": "tslint:no-inferrable-types",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-inferrable-types` rule with its default options (https://palantir.github.io/tslint/rules/no-inferrable-types/). Disallows explicit number/boolean/string annotations on variables, parameters and properties initialized to a literal of that type (numbers under any chain of unary +/-).",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "inferrable-type",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "predefined_type",
            "regex": "^(?<T>number|boolean|string)$",
            "inside": {
              "stopBy": "neighbor",
              "kind": "type_annotation",
              "inside": {
                "stopBy": "neighbor",
                "matches": "declaration"
              }
            },
            "any": [
              {
                "regex": "^number$",
                "inside": {
                  "stopBy": "neighbor",
                  "precedes": {
                    "stopBy": "end",
                    "matches": "numeric"
                  }
                }
              },
              {
                "regex": "^boolean$",
                "inside": {
                  "stopBy": "neighbor",
                  "precedes": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "true"
                      },
                      {
                        "kind": "false"
                      }
                    ]
                  }
                }
              },
              {
                "regex": "^string$",
                "inside": {
                  "stopBy": "neighbor",
                  "precedes": {
                    "stopBy": "end",
                    "any": [
                      {
                        "kind": "string"
                      },
                      {
                        "kind": "template_string"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "utils": {
            "declaration": {
              "any": [
                {
                  "kind": "variable_declarator"
                },
                {
                  "kind": "public_field_definition",
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^readonly$",
                      "not": {
                        "any": [
                          {
                            "kind": "identifier"
                          },
                          {
                            "kind": "property_identifier"
                          }
                        ]
                      }
                    }
                  }
                },
                {
                  "any": [
                    {
                      "kind": "required_parameter"
                    },
                    {
                      "kind": "optional_parameter"
                    }
                  ],
                  "not": {
                    "has": {
                      "stopBy": "neighbor",
                      "regex": "^readonly$",
                      "not": {
                        "any": [
                          {
                            "kind": "identifier"
                          },
                          {
                            "kind": "property_identifier"
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "numeric": {
              "any": [
                {
                  "kind": "number"
                },
                {
                  "kind": "identifier",
                  "regex": "^(?:Infinity|NaN)$"
                },
                {
                  "kind": "unary_expression",
                  "regex": "^[-+]",
                  "has": {
                    "stopBy": "neighbor",
                    "matches": "numeric"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_INFERRABLE_TYPES",
        "message": "Type $T trivially inferred from a $T literal, remove type annotation"
      }
    }
  ]
}
