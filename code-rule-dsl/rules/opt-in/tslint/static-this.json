{
  "format": "rerail.policy/v1",
  "id": "tslint:static-this",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `static-this` rule with its default options (https://palantir.github.io/tslint/rules/static-this/). Disallows `this` whose nearest enclosing class member is static: TSLint resets its context at every class member (a node whose parent is a class), so the walk up from `this` stops at the first class member and tests it for a `static` modifier; nested classes and non-static members inside a static one reset it.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "static-this",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "kind": "this",
            "inside": {
              "stopBy": {
                "matches": "class-member"
              },
              "matches": "class-member",
              "has": {
                "regex": "^static$",
                "not": {
                  "kind": "property_identifier"
                }
              }
            }
          },
          "utils": {
            "class-member": {
              "inside": {
                "kind": "class_body"
              },
              "not": {
                "kind": "comment"
              }
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "STATIC_THIS",
        "message": "Use the parent class name instead of `this` when in a `static` context."
      }
    }
  ]
}
