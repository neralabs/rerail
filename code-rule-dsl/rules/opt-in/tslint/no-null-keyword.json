{
  "format": "rerail.policy/v1",
  "id": "tslint:no-null-keyword",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `no-null-keyword` rule with its default options (https://palantir.github.io/tslint/rules/no-null-keyword/). Disallows the null keyword outside type positions; strict comparisons (=== / !==) against null are allowed.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "null-keyword",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "kind": "null"
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "kind": "literal_type"
                  }
                }
              },
              {
                "not": {
                  "inside": {
                    "stopBy": "neighbor",
                    "any": [
                      {
                        "pattern": "$A === null"
                      },
                      {
                        "pattern": "null === $A"
                      },
                      {
                        "pattern": "$A !== null"
                      },
                      {
                        "pattern": "null !== $A"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "NO_NULL_KEYWORD",
        "message": "Use 'undefined' instead of 'null'"
      }
    }
  ]
}
