{
  "format": "rerail.policy/v1",
  "id": "tslint:type-literal-delimiter",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `type-literal-delimiter` rule with its default options (https://palantir.github.io/tslint/rules/type-literal-delimiter/). Type literal members must be separated by ';' (no trailing ';' on single-line literals, TSLint default). A missing delimiter is reported on the member's last character, anchored through a named group in the member's regex.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "comma",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^,$"
              },
              {
                "inside": {
                  "kind": "object_type",
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "interface_declaration"
                    }
                  },
                  "stopBy": "neighbor"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "TYPE_LITERAL_DELIMITER",
        "message": "Expected type literal to use ';' instead of ','."
      }
    },
    {
      "id": "extra-trailing",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "regex": "^;$"
              },
              {
                "precedes": {
                  "stopBy": "neighbor",
                  "regex": "^\\}$"
                }
              },
              {
                "inside": {
                  "kind": "object_type",
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "interface_declaration"
                    }
                  },
                  "stopBy": "neighbor",
                  "regex": "^[^\\n]*$"
                }
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "TYPE_LITERAL_DELIMITER",
        "message": "Did not expect single-line type literal to have a trailing ';'."
      }
    },
    {
      "id": "missing",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "any": [
                  {
                    "kind": "property_signature"
                  },
                  {
                    "kind": "method_signature"
                  },
                  {
                    "kind": "index_signature"
                  },
                  {
                    "kind": "call_signature"
                  },
                  {
                    "kind": "construct_signature"
                  }
                ]
              },
              {
                "inside": {
                  "kind": "object_type",
                  "not": {
                    "inside": {
                      "stopBy": "neighbor",
                      "kind": "interface_declaration"
                    }
                  },
                  "stopBy": "neighbor",
                  "regex": "\\n"
                }
              },
              {
                "not": {
                  "precedes": {
                    "stopBy": "neighbor",
                    "regex": "^[;,]$"
                  }
                }
              },
              {
                "regex": "(?<LAST>.)$"
              }
            ]
          }
        }
      },
      "violation": {
        "anchor": "capture.LAST",
        "code": "TYPE_LITERAL_DELIMITER",
        "message": "Expected type literal to use ';' to separate members."
      }
    }
  ]
}
