{
  "format": "rerail.policy/v1",
  "id": "tslint:only-arrow-functions",
  "revision": 1,
  "mode": "steer",
  "description": "Port of TSLint's `only-arrow-functions` rule with its default options (https://palantir.github.io/tslint/rules/only-arrow-functions/). Disallows traditional (non-arrow) function expressions and declarations; generators and functions using `this` are exempt. A function is exempt when it is a generator, its first parameter is `this`, or `this` occurs in its body outside nested scopes with their own `this` (tsutils hasOwnThisReference: classes, function declarations and expressions, object-literal methods), found by a has walk that stops at those scopes. Overload and ambient signatures are function declarations too.",
  "scope": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/coverage/**",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.ts",
      "**/*.generated.tsx",
      "**/*.gen.ts"
    ]
  },
  "clauses": [
    {
      "id": "non-arrow-function",
      "forbid": {
        "ast": {
          "language": "typescript",
          "rule": {
            "all": [
              {
                "pattern": "function"
              },
              {
                "inside": {
                  "stopBy": "neighbor",
                  "all": [
                    {
                      "any": [
                        {
                          "kind": "function_expression"
                        },
                        {
                          "kind": "function_declaration"
                        },
                        {
                          "kind": "function_signature"
                        }
                      ]
                    },
                    {
                      "not": {
                        "has": {
                          "stopBy": "neighbor",
                          "kind": "formal_parameters",
                          "has": {
                            "stopBy": "neighbor",
                            "kind": "required_parameter",
                            "has": {
                              "stopBy": "neighbor",
                              "kind": "this"
                            }
                          }
                        }
                      }
                    },
                    {
                      "not": {
                        "has": {
                          "stopBy": {
                            "matches": "own-this"
                          },
                          "kind": "this"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "utils": {
            "own-this": {
              "any": [
                {
                  "kind": "class_declaration"
                },
                {
                  "kind": "class"
                },
                {
                  "kind": "abstract_class_declaration"
                },
                {
                  "kind": "function_expression"
                },
                {
                  "kind": "function_declaration"
                },
                {
                  "kind": "method_definition",
                  "inside": {
                    "kind": "object"
                  }
                }
              ]
            }
          }
        }
      },
      "violation": {
        "anchor": "witness.span",
        "code": "ONLY_ARROW_FUNCTIONS",
        "message": "non-arrow functions are forbidden"
      }
    }
  ]
}
