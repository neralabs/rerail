+// Diagnostic demand overlap only: inputs not in this key (captures/following) and
+// native state can still make replay unsafe. No observation bypasses execution.
+const DEMAND_CAPACITY: usize = 32768;
+type DemandKey = (usize, usize, usize, u32, bool);
+struct ObservedDemand {
+    // Retain the descriptor so its address cannot be recycled while resident.
+    _descriptor: Arc<Semantic>,
+    matched: bool,
+    cost: Cost,
+}
+struct ObservedFactDemand {
+    descriptor: Arc<Semantic>,
+    context: u32,
+}
+#[derive(Default)]
+struct DemandObserver {
+    entries: FxHashMap<DemandKey, ObservedDemand>,
+    // Physical fact-demand overlap, not verdict reuse: descriptor/context are observations,
+    // and all calls still execute against the currently installed native tables.
+    facts: FxHashMap<(usize, usize), ObservedFactDemand>,
+}
+impl DemandObserver {
+    fn observe(
+        &mut self,
+        key: DemandKey,
+        descriptor: Arc<Semantic>,
+        matched: bool,
+        cost: Cost,
+        metrics: &mut Metrics,
+    ) {
+        let class = usize::from(!matches!(descriptor.as_ref(), Semantic::Resolves(test)
+            if test.language == crate::code_rule_dsl::language::GrammarDialect::Python
+                && !test.item && !test.seen_before && !test.before_local
+                && test.unresolved.is_none() && !test.this_global));
+        let clean = |c: Cost| {
+            c.work == 0 && c.replay_work == 0 && c.levels == 0 && c.failure.is_none() && !c.unknown
+        };
+        if !cost.clause_state_read {
+            metrics.resolves_unread_demands_by_class[class] += 1;
+            metrics.resolves_unread_clean_by_class[class] += u64::from(clean(cost));
+        } else if cost.failure.is_none() && !cost.unknown {
+            metrics.resolves_fact_demands_by_class[class] += 1;
+            let fact_key = (key.0, key.1);
+            if let Some(prior) = self.facts.get(&fact_key) {
+                metrics.resolves_fact_repeats_by_class[class] += 1;
+                let same = Arc::ptr_eq(&prior.descriptor, &descriptor);
+                metrics.resolves_fact_same_descriptor_by_class[class] += u64::from(same);
+                metrics.resolves_fact_different_descriptor_by_class[class] += u64::from(!same);
+                metrics.resolves_fact_different_owner_by_class[class] +=
+                    u64::from(prior.context != key.3);
+            } else if self.facts.len() >= DEMAND_CAPACITY {
+                metrics.resolves_fact_clears += 1;
+                metrics.resolves_fact_evicted += self.facts.len() as u64;
+                self.facts.clear();
+            }
+            self.facts.insert(
+                fact_key,
+                ObservedFactDemand {
+                    descriptor: descriptor.clone(),
+                    context: key.3,
+                },
+            );
+            metrics.max_resolves_fact_entries =
+                metrics.max_resolves_fact_entries.max(self.facts.len());
+        }
+        metrics.python_resolves_eligible_by_class[class] += 1;
+        if let Some(prior) = self.entries.get(&key) {
+            metrics.resolves_demand_repeats += 1;
+            let agrees = prior.matched == matched && prior.cost.unknown == cost.unknown;
+            metrics.resolves_demand_agreements += u64::from(agrees);
+            if clean(prior.cost) && clean(cost) {
+                metrics.resolves_demand_clean_repeats += 1;
+                metrics.resolves_demand_clean_agreements += u64::from(agrees);
+                metrics.resolves_demand_clean_agreements_by_class[class] += u64::from(agrees);
+            }
+            metrics.resolves_demand_clause_state_mismatches +=
+                u64::from(prior.cost.clause_state_read != cost.clause_state_read);
+        } else if self.entries.len() >= DEMAND_CAPACITY {
+            metrics.resolves_demand_clears += 1;
+            metrics.resolves_demand_evicted += self.entries.len() as u64;
+            self.entries.clear();
+        }
+        self.entries.insert(
+            key,
+            ObservedDemand {
+                _descriptor: descriptor,
+                matched,
+                cost,
+            },
+        );
+        metrics.max_resolves_demand_entries =
+            metrics.max_resolves_demand_entries.max(self.entries.len());
+    }
+}
+fn record_unread_shape<D: Doc>(
+    semantic: &Semantic,
+    raw: &ast_grep_core::Node<'_, D>,
+    matched: bool,
+    metrics: &mut Metrics,
+) {
+    let Semantic::Resolves(test) = semantic else {
+        return;
+    };
+    let ordinary = !test.item
+        && !test.seen_before
+        && !test.before_local
+        && test.unresolved.is_none()
+        && !test.this_global;
+    let node = super::resolve::unparenthesized(&test.paren_kinds, raw.clone());
+    let kind = node.kind_id();
+    let reference = test.reference_kinds.contains(&kind);
+    let attribute = test.attribute_kinds.contains(&kind);
+    let dotted = test.dotted_kinds.contains(&kind);
+    let string = test.string_kinds.contains(&kind);
+    let text = crate::code_rule_dsl::identifier::name_in(test.language, node.text());
+    let global_name = test.globals.contains(text.as_ref());
+    let terminal = if ordinary && attribute {
+        if let Some(last) = node.field("attribute") {
+            let last = crate::code_rule_dsl::identifier::name_in(test.language, last.text());
+            if test
+                .imports
+                .iter()
+                .any(|name| name.rsplit('.').next() == Some(last.as_ref()))
+            {
+                "listed"
+            } else {
+                "not-listed"
+            }
+        } else {
+            "missing"
+        }
+    } else {
+        "not-applicable"
+    };
+    // Prefix labels follow holds_in's order. "possible" labels deliberately do
+    // not claim a reason after a table lookup or reconstruct the full import chain.
+    let reason = if test.item {
+        "item"
+    } else if test.seen_before {
+        "seen-before"
+    } else if test.this_global && test.this_kinds.contains(&kind) {
+        "this"
+    } else if dotted {
+        "imported-dotted"
+    } else if test.before_local {
+        "before-local"
+    } else if test.unresolved.is_some() && string {
+        "unresolved-string"
+    } else if !reference {
+        "non-reference-kind"
+    } else if test.unresolved.is_some() {
+        if attribute {
+            "unresolved-attribute"
+        } else {
+            "unresolved-reference"
+        }
+    } else if ordinary && attribute && !test.prefix && !test.import_any && terminal == "not-listed"
+    {
+        "attribute-import-suffix-reject"
+    } else if test.imports.is_empty()
+        && !test.import_any
+        && !test.global_any
+        && !global_name
+        && !(test.directives && test.options.is_none())
+    {
+        "no-import-or-global-name"
+    } else {
+        "default-candidate-possible"
+    };
+    let flags = format!(
+        "i{}a{}p{}g{}G{}d{}D{}",
+        u8::from(!test.imports.is_empty()),
+        u8::from(test.import_any),
+        u8::from(test.prefix),
+        u8::from(!test.globals.is_empty()),
+        u8::from(test.global_any),
+        u8::from(!test.imported.is_empty()),
+        u8::from(test.directives)
+    );
+    let mode = format!(
+        "item{}seen{}before{}unresolved{}this{}",
+        u8::from(test.item),
+        u8::from(test.seen_before),
+        u8::from(test.before_local),
+        u8::from(test.unresolved.is_some()),
+        u8::from(test.this_global)
+    );
+    let shape = format!(
+        "class={}|matched={}|raw={}|node={}|reason={}|flags={}|mode={}|ref={}|attr={}|dotted={}|string={}|terminal={}|global-name={}",
+        if ordinary { "ordinary" } else { "extended" },
+        u8::from(matched),
+        raw.kind(),
+        node.kind(),
+        reason,
+        flags,
+        mode,
+        u8::from(reference),
+        u8::from(attribute),
+        u8::from(dotted),
+        u8::from(string),
+        terminal,
+        u8::from(global_name)
+    );
+    *metrics.resolves_unread_shapes.entry(shape).or_default() += 1;
+}
+fn semantic_family(semantic: &Semantic) -> &'static str {
+    match semantic {
+        Semantic::Resolves(_) => "resolves",
+        Semantic::Binding(_) => "binding",
+        Semantic::Binds(_) => "binds",
+        Semantic::Value(_) => "value",
+        Semantic::Arguments(_) => "arguments",
+        Semantic::Parse(_) => "parse",
+        Semantic::Host(_) => "host",
+        Semantic::Capture(_) => "capture",
+        Semantic::FormatArgs(_) => "formatArgs",
+        Semantic::Layout(_) => "layout",
+        Semantic::Calls(_) => "calls",
+    }
+}
