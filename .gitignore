# The port readiness gates' upstream runtimes are pinned by their manifests alone (conformance/recorders/port-readiness/runtimes.ts):
# installs resolve in .rerail/port-readiness/runtimes/, and a lockfile here would put every transitive package in the dependency graph.
conformance/recorders/port-readiness/runtimes/*/package-lock.json
conformance/recorders/port-readiness/runtimes/*/uv.lock
conformance/recorders/port-readiness/runtimes/*/composer.lock

# Nothing the port readiness generator produces is in the tree: `npm run generate` uploads each tool-pack's answers to Rerail's
# private Azure blob store, keyed by the upstream release and a digest of the generator's inputs, and caches them under
# .rerail/port-readiness/expected/ (docs/generate-and-review.md). These rules keep a stray copy left by an older checkout out of
# the history, where it would stay forever.
packs/*/upstream/*/expected/
packs/*/upstream/*/recording.json
packs/*/upstream/*/corpus.json
