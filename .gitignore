node_modules/
dist/
target/
*.node
/index.js
/index.d.ts
/native/index.js
/native/index.d.ts
coverage/
.DS_Store
.rerail/
/tmp/

# Local secrets, such as the Bedrock API key for model testing. An example file stays committable.
.env
.env.*
!.env.example

# The port readiness gates' upstream runtimes are pinned by their manifests alone (conformance/recorders/port-readiness/runtimes.ts):
# installs resolve in .rerail/port-readiness/runtimes/, and a lockfile here would put every transitive package in the dependency graph.
conformance/recorders/port-readiness/runtimes/*/package-lock.json
conformance/recorders/port-readiness/runtimes/*/uv.lock
conformance/recorders/port-readiness/runtimes/*/composer.lock

# The port readiness gates' recordings are not in the tree: each tool-pack commits a recording.lock naming, by sha256, the one
# its rules are judged against (conformance/port-readiness/recording/store.ts). The recorder puts them in
# .rerail/port-readiness/recordings/, and CI keeps them in its Actions cache; committing one again would put 71 MB of generated
# JSON back in the history, where it stays forever.
packs/*/upstream/*/recording.json
packs/*/upstream/*/corpus.json

# Pack test data (PACK_FIXTURE_PATTERNS, scripts/s3/pack-fixtures.mjs), each tool's test cases and its recorded answers
# on them, is never in git. The authored part (what the tool's UPSTREAM.md lists as Rerail's, and authored/) lives in S3,
# fetched by `npm run fixtures:pull`: a pull request adds new or changed files with `git add -f`, and a maintainer moves
# them to S3 with `npm run fixtures:push` before merge. The derived part is `npm run fixtures:derive`'s, regenerated from
# the pins and cached by CI, and never committed (CONTRIBUTING.md, "Pack test data").
packs/*/upstream/*/fixtures/
packs/*/upstream/*/tests/
packs/*/upstream/*/*.expected.json
packs/*/upstream/*/cases.json
packs/*/upstream/*/*.cases.json
packs/*/upstream/*/fixtures.upstream-check.json
packs/*/upstream/*/lizard-*.tsv
packs/*/upstream/*/authored/
