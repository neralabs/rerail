node_modules/
dist/
target/
*.node
/index.js
/index.d.ts
/native/index.js
/native/index.d.ts
coverage/
.DS_Store
.rerail/
/tmp/

# Local secrets, such as the Bedrock API key for model testing. An example file stays committable.
.env
.env.*
!.env.example

# The derivation's runtimes are pinned by their manifests alone (scripts/pack-data/runtimes.ts): installs resolve in
# .rerail/pack-data/runtimes/, and a lockfile here would put every transitive package in the dependency graph.
scripts/pack-data/runtimes/*/package-lock.json
scripts/pack-data/runtimes/*/uv.lock
scripts/pack-data/runtimes/*/composer.lock

# Pack test data (PACK_FIXTURE_PATTERNS, scripts/s3/pack-fixtures.mjs), each tool's test cases and its expected
# findings on them, is never in git. Each tool-pack's data is one archive in S3, which its tracked test-data.lock names
# by sha256; `npm run fixtures:pull` fetches and extracts it. A pull request stages new or changed data under the
# tool-pack's tracked publish/ (`npm run fixtures:stage`), and the Publish pack data workflow uploads it and commits the
# new lock (docs/upstream.md, "Publishing pack data"). The archives are cached under .rerail/pack-data/archives/, which
# .rerail/ covers.
packs/*/upstream/*/fixtures/
packs/*/upstream/*/tests/
packs/*/upstream/*/*.expected.json
packs/*/upstream/*/cases.json
packs/*/upstream/*/*.cases.json
packs/*/upstream/*/fixtures.upstream-check.json
packs/*/upstream/*/lizard-*.tsv
packs/*/upstream/*/provenance.json
packs/*/upstream/*/LICENSES.md
packs/*/upstream/*/authored/

# A tool-pack's publish/ is tracked whole: anything in it is a publish request (CONTRIBUTING.md, "Pack test data").
!packs/*/upstream/*/publish/
!packs/*/upstream/*/publish/**
